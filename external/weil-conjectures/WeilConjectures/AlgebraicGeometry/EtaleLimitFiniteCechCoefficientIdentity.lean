module

public import WeilConjectures.SixFunctors.Etale.UpperLowerStar.Coherence
public import WeilConjectures.CategoryTheory.GrothendieckAbelian.ConcreteCoefficients
public import Mathlib.CategoryTheory.Sites.SheafCohomology.Cech
public import Mathlib.CategoryTheory.Limits.Constructions.Over.Products
import WeilConjectures.AlgebraicGeometry.EtaleLimitScalarSectionMapLaws

@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.Etale
attribute [local instance] Over.ConstructProducts.over_finiteProducts_of_finiteWidePullbacks

set_option linter.unusedVariables false in
/-- The identity law for prescribed descended Cech coefficient maps.
Source: Stacks Project, Tag 09YP, proof of lemma-colimit, the displayed canonical
Cech comparison. This is the identity part of the agent's explicit etale realization.
(blueprint: lem-weil-pbc-etale-limit-finite-cech-coefficient-identity).

Proof: Apply HomologicalComplex.Hom.ext in degree n, then Pi.hom_ext at each tuple t.
Postcompose each component equation by the presheaf image of eNj; this is an
isomorphism and hence can be cancelled. Use the transition formula for the identity
arrow and substitute hidentity after rewriting D.map_id. Evaluate
upperStarId_hom_app_unit_app on Wj j n t: the unit followed by the identity
coefficient map is restriction along the canonical projection from the identity
pullback to Wj. The hom of gamma j j (identity) is precisely this projection.
To check this identification, compose the hom of gamma with the first
projection Wj j n t -> W0 n t and use hγ. It has the same first projection as the
canonical comparison; both maps are over D_j, so their second projections also
agree. The target Wj is the pullback of W0 over D_j, and pullback.hom_ext gives
equality. The two inverse restriction maps cancel. This leaves the tuple projection
of the identity cochain map, as required. If K is empty, no tuple t exists in any
degree, and product extensionality is vacuous. This proves only the identity law.
-/
theorem etale_limit_finite_cech_coefficient_identity
    {I : Type u} [Preorder I]
    (D : Iᵒᵖ ⥤ Scheme.{u}) (c : Cone D)
    (F : ∀ i : I, Sheaf (D.obj (op i)).smallEtaleTopology AddCommGrpCat.{u + 1})
    (φ : ∀ {i j : I} (f : i ⟶ j),
      (upperStar AddCommGrpCat.{u + 1} (D.map f.op)).obj (F i) ⟶ F j)
    (hidentity : ∀ i : I, φ (𝟙 i) =
      (eqToIso (congrArg (upperStar AddCommGrpCat.{u + 1}) (D.map_id (op i)))).hom.app
        (F i) ≫ (upperStarId AddCommGrpCat.{u + 1} (D.obj (op i))).hom.app (F i))
    (hcomposition : ∀ (i j k : I) (f : i ⟶ j) (g : j ⟶ k),
      φ (f ≫ g) =
        (upperStarComp AddCommGrpCat.{u + 1} (D.map g.op) (D.map f.op)
          (D.map (f ≫ g).op) (D.map_comp g.op f.op)).hom.app (F i) ≫
        (upperStar AddCommGrpCat.{u + 1} (D.map g.op)).map (φ f) ≫ φ g)
    (G : I ⥤ Sheaf c.pt.smallEtaleTopology AddCommGrpCat.{u + 1})
    (eG : ∀ i : I, G.obj i ≅
      (upperStar AddCommGrpCat.{u + 1} (c.π.app (op i))).obj (F i))
    (hG : ∀ (i j : I) (f : i ⟶ j), G.map f =
      (eG i).hom ≫
        (upperStarComp AddCommGrpCat.{u + 1} (c.π.app (op j)) (D.map f.op)
          (c.π.app (op i)) (c.w f.op).symm).hom.app (F i) ≫
        (upperStar AddCommGrpCat.{u + 1} (c.π.app (op j))).map (φ f) ≫ (eG j).inv)
    (L : Cocone G)
    (U : c.pt.Etale)
    (K : Type (u + 1)) [Finite K] (V : K → c.pt.Etale) (f : ∀ k, V k ⟶ U)
    (i₀ : I) (U₀ : (D.obj (op i₀)).Etale)
    (V₀ : K → (D.obj (op i₀)).Etale) (f₀ : ∀ k, V₀ k ⟶ U₀)
    (eU : (MorphismProperty.Over.pullback @Etale ⊤ (c.π.app (op i₀))).obj U₀ ≅ U)
    (eV : ∀ k,
      (MorphismProperty.Over.pullback @Etale ⊤ (c.π.app (op i₀))).obj (V₀ k) ≅ V k)
    (he : ∀ k,
      (MorphismProperty.Over.pullback @Etale ⊤ (c.π.app (op i₀))).map (f₀ k) ≫
        eU.hom = (eV k).hom ≫ f k) :
    let J := {j : I // i₀ ≤ j}
    let B := fun j : J ↦
      MorphismProperty.Over.pullback @Etale ⊤ (D.map (homOfLE j.property).op)
    let Blim := MorphismProperty.Over.pullback @Etale ⊤ (c.π.app (op i₀))
    let Uj := fun j : J ↦ (B j).obj U₀
    let Vj := fun (j : J) (k : K) ↦ (B j).obj (V₀ k)
    let fj := fun (j : J) (k : K) ↦ (B j).map (f₀ k)
    let W₀ := fun (n : ℕ) (t : Fin (n + 1) → K) ↦
      (∏ᶜ fun a ↦ Over.mk (f₀ (t a))).left
    let pr₀ := fun (n : ℕ) (t : Fin (n + 1) → K) (a : Fin (n + 1)) ↦
      (Pi.π (fun a ↦ Over.mk (f₀ (t a))) a).left
    let Wj := fun (j : J) (n : ℕ) (t : Fin (n + 1) → K) ↦ (B j).obj (W₀ n t)
    let Wlim := fun (n : ℕ) (t : Fin (n + 1) → K) ↦ Blim.obj (W₀ n t)
    let Nj := fun (j : J) (n : ℕ) (t : Fin (n + 1) → K) ↦
      (∏ᶜ fun a ↦ Over.mk (fj j (t a))).left
    let Nlim := fun (n : ℕ) (t : Fin (n + 1) → K) ↦
      (∏ᶜ fun a ↦ Over.mk (f (t a))).left
    let Pj := fun (j : J) (n : ℕ) ↦
      fun t : Fin (n + 1) → K ↦ (F j.val).obj.obj (op (Nj j n t))
    let Plim := fun (n : ℕ) ↦
      fun t : Fin (n + 1) → K ↦ L.pt.obj.obj (op (Nlim n t))
    let Cj := fun j : J ↦
      (cechComplexFunctor (fun k : K ↦ Over.mk (fj j k))).obj
        ((Over.forget (Uj j)).op ⋙ (F j.val).obj)
    let CX := (cechComplexFunctor (fun k : K ↦ Over.mk (f k))).obj
      ((Over.forget U).op ⋙ L.pt.obj)
    ∀ (eNj : ∀ (j : J) (n : ℕ) (t : Fin (n + 1) → K),
        Wj j n t ≅ Nj j n t)
      (eNlim : ∀ (n : ℕ) (t : Fin (n + 1) → K), Wlim n t ≅ Nlim n t)
      (γ : ∀ (j k : J) (a : j ⟶ k) (n : ℕ) (t : Fin (n + 1) → K),
        (MorphismProperty.Over.pullback @Etale ⊤
          (D.map (show j.val ⟶ k.val from a).op)).obj (Wj j n t) ≅ Wj k n t)
      (δ : ∀ (j : J) (n : ℕ) (t : Fin (n + 1) → K),
        (MorphismProperty.Over.pullback @Etale ⊤
          (c.π.app (op j.val))).obj (Wj j n t) ≅ Wlim n t)
      (hNj : ∀ (j : J) (n : ℕ) (t : Fin (n + 1) → K) (a : Fin (n + 1)),
        (eNj j n t).hom ≫ (Pi.π (fun a ↦ Over.mk (fj j (t a))) a).left =
          (B j).map (pr₀ n t a))
      (hNlim : ∀ (n : ℕ) (t : Fin (n + 1) → K) (a : Fin (n + 1)),
        (eNlim n t).hom ≫ (Pi.π (fun a ↦ Over.mk (f (t a))) a).left =
          Blim.map (pr₀ n t a) ≫ (eV (t a)).hom)
      (hγ : ∀ (j k : J) (a : j ⟶ k) (n : ℕ) (t : Fin (n + 1) → K),
        (γ j k a n t).hom.left ≫
            pullback.fst (W₀ n t).hom (D.map (homOfLE k.property).op) =
          pullback.fst (Wj j n t).hom (D.map (show j.val ⟶ k.val from a).op) ≫
            pullback.fst (W₀ n t).hom (D.map (homOfLE j.property).op))
      (hδ : ∀ (j : J) (n : ℕ) (t : Fin (n + 1) → K),
        (δ j n t).hom.left ≫ pullback.fst (W₀ n t).hom (c.π.app (op i₀)) =
          pullback.fst (Wj j n t).hom (c.π.app (op j.val)) ≫
            pullback.fst (W₀ n t).hom (D.map (homOfLE j.property).op)),
      ∀ (m : ∀ (j k : J) (a : j ⟶ k), Cj j ⟶ Cj k)
        (l : ∀ j : J, Cj j ⟶ CX),
      (∀ (j k : J) (a : j ⟶ k) (n : ℕ) (t : Fin (n + 1) → K),
        (m j k a).f n ≫
            Pi.π (Pj k n) t ≫ (F k.val).obj.map (eNj k n t).hom.op =
          Pi.π (Pj j n) t ≫ (F j.val).obj.map (eNj j n t).hom.op ≫
            ((upperStarLowerStarAdjunction AddCommGrpCat.{u + 1}
              (D.map (show j.val ⟶ k.val from a).op)).unit.app (F j.val)).hom.app
                (op (Wj j n t)) ≫
            (φ (show j.val ⟶ k.val from a)).hom.app
              (op ((MorphismProperty.Over.pullback @Etale ⊤
                (D.map (show j.val ⟶ k.val from a).op)).obj (Wj j n t))) ≫
            (F k.val).obj.map (γ j k a n t).inv.op) ∧
      (∀ (j : J) (n : ℕ) (t : Fin (n + 1) → K),
        (l j).f n ≫
            Pi.π (Plim n) t ≫ L.pt.obj.map (eNlim n t).hom.op =
          Pi.π (Pj j n) t ≫ (F j.val).obj.map (eNj j n t).hom.op ≫
            ((upperStarLowerStarAdjunction AddCommGrpCat.{u + 1}
              (c.π.app (op j.val))).unit.app (F j.val)).hom.app (op (Wj j n t)) ≫
            (eG j.val).inv.hom.app
              (op ((MorphismProperty.Over.pullback @Etale ⊤
                (c.π.app (op j.val))).obj (Wj j n t))) ≫
            (L.ι.app j.val).hom.app
              (op ((MorphismProperty.Over.pullback @Etale ⊤
                (c.π.app (op j.val))).obj (Wj j n t))) ≫
            L.pt.obj.map (δ j n t).inv.op) →
      (∀ j : J, m j j (𝟙 j) = 𝟙 (Cj j)) := by
  intro J B Blim Uj Vj fj W₀ pr₀ Wj Wlim Nj Nlim Pj Plim Cj CX
    eNj eNlim γ δ hNj hNlim hγ hδ m l hm j
  apply HomologicalComplex.Hom.ext
  funext n
  apply Pi.hom_ext
  intro t
  apply (cancel_mono ((F j.val).obj.map (eNj j n t).hom.op)).1
  simp only [HomologicalComplex.id_f, Category.id_comp, Category.assoc]
  change (m j j (𝟙 j)).f n ≫ Pi.π (Pj j n) t ≫
      (F j.val).obj.map (eNj j n t).hom.op =
    Pi.π (Pj j n) t ≫ (F j.val).obj.map (eNj j n t).hom.op
  rw [hm.1 j j (𝟙 j) n t]
  have hi := (etale_limit_scalar_section_map_laws D c F φ hidentity hcomposition
    G eG hG L i₀ (W₀ n t)
    (fun j k a ↦ γ j k a n t) (fun j ↦ δ j n t)
    (fun j k a ↦ hγ j k a n t) (fun j ↦ hδ j n t)).1 j
  have hi' :
      ((upperStarLowerStarAdjunction AddCommGrpCat.{u + 1}
        (D.map (show j.val ⟶ j.val from 𝟙 j).op)).unit.app (F j.val)).hom.app
          (op (Wj j n t)) ≫
      (φ (show j.val ⟶ j.val from 𝟙 j)).hom.app
        (op ((MorphismProperty.Over.pullback @Etale ⊤
          (D.map (show j.val ⟶ j.val from 𝟙 j).op)).obj (Wj j n t))) ≫
      (F j.val).obj.map (γ j j (𝟙 j) n t).inv.op =
        𝟙 ((F j.val).obj.obj (op (Wj j n t))) := hi
  rw [hi', Category.comp_id]


end AlgebraicGeometry.Etale

