module

public import WeilConjectures.AlgebraicGeometry.Cohomological.CohomologicalDimension
public import Mathlib.FieldTheory.IsAlgClosed.Basic
import WeilConjectures.AlgebraicGeometry.SmoothPurity.SeparablyClosedTorsionCohomologicalDimension
import WeilConjectures.AlgebraicGeometry.SixFunctors.EllCohomologicalDimensionComparison
import WeilConjectures.AlgebraicGeometry.Base.BaseFieldFiniteTorsionCohomologicalDimension

/-!
# Cohomological dimension of the base field

The `ℓ`-cohomological dimension of an algebraically closed field is zero and that of a finite
field is at most one (Stacks Project, Tags 03QQ and 010T). The dimension and its local
prime-power torsion convention are those of `cohomologicalDimension`.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace AlgebraicGeometry.ProEtale

open CategoryTheory

/-- The `ℓ`-cohomological dimension of an algebraically closed field is zero, and
that of a finite field is at most one. There is no restriction on the characteristic.
See Stacks Project, Tags 03QQ and 010T.

Proof: `ellCohomologicalDimension_etale_comparison` identifies `cohomologicalDimension` with
the étale cohomological dimension and bounds it by `c` whenever the torsion étale cohomology
of the spectrum vanishes in degrees above `c`; the spectrum is affine, hence qcqs, and its
identity serves as the auxiliary qcqs morphism. The torsion bounds are
`Scheme.hasTorsionEtaleCohomologicalDimensionLE_zero_of_isSepClosed` and
`Scheme.hasTorsionEtaleCohomologicalDimensionLE_one_of_finite_baseField`; the underlying
Galois-cohomological argument is as follows.
1. Choose a separable closure inside an algebraic closure of `K`. The additive
   geometric-stalk equivalence identifies abelian étale sheaves on `Spec K` with discrete
   modules over the absolute Galois group, and sections with invariants. The equivalence
   preserves exact complexes and K-injectivity, so étale cohomology is identified with
   continuous Galois cohomology in every nonnegative degree, without any finite coefficient
   ring or common annihilator assumption.
2. If `K` is algebraically closed, it is separably closed, and all positive torsion étale
   cohomology of its spectrum vanishes, global sections being exact. This gives the bound zero.
3. The trivial Galois module `ZMod ℓ` is nonzero since `ℓ` is prime and is killed by `ℓ`, so
   it is prime-power torsion with nonzero degree-zero cohomology. Thus zero belongs to the
   supremum defining the dimension, giving equality with zero, also in characteristic `ℓ`.
4. For finite `K`, the absolute Galois group is the profinite completion of the integers, the
   inverse limit of the finite cyclic groups `C_n` under reduction. Pullback along this
   topological group isomorphism identifies continuous cochains and their cohomology.
5. A torsion discrete module over the profinite integers is the directed union of its finite
   stable submodules: each element has open stabilizer, hence finite orbit, and the subgroup
   generated by a finite orbit killed by `e > 0` is a quotient of a finite product of
   `ZMod e`. Continuous cohomology commutes with this directed union, so vanishing reduces to
   finite stable coefficient modules.
6. A finite module `A` with exponent `e` has open action kernel containing a coordinate
   kernel, so the action factors through some `C_m`, and the coordinate kernels at positive
   multiples of `m` are cofinal among the open normal subgroups acting trivially on `A`.
   Continuous cohomology is therefore the colimit of `H^s(C_n, A)` over positive multiples
   `n` of `m` along inflation maps.
7. For `s ≥ 2`, the inflation `H^s(C_n, A) → H^s(C_(e*n), A)` computed on the periodic
   cyclic resolutions multiplies by `e^(s/2)`, hence is zero since `e` kills `A`. Every
   colimit class thus vanishes, so continuous cohomology of every torsion discrete module
   vanishes in degrees at least two, with no common exponent for the whole module.
8. A torsion étale sheaf has torsion geometric stalk, since each germ is locally represented
   by a section killed by a positive integer. Steps 1 and 4 identify its cohomology with the
   continuous cohomology vanishing in step 7. In particular this holds for every prime-power
   torsion sheaf, which bounds the supremum of nonvanishing degrees by one.
-/
theorem cohomologicalDimension_baseField (ℓ : ℕ) (hℓ : Nat.Prime ℓ)
    (K : Type u) [Field K] :
    (IsAlgClosed K → cohomologicalDimension ℓ hℓ (Spec (.of K)) = 0) ∧
      (Finite K → cohomologicalDimension ℓ hℓ (Spec (.of K)) ≤ 1)  := by
  constructor
  · intro hK
    have hsep : IsSepClosed K := inferInstance
    have htor :=
      AlgebraicGeometry.Scheme.hasTorsionEtaleCohomologicalDimensionLE_zero_of_isSepClosed K
    have hcmp := (ellCohomologicalDimension_etale_comparison ℓ hℓ
      (Spec (.of K)) (X := Spec (.of K)) (Y := Spec (.of K)) (𝟙 _) 0).2.2.2 htor
    exact le_antisymm hcmp bot_le
  · intro hK
    have htor :=
      AlgebraicGeometry.Scheme.hasTorsionEtaleCohomologicalDimensionLE_one_of_finite_baseField K
    let g : Spec (.of K) ⟶ Spec (.of K) := 𝟙 _
    exact (ellCohomologicalDimension_etale_comparison ℓ hℓ
      (Spec (.of K)) (X := Spec (.of K)) (Y := Spec (.of K)) g 1).2.2.2 htor

/-- A finite or algebraically closed field has finite `ℓ`-cohomological dimension: it is `0`
in the algebraically closed case and at most `1` in the finite case
(`AlgebraicGeometry.ProEtale.cohomologicalDimension_baseField`). -/
theorem cohomologicalDimension_baseField_lt_top (ℓ : ℕ) (hℓ : Nat.Prime ℓ)
    (K : Type u) [Field K] (hK : Finite K ∨ IsAlgClosed K) :
    cohomologicalDimension ℓ hℓ (Spec (.of K)) < ⊤ := by
  rcases hK with hK | hK
  · exact lt_of_le_of_lt ((cohomologicalDimension_baseField ℓ hℓ K).2 hK) WithTop.one_lt_top
  · rw [(cohomologicalDimension_baseField ℓ hℓ K).1 hK]
    exact WithTop.coe_lt_top (0 : ℕ)

/-- Over a finite or algebraically closed field `K`, a finite-type morphism `g : X ⟶ Y` of
finite-type `K`-schemes has finite relative `ℓ`-cohomological dimension `cd_ℓ(g) < ∞`: the
base field has finite `ℓ`-cohomological dimension
(`AlgebraicGeometry.ProEtale.cohomologicalDimension_baseField`), so the relative finiteness
theorem for finite-type morphisms over a field of finite cohomological dimension
(`AlgebraicGeometry.ProEtale.relativeCohomologicalDimension_lt_top_of_finiteType`) applies. -/
theorem relativeCohomologicalDimension_lt_top_of_finiteType_of_baseField
    (ℓ : ℕ) (hℓ : Nat.Prime ℓ) {K : Type u} [Field K] (hK : Finite K ∨ IsAlgClosed K)
    {X Y : Scheme.{u}} [X.Over (Spec (.of K))] [Y.Over (Spec (.of K))]
    [LocallyOfFiniteType (X ↘ Spec (.of K))] [QuasiCompact (X ↘ Spec (.of K))]
    [LocallyOfFiniteType (Y ↘ Spec (.of K))] [QuasiCompact (Y ↘ Spec (.of K))]
    (g : X ⟶ Y) [g.IsOver (Spec (.of K))]
    [LocallyOfFiniteType g] [QuasiCompact g] :
    @relativeCohomologicalDimension ℓ hℓ X Y g inferInstance
      (@QuasiSeparated.of_quasiSeparatedSpace X Y g
        (@IsLocallyNoetherian.quasiSeparatedSpace X
          (LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of K))))) < ⊤ :=
  relativeCohomologicalDimension_lt_top_of_finiteType ℓ hℓ
    (cohomologicalDimension_baseField_lt_top ℓ hℓ K hK) g

end AlgebraicGeometry.ProEtale
