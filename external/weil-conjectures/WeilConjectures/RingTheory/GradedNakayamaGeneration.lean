/-!
# Graded Nakayama generation over the projective-line polynomial ring

Source: blueprint `theorem-riemann-roch-coherent-serre-duality`, graded-resolution proof, standard
graded Nakayama argument expanded in the blueprint (blueprint:
lem-sc-p1-graded-nakayama-generation).
-/

@[expose] public section

universe u v

namespace MvPolynomial

/-- Homogeneous lifts of vector-space generators modulo `(x₀,x₁)` generate a finite graded module.
Source: blueprint `theorem-riemann-roch-coherent-serre-duality`, graded-resolution proof; the
following standard minimal-degree argument is the blueprint's expansion, not an explicit proof in
the blueprint. (blueprint: lem-sc-p1-graded-nakayama-generation)

Proof: let `Q` be the graded submodule generated by the given homogeneous elements and set
`M = N/Q`. Generation modulo the irrelevant ideal implies `M = (x₀,x₁)M`.
By `lem-sc-p1-finite-homogeneous-generators`, `M` has finitely many homogeneous generators;
the smallest generator degree bounds all nonzero homogeneous degrees below, since the ring
has only nonnegative degrees. If `M` is nonzero, choose a nonzero homogeneous element `y` of
minimal degree `e`. Write `y = x₀a + x₁b` and take the degree `e-1` components of `a` and `b`.
At least one is nonzero, contradicting minimality. Hence `M = 0`, so `Q = N`. -/
theorem graded_nakayama_generation {k : Type u} [Field k]
    {N : Type v} [AddCommGroup N] [Module (MvPolynomial (Fin 2) k) N]
    [Module k N] [IsScalarTower k (MvPolynomial (Fin 2) k) N]
    [Module.Finite (MvPolynomial (Fin 2) k) N]
    (ℳ : ℤ → AddSubgroup N) (hℳ : DirectSum.IsInternal ℳ)
    (hsmul : ∀ (d : ℕ) (j : ℤ) (f : MvPolynomial (Fin 2) k) (x : N),
      f ∈ homogeneousSubmodule (Fin 2) k d → x ∈ ℳ j → f • x ∈ ℳ ((d : ℤ) + j))
    (r : ℕ) (n : Fin r → N) (hn : ∀ i : Fin r, SetLike.IsHomogeneousElem ℳ (n i))
    (hgen : Submodule.span k (Set.range (fun i : Fin r ↦
      (Ideal.span (Set.range (X : Fin 2 → MvPolynomial (Fin 2) k)) •
        (⊤ : Submodule (MvPolynomial (Fin 2) k) N)).mkQ (n i))) = ⊤) :
    Submodule.span (MvPolynomial (Fin 2) k) (Set.range n) = ⊤ := by
  classical
  let : DirectSum.Decomposition ℳ := hℳ.chooseDecomposition
  let Q := Submodule.span (MvPolynomial (Fin 2) k) (Set.range n)
  obtain ⟨B, hB⟩ := exists_graded_module_lower_bound ℳ hℳ hsmul
  have hdegrees (a : ℕ) : ∀ (j : ℤ) (x : N), j < B + a → x ∈ ℳ j → x ∈ Q := by
    induction a with
    | zero =>
      intro j x hj hx
      have hzero := hB j x (by simpa using hj) hx
      rw [hzero]
      exact Q.zero_mem
    | succ a ih =>
      intro j x hj hx
      obtain ⟨q, hq, y, hy, z, hz, hxyz⟩ :=
        homogeneous_decomposition_of_quotient_span ℳ hℳ hsmul r n hn hgen j x hx
      rw [hxyz]
      exact Q.add_mem (Q.add_mem hq (Q.smul_mem _ (ih (j - 1) y (by omega) hy)))
        (Q.smul_mem _ (ih (j - 1) z (by omega) hz))
  apply top_unique
  intro x _
  apply DirectSum.Decomposition.inductionOn (ℳ := ℳ)
    (motive := fun x ↦ x ∈ Q) Q.zero_mem ?_ (fun _ _ ↦ Q.add_mem) x
  intro j y
  exact hdegrees ((j - B).toNat + 1) j y (by omega) y.property

/-- A finite graded module with zero quotient modulo `(x₀,x₁)` is zero.
Source: blueprint `theorem-riemann-roch-coherent-serre-duality`, graded-resolution proof, graded
Nakayama. (blueprint: lem-sc-p1-graded-nakayama-generation)

Proof: take the empty family in the generation criterion. Its images span the zero quotient,
so its span is the whole module. The span of the empty family is zero, hence the module is zero.
Equivalently, the same finite homogeneous generator lower bound and minimal-degree
contradiction used above apply directly to `N = (x₀,x₁)N`. -/
theorem subsingleton_of_graded_quotient_subsingleton {k : Type u} [Field k]
    {N : Type v} [AddCommGroup N] [Module (MvPolynomial (Fin 2) k) N]
    [Module.Finite (MvPolynomial (Fin 2) k) N]
    (ℳ : ℤ → AddSubgroup N) (hℳ : DirectSum.IsInternal ℳ)
    (hsmul : ∀ (d : ℕ) (j : ℤ) (f : MvPolynomial (Fin 2) k) (x : N),
      f ∈ homogeneousSubmodule (Fin 2) k d → x ∈ ℳ j → f • x ∈ ℳ ((d : ℤ) + j))
    (hzero : Subsingleton (N ⧸
      (Ideal.span (Set.range (X : Fin 2 → MvPolynomial (Fin 2) k)) •
        (⊤ : Submodule (MvPolynomial (Fin 2) k) N)))) : Subsingleton N := by
  let : Module k N := Module.compHom N (algebraMap k (MvPolynomial (Fin 2) k))
  let : IsScalarTower k (MvPolynomial (Fin 2) k) N :=
    IsScalarTower.of_compHom k (MvPolynomial (Fin 2) k) N
  have : Subsingleton (N ⧸
      (Ideal.span (Set.range (X : Fin 2 → MvPolynomial (Fin 2) k)) •
        (⊤ : Submodule (MvPolynomial (Fin 2) k) N))) := hzero
  have hspan := graded_nakayama_generation ℳ hℳ hsmul 0
    (fun i : Fin 0 ↦ Fin.elim0 i) (fun i ↦ Fin.elim0 i) (by
      apply Subsingleton.elim)
  have hbot : (⊥ : Submodule (MvPolynomial (Fin 2) k) N) = ⊤ := by
    simpa using hspan
  refine ⟨fun x y ↦ ?_⟩
  have hx : x = 0 := by
    have : x ∈ (⊥ : Submodule (MvPolynomial (Fin 2) k) N) := by
      rw [hbot]
      trivial
    simpa using this
  have hy : y = 0 := by
    have : y ∈ (⊥ : Submodule (MvPolynomial (Fin 2) k) N) := by
      rw [hbot]
      trivial
    simpa using this
  exact hx.trans hy.symm

end MvPolynomial
