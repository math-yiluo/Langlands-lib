import Langlands.ClassFieldTheory.Local.LocalFieldOrder
import Langlands.Galois.Local.AbsoluteDefinitions
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.LinearAlgebra.Dimension.Localization
import Mathlib.RingTheory.LocalRing.Length
import Mathlib.RingTheory.LocalRing.Quotient

noncomputable section

open IsLocalRing ValuativeRel
open scoped WithZero

namespace Langlands.ClassFieldTheory.Local

universe u v

variable (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- The order-one element viewed in the actual integer ring. -/
def localIntegerUniformizer : 𝒪[K] :=
  ⟨localUniformizer K, ((valuation K).vle_one_iff).mp
    ((normalizedUnitOrder_nonneg_iff K (localUniformizer K)).mp (by simp))⟩

theorem span_localIntegerUniformizer :
    Ideal.span {localIntegerUniformizer K} = 𝓂[K] := by
  have hp : discreteLocalValuation K (localUniformizer K : K) = WithZero.exp (-1 : ℤ) := by
    rw [discreteLocalValuation_of_unit, normalizedUnitOrder_localUniformizer]
  ext x
  rw [Ideal.mem_span_singleton, ← (Valuation.integer.integers (valuation K)).le_iff_dvd,
    IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    Valuation.Integer.not_isUnit_iff_valuation_lt_one]
  change valuation K x.val ≤ valuation K (localUniformizer K : K) ↔ valuation K x.val < 1
  let e := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt K
  rw [← map_le_map_iff e, ← map_lt_map_iff e, map_one]
  change discreteLocalValuation K x.val ≤ discreteLocalValuation K (localUniformizer K : K) ↔
    discreteLocalValuation K x.val < 1
  rw [hp]
  by_cases hx : x.val = 0
  · simp [hx]
  · let a := Units.mk0 x.val hx
    change discreteLocalValuation K (a : K) ≤ WithZero.exp (-1 : ℤ) ↔
      discreteLocalValuation K (a : K) < 1
    rw [discreteLocalValuation_of_unit, WithZero.exp_le_exp, WithZero.exp_lt_one_iff]
    omega

section Extension

variable (L : Type v) [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]

/-- The map of the supplied valuation rings induced by the field embedding. -/
def localIntegerMap : 𝒪[K] →+* 𝒪[L] :=
  (algebraMap K L).restrict (valuation K).integer (valuation L).integer (by
    intro x hx
    change valuation L (algebraMap K L x) ≤ 1
    rw [← (valuation L).vle_one_iff, ← map_one (algebraMap K L),
      ValuativeExtension.vle_iff_vle, (valuation K).vle_one_iff]
    exact hx)

scoped instance localIntegerAlgebra : Algebra (𝒪[K]) (𝒪[L]) :=
  (localIntegerMap K L).toAlgebra

scoped instance localIntegerFieldAlgebra : Algebra (𝒪[K]) L :=
  Algebra.compHom L (algebraMap (𝒪[K]) K)

scoped instance localIntegerBaseTower : IsScalarTower (𝒪[K]) K L :=
  .of_algebraMap_eq fun _ => rfl

scoped instance localIntegerExtensionTower : IsScalarTower (𝒪[K]) (𝒪[L]) L :=
  .of_algebraMap_eq fun _ => rfl

omit [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [TopologicalSpace L] [IsNonarchimedeanLocalField L] in
theorem localIntegerMap_coe (a : 𝒪[K]) :
    (algebraMap (𝒪[K]) (𝒪[L]) a : L) = algebraMap K L (a : K) := rfl

scoped instance localIntegerAlgebra_isLocalHom :
    IsLocalHom (algebraMap (𝒪[K]) (𝒪[L])) where
  map_nonunit a ha := by
    rw [(Valuation.integer.integers (valuation L)).isUnit_iff_valuation_eq_one] at ha
    rw [(Valuation.integer.integers (valuation K)).isUnit_iff_valuation_eq_one]
    have h := ValuativeExtension.mapValueGroupWithZero_valuation (A := K) (B := L) (a : K)
    change valuation L (algebraMap K L (a : K)) = 1 at ha
    rw [ha, ← map_one (ValuativeExtension.mapValueGroupWithZero K L)] at h
    exact ValuativeExtension.mapValueGroupWithZero_strictMono.injective h

scoped instance localIntegerAlgebra_isTorsionFree :
    Module.IsTorsionFree (𝒪[K]) (𝒪[L]) :=
  Module.isTorsionFree_iff_algebraMap_injective.mpr fun _ _ h =>
    Subtype.ext ((algebraMap K L).injective (congrArg Subtype.val h))

/-- The residue degree is the dimension of the actual finite residue extension. -/
abbrev localResidueDegree : ℕ :=
  Module.finrank (𝓀[K]) (𝓀[L])

/-- The upper residue cardinality is the lower cardinality to the residue degree. -/
theorem localResidue_card :
    Nat.card (𝓀[L]) = Nat.card (𝓀[K]) ^ localResidueDegree K L :=
  @Module.natCard_eq_pow_finrank (𝓀[K]) (𝓀[L]) _ _ _ _

/-- The ideal generated by the base maximal ideal in the extension is the
power specified by the normalized order of a base uniformizer. -/
theorem map_maximalIdeal_eq_localRamificationFactor :
    Ideal.map (algebraMap (𝒪[K]) (𝒪[L])) (𝓂[K]) = 𝓂[L] ^ localRamificationFactor K L := by
  rw [← span_localIntegerUniformizer K, ← span_localIntegerUniformizer L, Ideal.map_span,
    Set.image_singleton, Ideal.span_singleton_pow]
  have hval : discreteLocalValuation L
      (algebraMap (𝒪[K]) (𝒪[L]) (localIntegerUniformizer K) : L) =
        discreteLocalValuation L ((localIntegerUniformizer L ^ localRamificationFactor K L :
          𝒪[L]) : L) := by
    change discreteLocalValuation L ((Units.map (algebraMap K L) (localUniformizer K) : Lˣ) : L) =
      discreteLocalValuation L ((localUniformizer L ^ localRamificationFactor K L : Lˣ) : L)
    rw [discreteLocalValuation_of_unit, discreteLocalValuation_of_unit,
      normalizedUnitOrder_map_uniformizer]
    change _ = WithZero.exp (-normalizedUnitOrder L
      (localRamificationFactor K L • Additive.ofMul (localUniformizer L)))
    simp
  have heq : valuation L _ = valuation L _ :=
    (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt L).injective hval
  apply le_antisymm <;> rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton,
    ← (Valuation.integer.integers (valuation L)).le_iff_dvd]
  · exact heq.le
  · exact heq.ge

variable [FiniteDimensional K L]

/-- A compatible finite extension is finite on the supplied integer rings,
including inseparable finite extensions. -/
theorem localIntegerAlgebra_finite (hcont : Continuous (algebraMap K L)) :
    Module.Finite (𝒪[K]) (𝒪[L]) := by
  let := LocalGalois.localNormedField K
  let := LocalGalois.localNormedField L
  let := LocalGalois.localNormedField_complete K
  let : ContinuousSMul K L := ⟨by
    simp only [Algebra.smul_def]
    exact (hcont.comp continuous_fst).mul continuous_snd⟩
  let b := Module.finBasis K L
  have hb := (isCompact_univ.image
    (b.equivFun.toLinearMap.continuous_of_finiteDimensional.comp
      (continuous_subtype_val : Continuous (Subtype.val : 𝒪[L] → L)))).isBounded
  obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.mp hb
  obtain ⟨c, hc⟩ := NormedField.exists_lt_norm K (max C 0)
  have hcpos : 0 < ‖c‖ := (le_max_right C 0).trans_lt hc
  have hc0 : c ≠ 0 := norm_pos_iff.mp hcpos
  have hcoord (x : 𝒪[L]) (i : Fin (Module.finrank K L)) :
      valuation K (b.equivFun x.val i / c) ≤ 1 := by
    have hx : ‖b.equivFun x.val‖ ≤ C := hC _ ⟨x, Set.mem_univ _, rfl⟩
    have hxi : ‖b.equivFun x.val i‖ ≤ C := (norm_le_pi_norm _ i).trans hx
    have hn : ‖b.equivFun x.val i / c‖ ≤ ‖(1 : K)‖ := by
      rw [norm_div, norm_one]
      exact (div_le_one hcpos).mpr (hxi.trans ((le_max_left C 0).trans hc.le))
    simpa only [map_one] using (LocalGalois.localNormedField_le K _ 1).mp hn
  let f : 𝒪[L] →ₗ[𝒪[K]] (Fin (Module.finrank K L) → 𝒪[K]) :=
    { toFun := fun x i => ⟨b.equivFun x.val i / c, hcoord x i⟩
      map_add' := by
        intro x y
        funext i
        apply Subtype.ext
        change b.equivFun (x.val + y.val) i / c =
          b.equivFun x.val i / c + b.equivFun y.val i / c
        simp only [map_add, Pi.add_apply, add_div]
      map_smul' := by
        intro a x
        funext i
        apply Subtype.ext
        simp only [RingHom.id_apply, Pi.smul_apply, Algebra.smul_def]
        change b.equivFun (algebraMap K L (a : K) * x.val) i / c =
          (a : K) * (b.equivFun x.val i / c)
        rw [← Algebra.smul_def]
        simp only [map_smul, Pi.smul_apply, smul_eq_mul, mul_div_assoc] }
  apply Module.Finite.of_injective f
  intro x y h
  apply Subtype.ext
  apply b.equivFun.injective
  funext i
  have hi := congrArg (fun z : Fin (Module.finrank K L) → 𝒪[K] => (z i : K)) h
  exact (div_left_inj' hc0).mp hi

set_option quotPrecheck false in
local notation "baseQuotient" => ((𝒪[K]) ⧸ 𝓂[K])
set_option quotPrecheck false in
local notation "extendedIdeal" => Ideal.map (algebraMap (𝒪[K]) (𝒪[L])) (𝓂[K])
set_option quotPrecheck false in
local notation "upperQuotient" => ((𝒪[L]) ⧸ extendedIdeal)

/-- The degree formula for any finite extension of compatible local fields. -/
theorem localRamificationFactor_mul_residueDegree
    (hcont : Continuous (algebraMap K L)) :
    localRamificationFactor K L * localResidueDegree K L = Module.finrank K L := by
  let := localIntegerAlgebra_finite K L hcont
  let : IsFractionRing (𝒪[K]) K := (Valuation.integer.integers (valuation K)).isFractionRing
  let : IsFractionRing (𝒪[L]) L := (Valuation.integer.integers (valuation L)).isFractionRing
  let : Field baseQuotient := Ideal.Quotient.field (𝓂[K])
  have hS : Module.length (𝒪[L]) upperQuotient = localRamificationFactor K L := by
    exact (congrArg (fun J : Ideal (𝒪[L]) => Module.length (𝒪[L]) ((𝒪[L]) ⧸ J))
      (map_maximalIdeal_eq_localRamificationFactor K L)).trans
        (IsDiscreteValuationRing.length_quotient_pow_maximalIdeal _ _)
  have hR : Module.length (𝒪[K]) upperQuotient = Module.finrank K L := by
    let : Module.Finite baseQuotient upperQuotient :=
      Module.Finite.of_restrictScalars_finite (𝒪[K]) _ _
    have hdim : Module.finrank baseQuotient upperQuotient = Module.finrank (𝒪[K]) (𝒪[L]) :=
      finrank_quotient_map
    rw [Module.length_eq_of_surjective (R := baseQuotient)
      (Ideal.Quotient.mk_surjective (I := 𝓂[K])),
      Module.length_eq_finrank, hdim, ← IsFractionRing.finrank_eq (𝒪[K]) K (𝒪[L]) L]
  have h := IsLocalRing.length_restrictScalars (𝒪[K]) (𝒪[L]) upperQuotient
  rw [hR, hS, Module.length_eq_finrank] at h
  exact_mod_cast h.symm

end Extension

end Langlands.ClassFieldTheory.Local
