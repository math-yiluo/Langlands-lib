import Langlands.ClassFieldTheory.Local.KummerNormSymmetry
import Mathlib.FieldTheory.Galois.Abelian
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure

/-! # Actual radical intermediate fields and their norm symmetry -/

noncomputable section

namespace Langlands.ClassFieldTheory.Local.KummerNorm

universe u

open Polynomial

variable (K : Type u) [Field K]

/-- The actual intermediate field generated by all roots of `X^n-a`. -/
def radicalField (n : ℕ) (a : K) : IntermediateField K (AlgebraicClosure K) :=
  IntermediateField.adjoin K ((X ^ n - C a).rootSet (AlgebraicClosure K))

instance radicalField_splitting (n : ℕ) (a : K) :
    IsSplittingField K (radicalField K n a) (X ^ n - C a) :=
  IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

instance radicalField_finiteDimensional (n : ℕ) (a : K) :
    FiniteDimensional K (radicalField K n a) :=
  IsSplittingField.finiteDimensional (radicalField K n a) (X ^ n - C a)

variable {K} {n : ℕ} [NeZero n] {a : K}

/-- Irreducible radical fields over a base containing a primitive root are abelian. -/
theorem radicalField_isAbelianGalois (H : Irreducible (X ^ n - C a))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) : IsAbelianGalois K (radicalField K n a) := by
  have hroots : (primitiveRoots n K).Nonempty :=
    ⟨ζ, (mem_primitiveRoots (NeZero.pos n)).mpr hζ⟩
  let := isGalois_of_isSplittingField_X_pow_sub_C hroots H (radicalField K n a)
  let := isCyclic_of_isSplittingField_X_pow_sub_C hroots H (radicalField K n a)
  exact IsAbelianGalois.of_isCyclic K (radicalField K n a)

theorem radicalField_finrank (H : Irreducible (X ^ n - C a))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) : Module.finrank K (radicalField K n a) = n :=
  finrank_of_isSplittingField_X_pow_sub_C
    ⟨ζ, (mem_primitiveRoots (NeZero.pos n)).mpr hζ⟩ H (radicalField K n a)

/-- A chosen root of a base unit is a unit of its actual radical field. -/
def radicalUnit (a : Kˣ) : (radicalField K n (a : K))ˣ := by
  let r := rootOfSplitsXPowSubC (NeZero.pos n) (a : K) (radicalField K n (a : K))
  have hr : r ^ n = algebraMap K (radicalField K n (a : K)) (a : K) :=
    rootOfSplitsXPowSubC_pow (a : K) (radicalField K n (a : K))
  refine Units.mk0 r ?_
  intro hzero
  have hnonzero : algebraMap K (radicalField K n (a : K)) (a : K) ≠ 0 :=
    (_root_.map_ne_zero (algebraMap K (radicalField K n (a : K)))).mpr (Units.ne_zero a)
  apply hnonzero
  rw [← hr, hzero, zero_pow (NeZero.ne n)]

theorem radicalUnit_pow (a : Kˣ) :
    radicalUnit (n := n) a ^ n =
      Units.map (algebraMap K (radicalField K n (a : K))).toMonoidHom a := by
  apply Units.ext
  exact rootOfSplitsXPowSubC_pow (a : K) (radicalField K n (a : K))

/-- Norm symmetry for the actual two radical intermediate fields. -/
theorem radicalField_norm_iff (a b ζ : Kˣ)
    (Ha : Irreducible (X ^ n - C (a : K)))
    (Hb : Irreducible (X ^ n - C (b : K)))
    (hζ : IsPrimitiveRoot (ζ : K) n) :
    b ∈ Langlands.LocalClassField.normSubgroup K (radicalField K n (a : K)) ↔
      a ∈ Langlands.LocalClassField.normSubgroup K (radicalField K n (b : K)) := by
  let L := radicalField K n (a : K)
  let R := radicalField K n (b : K)
  let M := L ⊔ R
  let : IsAbelianGalois K L := radicalField_isAbelianGalois Ha hζ
  let : IsAbelianGalois K R := radicalField_isAbelianGalois Hb hζ
  let : Algebra L M := (IntermediateField.inclusion (show L ≤ M from le_sup_left)).toRingHom.toAlgebra
  let : Algebra R M := (IntermediateField.inclusion (show R ≤ M from le_sup_right)).toRingHom.toAlgebra
  have : IsScalarTower K L M := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower K R M := IsScalarTower.of_algebraMap_eq' rfl
  exact norm_iff_of_irreducible_radicals K L R M a b ζ Ha Hb hζ
    (radicalUnit a) (radicalUnit b) (radicalUnit_pow a) (radicalUnit_pow b)

end Langlands.ClassFieldTheory.Local.KummerNorm
