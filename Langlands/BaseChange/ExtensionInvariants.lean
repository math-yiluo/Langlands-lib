import Langlands.Representation.Whittaker.Iwasawa
import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.RingTheory.Trace.Basic

/-!
# Residue degree and different exponent

Characterizations using the actual valuation rings and the trace codifferent.
-/

noncomputable section

namespace Langlands.BaseChange

universe u v

/-- The residue cardinalities satisfy `q_E = q_F ^ f`. -/
def IsResidueDegree (F : Type u) [Field F] [ValuativeRel F]
    (E : Type v) [Field E] [ValuativeRel E] (f : ℕ) : Prop :=
  Nat.card (IsLocalRing.ResidueField (ValuativeRel.valuation E).integer) =
    Nat.card (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) ^ f

/-- The trace codifferent is generated by the inverse `d`-th power of a uniformizer. -/
def IsDifferentExponent (F : Type u) [Field F] [ValuativeRel F]
    (E : Type v) [Field E] [ValuativeRel E] [Algebra F E] (d : ℕ) : Prop :=
  ∃ ϖ : Eˣ,
    GeneralLinear.Iwasawa.IsUniformizingElement (ValuativeRel.valuation E) ϖ ∧
      ∀ x : E,
        (∀ y ∈ (ValuativeRel.valuation E).integer,
          Algebra.trace F E (x * y) ∈ (ValuativeRel.valuation F).integer) ↔
            x * (ϖ : E) ^ d ∈ (ValuativeRel.valuation E).integer

variable {F : Type u} [Field F] [ValuativeRel F]
variable {E : Type v} [Field E] [ValuativeRel E]

/-- Over a local base field the residue-cardinality characterization is unique. -/
theorem IsResidueDegree.unique [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {f f' : ℕ} (h : IsResidueDegree F E f) (h' : IsResidueDegree F E f') : f = f' := by
  have hq : 1 < Nat.card (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) :=
    Finite.one_lt_card
  exact Nat.pow_right_injective hq (h.symm.trans h')

/-- A field has residue degree one over itself. -/
theorem isResidueDegree_self : IsResidueDegree F F 1 := by
  simp [IsResidueDegree]

private theorem uniformizer_valuation_eq {ϖ ψ : Eˣ}
    (hϖ : GeneralLinear.Iwasawa.IsUniformizingElement (ValuativeRel.valuation E) ϖ)
    (hψ : GeneralLinear.Iwasawa.IsUniformizingElement (ValuativeRel.valuation E) ψ) :
    ValuativeRel.valuation E (ϖ : E) = ValuativeRel.valuation E (ψ : E) := by
  have bound (a b : Eˣ)
      (ha : GeneralLinear.Iwasawa.IsUniformizingElement (ValuativeRel.valuation E) a)
      (hb : GeneralLinear.Iwasawa.IsUniformizingElement (ValuativeRel.valuation E) b) :
      ValuativeRel.valuation E (b : E) ≤ ValuativeRel.valuation E (a : E) := by
    obtain ⟨m, hm⟩ := ha.2 (b : E) b.ne_zero
    have ha0 := GeneralLinear.Iwasawa.valuation_pos (ValuativeRel.valuation E) a
    have hmpos : 0 < m :=
      (zpow_lt_one_iff_right_of_lt_one₀ ha0 ha.1).mp (hm ▸ hb.1)
    calc
      ValuativeRel.valuation E (b : E) = ValuativeRel.valuation E (a : E) ^ m := hm
      _ ≤ ValuativeRel.valuation E (a : E) ^ (1 : ℤ) :=
        (zpow_right_strictAnti₀ ha0 ha.1).antitone (by omega)
      _ = ValuativeRel.valuation E (a : E) := zpow_one _
  exact le_antisymm (bound ψ ϖ hψ hϖ) (bound ϖ ψ hϖ hψ)

/-- The trace-codifferent characterization determines the different exponent uniquely. -/
theorem IsDifferentExponent.unique [Algebra F E] {d d' : ℕ}
    (h : IsDifferentExponent F E d) (h' : IsDifferentExponent F E d') : d = d' := by
  obtain ⟨ϖ, hϖ, hd⟩ := h
  obtain ⟨ψ, hψ, hd'⟩ := h'
  have hv := uniformizer_valuation_eq hϖ hψ
  have bound (a b : ℕ) (ϖ ψ : Eˣ)
      (hϖ : GeneralLinear.Iwasawa.IsUniformizingElement (ValuativeRel.valuation E) ϖ)
      (hv : ValuativeRel.valuation E (ϖ : E) = ValuativeRel.valuation E (ψ : E))
      (hmem : ∀ x : E,
        x * (ϖ : E) ^ a ∈ (ValuativeRel.valuation E).integer ↔
          x * (ψ : E) ^ b ∈ (ValuativeRel.valuation E).integer) : a ≤ b := by
    have ha0 := GeneralLinear.Iwasawa.valuation_pos (ValuativeRel.valuation E) ϖ
    have hx : ((ϖ : E) ^ a)⁻¹ * (ϖ : E) ^ a ∈ (ValuativeRel.valuation E).integer := by
      simp [pow_ne_zero a ϖ.ne_zero]
    have hy := (hmem (((ϖ : E) ^ a)⁻¹)).mp hx
    rw [Valuation.mem_integer_iff, map_mul, map_inv₀, map_pow, map_pow, ← hv] at hy
    exact (pow_le_pow_iff_right_of_lt_one₀ ha0 hϖ.1).mp
      ((inv_mul_le_one₀ (pow_pos ha0 a)).mp hy)
  apply Nat.le_antisymm
  · exact bound d d' ϖ ψ hϖ hv (fun x => (hd x).symm.trans (hd' x))
  · exact bound d' d ψ ϖ hψ hv.symm (fun x => (hd' x).symm.trans (hd x))

end Langlands.BaseChange
