import Langlands.BaseChange.CuspidalSigmaLift
import Langlands.BaseChange.TwistedCharacter
import Langlands.Representation.Classification.Supercuspidal
import Langlands.Group.GL.LocalFieldTopology

/-!
# The σ-lift of a supercuspidal representation: structure

Henniart–Lemaire (2011), II.4.12, Proposition (printed p. 96); Arthur–Clozel (1989),
Chapter 1, Lemma 6.10 (printed p. 62) in prime degree. See the paired Markdown.
-/

namespace Langlands.BaseChange

universe u v uV uW

/-- Henniart–Lemaire, II.4.12, Proposition: let `F` be a nonarchimedean local field of
characteristic zero, `E` a cyclic extension with generator `σ` of `Gal(E/F)` of order `l`,
`π` an irreducible supercuspidal representation of `GL_n(F)` and `Π` a σ-lift of `π`. Let
`s` be the order of the stabilizer of the class of `π` in `K(E/F)`. Then `s ∣ l`,
`n = s n₁`, and `Π ≅ Π₁ × Π₁^σ × ⋯ × Π₁^{σ^{s-1}}` for an irreducible supercuspidal `Π₁` of
`GL_{n₁}(E)` whose stabilizer in `⟨σ⟩` is generated by `σ^s`. -/
def CuspidalSigmaLiftStructureStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (E : Type v) [Field E] [ValuativeRel E] [TopologicalSpace E]
    [IsNonarchimedeanLocalField E] [Algebra F E] [IsModuleTopology F E]
    (σ : E ≃ₐ[F] E) (l n : ℕ), IsCyclicAlgebra σ l → 0 < n →
    ∀ (V : Type uV) [AddCommGroup V] [Module ℂ V]
      (π : Representation ℂ (GeneralLinear n F) V) (hπ : IsAdmissible π),
      GeneralLinear.IsSupercuspidal π → π.IsIrreducible →
    ∀ (W : Type uW) [AddCommGroup W] [Module ℂ W]
      (P : Representation ℂ (GeneralLinear n E) W) (hP : IsAdmissible P),
      P.IsIrreducible →
    ∀ (A : SigmaIntertwiner σ n P) (c : ℂ),
      (haveI := LocalFieldTopology.generalLinear_t2Space F n
       haveI := LocalFieldTopology.generalLinear_locallyCompactSpace F n
       haveI := LocalFieldTopology.generalLinear_totallyDisconnectedSpace F n
       haveI := LocalFieldTopology.generalLinear_t2Space E n
       haveI := LocalFieldTopology.generalLinear_locallyCompactSpace E n
       haveI := LocalFieldTopology.generalLinear_totallyDisconnectedSpace E n
       IsSigmaLift σ l π hπ P hP A c) →
      Nat.card (normTwistStabilizer E π) ∣ l ∧
      ∃ (n₁ : ℕ) (hn₁ : 0 < n₁) (h : Nat.card (normTwistStabilizer E π) * n₁ = n)
        (W₁ : Type uW) (_ : AddCommGroup W₁) (_ : Module ℂ W₁)
        (P₁ : Representation ℂ (GeneralLinear n₁ E) W₁),
        GeneralLinear.IsSupercuspidal P₁ ∧ P₁.IsIrreducible ∧
        (∀ i : ℕ, Nonempty (P₁.Equiv (P₁.comp (entrywiseAut (σ ^ i) n₁).toMonoidHom)) ↔
          Nat.card (normTwistStabilizer E π) ∣ i) ∧
        Nonempty (P.Equiv
          ((sigmaOrbitProduct σ (Nat.card (normTwistStabilizer E π)) hn₁ P₁).comp
            (GeneralLinear.reindex (R := E) (finCongr h)).symm.toMonoidHom))

end Langlands.BaseChange
