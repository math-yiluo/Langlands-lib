import Langlands.BaseChange.CuspidalSigmaLift
import Langlands.BaseChange.TwistedCharacter
import Langlands.Representation.Classification.Supercuspidal
import Langlands.Group.GL.LocalFieldTopology

/-!
# The σ-lift of a supercuspidal representation: existence of the converse

Henniart–Lemaire (2011), II.4.12, Remarque (printed p. 97), in the case `a = 1`, with the
Corollaire of II.4.12 (printed p. 96). See the paired Markdown.
-/

namespace Langlands.BaseChange

universe u v uV uW

/-- Henniart–Lemaire, II.4.12, Remarque (case `a = 1`): let `F` be a nonarchimedean local
field of characteristic zero, `E` a cyclic extension with generator `σ` of `Gal(E/F)` of
order `l`, and `Π₁` an irreducible supercuspidal representation of `GL_{n₁}(E)` whose
stabilizer in `⟨σ⟩` is generated by `σ^s`. Then `Π = Π₁ × Π₁^σ × ⋯ × Π₁^{σ^{s-1}}` is
irreducible, admissible, and a σ-lift of an irreducible supercuspidal representation `π` of
`GL_{s n₁}(F)` whose stabilizer in `K(E/F)` has `s` elements. -/
def CuspidalSigmaLiftExistenceStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (E : Type v) [Field E] [ValuativeRel E] [TopologicalSpace E]
    [IsNonarchimedeanLocalField E] [Algebra F E] [IsModuleTopology F E]
    (σ : E ≃ₐ[F] E) (l : ℕ), IsCyclicAlgebra σ l →
    ∀ (s n₁ : ℕ) (hn₁ : 0 < n₁) (W : Type uW) [AddCommGroup W] [Module ℂ W]
      (P₁ : Representation ℂ (GeneralLinear n₁ E) W),
      GeneralLinear.IsSupercuspidal P₁ → P₁.IsIrreducible →
      (∀ i : ℕ, Nonempty (P₁.Equiv (P₁.comp (entrywiseAut (σ ^ i) n₁).toMonoidHom)) ↔
        s ∣ i) →
      (sigmaOrbitProduct σ s hn₁ P₁).IsIrreducible ∧
      ∃ (hP : IsAdmissible (sigmaOrbitProduct σ s hn₁ P₁))
        (V : Type uV) (_ : AddCommGroup V) (_ : Module ℂ V)
        (π : Representation ℂ (GeneralLinear (s * n₁) F) V) (hπ : IsAdmissible π)
        (A : SigmaIntertwiner σ (s * n₁) (sigmaOrbitProduct σ s hn₁ P₁)) (c : ℂ),
        GeneralLinear.IsSupercuspidal π ∧ π.IsIrreducible ∧
        Nat.card (normTwistStabilizer E π) = s ∧
        (haveI := LocalFieldTopology.generalLinear_t2Space F (s * n₁)
         haveI := LocalFieldTopology.generalLinear_locallyCompactSpace F (s * n₁)
         haveI := LocalFieldTopology.generalLinear_totallyDisconnectedSpace F (s * n₁)
         haveI := LocalFieldTopology.generalLinear_t2Space E (s * n₁)
         haveI := LocalFieldTopology.generalLinear_locallyCompactSpace E (s * n₁)
         haveI := LocalFieldTopology.generalLinear_totallyDisconnectedSpace E (s * n₁)
         IsSigmaLift σ l π hπ (sigmaOrbitProduct σ s hn₁ P₁) hP A c)

end Langlands.BaseChange
