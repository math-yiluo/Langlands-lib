import Mathlib.Analysis.Normed.Field.Krasner
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.SeparableClosure
import Mathlib.FieldTheory.IsSepClosed
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.Normal.Basic
import Mathlib.Topology.Bases
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# Countably many Galois extensions suffice

A field `K` has a countable Galois family if there are countably many finite Galois extensions
`L_i/K` such that every finite separable extension of `K` embeds into one of them. This holds
in two cases:

* every irreducible polynomial over `K` has degree at most two and `K` has characteristic
  zero (for instance `ℝ` and `ℂ`): then the algebraic closure of `K` is finite over `K`;
* `K` is a complete non-archimedean field with a countable dense subset: by Krasner's lemma,
  every finite separable extension is generated by a root of a monic polynomial with
  coefficients in the dense subset.
-/

noncomputable section

universe u

open Polynomial IntermediateField
open scoped NNReal

namespace Langlands.FieldTheory.CountableGaloisFamily

/-- Countably many finite Galois extensions receive every finite separable extension. -/
def HasCountableGaloisFamily (K : Type u) [Field K] : Prop :=
  ∃ (ι : Type u) (_ : Countable ι) (L : ι → Type u) (_ : ∀ i, Field (L i))
    (_ : ∀ i, Algebra K (L i)), (∀ i, FiniteDimensional K (L i) ∧ IsGalois K (L i)) ∧
    ∀ (E : Type u) [Field E] [Algebra K E] [FiniteDimensional K E] [Algebra.IsSeparable K E],
      ∃ i, Nonempty (E →ₐ[K] L i)

section Quadratic

variable {K : Type u} [Field K] [CharZero K]

/-- If every irreducible polynomial has degree at most two, the algebraic closure is finite. -/
theorem finiteDimensional_algebraicClosure
    (h : ∀ p : K[X], Irreducible p → p.natDegree ≤ 2) :
    FiniteDimensional K (AlgebraicClosure K) := by
  classical
  let Ω := AlgebraicClosure K
  have hint : ∀ x : Ω, IsIntegral K x := fun x => Algebra.IsIntegral.isIntegral x
  have hdeg : ∀ x : Ω, Module.finrank K K⟮x⟯ ≤ 2 := fun x => by
    rw [IntermediateField.adjoin.finrank (hint x)]
    exact h _ (minpoly.irreducible (hint x))
  obtain ⟨α, hα⟩ : ∃ α : Ω, ∀ x : Ω, Module.finrank K K⟮x⟯ ≤ Module.finrank K K⟮α⟯ := by
    by_cases h2 : ∃ α : Ω, Module.finrank K K⟮α⟯ = 2
    · obtain ⟨α, hα⟩ := h2
      exact ⟨α, fun x => hα ▸ hdeg x⟩
    · refine ⟨0, fun x => ?_⟩
      rw [IntermediateField.adjoin_zero, IntermediateField.finrank_bot]
      have := hdeg x
      have : FiniteDimensional K K⟮x⟯ := IntermediateField.adjoin.finiteDimensional (hint x)
      have h0 : 0 < Module.finrank K K⟮x⟯ := Module.finrank_pos
      push Not at h2
      have := h2 x
      omega
  have htop : K⟮α⟯ = ⊤ := by
    refine eq_top_iff.mpr fun β _ => ?_
    let E' : IntermediateField K Ω := IntermediateField.adjoin K {α, β}
    have : FiniteDimensional K E' := IntermediateField.finiteDimensional_adjoin fun x _ => hint x
    obtain ⟨θ, hθ⟩ := Field.exists_primitive_element K E'
    have hθint : IsIntegral K θ := .of_finite K θ
    have hfin : Module.finrank K E' ≤ Module.finrank K K⟮α⟯ := by
      have e1 : Module.finrank K E' = (minpoly K θ).natDegree := by
        rw [← IntermediateField.adjoin.finrank hθint, hθ, IntermediateField.finrank_top']
      have e2 : minpoly K (θ : Ω) = minpoly K θ := minpoly.algHom_eq E'.val E'.val.injective θ
      rw [e1, ← e2, ← IntermediateField.adjoin.finrank (hint _)]
      exact hα _
    have hle : K⟮α⟯ ≤ E' :=
      IntermediateField.adjoin_simple_le_iff.mpr (IntermediateField.subset_adjoin _ _ (by simp))
    have heq : K⟮α⟯ = E' := IntermediateField.eq_of_le_of_finrank_le hle hfin
    rw [heq]
    exact IntermediateField.subset_adjoin _ _ (by simp)
  have : FiniteDimensional K K⟮α⟯ := IntermediateField.adjoin.finiteDimensional (hint α)
  rw [htop] at this
  exact (IntermediateField.topEquiv (F := K) (E := Ω)).toLinearEquiv.finiteDimensional

/-- **The quadratic case.** -/
theorem hasCountableGaloisFamily_of_natDegree_le_two
    (h : ∀ p : K[X], Irreducible p → p.natDegree ≤ 2) : HasCountableGaloisFamily K := by
  have := finiteDimensional_algebraicClosure h
  refine ⟨PUnit, inferInstance, fun _ => AlgebraicClosure K, fun _ => inferInstance,
    fun _ => inferInstance, fun _ => ⟨this, ⟨⟩⟩, fun E _ _ _ _ => ⟨PUnit.unit, ⟨?_⟩⟩⟩
  exact IsAlgClosed.lift

end Quadratic

section Krasner

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- **Krasner's lemma and density.** Over a complete non-archimedean field, every finite separable
extension is generated by a root of a monic polynomial with coefficients in a given dense
subset. -/
theorem exists_dense_generator {D : Set K} (hD : Dense D) (E : Type u) [Field E] [Algebra K E]
    [FiniteDimensional K E] [Algebra.IsSeparable K E] :
    ∃ (n : ℕ) (a : Fin n → D) (γ : E), K⟮γ⟯ = ⊤ ∧
      aeval γ (X ^ n + ∑ k : Fin n, C ((a k : K)) * X ^ (k : ℕ)) = 0 := by
  classical
  let Ω := AlgebraicClosure K
  let _ : NormedField Ω := spectralNorm.normedField K Ω
  let _ : NormedAlgebra K Ω := spectralNorm.normedAlgebra K Ω
  have : IsKrasner K Ω := IsKrasner.of_completeSpace_of_normal K Ω
  -- the primitive element and its minimal polynomial
  set n := Module.finrank K E with hn
  obtain ⟨β', hβ'⟩ := Field.exists_primitive_element K E
  have hβ'int : IsIntegral K β' := .of_finite K β'
  set h := minpoly K β' with hh
  have hhsep : h.Separable := Algebra.IsSeparable.isSeparable K β'
  have hhm : h.Monic := minpoly.monic hβ'int
  have hhdeg : h.natDegree = n := by
    rw [hh, ← IntermediateField.adjoin.finrank hβ'int, hβ', IntermediateField.finrank_top']
  let ι : E →ₐ[K] Ω := IsAlgClosed.lift
  set β := ι β' with hβ
  have hβh : minpoly K β = h := minpoly.algHom_eq ι ι.injective β'
  -- the distance to the other conjugates
  obtain ⟨r, hr0, hr⟩ : ∃ r : ℝ, 0 < r ∧ ∀ x : Ω, aeval x h = 0 → x ≠ β → r ≤ ‖β - x‖ := by
    let S := (h.map (algebraMap K Ω)).roots.toFinset.erase β
    have hmemS : ∀ x : Ω, aeval x h = 0 → x ≠ β → x ∈ S := fun x hx hxβ => by
      rw [Finset.mem_erase, Multiset.mem_toFinset, mem_roots (hhm.map _).ne_zero, IsRoot,
        eval_map_algebraMap]
      exact ⟨hxβ, hx⟩
    by_cases hS : S.Nonempty
    · obtain ⟨x0, hx0, hmin⟩ := S.exists_min_image (fun x => ‖β - x‖) hS
      refine ⟨‖β - x0‖, norm_pos_iff.mpr (sub_ne_zero.mpr (Finset.ne_of_mem_erase hx0).symm),
        fun x hx hxβ => hmin x (hmemS x hx hxβ)⟩
    · exact ⟨1, one_pos, fun x hx hxβ => absurd ⟨x, hmemS x hx hxβ⟩ hS⟩
  -- approximate `h` by a monic polynomial over `K`
  set Cb : ℝ := max 1 ‖β‖ ^ n with hCb
  have hCb1 : 1 ≤ Cb := one_le_pow₀ (le_max_left _ _)
  set δ : ℝ := r ^ n / ((n + 1) * Cb) with hδ
  have hδ0 : 0 < δ := by positivity
  have happrox : ∀ k : Fin n, ∃ a : D, ‖((a : K)) - h.coeff k‖ < δ := fun k => by
    obtain ⟨a, hab, haD⟩ := Metric.dense_iff.mp hD (h.coeff k) δ hδ0
    exact ⟨⟨a, haD⟩, by rw [← dist_eq_norm]; exact hab⟩
  choose a ha using happrox
  let g₀ : K[X] := X ^ n + ∑ k : Fin n, C ((a k : K)) * X ^ (k : ℕ)
  have hsumdeg : (∑ k : Fin n, C ((a k : K)) * X ^ (k : ℕ)).degree < (X ^ n : K[X]).degree := by
    rw [degree_X_pow]
    exact degree_sum_fin_lt (fun k => (a k : K))
  have hg₀m : g₀.Monic := monic_X_pow_add (degree_sum_fin_lt (fun k => (a k : K)))
  have hg₀deg : g₀.natDegree = n := by
    rw [natDegree_add_eq_left_of_degree_lt hsumdeg, natDegree_X_pow]
  -- `g₀(β)` is small
  have hhsum : h = X ^ n + ∑ k : Fin n, C (h.coeff k) * X ^ (k : ℕ) := by
    conv_lhs => rw [hhm.as_sum, hhdeg]
    rw [Fin.sum_univ_eq_sum_range (fun k => C (h.coeff k) * X ^ k) n]
  have hβroot : aeval β h = 0 := by rw [← hβh]; exact minpoly.aeval K β
  have hgβ : aeval β g₀ = ∑ k : Fin n, algebraMap K Ω ((a k : K) - h.coeff k) * β ^ (k : ℕ) := by
    have h1 : aeval β h = β ^ n + ∑ k : Fin n, algebraMap K Ω (h.coeff k) * β ^ (k : ℕ) := by
      conv_lhs => rw [hhsum]
      simp [map_sum]
    have h2 : aeval β g₀ = β ^ n + ∑ k : Fin n, algebraMap K Ω (a k : K) * β ^ (k : ℕ) := by
      simp only [g₀, map_add, map_pow, aeval_X, map_sum, map_mul, aeval_C]
    rw [h2, ← sub_zero (β ^ n + _), ← hβroot, h1]
    simp only [map_sub, sub_mul, Finset.sum_sub_distrib]
    ring
  have hgβsmall : ‖aeval β g₀‖ < r ^ n := by
    rw [hgβ]
    have hterm : ∀ k : Fin n, ‖algebraMap K Ω ((a k : K) - h.coeff k) * β ^ (k : ℕ)‖ ≤ δ * Cb := by
      intro k
      rw [norm_mul, norm_algebraMap', norm_pow]
      refine mul_le_mul (ha k).le ?_ (by positivity) hδ0.le
      calc ‖β‖ ^ (k : ℕ) ≤ (max 1 ‖β‖) ^ (k : ℕ) :=
            pow_le_pow_left₀ (norm_nonneg _) (le_max_right _ _) _
        _ ≤ (max 1 ‖β‖) ^ n := pow_le_pow_right₀ (le_max_left _ _) k.is_lt.le
    calc ‖∑ k : Fin n, algebraMap K Ω ((a k : K) - h.coeff k) * β ^ (k : ℕ)‖
        ≤ ∑ k : Fin n, ‖algebraMap K Ω ((a k : K) - h.coeff k) * β ^ (k : ℕ)‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _k : Fin n, δ * Cb := Finset.sum_le_sum fun k _ => hterm k
      _ = n * (δ * Cb) := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ < r ^ n := by
        rw [hδ]
        have hpos : 0 < (n + 1 : ℝ) * Cb := by positivity
        rw [div_mul_eq_mul_div, mul_div_assoc', div_eq_mul_inv]
        rw [show (n : ℝ) * (r ^ n * Cb) * ((n + 1 : ℝ) * Cb)⁻¹ = r ^ n * (n / (n + 1)) by
          field_simp]
        have : (n : ℝ) / (n + 1) < 1 := by
          rw [div_lt_one (by positivity)]
          linarith
        nlinarith [pow_pos hr0 n]
  -- a root of `g₀` close to `β`
  have hsplit : (g₀.map (algebraMap K Ω)).Splits := IsAlgClosed.splits _
  obtain ⟨γ, hγroot, hγβ⟩ : ∃ γ ∈ g₀.aroots Ω, ‖β - γ‖ < r := by
    by_contra hcon
    push Not at hcon
    have hprod := hsplit.aeval_eq_prod_aroots_of_monic hg₀m β
    have hcard : (g₀.aroots Ω).card = n := by
      rw [aroots, ← hsplit.natDegree_eq_card_roots, natDegree_map, hg₀deg]
    have hle : (⟨r, hr0.le⟩ : ℝ≥0) ^ ((g₀.aroots Ω).map (β - ·)).card ≤
        (((g₀.aroots Ω).map (β - ·)).map nnnormHom).prod := by
      rw [← Multiset.card_map nnnormHom]
      apply Multiset.pow_card_le_prod
      intro x hx
      obtain ⟨y, hy, rfl⟩ := Multiset.mem_map.mp hx
      obtain ⟨z, hz, rfl⟩ := Multiset.mem_map.mp hy
      exact hcon z hz
    rw [← map_multiset_prod, ← hprod, Multiset.card_map, hcard] at hle
    have : r ^ n ≤ ‖aeval β g₀‖ := by
      have h3 : ((⟨r, hr0.le⟩ : ℝ≥0) ^ n : ℝ≥0) ≤ ‖aeval β g₀‖₊ := hle
      have h4 := NNReal.coe_le_coe.mpr h3
      convert h4 using 1
      · exact (NNReal.coe_pow (⟨r, hr0.le⟩ : ℝ≥0) n).symm
      · exact (coe_nnnorm _).symm
    linarith
  have hγ : aeval γ g₀ = 0 := by
    rw [mem_aroots] at hγroot
    exact hγroot.2
  -- Krasner's lemma
  have hγint : IsIntegral K γ := Algebra.IsIntegral.isIntegral γ
  have hβγ : β ∈ K⟮γ⟯ := IsKrasner.krasner (by rw [hβh]; exact hhsep) (IsAlgClosed.splits _)
    hγint fun x hconj hne => by
      have hx : aeval x h = 0 := by
        rw [← hβh, show minpoly K β = minpoly K x from hconj]
        exact minpoly.aeval K x
      exact hγβ.trans_le (hr x hx (Ne.symm hne))
  -- degrees
  have hβint : IsIntegral K β := hβ'int.map ι
  have hfinβ : Module.finrank K K⟮β⟯ = n := by
    rw [IntermediateField.adjoin.finrank hβint, hβh, hhdeg]
  have hγdvd : minpoly K γ ∣ g₀ := minpoly.dvd K γ hγ
  have hγdeg : (minpoly K γ).natDegree ≤ n := by
    have := natDegree_le_of_dvd hγdvd hg₀m.ne_zero
    rwa [hg₀deg] at this
  have : FiniteDimensional K K⟮γ⟯ := IntermediateField.adjoin.finiteDimensional hγint
  have hle : K⟮β⟯ ≤ K⟮γ⟯ := (IntermediateField.adjoin_simple_le_iff).mpr hβγ
  have heq : K⟮β⟯ = K⟮γ⟯ := IntermediateField.eq_of_le_of_finrank_le hle (by
    rw [IntermediateField.adjoin.finrank hγint, hfinβ]
    exact hγdeg)
  have hγmem : γ ∈ ι.fieldRange := by
    have h1 : K⟮β⟯ ≤ ι.fieldRange :=
      (IntermediateField.adjoin_simple_le_iff).mpr ⟨β', rfl⟩
    exact h1 (heq ▸ IntermediateField.mem_adjoin_simple_self K γ)
  obtain ⟨γ', hγ'⟩ := hγmem
  have hγ'' : ι γ' = γ := hγ'
  have hγdegeq : (minpoly K γ).natDegree = n := by
    rw [← IntermediateField.adjoin.finrank hγint, ← heq, hfinβ]
  -- `γ'` generates `E` and is a root of `g₀`
  have hγ'root : aeval γ' g₀ = 0 := by
    have h1 := aeval_algHom_apply ι γ' g₀
    rw [hγ'', hγ] at h1
    exact ι.injective (h1.symm.trans (map_zero ι).symm)
  have hγ'int : IsIntegral K γ' := .of_finite K γ'
  have hmin' : minpoly K γ' = minpoly K γ := by
    rw [← hγ'']
    exact (minpoly.algHom_eq ι ι.injective γ').symm
  refine ⟨n, a, γ', ?_, hγ'root⟩
  apply IntermediateField.eq_of_le_of_finrank_le le_top
  rw [IntermediateField.finrank_top', IntermediateField.adjoin.finrank hγ'int, hmin', hγdegeq]

/-- **Complete non-archimedean fields with a countable dense subset.** -/
theorem hasCountableGaloisFamily_of_isUltrametricDist [TopologicalSpace.SeparableSpace K] :
    HasCountableGaloisFamily K := by
  classical
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense K
  have : Countable D := hDc.to_subtype
  let g : (Σ n : ℕ, Fin n → D) → K[X] := fun c =>
    X ^ c.1 + ∑ k : Fin c.1, C ((c.2 k : K)) * X ^ (k : ℕ)
  refine ⟨Σ n : ℕ, Fin n → D, inferInstance,
    fun c => ↥(separableClosure K (g c).SplittingField), fun _ => inferInstance,
    fun _ => inferInstance, fun c => ⟨inferInstance, inferInstance⟩, fun E _ _ _ _ => ?_⟩
  obtain ⟨n, a, γ, hγtop, hγroot⟩ := exists_dense_generator hD E
  refine ⟨⟨n, a⟩, ?_⟩
  let SF := (g ⟨n, a⟩).SplittingField
  have hγint : IsIntegral K γ := .of_finite K γ
  have hg0 : (g ⟨n, a⟩).map (algebraMap K SF) ≠ 0 :=
    Polynomial.map_ne_zero (monic_X_pow_add (degree_sum_fin_lt (fun k => (a k : K)))).ne_zero
  have hsplit : ((minpoly K γ).map (algebraMap K SF)).Splits :=
    (SplittingField.splits (g ⟨n, a⟩)).of_dvd hg0
      (Polynomial.map_dvd (algebraMap K SF) (minpoly.dvd K γ hγroot))
  obtain ⟨y, hy⟩ := hsplit.exists_eval_eq_zero (by
    rw [degree_map]
    exact (minpoly.degree_pos hγint).ne')
  have hymem : y ∈ (minpoly K γ).aroots SF := by
    rw [mem_aroots]
    exact ⟨minpoly.ne_zero hγint, by rwa [aeval_def, ← eval_map]⟩
  let φ₀ : K⟮γ⟯ →ₐ[K] SF := (IntermediateField.algHomAdjoinIntegralEquiv K hγint).symm ⟨y, hymem⟩
  let φ : E →ₐ[K] SF := φ₀.comp ((IntermediateField.equivOfEq hγtop.symm).toAlgHom.comp
    (IntermediateField.topEquiv (F := K) (E := E)).symm.toAlgHom)
  refine ⟨φ.codRestrict (separableClosure K SF).toSubalgebra fun x => ?_⟩
  change φ x ∈ separableClosure K SF
  rw [mem_separableClosure_iff]
  change (minpoly K (φ x)).Separable
  rw [minpoly.algHom_eq φ φ.injective x]
  exact Algebra.IsSeparable.isSeparable K x

end Krasner

end Langlands.FieldTheory.CountableGaloisFamily
