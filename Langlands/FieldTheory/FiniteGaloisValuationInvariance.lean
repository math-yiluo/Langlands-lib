import Mathlib.FieldTheory.Galois.Infinite
import Mathlib.RingTheory.Valuation.Basic

/-! # Testing Galois invariance of valuations on finite normal subextensions -/

noncomputable section

namespace Langlands.FieldTheory

variable {K Ω Γ₀ : Type*} [Field K] [Field Ω] [Algebra K Ω] [IsGalois K Ω]
  [LinearOrderedCommGroupWithZero Γ₀]

/-- Restrict a valuation to the finite normal closure of the simple subextension
generated by a specified element. -/
def finiteGaloisValuationRestriction (w : Valuation Ω Γ₀) (x : Ω) :
    Valuation (FiniteGaloisIntermediateField.adjoin K ({x} : Set Ω)) Γ₀ :=
  w.comap (algebraMap (FiniteGaloisIntermediateField.adjoin K ({x} : Set Ω)) Ω)

@[simp] theorem finiteGaloisValuationRestriction_apply (w : Valuation Ω Γ₀) (x : Ω)
    (y : FiniteGaloisIntermediateField.adjoin K ({x} : Set Ω)) :
    finiteGaloisValuationRestriction (K := K) w x y = w (y : Ω) := rfl

/-- Galois invariance on all finite Galois subextensions implies invariance on
an arbitrary, possibly infinite, Galois extension. -/
theorem valuation_invariant_of_finite_galois (w : Valuation Ω Γ₀)
    (hfin : ∀ (F : IntermediateField K Ω) [FiniteDimensional K F] [IsGalois K F],
      ∀ (σ : Gal(F/K)) (y : F),
        (w.comap (algebraMap F Ω)) (σ y) = (w.comap (algebraMap F Ω)) y) :
    ∀ (σ : Gal(Ω/K)) (x : Ω), w (σ x) = w x := by
  intro σ x
  let F := FiniteGaloisIntermediateField.adjoin K ({x} : Set Ω)
  have hx : x ∈ F.toIntermediateField :=
    FiniteGaloisIntermediateField.subset_adjoin K ({x} : Set Ω) rfl
  let y : F := ⟨x, hx⟩
  have h := hfin F.toIntermediateField (σ.restrictNormal F) y
  change w (algebraMap F Ω ((σ.restrictNormal F) y)) = w x at h
  rwa [AlgEquiv.restrictNormal_commutes] at h

end Langlands.FieldTheory
