import Langlands.Algebra.RenardNilpotentIdealFiltration
import Langlands.Algebra.CommutingDimensionPrimary

/-! Actual simultaneous generalized eigenspaces and their original restricted actions. -/

noncomputable section
open scoped IsMulCommutative

namespace Langlands.Renard.CommutingReduction

universe u

variable {V : Type u} [AddCommGroup V] [Module ℂ V]
  {l : ℕ} (a : Fin l → Module.End ℂ V)

/-- The actual intersection of the original generators' generalized eigenspaces. -/
def jointSpace (χ : Fin l → ℂ) : Submodule ℂ V :=
  ⨅ i, (a i).maxGenEigenspace (χ i)

/-- Exactly the characters whose actual joint generalized eigenspace is nonzero. -/
def jointBlockIndex : Type :=
  {χ : Fin l → ℂ // jointSpace a χ ≠ ⊥}

@[simp] theorem mem_jointSpace (χ : Fin l → ℂ) (v : V) :
    v ∈ jointSpace a χ ↔ ∀ i, v ∈ (a i).maxGenEigenspace (χ i) := by
  simp only [jointSpace, Submodule.mem_iInf]

/-- Each joint space is contained in each of its defining generalized eigenspaces. -/
theorem jointSpace_le (χ : Fin l → ℂ) (i : Fin l) :
    jointSpace a χ ≤ (a i).maxGenEigenspace (χ i) :=
  iInf_le _ i

/-- The entire original generated algebra preserves every actual joint space. -/
theorem jointSpace_stable (hcomm : ∀ i j, Commute (a i) (a j))
    (χ : Fin l → ℂ) (r : NilpotentFiltration.generatedAlgebra a)
    (v : V) (hv : v ∈ jointSpace a χ) :
    (r : Module.End ℂ V) v ∈ jointSpace a χ := by
  let := NilpotentFiltration.generatedAlgebra_isMulCommutative a hcomm
  rw [mem_jointSpace] at hv ⊢
  intro i
  have hi : Commute (a i) (r : Module.End ℂ V) :=
    congrArg Subtype.val (mul_comm (NilpotentFiltration.generator a i) r)
  exact Module.End.mapsTo_maxGenEigenspace_of_comm hi (χ i) (hv i)

/-- Restriction of the original algebra's evaluation action to the actual joint space. -/
def blockRestriction (hcomm : ∀ i j, Commute (a i) (a j))
    (χ : Fin l → ℂ) :
    NilpotentFiltration.generatedAlgebra a →ₐ[ℂ] Module.End ℂ (jointSpace a χ) :=
  Langlands.CommutingDimension.restrictionAlgHom ℂ V
    (NilpotentFiltration.generatedAlgebra a) (jointSpace a χ)
    (jointSpace_stable a hcomm χ)

/-- The original tuple acting on its actual joint generalized eigenspace. -/
def blockTuple (hcomm : ∀ i j, Commute (a i) (a j))
    (χ : Fin l → ℂ) (i : Fin l) : Module.End ℂ (jointSpace a χ) :=
  blockRestriction a hcomm χ (NilpotentFiltration.generator a i)

/-- The source's nilpotent parts, subtracting each block's actual scalar eigenvalue. -/
def shiftedBlockTuple (hcomm : ∀ i j, Commute (a i) (a j))
    (χ : Fin l → ℂ) (i : Fin l) : Module.End ℂ (jointSpace a χ) :=
  blockTuple a hcomm χ i - algebraMap ℂ (Module.End ℂ (jointSpace a χ)) (χ i)

/-- The actual unital algebra generated by the original restricted tuple. -/
def blockAlgebra (hcomm : ∀ i j, Commute (a i) (a j))
    (χ : Fin l → ℂ) : Subalgebra ℂ (Module.End ℂ (jointSpace a χ)) :=
  NilpotentFiltration.generatedAlgebra (blockTuple a hcomm χ)

@[simp] theorem blockRestriction_apply
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ)
    (r : NilpotentFiltration.generatedAlgebra a) (v : jointSpace a χ) :
    (blockRestriction a hcomm χ r v : V) = (r : Module.End ℂ V) v := rfl

@[simp] theorem blockTuple_apply
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ)
    (i : Fin l) (v : jointSpace a χ) :
    (blockTuple a hcomm χ i v : V) = a i v := rfl

/-- The restricted original tuple generates the image of the actual action map. -/
theorem blockAlgebra_eq_range
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ) :
    blockAlgebra a hcomm χ = (blockRestriction a hcomm χ).range := by
  exact Langlands.CommutingDimension.adjoin_image_generators ℂ
    (NilpotentFiltration.generator a)
    (Langlands.CommutingDimension.adjoin_generators_top ℂ a)
    (blockRestriction a hcomm χ)

/-- The original restricted tuple still commutes. -/
theorem blockTuple_commute
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ)
    (i j : Fin l) :
    Commute (blockTuple a hcomm χ i) (blockTuple a hcomm χ j) := by
  have h : Commute (NilpotentFiltration.generator a i)
      (NilpotentFiltration.generator a j) := by
    apply Subtype.ext
    exact (hcomm i j).eq
  exact h.map (blockRestriction a hcomm χ)

/-- Subtracting the actual block eigenvalues preserves commutation. -/
theorem shiftedBlockTuple_commute
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ)
    (i j : Fin l) :
    Commute (shiftedBlockTuple a hcomm χ i) (shiftedBlockTuple a hcomm χ j) :=
  Langlands.CommutingDimension.commute_shift ℂ (blockTuple a hcomm χ) χ
    (blockTuple_commute a hcomm χ) i j

/-- Scalar subtraction leaves the actual unital restricted algebra unchanged. -/
theorem shiftedBlockTuple_adjoin_eq
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ) :
    Algebra.adjoin ℂ (Set.range (shiftedBlockTuple a hcomm χ)) =
      blockAlgebra a hcomm χ :=
  Langlands.CommutingDimension.adjoin_shift_eq ℂ (blockTuple a hcomm χ) χ

/-- Each actual scalar-subtracted block generator is nilpotent in finite dimension. -/
theorem shiftedBlockTuple_isNilpotent [FiniteDimensional ℂ V]
    (hcomm : ∀ i j, Commute (a i) (a j)) (χ : Fin l → ℂ) (i : Fin l) :
    IsNilpotent (shiftedBlockTuple a hcomm χ i) := by
  have hinv : Set.MapsTo (a i - algebraMap ℂ (Module.End ℂ V) (χ i))
      (jointSpace a χ) (jointSpace a χ) := by
    intro v hv
    exact (jointSpace a χ).sub_mem
      (jointSpace_stable a hcomm χ (NilpotentFiltration.generator a i) v hv)
      ((jointSpace a χ).smul_mem (χ i) hv)
  have heq : shiftedBlockTuple a hcomm χ i =
      (a i - algebraMap ℂ (Module.End ℂ V) (χ i)).restrict hinv := by
    ext v
    rfl
  rw [heq]
  exact Module.End.isNilpotent_restrict_of_le (jointSpace_le a χ i)
    ((a i).isNilpotent_restrict_maxGenEigenspace_sub_algebraMap (χ i))

end Langlands.Renard.CommutingReduction
