import Langlands.Algebra.LocalAlgebraTowerUpperPresentation
import Langlands.Algebra.LocalAlgebraTowerPrimeLocalization
import Langlands.Algebra.LocalAlgebraApproximationTransition
import Langlands.Algebra.LocalModuleApproximation

/-! # Upper stages of a synchronized local algebra tower approximation -/

universe uI uA uB uR uS uT

namespace Langlands.Algebra

open MvPolynomial IsLocalRing

/-! ## Polynomials over the components of a ring system -/

namespace LocalAlgebraSystem

variable {ι : Type uI} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
  {R : Type uR} {S : Type uS} [CommRing R] [CommRing S]
  [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
  (D : LocalAlgebraSystem.{uI, uA, uB} ι R S) {σ : Type*}

/-- Coefficientwise transition of polynomials composes like the transitions. -/
theorem map_algMap_map_algMap {i j k : ι} (hij : i ≤ j) (hjk : j ≤ k)
    (g : MvPolynomial σ (D.alg i)) :
    map (D.algMap j k hjk) (map (D.algMap i j hij) g) = map (D.algMap i k (hij.trans hjk)) g := by
  rw [map_map, show (D.algMap j k hjk).comp (D.algMap i j hij) = D.algMap i k (hij.trans hjk) from
    RingHom.ext fun s ↦ DirectedSystem.map_map' D.algMap hij hjk s]

/-- Coefficientwise transition along `i ≤ i` is the identity. -/
theorem map_algMap_self {i : ι} (h : i ≤ i) (g : MvPolynomial σ (D.alg i)) :
    map (D.algMap i i h) g = g := by
  rw [show D.algMap i i h = RingHom.id _ from
    RingHom.ext fun s ↦ DirectedSystem.map_self' D.algMap s, map_id]

/-- Coefficientwise cocone maps are compatible with coefficientwise transitions. -/
theorem map_algι_map_algMap {i j : ι} (h : i ≤ j) (g : MvPolynomial σ (D.alg i)) :
    map (D.algι j) (map (D.algMap i j h) g) = map (D.algι i) g := by
  rw [map_map, show (D.algι j).comp (D.algMap i j h) = D.algι i from
    RingHom.ext (D.algι_compat i j h)]

/-- A finite family of polynomials over `S` lifts to one component when the algebra colimit
map is onto. -/
theorem exists_map_algι_eq_fun (hD : Function.Surjective D.algebraColimitMap) {κ : Type*}
    [Finite κ] (p : κ → MvPolynomial σ S) :
    ∃ i, ∃ x : κ → MvPolynomial σ (D.alg i), ∀ k, map (D.algι i) (x k) = p k := by
  classical
  have := Fintype.ofFinite κ
  let C : Finset S := Finset.univ.biUnion fun k ↦ (p k).coeffs
  obtain ⟨i, y, hy⟩ := D.exists_algι_eq_fun hD (fun c : C ↦ (c : S))
  have h : ∀ k, p k ∈ Set.range (map (D.algι i) : MvPolynomial σ (D.alg i) →+* _) :=
    fun k ↦ MvPolynomial.mem_range_map_iff_coeffs_subset.2 fun c hc ↦
      ⟨y ⟨c, Finset.mem_biUnion.2 ⟨k, Finset.mem_univ _, Finset.mem_coe.1 hc⟩⟩, hy _⟩
  choose x hx using h
  exact ⟨i, x, hx⟩

/-- A finite family of component polynomials killed coefficientwise in `S` is killed by one
transition when the algebra colimit map is injective. -/
theorem exists_map_algMap_eq_zero_fun (hD : Function.Injective D.algebraColimitMap) {κ : Type*}
    [Finite κ] {i : ι} (x : κ → MvPolynomial σ (D.alg i))
    (hx : ∀ k, map (D.algι i) (x k) = 0) :
    ∃ j, ∃ h : i ≤ j, ∀ k, map (D.algMap i j h) (x k) = 0 := by
  classical
  obtain ⟨j, h, hj⟩ := D.exists_algMap_eq_zero_fun hD
    (fun km : (k : κ) × (x k).support ↦ (x km.1).coeff km.2.1) fun km ↦ by
      simpa [coeff_map] using congrArg (fun p ↦ p.coeff km.2.1) (hx km.1)
  refine ⟨j, h, fun k ↦ MvPolynomial.ext _ _ fun m ↦ ?_⟩
  rw [coeff_map]
  by_cases hm : m ∈ (x k).support
  · simpa using hj ⟨k, m, hm⟩
  · simp [notMem_support_iff.1 hm]

end LocalAlgebraSystem

/-! ## The upper stages -/

namespace LocalAlgebraTowerApproximation

open LocalAlgebraApproximationExistence

variable {ι : Type uI} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
  {R : Type uR} {S : Type uS} {T : Type uT} [CommRing R] [CommRing S] [CommRing T]
  [IsLocalRing R] [IsLocalRing S] [Algebra R S] [Algebra S T] [IsLocalHom (algebraMap R S)]

/-- Lifts of the finitely many relations of a presentation `P` of `T` over `S` to every
component of a ring system `D` for `R → S`, compatible with the transitions and with the cocone
maps (all applied coefficientwise). -/
structure RelLift (D : LocalAlgebraSystem.{uI, uA, uB} ι R S)
    (P : Pres S S T (RingEquiv.refl S)) where
  lift : ∀ i, P.F → MvPolynomial (Fin P.n) (D.alg i)
  map_lift : ∀ i j (h : i ≤ j) f, map (D.algMap i j h) (lift i f) = lift j f
  algι_lift : ∀ i f, map (D.algι i) (lift i f) = f

noncomputable section

namespace RelLift

variable {D : LocalAlgebraSystem.{uI, uA, uB} ι R S} {P : Pres S S T (RingEquiv.refl S)}
  (L : RelLift D P)

/-- The ideal generated by the lifted relations over a component. -/
def rel (i : ι) : Ideal (MvPolynomial (Fin P.n) (D.alg i)) := Ideal.span (Set.range (L.lift i))

theorem lift_mem_rel (i : ι) (f : P.F) : L.lift i f ∈ L.rel i := Ideal.subset_span ⟨f, rfl⟩

/-- Coefficientwise transition carries the relation ideal onto the later relation ideal. -/
theorem rel_map {i j : ι} (h : i ≤ j) : (L.rel i).map (map (D.algMap i j h)) = L.rel j := by
  have e : ⇑(map (σ := Fin P.n) (D.algMap i j h)) ∘ L.lift i = L.lift j :=
    funext fun f ↦ L.map_lift i j h f
  unfold rel
  rw [Ideal.map_span, ← Set.range_comp, e]

theorem rel_le_comap {i j : ι} (h : i ≤ j) : L.rel i ≤ (L.rel j).comap (map (D.algMap i j h)) :=
  Ideal.map_le_iff_le_comap.1 (L.rel_map h).le

/-- The finite type algebra over a component. -/
def Q (i : ι) : Type uB := MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i

instance (i : ι) : CommRing (L.Q i) :=
  inferInstanceAs (CommRing (MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i))

instance (i : ι) : Algebra (D.alg i) (L.Q i) :=
  inferInstanceAs (Algebra (D.alg i) (MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i))

instance (i : ι) : Algebra.FiniteType (D.alg i) (L.Q i) :=
  inferInstanceAs (Algebra.FiniteType (D.alg i) (MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i))

/-- The quotient map onto the finite type algebra. -/
def mkQ (i : ι) : MvPolynomial (Fin P.n) (D.alg i) →+* L.Q i := Ideal.Quotient.mk (L.rel i)

theorem mkQ_surjective (i : ι) : Function.Surjective (L.mkQ i) :=
  Ideal.Quotient.mk_surjective

theorem mkQ_eq_zero_iff {i : ι} {g : MvPolynomial (Fin P.n) (D.alg i)} :
    L.mkQ i g = 0 ↔ g ∈ L.rel i :=
  Ideal.Quotient.eq_zero_iff_mem

theorem mkQ_C (i : ι) (s : D.alg i) : L.mkQ i (C s) = algebraMap (D.alg i) (L.Q i) s := by
  rw [← MvPolynomial.algebraMap_eq]
  exact Ideal.Quotient.mk_algebraMap _ _ _

/-- Maps out of the finite type algebra. -/
def liftQ (i : ι) {X : Type*} [CommRing X] (f : MvPolynomial (Fin P.n) (D.alg i) →+* X)
    (hf : L.rel i ≤ RingHom.ker f) : L.Q i →+* X :=
  Ideal.Quotient.lift _ f fun _ ha ↦ RingHom.mem_ker.1 (hf ha)

theorem liftQ_mkQ (i : ι) {X : Type*} [CommRing X] (f : MvPolynomial (Fin P.n) (D.alg i) →+* X)
    (hf : L.rel i ≤ RingHom.ker f) (g : MvPolynomial (Fin P.n) (D.alg i)) :
    L.liftQ i f hf (L.mkQ i g) = f g :=
  Ideal.Quotient.lift_mk _ _ _

theorem rel_le_ker (i : ι) : L.rel i ≤ RingHom.ker (P.ρ.comp (map (D.algι i))) :=
  Ideal.span_le.2 (Set.range_subset_iff.2 fun f ↦ RingHom.mem_ker.2 (by
    rw [RingHom.comp_apply, L.algι_lift]
    exact P.ρ_F f f.2))

/-- The map from the finite type algebra to `T`. -/
def ρQ (i : ι) : L.Q i →+* T := L.liftQ i (P.ρ.comp (map (D.algι i))) (L.rel_le_ker i)

theorem ρQ_mkQ (i : ι) (g : MvPolynomial (Fin P.n) (D.alg i)) :
    L.ρQ i (L.mkQ i g) = P.ρ (map (D.algι i) g) := by
  rw [ρQ, liftQ_mkQ, RingHom.comp_apply]

/-- The transition of finite type algebras. -/
def QMap {i j : ι} (h : i ≤ j) : L.Q i →+* L.Q j :=
  L.liftQ i ((L.mkQ j).comp (map (D.algMap i j h))) fun g hg ↦ RingHom.mem_ker.2 (by
    rw [RingHom.comp_apply, mkQ_eq_zero_iff]
    exact L.rel_le_comap h hg)

theorem QMap_mkQ {i j : ι} (h : i ≤ j) (g : MvPolynomial (Fin P.n) (D.alg i)) :
    L.QMap h (L.mkQ i g) = L.mkQ j (map (D.algMap i j h) g) := by
  rw [QMap, liftQ_mkQ, RingHom.comp_apply]

theorem ρQ_QMap {i j : ι} (h : i ≤ j) (x : L.Q i) : L.ρQ j (L.QMap h x) = L.ρQ i x := by
  obtain ⟨g, rfl⟩ := L.mkQ_surjective i x
  rw [QMap_mkQ, ρQ_mkQ, ρQ_mkQ, D.map_algι_map_algMap]

theorem QMap_self {i : ι} (h : i ≤ i) (x : L.Q i) : L.QMap h x = x := by
  obtain ⟨g, rfl⟩ := L.mkQ_surjective i x
  rw [QMap_mkQ, D.map_algMap_self]

theorem QMap_QMap {i j k : ι} (hij : i ≤ j) (hjk : j ≤ k) (x : L.Q i) :
    L.QMap hjk (L.QMap hij x) = L.QMap (hij.trans hjk) x := by
  obtain ⟨g, rfl⟩ := L.mkQ_surjective i x
  rw [QMap_mkQ, QMap_mkQ, QMap_mkQ, D.map_algMap_map_algMap]

theorem QMap_algebraMap {i j : ι} (h : i ≤ j) (s : D.alg i) :
    L.QMap h (algebraMap (D.alg i) (L.Q i) s) =
      algebraMap (D.alg j) (L.Q j) (D.algMap i j h s) := by
  rw [← mkQ_C, QMap_mkQ, map_C, mkQ_C]

variable [IsLocalRing T]

/-- The prime of the finite type algebra lying under the maximal ideal of `T`. -/
def q (i : ι) : Ideal (L.Q i) := (maximalIdeal T).comap (L.ρQ i)

instance (i : ι) : (L.q i).IsPrime := Ideal.comap_isPrime _ _

theorem mem_primeCompl_iff {i : ι} {x : L.Q i} :
    x ∈ (L.q i).primeCompl ↔ IsUnit (L.ρQ i x) := by
  rw [Ideal.mem_primeCompl_iff, q, Ideal.mem_comap, notMem_maximalIdeal]

theorem q_eq_comap {i j : ι} (h : i ≤ j) : L.q i = (L.q j).comap (L.QMap h) := by
  ext x
  rw [q, Ideal.mem_comap, Ideal.mem_comap, q, Ideal.mem_comap, ρQ_QMap]

/-- The upper stage: the finite type algebra localized at `q i`. -/
abbrev Tl (i : ι) : Type uB := Localization.AtPrime (L.q i)

/-- The map from an upper stage to `T`. -/
def topι (i : ι) : L.Tl i →+* T :=
  IsLocalization.lift (M := (L.q i).primeCompl) (g := L.ρQ i) fun s ↦
    L.mem_primeCompl_iff.1 s.2

theorem topι_algebraMap (i : ι) (x : L.Q i) :
    L.topι i (algebraMap (L.Q i) (L.Tl i) x) = L.ρQ i x :=
  IsLocalization.lift_eq _ _

/-- The transition of upper stages. -/
def TMap {i j : ι} (h : i ≤ j) : L.Tl i →+* L.Tl j :=
  Localization.localRingHom (L.q i) (L.q j) (L.QMap h) (L.q_eq_comap h)

theorem TMap_algebraMap {i j : ι} (h : i ≤ j) (x : L.Q i) :
    L.TMap h (algebraMap (L.Q i) (L.Tl i) x) = algebraMap (L.Q j) (L.Tl j) (L.QMap h x) :=
  Localization.localRingHom_to_map _ _ _ _ _

theorem TMap_self {i : ι} (h : i ≤ i) (x : L.Tl i) : L.TMap h x = x := by
  have e : L.TMap h = RingHom.id _ := IsLocalization.ringHom_ext (L.q i).primeCompl
    (RingHom.ext fun a ↦ by
      rw [RingHom.comp_apply, TMap_algebraMap, QMap_self, RingHom.comp_apply, RingHom.id_apply])
  rw [e, RingHom.id_apply]

theorem TMap_TMap {i j k : ι} (hij : i ≤ j) (hjk : j ≤ k) (x : L.Tl i) :
    L.TMap hjk (L.TMap hij x) = L.TMap (hij.trans hjk) x := by
  have e : (L.TMap hjk).comp (L.TMap hij) = L.TMap (hij.trans hjk) :=
    IsLocalization.ringHom_ext (L.q i).primeCompl (RingHom.ext fun a ↦ by
      rw [RingHom.comp_apply, RingHom.comp_apply, TMap_algebraMap, TMap_algebraMap, QMap_QMap,
        RingHom.comp_apply, TMap_algebraMap])
  exact DFunLike.congr_fun e x

theorem topι_TMap {i j : ι} (h : i ≤ j) (x : L.Tl i) : L.topι j (L.TMap h x) = L.topι i x := by
  have e : (L.topι j).comp (L.TMap h) = L.topι i :=
    IsLocalization.ringHom_ext (L.q i).primeCompl (RingHom.ext fun a ↦ by
      simp only [RingHom.comp_apply, TMap_algebraMap, topι_algebraMap, ρQ_QMap])
  exact DFunLike.congr_fun e x

theorem topι_mk'_spec (i : ι) (a : L.Q i) (s : (L.q i).primeCompl) :
    L.ρQ i a = L.ρQ i s * L.topι i (IsLocalization.mk' (L.Tl i) a s) :=
  (IsLocalization.lift_mk'_spec ..).1 rfl

instance isLocalHom_topι (i : ι) : IsLocalHom (L.topι i) where
  map_nonunit x hx := by
    obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (L.q i).primeCompl x
    rw [IsLocalization.AtPrime.isUnit_mk'_iff, L.mem_primeCompl_iff, L.topι_mk'_spec i a s]
    exact (L.mem_primeCompl_iff.1 s.2).mul hx

theorem TMap_algebraMap_alg {i j : ι} (h : i ≤ j) (s : D.alg i) :
    L.TMap h (algebraMap (D.alg i) (L.Tl i) s) =
      algebraMap (D.alg j) (L.Tl j) (D.algMap i j h s) := by
  rw [IsScalarTower.algebraMap_apply (D.alg i) (L.Q i) (L.Tl i), TMap_algebraMap,
    QMap_algebraMap, ← IsScalarTower.algebraMap_apply]

theorem topι_algebraMap_alg (i : ι) (s : D.alg i) :
    L.topι i (algebraMap (D.alg i) (L.Tl i) s) = algebraMap S T (D.algι i s) := by
  rw [IsScalarTower.algebraMap_apply (D.alg i) (L.Q i) (L.Tl i), topι_algebraMap, ← mkQ_C,
    ρQ_mkQ, map_C, P.ρ_C]
  rfl

/-! ## The upper colimit -/

/-- Every element of `T` comes from some upper stage. -/
theorem exists_topι_eq (hD : Function.Surjective D.algebraColimitMap) (t : T) :
    ∃ i, ∃ x : L.Tl i, L.topι i x = t := by
  obtain ⟨a, c, hc, ht⟩ := P.surj t
  obtain ⟨i, x, hx⟩ := D.exists_map_algι_eq_fun hD (fun b : Bool ↦ cond b a c)
  have ha : map (D.algι i) (x true) = a := hx true
  have hc' : map (D.algι i) (x false) = c := hx false
  have hcu : L.mkQ i (x false) ∈ (L.q i).primeCompl := by
    rw [mem_primeCompl_iff, ρQ_mkQ, hc']
    exact hc
  refine ⟨i, IsLocalization.mk' (L.Tl i) (L.mkQ i (x true)) ⟨_, hcu⟩, ?_⟩
  have e := L.topι_mk'_spec i (L.mkQ i (x true)) ⟨_, hcu⟩
  rw [ρQ_mkQ, ρQ_mkQ, ha, hc', ← ht, mul_comm] at e
  exact (hc.mul_left_cancel e).symm

/-- An element of an upper stage killed in `T` dies at some later stage. -/
theorem exists_TMap_eq_zero (hD : D.IsColimit) {i : ι} (x : L.Tl i) (hx : L.topι i x = 0) :
    ∃ l, ∃ h : i ≤ l, L.TMap h x = 0 := by
  classical
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (L.q i).primeCompl x
  obtain ⟨g, rfl⟩ := L.mkQ_surjective i a
  have hg : P.ρ (map (D.algι i) g) = 0 := by
    rw [← ρQ_mkQ, L.topι_mk'_spec i, hx, mul_zero]
  obtain ⟨c, hc, hspan⟩ := P.ker _ hg
  have hF : (P.F : Set (MvPolynomial (Fin P.n) S)) = Set.range (fun f : P.F ↦ f.1) := by
    ext; simp
  rw [hF, Ideal.mem_span_range_iff_exists_fun] at hspan
  obtain ⟨μ, hμ⟩ := hspan
  -- Lift `c` and the coefficients `μ f` to one stage, then to a stage above `i`.
  obtain ⟨j, y, hy⟩ := D.exists_map_algι_eq_fun hD.2.2
    (fun o : Option P.F ↦ o.elim c μ)
  obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
  let Δ : MvPolynomial (Fin P.n) (D.alg k) :=
    map (D.algMap j k hjk) (y none) * map (D.algMap i k hik) g -
      ∑ f : P.F, map (D.algMap j k hjk) (y (some f)) * L.lift k f
  have hΔ : map (D.algι k) Δ = 0 := by
    simp only [Δ, map_sub, map_mul, map_sum, D.map_algι_map_algMap, L.algι_lift]
    rw [hy none, sub_eq_zero]
    change c * _ = _
    rw [← hμ]
    exact Finset.sum_congr rfl fun f _ ↦ by rw [hy (some f)]; rfl
  obtain ⟨l, hkl, hl⟩ := D.exists_map_algMap_eq_zero_fun hD.2.1 (fun _ : Unit ↦ Δ)
    fun _ ↦ hΔ
  have hl' := hl ()
  simp only [Δ, map_sub, map_mul, map_sum, D.map_algMap_map_algMap, L.map_lift,
    sub_eq_zero] at hl'
  let c' := map (D.algMap j l (hjk.trans hkl)) (y none)
  have hcu : L.mkQ l c' ∈ (L.q l).primeCompl := by
    rw [mem_primeCompl_iff, ρQ_mkQ, D.map_algι_map_algMap, hy none]
    exact hc
  refine ⟨l, hik.trans hkl, ?_⟩
  rw [IsLocalization.mk'_eq_mul_mk'_one, map_mul, TMap_algebraMap, QMap_mkQ,
    IsLocalization.map_eq_zero_iff (L.q l).primeCompl _ _ |>.2 ⟨⟨_, hcu⟩, ?_⟩, zero_mul]
  change L.mkQ l c' * L.mkQ l _ = 0
  rw [← map_mul, mkQ_eq_zero_iff, hl']
  exact sum_mem fun f _ ↦ Ideal.mul_mem_left _ _ (L.lift_mem_rel l f)

variable [IsLocalHom (algebraMap S T)]

instance isLocalHom_algebraMap (i : ι) : IsLocalHom (algebraMap (D.alg i) (L.Tl i)) where
  map_nonunit s hs := by
    have h : IsUnit (algebraMap S T (D.algι i s)) := by
      rw [← topι_algebraMap_alg]
      exact hs.map _
    have := D.algι_local i
    exact IsUnit.of_map (D.algι i) s (IsUnit.of_map (algebraMap S T) _ h)

instance essFiniteType_Tl (i : ι) : Algebra.EssFiniteType (D.alg i) (L.Tl i) := by
  have : Algebra.EssFiniteType (L.Q i) (L.Tl i) :=
    Algebra.EssFiniteType.of_isLocalization _ (L.q i).primeCompl
  exact Algebra.EssFiniteType.comp (D.alg i) (L.Q i) (L.Tl i)

variable [Algebra R T] [IsScalarTower R S T]

/-- The synchronized tower: the given ring system `D` for `R → S`, with the upper stages
`Tl i` over the components of `D`. -/
def tower : LocalAlgebraTowerSystem.{uI, uA, uB, uB} ι R S T where
  rs := D
  top := L.Tl
  topCommRing i := inferInstanceAs (CommRing (L.Tl i))
  topLocalRing i := inferInstanceAs (IsLocalRing (L.Tl i))
  upperAlgebra i := inferInstanceAs (Algebra (D.alg i) (L.Tl i))
  upper_local i := L.isLocalHom_algebraMap i
  topMap _ _ h := L.TMap h
  top_directed := ⟨fun _ x ↦ L.TMap_self _ x, fun _ _ _ hij hjk x ↦ L.TMap_TMap hij hjk x⟩
  topMap_local _ _ _ := Localization.isLocalHom_localRingHom _ _ _ _
  topMap_comm _ _ h s := L.TMap_algebraMap_alg h s
  topι := L.topι
  topι_local := L.isLocalHom_topι
  topι_compat _ _ h x := L.topι_TMap h x
  topι_comm := L.topι_algebraMap_alg

/-- The upper arrow of the tower has genuine ring colimits. -/
theorem tower_st_isColimit (hD : D.IsColimit) : L.tower.st.IsColimit := by
  refine ⟨hD.2, ⟨?_, ?_⟩⟩
  · rw [injective_iff_map_eq_zero]
    intro z hz
    induction z using Ring.DirectLimit.induction_on with
    | ih i x =>
      rw [LocalAlgebraSystem.algebraColimitMap_of] at hz
      obtain ⟨k, h, hk⟩ := L.exists_TMap_eq_zero hD x hz
      exact (Ring.DirectLimit.of_f (G := L.tower.st.alg)
        (f := fun i j h ↦ L.tower.st.algMap i j h) h x).symm.trans
        ((congrArg (Ring.DirectLimit.of L.tower.st.alg
          (fun i j h ↦ L.tower.st.algMap i j h) k) hk).trans (map_zero _))
  · intro t
    obtain ⟨i, x, rfl⟩ := L.exists_topι_eq hD.2.2 t
    exact ⟨Ring.DirectLimit.of _ _ i x, LocalAlgebraSystem.algebraColimitMap_of _ _ _⟩

/-! ## Prime localization of the upper transitions -/

/-- Prime localization for the actual upper base-change map of the tower. -/
theorem isPrimeLocalization_st {i j : ι} (h : i ≤ j) : L.tower.st.IsPrimeLocalization h := by
  let : Algebra (D.alg i) (D.alg j) := (D.algMap i j h).toAlgebra
  let : Algebra (MvPolynomial (Fin P.n) (D.alg i)) (MvPolynomial (Fin P.n) (D.alg j)) :=
    MvPolynomial.algebraMvPolynomial
  let : Algebra (D.alg i) (L.Q j) :=
    inferInstanceAs (Algebra (D.alg i) (MvPolynomial (Fin P.n) (D.alg j) ⧸ L.rel j))
  let : Algebra (L.Q i) (L.Q j) := (L.QMap h).toAlgebra
  let : IsScalarTower (D.alg i) (D.alg j) (L.Q j) :=
    inferInstanceAs (IsScalarTower (D.alg i) (D.alg j)
      (MvPolynomial (Fin P.n) (D.alg j) ⧸ L.rel j))
  let : IsScalarTower (D.alg i) (L.Q i) (L.Q j) :=
    IsScalarTower.of_algebraMap_eq fun s ↦ by
      change algebraMap (D.alg j) (L.Q j) (D.algMap i j h s) =
        L.QMap h (algebraMap (D.alg i) (L.Q i) s)
      exact (L.QMap_algebraMap h s).symm
  have hpush : _root_.Algebra.IsPushout (D.alg i) (D.alg j) (L.Q i) (L.Q j) := by
    let : Algebra (MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i)
        (MvPolynomial (Fin P.n) (D.alg j) ⧸ L.rel j) := (L.QMap h).toAlgebra
    let : IsScalarTower (D.alg i) (MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i)
        (MvPolynomial (Fin P.n) (D.alg j) ⧸ L.rel j) :=
      inferInstanceAs (IsScalarTower (D.alg i) (L.Q i) (L.Q j))
    change _root_.Algebra.IsPushout (D.alg i) (D.alg j)
      (MvPolynomial (Fin P.n) (D.alg i) ⧸ L.rel i) (MvPolynomial (Fin P.n) (D.alg j) ⧸ L.rel j)
    apply isPushout_quotient_of_ideal_map_eq (L.rel i) (L.rel j) (L.rel_map h)
    apply RingHom.ext
    intro g
    exact L.QMap_mkQ h g
  let : Algebra (L.tower.st.base i) (L.tower.st.base j) :=
    (L.tower.st.baseMap i j h).toAlgebra
  let : Algebra (L.tower.st.base i) (L.Q i) := inferInstanceAs (Algebra (D.alg i) (L.Q i))
  let : Algebra (L.tower.st.base i) (L.Q j) := inferInstanceAs (Algebra (D.alg i) (L.Q j))
  let : Algebra (L.tower.st.base j) (L.Q j) := inferInstanceAs (Algebra (D.alg j) (L.Q j))
  let : IsScalarTower (L.tower.st.base i) (L.Q i) (L.Q j) :=
    inferInstanceAs (IsScalarTower (D.alg i) (L.Q i) (L.Q j))
  let : IsScalarTower (L.tower.st.base i) (L.tower.st.base j) (L.Q j) :=
    inferInstanceAs (IsScalarTower (D.alg i) (D.alg j) (L.Q j))
  let : _root_.Algebra.IsPushout (L.tower.st.base i) (L.Q i) (L.tower.st.base j) (L.Q j) :=
    hpush.symm
  let : Algebra (L.Q i) (L.tower.st.alg i) := inferInstanceAs (Algebra (L.Q i) (L.Tl i))
  let : Algebra (L.Q j) (L.tower.st.alg j) := inferInstanceAs (Algebra (L.Q j) (L.Tl j))
  let : IsScalarTower (L.tower.st.base i) (L.Q i) (L.tower.st.alg i) :=
    inferInstanceAs (IsScalarTower (D.alg i) (L.Q i) (L.Tl i))
  let : IsScalarTower (L.tower.st.base j) (L.Q j) (L.tower.st.alg j) :=
    inferInstanceAs (IsScalarTower (D.alg j) (L.Q j) (L.Tl j))
  let : IsLocalization (L.q i).primeCompl (L.tower.st.alg i) :=
    inferInstanceAs (IsLocalization (L.q i).primeCompl (L.Tl i))
  let : IsLocalization (L.q j).primeCompl (L.tower.st.alg j) :=
    inferInstanceAs (IsLocalization (L.q j).primeCompl (L.Tl j))
  apply LocalAlgebraSystem.isPrimeLocalization_of_quotient_pushout L.tower.st h
    (L.q i).primeCompl (L.q j).primeCompl
  apply RingHom.ext
  intro a
  exact L.TMap_algebraMap h a

/-- Over a ring approximation system, the tower satisfies all simultaneous ring approximation
conditions. -/
theorem tower_isApproximation (hD : D.IsApproximation) : L.tower.IsApproximation :=
  ⟨hD, L.tower_st_isColimit hD.1, fun i ↦ L.essFiniteType_Tl i,
    fun _ _ h ↦ L.isPrimeLocalization_st h,
    fun i j h ↦ L.tower.rt_isPrimeLocalization h (hD.2.2.2 i j h) (L.isPrimeLocalization_st h)⟩

end RelLift

end

/-- The relations of a presentation of `T` over `S` lift compatibly to the components of the
tail of a ring system above some index. -/
theorem exists_relLift (D : LocalAlgebraSystem.{uI, uA, uB} ι R S)
    (hD : Function.Surjective D.algebraColimitMap) (P : Pres S S T (RingEquiv.refl S)) :
    ∃ i₀, Nonempty (RelLift (D.tail i₀) P) := by
  obtain ⟨i₀, x, hx⟩ := D.exists_map_algι_eq_fun hD (fun f : P.F ↦ f.1)
  refine ⟨i₀, ⟨⟨fun j f ↦ map (D.algMap i₀ j.1 j.2) (x f), fun j k h f ↦ ?_, fun j f ↦ ?_⟩⟩⟩
  · exact D.map_algMap_map_algMap j.2 h (x f)
  · change map (D.algι j.1) (map (D.algMap i₀ j.1 j.2) (x f)) = f
    rw [D.map_algι_map_algMap, hx]

end LocalAlgebraTowerApproximation

end Langlands.Algebra
