import Langlands.Algebra.LieWeightCenterProjection
import Langlands.Algebra.LieEnvelopingSymbol
import Langlands.Algebra.MvPolynomialDerivationGrading
import Mathlib.Algebra.MvPolynomial.PDeriv

/-! # Central elements in the positive right ideal vanish -/

noncomputable section

universe u v w z

set_option autoImplicit false

namespace Langlands.Algebra.LieCenterProjectionInjective

open Langlands.Algebra.UniversalEnveloping Langlands.Archimedean.Kostant
  Langlands.Archimedean.VermaPBW Langlands.Algebra.LieWeightProjection
  Langlands.Algebra.LieEnvelopingSymbol Langlands.Algebra.MvPolynomialDerivationGrading
  MvPolynomial

attribute [local instance 100] LieRing.ofAssociativeRing

variable {k : Type u} [Field k] {L : Type v} [LieRing L] [LieAlgebra k L]
  {I : Type w} [Fintype I] [DecidableEq I] (b : Module.Basis I k L) (d : I → ℝ)

local notation "U" => UniversalEnvelopingAlgebra k L
local notation "ι" => UniversalEnvelopingAlgebra.ι k

/-- The weight counting the letters of nonzero grading. -/
def letterWeight (a : I) : ℤ := if d a = 0 then 0 else 1

omit [Fintype I] [DecidableEq I] in
theorem letterWeight_eq_zero_or_one (a : I) : letterWeight d a = 0 ∨ letterWeight d a = 1 := by
  unfold letterWeight
  split_ifs <;> simp

omit [DecidableEq I] in
theorem weightedHomogeneousComponent_ξ (x : L) (n : ℤ) :
    weightedHomogeneousComponent (letterWeight d) n (ξ b x) =
      ∑ c, if letterWeight d c = n then b.repr x c • X c else 0 := by
  classical
  rw [ξ_apply, map_sum]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [map_smul, weightedHomogeneousComponent_of_mem (isWeightedHomogeneous_X k _ c)]
  split_ifs with h1 h2 h2
  · rfl
  · exact absurd h1.symm h2
  · exact absurd h2.symm h1
  · simp

omit [DecidableEq I] in
/-- The values of `adDer y` on the variables shift the letter weight by at most one. -/
theorem component_adDer_X_eq_zero (y : L) (i : I) (n : ℤ) (h1 : n ≠ letterWeight d i - 1)
    (h2 : n ≠ letterWeight d i) (h3 : n ≠ letterWeight d i + 1) :
    weightedHomogeneousComponent (letterWeight d) n (adDer b y (X i)) = 0 := by
  rw [adDer_X, weightedHomogeneousComponent_ξ]
  refine Finset.sum_eq_zero fun c _ => ?_
  rw [ite_eq_right]
  intro h
  rcases letterWeight_eq_zero_or_one d c with hc | hc <;>
    rcases letterWeight_eq_zero_or_one d i with hi | hi <;> omega

omit [DecidableEq I] in
theorem ξ_injective : Function.Injective (ξ b) := by
  classical
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro x hx
  apply b.repr.injective
  ext c
  have h := congrArg (fun p => p.coeff (Finsupp.single c 1)) hx
  simp only [ξ_apply, coeff_sum, coeff_smul, coeff_X, smul_eq_mul] at h
  simpa [Finsupp.single_eq_single_iff] using h

omit [DecidableEq I] in
/-- A derivation of a polynomial ring in finitely many variables is the sum of the partial
derivatives weighted by its values on the variables. -/
theorem derivation_apply_eq_sum_pderiv (D : Derivation k (MvPolynomial I k) (MvPolynomial I k))
    (p : MvPolynomial I k) : D p = ∑ i, pderiv i p * D (X i) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [← algebraMap_eq, Derivation.map_algebraMap]
    simp [algebraMap_eq]
  | add p q hp hq => rw [map_add, hp, hq, ← Finset.sum_add_distrib]; simp [add_mul]
  | mul_X p j hp =>
    have h1 : ∀ i, pderiv i (p * X j) * D (X i) =
        X j * (pderiv i p * D (X i)) +
          p * (Pi.single (M := fun _ => MvPolynomial I k) i 1 j * D (X i)) := by
      intro i
      rw [Derivation.leibniz, pderiv_X, smul_eq_mul, smul_eq_mul]
      ring
    rw [Derivation.leibniz, hp, smul_eq_mul, smul_eq_mul]
    simp_rw [h1]
    have h2 : ∑ i, Pi.single (M := fun _ => MvPolynomial I k) i 1 j * D (X i) = D (X j) := by
      rw [Finset.sum_eq_single j]
      · simp only [Pi.single_eq_same, one_mul]
      · intro i _ hij
        rw [Pi.single_eq_of_ne (Ne.symm hij), zero_mul]
      · simp
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, h2]
    ring

variable [CharZero k]

/-- **Vanishing of positive central elements.** Let the basis `b` of `L` be graded by
`d = ψ ∘ ev`, where `ev` are the eigenvalues of `ad H`. Suppose that for every nonzero polynomial
whose monomials all contain a letter of positive grading, the weight-lowering part of some
`adDer y` does not annihilate it. Then a central element of `U(L)` in the right ideal
generated by the positive basis vectors is zero. -/
theorem center_eq_zero_of_mem_positiveWeightRightIdeal (ev : I → k) (ψ : k →+ ℝ)
    (hψ : ∀ a, ψ (ev a) = d a) (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)
    (hnd : ∀ t : MvPolynomial I k, t ≠ 0 → (∀ α ∈ t.support, ∃ i, 0 < d i ∧ α i ≠ 0) →
      ∃ y, shiftPart (letterWeight d) (adDer b y) (-1) t ≠ 0)
    (zc : Subalgebra.center k U) (hz : zc.val ∈ positiveWeightRightIdeal b d) : zc.val = 0 := by
  have hbs := weightOrderedIndices_nodup d
  have hall := mem_weightOrderedIndices d
  have hpos : zc.val ∈ positivePBWSpan b d :=
    positiveWeightRightIdeal_le_positivePBWSpan b d
      (positiveWeightLieSubalgebra b d ev ψ hψ H hH).incl
      (positiveWeightLieBasis b d ev ψ hψ H hH)
      (positiveWeightLieSubalgebra_incl_basis b d ev ψ hψ H hH) hz
  have key (N : ℕ) (hN : zc.val ∈ degreeFiltration k L N) : symbol b hbs hall N zc.val = 0 := by
    refine eq_zero_of_derivations (letterWeight d) (fun y => adDer b y)
      (fun y i n h1 h2 h3 => component_adDer_X_eq_zero b d y i n h1 h2 h3)
      (fun α => ∃ i, 0 < d i ∧ α i ≠ 0) hnd _ ?_ ?_
    · intro α hα
      rw [MvPolynomial.mem_support_iff, coeff_symbol] at hα
      by_contra hno
      push Not at hno
      apply hα
      split_ifs
      · exact positivePBWSpan_coord_zero b d hno hpos
      · rfl
    · intro y
      change adDer b y (symbol b hbs hall N zc.val) = 0
      rw [← symbol_commutator_adDer b hbs hall y hN,
        sub_eq_zero.mpr (Subalgebra.mem_center_iff.mp zc.property (ι y)), map_zero]
  have main (N : ℕ) : zc.val ∈ degreeFiltration k L N → zc.val = 0 := by
    induction N with
    | zero => exact fun h0 => eq_zero_of_mem_zero_of_symbol_eq_zero b hbs hall h0 (key 0 h0)
    | succ N ih =>
      exact fun hN => ih (mem_degreeFiltration_of_symbol_eq_zero b hbs hall hN (key _ hN))
  obtain ⟨M, hM⟩ := exists_mem_degreeFiltration k L zc.val
  exact main M hM

/-- **Nondegeneracy from an invariant form.** Suppose a form `B` on `L` pairs the basis vectors
of opposite weights `wt` and opposite gradings `d`, and is nondegenerate. Suppose the
grading-zero part of `⁅b e, b i⁆` for `d e < 0 < d i` is `-B(b e, b i) T(wt i)` for a nonzero
vector `T(wt i)` of grading zero. Then every nonzero polynomial whose monomials all contain a
letter of positive grading is not annihilated by the weight-lowering part of some `adDer`. -/
theorem exists_shiftPart_ne_zero {Γ : Type z} [AddCommGroup Γ] (wt : I → Γ)
    (B : LinearMap.BilinForm k L) (T : Γ → L)
    (hB : ∀ v : L, (∀ e, B (b e) v = 0) → v = 0)
    (hBwt : ∀ e i, B (b e) (b i) ≠ 0 → wt e = -wt i)
    (hBd : ∀ e i, B (b e) (b i) ≠ 0 → d e = -d i)
    (hsupp : ∀ e i c, b.repr ⁅b e, b i⁆ c ≠ 0 → d c = d e + d i)
    (hcartan : ∀ e i c, d e < 0 → 0 < d i → d c = 0 →
      b.repr ⁅b e, b i⁆ c = -(B (b e) (b i) * b.repr (T (wt i)) c))
    (hT : ∀ i, 0 < d i → T (wt i) ≠ 0)
    (hTzero : ∀ γ c, d c ≠ 0 → b.repr (T γ) c = 0)
    (t : MvPolynomial I k) (ht : t ≠ 0) (htpos : ∀ α ∈ t.support, ∃ i, 0 < d i ∧ α i ≠ 0) :
    ∃ y, shiftPart (letterWeight d) (adDer b y) (-1) t ≠ 0 := by
  classical
  obtain ⟨α₀, hα₀⟩ := support_nonempty.mpr ht
  obtain ⟨i₀, hi₀, hαi₀⟩ := htpos α₀ hα₀
  set γ := wt i₀
  set μ := α₀ - Finsupp.single i₀ 1
  have hμ : μ + Finsupp.single i₀ 1 = α₀ := by
    ext j
    simp only [μ, Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
      Finsupp.single_apply]
    split_ifs with h
    · subst h; omega
    · omega
  have hcoef : (pderiv i₀ t).coeff μ ≠ 0 := by
    rw [coeff_pderiv, hμ]
    refine mul_ne_zero (MvPolynomial.mem_support_iff.mp hα₀) ?_
    have : (μ i₀ : k) + 1 = ((μ i₀ + 1 : ℕ) : k) := by push_cast; ring
    rw [this]
    exact Nat.cast_ne_zero.mpr (by omega)
  set a : I → k := fun i => if 0 < d i ∧ wt i = γ then (pderiv i t).coeff μ else 0
  set v : L := ∑ i, a i • b i
  have hv : v ≠ 0 := by
    intro h
    have hr := congrArg (fun x => b.repr x i₀) h
    simp only [v, map_sum, map_smul, Module.Basis.repr_self, Finsupp.coe_finsetSum,
      Finset.sum_apply, Finsupp.smul_apply, Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one,
      mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true, map_zero,
      Finsupp.zero_apply] at hr
    simp only [a, hi₀, true_and] at hr
    rw [ite_eq_left (rfl : wt i₀ = γ)] at hr
    exact hcoef hr
  obtain ⟨e, he⟩ : ∃ e, B (b e) v ≠ 0 := by
    by_contra h
    push Not at h
    exact hv (hB v h)
  have hBv : B (b e) v = ∑ i, a i * B (b e) (b i) := by
    simp only [v, map_sum, map_smul, smul_eq_mul]
  obtain ⟨i₁, hi₁⟩ : ∃ i, a i * B (b e) (b i) ≠ 0 := by
    by_contra h
    push Not at h
    exact he (by rw [hBv]; exact Finset.sum_eq_zero fun i _ => h i)
  have ha₁ : a i₁ ≠ 0 := left_ne_zero_of_mul hi₁
  have hB₁ : B (b e) (b i₁) ≠ 0 := right_ne_zero_of_mul hi₁
  have hcond₁ : 0 < d i₁ ∧ wt i₁ = γ := by
    by_contra h
    exact ha₁ (by simp only [a, ite_eq_right h])
  have hde : d e < 0 := by rw [hBd e i₁ hB₁]; linarith [hcond₁.1]
  have hwte : wt e = -γ := by rw [hBwt e i₁ hB₁, hcond₁.2]
  have hwt (i : I) (hB' : B (b e) (b i) ≠ 0) : wt i = γ := by
    have := hBwt e i hB'
    rw [hwte] at this
    exact neg_injective this.symm
  refine ⟨b e, ?_⟩
  -- the values of the lowering part on the variables
  have hval (i : I) : shiftPart (letterWeight d) (adDer b (b e)) (-1) (X i) =
      (if 0 < d i then -B (b e) (b i) else 0) • ξ b (T γ) := by
    rw [shiftPart_X, adDer_X, weightedHomogeneousComponent_ξ]
    by_cases hdi : d i = 0
    · have hw : letterWeight d i + -1 = -1 := by simp [letterWeight, hdi]
      rw [hw, ite_eq_right (by rw [hdi]; exact lt_irrefl 0), zero_smul]
      refine Finset.sum_eq_zero fun c _ => ?_
      rw [ite_eq_right]
      rcases letterWeight_eq_zero_or_one d c with h | h <;> omega
    · have hw : letterWeight d i + -1 = 0 := by simp [letterWeight, hdi]
      rw [hw]
      have hc0 (c : I) : (letterWeight d c = 0) ↔ d c = 0 := by
        unfold letterWeight; split_ifs with h <;> simp [h]
      rcases lt_or_gt_of_ne hdi with hneg | hpos
      · rw [ite_eq_right (by linarith), zero_smul]
        refine Finset.sum_eq_zero fun c _ => ?_
        split_ifs with h
        · have : b.repr ⁅b e, b i⁆ c = 0 := by
            by_contra hne
            have := hsupp e i c hne
            rw [(hc0 c).mp h] at this
            linarith
          rw [this, zero_smul]
        · rfl
      · rw [ite_eq_left hpos]
        by_cases hBi : B (b e) (b i) = 0
        · rw [hBi, neg_zero, zero_smul]
          refine Finset.sum_eq_zero fun c _ => ?_
          split_ifs with h
          · rw [hcartan e i c hde hpos ((hc0 c).mp h), hBi, zero_mul, neg_zero, zero_smul]
          · rfl
        · rw [← hwt i hBi, ξ_apply, Finset.smul_sum]
          refine Finset.sum_congr rfl fun c _ => ?_
          split_ifs with h
          · rw [hcartan e i c hde hpos ((hc0 c).mp h), smul_smul]
            congr 1
            ring
          · rw [hTzero _ c (fun h' => h ((hc0 c).mpr h')), zero_smul, smul_zero]
  set S : MvPolynomial I k := ∑ i, (if 0 < d i then B (b e) (b i) else 0) • pderiv i t
  have hDt : shiftPart (letterWeight d) (adDer b (b e)) (-1) t = -(ξ b (T γ) * S) := by
    rw [derivation_apply_eq_sum_pderiv]
    simp only [hval, S, Finset.mul_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    split_ifs
    · simp only [Algebra.smul_def, algebraMap_eq, map_neg]
      ring
    · simp
  have hS : S ≠ 0 := by
    intro h
    have hc := congrArg (fun p => p.coeff μ) h
    simp only [S, coeff_sum, coeff_smul, smul_eq_mul, AddMonoidAlgebra.coeff_zero,
      Finsupp.coe_zero, Pi.zero_apply] at hc
    apply he
    rw [hBv, ← hc]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [a]
    by_cases hdi : 0 < d i
    · by_cases hBi : B (b e) (b i) = 0
      · simp [hBi]
      · rw [ite_eq_left ⟨hdi, hwt i hBi⟩, ite_eq_left hdi, mul_comm]
    · rw [ite_eq_right (fun h => hdi h.1), ite_eq_right hdi, zero_mul, zero_mul]
  have hξ : ξ b (T γ) ≠ 0 := fun h => hT i₀ hi₀ (ξ_injective b (by rw [h, map_zero]))
  rw [hDt, neg_ne_zero]
  exact mul_ne_zero hξ hS

end Langlands.Algebra.LieCenterProjectionInjective
