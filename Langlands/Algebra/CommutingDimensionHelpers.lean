import Mathlib.LinearAlgebra.Charpoly.Basic
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.RingTheory.PowerBasis
import Mathlib.RingTheory.Nakayama

/-! Supporting algebraic lemmas for the nilpotent commuting-dimension estimate. -/

noncomputable section
open scoped Pointwise IsMulCommutative

namespace Langlands.CommutingDimension

universe uK uV

variable (K : Type uK) [Field K] (V : Type uV)
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]

omit [FiniteDimensional K V] in
/-- The scalar subalgebra has dimension at most one, including the zero space. -/
theorem zero_generators (a : Fin 0 → Module.End K V) :
    Module.finrank K (Algebra.adjoin K (Set.range a)) ≤ 1 := by
  rcases subsingleton_or_nontrivial V with hV | hV
  · have : Subsingleton V := hV
    rw [Module.finrank_zero_of_subsingleton]
    exact Nat.zero_le _
  · have : Nontrivial V := hV
    rw [Set.range_eq_empty, Algebra.adjoin_empty, Subalgebra.finrank_bot]

/-- The algebra generated by one endomorphism has dimension at most `dim V`. -/
theorem singleton_dimension (f : Module.End K V) :
    Module.finrank K (Algebra.adjoin K {f}) ≤ Module.finrank K V := by
  classical
  have hspan : (Algebra.adjoin K {f}).toSubmodule =
      Submodule.span K (Set.range fun i : Fin (minpoly K f).natDegree => f ^ (i : ℕ)) := by
    apply le_antisymm
    · intro g hg
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hg
      obtain ⟨p, hp⟩ := hg
      exact (LinearMap.isIntegral f).mem_span_pow ⟨p, hp.symm⟩
    · refine Submodule.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      exact (Algebra.adjoin K {f}).pow_mem (Algebra.subset_adjoin (Set.mem_singleton f)) _
  calc
    Module.finrank K (Algebra.adjoin K {f}) =
        Module.finrank K (Submodule.span K
          (Set.range fun i : Fin (minpoly K f).natDegree => f ^ (i : ℕ))) := by
      change Module.finrank K (Algebra.adjoin K {f}).toSubmodule = _
      rw [hspan]
    _ ≤ (minpoly K f).natDegree := by
      exact (finrank_span_le_card _).trans (by
        simpa only [Set.toFinset_card, Fintype.card_fin] using
          Fintype.card_range_le (fun i : Fin (minpoly K f).natDegree => f ^ (i : ℕ)))
    _ ≤ f.charpoly.natDegree :=
      Polynomial.natDegree_le_of_dvd f.minpoly_dvd_charpoly f.charpoly_monic.ne_zero
    _ = Module.finrank K V := f.charpoly_natDegree

/-- The natural-power estimate for one generator. -/
theorem one_generator (a : Fin 1 → Module.End K V) :
    Module.finrank K (Algebra.adjoin K (Set.range a)) ^ (2 ^ 1) ≤
      Module.finrank K V ^ (2 ^ (1 + 1) - 2) := by
  have h : Set.range a = {a 0} := by
    ext f
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      exact congrArg a (Subsingleton.elim _ _)
    · rintro rfl
      exact ⟨0, rfl⟩
  rw [h]
  simpa using Nat.pow_le_pow_left (singleton_dimension K V (a 0)) 2

omit [FiniteDimensional K V] in
/-- A commuting algebra is determined by its action on an algebra-generating subspace. -/
theorem restriction_injective (C : Subalgebra K (Module.End K V))
    (hcomm : ∀ c d : C, Commute (c : Module.End K V) (d : Module.End K V))
    (L : Submodule K V)
    (hspan : Submodule.span K {v : V | ∃ c : C, ∃ x : L, v = c.val x} = ⊤) :
    Function.Injective ((LinearMap.domRestrict' L).comp C.val.toLinearMap) := by
  apply LinearMap.ker_eq_bot.mp
  apply eq_bot_iff.mpr
  intro c hc
  have hcL : (c : Module.End K V).domRestrict L = 0 := hc
  have hker : Submodule.span K {v : V | ∃ d : C, ∃ x : L, v = d.val x} ≤
      (c : Module.End K V).ker := by
    refine Submodule.span_le.mpr ?_
    rintro v ⟨d, x, rfl⟩
    change c.val (d.val x) = 0
    calc
      _ = d.val (c.val x) :=
        congrArg (fun f : Module.End K V => f (x : V)) (hcomm c d).eq
      _ = 0 := by
        rw [show c.val x = 0 from LinearMap.congr_fun hcL x, map_zero]
  have hc0 : c = 0 := by
    apply Subtype.ext
    apply LinearMap.ext
    intro v
    exact hker (by rw [hspan]; trivial)
  simp only [hc0, Submodule.zero_mem]

/-- The restriction injection bounds the algebra dimension by `dim L * dim V`. -/
theorem dimension_le_generating_subspace (C : Subalgebra K (Module.End K V))
    (hcomm : ∀ c d : C, Commute (c : Module.End K V) (d : Module.End K V))
    (L : Submodule K V)
    (hspan : Submodule.span K {v : V | ∃ c : C, ∃ x : L, v = c.val x} = ⊤) :
    Module.finrank K C ≤ Module.finrank K L * Module.finrank K V := by
  have h := LinearMap.finrank_le_finrank_of_injective
    (restriction_injective K V C hcomm L hspan)
  simpa only [Module.finrank_linearMap] using h

/-- Nakayama upgrades generation modulo a radical ideal to generation by the algebra. -/
theorem span_action_of_sup_radical_eq_top
    (C : Subalgebra K (Module.End K V)) [IsMulCommutative C]
    (J : Ideal C) (hJ : J ≤ (⊥ : Ideal C).radical)
    (L : Submodule K V)
    (hL : L ⊔ (J • (⊤ : Submodule C V)).restrictScalars K = ⊤) :
    Submodule.span K {v : V | ∃ c : C, ∃ x : L, v = c.val x} = ⊤ := by
  let : Module.Finite C V := Module.Finite.of_restrictScalars_finite K C V
  let N : Submodule C V := Submodule.span C (L : Set V)
  have htop : (⊤ : Submodule C V) ≤ N ⊔ J • ⊤ := by
    intro v _
    have hv : v ∈ L ⊔ (J • (⊤ : Submodule C V)).restrictScalars K := by
      rw [hL]
      trivial
    obtain ⟨x, hx, y, hy, rfl⟩ := Submodule.mem_sup.mp hv
    exact Submodule.mem_sup.mpr ⟨x, Submodule.subset_span hx, y, hy, rfl⟩
  have hN : N = ⊤ := top_unique <|
    Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
      (hJ.trans Ideal.radical_le_jacobson) htop
  have hset : {v : V | ∃ c : C, ∃ x : L, v = c.val x} =
      (Set.univ : Set C) • (L : Set V) := by
    ext v
    constructor
    · rintro ⟨c, x, rfl⟩
      exact ⟨c, Set.mem_univ _, x, x.property, rfl⟩
    · rintro ⟨c, _, x, hx, rfl⟩
      exact ⟨c, ⟨x, hx⟩, rfl⟩
  rw [hset, Submodule.span_smul_of_span_eq_top (Submodule.span_univ (R := K))]
  change N.restrictScalars K = ⊤
  rw [hN, Submodule.restrictScalars_top]

/-- A complement to `J V` bounds the dimension of the commuting algebra. -/
theorem dimension_le_radical_codimension
    (C : Subalgebra K (Module.End K V)) [IsMulCommutative C]
    (J : Ideal C) (hJ : J ≤ (⊥ : Ideal C).radical) :
    Module.finrank K C ≤
      (Module.finrank K V -
        Module.finrank K ((J • (⊤ : Submodule C V)).restrictScalars K)) *
      Module.finrank K V := by
  let W := (J • (⊤ : Submodule C V)).restrictScalars K
  obtain ⟨L, hL⟩ := Submodule.exists_isCompl W
  have hspan := span_action_of_sup_radical_eq_top K V C J hJ L
    hL.symm.codisjoint.eq_top
  have hdim := Submodule.finrank_add_eq_of_isCompl hL
  have hcomm : ∀ c d : C, Commute (c : Module.End K V) (d : Module.End K V) := by
    intro c d
    exact congrArg Subtype.val (mul_comm c d)
  have hbound := dimension_le_generating_subspace K V C hcomm L hspan
  have hLdim : Module.finrank K L = Module.finrank K V - Module.finrank K W := by
    omega
  simpa only [hLdim] using hbound

omit [FiniteDimensional K V] in
/-- The action of an endomorphism algebra on an invariant subspace. -/
def restrictionAlgHom (C : Subalgebra K (Module.End K V)) (W : Submodule K V)
    (hW : ∀ c : C, ∀ v ∈ W, c.val v ∈ W) : C →ₐ[K] Module.End K W where
  toFun c := c.val.restrict (hW c)
  map_one' := by ext; rfl
  map_mul' _ _ := by ext; rfl
  map_zero' := by ext; rfl
  map_add' _ _ := by ext; rfl
  commutes' _ := by ext; rfl

/-- If `f(V)` lies in `W`, multiplication by `f` factors dimensionally through
the restriction of a commuting algebra to `W`. -/
theorem multiplication_dimension_le_restriction
    (C : Subalgebra K (Module.End K V))
    (hcomm : ∀ c d : C, Commute (c : Module.End K V) (d : Module.End K V))
    (f : C) (W : Submodule K V)
    (hW : ∀ c : C, ∀ v ∈ W, c.val v ∈ W)
    (hf : ∀ v : V, f.val v ∈ W) :
    Module.finrank K (LinearMap.range (LinearMap.mulLeft K f)) ≤
      Module.finrank K (restrictionAlgHom K V C W hW).range := by
  let r := (restrictionAlgHom K V C W hW).toLinearMap
  let t := LinearMap.mulLeft K f
  have hker : r.ker ≤ t.ker := by
    intro c hc
    change r c = 0 at hc
    change t c = 0
    apply Subtype.ext
    apply LinearMap.ext
    intro v
    change f.val (c.val v) = 0
    calc
      _ = c.val (f.val v) :=
        congrArg (fun g : Module.End K V => g v) (hcomm f c).eq
      _ = 0 := congrArg Subtype.val (LinearMap.congr_fun hc ⟨f.val v, hf v⟩)
  have hk := Submodule.finrank_mono hker
  have hr := r.finrank_range_add_finrank_ker
  have ht := t.finrank_range_add_finrank_ker
  change Module.finrank K t.range ≤ Module.finrank K r.range
  omega

/-- Adjoining one element to a subalgebra gives a sum with its multiplication image. -/
theorem dimension_adjoin_insert
    (E : Type*) [CommRing E] [Algebra K E] [FiniteDimensional K E]
    (B : Subalgebra K E) (f : E)
    (hgen : Algebra.adjoin K (insert f (B : Set E)) = ⊤) :
    Module.finrank K E ≤ Module.finrank K B +
      Module.finrank K (LinearMap.range (LinearMap.mulLeft K f)) := by
  let t := LinearMap.mulLeft K f
  let U := B.toSubmodule ⊔ t.range
  have hUone : (1 : E) ∈ U := Submodule.mem_sup_left B.one_mem
  have hUmul : ∀ x y : E, x ∈ U → y ∈ U → x * y ∈ U := by
    intro x y hx hy
    obtain ⟨b, hb, u, hu, rfl⟩ := Submodule.mem_sup.mp hx
    obtain ⟨c, rfl⟩ := hu
    obtain ⟨d, hd, v, hv, rfl⟩ := Submodule.mem_sup.mp hy
    obtain ⟨e, rfl⟩ := hv
    refine Submodule.mem_sup.mpr ⟨b * d, B.mul_mem hb hd,
      f * (b * e + c * d + f * c * e), ?_, ?_⟩
    · exact ⟨b * e + c * d + f * c * e, rfl⟩
    · change b * d + f * (b * e + c * d + f * c * e) =
        (b + f * c) * (d + f * e)
      ring
  let A : Subalgebra K E := U.toSubalgebra hUone hUmul
  have htop : (⊤ : Subalgebra K E) ≤ A := by
    rw [← hgen]
    apply Algebra.adjoin_le
    intro x hx
    rcases hx with rfl | hx
    · exact Submodule.mem_sup_right ⟨1, mul_one _⟩
    · exact Submodule.mem_sup_left hx
  have hU : U = ⊤ := top_unique fun x hx => htop hx
  have hdim := Submodule.finrank_add_le_finrank_add_finrank B.toSubmodule t.range
  change Module.finrank K U ≤ _ at hdim
  rw [hU, finrank_top] at hdim
  exact hdim

end Langlands.CommutingDimension
