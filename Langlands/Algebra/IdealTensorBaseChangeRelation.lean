import Langlands.Algebra.IdealTensorRelation
import Mathlib.RingTheory.Flat.Equalizer
import Mathlib.RingTheory.Flat.Stability
import Mathlib.RingTheory.Ideal.Over

/-! # Generator relations after a base change of the ring

Let `I` be an ideal of `R`, generated by `g k`, such that `(R ⧸ I) ⊗[R] M` is flat over
`R ⧸ I`, and let `R → R'` be a ring map. A relation `∑ k, g k • y k = 0` in `R' ⊗[R] M`
gives an element `∑ k, g k ⊗ y k` of `I R' ⊗[R'] (R' ⊗[R] M)`. We show that this element
is an `R'`-linear combination of the elements `∑ k, g k ⊗ (1 ⊗ z k)` coming from relations
`∑ k, g k • z k = 0` in `M`. This is the elementwise content of the surjectivity of
`Tor₁^R(M, R ⧸ I) ⊗[R] R' → Tor₁^{R'}(R' ⊗[R] M, R' ⧸ I R')` used in the proof of Stacks
Project Lemma 10.99.14 (tag 00MO). -/

open scoped TensorProduct

namespace Langlands.Algebra
namespace IdealTensorRelation

section Flat

/-- In a flat module, a relation with elements of an ideal has vanishing ideal tensor. -/
theorem sum_tmul_eq_zero_of_flat {B : Type*} [CommRing B] (J : Ideal B) {r : ℕ}
    (g : Fin r → J) {X : Type*} [AddCommGroup X] [Module B X] [Module.Flat B X]
    (x : Fin r → X) (hx : ∑ k, (g k : B) • x k = 0) : ∑ k, g k ⊗ₜ[B] x k = 0 := by
  apply Module.Flat.rTensor_preserves_injective_linearMap J.subtype Subtype.val_injective
  apply (TensorProduct.lid B X).injective
  simpa [map_sum] using hx

/-- If `K → F → P → 0` is exact with `P` flat, and `K₀ → K → F` is exact, then tensoring
`K → F` with any module kills no more than the image of `K₀`. -/
theorem ker_lTensor_le_range_of_flat {A : Type*} [CommRing A]
    {K₀ K F P : Type*} [AddCommGroup K₀] [Module A K₀] [AddCommGroup K] [Module A K]
    [AddCommGroup F] [Module A F] [AddCommGroup P] [Module A P] [Module.Flat A P]
    (j : K₀ →ₗ[A] K) (ι : K →ₗ[A] F) (π : F →ₗ[A] P) (hπ : Function.Surjective π)
    (hιπ : Function.Exact ι π) (hjι : Function.Exact j ι)
    (N : Type*) [AddCommGroup N] [Module A N] :
    LinearMap.ker (ι.lTensor N) ≤ LinearMap.range (j.lTensor N) := by
  let ιr : K →ₗ[A] LinearMap.ker π :=
    ι.codRestrict (LinearMap.ker π) fun k ↦ hιπ.apply_apply_eq_zero k
  have hιr : Function.Surjective ιr := fun ⟨x, hx⟩ ↦ by
    obtain ⟨k, hk⟩ := (hιπ x).mp hx
    exact ⟨k, Subtype.ext hk⟩
  have hjιr : Function.Exact j ιr := fun k ↦ by
    rw [← hjι k]
    exact Subtype.ext_iff
  have hinj := LinearMap.lTensor_injective_of_exact_of_flat (M := LinearMap.ker π) π hπ
    (LinearMap.ker π).subtype (LinearMap.ker π).injective_subtype
    (LinearMap.exact_subtype_ker_map π) N
  have hex := lTensor_exact (M := K₀) (N := K) (P := LinearMap.ker π) N hjιr hιr
  intro t ht
  have hcomp : ι.lTensor N = ((LinearMap.ker π).subtype.lTensor N) ∘ₗ (ιr.lTensor N) := by
    rw [← LinearMap.lTensor_comp]
    rfl
  rw [LinearMap.mem_ker, hcomp, LinearMap.comp_apply,
    ← map_zero ((LinearMap.ker π).subtype.lTensor N)] at ht
  exact (hex t).mp (hinj ht)

end Flat

section QuotientKernel

variable {R : Type*} [CommRing R] (I : Ideal R)
  {K F M : Type*} [AddCommGroup K] [Module R K] [AddCommGroup F] [Module R F]
  [AddCommGroup M] [Module R M]
  (ι : K →ₗ[R] F) (π : F →ₗ[R] M)

/-- The elements of `K` that `ι` maps into `I • F`. -/
abbrev idealPart : Submodule R K := (I • (⊤ : Submodule R F)).comap ι

/-- Modulo `I`, the kernel of `K → F` is the image of `idealPart`. -/
theorem exact_baseChange_idealPart :
    Function.Exact ((idealPart I ι).subtype.baseChange (R ⧸ I)) (ι.baseChange (R ⧸ I)) := by
  intro t
  constructor
  · intro ht
    obtain ⟨k, rfl⟩ := exists_eq_one_tmul I t
    rw [LinearMap.baseChange_tmul, one_tmul_eq_zero_iff] at ht
    exact ⟨1 ⊗ₜ ⟨k, ht⟩, rfl⟩
  · rintro ⟨s, rfl⟩
    obtain ⟨k, rfl⟩ := exists_eq_one_tmul I s
    rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul, one_tmul_eq_zero_iff]
    exact k.2

/-- Over `R ⧸ I`: tensoring the kernel inclusion with any module kills no more than the
image of `idealPart`, when `(R ⧸ I) ⊗[R] M` is flat. -/
theorem ker_lTensor_baseChange_le [Module.Flat (R ⧸ I) ((R ⧸ I) ⊗[R] M)]
    (hπ : Function.Surjective π) (hιπ : Function.Exact ι π)
    (N : Type*) [AddCommGroup N] [Module (R ⧸ I) N] :
    LinearMap.ker ((ι.baseChange (R ⧸ I)).lTensor N) ≤
      LinearMap.range (((idealPart I ι).subtype.baseChange (R ⧸ I)).lTensor N) := by
  have hπA : Function.Surjective (π.baseChange (R ⧸ I)) := LinearMap.lTensor_surjective _ hπ
  have hιπA : Function.Exact (ι.baseChange (R ⧸ I)) (π.baseChange (R ⧸ I)) :=
    lTensor_exact (M := K) (N := F) (P := M) (R ⧸ I) hιπ hπ
  exact ker_lTensor_le_range_of_flat (K₀ := (R ⧸ I) ⊗[R] idealPart I ι)
    (K := (R ⧸ I) ⊗[R] K) (F := (R ⧸ I) ⊗[R] F) (P := (R ⧸ I) ⊗[R] M)
    _ _ _ hπA hιπA (exact_baseChange_idealPart I ι) N

/-- Naturality of `cancelBaseChange` with respect to a map of the right factor. -/
theorem lTensor_cancelBaseChange (N : Type*) [AddCommGroup N] [Module (R ⧸ I) N] [Module R N]
    [IsScalarTower R (R ⧸ I) N] {X Y : Type*} [AddCommGroup X] [Module R X] [AddCommGroup Y]
    [Module R Y] (h : X →ₗ[R] Y) (s : N ⊗[R ⧸ I] ((R ⧸ I) ⊗[R] X)) :
    h.lTensor N (TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I) N X s) =
      TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I) N Y
        ((h.baseChange (R ⧸ I)).lTensor N s) := by
  induction s with
  | tmul n x =>
    induction x with
    | tmul a k => simp
    | add x y hx hy => simp only [TensorProduct.tmul_add, map_add, hx, hy]
  | add s s' hs hs' => simp only [map_add, hs, hs']

/-- Tensoring the kernel inclusion with a module over `R ⧸ I` kills no more than the image of
`idealPart`, when `(R ⧸ I) ⊗[R] M` is flat. -/
theorem ker_lTensor_le [Module.Flat (R ⧸ I) ((R ⧸ I) ⊗[R] M)]
    (hπ : Function.Surjective π) (hιπ : Function.Exact ι π)
    (N : Type*) [AddCommGroup N] [Module (R ⧸ I) N] [Module R N] [IsScalarTower R (R ⧸ I) N] :
    LinearMap.ker (ι.lTensor N) ≤ LinearMap.range ((idealPart I ι).subtype.lTensor N) := by
  intro t ht
  set eK := TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I) N K
  obtain ⟨s, rfl⟩ := eK.surjective t
  rw [LinearMap.mem_ker, lTensor_cancelBaseChange, LinearEquiv.map_eq_zero_iff] at ht
  obtain ⟨u, hu⟩ := ker_lTensor_baseChange_le I ι π hπ hιπ N ht
  refine ⟨TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I) N _ u, ?_⟩
  rw [lTensor_cancelBaseChange, hu]

end QuotientKernel

section BaseChange

variable {R R' : Type*} [CommRing R] [CommRing R'] [Algebra R R']

/-- Base change commutes with reduction modulo an ideal of the new ring. -/
theorem rTensor_mkQ_baseChange (J : Ideal R') {X Y : Type*} [AddCommGroup X] [Module R X]
    [AddCommGroup Y] [Module R Y] (h : X →ₗ[R] Y) (x : R' ⊗[R] X) :
    (Ideal.Quotient.mkₐ R J).toLinearMap.rTensor Y (h.baseChange R' x) =
      h.lTensor (R' ⧸ J) ((Ideal.Quotient.mkₐ R J).toLinearMap.rTensor X x) := by
  induction x with
  | tmul a k => simp
  | add x y hx hy => simp only [map_add, hx, hy]

/-- Reduction modulo `J` kills `J`-multiples. -/
theorem rTensor_mkQ_smul_eq_zero (J : Ideal R') {X : Type*} [AddCommGroup X] [Module R X]
    {a : R'} (ha : a ∈ J) (x : R' ⊗[R] X) :
    (Ideal.Quotient.mkₐ R J).toLinearMap.rTensor X (a • x) = 0 := by
  induction x with
  | tmul b k =>
    rw [TensorProduct.smul_tmul', LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply,
      smul_eq_mul, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr (J.mul_mem_right b ha), TensorProduct.zero_tmul]
  | add x y hx hy => rw [smul_add, map_add, hx, hy, add_zero]

/-- The kernel of reduction modulo `J` on `R' ⊗[R] X` is `J • ⊤`. -/
theorem mem_smul_top_of_rTensor_mkQ_eq_zero (J : Ideal R') {X : Type*} [AddCommGroup X]
    [Module R X] (x : R' ⊗[R] X)
    (hx : (Ideal.Quotient.mkₐ R J).toLinearMap.rTensor X x = 0) :
    x ∈ J • (⊤ : Submodule R' (R' ⊗[R] X)) := by
  have hJ : Function.Exact (J.restrictScalars R).subtype (Ideal.Quotient.mkₐ R J).toLinearMap :=
    fun y ↦ by simp [Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨u, rfl⟩ :=
    (rTensor_exact X hJ (Ideal.Quotient.mkₐ_surjective R J) x).mp hx
  clear hx
  induction u with
  | tmul j k =>
    have hj : ((j : R') ⊗ₜ[R] k : R' ⊗[R] X) = (j : R') • ((1 : R') ⊗ₜ[R] k) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [LinearMap.rTensor_tmul, Submodule.subtype_apply, hj]
    exact Submodule.smul_mem_smul j.2 Submodule.mem_top
  | add u v hu hv => rw [map_add]; exact Submodule.add_mem _ hu hv

variable (I : Ideal R) {r : ℕ} (g : Fin r → I) (M : Type*) [AddCommGroup M] [Module R M]

/-- The images in `I R'` of the generators of `I`. -/
abbrev mapGen (g : Fin r → I) : Fin r → I.map (algebraMap R R') :=
  fun k ↦ ⟨algebraMap R R' (g k), Ideal.mem_map_of_mem _ (g k).2⟩

theorem span_mapGen (hg : Ideal.span (Set.range fun k ↦ (g k : R)) = I) :
    Ideal.span (Set.range fun k ↦ (mapGen (R' := R') I g k : R')) =
      I.map (algebraMap R R') := by
  conv_rhs => rw [← hg]
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- The `R'`-span of the generator tensors of relations in `M`. -/
def relationSpan : Submodule R' (I.map (algebraMap R R') ⊗[R'] (R' ⊗[R] M)) :=
  Submodule.span R' {t | ∃ z : Fin r → M, ∑ k, (g k : R) • z k = 0 ∧
    t = ∑ k, mapGen (R' := R') I g k ⊗ₜ[R'] ((1 : R') ⊗ₜ[R] z k)}

section Presentation

variable {K F : Type*} [AddCommGroup K] [Module R K] [AddCommGroup F] [Module R F]
  (ι : K →ₗ[R] F) (π : F →ₗ[R] M)

/-- Base changes of elements of `idealPart` come from relations in `M`. -/
theorem exists_relation_of_idealPart (hg : Ideal.span (Set.range fun k ↦ (g k : R)) = I)
    (hιπ : Function.Exact ι π) (μ : R' ⊗[R] idealPart I ι) :
    ∃ u : Fin r → R' ⊗[R] F,
      ι.baseChange R' ((idealPart I ι).subtype.baseChange R' μ) =
        ∑ k, algebraMap R R' (g k) • u k ∧
      ∑ k, mapGen I g k ⊗ₜ[R'] π.baseChange R' (u k) ∈ relationSpan I g M := by
  induction μ with
  | tmul c k₁ =>
    obtain ⟨u', hu'⟩ := exists_sum_smul_of_mem_smul_top I g hg k₁.2
    refine ⟨fun k ↦ c ⊗ₜ u' k, ?_, ?_⟩
    · simp only [LinearMap.baseChange_tmul, Submodule.subtype_apply]
      rw [hu', TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [TensorProduct.tmul_smul, algebraMap_smul]
    · have hz : ∑ k, (g k : R) • π (u' k) = 0 := by
        simp only [← map_smul, ← map_sum, ← hu']
        exact hιπ.apply_apply_eq_zero _
      have heq : ∑ k, mapGen (R' := R') I g k ⊗ₜ[R'] π.baseChange R' (c ⊗ₜ u' k) =
          c • ∑ k, mapGen (R' := R') I g k ⊗ₜ[R'] ((1 : R') ⊗ₜ[R] π (u' k)) := by
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun k _ ↦ ?_
        rw [LinearMap.baseChange_tmul, ← TensorProduct.tmul_smul, TensorProduct.smul_tmul',
          smul_eq_mul, mul_one]
      rw [heq]
      exact Submodule.smul_mem _ c (Submodule.subset_span ⟨fun k ↦ π (u' k), hz, rfl⟩)
  | add μ₁ μ₂ h₁ h₂ =>
    obtain ⟨u₁, hu₁, hZ₁⟩ := h₁
    obtain ⟨u₂, hu₂, hZ₂⟩ := h₂
    refine ⟨u₁ + u₂, ?_, ?_⟩
    · simp only [map_add, hu₁, hu₂, Pi.add_apply, smul_add, Finset.sum_add_distrib]
    · simp only [Pi.add_apply, map_add, TensorProduct.tmul_add, Finset.sum_add_distrib]
      exact Submodule.add_mem _ hZ₁ hZ₂

/-- The relation lemma for a presentation `K → F → M → 0` with `F` flat. -/
theorem sum_tmul_mem_relationSpan_of_exact [Module.Flat R F]
    (hg : Ideal.span (Set.range fun k ↦ (g k : R)) = I)
    [Module.Flat (R ⧸ I) ((R ⧸ I) ⊗[R] M)] (hπ : Function.Surjective π)
    (hιπ : Function.Exact ι π) (y : Fin r → R' ⊗[R] M)
    (hy : ∑ k, algebraMap R R' (g k) • y k = 0) :
    ∑ k, mapGen I g k ⊗ₜ[R'] y k ∈ relationSpan I g M := by
  set I' := I.map (algebraMap R R')
  have hπι : ∀ w, π.baseChange R' (ι.baseChange R' w) = 0 := fun w ↦ by
    rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp, hιπ.linearMap_comp_eq_zero,
      LinearMap.baseChange_zero, LinearMap.zero_apply]
  -- Lift the relation to `R' ⊗[R] F`.
  have hπ' : Function.Surjective (π.baseChange R') := LinearMap.lTensor_surjective R' hπ
  choose y' hy' using fun k ↦ hπ' (y k)
  set v := ∑ k, algebraMap R R' (g k) • y' k
  have hv : π.baseChange R' v = 0 := by
    simp only [v, map_sum, map_smul, hy', hy]
  obtain ⟨κ, hκ⟩ := (lTensor_exact R' hιπ hπ v).mp hv
  replace hκ : ι.baseChange R' κ = v := hκ
  -- Reduce modulo `I R'` and use flatness modulo `I`.
  have hq : (Ideal.Quotient.mkₐ R I').toLinearMap.rTensor K κ ∈
      LinearMap.ker (ι.lTensor (R' ⧸ I')) := by
    rw [LinearMap.mem_ker, ← rTensor_mkQ_baseChange, hκ]
    simp only [v, map_sum]
    exact Finset.sum_eq_zero fun k _ ↦
      rTensor_mkQ_smul_eq_zero I' (Ideal.mem_map_of_mem _ (g k).2) _
  obtain ⟨μ', hμ'⟩ := ker_lTensor_le I ι π hπ hιπ (R' ⧸ I') hq
  obtain ⟨μ, rfl⟩ := LinearMap.rTensor_surjective _
    (g := (Ideal.Quotient.mkₐ R I').toLinearMap) (Ideal.Quotient.mkₐ_surjective R I') μ'
  have hdiff : κ - (idealPart I ι).subtype.baseChange R' μ ∈ I' • (⊤ : Submodule R' _) := by
    apply mem_smul_top_of_rTensor_mkQ_eq_zero
    rw [map_sub, rTensor_mkQ_baseChange, hμ', sub_self]
  obtain ⟨w, hw⟩ := exists_sum_smul_of_mem_smul_top I' (mapGen I g) (span_mapGen I g hg) hdiff
  obtain ⟨u, hu, hZ⟩ := exists_relation_of_idealPart I g M ι π hg hιπ μ
  -- A relation in the flat module `R' ⊗[R] F` has vanishing generator tensor.
  have h1 : ∑ k, algebraMap R R' (g k) • ι.baseChange R' (w k) =
      ι.baseChange R' (κ - (idealPart I ι).subtype.baseChange R' μ) := by
    rw [hw, map_sum]
    exact Finset.sum_congr rfl fun k _ ↦ (LinearMap.map_smul _ _ _).symm
  have hrel : ∑ k, algebraMap R R' (g k) • (y' k - u k - ι.baseChange R' (w k)) = 0 := by
    simp only [smul_sub, Finset.sum_sub_distrib]
    rw [← hu, h1, map_sub, hκ]
    abel
  have hflat := sum_tmul_eq_zero_of_flat I' (mapGen I g) _ hrel
  have h2 := congrArg ((π.baseChange R').lTensor I') hflat
  simp only [map_sum, LinearMap.lTensor_tmul, map_sub, hy', hπι, map_zero,
    TensorProduct.tmul_sub, TensorProduct.tmul_zero, Finset.sum_const_zero,
    Finset.sum_sub_distrib, sub_zero, sub_eq_zero] at h2
  rw [h2]
  exact hZ

end Presentation

/-- **Relation lemma.** If `(R ⧸ I) ⊗[R] M` is flat over `R ⧸ I`, then every relation
`∑ k, g k • y k = 0` in `R' ⊗[R] M` has generator tensor in `relationSpan`. -/
theorem sum_tmul_mem_relationSpan (hg : Ideal.span (Set.range fun k ↦ (g k : R)) = I)
    [Module.Flat (R ⧸ I) ((R ⧸ I) ⊗[R] M)] (y : Fin r → R' ⊗[R] M)
    (hy : ∑ k, algebraMap R R' (g k) • y k = 0) :
    ∑ k, mapGen I g k ⊗ₜ[R'] y k ∈ relationSpan I g M := by
  classical
  let π : (M →₀ R) →ₗ[R] M := Finsupp.linearCombination R id
  exact sum_tmul_mem_relationSpan_of_exact (K := LinearMap.ker π) (F := M →₀ R) I g M
    (LinearMap.ker π).subtype π hg (Finsupp.linearCombination_id_surjective R M)
    (LinearMap.exact_subtype_ker_map π) y hy

end BaseChange

end IdealTensorRelation
end Langlands.Algebra
