import Mathlib.Algebra.DirectSum.Decomposition
import Mathlib.RingTheory.Ideal.Cotangent

/-! # Homogeneous elements of a graded ideal and the sign of an additive functional -/

universe u v w

namespace Langlands.Algebra.GradedSignIdeal

open Classical

variable {k : Type u} [Field k] {R : Type v} [CommRing R] [Algebra k R]
    {Λ : Type w}

section AddCommGroup

variable [AddCommGroup Λ]

/-- The ideal of `R` generated by the homogeneous elements of `I` whose label has
nonpositive value under the additive functional `ν`. -/
def nonpositiveSpan (I : Ideal R) (W : Λ → Submodule k I) (ν : Λ →+ ℤ) : Ideal R :=
  Ideal.span {r | ∃ χ, ν χ ≤ 0 ∧ ∃ x ∈ W χ, r = (x : R)}

theorem mem_nonpositiveSpan (I : Ideal R) (W : Λ → Submodule k I) (ν : Λ →+ ℤ)
    {χ : Λ} (hχ : ν χ ≤ 0) {x : I} (hx : x ∈ W χ) :
    (x : R) ∈ nonpositiveSpan I W ν :=
  Ideal.subset_span ⟨χ, hχ, x, hx, rfl⟩

end AddCommGroup

private theorem square_induction (I : Ideal R) {P : I → Prop}
    (hmul : ∀ x y : I, P (x * y))
    (hadd : ∀ x y : I, P x → P y → P (x + y))
    (x : I) (hx : (x : R) ∈ I ^ 2) : P x := by
  rw [pow_two] at hx
  exact Submodule.mul_induction_on'
    (C := fun r hr => P ⟨r, Ideal.mul_le_left hr⟩)
    (fun a ha b hb => hmul ⟨a, ha⟩ ⟨b, hb⟩)
    (fun a ha b hb hpa hpb => hadd ⟨a, Ideal.mul_le_left ha⟩
      ⟨b, Ideal.mul_le_left hb⟩ hpa hpb) hx

private noncomputable def homogeneousProjection (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) (χ : Λ) : I →ₗ[k] I :=
  (W χ).subtype ∘ₗ DirectSum.component k Λ (fun ψ => W ψ) χ ∘ₗ
    (LinearEquiv.ofBijective (DirectSum.coeLinearMap W) hW).symm.toLinearMap

private theorem homogeneousProjection_same (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) (χ : Λ) {x : I} (hx : x ∈ W χ) :
    homogeneousProjection I W hW χ x = x :=
  congrArg Subtype.val (hW.ofBijective_coeLinearMap_of_mem hx)

private theorem homogeneousProjection_ne (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) {χ ψ : Λ} (hχψ : ψ ≠ χ)
    {x : I} (hx : x ∈ W ψ) :
    homogeneousProjection I W hW χ x = 0 :=
  congrArg Subtype.val (hW.ofBijective_coeLinearMap_of_mem_ne hχψ hx)

private theorem homogeneous_induction (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) {P : I → Prop} (hzero : P 0)
    (hhom : ∀ (χ : Λ) (x : I), x ∈ W χ → P x)
    (hadd : ∀ x y : I, P x → P y → P (x + y)) : ∀ x : I, P x := by
  let := hW.chooseDecomposition
  exact DirectSum.Decomposition.inductionOn W hzero
    (fun {χ} x => hhom χ x x.property) hadd

variable [AddCommGroup Λ]

/-- The induction on the value of `ν`: homogeneous elements of `I` whose label `χ` has
`ν χ ≤ n` and `ζ χ ≤ 0` lie in the nonpositive span of `ν`. -/
private theorem mem_nonpositiveSpan_of_le (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W)
    (hmul : ∀ (χ ψ : Λ) (x y : I), x ∈ W χ → y ∈ W ψ → x * y ∈ W (χ + ψ))
    (ζ ν : Λ →+ ℤ)
    (H : ∀ (χ : Λ) (x : I), x ∈ W χ → I.toCotangent x ≠ 0 → 0 < ν χ → 0 < ζ χ)
    (n : ℕ) :
    ∀ χ : Λ, ν χ ≤ n → ζ χ ≤ 0 → ∀ x : I, x ∈ W χ → (x : R) ∈ nonpositiveSpan I W ν := by
  induction n with
  | zero =>
    intro χ hχ _ x hx
    exact mem_nonpositiveSpan I W ν (by exact_mod_cast hχ) hx
  | succ n ih =>
    intro χ hχn hχζ x hx
    by_cases hχν : ν χ ≤ 0
    · exact mem_nonpositiveSpan I W ν hχν hx
    push Not at hχν
    have hx2 : (x : R) ∈ I ^ 2 := by
      apply (I.toCotangent_eq_zero x).mp
      by_contra h
      exact absurd (H χ x hx h hχν) (not_lt.mpr hχζ)
    let p := homogeneousProjection I W hW χ
    have hprod : ∀ a b : I, (p (a * b) : R) ∈ nonpositiveSpan I W ν := by
      intro a b
      refine homogeneous_induction I W hW
        (P := fun a => ∀ b : I, (p (a * b) : R) ∈ nonpositiveSpan I W ν) ?_ ?_ ?_ a b
      · intro b
        simp
      · intro α a ha b
        refine homogeneous_induction I W hW
          (P := fun b => (p (a * b) : R) ∈ nonpositiveSpan I W ν) ?_ ?_ ?_ b
        · simp
        · intro β b hb
          have hab := hmul α β a b ha hb
          by_cases heq : α + β = χ
          · have hp : p (a * b) = a * b :=
              homogeneousProjection_same I W hW χ (heq ▸ hab)
            rw [hp]
            change (a : R) * (b : R) ∈ nonpositiveSpan I W ν
            have hνsum : ν α + ν β = ν χ := by rw [← map_add, heq]
            have hζsum : ζ α + ζ β = ζ χ := by rw [← map_add, heq]
            by_cases hα : ν α ≤ 0
            · exact Ideal.mul_mem_right _ _ (mem_nonpositiveSpan I W ν hα ha)
            by_cases hβ : ν β ≤ 0
            · exact Ideal.mul_mem_left _ _ (mem_nonpositiveSpan I W ν hβ hb)
            push Not at hα hβ
            have hχn' : ν χ ≤ (n : ℤ) + 1 := by exact_mod_cast hχn
            by_cases hζα : ζ α ≤ 0
            · exact Ideal.mul_mem_right _ _ (ih α (by omega) hζα a ha)
            · exact Ideal.mul_mem_left _ _ (ih β (by omega) (by omega) b hb)
          · have hp : p (a * b) = 0 :=
              homogeneousProjection_ne I W hW heq hab
            simp [hp]
        · intro b b' hb hb'
          simpa only [mul_add, map_add, Submodule.coe_add] using
            (nonpositiveSpan I W ν).add_mem hb hb'
      · intro a a' ha ha' b
        simpa only [add_mul, map_add, Submodule.coe_add] using
          (nonpositiveSpan I W ν).add_mem (ha b) (ha' b)
    have hpx := square_induction I
      (P := fun z => (p z : R) ∈ nonpositiveSpan I W ν) hprod
      (fun a b ha hb => by
        simpa only [map_add, Submodule.coe_add] using
          (nonpositiveSpan I W ν).add_mem ha hb) x hx2
    change (homogeneousProjection I W hW χ x : R) ∈ nonpositiveSpan I W ν at hpx
    rwa [homogeneousProjection_same I W hW χ hx] at hpx

/-- Let `I` be an ideal internally graded by `Λ` with homogeneous products, and let
`ζ, ν : Λ →+ ℤ`. If every label of a homogeneous element with nonzero class in `I/I²` which
is positive for `ν` is also positive for `ζ`, then every homogeneous element whose label is
nonpositive for `ζ` lies in the ideal generated by the homogeneous elements whose labels are
nonpositive for `ν`. -/
theorem mem_nonpositiveSpan_of_cotangent_signs (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W)
    (hmul : ∀ (χ ψ : Λ) (x y : I), x ∈ W χ → y ∈ W ψ → x * y ∈ W (χ + ψ))
    (ζ ν : Λ →+ ℤ)
    (H : ∀ (χ : Λ) (x : I), x ∈ W χ → I.toCotangent x ≠ 0 → 0 < ν χ → 0 < ζ χ)
    {χ : Λ} (hχ : ζ χ ≤ 0) {x : I} (hx : x ∈ W χ) :
    (x : R) ∈ nonpositiveSpan I W ν :=
  mem_nonpositiveSpan_of_le I W hW hmul ζ ν H (ν χ).toNat χ (Int.self_le_toNat _) hχ x hx

end Langlands.Algebra.GradedSignIdeal
