import Langlands.Algebra.RenardCommutativeEndomorphismDimensionStatement
import Langlands.Algebra.CommutingDimensionPrimary
import Mathlib.Analysis.Complex.Polynomial.Basic

/-! Proof of Renard 2026, Appendix C.I, in the exact real-power form. -/

namespace Langlands.Renard

universe uV

/-- Renard's real exponent `2 - 2^(1-l)` is the Library exponent `2 - 2 / 2^l`. -/
theorem renardExponent_eq_dimensionExponent (l : ℕ) :
    2 - Real.rpow 2 (1 - (l : ℝ)) = CommutingDimension.dimensionExponent l := by
  rw [CommutingDimension.dimensionExponent, Real.rpow_eq_pow,
    Real.rpow_sub (by norm_num : (0 : ℝ) < 2), Real.rpow_one, Real.rpow_natCast]

/-- Renard C.I for the unital algebra generated by commuting endomorphisms,
specialized from the general algebraically closed field theorem to `ℂ`. -/
theorem commutativeEndomorphismDimension :
    CommutativeEndomorphismDimensionStatement.{uV} := by
  intro V _ _ _ l a hc
  rw [renardExponent_eq_dimensionExponent, Real.rpow_eq_pow]
  exact CommutingDimension.commuting_dimension ℂ V l a hc

end Langlands.Renard
