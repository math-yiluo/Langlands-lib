import Langlands.Algebra.NonUnitalModuleCornerInductionGeneratedStatements

/-!
# Generatedness of actual corner induction and surjective descent

An additive proof of Renard (9 July 2026), I.3.2, printed pp.20–22 / PDF26–28.
The first two assertions hold over arbitrary associative nonunital rings.
Local units enter only through the published nondegenerate induction functor.
-/

set_option autoImplicit false

namespace Langlands.Algebra.NonUnitalModuleCornerInductionGenerated

open CategoryTheory
open NonUnitalModuleCornerInduction
open NonUnitalModuleIdempotentGenerated

universe uA uZ uM uN

variable {A : Type uA} [NonUnitalRing A]

attribute [local instance] rightCornerModule cornerModule tensorModule

/-- Balancing with the corner unit uses its unit law on `Z`, not on `A`. -/
theorem tmul_eq_action (e : Idempotent A) {Z : Type uZ} [AddCommGroup Z]
    [Module (Idempotent.Corner e) Z] (a : A) (z : Z) :
    tmul e a z =
      (tensorModule e Z).toDistribSMul.toSMul.smul a (tmul e (e : A) z) := by
  rw [tensorModule_smul_tmul]
  simpa only [Idempotent.Corner.toAmbient_one, one_smul] using
    (tmul_balanced e (1 : Idempotent.Corner e) a z).symm

/-- The pure tensor with first entry `e` is fixed for the named residual action. -/
theorem unit_tmul_mem_fixedPart (e : Idempotent A) {Z : Type uZ} [AddCommGroup Z]
    [Module (Idempotent.Corner e) Z] (z : Z) :
    tmul e (e : A) z ∈ NonUnitalModuleCorner.fixedPart e (Tensor e Z) := by
  change (tensorModule e Z).toDistribSMul.toSMul.smul (e : A) (tmul e (e : A) z) = _
  rw [tensorModule_smul_tmul, e.property.eq]

/-- The actual quotient is generated by the idempotent under its original action. -/
theorem tensor_isGenerated (e : Idempotent A) (Z : Type uZ) [AddCommGroup Z]
    [Module (Idempotent.Corner e) Z] : IsGeneratedByIdempotent e (Tensor e Z) := by
  intro t
  obtain ⟨q, rfl⟩ := NonUnitalModuleTensor.projection_surjective (Idempotent.Corner e) A Z t
  refine TensorProduct.inductionOn q ?_ ?_
  · intro a z
    change tmul e a z ∈ aeM e (Tensor e Z)
    rw [tmul_eq_action e a z]
    exact (aeM e (Tensor e Z)).smul_mem' a
      (fixedPart_le e (unit_tmul_mem_fixedPart e z))
  · intro q r hq hr
    rw [map_add]
    exact (aeM e (Tensor e Z)).add_mem hq hr

section Descent

variable {M : Type uM} {N : Type uN} [AddCommGroup M] [AddCommGroup N]
  [NonUnitalModule A M] [NonUnitalModule A N]

/-- Every target generator lifts, so its additive closure lies in the subgroup image. -/
theorem aeM_le_map_of_surjective (e : Idempotent A) (f : NonUnitalModuleHom A M N)
    (hf : Function.Surjective f.toAddMonoidHom) :
    (aeM e N).toAddSubgroup ≤ (aeM e M).toAddSubgroup.map f.toAddMonoidHom := by
  apply (AddSubgroup.closure_le _).mpr
  rintro n ⟨a, n, rfl⟩
  obtain ⟨m, hm⟩ := hf n
  refine ⟨a • ((e : A) • m), smul_mem e a m, ?_⟩
  change f (a • ((e : A) • m)) = a • ((e : A) • n)
  rw [f.map_smul, f.map_smul, hm]

/-- Surjectivity restricts to the published generated-submodule intertwiner. -/
theorem restrict_surjective (e : Idempotent A) (f : NonUnitalModuleHom A M N)
    (hf : Function.Surjective f.toAddMonoidHom) :
    Function.Surjective
      (NonUnitalModuleIdempotentGenerated.restrict e f).toAddMonoidHom := by
  intro y
  obtain ⟨m, hm, hfm⟩ := aeM_le_map_of_surjective e f hf y.property
  refine ⟨⟨m, hm⟩, ?_⟩
  exact Subtype.ext hfm

/-- Generatedness descends along any surjective original intertwiner. -/
theorem isGenerated_of_surjective (e : Idempotent A) (f : NonUnitalModuleHom A M N)
    (hf : Function.Surjective f.toAddMonoidHom)
    (hM : IsGeneratedByIdempotent e M) : IsGeneratedByIdempotent e N := by
  intro n
  obtain ⟨m, rfl⟩ := hf n
  exact map_mem e f (hM m)

end Descent

/-- The identical nondegenerate induction functor, with generatedness attached. -/
def generatedFunctor (hA : IsIdempotented A) (e : Idempotent A) :
    ModuleCat.{uZ} (Idempotent.Corner e) ⥤ GeneratedModuleCat.{uA, max uA uZ} e :=
  (generatedProperty e).lift (nondegenerateFunctor hA e)
    (fun Z => tensor_isGenerated e Z)

instance generatedFunctor_additive (hA : IsIdempotented A) (e : Idempotent A) :
    (generatedFunctor.{uA, uZ} hA e).Additive where
  map_add := by
    intro Z Z' f g
    apply ObjectProperty.hom_ext
    exact (nondegenerateFunctor hA e).map_add

/-- Forgetting generatedness recovers the entire actual nondegenerate functor. -/
theorem generatedFunctor_comp_inclusion (hA : IsIdempotented A) (e : Idempotent A) :
    generatedFunctor.{uA, uZ} hA e ⋙ NonUnitalModuleIdempotentGenerated.inclusion e =
      nondegenerateFunctor hA e := rfl

/-- Forgetting both properties recovers the entire actual ambient functor. -/
theorem generatedFunctor_comp_ambient (hA : IsIdempotented A) (e : Idempotent A) :
    (generatedFunctor.{uA, uZ} hA e ⋙ NonUnitalModuleIdempotentGenerated.inclusion e) ⋙
      nondegenerateInclusion A = ambientFunctor e := rfl

/-- The exact closed generatedness family, with the explicitly named tensor structures. -/
theorem cornerInductionGenerated :
    NonUnitalModuleCornerInductionGeneratedStatements.CornerInductionGeneratedTheorem.{uA, uZ} := by
  intro A _ e Z _ _
  exact ⟨tmul_eq_action e, unit_tmul_mem_fixedPart e, tensor_isGenerated e Z⟩

/-- The exact closed descent family, retaining independent source and target universes. -/
theorem idempotentGeneratedSurjectiveDescent :
    NonUnitalModuleCornerInductionGeneratedStatements.IdempotentGeneratedSurjectiveDescentTheorem.{uA, uM, uN} := by
  intro A _ e M N _ _ _ _ f hf
  exact ⟨restrict_surjective e f hf, isGenerated_of_surjective e f hf⟩

/-- The exact closed additive factorization family. -/
theorem cornerInductionGeneratedFactorization :
    NonUnitalModuleCornerInductionGeneratedStatements.CornerInductionGeneratedFactorizationTheorem.{uA, uZ} := by
  intro A _ hA e
  exact ⟨generatedFunctor hA e, inferInstance,
    generatedFunctor_comp_inclusion hA e, generatedFunctor_comp_ambient hA e⟩

/-- The exact published closed aggregate, with all four independent carrier universes. -/
theorem cornerInductionGeneratedStatements :
    NonUnitalModuleCornerInductionGeneratedStatements.CornerInductionGeneratedStatements.{uA, uZ, uM, uN} :=
  ⟨cornerInductionGenerated, idempotentGeneratedSurjectiveDescent,
    cornerInductionGeneratedFactorization⟩

end Langlands.Algebra.NonUnitalModuleCornerInductionGenerated
