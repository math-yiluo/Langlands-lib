import Mathlib.Algebra.Group.Pointwise.Finset.Basic
import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.RingTheory.Invariant.Basic

/-! # A bound on module generators for nested rings of invariants -/

noncomputable section

open scoped BigOperators Pointwise

namespace Langlands

section Adjoin

open Polynomial

variable {R A : Type*} [CommRing R] [CommRing A] [Nontrivial A] [Algebra R A]

private theorem span_powers_eq_adjoin_singleton [DecidableEq A] (a : A)
    {p : Polynomial R} (hp : p.Monic) (hroot : aeval a p = 0) {d : ℕ} (hd : p.natDegree ≤ d) :
    Submodule.span R (↑((Finset.range d).image (a ^ ·)) : Set A) =
      (Algebra.adjoin R {a}).toSubmodule := by
  refine le_antisymm (Submodule.span_le.2 ?_) ?_
  · intro b hb
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hb)
    exact (Algebra.adjoin R {a}).pow_mem (Algebra.self_mem_adjoin_singleton R a) _
  · intro b hb
    change b ∈ Algebra.adjoin R {a} at hb
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨q, rfl⟩ := hb
    have hpne : p ≠ 1 := by
      intro he
      rw [he, map_one] at hroot
      exact one_ne_zero hroot
    have hmod : aeval a (q %ₘ p) = aeval a q :=
      eval₂_modByMonic_eq_self_of_root hroot
    change aeval a q ∈ _
    rw [← hmod, aeval_eq_sum_range' ((natDegree_modByMonic_lt q hp hpne).trans_le hd)]
    apply Submodule.sum_mem
    intro i hi
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_image_of_mem _ hi))

private theorem exists_finset_span_eq_adjoin_of_monic (d : ℕ) (s : Finset A)
    (h : ∀ a ∈ s, ∃ p : Polynomial R, p.Monic ∧ p.natDegree ≤ d ∧ aeval a p = 0) :
    ∃ t : Finset A, t.card ≤ d ^ s.card ∧
      Submodule.span R (t : Set A) = (Algebra.adjoin R (s : Set A)).toSubmodule := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      exact ⟨{1}, by simp, by simp [Algebra.toSubmodule_bot, Submodule.one_eq_span]⟩
  | @insert a s ha ih =>
      obtain ⟨p, hp, hdeg, hroot⟩ := h a (Finset.mem_insert_self a s)
      obtain ⟨t, hcard, ht⟩ := ih fun b hb => h b (Finset.mem_insert_of_mem hb)
      let powers := (Finset.range d).image (a ^ ·)
      have hpow : powers.card ≤ d := Finset.card_image_le.trans (Finset.card_range d).le
      refine ⟨powers * t, ?_, ?_⟩
      · rw [Finset.card_insert_of_notMem ha, pow_succ, Nat.mul_comm (d ^ s.card) d]
        exact Finset.card_mul_le.trans (Nat.mul_le_mul hpow hcard)
      · rw [Finset.coe_mul, ← Submodule.span_mul_span, ht,
          span_powers_eq_adjoin_singleton a hp hroot hdeg, Finset.coe_insert,
          ← Set.singleton_union, Algebra.adjoin_union_coe_submodule]

end Adjoin

private theorem exists_monic_orbit_polynomial
    {S A W : Type*} [CommRing S] [CommRing A] [Nontrivial A] [Algebra S A]
    [Group W] [Fintype W] [MulSemiringAction W A] [Algebra.IsInvariant S A W] (a : A) :
    ∃ p : Polynomial S, p.Monic ∧ p.natDegree = Fintype.card W ∧ Polynomial.aeval a p = 0 := by
  open Polynomial in
  obtain ⟨p, hp, hdeg, hmonic⟩ := lifts_and_natDegree_eq_and_monic
    (Algebra.IsInvariant.charpoly_mem_lifts S A W a) (MulSemiringAction.monic_charpoly W a)
  refine ⟨p, hmonic, ?_, ?_⟩
  · rw [hdeg, MulSemiringAction.charpoly_eq, Polynomial.natDegree_prod_of_monic
      (h := fun w _ => Polynomial.monic_X_sub_C (w • a))]
    simp
  · rw [Polynomial.aeval_def, ← Polynomial.eval_map, hp, MulSemiringAction.eval_charpoly]

section Invariants

open Polynomial

variable {k A W : Type*} [Field k] [CharZero k] [CommRing A] [Nontrivial A] [Algebra k A]
  [Group W] [Finite W] [MulSemiringAction W A] [SMulCommClass W k A]

omit [CharZero k] [Nontrivial A] [Finite W] in
private theorem fixedPoints_subalgebra_le (H : Subgroup W) :
    FixedPoints.subalgebra k A W ≤ FixedPoints.subalgebra k A H :=
  fun _ ha h => ha (h : W)

/-- If an algebra over a characteristic-zero field is generated by at most `m` elements and
a finite group `W` of order at most `d` acts by algebra automorphisms, the `H`-invariants for
each subgroup `H ≤ W` are spanned over the `W`-invariants by a family indexed by `Fin (d ^ m)`. -/
def InvariantModuleGeneratorBoundStatement (H : Subgroup W) (d m : ℕ) : Prop :=
  let S := FixedPoints.subalgebra k A W
  let T := FixedPoints.subalgebra k A H
  letI : Algebra S T := (Subalgebra.inclusion (fixedPoints_subalgebra_le H)).toRingHom.toAlgebra
  Nat.card W ≤ d →
    (∃ s : Finset A, s.card ≤ m ∧ Algebra.adjoin k (s : Set A) = ⊤) →
      ∃ g : Fin (d ^ m) → T, Submodule.span S (Set.range g) = ⊤

/-- Orbit polynomials and averaging give the uniform generator bound for nested invariants. -/
theorem exists_spanningFamily_fixedPoints (H : Subgroup W) (d m : ℕ) :
    InvariantModuleGeneratorBoundStatement (k := k) (A := A) H d m := by
  classical
  let := Fintype.ofFinite W
  let := Fintype.ofFinite H
  unfold InvariantModuleGeneratorBoundStatement
  intro S T horder
  let : Algebra S T := (Subalgebra.inclusion (fixedPoints_subalgebra_le H)).toRingHom.toAlgebra
  rintro ⟨s, hsize, hs⟩
  have hs' : Algebra.adjoin S (s : Set A) = ⊤ := by
    have hle : Algebra.adjoin k (s : Set A) ≤
        (Algebra.adjoin S (s : Set A)).restrictScalars k := by
      apply Algebra.adjoin_le
      intro a ha
      change a ∈ Algebra.adjoin S (s : Set A)
      exact Algebra.subset_adjoin (R := S) ha
    rw [hs] at hle
    exact eq_top_iff.2 fun a _ => hle (show a ∈ (⊤ : Subalgebra k A) from trivial)
  have hpoly (a : A) :
      ∃ p : Polynomial S, p.Monic ∧ p.natDegree ≤ d ∧ aeval a p = 0 := by
    obtain ⟨p, hp, hdeg, hroot⟩ := exists_monic_orbit_polynomial (S := S) (W := W) a
    exact ⟨p, hp, hdeg.trans_le (by simpa [Nat.card_eq_fintype_card] using horder), hroot⟩
  obtain ⟨t, htcard, ht⟩ :=
    exists_finset_span_eq_adjoin_of_monic d s (fun a _ => hpoly a)
  rw [hs', Algebra.top_toSubmodule] at ht
  have hd : 0 < d := (Nat.card_pos (α := W)).trans_le horder
  have htbound : t.card ≤ d ^ m :=
    htcard.trans (Nat.pow_le_pow_right hd hsize)
  obtain ⟨e⟩ : Nonempty (↑t ↪ Fin (d ^ m)) := Function.Embedding.nonempty_of_card_le
    (by simpa using htbound)
  let f : Fin (d ^ m) → A := Function.extend e Subtype.val (fun _ => 0)
  have hf : Submodule.span S (Set.range f) = ⊤ := by
    apply top_unique
    rw [← ht]
    refine Submodule.span_mono fun a ha => ⟨e ⟨a, ha⟩, ?_⟩
    exact e.injective.extend_apply Subtype.val (fun _ => 0) ⟨a, ha⟩
  let trace (a : A) : A := ∑ h : H, h • a
  have htrace (a : A) : trace a ∈ T := by
    intro h
    simp only [trace, Finset.smul_sum, smul_smul]
    exact Fintype.sum_bijective (h * ·) (Group.mulLeft_bijective h) _ _ (fun _ => rfl)
  let tr : A →ₗ[S] T :=
    { toFun := fun a => ⟨trace a, htrace a⟩
      map_add' := fun a b => Subtype.ext (by simp [trace, smul_add, Finset.sum_add_distrib])
      map_smul' := fun c a => Subtype.ext (by
        change trace ((c : A) * a) = (c : A) * trace a
        have hc (h : H) : h • (c : A) = c := c.property (h : W)
        simp only [trace, Finset.mul_sum, smul_mul', hc]) }
  have hsurj : Function.Surjective tr := by
    intro b
    refine ⟨((Fintype.card H : k)⁻¹) • (b : A), Subtype.ext ?_⟩
    change trace (((Fintype.card H : k)⁻¹) • (b : A)) = b
    have hcard : (Fintype.card H : k) ≠ 0 :=
      Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    have hb (h : H) : h • (b : A) = b := b.property h
    simp only [trace, smul_comm _ ((Fintype.card H : k)⁻¹), hb,
      Finset.sum_const, Finset.card_univ, ← Nat.cast_smul_eq_nsmul k,
      ← mul_smul, inv_mul_cancel₀ hcard, one_smul]
  refine ⟨tr ∘ f, ?_⟩
  rw [Set.range_comp, ← Submodule.map_span, hf, Submodule.map_top,
    LinearMap.range_eq_top.mpr hsurj]

end Invariants

end Langlands
