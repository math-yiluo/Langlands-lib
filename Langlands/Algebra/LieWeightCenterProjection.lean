import Langlands.Algebra.OrderedMonomialBasis
import Langlands.Algebra.LieEnvelopingEquiv
import Langlands.Algebra.RelativeEnvelopingCenter
import Mathlib.Tactic.NoncommRing

/-! # The relative centre projection for an adjoint grading of a Lie algebra -/

noncomputable section

universe u v w z z'

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Langlands.Algebra.LieWeightProjection

open Langlands.Algebra.UniversalEnveloping Langlands.Archimedean.VermaPBW
  Langlands.Archimedean.Kostant

attribute [local instance 100] LieRing.ofAssociativeRing

section WeightDecomposition

variable {k : Type u} [Field k] [CharZero k] {L : Type v} [LieRing L] [LieAlgebra k L]
  {I : Type w} [Fintype I] [DecidableEq I]
  (b : Module.Basis I k L) (d : I → ℝ)

local notation "U" => UniversalEnvelopingAlgebra k L
local notation "ι" => UniversalEnvelopingAlgebra.ι k

/-- The right ideal spanned by positive-weight generators times arbitrary
enveloping elements. -/
def positiveWeightRightIdeal : Submodule k U :=
  Submodule.span k {u | ∃ a : I, 0 < d a ∧ ∃ v : U, u = ι (b a) * v}

omit [CharZero k] [Fintype I] [DecidableEq I] in
theorem mul_mem_positiveWeightRightIdeal {u : U} (hu : u ∈ positiveWeightRightIdeal b d) (v : U) :
    u * v ∈ positiveWeightRightIdeal b d := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨a, ha, y, rfl⟩ := hu
    exact Submodule.subset_span ⟨a, ha, y * v, mul_assoc _ _ _⟩
  | zero => rw [zero_mul]; exact (positiveWeightRightIdeal b d).zero_mem
  | add x y _ _ hx hy => rw [add_mul]; exact (positiveWeightRightIdeal b d).add_mem hx hy
  | smul c x _ hx => rw [smul_mul_assoc]; exact (positiveWeightRightIdeal b d).smul_mem c hx

/-- The subalgebra generated by the weight-zero Lie directions. -/
def zeroWeightEnvelopingSubalgebra : Subalgebra k U :=
  Algebra.adjoin k {u | ∃ a : I, d a = 0 ∧ u = ι (b a)}

/-- The basis indices in decreasing adjoint weight. -/
def weightOrderedIndices : List I :=
  (Finset.univ : Finset I).toList.mergeSort fun a a' => decide (d a' ≤ d a)

omit [DecidableEq I] in
theorem weightOrderedIndices_nodup : (weightOrderedIndices d).Nodup :=
  (List.mergeSort_perm _ _).nodup_iff.mpr (Finset.nodup_toList _)

omit [DecidableEq I] in
theorem mem_weightOrderedIndices (a : I) : a ∈ weightOrderedIndices d :=
  (List.mergeSort_perm _ _).mem_iff.mpr (Finset.mem_toList.mpr (Finset.mem_univ a))

omit [DecidableEq I] in
theorem weightOrderedIndices_pairwise : (weightOrderedIndices d).Pairwise fun a a' => d a' ≤ d a := by
  simpa only [weightOrderedIndices, decide_eq_true_eq] using
    (List.pairwise_mergeSort (le := fun a a' : I => decide (d a' ≤ d a))
      (fun a a' a'' ha ha' => by simp only [decide_eq_true_eq] at *; linarith)
      (fun a a' => by simp only [Bool.or_eq_true, decide_eq_true_eq]; exact le_total _ _)
      (Finset.univ : Finset I).toList)

/-- The PBW basis ordered by decreasing weight. -/
def weightOrderedPBWBasis : Module.Basis (I →₀ ℕ) k U :=
  orderedMonomialBasis b (weightOrderedIndices_nodup d) (mem_weightOrderedIndices d)

omit [CharZero k] in
theorem weightOrderedPBWBasis_apply (α : I →₀ ℕ) :
    weightOrderedPBWBasis b d α = word k L ((expand (weightOrderedIndices d) α).map b) :=
  orderedMonomialBasis_apply b (weightOrderedIndices_nodup d) (mem_weightOrderedIndices d) α

omit [CharZero k] [Fintype I] [DecidableEq I] in
private theorem ad_word (ev : I → k) (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a) (l : List I) :
    ι H * word k L (l.map b) - word k L (l.map b) * ι H =
      (l.map ev).sum • word k L (l.map b) := by
  induction l with
  | nil => simp [word]
  | cons a l ih =>
    have h := (UniversalEnvelopingAlgebra.ι k (L := L)).map_lie H (b a)
    rw [hH, map_smul, Ring.lie_def] at h
    simp only [List.map_cons, word_cons, List.sum_cons]
    calc
      _ = (ι H * ι (b a) - ι (b a) * ι H) * word k L (l.map b) +
        ι (b a) * (ι H * word k L (l.map b) - word k L (l.map b) * ι H) := by
          noncomm_ring
      _ = _ := by rw [← h, ih, smul_mul_assoc, mul_smul_comm, add_smul]

private theorem ad_weightOrderedPBWBasis (ev : I → k) (H : L)
    (hH : ∀ a, ⁅H, b a⁆ = ev a • b a) (α : I →₀ ℕ) :
    ι H * weightOrderedPBWBasis b d α - weightOrderedPBWBasis b d α * ι H =
      ((expand (weightOrderedIndices d) α).map ev).sum • weightOrderedPBWBasis b d α := by
  rw [weightOrderedPBWBasis_apply]
  exact ad_word b ev H hH _

/-- The adjoint action of an element acting diagonally on the basis multiplies each
PBW coordinate by the total eigenvalue of its monomial. -/
theorem weightOrderedPBWBasis_repr_ad (ev : I → k) (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)
    (u : U) (α : I →₀ ℕ) :
    (weightOrderedPBWBasis b d).repr (ι H * u - u * ι H) α =
      ((expand (weightOrderedIndices d) α).map ev).sum *
        (weightOrderedPBWBasis b d).repr u α := by
  let B := weightOrderedPBWBasis b d
  let w (α : I →₀ ℕ) : k := ((expand (weightOrderedIndices d) α).map ev).sum
  let ad : U →ₗ[k] U := LinearMap.mulLeft k (ι H) - LinearMap.mulRight k (ι H)
  have h : B.coord α ∘ₗ ad = w α • B.coord α := by
    refine B.ext fun β => ?_
    change B.coord α (ι H * B β - B β * ι H) = w α • B.coord α (B β)
    rw [ad_weightOrderedPBWBasis b d ev H hH β, map_smul]
    change w β • B.coord α (B β) = _
    obtain rfl | hne := eq_or_ne β α
    · rfl
    · simp [Module.Basis.coord_apply, Module.Basis.repr_self, Ne.symm hne]
  exact LinearMap.congr_fun h u

omit [DecidableEq I] in
private theorem expand_weightOrderedIndices_pairwise (α : I →₀ ℕ) :
    (expand (weightOrderedIndices d) α).Pairwise fun a a' => d a' ≤ d a := by
  unfold expand
  refine List.pairwise_flatMap.mpr ⟨fun a _ => ?_, ?_⟩
  · exact List.pairwise_replicate.mpr (Or.inr le_rfl)
  · refine (weightOrderedIndices_pairwise d).imp_of_mem fun {a a'} _ _ h => ?_
    intro x hx y hy
    rw [List.eq_of_mem_replicate hx, List.eq_of_mem_replicate hy]
    exact h

omit [Fintype I] [DecidableEq I] in
private theorem weight_zero_of_sum_zero (l : List I) (hn : ∀ a ∈ l, d a ≤ 0)
    (hs : (l.map d).sum = 0) : ∀ a ∈ l, d a = 0 := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha := hn a (List.mem_cons_self)
    have ht : ∀ a ∈ l, d a ≤ 0 := fun j hj => hn j (List.mem_cons_of_mem _ hj)
    have htle : (l.map d).sum ≤ 0 := by
      have h := List.sum_le_length_nsmul (l.map d) (0 : ℝ) (by
        rintro _ hx
        obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hx
        exact ht j hj)
      simpa only [nsmul_zero] using h
    simp only [List.map_cons, List.sum_cons] at hs
    intro j hj
    rcases List.mem_cons.mp hj with rfl | hj
    · linarith
    · exact ih ht (by linarith) j hj

omit [CharZero k] [Fintype I] [DecidableEq I] in
private theorem word_mem_zeroWeight (l : List I) (h : ∀ a ∈ l, d a = 0) :
    word k L (l.map b) ∈ zeroWeightEnvelopingSubalgebra b d := by
  induction l with
  | nil =>
    simpa only [List.map_nil, word_nil] using (zeroWeightEnvelopingSubalgebra b d).one_mem
  | cons a l ih =>
    rw [List.map_cons, word_cons]
    exact (zeroWeightEnvelopingSubalgebra b d).mul_mem
      (Algebra.subset_adjoin ⟨a, h a List.mem_cons_self, rfl⟩)
      (ih fun c hc => h c (List.mem_cons_of_mem _ hc))

private theorem weightOrderedPBWBasis_mem_sup (α : I →₀ ℕ)
    (hs : ((expand (weightOrderedIndices d) α).map d).sum = 0) :
    weightOrderedPBWBasis b d α ∈
      positiveWeightRightIdeal b d ⊔ (zeroWeightEnvelopingSubalgebra b d).toSubmodule := by
  rw [weightOrderedPBWBasis_apply]
  generalize hl : expand (weightOrderedIndices d) α = l at hs ⊢
  have hsort := expand_weightOrderedIndices_pairwise d α
  rw [hl] at hsort
  cases l with
  | nil => exact Submodule.mem_sup_right (word_mem_zeroWeight b d [] (by simp))
  | cons a l =>
    by_cases ha : 0 < d a
    · apply Submodule.mem_sup_left
      rw [List.map_cons, word_cons]
      exact Submodule.subset_span ⟨a, ha, _, rfl⟩
    · have hnon (c : I) (hc : c ∈ a :: l) : d c ≤ 0 := by
        rcases List.mem_cons.mp hc with rfl | hc
        · exact le_of_not_gt ha
        · exact le_trans ((List.pairwise_cons.mp hsort).1 c hc) (le_of_not_gt ha)
      exact Submodule.mem_sup_right
        (word_mem_zeroWeight b d _ (weight_zero_of_sum_zero d _ hnon hs))

/-- The PBW coordinates of a central element live on monomials of total eigenvalue zero
for an element acting diagonally on the basis. -/
theorem center_repr_sum_eq_zero (ev : I → k) (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)
    (z : Subalgebra.center k U) (α : I →₀ ℕ)
    (hα : α ∈ ((weightOrderedPBWBasis b d).repr z.val).support) :
    ((expand (weightOrderedIndices d) α).map ev).sum = 0 := by
  have hz : ι H * z.val - z.val * ι H = 0 :=
    sub_eq_zero.mpr (Subalgebra.mem_center_iff.mp z.property (ι H))
  have h := weightOrderedPBWBasis_repr_ad b d ev H hH z.val α
  rw [hz, map_zero, Finsupp.zero_apply] at h
  exact (mul_eq_zero.mp h.symm).resolve_right (Finsupp.mem_support_iff.mp hα)

/-- For a grading by the values `d = ψ ∘ ev` of an additive map `ψ` on the eigenvalues
`ev` of one adjoint operator, a central element is a sum of a weight-zero enveloping element
and an element of the positive right ideal. -/
theorem center_mem_positiveWeight_sup_zeroWeight (ev : I → k) (ψ : k →+ ℝ)
    (hψ : ∀ a, ψ (ev a) = d a) (H : L)
    (hH : ∀ a, ⁅H, b a⁆ = ev a • b a) (z : Subalgebra.center k U) :
    z.val ∈ positiveWeightRightIdeal b d ⊔ (zeroWeightEnvelopingSubalgebra b d).toSubmodule := by
  let B := weightOrderedPBWBasis b d
  have hsupport (α : I →₀ ℕ) (hα : α ∈ (B.repr z.val).support) :
      ((expand (weightOrderedIndices d) α).map d).sum = 0 := by
    have h := congrArg ψ (center_repr_sum_eq_zero b d ev H hH z α hα)
    rw [map_list_sum, List.map_map, map_zero] at h
    rw [← h]
    congr 1
    exact List.map_congr_left fun a _ => (hψ a).symm
  rw [← B.linearCombination_repr z.val, Finsupp.linearCombination_apply, Finsupp.sum]
  exact Submodule.sum_mem _ fun α hα =>
    Submodule.smul_mem _ _ (weightOrderedPBWBasis_mem_sup b d α (hsupport α hα))

end WeightDecomposition

section Eigenvectors

variable {k : Type u} [Field k] {L : Type v} [LieRing L] [LieAlgebra k L]
  {I : Type w} (b : Module.Basis I k L)

/-- An eigenvector of an operator acting diagonally on a basis lies in the span of the
basis vectors with the same eigenvalue. -/
theorem mem_eigenSpan_of_ad (ev : I → k) (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)
    (μ : k) {x : L} (hx : ⁅H, x⁆ = μ • x) :
    x ∈ Submodule.span k (b '' {a | ev a = μ}) := by
  classical
  let ad : L →ₗ[k] L :=
    { toFun := fun y => ⁅H, y⁆
      map_add' := fun y z => lie_add H y z
      map_smul' := fun t y => lie_smul t H y }
  have hc (a : I) : b.coord a ∘ₗ ad = ev a • b.coord a := by
    refine b.ext fun q => ?_
    change b.coord a ⁅H, b q⁆ = ev a • b.coord a (b q)
    rw [hH, map_smul]
    by_cases h : a = q
    · rw [h]
    · simp [Module.Basis.coord_apply, Module.Basis.repr_self, h]
  have hs (a : I) (ha : a ∈ (b.repr x).support) : ev a = μ := by
    have h : b.repr (⁅H, x⁆) a = ev a * b.repr x a := LinearMap.congr_fun (hc a) x
    rw [hx, map_smul, Finsupp.smul_apply, smul_eq_mul] at h
    exact (mul_right_cancel₀ (Finsupp.mem_support_iff.mp ha) h).symm
  rw [← b.linearCombination_repr x, Finsupp.linearCombination_apply, Finsupp.sum]
  exact Submodule.sum_mem _ fun a ha =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, hs a ha, rfl⟩)

/-- For weights `d = ψ ∘ ev` given by an additive map on the eigenvalues, the bracket of two
basis vectors is a combination of basis vectors whose weight is the sum of their weights. -/
theorem lie_basis_mem_span (d : I → ℝ) (ev : I → k) (ψ : k →+ ℝ) (hψ : ∀ a, ψ (ev a) = d a)
    (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a) (a q : I) :
    ⁅b a, b q⁆ ∈ Submodule.span k (b '' {e | d e = d a + d q}) := by
  refine Submodule.span_mono ?_ (mem_eigenSpan_of_ad b ev H hH (ev a + ev q) ?_)
  · rintro _ ⟨e, he, rfl⟩
    refine ⟨e, ?_, rfl⟩
    simp only [Set.mem_ofPred_eq] at he ⊢
    rw [← hψ, he, map_add, hψ, hψ]
  · rw [leibniz_lie, hH, hH, smul_lie, lie_smul, ← add_smul]

end Eigenvectors

section PositiveIdeal
section Subindices

variable {I : Type w} (p : I → Prop) [DecidablePred p]

/-- Retain the indices satisfying `p` in the same order, now as subtype
indices. -/
def orderedSubindices (l : List I) : List {a // p a} :=
  l.filterMap fun a => if ha : p a then some ⟨a, ha⟩ else none

@[simp]
theorem map_val_orderedSubindices (l : List I) :
    (orderedSubindices p l).map Subtype.val = l.filter (fun a => decide (p a)) := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    by_cases ha : p a <;> simpa [orderedSubindices, ha] using ih

theorem orderedSubindices_nodup {l : List I} (hl : l.Nodup) : (orderedSubindices p l).Nodup :=
  List.Nodup.of_map Subtype.val (by rw [map_val_orderedSubindices]; exact hl.filter _)

theorem mem_orderedSubindices {l : List I} (a : {a // p a}) (ha : a.val ∈ l) :
    a ∈ orderedSubindices p l := by
  exact List.mem_filterMap.mpr ⟨a.val, ha, dite_eq_left a.property⟩

theorem expand_orderedSubindices (l : List I) (β : {a // p a} →₀ ℕ) :
    (expand (orderedSubindices p l) β).map Subtype.val =
      expand l (β.embDomain (Function.Embedding.subtype p)) := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    by_cases ha : p a
    · have hβ : (β.embDomain (Function.Embedding.subtype p)) a = β ⟨a, ha⟩ :=
        Finsupp.embDomain_apply_self (Function.Embedding.subtype p) β ⟨a, ha⟩
      simp only [orderedSubindices, List.filterMap_cons, dite_eq_left ha, expand, List.flatMap_cons,
        List.map_append, List.map_replicate, hβ]
      rw [← expand, ← expand, ← orderedSubindices, ih]
    · have han : a ∉ Set.range (Function.Embedding.subtype p) := by
        rintro ⟨x, rfl⟩
        exact ha x.property
      simp only [orderedSubindices, List.filterMap_cons, dite_eq_right ha, expand, List.flatMap_cons,
        Finsupp.embDomain_of_notMem_range _ _ _ han, List.replicate_zero, List.nil_append]
      exact ih

end Subindices

variable {k : Type u} [Field k] {L : Type v} [LieRing L] [LieAlgebra k L]
  {I : Type w} [Fintype I] [DecidableEq I]
  (b : Module.Basis I k L) (d : I → ℝ)

local notation "U" => UniversalEnvelopingAlgebra k L
local notation "ι" => UniversalEnvelopingAlgebra.ι k

section MappedBasis

variable {M : Type z} [LieRing M] [LieAlgebra k M]
  (p : I → Prop) [DecidablePred p] (j : M →ₗ⁅k⁆ L)
  (c : Module.Basis {a // p a} k M) (hc : ∀ a, j (c a) = b a.val)

omit [Fintype I] [DecidableEq I] in
include hc in
/-- The image of a monomial for a subset of the Lie basis has the same PBW
exponents extended by zero. -/
theorem map_orderedMonomial_subindices (l : List I) (β : {a // p a} →₀ ℕ) :
    Langlands.Algebra.LieEnvelopingEquiv.map j
        (orderedMonomial k M c (orderedSubindices p l) β) =
      orderedMonomial k L b l (β.embDomain (Function.Embedding.subtype p)) := by
  unfold orderedMonomial
  rw [map_word k M _ j.toLinearMap (Langlands.Algebra.LieEnvelopingEquiv.map_generator j)]
  rw [← expand_orderedSubindices p l β, List.map_map, List.map_map]
  congr 1
  exact List.map_congr_left fun a _ => hc a

end MappedBasis

section Coordinates

variable [CharZero k]

/-- The subspace spanned by ordered monomials having a positive letter. -/
def positivePBWSpan : Submodule k U :=
  Submodule.span k (weightOrderedPBWBasis b d ''
    {α | ∃ a, 0 < d a ∧ α a ≠ 0})

omit [CharZero k] in
theorem positivePBWSpan_coord_zero {α : I →₀ ℕ} (hα : ∀ a, 0 < d a → α a = 0)
    {x : U} (hx : x ∈ positivePBWSpan b d) :
    (weightOrderedPBWBasis b d).repr x α = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨β, ⟨a, ha, hβ⟩, rfl⟩ := hx
    have hne : α ≠ β := fun h => hβ (h ▸ hα a ha)
    rw [Module.Basis.repr_self, Finsupp.single_eq_of_ne hne]
  | zero => rw [map_zero, Finsupp.zero_apply]
  | add x y _ _ h₁ h₂ => rw [map_add, Finsupp.add_apply, h₁, h₂, add_zero]
  | smul t x _ h => rw [map_smul, Finsupp.smul_apply, h, smul_zero]

omit [CharZero k] [Fintype I] [DecidableEq I] in
private theorem filter_positive_append_nonpositive (l : List I)
    (hl : l.Pairwise fun a a' => d a' ≤ d a) :
    l.filter (fun a => decide (0 < d a)) ++ l.filter (fun a => decide (¬ 0 < d a)) = l := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    by_cases ha : 0 < d a
    · simpa [ha] using congrArg (List.cons a) (ih (List.pairwise_cons.mp hl).2)
    · have hnon (c : I) (hc : c ∈ a :: l) : ¬ 0 < d c := by
        rcases List.mem_cons.mp hc with rfl | hc
        · exact ha
        · exact fun h => ha (lt_of_lt_of_le h ((List.pairwise_cons.mp hl).1 c hc))
      have hp : (a :: l).filter (fun c => decide (0 < d c)) = [] :=
        List.filter_eq_nil_iff.mpr fun c hc => by simp [hnon c hc]
      have hm : (a :: l).filter (fun c => decide (¬ 0 < d c)) = a :: l :=
        List.filter_eq_self.mpr fun c hc => by simp [hnon c hc]
      rw [hp, hm, List.nil_append]

variable {N : Type z} [LieRing N] [LieAlgebra k N]
  (j : N →ₗ⁅k⁆ L) (c : Module.Basis {a : I // 0 < d a} k N)
  (hc : ∀ a, j (c a) = b a.val)

include hc in
private theorem positiveGenerator_mul_mem_positivePBWSpan (a : {a : I // 0 < d a}) (α : I →₀ ℕ) :
    ι (b a.val) * weightOrderedPBWBasis b d α ∈ positivePBWSpan b d := by
  classical
  let p (a : I) := 0 < d a
  let s := weightOrderedIndices d
  let pos := s.filter fun a => decide (p a)
  let rest := s.filter fun a => decide (¬p a)
  let sN := orderedSubindices p s
  let A := UniversalEnvelopingAlgebra k N
  let J := Langlands.Algebra.LieEnvelopingEquiv.map j
  let aug : A →ₐ[k] k := UniversalEnvelopingAlgebra.lift k (0 : N →ₗ⁅k⁆ k)
  let E := orderedMonomial k N c sN
  let e := Function.Embedding.subtype p
  let tail := word k L ((expand rest α).map b)
  let αN : {a // p a} →₀ ℕ := Finsupp.equivFunOnFinite.symm fun a => α a.val
  have hs : s = pos ++ rest :=
    (filter_positive_append_nonpositive d s (weightOrderedIndices_pairwise d)).symm
  have hsN : sN.Nodup := orderedSubindices_nodup p (weightOrderedIndices_nodup d)
  have hsNmem (a : {a // p a}) : a ∈ sN :=
    mem_orderedSubindices p a (mem_weightOrderedIndices d a.val)
  have hsplit (β : I →₀ ℕ) :
      expand s β = expand pos β ++ expand rest β :=
    (congrArg (fun t => expand t β) hs).trans (expand_append pos rest β)
  have hpos (a : I) (ha : a ∈ pos) : p a := by simpa only [pos, List.mem_filter,
    decide_eq_true_eq] using (List.mem_filter.mp ha).2
  have hneg (a : I) (ha : a ∈ rest) : ¬p a := by simpa only [rest, List.mem_filter,
    decide_eq_true_eq] using (List.mem_filter.mp ha).2
  have hzero (β : {a // p a} →₀ ℕ) (a : I) (ha : ¬p a) : β.embDomain e a = 0 :=
    Finsupp.embDomain_of_notMem_range _ _ _ (by
      rintro ⟨a', rfl⟩
      exact ha a'.property)
  have hmap (β : {a // p a} →₀ ℕ) :
      J (E β) = word k L ((expand pos (β.embDomain e)).map b) := by
    have hz : expand rest (β.embDomain e) = expand rest (0 : I →₀ ℕ) := by
      apply expand_congr
      intro a ha
      rw [hzero β a (hneg a ha), Finsupp.zero_apply]
    rw [show J (E β) = orderedMonomial k L b s (β.embDomain e) from
      map_orderedMonomial_subindices b p j c hc s β]
    unfold orderedMonomial
    rw [hsplit, hz, expand_zero, List.append_nil]
  have hmerge (β : {a // p a} →₀ ℕ) :
      J (E β) * tail =
        weightOrderedPBWBasis b d ((β.embDomain e) + α.filter (fun a => ¬p a)) := by
    let δ := β.embDomain e + α.filter (fun a => ¬p a)
    have hpos' : expand pos δ = expand pos (β.embDomain e) := by
      apply expand_congr
      intro a ha
      simp only [δ, Finsupp.add_apply, Finsupp.filter_apply,
        ite_eq_right (not_not_intro (hpos a ha)), add_zero]
    have hneg' : expand rest δ = expand rest α := by
      apply expand_congr
      intro a ha
      simp only [δ, Finsupp.add_apply, Finsupp.filter_apply, hzero β a (hneg a ha),
        ite_eq_left (hneg a ha), zero_add]
    rw [hmap, weightOrderedPBWBasis_apply]
    change _ = word k L ((expand s δ).map b)
    rw [hsplit, hpos', hneg', List.map_append, word_append]
  have hr : J (E αN) * tail = weightOrderedPBWBasis b d α := by
    have h : expand pos (αN.embDomain e) = expand pos α := by
      apply expand_congr
      intro a ha
      have he : e ⟨a, hpos a ha⟩ = a := rfl
      rw [← he, Finsupp.embDomain_apply_self]
      rfl
    rw [hmap, h, weightOrderedPBWBasis_apply]
    change _ = word k L ((expand s α).map b)
    rw [hsplit, List.map_append, word_append]
  have haug_ι (x : N) : aug (UniversalEnvelopingAlgebra.ι k x) = 0 :=
    UniversalEnvelopingAlgebra.lift_ι_apply k (0 : N →ₗ⁅k⁆ k) x
  have haug_word (l : List N) (hl : l ≠ []) : aug (word k N l) = 0 := by
    cases l with
    | nil => exact (hl rfl).elim
    | cons a l => rw [word_cons, map_mul, haug_ι, zero_mul]
  have htransform (u : A) : J u * tail - aug u • tail ∈ positivePBWSpan b d := by
    have hu : u ∈ Submodule.span k (Set.range E) :=
      top_le_span_orderedMonomial c hsN hsNmem Submodule.mem_top
    induction hu using Submodule.span_induction with
    | mem u hu =>
      obtain ⟨β, rfl⟩ := hu
      by_cases hβ : β = 0
      · subst β
        simp only [E, orderedMonomial, expand_zero, List.map_nil, word_nil, map_one,
          one_mul, one_smul, sub_self]
        exact (positivePBWSpan b d).zero_mem
      · obtain ⟨a, ha⟩ := Finsupp.support_nonempty_iff.mpr hβ
        have hβa := Finsupp.mem_support_iff.mp ha
        have hex : (expand sN β).map c ≠ [] := by
          intro h
          have h' : expand sN β = [] := List.map_eq_nil_iff.mp h
          have hm : a ∈ expand sN β := List.mem_flatMap.mpr
            ⟨a, hsNmem a, List.mem_replicate.mpr ⟨hβa, rfl⟩⟩
          rw [h'] at hm
          exact List.not_mem_nil hm
        have haug : aug (E β) = 0 := haug_word _ hex
        rw [haug, zero_smul, sub_zero, hmerge]
        apply Submodule.subset_span
        refine ⟨_, ⟨a.val, a.property, ?_⟩, rfl⟩
        have hf : ¬¬p a.val := not_not_intro a.property
        rw [Finsupp.add_apply, Finsupp.filter_apply, ite_eq_right hf, add_zero]
        change (β.embDomain e) (e a) ≠ 0
        rwa [Finsupp.embDomain_apply_self]
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add, map_add, add_mul, add_smul, add_sub_add_comm]
      exact (positivePBWSpan b d).add_mem hx hy
    | smul t x _ hx =>
      rw [map_smul, map_smul, smul_mul_assoc, smul_assoc, ← smul_sub]
      exact (positivePBWSpan b d).smul_mem t hx
  have h := htransform (UniversalEnvelopingAlgebra.ι k (c a) * E αN)
  rw [map_mul aug, haug_ι, zero_mul, zero_smul, sub_zero, map_mul,
    show J (UniversalEnvelopingAlgebra.ι k (c a)) = ι (b a.val) from
      (Langlands.Algebra.LieEnvelopingEquiv.map_generator j (c a)).trans
        (congrArg (UniversalEnvelopingAlgebra.ι k) (hc a)),
    mul_assoc, hr] at h
  exact h

include hc in
/-- The positive right ideal has zero coordinates on every PBW monomial
whose exponents in the positive directions all vanish. -/
theorem positiveWeightRightIdeal_le_positivePBWSpan :
    positiveWeightRightIdeal b d ≤ positivePBWSpan b d := by
  apply Submodule.span_le.mpr
  rintro _ ⟨a, ha, u, rfl⟩
  let B := weightOrderedPBWBasis b d
  rw [← B.linearCombination_repr u, Finsupp.linearCombination_apply, Finsupp.sum, Finset.mul_sum]
  refine Submodule.sum_mem _ fun α _ => ?_
  rw [mul_smul_comm]
  exact Submodule.smul_mem _ _ (positiveGenerator_mul_mem_positivePBWSpan b d j c hc ⟨a, ha⟩ α)

end Coordinates

section ZeroWeight

variable [CharZero k] {M : Type z} [LieRing M] [LieAlgebra k M]
  (j : M →ₗ⁅k⁆ L) (c : Module.Basis {a : I // d a = 0} k M)
  (hc : ∀ a, j (c a) = b a.val)

include hc in
/-- The PBW coordinates of the image of a Levi enveloping element, at an exponent supported on
the weight-zero letters, are its own ordered PBW coordinates. -/
theorem repr_envelopingMap_embDomain (u : UniversalEnvelopingAlgebra k M)
    (α : {a : I // d a = 0} →₀ ℕ) :
    (weightOrderedPBWBasis b d).repr (Langlands.Algebra.LieEnvelopingEquiv.map j u)
        (α.embDomain (Function.Embedding.subtype fun a => d a = 0)) =
      (orderedMonomialBasis c (orderedSubindices_nodup (fun a => d a = 0)
        (weightOrderedIndices_nodup d))
        (fun a => mem_orderedSubindices (fun a => d a = 0) a
          (mem_weightOrderedIndices d a.val))).repr u α := by
  let p (a : I) := d a = 0
  let s := weightOrderedIndices d
  let J := Langlands.Algebra.LieEnvelopingEquiv.map j
  let e := Function.Embedding.subtype p
  let BC := orderedMonomialBasis c
    (orderedSubindices_nodup p (weightOrderedIndices_nodup d))
    (fun a => mem_orderedSubindices p a (mem_weightOrderedIndices d a.val))
  let B := weightOrderedPBWBasis b d
  have hmap (β : {a // p a} →₀ ℕ) : J (BC β) = B (β.embDomain e) := by
    change J (BC β) = weightOrderedPBWBasis b d (β.embDomain e)
    rw [weightOrderedPBWBasis_apply]
    change J (BC β) = orderedMonomial k L b s (β.embDomain e)
    rw [← map_orderedMonomial_subindices b p j c hc s β]
    congr 1
    exact orderedMonomialBasis_apply c
      (orderedSubindices_nodup p (weightOrderedIndices_nodup d))
      (fun a => mem_orderedSubindices p a (mem_weightOrderedIndices d a.val)) β
  have hα : B.coord (α.embDomain e) ∘ₗ J.toLinearMap = BC.coord α := by
    refine BC.ext fun β => ?_
    rw [LinearMap.comp_apply, AlgHom.toLinearMap_apply, hmap, Module.Basis.coord_apply,
      Module.Basis.coord_apply, Module.Basis.repr_self, Module.Basis.repr_self]
    by_cases h : α = β
    · subst β
      rw [Finsupp.single_eq_same, Finsupp.single_eq_same]
    · rw [Finsupp.single_eq_of_ne ((Finsupp.embDomain_injective e).ne h),
        Finsupp.single_eq_of_ne h]
  exact LinearMap.congr_fun hα u

include hc in
/-- A Levi enveloping element whose image has only positive PBW coordinates
is zero. -/
theorem eq_zero_of_envelopingMap_mem_positivePBWSpan (u : UniversalEnvelopingAlgebra k M)
    (hu : Langlands.Algebra.LieEnvelopingEquiv.map j u ∈ positivePBWSpan b d) :
    u = 0 := by
  let BC := orderedMonomialBasis c
    (orderedSubindices_nodup (fun a => d a = 0) (weightOrderedIndices_nodup d))
    (fun a => mem_orderedSubindices (fun a => d a = 0) a (mem_weightOrderedIndices d a.val))
  apply BC.repr.injective
  ext α
  rw [map_zero, Finsupp.zero_apply, ← repr_envelopingMap_embDomain b d j c hc u α]
  refine positivePBWSpan_coord_zero b d (fun a ha => ?_) hu
  exact Finsupp.embDomain_of_notMem_range _ _ _ (by
    rintro ⟨a', rfl⟩
    exact (ne_of_gt ha) a'.property)

end ZeroWeight

section Stability

variable {M : Type z} [LieRing M] [LieAlgebra k M]
  (j : M →ₗ⁅k⁆ L)
  (hbr : ∀ x (a : I), 0 < d a →
    ⁅j x, b a⁆ ∈ Submodule.span k (b '' {a | 0 < d a}))

omit [Fintype I] [DecidableEq I] in
theorem mul_mem_positiveWeightRightIdeal_of_span
    {x : L} (hx : x ∈ Submodule.span k (b '' {a | 0 < d a})) (u : U) :
    ι x * u ∈ positiveWeightRightIdeal b d := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    exact Submodule.subset_span ⟨a, ha, u, rfl⟩
  | zero => rw [map_zero, zero_mul]; exact (positiveWeightRightIdeal b d).zero_mem
  | add x y _ _ hx hy => rw [map_add, add_mul]; exact (positiveWeightRightIdeal b d).add_mem hx hy
  | smul t x _ hx => rw [map_smul, smul_mul_assoc]; exact (positiveWeightRightIdeal b d).smul_mem t hx

omit [Fintype I] [DecidableEq I] in
include hbr in
private theorem positiveWeightRightIdeal_stable_generator (x : M) {u : U}
    (hu : u ∈ positiveWeightRightIdeal b d) :
    ι (j x) * u ∈ positiveWeightRightIdeal b d := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨a, ha, v, rfl⟩ := hu
    have h1 := (UniversalEnvelopingAlgebra.ι k (L := L)).map_lie (j x) (b a)
    have h2 : ι (j x) * (ι (b a) * v) =
        ι (b a) * (ι (j x) * v) + ι ⁅j x, b a⁆ * v := by
      rw [h1, Ring.lie_def]
      noncomm_ring
    rw [h2]
    exact (positiveWeightRightIdeal b d).add_mem
      (Submodule.subset_span ⟨a, ha, _, rfl⟩)
      (mul_mem_positiveWeightRightIdeal_of_span b d (hbr x a ha) v)
  | zero => rw [mul_zero]; exact (positiveWeightRightIdeal b d).zero_mem
  | add x y _ _ hx hy => rw [mul_add]; exact (positiveWeightRightIdeal b d).add_mem hx hy
  | smul t x _ hx => rw [mul_smul_comm]; exact (positiveWeightRightIdeal b d).smul_mem t hx

omit [Fintype I] [DecidableEq I] in
include hbr in
/-- Stability of the positive generators under Levi brackets gives stability
of the right ideal under left multiplication by every Levi operator. -/
theorem positiveWeightRightIdeal_stable_enveloping (a : UniversalEnvelopingAlgebra k M)
    (u : U) (hu : u ∈ positiveWeightRightIdeal b d) :
    Langlands.Algebra.LieEnvelopingEquiv.map j a * u ∈ positiveWeightRightIdeal b d := by
  let J := Langlands.Algebra.LieEnvelopingEquiv.map j
  obtain ⟨N, hN⟩ := exists_mem_degreeFiltration k M a
  have ha := degreeFiltration_le_wordSpan k M N hN
  clear hN
  revert u
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, hl, rfl⟩ := ha
    clear hl
    induction l with
    | nil =>
      intro u hu
      simpa only [word_nil, map_one, one_mul] using hu
    | cons x l ih =>
      intro u hu
      rw [word_cons, map_mul, mul_assoc, Langlands.Algebra.LieEnvelopingEquiv.map_generator]
      exact positiveWeightRightIdeal_stable_generator b d j hbr x (ih u hu)
  | zero => intro u _; rw [map_zero, zero_mul]; exact (positiveWeightRightIdeal b d).zero_mem
  | add x y _ _ hx hy =>
    intro u hu
    rw [map_add, add_mul]
    exact (positiveWeightRightIdeal b d).add_mem (hx _ hu) (hy _ hu)
  | smul t x _ hx =>
    intro u hu
    rw [map_smul, smul_mul_assoc]
    exact (positiveWeightRightIdeal b d).smul_mem t (hx _ hu)

end Stability

section Decomposition

variable [CharZero k] {M : Type z} {N : Type z'} [LieRing M] [LieAlgebra k M] [LieRing N] [LieAlgebra k N]
  (j : M →ₗ⁅k⁆ L) (jN : N →ₗ⁅k⁆ L)
  (b₀ : Module.Basis {a : I // d a = 0} k M) (bN : Module.Basis {a : I // 0 < d a} k N)
  (h₀ : ∀ a, j (b₀ a) = b a.val) (hN : ∀ a, jN (bN a) = b a.val)
  (ev : I → k) (ψ : k →+ ℝ) (hψ : ∀ a, ψ (ev a) = d a)
  (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)

omit [Fintype I] in
include h₀ hψ hH in
private theorem bracket_mem_positiveSpan (x : M) (a : I) (ha : 0 < d a) :
    ⁅j x, b a⁆ ∈ Submodule.span k (b '' {a | 0 < d a}) := by
  have hx : x ∈ Submodule.span k (Set.range b₀) := b₀.mem_span x
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨q, rfl⟩ := hx
    rw [h₀]
    refine Submodule.span_mono ?_ (lie_basis_mem_span b d ev ψ hψ H hH q.val a)
    rintro _ ⟨e, he, rfl⟩
    refine ⟨e, ?_, rfl⟩
    simp only [Set.mem_ofPred_eq] at he ⊢
    rw [he, q.property, zero_add]
    exact ha
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, add_lie]; exact Submodule.add_mem _ hx hy
  | smul t x _ hx => rw [map_smul, smul_lie]; exact Submodule.smul_mem _ t hx

include h₀ hN hψ hH in
/-- The positive and zero parts of an adjoint grading give the
triangular decomposition needed for the relative centre projection. -/
def relativeEnvelopingDecomposition_of_weight :
    RelativeEnvelopingDecomposition (Langlands.Algebra.LieEnvelopingEquiv.map j) where
  ideal := positiveWeightRightIdeal b d
  mul_mem_right _ hx y := mul_mem_positiveWeightRightIdeal b d hx y
  levi_mul_mem a u hu := positiveWeightRightIdeal_stable_enveloping b d j
    (bracket_mem_positiveSpan b d j b₀ h₀ ev ψ hψ H hH) a u hu
  eq_zero_of_mem a ha := eq_zero_of_envelopingMap_mem_positivePBWSpan b d j b₀ h₀ a
    (positiveWeightRightIdeal_le_positivePBWSpan b d jN bN hN ha)
  exists_representative z := by
    let J := Langlands.Algebra.LieEnvelopingEquiv.map j
    have hr : zeroWeightEnvelopingSubalgebra b d ≤ J.range := by
      apply Algebra.adjoin_le
      rintro _ ⟨a, ha, rfl⟩
      exact ⟨UniversalEnvelopingAlgebra.ι k (b₀ ⟨a, ha⟩),
        (Langlands.Algebra.LieEnvelopingEquiv.map_generator j _).trans
          (congrArg (UniversalEnvelopingAlgebra.ι k) (h₀ ⟨a, ha⟩))⟩
    obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp
      (center_mem_positiveWeight_sup_zeroWeight b d ev ψ hψ H hH z)
    obtain ⟨a, ha⟩ := hr hy
    refine ⟨a, ?_⟩
    change J a = y at ha
    change z.val - J a ∈ _
    rw [ha, ← hxy, add_sub_cancel_right]
    exact hx

end Decomposition





end PositiveIdeal

section PositiveLie
variable {k : Type u} [Field k] {L : Type v} [LieRing L] [LieAlgebra k L]
  {I : Type w} (b : Module.Basis I k L) (d : I → ℝ)

private theorem lie_mem_positiveWeightSpan (ev : I → k) (ψ : k →+ ℝ)
    (hψ : ∀ a, ψ (ev a) = d a) (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)
    {x y : L} (hx : x ∈ Submodule.span k (b '' {a | 0 < d a}))
    (hy : y ∈ Submodule.span k (b '' {a | 0 < d a})) :
    ⁅x, y⁆ ∈ Submodule.span k (b '' {a | 0 < d a}) := by
  let P := Submodule.span k (b '' {a | 0 < d a})
  change x ∈ P at hx
  change y ∈ P at hy
  change ⁅x, y⁆ ∈ P
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨q, hq, rfl⟩ := hy
      refine Submodule.span_mono ?_ (lie_basis_mem_span b d ev ψ hψ H hH a q)
      rintro _ ⟨e, he, rfl⟩
      refine ⟨e, ?_, rfl⟩
      simp only [Set.mem_ofPred_eq] at he ha hq ⊢
      rw [he]
      exact add_pos ha hq
    | zero => simpa only [lie_zero] using P.zero_mem
    | add y z _ _ hy hz => rw [lie_add]; exact P.add_mem hy hz
    | smul t y _ hy => rw [lie_smul]; exact P.smul_mem t hy
  | zero => simpa only [zero_lie] using P.zero_mem
  | add x z _ _ hx hz => rw [add_lie]; exact P.add_mem hx hz
  | smul t x _ hx => rw [smul_lie]; exact P.smul_mem t hx

variable (ev : I → k) (ψ : k →+ ℝ) (hψ : ∀ a, ψ (ev a) = d a)
  (H : L) (hH : ∀ a, ⁅H, b a⁆ = ev a • b a)

/-- The span of the positive weight directions is a Lie subalgebra. -/
def positiveWeightLieSubalgebra : LieSubalgebra k L where
  __ := Submodule.span k (b '' {a | 0 < d a})
  lie_mem' := lie_mem_positiveWeightSpan b d ev ψ hψ H hH

/-- The restricted basis of the positive Lie subalgebra. -/
def positiveWeightLieBasis : Module.Basis {a : I // 0 < d a} k
    (positiveWeightLieSubalgebra b d ev ψ hψ H hH) :=
  (Module.Basis.span (b.linearIndependent.comp Subtype.val Subtype.val_injective)).map
    (LinearEquiv.ofEq _ _ (by
      change Submodule.span k (Set.range (fun a : {a : I // 0 < d a} => b a.val)) =
        Submodule.span k (b '' {a | 0 < d a})
      congr 1
      ext x
      exact ⟨fun ⟨a, h⟩ => ⟨a.val, a.property, h⟩,
        fun ⟨a, ha, h⟩ => ⟨⟨a, ha⟩, h⟩⟩))

@[simp]
theorem positiveWeightLieSubalgebra_incl_basis (a : {a : I // 0 < d a}) :
    (positiveWeightLieSubalgebra b d ev ψ hψ H hH).incl
      (positiveWeightLieBasis b d ev ψ hψ H hH a) = b a.val := by
  rw [positiveWeightLieBasis, Module.Basis.map_apply, Module.Basis.span_apply]
  rfl

end PositiveLie

