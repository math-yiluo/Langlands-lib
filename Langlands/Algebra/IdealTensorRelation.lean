import Mathlib.RingTheory.Flat.EquationalCriterion
import Mathlib.Algebra.Module.LocalizedModule.Int
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.LinearAlgebra.TensorProduct.Vanishing

/-! # Tensor relations for a finitely generated ideal

For an ideal `I` generated by finitely many elements `g k`, every element of `I ⊗[B] X`
has the form `∑ k, g k ⊗ₜ x k`. Injectivity of `I ⊗[B] X → B ⊗[B] X` is therefore the
statement that every relation `∑ k, g k • x k = 0` has vanishing tensor `∑ k, g k ⊗ₜ x k`.
We show that this relation property, and flatness modulo `I`, pass from a module to its
localization along an algebra over `B`. -/

open scoped TensorProduct

namespace Langlands.Algebra
namespace IdealTensorRelation

variable {B : Type*} [CommRing B] (I : Ideal B) {r : ℕ} (g : Fin r → I)

/-- An element of `I • ⊤` is a combination of the generators of `I`. -/
theorem exists_sum_smul_of_mem_smul_top {X : Type*} [AddCommGroup X] [Module B X]
    (hg : Ideal.span (Set.range fun k ↦ (g k : B)) = I) {m : X}
    (hm : m ∈ I • (⊤ : Submodule B X)) :
    ∃ x : Fin r → X, m = ∑ k, (g k : B) • x k := by
  refine Submodule.smul_induction_on hm (fun c hc n _ ↦ ?_) (fun m m' hm hm' ↦ ?_)
  · rw [← hg] at hc
    obtain ⟨b, hb⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hc
    refine ⟨fun k ↦ b k • n, ?_⟩
    rw [← hb, Finset.sum_smul]
    exact Finset.sum_congr rfl fun k _ ↦ by rw [smul_smul, mul_comm]
  · obtain ⟨x, rfl⟩ := hm
    obtain ⟨x', rfl⟩ := hm'
    exact ⟨x + x', by simp [smul_add, Finset.sum_add_distrib]⟩

/-- Every element of `I ⊗[B] X` is a tensor combination of the generators of `I`. -/
theorem exists_eq_sum_tmul {X : Type*} [AddCommGroup X] [Module B X]
    (hg : Ideal.span (Set.range fun k ↦ (g k : B)) = I) (t : I ⊗[B] X) :
    ∃ x : Fin r → X, t = ∑ k, g k ⊗ₜ[B] x k := by
  induction t using TensorProduct.inductionOn with
  | tmul c n =>
    have hc : (c : B) ∈ Ideal.span (Set.range fun k ↦ (g k : B)) := by rw [hg]; exact c.2
    obtain ⟨b, hb⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hc
    have hc' : c = ∑ k, b k • g k := Subtype.ext (by simp [← hb])
    refine ⟨fun k ↦ b k • n, ?_⟩
    rw [hc', TensorProduct.sum_tmul]
    exact Finset.sum_congr rfl fun k _ ↦ TensorProduct.smul_tmul _ _ _
  | add t t' ht ht' =>
    obtain ⟨x, rfl⟩ := ht
    obtain ⟨x', rfl⟩ := ht'
    exact ⟨x + x', by simp [TensorProduct.tmul_add, Finset.sum_add_distrib]⟩

/-- Relation form of injectivity of the ideal tensor inclusion. -/
theorem rTensor_injective_of_relations {X : Type*} [AddCommGroup X] [Module B X]
    (hg : Ideal.span (Set.range fun k ↦ (g k : B)) = I)
    (h : ∀ x : Fin r → X, ∑ k, (g k : B) • x k = 0 → ∑ k, g k ⊗ₜ[B] x k = 0) :
    Function.Injective (LinearMap.rTensor X I.subtype) := by
  rw [injective_iff_map_eq_zero]
  intro t ht
  obtain ⟨x, rfl⟩ := exists_eq_sum_tmul I g hg t
  apply h x
  have := congrArg (TensorProduct.lid B X) ht
  simpa [map_sum] using this

/-- A trivial relation with the generators has vanishing generator tensor. -/
theorem sum_tmul_eq_zero_of_isTrivialRelation {X : Type*} [AddCommGroup X] [Module B X]
    {x : Fin r → X} (h : Module.IsTrivialRelation (fun k ↦ (g k : B)) x) :
    ∑ k, g k ⊗ₜ[B] x k = 0 := by
  obtain ⟨n, a, y, hxy, hay⟩ := h
  apply TensorProduct.sum_tmul_eq_zero_of_vanishesTrivially
  refine ⟨n, a, y, hxy, fun j ↦ Subtype.ext ?_⟩
  simpa [mul_comm] using hay j

/-- Every element of a quotient base change is a pure tensor with first factor one. -/
theorem exists_eq_one_tmul {X : Type*} [AddCommGroup X] [Module B X] (t : (B ⧸ I) ⊗[B] X) :
    ∃ x : X, t = 1 ⊗ₜ[B] x := by
  obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _
    (TensorProduct.quotTensorEquivQuotSMul X I t)
  refine ⟨x, ?_⟩
  rw [← TensorProduct.quotTensorEquivQuotSMul_symm_mk I x, hx, LinearEquiv.symm_apply_apply]

/-- A pure tensor `1 ⊗ x` in a quotient base change vanishes exactly on `I • ⊤`. -/
theorem one_tmul_eq_zero_iff {X : Type*} [AddCommGroup X] [Module B X] (x : X) :
    (1 : B ⧸ I) ⊗ₜ[B] x = 0 ↔ x ∈ I • (⊤ : Submodule B X) := by
  rw [← (TensorProduct.quotTensorEquivQuotSMul X I).map_eq_zero_iff,
    TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul, Submodule.Quotient.mk_eq_zero]

/-- The quotient action on pure tensors `1 ⊗ x` is the action on the second factor. -/
theorem smul_one_tmul {X : Type*} [AddCommGroup X] [Module B X] (b : B) (x : X) :
    Ideal.Quotient.mk I b • ((1 : B ⧸ I) ⊗ₜ[B] x) = (1 : B ⧸ I) ⊗ₜ[B] (b • x) := by
  rw [TensorProduct.smul_tmul', ← TensorProduct.smul_tmul]
  congr 1

section Localization

variable {T : Type*} [CommRing T] [Algebra B T] (Sm : Submonoid T)
  {P N : Type*} [AddCommGroup P] [Module T P] [Module B P] [IsScalarTower B T P]
  [AddCommGroup N] [Module T N] [Module B N] [IsScalarTower B T N]

/-- Multiplication by an element of the localizing submonoid, as a `B`-linear automorphism. -/
noncomputable def unitSMulEquiv (ψ : P →ₗ[T] N) [IsLocalizedModule Sm ψ] (c : Sm) :
    N ≃ₗ[B] N :=
  LinearEquiv.ofBijective ((algebraMap T (Module.End T N) c).restrictScalars B)
    (by
      have h := (Module.End.isUnit_iff _).mp (IsLocalizedModule.map_units ψ c)
      exact h)

omit [Module B P] [IsScalarTower B T P] in
@[simp] theorem unitSMulEquiv_apply (ψ : P →ₗ[T] N) [IsLocalizedModule Sm ψ] (c : Sm) (n : N) :
    unitSMulEquiv (B := B) Sm ψ c n = (c : T) • n := rfl

variable (ψ : P →ₗ[T] N) [IsLocalizedModule Sm ψ]

include Sm in
/-- The generator-relation property descends along a localization of modules. -/
theorem relations_of_isLocalizedModule
    (h : ∀ p : Fin r → P, ∑ k, (g k : B) • p k = 0 → ∑ k, g k ⊗ₜ[B] ψ (p k) = 0)
    (x : Fin r → N) (hx : ∑ k, (g k : B) • x k = 0) :
    ∑ k, g k ⊗ₜ[B] x k = 0 := by
  obtain ⟨s, hs⟩ := IsLocalizedModule.exist_integer_multiples_of_finite Sm ψ x
  choose p hp using hs
  have h0 : ψ (∑ k, (g k : B) • p k) = 0 := by
    simp only [map_sum, LinearMap.map_smul_of_tower, hp]
    simp_rw [smul_comm (g _ : B) (s : T)]
    rw [← Finset.smul_sum, hx, smul_zero]
  obtain ⟨u, hu⟩ := (IsLocalizedModule.eq_zero_iff Sm ψ).mp h0
  have h1 := h (fun k ↦ (u : T) • p k) (by
    simp_rw [smul_comm (g _ : B) (u : T)]
    rw [← Finset.smul_sum]
    exact hu)
  have h2 : ∑ k, g k ⊗ₜ[B] ψ ((u : T) • p k) =
      (unitSMulEquiv (B := B) Sm ψ (u * s)).lTensor I (∑ k, g k ⊗ₜ[B] x k) := by
    simp [map_sum, hp, mul_smul]
  rw [h2] at h1
  exact (LinearEquiv.map_eq_zero_iff _).mp h1

include Sm ψ in
/-- Flatness modulo the ideal descends along a localization of modules. -/
theorem flat_of_isLocalizedModule
    (hg : Ideal.span (Set.range fun k ↦ (g k : B)) = I)
    [Module.Flat (B ⧸ I) ((B ⧸ I) ⊗[B] P)] :
    Module.Flat (B ⧸ I) ((B ⧸ I) ⊗[B] N) := by
  refine Module.Flat.of_forall_isTrivialRelation fun {l f y} hfy ↦ ?_
  choose n hn using fun k ↦ exists_eq_one_tmul I (y k)
  choose c hc using fun k ↦ Ideal.Quotient.mk_surjective (f k)
  have hrel : ∑ k, c k • n k ∈ I • (⊤ : Submodule B N) := by
    rw [← one_tmul_eq_zero_iff, TensorProduct.tmul_sum]
    simp_rw [← smul_one_tmul, hc, ← hn]
    exact hfy
  obtain ⟨m, hm⟩ := exists_sum_smul_of_mem_smul_top I g hg hrel
  obtain ⟨s, hs⟩ := IsLocalizedModule.exist_integer_multiples_of_finite Sm ψ (Sum.elim n m)
  choose p hp using hs
  have h0 : ψ (∑ k, c k • p (Sum.inl k) - ∑ k, (g k : B) • p (Sum.inr k)) = 0 := by
    simp only [map_sub, map_sum, LinearMap.map_smul_of_tower, hp, Sum.elim_inl, Sum.elim_inr]
    simp_rw [smul_comm _ (s : T)]
    rw [← Finset.smul_sum, ← Finset.smul_sum, ← smul_sub, hm, sub_self, smul_zero]
  obtain ⟨u, hu⟩ := (IsLocalizedModule.eq_zero_iff Sm ψ).mp h0
  have hrelP : ∑ k, f k • ((1 : B ⧸ I) ⊗ₜ[B] ((u : T) • p (Sum.inl k))) = 0 := by
    have huv : ∑ k, c k • ((u : T) • p (Sum.inl k)) =
        ∑ k, (g k : B) • ((u : T) • p (Sum.inr k)) := by
      rw [Submonoid.smul_def, smul_sub, sub_eq_zero, Finset.smul_sum, Finset.smul_sum] at hu
      simpa only [smul_comm _ (u : T)] using hu
    simp_rw [← hc, smul_one_tmul]
    rw [← TensorProduct.tmul_sum, huv, one_tmul_eq_zero_iff]
    exact Submodule.sum_mem _ fun k _ ↦ Submodule.smul_mem_smul (g k).2 Submodule.mem_top
  obtain ⟨q, a, z, hxz, haz⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrelP
  let Φ : (B ⧸ I) ⊗[B] P →ₗ[B ⧸ I] (B ⧸ I) ⊗[B] N :=
    LinearMap.baseChange (B ⧸ I)
      ((unitSMulEquiv (B := B) Sm ψ (u * s)).symm.toLinearMap ∘ₗ ψ.restrictScalars B)
  have hΦ : ∀ k, Φ ((1 : B ⧸ I) ⊗ₜ[B] ((u : T) • p (Sum.inl k))) = y k := by
    intro k
    have he : ψ ((u : T) • p (Sum.inl k)) = unitSMulEquiv (B := B) Sm ψ (u * s) (n k) := by
      rw [LinearMap.map_smul, hp, unitSMulEquiv_apply, Submonoid.coe_mul, mul_smul]
      rfl
    simp only [Φ, LinearMap.baseChange_tmul, LinearMap.coe_comp, Function.comp_apply,
      LinearMap.coe_restrictScalars, he, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply, hn]
  refine ⟨q, a, fun j ↦ Φ (z j), fun k ↦ ?_, haz⟩
  have hk := hxz k
  simp only at hk
  rw [← hΦ k, hk, map_sum]
  simp only [map_smul]

end Localization

end IdealTensorRelation
end Langlands.Algebra
