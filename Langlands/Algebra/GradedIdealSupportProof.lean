import Langlands.Algebra.GradedIdealSupportStatement
import Mathlib.Algebra.DirectSum.Decomposition
import Mathlib.RingTheory.Filtration

/-! # Positive generation of the support of a graded proper ideal -/

universe u v w

namespace Langlands.Algebra.GradedIdealSupport

open Classical

variable {k : Type u} [Field k] {R : Type v} [CommRing R] [Algebra k R]
    {Λ : Type w}

private theorem square_induction (I : Ideal R) {P : I → Prop}
    (hmul : ∀ x y : I, P (x * y))
    (hadd : ∀ x y : I, P x → P y → P (x + y))
    (x : I) (hx : (x : R) ∈ I ^ 2) : P x := by
  rw [pow_two] at hx
  exact Submodule.mul_induction_on'
    (C := fun r hr => P ⟨r, Ideal.mul_le_left hr⟩)
    (fun a ha b hb => hmul ⟨a, ha⟩ ⟨b, hb⟩)
    (fun a ha b hb hpa hpb => hadd ⟨a, Ideal.mul_le_left ha⟩
      ⟨b, Ideal.mul_le_left hb⟩ hpa hpb) hx

private noncomputable def homogeneousProjection (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) (χ : Λ) : I →ₗ[k] I :=
  (W χ).subtype ∘ₗ DirectSum.component k Λ (fun ψ => W ψ) χ ∘ₗ
    (LinearEquiv.ofBijective (DirectSum.coeLinearMap W) hW).symm.toLinearMap

private theorem homogeneousProjection_same (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) (χ : Λ) {x : I} (hx : x ∈ W χ) :
    homogeneousProjection I W hW χ x = x := by
  classical
  exact congrArg Subtype.val (hW.ofBijective_coeLinearMap_of_mem hx)

private theorem homogeneousProjection_ne (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) {χ ψ : Λ} (hχψ : ψ ≠ χ)
    {x : I} (hx : x ∈ W ψ) :
    homogeneousProjection I W hW χ x = 0 := by
  classical
  exact congrArg Subtype.val (hW.ofBijective_coeLinearMap_of_mem_ne hχψ hx)

private theorem homogeneous_induction (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W) {P : I → Prop} (hzero : P 0)
    (hhom : ∀ (χ : Λ) (x : I), x ∈ W χ → P x)
    (hadd : ∀ x y : I, P x → P y → P (x + y)) : ∀ x : I, P x := by
  classical
  let := hW.chooseDecomposition
  exact DirectSum.Decomposition.inductionOn W hzero
    (fun {χ} x => hhom χ x x.property) hadd

variable [AddCommGroup Λ]

private theorem excluded_mem_pow (I : Ideal R) (W : Λ → Submodule k I)
    (hW : DirectSum.IsInternal W)
    (hmul : ∀ (χ ψ : Λ) (x y : I),
      x ∈ W χ → y ∈ W ψ → x * y ∈ W (χ + ψ))
    (S : AddSubsemigroup Λ) (hS : cotangentLiftSupport I W ⊆ S) (n : ℕ) :
    ∀ χ : Λ, χ ∉ S → ∀ x : I, x ∈ W χ → (x : R) ∈ I ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    intro χ hχ x hx
    have hx2 : (x : R) ∈ I ^ 2 := by
      apply (I.toCotangent_eq_zero x).mp
      by_contra h
      exact hχ (hS ⟨x, hx, h⟩)
    let p := homogeneousProjection I W hW χ
    have hprod : ∀ a b : I, (p (a * b) : R) ∈ I ^ (n + 1) := by
      intro a b
      refine homogeneous_induction I W hW
        (P := fun a => ∀ b : I, (p (a * b) : R) ∈ I ^ (n + 1)) ?_ ?_ ?_ a b
      · intro b
        simp
      · intro α a ha b
        refine homogeneous_induction I W hW
          (P := fun b => (p (a * b) : R) ∈ I ^ (n + 1)) ?_ ?_ ?_ b
        · simp
        · intro β b hb
          have hab := hmul α β a b ha hb
          by_cases heq : α + β = χ
          · have hp : p (a * b) = a * b :=
              homogeneousProjection_same I W hW χ (heq ▸ hab)
            rw [hp]
            change (a : R) * (b : R) ∈ I ^ (n + 1)
            by_cases hα : α ∈ S
            · have hβ : β ∉ S := fun hβ => hχ (heq ▸ S.add_mem hα hβ)
              rw [pow_succ']
              exact Ideal.mul_mem_mul a.property (ih β hβ b hb)
            · rw [pow_succ]
              exact Ideal.mul_mem_mul (ih α hα a ha) b.property
          · have hp : p (a * b) = 0 :=
              homogeneousProjection_ne I W hW heq hab
            simp [hp]
        · intro b b' hb hb'
          simpa only [mul_add, map_add, Submodule.coe_add] using
            (I ^ (n + 1)).add_mem hb hb'
      · intro a a' ha ha' b
        simpa only [add_mul, map_add, Submodule.coe_add] using
          (I ^ (n + 1)).add_mem (ha b) (ha' b)
    have hpx := square_induction I (P := fun z => (p z : R) ∈ I ^ (n + 1)) hprod
      (fun a b ha hb => by
        simpa only [map_add, Submodule.coe_add] using
          (I ^ (n + 1)).add_mem ha hb) x hx2
    change (homogeneousProjection I W hW χ x : R) ∈ I ^ (n + 1) at hpx
    rwa [homogeneousProjection_same I W hW χ hx] at hpx

/-- The raw homogeneous ideal support is generated by positive sums of the
labels admitting nonzero classes in the actual cotangent quotient. -/
theorem positiveGeneration : PositiveGenerationStatement.{u, v, w} := by
  intro k _ R _ _ _ _ Λ _ I hI W hW hmul
  apply Set.Subset.antisymm
  · rintro χ ⟨x, hx0, hxW⟩
    by_contra hχ
    have hxpow : (x : R) ∈ ⨅ n : ℕ, I ^ n := by
      apply (Submodule.mem_iInf _).mpr
      intro n
      exact excluded_mem_pow I W hW hmul
        (AddSubsemigroup.closure (cotangentLiftSupport I W))
        AddSubsemigroup.subset_closure n χ hχ x hxW
    rw [I.iInf_pow_eq_bot_of_isDomain hI] at hxpow
    exact hx0 (Subtype.ext ((Ideal.mem_bot).mp hxpow))
  · intro χ hχ
    induction hχ using AddSubsemigroup.closure_induction with
    | mem χ hχ =>
      rcases hχ with ⟨x, hxW, hx⟩
      refine ⟨x, ?_, hxW⟩
      intro hzero
      exact hx (hzero ▸ map_zero I.toCotangent)
    | add α β _ _ hα hβ =>
      rcases hα with ⟨x, hx0, hxW⟩
      rcases hβ with ⟨y, hy0, hyW⟩
      refine ⟨x * y, ?_, hmul α β x y hxW hyW⟩
      have hxR : (x : R) ≠ 0 := fun h => hx0 (Subtype.ext h)
      have hyR : (y : R) ≠ 0 := fun h => hy0 (Subtype.ext h)
      intro h
      exact mul_ne_zero hxR hyR (congrArg Subtype.val h)

end Langlands.Algebra.GradedIdealSupport
