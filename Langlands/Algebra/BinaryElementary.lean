import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Tactic.FinCases

/-! Elementary binary matrices over rings and division rings. -/

namespace Langlands.BinaryElementary

universe u

variable {D : Type u} [Ring D]

/-- Actual invertible binary matrices over the coefficient ring. -/
abbrev GL₂ (D : Type u) [Ring D] := (Matrix (Fin 2) (Fin 2) D)ˣ

/-- The upper elementary matrix, with its explicit inverse. -/
def upper (x : D) : GL₂ D where
  val := !![1, x; 0, 1]
  inv := !![1, -x; 0, 1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- The lower elementary matrix, with its explicit inverse. -/
def lower (x : D) : GL₂ D where
  val := !![1, 0; x, 1]
  inv := !![1, 0; -x, 1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- The diagonal binary unit with two prescribed unit entries. -/
def diagonal (a b : Dˣ) : GL₂ D where
  val := !![(a : D), 0; 0, (b : D)]
  inv := !![((a⁻¹ : Dˣ) : D), 0; 0, ((b⁻¹ : Dˣ) : D)]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem val_upper (x : D) :
    (upper x : Matrix (Fin 2) (Fin 2) D) = !![1, x; 0, 1] := rfl

@[simp] theorem val_lower (x : D) :
    (lower x : Matrix (Fin 2) (Fin 2) D) = !![1, 0; x, 1] := rfl

@[simp] theorem val_diagonal (a b : Dˣ) :
    (diagonal a b : Matrix (Fin 2) (Fin 2) D) = !![(a : D), 0; 0, (b : D)] := rfl

@[simp] theorem upper_inv (x : D) : (upper x)⁻¹ = upper (-x) := by
  apply Units.ext
  rfl

@[simp] theorem lower_inv (x : D) : (lower x)⁻¹ = lower (-x) := by
  apply Units.ext
  rfl

@[simp] theorem diagonal_inv (a b : Dˣ) :
    (diagonal a b)⁻¹ = diagonal a⁻¹ b⁻¹ := by
  apply Units.ext
  rfl

theorem upper_add (x y : D) : upper (x + y) = upper x * upper y := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [upper, Matrix.mul_apply, Fin.sum_univ_two, add_comm]

theorem lower_add (x y : D) : lower (x + y) = lower x * lower y := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lower, Matrix.mul_apply, Fin.sum_univ_two]

theorem diagonal_mul (a b c d : Dˣ) :
    diagonal a b * diagonal c d = diagonal (a * c) (b * d) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [diagonal, Matrix.mul_apply, Fin.sum_univ_two]

/-- The subgroup generated by all upper and lower elementary matrices. -/
def elementary (D : Type u) [Ring D] : Subgroup (GL₂ D) :=
  Subgroup.closure (Set.range upper ∪ Set.range lower)

theorem upper_mem (x : D) : upper x ∈ elementary D :=
  Subgroup.subset_closure (Or.inl ⟨x, rfl⟩)

theorem lower_mem (x : D) : lower x ∈ elementary D :=
  Subgroup.subset_closure (Or.inr ⟨x, rfl⟩)

/-- The signed row interchange, expressed as three elementary matrices. -/
def weyl : GL₂ D := upper 1 * lower (-1) * upper 1

theorem weyl_mem : weyl (D := D) ∈ elementary D :=
  (elementary D).mul_mem ((elementary D).mul_mem (upper_mem 1) (lower_mem (-1)))
    (upper_mem 1)

@[simp] theorem val_weyl :
    (weyl (D := D) : Matrix (Fin 2) (Fin 2) D) = !![0, 1; -1, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [weyl, upper, lower, Matrix.mul_apply, Fin.sum_univ_two]

theorem diagonal_conj_upper (a b : Dˣ) (x : D) :
    diagonal a b * upper x * (diagonal a b)⁻¹ =
      upper ((a : D) * x * ((b⁻¹ : Dˣ) : D)) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [diagonal, upper, Matrix.mul_apply, Fin.sum_univ_two, mul_assoc]

theorem diagonal_conj_lower (a b : Dˣ) (x : D) :
    diagonal a b * lower x * (diagonal a b)⁻¹ =
      lower ((b : D) * x * ((a⁻¹ : Dˣ) : D)) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [diagonal, lower, Matrix.mul_apply, Fin.sum_univ_two, mul_assoc]

section DivisionRing

variable {D : Type u} [DivisionRing D]

/-- Two elementary operations remove the off-diagonal entries at a nonzero pivot. -/
theorem eliminate (M : Matrix (Fin 2) (Fin 2) D) (ha : M 0 0 ≠ 0) :
    (lower (-M 1 0 * (M 0 0)⁻¹) : Matrix (Fin 2) (Fin 2) D) * M *
      (upper (-(M 0 0)⁻¹ * M 0 1) : Matrix (Fin 2) (Fin 2) D) =
        !![M 0 0, 0; 0, M 1 1 - M 1 0 * (M 0 0)⁻¹ * M 0 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lower, upper, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two,
      mul_assoc, ha, sub_eq_add_neg, add_comm]

/-- An invertible binary matrix cannot have a zero first column. -/
theorem firstColumn_ne_zero (g : GL₂ D) :
    g.val 0 0 ≠ 0 ∨ g.val 1 0 ≠ 0 := by
  by_cases ha : g.val 0 0 = 0
  · right
    intro hc
    have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) D => M 0 0) g.inv_mul
    simp [Matrix.mul_apply, Fin.sum_univ_two, ha, hc] at h
  · exact Or.inl ha

/-- At a nonzero pivot the diagonal entries obtained by elimination are units. -/
theorem exists_diagonal_reduction_of_pivot (g : GL₂ D) (ha : g.val 0 0 ≠ 0) :
    ∃ (e f : GL₂ D) (a b : Dˣ),
      e ∈ elementary D ∧ f ∈ elementary D ∧ e * g * f = diagonal a b := by
  let e := lower (-g.val 1 0 * (g.val 0 0)⁻¹)
  let f := upper (-(g.val 0 0)⁻¹ * g.val 0 1)
  let s := g.val 1 1 - g.val 1 0 * (g.val 0 0)⁻¹ * g.val 0 1
  have hk : (e * g * f).val = !![g.val 0 0, 0; 0, s] := eliminate g.val ha
  have hs : s ≠ 0 := by
    intro hs
    have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) D => M 1 1)
      (e * g * f).mul_inv
    rw [hk] at h
    simp [Matrix.mul_apply, Fin.sum_univ_two, hs] at h
  refine ⟨e, f, Units.mk0 _ ha, Units.mk0 _ hs, lower_mem _, upper_mem _, ?_⟩
  exact Units.ext hk

/-- Every invertible binary matrix over a division ring reduces to a unit diagonal. -/
theorem exists_diagonal_reduction (g : GL₂ D) :
    ∃ (e f : GL₂ D) (a b : Dˣ),
      e ∈ elementary D ∧ f ∈ elementary D ∧ e * g * f = diagonal a b := by
  rcases firstColumn_ne_zero g with ha | hc
  · exact exists_diagonal_reduction_of_pivot g ha
  · have hp : (weyl * g).val 0 0 ≠ 0 := by
      simpa [Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two] using hc
    obtain ⟨e, f, a, b, he, hf, h⟩ :=
      exists_diagonal_reduction_of_pivot (weyl * g) hp
    exact ⟨e * weyl, f, a, b, (elementary D).mul_mem he weyl_mem, hf,
      by simpa only [mul_assoc] using h⟩

/-- Equivalently, every binary unit is a product elementary-diagonal-elementary. -/
theorem exists_elementary_diagonal_elementary (g : GL₂ D) :
    ∃ (e f : GL₂ D) (a b : Dˣ),
      e ∈ elementary D ∧ f ∈ elementary D ∧ g = e * diagonal a b * f := by
  obtain ⟨e, f, a, b, he, hf, h⟩ := exists_diagonal_reduction g
  refine ⟨e⁻¹, f⁻¹, a, b, (elementary D).inv_mem he, (elementary D).inv_mem hf, ?_⟩
  rw [← h]
  simp [mul_assoc]

end DivisionRing

end Langlands.BinaryElementary
