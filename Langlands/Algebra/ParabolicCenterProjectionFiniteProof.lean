import Langlands.Algebra.ParabolicCenterProjectionLeading
import Mathlib.RingTheory.Adjoin.Tower
import Mathlib.RingTheory.FiniteType

/-! # Finiteness of the parabolic projection of an enveloping centre: proof -/

noncomputable section

universe v w

set_option autoImplicit false

namespace Langlands.Algebra.ParabolicCenterProjection.GradingData

open LieAlgebra MvPolynomial Langlands.Algebra.LieWeightProjection
  Langlands.Algebra.LieEnvelopingSymbol Langlands.Algebra.MvPolynomialLeadingFinite

attribute [local instance 100] LieRing.ofAssociativeRing

variable {g : Type v} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g] {H : g}
  (D : GradingData g H)

/-- The index type of the leading forms: power sums and centre coordinates. -/
abbrev LeadIndex : Type :=
  Fin (Fintype.card D.ι) ⊕ Fin (Module.finrank ℂ (center ℂ g : Submodule ℂ g))

variable (g) in
/-- A basis of the centre. -/
def centerBasis : Module.Basis (Fin (Module.finrank ℂ (center ℂ g : Submodule ℂ g))) ℂ
    (center ℂ g : Submodule ℂ g) :=
  Module.finBasis ℂ _

/-- The degrees of the leading forms. -/
def leadDegree : D.LeadIndex → ℕ
  | Sum.inl k => k.val + 1
  | Sum.inr _ => 1

/-- The leading forms: the power sums `∑ ℓ q ^ (k+1)` and the restrictions of the linear symbols
of a basis of the centre. -/
def leadForm : D.LeadIndex → MvPolynomial D.zeroIndex ℂ
  | Sum.inl k => ∑ q, D.ell q ^ (k.val + 1)
  | Sum.inr a => D.zeroRestrict (ξ D.basis (centerBasis g a : g))

/-- **Graded finiteness.** The polynomial ring on the letters of grading zero is finite over the
subalgebra generated by the leading forms. -/
theorem moduleFinite_leadForm :
    Module.Finite (Algebra.adjoin ℂ (Set.range D.leadForm)) (MvPolynomial D.zeroIndex ℂ) := by
  classical
  set A := Algebra.adjoin ℂ (Set.range D.leadForm)
  have hpow (m : ℕ) (h1 : 1 ≤ m) (h2 : m ≤ Fintype.card D.ι) : ∑ q, D.ell q ^ m ∈ A := by
    refine Algebra.subset_adjoin ⟨Sum.inl ⟨m - 1, by omega⟩, ?_⟩
    simp only [leadForm]
    rw [Nat.sub_add_cancel h1]
  have hell (q : D.ι) : IsIntegral A (D.ell q) := isIntegral_of_powerSums D.ell A hpow q
  have hcen (c : g) (hc : c ∈ center ℂ g) : D.zeroRestrict (ξ D.basis c) ∈ A := by
    have hc' : c = ∑ a, (centerBasis g).repr ⟨c, hc⟩ a • (centerBasis g a : g) := by
      conv_lhs => rw [show c = ((⟨c, hc⟩ : (center ℂ g : Submodule ℂ g)) : g) from rfl,
        ← (centerBasis g).sum_repr ⟨c, hc⟩]
      rw [Submodule.coe_sum]
      rfl
    rw [hc', map_sum, map_sum]
    refine A.sum_mem fun a _ => ?_
    rw [map_smul, map_smul]
    exact A.smul_mem (Algebra.subset_adjoin ⟨Sum.inr a, rfl⟩) _
  let S : Submodule ℂ g :=
    { carrier := {v | IsIntegral A (D.zeroRestrict (ξ D.basis v))}
      add_mem' := fun {x y} hx hy => by
        simp only [Set.mem_ofPred_eq, map_add] at hx hy ⊢
        exact hx.add hy
      zero_mem' := by
        simp only [Set.mem_ofPred_eq, map_zero]
        exact isIntegral_zero
      smul_mem' := fun c x hx => by
        simp only [Set.mem_ofPred_eq, map_smul] at hx ⊢
        rw [Algebra.smul_def, IsScalarTower.algebraMap_apply ℂ A]
        exact isIntegral_algebraMap.mul hx }
  have hS : Submodule.span ℂ (Set.range fun q => D.dualOf (D.wt q)) ⊔
      (center ℂ g : Submodule ℂ g) ≤ S := by
    refine sup_le (Submodule.span_le.mpr ?_) ?_
    · rintro _ ⟨q, rfl⟩
      exact hell q
    · intro c hc
      have := hcen c hc
      change IsIntegral A (D.zeroRestrict (ξ D.basis c))
      exact (isIntegral_algebraMap (R := A) (x := ⟨_, this⟩))
  have hX (a : D.zeroIndex) : IsIntegral A (X a : MvPolynomial D.zeroIndex ℂ) := by
    have h := hS (D.cartan_le_span_dualOf_sup_center (D.mem_cartan_of_φ_eq_zero a.2))
    change IsIntegral A (D.zeroRestrict (ξ D.basis (D.basis a.1))) at h
    rwa [ξ_basis, D.zeroRestrict_X_val] at h
  have : Algebra.IsIntegral A (MvPolynomial D.zeroIndex ℂ) := by
    constructor
    intro p
    induction p using MvPolynomial.induction_on with
    | C c =>
      change IsIntegral A (algebraMap ℂ (MvPolynomial D.zeroIndex ℂ) c)
      rw [IsScalarTower.algebraMap_apply ℂ A]
      exact isIntegral_algebraMap
    | add p q hp hq => exact hp.add hq
    | mul_X p a hp => exact hp.mul (hX a)
  have : Algebra.FiniteType A (MvPolynomial D.zeroIndex ℂ) :=
    Algebra.FiniteType.of_restrictScalars_finiteType ℂ A _
  exact Algebra.IsIntegral.finite

local notation "Ug" => UniversalEnvelopingAlgebra ℂ g

omit [FiniteDimensional ℂ g] in
theorem ι_mem_center {c : g} (hc : c ∈ center ℂ g) :
    UniversalEnvelopingAlgebra.ι ℂ c ∈ Subalgebra.center ℂ Ug :=
  Langlands.Archimedean.Kostant.mem_center_of_commute ℂ g fun x => by
    have h := (UniversalEnvelopingAlgebra.ι ℂ (L := g)).map_lie x c
    rw [(LieModule.mem_maxTrivSubmodule ℂ g g c).mp hc x, map_zero, Ring.lie_def] at h
    exact sub_eq_zero.mp h.symm

/-- The central elements whose Harish-Chandra images have the leading forms: Gelfand's elements
and a basis of the centre of `g`. -/
def leadElement : D.LeadIndex → Subalgebra.center ℂ Ug
  | Sum.inl k => ⟨LieGelfandCentral.gelfand D.form D.nondegenerate D.basis (k.val + 1),
      LieGelfandCentral.gelfand_mem_center D.form D.nondegenerate D.basis D.invariant _⟩
  | Sum.inr a => ⟨UniversalEnvelopingAlgebra.ι ℂ (centerBasis g a : g),
      ι_mem_center (centerBasis g a).2⟩

theorem leadElement_mem (i : D.LeadIndex) :
    (D.leadElement i).val ∈ UniversalEnveloping.degreeFiltration ℂ g (D.leadDegree i) := by
  cases i with
  | inl k => exact LieGelfandCentral.gelfand_mem D.form D.nondegenerate D.basis (k.val + 1)
  | inr a =>
    simpa [leadElement, leadDegree] using UniversalEnveloping.generator_mem_degreeOne ℂ g
      (centerBasis g a : g)

variable {m : Type w} [LieRing m] [LieAlgebra ℂ m] {j : m →ₗ⁅ℂ⁆ g}
  (hj : Function.Injective j) (hrange : ∀ X : g, X ∈ Set.range j ↔ ⁅H, X⁆ = 0)

local notation "Um" => UniversalEnvelopingAlgebra ℂ m

theorem homogeneousComponent_leadElement (P : Subalgebra.center ℂ Ug →ₐ[ℂ] Subalgebra.center ℂ Um)
    (hP : ∀ z : Subalgebra.center ℂ Ug, (z : Ug) -
      UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j) (P z : Um) ∈
        positiveRightIdeal H)
    (i : D.LeadIndex) :
    homogeneousComponent (D.leadDegree i) (D.hcMap hj hrange P (D.leadElement i)) =
      D.leadForm i := by
  rw [D.homogeneousComponent_hcMap hj hrange P hP]
  cases i with
  | inl k => exact D.zeroRestrict_symbol_gelfand _ _ (k.val + 1)
  | inr a => exact D.zeroRestrict_symbol_ι _ _ _

theorem moduleFinite_range_hcMap (P : Subalgebra.center ℂ Ug →ₐ[ℂ] Subalgebra.center ℂ Um)
    (hP : ∀ z : Subalgebra.center ℂ Ug, (z : Ug) -
      UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j) (P z : Um) ∈
        positiveRightIdeal H) :
    Module.Finite (D.hcMap hj hrange P).range (MvPolynomial D.zeroIndex ℂ) := by
  refine moduleFinite_of_leading (fun i => D.hcMap hj hrange P (D.leadElement i)) D.leadForm
    D.leadDegree (fun i => ?_) (fun i => ?_) D.moduleFinite_leadForm _ (fun i => ⟨_, rfl⟩)
  · rw [← D.homogeneousComponent_leadElement hj hrange P hP i]
    exact homogeneousComponent_isHomogeneous _ _
  · rw [← D.homogeneousComponent_leadElement hj hrange P hP i]
    exact D.degLT_sub_homogeneousComponent
      (D.hcMap_degLE hj hrange P hP _ (D.leadElement_mem i))

include D hj hrange in
theorem center_isNoetherian (P : Subalgebra.center ℂ Ug →ₐ[ℂ] Subalgebra.center ℂ Um)
    (hP : ∀ z : Subalgebra.center ℂ Ug, (z : Ug) -
      UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j) (P z : Um) ∈
        positiveRightIdeal H) :
    IsNoetherianRing (Subalgebra.center ℂ Ug) := by
  let γ := D.hcMap hj hrange P
  let A := γ.range
  have : Module.Finite A (MvPolynomial D.zeroIndex ℂ) := D.moduleFinite_range_hcMap hj hrange P hP
  have h : (⊤ : Subalgebra ℂ A).FG :=
    fg_of_fg_of_fg ℂ A (MvPolynomial D.zeroIndex ℂ) Algebra.FiniteType.out Module.Finite.fg_top
      Subtype.val_injective
  have : Algebra.FiniteType ℂ A := ⟨h⟩
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing ℂ A
  exact isNoetherianRing_of_ringEquiv A
    (AlgEquiv.ofInjective γ (D.hcMap_injective hj hrange P hP)).symm.toRingEquiv

theorem hcMap_finite (P : Subalgebra.center ℂ Ug →ₐ[ℂ] Subalgebra.center ℂ Um)
    (hP : ∀ z : Subalgebra.center ℂ Ug, (z : Ug) -
      UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j) (P z : Um) ∈
        positiveRightIdeal H) :
    (D.hcMap hj hrange P).Finite := by
  let γ := D.hcMap hj hrange P
  have h₁ : γ.rangeRestrict.Finite :=
    AlgHom.Finite.of_surjective _ (AlgHom.rangeRestrict_surjective _)
  have : Module.Finite γ.range (MvPolynomial D.zeroIndex ℂ) := D.moduleFinite_range_hcMap hj hrange P hP
  have h₂ : γ.range.val.Finite :=
    (RingHom.finite_algebraMap (A := γ.range) (B := MvPolynomial D.zeroIndex ℂ)).mpr this
  have h₃ : (γ.range.val.comp γ.rangeRestrict).Finite := h₂.comp h₁
  have h₄ : γ.range.val.comp γ.rangeRestrict = D.hcMap hj hrange P := AlgHom.ext fun _ => rfl
  rw [← h₄]
  exact h₃

include D hj hrange in
/-- **Finiteness of the parabolic projection.** -/
theorem finite (P : Subalgebra.center ℂ Ug →ₐ[ℂ] Subalgebra.center ℂ Um)
    (hP : ∀ z : Subalgebra.center ℂ Ug, (z : Ug) -
      UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j) (P z : Um) ∈
        positiveRightIdeal H) :
    P.Finite := by
  let Z := Subalgebra.center ℂ Ug
  let ZL := Subalgebra.center ℂ Um
  let Q := MvPolynomial D.zeroIndex ℂ
  let f := P
  let g' := D.leviHC hj hrange
  have hfg : (g'.comp f).Finite := D.hcMap_finite hj hrange P hP
  let : Algebra Z ZL := f.toRingHom.toAlgebra
  let : Algebra ZL Q := g'.toRingHom.toAlgebra
  let : Algebra Z Q := (g'.comp f).toRingHom.toAlgebra
  have : IsScalarTower Z ZL Q := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsNoetherianRing Z := D.center_isNoetherian hj hrange P hP
  have : Module.Finite Z Q := hfg
  change Module.Finite Z ZL
  exact Module.Finite.of_injective (IsScalarTower.toAlgHom Z ZL Q).toLinearMap
    (D.leviHC_injective hj hrange)

end Langlands.Algebra.ParabolicCenterProjection.GradingData

namespace Langlands.Algebra.ParabolicCenterProjection

/-- **Finiteness of the parabolic projection of the centre.** -/
theorem parabolicCenterProjectionFinite : ParabolicCenterProjectionFiniteStatement.{v, w} := by
  intro g _ _ _ m _ _ j H hred hspan hj hrange p hp
  obtain ⟨D⟩ := nonempty_gradingData hred H hspan
  exact D.finite hj hrange p hp

end Langlands.Algebra.ParabolicCenterProjection
