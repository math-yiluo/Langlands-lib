import Langlands.Algebra.LocalAlgebraApproximationExistenceStatement
import Mathlib.RingTheory.LocalRing.RingHom.Basic
import Mathlib.Tactic.IrreducibleDef

/-! # Existence of local algebra approximation systems (Stacks 00QV), proof -/

universe uR uS

namespace Langlands.Algebra

namespace LocalAlgebraApproximationExistence

/-! ## Local subrings essentially of finite type over `ℤ` -/

section BaseRing

variable {R : Type*} [CommRing R]

/-- The subring generated by the finite set `C ∪ A`. -/
def gen (C A : Finset R) : Subring R := Subring.closure ((C : Set R) ∪ A)

/-- The elements `a * s⁻¹` with `a, s` in `gen C A` and `s` a unit of `R`. It is irreducible so
that the kernel never unfolds it when comparing the subrings attached to different index sets. -/
irreducible_def locSub (C A : Finset R) : Subring R where
  carrier := {r | ∃ a ∈ gen C A, ∃ s ∈ gen C A, IsUnit s ∧ r * s = a}
  zero_mem' := ⟨0, zero_mem _, 1, one_mem _, isUnit_one, by simp⟩
  one_mem' := ⟨1, one_mem _, 1, one_mem _, isUnit_one, by simp⟩
  add_mem' := by
    rintro x y ⟨a, ha, s, hs, hsu, rfl⟩ ⟨b, hb, t, ht, htu, rfl⟩
    refine ⟨x * s * t + y * t * s, add_mem (mul_mem ha ht) (mul_mem hb hs), s * t,
      mul_mem hs ht, hsu.mul htu, by ring⟩
  mul_mem' := by
    rintro x y ⟨a, ha, s, hs, hsu, rfl⟩ ⟨b, hb, t, ht, htu, rfl⟩
    exact ⟨x * s * (y * t), mul_mem ha hb, s * t, mul_mem hs ht, hsu.mul htu, by ring⟩
  neg_mem' := by
    rintro x ⟨a, ha, s, hs, hsu, rfl⟩
    exact ⟨-(x * s), neg_mem ha, s, hs, hsu, by ring⟩

theorem mem_locSub {C A : Finset R} {r : R} :
    r ∈ locSub C A ↔ ∃ a ∈ gen C A, ∃ s ∈ gen C A, IsUnit s ∧ r * s = a := by
  rw [locSub_def]
  exact Iff.rfl

theorem gen_mono (C : Finset R) {A B : Finset R} (h : A ⊆ B) : gen C A ≤ gen C B :=
  Subring.closure_mono (Set.union_subset_union_right _ (Finset.coe_subset.2 h))

theorem gen_le_locSub (C A : Finset R) : gen C A ≤ locSub C A :=
  fun r hr ↦ mem_locSub.2 ⟨r, hr, 1, one_mem _, isUnit_one, mul_one r⟩

theorem locSub_mono (C : Finset R) {A B : Finset R} (h : A ⊆ B) : locSub C A ≤ locSub C B := by
  intro r hr
  obtain ⟨a, ha, s, hs, hsu, e⟩ := mem_locSub.1 hr
  exact mem_locSub.2 ⟨a, gen_mono C h ha, s, gen_mono C h hs, hsu, e⟩

theorem mem_locSub_of_mem_right (C : Finset R) {A : Finset R} {r : R} (hr : r ∈ A) :
    r ∈ locSub C A :=
  gen_le_locSub C A (Subring.subset_closure (Or.inr hr))

theorem mem_locSub_of_mem_left {C : Finset R} (A : Finset R) {r : R} (hr : r ∈ C) :
    r ∈ locSub C A :=
  gen_le_locSub C A (Subring.subset_closure (Or.inl hr))

/-- An element of `locSub C A` which is a unit of `R` is a unit of `locSub C A`. -/
instance isLocalHom_locSub_subtype (C A : Finset R) : IsLocalHom (locSub C A).subtype where
  map_nonunit := by
    rintro ⟨r, hr⟩ (hru : IsUnit r)
    obtain ⟨a, ha, s, hs, hsu, e⟩ := mem_locSub.1 hr
    obtain ⟨u, rfl⟩ := hru
    have hau : IsUnit a := e ▸ u.isUnit.mul hsu
    have hinv : (↑u⁻¹ : R) ∈ locSub C A :=
      mem_locSub.2 ⟨s, hs, a, ha, hau, by rw [← e, ← mul_assoc, Units.inv_mul, one_mul]⟩
    refine IsUnit.of_mul_eq_one ⟨_, hinv⟩ (Subtype.ext ?_)
    simp

instance isLocalRing_locSub [IsLocalRing R] (C A : Finset R) : IsLocalRing (locSub C A) :=
  (locSub C A).subtype.domain_isLocalRing

/-- The elements of `gen C A` which are units of `R`. -/
def unitsSubmonoid (C A : Finset R) : Submonoid (gen C A) :=
  (IsUnit.submonoid R).comap (gen C A).subtype

instance algebraGenLocSub (C A : Finset R) : Algebra (gen C A) (locSub C A) :=
  (Subring.inclusion (gen_le_locSub C A)).toAlgebra

theorem algebraMap_gen_locSub_coe (C A : Finset R) (x : gen C A) :
    ((algebraMap (gen C A) (locSub C A) x : locSub C A) : R) = x := rfl

instance isLocalization_locSub (C A : Finset R) :
    IsLocalization (unitsSubmonoid C A) (locSub C A) where
  map_units := by
    rintro ⟨⟨s, hs⟩, hsu⟩
    have hsu' : IsUnit s := hsu
    obtain ⟨u, hu⟩ := hsu'
    have hinv : (↑u⁻¹ : R) ∈ locSub C A :=
      mem_locSub.2 ⟨1, one_mem _, s, hs, hu ▸ u.isUnit, by rw [← hu]; simp⟩
    refine IsUnit.of_mul_eq_one ⟨_, hinv⟩ (Subtype.ext ?_)
    simp [algebraMap_gen_locSub_coe, ← hu]
  surj := by
    rintro ⟨r, hr⟩
    obtain ⟨a, ha, s, hs, hsu, e⟩ := mem_locSub.1 hr
    exact ⟨⟨⟨a, ha⟩, ⟨⟨s, hs⟩, hsu⟩⟩, Subtype.ext e⟩
  exists_of_eq := by
    intro x y h
    have h' : (x : R) = y := by
      simpa [algebraMap_gen_locSub_coe] using congrArg Subtype.val h
    exact ⟨1, by rw [Subtype.ext h']⟩

instance finiteType_gen (C A : Finset R) : Algebra.FiniteType ℤ (gen C A) :=
  have h : Algebra.FiniteType ℤ (Algebra.adjoin ℤ ((C : Set R) ∪ A)) :=
    Algebra.FiniteType.adjoin_of_finite (C.finite_toSet.union A.finite_toSet)
  h.equiv (Subring.closureEquivAdjoinInt ((C : Set R) ∪ A)).symm

instance essFiniteType_locSub (C A : Finset R) : Algebra.EssFiniteType ℤ (locSub C A) := by
  have : Algebra.EssFiniteType (gen C A) (locSub C A) :=
    Algebra.EssFiniteType.of_isLocalization _ (unitsSubmonoid C A)
  have : IsScalarTower ℤ (gen C A) (locSub C A) :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ by simp
  exact Algebra.EssFiniteType.comp ℤ (gen C A) (locSub C A)

end BaseRing


/-! ## A polynomial presentation recorded through its composite map -/

section Presentation

/-- A finite polynomial presentation of the `R`-algebra `S`, over a ring `R₀` identified with `R`
by `e`, recorded through the composite map `ρ` from the polynomial ring to `S`: `ρ` kills the
finitely many relations `F`, every element of `S` is a fraction of values of `ρ` with unit
denominator, and an element killed by `ρ` lies in the ideal generated by `F` after multiplication
by an element whose image is a unit. -/
structure Pres (R₀ R S : Type*) [CommRing R₀] [CommRing R] [CommRing S] [Algebra R S]
    (e : R₀ ≃+* R) where
  n : ℕ
  F : Finset (MvPolynomial (Fin n) R₀)
  ρ : MvPolynomial (Fin n) R₀ →+* S
  ρ_C : ∀ r, ρ (MvPolynomial.C r) = algebraMap R S (e r)
  ρ_F : ∀ f ∈ F, ρ f = 0
  surj : ∀ s, ∃ a t, IsUnit (ρ t) ∧ s * ρ t = ρ a
  ker : ∀ a, ρ a = 0 →
    ∃ t, IsUnit (ρ t) ∧ t * a ∈ Ideal.span (F : Set (MvPolynomial (Fin n) R₀))

/-- An essentially finitely presented algebra has a presentation in the sense of `Pres`. -/
theorem nonempty_pres {R₀ R S : Type*} [CommRing R₀] [CommRing R] [CommRing S] [Algebra R S]
    (e : R₀ ≃+* R) (h : EssFinitePresentation R S) : Nonempty (Pres R₀ R S e) := by
  classical
  obtain ⟨n, I, ⟨F₁, hF₁⟩, M, ⟨Φ⟩⟩ := h
  let E : MvPolynomial (Fin n) R₀ ≃+* MvPolynomial (Fin n) R := MvPolynomial.mapEquiv _ e
  let ρ₁ : MvPolynomial (Fin n) R →+* S :=
    Φ.toRingHom.comp ((algebraMap (MvPolynomial (Fin n) R ⧸ I) (Localization M)).comp
      (Ideal.Quotient.mk I))
  have hρ₁ : ∀ x, ρ₁ x = Φ (algebraMap _ (Localization M) (Ideal.Quotient.mk I x)) :=
    fun _ ↦ rfl
  have hunit : ∀ t, Ideal.Quotient.mk I t ∈ M → IsUnit (ρ₁ t) := fun t ht ↦ by
    rw [hρ₁]
    exact (IsLocalization.map_units (Localization M) ⟨_, ht⟩).map Φ
  have hE : ∀ x, E (E.symm x) = x := E.apply_symm_apply
  have hspan : Ideal.span ((F₁.image E.symm : Finset _) : Set (MvPolynomial (Fin n) R₀)) =
      I.comap E := by
    rw [Finset.coe_image, ← Ideal.map_span, ← hF₁, Ideal.map_symm]
  refine ⟨⟨n, F₁.image E.symm, ρ₁.comp E.toRingHom, ?_, ?_, ?_, ?_⟩⟩
  · intro r
    change Φ (algebraMap _ (Localization M)
      (Ideal.Quotient.mk I (MvPolynomial.map e.toRingHom (MvPolynomial.C r)))) = _
    rw [MvPolynomial.map_C, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
      ← IsScalarTower.algebraMap_apply, AlgEquiv.commutes]
    rfl
  · intro f hf
    obtain ⟨f₁, hf₁, rfl⟩ := Finset.mem_image.1 hf
    change ρ₁ (E (E.symm f₁)) = 0
    rw [hE, hρ₁, Ideal.Quotient.eq_zero_iff_mem.2 (hF₁ ▸ Ideal.subset_span hf₁), map_zero,
      map_zero]
  · intro s
    obtain ⟨⟨y, m⟩, hy⟩ := IsLocalization.mk'_surjective M (Φ.symm s)
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (m : MvPolynomial (Fin n) R ⧸ I)
    refine ⟨E.symm a, E.symm t, ?_, ?_⟩
    · change IsUnit (ρ₁ (E (E.symm t)))
      rw [hE]
      exact hunit t (ht ▸ m.2)
    · change s * ρ₁ (E (E.symm t)) = ρ₁ (E (E.symm a))
      rw [hE, hE, hρ₁, hρ₁, ht]
      simp only at hy
      rw [← Φ.apply_symm_apply s, ← hy, ← map_mul, IsLocalization.mk'_spec]
  · intro a ha
    change ρ₁ (E a) = 0 at ha
    rw [hρ₁, map_eq_zero_iff _ Φ.injective] at ha
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M (Localization M) _).1 ha
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (m : MvPolynomial (Fin n) R ⧸ I)
    refine ⟨E.symm t, ?_, ?_⟩
    · change IsUnit (ρ₁ (E (E.symm t)))
      rw [hE]
      exact hunit t (ht ▸ m.2)
    · rw [hspan, Ideal.mem_comap, map_mul, hE, ← Ideal.Quotient.eq_zero_iff_mem, map_mul, ht, hm]

end Presentation

/-! ## The approximating system attached to a presentation -/

noncomputable section System

open IsLocalRing

variable {R₀ R S : Type*} [CommRing R₀] [CommRing R] [CommRing S] [Algebra R S]
  {e : R₀ ≃+* R} (P : Pres R₀ R S e)

namespace Pres

/-- The finitely many coefficients of the relations. -/
def coeffSet : Finset R₀ := by
  classical exact P.F.biUnion MvPolynomial.coeffs

/-- The base ring indexed by a finite subset `i` of `R₀`. -/
abbrev B (i : Finset R₀) : Subring R₀ := locSub P.coeffSet i

/-- Polynomials over the base ring. -/
abbrev Poly (i : Finset R₀) : Type _ := MvPolynomial (Fin P.n) (P.B i)

/-- Mapping coefficients into `R₀`. -/
def toPoly (i : Finset R₀) : P.Poly i →+* MvPolynomial (Fin P.n) R₀ :=
  MvPolynomial.map (P.B i).subtype

theorem toPoly_injective (i : Finset R₀) : Function.Injective (P.toPoly i) :=
  MvPolynomial.map_injective _ Subtype.val_injective

theorem toPoly_C (i : Finset R₀) (b : P.B i) :
    P.toPoly i (MvPolynomial.C b) = MvPolynomial.C (b : R₀) :=
  MvPolynomial.map_C _ _

theorem toPoly_X (i : Finset R₀) (k : Fin P.n) :
    P.toPoly i (MvPolynomial.X k) = MvPolynomial.X k :=
  MvPolynomial.map_X _ _

/-- A polynomial over `R₀` whose coefficients lie in the base ring comes from the base ring. -/
theorem exists_toPoly_eq {i : Finset R₀} {f : MvPolynomial (Fin P.n) R₀}
    (h : ∀ c ∈ f.coeffs, c ∈ P.B i) : ∃ g, P.toPoly i g = f :=
  MvPolynomial.mem_range_map_iff_coeffs_subset.2 fun c hc ↦ ⟨⟨c, h c hc⟩, rfl⟩

/-- The coefficients of the relations lie in every base ring. -/
theorem mem_B_of_mem_F (i : Finset R₀) {f : MvPolynomial (Fin P.n) R₀} (hf : f ∈ P.F) :
    ∀ c ∈ f.coeffs, c ∈ P.B i := by
  classical
  intro c hc
  refine mem_locSub_of_mem_left i ?_
  unfold coeffSet
  convert Finset.mem_biUnion.2 ⟨f, hf, hc⟩

/-- The ideal of relations over the base ring. -/
def rel (i : Finset R₀) : Ideal (P.Poly i) := Ideal.span (P.toPoly i ⁻¹' (P.F : Set _))

theorem mem_rel_of_toPoly_mem {i : Finset R₀} {g : P.Poly i} (hg : P.toPoly i g ∈ P.F) :
    g ∈ P.rel i :=
  Ideal.subset_span (by rwa [Set.mem_preimage, Finset.mem_coe])

theorem rel_le_ker (i : Finset R₀) : P.rel i ≤ RingHom.ker (P.ρ.comp (P.toPoly i)) :=
  Ideal.span_le.2 fun g hg ↦ RingHom.mem_ker.2 (by
    rw [RingHom.comp_apply]
    exact P.ρ_F _ (by rwa [Set.mem_preimage, Finset.mem_coe] at hg))

/-- The finite type algebra over the base ring. -/
def A (i : Finset R₀) : Type _ := P.Poly i ⧸ P.rel i

instance (i : Finset R₀) : CommRing (P.A i) := inferInstanceAs (CommRing (P.Poly i ⧸ P.rel i))

instance (i : Finset R₀) : Algebra (P.B i) (P.A i) :=
  inferInstanceAs (Algebra (P.B i) (P.Poly i ⧸ P.rel i))

instance (i : Finset R₀) : Algebra.FiniteType (P.B i) (P.A i) :=
  inferInstanceAs (Algebra.FiniteType (P.B i) (P.Poly i ⧸ P.rel i))

/-- The quotient map onto the finite type algebra. -/
def mkA (i : Finset R₀) : P.Poly i →+* P.A i := Ideal.Quotient.mk (P.rel i)

theorem mkA_surjective (i : Finset R₀) : Function.Surjective (P.mkA i) :=
  Ideal.Quotient.mk_surjective

theorem mkA_eq_zero_iff {i : Finset R₀} {g : P.Poly i} : P.mkA i g = 0 ↔ g ∈ P.rel i :=
  Ideal.Quotient.eq_zero_iff_mem

theorem mkA_C (i : Finset R₀) (b : P.B i) :
    P.mkA i (MvPolynomial.C b) = algebraMap (P.B i) (P.A i) b := by
  rw [← MvPolynomial.algebraMap_eq]
  exact Ideal.Quotient.mk_algebraMap _ _ _

theorem A_hom_ext {i : Finset R₀} {T : Type*} [Semiring T] {f g : P.A i →+* T}
    (h : f.comp (P.mkA i) = g.comp (P.mkA i)) : f = g :=
  Ideal.Quotient.ringHom_ext h

/-- Maps out of the finite type algebra. -/
def liftA (i : Finset R₀) {T : Type*} [CommRing T] (f : P.Poly i →+* T)
    (hf : P.rel i ≤ RingHom.ker f) : P.A i →+* T :=
  Ideal.Quotient.lift _ f fun _ ha ↦ RingHom.mem_ker.1 (hf ha)

theorem liftA_mkA (i : Finset R₀) {T : Type*} [CommRing T] (f : P.Poly i →+* T)
    (hf : P.rel i ≤ RingHom.ker f) (g : P.Poly i) : P.liftA i f hf (P.mkA i g) = f g :=
  Ideal.Quotient.lift_mk _ _ _

/-- The map from the finite type algebra to `S`. -/
def ρA (i : Finset R₀) : P.A i →+* S := P.liftA i (P.ρ.comp (P.toPoly i)) (P.rel_le_ker i)

theorem ρA_mkA (i : Finset R₀) (g : P.Poly i) : P.ρA i (P.mkA i g) = P.ρ (P.toPoly i g) := by
  rw [ρA, liftA_mkA, RingHom.comp_apply]

/-- The inclusion of base rings. -/
def incl {i j : Finset R₀} (h : i ≤ j) : P.B i →+* P.B j :=
  Subring.inclusion (locSub_mono _ h)

@[simp] theorem coe_incl {i j : Finset R₀} (h : i ≤ j) (b : P.B i) : (P.incl h b : R₀) = b :=
  Subring.coe_inclusion _ b

theorem subtype_comp_incl {i j : Finset R₀} (h : i ≤ j) :
    (P.B j).subtype.comp (P.incl h) = (P.B i).subtype :=
  RingHom.ext fun b ↦ P.coe_incl h b

/-- The induced map of polynomial rings. -/
def polyMap {i j : Finset R₀} (h : i ≤ j) : P.Poly i →+* P.Poly j :=
  MvPolynomial.map (P.incl h)

theorem toPoly_polyMap {i j : Finset R₀} (h : i ≤ j) (g : P.Poly i) :
    P.toPoly j (P.polyMap h g) = P.toPoly i g := by
  rw [toPoly, polyMap, MvPolynomial.map_map, subtype_comp_incl]
  rfl

theorem rel_le_comap {i j : Finset R₀} (h : i ≤ j) :
    P.rel i ≤ (P.rel j).comap (P.polyMap h) :=
  Ideal.span_le.2 fun g hg ↦ Ideal.mem_comap.2 (P.mem_rel_of_toPoly_mem (by
    rw [toPoly_polyMap]
    rwa [Set.mem_preimage, Finset.mem_coe] at hg))

/-- The induced map of finite type algebras. -/
def AMap {i j : Finset R₀} (h : i ≤ j) : P.A i →+* P.A j :=
  P.liftA i ((P.mkA j).comp (P.polyMap h)) fun g hg ↦ RingHom.mem_ker.2 (by
    rw [RingHom.comp_apply, mkA_eq_zero_iff]
    exact P.rel_le_comap h hg)

theorem AMap_mkA {i j : Finset R₀} (h : i ≤ j) (g : P.Poly i) :
    P.AMap h (P.mkA i g) = P.mkA j (P.polyMap h g) := by
  rw [AMap, liftA_mkA, RingHom.comp_apply]

theorem ρA_AMap {i j : Finset R₀} (h : i ≤ j) (x : P.A i) :
    P.ρA j (P.AMap h x) = P.ρA i x := by
  obtain ⟨g, rfl⟩ := P.mkA_surjective i x
  rw [AMap_mkA, ρA_mkA, ρA_mkA, toPoly_polyMap]

@[simp] theorem incl_self {i : Finset R₀} (h : i ≤ i) (b : P.B i) : P.incl h b = b :=
  Subtype.ext rfl

@[simp] theorem incl_incl {i j k : Finset R₀} (hij : i ≤ j) (hjk : j ≤ k) (b : P.B i) :
    P.incl hjk (P.incl hij b) = P.incl (hij.trans hjk) b :=
  Subtype.ext rfl

theorem polyMap_C {i j : Finset R₀} (h : i ≤ j) (b : P.B i) :
    P.polyMap h (MvPolynomial.C b) = MvPolynomial.C (P.incl h b) :=
  MvPolynomial.map_C _ _

theorem polyMap_self {i : Finset R₀} (h : i ≤ i) (g : P.Poly i) : P.polyMap h g = g :=
  P.toPoly_injective i (P.toPoly_polyMap h g)

theorem polyMap_polyMap {i j k : Finset R₀} (hij : i ≤ j) (hjk : j ≤ k) (g : P.Poly i) :
    P.polyMap hjk (P.polyMap hij g) = P.polyMap (hij.trans hjk) g :=
  P.toPoly_injective k (by rw [toPoly_polyMap, toPoly_polyMap, toPoly_polyMap])

theorem AMap_self {i : Finset R₀} (h : i ≤ i) (x : P.A i) : P.AMap h x = x := by
  obtain ⟨g, rfl⟩ := P.mkA_surjective i x
  rw [AMap_mkA, polyMap_self]

theorem AMap_AMap {i j k : Finset R₀} (hij : i ≤ j) (hjk : j ≤ k) (x : P.A i) :
    P.AMap hjk (P.AMap hij x) = P.AMap (hij.trans hjk) x := by
  obtain ⟨g, rfl⟩ := P.mkA_surjective i x
  rw [AMap_mkA, AMap_mkA, AMap_mkA, polyMap_polyMap]

/-- A polynomial over `R₀` comes from the base ring of any index containing its coefficients. -/
theorem exists_toPoly_eq_of_subset {i : Finset R₀} {f : MvPolynomial (Fin P.n) R₀}
    (h : f.coeffs ⊆ i) : ∃ g, P.toPoly i g = f :=
  P.exists_toPoly_eq fun _ hc ↦ mem_locSub_of_mem_right _ (h hc)

/-- An element of the ideal generated by the relations comes from the ideal of relations over
some base ring. -/
theorem exists_rel_of_mem_span {p : MvPolynomial (Fin P.n) R₀}
    (hp : p ∈ Ideal.span (P.F : Set (MvPolynomial (Fin P.n) R₀))) :
    ∃ j p', p' ∈ P.rel j ∧ P.toPoly j p' = p := by
  classical
  induction hp using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨g, hg⟩ := P.exists_toPoly_eq (P.mem_B_of_mem_F ∅ (Finset.mem_coe.1 hf))
    exact ⟨∅, g, P.mem_rel_of_toPoly_mem (hg ▸ Finset.mem_coe.1 hf), hg⟩
  | zero => exact ⟨∅, 0, zero_mem _, map_zero _⟩
  | add x y _ _ hx hy =>
    obtain ⟨j₁, p₁, h₁, e₁⟩ := hx
    obtain ⟨j₂, p₂, h₂, e₂⟩ := hy
    refine ⟨j₁ ∪ j₂, P.polyMap Finset.subset_union_left p₁ +
      P.polyMap Finset.subset_union_right p₂,
      add_mem (P.rel_le_comap _ h₁) (P.rel_le_comap _ h₂), ?_⟩
    rw [map_add, toPoly_polyMap, toPoly_polyMap, e₁, e₂]
  | smul c x _ hx =>
    obtain ⟨j, p, h, e⟩ := hx
    obtain ⟨c', hc'⟩ := P.exists_toPoly_eq_of_subset (i := j ∪ c.coeffs) Finset.subset_union_right
    refine ⟨j ∪ c.coeffs, c' * P.polyMap Finset.subset_union_left p,
      Ideal.mul_mem_left _ _ (P.rel_le_comap _ h), ?_⟩
    rw [map_mul, toPoly_polyMap, hc', e, smul_eq_mul]

/-- The map from the base ring to `R`. -/
def baseι (i : Finset R₀) : P.B i →+* R := e.toRingHom.comp (P.B i).subtype

theorem baseι_apply (i : Finset R₀) (b : P.B i) : P.baseι i b = e b := rfl

theorem baseι_incl {i j : Finset R₀} (h : i ≤ j) (b : P.B i) :
    P.baseι j (P.incl h b) = P.baseι i b := rfl

instance isLocalHom_incl {i j : Finset R₀} (h : i ≤ j) : IsLocalHom (P.incl h) := by
  have : IsLocalHom ((P.B j).subtype.comp (P.incl h)) := by
    rw [subtype_comp_incl]
    infer_instance
  exact isLocalHom_of_comp _ (P.B j).subtype

instance isLocalHom_baseι (i : Finset R₀) : IsLocalHom (P.baseι i) where
  map_nonunit b hb := by
    have h : IsUnit ((P.B i).subtype b) := by
      simpa [baseι] using hb.map e.symm.toRingHom
    exact IsUnit.of_map _ b h

variable [IsLocalRing S]

/-- The inverse image of the maximal ideal of `S`. -/
def q (i : Finset R₀) : Ideal (P.A i) := (maximalIdeal S).comap (P.ρA i)

instance (i : Finset R₀) : (P.q i).IsPrime := Ideal.comap_isPrime _ _

theorem mem_primeCompl_iff {i : Finset R₀} {x : P.A i} :
    x ∈ (P.q i).primeCompl ↔ IsUnit (P.ρA i x) := by
  rw [Ideal.mem_primeCompl_iff, q, Ideal.mem_comap, notMem_maximalIdeal]

theorem q_eq_comap {i j : Finset R₀} (h : i ≤ j) : P.q i = (P.q j).comap (P.AMap h) := by
  ext x
  rw [q, Ideal.mem_comap, Ideal.mem_comap, q, Ideal.mem_comap, ρA_AMap]

/-- The local algebra: the finite type algebra localized at `q i`. -/
abbrev Sl (i : Finset R₀) : Type _ := Localization.AtPrime (P.q i)

/-- The map from the local algebra to `S`. -/
def algι (i : Finset R₀) : P.Sl i →+* S :=
  IsLocalization.lift (M := (P.q i).primeCompl) (g := P.ρA i) fun s ↦
    P.mem_primeCompl_iff.1 s.2

theorem algι_algebraMap (i : Finset R₀) (x : P.A i) :
    P.algι i (algebraMap (P.A i) (P.Sl i) x) = P.ρA i x :=
  IsLocalization.lift_eq _ _

/-- The transition map of local algebras. -/
def SlMap {i j : Finset R₀} (h : i ≤ j) : P.Sl i →+* P.Sl j :=
  Localization.localRingHom (P.q i) (P.q j) (P.AMap h) (P.q_eq_comap h)

theorem SlMap_algebraMap {i j : Finset R₀} (h : i ≤ j) (x : P.A i) :
    P.SlMap h (algebraMap (P.A i) (P.Sl i) x) = algebraMap (P.A j) (P.Sl j) (P.AMap h x) :=
  Localization.localRingHom_to_map _ _ _ _ _

theorem Sl_hom_ext {i : Finset R₀} {T : Type*} [CommRing T] {f g : P.Sl i →+* T}
    (hC : ∀ b, f (algebraMap (P.A i) (P.Sl i) (P.mkA i (MvPolynomial.C b))) =
      g (algebraMap (P.A i) (P.Sl i) (P.mkA i (MvPolynomial.C b))))
    (hX : ∀ k, f (algebraMap (P.A i) (P.Sl i) (P.mkA i (MvPolynomial.X k))) =
      g (algebraMap (P.A i) (P.Sl i) (P.mkA i (MvPolynomial.X k)))) : f = g := by
  have h : ((f.comp (algebraMap (P.A i) (P.Sl i))).comp (P.mkA i)) =
      ((g.comp (algebraMap (P.A i) (P.Sl i))).comp (P.mkA i)) :=
    MvPolynomial.ringHom_ext (fun b ↦ hC b) (fun k ↦ hX k)
  exact IsLocalization.ringHom_ext (P.q i).primeCompl (P.A_hom_ext h)


theorem SlMap_self {i : Finset R₀} (h : i ≤ i) (x : P.Sl i) : P.SlMap h x = x := by
  have e : P.SlMap h = RingHom.id _ := IsLocalization.ringHom_ext (P.q i).primeCompl
    (RingHom.ext fun a ↦ by
      rw [RingHom.comp_apply, SlMap_algebraMap, AMap_self, RingHom.comp_apply, RingHom.id_apply])
  rw [e, RingHom.id_apply]

theorem SlMap_SlMap {i j k : Finset R₀} (hij : i ≤ j) (hjk : j ≤ k) (x : P.Sl i) :
    P.SlMap hjk (P.SlMap hij x) = P.SlMap (hij.trans hjk) x := by
  have e : (P.SlMap hjk).comp (P.SlMap hij) = P.SlMap (hij.trans hjk) :=
    IsLocalization.ringHom_ext (P.q i).primeCompl (RingHom.ext fun a ↦ by
      rw [RingHom.comp_apply, RingHom.comp_apply, SlMap_algebraMap, SlMap_algebraMap, AMap_AMap,
        RingHom.comp_apply, SlMap_algebraMap])
  exact DFunLike.congr_fun e x

theorem algι_SlMap {i j : Finset R₀} (h : i ≤ j) (x : P.Sl i) :
    P.algι j (P.SlMap h x) = P.algι i x := by
  have e : (P.algι j).comp (P.SlMap h) = P.algι i :=
    IsLocalization.ringHom_ext (P.q i).primeCompl (RingHom.ext fun a ↦ by
      simp only [RingHom.comp_apply, SlMap_algebraMap, algι_algebraMap, ρA_AMap])
  exact DFunLike.congr_fun e x

theorem algι_mk'_spec (i : Finset R₀) (a : P.A i) (s : (P.q i).primeCompl) :
    P.ρA i a = P.ρA i s * P.algι i (IsLocalization.mk' (P.Sl i) a s) :=
  (IsLocalization.lift_mk'_spec ..).1 rfl

instance isLocalHom_algι (i : Finset R₀) : IsLocalHom (P.algι i) where
  map_nonunit x hx := by
    obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (P.q i).primeCompl x
    rw [IsLocalization.AtPrime.isUnit_mk'_iff, P.mem_primeCompl_iff, P.algι_mk'_spec i a s]
    exact (P.mem_primeCompl_iff.1 s.2).mul hx

theorem SlMap_algebraMap_base {i j : Finset R₀} (h : i ≤ j) (b : P.B i) :
    P.SlMap h (algebraMap (P.B i) (P.Sl i) b) = algebraMap (P.B j) (P.Sl j) (P.incl h b) := by
  rw [IsScalarTower.algebraMap_apply (P.B i) (P.A i) (P.Sl i), SlMap_algebraMap, ← mkA_C,
    AMap_mkA, polyMap_C, mkA_C, ← IsScalarTower.algebraMap_apply]

theorem algι_algebraMap_base (i : Finset R₀) (b : P.B i) :
    P.algι i (algebraMap (P.B i) (P.Sl i) b) = algebraMap R S (P.baseι i b) := by
  rw [IsScalarTower.algebraMap_apply (P.B i) (P.A i) (P.Sl i), algι_algebraMap, ← mkA_C, ρA_mkA,
    toPoly_C, P.ρ_C]
  rfl

instance isLocalHom_algebraMap [IsLocalHom (algebraMap R S)] (i : Finset R₀) :
    IsLocalHom (algebraMap (P.B i) (P.Sl i)) where
  map_nonunit b hb := by
    have h : IsUnit (algebraMap R S (P.baseι i b)) := by
      rw [← algι_algebraMap_base]
      exact hb.map _
    exact IsUnit.of_map (P.baseι i) b (IsUnit.of_map (algebraMap R S) _ h)

instance essFiniteType_Sl (i : Finset R₀) : Algebra.EssFiniteType (P.B i) (P.Sl i) := by
  have : Algebra.EssFiniteType (P.A i) (P.Sl i) :=
    Algebra.EssFiniteType.of_isLocalization _ (P.q i).primeCompl
  exact Algebra.EssFiniteType.comp (P.B i) (P.A i) (P.Sl i)

/-- The approximating system attached to a presentation. -/
def system [IsLocalRing R₀] [IsLocalRing R] [IsLocalHom (algebraMap R S)] :
    LocalAlgebraSystem (Finset R₀) R S where
  base i := P.B i
  alg i := P.Sl i
  baseCommRing i := inferInstanceAs (CommRing (P.B i))
  algCommRing i := inferInstanceAs (CommRing (P.Sl i))
  baseLocalRing i := inferInstanceAs (IsLocalRing (P.B i))
  algLocalRing i := inferInstanceAs (IsLocalRing (P.Sl i))
  componentAlgebra i := inferInstanceAs (Algebra (P.B i) (P.Sl i))
  structure_local i := P.isLocalHom_algebraMap i
  baseMap _ _ h := P.incl h
  algMap _ _ h := P.SlMap h
  base_directed := ⟨fun _ x ↦ P.incl_self _ x, fun _ _ _ hij hjk x ↦ P.incl_incl hij hjk x⟩
  alg_directed := ⟨fun _ x ↦ P.SlMap_self _ x, fun _ _ _ hij hjk x ↦ P.SlMap_SlMap hij hjk x⟩
  baseMap_local _ _ h := P.isLocalHom_incl h
  algMap_local _ _ _ := Localization.isLocalHom_localRingHom _ _ _ _
  map_comm _ _ h b := P.SlMap_algebraMap_base h b
  baseι := P.baseι
  algι := P.algι
  baseι_local := P.isLocalHom_baseι
  algι_local := P.isLocalHom_algι
  baseι_compat _ _ h b := P.baseι_incl h b
  algι_compat _ _ h x := P.algι_SlMap h x
  ι_comm := P.algι_algebraMap_base

/-- Every element of `S` comes from some local algebra. -/
theorem exists_algι_eq (y : S) : ∃ i x, P.algι i x = y := by
  classical
  obtain ⟨a, t, ht, hy⟩ := P.surj y
  obtain ⟨a', ha'⟩ := P.exists_toPoly_eq_of_subset (i := a.coeffs ∪ t.coeffs)
    Finset.subset_union_left
  obtain ⟨t', ht'⟩ := P.exists_toPoly_eq_of_subset (i := a.coeffs ∪ t.coeffs)
    Finset.subset_union_right
  have hts : P.mkA _ t' ∈ (P.q (a.coeffs ∪ t.coeffs)).primeCompl := by
    rw [mem_primeCompl_iff, ρA_mkA, ht']
    exact ht
  refine ⟨_, IsLocalization.mk' (P.Sl (a.coeffs ∪ t.coeffs)) (P.mkA _ a') ⟨_, hts⟩, ?_⟩
  have e := P.algι_mk'_spec _ (P.mkA _ a') ⟨_, hts⟩
  rw [ρA_mkA, ρA_mkA, ha', ht', ← hy, mul_comm] at e
  exact (ht.mul_left_cancel e).symm

/-- An element of a local algebra killed by the map to `S` dies at some later stage. -/
theorem exists_SlMap_eq_zero {i : Finset R₀} (x : P.Sl i) (hx : P.algι i x = 0) :
    ∃ k, ∃ h : i ≤ k, P.SlMap h x = 0 := by
  classical
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (P.q i).primeCompl x
  obtain ⟨g, rfl⟩ := P.mkA_surjective i a
  have hg : P.ρ (P.toPoly i g) = 0 := by
    rw [← ρA_mkA, P.algι_mk'_spec i, hx, mul_zero]
  obtain ⟨t, ht, hspan⟩ := P.ker _ hg
  obtain ⟨j, p, hp, hpe⟩ := P.exists_rel_of_mem_span hspan
  let k := i ∪ j ∪ t.coeffs
  have hik : i ≤ k := Finset.subset_union_left.trans Finset.subset_union_left
  have hjk : j ≤ k := Finset.subset_union_right.trans Finset.subset_union_left
  obtain ⟨t', ht'⟩ := P.exists_toPoly_eq_of_subset (i := k) Finset.subset_union_right
  have hrel : t' * P.polyMap hik g = P.polyMap hjk p :=
    P.toPoly_injective k (by rw [map_mul, toPoly_polyMap, toPoly_polyMap, ht', hpe])
  have hts : P.mkA k t' ∈ (P.q k).primeCompl := by
    rw [mem_primeCompl_iff, ρA_mkA, ht']
    exact ht
  refine ⟨k, hik, ?_⟩
  rw [IsLocalization.mk'_eq_mul_mk'_one, map_mul, SlMap_algebraMap, AMap_mkA,
    IsLocalization.map_eq_zero_iff (P.q k).primeCompl _ _ |>.2 ⟨⟨_, hts⟩, ?_⟩, zero_mul]
  rw [← map_mul, hrel, mkA_eq_zero_iff]
  exact P.rel_le_comap hjk hp

variable [IsLocalRing R₀] [IsLocalRing R] [IsLocalHom (algebraMap R S)]

theorem system_isColimit : P.system.IsColimit := by
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
  · refine Ring.DirectLimit.lift_injective _ _ _ fun i b b' hb ↦ Subtype.ext (e.injective hb)
  · intro r
    let b : P.system.base {e.symm r} := ⟨e.symm r, mem_locSub_of_mem_right _ (by simp)⟩
    exact ⟨Ring.DirectLimit.of _ _ _ b,
      (LocalAlgebraSystem.baseColimitMap_of _ _ b).trans (e.apply_symm_apply r)⟩
  · rw [injective_iff_map_eq_zero]
    intro z hz
    induction z using Ring.DirectLimit.induction_on with
    | ih i x =>
      rw [LocalAlgebraSystem.algebraColimitMap_of] at hz
      obtain ⟨k, h, hk⟩ := P.exists_SlMap_eq_zero x hz
      exact (Ring.DirectLimit.of_f (G := P.system.alg) (f := fun i j h ↦ P.system.algMap i j h)
        h x).symm.trans ((congrArg (Ring.DirectLimit.of P.system.alg
          (fun i j h ↦ P.system.algMap i j h) k) hk).trans (map_zero _))
  · intro y
    obtain ⟨i, x, rfl⟩ := P.exists_algι_eq y
    exact ⟨Ring.DirectLimit.of _ _ i x, LocalAlgebraSystem.algebraColimitMap_of _ _ _⟩

/-- The approximation property, given the prime localization clause. -/
theorem system_isApproximation
    (h4 : ∀ i j (h : i ≤ j), P.system.IsPrimeLocalization h) : P.system.IsApproximation :=
  ⟨P.system_isColimit, fun i ↦ essFiniteType_locSub _ i, fun i ↦ P.essFiniteType_Sl i, h4⟩

end Pres

end System

/-! ## Assembly over `ULift R` -/

section Assembly

/-- `ULift` of a local ring is local. -/
instance isLocalRing_ulift {R : Type uR} [CommRing R] [IsLocalRing R] :
    IsLocalRing (ULift.{uS} R) :=
  IsLocalRing.of_surjective' (ULift.ringEquiv.{uR, uS} (R := R)).symm.toRingHom
    (ULift.ringEquiv.{uR, uS} (R := R)).symm.surjective

/-- The existence statement, given the prime localization clause for the systems attached to
presentations over `ULift R`. -/
theorem exists_isApproximation (R : Type uR) (S : Type uS) [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
    (hS : EssFinitePresentation R S)
    (h4 : ∀ (P : Pres (ULift.{uS} R) R S ULift.ringEquiv) (i j : Finset (ULift.{uS} R))
      (h : i ≤ j), P.system.IsPrimeLocalization h) :
    ∃ (ι : Type (max uR uS)) (_ : Preorder ι) (_ : Nonempty ι)
      (_ : IsDirectedOrder ι)
      (D : LocalAlgebraSystem.{max uR uS, max uR uS, max uR uS, uR, uS} ι R S),
      D.IsApproximation := by
  obtain ⟨P⟩ := nonempty_pres (ULift.ringEquiv : ULift.{uS} R ≃+* R) hS
  exact ⟨Finset (ULift.{uS} R), inferInstance, ⟨∅⟩, inferInstance, P.system,
    P.system_isApproximation (h4 P)⟩

end Assembly

end LocalAlgebraApproximationExistence

