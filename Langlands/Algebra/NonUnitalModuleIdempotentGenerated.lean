import Langlands.Algebra.NonUnitalModuleCorner
import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# The actual idempotent-generated submodule and category

Renard (9 July 2026), I.3.2, printed p.19 / PDF25.
The arbitrary-ring construction is an internal generalization of the source.
-/

set_option autoImplicit false

namespace Langlands.Algebra.NonUnitalModuleIdempotentGenerated

open CategoryTheory
open NonUnitalModuleCorner (originalAction fixedPart)

universe uA uM uN uP

variable {A : Type uA} [NonUnitalRing A]
  {M : Type uM} {N : Type uN} {P : Type uP}
  [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
  [hM : NonUnitalModule A M] [hN : NonUnitalModule A N] [hP : NonUnitalModule A P]

/-- The actual original action values whose additive closure is `AeM`. -/
def actionValues (e : Idempotent A) (M : Type uM) [AddCommGroup M]
    [NonUnitalModule A M] : Set M :=
  {x | ∃ (a : A) (m : M), originalAction a (originalAction (e : A) m) = x}

theorem actionValues_eq (e : Idempotent A) :
    actionValues e M = {x | ∃ (a : A) (m : M), a • ((e : A) • m) = x} := rfl

/-- `AeM` is the additive closure of the displayed action values, with its original stability. -/
def aeM (e : Idempotent A) (M : Type uM) [AddCommGroup M]
    [NonUnitalModule A M] : NonUnitalSubmodule A M where
  toAddSubgroup := AddSubgroup.closure (actionValues e M)
  smul_mem' a {m} hm := by
    let S := AddSubgroup.closure (actionValues e M)
    have hs : actionValues e M ⊆ S.comap (originalAction a) := by
      rintro x ⟨b, n, rfl⟩
      change originalAction a (originalAction b (originalAction (e : A) n)) ∈ S
      rw [← NonUnitalModuleCorner.originalAction_mul]
      exact AddSubgroup.subset_closure ⟨a * b, n, rfl⟩
    exact ((AddSubgroup.closure_le _).mpr hs) hm

theorem aeM_toAddSubgroup (e : Idempotent A) :
    (aeM e M).toAddSubgroup = AddSubgroup.closure (actionValues e M) := rfl

theorem aeM_closure (e : Idempotent A) :
    (aeM e M).toAddSubgroup =
      AddSubgroup.closure {x | ∃ (a : A) (m : M), a • ((e : A) • m) = x} := rfl

theorem action_mem (e : Idempotent A) (a : A) (m : M) :
    originalAction a (originalAction (e : A) m) ∈ aeM e M :=
  AddSubgroup.subset_closure ⟨a, m, rfl⟩

theorem smul_mem (e : Idempotent A) (a : A) (m : M) :
    a • ((e : A) • m) ∈ aeM e M := action_mem e a m

theorem coordinate_mem (e : Idempotent A) (m : M) :
    e.leftActionCoordinate m ∈ aeM e M := by
  have h := action_mem e (e : A) m
  rw [← NonUnitalModuleCorner.originalAction_mul, e.property.eq] at h
  exact h

/-- The actual fixed subgroup lies in `AeM`, including in a nonunital ring. -/
theorem fixedPart_le (e : Idempotent A) :
    fixedPart e M ≤ (aeM e M).toAddSubgroup := by
  intro m hm
  have h : e.leftActionCoordinate m = m := hm
  change m ∈ aeM e M
  simpa only [h] using coordinate_mem e m

/-- The exact least-stable-subgroup characterization, in both directions. -/
theorem aeM_le_iff (e : Idempotent A) (S : NonUnitalSubmodule A M) :
    aeM e M ≤ S ↔ fixedPart e M ≤ S.toAddSubgroup := by
  constructor
  · intro h m hm
    exact h (fixedPart_le e hm)
  · intro h
    apply (AddSubgroup.closure_le _).mpr
    rintro x ⟨a, m, rfl⟩
    exact S.smul_mem' a (h (NonUnitalModuleCorner.coordinate_idempotent e m))

/-- The same universal property stated for any original-action-stable additive subgroup. -/
theorem aeM_le_stable_iff (e : Idempotent A) (S : AddSubgroup M)
    (hS : ∀ (a : A) (m : M), m ∈ S → originalAction a m ∈ S) :
    (aeM e M).toAddSubgroup ≤ S ↔ fixedPart e M ≤ S := by
  let T : NonUnitalSubmodule A M :=
    { toAddSubgroup := S
      smul_mem' a {m} hm := hS a m hm }
  exact aeM_le_iff e T

/-- A named choice of the inherited group on the actual subtype. -/
abbrev aeMAddCommGroup (e : Idempotent A) (M : Type uM) [AddCommGroup M]
    [NonUnitalModule A M] : AddCommGroup (aeM e M) := inferInstance

/-- A named choice of the inherited original action on the actual subtype. -/
abbrev aeMModule (e : Idempotent A) (M : Type uM) [AddCommGroup M]
    [NonUnitalModule A M] : NonUnitalModule A (aeM e M) := inferInstance

theorem aeMModule_smul (e : Idempotent A) (a : A) (x : aeM e M) :
    (aeMModule e M).toDistribSMul.toSMul.smul a x =
      ⟨originalAction a x.val, (aeM e M).smul_mem' a x.property⟩ := rfl

/-- The actual intertwining inclusion into the original module. -/
def submoduleInclusion (e : Idempotent A) : NonUnitalModuleHom A (aeM e M) M :=
  (aeM e M).subtype

@[simp] theorem submoduleInclusion_apply (e : Idempotent A) (x : aeM e M) :
    submoduleInclusion e x = x.val := rfl

theorem coe_submoduleInclusion (e : Idempotent A) :
    ⇑(submoduleInclusion (M := M) e) = fun x => x.val := rfl

/-- Every vector belongs to the actual submodule generated by the idempotent image. -/
def IsGeneratedByIdempotent (e : Idempotent A) (M : Type uM) [AddCommGroup M]
    [NonUnitalModule A M] : Prop := ∀ m : M, m ∈ aeM e M

theorem isGenerated_iff_eq_top (e : Idempotent A) :
    IsGeneratedByIdempotent e M ↔ (aeM e M).toAddSubgroup = ⊤ := by
  constructor
  · intro h
    exact le_antisymm le_top (fun m _ => h m)
  · intro h m
    change m ∈ (aeM e M).toAddSubgroup
    rw [h]
    trivial

theorem isGenerated_iff_coe_eq_univ (e : Idempotent A) :
    IsGeneratedByIdempotent e M ↔ (aeM e M : Set M) = Set.univ := by
  constructor
  · intro h
    exact Set.eq_univ_of_forall h
  · intro h m
    change m ∈ (aeM e M : Set M)
    rw [h]
    trivial

theorem isGenerated_iff_least (e : Idempotent A) :
    IsGeneratedByIdempotent e M ↔
      ∀ S : NonUnitalSubmodule A M, fixedPart e M ≤ S.toAddSubgroup →
        ∀ m : M, m ∈ S := by
  constructor
  · intro h S hS m
    exact (aeM_le_iff e S).mpr hS (h m)
  · intro h
    exact h (aeM e M) (fixedPart_le e)

theorem isGenerated_iff_stable (e : Idempotent A) :
    IsGeneratedByIdempotent e M ↔
      ∀ S : AddSubgroup M,
        (∀ (a : A) (m : M), m ∈ S → originalAction a m ∈ S) →
        fixedPart e M ≤ S → ∀ m : M, m ∈ S := by
  constructor
  · intro h S hS he m
    exact (aeM_le_stable_iff e S hS).mpr he (h m)
  · intro h m
    exact h (aeM e M).toAddSubgroup
      (fun a _ hm => (aeM e M).smul_mem' a hm) (fixedPart_le e) m

/-- Any action annihilating the chosen idempotent has zero generated subgroup. -/
theorem aeM_eq_bot_of_coordinate_zero (e : Idempotent A)
    (he : ∀ m : M, originalAction (e : A) m = 0) :
    (aeM e M).toAddSubgroup = ⊥ := by
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro x ⟨a, m, rfl⟩
    change originalAction a (originalAction (e : A) m) = 0
    rw [he, map_zero]
  · exact bot_le

theorem isGenerated_iff_zero_of_coordinate_zero (e : Idempotent A)
    (he : ∀ m : M, originalAction (e : A) m = 0) :
    IsGeneratedByIdempotent e M ↔ ∀ m : M, m = 0 := by
  unfold IsGeneratedByIdempotent
  change (∀ m : M, m ∈ (aeM e M).toAddSubgroup) ↔ _
  rw [aeM_eq_bot_of_coordinate_zero e he]
  rfl

theorem aeM_zero_idempotent :
    (aeM (⟨0, IsIdempotentElem.zero⟩ : Idempotent A) M).toAddSubgroup = ⊥ :=
  aeM_eq_bot_of_coordinate_zero _ NonUnitalModuleCorner.originalAction_zero

theorem isGenerated_zero_idempotent_iff :
    IsGeneratedByIdempotent (⟨0, IsIdempotentElem.zero⟩ : Idempotent A) M ↔
      ∀ m : M, m = 0 :=
  isGenerated_iff_zero_of_coordinate_zero _ NonUnitalModuleCorner.originalAction_zero

omit hM in
theorem aeM_zero_action (e : Idempotent A) :
    letI : NonUnitalModule A M := NonUnitalModule.zero
    (aeM e M).toAddSubgroup = ⊥ := by
  let : NonUnitalModule A M := NonUnitalModule.zero
  exact aeM_eq_bot_of_coordinate_zero e (fun _ => rfl)

omit hM in
theorem isGenerated_zero_action_iff (e : Idempotent A) :
    letI : NonUnitalModule A M := NonUnitalModule.zero
    IsGeneratedByIdempotent e M ↔ ∀ m : M, m = 0 := by
  let : NonUnitalModule A M := NonUnitalModule.zero
  exact isGenerated_iff_zero_of_coordinate_zero e (fun _ => rfl)

/-- An actual original intertwiner sends the generated subgroup into the target one. -/
theorem map_mem (e : Idempotent A) (f : NonUnitalModuleHom A M N)
    {m : M} (hm : m ∈ aeM e M) : f m ∈ aeM e N := by
  have hs : actionValues e M ⊆ (aeM e N).toAddSubgroup.comap f.toAddMonoidHom := by
    rintro x ⟨a, n, rfl⟩
    change f (a • ((e : A) • n)) ∈ aeM e N
    rw [f.map_smul, f.map_smul]
    exact smul_mem e a (f n)
  exact ((AddSubgroup.closure_le _).mpr hs) hm

/-- The actual restriction, with independent source and target universes. -/
def restrict (e : Idempotent A) (f : NonUnitalModuleHom A M N) :
    NonUnitalModuleHom A (aeM e M) (aeM e N) where
  toFun x := ⟨f x.val, map_mem e f x.property⟩
  map_zero' := Subtype.ext f.map_zero
  map_add' x y := Subtype.ext (f.map_add x.val y.val)
  map_smul' a x := Subtype.ext (f.map_smul a x.val)

@[simp] theorem restrict_apply (e : Idempotent A) (f : NonUnitalModuleHom A M N)
    (x : aeM e M) : (restrict e f x).val = f x.val := rfl

theorem coe_restrict (e : Idempotent A) (f : NonUnitalModuleHom A M N) :
    ⇑(restrict e f) = fun x => ⟨f x.val, map_mem e f x.property⟩ := rfl

@[simp] theorem restrict_id (e : Idempotent A) :
    restrict e (NonUnitalModuleHom.id A M) = NonUnitalModuleHom.id A (aeM e M) := by
  ext x
  rfl

@[simp] theorem restrict_comp (e : Idempotent A)
    (g : NonUnitalModuleHom A N P) (f : NonUnitalModuleHom A M N) :
    restrict e (g.comp f) = (restrict e g).comp (restrict e f) := by
  ext x
  rfl

@[simp] theorem restrict_zero (e : Idempotent A) :
    restrict e (0 : NonUnitalModuleHom A M N) = 0 := by
  ext x
  rfl

@[simp] theorem restrict_add (e : Idempotent A) (f g : NonUnitalModuleHom A M N) :
    restrict e (f + g) = restrict e f + restrict e g := by
  ext x
  rfl

@[simp] theorem restrict_neg (e : Idempotent A) (f : NonUnitalModuleHom A M N) :
    restrict e (-f) = -restrict e f := by
  ext x
  rfl

def restrictAddHom (e : Idempotent A) :
    NonUnitalModuleHom A M N →+ NonUnitalModuleHom A (aeM e M) (aeM e N) where
  toFun := restrict e
  map_zero' := restrict_zero e
  map_add' := restrict_add e

theorem coe_restrictAddHom (e : Idempotent A) :
    ⇑(restrictAddHom (M := M) (N := N) e) = restrict e := rfl

/-- Commutation with inclusion as equality of whole original intertwiners. -/
theorem submoduleInclusion_naturality (e : Idempotent A) (f : NonUnitalModuleHom A M N) :
    (submoduleInclusion e).comp (restrict e f) = f.comp (submoduleInclusion e) := by
  ext x
  rfl

/-- The actual generated-submodule functor; no nondegeneracy of its output is presumed. -/
def functor (e : Idempotent A) :
    NonUnitalModuleCat.{uA, uM} A ⥤ NonUnitalModuleCat.{uA, uM} A where
  obj M := NonUnitalModuleCat.of A (aeM e M)
  map f := restrict e f
  map_id _ := restrict_id e
  map_comp f g := restrict_comp e g f

@[simp] theorem functor_obj (e : Idempotent A) (M : NonUnitalModuleCat.{uA, uM} A) :
    (functor e).obj M = NonUnitalModuleCat.of A (aeM e M) := rfl

@[simp] theorem functor_map (e : Idempotent A)
    {M N : NonUnitalModuleCat.{uA, uM} A} (f : M ⟶ N) :
    (functor e).map f = restrict e f := rfl

@[simp] theorem functor_map_apply (e : Idempotent A)
    {M N : NonUnitalModuleCat.{uA, uM} A} (f : M ⟶ N) (x : aeM e M) :
    ((NonUnitalModuleHom.toAddMonoidHom ((functor e).map f)) x).val =
      (NonUnitalModuleHom.toAddMonoidHom f) x.val := rfl

instance functor_additive (e : Idempotent A) : (functor.{uA, uM} e).Additive where
  map_add := by
    intro M N f g
    exact restrict_add e f g

/-- The actual inclusions form a natural transformation to the identity functor. -/
def naturalInclusion (e : Idempotent A) :
    functor.{uA, uM} e ⟶ 𝟭 (NonUnitalModuleCat.{uA, uM} A) where
  app _ := submoduleInclusion e
  naturality _ _ f := (submoduleInclusion_naturality e f).symm

@[simp] theorem naturalInclusion_app (e : Idempotent A)
    (M : NonUnitalModuleCat.{uA, uM} A) :
    (naturalInclusion e).app M = submoduleInclusion e := rfl

/-- Generatedness is a property inside the already nondegenerate original category. -/
def generatedProperty (e : Idempotent A) :
    ObjectProperty (NondegenerateModuleCat.{uA, uM} A) :=
  fun M => IsGeneratedByIdempotent e M.obj

/-- Renard's full category `M(A,e)`, retaining the published original nondegeneracy condition. -/
abbrev GeneratedModuleCat (e : Idempotent A) :=
  (generatedProperty.{uA, uM} e).FullSubcategory

/-- The actual full and faithful additive inclusion into nondegenerate modules. -/
abbrev inclusion (e : Idempotent A) :
    GeneratedModuleCat.{uA, uM} e ⥤ NondegenerateModuleCat.{uA, uM} A :=
  (generatedProperty e).ι

theorem inclusion_full (e : Idempotent A) : (inclusion.{uA, uM} e).Full := inferInstance

theorem inclusion_faithful (e : Idempotent A) :
    (inclusion.{uA, uM} e).Faithful := inferInstance

theorem inclusion_additive (e : Idempotent A) :
    (inclusion.{uA, uM} e).Additive := inferInstance

@[simp] theorem inclusion_obj (e : Idempotent A) (M : GeneratedModuleCat.{uA, uM} e) :
    (inclusion e).obj M = M.obj := rfl

@[simp] theorem inclusion_map (e : Idempotent A)
    {M N : GeneratedModuleCat.{uA, uM} e} (f : M ⟶ N) :
    (inclusion e).map f = f.hom := rfl

theorem object_isNondegenerate (e : Idempotent A) (M : GeneratedModuleCat.{uA, uM} e) :
    IsNondegenerate A M.obj.obj := M.obj.property

theorem object_isGenerated (e : Idempotent A) (M : GeneratedModuleCat.{uA, uM} e) :
    IsGeneratedByIdempotent e M.obj.obj := M.property

/-- The published corner functor restricted along the actual generated-category inclusion. -/
def cornerFunctor (e : Idempotent A) :
    GeneratedModuleCat.{uA, uM} e ⥤ ModuleCat.{uM} (Idempotent.Corner e) :=
  inclusion e ⋙ NonUnitalModuleCorner.nondegenerateFunctor e

instance cornerFunctor_additive (e : Idempotent A) :
    (cornerFunctor.{uA, uM} e).Additive := by
  change (inclusion e ⋙ NonUnitalModuleCorner.nondegenerateFunctor.{uA, uM} e).Additive
  infer_instance

@[simp] theorem cornerFunctor_obj (e : Idempotent A)
    (M : GeneratedModuleCat.{uA, uM} e) :
    (cornerFunctor e).obj M =
      ModuleCat.of (Idempotent.Corner e) (NonUnitalModuleCorner.FixedPart e M.obj.obj) := rfl

@[simp] theorem cornerFunctor_map_hom (e : Idempotent A)
    {M N : GeneratedModuleCat.{uA, uM} e} (f : M ⟶ N) :
    ((cornerFunctor e).map f).hom = NonUnitalModuleCorner.restrict e f.hom.hom := rfl

@[simp] theorem cornerFunctor_map_apply (e : Idempotent A)
    {M N : GeneratedModuleCat.{uA, uM} e} (f : M ⟶ N)
    (x : NonUnitalModuleCorner.FixedPart e M.obj.obj) :
    (((cornerFunctor e).map f).hom x).val =
      (NonUnitalModuleHom.toAddMonoidHom f.hom.hom) x.val := rfl

end Langlands.Algebra.NonUnitalModuleIdempotentGenerated
