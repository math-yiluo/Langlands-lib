import Langlands.Algebra.NondegenerateModuleSubobject
import Langlands.Algebra.NondegenerateModuleExactnessConcrete
import Langlands.Algebra.NonUnitalModuleCornerInductionGenerated
import Langlands.Algebra.NonUnitalModuleCornerEvaluationProof

set_option autoImplicit false

noncomputable section

namespace Langlands.Algebra.NonUnitalModuleCornerSimpleProof

open CategoryTheory
open NonUnitalModuleCorner NonUnitalModuleCornerInduction
open NonUnitalModuleIdempotentGenerated NonUnitalModuleCornerSimpleStatements

attribute [local instance] rightCornerModule cornerModule tensorModule

universe uA uM

variable {A : Type uA} [NonUnitalRing A]

/-- Categorical simplicity gives the usual dichotomy for original stable subgroups. -/
theorem stable_dichotomy (hA : IsIdempotented A)
    (M : NondegenerateModuleCat.{uA, uM} A) [Simple M]
    (S : NonUnitalSubmodule A M.obj) :
    (∀ x : S, x.val = 0) ∨ ∀ m : M.obj, m ∈ S := by
  let :=  NondegenerateModuleCat.abelian.{uA, uM} A hA
  let f := NondegenerateModuleCat.subtypeHom M S
  by_cases hf : f = 0
  · exact Or.inl (fun x => congrArg (fun g => g.hom.toAddMonoidHom x) hf)
  · let : IsIso f := isIso_of_mono_of_nonzero hf
    have hs := (NondegenerateModuleExactnessConcrete.epi_iff hA f).1 inferInstance
    exact Or.inr (fun m => by
      obtain ⟨s, hs⟩ := hs m
      exact hs ▸ s.property)

/-- The original stable-subgroup dichotomy also implies categorical simplicity. -/
theorem simple_of_stable_dichotomy (hA : IsIdempotented A)
    (M : NondegenerateModuleCat.{uA, uM} A) [Nontrivial M.obj]
    (h : ∀ S : NonUnitalSubmodule A M.obj,
      (∀ x : S, x.val = 0) ∨ ∀ m : M.obj, m ∈ S) : Simple M := by
  let :=  NondegenerateModuleCat.abelian.{uA, uM} A hA
  constructor
  intro N f hf
  constructor
  · intro hi hz
    have hs := (NondegenerateModuleExactnessConcrete.epi_iff hA f).1 inferInstance
    obtain ⟨m, hm⟩ := exists_ne (0 : M.obj)
    obtain ⟨n, hn⟩ := hs m
    exact hm (hn.symm.trans (congrArg (fun g => g.hom.toAddMonoidHom n) hz))
  · intro hn
    rcases h (NonUnitalModuleHom.rangeSubmodule f.hom) with hz | hs
    · exact False.elim (hn (ObjectProperty.hom_ext _ (NonUnitalModuleHom.ext
        (fun n => hz ⟨f.hom.toAddMonoidHom n, ⟨n, rfl⟩⟩))))
    · have : Epi f := (NondegenerateModuleExactnessConcrete.epi_iff hA f).2 hs
      exact isIso_of_mono_of_epi f

/-- A nonzero fixed part supplies a fixed vector with nonzero ambient value. -/
theorem exists_fixed_ne_zero (e : Idempotent A) (M : Type uM)
    [AddCommGroup M] [NonUnitalModule A M] [Nontrivial (FixedPart e M)] :
    ∃ z : FixedPart e M, z.val ≠ 0 := by
  obtain ⟨z, hz⟩ := exists_ne (0 : FixedPart e M)
  exact ⟨z, fun h => hz (Subtype.ext h)⟩

section FixedGeneration

variable (e : Idempotent A) (M : Type uM)
  [AddCommGroup M] [NonUnitalModule A M]

/-- The stable additive subgroup generated by a corner submodule of the fixed part. -/
def fromFixed (P : Submodule (Idempotent.Corner e) (FixedPart e M)) :
    NonUnitalSubmodule A M where
  toAddSubgroup := AddSubgroup.closure {x | ∃ (a : A) (z : P), a • z.val.val = x}
  smul_mem' a := by
    intro m hm
    let S := AddSubgroup.closure {x : M | ∃ (b : A) (z : P), b • z.val.val = x}
    have hs : {x : M | ∃ (b : A) (z : P), b • z.val.val = x} ⊆
        S.comap (originalAction a) := by
      rintro x ⟨b, z, rfl⟩
      change a • (b • z.val.val) ∈ S
      rw [← mul_smul]
      exact AddSubgroup.subset_closure ⟨a * b, z, rfl⟩
    exact ((AddSubgroup.closure_le _).mpr hs) hm

theorem fixed_mem_fromFixed (P : Submodule (Idempotent.Corner e) (FixedPart e M))
    (z : P) : z.val.val ∈ fromFixed e M P := by
  exact AddSubgroup.subset_closure ⟨(e : A), z, z.val.property⟩

/-- Projecting the stable subgroup generated by `P` lands back in `P`. -/
theorem projection_mem_fromFixed (P : Submodule (Idempotent.Corner e) (FixedPart e M))
    {m : M} (hm : m ∈ fromFixed e M P) : projection e m ∈ P := by
  apply ((AddSubgroup.closure_le _).mpr
    (show {x : M | ∃ (a : A) (z : P), a • z.val.val = x} ⊆
      P.toAddSubgroup.comap (projection e) from ?_)) hm
  rintro x ⟨a, z, rfl⟩
  have hp := P.smul_mem (sandwichCorner e a) z.property
  change projection e (a • z.val.val) ∈ P
  have heq : projection e (a • z.val.val) = sandwichCorner e a • z.val := by
    apply Subtype.ext
    change (e : A) • (a • z.val.val) = ((e : A) * a * e) • z.val.val
    have hz : (e : A) • z.val.val = z.val.val := z.val.property
    rw [mul_smul, hz, mul_smul]
  rw [heq]
  exact hp

end FixedGeneration

/-- A nonzero fixed part of a simple original module is simple over the corner ring. -/
theorem simpleFixedPart : SimpleFixedPartStatement.{uA, uM} := by
  intro A _ hA e M _ _ hM hs hn
  let :=  hs
  let :=  hn
  apply (isSimpleModule_iff _ _).2
  refine { eq_bot_or_eq_top := ?_ }
  intro P
  rcases stable_dichotomy hA ⟨NonUnitalModuleCat.of A M, hM⟩ (fromFixed e M P) with hz | ht
  · left
    apply le_antisymm
    · intro z hzP
      exact Subtype.ext (hz ⟨z.val, fixed_mem_fromFixed e M P ⟨z, hzP⟩⟩)
    · exact bot_le
  · right
    apply top_unique
    intro z _
    have hp := projection_mem_fromFixed e M P (ht z.val)
    exact (Subtype.ext z.property : projection e z.val = z) ▸ hp

end Langlands.Algebra.NonUnitalModuleCornerSimpleProof
