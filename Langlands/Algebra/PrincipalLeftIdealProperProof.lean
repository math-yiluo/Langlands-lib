import Langlands.Algebra.SeparationStatements
import Mathlib.RingTheory.Ideal.Maximal

/-!
# Proper principal left ideals

The ring-theoretic auxiliary in Renard B.III (2026, printed273/PDF279):
`A x` is proper exactly when `x` has no left inverse.
-/

universe u

namespace Langlands.Renard

/-- The actual principal left ideal generated by `x` is proper exactly when
no element multiplied on the left of `x` gives `1`. -/
theorem principalLeftIdealProper (A : Type u) [Ring A] :
    PrincipalLeftIdealProperStatement A := by
  intro x
  change (¬ Submodule.span A ({x} : Set A) = ⊤) ↔ _
  rw [Ideal.eq_top_iff_one, Submodule.mem_span_singleton]
  simp only [smul_eq_mul, not_exists]

end Langlands.Renard
