import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.Basic.Complex.Basic

/-!
# Dimension bound for simple modules over a commutative sandwich algebra

Bernstein--Zelevinsky (1976), Lemma 4.10 and §4.11, page 39--40, in their
abstract algebraic form. This is a proposition definition, not a proof.
-/

namespace Langlands

universe uH uM

/-- Let `H` be a complex algebra containing elements `x 0, …, x (q-1)` and pairwise
commuting elements `a 0, …, a (l-1)` such that the products `x i * m * x j`, with
`m` in the subalgebra generated by the `a k`, span `H`. Then every simple
`H`-module that is finite-dimensional over `ℂ` has dimension at most `q ^ (2 ^ l)`. -/
def SandwichSimpleModuleDimensionBoundStatement : Prop :=
  ∀ (H : Type uH) [Ring H] [Algebra ℂ H] (q l : ℕ) (x : Fin q → H) (a : Fin l → H),
    (∀ i j, Commute (a i) (a j)) →
    Submodule.span ℂ
        {y : H | ∃ i j, ∃ m ∈ Algebra.adjoin ℂ (Set.range a), y = x i * m * x j} = ⊤ →
    ∀ (M : Type uM) [AddCommGroup M] [Module ℂ M] [Module H M] [IsScalarTower ℂ H M],
      IsSimpleModule H M → FiniteDimensional ℂ M → Module.finrank ℂ M ≤ q ^ (2 ^ l)

end Langlands
