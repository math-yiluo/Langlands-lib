import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.RingTheory.Adjoin.Basic

/-! # Fixed points of a weight-scaling automorphism of an enveloping algebra: statement

Let `L` be a Lie algebra over a field `k` with a finite basis `b` and an integer weight `d` on
the basis indices. This file defines the right ideal of `U(L)` generated by the basis vectors of
positive weight and the subalgebra generated by those of weight zero, and states that the
elements of `U(L)` fixed by the automorphism induced by a weight-scaling Lie algebra
automorphism lie in their sum, which is direct. -/

noncomputable section

universe u v

set_option autoImplicit false

namespace Langlands.Algebra.UniversalEnveloping

attribute [local instance 100] LieRing.ofAssociativeRing

section Spans

variable {k : Type u} [Field k] {L : Type v} [LieRing L] [LieAlgebra k L]
  {I : Type*} (b : I → L) (d : I → ℤ)

/-- The span of the products `ι(b a) · v` with `d a > 0` and `v` in `U(L)`: the right ideal of
the enveloping algebra generated by the generators of positive weight. -/
def positiveWeightGeneratorSpan : Submodule k (UniversalEnvelopingAlgebra k L) :=
  Submodule.span k
    {u | ∃ a, 0 < d a ∧ ∃ v : UniversalEnvelopingAlgebra k L,
      u = UniversalEnvelopingAlgebra.ι k (b a) * v}

/-- The subalgebra of the enveloping algebra generated by the generators `ι(b a)` with
`d a = 0`. -/
def zeroWeightGeneratorSubalgebra : Subalgebra k (UniversalEnvelopingAlgebra k L) :=
  Algebra.adjoin k {u | ∃ a, d a = 0 ∧ u = UniversalEnvelopingAlgebra.ι k (b a)}

end Spans

/-- Fixed points of a weight-scaling automorphism of an enveloping algebra. Let `b` be a basis of
a Lie algebra `L` over a field `k`, indexed by `Fin n`, let `d` be an integer weight on the
indices and let `c` be a unit of `k` that is not a root of unity. Let `T` be a Lie algebra
endomorphism of `L` with `T (b a) = c ^ d a • b a` for every `a`, and let `T̃` be the induced
algebra endomorphism of `U(L)`. Then every `z` in `U(L)` with `T̃ z = z` lies in the sum of the
right ideal generated by the `ι(b a)` with `d a > 0` and the subalgebra generated by the `ι(b a)`
with `d a = 0`, and these two subspaces meet only in `0`. -/
def EnvelopingFixedWeightDecompositionStatement : Prop :=
  ∀ (k : Type u) [Field k] (L : Type v) [LieRing L] [LieAlgebra k L] (n : ℕ)
    (b : Module.Basis (Fin n) k L) (d : Fin n → ℤ) (c : kˣ),
    (∀ m : ℤ, c ^ m = 1 → m = 0) →
    ∀ T : L →ₗ⁅k⁆ L, (∀ a, T (b a) = ((c ^ d a : kˣ) : k) • b a) →
      (∀ z : UniversalEnvelopingAlgebra k L,
        UniversalEnvelopingAlgebra.lift k ((UniversalEnvelopingAlgebra.ι k).comp T) z = z →
          z ∈ positiveWeightGeneratorSpan (k := k) b d ⊔
            (zeroWeightGeneratorSubalgebra (k := k) b d).toSubmodule) ∧
      Disjoint (positiveWeightGeneratorSpan (k := k) b d)
        (zeroWeightGeneratorSubalgebra (k := k) b d).toSubmodule

end Langlands.Algebra.UniversalEnveloping
