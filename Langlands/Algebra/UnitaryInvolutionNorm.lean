import Langlands.Algebra.UnitaryInvolutionStatements
import Langlands.Algebra.DivisionNormValuation
import Langlands.Algebra.LocalDivisionUnramifiedSubfield
import Mathlib.RingTheory.Norm.Basic

/-!
# Unitary involutions preserve the regular norm up to the scalar automorphism
-/

noncomputable section

universe u

namespace Langlands.UnitaryInvolution

open Polynomial

section Algebraic

variable {L D : Type u} [Field L] [DivisionRing D] [Algebra L D]
  {σ : L →+* L} {τ : D → D}

/-- The additive map underlying a unitary involution. -/
def addHom (hτ : IsUnitaryInvolution (⇑σ) τ) : D →+ D :=
  AddMonoidHom.mk' τ hτ.1

@[simp] theorem addHom_apply (hτ : IsUnitaryInvolution (⇑σ) τ) (x : D) :
    addHom hτ x = τ x := rfl

variable (hτ : IsUnitaryInvolution (⇑σ) τ)
include hτ

theorem tau_zero : τ 0 = 0 := (addHom hτ).map_zero

theorem tau_neg (x : D) : τ (-x) = -τ x := (addHom hτ).map_neg x

theorem tau_sub (x y : D) : τ (x - y) = τ x - τ y := (addHom hτ).map_sub x y

theorem tau_mul (x y : D) : τ (x * y) = τ y * τ x := hτ.2.1 x y

theorem tau_tau (x : D) : τ (τ x) = x := hτ.2.2.1 x

theorem tau_algebraMap (c : L) : τ (algebraMap L D c) = algebraMap L D (σ c) := hτ.2.2.2 c

theorem tau_one : τ 1 = 1 := by
  simpa using tau_algebraMap hτ 1

theorem tau_pow (x : D) (n : ℕ) : τ (x ^ n) = τ x ^ n := by
  induction n with
  | zero => simpa using tau_one hτ
  | succ n ih => rw [pow_succ, tau_mul hτ, ih, pow_succ']

theorem tau_smul (c : L) (x : D) : τ (c • x) = σ c • τ x := by
  rw [Algebra.smul_def, tau_mul hτ, tau_algebraMap hτ, Algebra.smul_def,
    Algebra.commutes]

theorem sigma_invol (c : L) : σ (σ c) = c := by
  apply (algebraMap L D).injective
  rw [← tau_algebraMap hτ (σ c), ← tau_algebraMap hτ c, tau_tau hτ]

theorem injective : Function.Injective τ := by
  intro x y h
  rw [← tau_tau hτ x, h, tau_tau hτ]

theorem tau_inv (x : D) : τ x⁻¹ = (τ x)⁻¹ := by
  by_cases hx : x = 0
  · simp [hx, tau_zero hτ]
  · have h : τ x⁻¹ * τ x = 1 := by
      rw [← tau_mul hτ, mul_inv_cancel₀ hx, tau_one hτ]
    exact eq_inv_of_mul_eq_one_left h

/-- The image of a unit under the involution, as a unit. -/
def tauUnit (j : Dˣ) : Dˣ :=
  Units.mk0 (τ j) (fun h => j.ne_zero (injective hτ (h.trans (tau_zero hτ).symm)))

@[simp] theorem tauUnit_coe (j : Dˣ) : ((tauUnit hτ j : Dˣ) : D) = τ j := rfl

theorem tau_aeval (x : D) (p : L[X]) :
    τ (aeval x p) = aeval (τ x) (p.map σ) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add, Polynomial.map_add, map_add, hτ.1, hp, hq]
  | monomial n c =>
    rw [aeval_monomial, Polynomial.map_monomial, aeval_monomial, tau_mul hτ,
      tau_pow hτ, tau_algebraMap hτ, Algebra.commutes]

variable [FiniteDimensional L D]

theorem minpoly_eq (x : D) : minpoly L (τ x) = (minpoly L x).map σ := by
  have hint : ∀ y : D, IsIntegral L y := fun y => Algebra.IsIntegral.isIntegral y
  have h1 : minpoly L (τ x) ∣ (minpoly L x).map σ := by
    apply minpoly.dvd
    rw [← tau_aeval hτ, minpoly.aeval, tau_zero hτ]
  have h2 : minpoly L x ∣ (minpoly L (τ x)).map σ := by
    apply minpoly.dvd
    have h := tau_aeval hτ (τ x) (minpoly L (τ x))
    rw [minpoly.aeval, tau_zero hτ, tau_tau hτ] at h
    exact h.symm
  have hd1 := natDegree_le_of_dvd h1 ((minpoly.monic (hint x)).map σ).ne_zero
  have hd2 := natDegree_le_of_dvd h2 ((minpoly.monic (hint (τ x))).map σ).ne_zero
  rw [natDegree_map] at hd1 hd2
  exact (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic (hint (τ x)))
    ((minpoly.monic (hint x)).map σ) h1 (by rw [natDegree_map]; exact hd2)).symm

end Algebraic

section Norm

open Langlands.CentralDivision

variable (L : Type u) {D : Type u} [Field L] [DivisionRing D] [Algebra L D]
  {σ : L →+* L} {τ : D → D}
variable [FiniteDimensional L D]

/-- The dimension of `D` over the subalgebra generated by `x`, with `D` a module through
left multiplication. -/
def adjoinRank (x : D) : ℕ :=
  Module.finrank (residueGeneratorSubalgebra L D x) D

theorem finrank_eq_natDegree_mul_adjoinRank (x : D) :
    Module.finrank L D = (minpoly L x).natDegree * adjoinRank L x := by
  let := residueGeneratorField L D x
  let E := residueGeneratorSubalgebra L D x
  have : FiniteDimensional E D := Module.Finite.of_restrictScalars_finite L E D
  rw [← residueGeneratorSubalgebra_finrank L D x, ← Module.finrank_mul_finrank L E D]
  rfl

theorem norm_eq_minpoly_coeff (x : D) :
    Algebra.norm L x =
      ((-1) ^ (minpoly L x).natDegree * (minpoly L x).coeff 0) ^ adjoinRank L x := by
  let := residueGeneratorField L D x
  let E := residueGeneratorSubalgebra L D x
  let pb := residueGeneratorPowerBasis L D x
  have : FiniteDimensional E D := Module.Finite.of_restrictScalars_finite L E D
  have hm : (pb.gen • (LinearMap.id : D →ₗ[E] D)).restrictScalars L =
      Algebra.lmul L D x := by
    ext y
    rfl
  rw [Algebra.norm_apply, ← hm, LinearMap.det_restrictScalars, LinearMap.det_smul,
    LinearMap.det_id, mul_one, map_pow, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly,
    ← pb.finrank, residueGeneratorSubalgebra_finrank L D x,
    ← minpoly.algHom_eq E.val Subtype.val_injective pb.gen]
  rfl

variable {L}
variable (hτ : IsUnitaryInvolution (⇑σ) τ)
include hτ

theorem natDegree_minpoly_tau (x : D) :
    (minpoly L (τ x)).natDegree = (minpoly L x).natDegree := by
  rw [minpoly_eq hτ, natDegree_map]

theorem adjoinRank_tau (x : D) : adjoinRank L (τ x) = adjoinRank L x := by
  have h1 := finrank_eq_natDegree_mul_adjoinRank L (τ x)
  have h2 := finrank_eq_natDegree_mul_adjoinRank L x
  rw [natDegree_minpoly_tau hτ] at h1
  have hpos : 0 < (minpoly L x).natDegree :=
    minpoly.natDegree_pos (Algebra.IsIntegral.isIntegral x)
  exact Nat.eq_of_mul_eq_mul_left hpos (h1.symm.trans h2)

/-- A unitary involution transforms the regular norm by the scalar automorphism. -/
theorem norm_tau (x : D) : Algebra.norm L (τ x) = σ (Algebra.norm L x) := by
  rw [norm_eq_minpoly_coeff, norm_eq_minpoly_coeff, adjoinRank_tau hτ,
    natDegree_minpoly_tau hτ, minpoly_eq hτ, coeff_map]
  simp [map_pow, map_mul, map_neg, map_one]

end Norm

end Langlands.UnitaryInvolution
