import Langlands.Algebra.NonUnitalModule
import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Balanced tensors of original nonunital modules

The actual balancing quotient of the integer tensor product. This supplies
the additive tensor used in Renard (9 July 2026), I.2.1-I.2.2.
-/

set_option autoImplicit false

namespace Langlands.Algebra.NonUnitalModuleTensor

open scoped TensorProduct
open MulOpposite

universe uA uX uY uZ uX' uY' uX'' uY''

variable (A : Type uA) (X : Type uX) (Y : Type uY)
  [NonUnitalRing A] [AddCommGroup X] [AddCommGroup Y]
  [NonUnitalModule Aᵐᵒᵖ X] [NonUnitalModule A Y]

/-- The actual integer submodule generated by the original balancing differences. -/
def relations : Submodule ℤ (X ⊗[ℤ] Y) :=
  Submodule.span ℤ (Set.range (fun p : A × X × Y =>
    (op p.1 • p.2.1) ⊗ₜ[ℤ] p.2.2 - p.2.1 ⊗ₜ[ℤ] (p.1 • p.2.2)))

/-- The original relative tensor, as the actual quotient of the integer tensor. -/
def Tensor : Type (max uX uY) := (X ⊗[ℤ] Y) ⧸ relations A X Y

instance addCommGroup : AddCommGroup (Tensor A X Y) :=
  inferInstanceAs (AddCommGroup ((X ⊗[ℤ] Y) ⧸ relations A X Y))

/-- The entire quotient map from the original integer tensor. -/
def projection : (X ⊗[ℤ] Y) →+ Tensor A X Y :=
  (relations A X Y).mkQ.toAddMonoidHom

theorem projection_function :
    (projection A X Y : (X ⊗[ℤ] Y) → Tensor A X Y) = Submodule.Quotient.mk := rfl

theorem projection_surjective : Function.Surjective (projection A X Y) :=
  Submodule.Quotient.mk_surjective _

/-- The pure tensor with its actual quotient value. -/
def tmul (x : X) (y : Y) : Tensor A X Y := projection A X Y (x ⊗ₜ[ℤ] y)

theorem tmul_function : tmul A X Y =
    fun x y => projection A X Y (x ⊗ₜ[ℤ] y) := rfl

@[simp] theorem zero_tmul (y : Y) : tmul A X Y 0 y = 0 := by
  rw [tmul, TensorProduct.zero_tmul, map_zero]

@[simp] theorem tmul_zero (x : X) : tmul A X Y x 0 = 0 := by
  rw [tmul, TensorProduct.tmul_zero, map_zero]

theorem add_tmul (x x' : X) (y : Y) :
    tmul A X Y (x + x') y = tmul A X Y x y + tmul A X Y x' y := by
  rw [tmul, TensorProduct.add_tmul, map_add]
  rfl

theorem tmul_add (x : X) (y y' : Y) :
    tmul A X Y x (y + y') = tmul A X Y x y + tmul A X Y x y' := by
  rw [tmul, TensorProduct.tmul_add, map_add]
  rfl

/-- The canonical map is biadditive on the original groups. -/
def biadditive : X →+ Y →+ Tensor A X Y where
  toFun x :=
    { toFun := tmul A X Y x
      map_zero' := tmul_zero A X Y x
      map_add' := tmul_add A X Y x }
  map_zero' := AddMonoidHom.ext (zero_tmul A X Y)
  map_add' x x' := AddMonoidHom.ext (add_tmul A X Y x x')

@[simp] theorem biadditive_apply (x : X) (y : Y) :
    biadditive A X Y x y = tmul A X Y x y := rfl

theorem biadditive_function :
    (fun x y => biadditive A X Y x y) = tmul A X Y := rfl

/-- The original right and left actions are balanced in the actual quotient. -/
theorem tmul_balanced (a : A) (x : X) (y : Y) :
    tmul A X Y (op a • x) y = tmul A X Y x (a • y) := by
  apply sub_eq_zero.mp
  change projection A X Y ((op a • x) ⊗ₜ[ℤ] y) -
    projection A X Y (x ⊗ₜ[ℤ] (a • y)) = 0
  rw [← map_sub]
  exact (Submodule.Quotient.mk_eq_zero _).mpr
    (Submodule.subset_span ⟨(a, x, y), rfl⟩)

variable {X Y}
variable {Z : Type uZ} [AddCommGroup Z]

/-- Exact balancing for a biadditive map on the retained original actions. -/
def IsBalanced (b : X →+ Y →+ Z) : Prop :=
  ∀ (a : A) (x : X) (y : Y), b (op a • x) y = b x (a • y)

/-- The actual additive subgroup of balanced biadditive maps. -/
def balancedMaps : AddSubgroup (X →+ Y →+ Z) where
  carrier := {b | IsBalanced A b}
  zero_mem' _ _ _ := rfl
  add_mem' {b c} hb hc a x y := by
    change b (op a • x) y + c (op a • x) y = b x (a • y) + c x (a • y)
    rw [hb a x y, hc a x y]
  neg_mem' {b} hb a x y := by
    change -b (op a • x) y = -b x (a • y)
    rw [hb a x y]

/-- Every biadditive map has the canonical lift to the original integer tensor. -/
def integerLift (b : X →+ Y →+ Z) : (X ⊗[ℤ] Y) →+ Z :=
  TensorProduct.liftAddHom b (fun n x y => by
    rw [map_zsmul, AddMonoidHom.zsmul_apply, map_zsmul])

@[simp] theorem integerLift_tmul (b : X →+ Y →+ Z) (x : X) (y : Y) :
    integerLift b (x ⊗ₜ[ℤ] y) = b x y := rfl

theorem relations_le_ker (b : X →+ Y →+ Z) (hb : IsBalanced A b) :
    relations A X Y ≤ LinearMap.ker (integerLift b).toIntLinearMap := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨a, x, y⟩, rfl⟩
  change integerLift b ((op a • x) ⊗ₜ[ℤ] y - x ⊗ₜ[ℤ] (a • y)) = 0
  rw [map_sub, integerLift_tmul, integerLift_tmul, hb a x y, sub_self]

/-- The intrinsic additive lift, descending the integer lift through the actual relations. -/
def lift (b : X →+ Y →+ Z) (hb : IsBalanced A b) : Tensor A X Y →+ Z :=
  ((relations A X Y).liftQ (integerLift b).toIntLinearMap (relations_le_ker A b hb)).toAddMonoidHom

@[simp] theorem lift_tmul (b : X →+ Y →+ Z) (hb : IsBalanced A b) (x : X) (y : Y) :
    lift A b hb (tmul A X Y x y) = b x y := rfl

/-- Factorization as an equality of complete additive maps. -/
theorem lift_comp_projection (b : X →+ Y →+ Z) (hb : IsBalanced A b) :
    (lift A b hb).comp (projection A X Y) = integerLift b := rfl

theorem lift_pure_function (b : X →+ Y →+ Z) (hb : IsBalanced A b) :
    (fun x y => lift A b hb (tmul A X Y x y)) = fun x y => b x y := rfl

/-- Additive maps out of the actual quotient are determined by all pure-tensor values. -/
theorem hom_ext {f g : Tensor A X Y →+ Z}
    (h : ∀ (x : X) (y : Y), f (tmul A X Y x y) = g (tmul A X Y x y)) : f = g := by
  apply AddMonoidHom.ext
  intro t
  obtain ⟨q, rfl⟩ := projection_surjective A X Y t
  have hq :
      (f.comp (projection A X Y)).toIntLinearMap =
        (g.comp (projection A X Y)).toIntLinearMap :=
    TensorProduct.ext' h
  exact LinearMap.congr_fun hq q

theorem lift_unique (b : X →+ Y →+ Z) (hb : IsBalanced A b)
    (f : Tensor A X Y →+ Z) (hf : ∀ x y, f (tmul A X Y x y) = b x y) :
    f = lift A b hb :=
  hom_ext A (fun x y => (hf x y).trans (lift_tmul A b hb x y).symm)

/-- Restriction to pure tensors as an actual element of the balanced-map subgroup. -/
def restrict (f : Tensor A X Y →+ Z) : balancedMaps A (X := X) (Y := Y) (Z := Z) :=
  ⟨{ toFun x := f.comp (biadditive A X Y x)
     map_zero' := by ext y; simp
     map_add' x x' := by ext y; simp },
    fun a x y => congrArg f (tmul_balanced A X Y a x y)⟩

@[simp] theorem restrict_apply (f : Tensor A X Y →+ Z) (x : X) (y : Y) :
    (restrict A f).val x y = f (tmul A X Y x y) := rfl

/-- The proved universal property as an actual additive equivalence. -/
def universalEquiv : (Tensor A X Y →+ Z) ≃+ balancedMaps A (X := X) (Y := Y) (Z := Z) where
  toFun := restrict A
  invFun b := lift A b.val b.property
  left_inv f := hom_ext A (fun _ _ => rfl)
  right_inv b := by apply Subtype.ext; ext x y; rfl
  map_add' _ _ := by apply Subtype.ext; ext x y; rfl

theorem universalEquiv_function :
    (fun (f : Tensor A X Y →+ Z) (x : X) (y : Y) => (universalEquiv A f).val x y) =
      fun f x y => f (tmul A X Y x y) := rfl

theorem universalEquiv_symm_pure_function :
    (fun (b : balancedMaps A (X := X) (Y := Y) (Z := Z)) (x : X) (y : Y) =>
      (universalEquiv A).symm b (tmul A X Y x y)) =
      fun b x y => b.val x y := rfl

theorem universalEquiv_symm_function :
    (fun b : balancedMaps A (X := X) (Y := Y) (Z := Z) =>
      ((universalEquiv A).symm b : Tensor A X Y → Z)) =
      fun b => (lift A b.val b.property : Tensor A X Y → Z) := rfl

theorem universalEquiv_left_inv (f : Tensor A X Y →+ Z) :
    (universalEquiv A).symm (universalEquiv A f) = f :=
  (universalEquiv A).symm_apply_apply f

theorem universalEquiv_right_inv (b : balancedMaps A (X := X) (Y := Y) (Z := Z)) :
    universalEquiv A ((universalEquiv A).symm b) = b :=
  (universalEquiv A).apply_symm_apply b

theorem universalEquiv_symm_comp_projection
    (b : balancedMaps A (X := X) (Y := Y) (Z := Z)) :
    ((universalEquiv A).symm b).comp (projection A X Y) = integerLift b.val := rfl

section Maps

variable {X' : Type uX'} {Y' : Type uY'} {X'' : Type uX''} {Y'' : Type uY''}
  [AddCommGroup X'] [AddCommGroup Y'] [AddCommGroup X''] [AddCommGroup Y'']
  [NonUnitalModule Aᵐᵒᵖ X'] [NonUnitalModule A Y']
  [NonUnitalModule Aᵐᵒᵖ X''] [NonUnitalModule A Y'']

/-- The actual biadditive map obtained from original right and left intertwiners. -/
def mapBiadditive (f : NonUnitalModuleHom Aᵐᵒᵖ X X') (g : NonUnitalModuleHom A Y Y') :
    X →+ Y →+ Tensor A X' Y' where
  toFun x := (biadditive A X' Y' (f x)).comp g.toAddMonoidHom
  map_zero' := by ext y; simp
  map_add' x x' := by ext y; simp

theorem mapBiadditive_balanced
    (f : NonUnitalModuleHom Aᵐᵒᵖ X X') (g : NonUnitalModuleHom A Y Y') :
    IsBalanced A (mapBiadditive A f g) := by
  intro a x y
  change tmul A X' Y' (f (op a • x)) (g y) = tmul A X' Y' (f x) (g (a • y))
  rw [f.map_smul, g.map_smul, tmul_balanced]

/-- The tensor map on the actual quotients, induced by the original intertwiners. -/
def map (f : NonUnitalModuleHom Aᵐᵒᵖ X X') (g : NonUnitalModuleHom A Y Y') :
    Tensor A X Y →+ Tensor A X' Y' :=
  lift A (mapBiadditive A f g) (mapBiadditive_balanced A f g)

@[simp] theorem map_tmul
    (f : NonUnitalModuleHom Aᵐᵒᵖ X X') (g : NonUnitalModuleHom A Y Y') (x : X) (y : Y) :
    map A f g (tmul A X Y x y) = tmul A X' Y' (f x) (g y) := rfl

theorem map_pure_function
    (f : NonUnitalModuleHom Aᵐᵒᵖ X X') (g : NonUnitalModuleHom A Y Y') :
    (fun x y => map A f g (tmul A X Y x y)) =
      fun x y => tmul A X' Y' (f x) (g y) := rfl

theorem map_id :
    map A (NonUnitalModuleHom.id Aᵐᵒᵖ X) (NonUnitalModuleHom.id A Y) =
      AddMonoidHom.id (Tensor A X Y) :=
  hom_ext A (fun _ _ => rfl)

theorem map_comp
    (f : NonUnitalModuleHom Aᵐᵒᵖ X X') (g : NonUnitalModuleHom A Y Y')
    (f' : NonUnitalModuleHom Aᵐᵒᵖ X' X'') (g' : NonUnitalModuleHom A Y' Y'') :
    (map A f' g').comp (map A f g) = map A (f'.comp f) (g'.comp g) :=
  hom_ext A (fun _ _ => rfl)

end Maps

section ZeroCases

example [Subsingleton Z] (b : X →+ Y →+ Z) (hb : IsBalanced A b) : lift A b hb = 0 := by
  apply hom_ext A
  intro x y
  exact Subsingleton.elim _ _

example [Subsingleton A] : relations A X Y = ⊥ := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨a, x, y⟩, rfl⟩
    change (op a • x) ⊗ₜ[ℤ] y - x ⊗ₜ[ℤ] (a • y) = 0
    rw [Subsingleton.elim a 0]
    simp only [op_zero, NonUnitalModule.zero_smul, TensorProduct.zero_tmul,
      TensorProduct.tmul_zero, sub_self]
  · exact bot_le

example [Subsingleton X] : Subsingleton (Tensor A X Y) := by
  have hz (t : Tensor A X Y) : t = 0 := by
    obtain ⟨q, rfl⟩ := projection_surjective A X Y t
    refine TensorProduct.inductionOn q ?_ ?_
    · intro x y
      change tmul A X Y x y = 0
      rw [Subsingleton.elim x 0, zero_tmul]
    · intro q r hq hr
      rw [map_add, hq, hr, add_zero]
  exact ⟨fun s t => (hz s).trans (hz t).symm⟩

example [Subsingleton Y] : Subsingleton (Tensor A X Y) := by
  have hz (t : Tensor A X Y) : t = 0 := by
    obtain ⟨q, rfl⟩ := projection_surjective A X Y t
    refine TensorProduct.inductionOn q ?_ ?_
    · intro x y
      change tmul A X Y x y = 0
      rw [Subsingleton.elim y 0, tmul_zero]
    · intro q r hq hr
      rw [map_add, hq, hr, add_zero]
  exact ⟨fun s t => (hz s).trans (hz t).symm⟩

end ZeroCases

section NonzeroZeroActions

/-- Zero algebra actions on nonzero groups do not collapse the tensor. -/
example :
    letI := NonUnitalModule.zero (A := ℤᵐᵒᵖ) (M := ℤ)
    letI := NonUnitalModule.zero (A := ℤ) (M := ℤ)
    tmul ℤ ℤ ℤ 1 1 ≠ 0 := by
  let _ := NonUnitalModule.zero (A := ℤᵐᵒᵖ) (M := ℤ)
  let _ := NonUnitalModule.zero (A := ℤ) (M := ℤ)
  let b : ℤ →+ ℤ →+ ℤ :=
    { toFun x :=
        { toFun y := x * y
          map_zero' := mul_zero x
          map_add' := mul_add x }
      map_zero' := AddMonoidHom.ext (zero_mul)
      map_add' x x' := AddMonoidHom.ext (fun y => add_mul x x' y) }
  have hb : IsBalanced ℤ b := by
    intro a x y
    change b 0 y = b x 0
    simp
  intro ht
  have h := congrArg (lift ℤ b hb) ht
  have hb1 : b 1 1 = 1 := rfl
  rw [lift_tmul, hb1, map_zero] at h
  exact one_ne_zero h

end NonzeroZeroActions

