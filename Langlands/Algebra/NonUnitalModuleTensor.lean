section CompetingGroups

set_option linter.overlappingInstances false

variable (A : Type uA) (X : Type uX) (Y : Type uY) [NonUnitalRing A]
  [originalXGroup : AddCommGroup X] [originalYGroup : AddCommGroup Y]
  [originalRight : NonUnitalModule Aᵐᵒᵖ X] [originalLeft : NonUnitalModule A Y]
  [competingXGroup : AddCommGroup X] [competingYGroup : AddCommGroup Y]

example :
    letI := originalXGroup
    letI := originalYGroup
    (X ⊗[ℤ] Y) →+ Tensor A X Y :=
  @projection A X Y _ originalXGroup originalYGroup originalRight originalLeft

example :
    letI := originalXGroup
    letI := originalYGroup
    ∀ {Z : Type uZ} [AddCommGroup Z],
      (Tensor A X Y →+ Z) ≃+ balancedMaps A (X := X) (Y := Y) (Z := Z) :=
  @universalEquiv A X Y _ originalXGroup originalYGroup originalRight originalLeft

end CompetingGroups

section CompetingActions

set_option linter.overlappingInstances false

variable (A : Type uA) (X : Type uX) (Y : Type uY)
  [NonUnitalRing A] [AddCommGroup X] [AddCommGroup Y]
  [originalRight : NonUnitalModule Aᵐᵒᵖ X] [originalLeft : NonUnitalModule A Y]
  [competingRight : NonUnitalModule Aᵐᵒᵖ X] [competingLeft : NonUnitalModule A Y]

example :
    letI := originalRight
    letI := originalLeft
    Submodule ℤ (X ⊗[ℤ] Y) := @relations A X Y _ _ _ originalRight originalLeft

example :
    letI := originalRight
    letI := originalLeft
    ∀ {Z : Type uZ} [AddCommGroup Z],
      (Tensor A X Y →+ Z) ≃+ balancedMaps A (X := X) (Y := Y) (Z := Z) :=
  @universalEquiv A X Y _ _ _ originalRight originalLeft

end CompetingActions

section CompetingAmbient

set_option linter.overlappingInstances false

variable (A : Type uA) [originalAmbient : NonUnitalRing A] [competingAmbient : NonUnitalRing A]

example :
    letI := originalAmbient
    ∀ (X : Type uX) (Y : Type uY) [AddCommGroup X] [AddCommGroup Y]
      [NonUnitalModule Aᵐᵒᵖ X] [NonUnitalModule A Y], (X ⊗[ℤ] Y) →+ Tensor A X Y :=
  fun X Y => @projection A X Y originalAmbient

example :
    letI := originalAmbient
    ∀ {X : Type uX} {Y : Type uY} [AddCommGroup X] [AddCommGroup Y]
      [NonUnitalModule Aᵐᵒᵖ X] [NonUnitalModule A Y] {Z : Type uZ} [AddCommGroup Z],
      (Tensor A X Y →+ Z) ≃+ balancedMaps A (X := X) (Y := Y) (Z := Z) :=
  fun {X} {Y} => @universalEquiv A X Y originalAmbient

end CompetingAmbient

section CompetingIntegerScalars

variable (A : Type uA) (X : Type uX) (Y : Type uY)
  [NonUnitalRing A] [AddCommGroup X] [AddCommGroup Y]
  [NonUnitalModule Aᵐᵒᵖ X] [NonUnitalModule A Y]
  [competingXInteger : Module ℤ X] [competingYInteger : Module ℤ Y]
  [competingQuotientGroup : AddCommGroup (Tensor A X Y)]

example :
    letI := AddCommGroup.toIntModule X
    letI := AddCommGroup.toIntModule Y
    Submodule ℤ (X ⊗[ℤ] Y) := @relations A X Y _ _ _ _ _

example :
    letI := AddCommGroup.toIntModule X
    letI := AddCommGroup.toIntModule Y
    letI := addCommGroup A X Y
    (X ⊗[ℤ] Y) →+ Tensor A X Y := @projection A X Y _ _ _ _ _

example :
    letI := AddCommGroup.toIntModule X
    letI := AddCommGroup.toIntModule Y
    letI := addCommGroup A X Y
    ∀ {Z : Type uZ} [AddCommGroup Z],
      (Tensor A X Y →+ Z) ≃+ balancedMaps A (X := X) (Y := Y) (Z := Z) :=
  @universalEquiv A X Y _ _ _ _ _

end CompetingIntegerScalars

section CompetingTargetGroup

set_option linter.overlappingInstances false

variable (A : Type uA) (X : Type uX) (Y : Type uY)
  [NonUnitalRing A] [AddCommGroup X] [AddCommGroup Y]
  [NonUnitalModule Aᵐᵒᵖ X] [NonUnitalModule A Y]
  (Z : Type uZ) [originalZGroup : AddCommGroup Z] [competingZGroup : AddCommGroup Z]

example :
    letI := originalZGroup
    (Tensor A X Y →+ Z) ≃+ balancedMaps A (X := X) (Y := Y) (Z := Z) :=
  @universalEquiv A X Y _ _ _ _ _ Z originalZGroup

end CompetingTargetGroup

end

end Langlands.Algebra.NonUnitalModuleTensor
