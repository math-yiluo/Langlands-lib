import Mathlib.Algebra.DirectSum.Module
import Mathlib.Algebra.Group.Subsemigroup.Basic
import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.Noetherian.Defs

/-! # Positive generation of graded ideal support -/

universe u v w

namespace Langlands.Algebra.GradedIdealSupport

variable {k : Type u} [Field k] {R : Type v} [CommRing R] [Algebra k R]
    {Λ : Type w} [AddCommGroup Λ]

/-- Weights of nonzero elements in the given internal grading of an ideal. -/
def support (I : Ideal R) (W : Λ → Submodule k I) : Set Λ :=
  {χ | ∃ x : I, x ≠ 0 ∧ x ∈ W χ}

/-- Weights admitting a homogeneous lift with nonzero class in I/I². -/
def cotangentLiftSupport (I : Ideal R) (W : Λ → Submodule k I) : Set Λ :=
  {χ | ∃ x : I, x ∈ W χ ∧ I.toCotangent x ≠ 0}

open Classical in
/-- A proper ideal in a Noetherian domain, internally graded with homogeneous
products, has support positively generated by its nonzero cotangent lifts. -/
def PositiveGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (R : Type v) [CommRing R] [Algebra k R]
    [IsNoetherianRing R] [IsDomain R] (Λ : Type w) [AddCommGroup Λ]
    (I : Ideal R), I ≠ ⊤ → ∀ W : Λ → Submodule k I,
    DirectSum.IsInternal W →
    (∀ (χ ψ : Λ) (x y : I), x ∈ W χ → y ∈ W ψ → x * y ∈ W (χ + ψ)) →
    support I W = (AddSubsemigroup.closure (cotangentLiftSupport I W) : Set Λ)

end Langlands.Algebra.GradedIdealSupport
