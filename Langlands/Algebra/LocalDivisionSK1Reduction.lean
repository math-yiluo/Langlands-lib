import Langlands.Algebra.CyclicSubfieldReducedNorm
import Langlands.Algebra.LocalDivisionValuation

/-! Reducing the reduced-norm kernel to moving norm-one units into a cyclic subfield. -/

noncomputable section

namespace Langlands.CentralDivision

universe u uL

open Langlands.CentralSimple Langlands.BinaryElementary.Reduced
open scoped TensorProduct

section Subgroup

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D]
  {L : Type uL} [Field L] [Algebra K L]

/-- The subgroup generated by the commutator subgroup and the units of an embedded field. -/
def commutatorFieldSubgroup (ι : L →ₐ[K] D) : Subgroup Dˣ :=
  commutator Dˣ ⊔ (Units.map ι.toMonoidHom).range

/-- Since the commutator subgroup is normal, a unit lies in `commutatorFieldSubgroup ι`
exactly when some commutator moves it into the field image. -/
theorem mem_commutatorFieldSubgroup_iff (ι : L →ₐ[K] D) {a : Dˣ} :
    a ∈ commutatorFieldSubgroup ι ↔
      ∃ c ∈ commutator Dˣ, c * a ∈ (Units.map ι.toMonoidHom).range := by
  rw [commutatorFieldSubgroup, Subgroup.mem_sup_of_normal_left]
  constructor
  · rintro ⟨y, hy, z, hz, rfl⟩
    exact ⟨y⁻¹, inv_mem hy, by simpa using hz⟩
  · rintro ⟨c, hc, hca⟩
    exact ⟨c⁻¹, inv_mem hc, c * a, hca, by group⟩

end Subgroup

section Generic

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D]
  [FiniteDimensional K D] [Algebra.IsCentral K D]
  {L : Type uL} [Field L] [Algebra K L] [FiniteDimensional K L]
  [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]

/-- If the canonical norm kernel lies in the subgroup generated by commutators and a cyclic
field of reduced degree, it is the commutator subgroup. -/
theorem ker_coefficientNorm_eq_commutator_of_le (ι : L →ₐ[K] D)
    (hdeg : Module.finrank K L = reducedDegree K D)
    (hle : (coefficientNorm K D).ker ≤ commutatorFieldSubgroup ι) :
    (coefficientNorm K D).ker = commutator Dˣ := by
  refine le_antisymm ?_ commutator_le_ker_coefficientNorm
  intro a ha
  obtain ⟨c, hc, hca⟩ := (mem_commutatorFieldSubgroup_iff ι).1 (hle ha)
  have hker : c * a ∈ (coefficientNorm K D).ker :=
    mul_mem (commutator_le_ker_coefficientNorm hc) ha
  have hmem : c * a ∈ (Units.map ι.toMonoidHom).range ⊓ commutator Dˣ := by
    rw [← range_inf_ker_coefficientNorm_eq_range_inf_commutator ι hdeg]
    exact ⟨hca, hker⟩
  have heq : a = c⁻¹ * (c * a) := by group
  rw [heq]
  exact mul_mem (inv_mem hc) hmem.2

/-- If commutators move every canonical norm-one unit into a cyclic field of reduced degree,
the canonical norm kernel is the commutator subgroup. -/
theorem ker_coefficientNorm_eq_commutator_of_movement (ι : L →ₐ[K] D)
    (hdeg : Module.finrank K L = reducedDegree K D)
    (hmove : ∀ a ∈ (coefficientNorm K D).ker,
      ∃ c ∈ commutator Dˣ, c * a ∈ (Units.map ι.toMonoidHom).range) :
    (coefficientNorm K D).ker = commutator Dˣ :=
  ker_coefficientNorm_eq_commutator_of_le ι hdeg fun a ha =>
    (mem_commutatorFieldSubgroup_iff ι).2 (hmove a ha)

end Generic

section Local

open ValuativeRel

variable (K D : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [DivisionRing D] [Algebra K D]
  [FiniteDimensional K D] [Algebra.IsCentral K D]

/-- A unit of canonical reduced norm one has valuation one for the reduced-norm valuation. -/
theorem localReducedNormValuation_eq_one_of_mem_ker {a : Dˣ}
    (ha : a ∈ (coefficientNorm K D).ker) :
    localReducedNormValuation K D (a : D) = 1 := by
  rw [mem_ker_coefficientNorm] at ha
  rw [localReducedNormValuation_apply, ha, map_one]

variable {K D} {L : Type uL} [Field L] [Algebra K L] [FiniteDimensional K L]
  [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]

/-- If commutators move every valuation-one unit into a cyclic field of reduced degree,
the canonical norm kernel is the commutator subgroup. -/
theorem ker_coefficientNorm_eq_commutator_of_unit_movement (ι : L →ₐ[K] D)
    (hdeg : Module.finrank K L = reducedDegree K D)
    (hmove : ∀ a : Dˣ, localReducedNormValuation K D (a : D) = 1 →
      ∃ c ∈ commutator Dˣ, c * a ∈ (Units.map ι.toMonoidHom).range) :
    (coefficientNorm K D).ker = commutator Dˣ :=
  ker_coefficientNorm_eq_commutator_of_movement ι hdeg fun a ha =>
    hmove a (localReducedNormValuation_eq_one_of_mem_ker K D ha)

end Local

end Langlands.CentralDivision
