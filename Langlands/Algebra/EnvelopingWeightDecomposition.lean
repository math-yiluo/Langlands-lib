import Langlands.Representation.Archimedean.LowerVermaPBW
import Mathlib.Tactic.NoncommRing

/-! # Ordered enveloping monomials of weight zero -/

noncomputable section

universe u v w

set_option autoImplicit false

namespace Langlands.Algebra.UniversalEnveloping

open Langlands.Archimedean.VermaPBW Langlands.Archimedean.Kostant

attribute [local instance 100] LieRing.ofAssociativeRing

variable {k : Type u} [Field k] [CharZero k] {L : Type v} [Ring L] [Algebra k L]
  {I : Type w} [Fintype I] [DecidableEq I]
  (b : Module.Basis I k L) (d : I → ℤ)

local notation "U" => UniversalEnvelopingAlgebra k L
local notation "ι" => UniversalEnvelopingAlgebra.ι k

/-- The right ideal spanned by positive-weight generators times arbitrary
enveloping elements. -/
def positiveWeightRightIdeal : Submodule k U :=
  Submodule.span k {u | ∃ a : I, 0 < d a ∧ ∃ v : U, u = ι (b a) * v}

omit [CharZero k] [Fintype I] [DecidableEq I] in
theorem mul_mem_positiveWeightRightIdeal {u : U} (hu : u ∈ positiveWeightRightIdeal b d) (v : U) :
    u * v ∈ positiveWeightRightIdeal b d := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨a, ha, y, rfl⟩ := hu
    exact Submodule.subset_span ⟨a, ha, y * v, mul_assoc _ _ _⟩
  | zero => rw [zero_mul]; exact (positiveWeightRightIdeal b d).zero_mem
  | add x y _ _ hx hy => rw [add_mul]; exact (positiveWeightRightIdeal b d).add_mem hx hy
  | smul c x _ hx => rw [smul_mul_assoc]; exact (positiveWeightRightIdeal b d).smul_mem c hx

/-- The subalgebra generated by the weight-zero Lie directions. -/
def zeroWeightEnvelopingSubalgebra : Subalgebra k U :=
  Algebra.adjoin k {u | ∃ a : I, d a = 0 ∧ u = ι (b a)}

/-- The basis indices in decreasing adjoint weight. -/
def weightOrderedIndices : List I :=
  (Finset.univ : Finset I).toList.mergeSort fun a a' => decide (d a' ≤ d a)

omit [DecidableEq I] in
theorem weightOrderedIndices_nodup : (weightOrderedIndices d).Nodup :=
  (List.mergeSort_perm _ _).nodup_iff.mpr (Finset.nodup_toList _)

omit [DecidableEq I] in
theorem mem_weightOrderedIndices (a : I) : a ∈ weightOrderedIndices d :=
  (List.mergeSort_perm _ _).mem_iff.mpr (Finset.mem_toList.mpr (Finset.mem_univ a))

omit [DecidableEq I] in
theorem weightOrderedIndices_pairwise : (weightOrderedIndices d).Pairwise fun a a' => d a' ≤ d a := by
  simpa only [weightOrderedIndices, decide_eq_true_eq] using
    (List.pairwise_mergeSort (le := fun a a' : I => decide (d a' ≤ d a))
      (fun a a' a'' ha ha' => by simp only [decide_eq_true_eq] at *; omega)
      (fun a a' => by simp only [Bool.or_eq_true, decide_eq_true_eq]; omega)
      (Finset.univ : Finset I).toList)

/-- The PBW basis ordered by decreasing weight. -/
def weightOrderedPBWBasis : Module.Basis (I →₀ ℕ) k U :=
  pbwBasis b (AssocSymbol.symbolData b) (AssocSymbol.symbolData_ξ_basis b)
    (weightOrderedIndices_nodup d) (mem_weightOrderedIndices d)

theorem weightOrderedPBWBasis_apply (α : I →₀ ℕ) :
    weightOrderedPBWBasis b d α = word k L ((expand (weightOrderedIndices d) α).map b) :=
  pbwBasis_apply b (AssocSymbol.symbolData b) (AssocSymbol.symbolData_ξ_basis b)
    (weightOrderedIndices_nodup d) (mem_weightOrderedIndices d) α

omit [CharZero k] [Fintype I] [DecidableEq I] in
private theorem ad_word (H : L) (hH : ∀ a, ⁅H, b a⁆ = (d a : k) • b a) (l : List I) :
    ι H * word k L (l.map b) - word k L (l.map b) * ι H =
      (((l.map d).sum : ℤ) : k) • word k L (l.map b) := by
  induction l with
  | nil => simp [word]
  | cons a l ih =>
    have h := (UniversalEnvelopingAlgebra.ι k (L := L)).map_lie H (b a)
    rw [hH, map_smul, Ring.lie_def] at h
    simp only [List.map_cons, word_cons, List.sum_cons, Int.cast_add]
    calc
      _ = (ι H * ι (b a) - ι (b a) * ι H) * word k L (l.map b) +
        ι (b a) * (ι H * word k L (l.map b) - word k L (l.map b) * ι H) := by
          noncomm_ring
      _ = _ := by rw [← h, ih, smul_mul_assoc, mul_smul_comm, add_smul]

private theorem ad_weightOrderedPBWBasis (H : L) (hH : ∀ a, ⁅H, b a⁆ = (d a : k) • b a)
    (α : I →₀ ℕ) :
    ι H * weightOrderedPBWBasis b d α - weightOrderedPBWBasis b d α * ι H =
      (((expand (weightOrderedIndices d) α).map d).sum : k) • weightOrderedPBWBasis b d α := by
  rw [weightOrderedPBWBasis_apply]
  exact ad_word b d H hH _

private theorem weightOrderedPBWBasis_repr_ad (H : L) (hH : ∀ a, ⁅H, b a⁆ = (d a : k) • b a)
    (u : U) (α : I →₀ ℕ) :
    (weightOrderedPBWBasis b d).repr (ι H * u - u * ι H) α =
      (((expand (weightOrderedIndices d) α).map d).sum : k) *
        (weightOrderedPBWBasis b d).repr u α := by
  let B := weightOrderedPBWBasis b d
  let w (α : I →₀ ℕ) : k := ((expand (weightOrderedIndices d) α).map d).sum
  let ad : U →ₗ[k] U := LinearMap.mulLeft k (ι H) - LinearMap.mulRight k (ι H)
  have h : B.coord α ∘ₗ ad = w α • B.coord α := by
    refine B.ext fun β => ?_
    change B.coord α (ι H * B β - B β * ι H) = w α • B.coord α (B β)
    rw [ad_weightOrderedPBWBasis b d H hH β, map_smul]
    change w β • B.coord α (B β) = _
    obtain rfl | hne := eq_or_ne β α
    · rfl
    · simp [Module.Basis.coord_apply, Module.Basis.repr_self, Ne.symm hne]
  exact LinearMap.congr_fun h u

omit [DecidableEq I] in
private theorem expand_weightOrderedIndices_pairwise (α : I →₀ ℕ) :
    (expand (weightOrderedIndices d) α).Pairwise fun a a' => d a' ≤ d a := by
  unfold expand
  refine List.pairwise_flatMap.mpr ⟨fun a _ => ?_, ?_⟩
  · exact List.pairwise_replicate.mpr (Or.inr le_rfl)
  · refine (weightOrderedIndices_pairwise d).imp_of_mem fun {a a'} _ _ h => ?_
    intro x hx y hy
    rw [List.eq_of_mem_replicate hx, List.eq_of_mem_replicate hy]
    exact h

omit [Fintype I] [DecidableEq I] in
private theorem weight_zero_of_sum_zero (l : List I) (hn : ∀ a ∈ l, d a ≤ 0)
    (hs : (l.map d).sum = 0) : ∀ a ∈ l, d a = 0 := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha := hn a (List.mem_cons_self)
    have ht : ∀ a ∈ l, d a ≤ 0 := fun j hj => hn j (List.mem_cons_of_mem _ hj)
    have htle : (l.map d).sum ≤ 0 := by
      have h := List.sum_le_length_nsmul (l.map d) (0 : ℤ) (by
        rintro _ hx
        obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hx
        exact ht j hj)
      simpa only [nsmul_zero] using h
    simp only [List.map_cons, List.sum_cons] at hs
    intro j hj
    rcases List.mem_cons.mp hj with rfl | hj
    · omega
    · exact ih ht (by omega) j hj

omit [CharZero k] [Fintype I] [DecidableEq I] in
private theorem word_mem_zeroWeight (l : List I) (h : ∀ a ∈ l, d a = 0) :
    word k L (l.map b) ∈ zeroWeightEnvelopingSubalgebra b d := by
  induction l with
  | nil =>
    simpa only [List.map_nil, word_nil] using (zeroWeightEnvelopingSubalgebra b d).one_mem
  | cons a l ih =>
    rw [List.map_cons, word_cons]
    exact (zeroWeightEnvelopingSubalgebra b d).mul_mem
      (Algebra.subset_adjoin ⟨a, h a List.mem_cons_self, rfl⟩)
      (ih fun c hc => h c (List.mem_cons_of_mem _ hc))

private theorem weightOrderedPBWBasis_mem_sup (α : I →₀ ℕ)
    (hs : ((expand (weightOrderedIndices d) α).map d).sum = 0) :
    weightOrderedPBWBasis b d α ∈
      positiveWeightRightIdeal b d ⊔ (zeroWeightEnvelopingSubalgebra b d).toSubmodule := by
  rw [weightOrderedPBWBasis_apply]
  generalize hl : expand (weightOrderedIndices d) α = l at hs ⊢
  have hsort := expand_weightOrderedIndices_pairwise d α
  rw [hl] at hsort
  cases l with
  | nil => exact Submodule.mem_sup_right (word_mem_zeroWeight b d [] (by simp))
  | cons a l =>
    by_cases ha : 0 < d a
    · apply Submodule.mem_sup_left
      rw [List.map_cons, word_cons]
      exact Submodule.subset_span ⟨a, ha, _, rfl⟩
    · have hnon (c : I) (hc : c ∈ a :: l) : d c ≤ 0 := by
        rcases List.mem_cons.mp hc with rfl | hc
        · exact le_of_not_gt ha
        · exact le_trans ((List.pairwise_cons.mp hsort).1 c hc) (le_of_not_gt ha)
      exact Submodule.mem_sup_right
        (word_mem_zeroWeight b d _ (weight_zero_of_sum_zero d _ hnon hs))

/-- For an integral grading given by one adjoint operator, a central element
is a sum of a weight-zero enveloping element and an element of the positive
right ideal. -/
theorem center_mem_positiveWeight_sup_zeroWeight (H : L)
    (hH : ∀ a, ⁅H, b a⁆ = (d a : k) • b a) (z : Subalgebra.center k U) :
    z.val ∈ positiveWeightRightIdeal b d ⊔ (zeroWeightEnvelopingSubalgebra b d).toSubmodule := by
  let B := weightOrderedPBWBasis b d
  have hz : ι H * z.val - z.val * ι H = 0 :=
    sub_eq_zero.mpr (Subalgebra.mem_center_iff.mp z.property (ι H))
  have hsupport (α : I →₀ ℕ) (hα : α ∈ (B.repr z.val).support) :
      ((expand (weightOrderedIndices d) α).map d).sum = 0 := by
    have h := weightOrderedPBWBasis_repr_ad b d H hH z.val α
    rw [hz, map_zero, Finsupp.zero_apply] at h
    have hc := (mul_eq_zero.mp h.symm).resolve_right (Finsupp.mem_support_iff.mp hα)
    exact Int.cast_eq_zero.mp hc
  rw [← B.linearCombination_repr z.val, Finsupp.linearCombination_apply, Finsupp.sum]
  exact Submodule.sum_mem _ fun α hα =>
    Submodule.smul_mem _ _ (weightOrderedPBWBasis_mem_sup b d α (hsupport α hα))

end Langlands.Algebra.UniversalEnveloping
