import Langlands.Algebra.PTorsionHopf.PolynomialStructure
import Mathlib.RingTheory.Flat.Equalizer
import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.RingTheory.FiniteType

/-! # Descent of algebra generation by a linear kernel -/

noncomputable section

universe u v w z

open TensorProduct

namespace Langlands.Algebra.KernelGeneration

variable {R : Type u} [CommRing R] {B : Type v} [CommRing B] [Algebra R B]
  {V : Type w} [AddCommGroup V] [Module R V]

/-- The subalgebra generated by a linear map's kernel. -/
def kernelAdjoin (d : B →ₗ[R] V) : Subalgebra R B :=
  Algebra.adjoin R (LinearMap.ker d : Set B)

/-- A faithfully flat scalar extension reflects whether a linear kernel generates
its ambient algebra. -/
theorem kernelAdjoin_eq_top_of_baseChange
    (S : Type z) [CommRing S] [Algebra R S] [Module.FaithfullyFlat R S]
    (d : B →ₗ[R] V)
    (hgen : Algebra.adjoin S
      (LinearMap.ker (AlgebraTensorModule.lTensor S S d) : Set (S ⊗[R] B)) = ⊤) :
    kernelAdjoin d = ⊤ := by
  let A := kernelAdjoin d
  have hker : LinearMap.ker (AlgebraTensorModule.lTensor S S d) ≤
      (A.baseChange S).toSubmodule := by
    rw [Module.Flat.ker_lTensor_eq S S d]
    rintro _ ⟨t, rfl⟩
    induction t using TensorProduct.inductionOn with
    | tmul s b =>
      exact Subalgebra.tmul_mem_baseChange (Algebra.subset_adjoin b.property) s
    | add a b ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  have hAtop : A.baseChange S = ⊤ := by
    apply top_le_iff.mp
    rw [← hgen]
    exact Algebra.adjoin_le hker
  have htensor : Function.Surjective (A.val.toLinearMap.lTensor S) := by
    change Function.Surjective (Algebra.TensorProduct.map (AlgHom.id S S) A.val)
    rw [← AlgHom.range_eq_top]
    exact hAtop
  have hsurj : Function.Surjective A.val :=
    (Module.FaithfullyFlat.lTensor_surjective_iff_surjective R S A.val.toLinearMap).mp htensor
  apply top_le_iff.mp
  intro b _
  obtain ⟨a, ha⟩ := hsurj b
  exact ha ▸ a.property

/-- A finite-type algebra generated by a specified set has a finite generating subset. -/
theorem exists_finset_generators [Algebra.FiniteType R B] {U : Set B}
    (hU : Algebra.adjoin R U = ⊤) :
    ∃ T : Finset B, (T : Set B) ⊆ U ∧ Algebra.adjoin R (T : Set B) = ⊤ := by
  classical
  obtain ⟨F, hF⟩ := Algebra.FiniteType.out (R := R) (A := B)
  have hmem : ∀ b : F, b.val ∈ Algebra.adjoin R U := by simp [hU]
  choose T hT hmemT using fun b : F => PTorsionHopf.exists_finset_of_mem_adjoin (hmem b)
  refine ⟨Finset.univ.biUnion T, ?_, ?_⟩
  · intro b hb
    obtain ⟨c, _, hc⟩ := Finset.mem_biUnion.mp hb
    exact hT c hc
  · apply top_le_iff.mp
    rw [← hF]
    apply Algebra.adjoin_le
    intro b hb
    exact Algebra.adjoin_mono (by
      intro c hc
      exact Finset.mem_biUnion.mpr ⟨⟨b, hb⟩, Finset.mem_univ _, hc⟩) (hmemT ⟨b, hb⟩)

/-- The descended kernel generators may be chosen as a finite family in that kernel. -/
theorem exists_finite_kernel_generators_of_baseChange
    [Algebra.FiniteType R B]
    (S : Type z) [CommRing S] [Algebra R S] [Module.FaithfullyFlat R S]
    (d : B →ₗ[R] V)
    (hgen : Algebra.adjoin S
      (LinearMap.ker (AlgebraTensorModule.lTensor S S d) : Set (S ⊗[R] B)) = ⊤) :
    ∃ T : Finset (LinearMap.ker d),
      Algebra.adjoin R (Subtype.val '' (T : Set (LinearMap.ker d))) = ⊤ := by
  classical
  obtain ⟨T, hT, hgenT⟩ := exists_finset_generators (kernelAdjoin_eq_top_of_baseChange S d hgen)
  obtain ⟨G, _, hG⟩ : ∃ G : Finset (LinearMap.ker d),
      (G : Set (LinearMap.ker d)) ⊆ Set.univ ∧ G.image Subtype.val = T := by
    apply Finset.subset_set_image_iff.mp
    intro b hb
    exact ⟨⟨b, hT hb⟩, Set.mem_univ _, rfl⟩
  exact ⟨G, by rw [← Finset.coe_image, hG]; exact hgenT⟩

end Langlands.Algebra.KernelGeneration
