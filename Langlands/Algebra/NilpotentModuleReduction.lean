import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Idempotents
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Algebra.Module.LinearMap.End

/-! # Endomorphism rigidity modulo a nilpotent base ideal -/

universe u v

namespace Langlands.NilpotentModuleReduction

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-- Every linear endomorphism preserves the submodule generated by a base ideal. -/
theorem smul_top_le_comap (I : Ideal R) (f : Module.End R M) :
    I • (⊤ : Submodule R M) ≤ (I • (⊤ : Submodule R M)).comap f := by
  rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
  exact Submodule.smul_mono le_rfl le_top

/-- Reduction of linear endomorphisms on the quotient module `M / I M`. -/
def reduction (I : Ideal R) :
    Module.End R M →+* Module.End R (M ⧸ I • (⊤ : Submodule R M)) where
  toFun f := (I • (⊤ : Submodule R M)).mapQ (I • ⊤) f (smul_top_le_comap I f)
  map_one' := by
    ext x
    rfl
  map_mul' f g := by
    ext x
    rfl
  map_zero' := by
    ext x
    rfl
  map_add' f g := by
    ext x
    rfl

@[simp]
theorem reduction_apply_mk (I : Ideal R) (f : Module.End R M) (x : M) :
    reduction I f (Submodule.Quotient.mk x) = Submodule.Quotient.mk (f x) := rfl

theorem reduction_eq_zero_iff (I : Ideal R) (f : Module.End R M) :
    reduction I f = 0 ↔ LinearMap.range f ≤ I • (⊤ : Submodule R M) := by
  constructor
  · intro h y hy
    obtain ⟨x, rfl⟩ := hy
    have hx := LinearMap.congr_fun h (Submodule.Quotient.mk x)
    exact (Submodule.Quotient.mk_eq_zero _).mp hx
  · intro h
    ext x
    exact (Submodule.Quotient.mk_eq_zero _).mpr (h (LinearMap.mem_range_self f x))

/-- If `f(M) ⊆ I M`, its `n`-th power has image in `I^n M`. -/
theorem range_pow_le (I : Ideal R) (f : Module.End R M)
    (hf : LinearMap.range f ≤ I • (⊤ : Submodule R M)) (n : ℕ) :
    LinearMap.range (f ^ n) ≤ I ^ n • (⊤ : Submodule R M) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', Module.End.mul_eq_comp, LinearMap.range_comp]
    calc
      (LinearMap.range (f ^ n)).map f ≤ (I ^ n • (⊤ : Submodule R M)).map f :=
        Submodule.map_mono ih
      _ = I ^ n • LinearMap.range f := by
        rw [Submodule.map_smul'', Submodule.map_top]
      _ ≤ I ^ n • (I • (⊤ : Submodule R M)) :=
        Submodule.smul_mono le_rfl hf
      _ = I ^ (n + 1) • (⊤ : Submodule R M) := by
        rw [← Submodule.mul_smul, pow_succ]

/-- An endomorphism which vanishes modulo a nilpotent base ideal is nilpotent. -/
theorem isNilpotent_of_range_le (I : Ideal R) (hI : IsNilpotent I)
    (f : Module.End R M) (hf : LinearMap.range f ≤ I • (⊤ : Submodule R M)) :
    IsNilpotent f := by
  obtain ⟨n, hn⟩ := hI
  refine ⟨n, LinearMap.range_eq_bot.mp (eq_bot_iff.mpr ?_)⟩
  simpa [hn] using range_pow_le I f hf n

/-- Commuting idempotents equal modulo a nilpotent base ideal are equal. -/
theorem eq_of_reduction_eq (I : Ideal R) (hI : IsNilpotent I)
    {e f : Module.End R M} (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (hef : Commute e f) (h : reduction I e = reduction I f) : e = f := by
  apply eq_of_isNilpotent_sub_of_isIdempotentElem_of_commute he hf _ hef
  apply isNilpotent_of_range_le I hI
  apply (reduction_eq_zero_iff I (e - f)).mp
  rw [map_sub, h, sub_self]

/-- Pointwise congruence modulo `I M` is enough for rigidity. -/
theorem eq_of_sub_mem (I : Ideal R) (hI : IsNilpotent I)
    {e f : Module.End R M} (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (hef : Commute e f) (h : ∀ x, e x - f x ∈ I • (⊤ : Submodule R M)) : e = f := by
  apply eq_of_isNilpotent_sub_of_isIdempotentElem_of_commute he hf _ hef
  apply isNilpotent_of_range_le I hI
  rintro y ⟨x, rfl⟩
  exact h x

end Langlands.NilpotentModuleReduction
