import Langlands.Algebra.RenardNilpotentIdealFiltration
import Langlands.Algebra.CommutingDimensionRecurrence

/-! The actual head ideal, tail algebra and first-level action in Renard C.I. -/

noncomputable section

namespace Langlands.Renard.NilpotentFiltration

universe u

variable {V : Type u} [AddCommGroup V] [Module ℂ V]

/-- The source's `R'`: the tail-generated subalgebra inside the original `R`. -/
def tailAlgebra {l : ℕ} (a : Fin (l + 1) → Module.End ℂ V) :
    Subalgebra ℂ (generatedAlgebra a) :=
  Algebra.adjoin ℂ (Set.range (Fin.tail (generator a)))

/-- The source's `R''`: the ideal generated by the first generator inside `R`. -/
def headIdeal {l : ℕ} (a : Fin (l + 1) → Module.End ℂ V) :
    Ideal (generatedAlgebra a) :=
  Ideal.span {generator a 0}

/-- The complex subspace underlying the actual first-generator ideal. -/
def headIdealSubspace {l : ℕ} (a : Fin (l + 1) → Module.End ℂ V) :
    Submodule ℂ (generatedAlgebra a) :=
  (headIdeal a).restrictScalars ℂ

/-- Inclusion in the original endomorphism ring identifies the tail algebra. -/
theorem tailAlgebra_map {l : ℕ} (a : Fin (l + 1) → Module.End ℂ V) :
    (tailAlgebra a).map (generatedAlgebra a).val =
      generatedAlgebra (Fin.tail a) := by
  rw [tailAlgebra, AlgHom.map_adjoin, ← Set.range_comp]
  rfl

/-- The first listed generator belongs to its actual principal ideal. -/
theorem generator_zero_mem_headIdeal {l : ℕ}
    (a : Fin (l + 1) → Module.End ℂ V) :
    generator a 0 ∈ headIdeal a :=
  Ideal.subset_span (Set.mem_singleton _)

variable {l : ℕ} (a : Fin l → Module.End ℂ V)

/-- The original generated algebra acts on the invariant first filtration level. -/
def firstLevelRestriction :
    generatedAlgebra a →ₐ[ℂ] Module.End ℂ (idealPowerSubspace a 1) :=
  Langlands.CommutingDimension.restrictionAlgHom ℂ V (generatedAlgebra a)
    (idealPowerSubspace a 1)
    (fun r _ hv => idealPowerSubspace_stable a 1 r hv)

/-- Each original generator restricted to the actual first filtration level. -/
def firstLevelTuple (i : Fin l) :
    Module.End ℂ (idealPowerSubspace a 1) :=
  firstLevelRestriction a (generator a i)

/-- The actual unital algebra generated by the restricted original tuple. -/
def firstLevelAlgebra :
    Subalgebra ℂ (Module.End ℂ (idealPowerSubspace a 1)) :=
  generatedAlgebra (firstLevelTuple a)

@[simp] theorem firstLevelRestriction_apply (r : generatedAlgebra a)
    (v : idealPowerSubspace a 1) :
    (firstLevelRestriction a r v : V) = (r : Module.End ℂ V) v := rfl

@[simp] theorem firstLevelTuple_apply (i : Fin l)
    (v : idealPowerSubspace a 1) :
    (firstLevelTuple a i v : V) = a i v := rfl

/-- The restricted original tuple generates the image of the actual action map. -/
theorem firstLevelAlgebra_eq_range :
    firstLevelAlgebra a = (firstLevelRestriction a).range := by
  exact Langlands.CommutingDimension.adjoin_image_generators ℂ (generator a)
    (Langlands.CommutingDimension.adjoin_generators_top ℂ a)
    (firstLevelRestriction a)

/-- Commutation of the original tuple is preserved by its restriction. -/
theorem firstLevelTuple_commute
    (hcomm : ∀ i j, Commute (a i) (a j)) (i j : Fin l) :
    Commute (firstLevelTuple a i) (firstLevelTuple a j) := by
  have h : Commute (generator a i) (generator a j) := by
    apply Subtype.ext
    exact (hcomm i j).eq
  exact h.map (firstLevelRestriction a)

/-- Nilpotence of an original generator is preserved by its restriction. -/
theorem firstLevelTuple_isNilpotent (hnil : ∀ i, IsNilpotent (a i))
    (i : Fin l) : IsNilpotent (firstLevelTuple a i) := by
  have h : IsNilpotent (generator a i) :=
    (IsNilpotent.map_iff (f := (generatedAlgebra a).val)
      Subtype.val_injective).mp (hnil i)
  exact h.map (firstLevelRestriction a)

end Langlands.Renard.NilpotentFiltration
