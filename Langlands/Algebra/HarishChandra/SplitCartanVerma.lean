import Langlands.Algebra.HarishChandra.VermaCentralCharacter
import Langlands.Algebra.HarishChandra.CenterBorelWeightBasis
import Mathlib.Algebra.MvPolynomial.Funext

/-! # Mirror Verma right ideals of a split Cartan subalgebra

Let `𝔥` be a split Cartan subalgebra of a finite-dimensional complex Lie algebra `𝔤`, and let
`X ∈ 𝔥` be real-regular: `Re χ(X) ≠ 0` for every root `χ`. For a linear form `λ` on `𝔥` the
mirror Verma right ideal `R_X(λ)` of `U(𝔤)` is generated by the root vectors of the roots with
`Re χ(X) > 0` and by the elements `h - λ(h)`, `h ∈ 𝔥`. This file shows that an element of
`U(𝔤)` commuting with `𝔥` is congruent modulo `R_X(λ)` to exactly one scalar, that along an
affine line of parameters this scalar is a polynomial function, and that an element commuting with
`𝔥` and lying in `R_X(λ)` for every `λ` lies in the right ideal generated by the positive root
vectors. -/

noncomputable section

universe v

set_option autoImplicit false

namespace Langlands.Algebra.HarishChandra

open LieModule Langlands.Algebra.UniversalEnveloping Polynomial

attribute [local instance 100] LieRing.ofAssociativeRing

section Weights

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L] {H : LieSubalgebra ℂ L}

theorem exists_ne_zero_of_weightSpace_ne_bot {χ : H → ℂ} (hχ : weightSpace L χ ≠ ⊥) :
    ∃ x ∈ weightSpace L χ, x ≠ 0 := by
  by_contra hcon
  push Not at hcon
  exact hχ ((LieSubmodule.eq_bot_iff _).mpr hcon)

theorem weightSpace_ne_bot_of_mem {χ : H → ℂ} {x : L} (hx : x ∈ weightSpace L χ) (hx0 : x ≠ 0) :
    weightSpace L χ ≠ ⊥ := by
  intro h
  rw [h] at hx
  exact hx0 hx

/-- A function on `𝔥` with a nonzero weight vector is linear; this is the linear form. -/
def weightForm {χ : H → ℂ} (hχ : weightSpace L χ ≠ ⊥) : H →ₗ[ℂ] ℂ where
  toFun := χ
  map_add' h₁ h₂ := by
    obtain ⟨x, hx, hx0⟩ := exists_ne_zero_of_weightSpace_ne_bot hχ
    rw [mem_weightSpace] at hx
    refine smul_left_injective ℂ hx0 ?_
    change χ (h₁ + h₂) • x = (χ h₁ + χ h₂) • x
    rw [← hx, add_smul, ← hx, ← hx, add_lie]
  map_smul' c h := by
    obtain ⟨x, hx, hx0⟩ := exists_ne_zero_of_weightSpace_ne_bot hχ
    rw [mem_weightSpace] at hx
    refine smul_left_injective ℂ hx0 ?_
    change χ (c • h) • x = (c * χ h) • x
    rw [← hx, mul_smul, ← hx, smul_lie]

@[simp]
theorem weightForm_apply {χ : H → ℂ} (hχ : weightSpace L χ ≠ ⊥) (h : H) :
    weightForm hχ h = χ h := rfl

theorem coe_weightForm {χ : H → ℂ} (hχ : weightSpace L χ ≠ ⊥) : ⇑(weightForm hχ) = χ := rfl

variable (H) in
/-- A real-regular element of `𝔥`: every root has nonzero real part at it. -/
def IsRealRegular (X : H) : Prop :=
  ∀ χ : H → ℂ, χ ≠ 0 → weightSpace L χ ≠ ⊥ → (χ X).re ≠ 0

end Weights

section RightIdeals

variable {A : Type*} [Ring A] [Algebra ℂ A]

/-- The span of a set closed under right multiplication is a right ideal. -/
theorem span_mul_mem_of_closed (S : Set A) (hS : ∀ s ∈ S, ∀ y : A, s * y ∈ S) {x : A}
    (hx : x ∈ Submodule.span ℂ S) (y : A) : x * y ∈ Submodule.span ℂ S := by
  induction hx using Submodule.span_induction with
  | mem x hx => exact Submodule.subset_span (hS x hx y)
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x x' _ _ h₁ h₂ => rw [add_mul]; exact Submodule.add_mem _ h₁ h₂
  | smul t x _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ t h

theorem sup_mul_mem {R₁ R₂ : Submodule ℂ A} (h₁ : ∀ r ∈ R₁, ∀ y : A, r * y ∈ R₁)
    (h₂ : ∀ r ∈ R₂, ∀ y : A, r * y ∈ R₂) {x : A} (hx : x ∈ R₁ ⊔ R₂) (y : A) :
    x * y ∈ R₁ ⊔ R₂ := by
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hx
  rw [add_mul]
  exact Submodule.add_mem _ (Submodule.mem_sup_left (h₁ p hp y))
    (Submodule.mem_sup_right (h₂ q hq y))

end RightIdeals

section Verma

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

local notation "U" => UniversalEnvelopingAlgebra ℂ L
local notation "ι" => UniversalEnvelopingAlgebra.ι ℂ

theorem generatorRightIdeal_mul_mem (V : Submodule ℂ L) {x : U}
    (hx : x ∈ generatorRightIdeal V) (y : U) : x * y ∈ generatorRightIdeal V := by
  refine span_mul_mem_of_closed {a | ∃ x ∈ V, ∃ b : U, a = ι x * b} ?_ hx y
  rintro _ ⟨a, ha, v, rfl⟩ y
  exact ⟨a, ha, v * y, by rw [mul_assoc]⟩

theorem generator_mul_mem_generatorRightIdeal (V : Submodule ℂ L) {x : L} (hx : x ∈ V)
    (v : U) : ι x * v ∈ generatorRightIdeal V :=
  Submodule.subset_span ⟨x, hx, v, rfl⟩

theorem generatorRightIdeal_mono {V W : Submodule ℂ L} (h : V ≤ W) :
    generatorRightIdeal V ≤ generatorRightIdeal W := by
  rw [generatorRightIdeal, Submodule.span_le]
  rintro _ ⟨x, hx, v, rfl⟩
  exact generator_mul_mem_generatorRightIdeal W (h hx) v

/-- The right ideal generated by the span of a family is spanned by the products of its members
with arbitrary elements. -/
theorem generatorRightIdeal_span_image {I : Type*} (b : I → L) (S : Set I) :
    generatorRightIdeal (Submodule.span ℂ (b '' S)) =
      Submodule.span ℂ {u | ∃ a, a ∈ S ∧ ∃ v : U, u = ι (b a) * v} := by
  apply le_antisymm
  · rw [generatorRightIdeal, Submodule.span_le]
    rintro _ ⟨x, hx, v, rfl⟩
    induction hx using Submodule.span_induction generalizing v with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact Submodule.subset_span ⟨a, ha, v, rfl⟩
    | zero => rw [map_zero, zero_mul]; exact Submodule.zero_mem _
    | add x x' _ _ h₁ h₂ => rw [map_add, add_mul]; exact Submodule.add_mem _ (h₁ v) (h₂ v)
    | smul t x _ h => rw [map_smul, smul_mul_assoc]; exact Submodule.smul_mem _ t (h v)
  · rw [Submodule.span_le]
    rintro _ ⟨a, ha, v, rfl⟩
    exact generator_mul_mem_generatorRightIdeal _
      (Submodule.subset_span (Set.mem_image_of_mem b ha)) v

variable {H : LieSubalgebra ℂ L}

/-- The right ideal generated by the elements `h - λ(h)` of `U(𝔤)`, `h ∈ 𝔥`. -/
def cartanShiftSpan (lam : H →ₗ[ℂ] ℂ) : Submodule ℂ U :=
  Submodule.span ℂ {u | ∃ h : H, ∃ v : U, u = (ι (h : L) - algebraMap ℂ U (lam h)) * v}

variable (H) in
/-- The mirror Verma right ideal of `X ∈ 𝔥` and `λ`: generated by the root vectors of the roots
with positive real part at `X` and by the elements `h - λ(h)` with `h ∈ 𝔥`. -/
def vermaIdeal (X : H) (lam : H →ₗ[ℂ] ℂ) : Submodule ℂ U :=
  generatorRightIdeal (positiveRootSubmodule H X) ⊔ cartanShiftSpan lam

theorem cartanShiftSpan_mul_mem (lam : H →ₗ[ℂ] ℂ) {x : U} (hx : x ∈ cartanShiftSpan lam)
    (y : U) : x * y ∈ cartanShiftSpan lam := by
  refine span_mul_mem_of_closed
    {u | ∃ h : H, ∃ v : U, u = (ι (h : L) - algebraMap ℂ U (lam h)) * v} ?_ hx y
  rintro _ ⟨h, v, rfl⟩ y
  exact ⟨h, v * y, by rw [mul_assoc]⟩

theorem vermaIdeal_mul_mem (X : H) (lam : H →ₗ[ℂ] ℂ) {x : U} (hx : x ∈ vermaIdeal H X lam)
    (y : U) : x * y ∈ vermaIdeal H X lam :=
  sup_mul_mem (fun _ hr y => generatorRightIdeal_mul_mem _ hr y)
    (fun _ hr y => cartanShiftSpan_mul_mem lam hr y) hx y

theorem positive_mul_mem_vermaIdeal (X : H) (lam : H →ₗ[ℂ] ℂ) {x : L}
    (hx : x ∈ positiveRootSubmodule H X) (v : U) : ι x * v ∈ vermaIdeal H X lam :=
  Submodule.mem_sup_left (generator_mul_mem_generatorRightIdeal _ hx v)

theorem cartan_mul_mem_vermaIdeal (X : H) (lam : H →ₗ[ℂ] ℂ) (h : H) (v : U) :
    (ι (h : L) - algebraMap ℂ U (lam h)) * v ∈ vermaIdeal H X lam :=
  Submodule.mem_sup_right (Submodule.subset_span ⟨h, v, rfl⟩)

theorem generatorRightIdeal_le_vermaIdeal (X : H) (lam : H →ₗ[ℂ] ℂ) {V : Submodule ℂ L}
    (hV : V ≤ positiveRootSubmodule H X) : generatorRightIdeal V ≤ vermaIdeal H X lam :=
  le_sup_of_le_left (generatorRightIdeal_mono hV)

/-- A singular vector: if `u₀` multiplies the generators of `R_X(λ)` into a right ideal `R`, it
multiplies all of `R_X(λ)` into `R`. -/
theorem mul_mem_of_mem_vermaIdeal (X : H) (lam : H →ₗ[ℂ] ℂ) (R : Submodule ℂ U)
    (hR : ∀ r ∈ R, ∀ y : U, r * y ∈ R) (u₀ : U)
    (hpos : ∀ x ∈ positiveRootSubmodule H X, u₀ * ι x ∈ R)
    (hcart : ∀ h : H, u₀ * (ι (h : L) - algebraMap ℂ U (lam h)) ∈ R) {r : U}
    (hr : r ∈ vermaIdeal H X lam) : u₀ * r ∈ R := by
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hr
  clear hr
  rw [mul_add]
  refine R.add_mem ?_ ?_
  · induction hp using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, v, rfl⟩ := hx
      rw [← mul_assoc]
      exact hR _ (hpos a ha) v
    | zero => rw [mul_zero]; exact R.zero_mem
    | add x y _ _ h₁ h₂ => rw [mul_add]; exact R.add_mem h₁ h₂
    | smul t x _ h => rw [mul_smul_comm]; exact R.smul_mem t h
  · induction hq using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨h, v, rfl⟩ := hx
      rw [← mul_assoc]
      exact hR _ (hcart h) v
    | zero => rw [mul_zero]; exact R.zero_mem
    | add x y _ _ h₁ h₂ => rw [mul_add]; exact R.add_mem h₁ h₂
    | smul t x _ h => rw [mul_smul_comm]; exact R.smul_mem t h

end Verma

section SortedBasis

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

local notation "U" => UniversalEnvelopingAlgebra ℂ L
local notation "ι" => UniversalEnvelopingAlgebra.ι ℂ

variable (H : LieSubalgebra ℂ L) (X : H)

/-- A basis of simultaneous eigenvectors of `ad 𝔥`, sorted by decreasing real weight at `X`, with
one vector for each nonzero weight that occurs and with the vectors of real weight zero in `𝔥`. -/
structure SortedWeightBasis where
  /-- The number of basis vectors. -/
  n : ℕ
  /-- The basis. -/
  b : Module.Basis (Fin n) ℂ L
  /-- The weights. -/
  w : Fin n → H → ℂ
  mem : ∀ a, b a ∈ weightSpace L (w a)
  antitone : Antitone (realWeight w X)
  zero : ∀ a, realWeight w X a = 0 → b a ∈ H ∧ w a = 0
  line : ∀ a a', w a ≠ 0 → w a = w a' → a = a'

variable {H X}

namespace SortedWeightBasis

variable (B : SortedWeightBasis H X)

theorem lie_eq (a : Fin B.n) (h : H) : ⁅(h : L), B.b a⁆ = B.w a h • B.b a :=
  (mem_weightSpace _ _).mp (B.mem a) h

theorem weightSpace_ne_bot (a : Fin B.n) : weightSpace L (B.w a) ≠ ⊥ :=
  weightSpace_ne_bot_of_mem (B.mem a) (B.b.ne_zero a)

open scoped Classical in
/-- The parameters of the basis Verma ideal attached to a linear form on `𝔥`. -/
def param (lam : H →ₗ[ℂ] ℂ) (a : Fin B.n) : ℂ :=
  if h : B.b a ∈ H then lam ⟨B.b a, h⟩ else 0

theorem param_add_smul (lam₀ lam₁ : H →ₗ[ℂ] ℂ) (t : ℂ) :
    B.param (lam₀ + t • lam₁) = B.param lam₀ + t • B.param lam₁ := by
  funext a
  simp only [param, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  split_ifs <;> simp

theorem neg_letters_lie (a a' : Fin B.n) (ha : realWeight B.w X a < 0)
    (ha' : realWeight B.w X a' < 0) :
    ⁅B.b a, B.b a'⁆ ∈ Submodule.span ℂ (B.b '' {i | realWeight B.w X i < 0}) := by
  refine Submodule.span_mono (Set.image_mono fun i (hi : B.w i = B.w a + B.w a') => ?_)
    (lie_mem_span_rootWeight B.b B.w B.lie_eq a a')
  change realWeight B.w X i < 0
  rw [realWeight, hi, Pi.add_apply, Complex.add_re]
  exact add_neg ha ha'

/-- Coordinates of an element of `𝔥` are supported on the weight-zero indices. -/
theorem repr_eq_zero_of_mem (hab : IsLieAbelian H) {h : L} (hh : h ∈ H) (a : Fin B.n)
    (ha : B.w a ≠ 0) : B.b.repr h a = 0 := by
  by_contra hne
  apply ha
  refine weight_eq_of_basis_repr_ne_zero B.b B.w B.mem (ψ := 0) ?_ hne
  rw [mem_weightSpace]
  intro h'
  rw [Pi.zero_apply, zero_smul, LieSubalgebra.coe_bracket_of_module]
  have := congrArg Subtype.val (hab.1 h' ⟨h, hh⟩)
  rw [LieSubalgebra.coe_bracket] at this
  simpa using this

theorem realWeight_eq_zero_iff (a : Fin B.n) :
    realWeight B.w X a = 0 ↔ B.w a = 0 := by
  refine ⟨fun h => (B.zero a h).2, fun h => ?_⟩
  rw [realWeight, h, Pi.zero_apply, Complex.zero_re]

/-- The basis Verma ideal is the intrinsic one. -/
theorem basisVermaIdeal_eq (hab : IsLieAbelian H) (lam : H →ₗ[ℂ] ℂ) :
    basisVermaIdeal B.b B.w X (B.param lam) = vermaIdeal H X lam := by
  rw [basisVermaIdeal, vermaIdeal, positiveRootSubmodule_eq_span B.b B.w B.mem X,
    generatorRightIdeal_span_image, realPositiveGeneratorSpan]
  congr 1
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨a, ha, v, rfl⟩
    have hH := (B.zero a ha).1
    refine Submodule.subset_span ⟨⟨B.b a, hH⟩, v, ?_⟩
    simp [param, hH]
  · rw [cartanShiftSpan, Submodule.span_le]
    rintro _ ⟨h, v, rfl⟩
    have hzero : ∀ a ∈ (B.b.repr (h : L)).support, B.b a ∈ H := fun a ha => by
      by_contra hna
      have hw : B.w a ≠ 0 := fun hw => hna (B.zero a ((B.realWeight_eq_zero_iff a).mpr hw)).1
      exact (Finsupp.mem_support_iff.mp ha) (B.repr_eq_zero_of_mem hab h.2 a hw)
    have hh : (h : L) = ∑ a ∈ (B.b.repr (h : L)).support, B.b.repr (h : L) a • B.b a := by
      conv_lhs => rw [← B.b.linearCombination_repr (h : L)]
      rw [Finsupp.linearCombination_apply, Finsupp.sum]
    have hhH : h = ∑ a ∈ (B.b.repr (h : L)).support.attach,
        B.b.repr (h : L) a • (⟨B.b a, hzero a a.2⟩ : H) := by
      apply Subtype.ext
      simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul]
      rw [Finset.sum_attach (B.b.repr (h : L)).support (fun a => B.b.repr (h : L) a • B.b a)]
      exact hh
    have hlam : lam h = ∑ a ∈ (B.b.repr (h : L)).support,
        B.b.repr (h : L) a * B.param lam a := by
      conv_lhs => rw [hhH]
      rw [map_sum, ← Finset.sum_attach (B.b.repr (h : L)).support
        (fun a => B.b.repr (h : L) a * B.param lam a)]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [map_smul, smul_eq_mul]
      simp [param, hzero a a.2]
    have e1 : ι (h : L) = ∑ a ∈ (B.b.repr (h : L)).support, B.b.repr (h : L) a • ι (B.b a) := by
      conv_lhs => rw [hh]
      rw [map_sum]
      exact Finset.sum_congr rfl fun a _ => map_smul _ _ _
    have e2 : algebraMap ℂ U (lam h) = ∑ a ∈ (B.b.repr (h : L)).support,
        B.b.repr (h : L) a • algebraMap ℂ U (B.param lam a) := by
      rw [hlam, map_sum]
      exact Finset.sum_congr rfl fun a _ => by rw [map_mul, ← Algebra.smul_def]
    have hsum : (ι (h : L) - algebraMap ℂ U (lam h)) * v =
        ∑ a ∈ (B.b.repr (h : L)).support,
          B.b.repr (h : L) a • ((ι (B.b a) - algebraMap ℂ U (B.param lam a)) * v) := by
      rw [e1, e2, ← Finset.sum_sub_distrib, Finset.sum_mul]
      exact Finset.sum_congr rfl fun a _ => by rw [← smul_sub, smul_mul_assoc]
    rw [hsum]
    refine Submodule.sum_mem _ fun a ha => Submodule.smul_mem _ _ (Submodule.subset_span ?_)
    have hzero : B.b a ∈ H := by
      by_contra hna
      have hw : B.w a ≠ 0 := fun hw => hna (B.zero a ((B.realWeight_eq_zero_iff a).mpr hw)).1
      exact (Finsupp.mem_support_iff.mp ha) (B.repr_eq_zero_of_mem hab h.2 a hw)
    refine ⟨a, ?_, v, rfl⟩
    by_contra hne
    have hw : B.w a ≠ 0 := fun hw => hne ((B.realWeight_eq_zero_iff a).mpr hw)
    exact (Finsupp.mem_support_iff.mp ha) (B.repr_eq_zero_of_mem hab h.2 a hw)

end SortedWeightBasis

/-- A real-regular element of a split Cartan subalgebra has a sorted weight basis. -/
theorem IsSplitCartan.nonempty_sortedWeightBasis [FiniteDimensional ℂ L] (hC : IsSplitCartan H)
    (hX : IsRealRegular H X) : Nonempty (SortedWeightBasis H X) := by
  obtain ⟨r, b, χ, hb, hline, hanti⟩ := hC.exists_ordered_weight_basis X
  refine ⟨⟨r, b, χ, hb, hanti, fun a ha => ?_, hline⟩⟩
  have hχ : χ a = 0 := by
    by_contra hne
    exact hX (χ a) hne (weightSpace_ne_bot_of_mem (hb a) (b.ne_zero a)) ha
  refine ⟨?_, hχ⟩
  have h0 := hb a
  rw [hχ] at h0
  have h1 : b a ∈ (weightSpace L (0 : H → ℂ) : Submodule ℂ L) := h0
  rw [hC.weightSpace_zero] at h1
  exact h1

end SortedBasis

section Intrinsic

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

local notation "U" => UniversalEnvelopingAlgebra ℂ L
local notation "ι" => UniversalEnvelopingAlgebra.ι ℂ

/-- The coefficient of `1` in a scalar. -/
theorem orderedPBWBasisOf_repr_algebraMap {n : ℕ} (b : Module.Basis (Fin n) ℂ L) (s : ℂ) :
    (orderedPBWBasisOf b).repr (algebraMap ℂ U s) (fun _ => 0) = s := by
  rw [Algebra.algebraMap_eq_smul_one, ← orderedPBWMonomial_zero b, ← orderedPBWBasisOf_apply,
    map_smul, Module.Basis.repr_self, Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul,
    mul_one]

theorem algebraMap_injective_of_basis {n : ℕ} (b : Module.Basis (Fin n) ℂ L) :
    Function.Injective (algebraMap ℂ U) := fun s t h => by
  rw [← orderedPBWBasisOf_repr_algebraMap b s, h, orderedPBWBasisOf_repr_algebraMap]

variable [FiniteDimensional ℂ L] {H : LieSubalgebra ℂ L} (hC : IsSplitCartan H) {X : H}
  (hX : IsRealRegular H X)

include hC hX in
/-- An element commuting with `𝔥` is congruent to a scalar modulo `R_X(λ)`, and along an affine
line of parameters the scalar is a polynomial function of the parameter. -/
theorem exists_polynomial_sub_mem_vermaIdeal (z : U)
    (hz : ∀ h : H, commutatorMap (h : L) z = 0) (lam₀ lam₁ : H →ₗ[ℂ] ℂ) :
    ∃ P : ℂ[X], ∀ t : ℂ, z - algebraMap ℂ U (P.eval t) ∈ vermaIdeal H X (lam₀ + t • lam₁) := by
  obtain ⟨B⟩ := hC.nonempty_sortedWeightBasis hX
  obtain ⟨P, hP⟩ := exists_polynomial_sub_mem_basisVermaIdeal B.b B.w B.lie_eq X B.zero
    B.antitone z hz (B.param lam₀) (B.param lam₁)
  refine ⟨P, fun t => ?_⟩
  rw [← B.basisVermaIdeal_eq hC.isLieAbelian, B.param_add_smul]
  exact hP t

include hC hX in
theorem exists_sub_mem_vermaIdeal (z : U) (hz : ∀ h : H, commutatorMap (h : L) z = 0)
    (lam : H →ₗ[ℂ] ℂ) : ∃ s : ℂ, z - algebraMap ℂ U s ∈ vermaIdeal H X lam := by
  obtain ⟨P, hP⟩ := exists_polynomial_sub_mem_vermaIdeal hC hX z hz lam 0
  exact ⟨P.eval 0, by simpa using hP 0⟩

include hC hX in
/-- A scalar lies in `R_X(λ)` only if it is zero. -/
theorem eq_zero_of_algebraMap_mem_vermaIdeal (lam : H →ₗ[ℂ] ℂ) (s : ℂ)
    (hs : algebraMap ℂ U s ∈ vermaIdeal H X lam) : s = 0 := by
  obtain ⟨B⟩ := hC.nonempty_sortedWeightBasis hX
  rw [← B.basisVermaIdeal_eq hC.isLieAbelian] at hs
  exact eq_zero_of_algebraMap_mem_basisVermaIdeal B.b B.w X B.zero B.antitone B.lie_eq _ s hs

include hC hX in
/-- The scalar congruent to an element modulo `R_X(λ)` is unique. -/
theorem eq_of_sub_mem_vermaIdeal (lam : H →ₗ[ℂ] ℂ) (z : U) {s₁ s₂ : ℂ}
    (h₁ : z - algebraMap ℂ U s₁ ∈ vermaIdeal H X lam)
    (h₂ : z - algebraMap ℂ U s₂ ∈ vermaIdeal H X lam) : s₁ = s₂ := by
  have h : algebraMap ℂ U (s₁ - s₂) ∈ vermaIdeal H X lam := by
    have := Submodule.sub_mem _ h₂ h₁
    rw [map_sub]
    convert this using 1
    abel
  exact sub_eq_zero.mp (eq_zero_of_algebraMap_mem_vermaIdeal hC hX lam _ h)

include hC hX in
/-- An element commuting with `𝔥` that lies in `R_X(λ)` for every `λ` lies in the right ideal
generated by the positive root vectors. -/
theorem mem_generatorRightIdeal_of_forall_mem_vermaIdeal (d : U)
    (hd : ∀ h : H, commutatorMap (h : L) d = 0)
    (hall : ∀ lam : H →ₗ[ℂ] ℂ, d ∈ vermaIdeal H X lam) :
    d ∈ generatorRightIdeal (positiveRootSubmodule H X) := by
  classical
  obtain ⟨B⟩ := hC.nonempty_sortedWeightBasis hX
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp
    (mem_sup_of_commute_of_antitone B.b B.w B.lie_eq X B.antitone d hd)
  have hpos : p ∈ generatorRightIdeal (positiveRootSubmodule H X) := by
    rw [positiveRootSubmodule_eq_span B.b B.w B.mem X, generatorRightIdeal_span_image]
    exact hp
  suffices hq0 : q = 0 by rw [hq0, add_zero]; exact hpos
  have hq' := realZeroGeneratorSubalgebra_le B.b B.w B.lie_eq X hq
  obtain ⟨f, hfsupp, hfq⟩ := (Finsupp.mem_span_image_iff_linearCombination ℂ).mp hq'
  have hval : ∀ c : Fin B.n → ℂ, ∑ e ∈ f.support,
      f e * ∏ i, (if realWeight B.w X i = 0 then c i ^ e i else 1) = 0 := by
    intro c
    let lam : H →ₗ[ℂ] ℂ := (B.b.constr ℂ c).comp H.toSubmodule.subtype
    have hparam : ∀ i, realWeight B.w X i = 0 → B.param lam i = c i := by
      intro i hi
      have hH := (B.zero i hi).1
      simp only [SortedWeightBasis.param, hH, dite_true, lam, LinearMap.comp_apply]
      exact Module.Basis.constr_basis _ _ _ _
    have hmem := hall lam
    rw [← B.basisVermaIdeal_eq hC.isLieAbelian] at hmem
    have h0 := vermaProjection_eq_zero_of_mem_basisVermaIdeal B.b B.w B.lie_eq X (B.param lam)
      B.zero B.antitone hmem
    rw [map_add, vermaProjection_eq_zero_of_mem B.b B.w X _ p
      (realPositiveGeneratorSpan_le B.b B.w B.lie_eq X B.antitone hp), zero_add, ← hfq,
      Finsupp.linearCombination_apply, Finsupp.sum, map_sum] at h0
    apply algebraMap_injective_of_basis B.b
    rw [map_zero, ← h0, map_sum]
    refine Finset.sum_congr rfl fun e he => ?_
    rw [map_smul, orderedPBWBasisOf_apply, vermaProjection_monomial_eq B.b B.w X _ e (hfsupp he),
      map_mul, ← Algebra.smul_def]
    congr 2
    refine Finset.prod_congr rfl fun i _ => ?_
    split_ifs with hi
    · rw [hparam i hi]
    · rfl
  let P : MvPolynomial (Fin B.n) ℂ :=
    ∑ e ∈ f.support, MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm e) (f e)
  have hP : P = 0 := by
    apply MvPolynomial.funext
    intro c
    rw [map_zero, ← hval c]
    simp only [P, map_sum, MvPolynomial.eval_monomial]
    refine Finset.sum_congr rfl fun e he => ?_
    congr 1
    rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [Finsupp.coe_equivFunOnFinite_symm]
    split_ifs with hi
    · rfl
    · have hei : e i = 0 := by
        by_contra hne
        exact hi (hfsupp he i hne)
      rw [hei, pow_zero]
  have hf : ∀ e ∈ f.support, f e = 0 := by
    intro e he
    have h1 := congrArg (fun p : MvPolynomial (Fin B.n) ℂ =>
      p.coeff (Finsupp.equivFunOnFinite.symm e)) hP
    simp only [P, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial] at h1
    rw [Finset.sum_eq_single e] at h1
    · simpa using h1
    · intro e' _ hne
      rw [ite_eq_right_iff]
      intro heq
      exact absurd (Finsupp.equivFunOnFinite.symm.injective heq) hne
    · intro hn
      exact absurd he hn
  rw [← hfq, Finsupp.linearCombination_apply, Finsupp.sum]
  exact Finset.sum_eq_zero fun e he => by rw [hf e he, zero_smul]

end Intrinsic

end Langlands.Algebra.HarishChandra
