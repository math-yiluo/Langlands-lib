import Langlands.Algebra.HarishChandra.RealWeightDecomposition

/-! # The Verma right ideal of a sorted weight basis and its projection

Let `b` be a basis of a complex Lie algebra `𝔤` of simultaneous eigenvectors for an abelian Lie
subalgebra `𝔥`, sorted so that the real weights `Re (w a X)` decrease, and such that the basis
vectors of real weight zero lie in `𝔥`. For scalars `c a` attached to the indices of weight zero,
the right ideal `R` of `U(𝔤)` generated by the generators of positive weight and by the elements
`ι(b a) - c a` with `b a` of weight zero is the annihilator of the highest weight vector of a
(mirror) Verma module. This file constructs the linear projection `π` of `U(𝔤)` onto the span of
the ordered monomials in the generators of negative weight, with `u - π u ∈ R` and `π R = 0`. -/

noncomputable section

universe v

set_option autoImplicit false

namespace Langlands.Algebra.HarishChandra

open Langlands.Algebra.UniversalEnveloping

attribute [local instance 100] LieRing.ofAssociativeRing

section Products

variable {A : Type*} [Ring A] [Algebra ℂ A] (R : Submodule ℂ A)

/-- If left multiplication by `x` acts on `A` as the scalar `s` modulo `R`, and preserves `R`, then
so does left multiplication by `x ^ m`, with the scalar `s ^ m`. -/
theorem pow_mul_sub_smul_mem (x : A) (s : ℂ) (hx : ∀ v : A, x * v - s • v ∈ R)
    (hR : ∀ r ∈ R, x * r ∈ R) : ∀ (m : ℕ) (v : A), x ^ m * v - s ^ m • v ∈ R
  | 0, v => by simp
  | m + 1, v => by
    have h1 := hR _ (pow_mul_sub_smul_mem x s hx hR m v)
    have h2 := R.smul_mem (s ^ m) (hx v)
    have heq : x ^ (m + 1) * v - s ^ (m + 1) • v =
        x * (x ^ m * v - s ^ m • v) + s ^ m • (x * v - s • v) := by
      rw [pow_succ', mul_assoc, mul_sub, mul_smul_comm, smul_sub, smul_smul, pow_succ]
      abel
    rw [heq]
    exact R.add_mem h1 h2

/-- The same for an ordered product of such elements. -/
theorem ofFn_prod_mul_sub_smul_mem : ∀ {m : ℕ} (x : Fin m → A) (s : Fin m → ℂ),
    (∀ j (v : A), x j * v - s j • v ∈ R) → (∀ j, ∀ r ∈ R, x j * r ∈ R) →
      ∀ v : A, (List.ofFn x).prod * v - (∏ j, s j) • v ∈ R
  | 0, _, _, _, _, v => by simp
  | m + 1, x, s, hx, hR, v => by
    rw [List.ofFn_succ, List.prod_cons, Fin.prod_univ_succ, mul_assoc]
    have ih := ofFn_prod_mul_sub_smul_mem (fun j => x j.succ) (fun j => s j.succ)
      (fun j => hx j.succ) (fun j => hR j.succ) v
    have h1 := hR 0 _ ih
    have h2 := R.smul_mem (∏ j : Fin m, s j.succ) (hx 0 v)
    have heq : x 0 * ((List.ofFn fun j => x j.succ).prod * v) -
        (s 0 * ∏ j : Fin m, s j.succ) • v =
        x 0 * ((List.ofFn fun j => x j.succ).prod * v - (∏ j : Fin m, s j.succ) • v) +
          (∏ j : Fin m, s j.succ) • (x 0 * v - s 0 • v) := by
      rw [mul_sub, mul_smul_comm, smul_sub, smul_smul, mul_comm (∏ j : Fin m, s j.succ)]
      abel
    rw [heq]
    exact R.add_mem h1 h2

omit [Algebra ℂ A] in
/-- Inserting a letter into an ordered product of powers, when it commutes with the earlier
letters that occur. -/
theorem mul_ofFn_prod_pow_single : ∀ {m : ℕ} (x : Fin m → A) (e : Fin m → ℕ) (a : Fin m),
    (∀ i, i < a → e i ≠ 0 → x i * x a = x a * x i) →
      x a * (List.ofFn fun i => x i ^ e i).prod =
        (List.ofFn fun i => x i ^ (e i + (Pi.single a 1 : Fin _ → ℕ) i)).prod
  | 0, _, _, a, _ => a.elim0
  | m + 1, x, e, a, h => by
    rw [List.ofFn_succ, List.prod_cons, List.ofFn_succ, List.prod_cons]
    induction a using Fin.cases with
    | zero =>
      have htail : (fun i : Fin m => x i.succ ^ (e i.succ + (Pi.single (0 : Fin (m + 1)) 1 : Fin (m + 1) → ℕ) i.succ)) =
          fun i => x i.succ ^ e i.succ := by
        funext i
        rw [Pi.single_eq_of_ne (Fin.succ_ne_zero i), add_zero]
      rw [htail, Pi.single_eq_same, pow_succ', mul_assoc]
    | succ a =>
      have hcomm : x a.succ * x 0 ^ e 0 = x 0 ^ e 0 * x a.succ := by
        by_cases h0 : e 0 = 0
        · rw [h0, pow_zero, one_mul, mul_one]
        · exact ((Commute.pow_right (h 0 (Fin.succ_pos a) h0).symm (e 0))).eq
      have ih := mul_ofFn_prod_pow_single (fun i => x i.succ) (fun i => e i.succ) a
        (fun i hi hei => h i.succ (Fin.succ_lt_succ_iff.mpr hi) hei)
      have hhead : e 0 + (Pi.single a.succ 1 : Fin (m + 1) → ℕ) 0 = e 0 := by
        rw [Pi.single_eq_of_ne (Fin.succ_ne_zero a).symm, add_zero]
      have htail : (fun i : Fin m => x i.succ ^ (e i.succ + (Pi.single a.succ 1 : Fin (m + 1) → ℕ) i.succ)) =
          fun i => x i.succ ^ (e i.succ + (Pi.single a 1 : Fin _ → ℕ) i) := by
        funext i
        simp only [Pi.single_apply, Fin.succ_inj]
      rw [← mul_assoc, hcomm, mul_assoc, ih, hhead, htail]

end Products

section Verma

open scoped Classical

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

local notation "U" => UniversalEnvelopingAlgebra ℂ L
local notation "ι" => UniversalEnvelopingAlgebra.ι ℂ

theorem realPositiveGeneratorSpan_mul_mem {I : Type*} (b : I → L) (d : I → ℝ) {x : U}
    (hx : x ∈ realPositiveGeneratorSpan b d) (y : U) : x * y ∈ realPositiveGeneratorSpan b d := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, v, rfl⟩ := hx
    rw [mul_assoc]
    exact Submodule.subset_span ⟨a, ha, v * y, rfl⟩
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x x' _ _ h₁ h₂ => rw [add_mul]; exact Submodule.add_mem _ h₁ h₂
  | smul t x _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ t h

variable {H : LieSubalgebra ℂ L} {n : ℕ} (b : Module.Basis (Fin n) ℂ L)
  (w : Fin n → H → ℂ) (hw : ∀ a (h : H), ⁅(h : L), b a⁆ = w a h • b a) (X : H)
  (c : Fin n → ℂ)

/-- The Verma right ideal: generated by the generators of positive real weight and by the
elements `ι(b a) - c a` for the indices of real weight zero. -/
def basisVermaIdeal : Submodule ℂ U :=
  realPositiveGeneratorSpan b (realWeight w X) ⊔
    Submodule.span ℂ {u | ∃ a, realWeight w X a = 0 ∧ ∃ v : U,
      u = (ι (b a) - algebraMap ℂ U (c a)) * v}

theorem basisVermaIdeal_mul_mem {x : U} (hx : x ∈ basisVermaIdeal b w X c) (y : U) :
    x * y ∈ basisVermaIdeal b w X c := by
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hx
  clear hx
  rw [add_mul]
  refine Submodule.add_mem _ (Submodule.mem_sup_left (realPositiveGeneratorSpan_mul_mem _ _ hp y))
    (Submodule.mem_sup_right ?_)
  induction hq using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, v, rfl⟩ := hx
    rw [mul_assoc]
    exact Submodule.subset_span ⟨a, ha, v * y, rfl⟩
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x x' _ _ h₁ h₂ => rw [add_mul]; exact Submodule.add_mem _ h₁ h₂
  | smul t x _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ t h

theorem generator_mul_mem_basisVermaIdeal (a : Fin n) (ha : 0 < realWeight w X a) (v : U) :
    ι (b a) * v ∈ basisVermaIdeal b w X c :=
  Submodule.mem_sup_left (Submodule.subset_span ⟨a, ha, v, rfl⟩)

theorem zero_generator_mul_mem_basisVermaIdeal (a : Fin n) (ha : realWeight w X a = 0) (v : U) :
    (ι (b a) - algebraMap ℂ U (c a)) * v ∈ basisVermaIdeal b w X c :=
  Submodule.mem_sup_right (Submodule.subset_span ⟨a, ha, v, rfl⟩)

variable (hzero : ∀ a, realWeight w X a = 0 → b a ∈ H ∧ w a = 0)

include hw hzero in
theorem zero_letters_commute (a a' : Fin n) (ha : realWeight w X a = 0)
    (ha' : realWeight w X a' = 0) : ι (b a) * ι (b a') = ι (b a') * ι (b a) := by
  have hlie : ⁅b a, b a'⁆ = 0 := by
    have h := hw a' ⟨b a, (hzero a ha).1⟩
    rw [(hzero a' ha').2] at h
    simpa using h
  have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι ℂ (L := L)) (b a) (b a')
  rw [hlie, map_zero, Ring.lie_def] at h
  exact (sub_eq_zero.mp h.symm)

include hw hzero in
/-- Left multiplication by a generator of weight zero preserves the Verma right ideal. -/
theorem zero_generator_mul_mem_of_mem (a : Fin n) (ha : realWeight w X a = 0) {r : U}
    (hr : r ∈ basisVermaIdeal b w X c) : ι (b a) * r ∈ basisVermaIdeal b w X c := by
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hr
  clear hr
  rw [mul_add]
  refine Submodule.add_mem _ ?_ ?_
  · induction hp using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a', ha', v, rfl⟩ := hx
      have hcomm : ι (b a) * ι (b a') = ι (b a') * ι (b a) +
          w a' ⟨b a, (hzero a ha).1⟩ • ι (b a') := by
        have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι ℂ (L := L)) (b a) (b a')
        have hb := hw a' ⟨b a, (hzero a ha).1⟩
        simp only at hb
        rw [hb, map_smul, Ring.lie_def] at h
        rw [h]
        abel
      rw [← mul_assoc, hcomm, add_mul, mul_assoc, smul_mul_assoc]
      exact Submodule.add_mem _ (generator_mul_mem_basisVermaIdeal b w X c a' ha' _)
        (Submodule.smul_mem _ _ (generator_mul_mem_basisVermaIdeal b w X c a' ha' _))
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add x x' _ _ h₁ h₂ => rw [mul_add]; exact Submodule.add_mem _ h₁ h₂
    | smul t x _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ t h
  · induction hq using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a', ha', v, rfl⟩ := hx
      have hcomm : ι (b a) * (ι (b a') - algebraMap ℂ U (c a')) =
          (ι (b a') - algebraMap ℂ U (c a')) * ι (b a) := by
        rw [mul_sub, sub_mul, zero_letters_commute b w hw X hzero a a' ha ha', Algebra.commutes]
      rw [← mul_assoc, hcomm, mul_assoc]
      exact zero_generator_mul_mem_basisVermaIdeal b w X c a' ha' _
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add x x' _ _ h₁ h₂ => rw [mul_add]; exact Submodule.add_mem _ h₁ h₂
    | smul t x _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ t h

/-- The value of the projection on an ordered monomial. -/
def vermaProjectionValue (e : Fin n → ℕ) : U :=
  if ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i then 0 else
    (∏ i, if realWeight w X i = 0 then c i ^ e i else 1) •
      orderedPBWMonomial b (fun i => if realWeight w X i < 0 then e i else 0)

/-- The projection onto the span of the ordered monomials in the generators of negative weight:
monomials with a letter of positive weight go to zero, and the letters of weight zero are replaced
by the scalars `c a`. -/
def vermaProjection : U →ₗ[ℂ] U :=
  (orderedPBWBasisOf b).constr ℂ (vermaProjectionValue b w X c)

theorem vermaProjection_monomial (e : Fin n → ℕ) :
    vermaProjection b w X c (orderedPBWMonomial b e) = vermaProjectionValue b w X c e := by
  rw [← orderedPBWBasisOf_apply, vermaProjection, Module.Basis.constr_basis]

theorem vermaProjection_eq_zero_of_mem (u : U)
    (hu : u ∈ realPositiveLetterSpan b (realWeight w X)) : vermaProjection b w X c u = 0 := by
  induction hu using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨e, he, rfl⟩ := hx
    rw [orderedPBWBasisOf_apply, vermaProjection_monomial, vermaProjectionValue,
      ite_eq_left (show ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i from he)]
  | zero => rw [map_zero]
  | add x y _ _ h₁ h₂ => rw [map_add, h₁, h₂, add_zero]
  | smul t x _ h => rw [map_smul, h, smul_zero]

/-- Ordered monomials with a letter of positive weight lie in the positive right span. -/
theorem monomial_mem_realPositiveGeneratorSpan (hd : Antitone (realWeight w X))
    (e : Fin n → ℕ) (he : ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i) :
    orderedPBWMonomial b e ∈ realPositiveGeneratorSpan b (realWeight w X) := by
  rw [orderedPBWMonomial]
  exact ofFn_prod_pow_mem_span_of_pos_real (fun i => ι (b i)) _ hd e he

theorem realPositiveLetterSpan_le_generatorSpan (hd : Antitone (realWeight w X)) :
    realPositiveLetterSpan b (realWeight w X) ≤ realPositiveGeneratorSpan b (realWeight w X) := by
  rw [realPositiveLetterSpan, Submodule.span_le]
  rintro _ ⟨e, he, rfl⟩
  rw [orderedPBWBasisOf_apply]
  exact monomial_mem_realPositiveGeneratorSpan b w X hd e he

include hw in
theorem vermaProjection_positive_mul (hd : Antitone (realWeight w X)) (a : Fin n)
    (ha : 0 < realWeight w X a) (v : U) : vermaProjection b w X c (ι (b a) * v) = 0 := by
  refine vermaProjection_eq_zero_of_mem b w X c _ ?_
  exact realPositiveGeneratorSpan_le b w hw X hd (Submodule.subset_span ⟨a, ha, v, rfl⟩)

include hw hzero in
theorem vermaProjection_zero_mul_monomial (hd : Antitone (realWeight w X)) (a : Fin n)
    (ha : realWeight w X a = 0) (e : Fin n → ℕ) :
    vermaProjection b w X c ((ι (b a) - algebraMap ℂ U (c a)) * orderedPBWMonomial b e) = 0 := by
  by_cases hpos : ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i
  · refine vermaProjection_eq_zero_of_mem b w X c _ (realPositiveGeneratorSpan_le b w hw X hd ?_)
    have hm := monomial_mem_realPositiveGeneratorSpan b w X hd e hpos
    have hcomm : ι (b a) * orderedPBWMonomial b e = orderedPBWMonomial b e * ι (b a) +
        monomialRootWeight w e ⟨b a, (hzero a ha).1⟩ • orderedPBWMonomial b e := by
      have h := commutatorMap_orderedPBWMonomial b w hw ⟨b a, (hzero a ha).1⟩ e
      rw [commutatorMap_apply] at h
      simp only at h
      rw [← h]
      abel
    rw [sub_mul, hcomm, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
    refine Submodule.sub_mem _ (Submodule.add_mem _ (realPositiveGeneratorSpan_mul_mem _ _ hm _)
      (Submodule.smul_mem _ _ hm)) (Submodule.smul_mem _ _ hm)
  · have hins : ι (b a) * orderedPBWMonomial b e =
        orderedPBWMonomial b (fun i => e i + (Pi.single a 1 : Fin _ → ℕ) i) := by
      rw [orderedPBWMonomial, orderedPBWMonomial]
      refine mul_ofFn_prod_pow_single (fun i => ι (b i)) e a fun i hi hei => ?_
      have hdi : realWeight w X a ≤ realWeight w X i := hd hi.le
      have hdi' : realWeight w X i = 0 := by
        push Not at hpos
        exact le_antisymm (hpos i hei) (ha ▸ hdi)
      exact zero_letters_commute b w hw X hzero i a hdi' ha
    have hpos' : ¬ ∃ i, e i + (Pi.single a 1 : Fin _ → ℕ) i ≠ 0 ∧ 0 < realWeight w X i := by
      rintro ⟨i, hi, hdi⟩
      by_cases hia : i = a
      · subst hia
        exact (lt_irrefl _ (ha ▸ hdi))
      · rw [Pi.single_eq_of_ne hia, add_zero] at hi
        exact hpos ⟨i, hi, hdi⟩
    rw [sub_mul, hins, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul, map_sub, map_smul,
      vermaProjection_monomial, vermaProjection_monomial, vermaProjectionValue,
      vermaProjectionValue, ite_eq_right hpos', ite_eq_right hpos, smul_smul]
    have hneg : (fun i => if realWeight w X i < 0 then e i + (Pi.single a 1 : Fin _ → ℕ) i else 0) =
        fun i => if realWeight w X i < 0 then e i else 0 := by
      funext i
      by_cases hi : realWeight w X i < 0
      · have hia : i ≠ a := fun h => by rw [h, ha] at hi; exact lt_irrefl _ hi
        rw [ite_eq_left hi, ite_eq_left hi, Pi.single_eq_of_ne hia, add_zero]
      · rw [ite_eq_right hi, ite_eq_right hi]
    have hprod : (∏ i, if realWeight w X i = 0 then c i ^ (e i + (Pi.single a 1 : Fin _ → ℕ) i) else 1) =
        c a * ∏ i, if realWeight w X i = 0 then c i ^ e i else 1 := by
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a), ← Finset.mul_prod_erase _ _
        (Finset.mem_univ a), ite_eq_left ha, ite_eq_left ha, Pi.single_eq_same, pow_succ]
      have hrest : (∏ i ∈ Finset.univ.erase a, if realWeight w X i = 0 then
          c i ^ (e i + (Pi.single a 1 : Fin n → ℕ) i) else 1) =
          ∏ i ∈ Finset.univ.erase a, if realWeight w X i = 0 then c i ^ e i else 1 :=
        Finset.prod_congr rfl fun i hi => by
          rw [Pi.single_eq_of_ne (Finset.ne_of_mem_erase hi), add_zero]
      rw [hrest]
      ring
    rw [hneg, hprod, sub_self]

include hw hzero in
/-- The projection vanishes on the Verma right ideal. -/
theorem vermaProjection_eq_zero_of_mem_basisVermaIdeal (hd : Antitone (realWeight w X)) {u : U}
    (hu : u ∈ basisVermaIdeal b w X c) : vermaProjection b w X c u = 0 := by
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hu
  clear hu
  rw [map_add]
  have h1 : vermaProjection b w X c p = 0 :=
    vermaProjection_eq_zero_of_mem b w X c _ (realPositiveGeneratorSpan_le b w hw X hd hp)
  rw [h1, zero_add]
  induction hq using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, v, rfl⟩ := hx
    rw [← (orderedPBWBasisOf b).linearCombination_repr v, Finsupp.linearCombination_apply,
      Finsupp.sum, Finset.mul_sum, map_sum]
    refine Finset.sum_eq_zero fun e _ => ?_
    rw [mul_smul_comm, map_smul, orderedPBWBasisOf_apply,
      vermaProjection_zero_mul_monomial b w hw X c hzero hd a ha e, smul_zero]
  | zero => rw [map_zero]
  | add x y _ _ h₁ h₂ => rw [map_add, h₁, h₂, add_zero]
  | smul t x _ h => rw [map_smul, h, smul_zero]

include hw hzero in
/-- Every element is congruent to its projection modulo the Verma right ideal. -/
theorem sub_vermaProjection_mem (hd : Antitone (realWeight w X)) (u : U) :
    u - vermaProjection b w X c u ∈ basisVermaIdeal b w X c := by
  rw [← (orderedPBWBasisOf b).linearCombination_repr u, Finsupp.linearCombination_apply,
    Finsupp.sum, map_sum, ← Finset.sum_sub_distrib]
  refine Submodule.sum_mem _ fun e _ => ?_
  rw [map_smul, ← smul_sub]
  refine Submodule.smul_mem _ _ ?_
  rw [orderedPBWBasisOf_apply, vermaProjection_monomial, vermaProjectionValue]
  by_cases hpos : ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i
  · rw [ite_eq_left hpos, sub_zero]
    exact Submodule.mem_sup_left (monomial_mem_realPositiveGeneratorSpan b w X hd e hpos)
  · rw [ite_eq_right hpos]
    let e₁ : Fin n → ℕ := fun i => if realWeight w X i = 0 then e i else 0
    let e₂ : Fin n → ℕ := fun i => if realWeight w X i < 0 then e i else 0
    have hord : ∀ i j, e₁ i ≠ 0 → e₂ j ≠ 0 → i < j := by
      intro i j hi hj
      have hdi : realWeight w X i = 0 := by
        by_contra h
        simp [e₁, h] at hi
      have hdj : realWeight w X j < 0 := by
        by_contra h
        simp [e₂, h] at hj
      by_contra hij
      have := hd (not_lt.mp hij)
      linarith
    have hsplit : orderedPBWMonomial b e = orderedPBWMonomial b e₁ * orderedPBWMonomial b e₂ := by
      rw [orderedPBWMonomial, orderedPBWMonomial, orderedPBWMonomial,
        ← ofFn_prod_pow_add _ e₁ e₂ hord]
      congr 1
      refine congrArg List.ofFn (funext fun i => ?_)
      push Not at hpos
      by_cases h0 : realWeight w X i = 0
      · have h1 : ¬ realWeight w X i < 0 := by rw [h0]; exact lt_irrefl 0
        simp [e₁, e₂, h0]
      · by_cases hn : realWeight w X i < 0
        · simp [e₁, e₂, h0, hn]
        · have hei : e i = 0 := by
            by_contra hei
            exact hn (lt_of_le_of_ne (hpos i hei) h0)
          simp [e₁, e₂, h0, hn, hei]
    have hzmul := ofFn_prod_mul_sub_smul_mem (basisVermaIdeal b w X c)
      (fun i => ι (b i) ^ e₁ i) (fun i => if realWeight w X i = 0 then c i ^ e i else 1)
      (fun i v => by
        by_cases h0 : realWeight w X i = 0
        · simp only [e₁, ite_eq_left h0]
          refine pow_mul_sub_smul_mem _ (ι (b i)) (c i) (fun v => ?_)
            (fun r hr => zero_generator_mul_mem_of_mem b w hw X c hzero i h0 hr) (e i) v
          rw [Algebra.smul_def, ← sub_mul]
          exact zero_generator_mul_mem_basisVermaIdeal b w X c i h0 v
        · simp only [e₁, ite_eq_right h0, pow_zero, one_mul, one_smul, sub_self]
          exact Submodule.zero_mem _)
      (fun i r hr => by
        by_cases h0 : realWeight w X i = 0
        · simp only [e₁, ite_eq_left h0]
          induction e i with
          | zero => rwa [pow_zero, one_mul]
          | succ m ih =>
            rw [pow_succ', mul_assoc]
            exact zero_generator_mul_mem_of_mem b w hw X c hzero i h0 ih
        · simp only [e₁, ite_eq_right h0, pow_zero, one_mul]
          exact hr)
      (orderedPBWMonomial b e₂)
    rw [hsplit]
    exact hzmul

/-- An ordered monomial in the generators of negative weight is fixed by the projection. -/
theorem vermaProjection_monomial_of_neg (e : Fin n → ℕ)
    (he : ∀ i, e i ≠ 0 → realWeight w X i < 0) :
    vermaProjection b w X c (orderedPBWMonomial b e) = orderedPBWMonomial b e := by
  have hpos : ¬ ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i := by
    rintro ⟨i, hi, hdi⟩
    exact lt_asymm hdi (he i hi)
  rw [vermaProjection_monomial, vermaProjectionValue, ite_eq_right hpos]
  have hprod : (∏ i, if realWeight w X i = 0 then c i ^ e i else (1 : ℂ)) = 1 := by
    refine Finset.prod_eq_one fun i _ => ?_
    by_cases h0 : realWeight w X i = 0
    · have hei : e i = 0 := by
        by_contra hei
        have := he i hei
        rw [h0] at this
        exact lt_irrefl 0 this
      rw [ite_eq_left h0, hei, pow_zero]
    · rw [ite_eq_right h0]
  have hneg : (fun i => if realWeight w X i < 0 then e i else 0) = e := by
    funext i
    by_cases hi : realWeight w X i < 0
    · rw [ite_eq_left hi]
    · rw [ite_eq_right hi]
      by_contra hei
      exact hi (he i (Ne.symm hei))
  rw [hprod, one_smul, hneg]

/-- The span of the ordered monomials in the generators of negative weight. -/
def realNegativeLetterSpan : Submodule ℂ U :=
  Submodule.span ℂ ((orderedPBWBasisOf b) '' {e | ∀ i, e i ≠ 0 → realWeight w X i < 0})

theorem vermaProjection_of_mem_realNegativeLetterSpan {u : U}
    (hu : u ∈ realNegativeLetterSpan b w X) : vermaProjection b w X c u = u := by
  induction hu using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨e, he, rfl⟩ := hx
    rw [orderedPBWBasisOf_apply]
    exact vermaProjection_monomial_of_neg b w X c e he
  | zero => rw [map_zero]
  | add x y _ _ h₁ h₂ => rw [map_add, h₁, h₂]
  | smul t x _ h => rw [map_smul, h]

include hw hzero in
/-- A nonzero element of the span of the monomials in the generators of negative weight is not in
the Verma right ideal. -/
theorem not_mem_basisVermaIdeal (hd : Antitone (realWeight w X)) {u : U}
    (hu : u ∈ realNegativeLetterSpan b w X) (hne : u ≠ 0) : u ∉ basisVermaIdeal b w X c := by
  intro hmem
  apply hne
  rw [← vermaProjection_of_mem_realNegativeLetterSpan b w X c hu]
  exact vermaProjection_eq_zero_of_mem_basisVermaIdeal b w hw X c hzero hd hmem

end Verma

end Langlands.Algebra.HarishChandra
