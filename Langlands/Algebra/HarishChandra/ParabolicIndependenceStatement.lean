import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Lie.Weights.Basic
import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.LinearAlgebra.Trace
import Mathlib.Basic.Complex.Basic

/-! # Independence of the parabolic for the normalized Levi component of central elements

For a complex Lie algebra `𝔤` with a split Cartan subalgebra `𝔥`, an element `X ∈ 𝔥` whose root
values are integers defines the Levi subalgebra `𝔪 = ker ad X` and the nilradical `𝔳` spanned by
the positive eigenspaces of `ad X`. A central element `z` of `U(𝔤)` is congruent modulo the right
ideal `𝔳 · U(𝔤)` to an element of `U(𝔪)`. This file states that after the shift
`Y ↦ Y + ρ_𝔳(Y)`, with `ρ_𝔳(Y) = ½ tr(ad Y | 𝔳)`, that element does not depend on `X`, among the
`X` with the same centralizer. -/

noncomputable section

universe v w

set_option autoImplicit false

namespace Langlands.Algebra.HarishChandra

open LieModule

attribute [local instance 100] LieRing.ofAssociativeRing

section Definitions

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

/-- A split Cartan subalgebra `𝔥` of a complex Lie algebra `𝔤`: `𝔥` is abelian, `ad 𝔥` is
diagonalizable on `𝔤` with zero weight space `𝔥`, every root space is a line, every root `α`
has an `𝔰𝔩₂`-triple `e ∈ 𝔤_α`, `f ∈ 𝔤_{-α}`, `[e, f] = h ∈ 𝔥` with `α(h) = 2`, and the only
nonzero multiples of a root that are roots are `±α`. -/
structure IsSplitCartan (H : LieSubalgebra ℂ L) : Prop where
  isLieAbelian : IsLieAbelian H
  iSup_weightSpace_eq_top : ⨆ χ : H → ℂ, weightSpace L χ = ⊤
  weightSpace_zero : (weightSpace L (0 : H → ℂ) : Submodule ℂ L) = H.toSubmodule
  finrank_weightSpace : ∀ χ : H → ℂ, χ ≠ 0 → weightSpace L χ ≠ ⊥ →
    Module.finrank ℂ (weightSpace L χ) = 1
  exists_sl2 : ∀ χ : H → ℂ, χ ≠ 0 → weightSpace L χ ≠ ⊥ →
    ∃ e ∈ weightSpace L χ, ∃ f ∈ weightSpace L (-χ), ∃ h : H, ⁅e, f⁆ = (h : L) ∧ χ h = 2
  reduced : ∀ χ : H → ℂ, χ ≠ 0 → weightSpace L χ ≠ ⊥ → ∀ c : ℂ, c ≠ 0 →
    weightSpace L (c • χ) ≠ ⊥ → c = 1 ∨ c = -1

/-- The sum of the eigenspaces of `ad X` for the positive integer eigenvalues. -/
def positiveEigenSubmodule (X : L) : Submodule ℂ L :=
  ⨆ (n : ℕ) (_ : 0 < n), (LieAlgebra.ad ℂ L X).eigenspace (n : ℂ)

/-- The right ideal `𝔳 · U(𝔤)` of the enveloping algebra generated by a subspace `𝔳`. -/
def generatorRightIdeal (V : Submodule ℂ L) : Submodule ℂ (UniversalEnvelopingAlgebra ℂ L) :=
  Submodule.span ℂ {a | ∃ x ∈ V, ∃ b : UniversalEnvelopingAlgebra ℂ L,
    a = UniversalEnvelopingAlgebra.ι ℂ x * b}

end Definitions

section Shift

variable {M : Type w} [LieRing M] [LieAlgebra ℂ M]

/-- The Lie map `Y ↦ ι Y + λ(Y)` into the enveloping algebra, for a linear form `λ` vanishing on
brackets. -/
def scalarShiftLie (lam : M →ₗ[ℂ] ℂ) (hlam : ∀ Y Y' : M, lam ⁅Y, Y'⁆ = 0) :
    M →ₗ⁅ℂ⁆ UniversalEnvelopingAlgebra ℂ M :=
  { (UniversalEnvelopingAlgebra.ι ℂ).toLinearMap +
      (Algebra.linearMap ℂ (UniversalEnvelopingAlgebra ℂ M)).comp lam with
    map_lie' := by
      intro Y Y'
      simp only [AddHom.toFun_eq_coe, LinearMap.coe_toAddHom, LinearMap.add_apply,
        LieHom.coe_toLinearMap, LinearMap.coe_comp, Function.comp_apply,
        Algebra.linearMap_apply]
      rw [hlam, map_zero, add_zero, LieHom.map_lie, Ring.lie_def, Ring.lie_def]
      set a := UniversalEnvelopingAlgebra.ι ℂ Y
      set b := UniversalEnvelopingAlgebra.ι ℂ Y'
      set p := algebraMap ℂ (UniversalEnvelopingAlgebra ℂ M) (lam Y)
      set q := algebraMap ℂ (UniversalEnvelopingAlgebra ℂ M) (lam Y')
      have h₁ : a * q = q * a := (Algebra.commutes _ a).symm
      have h₂ : p * b = b * p := Algebra.commutes _ b
      have h₃ : p * q = q * p := Algebra.commutes _ q
      simp only [add_mul, mul_add]
      rw [h₁, h₂, h₃]
      abel }

/-- The algebra endomorphism of `U(𝔪)` extending `Y ↦ Y + λ(Y)`. -/
def scalarShift (lam : M →ₗ[ℂ] ℂ) (hlam : ∀ Y Y' : M, lam ⁅Y, Y'⁆ = 0) :
    UniversalEnvelopingAlgebra ℂ M →ₐ[ℂ] UniversalEnvelopingAlgebra ℂ M :=
  UniversalEnvelopingAlgebra.lift ℂ (scalarShiftLie lam hlam)

end Shift

/-- Independence of the parabolic for the normalized Levi component of central elements
(Knapp–Vogan, Proposition 4.129 (c), mirrored to right ideals). Let `𝔥` be a split Cartan
subalgebra of a finite-dimensional complex Lie algebra `𝔤`, and let `X₁, X₂ ∈ 𝔥` take integer
values on all roots and vanish on the same roots. Let `ι : 𝔪 → 𝔤` be an injective Lie algebra
map onto the centralizer `ker ad X₁`, and `𝔳ᵢ` the sum of the positive eigenspaces of `ad Xᵢ`.
Let `λᵢ` be linear forms on `𝔪` vanishing on brackets with
`2 λᵢ(Y) = tr(ad ι(Y) | 𝔳ᵢ)`. If `z` is central in `U(𝔤)` and `yᵢ ∈ U(𝔪)` satisfy
`z - ι(yᵢ) ∈ 𝔳ᵢ · U(𝔤)`, then the shifts of `y₁` by `λ₁` and of `y₂` by `λ₂` agree. -/
def ParabolicIndependenceStatement : Prop :=
  ∀ (L : Type v) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L] (H : LieSubalgebra ℂ L),
    IsSplitCartan H →
    ∀ (M : Type w) [LieRing M] [LieAlgebra ℂ M] (ι : M →ₗ⁅ℂ⁆ L) (X₁ X₂ : H),
      (∀ χ : H → ℂ, weightSpace L χ ≠ ⊥ →
        (∃ n : ℤ, χ X₁ = n) ∧ (∃ n : ℤ, χ X₂ = n) ∧ (χ X₁ = 0 ↔ χ X₂ = 0)) →
      Function.Injective ι → LinearMap.range ι.toLinearMap = LinearMap.ker (LieAlgebra.ad ℂ L X₁) →
      ∀ (lam₁ lam₂ : M →ₗ[ℂ] ℂ) (hlam₁ : ∀ Y Y' : M, lam₁ ⁅Y, Y'⁆ = 0)
        (hlam₂ : ∀ Y Y' : M, lam₂ ⁅Y, Y'⁆ = 0),
      (∀ (Y : M) (hY : Set.MapsTo (LieAlgebra.ad ℂ L (ι Y))
          (positiveEigenSubmodule (X₁ : L)) (positiveEigenSubmodule (X₁ : L))),
        2 * lam₁ Y = LinearMap.trace ℂ _ ((LieAlgebra.ad ℂ L (ι Y)).restrict hY)) →
      (∀ (Y : M) (hY : Set.MapsTo (LieAlgebra.ad ℂ L (ι Y))
          (positiveEigenSubmodule (X₂ : L)) (positiveEigenSubmodule (X₂ : L))),
        2 * lam₂ Y = LinearMap.trace ℂ _ ((LieAlgebra.ad ℂ L (ι Y)).restrict hY)) →
      ∀ (z : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L))
        (y₁ y₂ : UniversalEnvelopingAlgebra ℂ M),
        (z : UniversalEnvelopingAlgebra ℂ L) -
            UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp ι) y₁ ∈
          generatorRightIdeal (positiveEigenSubmodule (X₁ : L)) →
        (z : UniversalEnvelopingAlgebra ℂ L) -
            UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp ι) y₂ ∈
          generatorRightIdeal (positiveEigenSubmodule (X₂ : L)) →
        scalarShift lam₁ hlam₁ y₁ = scalarShift lam₂ hlam₂ y₂

end Langlands.Algebra.HarishChandra
