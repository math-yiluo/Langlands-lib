import Langlands.Algebra.EnvelopingFixedWeightDecomposition
import Mathlib.Data.Fin.Tuple.Sort
import Mathlib.Basic.Complex.Basic

/-! # Elements of an enveloping algebra commuting with a family of weight operators

Let `𝔤` be a complex Lie algebra with a basis `b` of simultaneous eigenvectors of `ad h` for the
elements `h` of a Lie subalgebra `𝔥`, with weights `w a : 𝔥 → ℂ`. For a fixed `X ∈ 𝔥` give each
basis vector the real weight `Re (w a X)`. Every element of `U(𝔤)` that commutes with `𝔥` lies in
the sum of the right ideal generated by the basis vectors of positive real weight and the
subalgebra generated by those of real weight zero, and this sum is direct. -/

noncomputable section

universe v

set_option autoImplicit false

namespace Langlands.Algebra.HarishChandra

open Langlands.Algebra.UniversalEnveloping

attribute [local instance 100] LieRing.ofAssociativeRing

section RealProducts

variable {k : Type*} [Field k] {A : Type*} [Ring A] [Algebra k A]

/-- An ordered product of powers with a letter of positive real weight begins with a letter of
positive real weight, for weights decreasing along the order. -/
theorem ofFn_prod_pow_mem_span_of_pos_real : ∀ {n : ℕ} (x : Fin n → A) (d : Fin n → ℝ),
    Antitone d → ∀ (e : Fin n → ℕ), (∃ i, e i ≠ 0 ∧ 0 < d i) →
      (List.ofFn fun i => x i ^ e i).prod ∈
        Submodule.span k {u | ∃ a, 0 < d a ∧ ∃ v : A, u = x a * v}
  | 0, _, _, _, _, ⟨i, _⟩ => i.elim0
  | n + 1, x, d, hd, e, ⟨i, hei, hdi⟩ => by
    rw [List.ofFn_succ, List.prod_cons]
    by_cases he0 : e 0 = 0
    · rw [he0, pow_zero, one_mul]
      induction i using Fin.cases with
      | zero => exact absurd he0 hei
      | succ j =>
        have hd' : Antitone (fun i : Fin n => d i.succ) :=
          hd.comp_monotone (Fin.strictMono_succ.monotone)
        refine Submodule.span_mono ?_ (ofFn_prod_pow_mem_span_of_pos_real (fun i => x i.succ)
          (fun i => d i.succ) hd' (fun i => e i.succ) ⟨j, hei, hdi⟩)
        rintro u ⟨a, ha, v, rfl⟩
        exact ⟨a.succ, ha, v, rfl⟩
    · have h0 : 0 < d 0 := lt_of_lt_of_le hdi (hd (Fin.zero_le i))
      obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero he0
      rw [hm, pow_succ', mul_assoc]
      exact Submodule.subset_span ⟨0, h0, _, rfl⟩

/-- If the total real weight vanishes and no letter of positive weight occurs, every occurring
letter has weight zero. -/
theorem weight_eq_zero_of_sum_eq_zero_real {n : ℕ} (d : Fin n → ℝ) (e : Fin n → ℕ)
    (hsum : ∑ i, (e i : ℝ) * d i = 0) (hpos : ¬ ∃ i, e i ≠ 0 ∧ 0 < d i) :
    ∀ i, e i ≠ 0 → d i = 0 := by
  push Not at hpos
  have hle : ∀ i ∈ (Finset.univ : Finset (Fin n)), (e i : ℝ) * d i ≤ 0 := by
    intro i _
    by_cases hei : e i = 0
    · simp [hei]
    · exact mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) (hpos i hei)
  have hzero := (Finset.sum_eq_zero_iff_of_nonpos hle).mp hsum
  intro i hei
  have hi := hzero i (Finset.mem_univ i)
  rcases mul_eq_zero.mp hi with h | h
  · exact absurd (by exact_mod_cast h) hei
  · exact h

end RealProducts

section Commutator

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

local notation "U" => UniversalEnvelopingAlgebra ℂ L
local notation "ι" => UniversalEnvelopingAlgebra.ι ℂ

/-- The commutator with a generator, `u ↦ ι(x) u - u ι(x)`, as a linear endomorphism of `U(𝔤)`. -/
def commutatorMap (x : L) : U →ₗ[ℂ] U :=
  LinearMap.mulLeft ℂ (ι x) - LinearMap.mulRight ℂ (ι x)

theorem commutatorMap_apply (x : L) (u : U) : commutatorMap x u = ι x * u - u * ι x := rfl

theorem commutatorMap_mul (x : L) (u v : U) :
    commutatorMap x (u * v) = commutatorMap x u * v + u * commutatorMap x v := by
  simp only [commutatorMap_apply]
  noncomm_ring

theorem commutatorMap_ι (x y : L) : commutatorMap x (ι y) = ι ⁅x, y⁆ := by
  rw [commutatorMap_apply, LieHom.map_lie, Ring.lie_def]

theorem commutatorMap_pow (x : L) (u : U) (s : ℂ) (hu : commutatorMap x u = s • u) :
    ∀ m : ℕ, commutatorMap x (u ^ m) = ((m : ℂ) * s) • u ^ m
  | 0 => by simp [commutatorMap_apply]
  | m + 1 => by
    rw [pow_succ, commutatorMap_mul, commutatorMap_pow x u s hu m, hu, smul_mul_assoc,
      mul_smul_comm, ← add_smul]
    congr 1
    push_cast
    ring

theorem commutatorMap_ofFn_prod (x : L) : ∀ {n : ℕ} (y : Fin n → U) (s : Fin n → ℂ),
    (∀ i, commutatorMap x (y i) = s i • y i) →
      commutatorMap x (List.ofFn y).prod = (∑ i, s i) • (List.ofFn y).prod
  | 0, _, _, _ => by simp [commutatorMap_apply]
  | n + 1, y, s, h => by
    rw [List.ofFn_succ, List.prod_cons, commutatorMap_mul, h 0,
      commutatorMap_ofFn_prod x (fun i => y i.succ) (fun i => s i.succ) (fun i => h i.succ),
      Fin.sum_univ_succ, smul_mul_assoc, mul_smul_comm, ← add_smul]

variable {H : LieSubalgebra ℂ L} {n : ℕ} (b : Module.Basis (Fin n) ℂ L) (w : Fin n → H → ℂ)
  (hw : ∀ a (h : H), ⁅(h : L), b a⁆ = w a h • b a)

/-- The weight of an exponent vector, as a function on `𝔥`. -/
def monomialRootWeight (e : Fin n → ℕ) : H → ℂ := fun h => ∑ i, (e i : ℂ) * w i h

include hw in
theorem commutatorMap_orderedPBWMonomial (h : H) (e : Fin n → ℕ) :
    commutatorMap (h : L) (orderedPBWMonomial b e) =
      monomialRootWeight w e h • orderedPBWMonomial b e := by
  rw [orderedPBWMonomial]
  refine commutatorMap_ofFn_prod (h : L) _ (fun i => (e i : ℂ) * w i h) fun i => ?_
  refine commutatorMap_pow (h : L) _ (w i h) ?_ (e i)
  rw [commutatorMap_ι, hw, map_smul]

include hw in
/-- Coordinates of a commutator with an element of `𝔥` in the ordered monomial basis. -/
theorem orderedPBWBasisOf_repr_commutatorMap (h : H) (u : U) (e : Fin n → ℕ) :
    (orderedPBWBasisOf b).repr (commutatorMap (h : L) u) e =
      monomialRootWeight w e h * (orderedPBWBasisOf b).repr u e := by
  have hlin : (orderedPBWBasisOf b).coord e ∘ₗ commutatorMap (h : L) =
      monomialRootWeight w e h • (orderedPBWBasisOf b).coord e := by
    refine (orderedPBWBasisOf b).ext fun f => ?_
    change (orderedPBWBasisOf b).coord e (commutatorMap (h : L) (orderedPBWBasisOf b f)) =
      monomialRootWeight w e h • (orderedPBWBasisOf b).coord e (orderedPBWBasisOf b f)
    rw [orderedPBWBasisOf_apply, commutatorMap_orderedPBWMonomial b w hw, ←
      orderedPBWBasisOf_apply, map_smul]
    obtain rfl | hne := eq_or_ne f e
    · rfl
    · have h0 : (orderedPBWBasisOf b).coord e (orderedPBWBasisOf b f) = 0 := by
        rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_of_ne' hne]
      rw [h0, smul_zero, smul_zero]
  exact LinearMap.congr_fun hlin u

include hw in
/-- The monomials in the support of a weight vector of `U(𝔤)` have its weight. -/
theorem monomialRootWeight_eq_of_mem_support (u : U) (μ : H → ℂ)
    (hu : ∀ h : H, commutatorMap (h : L) u = μ h • u) (e : Fin n → ℕ)
    (he : e ∈ ((orderedPBWBasisOf b).repr u).support) :
    monomialRootWeight w e = μ := by
  funext h
  have h1 := orderedPBWBasisOf_repr_commutatorMap b w hw h u e
  rw [hu, map_smul, Finsupp.smul_apply, smul_eq_mul] at h1
  exact (mul_right_cancel₀ (Finsupp.mem_support_iff.mp he) h1).symm

include hw in
theorem repr_lie_basis (h : H) (x : L) (i : Fin n) :
    b.repr ⁅(h : L), x⁆ i = w i h * b.repr x i := by
  have hlin : b.coord i ∘ₗ (LieAlgebra.ad ℂ L (h : L)) = w i h • b.coord i := by
    refine b.ext fun j => ?_
    change b.coord i ⁅(h : L), b j⁆ = w i h • b.coord i (b j)
    rw [hw, map_smul]
    obtain rfl | hne := eq_or_ne j i
    · rfl
    · have h0 : b.coord i (b j) = 0 := by
        rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_of_ne' hne]
      rw [h0, smul_zero, smul_zero]
  exact LinearMap.congr_fun hlin x

include hw in
/-- A simultaneous eigenvector of `ad 𝔥` lies in the span of the basis vectors of its weight. -/
theorem mem_span_of_rootEigen (μ : H → ℂ) (x : L) (hx : ∀ h : H, ⁅(h : L), x⁆ = μ h • x) :
    x ∈ Submodule.span ℂ (b '' {i | w i = μ}) := by
  rw [← b.linearCombination_repr x, Finsupp.linearCombination_apply, Finsupp.sum]
  refine Submodule.sum_mem _ fun i hi => ?_
  refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, ?_, rfl⟩)
  funext h
  have h1 := repr_lie_basis b w hw h x i
  rw [hx, map_smul, Finsupp.smul_apply, smul_eq_mul] at h1
  exact (mul_right_cancel₀ (Finsupp.mem_support_iff.mp hi) h1).symm

include hw in
/-- Brackets of basis vectors add weights. -/
theorem lie_mem_span_rootWeight (a a' : Fin n) :
    ⁅b a, b a'⁆ ∈ Submodule.span ℂ (b '' {i | w i = w a + w a'}) := by
  refine mem_span_of_rootEigen b w hw _ _ fun h => ?_
  rw [leibniz_lie, hw, hw, smul_lie, lie_smul, ← add_smul, Pi.add_apply]

end Commutator

section RealWeights

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

local notation "U" => UniversalEnvelopingAlgebra ℂ L
local notation "ι" => UniversalEnvelopingAlgebra.ι ℂ

section Spans

variable {I : Type*} (b : I → L) (d : I → ℝ)

/-- The right ideal of `U(𝔤)` generated by the generators of positive real weight. -/
def realPositiveGeneratorSpan : Submodule ℂ U :=
  Submodule.span ℂ {u | ∃ a, 0 < d a ∧ ∃ v : U, u = ι (b a) * v}

/-- The subalgebra of `U(𝔤)` generated by the generators of real weight zero. -/
def realZeroGeneratorSubalgebra : Subalgebra ℂ U :=
  Algebra.adjoin ℂ {u | ∃ a, d a = 0 ∧ u = ι (b a)}

end Spans

variable {H : LieSubalgebra ℂ L} {n : ℕ} (b : Module.Basis (Fin n) ℂ L) (w : Fin n → H → ℂ)
  (hw : ∀ a (h : H), ⁅(h : L), b a⁆ = w a h • b a) (X : H)

/-- The real weight `Re (w a X)` of a basis index. -/
def realWeight (a : Fin n) : ℝ := (w a X).re

theorem realWeight_sum (e : Fin n → ℕ) :
    (monomialRootWeight w e X).re = ∑ i, (e i : ℝ) * realWeight w X i := by
  simp only [monomialRootWeight, Complex.re_sum, realWeight]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← Complex.ofReal_natCast, Complex.re_ofReal_mul]

/-- The span of the ordered monomials having a letter of positive real weight. -/
def realPositiveLetterSpan (d : Fin n → ℝ) : Submodule ℂ U :=
  Submodule.span ℂ ((orderedPBWBasisOf b) '' {e | ∃ i, e i ≠ 0 ∧ 0 < d i})

/-- The span of the ordered monomials all of whose letters have real weight zero. -/
def realZeroLetterSpan (d : Fin n → ℝ) : Submodule ℂ U :=
  Submodule.span ℂ ((orderedPBWBasisOf b) '' {e | ∀ i, e i ≠ 0 → d i = 0})

theorem realPositiveLetterSpan_inf_realZeroLetterSpan (d : Fin n → ℝ) :
    realPositiveLetterSpan b d ⊓ realZeroLetterSpan b d = ⊥ := by
  rw [eq_bot_iff]
  intro y ⟨hP, hZ⟩
  rw [Submodule.mem_bot]
  apply (orderedPBWBasisOf b).repr.injective
  ext e
  rw [map_zero, Finsupp.zero_apply]
  by_cases h : ∃ i, e i ≠ 0 ∧ 0 < d i
  · obtain ⟨i, hi, hdi⟩ := h
    exact repr_eq_zero_of_mem_span _ _ hZ fun he => (he i hi ▸ hdi).false
  · exact repr_eq_zero_of_mem_span _ _ hP h

include hw in
theorem lie_mem_span_realPos (a a' : Fin n) (ha : 0 < realWeight w X a)
    (ha' : 0 < realWeight w X a') :
    ⁅b a, b a'⁆ ∈ Submodule.span ℂ (b '' {i | 0 < realWeight w X i}) := by
  refine Submodule.span_mono (Set.image_mono fun i (hi : w i = w a + w a') => ?_)
    (lie_mem_span_rootWeight b w hw a a')
  change 0 < realWeight w X i
  rw [realWeight, hi, Pi.add_apply, Complex.add_re]
  exact add_pos ha ha'

include hw in
theorem lie_mem_span_realZero (a a' : Fin n) (ha : realWeight w X a = 0)
    (ha' : realWeight w X a' = 0) :
    ⁅b a, b a'⁆ ∈ Submodule.span ℂ (b '' {i | realWeight w X i = 0}) := by
  refine Submodule.span_mono (Set.image_mono fun i (hi : w i = w a + w a') => ?_)
    (lie_mem_span_rootWeight b w hw a a')
  change realWeight w X i = 0
  rw [realWeight, hi, Pi.add_apply, Complex.add_re]
  exact (congrArg₂ (· + ·) ha ha').trans (add_zero 0)

include hw in
theorem realZeroGeneratorSubalgebra_le :
    (realZeroGeneratorSubalgebra b (realWeight w X)).toSubmodule ≤
      realZeroLetterSpan b (realWeight w X) :=
  adjoin_le_span_orderedPBWBasisOf b (fun a => realWeight w X a = 0)
    (fun a a' ha ha' => lie_mem_span_realZero b w hw X a a' ha ha')

include hw in
/-- Left multiplication by a generator of positive real weight keeps a monomial in the span of
the monomials with a letter of positive real weight, for weights decreasing along the order. -/
theorem generator_mul_mem_realPositiveLetterSpan (hd : Antitone (realWeight w X)) (a : Fin n)
    (ha : 0 < realWeight w X a) (e : Fin n → ℕ) :
    ι (b a) * orderedPBWMonomial b e ∈ realPositiveLetterSpan b (realWeight w X) := by
  classical
  set d := realWeight w X with hd_def
  let e₁ : Fin n → ℕ := fun i => if 0 < d i then e i else 0
  let e₂ : Fin n → ℕ := fun i => if 0 < d i then 0 else e i
  have hord (f : Fin n → ℕ) (hf : ∀ i, f i ≠ 0 → 0 < d i) :
      ∀ i j, f i ≠ 0 → e₂ j ≠ 0 → i < j := by
    intro i j hi hj
    have hdi := hf i hi
    have hdj : ¬ 0 < d j := by
      intro h
      simp [e₂, h] at hj
    by_contra hij
    exact hdj (lt_of_lt_of_le hdi (hd (not_lt.mp hij)))
  have he₁ : ∀ i, e₁ i ≠ 0 → 0 < d i := by
    intro i hi
    by_contra h
    simp [e₁, h] at hi
  have hsplit : orderedPBWMonomial b e = orderedPBWMonomial b e₁ * orderedPBWMonomial b e₂ := by
    rw [orderedPBWMonomial, orderedPBWMonomial, orderedPBWMonomial,
      ← ofFn_prod_pow_add _ e₁ e₂ (hord e₁ he₁)]
    congr 1
    refine congrArg List.ofFn (funext fun i => ?_)
    by_cases h : 0 < d i <;> simp [e₁, e₂, h]
  let x := ι (b a) * orderedPBWMonomial b e₁
  have hx_adj : x ∈ Algebra.adjoin ℂ {u | ∃ a, 0 < d a ∧ u = ι (b a)} :=
    Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨a, ha, rfl⟩)
      (ofFn_prod_pow_mem_adjoin _ (fun a => 0 < d a) e₁ he₁)
  have hx_span : x ∈ Submodule.span ℂ ((orderedPBWBasisOf b) '' {f | ∀ i, f i ≠ 0 → 0 < d i}) :=
    adjoin_le_span_orderedPBWBasisOf b (fun a => 0 < d a)
      (fun a a' ha ha' => lie_mem_span_realPos b w hw X a a' ha ha') hx_adj
  have hcx (h : H) : commutatorMap (h : L) x = (w a h + monomialRootWeight w e₁ h) • x := by
    simp only [x, commutatorMap_mul, commutatorMap_ι, hw, map_smul,
      commutatorMap_orderedPBWMonomial b w hw, smul_mul_assoc, mul_smul_comm, add_smul]
  have hw₁ : 0 ≤ (monomialRootWeight w e₁ X).re := by
    rw [realWeight_sum]
    refine Finset.sum_nonneg fun i _ => ?_
    by_cases h : e₁ i = 0
    · simp [h]
    · exact mul_nonneg (Nat.cast_nonneg _) (he₁ i h).le
  have hsupport (f : Fin n → ℕ) (hf : f ∈ ((orderedPBWBasisOf b).repr x).support) :
      (∀ i, f i ≠ 0 → 0 < d i) ∧ ∃ i, f i ≠ 0 ∧ 0 < d i := by
    have hne := Finsupp.mem_support_iff.mp hf
    have hpos : ∀ i, f i ≠ 0 → 0 < d i := by
      by_contra h
      exact hne (repr_eq_zero_of_mem_span _ _ hx_span h)
    refine ⟨hpos, ?_⟩
    have hwf := monomialRootWeight_eq_of_mem_support b w hw x _ hcx f hf
    have hre : (monomialRootWeight w f X).re = d a + (monomialRootWeight w e₁ X).re := by
      rw [hwf, Complex.add_re]
      rfl
    by_contra hnone
    push Not at hnone
    have hzero : (monomialRootWeight w f X).re = 0 := by
      rw [realWeight_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      by_cases h : f i = 0
      · simp [h]
      · exact absurd (hpos i h) (not_lt.mpr (hnone i h))
    linarith
  rw [hsplit, ← mul_assoc]
  change x * orderedPBWMonomial b e₂ ∈ realPositiveLetterSpan b d
  rw [← (orderedPBWBasisOf b).linearCombination_repr x, Finsupp.linearCombination_apply,
    Finsupp.sum, Finset.sum_mul]
  refine Submodule.sum_mem _ fun f hf => ?_
  rw [smul_mul_assoc]
  refine Submodule.smul_mem _ _ ?_
  obtain ⟨hpos, i, hi, hdi⟩ := hsupport f hf
  refine Submodule.subset_span ⟨fun j => f j + e₂ j, ⟨i, show f i + e₂ i ≠ 0 by omega, hdi⟩, ?_⟩
  rw [orderedPBWBasisOf_apply, orderedPBWBasisOf_apply, orderedPBWMonomial, orderedPBWMonomial,
    orderedPBWMonomial, ofFn_prod_pow_add _ f e₂ (hord f hpos)]

include hw in
theorem realPositiveGeneratorSpan_le (hd : Antitone (realWeight w X)) :
    realPositiveGeneratorSpan b (realWeight w X) ≤ realPositiveLetterSpan b (realWeight w X) := by
  rw [realPositiveGeneratorSpan, Submodule.span_le]
  rintro u ⟨a, ha, v, rfl⟩
  rw [← (orderedPBWBasisOf b).linearCombination_repr v, Finsupp.linearCombination_apply,
    Finsupp.sum, Finset.mul_sum]
  refine Submodule.sum_mem _ fun e _ => ?_
  rw [mul_smul_comm, orderedPBWBasisOf_apply]
  exact Submodule.smul_mem _ _ (generator_mul_mem_realPositiveLetterSpan b w hw X hd a ha e)

include hw in
theorem disjoint_real_of_antitone (hd : Antitone (realWeight w X)) :
    Disjoint (realPositiveGeneratorSpan b (realWeight w X))
      (realZeroGeneratorSubalgebra b (realWeight w X)).toSubmodule := by
  rw [disjoint_iff, eq_bot_iff, ← realPositiveLetterSpan_inf_realZeroLetterSpan b]
  exact inf_le_inf (realPositiveGeneratorSpan_le b w hw X hd)
    (realZeroGeneratorSubalgebra_le b w hw X)

include hw in
/-- An element commuting with `𝔥` lies in the sum of the positive right span and the zero-weight
subalgebra, for real weights decreasing along the basis order. -/
theorem mem_sup_of_commute_of_antitone (hd : Antitone (realWeight w X)) (z : U)
    (hz : ∀ h : H, commutatorMap (h : L) z = 0) :
    z ∈ realPositiveGeneratorSpan b (realWeight w X) ⊔
      (realZeroGeneratorSubalgebra b (realWeight w X)).toSubmodule := by
  let B := orderedPBWBasisOf b
  have hz' : ∀ h : H, commutatorMap (h : L) z = (0 : H → ℂ) h • z := fun h => by
    rw [hz, Pi.zero_apply, zero_smul]
  have hsupport (e : Fin n → ℕ) (he : e ∈ (B.repr z).support) :
      ∑ i, (e i : ℝ) * realWeight w X i = 0 := by
    rw [← realWeight_sum, monomialRootWeight_eq_of_mem_support b w hw z 0 hz' e he]
    rfl
  rw [← B.linearCombination_repr z, Finsupp.linearCombination_apply, Finsupp.sum]
  refine Submodule.sum_mem _ fun e he => Submodule.smul_mem _ _ ?_
  rw [orderedPBWBasisOf_apply, orderedPBWMonomial]
  by_cases hpos : ∃ i, e i ≠ 0 ∧ 0 < realWeight w X i
  · exact Submodule.mem_sup_left (ofFn_prod_pow_mem_span_of_pos_real _ _ hd e hpos)
  · exact Submodule.mem_sup_right
      (ofFn_prod_pow_mem_adjoin (k := ℂ) _ (fun a => realWeight w X a = 0) e
        (weight_eq_zero_of_sum_eq_zero_real _ e (hsupport e he) hpos))

end RealWeights

end Langlands.Algebra.HarishChandra
