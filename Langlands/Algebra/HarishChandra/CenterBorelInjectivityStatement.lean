import Langlands.Algebra.HarishChandra.ParabolicIndependenceStatement

/-! # Injectivity of the center projection at a split Cartan -/

noncomputable section

universe v

set_option autoImplicit false

namespace Langlands.Algebra.HarishChandra

open LieModule

variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]

/-- The sum of the weight spaces whose weights take positive real part at `X`. -/
def positiveRootSubmodule (H : LieSubalgebra ℂ L) (X : H) : Submodule ℂ L :=
  ⨆ (χ : H → ℂ) (_ : 0 < (χ X).re), (weightSpace L χ : Submodule ℂ L)

/-- A central element in the right ideal generated by the positive roots for a regular
element of a split Cartan is zero. -/
def CenterBorelInjectivityStatement : Prop :=
  ∀ (L : Type v) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (H : LieSubalgebra ℂ L), IsSplitCartan H → ∀ X : H,
    (∀ χ : H → ℂ, χ ≠ 0 → weightSpace L χ ≠ ⊥ → (χ X).re ≠ 0) →
    ∀ z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L),
      z ∈ generatorRightIdeal (positiveRootSubmodule H X) → z = 0

end Langlands.Algebra.HarishChandra
