import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Data.Matrix.Basic
import Mathlib.Basic.Complex.Basic

/-!
# Finiteness of separated matrix representations of a finitely generated algebra

Let `R` be a complex algebra generated by finitely many elements. A family of algebra
homomorphisms `R → M_s(ℂ)` of one fixed size `s` that is separated by elements of `R`
(each member is nonzero on its own element and every other member kills it) is finite.

Each element of `R` acts through a matrix of polynomials in the entries of the images of
the generators. The vanishing ideals of these generic matrices form a family of ideals
in a Noetherian polynomial ring, and a maximal finite union bounds the family.
-/

namespace Langlands

open MvPolynomial

universe uR uι

variable {R : Type uR} [Ring R] [Algebra ℂ R]

/-- The entries of the images of the generators under a matrix representation. -/
def generatorEntries {t s : ℕ} (gen : Fin t → R) (φ : R →ₐ[ℂ] Matrix (Fin s) (Fin s) ℂ) :
    Fin t × Fin s × Fin s → ℂ :=
  fun k => φ (gen k.1) k.2.1 k.2.2

/-- Every element of an algebra generated by `gen` is represented, uniformly in the
matrix representation, by a matrix of polynomials in the generator entries. -/
theorem exists_genericMatrix {t s : ℕ} (gen : Fin t → R)
    (hgen : Algebra.adjoin ℂ (Set.range gen) = ⊤) (r : R) :
    ∃ Q : Matrix (Fin s) (Fin s) (MvPolynomial (Fin t × Fin s × Fin s) ℂ),
      ∀ φ : R →ₐ[ℂ] Matrix (Fin s) (Fin s) ℂ,
        (aeval (generatorEntries gen φ)).mapMatrix Q = φ r := by
  have hr : r ∈ Algebra.adjoin ℂ (Set.range gen) := hgen ▸ Algebra.mem_top
  induction hr using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨k, rfl⟩ := hx
    refine ⟨Matrix.of fun a b => X (k, a, b), fun φ => ?_⟩
    ext a b
    simp [generatorEntries]
  | algebraMap c =>
    exact ⟨algebraMap ℂ _ c, fun φ => by rw [AlgHom.commutes, AlgHom.commutes]⟩
  | add x y _ _ hx hy =>
    obtain ⟨Q₁, h₁⟩ := hx
    obtain ⟨Q₂, h₂⟩ := hy
    exact ⟨Q₁ + Q₂, fun φ => by rw [map_add, h₁, h₂, map_add]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨Q₁, h₁⟩ := hx
    obtain ⟨Q₂, h₂⟩ := hy
    exact ⟨Q₁ * Q₂, fun φ => by rw [map_mul, h₁, h₂, map_mul]⟩

/-- A separated family of matrix representations of one size of a finitely generated
complex algebra is finite. -/
theorem finite_of_separated_matrixRepresentations {ι : Type uι} {t s : ℕ} (gen : Fin t → R)
    (hgen : Algebra.adjoin ℂ (Set.range gen) = ⊤)
    (ψ : ι → R →ₐ[ℂ] Matrix (Fin s) (Fin s) ℂ) (f : ι → R)
    (hself : ∀ i, ψ i (f i) ≠ 0) (hother : ∀ i j, i ≠ j → ψ j (f i) = 0) :
    Finite ι := by
  classical
  choose Q hQ using fun i => exists_genericMatrix (s := s) gen hgen (f i)
  let pt : ι → Fin t × Fin s × Fin s → ℂ := fun j => generatorEntries gen (ψ j)
  let J : ι → Ideal (MvPolynomial (Fin t × Fin s × Fin s) ℂ) := fun i =>
    Ideal.span (Set.range fun ab : Fin s × Fin s => Q i ab.1 ab.2)
  have entry : ∀ i j a b, aeval (pt j) (Q i a b) = ψ j (f i) a b := by
    intro i j a b
    rw [← hQ i (ψ j)]
    rfl
  have hvan : ∀ i j, i ≠ j → J i ≤ RingHom.ker (aeval (pt j)) := by
    intro i j hij
    rw [Ideal.span_le]
    rintro _ ⟨⟨a, b⟩, rfl⟩
    change aeval (pt j) (Q i a b) = 0
    rw [entry, hother i j hij]
    rfl
  have hnv : ∀ i, ¬ J i ≤ RingHom.ker (aeval (pt i)) := by
    intro i hle
    apply hself i
    ext a b
    have h := hle (Ideal.subset_span ⟨(a, b), rfl⟩)
    change aeval (pt i) (Q i a b) = 0 at h
    rw [entry] at h
    exact h
  obtain ⟨_, ⟨F, rfl⟩, hmax⟩ :=
    (set_has_maximal_iff_noetherian (R := MvPolynomial (Fin t × Fin s × Fin s) ℂ)
      (M := MvPolynomial (Fin t × Fin s × Fin s) ℂ)).mpr
      (inferInstance : IsNoetherianRing (MvPolynomial (Fin t × Fin s × Fin s) ℂ))
      (Set.range fun F : Finset ι => ⨆ i ∈ F, J i) ⟨_, ⟨∅, rfl⟩⟩
  have hall : ∀ i, i ∈ F := by
    intro i
    by_contra hi
    have hle : (⨆ j ∈ F, J j) ≤ RingHom.ker (aeval (pt i)) :=
      iSup₂_le fun j hj => hvan j i fun h => hi (h ▸ hj)
    apply hnv i
    refine le_trans ?_ hle
    by_contra hJ
    apply hmax (⨆ j ∈ insert i F, J j) ⟨_, rfl⟩
    refine lt_of_le_of_ne ?_ ?_
    · exact iSup₂_le fun j hj => le_iSup₂_of_le j (Finset.mem_insert_of_mem hj) le_rfl
    · intro heq
      apply hJ
      rw [show (⨆ j ∈ F, J j) = ⨆ j ∈ insert i F, J j from heq]
      exact le_iSup₂_of_le i (Finset.mem_insert_self i F) le_rfl
  exact Finite.of_injective (fun i => (⟨i, hall i⟩ : F)) fun i j h => by
    simpa using congrArg Subtype.val h

end Langlands
