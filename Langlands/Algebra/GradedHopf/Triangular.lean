import Langlands.Algebra.GradedHopf.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.SemiringInverse
import Mathlib.RingTheory.Adjoin.Basic

/-! # Triangularizing graded matrix coefficients by fixed vectors -/

noncomputable section

open TensorProduct

namespace Langlands.Algebra.GradedHopf

namespace Triangular

variable {k A : Type*} [Field k]

section Compat

variable {m n o : Type*} [Fintype m] [Fintype n] [Fintype o]

/-- A scalar matrix is compatible with row weights `w` and column weights `w'` when its nonzero
entries only join a row and a column of the same weight. -/
def Compat (w : m → ℤ) (w' : n → ℤ) (P : Matrix m n k) : Prop :=
  ∀ i j, P i j ≠ 0 → w i = w' j

omit [Fintype m] [Fintype o] in
theorem Compat.mul {w : m → ℤ} {w' : n → ℤ} {w'' : o → ℤ} {P : Matrix m n k}
    {P' : Matrix n o k} (hP : Compat w w' P) (hP' : Compat w' w'' P') :
    Compat w w'' (P * P') := by
  intro i j h
  rw [Matrix.mul_apply] at h
  obtain ⟨l, -, hl⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
  exact (hP i l (left_ne_zero_of_mul hl)).trans (hP' l j (right_ne_zero_of_mul hl))

/-- The inverse of a compatible matrix is compatible with the weights exchanged. -/
theorem Compat.of_mul_eq_one [DecidableEq m] [DecidableEq n] {w : m → ℤ} {w' : n → ℤ}
    {P : Matrix m n k} {Q : Matrix n m k} (hP : Compat w w' P) (hPQ : P * Q = 1)
    (hQP : Q * P = 1) : Compat w' w Q := by
  have hD : ∀ d : ℤ, Matrix.diagonal (fun i => if w i = d then (1 : k) else 0) * P =
      P * Matrix.diagonal (fun j => if w' j = d then (1 : k) else 0) := by
    intro d
    ext i j
    rw [Matrix.diagonal_mul, Matrix.mul_diagonal]
    by_cases h : P i j = 0
    · simp [h]
    · simp [hP i j h]
  intro i j hij
  have key : Q * Matrix.diagonal (fun i => if w i = w j then (1 : k) else 0) =
      Matrix.diagonal (fun j' => if w' j' = w j then (1 : k) else 0) * Q :=
    calc _ = Q * Matrix.diagonal (fun i => if w i = w j then (1 : k) else 0) * (P * Q) := by
          rw [hPQ, Matrix.mul_one]
      _ = Q * (Matrix.diagonal (fun i => if w i = w j then (1 : k) else 0) * P) * Q := by
          simp only [Matrix.mul_assoc]
      _ = Q * (P * Matrix.diagonal (fun j' => if w' j' = w j then (1 : k) else 0)) * Q := by
          rw [hD]
      _ = (Q * P) * Matrix.diagonal (fun j' => if w' j' = w j then (1 : k) else 0) * Q := by
          simp only [Matrix.mul_assoc]
      _ = _ := by rw [hQP, Matrix.one_mul]
  have hij' := congrFun (congrFun key i) j
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul, ite_eq_left rfl, mul_one] at hij'
  by_contra hne
  rw [ite_eq_right hne, zero_mul] at hij'
  exact hij hij'

end Compat

variable [CommRing A] [Bialgebra k A]

section Conj

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The change of basis `Q * a * P` of a matrix of coefficients by scalar matrices. -/
def conj (Q P : Matrix n n k) (a : Matrix n n A) : Matrix n n A :=
  Q.map (algebraMap k A) * a * P.map (algebraMap k A)

omit [DecidableEq n] in
theorem conj_apply (Q P : Matrix n n k) (a : Matrix n n A) (i j : n) :
    conj Q P a i j = ∑ l, ∑ m, (Q i l * P m j) • a l m := by
  simp only [conj, Matrix.mul_apply, Matrix.map_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun m _ => ?_
  rw [Algebra.smul_def, map_mul]
  ring

omit [DecidableEq n] in
theorem conj_conj (Q₂ P₂ Q₁ P₁ : Matrix n n k) (a : Matrix n n A) :
    conj Q₂ P₂ (conj Q₁ P₁ a) = conj (Q₂ * Q₁) (P₁ * P₂) a := by
  simp only [conj, Matrix.map_mul, Matrix.mul_assoc]

theorem conj_one_one (a : Matrix n n A) : conj (1 : Matrix n n k) 1 a = a := by
  simp [conj]

omit [Fintype n] [DecidableEq n] in
theorem map_algebraMap_map {B : Type*} [Semiring B] [Algebra k B] (φ : A →ₐ[k] B)
    (M : Matrix n n k) : (M.map (algebraMap k A)).map φ = M.map (algebraMap k B) := by
  ext i j
  simp

/-- Every entry of `a` lies in the subalgebra generated by the entries of a change of basis
of `a`. -/
theorem adjoin_conj {a : Matrix n n A} {P Q : Matrix n n k} (hPQ : P * Q = 1)
    (h : Algebra.adjoin k (Set.range fun p : n × n => a p.1 p.2) = ⊤) :
    Algebra.adjoin k (Set.range fun p : n × n => conj Q P a p.1 p.2) = ⊤ := by
  rw [eq_top_iff, ← h]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  have ha : a i j = conj P Q (conj Q P a) i j := by rw [conj_conj, hPQ, conj_one_one]
  change a i j ∈ _
  rw [ha, conj_apply]
  exact Subalgebra.sum_mem _ fun l _ => Subalgebra.sum_mem _ fun m _ =>
    Subalgebra.smul_mem _ (Algebra.subset_adjoin
      (Set.mem_range_self (f := fun p : n × n => conj Q P a p.1 p.2) (l, m))) _

end Conj

section Corep

variable {n : Type*} [Fintype n] [DecidableEq n]

variable (k) in
/-- A square matrix of coefficients whose comultiplication is given by matrix multiplication
and whose counit is the identity matrix. -/
def IsCorep (a : Matrix n n A) : Prop :=
  a.map (Bialgebra.comulAlgHom k A) =
      a.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] A) *
        a.map (Algebra.TensorProduct.includeRight : A →ₐ[k] A ⊗[k] A) ∧
    a.map (Bialgebra.counitAlgHom k A) = 1

theorem isCorep_iff (a : Matrix n n A) :
    IsCorep k a ↔ (∀ i j, Coalgebra.comul (R := k) (a i j) = ∑ l, a i l ⊗ₜ[k] a l j) ∧
      ∀ i j, Coalgebra.counit (R := k) (a i j) = if i = j then 1 else 0 := by
  have hmul : ∀ i j, (a.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] A) *
      a.map (Algebra.TensorProduct.includeRight : A →ₐ[k] A ⊗[k] A)) i j =
        ∑ l, a i l ⊗ₜ[k] a l j := fun i j => by
    simp [Matrix.mul_apply, Algebra.TensorProduct.tmul_mul_tmul]
  simp only [IsCorep, ← Matrix.ext_iff, Matrix.map_apply, hmul, Matrix.one_apply,
    Bialgebra.comulAlgHom_apply, Bialgebra.counitAlgHom_apply]

theorem IsCorep.conj {a : Matrix n n A} (ha : IsCorep k a) {P Q : Matrix n n k}
    (hPQ : P * Q = 1) : IsCorep k (conj Q P a) := by
  have hQP : Q * P = 1 := mul_eq_one_comm.1 hPQ
  have h1 : P.map (algebraMap k (A ⊗[k] A)) * Q.map (algebraMap k (A ⊗[k] A)) = 1 := by
    rw [← Matrix.map_mul, hPQ, Matrix.map_one _ (map_zero _) (map_one _)]
  constructor
  · simp only [Triangular.conj, Matrix.map_mul, map_algebraMap_map, ha.1]
    calc _ = Q.map (algebraMap k (A ⊗[k] A)) *
          a.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] A) *
          (P.map (algebraMap k (A ⊗[k] A)) * Q.map (algebraMap k (A ⊗[k] A))) *
          a.map (Algebra.TensorProduct.includeRight : A →ₐ[k] A ⊗[k] A) *
          P.map (algebraMap k (A ⊗[k] A)) := by
          rw [h1, Matrix.mul_one]
          simp only [Matrix.mul_assoc]
      _ = _ := by simp only [Matrix.mul_assoc]
  · simp only [Triangular.conj, Matrix.map_mul, map_algebraMap_map, ha.2, Matrix.mul_one]
    rw [← Matrix.map_mul, hQP]
    simp

theorem IsCorep.submatrix_succ {n : ℕ} {a : Matrix (Fin (n + 1)) (Fin (n + 1)) A}
    (ha : IsCorep k a) (h0 : ∀ i : Fin n, a i.succ 0 = 0) :
    IsCorep k (a.submatrix Fin.succ Fin.succ) := by
  rw [isCorep_iff] at ha ⊢
  refine ⟨fun i j => ?_, fun i j => ?_⟩
  · simp only [Matrix.submatrix_apply]
    rw [ha.1, Fin.sum_univ_succ, h0, TensorProduct.zero_tmul, zero_add]
  · simp only [Matrix.submatrix_apply, ha.2, Fin.succ_inj]

end Corep

section Graded

variable (𝒜 : ℤ → Submodule k A) {n : Type*} [Fintype n] [DecidableEq n]

/-- The entry `(i, j)` of `a` has degree `w j - w i`. -/
def IsGraded (w : n → ℤ) (a : Matrix n n A) : Prop :=
  ∀ i j, a i j ∈ 𝒜 (w j - w i)

variable {𝒜}

omit [DecidableEq n] in
theorem IsGraded.conj {w w' : n → ℤ} {a : Matrix n n A} (ha : IsGraded 𝒜 w a)
    {P Q : Matrix n n k} (hP : Compat w w' P) (hQ : Compat w' w Q) :
    IsGraded 𝒜 w' (conj Q P a) := by
  intro i j
  rw [conj_apply]
  refine Submodule.sum_mem _ fun l _ => Submodule.sum_mem _ fun m _ => ?_
  by_cases h : Q i l * P m j = 0
  · rw [h, zero_smul]
    exact zero_mem _
  · have h1 := hQ i l (left_ne_zero_of_mul h)
    have h2 := hP m j (right_ne_zero_of_mul h)
    refine Submodule.smul_mem _ _ ?_
    rw [h1, ← h2]
    exact ha l m

variable [GradedAlgebra 𝒜]

omit [DecidableEq n] in
/-- The homogeneous components of a fixed vector of a graded matrix of coefficients are fixed
vectors, so a nonzero fixed vector yields a nonzero fixed vector of a single weight. -/
theorem exists_homogeneous_fixed {w : n → ℤ} {a : Matrix n n A} (ha : IsGraded 𝒜 w a)
    {v : n → k} (hv : v ≠ 0) (hfix : ∀ i, ∑ j, v j • a i j = v i • (1 : A)) :
    ∃ v' : n → k, v' ≠ 0 ∧ (∃ d, ∀ j, v' j ≠ 0 → w j = d) ∧
      ∀ i, ∑ j, v' j • a i j = v' i • (1 : A) := by
  obtain ⟨j₀, hj₀⟩ := Function.ne_iff.1 hv
  refine ⟨fun j => if w j = w j₀ then v j else 0, ?_, ⟨w j₀, fun j hj => ?_⟩, fun i => ?_⟩
  · exact Function.ne_iff.2 ⟨j₀, by simpa using hj₀⟩
  · by_contra h
    exact hj (ite_eq_right h)
  · have h := congrArg (gradeProj 𝒜 (w j₀ - w i)) (hfix i)
    have hg : ∀ j, gradeProj 𝒜 (w j₀ - w i) (a i j) =
        if w j - w i = w j₀ - w i then a i j else 0 := fun j => gradeProj_of_mem 𝒜 (ha i j)
    simp only [map_sum, map_smul, hg, gradeProj_of_mem 𝒜 (one_mem_zero 𝒜), sub_left_inj,
      smul_ite, smul_zero] at h
    simp only [ite_smul, zero_smul]
    rw [h]
    by_cases hi : w i = w j₀
    · rw [ite_eq_left (by omega), ite_eq_left hi]
    · rw [ite_eq_right (by omega), ite_eq_right hi]

end Graded

section Step

variable {n : ℕ} (v : Fin (n + 1) → k) (i₀ : Fin (n + 1))

/-- The basis change whose first column is `v` and whose other columns are the standard basis
vectors other than the `i₀`-th. -/
def stepP : Matrix (Fin (n + 1)) (Fin (n + 1)) k := fun i j =>
  if j = 0 then v i else if i = Equiv.swap 0 i₀ j then 1 else 0

/-- The inverse of `stepP v i₀` when `v i₀ ≠ 0`. -/
def stepQ : Matrix (Fin (n + 1)) (Fin (n + 1)) k := fun j l =>
  (if l = i₀ then (if j = 0 then (v i₀)⁻¹ else -((v i₀)⁻¹ * v (Equiv.swap 0 i₀ j))) else 0) +
    (if j = 0 then 0 else if l = Equiv.swap 0 i₀ j then 1 else 0)

theorem stepQ_mul_stepP (h : v i₀ ≠ 0) : stepQ v i₀ * stepP v i₀ = 1 := by
  ext j m
  rw [Matrix.mul_apply, Matrix.one_apply]
  by_cases hm : m = 0
  · subst hm
    simp only [stepP, stepQ, add_mul, ite_mul, zero_mul, Finset.sum_add_distrib,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true, one_mul]
    by_cases hj : j = 0
    · simp [hj, h]
    · have hτ : Equiv.swap 0 i₀ j ≠ i₀ := by
        intro he
        apply hj
        rwa [Equiv.swap_apply_eq_iff, Equiv.swap_apply_right] at he
      simp only [hj, ite_false, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
      rw [neg_mul, mul_right_comm, inv_mul_cancel₀ h, one_mul, neg_add_cancel]
  · have hτ : Equiv.swap 0 i₀ m ≠ i₀ := by
      intro he
      apply hm
      rwa [Equiv.swap_apply_eq_iff, Equiv.swap_apply_right] at he
    simp only [stepP, ite_eq_right hm, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true]
    simp only [stepQ, ite_eq_right hτ, zero_add]
    by_cases hj : j = 0
    · subst hj
      simp [Ne.symm hm]
    · simp [hj, (Equiv.swap 0 i₀).injective.eq_iff]
      exact if_congr eq_comm rfl rfl

theorem compat_stepP {w : Fin (n + 1) → ℤ} {d : ℤ} (hv : ∀ j, v j ≠ 0 → w j = d)
    (h : v i₀ ≠ 0) : Compat w (w ∘ Equiv.swap 0 i₀) (stepP v i₀) := by
  intro i j hij
  simp only [stepP] at hij
  by_cases hj : j = 0
  · subst hj
    rw [ite_eq_left rfl] at hij
    simp [hv i hij, hv i₀ h]
  · rw [ite_eq_right hj] at hij
    by_cases hi : i = Equiv.swap 0 i₀ j
    · simp [hi]
    · simp [hi] at hij

/-- After the change of basis by `stepP v i₀`, a fixed vector `v` becomes the first standard
basis vector. -/
theorem conj_stepP_apply_zero {a : Matrix (Fin (n + 1)) (Fin (n + 1)) A}
    {Q : Matrix (Fin (n + 1)) (Fin (n + 1)) k} (hQP : Q * stepP v i₀ = 1)
    (hfix : ∀ i, ∑ j, v j • a i j = v i • (1 : A)) (i : Fin (n + 1)) :
    conj Q (stepP v i₀) a i 0 = if i = 0 then 1 else 0 := by
  rw [conj_apply]
  have h : ∀ l, ∑ m, (Q i l * stepP v i₀ m 0) • a l m = (Q i l * v l) • (1 : A) := fun l => by
    simp only [stepP, ↓reduceIte, mul_smul, ← Finset.smul_sum, hfix l]
  simp only [h, ← Finset.sum_smul]
  have hQP' := congrFun (congrFun hQP i) 0
  rw [Matrix.mul_apply] at hQP'
  simp only [stepP, ↓reduceIte] at hQP'
  rw [hQP', Matrix.one_apply]
  split_ifs <;> simp

end Step

section Extend

variable {n : ℕ}

/-- The block diagonal matrix with blocks `1` and `P`. -/
def ext1 (P : Matrix (Fin n) (Fin n) k) : Matrix (Fin (n + 1)) (Fin (n + 1)) k :=
  Matrix.of (Fin.cons (Fin.cons 1 0) fun i => Fin.cons 0 (P i))

@[simp] theorem ext1_zero_zero (P : Matrix (Fin n) (Fin n) k) : ext1 P 0 0 = 1 := rfl

@[simp] theorem ext1_zero_succ (P : Matrix (Fin n) (Fin n) k) (j : Fin n) :
    ext1 P 0 j.succ = 0 := by
  simp [ext1]

@[simp] theorem ext1_succ_zero (P : Matrix (Fin n) (Fin n) k) (i : Fin n) :
    ext1 P i.succ 0 = 0 := by
  simp [ext1]

@[simp] theorem ext1_succ_succ (P : Matrix (Fin n) (Fin n) k) (i j : Fin n) :
    ext1 P i.succ j.succ = P i j := by
  simp [ext1]

theorem ext1_mul (P Q : Matrix (Fin n) (Fin n) k) : ext1 P * ext1 Q = ext1 (P * Q) := by
  ext i j
  refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_succ]

theorem ext1_one : ext1 (1 : Matrix (Fin n) (Fin n) k) = 1 := by
  ext i j
  refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j <;>
    simp [Matrix.one_apply, Fin.succ_ne_zero, eq_comm (a := (0 : Fin (n + 1)))]

theorem compat_ext1 {w : Fin (n + 1) → ℤ} {w' : Fin n → ℤ} {P : Matrix (Fin n) (Fin n) k}
    (hP : Compat (w ∘ Fin.succ) w' P) : Compat w (Fin.cons (w 0) w') (ext1 P) := by
  intro i j h
  induction i using Fin.cases with
  | zero =>
    induction j using Fin.cases with
    | zero => rfl
    | succ j => exact absurd (ext1_zero_succ P j) h
  | succ i =>
    induction j using Fin.cases with
    | zero => exact absurd (ext1_succ_zero P i) h
    | succ j =>
      rw [ext1_succ_succ] at h
      simpa using hP i j h

theorem conj_ext1 {b : Matrix (Fin (n + 1)) (Fin (n + 1)) A}
    (hb : ∀ i, b i 0 = if i = 0 then 1 else 0) (Q P : Matrix (Fin n) (Fin n) k) :
    conj (ext1 Q) (ext1 P) b 0 0 = 1 ∧ (∀ i : Fin n, conj (ext1 Q) (ext1 P) b i.succ 0 = 0) ∧
      ∀ i j : Fin n, conj (ext1 Q) (ext1 P) b i.succ j.succ =
        conj Q P (b.submatrix Fin.succ Fin.succ) i j := by
  refine ⟨?_, fun i => ?_, fun i j => ?_⟩
  · simp [conj_apply, Fin.sum_univ_succ, hb]
  · simp [conj_apply, Fin.sum_univ_succ, hb]
  · simp [conj_apply, Fin.sum_univ_succ]

end Extend

section Main

variable (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜]

/-- A square matrix over `Fin n` is upper unitriangular. -/
def IsUnitriangular {n : ℕ} (b : Matrix (Fin n) (Fin n) A) : Prop :=
  (∀ i, b i i = 1) ∧ ∀ i j, j < i → b i j = 0

/-- If every nonempty matrix of coefficients has a nonzero fixed vector, then every graded matrix
of coefficients becomes upper unitriangular after a weight-compatible change of basis. -/
theorem exists_unitriangular_conj
    (hfix : ∀ (m : ℕ) (b : Matrix (Fin (m + 1)) (Fin (m + 1)) A), IsCorep k b →
      ∃ v : Fin (m + 1) → k, v ≠ 0 ∧ ∀ i, ∑ j, v j • b i j = v i • (1 : A)) :
    ∀ (n : ℕ) (w : Fin n → ℤ) (a : Matrix (Fin n) (Fin n) A), IsCorep k a → IsGraded 𝒜 w a →
      ∃ (w' : Fin n → ℤ) (P Q : Matrix (Fin n) (Fin n) k),
        P * Q = 1 ∧ Compat w w' P ∧ IsUnitriangular (conj Q P a) := by
  intro n
  induction n with
  | zero =>
    intro w a _ _
    exact ⟨w, 1, 1, Matrix.mul_one 1, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0⟩
  | succ n ih =>
    intro w a ha hg
    obtain ⟨v₀, hv₀, hfix₀⟩ := hfix n a ha
    obtain ⟨v, hv, ⟨d, hd⟩, hvfix⟩ := exists_homogeneous_fixed hg hv₀ hfix₀
    obtain ⟨i₀, hi₀⟩ := Function.ne_iff.1 hv
    have hQP : stepQ v i₀ * stepP v i₀ = 1 := stepQ_mul_stepP v i₀ hi₀
    have hPQ : stepP v i₀ * stepQ v i₀ = 1 := mul_eq_one_comm.1 hQP
    have hP := compat_stepP v i₀ hd hi₀
    have hQ := hP.of_mul_eq_one hPQ hQP
    have hb := ha.conj hPQ
    have hbg := hg.conj hP hQ
    have hb0 := conj_stepP_apply_zero v i₀ hQP hvfix
    have hc := hb.submatrix_succ fun i => by rw [hb0, ite_eq_right (Fin.succ_ne_zero i)]
    obtain ⟨w₂, P', Q', hPQ', hP', hU'⟩ :=
      ih ((w ∘ Equiv.swap 0 i₀) ∘ Fin.succ) _ hc fun i j => hbg i.succ j.succ
    refine ⟨Fin.cons ((w ∘ Equiv.swap 0 i₀) 0) w₂, stepP v i₀ * ext1 P', ext1 Q' * stepQ v i₀,
      ?_, hP.mul (compat_ext1 hP'), ?_⟩
    · rw [Matrix.mul_assoc, ← Matrix.mul_assoc (ext1 P'), ext1_mul, hPQ', ext1_one,
        Matrix.one_mul, hPQ]
    · rw [← conj_conj]
      obtain ⟨h00, hs0, hss⟩ := conj_ext1 hb0 Q' P'
      refine ⟨fun i => ?_, fun i j hji => ?_⟩
      · induction i using Fin.cases with
        | zero => exact h00
        | succ i => rw [hss]; exact hU'.1 i
      · induction i using Fin.cases with
        | zero => exact absurd hji (Fin.not_lt_zero j)
        | succ i =>
          induction j using Fin.cases with
          | zero => exact hs0 i
          | succ j => rw [hss]; exact hU'.2 i j (Fin.succ_lt_succ_iff.1 hji)

end Main

end Triangular

end Langlands.Algebra.GradedHopf
