import Langlands.Algebra.GradedHopf.UnipotentFlag

/-! # The trivial `ℤ`-grading and ungraded unitriangular matrix coefficients -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry TensorProduct
open Langlands.GroupScheme

namespace Langlands.Algebra.GradedHopf

section TrivialGrade

variable (k A : Type*) [CommRing k] [CommRing A] [Algebra k A]

/-- The trivial `ℤ`-grading, with every element in degree `0`. -/
def trivialGrade : ℤ → Submodule k A := fun i => if i = 0 then ⊤ else ⊥

variable {k A}

theorem trivialGrade_zero : trivialGrade k A 0 = ⊤ := by simp [trivialGrade]

theorem trivialGrade_of_ne {i : ℤ} (hi : i ≠ 0) : trivialGrade k A i = ⊥ := by
  simp [trivialGrade, hi]

theorem mem_trivialGrade_zero (a : A) : a ∈ trivialGrade k A 0 := by
  rw [trivialGrade_zero]
  exact Submodule.mem_top

theorem eq_zero_of_mem_trivialGrade {i : ℤ} (hi : i ≠ 0) {a : A}
    (ha : a ∈ trivialGrade k A i) : a = 0 := by
  rwa [trivialGrade_of_ne hi, Submodule.mem_bot] at ha

theorem isInternal_trivialGrade : DirectSum.IsInternal (trivialGrade k A) := by
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · rw [iSupIndep_def]
    intro i
    by_cases hi : i = 0
    · subst hi
      have h : (⨆ (j) (_ : j ≠ (0 : ℤ)), trivialGrade k A j) = ⊥ := by
        simp only [iSup_eq_bot]
        intro j hj
        exact trivialGrade_of_ne hj
      rw [h]
      exact disjoint_bot_right
    · rw [trivialGrade_of_ne hi]
      exact disjoint_bot_left
  · exact eq_top_iff.2 (le_iSup_of_le 0 trivialGrade_zero.ge)

/-- The graded-algebra structure of the trivial grading. -/
@[instance_reducible]
def trivialGradedAlgebra : GradedAlgebra (trivialGrade k A) where
  one_mem := mem_trivialGrade_zero 1
  mul_mem i j a b ha hb := by
    by_cases hi : i = 0
    · by_cases hj : j = 0
      · subst hi hj
        exact mem_trivialGrade_zero _
      · rw [eq_zero_of_mem_trivialGrade hj hb, mul_zero]
        exact Submodule.zero_mem _
    · rw [eq_zero_of_mem_trivialGrade hi ha, zero_mul]
      exact Submodule.zero_mem _
  toDecomposition := isInternal_trivialGrade.chooseDecomposition

end TrivialGrade

section Bialgebra

variable {k A : Type*} [CommRing k] [CommRing A] [Bialgebra k A]

/-- Every bialgebra is graded for the trivial grading. -/
theorem isGradedBialgebra_trivialGrade [GradedAlgebra (trivialGrade k A)] :
    IsGradedBialgebra (trivialGrade k A) where
  comul_mem n a ha := by
    by_cases hn : n = 0
    · subst hn
      induction Coalgebra.comul (R := k) a using TensorProduct.induction_on with
      | zero => exact Submodule.zero_mem _
      | tmul x y =>
        simpa only [add_zero] using tmul_mem_tensorGrade (trivialGrade k A) (trivialGrade k A)
          (mem_trivialGrade_zero x) (mem_trivialGrade_zero y)
      | add x y hx hy => exact Submodule.add_mem _ hx hy
    · rw [eq_zero_of_mem_trivialGrade hn ha, map_zero]
      exact Submodule.zero_mem _
  counit_eq_zero n hn a ha := by
    rw [eq_zero_of_mem_trivialGrade hn ha, map_zero]

end Bialgebra

/-- Ungraded form of `exists_unitriangular_of_isUnipotent`: the Hopf algebra of a unipotent
group scheme of finite type over a field is generated by the entries of an upper
unitriangular matrix of coefficients. -/
theorem exists_unitriangular_matrixCoefficients {k : Type u} [Field k]
    (A : CommHopfAlgCat.{u} (CommRingCat.of k)) [Algebra.FiniteType k A]
    (hU : IsUnipotent ((hopfSpec (CommRingCat.of k)).obj (op A))) :
    ∃ (n : ℕ) (M : Matrix (Fin n) (Fin n) A),
      (∀ i j, Coalgebra.comul (R := k) (M i j) = ∑ l, M i l ⊗ₜ[k] M l j) ∧
      (∀ i j, Coalgebra.counit (R := k) (M i j) = if i = j then 1 else 0) ∧
      Algebra.adjoin k (Set.range fun p : Fin n × Fin n => M p.1 p.2) = ⊤ ∧
      (∀ i, M i i = 1) ∧ ∀ i j, j < i → M i j = 0 := by
  let := trivialGradedAlgebra (k := k) (A := A)
  obtain ⟨G, hdiag, hlow⟩ :=
    exists_unitriangular_of_isUnipotent A (trivialGrade k A) isGradedBialgebra_trivialGrade hU
  exact ⟨G.n, G.M, G.comul_apply, G.counit_apply, G.adjoin_eq_top, hdiag, hlow⟩

end Langlands.Algebra.GradedHopf
