import Langlands.Algebra.GradedHopf.Quotient
import Langlands.Algebra.GradedHopf.LaurentCoaction
import Langlands.CommutativeAlgebra.GradedFormallySmoothPolynomial

/-! # The positive part of a `ℤ`-graded augmented algebra -/

noncomputable section

open DirectSum

namespace Langlands.Algebra.GradedHopf

section Regrade

variable {ι ι' k A : Type*} [DecidableEq ι] [DecidableEq ι'] [AddCommMonoid ι] [AddCommMonoid ι']
  [CommRing k] [CommRing A] [Algebra k A] (𝒜 : ι → Submodule k A) [GradedAlgebra 𝒜]
  (φ : ι' ≃+ ι)

/-- The grading `i' ↦ 𝒜 (φ i')` obtained by reindexing along an additive equivalence. -/
@[instance_reducible]
def regradedAlgebra : GradedAlgebra (fun i' => 𝒜 (φ i')) where
  one_mem := by rw [map_zero]; exact SetLike.GradedOne.one_mem
  mul_mem i j a b ha hb := by rw [map_add]; exact SetLike.GradedMul.mul_mem ha hb
  toDecomposition :=
    (DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
      ((DirectSum.Decomposition.isInternal 𝒜).submodule_iSupIndep.comp φ.injective)
      ((φ.toEquiv.iSup_comp (g := 𝒜)).trans
        (DirectSum.Decomposition.isInternal 𝒜).submodule_iSup_eq_top)).chooseDecomposition

/-- For any grading instance on `i' ↦ 𝒜 (φ i')`, its degree projections are those of `𝒜`. -/
theorem gradeProj_regrade [GradedAlgebra (fun i' => 𝒜 (φ i'))] (i' : ι') (a : A) :
    gradeProj (fun i' => 𝒜 (φ i')) i' a = gradeProj 𝒜 (φ i') a := by
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => rw [map_zero, map_zero]
  | @homogeneous i a =>
    have ha : (a : A) ∈ 𝒜 (φ (φ.symm i)) := by rw [φ.apply_symm_apply]; exact a.2
    rw [gradeProj_of_mem (fun i' => 𝒜 (φ i')) ha, gradeProj_of_mem 𝒜 a.2]
    exact if_congr φ.symm_apply_eq rfl rfl
  | add a b ha hb => rw [map_add, map_add, ha, hb]

end Regrade

section Positive

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (𝒜 : ℤ → Submodule k A)
  [GradedAlgebra 𝒜] (ε : A →ₐ[k] k)

/-- The ideal generated by the homogeneous elements of negative degree and the elements of
degree `0` killed by `ε`. Its quotient is the positive part of `A`. -/
def positiveIdeal : Ideal A :=
  Ideal.span {a | (∃ n < 0, a ∈ 𝒜 n) ∨ (a ∈ 𝒜 0 ∧ ε a = 0)}

variable {𝒜 ε}

omit [GradedAlgebra 𝒜] in
theorem mem_positiveIdeal_of_neg {n : ℤ} (hn : n < 0) {a : A} (ha : a ∈ 𝒜 n) :
    a ∈ positiveIdeal 𝒜 ε :=
  Ideal.subset_span (Or.inl ⟨n, hn, ha⟩)

omit [GradedAlgebra 𝒜] in
theorem mem_positiveIdeal_of_zero {a : A} (ha : a ∈ 𝒜 0) (hεa : ε a = 0) :
    a ∈ positiveIdeal 𝒜 ε :=
  Ideal.subset_span (Or.inr ⟨ha, hεa⟩)

variable (𝒜 ε)

omit [GradedAlgebra 𝒜] in
theorem negSpan_le_positiveIdeal : negSpan 𝒜 ≤ positiveIdeal 𝒜 ε :=
  Ideal.span_le.2 fun _ ⟨_, hn, ha⟩ => mem_positiveIdeal_of_neg hn ha

theorem isHomogeneous_positiveIdeal : (positiveIdeal 𝒜 ε).IsHomogeneous 𝒜 := by
  refine Ideal.homogeneous_span 𝒜 _ ?_
  rintro a (⟨n, -, ha⟩ | ⟨ha, -⟩)
  · exact ⟨n, ha⟩
  · exact ⟨0, ha⟩

variable {𝒜 ε}

/-- An augmentation that kills every summand of nonzero degree does not change under
projection to degree `0`. -/
theorem apply_gradeProj_zero (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) (a : A) :
    ε (gradeProj 𝒜 0 a) = ε a := by
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => rw [map_zero, map_zero]
  | @homogeneous i a =>
    rw [gradeProj_of_mem 𝒜 a.2]
    split_ifs with h
    · rfl
    · rw [map_zero, hε i h a a.2]
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add]

omit [GradedAlgebra 𝒜] in
theorem positiveIdeal_le_ker (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) :
    positiveIdeal 𝒜 ε ≤ RingHom.ker ε := by
  refine Ideal.span_le.2 ?_
  rintro a (⟨n, hn, ha⟩ | ⟨-, hεa⟩)
  · exact hε n hn.ne a ha
  · exact hεa

theorem gradeProj_zero_mul_mem (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) {b c : A} (hb : ε b = 0)
    (hc : ε c = 0) : gradeProj 𝒜 0 (b * c) ∈ positiveIdeal 𝒜 ε ^ 2 ⊔ negSpan 𝒜 := by
  classical
  rw [← sum_gradeProj 𝒜 b, Finset.sum_mul, map_sum]
  refine Ideal.sum_mem _ fun n _ => ?_
  rw [gradeProj_mul_of_left_mem 𝒜 (gradeProj_mem 𝒜 n b), zero_sub]
  rcases lt_trichotomy n 0 with hn | rfl | hn
  · refine Ideal.mem_sup_right (Ideal.mul_mem_right _ _ ?_)
    exact Ideal.subset_span ⟨n, hn, gradeProj_mem 𝒜 n b⟩
  · refine Ideal.mem_sup_left ?_
    rw [pow_two, neg_zero]
    refine Ideal.mul_mem_mul (mem_positiveIdeal_of_zero (gradeProj_mem 𝒜 0 b) ?_)
      (mem_positiveIdeal_of_zero (gradeProj_mem 𝒜 0 c) ?_)
    · rw [apply_gradeProj_zero hε, hb]
    · rw [apply_gradeProj_zero hε, hc]
  · refine Ideal.mem_sup_right (Ideal.mul_mem_left _ _ ?_)
    exact Ideal.subset_span ⟨-n, neg_neg_iff_pos.2 hn, gradeProj_mem 𝒜 (-n) c⟩

theorem gradeProj_zero_mem_of_mem_sq (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) {x : A}
    (hx : x ∈ RingHom.ker ε ^ 2) :
    gradeProj 𝒜 0 x ∈ positiveIdeal 𝒜 ε ^ 2 ⊔ negSpan 𝒜 := by
  rw [pow_two] at hx
  refine Submodule.mul_induction_on hx (fun b hb c hc => gradeProj_zero_mul_mem hε hb hc) ?_
  intro x y hx hy
  rw [map_add]
  exact Ideal.add_mem _ hx hy

/-- The positive ideal is contained in its square up to the negative part, provided every
element of degree `0` of the augmentation ideal lies in its square. -/
theorem positiveIdeal_le_sq_sup (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0)
    (h0 : ∀ a ∈ 𝒜 0, ε a = 0 → a ∈ RingHom.ker ε ^ 2) :
    positiveIdeal 𝒜 ε ≤ positiveIdeal 𝒜 ε ^ 2 ⊔ negSpan 𝒜 := by
  refine Ideal.span_le.2 ?_
  rintro a (⟨n, hn, ha⟩ | ⟨ha, hεa⟩)
  · exact Ideal.mem_sup_right (Ideal.subset_span ⟨n, hn, ha⟩)
  · have := gradeProj_zero_mem_of_mem_sq hε (h0 a ha hεa)
    rwa [gradeProj_of_mem_self 𝒜 ha] at this

/-- The positive part of a formally smooth `ℤ`-graded augmented algebra is formally smooth. -/
theorem formallySmooth_positive [Algebra.FormallySmooth k A]
    (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) (h0 : ∀ a ∈ 𝒜 0, ε a = 0 → a ∈ RingHom.ker ε ^ 2) :
    Algebra.FormallySmooth k (A ⧸ positiveIdeal 𝒜 ε) := by
  have := formallySmooth_quotient_negSpan 𝒜
  exact formallySmooth_quotient_of_le_sq_sup (negSpan_le_positiveIdeal 𝒜 ε)
    (positiveIdeal_le_sq_sup hε h0)

/-- The augmentation of the positive part. -/
def positiveCounit (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) : A ⧸ positiveIdeal 𝒜 ε →ₐ[k] k :=
  Ideal.Quotient.liftₐ _ ε fun _ ha => positiveIdeal_le_ker hε ha

omit [GradedAlgebra 𝒜] in
theorem positiveCounit_mk (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) (a : A) :
    positiveCounit hε (Ideal.Quotient.mk _ a) = ε a :=
  rfl

omit [GradedAlgebra 𝒜] in
theorem nontrivial_positive [Nontrivial k] (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0) :
    Nontrivial (A ⧸ positiveIdeal 𝒜 ε) :=
  RingHom.domain_nontrivial (positiveCounit hε : A ⧸ positiveIdeal 𝒜 ε →+* k)

variable (𝒜 ε)

/-- The `ℕ`-indexed family of submodules of the positive part: the image of `𝒜 n`. -/
abbrev positiveGrade : ℕ → Submodule k (A ⧸ positiveIdeal 𝒜 ε) :=
  quotGrade 𝒜 (positiveIdeal 𝒜 ε) (Nat.castAddMonoidHom ℤ)

variable {𝒜 ε}

theorem not_mem_range_natCast {i : ℤ} (hi : i ∉ Set.range (Nat.castAddMonoidHom ℤ)) : i < 0 := by
  by_contra h
  exact hi ⟨i.toNat, by simp [Int.toNat_of_nonneg (not_lt.1 h)]⟩

/-- The `ℕ`-grading of the positive part. -/
@[instance_reducible]
def positiveGradedAlgebra : GradedAlgebra (positiveGrade 𝒜 ε) :=
  quotGradedAlgebra (isHomogeneous_positiveIdeal 𝒜 ε) Nat.cast_injective
    fun _ hi _a ha => mem_positiveIdeal_of_neg (not_mem_range_natCast hi) ha

/-- The degree-`0` part of the positive part consists of the scalars. -/
theorem positiveGrade_zero : positiveGrade 𝒜 ε 0 =
    LinearMap.range (Algebra.linearMap k (A ⧸ positiveIdeal 𝒜 ε)) := by
  apply le_antisymm
  · rintro _ ⟨a, ha, rfl⟩
    have ha' : a ∈ 𝒜 0 := by simpa using ha
    refine ⟨ε a, ?_⟩
    change algebraMap k _ (ε a) = Ideal.Quotient.mk _ a
    rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq]
    refine mem_positiveIdeal_of_zero ?_ ?_
    · exact Submodule.sub_mem _ (algebraMap_mem_zero 𝒜 _) ha'
    · rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
  · rintro _ ⟨r, rfl⟩
    refine ⟨algebraMap k A r, by simpa using algebraMap_mem_zero 𝒜 r, ?_⟩
    change Ideal.Quotient.mk _ (algebraMap k A r) = algebraMap k _ r
    rw [Ideal.Quotient.mk_algebraMap]

end Positive

section Polynomial

/-- The positive part of a finitely generated, formally smooth `ℤ`-graded augmented algebra
over a field, whose degree-`0` augmentation ideal lies in the square of the augmentation
ideal, is a polynomial algebra on finitely many generators of positive degree. -/
theorem exists_positive_aeval_bijective {k A : Type*} [Field k] [CommRing A] [Algebra k A]
    {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] {ε : A →ₐ[k] k} [Algebra.FiniteType k A]
    [Algebra.FormallySmooth k A] (hε : ∀ n ≠ 0, ∀ a ∈ 𝒜 n, ε a = 0)
    (h0 : ∀ a ∈ 𝒜 0, ε a = 0 → a ∈ RingHom.ker ε ^ 2) :
    ∃ (n : ℕ) (d : Fin n → ℕ) (x : Fin n → A ⧸ positiveIdeal 𝒜 ε), (∀ i, 0 < d i) ∧
      (∀ i, x i ∈ positiveGrade 𝒜 ε (d i)) ∧
      Function.Bijective
        (MvPolynomial.aeval x : MvPolynomial (Fin n) k →ₐ[k] A ⧸ positiveIdeal 𝒜 ε) := by
  let := positiveGradedAlgebra (𝒜 := 𝒜) (ε := ε)
  have := nontrivial_positive hε
  have := formallySmooth_positive hε h0
  exact Langlands.Algebra.GradedFormallySmooth.exists_homogeneous_aeval_bijective
    (positiveGrade 𝒜 ε) positiveGrade_zero

end Polynomial

end Langlands.Algebra.GradedHopf
