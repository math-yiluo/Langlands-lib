import Langlands.Algebra.CentralSimple.LandherrCancellation
import Langlands.Algebra.CentralSimple.LandherrNormOneUnit
import Langlands.Algebra.CentralSimple.LandherrMainLemmas

/-! # The final algebraic steps of Landherr's theorem -/

noncomputable section

namespace Langlands.CentralSimple.Landherr

open Langlands.GroupScheme.Quaternionic Langlands.GroupScheme.SU3Root

universe u

variable (F E : Type u) [Field F] [Field E] [Algebra F E]
  [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E] [CharZero F]
  (B : Type u) [Ring B] [Algebra E B] [Algebra F B] [IsScalarTower F E B]
  [FiniteDimensional E B] [Algebra.IsCentral E B] [IsSimpleRing B]
  (τ : FirstKindInvolution F B)
  (hτ : ∀ e : E, τ (algebraMap E B e) = algebraMap E B (conjugation F E e))

include hτ in
/-- Let `τ` act on `E` by quadratic conjugation. If `diag(y, 1) = Z τ(Z)ᵗ` in `M₂(B)`
for a unit `y`, then `y = x τ(x)` for a unit `x` of `B`. -/
theorem exists_eq_mul_of_diag_unit (y : Bˣ) (Z : Matrix (Fin 2) (Fin 2) B)
    (hZ : Z * τ.matrix (Fin 2) Z = !![(y : B), 0; 0, 1]) : ∃ x : Bˣ, (y : B) = x * τ x := by
  have : FiniteDimensional F E :=
    .of_finrank_pos (by rw [Algebra.IsQuadraticExtension.finrank_eq_two F E]; decide)
  have : FiniteDimensional F B := Module.Finite.trans E B
  obtain ⟨μ, hμ, hu⟩ := exists_normOne_isUnit_sub F E B (Z 1 1)
  have hμc : ∀ z, algebraMap E B μ * z = z * algebraMap E B μ := fun z => Algebra.commutes μ z
  have hμ' : algebraMap E B μ * τ (algebraMap E B μ) = 1 := by
    rw [hτ, ← map_mul, hμ, map_one]
  obtain ⟨a, ha⟩ := exists_eq_mul_of_diag τ (y : B) Z hZ (algebraMap E B μ) hμc hμ' hu
  have hau : IsUnit a := isUnit_of_mul_eq_one' F (b := τ a * ↑y⁻¹)
    (by rw [← mul_assoc, ← ha, Units.mul_inv])
  exact ⟨hau.unit, ha⟩

include hτ in
/-- The involution acts on the skew scalar matrix by a sign. -/
theorem matrix_algebraMap_skewRoot :
    τ.matrix (Fin 2) (algebraMap E (Matrix (Fin 2) (Fin 2) B) (skewRoot F E)) =
      -algebraMap E (Matrix (Fin 2) (Fin 2) B) (skewRoot F E) := by
  ext i j
  rw [FirstKindInvolution.matrix_apply, Matrix.algebraMap_matrix_apply,
    Matrix.neg_apply, Matrix.algebraMap_matrix_apply]
  by_cases h : i = j
  · subst h
    simp [hτ, conjugation_skewRoot]
  · simp [h, Ne.symm h]

include hτ in
/-- Let `τ` act on `E` by quadratic conjugation. If the transposed involution fixes `y'`
and `X² - d Y² = y'` with `X, Y` in the `F`-subalgebra generated by `y'`, then
`Z = X + r Y` satisfies `Z τ(Z)ᵗ = y'`. -/
theorem mul_matrix_eq_of_norm (y' : Matrix (Fin 2) (Fin 2) B) (hy' : τ.matrix (Fin 2) y' = y')
    (X Y : Algebra.adjoin F {y'})
    (hXY : X ^ 2 - algebraMap F _ (skewSq F E) * Y ^ 2 = ⟨y', Algebra.subset_adjoin rfl⟩) :
    ((X : Matrix (Fin 2) (Fin 2) B) +
        algebraMap E (Matrix (Fin 2) (Fin 2) B) (skewRoot F E) * (Y : Matrix (Fin 2) (Fin 2) B)) *
      τ.matrix (Fin 2) ((X : Matrix (Fin 2) (Fin 2) B) +
        algebraMap E (Matrix (Fin 2) (Fin 2) B) (skewRoot F E) * (Y : Matrix (Fin 2) (Fin 2) B)) =
      y' := by
  set R := algebraMap E (Matrix (Fin 2) (Fin 2) B) (skewRoot F E) with hR
  have hX : τ.matrix (Fin 2) (X : Matrix (Fin 2) (Fin 2) B) = X :=
    involution_fix_adjoin (τ.matrix (Fin 2)) hy' X.2
  have hY : τ.matrix (Fin 2) (Y : Matrix (Fin 2) (Fin 2) B) = Y :=
    involution_fix_adjoin (τ.matrix (Fin 2)) hy' Y.2
  have hRτ : τ.matrix (Fin 2) R = -R := matrix_algebraMap_skewRoot F E B τ hτ
  have hRc : ∀ W : Matrix (Fin 2) (Fin 2) B, R * W = W * R := fun W => Algebra.commutes _ W
  have hXYc : (X : Matrix (Fin 2) (Fin 2) B) * Y = Y * X := congrArg Subtype.val (mul_comm X Y)
  have hRR : R * R = algebraMap F (Matrix (Fin 2) (Fin 2) B) (skewSq F E) := by
    rw [hR, ← map_mul, ← algebraMap_skewSq, ← IsScalarTower.algebraMap_apply]
  have hval := congrArg Subtype.val hXY
  simp only [Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_pow,
    Subalgebra.coe_algebraMap] at hval
  rw [FirstKindInvolution.map_add, FirstKindInvolution.map_mul, hX, hY, hRτ]
  refine Eq.trans ?_ hval
  calc ((X : Matrix (Fin 2) (Fin 2) B) + R * Y) * (X + Y * -R)
      = X * X - X * Y * R + R * Y * X - R * Y * (Y * R) := by noncomm_ring
    _ = X * X - R * R * (Y * Y) := by
        have h1 : (X : Matrix (Fin 2) (Fin 2) B) * Y * R = R * Y * X := by
          calc (X : Matrix (Fin 2) (Fin 2) B) * Y * R = R * (X * Y) := (hRc _).symm
            _ = R * (Y * X) := by rw [hXYc]
            _ = R * Y * X := (mul_assoc _ _ _).symm
        have hYR : (Y : Matrix (Fin 2) (Fin 2) B) * R = R * Y := (hRc _).symm
        have h2 : R * Y * (Y * R) = R * R * (Y * Y) := by
          calc R * Y * (Y * R) = R * (Y * (Y * R)) := mul_assoc _ _ _
            _ = R * (Y * (R * Y)) := by rw [hYR]
            _ = R * ((Y * R) * Y) := by rw [mul_assoc]
            _ = R * ((R * Y) * Y) := by rw [hYR]
            _ = R * R * (Y * Y) := by noncomm_ring
        rw [h1, h2, sub_add_cancel]
    _ = (X : Matrix (Fin 2) (Fin 2) B) ^ 2 -
          algebraMap F (Matrix (Fin 2) (Fin 2) B) (skewSq F E) * (Y : Matrix (Fin 2) (Fin 2) B) ^ 2 := by
        rw [hRR, sq, sq]

end Langlands.CentralSimple.Landherr
