import Langlands.ClassFieldTheory.Global.CofiniteQuadraticNormAlgebra
import Langlands.Global.AdelicGroupLocalPoints
import Langlands.GroupScheme.Examples.SU3RootParametersQuadratic
import Langlands.GroupScheme.Quaternionic.Involution
import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-! # Cofinite local involution products for symmetric units -/

noncomputable section

open scoped TensorProduct
open Filter IsDedekindDomain

namespace Langlands.CentralSimple

open Langlands.GroupScheme.Quaternionic Langlands.GroupScheme.SU3Root
open Langlands.Global (Place FinitePlace placeCompletion)
open Langlands.ClassFieldTheory.Global

universe u

/-- A symmetric unit in a central simple algebra with unitary involution is an involution
product in the completed algebra at all but finitely many finite places. -/
def NumberFieldUnitarySymmetricCofiniteStatement : Prop :=
  ∀ (F E B : Type u) [Field F] [NumberField F] [Field E] [Algebra F E]
    [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E]
    [Ring B] [Algebra E B] [Algebra F B] [IsScalarTower F E B]
    [FiniteDimensional E B] [Algebra.IsCentral E B] [IsSimpleRing B]
    (τ : FirstKindInvolution F B),
    (∀ e : E, τ (algebraMap E B e) = algebraMap E B (conjugation F E e)) →
    ∀ (g : Bˣ), τ (g : B) = g →
      ∀ᶠ v : FinitePlace F in cofinite,
        ∃ h : (placeCompletion F (.inr v) ⊗[F] B)ˣ,
          (1 : placeCompletion F (.inr v)) ⊗ₜ[F] (g : B) =
            (h : placeCompletion F (.inr v) ⊗[F] B) * τ.baseChange (placeCompletion F (.inr v)) h

private theorem exists_conjugation_neg_sq {F E : Type u} [Field F] [CharZero F] [Field E] [Algebra F E]
    [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E] :
    ∃ ω : E, ∃ d : F, d ≠ 0 ∧ conjugation F E ω = -ω ∧ ω ^ 2 = algebraMap F E d := by
  have hne : ∃ b : E, b ≠ conjugation F E b := by
    by_contra! h
    exact conjugation_ne_one F E (AlgEquiv.ext fun b => (h b).symm)
  obtain ⟨b, hb⟩ := hne
  let ω := b - conjugation F E b
  have hω : conjugation F E ω = -ω := by
    rw [show ω = b - conjugation F E b from rfl, map_sub, conjugation_involutive, neg_sub]
  have hω2 : conjugation F E (ω ^ 2) = ω ^ 2 := by rw [map_pow, hω, neg_sq]
  have : CharZero E := Algebra.charZero_of_charZero F E
  let d := Algebra.trace F E (ω ^ 2) / 2
  have hd : algebraMap F E d = ω ^ 2 := by
    change algebraMap F E (Algebra.trace F E (ω ^ 2) / 2) = ω ^ 2
    rw [map_div₀, algebraMap_trace, hω2, map_ofNat]
    ring
  refine ⟨ω, d, ?_, hω, hd.symm⟩
  intro hzero
  rw [hzero, map_zero] at hd
  exact (pow_ne_zero 2 (sub_ne_zero.mpr hb)) hd.symm

section SymmetricAlgebra

variable {F B : Type u} [Field F] [Ring B] [Algebra F B]
  (τ : FirstKindInvolution F B) (g : Bˣ)

local notation "A" => Algebra.adjoin F ({(g : B)} : Set B)

private theorem adjoin_symm (hg : τ (g : B) = g) (x : A) : τ (x : B) = (x : B) := by
  obtain ⟨x, hx⟩ := x
  change τ x = x
  induction hx using Algebra.adjoin_induction with
  | mem y hy => rwa [Set.mem_singleton_iff.mp hy]
  | algebraMap a => exact τ.map_algebraMap a
  | add y z _ _ hy hz => simp only [τ.map_add, hy, hz]
  | mul y z hy hz hty htz =>
    rw [τ.map_mul, hty, htz]
    exact congrArg Subtype.val (mul_comm (⟨z, hz⟩ : A) (⟨y, hy⟩ : A))

private theorem exists_adjoin_unit [FiniteDimensional F B] : ∃ a : Aˣ, ((a : A) : B) = (g : B) := by
  let x : A := ⟨g, Algebra.subset_adjoin (Set.mem_singleton _)⟩
  have hinj : Function.Injective (Algebra.lmul F A x) := by
    intro y z h
    apply Subtype.ext
    exact (g.mul_right_inj).mp (congrArg (fun t : A => (t : B)) h)
  obtain ⟨y, hy⟩ := (LinearMap.injective_iff_surjective.mp hinj) 1
  exact ⟨Units.mkOfMulEqOne x y hy, rfl⟩

end SymmetricAlgebra

/-- Cofinite local solvability via the commutative algebra generated by the symmetric unit. -/
theorem numberFieldUnitarySymmetricCofinite : NumberFieldUnitarySymmetricCofiniteStatement.{u} := by
  intro F E B _ _ _ _ _ _ _ _ _ _ _ _ _ τ hτ g hg
  have : FiniteDimensional F E := .of_finrank_pos (by
    rw [Algebra.IsQuadraticExtension.finrank_eq_two F E]
    decide)
  have : FiniteDimensional F B := Module.Finite.trans E B
  obtain ⟨ω, d, hd, hω, hωsq⟩ := exists_conjugation_neg_sq (F := F) (E := E)
  let A := Algebra.adjoin F ({(g : B)} : Set B)
  obtain ⟨a, ha⟩ := exists_adjoin_unit (F := F) g
  filter_upwards [cofiniteQuadraticNormAlgebra F A d hd a] with v hv
  let R := v.adicCompletion F
  change ∃ h : (R ⊗[F] B)ˣ, (1 : R) ⊗ₜ[F] (g : B) = (h : R ⊗[F] B) * τ.baseChange R h
  let f : R ⊗[F] A →ₐ[R] R ⊗[F] B := Algebra.TensorProduct.map (AlgHom.id R R) A.val
  obtain ⟨x, y, hxy⟩ := hv
  have hxy' := congrArg f hxy
  have hdmap : f (algebraMap F (R ⊗[F] A) d) = algebraMap F (R ⊗[F] B) d :=
    (f.restrictScalars F).commutes d
  rw [map_sub, map_pow, map_mul, map_pow, hdmap] at hxy'
  change f x ^ 2 - algebraMap F (R ⊗[F] B) d * f y ^ 2 = (1 : R) ⊗ₜ[F] ((a : A) : B) at hxy'
  rw [ha] at hxy'
  have hsym (t : R ⊗[F] A) : τ.baseChange R (f t) = f t := by
    induction t using TensorProduct.inductionOn with
    | tmul r b =>
      change r ⊗ₜ[F] τ (b : B) = r ⊗ₜ[F] (b : B)
      rw [adjoin_symm τ g hg b]
    | add t s ht hs => simp only [map_add, ht, hs]
  let c : R ⊗[F] B := (1 : R) ⊗ₜ[F] algebraMap E B ω
  have hc (z : R ⊗[F] B) : Commute c z := by
    induction z using TensorProduct.inductionOn with
    | tmul r b =>
      change ((1 : R) ⊗ₜ[F] algebraMap E B ω) * (r ⊗ₜ[F] b) =
        (r ⊗ₜ[F] b) * ((1 : R) ⊗ₜ[F] algebraMap E B ω)
      rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
        one_mul, mul_one, Algebra.commutes]
    | add z w hz hw => exact hz.add_right hw
  have hcsq : c ^ 2 = algebraMap F (R ⊗[F] B) d := by
    change ((1 : R) ⊗ₜ[F] algebraMap E B ω) ^ 2 = _
    rw [pow_two, Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← map_mul, ← pow_two, hωsq,
      ← IsScalarTower.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply']
  have hbar : τ.baseChange R c = -c := by
    change (1 : R) ⊗ₜ[F] τ (algebraMap E B ω) = -((1 : R) ⊗ₜ[F] algebraMap E B ω)
    rw [hτ, hω, map_neg, TensorProduct.tmul_neg]
  let X := f x
  let Y := c * f y
  have hcomm : Commute X Y := (hc X).symm.mul_right ((Commute.all x y).map f)
  have hτXY : τ.baseChange R (X + Y) = X - Y := by
    change τ.baseChange R (f x + c * f y) = f x - c * f y
    rw [FirstKindInvolution.map_add, FirstKindInvolution.map_mul, hsym, hsym, hbar,
      mul_neg, sub_eq_add_neg, (hc (f y)).eq]
  have hh : (X + Y) * τ.baseChange R (X + Y) = (1 : R) ⊗ₜ[F] (g : B) := by
    rw [hτXY]
    calc
      (X + Y) * (X - Y) = X ^ 2 - Y ^ 2 := by
        rw [add_mul, mul_sub, mul_sub, ← hcomm.eq]
        noncomm_ring
      _ = _ := by
        change f x ^ 2 - (c * f y) ^ 2 = _
        rw [(hc (f y)).mul_pow, hcsq]
        exact hxy'
  have hm : Commute (X + Y) (τ.baseChange R (X + Y)) := by
    rw [hτXY]
    exact ((Commute.refl X).add_left hcomm.symm).sub_right (hcomm.add_left (Commute.refl Y))
  have hu : IsUnit (X + Y) := (hm.isUnit_mul_iff.mp (hh.symm ▸
    g.isUnit.map (Algebra.TensorProduct.includeRight : B →ₐ[F] R ⊗[F] B))).1
  refine ⟨hu.unit, ?_⟩
  rw [IsUnit.unit_spec]
  exact hh.symm

end Langlands.CentralSimple
