import Langlands.Algebra.CentralSimple.LandherrIntegrality
import Langlands.Algebra.CentralSimple.LandherrElementary
import Langlands.GroupScheme.Quaternionic.Involution
import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.RingTheory.Artinian.Module

/-! # Auxiliary lemmas for the assembly of Landherr's theorem -/

noncomputable section

namespace Langlands.CentralSimple.Landherr

open IsDedekindDomain NumberField Langlands.GroupScheme.Quaternionic Langlands.BinaryElementary

universe u v w

/-- A list of length `L` is recovered from its entries indexed by `Fin L`. -/
theorem ofFn_getD_eq {α : Type*} (l : List α) (d : α) (L : ℕ) (hL : l.length = L) :
    List.ofFn (fun j : Fin L => l.getD j d) = l := by
  subst hL
  apply List.ext_getElem (by simp)
  intro n h1 h2
  simp [List.getD_eq_getElem?_getD]

section Units

variable {F : Type u} [Field F] {A : Type v} [Ring A] [Algebra F A] [FiniteDimensional F A]

omit [FiniteDimensional F A] in
/-- In a finite-dimensional algebra a right-invertible element is invertible. -/
theorem isUnit_of_mul_eq_one' (F : Type u) [Field F] [Algebra F A] [FiniteDimensional F A]
    {a b : A} (h : a * b = 1) : IsUnit a := by
  have : IsArtinianRing A := IsArtinianRing.of_finite F A
  exact isUnit_iff_exists_inv.mpr ⟨b, h⟩

/-- A unit of a finite-dimensional algebra is a unit of every subalgebra containing it whose
multiplication is commutative. -/
theorem isUnit_subalgebra {K : Subalgebra F A} {a : K} (ha : IsUnit (a : A))
    (hcomm : ∀ x y : K, x * y = y * x) : IsUnit a := by
  have hfin : FiniteDimensional F K := inferInstance
  let φ : K →ₗ[F] K := LinearMap.mulLeft F a
  have hinj : Function.Injective φ := by
    intro x y hxy
    have : (a : A) * x = (a : A) * y := congrArg Subtype.val hxy
    exact Subtype.ext (ha.mul_left_cancel this)
  obtain ⟨b, hb⟩ := LinearMap.surjective_of_injective hinj 1
  have hb' : a * b = 1 := hb
  exact ⟨⟨a, b, hb', by rw [hcomm]; exact hb'⟩, rfl⟩

end Units

section Involution

variable {F : Type u} [CommRing F] {A : Type v} [Ring A] [Algebra F A] (τ : FirstKindInvolution F A)

/-- An `F`-linear anti-involution maps a unit `u` to a unit with inverse `τ(u⁻¹)`. -/
def involutionUnit (u : Aˣ) : Aˣ where
  val := τ u
  inv := τ (↑u⁻¹ : A)
  val_inv := by rw [← FirstKindInvolution.map_mul, Units.inv_mul, FirstKindInvolution.map_one]
  inv_val := by rw [← FirstKindInvolution.map_mul, Units.mul_inv, FirstKindInvolution.map_one]

@[simp] theorem involutionUnit_val (u : Aˣ) : (involutionUnit τ u : A) = τ u := rfl

/-- An involution fixing `x` fixes the subalgebra generated by `x`. -/
theorem involution_fix_adjoin {x : A} (hx : τ x = x) {a : A} (ha : a ∈ Algebra.adjoin F {x}) :
    τ a = a := by
  induction ha using Algebra.adjoin_induction with
  | mem y hy => rw [Set.mem_singleton_iff.mp hy]; exact hx
  | algebraMap r => exact FirstKindInvolution.map_algebraMap τ r
  | add y z _ _ hy hz => rw [FirstKindInvolution.map_add, hy, hz]
  | mul y z hy' hz' hy hz =>
    rw [FirstKindInvolution.map_mul, hy, hz]
    have := mul_comm (⟨z, hz'⟩ : Algebra.adjoin F {x}) ⟨y, hy'⟩
    exact congrArg Subtype.val this

end Involution

section Integral

variable {F : Type u} [Field F] [NumberField F] {A : Type v} [Ring A] [Algebra F A]
  {ι : Type w} [Fintype ι] [DecidableEq ι] {β : Module.Basis ι F A}
  {v : HeightOneSpectrum (𝓞 F)}

omit [DecidableEq ι] [Fintype ι] in
/-- A linear map with integral images of a basis preserves integrality. -/
theorem intAt_map {A' : Type v} [Ring A'] [Algebra F A'] {ι' : Type w} [Fintype ι']
    (β' : Module.Basis ι' F A') (φ : A' →ₗ[F] A) (hφ : ∀ i, IntAt β v (φ (β' i))) {a : A'}
    (ha : IntAt β' v a) : IntAt β v (φ a) := by
  rw [← β'.sum_repr a, map_sum]
  exact intAt_sum fun i _ => by rw [LinearMap.map_smul]; exact intAt_smul (ha i) (hφ i)

variable {B : Type v} [Ring B] [Algebra F B] {ιB : Type w} [Fintype ιB] (βB : Module.Basis ιB F B)

variable (F) in
/-- The linear map sending `b` to the matrix with sole entry `b` at `(0, 1)`. -/
abbrev upperPart : B →ₗ[F] Matrix (Fin 2) (Fin 2) B := Matrix.singleLinearMap F 0 1

variable (F) in
/-- The linear map sending `b` to the matrix with sole entry `b` at `(1, 0)`. -/
abbrev lowerPart : B →ₗ[F] Matrix (Fin 2) (Fin 2) B := Matrix.singleLinearMap F 1 0

omit [NumberField F] in
variable (F) in
theorem upper_eq (b : B) : (upper b : Matrix (Fin 2) (Fin 2) B) = 1 + upperPart F b := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp

omit [NumberField F] in
variable (F) in
theorem lower_eq (b : B) : (lower b : Matrix (Fin 2) (Fin 2) B) = 1 + lowerPart F b := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp

variable {ι₂ : Type w} [Fintype ι₂] [DecidableEq ι₂]
  {β₂ : Module.Basis ι₂ F (Matrix (Fin 2) (Fin 2) B)}

omit [DecidableEq ι₂] in
/-- Let `β₂` have integral structure constants and integral coordinates of `1` at `v`.
If the images of `βB` under `upperPart` and `lowerPart` are integral in `β₂`, a list product
with entries integral in `βB` and its inverse are both integral in `β₂`. -/
theorem intAt_listProd (hB : BasisIntAt β₂ v)
    (hup : ∀ i, IntAt β₂ v (upperPart F (βB i))) (hlo : ∀ i, IntAt β₂ v (lowerPart F (βB i)))
    (l : List (B × B)) (hl : ∀ pq ∈ l, IntAt βB v pq.1 ∧ IntAt βB v pq.2) :
    IntAt β₂ v (listProd l : Matrix (Fin 2) (Fin 2) B) ∧
      IntAt β₂ v (↑(listProd l)⁻¹ : Matrix (Fin 2) (Fin 2) B) := by
  have hU : ∀ b, IntAt βB v b → IntAt β₂ v (upper b : Matrix (Fin 2) (Fin 2) B) := fun b hb => by
    rw [upper_eq F]; exact intAt_add (intAt_one hB) (intAt_map βB (upperPart F) hup hb)
  have hL : ∀ b, IntAt βB v b → IntAt β₂ v (lower b : Matrix (Fin 2) (Fin 2) B) := fun b hb => by
    rw [lower_eq F]; exact intAt_add (intAt_one hB) (intAt_map βB (lowerPart F) hlo hb)
  induction l with
  | nil => refine ⟨?_, ?_⟩ <;> simpa using intAt_one hB
  | cons pq l ih =>
    have hpq : IntAt βB v pq.1 ∧ IntAt βB v pq.2 := hl pq (List.mem_cons_self)
    have hrest : ∀ x ∈ l, IntAt βB v x.1 ∧ IntAt βB v x.2 := fun x hx =>
      hl x (List.mem_cons_of_mem pq hx)
    have ih' := ih hrest
    have hp := hpq.1
    have hq := hpq.2
    have ih1 := ih'.1
    have ih2 := ih'.2
    rw [listProd_cons, mul_inv_rev, mul_inv_rev, upper_inv, lower_inv]
    simp only [Units.val_mul]
    exact ⟨intAt_mul hB (intAt_mul hB (hU _ hp) (hL _ hq)) ih1,
      intAt_mul hB ih2 (intAt_mul hB (hL _ (intAt_neg hq)) (hU _ (intAt_neg hp)))⟩

end Integral

end Langlands.CentralSimple.Landherr
