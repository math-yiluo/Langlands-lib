import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Lie.Solvable
import Mathlib.Algebra.Lie.Abelian
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.Analysis.Complex.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Defs

/-! # Finiteness of the parabolic projection of an enveloping centre -/

universe v w

set_option autoImplicit false

namespace Langlands.Algebra.ParabolicCenterProjection

attribute [local instance 100] LieRing.ofAssociativeRing

variable {g : Type v} [LieRing g] [LieAlgebra ℂ g]

/-- The right ideal of the enveloping algebra spanned by the products `Y u` with `Y` an
eigenvector of `ad H` for a positive integer eigenvalue. -/
def positiveRightIdeal (H : g) : Submodule ℂ (UniversalEnvelopingAlgebra ℂ g) :=
  Submodule.span ℂ {x | ∃ (k : ℕ) (Y : g), ⁅H, Y⁆ = ((k + 1 : ℕ) : ℂ) • Y ∧
    ∃ u : UniversalEnvelopingAlgebra ℂ g, x = UniversalEnvelopingAlgebra.ι ℂ Y * u}

/-- **Finiteness of the parabolic projection of the centre** (Harish-Chandra). Let `g` be a
finite-dimensional reductive complex Lie algebra, `H ∈ g` an element whose adjoint action is
diagonalizable with integer eigenvalues, and `j : m → g` an injective Lie algebra map onto
the centralizer of `H`. Every algebra map `p` between the centres of the enveloping
algebras such that each central `z` is congruent to the image of `p z` modulo the right
ideal generated by the positive eigenvectors makes the centre of `U(m)` a finite module
over the centre of `U(g)`. -/
def ParabolicCenterProjectionFiniteStatement : Prop :=
  ∀ (g : Type v) [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (m : Type w) [LieRing m] [LieAlgebra ℂ m] (j : m →ₗ⁅ℂ⁆ g) (H : g),
    LieAlgebra.radical ℂ g = LieAlgebra.center ℂ g →
    Submodule.span ℂ {Y : g | ∃ k : ℤ, ⁅H, Y⁆ = (k : ℂ) • Y} = ⊤ →
    Function.Injective j → (∀ X : g, X ∈ Set.range j ↔ ⁅H, X⁆ = 0) →
    ∀ p : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ g) →ₐ[ℂ]
        Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ m),
      (∀ z : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ g),
        (z : UniversalEnvelopingAlgebra ℂ g) -
          UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j)
            (p z : UniversalEnvelopingAlgebra ℂ m) ∈ positiveRightIdeal H) →
      p.Finite

end Langlands.Algebra.ParabolicCenterProjection
