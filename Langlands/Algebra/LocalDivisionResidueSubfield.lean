import Langlands.Algebra.LocalDivisionResidueScalar
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-! Actual embedded commutative subfields with the full local division-algebra residue. -/

noncomputable section

namespace Langlands.CentralDivision

open ValuativeRel
open scoped IsMulCommutative

universe u uL

variable (K D : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [DivisionRing D] [Algebra K D]
  [FiniteDimensional K D] [Algebra.IsCentral K D]

section Embedding

variable {L : Type uL} [Field L] [Algebra K L] (ι : L →ₐ[K] D)

/-- Restrict the actual local division-algebra valuation to an embedded subfield. -/
def localDivisionSubfieldValuation : Valuation L (ValueGroupWithZero K) :=
  (localReducedNormValuation K D).comap ι.toRingHom

@[simp]
theorem localDivisionSubfieldValuation_apply (x : L) :
    localDivisionSubfieldValuation K D ι x = localReducedNormValuation K D (ι x) := rfl

/-- The inclusion of the actual integer subrings for the restricted valuation. -/
def localDivisionSubfieldIntegerMap :
    (localDivisionSubfieldValuation K D ι).integer →+*
      (localReducedNormValuation K D).integer where
  toFun x := ⟨ι x.val, x.prop⟩
  map_one' := Subtype.ext (map_one _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' x y := Subtype.ext (map_add _ x.val y.val)
  map_mul' x y := Subtype.ext (map_mul _ x.val y.val)

/-- The map of actual strict-ideal residue quotients induced by the inclusion. -/
def localDivisionSubfieldResidueMap :
    DivisionValuation.Residue (localDivisionSubfieldValuation K D ι) →+*
      DivisionValuation.Residue (localReducedNormValuation K D) :=
  Ideal.Quotient.lift (DivisionValuation.strictIdeal _)
    ((DivisionValuation.reduction _).comp (localDivisionSubfieldIntegerMap K D ι))
    (fun _ hx => (DivisionValuation.reduction_eq_zero_iff _ _).mpr hx)

@[simp]
theorem localDivisionSubfieldResidueMap_reduction
    (x : (localDivisionSubfieldValuation K D ι).integer) :
    localDivisionSubfieldResidueMap K D ι
        (DivisionValuation.reduction (localDivisionSubfieldValuation K D ι) x) =
      DivisionValuation.reduction (localReducedNormValuation K D)
        (localDivisionSubfieldIntegerMap K D ι x) := rfl

theorem localDivisionSubfieldResidueMap_injective :
    Function.Injective (localDivisionSubfieldResidueMap K D ι) :=
  (localDivisionSubfieldResidueMap K D ι).injective

/-- A subfield containing an integral lift of a residue generator has full residue. -/
theorem localDivisionSubfieldResidueMap_surjective
    (a : (localReducedNormValuation K D).integerˣ)
    (ha : (a.val : D) ∈ Set.range ι)
    (hgen : ∀ z : DivisionValuation.Residue (localReducedNormValuation K D),
      z = 0 ∨ ∃ n : ℕ,
        z = DivisionValuation.reduction (localReducedNormValuation K D) (a.val ^ n)) :
    Function.Surjective (localDivisionSubfieldResidueMap K D ι) := by
  obtain ⟨b, hb⟩ := ha
  intro z
  rcases hgen z with rfl | ⟨n, hn⟩
  · exact ⟨0, map_zero _⟩
  · let x : (localDivisionSubfieldValuation K D ι).integer :=
      ⟨b ^ n, by
        change localReducedNormValuation K D (ι (b ^ n)) ≤ 1
        rw [map_pow, hb]
        exact (a.val ^ n).prop⟩
    refine ⟨DivisionValuation.reduction _ x, ?_⟩
    rw [localDivisionSubfieldResidueMap_reduction, hn]
    apply congrArg (DivisionValuation.reduction _)
    apply Subtype.ext
    change ι (b ^ n) = (a.val : D) ^ n
    rw [map_pow, hb]

/-- The actual residue quotient isomorphism for any such embedded subfield. -/
def localDivisionSubfieldResidueEquiv
    (a : (localReducedNormValuation K D).integerˣ)
    (ha : (a.val : D) ∈ Set.range ι)
    (hgen : ∀ z : DivisionValuation.Residue (localReducedNormValuation K D),
      z = 0 ∨ ∃ n : ℕ,
        z = DivisionValuation.reduction (localReducedNormValuation K D) (a.val ^ n)) :
    DivisionValuation.Residue (localDivisionSubfieldValuation K D ι) ≃+*
      DivisionValuation.Residue (localReducedNormValuation K D) :=
  RingEquiv.ofBijective (localDivisionSubfieldResidueMap K D ι)
    ⟨localDivisionSubfieldResidueMap_injective K D ι,
      localDivisionSubfieldResidueMap_surjective K D ι a ha hgen⟩

end Embedding

/-- The actual subalgebra generated by one original division-algebra element. -/
def residueGeneratorSubalgebra (a : D) : Subalgebra K D := Algebra.adjoin K {a}

instance residueGeneratorSubalgebra_commutative (a : D) :
    IsMulCommutative (residueGeneratorSubalgebra K D a) :=
  Algebra.isMulCommutative_adjoin_singleton K a

/-- A singly generated subalgebra of the finite-dimensional division algebra is a field. -/
@[instance_reducible]
def residueGeneratorField (a : D) : Field (residueGeneratorSubalgebra K D a) :=
  fieldOfFiniteDimensional K _

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  [FiniteDimensional K D] [Algebra.IsCentral K D] in
theorem residueGenerator_mem (a : D) : a ∈ residueGeneratorSubalgebra K D a :=
  Algebra.self_mem_adjoin_singleton K a

/-- Some actual commutative subfield has residue mapping onto the full division-algebra residue. -/
theorem exists_residueGeneratorSubfield :
    ∃ a : (localReducedNormValuation K D).integerˣ,
      letI := residueGeneratorField K D (a.val : D)
      Function.Surjective (localDivisionSubfieldResidueMap K D
        (residueGeneratorSubalgebra K D (a.val : D)).val) := by
  obtain ⟨a, ha⟩ := exists_localDivisionResidue_generator K D
  refine ⟨a, ?_⟩
  let := residueGeneratorField K D (a.val : D)
  apply localDivisionSubfieldResidueMap_surjective K D _ a _ ha
  exact ⟨⟨a.val, residueGenerator_mem K D (a.val : D)⟩, rfl⟩

end Langlands.CentralDivision
