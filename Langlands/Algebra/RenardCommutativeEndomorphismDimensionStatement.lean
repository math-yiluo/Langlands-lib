import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Basic.Complex.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-! Exact real-power statements of Renard 2026, Appendix C.I. -/

namespace Langlands.Renard

universe uV

/-- Renard C.I for the actual unital algebra generated by commuting endomorphisms.
Both powers and both subtractions in the bound are real operations. -/
def CommutativeEndomorphismDimensionStatement : Prop :=
  ∀ (V : Type uV) [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (l : ℕ) (a : Fin l → Module.End ℂ V),
    (∀ i j, Commute (a i) (a j)) →
    (Module.finrank ℂ (Algebra.adjoin ℂ (Set.range a)) : ℝ) ≤
      Real.rpow (Module.finrank ℂ V : ℝ) (2 - Real.rpow 2 (1 - (l : ℝ)))

/-- Source-facing form of Renard C.I with an arbitrary actual subalgebra and an
explicit equality identifying its generators. -/
def CommutativeSubalgebraDimensionStatement : Prop :=
  ∀ (V : Type uV) [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (l : ℕ) (a : Fin l → Module.End ℂ V)
    (R : Subalgebra ℂ (Module.End ℂ V)),
    (∀ i j, Commute (a i) (a j)) →
    R = Algebra.adjoin ℂ (Set.range a) →
    (Module.finrank ℂ R : ℝ) ≤
      Real.rpow (Module.finrank ℂ V : ℝ) (2 - Real.rpow 2 (1 - (l : ℝ)))

end Langlands.Renard
