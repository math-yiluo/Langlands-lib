import Langlands.Algebra.KernelGenerationDescent
import Langlands.Algebra.PTorsionHopf.PrimitiveBaseChange
import Langlands.Algebra.PTorsionHopf.PrimitiveGeneration
import Langlands.Algebra.PTorsionHopf.Verschiebung

/-! # Descent of primitive algebra generators -/

noncomputable section

open TensorProduct WithConv

namespace Langlands.Algebra.PTorsionHopf

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Bialgebra k A]

/-- Primitive algebra generation descends along any extension of the ground field. -/
theorem adjoin_primitive_eq_top_of_baseChange
    (L : Type*) [Field L] [Algebra k L]
    (hgen : Algebra.adjoin L {x : L ⊗[k] A | Bialgebra.IsPrimitiveElem L x} = ⊤) :
    Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} = ⊤ := by
  have hkerL : (LinearMap.ker ((primitiveDefect k A).baseChange L) : Set (L ⊗[k] A)) =
      {x : L ⊗[k] A | Bialgebra.IsPrimitiveElem L x} :=
    Set.ext (mem_ker_baseChange_primitiveDefect k A L)
  have h := KernelGeneration.kernelAdjoin_eq_top_of_baseChange L (primitiveDefect k A) (by
    change Algebra.adjoin L
      (LinearMap.ker ((primitiveDefect k A).baseChange L) : Set (L ⊗[k] A)) = ⊤
    rwa [hkerL])
  have hker : (LinearMap.ker (primitiveDefect k A) : Set A) =
      {x : A | Bialgebra.IsPrimitiveElem k x} := Set.ext (mem_ker_primitiveDefect k A)
  simpa only [KernelGeneration.kernelAdjoin, hker] using h

/-- A finite-type bialgebra generated by primitives has finitely many primitive generators. -/
theorem exists_finite_primitive_generators [Algebra.FiniteType k A]
    (hgen : Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} = ⊤) :
    ∃ T : Finset {x : A // Bialgebra.IsPrimitiveElem k x},
      Algebra.adjoin k (Subtype.val '' (T : Set {x : A // Bialgebra.IsPrimitiveElem k x})) = ⊤ := by
  classical
  obtain ⟨T, hT, hgenT⟩ := KernelGeneration.exists_finset_generators hgen
  obtain ⟨G, _, hG⟩ : ∃ G : Finset {x : A // Bialgebra.IsPrimitiveElem k x},
      (G : Set {x : A // Bialgebra.IsPrimitiveElem k x}) ⊆ Set.univ ∧
      G.image Subtype.val = T := by
    apply Finset.subset_set_image_iff.mp
    intro b hb
    exact ⟨⟨b, hT hb⟩, Set.mem_univ _, rfl⟩
  exact ⟨G, by rw [← Finset.coe_image, hG]; exact hgenT⟩

variable [Coalgebra.IsCocomm k A]

/-- Reducedness and p-torsion of geometric points imply primitive generation over
an arbitrary original field; connectedness is not needed. -/
theorem adjoin_primitive_eq_top_of_geometric_points
    (L : Type*) [Field L] [Algebra k L] [IsAlgClosed L]
    [Algebra.FiniteType L (L ⊗[k] A)] [IsReduced (L ⊗[k] A)]
    (p : ℕ) [Fact p.Prime] [CharP L p]
    (hA : ∀ φ : (L ⊗[k] A) →ₐ[L] L, toConv φ.toLinearMap ^ p = 1) :
    Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} = ⊤ := by
  apply adjoin_primitive_eq_top_of_baseChange L
  exact adjoin_primitive_eq_top p fun ξ hξ => convPow_char_eq_zero p hA hξ

/-- Finite primitive algebra generators over the original field, obtained from
reduced p-torsion geometric points after algebraically closed scalar extension. -/
theorem exists_finite_primitive_generators_of_geometric_points
    [Algebra.FiniteType k A]
    (L : Type*) [Field L] [Algebra k L] [IsAlgClosed L]
    [Algebra.FiniteType L (L ⊗[k] A)] [IsReduced (L ⊗[k] A)]
    (p : ℕ) [Fact p.Prime] [CharP L p]
    (hA : ∀ φ : (L ⊗[k] A) →ₐ[L] L, toConv φ.toLinearMap ^ p = 1) :
    ∃ T : Finset {x : A // Bialgebra.IsPrimitiveElem k x},
      Algebra.adjoin k (Subtype.val '' (T : Set {x : A // Bialgebra.IsPrimitiveElem k x})) = ⊤ :=
  exists_finite_primitive_generators (adjoin_primitive_eq_top_of_geometric_points L p hA)

/-- A chosen finite primitive generating set, with its original-field generation proof. -/
def finitePrimitiveGeneratorsOfGeometricPoints
    [Algebra.FiniteType k A]
    (L : Type*) [Field L] [Algebra k L] [IsAlgClosed L]
    [Algebra.FiniteType L (L ⊗[k] A)] [IsReduced (L ⊗[k] A)]
    (p : ℕ) [Fact p.Prime] [CharP L p]
    (hA : ∀ φ : (L ⊗[k] A) →ₐ[L] L, toConv φ.toLinearMap ^ p = 1) :
    {T : Finset {x : A // Bialgebra.IsPrimitiveElem k x} //
      Algebra.adjoin k (Subtype.val '' (T : Set {x : A // Bialgebra.IsPrimitiveElem k x})) = ⊤} :=
  ⟨Classical.choose (exists_finite_primitive_generators_of_geometric_points L p hA),
    Classical.choose_spec (exists_finite_primitive_generators_of_geometric_points L p hA)⟩

end Langlands.Algebra.PTorsionHopf
