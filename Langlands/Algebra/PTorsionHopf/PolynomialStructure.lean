import Langlands.Algebra.PTorsionHopf.PrimitiveGeneration
import Langlands.Algebra.PTorsionHopf.MinimalRelation
import Langlands.Algebra.PTorsionHopf.EuclidReduction
import Mathlib.RingTheory.FiniteType

/-! # Coordinate algebras of commutative groups killed by `p` are polynomial rings -/

noncomputable section

universe u

open Coalgebra WithConv

namespace Langlands.Algebra.PTorsionHopf

/-- An element of the algebra generated by a set lies in the algebra generated by a finite
subset. -/
theorem exists_finset_of_mem_adjoin {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    {S : Set A} {a : A} (ha : a ∈ Algebra.adjoin k S) :
    ∃ t : Finset A, (t : Set A) ⊆ S ∧ a ∈ Algebra.adjoin k (t : Set A) := by
  classical
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact ⟨{x}, by simpa using hx, Algebra.subset_adjoin (by simp)⟩
  | algebraMap r => exact ⟨∅, by simp, Subalgebra.algebraMap_mem _ r⟩
  | add x y _ _ hx hy =>
    obtain ⟨t, ht, hxt⟩ := hx
    obtain ⟨t', ht', hyt⟩ := hy
    refine ⟨t ∪ t', by simpa using ⟨ht, ht'⟩, Subalgebra.add_mem _ ?_ ?_⟩
    · exact Algebra.adjoin_mono (by simp) hxt
    · exact Algebra.adjoin_mono (by simp) hyt
  | mul x y _ _ hx hy =>
    obtain ⟨t, ht, hxt⟩ := hx
    obtain ⟨t', ht', hyt⟩ := hy
    refine ⟨t ∪ t', by simpa using ⟨ht, ht'⟩, Subalgebra.mul_mem _ ?_ ?_⟩
    · exact Algebra.adjoin_mono (by simp) hxt
    · exact Algebra.adjoin_mono (by simp) hyt

variable {k : Type u} [Field k] {A : Type u} [CommRing A] [Bialgebra k A]

/-- A finitely generated bialgebra generated by its primitive elements has a finite primitive
generating tuple. -/
theorem exists_isPrimitiveGenerating [Algebra.FiniteType k A]
    (h : Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} = ⊤) :
    ∃ (s : ℕ) (y : Fin s → A), IsPrimitiveGenerating (k := k) y := by
  classical
  obtain ⟨S, hS⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k A).FG)
  have hmem : ∀ a ∈ S, ∃ t : Finset A,
      (t : Set A) ⊆ {x : A | Bialgebra.IsPrimitiveElem k x} ∧ a ∈ Algebra.adjoin k (t : Set A) :=
    fun a _ => exists_finset_of_mem_adjoin (h ▸ Algebra.mem_top)
  choose t ht hat using hmem
  set T : Finset A := S.attach.biUnion fun a => t a.1 a.2 with hT
  refine ⟨T.card, fun i => (T.equivFin.symm i : A), fun i => ?_, ?_⟩
  · obtain ⟨a, _, hx⟩ := Finset.mem_biUnion.1 (T.equivFin.symm i).2
    exact ht a.1 a.2 hx
  · rw [eq_top_iff, ← hS, Algebra.adjoin_le_iff]
    intro a ha
    refine Algebra.adjoin_mono ?_ (hat a ha)
    intro x hx
    refine ⟨T.equivFin ⟨x, Finset.mem_biUnion.2 ⟨⟨a, ha⟩, Finset.mem_attach _ _, hx⟩⟩, ?_⟩
    simp

/-- The restriction of a polynomial to the `i`-th coordinate axis. -/
def axisPoly {s : ℕ} (F : MvPolynomial (Fin s) k) (i : Fin s) : Polynomial k :=
  MvPolynomial.aeval (Pi.single i (Polynomial.X : Polynomial k)) F

theorem aeval_axisPoly {s : ℕ} (F : MvPolynomial (Fin s) k) (i : Fin s) {R : Type*} [CommRing R]
    [Algebra k R] (r : R) :
    Polynomial.aeval r (axisPoly F i) = MvPolynomial.aeval (Pi.single i r) F := by
  have hfun : (fun j => Polynomial.aeval r
      ((Pi.single i (Polynomial.X : Polynomial k) : Fin s → Polynomial k) j)) =
      Pi.single i r := by
    funext j
    by_cases h : j = i
    · subst h
      simp
    · simp [h]
  rw [axisPoly, MvPolynomial.comp_aeval_apply, hfun]

/-- A polynomial with vanishing additivity defect is the sum of its axis restrictions. -/
theorem aeval_eq_sum_axisPoly {s : ℕ} {F : MvPolynomial (Fin s) k} (hF : addDefect F = 0)
    {R : Type*} [CommRing R] [Algebra k R] (v : Fin s → R) :
    MvPolynomial.aeval v F = ∑ i, Polynomial.aeval (v i) (axisPoly F i) := by
  classical
  have h0 : MvPolynomial.aeval (0 : Fin s → R) F = 0 := by
    have := aeval_add_of_addDefect_eq_zero hF (0 : Fin s → R) 0
    rw [add_zero] at this
    exact (left_eq_add.1 this)
  have key : ∀ S : Finset (Fin s), MvPolynomial.aeval (∑ i ∈ S, Pi.single i (v i)) F =
      ∑ i ∈ S, MvPolynomial.aeval (Pi.single i (v i)) F := by
    intro S
    induction S using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty, h0]
    | insert a S ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, aeval_add_of_addDefect_eq_zero hF, ih]
  conv_lhs => rw [← Finset.univ_sum_single v]
  rw [key]
  exact Finset.sum_congr rfl fun i _ => (aeval_axisPoly F i (v i)).symm

theorem isAdditivePoly_axisPoly {s : ℕ} {F : MvPolynomial (Fin s) k} (hF : addDefect F = 0)
    (i : Fin s) : IsAdditivePoly (axisPoly F i) := fun R _ _ a b => by
  rw [aeval_axisPoly, aeval_axisPoly, aeval_axisPoly, Pi.single_add,
    aeval_add_of_addDefect_eq_zero hF]

variable [IsDomain A] (p : ℕ) [Fact p.Prime] [CharP k p] [PerfectRing k p]

include p in
/-- A primitive generating tuple of minimal length is algebraically independent. -/
theorem injective_aeval_of_minimal {s : ℕ} (y : Fin s → A) (hy : IsPrimitiveGenerating (k := k) y)
    (hmin : ∀ s' < s, ¬ ∃ y' : Fin s' → A, IsPrimitiveGenerating (k := k) y') :
    Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin s) k →ₐ[k] A) := by
  classical
  rw [injective_iff_map_eq_zero]
  intro F₀ hF₀
  by_contra hne
  have hrel : ∃ d, ∃ F : MvPolynomial (Fin s) k, F ≠ 0 ∧ MvPolynomial.aeval y F = 0 ∧
      F.totalDegree = d := ⟨_, F₀, hne, hF₀, rfl⟩
  obtain ⟨F, hF0, hFrel, hFd⟩ := Nat.find_spec hrel
  have hminF : ∀ G : MvPolynomial (Fin s) k, MvPolynomial.aeval y G = 0 →
      G.totalDegree < F.totalDegree → G = 0 := by
    intro G hG hlt
    by_contra hG0
    exact Nat.find_min hrel (hFd ▸ hlt) ⟨G, hG0, hG, rfl⟩
  have hadd := addDefect_eq_zero_of_minimal hy.1 hFrel hminF
  cases s with
  | zero =>
    have hc : F = MvPolynomial.C (F.coeff 0) := MvPolynomial.eq_C_of_isEmpty F
    rw [hc, MvPolynomial.aeval_C] at hFrel
    have : F.coeff 0 = 0 := (algebraMap k A).injective (by rw [hFrel, map_zero])
    exact hF0 (by rw [hc, this, map_zero])
  | succ s =>
    have hrelsum : ∑ i, Polynomial.aeval (y i) (axisPoly F i) = 0 := by
      rw [← aeval_eq_sum_axisPoly hadd, hFrel]
    have hne' : ∃ i, axisPoly F i ≠ 0 := by
      by_contra h
      push Not at h
      apply hF0
      have := aeval_eq_sum_axisPoly hadd (MvPolynomial.X : Fin (s + 1) → MvPolynomial (Fin (s + 1)) k)
      rw [MvPolynomial.aeval_X_left_apply] at this
      rw [this]
      exact Finset.sum_eq_zero fun i _ => by rw [h i, map_zero]
    obtain ⟨y', hy'⟩ := exists_isPrimitiveGenerating_of_relation p _ y (fun i => axisPoly F i)
      hy (fun i => isAdditivePoly_axisPoly hadd i) hne' hrelsum le_rfl
    exact hmin s (Nat.lt_succ_self s) ⟨y', hy'⟩

/-- **Polynomial structure of the coordinate algebra.** Let `k` be an algebraically closed field
of characteristic `p`, and `A` a finitely generated commutative and cocommutative bialgebra over
`k` which is a domain. If every `k`-point of `A` is killed by `p` in the convolution group, then
`A` is a polynomial algebra on finitely many primitive elements. -/
theorem exists_primitive_polynomial_coordinates [IsAlgClosed k] [IsCocomm k A]
    [Algebra.FiniteType k A] (hA : ∀ φ : A →ₐ[k] k, toConv φ.toLinearMap ^ p = 1) :
    ∃ (s : ℕ) (y : Fin s → A), (∀ i, Bialgebra.IsPrimitiveElem k (y i)) ∧
      Function.Bijective (MvPolynomial.aeval y : MvPolynomial (Fin s) k →ₐ[k] A) := by
  classical
  have hV : ∀ ξ ∈ augIdeal (k := k) (A := A), ξ ^ p = 0 :=
    fun ξ hξ => convPow_char_eq_zero p hA (mem_augIdeal.1 hξ)
  have hex := exists_isPrimitiveGenerating (adjoin_primitive_eq_top p hV)
  obtain ⟨y, hy⟩ := Nat.find_spec hex
  refine ⟨Nat.find hex, y, hy.1, injective_aeval_of_minimal p y hy
    fun s' hs' => Nat.find_min hex hs', ?_⟩
  rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
  exact hy.2

end Langlands.Algebra.PTorsionHopf
