import Langlands.Algebra.PTorsionHopf.PrimitiveProducts
import Mathlib.Data.Nat.Prime.Factorial

/-! # Bialgebras with vanishing Verschiebung are generated by primitive elements -/

noncomputable section

open Coalgebra WithConv TensorProduct

namespace Langlands.Algebra.PTorsionHopf

open Langlands.GroupScheme.AffineLinearEmbedding Langlands.GroupScheme.Chevalley

section Generic

/-- A product of elements of an ideal over a finite set lies in the power by its cardinality. -/
theorem prod_mem_pow_card {R ι : Type*} [CommRing R] [DecidableEq ι] (I : Ideal R) (x : ι → R)
    (s : Finset ι) (hx : ∀ i ∈ s, x i ∈ I) : ∏ i ∈ s, x i ∈ I ^ s.card := by
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha, pow_succ']
    exact Ideal.mul_mem_mul (hx a (Finset.mem_insert_self a s))
      (ih fun i hi => hx i (Finset.mem_insert_of_mem hi))

/-- Elements of `I ^ n` are sums of multiples of products of `n` elements of `I`. -/
theorem mem_pow_closure {R : Type*} [CommRing R] (I : Ideal R) (n : ℕ) :
    ∀ y ∈ I ^ n, y ∈ AddSubmonoid.closure
      {z | ∃ (d : R) (η : Fin n → R), (∀ t, η t ∈ I) ∧ z = d * ∏ t, η t} := by
  induction n with
  | zero =>
    intro y _
    exact AddSubmonoid.subset_closure ⟨y, Fin.elim0, fun t => t.elim0, by simp⟩
  | succ n ih =>
    intro y hy
    rw [pow_succ'] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro x hx z hz
      refine AddSubmonoid.closure_induction (motive := fun z _ => x * z ∈ AddSubmonoid.closure
        {z | ∃ (d : R) (η : Fin (n + 1) → R), (∀ t, η t ∈ I) ∧ z = d * ∏ t, η t}) ?_ ?_ ?_
        (ih z hz)
      · rintro _ ⟨d, η, hη, rfl⟩
        refine AddSubmonoid.subset_closure ⟨d, Fin.cons x η, ?_, ?_⟩
        · intro t
          refine Fin.cases ?_ (fun t => ?_) t
          · simpa using hx
          · simpa using hη t
        · rw [Fin.prod_univ_succ, Fin.cons_zero]
          simp only [Fin.cons_succ]
          ring
      · simp
      · intro u v _ _ hu hv
        rw [mul_add]
        exact AddSubmonoid.add_mem _ hu hv
    · intro u v hu hv
      exact AddSubmonoid.add_mem _ hu hv

end Generic

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Bialgebra k A] [IsCocomm k A]

/-- Elements killed by an ideal of the convolution dual. -/
def killedBy (J : Ideal (WithConv (A →ₗ[k] k))) : Submodule k A where
  carrier := {x | ∀ θ ∈ J, θ x = 0}
  add_mem' {x y} hx hy θ hθ := by rw [map_add, hx θ hθ, hy θ hθ, add_zero]
  zero_mem' θ _ := map_zero _
  smul_mem' c x hx θ hθ := by rw [map_smul, hx θ hθ, smul_zero]

omit [IsCocomm k A] in
theorem mem_killedBy {J : Ideal (WithConv (A →ₗ[k] k))} {x : A} :
    x ∈ killedBy J ↔ ∀ θ ∈ J, θ x = 0 := Iff.rfl

omit [IsCocomm k A] in
theorem smul_apply' (c : k) (θ : WithConv (A →ₗ[k] k)) (x : A) : (c • θ) x = c * θ x := rfl

omit [IsCocomm k A] in
theorem sub_apply' (θ η : WithConv (A →ₗ[k] k)) (x : A) : (θ - η) x = θ x - η x := rfl

omit [IsCocomm k A] in
theorem one_apply' (x : A) : (1 : WithConv (A →ₗ[k] k)) x = counit x := by
  rw [LinearMap.convOne_apply, Algebra.algebraMap_self, RingHom.id_apply]

omit [IsCocomm k A] in
/-- The component of a functional in the augmentation ideal. -/
theorem sub_smul_one_mem_augIdeal (θ : WithConv (A →ₗ[k] k)) :
    θ - θ 1 • 1 ∈ augIdeal (k := k) (A := A) := by
  rw [mem_augIdeal, sub_apply', smul_apply', convOne_apply_one, mul_one, sub_self]

omit [IsCocomm k A] in
/-- An element killed by the augmentation ideal is a scalar. -/
theorem eq_counit_smul_one_of_mem_killedBy {a : A} (ha : a ∈ killedBy (augIdeal (k := k))) :
    a = counit (R := k) a • (1 : A) := by
  rw [← sub_eq_zero]
  refine (Module.forall_dual_apply_eq_zero_iff k _).1 fun f => ?_
  have h := ha _ (sub_smul_one_mem_augIdeal (toConv f))
  rw [sub_apply', smul_apply', one_apply'] at h
  change f a - f 1 * counit a = 0 at h
  rw [map_sub, map_smul, smul_eq_mul, mul_comm]
  exact h

/-- An element of the augmentation kernel killed by the square of the augmentation ideal is
primitive. -/
theorem isPrimitiveElem_of_mem_killedBy {x : A} (hε : counit (R := k) x = 0)
    (hx : x ∈ killedBy (augIdeal (k := k) (A := A) ^ 2)) : Bialgebra.IsPrimitiveElem k x := by
  refine ⟨hε, ?_⟩
  apply tensor_ext
  intro g
  refine (Module.forall_dual_apply_eq_zero_iff k _).1 ?_ |> sub_eq_zero.1
  intro f
  rw [map_sub, sub_eq_zero]
  change f (rightAct g x) = _
  rw [← convMul_apply_eq_rightAct (toConv f) (toConv g) x]
  have hf := sub_smul_one_mem_augIdeal (toConv f)
  have hg := sub_smul_one_mem_augIdeal (toConv g)
  have h2 := hx _ (by rw [pow_two (augIdeal (k := k) (A := A))]; exact Ideal.mul_mem_mul hf hg)
  have hexp : toConv f * toConv g = (toConv f - toConv f 1 • 1) * (toConv g - toConv g 1 • 1) +
      toConv g 1 • (toConv f - toConv f 1 • 1) + toConv f 1 • (toConv g - toConv g 1 • 1) +
      (toConv f 1 * toConv g 1) • 1 := by
    simp only [sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one, smul_sub,
      smul_smul]
    abel_nf
  rw [hexp, add_apply', add_apply', add_apply', h2, smul_apply', smul_apply', smul_apply',
    sub_apply', sub_apply', smul_apply', smul_apply', one_apply', hε]
  simp only [map_add, LinearMap.lTensor_tmul, TensorProduct.rid_tmul, map_smul, smul_eq_mul,
    mul_zero, add_zero]
  ring

/-- A functional in the augmentation ideal vanishing on the primitive part of a
finite-dimensional subspace containing `1` agrees there with an element of the square of the
augmentation ideal. -/
theorem exists_mem_sq_eq_on (W : Submodule k A) [FiniteDimensional k W] (h1 : (1 : A) ∈ W)
    {η : WithConv (A →ₗ[k] k)} (hη : η ∈ augIdeal (k := k) (A := A))
    (hηV : ∀ x ∈ W, counit (R := k) x = 0 →
      x ∈ killedBy (augIdeal (k := k) (A := A) ^ 2) → η x = 0) :
    ∃ θ ∈ augIdeal (k := k) (A := A) ^ 2, ∀ w ∈ W, η w = θ w := by
  set U : Submodule k (Module.Dual k W) :=
    ((augIdeal (k := k) (A := A) ^ 2).restrictScalars k).map (restrictDual W)
  have hθ1 : ∀ θ ∈ augIdeal (k := k) (A := A) ^ 2, θ 1 = 0 := fun θ hθ =>
    mem_augIdeal.1 (Ideal.pow_le_self two_ne_zero hθ)
  have hmem : restrictDual W η ∈ U := by
    rw [← Subspace.dualCoannihilator_dualAnnihilator_eq (W := U), Submodule.mem_dualAnnihilator]
    intro w hw
    rw [Submodule.mem_dualCoannihilator] at hw
    have hk : (w : A) ∈ killedBy (augIdeal (k := k) (A := A) ^ 2) := fun θ hθ =>
      hw _ ⟨θ, hθ, rfl⟩
    have hv := hηV ((w : A) - counit (R := k) (w : A) • 1) (W.sub_mem w.2 (W.smul_mem _ h1))
      (by rw [map_sub, map_smul, Bialgebra.counit_one, smul_eq_mul, mul_one, sub_self])
      (fun θ hθ => by
        change θ.ofConv _ = 0
        rw [map_sub, map_smul]
        change θ w - _ • θ 1 = 0
        rw [hk θ hθ, hθ1 θ hθ, smul_zero, sub_zero])
    change η.ofConv _ = 0 at hv
    rw [map_sub, map_smul] at hv
    change η w - _ • η 1 = 0 at hv
    rw [mem_augIdeal.1 hη, smul_zero, sub_zero] at hv
    exact hv
  obtain ⟨θ, hθ, hθη⟩ := hmem
  exact ⟨θ, hθ, fun w hw => (LinearMap.congr_fun hθη ⟨w, hw⟩).symm⟩

/-- Under vanishing on primitive parts, an element killed by the `(m + 2)`-th power of the
augmentation ideal is killed by `η * Θ` for `Θ` in the `m`-th power. -/
theorem convMul_apply_eq_zero_of_vanish [DecidableEq A] {m : ℕ} {a : A}
    (ha : a ∈ killedBy (augIdeal (k := k) (A := A) ^ (m + 2)))
    {η : WithConv (A →ₗ[k] k)} (hη : η ∈ augIdeal (k := k) (A := A))
    (hηV : ∀ x ∈ regularSpan (K := k) ({a, 1} : Finset A), counit (R := k) x = 0 →
      x ∈ killedBy (augIdeal (k := k) (A := A) ^ 2) → η x = 0)
    {Θ : WithConv (A →ₗ[k] k)} (hΘ : Θ ∈ augIdeal (k := k) (A := A) ^ m) :
    (η * Θ) a = 0 := by
  obtain ⟨θ, hθ, hθη⟩ := exists_mem_sq_eq_on (regularSpan (K := k) ({a, 1} : Finset A))
    (subset_regularSpan _ (by simp)) hη hηV
  have hmem : θ * Θ ∈ augIdeal (k := k) (A := A) ^ (m + 2) := by
    have := Ideal.mul_mem_mul hθ hΘ
    rwa [← pow_add (augIdeal (k := k) (A := A)), add_comm] at this
  rw [convMul_apply_eq_rightAct,
    hθη _ (rightAct_mem_regularSpan _ _ (subset_regularSpan _ (by simp))),
    ← convMul_apply_eq_rightAct]
  exact ha (θ * Θ) hmem

omit [IsCocomm k A] in
theorem sum_apply' {ι : Type*} (s : Finset ι) (f : ι → WithConv (A →ₗ[k] k)) (x : A) :
    (∑ i ∈ s, f i) x = ∑ i ∈ s, f i x := by
  change (∑ i ∈ s, f i).ofConv x = _
  rw [WithConv.ofConv_sum, LinearMap.sum_apply]

/-- A product of dual basis functionals along a sequence of labels is the dual monomial of the
label counts. -/
theorem prod_comp_eq_dualMonomial {r M : ℕ} (ξ : Fin r → WithConv (A →ₗ[k] k))
    (j : Fin M → Fin r) :
    ∏ t, ξ (j t) = dualMonomial ξ (labelCount j Finset.univ) := by
  classical
  rw [dualMonomial, ← Finset.prod_fiberwise' Finset.univ j ξ]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [Finset.prod_const]
  rfl

theorem sum_labelCount {r M : ℕ} (j : Fin M → Fin r) :
    ∑ i, labelCount j Finset.univ i = M := by
  classical
  simp only [labelCount]
  rw [← Finset.card_eq_sum_card_fiberwise (fun t _ => Finset.mem_univ (j t)),
    Finset.card_univ, Fintype.card_fin]

/-- **Multilinear reduction.** Suppose `η - ∑ η(bᵢ) ξᵢ` vanishes on `V` for every `η` in the
augmentation ideal. If `g` is killed by all dual monomials of degree `m + 1`, and by `η * Θ`
whenever `η` vanishes on `V` and `Θ` lies in the `m`-th power of the augmentation ideal, then
`g` is killed by every product of `m + 1` elements of the augmentation ideal. -/
theorem prod_apply_eq_zero {r m : ℕ} (b : Fin r → A) (ξ : Fin r → WithConv (A →ₗ[k] k))
    (hξ : ∀ i, ξ i ∈ augIdeal (k := k) (A := A)) (V : Set A)
    (hdecomp : ∀ η ∈ augIdeal (k := k) (A := A), ∀ x ∈ V, (η - ∑ i, η (b i) • ξ i) x = 0)
    {g : A} (hmono : ∀ δ : Fin r → ℕ, ∑ i, δ i = m + 1 → dualMonomial ξ δ g = 0)
    (hvan : ∀ η ∈ augIdeal (k := k) (A := A), (∀ x ∈ V, η x = 0) →
      ∀ Θ ∈ augIdeal (k := k) (A := A) ^ m, (η * Θ) g = 0)
    (η : Fin (m + 1) → WithConv (A →ₗ[k] k)) (hη : ∀ t, η t ∈ augIdeal (k := k) (A := A)) :
    (∏ t, η t) g = 0 := by
  classical
  set lam : Fin (m + 1) → WithConv (A →ₗ[k] k) := fun t => ∑ i, η t (b i) • ξ i with hlamdef
  have hlam : ∀ t, lam t ∈ augIdeal (k := k) (A := A) := fun t =>
    Ideal.sum_mem _ fun i _ => Submodule.smul_of_tower_mem _ _ (hξ i)
  set η' : Fin (m + 1) → WithConv (A →ₗ[k] k) := fun t => η t - lam t with hη'def
  have hη'n : ∀ t, η' t ∈ augIdeal (k := k) (A := A) := fun t => Ideal.sub_mem _ (hη t) (hlam t)
  have hη'V : ∀ t, ∀ x ∈ V, η' t x = 0 := fun t x hx => hdecomp (η t) (hη t) x hx
  have hsplit : ∏ t, η t = ∏ t, (lam t + η' t) :=
    Finset.prod_congr rfl fun t _ => (add_sub_cancel (lam t) (η t)).symm
  rw [hsplit, Finset.prod_add, sum_apply']
  refine Finset.sum_eq_zero fun S _ => ?_
  by_cases hS : S = Finset.univ
  · subst hS
    rw [Finset.sdiff_self, Finset.prod_empty, mul_one, hlamdef, Finset.prod_univ_sum,
      sum_apply']
    refine Finset.sum_eq_zero fun j _ => ?_
    simp only [Algebra.smul_def]
    rw [Finset.prod_mul_distrib, ← map_prod, ← Algebra.smul_def, smul_apply',
      prod_comp_eq_dualMonomial, hmono _ (sum_labelCount j), mul_zero]
  · obtain ⟨t₀, ht₀⟩ : ∃ t₀, t₀ ∉ S := by
      by_contra h
      push Not at h
      exact hS (Finset.eq_univ_iff_forall.2 h)
    have ht₀' : t₀ ∈ Finset.univ \ S := Finset.mem_sdiff.2 ⟨Finset.mem_univ _, ht₀⟩
    rw [← Finset.mul_prod_erase _ _ ht₀', mul_left_comm]
    refine hvan (η' t₀) (hη'n t₀) (hη'V t₀) _ ?_
    have h1 := prod_mem_pow_card _ lam S fun t _ => hlam t
    have h2 := prod_mem_pow_card _ η' ((Finset.univ \ S).erase t₀) fun t _ => hη'n t
    have hcard : S.card + ((Finset.univ \ S).erase t₀).card = m := by
      rw [Finset.card_erase_of_mem ht₀', Finset.card_univ_sdiff, Fintype.card_fin]
      have : S.card < m + 1 := by
        have := Finset.card_lt_card (Finset.ssubset_univ_iff.2 hS)
        rwa [Finset.card_univ, Fintype.card_fin] at this
      omega
    have := Ideal.mul_mem_mul h1 h2
    rwa [← pow_add (augIdeal (k := k) (A := A)), hcard] at this

section Main

variable (p : ℕ) [Fact p.Prime] [CharP k p]

omit [IsCocomm k A] in
theorem factorial_prod_ne_zero {r : ℕ} {δ : Fin r → ℕ} (hδ : ∀ i, δ i < p) :
    ((∏ i, (δ i).factorial : ℕ) : k) ≠ 0 := by
  rw [Ne, CharP.cast_eq_zero_iff k p]
  intro h
  obtain ⟨i, _, hi⟩ := ((Nat.Prime.prime Fact.out).dvd_finsetProd_iff _).1 h
  exact absurd ((Nat.Prime.dvd_factorial Fact.out).1 hi) (not_le.2 (hδ i))

/-- **Generation by primitive elements, filtered form.** If every functional in the augmentation
ideal has vanishing `p`-th convolution power, then every element killed by the `(m + 1)`-th
power of the augmentation ideal is a polynomial in primitive elements. -/
theorem mem_adjoin_primitive_of_mem_killedBy
    (hV : ∀ ξ ∈ augIdeal (k := k) (A := A), ξ ^ p = 0) (m : ℕ) :
    ∀ a ∈ killedBy (augIdeal (k := k) (A := A) ^ (m + 1)),
      a ∈ Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} := by
  classical
  induction m with
  | zero =>
    intro a ha
    have ha' : a ∈ killedBy (augIdeal (k := k) (A := A)) := by
      rw [zero_add, pow_one (augIdeal (k := k) (A := A))] at ha
      exact ha
    rw [eq_counit_smul_one_of_mem_killedBy ha']
    exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) _
  | succ m ih =>
    intro a ha
    set W := regularSpan (K := k) ({a, 1} : Finset A) with hWdef
    set V : Submodule k A := W ⊓ LinearMap.ker (counit (R := k) (A := A)) ⊓
      killedBy (augIdeal (k := k) (A := A) ^ 2) with hVdef
    have hVmem : ∀ {x : A}, x ∈ V ↔
        (x ∈ W ∧ counit (R := k) x = 0) ∧ x ∈ killedBy (augIdeal (k := k) (A := A) ^ 2) := by
      intro x
      rw [hVdef, Submodule.mem_inf, Submodule.mem_inf, LinearMap.mem_ker]
    have : FiniteDimensional k V :=
      Submodule.finiteDimensional_of_le (inf_le_left.trans inf_le_left)
    set r := Module.finrank k V
    let bV : Module.Basis (Fin r) k V := Module.finBasis k V
    let b : Fin r → A := fun i => (bV i : A)
    have hbV : ∀ i, b i ∈ V := fun i => (bV i).2
    have hb : ∀ i, Bialgebra.IsPrimitiveElem k (b i) := fun i =>
      isPrimitiveElem_of_mem_killedBy (hVmem.1 (hbV i)).1.2 (hVmem.1 (hbV i)).2
    obtain ⟨P, hP⟩ := V.subtype.exists_leftInverse_of_injective V.ker_subtype
    have hPV : ∀ x (hx : x ∈ V), P x = ⟨x, hx⟩ := fun x hx => LinearMap.congr_fun hP ⟨x, hx⟩
    let ξ : Fin r → WithConv (A →ₗ[k] k) := fun i =>
      toConv (bV.coord i ∘ₗ P) - toConv (bV.coord i ∘ₗ P) 1 • 1
    have hξ : ∀ i, ξ i ∈ augIdeal (k := k) (A := A) := fun i => sub_smul_one_mem_augIdeal _
    have hξV : ∀ i, ∀ x (hx : x ∈ V), ξ i x = bV.coord i ⟨x, hx⟩ := by
      intro i x hx
      rw [show ξ i = toConv (bV.coord i ∘ₗ P) - toConv (bV.coord i ∘ₗ P) 1 • 1 from rfl,
        sub_apply', smul_apply', one_apply', (hVmem.1 hx).1.2, mul_zero, sub_zero]
      change bV.coord i (P x) = _
      rw [hPV x hx]
    have hξb : ∀ i j, ξ i (b j) = if i = j then 1 else 0 := by
      intro i j
      rw [hξV i (b j) (hbV j)]
      change bV.coord i (bV j) = _
      rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
      by_cases h : i = j
      · rw [ite_eq_left h.symm, ite_eq_left h]
      · rw [ite_eq_right (Ne.symm h), ite_eq_right h]
    have hdecomp : ∀ η ∈ augIdeal (k := k) (A := A), ∀ x ∈ (V : Set A),
        (η - ∑ i, η (b i) • ξ i) x = 0 := by
      intro η _ x hx
      rw [sub_apply', sum_apply']
      simp only [smul_apply', hξV _ x hx]
      have hx' : x = ∑ i, bV.coord i ⟨x, hx⟩ • b i := by
        have := congrArg Subtype.val (bV.sum_repr ⟨x, hx⟩)
        rw [Submodule.coe_sum] at this
        simpa [b, Module.Basis.coord_apply] using this.symm
      have hηx : η x = ∑ i, η (b i) * bV.coord i ⟨x, hx⟩ := by
        conv_lhs => rw [hx']
        change η.ofConv _ = _
        rw [map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_smul, smul_eq_mul, mul_comm]
      rw [hηx, sub_self]
    have hvanA : ∀ η ∈ augIdeal (k := k) (A := A), (∀ x ∈ (V : Set A), η x = 0) →
        ∀ Θ ∈ augIdeal (k := k) (A := A) ^ m, (η * Θ) a = 0 :=
      fun η hη hηV Θ hΘ => convMul_apply_eq_zero_of_vanish ha hη
        (fun x hxW hε hk => hηV x (hVmem.2 ⟨⟨hxW, hε⟩, hk⟩)) hΘ
    let G : Finset (Fin r → ℕ) :=
      (Fintype.piFinset fun _ => Finset.range p).filter (fun γ => ∑ i, γ i = m + 1)
    let Iγ : (Fin r → ℕ) → Finset (Σ _ : Fin r, ℕ) := fun γ =>
      Finset.univ.sigma fun i => Finset.range (γ i)
    let mono : (Fin r → ℕ) → A := fun γ => ∏ v ∈ Iγ γ, b v.1
    let f : A := ∑ γ ∈ G, (dualMonomial ξ γ a * ((∏ i, (γ i).factorial : ℕ) : k)⁻¹) • mono γ
    have hcardI : ∀ γ, (Iγ γ).card = ∑ i, γ i := fun γ => by simp [Iγ, Finset.card_sigma]
    have hlabel : ∀ γ, labelCount Sigma.fst (Iγ γ) = γ := fun γ => funext fun i => by
      simp only [labelCount, Iγ]
      rw [Finset.card_eq_sum_ones, Finset.sum_filter, Finset.sum_sigma]
      simp only [Finset.sum_boole, Nat.cast_id]
      simp
      rw [Finset.sum_eq_single i (fun x _ hx => by rw [ite_eq_right hx, Finset.card_empty])
        (by simp), ite_eq_left rfl, Finset.card_range]
    have hf : f ∈ Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} :=
      Subalgebra.sum_mem _ fun γ _ => Subalgebra.smul_mem _
        (Subalgebra.prod_mem _ fun v _ => Algebra.subset_adjoin (hb v.1)) _
    have hvanF : ∀ η ∈ augIdeal (k := k) (A := A), (∀ x ∈ (V : Set A), η x = 0) →
        ∀ Θ ∈ augIdeal (k := k) (A := A) ^ m, (η * Θ) f = 0 := by
      intro η hη hηV Θ hΘ
      change (η * Θ).ofConv _ = 0
      rw [map_sum]
      refine Finset.sum_eq_zero fun γ hγ => ?_
      rw [map_smul]
      change _ • (η * Θ) (mono γ) = 0
      rw [convMul_apply_prod_eq_sum (fun v => b v.1) (Iγ γ) (fun v _ => hb v.1) hη hΘ
        (by rw [hcardI, (Finset.mem_filter.1 hγ).2])]
      rw [Finset.sum_eq_zero fun v _ => by rw [hηV _ (hbV v.1), zero_mul], smul_zero]
    have hmono : ∀ δ : Fin r → ℕ, ∑ i, δ i = m + 1 → dualMonomial ξ δ (a - f) = 0 := by
      intro δ hδ
      by_cases hδp : ∀ i, δ i < p
      · have hδG : δ ∈ G := Finset.mem_filter.2
          ⟨Fintype.mem_piFinset.2 fun i => Finset.mem_range.2 (hδp i), hδ⟩
        change (dualMonomial ξ δ).ofConv (a - f) = 0
        rw [map_sub, sub_eq_zero, map_sum, Finset.sum_eq_single_of_mem δ hδG]
        · rw [map_smul]
          change _ = _ • dualMonomial ξ δ (mono δ)
          rw [dualMonomial_apply_prod hb hξ hξb Sigma.fst (m + 1) δ hδ (Iγ δ)
            (by rw [hcardI, hδ]), ite_eq_left (hlabel δ), smul_eq_mul, mul_assoc,
            inv_mul_cancel₀ (factorial_prod_ne_zero p hδp), mul_one]
        · intro γ hγ hne
          rw [map_smul]
          change _ • dualMonomial ξ δ (mono γ) = 0
          rw [dualMonomial_apply_prod hb hξ hξb Sigma.fst (m + 1) δ hδ (Iγ γ)
            (by rw [hcardI, (Finset.mem_filter.1 hγ).2]), hlabel, ite_eq_right hne, smul_zero]
      · push Not at hδp
        obtain ⟨i, hi⟩ := hδp
        have hzero : dualMonomial ξ δ = 0 := by
          rw [dualMonomial]
          refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
          rw [← Nat.sub_add_cancel hi, pow_add, hV _ (hξ i), mul_zero]
        rw [hzero]
        rfl
    have hkill : a - f ∈ killedBy (augIdeal (k := k) (A := A) ^ (m + 1)) := by
      intro θ hθ
      refine AddSubmonoid.closure_induction (motive := fun θ _ => θ (a - f) = 0) ?_ ?_ ?_
        (mem_pow_closure _ (m + 1) θ hθ)
      · rintro _ ⟨d, η, hη, rfl⟩
        have hupd : d * ∏ t, η t = ∏ t, Function.update η 0 (d * η 0) t := by
          rw [Fin.prod_univ_succ, Fin.prod_univ_succ, Function.update_self, mul_assoc]
          congr 2
        rw [hupd]
        refine prod_apply_eq_zero b ξ hξ V hdecomp hmono ?_ _ ?_
        · intro η hη hηV Θ hΘ
          change (η * Θ).ofConv (a - f) = 0
          rw [map_sub]
          change (η * Θ) a - (η * Θ) f = 0
          rw [hvanA η hη hηV Θ hΘ, hvanF η hη hηV Θ hΘ, sub_zero]
        · intro t
          by_cases ht : t = 0
          · subst ht
            rw [Function.update_self]
            exact Ideal.mul_mem_left _ _ (hη 0)
          · rw [Function.update_of_ne ht]
            exact hη t
      · rfl
      · intro x y _ _ hx hy
        rw [add_apply', hx, hy, add_zero]
    have h := ih (a - f) hkill
    rw [show a = (a - f) + f by ring]
    exact Subalgebra.add_mem _ h hf

/-- **Generation by primitive elements.** A cocommutative bialgebra over a field of
characteristic `p` in which every functional vanishing at `1` has vanishing `p`-th
convolution power is generated as an algebra by its primitive elements. -/
theorem adjoin_primitive_eq_top (hV : ∀ ξ ∈ augIdeal (k := k) (A := A), ξ ^ p = 0) :
    Algebra.adjoin k {x : A | Bialgebra.IsPrimitiveElem k x} = ⊤ := by
  refine eq_top_iff.2 fun a _ => ?_
  obtain ⟨N, hN⟩ := exists_pow_augIdeal_apply_eq_zero p hV a
  exact mem_adjoin_primitive_of_mem_killedBy p hV N a fun θ hθ =>
    hN θ (Ideal.pow_le_pow_right (Nat.le_succ N) hθ)

end Main

