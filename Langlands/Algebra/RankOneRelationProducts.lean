import Langlands.Algebra.RankOneRelationIdentities
import Mathlib.GroupTheory.NoncommPiCoprod

/-! # Products of commuting rank-one relation data

For a finite family of rank-one relation data whose root elements commute across distinct
indices, the product of the coroot values is the corresponding word in the products of the
root elements. -/

namespace Langlands.Algebra.RankOneRelation

variable {k H : Type*} [Field k] [Group H]

namespace Data

/-- The subgroup generated by the root elements of a rank-one datum. -/
def rootSubgroup (D : Data k H) : Subgroup H :=
  Subgroup.closure (Set.range D.xp ∪ Set.range D.xm)

theorem xp_mem (D : Data k H) (c : k) : D.xp c ∈ D.rootSubgroup :=
  Subgroup.subset_closure (Or.inl ⟨c, rfl⟩)

theorem xm_mem (D : Data k H) (c : k) : D.xm c ∈ D.rootSubgroup :=
  Subgroup.subset_closure (Or.inr ⟨c, rfl⟩)

theorem h_mem (D : Data k H) (u : kˣ) : D.h u ∈ D.rootSubgroup := by
  rw [D.h_eq_word]
  exact D.rootSubgroup.mul_mem (D.rootSubgroup.mul_mem (D.rootSubgroup.mul_mem
    (D.rootSubgroup.inv_mem (D.xm_mem _)) (D.xp_mem _)) (D.xm_mem _))
    (D.rootSubgroup.inv_mem (D.xp_mem _))

end Data

variable {ι : Type*} (D : ι → Data k H)

/-- Root elements of distinct members of the family commute. -/
def RootsCommute : Prop :=
  Pairwise fun i j => ∀ c d : k,
    Commute ((D i).xp c) ((D j).xp d) ∧ Commute ((D i).xp c) ((D j).xm d) ∧
      Commute ((D i).xm c) ((D j).xp d) ∧ Commute ((D i).xm c) ((D j).xm d)

variable {D}

/-- Commuting generators give commuting root subgroups. -/
theorem RootsCommute.subgroups (hD : RootsCommute D) :
    Pairwise fun i j => ∀ x y : H, x ∈ (D i).rootSubgroup → y ∈ (D j).rootSubgroup →
      Commute x y := by
  intro i j hij x y hx hy
  have hgen : ∀ a ∈ Set.range (D i).xp ∪ Set.range (D i).xm,
      ∀ b ∈ Set.range (D j).xp ∪ Set.range (D j).xm, Commute a b := by
    rintro a (⟨c, rfl⟩ | ⟨c, rfl⟩) b (⟨d, rfl⟩ | ⟨d, rfl⟩)
    · exact (hD hij c d).1
    · exact (hD hij c d).2.1
    · exact (hD hij c d).2.2.1
    · exact (hD hij c d).2.2.2
  induction hx using Subgroup.closure_induction with
  | mem a ha =>
    induction hy using Subgroup.closure_induction with
    | mem b hb => exact hgen a ha b hb
    | one => exact Commute.one_right _
    | mul _ _ _ _ h₁ h₂ => exact Commute.mul_right h₁ h₂
    | inv _ _ h => exact Commute.inv_right h
  | one => exact Commute.one_left _
  | mul _ _ _ _ h₁ h₂ => exact Commute.mul_left h₁ h₂
  | inv _ _ h => exact Commute.inv_left h

variable [Fintype ι]

/-- The product homomorphism on the family of root subgroups. -/
noncomputable def prodHom (hD : RootsCommute D) : (∀ i, (D i).rootSubgroup) →* H :=
  Subgroup.noncommPiCoprod hD.subgroups

/-- The product of the coroot values is the word of `h_eq_word` in the products of the root
elements. -/
theorem prodHom_h (hD : RootsCommute D) (u : ι → kˣ) :
    prodHom hD (fun i => ⟨(D i).h (u i), (D i).h_mem (u i)⟩) =
      (prodHom hD (fun i => ⟨(D i).xm ((u i : k)⁻¹ * ((u i : k) - 1)), (D i).xm_mem _⟩))⁻¹ *
        prodHom hD (fun i => ⟨(D i).xp 1, (D i).xp_mem _⟩) *
        prodHom hD (fun i => ⟨(D i).xm ((u i : k) - 1), (D i).xm_mem _⟩) *
        (prodHom hD (fun i => ⟨(D i).xp (u i : k)⁻¹, (D i).xp_mem _⟩))⁻¹ := by
  rw [← map_inv, ← map_inv, ← map_mul, ← map_mul, ← map_mul]
  congr 1
  funext i
  apply Subtype.ext
  simp only [Pi.mul_apply, Pi.inv_apply, Subgroup.coe_mul, Subgroup.coe_inv]
  exact (D i).h_eq_word (u i)

/-- The product is transported by a group endomorphism that permutes the factors. -/
theorem map_prodHom_of_perm (hD : RootsCommute D) (ψ : H →* H) (e : ι ≃ ι)
    (f g : ∀ i, (D i).rootSubgroup) (hfg : ∀ i, ψ (f i) = g (e i)) :
    ψ (prodHom hD f) = prodHom hD g := by
  rw [prodHom, Subgroup.noncommPiCoprod_apply, Subgroup.noncommPiCoprod_apply]
  have h := Finset.map_noncommProd Finset.univ (fun i => (f i : H))
    (fun i _ j _ hij => hD.subgroups hij _ _ (f i).prop (f j).prop) ψ
  rw [h]
  unfold Finset.noncommProd
  congr 1
  simp only [hfg]
  have hm := Multiset.map_map (fun i => (g i : H)) e Finset.univ.val
  rw [Multiset.map_univ_val_equiv] at hm
  exact hm.symm

end Langlands.Algebra.RankOneRelation
