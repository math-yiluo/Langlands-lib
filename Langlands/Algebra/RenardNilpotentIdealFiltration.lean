import Mathlib.Basic.Complex.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Ideal.Operations

/-! The actual generated ideal and its power-action filtration in Renard C.I. -/

noncomputable section

namespace Langlands.Renard.NilpotentFiltration

universe u

variable {V : Type u} [AddCommGroup V] [Module ℂ V]
  {l : ℕ} (a : Fin l → Module.End ℂ V)

/-- The source's actual unital endomorphism algebra `R`. -/
def generatedAlgebra : Subalgebra ℂ (Module.End ℂ V) :=
  Algebra.adjoin ℂ (Set.range a)

/-- A listed endomorphism viewed as an element of its actual generated algebra. -/
def generator (i : Fin l) : generatedAlgebra a :=
  ⟨a i, Algebra.subset_adjoin (Set.mem_range_self i)⟩

/-- The ideal generated by the actual tuple inside its generated algebra.
For an arbitrary tuple this is the left ideal; under commutation the algebra
is commutative and it is the usual two-sided source ideal. -/
def generatorIdeal : Ideal (generatedAlgebra a) :=
  Ideal.span (Set.range (generator a))

/-- The actual `R`-submodule `I^n V`, using the original endomorphism action. -/
def idealPowerModule (n : ℕ) : Submodule (generatedAlgebra a) V :=
  (generatorIdeal a) ^ n • (⊤ : Submodule (generatedAlgebra a) V)

/-- The complex subspace `V_n = I^n V` obtained by restricting scalars. -/
def idealPowerSubspace (n : ℕ) : Submodule ℂ V :=
  (idealPowerModule a n).restrictScalars ℂ

@[simp] theorem generator_val (i : Fin l) :
    (generator a i : Module.End ℂ V) = a i := rfl

/-- Tuple commutation gives commutativity of the actual generated algebra. -/
theorem generatedAlgebra_isMulCommutative
    (hcomm : ∀ i j, Commute (a i) (a j)) :
    IsMulCommutative (generatedAlgebra a) := by
  apply Algebra.isMulCommutative_adjoin ℂ
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
  exact hcomm i j

/-- Every actual generator belongs to the actual generated ideal. -/
theorem generator_mem_ideal (i : Fin l) :
    generator a i ∈ generatorIdeal a :=
  Ideal.subset_span (Set.mem_range_self i)

@[simp] theorem idealPowerModule_zero :
    idealPowerModule a 0 = ⊤ := by
  simp [idealPowerModule, Submodule.pow_zero, Ideal.one_eq_top]

@[simp] theorem idealPowerSubspace_zero :
    idealPowerSubspace a 0 = ⊤ := by
  simp [idealPowerSubspace]

/-- Ideal powers act successively on the original `R`-module. -/
theorem idealPowerModule_succ (n : ℕ) :
    idealPowerModule a (n + 1) = generatorIdeal a • idealPowerModule a n := by
  obtain rfl | hn := eq_or_ne n 0
  · simp [idealPowerModule, Submodule.pow_one, Submodule.pow_zero, Ideal.one_eq_top]
  · unfold idealPowerModule
    rw [Submodule.pow_succ' _ hn, Submodule.mul_smul]

/-- The power-action submodules form a descending family. -/
theorem idealPowerModule_antitone : Antitone (idealPowerModule a) := by
  intro m n hmn
  exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn)

/-- The complex source subspaces form the same descending family. -/
theorem idealPowerSubspace_antitone : Antitone (idealPowerSubspace a) := by
  intro m n hmn v hv
  exact idealPowerModule_antitone a hmn hv

/-- Every filtration level is stable under the whole actual generated algebra. -/
theorem idealPowerSubspace_stable (n : ℕ) (r : generatedAlgebra a)
    {v : V} (hv : v ∈ idealPowerSubspace a n) :
    (r : Module.End ℂ V) v ∈ idealPowerSubspace a n :=
  (idealPowerModule a n).smul_mem r hv

/-- The image of each listed generator lies in `V_1`. -/
theorem generator_apply_mem_one (i : Fin l) (v : V) :
    a i v ∈ idealPowerSubspace a 1 := by
  change generator a i • v ∈
    (generatorIdeal a) ^ 1 • (⊤ : Submodule (generatedAlgebra a) V)
  rw [Submodule.pow_one]
  exact Submodule.smul_mem_smul (generator_mem_ideal a i) Submodule.mem_top

end Langlands.Renard.NilpotentFiltration
