import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.Finsupp.Supported
import Mathlib.Order.WellFounded

/-! # Linear normalization for well-founded triangular reductions -/

noncomputable section

universe u v

set_option autoImplicit false

namespace Langlands.Algebra.TriangularNormalization

variable {k : Type u} [CommRing k] {W : Type v}
variable (r : W → W → Prop) (wf : WellFounded r)
variable (rule : W → (W →₀ k) → Prop)

/-- A word is irreducible when it has no right-hand side. -/
def Irreducible (w : W) : Prop := ¬ ∃ p, rule w p

/-- All terms on a right-hand side precede its left-hand word. -/
def Triangular : Prop := ∀ w p, rule w p → ∀ v ∈ p.support, r v w

/-- Each choice of a right-hand side has the same image under every linear map
that already respects the strictly smaller reductions. -/
def Coherent : Prop :=
  ∀ w p q, rule w p → rule w q → ∀ f : (W →₀ k) →ₗ[k] (W →₀ k),
    (∀ v s, r v w → rule v s → f (Finsupp.single v 1) = f s) → f p = f q

private def normalizeStep (w : W) (rec : ∀ v, r v w → (W →₀ k)) : W →₀ k := by
  classical
  exact if h : ∃ p, rule w p then
    (Classical.choose h).sum fun v a => a • (if hv : r v w then rec v hv else 0)
  else Finsupp.single w 1

/-- Normalize a word by any available triangular reduction. -/
def normalizeWord : W → (W →₀ k) := wf.fix (normalizeStep r rule)

/-- Extend word normalization linearly to finite formal sums. -/
def normalize : (W →₀ k) →ₗ[k] (W →₀ k) :=
  Finsupp.linearCombination k (normalizeWord r wf rule)

@[simp]
theorem normalize_single (w : W) (a : k) :
    normalize r wf rule (Finsupp.single w a) = a • normalizeWord r wf rule w := by
  simp [normalize]

private theorem normalizeWord_eq (w : W) :
    normalizeWord r wf rule w =
      normalizeStep r rule w (fun v _ => normalizeWord r wf rule v) := by
  exact wf.fix_eq (normalizeStep r rule) w

/-- An irreducible word is fixed. -/
theorem normalizeWord_irreducible {w : W} (hw : Irreducible rule w) :
    normalizeWord r wf rule w = Finsupp.single w 1 := by
  classical
  rw [normalizeWord_eq]
  change ¬ ∃ p, rule w p at hw
  simp only [normalizeStep, dite_eq_right hw]

private theorem normalizeWord_selected (ht : Triangular r rule) {w : W}
    (h : ∃ p, rule w p) :
    normalizeWord r wf rule w = normalize r wf rule (Classical.choose h) := by
  classical
  rw [normalizeWord_eq]
  simp only [normalizeStep, dite_eq_left h, normalize, Finsupp.linearCombination_apply]
  apply Finset.sum_congr rfl
  intro v hv
  simp only [ht w _ (Classical.choose_spec h) v hv, ↓reduceDIte]

/-- Local coherence implies that normalization respects every reduction. -/
theorem normalizeWord_rule (ht : Triangular r rule) (hc : Coherent r rule) :
    ∀ w p, rule w p → normalizeWord r wf rule w = normalize r wf rule p := by
  classical
  intro w
  induction w using wf.induction with
  | h w ih =>
    intro p hp
    let hex : ∃ q, rule w q := ⟨p, hp⟩
    rw [normalizeWord_selected r wf rule ht hex]
    apply hc w _ p (Classical.choose_spec hex) hp (normalize r wf rule)
    intro v s hv hs
    simpa using ih v hv s hs

/-- The submodule generated by all differences between a left-hand word and a
right-hand side. Contextual rewriting can include the contexts in `rule`. -/
def relations : Submodule k (W →₀ k) :=
  Submodule.span k {x | ∃ w p, rule w p ∧ x = Finsupp.single w 1 - p}

/-- Every rewriting relation is killed by the normalizer. -/
theorem relations_le_ker (ht : Triangular r rule) (hc : Coherent r rule) :
    relations rule ≤ LinearMap.ker (normalize r wf rule) := by
  apply Submodule.span_le.mpr
  rintro x ⟨w, p, hp, rfl⟩
  change normalize r wf rule (Finsupp.single w 1 - p) = 0
  simp [normalizeWord_rule r wf rule ht hc w p hp]

/-- Normalization changes a word only by a linear combination of relations. -/
theorem word_sub_normalizeWord_mem_relations (ht : Triangular r rule) :
    ∀ w, Finsupp.single w 1 - normalizeWord r wf rule w ∈ relations rule := by
  classical
  intro w
  induction w using wf.induction with
  | h w ih =>
    by_cases hex : ∃ p, rule w p
    · let p := Classical.choose hex
      have hp : rule w p := Classical.choose_spec hex
      have hrel : Finsupp.single w 1 - p ∈ relations rule :=
        Submodule.subset_span ⟨w, p, hp, rfl⟩
      have hsum : p - normalize r wf rule p ∈ relations rule := by
        have hs : p.sum (fun v a => a • (Finsupp.single v 1 -
            normalizeWord r wf rule v)) ∈ relations rule := by
          apply Submodule.sum_mem
          intro v hv
          exact (relations rule).smul_mem _ (ih v (ht w p hp v hv))
        convert hs using 1
        simp only [normalize, Finsupp.linearCombination_apply, smul_sub,
          Finsupp.sum_sub, Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.sum_single]
      rw [normalizeWord_selected r wf rule ht hex]
      simpa only [sub_add_sub_cancel] using (relations rule).add_mem hrel hsum
    · rw [normalizeWord_irreducible r wf rule hex, sub_self]
      exact (relations rule).zero_mem

/-- Every formal sum differs from its normal form by relations. -/
theorem sub_normalize_mem_relations (ht : Triangular r rule) (p : W →₀ k) :
    p - normalize r wf rule p ∈ relations rule := by
  classical
  have hs : p.sum (fun w a => a • (Finsupp.single w 1 -
      normalizeWord r wf rule w)) ∈ relations rule := by
    apply Submodule.sum_mem
    intro w hw
    exact (relations rule).smul_mem _ (word_sub_normalizeWord_mem_relations r wf rule ht w)
  convert hs using 1
  simp only [normalize, Finsupp.linearCombination_apply, smul_sub,
    Finsupp.sum_sub, Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.sum_single]

/-- A normalized word is supported on irreducible words. -/
theorem normalizeWord_mem_supported (ht : Triangular r rule) :
    ∀ w, normalizeWord r wf rule w ∈
      Finsupp.supported k k {v | Irreducible rule v} := by
  classical
  intro w
  induction w using wf.induction with
  | h w ih =>
    by_cases hex : ∃ p, rule w p
    · rw [normalizeWord_selected r wf rule ht hex]
      change (Classical.choose hex).sum _ ∈ _
      apply Submodule.sum_mem
      intro v hv
      exact Submodule.smul_mem _ _ (ih v (ht w _ (Classical.choose_spec hex) v hv))
    · rw [normalizeWord_irreducible r wf rule hex]
      exact Finsupp.single_mem_supported k 1 hex

/-- Every normal form is supported on irreducible words. -/
theorem normalize_mem_supported (ht : Triangular r rule) (p : W →₀ k) :
    normalize r wf rule p ∈ Finsupp.supported k k {v | Irreducible rule v} := by
  classical
  apply Submodule.sum_mem
  intro w hw
  exact Submodule.smul_mem _ _ (normalizeWord_mem_supported r wf rule ht w)

/-- A formal sum already supported on irreducible words is fixed. -/
theorem normalize_eq_self {p : W →₀ k}
    (hp : p ∈ Finsupp.supported k k {v | Irreducible rule v}) :
    normalize r wf rule p = p := by
  classical
  change p.sum (fun w a => a • normalizeWord r wf rule w) = p
  conv_rhs => rw [← p.sum_single]
  apply Finset.sum_congr rfl
  intro w hw
  simp only [normalizeWord_irreducible r wf rule (hp hw), Finsupp.smul_single,
    smul_eq_mul, mul_one]

/-- Applying normalization twice gives the same result. -/
theorem normalize_idempotent (ht : Triangular r rule) (p : W →₀ k) :
    normalize r wf rule (normalize r wf rule p) = normalize r wf rule p :=
  normalize_eq_self r wf rule (normalize_mem_supported r wf rule ht p)

/-- The kernel consists exactly of the span of rewriting differences. -/
theorem ker_normalize (ht : Triangular r rule) (hc : Coherent r rule) :
    LinearMap.ker (normalize r wf rule) = relations rule := by
  apply le_antisymm
  · intro p hp
    have h := sub_normalize_mem_relations r wf rule ht p
    change normalize r wf rule p = 0 at hp
    simpa only [hp, sub_zero] using h
  · exact relations_le_ker r wf rule ht hc

/-- Normal forms give unique representatives modulo rewriting differences. -/
theorem normalize_eq_iff_sub_mem (ht : Triangular r rule) (hc : Coherent r rule)
    (p q : W →₀ k) :
    normalize r wf rule p = normalize r wf rule q ↔ p - q ∈ relations rule := by
  rw [← ker_normalize r wf rule ht hc]
  simp only [LinearMap.mem_ker, map_sub, sub_eq_zero]

/-- The image of normalization is precisely the module of irreducible sums. -/
theorem range_normalize (ht : Triangular r rule) :
    LinearMap.range (normalize r wf rule) =
      Finsupp.supported k k {v | Irreducible rule v} := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    exact normalize_mem_supported r wf rule ht p
  · intro p hp
    exact ⟨p, normalize_eq_self r wf rule hp⟩

end Langlands.Algebra.TriangularNormalization
