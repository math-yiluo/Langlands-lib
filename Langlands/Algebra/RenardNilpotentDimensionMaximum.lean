import Mathlib.Basic.Complex.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix
import Mathlib.Order.Lattice.Nat
import Mathlib.RingTheory.Adjoin.Basic

/-! The actual nilpotent-generated dimension maximum in Renard 2026, Appendix C.I. -/

noncomputable section

namespace Langlands.Renard

universe u

/-- Possible dimensions of the actual unital algebras generated by `l` commuting
nilpotent endomorphisms of the given complex vector space. -/
def nilpotentGeneratedDimensions (l : ℕ) (V : Type u)
    [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V] : Set ℕ :=
  {d | ∃ a : Fin l → Module.End ℂ V,
    (∀ i j, Commute (a i) (a j)) ∧
    (∀ i, IsNilpotent (a i)) ∧
    Module.finrank ℂ (Algebra.adjoin ℂ (Set.range a)) = d}

/-- The largest possible dimension, implemented as the natural supremum of the
actual dimension set. Its membership and greatest-element law are proved below. -/
def nilpotentGeneratedMaxDimension (l : ℕ) (V : Type u)
    [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V] : ℕ :=
  sSup (nilpotentGeneratedDimensions l V)

/-- The canonical-carrier specialization of the nilpotent-generated maximum.
Identification with the maximum on an arbitrary dimension-`k` carrier is separate. -/
def nilpotentGeneratedPhi (l k : ℕ) : ℕ :=
  nilpotentGeneratedMaxDimension l (Fin k → ℂ)

variable (l : ℕ) (V : Type u)
  [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]

/-- The zero tuple is admissible, also for no generators and for the zero space. -/
theorem nilpotentGeneratedDimensions_nonempty :
    (nilpotentGeneratedDimensions l V).Nonempty := by
  refine ⟨Module.finrank ℂ
    (Algebra.adjoin ℂ (Set.range (fun _ : Fin l => (0 : Module.End ℂ V)))),
    (fun _ => 0), ?_, ?_, rfl⟩
  · intro i j
    exact Commute.refl 0
  · intro i
    exact IsNilpotent.zero

/-- Inclusion in the ambient endomorphism space bounds every possible dimension. -/
theorem nilpotentGeneratedDimensions_le {d : ℕ}
    (hd : d ∈ nilpotentGeneratedDimensions l V) :
    d ≤ (Module.finrank ℂ V) ^ 2 := by
  obtain ⟨a, _, _, rfl⟩ := hd
  calc
    Module.finrank ℂ (Algebra.adjoin ℂ (Set.range a)) ≤
        Module.finrank ℂ (Module.End ℂ V) :=
      Submodule.finrank_le (Algebra.adjoin ℂ (Set.range a)).toSubmodule
    _ = (Module.finrank ℂ V) ^ 2 := by
      rw [Module.finrank_linearMap, pow_two]

/-- The exact set of possible dimensions is bounded without a sharp estimate. -/
theorem nilpotentGeneratedDimensions_bddAbove :
    BddAbove (nilpotentGeneratedDimensions l V) :=
  ⟨(Module.finrank ℂ V) ^ 2, fun _ hd => nilpotentGeneratedDimensions_le l V hd⟩

/-- The defined supremum belongs to the exact dimension set and bounds it above. -/
theorem nilpotentGeneratedMaxDimension_isGreatest :
    IsGreatest (nilpotentGeneratedDimensions l V)
      (nilpotentGeneratedMaxDimension l V) := by
  exact ⟨Nat.sSup_mem (nilpotentGeneratedDimensions_nonempty l V)
    (nilpotentGeneratedDimensions_bddAbove l V),
    fun _ hd => le_csSup (nilpotentGeneratedDimensions_bddAbove l V) hd⟩

/-- An actual commuting nilpotent tuple attains the defined maximum. -/
theorem nilpotentGeneratedMaxDimension_attained :
    ∃ a : Fin l → Module.End ℂ V,
      (∀ i j, Commute (a i) (a j)) ∧
      (∀ i, IsNilpotent (a i)) ∧
      Module.finrank ℂ (Algebra.adjoin ℂ (Set.range a)) =
        nilpotentGeneratedMaxDimension l V :=
  (nilpotentGeneratedMaxDimension_isGreatest l V).1

/-- Every admissible actual tuple is bounded by the constructed maximum. -/
theorem finrank_adjoin_le_nilpotentGeneratedMaxDimension
    (a : Fin l → Module.End ℂ V)
    (hcomm : ∀ i j, Commute (a i) (a j))
    (hnil : ∀ i, IsNilpotent (a i)) :
    Module.finrank ℂ (Algebra.adjoin ℂ (Set.range a)) ≤
      nilpotentGeneratedMaxDimension l V :=
  (nilpotentGeneratedMaxDimension_isGreatest l V).2 ⟨a, hcomm, hnil, rfl⟩

/-- The maximum itself satisfies the ambient endomorphism dimension bound. -/
theorem nilpotentGeneratedMaxDimension_le :
    nilpotentGeneratedMaxDimension l V ≤ (Module.finrank ℂ V) ^ 2 :=
  nilpotentGeneratedDimensions_le l V
    (nilpotentGeneratedMaxDimension_isGreatest l V).1

/-- On a zero-dimensional carrier the constructed maximum is zero. -/
theorem nilpotentGeneratedMaxDimension_eq_zero_of_finrank_eq_zero
    (hV : Module.finrank ℂ V = 0) :
    nilpotentGeneratedMaxDimension l V = 0 := by
  apply Nat.eq_zero_of_le_zero
  simpa only [hV, zero_pow (by decide : 2 ≠ 0)] using
    nilpotentGeneratedMaxDimension_le l V

/-- The canonical zero-dimensional specialization is zero for every generator count. -/
@[simp] theorem nilpotentGeneratedPhi_zero :
    nilpotentGeneratedPhi l 0 = 0 := by
  apply nilpotentGeneratedMaxDimension_eq_zero_of_finrank_eq_zero
  simp

end Langlands.Renard
