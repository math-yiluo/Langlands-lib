import Mathlib.RingTheory.Extension.Presentation.Core
import Mathlib.RingTheory.Flat.Localization
import Mathlib.RingTheory.Flat.Stability
import Mathlib.RingTheory.Localization.BaseChange
import Mathlib.RingTheory.Localization.LocalizationLocalization

/-! # Finite stages of a presentation over finitely generated subrings -/

open TensorProduct

namespace Langlands.Algebra.FinitePresentationStages

variable {A B ι σ : Type*} [CommRing A] [CommRing B] [Algebra A B]
  (P : Algebra.Presentation A B ι σ)

/-- The base ring of the stage `t`: the subring generated by the coefficients of the
relations of `P` and the finite set `t`. -/
noncomputable def base (t : Finset A) : Subalgebra ℤ A :=
  Algebra.adjoin ℤ (P.coeffs ∪ (t : Set A))

theorem coeffs_subset_base (t : Finset A) : P.coeffs ⊆ base P t :=
  fun _ hx ↦ Algebra.subset_adjoin (Or.inl hx)

theorem mem_base_of_mem {t : Finset A} {a : A} (ha : a ∈ t) : a ∈ base P t :=
  Algebra.subset_adjoin (Or.inr ha)

theorem base_mono {t t' : Finset A} (h : t ⊆ t') : base P t ≤ base P t' :=
  Algebra.adjoin_mono (Set.union_subset_union_right _ (Finset.coe_subset.mpr h))

instance (t : Finset A) : P.HasCoeffs (base P t) where
  coeffs_subset_range := fun x hx ↦ ⟨⟨x, coeffs_subset_base P t hx⟩, rfl⟩

instance [Finite σ] (t : Finset A) : Algebra.FiniteType ℤ (base P t) :=
  .adjoin_of_finite (P.finite_coeffs.union t.finite_toSet)

instance [Finite σ] (t : Finset A) : IsNoetherianRing (base P t) :=
  Algebra.FiniteType.isNoetherianRing ℤ _

/-- The model of `B` over the stage base ring: the polynomial ring over `base P t`
modulo the descended relations. -/
abbrev model (t : Finset A) : Type _ := P.ModelOfHasCoeffs (base P t)

/-- The canonical map from the stage model to `B`. -/
noncomputable def toB (t : Finset A) : model P t →ₐ[base P t] B :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval P.val) <| by
    simp_rw [← RingHom.mem_ker, ← SetLike.le_def, Ideal.span_le]
    rintro a ⟨i, rfl⟩
    simp

@[simp] theorem toB_mk (t : Finset A) (F : MvPolynomial ι (base P t)) :
    toB P t (Ideal.Quotient.mk _ F) = MvPolynomial.aeval P.val F := rfl

/-- The images of the variables in the stage model. -/
noncomputable def gen (t : Finset A) (i : ι) : model P t :=
  Ideal.Quotient.mk _ (MvPolynomial.X i)

theorem aeval_gen (t : Finset A) (F : MvPolynomial ι (base P t)) :
    MvPolynomial.aeval (gen P t) F = (Ideal.Quotient.mk _ F : model P t) := by
  have := DFunLike.congr_fun (MvPolynomial.comp_aeval (R := base P t) MvPolynomial.X
    (Ideal.Quotient.mkₐ (base P t) (Ideal.span (Set.range (P.relationOfHasCoeffs (base P t))))))
    F
  simp only [AlgHom.coe_comp, Function.comp_apply, MvPolynomial.aeval_X_left_apply,
    Ideal.Quotient.mkₐ_eq_mk] at this
  exact this.symm

/-- The Mathlib comparison `A ⊗[base P t] model P t ≃ₐ[A] B` restricts to `toB` on `1 ⊗ x`. -/
theorem tensorModelOfHasCoeffsEquiv_one_tmul (t : Finset A) (x : model P t) :
    P.tensorModelOfHasCoeffsEquiv (base P t) (1 ⊗ₜ x) = toB P t x := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  change algebraMap A B 1 * MvPolynomial.aeval P.val F = _
  rw [map_one, one_mul]
  rfl

/-- Every stage gives a model of `B` over a subring of finite type over `ℤ`. -/
theorem nonempty_tensor_model (t : Finset A) :
    Nonempty (A ⊗[base P t] model P t ≃ₐ[A] B) :=
  ⟨P.tensorModelOfHasCoeffsEquiv (base P t)⟩

instance [Finite ι] [Finite σ] (t : Finset A) :
    Algebra.FinitePresentation (base P t) (model P t) := inferInstance

section Transition

variable {P} {t t' t'' : Finset A}

/-- The descended relations are compatible with enlarging the stage. -/
theorem map_relationOfHasCoeffs (h : t ⊆ t') (r : σ) :
    MvPolynomial.map (Subalgebra.inclusion (base_mono P h)).toRingHom
      (P.relationOfHasCoeffs (base P t) r) = P.relationOfHasCoeffs (base P t') r := by
  apply MvPolynomial.map_injective (algebraMap (base P t') A) Subtype.val_injective
  rw [MvPolynomial.map_map, P.map_relationOfHasCoeffs]
  exact P.map_relationOfHasCoeffs (base P t) r

variable (P) in
/-- The transition ring map between stage models. -/
noncomputable def trans (h : t ⊆ t') : model P t →+* model P t' :=
  Ideal.Quotient.lift _ ((Ideal.Quotient.mk _).comp
      (MvPolynomial.map (Subalgebra.inclusion (base_mono P h)).toRingHom)) <| by
    have hle : Ideal.span (Set.range (P.relationOfHasCoeffs (base P t))) ≤
        (Ideal.span (Set.range (P.relationOfHasCoeffs (base P t')))).comap
          (MvPolynomial.map (Subalgebra.inclusion (base_mono P h)).toRingHom) := by
      rw [Ideal.span_le]
      rintro _ ⟨r, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, map_relationOfHasCoeffs h r]
      exact Ideal.subset_span ⟨r, rfl⟩
    intro F hF
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hle hF

theorem trans_mk (h : t ⊆ t') (F : MvPolynomial ι (base P t)) :
    trans P h (Ideal.Quotient.mk _ F) =
      Ideal.Quotient.mk _ (MvPolynomial.map (Subalgebra.inclusion (base_mono P h)).toRingHom F) :=
  rfl

theorem trans_algebraMap (h : t ⊆ t') (a : base P t) :
    trans P h (algebraMap (base P t) (model P t) a) =
      algebraMap (base P t') (model P t') (Subalgebra.inclusion (base_mono P h) a) := by
  change Ideal.Quotient.mk _ (MvPolynomial.map _ (MvPolynomial.C a)) =
    Ideal.Quotient.mk _ (MvPolynomial.C _)
  rw [MvPolynomial.map_C]
  rfl

@[simp] theorem trans_gen (h : t ⊆ t') (i : ι) : trans P h (gen P t i) = gen P t' i := by
  rw [gen, trans_mk, MvPolynomial.map_X]
  rfl

@[simp] theorem toB_trans (h : t ⊆ t') (x : model P t) :
    toB P t' (trans P h x) = toB P t x := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [trans_mk, toB_mk, toB_mk, MvPolynomial.aeval_def, MvPolynomial.aeval_def,
    MvPolynomial.eval₂_map]
  rfl

@[simp] theorem trans_refl (x : model P t) : trans P (subset_refl t) x = x := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [trans_mk]
  congr 1
  conv_rhs => rw [← MvPolynomial.map_id F]
  rfl

theorem trans_trans (h₁ : t ⊆ t') (h₂ : t' ⊆ t'') (x : model P t) :
    trans P h₂ (trans P h₁ x) = trans P (h₁.trans h₂) x := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [trans_mk, trans_mk, trans_mk, MvPolynomial.map_map]
  rfl

end Transition

section Lifting

/-- Every element of `B` comes from some stage containing a given finite set. -/
theorem exists_lift (t₀ : Finset A) (b : B) :
    ∃ t, t₀ ⊆ t ∧ ∃ x : model P t, toB P t x = b := by
  classical
  obtain ⟨F, hF⟩ := P.aeval_val_surjective b
  refine ⟨t₀ ∪ F.coeffs, Finset.subset_union_left, ?_⟩
  have hmem : F ∈ Set.range (MvPolynomial.map (algebraMap (base P (t₀ ∪ F.coeffs)) A)) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro a ha
    exact ⟨⟨a, mem_base_of_mem P (Finset.mem_union_right _ ha)⟩, rfl⟩
  obtain ⟨G, hG⟩ := hmem
  refine ⟨Ideal.Quotient.mk _ G, ?_⟩
  have hGF := congrArg (MvPolynomial.aeval P.val) hG
  rw [MvPolynomial.aeval_map_algebraMap] at hGF
  rw [toB_mk, hGF, hF]

/-- An element of a stage killed in `B` is killed at some later stage. -/
theorem exists_trans_eq_zero [Finite σ] {t : Finset A} (x : model P t)
    (hx : toB P t x = 0) : ∃ t', ∃ h : t ⊆ t', trans P h x = 0 := by
  classical
  cases nonempty_fintype σ
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [toB_mk] at hx
  have hker : MvPolynomial.map (algebraMap (base P t) A) F ∈ P.ker := by
    rw [P.ker_eq_ker_aeval_val, RingHom.mem_ker, MvPolynomial.aeval_map_algebraMap]
    exact hx
  rw [← P.span_range_relation_eq_ker, Ideal.mem_span_range_iff_exists_fun] at hker
  obtain ⟨c, hc⟩ := hker
  let t' := t ∪ Finset.univ.biUnion fun r ↦ (c r).coeffs
  have h : t ⊆ t' := Finset.subset_union_left
  have hlift (r : σ) : c r ∈ Set.range (MvPolynomial.map (algebraMap (base P t') A)) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro a ha
    exact ⟨⟨a, mem_base_of_mem P (Finset.mem_union_right _
      (Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ _, ha⟩))⟩, rfl⟩
  choose d hd using hlift
  refine ⟨t', h, ?_⟩
  rw [trans_mk, Ideal.Quotient.eq_zero_iff_mem]
  have heq : MvPolynomial.map (Subalgebra.inclusion (base_mono P h)).toRingHom F =
      ∑ r, d r * P.relationOfHasCoeffs (base P t') r := by
    apply MvPolynomial.map_injective (algebraMap (base P t') A) Subtype.val_injective
    rw [MvPolynomial.map_map, map_sum]
    simp only [map_mul, hd, P.map_relationOfHasCoeffs]
    exact hc.symm
  rw [heq]
  exact Ideal.sum_mem _ fun r _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r, rfl⟩)

end Lifting

section BaseChange

variable {t t' : Finset A}

/-- The algebra structure of a later stage base ring over an earlier one. -/
noncomputable abbrev baseAlgebra (h : t ⊆ t') : Algebra (base P t) (base P t') :=
  (Subalgebra.inclusion (base_mono P h)).toRingHom.toAlgebra

/-- The algebra structure of a later stage model over an earlier one, given by `trans`. -/
noncomputable abbrev modelAlgebra (h : t ⊆ t') : Algebra (model P t) (model P t') :=
  (trans P h).toAlgebra

/-- The transition map as a homomorphism of `base P t`-algebras. -/
noncomputable def transAlg (h : t ⊆ t') :
    letI := baseAlgebra P h
    model P t →ₐ[base P t] model P t' :=
  letI := baseAlgebra P h
  { trans P h with commutes' := fun a ↦ trans_algebraMap h a }

theorem transAlg_apply (h : t ⊆ t') (x : model P t) :
    letI := baseAlgebra P h
    transAlg P h x = trans P h x := rfl

/-- The canonical map `base P t' ⊗[base P t] model P t → model P t'`. -/
noncomputable def tensorHom (h : t ⊆ t') :
    letI := baseAlgebra P h
    base P t' ⊗[base P t] model P t →ₐ[base P t'] model P t' :=
  letI := baseAlgebra P h
  Algebra.TensorProduct.lift (Algebra.ofId (base P t') (model P t')) (transAlg P h)
    fun _ _ ↦ Commute.all _ _

theorem tensorHom_tmul (h : t ⊆ t') (c : base P t') (x : model P t) :
    letI := baseAlgebra P h
    tensorHom P h (c ⊗ₜ x) = algebraMap (base P t') (model P t') c * trans P h x := rfl

/-- The inverse of `tensorHom`. -/
noncomputable def tensorInv (h : t ⊆ t') :
    letI := baseAlgebra P h
    model P t' →ₐ[base P t'] base P t' ⊗[base P t] model P t :=
  letI := baseAlgebra P h
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval fun i ↦ (1 : base P t') ⊗ₜ[base P t] gen P t i) <| by
    have key (F : MvPolynomial ι (base P t)) :
        MvPolynomial.aeval (fun i ↦ (1 : base P t') ⊗ₜ[base P t] gen P t i)
          (MvPolynomial.map (Subalgebra.inclusion (base_mono P h)).toRingHom F) =
        (1 : base P t') ⊗ₜ[base P t] (Ideal.Quotient.mk _ F : model P t) := by
      rw [show (Subalgebra.inclusion (base_mono P h)).toRingHom =
        algebraMap (base P t) (base P t') from rfl, MvPolynomial.aeval_map_algebraMap,
        ← aeval_gen]
      exact (DFunLike.congr_fun (MvPolynomial.comp_aeval (R := base P t) (gen P t)
        (Algebra.TensorProduct.includeRight (R := base P t) (A := base P t'))) F).symm
    simp_rw [← RingHom.mem_ker, ← SetLike.le_def, Ideal.span_le]
    rintro _ ⟨r, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, ← map_relationOfHasCoeffs h r,
      key, Ideal.Quotient.mk_span_range, TensorProduct.tmul_zero]

theorem tensorInv_mk (h : t ⊆ t') (F : MvPolynomial ι (base P t')) :
    letI := baseAlgebra P h
    tensorInv P h (Ideal.Quotient.mk _ F : model P t') =
      MvPolynomial.aeval (fun i ↦ (1 : base P t') ⊗ₜ[base P t] gen P t i) F := rfl

/-- The transition base change: the later stage model is the base change of the
earlier one. -/
noncomputable def tensorEquiv (h : t ⊆ t') :
    letI := baseAlgebra P h
    base P t' ⊗[base P t] model P t ≃ₐ[base P t'] model P t' :=
  letI := baseAlgebra P h
  AlgEquiv.ofAlgHom (tensorHom P h) (tensorInv P h)
    (by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk, tensorInv_mk,
        MvPolynomial.aeval_X, AlgHom.coe_id, id_eq]
      rw [tensorHom_tmul, map_one, one_mul, trans_gen]
      rfl)
    (by
      apply Algebra.TensorProduct.ext
      · exact Subsingleton.elim _ _
      · apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro i
        simp only [AlgHom.coe_comp, AlgHom.coe_restrictScalars', Function.comp_apply,
          Ideal.Quotient.mkₐ_eq_mk, Algebra.TensorProduct.includeRight_apply, AlgHom.coe_id,
          id_eq]
        rw [tensorHom_tmul, map_one, one_mul]
        change tensorInv P h (trans P h (gen P t i)) = 1 ⊗ₜ gen P t i
        rw [trans_gen]
        exact MvPolynomial.aeval_X _ _)

theorem tensorEquiv_tmul (h : t ⊆ t') (c : base P t') (x : model P t) :
    letI := baseAlgebra P h
    tensorEquiv P h (c ⊗ₜ x) = algebraMap (base P t') (model P t') c * trans P h x := rfl

theorem isScalarTower_model (h : t ⊆ t') :
    letI := baseAlgebra P h
    letI := modelAlgebra P h
    IsScalarTower (base P t) (model P t) (model P t') :=
  letI := baseAlgebra P h
  letI := modelAlgebra P h
  .of_algebraMap_eq fun a ↦ by
    change _ = trans P h _
    rw [trans_algebraMap]
    rfl

/-- The transition square of stages is a pushout. -/
theorem isPushout (h : t ⊆ t') :
    letI := baseAlgebra P h
    letI := modelAlgebra P h
    haveI := isScalarTower_model (P := P) h
    Algebra.IsPushout (base P t) (model P t) (base P t') (model P t') := by
  let := baseAlgebra P h
  let := modelAlgebra P h
  have := isScalarTower_model (P := P) h
  refine Algebra.IsPushout.symm ⟨?_⟩
  refine IsBaseChange.of_equiv (tensorEquiv P h).toLinearEquiv fun x ↦ ?_
  change tensorEquiv P h (1 ⊗ₜ x) = trans P h x
  rw [tensorEquiv_tmul, map_one, one_mul]

end BaseChange

section Ascent

/-- Flatness at a prime ascends along a pushout square: if `S'` is the base change of `S`
along `R → R'` and the localization of `S` at `q' ∩ S` is flat over `R`, then the
localization of `S'` at `q'` is flat over `R'`. -/
theorem flat_localization_atPrime_of_isPushout {R S R' S' : Type*} [CommRing R] [CommRing S]
    [CommRing R'] [CommRing S'] [Algebra R S] [Algebra R R'] [Algebra R' S'] [Algebra S S']
    [Algebra R S'] [IsScalarTower R R' S'] [IsScalarTower R S S'] [Algebra.IsPushout R S R' S']
    (q' : Ideal S') [q'.IsPrime]
    (hflat : Module.Flat R (Localization.AtPrime (q'.comap (algebraMap S S')))) :
    Module.Flat R' (Localization.AtPrime q') := by
  set q := q'.comap (algebraMap S S')
  let T := Localization (Algebra.algebraMapSubmonoid S' q.primeCompl)
  have hT : Algebra.IsPushout S S' (Localization.AtPrime q) T :=
    (Algebra.isLocalization_iff_isPushout q.primeCompl (Localization.AtPrime q)).mp inferInstance
  have : IsScalarTower R R' T := .of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply R S' T, IsScalarTower.algebraMap_apply R R' S',
      ← IsScalarTower.algebraMap_apply R' S' T]
  have : IsScalarTower R (Localization.AtPrime q) T := .of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply R S (Localization.AtPrime q),
      ← IsScalarTower.algebraMap_apply S (Localization.AtPrime q) T,
      IsScalarTower.algebraMap_apply S S' T, ← IsScalarTower.algebraMap_apply R S S',
      ← IsScalarTower.algebraMap_apply R S' T]
  have hRT : Algebra.IsPushout R (Localization.AtPrime q) R' T :=
    (Algebra.IsPushout.comp_iff (R := R) (S := S) (R' := R') (S' := S')).mpr hT.symm
  have : Module.Flat R' T :=
    Module.Flat.isBaseChange R R' (Localization.AtPrime q) T hRT.symm.out
  have hle : Algebra.algebraMapSubmonoid S' q.primeCompl ≤ q'.primeCompl := by
    rintro _ ⟨s, hs, rfl⟩
    exact hs
  let : Algebra T (Localization.AtPrime q') :=
    IsLocalization.localizationAlgebraOfSubmonoidLe T (Localization.AtPrime q') _ _ hle
  have : IsScalarTower S' T (Localization.AtPrime q') :=
    IsLocalization.localization_isScalarTower_of_submonoid_le T _ _ _ hle
  have : IsLocalization (q'.primeCompl.map (algebraMap S' T)) (Localization.AtPrime q') :=
    IsLocalization.isLocalization_of_submonoid_le T _ _ _ hle
  have : Module.Flat T (Localization.AtPrime q') :=
    IsLocalization.flat _ (q'.primeCompl.map (algebraMap S' T))
  have : IsScalarTower R' T (Localization.AtPrime q') := .of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply R' S' (Localization.AtPrime q'),
      IsScalarTower.algebraMap_apply S' T (Localization.AtPrime q'),
      ← IsScalarTower.algebraMap_apply R' S' T]
  exact Module.Flat.trans R' T (Localization.AtPrime q')

variable {t t' : Finset A}

/-- Flatness of a stage model at a prime is inherited by every later stage at every prime
lying over it. -/
theorem flat_localization_trans (h : t ⊆ t') (q' : Ideal (model P t')) [q'.IsPrime]
    (hflat : Module.Flat (base P t) (Localization.AtPrime (q'.comap (trans P h)))) :
    Module.Flat (base P t') (Localization.AtPrime q') := by
  let := baseAlgebra P h
  let := modelAlgebra P h
  have := isScalarTower_model (P := P) h
  have := isPushout (P := P) h
  exact flat_localization_atPrime_of_isPushout q' hflat

/-- The primes of the stages under a fixed prime of `B` are compatible with the transitions. -/
theorem comap_trans_comap_toB (h : t ⊆ t') (Q : Ideal B) :
    (Q.comap (toB P t')).comap (trans P h) = Q.comap (toB P t) := by
  ext x
  simp only [Ideal.mem_comap]
  erw [toB_trans]

end Ascent

end Langlands.Algebra.FinitePresentationStages
