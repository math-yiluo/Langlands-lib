import Langlands.Algebra.LieWeightCenterProjection
import Langlands.Algebra.ParabolicCenterProjectionFiniteStatement
import Mathlib.LinearAlgebra.Dimension.Finite

/-! # Existence of the parabolic projection of an enveloping centre -/

noncomputable section

universe v w

set_option autoImplicit false

namespace Langlands.Algebra.ParabolicCenterProjection

open Langlands.Algebra.LieWeightProjection

attribute [local instance 100] LieRing.ofAssociativeRing

variable {g : Type v} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
  {m : Type w} [LieRing m] [LieAlgebra ℂ m]

/-- **Harish-Chandra's parabolic projection.** For an element `H` of a finite-dimensional
complex Lie algebra with integral diagonalizable adjoint action and an injective Lie map `j`
onto its centralizer, there is an algebra map between the enveloping centres such that every
central `z` is congruent to the image of its projection modulo the right ideal generated by
the positive eigenvectors. -/
theorem exists_centerProjection (j : m →ₗ⁅ℂ⁆ g) (H : g)
    (hspan : Submodule.span ℂ {Y : g | ∃ k : ℤ, ⁅H, Y⁆ = (k : ℂ) • Y} = ⊤)
    (hj : Function.Injective j) (hrange : ∀ X : g, X ∈ Set.range j ↔ ⁅H, X⁆ = 0) :
    ∃ p : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ g) →ₐ[ℂ]
        Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ m),
      ∀ z : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ g),
        (z : UniversalEnvelopingAlgebra ℂ g) -
          UniversalEnvelopingAlgebra.lift ℂ ((UniversalEnvelopingAlgebra.ι ℂ).comp j)
            (p z : UniversalEnvelopingAlgebra ℂ m) ∈ positiveRightIdeal H := by
  classical
  obtain ⟨t, htS, htspan, hli⟩ :=
    exists_linearIndependent ℂ {Y : g | ∃ k : ℤ, ⁅H, Y⁆ = (k : ℂ) • Y}
  let : Fintype t := (hli.setFinite).fintype
  let b : Module.Basis t ℂ g := Module.Basis.mk hli (by
    rw [Subtype.range_coe, htspan, hspan])
  have hb (a : t) : b a = a := Module.Basis.mk_apply _ _ _
  choose d hd using fun a : t => htS a.2
  let dr : t → ℝ := fun a => (d a : ℝ)
  let ev : t → ℂ := fun a => (d a : ℂ)
  have hψ : ∀ a, Complex.reAddGroupHom (ev a) = dr a := fun a => by
    simp [ev, dr, Complex.reAddGroupHom]
  have hH : ∀ a, ⁅H, b a⁆ = ev a • b a := fun a => by rw [hb]; exact hd a
  have hzero (a : {a : t // dr a = 0}) : ∃ x : m, j x = b a.val := by
    refine (hrange _).mpr ?_
    have h0 : d a.val = 0 := by
      have h := a.2
      simp only [dr] at h
      exact_mod_cast h
    rw [hH]
    simp [ev, h0]
  choose c hc using hzero
  have hcomp : (j.toLinearMap : m → g) ∘ c = b ∘ Subtype.val := funext hc
  have hcli : LinearIndependent ℂ c := by
    apply LinearIndependent.of_comp j.toLinearMap
    rw [hcomp]
    exact b.linearIndependent.comp _ Subtype.val_injective
  have hcspan : ⊤ ≤ Submodule.span ℂ (Set.range c) := by
    intro x _
    have hx : j x ∈ Submodule.span ℂ (b '' {a | ev a = 0}) :=
      mem_eigenSpan_of_ad b ev H hH 0 (by rw [(hrange _).mp ⟨x, rfl⟩, zero_smul])
    have hset : {a | ev a = 0} = {a | dr a = 0} := by
      ext a
      simp only [Set.mem_ofPred_eq, ev, dr, Int.cast_eq_zero]
    have hmap : Submodule.span ℂ (b '' {a | dr a = 0}) =
        (Submodule.span ℂ (Set.range c)).map j.toLinearMap := by
      rw [Submodule.map_span]
      congr 1
      ext y
      constructor
      · rintro ⟨a, ha, rfl⟩
        exact ⟨c ⟨a, ha⟩, ⟨⟨a, ha⟩, rfl⟩, hc ⟨a, ha⟩⟩
      · rintro ⟨_, ⟨a, rfl⟩, rfl⟩
        exact ⟨a.1, a.2, (hc a).symm⟩
    rw [hset, hmap] at hx
    obtain ⟨y, hy, hjy⟩ := hx
    rw [← hj hjy]
    exact hy
  let b₀ : Module.Basis {a : t // dr a = 0} ℂ m := Module.Basis.mk hcli hcspan
  have h₀ (a : {a : t // dr a = 0}) : j (b₀ a) = b a.val := by
    rw [Module.Basis.mk_apply]
    exact hc a
  let D := relativeEnvelopingDecomposition_of_weight b dr j
    (positiveWeightLieSubalgebra b dr ev Complex.reAddGroupHom hψ H hH).incl b₀
    (positiveWeightLieBasis b dr ev Complex.reAddGroupHom hψ H hH) h₀
    (positiveWeightLieSubalgebra_incl_basis b dr ev Complex.reAddGroupHom hψ H hH)
    ev Complex.reAddGroupHom hψ H hH
  refine ⟨D.centerProjection, fun z => ?_⟩
  have hle : positiveWeightRightIdeal b dr ≤ positiveRightIdeal H := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, ha, v, rfl⟩
    apply Submodule.subset_span
    have ha' : 0 < d a := by
      have h : 0 < dr a := ha
      simp only [dr] at h
      exact_mod_cast h
    refine ⟨(d a - 1).toNat, b a, ?_, v, rfl⟩
    have hk : (((d a - 1).toNat + 1 : ℕ) : ℤ) = d a := by omega
    have hk' : ((((d a - 1).toNat + 1 : ℕ)) : ℂ) = ((d a : ℤ) : ℂ) := by exact_mod_cast hk
    rw [hH, hk']
  exact hle (D.sub_centerProjection_mem z)

end Langlands.Algebra.ParabolicCenterProjection
