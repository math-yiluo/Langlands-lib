import Langlands.Algebra.NonUnitalModuleCornerSimpleInduced

set_option autoImplicit false

noncomputable section

namespace Langlands.Algebra.NonUnitalModuleCornerSimpleProof

open CategoryTheory
open NonUnitalModuleCorner NonUnitalModuleCornerInduction NonUnitalModuleCornerEvaluation
open NonUnitalModuleIdempotentGenerated NonUnitalModuleCornerSimpleStatements
open NonUnitalModuleCornerEvaluationProof

attribute [local instance] rightCornerModule cornerModule tensorModule

universe uA uM uW

variable {A : Type uA} [NonUnitalRing A]

/-- A simple original module with nonzero fixed part is generated by that fixed part. -/
theorem simple_isGenerated (hA : IsIdempotented A) (e : Idempotent A)
    (M : NondegenerateModuleCat.{uA, uM} A) [Simple M]
    [Nontrivial (FixedPart e M.obj)] : IsGeneratedByIdempotent e M.obj := by
  rcases stable_dichotomy hA M (aeM e M.obj) with hz | ht
  · obtain ⟨z, hn⟩ := exists_fixed_ne_zero e M.obj
    exact False.elim (hn (hz ⟨z.val, fixedPart_le e z.property⟩))
  · exact ht

/-- Such a simple module has zero `eA`-annihilator. -/
theorem simple_annihilator_zero (hA : IsIdempotented A) (e : Idempotent A)
    (M : NondegenerateModuleCat.{uA, uM} A) [Simple M]
    [Nontrivial (FixedPart e M.obj)] :
    ∀ m ∈ NonUnitalSubmodule.idempotentAnnihilator e M.obj, m = 0 := by
  rcases stable_dichotomy hA M (NonUnitalSubmodule.idempotentAnnihilator e M.obj) with hz | ht
  · exact fun m hm => hz ⟨m, hm⟩
  · obtain ⟨z, hn⟩ := exists_fixed_ne_zero e M.obj
    exact False.elim (hn (z.property.symm.trans
      (NonUnitalSubmodule.idempotent_smul_eq_zero_of_mem (ht z.val))))

/-- The specified evaluation descends and becomes bijective on the named quotient. -/
theorem inducedQuotientFixedPart : InducedQuotientFixedPartStatement.{uA, uM} := by
  intro A _ hA e M _ _ hM hs hn
  let := hs
  let := hn
  let X : NondegenerateModuleCat.{uA, uM} A := ⟨NonUnitalModuleCat.of A M, hM⟩
  have hg : IsGeneratedByIdempotent e M := simple_isGenerated hA e X
  have hz := simple_annihilator_zero hA e X
  have hkill : ∀ t ∈ NonUnitalSubmodule.idempotentAnnihilator e (Tensor e (FixedPart e M)),
      evaluation e M t = 0 := by
    intro t ht
    exact hz _ (NonUnitalModuleHom.map_mem_idempotentAnnihilator e (evaluation e M) ht)
  let φbar := (evaluation e M).annihilatorQuotientDesc e hkill
  refine ⟨φbar, rfl, ?_, ?_⟩
  · apply (injective_iff_map_eq_zero φbar.toAddMonoidHom).2
    intro x hx
    obtain ⟨t, rfl⟩ := annihilatorQuotientProjection_surjective e x
    apply (annihilatorQuotientProjection_eq_zero_iff e t).2
    exact evaluation_kernel_le_annihilator e M hx
  · intro m
    obtain ⟨t, ht⟩ := (evaluation_surjective_iff e M).2 hg m
    exact ⟨annihilatorQuotientProjection e (Tensor e (FixedPart e M)) t, ht⟩

/-- The four clauses of the Proposition of I.3.2. -/
theorem simpleCorrespondence : SimpleCorrespondenceStatement.{uA, uM, uW} :=
  ⟨simpleFixedPart, simpleInducedQuotient, fixedPartInducedQuotient, inducedQuotientFixedPart⟩

end Langlands.Algebra.NonUnitalModuleCornerSimpleProof
