import Mathlib.RingTheory.IsTensorProduct
import Mathlib.RingTheory.Flat.Basic
import Mathlib.LinearAlgebra.TensorProduct.RightExactness
import Mathlib.LinearAlgebra.TensorProduct.Pi

/-! # Ideals in pushouts of commutative rings -/

universe u

open TensorProduct

namespace Langlands.Algebra.PushoutIdealTensor

section TensorMap

variable {C S Γ Γ' : Type u} [CommRing C] [CommRing S] [CommRing Γ] [CommRing Γ']
  [Algebra C S] [Algebra C Γ] [Algebra C Γ'] [Algebra S Γ'] [Algebra Γ Γ']
  [IsScalarTower C S Γ'] [IsScalarTower C Γ Γ'] [Algebra.IsPushout C S Γ Γ']

variable (C Γ Γ') in
/-- The multiplication map `𝔞 ⊗[C] Γ → Γ'`, `a ⊗ x ↦ a x`, for an ideal `𝔞` of `S`,
through the pushout identification `S ⊗[C] Γ ≅ Γ'`. -/
noncomputable def idealTensorMap (𝔞 : Ideal S) : (𝔞.restrictScalars C) ⊗[C] Γ →ₗ[C] Γ' :=
  ((Algebra.IsPushout.equiv C S Γ Γ').toLinearEquiv.restrictScalars C).toLinearMap ∘ₗ
    LinearMap.rTensor Γ (𝔞.restrictScalars C).subtype

lemma idealTensorMap_tmul (𝔞 : Ideal S) (a : 𝔞.restrictScalars C) (x : Γ) :
    idealTensorMap C Γ Γ' 𝔞 (a ⊗ₜ[C] x) =
      algebraMap S Γ' (a : S) * algebraMap Γ Γ' x := by
  simp [idealTensorMap, Algebra.IsPushout.equiv_tmul]

/-- For a flat `C`-algebra `Γ`, the tensor map is injective. -/
lemma idealTensorMap_injective [Module.Flat C Γ] (𝔞 : Ideal S) :
    Function.Injective (idealTensorMap C Γ Γ' 𝔞) := by
  rw [idealTensorMap, LinearMap.coe_comp]
  exact (LinearEquiv.injective _).comp
    (Module.Flat.rTensor_preserves_injective_linearMap _ (Submodule.injective_subtype _))

/-- The range of the tensor map is the ideal of `Γ'` generated by `𝔞`. -/
lemma range_idealTensorMap (𝔞 : Ideal S) :
    LinearMap.range (idealTensorMap C Γ Γ' 𝔞) =
      (Ideal.map (algebraMap S Γ') 𝔞).restrictScalars C := by
  let e := Algebra.IsPushout.equiv C S Γ Γ'
  have hr := Ideal.map_includeLeft_eq (R := C) (B := Γ) 𝔞
  have he : (e.toRingEquiv : S ⊗[C] Γ →+* Γ').comp
      (Algebra.TensorProduct.includeLeft : S →ₐ[C] S ⊗[C] Γ).toRingHom = algebraMap S Γ' := by
    ext a
    simp [e, Algebra.IsPushout.equiv_tmul]
  ext y
  simp only [idealTensorMap, LinearMap.range_comp, Submodule.mem_map, ← hr,
    Submodule.restrictScalars_mem, LinearEquiv.coe_coe, LinearEquiv.restrictScalars_apply,
    AlgEquiv.toLinearEquiv_apply]
  rw [← he, ← Ideal.map_map, Ideal.map_comap_of_equiv, Ideal.mem_comap]
  constructor
  · rintro ⟨t, ht, rfl⟩
    have h1 : e.symm (e t) = t := e.symm_apply_apply t
    change e.toRingEquiv.symm (e t) ∈ Ideal.map _ 𝔞
    exact (congrArg (· ∈ Ideal.map (Algebra.TensorProduct.includeLeft :
      S →ₐ[C] S ⊗[C] Γ) 𝔞) h1).mpr ht
  · intro hy
    exact ⟨e.symm y, hy, e.apply_symm_apply y⟩

end TensorMap

section Kernel

variable {S S' Γ' Γ'' : Type u} [CommRing S] [CommRing S'] [CommRing Γ'] [CommRing Γ'']
  [Algebra S S'] [Algebra S Γ'] [Algebra S Γ''] [Algebra S' Γ''] [Algebra Γ' Γ'']
  [IsScalarTower S S' Γ''] [IsScalarTower S Γ' Γ''] [Algebra.IsPushout S S' Γ' Γ'']

/-- Base change along a surjection kills exactly the extended kernel. -/
lemma ker_algebraMap_eq_map (hq : Function.Surjective (algebraMap S S')) :
    RingHom.ker (algebraMap Γ' Γ'') =
      Ideal.map (algebraMap S Γ') (RingHom.ker (algebraMap S S')) := by
  apply le_antisymm
  · intro x hx
    have hx' : (Algebra.IsPushout.equiv S S' Γ' Γ'').symm (algebraMap Γ' Γ'' x) = 0 := by
      rw [RingHom.mem_ker.mp hx, map_zero]
    rw [Algebra.IsPushout.equiv_symm_algebraMap_right] at hx'
    -- `1 ⊗ x = 0` in `S' ⊗[S] Γ'`
    have hmem : (1 : S) ⊗ₜ[S] x ∈ RingHom.ker
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom S S S') (AlgHom.id S Γ')) := by
      rw [RingHom.mem_ker]
      simpa using hx'
    rw [Algebra.TensorProduct.rTensor_ker _ (by simpa using hq)] at hmem
    have hle : Ideal.map (Algebra.TensorProduct.includeLeft : S →ₐ[S] S ⊗[S] Γ')
        (RingHom.ker (IsScalarTower.toAlgHom S S S')) ≤
        Ideal.comap (Algebra.TensorProduct.lid S Γ')
          (Ideal.map (algebraMap S Γ') (RingHom.ker (algebraMap S S'))) := by
      rw [Ideal.map_le_iff_le_comap]
      intro k hk
      simp only [Ideal.mem_comap, Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.lid_tmul]
      rw [Algebra.smul_def, mul_one]
      exact Ideal.mem_map_of_mem _ (by simpa using hk)
    simpa using hle hmem
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simp only [Ideal.mem_comap, RingHom.mem_ker]
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply S S' Γ'',
      RingHom.mem_ker.mp ha, map_zero]

end Kernel


section Cech

variable {C A A₀ M : Type u} [CommRing C] [CommRing A] [CommRing A₀]
  [Algebra C A] [Algebra C A₀]
  [AddCommGroup M] [Module C M] [Module A₀ M] [IsScalarTower C A₀ M]
  {ι : Type u} [Fintype ι] [DecidableEq ι]
  (Γ Γ' : ι → Type u) [∀ i, CommRing (Γ i)] [∀ i, CommRing (Γ' i)]
  [∀ i, Algebra C (Γ i)] [∀ i, Algebra A (Γ' i)] [∀ i, Algebra C (Γ' i)]
  [∀ i, Algebra (Γ i) (Γ' i)] [∀ i, IsScalarTower C A (Γ' i)]
  [∀ i, IsScalarTower C (Γ i) (Γ' i)] [∀ i, Algebra.IsPushout C A (Γ i) (Γ' i)]
  (j : M →ₗ[C] A)

/-- Componentwise tensor map from `(A₀ ⊗[C] ∏ Γ) ⊗[A₀] M` to `∏ Γ'`, sending
`(a ⊗ x) ⊗ m` to the family `j (a • m) · x i`. -/
noncomputable def cechTensorMap : (A₀ ⊗[C] (∀ i, Γ i)) ⊗[A₀] M →ₗ[C] (∀ i, Γ' i) :=
  (LinearMap.pi fun i => ((Algebra.IsPushout.equiv C A (Γ i) (Γ' i)).toLinearEquiv.restrictScalars
      C).toLinearMap ∘ₗ LinearMap.rTensor (Γ i) j ∘ₗ LinearMap.proj i) ∘ₗ
    (TensorProduct.piRight C C M Γ).toLinearMap ∘ₗ
    ((TensorProduct.AlgebraTensorModule.cancelBaseChange C A₀ A₀ M (∀ i, Γ i)).restrictScalars
      C).toLinearMap ∘ₗ
    ((TensorProduct.comm A₀ (A₀ ⊗[C] (∀ i, Γ i)) M).restrictScalars C).toLinearMap

lemma cechTensorMap_tmul (a : A₀) (x : ∀ i, Γ i) (m : M) (i : ι) :
    cechTensorMap Γ Γ' j ((a ⊗ₜ[C] x) ⊗ₜ[A₀] m) i =
      algebraMap A (Γ' i) (j (a • m)) * algebraMap (Γ i) (Γ' i) (x i) := by
  simp [cechTensorMap, Algebra.IsPushout.equiv_tmul]

/-- For flat `Γ i` and injective `j`, the componentwise tensor map is injective. -/
lemma cechTensorMap_injective [∀ i, Module.Flat C (Γ i)] (hj : Function.Injective j) :
    Function.Injective (cechTensorMap (A₀ := A₀) Γ Γ' j) := by
  rw [cechTensorMap]
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe]
  refine Function.Injective.comp ?_ ((LinearEquiv.injective _).comp
    ((LinearEquiv.injective _).comp (LinearEquiv.injective _)))
  intro x y hxy
  funext i
  have hi := congrFun hxy i
  simp only [LinearMap.pi_apply, LinearMap.coe_comp, Function.comp_apply,
    LinearMap.proj_apply] at hi
  exact Module.Flat.rTensor_preserves_injective_linearMap j hj
    ((LinearEquiv.injective _) hi)

/-- If `j` maps onto an ideal `𝔞`, the range of the componentwise tensor map consists of
the families whose components lie in the extended ideals. -/
lemma mem_range_cechTensorMap_iff (𝔞 : Ideal A) (hj : ∀ a : A, a ∈ 𝔞 ↔ ∃ m, j m = a)
    (y : ∀ i, Γ' i) :
    y ∈ LinearMap.range (cechTensorMap (A₀ := A₀) Γ Γ' j) ↔
      ∀ i, y i ∈ Ideal.map (algebraMap A (Γ' i)) 𝔞 := by
  have hcomp : ∀ i, y i ∈ Ideal.map (algebraMap A (Γ' i)) 𝔞 ↔
      ∃ t : M ⊗[C] Γ i, (Algebra.IsPushout.equiv C A (Γ i) (Γ' i))
        (LinearMap.rTensor (Γ i) j t) = y i := by
    intro i
    have hr := range_idealTensorMap (C := C) (Γ := Γ i) (Γ' := Γ' i) 𝔞
    rw [← Submodule.restrictScalars_mem C, ← hr]
    let j' : M →ₗ[C] 𝔞.restrictScalars C :=
      LinearMap.codRestrict _ j (fun m => (hj (j m)).mpr ⟨m, rfl⟩)
    have hj' : Function.Surjective j' := by
      rintro ⟨a, ha⟩
      obtain ⟨m, hm⟩ := (hj a).mp ha
      exact ⟨m, Subtype.ext hm⟩
    have hfac : LinearMap.rTensor (Γ i) j =
        LinearMap.rTensor (Γ i) (𝔞.restrictScalars C).subtype ∘ₗ LinearMap.rTensor (Γ i) j' := by
      rw [← LinearMap.rTensor_comp]
      rfl
    constructor
    · rintro ⟨t, ht⟩
      obtain ⟨t', rfl⟩ := LinearMap.rTensor_surjective (Γ i) hj' t
      refine ⟨t', ?_⟩
      rw [← ht, hfac]
      rfl
    · rintro ⟨t, ht⟩
      refine ⟨LinearMap.rTensor (Γ i) j' t, ?_⟩
      rw [← ht, hfac]
      rfl
  constructor
  · rintro ⟨t, rfl⟩ i
    rw [hcomp]
    exact ⟨_, rfl⟩
  · intro hy
    choose t ht using fun i => (hcomp i).mp (hy i)
    let x : (A₀ ⊗[C] (∀ i, Γ i)) ⊗[A₀] M :=
      ((TensorProduct.comm A₀ (A₀ ⊗[C] (∀ i, Γ i)) M).symm
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange C A₀ A₀ M (∀ i, Γ i)).symm
          ((TensorProduct.piRight C C M Γ).symm t)))
    refine ⟨x, ?_⟩
    funext i
    simp [x, cechTensorMap, ht]

end Cech

end Langlands.Algebra.PushoutIdealTensor
