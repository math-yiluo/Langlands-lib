import Langlands.Algebra.CommutingDimensionHelpers
import Langlands.Algebra.CommutingDimensionNumerics

/-! Algebraic assembly of the radical dimension recurrence. -/

noncomputable section
open scoped Pointwise IsMulCommutative

namespace Langlands.CommutingDimension

universe uK uV

variable (K : Type uK) [Field K]

/-- A generating family generates its own adjoin also as an internal algebra. -/
theorem adjoin_generators_top
    {E : Type*} [Ring E] [Algebra K E] {ι : Type*} (a : ι → E) :
    Algebra.adjoin K (Set.range (fun i =>
      (⟨a i, Algebra.subset_adjoin (Set.mem_range_self i)⟩ :
        Algebra.adjoin K (Set.range a)))) = ⊤ := by
  apply Subalgebra.map_injective (f := (Algebra.adjoin K (Set.range a)).val)
    Subtype.val_injective
  rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val, ← Set.range_comp]
  rfl

/-- Injective algebra maps preserve the dimension of a generated algebra. -/
theorem finrank_adjoin_map
    {E F : Type*} [Ring E] [Ring F] [Algebra K E] [Algebra K F]
    {ι : Type*} (a : ι → E) (f : E →ₐ[K] F) (hf : Function.Injective f) :
    Module.finrank K (Algebra.adjoin K (Set.range a)) =
      Module.finrank K (Algebra.adjoin K (Set.range (fun i => f (a i)))) := by
  have h := ((Algebra.adjoin K (Set.range a)).equivMapOfInjective f hf).toLinearEquiv.finrank_eq
  rwa [AlgHom.map_adjoin, ← Set.range_comp] at h

/-- Generators of an algebra map to generators of its image. -/
theorem adjoin_image_generators
    {E F : Type*} [Ring E] [Ring F] [Algebra K E] [Algebra K F]
    {ι : Type*} (a : ι → E) (hgen : Algebra.adjoin K (Set.range a) = ⊤)
    (f : E →ₐ[K] F) :
    Algebra.adjoin K (Set.range (fun i => f (a i))) = f.range := by
  rw [show Set.range (fun i => f (a i)) = f '' Set.range a from
    Set.range_comp f a, ← AlgHom.map_adjoin, hgen, Algebra.map_top]

/-- A finite list generates by adjoining its head to the algebra generated by its tail. -/
theorem adjoin_head_tail
    {E : Type*} [Ring E] [Algebra K E] {l : ℕ} (a : Fin (l + 1) → E)
    (hgen : Algebra.adjoin K (Set.range a) = ⊤) :
    Algebra.adjoin K (insert (a 0) (Algebra.adjoin K (Set.range (Fin.tail a)) : Set E)) =
      ⊤ := by
  apply top_unique
  rw [← hgen]
  apply Algebra.adjoin_le
  intro x hx
  rw [Fin.range_fin_succ] at hx
  rcases hx with rfl | hx
  · exact Algebra.subset_adjoin (Set.mem_insert _ _)
  · exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Algebra.subset_adjoin hx))

variable (V : Type uV) [AddCommGroup V] [Module K V] [FiniteDimensional K V]

/-- A radical ideal acts through a proper subspace on a nonzero finite module. -/
theorem radical_action_ne_top [Nontrivial V]
    (C : Subalgebra K (Module.End K V)) [IsMulCommutative C]
    (J : Ideal C) (hJ : J ≤ (⊥ : Ideal C).radical) :
    (J • (⊤ : Submodule C V)).restrictScalars K ≠ ⊤ := by
  let : Module.Finite C V := Module.Finite.of_restrictScalars_finite K C V
  intro h
  have htop : (⊤ : Submodule C V) ≤ (⊥ : Submodule C V) ⊔ J • ⊤ := by
    intro v _
    simp only [bot_sup_eq]
    change v ∈ (J • (⊤ : Submodule C V)).restrictScalars K
    rw [h]
    trivial
  have hbot := Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
    (hJ.trans Ideal.radical_le_jacobson) htop
  exact bot_ne_top (top_unique hbot)

/-- Separate the head generator, then restrict its multiplication image to an invariant subspace. -/
theorem dimension_recurrence
    (C : Subalgebra K (Module.End K V)) [IsMulCommutative C]
    {l : ℕ} (a : Fin (l + 1) → C)
    (hgen : Algebra.adjoin K (Set.range a) = ⊤)
    (W : Submodule K V) (hW : ∀ c : C, ∀ v ∈ W, c.val v ∈ W)
    (ha : ∀ v : V, (a 0).val v ∈ W) :
    Module.finrank K C ≤
      Module.finrank K (Algebra.adjoin K (Set.range (Fin.tail a))) +
      Module.finrank K (restrictionAlgHom K V C W hW).range := by
  have h₁ := dimension_adjoin_insert K C
    (Algebra.adjoin K (Set.range (Fin.tail a))) (a 0) (adjoin_head_tail K a hgen)
  have h₂ := multiplication_dimension_le_restriction K V C
    (fun c d => congrArg Subtype.val (mul_comm c d)) (a 0) W hW ha
  omega

end Langlands.CommutingDimension
