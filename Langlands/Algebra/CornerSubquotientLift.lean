import Langlands.Algebra.NonUnitalModuleCornerSimpleSubmodules

/-! # Lifting a fixed-part subquotient to an ambient simple subquotient -/

noncomputable section

namespace Langlands.Algebra.NonUnitalModuleCorner

open NonUnitalModuleCornerSimpleProof

variable {R M Q : Type*} [Ring R]
variable [AddCommGroup M] [Module R M] [AddCommGroup Q] [Module R Q]

local instance unitalModule (X : Type*) [AddCommGroup X] [Module R X] :
    NonUnitalModule R X :=
  NonUnitalModule.ofModule R X

variable (e : Idempotent R) (P : Submodule (Idempotent.Corner e) (FixedPart e M))
  (q : P →ₗ[Idempotent.Corner e] FixedPart e Q)

/-- The graph of a corner map lies in the fixed part of the product module. -/
def fixedGraphMap : P →ₗ[Idempotent.Corner e] FixedPart e (M × Q) where
  toFun x := ⟨(x.val.val, (q x).val), Prod.ext x.val.property (q x).property⟩
  map_add' x y := Subtype.ext (Prod.ext rfl
    (congrArg Subtype.val (q.map_add x y)))
  map_smul' a x := Subtype.ext (Prod.ext rfl
    (congrArg Subtype.val (q.map_smul a x)))

/-- The ambient submodule generated by the fixed-part graph. -/
def generatedFixedGraph : Submodule R (M × Q) :=
  let G := fromFixed e (M × Q) (LinearMap.range (fixedGraphMap e P q))
  { carrier := G.toAddSubgroup
    zero_mem' := G.toAddSubgroup.zero_mem
    add_mem' := G.toAddSubgroup.add_mem
    smul_mem' := G.smul_mem' }

/-- For simple `Q`, a nonzero corner map from a subspace of the fixed part of
`M` to the fixed part of `Q` makes `Q` an actual subquotient of `M`. -/
theorem exists_subquotient_of_fixedPart [IsSimpleModule R Q]
    (hq : ∃ x, q x ≠ 0) :
    ∃ U : Submodule R M, ∃ f : U →ₗ[R] Q, Function.Surjective f := by
  obtain ⟨x, hx⟩ := hq
  have hval : (q x).val ≠ 0 := fun hz => hx (Subtype.ext hz)
  let G := generatedFixedGraph e P q
  let π := (LinearMap.fst R M Q).comp G.subtype
  let η := (LinearMap.snd R M Q).comp G.subtype
  have hπ : Function.Injective π := by
    apply LinearMap.ker_eq_bot.mp
    rw [LinearMap.ker_eq_bot']
    intro z hz
    have hz₁ : z.val.1 = 0 := hz
    have hz₂ : z.val.2 = 0 := by
      by_contra hne
      obtain ⟨a, ha⟩ := IsSimpleModule.toSpanSingleton_surjective R hne (q x).val
      change a • z.val.2 = (q x).val at ha
      have hmem := G.smul_mem a z.property
      obtain ⟨y, hy⟩ := projection_mem_fromFixed e (M × Q)
        (LinearMap.range (fixedGraphMap e P q)) hmem
      have hy₁ := congrArg (fun p : FixedPart e (M × Q) => p.val.1) hy
      change y.val.val = (e : R) • (a • z.val.1) at hy₁
      rw [hz₁, smul_zero, smul_zero] at hy₁
      have hy₀ : y = 0 := Subtype.ext (Subtype.ext hy₁)
      have hy₂ := congrArg (fun p : FixedPart e (M × Q) => p.val.2) hy
      change (q y).val = (e : R) • (a • z.val.2) at hy₂
      rw [ha, show (e : R) • (q x).val = (q x).val from (q x).property] at hy₂
      exact hval (hy₂.symm.trans (by rw [hy₀, map_zero]; rfl))
    exact Subtype.ext (Prod.ext hz₁ hz₂)
  have hη : Function.Surjective η := by
    apply LinearMap.range_eq_top.mp
    apply (eq_bot_or_eq_top (LinearMap.range η)).resolve_left
    intro hbot
    let g := fixedGraphMap e P q
    let z : G := ⟨(g x).val, fixed_mem_fromFixed e (M × Q) (LinearMap.range g)
      ⟨g x, LinearMap.mem_range_self g x⟩⟩
    exact hval (LinearMap.congr_fun (LinearMap.range_eq_bot.mp hbot) z)
  let eπ := LinearEquiv.ofInjective π hπ
  exact ⟨LinearMap.range π, η.comp eπ.symm.toLinearMap, hη.comp eπ.symm.surjective⟩

end Langlands.Algebra.NonUnitalModuleCorner
