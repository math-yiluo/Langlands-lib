import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.Tactic.Abel

/-! # The centre map from a triangular enveloping decomposition -/

noncomputable section

universe u v w

set_option autoImplicit false

namespace Langlands.Algebra

variable {k : Type u} [CommRing k]
  {A : Type v} [Ring A] [Algebra k A] {U : Type w} [Ring U] [Algebra k U]

/-- The right ideal and its Levi complement used to project central elements.
The ideal is stable under left multiplication by the Levi algebra, and
each central element has a unique Levi representative modulo the ideal. -/
structure RelativeEnvelopingDecomposition (j : A →ₐ[k] U) where
  ideal : Submodule k U
  mul_mem_right : ∀ x ∈ ideal, ∀ y : U, x * y ∈ ideal
  levi_mul_mem : ∀ a : A, ∀ x ∈ ideal, j a * x ∈ ideal
  eq_zero_of_mem : ∀ a : A, j a ∈ ideal → a = 0
  exists_representative : ∀ z : Subalgebra.center k U, ∃ a : A, z.val - j a ∈ ideal

namespace RelativeEnvelopingDecomposition

variable {j : A →ₐ[k] U} (D : RelativeEnvelopingDecomposition j)

private def representative (z : Subalgebra.center k U) : A :=
  (D.exists_representative z).choose

private theorem sub_representative_mem (z : Subalgebra.center k U) :
    z.val - j (D.representative z) ∈ D.ideal :=
  (D.exists_representative z).choose_spec

private theorem representative_eq (z : Subalgebra.center k U) (a : A)
    (ha : z.val - j a ∈ D.ideal) : D.representative z = a := by
  apply sub_eq_zero.mp
  apply D.eq_zero_of_mem
  rw [map_sub, show j (D.representative z) - j a =
    (z.val - j a) - (z.val - j (D.representative z)) by abel]
  exact D.ideal.sub_mem ha (D.sub_representative_mem z)

private theorem representative_mem_center (z : Subalgebra.center k U) :
    D.representative z ∈ Subalgebra.center k A := by
  rw [Subalgebra.mem_center_iff]
  intro a
  apply sub_eq_zero.mp
  apply D.eq_zero_of_mem
  have hz := Subalgebra.mem_center_iff.mp z.property (j a)
  let d := z.val - j (D.representative z)
  have hd : d ∈ D.ideal := D.sub_representative_mem z
  have hcomm : j (a * D.representative z - D.representative z * a) = d * j a - j a * d := by
    rw [map_sub, map_mul, map_mul]
    dsimp only [d]
    rw [sub_mul, mul_sub, hz]
    abel
  rw [hcomm]
  exact D.ideal.sub_mem (D.mul_mem_right d hd _) (D.levi_mul_mem a d hd)

/-- The relative centre map, characterized by equality modulo the right
ideal generated by the positive directions. -/
def centerProjection : Subalgebra.center k U →ₐ[k] Subalgebra.center k A where
  toFun z := ⟨D.representative z, D.representative_mem_center z⟩
  map_one' := Subtype.ext (D.representative_eq 1 1 (by simp))
  map_mul' z w := by
    apply Subtype.ext
    apply D.representative_eq
    change z.val * w.val - j (D.representative z * D.representative w) ∈ D.ideal
    rw [map_mul, show z.val * w.val - j (D.representative z) * j (D.representative w) =
      (z.val - j (D.representative z)) * w.val +
        j (D.representative z) * (w.val - j (D.representative w)) by
      rw [sub_mul, mul_sub]
      abel]
    exact D.ideal.add_mem (D.mul_mem_right _ (D.sub_representative_mem z) _)
      (D.levi_mul_mem _ _ (D.sub_representative_mem w))
  map_zero' := Subtype.ext (D.representative_eq 0 0 (by simp))
  map_add' z w := by
    apply Subtype.ext
    apply D.representative_eq
    change z.val + w.val - j (D.representative z + D.representative w) ∈ D.ideal
    rw [map_add, add_sub_add_comm]
    exact D.ideal.add_mem (D.sub_representative_mem z) (D.sub_representative_mem w)
  commutes' c := Subtype.ext (D.representative_eq _ _ (by
    change algebraMap k U c - j (algebraMap k A c) ∈ D.ideal
    rw [j.commutes, sub_self]
    exact D.ideal.zero_mem))

theorem sub_centerProjection_mem (z : Subalgebra.center k U) :
    z.val - j (D.centerProjection z).val ∈ D.ideal :=
  D.sub_representative_mem z

theorem centerProjection_val_eq (z : Subalgebra.center k U) (a : A)
    (h : z.val - j a ∈ D.ideal) : (D.centerProjection z).val = a :=
  D.representative_eq z a h

end RelativeEnvelopingDecomposition

end Langlands.Algebra
