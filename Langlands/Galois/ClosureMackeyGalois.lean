import Langlands.Galois.ClosureRestrictionGalois
import Mathlib.FieldTheory.Normal.Basic

/-!
# One Mackey double coset for absolute Galois groups

Let `E'/E` and `D/E` be algebraic extensions inside a normal extension `L/E`, with `D/E` normal,
and suppose that `Gal(L/E) = Gal(L/D) · Gal(L/E')`. For closure embeddings `e : Ē → Ē'` and
`eD : Ē → D̄`, the images `H` and `R` of the absolute Galois groups of `E'` and `D` then satisfy
`Gal(Ē/E) = R · H`, and `R` is normal. If `M` is a common extension of `D` and `E'`, generated by
them, the element `x` of `Gal(Ē/E)` comparing the two composite closure embeddings `Ē → M̄`
conjugates the image of the absolute group of `M` in that of `D` into `H`, and every element of
the absolute group of `D` that `x` conjugates into `H` comes from the absolute group of `M`.
These are the hypotheses of Mackey's formula with a single double coset.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.GaloisRepresentation

section NormalImage

variable {E D Ω : Type*} [Field E] [Field D] [Field Ω] [Algebra E D] [Algebra E Ω] [Normal E D]

/-- Two embeddings of a normal extension have the same image. -/
theorem exists_eq_of_normal (δ φ : D →ₐ[E] Ω) (d : D) : ∃ d' : D, φ d = δ d' := by
  have : Normal E δ.fieldRange := Normal.of_algEquiv δ.equivFieldRange
  let f : δ.fieldRange →ₐ[E] Ω := φ.comp δ.equivFieldRange.symm.toAlgHom
  have hf := AlgHom.fieldRange_of_normal f
  have hmem : φ d ∈ f.fieldRange := ⟨δ.equivFieldRange d, by simp [f]⟩
  rw [hf] at hmem
  obtain ⟨d', hd'⟩ := hmem
  exact ⟨d', hd'.symm⟩

end NormalImage

section Cover

variable {E E' D L : Type*} [Field E] [Field E'] [Field D] [Field L]
  [Algebra E E'] [Algebra E D] [Algebra E L] [Algebra E' L] [Algebra D L]
  [IsScalarTower E E' L] [IsScalarTower E D L]
  [Algebra.IsAlgebraic E E'] [Algebra.IsAlgebraic E' L] [Normal E L] [Normal E D]

/-- The image of the absolute group of a normal extension `D` is normal. -/
theorem range_restrictionAlongClosure_normal
    (eD : AlgebraicClosure E →ₐ[E] AlgebraicClosure D) :
    (restrictionAlongClosure eD).toMonoidHom.range.Normal := by
  refine ⟨fun r hr g => ?_⟩
  rw [mem_range_restrictionAlongClosure_iff] at hr ⊢
  intro d
  let δ := transportedEmbedding eD
  let φ : D →ₐ[E] AlgebraicClosure E := (AlgEquiv.toAlgHom g⁻¹).comp δ
  obtain ⟨d', hd'⟩ := exists_eq_of_normal δ φ d
  have h1 : AlgEquiv.toRingEquiv g⁻¹ (δ d) = δ d' := hd'
  change AlgEquiv.toRingEquiv g (AlgEquiv.toRingEquiv r (AlgEquiv.toRingEquiv g⁻¹ (δ d))) = δ d
  rw [h1, hr d', ← h1]
  change AlgEquiv.toRingEquiv (g * g⁻¹) (δ d) = δ d
  rw [mul_inv_cancel]
  rfl

/-- From `Gal(L/E) = Gal(L/D) · Gal(L/E')` to absolute Galois groups: every element of the
absolute group of `E` is a product of an element of the image of the absolute group of `D` and
an element of the image of the absolute group of `E'`. -/
theorem exists_mul_of_galois_mul
    (e : AlgebraicClosure E →ₐ[E] AlgebraicClosure E')
    (eD : AlgebraicClosure E →ₐ[E] AlgebraicClosure D)
    (hsingle : ∀ σ : L ≃ₐ[E] L, ∃ a b : L ≃ₐ[E] L,
      (∀ d : D, a (algebraMap D L d) = algebraMap D L d) ∧
      (∀ x : E', b (algebraMap E' L x) = algebraMap E' L x) ∧ σ = a * b)
    (g : Field.absoluteGaloisGroup E) :
    ∃ r ∈ (restrictionAlongClosure eD).toMonoidHom.range,
      ∃ h ∈ (restrictionAlongClosure e).toMonoidHom.range, g = r * h := by
  let Ω := AlgebraicClosure E
  let e' := transportedEmbedding e
  let δ := transportedEmbedding eD
  obtain ⟨lam, hlam⟩ : ∃ lam : L →ₐ[E] Ω, ∀ x : E', lam (algebraMap E' L x) = e' x := by
    let : Algebra E' Ω := e'.toRingHom.toAlgebra
    have : IsScalarTower E E' Ω := IsScalarTower.of_algebraMap_eq fun c => (e'.commutes c).symm
    let lam₀ : L →ₐ[E'] Ω := IsAlgClosed.lift
    exact ⟨lam₀.restrictScalars E, fun x => lam₀.commutes x⟩
  let : Algebra L Ω := lam.toRingHom.toAlgebra
  have : IsScalarTower E L Ω := IsScalarTower.of_algebraMap_eq fun c => (lam.commutes c).symm
  have hlamL (l : L) : algebraMap L Ω l = lam l := rfl
  let σ : L ≃ₐ[E] L := AlgHom.restrictNormal' (AlgEquiv.toAlgHom g) L
  have hσ (l : L) : lam (σ l) = AlgEquiv.toRingEquiv g (lam l) :=
    AlgHom.restrictNormal_commutes (AlgEquiv.toAlgHom g) L l
  obtain ⟨a, b, ha, hb, hab⟩ := hsingle σ
  let aHat : Field.absoluteGaloisGroup E := AlgEquiv.liftNormal a Ω
  let bHat : Field.absoluteGaloisGroup E := AlgEquiv.liftNormal b Ω
  have haHat (l : L) : AlgEquiv.toRingEquiv aHat (lam l) = lam (a l) :=
    AlgEquiv.liftNormal_commutes a Ω l
  have hbHat (l : L) : AlgEquiv.toRingEquiv bHat (lam l) = lam (b l) :=
    AlgEquiv.liftNormal_commutes b Ω l
  have hδ (d : D) : ∃ d' : D, δ d = lam (algebraMap D L d') :=
    exists_eq_of_normal (lam.comp (IsScalarTower.toAlgHom E D L)) δ d
  let k : Field.absoluteGaloisGroup E := (aHat * bHat)⁻¹ * g
  have hk (l : L) : AlgEquiv.toRingEquiv k (lam l) = lam l := by
    have h1 : AlgEquiv.toRingEquiv (aHat * bHat) (lam l) = AlgEquiv.toRingEquiv g (lam l) := by
      change AlgEquiv.toRingEquiv aHat (AlgEquiv.toRingEquiv bHat (lam l)) = _
      rw [hbHat, haHat, ← hσ, hab]
      rfl
    change AlgEquiv.toRingEquiv (aHat * bHat)⁻¹ (AlgEquiv.toRingEquiv g (lam l)) = lam l
    rw [← h1]
    change AlgEquiv.toRingEquiv ((aHat * bHat)⁻¹ * (aHat * bHat)) (lam l) = lam l
    rw [inv_mul_cancel]
    rfl
  refine ⟨aHat, ?_, bHat * k, ?_, ?_⟩
  · rw [mem_range_restrictionAlongClosure_iff]
    intro d
    obtain ⟨d', hd'⟩ := hδ d
    change AlgEquiv.toRingEquiv aHat (δ d) = δ d
    rw [hd', haHat, ha]
  · rw [mem_range_restrictionAlongClosure_iff]
    intro x
    change AlgEquiv.toRingEquiv bHat (AlgEquiv.toRingEquiv k (e' x)) = e' x
    rw [← hlam, hk, hbHat, hb]
  · simp only [k, mul_inv_rev, ← mul_assoc, mul_inv_cancel, one_mul]

end Cover

section Mackey

variable {E E' D M : Type*} [Field E] [Field E'] [Field D] [Field M]
  [Algebra E E'] [Algebra E D] [Algebra D M] [Algebra E' M] [Algebra E M]
  [IsScalarTower E D M] [IsScalarTower E E' M]
  (e : AlgebraicClosure E →ₐ[E] AlgebraicClosure E')
  (eD : AlgebraicClosure E →ₐ[E] AlgebraicClosure D)
  (eM : AlgebraicClosure D →ₐ[D] AlgebraicClosure M)
  (ej : AlgebraicClosure E' →ₐ[E'] AlgebraicClosure M)

/-- The composite closure embedding through `E'`. -/
def closureThrough' : AlgebraicClosure E →ₐ[E] AlgebraicClosure M :=
  { toRingHom := ej.toRingHom.comp e.toRingHom
    commutes' := fun c => by
      change ej (e (algebraMap E (AlgebraicClosure E) c)) = algebraMap E (AlgebraicClosure M) c
      rw [e.commutes, IsScalarTower.algebraMap_apply E E' (AlgebraicClosure E'), ej.commutes,
        IsScalarTower.algebraMap_apply E M (AlgebraicClosure M),
        IsScalarTower.algebraMap_apply E E' M,
        IsScalarTower.algebraMap_apply E' M (AlgebraicClosure M)] }

/-- The composite closure embedding through `D`. -/
def closureThroughD : AlgebraicClosure E →ₐ[E] AlgebraicClosure M :=
  { toRingHom := eM.toRingHom.comp eD.toRingHom
    commutes' := fun c => by
      change eM (eD (algebraMap E (AlgebraicClosure E) c)) = algebraMap E (AlgebraicClosure M) c
      rw [eD.commutes, IsScalarTower.algebraMap_apply E D (AlgebraicClosure D), eM.commutes,
        IsScalarTower.algebraMap_apply E M (AlgebraicClosure M),
        IsScalarTower.algebraMap_apply E D M,
        IsScalarTower.algebraMap_apply D M (AlgebraicClosure M)] }

/-- The element of the absolute group of `E` comparing the two composite closure embeddings. -/
def mackeyElement : Field.absoluteGaloisGroup E :=
  closureChange (closureThrough' e ej) (closureThroughD eD eM)

theorem mackeyElement_spec (z : AlgebraicClosure E) :
    ej (e (AlgEquiv.toRingEquiv (mackeyElement e eD eM ej) z)) = eM (eD z) :=
  closureChange_spec (closureThrough' e ej) (closureThroughD eD eM) z

/-- Conjugation by `mackeyElement` carries the image of the absolute group of `M` through `D`
to its image through `E'`. -/
theorem mackeyElement_conj (y : Field.absoluteGaloisGroup M) :
    mackeyElement e eD eM ej * restrictionAlongClosure eD (restrictionAlongClosure eM y) *
        (mackeyElement e eD eM ej)⁻¹ =
      restrictionAlongClosure e (restrictionAlongClosure ej y) := by
  have h1 := closureChange_intertwines (closureThrough' e ej) (closureThroughD eD eM) y
  rw [← restrictionAlongClosure_comp eD eM (closureThroughD eD eM) (fun _ => rfl),
    ← restrictionAlongClosure_comp e ej (closureThrough' e ej) (fun _ => rfl)]
  change closureChange _ _ * _ * (closureChange _ _)⁻¹ = _
  rw [h1, mul_inv_cancel_right]

variable [Algebra.IsAlgebraic E E'] [Algebra.IsAlgebraic D M]

/-- An element of the absolute group of `D` that `mackeyElement` conjugates into the image of
the absolute group of `E'` fixes the transported copy of `E'` in `D̄`. -/
theorem fixes_closureCopy_of_conj_mem (ℓ : Field.absoluteGaloisGroup D)
    (hℓ : mackeyElement e eD eM ej * restrictionAlongClosure eD ℓ *
        (mackeyElement e eD eM ej)⁻¹ ∈ (restrictionAlongClosure e).toMonoidHom.range)
    (a : E') :
    AlgEquiv.toRingEquiv ℓ (transportedEmbedding eM (algebraMap E' M a)) =
      transportedEmbedding eM (algebraMap E' M a) := by
  set x := mackeyElement e eD eM ej
  obtain ⟨t, ht⟩ := hℓ
  let z₀ := transportedEmbedding e a
  have hz₀ : AlgEquiv.toRingEquiv (x * restrictionAlongClosure eD ℓ * x⁻¹) z₀ = z₀ := by
    have hfix := (mem_range_restrictionAlongClosure_iff e _).mp ⟨t, rfl⟩ a
    change AlgEquiv.toRingEquiv (restrictionAlongClosure e t) z₀ = z₀ at hfix
    rw [← ht]
    exact hfix
  have hcopy : transportedEmbedding eM (algebraMap E' M a) =
      eD (AlgEquiv.toRingEquiv x⁻¹ z₀) := by
    apply (closureEmbeddingRingEquiv eM).injective
    rw [closureEmbeddingRingEquiv_apply, closureEmbeddingRingEquiv_apply, e_transportedEmbedding]
    have h := mackeyElement_spec e eD eM ej (AlgEquiv.toRingEquiv x⁻¹ z₀)
    have hx : AlgEquiv.toRingEquiv x (AlgEquiv.toRingEquiv x⁻¹ z₀) = z₀ := by
      change AlgEquiv.toRingEquiv (x * x⁻¹) z₀ = z₀
      rw [mul_inv_cancel]
      rfl
    rw [hx, e_transportedEmbedding, ej.commutes,
      IsScalarTower.algebraMap_apply E' M (AlgebraicClosure M)] at h
    exact h
  rw [hcopy, ← restrictionAlongClosure_commutes]
  congr 1
  have hgrp : x⁻¹ * (x * restrictionAlongClosure eD ℓ * x⁻¹) =
      restrictionAlongClosure eD ℓ * x⁻¹ := by group
  change AlgEquiv.toRingEquiv (restrictionAlongClosure eD ℓ * x⁻¹) z₀ =
    AlgEquiv.toRingEquiv x⁻¹ z₀
  rw [← hgrp]
  change AlgEquiv.toRingEquiv x⁻¹
    (AlgEquiv.toRingEquiv (x * restrictionAlongClosure eD ℓ * x⁻¹) z₀) = _
  rw [hz₀]

/-- If the transported copy of `E'` determines `D`-algebra maps out of `M`, then every element
of the absolute group of `D` that `mackeyElement` conjugates into the image of the absolute
group of `E'` lies in the image of the absolute group of `M`. -/
theorem mem_range_of_conj_mem
    (hgen : ∀ φ₁ φ₂ : M →ₐ[D] AlgebraicClosure D,
      (∀ a : E', φ₁ (algebraMap E' M a) = φ₂ (algebraMap E' M a)) → φ₁ = φ₂)
    (ℓ : Field.absoluteGaloisGroup D)
    (hℓ : mackeyElement e eD eM ej * restrictionAlongClosure eD ℓ *
        (mackeyElement e eD eM ej)⁻¹ ∈ (restrictionAlongClosure e).toMonoidHom.range) :
    ℓ ∈ (restrictionAlongClosure eM).toMonoidHom.range := by
  rw [mem_range_restrictionAlongClosure_iff]
  have h := hgen ((AlgEquiv.toAlgHom ℓ).comp (transportedEmbedding eM)) (transportedEmbedding eM)
    (fun a => fixes_closureCopy_of_conj_mem e eD eM ej ℓ hℓ a)
  intro m
  exact DFunLike.congr_fun h m

end Mackey

section Cosets

variable {G Γ : Type*} [Group G] [Group Γ]

/-- If `G = R · H` with `R` the normal image of `ι`, every element of `G` lies in the double
coset `H x ι(Γ)` for every `x`. -/
theorem exists_mul_mul_of_mul_cover (H : Subgroup G) (ι : Γ →* G) [ι.range.Normal]
    (hcover : ∀ g : G, ∃ r ∈ ι.range, ∃ h ∈ H, g = r * h) (x g : G) :
    ∃ (h : H) (ℓ : Γ), g = h * (x * ι ℓ) := by
  obtain ⟨r, hr, h, hh, hxg⟩ := hcover (x * g⁻¹)
  have hr' : x⁻¹ * r⁻¹ * x ∈ ι.range := by
    have := (inferInstance : ι.range.Normal).conj_mem r⁻¹ (ι.range.inv_mem hr) x⁻¹
    simpa only [inv_inv] using this
  obtain ⟨ℓ, hℓ⟩ := hr'
  refine ⟨⟨h⁻¹, H.inv_mem hh⟩, ℓ, ?_⟩
  rw [hℓ]
  have hg : g = (x * g⁻¹)⁻¹ * x := by group
  rw [hg, hxg]
  simp only [mul_inv_rev]
  group

end Cosets

section NormalSubgroup

variable {D M L : Type*} [Field D] [Field M] [Field L] [Algebra D M] [Algebra M L] [Algebra D L]
  [IsScalarTower D M L] [Normal D L]
  (eM : AlgebraicClosure D →ₐ[D] AlgebraicClosure M)
  (κ' : AlgebraicClosure M →ₐ[M] AlgebraicClosure L)

/-- The composite closure embedding `D̄ → M̄ → L̄`. -/
def closureThroughM : AlgebraicClosure D →ₐ[D] AlgebraicClosure L :=
  { toRingHom := κ'.toRingHom.comp eM.toRingHom
    commutes' := fun c => by
      change κ' (eM (algebraMap D (AlgebraicClosure D) c)) = algebraMap D (AlgebraicClosure L) c
      rw [eM.commutes, IsScalarTower.algebraMap_apply D M (AlgebraicClosure M), κ'.commutes,
        IsScalarTower.algebraMap_apply D L (AlgebraicClosure L),
        IsScalarTower.algebraMap_apply D M L,
        IsScalarTower.algebraMap_apply M L (AlgebraicClosure L)] }

omit [Normal D L] in
theorem restrictionAlongClosure_closureThroughM (x : Field.absoluteGaloisGroup L) :
    restrictionAlongClosure (closureThroughM eM κ') x =
      restrictionAlongClosure eM (restrictionAlongClosure κ' x) :=
  restrictionAlongClosure_comp eM κ' (closureThroughM eM κ') (fun _ => rfl) x

/-- An element of the absolute group of `D`, transported to `L̄` along `closureThroughM`. -/
def closureTransport (g : Field.absoluteGaloisGroup D) :
    AlgebraicClosure L ≃ₐ[D] AlgebraicClosure L :=
  AlgEquiv.ofRingEquiv
    (f := ((closureEmbeddingRingEquiv (closureThroughM eM κ')).symm.trans
      (AlgEquiv.toRingEquiv g)).trans (closureEmbeddingRingEquiv (closureThroughM eM κ')))
    (fun c => by
      change closureThroughM eM κ' (AlgEquiv.toRingEquiv g
        ((closureEmbeddingRingEquiv (closureThroughM eM κ')).symm
          (algebraMap D (AlgebraicClosure L) c))) = _
      have h1 : (closureEmbeddingRingEquiv (closureThroughM eM κ')).symm
          (algebraMap D (AlgebraicClosure L) c) = algebraMap D (AlgebraicClosure D) c := by
        rw [RingEquiv.symm_apply_eq, closureEmbeddingRingEquiv_apply, AlgHom.commutes]
      rw [h1]
      have h2 : AlgEquiv.toRingEquiv g (algebraMap D (AlgebraicClosure D) c) =
          algebraMap D (AlgebraicClosure D) c := AlgEquiv.commutes g c
      rw [h2, AlgHom.commutes])

theorem closureTransport_spec (g : Field.absoluteGaloisGroup D) (z : AlgebraicClosure D) :
    closureTransport eM κ' g (closureThroughM eM κ' z) =
      closureThroughM eM κ' (AlgEquiv.toRingEquiv g z) := by
  change closureEmbeddingRingEquiv (closureThroughM eM κ') (AlgEquiv.toRingEquiv g
    ((closureEmbeddingRingEquiv (closureThroughM eM κ')).symm
      (closureEmbeddingRingEquiv (closureThroughM eM κ') z))) = _
  rw [RingEquiv.symm_apply_apply]
  rfl

/-- The restriction of the transported automorphism to the normal extension `L`. -/
def restrictedTransport (g : Field.absoluteGaloisGroup D) : L ≃ₐ[D] L :=
  AlgHom.restrictNormal' (closureTransport eM κ' g).toAlgHom L

theorem restrictedTransport_spec (g : Field.absoluteGaloisGroup D) (l : L) :
    algebraMap L (AlgebraicClosure L) (restrictedTransport eM κ' g l) =
      closureTransport eM κ' g (algebraMap L (AlgebraicClosure L) l) :=
  AlgHom.restrictNormal_commutes (closureTransport eM κ' g).toAlgHom L l

/-- Conjugation of the absolute group of `L` by the transported automorphism. -/
def transportConj (g : Field.absoluteGaloisGroup D) (x : Field.absoluteGaloisGroup L) :
    Field.absoluteGaloisGroup L :=
  AlgEquiv.ofRingEquiv
    (f := (((closureTransport eM κ' g).toRingEquiv.trans (AlgEquiv.toRingEquiv x)).trans
      (closureTransport eM κ' g).symm.toRingEquiv))
    (fun l => by
      change (closureTransport eM κ' g).symm (AlgEquiv.toRingEquiv x
        (closureTransport eM κ' g (algebraMap L (AlgebraicClosure L) l))) = _
      rw [← restrictedTransport_spec]
      have h2 : AlgEquiv.toRingEquiv x (algebraMap L (AlgebraicClosure L)
          (restrictedTransport eM κ' g l)) =
          algebraMap L (AlgebraicClosure L) (restrictedTransport eM κ' g l) :=
        AlgEquiv.commutes x _
      rw [h2, restrictedTransport_spec, AlgEquiv.symm_apply_apply])

/-- Conjugating the image of `x` by `g` gives the image of the transported conjugate of `x`. -/
theorem conj_restrictionAlongClosure_closureThroughM (g : Field.absoluteGaloisGroup D)
    (x : Field.absoluteGaloisGroup L) :
    g⁻¹ * restrictionAlongClosure (closureThroughM eM κ') x * g =
      restrictionAlongClosure (closureThroughM eM κ') (transportConj eM κ' g x) := by
  apply eq_restrictionAlongClosure
  intro z
  set κ := closureThroughM eM κ'
  set τ := closureTransport eM κ' g
  have hinv (w : AlgebraicClosure D) :
      κ (AlgEquiv.toRingEquiv g⁻¹ w) = τ.symm (κ w) := by
    rw [AlgEquiv.eq_symm_apply, closureTransport_spec]
    change κ (AlgEquiv.toRingEquiv (g * g⁻¹) w) = κ w
    rw [mul_inv_cancel]
    rfl
  change κ (AlgEquiv.toRingEquiv g⁻¹ (AlgEquiv.toRingEquiv (restrictionAlongClosure κ x)
    (AlgEquiv.toRingEquiv g z))) = τ.symm (AlgEquiv.toRingEquiv x (τ (κ z)))
  rw [hinv, restrictionAlongClosure_commutes, closureTransport_spec]

/-- The image of the absolute group of `L` is normal in the absolute group of `D`. -/
theorem range_restrictionAlongClosure_closureThroughM_normal :
    (restrictionAlongClosure (closureThroughM eM κ')).toMonoidHom.range.Normal := by
  refine ⟨fun n hn g => ?_⟩
  obtain ⟨x, rfl⟩ := hn
  refine ⟨transportConj eM κ' g⁻¹ x, ?_⟩
  have h := conj_restrictionAlongClosure_closureThroughM eM κ' g⁻¹ x
  rw [inv_inv] at h
  exact h.symm

omit [Normal D L] in
/-- The image of the absolute group of `L` lies in that of `M`. -/
theorem range_closureThroughM_le :
    (restrictionAlongClosure (closureThroughM eM κ')).toMonoidHom.range ≤
      (restrictionAlongClosure eM).toMonoidHom.range := by
  rintro _ ⟨x, rfl⟩
  exact ⟨restrictionAlongClosure κ' x, (restrictionAlongClosure_closureThroughM eM κ' x).symm⟩

/-- If the transported automorphism fixes `M` pointwise, `g` comes from the absolute group of
`M`. -/
theorem mem_range_of_restrictedTransport_fixes [Algebra.IsAlgebraic D M]
    (g : Field.absoluteGaloisGroup D)
    (h : ∀ m : M, restrictedTransport eM κ' g (algebraMap M L m) = algebraMap M L m) :
    g ∈ (restrictionAlongClosure eM).toMonoidHom.range := by
  rw [mem_range_restrictionAlongClosure_iff]
  intro m
  set κ := closureThroughM eM κ'
  have hκ : κ (transportedEmbedding eM m) = algebraMap L (AlgebraicClosure L) (algebraMap M L m) := by
    change κ' (eM (transportedEmbedding eM m)) = _
    rw [e_transportedEmbedding, κ'.commutes, IsScalarTower.algebraMap_apply M L (AlgebraicClosure L)]
  apply (closureEmbeddingRingEquiv κ).injective
  rw [closureEmbeddingRingEquiv_apply, closureEmbeddingRingEquiv_apply, ← closureTransport_spec, hκ,
    ← restrictedTransport_spec, h]

end NormalSubgroup

end Langlands.GaloisRepresentation
