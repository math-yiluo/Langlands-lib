import Langlands.Galois.Local.SeparableUnramifiedIntegerRing

/-! # The completed integer ring of the maximal unramified extension -/

noncomputable section

open IsLocalRing ValuativeRel

namespace Langlands.LocalGalois.Separable.UnramifiedCompletion

universe u

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

local instance : IsDiscreteValuationRing (fixedFieldIntegers F) :=
  fixedFieldIntegersIsDVR_of_valuesFromBase F (fixedFieldValuesFromBase F)

instance : IsLocalRing (Integers F) :=
  AdicCompletion.isLocalRing_of_fg (maximalIdeal (fixedFieldIntegers F)).fg_of_isNoetherianRing

instance : IsLocalHom (algebraMap (fixedFieldIntegers F) (Integers F)) :=
  AdicCompletion.algebraMap_isLocalHom_of_fg
    (maximalIdeal (fixedFieldIntegers F)).fg_of_isNoetherianRing

instance : Algebra 𝒪[F] (Integers F) :=
  ((algebraMap (fixedFieldIntegers F) (Integers F)).comp (integerToFixedField F)).toAlgebra

instance : IsLocalHom (algebraMap 𝒪[F] (Integers F)) := by
  change IsLocalHom ((algebraMap (fixedFieldIntegers F) (Integers F)).comp (integerToFixedField F))
  infer_instance

/-- The residue field of the completed integer ring. -/
abbrev Residue := ResidueField (Integers F)

/-- The original local map to the completion induces an isomorphism on residue fields. -/
def residueEquiv : ResidueField (fixedFieldIntegers F) ≃+* Residue F :=
  RingEquiv.ofBijective _ (AdicCompletion.residueField_map_bijective (fixedFieldIntegers F))

@[simp]
theorem residueEquiv_residue (x : fixedFieldIntegers F) :
    residueEquiv F (residue _ x) = residue (Integers F) (algebraMap _ _ x) := rfl

instance : Algebra 𝓀[F] (Residue F) :=
  (ResidueField.map (algebraMap 𝒪[F] (Integers F))).toAlgebra

instance : IsScalarTower 𝒪[F] 𝓀[F] (Residue F) :=
  IsScalarTower.of_algebraMap_eq' rfl

instance : IsAlgClosure 𝓀[F] (Residue F) := by
  let := (residueToFixedField F).toAlgebra
  have : IsAlgClosure 𝓀[F] (ResidueField (fixedFieldIntegers F)) := fixedFieldResidueIsAlgClosure F
  have : IsAlgClosed (ResidueField (fixedFieldIntegers F)) := IsAlgClosure.isAlgClosed 𝓀[F]
  refine ⟨IsAlgClosed.of_ringEquiv _ _ (residueEquiv F), ?_⟩
  apply Algebra.IsAlgebraic.ringHom_of_comp_eq (RingHom.id 𝓀[F]) (residueEquiv F)
    Function.injective_id (residueEquiv F).surjective
  ext x
  obtain ⟨x, rfl⟩ := residue_surjective x
  rfl

/-- The unramified integer ring has the same uniformizer as the original integer ring. -/
theorem maximalIdeal_before_eq_span_uniformizer {π : 𝒪[F]} (hπ : Irreducible π) :
    maximalIdeal (fixedFieldIntegers F) = Ideal.span {integerToFixedField F π} := by
  let v := fixedFieldValuation F
  refine le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · intro z hz
    obtain ⟨a, ha⟩ := fixedFieldValuesFromBase F (z : inertiaFixedField F)
    have hza : v z = v (algebraMap F (inertiaFixedField F) a) :=
      ha.trans (fixedFieldValuation_base F a).symm
    have ha₁ : valuation F a < 1 :=
      (Valuation.HasExtension.val_map_lt_one_iff (valuation F) v a).mp
        (hza ▸ (Valuation.mem_maximalIdeal_iff _ v).mp hz)
    let a₀ : 𝒪[F] := ⟨a, ha₁.le⟩
    have ha₀ : a₀ ∈ maximalIdeal (𝒪[F]) := (Valuation.mem_maximalIdeal_iff _ _).mpr ha₁
    have haπ : valuation F a ≤ valuation F π := by
      change a₀ ∈ (maximalIdeal (𝒪[F]) : Set (𝒪[F])) at ha₀
      rw [Irreducible.maximalIdeal_eq_setOfPred_le_v_coe (valuation F) hπ] at ha₀
      exact ha₀
    change z ∈ (Ideal.span {integerToFixedField F π} : Set (fixedFieldIntegers F))
    rw [Valuation.integer.coe_span_singleton_eq_setOfPred_le_v_coe]
    exact hza.le.trans ((Valuation.HasExtension.val_map_le_iff (valuation F) v a π).mpr haπ)
  · apply (Valuation.mem_maximalIdeal_iff _ v).mpr
    exact (Valuation.HasExtension.val_map_lt_one_iff (valuation F) v π).mpr
      (Valuation.integer.v_irreducible_lt_one (v := valuation F) hπ)

/-- The completed base's maximal ideal is generated by the image of the base uniformizer. -/
theorem maximalIdeal_eq_span_uniformizer {π : 𝒪[F]} (hπ : Irreducible π) :
    maximalIdeal (Integers F) = Ideal.span {algebraMap 𝒪[F] (Integers F) π} := by
  let i := algebraMap (fixedFieldIntegers F) (Integers F)
  calc
    maximalIdeal (Integers F) = Ideal.map i (maximalIdeal (fixedFieldIntegers F)) :=
      AdicCompletion.maximalIdeal_eq_map
    _ = Ideal.map i (Ideal.span {integerToFixedField F π}) :=
      congrArg (Ideal.map i) (maximalIdeal_before_eq_span_uniformizer F hπ)
    _ = Ideal.span {algebraMap 𝒪[F] (Integers F) π} := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl

/-- The original uniformizer acts by zero on the completed base's residue field. -/
theorem residue_uniformizer {π : 𝒪[F]} (hπ : Irreducible π) :
    algebraMap 𝒪[F] (Residue F) π = 0 := by
  change residue (Integers F) (algebraMap 𝒪[F] (Integers F) π) = 0
  rw [residue_eq_zero_iff, maximalIdeal_eq_span_uniformizer F hπ]
  exact Ideal.subset_span (Set.mem_singleton _)

end Langlands.LocalGalois.Separable.UnramifiedCompletion
