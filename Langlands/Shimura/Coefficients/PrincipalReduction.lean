import Langlands.Shimura.Coefficients.Lattice
import Mathlib.Topology.Algebra.Module.ModuleTopology

noncomputable section

universe u v w

namespace Langlands.Shimura.Coefficients

open scoped Pointwise TensorProduct

section Principal

variable {R : Type u} [CommRing R]
variable {K : Type v} [Field K] [Algebra R K]
variable {V : Type w} [AddCommGroup V] [Module K V] [Module R V] [IsScalarTower R K V]
variable [TopologicalSpace V] [ContinuousConstSMul K V]

/-- Every nonzero principal-ideal power of an open submodule is open in the ambient space. -/
theorem principalPower_smul_isOpen (a : R) (ha : algebraMap R K a ≠ 0)
    (Λ : Submodule R V) (hΛ : IsOpen (Λ : Set V)) (n : ℕ) :
    IsOpen (((Ideal.span {a}) ^ n • Λ : Submodule R V) : Set V) := by
  rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul,
    Submodule.coe_pointwise_smul]
  have heq : (a ^ n) • (Λ : Set V) = (algebraMap R K a ^ n) • (Λ : Set V) := by
    rw [← map_pow]
    ext x
    simp only [Set.mem_smul_set, algebraMap_smul]
  rw [heq]
  exact hΛ.smul₀ (pow_ne_zero n ha)

/-- The reduction submodule has the topology induced from its ambient scalar multiple. -/
theorem principalPower_top_isOpen (a : R) (ha : algebraMap R K a ≠ 0)
    (Λ : Submodule R V) (hΛ : IsOpen (Λ : Set V)) (n : ℕ) :
    IsOpen (((Ideal.span {a}) ^ n • ⊤ : Submodule R Λ) : Set Λ) := by
  have heq : (((Ideal.span {a}) ^ n • ⊤ : Submodule R Λ) : Set Λ) =
      (Subtype.val : Λ → V) ⁻¹' (((Ideal.span {a}) ^ n • Λ : Submodule R V) : Set V) := by
    ext x
    exact Submodule.mem_smul_top_iff _ _ _
  rw [heq]
  exact (principalPower_smul_isOpen a ha Λ hΛ n).preimage continuous_subtype_val

end Principal

section Coefficients

open Langlands.Global

variable {L : Type u} [Field L] [NumberField L] (l : FinitePlace L)

/-- The ideal generated by a rational natural-number scalar in the local coefficient ring. -/
def coefficientScalarIdeal (m : ℕ) : Ideal (CoefficientIntegers l) :=
  Ideal.span {(m : CoefficientIntegers l)}

variable (W : Type w) [AddCommGroup W] [Module L W]

/-- Reduction by a nonzero rational scalar has an open kernel on every open local lattice. -/
theorem coefficientScalarPower_isOpen (m : ℕ) (hm : m ≠ 0)
    (Λ : Submodule (CoefficientIntegers l) (FiniteCompletion L l ⊗[L] W)) :
    letI := moduleTopology (FiniteCompletion L l) (FiniteCompletion L l ⊗[L] W)
    IsOpen (Λ : Set (FiniteCompletion L l ⊗[L] W)) →
      ∀ n : ℕ, IsOpen (((coefficientScalarIdeal l m) ^ n • ⊤ :
        Submodule (CoefficientIntegers l) Λ) : Set Λ) := by
  let _ := moduleTopology (FiniteCompletion L l) (FiniteCompletion L l ⊗[L] W)
  let : CharZero (FiniteCompletion L l) := Algebra.charZero_of_charZero L (FiniteCompletion L l)
  intro hΛ n
  apply principalPower_top_isOpen (K := FiniteCompletion L l) _ _ Λ hΛ n
  simpa only [map_natCast] using (Nat.cast_ne_zero.mpr hm : (m : FiniteCompletion L l) ≠ 0)

end Coefficients

end Langlands.Shimura.Coefficients
