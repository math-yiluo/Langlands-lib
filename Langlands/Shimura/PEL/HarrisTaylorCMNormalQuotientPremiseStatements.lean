import Langlands.Shimura.PEL.HarrisTaylorCMNormalActions
import Mathlib.AlgebraicGeometry.Morphisms.Etale
import Mathlib.CategoryTheory.Sites.IsSheafFor

/-! # Étale descent, étale-local lifting and connected fibres of the normalized CM classes -/

noncomputable section

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj TensorProduct

set_option autoImplicit false

namespace Langlands.Shimura.PEL.HarrisTaylorCMWeilLevel

open NumberField _root_.Algebra Langlands.AbelianScheme HarrisPolarizedWeilLevel
open Langlands.AlgebraicGeometry.Picard Langlands.Scheme.Modules
open Langlands.AlgebraicGeometry.FiniteEtale Langlands.GroupScheme

variable {E F A : Type}
  [Field E] [NumberField E] [IsTotallyReal E]
  [Field F] [NumberField F] [IsTotallyComplex F] [IsCMField F]
  [Algebra E F] [IsQuadraticExtension E F]
  [Ring A] [Algebra E A] [Algebra F A] [IsScalarTower E F A]
  [Algebra ℚ A] [IsScalarTower ℚ E A] [IsScalarTower ℚ F A]
  {n : ℕ} (D : CentralSimpleUnitaryData E F A n)
  {L : Type} [Field L] [NumberField L] [IsCMField L]
  [IsQuadraticExtension ℚ L] [Algebra L F]
  {τ₀ : L →+* ℂ}
  (C : HarrisSignatureCharts D.toSecondKindInvolution n
    (harrisCMSection E (algebraMap L F) τ₀))
  (preservation : pullbackTensorComparisonIsIsoStatement.{0})
  (composition : PullbackTensorCompositionStatement.{0})
  (unitCoherence : PullbackTensorUnitCoherenceStatement.{0})
  (associativity : ExplicitPullbackTensorAssociativityStatement.{0})
  (comparison : TensorMonoidalLeftUnitorComparisonStatement.{0})
  (symmetry : PullbackTensorSymmetryStatement.{0})
  (stability : PicardZeroPullbackStatement.{0})
  (square : MumfordBundlePicardZeroStatement.{0})
  (universality : PicardZeroUniversalBaseChangeStatement.{0})
  (dualityNaturality : DualAbelianBaseChangeNaturalityStatement.{0})
  (polarizationStability : PolarizationBaseChangeStatement.{0})
  (compatibility : RelativeFiniteWeilTransitionStatement.{0})
  (h : Global.RationalProfiniteIntegerAdeleComparison)
  (htor : TorsionFiniteEtaleStatement.{0})

local notation "DisBases" => ComponentwiseAdmissibleCMBaseCategory D C preservation
  composition unitCoherence associativity comparison symmetry stability square universality
local notation "moduli" => smallLevelClassPresheafTower D C preservation composition
  unitCoherence associativity comparison symmetry stability square universality
  dualityNaturality polarizationStability compatibility h htor

/-- Étale descent for the normalized class presheaf at every small level: for
every admissible test `S` and every family of admissible tests `T i` with étale
morphisms `T i ⟶ S` over `Spec F` whose images cover `S`, the presheaf
`(smallLevelClassPresheafTower …).obj U` satisfies the sheaf condition for the
presieve generated by the family. -/
def CMSmallLevelEtaleSheafStatement : Prop :=
  ∀ (U : SmallCMLevel D) (S : DisBases) (J : Type) (T : J → DisBases) (f : ∀ i, T i ⟶ S),
    (∀ i, Etale (f i).hom.left) →
    (∀ x : S.obj.left, ∃ (i : J) (y : (T i).obj.left), (f i).hom.left.base y = x) →
    Presieve.IsSheafFor ((moduli).obj U) (Presieve.ofArrows T f)

/-- Étale-local lifting along a smaller small level: for small levels `U' ≤ U`,
every class at level `U` on an admissible test `S` becomes, after pullback along
some étale surjective morphism of admissible tests `S₁ ⟶ S`, the image of a
class at level `U'` under the forgetting transition of the presheaf tower. -/
def CMSublevelEtaleLiftStatement : Prop :=
  ∀ (U' U : SmallCMLevel D) (hle : U'.obj.subgroup ≤ U.obj.subgroup) (S : DisBases)
    (c : ((moduli).obj U).obj (Opposite.op S)),
    ∃ (S₁ : DisBases) (p : S₁ ⟶ S) (c₁ : ((moduli).obj U').obj (Opposite.op S₁)),
      Etale p.hom.left ∧ Surjective p.hom.left ∧
        ((moduli).map (smallCMInclusion D hle)).app (Opposite.op S₁) c₁ =
          ((moduli).obj U).map p.op c

/-- Fibres of the forgetting transition on connected tests: for small levels
`U' ≤ U` with `U'` normal in `U` and an admissible test `T` whose underlying
scheme is connected, two classes at level `U'` on `T` with the same image at
level `U` differ by the inverse right translation of some element of `U`. -/
def CMNormalSublevelConnectedFibreStatement : Prop :=
  ∀ (U' U : SmallCMLevel D) (hle : U'.obj.subgroup ≤ U.obj.subgroup)
    [(U'.obj.subgroup.subgroupOf U.obj.subgroup).Normal] (T : DisBases),
    ConnectedSpace T.obj.left →
    ∀ c₁ c₂ : ((moduli).obj U').obj (Opposite.op T),
      ((moduli).map (smallCMInclusion D hle)).app (Opposite.op T) c₁ =
          ((moduli).map (smallCMInclusion D hle)).app (Opposite.op T) c₂ →
        ∃ g : U.obj.subgroup,
          ((moduli).map (smallCMNormalInverseArrow D U U' hle g)).app (Opposite.op T) c₁ = c₂

end Langlands.Shimura.PEL.HarrisTaylorCMWeilLevel
