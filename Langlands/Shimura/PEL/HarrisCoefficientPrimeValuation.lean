import Langlands.Shimura.PEL.HarrisTaylorCMEllAdicGaloisCohomology
import Langlands.Global.AdelicFunctoriality.LocalDegree
import Langlands.Shimura.Coefficients.FiniteReduction
import Langlands.Shimura.Coefficients.HarrisReduction

/-! # The coefficient prime in the completed coefficient rings

The coefficient prime `ℓ` of a rational finite place `p` has valuation `< 1` at every place `l` of
a number field `K` above `p`. Hence `ℓ` is a nonzero non-unit of the valuation ring `O_l`, its
powers tend to zero in `O_l`, and `ℓ` is a non-unit of the product `∏_{l | p} O_l`. The
coefficient rings `O_l / ℓ^r` and `(∏_{l | p} O_l) / ℓ^r` of Harris's `ℓ`-power stages are
therefore finite and nonzero for `r ≥ 1`. See `HarrisCoefficientPrimeValuation.md`.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Shimura.PEL.HarrisTaylorCMWeilLevel

open NumberField Filter Topology IsDedekindDomain HeightOneSpectrum
open Langlands.Global AdelicFunctoriality Langlands.Shimura.Coefficients

variable (p : Langlands.Global.FinitePlace ℚ) {K : Type} [Field K] [NumberField K]

/-- The coefficient prime has valuation `< 1` in the completion at every place above `p`. -/
theorem harrisCoefficientPrime_valued_lt_one (l : FinitePlacesAbove K p) :
    Valued.v ((harrisCoefficientPrime p : ℕ) : FiniteCompletion K l.1) < 1 := by
  have h := (valuation_lt_one_iff_mem (K := K) l.1 _).2 (harrisCoefficientPrime_mem_above p l)
  have e := valuedAdicCompletion_eq_valuation (K := K) l.1
    ((harrisCoefficientPrime p : ℕ) : 𝓞 K)
  simp only [map_natCast] at e h
  rwa [e]

/-- The coefficient prime is nonzero in the completion at every place above `p`. -/
theorem harrisCoefficientPrime_ne_zero_completion (l : FinitePlacesAbove K p) :
    ((harrisCoefficientPrime p : ℕ) : FiniteCompletion K l.1) ≠ 0 := by
  have h : ((harrisCoefficientPrime p : ℕ) : K) ≠ 0 :=
    Nat.cast_ne_zero.2 (harrisCoefficientPrime_ne_zero p)
  have e : ((harrisCoefficientPrime p : ℕ) : FiniteCompletion K l.1) =
      algebraMap K (FiniteCompletion K l.1) (harrisCoefficientPrime p : ℕ) :=
    (map_natCast _ _).symm
  rw [e]
  exact (map_ne_zero _).2 h

/-- The coefficient prime is not a unit of the valuation ring `O_l` at a place `l` above `p`. -/
theorem harrisCoefficientPrime_not_isUnit (l : FinitePlacesAbove K p) :
    ¬ IsUnit ((harrisCoefficientPrime p : ℕ) : CoefficientIntegers l.1) := by
  rw [adicCompletionIntegers.isUnit_iff_valued_eq_one]
  push_cast
  exact (harrisCoefficientPrime_valued_lt_one p l).ne

/-- The powers of the coefficient prime tend to zero in the valuation ring `O_l`. -/
theorem tendsto_harrisCoefficientPrime_pow (l : FinitePlacesAbove K p) :
    Tendsto (fun r : ℕ => ((harrisCoefficientPrime p : ℕ) : CoefficientIntegers l.1) ^ r)
      atTop (𝓝 0) := by
  rw [tendsto_subtype_rng]
  push_cast
  exact Valued.tendsto_zero_pow_of_v_lt_one (harrisCoefficientPrime_valued_lt_one p l)

/-- The coefficient prime is not a unit of `∏_{l | p} O_l`. -/
theorem harrisCoefficientPrime_not_isUnit_integers :
    ¬ IsUnit ((harrisCoefficientPrime p : ℕ) : HarrisCoefficientIntegers K p) := by
  intro hu
  let l : FinitePlacesAbove K p := placeAbove K p
  apply harrisCoefficientPrime_not_isUnit p l
  simpa using hu.map (Pi.evalRingHom (fun l' : FinitePlacesAbove K p =>
    CoefficientIntegers l'.1) l)

/-! ## The coefficient rings modulo powers of `ℓ` -/

variable (K) in
/-- The coefficient ring `(∏_{l | p} O_l) / ℓ^r` of Harris's `ℓ`-power stage `r`. -/
abbrev HarrisEllCoefficientRing (r : ℕ) :=
  HarrisCoefficientReductionRing K p (harrisCoefficientPrime p) r

/-- The coefficient ring `O_l / ℓ^r` at a place `l` above `p`. -/
abbrev HarrisEllPlaceCoefficientRing (l : FinitePlacesAbove K p) (r : ℕ) :=
  CoefficientReductionRing l.1 (harrisCoefficientPrime p) r

/-- The ideal generated by the coefficient prime in `O_l` is proper. -/
theorem coefficientScalarIdeal_harrisCoefficientPrime_ne_top (l : FinitePlacesAbove K p) :
    coefficientScalarIdeal l.1 (harrisCoefficientPrime p) ≠ ⊤ := by
  rw [coefficientScalarIdeal, Ne, Ideal.span_singleton_eq_top]
  exact harrisCoefficientPrime_not_isUnit p l

variable (K) in
/-- The ideal generated by the coefficient prime in `∏_{l | p} O_l` is proper. -/
theorem harrisCoefficientScalarIdeal_harrisCoefficientPrime_ne_top :
    harrisCoefficientScalarIdeal K p (harrisCoefficientPrime p) ≠ ⊤ := by
  rw [harrisCoefficientScalarIdeal, Ne, Ideal.span_singleton_eq_top]
  exact harrisCoefficientPrime_not_isUnit_integers p

/-- The coefficient ring `O_l / ℓ^r` is nonzero for `r ≥ 1`. -/
theorem harrisEllPlaceCoefficientRing_nontrivial (l : FinitePlacesAbove K p) {r : ℕ}
    (hr : r ≠ 0) : Nontrivial (HarrisEllPlaceCoefficientRing p l r) :=
  Ideal.Quotient.nontrivial_iff.2 (ne_top_of_le_ne_top
    (coefficientScalarIdeal_harrisCoefficientPrime_ne_top p l) (Ideal.pow_le_self hr))

variable (K) in
/-- The coefficient ring `(∏_{l | p} O_l) / ℓ^r` is nonzero for `r ≥ 1`. -/
theorem harrisEllCoefficientRing_nontrivial {r : ℕ} (hr : r ≠ 0) :
    Nontrivial (HarrisEllCoefficientRing p K r) :=
  Ideal.Quotient.nontrivial_iff.2 (ne_top_of_le_ne_top
    (harrisCoefficientScalarIdeal_harrisCoefficientPrime_ne_top p K) (Ideal.pow_le_self hr))

/-- The coefficient ring `O_l / ℓ^r` is finite. -/
theorem harrisEllPlaceCoefficientRing_finite (l : FinitePlacesAbove K p) (r : ℕ) :
    Finite (HarrisEllPlaceCoefficientRing p l r) :=
  coefficientReductionRing_finite l.1 _ (harrisCoefficientPrime_ne_zero p) r

variable (K) in
/-- The coefficient ring `(∏_{l | p} O_l) / ℓ^r` is finite. -/
theorem harrisEllCoefficientRing_finite (r : ℕ) : Finite (HarrisEllCoefficientRing p K r) :=
  harrisCoefficientReductionRing_finite K p _ (harrisCoefficientPrime_ne_zero p) r

end Langlands.Shimura.PEL.HarrisTaylorCMWeilLevel
