import Langlands.Shimura.PEL.HarrisTaylorCMGeneratorDeterminant
import Langlands.Shimura.PEL.RationalLieDeterminantBaseChange
import Langlands.AbelianScheme.LieBaseChangeNaturalityProof
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import Mathlib.RingTheory.Finiteness.Ideal

/-! # Coefficient ideals and affine loci of the normalized Harris determinant -/

noncomputable section

open CategoryTheory _root_.AlgebraicGeometry MvPolynomial
open Langlands.Scheme.Modules
open Langlands.AlgebraicGeometry.SmoothProperConnectedGlobalFunctionsProof

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u v w

namespace Langlands.Shimura.HodgeDeterminant

variable {R : Type u} [CommRing R] {σ : Type v}

/-- The ideal generated by all the coefficients of an actual polynomial. -/
def coefficientIdeal (q : MvPolynomial σ R) : Ideal R :=
  Ideal.span (Set.range q.coeff)

theorem coefficientIdeal_eq_span_support (q : MvPolynomial σ R) :
    coefficientIdeal q = Ideal.span (q.coeff '' (q.support : Set (σ →₀ ℕ))) := by
  classical
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨d, rfl⟩
    by_cases hd : d ∈ q.support
    · exact Ideal.subset_span ⟨d, hd, rfl⟩
    · have hz : q.coeff d = 0 := by simpa only [mem_support_iff, not_not] using hd
      rw [hz]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro _ ⟨d, _, rfl⟩
    exact Ideal.subset_span ⟨d, rfl⟩

/-- No Noetherian hypothesis is needed: the polynomial has finite support. -/
theorem coefficientIdeal_fg (q : MvPolynomial σ R) : (coefficientIdeal q).FG := by
  rw [coefficientIdeal_eq_span_support]
  exact Submodule.fg_span (q.support.finite_toSet.image _)

/-- Formation of the coefficient ideal commutes with every coefficient map. -/
theorem coefficientIdeal_map {T : Type w} [CommRing T]
    (f : R →+* T) (q : MvPolynomial σ R) :
    (coefficientIdeal q).map f = coefficientIdeal (MvPolynomial.map f q) := by
  unfold coefficientIdeal
  rw [Ideal.map_span]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_range, coeff_map]
  constructor
  · rintro ⟨_, ⟨d, rfl⟩, rfl⟩
    exact ⟨d, rfl⟩
  · rintro ⟨d, rfl⟩
    exact ⟨q.coeff d, ⟨d, rfl⟩, rfl⟩

/-- An arbitrary coefficient map kills the ideal exactly when it kills the polynomial. -/
theorem coefficientIdeal_le_ker_iff {T : Type w} [CommRing T]
    (f : R →+* T) (q : MvPolynomial σ R) :
    coefficientIdeal q ≤ RingHom.ker f ↔ MvPolynomial.map f q = 0 := by
  simp [coefficientIdeal, Ideal.span_le, Set.range_subset_iff,
    MvPolynomial.ext_iff, MvPolynomial.coeff_map]

theorem coefficientIdeal_sub_le_ker_iff {T : Type w} [CommRing T]
    (f : R →+* T) (p q : MvPolynomial σ R) :
    coefficientIdeal (p - q) ≤ RingHom.ker f ↔
      MvPolynomial.map f p = MvPolynomial.map f q := by
  rw [coefficientIdeal_le_ker_iff, map_sub, sub_eq_zero]

theorem coefficientIdeal_eq_bot_iff (q : MvPolynomial σ R) :
    coefficientIdeal q = ⊥ ↔ q = 0 := by
  have hk : RingHom.ker (RingHom.id R) = ⊥ :=
    (RingHom.injective_iff_ker_eq_bot _).mp Function.injective_id
  simpa only [hk, map_id, le_bot_iff] using
    coefficientIdeal_le_ker_iff (RingHom.id R) q

/-- A prescribed finite coefficient index set also generates the ideal if
all coefficients outside it vanish. -/
theorem coefficientIdeal_eq_span_of_coeff_zero
    (q : MvPolynomial σ R) (s : Finset (σ →₀ ℕ))
    (hs : ∀ d ∉ s, q.coeff d = 0) :
    coefficientIdeal q = Ideal.span (q.coeff '' (s : Set (σ →₀ ℕ))) := by
  classical
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨d, rfl⟩
    by_cases hd : d ∈ s
    · exact Ideal.subset_span ⟨d, hd, rfl⟩
    · rw [hs d hd]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro _ ⟨d, _, rfl⟩
    exact Ideal.subset_span ⟨d, rfl⟩

/-- The union of the two homogeneous degrees generates the equality ideal. -/
theorem coefficientIdeal_sub_eq_span_homogeneous
    [Finite σ] {p q : MvPolynomial σ R} {m n : ℕ}
    (hp : p.IsHomogeneous m) (hq : q.IsHomogeneous n) :
    coefficientIdeal (p - q) =
      Ideal.span ((p - q).coeff ''
        (homogeneousEquationIndices σ m n : Set (σ →₀ ℕ))) := by
  apply coefficientIdeal_eq_span_of_coeff_zero
  intro d hd
  rw [mem_homogeneousEquationIndices] at hd
  rw [coeff_sub, hp.coeff_eq_zero (fun hm => hd (Or.inl hm)),
    hq.coeff_eq_zero (fun hn => hd (Or.inr hn)), sub_self]

end Langlands.Shimura.HodgeDeterminant

namespace Langlands.AlgebraicGeometry.PolynomialCoefficientLocus

open Langlands.Shimura.HodgeDeterminant

variable {X : Scheme.{u}} {σ : Type v}

/-- The ideal sheaf generated by the coefficients of an equality of global polynomials. -/
def idealSheaf (p q : MvPolynomial σ Γ(X, ⊤)) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (coefficientIdeal (p - q))

/-- The actual closed subscheme cut out by these coefficient equations. -/
def scheme (p q : MvPolynomial σ Γ(X, ⊤)) : Scheme.{u} :=
  (idealSheaf p q).subscheme

/-- Its actual inclusion into the supplied ambient scheme. -/
def ι (p q : MvPolynomial σ Γ(X, ⊤)) : scheme p q ⟶ X :=
  (idealSheaf p q).subschemeι

instance (p q : MvPolynomial σ Γ(X, ⊤)) : IsClosedImmersion (ι p q) := by
  dsimp [ι]
  infer_instance

/-- Over an affine ambient scheme, factorization is exactly coefficientwise
equality after pullback, for every test scheme. -/
theorem factors_iff [IsAffine X] (p q : MvPolynomial σ Γ(X, ⊤))
    {T : Scheme.{u}} (f : T ⟶ X) :
    (∃ k : T ⟶ scheme p q, k ≫ ι p q = f) ↔
      MvPolynomial.map f.appTop.hom p = MvPolynomial.map f.appTop.hom q := by
  rw [← coefficientIdeal_sub_le_ker_iff]
  constructor
  · rintro ⟨k, hk⟩
    have hker : idealSheaf p q ≤ f.ker := by
      rw [← hk]
      simpa only [ι, Scheme.IdealSheafData.ker_subschemeι] using k.le_ker_comp (ι p q)
    rw [Scheme.ker_of_isAffine] at hker
    have ht := hker ⟨⊤, isAffineOpen_top X⟩
    have hid : homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤) = 𝟙 (⊤ : X.Opens) :=
      Subsingleton.elim _ _
    simpa only [idealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal,
      hid, CategoryTheory.op_id, X.presheaf.map_id, CommRingCat.hom_id,
      Ideal.map_id] using ht
  · intro h
    have hker : (ι p q).ker ≤ f.ker := by
      rw [ι, Scheme.IdealSheafData.ker_subschemeι, Scheme.ker_of_isAffine]
      intro U
      exact Ideal.map_mono h
    exact ⟨IsClosedImmersion.lift (ι p q) f hker,
      IsClosedImmersion.lift_fac (ι p q) f hker⟩

end Langlands.AlgebraicGeometry.PolynomialCoefficientLocus

namespace Langlands.Shimura.CentralSimpleUnitaryData

open NumberField _root_.Algebra Langlands.AbelianScheme

variable {E F A : Type}
    [Field E] [NumberField E] [IsTotallyReal E]
    [Field F] [NumberField F] [IsTotallyComplex F]
    [Algebra E F] [IsQuadraticExtension E F]
    [Ring A] [Algebra E A] [Algebra F A] [IsScalarTower E F A]
    [Algebra ℚ A] [IsScalarTower ℚ E A] [IsScalarTower ℚ F A]
    {n : ℕ} (D : CentralSimpleUnitaryData E F A n)
    {L : Type} [Field L] [NumberField L] [IsCMField L]
    [IsQuadraticExtension ℚ L] [Algebra L F]
    {τ₀ : L →+* ℂ}
    (C : HarrisSignatureCharts D.toSecondKindInvolution n
      (harrisCMSection E (algebraMap L F) τ₀))
    {S : Scheme.{0}} (p : S ⟶ Spec (.of F))
    (B : AbelianScheme S) (i : A →ₐ[ℚ] End0 B)
    {U : S.Opens} {I : Type} [Fintype I]

local notation "hΦ" => isCMSection_harrisCMSection E (algebraMap L F) τ₀
local notation "g" => D.harrisHodgePELOrderGenerators C
local notation "α" => D.harrisRationalOrderAction C B i

/-- The finitely generated ideal of the normalized determinant equation for
the fixed generating family, in the full actual section ring. -/
def harrisTaylorCMDeterminantIdeal
    (e : SheafOfModules.free (R := S.ringCatSheaf.over U) I ≅ B.Lie.over U)
    (V : Over U) : Ideal Γ(S, V.left) :=
  HodgeDeterminant.coefficientIdeal
    (lieRationalSectionDeterminant p B α e g V -
      MvPolynomial.map (secHom p V.left).hom
        (D.kottwitzReflexDeterminantBaseChange C hΦ (fun k => (g k : A))
          (D.harrisTaylorReflexToCM C).toRingHom))

theorem harrisTaylorCMDeterminantIdeal_fg
    (e : SheafOfModules.free (R := S.ringCatSheaf.over U) I ≅ B.Lie.over U)
    (V : Over U) : (D.harrisTaylorCMDeterminantIdeal C p B i e V).FG :=
  HodgeDeterminant.coefficientIdeal_fg _

/-- Vanishing of the ideal imposes every finite order-family test on this
same chart and smaller open. -/
theorem harrisTaylorCMDeterminantIdeal_eq_bot_iff
    (e : SheafOfModules.free (R := S.ringCatSheaf.over U) I ≅ B.Lie.over U)
    (V : Over U) :
    D.harrisTaylorCMDeterminantIdeal C p B i e V = ⊥ ↔
      ∀ (κ : Type) [Fintype κ] (a : κ → D.harrisHodgePELIntegralOrder C),
        D.HarrisTaylorCMRationalLieDeterminantConditionAt C p B i e a V := by
  rw [D.harrisTaylorCMRationalLieDeterminantConditionAt_iff_generators C p B i
    g (D.span_harrisHodgePELOrderGenerators C) e V]
  exact (HodgeDeterminant.coefficientIdeal_eq_bot_iff _).trans sub_eq_zero

/-- The ideal agrees on every common smaller open of any two Lie charts,
without a same-rank hypothesis. -/
theorem harrisTaylorCMDeterminantIdeal_overlap
    (e : SheafOfModules.free (R := S.ringCatSheaf.over U) I ≅ B.Lie.over U)
    {U' W : S.Opens} {J : Type} [Fintype J]
    (e' : SheafOfModules.free (R := S.ringCatSheaf.over U') J ≅ B.Lie.over U')
    (j : W ⟶ U) (j' : W ⟶ U') :
    D.harrisTaylorCMDeterminantIdeal C p B i e (Over.mk j) =
      D.harrisTaylorCMDeterminantIdeal C p B i e' (Over.mk j') := by
  unfold harrisTaylorCMDeterminantIdeal
  rw [lieRationalSectionDeterminant_overlap p B α e e' g j j']
  rfl

/-- Restricting the ideal gives exactly the ideal on the smaller open. -/
theorem harrisTaylorCMDeterminantIdeal_restrict
    (e : SheafOfModules.free (R := S.ringCatSheaf.over U) I ≅ B.Lie.over U)
    {V W : Over U} (j : V ⟶ W) :
    (D.harrisTaylorCMDeterminantIdeal C p B i e W).map
        (S.presheaf.map j.left.op).hom =
      D.harrisTaylorCMDeterminantIdeal C p B i e V := by
  unfold harrisTaylorCMDeterminantIdeal
  rw [HodgeDeterminant.coefficientIdeal_map, map_sub,
    lieRationalSectionDeterminant_restrict p B α e g j, MvPolynomial.map_map]
  congr 3
  apply congrArg MvPolynomial.map
  have hj : homOfLE (leOfHom j.left) = j.left := Subsingleton.elim _ _
  simpa only [CommRingCat.hom_comp, hj] using
    congrArg CommRingCat.Hom.hom (secHom_map p (leOfHom j.left))

/-- The coefficient ideal commutes with actual abelian-scheme and action base change. -/
theorem harrisTaylorCMDeterminantIdeal_baseChange
    {T : Scheme.{0}} (b : T ⟶ S)
    (e : SheafOfModules.free (R := S.ringCatSheaf.over U) I ≅ B.Lie.over U)
    (V : Over U) :
    (D.harrisTaylorCMDeterminantIdeal C p B i e V).map (b.app V.left).hom =
      D.harrisTaylorCMDeterminantIdeal C (b ≫ p) ((baseChange b).obj B)
        ((rationalBaseChangeEnd b B).comp i) (lieBaseChangeChart b B e)
        (Over.mk ((TopologicalSpace.Opens.map b.base).map V.hom)) := by
  unfold harrisTaylorCMDeterminantIdeal
  rw [HodgeDeterminant.coefficientIdeal_map, map_sub,
    lieRationalSectionDeterminant_baseChange_of_naturality p b B α
      (lieBaseChangeNaturalityStatements S).1 e g V,
    D.harrisRationalOrderAction_baseChange C B i b, MvPolynomial.map_map]
  have hs : (b.app V.left).hom.comp (secHom p V.left).hom =
      (secHom (b ≫ p) (b ⁻¹ᵁ V.left)).hom :=
    congrArg CommRingCat.Hom.hom (secHom_comp_app p b V.left)
  rw [hs]
  rfl

/-- A single global free chart detects the condition on every finite Lie chart
and every smaller open, by restriction and basis independence. -/
theorem harrisTaylorCMDeterminantIdeal_eq_bot_iff_global
    (e : SheafOfModules.free (R := S.ringCatSheaf.over ⊤) I ≅ B.Lie.over ⊤) :
    D.harrisTaylorCMDeterminantIdeal C p B i e (Over.mk (𝟙 ⊤)) = ⊥ ↔
      D.HarrisTaylorCMRationalLieDeterminantCondition C p B i := by
  rw [D.harrisTaylorCMDeterminantIdeal_eq_bot_iff C p B i e (Over.mk (𝟙 ⊤))]
  constructor
  · intro h κ _ a U' J _ e' V
    let j : V.left ⟶ (⊤ : S.Opens) := homOfLE le_top
    have hsmall := D.harrisTaylorCMRationalLieDeterminantConditionAt_restrict C p B i
      e a (Over.homMk j : Over.mk j ⟶ Over.mk (𝟙 ⊤)) (h κ a)
    change lieRationalSectionDeterminant p B α e' a V = _
    calc
      _ = lieRationalSectionDeterminant p B α e a (Over.mk j) :=
        (lieRationalSectionDeterminant_overlap p B α e e' a j V.hom).symm
      _ = _ := hsmall
  · intro h κ _ a
    exact h κ a ⊤ I e (Over.mk (𝟙 ⊤))

/-- The normalized determinant locus inside a supplied family with globally free Lie module. -/
def harrisTaylorCMDeterminantLocus
    (e : SheafOfModules.free (R := S.ringCatSheaf.over ⊤) I ≅ B.Lie.over ⊤) : Scheme.{0} :=
  Langlands.AlgebraicGeometry.PolynomialCoefficientLocus.scheme
    (lieRationalSectionDeterminant p B α e g (Over.mk (𝟙 ⊤)))
    (MvPolynomial.map (secHom p ⊤).hom
      (D.kottwitzReflexDeterminantBaseChange C hΦ (fun k => (g k : A))
        (D.harrisTaylorReflexToCM C).toRingHom))

/-- The actual inclusion of the normalized determinant locus. -/
def harrisTaylorCMDeterminantLocusι
    (e : SheafOfModules.free (R := S.ringCatSheaf.over ⊤) I ≅ B.Lie.over ⊤) :
    D.harrisTaylorCMDeterminantLocus C p B i e ⟶ S :=
  Langlands.AlgebraicGeometry.PolynomialCoefficientLocus.ι _ _

instance
    (e : SheafOfModules.free (R := S.ringCatSheaf.over ⊤) I ≅ B.Lie.over ⊤) :
    IsClosedImmersion (D.harrisTaylorCMDeterminantLocusι C p B i e) := by
  dsimp [harrisTaylorCMDeterminantLocusι]
  infer_instance

/-- For every test scheme over an affine supplied family, factoring through the
closed determinant locus is equivalent to the full normalized determinant condition
on the actual pulled-back abelian scheme and rational action. -/
theorem harrisTaylorCMDeterminantLocus_factors_iff [IsAffine S]
    (e : SheafOfModules.free (R := S.ringCatSheaf.over ⊤) I ≅ B.Lie.over ⊤)
    {T : Scheme.{0}} (b : T ⟶ S) :
    (∃ k : T ⟶ D.harrisTaylorCMDeterminantLocus C p B i e,
      k ≫ D.harrisTaylorCMDeterminantLocusι C p B i e = b) ↔
      D.HarrisTaylorCMRationalLieDeterminantCondition C (b ≫ p)
        ((baseChange b).obj B) ((rationalBaseChangeEnd b B).comp i) := by
  dsimp only [harrisTaylorCMDeterminantLocus, harrisTaylorCMDeterminantLocusι]
  rw [Langlands.AlgebraicGeometry.PolynomialCoefficientLocus.factors_iff,
    ← HodgeDeterminant.coefficientIdeal_sub_le_ker_iff,
    ← Ideal.map_eq_bot_iff_le_ker]
  change (D.harrisTaylorCMDeterminantIdeal C p B i e (Over.mk (𝟙 ⊤))).map
      b.appTop.hom = ⊥ ↔ _
  have hbc :
      (D.harrisTaylorCMDeterminantIdeal C p B i e (Over.mk (𝟙 ⊤))).map b.appTop.hom =
        D.harrisTaylorCMDeterminantIdeal C (b ≫ p) ((baseChange b).obj B)
          ((rationalBaseChangeEnd b B).comp i) (lieBaseChangeChart b B e)
          (Over.mk (𝟙 ⊤)) := by
    have h := D.harrisTaylorCMDeterminantIdeal_baseChange C p B i b e (Over.mk (𝟙 ⊤))
    change
      (D.harrisTaylorCMDeterminantIdeal C p B i e (Over.mk (𝟙 ⊤))).map b.appTop.hom =
        D.harrisTaylorCMDeterminantIdeal C (b ≫ p) ((baseChange b).obj B)
          ((rationalBaseChangeEnd b B).comp i) (lieBaseChangeChart b B e)
          (Over.mk ((TopologicalSpace.Opens.map b.base).map (𝟙 (⊤ : S.Opens)))) at h
    have ht : (TopologicalSpace.Opens.map b.base).map (𝟙 (⊤ : S.Opens)) =
        𝟙 (⊤ : T.Opens) := Subsingleton.elim _ _
    rw [ht] at h
    exact h
  rw [hbc]
  exact D.harrisTaylorCMDeterminantIdeal_eq_bot_iff_global C (b ≫ p)
    ((baseChange b).obj B) ((rationalBaseChangeEnd b B).comp i) (lieBaseChangeChart b B e)

end Langlands.Shimura.CentralSimpleUnitaryData
