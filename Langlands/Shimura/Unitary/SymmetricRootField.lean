import Langlands.Shimura.Unitary.SymmetricReducedCharpoly
import Langlands.Algebra.ReducedNormSubfield
import Langlands.Algebra.ReducedCharpolyFromSplitFactors
import Langlands.Global.AdelicFunctoriality.NormReduction

/-! # The fields generated by a symmetric element with irreducible reduced polynomial -/

noncomputable section

namespace Langlands.Shimura.FiniteUnitary

open _root_.Algebra _root_.Polynomial NumberField Langlands.CentralSimple
open scoped TensorProduct

universe u v

section RootFields

variable {E : Type u} (K : Type v) [Field E] [Field K] [Algebra E K] (f : E[X])

local notation "p" => f.map (algebraMap E K)

/-- The actual coefficient-extension homomorphism between the two root algebras. -/
def rootAlgebraMap : AdjoinRoot f →ₐ[E] AdjoinRoot p :=
  AdjoinRoot.mapAlgHom (Algebra.ofId E K) f p dvd_rfl

@[simp] theorem rootAlgebraMap_root : rootAlgebraMap K f (AdjoinRoot.root f) = AdjoinRoot.root p :=
  AdjoinRoot.map_root (algebraMap E K) f p dvd_rfl

@[simp] theorem rootAlgebraMap_mk (h : E[X]) :
    rootAlgebraMap K f (AdjoinRoot.mk f h) = AdjoinRoot.mk p (h.map (algebraMap E K)) := by
  rw [← AdjoinRoot.aeval_eq, ← AdjoinRoot.aeval_eq, ← aeval_algHom_apply (rootAlgebraMap K f),
    rootAlgebraMap_root, aeval_eq_aeval_map (IsScalarTower.algebraMap_eq E K (AdjoinRoot p)).symm]

theorem upperRootField_finrank (hf : f.Monic) :
    Module.finrank K (AdjoinRoot p) = f.natDegree := by
  rw [Module.finrank_eq_card_basis (AdjoinRoot.powerBasisAux' (hf.map (algebraMap E K))),
    Fintype.card_fin, hf.natDegree_map]

variable [Fact (Irreducible f)] [Fact (Irreducible (f.map (algebraMap E K)))]

/-- The field generated by the base root in the upper root field. Its carrier
lives in the same universe as the upper field. -/
def symmetricRootField : IntermediateField E (AdjoinRoot p) :=
  (rootAlgebraMap K f).fieldRange

/-- The lower root field is an actual copy of the base polynomial's root algebra. -/
def symmetricRootFieldEquiv : AdjoinRoot f ≃ₐ[E] symmetricRootField K f :=
  (rootAlgebraMap K f).equivFieldRange

theorem symmetricRootField_finrank (hf : f.Monic) :
    Module.finrank E (symmetricRootField K f) = f.natDegree := by
  rw [← (symmetricRootFieldEquiv K f).toLinearEquiv.finrank_eq,
    Module.finrank_eq_card_basis (AdjoinRoot.powerBasisAux' hf), Fintype.card_fin]

theorem symmetricRootField_numberField [NumberField E] (hf : f.Monic) :
    NumberField (symmetricRootField K f) := by
  let : FiniteDimensional E (AdjoinRoot f) := hf.finite_adjoinRoot
  let : FiniteDimensional E (symmetricRootField K f) :=
    (symmetricRootFieldEquiv K f).toLinearEquiv.finiteDimensional
  exact NumberField.of_module_finite E _

/-- Extending the symmetric root field from the base to the quadratic center
identifies the upper root field with its actual tensor product. -/
def symmetricRootFieldBaseChange (hf : f.Monic) :
    {e : K ⊗[E] (symmetricRootField K f) ≃ₐ[K] AdjoinRoot p //
      ∀ z : symmetricRootField K f, e (1 ⊗ₜ[E] z) = (z : AdjoinRoot p)} := by
  let M := AdjoinRoot p
  let F := symmetricRootField K f
  let e : K ⊗[E] F →ₐ[K] M := Algebra.TensorProduct.lift (Algebra.ofId K M) F.val
    (fun a b => Algebra.commutes a (F.val b))
  have he (z : F) : e (1 ⊗ₜ[E] z) = (z : M) := by
    change (algebraMap K M 1) * F.val z = (z : M)
    rw [map_one, one_mul]
    rfl
  have hsurj : Function.Surjective e := by
    rw [← AlgHom.range_eq_top, ← top_le_iff, ← AdjoinRoot.adjoinRoot_eq_top (f := p)]
    apply Algebra.adjoin_le
    intro x hx
    have hx' : x = AdjoinRoot.root p := Set.mem_singleton_iff.mp hx
    subst x
    let z := symmetricRootFieldEquiv K f (AdjoinRoot.root f)
    refine ⟨1 ⊗ₜ[E] z, (he z).trans ?_⟩
    change rootAlgebraMap K f (AdjoinRoot.root f) = AdjoinRoot.root p
    exact rootAlgebraMap_root K f
  let : FiniteDimensional E (AdjoinRoot f) := hf.finite_adjoinRoot
  let : FiniteDimensional E F := (symmetricRootFieldEquiv K f).toLinearEquiv.finiteDimensional
  let : FiniteDimensional K M := (hf.map (algebraMap E K)).finite_adjoinRoot
  have hd : Module.finrank K (K ⊗[E] F) = Module.finrank K M := by
    rw [Module.finrank_baseChange, symmetricRootField_finrank K f hf, upperRootField_finrank K f hf]
  exact ⟨AlgEquiv.ofBijective e
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank
      (f := e.toLinearMap) hd).mpr hsurj, hsurj⟩, he⟩

theorem symmetricRootField_quadratic [IsQuadraticExtension E K] (hf : f.Monic) :
    IsQuadraticExtension (symmetricRootField K f) (AdjoinRoot p) := by
  let : FiniteDimensional E (AdjoinRoot f) := hf.finite_adjoinRoot
  let : FiniteDimensional E (symmetricRootField K f) :=
    (symmetricRootFieldEquiv K f).toLinearEquiv.finiteDimensional
  let : FiniteDimensional K (AdjoinRoot p) := (hf.map (algebraMap E K)).finite_adjoinRoot
  have : FiniteDimensional E (AdjoinRoot p) := Module.Finite.trans K (AdjoinRoot p)
  refine ⟨?_⟩
  have hE := Module.finrank_mul_finrank E K (AdjoinRoot p)
  have hF := Module.finrank_mul_finrank E (symmetricRootField K f) (AdjoinRoot p)
  rw [IsQuadraticExtension.finrank_eq_two E K, upperRootField_finrank K f hf] at hE
  rw [symmetricRootField_finrank K f hf, ← hE, mul_comm 2] at hF
  exact Nat.eq_of_mul_eq_mul_left (Fact.out : Irreducible f).natDegree_pos hF

end RootFields

section Subfield

variable {E : Type u} {K A : Type v}
  [Field E] [Field K] [Algebra E K] [Ring A] [Algebra K A] {f : E[X]} {n : ℕ}

local notation "p" => f.map (algebraMap E K)
local notation "M" => AdjoinRoot (f.map (algebraMap E K))
local notation "F" => symmetricRootField K f

/-- The root algebra evaluates at the specified root in the possibly
noncommutative algebra. -/
def rootAlgebraEvaluation {a : A} (h : aeval a p = 0) : M →ₐ[K] A where
  __ := Ideal.Quotient.lift (Ideal.span ({p} : Set K[X])) (aeval a).toRingHom (by
    intro g hg
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hg
    simp [h])
  commutes' k := by
    change (aeval a) (C k) = algebraMap K A k
    exact aeval_C _ _

@[simp] theorem rootAlgebraEvaluation_mk {a : A} (h : aeval a p = 0) (g : K[X]) :
    rootAlgebraEvaluation h (AdjoinRoot.mk p g) = aeval a g := rfl

@[simp] theorem rootAlgebraEvaluation_root {a : A} (h : aeval a p = 0) :
    rootAlgebraEvaluation h (AdjoinRoot.root p) = a := aeval_X _

variable [Algebra E A]

private theorem symmetric_aeval (σ : AlgebraInvolution E A) {a : A} (ha : σ a = a) (g : E[X]) :
    σ (aeval a g) = aeval a g := by
  have hpow (m : ℕ) : σ (a ^ m) = a ^ m := by
    induction m with
    | zero => rw [pow_zero, σ.apply_one]
    | succ m hm =>
      calc
        σ (a ^ (m + 1)) = a * a ^ m := by rw [pow_succ, σ.apply_mul, ha, hm]
        _ = a ^ (m + 1) := (pow_succ' _ _).symm
  induction g using Polynomial.induction_on' with
  | add f₁ f₂ h₁ h₂ => simp only [map_add, σ.apply_add, h₁, h₂]
  | monomial m e =>
    rw [aeval_monomial, σ.apply_mul, hpow, σ.apply_algebraMap, Algebra.commutes]

variable [IsScalarTower E K A] [Fact (Irreducible f)]
  [Fact (Irreducible (f.map (algebraMap E K)))]

/-- The image of the lower root field consists of symmetric elements when the
generating element is symmetric. -/
theorem rootAlgebraEvaluation_symmetric (σ : AlgebraInvolution E A)
    {a : A} (ha : σ a = a) (h : aeval a p = 0) (z : F) :
    σ (rootAlgebraEvaluation h (z : M)) = rootAlgebraEvaluation h (z : M) := by
  obtain ⟨z₀, hz₀⟩ := (symmetricRootFieldEquiv K f).surjective z
  rw [← hz₀]
  obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective z₀
  change σ (rootAlgebraEvaluation h (rootAlgebraMap K f (AdjoinRoot.mk f g))) =
    rootAlgebraEvaluation h (rootAlgebraMap K f (AdjoinRoot.mk f g))
  rw [rootAlgebraMap_mk, rootAlgebraEvaluation_mk,
    ← aeval_eq_aeval_map (IsScalarTower.algebraMap_eq E K A).symm]
  exact symmetric_aeval σ ha g

variable [NumberField E] [IsTotallyReal E] [NumberField K] [IsTotallyComplex K]
  [IsQuadraticExtension E K] [FiniteDimensional K A] [Algebra.IsCentral K A] [IsSimpleRing A]

omit [IsScalarTower E K A] [NumberField E] in
/-- The reduced norm of a point from the symmetric root field is the
base-field norm followed by the original center inclusion. -/
theorem reducedNorm_symmetricRootField (D : CentralSimpleUnitaryData E K A n)
    (hf : f.Monic) (hdeg : f.natDegree = n) {a : A} (h : aeval a p = 0) (z : F) :
    reducedNorm K A K (1 ⊗ₜ[K] rootAlgebraEvaluation h (z : M)) =
      algebraMap E K (Algebra.norm E z) := by
  let : FiniteDimensional E (AdjoinRoot f) := hf.finite_adjoinRoot
  let : FiniteDimensional E F := (symmetricRootFieldEquiv K f).toLinearEquiv.finiteDimensional
  let : FiniteDimensional K M := (hf.map (algebraMap E K)).finite_adjoinRoot
  have hs : reducedDegree K A = n := by
    change Nat.sqrt (Module.finrank K A) = n
    rw [D.dimension, pow_two, Nat.sqrt_eq]
  have hm : Module.finrank K M = reducedDegree K A := (upperRootField_finrank K f hf).trans (hdeg.trans hs.symm)
  rw [reducedNorm_eq_field_norm K A (rootAlgebraEvaluation h) hm]
  let e := symmetricRootFieldBaseChange K f hf
  rw [← e.property z, Algebra.norm_eq_of_algEquiv e.val]
  exact Langlands.Global.AdelicFunctoriality.norm_baseChange z

end Subfield

section SymmetricPolynomial

variable {E : Type u} {K A : Type v}
  [Field E] [NumberField E] [IsTotallyReal E]
  [Field K] [NumberField K] [IsTotallyComplex K] [Algebra E K] [IsQuadraticExtension E K]
  [Ring A] [Algebra E A] [Algebra K A] [IsScalarTower E K A]
  [FiniteDimensional K A] [Algebra.IsCentral K A] [IsSimpleRing A] {n : ℕ}

theorem symmetricReducedCharpoly_aeval (D : CentralSimpleUnitaryData E K A n) {a : A}
    (ha : D.involution a = a) :
    aeval a ((symmetricReducedCharpoly D ha).val.map (algebraMap E K)) = 0 := by
  rw [(symmetricReducedCharpoly D ha).property]
  exact aeval_reducedCharpoly a

theorem symmetricReducedCharpoly_irreducible (D : CentralSimpleUnitaryData E K A n) {a : A}
    (ha : D.involution a = a) (h : Irreducible (reducedCharpoly K A a)) :
    Irreducible (symmetricReducedCharpoly D ha).val := by
  have : IsLocalHom (Polynomial.mapRingHom (algebraMap E K)) := ⟨fun g hg => by
    change IsUnit (g.map (algebraMap E K)) at hg
    apply Polynomial.isUnit_iff_degree_eq_zero.mpr
    rw [← Polynomial.degree_map_eq_of_injective (algebraMap E K).injective g]
    exact Polynomial.isUnit_iff_degree_eq_zero.mp hg⟩
  apply Irreducible.of_map (f := Polynomial.mapRingHom (algebraMap E K))
  change Irreducible ((symmetricReducedCharpoly D ha).val.map (algebraMap E K))
  rwa [(symmetricReducedCharpoly D ha).property]

end SymmetricPolynomial

end Langlands.Shimura.FiniteUnitary
