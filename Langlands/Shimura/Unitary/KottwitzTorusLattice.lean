import Langlands.Shimura.Unitary.KottwitzPrincipalSeries
import Langlands.Global.AdelicFunctoriality.CompletedRamification

/-! # The torus at a good prime: points of rational cocharacters times integral points -/

noncomputable section

open NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped NumberField TensorProduct Valued WithZero
open WithZero

set_option linter.unusedSectionVars false

universe u v w uL

namespace Langlands.Shimura.KottwitzUnramified

open Langlands.Global.AdelicFunctoriality

variable {E : Type u} {K : Type v} {A : Type w}
variable [Field E] [NumberField E] [IsTotallyReal E]
variable [Field K] [NumberField K] [IsTotallyComplex K]
variable [Algebra E K] [Algebra.IsQuadraticExtension E K]
variable [Ring A] [Algebra K A] [Algebra E A] [IsScalarTower E K A]
variable [Algebra ℚ A] [IsScalarTower ℚ E A] [IsScalarTower ℚ K A]
variable {σ : SecondKindInvolution E K A} {p : HeightOneSpectrum (𝓞 ℚ)} {n : ℕ}

section Valuations

/-- The prime ideal of `p` is generated by the rational prime below it. -/
theorem asIdeal_eq_span_residuePrime :
    p.asIdeal = Ideal.span {((residuePrime p : ℕ) : 𝓞 ℚ)} := by
  have h := congrArg (Ideal.map (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)).symm)
    (Rat.HeightOneSpectrum.span_natGenerator p)
  rw [Ideal.map_span, Set.image_singleton, map_natCast, Ideal.map_symm,
    Ideal.comap_map_of_bijective _ (RingEquiv.bijective _)] at h
  exact h.symm

/-- The prime `p` has valuation `exp(-1)` in `ℚ_p`. -/
theorem valued_residuePrime :
    Valued.v ((residuePrime p : ℕ) : p.adicCompletion ℚ) = exp (-1 : ℤ) := by
  rw [← map_natCast (algebraMap (𝓞 ℚ) (p.adicCompletion ℚ)) (residuePrime p)]
  refine (valuedAdicCompletion_eq_valuation (R := 𝓞 ℚ) (K := ℚ) (v := p) _).trans ?_
  rw [valuation_of_algebraMap]
  exact intValuation_singleton p (by exact_mod_cast residuePrime_ne_zero)
    asIdeal_eq_span_residuePrime

/-- At a place `w ∣ p` with ramification index one, `p` has valuation `exp(-1)` in `K_w`. -/
theorem valued_residuePrime_place (w : FinitePlacesAbove K p)
    (he : w.1.asIdeal.ramificationIdx (𝓞 ℚ) = 1) :
    Valued.v ((residuePrime p : ℕ) : w.1.adicCompletion K) = exp (-1 : ℤ) := by
  rw [← map_natCast (FiniteExtension.completionMap p w.1),
    FiniteExtension.valuation_completionMap, he, pow_one, valued_residuePrime]

theorem valued_primeUnit_zpow (w : FinitePlacesAbove K p)
    (he : w.1.asIdeal.ramificationIdx (𝓞 ℚ) = 1) (z : ℤ) :
    Valued.v ((primeUnit p w ^ z : (w.1.adicCompletion K)ˣ) : w.1.adicCompletion K) =
      exp (-z) := by
  rw [Units.val_zpow_eq_zpow_val, map_zpow₀, primeUnit, Units.val_mk0,
    valued_residuePrime_place w he, ← exp_zsmul, smul_neg, smul_eq_mul, mul_one]

/-- Every nonzero element of an unramified completion is a power of `p` times a unit. -/
theorem exists_valued_eq (w : FinitePlacesAbove K p)
    (he : w.1.asIdeal.ramificationIdx (𝓞 ℚ) = 1) {y : w.1.adicCompletion K} (hy : y ≠ 0) :
    ∃ z : ℤ, Valued.v y = exp (-z) ∧
      Valued.v (y * ((primeUnit p w ^ (-z) : (w.1.adicCompletion K)ˣ) :
        w.1.adicCompletion K)) = 1 := by
  have hv : Valued.v y ≠ 0 := (map_ne_zero _).mpr hy
  refine ⟨-log (Valued.v y), by rw [neg_neg, exp_log hv], ?_⟩
  have key : ∀ a : ℤ, exp a * exp (-a) = (1 : ℤᵐ⁰) := fun a => by
    rw [← exp_add, add_neg_cancel, exp_zero]
  rw [map_mul, valued_primeUnit_zpow w he]
  simp only [neg_neg]
  conv_lhs => arg 1; rw [← exp_log hv]
  exact key _

/-- A ring homomorphism between unramified completions above `p` that carries integers to
integers preserves the valuation. -/
theorem valued_map_of_integral {w w' : FinitePlacesAbove K p}
    (he : w.1.asIdeal.ramificationIdx (𝓞 ℚ) = 1) (he' : w'.1.asIdeal.ramificationIdx (𝓞 ℚ) = 1)
    (f : w'.1.adicCompletion K →+* w.1.adicCompletion K)
    (hf : ∀ x, x ∈ w'.1.adicCompletionIntegers K → f x ∈ w.1.adicCompletionIntegers K)
    (y : w'.1.adicCompletion K) : Valued.v (f y) = Valued.v y := by
  by_cases hy : y = 0
  · simp [hy]
  obtain ⟨z, hz, hu⟩ := exists_valued_eq w' he' hy
  set u := y * ((primeUnit p w' ^ (-z) : (w'.1.adicCompletion K)ˣ) : w'.1.adicCompletion K)
  have hyu : y = u * ((primeUnit p w' ^ z : (w'.1.adicCompletion K)ˣ) :
      w'.1.adicCompletion K) := by
    simp only [u, mul_assoc, ← Units.val_mul, ← zpow_add, neg_add_cancel, zpow_zero,
      Units.val_one, mul_one]
  have hu0 : u ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hu
    exact zero_ne_one hu
  have h1 : Valued.v (f u) ≤ 1 := hf u (le_of_eq hu)
  have h2 : Valued.v (f u⁻¹) ≤ 1 :=
    hf u⁻¹ (show Valued.v u⁻¹ ≤ 1 by rw [map_inv₀, hu, inv_one])
  have h3 : Valued.v (f u) * Valued.v (f u⁻¹) = 1 := by
    rw [← map_mul, ← map_mul, mul_inv_cancel₀ hu0, map_one, map_one]
  have hfu : Valued.v (f u) = 1 :=
    le_antisymm h1 (h3 ▸ mul_le_of_le_one_right' h2)
  rw [hyu, map_mul, map_mul, hfu, one_mul, map_primeUnit, valued_primeUnit_zpow w he,
    map_mul, hu, one_mul, valued_primeUnit_zpow w' he']

end Valuations

section Decomposition

/-- A diagonal unit of the matrix product whose diagonal entries all have valuation one is
integral with integral inverse. -/
theorem diag_unit_mem_units (x : (MatrixProduct K p n)ˣ) (hu : IsUpper K p n x)
    (hl : IsLower K p n x) (hv : ∀ w k, Valued.v ((x : MatrixProduct K p n) w k k) = 1) :
    x ∈ (integralMatrices K p n).toSubmonoid.units := by
  have hd : ∀ w, Matrix.IsDiag ((x : MatrixProduct K p n) w) :=
    (isUpper_and_isLower_iff _).mp ⟨hu, hl⟩
  have hd' : ∀ w, Matrix.IsDiag (((x⁻¹ : (MatrixProduct K p n)ˣ) : MatrixProduct K p n) w) :=
    (isUpper_and_isLower_iff _).mp ⟨IsUpper.inv hu, IsLower.inv hl⟩
  have hprod : ∀ w k, ((x : MatrixProduct K p n) w k k) *
      (((x⁻¹ : (MatrixProduct K p n)ˣ) : MatrixProduct K p n) w k k) = 1 := by
    intro w k
    have h := congrFun x.mul_inv w
    have h' := congrArg (fun M : Matrix (Fin n) (Fin n) (w.1.adicCompletion K) => M k k) h
    simp only [Pi.mul_apply, Pi.one_apply, Matrix.mul_apply, Matrix.one_apply_eq] at h'
    rw [Finset.sum_eq_single k] at h'
    · exact h'
    · intro j _ hj
      rw [hd w (Ne.symm hj), zero_mul]
    · intro hk
      exact absurd (Finset.mem_univ k) hk
  refine ⟨fun w k l => ?_, fun w k l => ?_⟩
  · change ((x : MatrixProduct K p n) w k l) ∈ w.1.adicCompletionIntegers K
    by_cases hkl : k = l
    · subst hkl
      exact (show Valued.v ((x : MatrixProduct K p n) w k k) ≤ 1 from le_of_eq (hv w k))
    · rw [hd w hkl]
      exact zero_mem _
  · change (((x⁻¹ : (MatrixProduct K p n)ˣ) : MatrixProduct K p n) w k l) ∈
      w.1.adicCompletionIntegers K
    by_cases hkl : k = l
    · subst hkl
      have h := congrArg Valued.v (hprod w k)
      rw [map_mul, hv w k, one_mul, map_one] at h
      exact (show Valued.v (((x⁻¹ : (MatrixProduct K p n)ˣ) : MatrixProduct K p n) w k k) ≤ 1
        from le_of_eq h)
    · rw [hd' w hkl]
      exact zero_mem _

variable (c : UnramifiedChart σ p n)

/-- At a good prime every point of the torus is the point `λ(p)` of a rational cocharacter
times a point of the torus in the level `K_p`: `T(ℚ_p) = λ(p) · (T ∩ K_p)`. -/
theorem UnramifiedChart.exists_cocharHom_mul_level (hp : IsUnramifiedAt p K) (t : c.torus) :
    ∃ (m : localCocharacters E K p n) (u : c.torus),
      (u : LocalPoints σ p) ∈ c.level ∧ t = c.cocharHom (Multiplicative.ofAdd m) * u := by
  classical
  set M : (MatrixProduct K p n)ˣ := pointUnit c.charts t.1 with hM
  have hdiag : ∀ w, Matrix.IsDiag ((M : MatrixProduct K p n) w) := (c.mem_torus_iff t.1).mp t.2
  -- nonzero diagonal entries
  have hne : ∀ w k, ((M : MatrixProduct K p n) w k k) ≠ 0 := by
    intro w k h0
    have h := congrFun M.mul_inv w
    have h' := congrArg (fun N : Matrix (Fin n) (Fin n) (w.1.adicCompletion K) => N k k) h
    simp only [Pi.mul_apply, Pi.one_apply, Matrix.mul_apply, Matrix.one_apply_eq] at h'
    rw [Finset.sum_eq_single k, h0, zero_mul] at h'
    · exact zero_ne_one h'
    · intro j _ hj
      rw [hdiag w (Ne.symm hj), zero_mul]
    · intro hk
      exact absurd (Finset.mem_univ k) hk
  set s : (p.adicCompletion ℚ)ˣ := t.1.1.2
  have hs : (s : p.adicCompletion ℚ) ≠ 0 := s.ne_zero
  let z : FinitePlacesAbove K p → Fin n → ℤ :=
    fun w k => -log (Valued.v ((M : MatrixProduct K p n) w k k))
  let zc : ℤ := -log (Valued.v (s : p.adicCompletion ℚ))
  have hz : ∀ w k, Valued.v ((M : MatrixProduct K p n) w k k) = exp (-z w k) := by
    intro w k
    simp only [z, neg_neg]
    exact (exp_log ((map_ne_zero _).mpr (hne w k))).symm
  have hzc : Valued.v (s : p.adicCompletion ℚ) = exp (-zc) := by
    simp only [zc, neg_neg]
    exact (exp_log ((map_ne_zero _).mpr hs)).symm
  -- the similitude equation on diagonal entries
  have hsim : ∀ w k, ((M : MatrixProduct K p n) w k k) *
      c.conj w ((M : MatrixProduct K p n) (placeConj (E := E) p w) (Fin.rev k) (Fin.rev k)) =
      FiniteExtension.completionMap p w.1 (s : p.adicCompletion ℚ) := by
    intro w k
    have h := congrFun (pointUnit_similitude (σ := σ) c.charts t.1) w
    have h' := congrArg (fun N : Matrix (Fin n) (Fin n) (w.1.adicCompletion K) => N k k) h
    simp only [Pi.mul_apply, Matrix.mul_apply] at h'
    rw [Finset.sum_eq_single k, c.transportedInvolution_apply, chartEquiv_algebraMap,
      Matrix.algebraMap_matrix_apply] at h'
    simp only [↓reduceIte] at h'
    · exact h'
    · intro j _ hj
      rw [hdiag w (Ne.symm hj), zero_mul]
    · intro hk
      exact absurd (Finset.mem_univ k) hk
  have hcompat : ∀ w k, z w k + z (placeConj (E := E) p w) (Fin.rev k) = zc := by
    intro w k
    have h := congrArg Valued.v (hsim w k)
    rw [map_mul, valued_map_of_integral (hp w) (hp _) (c.conj w) (c.conj_integer w), hz, hz,
      FiniteExtension.valuation_completionMap, hp w, pow_one, hzc, ← exp_add] at h
    have := exp_injective h
    omega
  let m : localCocharacters E K p n := ⟨(z, zc), hcompat⟩
  refine ⟨m, (c.cocharHom (Multiplicative.ofAdd m))⁻¹ * t, ?_, by group⟩
  have hpu : (pointUnit c.charts ((c.cocharHom (Multiplicative.ofAdd m))⁻¹ * t).1 :
      MatrixProduct K p n) = fun w => (Matrix.diagonal fun k =>
        ((primeUnit p w ^ (-z w k) : (w.1.adicCompletion K)ˣ) : w.1.adicCompletion K)) *
          (M : MatrixProduct K p n) w := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv, Units.val_mul,
      show c.cocharHom (Multiplicative.ofAdd m) = c.cocharPoint m from rfl,
      c.pointUnit_cocharPoint]
    rfl
  have hu := ((c.cocharHom (Multiplicative.ofAdd m))⁻¹ * t).2
  refine diag_unit_mem_units _ hu.1 hu.2 (fun w k => ?_)
  rw [hpu]
  simp only [Matrix.diagonal_mul]
  rw [map_mul, valued_primeUnit_zpow w (hp w), hz, neg_neg, ← exp_add, add_neg_cancel,
    exp_zero]

/-- The values of a character of the torus at the points `λ(p)`, as a character of the
lattice of rational cocharacters. -/
def UnramifiedChart.latticeCharacter {M : Type*} [Monoid M] (ξ : c.torus →* Mˣ) :
    Multiplicative (localCocharacters E K p n) →* Mˣ :=
  ξ.comp c.cocharHom

/-- At a good prime an unramified character of the torus is determined by its values at the
points `λ(p)` of the rational cocharacters. -/
theorem UnramifiedChart.unramifiedCharacter_ext (hp : IsUnramifiedAt p K) {M : Type*}
    [Monoid M] {ξ ξ' : c.torus →* Mˣ} (hξ : c.IsUnramifiedCharacter ξ)
    (hξ' : c.IsUnramifiedCharacter ξ')
    (h : ∀ m : localCocharacters E K p n,
      ξ (c.cocharHom (Multiplicative.ofAdd m)) = ξ' (c.cocharHom (Multiplicative.ofAdd m))) :
    ξ = ξ' := by
  ext1 t
  obtain ⟨m, u, hu, rfl⟩ := c.exists_cocharHom_mul_level hp t
  rw [map_mul, map_mul, hξ u hu, hξ' u hu, h m]

/-- At a good prime the restriction to the cocharacter lattice is injective on unramified
characters. -/
theorem UnramifiedChart.latticeCharacter_injective (hp : IsUnramifiedAt p K) {M : Type*}
    [Monoid M] {ξ ξ' : c.torus →* Mˣ} (hξ : c.IsUnramifiedCharacter ξ)
    (hξ' : c.IsUnramifiedCharacter ξ') (h : c.latticeCharacter ξ = c.latticeCharacter ξ') :
    ξ = ξ' :=
  c.unramifiedCharacter_ext hp hξ hξ' fun m => DFunLike.congr_fun h (Multiplicative.ofAdd m)

end Decomposition

end Langlands.Shimura.KottwitzUnramified
