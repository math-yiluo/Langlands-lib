import Langlands.AlgebraicGeometry.EtaleEquivalenceRelationRingFormStatement
import Langlands.AlgebraicGeometry.FiniteEtale.AffineQuotientCoconeProof
import Mathlib.AlgebraicGeometry.Morphisms.Separated

/-! # Ring form of an affine étale equivalence relation

Affine duality translates the pointwise equivalence relation laws. The closed immersion
condition forces the subalgebra generated by the target map to be the full relation ring.
-/

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace Langlands.AlgebraicGeometry

private theorem ringForm_adjoin_eq_top {U R : Scheme.{u}} [IsAffine U] [IsAffine R]
    (t s : R ⟶ U) [IsClosedImmersion (prod.lift t s)] :
    letI : Algebra Γ(U, ⊤) Γ(R, ⊤) := s.appTop.hom.toAlgebra
    Algebra.adjoin Γ(U, ⊤) (Set.range t.appTop.hom) = ⊤ := by
  let : Algebra Γ(U, ⊤) Γ(R, ⊤) := s.appTop.hom.toAlgebra
  let D := Algebra.adjoin Γ(U, ⊤) (Set.range t.appTop.hom)
  let ti : Γ(U, ⊤) →+* D :=
    t.appTop.hom.codRestrict D.toSubring (fun b => Algebra.subset_adjoin ⟨b, rfl⟩)
  let si : Γ(U, ⊤) →+* D := algebraMap Γ(U, ⊤) D
  let i : CommRingCat.of D ⟶ Γ(R, ⊤) := CommRingCat.ofHom D.val.toRingHom
  let p : Spec Γ(R, ⊤) ⟶ Spec (CommRingCat.of D) := Spec.map i
  let q : Spec (CommRingCat.of D) ⟶ U ⨯ U :=
    prod.lift (Spec.map (CommRingCat.ofHom ti) ≫ U.isoSpec.inv)
      (Spec.map (CommRingCat.ofHom si) ≫ U.isoSpec.inv)
  have hit : CommRingCat.ofHom ti ≫ i = t.appTop := rfl
  have his : CommRingCat.ofHom si ≫ i = s.appTop := rfl
  have hfactor : R.isoSpec.hom ≫ p ≫ q = prod.lift t s := by
    apply prod.hom_ext
    · simp only [q, Category.assoc, prod.lift_fst]
      change R.isoSpec.hom ≫ Spec.map i ≫
        Spec.map (CommRingCat.ofHom ti) ≫ U.isoSpec.inv = t
      rw [← Spec.map_comp_assoc, hit, Scheme.isoSpec_hom_naturality_assoc]
      simp
    · simp only [q, Category.assoc, prod.lift_snd]
      change R.isoSpec.hom ≫ Spec.map i ≫
        Spec.map (CommRingCat.ofHom si) ≫ U.isoSpec.inv = s
      rw [← Spec.map_comp_assoc, his, Scheme.isoSpec_hom_naturality_assoc]
      simp
  have : IsClosedImmersion ((R.isoSpec.hom ≫ p) ≫ q) := by
    rw [Category.assoc, hfactor]
    infer_instance
  have : IsClosedImmersion (R.isoSpec.hom ≫ p) :=
    IsClosedImmersion.of_comp _ q
  have : IsClosedImmersion p := by
    have : IsClosedImmersion (R.isoSpec.inv ≫ (R.isoSpec.hom ≫ p)) := inferInstance
    simpa using this
  have hsurj := (IsClosedImmersion.isAffine_surjective_of_isAffine p).2
  have hi : Function.Surjective i := by
    have heq : i = (Scheme.ΓSpecIso (CommRingCat.of D)).inv ≫ p.appTop ≫
        (Scheme.ΓSpecIso Γ(R, ⊤)).hom := by
      simp [p]
    rw [heq]
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso Γ(R, ⊤)).hom).2.comp
      (hsurj.comp
        (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of D)).inv).2)
  apply top_unique
  intro c _
  obtain ⟨d, hd⟩ := hi c
  exact hd ▸ d.property

/-- The rings of global sections of an affine étale equivalence relation form the
published ring-level equivalence relation whenever its relation map is a closed immersion. -/
theorem etaleEquivalenceRelationRingForm :
    EtaleEquivalenceRelationRingFormStatement.{u} := by
  intro E hU hR hj
  let : IsAffine E.U := hU
  let : IsAffine E.R := hR
  let : IsClosedImmersion (prod.lift E.t E.s) := hj
  let : Algebra Γ(E.U, ⊤) Γ(E.R, ⊤) := E.s.appTop.hom.toAlgebra
  refine
    { adjoin_range_eq_top := ringForm_adjoin_eq_top E.t E.s
      refl := ?_
      symm := ?_
      trans := ?_
      etale_algebraMap := ?_
      etale_t := ?_ }
  · intro T _ a
    let K := CommRingCat.of T
    obtain ⟨r, ht, hs⟩ :=
      E.refl (Spec K) ((FiniteEtale.affinePointEquiv E.U K).symm (CommRingCat.ofHom a))
    refine ⟨(FiniteEtale.affinePointEquiv E.R K r).hom, ?_, ?_⟩
    · change (E.t.appTop ≫ FiniteEtale.affinePointEquiv E.R K r).hom = a
      rw [← FiniteEtale.affinePointEquiv_comp, ht, Equiv.apply_symm_apply]
      rfl
    · change (E.s.appTop ≫ FiniteEtale.affinePointEquiv E.R K r).hom = a
      rw [← FiniteEtale.affinePointEquiv_comp, hs, Equiv.apply_symm_apply]
      rfl
  · intro T _ φ
    let K := CommRingCat.of T
    let r := (FiniteEtale.affinePointEquiv E.R K).symm (CommRingCat.ofHom φ)
    have hr : FiniteEtale.affinePointEquiv E.R K r = CommRingCat.ofHom φ :=
      Equiv.apply_symm_apply _ _
    obtain ⟨r', ht, hs⟩ := E.symm (Spec K) r
    refine ⟨(FiniteEtale.affinePointEquiv E.R K r').hom, ?_, ?_⟩
    · change (E.t.appTop ≫ FiniteEtale.affinePointEquiv E.R K r').hom =
        φ.comp E.s.appTop.hom
      rw [← FiniteEtale.affinePointEquiv_comp, ht, FiniteEtale.affinePointEquiv_comp, hr]
      rfl
    · change (E.s.appTop ≫ FiniteEtale.affinePointEquiv E.R K r').hom =
        φ.comp E.t.appTop.hom
      rw [← FiniteEtale.affinePointEquiv_comp, hs, FiniteEtale.affinePointEquiv_comp, hr]
      rfl
  · intro T _ φ ψ h
    let K := CommRingCat.of T
    let r := (FiniteEtale.affinePointEquiv E.R K).symm (CommRingCat.ofHom φ)
    let r' := (FiniteEtale.affinePointEquiv E.R K).symm (CommRingCat.ofHom ψ)
    have hr : FiniteEtale.affinePointEquiv E.R K r = CommRingCat.ofHom φ :=
      Equiv.apply_symm_apply _ _
    have hr' : FiniteEtale.affinePointEquiv E.R K r' = CommRingCat.ofHom ψ :=
      Equiv.apply_symm_apply _ _
    have hcomp : r ≫ E.s = r' ≫ E.t := by
      apply (FiniteEtale.affinePointEquiv E.U K).injective
      rw [FiniteEtale.affinePointEquiv_comp, FiniteEtale.affinePointEquiv_comp, hr, hr']
      exact congrArg CommRingCat.ofHom h
    obtain ⟨r'', ht, hs⟩ := E.trans (Spec K) r r' hcomp
    refine ⟨(FiniteEtale.affinePointEquiv E.R K r'').hom, ?_, ?_⟩
    · change (E.t.appTop ≫ FiniteEtale.affinePointEquiv E.R K r'').hom =
        φ.comp E.t.appTop.hom
      rw [← FiniteEtale.affinePointEquiv_comp, ht, FiniteEtale.affinePointEquiv_comp, hr]
      rfl
    · change (E.s.appTop ≫ FiniteEtale.affinePointEquiv E.R K r'').hom =
        ψ.comp E.s.appTop.hom
      rw [← FiniteEtale.affinePointEquiv_comp, hs, FiniteEtale.affinePointEquiv_comp, hr']
      rfl
  · exact (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp E.etale_s
  · exact (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp E.etale_t

end Langlands.AlgebraicGeometry
