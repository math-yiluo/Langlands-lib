import Langlands.AlgebraicGeometry.Descent.FppfClosedLocusDescentStatement
import Langlands.AlgebraicGeometry.ClosedLocusFromAffineChartsProof
import Mathlib.AlgebraicGeometry.Cover.QuasiCompact
import Mathlib.AlgebraicGeometry.Morphisms.Flat
import Mathlib.RingTheory.TensorProduct.Pi
import Mathlib.RingTheory.TensorProduct.Quotient

/-! # Proof of fppf descent of closed loci

Over an affine base, the closed subscheme is cut out by the intersection of the preimages of
the local ideals; flatness shows that this ideal recovers each local ideal. The general case
glues the affine case with `closedLocusFromAffineCharts`.
-/

universe u

open CategoryTheory AlgebraicGeometry TensorProduct

namespace Langlands.AlgebraicGeometry.FppfClosedLocusDescent

section Algebra

variable (A : Type*) [CommRing A] {ι : Type*}
  (B : ι → Type*) [∀ l, CommRing (B l)] [∀ l, Algebra A (B l)] (I : ∀ l, Ideal (B l))

lemma algebraMap_quotient_eq_zero_iff (l : ι) (a : A) :
    algebraMap A (B l ⧸ I l) a = 0 ↔ a ∈ (I l).comap (algebraMap A (B l)) := by
  rw [IsScalarTower.algebraMap_apply A (B l) (B l ⧸ I l), Ideal.Quotient.algebraMap_eq,
    Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_comap]

/-- The canonical map `A ⧸ J ⟶ ∏ₗ Bₗ ⧸ Iₗ`, where `J` is the intersection of the
preimages of the ideals `Iₗ`. -/
noncomputable def quotientToPi :
    A ⧸ (⨅ l, (I l).comap (algebraMap A (B l))) →ₐ[A] ∀ l, B l ⧸ I l :=
  Ideal.Quotient.liftₐ _ (AlgHom.pi fun l ↦ Algebra.ofId A (B l ⧸ I l)) (by
    intro a ha
    funext l
    simp only [AlgHom.pi_apply, Algebra.ofId_apply, Pi.zero_apply]
    exact (algebraMap_quotient_eq_zero_iff A B I l a).mpr ((Ideal.mem_iInf.mp ha) l))

lemma quotientToPi_mk (a : A) (l : ι) :
    quotientToPi A B I (Ideal.Quotient.mk _ a) l = algebraMap A (B l ⧸ I l) a :=
  rfl

lemma quotientToPi_injective : Function.Injective (quotientToPi A B I) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_iInf]
  intro l
  have := congr_fun hx l
  rw [quotientToPi_mk, Pi.zero_apply] at this
  exact (algebraMap_quotient_eq_zero_iff A B I l a).mp this

/-- Flat descent of ideals along a finite family: if `Bᵢ` is flat over `A` and the image of
`Iᵢ` vanishes in every `Bᵢ ⊗[A] (Bₗ ⧸ Iₗ)`, then `Iᵢ` is generated by the intersection
`J` of the preimages of all `Iₗ`. -/
theorem le_map_iInf_comap [Fintype ι] [DecidableEq ι] (i : ι) [Module.Flat A (B i)]
    (h : ∀ l, ∀ b ∈ I i, (b ⊗ₜ[A] (1 : B l ⧸ I l)) = 0) :
    I i ≤ (⨅ l, (I l).comap (algebraMap A (B l))).map (algebraMap A (B i)) := by
  set J := ⨅ l, (I l).comap (algebraMap A (B l))
  intro b hb
  let e := Algebra.TensorProduct.piRight A A (B i) (fun l ↦ B l ⧸ I l)
  have hinj : Function.Injective
      (e.toLinearMap ∘ₗ (quotientToPi A B I).toLinearMap.lTensor (B i)) :=
    e.injective.comp
      (Module.Flat.lTensor_preserves_injective_linearMap _ (quotientToPi_injective A B I))
  have h1 : b ⊗ₜ[A] (1 : A ⧸ J) = 0 := by
    apply hinj
    rw [map_zero]
    funext l
    simp only [e, LinearMap.coe_comp, Function.comp_apply, LinearMap.lTensor_tmul,
      AlgHom.toLinearMap_apply, map_one, AlgEquiv.toLinearMap_apply, Pi.zero_apply,
      Algebra.TensorProduct.piRight_tmul, Pi.one_apply]
    exact h l b hb
  have h2 : Algebra.TensorProduct.quotIdealMapEquivTensorQuot (B i) J
      (Ideal.Quotient.mk _ b) = 0 := by
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    exact h1
  rw [map_eq_zero_iff _ (AlgEquiv.injective _), Ideal.Quotient.eq_zero_iff_mem] at h2
  exact h2

end Algebra

section Schemes

/-- A morphism factors through a closed immersion exactly when its kernel contains the kernel
of the closed immersion. -/
lemma factors_iff_ker_le {Z X T : Scheme.{u}} (ι : Z ⟶ X) [IsClosedImmersion ι] (g : T ⟶ X) :
    (∃ k : T ⟶ Z, k ≫ ι = g) ↔ ι.ker ≤ g.ker := by
  refine ⟨?_, fun H ↦ ⟨IsClosedImmersion.lift ι g H, IsClosedImmersion.lift_fac ι g H⟩⟩
  rintro ⟨k, rfl⟩
  exact k.le_ker_comp ι

/-- Over an affine target, factoring through a closed immersion is detected on the kernels of
the maps on global sections. -/
lemma factors_iff_ker_appTop_le {Z X T : Scheme.{u}} [IsAffine X] (ι : Z ⟶ X)
    [IsClosedImmersion ι] (g : T ⟶ X) :
    (∃ k : T ⟶ Z, k ≫ ι = g) ↔ RingHom.ker ι.appTop.hom ≤ RingHom.ker g.appTop.hom := by
  rw [factors_iff_ker_le, Scheme.ker_of_isAffine, Scheme.ker_of_isAffine]
  exact map_le_map_iff (Scheme.IdealSheafData.equivOfIsAffine (X := X)).symm

lemma ker_appTop_le_ker_comp_appTop {T' T X : Scheme.{u}} (h : T' ⟶ T) (g : T ⟶ X) :
    RingHom.ker g.appTop.hom ≤ RingHom.ker (h ≫ g).appTop.hom := by
  rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, ← RingHom.comap_ker]
  exact Ideal.ker_le_comap _

/-- The map on global sections of the morphism `Spec R ⟶ X` attached to a ring map
`Γ(X, ⊤) ⟶ R`, for `X` affine. -/
lemma appTop_specMap_comp_isoSpec_inv {X : Scheme.{u}} [IsAffine X] {R : CommRingCat.{u}}
    (ψ : Γ(X, ⊤) ⟶ R) :
    (Spec.map ψ ≫ X.isoSpec.inv).appTop = ψ ≫ (Scheme.ΓSpecIso R).inv := by
  have h : X.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(X, ⊤)).inv := by
    rw [← cancel_epi (Scheme.ΓSpecIso Γ(X, ⊤)).hom, Iso.hom_inv_id,
      ← Scheme.toSpecΓ_appTop, ← Scheme.Hom.comp_appTop]
    simp
  rw [Scheme.Hom.comp_appTop, h, Scheme.ΓSpecIso_inv_naturality]

lemma ker_appTop_specMap_comp_isoSpec_inv {X : Scheme.{u}} [IsAffine X] {R : CommRingCat.{u}}
    (ψ : Γ(X, ⊤) ⟶ R) :
    RingHom.ker (Spec.map ψ ≫ X.isoSpec.inv).appTop.hom = RingHom.ker ψ.hom := by
  rw [appTop_specMap_comp_isoSpec_inv, CommRingCat.hom_comp]
  exact RingHom.ker_comp_of_injective _
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).inv).1

/-- A morphism `g : T ⟶ Y` factors through a monomorphism `ι` as soon as `u ≫ g` factors
through `ι` for every `u` in a covering sieve of a subcanonical topology. -/
lemma exists_lift_of_covering {C : Type*} [Category C] (J : GrothendieckTopology C)
    [J.Subcanonical] {Z Y T : C} (ι : Z ⟶ Y) [Mono ι] (g : T ⟶ Y) (S : Sieve T) (hS : S ∈ J T)
    (h : ∀ ⦃T' : C⦄ (u : T' ⟶ T), S u → ∃ k : T' ⟶ Z, k ≫ ι = u ≫ g) :
    ∃ k : T ⟶ Z, k ≫ ι = g := by
  choose k hk using h
  have hZ := GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (J := J)
    (yoneda.obj Z) S hS
  have hY := GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (J := J)
    (yoneda.obj Y) S hS
  let x : Presieve.FamilyOfElements (yoneda.obj Z) S.arrows := fun _ u hu ↦ k u hu
  have hx : x.Compatible := by
    intro T₁ T₂ T₃ a₁ a₂ u₁ u₂ hu₁ hu₂ e
    change a₁ ≫ k u₁ hu₁ = a₂ ≫ k u₂ hu₂
    rw [← cancel_mono ι, Category.assoc, Category.assoc, hk, hk, ← Category.assoc,
      ← Category.assoc, e]
  refine ⟨hZ.amalgamate x hx, hY.isSeparatedFor.ext fun T' u hu ↦ ?_⟩
  have h' : u ≫ hZ.amalgamate x hx = k u hu := hZ.valid_glue hx u hu
  change u ≫ (hZ.amalgamate x hx ≫ ι) = u ≫ g
  rw [← Category.assoc, h', hk]

/-- A member of the pullback of the sieve generated by a family `f` factors through some `f l`. -/
lemma exists_of_pullback_generate_ofArrows {C : Type*} [Category C] {X T T' : C} {κ : Type*}
    {W : κ → C} {f : ∀ l, W l ⟶ X} (g : T ⟶ X) (u : T' ⟶ T)
    (hu : Sieve.pullback g (Sieve.generate (Presieve.ofArrows W f)) u) :
    ∃ (l : κ) (m : T' ⟶ W l), m ≫ f l = u ≫ g := by
  obtain ⟨_, m, _, ⟨l⟩, hm⟩ := hu
  exact ⟨l, m, hm⟩

/-- Over an affine scheme, every ideal of global sections is the kernel of the map on global
sections of a closed immersion. -/
lemma exists_isClosedImmersion_ker_appTop {X : Scheme.{u}} [IsAffine X] (J : Ideal Γ(X, ⊤)) :
    ∃ (Z : Scheme.{u}) (ι : Z ⟶ X), IsClosedImmersion ι ∧ RingHom.ker ι.appTop.hom = J :=
  ⟨Spec (CommRingCat.of (Γ(X, ⊤) ⧸ J)),
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ X.isoSpec.inv, inferInstance, by
      rw [ker_appTop_specMap_comp_isoSpec_inv]
      exact Ideal.mk_ker⟩

/-- The descent condition. Let `W₁ ⟶ Y` and `W₂ ⟶ Y` be morphisms of affine schemes, and let
`Zₖ ⟶ Wₖ` be closed immersions cutting out the pullbacks of a sieve `E` on `Y`. Then the ideal
`I₁` of `Z₁` vanishes in `Γ(W₁) ⊗ Γ(W₂) ⧸ I₂`, the ring of `W₁ ×_Y Z₂`. -/
lemma tmul_one_eq_zero_of_mem_ker {Y W₁ W₂ Z₁ Z₂ : Scheme.{u}} [IsAffine W₁] [IsAffine W₂]
    (E : Sieve Y) (f₁ : W₁ ⟶ Y) (f₂ : W₂ ⟶ Y) (ι₁ : Z₁ ⟶ W₁) (ι₂ : Z₂ ⟶ W₂)
    [IsClosedImmersion ι₁] [IsClosedImmersion ι₂]
    (h₁ : ∀ ⦃T : Scheme.{u}⦄ (g : T ⟶ W₁), (∃ k : T ⟶ Z₁, k ≫ ι₁ = g) ↔ E (g ≫ f₁))
    (h₂ : ∀ ⦃T : Scheme.{u}⦄ (g : T ⟶ W₂), (∃ k : T ⟶ Z₂, k ≫ ι₂ = g) ↔ E (g ≫ f₂))
    [IsAffine Y] [Algebra Γ(Y, ⊤) Γ(W₁, ⊤)] [Algebra Γ(Y, ⊤) Γ(W₂, ⊤)]
    (e₁ : algebraMap Γ(Y, ⊤) Γ(W₁, ⊤) = f₁.appTop.hom)
    (e₂ : algebraMap Γ(Y, ⊤) Γ(W₂, ⊤) = f₂.appTop.hom)
    (b : Γ(W₁, ⊤)) (hb : b ∈ RingHom.ker ι₁.appTop.hom) :
    b ⊗ₜ[Γ(Y, ⊤)] (1 : Γ(W₂, ⊤) ⧸ RingHom.ker ι₂.appTop.hom) = 0 := by
  let P := Γ(W₁, ⊤) ⊗[Γ(Y, ⊤)] (Γ(W₂, ⊤) ⧸ RingHom.ker ι₂.appTop.hom)
  let φ₁ : Γ(W₁, ⊤) →ₐ[Γ(Y, ⊤)] P := Algebra.TensorProduct.includeLeft
  let φ₂ : Γ(W₂, ⊤) →ₐ[Γ(Y, ⊤)] P :=
    Algebra.TensorProduct.includeRight.comp (Ideal.Quotient.mkₐ _ _)
  let p₁ : Spec (CommRingCat.of P) ⟶ W₁ :=
    Spec.map (CommRingCat.ofHom φ₁.toRingHom) ≫ W₁.isoSpec.inv
  let p₂ : Spec (CommRingCat.of P) ⟶ W₂ :=
    Spec.map (CommRingCat.ofHom φ₂.toRingHom) ≫ W₂.isoSpec.inv
  have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
    have hp₁ : p₁.appTop = _ := appTop_specMap_comp_isoSpec_inv _
    have hp₂ : p₂.appTop = _ := appTop_specMap_comp_isoSpec_inv _
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop p₁ f₁, Scheme.Hom.comp_appTop p₂ f₂, hp₁, hp₂, ← Category.assoc,
      ← Category.assoc]
    congr 1
    ext a
    change φ₁ (f₁.appTop.hom a) = φ₂ (f₂.appTop.hom a)
    rw [← e₁, ← e₂, AlgHom.commutes, AlgHom.commutes]
  have hp₂ : ∃ k : Spec (CommRingCat.of P) ⟶ Z₂, k ≫ ι₂ = p₂ := by
    rw [factors_iff_ker_appTop_le, ker_appTop_specMap_comp_isoSpec_inv]
    intro x hx
    rw [RingHom.mem_ker]
    change Algebra.TensorProduct.includeRight (Ideal.Quotient.mk _ x) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
  have hE : E (p₁ ≫ f₁) := hcomm ▸ (h₂ p₂).mp hp₂
  have hp₁ := (h₁ p₁).mpr hE
  rw [factors_iff_ker_appTop_le, ker_appTop_specMap_comp_isoSpec_inv] at hp₁
  exact hp₁ hb

/-- The affine case for a finite jointly surjective family of flat morphisms locally of finite
presentation from affine schemes. -/
theorem affine_core {Y : Scheme.{u}} [IsAffine Y] (E : Sieve Y)
    (hE : Scheme.fppfTopology.IsClosed E) {κ : Type*} [Fintype κ] [DecidableEq κ]
    (W : κ → Scheme.{u}) [∀ l, IsAffine (W l)] (f : ∀ l, W l ⟶ Y)
    (hflat : ∀ l, Flat (f l)) (hlfp : ∀ l, LocallyOfFinitePresentation (f l))
    (hsurj : ∀ x, ∃ l, x ∈ Set.range (f l))
    (h : ∀ l, ∃ (Z : Scheme.{u}) (ι : Z ⟶ W l), IsClosedImmersion ι ∧
      ∀ ⦃T : Scheme.{u}⦄ (g : T ⟶ W l), (∃ k : T ⟶ Z, k ≫ ι = g) ↔ E (g ≫ f l)) :
    ∃ (Z : Scheme.{u}) (ι : Z ⟶ Y), IsClosedImmersion ι ∧
      ∀ ⦃T : Scheme.{u}⦄ (g : T ⟶ Y), (∃ k : T ⟶ Z, k ≫ ι = g) ↔ E g := by
  choose Z ιZ hιZ hfac using h
  let _ : ∀ l, Algebra Γ(Y, ⊤) Γ(W l, ⊤) := fun l ↦ (f l).appTop.hom.toAlgebra
  have hflat' (l : κ) : Module.Flat Γ(Y, ⊤) Γ(W l, ⊤) := by
    have := hflat l
    exact (f l).flat_appTop
  let I : ∀ l, Ideal Γ(W l, ⊤) := fun l ↦ RingHom.ker (ιZ l).appTop.hom
  obtain ⟨Z₀, ι₀, hι₀, hker⟩ :=
    exists_isClosedImmersion_ker_appTop (⨅ l, (I l).comap (algebraMap Γ(Y, ⊤) Γ(W l, ⊤)))
  have hS : Sieve.generate (Presieve.ofArrows W f) ∈ Scheme.fppfTopology Y := by
    apply Precoverage.generate_mem_toGrothendieck
    rw [Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
    exact ⟨hsurj, fun l ↦ ⟨hflat l, hlfp l⟩⟩
  refine ⟨Z₀, ι₀, hι₀, fun T g ↦ ⟨fun hk ↦ ?_, fun hg ↦ ?_⟩⟩
  · have hg := (factors_iff_ker_appTop_le ι₀ g).mp hk
    rw [hker] at hg
    refine hE g (Scheme.fppfTopology.superset_covering ?_
      (Scheme.fppfTopology.pullback_stable g hS))
    intro T' u hu
    obtain ⟨l, m, hm⟩ := exists_of_pullback_generate_ofArrows g u hu
    change E (u ≫ g)
    rw [← hm]
    refine (hfac l m).mp ((factors_iff_ker_appTop_le (ιZ l) m).mpr ?_)
    refine (le_map_iInf_comap Γ(Y, ⊤) (fun l ↦ Γ(W l, ⊤)) I l fun l' b hb ↦
      tmul_one_eq_zero_of_mem_ker E (f l) (f l') (ιZ l) (ιZ l') (hfac l) (hfac l') rfl rfl b
        hb).trans ?_
    rw [Ideal.map_le_iff_le_comap]
    have h1 := hg.trans (ker_appTop_le_ker_comp_appTop u g)
    rw [← hm, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, ← RingHom.comap_ker] at h1
    exact h1
  · have := hι₀
    refine exists_lift_of_covering Scheme.fppfTopology ι₀ g _
      (Scheme.fppfTopology.pullback_stable g hS) ?_
    intro T' u hu
    obtain ⟨l, m, hm⟩ := exists_of_pullback_generate_ofArrows g u hu
    have hEm : E (m ≫ f l) := hm ▸ E.downward_closed hg u
    have hk := (factors_iff_ker_appTop_le (ιZ l) m).mp ((hfac l m).mpr hEm)
    rw [factors_iff_ker_appTop_le, hker, ← hm, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
      ← RingHom.comap_ker]
    exact (iInf_le _ l).trans (Ideal.comap_mono hk)

set_option backward.isDefEq.respectTransparency.types false in
/-- The affine case: over an affine scheme, an fppf covering sieve can be refined by a finite
family of affine schemes. -/
theorem affine_case {Y : Scheme.{u}} [IsAffine Y] (E : Sieve Y)
    (hE : Scheme.fppfTopology.IsClosed E) (R : Sieve Y) (hR : R ∈ Scheme.fppfTopology Y)
    (h : ∀ ⦃Y' : Scheme.{u}⦄ (f : Y' ⟶ Y), R f →
      ∃ (Z : Scheme.{u}) (ι : Z ⟶ Y'), IsClosedImmersion ι ∧
        ∀ ⦃T : Scheme.{u}⦄ (g : T ⟶ Y'), (∃ k : T ⟶ Z, k ≫ ι = g) ↔ E (g ≫ f)) :
    ∃ (Z : Scheme.{u}) (ι : Z ⟶ Y), IsClosedImmersion ι ∧
      ∀ ⦃T : Scheme.{u}⦄ (g : T ⟶ Y), (∃ k : T ⟶ Z, k ≫ ι = g) ↔ E g := by
  have : (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u}).IsMultiplicative :=
    { id_mem := fun _ ↦ ⟨inferInstance, inferInstance⟩
      comp_mem := fun f g hf hg ↦ by
        have := hf.1
        have := hf.2
        have := hg.1
        have := hg.2
        exact ⟨inferInstance, inferInstance⟩ }
  obtain ⟨𝒰, hle⟩ := (Scheme.mem_grothendieckTopology_iff
    (P := (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u}))).mp hR
  have hprop (i : 𝒰.I₀) : Flat (𝒰.f i) ∧ LocallyOfFinitePresentation (𝒰.f i) :=
    𝒰.map_prop i
  have : QuasiCompactCover 𝒰.toPreZeroHypercover := .of_isOpenMap fun i ↦ by
    have := (hprop i).1
    have := (hprop i).2
    exact (𝒰.f i).isOpenMap
  obtain ⟨n, a, V, hV, hcov⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact
    𝒰.toPreZeroHypercover (U := ⊤)
    (show IsCompact (⊤ : TopologicalSpace.Opens Y).carrier from isCompact_univ)
  have (i : Fin n) : IsAffine (V i) := hV i
  have hflat (i : Fin n) : Flat ((V i).ι ≫ 𝒰.f (a i)) := by
    have := (hprop (a i)).1
    infer_instance
  have hlfp (i : Fin n) : LocallyOfFinitePresentation ((V i).ι ≫ 𝒰.f (a i)) := by
    have := (hprop (a i)).2
    infer_instance
  refine affine_core E hE (fun i ↦ (V i).toScheme) (fun i ↦ (V i).ι ≫ 𝒰.f (a i)) hflat hlfp
    (fun x ↦ ?_) (fun i ↦ h _ (R.downward_closed (hle _ _ (Presieve.ofArrows.mk (a i))) _))
  have hx : x ∈ ⋃ i, 𝒰.f (a i) '' (V i) := by
    rw [hcov]
    trivial
  obtain ⟨i, y, hy, rfl⟩ := Set.mem_iUnion.mp hx
  exact ⟨i, ⟨y, hy⟩, by rw [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]⟩

end Schemes

end Langlands.AlgebraicGeometry.FppfClosedLocusDescent

namespace Langlands.AlgebraicGeometry

open FppfClosedLocusDescent in
/-- fppf descent of closed loci cut out by closed immersions. -/
theorem fppfClosedLocusDescent : FppfClosedLocusDescentStatement.{u} := by
  intro Y E hE ⟨R, hR, hloc⟩
  refine closedLocusFromAffineCharts Y (fun _ g ↦ E g) (fun _ _ f g hg ↦ E.downward_closed hg f)
    (fun T g hg ↦ ?_) (fun U ↦ ?_)
  · refine hE g (Scheme.fppfTopology.superset_covering ?_
      (Precoverage.generate_mem_toGrothendieck (R := Presieve.ofArrows
        (fun V : Y.affineOpens ↦ (g ⁻¹ᵁ (V : Y.Opens)).toScheme)
        (fun V ↦ (g ⁻¹ᵁ (V : Y.Opens)).ι)) ?_))
    · rw [Sieve.generate_le_iff]
      rintro _ _ ⟨V⟩
      exact hg V
    · rw [Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
      refine ⟨fun t ↦ ?_, fun V ↦ ⟨inferInstance, inferInstance⟩⟩
      obtain ⟨V, hV, hgV, -⟩ := exists_isAffineOpen_mem_and_subset
        (show g t ∈ (⊤ : Y.Opens) from trivial)
      exact ⟨⟨V, hV⟩, ⟨t, hgV⟩, rfl⟩
  · have : IsAffine (U : Y.Opens) := U.2
    refine affine_case (E.pullback (U : Y.Opens).ι)
      (Scheme.fppfTopology.isClosed_pullback _ _ hE) (R.pullback (U : Y.Opens).ι)
      (Scheme.fppfTopology.pullback_stable _ hR) fun Y' f hf ↦ ?_
    obtain ⟨Z, ι, hι, H⟩ := hloc (f ≫ (U : Y.Opens).ι) hf
    refine ⟨Z, ι, hι, fun T g ↦ ?_⟩
    rw [H g]
    change E (g ≫ f ≫ _) ↔ E ((g ≫ f) ≫ _)
    rw [Category.assoc]

end Langlands.AlgebraicGeometry
