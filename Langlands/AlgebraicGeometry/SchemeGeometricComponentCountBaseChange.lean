import Langlands.AlgebraicGeometry.SchemeGeometricComponentCountStatement
import Langlands.AlgebraicGeometry.GeometricallyConnectedClosedCoverProof
import Langlands.AlgebraicGeometry.ClosedSubschemeFiberCover
import Langlands.AlgebraicGeometry.AlgClosedConnectedProof
import Langlands.Topology.ClosedCoverQuotientComponents

/-! # Base-change invariance of geometric connected-component counts -/

noncomputable section

universe u v w

open Set Topology TopologicalSpace CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.SchemeFiberGeometry

open GenericImagePattern ComponentIncidence

/-- Homeomorphic spaces have the same number of connected components. -/
theorem componentCount_congr {A : Type v} {B : Type w} [TopologicalSpace A]
    [TopologicalSpace B] (h : A ≃ₜ B) :
    ENat.card (ConnectedComponents A) = ENat.card (ConnectedComponents B) :=
  ENat.card_congr
    { toFun := h.continuous.connectedComponentsMap
      invFun := h.symm.continuous.connectedComponentsMap
      left_inv := by
        intro c
        obtain ⟨x, rfl⟩ := ConnectedComponents.surjective_coe c
        simp only [Continuous.connectedComponentsMap_mk, Homeomorph.symm_apply_apply]
      right_inv := by
        intro c
        obtain ⟨x, rfl⟩ := ConnectedComponents.surjective_coe c
        simp only [Continuous.connectedComponentsMap_mk, Homeomorph.apply_symm_apply] }

/-- Isomorphic schemes have the same number of connected components. -/
theorem componentCount_congr_iso {X X' : Scheme.{u}} (e : X ≅ X') :
    ENat.card (ConnectedComponents X) = ENat.card (ConnectedComponents X') :=
  componentCount_congr e.hom.homeomorph

/-- A finite closed cover by connected sets computes the component count as the
number of classes of the equivalence relation generated by nonempty intersection. -/
theorem componentCount_eq_intersectionQuot {A : Type w} [TopologicalSpace A]
    {ι : Type v} [Finite ι] (s : ι → Set A) (hclosed : ∀ i, IsClosed (s i))
    (hconn : ∀ i, _root_.IsConnected (s i)) (hcover : (⋃ i, s i) = Set.univ) :
    ENat.card (ConnectedComponents A) = ENat.card (Quot (intersectionRelation s)) := by
  rw [Langlands.Topology.componentCount_eq_closedCoverIncidence id IsQuotientMap.id
    s hclosed hconn hcover]
  apply ENat.card_congr
  apply Quot.congr (Equiv.refl ι)
  intro i j
  constructor
  · rintro ⟨x, hx, y, hy, rfl⟩
    exact ⟨x, hx, hy⟩
  · rintro ⟨x, hx, hy⟩
    exact ⟨x, hx, x, hy, rfl⟩

section Field

variable {K L : Type u} [Field K] [Field L] {X : Scheme.{u}}

/-- A finite closed cover by geometrically connected closed subschemes computes the
component count of the scheme itself by incidence of the pieces. -/
theorem componentCount_eq_of_closedCover (f : X ⟶ Spec (CommRingCat.of K))
    {ι : Type v} [Finite ι] {Z : ι → Scheme.{u}} (g : ∀ i, Z i ⟶ X)
    [∀ i, IsClosedImmersion (g i)] [∀ i, GeometricallyConnected (g i ≫ f)]
    (hcover : (⋃ i, Set.range (g i)) = Set.univ) :
    ENat.card (ConnectedComponents X) =
      ENat.card (Quot (intersectionRelation (fun i => Set.range (g i)))) := by
  apply componentCount_eq_intersectionQuot _
    (fun i => (g i).isClosedEmbedding.isClosed_range) _ hcover
  intro i
  let : ConnectedSpace (Z i) :=
    GeometricallyConnected.connectedSpace_of_subsingleton (g i ≫ f)
  exact isConnected_range (g i).continuous

/-- The same finite closed cover computes the component count after every field
extension, by the same incidence of the original pieces. -/
theorem fieldBaseChange_componentCount_eq (f : X ⟶ Spec (CommRingCat.of K))
    (e : Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of K))
    {ι : Type v} [Finite ι] {Z : ι → Scheme.{u}} (g : ∀ i, Z i ⟶ X)
    [∀ i, IsClosedImmersion (g i)] [hgc : ∀ i, GeometricallyConnected (g i ≫ f)]
    (hcover : (⋃ i, Set.range (g i)) = Set.univ) :
    ENat.card (ConnectedComponents (pullback f e : Scheme.{u})) =
      ENat.card (Quot (intersectionRelation (fun i => Set.range (g i)))) := by
  rw [componentCount_eq_intersectionQuot (baseChangeSubschemeRanges (pullback.fst f e) g)
    (fun i => (pullback.snd (g i) (pullback.fst f e)).isClosedEmbedding.isClosed_range)
    (fun i => isConnected_fieldBaseChangeSubschemeRanges f e g i)
    (baseChangeSubschemeRanges_cover (pullback.fst f e) g hcover)]
  exact ENat.card_congr (Quot.congr (Equiv.refl ι)
    (fieldBaseChangeSubschemeRanges_incidence_iff f e g))

/-- Over an algebraically closed field, extension of the base field preserves the
number of connected components of a scheme of finite type. -/
theorem algClosed_fieldBaseChange_componentCount_eq [IsAlgClosed K]
    (f : X ⟶ Spec (CommRingCat.of K)) [LocallyOfFiniteType f] [QuasiCompact f]
    (e : Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of K)) :
    ENat.card (ConnectedComponents (pullback f e : Scheme.{u})) =
      ENat.card (ConnectedComponents X) := by
  let : IsNoetherian X :=
    { toIsLocallyNoetherian := LocallyOfFiniteType.isLocallyNoetherian f
      toCompactSpace := QuasiCompact.compactSpace_of_compactSpace f }
  let := (NoetherianSpace.finite_irreducibleComponents (α := X)).to_subtype
  let C : irreducibleComponents X → TopologicalSpace.Closeds X :=
    fun c => ⟨c.val, isClosed_of_mem_irreducibleComponents c.val c.property⟩
  let Z := fun c => (Scheme.IdealSheafData.vanishingIdeal (C c)).subscheme
  let g : ∀ c, Z c ⟶ X :=
    fun c => (Scheme.IdealSheafData.vanishingIdeal (C c)).subschemeι
  have hrange : ∀ c, Set.range (g c) = c.val := by
    intro c
    exact Scheme.IdealSheafData.range_subschemeι _
  let : ∀ c, GeometricallyConnected (g c ≫ f) := by
    intro c
    let : ConnectedSpace ↥(Set.range (g c)) :=
      isConnected_iff_connectedSpace.mp ((hrange c).symm ▸ c.property.1.isConnected)
    let : ConnectedSpace (Z c) := (g c).isEmbedding.toHomeomorph.connectedSpace_iff.mpr
      inferInstance
    exact Langlands.AlgebraicGeometry.algClosedConnected K (Z c) (g c ≫ f)
  have hcover : (⋃ c, Set.range (g c)) = Set.univ := by
    simp_rw [hrange]
    exact iUnion_componentSets X
  rw [fieldBaseChange_componentCount_eq f e g hcover,
    componentCount_eq_of_closedCover f g hcover]

/-- Any two algebraically closed extension fields give the same component count for a
scheme of finite type over a field. -/
theorem algClosedPoint_componentCount_eq {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (f : X ⟶ Spec (CommRingCat.of K)) [hft : LocallyOfFiniteType f] [hqc : QuasiCompact f]
    (e : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of K)) :
    ENat.card (ConnectedComponents (pullback f e : Scheme.{u})) =
      ENat.card (ConnectedComponents (pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) : Scheme.{u})) := by
  obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = e := ⟨Spec.preimage e, Spec.map_preimage e⟩
  let : Algebra K Ω := φ.hom.toAlgebra
  let ψ : AlgebraicClosure K →ₐ[K] Ω := IsAlgClosed.lift
  have hφ : Spec.map φ =
      Spec.map (CommRingCat.ofHom (ψ : AlgebraicClosure K →+* Ω)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ψ.comp_algebraMap]
    rfl
  rw [hφ, ← componentCount_congr_iso (pullbackLeftPullbackSndIso _ _ _)]
  exact algClosed_fieldBaseChange_componentCount_eq (pullback.snd f _) _

end Field

variable {X Y : Scheme.{u}}

/-- The geometric component count is computed on the actual residue-field fibre. -/
theorem geometricFiberComponentCount_eq_fiber (f : X ⟶ Y) (y : Y) :
    geometricFiberComponentCount f y =
      ENat.card (ConnectedComponents (pullback (f.fiberToSpecResidueField y)
        (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y)
          (AlgebraicClosure (Y.residueField y))))) : Scheme.{u})) :=
  (componentCount_congr_iso
    (pullbackLeftPullbackSndIso f (Y.fromSpecResidueField y) _)).symm

/-- Every geometric point over `y` with algebraically closed field computes the same
geometric component count. -/
theorem componentCount_algClosedPoint_eq (f : X ⟶ Y) [LocallyOfFiniteType f]
    [QuasiCompact f] (y : Y) {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (e : Spec (CommRingCat.of Ω) ⟶ Spec (Y.residueField y)) :
    ENat.card (ConnectedComponents
        (pullback f (e ≫ Y.fromSpecResidueField y) : Scheme.{u})) =
      geometricFiberComponentCount f y := by
  rw [geometricFiberComponentCount_eq_fiber,
    ← componentCount_congr_iso (pullbackLeftPullbackSndIso f (Y.fromSpecResidueField y) _)]
  have h₁ : LocallyOfFiniteType (f.fiberToSpecResidueField y) := by
    change LocallyOfFiniteType (pullback.snd f (Y.fromSpecResidueField y))
    infer_instance
  have h₂ : QuasiCompact (f.fiberToSpecResidueField y) := by
    change QuasiCompact (pullback.snd f (Y.fromSpecResidueField y))
    infer_instance
  exact algClosedPoint_componentCount_eq (hft := h₁) (hqc := h₂)
    (f.fiberToSpecResidueField y) e

/-- The geometric component count commutes with arbitrary cartesian base change. -/
theorem geometricFiberComponentCount_baseChange {P X' Y' : Scheme.{u}}
    {a : P ⟶ X'} {b : P ⟶ Y'} {f : X' ⟶ Y} {g : Y' ⟶ Y}
    (h : IsPullback a b f g) [LocallyOfFiniteType f] [QuasiCompact f] (y : Y') :
    geometricFiberComponentCount b y = geometricFiberComponentCount f (g y) := by
  have hsq := (IsPullback.of_hasPullback b (componentCountGeometricPoint y)).paste_horiz h
  have hpt : componentCountGeometricPoint y ≫ g =
      (Spec.map (CommRingCat.ofHom (algebraMap (Y'.residueField y)
        (AlgebraicClosure (Y'.residueField y)))) ≫ Spec.map (g.residueFieldMap y)) ≫
          Y.fromSpecResidueField (g y) := by
    simp only [componentCountGeometricPoint, Category.assoc,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  change ENat.card (ConnectedComponents (pullback b (componentCountGeometricPoint y) :
    Scheme.{u})) = _
  rw [componentCount_congr_iso hsq.isoPullback, hpt]
  exact componentCount_algClosedPoint_eq f (g y) _

/-- Closed covers of a residue-field fibre by geometrically connected pieces compute
the geometric component count by incidence inside that fibre. -/
theorem geometricFiberComponentCount_eq_incidence (f : X ⟶ Y) {ι : Type v} [Finite ι]
    {Z : ι → Scheme.{u}} (g : ∀ i, Z i ⟶ X) [∀ i, IsClosedImmersion (g i)] (y : Y)
    (hcover : closedSubschemeFiberCover f g y)
    (hpieces : ∀ i, GeometricallyConnected
      (pullback.snd (g i) (f.fiberι y) ≫ f.fiberToSpecResidueField y)) :
    geometricFiberComponentCount f y =
      ENat.card (Quot (closedSubschemeFiberIncidence f g y)) := by
  refine (geometricFiberComponentCount_eq_fiber f y).trans
    ((fieldBaseChange_componentCount_eq (hgc := hpieces)
    (f.fiberToSpecResidueField y) _ (fun i => pullback.snd (g i) (f.fiberι y))
    ((closedSubschemeFiberCover_iff_baseChangeRanges f g y).mp hcover)).trans ?_)
  apply ENat.card_congr
  apply Quot.congr (Equiv.refl ι)
  intro i j
  simp only [intersectionRelation, range_baseChange_eq_fiberSubschemeSets]
  rfl

end Langlands.AlgebraicGeometry.SchemeFiberGeometry
