/-! # Ideal quotients are pushforwards from the base-changed closed subscheme -/

noncomputable section

universe u

set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open scoped TensorProduct ChangeOfRings
open Langlands.Scheme.Modules

namespace Langlands.AlgebraicGeometry.Modules.IdealAdic

variable {R : CommRingCat.{u}} {X Z : Scheme.{u}} {f : X ⟶ Spec R} {I : Ideal R}

/-- The quotient map `R → R/I` in `CommRingCat`. -/
abbrev quotientRingHom (I : Ideal R) : R ⟶ CommRingCat.of (R ⧸ I) :=
  CommRingCat.ofHom (Ideal.Quotient.mk I)

variable {i : Z ⟶ X} {g : Z ⟶ Spec (CommRingCat.of (R ⧸ I))}

/-- On a base change of `Spec (R/I) → Spec R`, the base scalars in `I` vanish. -/
lemma structureRingHom_eq_zero_of_isPullback
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (a : R) (ha : a ∈ I) :
    DerivedSections.structureRingHom (i ≫ f) a = 0 := by
  have h : DerivedSections.structureRingHom (i ≫ f) =
      quotientRingHom I ≫ DerivedSections.structureRingHom g := by
    rw [hpb.w]
    simp [DerivedSections.structureRingHom]
  rw [h]
  change (DerivedSections.structureRingHom g).hom (Ideal.Quotient.mk I a) = 0
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]

/-- The base change of `Spec (R/I) → Spec R` is a closed immersion. -/
lemma isClosedImmersion_of_isPullback
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) : IsClosedImmersion i :=
  MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip
    (IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective)

/-- Over an affine open, the kernel of the closed-immersion ring map is generated by
the base ideal. -/
lemma ker_app_le_map_scalar
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I)))
    {U : X.Opens} (hU : IsAffineOpen U) :
    RingHom.ker (i.app U).hom ≤ Ideal.map (scalar f U) I := by
  intro x hx
  set J := Ideal.map (scalar f U) I
  let q : Γ(X, U) ⟶ CommRingCat.of (Γ(X, U) ⧸ J) :=
    CommRingCat.ofHom (Ideal.Quotient.mk J)
  let ψ : CommRingCat.of (R ⧸ I) ⟶ CommRingCat.of (Γ(X, U) ⧸ J) :=
    CommRingCat.ofHom (Ideal.quotientMap J (scalar f U) Ideal.le_comap_map)
  let t : Spec (CommRingCat.of (Γ(X, U) ⧸ J)) ⟶ X := Spec.map q ≫ hU.fromSpec
  have h1 : hU.fromSpec ≫ f =
      Spec.map (f.appLE ⊤ U le_top) ≫ (isAffineOpen_top (Spec R)).fromSpec :=
    (IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top _) hU le_top).symm
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h1
  have ht : t ≫ f = Spec.map ψ ≫ Spec.map (quotientRingHom I) := by
    simp only [t, Category.assoc, h1, ← Spec.map_comp]
    congr 1
  let ℓ := hpb.lift t (Spec.map ψ) ht
  have hℓ : ℓ ≫ i = t := hpb.lift_fst _ _ _
  have e₁ : (⊤ : (Spec Γ(X, U)).Opens) ≤ hU.fromSpec ⁻¹ᵁ U :=
    hU.fromSpec_preimage_self.ge
  have hcomp := Scheme.Hom.appLE_comp_appLE (Spec.map q) hU.fromSpec U ⊤ ⊤ e₁ le_top
  rw [Langlands.Scheme.Modules.isAffineOpen_fromSpec_appLE_top hU e₁] at hcomp
  have htop : (Spec.map q).appLE ⊤ ⊤ le_top = (Spec.map q).appTop := by
    rw [Scheme.Hom.appLE]
    have : (homOfLE (le_top : (⊤ : (Spec _).Opens) ≤ Spec.map q ⁻¹ᵁ ⊤)).op =
        𝟙 (op (Spec.map q ⁻¹ᵁ ⊤)) := Subsingleton.elim _ _
    rw [this, CategoryTheory.Functor.map_id, Category.comp_id]
  rw [htop, ← Scheme.ΓSpecIso_inv_naturality] at hcomp
  have hzero : (t.appLE U ⊤ (le_top.trans
      ((TopologicalSpace.Opens.map (Spec.map q).base).map (homOfLE e₁)).le)) x = 0 := by
    have key : ∀ (t' : Spec (CommRingCat.of (Γ(X, U) ⧸ J)) ⟶ X) (ht' : ℓ ≫ i = t')
        (e : ⊤ ≤ t' ⁻¹ᵁ U), (t'.appLE U ⊤ e) x = 0 := by
      intro t' ht' e
      subst ht'
      rw [Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      rw [RingHom.mem_ker.mp hx, map_zero]
    exact key t hℓ _
  have hq : (Scheme.ΓSpecIso _).inv (q x) = 0 := by
    rw [← CommRingCat.comp_apply, hcomp]
    exact hzero
  have hq' : q x = 0 := by
    have := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, U) ⧸ J))).hom hq
    rwa [Iso.inv_hom_id_apply, map_zero] at this
  exact Ideal.Quotient.eq_zero_iff_mem.mp hq'

/-- If `1 ⊗ m` vanishes in the base change of `N` along a surjective ring map `φ`,
then `m` lies in `ker φ • N`. -/
lemma mem_ker_smul_top_of_one_tmul_eq_zero {B C N : Type u} [CommRing B] [CommRing C]
    [AddCommGroup N] [Module B N] (φ : B →+* C) (hφ : Function.Surjective φ) (m : N)
    (h : ((1 : C) ⊗ₜ[B, φ] m) = 0) :
    m ∈ RingHom.ker φ • (⊤ : Submodule B N) := by
  let _ : Module B C := Module.compHom C φ
  let qL : B →ₗ[B] C :=
    { toFun := φ
      map_add' := map_add φ
      map_smul' := fun b x => by
        change φ (b * x) = φ b * φ x
        exact map_mul φ b x }
  have hrt := rTensor_exact N (LinearMap.exact_subtype_ker_map qL) (show
    Function.Surjective qL from hφ)
  have h1 : qL.rTensor N (1 ⊗ₜ m) = 0 := by
    rw [LinearMap.rTensor_tmul]
    change φ 1 ⊗ₜ m = 0
    rw [map_one]
    exact h
  obtain ⟨y, hy⟩ := (hrt _).1 h1
  have key : ∀ y : LinearMap.ker qL ⊗[B] N,
      TensorProduct.lid B N ((LinearMap.ker qL).subtype.rTensor N y) ∈
        RingHom.ker φ • (⊤ : Submodule B N) := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul k n =>
      rw [LinearMap.rTensor_tmul, TensorProduct.lid_tmul]
      exact Submodule.smul_mem_smul k.2 Submodule.mem_top
    | add x y hx hy => rw [map_add, map_add]; exact Submodule.add_mem _ hx hy
  have := key y
  rwa [hy, TensorProduct.lid_tmul, one_smul] at this

/-- Over an affine open, every section of the pullback to the base-changed
closed subscheme comes from a section of `M`. -/
lemma sectionPullback_surjective_of_isPullback
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] {U : X.Opens} (hU : IsAffineOpen U) :
    Function.Surjective (sectionPullback i M U) := by
  have := isClosedImmersion_of_isPullback hpb
  have hV : IsAffineOpen (i ⁻¹ᵁ U) := hU.preimage i
  have hφ : Function.Surjective (i.appLE U (i ⁻¹ᵁ U) le_rfl) := by
    rw [Scheme.Hom.appLE_eq_app]
    exact i.app_surjective U hU
  intro y
  obtain ⟨t, rfl⟩ := (pullbackTensorMap_bijective i M (le_refl (i ⁻¹ᵁ U)) hV hU).2 y
  induction t using TensorProduct.inductionOn with
  | tmul s m =>
    obtain ⟨b, hb⟩ := hφ (show Γ(Z, i ⁻¹ᵁ U) from s)
    refine ⟨b • m, ?_⟩
    have hs : s = i.appLE U (i ⁻¹ᵁ U) le_rfl b := hb.symm
    rw [hs, pullbackTensorMap_tmul, sectionPullbackLE_self, LinearMap.map_smulₛₗ,
      Scheme.Hom.appLE_eq_app]
  | add x y hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [map_add, map_add, ha, hb]⟩

/-- Over an affine open, a section of `M` whose pullback vanishes is a local
ideal multiple. -/
lemma mem_map_scalar_smul_top_of_sectionPullback_eq_zero
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] {U : X.Opens} (hU : IsAffineOpen U) (m : Γ(M, U))
    (hm : sectionPullback i M U m = 0) :
    m ∈ Ideal.map (scalar f U) I • (⊤ : Submodule Γ(X, U) Γ(M, U)) := by
  have := isClosedImmersion_of_isPullback hpb
  have hV : IsAffineOpen (i ⁻¹ᵁ U) := hU.preimage i
  have hφ : Function.Surjective (i.appLE U (i ⁻¹ᵁ U) le_rfl) := by
    rw [Scheme.Hom.appLE_eq_app]
    exact i.app_surjective U hU
  have ht : pullbackTensorMap i M (le_refl (i ⁻¹ᵁ U))
      ((1 : Γ(Z, i ⁻¹ᵁ U)) ⊗ₜ[Γ(X, U), (i.appLE U (i ⁻¹ᵁ U) le_rfl).hom] m) = 0 := by
    rw [pullbackTensorMap_one_tmul, sectionPullbackLE_self]
    exact hm
  have h0 : ((1 : Γ(Z, i ⁻¹ᵁ U)) ⊗ₜ[Γ(X, U), (i.appLE U (i ⁻¹ᵁ U) le_rfl).hom] m) = 0 :=
    (pullbackTensorMap_bijective i M (le_refl _) hV hU).1 (ht.trans (map_zero _).symm)
  have hmem := mem_ker_smul_top_of_one_tmul_eq_zero _ hφ m h0
  refine Submodule.smul_mono_left ?_ hmem
  rw [Scheme.Hom.appLE_eq_app]
  exact ker_app_le_map_scalar hpb hU

variable (f) in
/-- A map out of `M` killing the ideal multiples kills every local ideal
multiple of sections. -/
lemma app_eq_zero_of_mem_map_scalar_smul_top (I : Ideal R) {M N : X.Modules} (ψ : M ⟶ N)
    (hψ : inclusion f I M ≫ ψ = 0) {U : X.Opens} (m : Γ(M, U))
    (hm : m ∈ Ideal.map (scalar f U) I • (⊤ : Submodule Γ(X, U) Γ(M, U))) :
    ψ.app U m = 0 := by
  have hgen := (inclusion_comp_eq_zero_iff f I ψ).1 hψ U
  refine Submodule.smul_induction_on hm (fun j hj n _ => ?_) (fun x y hx hy => ?_)
  · rw [Scheme.Modules.Hom.app_smul]
    have hle : Ideal.map (scalar f U) I ≤
        LinearMap.ker (LinearMap.toSpanSingleton Γ(X, U) Γ(N, U) (ψ.app U n)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      change scalar f U a • ψ.app U n = 0
      rw [← Scheme.Modules.Hom.app_smul]
      exact hgen a ha n
    exact hle hj
  · rw [map_add, hx, hy, add_zero]

/-- A map out of `M` killing the ideal multiples kills every section whose pullback to
the base-changed closed subscheme vanishes. -/
lemma app_eq_zero_of_sectionPullback_eq_zero
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) {M N : X.Modules}
    [M.IsQuasicoherent] (ψ : M ⟶ N) (hψ : inclusion f I M ≫ ψ = 0) {U : X.Opens}
    (m : Γ(M, U)) (hm : sectionPullback i M U m = 0) :
    ψ.app U m = 0 := by
  apply DerivedSections.OpenCohomologyVanishing.eq_zero_of_locally_eq_zero N
  intro x hx
  obtain ⟨W, hW, hxW, hWU⟩ := exists_isAffineOpen_mem_and_subset hx
  have hle : W ≤ U := hWU
  refine ⟨W, homOfLE hle, hxW, ?_⟩
  have hnat : N.presheaf.map (homOfLE hle).op (ψ.app U m) =
      ψ.app W (M.presheaf.map (homOfLE hle).op m) :=
    (PresheafOfModules.naturality_apply ψ.val (homOfLE hle).op m).symm
  rw [hnat]
  apply app_eq_zero_of_mem_map_scalar_smul_top f I ψ hψ
  apply mem_map_scalar_smul_top_of_sectionPullback_eq_zero hpb M hW
  rw [sectionPullback_restrict, hm, map_zero]

/-- On a base change of `Spec (R/I) → Spec R`, the actual pullback unit of a
quasi-coherent module is an epimorphism. -/
lemma epi_unit_of_isPullback
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M) := by
  apply ClosedImmersionHigherDirectImageVanishing.epi_of_isLocallySurjective
  rw [TopCat.Presheaf.isLocallySurjective_iff]
  intro U t x hx
  obtain ⟨W, hW, hxW, hWU⟩ := exists_isAffineOpen_mem_and_subset hx
  have hle : W ≤ U := hWU
  obtain ⟨s, hs⟩ := sectionPullback_surjective_of_isPullback hpb M hW
    (((Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M)).presheaf.map
      (homOfLE hle).op t)
  exact ⟨W, hle, ⟨s, hs⟩, hxW⟩

/-- The kernel of the actual pullback unit maps to zero in the ideal quotient. -/
lemma kernel_ι_unit_projection
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] :
    kernel.ι ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M) ≫
      projection f I M = 0 := by
  set φ := (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M
  ext U s
  change (projection f I M).app U ((kernel.ι φ).app U s) = 0
  apply app_eq_zero_of_sectionPullback_eq_zero hpb (projection f I M) (cokernel.condition _)
  change φ.app U ((kernel.ι φ).app U s) = 0
  rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, kernel.condition,
    Scheme.Modules.Hom.zero_app]
  rfl

/-- On a base change of `Spec (R/I) → Spec R`, the canonical map from the ideal
quotient of a quasi-coherent module to the pushforward of its pullback is an
isomorphism. -/
lemma isIso_pullbackUnitDesc_of_isPullback
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] :
    IsIso (pullbackUnitDesc f I i (structureRingHom_eq_zero_of_isPullback hpb) M) := by
  set φ := (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M
  have := epi_unit_of_isPullback hpb M
  let hc := Abelian.epiIsCokernelOfKernel _ (kernelIsKernel φ)
  let e := hc.desc (CokernelCofork.ofπ (projection f I M) (kernel_ι_unit_projection hpb M))
  have he : φ ≫ e = projection f I M := hc.fac _ WalkingParallelPair.one
  refine ⟨e, ?_, ?_⟩
  · rw [← cancel_epi (projection f I M), ← Category.assoc, projection_pullbackUnitDesc, he,
      Category.comp_id]
  · rw [← cancel_epi φ, ← Category.assoc, he]
    exact (projection_pullbackUnitDesc f I i (structureRingHom_eq_zero_of_isPullback hpb)
      M).trans (Category.comp_id φ).symm

/-- The ideal quotient of a quasi-coherent module is the pushforward of its pullback
to the base change of `Spec (R/I) → Spec R`. -/
def closedFibreIso (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] :
    quotient f I M ≅ (Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M) :=
  have := isIso_pullbackUnitDesc_of_isPullback hpb M
  asIso (pullbackUnitDesc f I i (structureRingHom_eq_zero_of_isPullback hpb) M)

@[reassoc (attr := simp)]
lemma projection_closedFibreIso_hom
    (hpb : IsPullback i g f (Spec.map (quotientRingHom I))) (M : X.Modules)
    [M.IsQuasicoherent] :
    projection f I M ≫ (closedFibreIso hpb M).hom =
      (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M :=
  projection_pullbackUnitDesc f I i (structureRingHom_eq_zero_of_isPullback hpb) M

section ClosedPoint

variable (R) [IsLocalRing R]

/-- The ring map from a local ring to the residue field at the closed point of its
spectrum. -/
abbrev toClosedPointResidueField : R ⟶ (Spec R).residueField (IsLocalRing.closedPoint R) :=
  (stalkClosedPointIso R).inv ≫ (Spec R).residue (IsLocalRing.closedPoint R)

lemma toClosedPointResidueField_surjective :
    Function.Surjective (toClosedPointResidueField R) :=
  ((Spec R).residue_surjective _).comp
    (ConcreteCategory.bijective_of_isIso (stalkClosedPointIso R).inv).2

lemma ker_toClosedPointResidueField :
    RingHom.ker (toClosedPointResidueField R).hom = IsLocalRing.maximalIdeal R :=
  IsLocalRing.eq_maximalIdeal
    (RingHom.ker_isMaximal_of_surjective _ (toClosedPointResidueField_surjective R))

/-- For a local ring, the residue field at the closed point of its spectrum is the
quotient by the maximal ideal. -/
def residueFieldClosedPointIso :
    CommRingCat.of (R ⧸ IsLocalRing.maximalIdeal R) ≅
      (Spec R).residueField (IsLocalRing.closedPoint R) :=
  ((Ideal.quotEquivOfEq (ker_toClosedPointResidueField R).symm).trans
    (RingHom.quotientKerEquivOfSurjective (toClosedPointResidueField_surjective R))).toCommRingCatIso

lemma quotientRingHom_residueFieldClosedPointIso_hom :
    quotientRingHom (IsLocalRing.maximalIdeal R) ≫ (residueFieldClosedPointIso R).hom =
      toClosedPointResidueField R := by
  ext a
  rfl

lemma fromSpecResidueField_closedPoint :
    (Spec R).fromSpecResidueField (IsLocalRing.closedPoint R) =
      Spec.map (residueFieldClosedPointIso R).hom ≫
        Spec.map (quotientRingHom (IsLocalRing.maximalIdeal R)) := by
  rw [← Spec.map_comp, quotientRingHom_residueFieldClosedPointIso_hom, Spec.map_comp,
    Spec_stalkClosedPointIso]
  rfl

variable {R}

variable (f) in
/-- The fibre over the closed point of a local base is the base change of
`Spec (R/𝔪) → Spec R`. -/
lemma isPullback_fiberι_closedPoint :
    IsPullback (f.fiberι (IsLocalRing.closedPoint R))
      (f.fiberToSpecResidueField (IsLocalRing.closedPoint R) ≫
        Spec.map (residueFieldClosedPointIso R).hom) f
      (Spec.map (quotientRingHom (IsLocalRing.maximalIdeal R))) :=
  (IsPullback.of_hasPullback f
      ((Spec R).fromSpecResidueField (IsLocalRing.closedPoint R))).of_iso
    (Iso.refl _) (Iso.refl _) (asIso (Spec.map (residueFieldClosedPointIso R).hom))
    (Iso.refl _) (by simp [Scheme.Hom.fiberι]) (by simp [Scheme.Hom.fiberToSpecResidueField])
    (by simp) (by simp [fromSpecResidueField_closedPoint])

end ClosedPoint

end Langlands.AlgebraicGeometry.Modules.IdealAdic
