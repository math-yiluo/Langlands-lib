import Langlands.AlgebraicGeometry.PointTopology.AffineLineStratificationStatement
import Mathlib.RingTheory.Nilpotent.Lemmas
import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Proof of the affine-line correction to Conrad's Remark 3.3
-/

noncomputable section

universe u

open CategoryTheory
open _root_.AlgebraicGeometry
open scoped DualNumber

namespace Langlands.AlgebraicGeometry.PointTopology

variable (R : Type u) [CommRing R]

/-- The actual zero-evaluation map has kernel generated by the coordinate. -/
theorem affineLineOrigin_ker :
    RingHom.ker (MvPolynomial.aeval (R := R) (fun _ : Unit => (0 : R))).toRingHom =
      Ideal.span {MvPolynomial.X ()} := by
  let e := MvPolynomial.aeval (R := R) (fun _ : Unit => (0 : R))
  let I : Ideal (MvPolynomial Unit R) := Ideal.span {MvPolynomial.X ()}
  have h : ∀ p : MvPolynomial Unit R, p - MvPolynomial.C (e p) ∈ I := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp [e]
    | add p q hp hq =>
      simpa only [map_add, add_sub_add_comm] using I.add_mem hp hq
    | mul_X p i hp =>
      cases i
      simpa [e] using
        I.mul_mem_left p (Ideal.subset_span (Set.mem_singleton _))
  apply le_antisymm
  · intro p hp
    have hp' : e p = 0 := hp
    simpa only [hp', map_zero, sub_zero] using h p
  · apply Ideal.span_le.mpr
    rintro p (rfl : p = MvPolynomial.X ())
    exact MvPolynomial.aeval_X _ _

/-- The origin's underlying image is the actual closed subset V(t). -/
theorem range_affineLineOrigin :
    Set.range (affineLineOrigin R).left =
      PrimeSpectrum.zeroLocus {(MvPolynomial.X () : MvPolynomial Unit R)} := by
  change Set.range (PrimeSpectrum.comap
    (MvPolynomial.aeval (R := R) (fun _ : Unit => (0 : R))).toRingHom) = _
  rw [range_comap_of_surjective R _
    (fun r => ⟨MvPolynomial.C r, MvPolynomial.aeval_C _ r⟩),
    affineLineOrigin_ker, PrimeSpectrum.zeroLocus_span]

/-- Nilpotence describes the whole underlying image, rather than factorization
through the origin as a closed subscheme. -/
theorem range_subset_affineLineOrigin_iff
    (S : Type u) [CommRing S] [Algebra R S]
    (p : RingPoint R (ringTest R (MvPolynomial Unit R)) S) :
    Set.range p.left ⊆ Set.range (affineLineOrigin R).left ↔
      IsNilpotent (affineLinePointEquiv R S p) := by
  obtain ⟨s, rfl⟩ := (affineLinePointEquiv R S).symm.surjective p
  rw [Equiv.apply_symm_apply, range_affineLineOrigin]
  change (Set.range (PrimeSpectrum.comap
    (MvPolynomial.aeval (R := R) (fun _ : Unit => s)).toRingHom) ⊆
      PrimeSpectrum.zeroLocus {MvPolynomial.X ()}) ↔ IsNilpotent s
  rw [Set.range_subset_iff]
  simp only [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe,
    PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
  change (∀ x : PrimeSpectrum S,
    (MvPolynomial.aeval (R := R) (fun _ : Unit => s)) (MvPolynomial.X ()) ∈ x.asIdeal) ↔ _
  simp only [MvPolynomial.aeval_X]
  rw [nilpotent_iff_mem_prime]
  exact ⟨fun h I hI => h ⟨I, hI⟩, fun h x => h x.asIdeal x.isPrime⟩

/-- The six actual-scheme clauses hold for every commutative value algebra. -/
theorem affineLineStratificationProperties
    (S : Type u) [CommRing S] [Algebra R S] :
    AffineLineStratificationProperties R S := by
  dsimp only [AffineLineStratificationProperties]
  refine ⟨?_, range_subset_affineLineOrigin_iff R S, ?_, ?_, ?_, ?_⟩
  · rw [range_affineLineOrigin]
    exact PrimeSpectrum.basicOpen_eq_zeroLocus_compl _
  · intro p
    erw [range_affineLineOrigin_points R S]
    rfl
  · intro p
    erw [range_affineLinePuncture_points R S]
    rfl
  · intro hS
    have := hS
    apply Set.disjoint_left.mpr
    intro p hpZ hpU
    erw [range_affineLineOrigin_points R S] at hpZ
    erw [range_affineLinePuncture_points R S] at hpU
    have hz : affineLinePointEquiv R S p = 0 := hpZ
    change IsUnit (affineLinePointEquiv R S p) at hpU
    exact not_isUnit_zero (hz ▸ hpU)
  · erw [range_affineLineOrigin_points R S, range_affineLinePuncture_points R S]
    constructor
    · intro h s
      have hp := Set.eq_univ_iff_forall.mp h ((affineLinePointEquiv R S).symm s)
      simpa only [Set.mem_union, Set.mem_preimage, Set.mem_singleton_iff,
        Set.mem_ofPred_eq, Equiv.apply_symm_apply] using hp
    · intro h
      apply Set.eq_univ_iff_forall.mpr
      intro p
      exact h (affineLinePointEquiv R S p)

/-- Field coverage and the same-base local Artinian counterexample, together
with all six actual affine-line comparisons. -/
theorem conradRemark33Correction : ConradRemark33Correction.{u} := by
  refine ⟨fun R S _ _ _ => affineLineStratificationProperties R S, ?_, ?_⟩
  · intro R K _ _ _
    apply (affineLineStratificationProperties R K).2.2.2.2.2.mpr
    intro s
    by_cases hs : s = 0
    · exact Or.inl hs
    · exact Or.inr (isUnit_iff_ne_zero.mpr hs)
  · intro K _
    dsimp only
    refine ⟨inferInstance, dualNumber_isArtinianRing K, DualNumber.isNilpotent_eps,
      ?_, ?_, ?_⟩
    · apply (range_subset_affineLineOrigin_iff K[ε] K[ε] _).mpr
      rw [Equiv.apply_symm_apply]
      exact DualNumber.isNilpotent_eps
    · erw [range_affineLineOrigin_points K[ε] K[ε]]
      change ¬ affineLinePointEquiv K[ε] K[ε]
        ((affineLinePointEquiv K[ε] K[ε]).symm ε) = 0
      rw [Equiv.apply_symm_apply]
      exact dualNumber_eps_ne_zero K
    · erw [range_affineLinePuncture_points K[ε] K[ε]]
      change ¬ IsUnit (affineLinePointEquiv K[ε] K[ε]
        ((affineLinePointEquiv K[ε] K[ε]).symm ε))
      rw [Equiv.apply_symm_apply]
      exact dualNumber_eps_not_isUnit K

end Langlands.AlgebraicGeometry.PointTopology
