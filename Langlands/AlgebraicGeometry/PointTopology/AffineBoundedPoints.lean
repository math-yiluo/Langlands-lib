import Langlands.AlgebraicGeometry.PointTopology.Affine
import Mathlib.Algebra.Category.Ring.Constructions
import Mathlib.Analysis.Normed.Group.Ultra
import Mathlib.Analysis.Normed.Field.Basic
import Mathlib.Topology.MetricSpace.Ultra.Basic
import Mathlib.RingTheory.FiniteType
import Mathlib.Topology.Algebra.Ring.Basic

/-!
# Bounded sets of algebra points

Boundedness of a set of `K`-points of a `K`-algebra on generators propagates to the whole
algebra. Over an ultrametric field, every point of a finitely generated algebra has
arbitrarily small clopen neighbourhoods on which all elements are bounded. A pushout of
commutative rings is generated by the images of its two legs.
-/

noncomputable section

open CategoryTheory Filter Topology

namespace Langlands.AlgebraicGeometry.PointTopology

section Generation

universe u

/-- A pushout of commutative rings is generated, as a ring, by the images of its two legs. -/
theorem mem_closure_of_isPushout {A B C P : CommRingCat.{u}} {f : A ⟶ B} {g : A ⟶ C}
    {inl : B ⟶ P} {inr : C ⟶ P} (h : CategoryTheory.IsPushout f g inl inr) (p : P) :
    p ∈ Subring.closure (Set.range inl ∪ Set.range inr) := by
  let S := Subring.closure (Set.range inl ∪ Set.range inr)
  let jl : B ⟶ CommRingCat.of S := CommRingCat.ofHom
    (inl.hom.codRestrict S fun b => Subring.subset_closure (Or.inl ⟨b, rfl⟩))
  let jr : C ⟶ CommRingCat.of S := CommRingCat.ofHom
    (inr.hom.codRestrict S fun c => Subring.subset_closure (Or.inr ⟨c, rfl⟩))
  have hw : f ≫ jl = g ≫ jr := by
    ext a
    exact CategoryTheory.ConcreteCategory.congr_hom h.w a
  let ι : CommRingCat.of S ⟶ P := CommRingCat.ofHom S.subtype
  have hid : h.desc jl jr hw ≫ ι = 𝟙 P := by
    apply h.hom_ext
    · rw [← CategoryTheory.Category.assoc, h.inl_desc, CategoryTheory.Category.comp_id]
      rfl
    · rw [← CategoryTheory.Category.assoc, h.inr_desc, CategoryTheory.Category.comp_id]
      rfl
  have hp := CategoryTheory.ConcreteCategory.congr_hom hid p
  rw [← show ι (h.desc jl jr hw p) = p from hp]
  exact (h.desc jl jr hw p).2

end Generation

variable {K : Type*} [NontriviallyNormedField K] {A : Type*} [CommRing A] [Algebra K A]

/-- Boundedness of a set of points on a generating set of a subring propagates to the
subring. -/
theorem bounded_of_mem_closure (T : Set (A →ₐ[K] K)) (s : Set A)
    (hb : ∀ x ∈ s, ∃ C, ∀ φ ∈ T, ‖φ x‖ ≤ C) {a : A} (ha : a ∈ Subring.closure s) :
    ∃ C, ∀ φ ∈ T, ‖φ a‖ ≤ C := by
  induction ha using Subring.closure_induction with
  | mem x hx => exact hb x hx
  | zero => exact ⟨0, fun φ _ => by simp⟩
  | one => exact ⟨1, fun φ _ => by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨C₁, h₁⟩ := hx
    obtain ⟨C₂, h₂⟩ := hy
    exact ⟨C₁ + C₂, fun φ hφ => by
      rw [map_add]
      exact (norm_add_le _ _).trans (add_le_add (h₁ φ hφ) (h₂ φ hφ))⟩
  | neg x _ hx =>
    obtain ⟨C, h⟩ := hx
    exact ⟨C, fun φ hφ => by rw [map_neg, norm_neg]; exact h φ hφ⟩
  | mul x y _ _ hx hy =>
    obtain ⟨C₁, h₁⟩ := hx
    obtain ⟨C₂, h₂⟩ := hy
    exact ⟨max C₁ 0 * max C₂ 0, fun φ hφ => by
      rw [map_mul, norm_mul]
      exact mul_le_mul ((h₁ φ hφ).trans (le_max_left _ _))
        ((h₂ φ hφ).trans (le_max_left _ _)) (norm_nonneg _) (le_max_right _ _)⟩

/-- Boundedness of a set of points on a generating set of a `K`-algebra propagates to the
whole algebra. -/
theorem bounded_of_adjoin_eq_top (T : Set (A →ₐ[K] K)) (s : Set A)
    (hs : Algebra.adjoin K s = ⊤) (hb : ∀ x ∈ s, ∃ C, ∀ φ ∈ T, ‖φ x‖ ≤ C) (a : A) :
    ∃ C, ∀ φ ∈ T, ‖φ a‖ ≤ C := by
  have ha : a ∈ Algebra.adjoin K s := hs ▸ Algebra.mem_top
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact hb x hx
  | algebraMap c => exact ⟨‖c‖, fun φ _ => by rw [AlgHom.commutes]; rfl⟩
  | add x y _ _ hx hy =>
    obtain ⟨C₁, h₁⟩ := hx
    obtain ⟨C₂, h₂⟩ := hy
    exact ⟨C₁ + C₂, fun φ hφ => by
      rw [map_add]
      exact (norm_add_le _ _).trans (add_le_add (h₁ φ hφ) (h₂ φ hφ))⟩
  | mul x y _ _ hx hy =>
    obtain ⟨C₁, h₁⟩ := hx
    obtain ⟨C₂, h₂⟩ := hy
    exact ⟨max C₁ 0 * max C₂ 0, fun φ hφ => by
      rw [map_mul, norm_mul]
      exact mul_le_mul ((h₁ φ hφ).trans (le_max_left _ _))
        ((h₂ φ hφ).trans (le_max_left _ _)) (norm_nonneg _) (le_max_right _ _)⟩

/-- **Small bounded clopen neighbourhoods**: over an ultrametric field, every point of a
finitely generated algebra has, inside any neighbourhood, a clopen neighbourhood on which
every element of the algebra is bounded. -/
theorem exists_isClopen_bounded [IsUltrametricDist K] [Algebra.FiniteType K A]
    (u : AlgPoint K A K) {N : Set (AlgPoint K A K)} (hN : N ∈ 𝓝 u) :
    ∃ B : Set (AlgPoint K A K), IsClopen B ∧ u ∈ B ∧ B ⊆ N ∧
      ∀ a : A, ∃ C, ∀ φ ∈ B, ‖AlgPoint.toAlgHom φ a‖ ≤ C := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := K) (A := A)
  rw [AlgPoint.isEmbedding_evaluation.isInducing.nhds_eq_comap, Filter.mem_comap] at hN
  obtain ⟨t, ht, htN⟩ := hN
  rw [nhds_pi, Filter.mem_pi'] at ht
  obtain ⟨I, V, hV, hIV⟩ := ht
  choose ε hε hεV using fun i => Metric.mem_nhds_iff.mp (hV i)
  let B : Set (AlgPoint K A K) :=
    {φ | (∀ i ∈ I, ‖φ i - u i‖ ≤ ε i / 2) ∧ ∀ g ∈ s, ‖φ g - u g‖ ≤ 1}
  have hball : ∀ (a : A) (r : ℝ), 0 < r →
      IsClopen {φ : AlgPoint K A K | ‖φ a - u a‖ ≤ r} := by
    intro a r hr
    have hcont : Continuous fun φ : AlgPoint K A K => φ a := AlgPoint.continuous_eval a
    have he : {φ : AlgPoint K A K | ‖φ a - u a‖ ≤ r} =
        (fun φ : AlgPoint K A K => φ a) ⁻¹' Metric.closedBall (u a) r := by
      ext φ
      simp [dist_eq_norm]
    rw [he]
    exact ⟨Metric.isClosed_closedBall.preimage hcont,
      (IsUltrametricDist.isOpen_closedBall (u a) hr.ne').preimage hcont⟩
  refine ⟨B, ?_, ⟨fun i _ => by simp only [sub_self, norm_zero]; exact (half_pos (hε i)).le,
    fun g _ => by simp⟩, ?_, ?_⟩
  · have h1 : IsClopen {φ : AlgPoint K A K | ∀ i ∈ I, ‖φ i - u i‖ ≤ ε i / 2} := by
      simp only [Set.ofPred_forall]
      exact isClopen_biInter_finset fun i _ => hball i _ (half_pos (hε i))
    have h2 : IsClopen {φ : AlgPoint K A K | ∀ g ∈ s, ‖φ g - u g‖ ≤ 1} := by
      simp only [Set.ofPred_forall]
      exact isClopen_biInter_finset fun g _ => hball g 1 one_pos
    exact h1.inter h2
  · intro φ hφ
    apply htN
    apply hIV
    intro i hi
    apply hεV i
    rw [Metric.mem_ball, dist_eq_norm]
    exact (hφ.1 i hi).trans_lt (half_lt_self (hε i))
  · intro a
    obtain ⟨C, hC⟩ := bounded_of_adjoin_eq_top (AlgPoint.toAlgHom '' B) s hs (fun g hg => by
      refine ⟨‖u g‖ + 1, ?_⟩
      rintro _ ⟨φ, hφ, rfl⟩
      have := hφ.2 g hg
      calc ‖AlgPoint.toAlgHom φ g‖ = ‖φ g - u g + u g‖ := by rw [sub_add_cancel]; rfl
        _ ≤ ‖φ g - u g‖ + ‖u g‖ := norm_add_le _ _
        _ ≤ ‖u g‖ + 1 := by linarith) a
    exact ⟨C, fun φ hφ => hC _ ⟨φ, hφ, rfl⟩⟩
