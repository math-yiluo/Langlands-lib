import Langlands.AlgebraicGeometry.PointTopology.HenselianFiniteEtaleKrasner
import Langlands.AlgebraicGeometry.PointTopology.HenselianArchimedeanProof

/-!
# Finite étale algebras over a henselian field and over its completion

For a henselian valued field `K` with completion `K̂`, base change `A ↦ K̂ ⊗_K A` is bijective on
algebra maps between finite étale `K`-algebras, and every finite étale `K̂`-algebra arises.

Bijectivity and the reduction of essential surjectivity to fields hold whenever `K` is
separably closed in `K̂` (`HenselianFiniteEtale.bijective_map`,
`HenselianFiniteEtale.exists_etale_of_field`). The non-archimedean field case is Krasner's
lemma (`HenselianFiniteEtale.exists_field_of_isUltrametricDist`). In the archimedean case `K̂` is
`ℂ` or `ℝ`, up to a power of the absolute value:

* if `K̂ ≅ ℂ`, every finite extension is trivial;
* if `K̂ ≅ ℝ`, it is real closed, so a finite separable extension has degree `1` or `2`, and one
  of degree `2` is generated by a square root of `-1`, which also generates a quadratic
  extension of `K`.
-/

noncomputable section

universe u

open Polynomial IntermediateField
open scoped TensorProduct

namespace Langlands.AlgebraicGeometry.PointTopology

namespace HenselianFiniteEtale

open HenselianArchimedean

variable {K : Type u} [NontriviallyNormedField K]

local notation "K̂" => UniformSpace.Completion K

/-- **Archimedean case.** Every finite separable extension of `K̂` is `K̂ ⊗_K L` for a finite
separable extension `L` of `K`. -/
theorem exists_field_of_not_isUltrametricDist (hu : ¬ IsUltrametricDist K)
    (hK : IsHenselianValuedField K) (E : Type u) [Field E] [Algebra K̂ E] [FiniteDimensional K̂ E]
    [Algebra.IsSeparable K̂ E] :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L), FiniteDimensional K L ∧
      Algebra.IsSeparable K L ∧ Nonempty (K̂ ⊗[K] L ≃ₐ[K̂] E) := by
  obtain ⟨hcK, -⟩ := CompleteHenselian.exists_rpow_of_not_ultrametric hu
  have hsep : separableClosure K K̂ = ⊥ := separableClosure_completion_eq_bot K hK
  let _ := HenselianIffSeparablyClosed.completionNormedField K
  have hc : ¬ IsUltrametricDist K̂ := by
    intro hc
    apply hu
    refine IsUltrametricDist.isUltrametricDist_of_forall_norm_natCast_le_one fun n => ?_
    have h1 := IsUltrametricDist.norm_natCast_le_one K̂ n
    rwa [show ((n : K̂)) = ((n : K) : K̂) from
      (map_natCast (UniformSpace.Completion.coeRingHom (α := K)) n).symm,
      UniformSpace.Completion.norm_coe] at h1
  obtain ⟨hchar, s, hs0, hs1, hrat⟩ := CompleteHenselian.exists_rpow_of_not_ultrametric hc
  obtain ⟨φ, hφ⟩ := CompleteHenselian.exists_complex_rpow hs0 hs1 hrat
  have hφc : Continuous φ := (uniformContinuous_of_rpow φ hs0 hφ).continuous
  let ψ := CompleteHenselian.realHom hs0 hrat
  have hψc : Continuous ψ := CompleteHenselian.continuous_realHom hs0 hrat
  have hφψ : ∀ r : ℝ, φ (ψ r) = (r : ℂ) := by
    have heq := Rat.denseRange_cast.equalizer (hφc.comp hψc) Complex.continuous_ofReal
      (funext fun q => by simp [map_ratCast])
    exact fun r => congrFun heq r
  -- `K` as a subfield of `E`
  let _ : Algebra K E := ((algebraMap K̂ E).comp (algebraMap K K̂)).toAlgebra
  have : IsScalarTower K K̂ E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  -- degree `1`: `L = K`
  have hone : Module.finrank K̂ E = 1 → ∃ (L : Type u) (_ : Field L) (_ : Algebra K L),
      FiniteDimensional K L ∧ Algebra.IsSeparable K L ∧ Nonempty (K̂ ⊗[K] L ≃ₐ[K̂] E) := by
    intro h1
    exact ⟨K, inferInstance, inferInstance, inferInstance, inferInstance,
      nonempty_algEquiv_of_algHom hsep (Algebra.ofId K E) (by rw [Module.finrank_self, h1])⟩
  by_cases hreal : ∀ y : K̂, (φ y).im = 0
  · -- `K̂` is real closed
    let τ := realPart φ hreal
    have hτφ : ∀ y, ((τ y : ℝ) : ℂ) = φ y := ofReal_realPart φ hreal
    have hφτ : φ = Complex.ofRealHom.comp τ := by
      ext y
      exact (hτφ y).symm
    have hψ : ∀ y : K̂, ψ (τ y) = y := by
      intro y
      apply φ.injective
      rw [hφψ, hτφ]
    have hsq : ∀ y : K̂, 0 ≤ τ y → IsSquare y := by
      intro y hy
      refine ⟨ψ (Real.sqrt (τ y)), ?_⟩
      rw [← map_mul, Real.mul_self_sqrt hy, hψ]
    have : IsRealClosed K̂ :=
      { toIsSemireal := IsSemireal.of_not_isSumSq_neg_one (by
          intro hsum
          have hnn : ∀ t : K̂, IsSumSq t → 0 ≤ τ t := by
            intro t ht
            induction ht with
            | zero => rw [map_zero]
            | sq_add a _ ih =>
              rw [map_add, map_mul]
              nlinarith [mul_self_nonneg (τ a)]
          have := hnn _ hsum
          rw [map_neg, map_one] at this
          linarith)
        isSquare_or_isSquare_neg := fun y => by
          rcases le_total 0 (τ y) with hy | hy
          · exact Or.inl (hsq y hy)
          · exact Or.inr (hsq (-y) (by rw [map_neg]; linarith))
        exists_isRoot_of_odd_natDegree := fun {f} hf => by
          obtain ⟨t, ht⟩ := real_exists_isRoot_of_odd (f := f.map τ)
            (by rwa [natDegree_map_eq_of_injective τ.injective])
          refine ⟨ψ t, φ.injective ?_⟩
          rw [map_zero]
          change φ (eval (ψ t) f) = 0
          rw [← eval₂_id, hom_eval₂, RingHom.comp_id, hφψ, hφτ, ← Complex.ofRealHom_eq_coe,
            ← hom_eval₂, ← eval_map, ht.eq_zero, map_zero] }
    -- the degree is at most `2`
    obtain ⟨β, hβ⟩ := Field.exists_primitive_element K̂ E
    have hβint : IsIntegral K̂ β := .of_finite K̂ β
    have hdeg : (minpoly K̂ β).natDegree = Module.finrank K̂ E := by
      rw [← IntermediateField.adjoin.finrank hβint, hβ, IntermediateField.finrank_top']
    have hle : Module.finrank K̂ E ≤ 2 := by
      rw [← hdeg]
      exact Langlands.FieldTheory.RealClosedDegree.natDegree_le_two_of_irreducible τ
        (minpoly.irreducible hβint)
    have hpos : 0 < Module.finrank K̂ E := Module.finrank_pos
    rcases (show Module.finrank K̂ E = 1 ∨ Module.finrank K̂ E = 2 by omega) with h1 | h2
    · exact hone h1
    · -- degree `2`: `E = K̂(ι)` with `ι² = -1`, and `L = K(ι)`
      obtain ⟨ι, hι⟩ := Langlands.FieldTheory.RealClosedDegree.exists_sq_eq_neg_one
        (R := K̂) (F := E) h2
      have hιK : ι ∉ Set.range (algebraMap K E) := by
        rintro ⟨t, rfl⟩
        rw [← map_mul, ← map_one (algebraMap K E), ← map_neg,
          (algebraMap K E).injective.eq_iff] at hι
        have h1 := congrArg (fun x : K => (φ (algebraMap K K̂ x)).re) hι
        simp only [map_mul, map_neg, map_one, Complex.mul_re, Complex.neg_re, Complex.one_re,
          hreal, mul_zero, sub_zero] at h1
        nlinarith [mul_self_nonneg (φ (algebraMap K K̂ t)).re]
      have hιint : IsIntegral K ι := by
        refine ⟨X ^ 2 + 1, monic_X_pow_add (by rw [degree_one]; exact WithBot.coe_pos.mpr two_pos), ?_⟩
        change aeval ι (X ^ 2 + 1 : K[X]) = 0
        rw [map_add, map_pow, aeval_X, map_one, sq, hι, neg_add_cancel]
      have hιdeg : (minpoly K ι).natDegree = 2 := by
        have hle2 : (minpoly K ι).natDegree ≤ 2 := by
          have hdvd := minpoly.dvd K ι (show aeval ι (X ^ 2 + 1 : K[X]) = 0 by
            rw [map_add, map_pow, aeval_X, map_one, sq, hι, neg_add_cancel])
          have := natDegree_le_of_dvd hdvd (by
            intro h0
            have := congrArg (fun p : K[X] => p.coeff 0) h0
            simp at this)
          rwa [show (X ^ 2 + 1 : K[X]).natDegree = 2 by
            rw [natDegree_add_eq_left_of_degree_lt (by rw [degree_one, degree_X_pow]; norm_num),
              natDegree_X_pow]] at this
        have hne1 : (minpoly K ι).natDegree ≠ 1 := fun h => hιK (minpoly.natDegree_eq_one_iff.mp h)
        have hpos' := minpoly.natDegree_pos hιint
        omega
      have : FiniteDimensional K K⟮ι⟯ := IntermediateField.adjoin.finiteDimensional hιint
      have : Algebra.IsSeparable K K⟮ι⟯ :=
        (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K E).2
          (minpoly.irreducible hιint).separable
      refine ⟨K⟮ι⟯, inferInstance, inferInstance, inferInstance, inferInstance,
        nonempty_algEquiv_of_algHom hsep (K⟮ι⟯).val ?_⟩
      rw [IntermediateField.adjoin.finrank hιint, hιdeg, h2]
  · -- `K̂ ≅ ℂ` is algebraically closed
    push Not at hreal
    obtain ⟨y₀, hy₀⟩ := hreal
    have hsurj : Function.Surjective φ := by
      intro w
      set w₀ := φ y₀
      set b := w.im / w₀.im
      set a := w.re - b * w₀.re
      refine ⟨ψ a + ψ b * y₀, ?_⟩
      rw [map_add, map_mul, hφψ, hφψ]
      apply Complex.ext
      · simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im, zero_mul,
          sub_zero, a]
        ring
      · simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re, zero_add,
          zero_mul, add_zero, b]
        field_simp
        rfl
    have : IsAlgClosed K̂ := IsAlgClosed.of_exists_root K̂ fun p _ hirr => by
      obtain ⟨z, hz⟩ := Complex.exists_root (f := p.map φ)
        (by rw [degree_map]; exact degree_pos_of_irreducible hirr)
      obtain ⟨y, rfl⟩ := hsurj z
      refine ⟨y, φ.injective ?_⟩
      rw [map_zero, ← eval₂_id, hom_eval₂, RingHom.comp_id, ← eval_map]
      exact hz
    apply hone
    have hs : Function.Surjective (algebraMap K̂ E) :=
      (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K̂) (K := E)).2
    have htop : (⊥ : Subalgebra K̂ E) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨c, rfl⟩ := hs x
      exact Subalgebra.algebraMap_mem _ c
    exact Subalgebra.bot_eq_top_iff_finrank_eq_one.mp htop

end HenselianFiniteEtale

/-- **Finite étale algebras over a henselian field and over its completion** (Conrad, printed
p.14): base change to the completion is bijective on algebra maps between finite étale algebras,
and every finite étale algebra over the completion comes from one over `K`. -/
theorem henselianFiniteEtaleEquivalence : HenselianFiniteEtaleEquivalenceStatement.{u} := by
  intro K _ hK
  have hsep := separableClosure_completion_eq_bot K hK
  refine ⟨fun A B _ _ _ _ _ _ _ _ => HenselianFiniteEtale.bijective_map hsep,
    fun E _ _ _ _ => HenselianFiniteEtale.exists_etale_of_field ?_ E⟩
  intro E' _ _ _ _
  by_cases hu : IsUltrametricDist K
  · exact HenselianFiniteEtale.exists_field_of_isUltrametricDist hsep E'
  · exact HenselianFiniteEtale.exists_field_of_not_isUltrametricDist hu hK E'

end Langlands.AlgebraicGeometry.PointTopology
