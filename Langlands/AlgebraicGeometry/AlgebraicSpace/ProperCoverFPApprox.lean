import Langlands.AlgebraicGeometry.AlgebraicSpace.SpaceLimitModelExistenceProof
import Mathlib.AlgebraicGeometry.Noetherian

/-! # Noetherian models of separated finitely presented algebraic spaces over affine bases -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.AlgebraicSpace

namespace NoetherianModel

variable (R : CommRingCat.{u}) [DecidableEq R]

/-- The subring generated by a finite subset of `R`. -/
abbrev stage (s : Finset R) : Subalgebra ℤ R :=
  Algebra.adjoin ℤ (s : Set R)

omit [DecidableEq R] in
theorem stage_mono {s t : Finset R} (h : s ≤ t) : stage R s ≤ stage R t :=
  Algebra.adjoin_mono (Finset.coe_subset.mpr h)

omit [DecidableEq R] in
instance (s : Finset R) : IsNoetherianRing (stage R s) :=
  have : Algebra.FiniteType ℤ (stage R s) := Algebra.FiniteType.adjoin_of_finite s.finite_toSet
  Algebra.FiniteType.isNoetherianRing ℤ _

/-- The directed diagram of finitely generated subrings of `R`. -/
def ringDiagram : Finset R ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (stage R s)
  map h := CommRingCat.ofHom (Subalgebra.inclusion (stage_mono R h.le)).toRingHom
  map_id _ := by ext; rfl
  map_comp _ _ := by ext; rfl

/-- `R` as the cocone of its finitely generated subrings. -/
def ringCocone : Cocone (ringDiagram R) where
  pt := R
  ι := { app s := CommRingCat.ofHom (stage R s).val.toRingHom
         naturality _ _ _ := by ext; rfl }

/-- `R` is the filtered colimit of its finitely generated subrings. -/
def ringCoconeIsColimit : IsColimit (ringCocone R) := by
  have : ReflectsColimit (ringDiagram R) (CategoryTheory.forget CommRingCat.{u}) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  refine isColimitOfReflects (CategoryTheory.forget CommRingCat.{u}) ?_
  refine Types.FilteredColimit.isColimitOf _ _ ?_ ?_
  · rintro (x : R)
    exact ⟨{x}, (⟨x, Algebra.subset_adjoin (by simp)⟩ : stage R {x}), rfl⟩
  · rintro i j (x : stage R i) (y : stage R j) (h : (x : R) = y)
    refine ⟨i ⊔ j, homOfLE le_sup_left, homOfLE le_sup_right, ?_⟩
    change (Subalgebra.inclusion (stage_mono R le_sup_left) x : stage R (i ⊔ j)) =
      Subalgebra.inclusion (stage_mono R le_sup_right) y
    exact Subtype.ext h

variable (S : Scheme.{u}) [IsAffine S] [DecidableEq Γ(S, ⊤)]

/-- The spectra of the finitely generated subrings of `Γ(S, ⊤)`. -/
abbrev specDiagram : (Finset Γ(S, ⊤))ᵒᵖ ⥤ Scheme.{u} :=
  (ringDiagram Γ(S, ⊤)).op ⋙ Scheme.Spec

instance (i : (Finset Γ(S, ⊤))ᵒᵖ) : IsAffine ((specDiagram S).obj i) :=
  inferInstanceAs (IsAffine (Spec (CommRingCat.of (stage Γ(S, ⊤) i.unop))))

/-- The affine scheme `S` as the cone of the spectra of the finitely generated subrings of
its global sections. -/
def specCone : Cone (specDiagram S) :=
  (Scheme.Spec.mapCone (ringCocone Γ(S, ⊤)).op).extend S.isoSpec.symm.inv

/-- `S` is the cofiltered limit of these Noetherian affine schemes. -/
def specConeIsLimit : IsLimit (specCone S) :=
  IsLimit.ofIsoLimit (isLimitOfPreserves Scheme.Spec (ringCoconeIsColimit Γ(S, ⊤)).op)
    (Cone.extendIso (Scheme.Spec.mapCone (ringCocone Γ(S, ⊤)).op) S.isoSpec.symm)

end NoetherianModel

open NoetherianModel in
/-- A separated algebraic space with a quasi-compact, locally finitely presented atlas over an
affine scheme is the base change of such a space over a Noetherian affine scheme. -/
theorem exists_noetherian_model (S : Scheme.{u}) [IsAffine S] (X : AlgebraicSpace S)
    (hX : IsSeparated X)
    (hXa : HasAtlasProperty (@LocallyOfFinitePresentation.{u} ⊓ @QuasiCompact.{u}) X) :
    ∃ (R : CommRingCat.{u}) (_ : IsNoetherianRing R) (g : S ⟶ Spec R)
      (X₀ : AlgebraicSpace (Spec R)), IsSeparated X₀ ∧
        HasAtlasProperty (@LocallyOfFinitePresentation.{u} ⊓ @QuasiCompact.{u}) X₀ ∧
        Nonempty (baseChange g X₀ ≅ X) := by
  classical
  obtain ⟨i, X₀, hsep, hat, he⟩ :=
    spaceLimitModelExistence _ _ (specCone S) (specConeIsLimit S) X hX hXa
  exact ⟨CommRingCat.of (stage Γ(S, ⊤) i.unop), inferInstance, (specCone S).π.app i, X₀,
    hsep, hat, he⟩

end Langlands.AlgebraicGeometry.AlgebraicSpace
