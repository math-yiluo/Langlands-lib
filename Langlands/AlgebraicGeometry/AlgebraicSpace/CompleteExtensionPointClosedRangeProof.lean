/-! # Closed rational loci over extensions of complete normed fields -/
noncomputable section
universe u
open CategoryTheory CategoryTheory.Limits Opposite Topology Filter
open _root_.AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology
  (RingPoint ringTest schemePointTopology IsHenselianValuedField AlgPoint
    affineSchemePointEquiv AffineCoordinateRing)

namespace Langlands.AlgebraicGeometry.AlgebraicSpace
namespace CompleteExtensionClosedRange

section Trapping

variable {K M A : Type u} [NontriviallyNormedField K] [NontriviallyNormedField M]
  [NormedAlgebra K M] [CommRing A] [Algebra K A]

/-- A finite-dimensional intermediate field over a complete base field is closed. -/
theorem isClosed_intermediateField [CompleteSpace K] (E : IntermediateField K M)
    [FiniteDimensional K E] : IsClosed (E : Set M) := by
  have : FiniteDimensional K E.toSubalgebra.toSubmodule := ‹FiniteDimensional K E›
  exact Submodule.closed_of_finiteDimensional E.toSubalgebra.toSubmodule

/-- The points all of whose coordinates lie in a finite-dimensional intermediate field
form a closed set. -/
theorem isClosed_setOf_forall_mem [CompleteSpace K] (E : IntermediateField K M)
    [FiniteDimensional K E] : IsClosed {p : AlgPoint K A M | ∀ a, p a ∈ E} := by
  simp only [Set.ofPred_forall]
  exact isClosed_iInter fun a =>
    (isClosed_intermediateField E).preimage (AlgPoint.continuous_eval a)

variable [IsSepClosed M]

/-- **Galois trapping.** Let `S` be the separable closure of `K` in a separably closed
normed extension `M`, and let `T` be a set of `S`-valued points such that two
Galois-conjugate members of `T` lying in the open set `V` coincide. Then every point of
`V` in the closure of `T` has all coordinates in one finite Galois extension of `K`. -/
theorem exists_finiteGalois_of_mem_closure [CompleteSpace K] (hK : IsHenselianValuedField K)
    {V : Set (AlgPoint K A M)} (hV : IsOpen V)
    {T : Set (AlgPoint K A (separableClosure K M))}
    (hT : ∀ η ∈ T, ∀ σ : separableClosure K M ≃ₐ[K] separableClosure K M,
      AlgPoint.mapCoefficients (separableClosure K M).val
          (AlgPoint.mapCoefficients σ.toAlgHom η) ∈ V →
        AlgPoint.mapCoefficients (separableClosure K M).val η ∈ V →
          AlgPoint.mapCoefficients σ.toAlgHom η = η)
    {p : AlgPoint K A M} (hpV : p ∈ V)
    (hp : p ∈ closure (AlgPoint.mapCoefficients (separableClosure K M).val '' T)) :
    ∃ E : IntermediateField K M, FiniteDimensional K E ∧ IsGalois K E ∧ ∀ a, p a ∈ E := by
  classical
  let S := separableClosure K M
  let ι : AlgPoint K A S → AlgPoint K A M := AlgPoint.mapCoefficients S.val
  -- a basic coordinate neighbourhood of `p` inside `V`
  have hN : V ∈ 𝓝 p := hV.mem_nhds hpV
  rw [AlgPoint.isEmbedding_evaluation.isInducing.nhds_eq_comap, Filter.mem_comap] at hN
  obtain ⟨t, ht, htV⟩ := hN
  rw [nhds_pi, Filter.mem_pi'] at ht
  obtain ⟨I, W, hW, hIW⟩ := ht
  choose ε hε hεW using fun a => Metric.mem_nhds_iff.mp (hW a)
  have hball : ∀ r : AlgPoint K A M, (∀ a ∈ I, dist (r a) (p a) < ε a) → r ∈ V := by
    intro r hr
    apply htV
    apply hIW
    intro a ha
    exact hεW a (hr a ha)
  have hopen : ∀ q : AlgPoint K A M,
      IsOpen {r : AlgPoint K A M | ∀ a ∈ I, dist (r a) (q a) < ε a / 2} := by
    intro q
    simp only [Set.ofPred_forall]
    exact isOpen_biInter_finset fun a _ =>
      isOpen_lt ((AlgPoint.continuous_eval a).dist continuous_const) continuous_const
  -- an approximating member `w` of `T`
  obtain ⟨_, hwB, w, hwT, rfl⟩ := mem_closure_iff.mp hp _ (hopen p) (fun a _ => by
    rw [dist_self]
    exact half_pos (hε a))
  -- the finite Galois extension generated by the relevant coordinates of `w`
  let s : Set S := (fun a => w a) '' (I : Set A)
  have : Finite s := (I.finite_toSet.image _).to_subtype
  let E₀ := FiniteGaloisIntermediateField.adjoin K s
  let E : IntermediateField K M := (E₀ : IntermediateField K S).map S.val
  have hEeq : (E₀ : IntermediateField K S) ≃ₐ[K] E :=
    IntermediateField.equivMap (E₀ : IntermediateField K S) S.val
  have hEfin : FiniteDimensional K E := hEeq.toLinearEquiv.finiteDimensional
  have hEgal : IsGalois K E := IsGalois.of_algEquiv hEeq
  refine ⟨E, hEfin, hEgal, ?_⟩
  -- the invariant neighbourhood centred at `w`
  let B := {r : AlgPoint K A M | ∀ a ∈ I, dist (r a) (ι w a) < ε a / 2}
  have hBo : IsOpen B := hopen (ι w)
  have hpB : p ∈ B := fun a ha => by
    rw [dist_comm]
    exact hwB a ha
  have hBV : B ⊆ V := by
    intro r hr
    apply hball
    intro a ha
    calc dist (r a) (p a) ≤ dist (r a) (ι w a) + dist (ι w a) (p a) := dist_triangle _ _ _
      _ < ε a / 2 + ε a / 2 := add_lt_add (hr a ha) (hwB a ha)
      _ = ε a := add_halves _
  -- trapped members of `T` have all coordinates in `E`
  have htrap : ∀ η ∈ T, ι η ∈ B → ∀ a, ι η a ∈ E := by
    intro η hη hηB a
    have hfix : ∀ σ ∈ (E₀ : IntermediateField K S).fixingSubgroup, σ (η a) = η a := by
      intro σ hσ
      have hσB : ι (AlgPoint.mapCoefficients σ.toAlgHom η) ∈ B := by
        intro b hb
        have hwb : σ (w b) = w b :=
          hσ ⟨w b, FiniteGaloisIntermediateField.subset_adjoin K s ⟨b, hb, rfl⟩⟩
        change dist ((σ (η b) : S) : M) ((w b : S) : M) < ε b / 2
        rw [← hwb]
        change dist (σ (η b)) (σ (w b)) < ε b / 2
        rw [(FiniteExtensionEmbedding.isometry_aut hK σ).dist_eq]
        exact hηB b hb
      have h := hT η hη σ (hBV hσB) (hBV hηB)
      exact congrArg (fun q : AlgPoint K A S => q a) h
    have hmem : η a ∈ (E₀ : IntermediateField K S) := by
      rw [← InfiniteGalois.fixedField_fixingSubgroup (E₀ : IntermediateField K S)]
      exact fun σ => hfix σ σ.property
    exact ⟨η a, hmem, rfl⟩
  -- pass to the closure
  have hC := isClosed_setOf_forall_mem (A := A) E
  have hpC : p ∈ closure {r : AlgPoint K A M | ∀ a, r a ∈ E} := by
    rw [mem_closure_iff]
    intro o ho hpo
    obtain ⟨_, ⟨hyo, hyB⟩, η, hηT, rfl⟩ :=
      mem_closure_iff.mp hp (o ∩ B) (ho.inter hBo) ⟨hpo, hpB⟩
    exact ⟨ι η, hyo, htrap η hηT hyB⟩
  rw [hC.closure_eq] at hpC
  exact hpC

end Trapping

section SepClosed

variable {K M : Type u} [NontriviallyNormedField K] [NontriviallyNormedField M]
  [NormedAlgebra K M] [CompleteSpace K]
variable {X : AlgebraicSpace (Spec (CommRingCat.of K))}

/-- A point in the closure of the rational locus that is already defined over a finite
Galois intermediate field `E` is rational: the rational locus over `E` is closed and
`X_E(E) → X_M(M)` is a topological embedding. -/
theorem mem_range_of_intermediateField (hM : IsHenselianValuedField M)
    (hX : IsQuasiSeparatedLocallyFiniteType K X) (hs : IsSeparated X)
    (E : IntermediateField K M) [FiniteDimensional K E] [IsGalois K E]
    {z : RingPoints M (baseChange (Spec.algebraMap K M) X) M}
    (hz : z ∈ @closure (RingPoints M (baseChange (Spec.algebraMap K M) X) M)
      (etaleChartTopology M _) (Set.range (extensionPointMap M X)))
    (y : RingPoints K X E)
    (hy : baseChangeRingPointsEquiv K M M X z = RingPoints.changeRing E.val y) :
    z ∈ Set.range (extensionPointMap M X) := by
  have hK : IsHenselianValuedField K := PointTopology.completeHenselianValuedField K
  let : NormedAlgebra E M :=
    { norm_smul_le := fun c x => by
        change ‖(c : M) * x‖ ≤ ‖(c : M)‖ * ‖x‖
        exact (norm_mul _ _).le }
  have hE : IsHenselianValuedField E :=
    FiniteExtensionEmbedding.isHenselianValuedField_extension hK
  let XE := baseChange (Spec.algebraMap K E) X
  let XM := baseChange (Spec.algebraMap K M) X
  let : TopologicalSpace (RingPoints E XE E) := etaleChartTopology E XE
  let : TopologicalSpace (RingPoints M XM M) := etaleChartTopology M XM
  let : TopologicalSpace (RingPoints M (baseChange (Spec.algebraMap E M) XE) M) :=
    etaleChartTopology M _
  have hXE : IsQuasiSeparatedLocallyFiniteType E XE := ⟨hX.1.baseChange, hX.2.baseChange⟩
  let f := RingPoints.map (A := M) (towerIso K E M X).hom ∘ fieldExtensionPointMap E M XE
  have hf : IsEmbedding f :=
    (isHomeomorph_ringPointsMap_of_iso (towerIso K E M X)).isEmbedding.comp
      (isEmbedding_henselianExtensionPointMap hE hM hXE hs.baseChange)
  have hrange : f '' Set.range (extensionPointMap E X) = Set.range (extensionPointMap M X) := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext (fieldExtensionPointMap_tower K E M X))
  have hclosed : IsClosed (Set.range (extensionPointMap E X)) :=
    ExtensionClosedRange.isClosed_range_of_finite_galois hK hE hX hs
  let yE := (baseChangeRingPointsEquiv K E E X).symm y
  have hfy : f yE = z := by
    apply (baseChangeRingPointsEquiv K M M X).injective
    rw [hy]
    change baseChangeRingPointsEquiv K M M X
      (RingPoints.map (towerIso K E M X).hom (fieldExtensionPointMap E M XE yE)) = _
    rw [baseChangeRingPointsEquiv_towerIso, fieldExtensionPointMap, Equiv.apply_symm_apply,
      baseChangeRingPointsEquiv_changeRing, Equiv.apply_symm_apply]
    rfl
  have hyE : yE ∈ closure (Set.range (extensionPointMap E X)) := by
    rw [hf.isInducing.closure_eq_preimage_closure_image, hrange]
    rw [Set.mem_preimage, hfy]
    exact hz
  rw [hclosed.closure_eq] at hyE
  obtain ⟨x, hx⟩ := hyE
  refine ⟨x, ?_⟩
  rw [← hfy, ← hx]
  exact (fieldExtensionPointMap_tower K E M X x).symm

/-- **Separably closed case.** Over a separably closed henselian normed extension `M` of a
complete field `K`, the rational locus is closed. -/
theorem isClosed_range_of_isSepClosed [IsSepClosed M] (hM : IsHenselianValuedField M)
    (hX : IsQuasiSeparatedLocallyFiniteType K X) (hs : IsSeparated X) :
    IsClosed[etaleChartTopology M (baseChange (Spec.algebraMap K M) X)]
      (Set.range (extensionPointMap M X)) := by
  classical
  have hK : IsHenselianValuedField K := PointTopology.completeHenselianValuedField K
  let XM := baseChange (Spec.algebraMap K M) X
  let : TopologicalSpace (RingPoints M XM M) := etaleChartTopology M XM
  rw [← closure_subset_iff_isClosed]
  intro z hz
  -- an affine étale chart through `z`, defined over `K`
  obtain ⟨U, a, hU, ha, v, hv⟩ :=
    FieldPointEtaleLift.exists_affine_etale_point X (baseChangeRingPointsEquiv K M M X z)
  let := hU
  have hlft := locallyOfFiniteType_of_isEtale hX.2 (hom a) ha
  let c : EtaleFiniteTypeChart K X := ⟨U, a, ha, hlft, inferInstance⟩
  let A := AffineCoordinateRing K U
  let S := separableClosure K M
  let : TopologicalSpace (RingPoint K U M) := schemePointTopology K U M
  let : TopologicalSpace (RingPoint M c.fieldExtension.scheme M) :=
    schemePointTopology M c.fieldExtension.scheme M
  let e := PointTopology.ringPointBaseChangeEquiv K M M U
  have he : IsHomeomorph e := PointTopology.schemeBaseChangeTopology_proof K M M U
  let q := ExtensionClosedRange.chartExtensionMap (L := M) c
  have hqopen : IsOpenMap q := (c.fieldExtension.isOpenMap_pointMap hM).comp he.isOpenMap
  have hqeval (η : RingPoint K U M) : baseChangeRingPointsEquiv K M M X (q η) =
      RingPoints.map a ((schemeRingPointsEquiv K U M).symm η) :=
    ExtensionClosedRange.chartExtensionMap_eval c η
  have hqv : q v = z := (baseChangeRingPointsEquiv K M M X).injective (by rw [hqeval]; exact hv)
  -- a neighbourhood of `v` on which the chart is injective
  obtain ⟨V₀, hV₀o, hvV₀, hV₀inj⟩ := exists_isOpen_injOn_schemePointsMap
    (hom c.fieldExtension.hom)
    ((isLocallySeparated_of_isSeparated hs).baseChange (Spec.algebraMap K M))
    c.fieldExtension.isEtale (e v)
  let V := e ⁻¹' V₀
  have hVo : IsOpen V := hV₀o.preimage he.continuous
  have hvV : v ∈ V := hvV₀
  have hVinj : Set.InjOn q V := fun η hη ξ hξ heq => he.injective (hV₀inj hη hξ heq)
  -- affine coordinates
  let aE := affineSchemePointEquiv K U M
  have hAE : IsHomeomorph aE := by
    change @IsHomeomorph _ _ (schemePointTopology K U M) _ aE
    rw [PointTopology.schemePointTopology_eq_affine]
    exact @Homeomorph.isHomeomorph _ _
      (PointTopology.instTopologicalSpaceRingPointOfIsAffineLeftScheme K U M)
      AlgPoint.instTopologicalSpace (PointTopology.affineSchemePointHomeomorph K U M)
  let aS := affineSchemePointEquiv K U S
  let ι : AlgPoint K A S → AlgPoint K A M := AlgPoint.mapCoefficients S.val
  have hφ (η : AlgPoint K A S) (φ : S →ₐ[K] M) :
      aE.symm (AlgPoint.mapCoefficients φ η) = PointTopology.RingPoint.changeRing φ (aS.symm η) := by
    apply aE.injective
    rw [Equiv.apply_symm_apply, PointTopology.affineSchemePointEquiv_changeRing,
      Equiv.apply_symm_apply]
  -- chart points over `S` lying over rational points
  let T : Set (AlgPoint K A S) := {η | ∃ x : RingPoints K X K,
    RingPoints.map a ((schemeRingPointsEquiv K U S).symm (aS.symm η)) =
      RingPoints.changeRing (Algebra.ofId K S) x}
  have hqφ (η : AlgPoint K A S) (x : RingPoints K X K)
      (hx : RingPoints.map a ((schemeRingPointsEquiv K U S).symm (aS.symm η)) =
        RingPoints.changeRing (Algebra.ofId K S) x) (φ : S →ₐ[K] M) :
      q (PointTopology.RingPoint.changeRing φ (aS.symm η)) = extensionPointMap M X x := by
    apply (baseChangeRingPointsEquiv K M M X).injective
    rw [hqeval, extensionPointMap, Equiv.apply_symm_apply]
    change RingPoints.map a
      (RingPoints.changeRing φ ((schemeRingPointsEquiv K U S).symm (aS.symm η))) = _
    rw [← RingPoints.changeRing_map, hx, RingPoints.changeRing_comp]
    congr 1
    exact Subsingleton.elim _ _
  have hmem (θ : AlgPoint K A M) (hθ : θ ∈ aE '' V) : aE.symm θ ∈ V := by
    obtain ⟨ξ, hξ, rfl⟩ := hθ
    rw [Equiv.symm_apply_apply]
    exact hξ
  have hT : ∀ η ∈ T, ∀ σ : S ≃ₐ[K] S,
      ι (AlgPoint.mapCoefficients σ.toAlgHom η) ∈ aE '' V → ι η ∈ aE '' V →
        AlgPoint.mapCoefficients σ.toAlgHom η = η := by
    rintro η ⟨x, hx⟩ σ h₁ h₂
    have e₁ : ι (AlgPoint.mapCoefficients σ.toAlgHom η) =
        AlgPoint.mapCoefficients (S.val.comp σ.toAlgHom) η := AlgPoint.ext fun _ => rfl
    have h₃ : aE.symm (ι (AlgPoint.mapCoefficients σ.toAlgHom η)) = aE.symm (ι η) := by
      apply hVinj (hmem _ h₁) (hmem _ h₂)
      rw [e₁, hφ, hφ, hqφ η x hx, hqφ η x hx]
    have h₄ := aE.symm.injective h₃
    ext b
    exact congrArg (fun p : AlgPoint K A M => p b) h₄
  -- the affine point of `v` is a limit of points of `T`
  have hval : IsScalarTower.toAlgHom K S M = S.val := rfl
  have hpV : aE v ∈ aE '' V := ⟨v, hvV, rfl⟩
  have hp : aE v ∈ closure (ι '' T) := by
    rw [mem_closure_iff]
    intro o ho hvo
    let O := aE ⁻¹' o ∩ V
    have hOo : IsOpen O := (ho.preimage hAE.continuous).inter hVo
    obtain ⟨_, ⟨ξ, hξO, rfl⟩, x, hx⟩ :=
      mem_closure_iff.mp hz (q '' O) (hqopen _ hOo) ⟨v, ⟨hvo, hvV⟩, hqv⟩
    have hξx : RingPoints.map a ((schemeRingPointsEquiv K U M).symm ξ) =
        RingPoints.changeRing (IsScalarTower.toAlgHom K S M)
          (RingPoints.changeRing (Algebra.ofId K S) x) := by
      rw [← hqeval, ← hx, extensionPointMap, Equiv.apply_symm_apply, RingPoints.changeRing_comp]
      congr 1
    obtain ⟨w, hw⟩ := ExtensionCompletionReduction.exists_chart_lift_to_subfield
      (separableClosure.separableClosure_eq_bot K M) (hom a) ha ξ _ hξx
    refine ⟨ι (aS w), ?_, aS w, ⟨x, ?_⟩, rfl⟩
    · have hιw : ι (aS w) = aE ξ := by
        rw [← hw, hval, PointTopology.affineSchemePointEquiv_changeRing]
      rw [hιw]
      exact hξO.1
    · rw [Equiv.symm_apply_apply]
      apply RelativeIntegralPoints.changeRing_injective hs (IsScalarTower.toAlgHom K S M)
        (algebraMap S M).injective
      rw [RingPoints.changeRing_map]
      change RingPoints.map a ((schemeRingPointsEquiv K U M).symm
        (PointTopology.RingPoint.changeRing (IsScalarTower.toAlgHom K S M) w)) = _
      rw [hw]
      exact hξx
  -- trapping: `v` is defined over a finite Galois extension
  obtain ⟨E, hEfin, hEgal, hE⟩ :=
    exists_finiteGalois_of_mem_closure hK (hAE.isOpenMap V hVo) hT hpV hp
  have hpE : aE v ∈ Set.range (AlgPoint.mapCoefficients (A := A) E.val) := by
    rw [AlgPoint.range_mapCoefficients E.val Subtype.val_injective]
    exact Set.mem_iInter.mpr fun b => ⟨⟨_, hE b⟩, rfl⟩
  obtain ⟨pE, hpE⟩ := hpE
  let vE := (affineSchemePointEquiv K U E).symm pE
  have hvE : PointTopology.RingPoint.changeRing E.val vE = v := by
    apply aE.injective
    rw [PointTopology.affineSchemePointEquiv_changeRing, Equiv.apply_symm_apply, hpE]
  apply mem_range_of_intermediateField hM hX hs E hz
    (RingPoints.map a ((schemeRingPointsEquiv K U E).symm vE))
  rw [← hv, RingPoints.changeRing_map]
  change _ = RingPoints.map a ((schemeRingPointsEquiv K U M).symm
    (PointTopology.RingPoint.changeRing E.val vE))
  rw [hvE]

end SepClosed

section Tower

variable {K L M : Type u} [NontriviallyNormedField K] [NontriviallyNormedField L]
  [NontriviallyNormedField M] [NormedAlgebra K L] [NormedAlgebra L M] [NormedAlgebra K M]
  [IsScalarTower K L M]
variable {X : AlgebraicSpace (Spec (CommRingCat.of K))}

/-- Closedness of the rational locus over a larger field `M` implies it over `L`: the
rational locus over `L` is the preimage of the rational locus over `M` under the
continuous injective map `X_L(L) → X_M(M)`. -/
theorem isClosed_range_of_tower (hs : IsSeparated X)
    (hM : IsClosed[etaleChartTopology M (baseChange (Spec.algebraMap K M) X)]
      (Set.range (extensionPointMap M X))) :
    IsClosed[etaleChartTopology L (baseChange (Spec.algebraMap K L) X)]
      (Set.range (extensionPointMap L X)) := by
  let XL := baseChange (Spec.algebraMap K L) X
  let XM := baseChange (Spec.algebraMap K M) X
  let : TopologicalSpace (RingPoints L XL L) := etaleChartTopology L XL
  let : TopologicalSpace (RingPoints M XM M) := etaleChartTopology M XM
  let : TopologicalSpace (RingPoints M (baseChange (Spec.algebraMap L M) XL) M) :=
    etaleChartTopology M _
  let g := RingPoints.map (A := M) (towerIso K L M X).hom ∘ fieldExtensionPointMap L M XL
  have hg : Continuous g :=
    (isHomeomorph_ringPointsMap_of_iso (towerIso K L M X)).continuous.comp
      (continuous_fieldExtensionPointMap L M XL)
  have hginj : Function.Injective g := by
    refine (isHomeomorph_ringPointsMap_of_iso (towerIso K L M X)).injective.comp ?_
    intro x y h
    apply RelativeIntegralPoints.changeRing_injective hs.baseChange (Algebra.ofId L M)
      (algebraMap L M).injective
    exact (baseChangeRingPointsEquiv L M M XL).symm.injective h
  have hgx (x : RingPoints K X K) : g (extensionPointMap L X x) = extensionPointMap M X x :=
    fieldExtensionPointMap_tower K L M X x
  have hr : Set.range (extensionPointMap L X) = g ⁻¹' Set.range (extensionPointMap M X) := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨x, (hgx x).symm⟩
    · rintro ⟨x, hx⟩
      exact ⟨x, hginj ((hgx x).trans hx)⟩
  rw [hr]
  exact hM.preimage hg

end Tower

/-- **Closed rational loci over complete extensions.** For an arbitrary extension `L/K` of
complete nontrivially normed fields and a separated quasi-separated algebraic space `X`
locally of finite type over `K`, the image of `X(K) → X_L(L)` is closed. -/
theorem completeExtensionPointClosedRange : CompleteExtensionPointClosedRangeStatement.{u} := by
  intro K L _ _ _ _ _ X hX hs
  have hL : IsHenselianValuedField L := PointTopology.completeHenselianValuedField L
  let M := AlgebraicClosure L
  obtain ⟨w, hw, -⟩ := hL M
  let : NontriviallyNormedField M :=
    { w.toNormedField with
      non_trivial := by
        obtain ⟨c, hc⟩ := NormedField.exists_one_lt_norm L
        refine ⟨algebraMap L M c, ?_⟩
        change 1 < w (algebraMap L M c)
        rw [hw]
        exact hc }
  let : NormedAlgebra L M :=
    { norm_smul_le := fun c x => by
        change w (c • x) ≤ ‖c‖ * w x
        rw [Algebra.smul_def, map_mul, hw] }
  let : NormedAlgebra K M :=
    { norm_smul_le := fun c x => by
        change w (c • x) ≤ ‖c‖ * w x
        rw [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply K L M, hw,
          norm_algebraMap'] }
  have hM : IsHenselianValuedField M :=
    FiniteExtensionEmbedding.isHenselianValuedField_extension hL
  exact isClosed_range_of_tower (M := M) hs (isClosed_range_of_isSepClosed hM hX hs)

end CompleteExtensionClosedRange
end Langlands.AlgebraicGeometry.AlgebraicSpace
