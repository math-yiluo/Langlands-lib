import Langlands.AlgebraicGeometry.AlgebraicSpace.NoetherianGeometricComponents
import Langlands.AlgebraicGeometry.AlgebraicSpace.SpaceLimitModelExistenceQuasiSeparatedStatement
import Langlands.AlgebraicGeometry.AlgebraicSpace.GeometricFibreComponentsStatement
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_SubalgebraStages_nonempty_isLimit_cone

/-! # Noetherian models and geometric component constructibility -/

noncomputable section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Topology Opposite

namespace Langlands.AlgebraicGeometry.AlgebraicSpace

open SchemeFiberGeometry GeometricComponentTransport

/-- A Noetherian scheme-base model with the actual comparison isomorphism. -/
structure GeometricComponentNoetherianModel (B : Type u) [CommRing B]
    (X : AlgebraicSpace (Spec (CommRingCat.of B))) where
  base : Scheme.{u}
  noetherian : IsNoetherian base
  map : Spec (CommRingCat.of B) ⟶ base
  space : AlgebraicSpace base
  quasiSeparated : IsQuasiSeparated space
  finitePresentation :
    HasAtlasProperty (@LocallyOfFinitePresentation.{u} ⊓ @QuasiCompact.{u}) space
  comparison : baseChange map space ≅ X

/-- Whole-presheaf isomorphisms preserve the actual geometric component count. -/
theorem schemeGeometricFibreComponentCount_iso
    {S : Scheme.{u}} {X Y : AlgebraicSpace S}
    (e : X.presheaf ≅ Y.presheaf) (p : S) :
    schemeGeometricFibreComponentCount X p = schemeGeometricFibreComponentCount Y p := by
  let := pointTopology (X.presheaf ⨯ (schemeYoneda S).obj
    (Over.mk (componentCountGeometricPoint p)))
  let := pointTopology (Y.presheaf ⨯ (schemeYoneda S).obj
    (Over.mk (componentCountGeometricPoint p)))
  exact ENat.card_congr
    (componentsEquiv (Points.isoHomeomorph (prod.mapIso e (Iso.refl _))))

/-- Every actual Noetherian model supplies constructibility for the original space. -/
theorem isConstructible_geometricFibreComponentCount_of_noetherianModel
    {B : Type u} [CommRing B] {X : AlgebraicSpace (Spec (CommRingCat.of B))}
    (M : GeometricComponentNoetherianModel B X) (n : ℕ) :
    IsConstructible
      {p : Spec (CommRingCat.of B) | geometricFibreComponentCount B X p = n} := by
  obtain ⟨U, a, ha, hs, hU⟩ := M.finitePresentation
  let := hU.1
  let := hU.2
  let := M.noetherian
  have hc (p : Spec (CommRingCat.of B)) :
      geometricFibreComponentCount B X p =
        schemeGeometricFibreComponentCount M.space (M.map p) :=
    (schemeGeometricFibreComponentCount_iso
      ((forgetToPresheaf _).mapIso M.comparison) p).symm.trans
        (schemeGeometricFibreComponentCount_baseChange M.map M.space a ha hs p)
  have heq :
      {p : Spec (CommRingCat.of B) | geometricFibreComponentCount B X p = n} =
        M.map ⁻¹' {q : M.base | schemeGeometricFibreComponentCount M.space q = n} := by
    ext p
    exact (congrArg (fun c : ℕ∞ => c = n) (hc p)).to_iff
  rw [heq]
  exact M.map.isConstructible_preimage
    (isConstructible_schemeGeometricFibreComponentCount
      M.space M.quasiSeparated a ha hs n)

namespace GeometricComponentApproximation

variable (B : Type u) [CommRing B]

local instance : Algebra (ULift.{u} ℤ) B := ULift.algebra' ℤ B

/-- The integer subalgebra generated by each finite subset of the original ring. -/
def subalgebras : Finset B →o Subalgebra (ULift.{u} ℤ) B where
  toFun s := Algebra.adjoin (ULift.{u} ℤ) (s : Set B)
  monotone' := fun _ _ h => Algebra.adjoin_mono h

/-- These actual finite subalgebras exhaust the original ring. -/
theorem exhaustive (b : B) : ∃ s, b ∈ subalgebras B s := by
  classical
  exact ⟨{b}, Algebra.subset_adjoin (by simp)⟩

/-- Each finite integer-subalgebra stage is a Noetherian ring. -/
theorem stage_noetherian (s : Finset B) : IsNoetherianRing (subalgebras B s) := by
  let : IsNoetherianRing (ULift.{u} ℤ) :=
    isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
  let : Algebra.FiniteType (ULift.{u} ℤ) (subalgebras B s) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)
  exact Algebra.FiniteType.isNoetherianRing (ULift.{u} ℤ) (subalgebras B s)

/-- The inverse diagram of actual Noetherian affine base stages. -/
def diagram : (Finset B)ᵒᵖ ⥤ Scheme.{u} :=
  SubalgebraStages.specDiagram (subalgebras B)

/-- The canonical cone with point exactly the spectrum of the original ring. -/
def cone : Cone (diagram B) :=
  SubalgebraStages.specCone (subalgebras B)

/-- The canonical cone is an actual limit cone. -/
def isLimit : IsLimit (cone B) := by
  classical
  exact (P2MW.S_AlgebraicGeometry_SubalgebraStages_nonempty_isLimit_cone.LimBC.nonempty_isLimit_specCone
    (subalgebras B) (exhaustive B)).some

/-- Limit model existence constructs an actual Noetherian model over an integer stage. -/
def model
    (hlim : SpaceLimitModelExistenceQuasiSeparated.{u})
    (X : AlgebraicSpace (Spec (CommRingCat.of B))) (hX : IsQuasiSeparated X)
    (hfp : FinitePresentationOverRing B X) :
    GeometricComponentNoetherianModel B X := by
  classical
  apply Classical.choice
  let : ∀ i, IsAffine ((diagram B).obj i) := fun i => by
    change IsAffine (Spec (CommRingCat.of (subalgebras B i.unop)))
    infer_instance
  obtain ⟨i, X₀, hqs₀, hfp₀, ⟨e⟩⟩ :=
    hlim (Finset B)ᵒᵖ (diagram B) (cone B) (isLimit B) X hX hfp
  have hN := stage_noetherian B i.unop
  exact ⟨
    { base := (diagram B).obj i
      noetherian := by
        change IsNoetherian (Spec (CommRingCat.of (subalgebras B i.unop)))
        infer_instance
      map := (cone B).π.app i
      space := X₀
      quasiSeparated := hqs₀
      finitePresentation := hfp₀
      comparison := e }⟩

end GeometricComponentApproximation

/-- The exact arbitrary-ring host theorem follows from the separate, unrestricted
quasi-separated model-existence theorem. -/
theorem geometricFibreComponentsConstructible_of_limitModels
    (hlim : SpaceLimitModelExistenceQuasiSeparated.{u}) :
    GeometricFibreComponentsConstructibleStatement.{u} := by
  intro B _ X hX hfp n
  exact isConstructible_geometricFibreComponentCount_of_noetherianModel
    (GeometricComponentApproximation.model B hlim X hX hfp) n

end Langlands.AlgebraicGeometry.AlgebraicSpace
