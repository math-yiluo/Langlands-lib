import Langlands.AlgebraicGeometry.AlgebraicSpace.EtaleChartSeparated
import Langlands.AlgebraicGeometry.PointTopology.EtaleBoundedImageClosed
import Langlands.AlgebraicGeometry.PointTopology.AffineBoundedPoints
import Langlands.AlgebraicGeometry.PointTopology.AffineSchemeTopologyFamily
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-!
# Separated spaces over non-archimedean fields: totally disconnected rational points

Over a henselian valued field `K` whose norm is ultrametric, the rational points of a
separated, quasi-separated algebraic space locally of finite type are totally disconnected
for the étale-chart topology. The image of a bounded clopen ball of an affine chart is
clopen: its preimage in any other affine chart is the image of a locally bounded closed set
under an étale map of affine schemes, hence closed.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite Topology
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open _root_.AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology
  (RingPoint schemePointTopology IsHenselianValuedField AffineCoordinateRing
    affineSchemePointEquiv affineSchemePointHomeomorph affineCoordinatePullback AlgPoint)

namespace Langlands.AlgebraicGeometry.AlgebraicSpace

variable {K : Type u} [NontriviallyNormedField K]

/-- Every rational point of a quasi-separated space locally of finite type lies in the
image of an affine chart. -/
theorem exists_affine_chart_pointMap_eq {X : AlgebraicSpace (Spec (CommRingCat.of K))}
    (hX : IsQuasiSeparated X) (hX' : LocallyOfFiniteTypeOverBase X) (x : RingPoints K X K) :
    ∃ (d : EtaleFiniteTypeChart K X) (y : RingPoint K d.scheme K),
      IsAffine d.scheme.left ∧ d.pointMap y = x := by
  obtain ⟨U, f, hU, hf, u, hu⟩ :=
    RationalPointEtaleLiftProof.rationalPointEtaleLiftStatement K X hX x
  have hlft := locallyOfFiniteType_of_isEtale hX' (hom f) hf
  have := hU
  exact ⟨⟨U, f, hf, hlft, inferInstance⟩, u, hU, hu⟩

/-- Separated spaces are locally separated. -/
theorem isLocallySeparated_of_isSeparated {S : Scheme.{u}} {X : AlgebraicSpace S}
    (hX : IsSeparated X) : IsLocallySeparated X :=
  ⟨hX.1, fun _ _ g fst snd h => by
    have : _root_.AlgebraicGeometry.IsClosedImmersion snd.left := hX.2 g fst snd h
    change IsImmersion snd.left
    infer_instance⟩

section Overlap

variable {X : AlgebraicSpace (Spec (CommRingCat.of K))} {U V : Over (Spec (CommRingCat.of K))}
  [IsAffine U.left] [IsAffine V.left]
  (a : (schemeYoneda _).obj U ⟶ X.presheaf) (b : (schemeYoneda _).obj V ⟶ X.presheaf)

/-- The product over `Spec K` of two affine schemes is affine. -/
instance isAffine_tensorObj_left : IsAffine (U ⊗ V).left := by
  change IsAffine (Limits.pullback U.hom V.hom)
  infer_instance

/-- If `X` is separated, the overlap of two affine schemes over `X` is affine. -/
theorem isAffine_pairPullback (hX : IsSeparated X) : IsAffine (pairPullback a b).left := by
  have := isClosedImmersion_pairPullbackLift a b hX
  exact isAffine_of_isAffineHom (lift (pairPullbackFst a b) (pairPullbackSnd a b)).left

/-- If `X` is separated, the global sections of the overlap of two affine schemes over `X`
are generated by the pullbacks of the global sections of the two schemes. -/
theorem mem_closure_pairPullback (hX : IsSeparated X) (z : Γ((pairPullback a b).left, ⊤)) :
    z ∈ Subring.closure (Set.range (pairPullbackFst a b).left.appTop ∪
      Set.range (pairPullbackSnd a b).left.appTop) := by
  have := isClosedImmersion_pairPullbackLift a b hX
  set ι := lift (pairPullbackFst a b) (pairPullbackSnd a b) with hι
  obtain ⟨y, rfl⟩ := ι.left.app_surjective ⊤ (isAffineOpen_top _) z
  have hpo := isPushout_appTop_of_isPullback (IsPullback.of_hasPullback U.hom V.hom)
  have hy := PointTopology.mem_closure_of_isPushout hpo y
  have hmap : ι.left.appTop.hom y ∈ (Subring.closure _).map ι.left.appTop.hom :=
    Subring.mem_map.mpr ⟨y, hy, rfl⟩
  rw [RingHom.map_closure] at hmap
  refine Subring.closure_mono ?_ hmap
  rintro _ ⟨c, hc | hc, rfl⟩
  · obtain ⟨d, rfl⟩ := hc
    refine Or.inl ⟨d, ?_⟩
    change (pairPullbackFst a b).left.appTop d = ι.left.appTop ((fst U V).left.appTop d)
    rw [← lift_fst (pairPullbackFst a b) (pairPullbackSnd a b), Over.comp_left,
      Scheme.Hom.comp_appTop]
    rfl
  · obtain ⟨d, rfl⟩ := hc
    refine Or.inr ⟨d, ?_⟩
    change (pairPullbackSnd a b).left.appTop d = ι.left.appTop ((snd U V).left.appTop d)
    rw [← lift_snd (pairPullbackFst a b) (pairPullbackSnd a b), Over.comp_left,
      Scheme.Hom.comp_appTop]
    rfl

end Overlap

section Clopen

variable [IsUltrametricDist K] {X : AlgebraicSpace (Spec (CommRingCat.of K))}

/-- If `X` is separated, the preimage in an affine chart `d` of the image of a closed
bounded set of an affine chart `c` is closed. -/
theorem isClosed_preimage_image_of_bounded (hK : IsHenselianValuedField K) (hX : IsSeparated X)
    (c d : EtaleFiniteTypeChart K X) [IsAffine c.scheme.left] [IsAffine d.scheme.left]
    (B : Set (RingPoint K c.scheme K)) (hB : IsClosed[schemePointTopology K c.scheme K] B)
    (hbdd : ∀ g : AffineCoordinateRing K c.scheme, ∃ C : ℝ,
      ∀ p ∈ B, ‖affineSchemePointEquiv K c.scheme K p g‖ ≤ C) :
    IsClosed[schemePointTopology K d.scheme K] (d.pointMap ⁻¹' (c.pointMap '' B)) := by
  have := d.locallyOfFiniteType
  set a : (schemeYoneda _).obj c.scheme ⟶ X.presheaf := hom c.hom
  set b : (schemeYoneda _).obj d.scheme ⟶ X.presheaf := hom d.hom
  have := isAffine_pairPullback a b hX
  have e : d.pointMap ⁻¹' (c.pointMap '' B) =
      (fun w : RingPoint K (pairPullback a b) K => (w ≫ pairPullbackSnd a b : RingPoint K _ K)) ''
        ((fun w : RingPoint K (pairPullback a b) K =>
          (w ≫ pairPullbackFst a b : RingPoint K _ K)) ⁻¹' B) :=
    preimage_image_schemePointsMap a b B
  rw [e, PointTopology.schemePointTopology_eq_affine]
  rw [PointTopology.schemePointTopology_eq_affine] at hB
  have hcont := PointTopology.schemePointContinuity_proof K K _ _ (pairPullbackFst a b)
  rw [PointTopology.schemePointTopology_eq_affine, PointTopology.schemePointTopology_eq_affine]
    at hcont
  refine PointTopology.isClosed_image_of_locallyBounded hK (pairPullbackSnd a b)
    (etale_pairPullbackSnd a b c.isEtale) _ (hB.preimage hcont) fun v => ?_
  -- a bounded neighbourhood of `v`
  let eV := affineSchemePointHomeomorph K d.scheme K
  obtain ⟨N₀, hN₀, hvN₀, -, hN₀b⟩ :=
    PointTopology.exists_isClopen_bounded (eV v) (Filter.univ_mem)
  refine ⟨eV ⁻¹' N₀, eV.continuous.continuousAt.preimage_mem_nhds (hN₀.isOpen.mem_nhds hvN₀),
    fun z => ?_⟩
  let eW := affineSchemePointEquiv K (pairPullback a b) K
  let T : Set (AffineCoordinateRing K (pairPullback a b) →ₐ[K] K) :=
    {φ | ∃ w : RingPoint K (pairPullback a b) K, (w ≫ pairPullbackFst a b : RingPoint K _ K) ∈ B ∧
      (w ≫ pairPullbackSnd a b : RingPoint K _ K) ∈ eV ⁻¹' N₀ ∧ AlgPoint.toAlgHom (eW w) = φ}
  have hgen : ∀ x ∈ Set.range (pairPullbackFst a b).left.appTop ∪
      Set.range (pairPullbackSnd a b).left.appTop, ∃ C : ℝ, ∀ φ ∈ T, ‖φ x‖ ≤ C := by
    intro x hx
    rcases hx with ⟨g, rfl⟩ | ⟨h, rfl⟩
    · obtain ⟨C, hC⟩ := hbdd g
      refine ⟨C, ?_⟩
      rintro _ ⟨w, hwB, -, rfl⟩
      have hn := PointTopology.affineSchemePointEquiv_natural K K (pairPullbackFst a b) w
      have := congrArg (fun q : AlgPoint K (AffineCoordinateRing K c.scheme) K => q g) hn
      calc ‖AlgPoint.toAlgHom (eW w) ((pairPullbackFst a b).left.appTop g)‖
          = ‖affineSchemePointEquiv K c.scheme K (w ≫ pairPullbackFst a b) g‖ := congrArg norm this.symm
        _ ≤ C := hC _ hwB
    · obtain ⟨C, hC⟩ := hN₀b h
      refine ⟨C, ?_⟩
      rintro _ ⟨w, -, hwN, rfl⟩
      have hn := PointTopology.affineSchemePointEquiv_natural K K (pairPullbackSnd a b) w
      have := congrArg (fun q : AlgPoint K (AffineCoordinateRing K d.scheme) K => q h) hn
      calc ‖AlgPoint.toAlgHom (eW w) ((pairPullbackSnd a b).left.appTop h)‖
          = ‖affineSchemePointEquiv K d.scheme K (w ≫ pairPullbackSnd a b) h‖ := congrArg norm this.symm
        _ ≤ C := hC _ hwN
  obtain ⟨C, hC⟩ := PointTopology.bounded_of_mem_closure T _ hgen
    (mem_closure_pairPullback a b hX z)
  exact ⟨C, fun w hwB hwN => hC _ ⟨w, hwB, hwN, rfl⟩⟩

/-- **Totally disconnected** (Conrad, Proposition 5.4, printed p.15): over a henselian
valued field with ultrametric norm, the rational points of a separated, quasi-separated
algebraic space locally of finite type are totally disconnected for the étale-chart
topology. -/
theorem totallyDisconnectedSpace_etaleChartTopology (hK : IsHenselianValuedField K)
    (hX : IsQuasiSeparatedLocallyFiniteType K X) (hs : IsSeparated X) :
    @TotallyDisconnectedSpace _ (etaleChartTopology K X) := by
  let : TopologicalSpace (RingPoints K X K) := etaleChartTopology K X
  have : T2Space (RingPoints K X K) := t2Space_etaleChartTopology hK hX hs
  have key : ∀ (x : RingPoints K X K) (O : Set (RingPoints K X K)), IsOpen O → x ∈ O →
      ∃ C : Set (RingPoints K X K), IsClopen C ∧ x ∈ C ∧ C ⊆ O := by
    intro x O hO hxO
    obtain ⟨c, u, hc, rfl⟩ := exists_affine_chart_pointMap_eq hX.1 hX.2 x
    have := c.locallyOfFiniteType
    let eU := affineSchemePointHomeomorph K c.scheme K
    have hN' : IsOpen[schemePointTopology K c.scheme K] (c.pointMap ⁻¹' O) :=
      @Continuous.isOpen_preimage _ _ (schemePointTopology K c.scheme K) (etaleChartTopology K X)
        _ c.continuous_pointMap O hO
    rw [PointTopology.schemePointTopology_eq_affine] at hN'
    obtain ⟨B₀, hB₀, huB₀, hB₀N, hB₀b⟩ := PointTopology.exists_isClopen_bounded (eU u)
      (N := eU '' (c.pointMap ⁻¹' O)) ((eU.isOpenMap _ hN').mem_nhds ⟨u, hxO, rfl⟩)
    let B : Set (RingPoint K c.scheme K) := eU ⁻¹' B₀
    have hBc : IsClopen B := hB₀.preimage eU.continuous
    have hBsub : B ⊆ c.pointMap ⁻¹' O := fun p hp => by
      obtain ⟨q, hq, hqe⟩ := hB₀N hp
      rwa [eU.injective hqe] at hq
    have hBbdd : ∀ g : AffineCoordinateRing K c.scheme, ∃ C : ℝ,
        ∀ p ∈ B, ‖affineSchemePointEquiv K c.scheme K p g‖ ≤ C := fun g => by
      obtain ⟨C, hC⟩ := hB₀b g
      exact ⟨C, fun p hp => hC _ hp⟩
    have hBcl : IsClosed[schemePointTopology K c.scheme K] B := by
      rw [PointTopology.schemePointTopology_eq_affine]
      exact hBc.isClosed
    have hBop : IsOpen[schemePointTopology K c.scheme K] B := by
      rw [PointTopology.schemePointTopology_eq_affine]
      exact hBc.isOpen
    refine ⟨c.pointMap '' B, ⟨?_, c.isOpenMap_pointMap hK B hBop⟩, ⟨u, huB₀, rfl⟩,
      Set.image_subset_iff.mpr hBsub⟩
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro z hz
    obtain ⟨e, v, he, rfl⟩ := exists_affine_chart_pointMap_eq hX.1 hX.2 z
    have hcl := isClosed_preimage_image_of_bounded hK hs c e B hBcl hBbdd
    refine ⟨e.pointMap '' (e.pointMap ⁻¹' (c.pointMap '' B))ᶜ, ?_,
      e.isOpenMap_pointMap hK _ hcl.isOpen_compl, ⟨v, hz, rfl⟩⟩
    rintro _ ⟨m, hm, rfl⟩ hmem
    exact hm hmem
  have : TotallySeparatedSpace (RingPoints K X K) :=
    totallySeparatedSpace_iff_exists_isClopen.mpr fun x y hxy => by
      obtain ⟨O, P, hO, hP, hxO, hyP, hOP⟩ := t2_separation hxy
      obtain ⟨C, hC, hxC, hCO⟩ := key x O hO hxO
      exact ⟨C, hC, hxC, fun hyC => Set.disjoint_left.mp hOP (hCO hyC) hyP⟩
  infer_instance

end Clopen

end Langlands.AlgebraicGeometry.AlgebraicSpace
