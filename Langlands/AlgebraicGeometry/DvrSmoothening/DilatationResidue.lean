import Langlands.AlgebraicGeometry.DvrSmoothening.DilatationCentre

/-! # Generators of a smooth centre, from the residue field to the base -/

open scoped TensorProduct

universe u

namespace Langlands.AlgebraicGeometry.DvrSmoothening

section BaseKaehler

variable (R S : Type*) {A B : Type*} (L : Type*) [CommRing R] [CommRing S] [CommRing A]
  [CommRing B] [CommRing L] [Algebra R S] [Algebra R A] [Algebra A B] [Algebra S B] [Algebra R B]
  [IsScalarTower R A B] [IsScalarTower R S B] [SMulCommClass S A B]
  [Algebra B L] [Algebra A L] [IsScalarTower A B L]

/-- The map `L ⊗_A Ω_{A/R} → L ⊗_B Ω_{B/S}` induced by a commutative square of rings. -/
noncomputable def tensorKaehlerMapBase : L ⊗[A] Ω[A⁄R] →ₗ[L] L ⊗[B] Ω[B⁄S] :=
  TensorProduct.AlgebraTensorModule.lTensor L L
      ((TensorProduct.isBaseChange A Ω[A⁄R] B).lift (KaehlerDifferential.map R S A B)) ∘ₗ
    (TensorProduct.AlgebraTensorModule.cancelBaseChange A B L L Ω[A⁄R]).symm.toLinearMap

theorem tensorKaehlerMapBase_tmul_D (l : L) (a : A) :
    tensorKaehlerMapBase R S L (l ⊗ₜ[A] KaehlerDifferential.D R A a) =
      l ⊗ₜ[B] KaehlerDifferential.D S B (algebraMap A B a) := by
  simp only [tensorKaehlerMapBase, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
    TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
    TensorProduct.AlgebraTensorModule.lTensor_tmul]
  congr 1
  have := (TensorProduct.isBaseChange A Ω[A⁄R] B).lift_eq (KaehlerDifferential.map R S A B)
    (KaehlerDifferential.D R A a)
  simpa using this

end BaseKaehler

/-- **Local generators of the centre over the base.** Let `R` be a discrete valuation ring with
uniformizer `ϖ` and residue field `k`, `B` a formally smooth `k`-algebra, regarded as an
`R`-algebra through `R → k → B`, `P = R[X₁, …, X_N]`, and `β₀ : P → B` a surjective homomorphism of
`R`-algebras. Let `K` be a field with `P → K` factoring through `B`. If finitely many elements
`yᵢ ∈ ker β₀` have differentials spanning those of all elements of `ker β₀` in `K ⊗_P Ω_{P/R}`,
then every `j ∈ ker β₀` has a multiple `s j`, with `s` of non-zero image in `K`, in the ideal
generated by `ϖ` and the `yᵢ`. -/
theorem exists_mul_mem_span_of_residue {R : Type u} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] {ϖ : R} (hϖ : Irreducible ϖ) {N : ℕ} {B K : Type u} [CommRing B]
    [Algebra R B] [Algebra (IsLocalRing.ResidueField R) B]
    [IsScalarTower R (IsLocalRing.ResidueField R) B]
    [Algebra.FormallySmooth (IsLocalRing.ResidueField R) B] [Field K]
    [Algebra (MvPolynomial (Fin N) R) K]
    (β0 : MvPolynomial (Fin N) R →ₐ[R] B) (hβ0 : Function.Surjective β0) (κB : B →+* K)
    (hκ : ∀ p, algebraMap (MvPolynomial (Fin N) R) K p = κB (β0 p))
    {ι : Type*} [Fintype ι] (y : ι → MvPolynomial (Fin N) R) (hy : ∀ i, β0 (y i) = 0)
    (hspan : ∀ j, β0 j = 0 →
      (1 : K) ⊗ₜ[MvPolynomial (Fin N) R] KaehlerDifferential.D R _ j ∈
        Submodule.span K (Set.range fun i =>
          (1 : K) ⊗ₜ[MvPolynomial (Fin N) R] KaehlerDifferential.D R _ (y i)))
    (j : MvPolynomial (Fin N) R) (hj : β0 j = 0) :
    ∃ s, algebraMap (MvPolynomial (Fin N) R) K s ≠ 0 ∧
      s * j ∈ Ideal.span {algebraMap R (MvPolynomial (Fin N) R) ϖ} ⊔ Ideal.span (Set.range y) := by
  classical
  let Pb := MvPolynomial (Fin N) (IsLocalRing.ResidueField R)
  let red : MvPolynomial (Fin N) R →+* Pb := MvPolynomial.map (IsLocalRing.residue R)
  letI : Algebra (MvPolynomial (Fin N) R) Pb := red.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin N) R) Pb := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R Pb r = red (algebraMap R (MvPolynomial (Fin N) R) r)
    rw [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq, MvPolynomial.map_C,
      IsLocalRing.ResidueField.algebraMap_eq]
  have : SMulCommClass (IsLocalRing.ResidueField R) (MvPolynomial (Fin N) R) Pb := ⟨fun a b c => by
    simp only [Algebra.smul_def]; ring⟩
  let βb : Pb →ₐ[IsLocalRing.ResidueField R] B := MvPolynomial.aeval fun i => β0 (MvPolynomial.X i)
  have hβred : ∀ p, βb (red p) = β0 p := by
    intro p
    have : (βb.toRingHom).comp red = β0.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change MvPolynomial.aeval (fun i => β0 (MvPolynomial.X i))
          (MvPolynomial.map (IsLocalRing.residue R) (MvPolynomial.C r)) = β0 (MvPolynomial.C r)
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C, ← IsLocalRing.ResidueField.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      · intro i
        change MvPolynomial.aeval (fun i => β0 (MvPolynomial.X i))
          (MvPolynomial.map (IsLocalRing.residue R) (MvPolynomial.X i)) = β0 (MvPolynomial.X i)
        rw [MvPolynomial.map_X, MvPolynomial.aeval_X]
    exact RingHom.congr_fun this p
  have hβsurj : Function.Surjective βb := fun b => by
    obtain ⟨p, rfl⟩ := hβ0 b
    exact ⟨red p, hβred p⟩
  letI : Algebra Pb K := (κB.comp βb.toRingHom).toAlgebra
  have : IsScalarTower (MvPolynomial (Fin N) R) Pb K := IsScalarTower.of_algebraMap_eq fun p => by
    change algebraMap (MvPolynomial (Fin N) R) K p = κB (βb (red p))
    rw [hβred, hκ]
  set Jb := RingHom.ker βb with hJbdef
  have : Algebra.FormallySmooth (IsLocalRing.ResidueField R) (Pb ⧸ Jb) :=
    Algebra.FormallySmooth.of_equiv (Ideal.quotientKerAlgEquivOfSurjective hβsurj).symm
  have hJb : Jb ≤ RingHom.ker (algebraMap Pb K) := by
    intro x hx
    rw [RingHom.mem_ker] at hx ⊢
    change κB (βb x) = 0
    rw [hx, map_zero]
  have : Module.Finite Pb Ω[Pb⁄IsLocalRing.ResidueField R] :=
    Module.Finite.of_basis (KaehlerDifferential.mvPolynomialBasis (IsLocalRing.ResidueField R) (Fin N))
  have hyb : ∀ i, red (y i) ∈ Jb := fun i => by
    rw [RingHom.mem_ker, hβred, hy]
  have hred_surj : Function.Surjective red :=
    MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
  have hspanb : ∀ jb ∈ Jb, (1 : K) ⊗ₜ[Pb] KaehlerDifferential.D (IsLocalRing.ResidueField R) Pb jb ∈
      Submodule.span K (Set.range fun i =>
        (1 : K) ⊗ₜ[Pb] KaehlerDifferential.D (IsLocalRing.ResidueField R) Pb (red (y i))) := by
    intro jb hjb
    obtain ⟨p, rfl⟩ := hred_surj jb
    have hp : β0 p = 0 := by rw [← hβred]; exact hjb
    have := Submodule.mem_map_of_mem
      (f := tensorKaehlerMapBase R (IsLocalRing.ResidueField R) K (A := MvPolynomial (Fin N) R)
        (B := Pb)) (hspan p hp)
    rw [Submodule.map_span, ← Set.range_comp, tensorKaehlerMapBase_tmul_D] at this
    convert this using 3
    funext i
    rw [Function.comp_apply, tensorKaehlerMapBase_tmul_D]
    rfl
  obtain ⟨sb, hsb, hmem⟩ := exists_mul_mem_span_of_formallySmooth Jb hJb (fun i => red (y i))
    hyb hspanb (red j) (by rw [RingHom.mem_ker, hβred, hj])
  obtain ⟨s, rfl⟩ := hred_surj sb
  refine ⟨s, ?_, ?_⟩
  · rwa [IsScalarTower.algebraMap_apply (MvPolynomial (Fin N) R) Pb K]
  · have hmap : red (s * j) ∈ (Ideal.span (Set.range y)).map red := by
      rw [Ideal.map_span, ← Set.range_comp, map_mul]
      exact hmem
    obtain ⟨x, hx, hxe⟩ := (Ideal.mem_map_iff_of_surjective red hred_surj).mp hmap
    have hker : s * j - x ∈ RingHom.ker red := by
      rw [RingHom.mem_ker, map_sub, hxe, sub_self]
    have hkerC : RingHom.ker red = Ideal.span {algebraMap R (MvPolynomial (Fin N) R) ϖ} := by
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hϖ.maximalIdeal_eq, Ideal.map_span,
        Set.image_singleton, MvPolynomial.algebraMap_eq]
    rw [hkerC] at hker
    have : s * j = (s * j - x) + x := by ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mem_sup_left hker) (Ideal.mem_sup_right hx)

end Langlands.AlgebraicGeometry.DvrSmoothening
