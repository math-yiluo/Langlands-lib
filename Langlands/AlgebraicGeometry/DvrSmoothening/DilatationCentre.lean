import Langlands.AlgebraicGeometry.DvrSmoothening.DilatationPresentation
import Langlands.AlgebraicGeometry.DvrSmoothening.JacobianPoint
import Mathlib.RingTheory.TotallySplit

/-! # Local generators of a smooth centre -/

open scoped TensorProduct

universe u

namespace Langlands.AlgebraicGeometry.DvrSmoothening

/-- **Local generators of the ideal of a smooth subscheme.** Let `P` be a formally smooth noetherian
algebra over a field `k` with finite free differentials, `J ⊆ P` an ideal with `P ⧸ J` formally
smooth over `k`, and `K` a field which is a `P`-algebra killing `J`. If finitely many elements
`yᵢ ∈ J` have differentials spanning the differentials of all elements of `J` in
`K ⊗_P Ω_{P/k}`, then the `yᵢ` generate `J` locally at the kernel of `P → K`: every `j ∈ J` has a
multiple `s j`, with `s` not in this kernel, in the ideal generated by the `yᵢ`. -/
theorem exists_mul_mem_span_of_formallySmooth {k P K : Type u} [Field k] [CommRing P]
    [Algebra k P] [Algebra.FormallySmooth k P] [Module.Free P Ω[P⁄k]] [Module.Finite P Ω[P⁄k]]
    [IsNoetherianRing P] [Field K] [Algebra P K]
    (J : Ideal P) [Algebra.FormallySmooth k (P ⧸ J)] (hJ : J ≤ RingHom.ker (algebraMap P K))
    {ι : Type*} [Fintype ι] (y : ι → P) (hy : ∀ i, y i ∈ J)
    (hspan : ∀ j ∈ J, (1 : K) ⊗ₜ[P] KaehlerDifferential.D k P j ∈
      Submodule.span K (Set.range fun i => (1 : K) ⊗ₜ[P] KaehlerDifferential.D k P (y i)))
    (j : P) (hj : j ∈ J) :
    ∃ s : P, algebraMap P K s ≠ 0 ∧ s * j ∈ Ideal.span (Set.range y) := by
  classical
  set 𝔭 := RingHom.ker (algebraMap P K) with h𝔭
  have : 𝔭.IsPrime := RingHom.ker_isPrime _
  let P' := Localization.AtPrime 𝔭
  have hunit : ∀ s : 𝔭.primeCompl, IsUnit (algebraMap P K s) := fun s =>
    isUnit_iff_ne_zero.mpr fun h => s.2 h
  letI : Algebra P' K := (IsLocalization.lift (M := 𝔭.primeCompl) (S := P') hunit).toAlgebra
  have : IsScalarTower P P' K := IsScalarTower.of_algebraMap_eq fun x =>
    (IsLocalization.lift_eq (M := 𝔭.primeCompl) (S := P') hunit x).symm
  set J' : Ideal P' := J.map (algebraMap P P') with hJ'def
  have hJ'K : J' ≤ RingHom.ker (algebraMap P' K) := by
    rw [hJ'def, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, ← IsScalarTower.algebraMap_apply]
    exact hJ hx
  let S0 := P' ⧸ J'
  letI : Algebra S0 K := (Ideal.Quotient.lift J' (algebraMap P' K) hJ'K).toAlgebra
  have : IsScalarTower P' (P' ⧸ J') K :=
    IsScalarTower.of_algebraMap_eq (R := P') (S := P' ⧸ J') (A := K) fun x => rfl
  have hJ'top : J' ≠ ⊤ := fun h => by
    have : (1 : P') ∈ RingHom.ker (algebraMap P' K) := hJ'K (h ▸ Submodule.mem_top)
    simp at this
  have : Nontrivial S0 := Ideal.Quotient.nontrivial_iff.mpr hJ'top
  have : IsLocalRing S0 :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J') Ideal.Quotient.mk_surjective
  have : Algebra.FormallyEtale P P' := Algebra.FormallyEtale.of_isLocalization 𝔭.primeCompl
  have : Algebra.FormallySmooth k P' := Algebra.FormallySmooth.comp k P P'
  let e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P P'
  have : Module.Free P' Ω[P'⁄k] := .of_equiv e
  have : Module.Finite P' Ω[P'⁄k] := .of_surjective e.toLinearMap e.surjective
  -- `S0` is formally smooth over `k`
  have hS0 : Algebra.FormallySmooth k S0 := by
    letI : Algebra (P ⧸ J) S0 :=
      (Ideal.quotientMap (J.map (algebraMap P P')) (algebraMap P P') Ideal.le_comap_map).toAlgebra
    have hloc := isLocalization_quotient (A' := P') 𝔭.primeCompl J
    have : Algebra.FormallyEtale (P ⧸ J) S0 :=
      Algebra.FormallyEtale.of_isLocalization (𝔭.primeCompl.map (Ideal.Quotient.mk J))
    have : IsScalarTower k (P ⧸ J) S0 := IsScalarTower.of_algebraMap_eq fun x => by
      change Ideal.Quotient.mk J' (algebraMap k P' x) =
        Ideal.Quotient.mk J' (algebraMap P P' (algebraMap k P x))
      rw [← IsScalarTower.algebraMap_apply]
    exact Algebra.FormallySmooth.comp k (P ⧸ J) S0
  have h₁ : Function.Surjective (algebraMap P' S0) := Ideal.Quotient.mk_surjective
  have hker : RingHom.ker (algebraMap P' S0) = J' := Ideal.mk_ker
  have h₂ : (RingHom.ker (algebraMap P' S0)).FG := IsNoetherian.noetherian _
  have hmax : IsLocalRing.maximalIdeal P' ≤ RingHom.ker (algebraMap P' K) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭 P', Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, ← IsScalarTower.algebraMap_apply]
    exact hx
  have h₃ : IsLocalRing.maximalIdeal S0 ≤ RingHom.ker (algebraMap S0 K) := by
    intro x hx
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hy : y ∈ IsLocalRing.maximalIdeal P' := by
      by_contra h
      exact (IsLocalRing.mem_maximalIdeal _).mp hx ((IsLocalRing.notMem_maximalIdeal.mp h).map _)
    exact hmax hy
  have hinj := (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange (R := k) P' K
    h₁ h₂ h₃).mp hS0
  set Kr := RingHom.ker (algebraMap P' S0)
  let F := KaehlerDifferential.cotangentComplexBaseChange k S0 P' K
  let Ψ := tensorKaehlerMap k K (P := P) (S := P')
  have hmemKr : ∀ x ∈ J, algebraMap P P' x ∈ Kr := fun x hx => by
    rw [hker]; exact Ideal.mem_map_of_mem _ hx
  have hF : ∀ x (hx : x ∈ J), F ((1 : K) ⊗ₜ[P'] (⟨algebraMap P P' x, hmemKr x hx⟩ : Kr)) =
      Ψ ((1 : K) ⊗ₜ[P] KaehlerDifferential.D k P x) := by
    intro x hx
    simp only [F, Ψ, KaehlerDifferential.cotangentComplexBaseChange_tmul,
      KaehlerDifferential.kerToTensor_apply, one_smul, tensorKaehlerMap_tmul_D]
  set Y := Submodule.span K (Set.range fun i =>
    (1 : K) ⊗ₜ[P'] (⟨algebraMap P P' (y i), hmemKr _ (hy i)⟩ : Kr))
  -- the classes of elements of `J` lie in the span of the classes of the `yᵢ`
  have hcl : ∀ x (hx : x ∈ J), (1 : K) ⊗ₜ[P'] (⟨algebraMap P P' x, hmemKr x hx⟩ : Kr) ∈ Y := by
    intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp (hspan x hx)
    have : (1 : K) ⊗ₜ[P'] (⟨algebraMap P P' x, hmemKr x hx⟩ : Kr) =
        ∑ i, a i • (1 : K) ⊗ₜ[P'] (⟨algebraMap P P' (y i), hmemKr _ (hy i)⟩ : Kr) := by
      have h1 : F (∑ i, a i • (1 : K) ⊗ₜ[P'] (⟨algebraMap P P' (y i), hmemKr _ (hy i)⟩ : Kr)) =
          Ψ ((1 : K) ⊗ₜ[P] KaehlerDifferential.D k P x) := by
        rw [← ha, map_sum, map_sum]
        exact Finset.sum_congr rfl fun i _ => by rw [map_smul, map_smul, hF _ (hy i)]
      apply hinj
      rw [hF x hx, h1]
    rw [this]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  -- hence the classes of the `yᵢ` span `K ⊗ J'`
  have hYtop : ∀ z : K ⊗[P'] Kr, z ∈ Y := by
    intro z
    induction z using TensorProduct.inductionOn with
    | add z₁ z₂ h₁ h₂ => exact Y.add_mem h₁ h₂
    | tmul l g =>
      obtain ⟨g, hg⟩ := g
      have hg' : g ∈ J' := hker ▸ hg
      induction hg' using Submodule.span_induction generalizing l with
      | mem g hg'' =>
        obtain ⟨x, hx, rfl⟩ := hg''
        have : l ⊗ₜ[P'] (⟨algebraMap P P' x, hg⟩ : Kr) =
            l • ((1 : K) ⊗ₜ[P'] (⟨algebraMap P P' x, hmemKr x hx⟩ : Kr)) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [this]
        exact Y.smul_mem _ (hcl x hx)
      | zero =>
        have : l ⊗ₜ[P'] (⟨0, hg⟩ : Kr) = 0 := by
          rw [show (⟨0, hg⟩ : Kr) = 0 from rfl, TensorProduct.tmul_zero]
        rw [this]; exact Y.zero_mem
      | add g₁ g₂ hg₁ hg₂ ih₁ ih₂ =>
        have e₁ : g₁ ∈ Kr := hker ▸ hg₁
        have e₂ : g₂ ∈ Kr := hker ▸ hg₂
        have : l ⊗ₜ[P'] (⟨g₁ + g₂, hg⟩ : Kr) =
            l ⊗ₜ[P'] (⟨g₁, e₁⟩ : Kr) + l ⊗ₜ[P'] (⟨g₂, e₂⟩ : Kr) := by
          rw [← TensorProduct.tmul_add]; rfl
        rw [this]
        exact Y.add_mem (ih₁ l e₁) (ih₂ l e₂)
      | smul a g hg₁ ih =>
        have e₁ : g ∈ Kr := hker ▸ hg₁
        have : l ⊗ₜ[P'] (⟨a • g, hg⟩ : Kr) = (a • l) ⊗ₜ[P'] (⟨g, e₁⟩ : Kr) := by
          rw [TensorProduct.smul_tmul]; rfl
        rw [this]
        exact ih _ e₁
  -- Nakayama
  set Ys : Submodule P' Kr := Submodule.span P' (Set.range fun i =>
    (⟨algebraMap P P' (y i), hmemKr _ (hy i)⟩ : Kr))
  have hsubK : Subsingleton (K ⊗[P'] (Kr ⧸ Ys)) := by
    let q := TensorProduct.AlgebraTensorModule.lTensor K K Ys.mkQ
    have hq : Function.Surjective q := LinearMap.lTensor_surjective K Ys.mkQ_surjective
    have hqY : Y ≤ LinearMap.ker q := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have hz : Ys.mkQ (⟨algebraMap P P' (y i), hmemKr _ (hy i)⟩ : Kr) = 0 :=
        (Submodule.Quotient.mk_eq_zero Ys).mpr (Submodule.subset_span ⟨i, rfl⟩)
      rw [SetLike.mem_coe, LinearMap.mem_ker]
      simp [q, hz]
    refine ⟨fun a b => ?_⟩
    obtain ⟨a, rfl⟩ := hq a
    obtain ⟨b, rfl⟩ := hq b
    rw [hqY (hYtop a), hqY (hYtop b)]
  letI : Algebra (IsLocalRing.ResidueField P') K :=
    (Ideal.Quotient.lift (IsLocalRing.maximalIdeal P') (algebraMap P' K) hmax).toAlgebra
  have : IsScalarTower P' (IsLocalRing.ResidueField P') K :=
    IsScalarTower.of_algebraMap_eq fun x => rfl
  let ec := TensorProduct.AlgebraTensorModule.cancelBaseChange P' (IsLocalRing.ResidueField P') K K
    (Kr ⧸ Ys)
  have : Subsingleton (K ⊗[IsLocalRing.ResidueField P']
      (IsLocalRing.ResidueField P' ⊗[P'] (Kr ⧸ Ys))) := ec.toEquiv.subsingleton
  have hk : Subsingleton (IsLocalRing.ResidueField P' ⊗[P'] (Kr ⧸ Ys)) :=
    (Module.FaithfullyFlat.subsingleton_tensorProduct_iff_right _ K).mp this
  have : Module.Finite P' Kr := Module.IsNoetherian.finite P' _
  have : Subsingleton (Kr ⧸ Ys) := (IsLocalRing.subsingleton_tensorProduct).mp hk
  have hYs : Ys = ⊤ := Submodule.Quotient.subsingleton_iff.mp this
  -- conclusion
  have hjYs : (⟨algebraMap P P' j, hmemKr j hj⟩ : Kr) ∈ Ys := hYs ▸ Submodule.mem_top
  have hjmap : algebraMap P P' j ∈ (Ideal.span (Set.range y)).map (algebraMap P P') := by
    have := Submodule.mem_map_of_mem (f := Kr.subtype) hjYs
    rw [Submodule.map_span, ← Set.range_comp] at this
    rw [Ideal.map_span, ← Set.range_comp]
    exact this
  obtain ⟨⟨⟨a, ha⟩, s⟩, hs⟩ := (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl P').mp hjmap
  simp only at hs
  rw [← map_mul] at hs
  obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists 𝔭.primeCompl P').mp hs
  refine ⟨(t : P) * s, fun h => (𝔭.primeCompl.mul_mem t.2 s.2) h, ?_⟩
  have : (t : P) * s * j = t * a := by rw [← ht]; ring
  rw [this]
  exact Ideal.mul_mem_left _ _ ha

end Langlands.AlgebraicGeometry.DvrSmoothening
