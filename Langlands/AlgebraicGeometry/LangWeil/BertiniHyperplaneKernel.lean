import Langlands.AlgebraicGeometry.LangWeil.BertiniHyperplaneSeparable
import Langlands.AnthropicFLT.Theorems.Thm_Algebra_TensorProduct_nilradical_isPrime_of_isAlgebraic_of_forall_isSeparable_mem_range

/-!
# The kernel of the generic hyperplane evaluation

Let `k` be a field, `D` a domain over `k` and `g : Fin N → D`. Write `𝓛 = k(a_*, a_0, …)` and
`h = a_* ⊗ 1 + ∑ aᵢ ⊗ gᵢ ∈ 𝓛 ⊗[k] D`. With `ℱ = Frac(D)(x_0, …, x_{N-1})` and
`ξ = ∑ gᵢ xᵢ`, if two of the `gᵢ` are algebraically independent over `k`, the assignment
`a_* ↦ -ξ`, `aᵢ ↦ xᵢ`, `d ↦ d` defines a homomorphism `𝓛 ⊗[k] D → ℱ` whose kernel is the
ideal `(h)`. The module also proves two general criteria for the radical of a principal ideal
to be prime.
-/

noncomputable section

universe u

open MvPolynomial TensorProduct

namespace Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplane

/-- Two ring homomorphisms out of a polynomial ring that agree on constants differ, on every
polynomial, by an element of the ideal generated by their differences on the variables. -/
theorem sub_mem_span_of_ringHom {R S σ : Type*} [CommRing R] [CommRing S]
    (f₁ f₂ : MvPolynomial σ R →+* S) (hC : ∀ c, f₁ (C c) = f₂ (C c)) (p : MvPolynomial σ R) :
    f₁ p - f₂ p ∈ Ideal.span (Set.range fun i => f₁ (X i) - f₂ (X i)) := by
  set I := Ideal.span (Set.range fun i => f₁ (X i) - f₂ (X i))
  induction p using MvPolynomial.induction_on with
  | C a => rw [hC, sub_self]; exact I.zero_mem
  | add p q hp hq => rw [map_add, map_add, add_sub_add_comm]; exact I.add_mem hp hq
  | mul_X p i hp =>
    have : f₁ (p * X i) - f₂ (p * X i) =
        (f₁ p - f₂ p) * f₁ (X i) + f₂ p * (f₁ (X i) - f₂ (X i)) := by
      simp only [map_mul]; ring
    rw [this]
    exact I.add_mem (I.mul_mem_right _ hp) (I.mul_mem_left _ (Ideal.subset_span ⟨i, rfl⟩))

/-- If `Φ : S → T` kills `y`, its kernel lies in `(y)`, and the nilradical of `T` is prime,
then the radical of `(y)` is prime: it is the preimage of the nilradical of `T`. -/
theorem radical_span_singleton_isPrime_of_ker {S T : Type*} [CommRing S] [CommRing T]
    (Φ : S →+* T) {y : S} (hy : Φ y = 0) (hker : ∀ s, Φ s = 0 → s ∈ Ideal.span {y})
    (hT : (nilradical T).IsPrime) : (Ideal.span {y}).radical.IsPrime := by
  have h : (Ideal.span {y}).radical = (nilradical T).comap Φ := by
    ext s
    rw [Ideal.mem_comap, mem_nilradical]
    constructor
    · rintro ⟨m, hm⟩
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hm
      exact ⟨m, by rw [← map_pow, ← ha, map_mul, hy, mul_zero]⟩
    · rintro ⟨m, hm⟩
      exact ⟨m, hker _ (by rw [map_pow, hm])⟩
  rw [h]
  exact Ideal.comap_isPrime Φ (nilradical T)

/-- Primality of the radical of a principal ideal descends along a surjection whose kernel
consists of nilpotent elements. -/
theorem radical_span_singleton_isPrime_of_surjective {R S : Type*} [CommRing R] [CommRing S]
    (χ : R →+* S) (hχ : Function.Surjective χ) (hker : RingHom.ker χ ≤ nilradical R) {x : R}
    (h : (Ideal.span {χ x}).radical.IsPrime) : (Ideal.span {x}).radical.IsPrime := by
  have e : (Ideal.span {x}).radical = (Ideal.span {χ x}).radical.comap χ := by
    ext r
    rw [Ideal.mem_comap]
    constructor
    · rintro ⟨m, hm⟩
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hm
      exact ⟨m, Ideal.mem_span_singleton'.mpr ⟨χ a, by rw [← map_pow, ← ha, map_mul]⟩⟩
    · rintro ⟨m, hm⟩
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hm
      obtain ⟨a, rfl⟩ := hχ b
      have hz : r ^ m - a * x ∈ RingHom.ker χ := by
        rw [RingHom.mem_ker, map_sub, map_mul, map_pow, hb, sub_self]
      have hz' : r ^ m - a * x ∈ (Ideal.span {x}).radical :=
        Ideal.radical_mono bot_le (hker hz)
      have hax : a * x ∈ (Ideal.span {x}).radical :=
        Ideal.le_radical (Ideal.mul_mem_left _ a (Ideal.subset_span rfl))
      have hrm : r ^ m ∈ (Ideal.span {x}).radical := by
        simpa using Ideal.add_mem _ hz' hax
      exact Ideal.mem_radical_of_pow_mem hrm
  rw [e]
  exact Ideal.comap_isPrime χ _

/-- Clearing denominators in `Frac(R) ⊗ B`: every element becomes, after multiplication by a
nonzero element of `R`, the image of an element of `R ⊗ B`. -/
theorem exists_tmul_mul_eq_map {k R Fr B : Type*} [CommRing k] [CommRing R] [IsDomain R]
    [Field Fr] [Algebra R Fr] [IsFractionRing R Fr] [CommRing B] [Algebra k R] [Algebra k Fr]
    [IsScalarTower k R Fr] [Algebra k B] (z : Fr ⊗[k] B) :
    ∃ q : R, q ≠ 0 ∧ ∃ w : R ⊗[k] B, (algebraMap R Fr q ⊗ₜ[k] (1 : B)) * z =
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom k R Fr) (AlgHom.id k B) w := by
  have e : ∀ q : R, Algebra.TensorProduct.map (IsScalarTower.toAlgHom k R Fr) (AlgHom.id k B)
      (q ⊗ₜ[k] (1 : B)) = algebraMap R Fr q ⊗ₜ[k] (1 : B) := fun q => by simp
  induction z with
  | tmul a b =>
    obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := R) a
    refine ⟨q, nonZeroDivisors.ne_zero hq, p ⊗ₜ b, ?_⟩
    have hq' : algebraMap R Fr q ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, Algebra.TensorProduct.map_tmul,
      mul_div_cancel₀ _ hq']
    simp
  | add z₁ z₂ h₁ h₂ =>
    obtain ⟨q₁, hq₁, w₁, hw₁⟩ := h₁
    obtain ⟨q₂, hq₂, w₂, hw₂⟩ := h₂
    refine ⟨q₁ * q₂, mul_ne_zero hq₁ hq₂, (q₂ ⊗ₜ 1) * w₁ + (q₁ ⊗ₜ 1) * w₂, ?_⟩
    have e₁ : algebraMap R Fr (q₁ * q₂) ⊗ₜ[k] (1 : B) =
        (algebraMap R Fr q₁ ⊗ₜ[k] (1 : B)) * (algebraMap R Fr q₂ ⊗ₜ[k] (1 : B)) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, map_mul]
    rw [e₁, map_add, map_mul, map_mul, e, e, ← hw₁, ← hw₂]
    ring

/-- The generic hyperplane equation `a_* ⊗ 1 + ∑ aᵢ ⊗ gᵢ` in `k(a_*, a_0, …) ⊗[k] B`. -/
def hyperplaneEq (k : Type*) [Field k] {B : Type*} [CommRing B] [Algebra k B] {N : ℕ}
    (g : Fin N → B) : FractionRing (MvPolynomial (Option (Fin N)) k) ⊗[k] B :=
  algebraMap (MvPolynomial (Option (Fin N)) k) (FractionRing (MvPolynomial (Option (Fin N)) k))
      (X none) ⊗ₜ[k] (1 : B) +
    ∑ i : Fin N, algebraMap (MvPolynomial (Option (Fin N)) k)
      (FractionRing (MvPolynomial (Option (Fin N)) k)) (X (some i)) ⊗ₜ[k] g i

section Core

variable (k : Type u) [Field k] {D : Type u} [CommRing D] [Algebra k D] {N : ℕ}
  (g : Fin N → D)

local notation "𝒦" => FractionRing D
local notation "𝒬" => MvPolynomial (Fin N) (FractionRing D)
local notation "ℱ" => FractionRing (MvPolynomial (Fin N) (FractionRing D))
local notation "𝒫" => MvPolynomial (Option (Fin N)) k
local notation "𝓛" => FractionRing (MvPolynomial (Option (Fin N)) k)

variable [IsDomain D]

/-- The generic linear form `ξ = ∑ gᵢ xᵢ` in `ℱ = Frac(D)(x_0, …, x_{N-1})`. -/
def linearForm : ℱ :=
  ∑ i, algebraMap 𝒦 ℱ (algebraMap D 𝒦 (g i)) * algebraMap 𝒬 ℱ (X i)

/-- The map `D[x] → ℱ` extending `D → Frac(D)`. -/
def polyMap : MvPolynomial (Fin N) D →ₐ[k] ℱ :=
  (IsScalarTower.toAlgHom k 𝒬 ℱ).comp (MvPolynomial.mapAlgHom (IsScalarTower.toAlgHom k D 𝒦))

omit [IsDomain D] in
theorem polyMap_injective : Function.Injective (polyMap k (D := D) (N := N)) :=
  (IsFractionRing.injective 𝒬 ℱ).comp
    (MvPolynomial.map_injective _ (IsFractionRing.injective D 𝒦))

omit [IsDomain D] in
theorem polyMap_C (d : D) :
    polyMap k (N := N) (C d) = algebraMap 𝒦 ℱ (algebraMap D 𝒦 d) := by
  simp [polyMap, IsScalarTower.algebraMap_apply 𝒦 𝒬 ℱ, MvPolynomial.algebraMap_eq]

omit [IsDomain D] in
theorem polyMap_X (i : Fin N) :
    polyMap k (D := D) (X i) = algebraMap 𝒬 ℱ (X i) := by
  simp [polyMap]

/-- The inclusion `D → ℱ`. -/
def coeffHom : D →ₐ[k] ℱ :=
  (polyMap k (D := D) (N := N)).comp (IsScalarTower.toAlgHom k D (MvPolynomial (Fin N) D))

omit [IsDomain D] in
theorem coeffHom_apply (d : D) :
    coeffHom k (N := N) d = algebraMap 𝒦 ℱ (algebraMap D 𝒦 d) := by
  simp [coeffHom, MvPolynomial.algebraMap_eq, polyMap_C]

/-- The evaluation `a_* ↦ -ξ`, `aᵢ ↦ xᵢ` of the parameter polynomial ring in `ℱ`. -/
def paramEval₀ : 𝒫 →ₐ[k] ℱ :=
  aeval fun o => o.elim (-linearForm g) fun i => algebraMap 𝒬 ℱ (X i)

/-- If two entries of `g` are algebraically independent over `k`, then so are the coordinates
`xᵢ` and `-ξ` in `ℱ`. -/
theorem paramEval₀_injective {j l : Fin N}
    (hjl : AlgebraicIndependent k ![algebraMap D 𝒦 (g j), algebraMap D 𝒦 (g l)]) :
    Function.Injective (paramEval₀ k g) := by
  classical
  have h0 := algebraicIndependent_option_linearForm (k := k) (fun i => algebraMap D 𝒦 (g i)) hjl
  have h1 := h0.comp (Option.map some) (Option.map_injective (Option.some_injective _))
  have h2 : AlgebraicIndependent k (fun o : Option (Fin N) =>
      o.elim (∑ i, C (algebraMap D 𝒦 (g i)) * X i : 𝒬) X) := by
    convert h1 using 1
    funext o
    cases o <;> rfl
  have h3 := h2.map' (f := IsScalarTower.toAlgHom k 𝒬 ℱ) (IsFractionRing.injective _ _)
  have h4 : AlgebraicIndependent k (fun o : Option (Fin N) =>
      o.elim (linearForm g) fun i => algebraMap 𝒬 ℱ (X i)) := by
    convert h3 using 1
    funext o
    cases o <;> simp [linearForm, IsScalarTower.algebraMap_apply 𝒦 𝒬 ℱ, MvPolynomial.algebraMap_eq]
  obtain ⟨hx, htr⟩ := AlgebraicIndependent.option_iff.mp h4
  have h5 : AlgebraicIndependent k (fun o : Option (Fin N) =>
      o.elim (-linearForm g) fun i => algebraMap 𝒬 ℱ (X i)) :=
    AlgebraicIndependent.option_iff.mpr ⟨hx, fun h => htr (by simpa using h.neg)⟩
  exact h5

variable {k g} in
/-- The field embedding `𝓛 → ℱ`, `a_* ↦ -ξ`, `aᵢ ↦ xᵢ`. -/
def paramEval (hψ : Function.Injective (paramEval₀ k g)) : 𝓛 →ₐ[k] ℱ :=
  IsFractionRing.liftAlgHom hψ

variable {k g} in
theorem paramEval_algebraMap (hψ : Function.Injective (paramEval₀ k g)) (p : 𝒫) :
    paramEval hψ (algebraMap 𝒫 𝓛 p) = paramEval₀ k g p := by
  simp [paramEval]

variable {k g} in
/-- The homomorphism `𝓛 ⊗[k] D → ℱ`, `a_* ↦ -ξ`, `aᵢ ↦ xᵢ`, `d ↦ d`. -/
def tensorEval (hψ : Function.Injective (paramEval₀ k g)) : 𝓛 ⊗[k] D →ₐ[k] ℱ :=
  Algebra.TensorProduct.lift (paramEval hψ) (coeffHom k) fun _ _ => Commute.all _ _

variable {k g} in
theorem tensorEval_hyperplaneEq (hψ : Function.Injective (paramEval₀ k g)) :
    tensorEval hψ (hyperplaneEq k g) = 0 := by
  simp [tensorEval, hyperplaneEq, paramEval_algebraMap, paramEval₀, coeffHom_apply, linearForm,
    mul_comm]

/-- The evaluation `𝒫 ⊗[k] D → D[x]`, `a_* ↦ -∑ gᵢ xᵢ`, `aᵢ ↦ xᵢ`. -/
def polyEval : 𝒫 ⊗[k] D →ₐ[k] MvPolynomial (Fin N) D :=
  Algebra.TensorProduct.lift (aeval fun o => o.elim (-∑ i, C (g i) * X i) X)
    (IsScalarTower.toAlgHom k D (MvPolynomial (Fin N) D)) fun _ _ => Commute.all _ _

/-- The section `D[x] → 𝒫 ⊗[k] D`, `xᵢ ↦ aᵢ ⊗ 1`. -/
def polySection : MvPolynomial (Fin N) D →+* 𝒫 ⊗[k] D :=
  eval₂Hom (Algebra.TensorProduct.includeRight : D →ₐ[k] 𝒫 ⊗[k] D).toRingHom
    fun i => X (some i) ⊗ₜ[k] (1 : D)

omit [IsDomain D] in
/-- Every element of `𝒫 ⊗[k] D` agrees with the section of its evaluation modulo the polynomial
hyperplane equation. -/
theorem sub_polySection_mem (w : 𝒫 ⊗[k] D) :
    w - polySection k (polyEval k g w) ∈ Ideal.span
      {(X none ⊗ₜ[k] (1 : D) + ∑ i, X (some i) ⊗ₜ[k] g i : 𝒫 ⊗[k] D)} := by
  set I := Ideal.span {(X none ⊗ₜ[k] (1 : D) + ∑ i, X (some i) ⊗ₜ[k] g i : 𝒫 ⊗[k] D)}
  have hP : ∀ p : 𝒫, p ⊗ₜ[k] (1 : D) - polySection k
      (aeval (fun o => o.elim (-∑ i, C (g i) * X i) X) p) ∈ I := by
    intro p
    let f₁ : 𝒫 →+* 𝒫 ⊗[k] D := (Algebra.TensorProduct.includeLeft : 𝒫 →ₐ[k] 𝒫 ⊗[k] D).toRingHom
    let f₂ : 𝒫 →+* 𝒫 ⊗[k] D := (polySection k (D := D) (N := N)).comp
      (aeval (fun o => o.elim (-∑ i, C (g i) * X i) X) : 𝒫 →ₐ[k] _).toRingHom
    have hC : ∀ c, f₁ (C c) = f₂ (C c) := by
      intro c
      simp [f₁, f₂, polySection, MvPolynomial.algebraMap_eq]
    have h := sub_mem_span_of_ringHom f₁ f₂ hC p
    refine Ideal.span_le.mpr ?_ h
    rintro _ ⟨o, rfl⟩
    cases o with
    | none =>
      apply Ideal.subset_span
      simp [f₁, f₂, polySection, Algebra.TensorProduct.tmul_mul_tmul]
    | some i => simp [f₁, f₂, polySection]
  induction w with
  | add w₁ w₂ h₁ h₂ =>
    rw [map_add, map_add, add_sub_add_comm]
    exact I.add_mem h₁ h₂
  | tmul p d =>
    have hd : polySection k (algebraMap D (MvPolynomial (Fin N) D) d) = (1 : 𝒫) ⊗ₜ[k] d := by
      simp [polySection, MvPolynomial.algebraMap_eq]
    have hev : polyEval k g (p ⊗ₜ[k] d) = aeval (fun o => o.elim (-∑ i, C (g i) * X i) X) p *
        algebraMap D (MvPolynomial (Fin N) D) d := by
      simp [polyEval]
    have e : p ⊗ₜ[k] d - polySection k (polyEval k g (p ⊗ₜ[k] d)) =
        (p ⊗ₜ[k] (1 : D) - polySection k
          (aeval (fun o => o.elim (-∑ i, C (g i) * X i) X) p)) * ((1 : 𝒫) ⊗ₜ[k] d) := by
      rw [hev, map_mul, hd, sub_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [e]
    exact I.mul_mem_right _ (hP p)

variable {k g} in
theorem tensorEval_comp_map (hψ : Function.Injective (paramEval₀ k g)) :
    (tensorEval hψ).comp
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k 𝒫 𝓛) (AlgHom.id k D)) =
      (polyMap k).comp (polyEval k g) := by
  apply Algebra.TensorProduct.ext
  · apply MvPolynomial.algHom_ext
    intro o
    cases o with
    | none =>
      simp [tensorEval, polyEval, paramEval_algebraMap, paramEval₀, linearForm, polyMap_C,
        polyMap_X]
    | some i =>
      simp [tensorEval, polyEval, paramEval_algebraMap, paramEval₀, polyMap_X]
  · ext d
    simp [tensorEval, polyEval, coeffHom]

variable {k g} in
/-- The kernel of `𝓛 ⊗[k] D → ℱ` is the ideal generated by the hyperplane equation. -/
theorem tensorEval_eq_zero_iff (hψ : Function.Injective (paramEval₀ k g)) (z : 𝓛 ⊗[k] D) :
    tensorEval hψ z = 0 ↔ z ∈ Ideal.span {hyperplaneEq k g} := by
  constructor
  · intro hz
    obtain ⟨q, hq, w, hw⟩ := exists_tmul_mul_eq_map (R := 𝒫) (Fr := 𝓛) (k := k) (B := D) z
    have hw0 : polyEval k g w = 0 := by
      apply polyMap_injective k
      rw [map_zero, ← AlgHom.comp_apply, ← tensorEval_comp_map hψ, AlgHom.comp_apply, ← hw,
        map_mul, hz, mul_zero]
    have hwI := sub_polySection_mem k g w
    rw [hw0, map_zero, sub_zero] at hwI
    have hmap : Algebra.TensorProduct.map (IsScalarTower.toAlgHom k 𝒫 𝓛) (AlgHom.id k D) w ∈
        Ideal.span {hyperplaneEq k g} := by
      have := Ideal.mem_map_of_mem
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k 𝒫 𝓛) (AlgHom.id k D)) hwI
      rw [Ideal.map_span, Set.image_singleton] at this
      convert this using 3
      simp [hyperplaneEq, map_sum]
    rw [← hw] at hmap
    have hu : IsUnit (algebraMap 𝒫 𝓛 q ⊗ₜ[k] (1 : D)) := by
      have h1 : IsUnit (algebraMap 𝓛 (𝓛 ⊗[k] D) (algebraMap 𝒫 𝓛 q)) :=
        (isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective 𝒫 𝓛)).mpr hq)).map _
      simpa [Algebra.TensorProduct.algebraMap_apply] using h1
    exact (Ideal.unit_mul_mem_iff_mem _ hu).mp hmap
  · intro hz
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    rw [map_mul, tensorEval_hyperplaneEq, mul_zero]

end Core

end Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplane
