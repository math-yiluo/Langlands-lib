import Mathlib
import Langlands.AnthropicFLT.Theorems.Thm_IntermediateField_mem_adjoin_sum_mul_of_isSeparable_of_algebraicIndependent
import Langlands.AnthropicFLT.P2M.Sol.S_Ideal_exists_mem_and_mem_and_radical_span_singleton_isPrime

/-!
# The generic linear form and the field-theoretic Bertini lemma

For a field `K` over a field `k` and `g : Fin N → K` containing two algebraically independent
entries, the generic linear form `ξ = ∑ gᵢ xᵢ` in the rational function field
`F = K(x₀, …, x_{N-1})` is transcendental over `k[x, g_j]`. Over an algebraically closed `k` the
Library's field Bertini lemma then shows that `k(x, ξ)` is separably closed in `F`.
-/

noncomputable section

universe u

open MvPolynomial

namespace Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplane

/-- A `Fin.snoc` family is algebraically independent when its initial family is and its last
entry is transcendental over the algebra generated by the initial family. -/
theorem algebraicIndependent_snoc {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {N : ℕ}
    {v : Fin N → A} {a : A} (hv : AlgebraicIndependent R v)
    (ha : Transcendental (Algebra.adjoin R (Set.range v)) a) :
    AlgebraicIndependent R (Fin.snoc v a : Fin (N + 1) → A) := by
  have h := AlgebraicIndependent.option_iff.mpr ⟨hv, ha⟩
  refine (algebraicIndependent_equiv' finSuccEquivLast ?_).mpr h
  funext i
  refine Fin.lastCases ?_ (fun i => ?_) i
  · simp [finSuccEquivLast_last]
  · simp [finSuccEquivLast_castSucc]

/-- In the polynomial ring `K[x]`, the family `(x, g_j, ∑ gᵢ xᵢ)` is algebraically independent
over `k` when `g_j, g_l` are. The proof shifts `x_l ↦ x_l + 1`, which fixes `k[x, g_j]` and
sends `∑ gᵢ xᵢ` to `∑ gᵢ xᵢ + g_l`. -/
theorem algebraicIndependent_option_linearForm {k K : Type*} [Field k] [Field K] [Algebra k K]
    {N : ℕ} (g : Fin N → K) {j l : Fin N} (hjl : AlgebraicIndependent k ![g j, g l]) :
    AlgebraicIndependent k (fun o : Option (Option (Fin N)) =>
      o.elim (∑ i, C (g i) * X i : MvPolynomial (Fin N) K)
        (fun o' => o'.elim (C (g j)) X)) := by
  classical
  have hX : AlgebraicIndependent K (X : Fin N → MvPolynomial (Fin N) K) :=
    MvPolynomial.algebraicIndependent_X _ _
  have hbase : AlgebraicIndependent k
      (Sum.elim (X : Fin N → MvPolynomial (Fin N) K)
        (algebraMap K (MvPolynomial (Fin N) K) ∘ ![g j, g l])) :=
    hjl.sumElim_comp hX
  let ι : Option (Fin N) → Fin N ⊕ Fin 2 := fun o => o.elim (Sum.inr 0) Sum.inl
  have hι : Function.Injective ι := by
    rintro (_ | a) (_ | b) h <;> simp_all [ι]
  set b : Option (Fin N) → MvPolynomial (Fin N) K := fun o => o.elim (C (g j)) X with hbdef
  have hbeq : Sum.elim (X : Fin N → MvPolynomial (Fin N) K)
      (algebraMap K (MvPolynomial (Fin N) K) ∘ ![g j, g l]) ∘ ι = b := by
    funext o
    cases o <;> simp [ι, b, MvPolynomial.algebraMap_eq]
  have hb : AlgebraicIndependent k b := hbeq ▸ hbase.comp ι hι
  have hgl : Transcendental (Algebra.adjoin k (Set.range b)) (C (g l) : MvPolynomial (Fin N) K) := by
    have h := hbase.transcendental_adjoin (s := Set.range ι) (i := Sum.inr 1)
      (by rintro ⟨o, ho⟩; cases o <;> simp [ι] at ho)
    rw [← Set.range_comp, hbeq] at h
    simpa [MvPolynomial.algebraMap_eq] using h
  refine AlgebraicIndependent.option_iff.mpr ⟨hb, ?_⟩
  set S := Algebra.adjoin k (Set.range b) with hS
  let σK : MvPolynomial (Fin N) K →ₐ[K] MvPolynomial (Fin N) K :=
    aeval fun i => X i + if i = l then 1 else 0
  let σK' : MvPolynomial (Fin N) K →ₐ[K] MvPolynomial (Fin N) K :=
    aeval fun i => X i - if i = l then 1 else 0
  have hcomp : σK'.comp σK = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [σK, σK', AlgHom.comp_apply, aeval_X, AlgHom.id_apply, map_add]
    split_ifs <;> simp
  have hσinj : Function.Injective σK := by
    intro p q hpq
    have := congrArg σK' hpq
    rwa [← AlgHom.comp_apply, ← AlgHom.comp_apply, hcomp] at this
  let σ : MvPolynomial (Fin N) K →ₐ[k] MvPolynomial (Fin N) K := σK.restrictScalars k
  have hσS : S ≤ S.comap σ := by
    rw [hS, Algebra.adjoin_le_iff]
    rintro _ ⟨o, rfl⟩
    cases o with
    | none =>
      change σ (C (g j)) ∈ S
      have : σ (C (g j)) = C (g j) := by simp [σ, σK]
      rw [this]
      exact Algebra.subset_adjoin ⟨none, rfl⟩
    | some i =>
      change σ (X i) ∈ S
      have : σ (X i) = X i + if i = l then 1 else 0 := by simp [σ, σK]
      rw [this]
      refine S.add_mem (Algebra.subset_adjoin ⟨some i, rfl⟩) ?_
      split_ifs
      · exact S.one_mem
      · exact S.zero_mem
  let f : S →ₐ[k] S := (σ.comp S.val).codRestrict S (fun s => hσS s.2)
  have hf : Function.Injective f := by
    intro s t hst
    apply Subtype.ext
    apply hσinj
    have := congrArg Subtype.val hst
    exact this
  have hσξ : σ (∑ i, C (g i) * X i) = (∑ i, C (g i) * X i) + C (g l) := by
    simp [σ, σK, mul_add, Finset.sum_add_distrib]
  intro halg
  have h2 : IsAlgebraic S (σ (∑ i, C (g i) * X i)) :=
    halg.ringHom_of_comp_eq (f : S →+* S) σ hf
      (RingHom.ext fun s => rfl)
  rw [hσξ] at h2
  have h3 := h2.sub halg
  rw [add_sub_cancel_left] at h3
  exact hgl h3

variable {k K : Type u} [Field k] [Field K] [Algebra k K]

/-- The family `(x, ξ, g_j)` in the rational function field `K(x)`, in the indexing of the
Library's field Bertini lemma, is algebraically independent over `k`. -/
theorem algebraicIndependent_snoc_linearForm {N : ℕ} (g : Fin N → K) {j l : Fin N}
    (hjl : AlgebraicIndependent k ![g j, g l]) :
    AlgebraicIndependent k
      (Fin.snoc (Fin.snoc
        (fun i => algebraMap (MvPolynomial (Fin N) K) (FractionRing (MvPolynomial (Fin N) K)) (X i))
        (∑ i, algebraMap K (FractionRing (MvPolynomial (Fin N) K)) (g i) *
          algebraMap (MvPolynomial (Fin N) K) (FractionRing (MvPolynomial (Fin N) K)) (X i)))
        (algebraMap K (FractionRing (MvPolynomial (Fin N) K)) (g j)) : Fin (N + 1 + 1) → _) := by
  classical
  have h0 := algebraicIndependent_option_linearForm (k := k) g hjl
  have h1 := h0.map' (f := IsScalarTower.toAlgHom k (MvPolynomial (Fin N) K)
    (FractionRing (MvPolynomial (Fin N) K))) (IsFractionRing.injective _ _)
  let e : Fin (N + 1 + 1) ≃ Option (Option (Fin N)) :=
    (finSuccEquivLast.trans (Equiv.optionCongr finSuccEquivLast)).trans
      (Equiv.swap none (some none))
  refine (algebraicIndependent_equiv' e ?_).mpr h1
  funext i
  refine Fin.lastCases ?_ (fun i => ?_) i
  · simp [e, finSuccEquivLast_last, IsScalarTower.algebraMap_apply K (MvPolynomial (Fin N) K)
      (FractionRing (MvPolynomial (Fin N) K)), MvPolynomial.algebraMap_eq]
  · refine Fin.lastCases ?_ (fun i => ?_) i
    · simp [e, finSuccEquivLast_last, finSuccEquivLast_castSucc,
        IsScalarTower.algebraMap_apply K (MvPolynomial (Fin N) K)
        (FractionRing (MvPolynomial (Fin N) K)), MvPolynomial.algebraMap_eq]
    · have h : Equiv.swap (none : Option (Option (Fin N))) (some none) (some (some i)) =
          some (some i) := Equiv.swap_apply_of_ne_of_ne (by simp) (by simp)
      simp [e, finSuccEquivLast_castSucc, h]

/-- Field Bertini for the generic linear form: over an algebraically closed field `k`, if `K`
is finitely generated over `k` and two entries of `g` are algebraically independent, then
`k(x, ξ)` is separably closed in `K(x)`. -/
theorem mem_adjoin_of_isSeparable [IsAlgClosed k] (hfg : (⊤ : IntermediateField k K).FG) {m : ℕ}
    (g : Fin (m + 1) → K) {j l : Fin (m + 1)} (hjl : AlgebraicIndependent k ![g j, g l])
    (θ : FractionRing (MvPolynomial (Fin (m + 1)) K))
    (hθ : IsSeparable (IntermediateField.adjoin k
      (Set.range (fun i => algebraMap (MvPolynomial (Fin (m + 1)) K)
        (FractionRing (MvPolynomial (Fin (m + 1)) K)) (X i)) ∪
        {∑ i, algebraMap K (FractionRing (MvPolynomial (Fin (m + 1)) K)) (g i) *
          algebraMap (MvPolynomial (Fin (m + 1)) K) (FractionRing (MvPolynomial (Fin (m + 1)) K))
            (X i)})) θ) :
    θ ∈ IntermediateField.adjoin k
      (Set.range (fun i => algebraMap (MvPolynomial (Fin (m + 1)) K)
        (FractionRing (MvPolynomial (Fin (m + 1)) K)) (X i)) ∪
        {∑ i, algebraMap K (FractionRing (MvPolynomial (Fin (m + 1)) K)) (g i) *
          algebraMap (MvPolynomial (Fin (m + 1)) K) (FractionRing (MvPolynomial (Fin (m + 1)) K))
            (X i)}) := by
  classical
  have hsc : ∀ θ : K, IsSeparable k θ → θ ∈ (⊥ : IntermediateField k K) := fun θ hθ =>
    P2MW.S_Ideal_exists_mem_and_mem_and_radical_span_singleton_isPrime.P2mIrredHyp.mem_bot_of_isSeparable
      k θ hθ
  have hc : (∑ i, (Pi.single j (1 : k) : Fin (m + 1) → k) i • g i) = g j := by
    simp [Pi.single_apply]
  have hind := algebraicIndependent_snoc_linearForm (k := k) g hjl
  rw [← hc] at hind
  exact IntermediateField.mem_adjoin_sum_mul_of_isSeparable_of_algebraicIndependent hfg hsc g
    (Pi.single j 1) _ (fun _ => rfl) hind θ hθ

end Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplane
