import Langlands.AlgebraicGeometry.LangWeil.BertiniHyperplaneKernel

/-!
# Primality of the generic hyperplane section over an algebraically closed field

Over an algebraically closed field `k`, for a domain `D` of finite type generated by `g` with two
algebraically independent entries, and an algebraic extension `Ω` of `𝓛 = k(a_*, a_0, …)`, the
ideal generated by `1 ⊗ h` in `Ω ⊗[𝓛] (𝓛 ⊗[k] D)` has prime radical.
-/

noncomputable section

universe u

open MvPolynomial TensorProduct

namespace Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplane

variable (k : Type u) [Field k] {D : Type u} [CommRing D] [IsDomain D] [Algebra k D] {N : ℕ}
  (g : Fin N → D)

local notation "𝒦" => FractionRing D
local notation "𝒬" => MvPolynomial (Fin N) (FractionRing D)
local notation "ℱ" => FractionRing (MvPolynomial (Fin N) (FractionRing D))
local notation "𝒫" => MvPolynomial (Option (Fin N)) k
local notation "𝓛" => FractionRing (MvPolynomial (Option (Fin N)) k)

variable {k g} in
/-- The image of `𝓛` in `ℱ` is the field `k(x, ξ)`. -/
theorem paramEval_fieldRange (hψ : Function.Injective (paramEval₀ k g)) :
    (paramEval hψ).fieldRange = IntermediateField.adjoin k
      (Set.range (fun i => algebraMap 𝒬 ℱ (X i)) ∪ {linearForm g}) := by
  apply le_antisymm
  · intro y hy
    obtain ⟨l, rfl⟩ := AlgHom.mem_fieldRange.mp hy
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := 𝒫) l
    rw [map_div₀, paramEval_algebraMap, paramEval_algebraMap]
    have hmem : ∀ p : 𝒫, paramEval₀ k g p ∈ IntermediateField.adjoin k
        (Set.range (fun i => algebraMap 𝒬 ℱ (X i)) ∪ {linearForm g}) := by
      intro p
      have h1 : paramEval₀ k g p ∈ Algebra.adjoin k (Set.range fun o : Option (Fin N) =>
          o.elim (-linearForm g) fun i => algebraMap 𝒬 ℱ (X i)) := by
        rw [Algebra.adjoin_range_eq_range_aeval]
        exact ⟨p, rfl⟩
      refine (Algebra.adjoin_le ?_ : Algebra.adjoin k _ ≤
        (IntermediateField.adjoin k _).toSubalgebra) h1
      rintro _ ⟨o, rfl⟩
      cases o with
      | none => exact neg_mem (IntermediateField.subset_adjoin k _ (Or.inr rfl))
      | some i => exact IntermediateField.subset_adjoin k _ (Or.inl ⟨i, rfl⟩)
    exact div_mem (hmem a) (hmem b)
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ (⟨i, rfl⟩ | rfl)
    · exact AlgHom.mem_fieldRange.mpr
        ⟨algebraMap 𝒫 𝓛 (X (some i)), by simp [paramEval_algebraMap, paramEval₀]⟩
    · exact AlgHom.mem_fieldRange.mpr
        ⟨-algebraMap 𝒫 𝓛 (X none), by simp [paramEval_algebraMap, paramEval₀]⟩

variable {k g} in
/-- Field Bertini for the generic linear form, phrased for the image of `𝓛` in `ℱ`. -/
theorem mem_fieldRange_of_isSeparable [IsAlgClosed k] [Algebra.FiniteType k D]
    (hψ : Function.Injective (paramEval₀ k g)) {j l : Fin N}
    (hjl : AlgebraicIndependent k ![algebraMap D 𝒦 (g j), algebraMap D 𝒦 (g l)]) (y : ℱ)
    (hy : IsSeparable (paramEval hψ).fieldRange y) : y ∈ (paramEval hψ).fieldRange := by
  obtain ⟨m, rfl⟩ : ∃ m, N = m + 1 := ⟨N - 1, by have := j.isLt; omega⟩
  rw [paramEval_fieldRange] at hy ⊢
  exact mem_adjoin_of_isSeparable
    (P2MW.S_Ideal_exists_mem_and_mem_and_radical_span_singleton_isPrime.P2mIrredHyp.fg_top_fractionRing
      k D)
    (fun i => algebraMap D 𝒦 (g i)) hjl y hy

variable {k g} in
/-- If `ℱ` is an `𝓛`-algebra through `paramEval`, then `𝓛` is separably closed in `ℱ`. -/
theorem forall_isSeparable_mem_range [IsAlgClosed k] [Algebra.FiniteType k D]
    (hψ : Function.Injective (paramEval₀ k g)) {j l : Fin N}
    (hjl : AlgebraicIndependent k ![algebraMap D 𝒦 (g j), algebraMap D 𝒦 (g l)])
    [Algebra 𝓛 ℱ] (hal : ∀ r, algebraMap 𝓛 ℱ r = paramEval hψ r) (y : ℱ)
    (hy : IsSeparable 𝓛 y) : y ∈ (algebraMap 𝓛 ℱ).range := by
  have hy' : IsSeparable (paramEval hψ).fieldRange y :=
    P2MW.S_Ideal_exists_mem_and_mem_and_radical_span_singleton_isPrime.P2mIrredHyp.isSeparable_transport
      (R₁ := 𝓛) (R₂ := (paramEval hψ).fieldRange) (L := ℱ) (L' := ℱ)
      (AlgEquiv.ofInjectiveField (paramEval hψ)).toRingEquiv (RingHom.id ℱ)
      (fun r => (hal r).symm) hy
  obtain ⟨x, hx⟩ := AlgHom.mem_fieldRange.mp (mem_fieldRange_of_isSeparable hψ hjl y hy')
  exact ⟨x, by rw [hal, hx]⟩

variable {k g} in
/-- If `ℱ` is an `𝓛`-algebra through `paramEval`, the `𝓛`-algebra map `𝓛 ⊗[k] D → ℱ` agrees
with `tensorEval`. -/
theorem lift_apply_eq_tensorEval (hψ : Function.Injective (paramEval₀ k g))
    [Algebra 𝓛 ℱ] [IsScalarTower k 𝓛 ℱ] (hal : ∀ r, algebraMap 𝓛 ℱ r = paramEval hψ r)
    (z : 𝓛 ⊗[k] D) :
    Algebra.TensorProduct.lift (Algebra.ofId 𝓛 ℱ) (coeffHom k) (fun _ _ => Commute.all _ _) z =
      tensorEval hψ z := by
  induction z with
  | tmul a b =>
    simp only [tensorEval, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, hal]
  | add x y hx hy => rw [map_add, map_add, hx, hy]

variable {k g} in
/-- If `ℱ` is an `𝓛`-algebra through `paramEval`, then after any base change `Ω` of the field
`𝓛` (which is flat), the kernel of `Ω ⊗[𝓛] (𝓛 ⊗[k] D) → Ω ⊗[𝓛] ℱ` is generated by `1 ⊗ h`. -/
theorem mem_span_one_tmul_of_map_eq_zero (hψ : Function.Injective (paramEval₀ k g))
    [Algebra 𝓛 ℱ] [IsScalarTower k 𝓛 ℱ] (hal : ∀ r, algebraMap 𝓛 ℱ r = paramEval hψ r)
    (Ω : Type*) [CommRing Ω] [Algebra 𝓛 Ω] (s : Ω ⊗[𝓛] (𝓛 ⊗[k] D))
    (hs : Algebra.TensorProduct.map (AlgHom.id 𝓛 Ω)
      (Algebra.TensorProduct.lift (Algebra.ofId 𝓛 ℱ) (coeffHom k) fun _ _ => Commute.all _ _) s
      = 0) :
    s ∈ Ideal.span {(1 : Ω) ⊗ₜ[𝓛] hyperplaneEq k g} := by
  set φ : 𝓛 ⊗[k] D →ₐ[𝓛] ℱ :=
    Algebra.TensorProduct.lift (Algebra.ofId 𝓛 ℱ) (coeffHom k) fun _ _ => Commute.all _ _
  have hφ : ∀ z, φ z = tensorEval hψ z := lift_apply_eq_tensorEval hψ hal
  have hexact : Function.Exact (LinearMap.mulLeft 𝓛 (hyperplaneEq k g)) φ.toLinearMap := by
    intro z
    change φ z = 0 ↔ _
    rw [hφ, tensorEval_eq_zero_iff, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨a, mul_comm _ _⟩
    · rintro ⟨a, rfl⟩
      exact ⟨a, mul_comm _ _⟩
  have hfl := Module.Flat.lTensor_exact Ω hexact
  have key : ∀ t, LinearMap.lTensor Ω (LinearMap.mulLeft 𝓛 (hyperplaneEq k g)) t ∈
      Ideal.span {(1 : Ω) ⊗ₜ[𝓛] hyperplaneEq k g} := by
    intro t
    induction t with
    | tmul ω y =>
      rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply]
      have : ω ⊗ₜ[𝓛] (hyperplaneEq k g * y) =
          (ω ⊗ₜ[𝓛] y) * ((1 : Ω) ⊗ₜ[𝓛] hyperplaneEq k g) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_comm y]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
    | add t₁ t₂ h₁ h₂ => rw [map_add]; exact Ideal.add_mem _ h₁ h₂
  obtain ⟨t, rfl⟩ := (hfl s).mp hs
  exact key t

/-- Core of Bertini's theorem: over an algebraically closed field `k`, for a domain `D` of
finite type over `k` and `g : Fin N → D` with two algebraically independent entries, the
generic hyperplane equation generates an ideal with prime radical after any algebraic base
change `Ω` of `𝓛 = k(a_*, a_0, …)`. -/
theorem radical_span_one_tmul_hyperplaneEq_isPrime [IsAlgClosed k] [Algebra.FiniteType k D]
    {j l : Fin N} (hjl : AlgebraicIndependent k ![algebraMap D 𝒦 (g j), algebraMap D 𝒦 (g l)])
    (Ω : Type*) [Field Ω] [Algebra 𝓛 Ω] [Algebra.IsAlgebraic 𝓛 Ω] :
    (Ideal.radical (R := Ω ⊗[𝓛] (𝓛 ⊗[k] D))
      (Ideal.span {(1 : Ω) ⊗ₜ[𝓛] hyperplaneEq k g})).IsPrime := by
  have hψ := paramEval₀_injective k g hjl
  let _ : Algebra 𝓛 ℱ := (paramEval hψ).toRingHom.toAlgebra
  have hal : ∀ r, algebraMap 𝓛 ℱ r = paramEval hψ r := fun _ => rfl
  have : IsScalarTower k 𝓛 ℱ :=
    IsScalarTower.of_algebraMap_eq fun c => ((paramEval hψ).commutes c).symm
  refine radical_span_singleton_isPrime_of_ker
    ((Algebra.TensorProduct.comm 𝓛 Ω ℱ).toRingEquiv.toRingHom.comp
      (Algebra.TensorProduct.map (AlgHom.id 𝓛 Ω)
        (Algebra.TensorProduct.lift (Algebra.ofId 𝓛 ℱ) (coeffHom k)
          fun _ _ => Commute.all _ _)).toRingHom) ?_ ?_
    (Algebra.TensorProduct.nilradical_isPrime_of_isAlgebraic_of_forall_isSeparable_mem_range
      𝓛 ℱ Ω (forall_isSeparable_mem_range hψ hjl hal))
  · have : (Algebra.TensorProduct.lift (Algebra.ofId 𝓛 ℱ) (coeffHom k)
        fun _ _ => Commute.all _ _) (hyperplaneEq k g) = 0 := by
      rw [lift_apply_eq_tensorEval hψ hal, tensorEval_hyperplaneEq]
    simp [this]
  · intro s hs
    apply mem_span_one_tmul_of_map_eq_zero hψ hal Ω s
    simpa using hs

end Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplane
