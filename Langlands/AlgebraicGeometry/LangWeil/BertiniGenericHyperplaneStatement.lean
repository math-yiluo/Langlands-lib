import Mathlib.AlgebraicGeometry.Geometrically.Irreducible
import Mathlib.RingTheory.KrullDimension.Basic
import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Algebra.MvPolynomial.CommRing

/-!
# Bertini's irreducibility theorem for the generic hyperplane section

Let `X = Spec A` be an affine scheme of finite type over a field `k`, geometrically irreducible
of dimension at least `2`, embedded in affine `n`-space by generators `g₁, …, gₙ` of `A`. The
section of `X` by the generic affine hyperplane `a₀ + a₁ g₁ + ⋯ + aₙ gₙ = 0`, defined over the
rational function field `k(a₀, …, aₙ)`, is geometrically irreducible.
-/

universe u

open CategoryTheory TensorProduct
open _root_.AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.LangWeil

/-- Bertini's theorem for the generic hyperplane section (Jouanolou, *Théorèmes de Bertini et
applications*, Théorème 6.3 4); Stacks Project, Lemma 37.32.3, Tag 0G4F, whose proof shows that
the generic fibre of the universal hyperplane section is geometrically irreducible). Let `k` be
a field and `A` a `k`-algebra generated by `g : Fin n → A`, such that `Spec A` is geometrically
irreducible over `k` and has Krull dimension at least `2`. Let `L = k(a_*)` be the field of
rational functions in the variables `a_* , a_0, …, a_{n-1}` (indexed by `Option (Fin n)`, with
`a_*` the constant term) and `h = a_* ⊗ 1 + ∑ᵢ aᵢ ⊗ gᵢ ∈ L ⊗[k] A`. Then
`Spec ((L ⊗[k] A) ⧸ (h))` is geometrically irreducible over `L`. -/
def BertiniGenericHyperplaneStatement : Prop :=
  ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A] (n : ℕ) (g : Fin n → A),
    Algebra.adjoin k (Set.range g) = ⊤ →
    GeometricallyIrreducible (Spec.map (CommRingCat.ofHom (algebraMap k A))) →
    2 ≤ ringKrullDim A →
    GeometricallyIrreducible
      (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing (MvPolynomial (Option (Fin n)) k))
        ((FractionRing (MvPolynomial (Option (Fin n)) k) ⊗[k] A) ⧸ Ideal.span
          {algebraMap (MvPolynomial (Option (Fin n)) k)
              (FractionRing (MvPolynomial (Option (Fin n)) k)) (MvPolynomial.X none) ⊗ₜ[k]
                (1 : A) +
            ∑ i : Fin n, algebraMap (MvPolynomial (Option (Fin n)) k)
              (FractionRing (MvPolynomial (Option (Fin n)) k)) (MvPolynomial.X (some i)) ⊗ₜ[k]
                g i}))))

end Langlands.AlgebraicGeometry.LangWeil
