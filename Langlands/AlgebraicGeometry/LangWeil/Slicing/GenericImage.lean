import Langlands.AlgebraicGeometry.LangWeil.Slicing.Hyperplane
import Langlands.AlgebraicGeometry.ConstructibleGenerizations
import Mathlib.RingTheory.Spectrum.Prime.Chevalley
import Mathlib.RingTheory.Localization.Away.AdjoinRoot
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import Mathlib.RingTheory.Flat.Basic
import Mathlib.RingTheory.MvPolynomial.Localization

/-!
# Nonempty fibres near the generic point, and non-containment of generic hyperplanes

`exists_ne_zero_forall_nontrivial_tensor`: if a finitely generated algebra `B` over a Noetherian
domain `R` has a point over the generic point of `Spec R`, then there is `r ≠ 0` in `R` such that
`K ⊗[R] B` is nontrivial for every field `K` over `R` in which `r` does not vanish. This is
Chevalley's theorem: the image of `Spec B → Spec R` is constructible and contains the generic
point, hence contains a nonempty basic open set.

`exists_ne_zero_forall_hyp_not_mem_nilradical`: if `A` is generated by `g : Fin n → A` over a
Noetherian domain `R` and has a point with values in a field into which `R` injects, then there
is a nonzero polynomial `c` in the hyperplane coefficients such that the hyperplane element
`β_* ⊗ 1 + ∑ᵢ βᵢ ⊗ gᵢ` of `K ⊗[R] A` is not nilpotent whenever `c(β) ≠ 0`.
-/

open scoped TensorProduct

namespace Langlands.AlgebraicGeometry.LangWeil.Slicing

/-- **Chevalley near the generic point.** If a finitely generated algebra `B` over a
Noetherian domain `R` has a prime lying over `0`, then for some `r ≠ 0` every field `K` over `R`
in which `r` does not vanish gives a nontrivial `K ⊗[R] B`. -/
theorem exists_ne_zero_forall_nontrivial_tensor {R B : Type*} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [CommRing B] [Algebra R B] [Algebra.FiniteType R B]
    (Q : Ideal B) [Q.IsPrime] (hQ : Q.comap (algebraMap R B) = ⊥) :
    ∃ r : R, r ≠ 0 ∧ ∀ (K : Type*) [Field K] [Algebra R K],
      algebraMap R K r ≠ 0 → Nontrivial (K ⊗[R] B) := by
  have hfp : (algebraMap R B).FinitePresentation :=
    RingHom.FinitePresentation.of_finiteType.mp (RingHom.finiteType_algebraMap.mpr ‹_›)
  have hcons := PrimeSpectrum.isConstructible_comap_image hfp Topology.IsConstructible.univ
  let η : PrimeSpectrum R := ⟨⊥, Ideal.isPrime_bot⟩
  have hη : IsGenericPoint η Set.univ := by
    rw [isGenericPoint_def, PrimeSpectrum.closure_singleton]
    exact PrimeSpectrum.zeroLocus_bot
  obtain ⟨U, hU, hηU, hUS⟩ :=
    Langlands.AlgebraicGeometry.exists_open_constructible_membership_on_generic hη hcons
  have hηS : η ∈ PrimeSpectrum.comap (algebraMap R B) '' Set.univ :=
    ⟨⟨Q, ‹_›⟩, trivial, PrimeSpectrum.ext hQ⟩
  obtain ⟨V, ⟨r, rfl⟩, hηV, hVU⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hηU hU
  refine ⟨r, fun hr => (PrimeSpectrum.mem_basicOpen r η).mp hηV (by simp [η, hr]), ?_⟩
  intro K _ _ hrK
  let p : PrimeSpectrum R := ⟨RingHom.ker (algebraMap R K), RingHom.ker_isPrime _⟩
  have : p.asIdeal.IsPrime := p.isPrime
  have hpV : p ∈ (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R)) :=
    (PrimeSpectrum.mem_basicOpen r p).mpr hrK
  obtain ⟨q, -, hq⟩ := (hUS p ⟨trivial, hVU hpV⟩).mpr hηS
  have hnt : Nontrivial (p.asIdeal.ResidueField ⊗[R] B) :=
    (p.nontrivial_iff_mem_rangeComap (S := B)).mpr ⟨q, hq⟩
  let : Algebra p.asIdeal.ResidueField K :=
    (Ideal.ResidueField.lift p.asIdeal (algebraMap R K) le_rfl fun x hx =>
      (Ne.isUnit fun h => hx h)).toAlgebra
  have : IsScalarTower R p.asIdeal.ResidueField K := IsScalarTower.of_algebraMap_eq fun x =>
    (Ideal.ResidueField.lift_algebraMap p.asIdeal (algebraMap R K) le_rfl _ x).symm
  have : Nontrivial (K ⊗[p.asIdeal.ResidueField] (p.asIdeal.ResidueField ⊗[R] B)) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right _ _ _
      (algebraMap p.asIdeal.ResidueField K).injective
  exact (Algebra.TensorProduct.cancelBaseChange R p.asIdeal.ResidueField K K B).toEquiv.symm.nontrivial

/-- If the hyperplane element `h` of `P ⊗[R] A` survives in `K ⊗[P] (P ⊗[R] A)[1/h]`, then its image
in `K ⊗[R] A` is not nilpotent. -/
theorem hyp_not_mem_nilradical_of_nontrivial {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    {n : ℕ} (g : Fin n → A) {P : Type*} [CommRing P] [Algebra R P] (K : Type*) [Field K]
    [Algebra R K] [Algebra P K] [IsScalarTower R P K] (α : Option (Fin n) → P)
    [Nontrivial (K ⊗[P] Localization.Away (hyp R g α))] :
    hyp R g (algebraMap P K ∘ α) ∉ nilradical (K ⊗[R] A) := by
  intro hnil
  let Ψ : K ⊗[R] A →ₐ[K] K ⊗[P] Localization.Away (hyp R g α) :=
    (Algebra.TensorProduct.map (AlgHom.id K K)
      (IsScalarTower.toAlgHom P (P ⊗[R] A) (Localization.Away (hyp R g α)))).comp
      (Algebra.TensorProduct.cancelBaseChange R P K K A).symm.toAlgHom
  have hcan : Algebra.TensorProduct.cancelBaseChange R P K K A ((1 : K) ⊗ₜ hyp R g α) =
      hyp R g (algebraMap P K ∘ α) := by
    simp [hyp, TensorProduct.tmul_add, TensorProduct.tmul_sum, Algebra.smul_def]
  have hΨ : Ψ (hyp R g (algebraMap P K ∘ α)) = Algebra.TensorProduct.includeRight
      (algebraMap (P ⊗[R] A) (Localization.Away (hyp R g α)) (hyp R g α)) := by
    rw [← hcan]
    simp [Ψ]
  have hu : IsUnit (Ψ (hyp R g (algebraMap P K ∘ α))) :=
    hΨ ▸ (IsLocalization.Away.algebraMap_isUnit (hyp R g α)).map _
  exact ((mem_nilradical.mp hnil).map Ψ).not_isUnit hu

section NotMem

variable {R A : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R] [CommRing A] [Algebra R A]
  [Algebra.FiniteType R A] {n : ℕ} (g : Fin n → A)

local notation "𝒫" => MvPolynomial (Option (Fin n)) R

/-- **Generic hyperplanes do not contain the generic fibre.** If `A` has a point with values in a
field into which `R` injects, there is a nonzero polynomial `c` in the hyperplane coefficients
such that the hyperplane element of `K ⊗[R] A` with coefficients `β` in a field `K` is not
nilpotent whenever `c(β) ≠ 0`. -/
theorem exists_ne_zero_forall_hyp_not_mem_nilradical {F : Type*} [Field F] [Algebra R F]
    (hF : Function.Injective (algebraMap R F)) (θ : A →ₐ[R] F) :
    ∃ c : 𝒫, c ≠ 0 ∧ ∀ (K : Type*) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c ≠ 0 → hyp R g β ∉ nilradical (K ⊗[R] A) := by
  classical
  let h : 𝒫 ⊗[R] A := hyp R g (MvPolynomial.X : Option (Fin n) → 𝒫)
  -- The point `θ` gives a map `𝒫 ⊗[R] A → F(a)` sending `h` to `a_* + ∑ᵢ aᵢ θ(gᵢ) ≠ 0`.
  let E := FractionRing (MvPolynomial (Option (Fin n)) F)
  let ι : 𝒫 →+* E :=
    (algebraMap (MvPolynomial (Option (Fin n)) F) E).comp (MvPolynomial.map (algebraMap R F))
  have hι : Function.Injective ι :=
    (IsFractionRing.injective _ E).comp (MvPolynomial.map_injective _ hF)
  let : Algebra 𝒫 E := ι.toAlgebra
  have : IsScalarTower R 𝒫 E := IsScalarTower.of_algebraMap_eq fun r => by
    change _ = algebraMap (MvPolynomial (Option (Fin n)) F) E
      (MvPolynomial.map (algebraMap R F) (MvPolynomial.C r))
    rw [MvPolynomial.map_C, IsScalarTower.algebraMap_apply R (MvPolynomial (Option (Fin n)) F) E,
      MvPolynomial.algebraMap_apply]
  let θE : A →ₐ[R] E := (IsScalarTower.toAlgHom R F E).comp θ
  let φT : (𝒫 ⊗[R] A) →ₐ[𝒫] E := Algebra.TensorProduct.liftEquivRight R 𝒫 A E θE
  let p : MvPolynomial (Option (Fin n)) F :=
    MvPolynomial.X none + ∑ i, MvPolynomial.X (some i) * MvPolynomial.C (θ (g i))
  have hp : p ≠ 0 := by
    intro hp
    have := congrArg (MvPolynomial.eval fun j : Option (Fin n) => Option.elim j (1 : F) 0) hp
    simp [p] at this
  have hφp : φT h = algebraMap (MvPolynomial (Option (Fin n)) F) E p := by
    change Algebra.TensorProduct.liftEquivRight R 𝒫 A E θE (hyp R g MvPolynomial.X) = _
    rw [lift_hyp]
    simp only [p, map_add, map_sum, map_mul, RingHom.algebraMap_toAlgebra, ι, RingHom.comp_apply,
      MvPolynomial.map_X, θE, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      IsScalarTower.algebraMap_apply F (MvPolynomial (Option (Fin n)) F) E,
      MvPolynomial.algebraMap_eq]
  have hφh : IsUnit ((φT : (𝒫 ⊗[R] A) →+* E) h) := by
    refine Ne.isUnit ?_
    rw [AlgHom.coe_toRingHom, hφp]
    exact (map_ne_zero_iff _ (IsFractionRing.injective _ E)).mpr hp
  let φB : Localization.Away h →+* E := IsLocalization.Away.lift h hφh
  have hQ : (RingHom.ker φB).comap (algebraMap 𝒫 (Localization.Away h)) = ⊥ := by
    rw [RingHom.comap_ker, ← RingHom.injective_iff_ker_eq_bot]
    convert hι using 1
    ext q
    rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply 𝒫 (𝒫 ⊗[R] A) (Localization.Away h),
      IsLocalization.Away.lift_eq, AlgHom.coe_toRingHom, AlgHom.commutes]
    rfl
  have : (RingHom.ker φB).IsPrime := RingHom.ker_isPrime φB
  obtain ⟨r, hr0, hr⟩ :=
    exists_ne_zero_forall_nontrivial_tensor (R := 𝒫) (B := Localization.Away h)
      (RingHom.ker φB) hQ
  refine ⟨r, hr0, fun K _ _ β hβ hnil => ?_⟩
  let : Algebra 𝒫 K := (MvPolynomial.aeval β).toRingHom.toAlgebra
  have : IsScalarTower R 𝒫 K :=
    IsScalarTower.of_algebraMap_eq fun r => ((MvPolynomial.aeval β).commutes r).symm
  have : Nontrivial (K ⊗[𝒫] Localization.Away h) := hr K hβ
  have heq : algebraMap 𝒫 K ∘ MvPolynomial.X = β := funext fun j => MvPolynomial.aeval_X β j
  rw [← heq] at hnil
  exact hyp_not_mem_nilradical_of_nontrivial g K MvPolynomial.X hnil

end NotMem

end Langlands.AlgebraicGeometry.LangWeil.Slicing
