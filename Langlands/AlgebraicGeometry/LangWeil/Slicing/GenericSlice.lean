import Langlands.AlgebraicGeometry.LangWeil.BertiniGenericHyperplaneStatement
import Langlands.AlgebraicGeometry.LangWeil.Slicing.Hyperplane
import Langlands.AlgebraicGeometry.GeometricIrreducibilityAffine
import Langlands.Algebra.GeometricIrreducibilitySpreadingProof
import Mathlib.RingTheory.FiniteStability
import Mathlib.RingTheory.MvPolynomial.Localization
import Mathlib.RingTheory.Localization.LocalizationLocalization

/-!
# Geometric irreducibility of generic hyperplane sections

Let `R` be a domain and `A` a finitely generated `R`-algebra, generated by `g : Fin n → A`, whose
generic fibre is geometrically irreducible of dimension at least `2`. Bertini's theorem for the
generic hyperplane section, spread out over the parameter ring `R[a_*, a_0, …, a_{n-1}]`, gives a
nonzero polynomial `c` in the parameters such that every hyperplane section with coefficients `β`
in a field and `c(β) ≠ 0` has prime nilradical.
-/

universe u

open scoped TensorProduct
open _root_.AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.LangWeil.Slicing

open Langlands.Algebra

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The rational function field over the fraction field of a domain `R` is a fraction field of
the polynomial ring over `R`. -/
theorem isFractionRing_mvPolynomial (R : Type*) [CommRing R] [IsDomain R] (σ : Type*) :
    IsFractionRing (MvPolynomial σ R) (FractionRing (MvPolynomial σ (FractionRing R))) := by
  have hinj : Function.Injective
      (algebraMap (MvPolynomial σ R) (MvPolynomial σ (FractionRing R))) :=
    MvPolynomial.map_injective _ (IsFractionRing.injective R (FractionRing R))
  have h := IsLocalization.localization_localization_isLocalization_of_has_all_units
    (M := (nonZeroDivisors R).map (MvPolynomial.C (σ := σ) (R := R)))
    (S := MvPolynomial σ (FractionRing R))
    (N := nonZeroDivisors (MvPolynomial σ (FractionRing R)))
    (T := FractionRing (MvPolynomial σ (FractionRing R))) (fun x hx => hx.mem_nonZeroDivisors)
  have hM : (nonZeroDivisors (MvPolynomial σ (FractionRing R))).comap
      (algebraMap (MvPolynomial σ R) (MvPolynomial σ (FractionRing R))) =
        nonZeroDivisors (MvPolynomial σ R) := by
    ext p
    simp only [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero, ne_eq]
    rw [← map_zero (algebraMap (MvPolynomial σ R) (MvPolynomial σ (FractionRing R))),
      hinj.eq_iff]
  rw [hM] at h
  exact h

section Generic

variable {R : Type u} [CommRing R] [IsDomain R] {A : Type u} [CommRing A] [Algebra R A]
  {n : ℕ} (g : Fin n → A)

local notation "𝒫" => MvPolynomial (Option (Fin n)) R
local notation "𝒫k" => MvPolynomial (Option (Fin n)) (FractionRing R)
local notation "𝓛" => FractionRing 𝒫k

/-- Bertini's theorem, applied to the generic fibre `FractionRing R ⊗[R] A`, says that the
universal hyperplane section over the parameter ring `𝒫` is geometrically irreducible at the
generic point of `Spec 𝒫`. -/
theorem nilradical_algebraicClosure_slice_isPrime (hB : BertiniGenericHyperplaneStatement.{u})
    (hg : Algebra.adjoin R (Set.range g) = ⊤)
    (hgi : ∀ (K : Type u) [Field K] [Algebra R K], Function.Injective (algebraMap R K) →
      (nilradical (K ⊗[R] A)).IsPrime)
    (hdim : 2 ≤ ringKrullDim (FractionRing R ⊗[R] A)) :
    (nilradical (AlgebraicClosure 𝓛 ⊗[𝒫] Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫))).IsPrime := by
  have hadj : Algebra.adjoin (FractionRing R)
      (Set.range fun i => (1 : FractionRing R) ⊗ₜ[R] g i) = ⊤ := by
    rw [Set.range_comp' (fun x : A => (1 : FractionRing R) ⊗ₜ[R] x) g]
    exact Algebra.TensorProduct.adjoin_one_tmul_image_eq_top _ hg
  have hgeo : GeometricallyIrreducible (Spec.map (CommRingCat.ofHom
      (algebraMap (FractionRing R) (FractionRing R ⊗[R] A)))) := by
    rw [SchemeFiberGeometry.geometricallyIrreducible_specMap_iff]
    intro K _ _
    let : Algebra R K := ((algebraMap (FractionRing R) K).comp
      (algebraMap R (FractionRing R))).toAlgebra
    have : IsScalarTower R (FractionRing R) K := IsScalarTower.of_algebraMap_eq fun _ => rfl
    refine (GenericIrreducibilityReduction.nilradical_isPrime_iff_of_ringEquiv
      (Algebra.TensorProduct.cancelBaseChange R (FractionRing R) K K A).toRingEquiv).mpr ?_
    exact hgi K ((algebraMap (FractionRing R) K).injective.comp
      (IsFractionRing.injective R (FractionRing R)))
  have hBk := hB (FractionRing R) (FractionRing R ⊗[R] A) n
    (fun i => (1 : FractionRing R) ⊗ₜ[R] g i) hadj hgeo hdim
  rw [SchemeFiberGeometry.geometricallyIrreducible_specMap_iff] at hBk
  have h1 := hBk (AlgebraicClosure 𝓛)
  have : @IsScalarTower 𝒫 𝓛 (AlgebraicClosure 𝓛) Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : @IsScalarTower R 𝒫 (AlgebraicClosure 𝓛) Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq fun r => by
      change _ = algebraMap 𝓛 (AlgebraicClosure 𝓛) (algebraMap 𝒫 𝓛 (algebraMap R 𝒫 r))
      rw [← IsScalarTower.algebraMap_apply R 𝒫 𝓛]
      rfl
  have heq : (algebraMap 𝓛 (AlgebraicClosure 𝓛) ∘
      fun j : Option (Fin n) => algebraMap 𝒫k 𝓛 (MvPolynomial.X j)) =
        algebraMap 𝒫 (AlgebraicClosure 𝓛) ∘ MvPolynomial.X := by
    funext j
    change algebraMap 𝓛 (AlgebraicClosure 𝓛) (algebraMap 𝒫k 𝓛 (MvPolynomial.X j)) =
      algebraMap 𝓛 (AlgebraicClosure 𝓛) (algebraMap 𝒫 𝓛 (MvPolynomial.X j))
    rw [IsScalarTower.algebraMap_apply 𝒫 𝒫k 𝓛, MvPolynomial.algebraMap_def, MvPolynomial.map_X]
  have e1 := sliceBaseChange (FractionRing R) (fun i => (1 : FractionRing R) ⊗ₜ[R] g i)
    (S := 𝓛) (S' := AlgebraicClosure 𝓛) fun j => algebraMap 𝒫k 𝓛 (MvPolynomial.X j)
  have e2 := sliceCancelBaseChange R g (FractionRing R)
    (algebraMap 𝓛 (AlgebraicClosure 𝓛) ∘ fun j => algebraMap 𝒫k 𝓛 (MvPolynomial.X j))
  have e3 := sliceEquivOfEq R g heq
  have e4 := (sliceBaseChange R g (S := 𝒫) (S' := AlgebraicClosure 𝓛) MvPolynomial.X).symm
  have e12 := e1.trans e2
  have e123 := e12.trans e3
  have e := (e123.trans e4).toRingEquiv
  have h2 := (GenericIrreducibilityReduction.nilradical_isPrime_iff_of_ringEquiv
    (A := AlgebraicClosure 𝓛 ⊗[𝓛] Slice (FractionRing R) (fun i => (1 : FractionRing R) ⊗ₜ[R] g i)
      fun j => algebraMap 𝒫k 𝓛 (MvPolynomial.X j))
    (B := AlgebraicClosure 𝓛 ⊗[𝒫] Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫)) e).mp
  exact h2 h1

/-- **Generic hyperplane sections are geometrically irreducible.** There is a nonzero polynomial
`c` in the hyperplane coefficients such that the hyperplane section of `K ⊗[R] A` with
coefficients `β` in any field `K` with `c(β) ≠ 0` has prime nilradical. -/
theorem exists_ne_zero_forall_nilradical_slice_isPrime
    (hB : BertiniGenericHyperplaneStatement.{u}) [Algebra.FiniteType R A]
    (hg : Algebra.adjoin R (Set.range g) = ⊤)
    (hgi : ∀ (K : Type u) [Field K] [Algebra R K], Function.Injective (algebraMap R K) →
      (nilradical (K ⊗[R] A)).IsPrime)
    (hdim : 2 ≤ ringKrullDim (FractionRing R ⊗[R] A)) :
    ∃ c : 𝒫, c ≠ 0 ∧ ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c ≠ 0 → (nilradical (Slice R g β)).IsPrime := by
  have : IsFractionRing 𝒫 𝓛 := isFractionRing_mvPolynomial R (Option (Fin n))
  obtain ⟨c, hc0, hc⟩ := GenericIrreducibilityReduction.spreading_of_domain_algebras
    (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫)) 𝓛
    (fun C _ _ _ _ _ h => GenericIrreducibilitySpreading.exists_ne_zero_tensor_nilradical_isPrime h)
    (nilradical_algebraicClosure_slice_isPrime g hB hg hgi hdim)
  refine ⟨c, hc0, fun K _ _ β hβ => ?_⟩
  let : Algebra 𝒫 K := (MvPolynomial.aeval β).toRingHom.toAlgebra
  have : IsScalarTower R 𝒫 K :=
    IsScalarTower.of_algebraMap_eq fun r => ((MvPolynomial.aeval β).commutes r).symm
  have h := hc K hβ
  have heq : algebraMap 𝒫 K ∘ MvPolynomial.X = β := by
    funext j
    exact MvPolynomial.aeval_X β j
  have e := ((sliceBaseChange R g (S := 𝒫) (S' := K) MvPolynomial.X).trans
    (sliceEquivOfEq R g heq)).toRingEquiv
  exact (GenericIrreducibilityReduction.nilradical_isPrime_iff_of_ringEquiv
    (A := K ⊗[𝒫] Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫)) (B := Slice R g β) e).mp h

end Generic

end Langlands.AlgebraicGeometry.LangWeil.Slicing
