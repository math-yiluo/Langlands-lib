import Langlands.AlgebraicGeometry.LangWeil.Slicing.Counting
import Langlands.AlgebraicGeometry.LangWeil.Slicing.Bridges
import Langlands.AlgebraicGeometry.LangWeil.Slicing.Dimension
import Langlands.AlgebraicGeometry.LangWeil.Slicing.GenericSlice
import Langlands.AlgebraicGeometry.LangWeil.Slicing.GenericImage

/-!
# The slicing estimate for an affine family over an integral base

Let `R` be a domain of finite type over `ℤ` and `A` an `R`-algebra generated by `g : Fin n → A`,
such that, for some `r₀ ≠ 0`, every field `K` over `R` in which `r₀` does not vanish gives a
ring `K ⊗[R] A` with prime nilradical and Krull dimension `d + 2`. Given Bertini's theorem, the
uniform upper bound and the Lang–Weil estimate in dimension `d + 1`, the number of `κ`-points of
`A` satisfies the Lang–Weil estimate in dimension `d + 2` at every finite field `κ` over `R` in
which a suitable `r ≠ 0` does not vanish.
-/

universe u

open scoped TensorProduct
open Finset

namespace Langlands.AlgebraicGeometry.LangWeil.Slicing

open SchemeFiberGeometry

/-- The number of affine hyperplane parameters with nonzero linear part. -/
theorem card_filter_linear_ne_zero {κ : Type*} [Field κ] [Fintype κ] [DecidableEq κ] (n : ℕ) :
    #(univ.filter (fun α : Option (Fin n) → κ => (fun i => α (some i)) ≠ 0)) =
      Fintype.card κ * (Fintype.card κ ^ n - 1) := by
  have h1 : #(univ.filter (fun α : Option (Fin n) → κ => ¬ (fun i => α (some i)) ≠ 0)) =
      Fintype.card κ := by
    rw [← Fintype.card_subtype]
    exact Fintype.card_congr
      { toFun := fun α => α.1 none
        invFun := fun c => ⟨fun o => o.elim c 0, by simp; rfl⟩
        left_inv := fun α => by
          apply Subtype.ext
          funext o
          cases o with
          | none => rfl
          | some i => exact (congrFun (not_not.mp α.2) i).symm
        right_inv := fun c => rfl }
  have h2 := card_filter_add_card_filter_not (s := (univ : Finset (Option (Fin n) → κ)))
    (fun α : Option (Fin n) → κ => (fun i => α (some i)) ≠ 0)
  rw [h1, card_univ, Fintype.card_fun, Fintype.card_option, Fintype.card_fin, pow_succ] at h2
  rw [Nat.mul_sub_one, mul_comm]
  omega

/-- Mapping the coefficients does not increase the total degree. -/
theorem totalDegree_map_le {σ R S : Type*} [CommSemiring R] [CommSemiring S] (f : R →+* S)
    (p : MvPolynomial σ R) : (MvPolynomial.map f p).totalDegree ≤ p.totalDegree :=
  Finset.sup_mono (MvPolynomial.support_map_subset f p)

/-- An algebra generated by finitely many elements has finitely many points in a finite
algebra. -/
theorem finite_algHom_of_adjoin {R A κ : Type*} [CommRing R] [CommRing A] [Algebra R A]
    [CommRing κ] [Algebra R κ] [Finite κ] {n : ℕ} {g : Fin n → A}
    (hg : Algebra.adjoin R (Set.range g) = ⊤) : Finite (A →ₐ[R] κ) :=
  Finite.of_injective (fun x : A →ₐ[R] κ => fun i => x (g i)) fun x y hxy =>
    AlgHom.ext_of_adjoin_eq_top hg (by rintro _ ⟨i, rfl⟩; exact congrFun hxy i)

/-- If an algebra of positive dimension over a field is generated by `g`, then some generator is
not congruent to a constant modulo the nilradical. -/
theorem exists_forall_sub_algebraMap_not_mem_nilradical {K T : Type*} [Field K] [CommRing T]
    [Algebra K T] {n : ℕ} (g : Fin n → T) (hg : Algebra.adjoin K (Set.range g) = ⊤)
    (hdim : 0 < ringKrullDim T) :
    ∃ i₀, ∀ c : K, g i₀ - algebraMap K T c ∉ nilradical T := by
  by_contra h
  push Not at h
  choose c hc using h
  let π := Ideal.Quotient.mkₐ K (nilradical T)
  have hbot : (⊤ : Subalgebra K (T ⧸ nilradical T)) ≤ ⊥ := by
    rw [← (AlgHom.range_eq_top π).mpr (Ideal.Quotient.mkₐ_surjective K _), ← Algebra.map_top,
      ← hg, AlgHom.map_adjoin, Algebra.adjoin_le_iff]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, Algebra.mem_bot]
    refine ⟨c i, ?_⟩
    rw [← π.commutes (c i), eq_comm, ← sub_eq_zero, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hc i)
  have hsurj : Function.Surjective (algebraMap K (T ⧸ nilradical T)) := fun x =>
    Algebra.mem_bot.mp (hbot Algebra.mem_top)
  have h1 := ringKrullDim_le_of_surjective _ hsurj
  rw [ringKrullDim_eq_zero_of_field, ringKrullDim_quotient_nilradical] at h1
  exact (lt_irrefl _ (hdim.trans_le h1))

/-- Points of a hyperplane section with values in a finite field, as a filtered count. -/
theorem natCard_slice_algHom {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {n : ℕ}
    (g : Fin n → A) {S κ : Type*} [CommRing S] [CommRing κ] [Algebra R S] [Algebra R κ]
    [Algebra S κ] [IsScalarTower R S κ] [Fintype (A →ₐ[R] κ)] [DecidableEq κ]
    (α : Option (Fin n) → S) :
    Nat.card (Slice R g α →ₐ[S] κ) = #(univ.filter fun x : A →ₐ[R] κ =>
      algebraMap S κ (α none) + ∑ i, algebraMap S κ (α (some i)) * x (g i) = 0) := by
  rw [Nat.card_congr (slicePointsEquiv R g α), Nat.card_eq_fintype_card, Fintype.card_subtype]

section Fibres

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] {n : ℕ} (g : Fin n → A) {d : ℕ}
  {r₀ : R} {c₁ c₂ : MvPolynomial (Option (Fin n)) R}

/-- Hyperplane sections with coefficients outside the bad locus `r₀ c₁ c₂ = 0` have prime
nilradical and dimension `d + 1`. -/
theorem slice_isPrime_and_dim [Algebra.FiniteType R A]
    (hfib : ∀ (K : Type u) [Field K] [Algebra R K], algebraMap R K r₀ ≠ 0 →
      (nilradical (K ⊗[R] A)).IsPrime ∧ ringKrullDim (K ⊗[R] A) = (d + 2 : ℕ))
    (hc₁ : ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c₁ ≠ 0 → (nilradical (Slice R g β)).IsPrime)
    (hc₂ : ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c₂ ≠ 0 → hyp R g β ∉ nilradical (K ⊗[R] A))
    (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K)
    (hβ : MvPolynomial.aeval β (MvPolynomial.C r₀ * (c₁ * c₂)) ≠ 0) :
    (nilradical (Slice R g β)).IsPrime ∧ ringKrullDim (Slice R g β) = (d + 1 : ℕ) := by
  rw [map_mul, map_mul, MvPolynomial.aeval_C] at hβ
  obtain ⟨h0, h12⟩ := mul_ne_zero_iff.mp hβ
  obtain ⟨h1, h2⟩ := mul_ne_zero_iff.mp h12
  have hP := hc₁ K β h1
  obtain ⟨hT, hdim⟩ := hfib K h0
  have hne : Ideal.span {hyp R g β} ≠ ⊤ := by
    intro htop
    have : Subsingleton (Slice R g β) := Ideal.Quotient.subsingleton_iff.mpr htop
    exact hP.ne_top (Subsingleton.elim _ _)
  exact ⟨hP, ringKrullDim_quotient_span_singleton_eq K hT (hc₂ K β h2) hne (e := d + 1) hdim⟩

end Fibres

/-- The hyperplane element of `κ ⊗[R] A` in terms of the generators `1 ⊗ gᵢ`. -/
theorem hyp_eq_algebraMap_add_sum_smul {R A κ : Type*} [CommRing R] [CommRing A] [Algebra R A]
    [CommRing κ] [Algebra R κ] {n : ℕ} (g : Fin n → A) (α : Option (Fin n) → κ) :
    hyp R g α = algebraMap κ (κ ⊗[R] A) (α none) + ∑ i, α (some i) • ((1 : κ) ⊗ₜ[R] g i) := by
  simp [hyp, Algebra.TensorProduct.algebraMap_apply, TensorProduct.smul_tmul']

section Families

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] {n : ℕ} (g : Fin n → A) {d : ℕ}

set_option backward.isDefEq.respectTransparency false in
/-- Where the hyperplane does not contain the fibre, the fibre of the hyperplane section has
dimension at most `d + 1`. -/
theorem ringKrullDim_tensor_slice_le {P : Type u} [CommRing P] [Algebra R P]
    (α : Option (Fin n) → P) (K : Type u) [Field K] [Algebra R K] [Algebra P K]
    [IsScalarTower R P K] (hT : (nilradical (K ⊗[R] A)).IsPrime)
    (hdim : ringKrullDim (K ⊗[R] A) = (d + 2 : ℕ))
    (hh : hyp R g (algebraMap P K ∘ α) ∉ nilradical (K ⊗[R] A)) :
    ringKrullDim (K ⊗[P] Slice R g α) ≤ (d + 1 : ℕ) := by
  rw [ringKrullDim_eq_of_ringEquiv (sliceBaseChange R g α (S' := K)).toRingEquiv]
  have h := ringKrullDim_quotient_succ_le_of_not_le_nilradical hT
    (I := Ideal.span {hyp R g (algebraMap P K ∘ α)}) (by rwa [Ideal.span_singleton_le_iff_mem])
  rw [hdim] at h
  generalize ringKrullDim (Slice R g (algebraMap P K ∘ α)) = x at h ⊢
  induction x using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe m =>
    norm_cast at h ⊢
    rw [← WithBot.coe_natCast, WithBot.coe_le_coe,
      show ((d + 2 : ℕ) : ℕ∞) = ((d + 1 : ℕ) : ℕ∞) + 1 by push_cast; ring] at h
    exact (ENat.add_le_add_iff_right ENat.one_ne_top).mp h

/-- Where the hyperplane does not contain the fibre, the uniform upper bound for the universal
hyperplane section bounds the number of points on the hyperplane by `C₂ (#κ) ^ (d + 1)`. -/
theorem natCard_slice_le_of_upperBound {P : Type u} [CommRing P] [Algebra R P]
    (α' : Option (Fin n) → P) {r₀ : R}
    (hfib : ∀ (K : Type u) [Field K] [Algebra R K], algebraMap R K r₀ ≠ 0 →
      (nilradical (K ⊗[R] A)).IsPrime ∧ ringKrullDim (K ⊗[R] A) = (d + 2 : ℕ))
    {C₂ : ℝ} (hC₂ : ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra P κ] (e : ℕ),
      (∀ p : PrimeSpectrum P, p.asIdeal = RingHom.ker (algebraMap P κ) →
        ringKrullDim (p.asIdeal.Fiber (Slice R g α')) ≤ e) →
      (Nat.card (Slice R g α' →ₐ[P] κ) : ℝ) ≤ C₂ * (Nat.card κ : ℝ) ^ e)
    (κ : Type u) [Field κ] [Finite κ] [Algebra R κ] [Algebra P κ] [IsScalarTower R P κ]
    (hr₀ : algebraMap R κ r₀ ≠ 0)
    (hh : hyp R g (algebraMap P κ ∘ α') ∉ nilradical (κ ⊗[R] A)) :
    (Nat.card (Slice R g α' →ₐ[P] κ) : ℝ) ≤ C₂ * (Nat.card κ : ℝ) ^ (d + 1) := by
  refine hC₂ κ (d + 1) fun p hp => ?_
  let φ : p.asIdeal.ResidueField →ₐ[R] κ :=
    Ideal.ResidueField.liftₐ p.asIdeal (IsScalarTower.toAlgHom R P κ)
      (by
        intro x hx
        rw [hp, RingHom.mem_ker] at hx
        rw [RingHom.mem_ker]
        simpa using hx)
      (by
        intro x hx
        simp only [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
        refine Ne.isUnit fun h0 => hx ?_
        rw [hp, SetLike.mem_coe, RingHom.mem_ker]
        simpa using h0)
  have hφ : ∀ x : P, φ (algebraMap P p.asIdeal.ResidueField x) = algebraMap P κ x := fun x =>
    Ideal.ResidueField.liftₐ_algebraMap _ _ _ _ x
  have hr₀K : algebraMap R p.asIdeal.ResidueField r₀ ≠ 0 := by
    intro h0
    apply hr₀
    rw [← φ.commutes, h0, map_zero]
  obtain ⟨hT, hdim⟩ := hfib _ hr₀K
  refine ringKrullDim_tensor_slice_le g α' _ hT hdim fun hnil => hh ?_
  have h := (mem_nilradical.mp hnil).map (Algebra.TensorProduct.map φ (AlgHom.id R A))
  have heq : (⇑φ ∘ (algebraMap P p.asIdeal.ResidueField ∘ α')) = algebraMap P κ ∘ α' :=
    funext fun o => hφ (α' o)
  rw [map_hyp, heq] at h
  exact mem_nilradical.mpr h

/-- Away from the bad locus, the base change of a hyperplane section to a field has prime
nilradical and dimension `d + 1`. -/
theorem tensor_slice_isPrime_and_dim {P : Type u} [CommRing P] [Algebra R P]
    (α' : Option (Fin n) → P) {c : MvPolynomial (Option (Fin n)) R}
    (hc : ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c ≠ 0 →
        (nilradical (Slice R g β)).IsPrime ∧ ringKrullDim (Slice R g β) = (d + 1 : ℕ))
    (K : Type u) [Field K] [Algebra R K] [Algebra P K] [IsScalarTower R P K]
    (hK : MvPolynomial.aeval (algebraMap P K ∘ α') c ≠ 0) :
    (nilradical (K ⊗[P] Slice R g α')).IsPrime ∧
      ringKrullDim (K ⊗[P] Slice R g α') = (d + 1 : ℕ) := by
  obtain ⟨h1, h2⟩ := hc K _ hK
  let e := (sliceBaseChange R g α' (S' := K)).toRingEquiv
  exact ⟨(Langlands.Algebra.GenericIrreducibilityReduction.nilradical_isPrime_iff_of_ringEquiv
    (A := K ⊗[P] Slice R g α') (B := Slice R g (algebraMap P K ∘ α')) e).mpr h1,
    (ringKrullDim_eq_of_ringEquiv e).trans h2⟩

/-- `langWeil_ring` when every field scalar extension of `B` has prime nilradical and dimension
`e`. -/
theorem langWeil_ring_of_forall {e : ℕ} (hLW : FamilyLangWeilInDimension.{u} e)
    (S B : Type u) [CommRing S] [CommRing B] [Algebra S B] [Algebra.FiniteType ℤ S]
    [Algebra.FiniteType S B]
    (h : ∀ (K : Type u) [Field K] [Algebra S K],
      (nilradical (K ⊗[S] B)).IsPrime ∧ ringKrullDim (K ⊗[S] B) = e) :
    ∃ C : ℝ, 0 < C ∧ ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra S κ],
      |(Nat.card (B →ₐ[S] κ) : ℝ) - (Nat.card κ : ℝ) ^ e| ≤
        C * (Nat.card κ : ℝ) ^ ((e : ℝ) - 1 / 2) :=
  langWeil_ring hLW S B (fun K _ _ => (h K).1) fun _ =>
    hasPureRingDimension_of_isPrime_nilradical (h _).1 (h _).2

/-- Points on a hyperplane in good position, counted by the Lang–Weil estimate for a hyperplane
section over a parameter ring `P`. -/
theorem abs_card_filter_sub_le_of_langWeil {P : Type u} [CommRing P] [Algebra R P]
    (α' : Option (Fin n) → P) {C₁ : ℝ}
    (hC₁ : ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra P κ],
      |(Nat.card (Slice R g α' →ₐ[P] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 1)| ≤
        C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2))
    (κ : Type u) [Field κ] [Finite κ] [Algebra R κ] [Algebra P κ] [IsScalarTower R P κ]
    [Fintype (A →ₐ[R] κ)] [DecidableEq κ] (α : Option (Fin n) → κ)
    (hα : ∀ o, algebraMap P κ (α' o) = α o) :
    |(#(univ.filter fun x : A →ₐ[R] κ => α none + ∑ i, α (some i) * x (g i) = 0) : ℝ) -
        (Nat.card κ : ℝ) ^ (d + 1)| ≤ C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2) := by
  have h := natCard_slice_algHom (R := R) g (S := P) (κ := κ) α'
  simp only [hα] at h
  rw [← h]
  exact hC₁ κ

/-- **The slicing count over one finite field.** Let `κ` be a finite field over `R` such that
`κ ⊗[R] A` has prime nilradical and dimension `d + 2`, and let `c` be a polynomial in the
hyperplane coefficients that stays nonzero over `κ`. If hyperplanes with `c(α) ≠ 0` satisfy the
Lang–Weil estimate in dimension `d + 1` with constant `C₁`, and hyperplanes not containing the
fibre have at most `C₂ (#κ) ^ (d + 1)` points, then `#(A →ₐ[R] κ)` satisfies the estimate in
dimension `d + 2` with constant `2 (2 + D + C₁ + D C₂)`, where `D` is the total degree of `c`. -/
theorem abs_card_sub_le_of_slices {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {n : ℕ}
    (g : Fin n → A) (hg : Algebra.adjoin R (Set.range g) = ⊤) {d : ℕ}
    (c : MvPolynomial (Option (Fin n)) R) {C₁ C₂ : ℝ} (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (κ : Type*) [Field κ] [Fintype κ] [DecidableEq κ] [Algebra R κ] [Fintype (A →ₐ[R] κ)]
    (hc : MvPolynomial.map (algebraMap R κ) c ≠ 0)
    (hT : (nilradical (κ ⊗[R] A)).IsPrime) (hdim : ringKrullDim (κ ⊗[R] A) = (d + 2 : ℕ))
    (hgood : ∀ α : Option (Fin n) → κ, MvPolynomial.aeval α c ≠ 0 →
      |(#(univ.filter fun x : A →ₐ[R] κ => α none + ∑ i, α (some i) * x (g i) = 0) : ℝ) -
        (Fintype.card κ : ℝ) ^ (d + 1)| ≤
          C₁ * (Fintype.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2))
    (hbad : ∀ α : Option (Fin n) → κ, hyp R g α ∉ nilradical (κ ⊗[R] A) →
      (#(univ.filter fun x : A →ₐ[R] κ => α none + ∑ i, α (some i) * x (g i) = 0) : ℝ) ≤
        C₂ * (Fintype.card κ : ℝ) ^ (d + 1)) :
    |(Fintype.card (A →ₐ[R] κ) : ℝ) - (Fintype.card κ : ℝ) ^ (d + 2)| ≤
      2 * (2 + c.totalDegree + C₁ + c.totalDegree * C₂) *
        (Fintype.card κ : ℝ) ^ (((d + 2 : ℕ) : ℝ) - 1 / 2) := by
  classical
  set q := Fintype.card κ with hq
  let Nα : (Option (Fin n) → κ) → ℝ := fun α =>
    (#(univ.filter fun x : A →ₐ[R] κ => α none + ∑ i, α (some i) * x (g i) = 0) : ℝ)
  let Λ := univ.filter (fun α : Option (Fin n) → κ => (fun i => α (some i)) ≠ 0)
  let Λc := Λ.filter (fun α => hyp R g α ∈ nilradical (κ ⊗[R] A))
  let Λb := Λ.filter (fun α => hyp R g α ∉ nilradical (κ ⊗[R] A) ∧ MvPolynomial.aeval α c = 0)
  have hq2 : (2 : ℝ) ≤ q := by
    have : 1 < q := Fintype.one_lt_card
    exact_mod_cast this
  have hqn : 1 ≤ q ^ n := Nat.one_le_pow _ _ Fintype.card_pos
  refine abs_sub_pow_le_of_slices Λ Λc Λb (filter_subset _ _) (filter_subset _ _) ?_ Nα
    (Fintype.card (A →ₐ[R] κ)) q ((q : ℝ) ^ n) C₁ C₂ c.totalDegree d hq2 hC₁ hC₂
    (Nat.cast_nonneg _) ?_ ?_ ?_ ?_ (fun _ _ => Nat.cast_nonneg _) ?_ ?_ ?_
  · exact disjoint_filter.mpr fun α _ h1 h2 => h2.1 h1
  · rw [card_filter_linear_ne_zero, Nat.cast_mul, Nat.cast_sub hqn, Nat.cast_pow, Nat.cast_one]
    ring
  · have h := sum_card_filter_hyperplane (ι := A →ₐ[R] κ) n (fun x i => x (g i))
    simp only [Nα]
    rw [← Nat.cast_sum, h, Nat.cast_mul, Nat.cast_sub hqn, Nat.cast_pow, Nat.cast_one]
  · intro α hα
    have hnil := (mem_filter.mp hα).2
    simp only [Nα]
    rw [filter_true_of_mem, card_univ]
    intro x _
    have h := lift_hyp (R := R) (g := g) (S := κ) (κ := κ) α x
    simp only [Algebra.algebraMap_self, RingHom.id_apply] at h
    rw [← h]
    exact ((mem_nilradical.mp hnil).map _).eq_zero
  · have hadj : Algebra.adjoin κ (Set.range fun i => (1 : κ) ⊗ₜ[R] g i) = ⊤ := by
      rw [Set.range_comp' (fun x : A => (1 : κ) ⊗ₜ[R] x) g]
      exact Algebra.TensorProduct.adjoin_one_tmul_image_eq_top _ hg
    have hpos : 0 < ringKrullDim (κ ⊗[R] A) := by
      rw [hdim, ← WithBot.coe_natCast, ← WithBot.coe_zero, WithBot.coe_lt_coe]
      exact_mod_cast (by omega : 0 < d + 2)
    obtain ⟨i₀, hi₀⟩ := exists_forall_sub_algebraMap_not_mem_nilradical _ hadj hpos
    have h := card_filter_mem_ideal_mul_le (κ := κ) (nilradical (κ ⊗[R] A)) hT.ne_top n
      (fun i => (1 : κ) ⊗ₜ[R] g i) i₀ hi₀
    have hΛc : Λc = univ.filter (fun α : Option (Fin n) → κ => (fun i => α (some i)) ≠ 0 ∧
        algebraMap κ (κ ⊗[R] A) (α none) + ∑ i, α (some i) • ((1 : κ) ⊗ₜ[R] g i) ∈
          nilradical (κ ⊗[R] A)) := by
      simp only [Λc, Λ, filter_filter, hyp_eq_algebraMap_add_sum_smul]
    rw [hΛc]
    exact_mod_cast h
  · intro α hα
    exact hbad α (mem_filter.mp hα).2.1
  · have hsub : Λb ⊆ univ.filter (fun α : Option (Fin n) → κ =>
        MvPolynomial.eval α (MvPolynomial.map (algebraMap R κ) c) = 0) := by
      intro α hα
      rw [mem_filter, MvPolynomial.eval_map, ← MvPolynomial.aeval_def]
      exact ⟨mem_univ _, (mem_filter.mp hα).2.2⟩
    have h1 := card_filter_eval_eq_zero_le hc n (by simp)
    have h2 := totalDegree_map_le (algebraMap R κ) c
    have h3 : #Λb ≤ c.totalDegree * q ^ n :=
      (card_le_card hsub).trans (h1.trans (Nat.mul_le_mul_right _ h2))
    exact_mod_cast h3
  · intro α _ hαc hαb
    refine hgood α fun h0 => hαb (mem_filter.mpr ⟨‹_›, fun hnil => hαc ?_, h0⟩)
    exact mem_filter.mpr ⟨‹_›, hnil⟩

end Families

/-- An algebra whose generic fibre is nonzero has a point with values in a field into which the
base domain injects. -/
theorem exists_field_algHom {R A : Type u} [CommRing R] [IsDomain R] [CommRing A] [Algebra R A]
    [Nontrivial (FractionRing R ⊗[R] A)] :
    ∃ (F : Type u) (_ : Field F) (_ : Algebra R F), Function.Injective (algebraMap R F) ∧
      Nonempty (A →ₐ[R] F) := by
  obtain ⟨m, hm⟩ := Ideal.exists_maximal (FractionRing R ⊗[R] A)
  let _ := Ideal.Quotient.field m
  refine ⟨(FractionRing R ⊗[R] A) ⧸ m, inferInstance, inferInstance, ?_,
    ⟨(Ideal.Quotient.mkₐ R m).comp Algebra.TensorProduct.includeRight⟩⟩
  rw [IsScalarTower.algebraMap_eq R (FractionRing R) ((FractionRing R ⊗[R] A) ⧸ m),
    RingHom.coe_comp]
  exact (RingHom.injective (algebraMap (FractionRing R) _)).comp
    (IsFractionRing.injective R (FractionRing R))

/-- A polynomial that becomes a unit in `P` does not vanish at the images of the variables in a
field over `P`. -/
theorem aeval_algebraMap_ne_zero {R P K σ : Type*} [CommRing R] [CommRing P] [Field K]
    [Algebra R P] [Algebra R K] [Algebra P K] [IsScalarTower R P K]
    [Algebra (MvPolynomial σ R) P] [IsScalarTower R (MvPolynomial σ R) P]
    {c : MvPolynomial σ R} (hu : IsUnit (algebraMap (MvPolynomial σ R) P c)) :
    MvPolynomial.aeval (algebraMap P K ∘ algebraMap (MvPolynomial σ R) P ∘ MvPolynomial.X) c ≠
      0 := by
  have h := DFunLike.congr_fun (MvPolynomial.aeval_unique ((IsScalarTower.toAlgHom R P K).comp
    (IsScalarTower.toAlgHom R (MvPolynomial σ R) P))) c
  change MvPolynomial.aeval (⇑((IsScalarTower.toAlgHom R P K).comp
    (IsScalarTower.toAlgHom R (MvPolynomial σ R) P)) ∘ MvPolynomial.X) c ≠ 0
  rw [← h]
  exact (hu.map (algebraMap P K)).ne_zero

section Core

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] {n : ℕ} (g : Fin n → A) {d : ℕ}

local notation "𝒫" => MvPolynomial (Option (Fin n)) R

/-- Hyperplanes on which a polynomial `c` does not vanish are counted by the Lang–Weil estimate
for the universal hyperplane section over `𝒫[1/c]`. -/
theorem abs_card_filter_sub_le_of_away (c : 𝒫) {C₁ : ℝ}
    (hC₁ : ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra (Localization.Away c) κ],
      |(Nat.card (Slice R g (algebraMap 𝒫 (Localization.Away c) ∘ MvPolynomial.X) →ₐ[
          Localization.Away c] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 1)| ≤
        C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2))
    (κ : Type u) [Field κ] [Finite κ] [Algebra R κ] [Fintype (A →ₐ[R] κ)] [DecidableEq κ]
    (α : Option (Fin n) → κ) (hα : MvPolynomial.aeval α c ≠ 0) :
    |(#(univ.filter fun x : A →ₐ[R] κ => α none + ∑ i, α (some i) * x (g i) = 0) : ℝ) -
        (Nat.card κ : ℝ) ^ (d + 1)| ≤ C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2) := by
  let _ : Algebra 𝒫 κ := (MvPolynomial.aeval α).toRingHom.toAlgebra
  have hu : IsUnit (algebraMap 𝒫 κ c) := hα.isUnit
  let _ : Algebra (Localization.Away c) κ := (IsLocalization.Away.lift c hu).toAlgebra
  have hlift : ∀ p : 𝒫, algebraMap (Localization.Away c) κ (algebraMap 𝒫 _ p) =
      MvPolynomial.aeval α p := IsLocalization.Away.lift_eq c hu
  have : IsScalarTower R (Localization.Away c) κ := IsScalarTower.of_algebraMap_eq fun r => by
    rw [IsScalarTower.algebraMap_apply R 𝒫 (Localization.Away c), hlift,
      MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C]
  exact abs_card_filter_sub_le_of_langWeil g (algebraMap 𝒫 (Localization.Away c) ∘ MvPolynomial.X)
    hC₁ κ α fun o => by rw [Function.comp_apply, hlift, MvPolynomial.aeval_X]

/-- Hyperplanes not containing the fibre are bounded by the uniform upper bound for the universal
hyperplane section over `𝒫`. -/
theorem card_filter_le_of_upperBound {r₀ : R}
    (hfib : ∀ (K : Type u) [Field K] [Algebra R K], algebraMap R K r₀ ≠ 0 →
      (nilradical (K ⊗[R] A)).IsPrime ∧ ringKrullDim (K ⊗[R] A) = (d + 2 : ℕ))
    {C₂ : ℝ} (hC₂ : ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra 𝒫 κ] (e : ℕ),
      (∀ p : PrimeSpectrum 𝒫, p.asIdeal = RingHom.ker (algebraMap 𝒫 κ) →
        ringKrullDim (p.asIdeal.Fiber (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫))) ≤ e) →
      (Nat.card (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫) →ₐ[𝒫] κ) : ℝ) ≤
        C₂ * (Nat.card κ : ℝ) ^ e)
    (κ : Type u) [Field κ] [Finite κ] [Algebra R κ] [Fintype (A →ₐ[R] κ)] [DecidableEq κ]
    (hr₀ : algebraMap R κ r₀ ≠ 0) (α : Option (Fin n) → κ)
    (hh : hyp R g α ∉ nilradical (κ ⊗[R] A)) :
    (#(univ.filter fun x : A →ₐ[R] κ => α none + ∑ i, α (some i) * x (g i) = 0) : ℝ) ≤
      C₂ * (Nat.card κ : ℝ) ^ (d + 1) := by
  let _ : Algebra 𝒫 κ := (MvPolynomial.aeval α).toRingHom.toAlgebra
  have hX : ∀ o, algebraMap 𝒫 κ (MvPolynomial.X o) = α o := fun o => MvPolynomial.aeval_X α o
  have : IsScalarTower R 𝒫 κ := IsScalarTower.of_algebraMap_eq fun r => by
    change _ = MvPolynomial.aeval α (algebraMap R 𝒫 r)
    rw [MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C]
  have hX' : algebraMap 𝒫 κ ∘ (MvPolynomial.X : Option (Fin n) → 𝒫) = α := funext hX
  have h := natCard_slice_le_of_upperBound g MvPolynomial.X hfib hC₂ κ hr₀ (by rwa [hX'])
  rw [natCard_slice_algHom] at h
  simpa only [hX] using h

/-- An algebra of finite type over a ring of finite type over `ℤ` is of finite type over `ℤ`. -/
theorem finiteType_int_of_finiteType (S T : Type*) [CommRing S] [CommRing T] [Algebra S T]
    [Algebra.FiniteType ℤ S] [Algebra.FiniteType S T] : Algebra.FiniteType ℤ T :=
  Algebra.FiniteType.trans (S := S) inferInstance inferInstance

/-- The uniform upper bound for the universal hyperplane section over `𝒫`. -/
theorem exists_upperBound_slice [Algebra.FiniteType ℤ R] [Algebra.FiniteType R A]
    (hUB : FamilyPointUpperBoundStatement.{u}) :
    ∃ C₂ : ℝ, 0 < C₂ ∧ ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra 𝒫 κ] (e : ℕ),
      (∀ p : PrimeSpectrum 𝒫, p.asIdeal = RingHom.ker (algebraMap 𝒫 κ) →
        ringKrullDim (p.asIdeal.Fiber (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫))) ≤ e) →
      (Nat.card (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫) →ₐ[𝒫] κ) : ℝ) ≤
        C₂ * (Nat.card κ : ℝ) ^ e := by
  have := finiteType_int_of_finiteType R 𝒫
  exact upperBound_ring hUB 𝒫 _

/-- The Lang–Weil estimate in dimension `d + 1` for a hyperplane section over a parameter ring
`P`, when the polynomial `c` vanishes at no field point of `P` and hyperplane sections over
fields off the zero locus of `c` have prime nilradical and dimension `d + 1`. -/
theorem exists_langWeil_slice (hLW : FamilyLangWeilInDimension.{u} (d + 1)) {P : Type u}
    [CommRing P] [Algebra R P] [Algebra.FiniteType ℤ P] (α' : Option (Fin n) → P)
    [Algebra.FiniteType P (Slice R g α')] {c : MvPolynomial (Option (Fin n)) R}
    (hc : ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c ≠ 0 →
        (nilradical (Slice R g β)).IsPrime ∧ ringKrullDim (Slice R g β) = (d + 1 : ℕ))
    (hne : ∀ (K : Type u) [Field K] [Algebra R K] [Algebra P K] [IsScalarTower R P K],
      MvPolynomial.aeval (algebraMap P K ∘ α') c ≠ 0) :
    ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra P κ],
      |(Nat.card (Slice R g α' →ₐ[P] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 1)| ≤
        C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2) := by
  refine langWeil_ring_of_forall hLW P (Slice R g α') fun K _ _ => ?_
  let _ : Algebra R K := ((algebraMap P K).comp (algebraMap R P)).toAlgebra
  have : IsScalarTower R P K := IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact tensor_slice_isPrime_and_dim g α' hc K (hne K)

/-- The Lang–Weil estimate in dimension `d + 1` for the universal hyperplane section over
`𝒫[1/c]`, where `c` is a polynomial off whose zero locus hyperplane sections over fields have
prime nilradical and dimension `d + 1`. -/
theorem exists_langWeil_away [Algebra.FiniteType ℤ R] [Algebra.FiniteType R A]
    (hLW : FamilyLangWeilInDimension.{u} (d + 1)) (c : 𝒫)
    (hc : ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c ≠ 0 →
        (nilradical (Slice R g β)).IsPrime ∧ ringKrullDim (Slice R g β) = (d + 1 : ℕ)) :
    ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra (Localization.Away c) κ],
      |(Nat.card (Slice R g (algebraMap 𝒫 (Localization.Away c) ∘ MvPolynomial.X) →ₐ[
          Localization.Away c] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 1)| ≤
        C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2) := by
  have := finiteType_int_of_finiteType R 𝒫
  have := finiteType_int_of_finiteType 𝒫 (Localization.Away c)
  have hu : IsUnit (algebraMap 𝒫 (Localization.Away c) c) :=
    IsLocalization.Away.algebraMap_isUnit c
  exact exists_langWeil_slice g hLW (algebraMap 𝒫 (Localization.Away c) ∘ MvPolynomial.X) hc
    fun K _ _ _ _ => aeval_algebraMap_ne_zero hu

/-- The count over one finite field, from the constants of the two universal hyperplane
sections. -/
theorem abs_natCard_sub_le_of_constants (hg : Algebra.adjoin R (Set.range g) = ⊤) {r₀ : R}
    (hfib : ∀ (K : Type u) [Field K] [Algebra R K], algebraMap R K r₀ ≠ 0 →
      (nilradical (K ⊗[R] A)).IsPrime ∧ ringKrullDim (K ⊗[R] A) = (d + 2 : ℕ))
    (c : 𝒫) {C₁ C₂ : ℝ} (hC₁0 : 0 ≤ C₁) (hC₂0 : 0 ≤ C₂)
    (hC₁ : ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra (Localization.Away c) κ],
      |(Nat.card (Slice R g (algebraMap 𝒫 (Localization.Away c) ∘ MvPolynomial.X) →ₐ[
          Localization.Away c] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 1)| ≤
        C₁ * (Nat.card κ : ℝ) ^ (((d + 1 : ℕ) : ℝ) - 1 / 2))
    (hC₂ : ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra 𝒫 κ] (e : ℕ),
      (∀ p : PrimeSpectrum 𝒫, p.asIdeal = RingHom.ker (algebraMap 𝒫 κ) →
        ringKrullDim (p.asIdeal.Fiber (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫))) ≤ e) →
      (Nat.card (Slice R g (MvPolynomial.X : Option (Fin n) → 𝒫) →ₐ[𝒫] κ) : ℝ) ≤
        C₂ * (Nat.card κ : ℝ) ^ e)
    (κ : Type u) [Field κ] [Finite κ] [Algebra R κ] (hr₀ : algebraMap R κ r₀ ≠ 0)
    (hmap : MvPolynomial.map (algebraMap R κ) c ≠ 0) :
    |(Nat.card (A →ₐ[R] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 2)| ≤
      2 * (2 + c.totalDegree + C₁ + c.totalDegree * C₂) *
        (Nat.card κ : ℝ) ^ (((d + 2 : ℕ) : ℝ) - 1 / 2) := by
  classical
  obtain ⟨hT, hdim⟩ := hfib κ hr₀
  let _ : Fintype κ := Fintype.ofFinite κ
  have : Finite (A →ₐ[R] κ) := finite_algHom_of_adjoin hg
  let _ : Fintype (A →ₐ[R] κ) := Fintype.ofFinite _
  have key := abs_card_sub_le_of_slices g hg c hC₁0 hC₂0 κ hmap hT hdim
    (fun α hα => by
      have h := abs_card_filter_sub_le_of_away g c hC₁ κ α hα
      rwa [Nat.card_eq_fintype_card] at h)
    (fun α hα => by
      have h := card_filter_le_of_upperBound g hfib hC₂ κ hr₀ α hα
      rwa [Nat.card_eq_fintype_card] at h)
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  exact key

/-- **The slicing step for an affine family over an integral base.** Let `R` be a domain of
finite type over `ℤ` and `A` an `R`-algebra generated by `g`, such that for some `r₀ ≠ 0` every
field `K` over `R` in which `r₀` does not vanish gives a ring `K ⊗[R] A` with prime nilradical
and dimension `d + 2`. Given Bertini's theorem, the uniform upper bound and the Lang–Weil
estimate in dimension `d + 1`, there are `r ≠ 0` and `C > 0` such that
`|#(A →ₐ[R] κ) - (#κ) ^ (d + 2)| ≤ C (#κ) ^ (d + 2 - 1/2)` for every finite field `κ` over `R` in
which `r` does not vanish. -/
theorem abs_natCard_sub_le_of_slicing [IsDomain R] [Algebra.FiniteType ℤ R]
    (hB : BertiniGenericHyperplaneStatement.{u}) (hUB : FamilyPointUpperBoundStatement.{u})
    (hLW : FamilyLangWeilInDimension.{u} (d + 1)) (hg : Algebra.adjoin R (Set.range g) = ⊤)
    {r₀ : R} (hr₀ : r₀ ≠ 0)
    (hfib : ∀ (K : Type u) [Field K] [Algebra R K], algebraMap R K r₀ ≠ 0 →
      (nilradical (K ⊗[R] A)).IsPrime ∧ ringKrullDim (K ⊗[R] A) = (d + 2 : ℕ)) :
    ∃ r : R, r ≠ 0 ∧ ∃ C : ℝ, 0 < C ∧ ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra R κ],
      algebraMap R κ r ≠ 0 →
        |(Nat.card (A →ₐ[R] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 2)| ≤
          C * (Nat.card κ : ℝ) ^ (((d + 2 : ℕ) : ℝ) - 1 / 2) := by
  classical
  have : Algebra.FiniteType R A :=
    ⟨⟨univ.image g, by rw [coe_image, coe_univ, Set.image_univ, hg]⟩⟩
  have : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing ℤ R
  have hr₀F : algebraMap R (FractionRing R) r₀ ≠ 0 := fun h =>
    hr₀ (IsFractionRing.injective R (FractionRing R) (by rw [h, map_zero]))
  obtain ⟨hT0, hdim0⟩ := hfib (FractionRing R) hr₀F
  have : Nontrivial (FractionRing R ⊗[R] A) := ⟨⟨0, 1, fun h =>
    hT0.ne_top ((Ideal.eq_top_iff_one _).mpr (by rw [← h]; exact zero_mem _))⟩⟩
  obtain ⟨F, _, _, hF, ⟨θ⟩⟩ := exists_field_algHom (R := R) (A := A)
  have hdim2 : 2 ≤ ringKrullDim (FractionRing R ⊗[R] A) := by
    rw [hdim0]
    exact_mod_cast (by omega : 2 ≤ d + 2)
  obtain ⟨c₁, hc₁0, hc₁⟩ := exists_ne_zero_forall_nilradical_slice_isPrime g hB hg
    (fun K _ _ hK => (hfib K fun h => hr₀ (hK (by rw [h, map_zero]))).1) hdim2
  obtain ⟨c₂, hc₂0, hc₂⟩ := exists_ne_zero_forall_hyp_not_mem_nilradical g hF θ
  set c : 𝒫 := MvPolynomial.C r₀ * (c₁ * c₂) with hcdef
  have hc : ∀ (K : Type u) [Field K] [Algebra R K] (β : Option (Fin n) → K),
      MvPolynomial.aeval β c ≠ 0 →
        (nilradical (Slice R g β)).IsPrime ∧ ringKrullDim (Slice R g β) = (d + 1 : ℕ) :=
    fun K _ _ β hβ => slice_isPrime_and_dim g hfib hc₁ (fun K _ _ β => hc₂ K β) K β hβ
  have hc0 : c ≠ 0 :=
    mul_ne_zero (by rwa [Ne, MvPolynomial.C_eq_zero]) (mul_ne_zero hc₁0 hc₂0)
  obtain ⟨m0, hm0⟩ := MvPolynomial.ne_zero_iff.mp hc0
  obtain ⟨C₂, hC₂0, hC₂⟩ := exists_upperBound_slice (R := R) g hUB
  obtain ⟨C₁, hC₁0, hC₁⟩ := exists_langWeil_away g hLW c hc
  refine ⟨r₀ * c.coeff m0, mul_ne_zero hr₀ hm0,
    2 * (2 + c.totalDegree + C₁ + c.totalDegree * C₂), by positivity, fun κ _ _ _ hκ => ?_⟩
  rw [map_mul] at hκ
  obtain ⟨hr₀κ, hmκ⟩ := mul_ne_zero_iff.mp hκ
  have hmap : MvPolynomial.map (algebraMap R κ) c ≠ 0 := fun h =>
    hmκ (by rw [← MvPolynomial.coeff_map, h]; rfl)
  exact abs_natCard_sub_le_of_constants g hg hfib c hC₁0.le hC₂0.le hC₁ hC₂ κ hr₀κ hmap

end Core

/-- **The slicing step for affine families.** Given Bertini's theorem, the uniform upper bound
and the uniform Lang–Weil estimate in dimension `d + 1`: for every domain `R` of finite type over
`ℤ`, every `R`-algebra `A` of finite type and every `r₀ ≠ 0` such that `K ⊗[R] A` has prime
nilradical and dimension `d + 2` for all fields `K` over `R` in which `r₀` does not vanish, there
are `r ≠ 0` and `C > 0` with `|#(A →ₐ[R] κ) - (#κ) ^ (d + 2)| ≤ C (#κ) ^ (d + 2 - 1/2)` for every
finite field `κ` over `R` in which `r` does not vanish. -/
theorem affineFamilyLangWeil_slicing (hB : BertiniGenericHyperplaneStatement.{u})
    (hUB : FamilyPointUpperBoundStatement.{u}) (d : ℕ)
    (hLW : FamilyLangWeilInDimension.{u} (d + 1)) :
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra.FiniteType ℤ R]
      (A : Type u) [CommRing A] [Algebra R A] [Algebra.FiniteType R A] (r₀ : R), r₀ ≠ 0 →
      (∀ (K : Type u) [Field K] [Algebra R K], algebraMap R K r₀ ≠ 0 →
        (nilradical (K ⊗[R] A)).IsPrime ∧
          ringKrullDim (K ⊗[R] A) = ((d + 2 : ℕ) : WithBot ℕ∞)) →
      ∃ r : R, r ≠ 0 ∧ ∃ C : ℝ, 0 < C ∧ ∀ (κ : Type u) [Field κ] [Finite κ] [Algebra R κ],
        algebraMap R κ r ≠ 0 →
          |(Nat.card (A →ₐ[R] κ) : ℝ) - (Nat.card κ : ℝ) ^ (d + 2)| ≤
            C * (Nat.card κ : ℝ) ^ (((d + 2 : ℕ) : ℝ) - 1 / 2) := by
  intro R _ _ _ A _ _ hA r₀ hr₀ hfib
  obtain ⟨m, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hA
  have hg : Algebra.adjoin R (Set.range (f ∘ MvPolynomial.X)) = ⊤ := by
    rw [Set.range_comp, ← AlgHom.map_adjoin, MvPolynomial.adjoin_range_X, Algebra.map_top]
    exact (AlgHom.range_eq_top f).mpr hf
  exact abs_natCard_sub_le_of_slicing (f ∘ MvPolynomial.X) hB hUB hLW hg hr₀ hfib

end Langlands.AlgebraicGeometry.LangWeil.Slicing
