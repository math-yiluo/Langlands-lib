import Langlands.AlgebraicGeometry.EtaleEquivalenceRelation
import Mathlib.RingTheory.RingHom.Etale
import Mathlib.RingTheory.TensorProduct.Basic

/-! # Quasi-coherent modules on affine étale equivalence relations, in ring form

Let `U = Spec B` and `R = Spec C` be affine, with `s, t : R ⟶ U` and `j = (t, s)` a closed
immersion. Ring maps `C →+* T` are the `Spec T`-valued points of `R`. We write the source map
`s` as the algebra map `B → C` and keep `t : B →+* C` as a separate ring map.

* `RingEtaleEquivalenceRelation t`: the ring form of an étale equivalence relation with `j` a
  closed immersion (Stacks Tags 022P and 02WS).
* `GroupoidCoaction t M`: a quasi-coherent module on the groupoid (Stacks Tag 03LI) with
  underlying `B`-module `M`, written through its coaction `θ m = α (1 ⊗ m)`.
* `GroupoidCoaction.invariants`, `GroupoidCoaction.IsHom`, `GroupoidCoaction.IsAcyclic`.
* `EtaleEquivalenceRelation.ComodulesAcyclic E` for a Library étale equivalence relation.
-/

universe u v

open CategoryTheory CategoryTheory.Limits TensorProduct
open AlgebraicGeometry

namespace Langlands.AlgebraicGeometry

section Ring

variable {B C : Type u} [CommRing B] [CommRing C] [Algebra B C] (t : B →+* C)

/-- The ring form of an étale equivalence relation on `Spec B` with relation scheme `Spec C`,
source map `Spec (algebraMap B C)` and target map `Spec t`, for which `j = (t, s)` is a closed
immersion: `C` is generated by `t(B)` as a `B`-algebra (so `B ⊗ B → C` is surjective), the
`Spec T`-valued points of `Spec C` form an equivalence relation on the `Spec T`-valued points
of `Spec B` for every ring `T`, and both maps are étale. A ring map `φ : C →+* T` is the point
`r` with `t r = φ ∘ t` and `s r = φ ∘ algebraMap B C`. -/
structure RingEtaleEquivalenceRelation : Prop where
  /-- `C` is generated by `t(B)` over `B`: the map `B ⊗ B → C` is surjective. -/
  adjoin_range_eq_top : Algebra.adjoin B (Set.range t) = ⊤
  /-- Reflexivity: every pair `(a, a)` is a point of `Spec C`. -/
  refl : ∀ (T : Type u) [CommRing T] (a : B →+* T),
    ∃ φ : C →+* T, φ.comp t = a ∧ φ.comp (algebraMap B C) = a
  /-- Symmetry: with `(t r, s r)` the pair `(s r, t r)` is a point of `Spec C`. -/
  symm : ∀ (T : Type u) [CommRing T] (φ : C →+* T),
    ∃ ψ : C →+* T, ψ.comp t = φ.comp (algebraMap B C) ∧ ψ.comp (algebraMap B C) = φ.comp t
  /-- Transitivity: `(x, y)` and `(y, z)` give `(x, z)`. -/
  trans : ∀ (T : Type u) [CommRing T] (φ ψ : C →+* T),
    φ.comp (algebraMap B C) = ψ.comp t →
      ∃ χ : C →+* T, χ.comp t = φ.comp t ∧ χ.comp (algebraMap B C) = ψ.comp (algebraMap B C)
  /-- The source map is étale. -/
  etale_algebraMap : (algebraMap B C).Etale
  /-- The target map is étale. -/
  etale_t : t.Etale

variable (M : Type v) [AddCommGroup M] [Module B M]

/-- For a `t`-semilinear map `θ : M → C ⊗[B] M` and composable points `φ₁ = (x, y)`,
`φ₂ = (y, z)` of `Spec C` with values in `T` (so `φ₁ ∘ s = φ₂ ∘ t`), the composite
`α_{φ₂} ∘ α_{φ₁}`: it sends `c ⊗ m` to `φ₁ c • (φ₂ ⊗ id) (θ m)`. Here `T` is a `B`-algebra
through `φ₂ ∘ s`. -/
def coactionCompose {T : Type u} [CommRing T] [Algebra B T] (θ : M →+ C ⊗[B] M)
    (hθ : ∀ (b : B) (m : M), θ (b • m) = t b • θ m)
    (φ₁ : C →+* T) (φ₂ : C →ₐ[B] T) (h : φ₁.comp (algebraMap B C) = (φ₂ : C →+* T).comp t) :
    C ⊗[B] M →+ T ⊗[B] M :=
  liftAddHom
    { toFun := fun c =>
        { toFun := fun m => φ₁ c • LinearMap.rTensor M φ₂.toLinearMap (θ m)
          map_zero' := by simp
          map_add' := fun m m' => by simp [smul_add] }
      map_zero' := by ext m; simp
      map_add' := fun c c' => by ext m; simp [add_smul] }
    (fun b c m => by
      have key : ∀ (c' : C) (x : C ⊗[B] M), LinearMap.rTensor M φ₂.toLinearMap (c' • x) =
          φ₂ c' • LinearMap.rTensor M φ₂.toLinearMap x := by
        intro c' x
        induction x with
        | tmul c'' m'' => simp [smul_tmul', smul_eq_mul]
        | add x y hx hy => simp [smul_add, hx, hy]
      have hb : φ₁ (algebraMap B C b) = φ₂ (t b) := by
        simpa using congrArg (fun f => f b) h
      simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, hθ, key, smul_smul]
      rw [Algebra.smul_def, map_mul, hb, mul_comm])

/-- A quasi-coherent module on the affine groupoid `(Spec B, Spec C, s, t)` (Stacks
Definition 39.14.1, Tag 03LI) with underlying `B`-module `M`, written through its coaction.
The descent datum `α : t^*M → s^*M` is the `C`-linear extension of `θ`, so `θ (b • m) = t b • θ m`.
The two conditions of the definition are required at every point: `α` is the identity at every
point of the diagonal (Tag 03LI (2)), and `α_{φ₃} = α_{φ₂} ∘ α_{φ₁}` whenever
`φ₁ = (x, y)`, `φ₂ = (y, z)` and `φ₃ = (x, z)` (the cocycle condition, Tag 03LI (1)). -/
structure GroupoidCoaction where
  /-- The coaction `θ m = α (1 ⊗ m)`. -/
  coaction : M →+ C ⊗[B] M
  /-- `θ` is semilinear for `t`. -/
  map_smul : ∀ (b : B) (m : M), coaction (b • m) = t b • coaction m
  /-- `α` is the identity at every point of the diagonal. -/
  counit : ∀ (T : Type u) [CommRing T] [Algebra B T] (φ : C →ₐ[B] T),
    (φ : C →+* T).comp t = algebraMap B T →
      ∀ m : M, LinearMap.rTensor M φ.toLinearMap (coaction m) = (1 : T) ⊗ₜ m
  /-- The cocycle condition at all composable points. -/
  coassoc : ∀ (T : Type u) [CommRing T] [Algebra B T] (φ₁ : C →+* T) (φ₂ φ₃ : C →ₐ[B] T)
    (h : φ₁.comp (algebraMap B C) = (φ₂ : C →+* T).comp t),
    (φ₃ : C →+* T).comp t = φ₁.comp t →
      ∀ m : M, LinearMap.rTensor M φ₃.toLinearMap (coaction m) =
        coactionCompose t M coaction map_smul φ₁ φ₂ h (coaction m)

variable {t M}

namespace GroupoidCoaction

/-- The additive subgroup of invariant elements `{m | θ.coaction m = 1 ⊗ m}`. -/
def invariants (θ : GroupoidCoaction t M) : AddSubgroup M where
  carrier := {m | θ.coaction m = (1 : C) ⊗ₜ m}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq] at *
    rw [map_add, ha, hb, tmul_add]
  neg_mem' := by
    intro a ha
    simp only [Set.mem_ofPred_eq] at *
    rw [map_neg, ha, tmul_neg]

/-- A `B`-linear map `f : M → N` is a morphism of modules on the groupoid: `θ_N ∘ f = (C ⊗ f) ∘ θ_M`. -/
def IsHom {N : Type v} [AddCommGroup N] [Module B N] (θM : GroupoidCoaction t M)
    (θN : GroupoidCoaction t N) (f : M →ₗ[B] N) : Prop :=
  ∀ m : M, θN.coaction (f m) = LinearMap.lTensor C f (θM.coaction m)

/-- `θ` is acyclic: for every short exact sequence `0 → M → G → Q → 0` of modules on the groupoid,
every invariant element of `Q` lifts to an invariant element of `G`. This predicate is internal
to the planned proof of Stacks Lemma 69.17.3; no comparison with cohomology is formalized. -/
def IsAcyclic (θ : GroupoidCoaction t M) : Prop :=
  ∀ (G Q : Type v) [AddCommGroup G] [Module B G] [AddCommGroup Q] [Module B Q]
    (θG : GroupoidCoaction t G) (θQ : GroupoidCoaction t Q) (i : M →ₗ[B] G) (p : G →ₗ[B] Q),
    θ.IsHom θG i → θG.IsHom θQ p → Function.Injective i → Function.Surjective p →
      LinearMap.range i = LinearMap.ker p →
        ∀ q ∈ θQ.invariants, ∃ g ∈ θG.invariants, p g = q

end GroupoidCoaction

end Ring

namespace EtaleEquivalenceRelation

/-- Every module on the groupoid of `E`, in ring form with `B = Γ(E.U, ⊤)`, `C = Γ(E.R, ⊤)`,
source map `E.s.appTop` and target map `E.t.appTop`, is acyclic. Meaningful when `E.U` and
`E.R` are affine and `j = (t, s)` is a closed immersion. This is an internal predicate for the
planned proof of Stacks Lemma 69.17.3. -/
def ComodulesAcyclic (E : EtaleEquivalenceRelation.{u}) : Prop :=
  letI : Algebra Γ(E.U, ⊤) Γ(E.R, ⊤) := E.s.appTop.hom.toAlgebra
  ∀ (M : Type u) [AddCommGroup M] [Module Γ(E.U, ⊤) M]
    (θ : GroupoidCoaction E.t.appTop.hom M), θ.IsAcyclic

end EtaleEquivalenceRelation

end Langlands.AlgebraicGeometry
