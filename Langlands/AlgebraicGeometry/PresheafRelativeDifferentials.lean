import Mathlib.Algebra.Category.ModuleCat.Differentials.Presheaf
import Mathlib.AlgebraicGeometry.Scheme

/-!
# Relative differentials for a general pullback functor of ring presheaves

Let `F : C ⥤ D`, `S : Cᵒᵖ ⥤ CommRingCat`, `R : Dᵒᵖ ⥤ CommRingCat` and
`φ : S ⟶ F.op ⋙ R`. Mathlib's `PresheafOfModulesOfCommRing.Derivation` defines
`φ`-derivations, but constructs the presheaf of relative differentials only when
`F` is the identity functor.

For every `Y : Dᵒᵖ` we take the subring `pullbackSubring φ Y` of `R.obj Y`
generated by all restrictions `R.map f (φ.app X a)` along morphisms
`f : op (F.obj X.unop) ⟶ Y`. These subrings form a presheaf of commutative rings
`pullbackRing φ` on `D` with an inclusion `pullbackRingι φ : pullbackRing φ ⟶ R`.
A `φ`-derivation and a `pullbackRingι φ`-derivation have the same data, so the
presheaf of relative differentials of `φ` is Mathlib's presheaf of relative
differentials of `pullbackRingι φ`.
-/

universe v u v₁ v₂ u₁ u₂

open CategoryTheory

namespace Langlands.PresheafDifferentials

open PresheafOfModulesOfCommRing

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  {S : Cᵒᵖ ⥤ CommRingCat.{u}} {F : C ⥤ D} {R : Dᵒᵖ ⥤ CommRingCat.{u}}
  (φ : S ⟶ F.op ⋙ R)

/-- The sections of `R` over `Y` that are restrictions `R.map f (φ.app X a)` of images
of sections `a` of `S` over some `X`, along a morphism `f : op (F.obj X.unop) ⟶ Y`. -/
def generators (Y : Dᵒᵖ) : Set (R.obj Y) :=
  {b | ∃ (X : Cᵒᵖ) (f : F.op.obj X ⟶ Y) (a : S.obj X), R.map f (φ.app X a) = b}

/-- The subring of `R.obj Y` generated by `generators φ Y`. -/
def pullbackSubring (Y : Dᵒᵖ) : Subring (R.obj Y) :=
  Subring.closure (generators φ Y)

lemma map_mem_pullbackSubring {Y Y' : Dᵒᵖ} (g : Y ⟶ Y') {b : R.obj Y}
    (hb : b ∈ pullbackSubring φ Y) : R.map g b ∈ pullbackSubring φ Y' := by
  have : pullbackSubring φ Y ≤ (pullbackSubring φ Y').comap (R.map g).hom :=
    Subring.closure_le.2 fun _ ⟨X, f, a, h⟩ ↦ Subring.subset_closure
      ⟨X, f ≫ g, a, by rw [← h, R.map_comp]; rfl⟩
  exact this hb

/-- The presheaf of commutative rings `Y ↦ pullbackSubring φ Y` on `D`, with
restriction maps induced by those of `R`. -/
@[simps]
def pullbackRing : Dᵒᵖ ⥤ CommRingCat.{u} where
  obj Y := CommRingCat.of (pullbackSubring φ Y)
  map g := CommRingCat.ofHom
    ((R.map g).hom.restrict _ _ fun _ hb ↦ map_mem_pullbackSubring φ g hb)
  map_id Y := by
    ext b
    simp
  map_comp f g := by
    ext b
    simp

/-- The inclusion of presheaves of commutative rings `pullbackRing φ ⟶ R`. -/
@[simps]
def pullbackRingι : pullbackRing φ ⟶ R where
  app Y := CommRingCat.ofHom (pullbackSubring φ Y).subtype

variable {φ} {M : PresheafOfModulesOfCommRing.{v} R}

/-- A `φ`-derivation vanishes on the subring `pullbackSubring φ Y`. -/
lemma derivation_eq_zero_of_mem (d : M.Derivation φ) {Y : Dᵒᵖ} {b : R.obj Y}
    (hb : b ∈ pullbackSubring φ Y) : d.d b = 0 := by
  induction hb using Subring.closure_induction with
  | mem x hx =>
    obtain ⟨X, f, a, rfl⟩ := hx
    rw [d.d_map, d.d_app]
    exact map_zero _
  | zero => exact map_zero _
  | one => exact d.d_one Y
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | neg x _ hx => rw [map_neg, hx, neg_zero]
  | mul x y _ _ hx hy => rw [d.d_mul, hx, hy, smul_zero, smul_zero, add_zero]

/-- A `φ`-derivation, viewed as a `pullbackRingι φ`-derivation with the same
underlying additive maps. -/
def toPullbackDerivation (d : M.Derivation φ) : M.Derivation' (pullbackRingι φ) where
  d := d.d
  d_mul := d.d_mul
  d_map := d.d_map
  d_app b := derivation_eq_zero_of_mem d b.2

/-- A `pullbackRingι φ`-derivation, viewed as a `φ`-derivation with the same
underlying additive maps. -/
def ofPullbackDerivation (d : M.Derivation' (pullbackRingι φ)) : M.Derivation φ where
  d := d.d
  d_mul := d.d_mul
  d_map := d.d_map
  d_app {X} a := d.d_app (X := F.op.obj X)
    ⟨φ.app X a, Subring.subset_closure ⟨X, 𝟙 _, a, by simp⟩⟩

/-- `φ`-derivations and `pullbackRingι φ`-derivations with values in `M` are the
same: both conversions keep the underlying additive maps. -/
@[simps]
def derivationEquiv : M.Derivation φ ≃ M.Derivation' (pullbackRingι φ) where
  toFun := toPullbackDerivation
  invFun := ofPullbackDerivation
  left_inv _ := rfl
  right_inv _ := rfl

@[simp]
lemma toPullbackDerivation_d (d : M.Derivation φ) {Y : Dᵒᵖ} (b : R.obj Y) :
    (toPullbackDerivation d).d b = d.d b := rfl

@[simp]
lemma ofPullbackDerivation_d (d : M.Derivation' (pullbackRingι φ)) {Y : Dᵒᵖ}
    (b : R.obj Y) : (ofPullbackDerivation d).d b = d.d b := rfl

lemma toPullbackDerivation_postcomp {N : PresheafOfModulesOfCommRing.{v} R}
    (d : M.Derivation φ) (α : M ⟶ N) :
    toPullbackDerivation (d.postcomp α) = (toPullbackDerivation d).postcomp α := rfl

lemma ofPullbackDerivation_postcomp {N : PresheafOfModulesOfCommRing.{v} R}
    (d : M.Derivation' (pullbackRingι φ)) (α : M ⟶ N) :
    ofPullbackDerivation (d.postcomp α) = (ofPullbackDerivation d).postcomp α := rfl

variable (φ)

/-- The presheaf of relative differentials of `φ : S ⟶ F.op ⋙ R`: on `Y` it is the
module of Kähler differentials of `R.obj Y` over the subring `pullbackSubring φ Y`. -/
noncomputable def relativeDifferentials : PresheafOfModulesOfCommRing.{u} R :=
  DifferentialsConstruction.relativeDifferentials' (pullbackRingι φ)

/-- The universal `φ`-derivation `R ⟶ relativeDifferentials φ`, given on `Y` by the
Kähler differential `b ↦ d b`. -/
noncomputable def derivation : (relativeDifferentials φ).Derivation φ :=
  ofPullbackDerivation (DifferentialsConstruction.derivation' (pullbackRingι φ))

lemma derivation_d {Y : Dᵒᵖ} (b : R.obj Y) :
    (derivation φ).d b = CommRingCat.KaehlerDifferential.d b := rfl

/-! The construction applies to the comorphism `f.c : 𝒪_S ⟶ (Opens.map f.base).op ⋙ 𝒪_X`
of every morphism of schemes `f : X ⟶ S`. -/

noncomputable example {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) :
    PresheafOfModulesOfCommRing.{u} X.presheaf :=
  relativeDifferentials (F := TopologicalSpace.Opens.map f.base) f.c

noncomputable example {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) :
    (relativeDifferentials (F := TopologicalSpace.Opens.map f.base) f.c).Derivation
      (F := TopologicalSpace.Opens.map f.base) f.c :=
  derivation _

end Langlands.PresheafDifferentials
