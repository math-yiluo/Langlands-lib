import Mathlib

/-! # Cotangent spaces at a rational point and maximal ideals

Let `B` be a local ring with maximal ideal `𝔪`, let `A` be a ring with an algebra map
`σ : A → B`, and let `θ : A →+* B` be a second ring map with `θ⁻¹(𝔪) = σ⁻¹(𝔪) = 𝔭`. Assume that
the residue field of `B` is generated by `σ(A)` (a rational point). Then
`𝔪 = σ(𝔭) B + θ(𝔭) B` holds if and only if the differentials `dθ(g)`, `g ∈ 𝔭`, span
`κ ⊗_B Ω_{B/A}`; the converse needs a finiteness hypothesis for Nakayama's lemma.
-/

universe u v

open TensorProduct IsLocalRing

namespace Langlands.AlgebraicGeometry.SmoothRelationGoodPoint

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [IsLocalRing B] [Algebra A B]

/-- An element of `B` is a constant if it is a fraction `σ a / σ a'` with `σ a'` a unit. -/
def IsConst (A : Type u) {B : Type v} [CommRing A] [CommRing B] [IsLocalRing B] [Algebra A B]
    (z : B) : Prop :=
  ∃ a a' : A, algebraMap A B a' ∉ maximalIdeal B ∧ algebraMap A B a' * z = algebraMap A B a

namespace IsConst

lemma const (a : A) : IsConst A (algebraMap A B a) :=
  ⟨a, 1, by simp [(maximalIdeal.isMaximal B).ne_top, ← Ideal.eq_top_iff_one], by simp⟩

lemma add {z w : B} (hz : IsConst A z) (hw : IsConst A w) : IsConst A (z + w) := by
  obtain ⟨a, a', ha', hz⟩ := hz
  obtain ⟨b, b', hb', hw⟩ := hw
  refine ⟨a * b' + b * a', a' * b', ?_, ?_⟩
  · rw [map_mul]
    exact fun h ↦ ((maximalIdeal.isMaximal B).isPrime.mem_or_mem h).elim ha' hb'
  · simp only [map_mul, map_add]
    linear_combination (algebraMap A B b') * hz + (algebraMap A B a') * hw

lemma neg {z : B} (hz : IsConst A z) : IsConst A (-z) := by
  obtain ⟨a, a', ha', hz⟩ := hz
  exact ⟨-a, a', ha', by simp [hz]⟩

lemma sub {z w : B} (hz : IsConst A z) (hw : IsConst A w) : IsConst A (z - w) := by
  simpa [sub_eq_add_neg] using hz.add hw.neg

lemma mul {z w : B} (hz : IsConst A z) (hw : IsConst A w) : IsConst A (z * w) := by
  obtain ⟨a, a', ha', hz⟩ := hz
  obtain ⟨b, b', hb', hw⟩ := hw
  refine ⟨a * b, a' * b', ?_, ?_⟩
  · rw [map_mul]
    exact fun h ↦ ((maximalIdeal.isMaximal B).isPrime.mem_or_mem h).elim ha' hb'
  · simp only [map_mul]
    linear_combination (algebraMap A B b' * w) * hz + (algebraMap A B a) * hw

/-- A constant in the maximal ideal lies in the ideal generated by `σ(𝔭)`. -/
lemma mem_map {z : B} (hz : IsConst A z) (hzm : z ∈ maximalIdeal B) :
    z ∈ ((maximalIdeal B).comap (algebraMap A B)).map (algebraMap A B) := by
  obtain ⟨a, a', ha', hz⟩ := hz
  have hu : IsUnit (algebraMap A B a') := by
    simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using ha'
  have ha : a ∈ (maximalIdeal B).comap (algebraMap A B) := by
    rw [Ideal.mem_comap, ← hz]
    exact Ideal.mul_mem_left _ _ hzm
  obtain ⟨u, hu⟩ := hu
  have : z = algebraMap A B a * ↑u⁻¹ := by
    rw [← hz, ← hu, mul_comm (u : B), mul_assoc, Units.mul_inv, mul_one]
  rw [this]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ha)

/-- A constant has zero differential. -/
lemma D_eq_zero {z : B} (hz : IsConst A z) : KaehlerDifferential.D A B z = 0 := by
  obtain ⟨a, a', ha', hz⟩ := hz
  have hu : IsUnit (algebraMap A B a') := by
    simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using ha'
  have h := congrArg (KaehlerDifferential.D A B) hz
  rw [Derivation.leibniz, Derivation.map_algebraMap, Derivation.map_algebraMap, smul_zero,
    add_zero] at h
  obtain ⟨u, hu⟩ := hu
  have := congrArg (fun x ↦ (↑u⁻¹ : B) • x) h
  simp only [smul_zero] at this
  rwa [← hu, smul_smul, Units.inv_mul, one_smul] at this

end IsConst

variable (A B) in
/-- The rationality hypothesis: every element of `B` is congruent to a constant modulo the
maximal ideal. -/
def IsRationalPoint : Prop :=
  ∀ b : B, ∃ a a' : A, algebraMap A B a' ∉ maximalIdeal B ∧
    algebraMap A B a' * b - algebraMap A B a ∈ maximalIdeal B

lemma IsRationalPoint.exists_const (hrat : IsRationalPoint A B) (b : B) :
    ∃ c : B, IsConst A c ∧ b - c ∈ maximalIdeal B := by
  obtain ⟨a, a', ha', hb⟩ := hrat b
  have hu : IsUnit (algebraMap A B a') := by
    simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using ha'
  obtain ⟨u, hu⟩ := hu
  refine ⟨algebraMap A B a * ↑u⁻¹, ⟨a, a', ha', ?_⟩, ?_⟩
  · rw [← hu, mul_comm, mul_assoc, Units.inv_mul, mul_one]
  · have : b - algebraMap A B a * ↑u⁻¹ = ↑u⁻¹ * (algebraMap A B a' * b - algebraMap A B a) := by
      rw [← hu, mul_sub, ← mul_assoc, Units.inv_mul, one_mul, mul_comm]
    rw [this]
    exact Ideal.mul_mem_left _ _ hb

/-- The span of the differentials `1 ⊗ dθ(g)`, `g ∈ σ⁻¹(𝔪)`, in `κ ⊗_B Ω_{B/A}`. -/
noncomputable def cotangentSpan (θ : A →+* B) : Submodule (ResidueField B)
    (ResidueField B ⊗[B] Ω[B⁄A]) :=
  Submodule.span (ResidueField B)
    (Set.range fun g : (maximalIdeal B).comap (algebraMap A B) ↦
      (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B (θ g))

lemma one_tmul_smul (b : B) (ω : Ω[B⁄A]) :
    (1 : ResidueField B) ⊗ₜ[B] (b • ω) = residue B b • ((1 : ResidueField B) ⊗ₜ[B] ω) := by
  rw [← smul_tmul, TensorProduct.smul_tmul']
  congr 1

lemma one_tmul_D_mul_of_mem (b z : B) (hz : z ∈ maximalIdeal B) :
    (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B (b * z) =
      residue B b • ((1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B z) := by
  rw [Derivation.leibniz, tmul_add, one_tmul_smul, one_tmul_smul,
    (residue_eq_zero_iff z).mpr hz, zero_smul, add_zero]

/-- The elements `1 ⊗ db` span `κ ⊗_B Ω_{B/A}` over `κ`. -/
lemma span_one_tmul_D :
    Submodule.span (ResidueField B)
      (Set.range fun b : B ↦ (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B b) = ⊤ := by
  refine eq_top_iff.mpr ?_
  rintro x -
  induction x using TensorProduct.inductionOn with
  | add x y hx hy => exact add_mem hx hy
  | tmul k ω =>
    have hk : k ⊗ₜ[B] ω = k • ((1 : ResidueField B) ⊗ₜ[B] ω) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [hk]
    clear hk
    refine Submodule.smul_mem _ _ ?_
    have hω : ω ∈ Submodule.span B (Set.range (KaehlerDifferential.D A B)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hω using Submodule.span_induction with
    | mem ω hω =>
      obtain ⟨b, rfl⟩ := hω
      exact Submodule.subset_span ⟨b, rfl⟩
    | zero => simp
    | add ω ω' _ _ h h' => rw [tmul_add]; exact add_mem h h'
    | smul b ω _ h => rw [one_tmul_smul]; exact Submodule.smul_mem _ _ h

variable (θ : A →+* B)

/-- If `𝔪 = σ(𝔭) B + θ(𝔭) B`, the differentials `dθ(g)`, `g ∈ 𝔭`, span `κ ⊗_B Ω_{B/A}`. -/
theorem cotangentSpan_eq_top_of_maximalIdeal_eq
    (hrat : IsRationalPoint A B)
    (h : maximalIdeal B = ((maximalIdeal B).comap (algebraMap A B)).map (algebraMap A B) ⊔
      ((maximalIdeal B).comap (algebraMap A B)).map θ) :
    cotangentSpan θ = ⊤ := by
  set 𝔭 := (maximalIdeal B).comap (algebraMap A B)
  -- every element of the maximal ideal has its differential in the span
  have key : ∀ z ∈ maximalIdeal B,
      (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B z ∈ cotangentSpan (A := A) θ := by
    intro z hz
    rw [h, Ideal.map, Ideal.map, ← Submodule.span_union] at hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      rcases hz with ⟨a, ha, rfl⟩ | ⟨g, hg, rfl⟩
      · rw [Derivation.map_algebraMap, tmul_zero]; exact zero_mem _
      · exact Submodule.subset_span ⟨⟨g, hg⟩, rfl⟩
    | zero => simp
    | add z w _ _ hz hw => rw [map_add, tmul_add]; exact add_mem hz hw
    | smul b z hz' hz =>
      rw [smul_eq_mul, one_tmul_D_mul_of_mem]
      · exact Submodule.smul_mem _ _ hz
      · have : z ∈ maximalIdeal B := by
          rw [h, Ideal.map, Ideal.map, ← Submodule.span_union]; exact hz'
        exact this
  rw [eq_top_iff, ← span_one_tmul_D (A := A), Submodule.span_le]
  rintro _ ⟨b, rfl⟩
  obtain ⟨c, hc, hbc⟩ := hrat.exists_const b
  have : KaehlerDifferential.D A B b = KaehlerDifferential.D A B (b - c) := by
    rw [map_sub, hc.D_eq_zero, sub_zero]
  show (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B b ∈ cotangentSpan θ
  rw [this]
  exact key _ hbc

/-! ### The converse -/

section Converse

variable (A B) in
/-- The ideal `𝔪² + σ(𝔭) B`. -/
noncomputable def sqSupIdeal : Ideal B :=
  maximalIdeal B ^ 2 ⊔ ((maximalIdeal B).comap (algebraMap A B)).map (algebraMap A B)

lemma IsConst.mem_sqSupIdeal {w : B} (hw : IsConst A w) (hwm : w ∈ maximalIdeal B) :
    w ∈ sqSupIdeal A B :=
  Ideal.mem_sup_right (hw.mem_map hwm)

lemma mul_mem_sqSupIdeal {z w : B} (hz : z ∈ maximalIdeal B) (hw : w ∈ maximalIdeal B) :
    z * w ∈ sqSupIdeal A B :=
  Ideal.mem_sup_left (by rw [pow_two]; exact Ideal.mul_mem_mul hz hw)

/-- A choice of constant representative of every element. -/
noncomputable def constRep (hrat : IsRationalPoint A B) (b : B) : B :=
  (hrat.exists_const b).choose

lemma constRep_isConst (hrat : IsRationalPoint A B) (b : B) : IsConst A (constRep hrat b) :=
  (hrat.exists_const b).choose_spec.1

lemma sub_constRep_mem (hrat : IsRationalPoint A B) (b : B) :
    b - constRep hrat b ∈ maximalIdeal B :=
  (hrat.exists_const b).choose_spec.2

/-- The derivation `b ↦ [b - c(b)]` with values in `B / (𝔪² + σ(𝔭) B)`. -/
noncomputable def residueDerivation (hrat : IsRationalPoint A B) :
    Derivation A B (B ⧸ sqSupIdeal A B) :=
  Derivation.mk'
    { toFun := fun b ↦ Ideal.Quotient.mk (sqSupIdeal A B) (b - constRep hrat b)
      map_add' := fun b b' ↦ by
        rw [← map_add, Ideal.Quotient.eq]
        have hc := ((constRep_isConst hrat b).add (constRep_isConst hrat b')).sub
          (constRep_isConst hrat (b + b'))
        have : b + b' - constRep hrat (b + b') - (b - constRep hrat b + (b' - constRep hrat b')) =
            constRep hrat b + constRep hrat b' - constRep hrat (b + b') := by ring
        rw [this]
        refine hc.mem_sqSupIdeal ?_
        have : constRep hrat b + constRep hrat b' - constRep hrat (b + b') =
            b + b' - constRep hrat (b + b') - (b - constRep hrat b) -
              (b' - constRep hrat b') := by ring
        rw [this]
        exact sub_mem (sub_mem (sub_constRep_mem hrat _) (sub_constRep_mem hrat _))
          (sub_constRep_mem hrat _)
      map_smul' := fun a b ↦ by
        simp only [RingHom.id_apply, Algebra.smul_def]
        rw [← Ideal.Quotient.mk_algebraMap, ← map_mul, Ideal.Quotient.eq]
        have hc := ((IsConst.const (B := B) a).mul (constRep_isConst hrat b)).sub
          (constRep_isConst hrat (algebraMap A B a * b))
        have : algebraMap A B a * b - constRep hrat (algebraMap A B a * b) -
            algebraMap A B a * (b - constRep hrat b) =
            algebraMap A B a * constRep hrat b - constRep hrat (algebraMap A B a * b) := by ring
        rw [this]
        refine hc.mem_sqSupIdeal ?_
        have : algebraMap A B a * constRep hrat b - constRep hrat (algebraMap A B a * b) =
            (algebraMap A B a * b - constRep hrat (algebraMap A B a * b)) -
              algebraMap A B a * (b - constRep hrat b) := by ring
        rw [this]
        exact sub_mem (sub_constRep_mem hrat _)
          (Ideal.mul_mem_left _ _ (sub_constRep_mem hrat _)) }
    (fun b b' ↦ by
      simp only [LinearMap.coe_mk, AddHom.coe_mk, Algebra.smul_def,
        Ideal.Quotient.algebraMap_eq, ← map_mul, ← map_add]
      rw [Ideal.Quotient.eq]
      set c := constRep hrat b
      set c' := constRep hrat b'
      set cc := constRep hrat (b * b')
      have hb := sub_constRep_mem hrat b
      have hb' := sub_constRep_mem hrat b'
      have hbb := sub_constRep_mem hrat (b * b')
      have : b * b' - cc - (b * (b' - c') + b' * (b - c)) =
          (c * c' - cc) - (b - c) * (b' - c') := by ring
      rw [this]
      refine sub_mem (((constRep_isConst hrat b).mul (constRep_isConst hrat b')).sub
        (constRep_isConst hrat (b * b')) |>.mem_sqSupIdeal ?_) (mul_mem_sqSupIdeal hb hb')
      have : c * c' - cc = (b * b' - cc) - (b - c) * b' - c * (b' - c') := by ring
      rw [this]
      exact sub_mem (sub_mem hbb (Ideal.mul_mem_right _ _ hb)) (Ideal.mul_mem_left _ _ hb'))

lemma residueDerivation_apply (hrat : IsRationalPoint A B) (b : B) :
    residueDerivation hrat b = Ideal.Quotient.mk (sqSupIdeal A B) (b - constRep hrat b) := rfl

/-- An element of `𝔪` whose differential vanishes in `κ ⊗_B Ω_{B/A}` lies in `𝔪² + σ(𝔭) B`. -/
lemma mem_sqSupIdeal_of_one_tmul_D_eq_zero (hrat : IsRationalPoint A B) {z : B}
    (hz : z ∈ maximalIdeal B)
    (h : (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B z = 0) :
    z ∈ sqSupIdeal A B := by
  set J := sqSupIdeal A B
  let ψ := (residueDerivation hrat).liftKaehlerDifferential
  have hD : KaehlerDifferential.D A B z ∈ (maximalIdeal B • ⊤ : Submodule B Ω[B⁄A]) := by
    have h' : (TensorProduct.quotTensorEquivQuotSMul Ω[B⁄A] (maximalIdeal B)).symm
        (Submodule.Quotient.mk (KaehlerDifferential.D A B z)) = 0 := h
    rw [LinearEquiv.map_eq_zero_iff] at h'
    exact (Submodule.Quotient.mk_eq_zero _).mp h'
  -- the image of `ψ` lies in the image of `𝔪`
  have hrange : Submodule.map ψ ⊤ ≤ Submodule.map J.mkQ (maximalIdeal B) := by
    rw [← KaehlerDifferential.span_range_derivation, Submodule.map_span, Submodule.span_le]
    rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
    exact ⟨b - constRep hrat b, sub_constRep_mem hrat b, by
      simp [ψ, Derivation.liftKaehlerDifferential_comp_D, residueDerivation_apply]; rfl⟩
  have hzero : ψ (KaehlerDifferential.D A B z) = 0 := by
    have h1 := Submodule.mem_map_of_mem (f := ψ) hD
    rw [Submodule.map_smul''] at h1
    have h2 := smul_mono_right (maximalIdeal B) hrange h1
    rw [← Submodule.mem_bot B]
    refine (Submodule.smul_le.mpr ?_) h2
    rintro r hr _ ⟨m, hm, rfl⟩
    rw [Submodule.mem_bot, Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero]
    exact mul_mem_sqSupIdeal hr hm
  rw [Derivation.liftKaehlerDifferential_comp_D, residueDerivation_apply,
    Ideal.Quotient.eq_zero_iff_mem] at hzero
  have hc : constRep hrat z ∈ J := (constRep_isConst hrat z).mem_sqSupIdeal (by
    have : constRep hrat z = z - (z - constRep hrat z) := by ring
    rw [this]; exact sub_mem hz (sub_constRep_mem hrat z))
  have : z = (z - constRep hrat z) + constRep hrat z := by ring
  rw [this]
  exact add_mem hzero hc

/-- Every element of the cotangent span is the differential of an element of `θ(𝔭) B`. -/
lemma exists_eq_one_tmul_D_of_mem_cotangentSpan
    (hθ : (maximalIdeal B).comap θ = (maximalIdeal B).comap (algebraMap A B))
    {x : ResidueField B ⊗[B] Ω[B⁄A]} (hx : x ∈ cotangentSpan θ) :
    ∃ y ∈ ((maximalIdeal B).comap (algebraMap A B)).map θ,
      x = (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B y := by
  have hle : ((maximalIdeal B).comap (algebraMap A B)).map θ ≤ maximalIdeal B := by
    rw [← hθ]; exact Ideal.map_comap_le
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨g, hg⟩, rfl⟩ := hx
    exact ⟨θ g, Ideal.mem_map_of_mem _ hg, rfl⟩
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | add x x' _ _ hx hx' =>
    obtain ⟨y, hy, rfl⟩ := hx
    obtain ⟨y', hy', rfl⟩ := hx'
    exact ⟨y + y', add_mem hy hy', by rw [map_add, tmul_add]⟩
  | smul k x _ hx =>
    obtain ⟨y, hy, rfl⟩ := hx
    obtain ⟨w, rfl⟩ := residue_surjective k
    exact ⟨w * y, Ideal.mul_mem_left _ _ hy, (one_tmul_D_mul_of_mem w y (hle hy)).symm⟩

/-- Nakayama's lemma in the form used below: if `𝔪 ≤ P + N` with `N ⊆ 𝔪` finitely generated,
`P ≤ I` and `𝔪 ≤ I + 𝔪²`, then `N ≤ I`. -/
lemma le_of_le_sup_sq {P I N : Ideal B} (hN : N.FG) (hNm : N ≤ maximalIdeal B)
    (hmN : maximalIdeal B ≤ P ⊔ N) (hPI : P ≤ I)
    (hsq : maximalIdeal B ≤ I ⊔ maximalIdeal B ^ 2) : N ≤ I := by
  refine Submodule.le_of_le_smul_of_le_jacobson_bot hN (I := maximalIdeal B) ?_ ?_
  · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  · have h2 : maximalIdeal B ^ 2 ≤ I ⊔ maximalIdeal B * N := by
      rw [pow_two]
      calc maximalIdeal B * maximalIdeal B ≤ maximalIdeal B * (P ⊔ N) := Ideal.mul_mono_right hmN
        _ = maximalIdeal B * P ⊔ maximalIdeal B * N := Ideal.mul_sup _ _ _
        _ ≤ I ⊔ maximalIdeal B * N := sup_le_sup_right (Ideal.mul_le_right.trans hPI) _
    rw [Ideal.smul_eq_mul]
    exact hNm.trans (hsq.trans (sup_le le_sup_left h2))

/-- Conversely, if the differentials `dθ(g)`, `g ∈ 𝔭`, span `κ ⊗_B Ω_{B/A}`, and `𝔪` is
generated modulo `σ(𝔭) B` by a finitely generated ideal `N ⊆ 𝔪`, then
`𝔪 = σ(𝔭) B + θ(𝔭) B`. -/
theorem maximalIdeal_eq_of_cotangentSpan_eq_top
    (hθ : (maximalIdeal B).comap θ = (maximalIdeal B).comap (algebraMap A B))
    (hrat : IsRationalPoint A B)
    (hfg : ∃ N : Ideal B, N.FG ∧ N ≤ maximalIdeal B ∧
      maximalIdeal B ≤ ((maximalIdeal B).comap (algebraMap A B)).map (algebraMap A B) ⊔ N)
    (h : cotangentSpan θ = ⊤) :
    maximalIdeal B = ((maximalIdeal B).comap (algebraMap A B)).map (algebraMap A B) ⊔
      ((maximalIdeal B).comap (algebraMap A B)).map θ := by
  set 𝔭 := (maximalIdeal B).comap (algebraMap A B)
  set I := 𝔭.map (algebraMap A B) ⊔ 𝔭.map θ
  have hIle : I ≤ maximalIdeal B := sup_le Ideal.map_comap_le (by rw [← hθ]; exact Ideal.map_comap_le)
  -- `𝔪 ≤ I + 𝔪²`
  have hsq : maximalIdeal B ≤ I ⊔ maximalIdeal B ^ 2 := by
    intro b hb
    obtain ⟨y, hy, hxy⟩ := exists_eq_one_tmul_D_of_mem_cotangentSpan θ hθ
      (h.symm ▸ Submodule.mem_top :
        (1 : ResidueField B) ⊗ₜ[B] KaehlerDifferential.D A B b ∈ cotangentSpan θ)
    have hyle : y ∈ maximalIdeal B := hIle (Ideal.mem_sup_right hy)
    have hz := mem_sqSupIdeal_of_one_tmul_D_eq_zero hrat (sub_mem hb hyle)
      (by rw [map_sub, tmul_sub, hxy, sub_self])
    have : b = (b - y) + y := by ring
    rw [this]
    refine add_mem ?_ (Ideal.mem_sup_left (Ideal.mem_sup_right hy))
    have hJ : sqSupIdeal A B ≤ I ⊔ maximalIdeal B ^ 2 :=
      sup_le le_sup_right (le_sup_of_le_left le_sup_left)
    exact hJ hz
  obtain ⟨N, hN, hNm, hmN⟩ := hfg
  exact le_antisymm (hmN.trans (sup_le le_sup_left
    (le_of_le_sup_sq hN hNm hmN le_sup_left hsq))) hIle

end Converse

end Langlands.AlgebraicGeometry.SmoothRelationGoodPoint
