import Langlands.AlgebraicGeometry.AlgebraicSpace.Basic
import Mathlib.CategoryTheory.Sites.LocallyBijective

/-! # Morphisms of fppf sheaves that are bijective on affine tests -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

namespace Langlands.AlgebraicGeometry.Picard.LineHom

open AlgebraicSpace

set_option backward.isDefEq.respectTransparency false

variable {B : Scheme.{u}}

/-- The sieve on a test generated by the standard affine open cover of its scheme. -/
def affineCoverSieve (T : Over B) : Sieve T :=
  Sieve.ofArrows (fun i ↦ Over.mk (T.left.affineCover.f i ≫ T.hom))
    (fun i ↦ Over.homMk (T.left.affineCover.f i))

lemma affineCoverSieve_mem (T : Over B) : affineCoverSieve T ∈ (fppfTopology B) T := by
  change affineCoverSieve T ∈ (Scheme.fppfTopology.over B) _
  rw [GrothendieckTopology.mem_over_iff]
  change Sieve.overEquiv _ (Sieve.ofArrows _ _) ∈ Scheme.fppfTopology _
  rw [Sieve.overEquiv_ofArrows]
  exact (Precoverage.toGrothendieck_mono
    Scheme.zariskiPrecoverage_le_fppfPrecoverage) _ T.left.affineCover.mem_grothendieckTopology

lemma isAffine_of_mem_affineCoverSieve {T V : Over B} {k : V ⟶ T}
    (hk : affineCoverSieve T k) : ∃ (W : Over B) (a : V ⟶ W) (b : W ⟶ T),
      IsAffine W.left ∧ a ≫ b = k := by
  obtain ⟨W, a, b, ⟨i⟩, rfl⟩ := hk
  exact ⟨_, a, _, inferInstanceAs (IsAffine (Spec _)), rfl⟩

/-- A morphism of fppf sheaves on the full slice that is bijective on every affine test is an
isomorphism. -/
theorem isIso_of_bijective_affine {F G : Presheaf B}
    (hF : CategoryTheory.Presheaf.IsSheaf (fppfTopology B) F)
    (hG : CategoryTheory.Presheaf.IsSheaf (fppfTopology B) G) (Ψ : F ⟶ G)
    (h : ∀ T : Over B, IsAffine T.left → Function.Bijective (Ψ.app (op T))) : IsIso Ψ := by
  rw [isSheaf_iff_isSheaf_of_type] at hF hG
  have hinj : ∀ T, Function.Injective (Ψ.app T) := by
    intro T x y hxy
    refine (hF _ (affineCoverSieve_mem T.unop)).isSeparatedFor.ext ?_
    intro V k hk
    obtain ⟨W, a, b, hW, rfl⟩ := isAffine_of_mem_affineCoverSieve hk
    have hb : F.map b.op x = F.map b.op y := by
      apply (h W hW).1
      rw [NatTrans.naturality_apply, NatTrans.naturality_apply, hxy]
    rw [op_comp, F.map_comp, types_comp_apply, types_comp_apply, hb]
  have hsurj : ∀ T, Function.Surjective (Ψ.app T) := by
    intro T s
    have hmem : CategoryTheory.Presheaf.imageSieve Ψ s ∈ (fppfTopology B) T.unop := by
      refine (fppfTopology B).superset_covering ?_ (affineCoverSieve_mem T.unop)
      intro V k hk
      obtain ⟨W, a, b, hW, rfl⟩ := isAffine_of_mem_affineCoverSieve hk
      obtain ⟨t, ht⟩ := (h W hW).2 (G.map b.op s)
      refine ⟨F.map a.op t, ?_⟩
      rw [NatTrans.naturality_apply, ht, op_comp, G.map_comp, types_comp_apply]
    let t : Presieve.FamilyOfElements F (CategoryTheory.Presheaf.imageSieve Ψ s).arrows :=
      fun Y g hg ↦ CategoryTheory.Presheaf.localPreimage Ψ s g hg
    have ht : t.Compatible := by
      intro Y₁ Y₂ W g₁ g₂ f₁ f₂ hf₁ hf₂ w
      apply hinj
      have eq₁ := NatTrans.naturality_apply Ψ g₁.op (t f₁ hf₁)
      have eq₂ := NatTrans.naturality_apply Ψ g₂.op (t f₂ hf₂)
      have eq₃ := congr_arg (G.map g₁.op)
        (CategoryTheory.Presheaf.app_localPreimage Ψ s _ hf₁)
      have eq₄ := congr_arg (G.map g₂.op)
        (CategoryTheory.Presheaf.app_localPreimage Ψ s _ hf₂)
      refine eq₁.trans (eq₃.trans (Eq.trans ?_ (eq₄.symm.trans eq₂.symm)))
      rw [← Functor.map_comp_apply, ← Functor.map_comp_apply]
      simp only [← op_comp, w]
    refine ⟨(hF _ hmem).amalgamate t ht, ?_⟩
    apply (hG _ hmem).isSeparatedFor.ext
    intro Y g hg
    rw [← NatTrans.naturality_apply, (hF _ hmem).valid_glue ht]
    exact CategoryTheory.Presheaf.app_localPreimage Ψ s g hg
  rw [NatTrans.isIso_iff_isIso_app]
  intro T
  rw [isIso_iff_bijective]
  exact ⟨hinj T, hsurj T⟩

end Langlands.AlgebraicGeometry.Picard.LineHom
