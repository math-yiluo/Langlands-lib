import Langlands.AlgebraicGeometry.Picard.SmoothFamilyAbelianRepresentabilityOfFiniteTypeStatement
import Langlands.AlgebraicGeometry.Picard.SmoothFamilyAbelianRepresentabilityOfOpenCoverProof
import Langlands.AlgebraicGeometry.Picard.SmoothFamilyUniversalBaseChangeProof
import Langlands.AlgebraicGeometry.Picard.SmoothFamilyUniversalIsoTransport
import Langlands.AbelianScheme.AffineObjectSpreadingProof

/-! # Reduction of the smooth-family representer to bases of finite type over `ℤ` -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.AbelianScheme

/-- The unital subring generated by a finite set is of finite type over `ℤ`. -/
theorem finiteType_int_subringClosure {R : Type u} [CommRing R] (s : Finset R) :
    Algebra.FiniteType ℤ (Subring.closure (s : Set R)) :=
  (Algebra.FiniteType.adjoin_of_finite s.finite_toSet).equiv
    (Subring.closureEquivAdjoinInt (s : Set R)).symm

/-- Over an arbitrary affine base, the finite-type case, spreading, base change and
transport along isomorphisms give the representer. -/
theorem smoothFamilyAbelianRepresentability_spec_of_finiteType
    (h : FiniteTypeSmoothFamilyAbelianRepresentabilityStatement.{u})
    (R : CommRingCat.{u}) (A : AbelianScheme (Spec R)) :
    ∃ (B : AbelianScheme (Spec R)) (L : RigidifiedFamily A B.X),
      IsUniversalSmoothFamilyOnQuasiSeparatedTests A L := by
  obtain ⟨s, A₀, ⟨e⟩⟩ := affineObjectSpreading.{u} R A
  have := finiteType_int_subringClosure s
  obtain ⟨B₀, L₀, hL₀⟩ := h (Subring.closure (s : Set R)) A₀
  let b : Spec R ⟶ Spec (CommRingCat.of (Subring.closure (s : Set R))) :=
    Spec.map (CommRingCat.ofHom (Subring.closure (s : Set R)).subtype)
  have hb := smoothFamilyUniversalBaseChange.{u} _ _ b A₀ B₀.X L₀ hL₀
  obtain ⟨L, hL⟩ := smoothFamilyUniversalIsoTransport.{u} _ A _ e.symm _ _ hb
  exact ⟨(baseChange b).obj B₀, L, hL⟩

/-- The shared smooth-family representer over every quasi-separated base follows from the
finite-type case. -/
theorem smoothFamilyAbelianRepresentabilityOfFiniteType :
    SmoothFamilyAbelianRepresentabilityOfFiniteTypeStatement.{u} := by
  intro h S _ A
  exact smoothFamilyAbelianRepresentabilityOfOpenCover S A S.affineOpenCover.openCover
    fun i => smoothFamilyAbelianRepresentability_spec_of_finiteType h _ _

end Langlands.AbelianScheme
