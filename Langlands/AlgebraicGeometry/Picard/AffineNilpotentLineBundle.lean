/-! # Lifting line-bundle frames through affine nilpotent immersions -/

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open scoped TensorProduct ChangeOfRings

set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace Langlands.AlgebraicGeometry.Picard

open Langlands.Scheme.Modules Langlands.SchemeModule

/-- Scalar extension along a surjective ring map is generated by tensors with first factor one. -/
lemma oneTensor_surjective {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (hφ : Function.Surjective φ) (M : ModuleCat.{u} R) :
    Function.Surjective (fun m : M ↦ ((1 : S) ⊗ₜ[R,φ.hom] m :
      (ModuleCat.extendScalars φ.hom).obj M)) := by
  let : Algebra R S := φ.hom.toAlgebra
  intro t
  induction t using TensorProduct.inductionOn with
  | tmul s m =>
    obtain ⟨r, rfl⟩ := hφ s
    refine ⟨r • m, ?_⟩
    change ((1 : S) ⊗ₜ[R,φ.hom] (r • m)) = φ r ⊗ₜ[R,φ.hom] m
    erw [TensorProduct.tmul_smul]
    change ((φ r * 1) ⊗ₜ[R,φ.hom] m) = _
    rw [mul_one]
  | add t t' ht ht' =>
    obtain ⟨m, rfl⟩ := ht
    obtain ⟨m', rfl⟩ := ht'
    exact ⟨m + m', TensorProduct.tmul_add _ _ _⟩

/-- Actual affine pullback on sections is surjective along a surjective ring map. -/
lemma affineSectionsPullbackMap_surjective {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (hφ : Function.Surjective φ) (M : (Spec R).Modules) [M.IsQuasicoherent] :
    Function.Surjective (affineSectionsPullbackMap φ M) := by
  have hs : Function.Surjective (affineScalarSectionsMap φ M) :=
    (ModuleCat.epi_iff_surjective _).mp inferInstance
  intro q
  obtain ⟨t, rfl⟩ := hs q
  obtain ⟨m, rfl⟩ := oneTensor_surjective φ hφ ((moduleSpecΓFunctor (R := R)).obj M) t
  exact ⟨m, (affineScalarSectionsMap_one_tmul φ M m).symm⟩

/-- The global section pullback is the actual pullback-adjunction unit on sections. -/
lemma pullbackSection_eq_unit {X Y : Scheme.{u}} (g : Y ⟶ X) (M : X.Modules)
    (s : GlobalSections M) :
    pullbackSection g M s =
      ((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app M).app ⊤ s := by
  let φ := sectionHom M s
  have hc : (pullbackUnitIso g).hom ≫ pullbackSectionHom g M s =
      (Scheme.Modules.pullback g).map φ := by
    simp only [pullbackSectionHom, φ, Iso.hom_inv_id_assoc]
  have hu := pullbackUnitAdjunction Y X g
  rw [Adjunction.homEquiv_unit] at hu
  have hh : φ ≫ (Scheme.Modules.pullbackPushforwardAdjunction g).unit.app M =
      unitToPushforwardUnit g ≫
        (Scheme.Modules.pushforward g).map (pullbackSectionHom g M s) := by
    rw [← hu, Category.assoc, ← Functor.map_comp, hc]
    change φ ≫ (Scheme.Modules.pullbackPushforwardAdjunction g).unit.app M =
      (Scheme.Modules.pullbackPushforwardAdjunction g).unit.app (structureModule X) ≫
        (Scheme.Modules.pushforward g).map ((Scheme.Modules.pullback g).map φ)
    exact (Scheme.Modules.pullbackPushforwardAdjunction g).unit.naturality φ
  have he := congrArg (fun q ↦ q.app ⊤ (1 : Γ(X, ⊤))) hh
  change ((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app M).app ⊤
      ((sectionHom M s).app ⊤ (1 : Γ(X, ⊤))) =
    (pullbackSectionHom g M s).app ⊤ (g.appTop 1) at he
  change (pullbackSectionHom g M s).app ⊤ (1 : Γ(Y, ⊤)) =
    ((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app M).app ⊤ s
  simpa [sectionHom_app_one] using he.symm

/-- Pullback of actual global sections is surjective for an affine map with surjective
map on global rings. -/
lemma affinePullbackSection_surjective {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (g : Y ⟶ X) (hg : Function.Surjective g.appTop) (M : X.Modules) [M.IsQuasicoherent] :
    Function.Surjective (pullbackSection g M) := by
  let φ : Γ(X, ⊤) ⟶ Γ(Y, ⊤) := g.appTop
  have hw : g ≫ X.isoSpec.hom = Y.isoSpec.hom ≫ Spec.map φ :=
    (Scheme.isoSpec_hom_naturality g).symm
  have hp : IsPullback g Y.isoSpec.hom X.isoSpec.hom (Spec.map φ) :=
    IsPullback.of_vert_isIso ⟨hw⟩
  let := Langlands.AlgebraicGeometry.Modules.DerivedSections.isIso_scalarSectionsBaseChangeMap_of_isPullback_affine
    φ X.isoSpec.hom Y.isoSpec.hom g hw hp M
  have hs : Function.Surjective
      (Langlands.AlgebraicGeometry.Modules.DerivedSections.scalarSectionsBaseChangeMap
        φ X.isoSpec.hom Y.isoSpec.hom g hw M) :=
    (ModuleCat.epi_iff_surjective _).mp inferInstance
  intro q
  obtain ⟨t, ht⟩ := hs q
  obtain ⟨s, rfl⟩ := oneTensor_surjective φ hg
    ((Langlands.AlgebraicGeometry.Modules.DerivedSections.relativeGlobalSections X.isoSpec.hom).obj M) t
  refine ⟨s, ?_⟩
  rw [pullbackSection_eq_unit]
  exact (Langlands.AlgebraicGeometry.Modules.DerivedSections.scalarSectionsBaseChangeMap_one_tmul
    φ X.isoSpec.hom Y.isoSpec.hom g hw M s).symm.trans ht

/-- A line bundle on an affine scheme is trivial if its pullback to an affine
surjective closed subscheme is trivial and the global ring map is surjective. -/
lemma lineBundle_trivial_of_affinePullback {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (g : Y ⟶ X) [Surjective g] (hg : Function.Surjective g.appTop)
    (L : LineBundle X)
    (e : (Scheme.Modules.pullback g).obj L.obj ≅ structureModule Y) :
    Nonempty (L.obj ≅ structureModule X) := by
  obtain ⟨s, hs⟩ := affinePullbackSection_surjective g hg L.obj
    (e.inv.app ⊤ (1 : Γ(Y, ⊤)))
  have he : IsIso (sectionHom ((Scheme.Modules.pullback g).obj L.obj)
      (pullbackSection g L.obj s)) := by
    rw [hs, sectionHom_app_top_one]
    infer_instance
  have hp := trivializationOpen_eq_top_of_isIso
    ((Scheme.Modules.pullback g).obj L.obj) (pullbackSection g L.obj s) he
  rw [lineBundlePullbackSectionOpen X Y g L s] at hp
  have ht : trivializationOpen L.obj s = ⊤ := by
    apply top_le_iff.mp
    intro x hx
    obtain ⟨y, rfl⟩ := g.surjective x
    have hy : y ∈ g ⁻¹ᵁ trivializationOpen L.obj s := by rw [hp]; trivial
    exact hy
  let := isIso_sectionHom_of_trivializationOpen_eq_top L.obj s ht
  exact ⟨(asIso (sectionHom L.obj s)).symm⟩

/-- Choose the actual trivialization provided by affine frame lifting. -/
def affinePullbackTrivialization {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (g : Y ⟶ X) [Surjective g] (hg : Function.Surjective g.appTop)
    (L : LineBundle X)
    (e : (Scheme.Modules.pullback g).obj L.obj ≅ structureModule Y) :
    L.obj ≅ structureModule X :=
  (lineBundle_trivial_of_affinePullback g hg L e).some

namespace DualNumberThickening

variable {k : Type u} [Field k] {X : Scheme.{u}}
  (f : X ⟶ Spec (CommRingCat.of k))

/-- The actual zero-section map is surjective on global sections of rings. -/
lemma closedPoint_appTop_surjective : Function.Surjective (closedPoint f).appTop := by
  intro a
  refine ⟨(projection f).appTop a, ?_⟩
  have h := congrArg (fun r : X ⟶ X ↦ r.appTop) (closedPoint_projection f)
  have he := congrArg (fun r ↦ r.hom a) h
  exact he

/-- On an affine original scheme, every line bundle trivial along the actual zero
section is already trivial on the actual thickening. -/
def affineZeroSectionTrivialization [IsAffine X] (L : LineBundle (thickening f))
    (e : (Scheme.Modules.pullback (closedPoint f)).obj L.obj ≅ structureModule X) :
    L.obj ≅ structureModule (thickening f) :=
  affinePullbackTrivialization (closedPoint f) (closedPoint_appTop_surjective f) L e

end DualNumberThickening

end Langlands.AlgebraicGeometry.Picard
