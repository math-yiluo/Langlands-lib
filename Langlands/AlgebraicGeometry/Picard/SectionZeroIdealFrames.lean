import Langlands.AlgebraicGeometry.Picard.SectionZeroIdeal
import Langlands.AlgebraicGeometry.Picard.LineBundlePullback
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_Scheme_Modules_exists_isFrameOn_of_pullback_iso_unit
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_Scheme_Modules_IsFrameOn_pullbackLocalSection
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_Scheme_IdealSheafData_ideal_comap_of_le

/-! # The zero ideal of a section in local frames, and its pullback -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.Picard.SectionZeroIdeal

section Frames

variable {X : Scheme.{u}} {M : X.Modules} {U : X.Opens}

lemma map_id_apply (s : Γ(M, U)) : M.presheaf.map (homOfLE (le_refl U)).op s = s := by
  rw [show (homOfLE (le_refl U)).op = 𝟙 (Opposite.op U) from rfl, M.presheaf.map_id]
  rfl

/-- The coordinate of a section in a frame, as a linear equivalence. -/
noncomputable def frameEquiv {t : Γ(M, U)} (ht : Scheme.Modules.IsFrameOn t U) :
    Γ(M, U) ≃ₗ[Γ(X, U)] Γ(X, U) :=
  (LinearEquiv.ofBijective (LinearMap.toSpanSingleton Γ(X, U) Γ(M, U) t) (by
    have h := ht.bijective (le_refl U) (le_refl U)
    simp only [map_id_apply] at h
    exact h)).symm

lemma frameEquiv_smul {t : Γ(M, U)} (ht : Scheme.Modules.IsFrameOn t U) (a : Γ(X, U)) :
    frameEquiv ht (a • t) = a := by
  rw [frameEquiv, LinearEquiv.symm_apply_eq]
  rfl

end Frames

section ZeroIdeal

variable {X : Scheme.{u}} (L : LineBundle X) (σ : Γ(L.obj, ⊤))

/-- On an affine open with a frame `t`, the zero ideal of `σ` is generated by the coordinate of
`σ` in that frame. -/
theorem zeroIdeal_ideal_of_frame (U : X.affineOpens) {t : Γ(L.obj, U.1)}
    (ht : Scheme.Modules.IsFrameOn t U.1) (a : Γ(X, U.1)) (h : res L σ U.1 = a • t) :
    (zeroIdeal L σ).ideal U = Ideal.span {a} := by
  rw [zeroIdeal_ideal_of_equiv L σ U (frameEquiv ht), h, frameEquiv_smul]

/-- Every point has an affine neighbourhood carrying a frame of a line bundle. -/
theorem exists_affine_frame (x : X) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ ∃ t : Γ(L.obj, U.1), Scheme.Modules.IsFrameOn t U.1 := by
  obtain ⟨V, hxV, ⟨e⟩⟩ := L.property x
  obtain ⟨s, hs⟩ := Scheme.Modules.exists_isFrameOn_of_pullback_iso_unit V
    (((Scheme.Modules.restrictFunctorIsoPullback V.ι).app L.obj).symm ≪≫ e)
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.2
  exact ⟨⟨U, hU⟩, hxU, L.obj.presheaf.map (homOfLE hUV).op s,
    ((hs.map (homOfLE hUV)).mono hUV)⟩

/-- The zero ideal of the zero section is the zero ideal sheaf. -/
theorem zeroIdeal_zero : zeroIdeal L 0 = ⊥ := by
  have hx := fun x => exists_affine_frame L x
  choose U hxU t ht using hx
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top U
    (top_le_iff.mp fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU x⟩) fun x => ?_
  rw [zeroIdeal_ideal_of_frame L 0 (U x) (ht x) 0 (by simp [res]), Ideal.span_singleton_eq_bot.mpr rfl]
  rfl

/-- Multiplying the section by a unit does not change its zero ideal. -/
theorem zeroIdeal_smul_unit (c : Γ(X, ⊤)) (hc : IsUnit c) :
    zeroIdeal L (c • σ) = zeroIdeal L σ := by
  ext U : 2
  change (Submodule.span Γ(X, U.1) {res L (c • σ) U.1}).colon Set.univ =
    (Submodule.span Γ(X, U.1) {res L σ U.1}).colon Set.univ
  have hres : res L (c • σ) U.1 = X.presheaf.map (homOfLE le_top).op c • res L σ U.1 :=
    Scheme.Modules.map_smul _ _ _ _
  have hu : IsUnit (X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op c) := hc.map _
  rw [hres, Submodule.span_singleton_smul_eq hu]

/-- Transporting the section along an isomorphism of line bundles does not change its zero
ideal. -/
theorem zeroIdeal_iso {L' : LineBundle X} (e : L.obj ≅ L'.obj) :
    zeroIdeal L' (e.hom.app ⊤ σ) = zeroIdeal L σ := by
  ext U : 2
  change (Submodule.span Γ(X, U.1) {res L' (e.hom.app ⊤ σ) U.1}).colon Set.univ =
    (Submodule.span Γ(X, U.1) {res L σ U.1}).colon Set.univ
  let f : Γ(L.obj, U.1) ≃ₗ[Γ(X, U.1)] Γ(L'.obj, U.1) :=
    { toFun := e.hom.app U.1
      invFun := e.inv.app U.1
      map_add' := map_add _
      map_smul' := fun m x => Scheme.Modules.Hom.app_smul e.hom m x
      left_inv := fun x => by
        change (e.hom.app U.1 ≫ e.inv.app U.1) x = x
        rw [← Scheme.Modules.Hom.comp_app, e.hom_inv_id, Scheme.Modules.Hom.id_app]; rfl
      right_inv := fun x => by
        change (e.inv.app U.1 ≫ e.hom.app U.1) x = x
        rw [← Scheme.Modules.Hom.comp_app, e.inv_hom_id, Scheme.Modules.Hom.id_app]; rfl }
  have hres : res L' (e.hom.app ⊤ σ) U.1 = f (res L σ U.1) := by
    have := (e.hom.mapPresheaf).naturality (homOfLE (le_top : U.1 ≤ ⊤)).op
    exact (congrFun (congrArg (fun g => (ConcreteCategory.hom g : Γ(L.obj, ⊤) → Γ(L'.obj, U.1)))
      this) σ).symm
  rw [hres]
  ext a
  simp only [Submodule.mem_colon, Set.mem_univ, true_implies, Submodule.mem_span_singleton]
  constructor
  · intro h p
    obtain ⟨c, hc⟩ := h (f p)
    exact ⟨c, f.injective (by rw [map_smul, map_smul, hc])⟩
  · intro h p
    obtain ⟨c, hc⟩ := h (f.symm p)
    exact ⟨c, by rw [← map_smul, hc, map_smul, LinearEquiv.apply_symm_apply]⟩

end ZeroIdeal

section Comap

variable {X X' : Scheme.{u}} (φ : X' ⟶ X) (L : LineBundle X) (σ : Γ(L.obj, ⊤))

/-- The pullback of a global section along a morphism of schemes. -/
noncomputable def pullbackSection : Γ(((LineBundle.pullback φ).obj L).obj, ⊤) :=
  ((Scheme.Modules.pullback φ).obj L.obj).presheaf.map
    (homOfLE (show (⊤ : X'.Opens) ≤ φ ⁻¹ᵁ ⊤ from fun _ _ => trivial)).op
    (Scheme.Modules.pullbackLocalSection φ σ)

/-- **The zero ideal commutes with pullback.** -/
theorem zeroIdeal_comap :
    (zeroIdeal L σ).comap φ = zeroIdeal ((LineBundle.pullback φ).obj L) (pullbackSection φ L σ) := by
  have hx : ∀ x' : X', ∃ (U : X.affineOpens) (t : Γ(L.obj, U.1)) (V : X'.affineOpens)
      (hVU : V.1 ≤ φ ⁻¹ᵁ U.1), x' ∈ V.1 ∧ Scheme.Modules.IsFrameOn t U.1 := by
    intro x'
    obtain ⟨U, hxU, t, ht⟩ := exists_affine_frame L (φ.base x')
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
      X'.isBasis_affineOpens.exists_subset_of_mem_open (show x' ∈ φ ⁻¹ᵁ U.1 from hxU)
        (φ ⁻¹ᵁ U.1).2
    exact ⟨U, t, ⟨V, hV⟩, hVU, hxV, ht⟩
  choose U t V hVU hxV ht using hx
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top V
    (top_le_iff.mp fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩) fun x => ?_
  -- coordinate of `σ` on `U x`
  obtain ⟨a, ha⟩ := ((ht x).bijective (le_refl _) (le_refl _)).2 (res L σ (U x).1)
  simp only [map_id_apply] at ha
  rw [Scheme.IdealSheafData.ideal_comap_of_le _ φ (U x) (V x) (hVU x),
    zeroIdeal_ideal_of_frame L σ (U x) (ht x) a ha.symm, Ideal.map_span, Set.image_singleton]
  -- the pulled-back frame on `V x`
  let t' : Γ(((LineBundle.pullback φ).obj L).obj, (V x).1) :=
    ((Scheme.Modules.pullback φ).obj L.obj).presheaf.map (homOfLE (hVU x)).op
      (Scheme.Modules.pullbackLocalSection φ (t x))
  have ht' : Scheme.Modules.IsFrameOn t' (V x).1 :=
    ((Scheme.Modules.IsFrameOn.pullbackLocalSection φ (ht x)).map (homOfLE (hVU x))).mono
      (hVU x)
  rw [zeroIdeal_ideal_of_frame _ _ (V x) ht' ((φ.appLE (U x).1 (V x).1 (hVU x)).hom a)]
  -- compute the restriction of the pulled-back section
  have h1 : res ((LineBundle.pullback φ).obj L) (pullbackSection φ L σ) (V x).1 =
      ((Scheme.Modules.pullback φ).obj L.obj).presheaf.map (homOfLE (hVU x)).op
        (((Scheme.Modules.pullback φ).obj L.obj).presheaf.map
          (homOfLE (show φ ⁻¹ᵁ (U x).1 ≤ φ ⁻¹ᵁ ⊤ from fun _ _ => trivial)).op
          (Scheme.Modules.pullbackLocalSection φ σ)) := by
    change ((Scheme.Modules.pullback φ).obj L.obj).presheaf.map _
      (((Scheme.Modules.pullback φ).obj L.obj).presheaf.map _ _) = _
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← ConcreteCategory.comp_apply,
      ← Functor.map_comp]
    rfl
  rw [h1, Scheme.Modules.map_homOfLE_pullbackLocalSection φ le_top σ]
  change ((Scheme.Modules.pullback φ).obj L.obj).presheaf.map (homOfLE (hVU x)).op
    (Scheme.Modules.pullbackLocalSection φ (res L σ (U x).1)) = _
  rw [ha.symm, Scheme.Modules.pullbackLocalSection_smul, Scheme.Modules.map_smul]
  congr 1

end Comap

end Langlands.AlgebraicGeometry.Picard.SectionZeroIdeal
