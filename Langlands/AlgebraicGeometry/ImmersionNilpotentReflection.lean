import Langlands.Algebra.NilpotentModuleFiniteness
import Langlands.AlgebraicGeometry.Modules.AdicStalkQuotient
import Langlands.AlgebraicGeometry.Picard.AffineBaseChangeKernel
import Langlands.AlgebraicGeometry.Picard.InfinitesimalTensorNilpotence
import Mathlib.AlgebraicGeometry.Morphisms.Immersion

/-! # Reflection of immersions by nilpotent affine base reduction -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Topology

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace Langlands.AlgebraicGeometry.ImmersionNilpotentReflection

open Langlands.AlgebraicGeometry.Modules.AdicStalkQuotient

/-- Surjectivity lifts when the quotient kernel is extended from a nilpotent
ideal of the source ring. No finite generation hypothesis is needed. -/
theorem surjective_of_nilpotent_quotient
    {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    (f : R →+* S) (q : S →+* T) (I : Ideal R) (hI : IsNilpotent I)
    (hker : RingHom.ker q = I.map f)
    (h : Function.Surjective (q.comp f)) : Function.Surjective f := by
  let : Algebra R S := f.toAlgebra
  let l : R →ₗ[R] S := (Algebra.ofId R S).toLinearMap
  suffices LinearMap.range l = ⊤ from LinearMap.range_eq_top.mp this
  apply Langlands.Algebra.eq_top_of_sup_smul_eq_top_of_nilpotent I hI
  apply top_unique
  intro s _
  obtain ⟨a, ha⟩ := h (q s)
  have hmem : s - f a ∈ I • (⊤ : Submodule R S) := by
    rw [Ideal.smul_top_eq_map]
    change s - f a ∈ I.map f
    rw [← hker]
    change q (s - f a) = 0
    rw [map_sub, sub_eq_zero]
    exact ha.symm
  exact Submodule.mem_sup.mpr
    ⟨f a, ⟨a, rfl⟩, s - f a, hmem, add_sub_cancel _ _⟩

/-- The base action on stalks is compatible with composition. -/
theorem baseStalkHom_comp {R : Type u} [CommRing R] {X Y : Scheme.{u}}
    (f : X ⟶ Y) (s : Y ⟶ Spec (CommRingCat.of R)) (x : X) :
    baseStalkHom (f ≫ s) x =
      (f.stalkMap x).hom.comp (baseStalkHom s (f x)) := by
  simp only [baseStalkHom, Scheme.Hom.stalkMap_comp, CommRingCat.hom_comp,
    RingHom.comp_assoc]
  congr 3

/-- The actual quotient projection has stalk kernel generated by the base ideal. -/
theorem ker_baseChange_stalkMap {R : Type u} [CommRing R] {X : Scheme.{u}}
    (s : X ⟶ Spec (CommRingCat.of R)) (I : Ideal R)
    (z : (pullback s (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) : Scheme.{u})) :
    RingHom.ker
        ((pullback.fst s (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).stalkMap z).hom =
      I.map (baseStalkHom s (pullback.fst s
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) z)) := by
  let r := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))
  let p := pullback.fst s r
  have : IsClosedImmersion r := IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨U, hU, hx, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := ⊤) (x := p z) (by simp)
  rw [Modules.ClosedImmersion.ker_stalkMap_eq_map p z U hU hx,
    Picard.AffineBaseChangeKernel.affine_ker (Ideal.Quotient.mk I) s
      Ideal.Quotient.mk_surjective U hU,
    Ideal.mk_ker, Ideal.map_map]
  rw [germ_comp_baseSectionHom]

/-- The quotient projection gives a homeomorphism on underlying spaces. -/
def baseChangeHomeomorph
    (R : Type u) [CommRing R] (I : Ideal R) (hI : IsNilpotent I)
    {X : Scheme.{u}} (s : X ⟶ Spec (CommRingCat.of R)) :
    (pullback s (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) : Scheme.{u}) ≃ₜ X := by
  let r := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))
  have : IsClosedImmersion r := IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have : Surjective r := Picard.InfinitesimalTensorNilpotence.spec_surjective
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective (by simpa only [Ideal.mk_ker] using hI)
  let p := pullback.fst s r
  exact (isHomeomorph_iff_isEmbedding_surjective.mpr
    ⟨p.isEmbedding, p.surjective⟩).homeomorph

/-- An immersion modulo a nilpotent ideal is already an immersion. -/
theorem isImmersion_of_nilpotent_baseChange
    (R : Type u) [CommRing R] (I : Ideal R) (hI : IsNilpotent I)
    {X Y : Over (Spec (CommRingCat.of R))} (f : X ⟶ Y)
    (hf : IsImmersion
      (((Over.pullback (Spec.algebraMap R (R ⧸ I))).map f).left)) :
    IsImmersion f.left := by
  let r := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))
  let X₀ := pullback X.hom r
  let Y₀ := pullback Y.hom r
  let pX : X₀ ⟶ X.left := pullback.fst X.hom r
  let pY : Y₀ ⟶ Y.left := pullback.fst Y.hom r
  let f₀ : X₀ ⟶ Y₀ := ((Over.pullback r).map f).left
  have : IsImmersion f₀ := hf
  have : IsClosedImmersion r := IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have : Surjective r := Picard.InfinitesimalTensorNilpotence.spec_surjective
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective (by simpa only [Ideal.mk_ker] using hI)
  have w : pX ≫ f.left = f₀ ≫ pY := by
    simp [f₀, pX, pY, Over.pullback_map_left]
  have : SurjectiveOnStalks (pX ≫ f.left) := by
    rw [w]
    infer_instance
  have : SurjectiveOnStalks f.left := by
    constructor
    intro x
    obtain ⟨z, rfl⟩ := pX.surjective x
    let B := Y.left.presheaf.stalk (f.left (pX z))
    let C := X.left.presheaf.stalk (pX z)
    let a : B →+* C := (f.left.stalkMap (pX z)).hom
    let q := (pX.stalkMap z).hom
    let J : Ideal B := I.map (baseStalkHom Y.hom (f.left (pX z)))
    have hJ : IsNilpotent J := hI.map (Ideal.mapHom _)
    have hbase : baseStalkHom X.hom (pX z) =
        a.comp (baseStalkHom Y.hom (f.left (pX z))) := by
      rw [← Over.w f, baseStalkHom_comp]
    have hker : RingHom.ker q = J.map a := by
      rw [ker_baseChange_stalkMap X.hom I z, hbase, ← Ideal.map_map]
    have hcomp : Function.Surjective (q.comp a) := by
      have hs := (pX ≫ f.left).stalkMap_surjective z
      rw [Scheme.Hom.stalkMap_comp] at hs
      exact hs
    exact surjective_of_nilpotent_quotient a q J hJ hker hcomp
  let eX : X₀ ≃ₜ X.left := baseChangeHomeomorph R I hI X.hom
  have he : (f.left : X.left → Y.left) = pY ∘ f₀ ∘ eX.symm := by
    funext x
    have hx := congrArg (fun g : X₀ ⟶ Y.left => g (eX.symm x)) w
    change f.left (eX (eX.symm x)) = pY (f₀ (eX.symm x)) at hx
    change f.left x = pY (f₀ (eX.symm x))
    simpa only [eX.apply_symm_apply] using hx
  have hrange : Set.range f.left = pY '' Set.range f₀ := by
    rw [← range_eq_range_of_surjective (f₀ ≫ pY) f.left pX w]
    exact Set.range_comp pY f₀
  refine { isEmbedding := ?_, isLocallyClosed_range := ?_ }
  · rw [he]
    exact pY.isEmbedding.comp (f₀.isEmbedding.comp eX.symm.isEmbedding)
  · rw [hrange]
    exact f₀.isLocallyClosed_range.image pY.isEmbedding.isInducing
      pY.isClosedEmbedding.isClosed_range.isLocallyClosed

end Langlands.AlgebraicGeometry.ImmersionNilpotentReflection
