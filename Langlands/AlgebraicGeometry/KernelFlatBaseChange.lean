import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import Mathlib.AlgebraicGeometry.Morphisms.Flat
import Mathlib.RingTheory.Flat.Basic
import Langlands.AnthropicFLT.P2M.Sol.S_AlgebraicGeometry_Scheme_IdealSheafData_ideal_comap_of_le

/-! # Flat base change of the kernel of a quasi-compact morphism

For a quasi-compact morphism `f : X ⟶ Y` and a flat morphism `p : Y' ⟶ Y`, the pullback along
`p` of the kernel ideal sheaf of `f` (the ideal of its scheme-theoretic image) is the kernel of
the base change `X ×_Y Y' ⟶ Y'`. This is Stacks Project, Tag 081I (Lemma 29.26.16), for a
quasi-compact morphism.
-/

universe u

open CategoryTheory CategoryTheory.Limits TensorProduct

set_option backward.isDefEq.respectTransparency false

namespace Langlands.AlgebraicGeometry.KernelFlatBaseChange

open _root_.AlgebraicGeometry

/-- For a pushout square of commutative rings with `R ⟶ B` flat, the kernel of `B ⟶ P` is
generated by the image of the kernel of `R ⟶ C`. -/
theorem ker_algebraMap_eq_map_ker_of_flat (R B C P : Type*) [CommRing R] [CommRing B]
    [CommRing C] [CommRing P] [Algebra R B] [Algebra R C] [Algebra B P] [Algebra C P]
    [Algebra R P] [IsScalarTower R B P] [IsScalarTower R C P] [Algebra.IsPushout R B C P]
    [Module.Flat R B] :
    RingHom.ker (algebraMap B P) = (RingHom.ker (algebraMap R C)).map (algebraMap R B) := by
  apply le_antisymm
  · intro x hx
    have h0 : x ⊗ₜ[R] (1 : C) = 0 := by
      apply (Algebra.IsPushout.equiv R B C P).injective
      rw [map_zero, Algebra.IsPushout.equiv_tmul, map_one, mul_one]
      exact hx
    let f : R →ₗ[R] C := Algebra.linearMap R C
    have hex := Module.Flat.lTensor_exact B (LinearMap.exact_subtype_ker_map f)
    obtain ⟨z, hz⟩ := (hex (x ⊗ₜ[R] (1 : R))).mp (by
      rw [LinearMap.lTensor_tmul]
      simpa [f] using h0)
    have hx' : x = TensorProduct.rid R B (x ⊗ₜ[R] (1 : R)) := by simp
    rw [hx', ← hz]
    clear hz hx' h0 hx
    induction z using TensorProduct.inductionOn with
    | tmul b k =>
      rw [LinearMap.lTensor_tmul, Submodule.coe_subtype, TensorProduct.rid_tmul, Algebra.smul_def]
      refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_)
      have hk := k.2
      rw [LinearMap.mem_ker] at hk
      simp [f] at hk ⊢
    | add a b ha hb => rw [map_add, map_add]; exact Ideal.add_mem _ ha hb
  · rw [Ideal.map_le_iff_le_comap]
    intro k hk
    rw [Ideal.mem_comap, RingHom.mem_ker, ← IsScalarTower.algebraMap_apply,
      IsScalarTower.algebraMap_apply R C P, (RingHom.mem_ker).mp hk, map_zero]

/-- The `CommRingCat` form of `ker_algebraMap_eq_map_ker_of_flat`. -/
theorem ker_eq_map_ker_of_isPushout_of_flat {R B C P : CommRingCat.{u}} {f : R ⟶ B}
    {g : R ⟶ C} {inl : B ⟶ P} {inr : C ⟶ P} (h : IsPushout f g inl inr) (hf : f.hom.Flat) :
    RingHom.ker inl.hom = (RingHom.ker g.hom).map f.hom := by
  algebraize [f.hom, g.hom, inl.hom, inr.hom, inl.hom.comp f.hom]
  have hw : inl.hom.comp f.hom = inr.hom.comp g.hom := by
    simpa only [CommRingCat.hom_comp] using congr(($(h.w)).hom)
  have : IsScalarTower R C P := .of_algebraMap_eq' hw
  have : Algebra.IsPushout R B C P := CommRingCat.isPushout_iff_isPushout.mp h
  exact ker_algebraMap_eq_map_ker_of_flat R B C P

/-- The affine case: `X`, `Y` and `Y'` affine. -/
theorem ker_comap_of_flat_of_isAffine {X Y Y' : Scheme.{u}} [IsAffine X] [IsAffine Y]
    [IsAffine Y'] (f : X ⟶ Y) (p : Y' ⟶ Y) [Flat p] :
    f.ker.comap p = (pullback.snd f p).ker := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  rw [P2MW.S_AlgebraicGeometry_Scheme_IdealSheafData_ideal_comap_of_le.AlgebraicGeometry.Scheme.IdealSheafData.ComapLocal.ideal_comap_top,
    Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
  have H := isPushout_appTop_of_isPullback (IsPullback.of_hasPullback f p)
  exact (ker_eq_map_ker_of_isPushout_of_flat H.flip (Scheme.Hom.flat_appTop p)).symm

/-- If every member of an open cover of `X` factors through `g : X₀ ⟶ X`, then `g` does not
change the kernel of a quasi-compact morphism out of `X`. -/
theorem ker_comp_eq_of_factors {X₀ X Y : Scheme.{u}} (g : X₀ ⟶ X) (h : X ⟶ Y) [QuasiCompact h]
    (𝒱 : X.OpenCover) (a : ∀ i, 𝒱.X i ⟶ X₀) (ha : ∀ i, a i ≫ g = 𝒱.f i) :
    (g ≫ h).ker = h.ker := by
  apply le_antisymm
  · rw [← h.iInf_ker_openCover_map_comp 𝒱]
    refine le_iInf fun i => ?_
    rw [← ha i, Category.assoc]
    exact Scheme.Hom.le_ker_comp _ _
  · exact Scheme.Hom.le_ker_comp g h

/-- The kernel of a quasi-compact morphism is compatible with restriction along an open
immersion of its target. -/
theorem ker_comap_of_isPullback_of_isOpenImmersion {X' Y' V W : Scheme.{u}} (g : X' ⟶ Y')
    [QuasiCompact g] (g' : W ⟶ V) (iW : W ⟶ X') (j : V ⟶ Y') [IsOpenImmersion j]
    (H : IsPullback g' iW j g) :
    g.ker.comap j = g'.ker := by
  ext U : 2
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    Scheme.ker_ideal_of_isPullback_of_isOpenImmersion g g' iW j H]

/-- Kernels of two morphisms agreeing up to an isomorphism of their sources agree. -/
theorem ker_eq_of_isPullback {P P' X Y Y' : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y'}
    {fst' : P' ⟶ X} {snd' : P' ⟶ Y'} {f : X ⟶ Y} {p : Y' ⟶ Y}
    (h : IsPullback fst snd f p) (h' : IsPullback fst' snd' f p) : snd.ker = snd'.ker := by
  rw [← h.isoIsPullback_hom_snd _ _ h', Scheme.Hom.ker_comp_of_isIso]

/-- The case of affine `Y` and `Y'`, for an arbitrary quasi-compact `f`. -/
theorem ker_comap_of_flat_of_isAffine_base {X Y Y' : Scheme.{u}} [IsAffine Y] [IsAffine Y']
    (f : X ⟶ Y) [QuasiCompact f] (p : Y' ⟶ Y) [Flat p] :
    f.ker.comap p = (pullback.snd f p).ker := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  let 𝒰 := X.affineCover.finiteSubcover
  let g : ∐ 𝒰.X ⟶ X := Sigma.desc 𝒰.f
  have h1 : (g ≫ f).ker = f.ker :=
    ker_comp_eq_of_factors g f 𝒰 (fun i => Sigma.ι 𝒰.X i) (fun i => Sigma.ι_comp_desc _ _)
  let g' : pullback (g ≫ f) p ⟶ pullback f p :=
    pullback.map _ _ _ _ g (𝟙 _) (𝟙 _) (by simp) (by simp)
  have hg' : g' ≫ pullback.snd f p = pullback.snd (g ≫ f) p := by simp [g']
  let 𝒱 := 𝒰.pullback₁ (pullback.fst f p)
  have h2 : (g' ≫ pullback.snd f p).ker = (pullback.snd f p).ker := by
    refine ker_comp_eq_of_factors g' (pullback.snd f p) 𝒱
      (fun i => pullback.lift (pullback.snd _ _ ≫ Sigma.ι 𝒰.X i)
        (pullback.fst _ _ ≫ pullback.snd f p) ?_) fun i => ?_
    · rw [Category.assoc, Category.assoc, Sigma.ι_comp_desc_assoc, ← pullback.condition_assoc,
        pullback.condition]
    · apply pullback.hom_ext
      · change _ = pullback.fst (pullback.fst f p) (𝒰.f i) ≫ pullback.fst f p
        simp [g', g, pullback.condition]
      · change _ = pullback.fst (pullback.fst f p) (𝒰.f i) ≫ pullback.snd f p
        simp [g']
  rw [← h1, ker_comap_of_flat_of_isAffine (g ≫ f) p, ← hg', h2]

/-- **Ideal sheaves agreeing on an open cover are equal.** -/
theorem eq_of_comap_eq {X : Scheme.{u}} {ι : Type*} (U : ι → X.Opens) (hU : ⨆ i, U i = ⊤)
    {I J : X.IdealSheafData}
    (h : ∀ i, I.comap (U i).ι = J.comap (U i).ι) : I = J := by
  have hx : ∀ x : X, ∃ (W : X.affineOpens) (i : ι), x ∈ W.1 ∧ W.1 ≤ U i := by
    intro x
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hU.ge (Set.mem_univ x))
    obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWU⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open hi (U i).2
    exact ⟨⟨W, hW⟩, i, hxW, hWU⟩
  choose W i hxW hWU using hx
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top W
    (top_le_iff.mp fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW x⟩) fun x => ?_
  let W' : (U (i x)).toScheme.affineOpens :=
    ⟨(U (i x)).ι ⁻¹ᵁ (W x).1, (W x).2.preimage_of_isOpenImmersion (U (i x)).ι (by
      rw [Scheme.Opens.opensRange_ι]; exact hWU x)⟩
  have himg : (U (i x)).ι ''ᵁ W'.1 = (W x).1 := by
    change (U (i x)).ι ''ᵁ ((U (i x)).ι ⁻¹ᵁ (W x).1) = (W x).1
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr (hWU x)
  have hI := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I (U (i x)).ι W'
  have hJ := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion J (U (i x)).ι W'
  rw [h (i x), hJ] at hI
  have hinj : Function.Injective
      (Ideal.comap (((U (i x)).ι.appIso W'.1).inv.hom) : Ideal _ → Ideal _) :=
    Ideal.comap_injective_of_surjective _
      (ConcreteCategory.bijective_of_isIso ((U (i x)).ι.appIso W'.1).inv).2
  have := hinj hI
  have hW : (⟨(U (i x)).ι ''ᵁ W'.1, W'.2.image_of_isOpenImmersion _⟩ : X.affineOpens) = W x :=
    Subtype.ext himg
  have key : ∀ W₀ : X.affineOpens, W₀ = W x → J.ideal W₀ = I.ideal W₀ →
      I.ideal (W x) = J.ideal (W x) := by
    rintro W₀ rfl h₀; exact h₀.symm
  exact key _ hW this

/-- The restriction to an affine open `V ⊆ p⁻¹(U)`, `U` affine, of both ideal sheaves agree. -/
theorem comap_ι_of_le {X Y Y' : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] (p : Y' ⟶ Y) [Flat p]
    (U : Y.affineOpens) (V : Y'.affineOpens) (hVU : V.1 ≤ p ⁻¹ᵁ U.1) :
    (f.ker.comap p).comap V.1.ι = (pullback.snd f p).ker.comap V.1.ι := by
  let pV : V.1.toScheme ⟶ U.1.toScheme := Y'.homOfLE hVU ≫ p ∣_ U.1
  have hpV : pV ≫ U.1.ι = V.1.ι ≫ p := by simp [pV]
  have : Flat (p ∣_ U.1) :=
    MorphismProperty.of_isPullback (P := @Flat) (isPullback_morphismRestrict p U.1).flip ‹Flat p›
  have : Flat pV := by dsimp only [pV]; infer_instance
  have : IsAffine V.1.toScheme := V.2
  have : IsAffine U.1.toScheme := U.2
  -- the left-hand side
  rw [← Scheme.IdealSheafData.comap_comp, ← hpV, Scheme.IdealSheafData.comap_comp,
    ker_comap_of_isPullback_of_isOpenImmersion f (f ∣_ U.1) (f ⁻¹ᵁ U.1).ι U.1.ι
      (isPullback_morphismRestrict f U.1),
    ker_comap_of_flat_of_isAffine_base (f ∣_ U.1) pV]
  -- the right-hand side
  have t := (IsPullback.of_hasPullback f p).flip
  have hR := IsPullback.of_bot' (IsPullback.of_hasPullback f (V.1.ι ≫ p)).flip t
  rw [ker_comap_of_isPullback_of_isOpenImmersion (pullback.snd f p) _ _ V.1.ι hR]
  have h := (IsPullback.of_hasPullback (f ∣_ U.1) pV).paste_horiz
    (isPullback_morphismRestrict f U.1).flip
  rw [hpV] at h
  exact ker_eq_of_isPullback h (IsPullback.of_hasPullback f (V.1.ι ≫ p))

/-- **Flat base change of the kernel of a quasi-compact morphism.** For a quasi-compact
`f : X ⟶ Y` and a flat `p : Y' ⟶ Y`, the pullback along `p` of the kernel ideal sheaf of `f` is
the kernel of the base change `pullback.snd f p : X ×_Y Y' ⟶ Y'`. -/
theorem ker_comap_of_flat {X Y Y' : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] (p : Y' ⟶ Y)
    [Flat p] : f.ker.comap p = (pullback.snd f p).ker := by
  have hx : ∀ y : Y', ∃ (U : Y.affineOpens) (V : Y'.affineOpens), y ∈ V.1 ∧ V.1 ≤ p ⁻¹ᵁ U.1 := by
    intro y
    obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (p y)) isOpen_univ
    obtain ⟨_, ⟨V, hV, rfl⟩, hyV, hVU⟩ := Y'.isBasis_affineOpens.exists_subset_of_mem_open
      (show y ∈ p ⁻¹ᵁ U from hyU) (p ⁻¹ᵁ U).2
    exact ⟨⟨U, hU⟩, ⟨V, hV⟩, hyV, hVU⟩
  choose U V hyV hVU using hx
  exact eq_of_comap_eq (fun y => (V y).1)
    (top_le_iff.mp fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hyV y⟩)
    fun y => comap_ι_of_le f p (U y) (V y) (hVU y)

/-- The `IsPullback` form of `ker_comap_of_flat`. -/
theorem ker_comap_of_flat_of_isPullback {P X Y Y' : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y'}
    {f : X ⟶ Y} {p : Y' ⟶ Y} [QuasiCompact f] [Flat p] (h : IsPullback fst snd f p) :
    f.ker.comap p = snd.ker := by
  rw [ker_comap_of_flat f p, ker_eq_of_isPullback (IsPullback.of_hasPullback f p) h]

end Langlands.AlgebraicGeometry.KernelFlatBaseChange
