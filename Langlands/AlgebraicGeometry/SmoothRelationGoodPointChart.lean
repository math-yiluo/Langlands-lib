import Langlands.AlgebraicGeometry.FiberStalkFlatness
import Langlands.AlgebraicGeometry.SmoothRelationGoodPoint
import Langlands.AlgebraicGeometry.SmoothRelationGoodPointCotangent

/-! # Good points in affine charts

Let `t s : R ⟶ U` be morphisms of schemes with a common section `e : U ⟶ R`. For affine opens
`V ⊆ U` and `W ⊆ s⁻¹ V ∩ t⁻¹ V` with `e x ∈ W`, the condition `IsGoodPoint t s e x` is expressed
in the local ring of `B = Γ(R, W)` at the prime `q` of `e x`, with `A = Γ(U, V)` acting through
`s`. If it holds, the differentials of the `t`-pullbacks of the functions in `q ∩ A` span the
cotangent space `κ(q) ⊗ Ω[B_q⁄A]`.
-/

universe u

open CategoryTheory Opposite IsLocalRing TensorProduct

namespace Langlands.AlgebraicGeometry.SmoothRelationGoodPoint

open _root_.AlgebraicGeometry

/-! ### Transport along ring isomorphisms -/

section Transport

variable {A : Type*} {B₁ : Type*} {B₂ : Type*} [CommRing A] [CommRing B₁] [CommRing B₂]
  [IsLocalRing B₁] [IsLocalRing B₂]

lemma comap_maximalIdeal_ringEquiv (φ : B₁ ≃+* B₂) :
    (maximalIdeal B₂).comap (φ : B₁ →+* B₂) = maximalIdeal B₁ :=
  IsLocalRing.maximalIdeal_comap (φ : B₁ →+* B₂)

lemma map_maximalIdeal_ringEquiv_symm (φ : B₁ ≃+* B₂) :
    (maximalIdeal B₂).map (φ.symm : B₂ →+* B₁) = maximalIdeal B₁ := by
  rw [Ideal.map_comap_of_equiv, RingEquiv.symm_symm]
  exact comap_maximalIdeal_ringEquiv φ

variable [Algebra A B₁] [Algebra A B₂]

lemma isRationalPoint_of_ringEquiv (φ : B₁ ≃+* B₂)
    (hφ : ∀ a, φ (algebraMap A B₁ a) = algebraMap A B₂ a) (h : IsRationalPoint A B₂) :
    IsRationalPoint A B₁ := by
  intro b
  obtain ⟨a, a', ha', hb⟩ := h (φ b)
  refine ⟨a, a', fun hm ↦ ha' ?_, ?_⟩
  · rw [← hφ, ← comap_maximalIdeal_ringEquiv φ] at *
    exact hm
  · rw [← comap_maximalIdeal_ringEquiv φ, Ideal.mem_comap]
    simpa [hφ] using hb

/-- Transport of the ideal equality `𝔪 = σ(𝔭) B + θ(𝔭) B` along a ring isomorphism compatible
with the algebra maps. -/
lemma maximalIdeal_eq_of_ringEquiv (φ : B₁ ≃+* B₂)
    (hφ : ∀ a, φ (algebraMap A B₁ a) = algebraMap A B₂ a) (θ₁ : A →+* B₁)
    (h : maximalIdeal B₂ =
      ((maximalIdeal B₂).comap (algebraMap A B₂)).map (algebraMap A B₂) ⊔
        ((maximalIdeal B₂).comap (algebraMap A B₂)).map ((φ : B₁ →+* B₂).comp θ₁)) :
    maximalIdeal B₁ =
      ((maximalIdeal B₁).comap (algebraMap A B₁)).map (algebraMap A B₁) ⊔
        ((maximalIdeal B₁).comap (algebraMap A B₁)).map θ₁ := by
  have hσ : algebraMap A B₂ = (φ : B₁ →+* B₂).comp (algebraMap A B₁) := by
    ext a; exact (hφ a).symm
  have h𝔭 : (maximalIdeal B₂).comap (algebraMap A B₂) =
      (maximalIdeal B₁).comap (algebraMap A B₁) := by
    rw [hσ, ← Ideal.comap_comap, comap_maximalIdeal_ringEquiv]
  have hsymm : ∀ f : A →+* B₁, ((φ.symm : B₂ →+* B₁).comp ((φ : B₁ →+* B₂).comp f)) = f := by
    intro f; ext a; simp
  rw [h𝔭] at h
  have := congrArg (Ideal.map (φ.symm : B₂ →+* B₁)) h
  rwa [map_maximalIdeal_ringEquiv_symm, Ideal.map_sup, hσ, Ideal.map_map, Ideal.map_map,
    hsymm, hsymm] at this

end Transport

/-! ### Charts of stalk maps -/

section Chart

variable {X Y : Scheme.{u}} (f : X ⟶ Y) {V : Y.Opens} {W : X.Opens} (hW : W ≤ f ⁻¹ᵁ V)

/-- The ring map `Γ(Y, V) → 𝒪_{X,x}` induced by `f`, for `x ∈ W ⊆ f⁻¹ V`. -/
noncomputable def chartMap (x : X) (hx : x ∈ W) : Γ(Y, V) →+* X.presheaf.stalk x :=
  (X.presheaf.germ W x hx).hom.comp (f.appLE V W hW).hom

lemma chartMap_apply (x : X) (hx : x ∈ W) (a : Γ(Y, V)) :
    chartMap f hW x hx a = (X.presheaf.germ W x hx).hom ((f.appLE V W hW).hom a) := rfl

lemma stalkMap_comp_germ (x : X) (hx : x ∈ W) (hfx : f x ∈ V) :
    (f.stalkMap x).hom.comp (Y.presheaf.germ V (f x) hfx).hom = chartMap f hW x hx := by
  rw [chartMap, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp,
    FiberStalkFlatness.germ_stalkMap_eq_appLE_germ f V W hW x hx hfx]

/-- On an affine open, every ideal of a stalk is generated by its sections. -/
lemma map_comap_germ (hV : IsAffineOpen V) (y : Y) (hy : y ∈ V) (J : Ideal (Y.presheaf.stalk y)) :
    (J.comap (Y.presheaf.germ V y hy).hom).map (Y.presheaf.germ V y hy).hom = J := by
  let := Y.presheaf.algebra_section_stalk ⟨y, hy⟩
  have := hV.isLocalization_stalk ⟨y, hy⟩
  exact IsLocalization.map_under (hV.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl _ J

/-- The image of the maximal ideal of `𝒪_{Y,f x}` in `𝒪_{X,x}` is generated by the image of the
prime of `Γ(Y, V)` at `f x`. -/
lemma map_maximalIdeal_stalkMap (hV : IsAffineOpen V) (x : X) (hx : x ∈ W) (hfx : f x ∈ V) :
    (maximalIdeal (Y.presheaf.stalk (f x))).map (f.stalkMap x).hom =
      ((maximalIdeal (X.presheaf.stalk x)).comap (chartMap f hW x hx)).map
        (chartMap f hW x hx) := by
  have hc : (maximalIdeal (X.presheaf.stalk x)).comap (chartMap f hW x hx) =
      (maximalIdeal (Y.presheaf.stalk (f x))).comap (Y.presheaf.germ V (f x) hfx).hom := by
    rw [← stalkMap_comp_germ f hW x hx hfx, ← Ideal.comap_comap, IsLocalRing.maximalIdeal_comap]
  rw [hc, ← stalkMap_comp_germ f hW x hx hfx, ← Ideal.map_map, map_comap_germ hV]

end Chart

/-! ### Good points in charts -/

section GoodPoint

variable {U R : Scheme.{u}} (t s : R ⟶ U) (e : U ⟶ R)

lemma apply_apply_of_comp_eq_id {f : R ⟶ U} (hf : e ≫ f = 𝟙 U) (x : U) : f (e x) = x := by
  rw [← Scheme.Hom.comp_apply, hf]
  rfl

lemma mem_of_comp_eq_id {f : R ⟶ U} (hf : e ≫ f = 𝟙 U) {x : U} {V : U.Opens} {W : R.Opens}
    (hW : W ≤ f ⁻¹ᵁ V) (hx : e x ∈ W) : x ∈ V := by
  have : f (e x) ∈ V := hW hx
  rwa [apply_apply_of_comp_eq_id e hf] at this

/-- `IsGoodPoint` in terms of the chart maps `Γ(U, V) → 𝒪_{R, e x}` of `s` and `t`. -/
theorem isGoodPoint_iff_chartMap (x : U) {V : U.Opens} (hV : IsAffineOpen V) {W : R.Opens}
    (hpW : e x ∈ W) (hWs : W ≤ s ⁻¹ᵁ V) (hWt : W ≤ t ⁻¹ᵁ V) :
    IsGoodPoint t s e x ↔
      maximalIdeal (R.presheaf.stalk (e x)) =
        ((maximalIdeal _).comap (chartMap s hWs (e x) hpW)).map (chartMap s hWs (e x) hpW) ⊔
          ((maximalIdeal _).comap (chartMap t hWt (e x) hpW)).map (chartMap t hWt (e x) hpW) := by
  rw [IsGoodPoint, map_maximalIdeal_stalkMap s hWs hV (e x) hpW (hWs hpW),
    map_maximalIdeal_stalkMap t hWt hV (e x) hpW (hWt hpW)]

lemma appLE_germ_of_eq_id {g : U ⟶ U} (hg : g = 𝟙 U) {V V' : U.Opens} (h : V' ≤ g ⁻¹ᵁ V)
    (x : U) (hx : x ∈ V') (hxV : x ∈ V) :
    g.appLE V V' h ≫ U.presheaf.germ V' x hx = U.presheaf.germ V x hxV := by
  subst hg
  simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
  exact TopCat.Presheaf.germ_res _ _ _ _

/-- If `e ≫ f = 𝟙`, then `e^#` maps the chart map of `f` at `e x` to the germ at `x`. -/
lemma appLE_germ_stalkMap_of_comp_eq_id {f : R ⟶ U} (hf : e ≫ f = 𝟙 U) (x : U) {V : U.Opens}
    {W : R.Opens} (hW : W ≤ f ⁻¹ᵁ V) (hx : e x ∈ W) (hxV : x ∈ V) :
    f.appLE V W hW ≫ R.presheaf.germ W (e x) hx ≫ e.stalkMap x = U.presheaf.germ V x hxV := by
  rw [Scheme.Hom.germ_stalkMap, ← Category.assoc, Scheme.Hom.app_eq_appLE,
    Scheme.Hom.appLE_comp_appLE]
  exact appLE_germ_of_eq_id (hf ▸ rfl) _ x hx hxV

lemma stalkMap_chartMap_of_comp_eq_id {f : R ⟶ U} (hf : e ≫ f = 𝟙 U) (x : U) {V : U.Opens}
    {W : R.Opens} (hW : W ≤ f ⁻¹ᵁ V) (hx : e x ∈ W) (hxV : x ∈ V) (a : Γ(U, V)) :
    (e.stalkMap x).hom (chartMap f hW (e x) hx a) = (U.presheaf.germ V x hxV).hom a :=
  congr($(appLE_germ_stalkMap_of_comp_eq_id e hf x hW hx hxV).hom a)

/-- If `e ≫ f = 𝟙`, the prime of `Γ(U, V)` below the maximal ideal of `𝒪_{R, e x}` along the
chart map of `f` is the prime of `x`. -/
lemma comap_maximalIdeal_chartMap_of_comp_eq_id {f : R ⟶ U} (hf : e ≫ f = 𝟙 U) (x : U)
    {V : U.Opens} {W : R.Opens} (hW : W ≤ f ⁻¹ᵁ V) (hx : e x ∈ W) (hxV : x ∈ V) :
    (maximalIdeal (R.presheaf.stalk (e x))).comap (chartMap f hW (e x) hx) =
      (maximalIdeal (U.presheaf.stalk x)).comap (U.presheaf.germ V x hxV).hom := by
  have h : (e.stalkMap x).hom.comp (chartMap f hW (e x) hx) = (U.presheaf.germ V x hxV).hom := by
    ext a; exact stalkMap_chartMap_of_comp_eq_id e hf x hW hx hxV a
  rw [← h, ← Ideal.comap_comap, IsLocalRing.maximalIdeal_comap (e.stalkMap x).hom]

/-- If `e ≫ f = 𝟙`, then `𝒪_{R, e x}` is a rational point over `Γ(U, V)` along the chart map of
`f`: every element is congruent to a fraction of sections modulo the maximal ideal. -/
lemma isRationalPoint_chartMap {f : R ⟶ U} (hf : e ≫ f = 𝟙 U) (x : U) {V : U.Opens}
    (hV : IsAffineOpen V) {W : R.Opens} (hW : W ≤ f ⁻¹ᵁ V) (hx : e x ∈ W) (hxV : x ∈ V)
    (b : R.presheaf.stalk (e x)) :
    ∃ a a' : Γ(U, V), chartMap f hW (e x) hx a' ∉ maximalIdeal _ ∧
      chartMap f hW (e x) hx a' * b - chartMap f hW (e x) hx a ∈ maximalIdeal _ := by
  let := U.presheaf.algebra_section_stalk ⟨x, hxV⟩
  have := hV.isLocalization_stalk ⟨x, hxV⟩
  obtain ⟨⟨a, a'⟩, hz⟩ :=
    IsLocalization.surj (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl ((e.stalkMap x).hom b)
  have hunit : IsUnit ((U.presheaf.germ V x hxV).hom a') :=
    IsLocalization.map_units (U.presheaf.stalk x) a'
  have he := stalkMap_chartMap_of_comp_eq_id e hf x hW hx hxV
  refine ⟨a, a', fun hm ↦ ?_, ?_⟩
  · have := map_nonunit (e.stalkMap x).hom _ hm
    rw [he, IsLocalRing.mem_maximalIdeal] at this
    exact this hunit
  · rw [← IsLocalRing.maximalIdeal_comap (e.stalkMap x).hom, Ideal.mem_comap, map_sub, map_mul,
      he, he]
    have hz' : (e.stalkMap x).hom b * (U.presheaf.germ V x hxV).hom a' =
        (U.presheaf.germ V x hxV).hom a := hz
    rw [mul_comm, hz', sub_self]
    exact zero_mem _

end GoodPoint

/-! ### The cotangent span at a good point -/

section Residue

variable {U R : Scheme.{u}} {t s : R ⟶ U} {e : U ⟶ R}

/-- The two pullbacks of the prime of `x` agree: `q ∩ Γ(U, V)` along `s` and along `t` is the
prime of `x`. -/
lemma comap_appLE_eq_comap_appLE (ht : e ≫ t = 𝟙 U) (hs : e ≫ s = 𝟙 U) (x : U) {V : U.Opens}
    {W : R.Opens} (hW : IsAffineOpen W) (hpW : e x ∈ W) (hWs : W ≤ s ⁻¹ᵁ V)
    (hWt : W ≤ t ⁻¹ᵁ V) :
    (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal.comap (t.appLE V W hWt).hom =
      (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal.comap (s.appLE V W hWs).hom := by
  have hxV : x ∈ V := mem_of_comp_eq_id e hs hWs hpW
  let := R.presheaf.algebra_section_stalk ⟨e x, hpW⟩
  have := hW.isLocalization_stalk ⟨e x, hpW⟩
  have hq : (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal =
      (maximalIdeal (R.presheaf.stalk (e x))).comap (R.presheaf.germ W (e x) hpW).hom :=
    (IsLocalization.AtPrime.under_maximalIdeal (R.presheaf.stalk (e x))
      (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal).symm
  rw [hq, Ideal.comap_comap, Ideal.comap_comap]
  change (maximalIdeal _).comap (chartMap t hWt (e x) hpW) =
    (maximalIdeal _).comap (chartMap s hWs (e x) hpW)
  rw [comap_maximalIdeal_chartMap_of_comp_eq_id e ht x hWt hpW hxV,
    comap_maximalIdeal_chartMap_of_comp_eq_id e hs x hWs hpW hxV]

/-- **Cotangent span at a good point.** Let `e` be a common section of `t s : R ⟶ U`, let
`V ⊆ U` and `W ⊆ s⁻¹ V ∩ t⁻¹ V` be affine opens with `e x ∈ W`, and let `B = Γ(R, W)` be a
`Γ(U, V)`-algebra through `s`. If `x` is good, then for the prime `q` of `e x` and
`p = q ∩ Γ(U, V)`, the elements `1 ⊗ d(t^# g)`, `g ∈ p`, span `κ(q) ⊗ Ω[B_q⁄Γ(U, V)]`. -/
theorem residueSpan_eq_top_of_isGoodPoint (ht : e ≫ t = 𝟙 U) (hs : e ≫ s = 𝟙 U) (x : U)
    {V : U.Opens} (hV : IsAffineOpen V) {W : R.Opens} (hW : IsAffineOpen W) (hpW : e x ∈ W)
    (hWs : W ≤ s ⁻¹ᵁ V) (hWt : W ≤ t ⁻¹ᵁ V) [Algebra Γ(U, V) Γ(R, W)]
    (hσ : algebraMap Γ(U, V) Γ(R, W) = (s.appLE V W hWs).hom) (q : Ideal Γ(R, W)) [q.IsPrime]
    (hq : (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal = q) (hgood : IsGoodPoint t s e x) :
    Submodule.span (ResidueField (Localization.AtPrime q))
      (Set.range (fun y : (t.appLE V W hWt).hom ''
          (q.comap (algebraMap Γ(U, V) Γ(R, W)) : Set Γ(U, V)) ↦
        (1 : ResidueField (Localization.AtPrime q)) ⊗ₜ[Localization.AtPrime q]
          KaehlerDifferential.D Γ(U, V) (Localization.AtPrime q)
            (algebraMap Γ(R, W) (Localization.AtPrime q) y))) = ⊤ := by
  have hxV : x ∈ V := mem_of_comp_eq_id e hs hWs hpW
  -- the good-point equality in the stalk, with the same prime on both sides
  have hgood' := (isGoodPoint_iff_chartMap t s e x hV hpW hWs hWt).mp hgood
  rw [comap_maximalIdeal_chartMap_of_comp_eq_id e ht x hWt hpW hxV,
    ← comap_maximalIdeal_chartMap_of_comp_eq_id e hs x hWs hpW hxV] at hgood'
  subst hq
  let := R.presheaf.algebra_section_stalk ⟨e x, hpW⟩
  have := hW.isLocalization_stalk ⟨e x, hpW⟩
  let φ := IsLocalization.algEquiv (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal.primeCompl
    (Localization.AtPrime (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal) (R.presheaf.stalk (e x))
  let : Algebra Γ(U, V) (R.presheaf.stalk (e x)) := (chartMap s hWs (e x) hpW).toAlgebra
  have hφ : ∀ a, φ.toRingEquiv (algebraMap Γ(U, V)
      (Localization.AtPrime (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal) a) =
      algebraMap Γ(U, V) (R.presheaf.stalk (e x)) a := by
    intro a
    change φ _ = _
    rw [IsScalarTower.algebraMap_apply Γ(U, V) Γ(R, W), AlgEquiv.commutes, hσ]
    rfl
  let θ₁ := (algebraMap Γ(R, W) (Localization.AtPrime (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal)).comp
    (t.appLE V W hWt).hom
  have hθ : (φ.toRingEquiv : _ →+* R.presheaf.stalk (e x)).comp θ₁ = chartMap t hWt (e x) hpW := by
    ext a
    change φ (algebraMap Γ(R, W) _ ((t.appLE V W hWt).hom a)) = _
    rw [AlgEquiv.commutes]
    rfl
  have hrat : IsRationalPoint Γ(U, V) (R.presheaf.stalk (e x)) :=
    isRationalPoint_chartMap e hs x hV hWs hpW hxV
  have h₁ := maximalIdeal_eq_of_ringEquiv φ.toRingEquiv hφ θ₁ (by rw [hθ]; exact hgood')
  have hspan := cotangentSpan_eq_top_of_maximalIdeal_eq θ₁
    (isRationalPoint_of_ringEquiv φ.toRingEquiv hφ hrat) h₁
  -- the prime of `Γ(U, V)` below the maximal ideal of `B_q`
  have hp : (maximalIdeal (Localization.AtPrime (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal)).comap
      (algebraMap Γ(U, V) (Localization.AtPrime (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal)) =
      (hW.primeIdealOf ⟨e x, hpW⟩).asIdeal.comap (algebraMap Γ(U, V) Γ(R, W)) := by
    rw [IsScalarTower.algebraMap_eq Γ(U, V) Γ(R, W), ← Ideal.comap_comap]
    congr 1
    exact Localization.AtPrime.under_maximalIdeal
  rw [cotangentSpan, hp] at hspan
  rw [← hspan]
  congr 1
  ext z
  constructor
  · rintro ⟨⟨_, g, hg, rfl⟩, rfl⟩
    exact ⟨⟨g, hg⟩, rfl⟩
  · rintro ⟨⟨g, hg⟩, rfl⟩
    exact ⟨⟨(t.appLE V W hWt).hom g, g, hg, rfl⟩, rfl⟩

end Residue

end Langlands.AlgebraicGeometry.SmoothRelationGoodPoint
