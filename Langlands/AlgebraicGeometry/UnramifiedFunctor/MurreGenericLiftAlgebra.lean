import Mathlib.RingTheory.RamificationInertia.Ramification
import Mathlib.RingTheory.Unramified.LocalRing
import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian
import Mathlib.RingTheory.Localization.LocalizationLocalization
import Mathlib.RingTheory.KrullDimension.Zero

/-! # Commutative algebra for Murre's Lemma 2, case (b)

Facts used to set up condition (F8) near a point `P` of an unramified algebra `S` over a
ring `R` whose image in `Spec R` lies in the nilradical:
* `P` is a minimal prime of `S` (`mem_minimalPrimes_of_under_le_nilradical`), since
  `P S_P = (P ∩ R) S_P` consists of nilpotents;
* for `S` noetherian there is `h ∉ P` lying in every other minimal prime, and then
  `nilradical S[1/h] = P S[1/h]` (`nilradical_away_eq`);
* quotients by ideals inside the nilradical keep the nilradical
  (`comap_nilradical_quotient`, `nilradical_quotient_eq_map`). -/

universe u

open IsLocalRing

noncomputable section

namespace Langlands.AlgebraicGeometry.UnramifiedFunctor

namespace GenericLift

section Unramified

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- For `S` essentially of finite type and formally unramified over `R`, and `q` a prime of
`S`, the maximal ideal of `S_q` is generated by the prime of `R` under `q`. -/
theorem map_under_eq_maximalIdeal [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]
    (q : Ideal S) [q.IsPrime] :
    (q.under R).map (algebraMap R (Localization.AtPrime q)) =
      maximalIdeal (Localization.AtPrime q) := by
  let p := q.under R
  let : Algebra (Localization.AtPrime p) (Localization.AtPrime q) :=
    Localization.AtPrime.algebraOfLiesOver p q
  have : Algebra.EssFiniteType (Localization.AtPrime p) (Localization.AtPrime q) :=
    Algebra.EssFiniteType.of_comp R _ _
  rw [IsScalarTower.algebraMap_eq R (Localization.AtPrime p) (Localization.AtPrime q),
    ← Ideal.map_map, Localization.AtPrime.map_eq_maximalIdeal]
  exact Algebra.FormallyUnramified.map_maximalIdeal

/-- If the prime under `P` consists of nilpotents, so does the image of `P` in `S_P`. -/
theorem isNilpotent_algebraMap_of_mem [Algebra.EssFiniteType R S]
    [Algebra.FormallyUnramified R S] (P : Ideal S) [P.IsPrime]
    (hP : P.under R ≤ nilradical R) {x : S} (hx : x ∈ P) :
    IsNilpotent (algebraMap S (Localization.AtPrime P) x) := by
  have hx' : algebraMap S (Localization.AtPrime P) x ∈ maximalIdeal (Localization.AtPrime P) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ P x).2 hx
  rw [← map_under_eq_maximalIdeal (R := R) P] at hx'
  have hle : (P.under R).map (algebraMap R (Localization.AtPrime P)) ≤
      nilradical (Localization.AtPrime P) :=
    Ideal.map_le_iff_le_comap.2 fun r hr ↦ (mem_nilradical.1 (hP hr)).map _
  exact mem_nilradical.1 (hle hx')

/-- A prime of an unramified `R`-algebra lying over a prime of `R` inside the nilradical is a
minimal prime. -/
theorem mem_minimalPrimes_of_under_le_nilradical [Algebra.EssFiniteType R S]
    [Algebra.FormallyUnramified R S] (P : Ideal S) [hP : P.IsPrime]
    (hPR : P.under R ≤ nilradical R) : P ∈ minimalPrimes S := by
  refine ⟨⟨hP, bot_le⟩, fun P' hP' hle x hx ↦ ?_⟩
  obtain ⟨n, hn⟩ := isNilpotent_algebraMap_of_mem P hPR hx
  rw [← map_pow] at hn
  obtain ⟨⟨s, hs⟩, hsx⟩ := (IsLocalization.map_eq_zero_iff P.primeCompl _ _).1 hn
  have hmem : s * x ^ n ∈ P' := by
    rw [hsx]
    exact P'.zero_mem
  rcases hP'.1.mem_or_mem hmem with h | h
  · exact absurd (hle h) hs
  · exact hP'.1.mem_of_pow_mem n h

end Unramified

section Minimal

variable {S : Type u} [CommRing S]

/-- In a noetherian ring, for a minimal prime `P` there is `h ∉ P` lying in every other minimal
prime. -/
theorem exists_mem_other_minimalPrimes [IsNoetherianRing S] {P : Ideal S}
    (hP : P ∈ minimalPrimes S) :
    ∃ h ∉ P, ∀ P' ∈ minimalPrimes S, P' ≠ P → h ∈ P' := by
  set s := (minimalPrimes.finite_of_isNoetherianRing S).toFinset.erase P
  have hs : ¬ s.inf id ≤ P := by
    intro hle
    obtain ⟨P', hP's, hP'le⟩ := (Ideal.IsPrime.inf_le' hP.1.1).1 hle
    obtain ⟨hne, hP'm⟩ := Finset.mem_erase.1 hP's
    rw [Set.Finite.mem_toFinset] at hP'm
    exact hne (le_antisymm hP'le (hP.2 hP'm.1 hP'le))
  obtain ⟨h, hhs, hhP⟩ := SetLike.not_le_iff_exists.1 hs
  exact ⟨h, hhP, fun P' hP' hne ↦
    Finset.inf_le (f := id) (Finset.mem_erase.2 ⟨hne, (Set.Finite.mem_toFinset _).2 hP'⟩) hhs⟩

/-- With `h` as in `exists_mem_other_minimalPrimes`, every prime not containing `h` contains
`P`. -/
theorem le_of_notMem_of_mem_other {P : Ideal S} {h : S}
    (hh : ∀ P' ∈ minimalPrimes S, P' ≠ P → h ∈ P') (Q : Ideal S) [Q.IsPrime] (hQ : h ∉ Q) :
    P ≤ Q := by
  obtain ⟨P₀, hP₀, hle⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ Q)
  by_cases e : P₀ = P
  · exact e ▸ hle
  · exact absurd (hle (hh P₀ hP₀ e)) hQ

/-- If every prime not containing `h` contains the prime `P ∌ h`, the nilradical of `S[1/h]`
is `P S[1/h]`. -/
theorem nilradical_away_eq {P : Ideal S} [hP : P.IsPrime] {h : S} (hhP : h ∉ P)
    (hle : ∀ Q : Ideal S, Q.IsPrime → h ∉ Q → P ≤ Q) :
    nilradical (Localization.Away h) = P.map (algebraMap S (Localization.Away h)) := by
  have hd : Disjoint (Submonoid.powers h : Set S) P :=
    (Ideal.disjoint_powers_iff_notMem_of_isPrime h).2 hhP
  have := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h)
    (Localization.Away h) P hP hd
  refine le_antisymm (nilradical_le_prime _) ?_
  rw [nilradical_eq_sInf]
  refine le_sInf fun J hJ ↦ ?_
  have : J.IsPrime := hJ
  have hhJ : h ∉ J.comap (algebraMap S (Localization.Away h)) := fun hJh ↦
    this.ne_top (Ideal.eq_top_of_isUnit_mem _ hJh (IsLocalization.Away.algebraMap_isUnit h))
  rw [← IsLocalization.map_under (Submonoid.powers h) (Localization.Away h) J]
  exact Ideal.map_mono (hle _ (Ideal.comap_isPrime _ _) hhJ)

end Minimal

section Quotient

variable {T : Type u} [CommRing T] {K : Ideal T}

/-- Dividing by an ideal inside the nilradical does not change the nilradical. -/
theorem comap_nilradical_quotient (hK : K ≤ nilradical T) :
    (nilradical (T ⧸ K)).comap (Ideal.Quotient.mk K) = nilradical T := by
  ext x
  rw [Ideal.mem_comap, mem_nilradical, mem_nilradical]
  refine ⟨fun ⟨n, hn⟩ ↦ ?_, fun hx ↦ hx.map _⟩
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hn
  exact (mem_nilradical.1 (hK hn)).of_pow

theorem nilradical_quotient_eq_map (hK : K ≤ nilradical T) :
    nilradical (T ⧸ K) = (nilradical T).map (Ideal.Quotient.mk K) := by
  rw [← comap_nilradical_quotient hK,
    Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective]

theorem isPrime_nilradical_quotient (hK : K ≤ nilradical T) [(nilradical T).IsPrime] :
    (nilradical (T ⧸ K)).IsPrime := by
  rw [nilradical_quotient_eq_map hK]
  exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])

end Quotient

end GenericLift

end Langlands.AlgebraicGeometry.UnramifiedFunctor
