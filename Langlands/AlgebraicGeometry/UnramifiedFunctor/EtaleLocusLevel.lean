import Langlands.AlgebraicGeometry.UnramifiedFunctor.EtaleLocusStalk
import Mathlib.RingTheory.HopkinsLevitzki

/-! # Levels and local data

A *level* is a ring `D` with a ring map `ρ : R' → D` such that the base change of `F` to
`Spec D` is represented by a scheme `X` over `Spec D` (locally of finite type and formally
unramified). A *local datum* at a point `w` of `U = Spec (R'/𝔍)` is a local ring `L` with maps
`R'/𝔍 → L` and `D → L` which is universal among local rings over `R'/𝔍` and `D` whose maximal
ideal lies over `w`. The image of `ξ` in `F(Spec L)` is a point of `X` with values in `L`,
which defines a point `x` of `X`, its local ring `Λ = 𝒪_{X,x}`, a surjection `ψ : Λ → L` and
the structure map `θ : D → Λ`. This module relates infinitesimal étaleness of `ξ` at `w`
(through `KillAt`) to the vanishing of `θ(ρ 𝔍)`, and proves that `ker ψ` is generated by
`θ(ρ 𝔍)`. -/

universe u v

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite IsLocalRing

noncomputable section

namespace Langlands.AlgebraicGeometry.UnramifiedFunctor

namespace EtaleLocus

section ElemEquiv

variable {S : Scheme.{u}} {F : (Over S)ᵒᵖ ⥤ Type v} {S' : Scheme.{u}} (g : S' ⟶ S)
  {Y' : Over S'} (e : (baseChange g F).RepresentableBy Y')

/-- Elements attached to morphisms with the same underlying scheme morphism agree. -/
lemma elemEquiv_congr {T : Over S} {t t' : T.left ⟶ S'} (ht : t ≫ g = T.hom)
    (ht' : t' ≫ g = T.hom) (a : Over.mk t ⟶ Y') (a' : Over.mk t' ⟶ Y')
    (h : a.left = a'.left) :
    Charts.elemEquiv g e T t ht a = Charts.elemEquiv g e T t' ht' a' := by
  have htt : t = t' := by
    have h1 : a.left ≫ Y'.hom = t := Over.w a
    have h2 : a'.left ≫ Y'.hom = t' := Over.w a'
    rw [← h1, ← h2, h]
  subst htt
  congr 1
  ext1
  exact h

/-- Equal elements come from morphisms with the same underlying scheme morphism. -/
lemma left_eq_of_elemEquiv_eq {T : Over S} {t t' : T.left ⟶ S'} (ht : t ≫ g = T.hom)
    (ht' : t' ≫ g = T.hom) (htt : t = t') (a : Over.mk t ⟶ Y') (a' : Over.mk t' ⟶ Y')
    (h : Charts.elemEquiv g e T t ht a = Charts.elemEquiv g e T t' ht' a') :
    a.left = a'.left := by
  subst htt
  rw [(Charts.elemEquiv g e T t ht).injective h]

end ElemEquiv

variable {R : CommRingCat.{u}} {F : (Over (Spec R))ᵒᵖ ⥤ Type v}
  {R' : Type u} [CommRing R'] [Algebra R R'] {𝔍 : Ideal R'}

section Level

variable {D : Type u} [CommRing D] (ρ : R' →+* D)

variable (R) in
/-- The morphism `Spec D ⟶ Spec R` of a level `ρ : R' → D`. -/
abbrev levelMap : Spec (CommRingCat.of D) ⟶ Spec R :=
  Spec.map (CommRingCat.ofHom (ρ.comp (algebraMap R R')))

variable (F) in
/-- A level: a representing scheme of the base change of `F` along `levelMap R ρ`, locally of
finite type and formally unramified over `Spec D`. -/
structure Level where
  /-- The representing scheme. -/
  X : Scheme.{u}
  /-- Its structure morphism. -/
  q : X ⟶ Spec (CommRingCat.of D)
  /-- The representation. -/
  e : (baseChange (levelMap R ρ) F).RepresentableBy (Over.mk q)
  [lft : LocallyOfFiniteType q]
  [fu : FormallyUnramified q]

attribute [instance] Level.lft Level.fu

variable (R 𝔍) in
/-- A local datum at the point `w` of `Spec (R'/𝔍)` for the level `ρ : R' → D`. -/
structure LocalDatum (w : Spec (CommRingCat.of (R' ⧸ 𝔍))) (L : Type u) [CommRing L]
    [IsLocalRing L] where
  /-- The map from `R'/𝔍`. -/
  ℓ : R' ⧸ 𝔍 →+* L
  /-- The map from `D`. -/
  δ : D →+* L
  /-- The structure morphism of `Spec L` over `Spec R`. -/
  f : Spec (CommRingCat.of L) ⟶ Spec R
  hf : Spec.map (CommRingCat.ofHom ((ℓ.comp (Ideal.Quotient.mk 𝔍)).comp (algebraMap R R'))) = f
  comm : ℓ.comp (Ideal.Quotient.mk 𝔍) = δ.comp ρ
  comap_eq : (maximalIdeal L).comap ℓ = w.asIdeal
  univ : ∀ (C : Type u) [CommRing C] [IsLocalRing C] (γ : R' ⧸ 𝔍 →+* C) (δ' : D →+* C),
    γ.comp (Ideal.Quotient.mk 𝔍) = δ'.comp ρ → (maximalIdeal C).comap γ = w.asIdeal →
    ∃ μ : L →+* C, IsLocalHom μ ∧ μ.comp ℓ = γ ∧ μ.comp δ = δ'
  gen : ∀ l : L, ∃ a s : D, IsUnit (δ s) ∧ l * δ s = δ a

namespace LocalDatum

variable {ρ} {w : Spec (CommRingCat.of (R' ⧸ 𝔍))} {L : Type u} [CommRing L] [IsLocalRing L]
  (d : LocalDatum R 𝔍 ρ w L)

lemma hT : Spec.map (CommRingCat.ofHom d.δ) ≫ levelMap R ρ = d.f := by
  rw [← d.hf, levelMap, specMap_ofHom_comp, d.comm, RingHom.comp_assoc]

/-- Ring maps out of `L` are determined on the image of `D`. -/
lemma hom_ext {C : Type*} [CommRing C] {ν₁ ν₂ : L →+* C} (h : ν₁.comp d.δ = ν₂.comp d.δ) :
    ν₁ = ν₂ := by
  ext l
  obtain ⟨a, s, hs, hl⟩ := d.gen l
  have ha := RingHom.congr_fun h a
  have hs' := RingHom.congr_fun h s
  simp only [RingHom.comp_apply] at ha hs'
  apply (hs.map ν₁).mul_left_injective
  simp only
  rw [← map_mul, hl, ha, hs', ← map_mul, hl]

variable (ξ : F.obj (op (chart R R' 𝔍)))

/-- The image of `ξ` in `F(Spec L)`. -/
def ζ : F.obj (op (Over.mk d.f)) := F.map (homU d.ℓ d.f d.hf).op ξ

variable (Lv : Level F ρ)

/-- The point `Spec L ⟶ X` given by `ξ`. -/
def mor : Over.mk (Spec.map (CommRingCat.ofHom d.δ)) ⟶ Over.mk Lv.q :=
  (Charts.elemEquiv (levelMap R ρ) Lv.e (Over.mk d.f) _ d.hT).symm (d.ζ ξ)

/-- The point of `X` given by `ξ`. -/
def pt : Lv.X := (d.mor ξ Lv).left (closedPoint (CommRingCat.of L))

/-- The local ring map `𝒪_{X,x} → L`. -/
def ψ : Lv.X.presheaf.stalk (d.pt ξ Lv) ⟶ CommRingCat.of L :=
  Scheme.stalkClosedPointTo (d.mor ξ Lv).left

instance : IsLocalHom (d.ψ ξ Lv).hom :=
  Scheme.isLocalHom_stalkClosedPointTo' _

/-- The structure map `D → 𝒪_{X,x}`. -/
def θ : CommRingCat.of D ⟶ Lv.X.presheaf.stalk (d.pt ξ Lv) :=
  structMap Lv.q (d.pt ξ Lv)

lemma mor_left : (d.mor ξ Lv).left = Spec.map (d.ψ ξ Lv) ≫ Lv.X.fromSpecStalk (d.pt ξ Lv) :=
  (Scheme.Spec_stalkClosedPointTo_fromSpecStalk _).symm

lemma θ_ψ : d.θ ξ Lv ≫ d.ψ ξ Lv = CommRingCat.ofHom d.δ := by
  apply structMap_comp_eq
  rw [← Category.assoc, ← mor_left]
  exact Over.w (d.mor ξ Lv)

lemma δ_eq : d.δ = (d.ψ ξ Lv).hom.comp (d.θ ξ Lv).hom :=
  (congrArg CommRingCat.Hom.hom (d.θ_ψ ξ Lv)).symm

lemma ψ_θ_apply (b : D) : (d.ψ ξ Lv).hom ((d.θ ξ Lv).hom b) = d.δ b := by
  rw [d.δ_eq ξ Lv]
  rfl

lemma ψ_surjective : Function.Surjective (d.ψ ξ Lv).hom := by
  intro l
  obtain ⟨a, s, hs, hl⟩ := d.gen l
  have hu : IsUnit ((d.θ ξ Lv).hom s) := by
    rw [← d.ψ_θ_apply ξ Lv] at hs
    exact isUnit_of_map_unit _ _ hs
  refine ⟨(d.θ ξ Lv).hom a * ↑hu.unit⁻¹, ?_⟩
  have h1 : (d.ψ ξ Lv).hom ((d.θ ξ Lv).hom s * ↑hu.unit⁻¹) = 1 := by
    rw [IsUnit.mul_val_inv, map_one]
  calc (d.ψ ξ Lv).hom ((d.θ ξ Lv).hom a * ↑hu.unit⁻¹)
      = d.δ a * (d.ψ ξ Lv).hom ↑hu.unit⁻¹ := by rw [map_mul, d.ψ_θ_apply]
    _ = l * (d.ψ ξ Lv).hom ((d.θ ξ Lv).hom s * ↑hu.unit⁻¹) := by
        rw [← hl, map_mul, d.ψ_θ_apply, mul_assoc]
    _ = l := by rw [h1, mul_one]

lemma ker_ψ_le_maximalIdeal :
    RingHom.ker (d.ψ ξ Lv).hom ≤ maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) := by
  intro a ha hu
  have := hu.map (d.ψ ξ Lv).hom
  rw [RingHom.mem_ker.1 ha] at this
  exact not_isUnit_zero this

/-- Restricting the image of `ξ` in `F(Spec L)` along a morphism to `Spec L`. -/
lemma map_ζ {T : Over (Spec R)} (k : T ⟶ Over.mk d.f) (t : T.left ⟶ Spec (CommRingCat.of D))
    (ht : t ≫ levelMap R ρ = T.hom) (hk : k.left ≫ Spec.map (CommRingCat.ofHom d.δ) = t) :
    F.map k.op (d.ζ ξ) = Charts.elemEquiv (levelMap R ρ) Lv.e T t ht
      ((Over.homMk k.left hk : Over.mk t ⟶ Over.mk (Spec.map (CommRingCat.ofHom d.δ))) ≫
        d.mor ξ Lv) := by
  have : d.ζ ξ = Charts.elemEquiv (levelMap R ρ) Lv.e (Over.mk d.f) _ d.hT (d.mor ξ Lv) :=
    (Equiv.apply_symm_apply _ _).symm
  rw [this, elemEquiv_naturality' (levelMap R ρ) Lv.e k t _ ht d.hT hk]

/-- A local ring map `χ : 𝒪_{X,x} → A` to a local artinian ring gives a lifting problem for `ξ`
at `w`. If `ξ` satisfies the lifting condition for `χ ∘ θ ∘ ρ`, then `χ ∘ θ ∘ ρ` kills `𝔍` and
`χ` factors through `ψ`. -/
theorem stalk_kill (hF5 : NilpotentInjective F) {A : Type u} [CommRing A] [IsLocalRing A]
    [IsArtinianRing A] (χ : Lv.X.presheaf.stalk (d.pt ξ Lv) ⟶ CommRingCat.of A)
    [IsLocalHom χ.hom] (hK : KillAt ξ w A ((d.θ ξ Lv ≫ χ).hom.comp ρ)) :
    (∀ j ∈ 𝔍, χ.hom ((d.θ ξ Lv).hom (ρ j)) = 0) ∧
      ∃ μ : L →+* A, IsLocalHom μ ∧ μ.comp (d.ψ ξ Lv).hom = χ.hom := by
  have hJ : IsNilpotent (maximalIdeal A) :=
    (isArtinianRing_iff_isNilpotent_maximalIdeal A).1 inferInstance
  have : Nontrivial (A ⧸ maximalIdeal A) :=
    Ideal.Quotient.nontrivial_iff.2 (maximalIdeal.isMaximal A).ne_top
  have : IsLocalRing (A ⧸ maximalIdeal A) := Charts.isLocalRing_quotient hJ
  have hmkloc : IsLocalHom (Ideal.Quotient.mk (maximalIdeal A)) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hJmax : (maximalIdeal (A ⧸ maximalIdeal A)).comap (Ideal.Quotient.mk (maximalIdeal A)) =
      maximalIdeal A :=
    congrArg PrimeSpectrum.asIdeal
      (IsLocalRing.comap_closedPoint (Ideal.Quotient.mk (maximalIdeal A)))
  obtain ⟨β, hβ⟩ : ∃ β, β = (d.θ ξ Lv ≫ χ).hom.comp ρ := ⟨_, rfl⟩
  rw [← hβ] at hK
  have hker : RingHom.ker (d.ψ ξ Lv).hom ≤
      RingHom.ker ((Ideal.Quotient.mk (maximalIdeal A)).comp χ.hom) := by
    intro a ha
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact map_nonunit χ.hom a (d.ker_ψ_le_maximalIdeal ξ Lv ha)
  obtain ⟨μ₀, hμ₀def⟩ : ∃ μ₀ : L →+* A ⧸ maximalIdeal A,
      μ₀ = (d.ψ ξ Lv).hom.liftOfSurjective (d.ψ_surjective ξ Lv) ⟨_, hker⟩ := ⟨_, rfl⟩
  have hμ₀ : μ₀.comp (d.ψ ξ Lv).hom = (Ideal.Quotient.mk (maximalIdeal A)).comp χ.hom := by
    rw [hμ₀def]
    exact RingHom.liftOfSurjective_comp _ _ _
  have hμ₀loc : IsLocalHom μ₀ := by
    constructor
    intro l hl
    obtain ⟨a, rfl⟩ := d.ψ_surjective ξ Lv l
    have h1 : IsUnit ((Ideal.Quotient.mk (maximalIdeal A)) (χ.hom a)) := by
      rw [← RingHom.comp_apply, ← hμ₀]
      exact hl
    exact (isUnit_of_map_unit χ.hom a (isUnit_of_map_unit _ _ h1)).map _
  have hμ₀max : (maximalIdeal (A ⧸ maximalIdeal A)).comap μ₀ = maximalIdeal L :=
    congrArg PrimeSpectrum.asIdeal (IsLocalRing.comap_closedPoint μ₀)
  have key : (μ₀.comp d.ℓ).comp (Ideal.Quotient.mk 𝔍) =
      (Ideal.Quotient.mk (maximalIdeal A)).comp β := by
    rw [RingHom.comp_assoc, d.comm, d.δ_eq ξ Lv, hβ]
    ext a
    exact RingHom.congr_fun hμ₀ ((d.θ ξ Lv).hom (ρ a))
  obtain ⟨f, hfdef⟩ : ∃ f : Spec (CommRingCat.of A) ⟶ Spec R,
      f = Spec.map (CommRingCat.ofHom (β.comp (algebraMap R R'))) := ⟨_, rfl⟩
  have hf' : Spec.map (CommRingCat.ofHom (((μ₀.comp d.ℓ).comp (Ideal.Quotient.mk 𝔍)).comp
      (algebraMap R R'))) =
      Spec.map (CommRingCat.ofHom (algebraMap A (A ⧸ maximalIdeal A))) ≫ f := by
    rw [hfdef, specMap_ofHom_comp, key, Ideal.Quotient.algebraMap_eq]
  have hk : Spec.map (CommRingCat.ofHom μ₀) ≫ d.f =
      (algebraOver f (A ⧸ maximalIdeal A)).hom := by
    rw [← d.hf, specMap_ofHom_comp]
    exact hf'
  let k : algebraOver f (A ⧸ maximalIdeal A) ⟶ Over.mk d.f :=
    Over.homMk (Spec.map (CommRingCat.ofHom μ₀)) hk
  have ht : Spec.map (d.θ ξ Lv ≫ χ) ≫ levelMap R ρ = (Over.mk f).hom := by
    rw [hfdef, levelMap, ← Spec.map_comp, hβ]
    rfl
  have hw : (Spec.map χ ≫ Lv.X.fromSpecStalk (d.pt ξ Lv)) ≫ Lv.q =
      Spec.map (d.θ ξ Lv ≫ χ) := by
    rw [Category.assoc, θ, ← specMap_structMap, ← Spec.map_comp]
  let a₂ : Over.mk (Spec.map (d.θ ξ Lv ≫ χ)) ⟶ Over.mk Lv.q := Over.homMk _ hw
  obtain ⟨v, hvdef⟩ : ∃ v, v = Charts.elemEquiv (levelMap R ρ) Lv.e (Over.mk f) _ ht a₂ :=
    ⟨_, rfl⟩
  have ht₁ : (Spec.map (CommRingCat.ofHom μ₀) ≫ Spec.map (CommRingCat.ofHom d.δ)) ≫
      levelMap R ρ = (algebraOver f (A ⧸ maximalIdeal A)).hom := by
    rw [Category.assoc, d.hT]
    exact hk
  have ht₂ : ((algebraOverBase f (A ⧸ maximalIdeal A)).left ≫ Spec.map (d.θ ξ Lv ≫ χ)) ≫
      levelMap R ρ = (algebraOver f (A ⧸ maximalIdeal A)).hom := by
    rw [Category.assoc, ht]
    rfl
  have hv : F.map (homU (μ₀.comp d.ℓ) _ hf').op ξ =
      F.map (algebraOverBase f (A ⧸ maximalIdeal A)).op v := by
    have hu₀ : homU (μ₀.comp d.ℓ) _ hf' = k ≫ homU d.ℓ d.f d.hf := by
      ext1
      simp only [k, Over.comp_left, Over.homMk_left, homU_left]
      rw [specMap_ofHom_comp]
    rw [hu₀, op_comp, Functor.map_comp_apply]
    change F.map k.op (d.ζ ξ) = _
    rw [d.map_ζ ξ Lv k _ ht₁ rfl, hvdef,
      elemEquiv_naturality' (levelMap R ρ) Lv.e (algebraOverBase f (A ⧸ maximalIdeal A)) _ _
        ht₂ ht rfl a₂]
    apply elemEquiv_congr
    change Spec.map (CommRingCat.ofHom μ₀) ≫ (d.mor ξ Lv).left =
      Spec.map (CommRingCat.ofHom (algebraMap A (A ⧸ maximalIdeal A))) ≫ Spec.map χ ≫
        Lv.X.fromSpecStalk (d.pt ξ Lv)
    rw [mor_left, ← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
    congr 2
    ext x
    exact RingHom.congr_fun hμ₀ x
  have hc : (homU (μ₀.comp d.ℓ) _ hf').left ≫
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔍)) =
      Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (maximalIdeal A)).comp β)) := by
    rw [homU_left, specMap_ofHom_comp, key]
  have hpt : ∀ x, (homU (μ₀.comp d.ℓ) _ hf').left x = w := by
    intro x
    rw [Charts.eq_of_isArtinianRing x (closedPoint _)]
    apply PrimeSpectrum.ext
    change (maximalIdeal (A ⧸ maximalIdeal A)).comap (μ₀.comp d.ℓ) = w.asIdeal
    rw [← Ideal.comap_comap, hμ₀max, d.comap_eq]
  have hkill := hK f hfdef.symm (maximalIdeal A) hJ _ hc hpt v hv
  refine ⟨fun j hj => by rw [← hkill j hj, hβ]; rfl, ?_⟩
  obtain ⟨γ, hγdef⟩ : ∃ γ, γ = Ideal.Quotient.lift 𝔍 β hkill := ⟨_, rfl⟩
  have hγ : γ.comp (Ideal.Quotient.mk 𝔍) = β := by
    rw [hγdef]
    exact Ideal.Quotient.lift_comp_mk _ _ _
  have hγ' : (Ideal.Quotient.mk (maximalIdeal A)).comp γ = μ₀.comp d.ℓ := by
    apply Ideal.Quotient.ringHom_ext
    rw [RingHom.comp_assoc, hγ, key]
  have hcomap : (maximalIdeal A).comap γ = w.asIdeal := by
    rw [← hJmax, Ideal.comap_comap, hγ', ← Ideal.comap_comap, hμ₀max, d.comap_eq]
  obtain ⟨μ, hμloc, hμℓ, hμδ⟩ := d.univ A γ (d.θ ξ Lv ≫ χ).hom (hγ.trans hβ) hcomap
  have hk' : Spec.map (CommRingCat.ofHom μ) ≫ d.f = (Over.mk f).hom := by
    rw [← d.hf, specMap_ofHom_comp]
    show _ = f
    rw [hfdef, ← hγ, ← hμℓ]
  let k' : Over.mk f ⟶ Over.mk d.f := Over.homMk (Spec.map (CommRingCat.ofHom μ)) hk'
  have ht' : (Spec.map (CommRingCat.ofHom μ) ≫ Spec.map (CommRingCat.ofHom d.δ)) ≫
      levelMap R ρ = (Over.mk f).hom := by
    rw [Category.assoc, d.hT]
    exact hk'
  have e3 := d.map_ζ ξ Lv k' _ ht' rfl
  have hcomp : algebraOverBase f (A ⧸ maximalIdeal A) ≫ k' ≫ homU d.ℓ d.f d.hf =
      homU (μ₀.comp d.ℓ) _ hf' := by
    ext1
    simp only [k', algebraOverBase, Over.comp_left, Over.homMk_left, homU_left]
    rw [specMap_ofHom_comp, specMap_ofHom_comp, hμℓ, Ideal.Quotient.algebraMap_eq, hγ']
  have e4 : F.map k'.op (d.ζ ξ) = v := by
    apply hF5 A (maximalIdeal A) hJ f
    rw [← hv, ← hcomp, op_comp, op_comp, Functor.map_comp_apply,
      Functor.map_comp_apply]
    rfl
  have htt : Spec.map (CommRingCat.ofHom μ) ≫ Spec.map (CommRingCat.ofHom d.δ) =
      Spec.map (d.θ ξ Lv ≫ χ) := by
    rw [specMap_ofHom_comp, hμδ]
    rfl
  have hleft := left_eq_of_elemEquiv_eq (levelMap R ρ) Lv.e ht' ht htt _ _
    (e3.symm.trans (e4.trans hvdef))
  simp only [k', a₂, Over.comp_left, Over.homMk_left] at hleft
  have hloc : IsLocalHom (d.ψ ξ Lv ≫ CommRingCat.ofHom μ).hom := by
    show IsLocalHom (μ.comp (d.ψ ξ Lv).hom)
    infer_instance
  have := specMap_fromSpecStalk_injective (d.ψ ξ Lv ≫ CommRingCat.ofHom μ) χ (by
    rw [Spec.map_comp, Category.assoc, ← mor_left]
    exact hleft)
  exact ⟨μ, hμloc, congrArg CommRingCat.Hom.hom this⟩

end LocalDatum

lemma exists_stalkHom {X : Scheme.{u}} (q : X ⟶ Spec (CommRingCat.of D)) {C : Type u}
    [CommRing C] [IsLocalRing C] (h : Spec (CommRingCat.of C) ⟶ X) (δ' : D →+* C)
    (hq : h ≫ q = Spec.map (CommRingCat.ofHom δ')) (x : X)
    (hx : h (closedPoint (CommRingCat.of C)) = x) :
    ∃ χ : X.presheaf.stalk x ⟶ CommRingCat.of C, IsLocalHom χ.hom ∧
      Spec.map χ ≫ X.fromSpecStalk x = h ∧ structMap q x ≫ χ = CommRingCat.ofHom δ' := by
  obtain ⟨χ, hχ, hχh⟩ := exists_eq_specMap_fromSpecStalk h x hx
  refine ⟨χ, hχ, hχh, structMap_comp_eq q x χ _ ?_⟩
  rw [← Category.assoc, hχh, hq]

namespace LocalDatum

variable {ρ} {w : Spec (CommRingCat.of (R' ⧸ 𝔍))} {L : Type u} [CommRing L] [IsLocalRing L]
  (d : LocalDatum R 𝔍 ρ w L)
  (ξ : F.obj (op (chart R R' 𝔍))) (Lv : Level F ρ)

/-- If `θ(ρ 𝔍) = 0`, then `ξ` satisfies the lifting condition at `w` for all ring maps
factoring through `ρ`. -/
theorem killAt_of_van (hvan : ∀ j ∈ 𝔍, (d.θ ξ Lv).hom (ρ j) = 0) (A : Type u) [CommRing A]
    [IsLocalRing A] [IsArtinianRing A] (δ' : D →+* A) : KillAt ξ w A (δ'.comp ρ) := by
  intro f hf J hJ u₀ hc hw v hv
  have : IsLocalRing (A ⧸ J) := Charts.isLocalRing_quotient hJ
  have hmkloc : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨γ₀, hγ₀⟩ := exists_specMap_ofHom u₀.left
  have h1 : γ₀.comp (Ideal.Quotient.mk 𝔍) = ((Ideal.Quotient.mk J).comp δ').comp ρ := by
    rw [← specMap_ofHom_inj, ← specMap_ofHom_comp, hγ₀, hc]
  have h2 : (maximalIdeal (A ⧸ J)).comap γ₀ = w.asIdeal := by
    have := hw (closedPoint _)
    rw [← hγ₀] at this
    exact congrArg PrimeSpectrum.asIdeal this
  obtain ⟨μ₀, hμ₀loc, hμ₀ℓ, hμ₀δ⟩ := d.univ (A ⧸ J) γ₀ ((Ideal.Quotient.mk J).comp δ') h1 h2
  have ht : Spec.map (CommRingCat.ofHom δ') ≫ levelMap R ρ = (Over.mk f).hom := by
    rw [levelMap, specMap_ofHom_comp]
    exact hf
  obtain ⟨a, ha⟩ : ∃ a, a = (Charts.elemEquiv (levelMap R ρ) Lv.e (Over.mk f) _ ht).symm v :=
    ⟨_, rfl⟩
  have hva : Charts.elemEquiv (levelMap R ρ) Lv.e (Over.mk f) _ ht a = v := by
    rw [ha, Equiv.apply_symm_apply]
  have hring : (μ₀.comp d.ℓ).comp (Ideal.Quotient.mk 𝔍) =
      (Ideal.Quotient.mk J).comp (δ'.comp ρ) := by
    rw [hμ₀ℓ, h1]
    rfl
  have hk : Spec.map (CommRingCat.ofHom μ₀) ≫ d.f = (algebraOver f (A ⧸ J)).hom := by
    rw [← d.hf, specMap_ofHom_comp]
    show _ = Spec.map (CommRingCat.ofHom (algebraMap A (A ⧸ J))) ≫ f
    rw [← hf, specMap_ofHom_comp, Ideal.Quotient.algebraMap_eq]
    exact congrArg (fun φ => Spec.map (CommRingCat.ofHom (φ.comp (algebraMap R R')))) hring
  let k : algebraOver f (A ⧸ J) ⟶ Over.mk d.f := Over.homMk (Spec.map (CommRingCat.ofHom μ₀)) hk
  have hu₀ : u₀ = k ≫ homU d.ℓ d.f d.hf := by
    ext1
    simp only [k, Over.comp_left, Over.homMk_left, homU_left]
    rw [specMap_ofHom_comp, hμ₀ℓ, hγ₀]
  have ht₁ : (Spec.map (CommRingCat.ofHom μ₀) ≫ Spec.map (CommRingCat.ofHom d.δ)) ≫
      levelMap R ρ = (algebraOver f (A ⧸ J)).hom := by
    rw [Category.assoc, d.hT]
    exact hk
  have e1 := d.map_ζ ξ Lv k _ ht₁ rfl
  have ht₂ : ((algebraOverBase f (A ⧸ J)).left ≫ Spec.map (CommRingCat.ofHom δ')) ≫
      levelMap R ρ = (algebraOver f (A ⧸ J)).hom := by
    rw [Category.assoc, ht]
    rfl
  have e2 := elemEquiv_naturality' (levelMap R ρ) Lv.e (algebraOverBase f (A ⧸ J)) _ _ ht₂ ht
    rfl a
  rw [hva] at e2
  have htt : Spec.map (CommRingCat.ofHom μ₀) ≫ Spec.map (CommRingCat.ofHom d.δ) =
      (algebraOverBase f (A ⧸ J)).left ≫ Spec.map (CommRingCat.ofHom δ') := by
    simp only [algebraOverBase, Over.homMk_left]
    rw [specMap_ofHom_comp, specMap_ofHom_comp, hμ₀δ, Ideal.Quotient.algebraMap_eq]
  have e3 : F.map k.op (d.ζ ξ) = F.map (algebraOverBase f (A ⧸ J)).op v := by
    rw [← hv, hu₀, op_comp, Functor.map_comp_apply]
    rfl
  have hleft := left_eq_of_elemEquiv_eq (levelMap R ρ) Lv.e ht₁ ht₂ htt _ _
    (e1.symm.trans (e3.trans e2))
  replace hleft : Spec.map (CommRingCat.ofHom μ₀) ≫ (d.mor ξ Lv).left =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ a.left := hleft
  have : IsLocalHom (CommRingCat.ofHom (Ideal.Quotient.mk J)).hom := hmkloc
  have : IsLocalHom (CommRingCat.ofHom μ₀).hom := hμ₀loc
  have hpt : a.left (closedPoint (CommRingCat.of A)) = d.pt ξ Lv := by
    have e : (d.mor ξ Lv).left (Spec.map (CommRingCat.ofHom μ₀) (closedPoint _)) =
        a.left (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) (closedPoint _)) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun g => g (closedPoint (CommRingCat.of (A ⧸ J)))) hleft).trans
          (Scheme.Hom.comp_apply _ _ _))
    have h4 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
        (closedPoint (CommRingCat.of (A ⧸ J))) = closedPoint (CommRingCat.of A) :=
      Spec_closedPoint
    have h5 : Spec.map (CommRingCat.ofHom μ₀) (closedPoint (CommRingCat.of (A ⧸ J))) =
        closedPoint (CommRingCat.of L) := Spec_closedPoint
    exact (congrArg (fun y => a.left y) h4.symm).trans
      (e.symm.trans (congrArg (fun y => (d.mor ξ Lv).left y) h5))
  obtain ⟨χ, -, -, hθχ⟩ := exists_stalkHom Lv.q a.left δ' (Over.w a) _ hpt
  intro j hj
  have : χ.hom ((d.θ ξ Lv).hom (ρ j)) = δ' (ρ j) := congrArg (fun φ => φ.hom (ρ j)) hθχ
  show δ' (ρ j) = 0
  rw [← this, hvan j hj, map_zero]

/-- If `ξ` satisfies the lifting condition at `w` for all ring maps factoring through `ρ`,
then `θ(ρ 𝔍) = 0`. -/
theorem van_of_killAt [IsNoetherianRing D] (hF5 : NilpotentInjective F)
    (H : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsArtinianRing A] (δ' : D →+* A),
      KillAt ξ w A (δ'.comp ρ)) (j : R') (hj : j ∈ 𝔍) : (d.θ ξ Lv).hom (ρ j) = 0 := by
  have : IsLocallyNoetherian Lv.X := LocallyOfFiniteType.isLocallyNoetherian Lv.q
  have hmem : ∀ N : ℕ, (d.θ ξ Lv).hom (ρ j) ∈
      maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) ^ (N + 1) := by
    intro N
    obtain ⟨I, hI⟩ : ∃ I, I = maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) ^ (N + 1) :=
      ⟨_, rfl⟩
    rw [← hI]
    have hItop : I ≠ ⊤ := by
      rw [hI]
      exact ne_top_of_le_ne_top (maximalIdeal.isMaximal _).ne_top
        (Ideal.pow_le_self N.succ_ne_zero)
    have : Nontrivial (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I) :=
      Ideal.Quotient.nontrivial_iff.2 hItop
    have : IsLocalRing (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have hmax : (maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv))).map (Ideal.Quotient.mk I) =
        maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I) := by
      ext x
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      have : IsLocalHom (Ideal.Quotient.mk I) :=
        IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
      simp [sup_eq_left.mpr (le_maximalIdeal hItop)]
    have : IsArtinianRing (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I) := by
      rw [isArtinianRing_iff_isNilpotent_maximalIdeal]
      refine ⟨N + 1, ?_⟩
      rw [← hmax, ← Ideal.map_pow, ← hI, Ideal.zero_eq_bot, Ideal.map_eq_bot_iff_le_ker,
        Ideal.mk_ker]
    let χ : Lv.X.presheaf.stalk (d.pt ξ Lv) ⟶
        CommRingCat.of (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I) :=
      CommRingCat.ofHom (Ideal.Quotient.mk I)
    have : IsLocalHom χ.hom := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have := (d.stalk_kill ξ Lv hF5 χ (H _ _)).1 j hj
    exact Ideal.Quotient.eq_zero_iff_mem.1 this
  have : (d.θ ξ Lv).hom (ρ j) ∈
      (⨅ N : ℕ, maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) ^ N) := by
    rw [Ideal.mem_iInf]
    intro N
    cases N with
    | zero => simp
    | succ N => exact hmem N
  rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal _).ne_top] at this
  exact this

/-- The kernel of `ψ : 𝒪_{X,x} → L` is contained in the ideal generated by `θ(ρ 𝔍)`. -/
theorem ker_ψ_le [IsNoetherianRing D] :
    RingHom.ker (d.ψ ξ Lv).hom ≤ Ideal.map ((d.θ ξ Lv).hom.comp ρ) 𝔍 := by
  have : IsLocallyNoetherian Lv.X := LocallyOfFiniteType.isLocallyNoetherian Lv.q
  obtain ⟨K, hK⟩ : ∃ K, K = RingHom.ker (d.ψ ξ Lv).hom := ⟨_, rfl⟩
  obtain ⟨𝔍Λ, h𝔍Λ⟩ : ∃ 𝔍Λ, 𝔍Λ = Ideal.map ((d.θ ξ Lv).hom.comp ρ) 𝔍 := ⟨_, rfl⟩
  rw [← hK, ← h𝔍Λ]
  have h𝔍K : 𝔍Λ ≤ K := by
    rw [h𝔍Λ, Ideal.map_le_iff_le_comap]
    intro j hj
    rw [Ideal.mem_comap, hK, RingHom.mem_ker, RingHom.comp_apply, d.ψ_θ_apply]
    have := RingHom.congr_fun d.comm j
    simp only [RingHom.comp_apply] at this
    rw [← this, Ideal.Quotient.eq_zero_iff_mem.2 hj, map_zero]
  have hKm : K ≤ maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) :=
    hK ▸ d.ker_ψ_le_maximalIdeal ξ Lv
  obtain ⟨I₀, hI₀⟩ : ∃ I₀, I₀ = 𝔍Λ ⊔ K ^ 2 := ⟨_, rfl⟩
  have hI₀K : I₀ ≤ K := hI₀ ▸ sup_le h𝔍K (Ideal.pow_le_self two_ne_zero)
  have hI₀top : I₀ ≠ ⊤ :=
    ne_top_of_le_ne_top (maximalIdeal.isMaximal _).ne_top (hI₀K.trans hKm)
  have : Nontrivial (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I₀) :=
    Ideal.Quotient.nontrivial_iff.2 hI₀top
  have : IsLocalRing (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I₀) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I₀) Ideal.Quotient.mk_surjective
  have hγ0 : ∀ j ∈ 𝔍, ((Ideal.Quotient.mk I₀).comp ((d.θ ξ Lv).hom.comp ρ)) j = 0 := by
    intro j hj
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hI₀]
    exact Ideal.mem_sup_left (h𝔍Λ ▸ Ideal.mem_map_of_mem _ hj)
  obtain ⟨γ, hγ⟩ : ∃ γ, γ = Ideal.Quotient.lift 𝔍
    ((Ideal.Quotient.mk I₀).comp ((d.θ ξ Lv).hom.comp ρ)) hγ0 := ⟨_, rfl⟩
  have hπ0 : ∀ a ∈ I₀, (d.ψ ξ Lv).hom a = 0 := fun a ha => by
    have := hI₀K ha
    rw [hK] at this
    exact this
  obtain ⟨π', hπ'⟩ : ∃ π', π' = Ideal.Quotient.lift I₀ (d.ψ ξ Lv).hom hπ0 := ⟨_, rfl⟩
  have hπsurj : Function.Surjective π' := by
    intro l
    obtain ⟨a, rfl⟩ := d.ψ_surjective ξ Lv l
    exact ⟨Ideal.Quotient.mk I₀ a, by rw [hπ']; rfl⟩
  have hπloc : IsLocalHom π' := IsLocalHom.of_surjective π' hπsurj
  have hπγ : π'.comp γ = d.ℓ := by
    apply Ideal.Quotient.ringHom_ext
    ext r
    rw [hπ', hγ]
    show (d.ψ ξ Lv).hom ((d.θ ξ Lv).hom (ρ r)) = d.ℓ (Ideal.Quotient.mk 𝔍 r)
    rw [d.ψ_θ_apply]
    exact (RingHom.congr_fun d.comm r).symm
  have hcomap : (maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I₀)).comap γ = w.asIdeal := by
    rw [← d.comap_eq, ← hπγ, ← Ideal.comap_comap]
    congr 1
    exact (congrArg PrimeSpectrum.asIdeal (IsLocalRing.comap_closedPoint π')).symm
  obtain ⟨σ, -, -, hσδ⟩ := d.univ _ γ ((Ideal.Quotient.mk I₀).comp (d.θ ξ Lv).hom)
    (by rw [hγ]; exact Ideal.Quotient.lift_comp_mk _ _ _) hcomap
  obtain ⟨K', hK'⟩ : ∃ K', K' = K.map (Ideal.Quotient.mk I₀) := ⟨_, rfl⟩
  have hK'2 : K' ^ 2 = ⊥ := by
    rw [hK', ← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker, hI₀]
    exact le_sup_right
  have hK'nil : IsNilpotent K' := ⟨2, hK'2⟩
  have hker' : RingHom.ker (d.ψ ξ Lv).hom ≤
      RingHom.ker ((Ideal.Quotient.mk K').comp (Ideal.Quotient.mk I₀)) := by
    intro a ha
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hK']
    exact Ideal.mem_map_of_mem _ (hK ▸ ha)
  obtain ⟨κ, hκdef⟩ : ∃ κ : L →+* (Lv.X.presheaf.stalk (d.pt ξ Lv) ⧸ I₀) ⧸ K',
      κ = (d.ψ ξ Lv).hom.liftOfSurjective (d.ψ_surjective ξ Lv) ⟨_, hker'⟩ := ⟨_, rfl⟩
  have hκ : κ.comp (d.ψ ξ Lv).hom = (Ideal.Quotient.mk K').comp (Ideal.Quotient.mk I₀) := by
    rw [hκdef]
    exact RingHom.liftOfSurjective_comp _ _ _
  have hσκ : (Ideal.Quotient.mk K').comp σ = κ := by
    apply d.hom_ext
    rw [RingHom.comp_assoc, hσδ, d.δ_eq ξ Lv, ← RingHom.comp_assoc _ _ κ, hκ, RingHom.comp_assoc]
  have hσψ : σ.comp (d.ψ ξ Lv).hom = Ideal.Quotient.mk I₀ := by
    let := (d.θ ξ Lv).hom.toAlgebra
    have : Algebra.FormallyUnramified (CommRingCat.of D : Type u)
        (Lv.X.presheaf.stalk (d.pt ξ Lv)) :=
      structMap_formallyUnramified Lv.q (d.pt ξ Lv)
    refine lift_unique (R := (CommRingCat.of D : Type u)) K' hK'nil _ _ ?_ ?_
    · show (σ.comp (d.ψ ξ Lv).hom).comp (d.θ ξ Lv).hom =
        (Ideal.Quotient.mk I₀).comp (d.θ ξ Lv).hom
      rw [RingHom.comp_assoc, ← d.δ_eq ξ Lv, hσδ]
    · rw [← RingHom.comp_assoc, hσκ, hκ]
  have hKle : K ≤ 𝔍Λ ⊔ maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) • K := by
    intro k hk
    have h0 : (d.ψ ξ Lv).hom k = 0 := RingHom.mem_ker.1 (hK ▸ hk)
    have h1 : Ideal.Quotient.mk I₀ k = 0 := by
      rw [← hσψ, RingHom.comp_apply, h0, map_zero]
    rw [Ideal.Quotient.eq_zero_iff_mem, hI₀] at h1
    have hsq : K ^ 2 ≤ maximalIdeal (Lv.X.presheaf.stalk (d.pt ξ Lv)) • K := by
      rw [pow_two, Ideal.smul_eq_mul]
      exact Ideal.mul_mono_left hKm
    exact sup_le_sup_left hsq 𝔍Λ h1
  exact Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian K)
    (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge hKle

end LocalDatum

