import Mathlib

/-! # Good points of a relation with an identity section

For two morphisms of schemes `t s : R ⟶ U` and a section `e : U ⟶ R`, a point `x : U` is good
when the maximal ideal of the local ring of `R` at `e x` is generated by the images of the maximal
ideals of the local rings of `U` at `s (e x)` and at `t (e x)`. This is the input of the slicing
step for smooth equivalence relations.
-/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.SmoothRelationGoodPoint

/-- A point `x : U` is good for `t s : R ⟶ U` and `e : U ⟶ R` if the maximal ideal of the stalk
of `R` at `e x` is the sum of the ideals generated by the images, under the stalk maps of `s` and
of `t`, of the maximal ideals of the stalks of `U` at `s (e x)` and at `t (e x)`. -/
def IsGoodPoint {U R : Scheme.{u}} (t s : R ⟶ U) (e : U ⟶ R) (x : U) : Prop :=
  IsLocalRing.maximalIdeal (R.presheaf.stalk (e x)) =
    Ideal.map (s.stalkMap (e x)).hom (IsLocalRing.maximalIdeal (U.presheaf.stalk (s (e x)))) ⊔
      Ideal.map (t.stalkMap (e x)).hom (IsLocalRing.maximalIdeal (U.presheaf.stalk (t (e x))))

end Langlands.AlgebraicGeometry.SmoothRelationGoodPoint
