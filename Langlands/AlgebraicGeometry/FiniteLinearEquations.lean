import Mathlib.RingTheory.FinitePresentation

/-! # Coordinate algebras of finite homogeneous linear systems -/

noncomputable section

universe u v w

open MvPolynomial

namespace Langlands.AlgebraicGeometry.FiniteLinearEquations

set_option backward.isDefEq.respectTransparency false

variable {R : Type u} [CommRing R] {m n : ℕ}
  (a : Fin m → Fin n → R)

/-- The homogeneous linear polynomial associated to one row of the matrix. -/
def polynomial (j : Fin m) : MvPolynomial (Fin n) R :=
  ∑ i, C (a j i) * X i

/-- The ideal generated by the finitely many row equations. -/
def equationsIdeal : Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range (polynomial a))

/-- The actual coordinate algebra, with no noetherian hypothesis on the base. -/
abbrev CoordinateRing := MvPolynomial (Fin n) R ⧸ equationsIdeal a

lemma equationsIdeal_fg : (equationsIdeal a).FG :=
  Submodule.fg_span (Set.finite_range (polynomial a))

instance coordinateRing_finitePresentation :
    Algebra.FinitePresentation R (CoordinateRing a) :=
  Algebra.FinitePresentation.quotient (equationsIdeal_fg a)

/-- Solutions over any commutative algebra of the coefficient ring. -/
def Solutions (S : Type v) [CommRing S] [Algebra R S] :=
  { x : Fin n → S // ∀ j, ∑ i, algebraMap R S (a j i) * x i = 0 }

variable {S : Type v} [CommRing S] [Algebra R S]

/-- Scalar-compatible maps carry solutions to solutions. -/
def mapSolutions {S' : Type w} [CommRing S'] [Algebra R S']
    (f : S →ₐ[R] S') (x : Solutions a S) : Solutions a S' :=
  ⟨fun i ↦ f (x.val i), fun j ↦ by
    calc
      ∑ i, algebraMap R S' (a j i) * f (x.val i) =
          f (∑ i, algebraMap R S (a j i) * x.val i) := by simp
      _ = 0 := by rw [x.property j, map_zero]⟩

private lemma aeval_polynomial (x : Fin n → S) (j : Fin m) :
    aeval x (polynomial a j) = ∑ i, algebraMap R S (a j i) * x i := by
  simp [polynomial]

private lemma equationsIdeal_le_ker (x : Solutions a S) :
    equationsIdeal a ≤ RingHom.ker (aeval x.val).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨j, rfl⟩
  exact (aeval_polynomial a x.val j).trans (x.property j)

/-- A solution gives the unique evaluation map out of the coordinate algebra. -/
def evaluation (x : Solutions a S) : CoordinateRing a →ₐ[R] S :=
  Ideal.Quotient.liftₐ (equationsIdeal a) (aeval x.val)
    (fun _ hp ↦ equationsIdeal_le_ker a x hp)

/-- Algebra maps out of the quotient are exactly the solutions of the system. -/
def pointsEquiv : (CoordinateRing a →ₐ[R] S) ≃ Solutions a S where
  toFun f := ⟨fun i ↦ f (Ideal.Quotient.mk _ (X i)), fun j ↦ by
    have h : Ideal.Quotient.mk (equationsIdeal a) (polynomial a j) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    have hf : (f.comp (Ideal.Quotient.mkₐ R (equationsIdeal a))) (polynomial a j) = 0 :=
      (congrArg f h).trans (map_zero f)
    simpa only [polynomial, map_sum, map_mul, algHom_C, AlgHom.comp_apply,
      Ideal.Quotient.mkₐ_eq_mk, AlgHom.commutes] using hf⟩
  invFun := evaluation a
  left_inv f := by
    apply Ideal.Quotient.algHom_ext
    ext i
    change aeval (fun i ↦ f (Ideal.Quotient.mk _ (X i))) (X i) = _
    exact aeval_X _ _
  right_inv x := by
    apply Subtype.ext
    funext i
    change aeval x.val (X i) = _
    exact aeval_X _ _

/-- The quotient-point correspondence retains the actual coordinates. -/
@[simp]
lemma pointsEquiv_apply (f : CoordinateRing a →ₐ[R] S) (i : Fin n) :
    (pointsEquiv a f).val i = f (Ideal.Quotient.mk _ (X i)) := rfl

/-- The correspondence commutes with every scalar-compatible map of test algebras. -/
lemma pointsEquiv_naturality {S' : Type w} [CommRing S'] [Algebra R S']
    (g : S →ₐ[R] S') (f : CoordinateRing a →ₐ[R] S) :
    pointsEquiv a (g.comp f) = mapSolutions a g (pointsEquiv a f) := rfl

end Langlands.AlgebraicGeometry.FiniteLinearEquations
