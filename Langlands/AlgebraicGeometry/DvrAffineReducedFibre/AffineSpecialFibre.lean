import Langlands.AlgebraicGeometry.DvrAffineReducedFibre.PrincipalFibre
import Mathlib.AlgebraicGeometry.Fiber
import Mathlib.AlgebraicGeometry.Properties
import Mathlib.RingTheory.TensorProduct.Quotient

/-! # The closed fibre of an affine morphism over a local ring -/

open AlgebraicGeometry CategoryTheory IsLocalRing TensorProduct

noncomputable section

universe u

namespace Langlands.AlgebraicGeometry.DvrAffineReducedFibre

variable (S B : Type u) [CommRing S] [IsLocalRing S] [CommRing B] [Algebra S B]

/-- The closed fibre of `Spec B → Spec S`, when the maximal ideal of `S` is
generated by `a`, is the spectrum of the quotient by the image of `a`. -/
def closedFibreQuotientIso (a : S) (ha : maximalIdeal S = Ideal.span {a}) :
    (Spec.algebraMap S B).fiber (closedPoint S) ≅
      Spec (.of (B ⧸ Ideal.span {algebraMap S B a})) := by
  let m := maximalIdeal S
  let e : (S ⧸ m) ≃ₐ[S] m.ResidueField :=
    AlgEquiv.ofBijective (IsScalarTower.toAlgHom S (S ⧸ m) m.ResidueField)
      (m.bijective_algebraMap_quotient_residueField)
  let et := Algebra.TensorProduct.congr e (AlgEquiv.refl (R := S) (A₁ := B))
  let eq : (B ⧸ m.map (algebraMap S B)) ≃+* (B ⧸ Ideal.span {algebraMap S B a}) :=
    Ideal.quotEquivOfEq (by rw [show m = maximalIdeal S from rfl, ha, Ideal.map_span,
      Set.image_singleton])
  let eb : (B ⧸ Ideal.span {algebraMap S B a}) ≃+* m.Fiber B :=
    eq.symm.trans ((Algebra.TensorProduct.quotIdealMapEquivQuotTensor B m).toRingEquiv.trans
      et.toRingEquiv)
  exact Arrow.leftFunc.mapIso (Spec.fiberToSpecResidueFieldIso S B (closedPoint S)) ≪≫
    Scheme.Spec.mapIso eb.toCommRingCatIso.op

private theorem mem_genericPoints_of_homeomorph_symm {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] (e : X ≃ₜ Y) {y : Y} (hy : y ∈ genericPoints Y) :
    e.symm y ∈ genericPoints X := by
  have hpre : e ⁻¹' ({y} : Set Y) = {e.symm y} := by
    ext x
    exact e.eq_symm_apply.symm
  change closure {e.symm y} ∈ irreducibleComponents X
  rw [← hpre, ← e.preimage_closure]
  exact preimage_mem_irreducibleComponents hy e.isOpenEmbedding
    ⟨y, subset_closure (Set.mem_singleton y), e.surjective y⟩

private theorem isReduced_stalk_of_iso {X Y : Scheme.{u}} (e : X ≅ Y) (x : X)
    (h : _root_.IsReduced (Y.presheaf.stalk (e.hom x))) :
    _root_.IsReduced (X.presheaf.stalk x) := by
  have : IsIso (e.hom.stalkMap x) := ((isIso_iff_isIso_stalkMap e.hom).mp e.isIso_hom).2 x
  let elocal := (asIso (e.hom.stalkMap x)).commRingCatIsoToRingEquiv
  exact isReduced_of_injective elocal.symm.toRingHom elocal.symm.injective

/-- The residue algebra is reduced if the total affine scheme has normal domain local
rings, the uniformizer is regular, and the closed fibre is reduced at its generic points. -/
theorem isReduced_residueTensor_of_isReduced_at_genericPoints [IsNoetherianRing B]
    {a : S} (ha : maximalIdeal S = Ideal.span {a})
    (hregular : algebraMap S B a ∈ nonZeroDivisors B)
    (hNormal : ∀ (p : Ideal B) [p.IsPrime],
      IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p))
    (hReduced : ∀ x : (Spec.algebraMap S B).fiber (closedPoint S),
      x ∈ genericPoints ((Spec.algebraMap S B).fiber (closedPoint S)) →
      _root_.IsReduced (((Spec.algebraMap S B).fiber (closedPoint S)).presheaf.stalk x)) :
    _root_.IsReduced (ResidueField S ⊗[S] B) := by
  let I := Ideal.span {algebraMap S B a}
  let e := closedFibreQuotientIso S B a ha
  have hquot : _root_.IsReduced (B ⧸ I) := by
    refine isReduced_principal_quotient_of_isReduced_at_minimalPrimes hregular hNormal ?_
    intro q hq hmin
    let x : PrimeSpectrum (B ⧸ I) := ⟨q, hq⟩
    have hx : x ∈ genericPoints (PrimeSpectrum (B ⧸ I)) := by
      change closure {x} ∈ irreducibleComponents _
      rw [← PrimeSpectrum.vanishingIdeal_mem_minimalPrimes, PrimeSpectrum.vanishingIdeal_singleton]
      exact hmin
    have hx' : e.inv x ∈ genericPoints ((Spec.algebraMap S B).fiber (closedPoint S)) :=
      mem_genericPoints_of_homeomorph_symm (Scheme.homeoOfIso e) hx
    have : _root_.IsReduced ((Spec (.of (B ⧸ I))).presheaf.stalk x) :=
      isReduced_stalk_of_iso e.symm x (hReduced (e.inv x) hx')
    let et := (Spec.stalkIso (.of (B ⧸ I)) x).commRingCatIsoToRingEquiv
    exact isReduced_of_injective et.symm.toRingHom et.symm.injective
  let eq : (B ⧸ (maximalIdeal S).map (algebraMap S B)) ≃+* (B ⧸ I) :=
    Ideal.quotEquivOfEq (by rw [ha, Ideal.map_span, Set.image_singleton])
  let et := (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B (maximalIdeal S)).symm
  exact isReduced_of_injective (eq.toRingHom.comp et.toRingHom) (eq.injective.comp et.injective)

end Langlands.AlgebraicGeometry.DvrAffineReducedFibre
