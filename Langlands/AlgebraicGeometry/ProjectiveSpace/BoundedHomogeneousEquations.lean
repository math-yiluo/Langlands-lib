import Langlands.AlgebraicGeometry.ProjectiveSpace.CoordinateCoverProof
import Langlands.AlgebraicGeometry.ProjectiveSpace.BaseChange
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_ProjSpace_exists_ideal_fg_forall_ker_ideal_basicOpen_eq_span_of_isClosedImmersion
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_ProjSpace_map_preimage_basicOpen_X
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_ProjSpace_restrictFun_app_app_awayToSection_eq_app_awayToSection_map
import Langlands.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_Scheme_IdealSheafData_ideal_comap_of_le
import Mathlib.AlgebraicGeometry.Noetherian

/-! # Equations of bounded degree on polynomial projective space -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Opposite MvPolynomial

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace Langlands.AlgebraicGeometry.ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The standard coordinate chart, as an affine open. -/
abbrev affineCoordinateChart (A : Type u) [CommRing A] (m : ℕ) (i : Fin (m + 1)) :
    (ProjectiveSpace A m).affineOpens :=
  ⟨projectiveSpaceCoordinateOpen A m i, isAffineOpen_projectiveSpaceCoordinateOpen A m i⟩

variable {A : Type u} [CommRing A] {m : ℕ}

/-- The regular function `F / X i ^ d` on the `i`th affine chart, for `F` homogeneous of degree
`d`. -/
def homogeneousChartSection (i : Fin (m + 1)) {d : ℕ}
    {F : MvPolynomial (Fin (m + 1)) A} (hF : F.IsHomogeneous d) :
    Γ(ProjectiveSpace A m, projectiveSpaceCoordinateOpen A m i) :=
  (Proj.awayToSection (homogeneousSubmodule (Fin (m + 1)) A) (X i))
    (HomogeneousLocalization.mk
      { deg := d
        num := ⟨F, (mem_homogeneousSubmodule d F).mpr hF⟩
        den := ⟨X i ^ d, (mem_homogeneousSubmodule d _).mpr (isHomogeneous_X_pow i d)⟩
        den_mem := ⟨d, rfl⟩ })

/-- A homogeneous equation vanishes on a closed subscheme if its fraction belongs to
the defining ideal on every standard chart. -/
def HomogeneousVanishes (I : (ProjectiveSpace A m).IdealSheafData) {d : ℕ}
    {F : MvPolynomial (Fin (m + 1)) A} (hF : F.IsHomogeneous d) : Prop :=
  ∀ i, homogeneousChartSection i hF ∈ I.ideal (affineCoordinateChart A m i)

/-- On each chart the defining ideal is generated by fractions of globally vanishing
homogeneous equations of degree at most `D`. -/
def HasBoundedHomogeneousEquations (I : (ProjectiveSpace A m).IdealSheafData) (D : ℕ) : Prop :=
  ∀ i, I.ideal (affineCoordinateChart A m i) =
    Ideal.span { a | ∃ (d : ℕ) (F : MvPolynomial (Fin (m + 1)) A) (hF : F.IsHomogeneous d),
      d ≤ D ∧ HomogeneousVanishes I hF ∧ a = homogeneousChartSection i hF }

/-- Every closed subscheme over a noetherian affine base admits a degree bound. -/
theorem exists_boundedHomogeneousEquations [IsNoetherianRing A]
    (I : (ProjectiveSpace A m).IdealSheafData) : ∃ D, HasBoundedHomogeneousEquations I D := by
  classical
  have : IsLocallyNoetherian (ProjectiveSpace A m) :=
    LocallyOfFiniteType.isLocallyNoetherian (ProjSpace.π A m)
  have : LocallyOfFinitePresentation (I.subschemeι ≫ ProjSpace.π A m) := inferInstance
  obtain ⟨J, -, -, hJ⟩ :=
    ProjSpace.exists_ideal_fg_forall_ker_ideal_basicOpen_eq_span_of_isClosedImmersion A m
      I.subscheme I.subschemeι
  rw [Scheme.IdealSheafData.ker_subschemeι] at hJ
  let Q (i : Fin (m + 1)) : Set Γ(ProjectiveSpace A m, projectiveSpaceCoordinateOpen A m i) :=
    { a | ∃ (d : ℕ) (F : MvPolynomial (Fin (m + 1)) A) (hF : F.IsHomogeneous d),
      F ∈ J ∧ a = homogeneousChartSection i hF }
  have hQ (i : Fin (m + 1)) : I.ideal (affineCoordinateChart A m i) = Ideal.span (Q i) := hJ i
  have hfg (i : Fin (m + 1)) : (Ideal.span (Q i)).FG := by
    have := IsLocallyNoetherian.component_noetherian (affineCoordinateChart A m i)
    exact IsNoetherian.noetherian _
  choose t ht ht' using fun i => (Submodule.fg_span_iff_fg_span_finset_subset (Q i)).mp (hfg i)
  have hex (i : Fin (m + 1)) (a : ↥(t i)) :
      ∃ (d : ℕ) (F : MvPolynomial (Fin (m + 1)) A) (hF : F.IsHomogeneous d),
        F ∈ J ∧ (a : Γ(ProjectiveSpace A m, projectiveSpaceCoordinateOpen A m i)) =
          homogeneousChartSection i hF := ht i a.property
  choose degree form hform hmem hfrac using hex
  let bound (i : Fin (m + 1)) := (t i).attach.sup (degree i)
  refine ⟨Finset.univ.sup bound, fun i => le_antisymm ?_ ?_⟩
  · have ht'' : Ideal.span (Q i) = Ideal.span (↑(t i)) := ht' i
    rw [hQ i, ht'', Ideal.span_le]
    intro a ha
    let j : ↥(t i) := ⟨a, ha⟩
    apply Ideal.subset_span
    refine ⟨degree i j, form i j, hform i j, ?_, ?_, hfrac i j⟩
    · exact (Finset.le_sup (f := degree i) (Finset.mem_attach _ j)).trans
        (Finset.le_sup (f := bound) (Finset.mem_univ i))
    · intro l
      rw [hQ l]
      exact Ideal.subset_span ⟨degree i j, form i j, hform i j, hmem i j, rfl⟩
  · apply Ideal.span_le.mpr
    rintro a ⟨d, F, hF, hd, hI, rfl⟩
    exact hI i

/-- If two closed subschemes have equations of degree at most `D`, equal vanishing conditions
in these degrees identify their ideal sheaves. -/
theorem HasBoundedHomogeneousEquations.eq_of_vanishing_iff
    {I J : (ProjectiveSpace A m).IdealSheafData} {D : ℕ}
    (hI : HasBoundedHomogeneousEquations I D) (hJ : HasBoundedHomogeneousEquations J D)
    (h : ∀ (d : ℕ) (F : MvPolynomial (Fin (m + 1)) A) (hF : F.IsHomogeneous d), d ≤ D →
      (HomogeneousVanishes I hF ↔ HomogeneousVanishes J hF)) : I = J := by
  apply Scheme.IdealSheafData.ext_of_iSup_eq_top (affineCoordinateChart A m)
    (iSup_projectiveSpaceCoordinateOpen A m)
  intro i
  rw [hI i, hJ i]
  congr 1
  ext a
  constructor
  · rintro ⟨d, F, hF, hd, hf, rfl⟩
    exact ⟨d, F, hF, hd, (h d F hF hd).mp hf, rfl⟩
  · rintro ⟨d, F, hF, hd, hf, rfl⟩
    exact ⟨d, F, hF, hd, (h d F hF hd).mpr hf, rfl⟩

/-- Membership in the actual kernel ideal is the vanishing of the pulled-back fraction. -/
lemma homogeneousVanishes_ker_iff {Y : Scheme.{u}} (i : Y ⟶ ProjectiveSpace A m)
    [QuasiCompact i] {d : ℕ} {F : MvPolynomial (Fin (m + 1)) A} (hF : F.IsHomogeneous d) :
    HomogeneousVanishes i.ker hF ↔ ∀ j, i.app (projectiveSpaceCoordinateOpen A m j)
      (homogeneousChartSection j hF) = 0 := by
  simp only [HomogeneousVanishes, Scheme.Hom.ker_apply, RingHom.mem_ker]

/-- A larger cutoff still supplies all defining equations on the charts. -/
theorem HasBoundedHomogeneousEquations.mono {I : (ProjectiveSpace A m).IdealSheafData}
    {D D' : ℕ} (hI : HasBoundedHomogeneousEquations I D) (hDD' : D ≤ D') :
    HasBoundedHomogeneousEquations I D' := by
  intro i
  apply le_antisymm
  · rw [hI i]
    apply Ideal.span_mono
    rintro a ⟨d, F, hF, hd, hf, ha⟩
    exact ⟨d, F, hF, hd.trans hDD', hf, ha⟩
  · apply Ideal.span_le.mpr
    rintro a ⟨d, F, hF, hd, hf, rfl⟩
    exact hf i

section BaseChange

variable (A m) (B : Type u) [CommRing B] [Algebra A B]

private lemma chart_le_preimage (i : Fin (m + 1)) :
    projectiveSpaceCoordinateOpen B m i ≤
      ProjSpace.map A B m ⁻¹ᵁ projectiveSpaceCoordinateOpen A m i :=
  (ProjSpace.map_preimage_basicOpen_X A B m i).ge

private theorem appLE_homogeneousChartSection {d : ℕ} {F : MvPolynomial (Fin (m + 1)) A}
    (hF : F.IsHomogeneous d) (i : Fin (m + 1)) :
    (ProjSpace.map A B m).appLE _ _ (chart_le_preimage A m B i)
      (homogeneousChartSection i hF) = homogeneousChartSection i (hF.map (algebraMap A B)) :=
  ProjSpace.restrictFun_app_app_awayToSection_eq_app_awayToSection_map
    (𝟙 (ProjectiveSpace A m)) B (𝟙 (ProjectiveSpace B m)) (ProjSpace.map A B m)
    (by simp) d F hF i (chart_le_preimage A m B i)

/-- Extending scalars preserves an equation degree bound, with no flatness assumption on
the new base ring. -/
theorem HasBoundedHomogeneousEquations.comap_map
    {I : (ProjectiveSpace A m).IdealSheafData} {D : ℕ}
    (hI : HasBoundedHomogeneousEquations I D) :
    HasBoundedHomogeneousEquations (I.comap (ProjSpace.map A B m)) D := by
  let e := ProjSpace.map A B m
  have hc (i : Fin (m + 1)) : (I.comap e).ideal (affineCoordinateChart B m i) =
      (I.ideal (affineCoordinateChart A m i)).map
        (e.appLE _ _ (chart_le_preimage A m B i)).hom :=
    I.ideal_comap_of_le e (affineCoordinateChart A m i) (affineCoordinateChart B m i)
      (chart_le_preimage A m B i)
  intro i
  apply le_antisymm
  · rw [hc i, hI i, Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨a, ⟨d, F, hF, hd, hf, rfl⟩, rfl⟩
    change e.appLE _ _ (chart_le_preimage A m B i) (homogeneousChartSection i hF) ∈ _
    rw [appLE_homogeneousChartSection]
    apply Ideal.subset_span
    refine ⟨d, MvPolynomial.map (algebraMap A B) F, hF.map _, hd, ?_, rfl⟩
    intro j
    rw [hc j, ← appLE_homogeneousChartSection A m B hF j]
    exact Ideal.mem_map_of_mem _ (hf j)
  · apply Ideal.span_le.mpr
    rintro a ⟨d, F, hF, hd, hf, rfl⟩
    exact hf i

end BaseChange

end Langlands.AlgebraicGeometry.ProjectiveSpace
