import Langlands.AlgebraicGeometry.ProjectiveSpace.CoordinateCoverStatement
import Mathlib.RingTheory.MvPolynomial.Ideal

/-! # Proof of the finite affine coordinate cover of polynomial projective space -/

universe u

namespace Langlands.AlgebraicGeometry

open _root_.AlgebraicGeometry

/-- Each coordinate open `D₊(X i)` is affine, since `X i` is homogeneous of degree one. -/
lemma isAffineOpen_projectiveSpaceCoordinateOpen (R : Type u) [CommRing R] (n : ℕ)
    (i : Fin (n + 1)) :
    IsAffineOpen (projectiveSpaceCoordinateOpen R n i) :=
  Proj.isAffineOpen_basicOpen (projectiveSpaceGrading R n) (MvPolynomial.X i)
    (projectiveSpace_X_mem R n i) Nat.one_pos

/-- The irrelevant ideal of the total-degree grading lies in the ideal generated by the
variables. -/
lemma projectiveSpace_irrelevant_le_span_X (R : Type u) [CommRing R] (n : ℕ) :
    (HomogeneousIdeal.irrelevant (projectiveSpaceGrading R n)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (n + 1) → ProjectiveCoordinateRing R n)) := by
  intro p hp
  rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff] at hp
  have hcomp : GradedRing.proj (projectiveSpaceGrading R n) 0 p =
      MvPolynomial.homogeneousComponent 0 p :=
    MvPolynomial.decomposition.decompose'_apply p 0
  rw [hcomp, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hp
  have hmem := (MvPolynomial.mem_pow_idealOfVars_iff' 1 p).mpr fun x hx => by
    have hx0 : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (by omega)
    subst hx0
    exact hp
  simpa using hmem

/-- The `n + 1` coordinate opens cover projective space. -/
lemma iSup_projectiveSpaceCoordinateOpen (R : Type u) [CommRing R] (n : ℕ) :
    (⨆ i : Fin (n + 1), projectiveSpaceCoordinateOpen R n i) = ⊤ :=
  Proj.iSup_basicOpen_eq_top (projectiveSpaceGrading R n) _
    (projectiveSpace_irrelevant_le_span_X R n)

/-- The coordinate opens of `ProjectiveSpace R n` are affine and cover it, and the
underlying space is compact. -/
theorem projectiveSpaceCoordinateCover : ProjectiveSpaceCoordinateCoverStatement.{u} := by
  intro R _ n
  refine ⟨isAffineOpen_projectiveSpaceCoordinateOpen R n,
    iSup_projectiveSpaceCoordinateOpen R n, ?_⟩
  rw [← isCompact_univ_iff]
  have h := congrArg (fun U : (ProjectiveSpace R n).Opens => (U : Set (ProjectiveSpace R n)))
    (iSup_projectiveSpaceCoordinateOpen R n)
  simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top] at h
  rw [← h]
  exact isCompact_iUnion fun i => (isAffineOpen_projectiveSpaceCoordinateOpen R n i).isCompact

end Langlands.AlgebraicGeometry
