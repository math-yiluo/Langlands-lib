import Langlands.BushnellKutzko.GLSimpleTypes

/-! # The subgroup generated by a simple type subgroup and its parameter field -/

noncomputable section

namespace Langlands.BushnellKutzko.GLSimpleTypeData

universe uF uρ

variable {F : Type uF} [Field F] [TopologicalSpace F] [ValuativeRel F]
  [IsNonarchimedeanLocalField F] {n : ℕ} {ψF : AddChar F ℂ}
  {J : Subgroup (GeneralLinear n F)} {ρ : SmoothRep.{0, uF, uρ} ℂ J}

/-- The homomorphism from `Eˣ` to the matrix group, using the action of the parameter field
and the inverse of the standard `toLin` identification. -/
def fieldUnitsHom (d : GLSimpleTypeData ψF ρ) : d.parameterFieldˣ →* GeneralLinear n F :=
  (Matrix.GeneralLinearGroup.toLin.symm :
    (Module.End F (Fin n → F))ˣ ≃* GeneralLinear n F).toMonoidHom.comp
      (Units.map d.fieldEmbedding.toMonoidHom)

/-- The subgroup `Eˣ J` of BK93 §6.1, defined as the join of `J` and the image of `Eˣ`. -/
def extensionSubgroup (d : GLSimpleTypeData ψF ρ) : Subgroup (GeneralLinear n F) :=
  J ⊔ d.fieldUnitsHom.range

/-- The type subgroup lies in `Eˣ J`. -/
theorem le_extensionSubgroup (d : GLSimpleTypeData ψF ρ) : J ≤ d.extensionSubgroup :=
  le_sup_left

/-- `Eˣ J` is open because it contains the open subgroup `J`. -/
theorem isOpen_extensionSubgroup (d : GLSimpleTypeData ψF ρ) :
    IsOpen (d.extensionSubgroup : Set (GeneralLinear n F)) :=
  Subgroup.isOpen_mono d.le_extensionSubgroup d.isOpen

end Langlands.BushnellKutzko.GLSimpleTypeData
