import Langlands.BushnellKutzko.SimpleCharacterJNormalizer
import Langlands.BushnellKutzko.SimpleCharacterPairingGroup
import Langlands.BushnellKutzko.SimpleCharacterBlockTriviality
import Langlands.BushnellKutzko.CentralizerDoubleCoset

/-! # The depth-one H group enlarged in the lower corner -/

noncomputable section

open ValuativeRel
open scoped Pointwise commutatorElement

namespace Langlands.BushnellKutzko.SplitBlocks

universe uF uV

private theorem exists_character_on_sup_of_trivial {G : Type*} [Group G]
    {H D : Subgroup G} (θ : H →* ℂˣ)
    (hD : D ≤ characterNormalizerSubgroup θ)
    (hker : ∀ h : H, (h : G) ∈ D → θ h = 1) :
    ∃ η : (D ⊔ H : Subgroup G) →* ℂˣ, ∀ (d : D) (h : H)
      (hk : (d : G) * (h : G) ∈ D ⊔ H), η ⟨_, hk⟩ = θ h := by
  classical
  let K : Subgroup G := D ⊔ H
  have hDH : ((D ⊔ H : Subgroup G) : Set G) = (D : Set G) * (H : Set G) :=
    Subgroup.coe_mul_of_left_le_normalizer_right D H (fun _ hd => (hD hd).1)
  have hfac (k : K) : ∃ d : D, ∃ h : H, (d : G) * (h : G) = (k : G) := by
    have hm : (k : G) ∈ ((D ⊔ H : Subgroup G) : Set G) := k.2
    rw [hDH] at hm
    obtain ⟨d, hd, h, hh, hk⟩ := Set.mem_mul.mp hm
    exact ⟨⟨d, hd⟩, ⟨h, hh⟩, hk⟩
  choose d h heq using hfac
  have hvalue (k : K) (d' : D) (h' : H) (hk : (d' : G) * (h' : G) = (k : G)) :
      θ (h k) = θ h' := by
    have hrel : ((h k : H) : G) * (h' : G)⁻¹ = ((d k : D) : G)⁻¹ * (d' : G) := by
      calc
        _ = ((d k : D) : G)⁻¹ * ((d k : G) * (h k : G)) * (h' : G)⁻¹ := by group
        _ = _ := by rw [heq, ← hk]; group
    have hv := hker (h k * h'⁻¹) (by
      change (h k : G) * (h' : G)⁻¹ ∈ D
      rw [hrel]
      exact D.mul_mem (D.inv_mem (d k).2) d'.2)
    rw [map_mul, map_inv, ← div_eq_mul_inv] at hv
    exact div_eq_one.mp hv
  let η : K →* ℂˣ :=
    { toFun := fun k => θ (h k)
      map_one' := (hvalue 1 1 1 (one_mul 1)).trans (map_one θ)
      map_mul' := fun k l => by
        let u := (d l : G)⁻¹ * (h k : G) * (d l : G)
        have hu : u ∈ H := by
          simpa only [u, inv_inv] using
            (Subgroup.mem_normalizer_iff.mp (hD (D.inv_mem (d l).2)).1 _).mp (h k).2
        let h' : H := ⟨u, hu⟩
        have hθ : θ h' = θ (h k) := by
          have hu' : (d l : G)⁻¹ * (h k : G) * ((d l : G)⁻¹)⁻¹ ∈ H := by
            simpa only [inv_inv] using hu
          simpa only [inv_inv, u, h'] using (hD (D.inv_mem (d l).2)).2 (h k) hu'
        have hk : ((d k * d l : D) : G) * ((h' * h l : H) : G) = ((k * l : K) : G) := by
          change ((d k : G) * (d l : G)) *
            (((d l : G)⁻¹ * (h k : G) * (d l : G)) * (h l : G)) = (k : G) * (l : G)
          rw [← heq k, ← heq l]
          group
        rw [hvalue (k * l) (d k * d l) (h' * h l) hk, map_mul, hθ] }
  exact ⟨η, fun d' h' hk => hvalue ⟨_, hk⟩ d' h' rfl⟩

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F] {V : Type uV} [AddCommGroup V] [Module F V]

local notation "A" => Module.End F V
local notation "G" => (Module.End F V)ˣ
local notation "H[" S "," q "]" => simpleHGroup (Stratum.chain S) (Stratum.n S) (Stratum.b S)
  (Stratum.DefiningSequenceChoice.tail q)
local notation "Hₗ[" S "," q "]" => simpleHLayer (Stratum.chain S) (Stratum.n S) (Stratum.b S)
  (Stratum.DefiningSequenceChoice.tail q)
local notation "J[" S "," q "]" => simpleJGroup (Stratum.chain S) (Stratum.n S) (Stratum.b S)
  (Stratum.DefiningSequenceChoice.tail q)
local notation "Jₗ[" S "," q "]" => simpleJLayer (Stratum.chain S) (Stratum.n S) (Stratum.b S)
  (Stratum.DefiningSequenceChoice.tail q)

/-- The lower unipotent subgroup of `J^1`, generated by the lower entries in its lattice. -/
def simpleLowerJGroup (S : Stratum 𝒪[F] F V) (q : S.DefiningSequenceChoice)
    {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0) : Subgroup G :=
  blockUnipotent e₂ e₁ h₁₂ (Jₗ[S,q] 1).toAddSubgroup

/-- The subgroup generated by `H^1` and the lower unipotent part of `J^1`. -/
def simpleLowerHGroup (S : Stratum 𝒪[F] F V) (q : S.DefiningSequenceChoice)
    {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0) : Subgroup G :=
  simpleLowerJGroup S q h₁₂ ⊔ H[S,q] 1

section

variable (S : Stratum 𝒪[F] F V) (h0 : S.r = 0) (hs : S.IsSimple) (q : S.DefiningSequenceChoice)

include h0 hs

theorem simpleLowerJGroup_le_simpleJGroup {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0) :
    simpleLowerJGroup S q h₁₂ ≤ J[S,q] 1 := by
  intro k hk
  change e₂ * ((k : A) - 1) * e₁ = (k : A) - 1 ∧
    (k : A) - 1 ∈ Jₗ[S,q] 1 at hk
  exact (simpleJGroup_mem_iff_of_pos S h0 hs q (m := 1) le_rfl).mpr hk.2

theorem simpleLowerHGroup_le_simpleJGroup {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0) :
    simpleLowerHGroup S q h₁₂ ≤ J[S,q] 1 := by
  have hG := simpleStratumGroupProperties F V S h0 hs q
  change simpleLowerJGroup S q h₁₂ ⊔ H[S,q] 1 ≤ J[S,q] 1
  exact sup_le (simpleLowerJGroup_le_simpleJGroup S h0 hs q h₁₂) (hG.2.2.2.1 1).1

/-- An element of the enlarged group belongs to `H^1` if its lower corner does. -/
theorem mem_simpleHGroup_iff_lowerCorner_of_mem_simpleLowerHGroup
    {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0)
    (he₁ : e₁ ∈ centralizerLattice S.chain S.b 0) (he₂ : e₂ ∈ centralizerLattice S.chain S.b 0)
    {k : G} (hk : k ∈ simpleLowerHGroup S q h₁₂) :
    k ∈ H[S,q] 1 ↔ e₂ * ((k : A) - 1) * e₁ ∈ Hₗ[S,q] 1 := by
  have hG := simpleStratumGroupProperties F V S h0 hs q
  have hnorm : simpleLowerJGroup S q h₁₂ ≤ Subgroup.normalizer (H[S,q] 1 : Set G) :=
    (simpleLowerJGroup_le_simpleJGroup S h0 hs q h₁₂).trans
      ((simpleJGroup_antitone _ _ _ _ (Nat.zero_le 1)).trans (hG.2.2.2.1 0).2.2)
  have hprod := Subgroup.coe_mul_of_left_le_normalizer_right (simpleLowerJGroup S q h₁₂) (H[S,q] 1) hnorm
  have hkset : k ∈ ((simpleLowerJGroup S q h₁₂ ⊔ H[S,q] 1 : Subgroup G) : Set G) := hk
  rw [hprod] at hkset
  obtain ⟨d, hd, h, hh, rfl⟩ := Set.mem_mul.mp hkset
  let x := (d : A) - 1
  let y := (h : A) - 1
  have hproj {a : A} (ha : a ∈ Hₗ[S,q] 1) : e₂ * a * e₁ ∈ Hₗ[S,q] 1 :=
    (mul_mem_simpleHLayer_of_mem_centralizer S h0 hs q 1 he₁
      (mul_mem_simpleHLayer_of_mem_centralizer S h0 hs q 1 he₂ ha).1).2
  change h ∈ H[S,q] 1 at hh
  have hyH : y ∈ Hₗ[S,q] 1 := (simpleHGroup_mem_iff_of_pos S h0 hs q le_rfl).mp hh
  change e₂ * x * e₁ = x ∧ x ∈ Jₗ[S,q] 1 at hd
  have hxJ : x ∈ Jₗ[S,q] 1 := hd.2
  obtain ⟨-, hL, -, -, ⟨-, hcross, -⟩, -⟩ := simpleStratumLatticeProperties F V S h0 hs q
  have hyJ : y ∈ Jₗ[S,q] 1 := (hL.2.2.2.2.2.2.2 1).2.2 hyH
  have hxy₂ : x * y ∈ Hₗ[S,q] 2 := hcross 1 1 le_rfl le_rfl (Submodule.mul_mem_mul hxJ hyJ)
  have hxy : x * y ∈ Hₗ[S,q] 1 := ⟨hxy₂.1, S.chain.endFiltration_antitone (by norm_num) hxy₂.2⟩
  have hval : e₂ * (((d * h : G) : A) - 1) * e₁ = x + (e₂ * y * e₁ + e₂ * (x * y) * e₁) := by
    rw [show ((d * h : G) : A) - 1 = x + y + x * y by rw [Units.val_mul]; dsimp [x, y]; noncomm_ring]
    simp only [mul_add, add_mul]
    rw [show e₂ * x * e₁ = x from hd.1]
    abel
  constructor
  · intro hdh
    exact hproj ((simpleHGroup_mem_iff_of_pos S h0 hs q le_rfl).mp hdh)
  · intro hdh
    rw [hval] at hdh
    have hxH : x ∈ Hₗ[S,q] 1 := by
      have hsub := sub_mem hdh (add_mem (hproj hyH) (hproj hxy))
      rwa [add_sub_cancel_right] at hsub
    exact (H[S,q] 1).mul_mem ((simpleHGroup_mem_iff_of_pos S h0 hs q le_rfl).mpr hxH)
      hh

/-- Conjugation by `J^1` preserves the enlarged group. -/
theorem simpleLowerHGroup_conj_mem {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0) {g k : G} (hg : g ∈ J[S,q] 1)
    (hk : k ∈ simpleLowerHGroup S q h₁₂) :
    g * k * g⁻¹ ∈ simpleLowerHGroup S q h₁₂ := by
  have hc := SimpleStratum.commutator_mem_HGroup simpleStratumGroupProperties S h0 hs q
    le_rfl le_rfl (p := 1) (by omega) hg (simpleLowerHGroup_le_simpleJGroup S h0 hs q h₁₂ hk)
  rw [show g * k * g⁻¹ = ⁅g, k⁆ * k by simp [commutatorElement_def]]
  have hHK : H[S,q] 1 ≤ simpleLowerHGroup S q h₁₂ := le_sup_right
  exact (simpleLowerHGroup S q h₁₂).mul_mem (hHK hc) hk

/-- The simple character of `H^1` extends to the enlargement by the trivial
character on the lower unipotent group. -/
theorem exists_simpleLowerHCharacter {e₁ e₂ : A} (h₁₂ : e₁ * e₂ = 0) (hn : (1 : ℤ) < S.n)
    (hcrit : (1 : WithTop ℤ) < simpleCriticalDepth S.chain S.b)
    {ψF : AddChar F ℂ} (hψ : IsBKAdditiveCharacter ψF)
    {θ : H[S,q] 1 →* ℂˣ} (hθ : θ ∈ simpleCharacters ψF S.chain S.n S.b q.tail 0)
    (hadd : e₁ + e₂ = 1) (h₂₁ : e₂ * e₁ = 0)
    (he₁ : e₁ ∈ centralizerLattice S.chain S.b 0) (he₂ : e₂ ∈ centralizerLattice S.chain S.b 0) :
    ∃ η : simpleLowerHGroup S q h₁₂ →* ℂˣ, ∀ (d : simpleLowerJGroup S q h₁₂) (h : H[S,q] 1)
      (hk : (d : G) * (h : G) ∈ simpleLowerHGroup S q h₁₂),
      η ⟨(d : G) * (h : G), hk⟩ = θ h := by
  have hn0 : (0 : ℤ) < S.n := by omega
  have hc0 : (0 : WithTop ℤ) < simpleCriticalDepth S.chain S.b :=
    lt_trans (WithTop.coe_lt_coe.mpr Int.zero_lt_one) hcrit
  have hD := (simpleLowerJGroup_le_simpleJGroup S h0 hs q h₁₂).trans
    ((simpleJGroup_antitone _ _ _ _ (Nat.zero_le 1)).trans
      (simpleJ_le_characterNormalizerSubgroup ψF hψ S h0 hs q 0 hn0 hc0 hθ))
  refine exists_character_on_sup_of_trivial θ hD (fun h hh => ?_)
  exact simpleCharacter_eq_one_of_block S h0 hs q 0 (by simpa using hn) hcrit hψ hθ
    (by rw [add_comm]; exact hadd) h₂₁ h₁₂
    (commute_of_mem_centralizerLattice he₂).symm (commute_of_mem_centralizerLattice he₁).symm h hh.1

end

end Langlands.BushnellKutzko.SplitBlocks
