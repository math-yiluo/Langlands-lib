import Langlands.BushnellKutzko.ElementFieldInvariants
import Langlands.BushnellKutzko.StratumSemilinearTransport

/-! # Invariance of the field invariants of `F[β]` under conjugation

The ramification index `e(E|F)` and residue degree `f(E|F)` of `SubfieldIntegers` and
`ElementFieldInvariants` depend only on the isomorphism class of the `F`-algebra `E`.
Conjugation by an `F`-linear automorphism `f` of `V` restricts to an isomorphism of
`F`-algebras `F[β] ≃ F[fβf⁻¹]`, so the ramification index and residue degree of the field
generated by `β` are invariant under conjugation.
-/

noncomputable section

open ValuativeRel

namespace Langlands.BushnellKutzko

set_option backward.isDefEq.respectTransparency.types false in
/-- The ramification index of an ideal is invariant under an isomorphism of algebras. The
proof follows Mathlib's `Ideal.ramificationIdx_smul`. -/
theorem ramificationIdx_map_algEquiv {R S S' : Type*} [CommRing R] [CommRing S] [CommRing S']
    [Algebra R S] [Algebra R S'] (q : Ideal S) (e : S ≃ₐ[R] S') :
    (q.map e).ramificationIdx R = q.ramificationIdx R := by
  have hcomap : Ideal.comap e (q.map e) = q := Ideal.comap_map_of_bijective e e.bijective
  by_cases hq : q.IsPrime
  swap
  · have hq' : ¬ (q.map e).IsPrime := fun h => hq (hcomap ▸ Ideal.comap_isPrime e (q.map e))
    rw [Ideal.ramificationIdx_of_not_isPrime _ _ hq, Ideal.ramificationIdx_of_not_isPrime _ _ hq']
  · have hq' : (q.map e).IsPrime := Ideal.map_isPrime_of_equiv e
    have hmem : ∀ y : S, e y ∈ q.map e ↔ y ∈ q := fun y => by
      rw [← Ideal.mem_comap, hcomap]
    have hunder : (q.map e).under R = q.under R := by
      ext x
      rw [Ideal.under_def, Ideal.under_def, Ideal.mem_comap, Ideal.mem_comap,
        ← AlgEquiv.commutes e x, hmem]
    let Sq := Localization.AtPrime q
    let Sq' := Localization.AtPrime (q.map e)
    let g : Sq ≃ₐ[R] Sq' := Localization.localAlgEquiv q (q.map e) e hcomap.symm
    let : Algebra Sq Sq' := g.toRingHom.toAlgebra
    have : IsScalarTower R Sq Sq' := IsScalarTower.of_algHom g.toAlgHom
    let p := q.under R
    let e' : (Sq ⧸ p.map (algebraMap R Sq)) ≃ₐ[Sq] Sq' ⧸ p.map (algebraMap R Sq') :=
      Ideal.quotientEquivAlg _ _ (AlgEquiv.ofBijective (Algebra.ofId Sq Sq') g.bijective)
        (by rw [IsScalarTower.algebraMap_eq R Sq Sq', Ideal.map_map,
          ← AlgEquiv.toAlgHom_toRingHom, AlgEquiv.toAlgHom_ofBijective, Algebra.toRingHom_ofId])
    rw [Ideal.ramificationIdx_def (q.map e), Ideal.ramificationIdx_def q, hunder,
      e'.toLinearEquiv.length_eq, Module.length_eq_of_surjective g.surjective]

section Invariants

variable (F : Type*) [Field F] [ValuativeRel F] {E E' : Type*} [Field E] [Field E']
  [Algebra F E] [Algebra F E']

/-- An isomorphism of `F`-algebras restricts to an isomorphism of the rings of integers. -/
def subfieldIntegersAlgEquiv (e : E ≃ₐ[F] E') :
    subfieldIntegers F E ≃ₐ[𝒪[F]] subfieldIntegers F E' :=
  AlgEquiv.mapIntegralClosure (e.restrictScalars 𝒪[F])

theorem map_subfieldMaximalIdeal (e : E ≃ₐ[F] E') :
    (subfieldMaximalIdeal F E).map (subfieldIntegersAlgEquiv F e) = subfieldMaximalIdeal F E' :=
  map_ideal_ringJacobson ((subfieldIntegersAlgEquiv F e : subfieldIntegers F E →ₐ[𝒪[F]]
    subfieldIntegers F E') : subfieldIntegers F E →+* subfieldIntegers F E')
    (subfieldIntegersAlgEquiv F e).bijective

theorem subfieldRamificationIndex_congr (e : E ≃ₐ[F] E') :
    subfieldRamificationIndex F E = subfieldRamificationIndex F E' := by
  unfold subfieldRamificationIndex
  rw [← map_subfieldMaximalIdeal F e]
  exact (ramificationIdx_map_algEquiv _ (subfieldIntegersAlgEquiv F e)).symm

theorem subfieldResidueDegree_congr (e : E ≃ₐ[F] E') :
    subfieldResidueDegree F E = subfieldResidueDegree F E' := by
  unfold subfieldResidueDegree subfieldResidueRing
  congr 1
  exact (Ideal.quotientEquivAlg _ _ (subfieldIntegersAlgEquiv F e)
    (map_subfieldMaximalIdeal F e).symm).toLinearEquiv.length_eq

end Invariants

section Element

variable {F : Type*} [Field F] {V : Type*} [AddCommGroup V] [Module F V]

/-- Conjugation by an `F`-linear automorphism restricts to an isomorphism of
`F`-algebras `F[β] ≃ F[fβf⁻¹]`. -/
def elementAlgebraAlgConj (f : V ≃ₗ[F] V) (β : Module.End F V) :
    elementAlgebra β ≃ₐ[F] elementAlgebra (endConj f β) :=
  { elementAlgebraConj f β with
    commutes' := fun c => Subtype.ext (endConj_algebraMap f c) }

variable [ValuativeRel F]

theorem elementRamificationIndex_endConj (f : V ≃ₗ[F] V) (β : Module.End F V) :
    elementRamificationIndex F (endConj f β) = elementRamificationIndex F β := by
  unfold elementRamificationIndex
  by_cases h : IsField (elementAlgebra β)
  · have h' := (isField_elementAlgebra_endConj_iff f β).2 h
    simp only [h, h', ↓reduceDIte]
    let := h.toField
    let := h'.toField
    exact (subfieldRamificationIndex_congr F (elementAlgebraAlgConj f β)).symm
  · have h' : ¬ IsField (elementAlgebra (endConj f β)) :=
      fun h' => h ((isField_elementAlgebra_endConj_iff f β).1 h')
    simp only [h, h', ↓reduceDIte]

theorem elementResidueDegree_endConj (f : V ≃ₗ[F] V) (β : Module.End F V) :
    elementResidueDegree F (endConj f β) = elementResidueDegree F β := by
  unfold elementResidueDegree
  by_cases h : IsField (elementAlgebra β)
  · have h' := (isField_elementAlgebra_endConj_iff f β).2 h
    simp only [h, h', ↓reduceDIte]
    let := h.toField
    let := h'.toField
    exact (subfieldResidueDegree_congr F (elementAlgebraAlgConj f β)).symm
  · have h' : ¬ IsField (elementAlgebra (endConj f β)) :=
      fun h' => h ((isField_elementAlgebra_endConj_iff f β).1 h')
    simp only [h, h', ↓reduceDIte]

end Element

end Langlands.BushnellKutzko
