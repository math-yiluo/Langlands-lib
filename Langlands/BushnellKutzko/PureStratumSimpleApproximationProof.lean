import Langlands.BushnellKutzko.PureStratumApproximationFromPremises
import Langlands.BushnellKutzko.PureStratumTopNonsplitProof
import Langlands.BushnellKutzko.NonsplitRefinementProof
import Langlands.BushnellKutzko.SplitObstructionProof

/-! # Simple approximation of a pure stratum: proof (BK93 (2.4.1)(i), printed p. 65)

Proof of `PureStratumSimpleApproximationStatement`: every pure stratum is equivalent to a simple
stratum on the same chain with the same integers, whose generated field has ramification index and
residue degree dividing those of the field generated by the original element. The argument of
BK93, printed pp. 66–71, is carried out in `pureStratumSimpleApproximation_of_premises`; this
module supplies its hypotheses, the propositions (2.3.11), (2.3.4) and (2.3.12) of BK93, by their
proofs `topNonsplitPremise`, `nonsplitRefinement` and `splitObstructionPremise`.
-/

namespace Langlands.BushnellKutzko

universe uF uV

/-- **BK93 (2.4.1)(i), printed p. 65.** Every pure stratum `[𝔄,n,r,β]` is equivalent to a simple
stratum `[𝔄,n,r,γ]` with the same chain and integers, such that `e(F[γ]|F)` divides `e(F[β]|F)`
and `f(F[γ]|F)` divides `f(F[β]|F)`. -/
theorem pureStratumSimpleApproximation : PureStratumSimpleApproximationStatement.{uF, uV} :=
  PureApproximation.pureStratumSimpleApproximation_of_premises
    PureApproximation.topNonsplitPremise
    PureApproximation.nonsplitRefinement
    PureApproximation.nonsplitRefinement
    PureApproximation.splitObstructionPremise

end Langlands.BushnellKutzko
