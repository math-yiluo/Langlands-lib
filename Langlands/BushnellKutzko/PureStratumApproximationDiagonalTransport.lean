import Langlands.BushnellKutzko.PureStratumApproximationScaling
import Langlands.BushnellKutzko.PureStratumApproximationFieldInvariants
import Langlands.BushnellKutzko.StratumApproximationReduction
import Langlands.BushnellKutzko.LatticeChainLayerCommutation

/-! # Valuation, normalization and invariants of a repeated field-line diagonal -/

noncomputable section

open ValuativeRel

namespace Langlands.BushnellKutzko.PureApproximation

universe uF uE uV

section Units

variable {F : Type uF} [Field F] [ValuativeRel F]
  {V : Type uV} [AddCommGroup V] [Module F V] (A : LatticeChain 𝒪[F] F V)

private theorem stabilizer_mem_endFiltration (g : A.stabilizer) :
    ((g.val : (Module.End F V)ˣ) : Module.End F V) ∈
      A.endFiltration (A.stabilizerValuation g) := by
  intro i v hv
  have h := Submodule.mem_map_of_mem
    (f := ((g.val : Module.End F V)).restrictScalars 𝒪[F]) hv
  rwa [A.map_lattice_stabilizer g i] at h

/-- If a unit and its inverse send every lattice into the oppositely shifted lattices,
then the unit realizes the shift on the chain. -/
theorem unit_mem_stabilizer_of_shifts (g : (Module.End F V)ˣ) (s : ℤ)
    (hg : (g : Module.End F V) ∈ A.endFiltration s)
    (hg' : (↑g⁻¹ : Module.End F V) ∈ A.endFiltration (-s)) : g ∈ A.stabilizer := by
  intro i
  refine ⟨i + s, ?_⟩
  change (A.lattice i).map ((g : Module.End F V).restrictScalars 𝒪[F]) = A.lattice (i + s)
  ext v
  rw [Submodule.mem_map]
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact hg _ _ hx
  · intro hv
    have h := hg' (i + s) v hv
    rw [add_neg_cancel_right] at h
    refine ⟨(↑g⁻¹ : Module.End F V) v, h, ?_⟩
    change (g : Module.End F V) ((↑g⁻¹ : Module.End F V) v) = v
    rw [← Module.End.mul_apply, Units.mul_inv, Module.End.one_apply]

end Units

section Comparison

variable {F : Type uF} [Field F] [ValuativeRel F]
  {E : Type uE} [Field E] [Algebra F E]
  {V : Type uV} [AddCommGroup V] [Module F V] [Module E V] [IsScalarTower F E V]
  (A : LatticeChain 𝒪[F] F V) (C : LatticeChain 𝒪[F] F E)
  {n : ℕ} (w : Module.Basis (Fin n) E V) (d : ℤ) (p : Fin n → ℤ)
  (hw : RelSplits (L := E) A w) (hd : 0 < d)
  (hcoord : ScaledLatticeCoordinates A C w d p) (j₀ : Fin n)

include hd in
theorem ceilDiv_scale_mul (k : ℤ) : ceilDiv (d * k) d = k := by
  rw [← zero_add (d * k), ceilDiv_add_mul hd, ceilDiv_zero, zero_add]

include hw hd hcoord j₀ in
/-- A normalizing unit on the line acts diagonally by a normalizing unit. -/
theorem diagonal_unit_mem_stabilizer (g : (Module.End F E)ˣ) (hg : g ∈ C.stabilizer) :
    Units.map (diagonal F w).toMonoidHom g ∈ A.stabilizer := by
  let G : C.stabilizer := ⟨g, hg⟩
  let k := C.stabilizerValuation G
  apply unit_mem_stabilizer_of_shifts A _ (d * k)
  · change diagonal F w (g : Module.End F E) ∈ A.endFiltration (d * k)
    rw [diagonal_mem_endFiltration_iff A C w d p hw hd hcoord j₀, ceilDiv_scale_mul d hd]
    exact stabilizer_mem_endFiltration C G
  · change diagonal F w (↑g⁻¹ : Module.End F E) ∈ A.endFiltration (-(d * k))
    rw [← mul_neg, diagonal_mem_endFiltration_iff A C w d p hw hd hcoord j₀,
      ceilDiv_scale_mul d hd]
    have h := stabilizer_mem_endFiltration C G⁻¹
    rw [C.stabilizerValuation_inv] at h
    exact h

include hw hd hcoord j₀ in
/-- An algebra generated by a normalizing line element remains normalizing on the ambient chain. -/
theorem normalizingUnits_diagonal (b : Module.End F E) (hb : NormalizingUnits C (elementAlgebra b)) :
    NormalizingUnits A (elementAlgebra (diagonal F w b)) := by
  intro X hX hX0
  rw [elementAlgebra_diagonal, Subalgebra.mem_map] at hX
  obtain ⟨x, hx, rfl⟩ := hX
  have hx0 : x ≠ 0 := fun h => hX0 (by simp [h])
  obtain ⟨g, hgv, hg⟩ := hb x hx hx0
  exact ⟨Units.map (diagonal F w).toMonoidHom g, congrArg (diagonal F w) hgv,
    diagonal_unit_mem_stabilizer A C w d p hw hd hcoord j₀ g hg⟩

variable [TopologicalSpace F] [IsNonarchimedeanLocalField F]

include hw hd hcoord j₀ in
/-- The valuation of a repeated diagonal is multiplied by the scale, with zero still at top. -/
theorem valuation_diagonal (b : Module.End F E) :
    A.valuation (diagonal F w b) = WithTop.map (fun k => d * k) (C.valuation b) := by
  by_cases hb : b = 0
  · simp [hb, LatticeChain.valuation]
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[F]
  obtain ⟨k, hk, hk'⟩ := exists_depth C hπ hb
  rw [C.valuation_eq_of_mem_of_notMem hk hk', WithTop.map_coe]
  apply A.valuation_eq_of_mem_of_notMem
  · rw [diagonal_mem_endFiltration_iff A C w d p hw hd hcoord j₀, ceilDiv_scale_mul d hd]
    exact hk
  · rw [diagonal_mem_endFiltration_iff A C w d p hw hd hcoord j₀, add_comm (d * k) 1,
      ceilDiv_add_mul hd, ceilDiv_one hd, add_comm 1 k]
    exact hk'

include hw hd hcoord j₀ in
/-- The diagonal lifts the field invariants unchanged. -/
theorem elementInvariants_diagonal (b : Module.End F E)
    (hb : NormalizingUnits C (elementAlgebra b)) :
    elementRamificationIndex F (diagonal F w b) = elementRamificationIndex F b ∧
      elementResidueDegree F (diagonal F w b) = elementResidueDegree F b := by
  let : FiniteDimensional F E := C.finiteDimensional
  let : FiniteDimensional F V := A.finiteDimensional
  obtain ⟨hL, -⟩ := isField_of_normalizingUnits C hb
  obtain ⟨hV, -⟩ := isField_of_normalizingUnits A
    (normalizingUnits_diagonal A C w d p hw hd hcoord j₀ b hb)
  have e : elementAlgebra b ≃ₐ[F] elementAlgebra (diagonal F w b) := by
    rw [elementAlgebra_diagonal]
    exact (elementAlgebra b).equivMapOfInjective (diagonal F w) (diagonal_injective w j₀)
  unfold elementRamificationIndex elementResidueDegree
  rw [dite_eq_left hV, dite_eq_left hL, dite_eq_left hV, dite_eq_left hL]
  let : Field (elementAlgebra b) := hL.toField
  let : Field (elementAlgebra (diagonal F w b)) := hV.toField
  exact subfieldInvariants_of_algEquiv e.symm

/-- Over a nonarchimedean local field `F`, in the common splitting model, the diagonal
transports valuation, normalization and the invariants of a normalizing generated field.
Every hypothesis is a binder of this definition, not a section variable. -/
def DiagonalStratumTransportStatement {F : Type uF} [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] {E : Type uE} [Field E] [Algebra F E]
    {V : Type uV} [AddCommGroup V] [Module F V] [Module E V] [IsScalarTower F E V]
    (A : LatticeChain 𝒪[F] F V) (C : LatticeChain 𝒪[F] F E) {n : ℕ}
    (w : Module.Basis (Fin n) E V) (d : ℤ) (p : Fin n → ℤ) : Prop :=
  RelSplits (L := E) A w → 0 < d → ScaledLatticeCoordinates A C w d p → Nonempty (Fin n) →
    ∀ b : Module.End F E,
      A.valuation (diagonal F w b) = WithTop.map (fun k => d * k) (C.valuation b) ∧
      (NormalizingUnits C (elementAlgebra b) →
        NormalizingUnits A (elementAlgebra (diagonal F w b)) ∧
        elementRamificationIndex F (diagonal F w b) = elementRamificationIndex F b ∧
        elementResidueDegree F (diagonal F w b) = elementResidueDegree F b)

theorem diagonalStratumTransport : DiagonalStratumTransportStatement A C w d p := by
  intro hw hd hcoord ⟨j⟩ b
  exact ⟨valuation_diagonal A C w d p hw hd hcoord j b, fun hb =>
    ⟨normalizingUnits_diagonal A C w d p hw hd hcoord j b hb,
     elementInvariants_diagonal A C w d p hw hd hcoord j b hb⟩⟩

end Comparison

end Langlands.BushnellKutzko.PureApproximation
