import Langlands.BushnellKutzko.PureStratumApproximationConjugation
import Langlands.BushnellKutzko.SimpleCharacterNormalizerRestriction
import Langlands.BushnellKutzko.SimpleCharacterIntertwiningProof
import Langlands.BushnellKutzko.AdjointExactnessProof
import Langlands.BushnellKutzko.DiagonalSplitTypeRefinement

/-! # Making the twisting element split (BK93 (8.2.8)) -/

noncomputable section

open ValuativeRel

namespace Langlands.BushnellKutzko.SplitBlocks

universe uF uV
universe uE

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F] {V : Type uV} [AddCommGroup V] [Module F V]

local notation "A" => Module.End F V
local notation "G" => (Module.End F V)ˣ

omit [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- An element generating the scalar subalgebra commutes with every endomorphism. -/
theorem commute_of_elementAlgebra_eq_bot {β : A} (hβ : elementAlgebra β = ⊥)
    (x : A) : Commute β x := by
  have hmem := Algebra.self_mem_adjoin_singleton F β
  rw [show Algebra.adjoin F ({β} : Set A) = ⊥ from hβ] at hmem
  obtain ⟨a, rfl⟩ := Algebra.mem_bot.mp hmem
  exact Algebra.commutes a x

/-- A corestriction for a field generated by a scalar has zero kernel. -/
theorem tameCorestriction_injective_of_elementAlgebra_eq_bot {E : Type*} [Field E]
    [Algebra F E] [Module E V] [IsScalarTower F E V] (S : Stratum 𝒪[F] F V) (hS : S.IsSimple)
    {βE : E} (hβES : subfieldEmbedding F E V βE = S.b)
    (hβE : Algebra.adjoin F ({βE} : Set E) = ⊤) (hb : elementAlgebra S.b = ⊥)
    (s : TameCorestriction 𝒪[F] F E V) : Function.Injective s := by
  let := S.chain.finiteDimensional
  have hE := PureApproximation.normalized_of_generated S hS.1 hβES hβE
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[F]
  have hsurj := s.surjective_of_clearing S.chain hE (fun h => hϖ.ne_zero (Subtype.ext h))
    (fun x => S.chain.exists_uniformizer_pow_mem_endFiltration hϖ x 0)
  have ha : adjointMap F (subfieldEmbedding F E V βE) = 0 := by
    apply LinearMap.ext
    intro x
    change subfieldEmbedding F E V βE * x - x * subfieldEmbedding F E V βE = 0
    rw [hβES, (commute_of_elementAlgebra_eq_bot hb x).eq, sub_self]
  change Function.Injective s.toLinearMap
  rw [← LinearMap.ker_eq_bot, ← s.range_adjointMap_eq_ker βE hβE hsurj, ha,
    LinearMap.range_zero]

/-- For a simple stratum `[𝔄, n, 0, β]` with `β` not scalar and depth `r`, an element of `𝔓^{−m}`
killed by a tame corestriction is `a_β(x)` for some `x ∈ 𝔔^{r−m} 𝔑_{−r}`
(BK93 (1.4.10)). -/
theorem exists_mem_centralizer_mul_adjoint_of_corestriction_eq_zero {E : Type*} [Field E]
    [Algebra F E] [Module E V] [IsScalarTower F E V] (S : Stratum 𝒪[F] F V) (hS : S.IsSimple)
    {βE : E} (hβES : subfieldEmbedding F E V βE = S.b) (hβE : Algebra.adjoin F ({βE} : Set E) = ⊤)
    (hb : elementAlgebra S.b ≠ ⊥) (s : TameCorestriction 𝒪[F] F E V) {m : ℤ} {z : A} (hz : z ∈ S.chain.endFiltration (-m))
    (hsz : s z = 0) :
    ∃ x ∈ centralizerLattice S.chain S.b (finiteCriticalDepth S.chain S.n S.b - m) *
        adjointLattice S.chain S.b (-finiteCriticalDepth S.chain S.n S.b),
      S.b * x - x * S.b = z := by
  have := S.chain.finiteDimensional
  have hE := PureApproximation.normalized_of_generated S hS.1 hβES hβE
  have hns : ¬ ∃ a : F, algebraMap F E a = βE := by
    rintro ⟨a, ha⟩
    apply hb
    have hmem : S.b ∈ (⊥ : Subalgebra F A) := by
      rw [← hβES, ← ha, AlgHom.commutes]
      exact Subalgebra.algebraMap_mem _ a
    rw [eq_bot_iff]
    exact (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hmem))
  set r := finiteCriticalDepth S.chain S.n S.b with hr
  have hcrit : criticalExponent S.chain S.b = ((-r : ℤ) : WithBot ℤ) := by
    cases hk : criticalExponent S.chain S.b with
    | bot => exact absurd (SimpleStratumLattice.scalar_of_criticalExponent_bot S.chain hk) hb
    | coe k =>
      have hrk : r = -k := by
        simp only [hr, finiteCriticalDepth, simpleCriticalDepth, hk]
        rfl
      rw [hrk, neg_neg]
  have h := adjointExactness F V E S.chain βE hβE hns hE
  rw [hβES] at h
  have h3 := (h.2.2.2.2 s (r - m) (-r) 1 (le_of_eq hcrit) le_rfl).2.2.1
  obtain ⟨-, -, -, -, -, -, -, -, -, hlast⟩ := h3
  have hz' : z ∈ (S.chain.endFiltration (r - m + -r)).toAddSubgroup := by
    rw [show r - m + -r = -m by ring]
    exact hz
  obtain ⟨x, hx, hxz⟩ := (hlast z hz').mp (by
    change (s z).restrictScalars F ∈ (⊥ : AddSubgroup A)
    rw [hsz]
    rfl)
  refine ⟨x, hx, ?_⟩
  have : z - adjointMap 𝒪[F] S.b x = 0 := hxz
  rw [sub_eq_zero] at this
  rw [this]
  rfl

/-- **Changing the twisting element by a unit of `Y_m` (BK93 (8.2.8)).** Let `[𝔄, n, 0, β]` be
simple with `β` not scalar, `θ ∈ C(𝔄, m−1, β)` on `H^m` with `m = i + 1`, `c, c' ∈ 𝔓^{−m}`, and
`u ∈ 𝔔^{r−m} 𝔑_{−r}` with `β u − u β = c' − c`. Then `g = 1 + u` is a unit normalizing `H^m` with
`(θ ψ_c)(g h g⁻¹) = (θ ψ_{c'})(h)` on `H^m`. -/
theorem exists_conj_twist_character_of_adjoint (S : Stratum 𝒪[F] F V) (h0 : S.r = 0) (hs : S.IsSimple)
    (q : S.DefiningSequenceChoice) (i : ℕ) (hin : (i : ℤ) + 1 < S.n)
    (hcrit : (((i + 1 : ℕ) : ℤ) : WithTop ℤ) < simpleCriticalDepth S.chain S.b)
    {ψF : AddChar F ℂ} (hψ : IsBKAdditiveCharacter ψF)
    {θ : simpleHGroup S.chain S.n S.b q.tail (i + 1) →* ℂˣ}
    (hθ : θ ∈ simpleCharacters ψF S.chain S.n S.b q.tail i) (hb : elementAlgebra S.b ≠ ⊥)
    {c c' : A}
    (hc : c ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ)))
    (hc' : c' ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ))) {u : A}
    (huQN : u ∈ centralizerLattice S.chain S.b
      (finiteCriticalDepth S.chain S.n S.b - ((i + 1 : ℕ) : ℤ)) *
        adjointLattice S.chain S.b (-finiteCriticalDepth S.chain S.n S.b))
    (hbu : S.b * u - u * S.b = -(c - c')) :
    ∃ g : G, (g : A) = 1 + u ∧ g ∈ Subgroup.normalizer (simpleHGroup S.chain S.n S.b q.tail (i + 1) : Set G) ∧
      ∀ (h : simpleHGroup S.chain S.n S.b q.tail (i + 1))
        (hgh : g * (h : G) * g⁻¹ ∈ simpleHGroup S.chain S.n S.b q.tail (i + 1)),
        (θ ⟨_, hgh⟩ : ℂ) * elementCharacter (traceCharacter ψF) c (g * (h : G) * g⁻¹) =
          (θ h : ℂ) * elementCharacter (traceCharacter ψF) c' (h : G) := by
  set r := finiteCriticalDepth S.chain S.n S.b with hr
  have hmr : ((i + 1 : ℕ) : ℤ) < r := lt_finiteCriticalDepth_of_lt S.chain S.n S.b hcrit (by omega)
  set d := c - c' with hd
  have hdP : d ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ)) := sub_mem hc hc'
  have huP : u ∈ S.chain.endFiltration (r - ((i + 1 : ℕ) : ℤ)) :=
    (centralizerLattice_mul_adjointLattice_le_inf S.chain S.b hmr.le huQN).2
  obtain ⟨g, hgU, hgu⟩ := S.chain.exists_mem_unitFiltration (n := 1) le_rfl
    (S.chain.endFiltration_antitone (by push_cast; omega) huP)
  have hg1 : (g : A) - 1 = u := by rw [hgu]; abel
  have hgY : g ∈ simpleCharacterIntertwiningFactor S q (i + 1) := by
    unfold simpleCharacterIntertwiningFactor
    rw [ite_eq_right hb]
    exact Submodule.mem_sup_left (hg1 ▸ huQN)
  have hnorm := (simpleCharacterIntertwiningFactor_restriction simpleCharacterIntertwining
    simpleCharacterCovariance ψF hψ S h0 hs q i hin hcrit hθ hgY).1
  have hcrit_i : ((i : ℤ) : WithTop ℤ) < simpleCriticalDepth S.chain S.b :=
    lt_of_le_of_lt (WithTop.coe_le_coe.mpr (by push_cast; omega)) hcrit
  have hcov := simpleCharacterCovariance F V ψF hψ S h0 hs q i (i + 1) (by omega) hin hcrit_i hcrit
    (by omega) θ hθ g (by
      refine ⟨g * 1, Set.mul_mem_mul hgY ?_, 1, ?_, mul_one _⟩
      · exact (centralizerUnitGroup S.b).one_mem
      · unfold simpleCharacterIntertwiningFactor
        rw [ite_eq_right hb]
        dsimp only
        simp)
  refine ⟨g, hgu, hnorm, fun h hgh => ?_⟩
  set w : A := ((g⁻¹ : G) : A) with hwdef
  have hw1 : w * (1 + u) = 1 := by rw [hwdef, ← hgu, Units.inv_mul]
  have hgval : (g : A) = 1 + u := hgu
  -- the conjugation difference
  set D : A := w * S.b * (g : A) - S.b + w * c * (g : A) - c' with hD
  replace hbu : S.b * u - u * S.b = -d := hbu
  have hdiff : w * (S.b + c) * (g : A) - (S.b + c) = w * ((S.b + c) * u - u * (S.b + c)) := by
    rw [hgval]
    have : w * (S.b + c) * (1 + u) - (S.b + c) - w * ((S.b + c) * u - u * (S.b + c)) =
        w * (1 + u) * (S.b + c) - (S.b + c) := by noncomm_ring
    rw [hw1, one_mul, sub_self] at this
    exact sub_eq_zero.mp this
  have hDeq : D = -((w - 1) * d) + w * (c * u - u * c) := by
    have h1 : D = (w * (S.b + c) * (g : A) - (S.b + c)) + d := by
      rw [hD, hd]
      noncomm_ring
    rw [h1, hdiff]
    have h2 : (S.b + c) * u - u * (S.b + c) = (S.b * u - u * S.b) + (c * u - u * c) := by
      noncomm_ring
    rw [h2, hbu]
    noncomm_ring
  -- membership of the correction
  have hw0 : w ∈ S.chain.endFiltration 0 :=
    (S.chain.mem_order_iff_mem_endFiltration).1 hgU.2.1
  have hw1P : w - 1 ∈ S.chain.endFiltration 1 := by
    have := ((S.chain.unitFiltration 1).inv_mem hgU).2.2
    exact_mod_cast this
  have hcu : c * u - u * c ∈ S.chain.endFiltration (1 - ((i + 1 : ℕ) : ℤ)) := by
    have h1 := S.chain.mul_mem_endFiltration hc huP
    have h2 := S.chain.mul_mem_endFiltration huP hc
    exact S.chain.endFiltration_antitone
      (show 1 - ((i + 1 : ℕ) : ℤ) ≤ r - 2 * ((i + 1 : ℕ) : ℤ) by omega) (sub_mem
      (by simpa only [show -((i + 1 : ℕ) : ℤ) + (r - ((i + 1 : ℕ) : ℤ)) =
        r - 2 * ((i + 1 : ℕ) : ℤ) by ring] using h1)
      (by simpa only [show r - ((i + 1 : ℕ) : ℤ) + -((i + 1 : ℕ) : ℤ) =
        r - 2 * ((i + 1 : ℕ) : ℤ) by ring] using h2))
  have hDP : D ∈ S.chain.endFiltration (1 - ((i + 1 : ℕ) : ℤ)) := by
    rw [hDeq]
    refine add_mem (neg_mem ?_) ?_
    · have := S.chain.mul_mem_endFiltration hw1P hdP
      simpa only [show (1 : ℤ) + -((i + 1 : ℕ) : ℤ) = 1 - ((i + 1 : ℕ) : ℤ) by ring] using this
    · simpa using S.chain.mul_mem_endFiltration hw0 hcu
  have hhP : ((h : G) : A) - 1 ∈ S.chain.endFiltration ((i + 1 : ℕ) : ℤ) :=
    (simpleHGroup_le_unitFiltration S.chain S.n S.b q.tail (i + 1) h.2).2.2
  have hDh : elementCharacter (traceCharacter ψF) D (h : G) = 1 := by
    rw [elementCharacter_apply]
    exact traceCharacter_eq_one S.chain hψ (by
      simpa only [show 1 - ((i + 1 : ℕ) : ℤ) + ((i + 1 : ℕ) : ℤ) = 1 by ring] using
        S.chain.mul_mem_endFiltration hDP hhP)
  rw [hcov h hgh, elementCharacter_conj, mul_assoc, ← elementCharacter_add]
  congr 1
  have hsum : w * S.b * (g : A) - S.b + w * c * (g : A) = c' + D := by rw [hD]; abel
  rw [show (↑g⁻¹ : A) = w from rfl, hsum, elementCharacter_add, hDh, mul_one]

/-- **Changing the twisting element (BK93 (8.2.8)).** Let `[𝔄, n, 0, β]` be simple,
`θ ∈ C(𝔄, m−1, β)` on `H^m` with `m = i + 1`, and `c, c' ∈ 𝔓^{−m}` with `s(c) = s(c')`
for a tame corestriction `s`. Some unit `g` normalizing `H^m` satisfies
`(θ ψ_c)(g h g⁻¹) = (θ ψ_{c'})(h)` on `H^m`. -/
theorem exists_conj_twist_character {E : Type*} [Field E] [Algebra F E] [Module E V]
    [IsScalarTower F E V] (S : Stratum 𝒪[F] F V) (h0 : S.r = 0) (hs : S.IsSimple)
    (q : S.DefiningSequenceChoice) (i : ℕ) (hin : (i : ℤ) + 1 < S.n)
    (hcrit : (((i + 1 : ℕ) : ℤ) : WithTop ℤ) < simpleCriticalDepth S.chain S.b)
    {ψF : AddChar F ℂ} (hψ : IsBKAdditiveCharacter ψF)
    {θ : simpleHGroup S.chain S.n S.b q.tail (i + 1) →* ℂˣ}
    (hθ : θ ∈ simpleCharacters ψF S.chain S.n S.b q.tail i)
    {βE : E} (hβES : subfieldEmbedding F E V βE = S.b) (hβE : Algebra.adjoin F ({βE} : Set E) = ⊤)
    (s : TameCorestriction 𝒪[F] F E V) {c c' : A}
    (hc : c ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ)))
    (hc' : c' ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ))) (hscc : s (c - c') = 0) :
    ∃ g : G, g ∈ Subgroup.normalizer (simpleHGroup S.chain S.n S.b q.tail (i + 1) : Set G) ∧
      ∀ (h : simpleHGroup S.chain S.n S.b q.tail (i + 1))
        (hgh : g * (h : G) * g⁻¹ ∈ simpleHGroup S.chain S.n S.b q.tail (i + 1)),
        (θ ⟨_, hgh⟩ : ℂ) * elementCharacter (traceCharacter ψF) c (g * (h : G) * g⁻¹) =
          (θ h : ℂ) * elementCharacter (traceCharacter ψF) c' (h : G) := by
  by_cases hb : elementAlgebra S.b = ⊥
  · have hzero : s (c - c') = s 0 :=
      hscc.trans (s.toAddMonoidHom.map_zero).symm
    have hcc := sub_eq_zero.mp
      (tameCorestriction_injective_of_elementAlgebra_eq_bot S hs hβES hβE hb s hzero)
    subst c'
    refine ⟨1, (Subgroup.normalizer _).one_mem, fun h hh => ?_⟩
    have hconj : (1 : G) * (h : G) * 1⁻¹ = h := by simp
    rw [character_congr θ hconj hh h.2, hconj]
  · obtain ⟨x, hx, hxz⟩ := exists_mem_centralizer_mul_adjoint_of_corestriction_eq_zero S hs hβES
      hβE hb s (sub_mem hc hc') hscc
    obtain ⟨g, -, hg⟩ := exists_conj_twist_character_of_adjoint S h0 hs q i hin hcrit hψ hθ hb
      hc hc' (u := -x) (neg_mem hx) (by rw [← hxz]; noncomm_ring)
    exact ⟨g, hg⟩

/-- The twisting-character normalization for a fixed simple stratum and defining sequence. -/
def TwistNormalizationStatement (S : Stratum 𝒪[F] F V) (q : S.DefiningSequenceChoice) : Prop :=
  S.IsSimple → S.r = 0 →
    ∀ (i : ℕ), (i : ℤ) + 1 < S.n →
      (((i + 1 : ℕ) : ℤ) : WithTop ℤ) < simpleCriticalDepth S.chain S.b →
    ∀ {ψF : AddChar F ℂ}, IsBKAdditiveCharacter ψF →
    ∀ {θ : simpleHGroup S.chain S.n S.b q.tail (i + 1) →* ℂˣ},
      θ ∈ simpleCharacters ψF S.chain S.n S.b q.tail i →
    ∀ {E : Type uE} [Field E] [Algebra F E] [Module E V] [IsScalarTower F E V] {βE : E},
      subfieldEmbedding F E V βE = S.b → Algebra.adjoin F ({βE} : Set E) = ⊤ →
    ∀ (s : TameCorestriction 𝒪[F] F E V) {c c' : A},
      c ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ)) →
      c' ∈ S.chain.endFiltration (-((i + 1 : ℕ) : ℤ)) → s (c - c') = 0 →
    ∃ g : G, g ∈ Subgroup.normalizer (simpleHGroup S.chain S.n S.b q.tail (i + 1) : Set G) ∧
      ∀ (h : simpleHGroup S.chain S.n S.b q.tail (i + 1))
        (hgh : g * (h : G) * g⁻¹ ∈ simpleHGroup S.chain S.n S.b q.tail (i + 1)),
        (θ ⟨_, hgh⟩ : ℂ) * elementCharacter (traceCharacter ψF) c (g * (h : G) * g⁻¹) =
          (θ h : ℂ) * elementCharacter (traceCharacter ψF) c' (h : G)

theorem twistNormalization (S : Stratum 𝒪[F] F V) (q : S.DefiningSequenceChoice) :
    TwistNormalizationStatement S q := by
  intro hs h0 i hin hcrit ψF hψ θ hθ E _ _ _ _ βE hβES hβE s c c' hc hc' hscc
  exact exists_conj_twist_character S h0 hs q i hin hcrit hψ hθ hβES hβE s hc hc' hscc

end Langlands.BushnellKutzko.SplitBlocks
