import Langlands.BushnellKutzko.SimpleCharacterTransferIntersection
import Langlands.BushnellKutzko.NormalizerProof

/-! # Simple-character domains for a terminal element -/

open ValuativeRel
open scoped Pointwise

noncomputable section

namespace Langlands.BushnellKutzko

universe uF uV

variable {F : Type uF} [Field F] [ValuativeRel F]
  {V : Type uV} [AddCommGroup V] [Module F V]

local notation "A" => Module.End F V
local notation "G" => (Module.End F V)ˣ

/-- The terminal simple-character domain is generated by the relative units and
by the full ambient filtration at the high-index cutoff. -/
theorem simpleHGroup_nil_eq_sup (L : LatticeChain 𝒪[F] F V) (n : ℤ) (β : A)
    (k : ℕ) (hk : 0 < k) :
    simpleHGroup L n β [] k = relativeUnitFiltration L β k ⊔
      L.unitFiltration (max k (simpleHCutoff n).toNat) := by
  let c := simpleHCutoff n
  let j := max k c.toNat
  have hkj : k ≤ j := le_max_left ..
  have hcj : c ≤ (j : ℤ) := by
    have h : c.toNat ≤ j := le_max_right ..
    omega
  apply le_antisymm
  · apply (Subgroup.closure_le _).2
    intro g hg
    obtain ⟨hgU, hgH⟩ := hg
    by_cases hc : c ≤ (k : ℤ)
    · have hj : j = k := max_eq_left (by omega)
      exact (le_sup_right : L.unitFiltration j ≤ relativeUnitFiltration L β k ⊔ L.unitFiltration j)
        (show g ∈ L.unitFiltration j by rwa [hj])
    change (g : A) ∈ centralizerLattice L β 0 ⊔ L.endFiltration c at hgH
    obtain ⟨b, hb, y, hy, hsum⟩ := Submodule.mem_sup.mp hgH
    have hbsub : b - 1 ∈ L.endFiltration (k : ℤ) := by
      have heq : b - 1 = (g : A) - 1 - y := by rw [← hsum]; abel
      rw [heq]
      exact sub_mem hgU.2.2 (L.endFiltration_antitone (by omega) hy)
    obtain ⟨u, hu, huval⟩ := L.exists_mem_unitFiltration hk hbsub
    have huval' : (u : A) = b := by rw [huval]; abel
    have huC : u ∈ relativeUnitFiltration L β k := by
      refine ⟨?_, hu⟩
      change Commute β (u : A)
      rw [huval']
      have h := hb.2
      rwa [SetLike.mem_coe, LinearMap.mem_ker, StratumEquivalence.adjointMap_apply, sub_eq_zero] at h
    let v := u⁻¹ * g
    have hvU : v ∈ L.unitFiltration k := (L.unitFiltration k).mul_mem (inv_mem hu) hgU
    have hv : (v : A) - 1 = ((u⁻¹ : G) : A) * y := by
      have hdiff : (g : A) - (u : A) = y := by rw [huval', ← hsum, add_comm, add_sub_cancel_right]
      simp only [v, Units.val_mul, ← hdiff, mul_sub, Units.inv_mul]
    have hj : j = c.toNat := max_eq_right (by omega)
    have hc' : (j : ℤ) = c := by rw [hj, Int.toNat_of_nonneg (by omega)]
    have hvJ : v ∈ L.unitFiltration j := by
      refine ⟨hvU.1, hvU.2.1, ?_⟩
      rw [hc', hv]
      simpa only [zero_add] using L.mul_mem_endFiltration (m := 0) hu.2.1 hy
    have hleft : relativeUnitFiltration L β k ≤ relativeUnitFiltration L β k ⊔ L.unitFiltration j :=
      le_sup_left
    have hright : L.unitFiltration j ≤ relativeUnitFiltration L β k ⊔ L.unitFiltration j :=
      le_sup_right
    have hprod := (relativeUnitFiltration L β k ⊔ L.unitFiltration j).mul_mem
      (hleft huC) (hright hvJ)
    simpa [v] using hprod
  · refine sup_le (relativeUnitFiltration_le_simpleHGroup L n β [] k) ?_
    intro g hg
    apply Subgroup.subset_closure
    refine ⟨L.unitFiltration_antitone hkj hg, ?_⟩
    change (g : A) ∈ centralizerLattice L β 0 ⊔ L.endFiltration c
    refine Submodule.mem_sup.mpr ⟨1, ⟨L.order.one_mem, by simp [StratumEquivalence.adjointMap_apply]⟩,
      (g : A) - 1, L.endFiltration_antitone hcj hg.2.2, ?_⟩
    abel

variable [TopologicalSpace F] [IsNonarchimedeanLocalField F]

/-- For a terminal element, positive-depth groups have the literal filtered carrier. -/
theorem simpleHGroup_nil_mem_lattice (L : LatticeChain 𝒪[F] F V) (n : ℤ) (β : A)
    {k : ℕ} (hk : 0 < k) {g : G} (hg : g ∈ simpleHGroup L n β [] k) :
    (g : A) ∈ simpleHLattice L n β [] := by
  let c := simpleHCutoff n
  let j := max k c.toNat
  rw [simpleHGroup_nil_eq_sup L n β k hk] at hg
  have hnormal : relativeUnitFiltration L β k ≤ Subgroup.normalizer (L.unitFiltration j : Set G) := by
    rw [(normalizer F V L).2.2.1 j]
    exact fun _ h => ((normalizer F V L).1 k).1 h.2
  have hg' : g ∈ (relativeUnitFiltration L β k ⊔ L.unitFiltration j : Subgroup G) := hg
  have hprod := Subgroup.coe_mul_of_left_le_normalizer_right _ _ hnormal
  rw [← SetLike.mem_coe, hprod] at hg'
  obtain ⟨u, hu, v, hv, rfl⟩ := hg'
  change (u : A) * (v : A) ∈ centralizerLattice L β 0 ⊔ L.endFiltration c
  have huc : (u : A) ∈ centralizerLattice L β 0 := by
    refine ⟨hu.2.1, ?_⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, StratumEquivalence.adjointMap_apply, sub_eq_zero]
    exact hu.1
  have hcj : c ≤ (j : ℤ) := by
    have h : c.toNat ≤ j := le_max_right ..
    omega
  have hv' := L.endFiltration_antitone hcj (L.mem_unitFiltration.mp hv).2.2
  have hv'' : (u : A) * ((v : A) - 1) ∈ L.endFiltration c := by
    simpa only [zero_add] using L.mul_mem_endFiltration (m := 0) huc.1 hv'
  exact Submodule.mem_sup.mpr ⟨u, huc, _, hv'', by rw [mul_sub, mul_one]; abel⟩

end Langlands.BushnellKutzko
