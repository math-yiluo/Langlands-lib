import Langlands.BushnellKutzko.SplittingBasis

/-! # Moy's reduction for cosets containing a nilpotent element (Bushnell 1987, Theorem 1)

Let `𝓛` be an `𝔬_F`-lattice chain in `F^ι` with period `e`, let `j ∈ ℤ` and `x ∈ 𝔓^j(𝓛)`.
If the coset `x + 𝔓^{j+1}(𝓛)` contains an element `y` with `y^n ∈ 𝔓^{nj+1}(𝓛)` for some `n`,
there are a lattice chain `𝓜` with period `e'` and an integer `j'` with
`x + 𝔓^{j+1}(𝓛) ⊆ 𝔓^{j'}(𝓜)` and `j / e < j' / e'`
(`LatticeChain.exists_latticeChain_of_pow_mem`). In particular this holds if the coset contains
a nilpotent endomorphism (`LatticeChain.exists_latticeChain_of_isNilpotent`).

This is Bushnell 1987, Theorem 1 (conjectured by Moy), quoted as BK93 (2.3.1). Bushnell's
hypothesis is a nilpotent element of the coset; his Lemma 2.1 reduces it to the power condition,
which is all that his proof (Lemma 2.4) uses.
The proof follows Bushnell's: for a lattice `L` let `I(L)` be the lattice generated by
`(x + 𝔓^{j+1}) L`. Iterating `I` from `L_0` reaches lattices of `𝓛` infinitely often, so
some `B = L_q` satisfies `I^a(B) = ϖ^m B` with `a ≥ 1`. The lattices `ϖ^k I^l(B)` are totally
ordered and form a lattice chain `𝓜` on which `I` acts as a shift `j'`; comparing `I^a = ϖ^m`
gives `a j' = e' m`, and the power condition gives `e m > a j`.
-/

noncomputable section

open ValuativeRel
open scoped Pointwise

namespace Langlands.BushnellKutzko

universe u

/-! ### Enumerating a discrete chain by the integers -/

section OrderChain

variable {β : Type*} [PartialOrder β]

/-- A nonempty chain without largest or smallest element whose closed intervals are finite is
the range of a strictly monotone map `ℤ → β`. -/
theorem exists_strictMono_int_range_eq {s : Set β}
    (hs : IsChain (· ≤ ·) s) (hne : s.Nonempty)
    (hmax : ∀ a ∈ s, ∃ b ∈ s, a < b) (hmin : ∀ a ∈ s, ∃ b ∈ s, b < a)
    (hfin : ∀ a ∈ s, ∀ b ∈ s, {c | c ∈ s ∧ a ≤ c ∧ c ≤ b}.Finite) :
    ∃ f : ℤ → β, StrictMono f ∧ Set.range f = s := by
  classical
  have hs' : IsChain (· < ·) s := by
    intro a ha b hb hab
    rcases hs ha hb hab with h | h
    · exact Or.inl (lt_of_le_of_ne h hab)
    · exact Or.inr (lt_of_le_of_ne h (Ne.symm hab))
  let _ : LinearOrder s := hs'.linearOrder
  let _ : LocallyFiniteOrder s := LocallyFiniteOrder.ofFiniteIcc (fun a b => by
    have h : (Subtype.val ⁻¹' {c | c ∈ s ∧ (a : β) ≤ c ∧ c ≤ b} : Set s).Finite :=
      Set.Finite.preimage (Subtype.val_injective.injOn) (hfin a a.2 b b.2)
    refine h.subset ?_
    intro c hc
    exact ⟨c.2, hc.1, hc.2⟩)
  let _ : SuccOrder s := LinearLocallyFiniteOrder.succOrder s
  let _ : PredOrder s := LinearLocallyFiniteOrder.predOrder s
  have : NoMaxOrder s := ⟨fun a => by
    obtain ⟨b, hb, hab⟩ := hmax a a.2
    exact ⟨⟨b, hb⟩, hab⟩⟩
  have : NoMinOrder s := ⟨fun a => by
    obtain ⟨b, hb, hab⟩ := hmin a a.2
    exact ⟨⟨b, hb⟩, hab⟩⟩
  have : Nonempty s := hne.to_subtype
  let e : s ≃o ℤ := orderIsoIntOfLinearSuccPredArch
  refine ⟨fun t => ((e.symm t : s) : β), ?_, ?_⟩
  · intro t u htu
    have h : e.symm t < e.symm u := e.symm.strictMono htu
    exact h
  · ext b
    constructor
    · rintro ⟨t, rfl⟩
      exact (e.symm t).2
    · intro hb
      exact ⟨e ⟨b, hb⟩, by simp⟩

/-- A map that permutes the range of a strictly monotone `f : ℤ → β` and is strictly monotone on
it acts on indices as a translation. -/
theorem exists_shift_of_strictMono {f : ℤ → β} (hf : StrictMono f) (g : β → β)
    (hmaps : ∀ t, ∃ u, f u = g (f t))
    (hmono : ∀ t u, t < u → g (f t) < g (f u))
    (hsurj : ∀ u, ∃ t, g (f t) = f u) :
    ∃ c : ℤ, ∀ t, f (t + c) = g (f t) := by
  choose h hh using hmaps
  have hmono' : StrictMono h := by
    intro t u htu
    have := hmono t u htu
    rw [← hh t, ← hh u] at this
    exact hf.lt_iff_lt.mp this
  have hsurj' : ∀ u, ∃ t, h t = u := by
    intro u
    obtain ⟨t, ht⟩ := hsurj u
    exact ⟨t, hf.injective ((hh t).trans ht)⟩
  have hstep : ∀ t, h (t + 1) = h t + 1 := by
    intro t
    have h1 : h t < h (t + 1) := hmono' (lt_add_one t)
    obtain ⟨u, hu⟩ := hsurj' (h t + 1)
    have h2 : t < u := hmono'.lt_iff_lt.mp (by omega)
    have h3 : h (t + 1) ≤ h u := hmono'.monotone (by omega)
    omega
  have key : ∀ t, h t = t + h 0 := by
    intro t
    induction t using Int.induction_on with
    | zero => simp
    | succ k ih => rw [hstep, ih]; ring
    | pred k ih =>
      have h1 := hstep (-(k : ℤ) - 1)
      rw [show -(k : ℤ) - 1 + 1 = -(k : ℤ) by ring, ih] at h1
      omega
  refine ⟨h 0, fun t => ?_⟩
  rw [← key t, hh t]

end OrderChain

/-! ### Lattice chains from totally ordered sets of lattices -/

section ChainOfSet

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F] {ϖ : 𝒪[F]} (hϖ : Irreducible ϖ)
variable {ι : Type*}

namespace LatticeChain

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem units_smul_mono (u : Fˣ) {A B : Submodule 𝒪[F] (ι → F)} (h : A ≤ B) :
    u • A ≤ u • B := by
  rw [Units.smul_def, Units.smul_def]
  exact Submodule.map_mono h

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem units_smul_le_units_smul_iff (u : Fˣ) {A B : Submodule 𝒪[F] (ι → F)} :
    u • A ≤ u • B ↔ A ≤ B := by
  refine ⟨fun h => ?_, units_smul_mono u⟩
  have h' := units_smul_mono u⁻¹ h
  rwa [inv_smul_smul, inv_smul_smul] at h'

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem units_smul_lt_units_smul_iff (u : Fˣ) {A B : Submodule 𝒪[F] (ι → F)} :
    u • A < u • B ↔ A < B := by
  simp only [lt_iff_le_not_ge, units_smul_le_units_smul_iff]

/-- `ϖ L = 𝔭 L` for the pointwise action of the unit `ϖ` of `F`. -/
theorem uniformizerAsUnit_smul_eq (L : Submodule 𝒪[F] (ι → F)) :
    uniformizerAsUnit hϖ • L = Ring.jacobson 𝒪[F] • L := by
  rw [jacobson_integer_eq_maximalIdeal, hϖ.maximalIdeal_eq, Submodule.ideal_span_singleton_smul]
  ext v
  simp only [Submodule.mem_smul_pointwise_iff_exists]
  constructor
  · rintro ⟨b, hb, rfl⟩
    refine ⟨b, hb, ?_⟩
    ext k
    simp [Subring.smul_def]
  · rintro ⟨b, hb, rfl⟩
    refine ⟨b, hb, ?_⟩
    ext k
    simp [Subring.smul_def]

/-- `L_{q + e m} = ϖ^m L_q`. -/
theorem lattice_add_period_mul (𝓛 : LatticeChain 𝒪[F] F (ι → F)) (q m : ℤ) :
    𝓛.lattice (q + 𝓛.period * m) = uniformizerAsUnit hϖ ^ m • 𝓛.lattice q := by
  have hval : ((uniformizerAsUnit hϖ ^ m : Fˣ) : F) = (ϖ : F) ^ m := by
    rw [Units.val_zpow_eq_zpow_val, coe_uniformizerAsUnit]
  ext v
  rw [Units.smul_def, Submodule.mem_smul_pointwise_iff_exists, hval]
  constructor
  · intro hv
    refine ⟨((ϖ : F) ^ (-m)) • v, ?_, ?_⟩
    · rw [𝓛.zpow_smul_mem_iff hϖ]
      convert hv using 2
      ring
    · rw [smul_smul, ← zpow_add₀ (coe_uniformizer_ne_zero hϖ)]
      simp
  · rintro ⟨w, hw, rfl⟩
    rw [𝓛.zpow_smul_mem_iff hϖ]
    convert hw using 2
    ring

include hϖ in
/-- A totally ordered set of lattices, stable under all powers of `ϖ`, on which `ϖ` acts
strictly decreasingly, and with finite intervals, is the set of lattices of a lattice chain. -/
theorem exists_latticeChain_range_eq (C : Set (Submodule 𝒪[F] (ι → F)))
    (hlat : ∀ L ∈ C, L.IsLattice F)
    (hchain : IsChain (· ≤ ·) C) (hne : C.Nonempty)
    (hsmul : ∀ L ∈ C, ∀ k : ℤ, uniformizerAsUnit hϖ ^ k • L ∈ C)
    (hlt : ∀ L ∈ C, uniformizerAsUnit hϖ • L < L)
    (hfin : ∀ L ∈ C, ∀ L' ∈ C, {M | M ∈ C ∧ L' ≤ M ∧ M ≤ L}.Finite) :
    ∃ 𝓜 : LatticeChain 𝒪[F] F (ι → F), Set.range 𝓜.lattice = C := by
  set ϖu := uniformizerAsUnit hϖ with hϖu
  have hsmul1 : ∀ L ∈ C, ϖu • L ∈ C := fun L hL => by
    simpa using hsmul L hL 1
  have hsmulinv : ∀ L ∈ C, ϖu⁻¹ • L ∈ C := fun L hL => by
    simpa using hsmul L hL (-1)
  let s : Set (Submodule 𝒪[F] (ι → F))ᵒᵈ := OrderDual.ofDual ⁻¹' C
  have hs : IsChain (· ≤ ·) s := by
    intro a ha b hb hab
    rcases hchain ha hb hab with h | h
    · exact Or.inr h
    · exact Or.inl h
  obtain ⟨f, hf, hrange⟩ := exists_strictMono_int_range_eq hs
    (by obtain ⟨L, hL⟩ := hne; exact ⟨OrderDual.toDual L, hL⟩)
    (fun a ha => ⟨OrderDual.toDual (ϖu • OrderDual.ofDual a), hsmul1 _ ha, hlt _ ha⟩)
    (fun a ha => by
      refine ⟨OrderDual.toDual (ϖu⁻¹ • OrderDual.ofDual a), hsmulinv _ ha, ?_⟩
      have h : ϖu • (ϖu⁻¹ • OrderDual.ofDual a) < ϖu⁻¹ • OrderDual.ofDual a :=
        hlt _ (hsmulinv _ ha)
      rw [smul_inv_smul] at h
      exact h)
    (fun a ha b hb => by
      have h := (hfin (OrderDual.ofDual a) ha (OrderDual.ofDual b) hb).image OrderDual.toDual
      refine h.subset ?_
      intro c hc
      exact ⟨OrderDual.ofDual c, ⟨hc.1, hc.2.2, hc.2.1⟩, rfl⟩)
  have hmemC : ∀ t, OrderDual.ofDual (f t) ∈ C := fun t => by
    have : f t ∈ s := hrange ▸ Set.mem_range_self t
    exact this
  have hrangeC : ∀ L ∈ C, ∃ t, OrderDual.ofDual (f t) = L := by
    intro L hL
    have : OrderDual.toDual L ∈ Set.range f := hrange ▸ hL
    obtain ⟨t, ht⟩ := this
    exact ⟨t, by rw [ht]; rfl⟩
  -- `ϖ` acts on the indices as a translation by some `c > 0`.
  obtain ⟨c, hc⟩ := exists_shift_of_strictMono hf
    (fun a => OrderDual.toDual (ϖu • OrderDual.ofDual a))
    (fun t => by
      obtain ⟨u, hu⟩ := hrangeC _ (hsmul1 _ (hmemC t))
      exact ⟨u, hu⟩)
    (fun t u htu => by
      have h : OrderDual.ofDual (f u) < OrderDual.ofDual (f t) := hf htu
      show ϖu • OrderDual.ofDual (f u) < ϖu • OrderDual.ofDual (f t)
      exact (units_smul_lt_units_smul_iff ϖu).2 h)
    (fun u => by
      obtain ⟨t, ht⟩ := hrangeC _ (hsmulinv _ (hmemC u))
      refine ⟨t, ?_⟩
      show OrderDual.toDual (ϖu • OrderDual.ofDual (f t)) = f u
      rw [ht, smul_inv_smul]
      rfl)
  have hcpos : 0 < c := by
    have h1 : f 0 < f (0 + c) := by
      rw [hc 0]
      exact hlt _ (hmemC 0)
    have := hf.lt_iff_lt.mp h1
    omega
  refine ⟨{ lattice := fun t => OrderDual.ofDual (f t)
            isLattice := fun t => hlat _ (hmemC t)
            lattice_succ_lt := fun t => hf (lt_add_one t)
            exists_period := ⟨c.toNat, by omega, fun t => ?_⟩ }, ?_⟩
  · rw [Int.toNat_of_nonneg hcpos.le, hc t]
    exact uniformizerAsUnit_smul_eq hϖ _
  · ext L
    constructor
    · rintro ⟨t, rfl⟩
      exact hmemC t
    · intro hL
      exact hrangeC L hL

end LatticeChain

end ChainOfSet

/-! ### Moving a vector of exact index -/

section Transitive

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
variable {ι : Type*} [Fintype ι]

namespace LatticeChain

/-- If `v ∈ L_p` but `v ∉ L_{p+1}`, then every `w ∈ L_{p+k}` is `d v` for some
`d ∈ 𝔓^k(𝓛)`. -/
theorem exists_mem_endFiltration_apply_eq (𝓛 : LatticeChain 𝒪[F] F (ι → F)) {p k : ℤ}
    {v w : ι → F} (hv : v ∈ 𝓛.lattice p) (hv' : v ∉ 𝓛.lattice (p + 1))
    (hw : w ∈ 𝓛.lattice (p + k)) :
    ∃ d ∈ 𝓛.endFiltration k, d v = w := by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[F]
  obtain ⟨r, β, hβ, -⟩ := exists_basis_splits_both hϖ 𝓛 𝓛
  have hsum : ∑ l, β.repr v l • β l = v := β.sum_repr v
  obtain ⟨l0, hl0⟩ : ∃ l0, β.repr v l0 • β l0 ∉ 𝓛.lattice (p + 1) := by
    by_contra h
    push Not at h
    apply hv'
    rw [← hsum]
    exact Submodule.sum_mem _ (fun l _ => h l)
  have hterm : β.repr v l0 • β l0 ∈ 𝓛.lattice p :=
    hβ (β.repr v) p (by rw [hsum]; exact hv) l0
  have hc0 : β.repr v l0 ≠ 0 := by
    intro h
    apply hl0
    rw [h, zero_smul]
    exact zero_mem _
  have hβ0 : β l0 ≠ 0 := β.ne_zero l0
  have hcβ0 : β.repr v l0 • β l0 ≠ 0 := smul_ne_zero hc0 hβ0
  have hidx : 𝓛.index hϖ (β.repr v l0 • β l0) = p := by
    have h1 := (𝓛.mem_iff_le_index hϖ hcβ0 p).1 hterm
    have h2 : ¬ (p + 1 ≤ 𝓛.index hϖ (β.repr v l0 • β l0)) := fun h =>
      hl0 ((𝓛.mem_iff_le_index hϖ hcβ0 _).2 h)
    omega
  refine ⟨((β.repr v l0)⁻¹ • β.coord l0).smulRight w, ?_, ?_⟩
  · intro i u hu
    simp only [LinearMap.smulRight_apply, LinearMap.smul_apply, Module.Basis.coord_apply,
      smul_eq_mul]
    by_cases hu0 : β.repr u l0 = 0
    · rw [hu0, mul_zero, zero_smul]
      exact zero_mem _
    have hut : β.repr u l0 • β l0 ∈ 𝓛.lattice i :=
      hβ (β.repr u) i (by rw [β.sum_repr u]; exact hu) l0
    have hr0 : (β.repr v l0)⁻¹ * β.repr u l0 ≠ 0 := mul_ne_zero (inv_ne_zero hc0) hu0
    have heq : β.repr u l0 • β l0 =
        ((β.repr v l0)⁻¹ * β.repr u l0) • (β.repr v l0 • β l0) := by
      rw [smul_smul]
      congr 1
      field_simp
    have h3 := (𝓛.mem_iff_le_index hϖ (smul_ne_zero hu0 hβ0) i).1 hut
    rw [heq, 𝓛.index_smul hϖ hr0 hcβ0, hidx] at h3
    rw [𝓛.smul_mem_iff hϖ hr0]
    exact 𝓛.antitone (by omega) hw
  · simp only [LinearMap.smulRight_apply, LinearMap.smul_apply, Module.Basis.coord_apply,
      smul_eq_mul]
    rw [inv_mul_cancel₀ hc0, one_smul]

end LatticeChain

end Transitive

/-! ### The lattice generated by the image of a coset -/

section CosetImage

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
variable {ι : Type*}

namespace LatticeChain

variable (𝓛 : LatticeChain 𝒪[F] F (ι → F))

/-- `I(L)`: the `𝔬_F`-submodule generated by the vectors `z v` with `z` in the coset
`x + 𝔓^{j+1}(𝓛)` and `v ∈ L` (Bushnell 1987, §2). -/
def cosetImage (j : ℤ) (x : Module.End F (ι → F)) (L : Submodule 𝒪[F] (ι → F)) :
    Submodule 𝒪[F] (ι → F) :=
  Submodule.span 𝒪[F] {w | ∃ z, z - x ∈ 𝓛.endFiltration (j + 1) ∧ ∃ v ∈ L, z v = w}

variable {𝓛} {j : ℤ} {x : Module.End F (ι → F)}

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem apply_mem_cosetImage {z : Module.End F (ι → F)}
    (hz : z - x ∈ 𝓛.endFiltration (j + 1)) {L : Submodule 𝒪[F] (ι → F)} {v : ι → F}
    (hv : v ∈ L) : z v ∈ 𝓛.cosetImage j x L :=
  Submodule.subset_span ⟨z, hz, v, hv, rfl⟩

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem cosetImage_mono : Monotone (𝓛.cosetImage j x) := by
  intro L L' h
  apply Submodule.span_mono
  rintro w ⟨z, hz, v, hv, rfl⟩
  exact ⟨z, hz, v, h hv, rfl⟩

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem cosetImage_units_smul_le (u : Fˣ) (L : Submodule 𝒪[F] (ι → F)) :
    𝓛.cosetImage j x (u • L) ≤ u • 𝓛.cosetImage j x L := by
  rw [cosetImage, Submodule.span_le]
  rintro w ⟨z, hz, v', hv', rfl⟩
  rw [Units.smul_def, Submodule.mem_smul_pointwise_iff_exists] at hv'
  obtain ⟨v, hv, rfl⟩ := hv'
  rw [SetLike.mem_coe, map_smul, Units.smul_def]
  exact Submodule.smul_mem_pointwise_smul _ _ _ (apply_mem_cosetImage hz hv)

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- `I(u L) = u I(L)` for `u ∈ F^×`. -/
theorem cosetImage_units_smul (u : Fˣ) (L : Submodule 𝒪[F] (ι → F)) :
    𝓛.cosetImage j x (u • L) = u • 𝓛.cosetImage j x L := by
  refine le_antisymm (cosetImage_units_smul_le u L) ?_
  have h := cosetImage_units_smul_le (𝓛 := 𝓛) (j := j) (x := x) u⁻¹ (u • L)
  rw [inv_smul_smul] at h
  have h2 := units_smul_mono u h
  rwa [smul_inv_smul] at h2

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem iterate_cosetImage_units_smul (u : Fˣ) (l : ℕ) (L : Submodule 𝒪[F] (ι → F)) :
    (𝓛.cosetImage j x)^[l] (u • L) = u • (𝓛.cosetImage j x)^[l] L := by
  induction l with
  | zero => rfl
  | succ l ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, cosetImage_units_smul]

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem mem_endFiltration_of_sub_mem (hx : x ∈ 𝓛.endFiltration j) {z : Module.End F (ι → F)}
    (hz : z - x ∈ 𝓛.endFiltration (j + 1)) : z ∈ 𝓛.endFiltration j := by
  rw [show z = x + (z - x) by abel]
  exact add_mem hx (𝓛.endFiltration_antitone (by omega : j ≤ j + 1) hz)

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- If `L ⊆ L_p` then `I(L) ⊆ L_{p+j}`. -/
theorem cosetImage_le (hx : x ∈ 𝓛.endFiltration j) {L : Submodule 𝒪[F] (ι → F)} {p : ℤ}
    (hL : L ≤ 𝓛.lattice p) : 𝓛.cosetImage j x L ≤ 𝓛.lattice (p + j) := by
  rw [cosetImage, Submodule.span_le]
  rintro w ⟨z, hz, v, hv, rfl⟩
  exact mem_endFiltration_of_sub_mem hx hz p v (hL hv)

/-- If `L ⊆ L_p` but `L ⊄ L_{p+1}` then `L_{p+j+1} ⊆ I(L)` (the lower half of Bushnell 1987,
Lemma 2.3, printed p. 194). -/
theorem lattice_le_cosetImage [Fintype ι] {L : Submodule 𝒪[F] (ι → F)} {p : ℤ}
    (hL : L ≤ 𝓛.lattice p) (hL' : ¬ L ≤ 𝓛.lattice (p + 1)) :
    𝓛.lattice (p + j + 1) ≤ 𝓛.cosetImage j x L := by
  obtain ⟨v, hv, hv'⟩ := SetLike.not_le_iff_exists.1 hL'
  intro w hw
  obtain ⟨d, hd, hdv⟩ := 𝓛.exists_mem_endFiltration_apply_eq (k := j + 1) (hL hv) hv'
    (by rwa [← add_assoc])
  have h1 : (x + d) v ∈ 𝓛.cosetImage j x L := apply_mem_cosetImage (by simpa using hd) hv
  have h2 : x v ∈ 𝓛.cosetImage j x L := apply_mem_cosetImage (by simp) hv
  have h3 := sub_mem h1 h2
  simpa [hdv] using h3

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem pow_mem_endFiltration_natMul {y : Module.End F (ι → F)} (hy : y ∈ 𝓛.endFiltration j)
    (k : ℕ) : y ^ k ∈ 𝓛.endFiltration (k * j) := by
  induction k with
  | zero =>
    rw [mem_endFiltration]
    intro i v hv
    simpa using hv
  | succ k ih =>
    rw [pow_succ]
    have := 𝓛.mul_mem_endFiltration ih hy
    convert this using 2
    push_cast
    ring

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- A variant of Bushnell 1987, Lemma 2.4 (printed p. 194): if `y ∈ x + 𝔓^{j+1}` and
`L ⊆ L_p`, every `w ∈ I^k(L)` is congruent to `y^k v` modulo `L_{p+kj+1}` for some `v ∈ L`. -/
theorem exists_sub_pow_mem (hx : x ∈ 𝓛.endFiltration j) {y : Module.End F (ι → F)}
    (hy : y - x ∈ 𝓛.endFiltration (j + 1)) {L : Submodule 𝒪[F] (ι → F)} {p : ℤ}
    (hL : L ≤ 𝓛.lattice p) (k : ℕ) :
    ∀ w ∈ (𝓛.cosetImage j x)^[k] L, ∃ v ∈ L, w - (y ^ k) v ∈ 𝓛.lattice (p + k * j + 1) := by
  have hyj : y ∈ 𝓛.endFiltration j := mem_endFiltration_of_sub_mem hx hy
  induction k with
  | zero =>
    intro w hw
    exact ⟨w, hw, by simp⟩
  | succ k ih =>
    intro w hw
    rw [Function.iterate_succ_apply'] at hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨z, hz, u, hu, rfl⟩ := hw
      obtain ⟨v, hv, huv⟩ := ih u hu
      refine ⟨v, hv, ?_⟩
      have hzj : z ∈ 𝓛.endFiltration j := mem_endFiltration_of_sub_mem hx hz
      have hzy : z - y ∈ 𝓛.endFiltration (j + 1) := by
        have := sub_mem hz hy
        rwa [sub_sub_sub_cancel_right] at this
      have h1 : z (u - (y ^ k) v) ∈ 𝓛.lattice (p + ((k + 1 : ℕ) : ℤ) * j + 1) := by
        have := hzj _ _ huv
        convert this using 2
        push_cast
        ring
      have h2 : (z - y) ((y ^ k) v) ∈ 𝓛.lattice (p + ((k + 1 : ℕ) : ℤ) * j + 1) := by
        have := hzy _ _ (𝓛.pow_mem_endFiltration_natMul hyj k p v (hL hv))
        convert this using 2
        push_cast
        ring
      have h3 := add_mem h1 h2
      convert h3 using 1
      simp only [pow_succ', Module.End.mul_apply, map_sub, LinearMap.sub_apply]
      abel
    | zero => exact ⟨0, zero_mem _, by simp⟩
    | add w₁ w₂ _ _ h₁ h₂ =>
      obtain ⟨v₁, hv₁, h₁⟩ := h₁
      obtain ⟨v₂, hv₂, h₂⟩ := h₂
      refine ⟨v₁ + v₂, add_mem hv₁ hv₂, ?_⟩
      convert add_mem h₁ h₂ using 1
      rw [map_add]
      abel
    | smul c w _ h =>
      obtain ⟨v, hv, h⟩ := h
      refine ⟨c • v, L.smul_mem c hv, ?_⟩
      convert Submodule.smul_mem _ c h using 1
      rw [LinearMap.map_smul_of_tower, smul_sub]

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- If `y ∈ x + 𝔓^{j+1}` with `y^n ∈ 𝔓^{nj+1}` and `L ⊆ L_p`, then `I^n(L) ⊆ L_{p+nj+1}`. -/
theorem iterate_cosetImage_le_of_pow_mem (hx : x ∈ 𝓛.endFiltration j)
    {y : Module.End F (ι → F)} (hy : y - x ∈ 𝓛.endFiltration (j + 1)) {n : ℕ}
    (hn : y ^ n ∈ 𝓛.endFiltration (n * j + 1))
    {L : Submodule 𝒪[F] (ι → F)} {p : ℤ} (hL : L ≤ 𝓛.lattice p) :
    (𝓛.cosetImage j x)^[n] L ≤ 𝓛.lattice (p + n * j + 1) := by
  intro w hw
  obtain ⟨v, hvL, hv⟩ := exists_sub_pow_mem hx hy hL n w hw
  have h2 : (y ^ n) v ∈ 𝓛.lattice (p + n * j + 1) := by
    have := hn p v (hL hvL)
    convert this using 2
    ring
  simpa using add_mem hv h2

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- If `y ∈ x + 𝔓^{j+1}` with `y^n = 0` and `L ⊆ L_p`, then `I^n(L) ⊆ L_{p+nj+1}`. -/
theorem iterate_cosetImage_le_of_pow_eq_zero (hx : x ∈ 𝓛.endFiltration j)
    {y : Module.End F (ι → F)} (hy : y - x ∈ 𝓛.endFiltration (j + 1)) {n : ℕ} (hn : y ^ n = 0)
    {L : Submodule 𝒪[F] (ι → F)} {p : ℤ} (hL : L ≤ 𝓛.lattice p) :
    (𝓛.cosetImage j x)^[n] L ≤ 𝓛.lattice (p + n * j + 1) :=
  iterate_cosetImage_le_of_pow_mem hx hy (by rw [hn]; exact zero_mem _) hL

end LatticeChain

end CosetImage

/-! ### Iterating a map that commutes with a group action -/

section IterateSmul

variable {G α : Type*} [Group G] [MulAction G α]

theorem iterate_zpow_smul_comm (J : α → α) (u : G)
    (hsmul : ∀ (k : ℤ) (M : α), J (u ^ k • M) = u ^ k • J M) (l : ℕ) (k : ℤ) (M : α) :
    J^[l] (u ^ k • M) = u ^ k • J^[l] M := by
  induction l with
  | zero => rfl
  | succ l ih => rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, hsmul]

theorem iterate_mul_eq_zpow_smul (J : α → α) (u : G)
    (hsmul : ∀ (k : ℤ) (M : α), J (u ^ k • M) = u ^ k • J M) {a : ℕ} {m : ℤ} {B : α}
    (hper : J^[a] B = u ^ m • B) (t : ℕ) :
    J^[a * t] B = u ^ (m * t) • B := by
  induction t with
  | zero => simp
  | succ t ih =>
    rw [mul_add_one, Function.iterate_add_apply, hper, iterate_zpow_smul_comm J u hsmul, ih,
      smul_smul, ← zpow_add]
    congr 2
    push_cast
    ring

end IterateSmul

/-! ### Lattices sandwiched between consecutive members of a chain -/

section Sandwich

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F] {ϖ : 𝒪[F]} (hϖ : Irreducible ϖ)
variable {ι : Type*}

namespace LatticeChain

variable (𝓛 : LatticeChain 𝒪[F] F (ι → F))

/-- `M` is sandwiched at `p` in `𝓛` if `L_{p+1} ⊊ M ⊆ L_p`. -/
def IsSandwiched (p : ℤ) (M : Submodule 𝒪[F] (ι → F)) : Prop :=
  𝓛.lattice (p + 1) < M ∧ M ≤ 𝓛.lattice p

variable {𝓛}

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem isSandwiched_lattice (p : ℤ) : 𝓛.IsSandwiched p (𝓛.lattice p) :=
  ⟨𝓛.lattice_succ_lt p, le_rfl⟩

namespace IsSandwiched

variable {p p' : ℤ} {M M' : Submodule 𝒪[F] (ι → F)}

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem not_le_succ (h : 𝓛.IsSandwiched p M) : ¬ M ≤ 𝓛.lattice (p + 1) :=
  fun h' => lt_irrefl _ (h.1.trans_le h')

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- A sandwiched lattice is comparable with every member of the chain. -/
theorem le_or_le (h : 𝓛.IsSandwiched p M) (r : ℤ) :
    M ≤ 𝓛.lattice r ∨ 𝓛.lattice r ≤ M := by
  rcases le_or_gt r p with hr | hr
  · exact Or.inl (h.2.trans (𝓛.antitone hr))
  · exact Or.inr ((𝓛.antitone (by omega : p + 1 ≤ r)).trans h.1.le)

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem le_of_le (h : 𝓛.IsSandwiched p M) (h' : 𝓛.IsSandwiched p' M') (hle : M ≤ M') :
    p' ≤ p := by
  by_contra hlt
  have hlt' : p < p' := not_le.1 hlt
  have h2 : 𝓛.lattice p' ≤ 𝓛.lattice (p + 1) := 𝓛.antitone (by omega)
  exact lt_irrefl _ (((h.1.trans_le hle).trans_le h'.2).trans_le h2)

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem eq (h : 𝓛.IsSandwiched p M) (h' : 𝓛.IsSandwiched p' M) : p = p' :=
  le_antisymm (h'.le_of_le h le_rfl) (h.le_of_le h' le_rfl)

theorem isLattice (h : 𝓛.IsSandwiched p M) : M.IsLattice F := by
  have := 𝓛.isLattice (p + 1)
  exact Submodule.IsLattice.of_le_of_isLattice_of_fg F h.1.le ((𝓛.isLattice p).1.of_le h.2)

theorem zpow_smul (h : 𝓛.IsSandwiched p M) (k : ℤ) :
    𝓛.IsSandwiched (p + 𝓛.period * k) (uniformizerAsUnit hϖ ^ k • M) := by
  constructor
  · rw [show p + 𝓛.period * k + 1 = (p + 1) + 𝓛.period * k by ring,
      lattice_add_period_mul hϖ]
    exact (units_smul_lt_units_smul_iff _).2 h.1
  · rw [lattice_add_period_mul hϖ]
    exact units_smul_mono _ h.2

theorem uniformizer_smul_lt (h : 𝓛.IsSandwiched p M) : uniformizerAsUnit hϖ • M < M := by
  have h1 : uniformizerAsUnit hϖ • M ≤ 𝓛.lattice (p + 𝓛.period * 1) := by
    rw [lattice_add_period_mul hϖ, zpow_one]
    exact units_smul_mono _ h.2
  have h2 : 𝓛.lattice (p + 𝓛.period * 1) ≤ 𝓛.lattice (p + 1) :=
    𝓛.antitone (by have := 𝓛.period_pos; omega)
  exact (h1.trans h2).trans_lt h.1

variable {j : ℤ} {x : Module.End F (ι → F)}

/-- If `M` is sandwiched at `p`, then `I(M)` is sandwiched at `p + j` or equals `L_{p+j+1}`. -/
theorem cosetImage_or [Fintype ι] (hx : x ∈ 𝓛.endFiltration j) (h : 𝓛.IsSandwiched p M) :
    𝓛.IsSandwiched (p + j) (𝓛.cosetImage j x M) ∨
      𝓛.cosetImage j x M = 𝓛.lattice (p + j + 1) := by
  rcases (lattice_le_cosetImage (x := x) h.2 h.not_le_succ).lt_or_eq with hlt | heq
  · exact Or.inl ⟨hlt, cosetImage_le hx h.2⟩
  · exact Or.inr heq.symm

theorem exists_cosetImage [Fintype ι] (hx : x ∈ 𝓛.endFiltration j)
    (h : 𝓛.IsSandwiched p M) : ∃ p', 𝓛.IsSandwiched p' (𝓛.cosetImage j x M) := by
  rcases h.cosetImage_or hx with h' | h'
  · exact ⟨_, h'⟩
  · exact ⟨_, h' ▸ isSandwiched_lattice _⟩

end IsSandwiched

variable {j : ℤ} {x : Module.End F (ι → F)}

/-- Iterating `I` from a sandwiched lattice reaches a lattice of the chain after at least one
step (compare Bushnell 1987, Lemma 2.5, printed p. 194): otherwise `I^t(A)` would stay sandwiched at `p + t j` for all
`t`, contradicting `I^n(A) ⊆ L_{p+nj+1}` for the nilpotent `y`. -/
theorem exists_iterate_cosetImage_eq_lattice [Fintype ι] (hx : x ∈ 𝓛.endFiltration j)
    {y : Module.End F (ι → F)} (hy : y - x ∈ 𝓛.endFiltration (j + 1)) {n : ℕ}
    (hn : y ^ n ∈ 𝓛.endFiltration (n * j + 1))
    {p : ℤ} {A : Submodule 𝒪[F] (ι → F)} (hA : 𝓛.IsSandwiched p A) :
    ∃ t : ℕ, 1 ≤ t ∧ ∃ q, (𝓛.cosetImage j x)^[t] A = 𝓛.lattice q := by
  by_contra hcon
  have key : ∀ t : ℕ, 𝓛.IsSandwiched (p + t * j) ((𝓛.cosetImage j x)^[t] A) := by
    intro t
    induction t with
    | zero => simpa using hA
    | succ t ih =>
      rw [Function.iterate_succ_apply']
      rcases ih.cosetImage_or hx with h | h
      · convert h using 1
        push_cast
        ring
      · exact absurd ⟨t + 1, by omega, _, by rw [Function.iterate_succ_apply']; exact h⟩ hcon
  exact (key n).not_le_succ (iterate_cosetImage_le_of_pow_mem hx hy hn hA.2)

/-- Some lattice `L_q` of the chain satisfies `I^a(L_q) = ϖ^m L_q` with `a ≥ 1`. -/
theorem exists_iterate_cosetImage_eq_smul [Fintype ι] (hx : x ∈ 𝓛.endFiltration j)
    {y : Module.End F (ι → F)} (hy : y - x ∈ 𝓛.endFiltration (j + 1)) {n : ℕ}
    (hn : y ^ n ∈ 𝓛.endFiltration (n * j + 1)) :
    ∃ (q : ℤ) (a : ℕ) (m : ℤ), 1 ≤ a ∧
      (𝓛.cosetImage j x)^[a] (𝓛.lattice q) = uniformizerAsUnit hϖ ^ m • 𝓛.lattice q := by
  classical
  have hnext : ∀ q : ℤ, ∃ t : ℕ, 1 ≤ t ∧ ∃ q', (𝓛.cosetImage j x)^[t] (𝓛.lattice q) =
      𝓛.lattice q' :=
    fun q => exists_iterate_cosetImage_eq_lattice hx hy hn (isSandwiched_lattice q)
  choose T hT1 Q hQ using hnext
  obtain ⟨qs, hqs0, hqs⟩ : ∃ qs : ℕ → ℤ, qs 0 = 0 ∧ ∀ k, qs (k + 1) = Q (qs k) :=
    ⟨fun k => Q^[k] 0, rfl, fun k => Function.iterate_succ_apply' Q k 0⟩
  obtain ⟨ts, hts0, hts⟩ : ∃ ts : ℕ → ℕ, ts 0 = 0 ∧ ∀ k, ts (k + 1) = T (qs k) + ts k :=
    ⟨fun k => ∑ i ∈ Finset.range k, T (qs i), by simp,
      fun k => by simp [Finset.sum_range_succ, add_comm]⟩
  have hvisit : ∀ k, (𝓛.cosetImage j x)^[ts k] (𝓛.lattice 0) = 𝓛.lattice (qs k) := by
    intro k
    induction k with
    | zero => rw [hts0, hqs0]; rfl
    | succ k ih => rw [hts, Function.iterate_add_apply, ih, hQ, hqs]
  have hmono : StrictMono ts :=
    strictMono_nat_of_lt_succ (fun k => by rw [hts]; have := hT1 (qs k); omega)
  have : NeZero 𝓛.period := ⟨𝓛.period_pos.ne'⟩
  have main : ∀ k₁ k₂, k₁ < k₂ → ((qs k₁ : ℤ) : ZMod 𝓛.period) = ((qs k₂ : ℤ) : ZMod 𝓛.period) →
      ∃ (q : ℤ) (a : ℕ) (m : ℤ), 1 ≤ a ∧
        (𝓛.cosetImage j x)^[a] (𝓛.lattice q) = uniformizerAsUnit hϖ ^ m • 𝓛.lattice q := by
    intro k₁ k₂ hlt heq
    obtain ⟨m, hm⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ _).1 heq
    refine ⟨qs k₁, ts k₂ - ts k₁, m, ?_, ?_⟩
    · have := hmono hlt
      omega
    · have h1 : (𝓛.cosetImage j x)^[ts k₂ - ts k₁] (𝓛.lattice (qs k₁)) = 𝓛.lattice (qs k₂) := by
        rw [← hvisit k₁, ← Function.iterate_add_apply, Nat.sub_add_cancel (hmono hlt).le, hvisit]
      rw [h1, ← lattice_add_period_mul hϖ]
      congr 1
      omega
  obtain ⟨k₁, k₂, hne, heq⟩ :=
    Finite.exists_ne_map_eq_of_infinite (fun k => ((qs k : ℤ) : ZMod 𝓛.period))
  rcases lt_or_gt_of_ne hne with h | h
  · exact main _ _ h heq
  · exact main _ _ h heq.symm

/-- Bushnell 1987, (2.6)–(2.8) and the argument after (2.8) (printed pp. 194–195), abstracted
and without Bushnell's minimal choice of `a`: let `J` be a monotone operator on submodules that
commutes with the powers of `ϖ`, maps sandwiched lattices to sandwiched lattices and satisfies
`J^a(L_q) = ϖ^m L_q` with `a ≥ 1`. Then the lattices `ϖ^k J^l(L_q)` form a lattice chain `𝓜`
on which `J` acts as the shift by some `c` with `a c = e(𝓜) m`. -/
theorem exists_latticeChain_shift
    (J : Submodule 𝒪[F] (ι → F) → Submodule 𝒪[F] (ι → F)) (hmono : Monotone J)
    (hsmul : ∀ (k : ℤ) (M : Submodule 𝒪[F] (ι → F)),
      J (uniformizerAsUnit hϖ ^ k • M) = uniformizerAsUnit hϖ ^ k • J M)
    (hsw : ∀ (p : ℤ) (M : Submodule 𝒪[F] (ι → F)), 𝓛.IsSandwiched p M →
      ∃ p', 𝓛.IsSandwiched p' (J M))
    {a : ℕ} (ha : 1 ≤ a) {q m : ℤ}
    (hper : J^[a] (𝓛.lattice q) = uniformizerAsUnit hϖ ^ m • 𝓛.lattice q) :
    ∃ (𝓜 : LatticeChain 𝒪[F] F (ι → F)) (c : ℤ),
      (∀ t, 𝓜.lattice (t + c) = J (𝓜.lattice t)) ∧ (a : ℤ) * c = 𝓜.period * m := by
  classical
  set u := uniformizerAsUnit hϖ with hu
  set B := 𝓛.lattice q with hB
  have hsmulI : ∀ (l : ℕ) (k : ℤ) (M : Submodule 𝒪[F] (ι → F)),
      J^[l] (u ^ k • M) = u ^ k • J^[l] M :=
    iterate_zpow_smul_comm J u hsmul
  have hswI : ∀ l : ℕ, ∃ p, 𝓛.IsSandwiched p (J^[l] B) := by
    intro l
    induction l with
    | zero => exact ⟨q, isSandwiched_lattice q⟩
    | succ l ih =>
      obtain ⟨p, hp⟩ := ih
      rw [Function.iterate_succ_apply']
      exact hsw p _ hp
  have hred : ∀ (k : ℤ) (l : ℕ),
      u ^ k • J^[l] B = u ^ (k + m * ((l / a : ℕ) : ℤ)) • J^[l % a] B := by
    intro k l
    have h : J^[l] B = u ^ (m * ((l / a : ℕ) : ℤ)) • J^[l % a] B := by
      rw [← hsmulI, ← iterate_mul_eq_zpow_smul J u hsmul hper, ← Function.iterate_add_apply,
        Nat.mod_add_div]
    rw [h, smul_smul, ← zpow_add]
  let C : Set (Submodule 𝒪[F] (ι → F)) := {M | ∃ (k : ℤ) (l : ℕ), M = u ^ k • J^[l] B}
  have hmemC : ∀ (k : ℤ) (l : ℕ), u ^ k • J^[l] B ∈ C := fun k l => ⟨k, l, rfl⟩
  have hCsw : ∀ M ∈ C, ∃ p, 𝓛.IsSandwiched p M := by
    rintro M ⟨k, l, rfl⟩
    obtain ⟨p, hp⟩ := hswI l
    exact ⟨_, hp.zpow_smul hϖ k⟩
  -- Any two members of `C` are comparable.
  have hcmp : ∀ (k₁ k₂ : ℤ) (l d : ℕ), u ^ k₁ • J^[l] B ≤ u ^ k₂ • J^[l + d] B ∨
      u ^ k₂ • J^[l + d] B ≤ u ^ k₁ • J^[l] B := by
    intro k₁ k₂ l d
    rw [Function.iterate_add_apply, ← hsmulI, ← hsmulI]
    obtain ⟨p, hp⟩ := hswI d
    have hB' : u ^ k₁ • B = 𝓛.lattice (q + 𝓛.period * k₁) :=
      (lattice_add_period_mul hϖ 𝓛 q k₁).symm
    rw [hB']
    rcases (hp.zpow_smul hϖ k₂).le_or_le (q + 𝓛.period * k₁) with h | h
    · exact Or.inr ((hmono.iterate l) h)
    · exact Or.inl ((hmono.iterate l) h)
  have hchain : IsChain (· ≤ ·) C := by
    rintro M₁ ⟨k₁, l₁, rfl⟩ M₂ ⟨k₂, l₂, rfl⟩ -
    rcases le_total l₁ l₂ with h | h
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
      exact hcmp k₁ k₂ l₁ d
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
      exact (hcmp k₂ k₁ l₂ d).symm
  have hCsmul : ∀ M ∈ C, ∀ k : ℤ, u ^ k • M ∈ C := by
    rintro M ⟨k', l, rfl⟩ k
    rw [smul_smul, ← zpow_add]
    exact hmemC _ _
  have hClt : ∀ M ∈ C, u • M < M := fun M hM => by
    obtain ⟨p, hp⟩ := hCsw M hM
    exact hp.uniformizer_smul_lt hϖ
  choose pr hpr using hswI
  have he : (1 : ℤ) ≤ 𝓛.period := by exact_mod_cast 𝓛.period_pos
  have hfin : ∀ L ∈ C, ∀ L' ∈ C, {M | M ∈ C ∧ L' ≤ M ∧ M ≤ L}.Finite := by
    intro L hL L' hL'
    obtain ⟨P, hP⟩ := hCsw L hL
    obtain ⟨P', hP'⟩ := hCsw L' hL'
    refine ((Set.finite_Iio a).biUnion (fun r _ =>
      (Set.finite_Icc (-|P - pr r|) (|P' - pr r|)).image (fun k => u ^ k • J^[r] B))).subset ?_
    rintro M ⟨⟨k, l, rfl⟩, hM₁, hM₂⟩
    rw [hred] at hM₁ hM₂ ⊢
    have hsw' := (hpr (l % a)).zpow_smul hϖ (k + m * ((l / a : ℕ) : ℤ))
    have h1 := hP'.le_of_le hsw' hM₁
    have h2 := hsw'.le_of_le hP hM₂
    refine Set.mem_biUnion (Set.mem_Iio.2 (Nat.mod_lt _ (by omega))) ⟨_, ⟨?_, ?_⟩, rfl⟩
    · have h3 := neg_abs_le (P - pr (l % a))
      rcases le_or_gt 0 (k + m * ((l / a : ℕ) : ℤ)) with hk | hk
      · have := abs_nonneg (P - pr (l % a))
        linarith
      · have := mul_le_mul_of_nonpos_right he hk.le
        linarith
    · have h3 := le_abs_self (P' - pr (l % a))
      rcases le_or_gt (k + m * ((l / a : ℕ) : ℤ)) 0 with hk | hk
      · have := abs_nonneg (P' - pr (l % a))
        linarith
      · have := mul_le_mul_of_nonneg_right he hk.le
        linarith
  obtain ⟨𝓜, h𝓜⟩ := exists_latticeChain_range_eq hϖ C
    (fun M hM => (hCsw M hM).choose_spec.isLattice) hchain ⟨B, 0, 0, by simp⟩ hCsmul hClt hfin
  have hmemM : ∀ t, 𝓜.lattice t ∈ C := fun t => h𝓜 ▸ Set.mem_range_self t
  have hrangeM : ∀ M ∈ C, ∃ t, 𝓜.lattice t = M := fun M hM => by
    rw [← h𝓜] at hM
    exact hM
  -- `J` maps `C` to itself, bijectively and strictly monotonically, and `J^a = ϖ^m` on `C`.
  have hJC : ∀ M ∈ C, J M ∈ C := by
    rintro M ⟨k, l, rfl⟩
    rw [hsmul, ← Function.iterate_succ_apply' J l B]
    exact hmemC _ _
  have hJa : ∀ M ∈ C, J^[a] M = u ^ m • M := by
    rintro M ⟨k, l, rfl⟩
    have h1 : J^[a] (J^[l] B) = J^[l] (J^[a] B) := by
      rw [← Function.iterate_add_apply, ← Function.iterate_add_apply, add_comm]
    rw [hsmulI, h1, hper, hsmulI, smul_smul, smul_smul, mul_comm]
  have hJsurj : ∀ M ∈ C, ∃ M' ∈ C, J M' = M := by
    rintro M ⟨k, l, rfl⟩
    refine ⟨u ^ (k - m) • J^[l + (a - 1)] B, hmemC _ _, ?_⟩
    have h2 : J (J^[l + (a - 1)] B) = J^[l] (J^[a] B) := by
      rw [← Function.iterate_succ_apply' J, ← Function.iterate_add_apply]
      congr 1
      omega
    rw [hsmul, h2, hper, hsmulI, smul_smul, ← zpow_add, sub_add_cancel]
  have hJlt : ∀ M ∈ C, ∀ M' ∈ C, M < M' → J M < J M' := by
    intro M hM M' hM' hlt
    refine lt_of_le_of_ne (hmono hlt.le) (fun heq => hlt.ne ?_)
    have h3 : J^[a] M = J^[a] M' := by
      obtain ⟨b, hb⟩ : ∃ b, a = b + 1 := ⟨a - 1, by omega⟩
      rw [hb, Function.iterate_succ_apply, Function.iterate_succ_apply, heq]
    rw [hJa M hM, hJa M' hM'] at h3
    exact (smul_left_cancel_iff _).1 h3
  obtain ⟨c, hc⟩ := exists_shift_of_strictMono (β := (Submodule 𝒪[F] (ι → F))ᵒᵈ)
    (f := fun t => OrderDual.toDual (𝓜.lattice t))
    (fun t s h => OrderDual.toDual_lt_toDual.2 (𝓜.strictAnti h))
    (fun M => OrderDual.toDual (J (OrderDual.ofDual M)))
    (fun t => by
      obtain ⟨s, hs⟩ := hrangeM _ (hJC _ (hmemM t))
      exact ⟨s, by rw [hs]; rfl⟩)
    (fun t s h => OrderDual.toDual_lt_toDual.2
      (hJlt _ (hmemM s) _ (hmemM t) (𝓜.strictAnti h)))
    (fun s => by
      obtain ⟨M', hM', hJM'⟩ := hJsurj _ (hmemM s)
      obtain ⟨t, ht⟩ := hrangeM M' hM'
      refine ⟨t, ?_⟩
      show OrderDual.toDual (J (𝓜.lattice t)) = OrderDual.toDual (𝓜.lattice s)
      rw [ht, hJM'])
  have hc' : ∀ t, 𝓜.lattice (t + c) = J (𝓜.lattice t) :=
    fun t => OrderDual.toDual.injective (hc t)
  have hit : ∀ s : ℕ, ∀ t, 𝓜.lattice (t + s * c) = J^[s] (𝓜.lattice t) := by
    intro s
    induction s with
    | zero => intro t; simp
    | succ s ih =>
      intro t
      rw [Function.iterate_succ_apply', ← ih, ← hc']
      congr 1
      push_cast
      ring
  have h4 : 𝓜.lattice (0 + a * c) = 𝓜.lattice (0 + 𝓜.period * m) := by
    rw [hit, hJa _ (hmemM 0), lattice_add_period_mul hϖ 𝓜]
  have h5 := 𝓜.injective h4
  exact ⟨𝓜, c, hc', by linarith⟩

end LatticeChain

end Sandwich

/-! ### The main theorem -/

section Main

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
variable {ι : Type*} [Fintype ι]

namespace LatticeChain

/-- **Bushnell 1987, Theorem 1**, in the form proved there (Moy's conjecture; BK93 (2.3.1)).
Let `𝓛` be a lattice chain in `F^ι`, `j ∈ ℤ` and `x ∈ 𝔓^j(𝓛)`. If the coset `x + 𝔓^{j+1}(𝓛)`
contains an element `y` with `y^n ∈ 𝔓^{nj+1}(𝓛)` for some `n`, there are a lattice chain `𝓜`
and `j' ∈ ℤ` with `x + 𝔓^{j+1}(𝓛) ⊆ 𝔓^{j'}(𝓜)` and `j / e(𝓛) < j' / e(𝓜)`. -/
theorem exists_latticeChain_of_pow_mem (𝓛 : LatticeChain 𝒪[F] F (ι → F)) {j : ℤ}
    {x y : Module.End F (ι → F)} (hx : x ∈ 𝓛.endFiltration j) {n : ℕ}
    (hn : y ^ n ∈ 𝓛.endFiltration (n * j + 1))
    (hxy : y - x ∈ 𝓛.endFiltration (j + 1)) :
    ∃ (𝓜 : LatticeChain 𝒪[F] F (ι → F)) (j' : ℤ),
      (∀ z, z - x ∈ 𝓛.endFiltration (j + 1) → z ∈ 𝓜.endFiltration j') ∧
        j * 𝓜.period < j' * 𝓛.period := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[F]
  obtain ⟨q, a, m, ha, hper⟩ := exists_iterate_cosetImage_eq_smul hϖ hx hxy hn
  obtain ⟨𝓜, c, hc, hac⟩ := exists_latticeChain_shift hϖ (𝓛.cosetImage j x) cosetImage_mono
    (fun k M => cosetImage_units_smul _ M) (fun p M h => h.exists_cosetImage hx) ha hper
  refine ⟨𝓜, c, fun z hz => ?_, ?_⟩
  · intro t v hv
    rw [hc]
    exact apply_mem_cosetImage hz hv
  · have hbound : ∀ s : ℕ, (𝓛.cosetImage j x)^[n * s] (𝓛.lattice q) ≤
        𝓛.lattice (q + s * (n * j + 1)) := by
      intro s
      induction s with
      | zero => simp
      | succ s ih =>
        rw [mul_add_one, add_comm (n * s) n, Function.iterate_add_apply]
        have := iterate_cosetImage_le_of_pow_mem hx hxy hn ih
        convert this using 2
        push_cast
        ring
    have h1 := hbound a
    rw [mul_comm n a, iterate_mul_eq_zpow_smul _ _ (fun k M => cosetImage_units_smul _ M) hper,
      ← lattice_add_period_mul hϖ] at h1
    have h2 := 𝓛.strictAnti.le_iff_ge.1 h1
    have he : (0 : ℤ) < 𝓜.period := by exact_mod_cast 𝓜.period_pos
    have ha' : (1 : ℤ) ≤ a := by exact_mod_cast ha
    have h3 : (a : ℤ) * j < 𝓛.period * m := by
      by_contra h
      have h' : (𝓛.period : ℤ) * m ≤ a * j := not_lt.1 h
      have : (n : ℤ) * (𝓛.period * m) ≤ n * (a * j) :=
        mul_le_mul_of_nonneg_left h' (by positivity)
      nlinarith
    have h4 : (a : ℤ) * (j * 𝓜.period) < a * (c * 𝓛.period) := by
      rw [show (a : ℤ) * (j * 𝓜.period) = 𝓜.period * (a * j) by ring,
        show (a : ℤ) * (c * 𝓛.period) = 𝓛.period * (a * c) by ring, hac]
      have := mul_lt_mul_of_pos_left h3 he
      linarith
    exact lt_of_mul_lt_mul_left h4 (by positivity)

/-- **Bushnell 1987, Theorem 1** (Moy's conjecture; BK93 (2.3.1)). Let `𝓛` be a lattice chain
in `F^ι`, `j ∈ ℤ` and `x ∈ 𝔓^j(𝓛)`. If the coset `x + 𝔓^{j+1}(𝓛)` contains a nilpotent
element `y`, there are a lattice chain `𝓜` and `j' ∈ ℤ` with `x + 𝔓^{j+1}(𝓛) ⊆ 𝔓^{j'}(𝓜)` and
`j / e(𝓛) < j' / e(𝓜)`. -/
theorem exists_latticeChain_of_isNilpotent (𝓛 : LatticeChain 𝒪[F] F (ι → F)) {j : ℤ}
    {x y : Module.End F (ι → F)} (hx : x ∈ 𝓛.endFiltration j) (hy : IsNilpotent y)
    (hxy : y - x ∈ 𝓛.endFiltration (j + 1)) :
    ∃ (𝓜 : LatticeChain 𝒪[F] F (ι → F)) (j' : ℤ),
      (∀ z, z - x ∈ 𝓛.endFiltration (j + 1) → z ∈ 𝓜.endFiltration j') ∧
        j * 𝓜.period < j' * 𝓛.period := by
  obtain ⟨n, hn⟩ := hy
  exact 𝓛.exists_latticeChain_of_pow_mem hx (n := n) (by rw [hn]; exact zero_mem _) hxy

end LatticeChain

end Main

end Langlands.BushnellKutzko
