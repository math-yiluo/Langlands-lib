import Langlands.BushnellKutzko.SimpleIntertwiningStatement
import Langlands.BushnellKutzko.SimpleStratumLattices

/-! # The groups of a simple stratum (BK93 (3.1.14), printed p. 95) -/

noncomputable section

namespace Langlands.BushnellKutzko

universe uO uF uV

variable {O : Type uO} {F : Type uF} {V : Type uV} [CommRing O] [Field F] [Algebra O F]
  [AddCommGroup V] [Module F V] [Module O V] [IsScalarTower O F V]

local notation "A" => Module.End F V
local notation "G" => (Module.End F V)ˣ

/-- The literal intersection `ℌ(β,𝔄) ∩ U^m(𝔄)` inside `G`. -/
def simpleHCarrier (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) (m : ℕ) : Set G :=
  {g | g ∈ L.unitFiltration m ∧ (g : A) ∈ simpleHLattice L n β tail}

/-- The literal intersection `𝔍(β,𝔄) ∩ U^m(𝔄)` inside `G`. -/
def simpleJCarrier (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) (m : ℕ) : Set G :=
  {g | g ∈ L.unitFiltration m ∧ (g : A) ∈ simpleJLattice L n β tail}

/-- Subgroup generated by the `H^m` intersection; exactness of the carrier on
simple input is a separate target, not a hypothesis of the construction. -/
def simpleHGroup (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) (m : ℕ) : Subgroup G :=
  Subgroup.closure (simpleHCarrier L n β tail m)

/-- Subgroup generated by the `J^m` intersection. -/
def simpleJGroup (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) (m : ℕ) : Subgroup G :=
  Subgroup.closure (simpleJCarrier L n β tail m)

/-- The level-zero `J = J^0`. -/
abbrev simpleJ (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) : Subgroup G :=
  simpleJGroup L n β tail 0

theorem simpleHGroup_le_unitFiltration (L : LatticeChain O F V) (n : ℤ) (β : A)
    (tail : List A) (m : ℕ) : simpleHGroup L n β tail m ≤ L.unitFiltration m :=
  (Subgroup.closure_le (L.unitFiltration m)).2 (fun _ hg => hg.1)

theorem simpleJGroup_le_unitFiltration (L : LatticeChain O F V) (n : ℤ) (β : A)
    (tail : List A) (m : ℕ) : simpleJGroup L n β tail m ≤ L.unitFiltration m :=
  (Subgroup.closure_le (L.unitFiltration m)).2 (fun _ hg => hg.1)

theorem simpleHGroup_antitone (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) :
    Antitone (simpleHGroup L n β tail) := by
  intro i j hij
  apply Subgroup.closure_mono
  exact fun _ hg => ⟨L.unitFiltration_antitone hij hg.1, hg.2⟩

theorem simpleJGroup_antitone (L : LatticeChain O F V) (n : ℤ) (β : A) (tail : List A) :
    Antitone (simpleJGroup L n β tail) := by
  intro i j hij
  apply Subgroup.closure_mono
  exact fun _ hg => ⟨L.unitFiltration_antitone hij hg.1, hg.2⟩

/-- The centralizer units `B_β^×` inside `G`: commuting with the generator is
commuting with `F[β]`. -/
def centralizerUnitGroup (β : A) : Subgroup G where
  carrier := centralizerUnits β
  one_mem' := Commute.one_right β
  mul_mem' hg hh := Commute.mul_right hg hh
  inv_mem' hg := Commute.units_inv_right hg

/-- The image of `U^m(𝔅_β)` in `G`, computed in the shared lattice chain. -/
def relativeUnitFiltration (L : LatticeChain O F V) (β : A) (m : ℕ) : Subgroup G :=
  centralizerUnitGroup β ⊓ L.unitFiltration m

/-- The image of `𝔎(𝔅_β)` in `G`, computed in the shared lattice chain. -/
def relativeOrderNormalizer (L : LatticeChain O F V) (β : A) : Subgroup G :=
  centralizerUnitGroup β ⊓ L.stabilizer

end Langlands.BushnellKutzko
