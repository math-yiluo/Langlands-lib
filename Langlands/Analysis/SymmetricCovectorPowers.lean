import Mathlib.Analysis.Analytic.IteratedFDeriv
import Mathlib.LinearAlgebra.Multilinear.Basis
import Mathlib.Topology.Algebra.Module.FiniteDimension

/-! # Pure covector powers span symmetric continuous multilinear forms -/

noncomputable section

open scoped BigOperators

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Langlands

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The multilinear form obtained by using the same covector in every argument. -/
def continuousCovectorPower (n : ℕ) (covector : E →L[ℝ] ℝ) : E [×n]→L[ℝ] ℝ :=
  (ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap (fun _ => covector)

@[simp]
theorem continuousCovectorPower_apply (n : ℕ) (covector : E →L[ℝ] ℝ) (x : Fin n → E) :
    continuousCovectorPower n covector x = ∏ i, covector (x i) := rfl

theorem continuous_continuousCovectorPower (n : ℕ) :
    Continuous (continuousCovectorPower (E := E) n) :=
  ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMapLRight
    (E := fun _ => E)).cont.comp (continuous_pi fun _ => continuous_id)

@[simp]
theorem continuousCovectorPower_comp (n : ℕ) (covector : E →L[ℝ] ℝ) (L : E →L[ℝ] E) :
    (continuousCovectorPower n covector).compContinuousLinearMap (fun _ => L) =
      continuousCovectorPower n (covector.comp L) := by
  ext x
  rfl

/-- The subspace generated by pure covector powers in degree `n`. -/
def continuousCovectorPowerSpan (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]
    (n : ℕ) : Submodule ℝ (E [×n]→L[ℝ] ℝ) :=
  Submodule.span ℝ (Set.range (continuousCovectorPower (E := E) n))

private theorem finiteDimensional_multilinearForms [FiniteDimensional ℝ E] (n : ℕ) :
    FiniteDimensional ℝ (E [×n]→L[ℝ] ℝ) := by
  let b := Module.finBasis ℝ E
  let B := Basis.multilinearMap (R := ℝ) (fun _ : Fin n => b) (Module.finBasis ℝ ℝ)
  let := Module.Finite.of_basis B
  exact FiniteDimensional.of_injective ContinuousMultilinearMap.toMultilinearMapLinear
    ContinuousMultilinearMap.toMultilinearMap_injective

private theorem sum_products_mem_continuousCovectorPowerSpan [FiniteDimensional ℝ E] (n : ℕ)
    (covectors : Fin n → E →L[ℝ] ℝ) :
    ∑ σ : Equiv.Perm (Fin n),
      (ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
        (fun i => covectors (σ i)) ∈ continuousCovectorPowerSpan E n := by
  let M := E [×n]→L[ℝ] ℝ
  let : FiniteDimensional ℝ M := finiteDimensional_multilinearForms n
  let S := continuousCovectorPowerSpan E n
  obtain ⟨Q, hQ⟩ := S.exists_isCompl
  let P : M →L[ℝ] M := (Q.projection S hQ.symm).toContinuousLinearMap
  let B : (E →L[ℝ] ℝ) [×n]→L[ℝ] M :=
    (ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMapLRight
  let F := P.compContinuousMultilinearMap B
  have hF : (fun l : E →L[ℝ] ℝ => F (fun _ => l)) = 0 := by
    funext l
    change Q.projection S hQ.symm (continuousCovectorPower n l) = 0
    exact (Submodule.projection_apply_eq_zero_iff hQ.symm).mpr (Submodule.subset_span ⟨l, rfl⟩)
  have hd := F.iteratedFDeriv_comp_diagonal (0 : E →L[ℝ] ℝ) covectors
  rw [hF, iteratedFDeriv_zero] at hd
  change (0 : M) = _ at hd
  apply (Submodule.projection_apply_eq_zero_iff hQ.symm).mp
  change P (∑ σ : Equiv.Perm (Fin n), B (fun i => covectors (σ i))) = 0
  rw [map_sum]
  exact hd.symm

/-- Every symmetric continuous multilinear form on a finite-dimensional real space is a linear
combination of pure covector powers. -/
theorem mem_continuousCovectorPowerSpan_of_symmetric [FiniteDimensional ℝ E] {n : ℕ}
    (m : E [×n]→L[ℝ] ℝ)
    (hm : ∀ (σ : Equiv.Perm (Fin n)) (x : Fin n → E), m (fun i => x (σ i)) = m x) :
    m ∈ continuousCovectorPowerSpan E n := by
  classical
  let M := E [×n]→L[ℝ] ℝ
  let S := continuousCovectorPowerSpan E n
  let b := Module.finBasis ℝ E
  let d := Module.finrank ℝ E
  let cov (i : Fin d) : E →L[ℝ] ℝ := (b.coord i).toContinuousLinearMap
  let B (a : Fin n → Fin d) : M :=
    (ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap (fun i => cov (a i))
  let c (a : Fin n → Fin d) := m (fun i => b (a i))
  have hexp : m = ∑ a : Fin n → Fin d, c a • B a := by
    ext x
    have hx : (fun i => ∑ j : Fin d, cov j (x i) • b j) = x := funext fun i => b.sum_repr (x i)
    calc
      m x = m (fun i => ∑ j : Fin d, cov j (x i) • b j) := congrArg m hx.symm
      _ = ∑ a : Fin n → Fin d, m (fun i => cov (a i) (x i) • b (a i)) :=
        m.toMultilinearMap.map_sum (fun i j => cov j (x i) • b j)
      _ = (∑ a : Fin n → Fin d, c a • B a) x := by
        rw [_root_.sum_apply]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [ContinuousMultilinearMap.map_smul_univ]
        change (∏ i, cov (a i) (x i)) * c a = c a * (∏ i, cov (a i) (x i))
        exact mul_comm _ _
  let R (σ : Equiv.Perm (Fin n)) : M →ₗ[ℝ] M :=
    (ContinuousMultilinearMap.domDomCongrₗᵢ (𝕜 := ℝ) (G := E) (G' := ℝ) σ).toLinearEquiv.toLinearMap
  let sym : M →ₗ[ℝ] M := ∑ σ, R σ
  have hsym (p : M) (x : Fin n → E) : sym p x = ∑ σ : Equiv.Perm (Fin n), p (fun i => x (σ i)) := by
    have h : sym p = ∑ σ, R σ p := LinearMap.sum_apply _ _ _
    rw [h, _root_.sum_apply]
    rfl
  have hB (a : Fin n → Fin d) : sym (B a) ∈ S := by
    have he : sym (B a) = ∑ σ : Equiv.Perm (Fin n),
        (ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
          (fun i => cov (a (σ i))) := by
      ext x
      rw [hsym, _root_.sum_apply, ← Equiv.sum_comp (Equiv.inv (Equiv.Perm (Fin n)))]
      refine Finset.sum_congr rfl fun σ _ => ?_
      change (∏ i, cov (a i) (x (σ.symm i))) = ∏ i, cov (a (σ i)) (x i)
      calc
        _ = ∏ i, cov (a (σ i)) (x (σ.symm (σ i))) :=
          (Equiv.prod_comp σ (fun i => cov (a i) (x (σ.symm i)))).symm
        _ = _ := Finset.prod_congr rfl fun i _ => congrArg (cov (a (σ i)) ∘ x) (σ.symm_apply_apply i)
    rw [he]
    exact sum_products_mem_continuousCovectorPowerSpan n (fun i => cov (a i))
  have hsymm : sym m = (Fintype.card (Equiv.Perm (Fin n)) : ℝ) • m := by
    ext x
    rw [hsym]
    simp [hm, nsmul_eq_mul, smul_eq_mul]
  have hs : sym m ∈ S := by
    rw [hexp, map_sum]
    exact Submodule.sum_mem S fun a _ => by rw [map_smul]; exact S.smul_mem _ (hB a)
  have hp : (Fintype.card (Equiv.Perm (Fin n)) : ℝ) ≠ 0 := by
    exact_mod_cast (Fintype.card_ne_zero : Fintype.card (Equiv.Perm (Fin n)) ≠ 0)
  rw [hsymm] at hs
  have h := S.smul_mem (Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ hs
  rwa [smul_smul, inv_mul_cancel₀ hp, one_smul] at h

/-- A fixed finite list of pure powers and continuous coordinate functionals expands every
symmetric continuous multilinear form in the given degree. -/
theorem exists_continuousCovectorPower_expansion [FiniteDimensional ℝ E] (n : ℕ) :
    ∃ (d : ℕ) (cov : Fin d → E →L[ℝ] ℝ) (c : Fin d → (E [×n]→L[ℝ] ℝ) →L[ℝ] ℝ),
      ∀ m : E [×n]→L[ℝ] ℝ,
        (∀ (σ : Equiv.Perm (Fin n)) (x : Fin n → E), m (fun i => x (σ i)) = m x) →
        m = ∑ i, c i m • continuousCovectorPower n (cov i) := by
  classical
  let M := E [×n]→L[ℝ] ℝ
  let : FiniteDimensional ℝ M := finiteDimensional_multilinearForms n
  let S := continuousCovectorPowerSpan E n
  obtain ⟨I, u, _, hspan, hu⟩ := exists_linearIndependent' ℝ (continuousCovectorPower (E := E) n)
  let : Finite I := hu.finite
  let : Fintype I := Fintype.ofFinite I
  let e := Fintype.equivFin I
  let b : Module.Basis (Fin (Fintype.card I)) ℝ S :=
    ((Module.Basis.span hu).map (LinearEquiv.ofEq _ _ hspan)).reindex e
  obtain ⟨Q, hQ⟩ := S.exists_isCompl
  let c (i : Fin (Fintype.card I)) : M →L[ℝ] ℝ :=
    ((b.coord i).comp (S.projectionOnto Q hQ)).toContinuousLinearMap
  refine ⟨Fintype.card I, u ∘ e.symm, c, fun m hm => ?_⟩
  let m' : S := ⟨m, mem_continuousCovectorPowerSpan_of_symmetric m hm⟩
  have h := congrArg (fun x : S => (x : M)) (b.sum_repr m')
  have hb (i : Fin (Fintype.card I)) : ((b i : S) : M) = continuousCovectorPower n (u (e.symm i)) := by
    change (↑(((Module.Basis.span hu).map (LinearEquiv.ofEq _ _ hspan)).reindex e i) : M) = _
    rw [Module.Basis.reindex_apply, Module.Basis.map_apply, LinearEquiv.coe_ofEq_apply,
      Module.Basis.coe_span_apply]
    rfl
  have hc (i : Fin (Fintype.card I)) : c i m = b.repr m' i := by
    change b.coord i (S.projectionOnto Q hQ m) = b.repr m' i
    rw [Submodule.projectionOnto_apply_left hQ m', Module.Basis.coord_apply]
  simpa only [Submodule.coe_sum, Submodule.coe_smul, hb, ← hc, Function.comp_apply] using h.symm

end Langlands
