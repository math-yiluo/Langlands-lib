import Langlands.Representation.Derivative.MirabolicMinusPairingTransferStatement
import Langlands.AllField.Representation.Derivative.MirabolicMinus
import Langlands.AllField.Representation.RankinSelberg.AnalyticStatement
/-!
# Transfer of invariant pairings through unnormalized `Φ⁻`

A nonzero determinant-covariant pairing of two smooth representations of
`P_(m+2)`, the first generated by the vectors `ξ u x - x` with `u` in the radical,
gives a nonzero pairing of their unnormalized `Φ⁻` with the exponent lowered by one.
-/

noncomputable section

namespace Langlands.AllField.Derivative.Mirabolic
open Langlands.Derivative.Mirabolic hiding PhiMinusPairingTransferStatement phiMinusQuotient phiMinusQuotient_radical phiMinusQuotient_surjective phiMinusUnnormalized phiMinusUnnormalized_action
open Langlands.AllField.Derivative.Mirabolic
open Langlands.Derivative
open Langlands.AllField.Derivative

open Langlands.GeneralLinear
open Langlands.HarmonicAnalysis
open Langlands.RankinSelberg hiding UnequalRankAnalyticStatement UnequalRankCommonGeneratorStatement normalizedAbsoluteValue normalizedAbsoluteValue_apply
open Langlands.AllField.RankinSelberg

universe uF uV uW

/-- Let `ξ`, `ξ'` be smooth representations of `mirabolic (m + 1) F` such that the
vectors `ξ u x - x`, with `u` in the radical, span the carrier of `ξ`. A nonzero
form in `InvariantBilinear.forms ξ ξ'` at covariance `g ↦ |det g|^(-s)` gives a
nonzero form on the unnormalized `Φ⁻ ξ` and `Φ⁻ ξ'` at covariance
`h ↦ |det h|^(-(s - 1))`. -/
def PhiMinusPairingTransferStatement 
    (F : Type uF) [Field F] (T : LocalFieldData F) (m : ℕ) : Prop :=
  letI := T.topology
  ∀ ψ : UnitaryAdditiveCharacter F,
    ∀ (V : Type uV) [AddCommGroup V] [Module ℂ V],
    ∀ (W : Type uW) [AddCommGroup W] [Module ℂ W],
    ∀ (ξ : Representation ℂ (mirabolic (m + 1) F) V)
      (ξ' : Representation ℂ (mirabolic (m + 1) F) W)
      (hs : IsSmooth ξ) (hs' : IsSmooth ξ'),
      Submodule.span ℂ (Set.range fun p : Mirabolic.radical (m + 1) F × V =>
        ξ (p.1 : mirabolic (m + 1) F) p.2 - p.2) = ⊤ →
      ∀ s : ℂ,
      ∀ β : InvariantBilinear.forms ξ ξ'
          (fun g => determinantWeight (normalizedAbsoluteValue T) g.val (-s)),
        β ≠ 0 →
        ∃ β' : InvariantBilinear.forms
            ((phiMinusUnnormalized T ψ m).obj (SmoothRep.of ξ hs)).representation
            ((phiMinusUnnormalized T ψ m).obj (SmoothRep.of ξ' hs')).representation
            (fun h => determinantWeight (normalizedAbsoluteValue T) h.val (-(s - 1))),
          β' ≠ 0

end Langlands.AllField.Derivative.Mirabolic
