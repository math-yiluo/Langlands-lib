open Langlands.QuotientIntegration
open scoped NNReal ENNReal

universe uF uV

variable (F : Type uF) [Field F] [TopologicalSpace F] [ValuativeRel F] [IsNonarchimedeanLocalField F]

local instance boxVolumeMeasurableSpace (n : ℕ) :
    MeasurableSpace (Langlands.GeneralLinear (n + 1) F) := borel _
local instance boxVolumeBorelSpace (n : ℕ) :
    BorelSpace (Langlands.GeneralLinear (n + 1) F) := ⟨rfl⟩

local instance boxVolumeUnipotentMeasurable (n : ℕ) :
    MeasurableSpace (upperUnipotent (n + 1) F) := borel _
local instance boxVolumeUnipotentBorel (n : ℕ) :
    BorelSpace (upperUnipotent (n + 1) F) := ⟨rfl⟩

/-- The exact product of the three finite box masses in the Iwasawa calculation. -/
def boxComparisonVolume (n : ℕ) (A q : ℤ) (a : ℕ) : ℝ :=
  ((generalLinearHaar F n).restrict
    (integralSubgroup (ValuativeRel.valuation F).integer n :
      Set (Langlands.GeneralLinear (n + 1) F))).real (boxSupport F A q a) *
    ((tailMeasure F n).real (torusBox F a) *
      (unipotentHaar F n).real (unipotentBox F q a))


end Langlands.AllField.RankinSelberg.RankOneBox
