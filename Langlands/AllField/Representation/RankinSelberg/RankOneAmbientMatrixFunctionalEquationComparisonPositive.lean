  let : NonarchimedeanRing F := by
    convert! ValuativeRel.nonarchimedeanRing F
    exact Valuation.toTopologicalSpace_eq _
  infer_instance
local instance ambientComparisonScalarMeasurable : MeasurableSpace F := borel _
local instance ambientComparisonScalarBorel : BorelSpace F := ⟨rfl⟩
local instance ambientComparisonGLMeasurable (n : ℕ) :
    MeasurableSpace (Langlands.GeneralLinear (n + 1) F) := borel _
local instance ambientComparisonGLBorel (n : ℕ) :
    BorelSpace (Langlands.GeneralLinear (n + 1) F) := ⟨rfl⟩
local instance ambientComparisonUnipotentMeasurable :
    MeasurableSpace (upperUnipotent (0 + 1) F) := borel _
local instance ambientComparisonUnipotentBorel :
    BorelSpace (upperUnipotent (0 + 1) F) := ⟨rfl⟩
local instance ambientComparisonQuotientMeasurable :
    MeasurableSpace (LeftUnipotentQuotient 0 F) := borel _
local instance ambientComparisonQuotientBorel :
    BorelSpace (LeftUnipotentQuotient 0 F) := ⟨rfl⟩

