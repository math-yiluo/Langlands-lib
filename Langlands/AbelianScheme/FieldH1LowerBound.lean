/-! # The local dimension of an abelian variety is bounded by its first-order Picard classes -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.AbelianScheme.FieldH1LowerBound

open Langlands.AlgebraicGeometry Langlands.AlgebraicGeometry.Picard
open Langlands.AlgebraicGeometry.Picard.PicardGroupoid
