set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {k : Type u} [Field k]

section Stalk

variable {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of k))
  (e : Spec (CommRingCat.of k) ⟶ X)

/-- The residue augmentation of the stalk at a rational point, for a `k`-algebra structure
on the stalk compatible with the structure morphism. -/
def stalkAugmentation (he : e ≫ f = 𝟙 _)
    [Algebra k (X.presheaf.stalk (e (IsLocalRing.closedPoint k)))]
    (hO : Spec.map (CommRingCat.ofHom
        (algebraMap k (X.presheaf.stalk (e (IsLocalRing.closedPoint k))))) =
      X.fromSpecStalk _ ≫ f) :
    X.presheaf.stalk (e (IsLocalRing.closedPoint k)) →ₐ[k] k where
  toRingHom := (Scheme.stalkClosedPointTo e).hom
  commutes' r := by
    have h : Spec.map (Scheme.stalkClosedPointTo e) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap k (X.presheaf.stalk (e (IsLocalRing.closedPoint k))))) =
          𝟙 _ := by
      rw [hO, Scheme.Spec_stalkClosedPointTo_fromSpecStalk_assoc, he]
    rw [← Spec.map_comp, ← Spec.map_id] at h
    exact congrArg (fun φ : CommRingCat.of k ⟶ CommRingCat.of k ↦ φ.hom r)
      (Spec.map_injective h)

lemma stalkAugmentation_surjective (he : e ≫ f = 𝟙 _)
    [Algebra k (X.presheaf.stalk (e (IsLocalRing.closedPoint k)))]
    (hO : Spec.map (CommRingCat.ofHom
        (algebraMap k (X.presheaf.stalk (e (IsLocalRing.closedPoint k))))) =
      X.fromSpecStalk _ ≫ f) :
    Function.Surjective (stalkAugmentation f e he hO) := fun r ↦
  ⟨algebraMap k _ r, (stalkAugmentation f e he hO).commutes r⟩

end Stalk

section Hull

open FieldMinimalPicardHull ArtinianChartVersality AffineQuotientTests

variable {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f] [Flat f]

/-- The trivial line bundle on the residue fibre. -/
abbrev residueTrivial : LineBundle ((relativeSpace f).obj (ArtinianTest.residueBase k k)) :=
  LineBundle.trivial _

/-- A relative line-bundle class on an Artinian test, trivial on the residue fibre, becomes
trivial modulo an ideal of the test generated by one element of the augmentation ideal for
each basis vector of the first-order classes of the trivial bundle. -/
theorem exists_span_trivializing (T : ArtinianTest k k)
    (ℓ : Langlands.AlgebraicGeometry.Picard.Group ((relativeSpace f).obj (ArtinianTest.base T)))
    (hℓ : Langlands.AlgebraicGeometry.Picard.Group.pullback
      ((relativeSpace f).map (ArtinianTest.reduction T)) ℓ = 0) :
    ∃ (b : Index f (residueTrivial f) → T.algebra)
      (hJ : Ideal.span (Set.range b) ≤ RingHom.ker T.augmentation.toRingHom),
      Langlands.AlgebraicGeometry.Picard.Group.pullback ((relativeSpace f).map
        (ArtinianTest.baseMap (ArtinianTest.quotientMap T _ hJ))) ℓ = 0 := by
  set M₀ := residueTrivial f
  obtain ⟨L, hL⟩ := RelativePicard.exists_representative f (ArtinianTest.base T) ℓ
  have he : Nonempty (residueBundle f (hullBundle f M₀) (hullPoint f M₀) ≅
      (LineBundle.pullback ((relativeSpace f).map (ArtinianTest.reduction T))).obj L) := by
    have h₁ : (residueBundle f (hullBundle f M₀) (hullPoint f M₀)).classOf = 0 := by
      rw [(LineBundle.classOf_eq_iff_iso _ M₀).2 ⟨hullResidueIso f M₀⟩]
      exact LineBundle.classOf_trivial _
    have h₂ : ((LineBundle.pullback ((relativeSpace f).map (ArtinianTest.reduction T))).obj
        L).classOf = 0 := by
      rw [← Langlands.AlgebraicGeometry.Picard.Group.pullback_lineBundle_classOf]
      change Langlands.AlgebraicGeometry.Picard.Group.pullback _
        (RelativePicard.classOf f _ L) = 0
      rw [hL, hℓ]
    exact (LineBundle.classOf_eq_iff_iso _ _).1 (h₁.trans h₂.symm)
  let N := ArtinianTestDeformations.mk f (residueBundle f (hullBundle f M₀) (hullPoint f M₀))
    T L he.some
  obtain ⟨x, hred, -⟩ := exists_realization_point f (hullBundle f M₀) (hullPoint f M₀)
    (isFormallyVersalAt f M₀) T N
  have hx : RelativePicard.classOf f _
      ((LineBundle.pullback ((relativeSpace f).map x.1)).obj (hullBundle f M₀)) = ℓ := by
    rw [← hL]
    exact (RelativePicard.classOf_eq_iff_iso f _ _ _).2
      ⟨realizationIso f (hullBundle f M₀) (hullPoint f M₀) T N x⟩
  obtain ⟨ψ, hψ⟩ := exists_affineBaseMap_eq (R := k) (A := hullRing f M₀) (B := T.algebra) x.1
  have haug : T.augmentation.comp ψ = hullAugmentation f M₀ := by
    apply affineBaseMap_injective
    rw [affineBaseMap_comp, hψ]
    exact hred
  let b : Index f M₀ → T.algebra := fun i ↦ ψ (generator f M₀ i)
  have hJ : Ideal.span (Set.range b) ≤ RingHom.ker T.augmentation.toRingHom := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    change (T.augmentation.comp ψ) (generator f M₀ i) = 0
    rw [haug]
    exact hullAugmentation_generator f M₀ i
  refine ⟨b, hJ, ?_⟩
  have hconst := eq_constant_of_generator f M₀
    ((ArtinianTest.toAlgHom (ArtinianTest.quotientMap T _ hJ)).comp ψ)
    (by rw [← AlgHom.comp_assoc, ArtinianTest.augmentation_comp, haug])
    (fun i ↦ Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨i, rfl⟩))
  have hpt : ArtinianTest.baseMap (ArtinianTest.quotientMap T _ hJ) ≫ x.1 =
      affineBaseMap (Algebra.ofId k (ArtinianTest.quotient T _ hJ).algebra) ≫
        hullPoint f M₀ := by
    rw [← hψ]
    change affineBaseMap (ArtinianTest.toAlgHom (ArtinianTest.quotientMap T _ hJ)) ≫
      affineBaseMap ψ = _
    rw [← affineBaseMap_comp, hconst, affineBaseMap_comp]
    rfl
  have hres : Langlands.AlgebraicGeometry.Picard.Group.pullback
      ((relativeSpace f).map (hullPoint f M₀)) (hullBundle f M₀).classOf = 0 := by
    rw [Langlands.AlgebraicGeometry.Picard.Group.pullback_lineBundle_classOf]
    change (residueBundle f (hullBundle f M₀) (hullPoint f M₀)).classOf = 0
    rw [(LineBundle.classOf_eq_iff_iso _ M₀).2 ⟨hullResidueIso f M₀⟩]
    exact LineBundle.classOf_trivial _
  rw [← hx]
  change Langlands.AlgebraicGeometry.Picard.Group.pullback _
    ((LineBundle.pullback ((relativeSpace f).map x.1)).obj (hullBundle f M₀)).classOf = 0
  rw [← Langlands.AlgebraicGeometry.Picard.Group.pullback_lineBundle_classOf,
    ← AddMonoidHom.comp_apply, ← Langlands.AlgebraicGeometry.Picard.Group.pullback_comp,
    ← Functor.map_comp, hpt, Functor.map_comp,
    Langlands.AlgebraicGeometry.Picard.Group.pullback_comp, AddMonoidHom.comp_apply]
  exact (congrArg (fun q ↦ Langlands.AlgebraicGeometry.Picard.Group.pullback _ q) hres).trans
    (map_zero _)

end Hull

section Geometric

open FieldMinimalPicardHull ArtinianLocusStalk Langlands.RingTheory.LocalGeneratorsKrullDimension

variable (A : AbelianScheme (Spec (CommRingCat.of k)))

/-- The unit point of an abelian variety over a field. -/
abbrev unitPoint : A.X.left := unitSection A (IsLocalRing.closedPoint k)

/-- The `k`-algebra structure on the stalk at the unit point induced by the structure
morphism. -/
@[instance_reducible]
def stalkAlgebra : Algebra k (A.X.left.presheaf.stalk (unitPoint A)) :=
  (Spec.preimage (A.X.left.fromSpecStalk (unitPoint A) ≫ A.X.hom)).hom.toAlgebra

lemma spec_stalkAlgebra :
    letI := stalkAlgebra A
    Spec.map (CommRingCat.ofHom (algebraMap k (A.X.left.presheaf.stalk (unitPoint A)))) =
      A.X.left.fromSpecStalk (unitPoint A) ≫ A.X.hom := by
  let := stalkAlgebra A
  change Spec.map (CommRingCat.ofHom (Spec.preimage _).hom) = _
  rw [CommRingCat.ofHom_hom, Spec.map_preimage]

/-- The Krull dimension of the local ring at the unit point of an abelian variety is at most
the dimension of the first-order deformation classes of the trivial line bundle. -/
theorem ringKrullDim_stalk_le_card :
    ringKrullDim (A.X.left.presheaf.stalk (unitPoint A)) ≤
      Fintype.card (Index A.X.hom (residueTrivial A.X.hom)) := by
  let := stalkAlgebra A
  have : IsLocallyNoetherian A.X.left := LocallyOfFiniteType.isLocallyNoetherian A.X.hom
  let ε := stalkAugmentation A.X.hom (unitSection A) (unitSection_comp A) (spec_stalkAlgebra A)
  have hε : Function.Surjective ε := stalkAugmentation_surjective _ _ _ _
  obtain ⟨Q, Z, j, hj, hfin, hq1, hZ⟩ := FieldMumfordFiniteLocus.exists_finite_plain_locus k A
  have : IsLocallyArtinian Z := IsLocallyArtinian.of_locallyQuasiFinite (j ≫ A.X.hom)
  obtain ⟨c, hc⟩ := exists_uniform_pow_eq_bot j (unitPoint A)
  let T := LocalAdicArtinianTests.test ε hε c
  let π := LocalAdicArtinianTests.projection ε hε c
  let xT : ArtinianTest.base T ⟶ A.X := Over.homMk
    (Spec.map (CommRingCat.ofHom π.toRingHom) ≫ A.X.left.fromSpecStalk (unitPoint A)) (by
      change _ ≫ A.X.hom = Spec.map (CommRingCat.ofHom (algebraMap k T.algebra))
      rw [Category.assoc, ← spec_stalkAlgebra A, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2)
  have hred : ArtinianTest.reduction T ≫ xT = (1 : ArtinianTest.residueBase k k ⟶ A.X) := by
    let u : ArtinianTest.residueBase k k ⟶ Over.mk (𝟙 (Spec (CommRingCat.of k))) :=
      Over.homMk (ArtinianTest.residueBase k k).hom (Category.comp_id _)
    rw [← MonObj.comp_one u]
    apply Over.OverMorphism.ext
    change Spec.map (CommRingCat.ofHom T.augmentation.toRingHom) ≫
        Spec.map (CommRingCat.ofHom π.toRingHom) ≫ A.X.left.fromSpecStalk (unitPoint A) =
      Spec.map (CommRingCat.ofHom (algebraMap k k)) ≫ unitSection A
    have h2 : CommRingCat.ofHom π.toRingHom ≫ CommRingCat.ofHom T.augmentation.toRingHom =
        Scheme.stalkClosedPointTo (unitSection A) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_hom (Scheme.stalkClosedPointTo _)]
      congr 1
    rw [← Spec.map_comp_assoc, h2, Scheme.Spec_stalkClosedPointTo_fromSpecStalk,
      Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]
  let ℓ := Langlands.AlgebraicGeometry.Picard.Group.pullback ((relativeSpace A.X.hom).map xT) Q
  have hℓ : Langlands.AlgebraicGeometry.Picard.Group.pullback
      ((relativeSpace A.X.hom).map (ArtinianTest.reduction T)) ℓ = 0 := by
    change Langlands.AlgebraicGeometry.Picard.Group.pullback _
      (Langlands.AlgebraicGeometry.Picard.Group.pullback _ Q) = 0
    rw [← AddMonoidHom.comp_apply, ← Langlands.AlgebraicGeometry.Picard.Group.pullback_comp,
      ← Functor.map_comp, hred]
    exact hq1 _
  obtain ⟨b, hJ, h0⟩ := exists_span_trivializing A.X.hom T ℓ hℓ
  obtain ⟨g, hg⟩ := (hZ _ (ArtinianTest.baseMap (ArtinianTest.quotientMap T _ hJ) ≫ xT)).2 (by
    rw [Functor.map_comp, Langlands.AlgebraicGeometry.Picard.Group.pullback_comp,
      AddMonoidHom.comp_apply]
    exact h0)
  let ψ := (ArtinianTest.toAlgHom (ArtinianTest.quotientMap T _ hJ)).comp π
  have hψε : (ArtinianTest.quotient T _ hJ).augmentation.comp ψ = ε := by
    change ((ArtinianTest.quotient T _ hJ).augmentation.comp
      (ArtinianTest.toAlgHom (ArtinianTest.quotientMap T _ hJ))).comp π = ε
    rw [ArtinianTest.augmentation_comp]
    exact LocalAdicArtinianTests.augmentation_projection ε hε c
  have hloc : IsLocalHom ψ.toRingHom := by
    have : IsLocalHom
        ((ArtinianTest.quotient T _ hJ).augmentation.toRingHom.comp ψ.toRingHom) := by
      have h : (ArtinianTest.quotient T _ hJ).augmentation.toRingHom.comp ψ.toRingHom =
          (Scheme.stalkClosedPointTo (unitSection A)).hom :=
        congrArg AlgHom.toRingHom hψε
      rw [h]
      infer_instance
    exact isLocalHom_of_comp ψ.toRingHom (ArtinianTest.quotient T _ hJ).augmentation.toRingHom
  let φ : A.X.left.presheaf.stalk (unitPoint A) ⟶
      CommRingCat.of (ArtinianTest.quotient T _ hJ).algebra :=
    CommRingCat.ofHom ψ.toRingHom
  have : IsLocalHom φ.hom := hloc
  have hg' : g ≫ j = Spec.map φ ≫ A.X.left.fromSpecStalk (unitPoint A) := by
    rw [hg]
    change Spec.map (CommRingCat.ofHom
        (ArtinianTest.toAlgHom (ArtinianTest.quotientMap T _ hJ)).toRingHom) ≫
      Spec.map (CommRingCat.ofHom π.toRingHom) ≫ A.X.left.fromSpecStalk (unitPoint A) = _
    rw [← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
    rfl
  have hmem : ∀ a ∈ IsLocalRing.maximalIdeal (A.X.left.presheaf.stalk (unitPoint A)) ^ c,
      π a ∈ Ideal.span (Set.range b) := by
    intro a ha
    have h0 : Ideal.Quotient.mk (Ideal.span (Set.range b)) (π a) = 0 :=
      map_eq_zero_of_factor j c (unitPoint A) hc φ g hg' a ha
    exact Ideal.Quotient.eq_zero_iff_mem.1 h0
  choose b' hb' using fun i ↦ Ideal.Quotient.mk_surjective
    (I := IsLocalRing.maximalIdeal (A.X.left.presheaf.stalk (unitPoint A)) ^ (c + 1)) (b i)
  have hbm : ∀ i, b' i ∈ IsLocalRing.maximalIdeal (A.X.left.presheaf.stalk (unitPoint A)) := by
    intro i
    rw [← IsLocalRing.ker_eq_maximalIdeal ε.toRingHom hε, RingHom.mem_ker]
    have h := hJ (Ideal.subset_span ⟨i, rfl⟩)
    rw [RingHom.mem_ker, ← hb' i] at h
    change (T.augmentation.comp π) (b' i) = 0 at h
    rwa [LocalAdicArtinianTests.augmentation_projection ε hε c] at h
  refine ringKrullDim_le_card b' hbm c fun a ha ↦ ?_
  have hb : (Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (A.X.left.presheaf.stalk (unitPoint A)) ^ (c + 1))) ∘ b' = b :=
    funext hb'
  have h : Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (A.X.left.presheaf.stalk (unitPoint A)) ^ (c + 1)) a ∈
      Ideal.map (Ideal.Quotient.mk
        (IsLocalRing.maximalIdeal (A.X.left.presheaf.stalk (unitPoint A)) ^ (c + 1)))
        (Ideal.span (Set.range b')) := by
    rw [Ideal.map_span, ← Set.range_comp, hb]
    exact hmem a ha
  exact Ideal.mem_quotient_iff_mem_sup.1 h

/-- The stalk at the unit point has Krull dimension equal to the relative dimension. -/
theorem ringKrullDim_stalk_eq (g : ℕ) (hg : A.HasRelativeDimension g) :
    ringKrullDim (A.X.left.presheaf.stalk (unitPoint A)) = g :=
  fieldSmoothClosedPointStalkDimension k A.X.left A.X.hom g hg (unitPoint A)
    (isClosed_singleton_section_point A.X 1)

open ArtinianDualNumberComparison in
/-- The number of basis vectors of the first-order classes of the trivial bundle is the
dimension of the first structure-sheaf cohomology. -/
theorem card_index_eq_finrank :
    Fintype.card (Index A.X.hom (residueTrivial A.X.hom)) =
      Module.finrank k ((Modules.DerivedSections.relativeCohomology A.X.hom 1).obj
        (Langlands.Scheme.Modules.structureSheaf A.X.left)) := by
  rw [Fintype.card_ulift, Fintype.card_fin]
  have : CompactSpace (residueSpace (K := k) A.X.hom) :=
    QuasiCompact.compactSpace_of_compactSpace (residueStructure (K := k) A.X.hom)
  rw [(classH1LinearEquiv A.X.hom (residueTrivial A.X.hom)
    (Scheme.OrderedAffineCover.ofCompactSpace _)).finrank_eq]
  have hbase : (ArtinianTest.residueBase k k).hom = 𝟙 _ := by
    change Spec.map (CommRingCat.ofHom (algebraMap k k)) = _
    rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]
    rfl
  have : IsIso (ArtinianTest.residueBase k k).hom := by
    rw [hbase]
    infer_instance
  let e : residueSpace (K := k) A.X.hom ≅ A.X.left :=
    asIso (Limits.pullback.snd (ArtinianTest.residueBase k k).hom A.X.hom)
  have he : residueStructure (K := k) A.X.hom = e.hom ≫ A.X.hom := by
    change Limits.pullback.fst _ _ = Limits.pullback.snd _ _ ≫ A.X.hom
    rw [← Limits.pullback.condition]
    exact (Category.comp_id _).symm.trans
      (congrArg (Limits.pullback.fst (ArtinianTest.residueBase k k).hom A.X.hom ≫ ·) hbase.symm)
  have hiso : (Modules.DerivedSections.relativeCohomology (residueStructure (K := k) A.X.hom)
      1).obj (Langlands.Scheme.Modules.structureSheaf (residueSpace (K := k) A.X.hom)) ≅
      (Modules.DerivedSections.relativeCohomology A.X.hom 1).obj
        (Langlands.Scheme.Modules.structureSheaf A.X.left) := by
    rw [he]
    exact (Modules.DerivedSections.relativeCohomology (e.hom ≫ A.X.hom) 1).mapIso
        (Langlands.Scheme.Modules.pullbackUnitIso e.hom).symm ≪≫
      Modules.DerivedSections.relativeCohomologyPullbackIso e A.X.hom _ 1
  exact hiso.toLinearEquiv.finrank_eq

/-- The relative dimension of an abelian variety is at most the dimension of its first
structure-sheaf cohomology. -/
theorem le_finrank (g : ℕ) (hg : A.HasRelativeDimension g) :
    g ≤ Module.finrank k ((Modules.DerivedSections.relativeCohomology A.X.hom 1).obj
        (Langlands.Scheme.Modules.structureSheaf A.X.left)) := by
  have h := ringKrullDim_stalk_le_card A
  rw [ringKrullDim_stalk_eq A g hg, card_index_eq_finrank A] at h
  exact_mod_cast h

end Geometric

end Langlands.AbelianScheme.FieldH1LowerBound
