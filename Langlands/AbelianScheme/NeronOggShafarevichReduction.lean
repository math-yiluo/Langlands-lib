import Langlands.AbelianScheme.NeronOggShafarevichStatement
import Langlands.AbelianScheme.NeronModelExistenceStatement
import Langlands.AbelianScheme.StrictHenselianRationalTorsionGoodReductionStatement
import Langlands.CommutativeAlgebra.UnramifiedStrictHenselianDvrExtension
import Langlands.AbelianScheme.Tate.TrivialMonodromyRationalTorsion

/-! # The Néron–Ogg–Shafarevich criterion from Néron models and the torsion criterion -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry IsLocalRing
open Langlands.AlgebraicGeometry.FiniteEtale

namespace Langlands.AbelianScheme

/-- Existence of Néron models and the criterion that rationality of all prime-power
torsion over the fraction field of a strictly Henselian discrete valuation ring `W`
over `V`, whose maximal ideal is generated by that of `V` and whose residue extension is
separable, makes the Néron model an abelian scheme together imply the
Néron–Ogg–Shafarevich criterion. -/
def NeronOggShafarevichReductionStatement : Prop :=
  NeronModelExistenceStatement.{u} →
  StrictHenselianRationalTorsionGoodReductionStatement.{u} →
  NeronOggShafarevichStatement.{u}

/-- A local homomorphism of discrete valuation rings carrying the maximal ideal onto a
generator of the maximal ideal is injective. -/
theorem injective_algebraMap_of_map_maximalIdeal {V W : Type u} [CommRing V] [IsDomain V]
    [IsDiscreteValuationRing V] [CommRing W] [IsDomain W] [IsDiscreteValuationRing W]
    [Algebra V W] (hmax : (maximalIdeal V).map (algebraMap V W) = maximalIdeal W) :
    Function.Injective (algebraMap V W) := by
  rw [injective_iff_map_eq_zero]
  intro v hv
  by_contra hv0
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible V
  obtain ⟨n, c, hvc⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hv0 hϖ
  have hϖ0 : algebraMap V W ϖ = 0 := by
    rw [hvc, map_mul, map_pow] at hv
    have hc : IsUnit (algebraMap V W (c : V)) := c.isUnit.map _
    exact pow_eq_zero_iff'.mp ((hc.mul_right_eq_zero).mp hv) |>.1
  apply IsDiscreteValuationRing.not_a_field W
  rw [← hmax, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton, hϖ0,
    Ideal.span_singleton_eq_bot]

/-- The Néron–Ogg–Shafarevich criterion follows from the two inputs. -/
theorem neronOggShafarevichReduction : NeronOggShafarevichReductionStatement.{u} := by
  intro hNeron hTors V K _ _ _ _ _ _ B ℓ _ hℓ hyp
  obtain ⟨W, _, _, _, _, _, _, _, hmax, hsep⟩ :=
    CommutativeAlgebra.unramifiedStrictHenselianDvrExtension.{u} V
  let L := FractionRing W
  have hinj : Function.Injective ((algebraMap W L).comp (algebraMap V W)) :=
    (IsFractionRing.injective W L).comp (injective_algebraMap_of_map_maximalIdeal hmax)
  let : Algebra K L := (IsFractionRing.lift (K := K) hinj).toAlgebra
  have hcomm : (algebraMap W L).comp (algebraMap V W) =
      (algebraMap K L).comp (algebraMap V K) := by
    ext v
    exact (IsFractionRing.lift_algebraMap (K := K) hinj v).symm
  have huL : ∀ m : ℕ, IsUnit ((ℓ ^ m : ℕ) : Γ(Spec (.of L), ⊤)) := by
    intro m
    have h1 := (hℓ.pow m).map
      ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom.comp
        ((algebraMap W L).comp (algebraMap V W)))
    simpa only [RingHom.coe_comp, Function.comp_apply, map_pow, map_natCast,
      Nat.cast_pow] using h1
  have htriv := hyp W hmax L hcomm (AlgebraicClosure L)
    (Spec.algebraMap L (AlgebraicClosure L)) huL
  have htors : ∀ ν : ℕ,
      HasRationalGeometricTorsion ((baseChange (Spec.algebraMap K L)).obj B) (ℓ ^ ν) :=
    fun ν => Tate.PrimeAdic.hasRationalGeometricTorsion_of_rationalMonodromy_eq_one
      ((baseChange (Spec.algebraMap K L)).obj B) ℓ huL htriv ν
  obtain ⟨N⟩ := hNeron V K B
  obtain ⟨hprop, hconn⟩ :=
    hTors V K B N W hmax hsep L hcomm ℓ (Fact.out : ℓ.Prime) hℓ htors
  exact ⟨N.toAbelianScheme hprop hconn, ⟨(N.toAbelianSchemeGenericIso hprop hconn).symm⟩⟩

end Langlands.AbelianScheme
