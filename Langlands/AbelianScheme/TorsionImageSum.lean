import Langlands.AbelianScheme.TorsionFunctor
import Langlands.AbelianScheme.FiniteEtaleQuotient
import Langlands.GroupScheme.FiniteEtaleSum

/-! # The finite étale sum of endomorphism images on torsion -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.AbelianScheme.FiniteEtaleSubgroup.TorsionImageSum

variable {S : Scheme.{u}} {I : Type u} [Fintype I]
  (A : AbelianScheme S) (n : ℤ) (f : I → End A)

/-- Restrict every endomorphism to the actual integer torsion scheme. -/
abbrev maps (i : I) : GroupScheme.torsion A.toGrp n ⟶ GroupScheme.torsion A.toGrp n :=
  GroupScheme.torsionMap (groupHom (f i)) n

variable [IsFinite (GroupScheme.torsion A.toGrp n).X.hom]
  [Etale (GroupScheme.torsion A.toGrp n).X.hom]

/-- The actual finite étale closed subgroup generated by the endomorphism images of
`A[n]`, retaining its inclusion into `A`. -/
def subgroup : FiniteEtaleSubgroup A where
  G := { toGrp := GroupScheme.FiniteEtaleSum.image (maps A n f) }
  inclusion := Additive.ofMul
    (GroupScheme.FiniteEtaleSum.inclusion (maps A n f) ≫ GroupScheme.torsionι A.toGrp n)
  isClosedImmersion := by
    change IsClosedImmersion
      ((GroupScheme.FiniteEtaleSum.inclusion (maps A n f)).hom.hom.left ≫
        (GroupScheme.torsionι A.toGrp n).hom.hom.left)
    infer_instance
  isFinite := inferInstance
  etale := inferInstance

/-- Each restricted endomorphism maps into the actual sum subgroup. -/
def component (i : I) :
    (CommGroupScheme.torsionFunctor n).obj A.toCommGroupScheme ⟶ (subgroup A n f).G :=
  Additive.ofMul (GroupScheme.FiniteEtaleSum.component (maps A n f) i)

@[reassoc (attr := simp)]
theorem component_inclusion (i : I) :
    component A n f i ≫ (subgroup A n f).inclusion =
      (CommGroupScheme.torsionInclusion n).app A.toCommGroupScheme ≫ commHom (f i) := by
  change Additive.ofMul
    (GroupScheme.FiniteEtaleSum.component (maps A n f) i ≫
      (GroupScheme.FiniteEtaleSum.inclusion (maps A n f) ≫ GroupScheme.torsionι A.toGrp n)) =
    Additive.ofMul (GroupScheme.torsionι A.toGrp n ≫ groupHom (f i))
  congr 1
  rw [← Category.assoc, GroupScheme.FiniteEtaleSum.component_inclusion,
    GroupScheme.torsionMap_ι]

/-- A map kills the sum subgroup precisely when it kills every restricted image. -/
theorem inclusion_comp_eq_zero_iff {H : CommGroupScheme S}
    (g : A.toCommGroupScheme ⟶ H) :
    (subgroup A n f).inclusion ≫ g = 0 ↔
      ∀ i, (CommGroupScheme.torsionInclusion n).app A.toCommGroupScheme ≫
        commHom (f i) ≫ g = 0 := by
  change
    (GroupScheme.FiniteEtaleSum.inclusion (maps A n f) ≫
        GroupScheme.torsionι A.toGrp n) ≫ CommGroupScheme.groupHom g = 1 ↔
      ∀ i, GroupScheme.torsionι A.toGrp n ≫
        groupHom (f i) ≫ CommGroupScheme.groupHom g = 1
  simpa only [maps, ← Category.assoc, GroupScheme.torsionMap_ι] using
    (GroupScheme.FiniteEtaleSum.inclusion_comp_eq_one_iff (maps A n f)
      (GroupScheme.torsionι A.toGrp n ≫ CommGroupScheme.groupHom g))

/-- Multiplication by the defining integer kills the subgroup inclusion. -/
@[simp]
theorem inclusion_zsmul :
    (subgroup A n f).inclusion ≫ (n • (𝟙 A.toCommGroupScheme)) = 0 := by
  change
    (GroupScheme.FiniteEtaleSum.inclusion (maps A n f) ≫
        GroupScheme.torsionι A.toGrp n) ≫ GroupScheme.multiplication A.toGrp n = 1
  rw [Category.assoc, GroupScheme.torsionι_multiplication, MonObj.comp_one]

end Langlands.AbelianScheme.FiniteEtaleSubgroup.TorsionImageSum
