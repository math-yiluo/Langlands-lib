import Langlands.GroupScheme.CorepresentedAffineComparison
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.AlgebraicGeometry.Morphisms.Affine

/-! # The general linear group scheme from explicit matrix coordinates -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry MvPolynomial CategoryTheory.MonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.GeneralLinear

/-- The polynomial variables: the entries of a matrix and the entries of its inverse. -/
inductive Coordinate (n : Type) : Type
  | entry : n → n → Coordinate n
  | inverseEntry : n → n → Coordinate n

section Algebra

variable (n : Type) [Fintype n] [DecidableEq n] (R : Type u) [CommRing R]

/-- The generic matrix whose `(i, j)` entry is the variable `entry i j`. -/
def genericMatrix : Matrix n n (MvPolynomial (Coordinate n) R) :=
  Matrix.of fun i j => X (Coordinate.entry i j)

/-- The generic matrix whose `(i, j)` entry is the variable `inverseEntry i j`. -/
def genericInverse : Matrix n n (MvPolynomial (Coordinate n) R) :=
  Matrix.of fun i j => X (Coordinate.inverseEntry i j)

/-- The entries of `X Y - 1` and `Y X - 1` for the two generic matrices. -/
def relations : Set (MvPolynomial (Coordinate n) R) :=
  Set.range (fun p : n × n => (genericMatrix n R * genericInverse n R - 1) p.1 p.2) ∪
    Set.range (fun p : n × n => (genericInverse n R * genericMatrix n R - 1) p.1 p.2)

/-- The ideal generated by the two matrix inverse equations. -/
def ideal : Ideal (MvPolynomial (Coordinate n) R) :=
  Ideal.span (relations n R)

/-- The coordinate ring of the general linear group. -/
abbrev CoordinateRing : Type u :=
  MvPolynomial (Coordinate n) R ⧸ ideal n R

/-- The quotient map from the polynomial ring to the coordinate ring. -/
abbrev quotient : MvPolynomial (Coordinate n) R →ₐ[R] CoordinateRing n R :=
  Ideal.Quotient.mkₐ R (ideal n R)

variable {n R}

/-- A polynomial map kills the ideal once its generic matrices are mutually inverse. -/
theorem ideal_le_ker {S : Type u} [CommRing S] [Algebra R S]
    (ψ : MvPolynomial (Coordinate n) R →ₐ[R] S)
    (h₁ : ψ.mapMatrix (genericMatrix n R) * ψ.mapMatrix (genericInverse n R) = 1)
    (h₂ : ψ.mapMatrix (genericInverse n R) * ψ.mapMatrix (genericMatrix n R) = 1) :
    ideal n R ≤ RingHom.ker ψ := by
  refine Ideal.span_le.mpr ?_
  rintro _ (⟨⟨i, j⟩, rfl⟩ | ⟨⟨i, j⟩, rfl⟩) <;> simp only [SetLike.mem_coe, RingHom.mem_ker]
  · change ψ.mapMatrix (genericMatrix n R * genericInverse n R - 1) i j = 0
    rw [map_sub, map_mul, map_one, h₁, sub_self, Matrix.zero_apply]
  · change ψ.mapMatrix (genericInverse n R * genericMatrix n R - 1) i j = 0
    rw [map_sub, map_mul, map_one, h₂, sub_self, Matrix.zero_apply]

variable (n R)

theorem quotient_mapMatrix_mul_inverse :
    (quotient n R).mapMatrix (genericMatrix n R) *
      (quotient n R).mapMatrix (genericInverse n R) = 1 := by
  have h : (quotient n R).mapMatrix (genericMatrix n R * genericInverse n R - 1) = 0 := by
    ext i j
    rw [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.zero_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Or.inl ⟨(i, j), rfl⟩)
  rwa [map_sub, map_mul, map_one, sub_eq_zero] at h

theorem quotient_mapMatrix_inverse_mul :
    (quotient n R).mapMatrix (genericInverse n R) *
      (quotient n R).mapMatrix (genericMatrix n R) = 1 := by
  have h : (quotient n R).mapMatrix (genericInverse n R * genericMatrix n R - 1) = 0 := by
    ext i j
    rw [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.zero_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Or.inr ⟨(i, j), rfl⟩)
  rwa [map_sub, map_mul, map_one, sub_eq_zero] at h

/-- The universal invertible matrix over the coordinate ring. -/
def universal : GL n (CoordinateRing n R) where
  val := (quotient n R).mapMatrix (genericMatrix n R)
  inv := (quotient n R).mapMatrix (genericInverse n R)
  val_inv := quotient_mapMatrix_mul_inverse n R
  inv_val := quotient_mapMatrix_inverse_mul n R

@[simp] theorem universal_apply (i j : n) :
    universal n R i j = quotient n R (X (Coordinate.entry i j)) := rfl

@[simp] theorem universal_inv_apply (i j : n) :
    (universal n R)⁻¹ i j = quotient n R (X (Coordinate.inverseEntry i j)) := rfl

variable {n R} {S T : Type u} [CommRing S] [Algebra R S] [CommRing T] [Algebra R T]

/-- The invertible matrix obtained by specializing the universal one along an algebra map. -/
def point (f : CoordinateRing n R →ₐ[R] S) : GL n S :=
  Matrix.GeneralLinearGroup.map f.toRingHom (universal n R)

@[simp] theorem point_apply (f : CoordinateRing n R →ₐ[R] S) (i j : n) :
    point f i j = f (quotient n R (X (Coordinate.entry i j))) := rfl

@[simp] theorem point_inv_apply (f : CoordinateRing n R →ₐ[R] S) (i j : n) :
    (point f)⁻¹ i j = f (quotient n R (X (Coordinate.inverseEntry i j))) := rfl

/-- Specialization is natural in the target algebra. -/
theorem point_comp (f : CoordinateRing n R →ₐ[R] S) (g : S →ₐ[R] T) :
    point (g.comp f) = Matrix.GeneralLinearGroup.map g.toRingHom (point f) := rfl

@[simp] theorem point_id : point (AlgHom.id R (CoordinateRing n R)) = universal n R := rfl

/-- The values of the variables at an invertible matrix: its entries and those of its inverse. -/
def values (g : GL n S) : Coordinate n → S
  | .entry i j => g i j
  | .inverseEntry i j => g⁻¹ i j

theorem aeval_mapMatrix_genericMatrix (g : GL n S) :
    (aeval (R := R) (values g)).mapMatrix (genericMatrix n R) = (g : Matrix n n S) := by
  ext i j
  simp [genericMatrix, values]

theorem aeval_mapMatrix_genericInverse (g : GL n S) :
    (aeval (R := R) (values g)).mapMatrix (genericInverse n R) =
      ((g⁻¹ : GL n S) : Matrix n n S) := by
  ext i j
  simp [genericInverse, values]

/-- The algebra map from the coordinate ring classifying an invertible matrix. -/
def classify (g : GL n S) : CoordinateRing n R →ₐ[R] S :=
  Ideal.Quotient.liftₐ _ (aeval (values g)) fun _ ha =>
    RingHom.mem_ker.mp <| ideal_le_ker _
      (by rw [aeval_mapMatrix_genericMatrix, aeval_mapMatrix_genericInverse]; exact g.mul_inv)
      (by rw [aeval_mapMatrix_genericMatrix, aeval_mapMatrix_genericInverse]; exact g.inv_mul)
      ha

theorem classify_comp_quotient (g : GL n S) :
    (classify (R := R) g).comp (quotient n R) = aeval (values g) :=
  Ideal.Quotient.liftₐ_comp _ _ _

@[simp] theorem classify_quotient (g : GL n S) (p : MvPolynomial (Coordinate n) R) :
    classify g (quotient n R p) = aeval (values g) p :=
  AlgHom.congr_fun (classify_comp_quotient g) p

@[simp] theorem classify_entry (g : GL n S) (i j : n) :
    classify (R := R) g (quotient n R (X (Coordinate.entry i j))) = g i j := by
  rw [classify_quotient, aeval_X]
  rfl

@[simp] theorem classify_inverseEntry (g : GL n S) (i j : n) :
    classify (R := R) g (quotient n R (X (Coordinate.inverseEntry i j))) = g⁻¹ i j := by
  rw [classify_quotient, aeval_X]
  rfl

/-- Algebra maps out of the coordinate ring are exactly the invertible matrices. -/
def homEquiv : (CoordinateRing n R →ₐ[R] S) ≃ GL n S where
  toFun := point
  invFun := classify
  left_inv f := by
    apply Ideal.Quotient.algHom_ext
    apply MvPolynomial.algHom_ext
    intro v
    rw [AlgHom.comp_apply, AlgHom.comp_apply, classify_quotient, aeval_X]
    cases v <;> rfl
  right_inv g := by
    apply Units.ext
    ext i j
    exact classify_entry g i j

@[simp] theorem classify_point (f : CoordinateRing n R →ₐ[R] S) : classify (point f) = f :=
  homEquiv.left_inv f

@[simp] theorem point_classify (g : GL n S) : point (classify (R := R) g) = g :=
  homEquiv.right_inv g

/-- The classifying map is natural in the target algebra. -/
theorem classify_map (g : GL n S) (h : S →ₐ[R] T) :
    classify (Matrix.GeneralLinearGroup.map h.toRingHom g) = h.comp (classify (R := R) g) := by
  apply homEquiv.injective
  change point _ = point _
  rw [point_comp, point_classify, point_classify]

@[simp] theorem classify_universal :
    classify (universal n R) = AlgHom.id R (CoordinateRing n R) := by
  rw [← point_id, classify_point]

end Algebra

section Scheme

variable (n : Type) [Fintype n] [DecidableEq n] (R : CommRingCat.{u})

/-- The functor of invertible matrices, with coefficient change applied entrywise. -/
def functor : CommAlgCat.{u} R ⥤ GrpCat.{u} where
  obj S := GrpCat.of (GL n S)
  map f := GrpCat.ofHom (Matrix.GeneralLinearGroup.map f.hom.toRingHom)
  map_id _ := rfl
  map_comp _ _ := rfl

@[simp] theorem functor_obj (S : CommAlgCat.{u} R) : (functor n R).obj S = GrpCat.of (GL n S) :=
  rfl

theorem functor_map_apply {S T : CommAlgCat.{u} R} (f : S ⟶ T) (g : GL n S) :
    (functor n R).map f g = Matrix.GeneralLinearGroup.map f.hom.toRingHom g := rfl

/-- The coordinate ring as an object of commutative `R`-algebras. -/
abbrev coordinateAlgebra : CommAlgCat.{u} R := CommAlgCat.of R (CoordinateRing n R)

/-- The coordinate ring corepresents the functor of invertible matrices. -/
def corepresentableBy :
    (functor n R ⋙ forget GrpCat).CorepresentableBy (coordinateAlgebra n R) where
  homEquiv :=
    { toFun := fun f => point f.hom
      invFun := fun g => CommAlgCat.ofHom (classify g)
      left_inv := fun f => CommAlgCat.hom_ext (classify_point f.hom)
      right_inv := fun g => point_classify g }
  homEquiv_comp g f := point_comp f.hom g.hom

theorem corepresentableBy_homEquiv {S : CommAlgCat.{u} R} (f : coordinateAlgebra n R ⟶ S) :
    (corepresentableBy n R).homEquiv f = point f.hom := rfl

theorem corepresentableBy_homEquiv_symm {S : CommAlgCat.{u} R} (g : GL n S) :
    (corepresentableBy n R).homEquiv.symm g = CommAlgCat.ofHom (classify g) := rfl

/-- The general linear group scheme over `Spec R`, as the spectrum of the coordinate ring. -/
abbrev groupScheme : GroupScheme (Spec R) :=
  Corepresented.groupScheme (functor n R) (corepresentableBy n R)

@[simp] theorem groupScheme_X :
    (groupScheme n R).X = (algSpec R).obj (op (coordinateAlgebra n R)) := rfl

theorem groupScheme_left :
    (groupScheme n R).X.left = Spec (CommRingCat.of (CoordinateRing n R)) := rfl

theorem groupScheme_hom :
    (groupScheme n R).X.hom =
      Spec.map (CommRingCat.ofHom (algebraMap R (CoordinateRing n R))) := rfl

instance isAffine_groupScheme : IsAffine (groupScheme n R).X.left :=
  inferInstanceAs (IsAffine (Spec (CommRingCat.of (CoordinateRing n R))))

instance isAffineHom_groupScheme : IsAffineHom (groupScheme n R).X.hom :=
  isAffineHom_of_isAffine _

/-- The global coordinate function on the general linear group giving the `(i, j)` entry. -/
def entrySection (i j : n) : Γ((groupScheme n R).X.left, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of (CoordinateRing n R))).inv
    (quotient n R (X (Coordinate.entry i j)))

/-- The global coordinate function giving the `(i, j)` entry of the inverse matrix. -/
def inverseEntrySection (i j : n) : Γ((groupScheme n R).X.left, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of (CoordinateRing n R))).inv
    (quotient n R (X (Coordinate.inverseEntry i j)))

end Scheme

section Points

variable (n : Type) [Fintype n] [DecidableEq n] (R : CommRingCat.{u})

/-- Points on every test scheme over `Spec R` are invertible matrices over its global
sections. -/
def pointsEquiv (T : Over (Spec R)) : (T ⟶ (groupScheme n R).X) ≃* GL n Γ(T.left, ⊤) :=
  Corepresented.pointsEquiv (functor n R) (corepresentableBy n R) T

variable {n R}

/-- The point comparison specializes the universal matrix along the algebra map supplied by
the relative `Spec`/`Γ` adjunction. -/
theorem pointsEquiv_apply (T : Over (Spec R)) (x : T ⟶ (groupScheme n R).X) :
    pointsEquiv n R T x =
      point (((algΓAlgSpecAdjunction R).homEquiv T (op (coordinateAlgebra n R))).symm x).unop.hom :=
  rfl

/-- The adjoint algebra map is pullback of global functions along the point. -/
theorem adjunction_homEquiv_symm_apply (T : Over (Spec R)) (x : T ⟶ (groupScheme n R).X)
    (b : CoordinateRing n R) :
    (((algΓAlgSpecAdjunction R).homEquiv T (op (coordinateAlgebra n R))).symm x).unop.hom b =
      x.left.appTop ((Scheme.ΓSpecIso (CommRingCat.of (CoordinateRing n R))).inv b) := by
  change T ⟶ (algSpec R).obj (op (coordinateAlgebra n R)) at x
  rw [Adjunction.homEquiv_counit]
  rfl

/-- The `(i, j)` entry of a point is the pullback of the `(i, j)` coordinate function. -/
theorem pointsEquiv_apply_apply (T : Over (Spec R)) (x : T ⟶ (groupScheme n R).X) (i j : n) :
    pointsEquiv n R T x i j = x.left.appTop (entrySection n R i j) :=
  adjunction_homEquiv_symm_apply T x _

/-- The `(i, j)` entry of the inverse of a point is the pullback of the corresponding
inverse coordinate function. -/
theorem pointsEquiv_inv_apply (T : Over (Spec R)) (x : T ⟶ (groupScheme n R).X) (i j : n) :
    (pointsEquiv n R T x)⁻¹ i j = x.left.appTop (inverseEntrySection n R i j) :=
  adjunction_homEquiv_symm_apply T x _

/-- Points are determined by their matrix entries. -/
theorem points_ext {T : Over (Spec R)} {x y : T ⟶ (groupScheme n R).X}
    (h : ∀ i j, pointsEquiv n R T x i j = pointsEquiv n R T y i j) : x = y :=
  (pointsEquiv n R T).injective (Units.ext (Matrix.ext h))

/-- The point with prescribed matrix is the adjoint of its classifying algebra map. -/
theorem pointsEquiv_symm_apply (T : Over (Spec R)) (g : GL n Γ(T.left, ⊤)) :
    (pointsEquiv n R T).symm g =
      (algΓAlgSpecAdjunction R).homEquiv T (op (coordinateAlgebra n R))
        (CommAlgCat.ofHom (classify (S := ((algΓ R).obj T).unop) g)).op := by
  apply (pointsEquiv n R T).injective
  rw [MulEquiv.apply_symm_apply]
  have h := pointsEquiv_apply (n := n) T ((algΓAlgSpecAdjunction R).homEquiv T
    (op (coordinateAlgebra n R)) (CommAlgCat.ofHom (classify (S := ((algΓ R).obj T).unop) g)).op)
  have h' := congrArg (fun f : (algΓ R).obj T ⟶ op (coordinateAlgebra n R) => point f.unop.hom)
    (((algΓAlgSpecAdjunction R).homEquiv T (op (coordinateAlgebra n R))).symm_apply_apply
      (CommAlgCat.ofHom (classify (S := ((algΓ R).obj T).unop) g)).op)
  have h'' : point (classify (R := R) (S := ((algΓ R).obj T).unop) g) = g := point_classify _
  exact (h.trans (h'.trans h'')).symm

/-- Restriction of points along a test-scheme map applies the pullback of global sections to
every entry. -/
theorem pointsEquiv_naturality {T T' : Over (Spec R)} (a : T' ⟶ T)
    (x : T ⟶ (groupScheme n R).X) :
    pointsEquiv n R T' (a ≫ x) =
      Matrix.GeneralLinearGroup.map a.left.appTop.hom (pointsEquiv n R T x) :=
  Corepresented.pointsEquiv_naturality _ _ a x

/-- Restriction of points acts entrywise. -/
theorem pointsEquiv_comp_apply {T T' : Over (Spec R)} (a : T' ⟶ T)
    (x : T ⟶ (groupScheme n R).X) (i j : n) :
    pointsEquiv n R T' (a ≫ x) i j = a.left.appTop (pointsEquiv n R T x i j) := by
  rw [pointsEquiv_naturality]
  rfl

/-- The group law on points is matrix multiplication. -/
@[simp] theorem pointsEquiv_mul (T : Over (Spec R)) (x y : T ⟶ (groupScheme n R).X) :
    pointsEquiv n R T (x * y) = pointsEquiv n R T x * pointsEquiv n R T y :=
  map_mul _ _ _

/-- The identity point is the identity matrix. -/
@[simp] theorem pointsEquiv_one (T : Over (Spec R)) :
    pointsEquiv n R T 1 = 1 :=
  map_one _

/-- Inversion of points is matrix inversion. -/
@[simp] theorem pointsEquiv_inv (T : Over (Spec R)) (x : T ⟶ (groupScheme n R).X) :
    pointsEquiv n R T x⁻¹ = (pointsEquiv n R T x)⁻¹ :=
  map_inv _ _

/-- Composing a pair of points with the multiplication morphism multiplies their matrices. -/
theorem pointsEquiv_lift_μ (T : Over (Spec R)) (x y : T ⟶ (groupScheme n R).X) :
    pointsEquiv n R T (CartesianMonoidalCategory.lift x y ≫ μ[(groupScheme n R).X]) =
      pointsEquiv n R T x * pointsEquiv n R T y := by
  rw [← pointsEquiv_mul, CategoryTheory.Hom.mul_def]

/-- The unit morphism gives the identity matrix. -/
theorem pointsEquiv_toUnit_η (T : Over (Spec R)) :
    pointsEquiv n R T (CartesianMonoidalCategory.toUnit T ≫ η[(groupScheme n R).X]) = 1 := by
  rw [← pointsEquiv_one, CategoryTheory.Hom.one_def]

/-- Composing a point with the inversion morphism inverts its matrix. -/
theorem pointsEquiv_comp_ι (T : Over (Spec R)) (x : T ⟶ (groupScheme n R).X) :
    pointsEquiv n R T (x ≫ ι[(groupScheme n R).X]) = (pointsEquiv n R T x)⁻¹ := by
  rw [← pointsEquiv_inv, CategoryTheory.Hom.inv_def]

/-- The multiplication morphism multiplies the matrices of the two projections. -/
theorem pointsEquiv_μ :
    pointsEquiv n R ((groupScheme n R).X ⊗ (groupScheme n R).X) μ[(groupScheme n R).X] =
      pointsEquiv n R _ (CartesianMonoidalCategory.fst (groupScheme n R).X (groupScheme n R).X) *
        pointsEquiv n R _
          (CartesianMonoidalCategory.snd (groupScheme n R).X (groupScheme n R).X) := by
  rw [← pointsEquiv_mul, CategoryTheory.Hom.mul_def, CartesianMonoidalCategory.lift_fst_snd,
    Category.id_comp]

/-- The identity point of the group scheme is the matrix of coordinate functions. -/
theorem pointsEquiv_id_apply (i j : n) :
    pointsEquiv n R (groupScheme n R).X (𝟙 _) i j = entrySection n R i j := by
  rw [pointsEquiv_apply_apply]
  rfl

/-- The inverse of the identity point is the matrix of inverse coordinate functions. -/
theorem pointsEquiv_id_inv_apply (i j : n) :
    (pointsEquiv n R (groupScheme n R).X (𝟙 _))⁻¹ i j = inverseEntrySection n R i j := by
  rw [pointsEquiv_inv_apply]
  rfl

variable (n R) in
/-- Points on affine test schemes are invertible matrices over the test algebra. -/
def affinePointsEquiv (S : CommAlgCat.{u} R) :
    ((algSpec R).obj (op S) ⟶ (groupScheme n R).X) ≃* GL n S :=
  Corepresented.affinePointsEquiv (functor n R) (corepresentableBy n R) S

/-- The spectrum of an algebra map out of the coordinate ring is the specialized matrix. -/
@[simp] theorem affinePointsEquiv_map (S : CommAlgCat.{u} R) (f : coordinateAlgebra n R ⟶ S) :
    affinePointsEquiv n R S ((algSpec R).map f.op) = point f.hom :=
  Corepresented.affinePointsEquiv_map _ _ S f

/-- The affine point with prescribed matrix is the spectrum of its classifying map. -/
theorem affinePointsEquiv_symm_apply (S : CommAlgCat.{u} R) (g : GL n S) :
    (affinePointsEquiv n R S).symm g = (algSpec R).map (CommAlgCat.ofHom (classify g)).op := by
  apply (affinePointsEquiv n R S).injective
  rw [MulEquiv.apply_symm_apply, affinePointsEquiv_map]
  exact (point_classify g).symm

/-- Affine points are natural in the test algebra. -/
theorem affinePointsEquiv_naturality {S T : CommAlgCat.{u} R} (g : S ⟶ T)
    (f : (algSpec R).obj (op S) ⟶ (groupScheme n R).X) :
    affinePointsEquiv n R T ((algSpec R).map g.op ≫ f) =
      Matrix.GeneralLinearGroup.map g.hom.toRingHom (affinePointsEquiv n R S f) :=
  Corepresented.affinePointsEquiv_naturality _ _ g f

/-- On an affine test scheme, global-section coordinates are affine coordinates transported
along the inverse global-sections isomorphism. -/
theorem pointsEquiv_eq_affinePointsEquiv (S : CommAlgCat.{u} R)
    (x : (algSpec R).obj (op S) ⟶ (groupScheme n R).X) :
    pointsEquiv n R ((algSpec R).obj (op S)) x =
      Matrix.GeneralLinearGroup.map (Corepresented.affineSectionsIso S).inv.hom.toRingHom
        (affinePointsEquiv n R S x) :=
  Corepresented.pointsEquiv_eq_affinePointsEquiv _ _ S x

end Points

end Langlands.GroupScheme.GeneralLinear
