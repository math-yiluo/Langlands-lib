import Langlands.GroupScheme.Cartan.GenerationStatement
import Langlands.GroupScheme.Absolute.ParabolicTransport
import Langlands.GroupScheme.SubgroupIntersection

/-! # Cartan containment for dimension induction -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

section Base

variable {S : Scheme.{u}} {G M H C : GroupScheme S}
  {T : CommGroupScheme S}

/-- Factorization of a group-scheme homomorphism as a scheme morphism is
equivalent to containment of its range on every test scheme. -/
theorem factorsThrough_hom_iff_range_le (c : C ⟶ G) (i : H ⟶ G) :
    FactorsThrough c.hom.hom i ↔ SubgroupFunctor.range c ≤ SubgroupFunctor.range i := by
  constructor
  · rintro ⟨f, hf⟩ U x ⟨y, rfl⟩
    change U ⟶ C.X at y
    apply SubgroupFunctor.mem_range.2
    refine ⟨y ≫ f, ?_⟩
    change (y ≫ f) ≫ i.hom.hom = y ≫ c.hom.hom
    rw [Category.assoc, hf]
  · intro h
    exact h C.X (show c.hom.hom ∈ (SubgroupFunctor.range c).carrier C.X from
      SubgroupFunctor.mem_range.2 ⟨𝟙 C.X, Category.id_comp _⟩)

/-- A homomorphism carries points centralizing a commutative subgroup to points
centralizing its image, including after arbitrary refinements of the test. -/
theorem mem_torusCentralizer_comp (t : T.toGrp ⟶ M) (j : M ⟶ G)
    {U : Over S} {g : U ⟶ M.X} (hg : g ∈ (torusCentralizer t).carrier U) :
    g ≫ j.hom.hom ∈ (torusCentralizer (t ≫ j)).carrier U := by
  intro V a x
  apply (commute_iff_eq _ _).mpr
  have h := congrArg (fun f => f ≫ j.hom.hom) (hg V a x).eq
  simpa only [MonObj.mul_comp, Grp.comp_hom_hom, Category.assoc] using h

end Base

variable {k : Type u} [Field k]
  {G M H C : GroupScheme (Spec (CommRingCat.of k))}

/-- Every actual closed subgroup containing every Cartan subgroup has full
range on every test scheme. No regularity of the competitor is required. -/
def IsGeneratedByCartanSubgroups (G : GroupScheme (Spec (CommRingCat.of k))) : Prop :=
  ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
    IsClosedSubgroup i →
    (∀ (C : GroupScheme (Spec (CommRingCat.of k))) (c : C ⟶ G),
      IsCartanSubgroup c → FactorsThrough c.hom.hom i) →
    SubgroupFunctor.range i = ⊤

/-- If a maximal torus witnessing a Cartan subgroup stays maximal in the
ambient affine group, that Cartan subgroup maps into an ambient Cartan. -/
theorem IsCartanSubgroup.exists_ambient_cartan [IsAffine G.X.left]
    {c : C ⟶ M} (hc : IsCartanSubgroup c) (j : M ⟶ G)
    (htori : ∀ (T : CommGroupScheme (Spec (CommRingCat.of k))) (t : T.toGrp ⟶ M),
      IsMaximalTorus t → IsMaximalTorus (t ≫ j)) :
    ∃ (D : GroupScheme (Spec (CommRingCat.of k))) (d : D ⟶ G),
      IsCartanSubgroup d ∧ FactorsThrough (c ≫ j).hom.hom d := by
  obtain ⟨T, t, ht, hrep⟩ := hc.exists_centralizer_representation
  obtain ⟨D, d, hd, hdrep⟩ := exists_isCartanSubgroup_of_isMaximalTorus (htori T t ht)
  refine ⟨D, d, hd, (factorsThrough_hom_iff_range_le _ _).2 ?_⟩
  rintro U x ⟨y, rfl⟩
  change U ⟶ C.X at y
  change y ≫ (c ≫ j).hom.hom ∈ (SubgroupFunctor.range d).carrier U
  rw [hdrep.2]
  have hy : y ≫ c.hom.hom ∈ (torusCentralizer t).carrier U := by
    rw [← hrep.2]
    exact ⟨y, rfl⟩
  simpa only [Grp.comp_hom_hom, ← Category.assoc] using
    mem_torusCentralizer_comp t j hy

/-- A closed subgroup containing all ambient Cartans contains a smaller closed
subgroup generated by its Cartans, provided its maximal tori stay maximal.
The proof applies generation to the scheme-theoretic intersection with the
competitor, so that the competitor may be nonreduced and nonsmooth. -/
theorem IsGeneratedByCartanSubgroups.range_le_of_maximalTori [IsAffine G.X.left]
    (hM : IsGeneratedByCartanSubgroups M) (j : M ⟶ G) (hj : IsClosedSubgroup j)
    (htori : ∀ (T : CommGroupScheme (Spec (CommRingCat.of k))) (t : T.toGrp ⟶ M),
      IsMaximalTorus t → IsMaximalTorus (t ≫ j))
    (i : H ⟶ G) (hi : IsClosedSubgroup i)
    (hcartan : ∀ (D : GroupScheme (Spec (CommRingCat.of k))) (d : D ⟶ G),
      IsCartanSubgroup d → FactorsThrough d.hom.hom i) :
    SubgroupFunctor.range j ≤ SubgroupFunctor.range i := by
  have hjc : IsClosedImmersion j.hom.hom.left := hj
  have hic : IsClosedImmersion i.hom.hom.left := hi
  have : Mono i.hom.hom := Over.mono_of_mono_left _
  have hfull := hM (subgroupIntersection j i) (subgroupIntersectionFst j i)
    (isClosedSubgroup_subgroupIntersectionFst j hi) (by
      intro C c hc
      obtain ⟨D, d, hd, hcd⟩ := hc.exists_ambient_cartan j htori
      have hrange : SubgroupFunctor.range (c ≫ j) ≤ SubgroupFunctor.range i :=
        ((factorsThrough_hom_iff_range_le _ _).1 hcd).trans
          ((factorsThrough_hom_iff_range_le _ _).1 (hcartan D d hd))
      have hclosed : IsClosedImmersion (c ≫ j).hom.hom.left := hc.1.comp hj
      have : Mono (c ≫ j).hom.hom := Over.mono_of_mono_left _
      obtain ⟨f, hf⟩ := SubgroupFunctor.exists_factor_of_range_le hrange
      refine ⟨(pullback.lift c f hf.symm).hom.hom, ?_⟩
      exact congrArg (fun a => a.hom.hom) (pullback.lift_fst c f hf.symm))
  rintro U x ⟨y, rfl⟩
  have hy : y ∈ (SubgroupFunctor.range (subgroupIntersectionFst j i)).carrier U := by
    rw [hfull]
    exact Subgroup.mem_top _
  obtain ⟨z, hz⟩ := hy
  change U ⟶ M.X at y
  change U ⟶ (subgroupIntersection j i).X at z
  change z ≫ (subgroupIntersectionFst j i).hom.hom = y at hz
  apply SubgroupFunctor.mem_range.2
  refine ⟨z ≫ (subgroupIntersectionSnd j i).hom.hom, ?_⟩
  have hw := congrArg (fun a => a.hom.hom) (subgroupIntersection_condition j i)
  rw [Grp.comp_hom_hom, Grp.comp_hom_hom] at hw
  change (z ≫ (subgroupIntersectionSnd j i).hom.hom) ≫ i.hom.hom = y ≫ j.hom.hom
  rw [Category.assoc, ← hw, ← Category.assoc, hz]

/-- A central maximal torus makes the entire group a Cartan subgroup. -/
theorem isCartanSubgroup_id_of_central_maximalTorus
    {T : CommGroupScheme (Spec (CommRingCat.of k))} {t : T.toGrp ⟶ G}
    (ht : IsMaximalTorus t) (hcentral : IsCentral t) : IsCartanSubgroup (𝟙 G) := by
  refine ⟨?_, T, t, ht, ?_⟩
  · change IsClosedImmersion (𝟙 G.X.left)
    infer_instance
  apply SubgroupFunctor.ext
  intro U
  apply Subgroup.ext
  intro g
  constructor
  · intro _ V a x
    exact (commute_of_mem_center (hcentral V x) (a ≫ g)).symm
  · intro _
    exact SubgroupFunctor.mem_range.2 ⟨g, Category.comp_id _⟩

/-- A group which is itself Cartan satisfies the full all-test generation
property, for arbitrary closed competitors. -/
theorem isGeneratedByCartanSubgroups_of_isCartanSubgroup_id
    (hG : IsCartanSubgroup (𝟙 G)) : IsGeneratedByCartanSubgroups G := by
  intro H i _ hcartan
  have h := (factorsThrough_hom_iff_range_le _ _).1 (hcartan G (𝟙 G) hG)
  apply SubgroupFunctor.ext
  intro U
  apply top_unique
  intro x _
  exact h U (SubgroupFunctor.mem_range.2 ⟨x, Category.comp_id _⟩)

end Langlands.GroupScheme
