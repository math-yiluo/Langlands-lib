import Langlands.GroupScheme.Cartan.Basic
import Langlands.GroupScheme.ImageGeneration

/-! # Generation of connected affine groups by their Cartan subgroups -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- Over an infinite field, a smooth connected affine group is generated by its
Cartan subgroups. Every closed subgroup containing all Cartan subgroups has top
range on all test schemes. -/
def CartanGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] [Infinite k]
    (G : GroupScheme (Spec (CommRingCat.of k))),
    Smooth G.X.hom → IsAffineHom G.X.hom → ConnectedSpace G.X.left →
    ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      IsClosedSubgroup i →
      (∀ (C : GroupScheme (Spec (CommRingCat.of k))) (c : C ⟶ G),
        IsCartanSubgroup c → FactorsThrough c.hom.hom i) →
      SubgroupFunctor.range i = ⊤

end Langlands.GroupScheme
