import Langlands.GroupScheme.GeneratedFamily
import Langlands.GroupScheme.Cartan.LieInduction

/-! # Cartan generation from families spanning the actual Lie module -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {I : Type v} (A : I → GroupScheme (Spec (CommRingCat.of k))) (a : ∀ j, A j ⟶ G)
    [IsAffineHom G.X.hom] [∀ j, IsAffineHom (A j).X.hom]

/-- The actual differentials of the family span the ambient Lie module. -/
def LieSpanningFamily : Prop :=
  (⨆ j, LinearMap.range (Lie.targetMapLinear (a j) k)) = ⊤

/-- A smooth connected closed family spanning the Lie module generates the
ambient group by Cartans if each member is generated by its Cartans and its
maximal tori remain maximal in the ambient group. -/
theorem isGeneratedByCartanSubgroups_of_lieSpanningFamily
    [Smooth G.X.hom] [ConnectedSpace G.X.left]
    (hsm : ∀ j, Smooth (A j).X.hom)
    (hconn : ∀ j, ConnectedSpace (A j).X.left)
    (hclosed : ∀ j, IsClosedSubgroup (a j))
    (hspan : LieSpanningFamily A a)
    (hgen : ∀ j, IsGeneratedByCartanSubgroups (A j))
    (htori : ∀ j, PreservesMaximalTori (a j)) :
    IsGeneratedByCartanSubgroups G := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  obtain ⟨D, d, hsmD, haffD, hconnD, hd⟩ :=
    FiniteGeneration.exists_smooth_generated_family (A := A) (a := a)
      (fun j => ⟨hsm j, inferInstance, hconn j⟩)
  let : Smooth D.X.hom := hsmD
  let : IsAffineHom D.X.hom := haffD
  let : ConnectedSpace D.X.left := hconnD
  have hrepD : (SubgroupFunctor.range d).IsRepresentedBy d := by
    let : IsClosedImmersion d.hom.hom.left := hd.1
    exact ⟨Over.mono_of_mono_left _, rfl⟩
  have hlie : (SubgroupFunctor.range d).lie k = ⊤ := by
    apply top_unique
    rw [← hspan]
    apply iSup_le
    intro j
    have hrep : (SubgroupFunctor.range (a j)).IsRepresentedBy (a j) := by
      let : IsClosedImmersion (a j).hom.hom.left := hclosed j
      exact ⟨Over.mono_of_mono_left _, rfl⟩
    rw [← (SubgroupFunctor.range (a j)).lie_eq_range k (a j) hrep]
    exact SubgroupFunctor.lie_mono k
      ((factorsThrough_hom_iff_range_le (a j) d).1 (hd.2.1 j))
  have hsurj : Function.Surjective (Lie.targetMapLinear d k) := by
    apply LinearMap.range_eq_top.mp
    rw [← (SubgroupFunctor.range d).lie_eq_range k d hrepD, hlie]
  have htop : SubgroupFunctor.range d = ⊤ := by
    apply lieSubgroupEquality k G D d hd.1
    intro X
    obtain ⟨Y, hY⟩ := hsurj (Additive.ofMul X)
    exact ⟨Y.toMul, congrArg (fun Z => Z.toMul.val) hY⟩
  intro H i hi hcartan
  have hfamily : ∀ j, FactorsThrough (a j).hom.hom i := by
    intro j
    exact (factorsThrough_hom_iff_range_le (a j) i).2
      ((hgen j).range_le_of_maximalTori (a j) (hclosed j) (htori j) i hi hcartan)
  have hle := hd.2.2 H i hi hfamily
  rw [htop] at hle
  apply SubgroupFunctor.ext
  intro U
  exact le_antisymm le_top (hle U)

end Langlands.GroupScheme
