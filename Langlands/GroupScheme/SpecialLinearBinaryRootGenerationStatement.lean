import Langlands.GroupScheme.SpecialLinearBinaryRootGroups
import Langlands.GroupScheme.GeneratedFamily

/-! # SL₂ is generated by its two root subgroups: statement -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- **`SL₂` is generated by `U⁺` and `U⁻`** (Milne, *Algebraic Groups* (2017),
Proposition 20.23). Over every field `k`, the whole group scheme `SL₂` is the closed
subgroup generated by the family consisting of the upper and the lower additive root
homomorphisms `𝔾ₐ ⟶ SL₂`, `a ↦ [[1, a], [0, 1]]` and `a ↦ [[1, 0], [a, 1]]`: every closed
subgroup of `SL₂` through which both root homomorphisms factor contains all of `SL₂`.

Generation is the Library's `IsGeneratedByFamily`, applied to the identity of `SL₂`. -/
def SpecialLinearBinaryRootGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k],
    IsGeneratedByFamily
      (fun _ : Fin 2 => VectorGroup.groupScheme (CommRingCat.of k) 1)
      ![SpecialLinear.BinaryRoot.upperMap (CommRingCat.of k),
        SpecialLinear.BinaryRoot.lowerMap (CommRingCat.of k)]
      (𝟙 (SpecialLinear.groupScheme (Fin 2) (CommRingCat.of k)))

end Langlands.GroupScheme
