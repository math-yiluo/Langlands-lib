import Langlands.GroupScheme.SmoothNormalizer.BaseChange

/-! # The normalizer of a smooth connected subgroup is cut out by a finitely generated ideal -/

universe u

open CategoryTheory TensorProduct Langlands.GroupScheme.Corepresented
open Langlands.Algebra.ProjectiveTensorCoefficients

namespace Langlands.GroupScheme.SmoothNormalizer

variable {R : CommRingCat.{u}} {F : CommAlgCat.{u} R ⥤ GrpCat.{u}} {B : CommAlgCat.{u} R}
  {e : (F ⋙ forget GrpCat).CorepresentableBy B} {H : ∀ A : CommAlgCat.{u} R, Subgroup (F.obj A)}
  {I : Ideal B}

section Conj

variable (e I) in
/-- The conjugate of the universal cut point over `A ⊗[R] (B ⧸ I)` by a point `g` over `A`. -/
abbrev conjPt {A : CommAlgCat.{u} R} (g : F.obj A) : F.obj (tensorQuotient I A) :=
  F.map (tensorQuotientLeft I A) g * universalCutPoint e I A *
    (F.map (tensorQuotientLeft I A) g)⁻¹

variable (hI : IsCutOutBy e H I)

/-- The family of points `h` of the subgroup over `A`-algebras `X` whose conjugate by `g` again
lies in the subgroup. It is the preimage of the subgroup under conjugation by `g`. -/
def conjFamily {A : CommAlgCat.{u} R} (g : F.obj A) (X : CommAlgCat.{u} (CommRingCat.of A)) :
    Subgroup ((res A ⋙ cutFunctor hI).obj X) :=
  (H ((res A).obj X)).comap
    ((MulAut.conj (F.map (toRes A X) g)).toMonoidHom.comp (H ((res A).obj X)).subtype)

/-- An `A`-algebra map out of `A ⊗[R] D`, as a map of `R`-algebras for the restricted
structure on the target. -/
def toResHom {A : CommAlgCat.{u} R} {D : CommAlgCat.{u} R} {X : CommAlgCat.{u} (CommRingCat.of A)}
    (φ : baseChangeAlg A D ⟶ X) : CommAlgCat.of R (A ⊗[R] D) ⟶ (res A).obj X :=
  letI := resAlgebra A X
  CommAlgCat.ofHom
    { φ.hom.toRingHom with
      commutes' := fun r => by
        change φ.hom (algebraMap R (A ⊗[R] D) r) = algebraMap A X (algebraMap R A r)
        exact φ.hom.commutes (algebraMap R A r) }

@[simp] theorem toResHom_hom_apply {A : CommAlgCat.{u} R} {D : CommAlgCat.{u} R}
    {X : CommAlgCat.{u} (CommRingCat.of A)} (φ : baseChangeAlg A D ⟶ X) (x : A ⊗[R] D) :
    (toResHom φ).hom x = φ.hom x := rfl

theorem cutCorep_val {X : CommAlgCat.{u} R} (h : (cutFunctor hI).obj X) :
    (h.1 : F.obj X) = e.homEquiv (quotientMap I ≫ (cutCorepresentableBy hI).homEquiv.symm h) := by
  conv_lhs => rw [← (cutCorepresentableBy hI).homEquiv.apply_symm_apply h]
  rfl

/-- The family `conjFamily hI g` is cut out by the ideal generated by the image of `I` under the
classifying map of the conjugated universal cut point. -/
theorem isCutOutBy_conjFamily {A : CommAlgCat.{u} R} (g : F.obj A) :
    IsCutOutBy (baseChangeCorep A (cutCorepresentableBy hI)) (conjFamily hI g)
      (Ideal.map (cls e (conjPt e I g)) I) := by
  intro X h
  set φ := (baseChangeCorep A (cutCorepresentableBy hI)).homEquiv.symm h
  have hres : (cutCorepresentableBy hI).homEquiv.symm h = restrictRight A φ :=
    (restrictRight_baseChangeCorep_symm A (cutCorepresentableBy hI) X h).symm
  have h1 : F.map (toResHom φ) (universalCutPoint e I A) = h.1 := by
    apply eq_of_cls_eq (e := e)
    rw [cls_map, cutCorep_val hI h, hres, universalCutPoint, cls, cls, Equiv.symm_apply_apply,
      Equiv.symm_apply_apply]
    ext b
    rfl
  have h2 : F.map (toResHom φ) (F.map (tensorQuotientLeft I A) g) = F.map (toRes A X) g := by
    have hc : tensorQuotientLeft I A ≫ toResHom φ = toRes A X :=
      CommAlgCat.hom_ext (AlgHom.ext fun a => φ.hom.commutes a)
    rw [← ConcreteCategory.comp_apply, ← F.map_comp, hc]
  have h3 : F.map (toResHom φ) (conjPt e I g) =
      F.map (toRes A X) g * h.1 * (F.map (toRes A X) g)⁻¹ := by
    rw [map_mul, map_mul, map_inv, h1, h2]
  change (F.map (toRes A X) g * h.1 * (F.map (toRes A X) g)⁻¹ ∈ H _) ↔ _
  rw [← h3, hI]
  constructor
  · intro hb k hk
    have hle : Ideal.map (cls e (conjPt e I g)) I ≤ RingHom.ker φ.hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb'
      have := hb b hb'
      change cls e (F.map (toResHom φ) (conjPt e I g)) b = 0 at this
      rw [cls_map] at this
      exact this
    exact hle hk
  · intro hk b hb
    change cls e (F.map (toResHom φ) (conjPt e I g)) b = 0
    rw [cls_map]
    exact hk _ (Ideal.mem_map_of_mem _ hb)

end Conj

section Trunc

variable (hI : IsCutOutBy e H I)

/-- The augmentation ideal of `B ⧸ I`: the kernel of the counit of the cut subgroup. -/
abbrev augIdeal : Ideal (B ⧸ I) := RingHom.ker (counit (cutCorepresentableBy hI))

/-- The truncation `A ⊗[R] (B ⧸ I) → A ⊗[R] ((B ⧸ I) ⧸ J ^ (n + 1))`. -/
abbrev truncMap (A : CommAlgCat.{u} R) (n : ℕ) :
    A ⊗[R] (B ⧸ I) →ₐ[R] A ⊗[R] ((B ⧸ I) ⧸ augIdeal hI ^ (n + 1)) :=
  Algebra.TensorProduct.map (AlgHom.id R A) (Ideal.Quotient.mkₐ R (augIdeal hI ^ (n + 1)))

theorem counit_baseChange_tmul (A : CommAlgCat.{u} R) (q : B ⧸ I) :
    counit (baseChangeCorep A (cutCorepresentableBy hI)) ((1 : A) ⊗ₜ[R] q) =
      algebraMap R A (counit (cutCorepresentableBy hI) q) := by
  have h := congrArg (fun f => f.hom q) (restrictRight_baseChangeCorep_symm A
    (cutCorepresentableBy hI) (CommAlgCat.of (CommRingCat.of A) (CommRingCat.of A)) 1)
  refine h.trans ?_
  change cls (cutCorepresentableBy hI) (1 : (cutFunctor hI).obj
    ((res A).obj (CommAlgCat.of (CommRingCat.of A) (CommRingCat.of A)))) q = _
  rw [cls_one]
  rfl

theorem ker_truncMap_le (A : CommAlgCat.{u} R) (n : ℕ) :
    RingHom.ker (truncMap hI A n) ≤
      RingHom.ker (counit (baseChangeCorep A (cutCorepresentableBy hI))) ^ (n + 1) := by
  rw [truncMap, Algebra.TensorProduct.lTensor_ker _ Ideal.Quotient.mk_surjective,
    show RingHom.ker (Ideal.Quotient.mkₐ R (augIdeal hI ^ (n + 1))) = augIdeal hI ^ (n + 1) from
      Ideal.mk_ker, Ideal.map_pow]
  apply Ideal.pow_right_mono
  rw [Ideal.map_le_iff_le_comap]
  intro q hq
  rw [Ideal.mem_comap, RingHom.mem_ker]
  change counit (baseChangeCorep A (cutCorepresentableBy hI)) ((1 : A) ⊗ₜ[R] q) = 0
  rw [counit_baseChange_tmul, RingHom.mem_ker.1 hq, map_zero]

end Trunc

section Key

/-- Connectedness of the fibres of `A ⊗[R] C` over `A` follows from connectedness of the fibres of
`C` over `R`, since `κ(p) ⊗[A] (A ⊗[R] C) ≅ κ(p) ⊗[R] C`. -/
theorem connectedSpace_baseChange (C : Type u) [CommRing C] [Algebra R C]
    (hconn : ∀ (K : Type u) [Field K] [Algebra R K], ConnectedSpace (PrimeSpectrum (K ⊗[R] C)))
    (A : CommAlgCat.{u} R) (p : PrimeSpectrum A) :
    ConnectedSpace (PrimeSpectrum (p.asIdeal.ResidueField ⊗[A] (A ⊗[R] C))) := by
  have := hconn p.asIdeal.ResidueField
  let φ := Algebra.TensorProduct.cancelBaseChange R A p.asIdeal.ResidueField
    p.asIdeal.ResidueField C
  exact (PrimeSpectrum.homeomorphOfRingEquiv φ.toRingEquiv.symm).connectedSpace_iff.1 this

variable (hI : IsCutOutBy e H I)

/-- **Key lemma.** If the conjugate of the universal cut point by `g` vanishes on `I` modulo every
power of the augmentation ideal, then it lies in the subgroup. This is the density of the
infinitesimal neighbourhoods of the identity in a smooth subgroup with connected fibres. -/
theorem conjPt_mem [Algebra.Smooth R (B ⧸ I)] (hfgI : I.FG)
    (hconn : ∀ (K : Type u) [Field K] [Algebra R K],
      ConnectedSpace (PrimeSpectrum (K ⊗[R] (B ⧸ I))))
    {A : CommAlgCat.{u} R} (g : F.obj A)
    (h : ∀ n : ℕ, ∀ b ∈ I, truncMap hI A n (cls e (conjPt e I g) b) = 0) :
    conjPt e I g ∈ H (tensorQuotient I A) := by
  have hK := isCutOutBy_conjFamily hI g
  have : Algebra.Smooth (CommRingCat.of A) (baseChangeAlg A (quotientAlgebra I)) := by
    change Algebra.Smooth A (A ⊗[R] (B ⧸ I))
    infer_instance
  have hbot := eq_bot_of_forall_le_pow
    (fun p => connectedSpace_baseChange (B ⧸ I) hconn A p) hK (hfgI.map _) (fun n => by
      cases n with
      | zero => rw [pow_zero, Ideal.one_eq_top]; exact le_top
      | succ m =>
        refine le_trans ?_ (ker_truncMap_le hI A m)
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        exact h m b hb)
  rw [hI]
  intro b hb
  have hmem : cls e (conjPt e I g) b ∈ Ideal.map (cls e (conjPt e I g)) I :=
    Ideal.mem_map_of_mem _ hb
  rw [hbot] at hmem
  exact (Submodule.mem_bot _).1 hmem

end Key

section Coefficients

variable {R₀ : Type*} [CommRing R₀] {P : Type*} [AddCommGroup P] [Module R₀ P]
  {A₀ : Type*} [CommRing A₀] [Algebra R₀ A₀]

theorem contract_add_left (φ ψ : P →ₗ[R₀] R₀) (x : A₀ ⊗[R₀] P) :
    contract (φ + ψ) x = contract φ x + contract ψ x := by
  induction x using TensorProduct.inductionOn with
  | tmul m p => simp [add_smul]
  | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]; abel

theorem contract_smul_left (r : R₀) (φ : P →ₗ[R₀] R₀) (x : A₀ ⊗[R₀] P) :
    contract (r • φ) x = r • contract φ x := by
  induction x using TensorProduct.inductionOn with
  | tmul m p => simp [mul_smul]
  | add x y hx hy => rw [map_add, map_add, hx, hy, smul_add]

/-- The coefficient ideal of finitely many tensors with a finite projective right factor is
finitely generated. -/
theorem coefficientIdeal_fg [Module.Finite R₀ P] [Module.Projective R₀ P]
    {T : Set (A₀ ⊗[R₀] P)} (hT : T.Finite) : (coefficientIdeal T).FG := by
  classical
  obtain ⟨Φ, hΦ⟩ := Module.Finite.fg_top (R := R₀) (M := Module.Dual R₀ P)
  refine ⟨(hT.toFinset ×ˢ Φ).image (fun p => contract p.2 p.1), le_antisymm ?_ ?_⟩
  · rw [Ideal.span_le]
    intro a ha
    simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe, Finset.mem_product,
      Set.Finite.mem_toFinset] at ha
    obtain ⟨⟨x, φ⟩, ⟨hx, -⟩, rfl⟩ := ha
    exact Ideal.subset_span ⟨x, hx, φ, rfl⟩
  · rw [coefficientIdeal, Ideal.span_le]
    rintro _ ⟨x, hx, φ, rfl⟩
    have hφ : φ ∈ Submodule.span R₀ (Φ : Set (Module.Dual R₀ P)) := hΦ ▸ Submodule.mem_top
    induction hφ using Submodule.span_induction with
    | mem ψ hψ =>
      exact Ideal.subset_span (Finset.mem_coe.2 (Finset.mem_image.2
        ⟨(x, ψ), Finset.mem_product.2 ⟨hT.mem_toFinset.2 hx, hψ⟩, rfl⟩))
    | zero =>
      have : contract (0 : P →ₗ[R₀] R₀) x = 0 := by
        clear hx
        induction x using TensorProduct.inductionOn with
        | tmul m p => simp
        | add y z hy hz => rw [map_add, hy, hz, add_zero]
      rw [this]
      exact Submodule.zero_mem _
    | add ψ χ _ _ hψ hχ => rw [contract_add_left]; exact Submodule.add_mem _ hψ hχ
    | smul r ψ _ hψ =>
      rw [contract_smul_left, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hψ

theorem coefficientIdeal_mono {T T' : Set (A₀ ⊗[R₀] P)} (h : T ⊆ T') :
    coefficientIdeal T ≤ coefficientIdeal T' := by
  apply Ideal.span_mono
  rintro _ ⟨x, hx, φ, rfl⟩
  exact ⟨x, h hx, φ, rfl⟩

/-- For algebra maps `ρ, ρ'` into `A₀ ⊗[R₀] P`, the coefficient ideal of the images of an ideal
`span S` equals that of the images of the generators `S`. -/
theorem coefficientIdeal_image_span {Q : Type*} [CommRing Q] [Algebra R₀ Q]
    [Module.Projective R₀ Q] (ρ ρ' : A₀ →ₐ[R₀] A₀ ⊗[R₀] Q) (S : Set A₀) :
    coefficientIdeal (ρ '' (Ideal.span S : Set A₀) ∪ ρ' '' (Ideal.span S : Set A₀)) =
      coefficientIdeal (ρ '' S ∪ ρ' '' S) := by
  apply le_antisymm
  · set M := coefficientIdeal (ρ '' S ∪ ρ' '' S)
    have hkerM : RingHom.ker (Ideal.Quotient.mkₐ R₀ M).toRingHom = M := Ideal.mk_ker
    have hM := (coefficientIdeal_le_ker_iff (ρ '' S ∪ ρ' '' S) (Ideal.Quotient.mkₐ R₀ M)).1
      hkerM.ge
    conv_rhs => rw [← hkerM]
    rw [coefficientIdeal_le_ker_iff]
    have hσ : ∀ τ : A₀ →ₐ[R₀] A₀ ⊗[R₀] Q, (∀ s ∈ S, τ s ∈ ρ '' S ∪ ρ' '' S) →
        ∀ b ∈ Ideal.span S, (Ideal.Quotient.mkₐ R₀ M).toLinearMap.rTensor Q (τ b) = 0 := by
      intro τ hτ b hb
      let σ := (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R₀ M) (AlgHom.id R₀ Q)).comp τ
      have hle : Ideal.span S ≤ RingHom.ker σ := by
        rw [Ideal.span_le]
        intro s hs
        exact hM _ (hτ s hs)
      exact hle hb
    rintro _ (⟨b, hb, rfl⟩ | ⟨b, hb, rfl⟩)
    · exact hσ ρ (fun s hs => Or.inl ⟨s, hs, rfl⟩) b hb
    · exact hσ ρ' (fun s hs => Or.inr ⟨s, hs, rfl⟩) b hb
  · apply coefficientIdeal_mono
    exact Set.union_subset_union (Set.image_mono Ideal.subset_span)
      (Set.image_mono Ideal.subset_span)

end Coefficients

section Normalizer

variable (hI : IsCutOutBy e H I)

theorem conjPt_inv {A : CommAlgCat.{u} R} (g : F.obj A) :
    conjPt e I g⁻¹ = (F.map (tensorQuotientLeft I A) g)⁻¹ * universalCutPoint e I A *
      F.map (tensorQuotientLeft I A) g := by
  rw [conjPt, map_inv, inv_inv]

/-- The `n`-th approximation of the normalizer ideal: the coefficient ideal, along the `n`-th jet
module of `B ⧸ I`, of the truncated images of `I` under both universal conjugations. -/
def normalizerIdealStep (n : ℕ) : Ideal B :=
  coefficientIdeal ((truncMap hI B n) ''
    ((cls e (universalConjugate e I)) '' I ∪ (cls e (universalInvConjugate e I)) '' I))

/-- The normalizer ideal: the supremum of all approximations. -/
def smoothNormalizerIdeal : Ideal B := ⨆ n, normalizerIdealStep hI n

theorem rTensor_truncMap {A : CommAlgCat.{u} R} (φ : B ⟶ A) (n : ℕ) (y : B ⊗[R] (B ⧸ I)) :
    φ.hom.toLinearMap.rTensor ((B ⧸ I) ⧸ augIdeal hI ^ (n + 1)) (truncMap hI B n y) =
      truncMap hI A n (φ.hom.toLinearMap.rTensor (B ⧸ I) y) := by
  induction y using TensorProduct.inductionOn with
  | tmul b q => rfl
  | add y z hy hz => rw [map_add, map_add, hy, hz, map_add, map_add]

theorem cls_conjPt_homEquiv {A : CommAlgCat.{u} R} (φ : B ⟶ A) (b : B) :
    cls e (conjPt e I (e.homEquiv φ)) b =
      φ.hom.toLinearMap.rTensor (B ⧸ I) (cls e (universalConjugate e I) b) := by
  rw [conjPt, ← map_universalConjugate, cls_map, AlgHom.comp_apply, ← tensorQuotientMap_apply]

theorem cls_conjPt_inv_homEquiv {A : CommAlgCat.{u} R} (φ : B ⟶ A) (b : B) :
    cls e (conjPt e I (e.homEquiv φ)⁻¹) b =
      φ.hom.toLinearMap.rTensor (B ⧸ I) (cls e (universalInvConjugate e I) b) := by
  rw [conjPt_inv, ← map_universalInvConjugate, cls_map, AlgHom.comp_apply,
    ← tensorQuotientMap_apply]

theorem normalizerIdealStep_le_ker_iff [Algebra.Smooth R (B ⧸ I)] {A : CommAlgCat.{u} R}
    (φ : B ⟶ A) (n : ℕ) :
    normalizerIdealStep hI n ≤ RingHom.ker φ.hom.toRingHom ↔
      ∀ b ∈ I, truncMap hI A n (cls e (conjPt e I (e.homEquiv φ)) b) = 0 ∧
        truncMap hI A n (cls e (conjPt e I (e.homEquiv φ)⁻¹) b) = 0 := by
  have := (Algebra.Smooth.finite_projective_quotient_ker_pow
    (counit (cutCorepresentableBy hI)) n).2
  rw [normalizerIdealStep, coefficientIdeal_le_ker_iff]
  simp only [Set.mem_image, Set.mem_union, forall_exists_index, and_imp]
  constructor
  · intro h b hb
    refine ⟨?_, ?_⟩
    · rw [cls_conjPt_homEquiv, ← rTensor_truncMap]
      exact h _ _ (Or.inl ⟨b, hb, rfl⟩) rfl
    · rw [cls_conjPt_inv_homEquiv, ← rTensor_truncMap]
      exact h _ _ (Or.inr ⟨b, hb, rfl⟩) rfl
  · rintro h _ y (⟨b, hb, rfl⟩ | ⟨b, hb, rfl⟩) rfl
    · rw [rTensor_truncMap, ← cls_conjPt_homEquiv]
      exact (h b hb).1
    · rw [rTensor_truncMap, ← cls_conjPt_inv_homEquiv]
      exact (h b hb).2

/-- **The normalizer is cut out by `smoothNormalizerIdeal`.** -/
theorem isCutOutBy_smoothNormalizerIdeal [Algebra.Smooth R (B ⧸ I)] (hfgI : I.FG)
    (hconn : ∀ (K : Type u) [Field K] [Algebra R K],
      ConnectedSpace (PrimeSpectrum (K ⊗[R] (B ⧸ I)))) :
    IsCutOutBy e (normalizerFamily H) (smoothNormalizerIdeal hI) := by
  intro A g
  obtain ⟨φ, rfl⟩ := e.homEquiv.surjective g
  rw [mem_normalizerFamily_iff hI, Equiv.symm_apply_apply]
  have hR : (∀ b ∈ smoothNormalizerIdeal hI, φ.hom b = 0) ↔
      ∀ n, normalizerIdealStep hI n ≤ RingHom.ker φ.hom.toRingHom := by
    rw [← iSup_le_iff]
    exact ⟨fun h b hb => h b hb, fun h b hb => h hb⟩
  rw [hR]
  simp_rw [normalizerIdealStep_le_ker_iff hI φ]
  constructor
  · rintro ⟨h1, h2⟩ n b hb
    rw [← conjPt_inv] at h2
    rw [hI] at h1 h2
    exact ⟨by rw [h1 b hb, map_zero], by rw [h2 b hb, map_zero]⟩
  · intro h
    refine ⟨conjPt_mem hI hfgI hconn _ fun n b hb => (h n b hb).1, ?_⟩
    rw [← conjPt_inv]
    exact conjPt_mem hI hfgI hconn _ fun n b hb => (h n b hb).2

theorem normalizerIdealStep_fg [Algebra.Smooth R (B ⧸ I)] (hfgI : I.FG) (n : ℕ) :
    (normalizerIdealStep hI n).FG := by
  obtain ⟨S, hS⟩ := hfgI
  have hfp := Algebra.Smooth.finite_projective_quotient_ker_pow
    (counit (cutCorepresentableBy hI)) n
  have := hfp.1
  have := hfp.2
  have hIS : (I : Set B) = (Ideal.span (S : Set B) : Set B) := by rw [hS]
  rw [normalizerIdealStep, Set.image_union, ← Set.image_comp, ← Set.image_comp, hIS]
  have h := coefficientIdeal_image_span ((truncMap hI B n).comp (cls e (universalConjugate e I)))
    ((truncMap hI B n).comp (cls e (universalInvConjugate e I))) (S : Set B)
  rw [AlgHom.coe_comp, AlgHom.coe_comp] at h
  rw [h]
  exact coefficientIdeal_fg ((S.finite_toSet.image _).union (S.finite_toSet.image _))

theorem rTensor_mk_eq_zero_iff (J : Ideal B) (y : B ⊗[R] (B ⧸ I)) :
    (Ideal.Quotient.mkₐ R J).toLinearMap.rTensor (B ⧸ I) y = 0 ↔
      y ∈ Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I)) J := by
  have h := Algebra.TensorProduct.rTensor_ker (R := R) (S := R) (Ideal.Quotient.mkₐ R J)
    (Ideal.Quotient.mkₐ_surjective R J) (C := B ⧸ I)
  rw [show RingHom.ker (Ideal.Quotient.mkₐ R J) = J from Ideal.mk_ker] at h
  rw [← h]
  rfl

/-- **The normalizer ideal is finitely generated.** The conjugation conditions modulo the whole
ideal involve finitely many generators of `I`, hence finitely many approximation steps. -/
theorem smoothNormalizerIdeal_fg [Algebra.Smooth R (B ⧸ I)] (hfgI : I.FG)
    (hconn : ∀ (K : Type u) [Field K] [Algebra R K],
      ConnectedSpace (PrimeSpectrum (K ⊗[R] (B ⧸ I)))) :
    (smoothNormalizerIdeal hI).FG := by
  classical
  have hcut := isCutOutBy_smoothNormalizerIdeal hI hfgI hconn
  let π : B ⟶ CommAlgCat.of R (B ⧸ smoothNormalizerIdeal hI) :=
    CommAlgCat.ofHom (Ideal.Quotient.mkₐ R _)
  have hπ : e.homEquiv π ∈ normalizerFamily H _ := (hcut _ _).2 fun b hb => by
    rw [Equiv.symm_apply_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.2 hb
  rw [mem_normalizerFamily_iff hI, ← conjPt_inv] at hπ
  obtain ⟨h1, h2⟩ := hπ
  rw [hI] at h1 h2
  have hγ : ∀ b ∈ I, cls e (universalConjugate e I) b ∈
      ⨆ n, Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I))
        (normalizerIdealStep hI n) := fun b hb => by
    rw [← Ideal.map_iSup, ← smoothNormalizerIdeal, ← rTensor_mk_eq_zero_iff]
    have := h1 b hb
    rw [cls_conjPt_homEquiv] at this
    exact this
  have hγ' : ∀ b ∈ I, cls e (universalInvConjugate e I) b ∈
      ⨆ n, Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I))
        (normalizerIdealStep hI n) := fun b hb => by
    rw [← Ideal.map_iSup, ← smoothNormalizerIdeal, ← rTensor_mk_eq_zero_iff]
    have := h2 b hb
    rw [cls_conjPt_inv_homEquiv] at this
    exact this
  obtain ⟨S, hS⟩ := hfgI
  choose T hT using fun s : S =>
    Submodule.mem_iSup_iff_exists_finset.1 (hγ s (hS ▸ Ideal.subset_span s.2))
  choose T' hT' using fun s : S =>
    Submodule.mem_iSup_iff_exists_finset.1 (hγ' s (hS ▸ Ideal.subset_span s.2))
  let U : Finset ℕ := Finset.univ.biUnion T ∪ Finset.univ.biUnion T'
  let N' := ⨆ n ∈ U, normalizerIdealStep hI n
  have hfg' : N'.FG := Submodule.fg_biSup U _ fun n _ => normalizerIdealStep_fg hI ⟨S, hS⟩ n
  have hN'N : N' ≤ smoothNormalizerIdeal hI :=
    iSup₂_le fun n _ => le_iSup (normalizerIdealStep hI) n
  have hsub : ∀ V : Finset ℕ, V ⊆ U →
      ⨆ n ∈ V, Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I))
        (normalizerIdealStep hI n) ≤
      Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I)) N' := by
    intro V hV
    refine iSup₂_le fun n hn => Ideal.map_mono ?_
    exact le_iSup₂ (f := fun n (_ : n ∈ U) => normalizerIdealStep hI n) n (hV hn)
  have hγS : ∀ s ∈ S, cls e (universalConjugate e I) s ∈
      Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I)) N' := fun s hs =>
    hsub _ (fun n hn => Finset.mem_union_left _ (Finset.mem_biUnion.2
      ⟨⟨s, hs⟩, Finset.mem_univ _, hn⟩)) (hT ⟨s, hs⟩)
  have hγ'S : ∀ s ∈ S, cls e (universalInvConjugate e I) s ∈
      Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I)) N' := fun s hs =>
    hsub _ (fun n hn => Finset.mem_union_right _ (Finset.mem_biUnion.2
      ⟨⟨s, hs⟩, Finset.mem_univ _, hn⟩)) (hT' ⟨s, hs⟩)
  let π' : B ⟶ CommAlgCat.of R (B ⧸ N') := CommAlgCat.ofHom (Ideal.Quotient.mkₐ R N')
  have hkill : ∀ τ : B →ₐ[R] B ⊗[R] (B ⧸ I), (∀ s ∈ S, τ s ∈
      Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] (B ⧸ I)) N') →
      ∀ b ∈ I, (Ideal.Quotient.mkₐ R N').toLinearMap.rTensor (B ⧸ I) (τ b) = 0 := by
    intro τ hτ b hb
    let σ := (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R N')
      (AlgHom.id R (B ⧸ I))).comp τ
    have hle : I ≤ RingHom.ker σ := hS.ge.trans (Ideal.span_le.2 fun s hs =>
      (rTensor_mk_eq_zero_iff N' _).2 (hτ s hs))
    exact hle hb
  have hπ' : e.homEquiv π' ∈ normalizerFamily H _ := by
    rw [mem_normalizerFamily_iff hI, ← conjPt_inv, hI, hI]
    refine ⟨fun b hb => ?_, fun b hb => ?_⟩
    · rw [cls_conjPt_homEquiv]
      exact hkill _ hγS b hb
    · rw [cls_conjPt_inv_homEquiv]
      exact hkill _ hγ'S b hb
  have hNN' : smoothNormalizerIdeal hI ≤ N' := by
    intro b hb
    have := (hcut _ _).1 hπ' b hb
    rw [Equiv.symm_apply_apply] at this
    exact Ideal.Quotient.eq_zero_iff_mem.1 this
  rw [le_antisymm hNN' hN'N]
  exact hfg'

end Normalizer

end Langlands.GroupScheme.SmoothNormalizer
