import Langlands.GroupScheme.AffineWeilDynamics
import Langlands.GroupScheme.CentralSimpleBinaryDynamic
import Langlands.GroupScheme.CentralSimpleBinaryGeneration
import Langlands.GroupScheme.Rational.AffineWeilPoints
import Langlands.GroupScheme.Rational.DynamicElementarySubgroup

/-! # Actual Weil-restricted binary norm-one images and elementary generation -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped CategoryTheory.MonObj TensorProduct

namespace Langlands.GroupScheme.AffineWeil

variable (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
  [Module.Finite A B] [Module.Projective A B]
  {G H : GroupScheme (Spec (CommRingCat.of B))}
  [IsAffine G.X.left] [LocallyOfFiniteType G.X.hom]
  [IsAffine H.X.left] [LocallyOfFiniteType H.X.hom]

/-- The restricted homomorphism is the original homomorphism on every tensor-spectrum test. -/
theorem testPointsEquiv_map (f : G ⟶ H) {T : Over (Spec (CommRingCat.of A))}
    (x : T ⟶ (groupScheme A B G).X) :
    testPointsEquiv A B H T (x ≫ (map A B f).hom.hom) =
      testPointsEquiv A B G T x ≫ f.hom.hom :=
  Corepresented.groupSchemeMap_points (corepresentableBy A B G)
    (corepresentableBy A B H) (pointTransformation A B f) x

/-- Restriction preserves containment of an actual homomorphism's range in a dynamic unipotent. -/
theorem range_map_le_dynamicUnipotent (f : G ⟶ H)
    (χ : (Gm (Spec (CommRingCat.of B))).toGrp ⟶ H)
    (hf : SubgroupFunctor.range f ≤ Dynamic.unipotent χ) :
    SubgroupFunctor.range (map A B f) ≤ Dynamic.unipotent (cocharacter A B χ) := by
  intro T x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  apply mem_dynamicUnipotent_of_testPointsEquiv A B χ
  rw [testPointsEquiv_map]
  exact hf _ (SubgroupFunctor.mem_range.mpr ⟨testPointsEquiv A B G T y, rfl⟩)

end Langlands.GroupScheme.AffineWeil

namespace Langlands.GroupScheme.CentralSimpleUnits.BinaryRoot.WeilRoot

variable (F E D : Type u) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E]
  [Ring D] [Algebra E D] [FiniteDimensional E D]
  [Algebra.IsCentral E D] [IsSimpleRing D]

local instance vectorGroup_affine (d : ℕ) :
    IsAffine (VectorGroup.groupScheme (CommRingCat.of E) d).X.left := by
  change IsAffine (Spec (CommRingCat.of (MvPolynomial (Fin d) E)))
  infer_instance

local instance vectorGroup_finiteType (d : ℕ) :
    LocallyOfFiniteType (VectorGroup.groupScheme (CommRingCat.of E) d).X.hom := by
  change LocallyOfFiniteType
    (Spec.map (CommRingCat.ofHom (algebraMap E (MvPolynomial (Fin d) E))))
  apply HasRingHomProperty.Spec_iff.mpr
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The actual affine restriction of the canonical binary reduced-norm-one group. -/
abbrev groupScheme : GroupScheme (Spec (CommRingCat.of F)) :=
  AffineWeil.groupScheme F E (BinaryRoot.groupScheme E D)

/-- The actual restricted additive parameter group for a chosen coefficient basis. -/
abbrev additiveScheme (d : ℕ) : GroupScheme (Spec (CommRingCat.of F)) :=
  AffineWeil.groupScheme F E (FiniteAlgebraUnits.BinaryRoot.additiveScheme E (d := d))

variable {d : ℕ} (bD : Module.Basis (Fin d) E D)

/-- The restriction of the original upper or lower norm-one elementary homomorphism. -/
def elementaryMap (neg : Bool) :
    additiveScheme F E d ⟶ groupScheme F E D :=
  AffineWeil.map F E (BinaryRoot.elementaryMap E D bD neg)

/-- The actual ground-field cocharacter induced by the original contracting cocharacter. -/
def cocharacter (neg : Bool) :
    (Gm (Spec (CommRingCat.of F))).toGrp ⟶ groupScheme F E D :=
  AffineWeil.cocharacter F E (BinaryRoot.cocharacter E D neg)

/-- Both actual restricted elementary images contract on every relative test scheme. -/
theorem elementary_range_le_dynamicUnipotent (neg : Bool) :
    SubgroupFunctor.range (elementaryMap F E D bD neg) ≤
      Dynamic.unipotent (cocharacter F E D neg) :=
  AffineWeil.range_map_le_dynamicUnipotent F E
    (BinaryRoot.elementaryMap E D bD neg) (BinaryRoot.cocharacter E D neg)
    (BinaryRoot.elementary_range_le_dynamicUnipotent E D bD neg)

/-- The subgroup generated by the two actual rational restricted elementary images. -/
def rationalElementarySubgroup : Subgroup (rationalPoints (groupScheme F E D)) :=
  (rationalPoints.map (elementaryMap F E D bD false)).range ⊔
    (rationalPoints.map (elementaryMap F E D bD true)).range

/-- Rational comparison identifies each actual restricted elementary range with its original range. -/
theorem map_rationalElementaryRange (neg : Bool) :
    ((rationalPoints.map (elementaryMap F E D bD neg)).range).map
        (AffineWeil.rationalPointsEquiv F E (BinaryRoot.groupScheme E D)).toMonoidHom =
      (rationalPoints.map (BinaryRoot.elementaryMap E D bD neg)).range := by
  apply le_antisymm
  · rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨AffineWeil.rationalPointsEquiv F E
        (FiniteAlgebraUnits.BinaryRoot.additiveScheme E (d := d)) x,
      (AffineWeil.rationalPointsEquiv_map F E (BinaryRoot.elementaryMap E D bD neg) x).symm⟩
  · rintro _ ⟨x, rfl⟩
    let y := (AffineWeil.rationalPointsEquiv F E
      (FiniteAlgebraUnits.BinaryRoot.additiveScheme E (d := d))).symm x
    refine ⟨rationalPoints.map (elementaryMap F E D bD neg) y, ⟨y, rfl⟩, ?_⟩
    change AffineWeil.rationalPointsEquiv F E (BinaryRoot.groupScheme E D)
      (rationalPoints.map (AffineWeil.map F E (BinaryRoot.elementaryMap E D bD neg)) y) = _
    rw [AffineWeil.rationalPointsEquiv_map]
    exact congrArg (rationalPoints.map (BinaryRoot.elementaryMap E D bD neg))
      ((AffineWeil.rationalPointsEquiv F E
        (FiniteAlgebraUnits.BinaryRoot.additiveScheme E (d := d))).apply_symm_apply x)

/-- Rational comparison identifies the actual generated elementary subgroups. -/
theorem map_rationalElementarySubgroup :
    (rationalElementarySubgroup F E D bD).map
        (AffineWeil.rationalPointsEquiv F E (BinaryRoot.groupScheme E D)).toMonoidHom =
      BinaryRoot.rationalElementarySubgroup E D bD := by
  rw [rationalElementarySubgroup, Subgroup.map_sup,
    map_rationalElementaryRange, map_rationalElementaryRange]
  rfl

/-- Full rational generation of the restriction is equivalent to original rational generation. -/
theorem rationalElementarySubgroup_eq_top_iff_original :
    rationalElementarySubgroup F E D bD = ⊤ ↔
      BinaryRoot.rationalElementarySubgroup E D bD = ⊤ := by
  let e := AffineWeil.rationalPointsEquiv F E (BinaryRoot.groupScheme E D)
  constructor
  · intro h
    rw [← map_rationalElementarySubgroup F E D bD, h, Subgroup.map_top]
    exact e.toMonoidHom.range_eq_top.mpr e.surjective
  · intro h
    apply top_unique
    intro x _
    have hx : e x ∈ (rationalElementarySubgroup F E D bD).map e.toMonoidHom := by
      rw [map_rationalElementarySubgroup, h]
      trivial
    obtain ⟨y, hy, hyx⟩ := hx
    rwa [e.injective hyx] at hy

variable {G : GroupScheme (Spec (CommRingCat.of F))}

/-- Each original restricted elementary point maps to an actual
geometric parabolic-radical generator in a connected reductive target. -/
theorem map_elementaryPoint_mem_parabolicUnipotentPointSet
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G) (neg : Bool)
    (x : rationalPoints (additiveScheme F E d)) :
    rationalPoints.map f (rationalPoints.map (elementaryMap F E D bD neg) x) ∈
      parabolicUnipotentPointSet G := by
  have hx : rationalPoints.map (elementaryMap F E D bD neg) x ∈
      (Dynamic.unipotent (cocharacter F E D neg)).carrier (Over.mk (𝟙 _)) :=
    elementary_range_le_dynamicUnipotent F E D bD neg _
      (SubgroupFunctor.mem_range.mpr ⟨x, rfl⟩)
  exact mem_parabolicUnipotentPointSet_of_dynamicUnipotent hG
    (cocharacter F E D neg ≫ f)
    (Dynamic.unipotent_le_comap (cocharacter F E D neg) f _ hx)

/-- Both actual restricted elementary images map into the target's
actual parabolic elementary subgroup. -/
theorem map_elementary_range_le_parabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G) (neg : Bool) :
    ((rationalPoints.map (elementaryMap F E D bD neg)).range).map
        (rationalPoints.map f) ≤ parabolicElementarySubgroup G := by
  rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
  exact Subgroup.subset_closure
    (map_elementaryPoint_mem_parabolicUnipotentPointSet F E D bD hG f neg x)

/-- The whole subgroup generated by actual restricted elementary points
maps into the target's actual parabolic elementary subgroup. -/
theorem map_rationalElementarySubgroup_le_parabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G) :
    (rationalElementarySubgroup F E D bD).map (rationalPoints.map f) ≤
      parabolicElementarySubgroup G := by
  rw [rationalElementarySubgroup, Subgroup.map_sup]
  exact sup_le
    (map_elementary_range_le_parabolicElementarySubgroup F E D bD hG f false)
    (map_elementary_range_le_parabolicElementarySubgroup F E D bD hG f true)

/-- The original rational map on the generated restricted elementary subgroup,
with its codomain restricted to the target's actual elementary subgroup. -/
def rationalElementaryPointsToParabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G) :
    rationalElementarySubgroup F E D bD →* parabolicElementarySubgroup G :=
  ((rationalPoints.map f).comp (rationalElementarySubgroup F E D bD).subtype).codRestrict
    (parabolicElementarySubgroup G) fun x =>
      map_rationalElementarySubgroup_le_parabolicElementarySubgroup F E D bD hG f
        ⟨x.val, x.property, rfl⟩

@[simp]
theorem rationalElementaryPointsToParabolicElementarySubgroup_apply_coe
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G)
    (x : rationalElementarySubgroup F E D bD) :
    (rationalElementaryPointsToParabolicElementarySubgroup F E D bD hG f x :
      rationalPoints G) = rationalPoints.map f x.val := rfl

section DivisionRing

variable {D : Type u} [DivisionRing D] [Algebra E D]
  [FiniteDimensional E D] [Algebra.IsCentral E D]
  {d : ℕ} (bD : Module.Basis (Fin d) E D)

/-- Full actual rational elementary generation of the restriction is exactly
coefficient SK1 vanishing over the original coefficient field. -/
theorem rationalElementarySubgroup_eq_top_iff :
    rationalElementarySubgroup F E D bD = ⊤ ↔
      (Langlands.BinaryElementary.Reduced.coefficientNorm E D).ker = commutator Dˣ :=
  (rationalElementarySubgroup_eq_top_iff_original F E D bD).trans
    (BinaryRoot.rationalElementarySubgroup_eq_top_iff E bD)

/-- Coefficient SK1 vanishing puts the full actual restricted binary image
in the target's elementary subgroup. The arithmetic premise is explicit. -/
theorem rationalPoints_range_le_parabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm E D).ker = commutator Dˣ) :
    (rationalPoints.map f).range ≤ parabolicElementarySubgroup G := by
  have h := map_rationalElementarySubgroup_le_parabolicElementarySubgroup
    F E D (Module.finBasis E D) hG f
  rw [(rationalElementarySubgroup_eq_top_iff F E (Module.finBasis E D)).mpr hSK,
    Subgroup.map_top] at h
  exact h

/-- The original full rational point map with restricted codomain, under the
explicit coefficient SK1 equality. -/
def rationalPointsToParabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm E D).ker = commutator Dˣ) :
    rationalPoints (groupScheme F E D) →* parabolicElementarySubgroup G :=
  (rationalPoints.map f).codRestrict (parabolicElementarySubgroup G) fun x =>
    rationalPoints_range_le_parabolicElementarySubgroup F E hG f hSK ⟨x, rfl⟩

@[simp]
theorem rationalPointsToParabolicElementarySubgroup_apply_coe
    (hG : IsConnectedReductive G) (f : groupScheme F E D ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm E D).ker = commutator Dˣ)
    (x : rationalPoints (groupScheme F E D)) :
    (rationalPointsToParabolicElementarySubgroup F E hG f hSK x : rationalPoints G) =
      rationalPoints.map f x := rfl

/-- Full-image containment for any specified actual model of the restricted source. -/
theorem rationalPoints_range_le_parabolicElementarySubgroup_of_iso
    {A : GroupScheme (Spec (CommRingCat.of F))}
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme F E D) (a : A ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm E D).ker = commutator Dˣ) :
    (rationalPoints.map a).range ≤ parabolicElementarySubgroup G := by
  have h := rationalPoints_range_le_parabolicElementarySubgroup F E hG (e.inv ≫ a) hSK
  rintro _ ⟨x, rfl⟩
  have hx := h ⟨rationalPoints.map e.hom x, rfl⟩
  simpa only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc,
    ← Grp.comp_hom_hom, e.hom_inv_id_assoc] using hx

end DivisionRing

end Langlands.GroupScheme.CentralSimpleUnits.BinaryRoot.WeilRoot
