import Langlands.RingTheory.WeilRestriction.FiniteType
import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap

/-! # Connectedness of finite-type Weil restrictions along a local Artinian coefficient algebra

Let `k` be an algebraically closed field, `B` a finite `k`-algebra whose residue map
`B → k` has nilpotent kernel, and `O` a formally smooth finite-type `B`-algebra. The
rational points of the Weil restriction `W` of `O` are the `B`-points of `O`. Two such
points with the same reduction are joined by an affine line (`exists_path`), and a
formally smooth lift of the special fibre `k ⊗[B] O` joins all reductions. Hence, if the
special fibre is connected and `O` has a `B`-point, the spectrum of `W` is connected. -/

noncomputable section

universe u

open scoped TensorProduct Polynomial

namespace Langlands.GroupScheme.IntegralModel.EqualCharacteristicGreenberg

open Langlands.Algebra

section Topology

/-- In a compact T0 space, if every closed point lies in the connected component of one
point, the space is connected: every nonempty clopen set contains a closed point. -/
theorem connectedSpace_of_closedPoints {X : Type*} [TopologicalSpace X] [T0Space X]
    [CompactSpace X] (x₀ : X)
    (h : ∀ x : X, IsClosed ({x} : Set X) → x ∈ connectedComponent x₀) : ConnectedSpace X := by
  rw [connectedSpace_iff_clopen]
  refine ⟨⟨x₀⟩, fun s hs => ?_⟩
  by_cases hx₀ : x₀ ∈ s
  · right
    by_contra hne
    obtain ⟨y, hy, hyc⟩ := hs.compl.isClosed.exists_closed_singleton
      (Set.nonempty_compl.mpr hne)
    exact hy (hs.connectedComponent_subset hx₀ (h y hyc))
  · left
    by_contra hne
    obtain ⟨y, hy, hyc⟩ := hs.isClosed.exists_closed_singleton
      (Set.nonempty_iff_ne_empty.mpr hne)
    have hcc := connectedComponent_eq (h y hyc)
    exact hx₀ (hs.connectedComponent_subset hy (by rw [← hcc]; exact mem_connectedComponent))

end Topology

section Points

variable {k R : Type*} [Field k] [CommRing R] [Algebra k R]

/-- The prime ideal of a rational point of an algebra. -/
def ratPoint (ψ : R →ₐ[k] k) : PrimeSpectrum R :=
  ⟨RingHom.ker ψ, RingHom.ker_isPrime ψ⟩

theorem comap_ratPoint {T : Type*} [CommRing T] [Algebra k T] (φ : R →ₐ[k] T)
    (t : T →ₐ[k] k) :
    PrimeSpectrum.comap (φ : R →+* T) (ratPoint t) = ratPoint (t.comp φ) := by
  apply PrimeSpectrum.ext
  ext x
  simp [ratPoint, RingHom.mem_ker]

/-- Rational points factoring through an algebra with connected spectrum lie in one
connected component. -/
theorem ratPoint_mem_connectedComponent {T : Type*} [CommRing T] [Algebra k T]
    [ConnectedSpace (PrimeSpectrum T)] (φ : R →ₐ[k] T) (t t' : T →ₐ[k] k) :
    ratPoint (t.comp φ) ∈ connectedComponent (ratPoint (t'.comp φ)) := by
  have hconn := isConnected_range (PrimeSpectrum.continuous_comap (φ : R →+* T))
  rw [← comap_ratPoint, ← comap_ratPoint]
  exact hconn.isPreconnected.subset_connectedComponent ⟨_, rfl⟩ ⟨_, rfl⟩

/-- **Nullstellensatz.** Over an algebraically closed field, every closed point of the
spectrum of a finite-type algebra is a rational point. -/
theorem exists_ratPoint_eq [IsAlgClosed k] [Algebra.FiniteType k R] (x : PrimeSpectrum R)
    (hx : IsClosed ({x} : Set (PrimeSpectrum R))) : ∃ ψ : R →ₐ[k] k, ratPoint ψ = x := by
  have hm : x.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal x).mp hx
  let : Field (R ⧸ x.asIdeal) := Ideal.Quotient.field x.asIdeal
  have : Algebra.FiniteType k (R ⧸ x.asIdeal) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k x.asIdeal)
      Ideal.Quotient.mk_surjective
  have : Module.Finite k (R ⧸ x.asIdeal) := finite_of_finite_type_of_isJacobsonRing k _
  have hbij : Function.Bijective (algebraMap k (R ⧸ x.asIdeal)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : k ≃ₐ[k] R ⧸ x.asIdeal := AlgEquiv.ofBijective (Algebra.ofId k _) hbij
  refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k x.asIdeal), ?_⟩
  apply PrimeSpectrum.ext
  ext r
  simp [ratPoint, RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]

end Points

section Path

variable {B O P D : Type*} [CommRing B] [CommRing O] [CommRing P] [CommRing D]
  [Algebra B O] [Algebra B P] [Algebra B D] [Algebra.FormallySmooth B O]

/-- **Affine-line paths.** Let `ι : D → P` be a section of two evaluations `e₀, e₁ : P → D`
sending `t` to `0` and `1`. Two points `f, g` of a formally smooth algebra which agree
modulo a nilpotent ideal are the two ends of one `P`-point: lift `g + t (f - g)`, which is
multiplicative modulo the nilpotent ideal generated by `t (t - 1) I`. -/
theorem exists_path (ι : D →ₐ[B] P) (e₀ e₁ : P →ₐ[B] D) (t : P)
    (h₀ : ∀ d, e₀ (ι d) = d) (h₁ : ∀ d, e₁ (ι d) = d) (ht₀ : e₀ t = 0) (ht₁ : e₁ t = 1)
    (I : Ideal D) (hI : IsNilpotent I) (f g : O →ₐ[B] D) (hfg : ∀ o, f o - g o ∈ I) :
    ∃ h : O →ₐ[B] P, (∀ o, e₁ (h o) = f o) ∧ ∀ o, e₀ (h o) = g o := by
  let J : Ideal P := Ideal.span {t * (t - 1)} * I.map ι
  have hJ : IsNilpotent J := by
    obtain ⟨N, hN⟩ := hI
    refine ⟨N, ?_⟩
    have h1 : J ^ N ≤ (I.map ι) ^ N := Ideal.pow_right_mono Ideal.mul_le_right N
    have h2 : (I.map ι) ^ N = ⊥ := by
      rw [← Ideal.map_pow, hN, Ideal.zero_eq_bot, Ideal.map_bot]
    exact le_bot_iff.mp (h2 ▸ h1)
  let u : O → P := fun o => ι (g o) + t * ι (f o - g o)
  have hu_mul : ∀ a b, u (a * b) - u a * u b ∈ J := by
    intro a b
    have : u (a * b) - u a * u b = (t * (t - 1)) * ι (-((f a - g a) * (f b - g b))) := by
      simp only [u, map_mul, map_sub, map_neg]
      ring
    rw [this]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _)
      (Ideal.mem_map_of_mem _ (I.neg_mem (I.mul_mem_right _ (hfg a))))
  let g₀ : O →ₐ[B] P ⧸ J :=
    { toFun := fun o => Ideal.Quotient.mk J (u o)
      map_one' := by simp [u]
      map_mul' := fun a b => by
        rw [← map_mul, Ideal.Quotient.eq]
        exact hu_mul a b
      map_zero' := by simp [u]
      map_add' := fun a b => by
        rw [← map_add]
        congr 1
        simp only [u, map_add, map_sub]
        ring
      commutes' := fun b => by
        simp only [u, AlgHom.commutes, sub_self, map_zero, mul_zero, add_zero]
        rfl }
  let h := Algebra.FormallySmooth.lift J hJ g₀
  have hh : ∀ o, h o - u o ∈ J := fun o => by
    rw [← Ideal.Quotient.eq, Algebra.FormallySmooth.mk_lift]
    rfl
  have hker : ∀ e : P →ₐ[B] D, e t * (e t - 1) = 0 → ∀ x ∈ J, e x = 0 := by
    intro e he x hx
    have hle : J ≤ RingHom.ker e := by
      refine (Ideal.mul_le_left (I := Ideal.span {t * (t - 1)}) (J := I.map ι)).trans ?_
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        map_mul, map_sub, map_one]
      exact he
    exact hle hx
  refine ⟨h, fun o => ?_, fun o => ?_⟩
  · have := hker e₁ (by rw [ht₁]; ring) _ (hh o)
    rw [map_sub, sub_eq_zero] at this
    rw [this]
    simp [u, h₁, ht₁]
  · have := hker e₀ (by rw [ht₀]; ring) _ (hh o)
    rw [map_sub, sub_eq_zero] at this
    rw [this]
    simp [u, h₀, ht₀]

end Path

section Weil

variable (k B O : Type u) [Field k] [CommRing B] [Algebra k B] [Module.Finite k B]
  [CommRing O] [Algebra B O] [Algebra.FiniteType B O]

/-- The `B`-point of `O` attached to a rational point of its Weil restriction. -/
def basePoint (ψ : WeilRestrictionFiniteType k B O →ₐ[k] k) : O →ₐ[B] B :=
  (Algebra.TensorProduct.rid k B B).toAlgHom.comp
    (WeilRestrictionFiniteType.homEquiv k B O k ψ)

theorem basePoint_comp {T : Type u} [CommRing T] [Algebra k T]
    (φ : WeilRestrictionFiniteType k B O →ₐ[k] T) (t : T →ₐ[k] k) :
    basePoint k B O (t.comp φ) = (Algebra.TensorProduct.rid k B B).toAlgHom.comp
      ((Algebra.TensorProduct.lTensor B t).comp
        (WeilRestrictionFiniteType.homEquiv k B O T φ)) := by
  rw [basePoint, WeilRestrictionFiniteType.homEquiv_comp]

theorem basePoint_bijective : Function.Bijective (basePoint k B O) := by
  constructor
  · intro ψ ψ' h
    apply (WeilRestrictionFiniteType.homEquiv k B O k).injective
    exact AlgHom.ext fun o => (Algebra.TensorProduct.rid k B B).injective
      (DFunLike.congr_fun h o)
  · intro p
    refine ⟨(WeilRestrictionFiniteType.homEquiv k B O k).symm
      ((Algebra.TensorProduct.rid k B B).symm.toAlgHom.comp p), ?_⟩
    apply AlgHom.ext
    intro o
    simp [basePoint]

variable [Algebra B k] [IsScalarTower k B k] [Algebra.FormallySmooth B O]

omit [IsScalarTower k B k] in
/-- Rational points of the Weil restriction whose `B`-points have the same reduction lie in
one connected component: they are joined by an affine line. -/
theorem ratPoint_mem_of_reduction_eq (hnil : IsNilpotent (RingHom.ker (algebraMap B k)))
    (ψ ψ' : WeilRestrictionFiniteType k B O →ₐ[k] k)
    (h : ∀ o, algebraMap B k (basePoint k B O ψ o) = algebraMap B k (basePoint k B O ψ' o)) :
    ratPoint ψ ∈ connectedComponent (ratPoint ψ') := by
  let ev : k → (B ⊗[k] k[X] →ₐ[B] B) := fun c =>
    (Algebra.TensorProduct.rid k B B).toAlgHom.comp
      (Algebra.TensorProduct.lTensor B (Polynomial.aeval c))
  obtain ⟨γ, γ1, γ0⟩ := exists_path
    (Algebra.TensorProduct.includeLeft : B →ₐ[B] B ⊗[k] k[X]) (ev 0) (ev 1)
    ((1 : B) ⊗ₜ Polynomial.X) (fun d => by simp [ev]) (fun d => by simp [ev])
    (by simp [ev]) (by simp [ev]) (RingHom.ker (algebraMap B k)) hnil
    (basePoint k B O ψ) (basePoint k B O ψ')
    (fun o => by rw [RingHom.mem_ker, map_sub, h o, sub_self])
  let φ := (WeilRestrictionFiniteType.homEquiv k B O k[X]).symm γ
  have hc : ∀ c : k, basePoint k B O ((Polynomial.aeval c).comp φ) = (ev c).comp γ := by
    intro c
    rw [basePoint_comp, Equiv.apply_symm_apply, AlgHom.comp_assoc]
  have e1 : (Polynomial.aeval (1 : k)).comp φ = ψ := by
    apply (basePoint_bijective k B O).1
    rw [hc]
    exact AlgHom.ext γ1
  have e0 : (Polynomial.aeval (0 : k)).comp φ = ψ' := by
    apply (basePoint_bijective k B O).1
    rw [hc]
    exact AlgHom.ext γ0
  rw [← e1, ← e0]
  exact ratPoint_mem_connectedComponent φ _ _

omit [IsScalarTower k B k] in
/-- **Connectedness from a section.** If a `B`-point `s` of `O` with coefficients in
`B ⊗[k] A`, for a `k`-algebra `A` with connected spectrum, realizes every reduction of a
`B`-point, and `O` has a `B`-point, then the Weil restriction has connected spectrum. -/
theorem connectedSpace_of_section [IsAlgClosed k]
    (hnil : IsNilpotent (RingHom.ker (algebraMap B k)))
    {A : Type u} [CommRing A] [Algebra k A] [ConnectedSpace (PrimeSpectrum A)]
    (s : O →ₐ[B] B ⊗[k] A)
    (hs : ∀ p : O →ₐ[B] B, ∃ a : A →ₐ[k] k, ∀ o,
      algebraMap B k (Algebra.TensorProduct.rid k B B
        (Algebra.TensorProduct.lTensor (S := B) B a (s o))) = algebraMap B k (p o))
    (e : O →ₐ[B] B) :
    ConnectedSpace (PrimeSpectrum (WeilRestrictionFiniteType k B O)) := by
  let φ := (WeilRestrictionFiniteType.homEquiv k B O A).symm s
  have key : ∀ ψ : WeilRestrictionFiniteType k B O →ₐ[k] k, ∃ a : A →ₐ[k] k,
      ratPoint ψ ∈ connectedComponent (ratPoint (a.comp φ)) := by
    intro ψ
    obtain ⟨a, ha⟩ := hs (basePoint k B O ψ)
    refine ⟨a, ratPoint_mem_of_reduction_eq k B O hnil ψ (a.comp φ) fun o => ?_⟩
    rw [basePoint_comp, Equiv.apply_symm_apply]
    exact (ha o).symm
  obtain ⟨ψ₀, -⟩ := (basePoint_bijective k B O).2 e
  obtain ⟨a₀, h₀⟩ := key ψ₀
  refine connectedSpace_of_closedPoints (ratPoint ψ₀) fun x hx => ?_
  obtain ⟨ψ, rfl⟩ := exists_ratPoint_eq (k := k) x hx
  obtain ⟨a, ha⟩ := key ψ
  have h1 : ratPoint (a.comp φ) ∈ connectedComponent (ratPoint (a₀.comp φ)) :=
    ratPoint_mem_connectedComponent φ a a₀
  rw [← connectedComponent_eq h₀, connectedComponent_eq h1]
  exact ha

omit [Module.Finite k B] [Algebra.FiniteType B O] in
/-- **The special-fibre section.** Formal smoothness lifts the canonical map from `O` to
its special fibre `A = k ⊗[B] O` through `B ⊗[k] A → A`, whose kernel is generated by
the nilpotent residue kernel of `B`. Every reduction of a `B`-point is then realized. -/
theorem exists_section (hnil : IsNilpotent (RingHom.ker (algebraMap B k))) :
    ∃ s : O →ₐ[B] B ⊗[k] (k ⊗[B] O), ∀ p : O →ₐ[B] B, ∃ a : (k ⊗[B] O) →ₐ[k] k, ∀ o,
      algebraMap B k (Algebra.TensorProduct.rid k B B
        (Algebra.TensorProduct.lTensor (S := B) B a (s o))) = algebraMap B k (p o) := by
  let A := k ⊗[B] O
  let C := B ⊗[k] A
  let I : Ideal C := (RingHom.ker (algebraMap B k)).map (algebraMap B C)
  have hI : IsNilpotent I := by
    obtain ⟨N, hN⟩ := hnil
    refine ⟨N, ?_⟩
    rw [Ideal.zero_eq_bot, ← Ideal.map_pow, hN, Ideal.zero_eq_bot, Ideal.map_bot]
  let inc : O →+* C := (Algebra.TensorProduct.includeRight : A →ₐ[k] C).toRingHom.comp
    (Algebra.TensorProduct.includeRight : O →ₐ[B] A).toRingHom
  have hinc : ∀ b : B, inc (algebraMap B O b) =
      algebraMap B C (algebraMap k B (algebraMap B k b)) := by
    intro b
    change (Algebra.TensorProduct.includeRight : A →ₐ[k] C)
      ((Algebra.TensorProduct.includeRight : O →ₐ[B] A) (algebraMap B O b)) = _
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply B k A, AlgHom.commutes,
      ← IsScalarTower.algebraMap_apply k B C]
  have hred : ∀ b : B, algebraMap k B (algebraMap B k b) - b ∈ RingHom.ker (algebraMap B k) := by
    intro b
    rw [RingHom.mem_ker, map_sub, ← IsScalarTower.algebraMap_apply k B k,
      Algebra.algebraMap_self_apply, sub_self]
  let g₀ : O →ₐ[B] C ⧸ I :=
    { toRingHom := (Ideal.Quotient.mk I).comp inc
      commutes' := fun b => by
        change Ideal.Quotient.mk I (inc (algebraMap B O b)) = _
        rw [hinc, ← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq, ← map_sub]
        exact Ideal.mem_map_of_mem _ (hred b) }
  let s := Algebra.FormallySmooth.lift I hI g₀
  have hs : ∀ o, s o - inc o ∈ I := fun o => by
    rw [← Ideal.Quotient.eq, Algebra.FormallySmooth.mk_lift]
    rfl
  refine ⟨s, fun p => ?_⟩
  let a : A →ₐ[k] k := Algebra.TensorProduct.lift (AlgHom.id k k)
    ((Algebra.ofId B k).comp p) (fun _ _ => Commute.all _ _)
  refine ⟨a, fun o => ?_⟩
  let F : C →ₐ[B] k := (Algebra.ofId B k).comp
    ((Algebra.TensorProduct.rid k B B).toAlgHom.comp (Algebra.TensorProduct.lTensor (S := B) B a))
  have hFI : I ≤ RingHom.ker F := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes]
    exact hx
  have h1 := hFI (hs o)
  rw [RingHom.mem_ker, map_sub, sub_eq_zero] at h1
  change F (s o) = _
  rw [h1]
  change algebraMap B k (Algebra.TensorProduct.rid k B B
    ((1 : B) ⊗ₜ a ((1 : k) ⊗ₜ o))) = _
  rw [Algebra.TensorProduct.rid_tmul, Algebra.TensorProduct.lift_tmul, map_one, one_mul,
    Algebra.smul_def, mul_one, ← IsScalarTower.algebraMap_apply k B k,
    Algebra.algebraMap_self_apply]
  rfl

/-- **Connectedness of the Weil restriction.** If the special fibre `k ⊗[B] O` has connected
spectrum and `O` has a `B`-point, the finite-type Weil restriction of `O` along `B` has
connected spectrum. -/
theorem connectedSpace_weilRestriction [IsAlgClosed k]
    (hnil : IsNilpotent (RingHom.ker (algebraMap B k)))
    [ConnectedSpace (PrimeSpectrum (k ⊗[B] O))] (e : O →ₐ[B] B) :
    ConnectedSpace (PrimeSpectrum (WeilRestrictionFiniteType k B O)) := by
  obtain ⟨s, hs⟩ := exists_section k B O hnil
  exact connectedSpace_of_section k B O hnil s hs e

end Weil

end Langlands.GroupScheme.IntegralModel.EqualCharacteristicGreenberg
