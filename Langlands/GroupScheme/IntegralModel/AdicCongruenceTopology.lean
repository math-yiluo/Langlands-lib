import Langlands.GroupScheme.IntegralModel.CongruenceNeighborhoodBasisProof
import Langlands.Geometry.Building.KPUnramifiedNormedTopology
import Langlands.Galois.Local.SeparableUnramifiedArithmeticProof
import Mathlib.Analysis.SpecificLimits.Basic

/-! # Congruence neighborhoods without compactness -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology Filter
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.IntegralModel

open Langlands.AlgebraicGeometry.PointTopology

section Sections

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K] [IsLocalRing R]
  {G : GroupScheme (Spec (CommRingCat.of K))}
  (M : IntegralModel R K G)
  [TopologicalSpace R] [IsTopologicalRing R]

private instance adicCongruenceModelAffine : IsAffine M.group.X.left :=
  isAffine_of_isAffineHom M.group.X.hom

local instance adicCongruenceSectionTopology : TopologicalSpace M.integralSections :=
  rationalPointTopology R M.group.X

/-- The filter generated by the actual positive reduction kernels of the
specified integral model. -/
def congruenceKernelFilter : Filter M.integralSections :=
  ⨅ n : ℕ+, 𝓟 (M.congruenceKernelAt n : Set M.integralSections)

/-- If powers of the actual maximal ideal are cofinal at zero, actual
positive reduction kernels are cofinal at the identity in the section topology. -/
theorem congruenceKernelAt_cofinal_of_maximalIdealPowers
    (hsmall : ∀ V ∈ 𝓝 (0 : R), ∃ n : ℕ+,
      (((IsLocalRing.maximalIdeal R) ^ (n : ℕ) : Ideal R) : Set R) ⊆ V)
    (U : Set M.integralSections) (hU : U ∈ 𝓝 (1 : M.integralSections)) :
    ∃ n : ℕ+, (M.congruenceKernelAt n : Set M.integralSections) ⊆ U := by
  let B : Filter M.integralSections := M.congruenceKernelFilter
  have hdir : Directed (· ⊇ ·)
      (fun n : ℕ+ => (M.congruenceKernelAt n : Set M.integralSections)) := by
    intro n m
    exact ⟨max n m, M.congruenceKernelAt_antitone (le_max_left _ _),
      M.congruenceKernelAt_antitone (le_max_right _ _)⟩
  have hb : B.HasBasis (fun _ : ℕ+ => True)
      (fun n => (M.congruenceKernelAt n : Set M.integralSections)) :=
    Filter.hasBasis_iInf_principal hdir
  let Φ := (rationalPointHomeomorph R M.group.X).trans
    (affineSchemePointHomeomorph R M.group.X R)
  have hΦ : Tendsto Φ B (𝓝 (Φ 1)) := by
    rw [AlgPoint.isEmbedding_evaluation.isInducing.tendsto_nhds_iff]
    apply tendsto_pi_nhds.mpr
    intro a
    apply tendsto_def.mpr
    intro V hV
    change V ∈ 𝓝 (M.integralCoordinateAlgHom 1 a) at hV
    have htrans : Continuous (fun r : R => M.integralCoordinateAlgHom 1 a + r) :=
      continuous_const.add continuous_id
    have hV' : (fun r : R => M.integralCoordinateAlgHom 1 a + r) ⁻¹' V ∈
        𝓝 (0 : R) := by
      exact htrans.continuousAt.preimage_mem_nhds (by simpa only [add_zero] using hV)
    obtain ⟨n, hn⟩ := hsmall _ hV'
    apply hb.mem_iff.mpr
    refine ⟨n, trivial, ?_⟩
    intro x hx
    have hx' := (M.reductionAt_eq_iff_integralCoordinates n x 1).mp
      (((M.mem_congruenceKernelAt n x).mp hx).trans (map_one _).symm) a
    have := hn hx'
    change M.integralCoordinateAlgHom 1 a +
      (M.integralCoordinateAlgHom x a - M.integralCoordinateAlgHom 1 a) ∈ V at this
    change M.integralCoordinateAlgHom x a ∈ V
    simpa only [← add_sub_assoc, add_sub_cancel_left] using this
  have hid : Tendsto (id : M.integralSections → M.integralSections) B
      (𝓝 (1 : M.integralSections)) := by
    exact Φ.isInducing.tendsto_nhds_iff.mpr hΦ
  obtain ⟨n, _, hn⟩ := hb.mem_iff.mp (hid hU)
  exact ⟨n, hn⟩

variable [TopologicalSpace K] [IsTopologicalRing K] [IsAffine G.X.left]

local instance adicCongruenceGenericTopology : TopologicalSpace (rationalPoints G) :=
  rationalPointTopology K G.X

/-- Continuity of the actual generic map transports the section result to
the original positive congruence subgroups in the specified generic group. -/
theorem congruenceSubgroupAt_cofinal_of_maximalIdealPowers
    (hsmall : ∀ V ∈ 𝓝 (0 : R), ∃ n : ℕ+,
      (((IsLocalRing.maximalIdeal R) ^ (n : ℕ) : Ideal R) : Set R) ⊆ V)
    (hRK : Continuous (algebraMap R K))
    (U : Set (rationalPoints G)) (hU : U ∈ 𝓝 (1 : rationalPoints G)) :
    ∃ n : ℕ+, (M.congruenceSubgroupAt n : Set (rationalPoints G)) ⊆ U := by
  have hpre : M.integralPointMap ⁻¹' U ∈ 𝓝 (1 : M.integralSections) := by
    simpa only [map_one] using
      (M.continuous_integralPointMap hRK).continuousAt.preimage_mem_nhds
        (by simpa only [map_one] using hU)
  obtain ⟨n, hn⟩ := M.congruenceKernelAt_cofinal_of_maximalIdealPowers hsmall _ hpre
  refine ⟨n, ?_⟩
  rintro g ⟨x, hx, rfl⟩
  exact hn hx

end Sections

section OpenImage

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]
  {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffine G.X.left]
  (M : IntegralModel R K G)
  [TopologicalSpace K]

private instance adicOpenImageModelAffine : IsAffine M.group.X.left :=
  isAffine_of_isAffineHom M.group.X.hom

local instance adicOpenImageTopology : TopologicalSpace (rationalPoints G) :=
  rationalPointTopology K G.X

/-- Original-model coordinates are continuous for any topological field base. -/
theorem continuous_coordinateAlgHom_apply_generic
    (a : AffineCoordinateRing R M.group.X) :
    Continuous fun g : rationalPoints G => M.coordinateAlgHom g a := by
  have hc : Continuous (fun g : rationalPoints G =>
      rationalPointAlgebraHom K G.X g (M.genericCoordinate a)) :=
    (AlgPoint.continuous_eval _).comp
      ((affineSchemePointHomeomorph K G.X K).continuous.comp
        (rationalPointHomeomorph K G.X).continuous)
  convert hc using 1
  funext g
  rw [coordinateAlgHom_apply, GaloisPointComparison.rationalCoeffEquiv_eq]
  exact (affineSchemePointEquiv_apply_eq_evaluation G _ _).symm

/-- An open coefficient-ring image makes the actual finite-type model's
integral-point image open. -/
theorem isOpen_integralPoints_of_isOpen_range
    (hR : IsOpen (Set.range (algebraMap R K))) :
    IsOpen (M.integralPoints : Set (rationalPoints G)) := by
  obtain ⟨s, hs⟩ := (inferInstance :
    Algebra.FiniteType R (AffineCoordinateRing R M.group.X)).out
  have heq : (M.integralPoints : Set (rationalPoints G)) =
      ⋂ a ∈ s, (fun g => M.coordinateAlgHom g a) ⁻¹'
        Set.range (algebraMap R K) := by
    ext g
    simp only [SetLike.mem_coe, Set.mem_iInter, Set.mem_preimage]
    exact M.mem_integralPoints_iff_of_adjoin_eq_top hs g
  rw [heq]
  exact isOpen_biInter_finset fun a _ =>
    hR.preimage (M.continuous_coordinateAlgHom_apply_generic a)

end OpenImage

end Langlands.GroupScheme.IntegralModel

namespace Langlands.LocalGalois.Separable

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

/-- Positive powers of the maximal ideal of the actual unramified integer
ring are cofinal at zero in its induced spectral-norm topology. -/
theorem fixedFieldIntegers_maximalIdealPowers_cofinal :
    letI : NontriviallyNormedField (inertiaFixedField F) := fixedFieldNormedField F
    ∀ V ∈ 𝓝 (0 : fixedFieldIntegers F), ∃ n : ℕ+,
      (((IsLocalRing.maximalIdeal (fixedFieldIntegers F)) ^ (n : ℕ) :
        Ideal (fixedFieldIntegers F)) : Set (fixedFieldIntegers F)) ⊆ V := by
  let : NontriviallyNormedField (inertiaFixedField F) := fixedFieldNormedField F
  let : IsDiscreteValuationRing (fixedFieldIntegers F) :=
    (separableUnramifiedArithmetic F).2.2.2.1
  intro V hV
  obtain ⟨ε, hε, hεV⟩ := Metric.mem_nhds_iff.mp hV
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible (fixedFieldIntegers F)
  have hπnorm : ‖π‖ < 1 := by
    have hm : π ∈ IsLocalRing.maximalIdeal (fixedFieldIntegers F) :=
      (IsLocalRing.mem_maximalIdeal π).mpr hπ.not_isUnit
    have hv := (Valuation.mem_maximalIdeal_iff (v := fixedFieldValuation F)).mp hm
    exact NNReal.coe_lt_coe.mpr hv
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hε hπnorm
  refine ⟨⟨n + 1, Nat.succ_pos n⟩, ?_⟩
  intro r hr
  change r ∈ ((IsLocalRing.maximalIdeal (fixedFieldIntegers F)) ^ (n + 1) :
    Ideal (fixedFieldIntegers F)) at hr
  have hr' : π ^ (n + 1) ∣ r := by
    rw [hπ.maximalIdeal_eq, Ideal.span_singleton_pow] at hr
    exact Ideal.mem_span_singleton.mp hr
  obtain ⟨s, rfl⟩ := hr'
  apply hεV
  rw [Metric.mem_ball, dist_zero_right]
  have hs : ‖s‖ ≤ 1 := NNReal.coe_le_coe.mpr s.property
  calc
    ‖π ^ (n + 1) * s‖ ≤ ‖π ^ (n + 1)‖ * ‖s‖ := norm_mul_le _ _
    _ ≤ ‖π‖ ^ (n + 1) * 1 := mul_le_mul (norm_pow_le _ _) hs (norm_nonneg _) (by positivity)
    _ = ‖π‖ ^ (n + 1) := mul_one _
    _ ≤ ‖π‖ ^ n := pow_le_pow_of_le_one (norm_nonneg _) hπnorm.le (Nat.le_succ n)
    _ < ε := hn

end Langlands.LocalGalois.Separable

namespace Langlands.GroupScheme.IntegralModel

open Langlands.LocalGalois.Separable
open Langlands.AlgebraicGeometry.PointTopology

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
  [IsAffine G.X.left]
  (M : IntegralModel (fixedFieldIntegers F) (inertiaFixedField F) G)

/-- Actual positive congruence subgroups are cofinal at the identity for
the published maximal-unramified rational-point topology. -/
theorem congruenceSubgroupAt_cofinal_unramified
    (U : Set (rationalPoints G)) :
    letI : TopologicalSpace (inertiaFixedField F) := fixedFieldTopology F
    letI : TopologicalSpace (rationalPoints G) :=
      rationalPointTopology (inertiaFixedField F) G.X
    U ∈ 𝓝 (1 : rationalPoints G) →
      ∃ n : ℕ+, (M.congruenceSubgroupAt n : Set (rationalPoints G)) ⊆ U := by
  rw [← fixedFieldNormedField_topology F]
  let : NontriviallyNormedField (inertiaFixedField F) := fixedFieldNormedField F
  let : TopologicalSpace (rationalPoints G) :=
    rationalPointTopology (inertiaFixedField F) G.X
  intro hU
  exact M.congruenceSubgroupAt_cofinal_of_maximalIdealPowers
    (fixedFieldIntegers_maximalIdealPowers_cofinal F) continuous_subtype_val U hU

/-- The actual integral-point image is open over the maximal unramified
integer ring, without compactness of that ring. -/
theorem isOpen_integralPoints_unramified :
    letI : TopologicalSpace (inertiaFixedField F) := fixedFieldTopology F
    letI : TopologicalSpace (rationalPoints G) :=
      rationalPointTopology (inertiaFixedField F) G.X
    IsOpen (M.integralPoints : Set (rationalPoints G)) := by
  rw [← fixedFieldNormedField_topology F]
  let : NontriviallyNormedField (inertiaFixedField F) := fixedFieldNormedField F
  let : IsUltrametricDist (inertiaFixedField F) := fixedFieldNormedField_isUltrametricDist F
  let : TopologicalSpace (rationalPoints G) :=
    rationalPointTopology (inertiaFixedField F) G.X
  apply M.isOpen_integralPoints_of_isOpen_range
  have heq : Set.range (algebraMap (fixedFieldIntegers F) (inertiaFixedField F)) =
      Metric.closedBall (0 : inertiaFixedField F) 1 := by
    ext x
    simp only [Metric.mem_closedBall, dist_zero_right]
    constructor
    · rintro ⟨r, rfl⟩
      exact NNReal.coe_le_coe.mpr r.property
    · intro hx
      exact ⟨⟨x, NNReal.coe_le_coe.mp hx⟩, rfl⟩
  rw [heq]
  exact IsUltrametricDist.isOpen_closedBall _ one_ne_zero

end Langlands.GroupScheme.IntegralModel
