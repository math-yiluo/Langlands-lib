import Langlands.GroupScheme.IntegralModel.Smoothening.TerminationChainHopf
import Langlands.GroupScheme.IntegralModel.Smoothening.TerminationQuotient
import Langlands.GroupScheme.IntegralModel.Smoothening.TerminationChoice
import Langlands.GroupScheme.IntegralModel.Smoothening.TerminationPsi

/-! # The defect drops along the smoothening sequence

For the members `C n` of the smoothening sequence, the defect of `C (n+1)` plus the length of the
`ϖ`-torsion of the cotangent module of `C n` is at most the defect of `C n`. This combines the
dilatation computation, the Krull-intersection generators, the graded independence coming from the
smoothness of the closure of the reduced points, and the Γ-trick. -/

noncomputable section

universe u

open scoped TensorProduct
open IsLocalRing Coalgebra Bialgebra HopfAlgebra

namespace Langlands.GroupScheme.IntegralModel.Smoothening.Termination

variable {R : Type u} {K : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K] {A : Type u} [CommRing A] [HopfAlgebra R A]

section FG

variable [Algebra.FiniteType R A]

omit [Algebra.FiniteType R A] in
/-- The dilatation of a finitely generated member is finitely generated. -/
theorem dilat_fg {ϖ : R} (hϖ : Irreducible ϖ) (C : Subalgebra R (integralFunctions R K A))
    (hC : C.FG) : (dilat ϖ (jIdeal R K A C)).FG := by
  have : Algebra.FiniteType R C := (Subalgebra.fg_iff_finiteType C).mp hC
  have : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing R C
  obtain ⟨s, hs⟩ := (IsNoetherian.noetherian (jIdeal R K A C) : (jIdeal R K A C).FG)
  classical
  have hdiv : ∀ g ∈ s, ∃ b : integralFunctions R K A, (g : integralFunctions R K A) = ϖ • b := by
    intro g hg
    have hgJ : g ∈ jIdeal R K A C := hs ▸ Submodule.subset_span hg
    exact exists_eq_smul_of_dvd hϖ.ne_zero _ fun φ => by
      have := hgJ φ
      rw [hϖ.maximalIdeal_eq, Ideal.mem_span_singleton] at this
      exact this
  choose! b hb using hdiv
  have heq : dilat ϖ (jIdeal R K A C) = C ⊔ Algebra.adjoin R ((s.image b : Finset _) : Set _) := by
    apply le_antisymm
    · apply Algebra.adjoin_le
      rintro x (hx | ⟨j, hj, hjx⟩)
      · exact Algebra.mem_sup_left hx
      · have hj' : j ∈ Submodule.span C (s : Set C) := hs.symm ▸ hj
        obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hj'
        have hx : x = ∑ g ∈ s, ((f g : C) : integralFunctions R K A) * b g := by
          apply smul_right_injective _ hϖ.ne_zero
          change ϖ • x = ϖ • _
          rw [hjx, ← hf, Finset.smul_sum]
          simp only [AddSubmonoidClass.coe_finsetSum, smul_eq_mul, Subalgebra.coe_mul]
          exact Finset.sum_congr rfl fun g hg => by rw [hb g hg, mul_smul_comm]
        rw [hx]
        refine Subalgebra.sum_mem _ fun g hg => Subalgebra.mul_mem _
          (Algebra.mem_sup_left (f g).2) (Algebra.mem_sup_right (Algebra.subset_adjoin ?_))
        exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hg)
    · refine sup_le (le_dilat _) (Algebra.adjoin_le ?_)
      intro y hy
      obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hy)
      refine divSet_subset_dilat _ ⟨g, hs ▸ Submodule.subset_span hg, ?_⟩
      exact (hb g hg).symm
  rw [heq]
  exact hC.sup (Subalgebra.fg_adjoin_finset _)

/-- Every member of the smoothening sequence is finitely generated. -/
theorem chain_fg {ϖ : R} (hϖ : Irreducible ϖ) (n : ℕ) : (chain R K A ϖ n).FG := by
  induction n with
  | zero =>
    rw [chain_zero, ← Algebra.map_top]
    exact (Algebra.FiniteType.out).map _
  | succ n ih => exact dilat_fg hϖ _ ih

end FG

section Points

variable (K) in
/-- The points of a subalgebra of the integral functions coming from points of `A`. -/
def subPoints (S : Subalgebra R (integralFunctions R K A)) : Set (S →ₐ[R] R) :=
  Set.range fun φ : A →ₐ[R] R => (point (K := K) φ).comp S.val

omit [IsDomain R] [IsDiscreteValuationRing R] in
theorem lift_comp_val_apply (S : Subalgebra R (integralFunctions R K A)) (φ ψ : A →ₐ[R] R)
    (x : S ⊗[R] S) :
    Algebra.TensorProduct.lift ((point (K := K) φ).comp S.val) ((point (K := K) ψ).comp S.val)
      (fun _ _ => .all _ _) x = pairValue (K := K) φ ψ (tensorVal S x) := by
  induction x using TensorProduct.inductionOn with
  | tmul a b => simp
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add]

end Points

section HopfSide

variable {C : Type u} [CommRing C] [HopfAlgebra R C]

/-- **The Hopf-algebra input to the defect drop.** Let `C` be a finitely generated commutative
Hopf algebra over `R` and `Γ` a set of points containing the counit and stable under products and
the antipode. Let `J` be the ideal of elements whose values at the points of `Γ` lie in the maximal
ideal. Then there are elements `z k ∈ J` of the augmentation ideal whose differentials are
independent modulo `ϖ`, such that `J` is generated by `ϖ` and the `z k` after multiplication by an
element with unit value, and every `ϖ`-torsion class of the cotangent module comes from a relation
`ϖ² g₀ + ϖ ∑ z_k g_k + ∑ z_k z_l g_{kl} = 0`. -/
theorem hopf_relations [IsAlgClosed (ResidueField R)] [Algebra.FiniteType R C] {ϖ : R}
    (hϖ : Irreducible ϖ) {Γ : Set (C →ₐ[R] R)} (h1 : counitAlgHom R C ∈ Γ)
    (h2 : ∀ φ ∈ Γ, ∀ ψ ∈ Γ,
      (Algebra.TensorProduct.lift φ ψ (fun _ _ => .all _ _)).comp (comulAlgHom R C) ∈ Γ)
    (h3 : ∀ φ ∈ Γ, φ.comp (antipodeAlgHom R C) ∈ Γ)
    (ε : C →ₐ[R] R) (hε : ε = counitAlgHom R C) (J : Ideal C) (hJ : ptLocus Γ = J) :
    ∃ (c : ℕ) (z : Fin c → C), (∀ k, z k ∈ J) ∧ (∀ k, z k ∈ augIdeal ε) ∧
      (∃ g : C, IsUnit (ε g) ∧
        ∀ j ∈ J, ∃ (a : C) (b : Fin c → C), g * j = ϖ • a + ∑ k, z k * b k) ∧
      IndepModulo ϖ (fun k => dif ε (z k)) ∧
      ∀ τ ∈ Submodule.torsionBy R (Cot ε) ϖ,
        ∃ (g0 : C) (g1 : Fin c → C) (g2 : Fin c → Fin c → C),
          ϖ ^ 2 • g0 + ϖ • ∑ k, z k * g1 k + ∑ k, ∑ l, z k * z l * g2 k l = 0 ∧
          ϖ • dif ε g0 + ∑ k, ε (g1 k) • dif ε (z k) = τ := by
  subst hε hJ
  have : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing R C
  have hm := hϖ.maximalIdeal_eq
  have hϖm : ϖ ∈ maximalIdeal R := (mem_maximalIdeal ϖ).mpr hϖ.not_isUnit
  obtain ⟨G⟩ := exists_goodChoice (counitAlgHom R C) hm (ptLocus Γ)
  have : Algebra.Smooth (ResidueField R) ((ResidueField R ⊗[R] C) ⧸ jbar Γ) :=
    smooth_quotient_jbar h1 h2 h3
  have hgr : GradedIndep (counitAlgHom R C) ϖ G.x (ptLocus Γ) :=
    gradedIndep_of_formallySmooth (counitAlgHom R C) hm (ptLocus Γ) (quotMap Γ)
      (quotMap_surjective Γ) (ker_quotMap Γ) (quotPoint h1) (fun y => quotPoint_quotMap h1 y)
      G.x G.x_mem_I G.hxind
  have hϖJ : Ideal.span {algebraMap R C ϖ} ≤ ptLocus Γ := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, mem_ptLocus]
    intro φ _
    rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
    exact hϖm
  have hϖJ' : ∀ y : C, ϖ • y ∈ ptLocus Γ := fun y => by
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (hϖJ (Ideal.mem_span_singleton_self _))
  have hJm : ptLocus Γ ≤ ptIdeal (counitAlgHom R C) ϖ := by
    intro j hj
    rw [ptIdeal, Ideal.mem_comap, ← hm]
    exact (mem_ptLocus Γ).mp hj _ h1
  have hzJ : Ideal.span (Set.range G.z) ≤ ptLocus Γ := by
    rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    exact G.z_mem_J k
  have hxI : Ideal.span (Set.range G.x) ≤ augIdeal (counitAlgHom R C) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact G.x_mem_I j
  have hA := exists_mul_eq_of_mem_J hϖm hgr G.hgen hzJ hϖJ hJm hxI
  have hQ2 := exists_mul_eq_of_mem_sq hϖm hgr G.hgen hzJ hϖJ hxI
  have hQ1 : ∀ (b0 : C) (b : Fin G.c → C), ϖ • b0 + ∑ k, G.z k * b k = 0 →
      ∃ h : C, IsUnit (counitAlgHom R C h) ∧ h * b0 ∈ ptLocus Γ ∧ ∀ k, h * b k ∈ ptLocus Γ := by
    intro b0 b hrel
    obtain ⟨h, hu, hh0, hhk⟩ := gamma_trick hϖ (fun φ : Γ => (φ : C →ₐ[R] R))
      G.z (fun φ k => (mem_ptLocus Γ).mp (G.z_mem_J k) φ φ.2) G.l G.hl b0 b hrel
    exact ⟨h, hu, (mem_ptLocus Γ).mpr fun φ hφ => hh0 ⟨φ, hφ⟩,
      fun k => (mem_ptLocus Γ).mpr fun φ hφ => hhk k ⟨φ, hφ⟩⟩
  have hind : IndepModulo ϖ (fun k => dif (counitAlgHom R C) (G.z k)) := by
    intro a ha m
    obtain ⟨t, -, ht⟩ := Submodule.mem_map.mp ha
    have h0 := congrArg (G.l m) ht
    rw [LinearMap.lsmul_apply, map_smul, map_sum] at h0
    simp only [map_smul, G.hl, Finset.sum_ite_eq', Finset.mem_univ,
      ite_true, Algebra.smul_def, mul_one, mul_ite, mul_zero, IsLocalRing.ResidueField.algebraMap_eq,
      (residue_eq_zero_iff _).mpr hϖm, zero_mul] at h0
    rw [← Ideal.mem_span_singleton, ← hm, ← residue_eq_zero_iff]
    exact h0.symm
  exact ⟨G.c, G.z, G.z_mem_J, G.z_mem_I, hA, hind, fun τ hτ =>
    exists_relation (counitAlgHom R C) hϖ.ne_zero hϖJ' G.z_mem_I hA hQ1 hQ2 τ hτ⟩

end HopfSide

section CoreStep

/-- **Defect drop along one step of the smoothening sequence.** -/
theorem core_step [IsAlgClosed (ResidueField R)] {ϖ : R} (hϖ : Irreducible ϖ)
    (S : Subalgebra R (integralFunctions R K A)) (hS : (incl R K A).range ≤ S)
    (hcomul : ∀ s ∈ S, comulAlgHom R (integralFunctions R K A) s ∈ pureSpan R K A S S)
    (hanti : ∀ s ∈ S, antipodeInt s ∈ S) (hfg : S.FG) :
    defect R (Cot (C := dilat ϖ (jIdeal R K A S))
        (subPoint (counitAlgHom R (integralFunctions R K A)) (dilat ϖ (jIdeal R K A S)))) +
      torsionByLength R (Cot (C := S) (subPoint (counitAlgHom R (integralFunctions R K A)) S)) ϖ ≤
      defect R (Cot (C := S) (subPoint (counitAlgHom R (integralFunctions R K A)) S)) := by
  let inst : HopfAlgebra R S := hopfSub S hS hcomul hanti
  have hft : Algebra.FiniteType R S := (Subalgebra.fg_iff_finiteType S).mp hfg
  have h1 : counitAlgHom R S ∈ subPoints K S := ⟨counitAlgHom R A, AlgHom.ext fun _ => rfl⟩
  have h2 : ∀ φ ∈ subPoints K S, ∀ ψ ∈ subPoints K S,
      (Algebra.TensorProduct.lift φ ψ (fun _ _ => .all _ _)).comp (comulAlgHom R S) ∈
        subPoints K S := by
    rintro _ ⟨φ, rfl⟩ _ ⟨ψ, rfl⟩
    refine ⟨(Algebra.TensorProduct.lift φ ψ (fun _ _ => .all _ _)).comp (comulAlgHom R A),
      AlgHom.ext fun s => ?_⟩
    change point _ (s : integralFunctions R K A) = Algebra.TensorProduct.lift
      ((point (K := K) φ).comp S.val) ((point (K := K) ψ).comp S.val) (fun _ _ => .all _ _)
      (comulSub S hcomul s)
    rw [lift_comp_val_apply, tensorVal_comulSub, ← AlgHom.comp_apply, lift_point_comp_comul]
  have h3 : ∀ φ ∈ subPoints K S, φ.comp (antipodeAlgHom R S) ∈ subPoints K S := by
    rintro _ ⟨φ, rfl⟩
    refine ⟨φ.comp (antipodeAlgHom R A), AlgHom.ext fun s => ?_⟩
    change point _ (s : integralFunctions R K A) = point φ (antipodeInt (s : integralFunctions R K A))
    rw [← AlgHom.comp_apply (point φ), point_comp_antipodeInt]
  obtain ⟨c, z, hzJ, hzI, hA, hind, hrel⟩ := @hopf_relations R _ _ _ S _ inst _ hft ϖ hϖ _ h1 h2 h3
    (subPoint (counitAlgHom R (integralFunctions R K A)) S) (AlgHom.ext fun _ => rfl)
    (jIdeal R K A S) (by
      ext c
      rw [mem_ptLocus, mem_jIdeal]
      constructor
      · intro h φ
        exact h _ ⟨φ, rfl⟩
      · rintro h _ ⟨φ, rfl⟩
        exact h φ)
  choose ζ hζ using fun k => exists_eq_smul_of_dvd hϖ.ne_zero ((z k : S) :
    integralFunctions R K A) fun φ => by
      have := hzJ k φ
      rw [hϖ.maximalIdeal_eq, Ideal.mem_span_singleton] at this
      exact this
  have hd : DivData (counitAlgHom R (integralFunctions R K A)) ϖ (jIdeal R K A S) z ζ :=
    ⟨hϖ.ne_zero, hzJ, hzI, fun k => (hζ k).symm⟩
  exact hd.defect_add_le hA hind hrel

end CoreStep

end Langlands.GroupScheme.IntegralModel.Smoothening.Termination
