import Langlands.GroupScheme.IntegralModel.Smoothening.TerminationDilatation
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-! # Generators of `J` and of `I² ∩ J` from a graded independence property

Let `C` be an `R`-algebra with an `R`-point `ε`, `I` the augmentation ideal, `ϖ ∈ R`, and
`𝔪 = ε⁻¹(ϖ R)`. Let `z` and `x` be elements of `I` spanning `I` modulo `𝔪 I`, with the `z k` in an
ideal `J ⊇ ϖ C`. Assume the *graded independence property*: a homogeneous polynomial of degree `n`
in `x` lying in `J + 𝔪^(n+1)` has all coefficients in `𝔪`. Then `J ⊆ (ϖ, z)` and
`I² ∩ J ⊆ ϖ I² + z I`, both up to multiplication by an element outside `𝔪`. -/

noncomputable section

open Module Submodule

namespace Langlands.GroupScheme.IntegralModel.Smoothening.Termination

variable {R : Type*} [CommRing R] {C : Type*} [CommRing C] [Algebra R C]

/-- The ideal of elements whose value lies in `ϖ R`. -/
def ptIdeal (ε : C →ₐ[R] R) (ϖ : R) : Ideal C := (Ideal.span {ϖ}).comap ε

theorem augIdeal_le_ptIdeal (ε : C →ₐ[R] R) (ϖ : R) : augIdeal ε ≤ ptIdeal ε ϖ := by
  intro y hy
  rw [ptIdeal, Ideal.mem_comap, RingHom.mem_ker.mp hy]
  exact Ideal.zero_mem _

theorem algebraMap_mem_ptIdeal (ε : C →ₐ[R] R) (ϖ : R) : algebraMap R C ϖ ∈ ptIdeal ε ϖ := by
  rw [ptIdeal, Ideal.mem_comap, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
  exact Ideal.mem_span_singleton_self ϖ

/-- Every element of an ideal power generated by `x` is a homogeneous polynomial in `x`. -/
theorem exists_isHomogeneous_of_mem_span_pow {t : ℕ} (x : Fin t → C) (n : ℕ) {f : C}
    (hf : f ∈ Ideal.span (Set.range x) ^ n) :
    ∃ P : MvPolynomial (Fin t) C, P.IsHomogeneous n ∧ MvPolynomial.eval x P = f := by
  induction n generalizing f with
  | zero =>
    exact ⟨MvPolynomial.C f, MvPolynomial.isHomogeneous_C _ _, by simp⟩
  | succ n ih =>
    rw [pow_succ] at hf
    refine Submodule.mul_induction_on hf ?_ ?_
    · intro a ha b hb
      obtain ⟨P, hP, rfl⟩ := ih ha
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun C).mp hb
      refine ⟨P * ∑ j, MvPolynomial.C (c j) * MvPolynomial.X j, hP.mul ?_, ?_⟩
      · refine MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ => ?_
        simpa using (MvPolynomial.isHomogeneous_C _ (c j)).mul (MvPolynomial.isHomogeneous_X C j)
      · simp [smul_eq_mul]
    · rintro a b ⟨P, hP, rfl⟩ ⟨Q, hQ, rfl⟩
      exact ⟨P + Q, hP.add hQ, by simp⟩

/-- The value of a homogeneous polynomial of degree `n` with coefficients in an ideal `𝔞` lies in
`𝔞 * (x)^n`. -/
theorem eval_mem_mul_span_pow {t : ℕ} (x : Fin t → C) (n : ℕ) (𝔞 : Ideal C)
    (P : MvPolynomial (Fin t) C) (hP : P.IsHomogeneous n) (hc : ∀ μ, P.coeff μ ∈ 𝔞) :
    MvPolynomial.eval x P ∈ 𝔞 * Ideal.span (Set.range x) ^ n := by
  rw [MvPolynomial.eval_eq']
  refine Ideal.sum_mem _ fun μ hμ => Ideal.mul_mem_mul (hc μ) ?_
  have hdeg : ∑ i, μ i = n := by
    have := hP (MvPolynomial.mem_support_iff.mp hμ)
    have h2 : μ.degree = n := by rw [Finsupp.degree_eq_weight_one]; exact this
    rwa [Finsupp.degree_eq_sum] at h2
  rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun i _ =>
    Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _

/-- **Krull intersection with a multiplier.** In a Noetherian ring, an element lying in
`𝔞 + 𝔪^N` for every `N` lies in `𝔞` after multiplication by some `1 - r` with `r ∈ 𝔪`. -/
theorem exists_one_sub_mul_mem [IsNoetherianRing C] {𝔞 𝔪 : Ideal C} {y : C}
    (h : ∀ N : ℕ, y ∈ 𝔞 ⊔ 𝔪 ^ N) : ∃ r ∈ 𝔪, (1 - r) * y ∈ 𝔞 := by
  have hmem : (Ideal.Quotient.mk 𝔞 y) ∈ (⨅ i : ℕ, 𝔪 ^ i • ⊤ : Submodule C (C ⧸ 𝔞)) := by
    rw [Submodule.mem_iInf]
    intro i
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (h i)
    have : Ideal.Quotient.mk 𝔞 y = b • Ideal.Quotient.mk 𝔞 1 := by
      rw [← hab, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add,
        ← Ideal.Quotient.mkₐ_eq_mk C, ← map_smul, smul_eq_mul, mul_one]
    rw [this]
    exact Submodule.smul_mem_smul hb Submodule.mem_top
  obtain ⟨⟨r, hr⟩, hrx⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff 𝔪 _).mp hmem
  refine ⟨r, hr, ?_⟩
  have h2 : Ideal.Quotient.mk 𝔞 (r * y) = Ideal.Quotient.mk 𝔞 y := by
    rw [← Ideal.Quotient.mkₐ_eq_mk C, ← smul_eq_mul, map_smul]
    exact hrx
  rw [← Ideal.Quotient.eq_zero_iff_mem, sub_mul, one_mul, map_sub, h2, sub_self]

section Iteration

variable (ε : C →ₐ[R] R) (ϖ : R) {t c : ℕ} (x : Fin t → C) (z : Fin c → C) (J : Ideal C)

/-- The graded independence property of `x` modulo `J`. -/
def GradedIndep : Prop :=
  ∀ (n : ℕ) (P : MvPolynomial (Fin t) C), P.IsHomogeneous n →
    MvPolynomial.eval x P ∈ J ⊔ ptIdeal ε ϖ ^ (n + 1) → ∀ μ, P.coeff μ ∈ ptIdeal ε ϖ

theorem ptIdeal_le_augIdeal_sup : ptIdeal ε ϖ ≤ augIdeal ε ⊔ Ideal.span {algebraMap R C ϖ} := by
  intro y hy
  rw [ptIdeal, Ideal.mem_comap] at hy
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hy
  have h1 : y - algebraMap R C (ε y) ∈ augIdeal ε := sub_algebraMap_mem ε y
  have h2 : algebraMap R C (ε y) ∈ Ideal.span {algebraMap R C ϖ} := by
    rw [← ha, map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  have : y = (y - algebraMap R C (ε y)) + algebraMap R C (ε y) := by ring
  rw [this]
  exact Submodule.add_mem_sup h1 h2

variable {ε ϖ x z J}

theorem augIdeal_le_of_le_mul (hgen : augIdeal ε ≤
      Ideal.span (Set.range z) ⊔ Ideal.span (Set.range x) ⊔ ptIdeal ε ϖ * augIdeal ε)
    (N : ℕ) :
    augIdeal ε ≤ Ideal.span (Set.range z) ⊔ Ideal.span (Set.range x) ⊔ ptIdeal ε ϖ ^ N := by
  set Z := Ideal.span (Set.range z)
  set X := Ideal.span (Set.range x)
  set m := ptIdeal ε ϖ
  set I := augIdeal ε
  have key : ∀ N : ℕ, I ≤ Z ⊔ X ⊔ m ^ N * I := by
    intro N
    induction N with
    | zero =>
      rw [pow_zero, one_mul]
      exact le_sup_right
    | succ N ih =>
      have h1 : m ^ N * I ≤ Z ⊔ X ⊔ m ^ (N + 1) * I := by
        calc m ^ N * I ≤ m ^ N * (Z ⊔ X ⊔ m * I) := Ideal.mul_mono_right hgen
          _ = m ^ N * Z ⊔ m ^ N * X ⊔ m ^ (N + 1) * I := by
              rw [Ideal.mul_sup, Ideal.mul_sup, pow_succ, mul_assoc]
          _ ≤ Z ⊔ X ⊔ m ^ (N + 1) * I :=
              sup_le_sup_right (sup_le_sup Ideal.mul_le_right Ideal.mul_le_right) _
      exact ih.trans (sup_le le_sup_left h1)
  exact (key N).trans (sup_le_sup_left Ideal.mul_le_left _)

theorem graded_step (hψ : GradedIndep ε ϖ x J) {n N : ℕ} (hnN : n + 1 ≤ N) :
    Ideal.span (Set.range x) ^ n ⊓ (J ⊔ ptIdeal ε ϖ ^ N) ≤
      ptIdeal ε ϖ * Ideal.span (Set.range x) ^ n := by
  rintro f ⟨hf1, hf2⟩
  obtain ⟨P, hP, rfl⟩ := exists_isHomogeneous_of_mem_span_pow x n hf1
  have hle : J ⊔ ptIdeal ε ϖ ^ N ≤ J ⊔ ptIdeal ε ϖ ^ (n + 1) :=
    sup_le_sup_left (Ideal.pow_le_pow_right hnN) J
  exact eval_mem_mul_span_pow x n _ P hP (hψ n P hP (hle hf2))

/-- The decomposition step: an element of `A ⊔ X^n ⊔ 𝔪^N` that lies in `J`, with `A ≤ J`, lies in
`A ⊔ 𝔪 X^n ⊔ 𝔪^N`. -/
theorem mem_step (hψ : GradedIndep ε ϖ x J) {A : Ideal C} (hAJ : A ≤ J) {n N : ℕ}
    (hnN : n + 1 ≤ N) {y : C} (hyJ : y ∈ J)
    (hy : y ∈ A ⊔ Ideal.span (Set.range x) ^ n ⊔ ptIdeal ε ϖ ^ N) :
    y ∈ A ⊔ ptIdeal ε ϖ * Ideal.span (Set.range x) ^ n ⊔ ptIdeal ε ϖ ^ N := by
  obtain ⟨a, ha, w, hw, rfl⟩ := Submodule.mem_sup.mp hy
  obtain ⟨b, hb, f, hf, rfl⟩ := Submodule.mem_sup.mp ha
  have hfJ : f ∈ J ⊔ ptIdeal ε ϖ ^ N := by
    have : f = (b + f + w - b) + (-w) := by ring
    rw [this]
    exact Submodule.add_mem_sup (J.sub_mem hyJ (hAJ hb)) (Submodule.neg_mem _ hw)
  exact Submodule.add_mem_sup (Submodule.add_mem_sup hb (graded_step hψ hnN ⟨hf, hfJ⟩)) hw

/-- **Generators of `J`.** -/
theorem le_span_sup_pow (hψ : GradedIndep ε ϖ x J)
    (hgen : augIdeal ε ≤
      Ideal.span (Set.range z) ⊔ Ideal.span (Set.range x) ⊔ ptIdeal ε ϖ * augIdeal ε)
    (hzJ : Ideal.span (Set.range z) ≤ J) (hϖJ : Ideal.span {algebraMap R C ϖ} ≤ J)
    (hJm : J ≤ ptIdeal ε ϖ) (hxI : Ideal.span (Set.range x) ≤ augIdeal ε) (N : ℕ) :
    J ≤ Ideal.span {algebraMap R C ϖ} ⊔ Ideal.span (Set.range z) ⊔ ptIdeal ε ϖ ^ N := by
  set Z := Ideal.span (Set.range z)
  set X := Ideal.span (Set.range x)
  set m := ptIdeal ε ϖ
  set I := augIdeal ε
  set Pv := Ideal.span {algebraMap R C ϖ}
  have hgenN := augIdeal_le_of_le_mul hgen N
  have hmI : m ≤ I ⊔ Pv := ptIdeal_le_augIdeal_sup ε ϖ
  have hmX : ∀ n, m * X ^ n ≤ Pv ⊔ Z ⊔ X ^ (n + 1) ⊔ m ^ N := by
    intro n
    calc m * X ^ n ≤ (I ⊔ Pv) * X ^ n := Ideal.mul_mono_left hmI
      _ = I * X ^ n ⊔ Pv * X ^ n := Ideal.sup_mul _ _ _
      _ ≤ (Z ⊔ X ⊔ m ^ N) * X ^ n ⊔ Pv := sup_le_sup (Ideal.mul_mono_left hgenN) Ideal.mul_le_left
      _ = Z * X ^ n ⊔ X ^ (n + 1) ⊔ m ^ N * X ^ n ⊔ Pv := by
          rw [Ideal.sup_mul, Ideal.sup_mul, ← pow_succ']
      _ ≤ Pv ⊔ Z ⊔ X ^ (n + 1) ⊔ m ^ N := by
          refine sup_le (sup_le (sup_le ?_ ?_) ?_) ?_
          · exact Ideal.mul_le_left.trans (le_sup_right.trans (le_sup_left.trans le_sup_left))
          · exact le_sup_right.trans le_sup_left
          · exact Ideal.mul_le_left.trans le_sup_right
          · exact le_sup_left.trans (le_sup_left.trans le_sup_left)
  have claim : ∀ n, 1 ≤ n → n ≤ N → J ⊓ I ≤ Pv ⊔ Z ⊔ X ^ n ⊔ m ^ N := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base =>
      intro _ y hy
      rw [pow_one]
      have := hgenN hy.2
      have hle : Z ⊔ X ⊔ m ^ N ≤ Pv ⊔ Z ⊔ X ⊔ m ^ N :=
        sup_le_sup_right (sup_le_sup_right le_sup_right _) _
      exact hle this
    | succ n hn ih =>
      intro hnN y hy
      have h1 := mem_step hψ (A := Pv ⊔ Z) (sup_le hϖJ hzJ) hnN hy.1 (ih (by omega) hy)
      obtain ⟨a, ha, w, hw, rfl⟩ := Submodule.mem_sup.mp h1
      obtain ⟨b, hb, f, hf, rfl⟩ := Submodule.mem_sup.mp ha
      have hf' := hmX n hf
      refine Submodule.add_mem _ (Submodule.add_mem _ ?_ hf') (Submodule.mem_sup_right hw)
      exact Submodule.mem_sup_left (Submodule.mem_sup_left hb)
  intro j hj
  rcases Nat.eq_zero_or_pos N with hN | hN
  · rw [hN, pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_sup_right Submodule.mem_top
  have hXN : X ^ N ≤ m ^ N := Ideal.pow_right_mono (hxI.trans (augIdeal_le_ptIdeal ε ϖ)) N
  obtain ⟨i, hi, p, hp, rfl⟩ := Submodule.mem_sup.mp (hmI (hJm hj))
  have hiJ : i ∈ J := by
    have : i = (i + p) - p := by ring
    rw [this]
    exact J.sub_mem hj (hϖJ hp)
  have := claim N hN le_rfl ⟨hiJ, hi⟩
  have h2 : Pv ⊔ Z ⊔ X ^ N ⊔ m ^ N ≤ Pv ⊔ Z ⊔ m ^ N :=
    sup_le (sup_le le_sup_left (hXN.trans le_sup_right)) le_sup_right
  exact Submodule.add_mem _ (h2 this) (Submodule.mem_sup_left (Submodule.mem_sup_left hp))

/-- **`I² ∩ J` modulo powers of `𝔪`.** -/
theorem sq_inf_le_sup_pow (hψ : GradedIndep ε ϖ x J)
    (hgen : augIdeal ε ≤
      Ideal.span (Set.range z) ⊔ Ideal.span (Set.range x) ⊔ ptIdeal ε ϖ * augIdeal ε)
    (hzJ : Ideal.span (Set.range z) ≤ J) (hϖJ : Ideal.span {algebraMap R C ϖ} ≤ J)
    (hxI : Ideal.span (Set.range x) ≤ augIdeal ε) (N : ℕ) :
    augIdeal ε ^ 2 ⊓ J ≤ Ideal.span {algebraMap R C ϖ} * augIdeal ε ^ 2 ⊔
      Ideal.span (Set.range z) * augIdeal ε ⊔ ptIdeal ε ϖ ^ N := by
  set Z := Ideal.span (Set.range z)
  set X := Ideal.span (Set.range x)
  set m := ptIdeal ε ϖ
  set I := augIdeal ε
  set Pv := Ideal.span {algebraMap R C ϖ}
  set A := Pv * I ^ 2 ⊔ Z * I
  have hAJ : A ≤ J := sup_le (Ideal.mul_le_left.trans hϖJ) (Ideal.mul_le_left.trans hzJ)
  have hgenN := augIdeal_le_of_le_mul hgen N
  have hmI : m ≤ I ⊔ Pv := ptIdeal_le_augIdeal_sup ε ϖ
  have hIm : I ≤ m := augIdeal_le_ptIdeal ε ϖ
  rcases Nat.lt_or_ge N 2 with hN | hN
  · intro y hy
    refine Submodule.mem_sup_right ?_
    interval_cases N
    · rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    · rw [pow_one]
      exact hIm (Ideal.pow_le_self two_ne_zero hy.1)
  have hXn : ∀ n, 1 ≤ n → X ^ n ≤ I := fun n hn =>
    (Ideal.pow_le_self (by omega)).trans hxI
  have hmX : ∀ n, 2 ≤ n → m * X ^ n ≤ A ⊔ X ^ (n + 1) ⊔ m ^ N := by
    intro n hn
    calc m * X ^ n ≤ (I ⊔ Pv) * X ^ n := Ideal.mul_mono_left hmI
      _ = I * X ^ n ⊔ Pv * X ^ n := Ideal.sup_mul _ _ _
      _ ≤ (Z ⊔ X ⊔ m ^ N) * X ^ n ⊔ Pv * I ^ 2 :=
          sup_le_sup (Ideal.mul_mono_left hgenN)
            (Ideal.mul_mono_right ((Ideal.pow_right_mono hxI n).trans
              (Ideal.pow_le_pow_right hn)))
      _ = Z * X ^ n ⊔ X ^ (n + 1) ⊔ m ^ N * X ^ n ⊔ Pv * I ^ 2 := by
          rw [Ideal.sup_mul, Ideal.sup_mul, ← pow_succ']
      _ ≤ A ⊔ X ^ (n + 1) ⊔ m ^ N := by
          refine sup_le (sup_le (sup_le ?_ ?_) ?_) ?_
          · exact (Ideal.mul_mono_right (hXn n (by omega))).trans
              (le_sup_right.trans (le_sup_left.trans le_sup_left))
          · exact le_sup_right.trans le_sup_left
          · exact Ideal.mul_le_left.trans le_sup_right
          · exact le_sup_left.trans (le_sup_left.trans le_sup_left)
  have hbase : I ^ 2 ≤ A ⊔ X ^ 2 ⊔ m ^ N := by
    have hXI : X * I ≤ Z * I ⊔ X ^ 2 ⊔ m ^ N := by
      calc X * I ≤ X * (Z ⊔ X ⊔ m ^ N) := Ideal.mul_mono_right hgenN
        _ = X * Z ⊔ X ^ 2 ⊔ X * m ^ N := by rw [Ideal.mul_sup, Ideal.mul_sup, pow_two]
        _ ≤ Z * I ⊔ X ^ 2 ⊔ m ^ N := by
            refine sup_le (sup_le ?_ (le_sup_right.trans le_sup_left)) ?_
            · rw [mul_comm]
              exact (Ideal.mul_mono_right hxI).trans (le_sup_left.trans le_sup_left)
            · exact Ideal.mul_le_right.trans le_sup_right
    calc I ^ 2 = I * I := pow_two I
      _ ≤ (Z ⊔ X ⊔ m ^ N) * I := Ideal.mul_mono_left hgenN
      _ = Z * I ⊔ X * I ⊔ m ^ N * I := by rw [Ideal.sup_mul, Ideal.sup_mul]
      _ ≤ A ⊔ X ^ 2 ⊔ m ^ N := by
          refine sup_le (sup_le ?_ ?_) ?_
          · exact le_sup_right.trans (le_sup_left.trans le_sup_left)
          · exact hXI.trans (sup_le_sup_right (sup_le_sup_right le_sup_right _) _)
          · exact Ideal.mul_le_left.trans le_sup_right
  have claim : ∀ n, 2 ≤ n → n ≤ N → I ^ 2 ⊓ J ≤ A ⊔ X ^ n ⊔ m ^ N := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => exact fun _ => inf_le_left.trans hbase
    | succ n hn ih =>
      intro hnN y hy
      have h1 := mem_step hψ hAJ hnN hy.2 (ih (by omega) hy)
      obtain ⟨a, ha, w, hw, rfl⟩ := Submodule.mem_sup.mp h1
      obtain ⟨b, hb, f, hf, rfl⟩ := Submodule.mem_sup.mp ha
      refine Submodule.add_mem _ (Submodule.add_mem _ ?_ (hmX n hn hf))
        (Submodule.mem_sup_right hw)
      exact Submodule.mem_sup_left (Submodule.mem_sup_left hb)
  have hXN : X ^ N ≤ m ^ N := Ideal.pow_right_mono (hxI.trans hIm) N
  exact (claim N hN le_rfl).trans
    (sup_le (sup_le le_sup_left (hXN.trans le_sup_right)) le_sup_right)

end Iteration

section Explicit

variable {ε : C →ₐ[R] R} {ϖ : R} {t c : ℕ} {x : Fin t → C} {z : Fin c → C} {J : Ideal C}

theorem isUnit_one_sub [IsLocalRing R] (hϖ : ϖ ∈ IsLocalRing.maximalIdeal R) {r : C}
    (hr : r ∈ ptIdeal ε ϖ) : IsUnit (ε (1 - r)) := by
  rw [map_sub, map_one]
  apply IsLocalRing.isUnit_one_sub_self_of_mem_nonunits
  rw [← IsLocalRing.mem_maximalIdeal]
  rw [ptIdeal, Ideal.mem_comap] at hr
  exact (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖ)) hr

theorem mem_span_mul_iff_exists {I : Ideal C} {y : C}
    (hy : y ∈ Ideal.span (Set.range z) * I) :
    ∃ b : Fin c → C, (∀ k, b k ∈ I) ∧ y = ∑ k, z k * b k := by
  refine Submodule.mul_induction_on hy ?_ ?_
  · intro a ha b hb
    obtain ⟨d, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun C).mp ha
    refine ⟨fun k => d k * b, fun k => I.mul_mem_left _ hb, ?_⟩
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun k _ => by rw [smul_eq_mul]; ring
  · rintro a b ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
    exact ⟨u + v, fun k => I.add_mem (hu k) (hv k), by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun k _ => by rw [Pi.add_apply, mul_add]⟩

theorem mem_span_sup_iff_exists {y : C}
    (hy : y ∈ Ideal.span {algebraMap R C ϖ} ⊔ Ideal.span (Set.range z)) :
    ∃ (a : C) (b : Fin c → C), y = ϖ • a + ∑ k, z k * b k := by
  obtain ⟨p, hp, w, hw, rfl⟩ := Submodule.mem_sup.mp hy
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hp
  obtain ⟨b, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun C).mp hw
  refine ⟨a, b, ?_⟩
  rw [Algebra.smul_def, mul_comm]
  congr 1
  exact Finset.sum_congr rfl fun k _ => by rw [smul_eq_mul, mul_comm]

/-- **(a) Generators of `J`, explicit form.** -/
theorem exists_mul_eq_of_mem_J [IsLocalRing R] [IsNoetherianRing C]
    (hϖ : ϖ ∈ IsLocalRing.maximalIdeal R) (hψ : GradedIndep ε ϖ x J)
    (hgen : augIdeal ε ≤
      Ideal.span (Set.range z) ⊔ Ideal.span (Set.range x) ⊔ ptIdeal ε ϖ * augIdeal ε)
    (hzJ : Ideal.span (Set.range z) ≤ J) (hϖJ : Ideal.span {algebraMap R C ϖ} ≤ J)
    (hJm : J ≤ ptIdeal ε ϖ) (hxI : Ideal.span (Set.range x) ≤ augIdeal ε) :
    ∃ g : C, IsUnit (ε g) ∧ ∀ j ∈ J, ∃ (a : C) (b : Fin c → C), g * j = ϖ • a + ∑ k, z k * b k := by
  set G := Ideal.span {algebraMap R C ϖ} ⊔ Ideal.span (Set.range z)
  have hloc : ∀ j ∈ J, ∃ g : C, IsUnit (ε g) ∧ g * j ∈ G := by
    intro j hj
    obtain ⟨r, hr, hrj⟩ := exists_one_sub_mul_mem (𝔞 := G) (𝔪 := ptIdeal ε ϖ) (y := j)
      (fun N => le_span_sup_pow hψ hgen hzJ hϖJ hJm hxI N hj)
    exact ⟨1 - r, isUnit_one_sub hϖ hr, hrj⟩
  obtain ⟨s, hs⟩ := (IsNoetherian.noetherian J : J.FG)
  classical
  choose! g hgu hgj using fun y (hy : y ∈ (s : Set C)) => hloc y (hs ▸ Ideal.subset_span hy)
  refine ⟨∏ y ∈ s, g y, ?_, ?_⟩
  · rw [map_prod]
    exact IsUnit.prod_iff.mpr fun y hy => hgu y hy
  · intro j hj
    apply mem_span_sup_iff_exists
    rw [← hs] at hj
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hj
    · intro y hy
      rw [← Finset.mul_prod_erase s g hy, mul_comm (g y), mul_assoc]
      exact G.mul_mem_left _ (hgj y hy)
    · rw [mul_zero]
      exact G.zero_mem
    · intro a b _ _ ha hb
      rw [mul_add]
      exact G.add_mem ha hb
    · intro d a _ ha
      rw [smul_eq_mul, mul_left_comm]
      exact G.mul_mem_left _ ha

/-- **(Q2) `I² ∩ J`, explicit form.** -/
theorem exists_mul_eq_of_mem_sq [IsLocalRing R] [IsNoetherianRing C]
    (hϖ : ϖ ∈ IsLocalRing.maximalIdeal R) (hψ : GradedIndep ε ϖ x J)
    (hgen : augIdeal ε ≤
      Ideal.span (Set.range z) ⊔ Ideal.span (Set.range x) ⊔ ptIdeal ε ϖ * augIdeal ε)
    (hzJ : Ideal.span (Set.range z) ≤ J) (hϖJ : Ideal.span {algebraMap R C ϖ} ≤ J)
    (hxI : Ideal.span (Set.range x) ≤ augIdeal ε) :
    ∀ q ∈ augIdeal ε ^ 2, q ∈ J → ∃ h : C, IsUnit (ε h) ∧
      ∃ a ∈ augIdeal ε ^ 2, ∃ b : Fin c → C, (∀ k, b k ∈ augIdeal ε) ∧
        h * q = ϖ • a + ∑ k, z k * b k := by
  intro q hq hqJ
  obtain ⟨r, hr, hrq⟩ := exists_one_sub_mul_mem
    (fun N => sq_inf_le_sup_pow hψ hgen hzJ hϖJ hxI N ⟨hq, hqJ⟩)
  refine ⟨1 - r, isUnit_one_sub hϖ hr, ?_⟩
  obtain ⟨p, hp, w, hw, hpw⟩ := Submodule.mem_sup.mp hrq
  obtain ⟨a, ha, rfl⟩ := Ideal.mem_span_singleton_mul.mp hp
  obtain ⟨b, hb, rfl⟩ := mem_span_mul_iff_exists hw
  exact ⟨a, ha, b, hb, by rw [← hpw, Algebra.smul_def]⟩

end Explicit

end Langlands.GroupScheme.IntegralModel.Smoothening.Termination
