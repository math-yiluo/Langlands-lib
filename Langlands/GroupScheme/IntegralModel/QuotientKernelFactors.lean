import Langlands.GroupScheme.IntegralModel.UnipotentQuotientCell
import Langlands.GroupScheme.Dynamic.ParabolicProduct
import Langlands.GroupScheme.Dynamic.AffineRepresentability

/-! # Integral dynamic factors of a special-fibre quotient kernel -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 1600000

namespace Langlands.GroupScheme.IntegralModel

variable {R K : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))}
    (M : IntegralModel R K G)
    (χ : (Gm (Spec (CommRingCat.of R))).toGrp ⟶ M.group)
    {Q : GroupScheme (Spec (CommRingCat.of (IsLocalRing.ResidueField R)))}
    (q : M.specialFibre ⟶ Q)

/-- The subgroup generated by the quotient-kernel intersections with the
original integral negative radical, centralizer, and positive radical. -/
def dynamicQuotientKernelSubgroup : Subgroup M.integralSections :=
  ((Dynamic.unipotent (Dynamic.oppositeCocharacter χ)).carrier (𝟙_ (Over _)) ⊓
    ((rationalPoints.map q).comp M.reduction).ker) ⊔
  ((Dynamic.centralizer χ).carrier (𝟙_ (Over _)) ⊓
    ((rationalPoints.map q).comp M.reduction).ker) ⊔
  ((Dynamic.unipotent χ).carrier (𝟙_ (Over _)) ⊓
    ((rationalPoints.map q).comp M.reduction).ker)

theorem dynamicQuotientKernelSubgroup_le :
    M.dynamicQuotientKernelSubgroup χ q ≤
      ((rationalPoints.map q).comp M.reduction).ker :=
  sup_le (sup_le inf_le_right inf_le_right) inf_le_right

private theorem restrict_mem_of_isRepresentedBy
    {B B' : Scheme.{u}} (b : B' ⟶ B)
    {H J : GroupScheme B} {F : SubgroupFunctor H} {j : J ⟶ H}
    (hj : F.IsRepresentedBy j)
    {x : 𝟙_ (Over B) ⟶ H.X} (hx : x ∈ F.carrier (𝟙_ (Over B))) :
    baseChangeSectionHom b H x ∈ (F.baseChange b).carrier (𝟙_ (Over B')) := by
  rw [← hj.2] at hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  rw [baseChangeSectionHom_naturality, ← (hj.baseChange b).2]
  exact SubgroupFunctor.mem_range.mpr ⟨baseChangeSectionHom b J y, rfl⟩

variable [Smooth M.group.X.hom] [ConnectedSpace M.specialFibre.X.left]
    [Smooth Q.X.hom] [IsAffineHom Q.X.hom] [ConnectedSpace Q.X.left]
    (hqs : Smooth q.hom.hom.left) (hqsurj : Surjective q.hom.hom.left)
    [ConnectedSpace (kernel q).X.left] (hN : IsUnipotent (kernel q))

include hqs hqsurj hN in
/-- Every original integral section killed by the special-fibre quotient
has three original integral dynamic factors, each killed by that quotient. -/
theorem exists_dynamicFactors_mem_quotientKernel
    (x : M.integralSections)
    (hx : rationalPoints.map q (M.reduction x) = 1) :
    ∃ v ∈ (Dynamic.unipotent (Dynamic.oppositeCocharacter χ)).carrier (𝟙_ (Over _)),
      rationalPoints.map q (M.reduction v) = 1 ∧
      ∃ z ∈ (Dynamic.centralizer χ).carrier (𝟙_ (Over _)),
        rationalPoints.map q (M.reduction z) = 1 ∧
        ∃ u ∈ (Dynamic.unipotent χ).carrier (𝟙_ (Over _)),
          rationalPoints.map q (M.reduction u) = 1 ∧ x = v * z * u := by
  let : IsAffine M.group.X.left := isAffine_of_isAffineHom M.group.X.hom
  let : IsAffine Q.X.left := isAffine_of_isAffineHom Q.X.hom
  let b := residueBaseMap R
  let χQ := Dynamic.baseChangeCocharacter b χ ≫ q
  let i := Dynamic.Affine.unipotentHom (Dynamic.oppositeCocharacter χ)
  let p := Dynamic.Affine.parabolicHom χ
  have hi := Dynamic.Affine.isRepresentedBy_unipotentHom (Dynamic.oppositeCocharacter χ)
  have hp := Dynamic.Affine.isRepresentedBy_parabolicHom χ
  let j := Dynamic.Affine.unipotentHom (Dynamic.oppositeCocharacter χQ)
  let r := Dynamic.Affine.parabolicHom χQ
  have hj := Dynamic.Affine.isRepresentedBy_unipotentHom (Dynamic.oppositeCocharacter χQ)
  have hr := Dynamic.Affine.isRepresentedBy_parabolicHom χQ
  have hb : lift (1 : 𝟙_ (Over _) ⟶ (Dynamic.Affine.unipotentScheme
      (Dynamic.oppositeCocharacter χQ)).X)
      (1 : 𝟙_ (Over _) ⟶ (Dynamic.Affine.parabolicScheme χQ).X) ≫
        SubgroupFunctor.cellMultiplication j r = M.reduction x ≫ q.hom.hom := by
    simpa only [SubgroupFunctor.lift_cellMultiplication, MonObj.one_comp, one_mul,
      rationalPoints.map_apply]
      using hx.symm
  obtain ⟨a, ha⟩ := (M.oppositeCell_section_lifts_iff_quotient_reduction
    χ i p hi hp q hqs hqsurj hN j r hj hr x).mpr ⟨_, hb⟩
  let v : M.integralSections := a ≫ fst _ _ ≫ i.hom.hom
  let w : M.integralSections := a ≫ snd _ _ ≫ p.hom.hom
  have hv : v ∈ (Dynamic.unipotent (Dynamic.oppositeCocharacter χ)).carrier
      (𝟙_ (Over _)) := by
    rw [← hi.2]
    exact SubgroupFunctor.mem_range.mpr ⟨a ≫ fst _ _, rfl⟩
  have hw : w ∈ (Dynamic.parabolic χ).carrier (𝟙_ (Over _)) := by
    rw [← hp.2]
    exact SubgroupFunctor.mem_range.mpr ⟨a ≫ snd _ _, rfl⟩
  have hvw : v * w = x := by
    simpa only [SubgroupFunctor.cellMultiplication, MonObj.comp_mul,
      Category.assoc] using ha
  have hvred : M.reduction v ∈
      (Dynamic.unipotent (Dynamic.baseChangeCocharacter b
        (Dynamic.oppositeCocharacter χ))).carrier (𝟙_ (Over _)) := by
    rw [Dynamic.unipotent_baseChange]
    exact restrict_mem_of_isRepresentedBy b hi hv
  have hwred : M.reduction w ∈
      (Dynamic.parabolic (Dynamic.baseChangeCocharacter b χ)).carrier (𝟙_ (Over _)) := by
    rw [Dynamic.parabolic_baseChange]
    exact restrict_mem_of_isRepresentedBy b hp hw
  have hvq : rationalPoints.map q (M.reduction v) ∈
      (Dynamic.unipotent (Dynamic.oppositeCocharacter χQ)).carrier (𝟙_ (Over _)) := by
    have h := Dynamic.unipotent_le_comap
      (Dynamic.baseChangeCocharacter b (Dynamic.oppositeCocharacter χ)) q _ hvred
    rw [SubgroupFunctor.mem_comap] at h
    simpa only [χQ, Dynamic.oppositeCocharacter, Dynamic.baseChangeCocharacter_powerHom,
      Category.assoc, rationalPoints.map_apply] using h
  have hwq : rationalPoints.map q (M.reduction w) ∈
      (Dynamic.parabolic χQ).carrier (𝟙_ (Over _)) :=
    Dynamic.parabolic_le_comap (Dynamic.baseChangeCocharacter b χ) q _ hwred
  let f := (rationalPoints.map q).comp M.reduction
  have hvwq : f v * f w = 1 := by
    rw [← map_mul, hvw]
    exact hx
  have hvone : f v = 1 := by
    apply Dynamic.eq_one_of_mem_opposite_unipotent_of_mem_parabolic χQ hvq
    change f v ∈ (Dynamic.parabolic χQ).carrier (𝟙_ (Over _))
    rw [eq_inv_of_mul_eq_one_left hvwq]
    exact ((Dynamic.parabolic χQ).carrier _).inv_mem hwq
  have hwone : f w = 1 := by
    simpa only [hvone, one_mul] using hvwq
  let z : M.integralSections := Dynamic.limit χ ⟨w, hw⟩
  let u : M.integralSections := z⁻¹ * w
  have hz : z ∈ (Dynamic.centralizer χ).carrier (𝟙_ (Over _)) :=
    Dynamic.limit_mem_centralizer χ ⟨w, hw⟩
  have hu : u ∈ (Dynamic.unipotent χ).carrier (𝟙_ (Over _)) :=
    Dynamic.inv_limit_mul_mem_unipotent χ ⟨w, hw⟩
  have hzu : z * u = w := mul_inv_cancel_left z w
  have hzred : M.reduction z ∈
      (Dynamic.centralizer (Dynamic.baseChangeCocharacter b χ)).carrier (𝟙_ (Over _)) := by
    rw [Dynamic.centralizer_baseChange]
    exact restrict_mem_of_isRepresentedBy b
      (Dynamic.Affine.isRepresentedBy_centralizerHom χ) hz
  have hured : M.reduction u ∈
      (Dynamic.unipotent (Dynamic.baseChangeCocharacter b χ)).carrier (𝟙_ (Over _)) := by
    rw [Dynamic.unipotent_baseChange]
    exact restrict_mem_of_isRepresentedBy b
      (Dynamic.Affine.isRepresentedBy_unipotentHom χ) hu
  have hzq : f z ∈ (Dynamic.centralizer χQ).carrier (𝟙_ (Over _)) :=
    Dynamic.centralizer_le_comap (Dynamic.baseChangeCocharacter b χ) q _ hzred
  have huq : f u ∈ (Dynamic.unipotent χQ).carrier (𝟙_ (Over _)) :=
    Dynamic.unipotent_le_comap (Dynamic.baseChangeCocharacter b χ) q _ hured
  have hzuq : f z * f u = 1 := by rw [← map_mul, hzu, hwone]
  have hzone : f z = 1 := by
    have hl := Dynamic.hasLimit_centralizer_mul_unipotent χQ hzq huq
    rw [hzuq] at hl
    exact hl.unique χQ (Dynamic.hasLimit_of_mem_centralizer χQ
      ((Dynamic.centralizer χQ).carrier _).one_mem)
  have huone : f u = 1 := by simpa only [hzone, one_mul] using hzuq
  refine ⟨v, hv, hvone, z, hz, hzone, u, hu, huone, ?_⟩
  rw [mul_assoc, hzu, hvw]

include hqs hqsurj hN in
/-- A bound on the three original dynamic quotient-kernel intersections
bounds the full original integral quotient kernel. -/
theorem quotientKernel_le_of_dynamicFactors (S : Subgroup M.integralSections)
    (hV : (Dynamic.unipotent (Dynamic.oppositeCocharacter χ)).carrier (𝟙_ (Over _)) ⊓
      ((rationalPoints.map q).comp M.reduction).ker ≤ S)
    (hZ : (Dynamic.centralizer χ).carrier (𝟙_ (Over _)) ⊓
      ((rationalPoints.map q).comp M.reduction).ker ≤ S)
    (hU : (Dynamic.unipotent χ).carrier (𝟙_ (Over _)) ⊓
      ((rationalPoints.map q).comp M.reduction).ker ≤ S) :
    ((rationalPoints.map q).comp M.reduction).ker ≤ S := by
  intro x hx
  obtain ⟨v, hv, hvq, z, hz, hzq, u, hu, huq, rfl⟩ :=
    M.exists_dynamicFactors_mem_quotientKernel χ q hqs hqsurj hN x hx
  exact S.mul_mem (S.mul_mem (hV ⟨hv, hvq⟩) (hZ ⟨hz, hzq⟩)) (hU ⟨hu, huq⟩)

include hqs hqsurj hN in
/-- The three actual integral dynamic intersections generate exactly the
kernel of reduction followed by the specified quotient. -/
theorem dynamicQuotientKernelSubgroup_eq :
    M.dynamicQuotientKernelSubgroup χ q =
      ((rationalPoints.map q).comp M.reduction).ker := by
  apply le_antisymm (M.dynamicQuotientKernelSubgroup_le χ q)
  apply M.quotientKernel_le_of_dynamicFactors χ q hqs hqsurj hN
  · exact le_sup_of_le_left le_sup_left
  · exact le_sup_of_le_left le_sup_right
  · exact le_sup_right

end Langlands.GroupScheme.IntegralModel
