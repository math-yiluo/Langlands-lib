import Langlands.GroupScheme.IntegralModel.CongruenceTower
import Langlands.GroupScheme.RelativeIdentityComponent.OpenConstruction
import Mathlib.GroupTheory.Index
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Henselian
import Mathlib.FieldTheory.IsAlgClosed.Basic

/-! # Connected generators and the relative identity component (KP A.4.26) -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace ConnectedGeneration

variable {R : Type u} [CommRing R] [IsLocalRing R]
  (X : GroupScheme (Spec (CommRingCat.of R)))

/-- The positive congruence kernel on actual sections, using the actual
quotient of the coefficient ring by a power of its maximal ideal. -/
def sectionCongruenceKernel (n : ℕ+) : Subgroup (rationalPoints X) :=
  (baseChangeSectionHom (IntegralModel.congruenceBaseMap R n) X).ker

@[simp]
theorem mem_sectionCongruenceKernel (n : ℕ+) (x : rationalPoints X) :
    x ∈ sectionCongruenceKernel X n ↔
      baseChangeSectionHom (IntegralModel.congruenceBaseMap R n) X x = 1 :=
  Iff.rfl

variable {X}

/-- The subgroup generated by the images of the integral sections of a
supplied family of actual group-scheme homomorphisms. -/
def generatedImages {I : Type v}
    {Y : I → GroupScheme (Spec (CommRingCat.of R))}
    (f : ∀ j, Y j ⟶ X) : Subgroup (rationalPoints X) :=
  ⨆ j, (rationalPoints.map (f j)).range

omit [IsLocalRing R] in
/-- Connected-source images lie in every supplied representative of the
relative identity component. This is the first step of KP A.4.26. -/
theorem generatedImages_le_componentRange {I : Type v}
    {Y : I → GroupScheme (Spec (CommRingCat.of R))}
    [∀ j, GeometricallyConnected (Y j).X.hom]
    (f : ∀ j, Y j ⟶ X)
    {N : GroupScheme (Spec (CommRingCat.of R))}
    (i : N ⟶ X) (hi : IsRelativeIdentityComponent X i) :
    generatedImages f ≤ (rationalPoints.map i).range := by
  apply iSup_le
  intro j x hx
  obtain ⟨y, rfl⟩ := hx
  have hf : InRelativeIdentityComponent X (f j).hom.hom :=
    RelativeIdentityComponent.inRelativeIdentityComponent_of_geometricallyConnected
      X (f j).hom.hom η[(Y j).X] (IsMonHom.one_hom _)
  obtain ⟨z, hz⟩ := (hi.factors_iff _ _).mpr
    (InRelativeIdentityComponent.precomp X hf y)
  exact ⟨z, hz⟩

/-- Containment after one actual reduction implies containment on sections
when the target subgroup contains that reduction's kernel. -/
theorem le_of_reduction_le {P U : Subgroup (rationalPoints X)} (m : ℕ+)
    (hker : sectionCongruenceKernel X m ≤ U)
    (hred : P.map (baseChangeSectionHom (IntegralModel.congruenceBaseMap R m) X) ≤
      U.map (baseChangeSectionHom (IntegralModel.congruenceBaseMap R m) X)) :
    P ≤ U := by
  intro x hx
  obtain ⟨y, hy, heq⟩ := hred (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
  have hk : x * y⁻¹ ∈ sectionCongruenceKernel X m := by
    rw [mem_sectionCongruenceKernel, map_mul, map_inv, heq, mul_inv_cancel]
  have h := U.mul_mem (hker hk) hy
  simpa only [inv_mul_cancel_right] using h

/-- For connected generators, surjectivity onto the component's image at
one open congruence level is sufficient for the desired equality. -/
theorem eq_componentRange_of_reduction {I : Type v}
    {Y : I → GroupScheme (Spec (CommRingCat.of R))}
    [∀ j, GeometricallyConnected (Y j).X.hom]
    (f : ∀ j, Y j ⟶ X)
    {N : GroupScheme (Spec (CommRingCat.of R))}
    (i : N ⟶ X) (hi : IsRelativeIdentityComponent X i) (m : ℕ+)
    (hker : sectionCongruenceKernel X m ≤ generatedImages f)
    (hred : ((rationalPoints.map i).range).map
        (baseChangeSectionHom (IntegralModel.congruenceBaseMap R m) X) ≤
      (generatedImages f).map
        (baseChangeSectionHom (IntegralModel.congruenceBaseMap R m) X)) :
    generatedImages f = (rationalPoints.map i).range :=
  le_antisymm (generatedImages_le_componentRange f i hi)
    (le_of_reduction_le m hker hred)

end ConnectedGeneration

/-- **KP Lemma A.4.26, affine specialization with congruence openness.**
Over a Henselian DVR with algebraically closed residue field, a finite
family of smooth affine groups with geometrically connected fibres generates
the integral sections of the relative identity component whenever its image
subgroup has finite index and contains a positive congruence kernel. -/
def ConnectedGenerationStatement : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R] [IsAlgClosed (IsLocalRing.ResidueField R)]
    (X : GroupScheme (Spec (CommRingCat.of R))) [IsAffineHom X.X.hom],
    Smooth X.X.hom →
    ∀ (n : ℕ) (Y : Fin n → GroupScheme (Spec (CommRingCat.of R)))
      [∀ j, IsAffineHom (Y j).X.hom],
      (∀ j, Smooth (Y j).X.hom) →
      (∀ j, GeometricallyConnected (Y j).X.hom) →
      ∀ (f : ∀ j, Y j ⟶ X),
        (ConnectedGeneration.generatedImages f).FiniteIndex →
        (∃ m : ℕ+, ConnectedGeneration.sectionCongruenceKernel X m ≤
          ConnectedGeneration.generatedImages f) →
        ∀ (N : GroupScheme (Spec (CommRingCat.of R))) (i : N ⟶ X),
          IsRelativeIdentityComponent X i →
          ConnectedGeneration.generatedImages f = (rationalPoints.map i).range

end Langlands.GroupScheme
