import Langlands.GroupScheme.IntegralModel.Smoothening.Model
import Langlands.GroupScheme.IntegralModel.Smoothening.TerminationMain

/-! # Existence of smoothenings over Henselian discrete valuation rings

Kaletha–Prasad, Appendix A.6, over a Henselian discrete valuation ring with algebraically closed
residue field. The smoothening of an integral model `M` is `Spec B`, where `B` is the ring of
integral functions of the coordinate Hopf algebra of `M`
(`Smoothening.smoothening_of_finiteType`). `B` is finitely generated by
`Smoothening.Termination.integralFunctions_finiteType`. -/

universe u

namespace Langlands.GroupScheme.IntegralModel

/-- **Existence of smoothenings** (Kaletha–Prasad, Appendix A.6, over a Henselian discrete
valuation ring with algebraically closed residue field). -/
theorem smoothening_exists : SmootheningStatement.{u} :=
  Smoothening.smoothening_of_finiteType Smoothening.Termination.integralFunctions_finiteType

end Langlands.GroupScheme.IntegralModel
