import Langlands.GroupScheme.VectorMatrixKernel
import Langlands.GroupScheme.IntegralModel.ScaledVectorPoints

/-! # Integral vector models with arbitrary basis matrices -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix

namespace Langlands.GroupScheme

namespace VectorGroup

variable {R : CommRingCat.{u}} {n m : ℕ}

/-- A matrix map multiplies the coefficient-ring section coordinates by
the original coefficient matrix. -/
theorem sectionCoordinates_matrixHom (M : Matrix (Fin m) (Fin n) R)
    (x : rationalPoints (groupScheme R n)) :
    (sectionCoordinates R m (x ≫ (matrixHom (R := R) M).hom.hom)).toAdd =
      M *ᵥ (sectionCoordinates R n x).toAdd := by
  funext j
  rw [sectionCoordinates_apply, coordinates_matrixHom, RingHom.map_mulVec]
  have hc : (M.map (scalarMap (Over.mk (𝟙 (Spec R))))).map
      (Scheme.ΓSpecIso R).hom.hom = M := by
    ext i l
    change ((Scheme.ΓSpecIso R).inv ≫ (𝟙 (Spec R) : Spec R ⟶ Spec R).appTop ≫
      (Scheme.ΓSpecIso R).hom) (M i l) = M i l
    simp
  rw [hc]
  rfl

end VectorGroup

namespace IntegralModel

variable (R K : Type u) [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K] (n : ℕ)

/-- The polynomial integral vector group, with generic identification
given by any invertible basis matrix. -/
def matrixVector (B : (Matrix (Fin n) (Fin n) K)ˣ) :
    IntegralModel R K (VectorGroup.groupScheme (CommRingCat.of K) n) where
  group := VectorGroup.groupScheme (CommRingCat.of R) n
  affine := by
    change IsAffineHom
      (Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin n) R))))
    infer_instance
  flat := by
    have := VectorGroup.smooth (CommRingCat.of R) n
    infer_instance
  finiteType := by
    have := VectorGroup.smooth (CommRingCat.of R) n
    infer_instance
  genericIso := VectorGroup.baseChangeIso
    (CommRingCat.ofHom (algebraMap R K)) ≪≫
      VectorGroup.matrixIso (R := CommRingCat.of K) B

theorem matrixVector_isSmooth (B : (Matrix (Fin n) (Fin n) K)ˣ) :
    (matrixVector R K n B).IsSmooth :=
  VectorGroup.smooth (CommRingCat.of R) n

theorem matrixVector_hasGeometricallyConnectedFibres
    (B : (Matrix (Fin n) (Fin n) K)ˣ) :
    (matrixVector R K n B).HasGeometricallyConnectedFibres :=
  VectorGroup.geometricallyConnected (CommRingCat.of R) n

/-- The integral section is carried to its integral coordinate column
multiplied by the generic basis matrix. -/
theorem matrixVector_integralPointMap (B : (Matrix (Fin n) (Fin n) K)ˣ)
    (x : (matrixVector R K n B).integralSections) :
    (VectorGroup.sectionCoordinates (CommRingCat.of K) n
      ((matrixVector R K n B).integralPointMap x)).toAdd =
      (B : Matrix (Fin n) (Fin n) K) *ᵥ
        (algebraMap R K ∘
          (VectorGroup.sectionCoordinates (CommRingCat.of R) n x).toAdd) := by
  change (VectorGroup.sectionCoordinates (CommRingCat.of K) n
    ((baseChangeSectionHom (Spec.algebraMap R K)
        (VectorGroup.groupScheme (CommRingCat.of R) n) x ≫
          (VectorGroup.baseChangeIso (CommRingCat.ofHom (algebraMap R K))).hom.hom.hom) ≫
            (VectorGroup.matrixHom (R := CommRingCat.of K)
              (B : Matrix (Fin n) (Fin n) K)).hom.hom)).toAdd = _
  rw [VectorGroup.sectionCoordinates_matrixHom]
  congr 1
  funext j
  exact VectorGroup.sectionCoordinates_baseChange
    (CommRingCat.ofHom (algebraMap R K)) x j

/-- Exact integral-point image, with no condition on chosen coordinates
other than belonging to the lattice generated by the basis columns. -/
theorem matrixVector_mem_integralPoints (B : (Matrix (Fin n) (Fin n) K)ˣ)
    (g : rationalPoints (VectorGroup.groupScheme (CommRingCat.of K) n)) :
    g ∈ (matrixVector R K n B).integralPoints ↔
      ∃ a : Fin n → R,
        (VectorGroup.sectionCoordinates (CommRingCat.of K) n g).toAdd =
          (B : Matrix (Fin n) (Fin n) K) *ᵥ (algebraMap R K ∘ a) := by
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨(VectorGroup.sectionCoordinates (CommRingCat.of R) n x).toAdd,
      matrixVector_integralPointMap R K n B x⟩
  · rintro ⟨a, ha⟩
    refine ⟨(VectorGroup.sectionCoordinates (CommRingCat.of R) n).symm
      (Multiplicative.ofAdd a), ?_⟩
    apply (VectorGroup.sectionCoordinates (CommRingCat.of K) n).injective
    apply Multiplicative.toAdd.injective
    rw [matrixVector_integralPointMap, MulEquiv.apply_symm_apply]
    exact ha.symm

variable {R K n}

/-- An integral matrix satisfying the basis-change equation extends the
identity of the actual generic vector group. -/
def matrixVectorTransition (B C : (Matrix (Fin n) (Fin n) K)ˣ)
    (M : Matrix (Fin n) (Fin n) R)
    (h : (C : Matrix (Fin n) (Fin n) K) * M.map (algebraMap R K) =
      (B : Matrix (Fin n) (Fin n) K)) :
    (matrixVector R K n B).Hom (matrixVector R K n C) (𝟙 _) where
  hom := VectorGroup.matrixHom (R := CommRingCat.of R) M
  generic_comm := by
    change (GroupScheme.baseChange (Spec.algebraMap R K)).map
        (VectorGroup.matrixHom (R := CommRingCat.of R) M) ≫
          ((VectorGroup.baseChangeIso _).hom ≫
            VectorGroup.matrixHom (R := CommRingCat.of K)
              (C : Matrix (Fin n) (Fin n) K)) =
      ((VectorGroup.baseChangeIso _).hom ≫
        VectorGroup.matrixHom (R := CommRingCat.of K)
          (B : Matrix (Fin n) (Fin n) K)) ≫ 𝟙 _
    rw [Category.comp_id, ← Category.assoc, ← VectorGroup.matrixHom_baseChange,
      Category.assoc, VectorGroup.matrixHom_comp]
    rw [show (C : Matrix (Fin n) (Fin n) K) *
      M.map (CommRingCat.ofHom (algebraMap R K)).hom = B from h]

variable [IsLocalRing R]

/-- Every generic-identity extension between these basis models has the
actual specialized matrix kernel, by generic rigidity. -/
theorem matrixVector_kernel_properties (B C : (Matrix (Fin n) (Fin n) K)ˣ)
    (M : Matrix (Fin n) (Fin n) R)
    (h : (C : Matrix (Fin n) (Fin n) K) * M.map (algebraMap R K) =
      (B : Matrix (Fin n) (Fin n) K))
    (φ : (matrixVector R K n B).Hom (matrixVector R K n C) (𝟙 _)) :
    Smooth (kernel φ.specialFibreMap).X.hom ∧
      ConnectedSpace (kernel φ.specialFibreMap).X.left ∧
        IsUnipotent (kernel φ.specialFibreMap) := by
  have hφ := φ.hom_eq (matrixVectorTransition B C M h)
  change Smooth (kernel ((GroupScheme.baseChange (residueBaseMap R)).map φ.hom)).X.hom ∧
    ConnectedSpace (kernel ((GroupScheme.baseChange (residueBaseMap R)).map φ.hom)).X.left ∧
      IsUnipotent (kernel ((GroupScheme.baseChange (residueBaseMap R)).map φ.hom))
  rw [hφ]
  exact VectorGroup.matrix_baseChange_kernel_properties
    (CommRingCat.ofHom (IsLocalRing.residue R)) M

end IntegralModel
end Langlands.GroupScheme
