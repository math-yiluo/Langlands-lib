import Langlands.GroupScheme.IntegralModel.ConnectedGeneration

/-! # Connected generators of finite index over an algebraically closed field

The field-level step in the proof of KP Lemma A.4.26: over an algebraically
closed field, a finite family of smooth affine groups with geometrically
connected fibres whose images generate a subgroup of finite index in the
rational points generates exactly the rational points of the identity
component.
-/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- **Field step of KP Lemma A.4.26.** Over an algebraically closed field `k`,
let `G` be a smooth affine group scheme and let `f j : Y j ⟶ G` be a finite
family of homomorphisms from smooth affine geometrically connected group
schemes. If the subgroup of `G(k)` generated by the images of the `Y j (k)` has
finite index, then it equals the rational-point range of every supplied
representative of the relative identity component of `G`. -/
def ConnectedGenerationFieldStatement : Prop :=
  ∀ (k : Type u) [Field k] [IsAlgClosed k]
    (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom],
    Smooth G.X.hom →
    ∀ (n : ℕ) (Y : Fin n → GroupScheme (Spec (CommRingCat.of k)))
      [∀ j, IsAffineHom (Y j).X.hom],
      (∀ j, Smooth (Y j).X.hom) →
      (∀ j, GeometricallyConnected (Y j).X.hom) →
      ∀ (f : ∀ j, Y j ⟶ G),
        (ConnectedGeneration.generatedImages f).FiniteIndex →
        ∀ (N : GroupScheme (Spec (CommRingCat.of k))) (i : N ⟶ G),
          IsRelativeIdentityComponent G i →
          ConnectedGeneration.generatedImages f = (rationalPoints.map i).range

end Langlands.GroupScheme
