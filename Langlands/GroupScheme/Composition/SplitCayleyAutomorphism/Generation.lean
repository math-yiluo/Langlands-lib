import Langlands.GroupScheme.Composition.SplitCayleyAutomorphism.Interface

/-! # Generation of the split Cayley automorphisms by root and torus elements -/

noncomputable section

universe u

open Matrix Polynomial

namespace Langlands.GroupScheme

namespace SplitCayley

section Ring

variable {A : Type u} [CommRing A]

theorem IsAutomorphism.comp {f g : (Fin 8 → A) → (Fin 8 → A)} (hf : IsAutomorphism f)
    (hg : IsAutomorphism g) : IsAutomorphism (f ∘ g) :=
  ⟨by rw [Function.comp_apply, hg.1, hf.1], fun x y => by
    rw [Function.comp_apply, hg.2, hf.2]
    rfl⟩

theorem isAutomorphism_mul {M N : Matrix (Fin 8) (Fin 8) A} (hM : IsAutomorphism M.mulVec)
    (hN : IsAutomorphism N.mulVec) : IsAutomorphism (M * N).mulVec := by
  have h : (M * N).mulVec = M.mulVec ∘ N.mulVec :=
    funext fun x => (Matrix.mulVec_mulVec x M N).symm
  rw [h]
  exact hM.comp hN

/-- The block-diagonal matrix `diag(1, M, N, 1)` in Zorn's coordinates `(a, u, v, b)`. -/
def zornBlock (M N : Matrix (Fin 3) (Fin 3) A) : Matrix (Fin 8) (Fin 8) A :=
  Matrix.of ![![1, 0, 0, 0, 0, 0, 0, 0],
    ![0, M 0 0, M 0 1, M 0 2, 0, 0, 0, 0],
    ![0, M 1 0, M 1 1, M 1 2, 0, 0, 0, 0],
    ![0, M 2 0, M 2 1, M 2 2, 0, 0, 0, 0],
    ![0, 0, 0, 0, N 0 0, N 0 1, N 0 2, 0],
    ![0, 0, 0, 0, N 1 0, N 1 1, N 1 2, 0],
    ![0, 0, 0, 0, N 2 0, N 2 1, N 2 2, 0],
    ![0, 0, 0, 0, 0, 0, 0, 1]]

theorem zornBlock_mulVec (M N : Matrix (Fin 3) (Fin 3) A) (x : Fin 8 → A) :
    zornBlock M N *ᵥ x = ![x 0, M 0 0 * x 1 + M 0 1 * x 2 + M 0 2 * x 3,
      M 1 0 * x 1 + M 1 1 * x 2 + M 1 2 * x 3, M 2 0 * x 1 + M 2 1 * x 2 + M 2 2 * x 3,
      N 0 0 * x 4 + N 0 1 * x 5 + N 0 2 * x 6, N 1 0 * x 4 + N 1 1 * x 5 + N 1 2 * x 6,
      N 2 0 * x 4 + N 2 1 * x 5 + N 2 2 * x 6, x 7] := by
  funext i
  fin_cases i <;> simp [zornBlock, mulVec, dotProduct, Fin.sum_univ_eight]

theorem matrix_eq_of_mulVec {M N : Matrix (Fin 8) (Fin 8) A} (h : ∀ x, M *ᵥ x = N *ᵥ x) :
    M = N := by
  ext i j
  have h' := congrFun (h (Pi.single j 1)) i
  rw [mulVec_single_one, mulVec_single_one] at h'
  exact h'

theorem zornBlock_mul (M N M' N' : Matrix (Fin 3) (Fin 3) A) :
    zornBlock M N * zornBlock M' N' = zornBlock (M * M') (N * N') := by
  refine matrix_eq_of_mulVec fun x => ?_
  rw [← mulVec_mulVec, zornBlock_mulVec, zornBlock_mulVec, zornBlock_mulVec]
  funext i
  fin_cases i <;> simp [Matrix.mul_apply, Fin.sum_univ_three] <;> ring

theorem zornBlock_one : zornBlock (1 : Matrix (Fin 3) (Fin 3) A) 1 = 1 := by
  ext a b
  fin_cases a <;> fin_cases b <;> simp [zornBlock]

theorem rootMatrix_apply (α : Root) (r : A) (a b : Fin 8) :
    rootMatrix α r a b = rootFun α r (Pi.single b 1) a := by
  rw [← rootMatrix_mulVec, mulVec_single_one]
  rfl

end Ring

section Field

variable {k : Type u} [Field k]

/-- The subgroup of `GL₈(k)` generated by the root-group and torus elements. -/
def rootTorusClosure (k : Type u) [Field k] : Subgroup (GL (Fin 8) k) :=
  Subgroup.closure (Set.range (fun p : Root × k => rootGL p.1 p.2) ∪
    Set.range (fun p : kˣ × kˣ => torusGL p.1 p.2))

theorem rootGL_mem_rootTorusClosure (α : Root) (r : k) : rootGL α r ∈ rootTorusClosure k :=
  Subgroup.subset_closure (Or.inl ⟨(α, r), rfl⟩)

theorem torusGL_mem_rootTorusClosure (s t : kˣ) : torusGL s t ∈ rootTorusClosure k :=
  Subgroup.subset_closure (Or.inr ⟨(s, t), rfl⟩)

/-- The matrices underlying the elements of `rootTorusClosure k`. -/
def rootTorusMatrices (k : Type u) [Field k] : Submonoid (Matrix (Fin 8) (Fin 8) k) :=
  (rootTorusClosure k).toSubmonoid.map (Units.coeHom (Matrix (Fin 8) (Fin 8) k))

theorem val_mem_rootTorusMatrices {g : GL (Fin 8) k} (hg : g ∈ rootTorusClosure k) :
    (g : Matrix (Fin 8) (Fin 8) k) ∈ rootTorusMatrices k :=
  ⟨g, hg, rfl⟩

theorem mem_rootTorusClosure_of_val_mem {g : GL (Fin 8) k}
    (hg : (g : Matrix (Fin 8) (Fin 8) k) ∈ rootTorusMatrices k) : g ∈ rootTorusClosure k := by
  obtain ⟨h, hh, he⟩ := hg
  have : h = g := Units.ext he
  rwa [← this]

/-- The block matrix `diag(1, M, (M⁻¹)ᵀ, 1)` of a `3 × 3` matrix `M`. For `det M = 1` these are
the automorphisms fixing the idempotent `e₀`, which form the long-root `SL₃` of `G₂`. -/
def sl3BlockMatrix (M : Matrix (Fin 3) (Fin 3) k) : Matrix (Fin 8) (Fin 8) k :=
  zornBlock M M⁻¹ᵀ

theorem sl3BlockMatrix_mul (M N : Matrix (Fin 3) (Fin 3) k) :
    sl3BlockMatrix (M * N) = sl3BlockMatrix M * sl3BlockMatrix N := by
  rw [sl3BlockMatrix, sl3BlockMatrix, sl3BlockMatrix, zornBlock_mul, Matrix.mul_inv_rev, transpose_mul]

theorem sl3BlockMatrix_one : sl3BlockMatrix (1 : Matrix (Fin 3) (Fin 3) k) = 1 := by
  rw [sl3BlockMatrix, inv_one, transpose_one, zornBlock_one]

theorem sl3BlockMatrix_transvection_mem (t : TransvectionStruct (Fin 3) k) :
    sl3BlockMatrix t.toMatrix ∈ rootTorusMatrices k := by
  have hinv : t.toMatrix⁻¹ = t.inv.toMatrix := Matrix.inv_eq_right_inv t.mul_inv
  rw [sl3BlockMatrix, hinv]
  rcases t with ⟨i, j, hij, c⟩
  have key : ∃ α : Root, zornBlock (transvection i j c) (transvection i j (-c))ᵀ =
      rootMatrix α c := by
    fin_cases i <;> fin_cases j
    · exact absurd rfl hij
    · refine ⟨.l12, ?_⟩
      refine matrix_eq_of_mulVec fun x => ?_
      rw [zornBlock_mulVec, rootMatrix_mulVec]
      funext l
      fin_cases l <;> simp [rootFun, transvection]
      ring
    · refine ⟨.l13, ?_⟩
      refine matrix_eq_of_mulVec fun x => ?_
      rw [zornBlock_mulVec, rootMatrix_mulVec]
      funext l
      fin_cases l <;> simp [rootFun, transvection]
      ring
    · refine ⟨.l21, ?_⟩
      refine matrix_eq_of_mulVec fun x => ?_
      rw [zornBlock_mulVec, rootMatrix_mulVec]
      funext l
      fin_cases l <;> simp [rootFun, transvection] <;> ring
    · exact absurd rfl hij
    · refine ⟨.l23, ?_⟩
      refine matrix_eq_of_mulVec fun x => ?_
      rw [zornBlock_mulVec, rootMatrix_mulVec]
      funext l
      fin_cases l <;> simp [rootFun, transvection]
      ring
    · refine ⟨.l31, ?_⟩
      refine matrix_eq_of_mulVec fun x => ?_
      rw [zornBlock_mulVec, rootMatrix_mulVec]
      funext l
      fin_cases l <;> simp [rootFun, transvection] <;> ring
    · refine ⟨.l32, ?_⟩
      refine matrix_eq_of_mulVec fun x => ?_
      rw [zornBlock_mulVec, rootMatrix_mulVec]
      funext l
      fin_cases l <;> simp [rootFun, transvection] <;> ring
    · exact absurd rfl hij
  obtain ⟨α, hα⟩ := key
  change zornBlock (transvection i j c) (transvection i j (-c))ᵀ ∈ _
  rw [hα, ← rootGL_val]
  exact val_mem_rootTorusMatrices (rootGL_mem_rootTorusClosure α c)

theorem sl3BlockMatrix_diagonal_mem (d : Fin 3 → k) (hd : d 0 * d 1 * d 2 = 1) :
    sl3BlockMatrix (diagonal d) ∈ rootTorusMatrices k := by
  have h0 : d 0 ≠ 0 := fun h => by simp [h] at hd
  have h1 : d 1 ≠ 0 := fun h => by simp [h] at hd
  have h2 : d 2 ≠ 0 := fun h => by simp [h] at hd
  have hinv : (diagonal d)⁻¹ = diagonal fun i => (d i)⁻¹ := by
    apply Matrix.inv_eq_right_inv
    rw [diagonal_mul_diagonal, ← diagonal_one]
    congr 1
    funext i
    fin_cases i <;> simp [h0, h1, h2]
  have heq : sl3BlockMatrix (diagonal d) =
      ((torusGL (Units.mk0 (d 0) h0) (Units.mk0 (d 1) h1) : GL (Fin 8) k) :
        Matrix (Fin 8) (Fin 8) k) := by
    rw [sl3BlockMatrix, hinv, diagonal_transpose, torusGL_val]
    ext a b
    fin_cases a <;> fin_cases b <;> simp [zornBlock, torusEntries]
    all_goals first
      | (field_simp; linear_combination hd)
      | (field_simp; linear_combination -hd)
  rw [heq]
  exact val_mem_rootTorusMatrices (torusGL_mem_rootTorusClosure _ _)

theorem sl3BlockMatrix_list_prod_mem (L : List (TransvectionStruct (Fin 3) k)) :
    sl3BlockMatrix (L.map TransvectionStruct.toMatrix).prod ∈ rootTorusMatrices k := by
  induction L with
  | nil =>
    rw [List.map_nil, List.prod_nil, sl3BlockMatrix_one]
    exact Submonoid.one_mem _
  | cons t L ih =>
    rw [List.map_cons, List.prod_cons, sl3BlockMatrix_mul]
    exact Submonoid.mul_mem _ (sl3BlockMatrix_transvection_mem t) ih

theorem sl3BlockMatrix_mem_of_det_eq_one (M : Matrix (Fin 3) (Fin 3) k) (hM : M.det = 1) :
    sl3BlockMatrix M ∈ rootTorusMatrices k := by
  obtain ⟨L, L', D, hLD⟩ := Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec M
  have hD : D 0 * D 1 * D 2 = 1 := by
    have h := congrArg Matrix.det hLD
    rw [det_mul, det_mul, TransvectionStruct.det_toMatrix_prod,
      TransvectionStruct.det_toMatrix_prod, det_diagonal, Fin.prod_univ_three, hM] at h
    linear_combination -h
  rw [hLD, sl3BlockMatrix_mul, sl3BlockMatrix_mul]
  exact Submonoid.mul_mem _
    (Submonoid.mul_mem _ (sl3BlockMatrix_list_prod_mem L) (sl3BlockMatrix_diagonal_mem D hD))
    (sl3BlockMatrix_list_prod_mem L')

/-! ### The stabilizer of the idempotent `e₀` -/

theorem mulFun_single_zero_left (y : Fin 8 → k) :
    mulFun k (Pi.single 0 1) y = ![y 0, y 1, y 2, y 3, 0, 0, 0, 0] := by
  funext i
  fin_cases i <;> simp [mulFun]

theorem mulFun_single_zero_right (y : Fin 8 → k) :
    mulFun k y (Pi.single 0 1) = ![y 0, 0, 0, 0, y 4, y 5, y 6, 0] := by
  funext i
  fin_cases i <;> simp [mulFun]

variable {M : Matrix (Fin 8) (Fin 8) k}

theorem stab_u (hM : IsAutomorphism M.mulVec) (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1)
    (i : Fin 8) (hx1 : mulFun k (Pi.single 0 1) (Pi.single i 1) = Pi.single i 1)
    (hx2 : mulFun k (Pi.single i 1) (Pi.single 0 1) = 0) :
    M 0 i = 0 ∧ M 4 i = 0 ∧ M 5 i = 0 ∧ M 6 i = 0 ∧ M 7 i = 0 := by
  have a := hM.2 (Pi.single 0 1) (Pi.single i 1)
  rw [hx1, h0, mulFun_single_zero_left, mulVec_single_one] at a
  have b := hM.2 (Pi.single i 1) (Pi.single 0 1)
  rw [hx2, h0, mulVec_zero, mulFun_single_zero_right, mulVec_single_one] at b
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa using (congrFun b 0).symm
  · simpa using congrFun a 4
  · simpa using congrFun a 5
  · simpa using congrFun a 6
  · simpa using congrFun a 7

theorem stab_v (hM : IsAutomorphism M.mulVec) (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1)
    (i : Fin 8) (hx1 : mulFun k (Pi.single i 1) (Pi.single 0 1) = Pi.single i 1)
    (hx2 : mulFun k (Pi.single 0 1) (Pi.single i 1) = 0) :
    M 0 i = 0 ∧ M 1 i = 0 ∧ M 2 i = 0 ∧ M 3 i = 0 ∧ M 7 i = 0 := by
  have a := hM.2 (Pi.single i 1) (Pi.single 0 1)
  rw [hx1, h0, mulFun_single_zero_right, mulVec_single_one] at a
  have b := hM.2 (Pi.single 0 1) (Pi.single i 1)
  rw [hx2, h0, mulVec_zero, mulFun_single_zero_left, mulVec_single_one] at b
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa using (congrFun b 0).symm
  · simpa using congrFun a 1
  · simpa using congrFun a 2
  · simpa using congrFun a 3
  · simpa using congrFun a 7

theorem stab_entry (hM : IsAutomorphism M.mulVec) (i j : Fin 8) (z : Fin 8 → k)
    (hz : mulFun k (Pi.single i 1) (Pi.single j 1) = z) (l : Fin 8) :
    (M *ᵥ z) l = mulFun k (fun a => M a i) (fun a => M a j) l := by
  rw [← hz, hM.2, mulVec_single_one, mulVec_single_one]
  rfl

theorem fix_seven (hM : IsAutomorphism M.mulVec) (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1) :
    M *ᵥ Pi.single 7 1 = Pi.single 7 1 := by
  have hu : unit k = Pi.single 0 1 + Pi.single 7 1 := by
    funext l
    fin_cases l <;> simp [unit]
  have h := hM.1
  rw [hu, mulVec_add, h0] at h
  exact add_left_cancel h

/-- The block of an `8 × 8` matrix on the coordinates `u₁, u₂, u₃`. -/
def blockU (M : Matrix (Fin 8) (Fin 8) k) : Matrix (Fin 3) (Fin 3) k :=
  Matrix.of fun a b => M (![1, 2, 3] a) (![1, 2, 3] b)

/-- The block of an `8 × 8` matrix on the coordinates `v₁, v₂, v₃`. -/
def blockV (M : Matrix (Fin 8) (Fin 8) k) : Matrix (Fin 3) (Fin 3) k :=
  Matrix.of fun a b => M (![4, 5, 6] a) (![4, 5, 6] b)

theorem fix_eq_zornBlock (hM : IsAutomorphism M.mulVec)
    (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1) : M = zornBlock (blockU M) (blockV M) := by
  have c0 : ∀ l, M l 0 = (Pi.single 0 1 : Fin 8 → k) l := fun l => by
    rw [← h0, mulVec_single_one]
    rfl
  have c7 : ∀ l, M l 7 = (Pi.single 7 1 : Fin 8 → k) l := fun l => by
    rw [← fix_seven hM h0, mulVec_single_one]
    rfl
  obtain ⟨u01, u41, u51, u61, u71⟩ := stab_u hM h0 1
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  obtain ⟨u02, u42, u52, u62, u72⟩ := stab_u hM h0 2
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  obtain ⟨u03, u43, u53, u63, u73⟩ := stab_u hM h0 3
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  obtain ⟨v04, v14, v24, v34, v74⟩ := stab_v hM h0 4
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  obtain ⟨v05, v15, v25, v35, v75⟩ := stab_v hM h0 5
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  obtain ⟨v06, v16, v26, v36, v76⟩ := stab_v hM h0 6
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  ext a b
  fin_cases a <;> fin_cases b <;> simp [zornBlock, blockU, blockV, c0, c7, u01, u41, u51, u61,
    u71, u02, u42, u52, u62, u72, u03, u43, u53, u63, u73, v04, v14, v24, v34, v74, v05, v15, v25,
    v35, v75, v06, v16, v26, v36, v76]

theorem fix_dot (hM : IsAutomorphism M.mulVec) {i j : Fin 8} (hi : M 0 i = 0)
    {z : Fin 8 → k} (hz : mulFun k (Pi.single i 1) (Pi.single j 1) = z) :
    (M *ᵥ z) 0 = M 1 i * M 4 j + M 2 i * M 5 j + M 3 i * M 6 j := by
  rw [stab_entry hM i j z hz]
  simp only [mulFun, Matrix.cons_val_zero, hi]
  ring

theorem fix_transpose_mul (hM : IsAutomorphism M.mulVec)
    (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1) : (blockU M)ᵀ * blockV M = 1 := by
  have u01 := (stab_u hM h0 1 (by funext l; fin_cases l <;> simp [mulFun])
    (by funext l; fin_cases l <;> simp [mulFun])).1
  have u02 := (stab_u hM h0 2 (by funext l; fin_cases l <;> simp [mulFun])
    (by funext l; fin_cases l <;> simp [mulFun])).1
  have u03 := (stab_u hM h0 3 (by funext l; fin_cases l <;> simp [mulFun])
    (by funext l; fin_cases l <;> simp [mulFun])).1
  have e14 : M 1 1 * M 4 4 + M 2 1 * M 5 4 + M 3 1 * M 6 4 = 1 := by
    rw [← fix_dot hM u01 (z := Pi.single 0 1) (by funext l; fin_cases l <;> simp [mulFun]), h0]
    simp
  have e25 : M 1 2 * M 4 5 + M 2 2 * M 5 5 + M 3 2 * M 6 5 = 1 := by
    rw [← fix_dot hM u02 (z := Pi.single 0 1) (by funext l; fin_cases l <;> simp [mulFun]), h0]
    simp
  have e36 : M 1 3 * M 4 6 + M 2 3 * M 5 6 + M 3 3 * M 6 6 = 1 := by
    rw [← fix_dot hM u03 (z := Pi.single 0 1) (by funext l; fin_cases l <;> simp [mulFun]), h0]
    simp
  have e15 : M 1 1 * M 4 5 + M 2 1 * M 5 5 + M 3 1 * M 6 5 = 0 := by
    rw [← fix_dot hM u01 (z := 0) (by funext l; fin_cases l <;> simp [mulFun]), mulVec_zero]
    rfl
  have e16 : M 1 1 * M 4 6 + M 2 1 * M 5 6 + M 3 1 * M 6 6 = 0 := by
    rw [← fix_dot hM u01 (z := 0) (by funext l; fin_cases l <;> simp [mulFun]), mulVec_zero]
    rfl
  have e24 : M 1 2 * M 4 4 + M 2 2 * M 5 4 + M 3 2 * M 6 4 = 0 := by
    rw [← fix_dot hM u02 (z := 0) (by funext l; fin_cases l <;> simp [mulFun]), mulVec_zero]
    rfl
  have e26 : M 1 2 * M 4 6 + M 2 2 * M 5 6 + M 3 2 * M 6 6 = 0 := by
    rw [← fix_dot hM u02 (z := 0) (by funext l; fin_cases l <;> simp [mulFun]), mulVec_zero]
    rfl
  have e34 : M 1 3 * M 4 4 + M 2 3 * M 5 4 + M 3 3 * M 6 4 = 0 := by
    rw [← fix_dot hM u03 (z := 0) (by funext l; fin_cases l <;> simp [mulFun]), mulVec_zero]
    rfl
  have e35 : M 1 3 * M 4 5 + M 2 3 * M 5 5 + M 3 3 * M 6 5 = 0 := by
    rw [← fix_dot hM u03 (z := 0) (by funext l; fin_cases l <;> simp [mulFun]), mulVec_zero]
    rfl
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [blockU, blockV, Matrix.mul_apply, Fin.sum_univ_three]
  all_goals first
    | linear_combination e14 | linear_combination e25 | linear_combination e36
    | linear_combination e15 | linear_combination e16 | linear_combination e24
    | linear_combination e26 | linear_combination e34 | linear_combination e35

theorem fix_det (hM : IsAutomorphism M.mulVec) (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1) :
    (blockU M).det = 1 := by
  obtain ⟨u01, u41, u51, u61, u71⟩ := stab_u hM h0 1
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  obtain ⟨u02, u42, u52, u62, -⟩ := stab_u hM h0 2
    (by funext l; fin_cases l <;> simp [mulFun]) (by funext l; fin_cases l <;> simp [mulFun])
  have u03 := (stab_u hM h0 3 (by funext l; fin_cases l <;> simp [mulFun])
    (by funext l; fin_cases l <;> simp [mulFun])).1
  have e36 : M 1 3 * M 4 6 + M 2 3 * M 5 6 + M 3 3 * M 6 6 = 1 := by
    rw [← fix_dot hM u03 (z := Pi.single 0 1) (by funext l; fin_cases l <;> simp [mulFun]), h0]
    simp
  have cross : ∀ l, M l 6 = mulFun k (fun a => M a 1) (fun a => M a 2) l := by
    intro l
    have h := stab_entry hM 1 2 (Pi.single 6 1) (by funext l; fin_cases l <;> simp [mulFun]) l
    rw [mulVec_single_one] at h
    exact h
  have x4 := cross 4
  have x5 := cross 5
  have x6 := cross 6
  simp [mulFun, u02, u41, u71, u42, u51, u52, u61, u62] at x4 x5 x6
  rw [det_fin_three]
  simp only [blockU, Matrix.of_apply, Matrix.cons_val, Fin.isValue]
  linear_combination e36 - M 1 3 * x4 - M 2 3 * x5 - M 3 3 * x6

/-- The automorphism matrices fixing `e₀` are the block matrices `sl3BlockMatrix B` with
`det B = 1`. -/
theorem exists_sl3BlockMatrix_of_fix (hM : IsAutomorphism M.mulVec)
    (h0 : M *ᵥ Pi.single 0 1 = Pi.single 0 1) :
    ∃ B : Matrix (Fin 3) (Fin 3) k, B.det = 1 ∧ M = sl3BlockMatrix B := by
  refine ⟨blockU M, fix_det hM h0, ?_⟩
  have hV : (blockU M)⁻¹ᵀ = blockV M := by
    rw [transpose_nonsing_inv]
    exact Matrix.inv_eq_right_inv (fix_transpose_mul hM h0)
  calc M = zornBlock (blockU M) (blockV M) := fix_eq_zornBlock hM h0
    _ = sl3BlockMatrix (blockU M) := by rw [sl3BlockMatrix, hV]

/-! ### Moving an idempotent to `e₀` -/

/-- Every automorphism matrix in `GL₈(k)` whose first column is `p` lies in the generated
subgroup. -/
def Good (p : Fin 8 → k) : Prop :=
  ∀ g : GL (Fin 8) k, IsAutomorphism (g : Matrix (Fin 8) (Fin 8) k).mulVec →
    (g : Matrix (Fin 8) (Fin 8) k) *ᵥ Pi.single 0 1 = p → g ∈ rootTorusClosure k

/-- `p` is an idempotent of Zorn's algebra different from `0` and from the unit. -/
def IsIdem (p : Fin 8 → k) : Prop :=
  mulFun k p p = p ∧ p ≠ 0 ∧ p ≠ unit k

theorem good_of_rootFun {p : Fin 8 → k} (α : Root) (r : k) (h : Good (rootFun α r p)) :
    Good p := by
  intro g hg hp
  have hg' : rootGL α r * g ∈ rootTorusClosure k := by
    apply h
    · rw [Units.val_mul]
      exact isAutomorphism_mul (isAutomorphism_rootGL α r) hg
    · rw [Units.val_mul, ← mulVec_mulVec, hp, rootGL_val, rootMatrix_mulVec]
  have := (rootTorusClosure k).mul_mem
    ((rootTorusClosure k).inv_mem (rootGL_mem_rootTorusClosure α r)) hg'
  rwa [inv_mul_cancel_left] at this

theorem good_single_zero : Good (Pi.single 0 1 : Fin 8 → k) := by
  intro g hg hp
  obtain ⟨B, hB, hgB⟩ := exists_sl3BlockMatrix_of_fix hg hp
  apply mem_rootTorusClosure_of_val_mem
  rw [hgB]
  exact sl3BlockMatrix_mem_of_det_eq_one B hB

theorem rootFun_zero_vec (α : Root) (r : k) : rootFun α r (0 : Fin 8 → k) = 0 := by
  rw [← rootMatrix_mulVec, mulVec_zero]

theorem rootFun_neg_rootFun (α : Root) (r : k) (x : Fin 8 → k) :
    rootFun α (-r) (rootFun α r x) = x := by
  rw [rootFun_rootFun, neg_add_cancel, rootFun_zero]

theorem isIdem_rootFun {p : Fin 8 → k} (hp : IsIdem p) (α : Root) (r : k) :
    IsIdem (rootFun α r p) := by
  obtain ⟨h1, h2, h3⟩ := hp
  refine ⟨?_, fun h => h2 ?_, fun h => h3 ?_⟩
  · rw [← (isAutomorphism_rootFun α r).2, h1]
  · rw [← rootFun_neg_rootFun α r p, h, rootFun_zero_vec]
  · rw [← rootFun_neg_rootFun α r p, h, (isAutomorphism_rootFun α (-r)).1]

theorem IsIdem.coords {p : Fin 8 → k} (h : IsIdem p) :
    p 0 * p 0 + (p 1 * p 4 + p 2 * p 5 + p 3 * p 6) = p 0 ∧
    (p 0 + p 7) * p 1 = p 1 ∧ (p 0 + p 7) * p 2 = p 2 ∧ (p 0 + p 7) * p 3 = p 3 ∧
    (p 0 + p 7) * p 4 = p 4 ∧ (p 0 + p 7) * p 5 = p 5 ∧ (p 0 + p 7) * p 6 = p 6 ∧
    p 7 * p 7 + (p 1 * p 4 + p 2 * p 5 + p 3 * p 6) = p 7 := by
  have e := h.1
  have e0 := congrFun e 0
  have e1 := congrFun e 1
  have e2 := congrFun e 2
  have e3 := congrFun e 3
  have e4 := congrFun e 4
  have e5 := congrFun e 5
  have e6 := congrFun e 6
  have e7 := congrFun e 7
  simp only [mulFun, Matrix.cons_val, Fin.isValue] at e0 e1 e2 e3 e4 e5 e6 e7
  exact ⟨by linear_combination e0, by linear_combination e1, by linear_combination e2,
    by linear_combination e3, by linear_combination e4, by linear_combination e5,
    by linear_combination e6, by linear_combination e7⟩

/-- Step A: idempotents on the diagonal `k e₀ + k e₇`. -/
theorem good_of_diag {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 = 0) (h2 : p 2 = 0)
    (h3 : p 3 = 0) (h4 : p 4 = 0) (h5 : p 5 = 0) (h6 : p 6 = 0) : Good p := by
  obtain ⟨E0, -, -, -, -, -, -, E7⟩ := hp.coords
  have a0 : p 0 = 0 ∨ p 0 = 1 := by
    have : p 0 * (p 0 - 1) = 0 := by
      linear_combination E0 - p 4 * h1 - p 5 * h2 - p 6 * h3
    rcases mul_eq_zero.1 this with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.1 h)
  have a7 : p 7 = 0 ∨ p 7 = 1 := by
    have : p 7 * (p 7 - 1) = 0 := by
      linear_combination E7 - p 4 * h1 - p 5 * h2 - p 6 * h3
    rcases mul_eq_zero.1 this with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.1 h)
  rcases a0 with a0 | a0 <;> rcases a7 with a7 | a7
  · exfalso
    apply hp.2.1
    funext i
    fin_cases i <;> simp [h1, h2, h3, h4, h5, h6, a0, a7]
  · refine good_of_rootFun .v1 1 (good_of_rootFun .u1 1 (good_of_rootFun .v1 1 ?_))
    have hq : rootFun Root.v1 1 (rootFun Root.u1 1 (rootFun Root.v1 1 p)) = Pi.single 0 1 := by
      funext i
      fin_cases i <;> simp [rootFun, h1, h2, h3, h4, h5, h6, a0, a7]
    rw [hq]
    exact good_single_zero
  · have hq : p = Pi.single 0 1 := by
      funext i
      fin_cases i <;> simp [h1, h2, h3, h4, h5, h6, a0, a7]
    rw [hq]
    exact good_single_zero
  · exfalso
    apply hp.2.2
    funext i
    fin_cases i <;> simp [unit, h1, h2, h3, h4, h5, h6, a0, a7]

theorem sub_ne_zero_of_idem {p : Fin 8 → k} (hp : IsIdem p) {i : Fin 8} (hi : p i ≠ 0)
    (hi' : (p 0 + p 7) * p i = p i) (h : p 1 * p 4 + p 2 * p 5 + p 3 * p 6 = 0) :
    p 0 - p 7 ≠ 0 := by
  have hab : p 0 + p 7 = 1 := by
    have : (p 0 + p 7 - 1) * p i = 0 := by linear_combination hi'
    exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hi)
  intro hd
  have E0 := hp.coords.1
  have E0' : p 0 * p 0 = p 0 := by linear_combination E0 - h
  exact one_ne_zero (by
    linear_combination (2 * p 0 - 1) * hab + (2 * p 0 - 1) * hd - 4 * E0' : (1 : k) = 0)

/-- Step B3: `u = 0` and `v = (v₁, 0, 0)` with `v₁ ≠ 0`. -/
theorem good_B3 {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 = 0) (h2 : p 2 = 0)
    (h3 : p 3 = 0) (h4 : p 4 ≠ 0) (h5 : p 5 = 0) (h6 : p 6 = 0) : Good p := by
  have hd := sub_ne_zero_of_idem hp h4 hp.coords.2.2.2.2.1
    (by rw [h1, h2, h3]; ring)
  have hr : -p 4 / (p 0 - p 7) * (p 0 - p 7) = -p 4 := div_mul_cancel₀ _ hd
  set r := -p 4 / (p 0 - p 7)
  refine good_of_rootFun .v1 r ?_
  refine good_of_diag (isIdem_rootFun hp .v1 r) ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp only [rootFun, Matrix.cons_val, Fin.isValue]
  · exact h1
  · linear_combination h2 - r * h6
  · linear_combination h3 + r * h5
  · linear_combination hr - r ^ 2 * h1
  · exact h5
  · exact h6

/-- Step B2a: `u = 0`, `v₁ ≠ 0` and `v₂ = 0`. -/
theorem good_B2a {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 = 0) (h2 : p 2 = 0)
    (h3 : p 3 = 0) (h4 : p 4 ≠ 0) (h5 : p 5 = 0) : Good p := by
  have hr : p 6 / p 4 * p 4 = p 6 := div_mul_cancel₀ _ h4
  set r := p 6 / p 4
  refine good_of_rootFun .l13 r ?_
  refine good_B3 (isIdem_rootFun hp .l13 r) ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp only [rootFun, Matrix.cons_val, Fin.isValue]
  · linear_combination h1 + r * h3
  · exact h2
  · exact h3
  · exact h4
  · exact h5
  · linear_combination -hr

/-- Step B2: `u = 0` and `v₁ ≠ 0`. -/
theorem good_B2 {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 = 0) (h2 : p 2 = 0)
    (h3 : p 3 = 0) (h4 : p 4 ≠ 0) : Good p := by
  have hr : p 5 / p 4 * p 4 = p 5 := div_mul_cancel₀ _ h4
  set r := p 5 / p 4
  refine good_of_rootFun .l12 r ?_
  refine good_B2a (isIdem_rootFun hp .l12 r) ?_ ?_ ?_ ?_ ?_ <;>
    simp only [rootFun, Matrix.cons_val, Fin.isValue]
  · linear_combination h1 + r * h2
  · exact h2
  · exact h3
  · exact h4
  · linear_combination -hr

/-- Step B: idempotents with `u = 0`. -/
theorem good_B {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 = 0) (h2 : p 2 = 0)
    (h3 : p 3 = 0) : Good p := by
  by_cases h4 : p 4 = 0
  · by_cases h5 : p 5 = 0
    · by_cases h6 : p 6 = 0
      · exact good_of_diag hp h1 h2 h3 h4 h5 h6
      · refine good_of_rootFun .l31 (-1) ?_
        refine good_B2 (isIdem_rootFun hp .l31 (-1)) ?_ ?_ ?_ ?_ <;>
          simp only [rootFun, Matrix.cons_val, Fin.isValue]
        · exact h1
        · exact h2
        · linear_combination h3 - h1
        · intro h
          apply h6
          linear_combination h - h4
    · refine good_of_rootFun .l21 (-1) ?_
      refine good_B2 (isIdem_rootFun hp .l21 (-1)) ?_ ?_ ?_ ?_ <;>
        simp only [rootFun, Matrix.cons_val, Fin.isValue]
      · exact h1
      · linear_combination h2 - h1
      · exact h3
      · intro h
        apply h5
        linear_combination h - h4
  · exact good_B2 hp h1 h2 h3 h4

theorem exists_root_C3 {p : Fin 8 → k} [IsAlgClosed k] (hp : IsIdem p) (h1 : p 1 ≠ 0)
    (h2 : p 2 = 0) (h3 : p 3 = 0) : ∃ r : k, p 1 + r * (p 0 - p 7) - r ^ 2 * p 4 = 0 := by
  by_cases h4 : p 4 = 0
  · have hd := sub_ne_zero_of_idem hp h1 hp.coords.2.1 (by rw [h2, h3, h4]; ring)
    refine ⟨-p 1 / (p 0 - p 7), ?_⟩
    have hr : -p 1 / (p 0 - p 7) * (p 0 - p 7) = -p 1 := div_mul_cancel₀ _ hd
    linear_combination hr - (-p 1 / (p 0 - p 7)) ^ 2 * h4
  · obtain ⟨r, hr⟩ := IsAlgClosed.exists_root (C (-p 4) * X ^ 2 + C (p 0 - p 7) * X + C (p 1))
      (by rw [degree_quadratic (neg_ne_zero.2 h4)]; decide)
    refine ⟨r, ?_⟩
    have hr' := hr.eq_zero
    simp only [eval_add, eval_mul, eval_C, eval_pow, eval_X] at hr'
    linear_combination hr'

/-- Step C3: `u = (u₁, 0, 0)` with `u₁ ≠ 0`. -/
theorem good_C3 [IsAlgClosed k] {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 ≠ 0) (h2 : p 2 = 0)
    (h3 : p 3 = 0) : Good p := by
  obtain ⟨r, hr⟩ := exists_root_C3 hp h1 h2 h3
  refine good_of_rootFun .u1 r ?_
  refine good_B (isIdem_rootFun hp .u1 r) ?_ ?_ ?_ <;>
    simp only [rootFun, Matrix.cons_val, Fin.isValue]
  · linear_combination hr
  · exact h2
  · exact h3

/-- Step C2a: `u₁ ≠ 0` and `u₂ = 0`. -/
theorem good_C2a [IsAlgClosed k] {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 ≠ 0)
    (h2 : p 2 = 0) : Good p := by
  have hr : -p 3 / p 1 * p 1 = -p 3 := div_mul_cancel₀ _ h1
  set r := -p 3 / p 1
  refine good_of_rootFun .l31 r ?_
  refine good_C3 (isIdem_rootFun hp .l31 r) ?_ ?_ ?_ <;>
    simp only [rootFun, Matrix.cons_val, Fin.isValue]
  · exact h1
  · exact h2
  · linear_combination hr

/-- Step C2: `u₁ ≠ 0`. -/
theorem good_C2 [IsAlgClosed k] {p : Fin 8 → k} (hp : IsIdem p) (h1 : p 1 ≠ 0) : Good p := by
  have hr : -p 2 / p 1 * p 1 = -p 2 := div_mul_cancel₀ _ h1
  set r := -p 2 / p 1
  refine good_of_rootFun .l21 r ?_
  refine good_C2a (isIdem_rootFun hp .l21 r) ?_ ?_ <;>
    simp only [rootFun, Matrix.cons_val, Fin.isValue]
  · exact h1
  · linear_combination hr

/-- Every nontrivial idempotent different from the unit is moved to `e₀`. -/
theorem good_of_isIdem [IsAlgClosed k] {p : Fin 8 → k} (hp : IsIdem p) : Good p := by
  by_cases h1 : p 1 = 0
  · by_cases h2 : p 2 = 0
    · by_cases h3 : p 3 = 0
      · exact good_B hp h1 h2 h3
      · refine good_of_rootFun .l13 1 ?_
        refine good_C2 (isIdem_rootFun hp .l13 1) ?_
        simp only [rootFun, Matrix.cons_val, Fin.isValue]
        intro h
        apply h3
        linear_combination h - h1
    · refine good_of_rootFun .l12 1 ?_
      refine good_C2 (isIdem_rootFun hp .l12 1) ?_
      simp only [rootFun, Matrix.cons_val, Fin.isValue]
      intro h
      apply h2
      linear_combination h - h1
  · exact good_C2 hp h1

theorem mulVec_injective_of_GL (g : GL (Fin 8) k) :
    Function.Injective (g : Matrix (Fin 8) (Fin 8) k).mulVec := by
  intro x y h
  have := congrArg (((g⁻¹ : GL (Fin 8) k) : Matrix (Fin 8) (Fin 8) k).mulVec) h
  simpa [mulVec_mulVec] using this

theorem isIdem_mulVec_single_zero {g : GL (Fin 8) k}
    (hg : IsAutomorphism (g : Matrix (Fin 8) (Fin 8) k).mulVec) :
    IsIdem ((g : Matrix (Fin 8) (Fin 8) k) *ᵥ Pi.single 0 1) := by
  have he : mulFun k (Pi.single 0 1) (Pi.single 0 1) = Pi.single 0 1 := by
    funext l
    fin_cases l <;> simp [mulFun]
  refine ⟨?_, fun h => ?_, fun h => ?_⟩
  · rw [← hg.2, he]
  · have := mulVec_injective_of_GL g (h.trans (mulVec_zero _).symm)
    simpa using congrFun this 0
  · have := mulVec_injective_of_GL g (h.trans hg.1.symm)
    simpa [unit] using congrFun this 7

/-- Over an algebraically closed field every automorphism matrix lies in the subgroup generated
by the root-group and torus elements. -/
theorem mem_rootTorusClosure [IsAlgClosed k] {g : GL (Fin 8) k}
    (hg : IsAutomorphism (g : Matrix (Fin 8) (Fin 8) k).mulVec) : g ∈ rootTorusClosure k :=
  good_of_isIdem (isIdem_mulVec_single_zero hg) g hg rfl

end Field

/-- The generation statement of `Interface.lean`. -/
theorem generation : GenerationStatement.{u} := fun _ _ _ _ hg => mem_rootTorusClosure hg

end SplitCayley

end Langlands.GroupScheme
