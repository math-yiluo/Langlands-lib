import Langlands.GroupScheme.Reductive.Basic
import Mathlib.AlgebraicGeometry.AlgClosed.Basic

/-! # Closed subgroups generated by the closure of a group of rational points -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- The points of the underlying space of `G` at which the given `k`-points are located. -/
def rationalPointImage {k : Type u} [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (Γ : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)) : Set G.X.left :=
  (fun x => x.left (IsLocalRing.closedPoint k)) '' Γ

/-- Over an algebraically closed field, the Zariski closure of a subgroup `Γ` of the rational
points of an affine group scheme `H` locally of finite type is the underlying set of a smooth
closed subgroup of `H` (Milne 2017, Lemma 1.40, Theorem 1.45 and Proposition 1.26(b)). -/
def RationalPointClosureSubgroupStatement : Prop :=
  ∀ (k : Type u) [Field k] [IsAlgClosed k] (H : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom H.X.hom] [LocallyOfFiniteType H.X.hom]
    (Γ : Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X)),
    ∃ (Z : GroupScheme (Spec (CommRingCat.of k))) (ζ : Z ⟶ H),
      IsClosedSubgroup ζ ∧ Smooth Z.X.hom ∧
        Set.range ζ.hom.hom.left = closure (rationalPointImage H (Γ : Set _))

end Langlands.GroupScheme
