import Langlands.GroupScheme.CorepresentedClosedSubgroup
import Langlands.GroupScheme.GeneralLinearSmoothProof
import Mathlib.AlgebraicGeometry.Properties

/-! # Coordinates on the upper triangular subgroup scheme of `GL_N`

For a strictly decreasing weight vector `e : Fin N → ℤ`, the block parabolic subgroup scheme of
`GL_N` over `Spec R` is the scheme of invertible upper triangular matrices. Its coordinate ring,
the quotient of the coordinate ring of `GL_N` by the entries below the diagonal, is the
polynomial ring in the entries on and above the diagonal with the product of the diagonal
entries inverted. Consequently the block parabolic subgroup scheme is smooth, and over a domain
its underlying space is irreducible, hence connected.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry MvPolynomial

namespace Langlands.GroupScheme.GeneralLinear.UpperTriangular

variable (N : ℕ) (R : CommRingCat.{u})

/-- The positions `(i, j)` with `i ≤ j`, on and above the diagonal. -/
abbrev Position : Type := {p : Fin N × Fin N // p.1 ≤ p.2}

/-- The polynomial ring in the entries on and above the diagonal. -/
abbrev Poly : Type u := MvPolynomial (Position N) R

/-- The product of the diagonal variables. -/
def diagonalProduct : Poly N R := ∏ i : Fin N, X ⟨(i, i), le_rfl⟩

/-- The polynomial ring in the entries on and above the diagonal, with the product of the
diagonal variables inverted. -/
abbrev Coord : Type u := Localization.Away (diagonalProduct N R)

/-- The generic upper triangular matrix over `Coord N R`. -/
def genericMatrix : Matrix (Fin N) (Fin N) (Coord N R) :=
  Matrix.of fun i j =>
    if h : i ≤ j then algebraMap (Poly N R) (Coord N R) (X ⟨(i, j), h⟩) else 0

theorem genericMatrix_apply_of_le {i j : Fin N} (h : i ≤ j) :
    genericMatrix N R i j = algebraMap (Poly N R) (Coord N R) (X ⟨(i, j), h⟩) := by
  simp [genericMatrix, h]

theorem genericMatrix_isUpperTriangular : (genericMatrix N R).IsUpperTriangular := by
  intro i j hji
  have h : ¬ i ≤ j := not_le.mpr hji
  simp only [genericMatrix, Matrix.of_apply, h, dite_false]

theorem genericMatrix_det :
    (genericMatrix N R).det = algebraMap (Poly N R) (Coord N R) (diagonalProduct N R) := by
  rw [Matrix.det_of_isUpperTriangular (genericMatrix_isUpperTriangular N R)]
  refine Eq.trans ?_ (map_prod (algebraMap (Poly N R) (Coord N R)) _ _).symm
  exact Finset.prod_congr rfl fun i _ => genericMatrix_apply_of_le N R le_rfl

/-- The generic invertible upper triangular matrix over `Coord N R`. -/
def genericUnit : GL (Fin N) (Coord N R) :=
  Matrix.GeneralLinearGroup.mk'' (genericMatrix N R) (by
    rw [genericMatrix_det]
    exact IsLocalization.Away.algebraMap_isUnit _)

@[simp] theorem genericUnit_apply (i j : Fin N) :
    genericUnit N R i j = genericMatrix N R i j := rfl

variable {N} (e : Fin N → ℤ)

/-- The ideal of the coordinate ring of `GL_N` generated by the entries `x_ij` with
`e i < e j`. -/
abbrev lowerIdeal : Ideal (CoordinateRing (Fin N) R) := entryIdeal (Fin N) R (fun i j => e i < e j) 0

/-- The coordinate ring of the block parabolic subgroup scheme of `e`. -/
abbrev QuotRing : Type u := CoordinateRing (Fin N) R ⧸ lowerIdeal R e

/-- The universal matrix of `GL_N` over the coordinate ring of the block parabolic subgroup. -/
def quotUnit : GL (Fin N) (QuotRing R e) :=
  point (S := QuotRing R e) (Ideal.Quotient.mkₐ R (lowerIdeal R e))

theorem quotUnit_apply (i j : Fin N) :
    quotUnit R e i j =
      Ideal.Quotient.mk (lowerIdeal R e) (quotient (Fin N) R (X (Coordinate.entry i j))) :=
  rfl

/-- The polynomial map sending each variable to the corresponding entry of the universal matrix
over the coordinate ring of the block parabolic subgroup. -/
def polyToQuot : Poly N R →ₐ[R] QuotRing R e :=
  aeval fun p => quotUnit R e p.1.1 p.1.2

variable {e} (he : StrictAnti e)
include he

theorem genericUnit_mem_blockParabolicSubgroup :
    genericUnit N R ∈ blockParabolicSubgroup (Coord N R) e := by
  rw [mem_blockParabolicSubgroup]
  intro i j hij
  exact genericMatrix_isUpperTriangular N R (he.lt_iff_gt.mp hij)

/-- The classifying map of the generic invertible upper triangular matrix, from the coordinate
ring of the block parabolic subgroup scheme. -/
def toCoord : QuotRing R e →ₐ[R] Coord N R :=
  Ideal.Quotient.liftₐ (lowerIdeal R e) (classify (genericUnit N R)) fun a ha =>
    (classify_eq_zero_iff (genericUnit N R) _ _).2 (fun i j hij => by
      rw [Pi.zero_apply, Pi.zero_apply, map_zero]
      exact (mem_blockParabolicSubgroup _ _).1
        (genericUnit_mem_blockParabolicSubgroup R he) i j hij) a ha

theorem toCoord_mk (a : CoordinateRing (Fin N) R) :
    toCoord R he (Ideal.Quotient.mk (lowerIdeal R e) a) = classify (genericUnit N R) a :=
  rfl

theorem quotUnit_isUpperTriangular : (quotUnit R e : Matrix (Fin N) (Fin N) (QuotRing R e)).IsUpperTriangular := by
  intro i j hji
  rw [quotUnit_apply, Ideal.Quotient.eq_zero_iff_mem]
  have hmem := Ideal.subset_span (s := {b | ∃ i j, e i < e j ∧
      quotient (Fin N) R (X (Coordinate.entry i j)) -
        algebraMap R (CoordinateRing (Fin N) R) ((0 : Fin N → Fin N → R) i j) = b})
    ⟨i, j, he.lt_iff_gt.mpr hji, rfl⟩
  rwa [Pi.zero_apply, Pi.zero_apply, map_zero, sub_zero] at hmem

theorem polyToQuot_diagonalProduct_isUnit : IsUnit (polyToQuot R e (diagonalProduct N R)) := by
  have h : polyToQuot R e (diagonalProduct N R) =
      (quotUnit R e : Matrix (Fin N) (Fin N) (QuotRing R e)).det := by
    rw [Matrix.det_of_isUpperTriangular (quotUnit_isUpperTriangular R he)]
    have hp : polyToQuot R e (diagonalProduct N R) =
        ∏ i : Fin N, polyToQuot R e (X ⟨(i, i), le_rfl⟩) :=
      map_prod (polyToQuot R e) _ _
    rw [hp]
    simp [polyToQuot]
  rw [h]
  exact (Matrix.isUnit_iff_isUnit_det _).mp (quotUnit R e).isUnit

/-- The extension of `polyToQuot` to the localization. -/
def fromCoord : Coord N R →ₐ[R] QuotRing R e :=
  IsLocalization.Away.liftAlgHom (P := QuotRing R e) (f := polyToQuot R e) (diagonalProduct N R)
    (polyToQuot_diagonalProduct_isUnit R he)

theorem fromCoord_algebraMap (p : Poly N R) :
    fromCoord R he (algebraMap (Poly N R) (Coord N R) p) = polyToQuot R e p :=
  IsLocalization.Away.lift_eq _ (polyToQuot_diagonalProduct_isUnit R he) p

theorem fromCoord_genericMatrix (i j : Fin N) :
    fromCoord R he (genericMatrix N R i j) = quotUnit R e i j := by
  by_cases h : i ≤ j
  · rw [genericMatrix_apply_of_le N R h, fromCoord_algebraMap]
    simp [polyToQuot]
  · rw [quotUnit_isUpperTriangular R he (not_le.mp h)]
    simp [genericMatrix, h]

theorem fromCoord_comp_toCoord : (fromCoord R he).comp (toCoord R he) = AlgHom.id R (QuotRing R e) := by
  apply Ideal.Quotient.algHom_ext
  apply (homEquiv (n := Fin N) (R := R) (S := QuotRing R e)).injective
  change point (S := QuotRing R e)
      (((fromCoord R he).comp (toCoord R he)).comp (Ideal.Quotient.mkₐ R (lowerIdeal R e))) =
    point (S := QuotRing R e) ((AlgHom.id R (QuotRing R e)).comp (Ideal.Quotient.mkₐ R (lowerIdeal R e)))
  apply Units.ext
  ext i j
  rw [point_apply, point_apply]
  change fromCoord R he (classify (genericUnit N R) (quotient (Fin N) R (X (Coordinate.entry i j)))) =
    quotUnit R e i j
  rw [classify_entry, genericUnit_apply, fromCoord_genericMatrix]

theorem toCoord_comp_fromCoord : (toCoord R he).comp (fromCoord R he) = AlgHom.id R (Coord N R) := by
  apply IsLocalization.algHom_ext (Submonoid.powers (diagonalProduct N R))
  apply MvPolynomial.algHom_ext
  intro p
  change toCoord R he (fromCoord R he (algebraMap (Poly N R) (Coord N R) (X p))) =
    algebraMap (Poly N R) (Coord N R) (X p)
  rw [fromCoord_algebraMap]
  change toCoord R he (aeval (fun p => quotUnit R e p.1.1 p.1.2) (X p)) = _
  rw [aeval_X, quotUnit_apply, toCoord_mk, classify_entry, genericUnit_apply,
    genericMatrix_apply_of_le N R p.2]

/-- The coordinate ring of the block parabolic subgroup scheme of a strictly decreasing weight
vector is the polynomial ring in the entries on and above the diagonal, localized at the product
of the diagonal entries. -/
def quotEquiv : QuotRing R e ≃ₐ[R] Coord N R :=
  AlgEquiv.ofAlgHom (toCoord R he) (fromCoord R he) (toCoord_comp_fromCoord R he)
    (fromCoord_comp_toCoord R he)

/-- The coordinate ring of the block parabolic subgroup scheme is a smooth algebra. -/
theorem quot_smooth : Algebra.Smooth R (QuotRing R e) := by
  let : Algebra.Smooth R (Poly N R) := ⟨inferInstance, inferInstance⟩
  let : Algebra.Smooth (Poly N R) (Coord N R) :=
    Algebra.Smooth.of_isLocalization_Away (diagonalProduct N R)
  let : Algebra.Smooth R (Coord N R) := Algebra.Smooth.comp R (Poly N R) (Coord N R)
  exact Algebra.Smooth.of_equiv (quotEquiv R he).symm

/-- The block parabolic subgroup scheme of a strictly decreasing weight vector is smooth. -/
theorem smooth_blockParabolicScheme : Smooth (blockParabolicScheme (Fin N) R e).X.hom := by
  change Smooth (Spec.map (CommRingCat.ofHom (algebraMap R (QuotRing R e))))
  rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
  change (algebraMap R (QuotRing R e)).Smooth
  rw [RingHom.smooth_algebraMap]
  exact quot_smooth R he

omit he in
theorem diagonalProduct_ne_zero [IsDomain R] : diagonalProduct N R ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun _ _ => X_ne_zero _

/-- Over a domain, the coordinate ring of the block parabolic subgroup scheme is a domain. -/
theorem quot_isDomain [IsDomain R] : IsDomain (QuotRing R e) := by
  have : IsDomain (Coord N R) :=
    IsLocalization.isDomain_localization
      (powers_le_nonZeroDivisors_of_noZeroDivisors (diagonalProduct_ne_zero R))
  exact Function.Injective.isDomain (quotEquiv R he).toRingEquiv.toRingHom
    (quotEquiv R he).injective

/-- Over a domain, the underlying space of the block parabolic subgroup scheme of a strictly
decreasing weight vector is irreducible, hence connected. -/
theorem connectedSpace_blockParabolicScheme [IsDomain R] :
    ConnectedSpace (blockParabolicScheme (Fin N) R e).X.left := by
  have : IsDomain (CommRingCat.of (QuotRing R e)) := quot_isDomain R he
  change ConnectedSpace (Spec (CommRingCat.of (QuotRing R e)))
  infer_instance

end Langlands.GroupScheme.GeneralLinear.UpperTriangular
