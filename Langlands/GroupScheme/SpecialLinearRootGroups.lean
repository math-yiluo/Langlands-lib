import Langlands.GroupScheme.SpecialLinear
import Langlands.GroupScheme.VectorGroupQuotient

/-! # Actual additive root maps and rational generation for split special linear groups -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.SpecialLinear.Root

variable {n : Type} [Fintype n] [DecidableEq n]

section MatrixGeneration

variable {k : Type u} [Field k] {i j : n}

/-- A determinant-one diagonal supported at two positions is a product of six transvections. -/
theorem diag2n_decompose (hij : i ≠ j) (a : k) (ha : a ≠ 0) :
    Matrix.SpecialLinearGroup.diag2n hij a ha =
      Matrix.SpecialLinearGroup.transvection hij a *
        Matrix.SpecialLinearGroup.transvection hij.symm (-a⁻¹) *
        Matrix.SpecialLinearGroup.transvection hij a *
        Matrix.SpecialLinearGroup.transvection hij (-1) *
        Matrix.SpecialLinearGroup.transvection hij.symm 1 *
        Matrix.SpecialLinearGroup.transvection hij (-1) := by
  apply Subtype.ext
  simp only [Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.transvection_coe,
    Matrix.SpecialLinearGroup.diag2n_coe]
  ext r s
  by_cases hri : r = i <;> by_cases hrj : r = j <;>
    by_cases hsi : s = i <;> by_cases hsj : s = j <;>
    simp_all [Matrix.diagonal_apply, Matrix.mul_add, Matrix.add_mul,
      Matrix.single_apply, Matrix.one_apply, eq_comm]

/-- Every split special-linear matrix over a field is generated by scalar transvections. -/
theorem eq_top_of_transvections
    (N : Subgroup (Matrix.SpecialLinearGroup n k))
    (hN : ∀ (i j : n) (hij : i ≠ j) (a : k),
      Matrix.SpecialLinearGroup.transvection hij a ∈ N) : N = ⊤ := by
  cases subsingleton_or_nontrivial n
  · exact Subsingleton.elim _ _
  · apply top_unique
    intro g _
    apply Matrix.SpecialLinearGroup.diagonal_transvection_induction'
      (fun x => x ∈ N) g
    · intro i j hij a ha
      rw [diag2n_decompose hij a ha]
      exact N.mul_mem
        (N.mul_mem (N.mul_mem (N.mul_mem (N.mul_mem
          (hN i j hij a) (hN j i hij.symm (-a⁻¹)))
          (hN i j hij a)) (hN i j hij (-1))) (hN j i hij.symm 1))
        (hN i j hij (-1))
    · exact hN
    · exact fun _ _ => N.mul_mem

end MatrixGeneration

section Matrices

variable {A B : Type u} [CommRing A] [CommRing B] {i j : n}

/-- A transvection is a homomorphism from the additive group of the coefficient ring. -/
def transvectionHom (hij : i ≠ j) : Multiplicative A →* Matrix.SpecialLinearGroup n A where
  toFun a := Matrix.SpecialLinearGroup.transvection hij a.toAdd
  map_one' := Matrix.SpecialLinearGroup.transvection_coeff_zero hij
  map_mul' a b := Matrix.SpecialLinearGroup.transvection_add hij a.toAdd b.toAdd

/-- Transvections commute with arbitrary changes of coefficient ring. -/
theorem map_transvection (f : A →+* B) (hij : i ≠ j) (a : A) :
    Matrix.SpecialLinearGroup.map f (Matrix.SpecialLinearGroup.transvection hij a) =
      Matrix.SpecialLinearGroup.transvection hij (f a) := by
  apply Matrix.SpecialLinearGroup.ext
  intro r s
  simp [Matrix.SpecialLinearGroup.map_apply_coe,
    Matrix.SpecialLinearGroup.transvection_coe, Matrix.single_apply, Matrix.one_apply, apply_ite f]

/-- Entrywise application of a ring equivalence gives an equivalence of special linear groups. -/
def matrixRingEquiv (e : A ≃+* B) :
    Matrix.SpecialLinearGroup n A ≃* Matrix.SpecialLinearGroup n B where
  toFun := Matrix.SpecialLinearGroup.map e.toRingHom
  invFun := Matrix.SpecialLinearGroup.map e.symm.toRingHom
  left_inv a := by
    apply Matrix.SpecialLinearGroup.ext
    intro r s
    exact e.symm_apply_apply (a r s)
  right_inv a := by
    apply Matrix.SpecialLinearGroup.ext
    intro r s
    exact e.apply_symm_apply (a r s)
  map_mul' := (Matrix.SpecialLinearGroup.map e.toRingHom).map_mul

end Matrices

section Schemes

variable (R : CommRingCat.{u}) {i j : n}

/-- The root map on every test scheme sends the sole additive coordinate to a transvection. -/
def rootPoints (hij : i ≠ j) (T : Over (Spec R)) :
    (T ⟶ (VectorGroup.groupScheme R 1).X) →*
      (T ⟶ (SpecialLinear.groupScheme n R).X) where
  toFun x := (SpecialLinear.pointsEquiv n R T).symm
    (Matrix.SpecialLinearGroup.transvection hij ((VectorGroup.coordinates R 1 T x).toAdd 0))
  map_one' := by
    apply (SpecialLinear.pointsEquiv n R T).injective
    rw [MulEquiv.apply_symm_apply, (VectorGroup.coordinates R 1 T).map_one,
      (SpecialLinear.pointsEquiv n R T).map_one]
    exact Matrix.SpecialLinearGroup.transvection_coeff_zero hij
  map_mul' x y := by
    apply (SpecialLinear.pointsEquiv n R T).injective
    simp only [MulEquiv.apply_symm_apply, map_mul]
    exact Matrix.SpecialLinearGroup.transvection_add hij _ _

/-- The transvection formula is natural on all relative test schemes. -/
theorem rootPoints_naturality (hij : i ≠ j) {T T' : Over (Spec R)}
    (a : T' ⟶ T) (x : T ⟶ (VectorGroup.groupScheme R 1).X) :
    rootPoints R hij T' (a ≫ x) = a ≫ rootPoints R hij T x := by
  apply (SpecialLinear.pointsEquiv n R T').injective
  simp only [rootPoints, MonoidHom.coe_mk, OneHom.coe_mk, MulEquiv.apply_symm_apply]
  change Matrix.SpecialLinearGroup.transvection hij
      ((VectorGroup.coordinates R 1 T' (a ≫ x)).toAdd 0) = _
  rw [SpecialLinear.pointsEquiv_naturality, MulEquiv.apply_symm_apply,
    map_transvection, VectorGroup.coordinates_comp]

/-- The actual additive root homomorphism into the special linear group scheme. -/
def rootMap (hij : i ≠ j) :
    VectorGroup.groupScheme R 1 ⟶ SpecialLinear.groupScheme n R :=
  homOfPoints (rootPoints R hij) (rootPoints_naturality R hij)

/-- On every test scheme, the actual root homomorphism has the prescribed matrix formula. -/
theorem pointsEquiv_rootMap (hij : i ≠ j) (T : Over (Spec R))
    (x : T ⟶ (VectorGroup.groupScheme R 1).X) :
    SpecialLinear.pointsEquiv n R T (x ≫ (rootMap R hij).hom.hom) =
      Matrix.SpecialLinearGroup.transvection hij ((VectorGroup.coordinates R 1 T x).toAdd 0) := by
  rw [rootMap, comp_homOfPoints]
  exact (SpecialLinear.pointsEquiv n R T).apply_symm_apply _

end Schemes

section RationalPoints

variable (k : Type u) [CommRing k]

/-- Actual rational points are determinant-one matrices over the base ring itself. -/
def rationalMatrixEquiv :
    rationalPoints (SpecialLinear.groupScheme n (CommRingCat.of k)) ≃*
      Matrix.SpecialLinearGroup n k :=
  (SpecialLinear.pointsEquiv n (CommRingCat.of k)
    (Over.mk (𝟙 (Spec (CommRingCat.of k))))).trans
      (matrixRingEquiv (Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv)

/-- Each root-map image is the corresponding scalar transvection on rational points. -/
theorem rationalMatrixEquiv_rootMap {i j : n} (hij : i ≠ j)
    (x : rationalPoints (VectorGroup.groupScheme (CommRingCat.of k) 1)) :
    rationalMatrixEquiv (n := n) k (rationalPoints.map (rootMap (CommRingCat.of k) hij) x) =
      Matrix.SpecialLinearGroup.transvection hij
        ((Scheme.ΓSpecIso (CommRingCat.of k)).hom
          ((VectorGroup.coordinates (CommRingCat.of k) 1 _ x).toAdd 0)) := by
  change Matrix.SpecialLinearGroup.map _
    (SpecialLinear.pointsEquiv n (CommRingCat.of k) _
      (x ≫ (rootMap (CommRingCat.of k) hij).hom.hom)) = _
  rw [pointsEquiv_rootMap, map_transvection]
  rfl

/-- Every scalar transvection comes from a rational point of the actual additive root group. -/
theorem exists_rational_rootPoint {i j : n} (hij : i ≠ j) (a : k) :
    ∃ x : rationalPoints (VectorGroup.groupScheme (CommRingCat.of k) 1),
      rationalMatrixEquiv (n := n) k (rationalPoints.map (rootMap (CommRingCat.of k) hij) x) =
        Matrix.SpecialLinearGroup.transvection hij a := by
  refine ⟨(VectorGroup.coordinates (CommRingCat.of k) 1 _).symm
    (Multiplicative.ofAdd fun _ => (Scheme.ΓSpecIso (CommRingCat.of k)).inv a), ?_⟩
  rw [rationalMatrixEquiv_rootMap, MulEquiv.apply_symm_apply]
  congr 1
  exact Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of k)) a

end RationalPoints

section RationalGeneration

variable (k : Type u) [Field k]

/-- Actual additive root images generate all rational points of split SL_n over every field. -/
theorem eq_top_of_root_images
    (N : Subgroup (rationalPoints (SpecialLinear.groupScheme n (CommRingCat.of k))))
    (hroot : ∀ (i j : n) (hij : i ≠ j),
      (rationalPoints.map (rootMap (CommRingCat.of k) hij)).range ≤ N) : N = ⊤ := by
  have htop : N.comap (rationalMatrixEquiv (n := n) k).symm.toMonoidHom = ⊤ := by
    apply eq_top_of_transvections
    intro i j hij a
    obtain ⟨y, hy⟩ := exists_rational_rootPoint k hij a
    change (rationalMatrixEquiv (n := n) k).symm _ ∈ N
    rw [← hy, MulEquiv.symm_apply_apply]
    exact hroot i j hij ⟨y, rfl⟩
  apply top_unique
  intro x _
  have hx : rationalMatrixEquiv (n := n) k x ∈
      N.comap (rationalMatrixEquiv (n := n) k).symm.toMonoidHom := by
    rw [htop]
    trivial
  change (rationalMatrixEquiv (n := n) k).symm
    (rationalMatrixEquiv (n := n) k x) ∈ N at hx
  simpa only [MulEquiv.symm_apply_apply] using hx

/-- The supremum of the actual rational root-map ranges is the whole split SL_n point group. -/
theorem iSup_root_ranges_eq_top :
    (⨆ (i : n), ⨆ (j : n), ⨆ (hij : i ≠ j),
      (rationalPoints.map (rootMap (CommRingCat.of k) hij)).range) = ⊤ :=
  eq_top_of_root_images k _ fun i j hij =>
    le_iSup_of_le i (le_iSup_of_le j (le_iSup_of_le hij le_rfl))

end RationalGeneration

end Langlands.GroupScheme.SpecialLinear.Root
