import Langlands.GroupScheme.SplitExistence.RootPerm

/-! # The decomposition `B = U'_i T U_i` for a simple root `i`

`U'_i` is generated by the root groups of the positive roots other than `i`. It is normalized by
`U_i` (commutator relations), by the torus and by the Weyl element `n_i`, and
`U⁺ = U'_i U_i`. Hence every element of `B` is `u' t x_i(a)`. -/

noncomputable section

universe u

open Matrix

open scoped Pointwise

namespace Langlands.GroupScheme.SplitExistence

namespace ChevalleyData

variable {J X Y : Type u} [AddCommGroup X] [AddCommGroup Y] {P : RootDatum J X Y} {b : P.Base}
  (D : ChevalleyData P b) {K : Type u} [Field K]

/-- The positive roots other than `i`. -/
def posMinus (i : J) : Set J := {j | b.IsPos j ∧ j ≠ i}

variable (K) in
/-- `U'_i`: generated by the root groups of the positive roots other than `i`. -/
def posMinusSub (i : J) : Subgroup (GL (Fin D.n) K) := D.rootsSub K (posMinus (b := b) i)

theorem coe_list_prod_x (L : List (J × K)) :
    (((L.map fun x => D.x x.1 x.2).prod : GL (Fin D.n) K) : Matrix (Fin D.n) (Fin D.n) K) =
      (L.map fun x => divExp (D.e x.1) x.2).prod := by
  induction L with
  | nil => simp
  | cons x L ih => simp [ih, coe_x]

/-- Conjugating a positive root group other than `U_i` by `x_i(s)` lands in `U'_i`. -/
theorem x_conj_mem_posMinusSub {i j : J} (hi : b.IsPos i) (hj : j ∈ posMinus (b := b) i) (s t : K) :
    D.x i s * D.x j t * (D.x i s)⁻¹ ∈ D.posMinusSub K i := by
  have hℓi := (D.isPos_iff_ℓ_pos i).1 hi
  have hℓj := (D.isPos_iff_ℓ_pos j).1 hj.1
  obtain ⟨L, hL, hcomm⟩ := D.commutator i j D.ℓ hℓi hℓj K s t
  have hC : D.x i s * D.x j t * D.x i (-s) * D.x j (-t) = (L.map fun x => D.x x.1 x.2).prod := by
    apply Units.ext
    rw [coe_list_prod_x]
    simp only [Units.val_mul, coe_x]
    exact hcomm
  have hCmem : (L.map fun x => D.x x.1 x.2).prod ∈ D.posMinusSub K i := by
    refine (D.posMinusSub K i).list_prod_mem fun g hg => ?_
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hg
    obtain ⟨a, c, ha, hc, hk⟩ := hL x hx
    have hℓk : D.ℓ (P.root x.1) = (a : ℤ) * D.ℓ (P.root i) + (c : ℤ) * D.ℓ (P.root j) := by
      rw [hk, map_add, map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul]
    have hpos : 0 < D.ℓ (P.root x.1) := by
      rw [hℓk]
      have h1 : (0 : ℤ) < (a : ℤ) * D.ℓ (P.root i) := mul_pos (by exact_mod_cast ha) hℓi
      have h2 : (0 : ℤ) < (c : ℤ) * D.ℓ (P.root j) := mul_pos (by exact_mod_cast hc) hℓj
      linarith
    have hki : x.1 ≠ i := by
      intro hki
      rw [hki] at hℓk
      have h1 : (1 : ℤ) ≤ a := by exact_mod_cast ha
      have h2 : (0 : ℤ) < (c : ℤ) * D.ℓ (P.root j) := mul_pos (by exact_mod_cast hc) hℓj
      nlinarith
    exact rootSub_le_rootsSub (show x.1 ∈ posMinus (b := b) i from
      ⟨(D.isPos_iff_ℓ_pos _).2 hpos, hki⟩) (x_mem_rootSub _ _)
  have hxj : D.x j t ∈ D.posMinusSub K i := rootSub_le_rootsSub hj (x_mem_rootSub _ _)
  have : D.x i s * D.x j t * (D.x i s)⁻¹ = (L.map fun x => D.x x.1 x.2).prod * D.x j t := by
    rw [← hC, x_neg, x_neg]
    group
  rw [this]
  exact (D.posMinusSub K i).mul_mem hCmem hxj

theorem rootSub_le_normalizer_posMinusSub {i : J} (hi : b.IsPos i) :
    D.rootSub K i ≤ Subgroup.normalizer (D.posMinusSub K i : Set (GL (Fin D.n) K)) := by
  intro g hg
  obtain ⟨s, rfl⟩ := mem_rootSub.1 hg
  refine mem_normalizer_closure (fun v hv => ?_) (fun v hv => ?_)
  · obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
    obtain ⟨t, rfl⟩ := mem_rootSub.1 hv
    exact D.x_conj_mem_posMinusSub hi hj s t
  · obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
    obtain ⟨t, rfl⟩ := mem_rootSub.1 hv
    have h := D.x_conj_mem_posMinusSub hi hj (-s) t
    rw [x_neg, inv_inv] at h
    exact h

theorem posSub_eq_sup {i : J} (hi : b.IsPos i) :
    D.posSub K = D.posMinusSub K i ⊔ D.rootSub K i := by
  apply le_antisymm
  · rw [posSub, rootsSub, Subgroup.closure_le]
    intro g hg
    obtain ⟨j, hj, hg⟩ := Set.mem_iUnion₂.1 hg
    by_cases hji : j = i
    · subst hji
      exact Subgroup.mem_sup_right hg
    · exact Subgroup.mem_sup_left (rootSub_le_rootsSub (show j ∈ posMinus (b := b) i from ⟨hj, hji⟩) hg)
  · exact sup_le (rootsSub_mono fun j hj => hj.1) (rootSub_le_rootsSub hi)

/-- Every element of `U⁺` is `u' x_i(a)` with `u' ∈ U'_i`. -/
theorem exists_posMinus_mul_x {i : J} (hi : b.IsPos i) {u : GL (Fin D.n) K}
    (hu : u ∈ D.posSub K) : ∃ u' ∈ D.posMinusSub K i, ∃ a : K, u = u' * D.x i a := by
  rw [D.posSub_eq_sup hi, ← SetLike.mem_coe,
    Subgroup.coe_mul_of_right_le_normalizer_left _ _ (D.rootSub_le_normalizer_posMinusSub hi),
    Set.mem_mul] at hu
  obtain ⟨u', hu', v, hv, rfl⟩ := hu
  obtain ⟨a, rfl⟩ := mem_rootSub.1 hv
  exact ⟨u', hu', a, rfl⟩

/-- Every element of `B` is `u' t x_i(a)` with `u' ∈ U'_i` and `t ∈ T`. -/
theorem exists_borel_decomp {i : J} (hi : b.IsPos i) {g : GL (Fin D.n) K}
    (hg : g ∈ D.borelSub K) :
    ∃ u' ∈ D.posMinusSub K i, ∃ t ∈ D.torusSub K, ∃ a : K, g = u' * t * D.x i a := by
  obtain ⟨t, ht, u, hu, rfl⟩ := mem_borelSub.1 hg
  obtain ⟨u', hu', a, rfl⟩ := D.exists_posMinus_mul_x hi hu
  refine ⟨t * u' * t⁻¹, ?_, t, ht, a, by group⟩
  exact (Subgroup.mem_normalizer_iff.1 (D.torusSub_le_normalizer _ ht) u').1 hu'

end ChevalleyData

end Langlands.GroupScheme.SplitExistence
