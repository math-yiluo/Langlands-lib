import Langlands.GroupScheme.SplitExistence.Weyl

/-! # Subgroups of the Chevalley group over a field

The torus `T`, the root groups `U_j`, the positive unipotent group `U⁺`, the Borel subgroup
`B = T U⁺`, the subgroup `N` generated by `T` and the Weyl elements, and the whole group `Γ`
generated by `T` and all root groups, as subgroups of `GL_n(K)`. -/

noncomputable section

open scoped Pointwise

universe u

open Matrix

namespace Langlands.GroupScheme.SplitExistence

section GroupLemmas

variable {G : Type*} [Group G]

/-- Conjugation by `g` maps `closure S` into `H` once it maps `S` into `H`. -/
theorem conj_mem_of_mem_closure {S : Set G} {H : Subgroup G} {g : G}
    (hS : ∀ s ∈ S, g * s * g⁻¹ ∈ H) {h : G} (hh : h ∈ Subgroup.closure S) :
    g * h * g⁻¹ ∈ H := by
  induction hh using Subgroup.closure_induction with
  | mem s hs => exact hS s hs
  | one => simp [H.one_mem]
  | mul a c _ _ ha hc =>
    have : g * (a * c) * g⁻¹ = (g * a * g⁻¹) * (g * c * g⁻¹) := by group
    rw [this]
    exact H.mul_mem ha hc
  | inv a _ ha =>
    have : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [this]
    exact H.inv_mem ha

/-- `g` normalizes `closure S` once conjugation by `g` and by `g⁻¹` maps `S` into it. -/
theorem mem_normalizer_closure {S : Set G} {g : G}
    (h₁ : ∀ s ∈ S, g * s * g⁻¹ ∈ Subgroup.closure S)
    (h₂ : ∀ s ∈ S, g⁻¹ * s * g⁻¹⁻¹ ∈ Subgroup.closure S) :
    g ∈ Subgroup.normalizer (Subgroup.closure S : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  refine ⟨fun hh => conj_mem_of_mem_closure h₁ hh, fun hh => ?_⟩
  have := conj_mem_of_mem_closure h₂ hh
  simpa [mul_assoc] using this

end GroupLemmas

namespace ChevalleyData

variable {J X Y : Type u} [AddCommGroup X] [AddCommGroup Y] {P : RootDatum J X Y} {b : P.Base}
  (D : ChevalleyData P b)

section CommRing

variable (K : Type u) [CommRing K]

/-- The torus `T(K)`, the image of the torus homomorphism. -/
def torusSub : Subgroup (GL (Fin D.n) K) := (D.torusHom (K := K)).range

/-- The root group `U_j(K)`. -/
def rootSub (j : J) : Subgroup (GL (Fin D.n) K) := (D.rootHom (K := K) j).range

/-- The subgroup generated by the root groups of a set of roots. -/
def rootsSub (S : Set J) : Subgroup (GL (Fin D.n) K) :=
  Subgroup.closure (⋃ j ∈ S, (D.rootSub K j : Set (GL (Fin D.n) K)))

/-- The positive unipotent subgroup `U⁺(K)`, generated by the positive root groups. -/
def posSub : Subgroup (GL (Fin D.n) K) := D.rootsSub K {j | b.IsPos j}

/-- The Borel subgroup `B(K) = T(K) ⊔ U⁺(K)`. -/
def borelSub : Subgroup (GL (Fin D.n) K) := D.torusSub K ⊔ D.posSub K

/-- The group `Γ(K)` generated by the torus and all root groups. -/
def chevSub : Subgroup (GL (Fin D.n) K) := D.torusSub K ⊔ D.rootsSub K Set.univ

variable {D K}

theorem x_mem_rootSub (j : J) (s : K) : D.x j s ∈ D.rootSub K j :=
  ⟨Multiplicative.ofAdd s, rfl⟩

theorem mem_rootSub {j : J} {g : GL (Fin D.n) K} : g ∈ D.rootSub K j ↔ ∃ s : K, D.x j s = g :=
  ⟨fun ⟨s, hs⟩ => ⟨s.toAdd, hs⟩, fun ⟨s, hs⟩ => ⟨Multiplicative.ofAdd s, hs⟩⟩

theorem rootSub_le_rootsSub {S : Set J} {j : J} (hj : j ∈ S) : D.rootSub K j ≤ D.rootsSub K S :=
  fun _ hg => Subgroup.subset_closure (Set.mem_biUnion hj hg)

theorem rootsSub_mono {S S' : Set J} (h : S ⊆ S') : D.rootsSub K S ≤ D.rootsSub K S' :=
  Subgroup.closure_mono (Set.biUnion_subset_biUnion_left h)

theorem torusHom_mem_torusSub (χ : Multiplicative X →* Kˣ) :
    D.torusHom χ ∈ D.torusSub K :=
  ⟨χ, rfl⟩

/-- Conjugating the generators of `rootsSub S` by `g` lands in `rootsSub S'` once it maps each
root group of `S` into a root group of `S'`. -/
theorem conj_mem_rootsSub {S S' : Set J} {g : GL (Fin D.n) K}
    (h : ∀ j ∈ S, ∃ j' ∈ S', ∀ s : K, ∃ s' : K, g * D.x j s * g⁻¹ = D.x j' s')
    {u : GL (Fin D.n) K} (hu : u ∈ D.rootsSub K S) : g * u * g⁻¹ ∈ D.rootsSub K S' := by
  refine conj_mem_of_mem_closure (fun v hv => ?_) hu
  obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
  obtain ⟨s, rfl⟩ := mem_rootSub.1 hv
  obtain ⟨j', hj', hs⟩ := h j hj
  obtain ⟨s', hs'⟩ := hs s
  rw [hs']
  exact rootSub_le_rootsSub hj' (x_mem_rootSub j' s')

/-- The torus normalizes every `rootsSub S`. -/
theorem torusSub_le_normalizer (S : Set J) :
    D.torusSub K ≤ Subgroup.normalizer (D.rootsSub K S : Set (GL (Fin D.n) K)) := by
  rintro _ ⟨χ, rfl⟩
  refine mem_normalizer_closure (fun v hv => ?_) (fun v hv => ?_)
  · obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
    obtain ⟨s, rfl⟩ := mem_rootSub.1 hv
    rw [torusHom_conj_x]
    exact rootSub_le_rootsSub hj (x_mem_rootSub j _)
  · obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
    obtain ⟨s, rfl⟩ := mem_rootSub.1 hv
    have hinv : (D.torusHom χ)⁻¹ = D.torusHom χ⁻¹ := (map_inv D.torusHom χ).symm
    rw [hinv, torusHom_conj_x]
    exact rootSub_le_rootsSub hj (x_mem_rootSub j _)

/-- `B = T U⁺` as sets. -/
theorem coe_borelSub :
    (D.borelSub K : Set (GL (Fin D.n) K)) =
      (D.torusSub K : Set (GL (Fin D.n) K)) * (D.posSub K : Set (GL (Fin D.n) K)) :=
  Subgroup.coe_mul_of_left_le_normalizer_right _ _ (D.torusSub_le_normalizer _)

theorem mem_borelSub {g : GL (Fin D.n) K} :
    g ∈ D.borelSub K ↔ ∃ t ∈ D.torusSub K, ∃ u ∈ D.posSub K, t * u = g := by
  rw [← SetLike.mem_coe, coe_borelSub, Set.mem_mul]
  simp only [SetLike.mem_coe]

end CommRing

section Field

variable (K : Type u) [Field K]

/-- The subgroup `N(K)` generated by the torus and the Weyl elements of the simple roots. -/
def weylSub : Subgroup (GL (Fin D.n) K) :=
  Subgroup.closure ((D.torusSub K : Set (GL (Fin D.n) K)) ∪ Set.range fun i : b.support => D.wn i)

variable {D K}

theorem wn_mem_weylSub (i : b.support) : D.wn i ∈ D.weylSub K :=
  Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)

theorem torusSub_le_weylSub : D.torusSub K ≤ D.weylSub K :=
  fun _ hg => Subgroup.subset_closure (Or.inl hg)

end Field

end ChevalleyData

end Langlands.GroupScheme.SplitExistence
