import Langlands.GroupScheme.SplitExistence.OrderedProduct

/-! # Ordered products over a closed set of roots positive for a height

Let `h : X →+ ℤ` and let `Ψ` be a set of roots on which `h` is positive and which contains every
root `a i + c j` with `a, c ≥ 1` and `i, j ∈ Ψ`. Over any commutative ring, every element of the
subgroup generated by the root groups of `Ψ` is an ordered product `∏ x_γ(c_γ)` over the roots of
`Ψ` listed once each in order of increasing `h` (Steinberg, *Lectures on Chevalley groups*, §3,
Lemma 17, whose proof is the same for `Ψ`). -/

noncomputable section

universe u

open Matrix

namespace Langlands.GroupScheme.SplitExistence

variable {J X Y : Type u} [AddCommGroup X] [AddCommGroup Y]

/-- A set of roots on which `h` is positive and which contains every root `a i + c j` with
`a, c ≥ 1` and `i, j` in the set. -/
structure IsClosedPositive (P : RootDatum J X Y) (h : X →+ ℤ) (Ψ : Set J) : Prop where
  pos : ∀ j ∈ Ψ, 0 < h (P.root j)
  closed : ∀ i ∈ Ψ, ∀ j ∈ Ψ, ∀ k : J, ∀ a c : ℕ, 1 ≤ a → 1 ≤ c →
    P.root k = a • P.root i + c • P.root j → k ∈ Ψ

namespace ChevalleyData

variable {P : RootDatum J X Y} {b : P.Base} (D : ChevalleyData P b) {K : Type u} [CommRing K]

/-- The product `∏_{j ∈ l} x_j(c j)` along a list of roots, over a commutative ring. -/
def listProd (l : List J) (c : J → K) : GL (Fin D.n) K :=
  (l.map fun j => D.x j (c j)).prod

theorem listProd_nil (c : J → K) : D.listProd [] c = 1 := rfl

theorem listProd_cons (j : J) (l : List J) (c : J → K) :
    D.listProd (j :: l) c = D.x j (c j) * D.listProd l c := by
  simp [listProd]

theorem listProd_append (l l' : List J) (c : J → K) :
    D.listProd (l ++ l') c = D.listProd l c * D.listProd l' c := by
  simp [listProd]

theorem listProd_congr {l : List J} {c c' : J → K} (h : ∀ j ∈ l, c j = c' j) :
    D.listProd l c = D.listProd l c' := by
  unfold listProd
  rw [List.map_congr_left fun j hj => by rw [h j hj]]

theorem listProd_zero (l : List J) : D.listProd l (0 : J → K) = 1 := by
  induction l with
  | nil => rfl
  | cons j l ih => rw [listProd_cons, Pi.zero_apply, x_zero, one_mul, ih]

theorem listProd_mem_rootsSub {S : Set J} {l : List J} (hl : ∀ j ∈ l, j ∈ S) (c : J → K) :
    D.listProd l c ∈ D.rootsSub K S := by
  refine (D.rootsSub K S).list_prod_mem fun g hg => ?_
  obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hg
  exact rootSub_le_rootsSub (hl j hj) (x_mem_rootSub _ _)

theorem coe_list_prod_x_ring (L : List (J × K)) :
    (((L.map fun x => D.x x.1 x.2).prod : GL (Fin D.n) K) : Matrix (Fin D.n) (Fin D.n) K) =
      (L.map fun x => divExp (D.e x.1) x.2).prod := by
  induction L with
  | nil => simp
  | cons x L ih => simp [ih, coe_x]

/-- Over a commutative ring, the commutator of two root elements of roots on which `h` is
positive lies in `rootsSub S` once `S` contains every root `a i + c j` with `a, c ≥ 1`. -/
theorem commutator_mem_rootsSub_ring (h : X →+ ℤ) {i j : J} (hi : 0 < h (P.root i))
    (hj : 0 < h (P.root j)) {S : Set J}
    (hS : ∀ k : J, ∀ a c : ℕ, 1 ≤ a → 1 ≤ c → P.root k = a • P.root i + c • P.root j → k ∈ S)
    (s t : K) : D.x i s * D.x j t * D.x i (-s) * D.x j (-t) ∈ D.rootsSub K S := by
  obtain ⟨L, hL, hcomm⟩ := D.commutator i j h hi hj K s t
  have hC : D.x i s * D.x j t * D.x i (-s) * D.x j (-t) = (L.map fun x => D.x x.1 x.2).prod := by
    apply Units.ext
    rw [coe_list_prod_x_ring]
    simp only [Units.val_mul, coe_x]
    exact hcomm
  rw [hC]
  refine (D.rootsSub K S).list_prod_mem fun g hg => ?_
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hg
  obtain ⟨a, c, ha, hc, hk⟩ := hL x hx
  exact rootSub_le_rootsSub (hS _ _ _ ha hc hk) (x_mem_rootSub _ _)

variable {h : X →+ ℤ} {Ψ : Set J}

variable (P h Ψ) in
/-- The roots of `Ψ` of `h`-level at least `m`. -/
def heightGe (m : ℤ) : Set J := {j | j ∈ Ψ ∧ m ≤ h (P.root j)}

/-- For roots `i, j ∈ Ψ`, the commutator of `x_i(s)` and `x_j(t)` lies in the subgroup
generated by the root groups of the roots of `Ψ` of level at least `m`, if
`h(i) + h(j) ≥ m`. -/
theorem commutator_mem_heightGe (hΨ : IsClosedPositive P h Ψ) {i j : J} (hi : i ∈ Ψ)
    (hj : j ∈ Ψ) {m : ℤ} (hm : m ≤ h (P.root i) + h (P.root j)) (s t : K) :
    D.x i s * D.x j t * D.x i (-s) * D.x j (-t) ∈ D.rootsSub K (heightGe P h Ψ m) := by
  have hℓi := hΨ.pos i hi
  have hℓj := hΨ.pos j hj
  refine D.commutator_mem_rootsSub_ring h hℓi hℓj ?_ s t
  intro k a c ha hc hk
  have hℓk : h (P.root k) = (a : ℤ) * h (P.root i) + (c : ℤ) * h (P.root j) := by
    rw [hk, map_add, map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul]
  have h1 : h (P.root i) ≤ (a : ℤ) * h (P.root i) := by
    have : (1 : ℤ) ≤ a := by exact_mod_cast ha
    nlinarith
  have h2 : h (P.root j) ≤ (c : ℤ) * h (P.root j) := by
    have : (1 : ℤ) ≤ c := by exact_mod_cast hc
    nlinarith
  exact ⟨hΨ.closed i hi j hj k a c ha hc hk, by linarith⟩

/-- Conjugation by a root element of `Ψ` maps `U_{Ψ,≥m}` into itself. -/
theorem x_conj_mem_heightGe (hΨ : IsClosedPositive P h Ψ) {i : J} (hi : i ∈ Ψ) (m : ℤ) (s : K)
    {g : GL (Fin D.n) K} (hg : g ∈ D.rootsSub K (heightGe P h Ψ m)) :
    D.x i s * g * (D.x i s)⁻¹ ∈ D.rootsSub K (heightGe P h Ψ m) := by
  refine conj_mem_of_mem_closure (fun v hv => ?_) hg
  obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
  obtain ⟨t, rfl⟩ := mem_rootSub.1 hv
  by_cases hij : j = i
  · subst hij
    rw [← x_add, ← x_neg, ← x_add, add_neg_cancel_comm]
    exact rootSub_le_rootsSub hj (x_mem_rootSub _ _)
  · have hc := D.commutator_mem_heightGe hΨ hi hj.1 (m := m)
      (by have := hΨ.pos i hi; linarith [hj.2]) s t
    have : D.x i s * D.x j t * (D.x i s)⁻¹ =
        (D.x i s * D.x j t * D.x i (-s) * D.x j (-t)) * D.x j t := by
      rw [x_neg, x_neg]; group
    rw [this]
    exact (D.rootsSub K _).mul_mem hc (rootSub_le_rootsSub hj (x_mem_rootSub _ _))

/-- `U_Ψ` normalizes `U_{Ψ,≥m}`. -/
theorem rootsSub_le_normalizer_heightGe (hΨ : IsClosedPositive P h Ψ) (m : ℤ) :
    D.rootsSub K Ψ ≤
      Subgroup.normalizer (D.rootsSub K (heightGe P h Ψ m) : Set (GL (Fin D.n) K)) := by
  rw [rootsSub, Subgroup.closure_le]
  intro g hg
  obtain ⟨i, hi, hg⟩ := Set.mem_iUnion₂.1 hg
  obtain ⟨s, rfl⟩ := mem_rootSub.1 hg
  rw [SetLike.mem_coe, Subgroup.mem_normalizer_iff]
  intro w
  refine ⟨fun hw => D.x_conj_mem_heightGe hΨ hi m s hw, fun hw => ?_⟩
  have := D.x_conj_mem_heightGe hΨ hi m (-s) hw
  rw [x_neg, inv_inv] at this
  have e : (D.x i s)⁻¹ * (D.x i s * w * (D.x i s)⁻¹) * D.x i s = w := by group
  rwa [e] at this

theorem inv_conj_mem_heightGe (hΨ : IsClosedPositive P h Ψ) {g : GL (Fin D.n) K}
    (hg : g ∈ D.rootsSub K Ψ) (m : ℤ) {w : GL (Fin D.n) K}
    (hw : w ∈ D.rootsSub K (heightGe P h Ψ m)) :
    g⁻¹ * w * g ∈ D.rootsSub K (heightGe P h Ψ m) := by
  have e := (Subgroup.mem_normalizer_iff.1
    (Subgroup.inv_mem _ (D.rootsSub_le_normalizer_heightGe hΨ m hg)) w).1 hw
  rwa [inv_inv] at e

variable [DecidableEq J] in
/-- **Level step.** On a list of distinct roots of `Ψ` of level `m ≥ 1`, left multiplication by
`x_δ(s)` changes the coefficient of `δ` by `s`, up to a right factor in `U_{Ψ,≥m+1}`. -/
theorem level_step_heightGe (hΨ : IsClosedPositive P h Ψ) {m : ℤ} (hm : 1 ≤ m) :
    ∀ (l : List J), l.Nodup → (∀ j ∈ l, j ∈ Ψ ∧ h (P.root j) = m) →
    ∀ {δ : J}, δ ∈ l → ∀ (s : K) (c : J → K), ∃ w ∈ D.rootsSub K (heightGe P h Ψ (m + 1)),
      D.x δ s * D.listProd l c = D.listProd l (Function.update c δ (c δ + s)) * w
  | [], _, _, δ, hδ, _, _ => absurd hδ List.not_mem_nil
  | γ :: l, hnd, hl, δ, hδ, s, c => by
    rw [List.nodup_cons] at hnd
    by_cases hγδ : δ = γ
    · subst hγδ
      refine ⟨1, (D.rootsSub K _).one_mem, ?_⟩
      rw [listProd_cons, listProd_cons, mul_one, ← mul_assoc, ← x_add,
        Function.update_self, add_comm]
      congr 1
      exact D.listProd_congr fun j hj => by
        rw [Function.update_of_ne (by rintro rfl; exact hnd.1 hj)]
    · have hδl : δ ∈ l := (List.mem_cons.1 hδ).resolve_left hγδ
      obtain ⟨w₂, hw₂, h₂⟩ := level_step_heightGe hΨ hm l hnd.2
        (fun j hj => hl j (List.mem_cons_of_mem _ hj)) hδl s c
      have hγ := hl γ (List.mem_cons_self ..)
      have hδ' := hl δ (List.mem_cons_of_mem _ hδl)
      have hw₁ := D.commutator_mem_heightGe hΨ hγ.1 hδ'.1 (m := m + 1)
        (by rw [hγ.2, hδ'.2]; linarith) (-c γ) s
      set w₁ := D.x γ (-c γ) * D.x δ s * D.x γ (- -c γ) * D.x δ (-s) with hw₁def
      set c' := Function.update c δ (c δ + s) with hc'
      have hPmem : D.listProd l c' ∈ D.rootsSub K Ψ :=
        D.listProd_mem_rootsSub (fun j hj => (hl j (List.mem_cons_of_mem _ hj)).1) c'
      refine ⟨(D.listProd l c')⁻¹ * w₁ * D.listProd l c' * w₂,
        (D.rootsSub K _).mul_mem (D.inv_conj_mem_heightGe hΨ hPmem _ hw₁) hw₂, ?_⟩
      have hcγ : c' γ = c γ := Function.update_of_ne (Ne.symm hγδ) _ _
      rw [listProd_cons, listProd_cons, hcγ]
      calc D.x δ s * (D.x γ (c γ) * D.listProd l c)
          = D.x γ (c γ) * w₁ * (D.x δ s * D.listProd l c) := by
            rw [hw₁def, neg_neg, x_neg, x_neg]; group
        _ = D.x γ (c γ) * w₁ * (D.listProd l c' * w₂) := by rw [h₂]
        _ = D.x γ (c γ) * D.listProd l c' *
            ((D.listProd l c')⁻¹ * w₁ * D.listProd l c' * w₂) := by group

section HeightList

variable [Fintype J]

variable (P h Ψ) in
open Classical in
/-- The roots of `Ψ`, sorted by increasing `h`. -/
def heightList : List J :=
  ((Finset.univ.filter fun j => j ∈ Ψ).toList).mergeSort
    fun a c => decide (h (P.root a) ≤ h (P.root c))

open Classical in
theorem mem_heightList {j : J} : j ∈ heightList P h Ψ ↔ j ∈ Ψ := by
  rw [heightList, (List.mergeSort_perm _ _).mem_iff, Finset.mem_toList, Finset.mem_filter]
  simp

open Classical in
theorem heightList_nodup : (heightList P h Ψ).Nodup :=
  (List.mergeSort_perm _ _).nodup_iff.2 (Finset.nodup_toList _)

open Classical in
theorem heightList_sorted :
    (heightList P h Ψ).Pairwise fun a c => h (P.root a) ≤ h (P.root c) := by
  have e := List.pairwise_mergeSort (le := fun a c => decide (h (P.root a) ≤ h (P.root c)))
    (fun a b c hab hbc => by simp only [decide_eq_true_eq] at *; exact hab.trans hbc)
    (fun a c => by simpa using le_total _ _) ((Finset.univ.filter fun j => j ∈ Ψ).toList)
  exact e.imp fun h' => by simpa using h'

variable (h Ψ) in
/-- The filtered ordered product over the roots of `Ψ` of level at least `m`. -/
def heightOpGe (m : ℤ) (c : J → K) : GL (Fin D.n) K :=
  D.listProd ((heightList P h Ψ).filter fun j => decide (m ≤ h (P.root j))) c

theorem heightOpGe_eq (m : ℤ) (c : J → K) :
    D.heightOpGe h Ψ m c =
      D.listProd ((heightList P h Ψ).filter fun j => decide (h (P.root j) = m)) c *
        D.heightOpGe h Ψ (m + 1) c := by
  rw [heightOpGe, heightOpGe,
    List.filter_ge_eq_append (fun j => h (P.root j)) m _ heightList_sorted, listProd_append]

theorem heightOpGe_mem (m : ℤ) (c : J → K) :
    D.heightOpGe h Ψ m c ∈ D.rootsSub K (heightGe P h Ψ m) := by
  refine D.listProd_mem_rootsSub (fun j hj => ?_) c
  rw [List.mem_filter, decide_eq_true_eq] at hj
  exact ⟨mem_heightList.1 hj.1, hj.2⟩

variable [DecidableEq J]

/-- One descending step: if `U_{Ψ,≥m+1}` consists of ordered products, so does `U_{Ψ,≥m}`. -/
theorem heightOpGe_step (hΨ : IsClosedPositive P h Ψ) {m : ℤ} (hm : 1 ≤ m)
    (ih : ∀ u ∈ D.rootsSub K (heightGe P h Ψ (m + 1)), ∃ c : J → K,
      u = D.heightOpGe h Ψ (m + 1) c) :
    ∀ u ∈ D.rootsSub K (heightGe P h Ψ m), ∃ c : J → K, u = D.heightOpGe h Ψ m c := by
  set L₁ := (heightList P h Ψ).filter fun j => decide (h (P.root j) = m) with hL₁
  have hL₁nd : L₁.Nodup := heightList_nodup.filter _
  have hL₁mem : ∀ j ∈ L₁, j ∈ Ψ ∧ h (P.root j) = m := by
    intro j hj
    rw [hL₁, List.mem_filter, decide_eq_true_eq] at hj
    exact ⟨mem_heightList.1 hj.1, hj.2⟩
  have glue : ∀ c' c'' : J → K, ∃ c₃ : J → K,
      D.listProd L₁ c₃ = D.listProd L₁ c' ∧
        D.heightOpGe h Ψ (m + 1) c₃ = D.heightOpGe h Ψ (m + 1) c'' := by
    intro c' c''
    refine ⟨fun j => if h (P.root j) = m then c' j else c'' j, ?_, ?_⟩
    · exact D.listProd_congr fun j hj => by
        rw [ite_eq_left_iff.2 fun h' => absurd (hL₁mem j hj).2 h']
    · refine D.listProd_congr fun j hj => ?_
      rw [List.mem_filter, decide_eq_true_eq] at hj
      exact ite_eq_right (by omega)
  have step : ∀ δ ∈ heightGe P h Ψ m, ∀ (s : K) (c : J → K), ∃ c₃ : J → K,
      D.x δ s * D.heightOpGe h Ψ m c = D.heightOpGe h Ψ m c₃ := by
    intro δ hδ s c
    rw [D.heightOpGe_eq m c, ← hL₁]
    rcases eq_or_lt_of_le hδ.2 with hlev | hlev
    · have hδL : δ ∈ L₁ := by
        rw [hL₁, List.mem_filter, decide_eq_true_eq]
        exact ⟨mem_heightList.2 hδ.1, hlev.symm⟩
      obtain ⟨w, hw, hstep⟩ := D.level_step_heightGe hΨ hm L₁ hL₁nd hL₁mem hδL s c
      obtain ⟨c'', hc''⟩ := ih (w * D.heightOpGe h Ψ (m + 1) c)
        ((D.rootsSub K _).mul_mem hw (D.heightOpGe_mem _ _))
      obtain ⟨c₃, h1, h2⟩ := glue (Function.update c δ (c δ + s)) c''
      refine ⟨c₃, ?_⟩
      rw [D.heightOpGe_eq m c₃, ← hL₁, h1, h2, ← hc'', ← mul_assoc, hstep, mul_assoc]
    · have hmem : D.x δ s ∈ D.rootsSub K (heightGe P h Ψ (m + 1)) :=
        rootSub_le_rootsSub (show δ ∈ heightGe P h Ψ (m + 1) from ⟨hδ.1, by omega⟩)
          (x_mem_rootSub _ _)
      have hP₁ : D.listProd L₁ c ∈ D.rootsSub K Ψ :=
        D.listProd_mem_rootsSub (fun j hj => (hL₁mem j hj).1) c
      obtain ⟨c'', hc''⟩ := ih ((D.listProd L₁ c)⁻¹ * D.x δ s * D.listProd L₁ c *
        D.heightOpGe h Ψ (m + 1) c) ((D.rootsSub K _).mul_mem
          (D.inv_conj_mem_heightGe hΨ hP₁ _ hmem) (D.heightOpGe_mem _ _))
      obtain ⟨c₃, h1, h2⟩ := glue c c''
      refine ⟨c₃, ?_⟩
      rw [D.heightOpGe_eq m c₃, ← hL₁, h1, h2, ← hc'']
      group
  intro u hu
  induction hu using Subgroup.closure_induction_left with
  | one => exact ⟨0, by rw [heightOpGe, listProd_zero]⟩
  | mul_left x hx y _ hy =>
    obtain ⟨δ, hδ, hx⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨s, rfl⟩ := mem_rootSub.1 hx
    obtain ⟨c, rfl⟩ := hy
    exact step δ hδ s c
  | inv_mul_cancel x hx y _ hy =>
    obtain ⟨δ, hδ, hx⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨s, rfl⟩ := mem_rootSub.1 hx
    obtain ⟨c, rfl⟩ := hy
    rw [← x_neg]
    exact step δ hδ (-s) c

/-- **`U_Ψ` is the ordered product of the root groups of `Ψ`**: every element of the subgroup
generated by the root groups of a closed set `Ψ` of `h`-positive roots is
`∏_{γ ∈ heightList P h Ψ} x_γ(c γ)`. -/
theorem exists_listProd_of_mem_rootsSub (hΨ : IsClosedPositive P h Ψ) {u : GL (Fin D.n) K}
    (hu : u ∈ D.rootsSub K Ψ) : ∃ c : J → K, u = D.listProd (heightList P h Ψ) c := by
  set M : ℕ := Finset.univ.sup fun j => (h (P.root j)).toNat with hM
  have hbound : ∀ j, h (P.root j) ≤ M := fun j => by
    have h1 : (h (P.root j)).toNat ≤ M :=
      Finset.le_sup (f := fun j => (h (P.root j)).toNat) (Finset.mem_univ j)
    have h2 := Int.self_le_toNat (h (P.root j))
    omega
  have key : ∀ t : ℕ, t ≤ M → ∀ v ∈ D.rootsSub K (heightGe P h Ψ ((M : ℤ) + 1 - t)),
      ∃ c : J → K, v = D.heightOpGe h Ψ ((M : ℤ) + 1 - t) c := by
    intro t
    induction t with
    | zero =>
      intro _ v hv
      have hempty : heightGe P h Ψ ((M : ℤ) + 1 - (0 : ℕ)) = ∅ := by
        ext j
        simp only [heightGe, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_and]
        intro _ h'
        have := hbound j
        push_cast at h'
        omega
      rw [rootsSub, hempty] at hv
      simp only [Set.mem_empty_iff_false, Set.iUnion_of_empty, Set.iUnion_empty,
        Subgroup.closure_empty, Subgroup.mem_bot] at hv
      exact ⟨0, by rw [hv, heightOpGe, listProd_zero]⟩
    | succ t ih =>
      intro ht
      have hm : (1 : ℤ) ≤ (M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) := by push_cast; omega
      have ih' : ∀ v ∈ D.rootsSub K (heightGe P h Ψ ((M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) + 1)),
          ∃ c : J → K, v = D.heightOpGe h Ψ ((M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) + 1) c := by
        have e : (M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) + 1 = (M : ℤ) + 1 - (t : ℤ) := by
          push_cast; ring
        rw [e]
        exact ih (by omega)
      exact D.heightOpGe_step hΨ hm ih'
  have e1 : (M : ℤ) + 1 - (M : ℕ) = 1 := by ring
  have hpos : heightGe P h Ψ 1 = Ψ := by
    ext j
    simp only [heightGe, Set.mem_ofPred_eq]
    exact ⟨fun h' => h'.1, fun h' => ⟨h', hΨ.pos j h'⟩⟩
  obtain ⟨c, hc⟩ := key M le_rfl u (by rw [e1, hpos]; exact hu)
  refine ⟨c, hc.trans ?_⟩
  rw [e1, heightOpGe]
  congr 1
  rw [List.filter_eq_self]
  intro j hj
  have := hΨ.pos j (mem_heightList.1 hj)
  simp only [decide_eq_true_eq]
  omega

end HeightList

end ChevalleyData

end Langlands.GroupScheme.SplitExistence
