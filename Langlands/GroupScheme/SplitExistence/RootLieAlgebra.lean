import Langlands.GroupScheme.SplitExistence.WeightGrading
import Mathlib.Algebra.Algebra.Bilinear
import Mathlib.Algebra.Module.LinearMap.Rat
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Span.Basic

/-!
# The rational Lie algebra generated by simple root operators

Fix weights `wt : ι → X` of a basis of `ℚ^ι`, and families `e i`, `f i` (`i : κ`) of rational
square matrices of weights `α i` and `-α i`, where the `α i` have unique integral coefficients,
such that `[e i, f j]` is `0` for `i ≠ j` and the diagonal matrix of an additive character
`χ i` of the weights for `i = j` (`LieGens`).

The span `lieSpan` of the iterated commutators of the `e i`, of the iterated commutators of the
`f i`, and of the diagonal matrices `h i` is closed under the commutator (`matAd_mem`). Its
nonzero weight components have weights that are nonnegative or nonpositive combinations of the
`α i` (`exists_coeff_of_isWtHom`); its component of weight `α i` is the line `ℚ • e i`
(`exists_eq_smul_e_of_isWtHom`); and it has no nonzero component of weight `k • α i` for an
integer `k ∉ {-1, 0, 1}` (`eq_one_or_eq_neg_one_of_isWtHom`).
-/

noncomputable section

open Matrix Submodule Set

namespace Langlands.GroupScheme.SplitExistence

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

section MatAd

/-- The commutator `[a, y] = a * y - y * a` of rational square matrices, as a bilinear map. -/
def matAd : Matrix ι ι ℚ →ₗ[ℚ] Matrix ι ι ℚ →ₗ[ℚ] Matrix ι ι ℚ :=
  LinearMap.mul ℚ (Matrix ι ι ℚ) - (LinearMap.mul ℚ (Matrix ι ι ℚ)).flip

theorem matAd_apply (a y : Matrix ι ι ℚ) : matAd a y = a * y - y * a := by
  simp [matAd]

/-- The Jacobi identity for the matrix commutator. -/
theorem matAd_matAd (a x y : Matrix ι ι ℚ) :
    matAd (matAd a x) y = matAd a (matAd x y) - matAd x (matAd a y) := by
  simp only [matAd_apply, mul_sub, sub_mul, mul_assoc]
  abel

theorem matAd_self (a : Matrix ι ι ℚ) : matAd a a = 0 := by
  simp [matAd_apply]

theorem matAd_swap (a y : Matrix ι ι ℚ) : matAd y a = -matAd a y := by
  simp [matAd_apply]

/-- If `matAd a` maps a generating set into `V`, it maps its span into `V`. -/
theorem matAd_mem_of_mem_span {a : Matrix ι ι ℚ} {G : Set (Matrix ι ι ℚ)}
    {V : Submodule ℚ (Matrix ι ι ℚ)} (h : ∀ y ∈ G, matAd a y ∈ V) {y : Matrix ι ι ℚ}
    (hy : y ∈ span ℚ G) : matAd a y ∈ V :=
  (span_le.2 (fun z hz => mem_comap.2 (h z hz)) : span ℚ G ≤ V.comap (matAd a)) hy

/-- If `matAd · y` maps a generating set into `V`, it maps its span into `V`. -/
theorem matAd_mem_of_mem_span_left {y : Matrix ι ι ℚ} {G : Set (Matrix ι ι ℚ)}
    {V : Submodule ℚ (Matrix ι ι ℚ)} (h : ∀ a ∈ G, matAd a y ∈ V) {a : Matrix ι ι ℚ}
    (ha : a ∈ span ℚ G) : matAd a y ∈ V :=
  (span_le.2 (fun z hz => mem_comap.2 (by rw [LinearMap.flip_apply]; exact h z hz)) :
    span ℚ G ≤ V.comap (matAd.flip y)) ha

end MatAd

variable {X : Type*} [AddCommGroup X] (wt : ι → X)

section CharDiag

/-- The diagonal matrix of an additive character `χ` of the weights. -/
def charDiag (χ : X →+ ℚ) : Matrix ι ι ℚ :=
  diagonal fun c => χ (wt c)

omit [Fintype ι] in
theorem isWtHom_charDiag (χ : X →+ ℚ) : IsWtHom wt 0 (charDiag wt χ) := by
  intro c d h
  by_cases hcd : c = d
  · rw [hcd, add_zero]
  · exact absurd (diagonal_apply_ne _ hcd) h

variable {wt} in
theorem matAd_charDiag {μ : X} {A : Matrix ι ι ℚ} (hA : IsWtHom wt μ A) (χ : X →+ ℚ) :
    matAd (charDiag wt χ) A = χ μ • A := by
  rw [matAd_apply]
  exact hA.diagonal_commutator χ

theorem matAd_charDiag_charDiag (χ χ' : X →+ ℚ) :
    matAd (charDiag wt χ) (charDiag wt χ') = 0 := by
  simp [matAd_apply, charDiag, mul_comm]

end CharDiag

section IterComm

variable {κ : Type*}

/-- Iterated commutators `[g i₁, [g i₂, …, [g i_{m-1}, g i_m] …]]` of a family `g` of matrices,
together with the weight `α i₁ + ⋯ + α i_m`. -/
inductive IterComm (g : κ → Matrix ι ι ℚ) (α : κ → X) : X → Matrix ι ι ℚ → Prop
  | base (i : κ) : IterComm g α (α i) (g i)
  | step {μ : X} {A : Matrix ι ι ℚ} (i : κ) :
      IterComm g α μ A → IterComm g α (μ + α i) (matAd (g i) A)

variable {wt} {g : κ → Matrix ι ι ℚ} {α : κ → X}

theorem IterComm.isWtHom (hg : ∀ i, IsWtHom wt (α i) (g i)) {μ : X} {A : Matrix ι ι ℚ}
    (h : IterComm g α μ A) : IsWtHom wt μ A := by
  induction h with
  | base i => exact hg i
  | step i _ ih =>
    rw [matAd_apply, add_comm]
    exact (hg i).commutator ih

theorem IterComm.exists_coeff [Fintype κ] [DecidableEq κ] {μ : X} {A : Matrix ι ι ℚ}
    (h : IterComm g α μ A) : ∃ c : κ → ℕ, c ≠ 0 ∧ μ = ∑ i, c i • α i := by
  induction h with
  | base i =>
    refine ⟨Pi.single i 1, fun h => absurd (congrFun h i) (by simp), ?_⟩
    simp [Pi.single_apply, ite_smul]
  | step i _ ih =>
    obtain ⟨c, -, rfl⟩ := ih
    refine ⟨c + Pi.single i 1, fun h => absurd (congrFun h i) (by simp), ?_⟩
    simp [add_smul, Finset.sum_add_distrib, Pi.single_apply, ite_smul]

/-- An iterated commutator whose weight is a multiple `k • α i` is either `g i` (and `k = 1`)
or zero, when the `α i` have unique integral coefficients. -/
theorem IterComm.eq_of_eq_smul [Fintype κ] [DecidableEq κ]
    (hα : ∀ c d : κ → ℤ, ∑ i, c i • α i = ∑ i, d i • α i → c = d) {μ : X}
    {A : Matrix ι ι ℚ} (h : IterComm g α μ A) (i : κ) (k : ℤ) (hμ : μ = k • α i) :
    (A = g i ∧ k = 1) ∨ A = 0 := by
  induction h generalizing k with
  | base j =>
    have hc := hα (Pi.single j 1) (Pi.single i k) (by
      simp only [Pi.single_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq',
        Finset.mem_univ, ite_true]
      exact hμ)
    by_cases hji : j = i
    · subst hji
      refine Or.inl ⟨rfl, ?_⟩
      have := congrFun hc j
      simp only [Pi.single_eq_same] at this
      exact this.symm
    · exfalso
      have := congrFun hc j
      simp [hji] at this
  | @step ν B j hB ih =>
    right
    obtain ⟨c, -, hcν⟩ := hB.exists_coeff
    have hc := hα (fun t => (c t : ℤ) + if t = j then 1 else 0) (Pi.single i k) (by
      simp only [add_smul, Finset.sum_add_distrib, ite_smul, one_smul, zero_smul,
        Finset.sum_ite_eq', Finset.mem_univ, ite_true, natCast_zsmul, Pi.single_apply, ← hcν]
      exact hμ)
    have hji : j = i := by
      by_contra hji
      have := congrFun hc j
      simp only [ite_true, Pi.single_apply, hji, ite_false] at this
      omega
    subst hji
    have hν : ν = (k - 1) • α j := by
      have hcj := congrFun hc j
      simp only [ite_true, Pi.single_eq_same] at hcj
      rw [hcν, Finset.sum_eq_single j (fun t _ ht => by
          have := congrFun hc t
          simp only [ht, ite_false, add_zero, Pi.single_apply] at this
          rw [show c t = 0 by omega, zero_smul])
        (by simp), ← natCast_zsmul]
      congr 1
      omega
    rcases ih (k - 1) hν with ⟨rfl, -⟩ | rfl
    · exact matAd_self _
    · exact map_zero _

end IterComm

/-- **Generators of a rational Lie algebra of matrices with a triangular weight structure.**
Families `e i`, `f i` of rational square matrices of weights `α i` and `-α i`, where the `α i`
have unique integral coefficients, with `[e i, f j] = 0` for `i ≠ j` and `[e i, f i]` the
diagonal matrix of the additive character `χ i` of the weights. -/
structure LieGens (κ : Type*) [Fintype κ] [DecidableEq κ] where
  α : κ → X
  e : κ → Matrix ι ι ℚ
  f : κ → Matrix ι ι ℚ
  χ : κ → X →+ ℚ
  coeff_inj : ∀ c d : κ → ℤ, ∑ i, c i • α i = ∑ i, d i • α i → c = d
  e_wt : ∀ i, IsWtHom wt (α i) (e i)
  f_wt : ∀ i, IsWtHom wt (-α i) (f i)
  e_f : ∀ i j, matAd (e i) (f j) = if i = j then charDiag wt (χ i) else 0

namespace LieGens

variable {wt} {κ : Type*} [Fintype κ] [DecidableEq κ] (G : LieGens wt κ)

/-- The iterated commutators of the `e i`. -/
def pos : Set (Matrix ι ι ℚ) :=
  {A | ∃ μ, IterComm G.e G.α μ A}

/-- The iterated commutators of the `f i`. -/
def neg : Set (Matrix ι ι ℚ) :=
  {A | ∃ μ, IterComm G.f (fun i => -G.α i) μ A}

/-- The span of the iterated commutators of the `e i` and of the `f i`, and of the diagonal
matrices `h i = [e i, f i]`. -/
def lieSpan : Submodule ℚ (Matrix ι ι ℚ) :=
  span ℚ (G.pos ∪ G.neg ∪ range fun k => charDiag wt (G.χ k))

theorem coeff_inj_neg (c d : κ → ℤ) (h : ∑ i, c i • -G.α i = ∑ i, d i • -G.α i) : c = d := by
  refine G.coeff_inj c d ?_
  simpa only [smul_neg, Finset.sum_neg_distrib, neg_inj] using h

theorem α_ne_zero (i : κ) : G.α i ≠ 0 := by
  intro h
  have := congrFun (G.coeff_inj (Pi.single i 1) 0 (by
    simp only [Pi.single_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true, Pi.zero_apply, Finset.sum_const_zero]
    exact h)) i
  simp at this

theorem e_mem (i : κ) : G.e i ∈ G.lieSpan :=
  subset_span (Or.inl (Or.inl ⟨_, IterComm.base i⟩))

theorem f_mem (i : κ) : G.f i ∈ G.lieSpan :=
  subset_span (Or.inl (Or.inr ⟨_, IterComm.base i⟩))

theorem charDiag_mem (i : κ) : charDiag wt (G.χ i) ∈ G.lieSpan :=
  subset_span (Or.inr ⟨i, rfl⟩)

omit [Fintype κ] [DecidableEq κ] in
/-- The commutator with an element `x` whose commutators with the generators `g j` are
diagonal maps the iterated commutators of the `g j` into the span of these and of the
diagonal matrices. -/
theorem matAd_mem_span_iterComm {g : κ → Matrix ι ι ℚ} {β : κ → X}
    (hg : ∀ j, IsWtHom wt (β j) (g j)) (χ : κ → X →+ ℚ) {x : Matrix ι ι ℚ}
    (hx : ∀ j, matAd x (g j) ∈ span ℚ (range fun k => charDiag wt (χ k))) {μ : X}
    {A : Matrix ι ι ℚ} (hA : IterComm g β μ A) :
    matAd x A ∈ span ℚ ({B | ∃ ν, IterComm g β ν B} ∪ range fun k => charDiag wt (χ k)) := by
  set V := span ℚ ({B | ∃ ν, IterComm g β ν B} ∪ range fun k => charDiag wt (χ k)) with hV
  have hgV : ∀ j, ∀ y ∈ V, matAd (g j) y ∈ V := fun j y hy => by
    refine matAd_mem_of_mem_span (fun z hz => ?_) hy
    rcases hz with ⟨ν, hz⟩ | ⟨k, rfl⟩
    · exact subset_span (Or.inl ⟨_, hz.step j⟩)
    · rw [matAd_swap, matAd_charDiag (hg j)]
      exact V.neg_mem (V.smul_mem _ (subset_span (Or.inl ⟨_, IterComm.base j⟩)))
  have hH : ∀ {ν : X} {B : Matrix ι ι ℚ}, IsWtHom wt ν B →
      ∀ y ∈ span ℚ (range fun k => charDiag wt (χ k)), matAd y B ∈ ℚ ∙ B := by
    intro ν B hB y hy
    refine matAd_mem_of_mem_span_left (fun z hz => ?_) hy
    obtain ⟨k, rfl⟩ := hz
    rw [matAd_charDiag hB]
    exact smul_mem _ _ (mem_span_singleton_self _)
  induction hA with
  | base j => exact span_mono subset_union_right (hx j)
  | @step ν B j hB ih =>
    rw [show matAd x (matAd (g j) B) = matAd (matAd x (g j)) B + matAd (g j) (matAd x B) by
      rw [matAd_matAd]; abel]
    refine V.add_mem ?_ (hgV j _ ih)
    have hBV : B ∈ V := subset_span (Or.inl ⟨ν, hB⟩)
    exact (span_singleton_le_iff_mem B V).2 hBV (hH (hB.isWtHom hg) _ (hx j))

theorem iterComm_e_isWtHom {μ : X} {A : Matrix ι ι ℚ} (h : IterComm G.e G.α μ A) :
    IsWtHom wt μ A :=
  h.isWtHom G.e_wt

theorem iterComm_f_isWtHom {μ : X} {A : Matrix ι ι ℚ}
    (h : IterComm G.f (fun i => -G.α i) μ A) : IsWtHom wt μ A :=
  h.isWtHom G.f_wt

theorem matAd_e_mem (i : κ) {y : Matrix ι ι ℚ} (hy : y ∈ G.lieSpan) :
    matAd (G.e i) y ∈ G.lieSpan := by
  refine matAd_mem_of_mem_span (fun z hz => ?_) hy
  rcases hz with (⟨μ, hz⟩ | ⟨μ, hz⟩) | ⟨k, rfl⟩
  · exact subset_span (Or.inl (Or.inl ⟨_, hz.step i⟩))
  · have := matAd_mem_span_iterComm G.f_wt G.χ (x := G.e i) (fun j => by
      rw [G.e_f]
      split_ifs with hij
      · exact subset_span ⟨i, rfl⟩
      · exact zero_mem _) hz
    refine span_mono ?_ this
    rintro z (hz | hz)
    · exact Or.inl (Or.inr hz)
    · exact Or.inr hz
  · rw [matAd_swap, matAd_charDiag (G.e_wt i)]
    exact neg_mem (smul_mem _ _ (G.e_mem i))

theorem matAd_f_mem (i : κ) {y : Matrix ι ι ℚ} (hy : y ∈ G.lieSpan) :
    matAd (G.f i) y ∈ G.lieSpan := by
  refine matAd_mem_of_mem_span (fun z hz => ?_) hy
  rcases hz with (⟨μ, hz⟩ | ⟨μ, hz⟩) | ⟨k, rfl⟩
  · have := matAd_mem_span_iterComm G.e_wt G.χ (x := G.f i) (fun j => by
      rw [matAd_swap, G.e_f]
      split_ifs with hij
      · exact neg_mem (subset_span ⟨j, rfl⟩)
      · rw [neg_zero]
        exact zero_mem _) hz
    refine span_mono ?_ this
    rintro z (hz | hz)
    · exact Or.inl (Or.inl hz)
    · exact Or.inr hz
  · exact subset_span (Or.inl (Or.inr ⟨_, hz.step i⟩))
  · rw [matAd_swap, matAd_charDiag (G.f_wt i)]
    exact neg_mem (smul_mem _ _ (G.f_mem i))

theorem matAd_charDiag_mem (k : κ) {y : Matrix ι ι ℚ} (hy : y ∈ G.lieSpan) :
    matAd (charDiag wt (G.χ k)) y ∈ G.lieSpan := by
  refine matAd_mem_of_mem_span (fun z hz => ?_) hy
  rcases hz with (⟨μ, hz⟩ | ⟨μ, hz⟩) | ⟨j, rfl⟩
  · rw [matAd_charDiag (G.iterComm_e_isWtHom hz)]
    exact smul_mem _ _ (subset_span (Or.inl (Or.inl ⟨_, hz⟩)))
  · rw [matAd_charDiag (G.iterComm_f_isWtHom hz)]
    exact smul_mem _ _ (subset_span (Or.inl (Or.inr ⟨_, hz⟩)))
  · rw [matAd_charDiag_charDiag]
    exact zero_mem _

/-- `lieSpan` is closed under the commutator. -/
theorem matAd_mem {x y : Matrix ι ι ℚ} (hx : x ∈ G.lieSpan) (hy : y ∈ G.lieSpan) :
    matAd x y ∈ G.lieSpan := by
  let Q : Matrix ι ι ℚ → Prop := fun a => ∀ y ∈ G.lieSpan, matAd a y ∈ G.lieSpan
  have hQ : ∀ {a b}, Q a → Q b → Q (matAd a b) := fun ha hb y hy => by
    rw [matAd_matAd]
    exact sub_mem (ha _ (hb _ hy)) (hb _ (ha _ hy))
  have hpos : ∀ {μ A}, IterComm G.e G.α μ A → Q A := by
    intro μ A h
    induction h with
    | base i => exact fun y hy => G.matAd_e_mem i hy
    | step i _ ih => exact hQ (fun y hy => G.matAd_e_mem i hy) ih
  have hneg : ∀ {μ A}, IterComm G.f (fun i => -G.α i) μ A → Q A := by
    intro μ A h
    induction h with
    | base i => exact fun y hy => G.matAd_f_mem i hy
    | step i _ ih => exact hQ (fun y hy => G.matAd_f_mem i hy) ih
  refine matAd_mem_of_mem_span_left (fun a ha => ?_) hx
  rcases ha with (⟨μ, ha⟩ | ⟨μ, ha⟩) | ⟨k, rfl⟩
  · exact hpos ha y hy
  · exact hneg ha y hy
  · exact G.matAd_charDiag_mem k hy

section Weights

variable [DecidableEq X]

omit [Fintype ι] [DecidableEq ι] in
/-- A homogeneous element of a span lies in the span of the homogeneous components of the
generators. -/
theorem mem_span_wtProj {S : Set (Matrix ι ι ℚ)} {μ : X} {x : Matrix ι ι ℚ}
    (hx : x ∈ span ℚ S) (hμ : IsWtHom wt μ x) : x ∈ span ℚ (wtProj wt μ '' S) := by
  have h1 : (wtProj wt μ).toRatLinearMap x ∈ (span ℚ S).map (wtProj wt μ).toRatLinearMap :=
    mem_map_of_mem hx
  rw [map_span] at h1
  simpa [hμ.wtProj_self] using h1

omit [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] in
theorem wtProj_mem_of_isWtHom {T : Submodule ℚ (Matrix ι ι ℚ)} {ν μ : X} {A : Matrix ι ι ℚ}
    (hA : IsWtHom wt ν A) (h : ν = μ → A ∈ T) : wtProj wt μ A ∈ T := by
  by_cases hνμ : ν = μ
  · subst hνμ
    rw [hA.wtProj_self]
    exact h rfl
  · rw [hA.wtProj_ne (Ne.symm hνμ)]
    exact zero_mem _

/-- Every homogeneous element of `lieSpan` lies in the span of the homogeneous components of
weight `μ` of the generators. -/
theorem lieSpan_le_of_wt {μ : X} {T : Submodule ℚ (Matrix ι ι ℚ)}
    (hpos : ∀ A, IterComm G.e G.α μ A → A ∈ T)
    (hneg : ∀ A, IterComm G.f (fun i => -G.α i) μ A → A ∈ T)
    (hdiag : μ = 0 → ∀ k, charDiag wt (G.χ k) ∈ T)
    {x : Matrix ι ι ℚ} (hx : x ∈ G.lieSpan) (hμ : IsWtHom wt μ x) : x ∈ T := by
  refine (span_le.2 ?_ : span ℚ _ ≤ T) (mem_span_wtProj hx hμ)
  rintro _ ⟨z, hz, rfl⟩
  rcases hz with (⟨ν, hz⟩ | ⟨ν, hz⟩) | ⟨k, rfl⟩
  · exact wtProj_mem_of_isWtHom (G.iterComm_e_isWtHom hz) fun h => hpos _ (h ▸ hz)
  · exact wtProj_mem_of_isWtHom (G.iterComm_f_isWtHom hz) fun h => hneg _ (h ▸ hz)
  · exact wtProj_mem_of_isWtHom (isWtHom_charDiag wt _) fun h => hdiag h.symm k

/-- The component of `lieSpan` of weight `α i` is the line `ℚ • e i`. -/
theorem exists_eq_smul_e_of_isWtHom {x : Matrix ι ι ℚ} (hx : x ∈ G.lieSpan) (i : κ)
    (hxw : IsWtHom wt (G.α i) x) : ∃ q : ℚ, x = q • G.e i := by
  have : x ∈ ℚ ∙ G.e i := by
    refine G.lieSpan_le_of_wt (fun A hA => ?_) (fun A hA => ?_) (fun h => ?_) hx hxw
    · rcases hA.eq_of_eq_smul G.coeff_inj i 1 (one_smul _ _).symm with ⟨rfl, -⟩ | rfl
      · exact mem_span_singleton_self _
      · exact zero_mem _
    · rcases hA.eq_of_eq_smul G.coeff_inj_neg i (-1) (by rw [neg_one_smul, neg_neg]) with
        ⟨-, h⟩ | rfl
      · exact absurd h (by decide)
      · exact zero_mem _
    · exact absurd h (G.α_ne_zero i)
  obtain ⟨q, hq⟩ := mem_span_singleton.1 this
  exact ⟨q, hq.symm⟩

/-- `lieSpan` has a nonzero component of weight `k • α i`, `k ≠ 0`, only for `k = ± 1`. -/
theorem eq_one_or_eq_neg_one_of_isWtHom {x : Matrix ι ι ℚ} (hx : x ∈ G.lieSpan)
    (hx0 : x ≠ 0) (i : κ) (k : ℤ) (hk : k ≠ 0) (hxw : IsWtHom wt (k • G.α i) x) :
    k = 1 ∨ k = -1 := by
  by_contra hk1
  push Not at hk1
  apply hx0
  have : x ∈ (⊥ : Submodule ℚ (Matrix ι ι ℚ)) := by
    refine G.lieSpan_le_of_wt (fun A hA => ?_) (fun A hA => ?_) (fun h => ?_) hx hxw
    · rcases hA.eq_of_eq_smul G.coeff_inj i k rfl with ⟨-, h⟩ | rfl
      · exact absurd h hk1.1
      · exact zero_mem _
    · rcases hA.eq_of_eq_smul G.coeff_inj_neg i (-k) (by rw [neg_smul, smul_neg, neg_neg])
        with ⟨-, h⟩ | rfl
      · exact absurd (neg_eq_iff_eq_neg.1 h) hk1.2
      · exact zero_mem _
    · exfalso
      have := congrFun (G.coeff_inj (Pi.single i k) 0 (by
        simp only [Pi.single_apply, ite_smul, zero_smul, Finset.sum_ite_eq',
          Finset.mem_univ, ite_true, Pi.zero_apply, Finset.sum_const_zero]
        exact h)) i
      simp only [Pi.single_eq_same, Pi.zero_apply] at this
      exact hk this
  simpa using this

/-- The weight of a nonzero homogeneous element of `lieSpan` of nonzero weight is a
nonnegative or a nonpositive integral combination of the `α i`. -/
theorem exists_coeff_of_isWtHom {x : Matrix ι ι ℚ} (hx : x ∈ G.lieSpan) (hx0 : x ≠ 0)
    {μ : X} (hμ0 : μ ≠ 0) (hxw : IsWtHom wt μ x) :
    ∃ c : κ → ℕ, μ = ∑ i, c i • G.α i ∨ μ = -∑ i, c i • G.α i := by
  by_contra hc
  push Not at hc
  apply hx0
  have : x ∈ (⊥ : Submodule ℚ (Matrix ι ι ℚ)) := by
    refine G.lieSpan_le_of_wt (fun A hA => ?_) (fun A hA => ?_) (fun h => absurd h hμ0) hx hxw
    · exfalso
      obtain ⟨c, -, hc'⟩ := hA.exists_coeff
      exact (hc c).1 hc'
    · exfalso
      obtain ⟨c, -, hc'⟩ := hA.exists_coeff
      refine (hc c).2 ?_
      rw [hc']
      simp only [smul_neg, Finset.sum_neg_distrib]
  simpa using this

end Weights

end LieGens

end Langlands.GroupScheme.SplitExistence
