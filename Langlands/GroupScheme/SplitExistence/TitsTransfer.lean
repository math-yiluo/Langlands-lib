import Langlands.Group.TitsSystemBruhat
import Mathlib.Tactic.Group

/-! # Tits axioms for subgroups of an ambient group

A concrete form of the Tits system axioms for two subgroups `B`, `N` of a group `H` and
elements `s i ∈ N`, stated with representatives in `H`. Under these axioms the subgroup
`B ⊔ N` carries the Library's `IsTitsSystem` with Weyl group `N / (B ⊓ N)`, and therefore
every subgroup `P` with `B ≤ P ≤ B ⊔ N` containing no `s i` equals `B`
(Bourbaki, *Lie* IV §2.5, Theorem 3, via `IsTitsSystem.exists_eq_standardParabolic`). -/

namespace Langlands.GroupScheme.SplitExistence

open Langlands.Group

variable {H : Type*} [Group H]

/-- Tits axioms for subgroups `B`, `N` of `H` and representatives `s i ∈ N`:
`B ⊓ N` is normalized by `N`; `N` is generated by `B ⊓ N` and the `s i`; `s i² ∈ B`;
`s i ∉ B`; for every representative `n ∈ s i (B ⊓ N)`, `m ∈ N` and `b ∈ B`,
`n b m ∈ B m B ∪ B (n m) B`; and `s i B s i⁻¹ ⊄ B`. -/
structure IsConcreteTits (B N : Subgroup H) {ι : Type*} (s : ι → H) : Prop where
  normal : ∀ n ∈ N, ∀ t ∈ B ⊓ N, n * t * n⁻¹ ∈ B
  s_mem : ∀ i, s i ∈ N
  le_closure : N ≤ Subgroup.closure ((B ⊓ N : Set H) ∪ Set.range s)
  sq_mem : ∀ i, s i * s i ∈ B
  not_mem : ∀ i, s i ∉ B
  mul_mem : ∀ i, ∀ n ∈ N, (s i)⁻¹ * n ∈ B → ∀ m ∈ N, ∀ b ∈ B,
    ∃ b₁ ∈ B, ∃ b₂ ∈ B, n * b * m = b₁ * m * b₂ ∨ n * b * m = b₁ * (n * m) * b₂
  conj : ∀ i, ∃ b ∈ B, s i * b * (s i)⁻¹ ∉ B

namespace IsConcreteTits

variable {B N : Subgroup H} {ι : Type*} {s : ι → H}

/-- The ambient group `B ⊔ N`. -/
abbrev Γ (B N : Subgroup H) : Subgroup H := B ⊔ N

/-- `B` inside `B ⊔ N`. -/
abbrev B' (B N : Subgroup H) : Subgroup (Γ B N) := B.subgroupOf (Γ B N)

/-- `N` inside `B ⊔ N`. -/
abbrev N' (B N : Subgroup H) : Subgroup (Γ B N) := N.subgroupOf (Γ B N)

/-- `B ⊓ N` inside `N`, as a subgroup of `N'`. -/
abbrev T' (B N : Subgroup H) : Subgroup (N' B N) := (B' B N).subgroupOf (N' B N)

theorem normal_T' (h : IsConcreteTits B N s) : (T' B N).Normal where
  conj_mem t ht n := by
    simp only [Subgroup.mem_subgroupOf] at ht ⊢
    have hn : ((n : Γ B N) : H) ∈ N := n.2
    have ht' : ((t : Γ B N) : H) ∈ B ⊓ N := ⟨ht, t.2⟩
    simpa using h.normal _ hn _ ht'

/-- The Weyl group `N / (B ⊓ N)`. -/
abbrev W (B N : Subgroup H) [(T' B N).Normal] : Type _ := N' B N ⧸ T' B N

/-- Elements of `B` as elements of `B'`. -/
theorem mem_B' {g : Γ B N} : g ∈ B' B N ↔ (g : H) ∈ B := Subgroup.mem_subgroupOf

section Quotient

variable [(T' B N).Normal]

/-- The quotient map `N → N / (B ⊓ N)`. -/
noncomputable def π : N' B N →* W B N := QuotientGroup.mk' (T' B N)

theorem π_eq_one_iff (n : N' B N) : π n = 1 ↔ (((n : Γ B N) : H) ∈ B) := by
  rw [π, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  rfl

variable (h : IsConcreteTits B N s)

/-- The representative of `s i` in `N'`. -/
def sN (i : ι) : N' B N :=
  ⟨⟨s i, Subgroup.mem_sup_right (h.s_mem i)⟩, h.s_mem i⟩

/-- The simple reflections `π (s i)`. -/
def S : Set (W B N) := Set.range fun i => π (h.sN i)

theorem π_eq_π_sN_iff (i : ι) (n : N' B N) :
    π n = π (h.sN i) ↔ (s i)⁻¹ * (((n : Γ B N) : H)) ∈ B := by
  rw [show π n = π (h.sN i) ↔ π ((h.sN i)⁻¹ * n) = 1 by
    rw [map_mul, map_inv, inv_mul_eq_one, eq_comm], π_eq_one_iff]
  rfl

theorem closure_S : Subgroup.closure h.S = ⊤ := by
  rw [eq_top_iff]
  rintro w -
  obtain ⟨n, rfl⟩ := QuotientGroup.mk'_surjective (T' B N) w
  have hn : (((n : Γ B N) : H)) ∈ Subgroup.closure ((B ⊓ N : Set H) ∪ Set.range s) :=
    h.le_closure n.2
  suffices key : ∀ g ∈ Subgroup.closure ((B ⊓ N : Set H) ∪ Set.range s),
      g ∈ N ∧ ∀ hN : g ∈ N, π (⟨⟨g, Subgroup.mem_sup_right hN⟩, hN⟩ : N' B N) ∈
        Subgroup.closure h.S by
    exact (key _ hn).2 n.2
  intro g hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with hg | ⟨i, rfl⟩
    · refine ⟨hg.2, fun hN => ?_⟩
      rw [(π_eq_one_iff _).2 hg.1]
      exact Subgroup.one_mem _
    · exact ⟨h.s_mem i, fun _ => Subgroup.subset_closure ⟨i, rfl⟩⟩
  | one =>
    refine ⟨N.one_mem, fun hN => ?_⟩
    rw [show (⟨⟨1, Subgroup.mem_sup_right hN⟩, hN⟩ : N' B N) = 1 from rfl, map_one]
    exact Subgroup.one_mem _
  | mul a c _ _ ha hc =>
    refine ⟨N.mul_mem ha.1 hc.1, fun hN => ?_⟩
    have : (⟨⟨a * c, Subgroup.mem_sup_right hN⟩, hN⟩ : N' B N) =
        ⟨⟨a, Subgroup.mem_sup_right ha.1⟩, ha.1⟩ * ⟨⟨c, Subgroup.mem_sup_right hc.1⟩, hc.1⟩ := rfl
    rw [this, map_mul]
    exact Subgroup.mul_mem _ (ha.2 ha.1) (hc.2 hc.1)
  | inv a _ ha =>
    refine ⟨N.inv_mem ha.1, fun hN => ?_⟩
    have : (⟨⟨a⁻¹, Subgroup.mem_sup_right hN⟩, hN⟩ : N' B N) =
        (⟨⟨a, Subgroup.mem_sup_right ha.1⟩, ha.1⟩)⁻¹ := rfl
    rw [this, map_inv]
    exact Subgroup.inv_mem _ (ha.2 ha.1)

theorem isTitsSystem : IsTitsSystem (B' B N) (N' B N) π h.S := by
  refine ⟨QuotientGroup.mk'_surjective _, QuotientGroup.ker_mk' _, ?_, h.closure_S, ?_, ?_, ?_, ?_⟩
  · exact codisjoint_iff.1 (Subgroup.codisjoint_subgroupOf_sup B N)
  · rintro _ ⟨i, rfl⟩ h1
    exact h.not_mem i ((π_eq_one_iff _).1 h1)
  · rintro _ ⟨i, rfl⟩
    rw [← map_mul, π_eq_one_iff]
    exact h.sq_mem i
  · rintro _ ⟨i, rfl⟩ n m hn b hb
    have hn' := (h.π_eq_π_sN_iff i n).1 hn
    obtain ⟨b₁, hb₁, b₂, hb₂, hc | hc⟩ :=
      h.mul_mem i _ n.2 hn' _ m.2 _ (mem_B'.1 hb)
    · left
      refine ⟨m, rfl, ⟨b₁, Subgroup.mem_sup_left hb₁⟩, hb₁, ⟨b₂, Subgroup.mem_sup_left hb₂⟩, hb₂, ?_⟩
      exact Subtype.ext hc
    · right
      refine ⟨n * m, by rw [map_mul, hn], ⟨b₁, Subgroup.mem_sup_left hb₁⟩, hb₁,
        ⟨b₂, Subgroup.mem_sup_left hb₂⟩, hb₂, ?_⟩
      exact Subtype.ext hc
  · rintro _ ⟨i, rfl⟩ n hn
    have hn' := (h.π_eq_π_sN_iff i n).1 hn
    obtain ⟨b₀, hb₀, hc⟩ := h.conj i
    set t : H := (s i)⁻¹ * (((n : Γ B N) : H)) with ht
    have htB : t⁻¹ * b₀ * t ∈ B := B.mul_mem (B.mul_mem (B.inv_mem hn') hb₀) hn'
    refine ⟨⟨t⁻¹ * b₀ * t, Subgroup.mem_sup_left htB⟩, htB, fun hmem => hc ?_⟩
    have hnt : (((n : Γ B N) : H)) = s i * t := by rw [ht]; group
    have : (((n : Γ B N) : H)) * (t⁻¹ * b₀ * t) * (((n : Γ B N) : H))⁻¹ =
        s i * b₀ * (s i)⁻¹ := by
      rw [hnt]; group
    rw [← this]
    exact mem_B'.1 hmem

end Quotient

/-- **Parabolic rigidity.** A subgroup `P` with `B ≤ P ≤ B ⊔ N` containing none of the `s i`
equals `B`. -/
theorem eq_of_le (h : IsConcreteTits B N s) (P : Subgroup H) (hBP : B ≤ P)
    (hPΓ : P ≤ B ⊔ N) (hs : ∀ i, s i ∉ P) : P = B := by
  have := h.normal_T'
  have hT := h.isTitsSystem
  have hB'P : B' B N ≤ P.subgroupOf (Γ B N) := fun g hg => hBP hg
  obtain ⟨X, hXS, hX⟩ := hT.exists_eq_standardParabolic (P.subgroupOf (Γ B N)) hB'P
  have hXe : X = ∅ := by
    rw [Set.eq_empty_iff_forall_notMem]
    intro w hw
    obtain ⟨i, rfl⟩ := hXS hw
    have hmem : ((h.sN i : N' B N) : Γ B N) ∈ (P.subgroupOf (Γ B N) : Set (Γ B N)) := by
      rw [hX]
      exact ⟨_, Subgroup.subset_closure hw, TitsSystem.coe_mem_cell _⟩
    exact hs i hmem
  rw [hXe, hT.standardParabolic_empty] at hX
  have h1 : P.subgroupOf (Γ B N) = B.subgroupOf (Γ B N) := SetLike.coe_injective hX
  rw [Subgroup.subgroupOf_inj, inf_eq_left.2 hPΓ, inf_eq_left.2 le_sup_left] at h1
  exact h1

end IsConcreteTits

end Langlands.GroupScheme.SplitExistence
