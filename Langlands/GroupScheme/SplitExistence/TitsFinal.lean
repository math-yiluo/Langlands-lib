import Langlands.GroupScheme.SplitExistence.TitsAxioms

/-! # The `ℓ`-parabolic subgroup of the Chevalley group is `B`

`btSub` is the group of invertible matrices that are block triangular for the order of the
basis by `ℓ(wt c)`, i.e. the points of the parabolic subgroup of the cocharacter `ℓ`. With the
Tits axioms (`IsConcreteTits`) and `IsConcreteTits.eq_of_le`, `Γ ∩ btSub = B`, where `Γ` is
generated by the torus and all root groups. -/

noncomputable section

universe u

open Matrix

namespace Langlands.GroupScheme.SplitExistence

namespace ChevalleyData

variable {J X Y : Type u} [AddCommGroup X] [AddCommGroup Y] {P : RootDatum J X Y} {b : P.Base}
  (D : ChevalleyData P b) {K : Type u} [Field K]

/-- The block function `c ↦ ℓ(wt c)`, in the order dual so that block-triangular means
"nonzero entries `(c, d)` have `ℓ(wt d) ≤ ℓ(wt c)`". -/
def blockFn : Fin D.n → ℤᵒᵈ := fun c => OrderDual.toDual (D.ℓ (D.wt c))

variable (K) in
/-- The `ℓ`-parabolic subgroup of `GL_n(K)`. -/
def btSub : Subgroup (GL (Fin D.n) K) where
  carrier := {g | (g : Matrix (Fin D.n) (Fin D.n) K).BlockTriangular D.blockFn}
  mul_mem' {g g'} hg hg' := by
    change ((g * g' : GL (Fin D.n) K) : Matrix (Fin D.n) (Fin D.n) K).BlockTriangular D.blockFn
    rw [Units.val_mul]
    exact hg.mul hg'
  one_mem' := by
    change ((1 : GL (Fin D.n) K) : Matrix (Fin D.n) (Fin D.n) K).BlockTriangular D.blockFn
    rw [Units.val_one]
    exact Matrix.blockTriangular_one
  inv_mem' {g} hg := by
    let _ : Invertible (g : Matrix (Fin D.n) (Fin D.n) K) := Units.invertible g
    have h := Matrix.blockTriangular_inv_of_blockTriangular hg
    change ((g⁻¹ : GL (Fin D.n) K) : Matrix (Fin D.n) (Fin D.n) K).BlockTriangular D.blockFn
    rwa [Matrix.coe_units_inv]

theorem mem_btSub {g : GL (Fin D.n) K} :
    g ∈ D.btSub K ↔ (g : Matrix (Fin D.n) (Fin D.n) K).BlockTriangular D.blockFn :=
  Iff.rfl

theorem utSub_le_btSub : D.utSub ≤ D.btSub K := fun _ hg => D.blockTriangular_of_isUT hg

theorem torusSub_le_btSub : D.torusSub K ≤ D.btSub K := by
  rintro _ ⟨χ, rfl⟩
  rw [mem_btSub, coe_torusHom]
  exact Matrix.blockTriangular_diagonal _

theorem borelSub_le_btSub : D.borelSub K ≤ D.btSub K :=
  sup_le D.torusSub_le_btSub (D.posSub_le_utSub.trans D.utSub_le_btSub)

/-- An entry `(c, d)` of an element of `btSub` with `ℓ(wt c) < ℓ(wt d)` vanishes. -/
theorem entry_eq_zero_of_mem_btSub {g : GL (Fin D.n) K} (hg : g ∈ D.btSub K) {c d : Fin D.n}
    (hcd : D.ℓ (D.wt c) < D.ℓ (D.wt d)) : (g : Matrix (Fin D.n) (Fin D.n) K) c d = 0 :=
  hg hcd

/-- Every column of an invertible matrix has a nonzero entry. -/
theorem exists_entry_ne_zero (g : GL (Fin D.n) K) (d : Fin D.n) :
    ∃ c, (g : Matrix (Fin D.n) (Fin D.n) K) c d ≠ 0 := by
  by_contra h
  push Not at h
  have h1 := congrArg (fun A => A d d)
    (show ((g⁻¹ : GL (Fin D.n) K) : Matrix (Fin D.n) (Fin D.n) K) *
      (g : Matrix (Fin D.n) (Fin D.n) K) = 1 by rw [← Units.val_mul, inv_mul_cancel, Units.val_one])
  simp only [Matrix.mul_apply, h, mul_zero, Finset.sum_const_zero, one_apply_eq] at h1
  exact zero_ne_one h1

theorem pairing_reflection (i : J) (x : X) :
    P.toLinearMap (P.reflection i x) (P.coroot i) = -P.toLinearMap x (P.coroot i) := by
  rw [RootPairing.reflection_apply]
  change P.toLinearMap (x - P.toLinearMap x (P.coroot i) • P.root i) (P.coroot i) = _
  rw [map_sub, map_zsmul, LinearMap.sub_apply, LinearMap.smul_apply, P.root_coroot_two,
    smul_eq_mul]
  ring

theorem exists_pairing_pos (K : Type u) [Field K] (i : b.support) :
    ∃ d : Fin D.n, 0 < P.toLinearMap (D.wt d) (P.coroot i) := by
  have hne : ∃ d : Fin D.n, P.toLinearMap (D.wt d) (P.coroot i) ≠ 0 := by
    by_contra h
    push Not at h
    let f : X →+ ℤ := (P.toLinearMap.flip (P.coroot i)).toAddMonoidHom
    have hle : AddSubgroup.closure (Set.range D.wt) ≤ f.ker := by
      rw [AddSubgroup.closure_le]
      rintro _ ⟨d, rfl⟩
      exact h d
    rw [D.closure_range_wt] at hle
    have h2 : f (P.root i) = 0 := hle trivial
    have h3 : f (P.root i) = 2 := P.root_coroot_two i
    rw [h2] at h3
    norm_num at h3
  obtain ⟨d, hd⟩ := hne
  rcases lt_or_gt_of_ne hd with hneg | hpos
  · obtain ⟨c, hc⟩ := D.exists_entry_ne_zero (D.wn (K := K) i) d
    refine ⟨c, ?_⟩
    rw [D.wn_weight i hc, pairing_reflection]
    linarith
  · exact ⟨d, hpos⟩

theorem wn_not_mem_btSub (i : b.support) : D.wn (K := K) i ∉ D.btSub K := by
  intro h
  obtain ⟨d, hd⟩ := D.exists_pairing_pos K i
  obtain ⟨c, hc⟩ := D.exists_entry_ne_zero (D.wn (K := K) i) d
  apply hc
  apply D.entry_eq_zero_of_mem_btSub h
  have hi := (D.isPos_iff_ℓ_pos (i : J)).1 (RootPairing.Base.isPos_of_mem_support i.2)
  rw [D.wn_weight i hc, RootPairing.reflection_apply]
  change D.ℓ (D.wt d - P.toLinearMap (D.wt d) (P.coroot i) • P.root i) < D.ℓ (D.wt d)
  rw [map_sub, map_zsmul, smul_eq_mul]
  nlinarith

theorem e_one_map_ne_zero_field (j : J) : (D.e j 1).map (Int.castRingHom K) ≠ 0 := by
  rcases CharP.char_is_prime_or_zero K (ringChar K) with hp | hp
  · have : Fact (ringChar K).Prime := ⟨hp⟩
    have hcomp : Int.castRingHom K =
        (ZMod.castHom (dvd_refl (ringChar K)) K).comp (Int.castRingHom (ZMod (ringChar K))) :=
      RingHom.ext_int _ _
    intro h0
    apply D.e_one_map_ne_zero j (ringChar K) hp
    ext c d
    have := congrArg (fun A => A c d) h0
    simp only [Matrix.map_apply, Matrix.zero_apply, hcomp, RingHom.comp_apply] at this
    exact (map_eq_zero_iff _ (ZMod.castHom_injective (n := ringChar K) K)).1 this
  · have : CharZero K := by
      have := ringChar.charP K
      rw [hp] at this
      exact CharP.charP_to_charZero K
    intro h0
    apply D.e_one_map_ne_zero j 2 Nat.prime_two
    ext c d
    have := congrArg (fun A => A c d) h0
    simp only [Matrix.map_apply, Matrix.zero_apply, eq_intCast, Int.cast_eq_zero] at this
    simp [this]

theorem x_not_mem_btSub_of_neg {j : J} (hj : D.ℓ (P.root j) < 0) {s : K} (hs : s ≠ 0) :
    D.x j s ∉ D.btSub K := by
  intro h
  have hne := D.e_one_map_ne_zero_field (K := K) j
  obtain ⟨c, d, hcd⟩ : ∃ c d, ((D.e j 1).map (Int.castRingHom K)) c d ≠ 0 := by
    by_contra h'
    push Not at h'
    exact hne (Matrix.ext h')
  have he : D.e j 1 c d ≠ 0 := by
    intro h0
    simp [h0] at hcd
  have hw := D.e_weight j 1 c d he
  have hlt : D.ℓ (D.wt c) < D.ℓ (D.wt d) := by
    rw [hw, map_add, one_smul]
    linarith
  have hentry := D.entry_eq_zero_of_mem_btSub h hlt
  rw [coe_x] at hentry
  simp only [divExp, Matrix.sum_apply, Matrix.smul_apply, Matrix.map_apply, smul_eq_mul,
    eq_intCast] at hentry hcd
  rw [Finset.sum_eq_single 1] at hentry
  · rw [pow_one] at hentry
    exact hcd ((mul_eq_zero.1 hentry).resolve_left hs)
  · intro k _ hk
    by_cases hek : D.e j k c d = 0
    · simp [hek]
    · exfalso
      have hwk := D.e_weight j k c d hek
      rw [hw] at hwk
      have hℓ := congrArg D.ℓ hwk
      simp only [map_add, map_nsmul, one_smul, nsmul_eq_mul] at hℓ
      have hk' : ((k : ℤ) - 1) * D.ℓ (P.root j) = 0 := by linarith
      rcases mul_eq_zero.1 hk' with h1 | h1
      · exact hk (by omega)
      · exact (D.ℓ_root_ne_zero j) h1
  · simp [show 1 < D.n + 1 from by
      by_contra hn
      have : D.n = 0 := by omega
      exact (Fin.elim0 (this ▸ c))]

theorem rootSub_reflectionPerm_le (j : b.support) (i : J) {H : Subgroup (GL (Fin D.n) K)}
    (hi : D.rootSub K i ≤ H) (hw : D.wn j ∈ H) : D.rootSub K (P.reflectionPerm j i) ≤ H := by
  intro g hg
  obtain ⟨s, rfl⟩ := mem_rootSub.1 hg
  obtain ⟨ε, hε, h⟩ := D.wn_conj_x (K := K) j i
  have hεε : (ε : K) * ε = 1 := by
    rcases hε with rfl | rfl <;> norm_num
  have h' := h (ε * s)
  rw [← mul_assoc, hεε, one_mul] at h'
  rw [← h']
  exact H.mul_mem (H.mul_mem hw (hi (x_mem_rootSub i _))) (H.inv_mem hw)

theorem reflectionPerm_neg_neg (i : J) :
    P.reflectionPerm (P.reflectionPerm i i) (P.reflectionPerm i i) = i := by
  apply P.root.injective
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
    RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self, neg_neg]

theorem reflectionPerm_neg_reflectionPerm (j i : J) :
    P.reflectionPerm (P.reflectionPerm j i) (P.reflectionPerm j i) =
      P.reflectionPerm j (P.reflectionPerm i i) := by
  apply P.root.injective
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
    RootPairing.root_reflectionPerm, RootPairing.root_reflectionPerm,
    RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self, map_neg]

theorem weylSub_le_chevSub : D.weylSub K ≤ D.chevSub K := by
  rw [weylSub, Subgroup.closure_le]
  rintro _ (h | ⟨i, rfl⟩)
  · exact le_sup_left (α := Subgroup (GL (Fin D.n) K)) h
  · change D.wn i ∈ (D.chevSub K : Set (GL (Fin D.n) K))
    rw [wn_eq]
    have hx : ∀ (j : J) (s : K), D.x j s ∈ D.chevSub K := fun j s =>
      le_sup_right (α := Subgroup (GL (Fin D.n) K))
        (rootSub_le_rootsSub (Set.mem_univ j) (x_mem_rootSub j s))
    exact (D.chevSub K).mul_mem ((D.chevSub K).mul_mem (hx _ _) (hx _ _)) (hx _ _)

theorem borelSub_le_chevSub : D.borelSub K ≤ D.chevSub K :=
  sup_le le_sup_left ((rootsSub_mono (Set.subset_univ _)).trans le_sup_right)

variable [Finite J] [P.IsReduced]

theorem chevSub_le_sup : D.chevSub K ≤ D.borelSub K ⊔ D.weylSub K := by
  set H := D.borelSub K ⊔ D.weylSub K
  have hwn : ∀ i : b.support, D.wn (K := K) i ∈ H := fun i =>
    le_sup_right (α := Subgroup (GL (Fin D.n) K)) (wn_mem_weylSub i)
  have key : ∀ j : J, D.rootSub K j ≤ H ∧ D.rootSub K (P.reflectionPerm j j) ≤ H := by
    intro j
    refine b.induction_reflect (p := fun j => D.rootSub K j ≤ H ∧
      D.rootSub K (P.reflectionPerm j j) ≤ H) j (fun i hi => ⟨hi.2, ?_⟩) (fun i hi => ?_) (fun i j' hi hj' => ?_)
    · rw [reflectionPerm_neg_neg]
      exact hi.1
    · have h1 : D.rootSub K i ≤ H := (rootSub_le_rootsSub (S := {j | b.IsPos j})
        (RootPairing.Base.isPos_of_mem_support hi)).trans
        ((D.posSub_le_borelSub).trans le_sup_left)
      exact ⟨h1, D.rootSub_reflectionPerm_le ⟨i, hi⟩ i h1 (hwn ⟨i, hi⟩)⟩
    · refine ⟨D.rootSub_reflectionPerm_le ⟨j', hj'⟩ i hi.1 (hwn ⟨j', hj'⟩), ?_⟩
      rw [reflectionPerm_neg_reflectionPerm]
      exact D.rootSub_reflectionPerm_le ⟨j', hj'⟩ _ hi.2 (hwn ⟨j', hj'⟩)
  refine sup_le (D.torusSub_le_borelSub.trans le_sup_left) ?_
  rw [rootsSub, Subgroup.closure_le]
  intro g hg
  obtain ⟨j, -, hg⟩ := Set.mem_iUnion₂.1 hg
  exact (key j).1 hg

theorem isConcreteTits :
    IsConcreteTits (D.borelSub K) (D.weylSub K) fun i : b.support => D.wn (K := K) i where
  normal n hn t ht := by
    rw [D.borelSub_inf_weylSub] at ht
    exact D.torusSub_le_borelSub (D.conj_mem_torusSub_of_mem_weylSub hn ht)
  s_mem i := wn_mem_weylSub i
  le_closure := by
    intro g hg
    refine Subgroup.closure_mono (Set.union_subset_union_left _ fun t ht => ?_) hg
    rw [← D.borelSub_inf_weylSub] at ht
    exact ⟨ht.1, ht.2⟩
  sq_mem i := by
    rw [D.wn_mul_self]
    exact D.torusSub_le_borelSub (torusHom_mem_torusSub _)
  not_mem i h := D.wn_not_mem_btSub i (D.borelSub_le_btSub h)
  mul_mem i n hn hn' m hm g hg := D.tits_mul_mem i hn hn' hm hg
  conj i := by
    refine ⟨D.x i 1, D.x_mem_borelSub (RootPairing.Base.isPos_of_mem_support i.2) 1, fun h => ?_⟩
    obtain ⟨ε, hε, h1⟩ := D.wn_conj_x (K := K) i i
    rw [h1] at h
    have hεne : (ε : K) * 1 ≠ 0 := by rcases hε with rfl | rfl <;> norm_num
    refine D.x_not_mem_btSub_of_neg ?_ hεne (D.borelSub_le_btSub h)
    rw [D.ℓ_reflectionPerm_self]
    have := (D.isPos_iff_ℓ_pos (i : J)).1 (RootPairing.Base.isPos_of_mem_support i.2)
    linarith

/-- **The `ℓ`-parabolic subgroup of `Γ` is `B`.** -/
theorem chevSub_inf_btSub : D.chevSub K ⊓ D.btSub K = D.borelSub K :=
  D.isConcreteTits.eq_of_le _ (le_inf D.borelSub_le_chevSub D.borelSub_le_btSub)
    (inf_le_left.trans D.chevSub_le_sup) fun i h => D.wn_not_mem_btSub i h.2

end ChevalleyData

end Langlands.GroupScheme.SplitExistence
