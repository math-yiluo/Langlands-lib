import Langlands.GroupScheme.SplitExistence.SimpleDecomp

/-! # `U⁺` is the ordered product of the positive root groups

With the positive roots listed in order of increasing `ℓ`, every element of `U⁺(K)` is an
ordered product `∏ x_γ(c_γ)` (Steinberg, *Lectures on Chevalley groups*, §3, Lemma 17). The proof
is a descending induction on the level `m`: the subgroup `U_{≥m}` generated by the positive root
groups of `ℓ`-level at least `m` is normalized by `U⁺`, and the root groups of level exactly `m`
commute modulo `U_{≥m+1}` by the commutator relations. -/

noncomputable section

universe u

open Matrix

namespace Langlands.GroupScheme.SplitExistence

/-- In a list sorted by a key, the entries of key at least `m` are those of key `m` followed by
those of key at least `m + 1`. -/
theorem List.filter_ge_eq_append {α : Type*} (f : α → ℤ) (m : ℤ) :
    ∀ l : List α, l.Pairwise (fun a c => f a ≤ f c) →
      l.filter (fun a => decide (m ≤ f a)) =
        l.filter (fun a => decide (f a = m)) ++ l.filter (fun a => decide (m + 1 ≤ f a))
  | [], _ => rfl
  | a :: l, h => by
    rw [List.pairwise_cons] at h
    have ih := List.filter_ge_eq_append f m l h.2
    by_cases h1 : f a < m
    · have h2 : ¬ m ≤ f a := by omega
      have h3 : f a ≠ m := by omega
      have h4 : ¬ m + 1 ≤ f a := by omega
      simp [List.filter_cons, h2, h3, ih]
      try omega
    · by_cases h5 : f a = m
      · have h4 : ¬ m + 1 ≤ f a := by omega
        simp [h5, ih]
      · have hgt : m < f a := by omega
        have hall : ∀ c ∈ l, m < f c := fun c hc => lt_of_lt_of_le hgt (h.1 c hc)
        have e1 : l.filter (fun c => decide (f c = m)) = [] := by
          rw [List.filter_eq_nil_iff]
          intro c hc
          have := hall c hc
          simp only [decide_eq_true_eq]
          omega
        have e2 : l.filter (fun c => decide (m ≤ f c)) = l.filter (fun c => decide (m + 1 ≤ f c)) := by
          apply List.filter_congr
          intro c hc
          have := hall c hc
          simp only [decide_eq_decide]
          omega
        have h6 : m ≤ f a := by omega
        have h7 : m + 1 ≤ f a := by omega
        simp [List.filter_cons, h6, h5, e1, e2]
        try omega

namespace ChevalleyData

variable {J X Y : Type u} [AddCommGroup X] [AddCommGroup Y] {P : RootDatum J X Y} {b : P.Base}
  (D : ChevalleyData P b) {K : Type u} [Field K]

/-- The ordered product `∏_{j ∈ l} x_j(c j)` along a list of roots. -/
def orderedProd (l : List J) (c : J → K) : GL (Fin D.n) K :=
  (l.map fun j => D.x j (c j)).prod

theorem orderedProd_nil (c : J → K) : D.orderedProd [] c = 1 := rfl

theorem orderedProd_cons (j : J) (l : List J) (c : J → K) :
    D.orderedProd (j :: l) c = D.x j (c j) * D.orderedProd l c := by
  simp [orderedProd]

theorem orderedProd_append (l l' : List J) (c : J → K) :
    D.orderedProd (l ++ l') c = D.orderedProd l c * D.orderedProd l' c := by
  simp [orderedProd]

theorem orderedProd_congr {l : List J} {c c' : J → K} (h : ∀ j ∈ l, c j = c' j) :
    D.orderedProd l c = D.orderedProd l c' := by
  unfold orderedProd
  rw [List.map_congr_left fun j hj => by rw [h j hj]]

theorem orderedProd_zero (l : List J) : D.orderedProd l (0 : J → K) = 1 := by
  induction l with
  | nil => rfl
  | cons j l ih => rw [orderedProd_cons, Pi.zero_apply, x_zero, one_mul, ih]

theorem orderedProd_mem_rootsSub {S : Set J} {l : List J} (hl : ∀ j ∈ l, j ∈ S) (c : J → K) :
    D.orderedProd l c ∈ D.rootsSub K S := by
  refine (D.rootsSub K S).list_prod_mem fun g hg => ?_
  obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hg
  exact rootSub_le_rootsSub (hl j hj) (x_mem_rootSub _ _)

/-- The commutator of two root elements of roots on which some `h : X →+ ℤ` is positive lies in
`rootsSub S` once `S` contains every root `a i + c j` with `a, c ≥ 1`. -/
theorem commutator_mem_rootsSub (h : X →+ ℤ) {i j : J} (hi : 0 < h (P.root i))
    (hj : 0 < h (P.root j)) {S : Set J}
    (hS : ∀ k : J, ∀ a c : ℕ, 1 ≤ a → 1 ≤ c → P.root k = a • P.root i + c • P.root j → k ∈ S)
    (s t : K) : D.x i s * D.x j t * D.x i (-s) * D.x j (-t) ∈ D.rootsSub K S := by
  obtain ⟨L, hL, hcomm⟩ := D.commutator i j h hi hj K s t
  have hC : D.x i s * D.x j t * D.x i (-s) * D.x j (-t) = (L.map fun x => D.x x.1 x.2).prod := by
    apply Units.ext
    rw [coe_list_prod_x]
    simp only [Units.val_mul, coe_x]
    exact hcomm
  rw [hC]
  refine (D.rootsSub K S).list_prod_mem fun g hg => ?_
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hg
  obtain ⟨a, c, ha, hc, hk⟩ := hL x hx
  exact rootSub_le_rootsSub (hS _ _ _ ha hc hk) (x_mem_rootSub _ _)

/-- Positive roots of `ℓ`-level at least `m`. -/
def posGe (m : ℤ) : Set J := {j | b.IsPos j ∧ m ≤ D.ℓ (P.root j)}

theorem ℓ_root_pos {j : J} (hj : b.IsPos j) : 0 < D.ℓ (P.root j) := (D.isPos_iff_ℓ_pos j).1 hj

/-- For positive roots `i, j`, the commutator of `x_i(s)` and `x_j(t)` lies in the subgroup
generated by the positive root groups of level at least `m`, provided `ℓ(i) + ℓ(j) ≥ m`. -/
theorem commutator_mem_posGe {i j : J} (hi : b.IsPos i) (hj : b.IsPos j) {m : ℤ}
    (hm : m ≤ D.ℓ (P.root i) + D.ℓ (P.root j)) (s t : K) :
    D.x i s * D.x j t * D.x i (-s) * D.x j (-t) ∈ D.rootsSub K (D.posGe m) := by
  have hℓi := D.ℓ_root_pos hi
  have hℓj := D.ℓ_root_pos hj
  refine D.commutator_mem_rootsSub D.ℓ hℓi hℓj ?_ s t
  · intro k a c ha hc hk
    have hℓk : D.ℓ (P.root k) = (a : ℤ) * D.ℓ (P.root i) + (c : ℤ) * D.ℓ (P.root j) := by
      rw [hk, map_add, map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul]
    have h1 : D.ℓ (P.root i) ≤ (a : ℤ) * D.ℓ (P.root i) := by
      have : (1 : ℤ) ≤ a := by exact_mod_cast ha
      nlinarith
    have h2 : D.ℓ (P.root j) ≤ (c : ℤ) * D.ℓ (P.root j) := by
      have : (1 : ℤ) ≤ c := by exact_mod_cast hc
      nlinarith
    refine ⟨(D.isPos_iff_ℓ_pos k).2 (by linarith), by linarith⟩

/-- Conjugation by a positive root element maps `U_{≥m}` into itself. -/
theorem x_conj_mem_posGe {i : J} (hi : b.IsPos i) (m : ℤ) (s : K) {g : GL (Fin D.n) K}
    (hg : g ∈ D.rootsSub K (D.posGe m)) : D.x i s * g * (D.x i s)⁻¹ ∈ D.rootsSub K (D.posGe m) := by
  refine conj_mem_of_mem_closure (fun v hv => ?_) hg
  obtain ⟨j, hj, hv⟩ := Set.mem_iUnion₂.1 hv
  obtain ⟨t, rfl⟩ := mem_rootSub.1 hv
  by_cases hij : j = i
  · subst hij
    rw [← x_add, ← x_neg, ← x_add, add_neg_cancel_comm]
    exact rootSub_le_rootsSub hj (x_mem_rootSub _ _)
  · have hc := D.commutator_mem_posGe hi hj.1 (m := m)
      (by have := D.ℓ_root_pos hi; linarith [hj.2]) s t
    have : D.x i s * D.x j t * (D.x i s)⁻¹ =
        (D.x i s * D.x j t * D.x i (-s) * D.x j (-t)) * D.x j t := by
      rw [x_neg, x_neg]; group
    rw [this]
    exact (D.rootsSub K _).mul_mem hc (rootSub_le_rootsSub hj (x_mem_rootSub _ _))

/-- `U⁺` normalizes `U_{≥m}`. -/
theorem posSub_le_normalizer_posGe (m : ℤ) :
    D.posSub K ≤ Subgroup.normalizer (D.rootsSub K (D.posGe m) : Set (GL (Fin D.n) K)) := by
  rw [posSub, rootsSub, Subgroup.closure_le]
  intro g hg
  obtain ⟨i, hi, hg⟩ := Set.mem_iUnion₂.1 hg
  obtain ⟨s, rfl⟩ := mem_rootSub.1 hg
  rw [SetLike.mem_coe, Subgroup.mem_normalizer_iff]
  intro h
  refine ⟨fun hh => D.x_conj_mem_posGe hi m s hh, fun hh => ?_⟩
  have := D.x_conj_mem_posGe hi m (-s) hh
  rw [x_neg, inv_inv] at this
  have e : (D.x i s)⁻¹ * (D.x i s * h * (D.x i s)⁻¹) * D.x i s = h := by group
  rwa [e] at this

theorem inv_conj_mem_posGe {g : GL (Fin D.n) K} (hg : g ∈ D.posSub K) (m : ℤ)
    {w : GL (Fin D.n) K} (hw : w ∈ D.rootsSub K (D.posGe m)) :
    g⁻¹ * w * g ∈ D.rootsSub K (D.posGe m) := by
  have h := (Subgroup.mem_normalizer_iff.1
    (Subgroup.inv_mem _ (D.posSub_le_normalizer_posGe m hg)) w).1 hw
  rwa [inv_inv] at h

variable [DecidableEq J] in
/-- **Level step.** On a list of distinct positive roots of level `m ≥ 1`, left multiplication by
`x_δ(s)` changes the coefficient of `δ` by `s`, up to a right factor in `U_{≥m+1}`. -/
theorem level_step {m : ℤ} (hm : 1 ≤ m) :
    ∀ (l : List J), l.Nodup → (∀ j ∈ l, b.IsPos j ∧ D.ℓ (P.root j) = m) →
    ∀ {δ : J}, δ ∈ l → ∀ (s : K) (c : J → K), ∃ w ∈ D.rootsSub K (D.posGe (m + 1)),
      D.x δ s * D.orderedProd l c = D.orderedProd l (Function.update c δ (c δ + s)) * w
  | [], _, _, δ, hδ, _, _ => absurd hδ List.not_mem_nil
  | γ :: l, hnd, hl, δ, hδ, s, c => by
    rw [List.nodup_cons] at hnd
    by_cases hγδ : δ = γ
    · subst hγδ
      refine ⟨1, (D.rootsSub K _).one_mem, ?_⟩
      rw [orderedProd_cons, orderedProd_cons, mul_one, ← mul_assoc, ← x_add,
        Function.update_self, add_comm]
      congr 1
      exact D.orderedProd_congr fun j hj => by
        rw [Function.update_of_ne (by rintro rfl; exact hnd.1 hj)]
    · have hδl : δ ∈ l := (List.mem_cons.1 hδ).resolve_left hγδ
      obtain ⟨w₂, hw₂, h₂⟩ := level_step hm l hnd.2 (fun j hj => hl j (List.mem_cons_of_mem _ hj))
        hδl s c
      have hγ := hl γ (List.mem_cons_self ..)
      have hδ' := hl δ (List.mem_cons_of_mem _ hδl)
      have hw₁ := D.commutator_mem_posGe hγ.1 hδ'.1 (m := m + 1)
        (by rw [hγ.2, hδ'.2]; linarith) (-c γ) s
      set w₁ := D.x γ (-c γ) * D.x δ s * D.x γ (- -c γ) * D.x δ (-s) with hw₁def
      set c' := Function.update c δ (c δ + s) with hc'
      have hPmem : D.orderedProd l c' ∈ D.posSub K :=
        D.orderedProd_mem_rootsSub (fun j hj => (hl j (List.mem_cons_of_mem _ hj)).1) c'
      refine ⟨(D.orderedProd l c')⁻¹ * w₁ * D.orderedProd l c' * w₂,
        (D.rootsSub K _).mul_mem (D.inv_conj_mem_posGe hPmem _ hw₁) hw₂, ?_⟩
      have hcγ : c' γ = c γ := Function.update_of_ne (Ne.symm hγδ) _ _
      rw [orderedProd_cons, orderedProd_cons, hcγ]
      calc D.x δ s * (D.x γ (c γ) * D.orderedProd l c)
          = D.x γ (c γ) * w₁ * (D.x δ s * D.orderedProd l c) := by
            rw [hw₁def, neg_neg, x_neg, x_neg]; group
        _ = D.x γ (c γ) * w₁ * (D.orderedProd l c' * w₂) := by rw [h₂]
        _ = D.x γ (c γ) * D.orderedProd l c' *
            ((D.orderedProd l c')⁻¹ * w₁ * D.orderedProd l c' * w₂) := by group

section PosList

variable [Fintype J]

open Classical in
/-- The positive roots, sorted by increasing `ℓ`. -/
def posList : List J :=
  ((Finset.univ.filter fun j => b.IsPos j).toList).mergeSort
    fun a c => decide (D.ℓ (P.root a) ≤ D.ℓ (P.root c))

open Classical in
theorem mem_posList {j : J} : j ∈ D.posList ↔ b.IsPos j := by
  rw [posList, (List.mergeSort_perm _ _).mem_iff, Finset.mem_toList, Finset.mem_filter]
  simp

open Classical in
theorem posList_nodup : D.posList.Nodup :=
  (List.mergeSort_perm _ _).nodup_iff.2 (Finset.nodup_toList _)

open Classical in
theorem posList_sorted : D.posList.Pairwise fun a c => D.ℓ (P.root a) ≤ D.ℓ (P.root c) := by
  have h := List.pairwise_mergeSort (le := fun a c => decide (D.ℓ (P.root a) ≤ D.ℓ (P.root c)))
    (fun a b c hab hbc => by simp only [decide_eq_true_eq] at *; exact hab.trans hbc)
    (fun a c => by simpa using le_total _ _) ((Finset.univ.filter fun j => b.IsPos j).toList)
  exact h.imp fun h' => by simpa using h'

/-- The filtered ordered product over the positive roots of level at least `m`. -/
def opGe (m : ℤ) (c : J → K) : GL (Fin D.n) K :=
  D.orderedProd (D.posList.filter fun j => decide (m ≤ D.ℓ (P.root j))) c

theorem opGe_eq (m : ℤ) (c : J → K) :
    D.opGe m c = D.orderedProd (D.posList.filter fun j => decide (D.ℓ (P.root j) = m)) c *
      D.opGe (m + 1) c := by
  rw [opGe, opGe, List.filter_ge_eq_append (fun j => D.ℓ (P.root j)) m _ D.posList_sorted,
    orderedProd_append]

theorem opGe_mem (m : ℤ) (c : J → K) : D.opGe m c ∈ D.rootsSub K (D.posGe m) := by
  refine D.orderedProd_mem_rootsSub (fun j hj => ?_) c
  rw [List.mem_filter, decide_eq_true_eq] at hj
  exact ⟨D.mem_posList.1 hj.1, hj.2⟩

variable [DecidableEq J]

/-- One descending step: if `U_{≥m+1}` consists of ordered products, so does `U_{≥m}`. -/
theorem opGe_step {m : ℤ} (hm : 1 ≤ m)
    (ih : ∀ u ∈ D.rootsSub K (D.posGe (m + 1)), ∃ c : J → K, u = D.opGe (m + 1) c) :
    ∀ u ∈ D.rootsSub K (D.posGe m), ∃ c : J → K, u = D.opGe m c := by
  set L₁ := D.posList.filter fun j => decide (D.ℓ (P.root j) = m) with hL₁
  have hL₁nd : L₁.Nodup := D.posList_nodup.filter _
  have hL₁mem : ∀ j ∈ L₁, b.IsPos j ∧ D.ℓ (P.root j) = m := by
    intro j hj
    rw [hL₁, List.mem_filter, decide_eq_true_eq] at hj
    exact ⟨D.mem_posList.1 hj.1, hj.2⟩
  -- gluing coefficients of level `m` and of level `≥ m+1`
  have glue : ∀ c' c'' : J → K, ∃ c₃ : J → K,
      D.orderedProd L₁ c₃ = D.orderedProd L₁ c' ∧ D.opGe (m + 1) c₃ = D.opGe (m + 1) c'' := by
    intro c' c''
    refine ⟨fun j => if D.ℓ (P.root j) = m then c' j else c'' j, ?_, ?_⟩
    · exact D.orderedProd_congr fun j hj => by rw [ite_eq_left_iff.2 fun h => absurd (hL₁mem j hj).2 h]
    · refine D.orderedProd_congr fun j hj => ?_
      rw [List.mem_filter, decide_eq_true_eq] at hj
      exact ite_eq_right (by omega)
  -- left multiplication by a generator
  have step : ∀ δ ∈ D.posGe m, ∀ (s : K) (c : J → K), ∃ c₃ : J → K,
      D.x δ s * D.opGe m c = D.opGe m c₃ := by
    intro δ hδ s c
    rw [D.opGe_eq m c, ← hL₁]
    rcases eq_or_lt_of_le hδ.2 with hlev | hlev
    · have hδL : δ ∈ L₁ := by
        rw [hL₁, List.mem_filter, decide_eq_true_eq]
        exact ⟨D.mem_posList.2 hδ.1, hlev.symm⟩
      obtain ⟨w, hw, hstep⟩ := D.level_step hm L₁ hL₁nd hL₁mem hδL s c
      obtain ⟨c'', hc''⟩ := ih (w * D.opGe (m + 1) c)
        ((D.rootsSub K _).mul_mem hw (D.opGe_mem _ _))
      obtain ⟨c₃, h1, h2⟩ := glue (Function.update c δ (c δ + s)) c''
      refine ⟨c₃, ?_⟩
      rw [D.opGe_eq m c₃, ← hL₁, h1, h2, ← hc'', ← mul_assoc, hstep, mul_assoc]
    · have hmem : D.x δ s ∈ D.rootsSub K (D.posGe (m + 1)) :=
        rootSub_le_rootsSub (show δ ∈ D.posGe (m + 1) from ⟨hδ.1, by omega⟩) (x_mem_rootSub _ _)
      have hP₁ : D.orderedProd L₁ c ∈ D.posSub K :=
        D.orderedProd_mem_rootsSub (fun j hj => (hL₁mem j hj).1) c
      obtain ⟨c'', hc''⟩ := ih ((D.orderedProd L₁ c)⁻¹ * D.x δ s * D.orderedProd L₁ c *
        D.opGe (m + 1) c) ((D.rootsSub K _).mul_mem (D.inv_conj_mem_posGe hP₁ _ hmem)
          (D.opGe_mem _ _))
      obtain ⟨c₃, h1, h2⟩ := glue c c''
      refine ⟨c₃, ?_⟩
      rw [D.opGe_eq m c₃, ← hL₁, h1, h2, ← hc'']
      group
  intro u hu
  induction hu using Subgroup.closure_induction_left with
  | one => exact ⟨0, by rw [opGe, orderedProd_zero]⟩
  | mul_left x hx y _ hy =>
    obtain ⟨δ, hδ, hx⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨s, rfl⟩ := mem_rootSub.1 hx
    obtain ⟨c, rfl⟩ := hy
    exact step δ hδ s c
  | inv_mul_cancel x hx y _ hy =>
    obtain ⟨δ, hδ, hx⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨s, rfl⟩ := mem_rootSub.1 hx
    obtain ⟨c, rfl⟩ := hy
    rw [← x_neg]
    exact step δ hδ (-s) c

/-- **`U⁺` is the ordered product of the positive root groups** (Steinberg, *Lectures*, §3,
Lemma 17): every element of `U⁺(K)` is `∏_{γ ∈ posList} x_γ(c γ)`. -/
theorem exists_orderedProd_of_mem_posSub {u : GL (Fin D.n) K} (hu : u ∈ D.posSub K) :
    ∃ c : J → K, u = D.orderedProd D.posList c := by
  set M : ℕ := Finset.univ.sup fun j => (D.ℓ (P.root j)).toNat with hM
  have hbound : ∀ j, D.ℓ (P.root j) ≤ M := fun j => by
    have h1 : (D.ℓ (P.root j)).toNat ≤ M :=
      Finset.le_sup (f := fun j => (D.ℓ (P.root j)).toNat) (Finset.mem_univ j)
    have h2 := Int.self_le_toNat (D.ℓ (P.root j))
    omega
  have key : ∀ t : ℕ, t ≤ M → ∀ v ∈ D.rootsSub K (D.posGe ((M : ℤ) + 1 - t)), ∃ c : J → K,
      v = D.opGe ((M : ℤ) + 1 - t) c := by
    intro t
    induction t with
    | zero =>
      intro _ v hv
      have hempty : D.posGe ((M : ℤ) + 1 - (0 : ℕ)) = ∅ := by
        ext j
        simp only [posGe, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_and]
        intro _ h
        have := hbound j
        push_cast at h
        omega
      rw [rootsSub, hempty] at hv
      simp only [Set.mem_empty_iff_false, Set.iUnion_of_empty, Set.iUnion_empty,
        Subgroup.closure_empty, Subgroup.mem_bot] at hv
      exact ⟨0, by rw [hv, opGe, orderedProd_zero]⟩
    | succ t ih =>
      intro ht
      have hm : (1 : ℤ) ≤ (M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) := by push_cast; omega
      have ih' : ∀ v ∈ D.rootsSub K (D.posGe ((M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) + 1)),
          ∃ c : J → K, v = D.opGe ((M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) + 1) c := by
        have e : (M : ℤ) + 1 - ((t + 1 : ℕ) : ℤ) + 1 = (M : ℤ) + 1 - (t : ℤ) := by
          push_cast; ring
        rw [e]
        exact ih (by omega)
      exact D.opGe_step hm ih'
  have e1 : (M : ℤ) + 1 - (M : ℕ) = 1 := by ring
  have hpos : D.posGe 1 = {j | b.IsPos j} := by
    ext j
    simp only [posGe, Set.mem_ofPred_eq]
    exact ⟨fun h => h.1, fun h => ⟨h, D.ℓ_root_pos h⟩⟩
  obtain ⟨c, hc⟩ := key M le_rfl u (by rw [e1, hpos]; exact hu)
  refine ⟨c, hc.trans ?_⟩
  rw [e1, opGe]
  congr 1
  rw [List.filter_eq_self]
  intro j hj
  have := D.ℓ_root_pos (D.mem_posList.1 hj)
  simp only [decide_eq_true_eq]
  omega

end PosList

end ChevalleyData

