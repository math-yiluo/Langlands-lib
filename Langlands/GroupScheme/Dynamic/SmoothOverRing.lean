import Langlands.GroupScheme.Dynamic.SmoothProof

/-! # Smoothness of dynamic subgroups over an arbitrary base ring -/

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry Opposite
open scoped CategoryTheory.MonObj

namespace Langlands.CommutativeAlgebra.GradedFormallySmooth

open Langlands.GroupScheme.AffineLine

section FG

variable {B : Type v} [CommRing B]

/-- A Laurent polynomial is a polynomial exactly when its coefficients of negative degree
vanish. -/
theorem mem_range_toLaurent_iff {A : Type v} [CommRing A] (q : LaurentPolynomial A) :
    q ∈ (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A).range ↔
      ∀ n < 0, q.coeff n = 0 := by
  constructor
  · rintro ⟨p, rfl⟩ n hn
    exact coeff_toLaurent_of_neg p hn
  · intro h
    exact ⟨_, toLaurent_trunc h⟩

/-- The Laurent polynomials whose coefficients of negative degree lie in `J`. -/
def nonnegMod (J : Ideal B) : Subring (LaurentPolynomial B) :=
  (Polynomial.toLaurent : Polynomial (B ⧸ J) →+* LaurentPolynomial (B ⧸ J)).range.comap
    (AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk J))

theorem mem_nonnegMod {J : Ideal B} {q : LaurentPolynomial B} :
    q ∈ nonnegMod J ↔ ∀ n < 0, q.coeff n ∈ J := by
  rw [nonnegMod, Subring.mem_comap, mem_range_toLaurent_iff]
  simp only [AddMonoidAlgebra.coeff_mapRingHom, Ideal.Quotient.eq_zero_iff_mem]

theorem mapRingHom_eq_C_iff {J : Ideal B} {q : LaurentPolynomial B} {b : B} :
    AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk J) q =
        LaurentPolynomial.C (Ideal.Quotient.mk J b) ↔
      ∀ n, (q - LaurentPolynomial.C b).coeff n ∈ J := by
  have key (n : ℤ) : (AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk J) q).coeff n =
      (LaurentPolynomial.C (Ideal.Quotient.mk J b)).coeff n ↔
        (q - LaurentPolynomial.C b).coeff n ∈ J := by
    rw [AddMonoidAlgebra.coeff_mapRingHom, LaurentPolynomial.C_apply, AddMonoidAlgebra.coeff_sub,
      Finsupp.sub_apply, LaurentPolynomial.C_apply, ← Ideal.Quotient.eq]
    split_ifs <;> simp
  constructor
  · intro h n
    exact (key n).1 (congrArg (fun p => p.coeff n) h)
  · intro h
    exact LaurentPolynomial.ext fun n => (key n).2 (h n)

variable {R : Type u} [CommRing R] [Algebra R B] (c : B →+* LaurentPolynomial B)

/-- The coefficients of negative degree of the values of `c` on a finite set. -/
def negCoeffs (s : Finset B) : Set B :=
  ⋃ x ∈ (s : Set B), (fun n => (c x).coeff n) '' {n | n < 0 ∧ n ∈ (c x).coeff.support}

theorem negCoeffs_finite (s : Finset B) : (negCoeffs c s).Finite :=
  Set.Finite.biUnion s.finite_toSet fun x _ =>
    ((c x).coeff.support.finite_toSet.subset fun _ hn => hn.2).image _

theorem coeff_mem_span_negCoeffs {s : Finset B} {x : B} (hx : x ∈ s) {n : ℤ} (hn : n < 0) :
    (c x).coeff n ∈ Ideal.span (negCoeffs c s) := by
  by_cases h : (c x).coeff n = 0
  · rw [h]
    exact Ideal.zero_mem _
  · exact Ideal.subset_span (Set.mem_biUnion hx ⟨n, ⟨hn, Finsupp.mem_support_iff.2 h⟩, rfl⟩)

theorem negCoeffs_subset (s : Finset B) :
    negCoeffs c s ⊆ {d | ∃ b, ∃ n < 0, (c b).coeff n = d} := by
  intro d hd
  obtain ⟨x, -, hd'⟩ := Set.mem_iUnion₂.1 hd
  obtain ⟨n, ⟨hn, -⟩, rfl⟩ := hd'
  exact ⟨x, n, hn, rfl⟩

/-- The coefficients of the values of `b ↦ c b - b` on a finite set. -/
def offCoeffs (s : Finset B) : Set B :=
  ⋃ x ∈ (s : Set B), (fun n => (c x - LaurentPolynomial.C x).coeff n) ''
    {n | n ∈ (c x - LaurentPolynomial.C x).coeff.support}

theorem offCoeffs_finite (s : Finset B) : (offCoeffs c s).Finite :=
  Set.Finite.biUnion s.finite_toSet fun x _ =>
    ((c x - LaurentPolynomial.C x).coeff.support.finite_toSet.subset fun _ hn => hn).image _

theorem coeff_mem_span_offCoeffs {s : Finset B} {x : B} (hx : x ∈ s) (n : ℤ) :
    (c x - LaurentPolynomial.C x).coeff n ∈ Ideal.span (offCoeffs c s) := by
  by_cases h : (c x - LaurentPolynomial.C x).coeff n = 0
  · rw [h]
    exact Ideal.zero_mem _
  · exact Ideal.subset_span (Set.mem_biUnion hx ⟨n, Finsupp.mem_support_iff.2 h, rfl⟩)

/-- For a finitely generated algebra, the ideal generated by the coefficients of negative degree
is generated by those of finitely many generators. -/
theorem negIdeal_fg [Algebra.FiniteType R B]
    (hR : ∀ r : R, c (algebraMap R B r) = LaurentPolynomial.C (algebraMap R B r)) :
    (negIdeal c).FG := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := B)
  set J := Ideal.span (negCoeffs c s)
  let S : Subalgebra R B :=
    { ((nonnegMod J).comap c).toSubsemiring with
      algebraMap_mem' := fun r => by
        change c (algebraMap R B r) ∈ nonnegMod J
        rw [hR, mem_nonnegMod]
        intro n hn
        simp only [LaurentPolynomial.C_apply, hn.ne, ↓reduceIte]
        exact J.zero_mem }
  have hS (b : B) : ∀ n < 0, (c b).coeff n ∈ J := by
    have hb : b ∈ Algebra.adjoin R (s : Set B) := by
      rw [hs]
      exact Algebra.mem_top
    exact mem_nonnegMod.1 (Algebra.adjoin_le (S := S)
      (fun x hx => mem_nonnegMod.2 fun n hn => coeff_mem_span_negCoeffs c hx hn) hb)
  have heq : negIdeal c = J := by
    apply le_antisymm
    · exact Ideal.span_le.2 (by rintro d ⟨b, n, hn, rfl⟩; exact hS b n hn)
    · exact Ideal.span_mono (negCoeffs_subset c s)
  rw [heq]
  exact ⟨(negCoeffs_finite c s).toFinset, by rw [Set.Finite.coe_toFinset]⟩

/-- For a finitely generated algebra, the ideal generated by the coefficients of `c b - b` is
generated by those of finitely many generators. -/
theorem offIdeal_fg [Algebra.FiniteType R B]
    (hR : ∀ r : R, c (algebraMap R B r) = LaurentPolynomial.C (algebraMap R B r)) :
    (offIdeal c).FG := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := B)
  set J := Ideal.span (offCoeffs c s)
  let S : Subalgebra R B :=
    { (RingHom.eqLocus ((AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk J)).comp c)
        (LaurentPolynomial.C.comp (Ideal.Quotient.mk J))).toSubsemiring with
      algebraMap_mem' := fun r => by
        change AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk J) (c (algebraMap R B r)) =
          LaurentPolynomial.C (Ideal.Quotient.mk J (algebraMap R B r))
        rw [mapRingHom_eq_C_iff, hR, sub_self]
        intro n
        exact J.zero_mem }
  have hS (b : B) : ∀ n, (c b - LaurentPolynomial.C b).coeff n ∈ J := by
    have hb : b ∈ Algebra.adjoin R (s : Set B) := by
      rw [hs]
      exact Algebra.mem_top
    exact mapRingHom_eq_C_iff.1 (Algebra.adjoin_le (S := S)
      (fun x hx => mapRingHom_eq_C_iff.2 fun n => coeff_mem_span_offCoeffs c hx n) hb)
  have heq : offIdeal c = J := by
    apply le_antisymm
    · exact Ideal.span_le.2 (by rintro d ⟨b, n, rfl⟩; exact hS b n)
    · apply Ideal.span_mono
      intro d hd
      obtain ⟨x, -, hd'⟩ := Set.mem_iUnion₂.1 hd
      obtain ⟨n, -, rfl⟩ := hd'
      exact ⟨x, n, rfl⟩
  rw [heq]
  exact ⟨(offCoeffs_finite c s).toFinset, by rw [Set.Finite.coe_toFinset]⟩

/-- The ideal generated by the coefficients of negative degree of the values of `c` and by the
differences `c(b)₀ - ε(b)`. -/
def unipIdeal (ε : B →+* B) : Ideal B :=
  Ideal.span ({d | ∃ b, ∃ n < 0, (c b).coeff n = d} ∪ {d | ∃ b, (c b).coeff 0 - ε b = d})

/-- Constant coefficients of values in `nonnegMod J` are multiplicative modulo `J`. -/
theorem coeff_zero_mul_mod {J : Ideal B} {q q' : LaurentPolynomial B} (hq : q ∈ nonnegMod J)
    (hq' : q' ∈ nonnegMod J) :
    Ideal.Quotient.mk J ((q * q').coeff 0) =
      Ideal.Quotient.mk J (q.coeff 0) * Ideal.Quotient.mk J (q'.coeff 0) := by
  obtain ⟨p, hp⟩ := hq
  obtain ⟨p', hp'⟩ := hq'
  have h0 (r : LaurentPolynomial B) :
      Ideal.Quotient.mk J (r.coeff 0) =
        (AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk J) r).coeff 0 :=
    (AddMonoidAlgebra.coeff_mapRingHom _ r 0).symm
  rw [h0, h0 q, h0 q', map_mul, ← hp, ← hp', ← map_mul]
  have h (r : Polynomial (B ⧸ J)) : (Polynomial.toLaurent r).coeff 0 = r.coeff 0 :=
    coeff_toLaurent_natCast r 0
  rw [h, h, h, Polynomial.mul_coeff_zero]

theorem unipIdeal_fg [Algebra.FiniteType R B] (ε : B →+* B)
    (hR : ∀ r : R, c (algebraMap R B r) = LaurentPolynomial.C (algebraMap R B r))
    (hε : ∀ r : R, ε (algebraMap R B r) = algebraMap R B r) :
    (unipIdeal c ε).FG := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := B)
  let gens : Set B := negCoeffs c s ∪ (fun x => (c x).coeff 0 - ε x) '' (s : Set B)
  have hfin : gens.Finite := (negCoeffs_finite c s).union (s.finite_toSet.image _)
  set J := Ideal.span gens
  have hJ : Ideal.span (negCoeffs c s) ≤ J := Ideal.span_mono Set.subset_union_left
  let S : Subalgebra R B :=
    { carrier := {b | c b ∈ nonnegMod J ∧ (c b).coeff 0 - ε b ∈ J}
      mul_mem' := by
        rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
        refine ⟨by rw [map_mul]; exact Subring.mul_mem _ ha hb, ?_⟩
        rw [← Ideal.Quotient.eq] at ha' hb' ⊢
        rw [map_mul, coeff_zero_mul_mod ha hb, ha', hb', map_mul, map_mul]
      one_mem' := by
        refine ⟨by rw [map_one]; exact Subring.one_mem _, ?_⟩
        have h1 : (c 1).coeff 0 - ε 1 = 0 := by
          rw [map_one, map_one, ← map_one (LaurentPolynomial.C (R := B)),
            LaurentPolynomial.C_apply]
          simp
        rw [h1]
        exact J.zero_mem
      add_mem' := by
        rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
        refine ⟨by rw [map_add]; exact Subring.add_mem _ ha hb, ?_⟩
        rw [map_add, map_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply,
          add_sub_add_comm]
        exact J.add_mem ha' hb'
      zero_mem' := by
        refine ⟨by rw [map_zero]; exact Subring.zero_mem _, ?_⟩
        have h0 : (c 0).coeff 0 - ε 0 = 0 := by simp
        rw [h0]
        exact J.zero_mem
      algebraMap_mem' := fun r => by
        refine ⟨?_, ?_⟩
        · rw [hR, mem_nonnegMod]
          intro n hn
          simp only [LaurentPolynomial.C_apply, hn.ne, ↓reduceIte]
          exact J.zero_mem
        · have h : (c (algebraMap R B r)).coeff 0 - ε (algebraMap R B r) = 0 := by
            rw [hR, hε, LaurentPolynomial.C_apply]
            simp
          rw [h]
          exact J.zero_mem }
  have hS (b : B) : b ∈ S := by
    have hb : b ∈ Algebra.adjoin R (s : Set B) := by
      rw [hs]
      exact Algebra.mem_top
    refine Algebra.adjoin_le (S := S) (fun x hx => ⟨?_, ?_⟩) hb
    · exact mem_nonnegMod.2 fun n hn => hJ (coeff_mem_span_negCoeffs c hx hn)
    · exact Ideal.subset_span (Set.mem_union_right _ ⟨x, hx, rfl⟩)
  have heq : unipIdeal c ε = J := by
    apply le_antisymm
    · refine Ideal.span_le.2 ?_
      rintro d (⟨b, n, hn, rfl⟩ | ⟨b, rfl⟩)
      · exact mem_nonnegMod.1 (hS b).1 n hn
      · exact (hS b).2
    · apply Ideal.span_mono
      rintro d (hd | ⟨x, -, rfl⟩)
      · exact Or.inl (negCoeffs_subset c s hd)
      · exact Or.inr ⟨x, rfl⟩
  rw [heq]
  exact ⟨hfin.toFinset, by rw [Set.Finite.coe_toFinset]⟩

end FG

end Langlands.CommutativeAlgebra.GradedFormallySmooth

namespace Langlands.GroupScheme

namespace DynamicSmoothRing

open CommutativeAlgebra.GradedFormallySmooth DynamicSmooth

variable {R : CommRingCat.{u}}

/-- A formally smooth quotient of a smooth algebra by a finitely generated ideal is smooth. -/
theorem smooth_quotient_of_fg {B : CommAlgCat.{u} R} [Algebra.Smooth R B] {I : Ideal B}
    (hI : I.FG) (h : Algebra.FormallySmooth R (B ⧸ I)) : Algebra.Smooth R (B ⧸ I) where
  formallySmooth := h
  finitePresentation := Algebra.FinitePresentation.quotient hI

section Corepresented

variable {F : CommAlgCat.{u} R ⥤ GrpCat.{u}} {B : CommAlgCat.{u} R}
  {e : (F ⋙ forget GrpCat).CorepresentableBy B} [Algebra.Smooth R B]
  (χ : (Gm (Spec R)).toGrp ⟶ Corepresented.groupScheme F e)

theorem parabolicIdeal_fg : (Corepresented.parabolicIdeal χ).FG :=
  negIdeal_fg (R := R) (Corepresented.coaction χ).hom (Corepresented.coaction_algebraMap χ)

theorem centralizerIdeal_fg : (Corepresented.centralizerIdeal χ).FG :=
  offIdeal_fg (R := R) (Corepresented.coaction χ).hom (Corepresented.coaction_algebraMap χ)

omit [Algebra.Smooth R B] in
theorem counit_algebraMap (r : R) :
    (Corepresented.counit e).hom (algebraMap R B r) = r := by
  have h := Corepresented.algebraMap_comp_pointRing (e := e) (f := 𝟙 (Spec R))
    (1 : Over.mk (𝟙 (Spec R)) ⟶ (Corepresented.groupScheme F e).X)
  rw [Spec.preimage_id] at h
  exact congrArg (fun φ => φ.hom r) h

theorem unipotentIdeal_fg : (Corepresented.unipotentIdeal χ).FG :=
  unipIdeal_fg (R := R) (Corepresented.coaction χ).hom
    ((algebraMap R B).comp (Corepresented.counit e).hom) (Corepresented.coaction_algebraMap χ)
    (fun r => by
      change algebraMap R B ((Corepresented.counit e).hom (algebraMap R B r)) = _
      rw [counit_algebraMap])

/-- The constructed dynamic parabolic `P_G(χ)` is smooth, over any base ring. -/
theorem smooth_parabolicScheme : Smooth (Corepresented.parabolicScheme χ).X.hom :=
  (smooth_algSpec_iff (Corepresented.quotientAlgebra (Corepresented.parabolicIdeal χ))).2
    (smooth_quotient_of_fg (parabolicIdeal_fg χ) (formallySmooth_parabolic χ))

/-- The constructed centralizer `Z_G(χ)` is smooth, over any base ring. -/
theorem smooth_centralizerScheme : Smooth (Corepresented.centralizerScheme χ).X.hom :=
  (smooth_algSpec_iff (Corepresented.quotientAlgebra (Corepresented.centralizerIdeal χ))).2
    (smooth_quotient_of_fg (centralizerIdeal_fg χ) (formallySmooth_centralizer χ))

/-- The constructed dynamic unipotent subgroup `U_G(χ)` is smooth, over any base ring. -/
theorem smooth_unipotentScheme : Smooth (Corepresented.unipotentScheme χ).X.hom := by
  have : Algebra.FormallySmooth R (B ⧸ Corepresented.parabolicIdeal χ) :=
    formallySmooth_parabolic χ
  have hU : Algebra.FormallySmooth R (B ⧸ Corepresented.unipotentIdeal χ) :=
    formallySmooth_of_algSpec_retract
      (A := Corepresented.quotientAlgebra (Corepresented.parabolicIdeal χ))
      (A' := Corepresented.quotientAlgebra (Corepresented.unipotentIdeal χ))
      (lift (𝟙 _) 1 ≫ (Corepresented.multiplicationIso χ).hom)
      ((Corepresented.multiplicationIso χ).inv ≫ fst _ _)
      (lift_comp_hom_comp_inv_comp_fst 1 (Corepresented.multiplicationIso χ))
  exact (smooth_algSpec_iff (Corepresented.quotientAlgebra (Corepresented.unipotentIdeal χ))).2
    (smooth_quotient_of_fg (unipotentIdeal_fg χ) hU)

end Corepresented

end DynamicSmoothRing

open DynamicSmoothRing DynamicSmooth in
/-- **Smoothness of dynamic subgroups over a ring.** For a smooth affine group scheme `G` over
an arbitrary commutative ring `R` and a cocharacter `χ`, every representative of `P_G(χ)`,
`Z_G(χ)` or `U_G(χ)` is smooth over `R`. -/
theorem dynamicSmooth_ring (R : Type u) [CommRing R] (G : GroupScheme (Spec (CommRingCat.of R)))
    [Smooth G.X.hom] [IsAffineHom G.X.hom] (χ : (Gm (Spec (CommRingCat.of R))).toGrp ⟶ G)
    (H : GroupScheme (Spec (CommRingCat.of R))) (j : H ⟶ G) :
    ((Dynamic.parabolic χ).IsRepresentedBy j → Smooth H.X.hom) ∧
    ((Dynamic.centralizer χ).IsRepresentedBy j → Smooth H.X.hom) ∧
    ((Dynamic.unipotent χ).IsRepresentedBy j → Smooth H.X.hom) := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have hB : Algebra.Smooth (CommRingCat.of R) (AffineCoordinates.algebra G) :=
    (smooth_algSpec_iff (AffineCoordinates.algebra G)).1
      (smooth_of_over_iso ((Grp.forget _).mapIso (AffineCoordinates.groupSchemeIso G))
        (inferInstance : Smooth G.X.hom))
  refine ⟨fun hj => ?_, fun hj => ?_, fun hj => ?_⟩
  · exact smooth_of_over_iso
      ((Grp.forget _).mapIso
        (hj.isoOfIsRepresentedBy (Dynamic.Affine.isRepresentedBy_parabolicHom χ)))
      (smooth_parabolicScheme (Dynamic.Affine.cocharacter χ))
  · exact smooth_of_over_iso
      ((Grp.forget _).mapIso
        (hj.isoOfIsRepresentedBy (Dynamic.Affine.isRepresentedBy_centralizerHom χ)))
      (smooth_centralizerScheme (Dynamic.Affine.cocharacter χ))
  · exact smooth_of_over_iso
      ((Grp.forget _).mapIso
        (hj.isoOfIsRepresentedBy (Dynamic.Affine.isRepresentedBy_unipotentHom χ)))
      (smooth_unipotentScheme (Dynamic.Affine.cocharacter χ))

end Langlands.GroupScheme
