import Langlands.GroupScheme.Dynamic.RingPointCoordinates
import Langlands.GroupScheme.Dynamic.CoactionGrading
import Langlands.GroupScheme.Dynamic.DominantCombinationInclusions
import Langlands.CommutativeAlgebra.GradedLineLocal

/-! # The grading of the coordinate ring of a dynamic unipotent subgroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.Corepresented

open CommutativeAlgebra

variable {R : CommRingCat.{u}} {F : CommAlgCat.{u} R ⥤ GrpCat.{u}} {B : CommAlgCat.{u} R}
  {e : (F ⋙ forget GrpCat).CorepresentableBy B} (χ : (Gm (Spec R)).toGrp ⟶ groupScheme F e)

/-- The quotient map `B → B ⧸ J` onto the coordinate ring of `U_G(χ)`. -/
abbrev unipQuot : B →+* B ⧸ unipotentIdeal χ := Ideal.Quotient.mk (unipotentIdeal χ)

/-- The coaction followed by reduction of coefficients modulo `J`. -/
abbrev reducedCoaction : B →+* LaurentPolynomial (B ⧸ unipotentIdeal χ) :=
  (AddMonoidAlgebra.mapRingHom ℤ (unipQuot χ)).comp (coaction χ).hom

theorem reducedCoaction_of_homogeneous {d : B} {n : ℤ}
    (hd : (coaction χ).hom d = AddMonoidAlgebra.single n d) (hJ : d ∈ unipotentIdeal χ) :
    reducedCoaction χ d = 0 := by
  rw [RingHom.comp_apply, hd, AddMonoidAlgebra.mapRingHom_single,
    Ideal.Quotient.eq_zero_iff_mem.2 hJ, AddMonoidAlgebra.single_zero]

/-- The unipotent ideal is generated by homogeneous elements, so the coaction descends. -/
theorem unipotentIdeal_le_ker : unipotentIdeal χ ≤ RingHom.ker (reducedCoaction χ) := by
  refine Ideal.span_le.2 ?_
  rintro d (⟨b, n, hn, rfl⟩ | ⟨b, rfl⟩)
  · exact reducedCoaction_of_homogeneous χ (coaction_coeff_coaction χ b n)
      (Ideal.subset_span (Or.inl ⟨b, n, hn, rfl⟩))
  · refine reducedCoaction_of_homogeneous χ (n := 0) ?_
      (Ideal.subset_span (Or.inr ⟨b, rfl⟩))
    rw [map_sub, coaction_coeff_coaction, coaction_algebraMap, ← LaurentPolynomial.single_eq_C,
      ← AddMonoidAlgebra.single_sub]

/-- The grading of the coordinate ring `B ⧸ J` of `U_G(χ)`. -/
def unipCoaction : B ⧸ unipotentIdeal χ →+* LaurentPolynomial (B ⧸ unipotentIdeal χ) :=
  Ideal.Quotient.lift _ (reducedCoaction χ) fun _ hb => unipotentIdeal_le_ker χ hb

theorem unipCoaction_mk (b : B) :
    unipCoaction χ (unipQuot χ b) =
      AddMonoidAlgebra.mapRingHom ℤ (unipQuot χ) ((coaction χ).hom b) :=
  Ideal.Quotient.lift_mk _ _ _

theorem coeff_unipCoaction_mk (b : B) (n : ℤ) :
    (unipCoaction χ (unipQuot χ b)).coeff n = unipQuot χ (((coaction χ).hom b).coeff n) := by
  rw [unipCoaction_mk, AddMonoidAlgebra.coeff_mapRingHom]

theorem isGrading_unipCoaction : GradedLine.IsGrading R (unipCoaction χ) where
  map_algebraMap r := by
    change unipCoaction χ (unipQuot χ (algebraMap R B r)) = _
    rw [unipCoaction_mk, coaction_algebraMap, ← LaurentPolynomial.single_eq_C,
      AddMonoidAlgebra.mapRingHom_single, LaurentPolynomial.single_eq_C]
    rfl
  sum_coeff a := by
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [unipCoaction_mk]
    have h := sum_coeff_coaction χ b
    conv_rhs => rw [← h]
    simp only [Finsupp.sum]
    rw [map_sum]
    have hsub : (AddMonoidAlgebra.mapRingHom ℤ (unipQuot χ) ((coaction χ).hom b)).coeff.support ⊆
        ((coaction χ).hom b).coeff.support := by
      intro n hn
      rw [Finsupp.mem_support_iff] at hn ⊢
      intro h0
      apply hn
      rw [AddMonoidAlgebra.coeff_mapRingHom, h0, map_zero]
    rw [Finset.sum_subset hsub fun n _ hn => Finsupp.notMem_support_iff.1 hn]
    exact Finset.sum_congr rfl fun n _ => AddMonoidAlgebra.coeff_mapRingHom _ _ _
  coeff_coeff a n := by
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [coeff_unipCoaction_mk, unipCoaction_mk, coaction_coeff_coaction,
      AddMonoidAlgebra.mapRingHom_single]

theorem unipCoaction_coeff_neg (a : B ⧸ unipotentIdeal χ) {n : ℤ} (hn : n < 0) :
    (unipCoaction χ a).coeff n = 0 := by
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [coeff_unipCoaction_mk, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Or.inl ⟨b, n, hn, rfl⟩)

theorem unipCoaction_coeff_zero (a : B ⧸ unipotentIdeal χ) :
    (unipCoaction χ a).coeff 0 ∈ Set.range (algebraMap R (B ⧸ unipotentIdeal χ)) := by
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
  refine ⟨counit e b, ?_⟩
  rw [coeff_unipCoaction_mk]
  change unipQuot χ (algebraMap R B (counit e b)) = _
  rw [eq_comm, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Or.inr ⟨b, rfl⟩)

/-! ### Points of the unipotent subgroup -/

theorem pointRing_unipotentHom {A : CommRingCat.{u}} {f : Spec A ⟶ Spec R}
    (y : Over.mk f ⟶ (unipotentScheme χ).X) :
    pointRing (y ≫ (unipotentHom χ).hom.hom) =
      CommRingCat.ofHom (unipQuot χ) ≫ pointRing y := by
  apply Spec.map_injective
  rw [specMap_pointRing, Spec.map_comp, specMap_pointRing, Over.comp_left, cutHom_left]
  rfl

/-! ### The scaling identity -/

section Scaling

variable (D : Type u) [CommRing D]

/-- The unit `T` of the Laurent polynomial ring. -/
def unitT : (LaurentPolynomial D)ˣ where
  val := LaurentPolynomial.T 1
  inv := LaurentPolynomial.T (-1)
  val_inv := by rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero]
  inv_val := by rw [← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero]

theorem unitT_zpow (n : ℤ) : ((unitT D ^ n : (LaurentPolynomial D)ˣ) : LaurentPolynomial D) =
    LaurentPolynomial.T n := by
  induction n using Int.induction_on with
  | zero => rw [zpow_zero, Units.val_one, LaurentPolynomial.T_zero]
  | succ n ih =>
    rw [zpow_add_one, Units.val_mul, ih]
    change _ * LaurentPolynomial.T 1 = _
    rw [← LaurentPolynomial.T_add]
  | pred n ih =>
    rw [zpow_sub_one, Units.val_mul, ih]
    change _ * LaurentPolynomial.T (-1) = _
    rw [← LaurentPolynomial.T_add, sub_eq_add_neg]

variable {D} {B' : Type u} [CommRing B']

/-- Evaluating at `T` after embedding coefficients as constants recovers the Laurent
polynomial. -/
theorem eval₂_T_mapRingHom (g : B' →+* D) (q : LaurentPolynomial B') :
    LaurentPolynomial.eval₂ (RingHom.id (LaurentPolynomial D)) (unitT D)
        (AddMonoidAlgebra.mapRingHom ℤ (LaurentPolynomial.C.comp g) q) =
      AddMonoidAlgebra.mapRingHom ℤ g q := by
  induction q using AddMonoidAlgebra.induction_linear with
  | zero => rw [map_zero, map_zero, map_zero]
  | add p q hp hq => rw [map_add, map_add, hp, hq, map_add]
  | single n b =>
    rw [AddMonoidAlgebra.mapRingHom_single, AddMonoidAlgebra.mapRingHom_single,
      LaurentPolynomial.single_eq_C_mul_T, LaurentPolynomial.eval₂_C_mul_T, RingHom.id_apply,
      unitT_zpow, RingHom.comp_apply, ← LaurentPolynomial.single_eq_C_mul_T]

end Scaling

section ScalingIdentity

open Polynomial AffineLine

variable {K : Type u} [Field K] [Algebra R K]

/-- The constant inclusion `K[X] → K[X][T, T⁻¹]`, as an `R`-algebra map. -/
def constIncl : K[X] →ₐ[R] LaurentPolynomial K[X] :=
  (Algebra.ofId K[X] (LaurentPolynomial K[X])).restrictScalars R

theorem constIncl_apply (p : K[X]) : constIncl (R := R) p = LaurentPolynomial.C p := rfl

/-- **The scaling identity from equivariance.** If conjugating the pullback of a point `y₀` of
`U_G(χ)` over `K[X]` by `χ(T)` gives a point `y₁` classified by `y₀` followed by
`X ↦ T^m X`, then the classifying map of `y₀` intertwines the grading with this scaling. -/
theorem scaling_of_conj (m : ℕ) (y₀ : RingCoordinates.specOver R K[X] ⟶ (unipotentScheme χ).X)
    (y₁ : RingCoordinates.specOver R (LaurentPolynomial K[X]) ⟶ (unipotentScheme χ).X)
    (h₁ : RingCoordinates.algHom y₁ = ((aeval (LaurentPolynomial.T (m : ℤ) * LaurentPolynomial.C X :
      LaurentPolynomial K[X])).restrictScalars R).comp (RingCoordinates.algHom y₀))
    (hconj : (unitPoint (Spec.map (CommRingCat.ofHom (algebraMap R (LaurentPolynomial K[X]))))
        (unitT K[X]) ≫ χ.hom.hom) *
        ((RingCoordinates.specMapOver (constIncl (R := R)) ≫ y₀) ≫ (unipotentHom χ).hom.hom) *
        (unitPoint (Spec.map (CommRingCat.ofHom (algebraMap R (LaurentPolynomial K[X]))))
          (unitT K[X]) ≫ χ.hom.hom)⁻¹ = y₁ ≫ (unipotentHom χ).hom.hom)
    (a : B ⧸ unipotentIdeal χ) :
    AddMonoidAlgebra.mapRingHom ℤ ((RingCoordinates.algHom y₀ : B ⧸ unipotentIdeal χ →ₐ[R] K[X]) :
        B ⧸ unipotentIdeal χ →+* K[X]) (unipCoaction χ a) =
      aeval (LaurentPolynomial.T (m : ℤ) * LaurentPolynomial.C X : LaurentPolynomial K[X])
        (RingCoordinates.algHom y₀ a) := by
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
  have h := congrArg (fun φ => φ.hom b) (congrArg pointRing hconj)
  simp only at h
  rw [pointRing_conj, pointRing_unipotentHom, pointRing_unipotentHom, RingCoordinates.pointRing_comp] at h
  have h2 : (RingCoordinates.algHom y₁) (unipQuot χ b) = _ := congrArg (fun φ => φ (unipQuot χ b)) h₁
  have hpre : Spec.preimage (RingCoordinates.specMapOver (constIncl (R := R) (K := K))).left =
      CommRingCat.ofHom (constIncl (R := R) (K := K)).toRingHom := Spec.preimage_map _
  rw [hpre] at h
  have hL : LaurentPolynomial.eval₂ (RingHom.id _) (unitT K[X])
      (AddMonoidAlgebra.mapRingHom ℤ (LaurentPolynomial.C.comp
        ((RingCoordinates.algHom y₀ : B ⧸ unipotentIdeal χ →ₐ[R] K[X]).toRingHom.comp (unipQuot χ)))
        ((coaction χ).hom b)) =
      AddMonoidAlgebra.mapRingHom ℤ (RingCoordinates.algHom y₀ : B ⧸ unipotentIdeal χ →ₐ[R] K[X]).toRingHom
        (AddMonoidAlgebra.mapRingHom ℤ (unipQuot χ) ((coaction χ).hom b)) := by
    rw [eval₂_T_mapRingHom, AddMonoidAlgebra.mapRingHom_comp, RingHom.comp_apply]
  rw [unipCoaction_mk]
  refine (hL.symm.trans ?_).trans h2
  exact h

end ScalingIdentity

end Langlands.GroupScheme.Corepresented
