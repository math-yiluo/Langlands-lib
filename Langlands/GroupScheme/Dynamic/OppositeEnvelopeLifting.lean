import Langlands.GroupScheme.Dynamic.OppositeEnvelope
import Langlands.GroupScheme.Rational.TorusGeneratedEnvelopeLifting
import Langlands.GroupScheme.PseudoParabolicDynamicPresentation
import Langlands.GroupScheme.PseudoParabolicRationalLiftingReduction
import Langlands.GroupScheme.PseudoParabolicSplitRadicalProductProof

/-! # Rational lifting through the subgroup generated by `U(χ)`, `χ` and `U(χ⁻¹)` -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace Dynamic

variable {k : Type u} [Field k] [Infinite k] {G P : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]

/-- Over an infinite field, every rational point of a supplied quotient of a smooth
connected affine group by a closed subgroup representing `P(χ)` lifts to a rational
point of the group. -/
theorem rational_lifts_of_infinite (i : P ⟶ G) (hi : IsClosedSubgroup i)
    (χ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G)
    (hχ : SubgroupFunctor.range i = parabolic χ)
    {Q : Over (Spec (CommRingCat.of k))} (q : G.X ⟶ Q)
    [Smooth q.left] [Surjective q.left] [QuasiCompact q.left]
    [IsSeparated Q.hom] [LocallyOfFiniteType Q.hom] [QuasiCompact Q.hom]
    (hfib : ∀ (T : Over (Spec (CommRingCat.of k))) (a b : T ⟶ G.X),
      a ≫ q = b ≫ q ↔ a⁻¹ * b ∈ (SubgroupFunctor.range i).carrier T) :
    ∀ p : RationalPoint k Q, ∃ g : RationalPoint k G.X, g ≫ q = p := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  obtain ⟨D, hD⟩ := OppositeEnvelope.exists_generatedImage χ
  have : Smooth D.group.X.hom := hD.1
  have : IsAffineHom D.group.X.hom := hD.2.1
  have : IsAffine D.group.X.left := isAffine_of_isAffineHom D.group.X.hom
  have : IsClosedImmersion i.hom.hom.left := hi
  have : Mono i.hom.hom := Over.mono_of_mono_left _
  have : IsAffineHom P.X.hom := by
    rw [← Over.w i.hom.hom]
    infer_instance
  have : Smooth P.X.hom := HomogeneousQuotient.smooth_subgroup_of_smooth_quotient G P i q hfib
  have hn : (SubgroupFunctor.range D.inclusion).IsNormalizedBy (SubgroupFunctor.range i) := by
    rw [hχ]
    exact OppositeEnvelope.isNormalizedBy_parabolic D
  have hprod := normalized_subgroup_product_smooth_surjective D.inclusion i χ D.closed hn
    (OppositeEnvelope.reversed_unipotent_le D) (le_of_eq hχ.symm)
  let : Smooth (HomogeneousQuotientRestriction.productMap D.inclusion i).left := hprod.1
  let : Surjective (HomogeneousQuotientRestriction.productMap D.inclusion i).left := hprod.2
  have hχD : SubgroupFunctor.range χ ≤ closedImageEnvelope (OppositeEnvelope.map χ) := by
    rw [← D.represents.2]
    exact OppositeEnvelope.range_cocharacter_le D
  let ψ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ D.group := D.represents.factorHom χ hχD
  have hψ : ψ ≫ D.inclusion = χ := D.represents.factorHom_comp χ hχD
  let j := Affine.parabolicHom ψ
  have hj := Affine.isRepresentedBy_parabolicHom ψ
  have hpre : SubgroupFunctor.range j = (SubgroupFunctor.range i).comap D.inclusion := by
    rw [hj.2, hχ]
    simpa only [hψ] using parabolic_eq_comap_of_isClosedSubgroup ψ D.inclusion D.closed
  let E := HomogeneousQuotientRestriction.restrict D.inclusion i q hfib D.closed j hpre
  let : Smooth E.projection.left := E.smooth_projection
  let : Surjective E.projection.left := E.surjective_projection
  let : QuasiCompact E.projection.left := E.quasiCompact_projection
  intro p
  obtain ⟨d, hd⟩ := rational_lifts_of_dense_parabolic k j ψ hj E.projection E.fibers
    (OppositeEnvelope.hasDenseRationalPoints χ D hD) p
  exact ⟨d ≫ D.inclusion.hom.hom, (Category.assoc _ _ _).trans hd⟩

end Dynamic

namespace OppositeEnvelopeLifting

variable {k : Type u} [Field k]

/-- Over an infinite field, a smooth connected affine group with trivial split
ground-field unipotent radical has the full pseudo-parabolic rational-lifting property. -/
theorem property_of_trivial_split_radical [Infinite k]
    (G : GroupScheme (Spec (CommRingCat.of k)))
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]
    {N : GroupScheme (Spec (CommRingCat.of k))} (n : N ⟶ G)
    (hn : IsSplitUnipotentRadical n) (hzero : SubgroupFunctor.range n = ⊥) :
    PseudoParabolicRationalLiftingProperty G := by
  intro P i hi Q q hsep hlft hqc hsmq hsurjq hqcq hfib x
  let : IsSeparated Q.hom := hsep
  let : LocallyOfFiniteType Q.hom := hlft
  let : QuasiCompact Q.hom := hqc
  let : Smooth q.left := hsmq
  let : Surjective q.left := hsurjq
  let : QuasiCompact q.left := hqcq
  let E := DynamicParabolicPresentation.ofSplitProduct hi n hzero
    (fun U j hj χ T a => pseudoParabolicSplitRadicalProduct k G U N j n hj hn χ T a)
  exact Dynamic.rational_lifts_of_infinite i hi.isClosedSubgroup E.cocharacter E.range_eq q
    hfib x

end OppositeEnvelopeLifting

end Langlands.GroupScheme
