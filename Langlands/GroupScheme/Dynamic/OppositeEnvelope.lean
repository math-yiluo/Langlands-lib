/-! # The closed subgroup generated by `U(χ)`, `χ` and `U(χ⁻¹)` -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace Dynamic

section Product

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {k : Type u} [Field k] {G H P : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]
    [Smooth H.X.hom] [IsAffineHom H.X.hom]
    [Smooth P.X.hom] [IsAffineHom P.X.hom]
    (d : H ⟶ G) (i : P ⟶ G) [Mono i.hom.hom]
    (χ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G)
    (hd : IsClosedSubgroup d)
    (hn : (SubgroupFunctor.range d).IsNormalizedBy (SubgroupFunctor.range i))
    (hU : unipotent (CommGroupScheme.groupHom (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫ χ) ≤
      SubgroupFunctor.range d)
    (hP : parabolic χ ≤ SubgroupFunctor.range i)

include hd hn hU hP in
/-- A closed smooth affine subgroup normalized by a smooth affine subgroup containing
`P(χ)`, and containing `U(χ⁻¹)`, multiplies smoothly and surjectively onto the
connected ambient group. -/
theorem normalized_subgroup_product_smooth_surjective :
    Smooth ((fst H.X P.X ≫ d.hom.hom) * (snd H.X P.X ≫ i.hom.hom)).left ∧
      Surjective ((fst H.X P.X ≫ d.hom.hom) * (snd H.X P.X ≫ i.hom.hom)).left := by
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  let : IsClosedImmersion d.hom.hom.left := hd
  let : Mono d.hom.hom := Over.mono_of_mono_left d.hom.hom
  let a := AutomorphicAction.ofNormalizedConjugation d i hn
  let χopp := CommGroupScheme.groupHom
    (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫ χ
  let U := Affine.unipotentScheme χopp
  let V := Affine.parabolicScheme χ
  have hUrep := Affine.isRepresentedBy_unipotentHom χopp
  have hdrep : (SubgroupFunctor.range d).IsRepresentedBy d := ⟨inferInstance, rfl⟩
  have hUle : SubgroupFunctor.range (Affine.unipotentHom χopp) ≤ SubgroupFunctor.range d := by
    rw [hUrep.2]
    exact hU
  let s : U ⟶ H := hdrep.factorHom (Affine.unipotentHom χopp) hUle
  let t : V ⟶ P :=
    (Affine.isRepresentedBy_parabolicHom χ).lift
      (⟨inferInstance, rfl⟩ : (SubgroupFunctor.range i).IsRepresentedBy i)
      (fun T => Subgroup.inclusion (hP T)) (fun _ _ => rfl)
  have hs : s ≫ d = Affine.unipotentHom χopp := hdrep.factorHom_comp _ hUle
  have ht : t ≫ i = Affine.parabolicHom χ :=
    (Affine.isRepresentedBy_parabolicHom χ).lift_comp_eq
      (⟨inferInstance, rfl⟩ : (SubgroupFunctor.range i).IsRepresentedBy i)
      (fun T => Subgroup.inclusion (hP T)) (fun _ _ => rfl) (fun _ _ => rfl)
  have hopen : IsOpenImmersion
      ((fst U.X V.X ≫ (s ≫ d).hom.hom) *
        (snd U.X V.X ≫ (t ≫ i).hom.hom)).left := by
    rw [hs, ht]
    exact oppositeCellStatement k G χ U V _ _
      (Affine.isRepresentedBy_unipotentHom χopp)
      (Affine.isRepresentedBy_parabolicHom χ)
  have h := a.smoothSurjective_of_openCell d i
    (fun T p h => SubgroupFunctor.lift_comp_normalizedConjugation_comp d i hn p h)
    s t
  simpa only [AutomorphicAction.semidirectHomLift_hom] using h

end Product

namespace OppositeEnvelope

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffine G.X.left] (χ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G)

/-- The reversed cocharacter `t ↦ χ(t⁻¹)`. -/
abbrev reversed : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G :=
  CommGroupScheme.groupHom (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫ χ

/-- The source scheme `U(χ) ×_k 𝔾_m ×_k U(χ⁻¹)`. -/
abbrev source : Over (Spec (CommRingCat.of k)) :=
  (Affine.unipotentScheme χ).X ⊗
    ((Gm (Spec (CommRingCat.of k))).X ⊗ (Affine.unipotentScheme (reversed χ)).X)

/-- The point `(a, t, b)` of the source. -/
abbrev point {T : Over (Spec (CommRingCat.of k))} (a : T ⟶ (Affine.unipotentScheme χ).X)
    (t : T ⟶ (Gm (Spec (CommRingCat.of k))).X)
    (b : T ⟶ (Affine.unipotentScheme (reversed χ)).X) : T ⟶ source χ :=
  lift a (lift t b)

/-- The morphism `(a, t, b) ↦ a · χ(t) · b`. -/
def map : source χ ⟶ G.X :=
  (fst _ _ ≫ (Affine.unipotentHom χ).hom.hom) *
    ((snd _ _ ≫ fst _ _) ≫ χ.hom.hom) *
    ((snd _ _ ≫ snd _ _) ≫ (Affine.unipotentHom (reversed χ)).hom.hom)

theorem comp_map {T : Over (Spec (CommRingCat.of k))} (w : T ⟶ source χ) :
    w ≫ map χ = (w ≫ fst _ _ ≫ (Affine.unipotentHom χ).hom.hom) *
      (w ≫ snd _ _ ≫ fst _ _ ≫ χ.hom.hom) *
      (w ≫ snd _ _ ≫ snd _ _ ≫ (Affine.unipotentHom (reversed χ)).hom.hom) := by
  simp only [map, MonObj.comp_mul, Category.assoc]

theorem point_map {T : Over (Spec (CommRingCat.of k))} (a : T ⟶ (Affine.unipotentScheme χ).X)
    (t : T ⟶ (Gm (Spec (CommRingCat.of k))).X)
    (b : T ⟶ (Affine.unipotentScheme (reversed χ)).X) :
    point χ a t b ≫ map χ = (a ≫ (Affine.unipotentHom χ).hom.hom) * (t ≫ χ.hom.hom) *
      (b ≫ (Affine.unipotentHom (reversed χ)).hom.hom) := by
  simp only [comp_map, point, lift_fst_assoc, lift_snd_assoc]

/-- The base point `(1, 1, 1)`. -/
def basePoint : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ source χ :=
  point χ 1 1 1

theorem basePoint_map : basePoint χ ≫ map χ = 1 := by
  simp only [basePoint, point_map, MonObj.one_comp, mul_one]

section Geometry

variable [Smooth G.X.hom] [IsAffineHom G.X.hom]

private theorem good_of_group (H : GroupScheme (Spec (CommRingCat.of k)))
    [Smooth H.X.hom] [IsAffineHom H.X.hom] [ConnectedSpace H.X.left] :
    ImageGeneration.FinitePowerGood _ H.X :=
  ImageGeneration.finitePowerGood_of_geometricallyIntegral H.X inferInstance inferInstance
    (smoothConnectedAffineGeometry.1 k H inferInstance inferInstance inferInstance)

theorem unipotentScheme_smooth (ψ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G) :
    Smooth (Affine.unipotentScheme ψ).X.hom :=
  (dynamicSmooth k G ψ _ (Affine.unipotentHom ψ)).2.2 (Affine.isRepresentedBy_unipotentHom ψ)

omit [Smooth G.X.hom] in
theorem unipotentScheme_isAffineHom (ψ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G) :
    IsAffineHom (Affine.unipotentScheme ψ).X.hom := by
  have : IsClosedImmersion (Affine.unipotentHom ψ).hom.hom.left :=
    Affine.isClosedSubgroup_unipotentHom ψ
  rw [← Over.w (Affine.unipotentHom ψ).hom.hom]
  infer_instance

theorem unipotentScheme_connectedSpace (ψ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G) :
    ConnectedSpace (Affine.unipotentScheme ψ).X.left :=
  (dynamicConnected k G ψ _ (Affine.unipotentHom ψ)).1 (Affine.isRepresentedBy_unipotentHom ψ)

theorem source_good : ImageGeneration.FinitePowerGood _ (source χ) := by
  have := unipotentScheme_smooth χ
  have := unipotentScheme_isAffineHom χ
  have := unipotentScheme_connectedSpace χ
  have := unipotentScheme_smooth (reversed χ)
  have := unipotentScheme_isAffineHom (reversed χ)
  have := unipotentScheme_connectedSpace (reversed χ)
  have hgm : IsTorus (Gm (Spec (CommRingCat.of k))).toGrp := IsSplitTorus.isTorus isSplitTorus_gm
  have : Smooth (Gm (Spec (CommRingCat.of k))).toGrp.X.hom := IsTorus.smooth hgm
  have : IsAffineHom (Gm (Spec (CommRingCat.of k))).toGrp.X.hom := isSplitTorus_gm.isAffineHom
  have : ConnectedSpace (Gm (Spec (CommRingCat.of k))).toGrp.X.left :=
    IsTorus.connectedSpace hgm
  exact ImageGeneration.finitePowerGood_tensor _ _ (good_of_group _)
    (ImageGeneration.finitePowerGood_tensor _ _ (good_of_group (Gm _).toGrp) (good_of_group _))

/-- The closed subgroup generated by the image of `(a, t, b) ↦ a · χ(t) · b` has a
smooth connected representative, dominated by a finite power of the source. -/
theorem exists_generatedImage :
    ∃ D : GeneratedImage (map χ), D.HasSmoothConnectedGeneration := by
  have hV := source_good χ
  have : GeometricallyReduced (source χ).hom := hV.2.2.1
  have : GeometricallyIrreducible (source χ).hom := hV.2.2.2
  exact ImageGeneration.pointedImageGeneration k G inferInstance inferInstance (source χ)
    hV.1 hV.2.1 (GeometricallyIntegral.of_geometricallyReduced_of_geometricallyIrreducible _)
    (basePoint χ) (map χ) (basePoint_map χ)

end Geometry

section Containment

variable {χ} (D : GeneratedImage (map χ))

theorem comp_map_mem {T : Over (Spec (CommRingCat.of k))} (v : T ⟶ source χ) :
    v ≫ map χ ∈ (SubgroupFunctor.range D.inclusion).carrier T := by
  rw [D.represents.2]
  exact closedImageEnvelope_containsImage (map χ) T v

theorem unipotent_le : unipotent χ ≤ SubgroupFunctor.range D.inclusion := by
  intro T x hx
  rw [← (Affine.isRepresentedBy_unipotentHom χ).2] at hx
  obtain ⟨a, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  have h := comp_map_mem D (point χ a 1 1)
  rwa [point_map, MonObj.one_comp, MonObj.one_comp, mul_one, mul_one] at h

theorem reversed_unipotent_le : unipotent (reversed χ) ≤ SubgroupFunctor.range D.inclusion := by
  intro T x hx
  rw [← (Affine.isRepresentedBy_unipotentHom (reversed χ)).2] at hx
  obtain ⟨b, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  have h := comp_map_mem D (point χ 1 1 b)
  rwa [point_map, MonObj.one_comp, MonObj.one_comp, one_mul, one_mul] at h

theorem range_cocharacter_le : SubgroupFunctor.range χ ≤ SubgroupFunctor.range D.inclusion := by
  intro T x hx
  obtain ⟨t, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  have h := comp_map_mem D (point χ 1 t 1)
  rwa [point_map, MonObj.one_comp, MonObj.one_comp, one_mul, mul_one] at h

/-- Conjugating an image point of the source by a point of `P(χ)` stays in the
generated subgroup: write the conjugating point as `u · z` with `u` in `U(χ)` and
`z` in `Z(χ)`, and conjugate each of the three factors by `z`. -/
theorem conj_comp_map_mem [IsSeparated G.X.hom] {T : Over (Spec (CommRingCat.of k))}
    {p : T ⟶ G.X} (hp : p ∈ (parabolic χ).carrier T) (w : T ⟶ source χ) :
    p * (w ≫ map χ) * p⁻¹ ∈ (SubgroupFunctor.range D.inclusion).carrier T := by
  let H := (SubgroupFunctor.range D.inclusion).carrier T
  let a := w ≫ fst _ _ ≫ (Affine.unipotentHom χ).hom.hom
  let τ := w ≫ snd _ _ ≫ fst _ _
  let b := w ≫ snd _ _ ≫ snd _ _ ≫ (Affine.unipotentHom (reversed χ)).hom.hom
  have ha : a ∈ (unipotent χ).carrier T := by
    rw [← (Affine.isRepresentedBy_unipotentHom χ).2]
    exact SubgroupFunctor.mem_range.mpr ⟨w ≫ fst _ _, by simp only [a, Category.assoc]⟩
  have hb : b ∈ (unipotent (reversed χ)).carrier T := by
    rw [← (Affine.isRepresentedBy_unipotentHom (reversed χ)).2]
    exact SubgroupFunctor.mem_range.mpr ⟨w ≫ snd _ _ ≫ snd _ _, by simp only [b, Category.assoc]⟩
  let l := limit χ ⟨p, hp⟩
  have hl : l ∈ (centralizer χ).carrier T := limit_mem_centralizer χ ⟨p, hp⟩
  have hu : p * l⁻¹ ∈ (unipotent χ).carrier T := mul_inv_limit_mem_unipotent χ ⟨p, hp⟩
  have hla : l * a * l⁻¹ ∈ H :=
    unipotent_le D T (conj_mem_unipotent χ (centralizer_le_parabolic χ T hl) ha)
  have hlb : l * b * l⁻¹ ∈ H :=
    reversed_unipotent_le D T (conj_mem_unipotent (reversed χ)
      (centralizer_le_parabolic (reversed χ) T (centralizer_le_precomp χ _ T hl)) hb)
  have hlt : l * (τ ≫ χ.hom.hom) * l⁻¹ ∈ H := by
    have hc : l ∈ (torusCentralizer χ).carrier T := by
      rw [torusCentralizer_gm_eq_dynamicCentralizer]
      exact hl
    have hcomm := (mem_torusCentralizer χ).mp hc T (𝟙 T) τ
    rw [Category.id_comp] at hcomm
    rw [hcomm.mul_inv_cancel]
    exact range_cocharacter_le D T (SubgroupFunctor.mem_range.mpr ⟨τ, rfl⟩)
  have key : ∀ x y z : T ⟶ G.X, p * (x * y * z) * p⁻¹ =
      (p * l⁻¹) * ((l * x * l⁻¹) * (l * y * l⁻¹) * (l * z * l⁻¹)) * (p * l⁻¹)⁻¹ := by
    intro x y z
    group
  have hτ : w ≫ snd _ _ ≫ fst _ _ ≫ χ.hom.hom = τ ≫ χ.hom.hom := by
    simp only [τ, Category.assoc]
  rw [comp_map, key, hτ]
  exact H.mul_mem (H.mul_mem (unipotent_le D T hu)
    (H.mul_mem (H.mul_mem hla hlt) hlb)) (H.inv_mem (unipotent_le D T hu))

/-- The generated subgroup is normalized by `P(χ)` on every relative test. -/
theorem isNormalizedBy_parabolic [IsAffineHom G.X.hom] :
    (SubgroupFunctor.range D.inclusion).IsNormalizedBy (parabolic χ) := by
  let ip := Affine.parabolicHom χ
  let b := AutomorphicAction.conjugation ip
  have hPs : IsAffineHom (Affine.parabolicScheme χ).X.hom := by
    have : IsClosedImmersion ip.hom.hom.left := Affine.isClosedSubgroup_parabolicHom χ
    rw [← Over.w ip.hom.hom]
    infer_instance
  obtain ⟨C, j, hj, hjc⟩ := b.orbitCore_range_isClosedRepresentable hPs D.inclusion D.closed
  have hcore : (b.orbitCore (SubgroupFunctor.range D.inclusion)).ContainsImage (map χ) := by
    intro T v T' c h
    rw [AutomorphicAction.conjugation_act, ← Category.assoc]
    apply conj_comp_map_mem D
    rw [← (Affine.isRepresentedBy_parabolicHom χ).2]
    exact SubgroupFunctor.mem_range.mpr ⟨h, rfl⟩
  have hle := closedImageEnvelope_le_of_containsImage (map χ) j hj hjc hcore
  intro T g x hg hx
  rw [← (Affine.isRepresentedBy_parabolicHom χ).2] at hg
  obtain ⟨h, rfl⟩ := SubgroupFunctor.mem_range.mp hg
  rw [D.represents.2] at hx
  have h' := hle T hx T (𝟙 T) h
  rwa [Category.id_comp, AutomorphicAction.conjugation_act] at h'

end Containment

section Density

open Langlands.AlgebraicGeometry.PointTopology

omit [IsAffine G.X.left] in
/-- The terminal object over a field has dense rational points. -/
theorem hasDenseRationalPoints_unit :
    HasDenseRationalPoints k (𝟙_ (Over (Spec (CommRingCat.of k)))) := by
  apply Dense.mono (Set.subset_iUnion _
    (𝟙 (𝟙_ (Over (Spec (CommRingCat.of k)))) : RationalPoint k _))
  apply Function.Surjective.denseRange
  intro x
  exact ⟨x, rfl⟩

omit [IsAffine G.X.left] in
/-- Finite powers of a smooth scheme with dense rational points are smooth with dense
rational points. -/
theorem finitePower_smooth_dense (V : Over (Spec (CommRingCat.of k))) (hV : Smooth V.hom)
    (hd : HasDenseRationalPoints k V) :
    ∀ n : ℕ, Smooth (finitePower V n).hom ∧ HasDenseRationalPoints k (finitePower V n)
  | 0 => ⟨smooth_of_over_iso (finitePowerZeroIso V)
      (show Smooth (𝟙_ (Over (Spec (CommRingCat.of k)))).hom from
        inferInstanceAs (Smooth (𝟙 (Spec (CommRingCat.of k))))),
      RationalDensity.HasDenseRationalPoints.of_iso (finitePowerZeroIso V).symm
        hasDenseRationalPoints_unit⟩
  | n + 1 => by
    obtain ⟨hs, hdn⟩ := finitePower_smooth_dense V hV hd n
    have : Smooth (finitePower V n).hom := hs
    exact ⟨smooth_of_over_iso (finitePowerSuccIso V n) (smooth_tensor _ _ hV hs),
      RationalDensity.HasDenseRationalPoints.of_iso (finitePowerSuccIso V n).symm
        (RationalDensity.HasDenseRationalPoints.tensor RationalDensity.isOpenMap_fst hd hdn)⟩

variable [Smooth G.X.hom] [IsAffineHom G.X.hom]

theorem source_smooth : Smooth (source χ).hom :=
  smooth_tensor _ _ (unipotentScheme_smooth χ)
    (smooth_tensor _ _ (smooth_gm _) (unipotentScheme_smooth (reversed χ)))

/-- Over an infinite field, the source `U(χ) × 𝔾_m × U(χ⁻¹)` has dense rational points. -/
theorem source_dense [Infinite k] : HasDenseRationalPoints k (source χ) := by
  have := unipotentScheme_isAffineHom χ
  have := unipotentScheme_isAffineHom (reversed χ)
  have hU : HasDenseRationalPoints k (Affine.unipotentScheme χ).X :=
    RationalDensity.IsSplitUnipotent.hasDenseRationalPoints
      (isSplitUnipotent_of_isRepresentedBy_unipotent χ (Affine.isRepresentedBy_unipotentHom χ)
        (Affine.isClosedSubgroup_unipotentHom χ))
  have hU' : HasDenseRationalPoints k (Affine.unipotentScheme (reversed χ)).X :=
    RationalDensity.IsSplitUnipotent.hasDenseRationalPoints
      (isSplitUnipotent_of_isRepresentedBy_unipotent (reversed χ)
        (Affine.isRepresentedBy_unipotentHom (reversed χ))
        (Affine.isClosedSubgroup_unipotentHom (reversed χ)))
  have hgm : HasDenseRationalPoints k (Gm (Spec (CommRingCat.of k))).X :=
    IsTorus.hasDenseRationalPoints_of_finiteGaloisSplitting torusFiniteGaloisSplitting
      (IsSplitTorus.isTorus isSplitTorus_gm)
  have := unipotentScheme_smooth (reversed χ)
  have : Smooth ((Gm (Spec (CommRingCat.of k))).X ⊗
      (Affine.unipotentScheme (reversed χ)).X).hom :=
    smooth_tensor _ _ (smooth_gm _) (unipotentScheme_smooth (reversed χ))
  exact RationalDensity.HasDenseRationalPoints.tensor RationalDensity.isOpenMap_fst hU
    (RationalDensity.HasDenseRationalPoints.tensor RationalDensity.isOpenMap_fst hgm hU')

/-- Over an infinite field, the generated subgroup has dense rational points. -/
theorem hasDenseRationalPoints [Infinite k] (D : GeneratedImage (map χ))
    (hD : D.HasSmoothConnectedGeneration) : HasDenseRationalPoints k D.group.X := by
  obtain ⟨n, -, hdom⟩ := hD.2.2.2
  exact hasDenseRationalPoints_of_denseRange (D.powerMap n) hdom.denseRange
    (finitePower_smooth_dense (source χ) (source_smooth χ) (source_dense χ) n).2

end Density

end OppositeEnvelope

