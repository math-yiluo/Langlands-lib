import Langlands.GroupScheme.RelativeUnipotent.RootWeightFiltration
import Langlands.GroupScheme.RelativeLevi.SplitBorelPositiveFactors
import Langlands.GroupScheme.Reductive.LocalRootGroupParam

/-! # Ambient root ranges and comparison of weighted filtration terms -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.GroupTheory.HeightFiltration

variable {A B : Type*} [Group A] [Group B] {n m : ℕ}

/-- A group homomorphism carries a generated weight level to the level
generated by the images of exactly the same factors. -/
theorem map_level (H : Fin n → Subgroup A) (w : Fin n → ℕ) (d : ℕ)
    (f : A →* B) :
    (level H w d).map f = level (fun k => (H k).map f) w d := by
  simp only [level, factor, Subgroup.map_iSup]

/-- Relabelling factors while preserving their groups and weights preserves
every generated level; the enumerated product order is immaterial here. -/
theorem level_eq_of_equiv (H : Fin n → Subgroup A) (H' : Fin m → Subgroup A)
    (w : Fin n → ℕ) (w' : Fin m → ℕ) (e : Fin n ≃ Fin m)
    (hH : ∀ k, H k = H' (e k)) (hw : ∀ k, w k = w' (e k)) (d : ℕ) :
    level H w d = level H' w' d := by
  apply le_antisymm
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    rw [hH k]
    exact le_level H' w' (by simpa [hw k] using hk)
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    obtain ⟨l, rfl⟩ := e.surjective k
    rw [← hH l]
    exact le_level H w (by simpa [hw l] using hk)

end Langlands.GroupTheory.HeightFiltration

namespace Langlands.GroupScheme.SubgroupFunctor

variable {S : Scheme.{u}} {K U G : GroupScheme S}

/-- The pointwise range of a composite is the image of the first range under
the second homomorphism, on every scheme test. -/
theorem range_comp_carrier (f : K ⟶ U) (j : U ⟶ G) (T : Over S) :
    (range (f ≫ j)).carrier T =
      ((range f).carrier T).map ((yonedaGrp.map j).app (Opposite.op T)).hom := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    apply Subgroup.mem_map.mpr
    refine ⟨y ≫ f.hom.hom, mem_range.mpr ⟨y, rfl⟩, ?_⟩
    change (y ≫ f.hom.hom) ≫ j.hom.hom = y ≫ (f ≫ j).hom.hom
    rw [Grp.comp_hom_hom, Category.assoc]
  · intro hx
    obtain ⟨z, hz, hx⟩ := Subgroup.mem_map.mp hx
    obtain ⟨y, hy⟩ := mem_range.mp hz
    apply mem_range.mpr
    refine ⟨y, ?_⟩
    rw [Grp.comp_hom_hom, ← Category.assoc, hy]
    exact hx

end Langlands.GroupScheme.SubgroupFunctor

namespace Langlands.GroupScheme.LocalSplitCell

open RelativeUnipotent Langlands.GroupTheory

variable {R : Type u} [CommRing R]
  {U G : GroupScheme (Spec (CommRingCat.of R))}
  {J : Type u} {n : ℕ}

/-- The root factors defined using global-function parameters are exactly
the all-test ranges of the actual root homomorphisms. -/
theorem rootFactor_eq_range (fam : J → (Ga R ⟶ G)) (pos : Fin n → J)
    (T : Over (Spec (CommRingCat.of R))) (k : Fin n) :
    rootFactor fam pos T k = (SubgroupFunctor.range (fam (pos k))).carrier T := by
  ext x
  constructor
  · rintro ⟨c, rfl⟩
    exact SubgroupFunctor.mem_range.mpr
      ⟨VectorGroup.scalarPoint (CommRingCat.of R) T c.toAdd, rfl⟩
  · rintro ⟨y, rfl⟩
    obtain ⟨c, rfl⟩ :=
      (LocalRootGroup.scalarPoint_bijective (CommRingCat.of R) T).surjective y
    exact ⟨Multiplicative.ofAdd c, rfl⟩

/-- The image of a parametrized root factor is the factor of the composite
root homomorphism, without an affineness condition on the test scheme. -/
theorem map_rootFactor (fam : J → (Ga R ⟶ U)) (pos : Fin n → J)
    (j : U ⟶ G) (T : Over (Spec (CommRingCat.of R))) (k : Fin n) :
    (rootFactor fam pos T k).map ((yonedaGrp.map j).app (Opposite.op T)).hom =
      rootFactor (fun a => fam a ≫ j) pos T k := by
  rw [rootFactor_eq_range, rootFactor_eq_range,
    ← SubgroupFunctor.range_comp_carrier]

variable {C : RootHeightChart U} (W : RootWeightData C) (j : U ⟶ G)

/-- The ambient range of each represented weight term is generated by its
actual ambient root subgroup factors at the same unscaled cutoff. -/
theorem range_weightInclusion_comp (d : ℕ) :
    SubgroupFunctor.range (W.inclusion d ≫ j) =
      heightSubgroup (fun a => C.roots a ≫ j) ULift.up W.weight (d + 1) := by
  apply SubgroupFunctor.ext
  intro T
  rw [SubgroupFunctor.range_comp_carrier, (W.isRepresentedBy_inclusion d).2]
  change (HeightFiltration.level (rootFactor C.roots ULift.up T) W.weight (d + 1)).map
    ((yonedaGrp.map j).app (Opposite.op T)).hom = _
  rw [HeightFiltration.map_level]
  congr 1
  funext k
  exact map_rootFactor C.roots ULift.up j T k

end Langlands.GroupScheme.LocalSplitCell

namespace Langlands.GroupScheme.RelativeUnipotent.RootWeightData

open LocalSplitCell Langlands.GroupTheory

variable {R : Type u} [CommRing R]
  {G U U' : GroupScheme (Spec (CommRingCat.of R))}
  {C : RootHeightChart U} {C' : RootHeightChart U'}
  (W : RootWeightData C) (W' : RootWeightData C')
  (j : U ⟶ G) (j' : U' ⟶ G)
  (e : Fin C.dimension ≃ Fin C'.dimension)
  (hroot : ∀ (T : Over (Spec (CommRingCat.of R))) (k : Fin C.dimension),
    (SubgroupFunctor.range (C.roots (ULift.up k) ≫ j)).carrier T =
      (SubgroupFunctor.range (C'.roots (ULift.up (e k)) ≫ j')).carrier T)
  (hw : ∀ k, W.weight k = W'.weight (e k))

include hroot hw in
/-- Equal weighted ambient root ranges give equal ambient filtration ranges
at every level and on all scheme tests. -/
theorem range_inclusion_comp_eq (d : ℕ) :
    SubgroupFunctor.range (W.inclusion d ≫ j) =
      SubgroupFunctor.range (W'.inclusion d ≫ j') := by
  rw [range_weightInclusion_comp, range_weightInclusion_comp]
  apply SubgroupFunctor.ext
  intro T
  apply HeightFiltration.level_eq_of_equiv _ _ _ _ e _ hw (d + 1)
  intro k
  rw [rootFactor_eq_range, rootFactor_eq_range]
  exact hroot T k

variable [Mono j.hom.hom] [Mono j'.hom.hom]

/-- The actual represented terms identified by weighted ambient root ranges
are isomorphic, with their ambient inclusions preserved. -/
def ambientTermIso (d : ℕ) : W.groupScheme d ≅ W'.groupScheme d := by
  let : Mono (W.inclusion d).hom.hom := (W.isRepresentedBy_inclusion d).1
  let : Mono (W'.inclusion d).hom.hom := (W'.isRepresentedBy_inclusion d).1
  have hmono : Mono (W.inclusion d ≫ j).hom.hom := by
    change Mono ((W.inclusion d).hom.hom ≫ j.hom.hom)
    infer_instance
  have hmono' : Mono (W'.inclusion d ≫ j').hom.hom := by
    change Mono ((W'.inclusion d).hom.hom ≫ j'.hom.hom)
    infer_instance
  exact (show (SubgroupFunctor.range (W.inclusion d ≫ j)).IsRepresentedBy
      (W.inclusion d ≫ j) from ⟨hmono, rfl⟩).isoOfIsRepresentedBy
    ⟨hmono', (W.range_inclusion_comp_eq W' j j' e hroot hw d).symm⟩

/-- The term comparison isomorphism recovers the original ambient maps. -/
theorem ambientTermIso_hom_comp (d : ℕ) :
    (W.ambientTermIso W' j j' e hroot hw d).hom ≫ (W'.inclusion d ≫ j') =
      W.inclusion d ≫ j := by
  exact SubgroupFunctor.IsRepresentedBy.isoOfIsRepresentedBy_hom_comp _ _

end Langlands.GroupScheme.RelativeUnipotent.RootWeightData
