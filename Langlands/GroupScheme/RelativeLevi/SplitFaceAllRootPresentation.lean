import Langlands.GroupScheme.RelativeLevi.SplitParabolicFaceChart
import Langlands.GroupScheme.RelativeLevi.RootWeightAmbientComparison

/-! # All-root presentation of actual canonical face terms -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.GroupScheme.SplitParabolicFaceChart

open LocalSplitCell RelativeUnipotent Langlands.GroupTheory
open Langlands.LinearAlgebra.RootDatumFaceHeight

variable {R : Type u} [CommRing R]
  {I J : Type u} [Fintype I] [Fintype J]
  {G : GroupScheme (Spec (CommRingCat.of R))} [IsAffineHom G.X.hom]
  {i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G}
  {P : RootDatum J (I → ℤ) (I → ℤ)}
  {fam : J → (Ga R ⟶ G)} {wt : I → ℤ}
  (C : SplitParabolicFaceChart i P fam wt)

private local instance : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom

/-- Face heights of negative roots are nonpositive, for any coweight. -/
theorem faceHeight_nonpos_of_not_isPos (a : J) (ha : ¬ C.base.IsPos a) :
    faceHeight C.base C.faceCoweight (P.rootSpanMem ℤ a) ≤ 0 := by
  let := P.indexNeg
  have hp := faceHeight_nonneg_of_isPos C.base C.faceCoweight
    ((RootPairing.Base.IsPos.neg_iff_not C.base a).mpr ha)
  have hn : P.rootSpanMem ℤ (-a) = - P.rootSpanMem ℤ a := by
    apply Subtype.ext
    change P.root (P.reflectionPerm a a) = -P.root a
    simp
  rw [hn, map_neg] at hp
  omega

/-- The nonnegative face weight on every root, with negative face heights
truncated to zero. Only positive cutoffs are used. -/
def allRootWeight (a : J) : ℕ :=
  (faceHeight C.base C.faceCoweight (P.rootSpanMem ℤ a)).toNat

/-- An enumeration of the entire root family, with no positive-base restriction. -/
def allRootIndex (A : Type u) [Finite A] : Fin (Nat.card A) ≃ A :=
  (Finite.equivFin A).symm

/-- The actual subgroup generated by all ambient root ranges at the original
unscaled positive face cutoff. -/
def allRootSubgroup (d : ℕ) : SubgroupFunctor G :=
  heightSubgroup fam (allRootIndex J) (fun k => C.allRootWeight ((allRootIndex J) k)) (d + 1)

@[simp] theorem allRootWeight_index (k : Fin C.chart.dimension) :
    C.allRootWeight (C.index k) = C.weights.weight k := by
  rw [allRootWeight, ← C.weight_eq, Int.toNat_natCast]

/-- An active root in the full-root presentation lies in the chart's positive system. -/
theorem isPos_of_allRootWeight_pos (a : J) (ha : 0 < C.allRootWeight a) : C.base.IsPos a := by
  by_contra hn
  have hh := C.faceHeight_nonpos_of_not_isPos a hn
  change 0 < (faceHeight C.base C.faceCoweight (P.rootSpanMem ℤ a)).toNat at ha
  omega

/-- The all-root generated subgroup is precisely the actual original term on
every scheme test, including all discarded zero and negative root weights. -/
theorem range_inclusion_comp_eq_allRootSubgroup (d : ℕ) :
    SubgroupFunctor.range (C.weights.inclusion d ≫
      Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter)) =
        C.allRootSubgroup d := by
  rw [range_weightInclusion_comp]
  apply SubgroupFunctor.ext
  intro T
  change HeightFiltration.level
    (rootFactor (fun a => C.chart.roots a ≫
      Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter)) ULift.up T)
    C.weights.weight (d + 1) =
    HeightFiltration.level (rootFactor fam (allRootIndex J) T)
      (fun k => C.allRootWeight ((allRootIndex J) k)) (d + 1)
  apply le_antisymm
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    let l := (allRootIndex J).symm (C.index k)
    have hl : (allRootIndex J) l = (C.index k : J) := by simp [l]
    have hw : C.weights.weight k = C.allRootWeight ((allRootIndex J) l) := by
      rw [hl, C.allRootWeight_index]
    have hf : rootFactor (fun a => C.chart.roots a ≫
          Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter)) ULift.up T k =
        rootFactor fam (allRootIndex J) T l := by
      rw [rootFactor_eq_range, rootFactor_eq_range, C.root_comp, hl]
    rw [hf]
    exact HeightFiltration.le_level _ _ (by rw [← hw]; exact hk)
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    have hp : C.base.IsPos ((allRootIndex J) k) :=
      C.isPos_of_allRootWeight_pos ((allRootIndex J) k)
        (lt_of_lt_of_le (Nat.zero_lt_succ d) hk)
    let l := C.index.symm ⟨(allRootIndex J) k, hp⟩
    have hl : (C.index l : J) = (allRootIndex J) k := by simp [l]
    have hw : C.weights.weight l = C.allRootWeight ((allRootIndex J) k) := by
      rw [← hl, C.allRootWeight_index]
    have hf : rootFactor fam (allRootIndex J) T k =
        rootFactor (fun a => C.chart.roots a ≫
          Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter)) ULift.up T l := by
      rw [rootFactor_eq_range, rootFactor_eq_range, C.root_comp, hl]
    rw [hf]
    exact HeightFiltration.le_level _ _ (by rw [hw]; exact hk)

end Langlands.GroupScheme.SplitParabolicFaceChart
