import Langlands.GroupScheme.RelativeLevi.SplitFaceBaseComparison
import Langlands.GroupScheme.RelativeLevi.SplitFaceAllRootPresentation
import Langlands.GroupScheme.Reductive.LocalSplitRootBaseChange
import Langlands.GroupScheme.SubgroupBaseChange

/-! # Actual unscaled root-weight terms under affine base change -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.GroupScheme.LocalSplitCell

open Langlands.GroupTheory LocalSplitRootBaseChange

variable {R : Type u} [CommRing R] (A : Type u) [CommRing A] [Algebra R A]
  {G : GroupScheme (Spec (CommRingCat.of R))}
  {J : Type u} {n : ℕ}
  (fam : J → (Ga R ⟶ G)) (pos : Fin n → J)

/-- Actual root factors correspond on every scheme test after coefficient extension. -/
theorem map_rootFactor_baseChange (T : Over (Spec (CommRingCat.of A))) (k : Fin n) :
    (rootFactor (fun a => baseChangeRoot A (fam a)) pos T k).map
      (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).toMonoidHom =
    rootFactor fam pos ((Over.map (algebraBaseMap R A)).obj T) k := by
  rw [rootFactor_eq_range, rootFactor_eq_range]
  have hr : SubgroupFunctor.range (baseChangeRoot A (fam (pos k))) =
      (SubgroupFunctor.range (fam (pos k))).baseChange (algebraBaseMap R A) := by
    unfold baseChangeRoot
    exact (SubgroupFunctor.range_iso_comp (gaIso (R := R) A).symm _).trans
      (SubgroupFunctor.range_baseChangeHom (algebraBaseMap R A) _)
  rw [hr]
  exact Subgroup.map_comap_eq_self_of_surjective
    (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).surjective _

/-- Generated weighted root subgroups commute with arbitrary coefficient extension,
with the original integral weights and on all scheme tests. -/
theorem heightSubgroup_baseChange (w : Fin n → ℕ) (d : ℕ) :
    (heightSubgroup fam pos w d).baseChange (algebraBaseMap R A) =
      heightSubgroup (fun a => baseChangeRoot A (fam a)) pos w d := by
  apply SubgroupFunctor.ext
  intro T
  apply Subgroup.map_injective
    (f := (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).toMonoidHom)
    (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).injective
  change (Subgroup.comap
      (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).toMonoidHom
      (HeightFiltration.level
        (rootFactor fam pos ((Over.map (algebraBaseMap R A)).obj T)) w d)).map
      (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).toMonoidHom =
    (HeightFiltration.level (rootFactor (fun a => baseChangeRoot A (fam a)) pos T) w d).map
      (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).toMonoidHom
  rw [Subgroup.map_comap_eq_self_of_surjective
    (GroupScheme.baseChangePointsEquiv (algebraBaseMap R A) G T).surjective,
    HeightFiltration.map_level]
  congr 1
  funext k
  exact (map_rootFactor_baseChange A fam pos T k).symm

end Langlands.GroupScheme.LocalSplitCell

namespace Langlands.GroupScheme.SplitParabolicFaceChart

open LocalSplitCell LocalSplitRootBaseChange RelativeUnipotent
open Langlands.LinearAlgebra.RootDatumFaceHeight
open Langlands.LinearAlgebra.RootDatumFaceBaseComparison

variable {R : Type u} [CommRing R]
  {I J : Type u} [Fintype I] [Fintype J]
  {G : GroupScheme (Spec (CommRingCat.of R))} [IsAffineHom G.X.hom]
  {i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G}
  {P : RootDatum J (I → ℤ) (I → ℤ)}
  {fam : J → (Ga R ⟶ G)} {wt : I → ℤ}
  (C : SplitParabolicFaceChart i P fam wt)
  (A : Type u) [CommRing A] [Algebra R A]

private local instance : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
local instance : IsAffineHom ((GroupScheme.baseChange (algebraBaseMap R A)).obj G).X.hom :=
  MorphismProperty.pullback_snd G.X.hom (algebraBaseMap R A) inferInstance

/-- The subgroup generated by the actual base-changed roots at the unchanged
canonical face cutoff. No auxiliary regular chart is chosen over the new ring. -/
def affineBaseChangeSubgroup (d : ℕ) :
    SubgroupFunctor ((GroupScheme.baseChange (algebraBaseMap R A)).obj G) :=
  heightSubgroup (fun a => baseChangeRoot A (fam a)) (allRootIndex J)
    (fun k => C.allRootWeight ((allRootIndex J) k)) (d + 1)

/-- The original full-root presentation pulls back to the actual root ranges. -/
theorem allRootSubgroup_baseChange (d : ℕ) :
    (C.allRootSubgroup d).baseChange (algebraBaseMap R A) =
      C.affineBaseChangeSubgroup A d :=
  heightSubgroup_baseChange A fam (allRootIndex J) _ _

/-- The actual pullback of the original ambient inclusion represents exactly
the generated subgroup at the original, unscaled face cutoff. -/
theorem range_affineBaseChange_inclusion (d : ℕ) :
    SubgroupFunctor.range ((GroupScheme.baseChange (algebraBaseMap R A)).map
      (C.weights.inclusion d ≫
        Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter))) =
      C.affineBaseChangeSubgroup A d := by
  rw [SubgroupFunctor.range_baseChangeHom, C.range_inclusion_comp_eq_allRootSubgroup,
    C.allRootSubgroup_baseChange]

variable (D : SplitParabolicFaceChart (splitTorus.baseChangeHom (K := A) G I i)
  P (fun a => baseChangeRoot A (fam a)) wt)
  (hG : IsReductive G)
  (hmax : IsFibrewiseMaximalTorus (T := splitTorus.commGroupScheme _ I) i)
  (hP : IsFibrewiseRootDatumOf I G i P)

include hG hmax hP in
/-- A fresh chart over the extended coefficient ring has exactly the original
face-height functional, even when its positive base is chosen independently. -/
theorem faceHeight_eq_of_affineBaseChange [Nontrivial R] :
    faceHeight C.base C.faceCoweight = faceHeight D.base D.faceCoweight := by
  let : P.IsReduced := hP.isReduced
  let := hP.finite_zeroReflectionSubgroup hG hmax C.faceCoweight
  have hdom : ∀ a ∈ D.base.support, 0 ≤ P.root' a C.faceCoweight := by
    intro a ha
    rw [C.coweight_eq, ← D.coweight_eq]
    exact D.dominant a ha
  calc
    faceHeight C.base C.faceCoweight = faceHeight D.base C.faceCoweight :=
      faceHeight_eq_of_dominant_bases P C.base D.base C.faceCoweight C.dominant hdom
    _ = faceHeight D.base D.faceCoweight := by
      apply faceHeight_eq_of_simple_zero_iff
      intro a _
      rw [C.coweight_eq, D.coweight_eq]

include hG hmax hP in
/-- The pullback of every original ambient term equals the actual term of an
independently chosen chart on the pulled-back roots, on every scheme test. -/
theorem range_affineBaseChange_inclusion_eq [Nontrivial R] (d : ℕ) :
    SubgroupFunctor.range ((GroupScheme.baseChange (algebraBaseMap R A)).map
      (C.weights.inclusion d ≫
        Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter))) =
    SubgroupFunctor.range (D.weights.inclusion d ≫
      Dynamic.Affine.unipotentHom
        (AffineRegularBorel.cocharacter (splitTorus.baseChangeHom (K := A) G I i)
          D.cocharacter)) := by
  rw [C.range_affineBaseChange_inclusion A, D.range_inclusion_comp_eq_allRootSubgroup]
  have hface := C.faceHeight_eq_of_affineBaseChange A D hG hmax hP
  have hw : (fun k => C.allRootWeight ((allRootIndex J) k)) =
      (fun k => D.allRootWeight ((allRootIndex J) k)) := by
    funext k
    exact congrArg (fun f => (f (P.rootSpanMem ℤ ((allRootIndex J) k))).toNat) hface
  change heightSubgroup _ _ _ _ = heightSubgroup _ _ _ _
  rw [hw]

/-- The actual pullback term and the freshly constructed term are isomorphic,
with their original ambient inclusions preserved. -/
def affineBaseChangeTermIso [Nontrivial R] (d : ℕ) :
    (GroupScheme.baseChange (algebraBaseMap R A)).obj (C.weights.groupScheme d) ≅
      D.weights.groupScheme d := by
  let c := C.weights.inclusion d ≫
    Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter)
  let b := D.weights.inclusion d ≫ Dynamic.Affine.unipotentHom
    (AffineRegularBorel.cocharacter (splitTorus.baseChangeHom (K := A) G I i) D.cocharacter)
  have hm : Mono c.hom.hom := by
    change Mono ((C.weights.inclusion d).hom.hom ≫ _)
    exact mono_comp' (C.weights.isRepresentedBy_inclusion d).1
      (Dynamic.Affine.isRepresentedBy_unipotentHom
        (AffineRegularBorel.cocharacter i C.cocharacter)).1
  have hc : (SubgroupFunctor.range c).IsRepresentedBy c := ⟨hm, rfl⟩
  have hcb := hc.baseChange (algebraBaseMap R A)
  have hb : Mono b.hom.hom := by
    change Mono ((D.weights.inclusion d).hom.hom ≫ _)
    exact mono_comp' (D.weights.isRepresentedBy_inclusion d).1
      (Dynamic.Affine.isRepresentedBy_unipotentHom
        (AffineRegularBorel.cocharacter (splitTorus.baseChangeHom (K := A) G I i)
          D.cocharacter)).1
  exact hcb.isoOfIsRepresentedBy ⟨hb, by
    rw [← SubgroupFunctor.range_baseChangeHom]
    exact (C.range_affineBaseChange_inclusion_eq A D hG hmax hP d).symm⟩

/-- The comparison retains the original ambient map after actual base change. -/
theorem affineBaseChangeTermIso_hom_comp [Nontrivial R] (d : ℕ) :
    (C.affineBaseChangeTermIso A D hG hmax hP d).hom ≫
      (D.weights.inclusion d ≫ Dynamic.Affine.unipotentHom
        (AffineRegularBorel.cocharacter (splitTorus.baseChangeHom (K := A) G I i)
          D.cocharacter)) =
    (GroupScheme.baseChange (algebraBaseMap R A)).map
      (C.weights.inclusion d ≫
        Dynamic.Affine.unipotentHom (AffineRegularBorel.cocharacter i C.cocharacter)) := by
  unfold affineBaseChangeTermIso
  exact SubgroupFunctor.IsRepresentedBy.isoOfIsRepresentedBy_hom_comp _ _

end Langlands.GroupScheme.SplitParabolicFaceChart
