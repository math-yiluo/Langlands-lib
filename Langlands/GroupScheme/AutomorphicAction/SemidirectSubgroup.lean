import Langlands.GroupScheme.AutomorphicAction.SemidirectLift
import Langlands.GroupScheme.ImageGenerationSubgroup
import Langlands.GroupScheme.RepresentedAction
import Langlands.GroupScheme.Dynamic.ClosedSubgroup

/-! # Stable subgroup functors inside an actual semidirect product -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.AutomorphicAction

variable {B : Scheme.{u}} {K G : GroupScheme B}
    (a : AutomorphicAction K G)
    (F : SubgroupFunctor G) (hF : a.IsStable F)

/-- Extend a stable normal-factor subgroup by the entire acting factor.
Membership is imposed on the normal coordinate on every test scheme. -/
def semidirectSubgroup : SubgroupFunctor a.semidirectProduct where
  carrier T :=
    { carrier := {z | (a.semidirectPointsEquiv T z).left ∈ F.carrier T}
      one_mem' := by
        change (a.semidirectPointsEquiv T 1).left ∈ F.carrier T
        rw [map_one]
        exact (F.carrier T).one_mem
      mul_mem' := by
        intro x y hx hy
        change (a.semidirectPointsEquiv T (x * y)).left ∈ F.carrier T
        rw [map_mul, SemidirectProduct.mul_left, pointsAction_apply]
        exact (F.carrier T).mul_mem hx (hF T _ _ hy)
      inv_mem' := by
        intro x hx
        change (a.semidirectPointsEquiv T x⁻¹).left ∈ F.carrier T
        rw [map_inv, SemidirectProduct.inv_left, pointsAction_apply]
        exact hF T _ _ ((F.carrier T).inv_mem hx) }
  comp_mem q z hz := by
    change (a.semidirectPointsEquiv _ (q ≫ z)).left ∈ F.carrier _
    rw [(a.semidirectPointsEquiv_naturality q z).1]
    exact F.comp_mem q hz

theorem mem_semidirectSubgroup {T : Over B} (z : T ⟶ a.semidirectProduct.X) :
    z ∈ (semidirectSubgroup a F hF).carrier T ↔
      (a.semidirectPointsEquiv T z).left ∈ F.carrier T := Iff.rfl

/-- Every semidirect point is the product of its two canonical coordinate points. -/
theorem semidirect_point_decomposition {T : Over B} (z : T ⟶ a.semidirectProduct.X) :
    z = ((a.semidirectPointsEquiv T z).left ≫ a.semidirectInl.hom.hom) *
      ((a.semidirectPointsEquiv T z).right ≫ a.semidirectInr.hom.hom) := by
  apply (a.semidirectPointsEquiv T).injective
  rw [map_mul, semidirectInl_points, semidirectInr_points]
  exact (SemidirectProduct.inl_left_mul_inr_right _).symm

/-- Restriction of the extended subgroup to the normal factor is exactly the
original subgroup, with no smoothness or reducedness hypothesis. -/
theorem semidirectSubgroup_comap_inl :
    (semidirectSubgroup a F hF).comap a.semidirectInl = F := by
  apply SubgroupFunctor.ext
  intro T
  apply Subgroup.ext
  intro g
  change (a.semidirectPointsEquiv T (g ≫ a.semidirectInl.hom.hom)).left ∈
    F.carrier T ↔ g ∈ F.carrier T
  rw [semidirectInl_points, SemidirectProduct.left_inl]

/-- The acting factor lies wholly in the extended subgroup. -/
theorem range_inr_le_semidirectSubgroup :
    SubgroupFunctor.range a.semidirectInr ≤ semidirectSubgroup a F hF := by
  intro T z hz
  rcases SubgroupFunctor.mem_range.1 hz with ⟨k, rfl⟩
  change (a.semidirectPointsEquiv T (k ≫ a.semidirectInr.hom.hom)).left ∈ F.carrier T
  rw [semidirectInr_points]
  exact (F.carrier T).one_mem

/-- The extended subgroup is generated by the original subgroup in the normal
factor and the whole acting factor. -/
theorem semidirectSubgroup_le_iff (V : SubgroupFunctor a.semidirectProduct) :
    semidirectSubgroup a F hF ≤ V ↔
      F.map a.semidirectInl ≤ V ∧ SubgroupFunctor.range a.semidirectInr ≤ V := by
  constructor
  · intro h
    refine ⟨?_, (range_inr_le_semidirectSubgroup a F hF).trans h⟩
    intro T z hz
    rcases SubgroupFunctor.mem_map.1 hz with ⟨g, hg, rfl⟩
    apply h T
    change (a.semidirectPointsEquiv T (g ≫ a.semidirectInl.hom.hom)).left ∈ F.carrier T
    simpa only [semidirectInl_points, SemidirectProduct.left_inl] using hg
  · rintro ⟨hleft, hright⟩ T z hz
    rw [semidirect_point_decomposition a z]
    exact (V.carrier T).mul_mem
      (hleft T ⟨_, hz, rfl⟩) (hright T ⟨_, rfl⟩)

/-- Extension is covariant in the stable normal-factor subgroup. -/
theorem semidirectSubgroup_mono {F' : SubgroupFunctor G} (hF' : a.IsStable F')
    (h : F ≤ F') : semidirectSubgroup a F hF ≤ semidirectSubgroup a F' hF' :=
  fun T _ hz => h T hz

section Maps

variable {H : GroupScheme B} (c : AutomorphicAction K H) (f : H ⟶ G)
    (heq : ∀ (T : Over B) (k : T ⟶ K.X) (h : T ⟶ H.X),
      c.act k h ≫ f.hom.hom = a.act k (h ≫ f.hom.hom))

/-- The exact all-test range of a semidirect map imposes only the original
range condition on the normal coordinate. -/
theorem mem_range_semidirectMap_iff {T : Over B} (z : T ⟶ a.semidirectProduct.X) :
    z ∈ (SubgroupFunctor.range (semidirectMap c a f heq)).carrier T ↔
      (a.semidirectPointsEquiv T z).left ∈ (SubgroupFunctor.range f).carrier T := by
  rw [SubgroupFunctor.mem_range, SubgroupFunctor.mem_range]
  constructor
  · rintro ⟨x, rfl⟩
    rw [semidirectMap_points]
    exact ⟨_, rfl⟩
  · rintro ⟨h, hh⟩
    let x : T ⟶ c.semidirectProduct.X := lift h (a.semidirectPointsEquiv T z).right
    refine ⟨x, ?_⟩
    apply (a.semidirectPointsEquiv T).injective
    rw [semidirectMap_points]
    have hx : c.semidirectPointsEquiv T x =
        ⟨h, (a.semidirectPointsEquiv T z).right⟩ :=
      c.semidirectPointsEquiv_lift h (a.semidirectPointsEquiv T z).right
    rw [hx]
    exact SemidirectProduct.ext hh rfl

/-- A monic equivariant map remains monic after adjoining the same acting
factor, on all tests. -/
theorem semidirectMap_mono [Mono f.hom.hom] :
    Mono (semidirectMap c a f heq).hom.hom := by
  constructor
  intro T x y hxy
  have h := congrArg (a.semidirectPointsEquiv T) hxy
  rw [semidirectMap_points, semidirectMap_points] at h
  apply (c.semidirectPointsEquiv T).injective
  apply SemidirectProduct.ext
  · exact (cancel_mono f.hom.hom).mp (congrArg SemidirectProduct.left h)
  · exact congrArg (fun w : SemidirectProduct (T ⟶ G.X) (T ⟶ K.X)
        (a.pointsAction T) => w.right) h

/-- Closedness of an equivariant normal-factor inclusion passes to the
actual semidirect map. -/
theorem isClosedSubgroup_semidirectMap (hf : IsClosedSubgroup f) :
    IsClosedSubgroup (semidirectMap c a f heq) := by
  let : IsClosedImmersion f.hom.hom.left := hf
  let : IsClosedImmersion (Over.Hom.left (𝟙 K.X)) := by
    change IsClosedImmersion (𝟙 K.X.left)
    infer_instance
  change IsClosedImmersion (semidirectMap c a f heq).hom.hom.left
  rw [semidirectMap_hom]
  exact ImageGeneration.isClosedImmersion_tensorHom_left f.hom.hom (𝟙 K.X)

end Maps

section Representatives

variable {H : GroupScheme B} (f : H ⟶ G) (hf : F.IsRepresentedBy f)

/-- The actual inclusion representing the extension of a stable represented
subgroup by the acting factor. -/
def semidirectSubgroupInclusion :
    (a.onRepresentedSubgroup f hf hF).semidirectProduct ⟶ a.semidirectProduct :=
  semidirectMap (a.onRepresentedSubgroup f hf hF) a f
    (fun _ k h => a.onRepresentedSubgroup_act_comp f hf hF k h)

/-- Stable represented subgroups extend to represented subgroups of the actual
semidirect product. The equality holds on every test scheme. -/
theorem isRepresentedBy_semidirectSubgroupInclusion :
    (semidirectSubgroup a F hF).IsRepresentedBy
      (semidirectSubgroupInclusion a F hF f hf) := by
  have : Mono f.hom.hom := hf.1
  refine ⟨semidirectMap_mono a _ f _, ?_⟩
  apply SubgroupFunctor.ext
  intro T
  apply Subgroup.ext
  intro z
  change z ∈ (SubgroupFunctor.range (semidirectMap
    (a.onRepresentedSubgroup f hf hF) a f _)).carrier T ↔ _
  rw [mem_range_semidirectMap_iff, hf.2]
  rfl

/-- The extended representing inclusion is closed whenever the original
representing inclusion is closed. -/
theorem isClosedSubgroup_semidirectSubgroupInclusion (hfc : IsClosedSubgroup f) :
    IsClosedSubgroup (semidirectSubgroupInclusion a F hF f hf) :=
  isClosedSubgroup_semidirectMap a _ f _ hfc

end Representatives

section ExternalAction

variable {L : GroupScheme B} (b : AutomorphicAction L G)
    (hcomm : ∀ (T : Over B) (s : T ⟶ L.X) (k : T ⟶ K.X) (g : T ⟶ G.X),
      b.act s (a.act k g) = a.act k (b.act s g))

/-- Stability under a commuting external action passes to the extension,
using its actual lifted action. -/
theorem semidirectSubgroup_isStable (hb : b.IsStable F) :
    (a.semidirectLift b hcomm).IsStable (semidirectSubgroup a F hF) := by
  intro T s z hz
  change (a.semidirectPointsEquiv T
    ((a.semidirectLift b hcomm).act s z)).left ∈ F.carrier T
  rw [semidirectLift_act_points]
  exact hb T s _ hz

end ExternalAction

end Langlands.GroupScheme.AutomorphicAction
