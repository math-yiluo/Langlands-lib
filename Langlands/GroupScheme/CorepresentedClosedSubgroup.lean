import Langlands.GroupScheme.CorepresentedPoints
import Langlands.GroupScheme.Reductive.Basic
import Langlands.GroupScheme.Dynamic.GeneralLinear
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Closed subgroup schemes cut out by ideals of a representing algebra

Let `F` be a group-valued functor on commutative `R`-algebras corepresented by an algebra `B`,
so that `Spec B` is an affine group scheme over `Spec R`. A family of subgroups `H A ⊆ F A` is
cut out by an ideal `I` of `B` when a point lies in `H A` exactly when its classifying algebra
map `B → A` kills `I`. Then `B ⧸ I` corepresents `A ↦ H A`, and the induced homomorphism
`Spec (B ⧸ I) → Spec B` is a closed immersion whose points over every scheme `T` over `Spec R`
are the points of `Spec B` lying in `H Γ(T, 𝒪_T)`.

As an application, the block parabolic, block Levi and block unipotent subgroup functors of
`GL_n` for a weight vector `e : n → ℤ` are represented by closed subgroup schemes, with
coordinate rings the quotients of the coordinate ring of `GL_n` by the ideals generated by the
entries `x_ij` with `e i < e j`, the entries `x_ij` with `e i ≠ e j`, and the differences
`x_ij - δ_ij` with `e i ≤ e j`, respectively.
-/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.Corepresented

variable {R : CommRingCat.{u}} {F : CommAlgCat.{u} R ⥤ GrpCat.{u}} {B : CommAlgCat.{u} R}
  (e : (F ⋙ forget GrpCat).CorepresentableBy B)

/-- A family of subgroups `H A` of the groups `F A` is cut out by an ideal `I` of the
representing algebra `B` when a point `x ∈ F A` lies in `H A` exactly when its classifying
algebra map `B → A` vanishes on `I`. -/
def IsCutOutBy (H : ∀ A : CommAlgCat.{u} R, Subgroup (F.obj A)) (I : Ideal B) : Prop :=
  ∀ (A : CommAlgCat.{u} R) (x : F.obj A), x ∈ H A ↔ ∀ b ∈ I, (e.homEquiv.symm x).hom b = 0

variable {e} {H : ∀ A : CommAlgCat.{u} R, Subgroup (F.obj A)} {I : Ideal B}

/-- A family of subgroups cut out by an ideal is preserved by every algebra map. -/
theorem IsCutOutBy.map_mem (hI : IsCutOutBy e H I) {A A' : CommAlgCat.{u} R} (f : A ⟶ A')
    {x : F.obj A} (hx : x ∈ H A) : F.map f x ∈ H A' := by
  rw [hI] at hx ⊢
  intro b hb
  have h : e.homEquiv.symm (F.map f x) = e.homEquiv.symm x ≫ f :=
    (e.homEquiv_symm_comp x f).symm
  rw [h, CommAlgCat.hom_comp, AlgHom.comp_apply, hx b hb, map_zero]

variable (hI : IsCutOutBy e H I)

/-- The group-valued functor `A ↦ H A`, with the maps induced by those of `F`. -/
def cutFunctor : CommAlgCat.{u} R ⥤ GrpCat.{u} where
  obj A := GrpCat.of (H A)
  map f := GrpCat.ofHom
    { toFun := fun x => ⟨F.map f x.1, hI.map_mem f x.2⟩
      map_one' := Subtype.ext (map_one (F.map f).hom)
      map_mul' := fun x y => Subtype.ext (map_mul (F.map f).hom x.1 y.1) }
  map_id A := by
    ext x
    simp
  map_comp f g := by
    ext x
    simp

variable (I) in
/-- The quotient `B ⧸ I` as a commutative `R`-algebra. -/
abbrev quotientAlgebra : CommAlgCat.{u} R := CommAlgCat.of R (B ⧸ I)

variable (I) in
/-- The quotient map `B → B ⧸ I`. -/
abbrev quotientMap : B ⟶ quotientAlgebra I := CommAlgCat.ofHom (Ideal.Quotient.mkₐ R I)

/-- The quotient `B ⧸ I` corepresents the functor `A ↦ H A`: an algebra map `B ⧸ I → A`
corresponds to the point of `F A` classified by its composite with `B → B ⧸ I`. -/
def cutCorepresentableBy :
    (cutFunctor hI ⋙ forget GrpCat).CorepresentableBy (quotientAlgebra I) where
  homEquiv {A} :=
    { toFun := fun f => ⟨e.homEquiv (quotientMap I ≫ f), (hI A _).2 fun b hb => by
        rw [Equiv.symm_apply_apply, CommAlgCat.hom_comp, AlgHom.comp_apply]
        change f.hom (Ideal.Quotient.mk I b) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.2 hb, map_zero]⟩
      invFun := fun x => CommAlgCat.ofHom
        (Ideal.Quotient.liftₐ I (e.homEquiv.symm x.1).hom ((hI A x.1).1 x.2))
      left_inv := fun f => by
        apply CommAlgCat.hom_ext
        apply Ideal.Quotient.algHom_ext
        rw [CommAlgCat.hom_ofHom, Ideal.Quotient.liftₐ_comp]
        change (e.homEquiv.symm (e.homEquiv (quotientMap I ≫ f))).hom = _
        rw [Equiv.symm_apply_apply, CommAlgCat.hom_comp]
        rfl
      right_inv := fun x => by
        apply Subtype.ext
        change e.homEquiv (quotientMap I ≫ CommAlgCat.ofHom
          (Ideal.Quotient.liftₐ I (e.homEquiv.symm x.1).hom ((hI A x.1).1 x.2))) = x.1
        have h : quotientMap I ≫ CommAlgCat.ofHom
            (Ideal.Quotient.liftₐ I (e.homEquiv.symm x.1).hom ((hI A x.1).1 x.2)) =
              e.homEquiv.symm x.1 := by
          apply CommAlgCat.hom_ext
          rw [CommAlgCat.hom_comp, CommAlgCat.hom_ofHom]
          exact Ideal.Quotient.liftₐ_comp _ _ _
        rw [h, Equiv.apply_symm_apply] }
  homEquiv_comp {A A'} g f := by
    apply Subtype.ext
    change e.homEquiv (quotientMap I ≫ f ≫ g) = F.map g (e.homEquiv (quotientMap I ≫ f))
    rw [← Category.assoc]
    exact e.homEquiv_comp g _

/-- The affine group scheme `Spec (B ⧸ I)` over `Spec R` whose points are the subgroups
`H`. -/
abbrev cutGroupScheme : GroupScheme (Spec R) :=
  groupScheme (cutFunctor hI) (cutCorepresentableBy hI)

/-- The natural inclusion of the subgroups `H A` into `F A`. -/
def cutInclusion : cutFunctor hI ⟶ F where
  app A := GrpCat.ofHom (H A).subtype

/-- The homomorphism `Spec (B ⧸ I) → Spec B` induced by the inclusion of `H` into `F`. -/
def cutHom : cutGroupScheme hI ⟶ groupScheme F e :=
  groupSchemeMap (cutCorepresentableBy hI) e (cutInclusion hI)

/-- The underlying morphism of schemes of `cutHom` is the spectrum of the quotient map
`B → B ⧸ I`. -/
theorem cutHom_left :
    (cutHom hI).hom.hom.left = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) := by
  have h : e.homEquiv.symm ((cutInclusion hI).app (quotientAlgebra I)
      ((cutCorepresentableBy hI).homEquiv (𝟙 _))) = quotientMap I := by
    change e.homEquiv.symm (e.homEquiv (quotientMap I ≫ 𝟙 _)) = _
    rw [Equiv.symm_apply_apply, Category.comp_id]
  rw [cutHom, groupSchemeMap_hom, h]
  rfl

/-- The homomorphism `Spec (B ⧸ I) → Spec B` is a closed immersion. -/
instance isClosedImmersion_cutHom : IsClosedImmersion (cutHom hI).hom.hom.left := by
  rw [cutHom_left]
  exact IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- `Spec (B ⧸ I)` is a closed subgroup of `Spec B`. -/
theorem isClosedSubgroup_cutHom : IsClosedSubgroup (cutHom hI) :=
  isClosedImmersion_cutHom hI

/-- The homomorphism `Spec (B ⧸ I) → Spec B` is a monomorphism of schemes over `Spec R`. -/
instance mono_cutHom : Mono (cutHom hI).hom.hom :=
  Over.mono_of_mono_left _

/-- The subgroup functor of `Spec B` whose points over a scheme `T` over `Spec R` are the points
whose image in `F Γ(T, 𝒪_T)` lies in `H Γ(T, 𝒪_T)`. -/
def cutSubgroupFunctor : SubgroupFunctor (groupScheme F e) where
  carrier T := (H ((algΓ R).obj T).unop).comap (pointsEquiv F e T).toMonoidHom
  comp_mem a x hx := by
    change pointsEquiv F e _ (a ≫ x) ∈ H _
    rw [pointsEquiv_naturality]
    exact hI.map_mem _ hx

theorem mem_cutSubgroupFunctor {T : Over (Spec R)} {x : T ⟶ (groupScheme F e).X} :
    x ∈ (cutSubgroupFunctor hI).carrier T ↔ pointsEquiv F e T x ∈ H ((algΓ R).obj T).unop :=
  Iff.rfl

/-- The points of `Spec B` factoring through `Spec (B ⧸ I)` are exactly those in `H`, on every
scheme over `Spec R`. -/
theorem range_cutHom : SubgroupFunctor.range (cutHom hI) = cutSubgroupFunctor hI := by
  ext T x
  rw [SubgroupFunctor.mem_range, mem_cutSubgroupFunctor]
  constructor
  · rintro ⟨y, rfl⟩
    rw [cutHom, groupSchemeMap_points]
    exact (pointsEquiv (cutFunctor hI) (cutCorepresentableBy hI) T y).2
  · intro hx
    let y : (cutFunctor hI).obj ((algΓ R).obj T).unop := ⟨_, hx⟩
    refine ⟨(pointsEquiv (cutFunctor hI) (cutCorepresentableBy hI) T).symm y, ?_⟩
    apply (pointsEquiv F e T).injective
    rw [cutHom, groupSchemeMap_points]
    exact congrArg Subtype.val
      ((pointsEquiv (cutFunctor hI) (cutCorepresentableBy hI) T).apply_symm_apply y)

/-- The subgroup functor `H` of `Spec B` is represented by the closed subgroup scheme
`Spec (B ⧸ I)`. -/
theorem isRepresentedBy_cutHom : (cutSubgroupFunctor hI).IsRepresentedBy (cutHom hI) :=
  ⟨inferInstance, range_cutHom hI⟩

end Langlands.GroupScheme.Corepresented

namespace Langlands.GroupScheme.GeneralLinear

open MvPolynomial

variable {n : Type} [Fintype n] [DecidableEq n] {R : CommRingCat.{u}}

variable (n R) in
/-- The ideal of the coordinate ring of `GL_n` generated by the functions `x_ij - c_ij` for the
positions `(i, j)` with `p i j`, where `x_ij` is the `(i, j)` entry. -/
def entryIdeal (p : n → n → Prop) (c : n → n → R) : Ideal (CoordinateRing n R) :=
  Ideal.span {b | ∃ i j, p i j ∧
    quotient n R (X (Coordinate.entry i j)) - algebraMap R (CoordinateRing n R) (c i j) = b}

/-- The algebra map classifying an invertible matrix `g` kills `entryIdeal n R p c` exactly when
`g i j = c i j` for all positions with `p i j`. -/
theorem classify_eq_zero_iff {S : Type u} [CommRing S] [Algebra R S] (g : GL n S)
    (p : n → n → Prop) (c : n → n → R) :
    (∀ b ∈ entryIdeal n R p c, classify (R := R) g b = 0) ↔
      ∀ i j, p i j → (g : Matrix n n S) i j = algebraMap R S (c i j) := by
  constructor
  · intro h i j hij
    have hb := h _ (Ideal.subset_span ⟨i, j, hij, rfl⟩)
    rwa [map_sub, classify_entry, AlgHom.commutes, sub_eq_zero] at hb
  · intro h b hb
    have hle : entryIdeal n R p c ≤ RingHom.ker (classify (R := R) g) := by
      rw [entryIdeal, Ideal.span_le]
      rintro _ ⟨i, j, hij, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, classify_entry, AlgHom.commutes, h i j hij,
        sub_self]
    exact hle hb

/-- A family of subgroups of `GL_n` defined by the conditions `g i j = c i j` for the positions
with `p i j` is cut out by `entryIdeal n R p c`. -/
theorem isCutOutBy_entryIdeal (p : n → n → Prop) (c : n → n → R)
    (H : ∀ A : CommAlgCat.{u} R, Subgroup ((functor n R).obj A))
    (hH : ∀ (A : CommAlgCat.{u} R) (g : GL n A),
      g ∈ H A ↔ ∀ i j, p i j → (g : Matrix n n A) i j = algebraMap R A (c i j)) :
    Corepresented.IsCutOutBy (corepresentableBy n R) H (entryIdeal n R p c) := fun A g =>
  (hH A g).trans (classify_eq_zero_iff g p c).symm

variable (e : n → ℤ)

/-- The block parabolic subgroups are cut out by the entries `x_ij` with `e i < e j`. -/
theorem isCutOutBy_blockParabolic :
    Corepresented.IsCutOutBy (corepresentableBy n R) (fun A => blockParabolicSubgroup A e)
      (entryIdeal n R (fun i j => e i < e j) 0) :=
  isCutOutBy_entryIdeal _ _ _ fun A g => by
    change (∀ i j, e i < e j → (g : Matrix n n A) i j = 0) ↔ _
    simp only [Pi.zero_apply, map_zero]

/-- The block Levi subgroups are cut out by the entries `x_ij` with `e i ≠ e j`. -/
theorem isCutOutBy_blockLevi :
    Corepresented.IsCutOutBy (corepresentableBy n R) (fun A => blockLeviSubgroup A e)
      (entryIdeal n R (fun i j => e i ≠ e j) 0) :=
  isCutOutBy_entryIdeal _ _ _ fun A g => by
    change (∀ i j, e i ≠ e j → (g : Matrix n n A) i j = 0) ↔ _
    simp only [Pi.zero_apply, map_zero]

/-- The block unipotent subgroups are cut out by the functions `x_ij - δ_ij` with `e i ≤ e j`. -/
theorem isCutOutBy_blockUnipotent :
    Corepresented.IsCutOutBy (corepresentableBy n R) (fun A => blockUnipotentSubgroup A e)
      (entryIdeal n R (fun i j => e i ≤ e j) (fun i j => (1 : Matrix n n R) i j)) :=
  isCutOutBy_entryIdeal _ _ _ fun A g => by
    change (∀ i j, e i ≤ e j → (g : Matrix n n A) i j = (1 : Matrix n n A) i j) ↔ _
    have h1 : ∀ i j, algebraMap R A ((1 : Matrix n n R) i j) = (1 : Matrix n n A) i j :=
      fun i j => congrFun (congrFun (map_one (algebraMap R A).mapMatrix) i) j
    simp only [h1]

variable (n R)

/-- The block parabolic subgroup scheme of `GL_n` for the weights `e`: the spectrum of the
quotient of the coordinate ring of `GL_n` by the entries `x_ij` with `e i < e j`. -/
abbrev blockParabolicScheme : GroupScheme (Spec R) :=
  Corepresented.cutGroupScheme (isCutOutBy_blockParabolic (n := n) (R := R) e)

/-- The block Levi subgroup scheme of `GL_n` for the weights `e`: the spectrum of the quotient
of the coordinate ring of `GL_n` by the entries `x_ij` with `e i ≠ e j`. -/
abbrev blockLeviScheme : GroupScheme (Spec R) :=
  Corepresented.cutGroupScheme (isCutOutBy_blockLevi (n := n) (R := R) e)

/-- The block unipotent subgroup scheme of `GL_n` for the weights `e`: the spectrum of the
quotient of the coordinate ring of `GL_n` by the functions `x_ij - δ_ij` with `e i ≤ e j`. -/
abbrev blockUnipotentScheme : GroupScheme (Spec R) :=
  Corepresented.cutGroupScheme (isCutOutBy_blockUnipotent (n := n) (R := R) e)

/-- The inclusion of the block parabolic subgroup scheme into `GL_n`, a closed immersion. -/
abbrev blockParabolicHom : blockParabolicScheme n R e ⟶ groupScheme n R :=
  Corepresented.cutHom _

/-- The inclusion of the block Levi subgroup scheme into `GL_n`, a closed immersion. -/
abbrev blockLeviHom : blockLeviScheme n R e ⟶ groupScheme n R :=
  Corepresented.cutHom _

/-- The inclusion of the block unipotent subgroup scheme into `GL_n`, a closed immersion. -/
abbrev blockUnipotentHom : blockUnipotentScheme n R e ⟶ groupScheme n R :=
  Corepresented.cutHom _

theorem cutSubgroupFunctor_blockParabolic :
    Corepresented.cutSubgroupFunctor (isCutOutBy_blockParabolic (n := n) (R := R) e) =
      blockParabolic n R e :=
  rfl

theorem cutSubgroupFunctor_blockLevi :
    Corepresented.cutSubgroupFunctor (isCutOutBy_blockLevi (n := n) (R := R) e) =
      blockLevi n R e :=
  rfl

theorem cutSubgroupFunctor_blockUnipotent :
    Corepresented.cutSubgroupFunctor (isCutOutBy_blockUnipotent (n := n) (R := R) e) =
      blockUnipotent n R e :=
  rfl

/-- The block parabolic subgroup functor of `GL_n` is represented by a closed subgroup scheme. -/
theorem isRepresentedBy_blockParabolic :
    (blockParabolic n R e).IsRepresentedBy (blockParabolicHom n R e) :=
  Corepresented.isRepresentedBy_cutHom _

/-- The block Levi subgroup functor of `GL_n` is represented by a closed subgroup scheme. -/
theorem isRepresentedBy_blockLevi :
    (blockLevi n R e).IsRepresentedBy (blockLeviHom n R e) :=
  Corepresented.isRepresentedBy_cutHom _

/-- The block unipotent subgroup functor of `GL_n` is represented by a closed subgroup scheme. -/
theorem isRepresentedBy_blockUnipotent :
    (blockUnipotent n R e).IsRepresentedBy (blockUnipotentHom n R e) :=
  Corepresented.isRepresentedBy_cutHom _

theorem isClosedSubgroup_blockParabolicHom : IsClosedSubgroup (blockParabolicHom n R e) :=
  Corepresented.isClosedSubgroup_cutHom _

theorem isClosedSubgroup_blockLeviHom : IsClosedSubgroup (blockLeviHom n R e) :=
  Corepresented.isClosedSubgroup_cutHom _

theorem isClosedSubgroup_blockUnipotentHom : IsClosedSubgroup (blockUnipotentHom n R e) :=
  Corepresented.isClosedSubgroup_cutHom _

end Langlands.GroupScheme.GeneralLinear
