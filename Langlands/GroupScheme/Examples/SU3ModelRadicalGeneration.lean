import Langlands.GroupScheme.Examples.SU3WeilAmbientGeneration

/-! # Parabolic radical generation for actual SU3 models -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.SU3Root

namespace SchemeModel

variable (k L : Type u) [Field k] [Field L] [Algebra k L]
  [Algebra.IsQuadraticExtension k L] [Algebra.IsSeparable k L]
  {A G : GroupScheme (Spec (CommRingCat.of k))}

/-- Actual source isomorphisms transport full SU3 image containment into any normal
subgroup containing the composed upper dynamics. -/
theorem rationalPoints_range_le_of_iso_upper_dynamic
    (e : A ≅ groupScheme k L) (a : A ⟶ G)
    (N : Subgroup (rationalPoints G)) [N.Normal]
    (hu : (Dynamic.unipotent (cocharacter k L ≫ e.inv ≫ a)).carrier
      (Over.mk (𝟙 _)) ≤ N) :
    (rationalPoints.map a).range ≤ N := by
  have h := rationalPoints_range_le_of_upper_dynamic k L (e.inv ≫ a) N hu
  rintro _ ⟨x, rfl⟩
  have hx := h ⟨rationalPoints.map e.hom x, rfl⟩
  simpa only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc,
    ← Grp.comp_hom_hom, e.hom_inv_id_assoc] using hx

/-- Full rational images of actual models isomorphic to SU3 lie in the target's
actual parabolic elementary subgroup. -/
theorem rationalPoints_range_le_parabolicElementarySubgroup_of_iso
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme k L) (a : A ⟶ G) :
    (rationalPoints.map a).range ≤ parabolicElementarySubgroup G :=
  rationalPoints_range_le_of_iso_upper_dynamic k L e a (parabolicElementarySubgroup G)
    (dynamicUnipotent_le_parabolicElementarySubgroup hG (cocharacter k L ≫ e.inv ≫ a))

/-- The original rational map from an actual SU3 model, with restricted target. -/
def rationalPointsToParabolicElementarySubgroup
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme k L) (a : A ⟶ G) :
    rationalPoints A →* parabolicElementarySubgroup G :=
  (rationalPoints.map a).codRestrict (parabolicElementarySubgroup G) fun x =>
    rationalPoints_range_le_parabolicElementarySubgroup_of_iso k L hG e a ⟨x, rfl⟩

@[simp] theorem rationalPointsToParabolicElementarySubgroup_apply_coe
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme k L) (a : A ⟶ G)
    (x : rationalPoints A) :
    (rationalPointsToParabolicElementarySubgroup k L hG e a x :
      rationalPoints G) = rationalPoints.map a x := rfl

/-- A connected reductive actual SU3 model is generated by its actual rational
parabolic radicals. -/
theorem parabolicElementarySubgroup_eq_top_of_iso
    (hA : IsConnectedReductive A) (e : A ≅ groupScheme k L) :
    parabolicElementarySubgroup A = ⊤ := by
  apply top_unique
  intro x _
  have hx := rationalPoints_range_le_parabolicElementarySubgroup_of_iso k L hA e
    (𝟙 A) ⟨x, rfl⟩
  simpa only [rationalPoints.map_apply, Grp.id_hom_hom, Category.comp_id] using hx

/-- Any subgroup containing every actual rational parabolic radical of an actual
SU3 model is the whole rational group. -/
theorem eq_top_of_parabolic_radicals_of_iso
    (hA : IsConnectedReductive A) (e : A ≅ groupScheme k L)
    (N : Subgroup (rationalPoints A))
    (hrad : ∀ (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ A) (r : U ⟶ P),
      IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
        (rationalPoints.map (r ≫ p)).range ≤ N) : N = ⊤ := by
  apply top_unique
  rw [← parabolicElementarySubgroup_eq_top_of_iso k L hA e]
  exact (parabolicElementarySubgroup_le_iff N).mpr hrad

end SchemeModel

namespace WeilSchemeModel

variable (F k L : Type u) [Field F] [Field k] [Field L]
  [Algebra F k] [FiniteDimensional F k] [Algebra k L]
  [Algebra.IsQuadraticExtension k L] [Algebra.IsSeparable k L]
  {A G : GroupScheme (Spec (CommRingCat.of F))}

/-- Actual source isomorphisms transport restricted SU3 full-image containment into
normal subgroups containing the composed ground-base upper dynamics. -/
theorem rationalPoints_range_le_of_iso_upper_dynamic
    (e : A ≅ groupScheme F k L) (a : A ⟶ G)
    (N : Subgroup (rationalPoints G)) [N.Normal]
    (hu : (Dynamic.unipotent (cocharacter F k L ≫ e.inv ≫ a)).carrier
      (Over.mk (𝟙 _)) ≤ N) :
    (rationalPoints.map a).range ≤ N := by
  have h := rationalPoints_range_le_of_upper_dynamic F k L (e.inv ≫ a) N hu
  rintro _ ⟨x, rfl⟩
  have hx := h ⟨rationalPoints.map e.hom x, rfl⟩
  simpa only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc,
    ← Grp.comp_hom_hom, e.hom_inv_id_assoc] using hx

/-- The full original rational image of an actual restricted SU3 model lies in the
target's actual parabolic elementary subgroup. -/
theorem rationalPoints_range_le_parabolicElementarySubgroup_of_iso
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme F k L) (a : A ⟶ G) :
    (rationalPoints.map a).range ≤ parabolicElementarySubgroup G :=
  rationalPoints_range_le_of_iso_upper_dynamic F k L e a (parabolicElementarySubgroup G)
    (dynamicUnipotent_le_parabolicElementarySubgroup hG
      (cocharacter F k L ≫ e.inv ≫ a))

/-- The actual restricted-model rational map with codomain in the target's
parabolic elementary subgroup. -/
def rationalPointsToParabolicElementarySubgroup
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme F k L) (a : A ⟶ G) :
    rationalPoints A →* parabolicElementarySubgroup G :=
  (rationalPoints.map a).codRestrict (parabolicElementarySubgroup G) fun x =>
    rationalPoints_range_le_parabolicElementarySubgroup_of_iso F k L hG e a ⟨x, rfl⟩

@[simp] theorem rationalPointsToParabolicElementarySubgroup_apply_coe
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme F k L) (a : A ⟶ G)
    (x : rationalPoints A) :
    (rationalPointsToParabolicElementarySubgroup F k L hG e a x :
      rationalPoints G) = rationalPoints.map a x := rfl

/-- Every connected reductive actual model of the restricted SU3 group is generated
by its actual rational parabolic radicals. -/
theorem parabolicElementarySubgroup_eq_top_of_iso
    (hA : IsConnectedReductive A) (e : A ≅ groupScheme F k L) :
    parabolicElementarySubgroup A = ⊤ := by
  apply top_unique
  intro x _
  have hx := rationalPoints_range_le_parabolicElementarySubgroup_of_iso F k L hA e
    (𝟙 A) ⟨x, rfl⟩
  simpa only [rationalPoints.map_apply, Grp.id_hom_hom, Category.comp_id] using hx

/-- Every subgroup containing the actual rational parabolic radicals of an actual
restricted SU3 model is the whole group; no normality premise is needed. -/
theorem eq_top_of_parabolic_radicals_of_iso
    (hA : IsConnectedReductive A) (e : A ≅ groupScheme F k L)
    (N : Subgroup (rationalPoints A))
    (hrad : ∀ (P U : GroupScheme (Spec (CommRingCat.of F))) (p : P ⟶ A) (r : U ⟶ P),
      IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
        (rationalPoints.map (r ≫ p)).range ≤ N) : N = ⊤ := by
  apply top_unique
  rw [← parabolicElementarySubgroup_eq_top_of_iso F k L hA e]
  exact (parabolicElementarySubgroup_le_iff N).mpr hrad

end WeilSchemeModel
end Langlands.GroupScheme.SU3Root
