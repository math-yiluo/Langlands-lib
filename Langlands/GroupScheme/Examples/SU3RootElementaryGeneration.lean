import Langlands.GroupScheme.Examples.SU3RootReflection
import Langlands.GroupScheme.Examples.SU3RootParametersQuadratic

/-! # Root-generated diagonal and Weyl matrices for the quadratic coordinate model -/

noncomputable section

namespace Langlands.GroupScheme.SU3Root

universe u v

section Ring

variable {A : Type u} [CommRing A] (c : RingInvolution A)

/-- The subgroup of actual invertible matrices generated by the two coordinate images. -/
def elementarySubgroup : Subgroup (Matrix.GeneralLinearGroup (Fin 3) A) :=
  (Parameters.embedding c).range ⊔ (oppositeEmbedding c).range

theorem embedding_mem_elementarySubgroup (x : Parameters c) :
    Parameters.embedding c x ∈ elementarySubgroup c :=
  (show (Parameters.embedding c).range ≤ elementarySubgroup c from le_sup_left)
    ⟨x, rfl⟩

theorem oppositeEmbedding_mem_elementarySubgroup (x : Parameters c) :
    oppositeEmbedding c x ∈ elementarySubgroup c :=
  (show (oppositeEmbedding c).range ≤ elementarySubgroup c from le_sup_right)
    ⟨x, rfl⟩

end Ring

section Field

variable {L : Type u} [Field L] {c : RingInvolution L}

theorem reflectionMatrix_mem_elementarySubgroup (x : Parameters c) (hx : x.second ≠ 0) :
    reflectionMatrix c (Units.mk0 x.second hx) ∈ elementarySubgroup c := by
  rw [← opposite_factorization x hx]
  exact (elementarySubgroup c).mul_mem
    ((elementarySubgroup c).mul_mem
      (oppositeEmbedding_mem_elementarySubgroup c _)
      (embedding_mem_elementarySubgroup c _))
    (oppositeEmbedding_mem_elementarySubgroup c _)

theorem diagonal_ratio_mem_elementarySubgroup (x y : Parameters c)
    (hx : x.second ≠ 0) (hy : y.second ≠ 0) :
    diagonal c (Units.mk0 x.second hx * (Units.mk0 y.second hy)⁻¹) ∈
      elementarySubgroup c := by
  rw [← reflectionMatrix_mul_inv]
  exact (elementarySubgroup c).mul_mem
    (reflectionMatrix_mem_elementarySubgroup x hx)
    ((elementarySubgroup c).inv_mem (reflectionMatrix_mem_elementarySubgroup y hy))

namespace Parameters

/-- A trace-one second coordinate built from a scalar moved by the involution. -/
def traceOneOfNonfixed (a : L) (ha : c.bar a ≠ a) : Parameters c :=
  ⟨(1, a / (a - c.bar a)), by
    have hd : a - c.bar a ≠ 0 := sub_ne_zero.mpr (Ne.symm ha)
    change a / (a - c.bar a) + c.bar (a / (a - c.bar a)) = 1 * c.bar 1
    simp only [map_div₀, map_sub, RingInvolution.bar_bar, map_one, one_mul]
    rw [show c.bar a - a = -(a - c.bar a) by ring, div_neg]
    field_simp
    ring⟩

/-- A nonzero trace-zero second coordinate from the same nonfixed scalar. -/
def traceZeroOfNonfixed (a : L) (_ha : c.bar a ≠ a) : Parameters c :=
  ⟨(0, (a - c.bar a)⁻¹), by
    change (a - c.bar a)⁻¹ + c.bar ((a - c.bar a)⁻¹) = 0 * c.bar 0
    simp only [map_inv₀, map_sub, RingInvolution.bar_bar, zero_mul]
    rw [show c.bar a - a = -(a - c.bar a) by ring, inv_neg, add_neg_cancel]⟩

@[simp] theorem traceOneOfNonfixed_first (a : L) (ha : c.bar a ≠ a) :
    (traceOneOfNonfixed a ha).first = 1 := rfl

@[simp] theorem traceOneOfNonfixed_second (a : L) (ha : c.bar a ≠ a) :
    (traceOneOfNonfixed a ha).second = a / (a - c.bar a) := rfl

@[simp] theorem traceZeroOfNonfixed_first (a : L) (ha : c.bar a ≠ a) :
    (traceZeroOfNonfixed a ha).first = 0 := rfl

@[simp] theorem traceZeroOfNonfixed_second (a : L) (ha : c.bar a ≠ a) :
    (traceZeroOfNonfixed a ha).second = (a - c.bar a)⁻¹ := rfl

theorem traceOneOfNonfixed_second_ne_zero (a : L) (ha : c.bar a ≠ a) :
    (traceOneOfNonfixed a ha).second ≠ 0 := by
  have ha0 : a ≠ 0 := by
    intro h
    exact ha (by simp [h])
  exact div_ne_zero ha0 (sub_ne_zero.mpr (Ne.symm ha))

theorem traceZeroOfNonfixed_second_ne_zero (a : L) (ha : c.bar a ≠ a) :
    (traceZeroOfNonfixed a ha).second ≠ 0 :=
  inv_ne_zero (sub_ne_zero.mpr (Ne.symm ha))

end Parameters

/-- A nonfixed unit is a ratio of second coordinates of two actual root parameters. -/
theorem diagonal_mem_elementarySubgroup_of_nonfixed (t : Lˣ)
    (ht : c.bar (t : L) ≠ (t : L)) :
    diagonal c t ∈ elementarySubgroup c := by
  let x := Parameters.traceOneOfNonfixed (t : L) ht
  let y := Parameters.traceZeroOfNonfixed (t : L) ht
  have hx : x.second ≠ 0 := Parameters.traceOneOfNonfixed_second_ne_zero _ ht
  have hy : y.second ≠ 0 := Parameters.traceZeroOfNonfixed_second_ne_zero _ ht
  have hratio : Units.mk0 x.second hx * (Units.mk0 y.second hy)⁻¹ = t := by
    apply Units.ext
    change ((t : L) / ((t : L) - c.bar (t : L))) *
      (((t : L) - c.bar (t : L))⁻¹)⁻¹ = (t : L)
    rw [inv_inv, div_mul_cancel₀ _ (sub_ne_zero.mpr (Ne.symm ht))]
  simpa only [hratio] using diagonal_ratio_mem_elementarySubgroup x y hx hy

/-- Every scalar-unit diagonal is generated if the field involution is nonidentity. -/
theorem diagonal_mem_elementarySubgroup
    (hc : ∃ a : L, c.bar a ≠ a) (t : Lˣ) :
    diagonal c t ∈ elementarySubgroup c := by
  by_cases ht : c.bar (t : L) = (t : L)
  · obtain ⟨a, ha⟩ := hc
    have ha0 : a ≠ 0 := by
      intro h
      exact ha (by simp [h])
    let s : Lˣ := Units.mk0 a ha0
    have hs : c.bar (s : L) ≠ (s : L) := ha
    have hquot : c.bar ((t * s⁻¹ : Lˣ) : L) ≠ ((t * s⁻¹ : Lˣ) : L) := by
      intro h
      apply ha
      have h' : c.bar a⁻¹ = a⁻¹ := by
        apply mul_left_cancel₀ t.ne_zero
        simpa only [Units.val_mul, Units.val_inv_eq_inv_val, map_mul,
          ht, s, Units.val_mk0] using h
      have h'' := congrArg Inv.inv h'
      simpa only [map_inv₀, inv_inv] using h''
    have hmul : s * (t * s⁻¹) = t := by
      simp [mul_left_comm]
    rw [← hmul, diagonal_mul]
    exact (elementarySubgroup c).mul_mem
      (diagonal_mem_elementarySubgroup_of_nonfixed s hs)
      (diagonal_mem_elementarySubgroup_of_nonfixed (t * s⁻¹) hquot)
  · exact diagonal_mem_elementarySubgroup_of_nonfixed t ht

/-- A nonidentity field involution makes the actual Weyl representative root-generated. -/
theorem weylElement_mem_elementarySubgroup (hc : ∃ a : L, c.bar a ≠ a) :
    (weylElement : Matrix.GeneralLinearGroup (Fin 3) L) ∈ elementarySubgroup c := by
  obtain ⟨a, ha⟩ := hc
  let x := Parameters.traceZeroOfNonfixed a ha
  have hx : x.second ≠ 0 := Parameters.traceZeroOfNonfixed_second_ne_zero a ha
  have hd := diagonal_mem_elementarySubgroup ⟨a, ha⟩ (Units.mk0 x.second hx)
  have hr := reflectionMatrix_mem_elementarySubgroup x hx
  have h := (elementarySubgroup c).mul_mem ((elementarySubgroup c).inv_mem hd) hr
  simpa only [reflectionMatrix, inv_mul_cancel_left] using h

end Field

section Quadratic

variable (k : Type u) (L : Type v) [Field k] [Field L] [Algebra k L]
  [Algebra.IsQuadraticExtension k L] [Algebra.IsSeparable k L]

theorem fieldInvolution_exists_nonfixed :
    ∃ a : L, (fieldInvolution k L).bar a ≠ a := by
  by_contra h
  apply conjugation_ne_one k L
  ext a
  exact not_not.mp (not_exists.mp h a)

theorem diagonal_mem_elementarySubgroup_quadratic (t : Lˣ) :
    diagonal (fieldInvolution k L) t ∈ elementarySubgroup (fieldInvolution k L) :=
  diagonal_mem_elementarySubgroup (fieldInvolution_exists_nonfixed k L) t

theorem weylElement_mem_elementarySubgroup_quadratic :
    (weylElement : Matrix.GeneralLinearGroup (Fin 3) L) ∈
      elementarySubgroup (fieldInvolution k L) :=
  weylElement_mem_elementarySubgroup (fieldInvolution_exists_nonfixed k L)

end Quadratic

end Langlands.GroupScheme.SU3Root
