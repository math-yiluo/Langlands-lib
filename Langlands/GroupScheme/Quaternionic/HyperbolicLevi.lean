import Langlands.GroupScheme.Quaternionic.EichlerTransformations
import Mathlib.Tactic.Group

/-!
# The Levi subgroup and the Eichler subgroup of a hyperbolic pair

Let `(e, f)` be a hyperbolic pair of a `σ`-quadratic form `q` on row vectors `D^n`:
`q(e) = q(f) = 0` and `h(e, f) = 1`.

* `levi` is the group homomorphism `Dˣ → GL_n(D)`, `a ↦ ℓ(a)`, where `ℓ(a)` sends
  `e ↦ a e`, `f ↦ σ(a)⁻¹ f` and fixes `{e, f}^⊥`.
* `eichlerSubgroup` is the subgroup `E` generated by the Eichler transformations along `e`
  and along `f`; it is normalized by every `ℓ(a)`.
* `weylMatrix` is the product `m_{x,c}` of three Eichler transformations, which swaps the
  lines `D e` and `D f` and acts on `{e, f}^⊥` as the reflection `ρ_{x,c}`.
* `eichlerLeviSubgroup` is the normal subgroup `N_E = {a | ℓ(a) ∈ E}` of `Dˣ`; it contains the
  nonzero scalars and the commutators `g⁻¹ z g z⁻¹` for `z = σ(c) σ(a₀)⁻¹`.

The main result `mem_sup_of_vecMul_eq_smul`: if `{e, f}^⊥` is anisotropic and `σ` has a
nonzero alternating element, every rational isometry preserving the lines `D e` and `D f`
lies in `ℓ(Dˣ) ⊔ E`.
-/

noncomputable section

universe u v w

open Matrix

namespace Langlands.GroupScheme.Quaternionic

namespace FirstKindInvolution.Eichler

variable {K : Type u} {D : Type v} [Field K] [DivisionRing D] [Algebra K D]
  (σ : FirstKindInvolution K D) {n : Type w} [Fintype n] [DecidableEq n]
  (q : σ.QuadraticForms n)

/-- A hyperbolic pair `(e, f)` of `q`: `q(e) = q(f) = 0` and `h(e, f) = 1`. -/
structure IsHyperbolic (e f : n → D) : Prop where
  quadraticValue_left : σ.quadraticValue e q = 0
  quadraticValue_right : σ.quadraticValue f q = 0
  sesqForm_eq_one : σ.sesqForm (σ.polar q) e f = 1

namespace IsHyperbolic

variable {σ q} {e f : n → D} (hP : IsHyperbolic σ q e f)
include hP

theorem sesqForm_left_left : σ.sesqForm (σ.polar q) e e = 0 :=
  sesqForm_polar_self_eq_zero σ q e hP.quadraticValue_left

theorem sesqForm_right_right : σ.sesqForm (σ.polar q) f f = 0 :=
  sesqForm_polar_self_eq_zero σ q f hP.quadraticValue_right

theorem sesqForm_right_left : σ.sesqForm (σ.polar q) f e = 1 := by
  rw [← sesqForm_polar_swap, hP.sesqForm_eq_one, map_one]

theorem symm : IsHyperbolic σ q f e :=
  ⟨hP.quadraticValue_right, hP.quadraticValue_left, hP.sesqForm_right_left⟩

/-- The component of `v` orthogonal to `e` and `f` is orthogonal to `e`. -/
theorem sesqForm_proj_left (v : n → D) :
    σ.sesqForm (σ.polar q)
      (v - σ.sesqForm (σ.polar q) v f • e - σ.sesqForm (σ.polar q) v e • f) e = 0 := by
  simp only [sesqForm_sub_left, sesqForm_smul_left, hP.sesqForm_left_left,
    hP.sesqForm_right_left, mul_zero, mul_one, sub_zero, sub_self]

/-- The component of `v` orthogonal to `e` and `f` is orthogonal to `f`. -/
theorem sesqForm_proj_right (v : n → D) :
    σ.sesqForm (σ.polar q)
      (v - σ.sesqForm (σ.polar q) v f • e - σ.sesqForm (σ.polar q) v e • f) f = 0 := by
  simp only [sesqForm_sub_left, sesqForm_smul_left, hP.sesqForm_eq_one,
    hP.sesqForm_right_right, mul_zero, mul_one, sub_self]

/-- A matrix acting on row vectors is determined by its values on `e`, `f` and on the
orthogonal complement `{e, f}^⊥`. -/
theorem matrix_ext {M N : Matrix n n D} (he : e ᵥ* M = e ᵥ* N) (hf : f ᵥ* M = f ᵥ* N)
    (hz : ∀ z, σ.sesqForm (σ.polar q) z e = 0 → σ.sesqForm (σ.polar q) z f = 0 →
      z ᵥ* M = z ᵥ* N) : M = N := by
  rw [ext_iff_vecMul]
  intro v
  have hv : v = (v - σ.sesqForm (σ.polar q) v f • e - σ.sesqForm (σ.polar q) v e • f) +
      σ.sesqForm (σ.polar q) v f • e + σ.sesqForm (σ.polar q) v e • f := by abel
  rw [hv, add_vecMul, add_vecMul, add_vecMul, add_vecMul, smul_vecMul, smul_vecMul,
    smul_vecMul, smul_vecMul, he, hf, hz _ (hP.sesqForm_proj_left v) (hP.sesqForm_proj_right v)]

end IsHyperbolic

/-! ### Eichler transformations on the hyperbolic frame -/

/-- An Eichler transformation along `e` moves a vector orthogonal to `e` by a multiple of `e`. -/
theorem vecMul_eichlerMatrix_of_sesqForm_eq_zero {e x v : n → D} (c : D)
    (hv : σ.sesqForm (σ.polar q) v e = 0) :
    v ᵥ* eichlerMatrix σ q e x c = v - σ.sesqForm (σ.polar q) v x • e := by
  rw [vecMul_eichlerMatrix, hv, zero_smul, add_zero, zero_mul, add_zero]

/-- The action of an Eichler transformation along `e` on a vector `v` with `h(v, e) = 1`. -/
theorem vecMul_eichlerMatrix_of_sesqForm_eq_one {e x v : n → D} (c : D)
    (hv : σ.sesqForm (σ.polar q) v e = 1) :
    v ᵥ* eichlerMatrix σ q e x c = v + x - (σ.sesqForm (σ.polar q) v x + c) • e := by
  rw [vecMul_eichlerMatrix, hv, one_smul, one_mul]

/-! ### The Levi homomorphism -/

/-- The hyperbolic scaling `ℓ(a)`: `e ↦ a e`, `f ↦ σ(a)⁻¹ f`, identity on `{e, f}^⊥`. -/
def levi {e f : n → D} (hP : IsHyperbolic σ q e f) : Dˣ →* (Matrix n n D)ˣ where
  toFun a :=
    { val := scalingMatrix σ q e f a (σ a)⁻¹
      inv := scalingMatrix σ q e f (a : D)⁻¹ (σ (a : D))
      val_inv := by
        rw [scalingMatrix_mul σ q hP.sesqForm_left_left hP.sesqForm_right_right
          hP.sesqForm_eq_one, mul_inv_cancel₀ a.ne_zero,
          inv_mul_cancel₀ (map_ne_zero_of_ne_zero σ a.ne_zero), scalingMatrix_one_one]
      inv_val := by
        rw [scalingMatrix_mul σ q hP.sesqForm_left_left hP.sesqForm_right_right
          hP.sesqForm_eq_one, inv_mul_cancel₀ a.ne_zero,
          mul_inv_cancel₀ (map_ne_zero_of_ne_zero σ a.ne_zero), scalingMatrix_one_one] }
  map_one' := by
    ext : 1
    simp only [Units.val_one, map_one, inv_one]
    exact scalingMatrix_one_one σ q e f
  map_mul' a b := by
    ext : 1
    simp only [Units.val_mul]
    rw [scalingMatrix_mul σ q hP.sesqForm_left_left hP.sesqForm_right_right hP.sesqForm_eq_one,
      map_mul, mul_inv_rev]

variable {σ q}

@[simp] theorem val_levi {e f : n → D} (hP : IsHyperbolic σ q e f) (a : Dˣ) :
    ((levi σ q hP a : (Matrix n n D)ˣ) : Matrix n n D) = scalingMatrix σ q e f a (σ a)⁻¹ :=
  rfl

theorem vecMul_levi_left {e f : n → D} (hP : IsHyperbolic σ q e f) (a : Dˣ) :
    e ᵥ* (levi σ q hP a : Matrix n n D) = (a : D) • e := by
  rw [val_levi, vecMul_scalingMatrix, hP.sesqForm_left_left, hP.sesqForm_eq_one, one_mul,
    zero_mul, zero_smul, add_zero]
  ext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  noncomm_ring

theorem vecMul_levi_right {e f : n → D} (hP : IsHyperbolic σ q e f) (a : Dˣ) :
    f ᵥ* (levi σ q hP a : Matrix n n D) = (σ a)⁻¹ • f := by
  rw [val_levi, vecMul_scalingMatrix, hP.sesqForm_right_right, hP.sesqForm_right_left, one_mul,
    zero_mul, zero_smul, add_zero]
  ext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  noncomm_ring

theorem vecMul_levi_of_ortho {e f : n → D} (hP : IsHyperbolic σ q e f) (a : Dˣ) {z : n → D}
    (hze : σ.sesqForm (σ.polar q) z e = 0) (hzf : σ.sesqForm (σ.polar q) z f = 0) :
    z ᵥ* (levi σ q hP a : Matrix n n D) = z := by
  rw [val_levi, vecMul_scalingMatrix, hze, hzf, zero_mul, zero_mul, zero_smul, zero_smul,
    add_zero, add_zero]

theorem levi_mem [LinearOrder n] {e f : n → D} (hP : IsHyperbolic σ q e f) (a : Dˣ) :
    levi σ q hP a ∈ rationalIsometryGroup σ q := by
  have hσa : σ (a : D) ≠ 0 := map_ne_zero_of_ne_zero σ a.ne_zero
  rw [mem_rationalIsometryGroup_iff_forall, val_levi]
  have hab : (a : D) * σ (σ (a : D))⁻¹ = 1 := by
    rw [← map_inv_eq, apply_apply, mul_inv_cancel₀ a.ne_zero]
  exact ⟨sesqForm_vecMul_scalingMatrix σ q hP.sesqForm_left_left hP.sesqForm_right_right
    hP.sesqForm_eq_one hab, quadraticValue_vecMul_scalingMatrix σ q hP.quadraticValue_left
    hP.quadraticValue_right hP.sesqForm_eq_one hab⟩

/-! ### The Eichler subgroup -/

variable (σ q) in
/-- The subgroup `E` generated by the Eichler transformations along `e` and along `f`. -/
def eichlerSubgroup (e f : n → D) : Subgroup (Matrix n n D)ˣ :=
  Subgroup.closure (eichlerSet σ q e ∪ eichlerSet σ q f)

theorem eichlerSet_left_subset (e f : n → D) :
    eichlerSet σ q e ⊆ eichlerSubgroup σ q e f :=
  fun _ hu => Subgroup.subset_closure (Or.inl hu)

theorem eichlerSet_right_subset (e f : n → D) :
    eichlerSet σ q f ⊆ eichlerSubgroup σ q e f :=
  fun _ hu => Subgroup.subset_closure (Or.inr hu)

/-- Conjugating an Eichler transformation along `e` by an isometry that rescales `e` gives an
Eichler transformation along `e`. -/
theorem inv_mul_mul_mem_eichlerSet [LinearOrder n] {e : n → D} {g u : (Matrix n n D)ˣ} {d : D}
    (hg : g ∈ rationalIsometryGroup σ q) (hd : d ≠ 0)
    (hge : e ᵥ* (g : Matrix n n D) = d • e) (hu : u ∈ eichlerSet σ q e) :
    g⁻¹ * u * g ∈ eichlerSet σ q e := by
  obtain ⟨x, c, hxe, hc, hu⟩ := hu
  have hpol := (mem_rationalIsometryGroup_iff_forall σ q g).1 hg
  have hval := hpol.2
  have hpol := hpol.1
  refine ⟨σ d • (x ᵥ* (g : Matrix n n D)), σ d * c * d, ?_, ?_, ?_⟩
  · have h1 : σ.sesqForm (σ.polar q) (x ᵥ* (g : Matrix n n D)) e * σ d = 0 := by
      rw [← sesqForm_smul_right, ← hge, hpol, hxe]
    rw [sesqForm_smul_left, (mul_eq_zero.1 h1).resolve_right (map_ne_zero_of_ne_zero σ hd),
      mul_zero]
  · rw [quadraticValue_smul, hval, ← hc, valueSandwich_mk, apply_apply]
  · rw [Units.val_mul, Units.val_mul, hu, conj_eichlerMatrix σ q g hpol, hge,
      eichlerMatrix_smul]

/-- A general criterion: a subgroup all of whose elements conjugate a generating set into the
generated subgroup normalizes it. -/
theorem le_normalizer_closure {G : Type*} [Group G] {H : Subgroup G} {S : Set G}
    (h : ∀ g ∈ H, ∀ s ∈ S, g⁻¹ * s * g ∈ Subgroup.closure S) :
    H ≤ Subgroup.normalizer (Subgroup.closure S : Set G) := by
  have key : ∀ g ∈ H, ∀ x ∈ Subgroup.closure S, g⁻¹ * x * g ∈ Subgroup.closure S := by
    intro g hg x hx
    induction hx using Subgroup.closure_induction with
    | mem s hs => exact h g hg s hs
    | one => simp
    | mul x y _ _ hx hy =>
      have : g⁻¹ * (x * y) * g = (g⁻¹ * x * g) * (g⁻¹ * y * g) := by group
      rw [this]
      exact mul_mem hx hy
    | inv x _ hx =>
      have : g⁻¹ * x⁻¹ * g = (g⁻¹ * x * g)⁻¹ := by group
      rw [this]
      exact inv_mem hx
  intro g hg
  rw [Subgroup.mem_normalizer_iff'']
  intro x
  refine ⟨key g hg x, fun hx => ?_⟩
  have := key g⁻¹ (inv_mem hg) _ hx
  rwa [inv_inv, show g * (g⁻¹ * x * g) * g⁻¹ = x by group] at this

/-- The Levi subgroup normalizes the Eichler subgroup. -/
theorem range_levi_le_normalizer [LinearOrder n] {e f : n → D} (hP : IsHyperbolic σ q e f) :
    (levi σ q hP).range ≤
      Subgroup.normalizer (eichlerSubgroup σ q e f : Set (Matrix n n D)ˣ) := by
  apply le_normalizer_closure
  rintro _ ⟨a, rfl⟩ s (hs | hs)
  · exact Subgroup.subset_closure (Or.inl (inv_mul_mul_mem_eichlerSet (levi_mem hP a)
      a.ne_zero (vecMul_levi_left hP a) hs))
  · exact Subgroup.subset_closure (Or.inr (inv_mul_mul_mem_eichlerSet (levi_mem hP a)
      (inv_ne_zero (map_ne_zero_of_ne_zero σ a.ne_zero)) (vecMul_levi_right hP a) hs))

/-! ### Weyl elements -/

variable (σ q) in
/-- The Weyl element `m_{x,c} = E^f_{(σc)⁻¹x,(σc)⁻¹} E^e_{x,c} E^f_{c⁻¹x,(σc)⁻¹}` (applied from
left to right to row vectors). For `x ⊥ e, f`, `c ≠ 0` and `[c] = q(x)` it sends
`e ↦ -(σc)⁻¹ f`, `f ↦ -c e` and acts on `{e, f}^⊥` as the reflection `ρ_{x,c}`. -/
def weylMatrix (e f x : n → D) (c : D) : Matrix n n D :=
  eichlerMatrix σ q f ((σ c)⁻¹ • x) (σ c)⁻¹ * eichlerMatrix σ q e x c *
    eichlerMatrix σ q f (c⁻¹ • x) (σ c)⁻¹

section Weyl

variable {e f x : n → D} {c : D} (hP : IsHyperbolic σ q e f)
  (hxe : σ.sesqForm (σ.polar q) x e = 0) (hxf : σ.sesqForm (σ.polar q) x f = 0)
include hP hxe hxf

theorem vecMul_weylMatrix_left (hc0 : c ≠ 0)
    (hxx : σ.sesqForm (σ.polar q) x x = c + σ c) :
    e ᵥ* weylMatrix σ q e f x c = -(σ c)⁻¹ • f := by
  have hσc0 := map_ne_zero_of_ne_zero σ hc0
  have hex : σ.sesqForm (σ.polar q) e x = 0 := by
    rw [← sesqForm_polar_swap, hxe, map_zero]
  have hfx : σ.sesqForm (σ.polar q) f x = 0 := by
    rw [← sesqForm_polar_swap, hxf, map_zero]
  have h1 : e ᵥ* eichlerMatrix σ q f ((σ c)⁻¹ • x) (σ c)⁻¹ = e + (σ c)⁻¹ • x - (σ c)⁻¹ • f := by
    rw [vecMul_eichlerMatrix_of_sesqForm_eq_one σ q _ hP.sesqForm_eq_one, sesqForm_smul_right,
      hex, zero_mul, zero_add]
  have h2 : (e + (σ c)⁻¹ • x - (σ c)⁻¹ • f) ᵥ* eichlerMatrix σ q e x c = -(σ c)⁻¹ • f := by
    rw [sub_vecMul, add_vecMul, smul_vecMul, smul_vecMul,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hP.sesqForm_left_left,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hxe,
      vecMul_eichlerMatrix_of_sesqForm_eq_one σ q _ hP.sesqForm_right_left, hex, hxx, hfx]
    ext i
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, add_mul, mul_add, mul_sub,
      zero_mul, zero_add, inv_mul_cancel_left₀ hσc0]
    noncomm_ring
  have h3 : f ᵥ* eichlerMatrix σ q f (c⁻¹ • x) (σ c)⁻¹ = f := by
    rw [vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hP.sesqForm_right_right,
      sesqForm_smul_right, hfx, zero_mul, zero_smul, sub_zero]
  rw [weylMatrix, ← vecMul_vecMul, ← vecMul_vecMul, h1, h2, smul_vecMul, h3]

theorem vecMul_weylMatrix_right (hc0 : c ≠ 0)
    (hxx : σ.sesqForm (σ.polar q) x x = c + σ c) :
    f ᵥ* weylMatrix σ q e f x c = -c • e := by
  have hσc0 := map_ne_zero_of_ne_zero σ hc0
  have hex : σ.sesqForm (σ.polar q) e x = 0 := by
    rw [← sesqForm_polar_swap, hxe, map_zero]
  have hfx : σ.sesqForm (σ.polar q) f x = 0 := by
    rw [← sesqForm_polar_swap, hxf, map_zero]
  have hxx2 : σ.sesqForm (σ.polar q) x (c⁻¹ • x) = c * (σ c)⁻¹ + 1 := by
    rw [sesqForm_smul_right, hxx, map_inv_eq, add_mul, mul_inv_cancel₀ hσc0]
  have h1 : f ᵥ* eichlerMatrix σ q f ((σ c)⁻¹ • x) (σ c)⁻¹ = f := by
    rw [vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hP.sesqForm_right_right,
      sesqForm_smul_right, hfx, zero_mul, zero_smul, sub_zero]
  have h2 : f ᵥ* eichlerMatrix σ q e x c = f + x - c • e := by
    rw [vecMul_eichlerMatrix_of_sesqForm_eq_one σ q _ hP.sesqForm_right_left, hfx, zero_add]
  have h3 : (f + x - c • e) ᵥ* eichlerMatrix σ q f (c⁻¹ • x) (σ c)⁻¹ = -c • e := by
    rw [sub_vecMul, add_vecMul, smul_vecMul,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hP.sesqForm_right_right,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hxf,
      vecMul_eichlerMatrix_of_sesqForm_eq_one σ q _ hP.sesqForm_eq_one, hxx2,
      sesqForm_smul_right, sesqForm_smul_right, hfx, hex]
    ext i
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, add_mul, mul_add, mul_sub,
      zero_mul, zero_add, mul_inv_cancel_left₀ hc0]
    noncomm_ring
  rw [weylMatrix, ← vecMul_vecMul, ← vecMul_vecMul, h1, h2, h3]

omit hxe in
theorem vecMul_weylMatrix_of_ortho (hc0 : c ≠ 0)
    (hxx : σ.sesqForm (σ.polar q) x x = c + σ c) {z : n → D}
    (hze : σ.sesqForm (σ.polar q) z e = 0) (hzf : σ.sesqForm (σ.polar q) z f = 0) :
    z ᵥ* weylMatrix σ q e f x c = z ᵥ* reflectionMatrix σ q x c := by
  have hσc0 := map_ne_zero_of_ne_zero σ hc0
  have hfx : σ.sesqForm (σ.polar q) f x = 0 := by
    rw [← sesqForm_polar_swap, hxf, map_zero]
  have hxx2 : σ.sesqForm (σ.polar q) x (c⁻¹ • x) = c * (σ c)⁻¹ + 1 := by
    rw [sesqForm_smul_right, hxx, map_inv_eq, add_mul, mul_inv_cancel₀ hσc0]
  set β := σ.sesqForm (σ.polar q) z x * c⁻¹ with hβ
  have h1 : z ᵥ* eichlerMatrix σ q f ((σ c)⁻¹ • x) (σ c)⁻¹ = z - β • f := by
    rw [vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hzf, sesqForm_smul_right, map_inv_eq,
      apply_apply]
  have h2 : (z - β • f) ᵥ* eichlerMatrix σ q e x c = z - β • x - β • f := by
    rw [sub_vecMul, smul_vecMul, vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hze,
      vecMul_eichlerMatrix_of_sesqForm_eq_one σ q _ hP.sesqForm_right_left, hfx, zero_add]
    ext i
    simp only [hβ, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, mul_add, mul_sub,
      mul_assoc, inv_mul_cancel_left₀ hc0]
    noncomm_ring
  have h3 : (z - β • x - β • f) ᵥ* eichlerMatrix σ q f (c⁻¹ • x) (σ c)⁻¹ = z - β • x := by
    rw [sub_vecMul, sub_vecMul, smul_vecMul, smul_vecMul,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hzf,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hxf,
      vecMul_eichlerMatrix_of_sesqForm_eq_zero σ q _ hP.sesqForm_right_right, hxx2,
      sesqForm_smul_right, sesqForm_smul_right, hfx, map_inv_eq]
    ext i
    simp only [hβ, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, add_mul, mul_add, mul_sub, zero_mul,
      mul_assoc, inv_mul_cancel_left₀ hc0]
    noncomm_ring
  rw [weylMatrix, ← vecMul_vecMul, ← vecMul_vecMul, h1, h2, h3, vecMul_reflectionMatrix]

end Weyl

/-! ### Weyl elements, reflections and the Levi subgroup -/

theorem exists_weyl_mem_eichlerSubgroup {e f x : n → D} {c : D} (hP : IsHyperbolic σ q e f)
    (hxe : σ.sesqForm (σ.polar q) x e = 0) (hxf : σ.sesqForm (σ.polar q) x f = 0)
    (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q) :
    ∃ m ∈ eichlerSubgroup σ q e f, (m : Matrix n n D) = weylMatrix σ q e f x c := by
  obtain ⟨u1, hu1, hu1'⟩ := exists_mem_eichlerSet σ q (e := f) (x := (σ c)⁻¹ • x)
    (c := (σ c)⁻¹) hP.quadraticValue_right (by rw [sesqForm_smul_left, hxf, mul_zero]) (by
      rw [quadraticValue_smul, ← hc, valueSandwich_mk, map_inv_eq, apply_apply,
        mul_inv_cancel_right₀ hc0])
  obtain ⟨u2, hu2, hu2'⟩ := exists_mem_eichlerSet σ q hP.quadraticValue_left hxe hc
  obtain ⟨u3, hu3, hu3'⟩ := exists_mem_eichlerSet σ q (e := f) (x := c⁻¹ • x)
    (c := (σ c)⁻¹) hP.quadraticValue_right (by rw [sesqForm_smul_left, hxf, mul_zero]) (by
      rw [quadraticValue_smul, ← hc, valueSandwich_mk, inv_mul_cancel₀ hc0, one_mul,
        map_inv_eq])
  refine ⟨u1 * u2 * u3, mul_mem (mul_mem (eichlerSet_right_subset e f hu1)
    (eichlerSet_left_subset e f hu2)) (eichlerSet_right_subset e f hu3), ?_⟩
  rw [Units.val_mul, Units.val_mul, hu1', hu2', hu3', weylMatrix]

variable (σ q) in
theorem reflectionMatrix_zero (c : D) : reflectionMatrix σ q 0 c = 1 := by
  rw [ext_iff_vecMul]
  intro v
  simp [vecMul_reflectionMatrix]

/-- `ℓ((σc)⁻¹ σ(a₀)) ρ_{x,c} m_{0,a₀} = m_{x,c}` for an alternating `a₀ ≠ 0`. -/
theorem levi_mul_reflectionMatrix_mul_weylMatrix {e f x : n → D} {c a0 : D}
    (hP : IsHyperbolic σ q e f) (hxe : σ.sesqForm (σ.polar q) x e = 0)
    (hxf : σ.sesqForm (σ.polar q) x f = 0) (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q)
    (ha0 : a0 ∈ σ.alternatingSubspace) (ha00 : a0 ≠ 0) (a : Dˣ)
    (ha : (a : D) = (σ c)⁻¹ * σ a0) :
    (levi σ q hP a : Matrix n n D) * reflectionMatrix σ q x c * weylMatrix σ q e f 0 a0 =
      weylMatrix σ q e f x c := by
  have hσc0 := map_ne_zero_of_ne_zero σ hc0
  have hσa0 := map_ne_zero_of_ne_zero σ ha00
  have hxx := sesqForm_polar_self_of_quadraticValue σ q hc
  have h00 : σ.sesqForm (σ.polar q) (0 : n → D) 0 = a0 + σ a0 := by
    rw [sesqForm_zero_left, add_map_eq_zero_of_mem_alternatingSubspace σ ha0]
  have hex : σ.sesqForm (σ.polar q) e x = 0 := by
    rw [← sesqForm_polar_swap, hxe, map_zero]
  have hfx : σ.sesqForm (σ.polar q) f x = 0 := by
    rw [← sesqForm_polar_swap, hxf, map_zero]
  have h0e : σ.sesqForm (σ.polar q) (0 : n → D) e = 0 := sesqForm_zero_left _ _ _
  have h0f : σ.sesqForm (σ.polar q) (0 : n → D) f = 0 := sesqForm_zero_left _ _ _
  apply hP.matrix_ext
  · rw [← vecMul_vecMul, ← vecMul_vecMul, vecMul_levi_left, smul_vecMul, smul_vecMul,
      vecMul_reflectionMatrix, hex, zero_mul, zero_smul, sub_zero,
      vecMul_weylMatrix_left hP h0e h0f ha00 h00, vecMul_weylMatrix_left hP hxe hxf hc0 hxx,
      smul_smul, ha, mul_neg, mul_inv_cancel_right₀ hσa0]
  · rw [← vecMul_vecMul, ← vecMul_vecMul, vecMul_levi_right, smul_vecMul, smul_vecMul,
      vecMul_reflectionMatrix, hfx, zero_mul, zero_smul, sub_zero,
      vecMul_weylMatrix_right hP h0e h0f ha00 h00, vecMul_weylMatrix_right hP hxe hxf hc0 hxx,
      smul_smul, ha, map_mul, map_inv_eq, apply_apply, apply_apply, mul_inv_rev, inv_inv,
      mul_neg, mul_assoc, inv_mul_cancel₀ ha00, mul_one]
  · intro z hze hzf
    have hz'e : σ.sesqForm (σ.polar q) (z ᵥ* reflectionMatrix σ q x c) e = 0 := by
      rw [vecMul_reflectionMatrix, sesqForm_sub_left, sesqForm_smul_left, hze, hxe, mul_zero,
        sub_zero]
    have hz'f : σ.sesqForm (σ.polar q) (z ᵥ* reflectionMatrix σ q x c) f = 0 := by
      rw [vecMul_reflectionMatrix, sesqForm_sub_left, sesqForm_smul_left, hzf, hxf, mul_zero,
        sub_zero]
    rw [← vecMul_vecMul, ← vecMul_vecMul, vecMul_levi_of_ortho hP a hze hzf,
      vecMul_weylMatrix_of_ortho hP h0f ha00 h00 hz'e hz'f, reflectionMatrix_zero, vecMul_one,
      vecMul_weylMatrix_of_ortho hP hxf hc0 hxx hze hzf]

/-- `m_{x,c} ℓ(d) = ℓ((σc)⁻¹ (σd)⁻¹ σc) m_{x,c}`. -/
theorem weylMatrix_mul_levi {e f x : n → D} {c : D} (hP : IsHyperbolic σ q e f)
    (hxe : σ.sesqForm (σ.polar q) x e = 0) (hxf : σ.sesqForm (σ.polar q) x f = 0)
    (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q)
    (d d' : Dˣ) (hd' : (d' : D) = (σ c)⁻¹ * (σ d)⁻¹ * σ c) :
    weylMatrix σ q e f x c * (levi σ q hP d : Matrix n n D) =
      (levi σ q hP d' : Matrix n n D) * weylMatrix σ q e f x c := by
  have hσc0 := map_ne_zero_of_ne_zero σ hc0
  have hxx := sesqForm_polar_self_of_quadraticValue σ q hc
  apply hP.matrix_ext
  · rw [← vecMul_vecMul, ← vecMul_vecMul, vecMul_weylMatrix_left hP hxe hxf hc0 hxx,
      smul_vecMul, vecMul_levi_right, vecMul_levi_left, smul_vecMul,
      vecMul_weylMatrix_left hP hxe hxf hc0 hxx, smul_smul, smul_smul, hd', mul_neg, neg_mul,
      mul_inv_cancel_right₀ hσc0]
  · rw [← vecMul_vecMul, ← vecMul_vecMul, vecMul_weylMatrix_right hP hxe hxf hc0 hxx,
      smul_vecMul, vecMul_levi_left, vecMul_levi_right, smul_vecMul,
      vecMul_weylMatrix_right hP hxe hxf hc0 hxx, smul_smul, smul_smul, hd']
    congr 1
    simp only [map_mul, map_inv_eq, apply_apply, mul_inv_rev, inv_inv, mul_neg, neg_mul,
      mul_assoc, inv_mul_cancel₀ hc0, mul_one]
  · intro z hze hzf
    have hz'e : σ.sesqForm (σ.polar q) (z ᵥ* reflectionMatrix σ q x c) e = 0 := by
      rw [vecMul_reflectionMatrix, sesqForm_sub_left, sesqForm_smul_left, hze, hxe, mul_zero,
        sub_zero]
    have hz'f : σ.sesqForm (σ.polar q) (z ᵥ* reflectionMatrix σ q x c) f = 0 := by
      rw [vecMul_reflectionMatrix, sesqForm_sub_left, sesqForm_smul_left, hzf, hxf, mul_zero,
        sub_zero]
    rw [← vecMul_vecMul, ← vecMul_vecMul, vecMul_weylMatrix_of_ortho hP hxf hc0 hxx hze hzf,
      vecMul_levi_of_ortho hP d hz'e hz'f, vecMul_levi_of_ortho hP d' hze hzf,
      vecMul_weylMatrix_of_ortho hP hxf hc0 hxx hze hzf]

/-! ### The subgroup `N_E` of units with `ℓ(a) ∈ E` -/

/-- The units `a` of `D` whose hyperbolic scaling `ℓ(a)` lies in the Eichler subgroup. -/
def eichlerLeviSubgroup {e f : n → D} (hP : IsHyperbolic σ q e f) : Subgroup Dˣ :=
  (eichlerSubgroup σ q e f).comap (levi σ q hP)

theorem mem_eichlerLeviSubgroup {e f : n → D} (hP : IsHyperbolic σ q e f) (a : Dˣ) :
    a ∈ eichlerLeviSubgroup hP ↔ levi σ q hP a ∈ eichlerSubgroup σ q e f :=
  Iff.rfl

theorem eichlerLeviSubgroup_normal [LinearOrder n] {e f : n → D} (hP : IsHyperbolic σ q e f) :
    (eichlerLeviSubgroup hP).Normal :=
  ⟨fun a ha g => by
    rw [mem_eichlerLeviSubgroup, _root_.map_mul, _root_.map_mul, _root_.map_inv]
    exact (Subgroup.mem_normalizer_iff.1 (range_levi_le_normalizer hP ⟨g, rfl⟩) _).1 ha⟩

/-- `ℓ((σc)⁻¹ σ(a₀)) ρ_{x,c}` lies in the Eichler subgroup. -/
theorem levi_mul_mem_eichlerSubgroup {e f x : n → D} {c a0 : D} (hP : IsHyperbolic σ q e f)
    (hxe : σ.sesqForm (σ.polar q) x e = 0) (hxf : σ.sesqForm (σ.polar q) x f = 0)
    (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q)
    (ha0 : a0 ∈ σ.alternatingSubspace) (ha00 : a0 ≠ 0) (a : Dˣ)
    (ha : (a : D) = (σ c)⁻¹ * σ a0) (r : (Matrix n n D)ˣ)
    (hr : (r : Matrix n n D) = reflectionMatrix σ q x c) :
    levi σ q hP a * r ∈ eichlerSubgroup σ q e f := by
  obtain ⟨m, hm, hm'⟩ := exists_weyl_mem_eichlerSubgroup hP hxe hxf hc0 hc
  obtain ⟨m0, hm0, hm0'⟩ := exists_weyl_mem_eichlerSubgroup hP (sesqForm_zero_left _ _ _)
    (sesqForm_zero_left _ _ _) ha00
    (by rw [quadraticValue_zero, Submodule.Quotient.mk_eq_zero]; exact ha0)
  have : levi σ q hP a * r = m * m0⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq]
    ext : 1
    rw [Units.val_mul, Units.val_mul, hr, hm', hm0',
      levi_mul_reflectionMatrix_mul_weylMatrix hP hxe hxf hc0 hc ha0 ha00 a ha]
  rw [this]
  exact mul_mem hm (inv_mem hm0)

/-- Every reflection `ρ_{x,c}` with `x ⊥ e, f` lies in `ℓ(Dˣ) ⊔ E`. -/
theorem mem_sup_of_reflection {e f x : n → D} {c a0 : D} (hP : IsHyperbolic σ q e f)
    (hxe : σ.sesqForm (σ.polar q) x e = 0) (hxf : σ.sesqForm (σ.polar q) x f = 0)
    (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q)
    (ha0 : a0 ∈ σ.alternatingSubspace) (ha00 : a0 ≠ 0) (r : (Matrix n n D)ˣ)
    (hr : (r : Matrix n n D) = reflectionMatrix σ q x c) :
    r ∈ (levi σ q hP).range ⊔ eichlerSubgroup σ q e f := by
  set a : Dˣ := Units.mk0 ((σ c)⁻¹ * σ a0)
    (mul_ne_zero (inv_ne_zero (map_ne_zero_of_ne_zero σ hc0)) (map_ne_zero_of_ne_zero σ ha00))
  have h := levi_mul_mem_eichlerSubgroup hP hxe hxf hc0 hc ha0 ha00 a rfl r hr
  have : r = (levi σ q hP a)⁻¹ * (levi σ q hP a * r) := by group
  rw [this]
  exact mul_mem (inv_mem (Subgroup.mem_sup_left ⟨a, rfl⟩)) (Subgroup.mem_sup_right h)

/-- Nonzero scalars lie in `N_E`. -/
theorem algebraMap_mem_eichlerLeviSubgroup {e f : n → D} {a0 : D} (hP : IsHyperbolic σ q e f)
    (ha0 : a0 ∈ σ.alternatingSubspace) (ha00 : a0 ≠ 0) {t : K} (ht : t ≠ 0) (a : Dˣ)
    (ha : (a : D) = algebraMap K D t) : a ∈ eichlerLeviSubgroup hP := by
  have hc0 : t⁻¹ • a0 ≠ 0 := smul_ne_zero (inv_ne_zero ht) ha00
  have hσc0 := map_ne_zero_of_ne_zero σ hc0
  have h := levi_mul_mem_eichlerSubgroup hP (sesqForm_zero_left _ _ _)
    (sesqForm_zero_left _ _ _) hc0
    (by rw [quadraticValue_zero, Submodule.Quotient.mk_eq_zero]
        exact Submodule.smul_mem _ _ ha0) ha0 ha00 a
    (by
      rw [ha, eq_inv_mul_iff_mul_eq₀ hσc0, map_smul, Algebra.smul_def, mul_assoc,
        ← Algebra.commutes, ← mul_assoc, ← _root_.map_mul, inv_mul_cancel₀ ht, _root_.map_one,
        one_mul])
    1 (by rw [Units.val_one, reflectionMatrix_zero])
  rwa [mul_one] at h

/-- The commutator-type elements `d⁻¹ (σc)⁻¹ (σd)⁻¹ σc` lie in `N_E`. -/
theorem inv_mul_mem_eichlerLeviSubgroup [LinearOrder n] {e f x : n → D} {c : D}
    (hP : IsHyperbolic σ q e f) (hxe : σ.sesqForm (σ.polar q) x e = 0)
    (hxf : σ.sesqForm (σ.polar q) x f = 0) (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q)
    (d W δ : Dˣ) (hW : (W : D) = σ c) (hδ : (δ : D) = σ d) :
    d⁻¹ * (W⁻¹ * δ⁻¹ * W) ∈ eichlerLeviSubgroup hP := by
  obtain ⟨m, hm, hm'⟩ := exists_weyl_mem_eichlerSubgroup hP hxe hxf hc0 hc
  have key : m * levi σ q hP d = levi σ q hP (W⁻¹ * δ⁻¹ * W) * m := by
    ext : 1
    rw [Units.val_mul, Units.val_mul, hm']
    exact weylMatrix_mul_levi hP hxe hxf hc0 hc d _ (by simp [hW, hδ])
  have hconj : (levi σ q hP d)⁻¹ * m * levi σ q hP d ∈ eichlerSubgroup σ q e f :=
    (Subgroup.mem_normalizer_iff''.1 (range_levi_le_normalizer hP ⟨d, rfl⟩) m).1 hm
  have h1 : levi σ q hP (W⁻¹ * δ⁻¹ * W) = m * levi σ q hP d * m⁻¹ := by
    rw [key, mul_inv_cancel_right]
  rw [mem_eichlerLeviSubgroup, _root_.map_mul, _root_.map_inv, h1,
    show (levi σ q hP d)⁻¹ * (m * levi σ q hP d * m⁻¹) =
      (levi σ q hP d)⁻¹ * m * levi σ q hP d * m⁻¹ by group]
  exact mul_mem hconj (inv_mem hm)

/-- For `z = σ(c) σ(a₀)⁻¹`, every commutator `g⁻¹ z g z⁻¹` lies in `N_E`. -/
theorem commutator_mem_eichlerLeviSubgroup [LinearOrder n] {e f x : n → D} {c a0 : D}
    (hP : IsHyperbolic σ q e f) (hxe : σ.sesqForm (σ.polar q) x e = 0)
    (hxf : σ.sesqForm (σ.polar q) x f = 0) (hc0 : c ≠ 0)
    (hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue x q)
    (ha0 : a0 ∈ σ.alternatingSubspace) (ha00 : a0 ≠ 0) (W W0 : Dˣ) (hW : (W : D) = σ c)
    (hW0 : (W0 : D) = σ a0) (g : Dˣ) :
    g⁻¹ * (W * W0⁻¹) * g * (W * W0⁻¹)⁻¹ ∈ eichlerLeviSubgroup hP := by
  set d : Dˣ := Units.mk0 (σ g) (map_ne_zero_of_ne_zero σ g.ne_zero)
  have hδ : (g : D) = σ d := by simp [d]
  have h1 := inv_mul_mem_eichlerLeviSubgroup hP hxe hxf hc0 hc d W g hW hδ
  have h2 := inv_mul_mem_eichlerLeviSubgroup hP (sesqForm_zero_left _ _ _)
    (sesqForm_zero_left _ _ _) ha00
    (by rw [quadraticValue_zero, Submodule.Quotient.mk_eq_zero]; exact ha0) d W0 g hW0 hδ
  have h3 := (eichlerLeviSubgroup_normal hP).conj_mem _ (mul_mem h1 (inv_mem h2)) (W * d)
  convert h3 using 1
  group

/-! ### Isometries fixing a hyperbolic pair -/

variable (σ q) in
/-- `[h(x, x)] = q(x) + q(x)` modulo the alternating subspace. -/
theorem quotient_mk_sesqForm_polar_self (x : n → D) :
    (Submodule.Quotient.mk (σ.sesqForm (σ.polar q) x x) : D ⧸ σ.alternatingSubspace) =
      σ.quadraticValue x q + σ.quadraticValue x q := by
  induction q using Submodule.Quotient.induction_on with
  | _ Q =>
    rw [sesqForm_polar_mk, quadraticValue_mk, Submodule.Quotient.mk_add, quotient_mk_map]

variable (σ q) in
theorem quadraticValue_neg (x : n → D) : σ.quadraticValue (-x) q = σ.quadraticValue x q := by
  induction q using Submodule.Quotient.induction_on with
  | _ Q => rw [quadraticValue_mk, quadraticValue_mk, sesqForm_neg_left, sesqForm_neg_right, neg_neg]

variable (σ q) in
/-- The reflections `ρ_{y,c}` with `y ⊥ e, f`, `c ≠ 0` and `[c] = q(y)`. -/
def orthoReflectionSet (e f : n → D) : Set (Matrix n n D)ˣ :=
  {u | ∃ y c, σ.sesqForm (σ.polar q) y e = 0 ∧ σ.sesqForm (σ.polar q) y f = 0 ∧ c ≠ 0 ∧
    (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue y q ∧
    (u : Matrix n n D) = reflectionMatrix σ q y c}

/-- **Cartan–Dieudonné-type generation.** If `{e, f}^⊥` is anisotropic, every rational isometry
fixing `e` and `f` is a product of reflections `ρ_{y,c}` with `y ⊥ e, f`. -/
theorem mem_closure_orthoReflectionSet [LinearOrder n] {e f : n → D}
    (hanis : ∀ y, σ.sesqForm (σ.polar q) y e = 0 → σ.sesqForm (σ.polar q) y f = 0 →
      σ.quadraticValue y q = 0 → y = 0)
    {w : (Matrix n n D)ˣ} (hw : w ∈ rationalIsometryGroup σ q)
    (hwe : e ᵥ* (w : Matrix n n D) = e) (hwf : f ᵥ* (w : Matrix n n D) = f) :
    w ∈ Subgroup.closure (orthoReflectionSet σ q e f) := by
  suffices H : ∀ S : Finset n, ∀ w : (Matrix n n D)ˣ, w ∈ rationalIsometryGroup σ q →
      e ᵥ* (w : Matrix n n D) = e → f ᵥ* (w : Matrix n n D) = f →
      (∀ i ∉ S, Pi.single i (1 : D) ᵥ* (w : Matrix n n D) = Pi.single i 1) →
      w ∈ Subgroup.closure (orthoReflectionSet σ q e f) from
    H Finset.univ w hw hwe hwf (fun i hi => absurd (Finset.mem_univ i) hi)
  intro S
  induction S using Finset.induction_on with
  | empty =>
    intro w _ _ _ hfix
    have : w = 1 := by
      ext i j
      have h := congrFun (hfix i (Finset.notMem_empty i)) j
      simp only [single_vecMul, one_smul, Matrix.row] at h
      rw [Units.val_one]
      simpa [Matrix.one_apply, Pi.single_apply, eq_comm] using h
    rw [this]
    exact one_mem _
  | insert a S haS ih =>
    intro w hw hwe hwf hfix
    by_cases hwa : Pi.single a (1 : D) ᵥ* (w : Matrix n n D) = Pi.single a 1
    · refine ih w hw hwe hwf fun i hi => ?_
      by_cases hia : i = a
      · rw [hia]
        exact hwa
      · exact hfix i (by simp [hia, hi])
    obtain ⟨s, hs⟩ : ∃ s : n → D, s = Pi.single a 1 := ⟨_, rfl⟩
    rw [← hs] at hwa
    have hpol := (mem_rationalIsometryGroup_iff_forall σ q w).1 hw
    obtain ⟨y, hy⟩ : ∃ y : n → D, y = s ᵥ* (w : Matrix n n D) - s := ⟨_, rfl⟩
    have hy0 : y ≠ 0 := by
      rw [hy]
      exact sub_ne_zero.2 hwa
    have horth : ∀ v, v ᵥ* (w : Matrix n n D) = v → σ.sesqForm (σ.polar q) y v = 0 := by
      intro v hv
      have := hpol.1 s v
      rw [hv] at this
      rw [hy, sesqForm_sub_left, this, sub_self]
    have hye := horth e hwe
    have hyf := horth f hwf
    obtain ⟨c, hcdef⟩ : ∃ c : D, c = σ.sesqForm (σ.polar q) (s ᵥ* (w : Matrix n n D)) y :=
      ⟨_, rfl⟩
    have hc : (Submodule.Quotient.mk c : D ⧸ σ.alternatingSubspace) = σ.quadraticValue y q := by
      rw [hcdef, hy, sesqForm_sub_right, hpol.1 s s, Submodule.Quotient.mk_sub,
        quotient_mk_sesqForm_polar_self, sub_eq_add_neg (s ᵥ* (w : Matrix n n D)) s,
        quadraticValue_add, quadraticValue_neg, hpol.2, sesqForm_neg_right,
        Submodule.Quotient.mk_neg, sub_eq_add_neg]
    have hc0 : c ≠ 0 := by
      intro h0
      apply hy0
      apply hanis y hye hyf
      rw [← hc, h0, Submodule.Quotient.mk_zero]
    obtain ⟨r, hr, hr'⟩ := exists_mem_reflectionSet σ q hc0 hc
    have hrmem : r ∈ orthoReflectionSet σ q e f := ⟨y, c, hye, hyf, hc0, hc, hr'⟩
    have hrfix : ∀ v, σ.sesqForm (σ.polar q) y v = 0 → v ᵥ* (r : Matrix n n D) = v := by
      intro v hv
      rw [hr', vecMul_reflectionMatrix, ← sesqForm_polar_swap, hv, map_zero, zero_mul,
        zero_smul, sub_zero]
    have hw' : w * r ∈ rationalIsometryGroup σ q := mul_mem hw (reflectionSet_subset σ q hr)
    have key := ih (w * r) hw'
      (by rw [Units.val_mul, ← vecMul_vecMul, hwe, hrfix e hye])
      (by rw [Units.val_mul, ← vecMul_vecMul, hwf, hrfix f hyf]) (by
        intro i hi
        rw [Units.val_mul, ← vecMul_vecMul]
        by_cases hia : i = a
        · rw [hia, ← hs, hr', vecMul_reflectionMatrix, ← hcdef, mul_inv_cancel₀ hc0, one_smul,
            hy, sub_sub_cancel]
        · have hfi := hfix i (by simp [hia, hi])
          rw [hfi, hrfix _ (horth _ hfi)])
    have : w = (w * r) * r⁻¹ := by group
    rw [this]
    exact mul_mem key (inv_mem (Subgroup.subset_closure hrmem))

/-- **Rational decomposition.** Suppose `{e, f}^⊥` is anisotropic and `σ` has a nonzero
alternating element `a₀`. Then every rational isometry `u` with `e u ∈ D e` and `f u ∈ D f` lies
in the subgroup generated by the Levi subgroup `ℓ(Dˣ)` and the Eichler subgroup `E`. -/
theorem mem_sup_of_vecMul_eq_smul [LinearOrder n] {e f : n → D} {a0 : D}
    (hP : IsHyperbolic σ q e f) (ha0 : a0 ∈ σ.alternatingSubspace) (ha00 : a0 ≠ 0)
    (hanis : ∀ y, σ.sesqForm (σ.polar q) y e = 0 → σ.sesqForm (σ.polar q) y f = 0 →
      σ.quadraticValue y q = 0 → y = 0)
    {u : (Matrix n n D)ˣ} (hu : u ∈ rationalIsometryGroup σ q) {a b : D}
    (hue : e ᵥ* (u : Matrix n n D) = a • e) (huf : f ᵥ* (u : Matrix n n D) = b • f) :
    u ∈ (levi σ q hP).range ⊔ eichlerSubgroup σ q e f := by
  have hpol := (mem_rationalIsometryGroup_iff_forall σ q u).1 hu
  have hab : a * σ b = 1 := by
    have := hpol.1 e f
    rwa [hue, huf, sesqForm_smul_left, sesqForm_smul_right, hP.sesqForm_eq_one, one_mul] at this
  have ha : a ≠ 0 := left_ne_zero_of_mul_eq_one hab
  have hb : σ a * b = 1 := by
    have hσb : σ b = a⁻¹ := eq_inv_of_mul_eq_one_right hab
    have : b = (σ a)⁻¹ := by rw [← apply_apply σ b, hσb, map_inv_eq]
    rw [this, mul_inv_cancel₀ (map_ne_zero_of_ne_zero σ ha)]
  obtain ⟨a', ha'⟩ : ∃ a' : Dˣ, (a' : D) = a := ⟨Units.mk0 a ha, rfl⟩
  obtain ⟨w, hwdef⟩ : ∃ w, w = (levi σ q hP a')⁻¹ * u := ⟨_, rfl⟩
  have hw : w ∈ rationalIsometryGroup σ q := by
    rw [hwdef]
    exact mul_mem (inv_mem (levi_mem hP a')) hu
  have hwe : e ᵥ* (w : Matrix n n D) = e := by
    rw [hwdef, Units.val_mul, ← vecMul_vecMul, ← _root_.map_inv, vecMul_levi_left, smul_vecMul,
      hue, smul_smul, Units.val_inv_eq_inv_val, ha', inv_mul_cancel₀ ha, one_smul]
  have hwf : f ᵥ* (w : Matrix n n D) = f := by
    rw [hwdef, Units.val_mul, ← vecMul_vecMul, ← _root_.map_inv, vecMul_levi_right, smul_vecMul,
      huf, smul_smul, Units.val_inv_eq_inv_val, ha', map_inv_eq, inv_inv, hb, one_smul]
  have hle : Subgroup.closure (orthoReflectionSet σ q e f) ≤
      (levi σ q hP).range ⊔ eichlerSubgroup σ q e f :=
    (Subgroup.closure_le _).2 fun r ⟨_, _, hye, hyf, hc0, hc, hr⟩ =>
      mem_sup_of_reflection hP hye hyf hc0 hc ha0 ha00 r hr
  have : u = levi σ q hP a' * w := by rw [hwdef, mul_inv_cancel_left]
  rw [this]
  exact mul_mem (Subgroup.mem_sup_left ⟨a', rfl⟩)
    (hle (mem_closure_orthoReflectionSet hanis hw hwe hwf))

end FirstKindInvolution.Eichler

end Langlands.GroupScheme.Quaternionic
