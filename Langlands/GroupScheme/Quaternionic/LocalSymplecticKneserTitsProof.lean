import Langlands.GroupScheme.Quaternionic.SymplecticGeneration
import Langlands.GroupScheme.Quaternionic.SymplecticReductive

/-!
# Kneser–Tits for quaternionic symplectic groups of Witt index one

Proof of `LocalSymplecticKneserTitsStatement`: the rational points of the symplectic group of a
nondegenerate antihermitian form of rank two or three and Witt index one over a quaternion
division algebra (with an involution of the first kind whose symmetric part has dimension three)
are generated by the rational points of the unipotent radicals of its parabolic subgroups.
-/

universe u

namespace Langlands.GroupScheme.Quaternionic

/-- **Kneser–Tits for quaternionic symplectic groups of Witt index one.** -/
theorem localSymplecticKneserTits : LocalSymplecticKneserTitsStatement.{u} :=
  localSymplecticKneserTits_of_isConnectedReductive
    fun _ _ _ _ _ _ _ hD σ hS _ _ _ H hH hu _ =>
      FirstKindInvolution.isConnectedReductive_symplecticGroup hD σ hS H hH hu

end Langlands.GroupScheme.Quaternionic
