/-!
# Lifting Eichler transformations to a spin cover

For a spin cover `π : S ⟶ O(q)` and a hyperbolic pair `(e, f)` of `q`, the Eichler subgroup
`E` (generated by the Eichler transformations along `e` and `f`) is contained in the image of
the parabolic elementary subgroup `S(K)⁺` under the matrix map `s ↦ [π(s)]`.

Over a nonarchimedean local field, `S(K)⁺ = S(K)` follows from two further inputs about the
spin cover: rational points of `S` lying over a Levi element `ℓ(a)` give `ℓ(a) ∈ E`, and rational
points of `S` over the identity lie in `S(K)⁺`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Opposite Matrix
open scoped TensorProduct CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Multiplication by `m` on `𝔾_m` is the power map `Gm.powerHom S m`. -/
theorem multiplication_gm_eq_groupHom (S : Scheme.{u}) (m : ℤ) :
    multiplication (Gm S).toGrp m = CommGroupScheme.groupHom (Gm.powerHom S m) := by
  apply Grp.hom_ext
  rw [multiplication_hom, ← Category.id_comp (CommGroupScheme.groupHom (Gm.powerHom S m)).hom.hom,
    Gm.powerHom_apply, Gm.comp_zsmul_id]

namespace Quaternionic

namespace FirstKindInvolution.Eichler

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D] [FiniteDimensional K D]
  {σ : FirstKindInvolution K D} {n : Type} [Fintype n] [DecidableEq n]
  {q : σ.QuadraticForms n} {e f : n → D}

/-! ### Eigenvectors of the hyperbolic scaling -/

omit [FiniteDimensional K D] in
/-- A hyperbolic pair in the sense of `FirstKindInvolution.IsHyperbolicPair` is a hyperbolic pair
in the sense of `IsHyperbolic`. -/
theorem isHyperbolic_of_isHyperbolicPair (h : σ.IsHyperbolicPair q e f) :
    IsHyperbolic σ q e f :=
  ⟨h.1, h.2.1, h.2.2⟩

omit [FiniteDimensional K D] in
/-- If `s² ≠ 1`, every `s`-eigenvector of the hyperbolic scaling `M(s)` lies on the line `D e`. -/
theorem eq_smul_left_of_vecMul_hyperbolicScalingMatrix (h : σ.IsHyperbolicPair q e f)
    {s : Kˣ} (hs : (s : K) * s ≠ 1) {v : n → D}
    (hv : v ᵥ* σ.hyperbolicScalingMatrix q e f s = (s : K) • v) :
    v = σ.sesqForm (σ.polar q) v f • e := by
  have hs1 : (s : K) ≠ 1 := fun h1 => hs (by rw [h1, one_mul])
  have hss : (s : K) - ((s⁻¹ : Kˣ) : K) ≠ 0 := by
    intro h0
    apply hs
    have : (s : K) = ((s⁻¹ : Kˣ) : K) := sub_eq_zero.1 h0
    calc (s : K) * s = (s : K) * ((s⁻¹ : Kˣ) : K) := by rw [← this]
      _ = 1 := by rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have he : σ.sesqForm (σ.polar q) v e = 0 := by
    have h1 := congrArg (fun z => σ.sesqForm (σ.polar q) z e) hv
    simp only [vecMul_hyperbolicScalingMatrix, h.hyperbolicScaling_pair_left,
      sesqForm_polar_smul_left] at h1
    have h2 : ((s : K) - ((s⁻¹ : Kˣ) : K)) • σ.sesqForm (σ.polar q) v e = 0 := by
      rw [sub_smul, h1, sub_self]
    exact (smul_eq_zero.1 h2).resolve_left hss
  have hM : v ᵥ* σ.hyperbolicScalingMatrix q e f s =
      v + ((s : K) - 1) • (σ.sesqForm (σ.polar q) v f • e) +
        (((s⁻¹ : Kˣ) : K) - 1) • (σ.sesqForm (σ.polar q) v e • f) := by
    rw [hyperbolicScalingMatrix, Matrix.vecMul_add, Matrix.vecMul_add, Matrix.vecMul_one,
      Matrix.vecMul_smul, Matrix.vecMul_smul, vecMul_hyperbolicLineMatrix,
      vecMul_hyperbolicLineMatrix]
  rw [hM, he, zero_smul, smul_zero, add_zero] at hv
  have h3 : ((s : K) - 1) • (v - σ.sesqForm (σ.polar q) v f • e) = 0 := by
    rw [smul_sub, sub_smul, one_smul, ← hv]
    abel
  exact sub_eq_zero.1 ((smul_eq_zero.1 h3).resolve_left (sub_ne_zero.2 hs1))

omit [FiniteDimensional K D] in
/-- The hyperbolic scaling of `(e, f)` at `s` is that of `(f, e)` at `s⁻¹`. -/
theorem hyperbolicScalingMatrix_swap (s : Kˣ) :
    σ.hyperbolicScalingMatrix q e f s = σ.hyperbolicScalingMatrix q f e s⁻¹ := by
  rw [hyperbolicScalingMatrix, hyperbolicScalingMatrix, inv_inv, add_right_comm]

omit [FiniteDimensional K D] in
/-- If `s² ≠ 1`, every `s⁻¹`-eigenvector of the hyperbolic scaling `M(s)` lies on the line
`D f`. -/
theorem eq_smul_right_of_vecMul_hyperbolicScalingMatrix (h : σ.IsHyperbolicPair q e f)
    {s : Kˣ} (hs : (s : K) * s ≠ 1) {v : n → D}
    (hv : v ᵥ* σ.hyperbolicScalingMatrix q e f s = ((s⁻¹ : Kˣ) : K) • v) :
    v = σ.sesqForm (σ.polar q) v e • f := by
  rw [hyperbolicScalingMatrix_swap] at hv
  refine eq_smul_left_of_vecMul_hyperbolicScalingMatrix h.symm ?_ hv
  intro h1
  apply hs
  have : ((s * s : Kˣ) : K) = 1 := by
    rw [← inv_inv (s * s), mul_inv, Units.val_inv_eq_inv_val, Units.val_mul, h1, inv_one]
  rwa [Units.val_mul] at this

/-! ### Matrices of the hyperbolic cocharacter -/

variable [Infinite K]

/-- The matrix of the rational point `μ(t)` of the hyperbolic cocharacter is the hyperbolic
scaling matrix `M(t)`. -/
theorem isometryRationalMatrix_map_hyperbolicIsometryTorus (h : σ.IsHyperbolicPair q e f)
    (x : rationalPoints (Gm (Spec (CommRingCat.of K))).toGrp) :
    (isometryRationalMatrix σ q (rationalPoints.map h.hyperbolicIsometryTorus x) :
        Matrix n n D) =
      σ.hyperbolicScalingMatrix q e f (Gm.affineUnitsEquiv (CommRingCat.of K)
        (CommAlgCat.of K K) (GaloisPointComparison.rationalCoeffEquiv K _ x)) := by
  rw [isometryRationalMatrix_apply, GaloisPointComparison.rationalCoeffEquiv_map,
    affinePointsTarget_apply, Category.assoc, ← Grp.comp_hom_hom,
    h.hyperbolicIsometryTorus_comp]
  exact h.hyperbolicUnitTorus_affineMatrix _

/-! ### Lifting contracting points to a spin cover -/

variable {S : GroupScheme (Spec (CommRingCat.of K))} {π : S ⟶ σ.isometryGroup q}

omit [Infinite K] in
variable (π) in
/-- The matrix of the image `π(s)` of a rational point `s` of `S`. -/
def spinRationalMatrix : rationalPoints S →* (Matrix n n D)ˣ :=
  (isometryRationalMatrix σ q).comp (rationalPoints.map π)

omit [Infinite K] in
theorem spinRationalMatrix_apply (s : rationalPoints S) :
    spinRationalMatrix π s = isometryRationalMatrix σ q (rationalPoints.map π s) :=
  rfl

omit [Infinite K] in
/-- **Lifting contracting points.** For a spin cover `π : S ⟶ O(q)`, every rational point of
`O(q)` contracted by a cocharacter `ν` of `O(q)` is the image of a point of the parabolic
elementary subgroup `S(K)⁺`. -/
theorem exists_mem_parabolicElementarySubgroup_of_mem_unipotent (hπ : σ.IsSpinCover q π)
    (ν : (Gm (Spec (CommRingCat.of K))).toGrp ⟶ σ.isometryGroup q)
    {g : rationalPoints (σ.isometryGroup q)}
    (hg : g ∈ (Dynamic.unipotent ν).carrier (Over.mk (𝟙 _))) :
    ∃ s ∈ parabolicElementarySubgroup S, rationalPoints.map π s = g := by
  have hG := hπ.isSimplyConnected.isSemisimple.isConnectedReductive
  have := hπ.smooth
  obtain ⟨p, hp, hpπ⟩ := hπ.exists_centralIsogeny
  have : IsAffineHom S.X.hom := hG.isAffineHom
  have : IsAffine S.X.left := isAffine_of_isAffineHom S.X.hom
  have : IsAffine (σ.connectedIsometryGroup q).X.left :=
    isAffine_of_isAffineHom (σ.connectedIsometryGroup q).X.hom
  have : ConnectedSpace (Gm (Spec (CommRingCat.of K))).X.left := isSplitTorus_gm.connectedSpace
  set ν₀ := IdentityComponent.factor (σ.isometryGroup q) ν with hν₀def
  have hν₀ : ν₀ ≫ identityComponentι (σ.isometryGroup q) = ν :=
    IdentityComponent.factor_identityComponentι _ _
  obtain ⟨N, hN0, hN⟩ := hp.exists_pow_eq_one_kernel
  obtain ⟨χ, hχ⟩ := hp.exists_comp_eq_multiplication_comp ν₀ hN
  have hgr : g ∈ (SubgroupFunctor.range (identityComponentι (σ.isometryGroup q))).carrier
      (Over.mk (𝟙 _)) :=
    (AutomorphicAction.cocharacterAction ν).unipotent_le_identityComponent _
      (by rw [AutomorphicAction.cocharacterAction_unipotent]; exact hg)
  obtain ⟨g₀, hg₀⟩ := SubgroupFunctor.mem_range.1 hgr
  have hg₀U : g₀ ∈ (Dynamic.unipotent ν₀).carrier (Over.mk (𝟙 _)) := by
    rw [Dynamic.unipotent_eq_comap_of_isClosedSubgroup ν₀ _
      (IdentityComponent.isClosedSubgroup_identityComponentι _), SubgroupFunctor.mem_comap,
      hν₀, hg₀]
    exact hg
  have hg₀U' : g₀ ∈ (Dynamic.unipotent (χ ≫ p)).carrier (Over.mk (𝟙 _)) := by
    rw [hχ, multiplication_gm_eq_groupHom, Dynamic.unipotent_precomp_power _ (by omega)]
    exact hg₀U
  obtain ⟨s, hs, hsp⟩ := Dynamic.exists_unipotent_lift p hp χ g₀ hg₀U'
  refine ⟨s, dynamicUnipotent_le_parabolicElementarySubgroup hG χ hs, ?_⟩
  rw [rationalPoints.map_apply, ← hpπ, Grp.comp_hom_hom, ← Category.assoc, hsp, hg₀]

variable [LinearOrder n]

/-- **The Eichler subgroup lifts.** Every element of the Eichler subgroup of a hyperbolic pair is
the matrix of the image of a point of `S(K)⁺`. -/
theorem eichlerSubgroup_le_map (hπ : σ.IsSpinCover q π) (h : σ.IsHyperbolicPair q e f) :
    eichlerSubgroup σ q e f ≤ (parabolicElementarySubgroup S).map (spinRationalMatrix π) := by
  rw [eichlerSubgroup, Subgroup.closure_le]
  rintro u (hu | hu)
  · obtain ⟨g, hg, rfl⟩ := exists_mem_unipotent_of_mem_eichlerSet_left h hu
    obtain ⟨s, hs, rfl⟩ := exists_mem_parabolicElementarySubgroup_of_mem_unipotent hπ _ hg
    exact ⟨s, hs, rfl⟩
  · obtain ⟨g, hg, rfl⟩ := exists_mem_unipotent_of_mem_eichlerSet h hu
    obtain ⟨s, hs, rfl⟩ := exists_mem_parabolicElementarySubgroup_of_mem_unipotent hπ _ hg
    exact ⟨s, hs, rfl⟩

/-- **Kneser–Tits from the two spin inputs.** Let `K` be a nonarchimedean local field, `(e, f)`
a hyperbolic pair of `q` with anisotropic orthogonal complement `{e, f}^⊥`, `σ` with a nonzero
alternating element `a₀`, and `π : S ⟶ O(q)` a spin cover. Assume:

* (`hlevi`) whenever the matrix of `π(s)` is a Levi element `ℓ(a)`, then `ℓ(a) ∈ E`;
* (`hker`) every rational point `s` with `π(s) = 1` lies in `S(K)⁺`.

Then `S(K)⁺ = S(K)`. -/
theorem parabolicElementarySubgroup_eq_top_of_levi_of_kernel
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    (h : σ.IsHyperbolicPair q e f) {a₀ : D} (ha₀ : a₀ ∈ σ.alternatingSubspace)
    (ha₀₀ : a₀ ≠ 0)
    (hanis : ∀ y, σ.sesqForm (σ.polar q) y e = 0 → σ.sesqForm (σ.polar q) y f = 0 →
      σ.quadraticValue y q = 0 → y = 0)
    (hπ : σ.IsSpinCover q π)
    (hlevi : ∀ (s : rationalPoints S) (a : Dˣ),
      isometryRationalMatrix σ q (rationalPoints.map π s) =
          levi σ q (isHyperbolic_of_isHyperbolicPair h) a →
        levi σ q (isHyperbolic_of_isHyperbolicPair h) a ∈ eichlerSubgroup σ q e f)
    (hker : ∀ s : rationalPoints S, rationalPoints.map π s = 1 →
      s ∈ parabolicElementarySubgroup S) :
    parabolicElementarySubgroup S = ⊤ := by
  classical
  have hG := hπ.isSimplyConnected.isSemisimple.isConnectedReductive
  have := hπ.smooth
  obtain ⟨p, hp, hpπ⟩ := hπ.exists_centralIsogeny
  set hP := isHyperbolic_of_isHyperbolicPair h
  set φ := spinRationalMatrix π with hφ
  have hE := eichlerSubgroup_le_map hπ h
  -- a power of the hyperbolic cocharacter lifts to `S`
  obtain ⟨N, hN0, hN⟩ := hp.exists_pow_eq_one_kernel
  obtain ⟨χ, hχ⟩ := hp.exists_comp_eq_multiplication_comp h.hyperbolicConnectedTorus hN
  have : ConnectedSpace (Gm (Spec (CommRingCat.of K))).X.left := isSplitTorus_gm.connectedSpace
  have hμ₀ : h.hyperbolicConnectedTorus ≫ identityComponentι (σ.isometryGroup q) =
      h.hyperbolicIsometryTorus :=
    IdentityComponent.factor_identityComponentι _ _
  have hχπ : χ ≫ π = multiplication (Gm (Spec (CommRingCat.of K))).toGrp ((2 * N : ℕ) : ℤ) ≫
      h.hyperbolicIsometryTorus := by
    rw [← hpπ, ← Category.assoc, hχ, Category.assoc, hμ₀]
  -- a scalar `t` with `t ^ (4N) ≠ 1`
  obtain ⟨t₀, ht₀⟩ := (insert (0 : K) (Polynomial.nthRootsFinset (4 * N) (1 : K))).exists_notMem
  have ht₀0 : t₀ ≠ 0 := fun h0 => ht₀ (by rw [h0]; exact Finset.mem_insert_self _ _)
  have ht₀1 : t₀ ^ (4 * N) ≠ 1 := fun h1 => ht₀ (Finset.mem_insert_of_mem
    ((Polynomial.mem_nthRootsFinset (by omega) (1 : K)).2 h1))
  set t : Kˣ := Units.mk0 t₀ ht₀0
  set s₀ : Kˣ := t ^ (2 * N)
  have hs₀ : (s₀ : K) * s₀ ≠ 1 := by
    intro h1
    apply ht₀1
    have : (s₀ : K) * s₀ = t₀ ^ (4 * N) := by
      simp only [s₀, t, Units.val_pow_eq_pow_val, Units.val_mk0, ← pow_add]
      ring_nf
    rw [← this, h1]
  -- the rational point of `𝔾_m` with value `t`
  set x : rationalPoints (Gm (Spec (CommRingCat.of K))).toGrp :=
    (GaloisPointComparison.rationalCoeffEquiv K _).symm
      ((Gm.affineUnitsEquiv (CommRingCat.of K) (CommAlgCat.of K K)).symm t)
  have hxM : ((φ (x ≫ χ.hom.hom) : (Matrix n n D)ˣ) : Matrix n n D) =
      σ.hyperbolicScalingMatrix q e f s₀ := by
    have hxχ : rationalPoints.map π (x ≫ χ.hom.hom) =
        rationalPoints.map h.hyperbolicIsometryTorus (x ^ (((2 * N : ℕ) : ℤ))) := by
      rw [rationalPoints.map_apply, rationalPoints.map_apply, Category.assoc, ← Grp.comp_hom_hom,
        hχπ, Grp.comp_hom_hom, ← Category.assoc, points_multiplication]
    rw [hφ, spinRationalMatrix_apply, hxχ, isometryRationalMatrix_map_hyperbolicIsometryTorus,
      map_zpow, map_zpow]
    simp only [x, MulEquiv.apply_symm_apply, s₀, zpow_natCast]
  -- every point of the dynamic centralizer of `χ` lies in `S(K)⁺`
  have key : (Dynamic.centralizer χ).rationalPoints ≤ parabolicElementarySubgroup S := by
    intro s hs
    set u := φ s with hu
    have hcomm : (u : Matrix n n D) * σ.hyperbolicScalingMatrix q e f s₀ =
        σ.hyperbolicScalingMatrix q e f s₀ * u := by
      have hc := ((Dynamic.commute_cocharacter_of_mem_centralizer χ hs x).map φ).eq
      have := congrArg Units.val hc
      rwa [Units.val_mul, Units.val_mul, hxM] at this
    have hMe : e ᵥ* σ.hyperbolicScalingMatrix q e f s₀ = (s₀ : K) • e := by
      rw [vecMul_hyperbolicScalingMatrix, h.hyperbolicScaling_left]
    have hMf : f ᵥ* σ.hyperbolicScalingMatrix q e f s₀ = ((s₀⁻¹ : Kˣ) : K) • f := by
      rw [vecMul_hyperbolicScalingMatrix, h.hyperbolicScaling_right]
    have hue := eq_smul_left_of_vecMul_hyperbolicScalingMatrix h hs₀
      (v := e ᵥ* (u : Matrix n n D)) (by
        rw [vecMul_vecMul, hcomm, ← vecMul_vecMul, hMe, Matrix.smul_vecMul])
    have huf := eq_smul_right_of_vecMul_hyperbolicScalingMatrix h hs₀
      (v := f ᵥ* (u : Matrix n n D)) (by
        rw [vecMul_vecMul, hcomm, ← vecMul_vecMul, hMf, Matrix.smul_vecMul])
    have hsup := mem_sup_of_vecMul_eq_smul hP ha₀ ha₀₀ hanis
      (isometryRationalMatrix_mem σ q _) hue huf
    rw [← SetLike.mem_coe, Subgroup.coe_mul_of_left_le_normalizer_right _ _
      (range_levi_le_normalizer hP)] at hsup
    obtain ⟨_, ⟨a, rfl⟩, ε, hε, hℓε⟩ := hsup
    obtain ⟨s₁, hs₁, hφs₁⟩ := hE hε
    have hφs₁' : φ s₁ = ε := hφs₁
    have hφ₁ : φ (s * s₁⁻¹) = levi σ q hP a := by
      have hℓε' : φ s = levi σ q hP a * ε := hℓε.symm
      rw [_root_.map_mul, _root_.map_inv, hφs₁', hℓε']
      exact mul_inv_cancel_right _ _
    obtain ⟨s₂, hs₂, hφs₂⟩ := hE (hlevi (s * s₁⁻¹) a hφ₁)
    have hφs₂' : φ s₂ = levi σ q hP a := hφs₂
    have hk : rationalPoints.map π (s * s₁⁻¹ * s₂⁻¹) = 1 := by
      apply isometryRationalMatrix_injective σ q
      change φ (s * s₁⁻¹ * s₂⁻¹) = _
      rw [_root_.map_one, _root_.map_mul, _root_.map_inv, hφ₁, hφs₂', mul_inv_cancel]
    have hmem := (parabolicElementarySubgroup S).mul_mem
      ((parabolicElementarySubgroup S).mul_mem (hker _ hk) hs₂) hs₁
    rwa [inv_mul_cancel_right, inv_mul_cancel_right] at hmem
  have htop := centralizer_rationalPoints_sup_parabolicElementarySubgroup_of_localField K hG χ
  rw [eq_top_iff, ← htop]
  exact sup_le key le_rfl

end FirstKindInvolution.Eichler

end Quaternionic

end Langlands.GroupScheme
