import Langlands.GroupScheme.Quaternionic.UnitaryMatrices

/-!
# Generation of the unitary group of the standard antihermitian form of rank two

For an involution of the first kind `σ` of a division algebra `D`, let
`J = !![0, 1; -1, 0]`. With the weights `(1, -1)`, the unitary matrices of contracting shape
are the matrices `!![1, x; 0, 1]` and, for the opposite weights, `!![1, 0; x, 1]` with
`σ x = x`. When `D` is a quaternion algebra whose involution has a `3`-dimensional symmetric
part, every invertible `g` with `g J ᵗg^σ = J` is a product of such matrices.
-/

noncomputable section

universe u v

namespace Langlands.GroupScheme.Quaternionic

namespace FirstKindInvolution

variable {K : Type u} {D : Type v} [Field K] [DivisionRing D] [Algebra K D]
  (σ : FirstKindInvolution K D)

/-! ### The standard Gram matrix, weights and special matrices -/

variable (D) in
/-- The Gram matrix `!![0, 1; -1, 0]` of a hyperbolic pair `e, f` with `h(e, f) = 1`. -/
def gramTwo : Matrix (Fin 2) (Fin 2) D :=
  !![0, 1; -1, 0]

/-- The weights `(1, -1)` of the standard basis. -/
def weightTwo : Fin 2 → ℤ :=
  ![1, -1]

/-- The diagonal matrix with diagonal entries `p, q`. -/
def diagTwo (p q : D) : Matrix (Fin 2) (Fin 2) D :=
  !![p, 0; 0, q]

/-- The Weyl-type matrix `!![0, s; -s⁻¹, 0]`. -/
def weylTwo (s : D) : Matrix (Fin 2) (Fin 2) D :=
  !![0, s; -s⁻¹, 0]

/-- The upper matrix `!![1, x; 0, 1]`. -/
def upTwo (x : D) : Matrix (Fin 2) (Fin 2) D :=
  !![1, x; 0, 1]

/-- The lower matrix `!![1, 0; x, 1]`. -/
def loTwo (x : D) : Matrix (Fin 2) (Fin 2) D :=
  !![1, 0; x, 1]

/-- The subgroup generated by the unitary matrices of contracting shape for the weights
`(1, -1)` or `(-1, 1)`. -/
abbrev elementaryTwo : Subgroup (Matrix (Fin 2) (Fin 2) D)ˣ :=
  σ.contractingElementarySubgroup (gramTwo D) weightTwo

/-! ### The isometry equation entrywise -/

theorem mul_gramTwo_mul_apply (M : Matrix (Fin 2) (Fin 2) D) (i j : Fin 2) :
    (M * gramTwo D * σ.matrix (Fin 2) M) i j = M i 0 * σ (M j 1) - M i 1 * σ (M j 0) := by
  simp [Matrix.mul_apply, Fin.sum_univ_two, gramTwo]
  abel

theorem isometry_gramTwo_iff (M : Matrix (Fin 2) (Fin 2) D) :
    M * gramTwo D * σ.matrix (Fin 2) M = gramTwo D ↔
      ∀ i j, M i 0 * σ (M j 1) - M i 1 * σ (M j 0) = gramTwo D i j := by
  rw [← Matrix.ext_iff]
  simp only [σ.mul_gramTwo_mul_apply]

theorem isUnit_gramTwo : IsUnit (gramTwo D) := by
  refine IsUnit.of_mul_eq_one (!![0, -1; 1, 0]) ?_
  ext i j
  fin_cases i <;> fin_cases j <;> simp [gramTwo, Matrix.mul_apply, Fin.sum_univ_two]

variable {σ}

theorem upTwo_isometry {x : D} (h : σ x = x) :
    upTwo x * gramTwo D * σ.matrix (Fin 2) (upTwo x) = gramTwo D := by
  rw [isometry_gramTwo_iff]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [upTwo, gramTwo, h]

theorem loTwo_isometry {x : D} (h : σ x = x) :
    loTwo x * gramTwo D * σ.matrix (Fin 2) (loTwo x) = gramTwo D := by
  rw [isometry_gramTwo_iff]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [loTwo, gramTwo, h]

theorem diagTwo_isometry {p q : D} (h : p * σ q = 1) :
    diagTwo p q * gramTwo D * σ.matrix (Fin 2) (diagTwo p q) = gramTwo D := by
  have h' : q * σ p = 1 := by simpa using congrArg σ h
  rw [isometry_gramTwo_iff]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [diagTwo, gramTwo, h, h']

theorem upTwo_isContracting (x : D) : IsContracting weightTwo (upTwo x) := by
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [weightTwo, upTwo] at hij ⊢

theorem loTwo_isContracting (x : D) : IsContracting (-weightTwo) (loTwo x) := by
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [weightTwo, loTwo] at hij ⊢

/-! ### Realized matrices -/

theorem realized_upTwo {x : D} (h : σ x = x) : Realized σ.elementaryTwo (upTwo x) :=
  σ.realized_of_isometry isUnit_gramTwo _ (upTwo_isometry h) (Or.inl (upTwo_isContracting x))

theorem realized_loTwo {x : D} (h : σ x = x) : Realized σ.elementaryTwo (loTwo x) :=
  σ.realized_of_isometry isUnit_gramTwo _ (loTwo_isometry h) (Or.inr (loTwo_isContracting x))

theorem weylTwo_eq {s : D} (hs : s ≠ 0) : weylTwo s = upTwo s * loTwo (-s⁻¹) * upTwo s := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [weylTwo, upTwo, loTwo, Matrix.mul_apply, Fin.sum_univ_two, hs]

theorem realized_weylTwo {s : D} (hs : σ s = s) (hs0 : s ≠ 0) :
    Realized σ.elementaryTwo (weylTwo s) := by
  rw [weylTwo_eq hs0]
  exact ((realized_upTwo hs).mul (realized_loTwo (by simp [hs]))).mul (realized_upTwo hs)

theorem diagTwo_mul_diagTwo (p q p' q' : D) :
    diagTwo p q * diagTwo p' q' = diagTwo (p * p') (q * q') := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [diagTwo, Matrix.mul_apply, Fin.sum_univ_two]

theorem diagTwo_one : diagTwo (1 : D) 1 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [diagTwo]

/-- `diag(a, σ(a)⁻¹)` is a product of two Weyl-type matrices, writing `a = s t` with `s, t`
symmetric. -/
theorem realized_diagTwo [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) {a : D} (ha : a ≠ 0) :
    Realized σ.elementaryTwo (diagTwo a (σ a)⁻¹) := by
  obtain ⟨s, t, hs, ht, ht0, rfl⟩ := σ.exists_eq_mul_symmetric hD hS a
  have hs0 : s ≠ 0 := by
    rintro rfl
    simp at ha
  have e : diagTwo (s * t) (σ (s * t))⁻¹ = weylTwo s * weylTwo (-t⁻¹) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [diagTwo, weylTwo, Matrix.mul_apply, Fin.sum_univ_two, hs, ht, mul_inv_rev]
  rw [e]
  exact (realized_weylTwo hs hs0).mul (realized_weylTwo (by simp [ht]) (by simp [ht0]))

/-! ### Generation -/

/-- The first row of an isometry can be moved to `(*, 0)` by a realized matrix. -/
theorem exists_realized_row_zero_two {M : Matrix (Fin 2) (Fin 2) D}
    (hM : M * gramTwo D * σ.matrix (Fin 2) M = gramTwo D) :
    ∃ N, Realized σ.elementaryTwo N ∧ (M * N) 0 1 = 0 := by
  have hiso := (σ.isometry_gramTwo_iff M).1 hM 0 0
  have hrel : M 0 0 * σ (M 0 1) = M 0 1 * σ (M 0 0) := sub_eq_zero.1 (by simpa [gramTwo] using hiso)
  by_cases hv : M 0 0 = 0
  · refine ⟨weylTwo 1, realized_weylTwo σ.map_one one_ne_zero, ?_⟩
    simp [weylTwo, Matrix.mul_apply, Fin.sum_univ_two, hv]
  · have hσv : σ (M 0 0) ≠ 0 := σ.map_ne_zero hv
    have hu : σ (M 0 1) = (M 0 0)⁻¹ * (M 0 1 * σ (M 0 0)) := by
      rw [eq_inv_mul_iff_mul_eq₀ hv]
      exact hrel
    have hs : σ (-((M 0 0)⁻¹ * M 0 1)) = -((M 0 0)⁻¹ * M 0 1) := by
      rw [σ.map_neg, σ.map_mul, σ.map_inv, hu, mul_assoc, mul_assoc, mul_inv_cancel₀ hσv,
        mul_one]
    refine ⟨upTwo (-((M 0 0)⁻¹ * M 0 1)), realized_upTwo hs, ?_⟩
    simp [upTwo, Matrix.mul_apply, Fin.sum_univ_two, hv]

/-- An isometry whose first row is `(a, 0)` is `diag(a, σ(a)⁻¹)` times a lower matrix. -/
theorem realized_of_row_zero_two [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) {M : Matrix (Fin 2) (Fin 2) D}
    (hM : M * gramTwo D * σ.matrix (Fin 2) M = gramTwo D) (h01 : M 0 1 = 0) :
    Realized σ.elementaryTwo M := by
  have e01 := (σ.isometry_gramTwo_iff M).1 hM 0 1
  simp [gramTwo, h01] at e01
  have ha : M 0 0 ≠ 0 := by
    rintro h
    rw [h, zero_mul] at e01
    exact zero_ne_one e01
  have hσa : σ (M 0 0) ≠ 0 := σ.map_ne_zero ha
  have h11 : M 1 1 = (σ (M 0 0))⁻¹ := by
    rw [← σ.apply_apply (M 1 1), eq_inv_of_mul_eq_one_right e01, σ.map_inv]
  have hDinv : diagTwo (M 0 0)⁻¹ (σ (M 0 0)) * gramTwo D *
      σ.matrix (Fin 2) (diagTwo (M 0 0)⁻¹ (σ (M 0 0))) = gramTwo D :=
    diagTwo_isometry (by simp [ha])
  have hL := σ.realized_of_isometry isUnit_gramTwo weightTwo
    (σ.isometry_mul hDinv hM) (M := diagTwo (M 0 0)⁻¹ (σ (M 0 0)) * M) (Or.inr (by
      intro i j hij
      fin_cases i <;> fin_cases j <;> simp [weightTwo] at hij ⊢ <;>
        simp [diagTwo, Matrix.mul_apply, Fin.sum_univ_two, h01, h11, ha, hσa]))
  have e : diagTwo (M 0 0) (σ (M 0 0))⁻¹ * (diagTwo (M 0 0)⁻¹ (σ (M 0 0)) * M) = M := by
    rw [← mul_assoc, diagTwo_mul_diagTwo]
    simp [ha, hσa, diagTwo_one]
  rw [← e]
  exact (realized_diagTwo hD hS ha).mul hL

/-- **Generation.** Every isometry of the standard rank-two form is a product of unitary
matrices of contracting shape for the weights `(1, -1)` and `(-1, 1)`. -/
theorem unitaryMatrixGroup_gramTwo_le [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) :
    σ.unitaryMatrixGroup (gramTwo D) ≤ σ.elementaryTwo := by
  intro g hg
  obtain ⟨N, hN, h1⟩ := exists_realized_row_zero_two (σ.mem_unitaryMatrixGroup.1 hg)
  have hgN := σ.isometry_mul (σ.mem_unitaryMatrixGroup.1 hg) (σ.isometry_of_realized hN)
  exact Realized.mem (Realized.of_mul_right hN (realized_of_row_zero_two hD hS hgN h1) rfl)

theorem elementaryTwo_eq [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) :
    σ.elementaryTwo = σ.unitaryMatrixGroup (gramTwo D) :=
  le_antisymm (σ.contractingElementarySubgroup_le _ _) (σ.unitaryMatrixGroup_gramTwo_le hD hS)

end FirstKindInvolution

end Langlands.GroupScheme.Quaternionic
