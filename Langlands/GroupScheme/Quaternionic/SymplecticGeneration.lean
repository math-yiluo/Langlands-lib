import Langlands.GroupScheme.Quaternionic.SymplecticRationalPoints
import Langlands.GroupScheme.Quaternionic.HyperbolicBasis
import Langlands.GroupScheme.Quaternionic.LocalSymplecticKneserTitsStatement
import Langlands.GroupScheme.Rational.DynamicElementarySubgroup
import Langlands.GroupScheme.Rational.ParabolicWhiteheadIsomorphism
import Langlands.GroupScheme.Dynamic.CentralizerReductiveTransport

/-!
# Generation of the rational points of quaternionic symplectic groups of Witt index one

If the symplectic group `G` of a Gram matrix `H₀` is connected reductive, the cocharacters with
weights `pairWeight a b` and `pairWeight b a` factor through `G`, and the isometries of `H₀` are
generated by the isometries of contracting shape for these weights, then
`parabolicElementarySubgroup G = ⊤`: every generator is the matrix of a rational point in a
dynamic unipotent subgroup, hence in a parabolic radical. This applies to the standard Gram
matrices `gramTwo D` and `gramThree c`, and transports to every nondegenerate antihermitian form
of rank two or three and Witt index one through `symplecticGroupCongr`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.Quaternionic

open FiniteAlgebraUnits.WeightedRoot

theorem neg_pairWeight {n : Type} [DecidableEq n] (a b : n) :
    -pairWeight a b = pairWeight b a := by
  funext i
  simp only [Pi.neg_apply, pairWeight, neg_sub]

namespace FirstKindInvolution

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D] [FiniteDimensional K D]
  [Algebra.IsCentral K D] (σ : FirstKindInvolution K D)

section Criterion

variable {n : Type} [Fintype n] [DecidableEq n] [Nonempty n]

/-- **Generation criterion.** If the symplectic group of `H₀` is connected reductive, `H₀` is
supported where the weights `pairWeight a b` add to zero, and the isometries of `H₀` are
generated by those of contracting shape for `±pairWeight a b`, then its rational points are
generated by the rational points of the unipotent radicals of its parabolic subgroups. -/
theorem parabolicElementarySubgroup_eq_top_of_le_contracting (H₀ : Matrix n n D) (a b : n)
    (hab : a ≠ b) (hH : ∀ i j, H₀ i j ≠ 0 → pairWeight a b i + pairWeight a b j = 0)
    (hG : IsConnectedReductive (σ.symplecticGroup H₀))
    (hgen : σ.unitaryMatrixGroup H₀ ≤ σ.contractingElementarySubgroup H₀ (pairWeight a b)) :
    parabolicElementarySubgroup (σ.symplecticGroup H₀) = ⊤ := by
  have hH' : ∀ i j, H₀ i j ≠ 0 → pairWeight b a i + pairWeight b a j = 0 := by
    intro i j h
    have h1 := hH i j h
    rw [← neg_pairWeight, Pi.neg_apply, Pi.neg_apply]
    omega
  have hgens : σ.contractingElementarySubgroup H₀ (pairWeight a b) ≤
      (parabolicElementarySubgroup (σ.symplecticGroup H₀)).map (σ.rationalMatrix H₀) := by
    refine (Subgroup.closure_le _).2 ?_
    rintro u ⟨hu, hc | hc⟩
    · obtain ⟨y, hy, rfl⟩ := σ.exists_rationalMatrix_eq_of_contracting H₀ a b hab hH u hu hc
      exact ⟨y, dynamicUnipotent_le_parabolicElementarySubgroup hG _ hy, rfl⟩
    · rw [neg_pairWeight] at hc
      obtain ⟨y, hy, rfl⟩ :=
        σ.exists_rationalMatrix_eq_of_contracting H₀ b a hab.symm hH' u hu hc
      exact ⟨y, dynamicUnipotent_le_parabolicElementarySubgroup hG _ hy, rfl⟩
  rw [eq_top_iff]
  intro x _
  obtain ⟨y, hy, hxy⟩ := hgens (hgen (σ.rationalMatrix_mem H₀ x))
  rwa [σ.rationalMatrix_injective H₀ hxy] at hy

end Criterion

/-- **Rank two, standard form.** -/
theorem parabolicElementarySubgroup_gramTwo_eq_top (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3)
    (hG : IsConnectedReductive (σ.symplecticGroup (gramTwo D))) :
    parabolicElementarySubgroup (σ.symplecticGroup (gramTwo D)) = ⊤ := by
  have hw : weightTwo = pairWeight (0 : Fin 2) 1 := by
    funext i
    fin_cases i <;> simp [pairWeight, weightTwo]
  refine σ.parabolicElementarySubgroup_eq_top_of_le_contracting (gramTwo D) 0 1 (by decide) ?_ hG
    ?_
  · intro i j h
    fin_cases i <;> fin_cases j <;> simp_all [gramTwo, pairWeight]
  · rw [← hw]
    exact unitaryMatrixGroup_gramTwo_le (σ := σ) hD hS

/-- **Rank three, standard form.** -/
theorem parabolicElementarySubgroup_gramThree_eq_top (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) {c : D} (hc : c ∈ σ.alternatingSubspace)
    (hc0 : c ≠ 0) (hG : IsConnectedReductive (σ.symplecticGroup (gramThree c))) :
    parabolicElementarySubgroup (σ.symplecticGroup (gramThree c)) = ⊤ := by
  have hw : weightThree = pairWeight (0 : Fin 3) 1 := by
    funext i
    fin_cases i <;> simp [pairWeight, weightThree]
  refine σ.parabolicElementarySubgroup_eq_top_of_le_contracting (gramThree c) 0 1 (by decide) ?_
    hG ?_
  · intro i j h
    fin_cases i <;> fin_cases j <;> simp_all [gramThree, pairWeight]
  · rw [← hw]
    exact unitaryMatrixGroup_gramThree_le (σ := σ) hD hS hc hc0

/-- **Witt index one.** For a nondegenerate antihermitian form of rank two or three and Witt index
one whose symplectic group is connected reductive, the rational points of the symplectic group
are generated by the rational points of the unipotent radicals of its parabolic subgroups. -/
theorem parabolicElementarySubgroup_eq_top_of_wittIndex_eq_one (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) {m : ℕ} [NeZero m] (hm : m = 2 ∨ m = 3)
    (H : Matrix (Fin m) (Fin m) D) (hH : σ.IsAntihermitian H) (hu : IsUnit H)
    (hw : σ.wittIndex H = 1) (hG : IsConnectedReductive (σ.symplecticGroup H)) :
    parabolicElementarySubgroup (σ.symplecticGroup H) = ⊤ := by
  rcases hm with rfl | rfl
  · obtain ⟨P, hP, hPH⟩ := exists_gramTwo hH hu hw
    have e := σ.symplecticGroupCongr hP.unit H
    rw [IsUnit.unit_spec, hPH] at e
    rw [parabolicElementarySubgroup_eq_top_iff_iso e]
    exact σ.parabolicElementarySubgroup_gramTwo_eq_top hD hS (IsConnectedReductive.of_iso e.symm hG)
  · obtain ⟨P, c, hc, hc0, hP, hPH⟩ := exists_gramThree hH hu hw
    have e := σ.symplecticGroupCongr hP.unit H
    rw [IsUnit.unit_spec, hPH] at e
    rw [parabolicElementarySubgroup_eq_top_iff_iso e]
    exact σ.parabolicElementarySubgroup_gramThree_eq_top hD hS hc hc0
      (IsConnectedReductive.of_iso e.symm hG)

end FirstKindInvolution

/-- The Kneser–Tits statement for quaternionic symplectic groups of Witt index one follows from
connected reductivity of these groups. -/
theorem localSymplecticKneserTits_of_isConnectedReductive
    (hred : ∀ (K : Type u) [Field K] (D : Type u) [DivisionRing D] [Algebra K D]
      [Algebra.IsCentral K D] [FiniteDimensional K D], Module.finrank K D = 4 →
      ∀ σ : FirstKindInvolution K D, Module.finrank K σ.symmetricSubspace = 3 →
      ∀ (m : ℕ) [NeZero m], (m = 2 ∨ m = 3) →
      ∀ H : Matrix (Fin m) (Fin m) D, σ.IsAntihermitian H → IsUnit H → σ.wittIndex H = 1 →
        IsConnectedReductive (σ.symplecticGroup H)) :
    LocalSymplecticKneserTitsStatement.{u} := by
  intro K _ _ _ _ D _ _ _ _ hD σ hS m _ hm H hH hu hw
  exact σ.parabolicElementarySubgroup_eq_top_of_wittIndex_eq_one hD hS hm H hH hu hw
    (hred K D hD σ hS m hm H hH hu hw)

end Langlands.GroupScheme.Quaternionic
