import Langlands.GroupScheme.Quaternionic.UnitaryMatrices
import Mathlib.Tactic.NoncommRing

/-!
# Generation of the unitary group of the standard antihermitian form of rank three

For an involution of the first kind `σ` of a division algebra `D` and a nonzero `c ∈ {a - σ a}`,
let `H₀ = !![0, 1, 0; -1, 0, 0; 0, 0, c]`. With the weights `(1, -1, 0)`, the unitary matrices of
contracting shape are the upper matrices `!![1, x, b; 0, 1, 0; 0, y, 1]` and, for the opposite
weights, the lower matrices `!![1, 0, 0; x, 1, b; y, 0, 1]` that satisfy `g H₀ ᵗg^σ = H₀`. When
`D` is a quaternion algebra whose involution has a `3`-dimensional symmetric part, every
invertible `g` with `g H₀ ᵗg^σ = H₀` is a product of such matrices.
-/

noncomputable section

universe u v

namespace Langlands.GroupScheme.Quaternionic

namespace FirstKindInvolution

variable {K : Type u} {D : Type v} [Field K] [DivisionRing D] [Algebra K D]
  (σ : FirstKindInvolution K D)

/-! ### The standard Gram matrix, weights and special matrices -/

/-- The Gram matrix `!![0, 1, 0; -1, 0, 0; 0, 0, c]`: a hyperbolic pair `e, f` with
`h(e, f) = 1`, orthogonal to a vector of value `c`. -/
def gramThree (c : D) : Matrix (Fin 3) (Fin 3) D :=
  !![0, 1, 0; -1, 0, 0; 0, 0, c]

/-- The weights `(1, -1, 0)` of the standard basis. -/
def weightThree : Fin 3 → ℤ :=
  ![1, -1, 0]

/-- The diagonal matrix with diagonal entries `p, q, r`. -/
def diagThree (p q r : D) : Matrix (Fin 3) (Fin 3) D :=
  !![p, 0, 0; 0, q, 0; 0, 0, r]

/-- The Weyl-type matrix `!![0, s, 0; -s⁻¹, 0, 0; 0, 0, 1]`. -/
def weylThree (s : D) : Matrix (Fin 3) (Fin 3) D :=
  !![0, s, 0; -s⁻¹, 0, 0; 0, 0, 1]

/-- The upper matrix `!![1, x, b; 0, 1, 0; 0, c σ(b), 1]`. -/
def upThree (c b x : D) : Matrix (Fin 3) (Fin 3) D :=
  !![1, x, b; 0, 1, 0; 0, c * σ b, 1]

/-- The lower matrix `!![1, 0, 0; x, 1, b; -c σ(b), 0, 1]`. -/
def loThree (c b x : D) : Matrix (Fin 3) (Fin 3) D :=
  !![1, 0, 0; x, 1, b; -(c * σ b), 0, 1]

/-- The subgroup generated by the unitary matrices of contracting shape for the weights
`(1, -1, 0)` or `(-1, 1, 0)`. -/
abbrev elementaryThree (c : D) : Subgroup (Matrix (Fin 3) (Fin 3) D)ˣ :=
  σ.contractingElementarySubgroup (gramThree c) weightThree

/-! ### The isometry equation entrywise -/

theorem mul_gramThree_mul_apply (c : D) (M : Matrix (Fin 3) (Fin 3) D) (i j : Fin 3) :
    (M * gramThree c * σ.matrix (Fin 3) M) i j =
      M i 0 * σ (M j 1) - M i 1 * σ (M j 0) + M i 2 * c * σ (M j 2) := by
  simp [Matrix.mul_apply, Fin.sum_univ_three, gramThree]
  abel

theorem isometry_gramThree_iff (c : D) (M : Matrix (Fin 3) (Fin 3) D) :
    M * gramThree c * σ.matrix (Fin 3) M = gramThree c ↔
      ∀ i j, M i 0 * σ (M j 1) - M i 1 * σ (M j 0) + M i 2 * c * σ (M j 2) =
        gramThree c i j := by
  rw [← Matrix.ext_iff]
  simp only [σ.mul_gramThree_mul_apply]

theorem isUnit_gramThree {c : D} (hc : c ≠ 0) : IsUnit (gramThree c) := by
  refine IsUnit.of_mul_eq_one (!![0, -1, 0; 1, 0, 0; 0, 0, c⁻¹]) ?_
  ext i j
  fin_cases i <;> fin_cases j <;> simp [gramThree, Matrix.mul_apply, Fin.sum_univ_three, hc]

variable {σ}

theorem upThree_isometry {c b x : D} (hc : σ c = -c) (h : x - σ x = b * c * σ b) :
    σ.upThree c b x * gramThree c * σ.matrix (Fin 3) (σ.upThree c b x) = gramThree c := by
  have hx : σ x = x - b * c * σ b := by
    calc σ x = x - (x - σ x) := by abel
      _ = x - b * c * σ b := by rw [h]
  rw [isometry_gramThree_iff]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [upThree, gramThree, hc, hx, mul_assoc]

theorem loThree_isometry {c b x : D} (hc : σ c = -c) (h : x - σ x = -(b * c * σ b)) :
    σ.loThree c b x * gramThree c * σ.matrix (Fin 3) (σ.loThree c b x) = gramThree c := by
  have hx : σ x = x + b * c * σ b := by
    calc σ x = x - (x - σ x) := by abel
      _ = x + b * c * σ b := by rw [h, sub_neg_eq_add]
  rw [isometry_gramThree_iff]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [loThree, gramThree, hc, hx, mul_assoc]

theorem diagThree_isometry {c p q r : D} (h : p * σ q = 1) (hr : r * c * σ r = c) :
    diagThree p q r * gramThree c * σ.matrix (Fin 3) (diagThree p q r) = gramThree c := by
  have h' : q * σ p = 1 := by simpa using congrArg σ h
  rw [isometry_gramThree_iff]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [diagThree, gramThree, h, h', hr]

theorem upThree_isContracting (c b x : D) : IsContracting weightThree (σ.upThree c b x) := by
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [weightThree, upThree] at hij ⊢

theorem loThree_isContracting (c b x : D) : IsContracting (-weightThree) (σ.loThree c b x) := by
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [weightThree, loThree] at hij ⊢

/-! ### Realized matrices -/

section Realized

variable {c : D}

theorem realized_upThree (hc : σ c = -c) (hc0 : c ≠ 0) {b x : D} (h : x - σ x = b * c * σ b) :
    Realized (σ.elementaryThree c) (σ.upThree c b x) :=
  σ.realized_of_isometry (isUnit_gramThree hc0) _ (upThree_isometry hc h)
    (Or.inl (upThree_isContracting c b x))

theorem realized_loThree (hc : σ c = -c) (hc0 : c ≠ 0) {b x : D}
    (h : x - σ x = -(b * c * σ b)) :
    Realized (σ.elementaryThree c) (σ.loThree c b x) :=
  σ.realized_of_isometry (isUnit_gramThree hc0) _ (loThree_isometry hc h)
    (Or.inr (loThree_isContracting c b x))

theorem weylThree_eq (c : D) {s : D} (hs : s ≠ 0) :
    weylThree s = σ.upThree c 0 s * σ.loThree c 0 (-s⁻¹) * σ.upThree c 0 s := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [weylThree, upThree, loThree, Matrix.mul_apply, Fin.sum_univ_three, hs]

theorem realized_weylThree (hc : σ c = -c) (hc0 : c ≠ 0) {s : D} (hs : σ s = s) (hs0 : s ≠ 0) :
    Realized (σ.elementaryThree c) (weylThree s) := by
  rw [σ.weylThree_eq c hs0]
  refine ((realized_upThree hc hc0 ?_).mul (realized_loThree hc hc0 ?_)).mul
    (realized_upThree hc hc0 ?_) <;> simp [hs]

theorem diagThree_mul_diagThree (p q r p' q' r' : D) :
    diagThree p q r * diagThree p' q' r' = diagThree (p * p') (q * q') (r * r') := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [diagThree, Matrix.mul_apply, Fin.sum_univ_three]

theorem diagThree_one : diagThree (1 : D) 1 1 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [diagThree]

/-- `diag(a, σ(a)⁻¹, 1)` is a product of two Weyl-type matrices, writing `a = s t` with `s, t`
symmetric. -/
theorem realized_diagThree_left [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) (hc : σ c = -c) (hc0 : c ≠ 0) {a : D}
    (ha : a ≠ 0) : Realized (σ.elementaryThree c) (diagThree a (σ a)⁻¹ 1) := by
  obtain ⟨s, t, hs, ht, ht0, rfl⟩ := σ.exists_eq_mul_symmetric hD hS a
  have hs0 : s ≠ 0 := by
    rintro rfl
    simp at ha
  have e : diagThree (s * t) (σ (s * t))⁻¹ 1 = weylThree s * weylThree (-t⁻¹) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [diagThree, weylThree, Matrix.mul_apply, Fin.sum_univ_three, hs, ht, mul_inv_rev]
  rw [e]
  exact (realized_weylThree hc hc0 hs hs0).mul
    (realized_weylThree hc hc0 (by simp [ht]) (by simp [ht0]))

/-- The matrix `!![0, x, 0; -σ(x)⁻¹, 0, 0; 0, 0, σ(x) x⁻¹]` for `c = x - σ x`. -/
def nThree (x : D) : Matrix (Fin 3) (Fin 3) D :=
  !![0, x, 0; -(σ x)⁻¹, 0, 0; 0, 0, σ x * x⁻¹]

theorem nThree_eq {x : D} (hx : x ≠ 0) :
    σ.nThree x = σ.upThree (x - σ x) 1 x * σ.loThree (x - σ x) (-x⁻¹) (-(σ x)⁻¹) *
      σ.upThree (x - σ x) (-(σ x * x⁻¹)) x := by
  have hy : σ x ≠ 0 := σ.map_ne_zero hx
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [nThree, upThree, loThree, Matrix.mul_apply, Fin.sum_univ_three] <;>
    simp only [add_mul, mul_sub, sub_mul, neg_mul, mul_one, one_mul, mul_assoc,
      mul_inv_cancel₀ hx, inv_mul_cancel₀ hx, inv_mul_cancel_left₀ hx, mul_inv_cancel₀ hy,
      mul_inv_cancel_left₀ hy, inv_mul_cancel_left₀ hy] <;>
    abel

theorem realized_nThree {x : D} (hx : x ≠ 0) (hc0 : x - σ x ≠ 0) :
    Realized (σ.elementaryThree (x - σ x)) (σ.nThree x) := by
  have hy : σ x ≠ 0 := σ.map_ne_zero hx
  have hc : σ (x - σ x) = -(x - σ x) := by simp
  rw [σ.nThree_eq hx]
  refine ((realized_upThree hc hc0 ?_).mul (realized_loThree hc hc0 ?_)).mul
    (realized_upThree hc hc0 ?_)
  · simp
  · simp only [map_neg, map_inv, apply_apply, mul_sub, sub_mul, mul_neg, neg_mul, neg_neg,
      mul_assoc, inv_mul_cancel_left₀ hx, mul_inv_cancel₀ hy, mul_one]
  · simp only [map_neg, map_mul, map_inv, apply_apply, mul_sub, sub_mul, mul_neg, neg_mul,
      mul_assoc, mul_inv_cancel_left₀ hy, inv_mul_cancel₀ hx, mul_one]
    abel

/-- `diag(1, 1, w)` for `w c σ(w) = c`. -/
theorem realized_diagThree_right [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) (hc : σ c = -c) (hc0 : c ≠ 0) {w : D}
    (hw : w * c * σ w = c) : Realized (σ.elementaryThree c) (diagThree 1 1 w) := by
  by_cases hw1 : w = 1
  · subst hw1
    rw [diagThree_one]
    exact Realized.one
  have hw0 : w ≠ 0 := by
    rintro rfl
    simp at hw
    exact hc0 hw.symm
  have hσw0 : σ w ≠ 0 := σ.map_ne_zero hw0
  have h1w : 1 - w ≠ 0 := sub_ne_zero.2 (Ne.symm hw1)
  have h1σw : 1 - σ w ≠ 0 := by
    intro h
    apply h1w
    simpa using congrArg σ h
  obtain ⟨x, hx0, hxc, hxw⟩ : ∃ x : D, x ≠ 0 ∧ x - σ x = c ∧ σ x * x⁻¹ = w := by
    have hxc : (1 - w)⁻¹ * c - σ ((1 - w)⁻¹ * c) = c := by
      have hw' : w * (c * σ w) = c := by rw [← mul_assoc, hw]
      have key : (1 - w) * ((1 - w)⁻¹ * c - σ ((1 - w)⁻¹ * c)) * (1 - σ w) =
          (1 - w) * c * (1 - σ w) := by
        have hσ : σ ((1 - w)⁻¹ * c) = -(c * (1 - σ w)⁻¹) := by simp [hc]
        rw [hσ, sub_neg_eq_add, mul_add, mul_inv_cancel_left₀ h1w, add_mul, mul_assoc (1 - w),
          mul_assoc c, inv_mul_cancel₀ h1σw, mul_one]
        simp only [mul_sub, sub_mul, one_mul, mul_one, mul_assoc, hw']
        abel
      exact mul_left_cancel₀ h1w (mul_right_cancel₀ h1σw key)
    refine ⟨(1 - w)⁻¹ * c, mul_ne_zero (inv_ne_zero h1w) hc0, hxc, ?_⟩
    have hσx : σ ((1 - w)⁻¹ * c) = (1 - w)⁻¹ * c - c := by
      calc σ ((1 - w)⁻¹ * c) = (1 - w)⁻¹ * c - ((1 - w)⁻¹ * c - σ ((1 - w)⁻¹ * c)) := by abel
        _ = (1 - w)⁻¹ * c - c := by rw [hxc]
    rw [hσx, sub_mul, mul_inv_cancel₀ (mul_ne_zero (inv_ne_zero h1w) hc0), mul_inv_rev, inv_inv,
      ← mul_assoc, mul_inv_cancel₀ hc0, one_mul]
    abel
  subst hxc hxw
  have hy : σ x ≠ 0 := σ.map_ne_zero hx0
  have hd := realized_diagThree_left hD hS hc hc0 (inv_ne_zero hy)
  rw [map_inv, apply_apply, inv_inv] at hd
  have hW := realized_weylThree hc hc0 (σ.map_one) one_ne_zero
  refine Realized.of_mul_left (hW.mul hd) (realized_nThree hx0 hc0) ?_
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [nThree, weylThree, diagThree, Matrix.mul_apply, Fin.sum_univ_three]

end Realized

/-! ### Generation -/

section Generation

variable {c : D}

/-- If the first row of an isometry `M` is `(v, u, 0)`, a Weyl-type matrix or an upper
matrix moves it to `(*, 0, 0)`. -/
theorem exists_realized_row_zero_of_two (hc : σ c = -c) (hc0 : c ≠ 0)
    {M : Matrix (Fin 3) (Fin 3) D} (hM : M * gramThree c * σ.matrix (Fin 3) M = gramThree c)
    (h02 : M 0 2 = 0) :
    ∃ N, Realized (σ.elementaryThree c) N ∧ (M * N) 0 1 = 0 ∧ (M * N) 0 2 = 0 := by
  have hiso := (σ.isometry_gramThree_iff c M).1 hM 0 0
  simp only [h02, zero_mul, add_zero, gramThree] at hiso
  have hrel : M 0 0 * σ (M 0 1) = M 0 1 * σ (M 0 0) := sub_eq_zero.1 (by simpa using hiso)
  by_cases hv : M 0 0 = 0
  · refine ⟨weylThree 1, realized_weylThree hc hc0 σ.map_one one_ne_zero, ?_, ?_⟩ <;>
      simp [weylThree, Matrix.mul_apply, Fin.sum_univ_three, hv, h02]
  · have hσv : σ (M 0 0) ≠ 0 := σ.map_ne_zero hv
    have hu : σ (M 0 1) = (M 0 0)⁻¹ * (M 0 1 * σ (M 0 0)) := by
      rw [eq_inv_mul_iff_mul_eq₀ hv]
      exact hrel
    have hs : σ (-((M 0 0)⁻¹ * M 0 1)) = -((M 0 0)⁻¹ * M 0 1) := by
      rw [σ.map_neg, σ.map_mul, σ.map_inv, hu, mul_assoc, mul_assoc, mul_inv_cancel₀ hσv,
        mul_one]
    refine ⟨σ.upThree c 0 (-((M 0 0)⁻¹ * M 0 1)), realized_upThree hc hc0 (by simp [hs]), ?_,
      ?_⟩
    · simp [upThree, Matrix.mul_apply, Fin.sum_univ_three, h02, hv]
    · simp [upThree, Matrix.mul_apply, Fin.sum_univ_three, h02]

/-- The first row of an isometry can be moved to `(*, 0, 0)` by a realized matrix. -/
theorem exists_realized_row_zero (hc : c ∈ σ.alternatingSubspace) (hc0 : c ≠ 0)
    {M : Matrix (Fin 3) (Fin 3) D} (hM : M * gramThree c * σ.matrix (Fin 3) M = gramThree c) :
    ∃ N, Realized (σ.elementaryThree c) N ∧ (M * N) 0 1 = 0 ∧ (M * N) 0 2 = 0 := by
  have hc' := σ.map_eq_neg_of_mem_alternating hc
  by_cases h01 : M 0 1 = 0
  · have hiso := (σ.isometry_gramThree_iff c M).1 hM 0 0
    simp [gramThree, h01, hc0] at hiso
    exact ⟨1, Realized.one, by simpa using h01, by simpa using hiso⟩
  obtain ⟨c₀, hc₀⟩ := σ.mem_alternatingSubspace.1 hc
  obtain ⟨b, hb⟩ : ∃ b : D, b = -((M 0 1)⁻¹ * M 0 2) := ⟨_, rfl⟩
  have hL : Realized (σ.elementaryThree c) (σ.loThree c b (-(b * c₀ * σ b))) := by
    refine realized_loThree hc' hc0 ?_
    rw [← hc₀]
    simp
    noncomm_ring
  have hM' := σ.isometry_mul hM (σ.isometry_of_realized hL)
  have h02 : (M * σ.loThree c b (-(b * c₀ * σ b))) 0 2 = 0 := by
    simp [loThree, Matrix.mul_apply, Fin.sum_univ_three, hb, h01]
  obtain ⟨N, hN, h1, h2⟩ := exists_realized_row_zero_of_two hc' hc0 hM' h02
  exact ⟨_, hL.mul hN, by rwa [← mul_assoc], by rwa [← mul_assoc]⟩

/-- An isometry whose first row is `(a, 0, 0)` is realized: it is `diag(a, σ(a)⁻¹, w)` times a
lower matrix. -/
theorem realized_of_row_zero [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) (hc : σ c = -c) (hc0 : c ≠ 0)
    {M : Matrix (Fin 3) (Fin 3) D} (hM : M * gramThree c * σ.matrix (Fin 3) M = gramThree c)
    (h01 : M 0 1 = 0) (h02 : M 0 2 = 0) : Realized (σ.elementaryThree c) M := by
  have hiso := (σ.isometry_gramThree_iff c M).1 hM
  have e01 := hiso 0 1
  have e02 := hiso 0 2
  have e22 := hiso 2 2
  simp [gramThree, h01, h02] at e01 e02 e22
  have ha : M 0 0 ≠ 0 := by
    rintro h
    rw [h, zero_mul] at e01
    exact zero_ne_one e01
  have hσa : σ (M 0 0) ≠ 0 := σ.map_ne_zero ha
  have h21 : M 2 1 = 0 := e02.resolve_left ha
  simp [h21] at e22
  have h11 : M 1 1 = (σ (M 0 0))⁻¹ := by
    rw [← σ.apply_apply (M 1 1), eq_inv_of_mul_eq_one_right e01, σ.map_inv]
  have hw0 : M 2 2 ≠ 0 := by
    rintro h
    rw [h] at e22
    simp at e22
    exact hc0 e22.symm
  have hσw0 : σ (M 2 2) ≠ 0 := σ.map_ne_zero hw0
  have hDinv : diagThree (M 0 0)⁻¹ (σ (M 0 0)) (M 2 2)⁻¹ * gramThree c *
      σ.matrix (Fin 3) (diagThree (M 0 0)⁻¹ (σ (M 0 0)) (M 2 2)⁻¹) = gramThree c := by
    refine diagThree_isometry (by simp [ha]) ?_
    calc (M 2 2)⁻¹ * c * σ (M 2 2)⁻¹
        = (M 2 2)⁻¹ * (M 2 2 * c * σ (M 2 2)) * (σ (M 2 2))⁻¹ := by rw [e22, σ.map_inv]
      _ = c := by simp [mul_assoc, hw0, hσw0]
  have hL := σ.realized_of_isometry (isUnit_gramThree hc0) weightThree
    (σ.isometry_mul hDinv hM) (M := diagThree (M 0 0)⁻¹ (σ (M 0 0)) (M 2 2)⁻¹ * M) (Or.inr (by
      intro i j hij
      fin_cases i <;> fin_cases j <;> simp [weightThree] at hij ⊢ <;>
        simp [diagThree, Matrix.mul_apply, Fin.sum_univ_three, h01, h02, h21, h11, ha, hσa,
          hw0]))
  have e : diagThree (M 0 0) (σ (M 0 0))⁻¹ 1 * diagThree 1 1 (M 2 2) *
      (diagThree (M 0 0)⁻¹ (σ (M 0 0)) (M 2 2)⁻¹ * M) = M := by
    rw [diagThree_mul_diagThree, ← mul_assoc, diagThree_mul_diagThree]
    simp [ha, hσa, hw0, diagThree_one]
  rw [← e]
  exact ((realized_diagThree_left hD hS hc hc0 ha).mul
    (realized_diagThree_right hD hS hc hc0 e22)).mul hL

/-- **Generation.** Every isometry of the standard rank-three form is a product of unitary
matrices of contracting shape for the weights `(1, -1, 0)` and `(-1, 1, 0)`. -/
theorem unitaryMatrixGroup_gramThree_le [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) (hc : c ∈ σ.alternatingSubspace)
    (hc0 : c ≠ 0) : σ.unitaryMatrixGroup (gramThree c) ≤ σ.elementaryThree c := by
  intro g hg
  have hc' := σ.map_eq_neg_of_mem_alternating hc
  obtain ⟨N, hN, h1, h2⟩ := σ.exists_realized_row_zero hc hc0 (σ.mem_unitaryMatrixGroup.1 hg)
  have hgN := σ.isometry_mul (σ.mem_unitaryMatrixGroup.1 hg) (σ.isometry_of_realized hN)
  exact Realized.mem
    (Realized.of_mul_right hN (realized_of_row_zero hD hS hc' hc0 hgN h1 h2) rfl)

theorem elementaryThree_eq [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) (hc : c ∈ σ.alternatingSubspace)
    (hc0 : c ≠ 0) : σ.elementaryThree c = σ.unitaryMatrixGroup (gramThree c) :=
  le_antisymm (σ.contractingElementarySubgroup_le _ _)
    (σ.unitaryMatrixGroup_gramThree_le hD hS hc hc0)

end Generation

end FirstKindInvolution

end Langlands.GroupScheme.Quaternionic
