import Langlands.GroupScheme.Quaternionic.AlternatingConjugation
import Langlands.GroupScheme.Quaternionic.Forms
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.Matrix.Notation

/-!
# Unitary matrix groups of forms over a division algebra with involution

For an involution of the first kind `σ` of a division algebra `D` over a field `K` and a
Gram matrix `H ∈ M_n(D)`, this module defines the group of invertible matrices `g` with
`g H ᵗg^σ = H`, the matrices of contracting shape for an integral weight function on the
index type, and the subgroup generated by the contracting unitary matrices for a weight
function and its negative. It also proves that every element of a quaternion algebra with
an involution of the first kind whose symmetric elements form a `3`-dimensional subspace is a
product of two symmetric elements.
-/

noncomputable section

universe u v w

namespace Langlands.GroupScheme.Quaternionic

namespace FirstKindInvolution

variable {K : Type u} {D : Type v} [Field K] [DivisionRing D] [Algebra K D]
  (σ : FirstKindInvolution K D)

/-! ### The involution on inverses -/

@[simp] theorem map_eq_zero_iff {x : D} : σ x = 0 ↔ x = 0 := by
  constructor
  · intro h
    apply σ.injective
    rw [h, map_zero]
  · rintro rfl
    exact σ.map_zero

theorem map_ne_zero {x : D} (hx : x ≠ 0) : σ x ≠ 0 :=
  fun h => hx (σ.map_eq_zero_iff.1 h)

/-! ### Unitary matrices -/

variable {n : Type w} [Fintype n] [DecidableEq n]

/-- The group of invertible matrices `g ∈ GL_n(D)` with `g H ᵗg^σ = H`: the isometries of the
form with Gram matrix `H` for the row action. -/
def unitaryMatrixGroup (H : Matrix n n D) : Subgroup (Matrix n n D)ˣ where
  carrier := {g | (g : Matrix n n D) * H * σ.matrix n g = H}
  mul_mem' := by
    intro g h (hg : (g : Matrix n n D) * H * σ.matrix n g = H)
      (hh : (h : Matrix n n D) * H * σ.matrix n h = H)
    change ((g * h : (Matrix n n D)ˣ) : Matrix n n D) * H * σ.matrix n (g * h : (Matrix n n D)ˣ)
      = H
    rw [Units.val_mul, map_mul]
    calc (g : Matrix n n D) * h * H * (σ.matrix n h * σ.matrix n g)
        = g * (h * H * σ.matrix n h) * σ.matrix n g := by simp only [mul_assoc]
      _ = H := by rw [hh, hg]
  one_mem' := by
    change ((1 : (Matrix n n D)ˣ) : Matrix n n D) * H * σ.matrix n (1 : (Matrix n n D)ˣ) = H
    simp
  inv_mem' := by
    intro g (hg : (g : Matrix n n D) * H * σ.matrix n g = H)
    change ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) * H *
      σ.matrix n (g⁻¹ : (Matrix n n D)ˣ) = H
    have h1 : ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) * g = 1 := g.inv_mul
    have h2 : σ.matrix n g * σ.matrix n ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) = 1 := by
      rw [← map_mul, h1, map_one]
    calc ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) * H *
          σ.matrix n ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D)
        = ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) * (g * H * σ.matrix n g) *
            σ.matrix n ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) := by rw [hg]
      _ = (((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) * g) * H *
            (σ.matrix n g * σ.matrix n ((g⁻¹ : (Matrix n n D)ˣ) : Matrix n n D)) := by
          simp only [mul_assoc]
      _ = H := by rw [h1, h2, one_mul, mul_one]

theorem mem_unitaryMatrixGroup {H : Matrix n n D} {g : (Matrix n n D)ˣ} :
    g ∈ σ.unitaryMatrixGroup H ↔ (g : Matrix n n D) * H * σ.matrix n g = H :=
  Iff.rfl

/-- The isometry equation is stable under products. -/
theorem isometry_mul {H M N : Matrix n n D} (hM : M * H * σ.matrix n M = H)
    (hN : N * H * σ.matrix n N = H) : M * N * H * σ.matrix n (M * N) = H := by
  rw [map_mul]
  calc M * N * H * (σ.matrix n N * σ.matrix n M)
      = M * (N * H * σ.matrix n N) * σ.matrix n M := by simp only [mul_assoc]
    _ = H := by rw [hN, hM]

/-- A matrix `g` with `g H ᵗg^σ = H` for an invertible `H` is invertible. -/
theorem isUnit_of_isometry {H : Matrix n n D} (hH : IsUnit H) {g : Matrix n n D}
    (hg : g * H * σ.matrix n g = H) : IsUnit g := by
  refine IsUnit.of_mul_eq_one (H * σ.matrix n g * ((hH.unit⁻¹ : (Matrix n n D)ˣ) :
    Matrix n n D)) ?_
  calc g * (H * σ.matrix n g * ((hH.unit⁻¹ : (Matrix n n D)ˣ) : Matrix n n D))
      = (g * H * σ.matrix n g) * ((hH.unit⁻¹ : (Matrix n n D)ˣ) : Matrix n n D) := by
        simp only [mul_assoc]
    _ = 1 := by rw [hg]; exact hH.mul_val_inv

/-- The unitary unit with a prescribed matrix satisfying the isometry equation. -/
def unitaryOfIsometry {H : Matrix n n D} (hH : IsUnit H) {g : Matrix n n D}
    (hg : g * H * σ.matrix n g = H) : σ.unitaryMatrixGroup H :=
  ⟨(σ.isUnit_of_isometry hH hg).unit, hg⟩

@[simp] theorem unitaryOfIsometry_val {H : Matrix n n D} (hH : IsUnit H) {g : Matrix n n D}
    (hg : g * H * σ.matrix n g = H) :
    (((σ.unitaryOfIsometry hH hg : σ.unitaryMatrixGroup H) : (Matrix n n D)ˣ) :
      Matrix n n D) = g :=
  rfl

/-! ### Contracting matrices and the elementary subgroup -/

/-- A matrix has contracting shape for an integral weight function `w` on the indices when
it agrees with the identity matrix at every position `(i, j)` with `w i ≤ w j`. Its other
entries sit at the positions of strictly positive weight `w i - w j`. -/
def IsContracting (w : n → ℤ) (g : Matrix n n D) : Prop :=
  ∀ i j, w i ≤ w j → g i j = (1 : Matrix n n D) i j

/-- The subgroup of `GL_n(D)` generated by the unitary matrices of contracting shape for `w`
or for `-w`. -/
def contractingElementarySubgroup (H : Matrix n n D) (w : n → ℤ) : Subgroup (Matrix n n D)ˣ :=
  Subgroup.closure {g | g ∈ σ.unitaryMatrixGroup H ∧
    (IsContracting w (g : Matrix n n D) ∨ IsContracting (-w) (g : Matrix n n D))}

theorem contractingElementarySubgroup_le (H : Matrix n n D) (w : n → ℤ) :
    σ.contractingElementarySubgroup H w ≤ σ.unitaryMatrixGroup H :=
  (Subgroup.closure_le _).2 fun _ hg => hg.1

/-- A matrix is realized in a subgroup `E` of `GL_n(D)` when it is the underlying matrix of an
element of `E`. -/
def Realized (E : Subgroup (Matrix n n D)ˣ) (M : Matrix n n D) : Prop :=
  ∃ g ∈ E, (g : Matrix n n D) = M

namespace Realized

variable {E : Subgroup (Matrix n n D)ˣ} {M N P : Matrix n n D}

theorem one : Realized E (1 : Matrix n n D) :=
  ⟨1, E.one_mem, rfl⟩

theorem mul (hM : Realized E M) (hN : Realized E N) : Realized E (M * N) := by
  obtain ⟨g, hg, rfl⟩ := hM
  obtain ⟨h, hh, rfl⟩ := hN
  exact ⟨g * h, E.mul_mem hg hh, rfl⟩

/-- If `M` and `M N` are realized, so is `N`. -/
theorem of_mul_left (hM : Realized E M) (hP : Realized E P) (h : M * N = P) :
    Realized E N := by
  obtain ⟨g, hg, rfl⟩ := hM
  obtain ⟨p, hp, rfl⟩ := hP
  refine ⟨g⁻¹ * p, E.mul_mem (E.inv_mem hg) hp, ?_⟩
  rw [Units.val_mul, ← h, ← mul_assoc, Units.inv_mul, one_mul]

/-- If `N` and `M N` are realized, so is `M`. -/
theorem of_mul_right (hN : Realized E N) (hP : Realized E P) (h : M * N = P) :
    Realized E M := by
  obtain ⟨g, hg, rfl⟩ := hN
  obtain ⟨p, hp, rfl⟩ := hP
  refine ⟨p * g⁻¹, E.mul_mem hp (E.inv_mem hg), ?_⟩
  rw [Units.val_mul, ← h, mul_assoc, Units.mul_inv, mul_one]

/-- A unit whose underlying matrix is realized in `E` lies in `E`. -/
theorem mem {g : (Matrix n n D)ˣ} (hg : Realized E (g : Matrix n n D)) : g ∈ E := by
  obtain ⟨e, he, h⟩ := hg
  rwa [← Units.ext h]

end Realized

/-- A matrix realized in the contracting elementary subgroup satisfies the isometry
equation. -/
theorem isometry_of_realized {H : Matrix n n D} {w : n → ℤ} {M : Matrix n n D}
    (hM : Realized (σ.contractingElementarySubgroup H w) M) : M * H * σ.matrix n M = H := by
  obtain ⟨g, hg, rfl⟩ := hM
  exact σ.contractingElementarySubgroup_le H w hg

/-- A matrix of contracting shape for `w` or `-w` that satisfies the isometry equation is
realized in the contracting elementary subgroup. -/
theorem realized_of_isometry {H : Matrix n n D} (hH : IsUnit H) (w : n → ℤ)
    {M : Matrix n n D} (hM : M * H * σ.matrix n M = H)
    (hw : IsContracting w M ∨ IsContracting (-w) M) :
    Realized (σ.contractingElementarySubgroup H w) M :=
  ⟨(σ.unitaryOfIsometry hH hM : (Matrix n n D)ˣ),
    Subgroup.subset_closure ⟨(σ.unitaryOfIsometry hH hM).2, hw⟩, rfl⟩

/-! ### Products of symmetric elements -/

/-- The symmetric elements are the kernel of `id - σ`. -/
theorem ker_id_sub_eq_symmetricSubspace :
    LinearMap.ker (LinearMap.id - σ.toLinearMap) = σ.symmetricSubspace := by
  ext x
  rw [LinearMap.mem_ker, mem_symmetricSubspace, LinearMap.sub_apply, LinearMap.id_apply,
    coe_toLinearMap, sub_eq_zero, eq_comm]

/-- In dimension `4` with `3`-dimensional symmetric part, the alternating elements form a
line. -/
theorem finrank_alternatingSubspace [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) :
    Module.finrank K σ.alternatingSubspace = 1 := by
  have h := LinearMap.finrank_range_add_finrank_ker (LinearMap.id - σ.toLinearMap)
  rw [ker_id_sub_eq_symmetricSubspace, hS, hD] at h
  have h1 : Module.finrank K (LinearMap.range (LinearMap.id - σ.toLinearMap)) = 1 := by omega
  exact h1

/-- For `a ∈ D`, the `K`-linear map `t ↦ a t - σ(a t)` from the symmetric elements to the
alternating elements. -/
def symmetricDefect (a : D) : σ.symmetricSubspace →ₗ[K] σ.alternatingSubspace :=
  LinearMap.codRestrict σ.alternatingSubspace
    ((LinearMap.id - σ.toLinearMap) ∘ₗ LinearMap.mulLeft K a ∘ₗ σ.symmetricSubspace.subtype)
    (fun t => σ.sub_mem_alternatingSubspace (a * t))

/-- Every element of a quaternion algebra whose involution has a `3`-dimensional symmetric
part is a product `s t` of symmetric elements with `t ≠ 0`. -/
theorem exists_eq_mul_symmetric [FiniteDimensional K D] (hD : Module.finrank K D = 4)
    (hS : Module.finrank K σ.symmetricSubspace = 3) (a : D) :
    ∃ s t : D, σ s = s ∧ σ t = t ∧ t ≠ 0 ∧ a = s * t := by
  have h := LinearMap.finrank_range_add_finrank_ker (σ.symmetricDefect a)
  have hr : Module.finrank K (LinearMap.range (σ.symmetricDefect a)) ≤ 1 := by
    rw [← σ.finrank_alternatingSubspace hD hS]
    exact Submodule.finrank_le _
  rw [hS] at h
  have hk : LinearMap.ker (σ.symmetricDefect a) ≠ ⊥ := by
    intro hbot
    rw [hbot, finrank_bot] at h
    omega
  obtain ⟨t, ht, ht0⟩ := Submodule.ne_bot_iff _ |>.1 hk
  have ht0' : (t : D) ≠ 0 := fun h0 => ht0 (Subtype.ext h0)
  have hts : σ (t : D) = t := σ.mem_symmetricSubspace.1 t.2
  have hat : (a * t : D) - σ (a * t) = 0 := by
    exact congrArg Subtype.val (LinearMap.mem_ker.1 ht)
  refine ⟨a * t, (t : D)⁻¹, (sub_eq_zero.1 hat).symm, ?_, inv_ne_zero ht0', ?_⟩
  · rw [map_inv, hts]
  · rw [mul_assoc, mul_inv_cancel₀ ht0', mul_one]

end FirstKindInvolution

end Langlands.GroupScheme.Quaternionic
