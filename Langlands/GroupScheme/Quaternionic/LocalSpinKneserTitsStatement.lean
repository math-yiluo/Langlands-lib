import Langlands.GroupScheme.Quaternionic.GroupSchemes
import Langlands.GroupScheme.Reductive.AlmostSimple
import Langlands.GroupScheme.Rational.SplitTorus
import Langlands.GroupScheme.Rational.ElementarySubgroup
import Mathlib.NumberTheory.LocalField.Basic

/-!
# Kneser–Tits for quaternionic spin groups of rank one over local fields

Statement only: for a nondegenerate quadratic form, in the sense of Tits, of rank 4 or 5 and
Witt index 1 over a quaternion division algebra with an involution of the first kind whose
symmetric elements have dimension 3, the rational points of every spin group are generated by
the rational points of the unipotent radicals of its parabolic subgroups, over every
nonarchimedean local field.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme.Quaternionic

/-- Over every nonarchimedean local field `K`, let `D` be a quaternion central division
`K`-algebra and `σ` an involution of the first kind of `D` with `dim_K D^σ = 3`. For
`m = 4` or `5`, every nondegenerate `σ`-quadratic form `q` on `D^m` of Witt index `1` and
every spin group `S` of `q`, the rational points of `S` are generated by the rational points
of the unipotent radicals of the parabolic `K`-subgroups: `parabolicElementarySubgroup S = ⊤`.
-/
def LocalSpinKneserTitsStatement : Prop :=
  ∀ (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    (D : Type u) [DivisionRing D] [Algebra K D] [Algebra.IsCentral K D]
    [FiniteDimensional K D],
    Module.finrank K D = 4 →
    ∀ σ : FirstKindInvolution K D, Module.finrank K σ.symmetricSubspace = 3 →
    ∀ m : ℕ, (m = 4 ∨ m = 5) →
    ∀ q : σ.QuadraticForms (Fin m), σ.IsNondegenerateQuadratic q →
      σ.quadraticWittIndex q = 1 →
      ∀ (S : GroupScheme (Spec (CommRingCat.of K))) (π : S ⟶ σ.isometryGroup q),
        σ.IsSpinCover q π → parabolicElementarySubgroup S = ⊤

end Langlands.GroupScheme.Quaternionic
