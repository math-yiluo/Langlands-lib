import Langlands.GroupScheme.Quaternionic.QuaternionicProperWittSplit
import Langlands.GroupScheme.Quaternionic.SkewUnitaryGalois
import Langlands.LinearAlgebra.GramQuadraticComparison

/-! # Special unitary groups of anisotropic forms over a split real quaternion algebra

Let `Q` be anisotropic over a field `K` of characteristic zero in which every element or its
negative is a square, sums of two squares are squares and `-1` is not a square (for instance
`K ≅ ℝ`). For vectors `u, w` with `Q(u), Q(w) ≠ 0`, the ratio `Q(u)/Q(w)` is a square `λ²`.
Set `m = u + λ w`. If `m = 0`, the vectors are proportional and the product of their reflections
is the identity. If `m ≠ 0`, anisotropy gives `Q(m) ≠ 0` and `r_m` sends `u` to `-λ w`, so
`r_m ∘ r_u ∘ r_m = r_w` and `r_w ∘ r_u = (r_m ∘ r_u)²`. In finite dimension the
Cartan–Dieudonné theorem writes every proper isometry as a product of an even number of
reflections. Grouping them in pairs shows that proper isometries are products of squares.

Over a field `K ⊇ F` with the preceding field hypotheses and a splitting of the quaternion
algebra `D`, a special unitary matrix of an invertible antihermitian Gram matrix `H` for the
canonical involution corresponds, in a two-by-two chart, to a proper isometry of the scalar
symmetric Gram matrix of `H`. If the antihermitian form is anisotropic, so is the scalar form,
and the special unitary group is generated by squares.
-/

noncomputable section

universe u v w

open Matrix
open scoped TensorProduct

namespace Langlands.QuadraticForm

open QuadraticMap

section Reflections

variable {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
  (Q : _root_.QuadraticForm K V)

theorem polar_isometryEquiv (g : Q.IsometryEquiv Q) (x y : V) :
    polar Q (g x) (g y) = polar Q x y := by
  simp only [polar, ← map_add, g.map_app]

theorem reflection_reflection (z : V) (hz : Q z ≠ 0) (x : V) :
    reflection Q z hz (reflection Q z hz x) = x := by
  simp only [reflection_apply, polar_sub_left, polar_smul_left, polar_self, nsmul_eq_mul,
    Nat.cast_ofNat, smul_eq_mul]
  have hc : (polar Q x z - (polar Q x z / Q z) * (2 * Q z)) / Q z = -(polar Q x z / Q z) := by
    field_simp
    ring
  rw [hc, neg_smul, sub_neg_eq_add, sub_add_cancel]

theorem reflection_symm_apply (z : V) (hz : Q z ≠ 0) (x : V) :
    (reflection Q z hz).symm x = reflection Q z hz x := by
  rw [(reflection Q z hz).symm_apply_eq, reflection_reflection]

theorem reflection_smul_apply (z : V) (hz : Q z ≠ 0) {c : K} (hc : c ≠ 0)
    (hcz : Q (c • z) ≠ 0) (x : V) :
    reflection Q (c • z) hcz x = reflection Q z hz x := by
  rw [reflection_apply, reflection_apply, polar_smul_right, QuadraticMap.map_smul, smul_eq_mul,
    smul_eq_mul, smul_smul]
  congr 2
  field_simp

theorem reflection_congr {a b : V} (ha : Q a ≠ 0) (hb : Q b ≠ 0) (h : a = b) :
    reflection Q a ha = reflection Q b hb := by
  subst h
  rfl

theorem reflection_conj (g : Q.IsometryEquiv Q) (z : V) (hz : Q z ≠ 0) (hgz : Q (g z) ≠ 0)
    (x : V) : g (reflection Q z hz (g.symm x)) = reflection Q (g z) hgz x := by
  have hgs : g (g.symm x) = x := (g.eq_symm_apply).mp rfl
  rw [reflection_apply, reflection_apply, map_sub, map_smul, hgs, g.map_app,
    ← polar_isometryEquiv Q g (g.symm x) z, hgs]

variable (hK1 : ∀ t : K, IsSquare t ∨ IsSquare (-t)) (hK2 : ∀ s t : K, IsSquare (s * s + t * t))
  (hK3 : ¬ IsSquare (-1 : K)) (hQ : ∀ v, Q v = 0 → v = 0)

include hK1 hK2 hK3 hQ

/-- Let `K` have characteristic zero. Assume each element or its negative is a square, sums
of two squares are squares, and `-1` is nonsquare. For an anisotropic quadratic form `Q` over
`K`, the ratio of two nonzero values of `Q` is a square. -/
theorem isSquare_div [CharZero K] {u w : V} (hu : Q u ≠ 0) (hw : Q w ≠ 0) :
    IsSquare (Q u / Q w) := by
  rcases hK1 (Q u / Q w) with h | ⟨μ, hμ⟩
  · exact h
  · exfalso
    set α := Q u
    set γ := Q w
    set β := polar Q u w
    have hαγ : α = -(μ * μ) * γ := by
      field_simp at hμ
      linear_combination -hμ
    obtain ⟨d, hd⟩ := hK2 β (2 * μ * γ)
    set s₀ : K := (d - β) / (2 * γ) with hs₀
    have hval : Q (u + s₀ • w) = 0 := by
      rw [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, polar_smul_right, smul_eq_mul,
        smul_eq_mul]
      change α + s₀ * s₀ * γ + s₀ * β = 0
      rw [hs₀, hαγ]
      field_simp
      linear_combination (-1 : K) * hd
    have hz := hQ _ hval
    have hu' : u = (-s₀) • w := by
      rw [neg_smul]
      exact eq_neg_of_add_eq_zero_left hz
    have hα : α = s₀ * s₀ * γ := by
      change Q u = _
      rw [hu', QuadraticMap.map_smul, smul_eq_mul, neg_mul_neg]
    by_cases hμ0 : μ = 0
    · apply hu
      rw [hαγ, hμ0, mul_zero, neg_zero, zero_mul]
    · apply hK3
      refine ⟨s₀ / μ, ?_⟩
      have h : (s₀ * s₀ + μ * μ) * γ = 0 := by linear_combination hα.symm.trans hαγ
      rcases mul_eq_zero.mp h with h' | h'
      · field_simp
        linear_combination -h'
      · exact absurd h' hw

/-- Under the hypotheses on `K` and `Q` of `isSquare_div`, let `u` and `w` have nonzero
quadratic values. Then either `r_w ∘ r_u = 1` or `r_w ∘ r_u = (r_m ∘ r_u)²` for a vector `m`
of nonzero quadratic value. -/
theorem trans_reflection_eq_or [CharZero K] {u w : V} (hu : Q u ≠ 0) (hw : Q w ≠ 0) :
    (reflection Q u hu).trans (reflection Q w hw) = QuadraticMap.IsometryEquiv.refl Q ∨
      ∃ (m : V) (hm : Q m ≠ 0),
        (reflection Q u hu).trans (reflection Q w hw) =
          ((reflection Q u hu).trans (reflection Q m hm)).trans
            ((reflection Q u hu).trans (reflection Q m hm)) := by
  obtain ⟨l, hl⟩ := isSquare_div Q hK1 hK2 hK3 hQ hu hw
  have hl0 : l ≠ 0 := by
    rintro rfl
    rw [mul_zero, div_eq_zero_iff] at hl
    rcases hl with h | h
    · exact hu h
    · exact hw h
  have hll : l * l * Q w = Q u := by rw [← hl]; field_simp
  by_cases hm0 : u + l • w = 0
  · left
    have hu' : u = (-l) • w := by
      rw [neg_smul]
      exact eq_neg_of_add_eq_zero_left hm0
    apply DFunLike.ext
    intro x
    change reflection Q w hw (reflection Q u hu x) = x
    have h1 : reflection Q u hu x = reflection Q w hw x := by
      have hu'' : Q ((-l) • w) ≠ 0 := hu' ▸ hu
      rw [reflection_congr Q hu hu'' hu']
      exact reflection_smul_apply Q w hw (neg_ne_zero.mpr hl0) hu'' x
    rw [h1, reflection_reflection]
  · right
    set m := u + l • w with hmdef
    have hm : Q m ≠ 0 := fun h => hm0 (hQ m h)
    refine ⟨m, hm, ?_⟩
    have hpol : polar Q u m = Q m := by
      rw [hmdef, polar_add_right, polar_smul_right, polar_self, QuadraticMap.map_add (⇑Q),
        QuadraticMap.map_smul, polar_smul_right]
      simp only [smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat]
      rw [hll]
      ring
    have hrm : reflection Q m hm u = (-l) • w := by
      rw [reflection_apply, hpol, div_self hm, one_smul, hmdef, neg_smul]
      abel
    have hrmu : Q (reflection Q m hm u) ≠ 0 := by
      rw [(reflection Q m hm).map_app]
      exact hu
    have hconj (y : V) : reflection Q m hm (reflection Q u hu (reflection Q m hm y)) =
        reflection Q w hw y := by
      have h := reflection_conj Q (reflection Q m hm) u hu hrmu y
      rw [reflection_symm_apply] at h
      rw [h]
      have hlw : Q ((-l) • w) ≠ 0 := hrm ▸ hrmu
      rw [reflection_congr Q hrmu hlw hrm]
      exact reflection_smul_apply Q w hw (neg_ne_zero.mpr hl0) hlw y
    apply DFunLike.ext
    intro x
    change reflection Q w hw (reflection Q u hu x) =
      reflection Q m hm (reflection Q u hu (reflection Q m hm (reflection Q u hu x)))
    rw [hconj]

end Reflections

end Langlands.QuadraticForm

namespace Langlands.GroupScheme.Quaternionic.SkewUnitary

open QuadraticMap Langlands.QuadraticForm Langlands.LinearAlgebra.OrthogonalCocycleDescent

/-! ### The split chart -/

section SplitChart

variable {R : Type u} {A : Type v} [Field R] [Ring A] [Algebra R A]
  {I : Type} [Fintype I] [DecidableEq I]
  (e : A ≃ₐ[R] Matrix (Fin 2) (Fin 2) R)

local notation "J" => FirstKindInvolution.gramTwo R
local notation "φ" => Matrix.compRingEquiv I (Fin 2) R

/-- Square matrices over a split quaternion algebra as scalar matrices of twice the size. -/
def splitChart : Matrix I I A ≃+* Matrix (I × Fin 2) (I × Fin 2) R :=
  (e.mapMatrix (m := I)).toRingEquiv.trans φ

theorem splitChart_apply (P : Matrix I I A) (i j : I) (a b : Fin 2) :
    splitChart e P (i, a) (j, b) = e (P i j) a b := rfl

omit [Fintype I] [DecidableEq I] in
theorem splitSkewScalarGram_injective' :
    Function.Injective (splitSkewScalarGram (I := I) e) := by
  intro H G heq
  let hJ : IsUnit (J : Matrix (Fin 2) (Fin 2) R) := FirstKindInvolution.isUnit_gramTwo
  ext i j
  apply e.injective
  have h : e (H i j) * J = e (G i j) * J := by
    ext a b
    have h' := congrArg (fun M : Matrix (I × Fin 2) (I × Fin 2) R => M (i, a) (j, b)) heq
    simpa only [splitSkewScalarGram_apply] using h'
  have h' := congrArg (· * (↑hJ.unit⁻¹ : Matrix (Fin 2) (Fin 2) R)) h
  simpa only [mul_assoc, hJ.mul_val_inv, mul_one] using h'

theorem splitSkewScalarGram_eq_chart_mul (H : Matrix I I A) :
    splitSkewScalarGram e H = splitChart e H * φ (Matrix.diagonal fun _ : I => J) := by
  change _ = φ (H.map e) * φ (Matrix.diagonal fun _ : I => J)
  rw [← map_mul]
  ext ⟨i, a⟩ ⟨j, b⟩
  rw [splitSkewScalarGram_apply, Matrix.compRingEquiv_apply, Matrix.comp_apply]
  rw [Matrix.mul_diagonal, Matrix.map_apply]

variable (τ : FirstKindInvolution R A)
  (hτ : ∀ a : A, e (τ a) * FirstKindInvolution.gramTwo R =
    FirstKindInvolution.gramTwo R * (e a)ᵀ)

include hτ in
theorem splitChart_adjoint_mul (P : Matrix I I A) :
    splitChart e (τ.matrix I P) * φ (Matrix.diagonal fun _ : I => J) =
      φ (Matrix.diagonal fun _ : I => J) * (splitChart e P)ᵀ := by
  let L := Matrix.diagonal fun _ : I => J
  change φ ((τ.matrix I P).map e) * φ L = φ L * (φ (P.map e))ᵀ
  have h : (φ (P.map e))ᵀ = φ ((P.map e)ᵀ.map (·ᵀ)) := rfl
  rw [h, ← map_mul, ← map_mul]
  apply congrArg φ
  ext i j : 1
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.map_apply, Matrix.map_apply,
    Matrix.transpose_apply, Matrix.map_apply, FirstKindInvolution.matrix_apply]
  exact hτ (P j i)

include hτ in
/-- Congruence of antihermitian Gram matrices becomes congruence of scalar Gram matrices. -/
theorem splitSkewScalarGram_congruence' (H P : Matrix I I A) :
    splitSkewScalarGram e (P * H * τ.matrix I P) =
      splitChart e P * splitSkewScalarGram e H * (splitChart e P)ᵀ := by
  rw [splitSkewScalarGram_eq_chart_mul, splitSkewScalarGram_eq_chart_mul, map_mul, map_mul,
    mul_assoc (splitChart e P * splitChart e H), splitChart_adjoint_mul e τ hτ]
  simp only [mul_assoc]

end SplitChart

section ActualChart

open FiniteAlgebraUnits.MatrixPoints

variable {F D R : Type u} [Field F] [DivisionRing D] [Algebra F D]
  [FiniteDimensional F D] [Algebra.IsCentral F D] [Field R] [Algebra F R]
  {I : Type} [Fintype I] [DecidableEq I] [Nonempty I]

omit [FiniteDimensional F D] [Algebra.IsCentral F D] in
theorem chartR_eq_self (e : R ⊗[F] D ≃ₐ[R] Matrix (Fin 2) (Fin 2) R) (a : R ⊗[F] D) :
    DegreeSplitting.chartR e R a = e a := by
  refine TensorProduct.inductionOn
    (motive := fun t : R ⊗[F] D => DegreeSplitting.chartR e R t = e t) a ?_ ?_
  · intro r d
    rw [DegreeSplitting.chartR_tmul, Algebra.algebraMap_self]
    change r • e ((1 : R) ⊗ₜ[F] d) = e (r ⊗ₜ[F] d)
    rw [← map_smul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  · intro a b ha hb
    rw [map_add, map_add, ha, hb]

/-- In a splitting chart the reduced norm is the determinant of the scalar matrix. -/
theorem matrixReducedNorm_eq_det_splitChart
    (e : R ⊗[F] D ≃ₐ[R] Matrix (Fin 2) (Fin 2) R) (P : Matrix I I (R ⊗[F] D)) :
    matrixReducedNorm R P = (splitChart e P).det := by
  change Langlands.CentralSimple.reducedNorm F (Matrix I I D) R
    ((coefficientEquiv F D R).symm P) = _
  rw [DegreeSplitting.reducedNorm_eq_det_matrixChartR e]
  congr 1
  ext ⟨i, a⟩ ⟨j, b⟩
  rw [DegreeSplitting.matrixChartR_apply, AlgEquiv.apply_symm_apply,
    splitChart_apply, chartR_eq_self e]

end ActualChart

/-! ### Matrices of isometries of a symmetric Gram matrix -/

section GramIsometry

variable {K : Type u} [Field K] {ι : Type} [Fintype ι] [DecidableEq ι] {C : Matrix ι ι K}

/-- The matrix acting on rows by `v ↦ v ᵥ* isoMatrix g = g v`. -/
def isoMatrix (g : C.toQuadraticForm'.IsometryEquiv C.toQuadraticForm') : Matrix ι ι K :=
  (LinearMap.toMatrix' g.toLinearEquiv.toLinearMap)ᵀ

theorem isoMatrix_trans (g h : C.toQuadraticForm'.IsometryEquiv C.toQuadraticForm') :
    isoMatrix (g.trans h) = isoMatrix g * isoMatrix h := by
  rw [isoMatrix, isoMatrix, isoMatrix, ← Matrix.transpose_mul, ← LinearMap.toMatrix'_comp]
  rfl

theorem isoMatrix_refl : isoMatrix (QuadraticMap.IsometryEquiv.refl C.toQuadraticForm') = 1 := by
  rw [isoMatrix]
  change (LinearMap.toMatrix' LinearMap.id)ᵀ = 1
  rw [LinearMap.toMatrix'_id, Matrix.transpose_one]

theorem det_isoMatrix (g : C.toQuadraticForm'.IsometryEquiv C.toQuadraticForm') :
    (isoMatrix g).det = g.toLinearEquiv.toLinearMap.det := by
  rw [isoMatrix, Matrix.det_transpose, LinearMap.det_toMatrix']

variable [Invertible (2 : K)] (hC : Cᵀ = C)

include hC in
theorem isoMatrix_gram (g : C.toQuadraticForm'.IsometryEquiv C.toQuadraticForm') :
    isoMatrix g * C * (isoMatrix g)ᵀ = C := by
  have hcomp : C.toQuadraticForm'.comp g.toLinearEquiv.toLinearMap = C.toQuadraticForm' :=
    QuadraticMap.ext g.map_app
  have hm := congrArg QuadraticForm.toMatrix' hcomp
  rw [QuadraticForm.toMatrix'_comp, toMatrix_toQuadraticForm_of_symm hC] at hm
  rw [isoMatrix, Matrix.transpose_transpose]
  exact hm

include hC in
/-- A congruence `Y C Yᵀ = C` by an invertible matrix is the matrix of an isometry. -/
theorem exists_isoMatrix_eq (Y : Matrix ι ι K) (hYu : IsUnit Y) (hY : Y * C * Yᵀ = C) :
    ∃ g : C.toQuadraticForm'.IsometryEquiv C.toQuadraticForm', isoMatrix g = Y := by
  let P : GL ι K := ((Matrix.isUnit_transpose _).mpr hYu).unit
  have hP : (P : Matrix ι ι K) = Yᵀ := ((Matrix.isUnit_transpose _).mpr hYu).unit_spec
  let f : (ι → K) ≃ₗ[K] (ι → K) := (Matrix.GeneralLinearGroup.toLin P).toLinearEquiv
  have hf : LinearMap.toMatrix' f.toLinearMap = Yᵀ := by
    change LinearMap.toMatrix' (Matrix.toLin' (P : Matrix ι ι K)) = _
    rw [LinearMap.toMatrix'_toLin', hP]
  have hcomp : C.toQuadraticForm'.comp f.toLinearMap = C.toQuadraticForm' := by
    apply quadratic_toMatrix_injective
    rw [QuadraticForm.toMatrix'_comp, hf, toMatrix_toQuadraticForm_of_symm hC,
      Matrix.transpose_transpose]
    exact hY
  refine ⟨⟨f, fun x => DFunLike.congr_fun hcomp x⟩, ?_⟩
  change (LinearMap.toMatrix' f.toLinearMap)ᵀ = Y
  rw [hf, Matrix.transpose_transpose]

end GramIsometry

/-! ### The split anisotropic case -/

section Split

variable {F D : Type u} [Field F] [CharZero F] [DivisionRing D] [Algebra F D]
  [FiniteDimensional F D] [Algebra.IsCentral F D]
  (σ : FirstKindInvolution F D) (hdim : Module.finrank F D = 4)
  (hsym : Module.finrank F σ.symmetricSubspace = 3)
  {n : ℕ} [NeZero n] (Hs : Matrix (Fin n) (Fin n) D)

local notation "τ" => σ.quaternionConjugation hdim hsym

set_option maxHeartbeats 1000000 in
/-- Let `K` split `D` and satisfy the field hypotheses of `isSquare_div`. For an invertible
antihermitian Gram matrix for quaternion conjugation whose form over `K ⊗ D` is anisotropic,
the special unitary group over `K` is generated by squares. -/
theorem mem_closure_squares_of_split (K : Type u) [Field K] [Algebra F K]
    (hK1 : ∀ t : K, IsSquare t ∨ IsSquare (-t)) (hK2 : ∀ s t : K, IsSquare (s * s + t * t))
    (hK3 : ¬ IsSquare (-1 : K)) (e : K ⊗[F] D ≃ₐ[K] Matrix (Fin 2) (Fin 2) K)
    (hHs : (τ).matrix (Fin n) Hs = -Hs) (hu : IsUnit Hs)
    (hanis : ∀ y : Fin n → K ⊗[F] D,
      ((τ).baseChange K).matrixSesqBilin (gramOver n Hs K) y y = 0 → y = 0)
    (M : suGroup (τ) Hs K) :
    M ∈ Subgroup.closure {x : suGroup (τ) Hs K | ∃ y, y * y = x} := by
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap F K).injective
  let : Invertible (2 : K) := invertibleOfNonzero two_ne_zero
  let τA := (τ).baseChange K
  let H := gramOver (F := F) n Hs K
  let ψ := splitChart e (I := Fin n)
  let C := splitSkewScalarGram e H
  let S := Subgroup.closure {x : suGroup (τ) Hs K | ∃ y, y * y = x}
  have hτ : ∀ z, e (τA z) * FirstKindInvolution.gramTwo K =
      FirstKindInvolution.gramTwo K * (e z)ᵀ := σ.splitQuaternionConjugation_mul_gramTwo hdim hsym e
  have hH : τA.matrix (Fin n) H = -H := by
    ext i j
    have h := congrArg (fun X => X i j) hHs
    simp only [FirstKindInvolution.matrix_apply, Matrix.neg_apply] at h
    simp only [H, τA, gramOver, FirstKindInvolution.matrix_apply, Matrix.map_apply,
      Matrix.neg_apply, Algebra.TensorProduct.includeRight_apply,
      FirstKindInvolution.baseChange_tmul, h, TensorProduct.tmul_neg]
  have hHu : IsUnit H :=
    hu.map (Algebra.TensorProduct.includeRight : D →ₐ[F] K ⊗[F] D).toRingHom.mapMatrix
  have hC : Cᵀ = C := splitSkewScalarGram_isSymm e τA hτ hH
  have hCu : IsUnit C := splitSkewScalarGram_isUnit e hHu
  -- special unitary matrices are proper isometries of `C`
  have hsu (X : Matrix (Fin n) (Fin n) (K ⊗[F] D)) :
      IsSU (τ) Hs X ↔ ψ X * C * (ψ X)ᵀ = C ∧ (ψ X).det = 1 := by
    have hcong := splitSkewScalarGram_congruence' e τA hτ H X
    rw [IsSU, ← matrixReducedNorm_eq_det_splitChart e]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨?_, h2⟩
      rw [← hcong]
      exact congrArg (splitSkewScalarGram e) h1
    · rintro ⟨h1, h2⟩
      refine ⟨splitSkewScalarGram_injective' e (hcong.trans h1), h2⟩
  -- the scalar form is anisotropic
  let Q := C.toQuadraticForm'
  have hQ : ∀ v, Q v = 0 → v = 0 := by
    intro v hv
    have hv' : v ⬝ᵥ (C *ᵥ v) = 0 := by
      rw [← hv]
      change v ⬝ᵥ (C *ᵥ v) = Matrix.toLinearMap₂' K C v v
      rw [Matrix.toLinearMap₂'_apply']
    let X : Matrix (Fin 2) (Fin n × Fin 2) K := Matrix.of ![v, 0]
    let x := fromSplitSkewRows e X
    have hx : splitSkewRows e x = X := splitSkewRows_fromSplitSkewRows e X
    have hv'' : (v ᵥ* C) ⬝ᵥ v = 0 := by rw [← Matrix.dotProduct_mulVec]; exact hv'
    have hXC : X * C * Xᵀ = 0 := by
      ext a b
      fin_cases a <;> fin_cases b <;> simp [X, Matrix.mul_apply, Matrix.transpose_apply]
      simpa [dotProduct] using hv''
    have hb := matrixSesqBilin_splitSkewScalarGram e τA hτ H x x
    rw [hx, hXC] at hb
    have hb0 : τA.matrixSesqBilin H x x = 0 := by
      have hJ : IsUnit (FirstKindInvolution.gramTwo K : Matrix (Fin 2) (Fin 2) K) :=
        FirstKindInvolution.isUnit_gramTwo
      have h1 : e (τA.matrixSesqBilin H x x) = 0 := by
        have h2 := congrArg (· * (↑hJ.unit⁻¹ : Matrix (Fin 2) (Fin 2) K)) hb
        simpa only [mul_assoc, hJ.mul_val_inv, mul_one, zero_mul] using h2
      exact (map_eq_zero_iff e e.injective).mp h1
    have hx0 := hanis x hb0
    have hX0 : X = 0 := by
      rw [← hx, hx0]
      ext a ⟨i, b⟩
      simp [splitSkewRows]
    calc v = X 0 := rfl
      _ = 0 := by rw [hX0]; rfl
  have hQnd : Q.polarBilin.Nondegenerate := polar_nondegenerate_of_symmetric_unit hC hCu
  -- proper isometries give special unitary matrices
  have hlift (g : Q.IsometryEquiv Q) (hg : g.toLinearEquiv.toLinearMap.det = 1) :
      ∃ P : suGroup (τ) Hs K, ψ ((P : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D)) = isoMatrix g := by
    have hY := isoMatrix_gram hC g
    have hdet : (isoMatrix g).det = 1 := by rw [det_isoMatrix, hg]
    have hYu : IsUnit (isoMatrix g) := by
      rw [Matrix.isUnit_iff_isUnit_det, hdet]
      exact isUnit_one
    have hXu : IsUnit (ψ.symm (isoMatrix g)) := hYu.map ψ.symm
    refine ⟨⟨hXu.unit, (hsu _).mpr ?_⟩, ?_⟩
    · change ψ (ψ.symm (isoMatrix g)) * C * (ψ (ψ.symm (isoMatrix g)))ᵀ = C ∧
        (ψ (ψ.symm (isoMatrix g))).det = 1
      rw [RingEquiv.apply_symm_apply]
      exact ⟨hY, hdet⟩
    · change ψ (ψ.symm (isoMatrix g)) = _
      rw [RingEquiv.apply_symm_apply]
  have hψmul (P P' : suGroup (τ) Hs K) :
      ψ (((P * P' : suGroup (τ) Hs K) : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D)) =
        ψ ((P : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D)) * ψ ((P' : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D)) := by
    rw [Subgroup.coe_mul, Units.val_mul, map_mul]
  have hdet_r (z : Fin n × Fin 2 → K) (hz : Q z ≠ 0) :
      (reflection Q z hz).toLinearEquiv.toLinearMap.det = -1 := det_reflection Q z hz
  -- even reflection words are products of squares
  have hword : ∀ k : ℕ, ∀ l : List {z : Fin n × Fin 2 → K // Q z ≠ 0}, l.length = 2 * k →
      ∃ P ∈ S, ψ ((P : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D)) = isoMatrix (reflectionWord Q l) := by
    intro k
    induction k with
    | zero =>
      intro l hl
      rw [mul_zero, List.length_eq_zero_iff] at hl
      subst hl
      refine ⟨1, one_mem S, ?_⟩
      rw [reflectionWord_nil, isoMatrix_refl]
      change ψ 1 = 1
      exact map_one ψ
    | succ k ih =>
      intro l hl
      match l, hl with
      | a :: b :: rest, hl =>
        have hrest : rest.length = 2 * k := by
          simp only [List.length_cons] at hl
          omega
        obtain ⟨P₀, hP₀S, hP₀⟩ := ih rest hrest
        have hab : isoMatrix (reflectionWord Q (a :: b :: rest)) =
            isoMatrix ((reflection Q a a.2).trans (reflection Q b b.2)) *
              isoMatrix (reflectionWord Q rest) := by
          rw [reflectionWord_cons, reflectionWord_cons, isoMatrix_trans, isoMatrix_trans,
            isoMatrix_trans, mul_assoc]
        rcases trans_reflection_eq_or Q hK1 hK2 hK3 hQ a.2 b.2 with h | ⟨m, hm, h⟩
        · refine ⟨P₀, hP₀S, ?_⟩
          rw [hab, h, isoMatrix_refl, one_mul, hP₀]
        · let ρ := (reflection Q (a : Fin n × Fin 2 → K) a.2).trans (reflection Q m hm)
          have hρ : ρ.toLinearEquiv.toLinearMap.det = 1 := by
            change ((reflection Q m hm).toLinearEquiv.toLinearMap.comp
              (reflection Q (a : Fin n × Fin 2 → K) a.2).toLinearEquiv.toLinearMap).det = 1
            rw [LinearMap.det_comp, hdet_r, hdet_r]
            norm_num
          obtain ⟨Pρ, hPρ⟩ := hlift ρ hρ
          refine ⟨Pρ * Pρ * P₀, mul_mem (Subgroup.subset_closure ⟨Pρ, rfl⟩) hP₀S, ?_⟩
          rw [hψmul, hψmul, hab, h, isoMatrix_trans, hPρ, hP₀]
  -- conclusion
  have hM := (hsu ((M : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D))).mp M.2
  have hYu : IsUnit (ψ ((M : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D))) := by
    rw [Matrix.isUnit_iff_isUnit_det, hM.2]
    exact isUnit_one
  obtain ⟨g, hg⟩ := exists_isoMatrix_eq hC _ hYu hM.1
  have hgdet : g.toLinearEquiv.toLinearMap.det = 1 := by rw [← det_isoMatrix, hg, hM.2]
  obtain ⟨l, hl, hlg⟩ := exists_even_reflectionWord Q hQnd g hgdet
  obtain ⟨k, hk⟩ := hl
  obtain ⟨P, hPS, hP⟩ := hword k l (by rw [hk]; ring)
  have hPM : P = M := by
    apply Subtype.ext
    apply Units.ext
    apply ψ.injective
    rw [hP, hlg, hg]
  rw [← hPM]
  exact hPS

end Split

end Langlands.GroupScheme.Quaternionic.SkewUnitary
