import Langlands.GroupScheme.Quaternionic.Forms
import Langlands.Algebra.CentralSimpleReducedTrace
import Mathlib.LinearAlgebra.TensorAlgebra.Basic
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Central.Matrix
import Mathlib.RingTheory.SimpleRing.Matrix

/-!
# Tits's Clifford algebra of a quaternionic quadratic form

Let `D` be a finite-dimensional central division algebra over a field `K` with an
involution of the first kind `σ`, let `E = M_m(D)`, `T = {x - ᵗx^σ}` and let
`q ∈ E ⧸ T` be a `σ`-quadratic form in the sense of Tits. Following Tits (1968, §4.1),
the Clifford algebra of `q` is the quotient of the tensor algebra `T(E)` by the two-sided
ideal generated by

* `ι b - Trd (b * Q)` for every `b ∈ E` with `Trd (b * a) = 0` for all `a ∈ T`, and
* `ι₂ c - ι (Sand c Q)` for every `c ∈ E ⊗[K] E` with `Sand c a = 0` for all `a ∈ T`,

where `Q` is any representative of `q`, `Trd` is the reduced trace of `E`,
`Sand (b ⊗ b₁) a = b * a * b₁` and `ι₂ (b ⊗ b₁) = ι b * ι b₁`. The relations do not
depend on the representative `Q`.
-/

noncomputable section

universe u v w

open scoped TensorProduct

namespace Langlands.GroupScheme.Quaternionic

/-! ### The sandwich map and the degree-two map of a tensor algebra -/

section Sandwich

variable (K : Type v) [CommRing K]

/-- The sandwich map `Sand : A ⊗[K] A →ₗ[K] A →ₗ[K] A`, `Sand (b ⊗ b₁) a = b * a * b₁`. -/
def sandwich (A : Type w) [Ring A] [Algebra K A] : A ⊗[K] A →ₗ[K] A →ₗ[K] A :=
  TensorProduct.lift
    ((LinearMap.mul K (Module.End K A)).compl₁₂ (LinearMap.mul K A) (LinearMap.mul K A).flip)

@[simp] theorem sandwich_tmul {A : Type w} [Ring A] [Algebra K A] (b b₁ a : A) :
    sandwich K A (b ⊗ₜ[K] b₁) a = b * a * b₁ := by
  simp [sandwich, mul_assoc]

/-- The degree-two map `ι₂ : M ⊗[K] M →ₗ[K] T(M)`, `ι₂ (x ⊗ y) = ι x * ι y`. -/
def tensorι₂ (M : Type w) [AddCommGroup M] [Module K M] : M ⊗[K] M →ₗ[K] TensorAlgebra K M :=
  TensorProduct.lift
    ((LinearMap.mul K (TensorAlgebra K M)).compl₁₂ (TensorAlgebra.ι K) (TensorAlgebra.ι K))

@[simp] theorem tensorι₂_tmul {M : Type w} [AddCommGroup M] [Module K M] (x y : M) :
    tensorι₂ K M (x ⊗ₜ[K] y) = TensorAlgebra.ι K x * TensorAlgebra.ι K y := by
  simp [tensorι₂]

end Sandwich

namespace FirstKindInvolution

section Annihilators

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D]
  (σ : FirstKindInvolution K D) (m : ℕ)

/-! ### The two annihilators -/

/-- The sandwich-annihilator of `T = {x - ᵗx^σ}` in `E ⊗[K] E`, where `E = M_m(D)`: the
tensors `c` with `Sand c a = 0` for every `a ∈ T`. -/
def sandwichAnnihilator : Submodule K (Matrix (Fin m) (Fin m) D ⊗[K] Matrix (Fin m) (Fin m) D)
    where
  carrier := {c | ∀ a ∈ σ.quadraticKernel (Fin m), sandwich K _ c a = 0}
  add_mem' {c c'} hc hc' a ha := by
    rw [Set.mem_ofPred_eq] at hc hc'
    rw [_root_.map_add, LinearMap.add_apply, hc a ha, hc' a ha, add_zero]
  zero_mem' a _ := by rw [_root_.map_zero, LinearMap.zero_apply]
  smul_mem' t c hc a ha := by
    rw [Set.mem_ofPred_eq] at hc
    rw [_root_.map_smul, LinearMap.smul_apply, hc a ha, smul_zero]

theorem mem_sandwichAnnihilator {c : Matrix (Fin m) (Fin m) D ⊗[K] Matrix (Fin m) (Fin m) D} :
    c ∈ σ.sandwichAnnihilator m ↔ ∀ a ∈ σ.quadraticKernel (Fin m), sandwich K _ c a = 0 :=
  Iff.rfl

variable [FiniteDimensional K D] [Algebra.IsCentral K D] [NeZero m]

/-- The trace-annihilator of `T` in `E = M_m(D)`: the matrices `b` with `Trd (b * a) = 0`
for every `a ∈ T`, where `Trd` is the reduced trace of the central simple algebra `E`. -/
def traceAnnihilator : Submodule K (Matrix (Fin m) (Fin m) D) where
  carrier := {b | ∀ a ∈ σ.quadraticKernel (Fin m),
    CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * a) = 0}
  add_mem' {b b'} hb hb' a ha := by
    rw [Set.mem_ofPred_eq] at hb hb'
    rw [add_mul, _root_.map_add, hb a ha, hb' a ha, add_zero]
  zero_mem' a _ := by rw [zero_mul, _root_.map_zero]
  smul_mem' t b hb a ha := by
    rw [Set.mem_ofPred_eq] at hb
    rw [smul_mul_assoc, _root_.map_smul, hb a ha, smul_zero]

theorem mem_traceAnnihilator {b : Matrix (Fin m) (Fin m) D} :
    b ∈ σ.traceAnnihilator m ↔ ∀ a ∈ σ.quadraticKernel (Fin m),
      CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * a) = 0 :=
  Iff.rfl

end Annihilators

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D] [FiniteDimensional K D]
  [Algebra.IsCentral K D] (σ : FirstKindInvolution K D) (m : ℕ) [NeZero m]

/-! ### The defining relations -/

/-- The defining relations of Tits's Clifford algebra for a representative `Q : E`:
`ι b - Trd (b * Q)` for `b` in the trace-annihilator of `T`, and `ι₂ c - ι (Sand c Q)` for
`c` in the sandwich-annihilator of `T`. -/
def relationsOf (Q : Matrix (Fin m) (Fin m) D) :
    Set (TensorAlgebra K (Matrix (Fin m) (Fin m) D)) :=
  {x | ∃ b ∈ σ.traceAnnihilator m, x = TensorAlgebra.ι K b -
      algebraMap K _ (CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * Q))} ∪
    {x | ∃ c ∈ σ.sandwichAnnihilator m,
      x = tensorι₂ K _ c - TensorAlgebra.ι K (sandwich K _ c Q)}

/-- **Representative independence.** Changing the representative `Q` by an element of `T`
does not change the defining relations. -/
theorem relationsOf_eq_of_sub_mem {Q Q' : Matrix (Fin m) (Fin m) D}
    (h : Q - Q' ∈ σ.quadraticKernel (Fin m)) : σ.relationsOf m Q = σ.relationsOf m Q' := by
  have htr : ∀ b ∈ σ.traceAnnihilator m,
      CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * Q) =
        CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * Q') := by
    intro b hb
    rw [← sub_eq_zero, ← _root_.map_sub, ← mul_sub]
    exact hb _ h
  have hsand : ∀ c ∈ σ.sandwichAnnihilator m, sandwich K _ c Q = sandwich K _ c Q' := by
    intro c hc
    rw [← sub_eq_zero, ← LinearMap.map_sub]
    exact hc _ h
  ext x
  simp only [relationsOf, Set.mem_union, Set.mem_ofPred_eq]
  constructor
  · rintro (⟨b, hb, rfl⟩ | ⟨c, hc, rfl⟩)
    · exact Or.inl ⟨b, hb, by rw [htr b hb]⟩
    · exact Or.inr ⟨c, hc, by rw [hsand c hc]⟩
  · rintro (⟨b, hb, rfl⟩ | ⟨c, hc, rfl⟩)
    · exact Or.inl ⟨b, hb, by rw [htr b hb]⟩
    · exact Or.inr ⟨c, hc, by rw [hsand c hc]⟩

/-- The defining relations of Tits's Clifford algebra of a quadratic form `q`, computed from
any representative of `q`. -/
def relations (q : σ.QuadraticForms (Fin m)) :
    Set (TensorAlgebra K (Matrix (Fin m) (Fin m) D)) :=
  Quotient.liftOn' q (σ.relationsOf m) fun _ _ h =>
    σ.relationsOf_eq_of_sub_mem m ((Submodule.quotientRel_def _).1 h)

@[simp] theorem relations_mk (Q : Matrix (Fin m) (Fin m) D) :
    σ.relations m (Submodule.Quotient.mk Q) = σ.relationsOf m Q :=
  rfl

/-- The two-sided ideal of `T(E)` generated by the defining relations of `q`. -/
def cliffordIdeal (q : σ.QuadraticForms (Fin m)) :
    TwoSidedIdeal (TensorAlgebra K (Matrix (Fin m) (Fin m) D)) :=
  TwoSidedIdeal.span (σ.relations m q)

theorem cliffordIdeal_mk (Q : Matrix (Fin m) (Fin m) D) :
    σ.cliffordIdeal m (Submodule.Quotient.mk Q) = TwoSidedIdeal.span (σ.relationsOf m Q) :=
  rfl

theorem relations_subset_cliffordIdeal (q : σ.QuadraticForms (Fin m)) :
    σ.relations m q ⊆ (σ.cliffordIdeal m q : Set (TensorAlgebra K (Matrix (Fin m) (Fin m) D))) :=
  TwoSidedIdeal.subset_span

/-! ### The Clifford algebra -/

/-- **Tits's Clifford algebra** `C(q) = T(E) ⧸ I(q)` of a `σ`-quadratic form `q` on `D^m`,
the quotient of the tensor algebra of `E = M_m(D)` by the two-sided ideal generated by the
defining relations. -/
def TitsCliffordAlgebra (q : σ.QuadraticForms (Fin m)) : Type u :=
  TensorAlgebra K (Matrix (Fin m) (Fin m) D) ⧸ (σ.cliffordIdeal m q).asIdeal

variable (q : σ.QuadraticForms (Fin m))

instance : Ring (σ.TitsCliffordAlgebra m q) :=
  Ideal.Quotient.ring (σ.cliffordIdeal m q).asIdeal

instance : Algebra K (σ.TitsCliffordAlgebra m q) :=
  Ideal.Quotient.algebra K

instance : Inhabited (σ.TitsCliffordAlgebra m q) := ⟨0⟩

/-- The quotient map `T(E) →ₐ[K] C(q)`. -/
def cliffordMk : TensorAlgebra K (Matrix (Fin m) (Fin m) D) →ₐ[K] σ.TitsCliffordAlgebra m q :=
  Ideal.Quotient.mkₐ K (σ.cliffordIdeal m q).asIdeal

theorem cliffordMk_surjective : Function.Surjective (σ.cliffordMk m q) :=
  Ideal.Quotient.mkₐ_surjective K _

theorem cliffordMk_eq_zero_iff (x : TensorAlgebra K (Matrix (Fin m) (Fin m) D)) :
    σ.cliffordMk m q x = 0 ↔ x ∈ σ.cliffordIdeal m q := by
  exact Ideal.Quotient.eq_zero_iff_mem.trans TwoSidedIdeal.mem_asIdeal

theorem cliffordMk_eq_zero_of_mem_relations {x : TensorAlgebra K (Matrix (Fin m) (Fin m) D)}
    (hx : x ∈ σ.relations m q) : σ.cliffordMk m q x = 0 :=
  (σ.cliffordMk_eq_zero_iff m q x).2 (σ.relations_subset_cliffordIdeal m q hx)

/-- The degree-one generator map `ι : E →ₗ[K] C(q)`. -/
def cliffordι : Matrix (Fin m) (Fin m) D →ₗ[K] σ.TitsCliffordAlgebra m q :=
  (σ.cliffordMk m q).toLinearMap ∘ₗ TensorAlgebra.ι K

@[simp] theorem cliffordMk_ι (b : Matrix (Fin m) (Fin m) D) :
    σ.cliffordMk m q (TensorAlgebra.ι K b) = σ.cliffordι m q b :=
  rfl

/-- The degree-two map `ι₂ : E ⊗[K] E →ₗ[K] C(q)`, `ι₂ (b ⊗ b₁) = ι b * ι b₁`. -/
def cliffordι₂ :
    Matrix (Fin m) (Fin m) D ⊗[K] Matrix (Fin m) (Fin m) D →ₗ[K] σ.TitsCliffordAlgebra m q :=
  (σ.cliffordMk m q).toLinearMap ∘ₗ tensorι₂ K _

@[simp] theorem cliffordMk_tensorι₂
    (c : Matrix (Fin m) (Fin m) D ⊗[K] Matrix (Fin m) (Fin m) D) :
    σ.cliffordMk m q (tensorι₂ K _ c) = σ.cliffordι₂ m q c :=
  rfl

@[simp] theorem cliffordι₂_tmul (b b₁ : Matrix (Fin m) (Fin m) D) :
    σ.cliffordι₂ m q (b ⊗ₜ[K] b₁) = σ.cliffordι m q b * σ.cliffordι m q b₁ := by
  rw [cliffordι₂, LinearMap.comp_apply, tensorι₂_tmul, AlgHom.toLinearMap_apply, _root_.map_mul]
  rfl

/-- **First relation family.** If `Q` represents `q` and `Trd (b * a) = 0` for every
`a ∈ T`, then `ι b = Trd (b * Q)` in `C(q)`. -/
theorem cliffordι_eq_algebraMap {Q : Matrix (Fin m) (Fin m) D}
    (hQ : (Submodule.Quotient.mk Q : σ.QuadraticForms (Fin m)) = q)
    {b : Matrix (Fin m) (Fin m) D} (hb : b ∈ σ.traceAnnihilator m) :
    σ.cliffordι m q b = algebraMap K _
      (CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * Q)) := by
  subst hQ
  have h := σ.cliffordMk_eq_zero_of_mem_relations m (Submodule.Quotient.mk Q)
    (x := TensorAlgebra.ι K b -
      algebraMap K _ (CentralSimple.reducedTraceLinear K (Matrix (Fin m) (Fin m) D) (b * Q)))
    (show _ ∈ σ.relationsOf m Q from Or.inl ⟨b, hb, rfl⟩)
  rwa [_root_.map_sub, AlgHom.commutes, cliffordMk_ι, sub_eq_zero] at h

/-- **Second relation family.** If `Q` represents `q` and `Sand c a = 0` for every
`a ∈ T`, then `ι₂ c = ι (Sand c Q)` in `C(q)`. -/
theorem cliffordι₂_eq {Q : Matrix (Fin m) (Fin m) D}
    (hQ : (Submodule.Quotient.mk Q : σ.QuadraticForms (Fin m)) = q)
    {c : Matrix (Fin m) (Fin m) D ⊗[K] Matrix (Fin m) (Fin m) D}
    (hc : c ∈ σ.sandwichAnnihilator m) :
    σ.cliffordι₂ m q c = σ.cliffordι m q (sandwich K _ c Q) := by
  subst hQ
  have h := σ.cliffordMk_eq_zero_of_mem_relations m (Submodule.Quotient.mk Q)
    (x := tensorι₂ K _ c - TensorAlgebra.ι K (sandwich K _ c Q))
    (show _ ∈ σ.relationsOf m Q from Or.inr ⟨c, hc, rfl⟩)
  rwa [_root_.map_sub, cliffordMk_tensorι₂, cliffordMk_ι, sub_eq_zero] at h

/-- The degree-one generators generate `C(q)`: the subalgebra generated by the range of
`ι` is everything. -/
theorem adjoin_range_cliffordι :
    Algebra.adjoin K (Set.range (σ.cliffordι m q)) = ⊤ := by
  have h : Set.range (σ.cliffordι m q) =
      σ.cliffordMk m q '' Set.range (TensorAlgebra.ι K (M := Matrix (Fin m) (Fin m) D)) := by
    rw [← Set.range_comp]
    rfl
  rw [h, ← AlgHom.map_adjoin, TensorAlgebra.adjoin_range_ι, Algebra.map_top,
    AlgHom.range_eq_top]
  exact σ.cliffordMk_surjective m q

/-- **Universal property.** A `K`-algebra map from `T(E)` that kills the defining relations
of `q` factors through `C(q)`. -/
def cliffordLift {B : Type w} [Ring B] [Algebra K B]
    (f : TensorAlgebra K (Matrix (Fin m) (Fin m) D) →ₐ[K] B)
    (hf : ∀ x ∈ σ.relations m q, f x = 0) : σ.TitsCliffordAlgebra m q →ₐ[K] B :=
  Ideal.Quotient.liftₐ (σ.cliffordIdeal m q).asIdeal f fun x hx => by
    have hle : σ.cliffordIdeal m q ≤ TwoSidedIdeal.ker f :=
      TwoSidedIdeal.span_le.2 fun y hy => (TwoSidedIdeal.mem_ker f).2 (hf y hy)
    exact (TwoSidedIdeal.mem_ker f).1 (hle (TwoSidedIdeal.mem_asIdeal.1 hx))

@[simp] theorem cliffordLift_cliffordMk {B : Type w} [Ring B] [Algebra K B]
    (f : TensorAlgebra K (Matrix (Fin m) (Fin m) D) →ₐ[K] B)
    (hf : ∀ x ∈ σ.relations m q, f x = 0) (x : TensorAlgebra K (Matrix (Fin m) (Fin m) D)) :
    σ.cliffordLift m q f hf (σ.cliffordMk m q x) = f x :=
  rfl

end FirstKindInvolution

end Langlands.GroupScheme.Quaternionic
