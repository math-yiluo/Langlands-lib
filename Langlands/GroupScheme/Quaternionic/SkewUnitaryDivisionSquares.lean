import Langlands.GroupScheme.Quaternionic.SkewLineRotation
import Langlands.GroupScheme.Quaternionic.SkewUnitaryGalois
import Langlands.GroupScheme.Quaternionic.SkewHermitianOrthogonalBasis
import Langlands.GroupScheme.Quaternionic.IsometryWeights

/-! # Special unitary groups over a real quaternion division algebra are generated by squares

Let `τ` be an involution of the first kind of a finite-dimensional central division algebra
`D` over `F`, and `Hs` an invertible antihermitian Gram matrix of positive size. Let `K ⊇ F`
have characteristic zero and suppose `K ⊗ D` is a division algebra. The extended involution
is nonidentity and has a scalar norm `x τ_K(x) = N(x)`. Assume every element of `K` or its
negative is a square, sums of two squares are squares and `-1` is nonsquare, as for `K ≅ ℝ`.

Then the group `suGroup τ Hs K` of special unitary matrices is generated by squares. Choose an
orthogonal basis `x₁, …, xₙ` of the form over `K ⊗ D`. A special unitary matrix fixing the `xᵢ`
for `i ∈ S` and moving `xⱼ` to `y` is corrected by a reflection along `xⱼ - y` or by a
reflection along `xⱼ + y` followed by negation on the line of `y`. The line matrices fix
the `xᵢ` with `i ∈ S`. On a line with nonzero value, every isometric parameter `e` has
isometric square roots `f` of `e` and `g` of `f`. The matrix with parameter `f` is the
square of the isometry with parameter `g`, so it has reduced norm one. Squaring the
matrix with parameter `f` gives the one with parameter `e`.
-/

noncomputable section

universe u

open Matrix
open scoped TensorProduct

namespace Langlands.GroupScheme.Quaternionic.SkewUnitary

open FirstKindInvolution FirstKindInvolution.LineRotation

variable {F D : Type u} [Field F] [DivisionRing D] [Algebra F D]
  [Algebra.IsCentral F D] [FiniteDimensional F D] (τ : FirstKindInvolution F D)
  {n : ℕ} [NeZero n] (Hs : Matrix (Fin n) (Fin n) D)

omit [Algebra.IsCentral F D] [FiniteDimensional F D] [NeZero n] in
/-- The Gram matrix over `K ⊗ D` of an invertible Gram matrix over `D` is invertible. -/
theorem isUnit_gramOver {K : Type u} [Field K] [Algebra F K] (hu : IsUnit Hs) :
    IsUnit (gramOver (F := F) n Hs K) :=
  hu.map (Algebra.TensorProduct.includeRight : D →ₐ[F] K ⊗[F] D).toRingHom.mapMatrix

variable (K : Type u) [Field K] [Algebra F K] [CharZero K]

local notation "⌈" P "⌉" =>
  ((P : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ) : Matrix (Fin n) (Fin n) (K ⊗[F] D))

set_option maxHeartbeats 1000000 in
/-- Under the hypotheses of the module docstring, every special unitary matrix over `K ⊗ D` is a
product of squares of special unitary matrices. -/
theorem mem_closure_squares_of_division
    (hK1 : ∀ t : K, IsSquare t ∨ IsSquare (-t)) (hK2 : ∀ s t : K, IsSquare (s * s + t * t))
    (hK3 : ¬ IsSquare (-1 : K))
    (hdiv : ∀ y : K ⊗[F] D, y ≠ 0 → IsUnit y)
    (N : K ⊗[F] D → K) (hN : ∀ x, x * τ.baseChange K x = algebraMap K (K ⊗[F] D) (N x))
    (hτ : ∃ a : K ⊗[F] D, τ.baseChange K a ≠ a)
    (hHs : τ.IsAntihermitian Hs) (hu : IsUnit Hs) (M : suGroup τ Hs K) :
    M ∈ Subgroup.closure {x : suGroup τ Hs K | ∃ y, y * y = x} := by
  let : Nontrivial (K ⊗[F] D) := by
    obtain ⟨a, ha⟩ := hτ
    refine ⟨⟨a, τ.baseChange K a, ?_⟩⟩
    exact fun h => ha h.symm
  let : DivisionRing (K ⊗[F] D) := DivisionRing.ofIsUnitOrEqZero fun a =>
    (em (a = 0)).elim Or.inr fun h => Or.inl (hdiv a h)
  let τA := τ.baseChange K
  let G := gramOver (F := F) n Hs K
  let C := Subgroup.closure {x : suGroup τ Hs K | ∃ y, y * y = x}
  have hG : τA.IsAntihermitian G := by
    refine ⟨?_, fun i => ?_⟩
    · ext i j
      have h := congrArg (fun X => X i j) hHs.1
      simp only [FirstKindInvolution.matrix_apply, Matrix.neg_apply] at h
      simp only [G, τA, gramOver, FirstKindInvolution.matrix_apply, Matrix.map_apply,
        Matrix.neg_apply, Algebra.TensorProduct.includeRight_apply,
        FirstKindInvolution.baseChange_tmul, h, TensorProduct.tmul_neg]
    · obtain ⟨a, ha⟩ := (FirstKindInvolution.mem_alternatingSubspace τ).mp (hHs.2 i)
      refine (FirstKindInvolution.mem_alternatingSubspace τA).mpr ⟨(1 : K) ⊗ₜ[F] a, ?_⟩
      simp only [τA, G, gramOver, Matrix.map_apply, Algebra.TensorProduct.includeRight_apply,
        FirstKindInvolution.baseChange_tmul, ← ha, TensorProduct.tmul_sub]
  have hGu : IsUnit G := isUnit_gramOver Hs hu
  have hiso (P : suGroup τ Hs K) (v w : Fin n → K ⊗[F] D) :
      τA.sesqForm G (v ᵥ* ⌈P⌉)
        (w ᵥ* ⌈P⌉) = τA.sesqForm G v w := by
    rw [τA.sesqForm_vecMul]
    exact congrArg (fun X => τA.sesqForm X v w) P.2.1
  have hNG : matrixReducedNorm K G ≠ 0 := (hGu.map (matrixReducedNorm K)).ne_zero
  have hsq (P : Matrix (Fin n) (Fin n) (K ⊗[F] D)) (hP : P * G * τA.matrix (Fin n) P = G) :
      matrixReducedNorm K P ^ 2 = 1 := by
    have h := matrixReducedNorm_congruence K τ G P
    rw [hP] at h
    have h' : matrixReducedNorm K G * (matrixReducedNorm K P ^ 2 - 1) = 0 := by
      linear_combination -h
    rcases mul_eq_zero.mp h' with h'' | h''
    · exact absurd h'' hNG
    · linear_combination h''
  -- line matrices with isometric parameters are squares of special unitary matrices
  have hline (a : Fin n → K ⊗[F] D) (e : K ⊗[F] D) (hc : τA.sesqForm G a a ≠ 0)
      (he : e * τA.sesqForm G a a * τA e = τA.sesqForm G a a) :
      ∃ T : suGroup τ Hs K,
        ⌈T⌉ = lineMatrix τA G a e ∧ T ∈ C := by
    have hτc := map_sesqForm_self_eq_neg hG a
    obtain ⟨f, hf, hff⟩ := exists_sqrt_parameter τA N hN hK1 hK2 hK3 hc hτc he
    obtain ⟨g, hg, hgg⟩ := exists_sqrt_parameter τA N hN hK1 hK2 hK3 hc hτc hf
    have hne {t : K ⊗[F] D} (ht : t * τA.sesqForm G a a * τA t = τA.sesqForm G a a) : t ≠ 0 :=
      fun h0 => hc (by rw [← ht, h0, zero_mul, zero_mul])
    have hisoL {t : K ⊗[F] D} (ht : t * τA.sesqForm G a a * τA t = τA.sesqForm G a a) :
        lineMatrix τA G a t * G * τA.matrix (Fin n) (lineMatrix τA G a t) = G :=
      mul_mul_matrix_eq_of_sesqForm _ (sesqForm_vecMul_lineMatrix hG hc ht)
    have hLf : lineMatrix τA G a f = lineMatrix τA G a g * lineMatrix τA G a g := by
      rw [lineMatrix_mul τA G hc, hgg]
    have hNf : matrixReducedNorm K (lineMatrix τA G a f) = 1 := by
      rw [hLf, _root_.map_mul, ← pow_two, hsq _ (hisoL hg)]
    let U : (Matrix (Fin n) (Fin n) (K ⊗[F] D))ˣ :=
      ⟨lineMatrix τA G a f, lineMatrix τA G a f⁻¹, lineMatrix_mul_inv τA G hc (hne hf),
        lineMatrix_inv_mul τA G hc (hne hf)⟩
    let Tf : suGroup τ Hs K := ⟨U, ⟨hisoL hf, hNf⟩⟩
    refine ⟨Tf * Tf, ?_, Subgroup.subset_closure ⟨Tf, rfl⟩⟩
    change lineMatrix τA G a f * lineMatrix τA G a f = _
    rw [lineMatrix_mul τA G hc, hff]
  -- moving one row to another of the same value, fixing a set of orthogonal rows
  have hmove (x y : Fin n → K ⊗[F] D) (Z : Set (Fin n → K ⊗[F] D))
      (hxy : τA.sesqForm G x x = τA.sesqForm G y y) (hx0 : τA.sesqForm G x x ≠ 0)
      (hZ : ∀ z ∈ Z, τA.sesqForm G z x = 0 ∧ τA.sesqForm G z y = 0) :
      ∃ T : suGroup τ Hs K, T ∈ C ∧ x ᵥ* ⌈T⌉ = y ∧
        ∀ z ∈ Z, z ᵥ* ⌈T⌉ = z := by
    by_cases hs : τA (τA.sesqForm G x (x - y)) ≠ τA.sesqForm G x (x - y)
    · obtain ⟨hc, he, hxT⟩ := reflection_spec hG hxy hs
      obtain ⟨T, hT, hTC⟩ := hline (x - y) _ hc he
      refine ⟨T, hTC, by rw [hT]; exact hxT, fun z hz => ?_⟩
      rw [hT]
      apply vecMul_lineMatrix_of_orthogonal
      rw [Eichler.sesqForm_sub_right, (hZ z hz).1, (hZ z hz).2, sub_zero]
    · push Not at hs
      have hxy' : τA.sesqForm G x x = τA.sesqForm G (-y) (-y) := by
        rw [Eichler.sesqForm_neg_left, Eichler.sesqForm_neg_right, neg_neg, hxy]
      have hs' : τA (τA.sesqForm G x (x - -y)) ≠ τA.sesqForm G x (x - -y) := by
        intro h'
        apply hx0
        have e1 : τA.sesqForm G x (x - y) = τA.sesqForm G x x - τA.sesqForm G x y :=
          Eichler.sesqForm_sub_right _ _ _ _ _
        have e2 : τA.sesqForm G x (x - -y) = τA.sesqForm G x x + τA.sesqForm G x y := by
          rw [Eichler.sesqForm_sub_right, Eichler.sesqForm_neg_right, sub_neg_eq_add]
        have hb := map_sesqForm_self_eq_neg hG x
        rw [e1, FirstKindInvolution.map_sub, hb] at hs
        rw [e2, FirstKindInvolution.map_add, hb] at h'
        set b := τA.sesqForm G x x
        set t := τA.sesqForm G x y
        have h4 : (b + b) + (b + b) = 0 := by
          have h3 : -b - τA t + (-b + τA t) = b - t + (b + t) := by rw [hs, h']
          calc (b + b) + (b + b) = (b - t + (b + t)) - (-b - τA t + (-b + τA t)) := by abel
            _ = 0 := by rw [h3, sub_self]
        have h4' : (2 : K) • ((2 : K) • b) = 0 := by
          rw [two_smul K b, two_smul K (b + b)]
          exact h4
        rcases smul_eq_zero.mp h4' with h5 | h5
        · exact absurd h5 two_ne_zero
        · rcases smul_eq_zero.mp h5 with h6 | h6
          · exact absurd h6 two_ne_zero
          · exact h6
      obtain ⟨hc, he, hxT⟩ := reflection_spec hG hxy' hs'
      obtain ⟨T₁, hT₁, hT₁C⟩ := hline (x - -y) _ hc he
      have hcy : τA.sesqForm G y y ≠ 0 := hxy ▸ hx0
      have hem : (-1 : K ⊗[F] D) * τA.sesqForm G y y * τA (-1) = τA.sesqForm G y y := by
        rw [FirstKindInvolution.map_neg, FirstKindInvolution.map_one]
        noncomm_ring
      obtain ⟨T₂, hT₂, hT₂C⟩ := hline y (-1) hcy hem
      refine ⟨T₁ * T₂, mul_mem hT₁C hT₂C, ?_, ?_⟩
      · simp only [Subgroup.coe_mul, Units.val_mul]
        rw [← vecMul_vecMul, hT₁, hxT, hT₂, Matrix.neg_vecMul, vecMul_lineMatrix_self τA G hcy,
          neg_one_smul, neg_neg]
      · intro z hz
        simp only [Subgroup.coe_mul, Units.val_mul]
        rw [← vecMul_vecMul, hT₁, vecMul_lineMatrix_of_orthogonal, hT₂,
          vecMul_lineMatrix_of_orthogonal _ _ _ _ (hZ z hz).2]
        rw [Eichler.sesqForm_sub_right, Eichler.sesqForm_neg_right, (hZ z hz).1, (hZ z hz).2,
          neg_zero, sub_zero]
  -- an orthogonal basis
  obtain ⟨bas, hbo, hbd⟩ := AntihermitianForm.orthogonalBasis K (K ⊗[F] D) τA
    (Fin n → K ⊗[F] D) (AntihermitianForm.ofMatrix hG) hτ
    (AntihermitianForm.ofMatrix_separatingLeft hG hGu)
  have hbo' (i j) (hij : i ≠ j) : τA.sesqForm G (bas i) (bas j) = 0 := hbo i j hij
  have hbd' (i) : τA.sesqForm G (bas i) (bas i) ≠ 0 := hbd i
  have hinv (T : suGroup τ Hs K) {x y : Fin n → K ⊗[F] D}
      (h : x ᵥ* ⌈T⌉ = y) :
      y ᵥ* ⌈(T⁻¹ : suGroup τ Hs K)⌉ = x := by
    rw [← h, vecMul_vecMul, Subgroup.coe_inv, ← Units.val_mul, mul_inv_cancel, Units.val_one,
      vecMul_one]
  have hfix1 (P : suGroup τ Hs K)
      (hP : ∀ i, bas i ᵥ* ⌈P⌉ = bas i) : P = 1 := by
    let φ : (Fin n → K ⊗[F] D) →+ (Fin n → K ⊗[F] D) :=
      AddMonoidHom.mk' (fun v => v ᵥ* ⌈P⌉) fun v w => Matrix.add_vecMul _ v w
    have hall (v : Fin n → K ⊗[F] D) : v ᵥ* ⌈P⌉ = v := by
      have hv := bas.sum_repr v
      calc v ᵥ* ⌈P⌉ = φ (∑ i, bas.repr v i • bas i) := by rw [hv]; rfl
        _ = ∑ i, bas.repr v i • (bas i ᵥ* ⌈P⌉) := by
            rw [_root_.map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            change (bas.repr v i • bas i) ᵥ* ⌈P⌉ = _
            exact Matrix.smul_vecMul (bas.repr v i) (bas i) ⌈P⌉
        _ = v := by
            simp only [hP]
            exact hv
    apply Subtype.ext
    apply Units.ext
    rw [ext_iff_vecMul]
    intro v
    rw [hall v]
    simp

  have hmain : ∀ k : ℕ, ∀ (S : Finset (Fin (Module.finrank (K ⊗[F] D) (Fin n → K ⊗[F] D))))
      (P : suGroup τ Hs K), (Finset.univ \ S).card = k →
      (∀ i ∈ S, bas i ᵥ* ⌈P⌉ = bas i) → P ∈ C := by
    intro k
    induction k with
    | zero =>
      intro S P hk hP
      have hS : ∀ i, i ∈ S := by
        intro i
        by_contra hi
        have : i ∈ Finset.univ \ S := Finset.mem_sdiff.mpr ⟨Finset.mem_univ i, hi⟩
        rw [Finset.card_eq_zero.mp hk] at this
        exact Finset.notMem_empty i this
      rw [hfix1 P fun i => hP i (hS i)]
      exact one_mem C
    | succ k ih =>
      intro S P hk hP
      obtain ⟨j, hj⟩ : (Finset.univ \ S).Nonempty := Finset.card_pos.mp (by omega)
      have hjS : j ∉ S := (Finset.mem_sdiff.mp hj).2
      set y := bas j ᵥ* ⌈P⌉ with hy
      have hxy : τA.sesqForm G (bas j) (bas j) = τA.sesqForm G y y := (hiso P _ _).symm
      have hZ : ∀ z ∈ bas '' (S : Set _), τA.sesqForm G z (bas j) = 0 ∧
          τA.sesqForm G z y = 0 := by
        rintro z ⟨i, hi, rfl⟩
        have hij : i ≠ j := fun h => hjS (h ▸ hi)
        refine ⟨hbo' i j hij, ?_⟩
        rw [hy, ← hP i hi, hiso]
        exact hbo' i j hij
      obtain ⟨T, hTC, hxT, hzT⟩ := hmove (bas j) y _ hxy (hbd' j) hZ
      have hP' : ∀ i ∈ insert j S,
          bas i ᵥ* ⌈(P * T⁻¹ : suGroup τ Hs K)⌉ =
            bas i := by
        intro i hi
        simp only [Subgroup.coe_mul, Units.val_mul]
        rw [← vecMul_vecMul]
        rcases Finset.mem_insert.mp hi with rfl | hi
        · exact hinv T hxT
        · rw [hP i hi]
          exact hinv T (hzT _ ⟨i, hi, rfl⟩)
      have hcard : (Finset.univ \ insert j S).card = k := by
        rw [Finset.sdiff_insert, Finset.card_erase_of_mem hj, hk, Nat.add_sub_cancel]
      have h1 := ih (insert j S) (P * T⁻¹) hcard hP'
      have h2 : P = P * T⁻¹ * T := by group
      rw [h2]
      exact mul_mem h1 hTC
  exact hmain _ ∅ M rfl (by simp)

end Langlands.GroupScheme.Quaternionic.SkewUnitary
