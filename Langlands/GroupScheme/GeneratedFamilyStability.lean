import Langlands.GroupScheme.GeneratedFamily
import Langlands.GroupScheme.ImageEnvelopeStabilityProof
import Langlands.GroupScheme.Derived.CenterReduction

/-! # Stability and centralizers of subgroups generated by families -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.IsGeneratedByFamily

variable {k : Type u} [Field k]
    {G H : GroupScheme (Spec (CommRingCat.of k))}
    {I : Type v} {A : I → GroupScheme (Spec (CommRingCat.of k))}
    {a : ∀ j, A j ⟶ G} {i : H ⟶ G}
    (hi : IsGeneratedByFamily A a i)

include hi

/-- Each generating range lies in the generated range on every test. -/
theorem family_range_le (j : I) :
    SubgroupFunctor.range (a j) ≤ SubgroupFunctor.range i := by
  obtain ⟨f, hf⟩ := hi.2.1 j
  intro T x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  exact SubgroupFunctor.mem_range.mpr ⟨y ≫ f, by rw [Category.assoc, hf]⟩

/-- All-test containment in a represented closed competitor implies containment
of the generated family. -/
theorem range_le_of_family_range_le
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G)
    (hq : IsClosedSubgroup q)
    (hfamily : ∀ j, SubgroupFunctor.range (a j) ≤ SubgroupFunctor.range q) :
    SubgroupFunctor.range i ≤ SubgroupFunctor.range q := by
  apply hi.2.2 K q hq
  intro j
  exact (factorsThrough_iff_containsImage (a j).hom.hom q).mpr
    (fun T x => hfamily j T (SubgroupFunctor.mem_range.mpr ⟨x, rfl⟩))

/-- Minimality in arbitrary closed competitors preserves stability under every
affine group action over the field. -/
theorem isStable {S : GroupScheme (Spec (CommRingCat.of k))}
    (b : AutomorphicAction S G) (hS : IsAffineHom S.X.hom)
    (hfamily : ∀ j, b.IsStable (SubgroupFunctor.range (a j))) :
    b.IsStable (SubgroupFunctor.range i) := by
  obtain ⟨C, q, hq, hclosed⟩ := b.orbitCore_range_isClosedRepresentable hS i hi.1
  have hle : SubgroupFunctor.range i ≤ b.orbitCore (SubgroupFunctor.range i) := by
    rw [← hq.2]
    apply hi.range_le_of_family_range_le q hclosed
    intro j T x hx
    rw [hq.2]
    intro T' c s
    exact hi.family_range_le j T'
      (hfamily j T' s (c ≫ x) ((SubgroupFunctor.range (a j)).comp_mem c hx))
  intro T s x hx
  simpa only [Category.id_comp] using hle T hx T (𝟙 T) s

/-- Restrict an affine group action to the closed subgroup generated by
invariant family members. -/
def action {S : GroupScheme (Spec (CommRingCat.of k))}
    (b : AutomorphicAction S G) (hS : IsAffineHom S.X.hom)
    (hfamily : ∀ j, b.IsStable (SubgroupFunctor.range (a j))) :
    AutomorphicAction S H := by
  let : IsClosedImmersion i.hom.hom.left := hi.1
  exact b.onRepresentedSubgroup i ⟨Over.mono_of_mono_left _, rfl⟩
    (hi.isStable b hS hfamily)

/-- The generated subgroup inclusion intertwines the induced action with
the ambient action on every test scheme. -/
theorem action_act_comp {S : GroupScheme (Spec (CommRingCat.of k))}
    (b : AutomorphicAction S G) (hS : IsAffineHom S.X.hom)
    (hfamily : ∀ j, b.IsStable (SubgroupFunctor.range (a j)))
    {T : Over (Spec (CommRingCat.of k))} (s : T ⟶ S.X) (x : T ⟶ H.X) :
    (hi.action b hS hfamily).act s x ≫ i.hom.hom =
      b.act s (x ≫ i.hom.hom) :=
  b.onRepresentedSubgroup_act_comp i _ _ s x

/-- Centralizing every generator implies centralizing the generated subgroup;
the competing centralizer is allowed to be nonsmooth. -/
theorem range_le_centralizer [IsAffine G.X.left]
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G)
    (hq : IsClosedSubgroup q)
    (hfamily : ∀ j,
      SubgroupFunctor.range (a j) ≤ (SubgroupFunctor.range q).centralizer) :
    SubgroupFunctor.range i ≤ (SubgroupFunctor.range q).centralizer := by
  obtain ⟨C, c, hclosed, hc⟩ :=
    (hasClosedRepresentative_normalizer_centralizer_range q hq).2
  rw [← hc.2]
  exact hi.range_le_of_family_range_le c hclosed (fun j => by
    rw [hc.2]
    exact hfamily j)

end Langlands.GroupScheme.IsGeneratedByFamily
