import Langlands.GroupScheme.Rational.ParabolicStrictWeylDisplacement
import Langlands.GroupScheme.Rational.StandardLeviSplitContainment
import Langlands.Geometry.Building.RealTorusDuality

/-! # Uniqueness of full lifts annihilating the selected coroots -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj BigOperators

namespace Langlands.GroupScheme

open RealTorusSpace

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : T.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]

namespace RelativeRootReflectionData

variable (D : RelativeRootReflectionData i)

/-- The subgroup of the actual relative Weyl group generated by the supplied
reflection representatives of the selected actual roots. -/
def selectedWeylGroup (J : Set (characterLattice T)) : Subgroup (relativeWeylGroup i) :=
  Subgroup.closure {w | ∃ α : relativeRoots i,
    α.val ∈ J ∧ (QuotientGroup.mk (D.representative α) : relativeWeylGroup i) = w}

/-- The unnormalized full-real action sum of the selected reflection subgroup. -/
def selectedWeylSum (J : Set (characterLattice T)) [Fintype (D.selectedWeylGroup J)] :
    Vstar T →ₗ[ℝ] Vstar T :=
  ∑ w : D.selectedWeylGroup J, (relativeWeylFullRealAction i w.val).toLinearMap

@[simp] theorem selectedWeylSum_apply (J : Set (characterLattice T))
    [Fintype (D.selectedWeylGroup J)] (x : Vstar T) :
    D.selectedWeylSum J x =
      ∑ w : D.selectedWeylGroup J, relativeWeylFullRealAction i w.val x := by
  simp only [selectedWeylSum, LinearMap.sum_apply, LinearEquiv.coe_coe]

/-- Right multiplication reindexes the sum, so it is unchanged by a selected
Weyl action on its argument. -/
theorem selectedWeylSum_action (J : Set (characterLattice T))
    [Fintype (D.selectedWeylGroup J)] (w : D.selectedWeylGroup J) (x : Vstar T) :
    D.selectedWeylSum J (relativeWeylFullRealAction i w.val x) =
      D.selectedWeylSum J x := by
  simp only [selectedWeylSum_apply]
  simp_rw [← LinearEquiv.mul_apply, ← map_mul]
  exact Fintype.sum_equiv (Equiv.mulRight w) _ _ (fun _ => rfl)

/-- Averaging annihilates each selected root, because its own selected
reflection negates that root. -/
theorem selectedWeylSum_root_eq_zero (J : Set (characterLattice T))
    [Fintype (D.selectedWeylGroup J)] (α : relativeRoots i) (hα : α.val ∈ J) :
    D.selectedWeylSum J ((1 : ℝ) ⊗ₜ[ℤ] α.val) = 0 := by
  let w : D.selectedWeylGroup J :=
    ⟨QuotientGroup.mk (D.representative α), Subgroup.subset_closure ⟨α, hα, rfl⟩⟩
  have hneg : relativeWeylFullRealAction i w.val ((1 : ℝ) ⊗ₜ[ℤ] α.val) =
      -((1 : ℝ) ⊗ₜ[ℤ] α.val) := by
    rw [show w.val = QuotientGroup.mk (D.representative α) from rfl,
      D.fullRealAction_representative, pair_tmul_tmul, D.pair_self]
    norm_num
    module
  have h := D.selectedWeylSum_action J w ((1 : ℝ) ⊗ₜ[ℤ] α.val)
  rw [hneg, map_neg] at h
  have htwo : (2 : ℝ) • D.selectedWeylSum J ((1 : ℝ) ⊗ₜ[ℤ] α.val) = 0 := by
    rw [two_smul]
    exact neg_eq_iff_add_eq_zero.mp h
  exact (smul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- The selected root span lies in the kernel of the selected Weyl sum. -/
theorem selectedRootSpan_le_ker_selectedWeylSum (J : Set (characterLattice T))
    [Fintype (D.selectedWeylGroup J)] :
    Submodule.span ℝ ((fun α : characterLattice T => (1 : ℝ) ⊗ₜ[ℤ] α) ''
      (J ∩ relativeRoots i)) ≤ (D.selectedWeylSum J).ker := by
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨α, hα, rfl⟩
  exact D.selectedWeylSum_root_eq_zero J ⟨α, hα.2⟩ hα.1

/-- Selected-coroot annihilation makes every element of the selected
reflection subgroup fix the full real character. -/
theorem fullRealAction_eq_self_of_selectedCoroot_pair_eq_zero
    (J : Set (characterLattice T)) (x : Vstar T)
    (hx : ∀ α : relativeRoots i, α.val ∈ J →
      pair T x ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0)
    {w : relativeWeylGroup i} (hw : w ∈ D.selectedWeylGroup J) :
    relativeWeylFullRealAction i w x = x := by
  induction hw using Subgroup.closure_induction with
  | mem w hw =>
    obtain ⟨α, hα, rfl⟩ := hw
    rw [D.fullRealAction_representative, hx α hα, zero_smul, sub_zero]
  | one => simp
  | mul w v _ _ hw hv => rw [map_mul, LinearEquiv.mul_apply, hv, hw]
  | inv w _ hw =>
    apply (relativeWeylFullRealAction i w).injective
    rw [← LinearEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one, hw]
    rfl

/-- A vector in the selected-root span annihilating all selected coroots is
zero. Finiteness of the actual Weyl group is the only averaging premise. -/
theorem eq_zero_of_mem_selectedRootSpan_of_selectedCoroot_pair_eq_zero
    [Finite (relativeWeylGroup i)] (J : Set (characterLattice T)) {x : Vstar T}
    (hx : x ∈ Submodule.span ℝ ((fun α : characterLattice T => (1 : ℝ) ⊗ₜ[ℤ] α) ''
      (J ∩ relativeRoots i)))
    (hpair : ∀ α : relativeRoots i, α.val ∈ J →
      pair T x ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0) : x = 0 := by
  classical
  let H := D.selectedWeylGroup J
  let : Fintype H := Fintype.ofFinite H
  have hsum : D.selectedWeylSum J x = (Fintype.card H : ℝ) • x := by
    simp only [selectedWeylSum_apply,
      D.fullRealAction_eq_self_of_selectedCoroot_pair_eq_zero J x hpair (Subtype.mem _)]
    simp [H, Nat.cast_smul_eq_nsmul]
  have hzero := D.selectedRootSpan_le_ker_selectedWeylSum J hx
  change D.selectedWeylSum J x = 0 at hzero
  rw [hsum] at hzero
  exact (smul_eq_zero.mp hzero).resolve_left
    (Nat.cast_ne_zero.mpr (Fintype.card_ne_zero : Fintype.card H ≠ 0))

end RelativeRootReflectionData

namespace ParabolicRootPresentation

variable {A : CommGroupScheme (Spec (CommRingCat.of k))}
  {P M : GroupScheme (Spec (CommRingCat.of k))}
  [LocallyOfFiniteType G.X.hom]
  {p : P ⟶ G} {l : M ⟶ P} {a : A.toGrp ⟶ M}
  (r : ParabolicRootPresentation p l a)

local instance : Mono r.data.i.hom.hom.left := r.isCompatible.maximalSplit.isSplitSubtorus.mono

/-- The kernel of restriction to the specified Levi split component is
contained in the full real span of the selected simple roots. -/
theorem mem_selectedRootSpan_of_restrict_eq_zero {x : Vstar r.data.T}
    (hx : rationalCharacterRestrictReal (CommGroupScheme.groupHom r.data.f) x = 0) :
    x ∈ Submodule.span ℝ
      ((fun α : characterLattice r.data.T => (1 : ℝ) ⊗ₜ[ℤ] α) '' r.data.J) := by
  have hjc : IsClosedSubgroup (l ≫ p) :=
    r.isCompatible.levi.isClosedSubgroup.comp r.isCompatible.parabolic.isClosedSubgroup
  let := hjc.mono
  have : Mono (l ≫ p).hom.hom := Over.mono_of_mono_left _
  have hj : (standardLevi r.data.i r.data.ν r.data.J).IsRepresentedBy (l ≫ p) :=
    ⟨inferInstance, r.isCompatible.levi_eq⟩
  have hrange := r.isCompatible.splitComponent.rootAnnihilator_le_range_standardLevi
    r.isCompatible.maximalSplit r.data.ν r.data.J hjc hj r.finite_simpleRoots
    r.exists_standardCocharacter r.data.f r.isCompatible.factor_comp
  have hmem : x ∈ characterAnnihilator (rootAnnihilator r.data.T r.data.J) := by
    rw [mem_characterAnnihilator]
    intro v hv
    obtain ⟨y, rfl⟩ := hrange hv
    rw [pair_cocharacterMapReal, hx, map_zero, LinearMap.zero_apply]
  rw [rootAnnihilator_eq_cocharacterAnnihilator,
    characterAnnihilator_cocharacterAnnihilator r.isCompatible.maximalSplit.1.1] at hmem
  exact hmem

/-- Two full real lifts of the same actual split-component parameter coincide
if both annihilate the selected coroots. -/
theorem eq_of_restrict_eq_of_selectedCoroot_pair_eq_zero (hG : IsConnectedReductive G)
    (D : RelativeRootReflectionData r.data.i) (x y : Vstar r.data.T)
    (hx : ∀ α : relativeRoots r.data.i, α.val ∈ r.data.J →
      pair r.data.T x ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0)
    (hy : ∀ α : relativeRoots r.data.i, α.val ∈ r.data.J →
      pair r.data.T y ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0)
    (hxy : rationalCharacterRestrictReal (CommGroupScheme.groupHom r.data.f) x =
      rationalCharacterRestrictReal (CommGroupScheme.groupHom r.data.f) y) : x = y := by
  have := hG.finite_relativeWeylGroup r.data.i r.isCompatible.maximalSplit
  apply sub_eq_zero.mp
  apply D.eq_zero_of_mem_selectedRootSpan_of_selectedCoroot_pair_eq_zero r.data.J
  · have hspan := r.mem_selectedRootSpan_of_restrict_eq_zero
      (show rationalCharacterRestrictReal (CommGroupScheme.groupHom r.data.f) (x - y) = 0 by
        rw [map_sub, hxy, sub_self])
    have hJ : r.data.J ∩ relativeRoots r.data.i = r.data.J :=
      Set.inter_eq_left.mpr (fun α hα => (r.isCompatible.subset_simpleRoots hα).1.1)
    simpa only [hJ] using hspan
  · intro α hα
    rw [map_sub, LinearMap.sub_apply, hx α hα, hy α hα, sub_self]

end ParabolicRootPresentation

end Langlands.GroupScheme
