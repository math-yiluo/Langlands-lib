import Langlands.GroupScheme.Rational.ClosedRootSubsetStatements
import Langlands.GroupScheme.Rational.CoxeterCocharacterStabilizer
import Langlands.GroupScheme.Rational.RelativeWeylCoxeterProof
import Langlands.GroupScheme.Rational.RootReflectionExistenceProof
import Langlands.GroupScheme.Rational.ParabolicWeylDisplacement
import Langlands.GroupScheme.Rational.ReflectionNegation
import Langlands.GroupScheme.Rational.SimpleRootParabolicFactorization

/-! # The Weyl group of a standard Levi root subset -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.Aubert.General.RationalPointFamily Langlands.Group.RelativeWeylIndexing

namespace Langlands.GroupScheme

namespace StandardRootSubsetWeyl

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : T.toGrp ⟶ G} [IsAffineHom G.X.hom] [Mono i.hom.hom.left]
  {R : Set (characterLattice T)} {ν : cocharacterLattice T}
  {Θ : Set (characterLattice T)}

/-- Negation preserves either permitted ambient root set. -/
theorem neg_mem_ambient (D : RelativeRootReflectionData i)
    (hR : IsRelativeRootAmbient i R) {β : characterLattice T} (hβ : β ∈ R) :
    -β ∈ R := by
  rcases hR with rfl | rfl
  · exact D.neg_mem_relativeRoots i hβ
  · refine ⟨D.neg_mem_relativeRoots i hβ.1, ?_⟩
    intro rho hrho n hn heq
    apply hβ.2 (-rho) (D.neg_mem_relativeRoots i hrho) n hn
    simp only [smul_neg, heq, neg_neg]

omit [Mono i.hom.hom.left] in
/-- A standard cocharacter vanishes on the closed Levi root subset as soon
as the selected simple roots belong to a negation-stable ambient set. -/
theorem pairing_eq_zero_of_mem_levi
    (hneg : ∀ β ∈ R, -β ∈ R) (hΘR : Θ ⊆ R)
    {ζ : cocharacterLattice T} (hζ : IsStandardCocharacter i ν Θ ζ)
    {β : characterLattice T} (hβ : β ∈ standardLeviRootSubset R Θ) :
    latticePairing T β ζ = 0 := by
  have hclosed : IsClosedRootSubset R {rho | rho ∈ R ∧ latticePairing T rho ζ = 0} := by
    refine ⟨fun _ h => h.1, ?_⟩
    intro rho hrho δ hδ hsum
    exact ⟨hsum, by simp [hrho.2, hδ.2]⟩
  apply (rootClosure_subset hclosed ?_ hβ).2
  intro rho hrho
  rcases hrho with hrho | hrho
  · exact ⟨hΘR hrho, hζ.2.1 rho hrho⟩
  · refine ⟨by simpa only [neg_neg] using hneg (-rho) (hΘR hrho), ?_⟩
    have hzero := hζ.2.1 (-rho) hrho
    simpa only [map_neg, LinearMap.neg_apply, neg_eq_zero] using hzero

omit [IsAffineHom G.X.hom] in
/-- A root reflection whose root has zero pairing stabilizes pairing with
that cocharacter on the whole character lattice. -/
theorem reflection_mem_pairingStabilizer
    {ζ : cocharacterLattice T} {β : characterLattice T}
    {w : relativeWeylGroup i} (hzero : latticePairing T β ζ = 0)
    (hw : IsRootReflection i w β) :
    w ∈ cocharacterPairingWeylStabilizer i ζ := by
  obtain ⟨c, -, hw⟩ := hw
  intro χ
  change latticePairing T (relativeWeylCharacterAction i w χ) ζ = _
  rw [hw χ]
  simp [hzero]

/-- Integral reflection data realize the simple reflection of each actual
simple relative root as a root reflection on the full character lattice. -/
theorem isRootReflection_simple
    [LocallyOfFiniteType G.X.hom] [Finite (relativeWeylGroup i)]
    {CM : CoxeterMatrix (SimpleRoot i ν)} {cs : CoxeterSystem CM (relativeWeylGroup i)}
    (hT : IsSplitTorus T.toGrp) (hcs : IsRelativeWeylCoxeterRealization i ν cs)
    (D : RelativeRootReflectionData i) (a : SimpleRoot i ν) :
    IsRootReflection i (cs.simple a) a.val := by
  have hs := hcs.eq_simple_of_isRelativeReflection hT a
    (D.isRelativeReflection_representative hT (hT.finite_relativeRoots i)
      ⟨a.val, a.property.1.1⟩)
  rw [← hs]
  exact ⟨D.coroot ⟨a.val, a.property.1.1⟩,
    D.pair_self ⟨a.val, a.property.1.1⟩, D.action ⟨a.val, a.property.1.1⟩⟩

end StandardRootSubsetWeyl

/-- The Weyl group generated by root reflections in the standard Levi root
subset is the actual relative Weyl group of the standard Levi, in either
permitted ambient root set. -/
theorem rootSubsetWeylGroup_standardLevi
    {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
    (hG : IsConnectedReductive G) {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) :
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ ν : cocharacterLattice T, IsGenericCocharacter i ν →
        ∀ Θ : Set (characterLattice T), Θ ⊆ simpleRelativeRoots i ν →
          rootSubsetWeylGroup i (standardLeviRootSubset R Θ) =
            standardRelativeWeylGroup i ν Θ := by
  have := hG.isAffineHom
  have := hG.smooth
  have := hi.isSplitSubtorus.mono
  intro R hR ν hν Θ hΘ
  obtain ⟨hW, hS, CM, cs, hcs⟩ := relativeWeylCoxeter k G hG T i hi ν hν
  have := hW
  have := hS
  obtain ⟨D, -⟩ := relativeRootReflectionExistence k G hG T i hi
  have hT := hi.isSplitSubtorus.1
  have hΘR : Θ ⊆ R := by
    intro β hβ
    rcases hR with rfl | rfl
    · exact (hΘ hβ).1.1
    · exact (simpleRelativeRoot_mem_indivisiblePositiveRoots
        hcs.linearIndependent_simpleRelativeRoots (hΘ hβ)).1
  classical
  let I : Finset (SimpleRoot i ν) :=
    (Set.toFinite {a : SimpleRoot i ν | a.val ∈ Θ}).toFinset
  have hI (a : SimpleRoot i ν) : a ∈ I ↔ a.val ∈ Θ := by simp [I]
  have hroot : rootSet i ν I = Θ := by
    ext β
    constructor
    · rintro ⟨a, ha, rfl⟩
      exact (hI a).mp ha
    · intro hβ
      exact ⟨⟨β, hΘ hβ⟩, (hI _).mpr hβ, rfl⟩
  obtain ⟨ζ, hζ⟩ := hcs.exists_standardCocharacter_finset I
  have hζΘ : IsStandardCocharacter i ν Θ ζ := hroot ▸ hζ
  have hstab : cocharacterPairingWeylStabilizer i ζ = standardRelativeWeylGroup i ν Θ := by
    rw [hcs.pairingStabilizer_eq_standardSubgroup hν hζ, hcs.2.2.2.2 I, hroot]
  apply le_antisymm
  · rw [rootSubsetWeylGroup, Subgroup.closure_le]
    rintro w ⟨β, hβ, hw⟩
    rw [← hstab]
    exact StandardRootSubsetWeyl.reflection_mem_pairingStabilizer
      (StandardRootSubsetWeyl.pairing_eq_zero_of_mem_levi
        (fun _ h => StandardRootSubsetWeyl.neg_mem_ambient D hR h) hΘR hζΘ hβ) hw
  · rw [← hroot, ← hcs.2.2.2.2 I, standardSubgroup, Subgroup.closure_le]
    rintro _ ⟨a, ha, rfl⟩
    apply Subgroup.subset_closure
    refine ⟨a.val, ?_, StandardRootSubsetWeyl.isRootReflection_simple hT hcs D a⟩
    change a.val ∈ rootClosure R (rootSet i ν I ∪ {rho | -rho ∈ rootSet i ν I})
    exact subset_rootClosure _ (Or.inl ⟨a, ha, rfl⟩)

end Langlands.GroupScheme
