import Langlands.GroupScheme.Rational.RootGeneratedCentralizerSubgroup
import Langlands.Group.CoxeterQuotientKernel

/-! # The actual normalizer kernel for root-generated Coxeter lifts -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeRoot

variable {k : Type u} [Field k]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : S.toGrp ⟶ G) [IsAffineHom G.X.hom] [Mono i.hom.hom.left]

/-- The rank-one centralizer generated subgroup viewed inside the actual normalizer. -/
abbrev rankOneCentralizerNormalizerPoints : Subgroup (normalizerPoints i) :=
  (rankOneCentralizerGeneratedPoints i).subgroupOf (normalizerPoints i)

/-- The actual normalizer subgroup generated by the rank-one centralizer subgroup
and a family of normalizing lifts. -/
def rankOneLiftNormalizerPoints {B : Type v} (m : B → normalizerPoints i) :
    Subgroup (normalizerPoints i) :=
  Langlands.Group.CoxeterQuotient.generatedBy (rankOneCentralizerNormalizerPoints i) m

/-- The same generated subgroup as a subgroup of all rational points. -/
def rankOneLiftPoints {B : Type v} (m : B → normalizerPoints i) :
    Subgroup (rationalPoints G) :=
  (rankOneLiftNormalizerPoints i m).map (normalizerPoints i).subtype

/-- Two normalizing elements in the same opposite-root generated subgroup with
the same relative Weyl class agree modulo the rank-one centralizer subgroup. -/
theorem oppositeGenerated_lifts_eq_mod_rankOneCentralizer
    {a : characterLattice S} (ha : a ∈ relativeRoots i)
    {n m : normalizerPoints i}
    (hn : n.val ∈ oppositeGeneratedPoints i a)
    (hm : m.val ∈ oppositeGeneratedPoints i a)
    (heq : (QuotientGroup.mk n : relativeWeylGroup i) = QuotientGroup.mk m) :
    (QuotientGroup.mk n : normalizerPoints i ⧸ rankOneCentralizerNormalizerPoints i) =
      QuotientGroup.mk m := by
  apply QuotientGroup.eq.mpr
  change n.val⁻¹ * m.val ∈ rankOneCentralizerGeneratedPoints i
  have hz : n⁻¹ * m ∈ (centralizerPoints i).subgroupOf (normalizerPoints i) :=
    QuotientGroup.eq.mp heq
  apply Subgroup.subset_closure
  exact Set.mem_iUnion₂.mpr ⟨a, ha, hz,
    (oppositeGeneratedPoints i a).mul_mem ((oppositeGeneratedPoints i a).inv_mem hn) hm⟩

/-- A normalizing opposite-root lift of an involution has square in the rank-one
centralizer generated subgroup. -/
theorem oppositeGenerated_lift_sq_mem_rankOneCentralizer
    {a : characterLattice S} (ha : a ∈ relativeRoots i)
    {n : normalizerPoints i} (hn : n.val ∈ oppositeGeneratedPoints i a)
    (hinv : (QuotientGroup.mk n : relativeWeylGroup i) ^ 2 = 1) :
    n.val ^ 2 ∈ rankOneCentralizerGeneratedPoints i := by
  have hz : n ^ 2 ∈ (centralizerPoints i).subgroupOf (normalizerPoints i) := by
    apply (QuotientGroup.eq_one_iff (n ^ 2)).1
    simpa only [QuotientGroup.mk_pow] using hinv
  exact Subgroup.subset_closure (Set.mem_iUnion₂.mpr ⟨a, ha, hz,
    (oppositeGeneratedPoints i a).pow_mem hn 2⟩)

/-- The projection kernel of a root-lift generated normalizer subgroup is exactly
the rank-one centralizer subgroup, provided all Coxeter relations hold modulo it. -/
theorem rankOneLiftNormalizerPoints_inf_centralizer_eq
    {B : Type v} {M : CoxeterMatrix B} (cs : CoxeterSystem M (relativeWeylGroup i))
    (m : B → normalizerPoints i)
    (hm : ∀ a, (QuotientGroup.mk (m a) : relativeWeylGroup i) = cs.simple a)
    (hrel : M.IsLiftable (fun a => (QuotientGroup.mk (m a) :
      normalizerPoints i ⧸ rankOneCentralizerNormalizerPoints i))) :
    rankOneLiftNormalizerPoints i m ⊓
      (centralizerPoints i).subgroupOf (normalizerPoints i) =
        rankOneCentralizerNormalizerPoints i := by
  let q : normalizerPoints i →* relativeWeylGroup i :=
    QuotientGroup.mk' ((centralizerPoints i).subgroupOf (normalizerPoints i))
  have hH : rankOneCentralizerNormalizerPoints i ≤ q.ker := by
    rw [QuotientGroup.ker_mk']
    intro n hn
    exact rankOneCentralizerGeneratedPoints_le_centralizer i hn
  simpa only [q, QuotientGroup.ker_mk', rankOneLiftNormalizerPoints] using
    Langlands.Group.CoxeterQuotient.generatedBy_inf_ker_eq cs
    (rankOneCentralizerNormalizerPoints i) m q hH hm hrel

/-- The kernel equality stated as the ambient rational-point inclusion needed
by the Bruhat covering argument. -/
theorem centralizer_inf_rankOneLiftPoints_le
    {B : Type v} {M : CoxeterMatrix B} (cs : CoxeterSystem M (relativeWeylGroup i))
    (m : B → normalizerPoints i)
    (hm : ∀ a, (QuotientGroup.mk (m a) : relativeWeylGroup i) = cs.simple a)
    (hrel : M.IsLiftable (fun a => (QuotientGroup.mk (m a) :
      normalizerPoints i ⧸ rankOneCentralizerNormalizerPoints i))) :
    centralizerPoints i ⊓ rankOneLiftPoints i m ≤ rankOneCentralizerGeneratedPoints i := by
  intro g hg
  obtain ⟨n, hn, rfl⟩ := hg.2
  have hnH : n ∈ rankOneCentralizerNormalizerPoints i := by
    rw [← rankOneLiftNormalizerPoints_inf_centralizer_eq i cs m hm hrel]
    exact ⟨hn, hg.1⟩
  exact hnH

end Langlands.GroupScheme.RelativeRoot
