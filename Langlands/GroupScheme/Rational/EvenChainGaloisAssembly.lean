import Langlands.GroupScheme.Rational.EvenChainGaloisDataStatement
import Langlands.GroupScheme.Rational.EvenChainOrthogonalGaloisData
import Langlands.GroupScheme.Rational.EvenChainBlockCommutation
import Langlands.GroupScheme.Rational.AdjacentSimpleRootCommutator
import Langlands.LinearAlgebra.RootDatumPairedPaths
import Langlands.Algebra.SortedOrbitBlocks

/-! # Galois-stable even-path data from Galois-compatible merged data -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option autoImplicit false

section Galois

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]

local instance : IsAffineHom
    ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom := by
  change IsAffineHom (pullback.snd G.X.hom (algebraBaseMap k K))
  infer_instance

namespace PairingCompatiblePinningData

open LinearAlgebra.RootDatumPairedPaths Algebra.FiniteActionOrbitBlocks

variable (D : PairingCompatiblePinningData k K G)

/-- The pairs of distinct non-orthogonal simple roots in one Galois orbit, each represented
by one of its two roots. -/
abbrev Pairs : Type u := PairIndex D.action

instance : MulAction (K ≃ₐ[k] K) D.Pairs := pairAction D.isPairingCompatible

/-- The Galois action on pairs either keeps or swaps the order of the two roots. -/
theorem smul_orientation (σ : K ≃ₐ[k] K) (c : D.Pairs) :
    ((σ • c).1 = D.action σ c.1 ∧
        partner D.action (σ • c).1 = D.action σ (partner D.action c.1)) ∨
      ((σ • c).1 = D.action σ (partner D.action c.1) ∧
        partner D.action (σ • c).1 = D.action σ c.1) :=
  pairSMul_orientation D.isPairingCompatible σ c

/-- Merged-root data at the pairs: the first merged root is the representative of the pair,
the second one its partner, both unipotent coordinates are `1`, the merged representative
lies in the subgroup generated by `U_{± α}`, and the merged root coordinate, the merged
representative and the merged coroot are transported exactly by the Galois action. -/
structure MergedGaloisData where
  /-- The merged data of each pair. -/
  data : D.Pairs → D.pinning.SteinbergModifiedData
  a_eq : ∀ c, (data c).a = c.1
  b_eq : ∀ c, (data c).b = partner D.action c.1
  ca_eq : ∀ c, (data c).ca = 1
  cb_eq : ∀ c, (data c).cb = 1
  nAlpha_mem : ∀ c, (data c).nAlpha.point ∈
    (RelativeRoot.subgroup D.pinning.inclusion
        (D.pinning.rootDatum.root (data c).alpha)).carrier (Over.mk (𝟙 _)) ⊔
      (RelativeRoot.subgroup D.pinning.inclusion
        (-D.pinning.rootDatum.root (data c).alpha)).carrier (Over.mk (𝟙 _))
  xAlpha_conj : ∀ (σ : K ≃ₐ[k] K) (c : D.Pairs) (s : K),
    GaloisPointComparison.rationalConjugate k K G σ ((data c).xAlpha.rationalPoint s) =
      (data (σ • c)).xAlpha.rationalPoint (σ s)
  nAlpha_conj : ∀ (σ : K ≃ₐ[k] K) (c : D.Pairs),
    GaloisPointComparison.rationalConjugate k K G σ (data c).nAlpha.point =
      (data (σ • c)).nAlpha.point
  coroot_conj : ∀ (σ : K ≃ₐ[k] K) (c : D.Pairs) (t : Kˣ),
    GaloisPointComparison.rationalConjugate k K G σ
        (SplitPinning.corootRationalPoint D.pinning (data c).alpha t) =
      SplitPinning.corootRationalPoint D.pinning (data (σ • c)).alpha
        (Units.map (σ : K →* K) t)

variable {D}

namespace MergedGaloisData

variable (MD : D.MergedGaloisData)

/-- The even-path data: the paths through the pairs, with the supplied merged data. -/
def evenChainData : D.pinning.EvenChainData D.Pairs where
  half := half D.isPairingCompatible
  path := path D.isPairingCompatible
  isPathComponent := isPathComponent_path D.isPairingCompatible
  disjoint := path_disjoint D.isPairingCompatible
  modified := MD.data
  modified_a c := (MD.a_eq c).trans (path_left D.isPairingCompatible c).symm
  modified_b c := (MD.b_eq c).trans (path_right D.isPairingCompatible c).symm
  nAlpha_mem := MD.nAlpha_mem

theorem evenChainData_modified : MD.evenChainData.modified = MD.data := rfl

/-- The unmerged simple roots are exactly the unpaired ones. -/
theorem mem_rest_iff (z : D.pinning.base.support) :
    (∀ c, z ≠ (MD.evenChainData.modified c).a ∧ z ≠ (MD.evenChainData.modified c).b) ↔
      ¬ IsPaired D.action z := by
  rw [isPaired_iff_exists D.isPairingCompatible, evenChainData_modified]
  constructor
  · rintro h ⟨c, hc | hc⟩
    · exact (h c).1 (hc.trans (MD.a_eq c).symm)
    · exact (h c).2 (hc.trans (MD.b_eq c).symm)
  · intro h c
    exact ⟨fun hc => h ⟨c, Or.inl (hc.trans (MD.a_eq c))⟩,
      fun hc => h ⟨c, Or.inr (hc.trans (MD.b_eq c))⟩⟩

/-- The Galois action on the unmerged simple roots. -/
def restSMul (σ : K ≃ₐ[k] K) (z : MD.evenChainData.Rest) : MD.evenChainData.Rest :=
  ⟨D.action σ z.1, (MD.mem_rest_iff _).mpr (by
    rw [isPaired_apply_iff D.isPairingCompatible]
    exact (MD.mem_rest_iff _).mp z.2)⟩

instance restAction : MulAction (K ≃ₐ[k] K) MD.evenChainData.Rest where
  smul := MD.restSMul
  one_smul z := Subtype.ext (by
    change D.action 1 z.1 = z.1
    simp)
  mul_smul σ τ z := Subtype.ext (by
    change D.action (σ * τ) z.1 = D.action σ (D.action τ z.1)
    simp [Equiv.Perm.mul_apply])

theorem restSMul_val (σ : K ≃ₐ[k] K) (z : MD.evenChainData.Rest) :
    (σ • z).1 = D.action σ z.1 := rfl

/-- The key of an unmerged simple root: its distance from the middle pair of its path. -/
abbrev restKey (z : MD.evenChainData.Rest) : ℕ := level D.isPairingCompatible z.1

theorem restKey_smul (σ : K ≃ₐ[k] K) (z : MD.evenChainData.Rest) :
    MD.restKey (σ • z) = MD.restKey z :=
  level_apply D.isPairingCompatible σ z.1

/-- The unmerged simple roots in Galois orbit blocks sorted by distance from the middle. -/
abbrev restBlocks : List (List MD.evenChainData.Rest) :=
  sortedBlocks (K ≃ₐ[k] K) MD.evenChainData.Rest MD.restKey

/-- The middle-out ordering of the unmerged simple roots. -/
def restOrdering : Fin MD.restBlocks.flatten.length ≃ MD.evenChainData.Rest :=
  sortedOrdering (K ≃ₐ[k] K) MD.evenChainData.Rest MD.restKey

theorem isMiddleOut : MD.evenChainData.IsMiddleOut MD.restOrdering := by
  intro c i i' j j' hj hj' hlt
  apply sortedOrdering_lt_of_key_lt MD.restKey_smul
  change level D.isPairingCompatible (MD.restOrdering j).1 <
    level D.isPairingCompatible (MD.restOrdering j').1
  rw [hj, hj']
  change level D.isPairingCompatible (path D.isPairingCompatible c i) <
    level D.isPairingCompatible (path D.isPairingCompatible c i')
  rw [level_path, level_path]
  exact hlt

/-! ### Galois transport of the blocks -/

theorem ua_eq (c : D.Pairs) :
    (MD.data c).ua D.rootMaps = (D.rootMaps c.1).toRootParametrization.rationalPoint 1 := by
  unfold SplitPinning.SteinbergModifiedData.ua
  rw [MD.ca_eq, MD.a_eq]

theorem ub_eq (c : D.Pairs) :
    (MD.data c).ub D.rootMaps =
      (D.rootMaps (partner D.action c.1)).toRootParametrization.rationalPoint 1 := by
  unfold SplitPinning.SteinbergModifiedData.ub
  rw [MD.cb_eq, MD.b_eq]

theorem conj_simple (σ : K ≃ₐ[k] K) (z : D.pinning.base.support) :
    GaloisPointComparison.rationalConjugate k K G σ
        ((D.rootMaps z).toRootParametrization.rationalPoint 1) =
      (D.rootMaps (D.action σ z)).toRootParametrization.rationalPoint 1 := by
  rw [SplitPinning.RootMapsGaloisCompatible.rationalPoints k K G D.rootMaps D.action
    D.rootMaps_compatible, map_one]

theorem block_true (c : D.Pairs) (s : K) (t : Kˣ) :
    MD.evenChainData.block D.rootMaps c true s t =
      (MD.data c).ub D.rootMaps * (MD.data c).ua D.rootMaps *
        (MD.data c).xAlpha.rationalPoint s * (MD.data c).nAlpha.point *
          SplitPinning.corootRationalPoint D.pinning (MD.data c).alpha t := rfl

theorem block_false (c : D.Pairs) (s : K) (t : Kˣ) :
    MD.evenChainData.block D.rootMaps c false s t =
      (MD.data c).xAlpha.rationalPoint s * (MD.data c).nAlpha.point := rfl

/-- The Galois image of a block is the block of the image pair with the same pattern value,
transported unit, and a suitable root coordinate. -/
theorem block_rationalConjugate (σ : K ≃ₐ[k] K) (c : D.Pairs) (β : Bool) (s : K)
    (t : Kˣ) :
    ∃ s' : K, GaloisPointComparison.rationalConjugate k K G σ
        (MD.evenChainData.block D.rootMaps c β s t) =
      MD.evenChainData.block D.rootMaps (σ • c) β s' (Units.map (σ : K →* K) t) := by
  cases β
  · refine ⟨σ s, ?_⟩
    rw [block_false, block_false, map_mul, MD.xAlpha_conj, MD.nAlpha_conj]
  · rcases D.smul_orientation σ c with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · refine ⟨σ s, ?_⟩
      rw [block_true, block_true, map_mul, map_mul, map_mul, map_mul, MD.xAlpha_conj,
        MD.nAlpha_conj, MD.coroot_conj, MD.ua_eq, MD.ub_eq, conj_simple, conj_simple,
        ← h1, ← h2, ← MD.ua_eq, ← MD.ub_eq]
    · set c' := σ • c with hc'
      have hpaired : IsPaired D.action c'.1 := c'.2.1
      have hpab : D.pinning.rootDatum.pairing ((MD.data c').a : D.pinning.rootIndex)
          ((MD.data c').b : D.pinning.rootIndex) = -1 := by
        rw [MD.a_eq, MD.b_eq]
        exact (hpaired.pairing_partner D.isPairingCompatible).1
      have hpba : D.pinning.rootDatum.pairing ((MD.data c').b : D.pinning.rootIndex)
          ((MD.data c').a : D.pinning.rootIndex) = -1 := by
        rw [MD.a_eq, MD.b_eq]
        exact (hpaired.pairing_partner D.isPairingCompatible).2
      obtain ⟨r, hr⟩ := SplitPinning.adjacent_rationalPoint_reorder D.pinning
        (MD.data c').a (MD.data c').b (MD.data c').a_ne_b hpab hpba (MD.data c').root_eq
        (D.rootMaps (MD.data c').a).toRootParametrization
        (D.rootMaps (MD.data c').b).toRootParametrization (MD.data c').xAlpha 1 1
      have hr' : (MD.data c').ua D.rootMaps * (MD.data c').ub D.rootMaps =
          (MD.data c').ub D.rootMaps * (MD.data c').ua D.rootMaps *
            (MD.data c').xAlpha.rationalPoint r := by
        unfold SplitPinning.SteinbergModifiedData.ua SplitPinning.SteinbergModifiedData.ub
        rw [MD.ca_eq, MD.cb_eq]
        exact hr
      refine ⟨r + σ s, ?_⟩
      rw [block_true, block_true, map_mul, map_mul, map_mul, map_mul, MD.xAlpha_conj,
        MD.nAlpha_conj, MD.coroot_conj, MD.ua_eq, MD.ub_eq, conj_simple, conj_simple,
        ← h1, ← h2, ← MD.ua_eq, ← MD.ub_eq, hr',
        SplitPinning.RootParametrization.rationalPoint_add]
      simp only [mul_assoc]
      rfl

/-- The Galois image of the ordered product of blocks is again an ordered product of blocks
in the same order, with pattern and units transported along the action on pairs. -/
theorem blocks_rationalConjugate {r : ℕ} (o : Fin r ≃ D.Pairs) (σ : K ≃ₐ[k] K)
    (ε : D.Pairs → Bool) (s : D.Pairs → K) (t : D.Pairs → Kˣ) :
    ∃ s' : D.Pairs → K, GaloisPointComparison.rationalConjugate k K G σ
        (List.ofFn fun j : Fin r =>
          MD.evenChainData.block D.rootMaps (o j) (ε (o j)) (s (o j)) (t (o j))).prod =
      (List.ofFn fun j : Fin r =>
          MD.evenChainData.block D.rootMaps (o j) (ε (σ⁻¹ • o j)) (s' (o j))
            (Units.map (σ : K →* K) (t (σ⁻¹ • o j)))).prod := by
  choose S hS using fun c => MD.block_rationalConjugate σ c (ε c) (s c) (t c)
  let f : D.Pairs → rationalPoints (GaloisPointComparison.baseChanged k K G) := fun c' =>
    MD.evenChainData.block D.rootMaps c' (ε (σ⁻¹ • c')) (S (σ⁻¹ • c'))
      (Units.map (σ : K →* K) (t (σ⁻¹ • c')))
  refine ⟨fun c' => S (σ⁻¹ • c'), ?_⟩
  have hl : (List.ofFn fun j : Fin r => GaloisPointComparison.rationalConjugate k K G σ
      (MD.evenChainData.block D.rootMaps (o j) (ε (o j)) (s (o j)) (t (o j)))) =
      (List.ofFn fun j : Fin r => σ • o j).map f := by
    rw [List.map_ofFn]
    congr 1
    funext j
    simp only [Function.comp_apply, f, inv_smul_smul, hS]
  have hl' : (List.ofFn fun j : Fin r =>
      MD.evenChainData.block D.rootMaps (o j) (ε (σ⁻¹ • o j)) (S (σ⁻¹ • o j))
        (Units.map (σ : K →* K) (t (σ⁻¹ • o j)))) =
      (List.ofFn fun j : Fin r => o j).map f := by
    rw [List.map_ofFn]
    rfl
  have hinj : Function.Injective fun j : Fin r => σ • o j :=
    (MulAction.injective σ).comp o.injective
  have hperm : (List.ofFn fun j : Fin r => σ • o j).Perm (List.ofFn fun j : Fin r => o j) := by
    apply (List.perm_ext_iff_of_nodup (List.nodup_ofFn.mpr hinj)
      (List.nodup_ofFn.mpr o.injective)).mpr
    intro c
    simp only [List.mem_ofFn]
    constructor
    · rintro -
      exact ⟨o.symm c, by simp⟩
    · rintro -
      exact ⟨o.symm (σ⁻¹ • c), by simp⟩
  have hcomm : ((List.ofFn fun j : Fin r => σ • o j).map f).Pairwise Commute := by
    rw [List.pairwise_map, List.pairwise_ofFn]
    intro i j hij
    exact MD.evenChainData.commute_block D.rootMaps (fun h => (ne_of_lt hij) (hinj h)) _ _ _ _
      _ _
  rw [map_list_prod, List.map_ofFn]
  change (List.ofFn fun j : Fin r => GaloisPointComparison.rationalConjugate k K G σ
      (MD.evenChainData.block D.rootMaps (o j) (ε (o j)) (s (o j)) (t (o j)))).prod = _
  rw [hl, hl']
  exact (hperm.map f).prod_eq' hcomm

/-! ### Galois transport of the unmerged factors -/

/-- Two distinct entries of one sorted orbit block of unmerged roots are orthogonal. -/
theorem restBlocks_pairwise (l : List MD.evenChainData.Rest) (hl : l ∈ MD.restBlocks) :
    l.Pairwise (fun z w => z.1 ≠ w.1 ∧ D.pinning.rootDatum.IsOrthogonal z.1 w.1) := by
  apply ((List.nodup_flatten.mp (sortedBlocks_flatten_nodup (K ≃ₐ[k] K)
    MD.evenChainData.Rest MD.restKey)).1 l hl).pairwise_of_forall_ne
  intro z hz w hw hzw
  obtain ⟨τ, hτ⟩ := sortedBlocks_same_orbit (K ≃ₐ[k] K) MD.evenChainData.Rest MD.restKey
    l hl z w hz hw
  have hval : w.1 = D.action τ z.1 := by rw [← hτ]; rfl
  have hne : z.1 ≠ w.1 := fun h => hzw (Subtype.ext h)
  refine ⟨hne, ?_⟩
  rw [hval]
  exact not_isOrthogonal_of_not_isPaired ((MD.mem_rest_iff _).mp z.2) τ
    (by rw [← hval]; exact Ne.symm hne)

/-- The Galois image of the ordered product of the unmerged factors is the product of the
factors with transported coordinates, in the same order. -/
theorem rest_rationalConjugate (σ : K ≃ₐ[k] K) (d : Fin MD.restBlocks.flatten.length → K) :
    GaloisPointComparison.rationalConjugate k K G σ
        (List.ofFn fun j : Fin MD.restBlocks.flatten.length =>
          (D.rootMaps (MD.restOrdering j).1).toRootParametrization.rationalPoint (d j) *
            (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps
              (MD.restOrdering j).1).point).prod =
      (List.ofFn fun j : Fin MD.restBlocks.flatten.length =>
          (D.rootMaps (MD.restOrdering j).1).toRootParametrization.rationalPoint
              (σ (d (MD.restOrdering.symm (σ⁻¹ • MD.restOrdering j)))) *
            (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps
              (MD.restOrdering j).1).point).prod := by
  let e := MD.restOrdering
  let g := fun z : MD.evenChainData.Rest =>
    D.rationalRootFactor z.1 (d (e.symm z))
  let f := fun z : MD.evenChainData.Rest =>
    D.rationalRootFactor z.1 (σ (d (e.symm (σ⁻¹ • z))))
  have hflat : MD.restBlocks.flatten = List.ofFn e :=
    sortedBlocks_flatten_eq_ofFn (K ≃ₐ[k] K) MD.evenChainData.Rest MD.restKey
  have hgl : (List.ofFn fun j : Fin MD.restBlocks.flatten.length =>
      (D.rootMaps (e j).1).toRootParametrization.rationalPoint (d j) *
        (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps (e j).1).point) =
      (List.ofFn e).map g := by
    rw [List.map_ofFn]
    congr 1
    funext j
    simp only [Function.comp_apply, g, Equiv.symm_apply_apply]
    rfl
  have hfl : (List.ofFn fun j : Fin MD.restBlocks.flatten.length =>
      (D.rootMaps (e j).1).toRootParametrization.rationalPoint
          (σ (d (e.symm (σ⁻¹ • e j)))) *
        (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps (e j).1).point) =
      (List.ofFn e).map f := by
    rw [List.map_ofFn]
    rfl
  have hf (z : MD.evenChainData.Rest) :
      GaloisPointComparison.rationalConjugate k K G σ (g z) = f (σ • z) := by
    simp only [g, f, inv_smul_smul]
    exact D.rationalRootFactor_rationalConjugate σ z.1 _
  change GaloisPointComparison.rationalConjugate k K G σ (List.ofFn fun j => _).prod =
    (List.ofFn fun j => _).prod
  rw [hgl, hfl, ← hflat, List.map_flatten, List.prod_flatten, map_list_prod, List.map_map,
    List.map_flatten, List.prod_flatten]
  apply congrArg List.prod
  simp only [List.map_map]
  apply List.map_congr_left
  intro l hl
  dsimp only [Function.comp_def]
  rw [map_list_prod, List.map_map]
  have hcomm : (l.map f).Pairwise Commute := by
    rw [List.pairwise_map]
    exact (MD.restBlocks_pairwise l hl).imp
      (fun h => D.commute_rationalRootFactors _ _ h.1 h.2 _ _)
  have hinv := sortedBlocks_invariant (K ≃ₐ[k] K) MD.evenChainData.Rest MD.restKey σ l hl
  have := ((hinv.map f).symm.prod_eq' hcomm).symm
  simpa only [List.map_map, Function.comp_def, hf] using this

/-! ### Stability of the pattern set -/

theorem patternSet_stable {r : ℕ} (o : Fin r ≃ D.Pairs) (σ : K ≃ₐ[k] K)
    (g : rationalPoints (GaloisPointComparison.baseChanged k K G))
    (hg : g ∈ MD.evenChainData.patternSet D.rootMaps
      (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps) o MD.restOrdering) :
    GaloisPointComparison.rationalConjugate k K G σ g ∈
      MD.evenChainData.patternSet D.rootMaps
        (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps) o
          MD.restOrdering := by
  obtain ⟨ε, s, t, d, rfl⟩ := hg
  obtain ⟨s', hs'⟩ := MD.blocks_rationalConjugate o σ ε s t
  refine ⟨fun c => ε (σ⁻¹ • c), s', fun c => Units.map (σ : K →* K) (t (σ⁻¹ • c)),
    fun j => σ (d (MD.restOrdering.symm (σ⁻¹ • MD.restOrdering j))), ?_⟩
  unfold SplitPinning.EvenChainData.patternProduct
  rw [map_mul, hs', MD.rest_rationalConjugate]

include MD in
/-- Galois-compatible merged data give the even-path conclusion. -/
theorem exists_evenChainGaloisData :
    ∃ (J : Type u) (_ : Fintype J) (C : D.pinning.EvenChainData J) (r q : ℕ)
      (o : Fin r ≃ J) (e : Fin q ≃ C.Rest),
      C.IsMiddleOut e ∧
        ∀ (σ : K ≃ₐ[k] K) (g : rationalPoints (GaloisPointComparison.baseChanged k K G)),
          g ∈ C.patternSet D.rootMaps
              (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps) o e →
            GaloisPointComparison.rationalConjugate k K G σ g ∈ C.patternSet D.rootMaps
              (SplitPinning.canonicalSimpleReflectionRepresentatives D.rootMaps) o e :=
  ⟨D.Pairs, Fintype.ofFinite _, MD.evenChainData, Nat.card D.Pairs, _,
    (Finite.equivFin D.Pairs).symm, MD.restOrdering, MD.isMiddleOut,
    fun σ g hg => MD.patternSet_stable _ σ g hg⟩

end MergedGaloisData

end PairingCompatiblePinningData

end Galois

end Langlands.GroupScheme
