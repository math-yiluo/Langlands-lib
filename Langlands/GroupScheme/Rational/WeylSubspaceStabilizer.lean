import Langlands.GroupScheme.Rational.WeylCocharacterStabilizer
import Langlands.GroupScheme.Rational.SpanAnnihilatingCocharacter
import Langlands.GroupScheme.Rational.ConvexRootSymmetricSpan

/-! # Weyl stabilizers of rational character subspaces -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open Langlands.LinearAlgebra.RationalSpan
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [Mono i.hom.hom.left] [IsAffineHom G.X.hom]

/-- An element fixing all integral cocharacters annihilating a rational
character subspace is generated by reflections in the roots in that subspace. -/
theorem mem_rootSubsetWeylGroup_roots_in_subspace_of_fixed_annihilator
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (W : Submodule ℚ (ℚ ⊗[ℤ] characterLattice T)) (w : relativeWeylGroup i)
    (hw : ∀ ξ : cocharacterLattice T,
      (∀ α : characterLattice T, toRat α ∈ W → latticePairing T α ξ = 0) →
        relativeWeylCocharacterAction i w ξ = ξ) :
    w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ toRat α ∈ W} := by
  let := hG.smooth
  have hT := hi.isSplitSubtorus.1
  obtain ⟨ξ, hvanish, htest⟩ :=
    hT.exists_cocharacter_zero_iff_mem_subspace W (relativeRoots i) (hT.finite_relativeRoots i)
  have hzero := (mem_rootSubsetWeylGroup_zero_iff_cocharacter_fixed i hG hi ξ w).mpr
    (hw ξ hvanish)
  have hsets : {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} =
      {α | α ∈ relativeRoots i ∧ toRat α ∈ W} := by
    ext α
    exact and_congr_right (fun hα => htest α hα)
  rwa [hsets] at hzero

/-- The Weyl subgroup of the roots in a rational subspace is precisely the
pointwise stabilizer of its integral cocharacter annihilator. -/
theorem mem_rootSubsetWeylGroup_roots_in_subspace_iff_fixed_annihilator
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (W : Submodule ℚ (ℚ ⊗[ℤ] characterLattice T)) (w : relativeWeylGroup i) :
    w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ toRat α ∈ W} ↔
      ∀ ξ : cocharacterLattice T,
        (∀ α : characterLattice T, toRat α ∈ W → latticePairing T α ξ = 0) →
          relativeWeylCocharacterAction i w ξ = ξ := by
  constructor
  · intro hw ξ hξ
    apply (hi.isSplitSubtorus.1.relativeWeylCocharacterAction_eq_self_iff_pairing i ξ w).mpr
    exact rootSubsetWeylGroup_preserves_pairing i ξ (fun α hα => hξ α hα.2) hw
  · exact mem_rootSubsetWeylGroup_roots_in_subspace_of_fixed_annihilator i hG hi W w

/-- Character displacements lying in a rational subspace force membership
in the Weyl subgroup of the roots in that subspace. -/
theorem mem_rootSubsetWeylGroup_roots_in_subspace_of_displacement_mem
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (W : Submodule ℚ (ℚ ⊗[ℤ] characterLattice T)) (w : relativeWeylGroup i)
    (hw : ∀ χ : characterLattice T,
      toRat (relativeWeylCharacterAction i w χ - χ) ∈ W) :
    w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ toRat α ∈ W} := by
  apply mem_rootSubsetWeylGroup_roots_in_subspace_of_fixed_annihilator i hG hi W w
  intro ξ hξ
  apply (hi.isSplitSubtorus.1.relativeWeylCocharacterAction_eq_self_iff_pairing i ξ w).mpr
  intro χ
  have h := hξ _ (hw χ)
  rw [map_sub, LinearMap.sub_apply] at h
  exact sub_eq_zero.mp h

/-- For a convex root subset, fixing all integral cocharacters that
annihilate its symmetric part forces membership in that part's Weyl subgroup. -/
theorem IsConvexRootSubset.mem_rootSubsetWeylGroup_parabolicRootLevi_of_fixed_annihilator
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    {X : Set (characterLattice T)} (hX : IsConvexRootSubset (relativeRoots i) X)
    (w : relativeWeylGroup i)
    (hw : ∀ ξ : cocharacterLattice T,
      (∀ β ∈ parabolicRootLevi X, latticePairing T β ξ = 0) →
        relativeWeylCocharacterAction i w ξ = ξ) :
    w ∈ rootSubsetWeylGroup i (parabolicRootLevi X) := by
  have hroot := relativeRootSystem k G hG T i hi
  have h := mem_rootSubsetWeylGroup_roots_in_subspace_of_fixed_annihilator i hG hi
    (symmetricRootRatSpan X) w (fun ξ hξ => hw ξ (fun β hβ => hξ β (toRat_mem_ratSpan hβ)))
  rwa [← hX.parabolicRootLevi_eq_roots_in_symmetricRootRatSpan
    (fun _ hα => hroot.neg_mem_relativeRoots i hi.isSplitSubtorus.1 hα)] at h

/-- Uniform identification of rational-subspace Weyl groups with the
pointwise stabilizers of their integral cocharacter annihilators. -/
def WeylSubspaceStabilizerStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ (W : Submodule ℚ (ℚ ⊗[ℤ] characterLattice T)) (w : relativeWeylGroup i),
      w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ toRat α ∈ W} ↔
        ∀ ξ : cocharacterLattice T,
          (∀ α : characterLattice T, toRat α ∈ W → latticePairing T α ξ = 0) →
            relativeWeylCocharacterAction i w ξ = ξ

/-- Finite zero-set detection and the actual cocharacter stabilizer
theorem prove the rational-subspace identification. -/
theorem weylSubspaceStabilizer : WeylSubspaceStabilizerStatement.{u} := by
  intro k _ G hG T i hi
  let := hG.isAffineHom
  let := hi.isSplitSubtorus.mono
  exact mem_rootSubsetWeylGroup_roots_in_subspace_iff_fixed_annihilator i hG hi

end Langlands.GroupScheme
