import Langlands.GroupScheme.Rational.A2OrbitInduction
import Langlands.GroupScheme.Rational.RootMapGaloisRationalPoints

/-! # Rational points of an `A₂` relative root group from induced piece triples

A piece triple `x_B(u) · x_m(w) · x_A(v)` at the base piece, fixed by the stabilizer of the base
piece, induces a Galois-fixed product of piece triples over all pieces. It descends to a rational
point of the relative root group of the restriction `a`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme.GaloisPointComparison Langlands.Geometry.Building

namespace Langlands.GroupScheme

namespace GaloisCompatiblePinningData

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  (D : GaloisCompatiblePinningData k K G)

attribute [local instance] rootIndexMulAction

local instance a2OrbitDescentAffine :
    IsAffineHom ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom (algebraBaseMap k K))
  infer_instance

variable {p₀ q₀ : D.pinning.base.support} {m₀ : D.pinning.rootIndex}
  (M : D.PairOrbit m₀ → D.pinning.SteinbergModifiedData)
  (hMx : ∀ (σ : K ≃ₐ[k] K) (c : D.PairOrbit m₀) (s : K),
    rationalConjugate k K G σ ((M c).xAlpha.rationalPoint s) =
      (M (σ • c)).xAlpha.rationalPoint (σ s))

/-- The rational point `x_b(c)` of a simple root map of the pinning. -/
abbrev simplePoint (b : D.pinning.base.support) (c : K) : rationalPoints (baseChanged k K G) :=
  (D.rootMaps b).toRootParametrization.rationalPoint c

variable (p₀ q₀) in
/-- The triple `x_B(u) · x_m(w) · x_A(v)` at the piece `c`. -/
def pieceTriple (c : D.PairOrbit m₀) (u w v : K) : rationalPoints (baseChanged k K G) :=
  D.simplePoint (D.pairB q₀ c) u * (M c).xAlpha.rationalPoint w * D.simplePoint (D.pairA p₀ c) v

include hMx in
/-- Transport of the base triple to the piece `c`. -/
theorem inducedPoint_pieceTriple (u w v : K) (c : D.PairOrbit m₀) :
    D.inducedPoint (D.pieceTriple p₀ q₀ M (D.basePair m₀) u w v) c =
      D.pieceTriple p₀ q₀ M c (D.transportElement c u) (D.transportElement c w)
        (D.transportElement c v) := by
  unfold inducedPoint pieceTriple simplePoint
  rw [map_mul, map_mul,
    SplitPinning.RootMapsGaloisCompatible.rationalPoint k K D.rootMaps_compatible,
    SplitPinning.RootMapsGaloisCompatible.rationalPoint k K D.rootMaps_compatible, hMx,
    D.action_transportElement_pairA, D.action_transportElement_pairB, D.transportElement_smul]

section Family

variable {S : CommGroupScheme (Spec (CommRingCat.of k))} (t : S ⟶ D.torus)
  (hm₀ : D.pinning.rootDatum.root m₀ =
    D.pinning.rootDatum.root (p₀ : D.pinning.rootIndex) +
      D.pinning.rootDatum.root (q₀ : D.pinning.rootIndex))
  (hS : IsSplitTorus S.toGrp) {a : characterLattice S}
  (hp₀ : D.restrictMap t ≫ D.pinning.rootDatum.root (p₀ : D.pinning.rootIndex) =
    characterLattice.baseChange (algebraBaseMap k K) S a)
  (hq₀ : D.restrictMap t ≫ D.pinning.rootDatum.root (q₀ : D.pinning.rootIndex) =
    characterLattice.baseChange (algebraBaseMap k K) S a)
  (hpq : p₀ ≠ q₀)
  (hline : RestrictsToMultipliableLine (D.restrictMap t) D.pinning.rootDatum
    (characterLattice.baseChange (algebraBaseMap k K) S a))
  (hM : ∀ c, (M c).a = D.pairA p₀ c ∧ (M c).b = D.pairB q₀ c)

/-- The triple at a piece lies in the subgroup generated by the root groups of that piece. -/
theorem pieceTriple_mem_pieceGroup (c : D.PairOrbit m₀) (u w v : K) :
    D.pieceTriple p₀ q₀ M c u w v ∈ pieceGroup D.pinning.inclusion D.pinning.rootDatum
      (D.pairA p₀ c : D.pinning.rootIndex) (D.pairB q₀ c : D.pinning.rootIndex) (M c).alpha := by
  have hmem : ∀ (χ : characterLattice D.pinning.torus), χ ∈ pieceRoots D.pinning.rootDatum
      (D.pairA p₀ c : D.pinning.rootIndex) (D.pairB q₀ c : D.pinning.rootIndex) (M c).alpha →
      ∀ y ∈ rootGroupPoints D.pinning.inclusion χ, y ∈ pieceGroup D.pinning.inclusion
        D.pinning.rootDatum (D.pairA p₀ c : D.pinning.rootIndex)
        (D.pairB q₀ c : D.pinning.rootIndex) (M c).alpha :=
    fun χ hχ y hy => mem_pieceGroup_of_mem D.pinning.inclusion hχ hy
  unfold pieceTriple simplePoint
  refine Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) ?_
  · exact hmem _ (by simp [pieceRoots]) _
      ((D.rootMaps (D.pairB q₀ c)).toRootParametrization.rationalPoint_mem u)
  · exact hmem _ (by simp [pieceRoots]) _ ((M c).xAlpha.rationalPoint_mem w)
  · exact hmem _ (by simp [pieceRoots]) _
      ((D.rootMaps (D.pairA p₀ c)).toRootParametrization.rationalPoint_mem v)

include hm₀ hS hp₀ hq₀ hpq hline hM hMx in
/-- Transports of a stabilizer-fixed base triple to distinct pieces commute. -/
theorem inducedPoint_pieceTriple_commute (u w v : K) {c c' : D.PairOrbit m₀} (hcc : c ≠ c') :
    Commute (D.inducedPoint (D.pieceTriple p₀ q₀ M (D.basePair m₀) u w v) c)
      (D.inducedPoint (D.pieceTriple p₀ q₀ M (D.basePair m₀) u w v) c') := by
  have : Smooth ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom :=
    D.pinning.isConnectedReductive.smooth
  rw [D.inducedPoint_pieceTriple M hMx, D.inducedPoint_pieceTriple M hMx]
  have hpc := D.isMultipliablePiece_pair t hm₀ hS hp₀ hq₀ hpq c
  have hpc' := D.isMultipliablePiece_pair t hm₀ hS hp₀ hq₀ hpq c'
  rw [← D.mergedAlpha_eq hm₀ M hM c] at hpc
  rw [← D.mergedAlpha_eq hm₀ M hM c'] at hpc'
  have hd : (D.pairA p₀ c' : D.pinning.rootIndex) ≠ D.pairA p₀ c ∧
      (D.pairA p₀ c' : D.pinning.rootIndex) ≠ D.pairB q₀ c ∧
      (D.pairB q₀ c' : D.pinning.rootIndex) ≠ D.pairA p₀ c ∧
      (D.pairB q₀ c' : D.pinning.rootIndex) ≠ D.pairB q₀ c := by
    refine ⟨fun h => hcc ?_, fun h => hcc ?_, fun h => hcc ?_, fun h => hcc ?_⟩
    · exact D.pair_eq_of_mem t hm₀ hS hp₀ hq₀ hpq hline (Or.inl rfl) (Or.inl h.symm)
    · exact D.pair_eq_of_mem t hm₀ hS hp₀ hq₀ hpq hline (Or.inr rfl) (Or.inl h.symm)
    · exact D.pair_eq_of_mem t hm₀ hS hp₀ hq₀ hpq hline (Or.inl rfl) (Or.inr h.symm)
    · exact D.pair_eq_of_mem t hm₀ hS hp₀ hq₀ hpq hline (Or.inr rfl) (Or.inr h.symm)
  exact commute_of_mem_pieceGroup D.pinning.inclusion
    (pieces_commute D.pinning.inclusion D.pinning.isSplitTorus D.pinning.isRootDatum hline
      hpc hpc' hd)
    (D.pieceTriple_mem_pieceGroup M c _ _ _) (D.pieceTriple_mem_pieceGroup M c' _ _ _)

section Descent

variable [Smooth G.X.hom] [LocallyOfFiniteType G.X.hom] [IsAffineHom D.torus.toGrp.X.hom]
  [LocallyOfFiniteType D.torus.toGrp.X.hom] [FiniteDimensional k K] [IsGalois k K]
  (hT : IsSplitTorus ((CommGroupScheme.baseChange (algebraBaseMap k K)).obj D.torus).toGrp)
  (hf : IsMaximalSplitTorus (CommGroupScheme.groupHom t ≫ D.inclusion))
  (hjc : IsClosedSubgroup D.inclusion)
  (hcent : (torusCentralizer (CommGroupScheme.groupHom t ≫ D.inclusion)).IsRepresentedBy
      D.inclusion)

include hMx in
/-- **Descent of an induced product of piece triples.** If the base triple
`x_B(u) x_m(w) x_A(v)` is fixed by the stabilizer of the base piece, the product of its
transports over all pieces is the scalar extension of a rational point of the relative root
group of `a`. -/
theorem exists_rootGroupPoint_pieceTriple (ha0 : a ≠ 0) (u w v : K)
    (hfix : ∀ g : K ≃ₐ[k] K, g • D.basePair m₀ = D.basePair m₀ →
      rationalConjugate k K G g (D.pieceTriple p₀ q₀ M (D.basePair m₀) u w v) =
        D.pieceTriple p₀ q₀ M (D.basePair m₀) u w v) :
    ∃ X ∈ rootGroupPoints (CommGroupScheme.groupHom t ≫ D.inclusion) a,
      rationalExtend k K G X =
        (D.a2PieceFamily t hm₀ hS hp₀ hq₀ hpq hline M hM hT hf hjc hcent).tripleProd
          (fun l => D.simplePoint (D.pairB q₀ (D.pieceEquiv m₀ l))
            (D.transportElement (D.pieceEquiv m₀ l) u))
          (fun l => (M (D.pieceEquiv m₀ l)).xAlpha.rationalPoint
            (D.transportElement (D.pieceEquiv m₀ l) w))
          (fun l => D.simplePoint (D.pairA p₀ (D.pieceEquiv m₀ l))
            (D.transportElement (D.pieceEquiv m₀ l) v)) := by
  have : Smooth ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom :=
    D.pinning.isConnectedReductive.smooth
  have : Mono D.pinning.inclusion.hom.hom.left := D.pinning.isMaximalTorus.2.1.mono
  have hE := splitPinnedOppositeFactorPairs K ((GroupScheme.baseChange (algebraBaseMap k K)).obj G)
    D.pinning
  have hSK : IsSplitTorus ((CommGroupScheme.baseChange (algebraBaseMap k K)).obj S).toGrp :=
    hS.baseChange (algebraBaseMap k K)
  have ha0K : characterLattice.baseChange (algebraBaseMap k K) S a ≠ 0 := by
    intro h
    apply ha0
    apply (characterLattice.baseChangeEquiv (algebraBaseMap k K) S hS).map_eq_zero_iff.mp
    rw [characterLattice.baseChangeEquiv_apply, h]
  set h₀ := D.pieceTriple p₀ q₀ M (D.basePair m₀) u w v with hh₀
  have hprod : (List.ofFn fun l => D.inducedPoint h₀ (D.pieceEquiv m₀ l)).prod =
      (D.a2PieceFamily t hm₀ hS hp₀ hq₀ hpq hline M hM hT hf hjc hcent).tripleProd
          (fun l => D.simplePoint (D.pairB q₀ (D.pieceEquiv m₀ l))
            (D.transportElement (D.pieceEquiv m₀ l) u))
          (fun l => (M (D.pieceEquiv m₀ l)).xAlpha.rationalPoint
            (D.transportElement (D.pieceEquiv m₀ l) w))
          (fun l => D.simplePoint (D.pairA p₀ (D.pieceEquiv m₀ l))
            (D.transportElement (D.pieceEquiv m₀ l) v)) := by
    unfold PieceFamily.tripleProd
    congr 1
    apply List.ofFn_inj.mpr
    funext l
    rw [hh₀, D.inducedPoint_pieceTriple M hMx]
    rfl
  rw [← hprod]
  have hfixed : ∀ σ : K ≃ₐ[k] K, rationalConjugate k K G σ
      (List.ofFn fun l => D.inducedPoint h₀ (D.pieceEquiv m₀ l)).prod =
      (List.ofFn fun l => D.inducedPoint h₀ (D.pieceEquiv m₀ l)).prod :=
    D.rationalConjugate_inducedProduct hfix (fun c c' hcc =>
      D.inducedPoint_pieceTriple_commute M hMx t hm₀ hS hp₀ hq₀ hpq hline hM u w v hcc)
  have hmem : (List.ofFn fun l => D.inducedPoint h₀ (D.pieceEquiv m₀ l)).prod ∈
      rootGroupPoints (S := (CommGroupScheme.baseChange (algebraBaseMap k K)).obj S)
        ((GroupScheme.baseChange (algebraBaseMap k K)).map
          (CommGroupScheme.groupHom t ≫ D.inclusion))
        (characterLattice.baseChange (algebraBaseMap k K) S a) := by
    rw [← D.groupHom_restrictMap_comp_inclusion t]
    apply Subgroup.list_prod_mem
    intro y hy
    obtain ⟨l, rfl⟩ := (List.mem_ofFn' _ _).mp hy
    simp only
    rw [hh₀, D.inducedPoint_pieceTriple M hMx]
    set c := D.pieceEquiv m₀ l
    have hle : ∀ (r : D.pinning.rootIndex) (n : ℕ), 0 < n →
        D.restrictMap t ≫ D.pinning.rootDatum.root r =
          n • characterLattice.baseChange (algebraBaseMap k K) S a →
        rootGroupPoints D.pinning.inclusion (D.pinning.rootDatum.root r) ≤
          rootGroupPoints (CommGroupScheme.groupHom (D.restrictMap t) ≫ D.pinning.inclusion)
            (characterLattice.baseChange (algebraBaseMap k K) S a) := fun r n hn hr =>
      rootGroupPoints_le_comp D.pinning.inclusion D.pinning.isSplitTorus hE hSK ha0K
        (D.pinning.root_mem_relativeRoots r) hn hr
    have hm : D.restrictMap t ≫ D.pinning.rootDatum.root (M c).alpha =
        2 • characterLattice.baseChange (algebraBaseMap k K) S a := by
      rw [D.mergedAlpha_eq hm₀ M hM, D.root_pair hm₀, Preadditive.comp_add,
        D.restrict_pairA t hS hp₀, D.restrict_pairB t hS hq₀, two_nsmul]
    unfold pieceTriple simplePoint
    refine Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) ?_
    · exact hle _ 1 one_pos (by rw [D.restrict_pairB t hS hq₀, one_smul])
        ((D.rootMaps _).toRootParametrization.rationalPoint_mem _)
    · exact hle _ 2 two_pos hm ((M c).xAlpha.rationalPoint_mem _)
    · exact hle _ 1 one_pos (by rw [D.restrict_pairA t hS hp₀, one_smul])
        ((D.rootMaps _).toRootParametrization.rationalPoint_mem _)
  obtain ⟨X, hX, hXe⟩ := exists_mem_rootGroupPoints_of_fixed k K
    (CommGroupScheme.groupHom t ≫ D.inclusion) hS a ha0 hfixed hmem
  exact ⟨X, hX, hXe⟩

end Descent

end Family

end GaloisCompatiblePinningData

end Langlands.GroupScheme
