import Langlands.GroupScheme.Rational.RootSubgroupConjugation
import Langlands.GroupScheme.Rational.DynamicRadicalRootGeneration
import Langlands.GroupScheme.Rational.SimplyConnectedCentralizerProductReduction
import Langlands.GroupScheme.Rational.RootRayFromFactorPairs

/-! # The subgroup generated by actual relative-root points -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

open RelativeRoot

variable {k : Type u} [Field k]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  (i : S.toGrp ⟶ G)

/-- The abstract subgroup of rational points generated by all actual
relative-root subgroup functors at the specified torus. -/
def relativeRootGeneratedSubgroup : Subgroup (rationalPoints G) :=
  Subgroup.closure (⋃ α ∈ relativeRoots i,
    ((RelativeRoot.subgroup i α).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)))

/-- Every actual relative-root point lies in the generated subgroup. -/
theorem relativeRoot_subgroup_le_generated {α : characterLattice S}
    (hα : α ∈ relativeRoots i) :
    (RelativeRoot.subgroup i α).carrier (Over.mk (𝟙 _)) ≤
      relativeRootGeneratedSubgroup i := by
  intro g hg
  exact Subgroup.subset_closure (Set.mem_iUnion.mpr
    ⟨α, Set.mem_iUnion.mpr ⟨hα, hg⟩⟩)

/-- Containment of the generated subgroup is equivalent to containment of
every actual relative-root group. -/
theorem relativeRootGeneratedSubgroup_le_iff (K : Subgroup (rationalPoints G)) :
    relativeRootGeneratedSubgroup i ≤ K ↔
      ∀ α ∈ relativeRoots i,
        (RelativeRoot.subgroup i α).carrier (Over.mk (𝟙 _)) ≤ K := by
  rw [relativeRootGeneratedSubgroup, Subgroup.closure_le]
  simp only [Set.iUnion_subset_iff]
  rfl

variable [Mono i.hom.hom.left]

/-- Rational normalizer points normalize the subgroup generated by all
relative-root groups. This requires neither Bruhat covering nor root-pair
existence. -/
theorem normalizerPoints_le_normalizer_relativeRootGeneratedSubgroup :
    normalizerPoints i ≤
      Subgroup.normalizer (relativeRootGeneratedSubgroup i : Set (rationalPoints G)) := by
  rw [relativeRootGeneratedSubgroup, Subgroup.le_normalizer_closure_iff]
  intro n hn g hg
  obtain ⟨α, hg⟩ := Set.mem_iUnion.mp hg
  obtain ⟨hα, hg⟩ := Set.mem_iUnion.mp hg
  have hconj := RelativeRoot.normalizer_conj_mem i α ⟨n, hn⟩ hg
  have hroot := weylAction_mapsTo_relativeRoots i ⟨n, hn⟩ hα
  apply relativeRoot_subgroup_le_generated i hroot
  simpa only [constantPoint_self] using hconj

/-- The whole-torus centralizer normalizes the root-generated subgroup. -/
theorem centralizerPoints_le_normalizer_relativeRootGeneratedSubgroup :
    centralizerPoints i ≤
      Subgroup.normalizer (relativeRootGeneratedSubgroup i : Set (rationalPoints G)) :=
  (centralizerPoints_le_normalizerPoints i).trans
    (normalizerPoints_le_normalizer_relativeRootGeneratedSubgroup i)

omit [Mono i.hom.hom.left] in
/-- Disjoint positive root rays put the full dynamic radical in the subgroup
generated by actual relative-root points. -/
theorem dynamicUnipotent_le_relativeRootGeneratedSubgroup
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (ν : cocharacterLattice S)
    (hdisj : ∀ a ∈ indivisiblePositiveRoots i ν,
      ∀ b ∈ indivisiblePositiveRoots i ν, a ≠ b →
        Disjoint (RelativeRoot.cyclicTail a 1 : Set (characterLattice S))
          (RelativeRoot.cyclicTail b 1 : Set (characterLattice S))) :
    (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i)).carrier (Over.mk (𝟙 _)) ≤
      relativeRootGeneratedSubgroup i :=
  RelativeRoot.dynamicUnipotent_le_of_disjoint_positive_rays hG hi ν hdisj _
    (fun α => relativeRoot_subgroup_le_generated i α.property)

/-- Bruhat covering and dynamic-radical containment imply normality of the
root-generated subgroup. Equality of the generic and whole-torus centralizers
is retained as a local hypothesis. -/
theorem relativeRootGeneratedSubgroup_normal_of_bruhat
    (ν : cocharacterLattice S)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) = torusCentralizer i)
    (hBr : HasRationalBruhatDecomposition i ν)
    (hU : RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i) ≤
      relativeRootGeneratedSubgroup i) :
    (relativeRootGeneratedSubgroup i).Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  intro g _
  obtain ⟨a, b, n, z, rfl⟩ :=
    exists_unipotent_normalizer_unipotent_centralizer_mul i ν hZ hBr g
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _
      (Subgroup.mul_mem _ (Subgroup.le_normalizer (hU a.property))
        (normalizerPoints_le_normalizer_relativeRootGeneratedSubgroup i n.property))
      (Subgroup.le_normalizer (hU b.property)))
    (centralizerPoints_le_normalizer_relativeRootGeneratedSubgroup i z.property)

/-- For a reductive group, genericity supplies the centralizer equality. The
remaining local inputs are actual rational Bruhat covering and disjoint
positive root rays. -/
theorem relativeRootGeneratedSubgroup_normal_of_bruhat_of_disjoint_positive_rays
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (ν : cocharacterLattice S) (hν : IsGenericCocharacter i ν)
    (hBr : HasRationalBruhatDecomposition i ν)
    (hdisj : ∀ a ∈ indivisiblePositiveRoots i ν,
      ∀ b ∈ indivisiblePositiveRoots i ν, a ≠ b →
        Disjoint (RelativeRoot.cyclicTail a 1 : Set (characterLattice S))
          (RelativeRoot.cyclicTail b 1 : Set (characterLattice S))) :
    (relativeRootGeneratedSubgroup i).Normal :=
  relativeRootGeneratedSubgroup_normal_of_bruhat i ν
    (genericCentralizer k G hG S i hi ν hν) hBr
    (dynamicUnipotent_le_relativeRootGeneratedSubgroup i hG hi ν hdisj)

/-- Actual opposite factor pairs supply the disjoint rays needed above.
Their existence and rational Bruhat covering remain explicit premises. -/
theorem relativeRootGeneratedSubgroup_normal_of_bruhat_of_oppositeFactorPairs
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (ν : cocharacterLattice S) (hν : IsGenericCocharacter i ν)
    (hBr : HasRationalBruhatDecomposition i ν)
    (hE : RelativeRoot.HasOppositeFactorPairs i) :
    (relativeRootGeneratedSubgroup i).Normal := by
  let := hG.smooth
  apply relativeRootGeneratedSubgroup_normal_of_bruhat_of_disjoint_positive_rays
    i hG hi ν hν hBr
  intro a ha b hb hne
  exact hE.disjoint_cyclicTail_indivisibleRoots i hi.isSplitSubtorus.1
    ha.1 hb.1 hne

end Langlands.GroupScheme
