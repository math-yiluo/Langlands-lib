import Langlands.GroupScheme.Reductive.SplitPinnedOppositeFactorPairs
import Langlands.GroupScheme.Rational.SteinbergModifiedRootProduct
import Langlands.GroupScheme.Rational.SteinbergOrthogonalFactors

/-! # Simple-reflection representatives determined by normalized root coordinates -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.SplitPinning

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000
set_option autoImplicit false

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    {p : SplitPinning G}

local instance : IsClosedImmersion p.inclusion.hom.hom.left := p.isMaximalTorus.2.1

namespace NormalizedRootParametrization

variable {a : p.base.support} (x : p.NormalizedRootParametrization a)

/-- The actual rational root point with normalized coordinate one. -/
def unitPoint : rationalPoints G :=
  x.toRootParametrization.rationalPoint 1

theorem unitPoint_eq : x.unitPoint = x.point (Over.mk (𝟙 _)) 1 := by
  simp only [unitPoint, RootParametrization.rationalPoint, map_one]
  rfl

theorem unitPoint_mem :
    x.unitPoint ∈
      (RelativeRoot.subgroup p.inclusion (p.rootDatum.root a)).carrier (Over.mk (𝟙 _)) :=
  (x.mem_rootSubgroup_iff _ _).mpr ⟨1, x.unitPoint_eq.symm⟩

theorem unitPoint_ne_one : x.unitPoint ≠ 1 :=
  x.toRootParametrization.rationalPoint_ne_one one_ne_zero

/-- The ordered opposite pair around the actual normalized root point at one.
The pair is unique, so the choice introduces no further point-level freedom. -/
def oppositeFactorPair : rationalPoints G × rationalPoints G :=
  Classical.choose (splitPinnedOppositeFactorPairs k G p (p.rootDatum.root a)
    (p.root_mem_relativeRoots a) x.unitPoint x.unitPoint_mem x.unitPoint_ne_one)

theorem oppositeFactorPair_spec :
    RelativeRoot.IsOppositeFactorPair p.inclusion (p.rootDatum.root a)
      x.unitPoint x.oppositeFactorPair :=
  Classical.choose_spec (splitPinnedOppositeFactorPairs k G p (p.rootDatum.root a)
    (p.root_mem_relativeRoots a) x.unitPoint x.unitPoint_mem x.unitPoint_ne_one)

/-- Every ordered normalizing opposite pair around the same normalized
root point is the chosen pair. -/
theorem eq_oppositeFactorPair {q : rationalPoints G × rationalPoints G}
    (hq : RelativeRoot.IsOppositeFactorPair p.inclusion (p.rootDatum.root a)
      x.unitPoint q) : q = x.oppositeFactorPair :=
  hq.eq p.inclusion p.isSplitTorus (p.root_mem_relativeRoots a).1
    x.unitPoint_mem x.unitPoint_ne_one x.oppositeFactorPair_spec

/-- The actual opposite-root triple, with its induced torus automorphism and
the exact reflection on the entire pinned character lattice. -/
def reflectionRepresentative : p.SimpleReflectionRepresentative a :=
  let n : normalizerPoints p.inclusion :=
    ⟨x.oppositeFactorPair.1 * x.unitPoint * x.oppositeFactorPair.2,
      x.oppositeFactorPair_spec.2.2⟩
  { point := n.val
    torusAut := normalizingAut p.inclusion n
    normalizes := isNormalizingPoint_normalizingAut p.inclusion n
    characterAut_eq := p.oppositeFactorPair_weylAction a
      x.unitPoint_mem x.unitPoint_ne_one x.oppositeFactorPair_spec }

theorem reflectionRepresentative_point :
    x.reflectionRepresentative.point =
      x.oppositeFactorPair.1 * x.unitPoint * x.oppositeFactorPair.2 := rfl

/-- The actual reflection point belongs to the group generated by the
positive and negative intrinsic root groups. -/
theorem reflectionRepresentative_mem_generated :
    x.reflectionRepresentative.point ∈
      (RelativeRoot.subgroup p.inclusion (p.rootDatum.root a)).carrier (Over.mk (𝟙 _)) ⊔
        (RelativeRoot.subgroup p.inclusion (-(p.rootDatum.root a))).carrier
          (Over.mk (𝟙 _)) := by
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _
      (Subgroup.mem_sup_right x.oppositeFactorPair_spec.1)
      (Subgroup.mem_sup_left x.unitPoint_mem))
    (Subgroup.mem_sup_right x.oppositeFactorPair_spec.2.1)

end NormalizedRootParametrization

/-- Simple-reflection representatives determined by the supplied normalized
root maps, using the unique opposite pairs at coordinate one. -/
def canonicalSimpleReflectionRepresentatives
    (x : p.NormalizedSimpleRootParametrizations) : p.SimpleReflectionRepresentatives :=
  fun a => (x a).reflectionRepresentative

/-- The canonical family satisfies the root-generated condition used by the
actual-factor commutation and image-descent constructions. -/
theorem rootGenerated_canonicalSimpleReflectionRepresentatives
    (x : p.NormalizedSimpleRootParametrizations) :
    p.RootGeneratedSimpleReflectionRepresentatives
      (canonicalSimpleReflectionRepresentatives x) :=
  fun a => (x a).reflectionRepresentative_mem_generated

/-- The factors formed with the canonical family commute on every test
for distinct orthogonal members of the supplied simple-root base. -/
theorem commute_canonicalRootFactors
    (x : p.NormalizedSimpleRootParametrizations)
    (a b : p.base.support) (hab : a ≠ b) (ho : p.rootDatum.IsOrthogonal a b)
    (T : Over (Spec (CommRingCat.of k))) (c d : Γ(T.left, ⊤)) :
    Commute
      ((x a).point T c * (toUnit T ≫ (canonicalSimpleReflectionRepresentatives x a).point))
      ((x b).point T d * (toUnit T ≫ (canonicalSimpleReflectionRepresentatives x b).point)) :=
  p.commute_rootFactors x (canonicalSimpleReflectionRepresentatives x)
    (rootGenerated_canonicalSimpleReflectionRepresentatives x) a b hab ho T c d

end Langlands.GroupScheme.SplitPinning
