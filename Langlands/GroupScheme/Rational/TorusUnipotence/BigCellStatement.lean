import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.RingTheory.Noetherian.Defs

/-! # Graded big-cell injectivity for augmented coordinate algebras -/

noncomputable section

universe u

open TensorProduct

namespace Langlands.GroupScheme.TorusUnipotence

variable {k : Type u} [Field k] {A : Type u} [CommRing A] [Algebra k A]

/-- The ideal generated by all negative-degree elements and the degree-zero augmentation
elements. Its quotient is the coordinate ring of the positive big-cell factor. -/
def plusIdeal (𝒜 : ℤ → Submodule k A) (ε : A →ₐ[k] k) : Ideal A :=
  Ideal.span ({a | ∃ d < 0, a ∈ 𝒜 d} ∪ {a | a ∈ 𝒜 0 ∧ ε a = 0})

/-- The ideal generated by all positive-degree elements and the degree-zero augmentation
elements. -/
def minusIdeal (𝒜 : ℤ → Submodule k A) (ε : A →ₐ[k] k) : Ideal A :=
  Ideal.span ({a | ∃ d > 0, a ∈ 𝒜 d} ∪ {a | a ∈ 𝒜 0 ∧ ε a = 0})

/-- The comultiplication followed by the two signed quotient maps. -/
def bigCellMap (𝒜 : ℤ → Submodule k A) (ε : A →ₐ[k] k) (Δ : A →ₐ[k] A ⊗[k] A) :
    A →ₐ[k] (A ⧸ minusIdeal 𝒜 ε) ⊗[k] (A ⧸ plusIdeal 𝒜 ε) :=
  (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k (minusIdeal 𝒜 ε))
    (Ideal.Quotient.mkₐ k (plusIdeal 𝒜 ε))).comp Δ

/-- For a formally smooth Noetherian domain with a `ℤ`-grading, an augmentation vanishing in
nonzero degrees and a comultiplication satisfying both counit laws, if the degree-zero part of
the augmentation ideal lies in its square, then the comultiplication followed by the two signed
quotients is injective. -/
def GradedBigCellInjectivityStatement : Prop :=
  ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A] [IsDomain A]
    [IsNoetherianRing A] [Algebra.FormallySmooth k A]
    (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜] (ε : A →ₐ[k] k) (Δ : A →ₐ[k] A ⊗[k] A),
    (∀ d : ℤ, d ≠ 0 → ∀ a ∈ 𝒜 d, ε a = 0) →
    (Algebra.TensorProduct.lid k A).toAlgHom.comp
      ((Algebra.TensorProduct.map ε (AlgHom.id k A)).comp Δ) = AlgHom.id k A →
    (Algebra.TensorProduct.rid k k A).toAlgHom.comp
      ((Algebra.TensorProduct.map (AlgHom.id k A) ε).comp Δ) = AlgHom.id k A →
    (∀ a ∈ 𝒜 0, ε a = 0 → a ∈ (RingHom.ker ε) ^ 2) →
    Function.Injective (bigCellMap 𝒜 ε Δ)

end Langlands.GroupScheme.TorusUnipotence
