import Langlands.GroupScheme.Rational.RelativeCentralDirections
import Langlands.GroupScheme.Rational.RootReflectionAssembly
import Langlands.GroupScheme.Rational.StandardParabolic
import Mathlib.Geometry.Convex.Cone.Pointed
import Mathlib.LinearAlgebra.BilinearForm.Basic

/-! # Ambient realizations of the cones of Langlands' combinatorial lemma (Renard V.3.13–V.3.18)

Inside the real character space `𝔞*_∅ = Vstar T` of a maximal split torus, with integral
reflection data `D` supplying the coroots: the coroot annihilator `𝔞*_M` of a set `J` of simple
roots, the open and closed coroot faces in the root span, the nonnegative cones of roots
projected to `𝔞*_M`, the predicate (V.3.18.1), and the source hypothesis on the inner product.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct

namespace Langlands.GroupScheme

open RealTorusSpace

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  (i : T.toGrp ⟶ G) [Mono i.hom.hom.left] (ν : cocharacterLattice T)
  (D : RelativeRootReflectionData i)

/-- Renard V.3.13, `𝔞*_M ⊂ 𝔞*_∅`: the real characters `y` of `T` with `⟨y, α̌⟩ = 0` for every
root `α ∈ J`, the coroots `α̌` being those of `D`. -/
def corootAnnihilator (J : Set (characterLattice T)) : Submodule ℝ (Vstar T) :=
  ⨅ (α : relativeRoots i) (_ : α.1 ∈ J),
    LinearMap.ker ((pair T).flip ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α))

@[simp] theorem mem_corootAnnihilator (J : Set (characterLattice T)) (y : Vstar T) :
    y ∈ corootAnnihilator i D J ↔
      ∀ α : relativeRoots i, α.1 ∈ J → pair T y ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0 := by
  simp [corootAnnihilator]

/-- Renard V.3.16, `^G_Q[(𝔞^G_L)^*]^+` realized in `𝔞*_∅`: the vectors of the actual real root
span with `⟨y, α̌⟩ = 0` for `α ∈ K` and `⟨y, α̌⟩ > 0` for every simple root `α ∉ K`. -/
def openCorootFace (K : Set (characterLattice T)) : Set (Vstar T) :=
  {y | y ∈ relativeRootSpanReal i ∧
    (∀ α : relativeRoots i, α.1 ∈ K → pair T y ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0) ∧
    (∀ α : relativeRoots i, α.1 ∈ simpleRelativeRoots i ν → α.1 ∉ K →
      0 < pair T y ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α))}

/-- Renard V.3.16, the closure of `^G_P[(𝔞^G_M)^*]^+` realized in `𝔞*_∅`: the same conditions
with `⟨y, α̌⟩ ≥ 0` for every simple root `α ∉ J`. -/
def closedCorootFace (J : Set (characterLattice T)) : Set (Vstar T) :=
  {y | y ∈ relativeRootSpanReal i ∧
    (∀ α : relativeRoots i, α.1 ∈ J → pair T y ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α) = 0) ∧
    (∀ α : relativeRoots i, α.1 ∈ simpleRelativeRoots i ν → α.1 ∉ J →
      0 ≤ pair T y ((1 : ℝ) ⊗ₜ[ℤ] D.coroot α))}

/-- The closed convex cone in `𝔞*_M ⊂ 𝔞*_∅` generated by the projections to `𝔞*_M` of the
roots in `S`: the vectors of `𝔞*_M` congruent, modulo the real span of `J`, to a nonnegative
combination of roots in `S`. For `S = Δ_∅ ∖ J` it realizes the closure of `⁺[𝔞*_M]^G_P`. -/
def projectedRootNonnegCone (J S : Set (characterLattice T)) : Set (Vstar T) :=
  {y | y ∈ corootAnnihilator i D J ∧
    ∃ z ∈ PointedCone.hull ℝ ((fun α : characterLattice T => (1 : ℝ) ⊗ₜ[ℤ] α) '' S),
      y - z ∈ Submodule.span ℝ ((fun α : characterLattice T => (1 : ℝ) ⊗ₜ[ℤ] α) '' J)}

/-- Renard V.3.7, the inner product on `𝔞*_∅`: a symmetric positive definite real bilinear
form on the full real character space, invariant under the actual relative Weyl group. -/
def IsWeylInvariantInnerProduct (B : LinearMap.BilinForm ℝ (Vstar T)) : Prop :=
  (∀ x y : Vstar T, B x y = B y x) ∧ (∀ x : Vstar T, x ≠ 0 → 0 < B x x) ∧
    ∀ (w : relativeWeylGroup i) (x y : Vstar T),
      B (relativeWeylFullRealAction i w x) (relativeWeylFullRealAction i w y) = B x y

/-- Renard (V.3.18.1), corrected as in the V.5.5 proof: `K` is the simple-root index of a
standard parabolic `Q ⊇ P`, and `μ = μ_G + μ⁺ + μ⁻` with `μ_G` in the actual `𝔞*_G` (restrictions
of real rational characters of `G`), `μ⁺` in the open coroot face of `Q`, and `-μ⁻` in the
nonnegative cone of the roots of `K ∖ J` projected to `𝔞*_M`. -/
def IsLanglandsDecomposition (J : Set (characterLattice T)) (μ : Vstar T)
    (K : Set (characterLattice T)) (μG μp μm : Vstar T) : Prop :=
  J ⊆ K ∧ K ⊆ simpleRelativeRoots i ν ∧ μ = μG + μp + μm ∧
    μG ∈ LinearMap.range (rationalCharacterRestrictReal i) ∧
    μp ∈ openCorootFace i ν D K ∧
    -μm ∈ projectedRootNonnegCone i D J (K \ J)

end Langlands.GroupScheme
