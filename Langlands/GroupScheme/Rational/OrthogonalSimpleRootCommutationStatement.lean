import Langlands.GroupScheme.Reductive.Pinning
import Langlands.GroupScheme.Rational.RootSubgroup

/-! # Commutation for the point subgroups generated by orthogonal simple roots -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- The two point subgroups generated by the positive and negative root groups
of distinct orthogonal simple roots commute on every scheme test. -/
def OrthogonalSimpleRootCommutationStatement : Prop :=
  ∀ (k : Type u) [Field k]
    (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom]
    (p : SplitPinning G) (a b : p.base.support),
    a ≠ b → p.rootDatum.IsOrthogonal a b →
    ∀ (Z : Over (Spec (CommRingCat.of k))) (x y : Z ⟶ G.X),
      x ∈ (RelativeRoot.subgroup p.inclusion (p.rootDatum.root a)).carrier Z ⊔
        (RelativeRoot.subgroup p.inclusion (-(p.rootDatum.root a))).carrier Z →
      y ∈ (RelativeRoot.subgroup p.inclusion (p.rootDatum.root b)).carrier Z ⊔
        (RelativeRoot.subgroup p.inclusion (-(p.rootDatum.root b))).carrier Z →
      Commute x y

end Langlands.GroupScheme
