import Langlands.GroupScheme.Rational.MaximalSplitGeneratedMultiplicity
import Langlands.GroupScheme.Rational.MaximalSplitGeneratedWeyl

/-! # Reductivity of a group generated by rank-one line pairs -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise

set_option backward.isDefEq.respectTransparency false

namespace Langlands.GroupScheme.MaximalSplitSubgroup

open VectorGroup RootCell RelativeRoot

section Swap

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {H : GroupScheme (Spec (CommRingCat.of k))}

/-- The coordinate of the inverse of a point of `Ga` is the negated coordinate. -/
theorem crd_inv {Z : Over (Spec (CommRingCat.of k))} (b : Z ⟶ (Ga k).X) : crd b⁻¹ = -crd b := by
  show (VectorGroup.coordinates (CommRingCat.of k) 1 Z b⁻¹).toAdd 0 =
    -(VectorGroup.coordinates (CommRingCat.of k) 1 Z b).toAdd 0
  rw [map_inv, toAdd_inv, Pi.neg_apply]

/-- The point of `Ga` with the negated coordinate is the inverse. -/
theorem pt_neg_crd {Z : Over (Spec (CommRingCat.of k))} (b : Z ⟶ (Ga k).X) :
    pt (-crd b) = b⁻¹ :=
  crd_injective (by rw [crd_pt, crd_inv])

/-- The torus point of the opposite cocharacter is the inverse. -/
theorem coU_neg (t : T.toGrp ⟶ H) (ν : cocharacterLattice T) {Z : Over (Spec (CommRingCat.of k))}
    (u : Γ(Z.left, ⊤)ˣ) :
    (Gm.pointsEquiv _ Z).symm u ≫ (CommGroupScheme.groupHom (-ν)).hom.hom ≫ t.hom.hom =
      ((Gm.pointsEquiv _ Z).symm u ≫ (CommGroupScheme.groupHom ν).hom.hom ≫ t.hom.hom)⁻¹ := by
  have h1 : (CommGroupScheme.groupHom (-ν)).hom.hom = (CommGroupScheme.groupHom ν).hom.hom⁻¹ :=
    rfl
  rw [h1, ← Category.assoc, GrpObj.comp_inv, GrpObj.inv_comp, Category.assoc]

/-- **The rank-one relation with the roles of the lines exchanged.** If
`x(X) y(Y) = y(Y') ν(u) x(X')` holds over `Z`, then so does `y(X) x(Y) = x(Y') ν(u)⁻¹ y(X')`. -/
theorem relationOver_swap {t : T.toGrp ⟶ H} {ν : cocharacterLattice T} {x y : Ga k ⟶ H}
    {Z : Over (Spec (CommRingCat.of k))} (h : RelationOver t ν x y Z) :
    RelationOver t (-ν) y x Z := by
  intro a b a' b' u hu ha' hb'
  have key := h (pt (-crd b)) (pt (-crd a)) (pt (-crd b')) (pt (-crd a')) u
    (by rw [crd_pt, crd_pt, hu]; ring) (by rw [crd_pt, crd_pt, hb']; ring)
    (by rw [crd_pt, crd_pt, ha']; ring)
  rw [RelationAt, pt_neg_crd, pt_neg_crd, pt_neg_crd, pt_neg_crd, GrpObj.inv_comp,
    GrpObj.inv_comp, GrpObj.inv_comp, GrpObj.inv_comp] at key
  have key' := congrArg (·⁻¹) key
  simp only [mul_inv_rev, inv_inv, mul_assoc] at key'
  rw [RelationAt, coU_neg, key', mul_assoc]

end Swap

section Cone

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}

/-- The cone of the negated family is the negated cone. -/
theorem neg_mem_cone_of_mem_cone_neg {Idx : Type*} {a : Idx → characterLattice T}
    {χ : characterLattice T} (h : χ ∈ cone fun i => -a i) : -χ ∈ cone a := by
  induction h using AddSubsemigroup.closure_induction with
  | mem χ hχ =>
    obtain ⟨i, rfl⟩ := hχ
    rw [neg_neg]
    exact AddSubsemigroup.subset_closure ⟨i, rfl⟩
  | add χ ψ _ _ hχ hψ =>
    rw [neg_add]
    exact add_mem hχ hψ

/-- The characters of the family `a` lie in the reflection closure: every character in `Φ'`
satisfies each predicate that holds at every `a i` and is stable under each reflection
`χ ↦ χ - ⟨χ, ν i⟩ a i`. -/
def LiesInReflectionClosure {Idx : Type*} (a : Idx → characterLattice T)
    (ν : Idx → cocharacterLattice T) (Φ' : Set (characterLattice T)) : Prop :=
  ∀ P : characterLattice T → Prop, (∀ i, P (a i)) →
    (∀ i χ, P χ → P (χ - latticePairing T χ (ν i) • a i)) → ∀ χ ∈ Φ', P χ

end Cone

section Reductive

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {H : GroupScheme (Spec (CommRingCat.of k))}

/-- **Negative roots lie in the negative cone.** Under the hypotheses of
`mem_cone_of_mem_relativeRoots`, every root pairing negatively with `cch` is the negative of an
element of the cone of the `a i`. -/
theorem neg_mem_cone_of_mem_roots [IsAlgClosed k] [Smooth H.X.hom] [IsAffineHom H.X.hom]
    (hT : IsSplitTorus T.toGrp) {Idx : Type*}
    (t : T.toGrp ⟶ H) (a : Idx → characterLattice T) (ν : Idx → cocharacterLattice T)
    (x y : Idx → (Ga k ⟶ H))
    (hx : ∀ i, IsTorusEquivariant t (x i) (a i)) (hy : ∀ i, IsTorusEquivariant t (y i) (-a i))
    (hrel : ∀ i, RelationOver t (ν i) (x i) (y i) (Over.mk (𝟙 (Spec (CommRingCat.of k)))))
    (hcomm : ∀ i j, i ≠ j → ∀ g ∈ rangePts (x i), ∀ h ∈ rangePts (y j), Commute g h)
    (hgen : Dense (rationalPointImage H (Subgroup.closure
      ((⋃ i, (rangePts (x i) : Set (rationalPoints H))) ∪ (⋃ i, (rangePts (y i) : Set (rationalPoints H))) ∪
        (rangePts t : Set (rationalPoints H))) : Set (rationalPoints H))))
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch)
    (ht : IsClosedSubgroup t) {χ : characterLattice T} (hχ : χ ∈ roots t)
    (hχneg : latticePairing T χ cch < 0) : -χ ∈ cone a := by
  refine neg_mem_cone_of_mem_cone_neg (mem_cone_of_mem_relativeRoots hT t (fun i => -a i)
    (fun i => -ν i) y x hy (fun i => ?_) (fun i => relationOver_swap (hrel i)) ?_ ?_ (-cch) (fun i => ?_) ht
    ((relativeRoots_eq_roots t).symm ▸ hχ) ?_)
  · show IsTorusEquivariant t (x i) (-(-a i))
    rw [neg_neg]
    exact hx i
  · intro i j hij g hg h hh
    exact (hcomm j i (Ne.symm hij) h hh g hg).symm
  · rw [Set.union_comm (⋃ i, (rangePts (y i) : Set (rationalPoints H)))]
    exact hgen
  · show 0 < latticePairing T (-a i) (-cch)
    simp only [map_neg, LinearMap.neg_apply, neg_neg]
    exact hpos i
  · rw [map_neg]
    exact neg_pos.mpr hχneg

/-- A root with a generic cocharacter lies in the cone of the `a i` or in its negative. -/
theorem mem_cone_or_neg_mem_cone_of_mem_roots [IsAlgClosed k] [Smooth H.X.hom]
    [IsAffineHom H.X.hom]
    (hT : IsSplitTorus T.toGrp) {Idx : Type*}
    (t : T.toGrp ⟶ H) (a : Idx → characterLattice T) (ν : Idx → cocharacterLattice T)
    (x y : Idx → (Ga k ⟶ H))
    (hx : ∀ i, IsTorusEquivariant t (x i) (a i)) (hy : ∀ i, IsTorusEquivariant t (y i) (-a i))
    (hrel : ∀ i, RelationOver t (ν i) (x i) (y i) (Over.mk (𝟙 (Spec (CommRingCat.of k)))))
    (hcomm : ∀ i j, i ≠ j → ∀ g ∈ rangePts (x i), ∀ h ∈ rangePts (y j), Commute g h)
    (hgen : Dense (rationalPointImage H (Subgroup.closure
      ((⋃ i, (rangePts (x i) : Set (rationalPoints H))) ∪ (⋃ i, (rangePts (y i) : Set (rationalPoints H))) ∪
        (rangePts t : Set (rationalPoints H))) : Set (rationalPoints H))))
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch)
    (ht : IsClosedSubgroup t) {χ : characterLattice T} (hχ : χ ∈ roots t)
    (hgeneric : latticePairing T χ cch ≠ 0) : χ ∈ cone a ∨ -χ ∈ cone a := by
  rcases hgeneric.lt_or_gt with hneg | hpos'
  · exact Or.inr (neg_mem_cone_of_mem_roots hT t a ν x y hx hy hrel hcomm hgen cch hpos ht hχ
      hneg)
  · exact Or.inl (mem_cone_of_mem_relativeRoots hT t a ν x y hx hy hrel hcomm hgen cch hpos ht
      ((relativeRoots_eq_roots t).symm ▸ hχ) hpos')

/-- Each line weight carries the rootwise datum: it is a root with a one-dimensional weight
space and a Weyl inversion. -/
theorem isWeylLineRoot_line [IsAlgClosed k] [Smooth H.X.hom] [IsAffineHom H.X.hom]
    (hT : IsSplitTorus T.toGrp) {Idx : Type*}
    (t : T.toGrp ⟶ H) (a : Idx → characterLattice T) (ν : Idx → cocharacterLattice T)
    (x y : Idx → (Ga k ⟶ H))
    (hx : ∀ i, IsTorusEquivariant t (x i) (a i)) (hy : ∀ i, IsTorusEquivariant t (y i) (-a i))
    (hrel : ∀ i, RelationOver t (ν i) (x i) (y i) (Over.mk (𝟙 (Spec (CommRingCat.of k)))))
    (hcomm : ∀ i j, i ≠ j → ∀ g ∈ rangePts (x i), ∀ h ∈ rangePts (y j), Commute g h)
    (hgen : Dense (rationalPointImage H (Subgroup.closure
      ((⋃ i, (rangePts (x i) : Set (rationalPoints H))) ∪ (⋃ i, (rangePts (y i) : Set (rationalPoints H))) ∪
        (rangePts t : Set (rationalPoints H))) : Set (rationalPoints H))))
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch)
    (ht : IsClosedSubgroup t) (i : Idx) (eta : cocharacterLattice T)
    (heta : IsIsolatingCocharacter a i eta) [Mono (x i).hom.hom]
    (hpair : latticePairing T (a i) (ν i) = 2)
    {n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X}
    (hn : IsNormalizingPoint t n (latticeReflectionIso (a i) (ν i) hpair)) :
    IsWeylLineRoot t (a i) := by
  have hfin := finrank_weightSpace_eq_one hT t a ν x y hx hy hrel hcomm hgen cch hpos ht i eta
    heta
  refine ⟨mem_roots.mpr ⟨fun h0 => ?_, fun hbot => ?_⟩, hfin,
    hasWeylInversion_of_reflection hpair hn⟩
  · have := hpos i
    rw [h0, map_zero, LinearMap.zero_apply] at this
    exact lt_irrefl _ this
  · rw [hbot, finrank_bot] at hfin
    exact zero_ne_one hfin

/-- **Reductivity of the generated group** (CGP C.2.29(iv) in the reductive case). Over an
algebraically closed field, let `H` be smooth, affine and connected, with a closed split torus
`t` and lines `x i`, `y i` of weights `± a i` as in `torusCentralizer_eq_range_of_generated`.
Assume each `x i` is a monomorphism, each `a i` has an isolating cocharacter, `⟨a i, ν i⟩ = 2`,
and a rational point normalizes `t` through the reflection `s_{a i}`. Assume `cch` pairs nonzero
with every root. Let `Φ'` contain every root that lies in the cone of the `a i` or its negative,
be reduced, and lie in the reflection closure of the `a i`. Then `H` is connected reductive and
its roots are exactly `Φ'`. -/
theorem isConnectedReductive_and_roots_eq_of_generated [IsAlgClosed k] [Smooth H.X.hom]
    [IsAffineHom H.X.hom] [ConnectedSpace H.X.left]
    (hT : IsSplitTorus T.toGrp) {Idx : Type*}
    (t : T.toGrp ⟶ H) (a : Idx → characterLattice T) (ν : Idx → cocharacterLattice T)
    (x y : Idx → (Ga k ⟶ H))
    (hx : ∀ i, IsTorusEquivariant t (x i) (a i)) (hy : ∀ i, IsTorusEquivariant t (y i) (-a i))
    (hrel : ∀ i, RelationOver t (ν i) (x i) (y i) (Over.mk (𝟙 (Spec (CommRingCat.of k)))))
    (hcomm : ∀ i j, i ≠ j → ∀ g ∈ rangePts (x i), ∀ h ∈ rangePts (y j), Commute g h)
    (hgen : Dense (rationalPointImage H (Subgroup.closure
      ((⋃ i, (rangePts (x i) : Set (rationalPoints H))) ∪ (⋃ i, (rangePts (y i) : Set (rationalPoints H))) ∪
        (rangePts t : Set (rationalPoints H))) : Set (rationalPoints H))))
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch)
    (ht : IsClosedSubgroup t)
    (hmono : ∀ i, Mono (x i).hom.hom)
    (heta : ∀ i, ∃ eta : cocharacterLattice T, IsIsolatingCocharacter a i eta)
    (hpair : ∀ i, latticePairing T (a i) (ν i) = 2)
    (hn : ∀ i, ∃ n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X,
      IsNormalizingPoint t n (latticeReflectionIso (a i) (ν i) (hpair i)))
    (hgeneric : ∀ χ ∈ roots t, latticePairing T χ cch ≠ 0)
    (Φ' : Set (characterLattice T))
    (hsub : ∀ χ ∈ roots t, χ ∈ cone a ∨ -χ ∈ cone a → χ ∈ Φ')
    (hred : ∀ α ∈ Φ', ∀ β ∈ Φ', (∃ m n : ℤ, m ≠ 0 ∧ m • β = n • α) → β = α ∨ β = -α)
    (hclosure : LiesInReflectionClosure a ν Φ') :
    IsConnectedReductive H ∧ roots t = Φ' := by
  have hline : ∀ i, IsWeylLineRoot t (a i) := by
    intro i
    obtain ⟨eta, heta⟩ := heta i
    obtain ⟨n, hn⟩ := hn i
    have := hmono i
    exact isWeylLineRoot_line hT t a ν x y hx hy hrel hcomm hgen cch hpos ht i eta heta (hpair i)
      hn
  have hweyl : ∀ χ ∈ Φ', IsWeylLineRoot t χ := by
    refine hclosure (IsWeylLineRoot t) hline fun i χ h => ?_
    obtain ⟨n, hn⟩ := hn i
    exact h.reflection (hpair i) hn
  have hroots : roots t = Φ' := Set.Subset.antisymm
    (fun χ hχ => hsub χ hχ (mem_cone_or_neg_mem_cone_of_mem_roots hT t a ν x y hx hy hrel hcomm
      hgen cch hpos ht hχ (hgeneric χ hχ)))
    (fun χ hχ => (hweyl χ hχ).1)
  refine ⟨RootwiseWeyl.isConnectedReductive_of_rootwiseWeyl t hT ht
    (torusCentralizer_eq_range_of_generated t a ν x y hx hy hrel hcomm hgen cch hpos ht)
    (fun α hα => (hweyl α (hroots ▸ hα)).2.1) ?_
    (fun α hα => (hweyl α (hroots ▸ hα)).2.2.exists_transporter), hroots⟩
  rw [hroots]
  exact hred

end Reductive

end Langlands.GroupScheme.MaximalSplitSubgroup
