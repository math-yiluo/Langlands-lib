import Langlands.Algebra.GradedIdealSupportProof
import Langlands.GroupScheme.Rational.CoordinateSemigroupReduction
import Langlands.GroupScheme.Rational.CoordinateCotangentSupportProof

/-! # Positive augmentation-weight semigroup comparison -/

universe u

namespace Langlands.GroupScheme.CoordinateWeights

/-- Actual augmentation support is the positive semigroup generated by the
original intrinsic Lie support, with its universal containment criterion. -/
theorem coordinateSemigroupComparison : CoordinateSemigroupComparisonStatement.{u} :=
  coordinateSemigroupComparison_of_prerequisites
    Langlands.Algebra.GradedIdealSupport.positiveGeneration.{u, u, u}
    coordinateWeightDecomposition.{u} cotangentLieSupport.{u}

end Langlands.GroupScheme.CoordinateWeights
