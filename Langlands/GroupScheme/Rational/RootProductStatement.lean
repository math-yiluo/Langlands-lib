import Langlands.GroupScheme.Rational.WeightSemigroupStatement

/-! # Exact semigroup products and actual relative-root radical products -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeRoot

section Indices

variable {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]

/-- Actual roots which are not a positive integral multiple, of order at least
two, of another actual root. This is divisibility within the root set. -/
def indivisibleRoots (i : S.toGrp ⟶ G) : Set (characterLattice S) :=
  {a | a ∈ relativeRoots i ∧
    ∀ b ∈ relativeRoots i, ∀ m : ℕ, 1 < m → m • b ≠ a}

/-- The indivisible actual roots positive on an arbitrary cocharacter. -/
def indivisiblePositiveRoots (i : S.toGrp ⟶ G) (ν : cocharacterLattice S) :
    Set (characterLattice S) :=
  {a | a ∈ indivisibleRoots i ∧ 0 < latticePairing S a ν}

end Indices

/-- CGP 3.3.11 with its precise cross-exclusion hypothesis. The semigroups
generated by different blocks are not required to be disjoint. -/
def SemigroupOrderedProductStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (_hG : Smooth G.X.hom) (hAff : IsAffineHom G.X.hom)
    (_hConn : ConnectedSpace G.X.left) (_hSolv : IsSolvableScheme G)
    (S : CommGroupScheme (Spec (CommRingCat.of k))),
    IsSplitTorus S.toGrp → ∀ b : AutomorphicAction S.toGrp G,
    letI := hAff
    ∀ (n : ℕ) (Ψ : Fin n → Set (characterLattice S)),
      (⋃ r, Ψ r) = actionWeightSupport b ⊤ →
      (∀ r q : Fin n, r ≠ q → Disjoint (Ψ r) (Ψ q)) →
      (∀ r q : Fin n, r ≠ q →
        Disjoint (Ψ r) (AddSubsemigroup.closure (Ψ q) : Set (characterLattice S))) →
      ∃ (H : Fin n → GroupScheme (Spec (CommRingCat.of k))) (j : ∀ r, H r ⟶ G),
        (∀ r, (semigroupSubgroup b (AddSubsemigroup.closure (Ψ r))).IsRepresentedBy (j r) ∧
          IsClosedSubgroup (j r) ∧ Smooth (H r).X.hom ∧ ConnectedSpace (H r).X.left) ∧
        IsIso (orderedMultiplication j)

/-- For every cocharacter, the actual positive roots split into disjoint
positive integral rays indexed by finitely many indivisible actual roots. -/
def RelativeRootRayDecompositionStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (S : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : S.toGrp ⟶ G), IsMaximalSplitTorus i →
    letI := hG.isAffineHom
    ∀ ν : cocharacterLattice S,
      (∃ (n : ℕ) (a : Fin n → characterLattice S),
        Function.Injective a ∧ Set.range a = indivisiblePositiveRoots i ν) ∧
      (∀ a ∈ indivisiblePositiveRoots i ν,
        ∀ b ∈ indivisiblePositiveRoots i ν, a ≠ b →
          Disjoint (cyclicTail a 1 : Set (characterLattice S))
            (cyclicTail b 1 : Set (characterLattice S))) ∧
      (∀ χ ∈ relativeRoots i,
        0 < latticePairing S χ ν ↔
          ∃ a ∈ indivisiblePositiveRoots i ν, χ ∈ cyclicTail a 1)

/-- Any ordering of the indivisible positive actual roots gives a scheme
isomorphism onto a smooth closed representative of the actual Dynamic radical.
The doubled-root group remains inside its indivisible-root factor. -/
def DynamicRootOrderedProductStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (S : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : S.toGrp ⟶ G), IsMaximalSplitTorus i →
    letI := hG.isAffineHom
    ∀ (ν : cocharacterLattice S) (n : ℕ) (a : Fin n → characterLattice S),
      Function.Injective a → Set.range a = indivisiblePositiveRoots i ν →
      ∃ (U : GroupScheme (Spec (CommRingCat.of k))) (jU : U ⟶ G)
        (H : Fin n → GroupScheme (Spec (CommRingCat.of k))) (j : ∀ r, H r ⟶ G)
        (e : (∏ᶜ H).X ≅ U.X),
        (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy jU ∧
        IsClosedSubgroup jU ∧ Smooth U.X.hom ∧ ConnectedSpace U.X.left ∧
        IsUnipotent U ∧ IsSplitUnipotent U ∧
        (∀ r, (subgroup i (a r)).IsRepresentedBy (j r) ∧
          IsClosedSubgroup (j r) ∧ Smooth (H r).X.hom ∧ ConnectedSpace (H r).X.left ∧
          IsUnipotent (H r) ∧ IsSplitUnipotent (H r)) ∧
        e.hom ≫ jU.hom.hom = orderedMultiplication j

/-- Exact source products, finite root-ray indexing and actual Dynamic products. -/
def RootProductStatement : Prop :=
  SemigroupOrderedProductStatement.{u} ∧ RelativeRootRayDecompositionStatement.{u} ∧
    DynamicRootOrderedProductStatement.{u}

end Langlands.GroupScheme.RelativeRoot
