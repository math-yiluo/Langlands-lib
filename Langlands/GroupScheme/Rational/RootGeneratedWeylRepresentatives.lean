import Langlands.GroupScheme.Rational.RootFactorizationFromExistence
import Langlands.GroupScheme.Rational.ReflectionNegation
import Langlands.GroupScheme.Rational.RelativeWeylCoxeterAssembly
import Langlands.GroupScheme.Rational.RelativeWeylChamberGeneration
import Langlands.GroupScheme.Rational.SimplyConnectedCentralizerProductReduction

/-! # Actual Weyl representatives in root-generated rational subgroups -/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [IsAffineHom G.X.hom] [Mono i.hom.hom.left]

namespace RelativeRoot

/-- A normalizing opposite-root triple belongs to the subgroup generated by
the two actual root groups and gives full-kernel integral reflection data. -/
theorem exists_rootGeneratedRepresentative [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (a : relativeRoots i) :
    ∃ n : normalizerPoints i,
      n.val ∈ (subgroup i (-a.val)).carrier (Over.mk (𝟙 _)) ⊔
        (subgroup i a.val).carrier (Over.mk (𝟙 _)) ∧
      weylAction i n a.val = -a.val ∧
      n.val ∈ (kernelCentralizer i a.val).carrier (Over.mk (𝟙 _)) := by
  obtain ⟨x, hx, hx1⟩ := exists_rootPoint_actual hT i a.property
  obtain ⟨p, hp⟩ := hE a.val a.property x hx hx1
  refine ⟨⟨p.1 * x * p.2, hp.2.2⟩, ?_,
    hp.weylAction_eq_neg i hT a.property.1 hx hx1,
    hp.mem_kernelCentralizer i hx⟩
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Subgroup.mem_sup_left hp.1) (Subgroup.mem_sup_right hx))
    (Subgroup.mem_sup_left hp.2.1)

/-- Choose an actual normalizing triple for each root. The existence of
opposite factor pairs remains an explicit premise. -/
def rootGeneratedRepresentative [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (a : relativeRoots i) : normalizerPoints i :=
  Classical.choose (exists_rootGeneratedRepresentative i hT hE a)

theorem rootGeneratedRepresentative_spec [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (a : relativeRoots i) :
    (rootGeneratedRepresentative i hT hE a).val ∈
        (subgroup i (-a.val)).carrier (Over.mk (𝟙 _)) ⊔
          (subgroup i a.val).carrier (Over.mk (𝟙 _)) ∧
      weylAction i (rootGeneratedRepresentative i hT hE a) a.val = -a.val ∧
      (rootGeneratedRepresentative i hT hE a).val ∈
        (kernelCentralizer i a.val).carrier (Over.mk (𝟙 _)) :=
  Classical.choose_spec (exists_rootGeneratedRepresentative i hT hE a)

end RelativeRoot

namespace RelativeRootReflectionData

/-- Integral reflection data whose actual representatives are products of
opposite-root points, constructed from opposite-pair existence. -/
def ofOppositeFactorPairs [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i) :
    RelativeRootReflectionData i :=
  ofKernelCentralizingRepresentatives i hT
    (RelativeRoot.rootGeneratedRepresentative i hT hE)
    (fun a => (RelativeRoot.rootGeneratedRepresentative_spec i hT hE a).2.1)
    (fun a => (RelativeRoot.rootGeneratedRepresentative_spec i hT hE a).2.2)

theorem ofOppositeFactorPairs_representative_mem [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i)
    (a : relativeRoots i) :
    ((ofOppositeFactorPairs i hT hE).representative a).val ∈
      (RelativeRoot.subgroup i (-a.val)).carrier (Over.mk (𝟙 _)) ⊔
        (RelativeRoot.subgroup i a.val).carrier (Over.mk (𝟙 _)) :=
  (RelativeRoot.rootGeneratedRepresentative_spec i hT hE a).1

variable {i} (D : RelativeRootReflectionData i)

/-- Under the full actual-root-system hypothesis, any integral reflection
representatives generate the actual rational normalizer quotient. -/
theorem closure_representatives_eq_top
    (hT : IsSplitTorus T.toGrp) (hfinite : (relativeRoots i).Finite)
    (hroot : HasRelativeRootSystem i) :
    Subgroup.closure (Set.range fun a =>
      (QuotientGroup.mk (D.representative a) : relativeWeylGroup i)) = ⊤ := by
  apply Subgroup.map_injective hroot.relativeWeylAction_injective
  rw [Subgroup.map_top, MonoidHom.map_closure, ← Set.range_comp]
  exact (D.weylGroup_image hT hfinite).symm.trans
    (D.weylGroup_map_eq_range hT hfinite hroot)

/-- A rational-point subgroup containing a generating family of actual
reflection representatives supplies every actual relative-Weyl class. -/
theorem subgroupRelativeWeylMap_surjective_of_generation
    (hgenerate : Subgroup.closure (Set.range fun a =>
      (QuotientGroup.mk (D.representative a) : relativeWeylGroup i)) = ⊤)
    (H : Subgroup (rationalPoints G))
    (hH : ∀ a, (D.representative a).val ∈ H) :
    Function.Surjective (subgroupRelativeWeylMap i H) := by
  apply MonoidHom.range_eq_top.mp
  apply top_unique
  rw [← hgenerate, Subgroup.closure_le]
  rintro _ ⟨a, rfl⟩
  exact ⟨⟨D.representative a, hH a⟩, rfl⟩

end RelativeRootReflectionData

namespace RelativeRoot

/-- The chosen opposite-root representatives belong to every subgroup
containing all actual root groups. -/
theorem rootGeneratedRepresentative_mem [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (H : Subgroup (rationalPoints G))
    (hH : ∀ a ∈ relativeRoots i, (subgroup i a).carrier (Over.mk (𝟙 _)) ≤ H)
    (a : relativeRoots i) :
    (rootGeneratedRepresentative i hT hE a).val ∈ H := by
  let D := RelativeRootReflectionData.ofOppositeFactorPairs i hT hE
  exact (sup_le (hH (-a.val) (D.neg_mem_relativeRoots i a.property))
    (hH a.val a.property)) (rootGeneratedRepresentative_spec i hT hE a).1

/-- Opposite-pair existence and an actual-root-system realization give
relative-Weyl surjectivity for every subgroup containing the actual root groups. -/
theorem subgroupRelativeWeylMap_surjective_of_oppositeFactorPairs [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (hroot : HasRelativeRootSystem i) (H : Subgroup (rationalPoints G))
    (hH : ∀ a ∈ relativeRoots i, (subgroup i a).carrier (Over.mk (𝟙 _)) ≤ H) :
    Function.Surjective (subgroupRelativeWeylMap i H) := by
  let D := RelativeRootReflectionData.ofOppositeFactorPairs i hT hE
  exact D.subgroupRelativeWeylMap_surjective_of_generation
    (D.closure_representatives_eq_top hT (hroot.finite_relativeRoots i hT) hroot)
    H (rootGeneratedRepresentative_mem i hT hE H hH)

/-- A trivial positive-root stabilizer can replace the full root-system
realization in the root-generated Weyl-surjectivity argument. -/
theorem subgroupRelativeWeylMap_surjective_of_positive_stabilizer [Smooth G.X.hom]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (hfinite : (relativeRoots i).Finite) {ν : cocharacterLattice T}
    (hν : IsGenericCocharacter i ν) (hstab : HasTrivialPositiveRootStabilizer i ν)
    (H : Subgroup (rationalPoints G))
    (hH : ∀ a ∈ relativeRoots i, (subgroup i a).carrier (Over.mk (𝟙 _)) ≤ H) :
    Function.Surjective (subgroupRelativeWeylMap i H) := by
  let D := RelativeRootReflectionData.ofOppositeFactorPairs i hT hE
  exact D.subgroupRelativeWeylMap_surjective_of_generation
    (D.closure_representatives_eq_top_of_positive_stabilizer hT hfinite hν hstab)
    H (rootGeneratedRepresentative_mem i hT hE H hH)

end RelativeRoot

end Langlands.GroupScheme
