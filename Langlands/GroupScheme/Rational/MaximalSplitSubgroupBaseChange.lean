import Langlands.GroupScheme.Rational.MaximalSplitSubgroupGenerated
import Langlands.GroupScheme.Rational.MaximalSplitLineBaseChange
import Langlands.GroupScheme.GeneratedFamilyBaseChange
import Langlands.GroupScheme.Reductive.SplitLeviGluingGeneratedDensity
import Langlands.GroupScheme.GeometricConnectedness

/-! # The generated line subgroup after extension to an algebraically closed field -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false

namespace Langlands.GroupScheme.MaximalSplitSubgroup

open VectorGroup RootCell

variable {k K : Type u} [Field k] [Field K] [Algebra k K]

local notation "bc" => algebraBaseMap k K

/-- Smoothness, affineness and connectedness of a group scheme over `k` pass to its base
change to `K`. -/
theorem baseChange_smooth_affine_connected {M : GroupScheme (Spec (CommRingCat.of k))}
    (h : Smooth M.X.hom ∧ IsAffineHom M.X.hom ∧ ConnectedSpace M.X.left) :
    Smooth ((GroupScheme.baseChange bc).obj M).X.hom ∧
      IsAffineHom ((GroupScheme.baseChange bc).obj M).X.hom ∧
      ConnectedSpace ((GroupScheme.baseChange bc).obj M).X.left := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨?_, ?_, connectedSpace_baseChange_of_smooth_affine M bc⟩
  · change Smooth (Limits.pullback.snd M.X.hom bc)
    infer_instance
  · change IsAffineHom (Limits.pullback.snd M.X.hom bc)
    infer_instance

/-- The rational points of the range of a base-changed line are those of the base change of
the line. -/
theorem rangePts_lineBaseChange [IsAlgClosed K] {G : GroupScheme (Spec (CommRingCat.of k))}
    (x : Ga k ⟶ G) :
    rangePts (lineBaseChange K x) = rangePts ((GroupScheme.baseChange bc).map x) :=
  congrArg (fun P => P.carrier (Over.mk (𝟙 (Spec (CommRingCat.of K))))) (range_lineBaseChange x)

/-- **Density after base change.** If a smooth affine group `F` over `k` is generated by a split
torus `f` and lines `x d`, `y d`, then over an algebraically closed extension `K` the rational
points generated by the base-changed torus and lines are dense in `F_K`. -/
theorem dense_baseChange_lineFamily [IsAlgClosed K]
    {S : CommGroupScheme (Spec (CommRingCat.of k))} {F : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth F.X.hom] [IsAffineHom F.X.hom]
    (hT : IsSplitTorus S.toGrp) {Idx : Type*} (f : S.toGrp ⟶ F) (x y : Idx → (Ga k ⟶ F))
    (hgen : IsGeneratedByFamily (lineFamilySource S Idx) (lineFamily f x y) (𝟙 F)) :
    Dense (rationalPointImage ((GroupScheme.baseChange bc).obj F) (Subgroup.closure
      ((⋃ d, (rangePts (lineBaseChange K (x d)) : Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) ∪
        (⋃ d, (rangePts (lineBaseChange K (y d)) :
          Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) ∪
        (rangePts ((GroupScheme.baseChange bc).map f) :
          Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) :
        Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) := by
  have hA := lineFamilySource_smooth_affine_connected hT (Idx := Idx)
  have hgenK := IsGeneratedByFamily.baseChange K (lineFamilySource S Idx) (lineFamily f x y) hA
    hgen
  rw [CategoryTheory.Functor.map_id] at hgenK
  have : Smooth ((GroupScheme.baseChange bc).obj F).X.hom := by
    change Smooth (Limits.pullback.snd F.X.hom bc)
    infer_instance
  have : IsAffineHom ((GroupScheme.baseChange bc).obj F).X.hom := by
    change IsAffineHom (Limits.pullback.snd F.X.hom bc)
    infer_instance
  have hd := LeviGluing.dense_rationalPointImage_closure_of_isGeneratedByFamily
    (fun o => baseChange_smooth_affine_connected (K := K) (hA o)) hgenK
  have hset : ((⋃ d, (rangePts (lineBaseChange K (x d)) :
        Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) ∪
      (⋃ d, (rangePts (lineBaseChange K (y d)) :
        Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) ∪
      (rangePts ((GroupScheme.baseChange bc).map f) :
        Set (rationalPoints ((GroupScheme.baseChange bc).obj F)))) =
      ⋃ o, ((SubgroupFunctor.range ((GroupScheme.baseChange bc).map (lineFamily f x y o))).carrier
        (Over.mk (𝟙 (Spec (CommRingCat.of K)))) :
          Set (rationalPoints ((GroupScheme.baseChange bc).obj F))) := by
    simp only [rangePts_lineBaseChange]
    ext g
    simp only [Set.mem_union, Set.mem_iUnion]
    constructor
    · rintro ((⟨d, hd⟩ | ⟨d, hd⟩) | h)
      · exact ⟨some (true, d), hd⟩
      · exact ⟨some (false, d), hd⟩
      · exact ⟨none, h⟩
    · rintro ⟨(_ | ⟨_ | _, d⟩), h⟩
      · exact Or.inr h
      · exact Or.inl (Or.inr ⟨d, h⟩)
      · exact Or.inl (Or.inl ⟨d, h⟩)
  rw [hset]
  exact hd

end Langlands.GroupScheme.MaximalSplitSubgroup
