import Langlands.GroupScheme.Rational.StandardRelativeWeylGenerationReduction
import Langlands.GroupScheme.Rational.RootGeneratedCentralizerReduction
import Langlands.GroupScheme.Rational.RootSystemFromFactorPairs
import Langlands.GroupScheme.Rational.RootRankOneFactorizationProof

/-! # Proof that standard relative Weyl subgroups are generated by simple reflections -/

universe u

namespace Langlands.GroupScheme

/-- **The standard relative Weyl subgroups are generated by simple reflections**
(Borel–Tits 5.17). For a maximal split torus of a connected reductive group over any
field, a generic cocharacter `ν` and a set `J` of simple relative roots, the reflections
in the roots of `J` generate `standardRelativeWeylGroup i ν J`. The proof composes the
published rank-one factorization, relative root system, reflection existence, abstract
Coxeter and generation reductions. -/
theorem standardRelativeWeylGeneration : StandardRelativeWeylGenerationStatement.{u} :=
  standardRelativeWeylGenerationStatement_of_relativeWeylCoxeter
    (RootGeneratedCentralizerStructuralPremises.relativeWeylCoxeter
      ⟨relativeRootSystemStatement_of_rootRankOneFactorizationStatement rootRankOneFactorization,
        rootRankOneFactorization⟩)

end Langlands.GroupScheme
