import Langlands.GroupScheme.Rational.RootSubgroup
import Langlands.GroupScheme.Rational.RelativeRoots
import Langlands.GroupScheme.Rational.SplitTorus
import Langlands.GroupScheme.Torus.Maximal
import Langlands.GroupScheme.Torus.LatticeGalois

/-! # Relative root groups generated by absolute root groups: statement -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- **The relative root group `U_(a)` is generated by the absolute root groups `U_β` with
`β|_S` a positive multiple of `a`** (Borel–Tits, *Groupes réductifs* (1965), 3.8 (ii), 3.13
and 5.2; Milne, *Algebraic Groups* (2017), 25.19). Let `G` be a connected reductive group
over a field `k`, `i : S ⟶ G` a maximal split torus, `j : T ⟶ G` a maximal torus containing
`S` through `f : S ⟶ T`, and `K` an extension field of `k` over which `T` splits. For a
relative root `a`, call a root `β` of `(G_K, T_K)` *above `a`* when its restriction to `S_K`
is `n • a_K` for some positive integer `n`. Then:

1. the root subgroup of every root `β` above `a` is contained in the base change to `K` of
   the relative root subgroup `RelativeRoot.subgroup i a`;
2. every closed subgroup of `G_K` containing the root subgroups of all roots above `a`
   contains that base change.

So the base change of `U_(a)` is the smallest closed subgroup of `G_K` containing the
absolute root groups above `a`. -/
def RelativeRootGroupAbsoluteGenerationStatement : Prop :=
  ∀ (k K : Type u) [Field k] [Field K] [Algebra k K]
    (G : GroupScheme (Spec (CommRingCat.of k))) (hG : IsConnectedReductive G)
    (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
    IsMaximalSplitTorus i →
    ∀ (T : CommGroupScheme (Spec (CommRingCat.of k))) (j : T.toGrp ⟶ G) (f : S ⟶ T),
      IsMaximalTorus j → CommGroupScheme.groupHom f ≫ j = i →
      IsSplitTorus ((GroupScheme.baseChange (algebraBaseMap k K)).obj T.toGrp) →
      haveI := hG.isAffineHom
      haveI : IsAffineHom ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom := by
        change IsAffineHom (pullback.snd G.X.hom _)
        infer_instance
      ∀ a ∈ relativeRoots i,
        (∀ β ∈ roots ((GroupScheme.baseChange (algebraBaseMap k K)).map j),
          (∃ n : ℕ, 0 < n ∧ (CommGroupScheme.baseChange (algebraBaseMap k K)).map f ≫ β =
            n • characterLattice.baseChange (algebraBaseMap k K) S a) →
          RelativeRoot.subgroup ((GroupScheme.baseChange (algebraBaseMap k K)).map j) β ≤
            (RelativeRoot.subgroup i a).baseChange (algebraBaseMap k K)) ∧
        ∀ (H : GroupScheme (Spec (CommRingCat.of K)))
          (h : H ⟶ (GroupScheme.baseChange (algebraBaseMap k K)).obj G),
          IsClosedSubgroup h →
          (∀ β ∈ roots ((GroupScheme.baseChange (algebraBaseMap k K)).map j),
            (∃ n : ℕ, 0 < n ∧ (CommGroupScheme.baseChange (algebraBaseMap k K)).map f ≫ β =
              n • characterLattice.baseChange (algebraBaseMap k K) S a) →
            RelativeRoot.subgroup ((GroupScheme.baseChange (algebraBaseMap k K)).map j) β ≤
              SubgroupFunctor.range h) →
          (RelativeRoot.subgroup i a).baseChange (algebraBaseMap k K) ≤ SubgroupFunctor.range h

end Langlands.GroupScheme
