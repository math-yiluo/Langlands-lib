import Langlands.GroupScheme.Rational.RelativeCentralDirections
import Langlands.GroupScheme.Rational.RelativeWeylCharacterAction
import Langlands.GroupScheme.Rational.RelativeWeylRootKernel

/-! # Character-restriction bridges for relative Weyl faithfulness -/

set_option backward.isDefEq.respectTransparency false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

section RestrictionRange

variable (i : T.toGrp ⟶ G)

/-- The rationalized restriction range is generated by the restrictions of
actual integral group characters. -/
theorem rationalCharacterRestrictRat_range :
    (rationalCharacterRestrictRat i).range =
      Submodule.span ℚ (toRat '' Set.range (torusCharacterRestrict i)) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    induction x using TensorProduct.inductionOn with
    | tmul q χ =>
      change q ⊗ₜ[ℤ] torusCharacterRestrict i χ ∈
        Submodule.span ℚ (toRat '' Set.range (torusCharacterRestrict i))
      have hχ : toRat (torusCharacterRestrict i χ) ∈
          Submodule.span ℚ (toRat '' Set.range (torusCharacterRestrict i)) :=
        Submodule.subset_span ⟨_, ⟨χ, rfl⟩, rfl⟩
      simpa only [toRat_apply,
        smul_tmul', smul_eq_mul, mul_one] using
        Submodule.smul_mem _ q hχ
    | add x y hx hy =>
      simpa only [map_add] using Submodule.add_mem _ hx hy
  · apply Submodule.span_le.mpr
    rintro _ ⟨_, ⟨χ, rfl⟩, rfl⟩
    exact ⟨toRat χ, rfl⟩

variable [IsAffineHom G.X.hom]

/-- The intrinsic sum of the root span and rational-character restriction
range is the joint span used in the kernel comparison. -/
theorem relativeRootSpan_sup_restrictionRange :
    relativeRootSpan i ⊔ (rationalCharacterRestrictRat i).range =
      Submodule.span ℚ
        (toRat '' (relativeRoots i ∪ Set.range (torusCharacterRestrict i))) := by
  rw [Set.image_union, Submodule.span_union, rationalCharacterRestrictRat_range]
  rfl

/-- The geometric complement supplies the joint-spanning premise; disjointness
is not needed for this implication. -/
theorem relativeRoots_restrictedCharacters_span_of_isCompl
    (h : IsCompl (relativeRootSpan i) (rationalCharacterRestrictRat i).range) :
    Submodule.span ℚ
      (toRat '' (relativeRoots i ∪ Set.range (torusCharacterRestrict i))) = ⊤ := by
  rw [← relativeRootSpan_sup_restrictionRange]
  exact h.sup_eq_top

end RestrictionRange

section FullAction

variable (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]

/-- Compatibility of the two existing names for the same quotient action. -/
theorem relativeWeylCharacterAction_eq_latticeAction :
    relativeWeylCharacterAction i = relativeWeylLatticeAction i := rfl

/-- Faithfulness for the canonical full integral character action. -/
theorem IsSplitTorus.relativeWeylLatticeAction_injective (hT : IsSplitTorus T.toGrp) :
    Function.Injective (relativeWeylLatticeAction i) :=
  hT.relativeWeylCharacterAction_injective i

/-- Rationalization retains faithfulness of the full split-torus character
action, without reductivity or maximality. -/
theorem IsSplitTorus.relativeWeylFullRatAction_injective (hT : IsSplitTorus T.toGrp) :
    Function.Injective (relativeWeylFullRatAction i) := by
  intro w z hwz
  apply hT.relativeWeylLatticeAction_injective i
  apply LinearEquiv.ext
  intro χ
  apply hT.character_toRat_injective
  exact congrArg
    (fun e : (ℚ ⊗[ℤ] characterLattice T) ≃ₗ[ℚ] (ℚ ⊗[ℤ] characterLattice T) =>
      e (toRat χ)) hwz

/-- The canonical full integral action fixes every restricted group character. -/
theorem relativeWeylLatticeAction_torusCharacterRestrict
    (w : relativeWeylGroup i) (χ : rationalCharacters G) :
    relativeWeylLatticeAction i w (torusCharacterRestrict i χ) =
      torusCharacterRestrict i χ := by
  refine Quotient.inductionOn w ?_
  intro n
  exact weylAction_torusCharacterRestrict i n χ

/-- The full rational action fixes the rational-character restriction range
pointwise. -/
theorem relativeWeylFullRatAction_restrictionRange
    (w : relativeWeylGroup i) (x : ℚ ⊗[ℤ] rationalCharacters G) :
    relativeWeylFullRatAction i w (rationalCharacterRestrictRat i x) =
      rationalCharacterRestrictRat i x := by
  induction x using TensorProduct.inductionOn with
  | tmul q χ =>
    change q ⊗ₜ[ℤ] relativeWeylLatticeAction i w (torusCharacterRestrict i χ) =
      q ⊗ₜ[ℤ] torusCharacterRestrict i χ
    rw [relativeWeylLatticeAction_torusCharacterRestrict]
  | add x y hx hy => simp only [map_add, hx, hy]

end FullAction

section RootSpanFaithfulness

variable (i : T.toGrp ⟶ G) [Mono i.hom.hom.left] [IsAffineHom G.X.hom]

/-- Conditional root-span faithfulness from joint spanning by roots and
restricted characters. The spanning premise is a separate structural obligation. -/
theorem IsSplitTorus.relativeWeylAction_injective_of_span
    (hT : IsSplitTorus T.toGrp)
    (hspan : Submodule.span ℚ
      (toRat '' (relativeRoots i ∪ Set.range (torusCharacterRestrict i))) = ⊤) :
    Function.Injective (relativeWeylAction i) := by
  rw [injective_iff_map_eq_one]
  intro w hw
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective w
  rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
  apply (hT.weylAction_eq_one_iff i n).mp
  exact (hT.relativeWeylAction_mk_eq_one_iff_weylAction_eq_one i hspan n).mp hw

/-- The intrinsic rational root/character complement implies faithfulness of
the actual relative Weyl action on the root span. -/
theorem IsSplitTorus.relativeWeylAction_injective_of_isCompl
    (hT : IsSplitTorus T.toGrp)
    (h : IsCompl (relativeRootSpan i) (rationalCharacterRestrictRat i).range) :
    Function.Injective (relativeWeylAction i) :=
  hT.relativeWeylAction_injective_of_span i
    (relativeRoots_restrictedCharacters_span_of_isCompl i h)

/-- The intrinsic complement identifies the actual relative Weyl quotient with
its image on the actual root span. Identifying this image with a root-pairing
Weyl group remains a separate obligation. -/
def IsSplitTorus.relativeWeylEquivRootActionRange
    (hT : IsSplitTorus T.toGrp)
    (h : IsCompl (relativeRootSpan i) (rationalCharacterRestrictRat i).range) :
    relativeWeylGroup i ≃* (relativeWeylAction i).range :=
  MonoidHom.ofInjective (hT.relativeWeylAction_injective_of_isCompl i h)

@[simp]
theorem IsSplitTorus.coe_relativeWeylEquivRootActionRange_apply
    (hT : IsSplitTorus T.toGrp)
    (h : IsCompl (relativeRootSpan i) (rationalCharacterRestrictRat i).range)
    (w : relativeWeylGroup i) :
    (hT.relativeWeylEquivRootActionRange i h w :
      relativeRootSpan i ≃ₗ[ℚ] relativeRootSpan i) = relativeWeylAction i w :=
  rfl

@[simp]
theorem IsSplitTorus.relativeWeylAction_relativeWeylEquivRootActionRange_symm
    (hT : IsSplitTorus T.toGrp)
    (h : IsCompl (relativeRootSpan i) (rationalCharacterRestrictRat i).range)
    (w : (relativeWeylAction i).range) :
    relativeWeylAction i ((hT.relativeWeylEquivRootActionRange i h).symm w) = w :=
  MonoidHom.apply_ofInjective_symm _ _

end RootSpanFaithfulness

end Langlands.GroupScheme
