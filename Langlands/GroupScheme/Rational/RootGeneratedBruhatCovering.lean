import Langlands.Group.RankOneBruhatCovering
import Langlands.GroupScheme.Rational.GenericCentralizerProof
import Langlands.GroupScheme.Rational.BruhatOpenCellProof
import Langlands.GroupScheme.Rational.SimpleRootParabolicFactorization
import Langlands.GroupScheme.Rational.RootFactorizationFromExistence

/-! # Actual-root adapters for the rank-one Bruhat word argument -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [IsAffineHom G.X.hom] (ν : cocharacterLattice T)

/-- Covering of the subgroup generated by the actual root points, with a
specified middle subgroup. -/
def HasRootGeneratedBruhatCovering (M : Subgroup (rationalPoints G)) : Prop :=
  (Subgroup.closure (⋃ a ∈ relativeRoots i,
    ((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) :
      Set (rationalPoints G))) : Set (rationalPoints G)) ⊆
    Langlands.Group.RankOneBruhat.doubleCosets
      (RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i)) M

/-- Normalizer uniqueness for a generic cocharacter of an actual maximal
split torus follows from the published contraction results. -/
theorem hasUnipotentNormalizerSeparation_of_isConnectedReductive
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hν : IsGenericCocharacter i ν) :
    HasUnipotentNormalizerSeparation i ν := by
  let := hG.smooth
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  exact hasUnipotentNormalizerSeparation_of_productContractions i ν
    (genericCentralizer k G hG T i hi ν hν)
    (fun ξ => hasInjectiveOppositeCellMultiplication_of_isAffine i ξ)
    (hasNormalizerProductContractions_of_smooth_affine i ν)

/-- Actual normalizer uniqueness removes the unipotent factors from a
covered centralizing root-generated point. -/
theorem centralizer_inf_rootGenerated_le_of_bruhatCovering
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hν : IsGenericCocharacter i ν)
    (M H : Subgroup (rationalPoints G)) (hMN : M ≤ normalizerPoints i)
    (hcover : HasRootGeneratedBruhatCovering i ν M)
    (hkernel : centralizerPoints i ⊓ M ≤ H) :
    centralizerPoints i ⊓ Subgroup.closure (⋃ a ∈ relativeRoots i,
      ((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) :
        Set (rationalPoints G))) ≤ H := by
  refine Langlands.Group.RankOneBruhat.inf_le_of_doubleCosets
    (centralizerPoints i) (normalizerPoints i) _ H
    (centralizerPoints_le_normalizerPoints i) hMN hcover ?_ hkernel
  intro n hn n' hn' x hx y hy heq
  exact congrArg Subtype.val
    (hasUnipotentNormalizerSeparation_of_isConnectedReductive i ν hG hi hν
      ⟨n, hn⟩ ⟨n', hn'⟩ ⟨x, hx⟩ ⟨y, hy⟩ heq)

namespace RelativeRoot

variable [Mono i.hom.hom.left]

/-- The two opposite root groups provide the sign alternative in the word
argument for every actual normalizing point. -/
theorem rootPoint_conjugation_sign (hν : IsGenericCocharacter i ν)
    {a : characterLattice T} (ha : a ∈ relativeRoots i) (n : normalizerPoints i) :
    (∀ x ∈ (subgroup i a).carrier (Over.mk (𝟙 _)),
      n.val⁻¹ * x * n.val ∈ RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i)) ∨
    (∀ x ∈ (subgroup i (-a)).carrier (Over.mk (𝟙 _)),
      n.val⁻¹ * x * n.val ∈ RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i)) := by
  have hnroot := weylAction_mapsTo_relativeRoots i n⁻¹ ha
  rcases lt_or_gt_of_ne (hν _ hnroot) with hneg | hpos
  · right
    intro x hx
    have hc := normalizer_conj_mem i (-a) n⁻¹ hx
    simp only [G.constantPoint_self, Subgroup.coe_inv, inv_inv, map_neg] at hc
    exact subgroup_le_dynamicUnipotent i ν
      (by simpa only [map_neg, LinearMap.neg_apply] using neg_pos.mpr hneg) _ hc
  · left
    intro x hx
    have hc := normalizer_conj_mem i a n⁻¹ hx
    simp only [G.constantPoint_self, Subgroup.coe_inv, inv_inv] at hc
    exact subgroup_le_dynamicUnipotent i ν hpos _ hc

/-- If actual normalizer conjugation moves every root to a positive root
using elements of `M`, then the root-generated subgroup lies in the group
generated by `U(ν)` and `M`. -/
theorem rootGenerated_le_closure_unipotent_union
    (M : Subgroup (rationalPoints G))
    (hmove : ∀ a ∈ relativeRoots i, ∃ n : normalizerPoints i,
      n.val ∈ M ∧ 0 < latticePairing T (weylAction i n a) ν) :
    Subgroup.closure (⋃ a ∈ relativeRoots i,
      ((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G))) ≤
        Subgroup.closure
          ((RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i) :
            Set (rationalPoints G)) ∪ (M : Set (rationalPoints G))) := by
  let K := Subgroup.closure
    ((RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i) :
      Set (rationalPoints G)) ∪ (M : Set (rationalPoints G)))
  apply (Subgroup.closure_le _).2
  intro x hx
  obtain ⟨a, ha, hx⟩ := Set.mem_iUnion₂.mp hx
  obtain ⟨n, hn, hpos⟩ := hmove a ha
  have hnK : n.val ∈ K := Subgroup.subset_closure (Or.inr hn)
  have hc := normalizer_conj_mem i a n hx
  simp only [G.constantPoint_self] at hc
  have hcK : n.val * x * n.val⁻¹ ∈ K :=
    Subgroup.subset_closure (Or.inl (subgroup_le_dynamicUnipotent i ν hpos _ hc))
  have h := K.mul_mem (K.mul_mem (K.inv_mem hnK) hcK) hnK
  change x ∈ K
  simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel_right,
    inv_mul_cancel, mul_one] using h

omit [Mono i.hom.hom.left] in
/-- Opposite-pair existence supplies the rank-one point factorization
when the normalizing points of the opposite-root generated group lie in `M`. -/
theorem rootPoint_factorization_of_oppositeFactorPairs
    (hE : HasOppositeFactorPairs i) (M : Subgroup (rationalPoints G))
    {a : characterLattice T} (ha : a ∈ relativeRoots i)
    (hM : normalizerPoints i ⊓ Subgroup.closure
      (((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
        (subgroup i (-a)).carrier (Over.mk (𝟙 _))) ≤ M)
    (x : rationalPoints G) (hx : x ∈ (subgroup i a).carrier (Over.mk (𝟙 _)))
    (hx1 : x ≠ 1) :
    ∃ y ∈ (subgroup i (-a)).carrier (Over.mk (𝟙 _)),
      ∃ m ∈ M, ∃ z ∈ (subgroup i (-a)).carrier (Over.mk (𝟙 _)),
        x = y * m * z := by
  obtain ⟨p, hp⟩ := hE a ha x hx hx1
  let L := Subgroup.closure
    (((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
      (subgroup i (-a)).carrier (Over.mk (𝟙 _)))
  have hmL : p.1 * x * p.2 ∈ L :=
    L.mul_mem (L.mul_mem (Subgroup.subset_closure (Or.inr hp.1))
      (Subgroup.subset_closure (Or.inl hx)))
      (Subgroup.subset_closure (Or.inr hp.2.1))
  refine ⟨p.1⁻¹, Subgroup.inv_mem _ hp.1, p.1 * x * p.2, hM ⟨hp.2.2, hmL⟩,
    p.2⁻¹, Subgroup.inv_mem _ hp.2.1, ?_⟩
  group

end RelativeRoot

end Langlands.GroupScheme
