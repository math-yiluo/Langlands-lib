import Langlands.GroupScheme.Rational.OrthogonalOrbitDescent
import Langlands.GroupScheme.Reductive.LinkedRootSpecialLinearHom

/-! # Binary special linear homomorphisms over orthogonal orbits of simple roots -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.Algebra

namespace Langlands.GroupScheme

namespace SplitPinning

open SpecialLinear.BinaryPresentation

section Split

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] {p : SplitPinning G}
  (x : p.NormalizedSimpleRootParametrizations)

/-- The rank-one homomorphism of a simple root, from its normalized map and its
negative partner. -/
def rootSL2 (a : p.base.support) :
    Matrix.SpecialLinearGroup (Fin 2) k →* rationalPoints G :=
  (x a).linked.specialLinearHom (NormalizedRootParametrization.pairing_root_coroot (a := a))

theorem rootSL2_upper (a : p.base.support) (t : k) :
    rootSL2 x a (upper t) = (rankData x a).xp t :=
  LinkedRootParametrization.specialLinearHom_upper _ _ t

theorem rootSL2_lower (a : p.base.support) (t : k) :
    rootSL2 x a (lower t) = (rankData x a).xm t :=
  LinkedRootParametrization.specialLinearHom_lower _ _ t

theorem rootSL2_diag (a : p.base.support) (u : kˣ) :
    rootSL2 x a (diag u) = (rankData x a).h u :=
  LinkedRootParametrization.specialLinearHom_diag _ _ u

/-- Every value of the rank-one homomorphism lies in the subgroup generated by its root
elements. -/
theorem rootSL2_mem (a : p.base.support) (g : Matrix.SpecialLinearGroup (Fin 2) k) :
    rootSL2 x a g ∈ (rankData x a).rootSubgroup := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec i j hij c =>
    fin_cases i <;> fin_cases j
    · exact absurd rfl hij
    · change rootSL2 x a (upper c) ∈ _
      rw [rootSL2_upper]
      exact (rankData x a).xp_mem c
    · change rootSL2 x a (lower c) ∈ _
      rw [rootSL2_lower]
      exact (rankData x a).xm_mem c
    · exact absurd rfl hij
  | hmul A B hA hB =>
    rw [map_mul]
    exact Subgroup.mul_mem _ hA hB

end Split

section Galois

open GaloisPointComparison

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable (k K : Type u) [Field k] [Field K] [Algebra k K]
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (i : T.toGrp ⟶ G)

local instance orthogonalOrbitSpecialLinearIsAffineHom :
    IsAffineHom ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom (algebraBaseMap k K))
  infer_instance

variable (p : Langlands.GroupScheme.SplitPinning
    ((GroupScheme.baseChange (algebraBaseMap k K)).obj G))
    (eT : p.torus ≅ ((CommGroupScheme.baseChange (algebraBaseMap k K)).obj T))
    (hT : p.inclusion = CommGroupScheme.groupHom eT.hom ≫
      (GroupScheme.baseChange (algebraBaseMap k K)).map i)
    (x : p.NormalizedSimpleRootParametrizations)
    {ρ : (K ≃ₐ[k] K) →* Equiv.Perm p.base.support}
    (hx : RootMapsGaloisCompatible k K p x ρ)
    (hroot : ∀ (σ : K ≃ₐ[k] K) (a : p.base.support),
      characterLattice.congr eT (p.rootDatum.root (ρ σ a)) =
        characterLattice.galoisRepresentation k K T σ
          (characterLattice.congr eT (p.rootDatum.root a)))
    (O : Set p.base.support) (hOs : ∀ (σ : K ≃ₐ[k] K) a, a ∈ O ↔ ρ σ a ∈ O)
    (hO : ∀ a ∈ O, ∀ b ∈ O, a ≠ b → p.rootDatum.IsOrthogonal a b)

include hT hx hroot in
/-- Conjugating the coefficients of a rank-one homomorphism by a Galois automorphism gives
the rank-one homomorphism of the permuted simple root at the conjugated matrix. -/
theorem rootSL2_rationalConjugate (σ : K ≃ₐ[k] K) (a : p.base.support)
    (g : Matrix.SpecialLinearGroup (Fin 2) K) :
    rationalConjugate k K G σ (rootSL2 x a g) =
      rootSL2 x (ρ σ a) (Matrix.SpecialLinearGroup.map σ.toRingHom g) := by
  have h : (rationalConjugate k K G σ).toMonoidHom.comp (rootSL2 x a) =
      (rootSL2 x (ρ σ a)).comp (Matrix.SpecialLinearGroup.map σ.toRingHom) := by
    apply hom_ext
    · intro t
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, map_upper, rootSL2_upper,
        rankData_xp]
      exact RootMapsGaloisCompatible.rationalPoint k K hx σ a t
    · intro t
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, map_lower, rootSL2_lower,
        rankData_xm]
      have h := RootMapsGaloisCompatible.negPointFamily_rationalConjugate k K i p eT hT hx
        hroot σ a t
      simp only [negPointFamily] at h
      exact h
  exact DFunLike.congr_fun h g

/-- Families of matrices on the simple roots that are equivariant for the Galois action. -/
def equivariantFamilies (ρ : (K ≃ₐ[k] K) →* Equiv.Perm p.base.support) :
    Subgroup (p.base.support → Matrix.SpecialLinearGroup (Fin 2) K) where
  carrier := {g | ∀ (σ : K ≃ₐ[k] K) (a : p.base.support),
    g (ρ σ a) = Matrix.SpecialLinearGroup.map σ.toRingHom (g a)}
  one_mem' := fun σ a => by simp
  mul_mem' := fun {g h} hg hh σ a => by
    simp only [Pi.mul_apply, hg σ a, hh σ a, map_mul]
  inv_mem' := fun {g} hg σ a => by
    simp only [Pi.inv_apply, hg σ a, map_inv]

variable {E : Type u} [Field E] [Algebra k E] (τ : p.base.support → (E →ₐ[k] K))
  (hτ : ∀ (σ : K ≃ₐ[k] K) (a : p.base.support), a ∈ O → τ (ρ σ a) = σ.toAlgHom.comp (τ a))

omit [Algebra k E] in
theorem specialLinearMap_comp (f : E →+* K) (σ : K ≃ₐ[k] K)
    (g : Matrix.SpecialLinearGroup (Fin 2) E) :
    Matrix.SpecialLinearGroup.map (σ.toRingHom.comp f) g =
      Matrix.SpecialLinearGroup.map σ.toRingHom (Matrix.SpecialLinearGroup.map f g) := by
  ext r c
  simp [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply]

open Classical in
/-- Embedding coordinates of a matrix over `E`, trivial off `O`. -/
def fieldFamilyPi :
    Matrix.SpecialLinearGroup (Fin 2) E →* (p.base.support → Matrix.SpecialLinearGroup (Fin 2) K) :=
  MonoidHom.pi fun a =>
    if a ∈ O then Matrix.SpecialLinearGroup.map (τ a).toRingHom else 1

open Classical in
theorem fieldFamilyPi_apply (g : Matrix.SpecialLinearGroup (Fin 2) E) (a : p.base.support) :
    fieldFamilyPi k K p O τ g a =
      if a ∈ O then Matrix.SpecialLinearGroup.map (τ a).toRingHom g else 1 := by
  simp only [fieldFamilyPi, MonoidHom.pi_apply]
  split_ifs <;> rfl

open Classical in
theorem fieldFamilyPi_of_mem (g : Matrix.SpecialLinearGroup (Fin 2) E) {a : p.base.support}
    (ha : a ∈ O) :
    fieldFamilyPi k K p O τ g a = Matrix.SpecialLinearGroup.map (τ a).toRingHom g := by
  rw [fieldFamilyPi_apply, ite_eq_left_iff.mpr (fun h => absurd ha h)]

include hτ hOs in
theorem fieldFamilyPi_mem (g : Matrix.SpecialLinearGroup (Fin 2) E) :
    fieldFamilyPi k K p O τ g ∈ equivariantFamilies k K p ρ := by
  intro σ a
  by_cases ha : a ∈ O
  · have ha' : ρ σ a ∈ O := (hOs σ a).mp ha
    rw [fieldFamilyPi_of_mem k K p O τ g ha, fieldFamilyPi_of_mem k K p O τ g ha', hτ σ a ha]
    exact specialLinearMap_comp k K (τ a).toRingHom σ g
  · have ha' : ρ σ a ∉ O := fun h => ha ((hOs σ a).mpr h)
    simp only [fieldFamilyPi_apply, ha, ha', ite_false, map_one]

variable [Fintype O]

/-- The product over `O` of the rank-one homomorphisms, evaluated at a family of
matrices. -/
def orbitSL2 : (p.base.support → Matrix.SpecialLinearGroup (Fin 2) K) →*
    rationalPoints ((GroupScheme.baseChange (algebraBaseMap k K)).obj G) :=
  (RankOneRelation.prodHom (rootsCommute_of_orthogonal x O hO)).comp
    (MonoidHom.pi fun a : O =>
      ((rootSL2 x (a : p.base.support)).codRestrict _ (rootSL2_mem x a)).comp
        (Pi.evalMonoidHom (fun _ => Matrix.SpecialLinearGroup (Fin 2) K) (a : p.base.support)))

theorem orbitSL2_apply (g : p.base.support → Matrix.SpecialLinearGroup (Fin 2) K) :
    orbitSL2 k K p x O hO g =
      RankOneRelation.prodHom (rootsCommute_of_orthogonal x O hO)
        (fun a => ⟨rootSL2 x a (g a), rootSL2_mem x a (g a)⟩) := rfl

theorem orbitSL2_upper (c : p.base.support → K) :
    orbitSL2 k K p x O hO (fun a => upper (c a)) = orbitXp k K p x O hO c := by
  rw [orbitSL2_apply, orbitXp]
  congr 1
  funext a
  exact Subtype.ext (rootSL2_upper x a (c a))

theorem orbitSL2_lower (c : p.base.support → K) :
    orbitSL2 k K p x O hO (fun a => lower (c a)) = orbitXm k K p x O hO c := by
  rw [orbitSL2_apply, orbitXm]
  congr 1
  funext a
  exact Subtype.ext (rootSL2_lower x a (c a))

theorem orbitSL2_diag (u : p.base.support → Kˣ) :
    orbitSL2 k K p x O hO (fun a => diag (u a)) = orbitCoroot k K p x O hO u := by
  rw [orbitSL2_apply, orbitCoroot]
  congr 1
  funext a
  exact Subtype.ext (rootSL2_diag x a (u a))

include hT hx hroot hOs in
/-- Equivariant families give Galois-fixed orbit products. -/
theorem orbitSL2_rationalConjugate {g : p.base.support → Matrix.SpecialLinearGroup (Fin 2) K}
    (hg : g ∈ equivariantFamilies k K p ρ) (σ : K ≃ₐ[k] K) :
    rationalConjugate k K G σ (orbitSL2 k K p x O hO g) = orbitSL2 k K p x O hO g := by
  rw [orbitSL2_apply]
  apply RankOneRelation.map_prodHom_of_perm _ (rationalConjugate k K G σ).toMonoidHom
    ((ρ σ).subtypePerm (fun a => (hOs σ a).symm))
  intro a
  simp only [MulEquiv.coe_toMonoidHom, Equiv.Perm.subtypePerm_apply]
  rw [rootSL2_rationalConjugate k K i p eT hT x hx hroot σ a, hg σ a]

/-- The orbit product depends only on the values on `O`. -/
theorem orbitSL2_congr {g g' : p.base.support → Matrix.SpecialLinearGroup (Fin 2) K}
    (h : ∀ a ∈ O, g a = g' a) :
    orbitSL2 k K p x O hO g = orbitSL2 k K p x O hO g' := by
  rw [orbitSL2_apply, orbitSL2_apply]
  congr 1
  funext a
  exact Subtype.ext (congrArg (rootSL2 x (a : p.base.support)) (h a a.2))

section Descent

variable [FiniteDimensional k K] [IsGalois k K]

omit [Fintype O] [FiniteDimensional k K] [IsGalois k K] in
/-- Scalar extension of rational points of an affine group is injective. -/
theorem rationalExtend_injective_of_isAffineHom :
    Function.Injective (rationalExtend k K G) := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  intro y z h
  apply (rationalCoeffEquiv k G).injective
  apply GaloisPoint.extend_injective k K G
  simpa only [baseChangeCoeffEquiv_rationalExtend] using
    congrArg (baseChangeCoeffEquiv k K G) h

include hT hx hroot hOs in
/-- Orbit products of equivariant families are scalar extensions of rational points. -/
theorem exists_orbitSL2_eq_rationalExtend
    {g : p.base.support → Matrix.SpecialLinearGroup (Fin 2) K}
    (hg : g ∈ equivariantFamilies k K p ρ) :
    ∃ g₀ : rationalPoints G, rationalExtend k K G g₀ = orbitSL2 k K p x O hO g :=
  exists_rationalExtend_eq_of_fixed k K
    (orbitSL2_rationalConjugate k K i p eT hT x hx hroot O hOs hO hg)

/-- The descended orbit homomorphism on equivariant families. -/
def orbitSL2Rational : equivariantFamilies k K p ρ →* rationalPoints G where
  toFun g := Classical.choose
    (exists_orbitSL2_eq_rationalExtend k K i p eT hT x hx hroot O hOs hO g.2)
  map_one' := by
    apply rationalExtend_injective_of_isAffineHom k K
    rw [Classical.choose_spec
      (exists_orbitSL2_eq_rationalExtend k K i p eT hT x hx hroot O hOs hO
        (1 : equivariantFamilies k K p ρ).2), map_one]
    exact map_one _
  map_mul' g h := by
    apply rationalExtend_injective_of_isAffineHom k K
    rw [Classical.choose_spec
      (exists_orbitSL2_eq_rationalExtend k K i p eT hT x hx hroot O hOs hO (g * h).2), map_mul,
      Classical.choose_spec
        (exists_orbitSL2_eq_rationalExtend k K i p eT hT x hx hroot O hOs hO g.2),
      Classical.choose_spec
        (exists_orbitSL2_eq_rationalExtend k K i p eT hT x hx hroot O hOs hO h.2)]
    exact map_mul _ _ _

theorem rationalExtend_orbitSL2Rational (g : equivariantFamilies k K p ρ) :
    rationalExtend k K G (orbitSL2Rational k K i p eT hT x hx hroot O hOs hO g) =
      orbitSL2 k K p x O hO g :=
  Classical.choose_spec
    (exists_orbitSL2_eq_rationalExtend k K i p eT hT x hx hroot O hOs hO g.2)

/-- The rank-one homomorphism over `E`, descended to the rational points of `G`. -/
def fieldSL2 : Matrix.SpecialLinearGroup (Fin 2) E →* rationalPoints G :=
  (orbitSL2Rational k K i p eT hT x hx hroot O hOs hO).comp
    ((fieldFamilyPi k K p O τ).codRestrict _ (fieldFamilyPi_mem k K p O hOs τ hτ))

theorem rationalExtend_fieldSL2 (g : Matrix.SpecialLinearGroup (Fin 2) E) :
    rationalExtend k K G (fieldSL2 k K i p eT hT x hx hroot O hOs hO τ hτ g) =
      orbitSL2 k K p x O hO (fun a => Matrix.SpecialLinearGroup.map (τ a).toRingHom g) := by
  rw [fieldSL2, MonoidHom.comp_apply, rationalExtend_orbitSL2Rational]
  apply orbitSL2_congr
  intro a ha
  exact fieldFamilyPi_of_mem k K p O τ g ha

theorem rationalExtend_fieldSL2_upper (t : E) :
    rationalExtend k K G (fieldSL2 k K i p eT hT x hx hroot O hOs hO τ hτ (upper t)) =
      orbitXp k K p x O hO (fun a => τ a t) := by
  rw [rationalExtend_fieldSL2, ← orbitSL2_upper]
  congr 1
  funext a
  exact map_upper _ t

theorem rationalExtend_fieldSL2_lower (t : E) :
    rationalExtend k K G (fieldSL2 k K i p eT hT x hx hroot O hOs hO τ hτ (lower t)) =
      orbitXm k K p x O hO (fun a => τ a t) := by
  rw [rationalExtend_fieldSL2, ← orbitSL2_lower]
  congr 1
  funext a
  exact map_lower _ t

theorem rationalExtend_fieldSL2_diag (u : Eˣ) :
    rationalExtend k K G (fieldSL2 k K i p eT hT x hx hroot O hOs hO τ hτ (diag u)) =
      orbitCoroot k K p x O hO (fun a => Units.map (τ a).toRingHom.toMonoidHom u) := by
  rw [rationalExtend_fieldSL2, ← orbitSL2_diag]
  congr 1
  funext a
  exact map_diag _ u

end Descent

end Galois

end SplitPinning

end Langlands.GroupScheme
