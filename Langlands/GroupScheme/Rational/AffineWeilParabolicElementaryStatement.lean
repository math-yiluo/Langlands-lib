import Langlands.GroupScheme.Rational.AffineWeilPoints
import Langlands.GroupScheme.Rational.ElementarySubgroup
import Mathlib.FieldTheory.Separable

/-! # Parabolic radical generation under affine Weil restriction -/

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Borel–Tits 6.19 and 6.21(i) on rational points: for a finite separable
field extension `K/k` and a connected reductive group `G'` over `K`, the
published identification of the `k`-points of the affine Weil restriction
with `G'(K)` maps the subgroup generated by rational points of parabolic
unipotent radicals of the restriction onto the corresponding subgroup of
`G'(K)`. This is a statement only. -/
def AffineWeilParabolicElementarySubgroupStatement : Prop :=
  ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] [FiniteDimensional k K]
    [Algebra.IsSeparable k K] (G' : GroupScheme (Spec (CommRingCat.of K)))
    (hG' : IsConnectedReductive G'),
    haveI := hG'.isAffineHom
    haveI : IsAffine G'.X.left := isAffine_of_isAffineHom G'.X.hom
    haveI := hG'.smooth
    (parabolicElementarySubgroup (AffineWeil.groupScheme k K G')).map
        (AffineWeil.rationalPointsEquiv k K G').toMonoidHom =
      parabolicElementarySubgroup G'

end Langlands.GroupScheme
