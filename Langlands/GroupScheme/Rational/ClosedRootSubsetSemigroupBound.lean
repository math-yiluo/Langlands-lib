import Langlands.GroupScheme.Rational.ClosedRootSubsetStatements
import Langlands.GroupScheme.Rational.RootSubgroupTorusProduct
import Langlands.GroupScheme.Rational.GenericCentralizerProof
import Langlands.GroupScheme.Rational.DynamicSemigroupProof
import Langlands.GroupScheme.Rational.RelativeRootSignSupport
import Langlands.GroupScheme.Rational.WeightSemigroupSupport

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

open RelativeRoot

set_option backward.isDefEq.respectTransparency false

/-- The closed group generated by the torus centralizer and root groups for
`S` lies in the semigroup group of the additive monoid generated by `S`. -/
theorem IsRootSubsetGroup.range_le_addSubmonoidSemigroup
    {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
    (hG : IsConnectedReductive G) {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i)
    (ν : cocharacterLattice T)
    (hν : letI := hG.isAffineHom; IsGenericCocharacter i ν)
    {S : Set (characterLattice T)} (hS : letI := hG.isAffineHom; S ⊆ relativeRoots i)
    {H : GroupScheme (Spec (CommRingCat.of k))} {j : H ⟶ G}
    (hj : IsRootSubsetGroup i S j) :
    letI := hG.isAffineHom
    SubgroupFunctor.range j ≤ semigroupSubgroup (AutomorphicAction.conjugation i)
      (AddSubmonoid.closure S).toAddSubsemigroup := by
  let := hG.isAffineHom
  let := hG.smooth
  let := hG.connectedSpace
  let := hi.isSplitSubtorus.mono
  have hT := hi.isSplitSubtorus.1
  let A := (AddSubmonoid.closure S).toAddSubsemigroup
  let b := AutomorphicAction.conjugation i
  have hzero : (0 : characterLattice T) ∈ A := (AddSubmonoid.closure S).zero_mem
  have hc : torusCentralizer i ≤ semigroupSubgroup b A := by
    rw [← genericCentralizer k G hG T i hi ν hν,
      (dynamicSemigroupComparison k G inferInstance inferInstance inferInstance T hT i ν).2.1]
    apply semigroupSubgroup_mono_on_weightSupport
    apply (rootSupport_imp_iff_actionWeightSupport_imp i
      (fun χ => χ ∈ zeroSemigroup ν) (fun χ => χ ∈ A) (fun _ => hzero)).mp
    intro χ hχ hχzero
    exact (hν χ hχ hχzero).elim
  have hr (χ : characterLattice T) (hχ : χ ∈ S) :
      subgroup i χ ≤ semigroupSubgroup b A := by
    rw [← weightFiltration_one_eq_subgroup hT i χ (hS hχ).1]
    exact semigroupSubgroup_mono b
      (cyclicTail_one_le_of_mem (show χ ∈ A from AddSubmonoid.subset_closure hχ))
  obtain ⟨⟨K, q, hq, hqc, _, _⟩, _⟩ :=
    semigroupRealization k G inferInstance inferInstance T hT b A
  rw [← hq.2]
  apply hj.2.2.2 K q hqc
  · rw [hq.2]
    exact hc
  · intro χ hχ
    rw [hq.2]
    exact hr χ hχ

end Langlands.GroupScheme
