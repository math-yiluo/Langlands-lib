import Langlands.GroupScheme.Torus.ImageProof
import Langlands.GroupScheme.Torus.SplitOfDomination
import Langlands.GroupScheme.Torus.ExistenceProof
import Langlands.GroupScheme.Rational.SplitTorusFactorization

/-! # The closed torus generated by two commuting tori -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry CategoryTheory.MonoidalCategory
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]

/-- **The closed torus generated by two commuting tori.** Let `iS : S ⟶ G` and `t₁ : T₁ ⟶ G`
be homomorphisms into an affine group over a field `k` whose values commute, and let `K` be an
extension of `k` over which `S` and `T₁` are split. Then both maps factor through one closed
commutative subgroup `iT : T ⟶ G`, which is split over `K`. -/
theorem exists_closedTorus_of_commute (K : Type u) [Field K] [Algebra k K]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of k))} (iS : S.toGrp ⟶ G)
    {T₁ : GroupScheme (Spec (CommRingCat.of k))} (t₁ : T₁ ⟶ G)
    (hcomm : ∀ (U : Over (Spec (CommRingCat.of k))) (x : U ⟶ S.X) (y : U ⟶ T₁.X),
      Commute (x ≫ iS.hom.hom) (y ≫ t₁.hom.hom))
    (hS : IsSplitTorus ((baseChange (algebraBaseMap k K)).obj S.toGrp))
    (hT₁ : IsSplitTorus ((baseChange (algebraBaseMap k K)).obj T₁)) :
    ∃ (T : CommGroupScheme (Spec (CommRingCat.of k))) (iT : T.toGrp ⟶ G) (f : S ⟶ T)
      (g : T₁ ⟶ T.toGrp),
      CommGroupScheme.groupHom f ≫ iT = iS ∧ g ≫ iT = t₁ ∧ IsClosedSubgroup iT ∧
        IsSplitTorus ((baseChange (algebraBaseMap k K)).obj T.toGrp) := by
  let b := algebraBaseMap k K
  have : Flat b := TorusExistence.flat_algebraBaseMap K
  let E := S.toGrp ⊗ T₁
  have hEK : IsSplitTorus ((baseChange b).obj E) :=
    IsSplitTorus.of_iso (baseChangeTensorIso b S.toGrp T₁) (hS.tensor hT₁)
  have hE : IsTorus E := ⟨K, inferInstance, inferInstance, hEK⟩
  let e := prodHom iS t₁ hcomm
  have : QuasiCompact E.X.hom := hE.quasiCompact
  have : QuasiCompact (e.hom.hom.left ≫ G.X.hom) := by
    simpa only [Over.w e.hom.hom] using ‹QuasiCompact E.X.hom›
  have : QuasiCompact e.hom.hom.left := QuasiCompact.of_comp e.hom.hom.left G.X.hom
  have hI : IsTorus (SchematicImage.image e) := hE.isTorus_schematicImage e
  let T : CommGroupScheme (Spec (CommRingCat.of k)) :=
    { SchematicImage.image e with comm := hI.isCommMonObj }
  have hp : IsSchemeTheoreticallyDominant
      ((baseChange b).map (SchematicImage.projection e)).hom.hom.left :=
    isSchemeTheoreticallyDominant_baseChange b (SchematicImage.projection e)
  have : IsAffineHom ((baseChange b).obj T.toGrp).X.hom := by
    change IsAffineHom (CategoryTheory.Limits.pullback.snd (SchematicImage.image e).X.hom b)
    infer_instance
  refine ⟨T, SchematicImage.inclusion e,
    Additive.ofMul (prodInl S.toGrp T₁ ≫ SchematicImage.projection e),
    prodInr S.toGrp T₁ ≫ SchematicImage.projection e, ?_, ?_,
    inferInstanceAs (IsClosedImmersion (SchematicImage.inclusion e).hom.hom.left),
    IsSplitTorus.of_schematicallyDominant_hom hEK
      ((baseChange b).map (SchematicImage.projection e)) hp⟩
  · change (prodInl S.toGrp T₁ ≫ SchematicImage.projection e) ≫ SchematicImage.inclusion e = iS
    rw [Category.assoc, SchematicImage.projection_inclusion, prodInl_prodHom]
  · rw [Category.assoc, SchematicImage.projection_inclusion, prodInr_prodHom]

/-- If `g ≫ i` is a closed subgroup, where `g : A ⟶ B` is a homomorphism of split tori with
`A ≅ splitTorus I` and `B ≅ splitTorus J`, then `|I| ≤ |J|`. -/
theorem card_le_card_of_comp_isClosedSubgroup {A B G : GroupScheme (Spec (CommRingCat.of k))}
    (g : A ⟶ B) (i : B ⟶ G) (hgi : IsClosedSubgroup (g ≫ i)) (I J : Type u) [Finite I]
    [Finite J] (eA : A ≅ splitTorus (Spec (CommRingCat.of k)) I)
    (eB : B ≅ splitTorus (Spec (CommRingCat.of k)) J) : Nat.card I ≤ Nat.card J := by
  have : IsClosedImmersion (g ≫ i).hom.hom.left := hgi
  have hm : Mono (g ≫ i).hom.hom := Over.mono_of_mono_left _
  have : Mono g.hom.hom := by
    have : Mono (g.hom.hom ≫ i.hom.hom) := hm
    exact mono_of_mono g.hom.hom i.hom.hom
  have : IsIso eA.inv.hom.hom := inferInstanceAs (IsIso ((Grp.forget _).mapIso eA).inv)
  have : IsIso eB.hom.hom.hom := inferInstanceAs (IsIso ((Grp.forget _).mapIso eB).hom)
  let m : splitTorus (Spec (CommRingCat.of k)) I ⟶ splitTorus (Spec (CommRingCat.of k)) J :=
    eA.inv ≫ g ≫ eB.hom
  have : Mono m.hom.hom := by
    change Mono (eA.inv.hom.hom ≫ g.hom.hom ≫ eB.hom.hom.hom)
    infer_instance
  exact splitTorus.card_le_card_of_mono I J m

end Langlands.GroupScheme
