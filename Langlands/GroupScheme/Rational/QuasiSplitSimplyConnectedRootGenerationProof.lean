import Langlands.GroupScheme.Rational.QuasiSplitSimplyConnectedRootGenerationStatement
import Langlands.GroupScheme.Rational.QuasiSplitCentralizerRootGeneration

/-! # Proof of quasi-split simply connected rational root generation

The closing proof of `QuasiSplitSimplyConnectedRootGenerationStatement.{u}`. It applies the
published theorem `quasiSplitSimplyConnectedRootGeneration` of module
`Langlands.GroupScheme.Rational.QuasiSplitCentralizerRootGeneration`. -/

universe u

namespace Langlands.GroupScheme

/-- **Steinberg's generation theorem** (recalled in Platonov–Rapinchuk 1994, §7.2): over every
field, the rational points of a quasi-split simply connected group are generated by the
rational points of the actual relative-root groups of any maximal split torus. -/
theorem quasiSplitSimplyConnectedRootGenerationStatement_proof :
    QuasiSplitSimplyConnectedRootGenerationStatement.{u} :=
  quasiSplitSimplyConnectedRootGeneration

end Langlands.GroupScheme
