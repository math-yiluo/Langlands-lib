import Langlands.AlgebraicGeometry.GeometricallyReducedOfAlgClosedProof
import Langlands.GroupScheme.Rational.SplitSeriesExtension
import Langlands.GroupScheme.Rational.AdditiveGroupQuotient
import Langlands.GroupScheme.SemidirectProduct
import Langlands.GroupScheme.DominantHomFlat
import Langlands.GroupScheme.HomogeneousQuotientProof
import Langlands.GroupScheme.NormalQuotientGroup
import Langlands.GroupScheme.CentralIsogeny.Basic
import Langlands.AlgebraicGeometry.SmoothReducedProof

/-! # Split series of groups generated by a split normal subgroup and a split subgroup -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
  CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry Opposite
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeRoot

namespace SplitSemidirect

section Generic

variable {S : Scheme.{u}}

/-- A morphism into a group whose composite with a monic homomorphism is a homomorphism is
itself a homomorphism. -/
theorem isMonHom_of_comp_eq {G D : GroupScheme S} {X : Over S} [GrpObj X]
    (inc : D ⟶ G) [Mono inc.hom.hom] (g : X ⟶ D.X) (f : X ⟶ G.X) [IsMonHom f]
    (h : g ≫ inc.hom.hom = f) : IsMonHom g :=
  Semidirect.isMonHom_of_mul_comp g fun x y => by
    apply (cancel_mono inc.hom.hom).mp
    rw [Category.assoc, h, MonObj.mul_comp, MonObj.mul_comp, Category.assoc, Category.assoc, h]

/-- Membership in the range of a monic homomorphism descends along a flat, surjective and
quasi-compact morphism of tests. -/
theorem mem_range_of_comp_mem {G D : GroupScheme S} (inc : D ⟶ G) [Mono inc.hom.hom.left]
    {T T' : Over S} (π : T' ⟶ T) [QuasiCompact π.left] [Flat π.left] [Surjective π.left]
    {c : T ⟶ G.X} (h : π ≫ c ∈ (SubgroupFunctor.range inc).carrier T') :
    c ∈ (SubgroupFunctor.range inc).carrier T := by
  obtain ⟨y, hy⟩ := SubgroupFunctor.mem_range.mp h
  have hy' : y.left ≫ inc.hom.hom.left = π.left ≫ c.left := by
    rw [← Over.comp_left, hy, Over.comp_left]
  let s : T.left ⟶ D.X.left := EffectiveEpi.desc π.left y.left (fun {Z} g₁ g₂ he => by
    apply (cancel_mono inc.hom.hom.left).mp
    rw [Category.assoc, Category.assoc, hy', ← Category.assoc, he, Category.assoc])
  have hs : π.left ≫ s = y.left := EffectiveEpi.fac _ _ _
  have hsi : s ≫ inc.hom.hom.left = c.left := by
    apply (cancel_epi π.left).mp
    rw [← Category.assoc, hs, hy']
  refine SubgroupFunctor.mem_range.mpr ⟨Over.homMk s ?_, ?_⟩
  · rw [← Over.w inc.hom.hom, ← Category.assoc, hsi, Over.w c]
  · exact Over.OverMorphism.ext hsi

/-- Points in the range of the kernel inclusion are killed. -/
theorem comp_eq_one_of_mem {G Q D : GroupScheme S} {inc : D ⟶ G} {π : G ⟶ Q}
    (hker : SubgroupFunctor.range (kernelι π) = SubgroupFunctor.range inc) {T : Over S}
    (z : T ⟶ D.X) : (z ≫ inc.hom.hom) ≫ π.hom.hom = 1 := by
  rw [← mem_range_kernelι_iff, hker]
  exact SubgroupFunctor.mem_range.mpr ⟨z, rfl⟩

/-- The morphism `(n, h) ↦ j n * i h` from `N × H` to `P`. -/
def mulPoints {N H P : GroupScheme S} (j : N ⟶ P) (i : H ⟶ P) : N.X ⊗ H.X ⟶ P.X :=
  (fst N.X H.X ≫ j.hom.hom) * (snd N.X H.X ≫ i.hom.hom)

/-- For normal `range j`, `mulPoints j i` is the multiplication morphism of the semidirect
product `N ⋊ H`. -/
theorem mulPoints_eq_mulMap {N H P : GroupScheme S} (j : N ⟶ P) (i : H ⟶ P) [Mono j.hom.hom]
    (hN : (SubgroupFunctor.range j).IsNormal) :
    mulPoints j i = Semidirect.mulMap (Semidirect.conjStable_of_isNormal i j hN) :=
  rfl

end Generic

/-- A flat surjective morphism onto a scheme from a reduced scheme has reduced target. -/
theorem isReduced_of_flat_of_surjective {X Y : Scheme.{u}} (f : X ⟶ Y) [Flat f] [Surjective f]
    [IsReduced X] : IsReduced Y := by
  exact Langlands.AlgebraicGeometry.GeometricallyReducedOfAlgClosedProof.isReduced_of_flat_of_surjective f

section Field

variable {k : Type u} [Field k]

/-- The interface of images of homomorphisms used by the induction: a homomorphism from a smooth
connected affine group to a smooth affine group over a field factors through a smooth connected
affine closed subgroup by a flat, surjective and quasi-compact homomorphism. -/
def HomImageHypothesis (k : Type u) [Field k] : Prop :=
  ∀ (A G : GroupScheme (Spec (CommRingCat.of k))) (φ : A ⟶ G),
    Smooth A.X.hom → ConnectedSpace A.X.left → IsAffineHom A.X.hom →
    Smooth G.X.hom → IsAffineHom G.X.hom →
    ∃ (D : GroupScheme (Spec (CommRingCat.of k))) (inc : D ⟶ G) (fac : A ⟶ D),
      IsClosedSubgroup inc ∧ fac ≫ inc = φ ∧ Flat fac.hom.hom.left ∧
        Surjective fac.hom.hom.left ∧ QuasiCompact fac.hom.hom.left ∧
        Smooth D.X.hom ∧ ConnectedSpace D.X.left ∧ IsAffineHom D.X.hom

/-- The group identity behind normality of `N K` in `N H`. -/
theorem conj_mem_of {G : Type*} [Group G] (R : Subgroup G) {a b c d : G} (ha : a ∈ R)
    (hbc : b * c * b⁻¹ ∈ R) (hbd : b * d * b⁻¹ ∈ R) : (a * b) * (c * d) * (a * b)⁻¹ ∈ R := by
  have h : (a * b) * (c * d) * (a * b)⁻¹ = a * (b * c * b⁻¹) * (b * d * b⁻¹) * a⁻¹ := by group
  rw [h]
  exact R.mul_mem (R.mul_mem (R.mul_mem ha hbc) hbd) (R.inv_mem ha)

private abbrev fpqcProperty : MorphismProperty Scheme.{u} :=
  @QuasiCompact ⊓ (@Flat ⊓ @Surjective)

set_option backward.isDefEq.respectTransparency false in
/-- Splitness of a smooth affine group generated by a split normal closed subgroup `N` and the
image of a split group `H`, by induction on the length of the series of `H`. -/
theorem isSplitUnipotent_of_surjective (hIm : HomImageHypothesis k) (n : ℕ) :
    ∀ {P N H : GroupScheme (Spec (CommRingCat.of k))} [Smooth P.X.hom] [IsAffineHom P.X.hom]
      [Smooth N.X.hom] [ConnectedSpace N.X.left] [Smooth H.X.hom] [ConnectedSpace H.X.left]
      [IsAffineHom H.X.hom] (j : N ⟶ P) (i : H ⟶ P), IsClosedSubgroup j →
      (SubgroupFunctor.range j).IsNormal → IsSplitUnipotent N → HasSplitSeries n H →
      Surjective (mulPoints j i).left → IsSplitUnipotent P := by
  induction n with
  | zero =>
    intro P N H _ _ _ _ _ _ _ j i hj hN hNs hH hsurj
    obtain ⟨m, hm⟩ := hNs
    have : IsClosedImmersion j.hom.hom.left := hj
    have hsnd : snd N.X H.X ≫ i.hom.hom = 1 := by
      have h : snd N.X H.X ∈ (SubgroupFunctor.range (𝟙 H)).carrier _ :=
        SubgroupFunctor.mem_range.mpr ⟨snd N.X H.X, Category.comp_id _⟩
      rw [hH, SubgroupFunctor.bot_carrier, Subgroup.mem_bot] at h
      rw [h, MonObj.one_comp]
    rw [mulPoints, hsnd, _root_.mul_one, Over.comp_left] at hsurj
    have : Surjective j.hom.hom.left := Surjective.of_comp (fst N.X H.X).left j.hom.hom.left
    have : IsReduced P.X.left :=
      AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k _ P.X.hom
    have : IsIso j.hom.hom.left := isIso_of_isClosedImmersion_of_surjective _
    have hid : IsClosedSubgroup (𝟙 P) := by
      show IsClosedImmersion (𝟙 P.X.left)
      infer_instance
    have hrange : SubgroupFunctor.range j = SubgroupFunctor.range (𝟙 P) := by
      apply SubgroupFunctor.ext
      intro T
      ext x
      constructor
      · intro _
        exact SubgroupFunctor.mem_range.mpr ⟨x, Category.comp_id _⟩
      · intro _
        refine SubgroupFunctor.mem_range.mpr ⟨Over.homMk (x.left ≫ inv j.hom.hom.left) ?_, ?_⟩
        · rw [← Over.w j.hom.hom, Category.assoc, IsIso.inv_hom_id_assoc, Over.w x]
        · exact Over.OverMorphism.ext (by simp)
    exact ⟨m, HasSplitSeries.of_iso (IsClosedSubgroup.sourceIsoOfRangeEq hj hid hrange) hm⟩
  | succ n ih =>
    intro P N H _ _ _ _ _ _ _ j i hj hN hNs hH hsurj
    obtain ⟨K, V, jK, qK, hjK, hKs, hKc, hKn, hqK, hV, hK⟩ := hH
    have : Smooth K.X.hom := hKs
    have : ConnectedSpace K.X.left := hKc
    have : IsClosedImmersion j.hom.hom.left := hj
    have : Mono j.hom.hom := Over.mono_of_mono_left _
    have : IsClosedImmersion jK.hom.hom.left := hjK
    have : IsAffineHom K.X.hom := by
      rw [← Over.w jK.hom.hom]
      infer_instance
    have : IsAffineHom N.X.hom := by
      rw [← Over.w j.hom.hom]
      infer_instance
    have : IsReduced P.X.left :=
      AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k _ P.X.hom
    have : IsLocallyNoetherian P.X.left := LocallyOfFiniteType.isLocallyNoetherian P.X.hom
    have : GeometricallyConnected N.X.hom := geometricallyConnected_of_connected N
    -- the semidirect product `N ⋊ K` and its image `D` in `P`
    let hc : Semidirect.ConjStable (jK ≫ i) j := Semidirect.conjStable_of_isNormal (jK ≫ i) j hN
    have hAs : Smooth (Semidirect.group hc).X.hom :=
      show Smooth (pullback.fst N.X.hom K.X.hom ≫ N.X.hom) by infer_instance
    have : IsAffineHom (pullback.fst N.X.hom K.X.hom) :=
      MorphismProperty.pullback_fst _ _ inferInstance
    have hAa : IsAffineHom (Semidirect.group hc).X.hom :=
      show IsAffineHom (pullback.fst N.X.hom K.X.hom ≫ N.X.hom) by infer_instance
    have hAc : ConnectedSpace (Semidirect.group hc).X.left :=
      show ConnectedSpace ↥(Limits.pullback N.X.hom K.X.hom) by infer_instance
    obtain ⟨D, inc, fac, hinc, hfac, hfl, hsu, hqc, hDs, hDc, hDa⟩ :=
      hIm _ P (Semidirect.mulHom hc) hAs hAc hAa inferInstance inferInstance
    have : IsClosedImmersion inc.hom.hom.left := hinc
    have : Mono inc.hom.hom := Over.mono_of_mono_left _
    have : Smooth D.X.hom := hDs
    have : ConnectedSpace D.X.left := hDc
    have : IsAffineHom D.X.hom := hDa
    have : Flat fac.hom.hom.left := hfl
    have : Surjective fac.hom.hom.left := hsu
    have : QuasiCompact fac.hom.hom.left := hqc
    have hfac' : fac.hom.hom ≫ inc.hom.hom = Semidirect.mulMap hc := by
      rw [← Grp.comp_hom_hom, hfac]
      exact Semidirect.mulHom_hom_hom hc
    -- `N` and `K` inside `D`
    let j₀ : N.X ⟶ D.X := (Semidirect.conjAction hc).inl ≫ fac.hom.hom
    have hj₀ : j₀ ≫ inc.hom.hom = j.hom.hom := by
      rw [Category.assoc, hfac', Semidirect.inl_mulMap]
    let i₀ : K.X ⟶ D.X := (Semidirect.conjAction hc).inr ≫ fac.hom.hom
    have hi₀ : i₀ ≫ inc.hom.hom = jK.hom.hom ≫ i.hom.hom := by
      rw [Category.assoc, hfac', Semidirect.inr_mulMap, Grp.comp_hom_hom]
    have : IsMonHom j₀ := isMonHom_of_comp_eq inc j₀ j.hom.hom hj₀
    have : IsMonHom i₀ := isMonHom_of_comp_eq inc i₀ (jK.hom.hom ≫ i.hom.hom) hi₀
    let j' : N ⟶ D := Grp.homMk j₀
    let i' : K ⟶ D := Grp.homMk i₀
    have hj' : IsClosedSubgroup j' := by
      have : IsClosedImmersion (j₀.left ≫ inc.hom.hom.left) := by
        rw [← Over.comp_left, hj₀]
        infer_instance
      exact IsClosedImmersion.of_comp_isClosedImmersion j₀.left inc.hom.hom.left
    have hN' : (SubgroupFunctor.range j').IsNormal := by
      intro T g x _ hx
      obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
      obtain ⟨z, hz⟩ := SubgroupFunctor.mem_range.mp
        (hN T (g ≫ inc.hom.hom) (y ≫ j.hom.hom) (Subgroup.mem_top _)
          (SubgroupFunctor.mem_range.mpr ⟨y, rfl⟩))
      refine SubgroupFunctor.mem_range.mpr ⟨z, ?_⟩
      apply (cancel_mono inc.hom.hom).mp
      change (z ≫ j₀) ≫ inc.hom.hom = (g * (y ≫ j₀) * g⁻¹) ≫ inc.hom.hom
      rw [Category.assoc, hj₀, hz, MonObj.mul_comp, MonObj.mul_comp, GrpObj.inv_comp,
        Category.assoc, hj₀]
    have hsurj' : Surjective (mulPoints j' i').left := by
      have he : mulPoints j' i' = fac.hom.hom := by
        apply (cancel_mono inc.hom.hom).mp
        change ((fst N.X K.X ≫ j₀) * (snd N.X K.X ≫ i₀)) ≫ inc.hom.hom = _
        rw [MonObj.mul_comp, Category.assoc (fst N.X K.X) j₀, hj₀, Category.assoc (snd N.X K.X) i₀,
          hi₀, hfac']
        rfl
      rw [he]
      infer_instance
    obtain ⟨r, hr⟩ := ih j' i' hj' hN' hNs hK hsurj'
    -- the flat cover of `P` by `N ⋊ H`
    let hcH : Semidirect.ConjStable i j := Semidirect.conjStable_of_isNormal i j hN
    have : Smooth (Semidirect.group hcH).X.hom :=
      show Smooth (pullback.fst N.X.hom H.X.hom ≫ N.X.hom) by infer_instance
    have : IsAffineHom (pullback.fst N.X.hom H.X.hom) :=
      MorphismProperty.pullback_fst _ _ inferInstance
    have : IsAffineHom (Semidirect.group hcH).X.hom :=
      show IsAffineHom (pullback.fst N.X.hom H.X.hom ≫ N.X.hom) by infer_instance
    have : Surjective (Semidirect.mulHom hcH).hom.hom.left := hsurj
    have : QuasiCompact (Semidirect.mulHom hcH).hom.hom.left := by
      have : QuasiCompact ((Semidirect.mulHom hcH).hom.hom.left ≫ P.X.hom) := by
        rw [Over.w]
        infer_instance
      exact QuasiCompact.of_comp _ P.X.hom
    have : LocallyOfFiniteType (Semidirect.mulHom hcH).hom.hom.left := by
      have : LocallyOfFiniteType ((Semidirect.mulHom hcH).hom.hom.left ≫ P.X.hom) := by
        rw [Over.w]
        infer_instance
      exact locallyOfFiniteType_of_comp _ P.X.hom
    have : Flat (Semidirect.mulHom hcH).hom.hom.left :=
      DominantHomFlat.flat_of_isDominant (Semidirect.mulHom hcH)
    -- normality of `D` in `P`
    have hmem : ∀ {T : Over (Spec (CommRingCat.of k))} (nn : T ⟶ N.X) (hh : T ⟶ H.X)
        (n₁ : T ⟶ N.X) (k₁ : T ⟶ K.X),
        ((nn ≫ j.hom.hom) * (hh ≫ i.hom.hom)) *
            ((n₁ ≫ j.hom.hom) * (k₁ ≫ jK.hom.hom ≫ i.hom.hom)) *
            ((nn ≫ j.hom.hom) * (hh ≫ i.hom.hom))⁻¹ ∈
          (SubgroupFunctor.range inc).carrier T := by
      intro T nn hh n₁ k₁
      have hjmem : ∀ n : T ⟶ N.X, n ≫ j.hom.hom ∈ (SubgroupFunctor.range inc).carrier T :=
        fun n => SubgroupFunctor.mem_range.mpr ⟨n ≫ j₀, by rw [Category.assoc, hj₀]⟩
      apply conj_mem_of _ (hjmem nn)
      · obtain ⟨n₂, hn₂⟩ := SubgroupFunctor.mem_range.mp
          (hN T (hh ≫ i.hom.hom) (n₁ ≫ j.hom.hom) (Subgroup.mem_top _)
            (SubgroupFunctor.mem_range.mpr ⟨n₁, rfl⟩))
        rw [← hn₂]
        exact hjmem n₂
      · obtain ⟨k₂, hk₂⟩ := SubgroupFunctor.mem_range.mp
          (hKn T hh (k₁ ≫ jK.hom.hom) (Subgroup.mem_top _)
            (SubgroupFunctor.mem_range.mpr ⟨k₁, rfl⟩))
        have h2 : (k₂ ≫ i₀) ≫ inc.hom.hom =
            (hh ≫ i.hom.hom) * (k₁ ≫ jK.hom.hom ≫ i.hom.hom) * (hh ≫ i.hom.hom)⁻¹ := by
          rw [Category.assoc, hi₀, ← Category.assoc, hk₂, MonObj.mul_comp, MonObj.mul_comp,
            GrpObj.inv_comp, Category.assoc]
        rw [← h2]
        exact SubgroupFunctor.mem_range.mpr ⟨_, rfl⟩
    have hDn : (SubgroupFunctor.range inc).IsNormal := by
      let c : P.X ⊗ D.X ⟶ P.X :=
        fst P.X D.X * (snd P.X D.X ≫ inc.hom.hom) * (fst P.X D.X)⁻¹
      let π : (Semidirect.group hcH).X ⊗ (Semidirect.group hc).X ⟶ P.X ⊗ D.X :=
        (Semidirect.mulHom hcH).hom.hom ⊗ₘ fac.hom.hom
      have hp : fpqcProperty π.left :=
        MorphismProperty.pullbackMap (P := fpqcProperty)
          ⟨inferInstance, inferInstance, inferInstance⟩
          ⟨inferInstance, inferInstance, inferInstance⟩
          (Over.w (Semidirect.mulHom hcH).hom.hom).symm (Over.w fac.hom.hom).symm
      have : QuasiCompact π.left := hp.1
      have : Flat π.left := hp.2.1
      have : Surjective π.left := hp.2.2
      have hcmem : c ∈ (SubgroupFunctor.range inc).carrier (P.X ⊗ D.X) := by
        apply mem_range_of_comp_mem inc π
        have e1 : π ≫ fst P.X D.X =
            fst _ _ ≫ (Semidirect.mulHom hcH).hom.hom := by
          simp [π]
        have e2 : π ≫ snd P.X D.X = snd _ _ ≫ fac.hom.hom := by
          simp [π]
        have hπc : π ≫ c = (π ≫ fst P.X D.X) * ((π ≫ snd P.X D.X) ≫ inc.hom.hom) *
            (π ≫ fst P.X D.X)⁻¹ := by
          simp only [c, MonObj.comp_mul, GrpObj.comp_inv, Category.assoc]
        rw [hπc, e1, e2, Category.assoc, hfac']
        have := hmem (fst _ _ ≫ (Semidirect.conjAction hcH).left)
          (fst _ _ ≫ (Semidirect.conjAction hcH).right)
          (snd _ _ ≫ (Semidirect.conjAction hc).left)
          (snd _ _ ≫ (Semidirect.conjAction hc).right)
        simpa only [Semidirect.mulHom_hom_hom, Semidirect.mulMap, MonObj.comp_mul,
          Category.assoc, Grp.comp_hom_hom] using this
      intro T g x _ hx
      obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
      have h := (SubgroupFunctor.range inc).comp_mem (lift g y) hcmem
      simpa only [c, MonObj.comp_mul, GrpObj.comp_inv, lift_fst, lift_snd_assoc] using h
    -- the quotient `Q = P / D`
    obtain ⟨Q, πQ, hπQ, hQsep, hQlft, hqcπ⟩ : ∃ (Q : GroupScheme (Spec (CommRingCat.of k)))
        (πQ : P ⟶ Q), IsFppfQuotient (SubgroupFunctor.range inc) πQ ∧ IsSeparated Q.X.hom ∧
          LocallyOfFiniteType Q.X.hom ∧ QuasiCompact πQ.hom.hom.left := by
      obtain ⟨Q₀, π₀, hsep, hlft, -, hsmπ, hsuπ, hqcπ, hfib⟩ :=
        smoothSubgroupQuotientExistence k P D inc hinc hDs
      have : Smooth π₀.left := hsmπ
      have : Surjective π₀.left := hsuπ
      have : QuasiCompact π₀.left := hqcπ
      exact ⟨_, NormalQuotient.hom P _ hDn π₀ hfib, NormalQuotient.isFppfQuotient P _ hDn π₀ hfib,
        hsep, hlft, hqcπ⟩
    have hker := hπQ.2.2.2
    have : IsSeparated Q.X.hom := hQsep
    have : LocallyOfFiniteType Q.X.hom := hQlft
    have : QuasiCompact πQ.hom.hom.left := hqcπ
    have : Flat πQ.hom.hom.left := hπQ.1
    have : Surjective πQ.hom.hom.left := hπQ.2.1
    -- the descended map `ψ : V ⟶ Q`
    have hk : kernelι qK ≫ (i ≫ πQ) = 0 := by
      apply Grp.hom_ext
      change (kernelι qK).hom.hom ≫ (i ≫ πQ).hom.hom = 1
      have hx : (kernelι qK).hom.hom ∈ (SubgroupFunctor.range jK).carrier _ := by
        rw [← hqK.2.2.2]
        exact SubgroupFunctor.mem_range.mpr ⟨𝟙 _, Category.id_comp _⟩
      obtain ⟨y, hy⟩ := SubgroupFunctor.mem_range.mp hx
      rw [← hy, Grp.comp_hom_hom, ← Category.assoc, Category.assoc y, ← hi₀, ← Category.assoc]
      exact comp_eq_one_of_mem hker _
    obtain ⟨e, he⟩ := id hV
    have : IsAffine V.X.left := AdditiveGroupQuotient.isAffine e he
    have hVa : IsAffineHom V.X.hom := by
      rw [← Over.w (AdditiveGroupQuotient.lineIso e he).hom]
      exact (inferInstance : IsAffineHom ((AdditiveGroupQuotient.lineIso e he).hom.left ≫
        (𝔸(PUnit; Spec (CommRingCat.of k)) ↘ Spec (CommRingCat.of k))))
    have hVs : Smooth V.X.hom := by
      rw [← Over.w (AdditiveGroupQuotient.lineIso e he).hom]
      exact (inferInstance : Smooth ((AdditiveGroupQuotient.lineIso e he).hom.left ≫
        (𝔸(PUnit; Spec (CommRingCat.of k)) ↘ Spec (CommRingCat.of k))))
    have : Flat qK.hom.hom.left := hqK.1
    have : Surjective qK.hom.hom.left := hqK.2.1
    have : QuasiCompact qK.hom.hom.left := by
      have : QuasiCompact (qK.hom.hom.left ≫ V.X.hom) := by
        rw [Over.w]
        infer_instance
      exact QuasiCompact.of_comp _ V.X.hom
    let ψ : V ⟶ Q := FpqcHomDescent.hom qK (i ≫ πQ) hk
    have hψ : qK.hom.hom ≫ ψ.hom.hom = i.hom.hom ≫ πQ.hom.hom := by
      rw [← Grp.comp_hom_hom, FpqcHomDescent.fac qK (i ≫ πQ) hk, Grp.comp_hom_hom]
    have hjπ : j.hom.hom ≫ πQ.hom.hom = 1 := by
      rw [← hj₀]
      exact comp_eq_one_of_mem hker j₀
    have hmulπ : (Semidirect.mulHom hcH).hom.hom ≫ πQ.hom.hom =
        snd N.X H.X ≫ qK.hom.hom ≫ ψ.hom.hom := by
      rw [hψ]
      simp only [Semidirect.mulHom_hom_hom, Semidirect.mulMap, MonObj.mul_comp, Category.assoc,
        hjπ, MonObj.comp_one, _root_.one_mul]
      rfl
    have : Surjective ψ.hom.hom.left := by
      have hs : Surjective ((Semidirect.mulHom hcH).hom.hom ≫ πQ.hom.hom).left := by
        rw [Over.comp_left]
        infer_instance
      rw [hmulπ, Over.comp_left, Over.comp_left, ← Category.assoc] at hs
      exact Surjective.of_comp ((snd N.X H.X).left ≫ qK.hom.hom.left) ψ.hom.hom.left
    have : IsReduced Q.X.left := isReduced_of_flat_of_surjective πQ.hom.hom.left
    have : IsLocallyNoetherian Q.X.left := LocallyOfFiniteType.isLocallyNoetherian Q.X.hom
    have : LocallyOfFiniteType ψ.hom.hom.left := by
      have : LocallyOfFiniteType (ψ.hom.hom.left ≫ Q.X.hom) := by
        rw [Over.w]
        infer_instance
      exact locallyOfFiniteType_of_comp _ Q.X.hom
    have : QuasiCompact ψ.hom.hom.left := by
      have : QuasiCompact (ψ.hom.hom.left ≫ Q.X.hom) := by
        rw [Over.w]
        infer_instance
      exact QuasiCompact.of_comp _ Q.X.hom
    have : Flat ψ.hom.hom.left := DominantHomFlat.flat_of_isDominant ψ
    rcases trivial_or_isVectorGroup_of_flat_surjective hV ψ with h0 | h1
    · exact ⟨r + 0, HasSplitSeries.of_fppfQuotient_of_field hr inc πQ hinc hqcπ hπQ h0⟩
    · exact ⟨r + 1, D, Q, inc, πQ, hinc, hDs, hDc, hDn, hπQ, h1, hr⟩

end Field

end SplitSemidirect

end Langlands.GroupScheme.RelativeRoot
