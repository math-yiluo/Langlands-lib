import Langlands.GroupScheme.Rational.TorusDominationBaseChange
import Langlands.GroupScheme.Torus.FiniteGaloisSplittingProof

/-! # Finite Galois split-torus domination -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
variable {H : GroupScheme (Spec (CommRingCat.of k))}

/-- A pointed torus parametrization of a reduced affine group becomes a
pointed split-torus parametrization over a finite Galois extension. -/
theorem HasPointedTorusDomination.exists_finiteGalois_splitDomination_of_isReduced
    [IsReduced H.X.left] [IsAffineHom H.X.hom]
    (h : HasPointedTorusDomination H) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra k L),
      FiniteDimensional k L ∧ IsGalois k L ∧
        HasPointedSplitTorusDomination ((GroupScheme.baseChange
          (Spec.map (CommRingCat.ofHom (algebraMap k L)))).obj H) := by
  obtain ⟨P, p, hP, hd, hp⟩ := h
  obtain ⟨L, hL, hA, hfin, hgal, hsplit⟩ := torusFiniteGaloisSplitting k P hP
  exact ⟨L, hL, hA, hfin, hgal, _, (Over.pullback _).map p, hsplit,
    PointedTorusDomination.isDominant_baseChange hP p hd,
    PointedTorusDomination.pullback_map_one _ p hp⟩

/-- The finite Galois splitting field can be chosen for every pointed
parametrization of a smooth affine group by a torus. -/
theorem HasPointedTorusDomination.exists_finiteGalois_splitDomination
    [Smooth H.X.hom] [IsAffineHom H.X.hom]
    (h : HasPointedTorusDomination H) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra k L),
      FiniteDimensional k L ∧ IsGalois k L ∧
        HasPointedSplitTorusDomination ((GroupScheme.baseChange
          (Spec.map (CommRingCat.ofHom (algebraMap k L)))).obj H) := by
  have : ConnectedSpace H.X.left := h.connectedSpace
  have : GeometricallyIntegral H.X.hom :=
    smoothConnectedAffineGeometry.1 k H inferInstance inferInstance inferInstance
  have : IsReduced H.X.left :=
    GeometricallyReduced.isReduced_of_flat_of_isLocallyNoetherian H.X.hom
  exact h.exists_finiteGalois_splitDomination_of_isReduced

/-- A smooth affine group generated by its ground-field tori has a pointed
split-torus parametrization after some finite Galois extension. -/
theorem IsTorusGenerated.exists_finiteGalois_splitDomination
    [Smooth H.X.hom] [IsAffineHom H.X.hom] (hH : IsTorusGenerated H) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra k L),
      FiniteDimensional k L ∧ IsGalois k L ∧
        HasPointedSplitTorusDomination ((GroupScheme.baseChange
          (Spec.map (CommRingCat.ofHom (algebraMap k L)))).obj H) :=
  hH.hasPointedTorusDomination.exists_finiteGalois_splitDomination

/-- Actual finite Galois field and pointed split-torus parametrization of the
base-changed group, with all witnesses retained for further constructions. -/
structure FiniteGaloisSplitTorusDomination
    (H : GroupScheme (Spec (CommRingCat.of k))) where
  carrier : Type u
  [field : Field carrier]
  [algebra : Algebra k carrier]
  [finiteDimensional : FiniteDimensional k carrier]
  [isGalois : IsGalois k carrier]
  torus : GroupScheme (Spec (CommRingCat.of carrier))
  parametrization : torus.X ⟶ ((GroupScheme.baseChange
    (Spec.map (CommRingCat.ofHom (algebraMap k carrier)))).obj H).X
  isSplitTorus : IsSplitTorus torus
  dominant : IsDominant parametrization.left
  pointed : (1 : Over.mk (𝟙 (Spec (CommRingCat.of carrier))) ⟶ torus.X) ≫
    parametrization = 1

attribute [instance] FiniteGaloisSplitTorusDomination.field
  FiniteGaloisSplitTorusDomination.algebra
  FiniteGaloisSplitTorusDomination.finiteDimensional
  FiniteGaloisSplitTorusDomination.isGalois

/-- Choose the actual finite Galois extension and split-torus parametrization
supplied by pointed torus domination of a smooth affine group. -/
def HasPointedTorusDomination.finiteGaloisSplitDomination
    [Smooth H.X.hom] [IsAffineHom H.X.hom]
    (h : HasPointedTorusDomination H) : FiniteGaloisSplitTorusDomination H :=
  Classical.choice (by
    obtain ⟨L, hL, hA, hfin, hgal, P, p, hP, hd, hp⟩ :=
      h.exists_finiteGalois_splitDomination
    exact ⟨{
      carrier := L
      field := hL
      algebra := hA
      finiteDimensional := hfin
      isGalois := hgal
      torus := P
      parametrization := p
      isSplitTorus := hP
      dominant := hd
      pointed := hp }⟩)

/-- Retain a chosen finite Galois extension and pointed split-torus
parametrization of a smooth affine group generated by its ground-field tori. -/
def IsTorusGenerated.finiteGaloisSplitDomination
    [Smooth H.X.hom] [IsAffineHom H.X.hom] (hH : IsTorusGenerated H) :
    FiniteGaloisSplitTorusDomination H :=
  hH.hasPointedTorusDomination.finiteGaloisSplitDomination

end Langlands.GroupScheme
