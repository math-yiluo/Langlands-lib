import Langlands.GroupScheme.Rational.RootConeIntersectionDescent
import Langlands.GroupScheme.Rational.ConvexRootGroupRationalIntersection

/-! # Intersection of groups generated by convex indivisible-root subsets -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

section AlgebraicallyClosed

variable {k : Type u} [Field k] [IsAlgClosed k]
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (i : T.toGrp ⟶ G) (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (C D : PointedCone ℝ (RealTorusSpace.Vstar T))
    {H₁ H₂ H₃ : GroupScheme (Spec (CommRingCat.of k))}
    {h₁ : H₁ ⟶ G} {h₂ : H₂ ⟶ G} {h₃ : H₃ ⟶ G}

include hG hi

/-- Closed full-root cone slices have the expected rational-point intersection
over an algebraically closed field. -/
theorem rootConeGroups_rationalPoints_inter_of_isAlgClosed
    (hC : @IsClosed _ (moduleTopology ℝ _) (C : Set (RealTorusSpace.Vstar T)))
    (hD : @IsClosed _ (moduleTopology ℝ _) (D : Set (RealTorusSpace.Vstar T)))
    (hh₁ : IsRootSubsetGroup i
      {a | a ∈ relativeRoots i ∧ (1 : ℝ) ⊗ₜ[ℤ] a ∈ C} h₁)
    (hh₂ : IsRootSubsetGroup i
      {a | a ∈ relativeRoots i ∧ (1 : ℝ) ⊗ₜ[ℤ] a ∈ D} h₂)
    (hh₃ : IsRootSubsetGroup i
      {a | a ∈ relativeRoots i ∧ (1 : ℝ) ⊗ₜ[ℤ] a ∈ C ⊓ D} h₃) :
    (SubgroupFunctor.range h₁).carrier (Over.mk (𝟙 (Spec (CommRingCat.of k)))) ⊓
        (SubgroupFunctor.range h₂).carrier (Over.mk (𝟙 _)) =
      (SubgroupFunctor.range h₃).carrier (Over.mk (𝟙 _)) := by
  obtain ⟨hH₃s, hH₃a, hH₃c⟩ :=
    IsRootSubsetGroup.smooth_affine_connected i _ hG hi (fun _ ha => ha.1) hh₃
  let : Smooth H₃.X.hom := hH₃s
  let : IsAffineHom H₃.X.hom := hH₃a
  let : ConnectedSpace H₃.X.left := hH₃c
  have hnorm := rootConeGroupIntersection_le_normalizer i hG hi C D hh₁ hh₂ hh₃
  rw [rootConeSlice_inf] at hh₃
  exact convexRootGroups_rationalPoints_inter_of_isAlgClosed_of_normalizing
    i hG hi ⟨C, hC, rfl⟩ ⟨D, hD, rfl⟩ hh₁ hh₂ hh₃ hnorm

end AlgebraicallyClosed

set_option maxHeartbeats 800000 in
/-- Renard V.4.2 (i) for the published convex indivisible-root subsets. -/
theorem convexRootSubsetGroupIntersection :
    ConvexRootSubsetGroupIntersectionStatement.{u} := by
  intro k _ G hG T i hi
  let : IsAffineHom G.X.hom := hG.isAffineHom
  intro S X hS hX H₁ H₂ H₃ h₁ h₂ h₃ hh₁ hh₂ hh₃
  let : Smooth (subgroupIntersection h₁ h₂).X.hom :=
    smooth_subgroupIntersection_convexRootGroup i hG hi hS hX hh₁ hh₂
  have hle₁ : SubgroupFunctor.range h₃ ≤ SubgroupFunctor.range h₁ :=
    hh₃.2.2.2 H₁ h₁ hh₁.1 hh₁.2.1 (fun a ha => hh₁.2.2.1 a ha.1)
  have hle₂ : SubgroupFunctor.range h₃ ≤ SubgroupFunctor.range h₂ :=
    hh₃.2.2.2 H₂ h₂ hh₂.1 hh₂.2.1 (fun a ha => hh₂.2.2.1 a ha.2)
  have hle : SubgroupFunctor.range h₁ ⊓ SubgroupFunctor.range h₂ ≤
      SubgroupFunctor.range h₃ := by
    apply subgroupIntersection_le_of_baseChangePoints (K := AlgebraicClosure k) hh₃.1
    obtain ⟨C, hC, rfl⟩ := hS
    obtain ⟨D, hD, rfl⟩ := hX
    let K := AlgebraicClosure k
    let b := algebraBaseMap k K
    let GK := (GroupScheme.baseChange b).obj G
    have hGK : IsConnectedReductive GK := hG.baseChange_of_algebraicExtension
    let : IsAffineHom GK.X.hom := hGK.isAffineHom
    let : Smooth GK.X.hom := hGK.smooth
    let : LocallyOfFiniteType GK.X.hom := inferInstance
    have hiK : IsSplitSubtorus (T := (CommGroupScheme.baseChange b).obj T)
        ((GroupScheme.baseChange b).map i) :=
      ⟨hi.1.1.baseChange b, hi.1.2.baseChange b⟩
    obtain ⟨A, j, hj, _, f, hf⟩ :=
      exists_splitMaximalTorus_extension_of_isSepClosed
        (S := (CommGroupScheme.baseChange b).obj T)
        ((GroupScheme.baseChange b).map i) hiK
    let CK := rootConePreimage f (rootConeBaseChange b hi.1.1 C)
    let DK := rootConePreimage f (rootConeBaseChange b hi.1.1 D)
    have hCK : @IsClosed _ (moduleTopology ℝ _)
        (CK : Set (RealTorusSpace.Vstar A)) :=
      isClosed_rootConePreimage f _ (isClosed_rootConeBaseChange b hi.1.1 C hC)
    have hDK : @IsClosed _ (moduleTopology ℝ _)
        (DK : Set (RealTorusSpace.Vstar A)) :=
      isClosed_rootConePreimage f _ (isClosed_rootConeBaseChange b hi.1.1 D hD)
    have hh₁K := hh₁.baseChange_lift_rootCone i hG hi C hGK j hj f hf
    have hh₂K := hh₂.baseChange_lift_rootCone i hG hi D hGK j hj f hf
    have hh₃' : IsRootSubsetGroup i
        {a | a ∈ RelativeRoot.indivisibleRoots i ∧ (1 : ℝ) ⊗ₜ[ℤ] a ∈ C ⊓ D} h₃ := by
      rwa [rootConeSlice_inf]
    have hh₃K := hh₃'.baseChange_lift_rootCone i hG hi (C ⊓ D) hGK j hj f hf
    simp only [rootConeBaseChange_inf, rootConePreimage_inf] at hh₃K
    exact (rootConeGroups_rationalPoints_inter_of_isAlgClosed j hGK hj CK DK
      hCK hDK hh₁K hh₂K hh₃K).le
  intro U _ g
  exact ⟨fun hg => hle U hg, fun hg => ⟨hle₁ U hg, hle₂ U hg⟩⟩

end Langlands.GroupScheme
