import Langlands.GroupScheme.Rational.OrthogonalSimpleRootCommutationStatement
import Langlands.GroupScheme.Reductive.SplitLeviGluingMixedRoots
import Mathlib.GroupTheory.Subgroup.Centralizer

/-! # Commutation of the groups generated by orthogonal simple roots -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.SplitPinning

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (p : SplitPinning G)

theorem strict_mixed_simple_ne_zero_not_root
    (a b : p.base.support) (hab : a ≠ b)
    (n m : ℕ) (hn : 0 < n) (hm : 0 < m) :
    n • p.rootDatum.root a - m • p.rootDatum.root b ≠ 0 ∧
      n • p.rootDatum.root a - m • p.rootDatum.root b ∉ roots p.inclusion := by
  classical
  have hli : LinearIndependent ℤ (fun j : p.base.support => p.rootDatum.root j) :=
    p.base.linearIndepOn_root
  have hrange : Set.range (fun j : p.base.support => p.rootDatum.root j) =
      p.rootDatum.root '' (p.base.support : Set p.rootIndex) := by
    ext z
    simp
  have hpos := LeviGluing.mixed_not_mem_positiveClosure hli a b hab n m hm
  have hneg := LeviGluing.mixed_not_mem_positiveClosure hli b a hab.symm m n hn
  rw [hrange] at hpos hneg
  constructor
  · intro hz
    apply hpos
    rw [hz]
    exact AddSubmonoid.zero_mem _
  · intro hz
    rw [← p.isRootDatum.2.1] at hz
    obtain ⟨j, hj⟩ := hz
    rcases p.base.root_mem_or_neg_mem j with h | h
    · exact hpos (hj ▸ h)
    · apply hneg
      simpa only [hj, neg_sub] using h

theorem strict_positive_orthogonal_simple_ne_zero_not_root
    (a b : p.base.support) (hab : a ≠ b)
    (ho : p.rootDatum.IsOrthogonal a b)
    (n m : ℕ) (hn : 0 < n) (hm : 0 < m) :
    n • p.rootDatum.root a + m • p.rootDatum.root b ≠ 0 ∧
      n • p.rootDatum.root a + m • p.rootDatum.root b ∉ roots p.inclusion := by
  have hr : p.rootDatum.reflection a
      (n • p.rootDatum.root a + m • p.rootDatum.root b) =
      m • p.rootDatum.root b - n • p.rootDatum.root a := by
    simp only [map_add, map_nsmul, p.rootDatum.reflection_apply_self,
      p.rootDatum.reflection_apply_root, ho.2, zero_smul, sub_zero, smul_neg]
    abel
  obtain ⟨hzero, hroot⟩ :=
    p.strict_mixed_simple_ne_zero_not_root b a hab.symm m n hm hn
  constructor
  · intro hz
    apply hzero
    rw [← hr, hz, map_zero]
  · intro hz
    apply hroot
    rw [← p.isRootDatum.2.1, ← hr]
    exact p.rootDatum.mapsTo_reflection_root a (by rwa [p.isRootDatum.2.1])

theorem strict_signed_orthogonal_simple_ne_zero_not_root
    (a b : p.base.support) (hab : a ≠ b)
    (ho : p.rootDatum.IsOrthogonal a b)
    (c d : characterLattice p.torus)
    (hc : c = p.rootDatum.root a ∨ c = -p.rootDatum.root a)
    (hd : d = p.rootDatum.root b ∨ d = -p.rootDatum.root b)
    (n m : ℕ) (hn : 0 < n) (hm : 0 < m) :
    n • c + m • d ≠ 0 ∧ n • c + m • d ∉ roots p.inclusion := by
  rcases hc with rfl | rfl <;> rcases hd with rfl | rfl
  · exact p.strict_positive_orthogonal_simple_ne_zero_not_root a b hab ho n m hn hm
  · simpa only [smul_neg, ← sub_eq_add_neg] using
      p.strict_mixed_simple_ne_zero_not_root a b hab n m hn hm
  · simpa only [smul_neg, add_comm, ← sub_eq_add_neg] using
      p.strict_mixed_simple_ne_zero_not_root b a hab.symm m n hm hn
  · obtain ⟨hz, hr⟩ :=
      p.strict_positive_orthogonal_simple_ne_zero_not_root a b hab ho n m hn hm
    have hneg :
        -(n • p.rootDatum.root a + m • p.rootDatum.root b) ∉ roots p.inclusion := by
      rw [← p.isRootDatum.2.1, p.rootDatum.neg_mem_range_root_iff, p.isRootDatum.2.1]
      exact hr
    simpa only [smul_neg, ← neg_add] using And.intro (neg_ne_zero.mpr hz) hneg

theorem commute_of_no_strict_root_combinations
    (c d : characterLattice p.torus) (hc : c ≠ 0) (hd : d ≠ 0)
    (hcd : ∀ n m : ℕ, 0 < n → 0 < m →
      n • c + m • d ≠ 0 ∧ n • c + m • d ∉ roots p.inclusion)
    {Z : Over (Spec (CommRingCat.of k))} {x y : Z ⟶ G.X}
    (hx : x ∈ (RelativeRoot.subgroup p.inclusion c).carrier Z)
    (hy : y ∈ (RelativeRoot.subgroup p.inclusion d).carrier Z) :
    Commute x y := by
  let : Smooth G.X.hom := p.isConnectedReductive.smooth
  let action := AutomorphicAction.conjugation p.inclusion
  have hbot : RelativeRoot.semigroupSubgroup action
      (RelativeRoot.semigroupSum (RelativeRoot.cyclicTail c 1)
        (RelativeRoot.cyclicTail d 1)) = ⊥ := by
    apply RelativeRoot.semigroupSubgroup_eq_bot_of_noAmbientWeights_without_realization
      action p.isSplitTorus
    rintro χ ⟨_, ⟨n, _, hn, rfl⟩, _, ⟨m, _, hm, rfl⟩, rfl⟩ hweight
    obtain ⟨hzero, hroot⟩ := hcd n m hn hm
    exact hroot ((RelativeRoot.mem_actionWeightSupport_conjugation_iff
      p.inclusion hzero).mp hweight)
  have hx' : x ∈ (RelativeRoot.semigroupSubgroup action
      (RelativeRoot.cyclicTail c 1)).carrier Z := by
    change x ∈ (RelativeRoot.weightFiltration action c 1).carrier Z
    rw [RelativeRoot.weightFiltration_one_eq_subgroup p.isSplitTorus p.inclusion c hc]
    exact hx
  have hy' : y ∈ (RelativeRoot.semigroupSubgroup action
      (RelativeRoot.cyclicTail d 1)).carrier Z := by
    change y ∈ (RelativeRoot.weightFiltration action d 1).carrier Z
    rw [RelativeRoot.weightFiltration_one_eq_subgroup p.isSplitTorus p.inclusion d hd]
    exact hy
  have h := RelativeRoot.semigroupCommutator k G inferInstance inferInstance
    p.torus p.isSplitTorus action
    (RelativeRoot.cyclicTail c 1) (RelativeRoot.cyclicTail d 1) Z x y hx' hy'
  rw [hbot] at h
  have heq : x * y * x⁻¹ * y⁻¹ = 1 := h
  exact commutatorElement_eq_one_iff_commute.mp heq

theorem commute_signed_orthogonal_simple
    (a b : p.base.support) (hab : a ≠ b)
    (ho : p.rootDatum.IsOrthogonal a b)
    (c d : characterLattice p.torus)
    (hc : c = p.rootDatum.root a ∨ c = -p.rootDatum.root a)
    (hd : d = p.rootDatum.root b ∨ d = -p.rootDatum.root b)
    {Z : Over (Spec (CommRingCat.of k))} {x y : Z ⟶ G.X}
    (hx : x ∈ (RelativeRoot.subgroup p.inclusion c).carrier Z)
    (hy : y ∈ (RelativeRoot.subgroup p.inclusion d).carrier Z) :
    Commute x y := by
  have hc0 : c ≠ 0 := by
    rcases hc with rfl | rfl
    · exact p.rootDatum.ne_zero a
    · exact neg_ne_zero.mpr (p.rootDatum.ne_zero a)
  have hd0 : d ≠ 0 := by
    rcases hd with rfl | rfl
    · exact p.rootDatum.ne_zero b
    · exact neg_ne_zero.mpr (p.rootDatum.ne_zero b)
  exact p.commute_of_no_strict_root_combinations c d hc0 hd0
    (p.strict_signed_orthogonal_simple_ne_zero_not_root a b hab ho c d hc hd) hx hy

end Langlands.GroupScheme.SplitPinning

namespace Langlands.GroupScheme

/-- The exact orthogonal-simple-root commutation proposition at every universe. -/
theorem orthogonalSimpleRootCommutation :
    OrthogonalSimpleRootCommutationStatement.{u} := by
  intro k _ G _ p a b hab ho Z x y hx hy
  have hgen (c d : characterLattice p.torus)
      (hc : c = p.rootDatum.root a ∨ c = -p.rootDatum.root a)
      (hd : d = p.rootDatum.root b ∨ d = -p.rootDatum.root b) :
      (RelativeRoot.subgroup p.inclusion c).carrier Z ≤
        Subgroup.centralizer ((RelativeRoot.subgroup p.inclusion d).carrier Z) := by
    intro z hz w hw
    exact (p.commute_signed_orthogonal_simple a b hab ho c d hc hd hz hw).symm.eq
  have hside (c : characterLattice p.torus)
      (hc : c = p.rootDatum.root a ∨ c = -p.rootDatum.root a) :
      (RelativeRoot.subgroup p.inclusion c).carrier Z ≤
        Subgroup.centralizer
          (((RelativeRoot.subgroup p.inclusion (p.rootDatum.root b)).carrier Z ⊔
            (RelativeRoot.subgroup p.inclusion (-p.rootDatum.root b)).carrier Z) :
              Subgroup (Z ⟶ G.X)) := by
    apply Subgroup.le_centralizer_iff.mpr
    exact sup_le
      (Subgroup.le_centralizer_iff.mp (hgen c _ hc (Or.inl rfl)))
      (Subgroup.le_centralizer_iff.mp (hgen c _ hc (Or.inr rfl)))
  have hsup :
      (RelativeRoot.subgroup p.inclusion (p.rootDatum.root a)).carrier Z ⊔
          (RelativeRoot.subgroup p.inclusion (-p.rootDatum.root a)).carrier Z ≤
        Subgroup.centralizer
          (((RelativeRoot.subgroup p.inclusion (p.rootDatum.root b)).carrier Z ⊔
            (RelativeRoot.subgroup p.inclusion (-p.rootDatum.root b)).carrier Z) :
              Subgroup (Z ⟶ G.X)) :=
    sup_le (hside _ (Or.inl rfl)) (hside _ (Or.inr rfl))
  exact (hsup hx y hy).symm

end Langlands.GroupScheme
