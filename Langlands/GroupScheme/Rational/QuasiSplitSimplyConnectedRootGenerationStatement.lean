import Langlands.GroupScheme.SimplyConnected.Basic
import Langlands.GroupScheme.Reductive.QuasiSplit
import Langlands.GroupScheme.Rational.RootGeneratedSubgroup

/-! # Rational root generation for quasi-split simply connected groups -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- Over every field, the rational points of a quasi-split simply connected
group are generated by the actual relative-root groups for any maximal split
torus. This proposition includes the trivial group and finite fields. -/
def QuasiSplitSimplyConnectedRootGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k]
    (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom],
    IsSimplyConnected G → IsQuasiSplit G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i → relativeRootGeneratedSubgroup i = ⊤

end Langlands.GroupScheme
