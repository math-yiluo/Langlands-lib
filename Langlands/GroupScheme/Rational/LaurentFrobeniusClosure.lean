import Langlands.GroupScheme.Rational.LaurentFiniteFrobeniusBasis

/-! # Frobenius closures of finite pointed Laurent families -/

noncomputable section

universe u v

namespace Langlands.GroupScheme.LaurentAugmentation

variable (k : Type u) [CommRing k] (I : Type v)

/-- The algebra generated by the underlying functions of a pointed family. -/
def pointedAdjoin (S : Set (space k (I → ℤ))) :
    Subalgebra k (AddMonoidAlgebra k (I → ℤ)) :=
  Algebra.adjoin k (Subtype.val '' S)

variable {k I} {p : ℕ} [Fact p.Prime]

theorem subset_frobSpan (S : Set (space k (I → ℤ))) :
    S ⊆ frobSpan k p I S := by
  intro f hf
  exact Submodule.subset_span ⟨f, hf, 0, (frobPower_zero f).symm⟩

theorem frobSpan_mono {S T : Set (space k (I → ℤ))} (hST : S ⊆ T) :
    frobSpan k p I S ≤ frobSpan k p I T := by
  apply Submodule.span_mono
  rintro _ ⟨g, hg, r, rfl⟩
  exact ⟨g, hST hg, r, rfl⟩

theorem frobSpan_val_mem_pointedAdjoin {S : Set (space k (I → ℤ))}
    {f : space k (I → ℤ)} (hf : f ∈ frobSpan k p I S) :
    f.val ∈ pointedAdjoin k I S := by
  have hle : frobSpan k p I S ≤
      (pointedAdjoin k I S).toSubmodule.comap (space k (I → ℤ)).subtype := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, r, rfl⟩
    exact (pointedAdjoin k I S).pow_mem (Algebra.subset_adjoin ⟨g, hg, rfl⟩) _
  exact hle hf

theorem pointedAdjoin_frobSpan (S : Set (space k (I → ℤ))) :
    pointedAdjoin k I (frobSpan k p I S : Set (space k (I → ℤ))) =
      pointedAdjoin k I S := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨f, hf, rfl⟩
    exact frobSpan_val_mem_pointedAdjoin hf
  · exact Algebra.adjoin_mono (Set.image_mono (subset_frobSpan (p := p) S))

section Characteristic

variable [CharP k p]

theorem frobeniusMap_mem_frobSpan {S : Set (space k (I → ℤ))}
    {f : space k (I → ℤ)} (hf : f ∈ frobSpan k p I S) :
    frobeniusMap (k := k) (p := p) (I := I) f ∈ frobSpan k p I S := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨g, hg, r, rfl⟩ := hf
    rw [← frobPower_succ]
    exact Submodule.subset_span ⟨g, hg, r + 1, rfl⟩
  | zero => simp
  | add f g _ _ hf hg => rw [map_add]; exact add_mem hf hg
  | smul c f _ hf => rw [map_smulₛₗ]; exact Submodule.smul_mem _ _ hf

theorem frobSpan_idem (S : Set (space k (I → ℤ))) :
    frobSpan k p I (frobSpan k p I S : Set (space k (I → ℤ))) =
      frobSpan k p I S :=
  le_antisymm (frobSpan_le (fun _ hf => frobeniusMap_mem_frobSpan hf) Set.Subset.rfl)
    (frobSpan_mono (subset_frobSpan S))

/-- The Frobenius closure of a finite family still uses finitely many primitive orbits. -/
theorem exists_finiteOrbitSpace_frobSpan (F : Finset (space k (I → ℤ))) :
    ∃ s : Finset {m : I → ℤ // IsPrimitive p m},
      frobSpan k p I (F : Set (space k (I → ℤ))) ≤ finiteOrbitSpace k p I s := by
  obtain ⟨s, hs⟩ := exists_finiteOrbitSpace (p := p) F
  exact ⟨s, frobSpan_le (fun _ hf => frobeniusMap_mem_finiteOrbitSpace hf) hs⟩

end Characteristic

section Field

variable {K : Type u} [Field K] [CharP K p]

open Classical in
/-- A finite pointed family can be replaced by finite Frobenius generators
with independent encodings, preserving its generated Laurent algebra. -/
theorem exists_finiteFrobGenerators (F : Finset (space K (I → ℤ))) :
    ∃ (s : Finset {m : I → ℤ // IsPrimitive p m})
      (G : Finset (space K (I → ℤ))),
      frobSpan K p I (F : Set (space K (I → ℤ))) ≤ finiteOrbitSpace K p I s ∧
      (G : Set (space K (I → ℤ))) ⊆ frobSpan K p I (F : Set (space K (I → ℤ))) ∧
      frobSpan K p I (F : Set (space K (I → ℤ))) =
        frobSpan K p I (G : Set (space K (I → ℤ))) ∧
      pointedAdjoin K I (F : Set (space K (I → ℤ))) =
        pointedAdjoin K I (G : Set (space K (I → ℤ))) ∧
      TorusLinearization.FrobIndep (G.image (finiteEncoding K p I s)) := by
  classical
  obtain ⟨s, hs⟩ := exists_finiteOrbitSpace_frobSpan (p := p) F
  obtain ⟨G, hG, hspan, hind⟩ :=
    exists_finiteFrobBasis s (frobSpan K p I (F : Set (space K (I → ℤ)))) hs
      (fun _ hf => frobeniusMap_mem_frobSpan hf)
  refine ⟨s, G, hs, hG, hspan, ?_, hind⟩
  rw [← pointedAdjoin_frobSpan (p := p) (F : Set (space K (I → ℤ))), hspan,
    pointedAdjoin_frobSpan]

end Field

end Langlands.GroupScheme.LaurentAugmentation
