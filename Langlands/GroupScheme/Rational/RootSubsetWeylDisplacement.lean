import Langlands.GroupScheme.Rational.ClosedRootSubsetStatements
import Langlands.LinearAlgebra.RationalSpan

/-! # Character displacements of a root-generated Weyl subgroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open Langlands.LinearAlgebra.RationalSpan
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]

/-- The displacement of a character by an element of the subgroup generated by
reflections in `J` belongs to the integral span of `J`. -/
theorem characterDisplacement_mem_span_of_mem_rootSubsetWeylGroup
    {J : Set (characterLattice T)} {w : relativeWeylGroup i}
    (hw : w ∈ rootSubsetWeylGroup i J) (χ : characterLattice T) :
    relativeWeylCharacterAction i w χ - χ ∈ Submodule.span ℤ J := by
  change w ∈ Subgroup.closure _ at hw
  induction hw using Subgroup.closure_induction generalizing χ with
  | mem x hx =>
    obtain ⟨β, hβ, c, -, hc⟩ := hx
    have hd : relativeWeylCharacterAction i x χ - χ =
        -(latticePairing T χ c • β) := by
      rw [hc]
      abel
    rw [hd]
    exact (Submodule.span ℤ J).neg_mem
      ((Submodule.span ℤ J).smul_mem _ (Submodule.subset_span hβ))
  | one =>
    simp
  | mul x y _ _ hx hy =>
    rw [map_mul, LinearEquiv.mul_apply]
    convert (Submodule.span ℤ J).add_mem
      (hx (relativeWeylCharacterAction i y χ)) (hy χ) using 1
    abel
  | inv x _ hx =>
    have he : relativeWeylCharacterAction i x
        (relativeWeylCharacterAction i x⁻¹ χ) = χ := by
      rw [← LinearEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one]
      rfl
    have h := (Submodule.span ℤ J).neg_mem
      (hx (relativeWeylCharacterAction i x⁻¹ χ))
    simpa only [he, neg_sub] using h

/-- Rationalizing the character displacement gives an element of the rational
span of the generating roots. -/
theorem characterDisplacement_mem_ratSpan_of_mem_rootSubsetWeylGroup
    {J : Set (characterLattice T)} {w : relativeWeylGroup i}
    (hw : w ∈ rootSubsetWeylGroup i J) (χ : characterLattice T) :
    toRat (relativeWeylCharacterAction i w χ - χ) ∈ ratSpan J := by
  have hle : Submodule.span ℤ J ≤
      ((ratSpan J).restrictScalars ℤ).comap
        (toRat : characterLattice T →+ ℚ ⊗[ℤ] characterLattice T).toIntLinearMap := by
    apply Submodule.span_le.mpr
    intro β hβ
    exact toRat_mem_ratSpan hβ
  exact hle (characterDisplacement_mem_span_of_mem_rootSubsetWeylGroup i hw χ)

/-- Membership in two root-generated Weyl subgroups puts every rationalized
character displacement in the intersection of the two rational spans. -/
theorem characterDisplacement_mem_inf_ratSpan_of_mem_rootSubsetWeylGroup
    {S X : Set (characterLattice T)} {w : relativeWeylGroup i}
    (hS : w ∈ rootSubsetWeylGroup i S) (hX : w ∈ rootSubsetWeylGroup i X)
    (χ : characterLattice T) :
    toRat (relativeWeylCharacterAction i w χ - χ) ∈ ratSpan S ⊓ ratSpan X :=
  ⟨characterDisplacement_mem_ratSpan_of_mem_rootSubsetWeylGroup i hS χ,
    characterDisplacement_mem_ratSpan_of_mem_rootSubsetWeylGroup i hX χ⟩

/-- The character-displacement containment used in root-subset intersections. -/
def RootSubsetWeylDisplacementStatement : Prop :=
  ∀ {J : Set (characterLattice T)} {w : relativeWeylGroup i},
    w ∈ rootSubsetWeylGroup i J → ∀ χ : characterLattice T,
      toRat (relativeWeylCharacterAction i w χ - χ) ∈ ratSpan J

theorem rootSubsetWeylDisplacement : RootSubsetWeylDisplacementStatement i :=
  fun hw χ => characterDisplacement_mem_ratSpan_of_mem_rootSubsetWeylGroup i hw χ

end Langlands.GroupScheme
