import Langlands.GroupScheme.Rational.ElementarySubgroup
import Mathlib.GroupTheory.QuotientGroup.Defs

/-! # The quotient by actual rational parabolic radicals -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  (G : GroupScheme (Spec (CommRingCat.of k)))

/-- The quotient of the actual rational points by the subgroup generated by
all represented geometric unipotent radicals of rational parabolic subgroups. -/
abbrev parabolicWhiteheadQuotient :=
  rationalPoints G ⧸ parabolicElementarySubgroup G

/-- The canonical quotient homomorphism. -/
def parabolicWhiteheadQuotientMk : rationalPoints G →* parabolicWhiteheadQuotient G :=
  QuotientGroup.mk' (parabolicElementarySubgroup G)

theorem parabolicWhiteheadQuotientMk_surjective :
    Function.Surjective (parabolicWhiteheadQuotientMk G) :=
  QuotientGroup.mk'_surjective _

@[simp]
theorem ker_parabolicWhiteheadQuotientMk :
    (parabolicWhiteheadQuotientMk G).ker = parabolicElementarySubgroup G :=
  QuotientGroup.ker_mk' _

/-- A homomorphism kills the elementary subgroup exactly when it kills every
actual parabolic-radical image. -/
theorem parabolicElementarySubgroup_le_ker_iff
    {H : Type v} [Group H] (f : rationalPoints G →* H) :
    parabolicElementarySubgroup G ≤ f.ker ↔
      ∀ (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ G) (r : U ⟶ P),
        IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
          f.comp (rationalPoints.map (r ≫ p)) = 1 := by
  rw [parabolicElementarySubgroup_le_iff]
  constructor
  · intro h P U p r hp hr
    apply MonoidHom.ext
    intro x
    exact h P U p r hp hr ⟨x, rfl⟩
  · intro h P U p r hp hr y hy
    obtain ⟨x, rfl⟩ := hy
    exact DFunLike.congr_fun (h P U p r hp hr) x

/-- Each represented parabolic radical maps trivially to the quotient. -/
theorem parabolicWhiteheadQuotientMk_comp_radical
    {P U : GroupScheme (Spec (CommRingCat.of k))} {p : P ⟶ G} {r : U ⟶ P}
    (hp : IsParabolicSubgroup p) (hr : LeviSubgroup.IsGeometricUnipotentRadical r) :
    (parabolicWhiteheadQuotientMk G).comp (rationalPoints.map (r ≫ p)) = 1 := by
  apply (parabolicElementarySubgroup_le_ker_iff G _).mp
    (by rw [ker_parabolicWhiteheadQuotientMk])
  exact hp
  exact hr

/-- Any homomorphism killing every actual parabolic radical descends to the
actual quotient, uniquely. -/
theorem existsUnique_parabolicWhiteheadQuotient_lift
    {H : Type v} [Group H] (f : rationalPoints G →* H)
    (hf : ∀ (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ G) (r : U ⟶ P),
      IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
        f.comp (rationalPoints.map (r ≫ p)) = 1) :
    ∃! q : parabolicWhiteheadQuotient G →* H,
      q.comp (parabolicWhiteheadQuotientMk G) = f := by
  refine ⟨QuotientGroup.lift _ f ((parabolicElementarySubgroup_le_ker_iff G f).mpr hf),
    rfl, ?_⟩
  intro q hq
  apply QuotientGroup.monoidHom_ext
  exact hq

/-- Triviality of the actual quotient is precisely the elementary-subgroup
generation assertion. -/
theorem parabolicWhiteheadQuotient_subsingleton_iff :
    Subsingleton (parabolicWhiteheadQuotient G) ↔ parabolicElementarySubgroup G = ⊤ :=
  QuotientGroup.subsingleton_iff

/-- The normal-subgroup formulation and the elementary-subgroup equality agree
over any field, without an arithmetic hypothesis. -/
theorem parabolicElementarySubgroup_eq_top_iff :
    parabolicElementarySubgroup G = ⊤ ↔
      ∀ (N : Subgroup (rationalPoints G)), N.Normal →
        (∀ (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ G) (r : U ⟶ P),
          IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
            (rationalPoints.map (r ≫ p)).range ≤ N) →
        N = ⊤ := by
  constructor
  · intro h N _ hN
    apply top_unique
    rw [← h]
    exact (parabolicElementarySubgroup_le_iff N).mpr hN
  · intro h
    exact h _ inferInstance
      (fun _ _ _ _ hp hr => parabolic_radical_range_le_elementarySubgroup hp hr)

end Langlands.GroupScheme
