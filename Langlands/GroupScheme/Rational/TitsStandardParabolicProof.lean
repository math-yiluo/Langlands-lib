import Langlands.GroupScheme.Rational.TitsStandardParabolicStatement
import Langlands.GroupScheme.Rational.StandardParabolicEndpointsProof
import Langlands.GroupScheme.Rational.StandardParabolicPointsProof
import Langlands.GroupScheme.Rational.StandardRelativeWeylGenerationProof

/-! # Proof: the standard parabolics of the rational Tits system -/

universe u

namespace Langlands.GroupScheme

/-- **The standard parabolics of the rational Tits system** (Borel–Tits 5.17): for a maximal
split torus `i` of a connected reductive group over any field, a generic cocharacter `ν` and a
set `J` of simple relative roots, `P_J(k) = B W_J B` with `B = P_∅(k)` and `W_J` generated by
the reflections in the roots of `J`. The exact published statement
`TitsStandardParabolicStatement`, at an arbitrary universe. -/
theorem titsStandardParabolic : TitsStandardParabolicStatement.{u} :=
  titsStandardParabolicStatement_of_statements standardParabolicEndpoints
    standardParabolicPointsStatement_proof standardRelativeWeylGeneration

end Langlands.GroupScheme
