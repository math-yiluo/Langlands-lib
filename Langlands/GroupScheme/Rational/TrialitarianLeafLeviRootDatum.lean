import Langlands.GroupScheme.Rational.TrialitarianLeviTorusDescent
import Langlands.GroupScheme.Rational.CoweightSubgroupCoroots
import Langlands.GroupScheme.Rational.StandardLeviStandardFamiliesProof
import Langlands.GroupScheme.Dynamic.LieProof

/-! # The six coroots in the common zero face of the trialitarian leaf triple -/

noncomputable section

universe u v w

open CategoryTheory AlgebraicGeometry Matrix
open Langlands.LinearAlgebra

namespace Langlands.LinearAlgebra

private theorem d4CoordinateRoot_eq_a2_of_zero :
    ∀ (i j : Fin 4) (s t : Bool), i < j →
      d4CoordinateRoot i j s t ⬝ᵥ
        (d4LeafParabolicCocharacters 0 - d4LeafParabolicCocharacters 1) = 0 →
      ∃ k, d4CoordinateRoot i j s t =
        a2Coroots (TypeDNumberedVectors.simple (by decide : 2 ≤ 4) 1)
          (TypeDNumberedVectors.simple (by decide : 2 ≤ 4) 3) k := by
  decide

/-- The roots vanishing on the first difference of the leaf triple have precisely the
coroots of the subsystem generated by the adjacent vertices `1` and `3`. -/
theorem d4LeafParabolicCoweights_coroot_eq_a2_of_zero
    {I X Y : Type*} [AddCommGroup X] [AddCommGroup Y] [Finite I]
    (Q : RootDatum I X Y) [Q.IsReduced] (b : Q.Base) (hspan : Q.corootSpan ℤ = ⊤)
    (q : b.support ≃ Fin 4)
    (hD : ∀ a b : b.support, Q.pairing a.val b.val = CartanMatrix.D 4 (q a) (q b))
    (i : I)
    (hi : Q.root' i (d4LeafParabolicCoweights Q b q 0 - d4LeafParabolicCoweights Q b q 1) = 0) :
    ∃ k, Q.coroot i = a2Coroots (Q.coroot (q.symm 1)) (Q.coroot (q.symm 3)) k := by
  obtain ⟨j, l, hjl, s, t, hcoroot⟩ :=
    d4CorootCoordinates_exists_coordinateRoot Q b hspan q hD i
  rw [← d4CorootCoordinates_dotProduct_coroot Q b hspan q hD, hcoroot,
    map_sub, d4CorootCoordinates_leafParabolicCoweights,
    d4CorootCoordinates_leafParabolicCoweights] at hi
  obtain ⟨k, hk⟩ := d4CoordinateRoot_eq_a2_of_zero j l s t hjl hi
  refine ⟨k, d4CorootCoordinates_injective Q b hspan q ?_⟩
  rw [hcoroot, hk]
  fin_cases k <;> simp [a2Coroots]

end Langlands.LinearAlgebra

namespace Langlands.GroupScheme

variable {K : Type u} [Field K] {S : CommGroupScheme (Spec (CommRingCat.of K))}
  {G L : GroupScheme (Spec (CommRingCat.of K))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
  [IsAffineHom L.X.hom] [LocallyOfFiniteType L.X.hom]
  {s : S.toGrp ⟶ G} {sL : S.toGrp ⟶ L}
  {J I R : Type*} {X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum J (characterLattice S) (cocharacterLattice S)}
  {Pₗ : RootDatum R (characterLattice S) (cocharacterLattice S)}
  {Q : RootDatum I X Y} [Finite I] [Q.IsReduced]

set_option maxHeartbeats 800000 in
/-- On the same torus, the root datum of the represented centralizer inherits the six
coroots of the common zero face. The simple pair has off-diagonal pairings `-1`. -/
theorem IsRootDatumOf.exists_a2_of_leafCentralizer
    (hP : IsRootDatumOf s P) (hPₗ : IsRootDatumOf sL Pₗ)
    (hS : IsSplitTorus S.toGrp) (hs : IsClosedSubgroup s)
    (j : L ⟶ G) (hcomp : sL ≫ j = s)
    (b : Q.Base) (hspan : Q.corootSpan ℤ = ⊤) (q : b.support ≃ Fin 4)
    (hD : ∀ a b : b.support, Q.pairing a.val b.val = CartanMatrix.D 4 (q a) (q b))
    (e : J ≃ I) (θ : cocharacterLattice S ≃+ Y)
    (hroot : ∀ i ν, P.root' i ν = Q.root' (e i) (θ ν))
    (hcoroot : ∀ i, θ (P.coroot i) = Q.coroot (e i))
    (hj : (Dynamic.centralizer (CommGroupScheme.groupHom
      (θ.symm (d4LeafParabolicCoweights Q b q 0 - d4LeafParabolicCoweights Q b q 1)) ≫ s)
        ).IsRepresentedBy j) :
    ∃ a c : R, Pₗ.pairing a c = -1 ∧ Pₗ.pairing c a = -1 ∧
      ∀ i : R, ∃ k, Pₗ.coroot i = a2Coroots (Pₗ.coroot a) (Pₗ.coroot c) k := by
  let ζ₀ := d4LeafParabolicCoweights Q b q 0 - d4LeafParabolicCoweights Q b q 1
  let ζ := θ.symm ζ₀
  have hζ : θ ζ = ζ₀ := θ.apply_symm_apply ζ₀
  have hroots := relativeRoots_centralizer_factor dynamicLie s sL j hcomp ζ hj
  let E := hP.coweightSubgroupRootEmbedding hPₗ j hcomp hS hs ζ hroots
  have hrange : Set.range E.index = {i | P.root' i ζ = 0} :=
    E.range_index_eq _ (hP.root_range_eq_coweight_zero hPₗ ζ hroots)
  have hsimple (k : Fin 4) (hk0 : k ≠ 0) (hk2 : k ≠ 2) :
      e.symm (q.symm k).val ∈ Set.range E.index := by
    rw [hrange]
    change P.root' (e.symm (q.symm k).val) ζ = 0
    rw [hroot, hζ, Equiv.apply_symm_apply,
      d4LeafParabolicCoweights_difference_pairing Q b hspan q hD (q.symm k)]
    simp [hk0, hk2]
  obtain ⟨a, ha⟩ := hsimple 1 (by decide) (by decide)
  obtain ⟨c, hc⟩ := hsimple 3 (by decide) (by decide)
  have hpair (i l : R) :
      Pₗ.pairing i l = Q.pairing (e (E.index i)) (e (E.index l)) := by
    change Pₗ.toLinearMap (Pₗ.root i) (Pₗ.coroot l) = _
    rw [← E.root_eq, ← E.coroot_eq, hPₗ.1, ← hP.1]
    change P.root' (E.index i) (P.coroot (E.index l)) = _
    rw [hroot, hcoroot]
    rfl
  refine ⟨a, c, ?_, ?_, ?_⟩
  · rw [hpair, ha, hc, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      hD (q.symm 1) (q.symm 3)]
    simp only [Equiv.apply_symm_apply]
    decide
  · rw [hpair, ha, hc, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      hD (q.symm 3) (q.symm 1)]
    simp only [Equiv.apply_symm_apply]
    decide
  · intro i
    have hi : P.root' (E.index i) ζ = 0 := by
      have hi := Set.mem_range_self (f := E.index) i
      rwa [hrange] at hi
    rw [hroot, hζ] at hi
    obtain ⟨k, hk⟩ := d4LeafParabolicCoweights_coroot_eq_a2_of_zero Q b hspan q hD _ hi
    refine ⟨k, θ.injective ?_⟩
    rwa [← E.coroot_eq i, map_a2Coroots, ← E.coroot_eq a, ← E.coroot_eq c,
      hcoroot, hcoroot, hcoroot, ha, hc, Equiv.apply_symm_apply, Equiv.apply_symm_apply]

end Langlands.GroupScheme
