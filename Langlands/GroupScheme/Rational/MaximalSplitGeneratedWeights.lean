import Langlands.GroupScheme.Rational.MaximalSplitGeneratedCell
import Langlands.GroupScheme.Rational.DynamicPositiveSemigroup
import Langlands.GroupScheme.Rational.ActionWeightSupport
import Langlands.GroupScheme.Rational.SemigroupRealizationProof
import Langlands.GroupScheme.Rational.CyclicRootFunctorComparisonProof

/-! # The Lie weights of the generated split subgroup -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise

namespace Langlands.GroupScheme.MaximalSplitSubgroup

open VectorGroup RootCell RelativeRoot

section Cone

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}

/-- The additive semigroup generated by a family of characters. -/
abbrev cone {Idx : Type*} (a : Idx → characterLattice T) : AddSubsemigroup (characterLattice T) :=
  AddSubsemigroup.closure (Set.range a)

theorem cone_le_positiveSemigroup {Idx : Type*} (a : Idx → characterLattice T)
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch) :
    cone a ≤ positiveSemigroup cch :=
  AddSubsemigroup.closure_le.mpr (by
    rintro _ ⟨i, rfl⟩
    exact hpos i)

theorem cyclicTail_le_cone {Idx : Type*} (a : Idx → characterLattice T) (i : Idx) :
    cyclicTail (a i) 1 ≤ cone a := by
  rintro _ ⟨n, _, hn, rfl⟩
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_lt hn
  induction m with
  | zero =>
    rw [zero_add, zero_add, one_nsmul]
    exact AddSubsemigroup.subset_closure ⟨i, rfl⟩
  | succ m ih =>
    rw [show 0 + (m + 1) + 1 = (0 + m + 1) + 1 by omega, succ_nsmul]
    exact AddSubsemigroup.add_mem _ (ih (by omega) (by omega)) (AddSubsemigroup.subset_closure ⟨i, rfl⟩)

theorem positive_of_mem_cone_neg {Idx : Type*} (a : Idx → characterLattice T)
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch) :
    cone (fun i => -a i) ≤ positiveSemigroup (-cch) := by
  apply cone_le_positiveSemigroup
  intro i
  simpa only [map_neg, LinearMap.neg_apply, neg_neg] using hpos i

end Cone

section Weights

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
    {H : GroupScheme (Spec (CommRingCat.of k))} [Smooth H.X.hom] [IsAffineHom H.X.hom]

/-- An equivariant line of nonzero weight `c` lies in every semigroup subgroup whose
semigroup contains the positive multiples of `c`. -/
theorem range_line_le_semigroupSubgroup (hT : IsSplitTorus T.toGrp) (t : T.toGrp ⟶ H)
    (c : characterLattice T) (hc : c ≠ 0) (x : Ga k ⟶ H) (hx : IsTorusEquivariant t x c)
    (A : AddSubsemigroup (characterLattice T)) (hA : cyclicTail c 1 ≤ A) :
    SubgroupFunctor.range x ≤ semigroupSubgroup (AutomorphicAction.conjugation t) A := by
  refine (range_le_subgroup_of_isTorusEquivariant t c x hx).trans ?_
  rw [← weightFiltration_one_eq_subgroup hT t c hc]
  exact semigroupSubgroup_mono _ hA

/-- **The positive dynamic factor is the semigroup subgroup of the cone** (CGP C.2.29,
Step 1). Under the hypotheses of `torusCentralizer_eq_range_of_generated`, the dynamic
unipotent subgroup of a cocharacter positive on every `a i` is the semigroup subgroup of the
additive semigroup generated by the `a i`. -/
theorem unipotent_eq_semigroupSubgroup_cone [IsAlgClosed k] (hT : IsSplitTorus T.toGrp)
    {Idx : Type*}
    (t : T.toGrp ⟶ H) (a : Idx → characterLattice T) (ν : Idx → cocharacterLattice T)
    (x y : Idx → (Ga k ⟶ H))
    (hx : ∀ i, IsTorusEquivariant t (x i) (a i)) (hy : ∀ i, IsTorusEquivariant t (y i) (-a i))
    (hrel : ∀ i, RelationOver t (ν i) (x i) (y i) (Over.mk (𝟙 (Spec (CommRingCat.of k)))))
    (hcomm : ∀ i j, i ≠ j → ∀ g ∈ rangePts (x i), ∀ h ∈ rangePts (y j), Commute g h)
    (hgen : Dense (rationalPointImage H (Subgroup.closure
      ((⋃ i, (rangePts (x i) : Set (rationalPoints H))) ∪ (⋃ i, (rangePts (y i) : Set (rationalPoints H))) ∪
        (rangePts t : Set (rationalPoints H))) : Set (rationalPoints H))))
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch)
    (ht : IsClosedSubgroup t) :
    Dynamic.unipotent (CommGroupScheme.groupHom cch ≫ t) =
      semigroupSubgroup (AutomorphicAction.conjugation t) (cone a) := by
  let b := AutomorphicAction.conjugation t
  have ha0 : ∀ i, a i ≠ 0 := by
    intro i h
    have := hpos i
    rw [h, map_zero, LinearMap.zero_apply] at this
    exact lt_irrefl 0 this
  obtain ⟨Q, q, hq, hqc, -, -⟩ := isSmoothConnectedClosed_semigroupSubgroup b hT (cone a)
  obtain ⟨Q', q', hq', hq'c, -, -⟩ :=
    isSmoothConnectedClosed_semigroupSubgroup b hT (cone (fun i => -a i))
  have hdyn := dynamicUnipotentSemigroupComparison_of_semigroupRealization semigroupRealization
    H T hT t cch
  have hdyn' := dynamicUnipotentSemigroupComparison_of_semigroupRealization semigroupRealization
    H T hT t (-cch)
  have hrep := isRepresentedBy_dynamicFactors_of_generated t a ν x y hx hy hrel hcomm hgen cch
    ht q' q hq'c hqc ?_ ?_ ?_ ?_
  · exact hrep.2.2.2.symm.trans hq.2
  · rw [groupHom_neg_comp, hq'.2, hdyn']
    exact semigroupSubgroup_mono b (positive_of_mem_cone_neg a cch hpos)
  · rw [hq.2, hdyn]
    exact semigroupSubgroup_mono b (cone_le_positiveSemigroup a cch hpos)
  · intro i g hg
    have hle : SubgroupFunctor.range (y i) ≤ SubgroupFunctor.range q' := by
      rw [hq'.2]
      exact range_line_le_semigroupSubgroup hT t (-a i) (neg_ne_zero.mpr (ha0 i)) (y i) (hy i)
        _ (cyclicTail_le_cone (fun j => -a j) i)
    exact hle _ hg
  · intro i g hg
    have hle : SubgroupFunctor.range (x i) ≤ SubgroupFunctor.range q := by
      rw [hq.2]
      exact range_line_le_semigroupSubgroup hT t (a i) (ha0 i) (x i) (hx i) _
        (cyclicTail_le_cone a i)
    exact hle _ hg

/-- **Positive roots lie in the cone** (CGP C.2.29(ii)). Under the hypotheses of
`unipotent_eq_semigroupSubgroup_cone`, every relative root of `t` pairing positively with the
cocharacter lies in the additive semigroup generated by the `a i`. -/
theorem mem_cone_of_mem_relativeRoots [IsAlgClosed k] (hT : IsSplitTorus T.toGrp)
    {Idx : Type*}
    (t : T.toGrp ⟶ H) (a : Idx → characterLattice T) (ν : Idx → cocharacterLattice T)
    (x y : Idx → (Ga k ⟶ H))
    (hx : ∀ i, IsTorusEquivariant t (x i) (a i)) (hy : ∀ i, IsTorusEquivariant t (y i) (-a i))
    (hrel : ∀ i, RelationOver t (ν i) (x i) (y i) (Over.mk (𝟙 (Spec (CommRingCat.of k)))))
    (hcomm : ∀ i j, i ≠ j → ∀ g ∈ rangePts (x i), ∀ h ∈ rangePts (y j), Commute g h)
    (hgen : Dense (rationalPointImage H (Subgroup.closure
      ((⋃ i, (rangePts (x i) : Set (rationalPoints H))) ∪ (⋃ i, (rangePts (y i) : Set (rationalPoints H))) ∪
        (rangePts t : Set (rationalPoints H))) : Set (rationalPoints H))))
    (cch : cocharacterLattice T) (hpos : ∀ i, 0 < latticePairing T (a i) cch)
    (ht : IsClosedSubgroup t) {χ : characterLattice T} (hχ : χ ∈ relativeRoots t)
    (hχpos : 0 < latticePairing T χ cch) : χ ∈ cone a := by
  let b := AutomorphicAction.conjugation t
  have hdyn := dynamicUnipotentSemigroupComparison_of_semigroupRealization semigroupRealization
    H T hT t cch
  have heq : semigroupSubgroup b (positiveSemigroup cch) = semigroupSubgroup b (cone a) :=
    hdyn.symm.trans (unipotent_eq_semigroupSubgroup_cone hT t a ν x y hx hy hrel hcomm hgen cch
      hpos ht)
  have h1 := actionWeightSupport_semigroupSubgroup semigroupRealization inferInstance hT b (cone a)
  have h2 := actionWeightSupport_semigroupSubgroup semigroupRealization inferInstance hT b
    (positiveSemigroup cch)
  rw [heq, h1] at h2
  have hmem : χ ∈ actionWeightSupport b ⊤ ∩ (positiveSemigroup cch : Set _) := by
    rw [actionWeightSupport_top_inter_positiveSemigroup]
    exact ⟨hχ, hχpos⟩
  rw [← h2] at hmem
  exact hmem.2

end Weights

end Langlands.GroupScheme.MaximalSplitSubgroup
