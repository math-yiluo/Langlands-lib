import Langlands.GroupScheme.Rational.RelativeTitsSystemStatement
import Langlands.GroupScheme.Rational.StandardParabolicPointsTits
import Langlands.GroupScheme.Rational.TitsStandardParabolicStatement

/-! # The standard-parabolic Tits realization from the relative Tits system and generation

With `S = simpleRelativeReflections i ν`, the relative Tits system statement provides the Tits
axioms and the bijection between simple relative roots and their reflections, and the generation
statement identifies `W_J` with the subgroup generated by the reflections in the roots of `J`.
Together they give `StandardParabolicTitsRealization`: every `W_J` is generated by a subset of
`S`, and every subset of `S` generates some `W_J`.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} {i : T.toGrp ⟶ G} [Mono i.hom.hom.left]
  [IsAffineHom G.X.hom] {ν : cocharacterLattice T}

/-- If every simple relative root has at most one relative reflection, every set `X` of simple
relative reflections is the set of reflections in the simple roots having a reflection in `X`. -/
theorem relativeReflections_setOf_eq
    (h : ∀ α ∈ simpleRelativeRoots i ν, ∀ w w' : relativeWeylGroup i,
      IsRelativeReflection i α w → IsRelativeReflection i α w' → w = w')
    {X : Set (relativeWeylGroup i)} (hX : X ⊆ simpleRelativeReflections i ν) :
    relativeReflections i
        {α | α ∈ simpleRelativeRoots i ν ∧ ∃ w ∈ X, IsRelativeReflection i α w} = X := by
  ext w
  constructor
  · rintro ⟨α, ⟨hα, w', hw', hαw'⟩, hαw⟩
    exact h α hα w w' hαw hαw' ▸ hw'
  · intro hw
    obtain ⟨α, hα, hαw⟩ := hX hw
    exact ⟨α, ⟨hα, w, hw, hαw⟩, hαw⟩

/-- The relative Tits system statement and the generation statement give the Tits realization
used by `standardParabolicPointsStatement_of_titsRealization`, with
`S = simpleRelativeReflections i ν`. -/
theorem standardParabolicTitsRealization_of_statements
    (hTS : RelativeTitsSystemStatement.{u}) (hW : StandardRelativeWeylGenerationStatement.{u}) :
    StandardParabolicTitsRealization.{u} := by
  intro k _ G hG T i hi ν
  let _ := hG.isAffineHom
  let _ := hi.isSplitSubtorus.mono
  intro hν
  have hR := hTS k G hG T i hi ν hν
  refine ⟨simpleRelativeReflections i ν, hR.isTitsSystem, fun J hJ => ?_, fun X hX => ?_⟩
  · exact ⟨relativeReflections i J, relativeReflections_subset_simple hJ,
      (hW k G hG T i hi ν hν J hJ).symm⟩
  · refine ⟨{α | α ∈ simpleRelativeRoots i ν ∧ ∃ w ∈ X, IsRelativeReflection i α w},
      fun α hα => hα.1, ?_⟩
    rw [← hW k G hG T i hi ν hν _ fun α hα => hα.1,
      relativeReflections_setOf_eq (fun α hα w w' hw hw' =>
        (hR.existsUnique_isRelativeReflection hα).unique hw hw') hX]

end Langlands.GroupScheme
