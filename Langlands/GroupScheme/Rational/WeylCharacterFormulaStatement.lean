import Langlands.GroupScheme.Rational.FundamentalRepresentations
import Langlands.LinearAlgebra.DominantTriangularInvariants

/-! # The Weyl character formula for a split reductive group in characteristic zero -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- The Weyl character formula (Milne, *Algebraic Groups* (2017), Theorem 22.52, in
characteristic zero as corrected by the errata). Let `p` be a split pinning of `G` over a
field of characteristic zero and suppose that the half sum `rho` of the positive roots lies
in the character lattice `X`. Write `J μ = ∑_{w ∈ W} det(w) e^{w μ}` in the group ring
`ℤ[X]`, where `W` is the group of automorphisms of `X` generated by the root reflections.
Then for every representation `r` with `p.IsHighestWeight r lam` (a simple representation
with highest weight `lam`), the character `ch(r) = ∑_μ dim(r_μ) e^μ` satisfies
`J(rho) * ch(r) = J(lam + rho)`. -/
def WeylCharacterFormulaStatement : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k]
    (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom]
    (p : SplitPinning G) (rho : characterLattice p.torus),
    2 • rho = (∑ᶠ (i : p.rootIndex) (_ : p.rootDatum.root i ∈ p.positiveRootMonoid),
      p.rootDatum.root i) →
    let J : characterLattice p.torus → AddMonoidAlgebra ℤ (characterLattice p.torus) :=
      fun μ => ∑ᶠ w : LinearAlgebra.DominantTriangular.reflectionGroup p.rootDatum,
        AddMonoidAlgebra.single
          ((w : characterLattice p.torus ≃ₗ[ℤ] characterLattice p.torus) μ)
          (LinearMap.det
            (w : characterLattice p.torus ≃ₗ[ℤ] characterLattice p.torus).toLinearMap)
    ∀ (n : ℕ) (r : MatrixRepresentation G (Fin n)) (lam : characterLattice p.torus),
      p.IsHighestWeight r lam →
      ∃ c : characterLattice p.torus →₀ ℤ,
        (∀ μ : characterLattice p.torus,
          c μ = Module.finrank k (p.representationWeightSpace r μ)) ∧
        J rho * AddMonoidAlgebra.ofCoeff c = J (lam + rho)

end Langlands.GroupScheme
