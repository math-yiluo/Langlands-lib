import Langlands.GroupScheme.Rational.StandardParabolic
import Langlands.GroupScheme.Rational.RootSubgroup
import Langlands.GroupScheme.Rational.RootProductStatement
import Langlands.GroupScheme.Rational.RelativeWeylCharacterAction
import Langlands.GroupScheme.Rational.SplitTorus
import Langlands.GroupScheme.Reductive.Basic
import Langlands.Geometry.Building.RealTorusSpace
import Mathlib.Geometry.Convex.Cone.Pointed
import Mathlib.Topology.Algebra.Module.ModuleTopology

/-!
# Closed, convex, symmetric and unipotent sets of relative roots (Renard V.4.2)

Renard V.4.2 considers subsets of the relative roots of a minimal Levi subgroup: closed,
convex, symmetric and unipotent subsets, the subgroups `G(X)` generated by `M_∅` and the
root groups `U_γ` (`γ ∈ X`) and `U(X)` generated by the root groups alone, the
intersection proposition of Borel-Tits 3.22, parabolic triples of roots and their
relation with standard parabolic subgroups (Borel-Tits 5.12-5.18).

The combinatorial notions take the ambient root set `R` as a parameter. Renard's `Σ_∅`
is the reduced set `RelativeRoot.indivisibleRoots i`; Borel-Tits work in the possibly
nonreduced set `relativeRoots i`. The statements record each reading where it is true;
the Markdown file explains why the literal reduced reading of V.4.2 (ii) is false.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

/-! ### Combinatorics of subsets of an ambient root set -/

section Combinatorics

variable (R : Set (characterLattice T))

/-- Renard V.4.2: a subset `X` of the ambient root set `R` is closed when
`(X + X) ∩ R ⊆ X`; the sum `β + γ` may have `β = γ`. -/
def IsClosedRootSubset (X : Set (characterLattice T)) : Prop :=
  X ⊆ R ∧ ∀ β ∈ X, ∀ γ ∈ X, β + γ ∈ R → β + γ ∈ X

/-- Renard V.4.2: `X` is convex when it is the intersection of `R` with a closed convex cone
of `𝔞^* = ℝ ⊗ X^*(T)`. Characters are sent to `𝔞^*` by `χ ↦ 1 ⊗ χ`; the finite-dimensional
real space carries its canonical (module) topology. -/
def IsConvexRootSubset (X : Set (characterLattice T)) : Prop :=
  ∃ C : PointedCone ℝ (RealTorusSpace.Vstar T),
    @IsClosed _ (moduleTopology ℝ (RealTorusSpace.Vstar T)) (C : Set (RealTorusSpace.Vstar T)) ∧
      X = {γ | γ ∈ R ∧ (1 : ℝ) ⊗ₜ[ℤ] γ ∈ C}

/-- Renard V.4.2: a closed subset `X` is symmetric when `X = -X`. -/
def IsSymmetricRootSubset (X : Set (characterLattice T)) : Prop :=
  IsClosedRootSubset R X ∧ ∀ γ ∈ X, -γ ∈ X

/-- The roots of `R` that pair positively with the cocharacter `ν`. For a generic `ν`
defining the minimal parabolic, these are Renard's `Σ^+_∅` in the ambient `R`. -/
def positiveRootSubset (ν : cocharacterLattice T) : Set (characterLattice T) :=
  {γ | γ ∈ R ∧ 0 < latticePairing T γ ν}

/-- The closed subset of `R` generated by `X`: the intersection of the closed subsets of `R`
containing `X`. It is meant for `X ⊆ R`; otherwise the intersection is empty and the result
is the whole lattice. -/
def rootClosure (X : Set (characterLattice T)) : Set (characterLattice T) :=
  ⋂₀ {Y | IsClosedRootSubset R Y ∧ X ⊆ Y}

/-- Renard V.4.2: a closed subset `P` of `R` is parabolic when it contains the positive
roots `Σ^+_∅` (here those positive for `ν`). -/
def IsParabolicRootSubset (ν : cocharacterLattice T) (P : Set (characterLattice T)) : Prop :=
  IsClosedRootSubset R P ∧ positiveRootSubset R ν ⊆ P

/-- The Levi part `M = P ∩ (-P)` of a parabolic triple `(P, M, N)`. -/
def parabolicRootLevi (P : Set (characterLattice T)) : Set (characterLattice T) :=
  {γ | γ ∈ P ∧ -γ ∈ P}

/-- The unipotent part `N = P \ M` of a parabolic triple `(P, M, N)`. -/
def parabolicRootUnipotent (P : Set (characterLattice T)) : Set (characterLattice T) :=
  {γ | γ ∈ P ∧ -γ ∉ P}

/-- Renard V.4.2 (Borel-Tits 5.12): the closed subset generated by `Σ^+_∅ ∪ (-Θ)`. -/
def standardParabolicRootSubset (ν : cocharacterLattice T) (Θ : Set (characterLattice T)) :
    Set (characterLattice T) :=
  rootClosure R (positiveRootSubset R ν ∪ {γ | -γ ∈ Θ})

/-- Renard V.4.2 (Borel-Tits 5.12): the closed subset generated by `Θ ∪ (-Θ)`. -/
def standardLeviRootSubset (Θ : Set (characterLattice T)) : Set (characterLattice T) :=
  rootClosure R (Θ ∪ {γ | -γ ∈ Θ})

/-- The unipotent part `N = P \ M` of the standard parabolic subset attached to `Θ`. -/
def standardUnipotentRootSubset (ν : cocharacterLattice T) (Θ : Set (characterLattice T)) :
    Set (characterLattice T) :=
  parabolicRootUnipotent (standardParabolicRootSubset R ν Θ)

variable {R}

theorem isClosedRootSubset_self : IsClosedRootSubset R R :=
  ⟨subset_rfl, fun _ _ _ _ h => h⟩

/-- A convex subset is closed. -/
theorem IsConvexRootSubset.isClosedRootSubset {X : Set (characterLattice T)}
    (hX : IsConvexRootSubset R X) : IsClosedRootSubset R X := by
  obtain ⟨C, -, rfl⟩ := hX
  refine ⟨fun γ hγ => hγ.1, fun β hβ γ hγ hR => ⟨hR, ?_⟩⟩
  rw [TensorProduct.tmul_add]
  exact C.add_mem hβ.2 hγ.2

theorem subset_rootClosure (X : Set (characterLattice T)) : X ⊆ rootClosure R X :=
  Set.subset_sInter fun _ hY => hY.2

theorem rootClosure_subset {X Y : Set (characterLattice T)} (hY : IsClosedRootSubset R Y)
    (hXY : X ⊆ Y) : rootClosure R X ⊆ Y :=
  Set.sInter_subset_of_mem ⟨hY, hXY⟩

/-- The generated closed subset is closed when the generators lie in `R`. -/
theorem isClosedRootSubset_rootClosure {X : Set (characterLattice T)} (hX : X ⊆ R) :
    IsClosedRootSubset R (rootClosure R X) := by
  refine ⟨rootClosure_subset isClosedRootSubset_self hX, fun β hβ γ hγ hR => ?_⟩
  exact Set.mem_sInter.2 fun Y hY =>
    hY.1.2 β (Set.mem_sInter.1 hβ Y hY) γ (Set.mem_sInter.1 hγ Y hY) hR

theorem positiveRootSubset_relativeRoots [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G)
    (ν : cocharacterLattice T) :
    positiveRootSubset (relativeRoots i) ν = positiveRelativeRoots i ν :=
  rfl

theorem positiveRootSubset_indivisibleRoots [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G)
    (ν : cocharacterLattice T) :
    positiveRootSubset (RelativeRoot.indivisibleRoots i) ν =
      RelativeRoot.indivisiblePositiveRoots i ν :=
  rfl

theorem parabolicRootUnipotent_eq_diff (P : Set (characterLattice T)) :
    parabolicRootUnipotent P = P \ parabolicRootLevi P := by
  ext γ
  simp only [parabolicRootUnipotent, parabolicRootLevi, Set.mem_ofPred_eq, Set.mem_sdiff]
  tauto

end Combinatorics

/-! ### Weyl-group notions -/

section Weyl

variable (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]

/-- `X` is unipotent (Renard V.4.2) when it is closed in `R` and contained in `w · Σ^+_∅`
for some `w` in the relative Weyl group `W_G = N(k)/Z(k)`, where `Σ^+_∅` is the set of roots
of `R` positive for `ν`. -/
def IsUnipotentRootSubset (ν : cocharacterLattice T) (R X : Set (characterLattice T)) : Prop :=
  IsClosedRootSubset R X ∧
    ∃ w : relativeWeylGroup i,
      X ⊆ relativeWeylCharacterAction i w '' positiveRootSubset R ν

/-- `w` acts on characters as a reflection with root `β`: there is a cocharacter `c` with
`⟨β, c⟩ = 2` and `w χ = χ - ⟨χ, c⟩ β` for every character `χ`. -/
def IsRootReflection (w : relativeWeylGroup i) (β : characterLattice T) : Prop :=
  ∃ c : cocharacterLattice T, latticePairing T β c = 2 ∧
    ∀ χ, relativeWeylCharacterAction i w χ = χ - latticePairing T χ c • β

/-- The Weyl group `W_X ⊆ W_G` of a symmetric subset `X`: the subgroup generated by the
elements of the relative Weyl group acting as reflections with roots in `X`. -/
def rootSubsetWeylGroup (X : Set (characterLattice T)) : Subgroup (relativeWeylGroup i) :=
  Subgroup.closure {w | ∃ β ∈ X, IsRootReflection i w β}

end Weyl

/-! ### The subgroups `G(X)` and `U(X)` -/

section Groups

variable (i : T.toGrp ⟶ G) (X : Set (characterLattice T))

/-- `h` exhibits Renard's `G(X)`: a closed subgroup containing, on every test scheme, the
centralizer `M_∅ = Z_G(S)` of the torus and the root subgroups `U_γ` (`γ ∈ X`), and contained
in every closed subgroup with this property. The root subgroup `RelativeRoot.subgroup i γ`
has the weights `γ` and `2γ`. -/
def IsRootSubsetGroup {H : GroupScheme (Spec (CommRingCat.of k))} (h : H ⟶ G) : Prop :=
  IsClosedSubgroup h ∧ torusCentralizer i ≤ SubgroupFunctor.range h ∧
    (∀ γ ∈ X, RelativeRoot.subgroup i γ ≤ SubgroupFunctor.range h) ∧
    ∀ (K : GroupScheme (Spec (CommRingCat.of k))) (q : K ⟶ G), IsClosedSubgroup q →
      torusCentralizer i ≤ SubgroupFunctor.range q →
      (∀ γ ∈ X, RelativeRoot.subgroup i γ ≤ SubgroupFunctor.range q) →
        SubgroupFunctor.range h ≤ SubgroupFunctor.range q

/-- `h` exhibits Renard's `U(X)`: the closed subgroup generated by the root subgroups `U_γ`
(`γ ∈ X`), with the same minimality as `IsRootSubsetGroup`. -/
def IsRootSubsetUnipotentGroup {H : GroupScheme (Spec (CommRingCat.of k))} (h : H ⟶ G) :
    Prop :=
  IsClosedSubgroup h ∧ (∀ γ ∈ X, RelativeRoot.subgroup i γ ≤ SubgroupFunctor.range h) ∧
    ∀ (K : GroupScheme (Spec (CommRingCat.of k))) (q : K ⟶ G), IsClosedSubgroup q →
      (∀ γ ∈ X, RelativeRoot.subgroup i γ ≤ SubgroupFunctor.range q) →
        SubgroupFunctor.range h ≤ SubgroupFunctor.range q

variable {i X}

/-- `G(X)` is unique as a subgroup functor. -/
theorem IsRootSubsetGroup.range_eq {H H' : GroupScheme (Spec (CommRingCat.of k))}
    {h : H ⟶ G} {h' : H' ⟶ G} (hh : IsRootSubsetGroup i X h)
    (hh' : IsRootSubsetGroup i X h') :
    SubgroupFunctor.range h = SubgroupFunctor.range h' :=
  le_antisymm (hh.2.2.2 H' h' hh'.1 hh'.2.1 hh'.2.2.1)
    (hh'.2.2.2 H h hh.1 hh.2.1 hh.2.2.1)

/-- `U(X)` is unique as a subgroup functor. -/
theorem IsRootSubsetUnipotentGroup.range_eq {H H' : GroupScheme (Spec (CommRingCat.of k))}
    {h : H ⟶ G} {h' : H' ⟶ G} (hh : IsRootSubsetUnipotentGroup i X h)
    (hh' : IsRootSubsetUnipotentGroup i X h') :
    SubgroupFunctor.range h = SubgroupFunctor.range h' :=
  le_antisymm (hh.2.2 H' h' hh'.1 hh'.2.1) (hh'.2.2 H h hh.1 hh.2.1)

end Groups

/-- Three subgroups satisfy `h₁ ∩ h₂ = h₃` on reduced points: on every test scheme with
reduced underlying scheme, a point of `G` lies in the ranges of `h₁` and `h₂` exactly when it
lies in the range of `h₃`. This is the intersection of the reduced algebraic groups of
Borel-Tits; the scheme-theoretic intersection is not asserted. -/
def HasReducedPointIntersection {H₁ H₂ H₃ : GroupScheme (Spec (CommRingCat.of k))}
    (h₁ : H₁ ⟶ G) (h₂ : H₂ ⟶ G) (h₃ : H₃ ⟶ G) : Prop :=
  ∀ U : Over (Spec (CommRingCat.of k)), IsReduced U.left → ∀ g : U ⟶ G.X,
    (g ∈ (SubgroupFunctor.range h₁).carrier U ∧ g ∈ (SubgroupFunctor.range h₂).carrier U ↔
      g ∈ (SubgroupFunctor.range h₃).carrier U)

/-- The two ambient root sets used: Borel-Tits' possibly nonreduced `Φ(S, G)` and Renard's
reduced `Σ_∅` (the indivisible relative roots). -/
def IsRelativeRootAmbient [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G)
    (R : Set (characterLattice T)) : Prop :=
  R = relativeRoots i ∨ R = RelativeRoot.indivisibleRoots i

/-! ### Statements -/

/-- Convexity is decided by the cone generated by the subset itself: for the relative roots
of a maximal split torus in either ambient set, `X` is convex exactly when `X ⊆ R` and every
root of `R` in the closed convex cone spanned by `X` lies in `X`. -/
def ConvexRootSubsetHullStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G), IsMaximalSplitTorus i →
    haveI := hG.isAffineHom
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ X : Set (characterLattice T),
        IsConvexRootSubset R X ↔
          X ⊆ R ∧ ∀ γ ∈ R,
            (1 : ℝ) ⊗ₜ[ℤ] γ ∈ PointedCone.hull ℝ ((fun χ => (1 : ℝ) ⊗ₜ[ℤ] χ) '' X) → γ ∈ X

/-- Unipotence does not depend on the minimal parabolic: a closed subset is unipotent exactly
when some cocharacter is positive on all its elements. -/
def UnipotentRootSubsetCocharacterStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ ν : cocharacterLattice T, IsGenericCocharacter i ν →
        ∀ X : Set (characterLattice T),
          IsUnipotentRootSubset i ν R X ↔
            IsClosedRootSubset R X ∧
              ∃ ζ : cocharacterLattice T, ∀ γ ∈ X, 0 < latticePairing T γ ζ

/-- Renard V.4.2: a symmetric closed subset is a root system with Weyl group `W_X ⊆ W_G`.
Every root of `X` has a reflection in the relative Weyl group, every such reflection
preserves `X`, and hence so does the subgroup `W_X` they generate. -/
def SymmetricRootSubsetWeylStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ X : Set (characterLattice T), IsSymmetricRootSubset R X →
        (∀ β ∈ X, ∃ w : relativeWeylGroup i, IsRootReflection i w β) ∧
        (∀ β ∈ X, ∀ w : relativeWeylGroup i, IsRootReflection i w β →
          relativeWeylCharacterAction i w '' X = X) ∧
        ∀ w ∈ rootSubsetWeylGroup i X, relativeWeylCharacterAction i w '' X = X

/-- Renard V.4.2, combinatorial part of the proposition citing Borel-Tits 5.12-5.18: for
`Θ ⊆ Δ_∅`, the closed subsets `P` and `M` generated by `Σ^+_∅ ∪ (-Θ)` and `Θ ∪ (-Θ)` form,
with `N = P \ M`, a parabolic triple; `P` consists of the positive roots and the roots in
`ℤΘ`, `M` of the roots in `ℤΘ`; `P`, `M`, `N` are convex, `N` is unipotent, `M` is
symmetric, and `Θ` is recovered from `P` as the simple roots whose negatives lie in `P`. -/
def StandardParabolicRootTripleStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ ν : cocharacterLattice T, IsGenericCocharacter i ν →
        ∀ Θ : Set (characterLattice T), Θ ⊆ simpleRelativeRoots i ν →
          IsParabolicRootSubset R ν (standardParabolicRootSubset R ν Θ) ∧
          parabolicRootLevi (standardParabolicRootSubset R ν Θ) = standardLeviRootSubset R Θ ∧
          standardParabolicRootSubset R ν Θ =
            {γ | γ ∈ R ∧ (0 < latticePairing T γ ν ∨ γ ∈ AddSubgroup.closure Θ)} ∧
          standardLeviRootSubset R Θ = {γ | γ ∈ R ∧ γ ∈ AddSubgroup.closure Θ} ∧
          IsConvexRootSubset R (standardParabolicRootSubset R ν Θ) ∧
          IsConvexRootSubset R (standardLeviRootSubset R Θ) ∧
          IsConvexRootSubset R (standardUnipotentRootSubset R ν Θ) ∧
          IsUnipotentRootSubset i ν R (standardUnipotentRootSubset R ν Θ) ∧
          IsSymmetricRootSubset R (standardLeviRootSubset R Θ) ∧
          Θ = {α | α ∈ simpleRelativeRoots i ν ∧ -α ∈ standardParabolicRootSubset R ν Θ}

/-- Renard V.4.2: the subgroups `G(X)` and `U(X)` exist for every set `X` of relative roots
and are smooth, affine and connected; `U(X)` is unipotent when `X` is unipotent. -/
def RootSubsetGroupExistenceStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    (∀ X : Set (characterLattice T), X ⊆ relativeRoots i →
      (∃ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
        IsRootSubsetGroup i X h ∧ Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧
          ConnectedSpace H.X.left) ∧
      ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
        IsRootSubsetUnipotentGroup i X h ∧ Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧
          ConnectedSpace H.X.left) ∧
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ ν : cocharacterLattice T, IsGenericCocharacter i ν →
        ∀ X : Set (characterLattice T), IsUnipotentRootSubset i ν R X →
          ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
            IsRootSubsetUnipotentGroup i X h → IsUnipotent H

/-- Renard V.4.2, group part of the proposition citing Borel-Tits 5.12-5.18: for `Θ ⊆ Δ_∅`
the groups `G(P)`, `G(M)` and `U(N)` of the standard parabolic triple are the standard
parabolic `P_Θ`, its standard Levi `M_Θ` and its unipotent radical `N_Θ`, and the Weyl group
`W_M` of the symmetric subset `M` is the relative Weyl group of `M_Θ`. -/
def StandardParabolicRootSubsetGroupStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ R : Set (characterLattice T), IsRelativeRootAmbient i R →
      ∀ ν : cocharacterLattice T, IsGenericCocharacter i ν →
        ∀ Θ : Set (characterLattice T), Θ ⊆ simpleRelativeRoots i ν →
          (∀ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
            IsRootSubsetGroup i (standardParabolicRootSubset R ν Θ) h →
              SubgroupFunctor.range h = standardParabolic i ν Θ) ∧
          (∀ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
            IsRootSubsetGroup i (standardLeviRootSubset R Θ) h →
              SubgroupFunctor.range h = standardLevi i ν Θ) ∧
          (∀ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
            IsRootSubsetUnipotentGroup i (standardUnipotentRootSubset R ν Θ) h →
              SubgroupFunctor.range h = standardUnipotent i ν Θ) ∧
          rootSubsetWeylGroup i (standardLeviRootSubset R Θ) = standardRelativeWeylGroup i ν Θ

/-- Borel-Tits 3.22 b) in the possibly nonreduced relative roots: for closed `S` and `X`
whose intersection is convex, `G(S) ∩ G(X) = G(S ∩ X)` on reduced points. -/
def ClosedRootSubsetGroupIntersectionStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G), IsMaximalSplitTorus i →
    haveI := hG.isAffineHom
    ∀ S X : Set (characterLattice T),
      IsClosedRootSubset (relativeRoots i) S → IsClosedRootSubset (relativeRoots i) X →
      IsConvexRootSubset (relativeRoots i) (S ∩ X) →
      ∀ (H₁ H₂ H₃ : GroupScheme (Spec (CommRingCat.of k)))
        (h₁ : H₁ ⟶ G) (h₂ : H₂ ⟶ G) (h₃ : H₃ ⟶ G),
        IsRootSubsetGroup i S h₁ → IsRootSubsetGroup i X h₂ →
        IsRootSubsetGroup i (S ∩ X) h₃ → HasReducedPointIntersection h₁ h₂ h₃

/-- Renard V.4.2 (i), in Renard's reduced `Σ_∅`: for convex `S` and `X`,
`G(S) ∩ G(X) = G(S ∩ X)` on reduced points. -/
def ConvexRootSubsetGroupIntersectionStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G), IsMaximalSplitTorus i →
    haveI := hG.isAffineHom
    ∀ S X : Set (characterLattice T),
      IsConvexRootSubset (RelativeRoot.indivisibleRoots i) S →
      IsConvexRootSubset (RelativeRoot.indivisibleRoots i) X →
      ∀ (H₁ H₂ H₃ : GroupScheme (Spec (CommRingCat.of k)))
        (h₁ : H₁ ⟶ G) (h₂ : H₂ ⟶ G) (h₃ : H₃ ⟶ G),
        IsRootSubsetGroup i S h₁ → IsRootSubsetGroup i X h₂ →
        IsRootSubsetGroup i (S ∩ X) h₃ → HasReducedPointIntersection h₁ h₂ h₃

/-- Renard V.4.2 (ii) as in Borel-Tits 3.22 c), in the possibly nonreduced relative roots: for
closed `S` and unipotent `X`, `G(S) ∩ U(X) = U(S ∩ X)` on reduced points. -/
def UnipotentRootSubsetGroupIntersectionStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ ν : cocharacterLattice T, IsGenericCocharacter i ν →
      ∀ S X : Set (characterLattice T),
        IsClosedRootSubset (relativeRoots i) S → IsUnipotentRootSubset i ν (relativeRoots i) X →
        ∀ (H₁ H₂ H₃ : GroupScheme (Spec (CommRingCat.of k)))
          (h₁ : H₁ ⟶ G) (h₂ : H₂ ⟶ G) (h₃ : H₃ ⟶ G),
          IsRootSubsetGroup i S h₁ → IsRootSubsetUnipotentGroup i X h₂ →
          IsRootSubsetUnipotentGroup i (S ∩ X) h₃ → HasReducedPointIntersection h₁ h₂ h₃

/-- The statements of Renard V.4.2 on closed subsets of relative roots. -/
def ClosedRootSubsetStatements : Prop :=
  ConvexRootSubsetHullStatement.{u} ∧ UnipotentRootSubsetCocharacterStatement.{u} ∧
    SymmetricRootSubsetWeylStatement.{u} ∧ StandardParabolicRootTripleStatement.{u} ∧
