import Langlands.GroupScheme.Rational.ClosedRootSubsetStatements
import Langlands.GroupScheme.Rational.ParabolicRootPresentationExistenceReduction
import Langlands.GroupScheme.Rational.RelativeWeylCoxeterProof
import Langlands.GroupScheme.Rational.RelativeRootSystemProof
import Langlands.GroupScheme.Rational.WeylPositiveCocharacter

/-! # The stabilizer of an actual integral cocharacter -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.Aubert.General.RationalPointFamily
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]

/-- Reflections in characters annihilating a cocharacter preserve all its
character pairings, as does the subgroup they generate. -/
theorem rootSubsetWeylGroup_preserves_pairing
    {X : Set (characterLattice T)} (ξ : cocharacterLattice T)
    (hX : ∀ β ∈ X, latticePairing T β ξ = 0)
    {w : relativeWeylGroup i} (hw : w ∈ rootSubsetWeylGroup i X) :
    ∀ χ, latticePairing T (relativeWeylCharacterAction i w χ) ξ =
      latticePairing T χ ξ := by
  induction hw using Subgroup.closure_induction with
  | mem v hv =>
    obtain ⟨β, hβ, c, -, hc⟩ := hv
    intro χ
    rw [hc]
    simp only [map_sub, LinearMap.sub_apply, map_zsmul, LinearMap.smul_apply,
      hX β hβ, smul_zero, sub_zero]
  | one =>
    intro χ
    rw [map_one]
    rfl
  | mul a b _ _ ha hb =>
    intro χ
    rw [map_mul, LinearEquiv.mul_apply, ha, hb]
  | inv a _ ha =>
    intro χ
    have h := ha (relativeWeylCharacterAction i a⁻¹ χ)
    rw [← LinearEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one] at h
    exact h.symm

/-- A simple reflection of a realized relative Coxeter system has an actual
integral cocharacter in the published root-reflection formula. -/
theorem IsRelativeWeylCoxeterRealization.isRootReflection
    [IsAffineHom G.X.hom] {ν : cocharacterLattice T}
    {M : CoxeterMatrix (SimpleRoot i ν)}
    {cs : CoxeterSystem M (relativeWeylGroup i)}
    (h : IsRelativeWeylCoxeterRealization i ν cs)
    (hT : IsSplitTorus T.toGrp) (a : SimpleRoot i ν) :
    IsRootReflection i (cs.simple a) a.1 := by
  obtain ⟨f, hf, ha⟩ := h.1 a
  obtain ⟨c, hc⟩ := hT.isPerfPair_latticePairing.bijective_right.surjective f.toIntLinearMap
  have hpair (χ : characterLattice T) : latticePairing T χ c = f χ :=
    LinearMap.congr_fun hc χ
  exact ⟨c, (hpair a.1).trans hf, fun χ => by rw [hpair]; exact ha χ⟩

variable [IsAffineHom G.X.hom]

/-- A Weyl element preserving the pairings with an integral cocharacter
is generated by root reflections in roots on which that cocharacter vanishes. -/
theorem mem_rootSubsetWeylGroup_zero_of_pairing_fixed
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (ξ : cocharacterLattice T) (w : relativeWeylGroup i)
    (hw : ∀ χ, latticePairing T (relativeWeylCharacterAction i w χ) ξ =
      latticePairing T χ ξ) :
    w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} := by
  let := hG.smooth
  have hT := hi.isSplitSubtorus.1
  have hroot := relativeRootSystem k G hG T i hi
  obtain ⟨ν, hν, hrefine⟩ := hT.exists_genericCocharacter_refining i ξ
  obtain ⟨_, _, M, cs, hcs⟩ := relativeWeylCoxeter k G hG T i hi ν hν
  have hsimple (s : SimpleRoot i ν) (hs : latticePairing T s.1 ξ = 0) :
      cs.simple s ∈ rootSubsetWeylGroup i
        {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} :=
    Subgroup.subset_closure ⟨s.1, ⟨s.2.1.1, hs⟩, hcs.isRootReflection i hT s⟩
  suffices key : ∀ (l : ℕ) (v : relativeWeylGroup i), cs.length v = l →
      (∀ χ, latticePairing T (relativeWeylCharacterAction i v χ) ξ =
        latticePairing T χ ξ) →
      v ∈ rootSubsetWeylGroup i
        {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} from
    key _ w rfl hw
  intro l
  induction l using Nat.strong_induction_on with
  | _ l ih =>
    intro v hl hv
    by_cases h1 : v = 1
    · rw [h1]
      exact one_mem _
    obtain ⟨s, hs⟩ := cs.exists_rightDescent_of_ne_one h1
    have hnot : schemeWeylCharacterAction i v s.1 ∉ positiveRelativeRoots i ν :=
      fun hp => lt_asymm hs ((hcs.2.2.1 v s).2 hp)
    have hnegpos : -(schemeWeylCharacterAction i v s.1) ∈ positiveRelativeRoots i ν := by
      by_contra hc
      exact hnot (mem_positiveRelativeRoots_of_neg_not_mem hroot hT hν
        (schemeWeylCharacterAction_mem_relativeRoots _ s.2.1.1) hc)
    have hle := hrefine _ hnegpos.1 hnegpos.2.le
    change latticePairing T (-relativeWeylCharacterAction i v s.1) ξ ≥ 0 at hle
    rw [map_neg, LinearMap.neg_apply, hv] at hle
    have hge := hrefine s.1 s.2.1.1 s.2.1.2.le
    have hzero : latticePairing T s.1 ξ = 0 := by omega
    have hvs : v * cs.simple s ∈ rootSubsetWeylGroup i
        {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} := by
      apply ih _ (hl ▸ hs) _ rfl
      intro χ
      rw [map_mul, LinearEquiv.mul_apply, hv]
      exact rootSubsetWeylGroup_preserves_pairing i ξ (fun _ hα => hα.2) (hsimple s hzero) χ
    have := mul_mem hvs (hsimple s hzero)
    rwa [CoxeterSystem.simple_mul_simple_cancel_right] at this

omit [IsAffineHom G.X.hom] in
/-- Pairing preservation is equivalent to fixing the actual integral
cocharacter under the published quotient action. -/
theorem IsSplitTorus.relativeWeylCocharacterAction_eq_self_iff_pairing
    (hT : IsSplitTorus T.toGrp) (ξ : cocharacterLattice T) (w : relativeWeylGroup i) :
    relativeWeylCocharacterAction i w ξ = ξ ↔
      ∀ χ, latticePairing T (relativeWeylCharacterAction i w χ) ξ =
        latticePairing T χ ξ := by
  constructor
  · intro h χ
    have hpair := latticePairing_relativeWeyl i w χ ξ
    rwa [h] at hpair
  · intro h
    apply hT.isPerfPair_latticePairing.bijective_right.injective
    apply LinearMap.ext
    intro χ
    change latticePairing T χ (relativeWeylCocharacterAction i w ξ) = latticePairing T χ ξ
    rw [latticePairing_relativeWeyl_right]
    have hpair := h (relativeWeylCharacterAction i w⁻¹ χ)
    rw [← LinearEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one] at hpair
    exact hpair.symm

/-- The actual cocharacter stabilizer is the subgroup generated by
reflections in the roots that annihilate it. -/
theorem mem_rootSubsetWeylGroup_zero_iff_cocharacter_fixed
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (ξ : cocharacterLattice T) (w : relativeWeylGroup i) :
    w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} ↔
      relativeWeylCocharacterAction i w ξ = ξ := by
  rw [hi.isSplitSubtorus.1.relativeWeylCocharacterAction_eq_self_iff_pairing i]
  exact ⟨rootSubsetWeylGroup_preserves_pairing i ξ (fun _ hα => hα.2),
    mem_rootSubsetWeylGroup_zero_of_pairing_fixed i hG hi ξ w⟩

/-- Uniform identification of the cocharacter stabilizer in the actual
relative Weyl group with the Weyl subgroup of its zero roots. -/
def WeylCocharacterStabilizerStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ (ξ : cocharacterLattice T) (w : relativeWeylGroup i),
      w ∈ rootSubsetWeylGroup i {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} ↔
        relativeWeylCocharacterAction i w ξ = ξ

/-- Generic refinement and Coxeter descent prove the uniform stabilizer
identification without additional root-theoretic premises. -/
theorem weylCocharacterStabilizer : WeylCocharacterStabilizerStatement.{u} := by
  intro k _ G hG T i hi
  let := hG.isAffineHom
  let := hi.isSplitSubtorus.mono
  exact mem_rootSubsetWeylGroup_zero_iff_cocharacter_fixed i hG hi

end Langlands.GroupScheme
