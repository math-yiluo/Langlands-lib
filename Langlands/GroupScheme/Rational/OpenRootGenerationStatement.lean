import Langlands.GroupScheme.Rational.Characters
import Langlands.GroupScheme.Rational.RootSubgroup
import Langlands.GroupScheme.Rational.TorusCentralizer
import Langlands.GroupScheme.Rational.PointTopology
import Mathlib.NumberTheory.LocalField.Basic

/-!
# Open subgroups generated by open root and centralizer subgroups

KP Corollary 8.2.6 over a nonarchimedean local field, in the canonical
rational-point topology on actual points.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.GroupScheme.RelativeRoot

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

/-- For one group, torus and centralizer inclusion: the subgroup generated by open
subgroups `V a` of the actual root groups `U_a(F)`, for all relative roots `a`, and by
the image of an open subgroup `Z'` of `Z(F)`, is open in `G(F)`. Each `U_a(F)` carries
the subspace topology of the canonical topology on `G(F)`. -/
def OpenRootCentralizerGeneration
    {G : GroupScheme (Spec (CommRingCat.of F))} (hG : IsConnectedReductive G)
    {S : CommGroupScheme (Spec (CommRingCat.of F))} (i : S.toGrp ⟶ G)
    {Z : GroupScheme (Spec (CommRingCat.of F))} (j : Z ⟶ G) (hj : IsClosedSubgroup j) :
    Prop :=
  letI : IsAffineHom G.X.hom := hG.isAffineHom
  letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  letI : IsClosedImmersion j.hom.hom.left := hj
  letI : IsAffine Z.X.left := isAffine_of_isAffineHom j.hom.hom.left
  letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
  letI : TopologicalSpace (rationalPoints Z) := rationalPointTopology F Z.X
  ∀ (V : relativeRoots i → Subgroup (rationalPoints G)) (Z' : Subgroup (rationalPoints Z)),
    (∀ a : relativeRoots i,
      V a ≤ (subgroup i (a : characterLattice S)).carrier (Over.mk (𝟙 _))) →
    (∀ a : relativeRoots i, IsOpen ((V a).subgroupOf
      ((subgroup i (a : characterLattice S)).carrier (Over.mk (𝟙 _))) :
        Set ((subgroup i (a : characterLattice S)).carrier (Over.mk (𝟙 _))))) →
    IsOpen (Z' : Set (rationalPoints Z)) →
    IsOpen ((Z'.map (rationalPoints.map j) ⊔ ⨆ a, V a : Subgroup (rationalPoints G)) :
      Set (rationalPoints G))

/-- KP Corollary 8.2.6 over every nonarchimedean local field: for a connected
reductive group `G`, a maximal split torus `S` and the actual centralizer `Z = Z_G(S)`,
open subgroups of the root groups `U_a(F)` and of `Z(F)` generate an open subgroup of
`G(F)`. This is a statement target; it assumes no open-cell or product decomposition. -/
def OpenRootCentralizerGenerationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G),
    IsMaximalSplitTorus i →
    ∀ (Z : GroupScheme (Spec (CommRingCat.of F))) (j : Z ⟶ G),
      (torusCentralizer i).IsRepresentedBy j →
      ∀ hj : IsClosedSubgroup j, OpenRootCentralizerGeneration hG i j hj

end Langlands.GroupScheme.RelativeRoot
