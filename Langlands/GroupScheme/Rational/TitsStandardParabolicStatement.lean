import Langlands.Group.TitsSystem
import Langlands.GroupScheme.Rational.RelativeReflection
import Langlands.GroupScheme.Rational.Statement
import Langlands.GroupScheme.Rational.StandardParabolicEndpointsStatement
import Langlands.GroupScheme.Rational.StandardParabolicPointsStatement
import Langlands.GroupScheme.Rational.TitsStandardParabolic

/-! # Standard parabolics of the rational Tits system: targets and comparisons -/

set_option backward.isDefEq.respectTransparency false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise

namespace Langlands.GroupScheme

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

section Cells

variable [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)

/-- The Bruhat cell of the class of `n` for `B = P_∅(k)` is the double coset `B n B`. -/
theorem cell_mk_eq_doubleCoset (n : normalizerPoints i) :
    Langlands.Group.TitsSystem.cell (standardParabolicPoints i ν ∅)
        (QuotientGroup.mk' ((centralizerPoints i).subgroupOf (normalizerPoints i)))
        (QuotientGroup.mk n) =
      DoubleCoset.doubleCoset (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)
        (standardParabolicPoints i ν ∅) (standardParabolicPoints i ν ∅) := by
  ext g
  rw [DoubleCoset.mem_doubleCoset]
  constructor
  · rintro ⟨m, hm, b, hb, b', hb', rfl⟩
    have hz : n⁻¹ * m ∈ (centralizerPoints i).subgroupOf (normalizerPoints i) := by
      rw [← QuotientGroup.eq]
      exact hm.symm
    refine ⟨b, hb, ((n⁻¹ * m : normalizerPoints i) :
        Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) * b',
      Subgroup.mul_mem _ (centralizerPoints_le_standardParabolicPoints i ν ∅ hz) hb', ?_⟩
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_assoc, mul_inv_cancel_left]
  · rintro ⟨b, hb, b', hb', rfl⟩
    exact ⟨n, rfl, b, hb, b', hb', rfl⟩

end Cells

/-! ### The targets -/

/-- **The standard relative Weyl subgroups are generated by simple reflections**
(Borel–Tits 5.17). For a maximal split torus `i` of a connected reductive group and a
generic cocharacter `ν`, and every set `J` of simple relative roots, the subgroup of the
relative Weyl group generated by the reflections in the roots of `J` is the standard
relative Weyl subgroup `standardRelativeWeylGroup i ν J`, the image of the normalizer
points in the standard Levi `L_J(k)`. -/
def StandardRelativeWeylGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice T),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    IsGenericCocharacter i ν →
      ∀ J : Set (characterLattice T), J ⊆ simpleRelativeRoots i ν →
        Subgroup.closure (relativeReflections i J) = standardRelativeWeylGroup i ν J

/-- **Normalizing points in standard parabolics** (Borel–Tits 5.15, 5.17). For a maximal
split torus `i` of a connected reductive group, a generic cocharacter `ν` and a set `J` of
simple relative roots, a normalizing point lies in the standard parabolic `P_J(k)` exactly
when its class lies in the standard relative Weyl subgroup `standardRelativeWeylGroup i ν J`. -/
def NormalizerStandardParabolicStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice T),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    IsGenericCocharacter i ν →
      ∀ J : Set (characterLattice T), J ⊆ simpleRelativeRoots i ν →
        ∀ n : normalizerPoints i,
          (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈ standardParabolicPoints i ν J ↔
            (QuotientGroup.mk n : relativeWeylGroup i) ∈ standardRelativeWeylGroup i ν J

/-- **The standard parabolics of the rational Tits system** (Borel–Tits 5.17). For every
set `J` of simple relative roots, the standard parabolic set `B W_J B` of the rational
Tits system, with `B = P_∅(k)` and `W_J` generated by the reflections in the roots of
`J`, is the group of rational points of the standard parabolic `P_J`. -/
def TitsStandardParabolicStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice T),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    IsGenericCocharacter i ν →
      ∀ J : Set (characterLattice T), J ⊆ simpleRelativeRoots i ν →
        (standardParabolicPoints i ν J : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)) =
          Langlands.Group.TitsSystem.standardParabolic (standardParabolicPoints i ν ∅)
            (QuotientGroup.mk' ((centralizerPoints i).subgroupOf (normalizerPoints i)))
            (relativeReflections i J)

/-! ### Comparisons with the published statements -/

/-- The standard-parabolic comparison follows from the endpoint, rational-point and
generation statements. -/
theorem titsStandardParabolicStatement_of_statements
    (hE : StandardParabolicEndpointsStatement.{u}) (hP : StandardParabolicPointsStatement.{u})
    (hW : StandardRelativeWeylGenerationStatement.{u}) : TitsStandardParabolicStatement.{u} := by
  intro k _ G hG T i hi ν
  have := hG.isAffineHom
  have := hi.isSplitSubtorus.mono
  intro hν J hJ
  have hB : standardParabolicPoints i ν ∅ =
      (Dynamic.parabolic (CommGroupScheme.groupHom ν ≫ i)).carrier
        (Over.mk (𝟙 (Spec (CommRingCat.of k)))) := by
    rw [standardParabolicPoints, (hE k G hG T i hi ν hν).1]
  have hgen := hW k G hG T i hi ν hν J hJ
  ext g
  rw [SetLike.mem_coe, (hP k G hG T i hi ν hν).1 J hJ g]
  simp only [Langlands.Group.TitsSystem.standardParabolic, Langlands.Group.TitsSystem.cell,
    hgen, hB]
  constructor
  · rintro ⟨n, hn, p, hp, q, hq, rfl⟩
    exact ⟨QuotientGroup.mk n, hn, n, rfl, p, hp, q, hq, rfl⟩
  · rintro ⟨w, hw, n, rfl, p, hp, q, hq, rfl⟩
    exact ⟨n, hw, p, hp, q, hq, rfl⟩

/-- The normalizer comparison follows from the rational-point and Bruhat statements. The
reverse implication holds unconditionally (`coe_mem_standardParabolicPoints_of_mk_mem`). -/
theorem normalizerStandardParabolicStatement_of_statements
    (hP : StandardParabolicPointsStatement.{u}) (hBr : RationalBruhatStatement.{u}) :
    NormalizerStandardParabolicStatement.{u} := by
  intro k _ G hG T i hi ν
  have := hG.isAffineHom
  have := hi.isSplitSubtorus.mono
  intro hν J hJ n
  constructor
  · intro hn
    obtain ⟨m, hm, p, hp, q, hq, he⟩ := ((hP k G hG T i hi ν hν).1 J hJ n).1 hn
    have hmn : (QuotientGroup.mk m : relativeWeylGroup i) = QuotientGroup.mk n :=
      ((hBr k G hG T i hi ν hν).2 m n).1 ⟨p, hp, q, hq, he⟩
    rw [← hmn]
    exact hm
  · exact coe_mem_standardParabolicPoints_of_mk_mem i ν J

section Comparisons

variable [IsAffineHom G.X.hom] {i : T.toGrp ⟶ G} {ν : cocharacterLattice T}

/-- With the endpoint and Bruhat statements, the representative map is a bijection from
the relative Weyl group onto `P_∅(k) \ G(k) / P_∅(k)` (Borel–Tits 5.15). -/
theorem relativeWeylDoubleCoset_bijective_of_statements
    (hE : StandardParabolicEndpointsStatement.{u}) (hBr : RationalBruhatStatement.{u})
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i) (hν : IsGenericCocharacter i ν) :
    Function.Bijective (relativeWeylDoubleCoset i ν ∅ ∅) := by
  have hB : standardParabolicPoints i ν ∅ =
      (Dynamic.parabolic (CommGroupScheme.groupHom ν ≫ i)).carrier
        (Over.mk (𝟙 (Spec (CommRingCat.of k)))) := by
    have := hi.isSplitSubtorus.mono
    rw [standardParabolicPoints, (hE k G hG T i hi ν hν).1]
  obtain ⟨hsurj, hinj⟩ := hBr k G hG T i hi ν hν
  constructor
  · intro w w' h
    induction w using QuotientGroup.induction_on with | H n => ?_
    induction w' using QuotientGroup.induction_on with | H n' => ?_
    rw [relativeWeylDoubleCoset_mk, relativeWeylDoubleCoset_mk, DoubleCoset.eq] at h
    obtain ⟨p, hp, q, hq, he⟩ := h
    rw [hB] at hp hq
    exact (hinj n n').1 ⟨p, hp, q, hq, he⟩
  · intro x
    induction x using Quotient.inductionOn' with | h g => ?_
    obtain ⟨n, hn, p, hp, q, hq, rfl⟩ := hsurj g
    refine ⟨QuotientGroup.mk ⟨n, hn⟩, ?_⟩
    rw [relativeWeylDoubleCoset_mk]
    refine (DoubleCoset.eq.2 ⟨p, ?_, q, ?_, rfl⟩)
    · rw [hB]
      exact hp
    · rw [hB]
      exact hq

/-- With the endpoint statement, the standard relative Weyl subgroup of `J = ∅` is trivial;
this is the case `J = ∅` of `StandardRelativeWeylGenerationStatement`. -/
theorem standardRelativeWeylGroup_empty_of_statement
    (hE : StandardParabolicEndpointsStatement.{u}) (hG : IsConnectedReductive G)
    (hi : IsMaximalSplitTorus i) (hν : IsGenericCocharacter i ν) :
    standardRelativeWeylGroup i ν ∅ = ⊥ := by
  have hL : standardLeviPoints i ν ∅ = centralizerPoints i := by
    have := hi.isSplitSubtorus.mono
    rw [standardLeviPoints, (hE k G hG T i hi ν hν).2.1, torusCentralizer_carrier_base]
  rw [eq_bot_iff]
  intro w hw
  obtain ⟨n, hn, rfl⟩ := (mem_standardRelativeWeylGroup_iff i ν).1 hw
  rw [hL] at hn
  rw [Subgroup.mem_bot, QuotientGroup.eq_one_iff]
  exact hn

/-- The rational-point statement identifies `W_J \ W / W_K` with `P_J(k) \ G(k) / P_K(k)`
compatibly with the representative map (Borel–Tits 5.20). -/
theorem exists_relativeWeylDoubleCoset_equiv_of_statement
    (hP : StandardParabolicPointsStatement.{u}) (hG : IsConnectedReductive G)
    (hi : IsMaximalSplitTorus i) (hν : IsGenericCocharacter i ν)
    {J K : Set (characterLattice T)} (hJ : J ⊆ simpleRelativeRoots i ν)
    (hK : K ⊆ simpleRelativeRoots i ν) :
    ∃ e : DoubleCoset.Quotient
        (↑(standardRelativeWeylGroup i ν J) : Set (relativeWeylGroup i))
        (↑(standardRelativeWeylGroup i ν K) : Set (relativeWeylGroup i)) ≃
      DoubleCoset.Quotient
        (standardParabolicPoints i ν J : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X))
        (standardParabolicPoints i ν K),
      ∀ w : relativeWeylGroup i,
        e (DoubleCoset.mk (standardRelativeWeylGroup i ν J) (standardRelativeWeylGroup i ν K) w) =
          relativeWeylDoubleCoset i ν J K w := by
  obtain ⟨e, he⟩ := (hP k G hG T i hi ν hν).2.2.2 J K hJ hK
  refine ⟨e, fun w => ?_⟩
  induction w using QuotientGroup.induction_on with | H n => ?_
  exact he n

end Comparisons

end Langlands.GroupScheme
