import Langlands.GroupScheme.Rational.RootGeneratedBruhatWord
import Langlands.GroupScheme.Rational.RelativeReflectionProperties
import Mathlib.GroupTheory.Coxeter.Basic

/-! # Actual root-generated Bruhat covering from simple lifts -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.Aubert.General.RationalPointFamily
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [IsAffineHom G.X.hom] [Mono i.hom.hom.left]
  (ν : cocharacterLattice T)

/-- The generators used for the actual Bruhat word argument. -/
def rootGeneratedBruhatGenerators (H : Subgroup (rationalPoints G))
    (m : SimpleRoot i ν → normalizerPoints i) : Set (rationalPoints G) :=
  (RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i) : Set (rationalPoints G)) ∪
    (H : Set (rationalPoints G)) ∪ Set.range (fun a => (m a).val)

namespace RelativeRoot

omit ν in
/-- A chosen opposite-root lift suffices for the point factorization:
all pair-derived lifts have the same Weyl reflection and differ from the
chosen lift by a centralizing element of the same rank-one subgroup. -/
theorem rootPoint_factorization_of_reflectionLift
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hE : HasOppositeFactorPairs i)
    (M : Subgroup (rationalPoints G))
    {a : characterLattice T} (ha : a ∈ relativeRoots i)
    (n : normalizerPoints i) (hs : IsRelativeReflection i a (QuotientGroup.mk n))
    (hnM : n.val ∈ M)
    (hnL : n.val ∈ Subgroup.closure
      (((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
        (subgroup i (-a)).carrier (Over.mk (𝟙 _))))
    (hH : centralizerPoints i ⊓ Subgroup.closure
      (((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
        (subgroup i (-a)).carrier (Over.mk (𝟙 _))) ≤ M)
    (x : rationalPoints G) (hx : x ∈ (subgroup i a).carrier (Over.mk (𝟙 _)))
    (hx1 : x ≠ 1) :
    ∃ y ∈ (subgroup i (-a)).carrier (Over.mk (𝟙 _)),
      ∃ m ∈ M, ∃ z ∈ (subgroup i (-a)).carrier (Over.mk (𝟙 _)),
        x = y * m * z := by
  obtain ⟨p, hp⟩ := hE a ha x hx hx1
  let L := Subgroup.closure
    (((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
      (subgroup i (-a)).carrier (Over.mk (𝟙 _)))
  let n' : normalizerPoints i := ⟨p.1 * x * p.2, hp.2.2⟩
  have hn'L : n'.val ∈ L :=
    L.mul_mem (L.mul_mem (Subgroup.subset_closure (Or.inr hp.1))
      (Subgroup.subset_closure (Or.inl hx)))
      (Subgroup.subset_closure (Or.inr hp.2.1))
  have heq : (QuotientGroup.mk n : relativeWeylGroup i) = QuotientGroup.mk n' :=
    hroot.eq_of_isRelativeReflection hs (hp.isRelativeReflection i hT ha hx hx1)
  have hz : n⁻¹ * n' ∈ (centralizerPoints i).subgroupOf (normalizerPoints i) :=
    QuotientGroup.eq.mp heq
  have hdiff : n.val⁻¹ * n'.val ∈ M :=
    hH ⟨hz, L.mul_mem (L.inv_mem hnL) hn'L⟩
  have hn'M : n'.val ∈ M := by
    simpa only [mul_inv_cancel_left] using M.mul_mem hnM hdiff
  refine ⟨p.1⁻¹, Subgroup.inv_mem _ hp.1, n'.val, hn'M,
    p.2⁻¹, Subgroup.inv_mem _ hp.2.1, ?_⟩
  dsimp only [n']
  group

/-- A Weyl-surjective middle subgroup transports every actual root into
the positive chamber, so the actual root groups are generated by `U` and it. -/
theorem rootGenerated_le_closure_unipotent_union_of_weylSurjective
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hν : IsGenericCocharacter i ν)
    (M : Subgroup (rationalPoints G))
    (hW : Function.Surjective (subgroupRelativeWeylMap i M)) :
    Subgroup.closure (⋃ a ∈ relativeRoots i,
      ((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G))) ≤
        Subgroup.closure
          ((RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i) :
            Set (rationalPoints G)) ∪ (M : Set (rationalPoints G))) := by
  apply rootGenerated_le_closure_unipotent_union i ν M
  intro a ha
  rcases lt_or_gt_of_ne (hν _ ha) with hneg | hpos
  · obtain ⟨w, hw⟩ := hroot.exists_isRelativeReflection ha
    obtain ⟨n, hn⟩ := hW w
    change (QuotientGroup.mk n.val : relativeWeylGroup i) = w at hn
    rw [← hn] at hw
    refine ⟨n.val, n.property, ?_⟩
    rw [hw.weylAction_apply_self i hT n.val, map_neg, LinearMap.neg_apply]
    exact neg_pos.mpr hneg
  · exact ⟨1, M.one_mem, by simpa using hpos⟩

end RelativeRoot

/-- A simple lift preserves `U M U` when `M` contains the centralizing
part of its opposite-root subgroup. No containment of all its normalizing
points is needed. -/
theorem mul_mem_rootGenerated_doubleCosets_of_reflectionLift
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hν : IsGenericCocharacter i ν)
    (hfac : HasSimpleRootUnipotentFactorization i ν)
    (hE : RelativeRoot.HasOppositeFactorPairs i)
    (M : Subgroup (rationalPoints G)) (hMN : M ≤ normalizerPoints i)
    {a : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν)
    (n : normalizerPoints i) (hs : IsRelativeReflection i a (QuotientGroup.mk n))
    (hnM : n.val ∈ M)
    (hnL : n.val ∈ Subgroup.closure
      (((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
        (RelativeRoot.subgroup i (-a)).carrier (Over.mk (𝟙 _))))
    (hH : centralizerPoints i ⊓ Subgroup.closure
      (((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
        (RelativeRoot.subgroup i (-a)).carrier (Over.mk (𝟙 _))) ≤ M)
    {g : rationalPoints G}
    (hg : g ∈ Langlands.Group.RankOneBruhat.doubleCosets
      (RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i)) M) :
    n.val * g ∈ Langlands.Group.RankOneBruhat.doubleCosets
      (RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i)) M := by
  refine Langlands.Group.RankOneBruhat.mul_mem_doubleCosets_of_rankOne hnM
    ((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)))
    ((RelativeRoot.subgroup i (-a)).carrier (Over.mk (𝟙 _)))
    {q | n.val * q * n.val⁻¹ ∈
      RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i)} ?_ ?_ ?_ ?_ ?_ hg
  · intro u hu
    obtain ⟨q, -, hq, x, hx, heq⟩ := hfac a ha n hs u hu
    exact ⟨q, hq, x, hx, heq⟩
  · intro q hq
    exact hq
  · intro x hx
    have hc := RelativeRoot.normalizer_conj_mem i (-a) n hx
    simp only [GroupScheme.constantPoint_self, map_neg,
      hs.weylAction_apply_self i hT n, neg_neg] at hc
    exact RelativeRoot.subgroup_le_dynamicUnipotent i ν ha.1.2 _ hc
  · exact RelativeRoot.rootPoint_factorization_of_reflectionLift
      i hT hroot hE M ha.1.1 n hs hnM hnL hH
  · intro n' hn'
    exact RelativeRoot.rootPoint_conjugation_sign i ν hν ha.1.1 ⟨n', hMN hn'⟩

/-- The group word argument gives actual root-generated covering for a
middle subgroup generated by centralizing points and simple lifts. -/
theorem hasRootGeneratedBruhatCovering_of_simpleLifts
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hν : IsGenericCocharacter i ν)
    (hfac : HasSimpleRootUnipotentFactorization i ν)
    (hE : RelativeRoot.HasOppositeFactorPairs i)
    {C : CoxeterMatrix (SimpleRoot i ν)}
    (cs : CoxeterSystem C (relativeWeylGroup i))
    (H M : Subgroup (rationalPoints G))
    (hHZ : H ≤ centralizerPoints i) (hHM : H ≤ M) (hMN : M ≤ normalizerPoints i)
    (m : SimpleRoot i ν → normalizerPoints i)
    (hmM : ∀ a, (m a).val ∈ M)
    (hmclass : ∀ a, (QuotientGroup.mk (m a) : relativeWeylGroup i) = cs.simple a)
    (hmref : ∀ a, IsRelativeReflection i a.val (QuotientGroup.mk (m a)))
    (hmL : ∀ a, (m a).val ∈ Subgroup.closure
      (((RelativeRoot.subgroup i a.val).carrier (Over.mk (𝟙 _)) :
        Set (rationalPoints G)) ∪
          (RelativeRoot.subgroup i (-a.val)).carrier (Over.mk (𝟙 _))))
    (hH : ∀ a : SimpleRoot i ν, centralizerPoints i ⊓ Subgroup.closure
      (((RelativeRoot.subgroup i a.val).carrier (Over.mk (𝟙 _)) :
        Set (rationalPoints G)) ∪
          (RelativeRoot.subgroup i (-a.val)).carrier (Over.mk (𝟙 _))) ≤ H)
    (hMgen : M ≤ Subgroup.closure
      ((H : Set (rationalPoints G)) ∪ Set.range (fun a => (m a).val))) :
    HasRootGeneratedBruhatCovering i ν M := by
  have hW : Function.Surjective (subgroupRelativeWeylMap i M) := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← cs.subgroup_closure_range_simple]
    apply (Subgroup.closure_le _).2
    rintro _ ⟨a, rfl⟩
    exact ⟨⟨m a, hmM a⟩, hmclass a⟩
  have hgen : Subgroup.closure (⋃ a ∈ relativeRoots i,
      ((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G))) ≤
        Subgroup.closure (rootGeneratedBruhatGenerators i ν H m) := by
    apply (RelativeRoot.rootGenerated_le_closure_unipotent_union_of_weylSurjective
      i ν hT hroot hν M hW).trans
    apply (Subgroup.closure_le _).2
    intro x hx
    rcases hx with hx | hx
    · exact Subgroup.subset_closure (Or.inl (Or.inl hx))
    · exact hMgen.trans (Subgroup.closure_mono (fun _ hx =>
        hx.elim (fun h => Or.inl (Or.inr h)) Or.inr)) hx
  refine Langlands.Group.RankOneBruhat.subgroup_subset_doubleCosets H hHM
    (fun h hh u hu => centralizerPoints_conj_mem_dynamicUnipotent i ν (hHZ hh) hu)
    (Set.range (fun a => (m a).val)) ?_ ?_ _ hgen
  · rintro _ ⟨a, rfl⟩ g hg
    exact mul_mem_rootGenerated_doubleCosets_of_reflectionLift i ν
      hT hroot hν hfac hE M hMN a.property (m a) (hmref a) (hmM a) (hmL a)
      ((hH a).trans hHM) hg
  · rintro _ ⟨a, rfl⟩
    have hsqZ : (m a) ^ 2 ∈
        (centralizerPoints i).subgroupOf (normalizerPoints i) := by
      apply (QuotientGroup.eq_one_iff ((m a) ^ 2)).1
      simpa only [pow_two, QuotientGroup.mk_mul] using
        hroot.mul_self_of_isRelativeReflection (hmref a)
    have hsqH : (m a).val ^ 2 ∈ H :=
      hH a ⟨hsqZ, (Subgroup.closure _).pow_mem (hmL a) 2⟩
    refine ⟨((m a).val ^ 2)⁻¹, H.inv_mem hsqH, ?_⟩
    group

end Langlands.GroupScheme
