import Langlands.GroupScheme.Rational.RootGeneratedSubgroup
import Langlands.GroupScheme.Rational.RootGeneratedWeylRepresentatives
import Langlands.GroupScheme.Rational.RootRankOneFactorizationProof
import Langlands.GroupScheme.Rational.RelativeRootSystemProof
import Langlands.GroupScheme.Rational.RationalBruhatProof
import Langlands.GroupScheme.Rational.GenericCentralizerProof
import Langlands.GroupScheme.Rational.GenericCocharacter

/-!
# Rational points as root-generated points times centralizer points

For a connected reductive group `G` over any field `k` and a maximal split torus `S`,
`G(k) = G(k)^+ · Z_G(S)(k)`, where `G(k)^+` is the subgroup generated by the rational
points of the relative root groups. Consequently `G(k)^+ = G(k)` as soon as
`Z_G(S)(k) ⊆ G(k)^+`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- For every connected reductive group `G` over a field and every maximal split torus `i`,
the root-generated subgroup and the centralizer points generate all rational points. -/
def RootGeneratedCentralizerCoveringStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom G.X.hom], IsConnectedReductive G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
      relativeRootGeneratedSubgroup i ⊔ centralizerPoints i = ⊤

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {i : S.toGrp ⟶ G}

/-- Every rational point is a product `h * z` of a point `h` of the root-generated subgroup
and a point `z` of the centralizer of the maximal split torus. -/
theorem exists_relativeRootGenerated_mul_centralizer (hG : IsConnectedReductive G)
    (hi : IsMaximalSplitTorus i) (g : rationalPoints G) :
    ∃ h ∈ relativeRootGeneratedSubgroup i, ∃ z ∈ centralizerPoints i, g = h * z := by
  have : Smooth G.X.hom := hG.smooth
  have : Mono i.hom.hom.left := hi.isSplitSubtorus.mono
  have hT : IsSplitTorus S.toGrp := hi.isSplitSubtorus.1
  obtain ⟨ν, hν⟩ := hT.exists_genericCocharacter i
  have hZ := genericCentralizer k G hG S i hi ν hν
  have hBr := rationalBruhat k G hG S i hi ν hν
  have hrank : RelativeRoot.HasRankOneFactorization i :=
    rootRankOneFactorization.{u} k G hG S i hi
  have hpair : RelativeRoot.HasOppositeFactorPairs i :=
    fun a ha x hx hx1 => (hrank a ha x hx hx1).1.exists
  have hroot : HasRelativeRootSystem i := relativeRootSystem k G hG S i hi
  have hU : RationalPoint.unipotent (CommGroupScheme.groupHom ν ≫ i) ≤
      relativeRootGeneratedSubgroup i := by
    apply dynamicUnipotent_le_relativeRootGeneratedSubgroup i hG hi ν
    intro a ha b hb hne
    exact hpair.disjoint_cyclicTail_indivisibleRoots i hT ha.1 hb.1 hne
  have hW := (subgroupRelativeWeylMap_surjective_iff i (relativeRootGeneratedSubgroup i)).mp
    (RelativeRoot.subgroupRelativeWeylMap_surjective_of_oppositeFactorPairs i hT hpair hroot
      (relativeRootGeneratedSubgroup i)
      (fun a ha => relativeRoot_subgroup_le_generated i ha))
  obtain ⟨a, b, n, z, hg⟩ := exists_unipotent_normalizer_unipotent_centralizer_mul i ν hZ hBr g
  obtain ⟨h, hh, z', hz', hn⟩ := hW n
  -- `g = a * (h * z') * b * z = (a * h * (z' * b * z'⁻¹)) * (z' * z)`.
  refine ⟨(a : rationalPoints G) * h * (z' * b * z'⁻¹), ?_, z' * z,
    (centralizerPoints i).mul_mem hz' z.property, ?_⟩
  · refine (relativeRootGeneratedSubgroup i).mul_mem
      ((relativeRootGeneratedSubgroup i).mul_mem (hU a.property) hh) ?_
    exact hU (centralizerPoints_conj_mem_dynamicUnipotent i ν hz' b.property)
  · rw [hg, hn]
    group

/-- The root-generated subgroup and the centralizer points generate `G(k)`. -/
theorem relativeRootGeneratedSubgroup_sup_centralizerPoints (hG : IsConnectedReductive G)
    (hi : IsMaximalSplitTorus i) :
    relativeRootGeneratedSubgroup i ⊔ centralizerPoints i = ⊤ := by
  refine top_unique fun g _ => ?_
  obtain ⟨h, hh, z, hz, rfl⟩ := exists_relativeRootGenerated_mul_centralizer hG hi g
  exact Subgroup.mul_mem_sup hh hz

/-- If the centralizer points lie in the root-generated subgroup, then the root-generated
subgroup is all of `G(k)`. -/
theorem relativeRootGeneratedSubgroup_eq_top_of_centralizerPoints_le
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hZ : centralizerPoints i ≤ relativeRootGeneratedSubgroup i) :
    relativeRootGeneratedSubgroup i = ⊤ := by
  rw [← relativeRootGeneratedSubgroup_sup_centralizerPoints hG hi, sup_eq_left.mpr hZ]

/-- Proof of `RootGeneratedCentralizerCoveringStatement`. -/
theorem rootGeneratedCentralizerCovering : RootGeneratedCentralizerCoveringStatement.{u} :=
  fun _ _ _ _ hG _ _ hi => relativeRootGeneratedSubgroup_sup_centralizerPoints hG hi

end Langlands.GroupScheme
