import Langlands.GroupScheme.Rational.MaximalSplitSubgroupBaseChange
import Langlands.GroupScheme.Rational.MaximalSplitSubgroupRootTransport
import Langlands.GroupScheme.Rational.MaximalSplitNonmultipliableBase
import Langlands.GroupScheme.Rational.MaximalSplitGeneratedReductive
import Langlands.GroupScheme.Rational.MaximalSplitSubgroupStatement
import Langlands.GroupScheme.Rational.RelativeRootNegationProof
import Langlands.GroupScheme.Rational.LeviFactorization
import Langlands.GroupScheme.Rational.NormalizerGaloisAction
import Langlands.GroupScheme.Torus.RootSupportBaseChange
import Langlands.GroupScheme.Torus.MaximalBaseChangeReflection
import Langlands.GroupScheme.Torus.MaximalSelfCentralizing
import Langlands.GroupScheme.Reductive.SemisimpleFieldReflectionProof
import Langlands.GroupScheme.SubgroupBaseChange
import Langlands.GroupScheme.Lie.Functoriality
import Langlands.GroupScheme.Absolute.CocharacterDescentLattice

/-! # Proof of Borel–Tits 7.2: the split reductive subgroup with the nonmultipliable roots

Over `k`, the subgroup `F` of `G` generated by the maximal split torus `S` and rank-one line
pairs at a base `D` of the nonmultipliable relative roots is built in
`MaximalSplitSubgroupGenerated`. After base change to an algebraically closed extension `K`,
`MaximalSplitGeneratedReductive` shows that `F_K` is connected reductive with root set the base
change of the nonmultipliable roots, and `MaximalSplitGeneratedCell` shows that `S_K` is its own
torus centralizer in `F_K`. Descent along `K / k` gives the statement over `k`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false

namespace Langlands.GroupScheme.MaximalSplitSubgroup

open VectorGroup RootCell

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {S : CommGroupScheme (Spec (CommRingCat.of k))}

/-- **Borel–Tits 7.2 over `k`, checked over an algebraically closed extension `K`.** For a
maximal split torus `i : S ⟶ G` of a connected reductive group, there is a closed connected
reductive subgroup `j : F ⟶ G` through `S` (`f ≫ j = i`) with `f` a maximal torus of `F` and
`roots f` the nonmultipliable roots of `i`. -/
theorem exists_maximalSplitSubgroup (K : Type u) [Field K] [IsAlgClosed K]
    [Algebra k K]
    (hG : IsConnectedReductive G) (i : S.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) :
    ∃ (F : GroupScheme (Spec (CommRingCat.of k))) (hF : IsConnectedReductive F)
      (j : F ⟶ G) (f : S.toGrp ⟶ F),
      IsClosedSubgroup j ∧ f ≫ j = i ∧ IsMaximalTorus f ∧
        (haveI := hG.isAffineHom
         haveI := hF.isAffineHom
         roots f = {a | a ∈ roots i ∧ (2 : ℤ) • a ∉ roots i}) := by
  have := hG.isAffineHom
  have := hG.smooth
  have hT : IsSplitTorus S.toGrp := hi.1.1
  obtain ⟨D, lam, hD1, hD2, hD3, hD4, hD5, hD6, -, hD8⟩ := exists_nonmultipliableBase hG i hi
  obtain ⟨F, j, f, x, y, ν, hpair, n, hFs, hFa, hFc, hj, hfj, hgen, hx, hy, hxm, hrel, hn,
    hcomm, hrefl⟩ := exists_generated_lineSubgroup hG i hi (Idx := ↥D) (fun d => d.1)
      (fun d => hD1 d.1 d.2) (fun d e hde => hD4 d.1 d.2 e.1 e.2 (fun h => hde (Subtype.ext h)))
  have : Smooth F.X.hom := hFs
  have : IsAffineHom F.X.hom := hFa
  have : ConnectedSpace F.X.left := hFc
  have : IsClosedImmersion j.hom.hom.left := hj
  have : Mono j.hom.hom := Over.mono_of_mono_left _
  have hfcl : IsClosedSubgroup f := IsClosedSubgroup.of_comp hj (by rw [hfj]; exact hi.1.2)
  have hR' : roots f ⊆ roots i := by
    have h := roots_subset_comp j f
    rwa [hfj] at h
  have hneg : ∀ c ∈ roots i, -c ∈ roots i := relativeRootNegation k G hG S i hi
  let νD : ∀ d ∈ D, cocharacterLattice S := fun d hd => ν ⟨d, hd⟩
  have hrefl8 := hD8 νD (fun d hd => ⟨hpair ⟨d, hd⟩, fun c hc => hrefl ⟨d, hd⟩ c hc⟩)
  obtain ⟨hKs, hKa, hKc⟩ := baseChange_smooth_affine_connected (K := K) ⟨hFs, hFa, hFc⟩
  have hTK : IsSplitTorus
      ((CommGroupScheme.baseChange (algebraBaseMap k K)).obj S).toGrp :=
    hT.baseChange (algebraBaseMap k K)
  have ht : IsClosedSubgroup ((GroupScheme.baseChange (algebraBaseMap k K)).map f) :=
    IsClosedSubgroup.baseChange (algebraBaseMap k K) hfcl
  obtain ⟨hposK, hgenK, hetaK, hpairK, hsubK, hredK, hclosK⟩ :=
    baseChange_rootData (K := K) hT (roots i) (roots f) hR' hneg D lam νD hD2 hD3 hD5 hD6
      (fun d hd => hpair ⟨d, hd⟩) hrefl8 (nonmultipliable_eq_or_eq_neg hG i hi)
  have hrootsK : roots ((GroupScheme.baseChange (algebraBaseMap k K)).map f) =
      characterLattice.baseChange (algebraBaseMap k K) S '' roots f :=
    roots_baseChange F S hT f
  have hden := dense_baseChange_lineFamily (K := K) hT f x y hgen
  have hxK : ∀ d, IsTorusEquivariant ((GroupScheme.baseChange (algebraBaseMap k K)).map f)
      (lineBaseChange K (x d)) (characterLattice.baseChange (algebraBaseMap k K) S d.1) :=
    fun d => isTorusEquivariant_lineBaseChange (hx d)
  have hyK : ∀ d, IsTorusEquivariant ((GroupScheme.baseChange (algebraBaseMap k K)).map f)
      (lineBaseChange K (y d)) (-characterLattice.baseChange (algebraBaseMap k K) S d.1) := by
    intro d
    have h := isTorusEquivariant_lineBaseChange (K := K) (hy d)
    rwa [map_neg] at h
  have hrelK : ∀ d, RelationOver ((GroupScheme.baseChange (algebraBaseMap k K)).map f)
      (cocharacterLattice.baseChange (algebraBaseMap k K) S (ν d))
      (lineBaseChange K (x d)) (lineBaseChange K (y d))
      (Over.mk (𝟙 (Spec (CommRingCat.of K)))) :=
    fun d => relationOver_lineBaseChange (hrel d) _
  have hcommK : ∀ d e, d ≠ e → ∀ g ∈ rangePts (lineBaseChange K (x d)),
      ∀ h ∈ rangePts (lineBaseChange K (y e)), Commute g h :=
    fun d e hde g hg h hh => commute_lineBaseChange (fun Z c c' => hcomm d e hde Z _ _) hg hh
  have hmonoK : ∀ d, Mono (lineBaseChange K (x d)).hom.hom := by
    intro d
    have := hxm d
    exact mono_lineBaseChange (x d)
  have hnK := fun d : D => IsNormalizingPoint.baseChange_latticeReflection (K := K) f d.1 (ν d)
    (hpair d) (hn d)
  have hgenericK : ∀ χ ∈ roots ((GroupScheme.baseChange (algebraBaseMap k K)).map f),
      latticePairing _ χ (cocharacterLattice.baseChange (algebraBaseMap k K) S lam) ≠ 0 := by
    rw [hrootsK]
    exact hgenK
  have hsubK' : ∀ χ ∈ roots ((GroupScheme.baseChange (algebraBaseMap k K)).map f),
      χ ∈ cone (fun d : D => characterLattice.baseChange (algebraBaseMap k K) S d.1) ∨
        -χ ∈ cone (fun d : D => characterLattice.baseChange (algebraBaseMap k K) S d.1) →
      χ ∈ nonmultipliableBaseChange K (roots i) := by
    rw [hrootsK]
    exact hsubK
  obtain ⟨hFK, hrootsΦ⟩ := isConnectedReductive_and_roots_eq_of_generated hTK
    ((GroupScheme.baseChange (algebraBaseMap k K)).map f)
    (fun d : D => characterLattice.baseChange (algebraBaseMap k K) S d.1)
    (fun d : D => cocharacterLattice.baseChange (algebraBaseMap k K) S (ν d))
    (fun d => lineBaseChange K (x d)) (fun d => lineBaseChange K (y d)) hxK hyK hrelK hcommK
    hden (cocharacterLattice.baseChange (algebraBaseMap k K) S lam) hposK ht hmonoK hetaK hpairK
    (fun d => ⟨_, hnK d⟩) hgenericK _ hsubK' hredK hclosK
  have hcent := torusCentralizer_eq_range_of_generated
    ((GroupScheme.baseChange (algebraBaseMap k K)).map f)
    (fun d : D => characterLattice.baseChange (algebraBaseMap k K) S d.1)
    (fun d : D => cocharacterLattice.baseChange (algebraBaseMap k K) S (ν d))
    (fun d => lineBaseChange K (x d)) (fun d => lineBaseChange K (y d)) hxK hyK hrelK hcommK
    hden (cocharacterLattice.baseChange (algebraBaseMap k K) S lam) hposK ht
  have hF : IsConnectedReductive F := IsConnectedReductive.of_fieldExtension (K := K) hFK
  refine ⟨F, hF, j, f, hj, hfj,
    IsMaximalTorus.of_baseChange (K := K) hfcl
      (isMaximalTorus_of_torusCentralizer_eq hTK.isTorus ht hcent), ?_⟩
  show roots f = {a | a ∈ roots i ∧ (2 : ℤ) • a ∉ roots i}
  apply Set.image_injective.mpr (hT.characterLattice_baseChange_bijective
    (algebraBaseMap k K) S).injective
  rw [← hrootsK, hrootsΦ, nonmultipliableBaseChange]

end Langlands.GroupScheme.MaximalSplitSubgroup

namespace Langlands.GroupScheme

/-- **Borel–Tits (1965), Théorème 7.2, existence part.** Proved with `K` the algebraic
closure of `k`. -/
theorem maximalSplitSubgroup : MaximalSplitSubgroupStatement.{u} :=
  fun k _ _ hG _ i hi =>
    MaximalSplitSubgroup.exists_maximalSplitSubgroup (AlgebraicClosure k) hG i hi

end Langlands.GroupScheme
