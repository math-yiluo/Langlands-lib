/-! # Relative root groups generated by absolute root groups: proof -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace RelativeRoot

section OverBase

variable {B : Scheme.{u}} {S T : CommGroupScheme B} {G : GroupScheme B}

/-- Pulling the full torus orbit back along a homomorphism of commutative groups gives the
orbit of the restricted torus. -/
theorem orbit_comp_torusHom (f : S ⟶ T) (j : T.toGrp ⟶ G) {U : Over B} (g : U ⟶ G.X) :
    U ◁ (CommGroupScheme.groupHom f).hom.hom ≫ orbit j g =
      orbit (CommGroupScheme.groupHom f ≫ j) g := by
  simp only [orbit, AutomorphicAction.conjugation_act, MonObj.comp_mul,
    GrpObj.comp_inv, whiskerLeft_snd_assoc, whiskerLeft_fst_assoc, Grp.comp_hom_hom]

/-- The root functor of a character of the larger torus lies in the root functor of its
restriction, over an arbitrary base and on every test scheme. -/
theorem subgroup_le_subgroup_comp_torusHom (f : S ⟶ T) (j : T.toGrp ⟶ G)
    (β : characterLattice T) :
    subgroup j β ≤ subgroup (CommGroupScheme.groupHom f ≫ j) (f ≫ β) := by
  intro U g hg
  obtain ⟨e, he, he0⟩ := hg
  refine ⟨e, ?_, he0⟩
  rw [IsOrbitExtension]
  calc
    U ◁ ((CommGroupScheme.groupHom (f ≫ β)).hom.hom ≫ AffineLine.unitInclusion B) ≫ e =
        U ◁ (CommGroupScheme.groupHom f).hom.hom ≫
          (U ◁ ((CommGroupScheme.groupHom β).hom.hom ≫ AffineLine.unitInclusion B) ≫ e) := by
      rw [← Category.assoc, ← whiskerLeft_comp]
      rfl
    _ = U ◁ (CommGroupScheme.groupHom f).hom.hom ≫ orbit j g := by rw [he]
    _ = orbit (CommGroupScheme.groupHom f ≫ j) g := orbit_comp_torusHom f j g

/-- If the restriction of `β` is a positive multiple of `a`, the root functor of `β` lies in
the root functor of `a` for the restricted torus. -/
theorem subgroup_le_subgroup_comp_torusHom_of_nsmul (f : S ⟶ T) (j : T.toGrp ⟶ G)
    {β : characterLattice T} {a : characterLattice S} {n : ℕ} (hn : 0 < n)
    (hβ : f ≫ β = n • a) :
    subgroup j β ≤ subgroup (CommGroupScheme.groupHom f ≫ j) a := by
  refine (subgroup_le_subgroup_comp_torusHom f j β).trans ?_
  rw [hβ]
  exact subgroup_nsmul_le _ a hn

end OverBase

section Range

variable {B : Scheme.{u}} {G A H : GroupScheme B}

private theorem factorsThrough_of_range_le (a : A ⟶ G) (q : H ⟶ G)
    (h : SubgroupFunctor.range a ≤ SubgroupFunctor.range q) : FactorsThrough a.hom.hom q :=
  (factorsThrough_iff_containsImage _ _).mpr
    ((SubgroupFunctor.containsImage_iff _ _).mpr
      (h _ (SubgroupFunctor.mem_range.mpr ⟨𝟙 _, Category.id_comp _⟩)))

private theorem range_le_of_factorsThrough (a : A ⟶ G) (q : H ⟶ G)
    (h : FactorsThrough a.hom.hom q) :
    SubgroupFunctor.range a ≤ SubgroupFunctor.range q := by
  obtain ⟨g, hg⟩ := h
  intro T x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  exact SubgroupFunctor.mem_range.mpr ⟨y ≫ g, by rw [Category.assoc, hg]⟩

end Range

section Field

variable {F : Type u} [Field F]
    {S T : CommGroupScheme (Spec (CommRingCat.of F))}
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] [Smooth G.X.hom]

private theorem nsmul_ne_zero_of_isSplitTorus (hS : IsSplitTorus S.toGrp)
    {a : characterLattice S} (ha : a ≠ 0) {n : ℕ} (hn : 0 < n) : n • a ≠ 0 := by
  obtain ⟨I, hI, ⟨e⟩⟩ := hS
  have := hI
  intro h
  apply ha
  apply (splitTorusCharacterCoordinates e).injective
  have h' := congrArg (splitTorusCharacterCoordinates e) h
  rw [map_nsmul, map_zero] at h'
  rw [map_zero]
  funext x
  have hx := congrFun h' x
  simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at hx ⊢
  rcases mul_eq_zero.mp hx with h0 | h0
  · exact absurd h0 (by exact_mod_cast hn.ne')
  · exact h0

set_option backward.isDefEq.respectTransparency false in
/-- Over a field, with both tori split, every closed subgroup containing the root subgroups
of all roots restricting to positive multiples of `a` contains the root subgroup of `a` for
the restricted torus. -/
theorem subgroup_comp_torusHom_le_range_of_roots
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (f : S ⟶ T) (j : T.toGrp ⟶ G) {a : characterLattice S} (ha : a ≠ 0)
    {H : GroupScheme (Spec (CommRingCat.of F))} (h : H ⟶ G) (hh : IsClosedSubgroup h)
    (hroots : ∀ β ∈ roots j, (∃ n : ℕ, 0 < n ∧ f ≫ β = n • a) →
      subgroup j β ≤ SubgroupFunctor.range h) :
    subgroup (CommGroupScheme.groupHom f ≫ j) a ≤ SubgroupFunctor.range h := by
  classical
  let J := {β : characterLattice T // β ∈ roots j ∧ ∃ n : ℕ, 0 < n ∧ f ≫ β = n • a}
  have hJ : ∀ β : J, ∃ (C : GroupScheme (Spec (CommRingCat.of F))) (incl : C ⟶ G),
      (subgroup j β.1).IsRepresentedBy incl ∧ IsClosedSubgroup incl ∧ Smooth C.X.hom ∧
        ConnectedSpace C.X.left := fun β =>
    subgroup_isSmoothConnectedClosed_of_ne_zero hT j β.1 β.2.1.1
  choose C incl hincl hinclc hCs hCc using hJ
  have hCa : ∀ β, IsAffineHom (C β).X.hom := fun β => by
    have : IsClosedImmersion (incl β).hom.hom.left := hinclc β
    rw [← (incl β).hom.hom.w]
    infer_instance
  obtain ⟨D, d, hDs, -, hDc, hgen⟩ :=
    FiniteGeneration.exists_smooth_generated_family (A := C) (a := incl) fun β =>
      ⟨hCs β, hCa β, hCc β⟩
  have hU := subgroup_isSmoothConnectedClosed_of_ne_zero hS (CommGroupScheme.groupHom f ≫ j) a ha
  obtain ⟨HU, inclU, hinclU, hinclUc, -, -⟩ := hU
  have hβU : ∀ β : J, subgroup j β.1 ≤ subgroup (CommGroupScheme.groupHom f ≫ j) a :=
    fun β => by
      obtain ⟨n, hn, hβ⟩ := β.2.2
      exact subgroup_le_subgroup_comp_torusHom_of_nsmul f j hn hβ
  have hdU : SubgroupFunctor.range d ≤ subgroup (CommGroupScheme.groupHom f ≫ j) a := by
    rw [← hinclU.2]
    exact hgen.2.2 HU inclU hinclUc fun β =>
      factorsThrough_of_range_le (incl β) inclU (by rw [(hincl β).2, hinclU.2]; exact hβU β)
  have hβd : ∀ β : J, subgroup j β.1 ≤ SubgroupFunctor.range d := fun β => by
    rw [← (hincl β).2]
    exact range_le_of_factorsThrough (incl β) d (hgen.2.1 β)
  have hLieU : tangentSubmodule (subgroup (CommGroupScheme.groupHom f ≫ j) a) =
      semigroupWeightSpan (AutomorphicAction.conjugation j)
        (characterSemigroupPreimage f (cyclicTail a 1)) :=
    (tangentSubmodule_subgroup _ a hS ha).trans (semigroupWeightSpan_comp_torusHom hS hT f j _)
  have hLied : tangentSubmodule (SubgroupFunctor.range d) =
      semigroupWeightSpan (AutomorphicAction.conjugation j)
        (characterSemigroupPreimage f (cyclicTail a 1)) := by
    apply le_antisymm
    · exact (tangentSubmodule_mono hdU).trans hLieU.le
    · refine iSup_le fun χ => ?_
      rw [actionWeightSpace_conjugation]
      by_cases hχ : weightSpace j χ.1 = ⊥
      · rw [hχ]
        exact bot_le
      obtain ⟨n, -, hn, hnχ⟩ := χ.2
      have hχ0 : χ.1 ≠ 0 := by
        intro h0
        apply nsmul_ne_zero_of_isSplitTorus hS ha hn
        rw [hnχ, h0]
        exact (characterLattice.comapHom (CommGroupScheme.groupHom f)).map_zero
      let β : J := ⟨χ.1, ⟨hχ0, hχ⟩, n, hn, hnχ.symm⟩
      calc
        weightSpace j χ.1 = actionWeightSpace (AutomorphicAction.conjugation j) χ.1 :=
          (actionWeightSpace_conjugation j χ.1).symm
        _ ≤ semigroupWeightSpan (AutomorphicAction.conjugation j) (cyclicTail χ.1 1) :=
          le_iSup (fun ψ : cyclicTail χ.1 1 =>
              actionWeightSpace (AutomorphicAction.conjugation j) ψ.val)
            ⟨χ.1, 1, le_rfl, Nat.one_pos, one_nsmul _⟩
        _ = tangentSubmodule (subgroup j χ.1) := (tangentSubmodule_subgroup j χ.1 hT hχ0).symm
        _ ≤ tangentSubmodule (SubgroupFunctor.range d) := tangentSubmodule_mono (hβd β)
  have hdsc : IsSmoothConnectedClosed (SubgroupFunctor.range d) := by
    have : IsClosedImmersion d.hom.hom.left := hgen.1
    exact ⟨D, d, ⟨Over.mono_of_mono_left _, rfl⟩, hgen.1, hDs, hDc⟩
  have heq : SubgroupFunctor.range d = subgroup (CommGroupScheme.groupHom f ≫ j) a :=
    IsSmoothConnectedClosed.eq_of_le_of_hasLieImage hdsc
      (subgroup_isSmoothConnectedClosed_of_ne_zero hS (CommGroupScheme.groupHom f ≫ j) a ha)
      hdU ((hasLieImage_iff_tangentSubmodule_eq _ _).mpr hLied)
      ((hasLieImage_iff_tangentSubmodule_eq _ _).mpr hLieU)
  rw [← heq]
  exact hgen.2.2 H h hh fun β =>
    factorsThrough_of_range_le (incl β) h (by
      rw [(hincl β).2]
      obtain ⟨n, hn, hβ⟩ := β.2.2
      exact hroots β.1 β.2.1 ⟨n, hn, hβ⟩)

end Field

end RelativeRoot

set_option backward.isDefEq.respectTransparency false in
/-- The base change of the relative root group `U_(a)` is the smallest closed subgroup
containing the absolute root groups `U_β` with `β|_S` a positive multiple of `a`
(Borel–Tits, *Groupes réductifs* (1965), 3.8 (ii), 3.13 and 5.2). -/
theorem relativeRootGroupAbsoluteGeneration :
    RelativeRootGroupAbsoluteGenerationStatement.{u} := by
  intro k K _ _ _ G hG S i hi T j f _hj hf hTK
  have := hG.isAffineHom
  have := hG.smooth
  have : Smooth ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom := by
    change Smooth (pullback.snd G.X.hom _)
    infer_instance
  intro a ha
  have hS : IsSplitTorus S.toGrp := hi.1.1
  have hSK : IsSplitTorus ((CommGroupScheme.baseChange (algebraBaseMap k K)).obj S).toGrp :=
    hS.baseChange (algebraBaseMap k K)
  have haK : characterLattice.baseChange (algebraBaseMap k K) S a ≠ 0 :=
    (characterLattice.baseChangeEquiv (algebraBaseMap k K) S hS).map_ne_zero_iff.mpr ha.1
  have hiK : (GroupScheme.baseChange (algebraBaseMap k K)).map i =
      CommGroupScheme.groupHom ((CommGroupScheme.baseChange (algebraBaseMap k K)).map f) ≫
        (GroupScheme.baseChange (algebraBaseMap k K)).map j := by
    rw [← hf, Functor.map_comp]
    rfl
  have hU : (RelativeRoot.subgroup i a).baseChange (algebraBaseMap k K) =
      RelativeRoot.subgroup
        (CommGroupScheme.groupHom ((CommGroupScheme.baseChange (algebraBaseMap k K)).map f) ≫
          (GroupScheme.baseChange (algebraBaseMap k K)).map j)
        (characterLattice.baseChange (algebraBaseMap k K) S a) := by
    rw [← hiK]
    exact (RelativeRoot.subgroup_baseChange (algebraBaseMap k K) i a).symm
  rw [hU]
  refine ⟨fun β _ ⟨n, hn, hβ⟩ =>
    RelativeRoot.subgroup_le_subgroup_comp_torusHom_of_nsmul _ _ hn hβ, ?_⟩
  intro H h hh hroots
  exact RelativeRoot.subgroup_comp_torusHom_le_range_of_roots hSK hTK _ _ haK h hh hroots

end Langlands.GroupScheme
