import Langlands.GroupScheme.Rational.ClosedRootSubsetStatements
import Langlands.GroupScheme.GeneratedFamily
import Langlands.GroupScheme.Cartan.Induction
import Langlands.GroupScheme.Rational.CyclicRootFunctorComparisonProof
import Langlands.GroupScheme.Rational.RootSubgroupPositive
import Langlands.GroupScheme.Rational.WeylPositiveCocharacter
import Langlands.GroupScheme.Rational.LeviFactorization
import Langlands.GroupScheme.Torus.CentralizerSmooth
import Langlands.GroupScheme.Torus.CentralizerConnected
import Langlands.GroupScheme.Dynamic.UnipotentUnipotenceProof
import Langlands.GroupScheme.UnipotentClosedSubgroupProof

/-! # Existence and unipotence of the groups generated by root subsets -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

private theorem exists_smooth_generated_functors
    {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    {I : Type u} (F : I → SubgroupFunctor G)
    (hF : ∀ a, RelativeRoot.IsSmoothConnectedClosed (F a)) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
      IsClosedSubgroup h ∧
      (∀ a, F a ≤ SubgroupFunctor.range h) ∧
      (∀ (K : GroupScheme (Spec (CommRingCat.of k))) (q : K ⟶ G),
        IsClosedSubgroup q → (∀ a, F a ≤ SubgroupFunctor.range q) →
          SubgroupFunctor.range h ≤ SubgroupFunctor.range q) ∧
      Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left := by
  classical
  choose A a ha hac has haconn using hF
  obtain ⟨H, h, hs, haff, hconn, hh⟩ :=
    FiniteGeneration.exists_smooth_generated_family (A := A) (a := a)
      (fun j => ⟨has j, (hac j).isAffineHom, haconn j⟩)
  refine ⟨H, h, hh.1, ?_, ?_, hs, haff, hconn⟩
  · intro j
    rw [← (ha j).2]
    exact (factorsThrough_hom_iff_range_le (a j) h).mp (hh.2.1 j)
  · intro K q hq hFq
    apply hh.2.2 K q hq
    intro j
    apply (factorsThrough_hom_iff_range_le (a j) q).mpr
    rw [(ha j).2]
    exact hFq j

/-- The exact Renard V.4.2 existence target, including unipotence of every
closed representative generated by a unipotent root subset. -/
theorem rootSubsetGroupExistence : RootSubsetGroupExistenceStatement.{u} := by
  intro k _ G hG T i hi
  let : IsAffineHom G.X.hom := hG.isAffineHom
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  let : Smooth G.X.hom := hG.smooth
  let : ConnectedSpace G.X.left := hG.connectedSpace
  let : Mono i.hom.hom.left := hi.isSplitSubtorus.mono
  have hT : IsSplitTorus T.toGrp := hi.isSplitSubtorus.1
  constructor
  · intro X hX
    have hroot : ∀ a : X, RelativeRoot.IsSmoothConnectedClosed
        (RelativeRoot.subgroup i a.val) := by
      intro a
      exact RelativeRoot.subgroup_isSmoothConnectedClosed_of_ne_zero hT i a.val
        (mem_relativeRoots.mp (hX a.property)).1
    constructor
    · obtain ⟨Z, z, hzc, hzs, hz⟩ :=
        torusCentralizer_hasSmoothClosedRepresentative i hi.isSplitSubtorus hG.smooth
      have hzconn : ConnectedSpace Z.X.left := hT.connectedSpace_centralizer i hz
      let F : Option X → SubgroupFunctor G := fun a =>
        match a with
        | none => torusCentralizer i
        | some a => RelativeRoot.subgroup i a.val
      have hF : ∀ a, RelativeRoot.IsSmoothConnectedClosed (F a) := by
        intro a
        cases a with
        | none => exact ⟨Z, z, hz, hzc, hzs, hzconn⟩
        | some a => exact hroot a
      obtain ⟨H, h, hc, hall, hmin, hs, haff, hconn⟩ :=
        exists_smooth_generated_functors F hF
      refine ⟨H, h, ⟨hc, hall none, ?_, ?_⟩, hs, haff, hconn⟩
      · intro a ha
        exact hall (some ⟨a, ha⟩)
      · intro K q hq hcent hroots
        apply hmin K q hq
        intro a
        cases a with
        | none => exact hcent
        | some a => exact hroots a.val a.property
    · obtain ⟨H, h, hc, hall, hmin, hs, haff, hconn⟩ :=
        exists_smooth_generated_functors (fun a : X => RelativeRoot.subgroup i a.val) hroot
      refine ⟨H, h, ⟨hc, ?_, ?_⟩, hs, haff, hconn⟩
      · intro a ha
        exact hall ⟨a, ha⟩
      · intro K q hq hroots
        exact hmin K q hq (fun a => hroots a.val a.property)
  · intro R _ ν _ X hX H h hh
    obtain ⟨w, hw⟩ := hX.2
    let ζ := relativeWeylCocharacterAction i w ν
    have hpos : ∀ a ∈ X, 0 < latticePairing T a ζ := by
      intro a ha
      obtain ⟨b, hb, rfl⟩ := hw ha
      exact (latticePairing_relativeWeyl i w b ν).symm ▸ hb.2
    let χ := CommGroupScheme.groupHom ζ ≫ i
    let U := Dynamic.Affine.unipotentScheme χ
    let j : U ⟶ G := Dynamic.Affine.unipotentHom χ
    have hj : (Dynamic.unipotent χ).IsRepresentedBy j :=
      Dynamic.Affine.isRepresentedBy_unipotentHom χ
    have hjc : IsClosedSubgroup j := Dynamic.Affine.isClosedSubgroup_unipotentHom χ
    let : IsAffineHom U.X.hom := hjc.isAffineHom
    let : Smooth U.X.hom := (dynamicSmooth k G χ U j).2.2 hj
    have hle : SubgroupFunctor.range h ≤ SubgroupFunctor.range j := by
      apply hh.2.2 U j hjc
      intro a ha
      rw [hj.2]
      exact RelativeRoot.subgroup_le_dynamicUnipotent i ζ (hpos a ha)
    have hle' : SubgroupFunctor.range h ≤ Dynamic.unipotent χ := by
      rw [← hj.2]
      exact hle
    let f : H ⟶ U := hj.factorHom h hle'
    have hf : f ≫ j = h := hj.factorHom_comp h hle'
    have hfc : IsClosedSubgroup f :=
      IsClosedSubgroup.of_comp hjc (by rw [hf]; exact hh.1)
    exact unipotentClosedSubgroup k U H f hfc
      (dynamicUnipotentUnipotence k G χ U j hj)

end Langlands.GroupScheme
