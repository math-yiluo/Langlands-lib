import Langlands.GroupScheme.Rational.RootGeneratedBruhatAssembly
import Langlands.GroupScheme.Rational.RootGeneratedCoxeterKernel

/-! # Covering and kernel assembly for the root-generated centralizer -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.Aubert.General.RationalPointFamily

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G) [IsAffineHom G.X.hom]

namespace RelativeRoot

/-- The rank-one centralizer subgroup is contained in every subgroup
generated by it and a family of normalizer lifts. -/
theorem rankOneCentralizerGeneratedPoints_le_rankOneLiftPoints
    {B : Type v} (m : B → normalizerPoints i) :
    rankOneCentralizerGeneratedPoints i ≤ rankOneLiftPoints i m := by
  intro z hz
  refine ⟨⟨z, centralizerPoints_le_normalizerPoints i
    (rankOneCentralizerGeneratedPoints_le_centralizer i hz)⟩, ?_, rfl⟩
  change _ ∈ rankOneCentralizerNormalizerPoints i ⊔ Subgroup.closure (Set.range m)
  exact Subgroup.mem_sup_left hz

/-- Mapping the generated subgroup of the normalizer into all rational
points preserves its normalizer containment. -/
theorem rankOneLiftPoints_le_normalizerPoints
    {B : Type v} (m : B → normalizerPoints i) :
    rankOneLiftPoints i m ≤ normalizerPoints i := by
  rintro _ ⟨n, _, rfl⟩
  exact n.property

/-- Each chosen lift belongs to the subgroup generated by the lifts. -/
theorem mem_rankOneLiftPoints
    {B : Type v} (m : B → normalizerPoints i) (a : B) :
    (m a).val ∈ rankOneLiftPoints i m := by
  refine ⟨m a, ?_, rfl⟩
  change m a ∈ rankOneCentralizerNormalizerPoints i ⊔ Subgroup.closure (Set.range m)
  exact Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_range_self a))

/-- The image of the generated normalizer subgroup has the expected
ambient rational-point generators. -/
theorem rankOneLiftPoints_le_closure
    {B : Type v} (m : B → normalizerPoints i) :
    rankOneLiftPoints i m ≤ Subgroup.closure
      ((rankOneCentralizerGeneratedPoints i : Set (rationalPoints G)) ∪
        Set.range (fun a => (m a).val)) := by
  apply Subgroup.map_le_iff_le_comap.mpr
  change rankOneCentralizerNormalizerPoints i ⊔ Subgroup.closure (Set.range m) ≤ _
  refine sup_le ?_ ((Subgroup.closure_le _).2 ?_)
  · intro n hn
    exact Subgroup.subset_closure (Or.inl hn)
  · rintro _ ⟨a, rfl⟩
    exact Subgroup.subset_closure (Or.inr (Set.mem_range_self a))

end RelativeRoot

variable [Mono i.hom.hom.left] (ν : cocharacterLattice T)

/-- Actual simple lifts in opposite-root generated subgroups, satisfying
the Coxeter relations modulo the rank-one centralizer subgroup. -/
def HasRootGeneratedSimpleReflectionLifts
    {C : CoxeterMatrix (SimpleRoot i ν)}
    (cs : CoxeterSystem C (relativeWeylGroup i)) : Prop :=
  ∃ m : SimpleRoot i ν → normalizerPoints i,
    (∀ a, (QuotientGroup.mk (m a) : relativeWeylGroup i) = cs.simple a) ∧
    (∀ a, (m a).val ∈ RelativeRoot.oppositeGeneratedPoints i a.val) ∧
    C.IsLiftable (fun a => (QuotientGroup.mk (m a) :
      normalizerPoints i ⧸ RelativeRoot.rankOneCentralizerNormalizerPoints i))

/-- The earlier actual word argument covers the root-generated subgroup
using the precise lift-generated subgroup from the kernel computation. -/
theorem hasRootGeneratedBruhatCovering_rankOneLiftPoints
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hν : IsGenericCocharacter i ν)
    (hfac : HasSimpleRootUnipotentFactorization i ν)
    (hE : RelativeRoot.HasOppositeFactorPairs i)
    {C : CoxeterMatrix (SimpleRoot i ν)}
    (cs : CoxeterSystem C (relativeWeylGroup i))
    (hSimple : ∀ a : SimpleRoot i ν, IsRelativeReflection i a.val (cs.simple a))
    (m : SimpleRoot i ν → normalizerPoints i)
    (hm : ∀ a, (QuotientGroup.mk (m a) : relativeWeylGroup i) = cs.simple a)
    (hmL : ∀ a, (m a).val ∈ RelativeRoot.oppositeGeneratedPoints i a.val) :
    HasRootGeneratedBruhatCovering i ν (RelativeRoot.rankOneLiftPoints i m) := by
  refine hasRootGeneratedBruhatCovering_of_simpleLifts i ν hT hroot hν hfac hE cs
    (RelativeRoot.rankOneCentralizerGeneratedPoints i)
    (RelativeRoot.rankOneLiftPoints i m)
    (RelativeRoot.rankOneCentralizerGeneratedPoints_le_centralizer i)
    (RelativeRoot.rankOneCentralizerGeneratedPoints_le_rankOneLiftPoints i m)
    (RelativeRoot.rankOneLiftPoints_le_normalizerPoints i m)
    m (RelativeRoot.mem_rankOneLiftPoints i m) hm ?_ hmL ?_
    (RelativeRoot.rankOneLiftPoints_le_closure i m)
  · intro a
    rw [hm]
    exact hSimple a
  · intro a z hz
    exact Subgroup.subset_closure (Set.mem_iUnion₂.mpr ⟨a.val, a.property.1.1, hz⟩)

/-- Covering, actual normalizer separation and the lift-generated kernel
bound give the desired centralizer inclusion for fixed structural data. -/
theorem centralizer_inf_generatedPoints_le_of_simpleLifts
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hν : IsGenericCocharacter i ν)
    (hroot : HasRelativeRootSystem i)
    (hfac : HasSimpleRootUnipotentFactorization i ν)
    (hE : RelativeRoot.HasOppositeFactorPairs i)
    {C : CoxeterMatrix (SimpleRoot i ν)}
    (cs : CoxeterSystem C (relativeWeylGroup i))
    (hSimple : ∀ a : SimpleRoot i ν, IsRelativeReflection i a.val (cs.simple a))
    (hLifts : HasRootGeneratedSimpleReflectionLifts i ν cs) :
    centralizerPoints i ⊓ relativeRootGeneratedSubgroup i ≤
      RelativeRoot.rankOneCentralizerGeneratedPoints i := by
  obtain ⟨m, hm, hmL, hrel⟩ := hLifts
  exact centralizer_inf_rootGenerated_le_of_bruhatCovering i ν hG hi hν
    (RelativeRoot.rankOneLiftPoints i m)
    (RelativeRoot.rankOneCentralizerGeneratedPoints i)
    (RelativeRoot.rankOneLiftPoints_le_normalizerPoints i m)
    (hasRootGeneratedBruhatCovering_rankOneLiftPoints i ν hi.isSplitSubtorus.1
      hroot hν hfac hE cs hSimple m hm hmL)
    (RelativeRoot.centralizer_inf_rankOneLiftPoints_le i cs m hm hrel)

/-- The root-system realization and ordered root-point products supply
the simple-root unipotent factorization in the assembled bound. -/
theorem centralizer_inf_generatedPoints_le_of_orderedRootPoints
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hν : IsGenericCocharacter i ν)
    (hroot : HasRelativeRootSystem i)
    (hprod : HasOrderedRootPointFactorization i ν)
    (hE : RelativeRoot.HasOppositeFactorPairs i)
    {C : CoxeterMatrix (SimpleRoot i ν)}
    (cs : CoxeterSystem C (relativeWeylGroup i))
    (hSimple : ∀ a : SimpleRoot i ν, IsRelativeReflection i a.val (cs.simple a))
    (hLifts : HasRootGeneratedSimpleReflectionLifts i ν cs) :
    centralizerPoints i ⊓ relativeRootGeneratedSubgroup i ≤
      RelativeRoot.rankOneCentralizerGeneratedPoints i := by
  have hT := hi.isSplitSubtorus.1
  have hfac := hasSimpleRootUnipotentFactorization_of_orderedRootPoints i ν hν
    (fun _ ha => hroot.neg_mem_relativeRoots i hT ha)
    (hroot.linearIndependent_simpleRelativeRoots i ν hT hν)
    (hroot.finite_relativeRoots i hT) hprod
  exact centralizer_inf_generatedPoints_le_of_simpleLifts i ν
    hG hi hν hroot hfac hE cs hSimple hLifts

end Langlands.GroupScheme
