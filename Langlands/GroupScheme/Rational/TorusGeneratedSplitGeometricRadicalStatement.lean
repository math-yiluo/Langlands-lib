import Langlands.GroupScheme.Rational.TorusGeneratedEnvelope
import Langlands.GroupScheme.Rational.LeviSubgroup

/-! # The split geometric radical of a torus-generated solvable group -/

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- In a smooth connected affine solvable group generated by its ground-field
tori, the geometric unipotent radical descends and is split over that field. -/
def TorusGeneratedSplitGeometricRadicalStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left],
    IsSolvableGroupScheme G → IsTorusGenerated G →
      ∃ (U : GroupScheme (Spec (CommRingCat.of k))) (i : U ⟶ G),
        LeviSubgroup.IsGeometricUnipotentRadical i ∧ RelativeRoot.IsSplitUnipotent U

end Langlands.GroupScheme
