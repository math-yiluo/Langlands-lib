import Langlands.GroupScheme.Rational.ParabolicRootPresentationIntrinsicRoots
import Langlands.GroupScheme.Rational.StandardLeviCentralImage
import Langlands.GroupScheme.Rational.SplitComponentCocharacters
import Langlands.GroupScheme.Rational.IndependentStandardCocharacter
import Langlands.GroupScheme.Rational.PositiveRootInduction
import Langlands.GroupScheme.Dynamic.LieProof

/-! # Restricted ambient simple roots and intrinsic component roots -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.GroupScheme.ParabolicRootPresentation

variable {k : Type u} [Field k]
  {A : CommGroupScheme (Spec (CommRingCat.of k))}
  {G M P : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom]
  {p : P ⟶ G} {l : M ⟶ P} {a : A.toGrp ⟶ M}
  (r : ParabolicRootPresentation p l a)

/-- Every standard cocharacter lifts integrally through the specified component.
The cocharacter need not be the chosen simultaneous dynamic realization. -/
theorem exists_standardCocharacter_lift
    {zeta : cocharacterLattice r.data.T}
    (hzeta : IsStandardCocharacter r.data.i r.data.ν r.data.J zeta) :
    ∃ mu : cocharacterLattice A,
      RealTorusSpace.cocharacterMapInt r.data.f mu = zeta := by
  have : IsAffineHom M.X.hom := r.isCompatible.levi.isConnectedReductive.isAffineHom
  have hjc : IsClosedSubgroup (l ≫ p) :=
    r.isCompatible.levi.isClosedSubgroup.comp r.isCompatible.parabolic.isClosedSubgroup
  let := hjc.mono
  have : Mono (l ≫ p).hom.hom := Over.mono_of_mono_left _
  have hj : (standardLevi r.data.i r.data.ν r.data.J).IsRepresentedBy (l ≫ p) :=
    ⟨inferInstance, r.isCompatible.levi_eq⟩
  let t := standardLeviTorusFactor r.data.i r.data.ν r.data.J hj
  have ht : t ≫ (l ≫ p) = r.data.i :=
    standardLeviTorusFactor_comp r.data.i r.data.ν r.data.J hj
  have htmax : IsMaximalSplitTorus t :=
    r.isCompatible.maximalSplit.isMaximalSplitTorus_standardLeviTorusFactor
      r.data.i r.data.ν r.data.J hj hjc
  have : Mono t.hom.hom.left := htmax.isSplitSubtorus.mono
  have hft : CommGroupScheme.groupHom r.data.f ≫ t = a :=
    hj.hom_ext (by rw [Category.assoc, ht]; exact r.isCompatible.factor_comp)
  have hc : zeta ∈ centralCocharacters t :=
    hzeta.isCentral_standardLeviTorusFactor r.data.i r.data.ν r.data.J hj
  rw [← r.isCompatible.splitComponent.range_cocharacterMapInt_eq_centralCocharacters
    r.data.f hft] at hc
  exact hc

/-- An actual integral lift of a supplied standard cocharacter. -/
def standardCocharacterLift
    {zeta : cocharacterLattice r.data.T}
    (hzeta : IsStandardCocharacter r.data.i r.data.ν r.data.J zeta) :
    cocharacterLattice A :=
  (r.exists_standardCocharacter_lift hzeta).choose

@[simp] theorem cocharacterMapInt_standardCocharacterLift
    {zeta : cocharacterLattice r.data.T}
    (hzeta : IsStandardCocharacter r.data.i r.data.ν r.data.J zeta) :
    RealTorusSpace.cocharacterMapInt r.data.f (r.standardCocharacterLift hzeta) = zeta :=
  (r.exists_standardCocharacter_lift hzeta).choose_spec

section FiniteType

variable [LocallyOfFiniteType G.X.hom]

/-- Selected ambient roots vanish after restriction to the specified component. -/
theorem selectedRoot_restrict_eq_zero
    {alpha : characterLattice r.data.T} (halpha : alpha ∈ r.data.J) :
    r.data.f ≫ alpha = 0 := by
  have hjc : IsClosedSubgroup (l ≫ p) :=
    r.isCompatible.levi.isClosedSubgroup.comp r.isCompatible.parabolic.isClosedSubgroup
  let := hjc.mono
  have : Mono (l ≫ p).hom.hom := Over.mono_of_mono_left _
  exact selectedRoot_restrict_eq_zero_standardLevi dynamicLie
    r.data.i r.data.ν r.data.J r.isCompatible.subset_simpleRoots hjc
    ⟨inferInstance, r.isCompatible.levi_eq⟩ a r.isCompatible.splitComponent.1
    r.data.f r.isCompatible.factor_comp halpha

/-- Restriction vanishes on the positive monoid generated by selected roots. -/
theorem restrict_eq_zero_of_mem_closure
    {alpha : characterLattice r.data.T}
    (halpha : alpha ∈ AddSubmonoid.closure r.data.J) :
    r.data.f ≫ alpha = 0 := by
  induction halpha using AddSubmonoid.closure_induction with
  | mem x hx => exact r.selectedRoot_restrict_eq_zero hx
  | zero => simp
  | add x y _ _ hx hy => simp [Preadditive.comp_add, hx, hy]

/-- A positive ambient root restricts either to zero or to an intrinsic positive
root. The zero case is proved using actual selected-root centrality. -/
theorem restrict_positive_eq_zero_or_mem
    {alpha : characterLattice r.data.T}
    (halpha : alpha ∈ positiveRelativeRoots r.data.i r.data.ν) :
    r.data.f ≫ alpha = 0 ∨ r.data.f ≫ alpha ∈ r.intrinsicPositiveRoots := by
  have hn := r.isStandard_splitComponentCocharacter.pairing_nonneg_of_positive
    r.data.i r.data.ν halpha
  by_cases hz : latticePairing r.data.T alpha
      (RealTorusSpace.cocharacterMapInt r.data.f r.splitComponentCocharacter) = 0
  · exact Or.inl (r.restrict_eq_zero_of_mem_closure
      ((r.isStandard_splitComponentCocharacter.pairing_eq_zero_iff_mem_closure
        r.data.i r.data.ν halpha).mp hz))
  · have hp : 0 < latticePairing A (r.data.f ≫ alpha) r.splitComponentCocharacter := by
      rw [RelativeRoot.latticePairing_restrict_cocharacterMapInt]
      omega
    have hne : r.data.f ≫ alpha ≠ 0 := by
      intro h
      simp [h] at hp
    refine Or.inr ⟨?_, hp⟩
    rw [← r.isCompatible.factor_comp]
    exact (rootRestriction r.data.f r.data.i ⟨alpha, halpha.1, hne⟩).property

/-- With root negation, a positive component root has a positive ambient lift. -/
theorem exists_positiveRoot_restrict
    (hneg : ∀ alpha ∈ relativeRoots r.data.i, -alpha ∈ relativeRoots r.data.i)
    {beta : characterLattice A} (hbeta : beta ∈ r.intrinsicPositiveRoots) :
    ∃ alpha ∈ positiveRelativeRoots r.data.i r.data.ν, r.data.f ≫ alpha = beta := by
  have hbroot : beta ∈ roots (CommGroupScheme.groupHom r.data.f ≫ r.data.i) := by
    rw [r.isCompatible.factor_comp]
    exact hbeta.1
  obtain ⟨_, alpha, halpha, heq⟩ := (mem_roots_comp_iff
    r.isCompatible.maximalSplit.isSplitSubtorus.1 r.isCompatible.splitComponent.1.1.1
    r.data.f r.data.i beta).mp hbroot
  refine ⟨alpha, ⟨halpha, ?_⟩, heq⟩
  have hp : 0 < latticePairing r.data.T alpha
      (RealTorusSpace.cocharacterMapInt r.data.f r.splitComponentCocharacter) := by
    rw [← RelativeRoot.latticePairing_restrict_cocharacterMapInt, heq]
    exact hbeta.2
  rcases lt_or_gt_of_ne (r.isCompatible.generic alpha halpha) with hn | hpos
  · have hnp : -alpha ∈ positiveRelativeRoots r.data.i r.data.ν :=
      ⟨hneg alpha halpha, by simpa using neg_pos.mpr hn⟩
    have h := r.isStandard_splitComponentCocharacter.pairing_nonneg_of_positive
      r.data.i r.data.ν hnp
    simp only [map_neg, LinearMap.neg_apply] at h
    omega
  · exact hpos

/-- Every intrinsic simple root is a restriction of a complementary ambient
simple root. This direction needs negation but no root independence premise. -/
theorem exists_simpleRoot_restrict
    (hneg : ∀ alpha ∈ relativeRoots r.data.i, -alpha ∈ relativeRoots r.data.i)
    {beta : characterLattice A} (hbeta : beta ∈ r.intrinsicSimpleRoots) :
    ∃ alpha ∈ simpleRelativeRoots r.data.i r.data.ν,
      alpha ∉ r.data.J ∧ r.data.f ≫ alpha = beta := by
  obtain ⟨alpha, halpha, heq⟩ := r.exists_positiveRoot_restrict hneg hbeta.1
  have h := positiveRelativeRoots_induction r.data.i r.data.ν
    (P := fun chi => ∀ beta ∈ r.intrinsicSimpleRoots, r.data.f ≫ chi = beta →
      ∃ delta ∈ simpleRelativeRoots r.data.i r.data.ν,
        delta ∉ r.data.J ∧ r.data.f ≫ delta = beta)
    (hsimple := fun chi hchi beta hb heq => by
      refine ⟨chi, hchi, ?_, heq⟩
      intro hJ
      have hz := r.selectedRoot_restrict_eq_zero hJ
      exact hb.1.1.1 (heq.symm.trans hz))
    (hadd := fun chi hchi psi hpsi ihchi ihpsi beta hb heq => by
      have heq' : beta = r.data.f ≫ chi + r.data.f ≫ psi := by
        simpa only [Preadditive.comp_add] using heq.symm
      rcases r.restrict_positive_eq_zero_or_mem hchi with hc | hc
      · apply ihpsi beta hb
        simpa only [hc, zero_add] using heq'.symm
      · rcases r.restrict_positive_eq_zero_or_mem hpsi with hp | hp
        · apply ihchi beta hb
          simpa only [hp, add_zero] using heq'.symm
        · exact False.elim (hb.2 ⟨r.data.f ≫ chi, hc, r.data.f ≫ psi, hp, heq'⟩))
    halpha
  exact h beta hbeta heq

omit [LocallyOfFiniteType G.X.hom] in
/-- Independent rationalized ambient simple roots give an integral component
cocharacter taking one common positive value on all complementary simple roots. -/
theorem exists_uniform_splitComponentCocharacter
    (hLI : LinearIndependent ℚ (fun alpha : simpleRelativeRoots r.data.i r.data.ν =>
      toRat (alpha : characterLattice r.data.T))) :
    ∃ d : ℤ, 0 < d ∧ ∃ mu : cocharacterLattice A,
      IsStandardCocharacter r.data.i r.data.ν r.data.J
        (RealTorusSpace.cocharacterMapInt r.data.f mu) ∧
      ∀ alpha ∈ simpleRelativeRoots r.data.i r.data.ν, alpha ∉ r.data.J →
        latticePairing A (r.data.f ≫ alpha) mu = d := by
  classical
  obtain ⟨d, hd, zeta, hzeta⟩ :=
    r.isCompatible.maximalSplit.isSplitSubtorus.1.exists_scaled_pairings
      (fun alpha : simpleRelativeRoots r.data.i r.data.ν =>
        (alpha : characterLattice r.data.T)) hLI
      (fun alpha => if (alpha : characterLattice r.data.T) ∈ r.data.J then 0 else 1)
  have hs : IsStandardCocharacter r.data.i r.data.ν r.data.J zeta := by
    refine ⟨r.isCompatible.subset_simpleRoots, ?_, ?_⟩
    · intro alpha halpha
      simpa [halpha] using hzeta ⟨alpha, r.isCompatible.subset_simpleRoots halpha⟩
    · intro alpha halpha hJ
      simpa [hJ, hzeta ⟨alpha, halpha⟩] using hd
  obtain ⟨mu, hmu⟩ := r.exists_standardCocharacter_lift hs
  refine ⟨d, hd, mu, hmu ▸ hs, fun alpha halpha hJ => ?_⟩
  rw [RelativeRoot.latticePairing_restrict_cocharacterMapInt, hmu]
  simpa only [hJ, ite_false, mul_one] using hzeta ⟨alpha, halpha⟩

/-- A uniform positive height on complementary ambient simples bounds below
all positive component roots, even when ambient roots merge under restriction. -/
theorem uniform_pairing_le_of_intrinsicPositive
    (hneg : ∀ alpha ∈ relativeRoots r.data.i, -alpha ∈ relativeRoots r.data.i)
    {d : ℤ} (hd : 0 < d) (mu : cocharacterLattice A)
    (hmu : IsStandardCocharacter r.data.i r.data.ν r.data.J
      (RealTorusSpace.cocharacterMapInt r.data.f mu))
    (hpair : ∀ alpha ∈ simpleRelativeRoots r.data.i r.data.ν, alpha ∉ r.data.J →
      latticePairing A (r.data.f ≫ alpha) mu = d)
    {beta : characterLattice A} (hbeta : beta ∈ r.intrinsicPositiveRoots) :
    d ≤ latticePairing A beta mu := by
  obtain ⟨alpha, halpha, heq⟩ := r.exists_positiveRoot_restrict hneg hbeta
  have hbound : latticePairing A (r.data.f ≫ alpha) mu = 0 ∨
      d ≤ latticePairing A (r.data.f ≫ alpha) mu := by
    apply positiveRelativeRoots_induction r.data.i r.data.ν
      (P := fun chi => latticePairing A (r.data.f ≫ chi) mu = 0 ∨
        d ≤ latticePairing A (r.data.f ≫ chi) mu) (hα := halpha)
    · intro chi hchi
      by_cases hJ : chi ∈ r.data.J
      · left
        rw [RelativeRoot.latticePairing_restrict_cocharacterMapInt]
        exact hmu.2.1 chi hJ
      · exact Or.inr (le_of_eq (hpair chi hchi hJ).symm)
    · intro chi _ psi _ hc hp
      simp only [Preadditive.comp_add, map_add, LinearMap.add_apply]
      omega
  have hpos : 0 < latticePairing A (r.data.f ≫ alpha) mu := by
    rw [RelativeRoot.latticePairing_restrict_cocharacterMapInt]
    apply (r.isStandard_splitComponentCocharacter.same_pairing_signs_of_positive
      r.data.i r.data.ν hmu halpha).2.2.mp
    rw [← RelativeRoot.latticePairing_restrict_cocharacterMapInt, heq]
    exact hbeta.2
  rw [heq] at hbound hpos
  omega

/-- Under independence and negation, a complementary ambient simple root
restricts to an indecomposable positive component weight. -/
theorem restrict_mem_intrinsicSimpleRoots
    (hLI : LinearIndependent ℚ (fun alpha : simpleRelativeRoots r.data.i r.data.ν =>
      toRat (alpha : characterLattice r.data.T)))
    (hneg : ∀ alpha ∈ relativeRoots r.data.i, -alpha ∈ relativeRoots r.data.i)
    {alpha : characterLattice r.data.T}
    (halpha : alpha ∈ simpleRelativeRoots r.data.i r.data.ν)
    (hJ : alpha ∉ r.data.J) :
    r.data.f ≫ alpha ∈ r.intrinsicSimpleRoots := by
  refine ⟨r.restrict_mem_intrinsicPositiveRoots halpha hJ, ?_⟩
  rintro ⟨beta, hb, gamma, hg, heq⟩
  obtain ⟨d, hd, mu, hmu, hpair⟩ := r.exists_uniform_splitComponentCocharacter hLI
  have hb' := r.uniform_pairing_le_of_intrinsicPositive hneg hd mu hmu hpair hb
  have hg' := r.uniform_pairing_le_of_intrinsicPositive hneg hd mu hmu hpair hg
  have hsum := congrArg (fun chi => latticePairing A chi mu) heq
  have ha := hpair alpha halpha hJ
  simp only [map_add, LinearMap.add_apply] at hsum
  omega

/-- The restricted-root set in the full real character space is the real
image of intrinsic simple roots under the two explicit root hypotheses. -/
theorem restrictedRoots_eq_image_intrinsicSimpleRoots
    (hLI : LinearIndependent ℚ (fun alpha : simpleRelativeRoots r.data.i r.data.ν =>
      toRat (alpha : characterLattice r.data.T)))
    (hneg : ∀ alpha ∈ relativeRoots r.data.i, -alpha ∈ relativeRoots r.data.i) :
    r.restrictedRoots =
      (fun alpha : characterLattice A => (1 : ℝ) ⊗ₜ[ℤ] alpha) '' r.intrinsicSimpleRoots := by
  ext x
  constructor
  · intro hx
    obtain ⟨alpha, halpha, hJ, rfl⟩ := r.mem_restrictedRoots.mp hx
    exact ⟨_, r.restrict_mem_intrinsicSimpleRoots hLI hneg halpha hJ, rfl⟩
  · rintro ⟨beta, hbeta, rfl⟩
    obtain ⟨alpha, halpha, hJ, heq⟩ := r.exists_simpleRoot_restrict hneg hbeta
    exact r.mem_restrictedRoots.mpr ⟨alpha, halpha, hJ, congrArg _ heq⟩

end FiniteType

end Langlands.GroupScheme.ParabolicRootPresentation
