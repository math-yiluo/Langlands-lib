import Langlands.GroupScheme.Rational.StandardParabolic
import Mathlib.Algebra.Group.Submonoid.Operations
import Lean.Elab.Tactic.Omega

/-! # Positive-root induction and standard-cocharacter signs -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)

/-- Cocharacters have the same relative-root signs when their pairings with
every actual relative root have equivalent nonnegative, zero, and positive signs.
This property asserts no comparison of dynamic subgroup functors. -/
def HaveSameRelativeRootSigns (zeta eta : cocharacterLattice T) : Prop :=
  ∀ α ∈ relativeRoots i,
    (0 ≤ latticePairing T α zeta ↔ 0 ≤ latticePairing T α eta) ∧
    (latticePairing T α zeta = 0 ↔ latticePairing T α eta = 0) ∧
    (0 < latticePairing T α zeta ↔ 0 < latticePairing T α eta)

theorem HaveSameRelativeRootSigns.refl (zeta : cocharacterLattice T) :
    HaveSameRelativeRootSigns i zeta zeta :=
  fun _ _ => ⟨Iff.rfl, Iff.rfl, Iff.rfl⟩

theorem HaveSameRelativeRootSigns.symm {zeta eta : cocharacterLattice T}
    (h : HaveSameRelativeRootSigns i zeta eta) :
    HaveSameRelativeRootSigns i eta zeta := by
  intro α hα
  exact ⟨(h α hα).1.symm, (h α hα).2.1.symm, (h α hα).2.2.symm⟩

theorem HaveSameRelativeRootSigns.trans {zeta eta theta : cocharacterLattice T}
    (h₁ : HaveSameRelativeRootSigns i zeta eta)
    (h₂ : HaveSameRelativeRootSigns i eta theta) :
    HaveSameRelativeRootSigns i zeta theta := by
  intro α hα
  exact ⟨(h₁ α hα).1.trans (h₂ α hα).1,
    (h₁ α hα).2.1.trans (h₂ α hα).2.1,
    (h₁ α hα).2.2.trans (h₂ α hα).2.2⟩

/-- Induction on the positive integer pairing decomposes positive relative roots
into the simple ones, without a root-system or finiteness assumption. -/
theorem positiveRelativeRoots_induction {P : characterLattice T → Prop}
    (hsimple : ∀ α ∈ simpleRelativeRoots i ν, P α)
    (hadd : ∀ α ∈ positiveRelativeRoots i ν, ∀ β ∈ positiveRelativeRoots i ν,
      P α → P β → P (α + β))
    {α : characterLattice T} (hα : α ∈ positiveRelativeRoots i ν) : P α := by
  generalize hn : (latticePairing T α ν).toNat = n
  induction n using Nat.strong_induction_on generalizing α with
  | h n ih =>
    by_cases hs : α ∈ simpleRelativeRoots i ν
    · exact hsimple α hs
    · have hdecomp : ∃ β ∈ positiveRelativeRoots i ν,
          ∃ γ ∈ positiveRelativeRoots i ν, α = β + γ := by
        by_contra h
        exact hs ⟨hα, h⟩
      obtain ⟨β, hβ, γ, hγ, rfl⟩ := hdecomp
      have hsum : latticePairing T (β + γ) ν =
          latticePairing T β ν + latticePairing T γ ν := by
        simp
      have hb : (latticePairing T β ν).toNat < n := by
        have := hα.2
        have := hβ.2
        have := hγ.2
        omega
      have hc : (latticePairing T γ ν).toNat < n := by
        have := hα.2
        have := hβ.2
        have := hγ.2
        omega
      exact hadd β hβ γ hγ (ih _ hb hβ rfl) (ih _ hc hγ rfl)

/-- Every positive relative root belongs to the additive monoid generated by
the actual indecomposable positive relative roots. -/
theorem positiveRelativeRoots_subset_closure_simpleRelativeRoots :
    positiveRelativeRoots i ν ⊆ AddSubmonoid.closure (simpleRelativeRoots i ν) := by
  intro α hα
  exact positiveRelativeRoots_induction i ν
    (fun _ h => AddSubmonoid.subset_closure h)
    (fun _ _ _ _ hx hy => AddSubmonoid.add_mem _ hx hy) hα

/-- A standard cocharacter pairs nonnegatively with every positive relative root. -/
theorem IsStandardCocharacter.pairing_nonneg_of_positive
    {J : Set (characterLattice T)} {zeta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    {α : characterLattice T} (hα : α ∈ positiveRelativeRoots i ν) :
    0 ≤ latticePairing T α zeta := by
  apply positiveRelativeRoots_induction i ν (P := fun α => 0 ≤ latticePairing T α zeta)
      (hα := hα)
  · intro β hβ
    by_cases hβJ : β ∈ J
    · exact le_of_eq (hzeta.2.1 β hβJ).symm
    · exact le_of_lt (hzeta.2.2 β hβ hβJ)
  · intro β _ γ _ hβ hγ
    simpa using add_nonneg hβ hγ

/-- A standard cocharacter vanishes on the additive monoid generated by J. -/
theorem IsStandardCocharacter.pairing_eq_zero_of_mem_closure
    {J : Set (characterLattice T)} {zeta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    {α : characterLattice T} (hα : α ∈ AddSubmonoid.closure J) :
    latticePairing T α zeta = 0 := by
  induction hα using AddSubmonoid.closure_induction with
  | mem x hx => exact hzeta.2.1 x hx
  | zero => simp
  | add x y _ _ hx hy => simp [hx, hy]

/-- Among positive relative roots, a standard cocharacter vanishes exactly on
those in the additive monoid generated by J. -/
theorem IsStandardCocharacter.pairing_eq_zero_iff_mem_closure
    {J : Set (characterLattice T)} {zeta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    {α : characterLattice T} (hα : α ∈ positiveRelativeRoots i ν) :
    latticePairing T α zeta = 0 ↔ α ∈ AddSubmonoid.closure J := by
  refine ⟨?_, hzeta.pairing_eq_zero_of_mem_closure i ν⟩
  have h := positiveRelativeRoots_induction i ν
    (P := fun α => latticePairing T α zeta = 0 → α ∈ AddSubmonoid.closure J)
    (hsimple := fun β hβ hzero => by
      by_cases hβJ : β ∈ J
      · exact AddSubmonoid.subset_closure hβJ
      · have := hzeta.2.2 β hβ hβJ
        omega)
    (hadd := fun β hβpos γ hγpos hβ hγ hzero => by
      have hβnonneg := hzeta.pairing_nonneg_of_positive i ν hβpos
      have hγnonneg := hzeta.pairing_nonneg_of_positive i ν hγpos
      have hsum : latticePairing T β zeta + latticePairing T γ zeta = 0 := by
        simpa using hzero
      exact AddSubmonoid.add_mem _ (hβ (by omega)) (hγ (by omega))) hα
  exact h

/-- Among positive relative roots, a standard cocharacter is positive precisely
outside the additive monoid generated by J. -/
theorem IsStandardCocharacter.pairing_pos_iff_not_mem_closure
    {J : Set (characterLattice T)} {zeta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    {α : characterLattice T} (hα : α ∈ positiveRelativeRoots i ν) :
    0 < latticePairing T α zeta ↔ α ∉ AddSubmonoid.closure J := by
  have hnonneg := hzeta.pairing_nonneg_of_positive i ν hα
  rw [← hzeta.pairing_eq_zero_iff_mem_closure i ν hα]
  omega

/-- Two standard cocharacters for the same J have the same weak, zero, and
strict signs on every positive relative root. -/
theorem IsStandardCocharacter.same_pairing_signs_of_positive
    {J : Set (characterLattice T)} {zeta eta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    (heta : IsStandardCocharacter i ν J eta)
    {α : characterLattice T} (hα : α ∈ positiveRelativeRoots i ν) :
    (0 ≤ latticePairing T α zeta ↔ 0 ≤ latticePairing T α eta) ∧
    (latticePairing T α zeta = 0 ↔ latticePairing T α eta = 0) ∧
    (0 < latticePairing T α zeta ↔ 0 < latticePairing T α eta) := by
  refine ⟨iff_of_true (hzeta.pairing_nonneg_of_positive i ν hα)
    (heta.pairing_nonneg_of_positive i ν hα), ?_, ?_⟩
  · exact (hzeta.pairing_eq_zero_iff_mem_closure i ν hα).trans
      (heta.pairing_eq_zero_iff_mem_closure i ν hα).symm
  · exact (hzeta.pairing_pos_iff_not_mem_closure i ν hα).trans
      (heta.pairing_pos_iff_not_mem_closure i ν hα).symm

/-- Under explicit negation stability and genericity, the sign comparisons for
two standard cocharacters extend from positive roots to every relative root. -/
theorem IsStandardCocharacter.same_pairing_signs_of_root
    (hν : IsGenericCocharacter i ν)
    (hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i)
    {J : Set (characterLattice T)} {zeta eta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    (heta : IsStandardCocharacter i ν J eta)
    {α : characterLattice T} (hα : α ∈ relativeRoots i) :
    (0 ≤ latticePairing T α zeta ↔ 0 ≤ latticePairing T α eta) ∧
    (latticePairing T α zeta = 0 ↔ latticePairing T α eta = 0) ∧
    (0 < latticePairing T α zeta ↔ 0 < latticePairing T α eta) := by
  rcases lt_or_gt_of_ne (hν α hα) with hnegative | hpositive
  · have hpos : -α ∈ positiveRelativeRoots i ν :=
      ⟨hneg α hα, by simpa using neg_pos.mpr hnegative⟩
    have hz : latticePairing T α zeta ≤ 0 := by
      simpa using hzeta.pairing_nonneg_of_positive i ν hpos
    have he : latticePairing T α eta ≤ 0 := by
      simpa using heta.pairing_nonneg_of_positive i ν hpos
    have hzero : latticePairing T α zeta = 0 ↔ latticePairing T α eta = 0 := by
      simpa using (hzeta.same_pairing_signs_of_positive i ν heta hpos).2.1
    exact ⟨by omega, hzero, by omega⟩
  · exact hzeta.same_pairing_signs_of_positive i ν heta ⟨hα, hpositive⟩

/-- Standard cocharacters for a common J have the same relative-root signs,
assuming genericity and negation stability explicitly. -/
theorem IsStandardCocharacter.haveSameRelativeRootSigns
    (hν : IsGenericCocharacter i ν)
    (hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i)
    {J : Set (characterLattice T)} {zeta eta : cocharacterLattice T}
    (hzeta : IsStandardCocharacter i ν J zeta)
    (heta : IsStandardCocharacter i ν J eta) :
    HaveSameRelativeRootSigns i zeta eta :=
  fun _ hα => hzeta.same_pairing_signs_of_root i ν hν hneg heta hα

/-- With genericity and negation stability, the simple relative roots generate
all relative roots as an additive group. -/
theorem relativeRoots_subset_addSubgroupClosure_simpleRelativeRoots
    (hν : IsGenericCocharacter i ν)
    (hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i) :
    relativeRoots i ⊆ AddSubgroup.closure (simpleRelativeRoots i ν) := by
  have hpos : ∀ α ∈ positiveRelativeRoots i ν,
      α ∈ AddSubgroup.closure (simpleRelativeRoots i ν) := by
    intro α hα
    exact positiveRelativeRoots_induction i ν
      (fun _ h => AddSubgroup.subset_closure h)
      (fun _ _ _ _ hx hy => AddSubgroup.add_mem _ hx hy) hα
  intro α hα
  rcases lt_or_gt_of_ne (hν α hα) with hnegative | hpositive
  · have hn := hpos (-α) ⟨hneg α hα, by simpa using neg_pos.mpr hnegative⟩
    simpa using AddSubgroup.neg_mem _ hn
  · exact hpos α ⟨hα, hpositive⟩

end Langlands.GroupScheme
