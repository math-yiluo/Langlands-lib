import Langlands.GroupScheme.Rational.RelativeTitsMulCellReduction
import Langlands.GroupScheme.Rational.RootSubgroupNontrivial
import Langlands.GroupScheme.Rational.RootProductStatement
import Langlands.GroupScheme.Rational.OrderedProductPoints
import Langlands.GroupScheme.Rational.RootRayDecomposition
import Langlands.GroupScheme.Rational.RelativeRootStandardCocharacter
import Langlands.GroupScheme.Rational.PositiveRootInduction
import Langlands.GroupScheme.Dynamic.LimitMap
import Mathlib.Tactic.Group

/-! # The simple-root parabolic factorization from the ordered root product

For a simple relative root `a` and a reflection `s` in `a`, every `b ∈ P_∅(k)` is `b' * u` with
`u ∈ U_a(k)` and `n b' n⁻¹ ∈ P_∅(k)` for every representative `n` of `s`
(`HasSimpleRootParabolicFactorization`). The proof follows Borel–Tits 5.16: write
`b = z * v` with `z ∈ Z(k)` and `v ∈ U(ν)(k)`, order the indivisible positive roots with `a` last
and factor `v = v' * u` accordingly. Then `n z n⁻¹ ∈ Z(k)`, and `n v' n⁻¹ ∈ U(ν)(k)` because the
reflection `s` keeps every indivisible positive root other than `a` positive. The decomposition
`b = z * v` uses the published limit map of the dynamic parabolic. The unproved inputs are the
generic centralizer identity, the minimal endpoint identity, the ordered product of root
subgroups (through `HasOrderedRootPointFactorization`), and finiteness, negation-stability and
linearly independent simple roots of the relative roots.

`relativeTitsSystemStatement_of_structuralStatements` reduces `RelativeTitsSystemStatement` to
nine published structural statements, none of which is proved here.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj TensorProduct
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.GroupScheme

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

section Combinatorics

variable {i : T.toGrp ⟶ G} [IsAffineHom G.X.hom] {ν : cocharacterLattice T}

open Classical in
/-- Linearly independent simple roots have coordinate functionals on `ℚ ⊗ X*(T)`. -/
theorem exists_simpleRelativeRootCoord
    (hli : LinearIndependent ℚ
      (fun α : simpleRelativeRoots i ν => toRat (α : characterLattice T))) :
    ∃ g : simpleRelativeRoots i ν → (ℚ ⊗[ℤ] characterLattice T) →ₗ[ℚ] ℚ,
      ∀ b c : simpleRelativeRoots i ν,
        g b (toRat (c : characterLattice T)) = if c = b then 1 else 0 := by
  classical
  have h : ∀ b : simpleRelativeRoots i ν, ∃ g : (ℚ ⊗[ℤ] characterLattice T) →ₗ[ℚ] ℚ,
      ∀ c : simpleRelativeRoots i ν,
        g (toRat (c : characterLattice T)) = if c = b then 1 else 0 := by
    intro b
    obtain ⟨g, hg⟩ := LinearMap.exists_extend ((Module.Basis.span hli).coord b)
    refine ⟨g, fun c => ?_⟩
    have hc := LinearMap.congr_fun hg (Module.Basis.span hli c)
    rw [LinearMap.comp_apply, Submodule.coe_subtype, Module.Basis.coord_apply,
      Module.Basis.repr_self, Finsupp.single_apply, Module.Basis.span_apply] at hc
    exact hc
  choose g hg using h
  exact ⟨g, hg⟩

open Classical in
/-- On the additive monoid generated by the simple roots, the coordinates are nonnegative, and an
element whose coordinates vanish away from the simple root `a` is a natural multiple of `a`. -/
theorem coord_of_mem_closure_simpleRelativeRoots
    {g : simpleRelativeRoots i ν → (ℚ ⊗[ℤ] characterLattice T) →ₗ[ℚ] ℚ}
    (hg : ∀ b c : simpleRelativeRoots i ν,
      g b (toRat (c : characterLattice T)) = if c = b then 1 else 0)
    (a : simpleRelativeRoots i ν) {x : characterLattice T}
    (hx : x ∈ AddSubmonoid.closure (simpleRelativeRoots i ν)) :
    (∀ b, 0 ≤ g b (toRat x)) ∧
      ((∀ b, b ≠ a → g b (toRat x) = 0) → ∃ m : ℕ, x = m • (a : characterLattice T)) := by
  classical
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx =>
    refine ⟨fun b => ?_, fun h => ?_⟩
    · have := hg b ⟨x, hx⟩
      split_ifs at this <;> simp only [this] <;> norm_num
    · by_cases hxa : (⟨x, hx⟩ : simpleRelativeRoots i ν) = a
      · exact ⟨1, by rw [one_smul, ← hxa]⟩
      · have h1 := h ⟨x, hx⟩ hxa
        have h2 := hg ⟨x, hx⟩ ⟨x, hx⟩
        rw [ite_eq_left rfl] at h2
        exact absurd (h2.symm.trans h1) one_ne_zero
  | zero => exact ⟨fun b => by simp, fun _ => ⟨0, by simp⟩⟩
  | add x y _ _ hx hy =>
    refine ⟨fun b => by rw [map_add, map_add]; exact add_nonneg (hx.1 b) (hy.1 b),
      fun h => ?_⟩
    have hx0 : ∀ b, b ≠ a → g b (toRat x) = 0 := fun b hb => by
      have := h b hb
      rw [map_add, map_add] at this
      linarith [hx.1 b, hy.1 b]
    have hy0 : ∀ b, b ≠ a → g b (toRat y) = 0 := fun b hb => by
      have := h b hb
      rw [map_add, map_add] at this
      linarith [hx.1 b, hy.1 b]
    obtain ⟨m, rfl⟩ := hx.2 hx0
    obtain ⟨m', rfl⟩ := hy.2 hy0
    exact ⟨m + m', (add_smul m m' _).symm⟩

/-- With linearly independent simple roots, a simple root is an indivisible positive root. -/
theorem simpleRelativeRoot_mem_indivisiblePositiveRoots
    (hli : LinearIndependent ℚ
      (fun α : simpleRelativeRoots i ν => toRat (α : characterLattice T)))
    {a : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν) :
    a ∈ RelativeRoot.indivisiblePositiveRoots i ν := by
  classical
  obtain ⟨g, hg⟩ := exists_simpleRelativeRootCoord hli
  refine ⟨⟨ha.1.1, fun b hb m hm hba => ?_⟩, ha.1.2⟩
  have hpa : 0 < latticePairing T a ν := ha.1.2
  have hpb : 0 < latticePairing T b ν := by
    rw [← hba, map_nsmul, LinearMap.smul_apply, nsmul_eq_mul] at hpa
    exact pos_of_mul_pos_right hpa (by positivity)
  have hbcl : b ∈ AddSubmonoid.closure (simpleRelativeRoots i ν) :=
    positiveRelativeRoots_subset_closure_simpleRelativeRoots i ν ⟨hb, hpb⟩
  obtain ⟨m', hm'⟩ := (coord_of_mem_closure_simpleRelativeRoots hg ⟨a, ha⟩ hbcl).2 fun c hc => by
    have h1 := hg c ⟨a, ha⟩
    rw [ite_eq_right (Ne.symm hc)] at h1
    have h2 := congrArg (fun x => g c (toRat x)) hba
    simp only [map_nsmul, nsmul_eq_mul] at h2
    have h3 : (m : ℚ) * g c (toRat b) = 0 := h2.trans h1
    exact (mul_eq_zero.1 h3).resolve_left (by exact_mod_cast (by omega : m ≠ 0))
  have he : a = (m * m') • a := by
    calc a = m • b := hba.symm
      _ = m • m' • a := by rw [hm']
      _ = (m * m') • a := smul_smul m m' a
  have h1 := hg ⟨a, ha⟩ ⟨a, ha⟩
  rw [ite_eq_left rfl] at h1
  have h2 := congrArg (fun x => g ⟨a, ha⟩ (toRat x)) he
  simp only [map_nsmul, nsmul_eq_mul] at h2
  change g ⟨a, ha⟩ (toRat a) = 1 at h1
  rw [h1, mul_one] at h2
  have h3 : m * m' = 1 := by exact_mod_cast h2.symm
  have := Nat.eq_one_of_mul_eq_one_right h3
  omega

variable [Mono i.hom.hom.left]

/-- For a generic cocharacter, negation-stable roots and linearly independent simple roots, a
reflection in a simple root `a` keeps every indivisible positive root other than `a`
positive. -/
theorem pairing_weylAction_pos_of_isRelativeReflection (hν : IsGenericCocharacter i ν)
    (hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i)
    (hli : LinearIndependent ℚ
      (fun α : simpleRelativeRoots i ν => toRat (α : characterLattice T)))
    {a : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν) (n : normalizerPoints i)
    (hs : IsRelativeReflection i a (QuotientGroup.mk n))
    {c : characterLattice T} (hc : c ∈ RelativeRoot.indivisiblePositiveRoots i ν)
    (hca : c ≠ a) :
    0 < latticePairing T (weylAction i n c) ν := by
  classical
  obtain ⟨g, hg⟩ := exists_simpleRelativeRootCoord hli
  have hcR : c ∈ relativeRoots i := hc.1.1
  have hccl : c ∈ AddSubmonoid.closure (simpleRelativeRoots i ν) :=
    positiveRelativeRoots_subset_closure_simpleRelativeRoots i ν ⟨hcR, hc.2⟩
  have hcoord := coord_of_mem_closure_simpleRelativeRoots hg ⟨a, ha⟩ hccl
  -- some coordinate of `c` away from `a` is positive
  obtain ⟨b, hba, hb⟩ : ∃ b : simpleRelativeRoots i ν, b ≠ ⟨a, ha⟩ ∧ 0 < g b (toRat c) := by
    by_contra hcon
    push Not at hcon
    obtain ⟨m, hm⟩ := hcoord.2 fun b hb => le_antisymm (hcon b hb) (hcoord.1 b)
    rcases m with _ | _ | m
    · exact (mem_relativeRoots.1 hcR).1 (by simpa using hm)
    · exact hca (by simpa using hm)
    · exact hc.1.2 a ha.1.1 (m + 2) (by omega) hm.symm
  -- the reflection formula
  obtain ⟨haR, f, hf, hw⟩ := hs
  have hrefl : toRat (weylAction i n c) =
      toRat c - f ⟨toRat c, toRat_mem_ratSpan hcR⟩ • toRat a := by
    have h := congrArg Subtype.val (DFunLike.congr_fun hw ⟨toRat c, toRat_mem_ratSpan hcR⟩)
    rw [Module.reflection_apply, Submodule.coe_sub, Submodule.coe_smul] at h
    exact h
  have hdR : weylAction i n c ∈ relativeRoots i := weylAction_mapsTo_relativeRoots i n hcR
  have h0 : g b (toRat a) = 0 := by
    have h := hg b ⟨a, ha⟩
    rw [ite_eq_right (Ne.symm hba)] at h
    exact h
  have hgb : g b (toRat (weylAction i n c)) = g b (toRat c) := by
    rw [hrefl, map_sub, map_smul, h0, smul_zero, sub_zero]
  rcases lt_or_gt_of_ne (hν _ hdR) with hlt | hgt
  · exfalso
    have hnd : -weylAction i n c ∈ positiveRelativeRoots i ν :=
      ⟨hneg _ hdR, by rw [map_neg, LinearMap.neg_apply]; omega⟩
    have h := (coord_of_mem_closure_simpleRelativeRoots hg ⟨a, ha⟩
      (positiveRelativeRoots_subset_closure_simpleRelativeRoots i ν hnd)).1 b
    rw [map_neg, map_neg, hgb] at h
    linarith
  · exact hgt

end Combinatorics

section Points

variable {i : T.toGrp ⟶ G} {ν : cocharacterLattice T}

/-- A scheme isomorphism from the ordered product of represented root subgroups onto a
representative of `U(ν)` writes every point of `U(ν)(k)` as an ordered product of root-subgroup
points. -/
theorem exists_orderedRootPoints {n : ℕ} {a : Fin n → characterLattice T}
    {U : GroupScheme (Spec (CommRingCat.of k))} {jU : U ⟶ G}
    {H : Fin n → GroupScheme (Spec (CommRingCat.of k))} {j : ∀ r, H r ⟶ G}
    {e : (∏ᶜ H).X ≅ U.X}
    (hU : (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy jU)
    (hH : ∀ r, (RelativeRoot.subgroup i (a r)).IsRepresentedBy (j r))
    (he : e.hom ≫ jU.hom.hom = RelativeRoot.orderedMultiplication j)
    {x : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X}
    (hx : x ∈ (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i)).carrier (Over.mk (𝟙 _))) :
    ∃ g : Fin n → (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X),
      (∀ r, g r ∈ (RelativeRoot.subgroup i (a r)).carrier (Over.mk (𝟙 _))) ∧
        x = (List.ofFn g).prod := by
  rw [← hU.2, SubgroupFunctor.mem_range] at hx
  obtain ⟨y, rfl⟩ := hx
  let t := RelativeRoot.finiteProductPointsEquiv H _ (y ≫ e.inv)
  refine ⟨fun r => t r ≫ (j r).hom.hom, fun r => ?_, ?_⟩
  · rw [← (hH r).2, SubgroupFunctor.mem_range]
    exact ⟨t r, rfl⟩
  · have hy : y ≫ jU.hom.hom = (y ≫ e.inv) ≫ RelativeRoot.orderedMultiplication j := by
      rw [← he, Category.assoc, Iso.inv_hom_id_assoc]
    rw [hy, RelativeRoot.comp_orderedMultiplication]
    rfl

end Points

/-- **Ordered factorization of the points of `U(ν)(k)`.** For every enumeration without
repetition `a : Fin n → X^*(T)` of the indivisible positive relative roots, every point `x` of
`U(ν)(k)` is an ordered product `x = g 0 * ⋯ * g (n - 1)` with `g r ∈ U_{a r}(k)`. -/
def HasOrderedRootPointFactorization (i : T.toGrp ⟶ G) [IsAffineHom G.X.hom]
    (ν : cocharacterLattice T) : Prop :=
  ∀ (n : ℕ) (a : Fin n → characterLattice T), Function.Injective a →
    Set.range a = RelativeRoot.indivisiblePositiveRoots i ν →
    ∀ x ∈ (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i)).carrier (Over.mk (𝟙 _)),
      ∃ g : Fin n → (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X),
        (∀ r, g r ∈ (RelativeRoot.subgroup i (a r)).carrier (Over.mk (𝟙 _))) ∧
          x = (List.ofFn g).prod

/-- The ordered product of root subgroups gives the ordered factorization of the points of
`U(ν)(k)`, for every connected reductive group over a field, maximal split torus and
cocharacter. -/
theorem hasOrderedRootPointFactorization_of_statement
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u}) :
    ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
      (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
      (i : T.toGrp ⟶ G), IsMaximalSplitTorus i → ∀ ν : cocharacterLattice T,
      haveI := hG.isAffineHom
      HasOrderedRootPointFactorization i ν := by
  intro k _ G hG T i hi ν
  have := hG.isAffineHom
  intro n a hinj hrange x hx
  obtain ⟨U, jU, H, j, e, hU, -, -, -, -, -, hH, he⟩ :=
    hprod k G hG T i hi ν n a hinj hrange
  exact exists_orderedRootPoints hU (fun r => (hH r).1) he hx

variable {i : T.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom] {ν : cocharacterLattice T}

/-- **`HasSimpleRootParabolicFactorization` from the ordered root product.** For a generic
cocharacter, negation-stable finitely many roots, linearly independent simple roots, the minimal
endpoint identity `P_∅(k) = P(ν)(k)`, the generic centralizer identity `Z(ν) = Z_G(T)` and ordered
factorizations of the points of `U(ν)(k)` along every enumeration of the indivisible positive
roots, the factorization `HasSimpleRootParabolicFactorization i ν` holds. -/
theorem hasSimpleRootParabolicFactorization_of_orderedRootPoints
    (hν : IsGenericCocharacter i ν)
    (hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i)
    (hli : LinearIndependent ℚ
      (fun α : simpleRelativeRoots i ν => toRat (α : characterLattice T)))
    (hfin : (relativeRoots i).Finite)
    (hB : standardParabolicPoints i ν ∅ =
      (Dynamic.parabolic (CommGroupScheme.groupHom ν ≫ i)).carrier (Over.mk (𝟙 _)))
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) = torusCentralizer i)
    (hprod : HasOrderedRootPointFactorization i ν) :
    HasSimpleRootParabolicFactorization i ν := by
  intro a ha s hs b hb
  have haI := simpleRelativeRoot_mem_indivisiblePositiveRoots hli ha
  obtain ⟨n, e0, hinj, hrange⟩ :=
    RelativeRoot.exists_fin_enumeration_indivisiblePositiveRoots i ν hfin
  obtain ⟨r₀, hr₀⟩ : a ∈ Set.range e0 := by rw [hrange]; exact haI
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by have := r₀.pos; omega⟩
  -- enumerate with `a` last
  let e1 : Fin (m + 1) → characterLattice T := e0 ∘ Equiv.swap r₀ (Fin.last m)
  have hinj1 : Function.Injective e1 := hinj.comp (Equiv.injective _)
  have hrange1 : Set.range e1 = RelativeRoot.indivisiblePositiveRoots i ν := by
    rw [← hrange]
    exact EquivLike.range_comp e0 (Equiv.swap r₀ (Fin.last m))
  have hlast : e1 (Fin.last m) = a := by
    simp only [e1, Function.comp_apply, Equiv.swap_apply_right, hr₀]
  -- the Levi decomposition `b = z * v`
  rw [hB] at hb
  obtain ⟨z, hl⟩ := Dynamic.exists_hasLimit _ hb
  have hz : z ∈ (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).carrier _ :=
    hl.mem_centralizer _
  have hv : z⁻¹ * b ∈ (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i)).carrier _ := by
    have h := ((Dynamic.hasLimit_of_mem_centralizer _ hz).inv _).mul _ hl
    rwa [inv_mul_cancel] at h
  have hzC : z ∈ centralizerPoints i := by
    rw [hZ, torusCentralizer_carrier_base] at hz
    exact hz
  -- the ordered factorization `v = v' * u`
  obtain ⟨g, hg, hgv⟩ := hprod (m + 1) e1 hinj1 hrange1 _ hv
  rw [List.ofFn_succ', List.prod_concat] at hgv
  refine ⟨z * (List.ofFn fun r : Fin m => g r.castSucc).prod, ?_, g (Fin.last m), ?_, ?_⟩
  · intro n' hn'
    have hs' : IsRelativeReflection i a (QuotientGroup.mk n') := by
      rw [← hn'] at hs
      exact hs
    have h1 : (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) * z *
        (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)⁻¹ ∈
          standardParabolicPoints i ν ∅ := by
      rw [hB]
      refine Dynamic.centralizer_le_parabolic _ _ ?_
      have hc := conj_mem_centralizerPoints i n'.2 hzC
      rw [← torusCentralizer_carrier_base] at hc
      rw [hZ]
      exact hc
    have h2 : (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) *
        (List.ofFn fun r : Fin m => g r.castSucc).prod *
          (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)⁻¹ ∈
          standardParabolicPoints i ν ∅ := by
      rw [hB]
      refine Dynamic.unipotent_le_parabolic _ _ ?_
      rw [← MulAut.conj_apply, map_list_prod]
      refine list_prod_mem fun x hx => ?_
      rw [List.mem_map] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      rw [List.mem_ofFn] at hy
      obtain ⟨r, rfl⟩ := hy
      rw [MulAut.conj_apply]
      have hc := RelativeRoot.normalizer_conj_mem i _ n' (hg r.castSucc)
      simp only [GroupScheme.constantPoint_self] at hc
      refine RelativeRoot.subgroup_le_dynamicUnipotent i ν ?_ _ hc
      refine pairing_weylAction_pos_of_isRelativeReflection hν hneg hli ha n' hs' ?_ ?_
      · rw [← hrange1]
        exact ⟨_, rfl⟩
      · rw [← hlast]
        exact fun h => (Fin.castSucc_lt_last r).ne (hinj1 h)
    have h3 := (standardParabolicPoints i ν ∅).mul_mem h1 h2
    have heq : (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) *
        (z * (List.ofFn fun r : Fin m => g r.castSucc).prod) *
          (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)⁻¹ =
        (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) * z *
          (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)⁻¹ *
        ((n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) *
          (List.ofFn fun r : Fin m => g r.castSucc).prod *
            (n' : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)⁻¹) := by
      group
    rw [heq]
    exact h3
  · rw [← hlast]
    exact hg (Fin.last m)
  · calc b = z * (z⁻¹ * b) := by group
      _ = _ := by rw [hgv, mul_assoc]

/-- **`HasSimpleRootParabolicFactorization` from the published structural statements.** The
relative root system, the standard parabolic endpoints, generic centralizers and the ordered
product of root subgroups give `HasSimpleRootParabolicFactorization i ν` for every connected
reductive group over a field, maximal split torus `i` and generic cocharacter `ν`. -/
theorem hasSimpleRootParabolicFactorization_of_statements
    (hroot : RelativeRootSystemStatement.{u}) (hE : StandardParabolicEndpointsStatement.{u})
    (hZ : GenericCentralizerStatement.{u})
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u}) :
    ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
      (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
      (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice T),
      haveI := hG.isAffineHom
      haveI := hi.isSplitSubtorus.mono
      IsGenericCocharacter i ν → HasSimpleRootParabolicFactorization i ν := by
  intro k _ G hG T i hi ν
  have := hG.isAffineHom
  have := hi.isSplitSubtorus.mono
  intro hν
  have hT : IsSplitTorus T.toGrp := hi.isSplitSubtorus.1
  have hR : HasRelativeRootSystem i := hroot k G hG T i hi
  have hB : standardParabolicPoints i ν ∅ =
      (Dynamic.parabolic (CommGroupScheme.groupHom ν ≫ i)).carrier
        (Over.mk (𝟙 (Spec (CommRingCat.of k)))) := by
    rw [standardParabolicPoints, (hE k G hG T i hi ν hν).1]
  exact hasSimpleRootParabolicFactorization_of_orderedRootPoints hν
    (fun _ hα => hR.neg_mem_relativeRoots i hT hα)
    (hR.linearIndependent_simpleRelativeRoots i ν hT hν) (hR.finite_relativeRoots i hT) hB
    (hZ k G hG T i hi ν hν) (hasOrderedRootPointFactorization_of_statement hprod k G hG T i hi ν)

/-- **Reduction of the relative Tits system to the published structural statements and
nondegeneracy.** -/
theorem relativeTitsSystemStatement_of_rootProduct
    (hcox : RelativeWeylCoxeterStatement.{u}) (hE : StandardParabolicEndpointsStatement.{u})
    (hBr : RationalBruhatStatement.{u}) (hrank : RootRankOneFactorizationStatement.{u})
    (hroot : RelativeRootSystemStatement.{u}) (hZ : GenericCentralizerStatement.{u})
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (hconj : ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
      (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
      (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice T),
      haveI := hG.isAffineHom
      haveI := hi.isSplitSubtorus.mono
      IsGenericCocharacter i ν →
        ∀ s ∈ simpleRelativeReflections i ν, ∀ n : normalizerPoints i,
          QuotientGroup.mk' ((centralizerPoints i).subgroupOf (normalizerPoints i)) n = s →
          ∃ b ∈ standardParabolicPoints i ν ∅,
            (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) * b *
              (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)⁻¹ ∉
                standardParabolicPoints i ν ∅) :
    RelativeTitsSystemStatement.{u} :=
  relativeTitsSystemStatement_of_rankOneFactorization hcox hE hBr hrank
    (hasSimpleRootParabolicFactorization_of_statements hroot hE hZ hprod) hconj

/-- **The relative Tits system from the published structural statements.** The nondegeneracy
field `conj_not_le` comes from nonidentity rational points of the simple-root subgroups
(`RelativeSimpleRootPointData.of_rootSubgroup_statements`), which the root-subgroup realization
and vector statements supply. -/
theorem relativeTitsSystemStatement_of_structuralStatements
    (hcox : RelativeWeylCoxeterStatement.{u}) (hE : StandardParabolicEndpointsStatement.{u})
    (hBr : RationalBruhatStatement.{u}) (hrank : RootRankOneFactorizationStatement.{u})
    (hroot : RelativeRootSystemStatement.{u}) (hZ : GenericCentralizerStatement.{u})
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (hReal : RelativeRoot.RootSubgroupRealizationStatement.{u})
    (hVec : RelativeRoot.RootSubgroupVectorStatement.{u}) :
    RelativeTitsSystemStatement.{u} :=
  relativeTitsSystemStatement_of_rootProduct hcox hE hBr hrank hroot hZ hprod
    fun k _ G hG T i hi ν _ =>
      haveI := hG.isAffineHom
      haveI := hi.isSplitSubtorus.mono
      (RelativeSimpleRootPointData.of_rootSubgroup_statements i hReal hVec
        (hroot k G hG T i hi) hG hi ν).conj_not_le i ν hi.isSplitSubtorus.1

end Langlands.GroupScheme
