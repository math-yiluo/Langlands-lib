import Langlands.GroupScheme.Rational.AugmentedTensor
import Mathlib.Order.SupIndep

/-! # Degree support for tensor products of augmentation kernels -/

noncomputable section

universe u v w t s

open scoped TensorProduct

namespace Langlands.GroupScheme.RelativeRoot.AugmentedTensor

variable {k : Type u} [CommRing k] {Γ : Type s}

/-- The submodule generated by homogeneous spaces with degree in a given set. -/
def degreeSpan {M : Type*} [AddCommGroup M] [Module k M]
    (U : Γ → Submodule k M) (P : Set Γ) : Submodule k M :=
  ⨆ γ ∈ P, U γ

theorem degreeSpan_mono {M : Type*} [AddCommGroup M] [Module k M]
    (U : Γ → Submodule k M) {P Q : Set Γ} (h : P ⊆ Q) :
    degreeSpan U P ≤ degreeSpan U Q :=
  iSup_le fun γ => iSup_le fun hγ =>
    le_iSup_of_le γ (le_iSup_of_le (h hγ) le_rfl)

/-- An independent homogeneous family cannot have a nonzero element of a
degree in the span of the spaces indexed by the other degrees. -/
theorem degree_mem_of_nonzero {M : Type*} [AddCommGroup M] [Module k M]
    {U : Γ → Submodule k M} (hU : iSupIndep U) {P : Set Γ}
    {γ : Γ} {x : M} (hx : x ≠ 0) (hγ : x ∈ U γ) (hP : x ∈ degreeSpan U P) :
    γ ∈ P := by
  by_contra h
  exact hx (Submodule.disjoint_def.mp (hU.disjoint_biSup h) x hγ hP)

variable {A : Type v} [CommRing A] [Algebra k A]
  {B : Type w} [CommRing B] [Algebra k B]

/-- Bilinear images distribute over the selected homogeneous spaces in each
factor, with one selected degree from each factor. -/
theorem map₂_degreeSpan {M : Type*} [AddCommGroup M] [Module k M]
    (f : A →ₗ[k] B →ₗ[k] M) (U : Γ → Submodule k A)
    (V : Γ → Submodule k B) (P Q : Set Γ) :
    Submodule.map₂ f (degreeSpan U P) (degreeSpan V Q) =
      ⨆ α ∈ P, ⨆ β ∈ Q, Submodule.map₂ f (U α) (V β) := by
  simp only [degreeSpan]
  simp_rw [Submodule.map₂_iSup_left]
  simp_rw [Submodule.map₂_iSup_right]

variable [Add Γ]

/-- If homogeneous pure tensors add degrees, the tensor of two augmentation
kernels is supported on the literal sums of their supporting degrees. -/
theorem tensor_kernels_le_sum_degreeSpan
    (εA : A →ₐ[k] k) (εB : B →ₐ[k] k)
    (U : Γ → Submodule k A) (V : Γ → Submodule k B)
    (W : Γ → Submodule k (A ⊗[k] B)) (P Q : Set Γ)
    (hA : LinearMap.ker εA.toLinearMap ≤ degreeSpan U P)
    (hB : LinearMap.ker εB.toLinearMap ≤ degreeSpan V Q)
    (htensor : ∀ α β,
      Submodule.map₂ (TensorProduct.mk k A B) (U α) (V β) ≤ W (α + β)) :
    LinearMap.range (TensorProduct.mapIncl
      (LinearMap.ker εA.toLinearMap) (LinearMap.ker εB.toLinearMap)) ≤
      degreeSpan W (Set.image2 (· + ·) P Q) := by
  rw [TensorProduct.range_mapIncl]
  calc
    Submodule.map₂ (TensorProduct.mk k A B)
        (LinearMap.ker εA.toLinearMap) (LinearMap.ker εB.toLinearMap) ≤
        Submodule.map₂ (TensorProduct.mk k A B) (degreeSpan U P) (degreeSpan V Q) :=
      Submodule.map₂_le_map₂ hA hB
    _ = ⨆ α ∈ P, ⨆ β ∈ Q,
        Submodule.map₂ (TensorProduct.mk k A B) (U α) (V β) :=
      map₂_degreeSpan _ U V P Q
    _ ≤ degreeSpan W (Set.image2 (· + ·) P Q) := by
      refine iSup_le fun α => iSup_le fun hα =>
        iSup_le fun β => iSup_le fun hβ => ?_
      exact (htensor α β).trans
        (le_iSup_of_le (α + β)
          (le_iSup_of_le (show α + β ∈ Set.image2 (· + ·) P Q from
            ⟨α, hα, β, hβ, rfl⟩) le_rfl))

/-- Both identity-slice kernels satisfy the same literal degree-sum bound. -/
theorem identity_slice_kernels_le_sum_degreeSpan
    (εA : A →ₐ[k] k) (εB : B →ₐ[k] k)
    (U : Γ → Submodule k A) (V : Γ → Submodule k B)
    (W : Γ → Submodule k (A ⊗[k] B)) (P Q : Set Γ)
    (hA : LinearMap.ker εA.toLinearMap ≤ degreeSpan U P)
    (hB : LinearMap.ker εB.toLinearMap ≤ degreeSpan V Q)
    (htensor : ∀ α β,
      Submodule.map₂ (TensorProduct.mk k A B) (U α) (V β) ≤ W (α + β)) :
    LinearMap.ker (leftIdentitySlice εA B).toLinearMap ⊓
        LinearMap.ker (rightIdentitySlice A εB).toLinearMap ≤
      degreeSpan W (Set.image2 (· + ·) P Q) := by
  rw [ker_leftIdentitySlice_inf_ker_rightIdentitySlice]
  exact tensor_kernels_le_sum_degreeSpan εA εB U V W P Q hA hB htensor

variable {C : Type t} [CommRing C] [Algebra k C]

/-- An injective algebra pullback constant on both identity slices has the
literal sum bound on every nonzero homogeneous augmentation element. The
grading and its compatibility with the pullback remain explicit hypotheses. -/
theorem degree_mem_sum_of_injective_constant_slices
    (εA : A →ₐ[k] k) (εB : B →ₐ[k] k) (εC : C →ₐ[k] k)
    (φ : C →ₐ[k] A ⊗[k] B) (hφ : Function.Injective φ)
    (hleft : (leftIdentitySlice εA B).comp φ = (Algebra.ofId k B).comp εC)
    (hright : (rightIdentitySlice A εB).comp φ = (Algebra.ofId k A).comp εC)
    (U : Γ → Submodule k A) (V : Γ → Submodule k B)
    (W : Γ → Submodule k (A ⊗[k] B)) (P Q : Set Γ)
    (hA : LinearMap.ker εA.toLinearMap ≤ degreeSpan U P)
    (hB : LinearMap.ker εB.toLinearMap ≤ degreeSpan V Q)
    (htensor : ∀ α β,
      Submodule.map₂ (TensorProduct.mk k A B) (U α) (V β) ≤ W (α + β))
    (hW : iSupIndep W) {γ : Γ} {c : C}
    (hc : εC c = 0) (hc0 : c ≠ 0) (hγ : φ c ∈ W γ) :
    γ ∈ Set.image2 (· + ·) P Q := by
  have hnonzero : φ c ≠ 0 := by
    intro h
    exact hc0 (hφ (h.trans (map_zero φ).symm))
  apply degree_mem_of_nonzero hW hnonzero hγ
  apply tensor_kernels_le_sum_degreeSpan εA εB U V W P Q hA hB htensor
  exact map_augmentationKernel_mem_tensor εA εB εC φ hleft hright hc

end Langlands.GroupScheme.RelativeRoot.AugmentedTensor
