import Langlands.GroupScheme.Rational.MaximalSplitSubgroupLines
import Langlands.GroupScheme.Rational.MaximalSplitGeneratedMultiplicity
import Langlands.GroupScheme.GeneratedFamily
import Langlands.GroupScheme.Torus.SplitReductiveProof
import Langlands.GroupScheme.Rational.RootFactorPairTransport
import Langlands.GroupScheme.Rational.LeviFactorization
import Langlands.GroupScheme.Cartan.Induction

/-! # The subgroup generated by a maximal split torus and rank-one line pairs -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false

namespace Langlands.GroupScheme.MaximalSplitSubgroup

open LocalSplitCell (rootPoint)

section Family

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {S : CommGroupScheme (Spec (CommRingCat.of k))}

/-- The sources of the generating family: the torus at `none` and a copy of `Ga` at each
`some (b, d)`, for the positive (`b = true`) and negative (`b = false`) line at `d`. -/
def lineFamilySource (S : CommGroupScheme (Spec (CommRingCat.of k))) (Idx : Type*) :
    Option (Bool × Idx) → GroupScheme (Spec (CommRingCat.of k))
  | none => S.toGrp
  | some _ => RootCell.Ga k

/-- The generating family: the torus embedding at `none`, the line `x d` at `some (true, d)`
and the line `y d` at `some (false, d)`. -/
def lineFamily {Idx : Type*} (i : S.toGrp ⟶ G) (x y : Idx → (RootCell.Ga k ⟶ G)) :
    ∀ o, lineFamilySource S Idx o ⟶ G
  | none => i
  | some (true, d) => x d
  | some (false, d) => y d

/-- Every source of the generating family is smooth, affine and connected. -/
theorem lineFamilySource_smooth_affine_connected (hT : IsSplitTorus S.toGrp) {Idx : Type*}
    (o : Option (Bool × Idx)) :
    Smooth (lineFamilySource S Idx o).X.hom ∧ IsAffineHom (lineFamilySource S Idx o).X.hom ∧
      ConnectedSpace (lineFamilySource S Idx o).X.left := by
  rcases o with _ | _
  · exact ⟨hT.smooth, hT.isAffineHom, hT.connectedSpace⟩
  · exact ⟨smooth_ga, isAffineHom_ga, connectedSpace_ga⟩

end Family

section Reflect

variable {k : Type u} [Field k] {G F : GroupScheme (Spec (CommRingCat.of k))}
  {S : CommGroupScheme (Spec (CommRingCat.of k))}

/-- A monomorphic homomorphism reflects torus equivariance of a line. -/
theorem isTorusEquivariant_of_comp (j : F ⟶ G) [Mono j.hom.hom] {f : S.toGrp ⟶ F}
    {x : RootCell.Ga k ⟶ F} {α : characterLattice S}
    (h : VectorGroup.IsTorusEquivariant (f ≫ j) (x ≫ j) α) :
    VectorGroup.IsTorusEquivariant f x α := by
  intro Z t c
  apply (‹Mono j.hom.hom›).right_cancellation
  have h' := h Z t c
  simp only [MonObj.mul_comp, GrpObj.inv_comp, Grp.comp_hom_hom, Category.assoc] at h' ⊢
  exact h'

/-- A monomorphic homomorphism reflects the rank-one relation. -/
theorem relationOver_of_comp (j : F ⟶ G) [Mono j.hom.hom] {f : S.toGrp ⟶ F}
    {ν : cocharacterLattice S} {x y : RootCell.Ga k ⟶ F} {Z : Over (Spec (CommRingCat.of k))}
    (h : RootCell.RelationOver (f ≫ j) ν (x ≫ j) (y ≫ j) Z) :
    RootCell.RelationOver f ν x y Z := by
  intro a b a' b' u hu ha' hb'
  have h' := h a b a' b' u hu ha' hb'
  unfold RootCell.RelationAt at h' ⊢
  apply (‹Mono j.hom.hom›).right_cancellation
  simp only [MonObj.mul_comp, Grp.comp_hom_hom, Category.assoc] at h' ⊢
  exact h'

/-- A monomorphic homomorphism reflects commutation of points. -/
theorem commute_of_comp (j : F ⟶ G) [Mono j.hom.hom] {Z : Over (Spec (CommRingCat.of k))}
    {g h : Z ⟶ F.X} (hc : Commute (g ≫ j.hom.hom) (h ≫ j.hom.hom)) : Commute g h := by
  change g * h = h * g
  apply (‹Mono j.hom.hom›).right_cancellation
  rw [MonObj.mul_comp, MonObj.mul_comp]
  exact hc.eq

end Reflect

section Generated

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {S : CommGroupScheme (Spec (CommRingCat.of k))}

/-- **The generated subgroup with its lifted line pairs.** Let `i` be a maximal split torus of
a connected reductive group `G` and `a` a family of nonmultipliable relative roots such that no
`n a d - m a e` (`d ≠ e`, `n, m > 0`) is zero or a root. Then there are a smooth affine
connected closed subgroup `j : F ⟶ G`, generated by the torus and the line pairs at the `a d`,
a factorization `f ≫ j = i`, and lines `x d`, `y d` of `F` of weights `a d`, `-a d` with
cocharacters `ν d` (`⟨a d, ν d⟩ = 2`) and rational points `n d` of `F` normalizing `f` through
the reflections, satisfying the rank-one relation on every test scheme, such that `x d` and
`y e` commute for `d ≠ e` and `F` is generated by `f` and the lines as its own ambient group.
Finally, each reflection `c ↦ c - ⟨c, ν d⟩ a d` maps roots of `i` to roots of `i`. -/
theorem exists_generated_lineSubgroup (hG : IsConnectedReductive G) (i : S.toGrp ⟶ G)
    (hi : IsMaximalSplitTorus i) {Idx : Type*} (a : Idx → characterLattice S)
    (ha : haveI := hG.isAffineHom; ∀ d, a d ∈ roots i ∧ (2 : ℤ) • a d ∉ roots i)
    (hstrict : haveI := hG.isAffineHom; ∀ d e, d ≠ e → ∀ n m : ℕ, 0 < n → 0 < m →
      n • a d - m • a e ≠ 0 ∧ n • a d - m • a e ∉ roots i) :
    ∃ (F : GroupScheme (Spec (CommRingCat.of k))) (j : F ⟶ G) (f : S.toGrp ⟶ F)
      (x y : Idx → (RootCell.Ga k ⟶ F)) (ν : Idx → cocharacterLattice S)
      (hpair : ∀ d, latticePairing S (a d) (ν d) = 2)
      (n : Idx → (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ F.X)),
      Smooth F.X.hom ∧ IsAffineHom F.X.hom ∧ ConnectedSpace F.X.left ∧
      IsClosedSubgroup j ∧ f ≫ j = i ∧
      IsGeneratedByFamily (lineFamilySource S Idx) (lineFamily f x y) (𝟙 F) ∧
      (∀ d, VectorGroup.IsTorusEquivariant f (x d) (a d)) ∧
      (∀ d, VectorGroup.IsTorusEquivariant f (y d) (-a d)) ∧
      (∀ d, Mono (x d).hom.hom) ∧
      (∀ d, ∀ Z : Over (Spec (CommRingCat.of k)), RootCell.RelationOver f (ν d) (x d) (y d) Z) ∧
      (∀ d, IsNormalizingPoint f (n d) (latticeReflectionIso (a d) (ν d) (hpair d))) ∧
      (∀ d e, d ≠ e → ∀ (Z : Over (Spec (CommRingCat.of k))) (g h : Z ⟶ (RootCell.Ga k).X),
        Commute (g ≫ (x d).hom.hom) (h ≫ (y e).hom.hom)) ∧
      (haveI := hG.isAffineHom
       ∀ d, ∀ c ∈ roots i, c - latticePairing S c (ν d) • a d ∈ roots i) := by
  have := hG.isAffineHom
  have := hG.smooth
  have hT : IsSplitTorus S.toGrp := hi.1.1
  have hpairs := fun d => exists_linePair hG i hi (ha d).1 (ha d).2
  choose xG yG ν hpair nG hx hxm hxr hy hym hyr hn hnorm hrel using hpairs
  obtain ⟨F, j, hFs, hFa, hFc, hgen⟩ := FiniteGeneration.exists_smooth_generated_family
    (A := lineFamilySource S Idx) (a := lineFamily i xG yG)
    (lineFamilySource_smooth_affine_connected hT)
  have : IsClosedImmersion j.hom.hom.left := hgen.1
  have hjm : Mono j.hom.hom := Over.mono_of_mono_left _
  have hjr : (SubgroupFunctor.range j).IsRepresentedBy j := ⟨hjm, rfl⟩
  let b : ∀ o, lineFamilySource S Idx o ⟶ F := fun o =>
    hjr.factorHom (lineFamily i xG yG o)
      ((factorsThrough_hom_iff_range_le _ j).mp (hgen.2.1 o))
  have hb : ∀ o, b o ≫ j = lineFamily i xG yG o := fun o => hjr.factorHom_comp _ _
  let f : S.toGrp ⟶ F := b none
  let x : Idx → (RootCell.Ga k ⟶ F) := fun d => b (some (true, d))
  let y : Idx → (RootCell.Ga k ⟶ F) := fun d => b (some (false, d))
  have hf : f ≫ j = i := hb none
  have hxj : ∀ d, x d ≫ j = xG d := fun d => hb (some (true, d))
  have hyj : ∀ d, y d ≫ j = yG d := fun d => hb (some (false, d))
  have hfam : ∀ o, lineFamily f x y o ≫ j = lineFamily i xG yG o := by
    rintro (_ | ⟨_ | _, d⟩)
    · exact hf
    · exact hyj d
    · exact hxj d
  let n : Idx → (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ F.X) := fun d =>
    rootPoint (y d) (Over.mk (𝟙 _)) (-1) * rootPoint (x d) (Over.mk (𝟙 _)) 1 *
      rootPoint (y d) (Over.mk (𝟙 _)) (-1)
  have hnj : ∀ d, n d ≫ j.hom.hom = nG d := by
    intro d
    rw [hn d, ← hxj d, ← hyj d]
    simp only [n, MonObj.mul_comp, rootPoint, Grp.comp_hom_hom, Category.assoc]
  refine ⟨F, j, f, x, y, ν, hpair, n, hFs, hFa, hFc, hgen.1, hf,
    IsGeneratedByFamily.self hgen (lineFamily f x y) hfam, fun d => ?_, fun d => ?_,
    fun d => ?_, fun d Z => ?_, fun d => ?_, fun d e hde Z g h => ?_,
    fun d c hc => sub_pairing_smul_mem_roots (hnorm d) hc⟩
  · apply isTorusEquivariant_of_comp j
    rw [hf, hxj d]
    exact hx d
  · apply isTorusEquivariant_of_comp j
    rw [hf, hyj d]
    exact hy d
  · have : Mono ((x d).hom.hom ≫ j.hom.hom) := by
      rw [← Grp.comp_hom_hom, hxj d]
      exact hxm d
    exact mono_of_mono _ j.hom.hom
  · apply relationOver_of_comp j
    rw [hf, hxj d, hyj d]
    exact hrel d Z
  · apply IsNormalizingPoint.of_comp j
    rw [hf, hnj d]
    exact hnorm d
  · apply commute_of_comp j
    have hd0 : a d ≠ 0 := (ha d).1.1
    have he0 : a e ≠ 0 := (ha e).1.1
    refine commute_of_root_groups i hT hd0 he0 (hstrict d e hde) ?_ ?_
    · rw [Category.assoc, ← Grp.comp_hom_hom, hxj d]
      exact hxr d Z (SubgroupFunctor.mem_range.mpr ⟨g, rfl⟩)
    · rw [Category.assoc, ← Grp.comp_hom_hom, hyj e]
      exact hyr e Z (SubgroupFunctor.mem_range.mpr ⟨h, rfl⟩)

end Generated

end Langlands.GroupScheme.MaximalSplitSubgroup
