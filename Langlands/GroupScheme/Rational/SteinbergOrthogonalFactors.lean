import Langlands.GroupScheme.Rational.OrthogonalSimpleRootCommutation
import Langlands.GroupScheme.Rational.SteinbergOrbitImageDescent

/-! # Commutation of actual Steinberg factors for orthogonal simple roots -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000
set_option autoImplicit false

private theorem comp_mem_sup {S : Scheme.{u}} {G : GroupScheme S}
    (F H : SubgroupFunctor G) {T W : Over S} (f : W ⟶ T) {g : T ⟶ G.X}
    (hg : g ∈ F.carrier T ⊔ H.carrier T) :
    f ≫ g ∈ F.carrier W ⊔ H.carrier W := by
  let φ : (T ⟶ G.X) →* (W ⟶ G.X) :=
    { toFun := fun z => f ≫ z
      map_one' := MonObj.comp_one f
      map_mul' := fun z w => MonObj.comp_mul f z w }
  have h : F.carrier T ⊔ H.carrier T ≤
      (F.carrier W ⊔ H.carrier W).comap φ :=
    sup_le
      (fun z hz => Subgroup.mem_sup_left (F.comp_mem f hz))
      (fun z hz => Subgroup.mem_sup_right (H.comp_mem f hz))
  exact h hg

namespace SplitPinning

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (p : SplitPinning G)

/-- Each supplied reflection representative belongs to the rational point
subgroup generated by its positive and negative simple-root groups. -/
def RootGeneratedSimpleReflectionRepresentatives
    (n : p.SimpleReflectionRepresentatives) : Prop :=
  ∀ a : p.base.support,
    (n a).point ∈
      (RelativeRoot.subgroup p.inclusion (p.rootDatum.root a)).carrier (Over.mk (𝟙 _)) ⊔
        (RelativeRoot.subgroup p.inclusion (-(p.rootDatum.root a))).carrier (Over.mk (𝟙 _))

/-- A normalized root value times a root-generated representative remains
in the corresponding generated point subgroup on every test scheme. -/
theorem rootFactor_mem_generated
    (x : p.NormalizedSimpleRootParametrizations)
    (n : p.SimpleReflectionRepresentatives)
    (hn : p.RootGeneratedSimpleReflectionRepresentatives n)
    (a : p.base.support) (T : Over (Spec (CommRingCat.of k))) (c : Γ(T.left, ⊤)) :
    (x a).point T c * (toUnit T ≫ (n a).point) ∈
      (RelativeRoot.subgroup p.inclusion (p.rootDatum.root a)).carrier T ⊔
        (RelativeRoot.subgroup p.inclusion (-(p.rootDatum.root a))).carrier T := by
  apply Subgroup.mul_mem
  · exact Subgroup.mem_sup_left (((x a).mem_rootSubgroup_iff T _).mpr ⟨c, rfl⟩)
  · exact comp_mem_sup _ _ (toUnit T) (hn a)

/-- Actual root-and-representative factors for distinct orthogonal simple
roots commute on every test, provided the representatives are root-generated. -/
theorem commute_rootFactors
    (x : p.NormalizedSimpleRootParametrizations)
    (n : p.SimpleReflectionRepresentatives)
    (hn : p.RootGeneratedSimpleReflectionRepresentatives n)
    (a b : p.base.support) (hab : a ≠ b) (ho : p.rootDatum.IsOrthogonal a b)
    (T : Over (Spec (CommRingCat.of k))) (c d : Γ(T.left, ⊤)) :
    Commute ((x a).point T c * (toUnit T ≫ (n a).point))
      ((x b).point T d * (toUnit T ≫ (n b).point)) :=
  orthogonalSimpleRootCommutation k G p a b hab ho T _ _
    (p.rootFactor_mem_generated x n hn a T c)
    (p.rootFactor_mem_generated x n hn b T d)

end SplitPinning

namespace SteinbergOrbitImageDescent

variable (k K : Type u) [Field k] [Field K] [Algebra k K]
    (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom]

local notation "GK" => Functor.obj (GroupScheme.baseChange (algebraBaseMap k K)) G

local instance : IsAffineHom (GK).X.hom := by
  change IsAffineHom (pullback.snd G.X.hom (algebraBaseMap k K))
  infer_instance

variable (p : Langlands.GroupScheme.SplitPinning
    ((GroupScheme.baseChange (algebraBaseMap k K)).obj G))
    {r : ℕ} (I : Type u) (d : Fin r ≃ I)
    (e : Fin r ≃ p.base.support)
    (x : p.NormalizedSimpleRootParametrizations)
    (n : p.SimpleReflectionRepresentatives)
    (hn : p.RootGeneratedSimpleReflectionRepresentatives n)

local notation "R" => MvPolynomial I K

include hn

/-- The actual renamed factor belongs to its generated root subgroup
on the polynomial test over the splitting field. -/
theorem factorK_mem_generated (i : I) :
    factorK k K G p I d e x n i ∈
      (RelativeRoot.subgroup p.inclusion
        (p.rootDatum.root (e (d.symm i)))).carrier
          ((algSpec (CommRingCat.of K)).obj (op (CommAlgCat.of K R))) ⊔
      (RelativeRoot.subgroup p.inclusion
        (-(p.rootDatum.root (e (d.symm i))))).carrier
          ((algSpec (CommRingCat.of K)).obj (op (CommAlgCat.of K R))) := by
  exact comp_mem_sup _ _ (coordinateTestIso K I d).hom
    (p.rootFactor_mem_generated x n hn (e (d.symm i)) _
      (VectorGroup.coordinateSection (CommRingCat.of K) r (d.symm i)))

/-- Orthogonality gives commutation of the actual polynomial-valued
factors in the original group, after the multiplicative base-change comparison. -/
theorem commute_factors (i j : I) (hij : i ≠ j)
    (ho : p.rootDatum.IsOrthogonal (e (d.symm i)) (e (d.symm j))) :
    Commute (factor k K G p I d e x n i) (factor k K G p I d e x n j) := by
  have hab : e (d.symm i) ≠ e (d.symm j) := by
    intro h
    exact hij (d.symm.injective (e.injective h))
  exact (orthogonalSimpleRootCommutation K GK p _ _ hab ho _ _ _
    (factorK_mem_generated k K G p I d e x n hn i)
    (factorK_mem_generated k K G p I d e x n hn j)).map
      (Lie.affineBaseChangeEquiv k K G R)

/-- A pairwise distinct orthogonal coordinate block has pairwise commuting
actual Steinberg factors. -/
theorem pairwise_factors (l : List I)
    (ho : l.Pairwise (fun i j =>
      i ≠ j ∧ p.rootDatum.IsOrthogonal (e (d.symm i)) (e (d.symm j)))) :
    (l.map (factor k K G p I d e x n)).Pairwise Commute := by
  rw [List.pairwise_map]
  exact ho.imp (fun h => commute_factors k K G p I d e x n hn _ _ h.1 h.2)

/-- Image-ideal descent for the actual Steinberg morphism with the
within-block commutation premise proved from root-generated representatives
and distinct orthogonal coordinate blocks. Factor transport remains explicit. -/
def definingIdealDescent_of_orthogonal [IsGalois k K]
    (ρ : (K ≃ₐ[k] K) →* Equiv.Perm I) (blocks : List (List I))
    (horder : blocks.flatten = List.ofFn d)
    (hblocks : ∀ (σ : K ≃ₐ[k] K) l, l ∈ blocks → (l.map (ρ σ)).Perm l)
    (horth : ∀ l, l ∈ blocks → l.Pairwise (fun i j =>
      i ≠ j ∧ p.rootDatum.IsOrthogonal (e (d.symm i)) (e (d.symm j))))
    (hf : ∀ (σ : K ≃ₐ[k] K) i,
      Lie.affineMap G (PolynomialGalois.orbitAction k K I ρ σ)
          (factor k K G p I d e x n i) = factor k K G p I d e x n (ρ σ i)) :
    DefiningIdealDescent (pullback.fst G.X.hom (algebraBaseMap k K))
      (SplitPinning.steinbergProduct e x n).left.ker :=
  definingIdealDescent k K G p I d e x n ρ blocks horder hblocks
    (fun l hl => pairwise_factors k K G p I d e x n hn l (horth l hl)) hf

end SteinbergOrbitImageDescent

end Langlands.GroupScheme
