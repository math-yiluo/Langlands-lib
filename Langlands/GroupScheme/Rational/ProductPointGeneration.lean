import Langlands.GroupScheme.FiniteEtaleSum
import Langlands.GroupScheme.Rational.Characters

/-! # Rational points of a commutative target generated through a finite product -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry CategoryTheory.Limits
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.ProductGeneration

open FiniteEtaleSum

section Component

variable {k : Type u} [CommRing k] {J : Type*}
    {Qi : J → GroupScheme (Spec (CommRingCat.of k))} {Q : GroupScheme (Spec (CommRingCat.of k))}

/-- The subgroup of `Q(k)` generated by the images of all `Q_i(k)`. -/
abbrev componentPoints (φ : ∀ i, Qi i ⟶ Q) : Subgroup (rationalPoints Q) :=
  Subgroup.closure (⋃ i, ((rationalPoints.map (φ i)).range : Set (rationalPoints Q)))

end Component

variable {k : Type u} [CommRing k] {J : Type u} [Fintype J]
    {Qi : J → GroupScheme (Spec (CommRingCat.of k))} {Q : GroupScheme (Spec (CommRingCat.of k))}
    [IsCommMonObj Q.X] (φ : ∀ i, Qi i ⟶ Q)

/-- On rational points the coordinatewise product map `∏ Q_i → Q` is the product
of the component images. -/
theorem rationalPoints_map_sumMap (x : rationalPoints (pi Qi)) :
    rationalPoints.map (sumMap φ) x =
      ∏ i, rationalPoints.map (φ i) (piPointsEquiv Qi _ x i) := by
  let e : (pi Qi ⟶ Q) →* ((pi Qi).X ⟶ Q.X) :=
    { toFun := fun f => f.hom.hom, map_one' := rfl, map_mul' := fun _ _ => rfl }
  let c : ((pi Qi).X ⟶ Q.X) →* (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ Q.X) :=
    ((yonedaMon.obj (.mk Q.X)).map (Quiver.Hom.op x)).hom
  have h : rationalPoints.map (sumMap φ) x = c (e (sumMap φ)) := rfl
  rw [h, sumMap, map_prod, map_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  change x ≫ (Pi.π Qi i ≫ φ i).hom.hom = (x ≫ (Pi.π Qi i).hom.hom) ≫ (φ i).hom.hom
  simp [Category.assoc]

/-- The rational points in the image of `∏ Q_i → Q` are exactly the subgroup
generated by the images of the `Q_i(k)`. -/
theorem range_map_sumMap :
    (rationalPoints.map (sumMap φ)).range = componentPoints φ := by
  classical
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    rw [rationalPoints_map_sumMap]
    exact Subgroup.prod_mem _ fun i _ =>
      Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, _, rfl⟩)
  · rw [Subgroup.closure_le]
    intro y hy
    obtain ⟨i, z, rfl⟩ := Set.mem_iUnion.mp hy
    refine ⟨(piPointsEquiv Qi _).symm (Pi.mulSingle i z), ?_⟩
    rw [rationalPoints_map_sumMap, MulEquiv.apply_symm_apply,
      Finset.prod_eq_single i (fun j _ hji => by simp [Pi.mulSingle_eq_of_ne hji])
        (fun hi => absurd (Finset.mem_univ i) hi)]
    simp

/-- The coordinatewise product map is surjective on rational points exactly when
the images of the `Q_i(k)` generate `Q(k)`. -/
theorem surjective_map_sumMap_iff :
    Function.Surjective (rationalPoints.map (sumMap φ)) ↔ componentPoints φ = ⊤ := by
  rw [← range_map_sumMap, MonoidHom.range_eq_top]

/-- If the coordinatewise product map `∏ Q_i → Q` is an isomorphism, the images of
the `Q_i(k)` generate `Q(k)`. -/
theorem componentPoints_eq_top_of_isIso [IsIso (sumMap φ)] : componentPoints φ = ⊤ := by
  refine (surjective_map_sumMap_iff φ).mp fun y => ⟨rationalPoints.map (inv (sumMap φ)) y, ?_⟩
  simp only [rationalPoints.map_apply, Category.assoc, ← Grp.comp_hom_hom, IsIso.inv_hom_id]
  rfl

/-- If the coordinatewise product map is surjective on rational points, the image
of any rational-point map into `Q` lies in the subgroup generated by the images of
the `Q_i(k)`. -/
theorem range_le_componentPoints_of_surjective
    (hsurj : Function.Surjective (rationalPoints.map (sumMap φ)))
    {M : GroupScheme (Spec (CommRingCat.of k))} (q : M ⟶ Q) :
    (rationalPoints.map q).range ≤ componentPoints φ := by
  rw [(surjective_map_sumMap_iff φ).mp hsurj]
  exact le_top

/-- If the coordinatewise product map is an isomorphism, the image of any
rational-point map into `Q` lies in the subgroup generated by the images of the
`Q_i(k)`. -/
theorem range_le_componentPoints_of_isIso [IsIso (sumMap φ)]
    {M : GroupScheme (Spec (CommRingCat.of k))} (q : M ⟶ Q) :
    (rationalPoints.map q).range ≤ componentPoints φ := by
  rw [componentPoints_eq_top_of_isIso φ]
  exact le_top

end Langlands.GroupScheme.ProductGeneration
