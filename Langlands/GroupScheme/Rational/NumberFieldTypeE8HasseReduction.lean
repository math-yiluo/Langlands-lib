import Langlands.GroupScheme.Rational.NumberFieldHasseKernelTypeReduction
import Langlands.GroupScheme.Rational.QuasiSplitSplittingReduction
import Langlands.GroupScheme.Reductive.TitsIndexSeparableScalarExtension
import Langlands.GroupScheme.Reductive.GeometricSimplyConnected
import Langlands.GroupScheme.Reductive.QuasiSplit
import Mathlib.NumberTheory.NumberField.InfinitePlace.TotallyRealComplex
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.Algebra.Polynomial.SpecificDegree

/-! # The Hasse kernel in type `E_8`: totally complex fields and the real places

This module states two theorems on simply connected absolutely almost-simple groups
of type `E_8` over number fields and proves that together they give
`NumberFieldTypeE8HasseStatement`.

* `NumberFieldTotallyComplexTypeE8Statement`: over a totally complex number field
  such a group is quasi-split and all its cocycles on finite Galois field covers are
  trivial (Chernousov; Platonov–Rapinchuk, §6.8).
* `NumberFieldTypeE8QuadraticSplittingHasseStatement`: if a totally complex quadratic
  extension `L` of `F` makes the group quasi-split with trivial finite-Galois
  cohomology, then its Hasse kernel over `F` is trivial (Platonov–Rapinchuk, §6.8,
  printed p. 386, with Lemmas 6.17 and 6.28).

The two statements are not proved here.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Polynomial

namespace Langlands.GroupScheme

/-- Chernousov's theorem in the form used for the Hasse principle: over a totally
complex number field `K`, a simply connected absolutely almost-simple group of type
`E_8` is quasi-split, and every cocycle of it on a finite Galois field cover of `K`
is trivial. -/
def NumberFieldTotallyComplexTypeE8Statement : Prop :=
  ∀ (K : Type u) [Field K] [NumberField K] [NumberField.IsTotallyComplex K]
    (G : GroupScheme (Spec (CommRingCat.of K))) [IsAffineHom G.X.hom]
    [LocallyOfFiniteType G.X.hom] (d : TitsIndexData G) (e : d.Vertex ≃ Fin 8),
    IsSimplyConnected G → IsAbsolutelyAlmostSimple G →
    (∀ a b, d.cartan a b = CartanMatrix.E 8 (e a) (e b)) →
    IsQuasiSplit G ∧
      ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
        (ξ : Cocycle G (GaloisCocycle.cover K L)), ξ.IsTrivial

/-- The real-place step of the Hasse principle in type `E_8`. Let `G` be a simply
connected absolutely almost-simple group of type `E_8` over a number field `F`, and
let `L` be a totally complex quadratic extension of `F` such that `G_L` is quasi-split
and every cocycle of `G_L` on a finite Galois field cover of `L` is trivial. Then every
locally trivial cocycle of `G` on a finite Galois field cover of `F` is trivial. -/
def NumberFieldTypeE8QuadraticSplittingHasseStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    [LocallyOfFiniteType G.X.hom] (d : TitsIndexData G) (e : d.Vertex ≃ Fin 8),
    IsSimplyConnected G → IsAbsolutelyAlmostSimple G →
    (∀ a b, d.cartan a b = CartanMatrix.E 8 (e a) (e b)) →
    ∀ (L : Type u) [Field L] [Algebra F L] [Algebra.IsQuadraticExtension F L]
      [NumberField.IsTotallyComplex L],
      IsQuasiSplit ((GroupScheme.baseChange (algebraBaseMap F L)).obj G) →
      (∀ (M : Type u) [Field M] [Algebra L M] [FiniteDimensional L M] [IsGalois L M]
        (ζ : Cocycle ((GroupScheme.baseChange (algebraBaseMap F L)).obj G)
          (GaloisCocycle.cover L M)), ζ.IsTrivial) →
      ∀ (M : Type u) [Field M] [Algebra F M] [FiniteDimensional F M] [IsGalois F M]
        (ξ : Cocycle G (GaloisCocycle.cover F M)), ξ.LocallyTrivial → ξ.IsTrivial

/-- A field in which `-1` is a square has no real place. -/
theorem isTotallyComplex_of_isSquare_neg_one (K : Type*) [Field K]
    (h : IsSquare (-1 : K)) : NumberField.IsTotallyComplex K := by
  obtain ⟨x, hx⟩ := h
  refine ⟨fun v => NumberField.InfinitePlace.not_isReal_iff_isComplex.mp fun hv => ?_⟩
  have h1 := congrArg (NumberField.InfinitePlace.embedding_of_isReal hv) hx
  rw [map_neg, map_one, map_mul] at h1
  nlinarith [mul_self_nonneg (NumberField.InfinitePlace.embedding_of_isReal hv x)]

/-- A number field with a real place has a totally complex quadratic extension inside its
separable closure, namely the field generated by a square root of `-1`. -/
theorem exists_totallyComplex_quadratic_intermediateField (F : Type u) [Field F]
    [NumberField F] (hF : ¬ NumberField.IsTotallyComplex F) :
    ∃ E : IntermediateField F (SeparableClosure F),
      Algebra.IsQuadraticExtension F E ∧ NumberField.IsTotallyComplex E := by
  obtain ⟨i, hi⟩ := IsSepClosed.exists_pow_nat_eq (-1 : SeparableClosure F) 2
  have hint : IsIntegral F i := Algebra.IsIntegral.isIntegral i
  have hroot : ∀ x : F, ¬ IsRoot (X ^ 2 + 1 : F[X]) x := by
    intro x hx
    apply hF
    apply isTotallyComplex_of_isSquare_neg_one
    refine ⟨x, ?_⟩
    simp only [IsRoot, eval_add, eval_pow, eval_X, eval_one] at hx
    linear_combination (-1 : F) * hx
  have hdeg : (X ^ 2 + 1 : F[X]).natDegree = 2 := by
    compute_degree!
  have hirr : Irreducible (X ^ 2 + 1 : F[X]) :=
    irreducible_of_degree_le_three_of_not_isRoot (by rw [hdeg]; decide) hroot
  have hmin : (X ^ 2 + 1 : F[X]) = minpoly F i :=
    minpoly.eq_of_irreducible_of_monic hirr (by simp [hi]) (by monicity!)
  refine ⟨IntermediateField.adjoin F {i}, { toFree := inferInstance, finrank_eq_two' := ?_ }, ?_⟩
  · rw [IntermediateField.adjoin.finrank hint, ← hmin, hdeg]
  · apply isTotallyComplex_of_isSquare_neg_one
    refine ⟨⟨i, IntermediateField.mem_adjoin_simple_self F i⟩, ?_⟩
    apply Subtype.ext
    simp only [IntermediateField.coe_neg, IntermediateField.coe_one,
      IntermediateField.coe_mul]
    rw [← hi]
    ring

section Reduction

variable {F : Type u} [Field F] {G : GroupScheme (Spec (CommRingCat.of F))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]

private instance typeE8BaseChangeAffine (E : Type u) [Field E] [Algebra F E] :
    IsAffineHom ((GroupScheme.baseChange (algebraBaseMap F E)).obj G).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom _)
  infer_instance

private instance typeE8BaseChangeFiniteType (E : Type u) [Field E] [Algebra F E] :
    LocallyOfFiniteType ((GroupScheme.baseChange (algebraBaseMap F E)).obj G).X.hom := by
  change LocallyOfFiniteType (CategoryTheory.Limits.pullback.snd G.X.hom _)
  infer_instance

end Reduction

/-- The totally complex statement and the quadratic real-place statement give the Hasse
kernel in type `E_8`. Over a totally complex field the first statement applies directly.
Otherwise a square root of `-1` generates a totally complex quadratic extension `E`
inside the separable closure, the Tits index data and its `E_8` numbering are carried
to `G_E`, and the first statement over `E` supplies the hypotheses of the second. -/
theorem numberFieldTypeE8Hasse_of_totallyComplex_of_quadraticSplitting
    (hvan : NumberFieldTotallyComplexTypeE8Statement.{u})
    (hquad : NumberFieldTypeE8QuadraticSplittingHasseStatement.{u}) :
    NumberFieldTypeE8HasseStatement.{u} := by
  intro F _ _ G _ _ d e hsc habs hE8 M _ _ _ _ ξ hξ
  by_cases hF : NumberField.IsTotallyComplex F
  · exact (hvan F G d e hsc habs hE8).2 M ξ
  obtain ⟨E, hEq, hEc⟩ := exists_totallyComplex_quadratic_intermediateField F hF
  have : FiniteDimensional F E :=
    Module.finite_of_finrank_eq_succ (Algebra.IsQuadraticExtension.finrank_eq_two F E)
  have : NumberField E := NumberField.of_module_finite F E
  have : Algebra.IsSeparable E (SeparableClosure F) :=
    Algebra.isSeparable_tower_top_of_isSeparable F E (SeparableClosure F)
  have : IsSepClosure E (SeparableClosure F) := ⟨inferInstance, inferInstance⟩
  let : Algebra E (SeparableClosure E) := (separableClosure E (AlgebraicClosure E)).algebra
  let c : SeparableClosure E ≃ₐ[E] SeparableClosure F :=
    IsSepClosure.equiv E (SeparableClosure E) (SeparableClosure F)
  let X := d.separableScalarExtension E c
  let GE := (GroupScheme.baseChange (algebraBaseMap F E)).obj G
  have hscE : IsSimplyConnected GE := (isSimplyConnected_fieldExtension_iff G).mpr hsc
  have habsE : IsAbsolutelyAlmostSimple GE :=
    IsAbsolutelyAlmostSimple.baseChange_of_algebraicExtension habs
  have hE8E : ∀ a b, X.index.cartan a b =
      CartanMatrix.E 8 ((X.vertices.symm.trans e) a) ((X.vertices.symm.trans e) b) := by
    intro a b
    have h := X.cartan_eq (X.vertices.symm a) (X.vertices.symm b)
    simp only [Equiv.apply_symm_apply] at h
    rw [h, hE8]
    rfl
  obtain ⟨hqs, hvanE⟩ := hvan E GE X.index (X.vertices.symm.trans e) hscE habsE hE8E
  exact hquad F G d e hsc habs hE8 E hqs hvanE M ξ hξ

end Langlands.GroupScheme
