import Langlands.GroupScheme.Rational.WeylCharacterFormulaStatement
import Langlands.GroupScheme.Rational.FreudenthalMultiplicityStatement
import Langlands.GroupScheme.Rational.TorusFormalCharacter
import Langlands.GroupScheme.Rational.HighestWeightRootEndpoint
import Langlands.GroupScheme.Torus.SurjectionIsogenySectionProof
import Langlands.LinearAlgebra.FreudenthalWeylCharacter

/-! # The Weyl character formula from Freudenthal's multiplicity formula -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

namespace SplitPinning

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] (p : SplitPinning G)

/-- The monoid generated by the simple roots is the positive cone of the root datum. -/
theorem positiveRootMonoid_eq_positiveCone :
    p.positiveRootMonoid = LinearAlgebra.DominantTriangular.positiveCone p.rootDatum p.base :=
  rfl

variable [CharZero k] {n : ℕ} (r : MatrixRepresentation G (Fin n))

/-- In characteristic zero, the weight multiplicities of a representation have finite
support. -/
theorem finite_support_finrank_representationWeightSpace :
    (Function.support fun μ : characterLattice p.torus =>
      (Module.finrank k (p.representationWeightSpace r μ) : ℤ)).Finite := by
  refine (p.formalCharacter r).support.finite_toSet.subset fun μ hμ => ?_
  rw [Function.mem_support] at hμ
  rw [Finset.mem_coe, Finsupp.mem_support_iff, formalCharacter_apply]
  exact_mod_cast hμ

/-- The weight multiplicities of a representation, as a finitely supported function. -/
def weightMultiplicity : characterLattice p.torus →₀ ℤ :=
  Finsupp.ofSupportFinite _ (p.finite_support_finrank_representationWeightSpace r)

theorem weightMultiplicity_apply (μ : characterLattice p.torus) :
    p.weightMultiplicity r μ = Module.finrank k (p.representationWeightSpace r μ) :=
  rfl

end SplitPinning

open LinearAlgebra.WeylCharacter in
/-- **Freudenthal's multiplicity formula implies the Weyl character formula.** -/
theorem weylCharacterFormulaStatement_of_freudenthal
    (hfreud : FreudenthalMultiplicityStatement.{u}) : WeylCharacterFormulaStatement.{u} := by
  intro k _ _ G _ p rho hrho J n r lam hlam
  obtain ⟨F, hFs, hFinv, hFpos, hF⟩ := hfreud k G p n r lam hlam
  obtain ⟨hfree, hfin⟩ := TorusSurjectionIsogenySection.characterLattice_free_finite
    p.isSplitTorus
  have : p.rootDatum.IsReduced := p.isReduced
  let _ : Fintype p.rootIndex := Fintype.ofFinite _
  let c := p.weightMultiplicity r
  refine ⟨c, p.weightMultiplicity_apply r, ?_⟩
  have hc : ∀ μ, (c μ : ℚ) = (Module.finrank k (p.representationWeightSpace r μ) : ℚ) :=
    fun μ => by rw [p.weightMultiplicity_apply r, Int.cast_natCast]
  have hJ : ∀ μ, J μ = alternant p.rootDatum μ := fun μ => rfl
  rw [hJ, hJ]
  refine alternant_mul_ofCoeff_eq p.base hFs hFinv hFpos hrho c lam ?_ ?_ ?_ ?_
  · intro i μ
    simp only [c, SplitPinning.weightMultiplicity_apply,
      SplitPinning.finrank_representationWeightSpace_root_reflection]
  · rw [p.weightMultiplicity_apply r, hlam.2.2.1, Nat.cast_one]
  · intro μ hμ
    refine hlam.2.2.2 μ fun hbot => hμ ?_
    rw [p.weightMultiplicity_apply r, hbot, finrank_bot, Nat.cast_zero]
  · intro μ
    simp only [hc]
    exact hF μ

end Langlands.GroupScheme
