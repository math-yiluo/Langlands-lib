import Langlands.GroupScheme.Rational.RelativeRootStandardCocharacter
import Langlands.GroupScheme.Rational.RootRayDecomposition
import Langlands.GroupScheme.Rational.DynamicSemigroupProof
import Langlands.GroupScheme.Rational.SemigroupTriviality
import Langlands.GroupScheme.Rational.WeightSupportCongruence
import Langlands.GroupScheme.Rational.CyclicRootFunctorComparisonProof

/-! # Dynamic root groups with cyclic actual root support -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.LinearAlgebra.RationalSpan
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeRoot

variable {k : Type u} [Field k]
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom]
    (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)
    {a : characterLattice T}

/-- A positive character in the integral cyclic group generated by a positive
character is a strictly positive natural multiple. -/
theorem exists_pos_nsmul_of_mem_zmultiples
    (hpos : 0 < latticePairing T a ν)
    {b : characterLattice T} (hb : b ∈ AddSubgroup.zmultiples a)
    (hbpos : 0 < latticePairing T b ν) :
    ∃ n : ℕ, 0 < n ∧ n • a = b := by
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hb
  have hn : 0 < n := by
    have : 0 < n * latticePairing T a ν := by
      simpa only [map_zsmul, LinearMap.smul_apply, zsmul_eq_mul, Int.cast_id] using hbpos
    nlinarith
  refine ⟨n.toNat, by omega, ?_⟩
  rw [← natCast_zsmul a, Int.toNat_of_nonneg hn.le]

variable [Mono i.hom.hom.left]

/-- Cyclic actual root support permits only one indivisible positive ray. -/
theorem eq_indivisiblePositiveRoots_of_cyclic_support
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hcyclic : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples a)
    (hpos : 0 < latticePairing T a ν)
    {b c : characterLattice T}
    (hb : b ∈ indivisiblePositiveRoots i ν)
    (hc : c ∈ indivisiblePositiveRoots i ν) : b = c := by
  obtain ⟨n, hn, hnb⟩ :=
    exists_pos_nsmul_of_mem_zmultiples ν hpos (hcyclic b hb.1.1) hb.2
  obtain ⟨m, hm, hmc⟩ :=
    exists_pos_nsmul_of_mem_zmultiples ν hpos (hcyclic c hc.1.1) hc.2
  by_contra hne
  have hd := disjoint_cyclicTail_indivisibleRoots i hroot hT hb.1 hc.1 hne
  apply Set.disjoint_left.mp hd (show m • b ∈ cyclicTail b 1 from
    ⟨m, by omega, hm, rfl⟩)
  refine ⟨n, by omega, hn, ?_⟩
  rw [← hnb, ← hmc, smul_smul, smul_smul, mul_comm n m]

/-- With cyclic support, an actual root is positive exactly when it lies in
the unique indivisible positive ray. -/
theorem positive_iff_cyclicTail_of_cyclic_support
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hcyclic : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples a)
    (hpos : 0 < latticePairing T a ν)
    {b : characterLattice T} (hb : b ∈ indivisiblePositiveRoots i ν)
    {c : characterLattice T} (hc : c ∈ relativeRoots i) :
    0 < latticePairing T c ν ↔ c ∈ cyclicTail b 1 := by
  constructor
  · intro hcpos
    obtain ⟨b', hb', hc'⟩ := exists_indivisiblePositiveRoot_ray i ν hc hcpos
    rwa [eq_indivisiblePositiveRoots_of_cyclic_support i ν hT hroot
      hcyclic hpos hb' hb] at hc'
  · rintro ⟨n, _, hn, rfl⟩
    have hn' : 0 < (n : ℤ) := by exact_mod_cast hn
    simpa only [map_nsmul, LinearMap.smul_apply, nsmul_eq_mul] using
      mul_pos hn' hb.2

/-- The positive semigroup and the unique positive root ray select the same
ambient tangent weights, including at the zero character. -/
theorem agreeOnAmbientWeights_positive_cyclicTail
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hcyclic : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples a)
    (hpos : 0 < latticePairing T a ν)
    {b : characterLattice T} (hb : b ∈ indivisiblePositiveRoots i ν) :
    AgreeOnAmbientWeights (AutomorphicAction.conjugation i)
      (positiveSemigroup ν) (cyclicTail b 1) := by
  intro c hc
  by_cases hc0 : c = 0
  · subst c
    constructor
    · intro h
      have h : 0 < latticePairing T (0 : characterLattice T) ν := h
      simp only [map_zero, LinearMap.zero_apply, lt_self_iff_false] at h
    · rintro ⟨n, _, hn, hnb⟩
      have hpair := congrArg (fun c => latticePairing T c ν) hnb
      have hn' : 0 < (n : ℤ) := by exact_mod_cast hn
      have hbpos := hb.2
      simp only [map_nsmul, LinearMap.smul_apply, nsmul_eq_mul,
        map_zero, LinearMap.zero_apply] at hpair
      nlinarith
  · apply positive_iff_cyclicTail_of_cyclic_support i ν hT hroot hcyclic hpos hb
    exact ⟨hc0, by
      simpa only [actionWeightSpace_conjugation] using
        (mem_actionWeightSupport_top_iff (AutomorphicAction.conjugation i) c).mp hc⟩

/-- Negating both the character and the cocharacter preserves indivisible
positive roots. -/
theorem neg_mem_indivisiblePositiveRoots
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    {b : characterLattice T} (hb : b ∈ indivisiblePositiveRoots i ν) :
    -b ∈ indivisiblePositiveRoots i (-ν) := by
  refine ⟨⟨hroot.neg_mem_relativeRoots i hT hb.1.1, ?_⟩, ?_⟩
  · intro c hc n hn hnc
    apply hb.1.2 (-c) (hroot.neg_mem_relativeRoots i hT hc) n hn
    simp only [smul_neg, hnc, neg_neg]
  · simpa only [map_neg, LinearMap.neg_apply, neg_neg] using hb.2

omit [Mono i.hom.hom.left] in
/-- Negation on a positive cyclic generator forces negation on the original
character, by torsion freeness of the split-torus character lattice. -/
theorem characterAut_eq_neg_of_pos_multiple
    (hT : IsSplitTorus T.toGrp)
    (hpos : 0 < latticePairing T a ν)
    {b : characterLattice T} (hb : b ∈ AddSubgroup.zmultiples a)
    (hbpos : 0 < latticePairing T b ν)
    (σ : T ≅ T) (hσ : characterAut σ b = -b) :
    characterAut σ a = -a := by
  obtain ⟨n, hn, hnb⟩ := exists_pos_nsmul_of_mem_zmultiples ν hpos hb hbpos
  apply hT.character_toRat_injective
  have h := congrArg toRat hσ
  have h' : (n : ℚ) • toRat (characterAut σ a) = (n : ℚ) • toRat (-a) := by
    simpa only [← hnb, map_nsmul, map_neg, smul_neg, Nat.cast_smul_eq_nsmul] using h
  have hn' : (n : ℚ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  calc
    toRat (characterAut σ a) = (n : ℚ)⁻¹ • ((n : ℚ) • toRat (characterAut σ a)) := by
      rw [smul_smul, inv_mul_cancel₀ hn', one_smul]
    _ = (n : ℚ)⁻¹ • ((n : ℚ) • toRat (-a)) := congrArg _ h'
    _ = toRat (-a) := by rw [smul_smul, inv_mul_cancel₀ hn', one_smul]

variable [Smooth G.X.hom]

/-- The dynamic positive subgroup equals the actual subgroup of the
indivisible positive root; the original character need not be a root. -/
theorem dynamicUnipotent_eq_subgroup_of_cyclic_support
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hcyclic : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples a)
    (hpos : 0 < latticePairing T a ν)
    {b : characterLattice T} (hb : b ∈ indivisiblePositiveRoots i ν) :
    Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) = subgroup i b := by
  rw [dynamicUnipotentSemigroupComparison G T hT i ν,
    semigroupSubgroup_eq_of_weightSupport _ (agreeOnAmbientWeights_positive_cyclicTail
      i ν hT hroot hcyclic hpos hb)]
  exact weightFiltration_one_eq_subgroup hT i b hb.1.1.1

omit [Mono i.hom.hom.left] in
/-- A nontrivial dynamic positive subgroup forces the existence of an actual
indivisible positive root, without rational point or closed-field hypotheses. -/
theorem exists_indivisiblePositiveRoot_of_dynamicUnipotent_ne_bot
    (hT : IsSplitTorus T.toGrp)
    (hne : Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) ≠ ⊥) :
    ∃ b, b ∈ indivisiblePositiveRoots i ν := by
  by_contra hex
  apply hne
  rw [dynamicUnipotentSemigroupComparison G T hT i ν]
  apply semigroupSubgroup_eq_bot_of_noAmbientWeights_without_realization _ hT
  intro c hc hweight
  have hcpos : 0 < latticePairing T c ν := hc
  have hc0 : c ≠ 0 := by
    rintro rfl
    simp only [map_zero, LinearMap.zero_apply, lt_self_iff_false] at hcpos
  have hcroot : c ∈ relativeRoots i :=
    ⟨hc0, by
      simpa only [actionWeightSpace_conjugation] using
        (mem_actionWeightSupport_top_iff (AutomorphicAction.conjugation i) c).mp hweight⟩
  obtain ⟨b, hb, _⟩ := exists_indivisiblePositiveRoot_ray i ν hcroot hcpos
  exact hex ⟨b, hb⟩

/-- The opposite dynamic subgroup uses the negative of the same chosen root. -/
theorem dynamicUnipotent_neg_eq_subgroup_of_cyclic_support
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hcyclic : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples a)
    (hpos : 0 < latticePairing T a ν)
    {b : characterLattice T} (hb : b ∈ indivisiblePositiveRoots i ν) :
    Dynamic.unipotent (CommGroupScheme.groupHom (-ν) ≫ i) = subgroup i (-b) := by
  have hcyclic' : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples (-a) := by
    intro c hc
    obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp (hcyclic c hc)
    apply AddSubgroup.mem_zmultiples_iff.mpr
    exact ⟨-n, by simpa only [neg_smul, smul_neg, neg_neg] using hn⟩
  have hpos' : 0 < latticePairing T (-a) (-ν) := by
    simpa only [map_neg, LinearMap.neg_apply, neg_neg] using hpos
  exact dynamicUnipotent_eq_subgroup_of_cyclic_support i (-ν) hT hroot hcyclic'
    hpos' (neg_mem_indivisiblePositiveRoots i ν hT hroot hb)

/-- Choose one actual indivisible root for a nontrivial cyclic dynamic
subgroup, retaining the all-test identifications in both directions. -/
def cyclicDynamicRoot
    (hT : IsSplitTorus T.toGrp) (hroot : HasRelativeRootSystem i)
    (hcyclic : ∀ c ∈ relativeRoots i, c ∈ AddSubgroup.zmultiples a)
    (hpos : 0 < latticePairing T a ν)
    (hne : Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) ≠ ⊥) :
    {b : characterLattice T //
      b ∈ indivisiblePositiveRoots i ν ∧
        Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) = subgroup i b ∧
          Dynamic.unipotent (CommGroupScheme.groupHom (-ν) ≫ i) = subgroup i (-b)} := by
  let hex := exists_indivisiblePositiveRoot_of_dynamicUnipotent_ne_bot i ν hT hne
  let b := Classical.choose hex
  have hb : b ∈ indivisiblePositiveRoots i ν := Classical.choose_spec hex
  exact ⟨b, hb, dynamicUnipotent_eq_subgroup_of_cyclic_support
    i ν hT hroot hcyclic hpos hb,
    dynamicUnipotent_neg_eq_subgroup_of_cyclic_support i ν hT hroot hcyclic hpos hb⟩

end Langlands.GroupScheme.RelativeRoot
