import Langlands.GroupScheme.Rational.RootGeneratedCentralizerRankOneStatement
import Langlands.GroupScheme.Rational.RootSubgroupConjugation
import Langlands.GroupScheme.Rational.RootGeneratedSubgroup
import Mathlib.Algebra.Group.Subgroup.Basic

/-! # The subgroup generated by rank-one centralizer intersections -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeRoot

variable {k : Type u} [Field k]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : S.toGrp ⟶ G) [IsAffineHom G.X.hom]

/-- The subgroup generated by the two actual opposite root groups, for any character. -/
def oppositeGeneratedPoints (a : characterLattice S) : Subgroup (rationalPoints G) :=
  Subgroup.closure
    (((subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)) ∪
      (subgroup i (-a)).carrier (Over.mk (𝟙 _)))

/-- The actual right-hand subgroup in `RootGeneratedCentralizerRankOneStatement`. -/
def rankOneCentralizerGeneratedPoints : Subgroup (rationalPoints G) :=
  Subgroup.closure (⋃ a ∈ relativeRoots i,
    ((centralizerPoints i ⊓ oppositeGeneratedPoints i a :
      Subgroup (rationalPoints G)) : Set (rationalPoints G)))

@[simp] theorem oppositeGeneratedPoints_neg (a : characterLattice S) :
    oppositeGeneratedPoints i (-a) = oppositeGeneratedPoints i a := by
  simp only [oppositeGeneratedPoints, neg_neg, Set.union_comm]

/-- Every rank-one centralizer generator belongs to the whole-torus centralizer. -/
theorem rankOneCentralizerGeneratedPoints_le_centralizer :
    rankOneCentralizerGeneratedPoints i ≤ centralizerPoints i := by
  apply (Subgroup.closure_le _).2
  intro g hg
  obtain ⟨a, ha, hg⟩ := Set.mem_iUnion₂.mp hg
  exact hg.1

/-- A root group belongs to the subgroup generated by all relative root groups. -/
theorem subgroup_le_generatedPoints {a : characterLattice S} (ha : a ∈ relativeRoots i) :
    (subgroup i a).carrier (Over.mk (𝟙 _)) ≤ relativeRootGeneratedSubgroup i := by
  intro g hg
  exact Subgroup.subset_closure (Set.mem_iUnion₂.mpr ⟨a, ha, hg⟩)

/-- If both signs are roots, their generated group lies in the root-generated subgroup. -/
theorem oppositeGeneratedPoints_le_generatedPoints {a : characterLattice S}
    (ha : a ∈ relativeRoots i) (hna : -a ∈ relativeRoots i) :
    oppositeGeneratedPoints i a ≤ relativeRootGeneratedSubgroup i := by
  apply (Subgroup.closure_le _).2
  exact Set.union_subset (subgroup_le_generatedPoints i ha) (subgroup_le_generatedPoints i hna)

/-- The reverse inclusion to the target, under closure of the actual root set under negation. -/
theorem rankOneCentralizerGeneratedPoints_le_inf
    (hneg : ∀ a ∈ relativeRoots i, -a ∈ relativeRoots i) :
    rankOneCentralizerGeneratedPoints i ≤ centralizerPoints i ⊓ relativeRootGeneratedSubgroup i := by
  refine le_inf (rankOneCentralizerGeneratedPoints_le_centralizer i) ?_
  apply (Subgroup.closure_le _).2
  intro g hg
  obtain ⟨a, ha, hg⟩ := Set.mem_iUnion₂.mp hg
  exact oppositeGeneratedPoints_le_generatedPoints i ha (hneg a ha) hg.2

@[simp] theorem generatedPoints_eq_bot_of_roots_eq_empty (h : relativeRoots i = ∅) :
    relativeRootGeneratedSubgroup i = ⊥ := by
  simp [relativeRootGeneratedSubgroup, h]

@[simp] theorem rankOneCentralizerGeneratedPoints_eq_bot_of_roots_eq_empty
    (h : relativeRoots i = ∅) : rankOneCentralizerGeneratedPoints i = ⊥ := by
  simp [rankOneCentralizerGeneratedPoints, h]

/-- The required inclusion holds when the actual root set is empty. -/
theorem centralizer_inf_generatedPoints_le_of_roots_eq_empty
    (h : relativeRoots i = ∅) :
    centralizerPoints i ⊓ relativeRootGeneratedSubgroup i ≤ rankOneCentralizerGeneratedPoints i := by
  simp [generatedPoints_eq_bot_of_roots_eq_empty i h]

variable [Mono i.hom.hom.left]

/-- Actual normalizer conjugation carries an opposite-root generated subgroup
into the generated subgroup for the Weyl-translated character. -/
theorem conj_mem_oppositeGeneratedPoints (n : normalizerPoints i)
    {a : characterLattice S} {g : rationalPoints G} (hg : g ∈ oppositeGeneratedPoints i a) :
    n.val * g * n.val⁻¹ ∈ oppositeGeneratedPoints i (weylAction i n a) := by
  let f : rationalPoints G →* rationalPoints G := (MulAut.conj n.val).toMonoidHom
  have hle : oppositeGeneratedPoints i a ≤
      (oppositeGeneratedPoints i (weylAction i n a)).comap f := by
    apply (Subgroup.closure_le _).2
    intro x hx
    change n.val * x * n.val⁻¹ ∈ oppositeGeneratedPoints i (weylAction i n a)
    apply Subgroup.subset_closure
    rcases hx with hx | hx
    · exact Or.inl (by simpa only [SetLike.mem_coe, G.constantPoint_self] using
        normalizer_conj_mem i a n hx)
    · exact Or.inr (by simpa only [SetLike.mem_coe, G.constantPoint_self, map_neg] using
        normalizer_conj_mem i (-a) n hx)
  exact hle hg

/-- The whole rational normalizer preserves the subgroup generated by the
rank-one centralizer intersections. No structural theorem is a premise. -/
theorem normalizerPoints_le_normalizer_rankOneCentralizerGeneratedPoints :
    normalizerPoints i ≤ Subgroup.normalizer (rankOneCentralizerGeneratedPoints i) := by
  rw [rankOneCentralizerGeneratedPoints, Subgroup.le_normalizer_closure_iff]
  intro n hn g hg
  obtain ⟨a, ha, hg⟩ := Set.mem_iUnion₂.mp hg
  apply Subgroup.subset_closure
  exact Set.mem_iUnion₂.mpr ⟨weylAction i ⟨n, hn⟩ a,
    weylAction_mapsTo_relativeRoots i ⟨n, hn⟩ ha,
    conj_mem_centralizerPoints i hn hg.1,
    conj_mem_oppositeGeneratedPoints i ⟨n, hn⟩ hg.2⟩

/-- The right-hand subgroup is a normal subgroup of the rational normalizer. -/
instance rankOneCentralizerGeneratedPoints_normal_subgroupOf :
    ((rankOneCentralizerGeneratedPoints i).subgroupOf (normalizerPoints i)).Normal := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer
    ((rankOneCentralizerGeneratedPoints_le_centralizer i).trans
      (centralizerPoints_le_normalizerPoints i))).mpr
  exact normalizerPoints_le_normalizer_rankOneCentralizerGeneratedPoints i

end Langlands.GroupScheme.RelativeRoot
