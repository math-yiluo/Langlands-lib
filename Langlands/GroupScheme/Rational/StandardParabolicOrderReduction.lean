import Langlands.GroupScheme.Rational.StandardLeviAnnihilator

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)

/-- A standard cocharacter pairs nonnegatively with every simple relative root. -/
theorem IsStandardCocharacter.nonneg {J : Set (characterLattice T)}
    {zeta : cocharacterLattice T} (hzeta : IsStandardCocharacter i ν J zeta)
    {α : characterLattice T} (hα : α ∈ simpleRelativeRoots i ν) :
    0 ≤ latticePairing T α zeta := by
  by_cases hαJ : α ∈ J
  · rw [hzeta.2.1 α hαJ]
  · exact le_of_lt (hzeta.2.2 α hα hαJ)

/-- Adding a standard cocharacter for a larger face preserves standardness for
 the smaller face. -/
theorem IsStandardCocharacter.add_of_subset {J K : Set (characterLattice T)}
    {zeta eta : cocharacterLattice T} (hzeta : IsStandardCocharacter i ν J zeta)
    (heta : IsStandardCocharacter i ν K eta) (hJK : J ⊆ K) :
    IsStandardCocharacter i ν J (zeta + eta) := by
  refine ⟨hzeta.1, ?_, ?_⟩
  · intro α hα
    simp only [map_add, hzeta.2.1 α hα, heta.2.1 α (hJK hα), add_zero]
  · intro α hα hαJ
    simp only [map_add]
    exact add_pos_of_pos_of_nonneg (hzeta.2.2 α hα hαJ) (heta.nonneg i ν hα)

/-- The integer submodule generated by the standard cocharacters for a face. -/
def standardCocharacterSpan (J : Set (characterLattice T)) :
    Submodule ℤ (cocharacterLattice T) :=
  Submodule.span ℤ {zeta | IsStandardCocharacter i ν J zeta}

/-- Membership in the choice-free standard Levi means centralizing the span of
 all standard cocharacters for its face. -/
theorem mem_standardLevi_iff_standardCocharacterSpan_le
    {J : Set (characterLattice T)} {U : Over (Spec (CommRingCat.of k))}
    {g : U ⟶ G.X} :
    g ∈ (standardLevi i ν J).carrier U ↔
      standardCocharacterSpan i ν J ≤ Dynamic.centralizingCocharacters i g := by
  rw [mem_standardLevi]
  exact ⟨fun h => Submodule.span_le.2 h,
    fun h zeta hzeta => h (Submodule.subset_span hzeta)⟩

/-- The standard-cocharacter spans vary contravariantly with the standard face,
 provided the smaller face has a standard cocharacter. -/
theorem standardCocharacterSpan_antitone_of_exists {J K : Set (characterLattice T)}
    (hJK : J ⊆ K) (hexists : ∃ zeta, IsStandardCocharacter i ν J zeta) :
    standardCocharacterSpan i ν K ≤ standardCocharacterSpan i ν J := by
  obtain ⟨zeta, hzeta⟩ := hexists
  apply Submodule.span_le.2
  intro eta heta
  change eta ∈ standardCocharacterSpan i ν J
  have hz : zeta ∈ standardCocharacterSpan i ν J := Submodule.subset_span hzeta
  have hsum : zeta + eta ∈ standardCocharacterSpan i ν J :=
    Submodule.subset_span (hzeta.add_of_subset i ν heta hJK)
  simpa only [add_sub_cancel_left] using (standardCocharacterSpan i ν J).sub_mem hsum hz

/-- Levi inclusion needs only existence of a standard cocharacter for the smaller
 face. The inclusion is on every test scheme. -/
theorem standardLevi_mono_of_exists {J K : Set (characterLattice T)}
    (hJK : J ⊆ K) (hexists : ∃ zeta, IsStandardCocharacter i ν J zeta) :
    standardLevi i ν J ≤ standardLevi i ν K := by
  intro U g hg
  rw [mem_standardLevi_iff_standardCocharacterSpan_le] at hg ⊢
  exact (standardCocharacterSpan_antitone_of_exists i ν hJK hexists).trans hg

end Langlands.GroupScheme
