import Langlands.GroupScheme.Rational.SteinbergCanonicalRepresentatives
import Langlands.LinearAlgebra.RootDatumPathWeights

/-! # Pattern products for even path components (Steinberg's `N''` and `N'''`) -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.LinearAlgebra.RootDatumPathWeights
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace SplitPinning

/-- The distance of the path position `i` from the middle pair `{m - 1, m}` of a path with
`2 m` vertices: `m - 1 - i` on the left half and `i - m` on the right half. Both middle
positions have distance `0`. -/
def middleDistance (m i : ℕ) : ℕ := if i + 1 < m then m - 1 - i else i - m

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom]

/-- The rational point of the coroot cocharacter of a root at a unit of the field. -/
def corootRationalPoint (p : SplitPinning G) (α : p.rootIndex) (t : kˣ) : rationalPoints G :=
  (Gm.affinePointsEquiv (𝟙 (Spec (CommRingCat.of k)))).symm t ≫ (p.corootHom α).hom.hom

variable (p : SplitPinning G)

/-- A finite family of pairwise disjoint path components of even length `2 m_c`, each listed in
path order, together with supplied merged-root data at its middle pair. The merged
representative is generated by the rational root subgroups of plus and minus the merged root.
No existence of these data is asserted. -/
structure EvenChainData (J : Type u) where
  /-- Half the length of each path. -/
  half : J → ℕ
  /-- The vertices of each path, in path order. -/
  path : (c : J) → Fin (2 * half c) → p.base.support
  /-- Each path lists a connected component of type `A_{2m}` of the Dynkin diagram. -/
  isPathComponent : ∀ c, IsPathComponent (P := p.rootDatum) (b := p.base) (path c)
  /-- Distinct indices give disjoint paths. -/
  disjoint : ∀ (c c' : J) (i : Fin (2 * half c)) (i' : Fin (2 * half c')),
    path c i = path c' i' → c = c'
  /-- The supplied merged-root data of each path. -/
  modified : J → p.SteinbergModifiedData
  /-- The first merged simple root is the vertex `m - 1`. -/
  modified_a : ∀ c, (modified c).a =
    path c ⟨half c - 1, by have := (isPathComponent c).pos; omega⟩
  /-- The second merged simple root is the vertex `m`. -/
  modified_b : ∀ c, (modified c).b =
    path c ⟨half c, by have := (isPathComponent c).pos; omega⟩
  /-- The merged representative is generated by the rational root subgroups of `± α`. -/
  nAlpha_mem : ∀ c, (modified c).nAlpha.point ∈
    (RelativeRoot.subgroup p.inclusion (p.rootDatum.root (modified c).alpha)).carrier
        (Over.mk (𝟙 _)) ⊔
      (RelativeRoot.subgroup p.inclusion (-p.rootDatum.root (modified c).alpha)).carrier
        (Over.mk (𝟙 _))

namespace EvenChainData

variable {p} {J : Type u} (C : p.EvenChainData J)

/-- The simple roots that are not merged: all simple roots except the two middle vertices of
each path. -/
abbrev Rest : Type u :=
  {j : p.base.support // ∀ c, j ≠ (C.modified c).a ∧ j ≠ (C.modified c).b}

/-- An ordering of the unmerged simple roots is middle-out if, along each path, vertices
closer to the middle pair come first. Vertices at the same distance may come in either
order. -/
def IsMiddleOut {q : ℕ} (e : Fin q ≃ C.Rest) : Prop :=
  ∀ (c : J) (i i' : Fin (2 * C.half c)) (j j' : Fin q),
    ((e j : p.base.support) = C.path c i) → ((e j' : p.base.support) = C.path c i') →
      middleDistance (C.half c) i < middleDistance (C.half c) i' → j < j'

variable (x : p.NormalizedSimpleRootParametrizations) (n : p.SimpleReflectionRepresentatives)

/-- The block of the path `c` at rational points. For the pattern value `false` it is
Steinberg's `x_α(s) n_α`; for `true` it is `u_b u_a x_α(s) n_α α^∨(t)`. -/
def block (c : J) (b : Bool) (s : k) (t : kˣ) : rationalPoints G :=
  if b then
    (C.modified c).ub x * (C.modified c).ua x * (C.modified c).xAlpha.rationalPoint s *
      (C.modified c).nAlpha.point * corootRationalPoint p (C.modified c).alpha t
  else
    (C.modified c).xAlpha.rationalPoint s * (C.modified c).nAlpha.point

/-- The ordered pattern product at rational points: the blocks of the paths in the order `o`,
followed by `x_(e j)(d_j) n_(e j)` for the unmerged simple roots in the order `e`. The pattern
`ε c = false` selects Steinberg's `N''` at the path `c`, and `ε c = true` selects `N'''`;
the unit `t c` is used only in the second case. -/
def patternProduct {r q : ℕ} (o : Fin r ≃ J) (e : Fin q ≃ C.Rest) (ε : J → Bool)
    (s : J → k) (t : J → kˣ) (d : Fin q → k) : rationalPoints G :=
  (List.ofFn fun j : Fin r => C.block x (o j) (ε (o j)) (s (o j)) (t (o j))).prod *
    (List.ofFn fun j : Fin q =>
      (x (e j).1).toRootParametrization.rationalPoint (d j) * (n (e j).1).point).prod

/-- The set of all pattern products, over all patterns and all coordinates. -/
def patternSet {r q : ℕ} (o : Fin r ≃ J) (e : Fin q ≃ C.Rest) : Set (rationalPoints G) :=
  {g | ∃ (ε : J → Bool) (s : J → k) (t : J → kˣ) (d : Fin q → k),
    g = C.patternProduct x n o e ε s t d}

end EvenChainData

end SplitPinning

end Langlands.GroupScheme
