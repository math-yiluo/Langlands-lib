import Langlands.GroupScheme.Rational.Characters
import Langlands.GroupScheme.Rational.RelativeRoots
import Langlands.GroupScheme.Rational.RootSubgroup

/-!
# Rank-one generation of the root-generated part of a split-torus centralizer

A field-general statement about the rational points of `Z_G(S)` lying in the subgroup
generated by the rational root groups. This module states a proposition and supplies no
proof of it.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- For a connected reductive group `G` over a field `k` with maximal split torus `S`, every
rational point of `Z_G(S)` that lies in the subgroup `G(k)^+` generated by the rational root
groups `U_a(k)` is a product of centralizing elements of the rank-one groups
`⟨U_a(k), U_{-a}(k)⟩`. -/
def RootGeneratedCentralizerRankOneStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (S : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : S.toGrp ⟶ G), IsMaximalSplitTorus i →
    haveI := hG.isAffineHom
    centralizerPoints i ⊓ Subgroup.closure (⋃ a ∈ relativeRoots i,
        ((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G))) ≤
      Subgroup.closure (⋃ a ∈ relativeRoots i,
        ((centralizerPoints i ⊓ Subgroup.closure
          (((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) :
              Set (rationalPoints G)) ∪
            (RelativeRoot.subgroup i (-a)).carrier (Over.mk (𝟙 _))) :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)))

end Langlands.GroupScheme
