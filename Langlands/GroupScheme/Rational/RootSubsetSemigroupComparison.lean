import Langlands.GroupScheme.Rational.ClosedRootSubsetStatements
import Langlands.GroupScheme.Rational.RootSubgroupTorusProduct
import Langlands.GroupScheme.Rational.WeylPositiveCocharacter

/-! # Root-generated unipotent groups and selected semigroup subgroups -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

open RelativeRoot

set_option backward.isDefEq.respectTransparency false

variable {k : Type u} [Field k]
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom]

/-- Weyl positivity of a unipotent root subset excludes zero from its
generated additive semigroup. -/
theorem IsUnipotentRootSubset.zero_notMem_addSubsemigroupClosure
    (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]
    {ν : cocharacterLattice T} {X : Set (characterLattice T)}
    (hX : IsUnipotentRootSubset i ν (relativeRoots i) X) :
    0 ∉ AddSubsemigroup.closure X := by
  obtain ⟨w, hw⟩ := hX.2
  let ζ := relativeWeylCocharacterAction i w ν
  have hpos : X ⊆ (positiveSemigroup ζ : Set (characterLattice T)) := by
    intro χ hχ
    obtain ⟨ψ, hψ, rfl⟩ := hw hχ
    change 0 < latticePairing T (relativeWeylCharacterAction i w ψ)
      (relativeWeylCocharacterAction i w ν)
    rw [latticePairing_relativeWeyl]
    exact hψ.2
  have hclosure : AddSubsemigroup.closure X ≤ positiveSemigroup ζ :=
    AddSubsemigroup.closure_le.2 hpos
  intro hz
  have h := hclosure hz
  change 0 < latticePairing T 0 ζ at h
  simp at h

variable [Smooth G.X.hom]

/-- A zero-excluding semigroup with exactly the roots `X` realizes the closed
group generated by those root groups on every test scheme. -/
theorem IsRootSubsetUnipotentGroup.range_eq_semigroupSubgroup
    (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]
    (hT : IsSplitTorus T.toGrp) (hE : HasOppositeFactorPairs i)
    (A : AddSubsemigroup (characterLattice T)) (hzero : 0 ∉ A)
    {X : Set (characterLattice T)}
    (hroots : relativeRoots i ∩ (A : Set (characterLattice T)) = X)
    {H : GroupScheme (Spec (CommRingCat.of k))} {j : H ⟶ G}
    (hj : IsRootSubsetUnipotentGroup i X j) :
    SubgroupFunctor.range j = semigroupSubgroup (AutomorphicAction.conjugation i) A := by
  let b := AutomorphicAction.conjugation i
  have hr (χ : characterLattice T) (hχ : χ ∈ X) :
      subgroup i χ ≤ semigroupSubgroup b A := by
    have hχ' : χ ∈ relativeRoots i ∩ (A : Set _) := hroots.symm ▸ hχ
    rw [← weightFiltration_one_eq_subgroup hT i χ hχ'.1.1]
    exact semigroupSubgroup_mono b (cyclicTail_one_le_of_mem hχ'.2)
  apply le_antisymm
  · obtain ⟨⟨K, q, hq, hqc, _, _⟩, _⟩ :=
      semigroupRealization k G inferInstance inferInstance T hT b A
    rw [← hq.2]
    apply hj.2.2 K q hqc
    intro χ hχ
    rw [hq.2]
    exact hr χ hχ
  · intro V
    change (semigroupSubgroup (AutomorphicAction.conjugation i) A).carrier V ≤
      (SubgroupFunctor.range j).carrier V
    rw [semigroupSubgroup_carrier_eq_iSup_selectedRoots i hT hE A hzero]
    apply iSup_le
    intro χ
    exact hj.2.1 χ.val (hroots ▸ χ.property) V

omit [IsAffineHom G.X.hom] [Smooth G.X.hom] in
/-- Root-generated closed unipotent groups are monotone in the chosen set
of roots. -/
theorem IsRootSubsetUnipotentGroup.range_le_of_subset
    (i : T.toGrp ⟶ G) {X Y : Set (characterLattice T)}
    (hXY : X ⊆ Y)
    {H K : GroupScheme (Spec (CommRingCat.of k))} {j : H ⟶ G} {q : K ⟶ G}
    (hj : IsRootSubsetUnipotentGroup i X j)
    (hq : IsRootSubsetUnipotentGroup i Y q) :
    SubgroupFunctor.range j ≤ SubgroupFunctor.range q :=
  hj.2.2 K q hq.1 (fun χ hχ => hq.2.1 χ (hXY hχ))

omit [IsAffineHom G.X.hom] [Smooth G.X.hom] in
/-- A root-generated closed unipotent group lies in a root-generated group
whose indexing set contains its roots. -/
theorem IsRootSubsetUnipotentGroup.range_le_rootSubsetGroup
    (i : T.toGrp ⟶ G) {X Y : Set (characterLattice T)}
    (hXY : X ⊆ Y)
    {H K : GroupScheme (Spec (CommRingCat.of k))} {j : H ⟶ G} {q : K ⟶ G}
    (hj : IsRootSubsetUnipotentGroup i X j)
    (hq : IsRootSubsetGroup i Y q) :
    SubgroupFunctor.range j ≤ SubgroupFunctor.range q :=
  hj.2.2 K q hq.1 (fun χ hχ => hq.2.2.1 χ (hXY hχ))

end Langlands.GroupScheme
