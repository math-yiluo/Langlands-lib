/-! # Factors of other components act trivially -/

noncomputable section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory AlgebraicGeometry
open scoped Matrix CategoryTheory.MonObj

namespace Langlands.GroupScheme.SplitPinning

open Langlands.LinearAlgebra.RootDatumPathWeights
open MatrixRepresentation.AdditiveDividedPowers

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] {p : SplitPinning G} {n : Type} [Fintype n] [DecidableEq n]

/-- The subgroup of rational points generated by the root subgroups of `α_r` and `-α_r`. -/
abbrev rootSup (p : SplitPinning G) (r : p.rootIndex) : Subgroup (rationalPoints G) :=
  (RelativeRoot.subgroup p.inclusion (p.rootDatum.root r)).carrier (Over.mk (𝟙 _)) ⊔
    (RelativeRoot.subgroup p.inclusion (-p.rootDatum.root r)).carrier (Over.mk (𝟙 _))

/-- The rational points of the coroot of `r` lie in the subgroup generated by the root
subgroups of `± α_r`. -/
theorem corootRationalPoint_mem_rootSup (r : p.rootIndex) (t : kˣ) :
    corootRationalPoint p r t ∈ p.rootSup r := by
  obtain ⟨X⟩ := p.nonempty_linkedRootParametrization r
  let Z : Over (Spec (CommRingCat.of k)) := Over.mk (𝟙 _)
  let s : Z ⟶ (Gm (Spec (CommRingCat.of k))).X :=
    (Gm.affinePointsEquiv (𝟙 (Spec (CommRingCat.of k)))).symm t
  let u : Γ(Z.left, ⊤)ˣ := Gm.pointsEquiv _ Z s
  let a : Z ⟶ (RootCell.Ga k).X := RootCell.pt 1
  let b : Z ⟶ (RootCell.Ga k).X := RootCell.pt ((u : Γ(Z.left, ⊤)) - 1)
  let a' : Z ⟶ (RootCell.Ga k).X := RootCell.pt (↑u⁻¹ * 1)
  let b' : Z ⟶ (RootCell.Ga k).X := RootCell.pt (↑u⁻¹ * ((u : Γ(Z.left, ⊤)) - 1))
  have hrel := X.relation Z a b a' b' u (by simp [a, b]) (by simp [a, a']) (by simp [b, b'])
  have htorus : corootRationalPoint p r t =
      (Gm.pointsEquiv _ Z).symm u ≫ (CommGroupScheme.groupHom (p.rootDatum.coroot r)).hom.hom ≫
        p.inclusion.hom.hom := by
    simp only [u, MulEquiv.symm_apply_apply]
    rfl
  have hpos : ∀ w : Z ⟶ (RootCell.Ga k).X, w ≫ X.positive.hom.hom ∈
      (RelativeRoot.subgroup p.inclusion (p.rootDatum.root r)).carrier Z := fun w => by
    rw [← X.positive_represents.2, SubgroupFunctor.mem_range]
    exact ⟨w, rfl⟩
  have hneg : ∀ w : Z ⟶ (RootCell.Ga k).X, w ≫ X.negative.hom.hom ∈
      (RelativeRoot.subgroup p.inclusion (-p.rootDatum.root r)).carrier Z := fun w => by
    rw [← X.negative_represents.2, SubgroupFunctor.mem_range]
    exact ⟨w, rfl⟩
  have heq : (Gm.pointsEquiv _ Z).symm u ≫
        (CommGroupScheme.groupHom (p.rootDatum.coroot r)).hom.hom ≫ p.inclusion.hom.hom =
      (b' ≫ X.negative.hom.hom)⁻¹ * ((a ≫ X.positive.hom.hom) * (b ≫ X.negative.hom.hom)) *
        (a' ≫ X.positive.hom.hom)⁻¹ := by
    rw [hrel]
    group
  rw [htorus, heq]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _
    (Subgroup.mem_sup_right (hneg b'))) (Subgroup.mul_mem _ (Subgroup.mem_sup_left (hpos a))
      (Subgroup.mem_sup_right (hneg b)))) (Subgroup.inv_mem _ (Subgroup.mem_sup_left (hpos a')))

/-- Let `ρ` have a complete weight decomposition, and let no weight be moved to a weight by a
positive multiple of `δ`. Then every rational point of a subgroup represented by a
`δ`-equivariant additive map acts trivially. -/
theorem rationalMatrix_eq_one_of_isRepresentedBy (ρ : MatrixRepresentation G n)
    (hspan : (⨆ ξ, p.representationWeightSpace ρ ξ) = ⊤)
    {F : SubgroupFunctor G} {y : VectorGroup.groupScheme (CommRingCat.of k) 1 ⟶ G}
    (hy : F.IsRepresentedBy y) {δ : characterLattice p.torus}
    (hx : VectorGroup.IsTorusEquivariant p.inclusion y δ)
    (hshift : ∀ ξ (m : ℕ), 1 ≤ m → p.representationWeightSpace ρ ξ ≠ ⊥ →
      p.representationWeightSpace ρ (ξ + m • δ) = ⊥)
    {g : rationalPoints G} (hg : g ∈ F.carrier (Over.mk (𝟙 _))) :
    ρ.rationalMatrix g = 1 := by
  have hv : ∀ v : n → k, ∀ m, 1 ≤ m → dividedPower (ρ.restrict y) m v = 0 := by
    intro v m hm
    have hmem : v ∈ ⨆ ξ, p.representationWeightSpace ρ ξ := by
      rw [hspan]
      exact Submodule.mem_top
    refine Submodule.iSup_induction _ (motive := fun v => dividedPower (ρ.restrict y) m v = 0)
      hmem (fun ξ w hw => ?_) (map_zero _) (fun v w hv hw => by rw [map_add, hv, hw, add_zero])
    by_cases hbot : p.representationWeightSpace ρ ξ = ⊥
    · rw [hbot, Submodule.mem_bot] at hw
      rw [hw, map_zero]
    · have h := dividedPower_mem_representationWeightSpace_of_equivariant hx ρ m hw
      rwa [hshift ξ m hm hbot, Submodule.mem_bot] at h
  have hfix : ∀ v : n → k, (ρ.rationalMatrix g : Matrix n n k) *ᵥ v = v := fun v =>
    rationalMatrix_mulVec_eq_self_of_isRepresentedBy ρ hy (hv v) hg
  apply Units.ext
  rw [Units.val_one]
  apply Matrix.toLin'.injective
  refine LinearMap.ext fun v => ?_
  rw [Matrix.toLin'_apply, Matrix.toLin'_apply, Matrix.one_mulVec, hfix]

/-- Let `ρ` have a complete weight decomposition whose weights are all orthogonal to the coroot
of the simple root `z`, and let `r` be a root with `⟨α_r, z^∨⟩ ≠ 0`. Then the subgroup
generated by the root subgroups of `± α_r` acts trivially. -/
theorem rationalMatrix_eq_one_of_mem_rootSup (ρ : MatrixRepresentation G n)
    (hspan : (⨆ ξ, p.representationWeightSpace ρ ξ) = ⊤) {z : p.base.support}
    (hz : ∀ ξ, p.representationWeightSpace ρ ξ ≠ ⊥ →
      p.rootDatum.toLinearMap ξ (p.rootDatum.coroot z) = 0)
    {r : p.rootIndex}
    (hr : p.rootDatum.toLinearMap (p.rootDatum.root r) (p.rootDatum.coroot z) ≠ 0)
    {g : rationalPoints G} (hg : g ∈ p.rootSup r) :
    ρ.rationalMatrix g = 1 := by
  obtain ⟨X⟩ := p.nonempty_linkedRootParametrization r
  have hshift : ∀ δ : characterLattice p.torus,
      (δ = p.rootDatum.root r ∨ δ = -p.rootDatum.root r) →
      ∀ ξ (m : ℕ), 1 ≤ m → p.representationWeightSpace ρ ξ ≠ ⊥ →
        p.representationWeightSpace ρ (ξ + m • δ) = ⊥ := by
    intro δ hδ ξ m hm hξ
    by_contra hne
    have h1 := hz _ hne
    rw [map_add, LinearMap.add_apply, hz ξ hξ, zero_add, map_nsmul, LinearMap.smul_apply,
      nsmul_eq_mul] at h1
    have hm0 : (m : ℤ) ≠ 0 := by exact_mod_cast (show m ≠ 0 by omega)
    rcases hδ with rfl | rfl
    · exact hr ((mul_eq_zero.mp h1).resolve_left hm0)
    · rw [map_neg, LinearMap.neg_apply, mul_neg, neg_eq_zero] at h1
      exact hr ((mul_eq_zero.mp h1).resolve_left hm0)
  have hle : p.rootSup r ≤ ρ.rationalMatrix.ker := by
    refine sup_le (fun g hg => ?_) (fun g hg => ?_)
    · exact (MonoidHom.mem_ker).mpr (rationalMatrix_eq_one_of_isRepresentedBy ρ hspan
        X.positive_represents X.positive_equivariant (hshift _ (Or.inl rfl)) hg)
    · exact (MonoidHom.mem_ker).mpr (rationalMatrix_eq_one_of_isRepresentedBy ρ hspan
        X.negative_represents X.negative_equivariant (hshift _ (Or.inr rfl)) hg)
  exact (MonoidHom.mem_ker).mp (hle hg)

section Cone

variable {ρ : MatrixRepresentation G n} {lam : characterLattice p.torus}

/-- **Weights stay in their components.** Let `ρ` be a highest-weight representation at `lam`,
and let `Z` be a set of simple roots such that `α_w` pairs to zero with the coroot of every
member of `Z` for every simple root `w` outside `Z`. If `lam` is orthogonal to the coroots of
`Z`, then so is every weight of `ρ`. -/
theorem pairing_eq_zero_of_isHighestWeight (hρ : p.IsHighestWeight ρ lam)
    (Z : Set p.base.support)
    (hZ : ∀ z ∈ Z, ∀ w : p.base.support, w ∉ Z →
      p.rootDatum.pairing (w : p.rootIndex) (z : p.rootIndex) = 0)
    (hlam : ∀ z ∈ Z, p.rootDatum.toLinearMap lam (p.rootDatum.coroot z) = 0)
    {ξ : characterLattice p.torus} (hξ : p.representationWeightSpace ρ ξ ≠ ⊥) :
    ∀ z ∈ Z, p.rootDatum.toLinearMap ξ (p.rootDatum.coroot z) = 0 := by
  classical
  let _ := Fintype.ofFinite p.rootIndex
  let P := p.rootDatum
  let S : Set (characterLattice p.torus) := {ξ | p.representationWeightSpace ρ ξ ≠ ⊥}
  have hS_refl : ∀ ν ∈ S, ∀ w : p.base.support, P.reflection (w : p.rootIndex) ν ∈ S := by
    intro ν hν w
    have h := finrank_representationWeightSpace_simpleReflection ρ w ν
    intro hbot
    apply hν
    rw [← Submodule.finrank_eq_zero, ← h, hbot, finrank_bot]
  have hcoef : ∀ ν ∈ S, ∃ c : p.base.support → ℕ,
      lam - ν = ∑ w, c w • P.root (w : p.rootIndex) :=
    fun ν hν => AddSubmonoid.mem_closure_range_iff_of_fintype.mp (hρ.2.2.2 ν hν)
  have hli := linearIndependent_iff'.mp p.base.linearIndepOn_root.linearIndependent
  -- the pairing of a weight with a coroot in `Z` only sees the `Z`-coefficients
  have hpair : ∀ ν (c : p.base.support → ℕ), lam - ν = ∑ w, c w • P.root (w : p.rootIndex) →
      ∀ z ∈ Z, P.toLinearMap ν (P.coroot (z : p.rootIndex)) =
        -P.toLinearMap (∑ w ∈ Finset.univ.filter (· ∈ Z), c w • P.root (w : p.rootIndex))
          (P.coroot (z : p.rootIndex)) := by
    intro ν c hc z hz
    have hν : ν = lam - ∑ w, c w • P.root (w : p.rootIndex) := by rw [← hc]; abel
    have hsplit := Finset.sum_filter_add_sum_filter_not Finset.univ (· ∈ Z)
      (fun w => c w • P.root (w : p.rootIndex))
    have hnot : P.toLinearMap (∑ w ∈ Finset.univ.filter (fun w => w ∉ Z),
        c w • P.root (w : p.rootIndex)) (P.coroot (z : p.rootIndex)) = 0 := by
      rw [map_sum P.toLinearMap, LinearMap.sum_apply]
      refine Finset.sum_eq_zero fun w hw => ?_
      rw [map_nsmul, LinearMap.smul_apply, RootPairing.root_coroot_eq_pairing,
        hZ z hz w (Finset.mem_filter.mp hw).2, smul_zero]
    rw [hν, ← hsplit, map_sub, LinearMap.sub_apply, map_add, LinearMap.add_apply, hnot,
      hlam z hz, add_zero, zero_sub]
  suffices H : ∀ N : ℕ, ∀ ν ∈ S, ∀ c : p.base.support → ℕ,
      lam - ν = ∑ w, c w • P.root (w : p.rootIndex) →
      ∑ w ∈ Finset.univ.filter (· ∈ Z), c w ≤ N →
        ∀ z ∈ Z, P.toLinearMap ν (P.coroot (z : p.rootIndex)) = 0 by
    obtain ⟨c, hc⟩ := hcoef ξ hξ
    exact H _ ξ hξ c hc le_rfl
  intro N
  induction N with
  | zero =>
    intro ν _ c hc hN z hz
    have hc0 : ∀ w ∈ Finset.univ.filter (· ∈ Z), c w = 0 := fun w hw =>
      (Finset.sum_eq_zero_iff.mp (Nat.le_zero.mp hN)) w hw
    rw [hpair ν c hc z hz, Finset.sum_eq_zero fun w hw => by rw [hc0 w hw, zero_smul],
      map_zero, LinearMap.zero_apply, neg_zero]
  | succ N ih =>
    intro ν hν c hc hN
    -- the `Z`-part of `lam - ν`
    set D := ∑ w ∈ Finset.univ.filter (· ∈ Z), c w • P.root (w : p.rootIndex) with hD
    by_contra hne
    push Not at hne
    -- some coroot in `Z` pairs negatively with `ν`
    obtain ⟨z, hz, hneg⟩ : ∃ z ∈ Z, P.toLinearMap ν (P.coroot (z : p.rootIndex)) < 0 := by
      by_contra hall
      push Not at hall
      have hD0 : D ≠ 0 := by
        intro h0
        obtain ⟨z, hz, hz0⟩ := hne
        exact hz0 (by rw [hpair ν c hc z hz, ← hD, h0, map_zero, LinearMap.zero_apply,
          neg_zero])
      have hmem : D ∈ P.rootSpan ℤ :=
        Submodule.sum_mem _ fun w _ => nsmul_mem (Submodule.subset_span (Set.mem_range_self _)) _
      have hpos := P.rootForm_pos_of_ne_zero hmem hD0
      have hform' : ∀ y, 2 * P.RootForm D y = ∑ w ∈ Finset.univ.filter (· ∈ Z),
          (c w : ℤ) * (P.RootForm (P.root (w : p.rootIndex)) (P.root (w : p.rootIndex)) *
            P.toLinearMap y (P.coroot (w : p.rootIndex))) := by
        intro y
        rw [hD, map_sum P.RootForm, LinearMap.sum_apply, Finset.mul_sum]
        refine Finset.sum_congr rfl fun w _ => ?_
        rw [map_nsmul, LinearMap.smul_apply, nsmul_eq_mul, mul_left_comm,
          Langlands.RootDatum.Triangular.two_mul_rootForm_root]
      have hform := hform' D
      have hle : 2 * P.RootForm D D ≤ 0 := by
        rw [hform]
        refine Finset.sum_nonpos fun w hw => ?_
        have hwZ := (Finset.mem_filter.mp hw).2
        have h1 := hall w hwZ
        rw [hpair ν c hc w hwZ, ← hD] at h1
        have h2 := Langlands.RootDatum.Triangular.rootForm_root_pos (P := P)
          (w : p.rootIndex)
        exact mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _)
          (mul_nonpos_of_nonneg_of_nonpos h2.le (by linarith))
      linarith
    -- reflect in `z`
    have hν' : P.reflection (z : p.rootIndex) ν ∈ S := hS_refl ν hν z
    obtain ⟨c', hc'⟩ := hcoef _ hν'
    have hrefl : P.reflection (z : p.rootIndex) ν =
        ν - P.toLinearMap ν (P.coroot (z : p.rootIndex)) • P.root (z : p.rootIndex) :=
      RootPairing.reflection_apply _ _ _
    have hrel : ∀ w : p.base.support, (c' w : ℤ) =
        c w + if w = z then P.toLinearMap ν (P.coroot (z : p.rootIndex)) else 0 := by
      have heq : ∑ w, ((c' w : ℤ) - (c w + if w = z then
          P.toLinearMap ν (P.coroot (z : p.rootIndex)) else 0)) • P.root (w : p.rootIndex) =
            0 := by
        simp only [sub_smul, add_smul, ite_smul, zero_smul, Finset.sum_sub_distrib,
          Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte,
          natCast_zsmul]
        rw [← hc', ← hc, hrefl]
        abel
      intro w
      have := hli Finset.univ _ heq w (Finset.mem_univ w)
      linarith
    have hheight : ∑ w ∈ Finset.univ.filter (· ∈ Z), c' w ≤ N := by
      have hsum : (∑ w ∈ Finset.univ.filter (· ∈ Z), (c' w : ℤ)) =
          ∑ w ∈ Finset.univ.filter (· ∈ Z), (c w : ℤ) +
            P.toLinearMap ν (P.coroot (z : p.rootIndex)) := by
        simp only [hrel, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_filter,
          Finset.mem_univ, true_and, hz, ↓reduceIte]
      have h2 : (∑ w ∈ Finset.univ.filter (· ∈ Z), (c w : ℤ)) ≤ N + 1 := by exact_mod_cast hN
      have h3 : ((∑ w ∈ Finset.univ.filter (· ∈ Z), c' w : ℕ) : ℤ) =
          ∑ w ∈ Finset.univ.filter (· ∈ Z), (c' w : ℤ) := by push_cast; rfl
      omega
    have h0 := ih _ hν' c' hc' hheight z hz
    rw [hrefl, map_sub, LinearMap.sub_apply, map_zsmul, LinearMap.smul_apply,
      RootPairing.root_coroot_two, smul_eq_mul] at h0
    linarith

end Cone

section EvenChain

variable {J : Type u} (C : p.EvenChainData J) (x : p.NormalizedSimpleRootParametrizations)

/-- The second merged simple root pairs to `-1` with the coroot of the first one. -/
theorem EvenChainData.pairing_b_a (c : J) :
    p.rootDatum.toLinearMap (p.rootDatum.root (C.modified c).b)
      (p.rootDatum.coroot (C.modified c).a) = -1 := by
  have hpos := (C.isPathComponent c).pos
  have h := (C.isPathComponent c).pairing_eq ⟨C.half c, by omega⟩ ⟨C.half c - 1, by omega⟩
  rw [ite_eq_right (by simp only; omega), ite_eq_left (by simp only; omega)] at h
  rw [RootPairing.root_coroot_eq_pairing, C.modified_a, C.modified_b, h]

/-- The merged root pairs to `1` with the coroot of the first merged simple root. -/
theorem EvenChainData.pairing_alpha_a (c : J) :
    p.rootDatum.toLinearMap (p.rootDatum.root (C.modified c).alpha)
      (p.rootDatum.coroot (C.modified c).a) = 1 := by
  rw [(C.modified c).root_eq, map_add, LinearMap.add_apply, RootPairing.root_coroot_two,
    C.pairing_b_a c]
  norm_num

/-- If every weight of `ρ` is orthogonal to the coroot of the first merged simple root of the
path `c`, every block of `c` acts trivially. -/
theorem EvenChainData.rationalMatrix_block_eq_one (ρ : MatrixRepresentation G n)
    (hspan : (⨆ ξ, p.representationWeightSpace ρ ξ) = ⊤) (c : J)
    (hz : ∀ ξ, p.representationWeightSpace ρ ξ ≠ ⊥ →
      p.rootDatum.toLinearMap ξ (p.rootDatum.coroot (C.modified c).a) = 0)
    (b : Bool) (s : k) (t : kˣ) :
    ρ.rationalMatrix (C.block x c b s t) = 1 := by
  unfold EvenChainData.block
  set D := C.modified c
  have ha : p.rootDatum.toLinearMap (p.rootDatum.root D.a) (p.rootDatum.coroot D.a) ≠ 0 := by
    rw [RootPairing.root_coroot_two]
    norm_num
  have hb : p.rootDatum.toLinearMap (p.rootDatum.root D.b) (p.rootDatum.coroot D.a) ≠ 0 := by
    rw [C.pairing_b_a c]
    norm_num
  have hα : p.rootDatum.toLinearMap (p.rootDatum.root D.alpha)
      (p.rootDatum.coroot D.a) ≠ 0 := by
    rw [C.pairing_alpha_a c]
    norm_num
  have hua : ρ.rationalMatrix (D.ua x) = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz ha (Subgroup.mem_sup_left
      (((x D.a).toRootParametrization.mem_rootSubgroup_iff _ _).mpr ⟨_, rfl⟩))
  have hub : ρ.rationalMatrix (D.ub x) = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz hb (Subgroup.mem_sup_left
      (((x D.b).toRootParametrization.mem_rootSubgroup_iff _ _).mpr ⟨_, rfl⟩))
  have hxα : ρ.rationalMatrix (D.xAlpha.rationalPoint s) = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz hα (Subgroup.mem_sup_left
      ((D.xAlpha.mem_rootSubgroup_iff _ _).mpr ⟨_, rfl⟩))
  have hnα : ρ.rationalMatrix D.nAlpha.point = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz hα (C.nAlpha_mem c)
  have hcor : ρ.rationalMatrix (corootRationalPoint p D.alpha t) = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz hα (corootRationalPoint_mem_rootSup _ t)
  split_ifs <;> simp only [map_mul, hua, hub, hxα, hnα, hcor, mul_one]

/-- If every weight of `ρ` is orthogonal to the coroot of the simple root `w`, the factor
`x_w(d) n_w` with the canonical representative acts trivially. -/
theorem rationalMatrix_rootFactor_eq_one (ρ : MatrixRepresentation G n)
    (hspan : (⨆ ξ, p.representationWeightSpace ρ ξ) = ⊤) {w : p.base.support}
    (hz : ∀ ξ, p.representationWeightSpace ρ ξ ≠ ⊥ →
      p.rootDatum.toLinearMap ξ (p.rootDatum.coroot w) = 0) (d : k) :
    ρ.rationalMatrix ((x w).toRootParametrization.rationalPoint d *
      (canonicalSimpleReflectionRepresentatives x w).point) = 1 := by
  have hw : p.rootDatum.toLinearMap (p.rootDatum.root w) (p.rootDatum.coroot w) ≠ 0 := by
    rw [RootPairing.root_coroot_two]
    norm_num
  have h1 : ρ.rationalMatrix ((x w).toRootParametrization.rationalPoint d) = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz hw (Subgroup.mem_sup_left
      (((x w).toRootParametrization.mem_rootSubgroup_iff _ _).mpr ⟨_, rfl⟩))
  have h2 : ρ.rationalMatrix (canonicalSimpleReflectionRepresentatives x w).point = 1 :=
    rationalMatrix_eq_one_of_mem_rootSup ρ hspan hz hw
      (x w).reflectionRepresentative_mem_generated
  rw [map_mul, h1, h2, mul_one]

/-! ### Representations at the end vertex of a path -/

/-- The weights of a highest-weight representation at the fundamental weight of the end vertex
of the path `c` are orthogonal to the coroots of all simple roots off that path. -/
theorem EvenChainData.pairing_eq_zero_of_not_mem_path {ρ : MatrixRepresentation G n}
    {lam : characterLattice p.torus} (hρ : p.IsHighestWeight ρ lam) {c : J}
    (hlam : IsPathFundamental (C.path c) lam) {w : p.base.support}
    (hw : w ∉ Set.range (C.path c)) (ξ : characterLattice p.torus)
    (hξ : p.representationWeightSpace ρ ξ ≠ ⊥) :
    p.rootDatum.toLinearMap ξ (p.rootDatum.coroot w) = 0 := by
  obtain ⟨j, -, rfl⟩ := exists_eq_pathWeight_of_isHighestWeight hρ (C.isPathComponent c) hlam hξ
  exact pairing_pathWeight_of_not_mem (C.isPathComponent c) hlam hw j

/-- The blocks of the other paths act trivially on a representation at the end vertex of the
path `c`. -/
theorem EvenChainData.rationalMatrix_block_eq_one_of_ne {ρ : MatrixRepresentation G n}
    {lam : characterLattice p.torus} (hρ : p.IsHighestWeight ρ lam) {c : J}
    (hlam : IsPathFundamental (C.path c) lam) {c' : J} (hc : c' ≠ c) (b : Bool) (s : k)
    (t : kˣ) : ρ.rationalMatrix (C.block x c' b s t) = 1 := by
  refine C.rationalMatrix_block_eq_one x ρ hρ.2.1 c' (fun ξ hξ =>
    C.pairing_eq_zero_of_not_mem_path hρ hlam ?_ ξ hξ) b s t
  rintro ⟨i, hi⟩
  rw [C.modified_a] at hi
  exact hc (C.disjoint c' c _ i hi.symm)

/-- The factors `x_w(d) n_w` of simple roots off the path `c` act trivially on a representation
at the end vertex of `c`. -/
theorem EvenChainData.rationalMatrix_rootFactor_eq_one_of_not_mem {ρ : MatrixRepresentation G n}
    {lam : characterLattice p.torus} (hρ : p.IsHighestWeight ρ lam) {c : J}
    (hlam : IsPathFundamental (C.path c) lam) {w : p.base.support}
    (hw : w ∉ Set.range (C.path c)) (d : k) :
    ρ.rationalMatrix ((x w).toRootParametrization.rationalPoint d *
      (canonicalSimpleReflectionRepresentatives x w).point) = 1 :=
  rationalMatrix_rootFactor_eq_one x ρ hρ.2.1
    (fun ξ hξ => C.pairing_eq_zero_of_not_mem_path hρ hlam hw ξ hξ) d

/-! ### Representations whose highest weight is orthogonal to all paths -/

/-- If the highest weight is orthogonal to the coroots of all path vertices, so is every
weight. -/
theorem EvenChainData.pairing_eq_zero_of_offPath {ρ : MatrixRepresentation G n}
    {lam : characterLattice p.torus} (hρ : p.IsHighestWeight ρ lam)
    (hlam : ∀ c i, p.rootDatum.toLinearMap lam (p.rootDatum.coroot (C.path c i)) = 0)
    (ξ : characterLattice p.torus) (hξ : p.representationWeightSpace ρ ξ ≠ ⊥) (c : J)
    (i : Fin (2 * C.half c)) :
    p.rootDatum.toLinearMap ξ (p.rootDatum.coroot (C.path c i)) = 0 := by
  refine pairing_eq_zero_of_isHighestWeight hρ {w | ∃ c i, C.path c i = w} ?_ ?_ hξ _
    ⟨c, i, rfl⟩
  · rintro _ ⟨c, i, rfl⟩ w hw
    exact ((C.isPathComponent c).isOrthogonal w (fun ⟨j, hj⟩ => hw ⟨c, j, hj⟩) i).1
  · rintro _ ⟨c, i, rfl⟩
    exact hlam c i

/-- The highest weight of a fundamental representation at a simple root off all paths is
orthogonal to the coroots of all path vertices. -/
theorem EvenChainData.fundamental_pairing_path_eq_zero {a : p.base.support}
    (F : p.FundamentalRepresentation a) (ha : ∀ c i, C.path c i ≠ a) (c : J)
    (i : Fin (2 * C.half c)) :
    p.rootDatum.toLinearMap F.highestWeight (p.rootDatum.coroot (C.path c i)) = 0 := by
  have h := F.isFundamentalWeight (C.path c i)
  rwa [ite_eq_right (ha c i)] at h

/-- All blocks act trivially on a representation whose highest weight is orthogonal to the
coroots of all path vertices. -/
theorem EvenChainData.rationalMatrix_block_eq_one_of_offPath {ρ : MatrixRepresentation G n}
    {lam : characterLattice p.torus} (hρ : p.IsHighestWeight ρ lam)
    (hlam : ∀ c i, p.rootDatum.toLinearMap lam (p.rootDatum.coroot (C.path c i)) = 0)
    (c : J) (b : Bool) (s : k) (t : kˣ) : ρ.rationalMatrix (C.block x c b s t) = 1 := by
  refine C.rationalMatrix_block_eq_one x ρ hρ.2.1 c (fun ξ hξ => ?_) b s t
  rw [C.modified_a]
  exact C.pairing_eq_zero_of_offPath hρ hlam ξ hξ c _

/-- The factors `x_w(d) n_w` of path vertices act trivially on a representation whose highest
weight is orthogonal to the coroots of all path vertices. -/
theorem EvenChainData.rationalMatrix_rootFactor_eq_one_of_offPath
    {ρ : MatrixRepresentation G n} {lam : characterLattice p.torus}
    (hρ : p.IsHighestWeight ρ lam)
    (hlam : ∀ c i, p.rootDatum.toLinearMap lam (p.rootDatum.coroot (C.path c i)) = 0)
    (c : J) (i : Fin (2 * C.half c)) (d : k) :
    ρ.rationalMatrix ((x (C.path c i)).toRootParametrization.rationalPoint d *
      (canonicalSimpleReflectionRepresentatives x (C.path c i)).point) = 1 :=
  rationalMatrix_rootFactor_eq_one x ρ hρ.2.1
    (fun ξ hξ => C.pairing_eq_zero_of_offPath hρ hlam ξ hξ c i) d

end EvenChain

end Langlands.GroupScheme.SplitPinning
