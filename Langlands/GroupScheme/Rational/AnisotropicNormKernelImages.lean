import Langlands.GroupScheme.Rational.AnisotropicCentralizerNormKernel
import Langlands.Representation.Plancherel.RationalUnramifiedRestriction

/-! # Images of anisotropic factors in arbitrary rational norm kernels -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
variable {A Z G : GroupScheme (Spec (CommRingCat.of F))}

/-- Every point of an anisotropic connected reductive source maps into the target norm kernel. -/
theorem IsAnisotropic.map_mem_rationalCommonNormKernel (hA : IsAnisotropic A)
    (hred : IsConnectedReductive A) (f : A ⟶ Z) (a : rationalPoints A) :
    rationalPoints.map f a ∈ Plancherel.rationalCommonNormKernel Z := by
  apply Plancherel.rationalCommonNormKernel_le_comap f
  rw [hA.rationalCommonNormKernel_eq_top hred]
  exact Subgroup.mem_top a

/-- The actual point map from an anisotropic factor, corestricted to the target norm kernel. -/
def IsAnisotropic.normKernelPointMap (hA : IsAnisotropic A)
    (hred : IsConnectedReductive A) (f : A ⟶ Z) :
    rationalPoints A →* Plancherel.rationalCommonNormKernel Z :=
  (rationalPoints.map f).codRestrict (Plancherel.rationalCommonNormKernel Z)
    (hA.map_mem_rationalCommonNormKernel hred f)

@[simp] theorem IsAnisotropic.normKernelPointMap_coe (hA : IsAnisotropic A)
    (hred : IsConnectedReductive A) (f : A ⟶ Z) (a : rationalPoints A) :
    (hA.normKernelPointMap hred f a : rationalPoints Z) = rationalPoints.map f a :=
  rfl

/-- The full image of the factor map lies in the target norm kernel. -/
theorem IsAnisotropic.range_le_rationalCommonNormKernel (hA : IsAnisotropic A)
    (hred : IsConnectedReductive A) (f : A ⟶ Z) :
    (rationalPoints.map f).range ≤ Plancherel.rationalCommonNormKernel Z := by
  rintro z ⟨a, rfl⟩
  exact hA.map_mem_rationalCommonNormKernel hred f a

/-- Mapping a factor further into an ambient group lands in the image of the intermediate norm kernel. -/
theorem IsAnisotropic.map_range_le_map_rationalCommonNormKernel (hA : IsAnisotropic A)
    (hred : IsConnectedReductive A) (f : A ⟶ Z) (j : Z ⟶ G) :
    ((rationalPoints.map f).range).map (rationalPoints.map j) ≤
      (Plancherel.rationalCommonNormKernel Z).map (rationalPoints.map j) :=
  Subgroup.map_mono (hA.range_le_rationalCommonNormKernel hred f)

variable {I : Type v} (Aᵢ : I → GroupScheme (Spec (CommRingCat.of F)))
  (hA : ∀ a, IsAnisotropic (Aᵢ a)) (hred : ∀ a, IsConnectedReductive (Aᵢ a))
  (f : ∀ a, Aᵢ a ⟶ Z)

include hA hred in
/-- The subgroup generated by any family of anisotropic factor images lies in the norm kernel. -/
theorem iSup_anisotropicPointMapRange_le_normKernel :
    (⨆ a, (rationalPoints.map (f a)).range) ≤
      Plancherel.rationalCommonNormKernel Z :=
  iSup_le fun a => (hA a).range_le_rationalCommonNormKernel (hred a) (f a)

include hA hred in
/-- The same generated subgroup, mapped into the ambient group, lies in the norm-kernel image. -/
theorem map_iSup_anisotropicPointMapRange_le_map_normKernel (j : Z ⟶ G) :
    (⨆ a, (rationalPoints.map (f a)).range).map (rationalPoints.map j) ≤
      (Plancherel.rationalCommonNormKernel Z).map (rationalPoints.map j) :=
  Subgroup.map_mono (iSup_anisotropicPointMapRange_le_normKernel Aᵢ hA hred f)

end Langlands.GroupScheme
