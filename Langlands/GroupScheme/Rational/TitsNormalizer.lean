import Mathlib.Algebra.CharP.Two
import Langlands.GroupScheme.Rational.LeviFactorization
import Langlands.GroupScheme.Rational.NormalizedRootExistenceProof
import Langlands.GroupScheme.Rational.RelativeRoots
import Langlands.GroupScheme.Rational.SimpleCorootCoordinates
import Langlands.GroupScheme.Rational.SteinbergCanonicalRepresentatives
import Langlands.GroupScheme.Rational.SteinbergCoxeterTorus
import Langlands.GroupScheme.Rational.SteinbergRootMapUniqueness

/-! # The Tits normalizer on field points

Source: `tits-1966-normalisateurs-de-tores-i`,
SHA-256 `8b05f6f9017c869388181f16c5598f2094d511ea9e46173c2a7b6f68fa6de96f`,
§§4.2(1)–(3), 4.4 and 4.6 (printed pp. 112–116, PDF pp. 17–21).
The constructions use the actual normalizer and coroots of a supplied split pinning.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.SplitPinning

set_option autoImplicit false

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (p : SplitPinning G)

/-- The family of simple-root maps normalized by the supplied pinning. -/
def normalizedSimpleRootParametrizations : p.NormalizedSimpleRootParametrizations :=
  Classical.choice (normalizedRootExistence k G p).1

/-- Every family normalized by this pinning agrees with the chosen family. -/
theorem normalizedSimpleRootParametrizations_eq (x : p.NormalizedSimpleRootParametrizations) :
    p.normalizedSimpleRootParametrizations = x :=
  Subsingleton.elim _ _

/-- The lifts formed from the unique ordered opposite factors at coordinate one. -/
def titsReflectionRepresentatives : p.SimpleReflectionRepresentatives :=
  canonicalSimpleReflectionRepresentatives p.normalizedSimpleRootParametrizations

/-- The pinned lift of a simple reflection as an actual normalizer point. -/
def titsNormalizerPoint (a : p.base.support) : normalizerPoints p.inclusion :=
  (p.titsReflectionRepresentatives a).normalizerPoint

private local instance : Mono p.inclusion.hom.hom.left := p.isMaximalTorus.2.1.mono

/-- The pinned lift acts by the simple reflection on the full character lattice. -/
theorem weylAction_titsNormalizerPoint (a : p.base.support) :
    weylAction p.inclusion (p.titsNormalizerPoint a) = p.rootDatum.reflection a :=
  (p.titsReflectionRepresentatives a).weylAction_normalizerPoint

/-- The subgroup of actual normalizer points generated by the pinned lifts. -/
def titsNormalizer : Subgroup (normalizerPoints p.inclusion) :=
  Subgroup.closure (Set.range p.titsNormalizerPoint)

theorem titsNormalizerPoint_mem (a : p.base.support) :
    p.titsNormalizerPoint a ∈ p.titsNormalizer :=
  Subgroup.subset_closure (Set.mem_range_self a)

/-- The pinned lift as a generator in the Tits normalizer subgroup. -/
def titsNormalizerGenerator (a : p.base.support) : p.titsNormalizer :=
  ⟨p.titsNormalizerPoint a, p.titsNormalizerPoint_mem a⟩

@[simp] theorem coe_titsNormalizerGenerator (a : p.base.support) :
    (p.titsNormalizerGenerator a : normalizerPoints p.inclusion) = p.titsNormalizerPoint a :=
  rfl

/-- The restriction of the actual normalizer quotient map to the Tits subgroup. -/
def titsWeylProjection : p.titsNormalizer →* relativeWeylGroup p.inclusion :=
  (QuotientGroup.mk' ((centralizerPoints p.inclusion).subgroupOf
    (normalizerPoints p.inclusion))).comp p.titsNormalizer.subtype

@[simp] theorem titsWeylProjection_titsNormalizerGenerator (a : p.base.support) :
    p.titsWeylProjection (p.titsNormalizerGenerator a) =
      (QuotientGroup.mk (p.titsNormalizerPoint a) : relativeWeylGroup p.inclusion) :=
  rfl

/-- The actual torus inclusion on field points, with values in the normalizer. -/
def torusPointsToNormalizer : rationalPoints p.torus.toGrp →* normalizerPoints p.inclusion :=
  (rationalPoints.map p.inclusion).codRestrict _ fun t => by
    apply centralizerPoints_le_normalizerPoints p.inclusion
    rw [← torusCentralizer_carrier_base]
    exact range_le_torusCentralizer p.inclusion _ (SubgroupFunctor.mem_range.mpr ⟨t, rfl⟩)

@[simp] theorem coe_torusPointsToNormalizer (t : rationalPoints p.torus.toGrp) :
    (p.torusPointsToNormalizer t : rationalPoints G) = rationalPoints.map p.inclusion t :=
  rfl

/-- The subgroup of actual torus points generated by the simple coroot values at `-1`. -/
def titsSignSubgroup : Subgroup (rationalPoints p.torus.toGrp) :=
  Subgroup.closure (Set.range fun a : p.base.support => p.simpleCorootPoint a (-1))

/-- The simple coroot at `-1` as an element of the sign subgroup. -/
def titsSignGenerator (a : p.base.support) : p.titsSignSubgroup :=
  ⟨p.simpleCorootPoint a (-1), Subgroup.subset_closure (Set.mem_range_self a)⟩

@[simp] theorem coe_titsSignGenerator (a : p.base.support) :
    (p.titsSignGenerator a : rationalPoints p.torus.toGrp) = p.simpleCorootPoint a (-1) :=
  rfl

/-- The image of the sign subgroup in the actual normalizer. -/
def titsSignSubgroupInNormalizer : Subgroup (normalizerPoints p.inclusion) :=
  p.titsSignSubgroup.map p.torusPointsToNormalizer

theorem titsNormalizer_eq_bot_of_isEmpty [IsEmpty p.base.support] :
    p.titsNormalizer = ⊥ := by
  rw [titsNormalizer, Set.range_eq_empty, Subgroup.closure_empty]

theorem titsSignSubgroup_eq_bot_of_isEmpty [IsEmpty p.base.support] :
    p.titsSignSubgroup = ⊥ := by
  rw [titsSignSubgroup, Set.range_eq_empty, Subgroup.closure_empty]

/-- In characteristic two the simple-coroot sign values are all the identity. -/
theorem titsSignSubgroup_eq_bot_of_charTwo [CharP k 2] :
    p.titsSignSubgroup = ⊥ := by
  have hneg : (-1 : kˣ) = 1 := Units.ext CharTwo.neg_one_eq_one
  refine le_antisymm ((Subgroup.closure_le _).mpr ?_) bot_le
  rintro _ ⟨a, rfl⟩
  simp [hneg]

end Langlands.GroupScheme.SplitPinning
