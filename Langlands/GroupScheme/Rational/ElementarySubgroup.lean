import Langlands.GroupScheme.Rational.LeviSubgroup
import Langlands.GroupScheme.Rational.ParabolicAmbientTransport
import Langlands.GroupScheme.Rational.ParabolicPointConjugation

/-! # The elementary subgroup generated by actual parabolic unipotent radicals -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {G G' : GroupScheme (Spec (CommRingCat.of k))}

/-- Rational points in the image of a geometric unipotent radical of an actual
parabolic subgroup. All ground-field representatives are allowed. -/
def parabolicUnipotentPointSet (G : GroupScheme (Spec (CommRingCat.of k))) :
    Set (rationalPoints G) :=
  {x | ∃ (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ G) (r : U ⟶ P),
    IsParabolicSubgroup p ∧ LeviSubgroup.IsGeometricUnipotentRadical r ∧
      x ∈ (rationalPoints.map (r ≫ p)).range}

/-- The subgroup of `G(k)` generated by the rational points of the geometric
unipotent radicals of all actual parabolic `k`-subgroups. -/
def parabolicElementarySubgroup (G : GroupScheme (Spec (CommRingCat.of k))) :
    Subgroup (rationalPoints G) :=
  Subgroup.closure (parabolicUnipotentPointSet G)

/-- Every represented parabolic radical contributes all of its rational points. -/
theorem parabolic_radical_range_le_elementarySubgroup
    {P U : GroupScheme (Spec (CommRingCat.of k))} {p : P ⟶ G} {r : U ⟶ P}
    (hp : IsParabolicSubgroup p) (hr : LeviSubgroup.IsGeometricUnipotentRadical r) :
    (rationalPoints.map (r ≫ p)).range ≤ parabolicElementarySubgroup G := by
  intro x hx
  exact Subgroup.subset_closure ⟨P, U, p, r, hp, hr, hx⟩

/-- The elementary subgroup is the least subgroup containing every actual
parabolic radical's rational-point image. No normality premise is needed. -/
theorem parabolicElementarySubgroup_le_iff (E : Subgroup (rationalPoints G)) :
    parabolicElementarySubgroup G ≤ E ↔
      ∀ (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ G) (r : U ⟶ P),
        IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
          (rationalPoints.map (r ≫ p)).range ≤ E := by
  rw [parabolicElementarySubgroup, Subgroup.closure_le]
  constructor
  · intro h P U p r hp hr x hx
    exact h ⟨P, U, p, r, hp, hr, hx⟩
  · rintro h x ⟨P, U, p, r, hp, hr, hx⟩
    exact h P U p r hp hr hx

/-- Ambient isomorphisms take actual parabolic-radical generators to generators. -/
theorem map_mem_parabolicUnipotentPointSet (e : G ≅ G')
    {x : rationalPoints G} (hx : x ∈ parabolicUnipotentPointSet G) :
    rationalPoints.map e.hom x ∈ parabolicUnipotentPointSet G' := by
  obtain ⟨P, U, p, r, hp, hr, y, rfl⟩ := hx
  refine ⟨P, U, p ≫ e.hom, r, hp.comp_iso e, hr, y, ?_⟩
  simp only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc]

/-- The rational-point image under an ambient isomorphism preserves the
subgroup generated by parabolic radicals. -/
theorem parabolicElementarySubgroup_map_le (e : G ≅ G') :
    (parabolicElementarySubgroup G).map (rationalPoints.map e.hom) ≤
      parabolicElementarySubgroup G' := by
  rw [Subgroup.map_le_iff_le_comap, parabolicElementarySubgroup, Subgroup.closure_le]
  intro x hx
  exact Subgroup.subset_closure (map_mem_parabolicUnipotentPointSet e hx)

/-- The elementary subgroup is invariant under arbitrary ambient group-scheme
isomorphisms over the ground field. -/
theorem parabolicElementarySubgroup_map_eq (e : G ≅ G') :
    (parabolicElementarySubgroup G).map (rationalPoints.map e.hom) =
      parabolicElementarySubgroup G' := by
  apply le_antisymm (parabolicElementarySubgroup_map_le e)
  intro x hx
  refine Subgroup.mem_map.mpr ⟨rationalPoints.map e.inv x, ?_, ?_⟩
  · exact parabolicElementarySubgroup_map_le e.symm (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
  · simp only [rationalPoints.map_apply, Category.assoc, ← Grp.comp_hom_hom,
      e.inv_hom_id, Grp.id_hom_hom, Category.comp_id]

/-- Conjugating parabolic subgroups proves normality of the generated subgroup. -/
instance parabolicElementarySubgroup_normal : (parabolicElementarySubgroup G).Normal where
  conj_mem n hn g := by
    have h := parabolicElementarySubgroup_map_le (G.innerIso g)
      (Subgroup.mem_map.mpr ⟨n, hn, rfl⟩)
    rw [rationalPoints_map_innerIso] at h
    exact h

/-- Thus ordinary subgroup generation agrees with the normal-subgroup generation
used in the definition of `G(k)^+` in the Kneser–Tits problem. -/
theorem normalClosure_parabolicUnipotentPointSet :
    Subgroup.normalClosure (parabolicUnipotentPointSet G) = parabolicElementarySubgroup G := by
  apply le_antisymm
  · exact Subgroup.normalClosure_le_normal Subgroup.subset_closure
  · exact Subgroup.closure_le_normalClosure

end Langlands.GroupScheme
