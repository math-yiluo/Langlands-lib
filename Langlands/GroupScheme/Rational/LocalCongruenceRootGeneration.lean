import Langlands.GroupScheme.Rational.LocalRootGeneration
import Langlands.GroupScheme.IntegralModel.KernelCentralizerRoots

/-! # Congruence generation by actual integral root intersections -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 1600000

namespace Langlands.GroupScheme.RelativeRoot

/-- An ordered product chart reflects a section's congruence to the identity
in each individual factor. The restriction map may be any change of base. -/
theorem range_inf_restrictionKernel_le_of_orderedProductIso
    {B B' : Scheme.{u}} (b : B' ⟶ B)
    {G U : GroupScheme B} {n : ℕ}
    {H : Fin n → GroupScheme B} (j : ∀ r, H r ⟶ G) (jU : U ⟶ G)
    [Mono jU.hom.hom]
    (e : (∏ᶜ H).X ≅ U.X)
    (he : e.hom ≫ jU.hom.hom = orderedMultiplication j)
    (Q : Subgroup ((𝟙_ (Over B) ⟶ G.X)))
    (hQ : ∀ r, (SubgroupFunctor.range (j r)).carrier (𝟙_ (Over B)) ⊓
      (baseChangeSectionHom b G).ker ≤ Q) :
    (SubgroupFunctor.range jU).carrier (𝟙_ (Over B)) ⊓
      (baseChangeSectionHom b G).ker ≤ Q := by
  have : Mono (orderedMultiplication j) := by
    rw [← he]
    infer_instance
  have hone : (1 : (𝟙_ (Over B) ⟶ (∏ᶜ H).X)) ≫ orderedMultiplication j = 1 := by
    rw [comp_orderedMultiplication]
    simp [orderedPoints]
  rintro g ⟨hg, hgb⟩
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hg
  let p := y ≫ e.inv
  have hp : p ≫ orderedMultiplication j = y ≫ jU.hom.hom := by
    simp only [p, ← he, Category.assoc, Iso.inv_hom_id_assoc]
  let t : Over.mk b ⟶ 𝟙_ (Over B) := Over.homMk b (by simp)
  have hred : t ≫ (y ≫ jU.hom.hom) = t ≫ (1 : (𝟙_ (Over B) ⟶ G.X)) := by
    apply Over.OverMorphism.ext
    apply (baseChangeSectionHom_eq_iff b G _ _).mp
    exact hgb.trans (map_one _).symm
  have hpmod : t ≫ p = t ≫ (1 : (𝟙_ (Over B) ⟶ (∏ᶜ H).X)) := by
    apply (cancel_mono (orderedMultiplication j)).mp
    simpa only [Category.assoc, hp, hone] using hred
  rw [← hp, comp_orderedMultiplication]
  unfold orderedPoints
  apply Q.list_prod_mem
  intro z hz
  obtain ⟨r, rfl⟩ := List.mem_ofFn.mp hz
  apply hQ r
  refine ⟨SubgroupFunctor.mem_range.mpr ⟨_, rfl⟩, ?_⟩
  change baseChangeSectionHom b G
    (finiteProductPointsEquiv H _ p r ≫ (j r).hom.hom) = 1
  rw [← map_one (baseChangeSectionHom b G)]
  apply (baseChangeSectionHom_eq_iff b G _ _).mpr
  have h := congrArg
    (fun z => z ≫ (Pi.π H r).hom.hom ≫ (j r).hom.hom) hpmod
  have hone' : (1 : (𝟙_ (Over B) ⟶ (∏ᶜ H).X)) ≫
      (Pi.π H r).hom.hom ≫ (j r).hom.hom = (1 : (𝟙_ (Over B) ⟶ G.X)) := by simp
  simp only [Category.assoc, hone'] at h
  exact congrArg (fun z => z.left) h

section LocalDomain

variable {R k : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    [Field k] [Algebra R k]
    (I : Type u) [Fintype I] [DecidableEq I]
    {G : GroupScheme (Spec (CommRingCat.of R))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [GeometricallyConnected G.X.hom]
    (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G)

local instance localCongruenceRootGenerationFibreAffine :
    IsAffineHom ((GroupScheme.baseChange (algebraBaseMap R k)).obj G).X.hom :=
  inferInstanceAs (IsAffineHom (pullback.snd G.X.hom (algebraBaseMap R k)))

local instance localCongruenceRootGenerationAbsoluteAffine : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom

/-- At any specified restriction, the congruence part of the dynamic radical
is generated by the congruence parts of the actual integral root functors. -/
theorem dynamicUnipotent_inf_restrictionKernel_le_of_exponentRoots
    [Mono (splitTorus.baseChangeHom (K := k) G I i).hom.hom.left]
    (hroot : HasRelativeRootSystem
      (T := splitTorus.commGroupScheme (Spec (CommRingCat.of k)) I)
      (splitTorus.baseChangeHom (K := k) G I i))
    (ν : I → ℤ) {B' : Scheme.{u}} (b : B' ⟶ Spec (CommRingCat.of R))
    (Q : Subgroup (rationalPoints G))
    (hQ : ∀ m : I → ℤ,
      splitTorus.exponentCharacter (Spec (CommRingCat.of k)) I m ∈
        relativeRoots (T := splitTorus.commGroupScheme (Spec (CommRingCat.of k)) I)
          (splitTorus.baseChangeHom (K := k) G I i) →
      (subgroup i (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I m)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ (baseChangeSectionHom b G).ker ≤ Q) :
    (Dynamic.unipotent (CommGroupScheme.groupHom
      (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ (baseChangeSectionHom b G).ker ≤ Q := by
  classical
  let ik : (splitTorus.commGroupScheme (Spec (CommRingCat.of k)) I).toGrp ⟶
      (GroupScheme.baseChange (algebraBaseMap R k)).obj G :=
    splitTorus.baseChangeHom (K := k) G I i
  let νk := splitTorus.exponentCocharacter (Spec (CommRingCat.of k)) I ν
  obtain ⟨n, a, hinj, ha⟩ := exists_fin_enumeration_indivisiblePositiveRoots ik νk
    (hroot.finite_relativeRoots ik (isSplitTorus_splitTorus I))
  let m (r : Fin n) : I → ℤ := splitTorus.characterLatticeEquiv k I (a r)
  have hmk (r : Fin n) :
      splitTorus.exponentCharacter (Spec (CommRingCat.of k)) I (m r) = a r := by
    rw [splitTorus.exponentCharacter_eq_characterLatticeEquiv_symm]
    exact AddEquiv.symm_apply_apply _ _
  have ham (r : Fin n) : a r ∈ indivisiblePositiveRoots ik νk :=
    ha ▸ Set.mem_range_self r
  have hmR (r : Fin n) :
      splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I (m r) ≠ 0 := by
    have hcoord : splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I (m r) =
        (splitTorus.characterLatticeEquiv R I).symm (m r) :=
      (splitTorus.characterLatticeEquiv_symm_eq R I (m r)).symm
    intro hz
    have hmzero : m r = 0 := by
      apply (splitTorus.characterLatticeEquiv R I).symm.injective
      simpa only [map_zero] using hcoord.symm.trans hz
    have hakzero : a r = 0 := by
      rw [← hmk r, hmzero,
        splitTorus.exponentCharacter_eq_characterLatticeEquiv_symm, map_zero]
    exact (ham r).1.1.1 hakzero
  have hrep (r : Fin n) := Domain.subgroup_has_smooth_geometricallyConnected_closed_representative
    (isSplitTorus_splitTorus I) i
    (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I (m r)) (hmR r)
  choose H j hj hclosed haff hsm hconn using hrep
  let χ := CommGroupScheme.groupHom
    (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i
  let jU := Dynamic.Affine.unipotentHom χ
  have hU := Dynamic.Affine.isRepresentedBy_unipotentHom χ
  let : Mono jU.hom.hom := hU.1
  have hdisj : ∀ a ∈ indivisiblePositiveRoots ik νk,
      ∀ b ∈ indivisiblePositiveRoots ik νk, a ≠ b →
      Disjoint (cyclicTail a 1 : Set (characterLattice
        (splitTorus.commGroupScheme (Spec (CommRingCat.of k)) I)))
        (cyclicTail b 1 : Set (characterLattice
          (splitTorus.commGroupScheme (Spec (CommRingCat.of k)) I))) := by
    intro a ha b hb hne
    exact disjoint_cyclicTail_indivisibleRoots ik hroot (isSplitTorus_splitTorus I)
      ha.1 hb.1 hne
  obtain ⟨e, he⟩ := exists_orderedRootProductIso_localRing (k := k) I i ν
    hdisj m (by simpa only [hmk] using hinj)
    (by simpa only [hmk] using ha) hU j hj hsm
  rw [← hU.2]
  apply range_inf_restrictionKernel_le_of_orderedProductIso b j jU e he Q
  intro r
  rw [(hj r).2]
  exact hQ (m r) (by rw [hmk]; exact (ham r).1.1)

end LocalDomain

section CongruenceGeneration

variable {R K : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))}
    (M : IntegralModel R K G)
    [Smooth M.group.X.hom] [GeometricallyConnected M.group.X.hom]
    (I : Type u) [Fintype I] [DecidableEq I]
    (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ M.group)

/-- The subgroup generated by the prescribed congruence intersections with
all integral root functors selected by generic roots and a dynamic centralizer. -/
def exponentRootCentralizerCongruenceSubgroup (ν : I → ℤ) (n : ℕ+) :
    Subgroup M.integralSections :=
  (⨆ m : {m : I → ℤ //
      splitTorus.exponentCharacter (Spec (CommRingCat.of K)) I m ∈
        relativeRoots (T := splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I)
          (splitTorus.baseChangeHom (K := K) M.group I i)},
    (subgroup i (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I m.val)).carrier
      (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n) ⊔
    ((Dynamic.centralizer (CommGroupScheme.groupHom
      (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n)

/-- Every prescribed positive congruence kernel is generated by its intersections
with the actual integral root functors and a dynamic centralizer. -/
theorem congruenceKernelAt_le_of_exponentRoots_and_dynamicCentralizer
    [Mono (splitTorus.baseChangeHom (K := K) M.group I i).hom.hom.left]
    (hroot : HasRelativeRootSystem
      (T := splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I)
      (splitTorus.baseChangeHom (K := K) M.group I i))
    (ν : I → ℤ) (n : ℕ+) (Q : Subgroup M.integralSections)
    (hQ : ∀ m : I → ℤ,
      splitTorus.exponentCharacter (Spec (CommRingCat.of K)) I m ∈
        relativeRoots (T := splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I)
          (splitTorus.baseChangeHom (K := K) M.group I i) →
      (subgroup i (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I m)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n ≤ Q)
    (hZ : (Dynamic.centralizer (CommGroupScheme.groupHom
      (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n ≤ Q) :
    M.congruenceKernelAt n ≤ Q := by
  let χ := CommGroupScheme.groupHom
    (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i
  have hneg : CommGroupScheme.groupHom (Gm.powerHom _ (-1)) ≫ χ =
      CommGroupScheme.groupHom
        (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I (-ν)) ≫ i := by
    have hc : Gm.powerHom (Spec (CommRingCat.of R)) (-1) ≫
        splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν =
        splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I (-ν) := by
      rw [Gm.powerHom_apply, neg_one_zsmul, Preadditive.neg_comp, Category.id_comp]
      simp only [splitTorus.exponentCocharacter, Pi.neg_apply,
        neg_smul, Finset.sum_neg_distrib]
    change _ ≫ (_ ≫ i) = _
    rw [← Category.assoc]
    change CommGroupScheme.groupHom (Gm.powerHom _ (-1) ≫
      splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i = _
    rw [hc]
  have hV : (SubgroupFunctor.range (Dynamic.Affine.unipotentHom
      (CommGroupScheme.groupHom (Gm.powerHom _ (-1)) ≫ χ))).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n ≤ Q := by
    rw [(Dynamic.Affine.isRepresentedBy_unipotentHom _).2, hneg]
    exact dynamicUnipotent_inf_restrictionKernel_le_of_exponentRoots
      (k := K) I i hroot (-ν) (IntegralModel.congruenceBaseMap R n) Q hQ
  have hU : (SubgroupFunctor.range (Dynamic.Affine.unipotentHom χ)).carrier
      (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n ≤ Q := by
    rw [(Dynamic.Affine.isRepresentedBy_unipotentHom _).2]
    exact dynamicUnipotent_inf_restrictionKernel_le_of_exponentRoots
      (k := K) I i hroot ν (IntegralModel.congruenceBaseMap R n) Q hQ
  have hC : (SubgroupFunctor.range (Dynamic.Affine.centralizerHom χ)).carrier
      (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓ M.congruenceKernelAt n ≤ Q := by
    rw [(Dynamic.Affine.isRepresentedBy_centralizerHom _).2]
    exact hZ
  let D := IntegralModel.DynamicModels.tripleCell M χ
  intro g hg
  obtain ⟨t, ht⟩ := (D.congruenceProductEquiv n).surjective ⟨g, hg⟩
  have hv : rationalPoints.map D.negativeMap.hom t.1.val ∈ Q := by
    apply hV
    exact ⟨SubgroupFunctor.mem_range.mpr ⟨t.1.val, rfl⟩,
      D.negativeMap.map_mem_congruenceKernelAt n t.1.property⟩
  have hz : rationalPoints.map D.middleMap.hom t.2.1.val ∈ Q := by
    apply hC
    exact ⟨SubgroupFunctor.mem_range.mpr ⟨t.2.1.val, rfl⟩,
      D.middleMap.map_mem_congruenceKernelAt n t.2.1.property⟩
  have hu : rationalPoints.map D.positiveMap.hom t.2.2.val ∈ Q := by
    apply hU
    exact ⟨SubgroupFunctor.mem_range.mpr ⟨t.2.2.val, rfl⟩,
      D.positiveMap.map_mem_congruenceKernelAt n t.2.2.property⟩
  have hval := congrArg Subtype.val ht
  rw [D.congruenceProductEquiv_val] at hval
  exact (congrArg (fun x : M.integralSections => x ∈ Q) hval).mp
    (Q.mul_mem (Q.mul_mem hv hz) hu)

/-- The explicit generated subgroup is exactly the prescribed positive
congruence kernel, with the same original integral sections. -/
theorem exponentRootCentralizerCongruenceSubgroup_eq
    [Mono (splitTorus.baseChangeHom (K := K) M.group I i).hom.hom.left]
    (hroot : HasRelativeRootSystem
      (T := splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I)
      (splitTorus.baseChangeHom (K := K) M.group I i)) (ν : I → ℤ) (n : ℕ+) :
    exponentRootCentralizerCongruenceSubgroup M I i ν n = M.congruenceKernelAt n := by
  apply le_antisymm
  · exact sup_le (iSup_le fun _ => inf_le_right) inf_le_right
  · apply congruenceKernelAt_le_of_exponentRoots_and_dynamicCentralizer M I i hroot ν n
    · intro m hm
      exact le_sup_of_le_left (le_iSup_of_le ⟨m, hm⟩ le_rfl)
    · exact le_sup_right

end CongruenceGeneration

end Langlands.GroupScheme.RelativeRoot
