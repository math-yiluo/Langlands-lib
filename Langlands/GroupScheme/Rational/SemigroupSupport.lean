import Langlands.GroupScheme.Rational.SemigroupClosure
import Langlands.GroupScheme.Rational.SemigroupPartition

/-! # Actual semigroup generators depend only on occurring weights -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeRoot

variable {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]

/-- The actual smooth connected closed invariant subgroup functors whose
intrinsic weights lie in a specified set. This is a family of generators,
not a new subgroup construction. -/
def weightSupportedGenerators (b : AutomorphicAction S.toGrp G)
    (Ξ : Set (characterLattice S)) : Set (SubgroupFunctor G) :=
  {F | IsSmoothConnectedClosed F ∧ b.IsStable F ∧ actionWeightSupport b F ⊆ Ξ}

/-- An intrinsic weight bound only tests the part of the bound that occurs
in the ambient action. -/
theorem actionWeightSupport_subset_iff_inter_total (b : AutomorphicAction S.toGrp G)
    (F : SubgroupFunctor G) (Ξ : Set (characterLattice S)) :
    actionWeightSupport b F ⊆ Ξ ↔
      actionWeightSupport b F ⊆ Ξ ∩ actionWeightSupport b ⊤ := by
  constructor
  · intro h χ hχ
    exact ⟨h hχ,
      actionWeightSupport_mono b (fun _ _ _ => Subgroup.mem_top _) hχ⟩
  · intro h χ hχ
    exact (h hχ).1

/-- Removing all nonoccurring characters preserves the family of generators. -/
theorem weightSupportedGenerators_inter_total (b : AutomorphicAction S.toGrp G)
    (Ξ : Set (characterLattice S)) :
    weightSupportedGenerators b (Ξ ∩ actionWeightSupport b ⊤) =
      weightSupportedGenerators b Ξ := by
  ext F
  exact and_congr_right' (and_congr_right'
    (actionWeightSupport_subset_iff_inter_total b F Ξ).symm)

/-- Enlarging a character bound enlarges its family of actual generators. -/
theorem weightSupportedGenerators_mono (b : AutomorphicAction S.toGrp G)
    {Ξ Ξ' : Set (characterLattice S)} (h : Ξ ⊆ Ξ') :
    weightSupportedGenerators b Ξ ⊆ weightSupportedGenerators b Ξ' := by
  rintro F ⟨hF, hstable, hsupport⟩
  exact ⟨hF, hstable, hsupport.trans h⟩

/-- The semigroup predicate uses precisely the corresponding family of
actual smooth connected invariant generators. -/
theorem isSemigroupGenerator_iff_mem (b : AutomorphicAction S.toGrp G)
    (A : AddSubsemigroup (characterLattice S)) (F : SubgroupFunctor G) :
    IsSemigroupGenerator b A F ↔
      F ∈ weightSupportedGenerators b (A : Set (characterLattice S)) := Iff.rfl

section Partition

variable (b : AutomorphicAction S.toGrp G) {I : Type v}
    (Ψ : I → Set (characterLattice S))
    (hcover : (⋃ r, Ψ r) = actionWeightSupport b ⊤)
    (hcross : ∀ r q : I, r ≠ q →
      Disjoint (Ψ r)
        (AddSubsemigroup.closure (Ψ q) : Set (characterLattice S)))

include hcover hcross

/-- Exact cross-exclusion identifies the actual generator family for a
generated semigroup with the family bounded by its original block. -/
theorem weightSupportedGenerators_closure_eq (r : I) :
    weightSupportedGenerators b
        (AddSubsemigroup.closure (Ψ r) : Set (characterLattice S)) =
      weightSupportedGenerators b (Ψ r) := by
  rw [← weightSupportedGenerators_inter_total b,
    WeightPartition.closure_inter_support hcover hcross r]

/-- The generator predicate for a factor retains exactly the original block
bound, without assuming the generated semigroups are disjoint. -/
theorem isSemigroupGenerator_closure_iff (r : I) (F : SubgroupFunctor G) :
    IsSemigroupGenerator b (AddSubsemigroup.closure (Ψ r)) F ↔
      IsSmoothConnectedClosed F ∧ b.IsStable F ∧ actionWeightSupport b F ⊆ Ψ r := by
  rw [isSemigroupGenerator_iff_mem,
    weightSupportedGenerators_closure_eq b Ψ hcover hcross r]
  rfl

/-- On each test scheme, the canonical factor is generated by precisely the
points of smooth connected invariant subgroups supported in its original block. -/
theorem semigroupSubgroup_closure_carrier (r : I)
    (T : Over (Spec (CommRingCat.of k))) :
    (semigroupSubgroup b (AddSubsemigroup.closure (Ψ r))).carrier T =
      Subgroup.closure {g | ∃ F : SubgroupFunctor G,
        (IsSmoothConnectedClosed F ∧ b.IsStable F ∧
          actionWeightSupport b F ⊆ Ψ r) ∧ g ∈ F.carrier T} := by
  change Subgroup.closure _ = Subgroup.closure _
  congr 1
  ext g
  simp only [Set.mem_ofPred_eq, isSemigroupGenerator_closure_iff b Ψ hcover hcross r]

/-- The all-test universal property of each canonical factor may be tested
using the original-block support bound. -/
theorem semigroupSubgroup_closure_le_iff (r : I) (H : SubgroupFunctor G) :
    semigroupSubgroup b (AddSubsemigroup.closure (Ψ r)) ≤ H ↔
      ∀ F : SubgroupFunctor G,
        (IsSmoothConnectedClosed F ∧ b.IsStable F ∧
          actionWeightSupport b F ⊆ Ψ r) → F ≤ H := by
  rw [semigroupSubgroup_le_iff]
  simp only [isSemigroupGenerator_closure_iff b Ψ hcover hcross r]

end Partition

end Langlands.GroupScheme.RelativeRoot
