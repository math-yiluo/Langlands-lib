import Langlands.GroupScheme.Rational.CentralIsogenySquareLift
import Langlands.GroupScheme.Rational.NumberFieldQuaternionicNormOneIsometryHasse
import Langlands.GroupScheme.Quaternionic.SkewUnitaryDivisionSquares
import Langlands.GroupScheme.Quaternionic.SkewUnitarySplitSquares
import Langlands.GroupScheme.Quaternionic.QuaternionCoefficientDichotomy
import Langlands.GroupScheme.Quaternionic.BinaryQuaternionAction
import Langlands.GroupScheme.Quaternionic.QuaternionicOppositeSkewValues

/-! # The real boundary of the quaternionic spin cover

At a real place `v` of a number field `F` where `D` stays a division algebra or the quadratic
form stays anisotropic, the image in the simply connected cover `G` of the Kummer cocycle of
`a ∈ F_vˣ` is a coboundary only when `a` is a square of `F_v`.

The completion `K = F_v` is isomorphic to `ℝ`. The points `H(K)` of the reduced-norm-one isometry
group are special unitary matrices of the skew Gram matrix `conjugationSkewGram q` over `K ⊗ D`.
If `K ⊗ D` is a division algebra, or splits with the form anisotropic, this group is generated by
squares. Squares lift through the central isogeny `G → H` with kernel `μ₂`, so `G(K) → H(K)` is
surjective, and the Kummer computation then forces `a` to be a square.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry NumberField
open scoped TensorProduct CategoryTheory.MonObj

namespace Langlands.GroupScheme

open Quaternionic Quaternionic.SkewUnitary

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

section RealFacts

variable {K : Type u} [Field K] (ψ : K ≃+* ℝ)

include ψ in
theorem isSquare_iff_of_ringEquivReal (t : K) : IsSquare t ↔ 0 ≤ ψ t := by
  constructor
  · rintro ⟨r, rfl⟩
    rw [map_mul]
    exact mul_self_nonneg _
  · intro h
    refine ⟨ψ.symm (Real.sqrt (ψ t)), ψ.injective ?_⟩
    rw [map_mul, RingEquiv.apply_symm_apply, Real.mul_self_sqrt h]

include ψ in
theorem isSquare_or_isSquare_neg_of_ringEquivReal (t : K) : IsSquare t ∨ IsSquare (-t) := by
  rcases le_total 0 (ψ t) with h | h
  · exact Or.inl ((isSquare_iff_of_ringEquivReal ψ t).mpr h)
  · refine Or.inr ((isSquare_iff_of_ringEquivReal ψ (-t)).mpr ?_)
    rw [map_neg]
    linarith

include ψ in
theorem isSquare_add_mul_self_of_ringEquivReal (s t : K) : IsSquare (s * s + t * t) := by
  apply (isSquare_iff_of_ringEquivReal ψ _).mpr
  rw [map_add, map_mul, map_mul]
  exact add_nonneg (mul_self_nonneg _) (mul_self_nonneg _)

include ψ in
theorem not_isSquare_neg_one_of_ringEquivReal : ¬ IsSquare (-1 : K) := by
  rw [isSquare_iff_of_ringEquivReal ψ, map_neg, map_one]
  norm_num

end RealFacts

/-- In a finite-dimensional algebra over a field without zero divisors every nonzero element is
invertible. -/
theorem isUnit_of_ne_zero_of_isDomain {K A : Type u} [Field K] [Ring A] [Algebra K A]
    [FiniteDimensional K A] [IsDomain A] {y : A} (hy : y ≠ 0) : IsUnit y := by
  let L : A →ₗ[K] A := LinearMap.mulLeft K y
  have hL : Function.Injective L := fun a b h => mul_left_cancel₀ hy h
  obtain ⟨z, hz⟩ := (LinearMap.injective_iff_surjective.mp hL) 1
  change y * z = 1 at hz
  have hzy : z * y = 1 := by
    apply mul_left_cancel₀ hy
    rw [← mul_assoc, hz, one_mul, mul_one]
  exact ⟨⟨y, z, hz, hzy⟩, rfl⟩

section Anisotropy

variable {F D : Type u} [Field F] [DivisionRing D] [Algebra F D]
  [FiniteDimensional F D]
  (σ : FirstKindInvolution F D) (hdim : Module.finrank F D = 4)
  (hsym : Module.finrank F σ.symmetricSubspace = 3)
  {n : ℕ} (q : σ.QuadraticForms (Fin n))

/-- Over every commutative coefficient algebra, the self-value of `conjugationSkewGram q`
for quaternion conjugation is the polar self-value of `q` times the inverse alternating
unit on the right. -/
theorem matrixSesqBilin_gramOver_conjugationSkewGram (K : Type u) [CommRing K] [Algebra F K]
    (y : Fin n → K ⊗[F] D) :
    ((σ.quaternionConjugation hdim hsym).baseChange K).matrixSesqBilin
        (gramOver n (σ.conjugationSkewGram q hdim hsym) K) y y =
      (∑ j, ∑ k, y j * ((1 : K) ⊗ₜ[F] σ.polar q j k) * σ.baseChange K (y k)) *
        (↑(BinaryAction.tensorAlternatingUnit σ hdim hsym K)⁻¹ : K ⊗[F] D) := by
  rw [FirstKindInvolution.matrixSesqBilin_apply, Finset.sum_mul]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [BinaryAction.quaternionConjugation_baseChange]
  set L := BinaryAction.tensorAlternatingUnit σ hdim hsym K
  have hgram : gramOver n (σ.conjugationSkewGram q hdim hsym) K j k =
      ((1 : K) ⊗ₜ[F] σ.polar q j k) * (↑L⁻¹ : K ⊗[F] D) := by
    change ((σ.polar q * Matrix.scalar (Fin n)
        ((σ.quaternionAlternatingUnit hdim hsym : D))⁻¹).map
      (Algebra.TensorProduct.includeRight : D →ₐ[F] K ⊗[F] D)) j k = _
    rw [Matrix.map_apply, Matrix.scalar_apply, Matrix.mul_diagonal,
      Algebra.TensorProduct.includeRight_apply, BinaryAction.tensorAlternatingUnit_inv_val,
      Units.val_inv_eq_inv_val, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
  rw [hgram]
  calc y j * ((1 : K) ⊗ₜ[F] σ.polar q j k * ↑L⁻¹) * (↑L * σ.baseChange K (y k) * ↑L⁻¹)
      = y j * ((1 : K) ⊗ₜ[F] σ.polar q j k) * (↑L⁻¹ * ↑L) * σ.baseChange K (y k) * ↑L⁻¹ := by
        noncomm_ring
    _ = _ := by rw [Units.inv_mul, mul_one]

end Anisotropy

/-- At a real place where `D` stays a division algebra or the form stays anisotropic, the image in
the simply connected cover of the Kummer cocycle of `a` is a coboundary only when `a` is a square
of the completion. -/
theorem numberFieldQuaternionicSpinRealBoundary :
    NumberFieldQuaternionicSpinRealBoundaryStatement.{u} := by
  intro F _ _ D _ _ _ _ hD σ hσ n _ hn q hq G p hG hp e v hv hcond M _ _ _ _ _ _ a z hz hK
  let K := v.Completion
  let ψ : K ≃+* ℝ := InfinitePlace.Completion.ringEquivRealOfIsReal hv
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap F K).injective
  have hK1 := isSquare_or_isSquare_neg_of_ringEquivReal ψ
  have hK2 := isSquare_add_mul_self_of_ringEquivReal ψ
  have hK3 := not_isSquare_neg_one_of_ringEquivReal ψ
  -- affineness
  have : IsAffineHom G.X.hom := hG.isSemisimple.isConnectedReductive.isAffineHom
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have : IsClosedImmersion (σ.normOneIsometryAmbientι q).hom.hom.left :=
    σ.isClosedSubgroup_normOneIsometryAmbientι q
  have : IsAffineHom (σ.normOneIsometryGroup q).X.hom := by
    rw [← (σ.normOneIsometryAmbientι q).hom.hom.w]
    infer_instance
  have : IsAffine (σ.normOneIsometryGroup q).X.left :=
    isAffine_of_isAffineHom (σ.normOneIsometryGroup q).X.hom
  -- the special unitary group over the completion is generated by squares
  let τ := σ.quaternionConjugation hD hσ
  let Hs := σ.conjugationSkewGram q hD hσ
  have hHs : τ.IsAntihermitian Hs := σ.isAntihermitian_conjugationSkewGram q hD hσ
  have hu : IsUnit Hs := σ.isUnit_conjugationSkewGram q hD hσ hq
  have hsu : ∀ X : suGroup τ Hs K, X ∈ Subgroup.closure {x : suGroup τ Hs K | ∃ y, y * y = x} := by
    have hdivcase : (∀ y : K ⊗[F] D, y ≠ 0 → IsUnit y) →
        ∀ X : suGroup τ Hs K, X ∈ Subgroup.closure {x : suGroup τ Hs K | ∃ y, y * y = x} :=
      fun hdiv X => mem_closure_squares_of_division τ Hs K hK1 hK2 hK3 hdiv
        (fun x => Langlands.CentralSimple.reducedNorm F D K x)
        (σ.quaternionConjugation_norm_baseChange hD hσ K)
        (FirstKindInvolution.quaternionConjugation_baseChange_ne_id σ hD hσ) hHs hu X
    rcases hcond with hdiv | hanis
    · exact hdivcase hdiv
    · rcases quaternionCoefficientDichotomy F D K hD with hdom | hsplit
      · exact hdivcase fun y hy => isUnit_of_ne_zero_of_isDomain (K := K) hy
      · obtain ⟨e₂⟩ := hsplit
        intro X
        refine mem_closure_squares_of_split σ hD hσ Hs K hK1 hK2 hK3 e₂ hHs.1 hu ?_ X
        intro y hy
        apply hanis y
        rw [matrixSesqBilin_gramOver_conjugationSkewGram σ hD hσ q K y] at hy
        exact (Units.mul_left_eq_zero _).mp hy
  -- hence every point of `H(K)` is a product of squares
  let φ : (σ.normOneIsometryGroup q).affinePoints (CommAlgCat.of F K) →* suGroup τ Hs K :=
    (σ.normOnePointMatrix q K).codRestrict (suGroup τ Hs K)
      (σ.normOnePointMatrix_mem hD hσ q K)
  have hφ : Function.Bijective φ := by
    refine ⟨fun x y h => σ.normOnePointMatrix_injective q K (congrArg Subtype.val h), ?_⟩
    intro X
    obtain ⟨x, hx⟩ := σ.exists_normOnePointMatrix_eq hD hσ q K X.1 X.2
    exact ⟨x, Subtype.ext hx⟩
  let φe := MulEquiv.ofBijective φ hφ
  have hgen : ∀ h : (σ.normOneIsometryGroup q).affinePoints (CommAlgCat.of F K),
      h ∈ Subgroup.closure {x | ∃ y, y * y = x} := by
    intro h
    have h1 := hsu (φe h)
    have h2 := Subgroup.mem_map_of_mem (φe.symm.toMonoidHom) h1
    rw [MonoidHom.map_closure] at h2
    simp only [MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply] at h2
    refine Subgroup.closure_mono ?_ h2
    rintro _ ⟨_, ⟨y, rfl⟩, rfl⟩
    exact ⟨φe.symm y, (map_mul φe.symm y y).symm⟩
  -- squares lift, so `G(K) → H(K)` is surjective
  have hsurj : ∀ h : (σ.normOneIsometryGroup q).affinePoints (CommAlgCat.of F K),
      ∃ g, G.affinePointsTarget p (CommAlgCat.of F K) g = h := by
    intro h
    have hle : Subgroup.closure {x : (σ.normOneIsometryGroup q).affinePoints (CommAlgCat.of F K) | ∃ y, y * y = x} ≤
        (G.affinePointsTarget p (CommAlgCat.of F K)).range := by
      rw [Subgroup.closure_le]
      rintro _ ⟨y, rfl⟩
      obtain ⟨g, hg⟩ := hp.exists_target_eq_mul_self e K y
      exact ⟨g, hg⟩
    exact hle (hgen h)
  exact hp.isSquare_of_kummerImageTrivial e K M hsurj a z hz hK

end Langlands.GroupScheme
