import Langlands.GroupScheme.Rational.TorusGeneratedSplitGeometricRadicalAssembly
import Langlands.GroupScheme.Rational.SplitTorusDominatedSolvableQuotientReduction
import Langlands.GroupScheme.Absolute.SolvableTorusQuotientProof
import Langlands.GroupScheme.Rational.SplitTorusDominationProof
import Langlands.GroupScheme.Rational.SplitUnipotentStableVectorProof

/-! # The split geometric radical of a torus-generated solvable group -/

universe u

namespace Langlands.GroupScheme

/-- A pointed split-torus-dominated smooth connected affine solvable group has
an actual torus fppf quotient with a smooth connected unipotent full kernel. -/
theorem splitTorusDominatedSolvableQuotient :
    SplitTorusDominatedSolvableQuotientStatement.{u} :=
  splitTorusDominatedSolvableQuotient_of_solvableTorusQuotient solvableTorusQuotient

/-- Every smooth connected affine solvable group generated by its ground-field
tori has an actual geometric unipotent radical split over that same field. -/
theorem torusGeneratedSplitGeometricRadical :
    TorusGeneratedSplitGeometricRadicalStatement.{u} :=
  torusGeneratedSplitGeometricRadical_of_structuralStatements
    splitTorusDominatedSolvableQuotient unipotentSplitTorusDomination
    RelativeRoot.splitUnipotentStableVectorSubgroup

end Langlands.GroupScheme
