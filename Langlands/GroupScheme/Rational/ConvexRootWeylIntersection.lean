import Langlands.GroupScheme.Rational.RootSubsetWeylDisplacement
import Langlands.GroupScheme.Rational.WeylSubspaceStabilizer

/-! # Weyl groups of symmetric parts of convex root subsets -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open Langlands.LinearAlgebra.RationalSpan
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

/-- Taking the symmetric part commutes with intersection. -/
theorem parabolicRootLevi_inter (S X : Set (characterLattice T)) :
    parabolicRootLevi (S ∩ X) = parabolicRootLevi S ∩ parabolicRootLevi X := by
  ext α
  change ((α ∈ S ∧ α ∈ X) ∧ (-α ∈ S ∧ -α ∈ X)) ↔
    ((α ∈ S ∧ -α ∈ S) ∧ (α ∈ X ∧ -α ∈ X))
  tauto

variable (i : T.toGrp ⟶ G) [Mono i.hom.hom.left]

/-- Enlarging a root set enlarges its reflection-generated Weyl subgroup. -/
theorem rootSubsetWeylGroup_mono
    {S X : Set (characterLattice T)} (h : S ⊆ X) :
    rootSubsetWeylGroup i S ≤ rootSubsetWeylGroup i X := by
  apply Subgroup.closure_mono
  rintro w ⟨α, hα, hw⟩
  exact ⟨α, h hα, hw⟩

variable [IsAffineHom G.X.hom]

/-- The Weyl groups generated by the symmetric parts of two individually
convex relative-root subsets intersect in the group generated by their common
symmetric roots. -/
theorem rootSubsetWeylGroup_parabolicRootLevi_inter_of_convex
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    {S X : Set (characterLattice T)}
    (hS : IsConvexRootSubset (relativeRoots i) S)
    (hX : IsConvexRootSubset (relativeRoots i) X) :
    rootSubsetWeylGroup i (parabolicRootLevi S) ⊓
        rootSubsetWeylGroup i (parabolicRootLevi X) =
      rootSubsetWeylGroup i (parabolicRootLevi (S ∩ X)) := by
  have hroot := relativeRootSystem k G hG T i hi
  have hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i :=
    fun _ hα => hroot.neg_mem_relativeRoots i hi.isSplitSubtorus.1 hα
  have hsets : {α | α ∈ relativeRoots i ∧
      toRat α ∈ symmetricRootRatSpan S ⊓ symmetricRootRatSpan X} =
      parabolicRootLevi (S ∩ X) := by
    rw [parabolicRootLevi_inter]
    ext α
    constructor
    · rintro ⟨hα, hαS, hαX⟩
      exact ⟨(hS.mem_symmetricRootRatSpan_iff hneg hα).mp hαS,
        (hX.mem_symmetricRootRatSpan_iff hneg hα).mp hαX⟩
    · rintro ⟨hαS, hαX⟩
      have hα := hS.isClosedRootSubset.1 hαS.1
      exact ⟨hα, (hS.mem_symmetricRootRatSpan_iff hneg hα).mpr hαS,
        (hX.mem_symmetricRootRatSpan_iff hneg hα).mpr hαX⟩
  apply le_antisymm
  · intro w hw
    have h := mem_rootSubsetWeylGroup_roots_in_subspace_of_displacement_mem i hG hi
      (symmetricRootRatSpan S ⊓ symmetricRootRatSpan X) w
      (characterDisplacement_mem_inf_ratSpan_of_mem_rootSubsetWeylGroup i hw.1 hw.2)
    rwa [hsets] at h
  · apply le_inf
    · exact rootSubsetWeylGroup_mono i (fun _ hα => ⟨hα.1.1, hα.2.1⟩)
    · exact rootSubsetWeylGroup_mono i (fun _ hα => ⟨hα.1.2, hα.2.2⟩)

/-- Uniform intersection formula for the reflection-generated Weyl groups
of the symmetric parts of individually convex full relative-root subsets. -/
def ConvexRootWeylIntersectionStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ S X : Set (characterLattice T),
      IsConvexRootSubset (relativeRoots i) S →
      IsConvexRootSubset (relativeRoots i) X →
      rootSubsetWeylGroup i (parabolicRootLevi S) ⊓
          rootSubsetWeylGroup i (parabolicRootLevi X) =
        rootSubsetWeylGroup i (parabolicRootLevi (S ∩ X))

/-- Displacement containment and rational-subspace stabilizers prove the
uniform convex Weyl-intersection formula. -/
theorem convexRootWeylIntersection : ConvexRootWeylIntersectionStatement.{u} := by
  intro k _ G hG T i hi
  let := hG.isAffineHom
  let := hi.isSplitSubtorus.mono
  exact fun _ _ hS hX =>
    rootSubsetWeylGroup_parabolicRootLevi_inter_of_convex i hG hi hS hX

end Langlands.GroupScheme
