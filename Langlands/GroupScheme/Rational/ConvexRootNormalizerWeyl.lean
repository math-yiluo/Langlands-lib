import Langlands.GroupScheme.Rational.ConvexRootCocharacter
import Langlands.GroupScheme.Rational.ConvexRootWeylIntersection
import Langlands.GroupScheme.Rational.NormalizerParabolicPoints
import Langlands.GroupScheme.Rational.CocharacterCentralizerRootGeneration
import Langlands.GroupScheme.Rational.CocharacterCentralizerPointDetection
import Langlands.GroupScheme.Rational.RootSubgroupPositive

/-! # Normalizer points in groups generated by convex root subsets -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  (i : T.toGrp ⟶ G)

/-- A normalizing point fixing an integral cocharacter centralizes its image
on every test scheme. -/
theorem mem_dynamicCentralizer_of_cocharacterAut_normalizingAut_eq
    (n : normalizerPoints i) {ξ : cocharacterLattice T}
    (hfix : cocharacterAut (normalizingAut i n) ξ = ξ) :
    (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈
      (Dynamic.centralizer (CommGroupScheme.groupHom ξ ≫ i)).carrier
        (Over.mk (𝟙 (Spec (CommRingCat.of k)))) := by
  change ξ ≫ (normalizingAut i n).hom = ξ at hfix
  let U := Over.mk (𝟙 (Spec (CommRingCat.of k)))
  let t := snd U (Gm (Spec (CommRingCat.of k))).X
  have hconj := (isNormalizingPoint_normalizingAut i n).conj_comp
    (U ⊗ (Gm (Spec (CommRingCat.of k))).X)
    (t ≫ (CommGroupScheme.groupHom ξ).hom.hom)
  rw [Category.assoc, ← comp_groupHom_comp, hfix] at hconj
  rw [Dynamic.mem_centralizer, Dynamic.orbit]
  simp only [Grp.comp_hom_hom]
  change ((t ≫ (CommGroupScheme.groupHom ξ).hom.hom) ≫ i.hom.hom) *
    (fst U (Gm (Spec (CommRingCat.of k))).X ≫ n) *
      ((t ≫ (CommGroupScheme.groupHom ξ).hom.hom) ≫ i.hom.hom)⁻¹ =
        fst U (Gm (Spec (CommRingCat.of k))).X ≫ n
  rw [comp_eq_constantPoint]
  rw [mul_inv_eq_iff_eq_mul] at hconj ⊢
  exact hconj.symm

variable [IsAffineHom G.X.hom]

/-- A cocharacter nonnegative on the generating roots places the entire
root-subset group in its dynamic parabolic. -/
theorem IsRootSubsetGroup.range_le_dynamicParabolic_of_nonneg
    {S : Set (characterLattice T)}
    {H : GroupScheme (Spec (CommRingCat.of k))} {h : H ⟶ G}
    (hH : IsRootSubsetGroup i S h) (ξ : cocharacterLattice T)
    (hpos : ∀ α ∈ S, 0 ≤ latticePairing T α ξ) :
    SubgroupFunctor.range h ≤ Dynamic.parabolic (CommGroupScheme.groupHom ξ ≫ i) := by
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have hp := Dynamic.Affine.isRepresentedBy_parabolicHom
    (CommGroupScheme.groupHom ξ ≫ i)
  rw [← hp.2]
  apply hH.2.2.2 _ _ (Dynamic.Affine.isClosedSubgroup_parabolicHom _)
  · rw [hp.2]
    exact (torusCentralizer_le_dynamicCentralizer i (CommGroupScheme.groupHom ξ)).trans
      (Dynamic.centralizer_le_parabolic _)
  · intro α hα
    rw [hp.2]
    rcases (hpos α hα).eq_or_lt with hz | hpos
    · exact (RelativeRoot.subgroup_le_dynamicCentralizer_of_pairing_eq_zero
        i α ξ hz.symm).trans (Dynamic.centralizer_le_parabolic _)
    · exact (RelativeRoot.subgroup_le_dynamicUnipotent i ξ hpos).trans
        (Dynamic.unipotent_le_parabolic _)

variable [Mono i.hom.hom.left]

/-- Membership of a torus-normalizing point in a convex root-subset group
is detected by the Weyl subgroup of its symmetric roots. -/
theorem IsRootSubsetGroup.normalizer_mem_iff_weyl_mem
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    {S : Set (characterLattice T)}
    (hS : IsConvexRootSubset (relativeRoots i) S)
    {H : GroupScheme (Spec (CommRingCat.of k))} {h : H ⟶ G}
    (hH : IsRootSubsetGroup i S h) (n : normalizerPoints i) :
    (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈
        (SubgroupFunctor.range h).carrier (Over.mk (𝟙 _)) ↔
      (QuotientGroup.mk n : relativeWeylGroup i) ∈
        rootSubsetWeylGroup i (parabolicRootLevi S) := by
  let := hG.smooth
  have hroot := relativeRootSystem k G hG T i hi
  have hneg : ∀ α ∈ relativeRoots i, -α ∈ relativeRoots i :=
    fun _ hα => hroot.neg_mem_relativeRoots i hi.isSplitSubtorus.1 hα
  obtain ⟨ξ, hpos, hzero⟩ := hS.exists_cocharacter_nonneg_zero_iff
    hi.isSplitSubtorus.1 (hi.isSplitSubtorus.1.finite_relativeRoots i) hneg
  have hzeros : {α | α ∈ relativeRoots i ∧ latticePairing T α ξ = 0} =
      parabolicRootLevi S := by
    ext α
    exact ⟨fun hα => (hzero α hα.1).mp hα.2,
      fun hα => ⟨hS.isClosedRootSubset.1 hα.1,
        (hzero α (hS.isClosedRootSubset.1 hα.1)).mpr hα⟩⟩
  have hwiff := mem_rootSubsetWeylGroup_zero_iff_cocharacter_fixed
    i hG hi ξ (QuotientGroup.mk n)
  rw [hzeros, relativeWeylCocharacterAction_mk] at hwiff
  constructor
  · intro hn
    apply hwiff.mpr
    apply cocharacterAut_normalizingAut_eq_of_mem_dynamicCentralizer i n
    exact hi.isSplitSubtorus.mem_centralizer_of_mem_parabolic ξ n.property
      (hH.range_le_dynamicParabolic_of_nonneg i ξ hpos _ hn)
  · intro hw
    have hn := mem_dynamicCentralizer_of_cocharacterAut_normalizingAut_eq i n
      (hwiff.mp hw)
    apply dynamicCentralizer_rationalPoints_le_of_zeroRootGroups i hG hi ξ
      ((SubgroupFunctor.range h).carrier (Over.mk (𝟙 _))) _ _ hn
    · exact (centralizerPoints_le_torusCentralizer i).trans (hH.2.1 _)
    · intro α hα hz
      exact hH.2.2.1 α ((hzero α hα).mp hz).1 _

/-- The intersection of the two root-subset groups has no additional points
among the normalizers of the chosen maximal split torus. -/
theorem normalizer_mem_convexRootGroups_inter_iff
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    {S X : Set (characterLattice T)}
    (hS : IsConvexRootSubset (relativeRoots i) S)
    (hX : IsConvexRootSubset (relativeRoots i) X)
    {H₁ H₂ H₃ : GroupScheme (Spec (CommRingCat.of k))}
    {h₁ : H₁ ⟶ G} {h₂ : H₂ ⟶ G} {h₃ : H₃ ⟶ G}
    (hH₁ : IsRootSubsetGroup i S h₁) (hH₂ : IsRootSubsetGroup i X h₂)
    (hH₃ : IsRootSubsetGroup i (S ∩ X) h₃) (n : normalizerPoints i) :
    ((n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈
        (SubgroupFunctor.range h₁).carrier (Over.mk (𝟙 _)) ∧
      (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈
        (SubgroupFunctor.range h₂).carrier (Over.mk (𝟙 _))) ↔
      (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈
        (SubgroupFunctor.range h₃).carrier (Over.mk (𝟙 _)) := by
  have hSX : IsConvexRootSubset (relativeRoots i) (S ∩ X) := by
    let := moduleTopology ℝ (RealTorusSpace.Vstar T)
    obtain ⟨C, hC, rfl⟩ := hS
    obtain ⟨D, hD, rfl⟩ := hX
    refine ⟨C ⊓ D, hC.inter hD, ?_⟩
    ext α
    change ((α ∈ relativeRoots i ∧ _) ∧ (α ∈ relativeRoots i ∧ _)) ↔
      (α ∈ relativeRoots i ∧ (_ ∧ _))
    tauto
  rw [hH₁.normalizer_mem_iff_weyl_mem i hG hi hS,
    hH₂.normalizer_mem_iff_weyl_mem i hG hi hX,
    hH₃.normalizer_mem_iff_weyl_mem i hG hi hSX]
  change (QuotientGroup.mk n : relativeWeylGroup i) ∈
      rootSubsetWeylGroup i (parabolicRootLevi S) ⊓
        rootSubsetWeylGroup i (parabolicRootLevi X) ↔ _
  rw [rootSubsetWeylGroup_parabolicRootLevi_inter_of_convex i hG hi hS hX]

/-- Uniform detection of normalizer membership by the Weyl group of the
symmetric part of a convex relative-root subset. -/
def ConvexRootNormalizerWeylStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) (T : CommGroupScheme (Spec (CommRingCat.of k)))
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i),
    haveI := hG.isAffineHom
    haveI := hi.isSplitSubtorus.mono
    ∀ (S : Set (characterLattice T)), IsConvexRootSubset (relativeRoots i) S →
      ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
        IsRootSubsetGroup i S h → ∀ n : normalizerPoints i,
          (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) ∈
              (SubgroupFunctor.range h).carrier (Over.mk (𝟙 _)) ↔
            (QuotientGroup.mk n : relativeWeylGroup i) ∈
              rootSubsetWeylGroup i (parabolicRootLevi S)

/-- An adapted cocharacter identifies normalizing points of the root-subset
group with the corresponding symmetric-root Weyl subgroup. -/
theorem convexRootNormalizerWeyl : ConvexRootNormalizerWeylStatement.{u} := by
  intro k _ G hG T i hi
  let := hG.isAffineHom
  let := hi.isSplitSubtorus.mono
  intro S hS H h hH n
  exact hH.normalizer_mem_iff_weyl_mem i hG hi hS n

end Langlands.GroupScheme
