/-! # Centralizer points of quasi-split simply connected groups lie in `G(k)^+` -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme.GaloisPointComparison
open Langlands.LinearAlgebra.RootDatumOrbitPairs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option autoImplicit false

namespace Langlands.GroupScheme

/-- A nontrivial field automorphism moves some element, which is then neither `0` nor `-1`. -/
theorem exists_ne_zero_one_add_ne_zero_of_ne_one {k K : Type u} [Field k] [Field K]
    [Algebra k K] {σ : K ≃ₐ[k] K} (hσ : σ ≠ 1) : ∃ c₀ : K, c₀ ≠ 0 ∧ 1 + c₀ ≠ 0 := by
  by_contra h
  push Not at h
  apply hσ
  ext x
  by_cases hx : x = 0
  · simp [hx]
  · have hx1 : x = -1 := by
      have := h x hx
      linear_combination this
    simp [hx1]

/-- Every maximal split torus of a quasi-split group has a closed torus representing its
centralizer. -/
theorem IsQuasiSplit.nonempty_torusCentralizerTorusData {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} (hqs : IsQuasiSplit G)
    {S : CommGroupScheme (Spec (CommRingCat.of k))} {i : S.toGrp ⟶ G}
    (hi : IsMaximalSplitTorus i) : Nonempty (TorusCentralizerTorusData i) := by
  obtain ⟨A₀, a₀, C₀, j₀, ha₀, hj₀, hj₀c, hC⟩ := quasiSplitTorusCentralizerExistence k G hqs
  obtain ⟨g, e, he⟩ :=
    (maximalSplitTorusConjugacy k G hqs.isConnectedReductive).1 A₀ S a₀ i ha₀ hi
  exact ⟨{ torus := { toGrp := C₀, comm := hC.isCommMonObj }
           inclusion := j₀ ≫ (G.innerIso g).hom
           isTorus := hC
           isClosedSubgroup := hj₀c.comp_iso (G.innerIso g)
           represents := hj₀.torusCentralizer_of_iso_square e (G.innerIso g) he }⟩

/-- **Steinberg's centralizer inclusion.** For a quasi-split simply connected group and a
maximal split torus `i`, the centralizer points of `i` lie in the subgroup generated by the
rational points of the relative root groups. -/
theorem centralizerPoints_le_relativeRootGeneratedSubgroup_of_simplyConnected
    {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (hsc : IsSimplyConnected G) (hqs : IsQuasiSplit G)
    {S : CommGroupScheme (Spec (CommRingCat.of k))} {i : S.toGrp ⟶ G}
    (hi : IsMaximalSplitTorus i) :
    centralizerPoints i ≤ relativeRootGeneratedSubgroup i := by
  classical
  have hG : IsConnectedReductive G := hqs.isConnectedReductive
  have : Smooth G.X.hom := hG.smooth
  obtain ⟨C⟩ := hqs.nonempty_torusCentralizerTorusData hi
  let t : S ⟶ C.torus := Additive.ofMul (torusCentralizerFactor i C.represents)
  have ht : CommGroupScheme.groupHom t ≫ C.inclusion = i :=
    torusCentralizerFactor_comp i C.represents
  obtain ⟨K, hK, hAK, hfin, hgal, hsplit⟩ := torusFiniteGaloisSplitting k C.torus.toGrp C.isTorus
  let := hK
  let := hAK
  have := hfin
  have := hgal
  have hCT : IsConnectedReductive C.torus.toGrp := C.isTorus.isConnectedReductive_of_fieldSplitting
  have : IsAffineHom C.torus.toGrp.X.hom := hCT.isAffineHom
  have : Smooth C.torus.toGrp.X.hom := hCT.smooth
  have : IsAffineHom ((GroupScheme.baseChange (algebraBaseMap k K)).obj G).X.hom := by
    change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom (algebraBaseMap k K))
    infer_instance
  have hGK : IsConnectedReductive ((GroupScheme.baseChange (algebraBaseMap k K)).obj G) :=
    connectedReductiveFieldExtensionStatement k K G hG
  obtain ⟨J, hJ, P, hP, hred⟩ := rootDatumExistence K
    ((GroupScheme.baseChange (algebraBaseMap k K)).obj G) hGK _ hsplit _
    (C.isMaximalTorus_baseChange K)
  have := hJ
  have := hred
  let D : GaloisCompatiblePinningData k K G :=
    GaloisCompatiblePinningData.ofRegularCocharacter C.inclusion hP (C.regularCocharacter hi.1.1)
      (hP.root'_ne_zero_of_isRegularCocharacter
        (C.regularCocharacter_baseChange_isRegular K hi.1.1 hsplit))
      hGK hsplit (C.isMaximalTorus_baseChange K)
  have : IsAffineHom D.torus.toGrp.X.hom := hCT.isAffineHom
  have : Smooth D.torus.toGrp.X.hom := hCT.smooth
  have hρ : IsPairingCompatible D.pinning.base D.action :=
    GaloisCompatiblePinningData.ofRegularCocharacter_isPairingCompatible hGK hsplit
      (C.isMaximalTorus_baseChange K)
  have hf : IsMaximalSplitTorus (CommGroupScheme.groupHom t ≫ D.inclusion) := by
    change IsMaximalSplitTorus (CommGroupScheme.groupHom t ≫ C.inclusion)
    rw [ht]
    exact hi
  have hcent : (torusCentralizer (CommGroupScheme.groupHom t ≫ D.inclusion)).IsRepresentedBy
      D.inclusion := by
    change (torusCentralizer (CommGroupScheme.groupHom t ≫ C.inclusion)).IsRepresentedBy
      C.inclusion
    rw [ht]
    exact C.represents
  have hjc : IsClosedSubgroup D.inclusion := C.isClosedSubgroup
  have hspan : D.pinning.rootDatum.corootSpan ℤ = ⊤ :=
    splitSimplyConnectedCorootSpan K _ (isSimplyConnectedFieldExtension k K G hsc)
      D.pinning.torus D.pinning.isSplitTorus D.pinning.inclusion D.pinning.isMaximalTorus _
      D.pinning.rootDatum D.pinning.isRootDatum D.pinning.isReduced
  have hnc : ∀ x y : D.pinning.base.support, x ≠ y →
      D.pinning.rootDatum.pairing (x : D.pinning.rootIndex) y = -1 →
      D.pinning.rootDatum.pairing (y : D.pinning.rootIndex) x = -1 →
      (∃ σ : K ≃ₐ[k] K, D.action σ x = y) →
      ¬ Commute (D.simplePoint x 1) (D.simplePoint y 1) := by
    rintro x y hxy h1 - ⟨σ, hσ⟩
    have hσ1 : σ ≠ 1 := by
      rintro rfl
      rw [map_one, Equiv.Perm.one_apply] at hσ
      exact hxy hσ
    obtain ⟨c₀, hc₀, hc₁⟩ := exists_ne_zero_one_add_ne_zero_of_ne_one hσ1
    exact D.pinning.adjacent_unitPoint_not_commute D.rootMaps x y hxy h1 c₀ hc₀ hc₁
  intro z hz
  have hz' := centralizerPoints_le_torusCentralizer i hz
  rw [← C.represents.2] at hz'
  obtain ⟨z', hz'⟩ := SubgroupFunctor.mem_range.mp hz'
  obtain ⟨c, hc, hzc⟩ := D.exists_equivariant_simpleCorootProduct hspan z'
  have hmem := D.simpleCorootProduct_mem_of_equivariant t hG hsplit hf hjc hcent hspan hρ hnc hc
  rw [← hzc] at hmem
  obtain ⟨y, hy, hyz⟩ := Subgroup.mem_map.mp hmem
  have hyz' : y = rationalPoints.map D.inclusion z' :=
    GaloisCompatiblePinningData.rationalExtend_injective' (k := k) (K := K) hyz
  have hzz : rationalPoints.map D.inclusion z' = z := hz'
  rw [← hzz, ← hyz']
  rw [← ht]
  exact hy

/-- **Rational root generation for quasi-split simply connected groups.** -/
theorem quasiSplitSimplyConnectedRootGeneration :
    QuasiSplitSimplyConnectedRootGenerationStatement.{u} := by
  intro k _ G _ hsc hqs S i hi
  exact relativeRootGeneratedSubgroup_eq_top_of_centralizerPoints_le hqs.isConnectedReductive hi
    (centralizerPoints_le_relativeRootGeneratedSubgroup_of_simplyConnected hsc hqs hi)

end Langlands.GroupScheme
