/-! # Field extension of the fixed closed torus envelope: the inclusion -/

noncomputable section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace EnvelopeBaseChange

open BorelExistence

attribute [local instance]
  P2MW.S_GoodReductionJacobian_AbelianSchemePropertyBundle_geometricallyIntegral.S17A0.subsingleton_spec_field

/-- A quasi-compact schematically dominant morphism stays schematically dominant
after flat base change, using the actual pullback functor on over schemes. -/
theorem isSchemeTheoreticallyDominant_pullback_map {S S' : Scheme.{u}} (b : S' ⟶ S)
    [Flat b] {X Y : Over S} (p : X ⟶ Y)
    [IsSchemeTheoreticallyDominant p.left] [QuasiCompact p.left] :
    IsSchemeTheoreticallyDominant ((Over.pullback b).map p).left := by
  have hp : IsPullback ((Over.pullback b).map p).left
      (pullback.fst X.hom b) (pullback.fst Y.hom b) p.left := by
    refine .of_right (t := .flip <| .of_hasPullback Y.hom b)
      (by simpa using (.flip <| .of_hasPullback X.hom b)) (by simp)
  exact IsSchemeTheoreticallyDominant.of_isPullback hp.flip

/-- The first projection of a pulled-back over scheme, as a morphism over the
original base. -/
def pullbackFst {S S' : Scheme.{u}} (b : S' ⟶ S) (W : Over S) :
    (Over.map b).obj ((Over.pullback b).obj W) ⟶ W :=
  Over.homMk (pullback.fst W.hom b) (by simp [pullback.condition])

/-- The point equivalence sends a pulled-back morphism to its composite with the
first projection. -/
theorem baseChangePointsEquiv_pullback_map {S S' : Scheme.{u}} (b : S' ⟶ S)
    (G : GroupScheme S) {W : Over S} (g : W ⟶ G.X) :
    baseChangePointsEquiv b G ((Over.pullback b).obj W) ((Over.pullback b).map g) =
      pullbackFst b W ≫ g := by
  apply Over.OverMorphism.ext
  simp [pullbackFst]

variable {k : Type u} [Field k] (K : Type u) [Field K] [Algebra k K]
variable {H G : GroupScheme (Spec (CommRingCat.of k))}

/-- After extension of the ground field to `K`, every point of the subgroup lies
in the closed envelope of all `K`-tori, on every test scheme. -/
def BaseChangeContained (i : H ⟶ G) : Prop :=
  (SubgroupFunctor.range i).baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≤
    closedTorusEnvelope
      ((GroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj G)

/-- A closed ground-field torus lies in the envelope after any field extension. -/
theorem baseChangeContained_torus {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (j : T.toGrp ⟶ G) (hT : IsTorus T.toGrp) (hj : IsClosedSubgroup j) :
    BaseChangeContained K j := by
  rw [BaseChangeContained, ← SubgroupFunctor.range_baseChangeHom]
  exact closedTorusEnvelope_containsTori _
    ((CommGroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj T)
    ((GroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map j)
    hT.baseChange (hj.baseChange _)

/-- If, for every scheme `W` over `K` (not only `Spec K`), every `W`-valued point of
`f` read after extension to `K` lies in a closed subgroup `a` of the extended
group, then so does the extension of the group generated by `f`, provided a
dominant ordered power reaches all of the generated group. -/
theorem range_baseChange_le_of_points {V : Over (Spec (CommRingCat.of k))}
    [IsAffineHom V.hom] {f : V ⟶ G.X} (D : GeneratedImage f) [Smooth D.group.X.hom]
    [IsAffineHom D.group.X.hom]
    {n : ℕ} (hn : IsDominant (D.powerMap n).left)
    {A : GroupScheme (Spec (CommRingCat.of K))}
    (a : A ⟶ (GroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj G)
    (ha : IsClosedSubgroup a)
    (hf : ∀ (W : Over (Spec (CommRingCat.of K)))
      (v : (Over.map (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj W ⟶ V),
      (baseChangePointsEquiv _ G W).symm (v ≫ f) ∈ (SubgroupFunctor.range a).carrier W) :
    SubgroupFunctor.range
        ((GroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map
          D.inclusion) ≤ SubgroupFunctor.range a := by
  let b := Spec.map (CommRingCat.ofHom (algebraMap k K))
  have : IsClosedImmersion a.hom.hom.left := ha
  have : IsReduced D.group.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k _
      D.group.X.hom
  have : IsDominant (D.powerMap n).left := hn
  have : IsSchemeTheoreticallyDominant (D.powerMap n).left :=
    IsSchemeTheoreticallyDominant.of_isDominant _
  have : IsAffine (finitePower V n).left := by
    have : IsAffineHom (finitePower V n).hom := inferInstance
    exact isAffine_of_isAffineHom (finitePower V n).hom
  have : IsAffine D.group.X.left := isAffine_of_isAffineHom D.group.X.hom
  have : Flat b := (fieldExtension_fpqc k K).2.1
  have : IsSchemeTheoreticallyDominant ((Over.pullback b).map (D.powerMap n)).left :=
    isSchemeTheoreticallyDominant_pullback_map b _
  let W := (Over.pullback b).obj (finitePower V n)
  have hP : (Over.pullback b).map (orderedPowerMap f n) ∈
      (SubgroupFunctor.range a).carrier W := by
    rw [← MulEquiv.symm_apply_apply (baseChangePointsEquiv b G W)
      ((Over.pullback b).map (orderedPowerMap f n)), baseChangePointsEquiv_pullback_map,
      orderedPowerMap_points, map_list_prod, List.map_ofFn]
    refine Subgroup.list_prod_mem (K := (SubgroupFunctor.range a).carrier W) fun x hx => ?_
    obtain ⟨m, rfl⟩ := List.mem_ofFn.mp hx
    exact hf W _
  obtain ⟨h, hh⟩ := SubgroupFunctor.mem_range.mp hP
  obtain ⟨c, hc⟩ := exists_over_factor_of_schematic_precomp a.hom.hom
    ((Over.pullback b).map (D.powerMap n))
    ((GroupScheme.baseChange b).map D.inclusion).hom.hom h (by
      rw [hh, show orderedPowerMap f n = D.powerMap n ≫ D.inclusion.hom.hom by
        rw [GeneratedImage.powerMap, orderedPowerMap_comp, D.factor_comp], Functor.map_comp]
      rfl)
  intro U x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  exact SubgroupFunctor.mem_range.mpr ⟨y ≫ c, by rw [Category.assoc, hc]⟩

/-- The extension to `K` of the group generated by a subgroup contained after
extension and one closed ground-field torus is again contained after extension. -/
theorem baseChangeContained_generated {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (i : H ⟶ G) (hi : BaseChangeContained K i)
    (j : T.toGrp ⟶ G) (hT : IsTorus T.toGrp) (hj : IsClosedSubgroup j)
    [IsAffineHom (H.X ⊗ T.toGrp.X).hom]
    (D : GeneratedImage (SmoothTorusEnvelope.productMap i j))
    [Smooth D.group.X.hom] [IsAffineHom D.group.X.hom]
    {n : ℕ} (hn : IsDominant (D.powerMap n).left) :
    BaseChangeContained K D.inclusion := by
  rw [BaseChangeContained, ← SubgroupFunctor.range_baseChangeHom]
  intro W x hx A a ha ht
  have hmem : ∀ {L : GroupScheme (Spec (CommRingCat.of k))} (l : L ⟶ G),
      BaseChangeContained K l → ∀ (W' : Over (Spec (CommRingCat.of K)))
      (y : (Over.map (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj W' ⟶ L.X),
      (baseChangePointsEquiv _ G W').symm (y ≫ l.hom.hom) ∈
        (SubgroupFunctor.range a).carrier W' := by
    intro L l hl W' y
    refine hl W' ?_ A a ha ht
    rw [SubgroupFunctor.mem_baseChange, MulEquiv.apply_symm_apply]
    exact SubgroupFunctor.mem_range.mpr ⟨y, rfl⟩
  refine range_baseChange_le_of_points K D hn a ha (fun W' v => ?_) W hx
  rw [SmoothTorusEnvelope.productMap, MonObj.comp_mul, map_mul]
  exact ((SubgroupFunctor.range a).carrier W').mul_mem
    (by simpa only [Category.assoc] using hmem i hi W' (v ≫ fst _ _))
    (by simpa only [Category.assoc] using
      hmem j (baseChangeContained_torus K j hT hj) W' (v ≫ snd _ _))

/-- Smooth connected closed subgroups inside the envelope of ground-field tori
whose extension to `K` lies inside the envelope of `K`-tori. -/
def IsAdmissible (i : H ⟶ G) : Prop :=
  SmoothTorusEnvelope.IsAdmissible i ∧ BaseChangeContained K i

private theorem exists_admissible (G : GroupScheme (Spec (CommRingCat.of k))) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G), IsAdmissible K i := by
  obtain ⟨T, i, hT, hi⟩ := exists_isTorus_isClosedSubgroup G
  exact ⟨T.toGrp, i, ⟨hi, hT.smooth, hT.connectedSpace,
    closedTorusEnvelope_containsTori G T i hT hi⟩, baseChangeContained_torus K i hT hi⟩

private theorem exists_minimal_height_admissible
    (G : GroupScheme (Spec (CommRingCat.of k))) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G), IsAdmissible K i ∧
      ∀ (L : GroupScheme (Spec (CommRingCat.of k))) (j : L ⟶ G), IsAdmissible K j →
        (coordinateKernel i).height ≤ (coordinateKernel j).height := by
  let P : ℕ∞ → Prop := fun r =>
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      IsAdmissible K i ∧ (coordinateKernel i).height = r
  have hP : Set.Nonempty {r | P r} := by
    obtain ⟨H, i, hi⟩ := exists_admissible K G
    exact ⟨_, H, i, hi, rfl⟩
  obtain ⟨_, ⟨H, i, hi, rfl⟩, hmin⟩ :=
    WellFounded.has_min wellFounded_lt {r | P r} hP
  exact ⟨H, i, hi, fun L j hj => not_lt.1 (hmin _ ⟨L, j, hj, rfl⟩)⟩

private theorem range_left_le {L : GroupScheme (Spec (CommRingCat.of k))}
    (i : H ⟶ G) (j : L ⟶ G) (D : GeneratedImage (SmoothTorusEnvelope.productMap i j)) :
    SubgroupFunctor.range i ≤ SubgroupFunctor.range D.inclusion := by
  intro U x hx
  obtain ⟨h, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  refine SubgroupFunctor.mem_range.mpr ⟨lift h 1 ≫ D.factor, ?_⟩
  rw [Category.assoc, D.factor_comp, SmoothTorusEnvelope.productMap, MonObj.comp_mul]
  simp only [lift_fst_assoc, lift_snd_assoc, MonObj.one_comp, mul_one]

private theorem range_right_le {L : GroupScheme (Spec (CommRingCat.of k))}
    (i : H ⟶ G) (j : L ⟶ G) (D : GeneratedImage (SmoothTorusEnvelope.productMap i j)) :
    SubgroupFunctor.range j ≤ SubgroupFunctor.range D.inclusion := by
  intro U x hx
  obtain ⟨h, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  refine SubgroupFunctor.mem_range.mpr ⟨lift 1 h ≫ D.factor, ?_⟩
  rw [Category.assoc, D.factor_comp, SmoothTorusEnvelope.productMap, MonObj.comp_mul]
  simp only [lift_fst_assoc, lift_snd_assoc, MonObj.one_comp, one_mul]

private theorem generated_range_le_envelope
    (i : H ⟶ G) (hi : SubgroupFunctor.range i ≤ closedTorusEnvelope G)
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (j : T.toGrp ⟶ G) (hT : IsTorus T.toGrp) (hj : IsClosedSubgroup j)
    (D : GeneratedImage (SmoothTorusEnvelope.productMap i j)) :
    SubgroupFunctor.range D.inclusion ≤ closedTorusEnvelope G := by
  intro U x hx L a ha ht
  apply D.range_le a ha ?_ U hx
  apply (factorsThrough_iff_containsImage _ a).mpr
  intro V z
  rw [SmoothTorusEnvelope.productMap, MonObj.comp_mul]
  exact ((SubgroupFunctor.range a).carrier V).mul_mem
    (hi V (SubgroupFunctor.mem_range.mpr ⟨z ≫ fst _ _, rfl⟩) L a ha ht)
    (ht T j hT hj V (SubgroupFunctor.mem_range.mpr ⟨z ≫ snd _ _, rfl⟩))

private theorem minimal_containsTori [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (i : H ⟶ G) (hi : IsAdmissible K i)
    (hmin : ∀ (L : GroupScheme (Spec (CommRingCat.of k))) (j : L ⟶ G),
      IsAdmissible K j → (coordinateKernel i).height ≤ (coordinateKernel j).height) :
    (SubgroupFunctor.range i).ContainsTori := by
  intro T j hT hj
  have : Smooth H.X.hom := hi.1.2.1
  have : ConnectedSpace H.X.left := hi.1.2.2.1
  have : IsClosedImmersion i.hom.hom.left := hi.1.1
  have : IsClosedImmersion j.hom.hom.left := hj
  have : IsAffineHom H.X.hom := by
    rw [← Over.w i.hom.hom]
    infer_instance
  have : IsAffineHom T.toGrp.X.hom := by
    rw [← Over.w j.hom.hom]
    infer_instance
  obtain ⟨hAff, hFin, -, hInt⟩ := smoothConnectedAffineGeometry.2 k H T.toGrp
    inferInstance inferInstance inferInstance hT.smooth inferInstance hT.connectedSpace
  have hunit : (lift 1 1 :
      Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X ⊗ T.toGrp.X) ≫
      SmoothTorusEnvelope.productMap i j = 1 := by
    simp only [SmoothTorusEnvelope.productMap, MonObj.comp_mul, lift_fst_assoc,
      lift_snd_assoc, MonObj.one_comp, mul_one]
  obtain ⟨D, hD⟩ := ImageGeneration.pointedImageGeneration k G
    inferInstance inferInstance (H.X ⊗ T.toGrp.X) hAff hFin hInt _ _ hunit
  have : Smooth D.group.X.hom := hD.1
  have : IsAffineHom D.group.X.hom := hD.2.1
  have : GeometricallyConnected D.group.X.hom := hD.2.2.1
  obtain ⟨n, -, hn⟩ := hD.2.2.2
  have hconn : ConnectedSpace D.group.X.left :=
    GeometricallyConnected.connectedSpace_of_subsingleton (f := D.group.X.hom)
  have hbelow := generated_range_le_envelope i hi.1.2.2.2 j hT hj D
  have hext := baseChangeContained_generated K i hi.2 j hT hj D hn
  let f : H ⟶ D.group := D.represents.factorHom i (by
    rw [← D.represents.2]
    exact range_left_le i j D)
  have hf : f ≫ D.inclusion = i := D.represents.factorHom_comp _ _
  have : IsIso f := isIso_of_coordinateKernel_height_le i D.inclusion f hi.1.1 D.closed
    hf (hmin D.group D.inclusion ⟨⟨D.closed, hD.1, hconn, hbelow⟩, hext⟩)
  intro U x hx
  obtain ⟨d, hd⟩ := SubgroupFunctor.mem_range.mp (range_right_le i j D U hx)
  refine SubgroupFunctor.mem_range.mpr ⟨d ≫ (inv f).hom.hom, ?_⟩
  have hfi := congrArg (fun a : H ⟶ G => inv f ≫ a) hf
  simp only [← Category.assoc, IsIso.inv_hom_id, Category.id_comp] at hfi
  rw [Category.assoc, ← Grp.comp_hom_hom, ← hfi]
  exact hd

end EnvelopeBaseChange

variable {k : Type u} [Field k] (K : Type u) [Field K] [Algebra k K]

/-- For a smooth affine group over a field `k` and any field extension `K`, the
extension of the fixed envelope of `k`-tori lies in the fixed envelope of
`K`-tori, on every test scheme over `K`. -/
theorem closedTorusEnvelope_baseChange_le (G : GroupScheme (Spec (CommRingCat.of k)))
    [Smooth G.X.hom] [IsAffineHom G.X.hom] :
    (closedTorusEnvelope G).baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≤
      closedTorusEnvelope
        ((GroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj G) := by
  obtain ⟨H, i, hi, hmin⟩ := EnvelopeBaseChange.exists_minimal_height_admissible K G
  have hrange : SubgroupFunctor.range i = closedTorusEnvelope G :=
    le_antisymm hi.1.2.2.2
      (closedTorusEnvelope_le i hi.1.1 (EnvelopeBaseChange.minimal_containsTori K i hi hmin))
  rw [← hrange]
  exact hi.2

/-- The extension of the fixed envelope of `k`-tori equals the fixed envelope of
`K`-tori exactly when it contains every closed `K`-torus. -/
theorem closedTorusEnvelope_baseChange_eq_iff_containsTori
    (G : GroupScheme (Spec (CommRingCat.of k))) [Smooth G.X.hom] [IsAffineHom G.X.hom] :
    (closedTorusEnvelope G).baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
        closedTorusEnvelope
          ((GroupScheme.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj G) ↔
      ((closedTorusEnvelope G).baseChange
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))).ContainsTori := by
  constructor
  · intro h
    rw [h]
    exact closedTorusEnvelope_containsTori _
  · intro h
    apply le_antisymm (closedTorusEnvelope_baseChange_le K G)
    let D := smoothTorusGeneratedEnvelope G
    rw [← D.represents.2, ← SubgroupFunctor.range_baseChangeHom] at h ⊢
    exact closedTorusEnvelope_le _ (D.closed.baseChange _) h

end Langlands.GroupScheme
