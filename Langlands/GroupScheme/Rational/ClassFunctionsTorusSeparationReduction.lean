open Langlands.LinearAlgebra.DominantTriangular

/-! ### Characters separate points of a split torus -/

section PointSeparation

variable {S : Scheme.{u}} {T : CommGroupScheme S}

/-- Characters of a split torus separate its points over every test scheme. -/
theorem IsSplitTorus.point_ext_characters (hT : IsSplitTorus T.toGrp) {U : Over S}
    {x y : U ⟶ T.X}
    (h : ∀ χ : characterLattice T, x ≫ (CommGroupScheme.groupHom χ).hom.hom =
      y ≫ (CommGroupScheme.groupHom χ).hom.hom) : x = y := by
  obtain ⟨I, hI, ⟨e⟩⟩ := hT
  let eC : T ≅ splitTorus.commGroupScheme S I :=
    { hom := Additive.ofMul e.hom
      inv := Additive.ofMul e.inv
      hom_inv_id := congrArg Additive.ofMul e.hom_inv_id
      inv_hom_id := congrArg Additive.ofMul e.inv_hom_id }
  let : Fintype I := Fintype.ofFinite I
  have hid : 𝟙 T = ∑ c, (eC.hom ≫ splitTorus.proj S I c) ≫
      (splitTorus.single S I c ≫ eC.inv) := by
    calc 𝟙 T = eC.hom ≫ 𝟙 _ ≫ eC.inv := by simp
      _ = eC.hom ≫ (∑ c, splitTorus.proj S I c ≫ splitTorus.single S I c) ≫ eC.inv := by
        rw [splitTorus.sum_proj_comp_single]
      _ = _ := by simp only [Preadditive.sum_comp, Preadditive.comp_sum, Category.assoc]
  have key : ∀ z : U ⟶ T.X, z = ∏ c,
      (z ≫ (CommGroupScheme.groupHom (eC.hom ≫ splitTorus.proj S I c)).hom.hom) ≫
        (CommGroupScheme.groupHom (splitTorus.single S I c ≫ eC.inv)).hom.hom := by
    intro z
    have hz : z = z ≫ (CommGroupScheme.groupHom (𝟙 T)).hom.hom := (Category.comp_id z).symm
    conv_lhs => rw [hz, hid]
    rw [comp_groupHom_sum]
    exact Finset.prod_congr rfl fun c _ => comp_groupHom_comp _ _ _
  rw [key x, key y]
  exact Finset.prod_congr rfl fun c _ => by rw [h]

end PointSeparation

/-! ### Character values at rational points -/

section CharacterValues

variable {k : Type u} [CommRing k] {T : CommGroupScheme (Spec (CommRingCat.of k))}

/-- The values of all characters of `T` at a `k`-point `s`, as a homomorphism from the
multiplicative character lattice to `k`. -/
def characterValues (s : rationalPoints T.toGrp) : Multiplicative (characterLattice T) →* k where
  toFun ν :=
    (rationalCharacterEval ((rationalCharacters.equivCharacterLattice T).symm ν.toAdd) s : k)
  map_one' := by
    rw [toAdd_one, map_zero, rationalCharacterEval_zero, Units.val_one]
  map_mul' a b := by
    rw [toAdd_mul, map_add, rationalCharacterEval_add, Units.val_mul]

theorem characterValues_apply (s : rationalPoints T.toGrp) (ν : characterLattice T) :
    characterValues s (Multiplicative.ofAdd ν) =
      (rationalCharacterEval ((rationalCharacters.equivCharacterLattice T).symm ν) s : k) :=
  rfl

theorem characterValues_eq_affinePointsEquiv (s : rationalPoints T.toGrp)
    (ν : characterLattice T) :
    characterValues s (Multiplicative.ofAdd ν) =
      (Gm.affinePointsEquiv (𝟙 _) (s ≫ (CommGroupScheme.groupHom ν).hom.hom) : k) :=
  rfl

/-- Values at `s` of the characters moved by `characterAut σ` are the values at `σ⁻¹ s`. -/
theorem characterValues_characterAut (s : rationalPoints T.toGrp) (σ : T ≅ T)
    (ν : characterLattice T) :
    characterValues s (Multiplicative.ofAdd (characterAut σ ν)) =
      characterValues (s ≫ (CommGroupScheme.groupHom σ.inv).hom.hom)
        (Multiplicative.ofAdd ν) := by
  rw [characterValues_eq_affinePointsEquiv, characterValues_eq_affinePointsEquiv,
    characterAut_apply, comp_groupHom_comp]

/-- Characters separate the `k`-points of a split torus. -/
theorem IsSplitTorus.eq_of_characterValues_eq (hT : IsSplitTorus T.toGrp)
    {s t : rationalPoints T.toGrp}
    (h : ∀ ν : characterLattice T,
      characterValues s (Multiplicative.ofAdd ν) = characterValues t (Multiplicative.ofAdd ν)) :
    s = t := by
  apply hT.point_ext_characters
  intro ν
  apply (Gm.affinePointsEquiv (𝟙 (Spec (CommRingCat.of k)))).injective
  exact Units.ext (h ν)

end CharacterValues

/-! ### Realizing the reflection group by normalizing points -/

section Normalizing

variable {k : Type u} [Field k] {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom] {J : Type*}

/-- Every element of the group generated by the reflections of a root datum of `i` is the
character action of a point normalizing `i`. -/
theorem IsRootDatumOf.exists_isNormalizingPoint {i : T.toGrp ⟶ G}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)} (hP : IsRootDatumOf i P)
    {w : characterLattice T ≃ₗ[ℤ] characterLattice T} (hw : w ∈ reflectionGroup P) :
    ∃ (n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) (σ : T ≅ T),
      IsNormalizingPoint i n σ ∧ characterAut σ = w := by
  induction hw using Subgroup.closure_induction with
  | mem v hv =>
    obtain ⟨α, rfl⟩ := hv
    exact hP.2.2 α
  | one =>
    exact ⟨1, Iso.refl T, IsNormalizingPoint.one, LinearEquiv.ext fun χ => Category.id_comp χ⟩
  | mul u v _ _ hu hv =>
    obtain ⟨n, σ, hn, rfl⟩ := hu
    obtain ⟨m, τ, hm, rfl⟩ := hv
    refine ⟨n * m, τ ≪≫ σ, hn.mul hm, LinearEquiv.ext fun χ => ?_⟩
    rw [LinearEquiv.mul_apply, characterAut_apply, characterAut_apply, characterAut_apply,
      Iso.trans_inv, Category.assoc]
  | inv u _ hu =>
    obtain ⟨n, σ, hn, rfl⟩ := hu
    exact ⟨n⁻¹, σ.symm, hn.inv, LinearEquiv.ext fun χ => rfl⟩

omit [IsAffineHom G.X.hom] in
/-- If `n` normalizes `i` through `σ` and `t = σ⁻¹ s` on `k`-points, then `n⁻¹`
conjugates the image of `s` to the image of `t`. -/
theorem IsNormalizingPoint.inv_mul_mul_eq {i : T.toGrp ⟶ G}
    {n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X} {σ : T ≅ T}
    (hn : IsNormalizingPoint i n σ) {s t : rationalPoints T.toGrp}
    (ht : t = s ≫ (CommGroupScheme.groupHom σ.inv).hom.hom) :
    n⁻¹ * (s ≫ i.hom.hom) * n⁻¹⁻¹ = t ≫ i.hom.hom := by
  have h := congrArg (fun f : T.toGrp ⟶ G => s ≫ f.hom.hom) hn.inv
  simp only [Grp.comp_hom_hom, ← Category.assoc] at h
  rw [ht]
  refine Eq.trans ?_ h
  rw [comp_innerIso_hom]
  rfl

end Normalizing

/-! ### Conjugacy from triangular character data -/

namespace SplitPinning

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom]

/-- Let `p` be a split pinning and `s t` two `k`-points of its torus. Suppose every dominant
`lam` admits a reflection-group-invariant function `c` on the character lattice with
`c lam = 1`, support below `lam`, and the same character sum at `s` and at `t`. Then the images
of `s` and `t` in `G(k)` are conjugate. -/
theorem exists_conj_of_triangular (p : SplitPinning G) (s t : rationalPoints p.torus.toGrp)
    (hc : ∀ lam : characterLattice p.torus, p.IsDominantWeight lam →
      ∃ c : characterLattice p.torus →₀ k,
        LinearAlgebra.DominantTriangular.IsInvariant (reflectionGroup p.rootDatum) c ∧
        c lam = 1 ∧ (∀ ν, c ν ≠ 0 → lam - ν ∈ p.positiveRootMonoid) ∧
        evalChar (characterValues s) c = evalChar (characterValues t) c) :
    ∃ g : rationalPoints G, g * (s ≫ p.inclusion.hom.hom) * g⁻¹ = t ≫ p.inclusion.hom.hom := by
  obtain ⟨w, hw, hwν⟩ :=
    exists_mem_reflectionGroup_of_triangular p.base (characterValues s) (characterValues t) hc
  obtain ⟨n, σ, hn, rfl⟩ := p.isRootDatum.exists_isNormalizingPoint hw
  have ht : t = s ≫ (CommGroupScheme.groupHom σ.inv).hom.hom := by
    apply p.isSplitTorus.eq_of_characterValues_eq
    intro ν
    rw [hwν ν, characterValues_characterAut]
  exact ⟨n⁻¹, hn.inv_mul_mul_eq ht⟩

end SplitPinning

namespace ClassFunctions

/-- **Torus separation from root data and triangular character data.** Suppose that every
connected reductive group with a split maximal torus has a reduced root datum
(`RootDatumExistenceStatement`), and that for every split pinning `p` over an algebraically
closed field and all `k`-points `s t` of its torus with the same image under `rho G`, every
dominant `lam` admits an invariant triangular function with equal character sums at `s` and
`t`. Then `TorusSeparationStatement` holds. -/
theorem torusSeparation_of_triangular (hroot : RootDatumExistenceStatement.{u})
    (htri : ∀ (k : Type u) [Field k] [IsAlgClosed k]
      (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom]
      (p : SplitPinning G) (s t : rationalPoints p.torus.toGrp),
      (s ≫ p.inclusion.hom.hom) ≫ rho G = (t ≫ p.inclusion.hom.hom) ≫ rho G →
      ∀ lam : characterLattice p.torus, p.IsDominantWeight lam →
        ∃ c : characterLattice p.torus →₀ k,
        LinearAlgebra.DominantTriangular.IsInvariant (reflectionGroup p.rootDatum) c ∧
          c lam = 1 ∧ (∀ ν, c ν ≠ 0 → lam - ν ∈ p.positiveRootMonoid) ∧
          evalChar (characterValues s) c = evalChar (characterValues t) c) :
    TorusSeparationStatement.{u} := by
  intro k _ _ G hG
  have : IsAffineHom G.X.hom := hG.isConnectedReductive.isAffineHom
  intro T j hj s t hst
  have hT : IsSplitTorus T.toGrp :=
    SplittingAssembly.isSplit_of_isSepClosed_of_prerequisites
      CoalgebraDescent.separablyClosedGroupLikeSpanning T.toGrp hj.1
  obtain ⟨J, hJ, P, hP, hred⟩ := hroot k G hG.isConnectedReductive T hT j hj
  let : Finite J := hJ
  let p : SplitPinning G := SplitPinning.ofRootDatum hG.isConnectedReductive hT j hj P hP hred
    (splitRootLieLine k G hG.isConnectedReductive T hT j hj)
  exact p.exists_conj_of_triangular s t (htri k G p s t hst)

end ClassFunctions

end Langlands.GroupScheme
