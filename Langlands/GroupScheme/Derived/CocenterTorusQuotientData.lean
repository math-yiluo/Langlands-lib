import Langlands.GroupScheme.Derived.CommutativeQuotientData
import Langlands.GroupScheme.Derived.MaximalTorusProductSurjectivityStatement
import Langlands.GroupScheme.Torus.ExistenceProof
import Langlands.GroupScheme.Torus.SplitOfDomination
import Langlands.GroupScheme.CentralIsogeny.FpqcReflection
import Langlands.GroupScheme.GaloisPointRational

/-! # Cocenter torus quotient data from derived maximal-torus products -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

section Surjectivity

variable {S : Scheme.{u}} {G D H Q : GroupScheme S}

/-- A surjective commutative quotient of a group generated by its derived
subgroup and `H` is already the surjective image of `H`. -/
theorem IsDerivedSubgroup.surjective_comp_of_surjective_product
    {d : D ⟶ G} (hd : IsDerivedSubgroup d) (i : H ⟶ G) (q : G ⟶ Q)
    [IsCommMonObj Q.X] [IsSeparated Q.X.hom]
    (hp : Surjective (subgroupProductMap d i).left)
    (hq : Surjective q.hom.hom.left) :
    Surjective (i ≫ q).hom.hom.left := by
  have hdq : d.hom.hom ≫ q.hom.hom = 1 := by
    simpa only [Grp.comp_hom_hom, Grp.Hom.hom_one, Mon.Hom.hom_one] using
      congrArg (fun f => f.hom.hom) (hd.comp_eq_one q)
  have he : subgroupProductMap d i ≫ q.hom.hom =
      snd D.X H.X ≫ (i ≫ q).hom.hom := by
    simp only [subgroupProductMap, MonObj.mul_comp, Category.assoc, hdq,
      MonObj.comp_one, one_mul, Grp.comp_hom_hom]
  let : Surjective (subgroupProductMap d i).left := hp
  let : Surjective q.hom.hom.left := hq
  let : Surjective ((snd D.X H.X).left ≫ (i ≫ q).hom.hom.left) := by
    change Surjective (snd D.X H.X ≫ (i ≫ q).hom.hom).left
    rw [← he]
    change Surjective ((subgroupProductMap d i).left ≫ q.hom.hom.left)
    infer_instance
  exact Surjective.of_comp (snd D.X H.X).left (i ≫ q).hom.hom.left

end Surjectivity

section Tori

variable {k : Type u} [Field k]
    {T Q : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth Q.X.hom] [IsAffineHom Q.X.hom]

/-- A smooth affine group that is a surjective homomorphic image of a split
torus is split. -/
theorem IsSplitTorus.of_surjective_hom_to_smooth
    (hT : IsSplitTorus T) (f : T ⟶ Q)
    (hf : Surjective f.hom.hom.left) : IsSplitTorus Q := by
  let : IsReduced Q.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field
      k Q.X.left Q.X.hom
  let : Surjective f.hom.hom.left := hf
  let : IsDominant f.hom.hom.left := inferInstance
  exact hT.of_schematicallyDominant_hom f
    (IsSchemeTheoreticallyDominant.of_isDominant f.hom.hom.left)

/-- Surjective homomorphic images in a smooth affine target split over every
field extension splitting the source torus. -/
theorem IsTorus.isSplitTorus_baseChange_of_surjective_hom
    (f : T ⟶ Q) (hf : Surjective f.hom.hom.left)
    (E : Type u) [Field E] [Algebra k E]
    (hT : IsSplitTorus (GaloisPointComparison.baseChanged k E T)) :
    IsSplitTorus (GaloisPointComparison.baseChanged k E Q) := by
  let b := GaloisPointComparison.baseMap k E
  let F := GroupScheme.baseChange b
  let : Surjective f.hom.hom.left := hf
  have hfE : Surjective (F.map f).hom.hom.left :=
    MorphismProperty.of_isPullback (baseChange_map_isPullback b f).flip inferInstance
  let : Smooth (F.obj Q).X.hom :=
    inferInstanceAs (Smooth (CategoryTheory.Limits.pullback.snd Q.X.hom b))
  let : IsAffineHom (F.obj Q).X.hom :=
    inferInstanceAs (IsAffineHom (CategoryTheory.Limits.pullback.snd Q.X.hom b))
  exact hT.of_surjective_hom_to_smooth (F.map f) hfE

end Tori

section Cocenter

variable {k : Type u} [Field k]
    {G D : GroupScheme (Spec (CommRingCat.of k))}

/-- Choose a cocenter torus quotient with its maximal-torus surjections and
splitting comparisons, retaining derived maximal-torus product surjectivity
as the explicit structural input. Integral cocharacters are not asserted. -/
def cocenterTorusQuotientData
    (hprod : DerivedMaximalTorusProductSurjectivityStatement.{u})
    (hG : IsConnectedReductive G) {d : D ⟶ G} (hd : IsDerivedSubgroup d) :
    Σ (Q : CommGroupScheme (Spec (CommRingCat.of k))),
      {q : G ⟶ Q.toGrp //
        Smooth Q.X.hom ∧ IsAffineHom Q.X.hom ∧
        RelativeRoot.IsFppfQuotient (SubgroupFunctor.range d) q ∧
        IsTorus Q.toGrp ∧
        ∀ (T : CommGroupScheme (Spec (CommRingCat.of k))) (t : T.toGrp ⟶ G),
          IsMaximalTorus t →
          Surjective (t ≫ q).hom.hom.left ∧
          ∀ (E : Type u) [Field E] [Algebra k E],
            IsSplitTorus (GaloisPointComparison.baseChanged k E T.toGrp) →
            IsSplitTorus (GaloisPointComparison.baseChanged k E Q.toGrp)} := by
  let : Smooth G.X.hom := hG.smooth
  let : IsAffineHom G.X.hom := hG.isAffineHom
  let C := hd.commutativeQuotientData
  let Q := C.1
  let q := C.2.1
  have hC := C.2.2
  let : Smooth Q.X.hom := hC.1
  let : IsAffineHom Q.X.hom := hC.2.1
  have hsurj (T : CommGroupScheme (Spec (CommRingCat.of k))) (t : T.toGrp ⟶ G)
      (ht : IsMaximalTorus t) : Surjective (t ≫ q).hom.hom.left :=
    hd.surjective_comp_of_surjective_product t q
      (hprod k G D T d t hG hd ht) hC.2.2.2.1
  have hsplit (T : CommGroupScheme (Spec (CommRingCat.of k))) (t : T.toGrp ⟶ G)
      (ht : IsMaximalTorus t) (E : Type u) [Field E] [Algebra k E]
      (hs : IsSplitTorus (GaloisPointComparison.baseChanged k E T.toGrp)) :
      IsSplitTorus (GaloisPointComparison.baseChanged k E Q.toGrp) :=
    IsTorus.isSplitTorus_baseChange_of_surjective_hom (t ≫ q) (hsurj T t ht) E hs
  have hQ : IsTorus Q.toGrp := by
    obtain ⟨T, t, ht⟩ := TorusExistence.exists_isMaximalTorus G
    obtain ⟨E, hE, aE, hs⟩ := ht.1
    exact ⟨E, hE, aE, hsplit T t ht E hs⟩
  exact ⟨Q, q, hC.1, hC.2.1, hC.2.2, hQ,
    fun T t ht => ⟨hsurj T t ht, hsplit T t ht⟩⟩

end Cocenter

end Langlands.GroupScheme
