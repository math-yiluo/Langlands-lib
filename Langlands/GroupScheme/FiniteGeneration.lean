import Langlands.GroupScheme.ImageGenerationStatement
import Langlands.GroupScheme.SmoothConnectedGeometryProof
import Langlands.GroupScheme.Lie.DimensionInduction
import Langlands.GroupScheme.Rational.LeviFactorization
import Langlands.GroupScheme.UnitSubgroup

/-! # Extracting finite generating subfamilies of connected subgroups -/

noncomputable section

universe u v

open CategoryTheory CategoryTheory.MonoidalCategory
  CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {I : Type v} (A : I → GroupScheme (Spec (CommRingCat.of k))) (a : ∀ j, A j ⟶ G)

/-- A closed subgroup represents the subgroup generated by the indicated finite
subfamily. The minimality is on all test schemes and admits arbitrary closed competitors. -/
def IsGeneratedBySubfamily (s : Finset I)
    {H : GroupScheme (Spec (CommRingCat.of k))} (i : H ⟶ G) : Prop :=
  IsClosedSubgroup i ∧
    (∀ j ∈ s, FactorsThrough (a j).hom.hom i) ∧
    ∀ (K : GroupScheme (Spec (CommRingCat.of k))) (q : K ⟶ G), IsClosedSubgroup q →
      (∀ j ∈ s, FactorsThrough (a j).hom.hom q) →
        SubgroupFunctor.range i ≤ SubgroupFunctor.range q

namespace FiniteGeneration

variable {A a}

private theorem dimension_le {H : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom] [IsAffineHom H.X.hom] [Smooth G.X.hom]
    (i : H ⟶ G) (hi : IsClosedSubgroup i) :
    Lie.dimension H ≤ Lie.dimension G := by
  let : IsClosedImmersion i.hom.hom.left := hi
  let : Mono i.hom.hom := Over.mono_of_mono_left _
  exact LinearMap.finrank_le_finrank_of_injective (Lie.targetMapLinear_injective i k)

private theorem range_represents {H : GroupScheme (Spec (CommRingCat.of k))}
    (i : H ⟶ G) (hi : IsClosedSubgroup i) :
    (SubgroupFunctor.range i).IsRepresentedBy i := by
  let : IsClosedImmersion i.hom.hom.left := hi
  exact ⟨Over.mono_of_mono_left _, rfl⟩

/-- Pointed-image generation constructs the generated representative of every
finite family of smooth connected affine groups. -/
theorem exists_generated_subfamily
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (hGeneration : PointedImageGenerationStatement.{u})
    (hA : ∀ j, Smooth (A j).X.hom ∧ IsAffineHom (A j).X.hom ∧
      ConnectedSpace (A j).X.left) (s : Finset I) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left ∧
        IsGeneratedBySubfamily A a s i := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨Grp.trivial (Over (Spec (CommRingCat.of k))), kernelUnit G, ?_, ?_, ?_,
      kernelUnit_isClosedSubgroup G, ?_, ?_⟩
    · change Smooth (𝟙 (Spec (CommRingCat.of k)))
      infer_instance
    · change IsAffineHom (𝟙 (Spec (CommRingCat.of k)))
      infer_instance
    · change ConnectedSpace (Spec (CommRingCat.of k))
      infer_instance
    · simp only [Finset.notMem_empty, false_implies, implies_true]
    · intro K q _ _
      rw [range_kernelUnit]
      intro T
      exact bot_le
  | @insert t s _ ih =>
    obtain ⟨H, i, hsm, haff, hconn, hi⟩ := ih
    let : Smooth H.X.hom := hsm
    let : IsAffineHom H.X.hom := haff
    let : ConnectedSpace H.X.left := hconn
    let : Smooth (A t).X.hom := (hA t).1
    let : IsAffineHom (A t).X.hom := (hA t).2.1
    let : ConnectedSpace (A t).X.left := (hA t).2.2
    have hgeom := smoothConnectedAffineGeometry.2 k H (A t) hsm haff hconn
      (hA t).1 (hA t).2.1 (hA t).2.2
    let f : H.X ⊗ (A t).X ⟶ G.X :=
      (fst H.X (A t).X ≫ i.hom.hom) * (snd H.X (A t).X ≫ (a t).hom.hom)
    let v₀ : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X ⊗ (A t).X := lift 1 1
    have hv₀ : v₀ ≫ f = 1 := by
      simp [v₀, f, MonObj.comp_mul, MonObj.one_comp]
    obtain ⟨D, hD⟩ := hGeneration k G inferInstance inferInstance
      (H.X ⊗ (A t).X) hgeom.1 hgeom.2.1 hgeom.2.2.2 v₀ f hv₀
    let : GeometricallyConnected D.group.X.hom := hD.2.2.1
    have hDconn : ConnectedSpace D.group.X.left :=
      GeometricallyConnected.connectedSpace_of_subsingleton (f := D.group.X.hom)
    have hH : FactorsThrough i.hom.hom D.inclusion := by
      refine ⟨lift (𝟙 H.X) 1 ≫ D.factor, ?_⟩
      rw [Category.assoc, D.factor_comp]
      simp [f, MonObj.comp_mul, MonObj.one_comp]
    have ht : FactorsThrough (a t).hom.hom D.inclusion := by
      refine ⟨lift 1 (𝟙 (A t).X) ≫ D.factor, ?_⟩
      rw [Category.assoc, D.factor_comp]
      simp [f, MonObj.comp_mul, MonObj.one_comp]
    refine ⟨D.group, D.inclusion, hD.1, hD.2.1, hDconn, D.closed, ?_, ?_⟩
    · intro j hj
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact ht
      · obtain ⟨b, hb⟩ := hi.2.1 j hj
        obtain ⟨c, hc⟩ := hH
        exact ⟨b ≫ c, by rw [Category.assoc, hc, hb]⟩
    · intro K q hq hqfamily
      have hle := hi.2.2 K q hq (fun j hj =>
        hqfamily j (Finset.mem_insert_of_mem hj))
      let bH : H ⟶ K := (range_represents q hq).factorHom i hle
      have hbH : bH.hom.hom ≫ q.hom.hom = i.hom.hom := by
        change (bH ≫ q).hom.hom = i.hom.hom
        rw [(range_represents q hq).factorHom_comp]
      obtain ⟨bt, hbt⟩ := hqfamily t (Finset.mem_insert_self _ _)
      apply D.range_le q hq
      refine ⟨(fst H.X (A t).X ≫ bH.hom.hom) * (snd H.X (A t).X ≫ bt), ?_⟩
      rw [MonObj.mul_comp, Category.assoc, Category.assoc, hbH, hbt]

/-- The finite-family dimension argument. The existence of smooth connected
generated representatives is an explicit premise of this intermediate lemma. -/
theorem exists_finite_generating_subfamily
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (hfinite : ∀ s : Finset I,
      ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
        Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left ∧
          IsGeneratedBySubfamily A a s i)
    (hgenerates : ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      IsClosedSubgroup i → (∀ j, FactorsThrough (a j).hom.hom i) →
        SubgroupFunctor.range i = ⊤) :
    ∃ s : Finset I,
      ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
        IsClosedSubgroup i → (∀ j ∈ s, FactorsThrough (a j).hom.hom i) →
          SubgroupFunctor.range i = ⊤ := by
  classical
  let P (n : ℕ) : Prop :=
    ∃ (s : Finset I) (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G)
      (_ : Smooth H.X.hom) (hAff : IsAffineHom H.X.hom)
      (_ : ConnectedSpace H.X.left),
      IsGeneratedBySubfamily A a s i ∧ @Lie.dimension k _ H hAff = n
  have hbound : ∀ n, P n → n ≤ Lie.dimension G := by
    rintro n ⟨s, H, i, hsm, haff, hconn, hi, rfl⟩
    let : Smooth H.X.hom := hsm
    let : IsAffineHom H.X.hom := haff
    exact dimension_le i hi.1
  obtain ⟨H₀, i₀, hsm₀, haff₀, hconn₀, hi₀⟩ := hfinite ∅
  let : IsAffineHom H₀.X.hom := haff₀
  have hp₀ : P (Lie.dimension H₀) := ⟨∅, H₀, i₀, hsm₀, haff₀, hconn₀, hi₀, rfl⟩
  obtain ⟨s, H, i, hsm, haff, hconn, hi, hdim⟩ :=
    Nat.findGreatest_spec (P := P) (hbound _ hp₀) hp₀
  let : Smooth H.X.hom := hsm
  let : IsAffineHom H.X.hom := haff
  let : ConnectedSpace H.X.left := hconn
  have hmax : ∀ n, P n → n ≤ Lie.dimension H := by
    intro n hn
    rw [hdim]
    exact Nat.le_findGreatest (hbound n hn) hn
  have hall : ∀ t, FactorsThrough (a t).hom.hom i := by
    intro t
    obtain ⟨E, e, hsmE, haffE, hconnE, he⟩ := hfinite (insert t s)
    let : Smooth E.X.hom := hsmE
    let : IsAffineHom E.X.hom := haffE
    let : ConnectedSpace E.X.left := hconnE
    have hle : SubgroupFunctor.range i ≤ SubgroupFunctor.range e :=
      hi.2.2 E e he.1 (fun j hj => he.2.1 j (Finset.mem_insert_of_mem hj))
    let f : H ⟶ E := (range_represents e he.1).factorHom i hle
    have hf : f ≫ e = i := (range_represents e he.1).factorHom_comp i hle
    have hclosed : IsClosedSubgroup f :=
      IsClosedSubgroup.of_comp he.1 (by rw [hf]; exact hi.1)
    have hdimE : Lie.dimension E ≤ Lie.dimension H :=
      hmax _ ⟨insert t s, E, e, hsmE, haffE, hconnE, he, rfl⟩
    have hfiso : IsIso f := by
      by_contra hnot
      have hlt := Lie.dimension_lt_of_proper_closedSubgroup f hclosed hnot
      omega
    let : IsIso f := hfiso
    have hinv : inv f ≫ i = e := by
      rw [← hf, IsIso.inv_hom_id_assoc]
    obtain ⟨b, hb⟩ := he.2.1 t (Finset.mem_insert_self _ _)
    refine ⟨b ≫ (inv f).hom.hom, ?_⟩
    rw [Category.assoc, ← Grp.comp_hom_hom, hinv, hb]
  have htop := hgenerates H i hi.1 hall
  refine ⟨s, ?_⟩
  intro K q hq hsq
  have hle := hi.2.2 K q hq hsq
  rw [htop] at hle
  apply SubgroupFunctor.ext
  intro U
  exact le_antisymm le_top (hle U)

/-- An all-family generation theorem admits a finite subfamily, conditional only
on the explicit pointed-image generation theorem and the family's geometry. -/
theorem exists_finite_generating_subfamily_of_pointedImageGeneration
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (hGeneration : PointedImageGenerationStatement.{u})
    (hA : ∀ j, Smooth (A j).X.hom ∧ IsAffineHom (A j).X.hom ∧
      ConnectedSpace (A j).X.left)
    (hgenerates : ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      IsClosedSubgroup i → (∀ j, FactorsThrough (a j).hom.hom i) →
        SubgroupFunctor.range i = ⊤) :
    ∃ s : Finset I,
      ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
        IsClosedSubgroup i → (∀ j ∈ s, FactorsThrough (a j).hom.hom i) →
          SubgroupFunctor.range i = ⊤ :=
  exists_finite_generating_subfamily
    (fun s => exists_generated_subfamily hGeneration hA s) hgenerates

end FiniteGeneration

end Langlands.GroupScheme
