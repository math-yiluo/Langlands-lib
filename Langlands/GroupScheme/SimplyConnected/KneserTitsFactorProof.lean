import Langlands.GroupScheme.SimplyConnected.KneserTitsFactorStatement
import Langlands.GroupScheme.SimplyConnected.KneserTitsFactorReduction
import Langlands.GroupScheme.SimplyConnected.LocalKneserTitsProof
import Langlands.GroupScheme.Reductive.NormalIsogenyComplementProof
import Langlands.GroupScheme.Rational.RationalBruhatProof
import Langlands.GroupScheme.Rational.RootRankOneFactorizationProof
import Langlands.GroupScheme.Absolute.ParabolicDynamicProof
import Langlands.GroupScheme.Rational.SmoothMaximalSplitTorusConjugacyProof

/-! # Kneser–Tits for the isotropic almost-simple factors of a simply connected group: proof -/

universe u

namespace Langlands.GroupScheme

/-- **Kneser–Tits for the isotropic factors.** Over a nonarchimedean local field, the rational
points of every isotropic closed normal almost-simple subgroup of a simply connected group lie
in the subgroup generated by the root groups of a maximal split torus. -/
theorem simplyConnectedKneserTitsFactor : SimplyConnectedKneserTitsFactorStatement.{u} :=
  simplyConnectedKneserTitsFactor_of_localKT_and_structural_inputs localKneserTits
    semisimpleNormalIsogenyComplement rationalBruhat rootRankOneFactorization
    parabolicDynamic smoothMaximalSplitTorusConjugacy

end Langlands.GroupScheme
