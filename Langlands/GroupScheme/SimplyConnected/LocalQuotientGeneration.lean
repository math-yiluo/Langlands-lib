import Langlands.GroupScheme.Rational.FiniteSeparableQuotientExactness
import Langlands.GroupScheme.SimplyConnected.LocalCocycleVanishingStatement

/-! # Rational generation from quotient generation and kernel containment -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.AlgebraicGeometry.AlgebraicSpace
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.QuotientGeneration

section Kernel

variable {k : Type u} [CommRing k]
    {M D Q : GroupScheme (Spec (CommRingCat.of k))}
    (d : D ⟶ M) (q : M ⟶ Q)
    (hker : SubgroupFunctor.range d = SubgroupFunctor.range (kernelι q))

include hker

/-- A rational point killed by `q` is the image of a rational point of the
represented kernel. -/
theorem exists_kernel_point (x : rationalPoints M) (hx : rationalPoints.map q x = 1) :
    ∃ v : rationalPoints D, rationalPoints.map d v = x := by
  have h : x ∈ (SubgroupFunctor.range d).carrier (Over.mk (𝟙 _)) := by
    rw [hker, mem_range_kernelι_iff]
    exact hx
  exact SubgroupFunctor.mem_range.mp h

/-- On rational points, the kernel of `q` is the image of the represented kernel. -/
theorem ker_map_eq_range_map :
    (rationalPoints.map q).ker = (rationalPoints.map d).range := by
  ext x
  constructor
  · exact fun hx => exists_kernel_point d q hker x hx
  · rintro ⟨v, rfl⟩
    exact QuotientPointCocycle.kernelPoint_comp d q hker v

/-- A subgroup of `M(k)` containing the image of `D(k)`, whose image in `Q(k)`
contains the image of all of `M(k)`, is everything. -/
theorem eq_top_of_range_le_map (H : Subgroup (rationalPoints M))
    (hD : (rationalPoints.map d).range ≤ H)
    (hQ : (rationalPoints.map q).range ≤ H.map (rationalPoints.map q)) : H = ⊤ := by
  rw [eq_top_iff]
  intro x _
  obtain ⟨h, hh, hqh⟩ := hQ ⟨x, rfl⟩
  have hk : rationalPoints.map q (h⁻¹ * x) = 1 := by
    rw [map_mul, map_inv, hqh, inv_mul_cancel]
  obtain ⟨v, hv⟩ := exists_kernel_point d q hker _ hk
  have hm : h⁻¹ * x ∈ H := hD ⟨v, hv⟩
  simpa using H.mul_mem hh hm

end Kernel

section Family

variable {k : Type u} [CommRing k]
    {M D Q : GroupScheme (Spec (CommRingCat.of k))}
    (d : D ⟶ M) (q : M ⟶ Q)
    (hker : SubgroupFunctor.range d = SubgroupFunctor.range (kernelι q))
    {J : Type*} {Mi Qi : J → GroupScheme (Spec (CommRingCat.of k))}
    (m : ∀ i, Mi i ⟶ M) (qi : ∀ i, Mi i ⟶ Qi i) (φ : ∀ i, Qi i ⟶ Q)
    (hcomm : ∀ i, m i ≫ q = qi i ≫ φ i)

/-- The subgroup of `M(k)` generated by the images of all `M_i(k)`. -/
abbrev generatedPoints : Subgroup (rationalPoints M) :=
  Subgroup.closure (⋃ i, ((rationalPoints.map (m i)).range : Set (rationalPoints M)))

include hker hcomm in
/-- Diagram chase: if every `M_i(k) → Q_i(k)` is surjective, the images of the
`Q_i(k)` generate a subgroup of `Q(k)` containing the image of `M(k)`, and the
images of the `M_i(k)` generate a subgroup containing the image of `D(k)`, then
the images of the `M_i(k)` generate `M(k)`. -/
theorem generatedPoints_eq_top_of_surjective
    (hsurj : ∀ i, Function.Surjective (rationalPoints.map (qi i)))
    (hQ : (rationalPoints.map q).range ≤
      Subgroup.closure (⋃ i, ((rationalPoints.map (φ i)).range : Set (rationalPoints Q))))
    (hD : (rationalPoints.map d).range ≤ generatedPoints m) :
    generatedPoints m = ⊤ := by
  refine eq_top_of_range_le_map d q hker _ hD (hQ.trans ?_)
  rw [Subgroup.closure_le]
  intro y hy
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy
  obtain ⟨z, rfl⟩ := hi
  obtain ⟨w, rfl⟩ := hsurj i z
  refine ⟨rationalPoints.map (m i) w,
    Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, w, rfl⟩), ?_⟩
  have h := congrArg (fun f : Mi i ⟶ Q => w ≫ f.hom.hom) (hcomm i)
  simpa [rationalPoints.map_apply] using h

end Family

section Vanishing

variable {k : Type u} [Field k]
    {M D Q : GroupScheme (Spec (CommRingCat.of k))}
    (d : D ⟶ M) (q : M ⟶ Q)
    (hker : SubgroupFunctor.range d = SubgroupFunctor.range (kernelι q))
    {J : Type*} {Mi Di Qi : J → GroupScheme (Spec (CommRingCat.of k))}
    (m : ∀ i, Mi i ⟶ M) (di : ∀ i, Di i ⟶ Mi i) (qi : ∀ i, Mi i ⟶ Qi i)
    (φ : ∀ i, Qi i ⟶ Q) (hcomm : ∀ i, m i ≫ q = qi i ≫ φ i)
    (hkeri : ∀ i, SubgroupFunctor.range (di i) = SubgroupFunctor.range (kernelι (qi i)))
    [∀ i, Mono (di i).hom.hom] [∀ i, Smooth (qi i).hom.hom.left]
    [∀ i, Surjective (qi i).hom.hom.left]

include hker hcomm hkeri in
/-- If every finite separable cocycle of every `D_i` vanishes, quotient generation
and kernel containment give generation of `M(k)` by the images of the `M_i(k)`. -/
theorem generatedPoints_eq_top_of_finiteSeparable_vanishing
    (hvanish : ∀ i (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L]
      [Algebra.IsSeparable k L] (ξ : Cocycle (Di i) (specOver k L)), ξ.IsTrivial)
    (hQ : (rationalPoints.map q).range ≤
      Subgroup.closure (⋃ i, ((rationalPoints.map (φ i)).range : Set (rationalPoints Q))))
    (hD : (rationalPoints.map d).range ≤ generatedPoints m) :
    generatedPoints m = ⊤ :=
  generatedPoints_eq_top_of_surjective d q hker m qi φ hcomm
    (fun i => QuotientPointCocycle.surjective_of_finiteSeparable_vanishing
      (di i) (qi i) (hkeri i) (hvanish i))
    hQ hD

end Vanishing

section Local

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {M D Q : GroupScheme (Spec (CommRingCat.of F))}
    (d : D ⟶ M) (q : M ⟶ Q)
    (hker : SubgroupFunctor.range d = SubgroupFunctor.range (kernelι q))
    {J : Type*} {Mi Di Qi : J → GroupScheme (Spec (CommRingCat.of F))}
    (m : ∀ i, Mi i ⟶ M) (di : ∀ i, Di i ⟶ Mi i) (qi : ∀ i, Mi i ⟶ Qi i)
    (φ : ∀ i, Qi i ⟶ Q) (hcomm : ∀ i, m i ≫ q = qi i ≫ φ i)
    (hkeri : ∀ i, SubgroupFunctor.range (di i) = SubgroupFunctor.range (kernelι (qi i)))
    [∀ i, Mono (di i).hom.hom] [∀ i, Smooth (qi i).hom.hom.left]
    [∀ i, Surjective (qi i).hom.hom.left] [∀ i, IsAffineHom (Di i).X.hom]

include hker hcomm hkeri in
/-- Over a nonarchimedean local field, local cocycle vanishing for simply connected
groups lets simply connected kernels `D_i` supply the surjectivity in the diagram chase. -/
theorem generatedPoints_eq_top_of_localCocycleVanishing
    (hloc : LocalSimplyConnectedCocycleVanishingStatement.{u})
    (hsc : ∀ i, IsSimplyConnected (Di i))
    (hQ : (rationalPoints.map q).range ≤
      Subgroup.closure (⋃ i, ((rationalPoints.map (φ i)).range : Set (rationalPoints Q))))
    (hD : (rationalPoints.map d).range ≤ generatedPoints m) :
    generatedPoints m = ⊤ :=
  generatedPoints_eq_top_of_finiteSeparable_vanishing d q hker m di qi φ hcomm hkeri
    (fun i L _ _ _ _ ξ => hloc F (Di i) (hsc i) L ξ) hQ hD

end Local

end Langlands.GroupScheme.QuotientGeneration
