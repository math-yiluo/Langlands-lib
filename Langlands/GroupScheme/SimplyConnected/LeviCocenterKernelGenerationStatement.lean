import Langlands.GroupScheme.SimplyConnected.RankOneLeviFactors

/-!
# Kernel generation of the cocenter of the minimal Levi subgroup

This module states that, in a simply connected group, the image of the rational
points of the minimal Levi subgroup in its cocenter lies in the subgroup generated
by the rational kernels of the maps to the cocenters of the standard Levi subgroups
of the simple relative roots. It proves nothing.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Kernel generation of the cocenter of the minimal Levi subgroup. Let `G` be
simply connected with maximal split torus `i`, generic cocharacter `ν`, and
`j : M ⟶ G` representing the centralizer of `ν`; let `q : M ⟶ Q` be an fppf
quotient of `M` by its derived subgroup. For each simple relative root `α` let
`ζ α` be a standard cocharacter for `{α}`, let `l α : L α ⟶ G` represent the
centralizer of `ζ α` (the standard Levi subgroup of `{α}`), `m α : M ⟶ L α` the
inclusion, `r α : L α ⟶ R α` an fppf quotient of `L α` by its derived subgroup,
and `π α : Q ⟶ R α` the induced map of cocenters. Then the image of `M(k)` in
`Q(k)` lies in the subgroup generated by the kernels of the maps `π α` on
rational points. -/
def LeviCocenterKernelGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom G.X.hom], IsSimplyConnected G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
    ∀ ν : cocharacterLattice S, IsGenericCocharacter i ν →
    ∀ (M : GroupScheme (Spec (CommRingCat.of k))) (j : M ⟶ G),
      (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy j →
    ∀ (D : GroupScheme (Spec (CommRingCat.of k))) (d : D ⟶ M), IsDerivedSubgroup d →
    ∀ (Q : GroupScheme (Spec (CommRingCat.of k))) (q : M ⟶ Q),
      RelativeRoot.IsFppfQuotient (SubgroupFunctor.range d) q →
    ∀ ζ : simpleRelativeRoots i ν → cocharacterLattice S,
      (∀ α, IsStandardCocharacter i ν {α.1} (ζ α)) →
    ∀ (L : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (l : ∀ α, L α ⟶ G),
      (∀ α, (Dynamic.centralizer (CommGroupScheme.groupHom (ζ α) ≫ i)).IsRepresentedBy (l α)) →
    ∀ m : ∀ α, M ⟶ L α, (∀ α, m α ≫ l α = j) →
    ∀ (E : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (e : ∀ α, E α ⟶ L α), (∀ α, IsDerivedSubgroup (e α)) →
    ∀ (R : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (r : ∀ α, L α ⟶ R α),
      (∀ α, RelativeRoot.IsFppfQuotient (SubgroupFunctor.range (e α)) (r α)) →
    ∀ π : ∀ α, Q ⟶ R α, (∀ α, q ≫ π α = m α ≫ r α) →
      (rationalPoints.map q).range ≤
        Subgroup.closure (⋃ α, ((rationalPoints.map (π α)).ker : Set (rationalPoints Q)))

end Langlands.GroupScheme
