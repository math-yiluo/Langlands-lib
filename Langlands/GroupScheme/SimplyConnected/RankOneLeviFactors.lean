import Langlands.GroupScheme.SimplyConnected.RankOneLeviPresentation
import Langlands.GroupScheme.Rational.ElementarySubgroupHom
import Langlands.GroupScheme.Rational.StandardParabolic
import Langlands.GroupScheme.Rational.GenericCocharacter
import Langlands.GroupScheme.Rational.MaximalSplitTorusExtension
import Langlands.GroupScheme.Torus.ExistenceProof
import Langlands.GroupScheme.SubgroupIntersection
import Langlands.GroupScheme.SubgroupFunctor.QuotientEmbedding
import Langlands.GroupScheme.Rational.FppfQuotientSmooth
import Langlands.GroupScheme.Derived.Functoriality
import Langlands.GroupScheme.Derived.CocenterQuotientProof
import Langlands.GroupScheme.Derived.RepresentabilityProof

/-!
# Rank-one Levi factors and the rank-one Levi presentation

This module splits `Langlands.GroupScheme.RankOneLeviPresentationStatement`
into three structural statements about the rank-one Levi factors of an
isotropic simply connected group, and proves the presentation from them.
It proves none of the three statements.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

section Predicate

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {S : CommGroupScheme (Spec (CommRingCat.of k))}

/-- A rank-one Levi factor for the relative root `α` of the split torus `i`:
a closed simply connected almost-simple subgroup of split rank one which
contains the root subgroup of `α`, centralizes every cocharacter of `S`
orthogonal to `α`, and is normalized by the common centralizer of these
cocharacters. -/
def IsRankOneLeviFactor (i : S.toGrp ⟶ G) (α : characterLattice S)
    {A : GroupScheme (Spec (CommRingCat.of k))} (a : A ⟶ G) : Prop :=
  IsClosedSubgroup a ∧ IsSimplyConnected A ∧ IsAlmostSimple A ∧ splitRank A = 1 ∧
    RelativeRoot.subgroup i α ≤ SubgroupFunctor.range a ∧
    (∀ ζ : cocharacterLattice S, latticePairing S α ζ = 0 →
      SubgroupFunctor.range a ≤ Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i)) ∧
    ∀ (T : Over (Spec (CommRingCat.of k))) (g x : T ⟶ G.X),
      (∀ ζ : cocharacterLattice S, latticePairing S α ζ = 0 →
        g ∈ (Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i)).carrier T) →
      x ∈ (SubgroupFunctor.range a).carrier T →
        g * x * g⁻¹ ∈ (SubgroupFunctor.range a).carrier T

end Predicate

/-- Existence of rank-one Levi factors. For a simply connected group, a
maximal split torus `i`, a generic cocharacter `ν` and a representative `j`
of the centralizer of `ν`, every simple relative root has a rank-one Levi
factor whose intersection with the centralizer is connected reductive with
simply connected derived subgroups. -/
def RankOneLeviFactorExistenceStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom G.X.hom], IsSimplyConnected G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
    ∀ ν : cocharacterLattice S, IsGenericCocharacter i ν →
    ∀ (M : GroupScheme (Spec (CommRingCat.of k))) (j : M ⟶ G),
      (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy j →
    ∀ α ∈ simpleRelativeRoots i ν,
      ∃ (A : GroupScheme (Spec (CommRingCat.of k))) (a : A ⟶ G),
        IsRankOneLeviFactor i α a ∧
        IsConnectedReductive (subgroupIntersection j a) ∧
        ∀ (D : GroupScheme (Spec (CommRingCat.of k))) (d : D ⟶ subgroupIntersection j a),
          IsDerivedSubgroup d → IsSimplyConnected D

/-- Generation of the derived subgroup of the centralizer. For an isotropic
almost-simple simply connected group, every family of rank-one Levi factors
indexed by the simple relative roots has the following property: the
rational points of the derived subgroup of the centralizer `M` of a generic
cocharacter lie in the subgroup of `M(k)` generated by the rational points of
the intersections of `M` with the factors. -/
def RankOneLeviDerivedGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom G.X.hom], IsSimplyConnected G → IsAlmostSimple G → ¬ IsAnisotropic G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
    ∀ ν : cocharacterLattice S, IsGenericCocharacter i ν →
    ∀ (M : GroupScheme (Spec (CommRingCat.of k))) (j : M ⟶ G),
      (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy j →
    ∀ (A : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (a : ∀ α, A α ⟶ G), (∀ α, IsRankOneLeviFactor i α.1 (a α)) →
    ∀ (D : GroupScheme (Spec (CommRingCat.of k))) (d : D ⟶ M), IsDerivedSubgroup d →
      (rationalPoints.map d).range ≤
        Subgroup.closure (⋃ α, ((rationalPoints.map (subgroupIntersectionFst j (a α))).range :
          Set (rationalPoints M)))

/-- Generation of the cocenter. For a simply connected group, every family of
rank-one Levi factors indexed by the simple relative roots has the following
property. Let `q : M → Q` be an fppf quotient of the centralizer `M` of a
generic cocharacter by its derived subgroup, let `q_α` be an fppf quotient of
each intersection `M_α` of `M` with a factor by its derived subgroup, and let
`φ_α` complete the squares. Then the image of `M(k)` in `Q(k)` lies in the
subgroup generated by the images of the `Q_α(k)`. -/
def RankOneLeviCocenterGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom G.X.hom], IsSimplyConnected G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
    ∀ ν : cocharacterLattice S, IsGenericCocharacter i ν →
    ∀ (M : GroupScheme (Spec (CommRingCat.of k))) (j : M ⟶ G),
      (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy j →
    ∀ (A : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (a : ∀ α, A α ⟶ G), (∀ α, IsRankOneLeviFactor i α.1 (a α)) →
    ∀ (D : GroupScheme (Spec (CommRingCat.of k))) (d : D ⟶ M), IsDerivedSubgroup d →
    ∀ (Q : GroupScheme (Spec (CommRingCat.of k))) (q : M ⟶ Q),
      RelativeRoot.IsFppfQuotient (SubgroupFunctor.range d) q →
    ∀ (Dα : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (dα : ∀ α, Dα α ⟶ subgroupIntersection j (a α)), (∀ α, IsDerivedSubgroup (dα α)) →
    ∀ (Qα : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k)))
      (qα : ∀ α, subgroupIntersection j (a α) ⟶ Qα α),
      (∀ α, RelativeRoot.IsFppfQuotient (SubgroupFunctor.range (dα α)) (qα α)) →
    ∀ φ : ∀ α, Qα α ⟶ Q, (∀ α, subgroupIntersectionFst j (a α) ≫ q = qα α ≫ φ α) →
      (rationalPoints.map q).range ≤
        Subgroup.closure (⋃ α, ((rationalPoints.map (φ α)).range : Set (rationalPoints Q)))

/-- The three structural statements about rank-one Levi factors. -/
def RankOneLeviFactorStatements : Prop :=
  RankOneLeviFactorExistenceStatement.{u} ∧ RankOneLeviDerivedGenerationStatement.{u} ∧
    RankOneLeviCocenterGenerationStatement.{u}

section Assembly

variable {k : Type u} [Field k]

/-- A closed subgroup inclusion is a monomorphism over the base. -/
theorem IsClosedSubgroup.mono_hom {H M : GroupScheme (Spec (CommRingCat.of k))} {e : H ⟶ M}
    (he : IsClosedSubgroup e) : Mono e.hom.hom := by
  have : IsClosedImmersion e.hom.hom.left := he
  exact Over.mono_of_mono_left _

/-- The kernel of a quotient of a subgroup by its derived subgroup lies in
the kernel of a quotient of the ambient group by its derived subgroup. -/
theorem range_kernelι_le_comap_of_derived {M H Q Q' D E : GroupScheme (Spec (CommRingCat.of k))}
    (m : H ⟶ M) {d : D ⟶ M} (hd : IsDerivedSubgroup d) {e : E ⟶ H} (he : IsDerivedSubgroup e)
    {q : M ⟶ Q} (hq : RelativeRoot.IsFppfQuotient (SubgroupFunctor.range d) q)
    {q' : H ⟶ Q'} (hq' : RelativeRoot.IsFppfQuotient (SubgroupFunctor.range e) q') :
    SubgroupFunctor.range (kernelι q') ≤ (SubgroupFunctor.range (kernelι q)).comap m := by
  intro T x hx
  rw [hq'.2.2.2, he.2] at hx
  rw [SubgroupFunctor.mem_comap, hq.2.2.2, hd.2]
  exact mem_derivedSubgroup_comp m hx

/-- Rank-one Levi factor existence, derived generation and cocenter generation
give the rank-one Levi presentation. -/
theorem rankOneLeviPresentation_of_rankOneLeviFactors
    (h0 : RankOneLeviFactorExistenceStatement.{u})
    (h1 : RankOneLeviDerivedGenerationStatement.{u})
    (h2 : RankOneLeviCocenterGenerationStatement.{u}) :
    RankOneLeviPresentationStatement.{u} := by
  intro k _ G _ hsc hG hiso
  have hGred := hsc.isSemisimple.isConnectedReductive
  have : Smooth G.X.hom := hGred.smooth
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  obtain ⟨S, i, hi⟩ : ∃ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i := by
    obtain ⟨T, s, hs, _⟩ := exists_maximalSplitTorus_extension G
      (TorusExistence.trivialTorusHom G)
      ⟨isSplitTorus_splitTorus PEmpty, TorusExistence.isClosedSubgroup_trivialTorusHom G⟩
    exact ⟨T, s, hs⟩
  obtain ⟨ν, hν⟩ := hi.isSplitSubtorus.1.exists_genericCocharacter i
  let χ := CommGroupScheme.groupHom ν ≫ i
  let M := Dynamic.Affine.centralizerScheme χ
  let j : M ⟶ G := Dynamic.Affine.centralizerHom χ
  have hj : (Dynamic.centralizer χ).IsRepresentedBy j :=
    Dynamic.Affine.isRepresentedBy_centralizerHom χ
  have hjc : IsClosedSubgroup j := Dynamic.Affine.isClosedSubgroup_centralizerHom χ
  have hMred : IsConnectedReductive M := dynamicCentralizerReductive k G hGred χ M j hjc hj
  have : IsAffineHom M.X.hom := hMred.isAffineHom
  have : Smooth M.X.hom := hMred.smooth
  obtain ⟨D, d, -, -, hd⟩ := derivedSubgroupRepresentability k M
  obtain ⟨Q, q, -, hq, -, -⟩ := cocenterQuotientExistence k M D d hMred hd
  let J := simpleRelativeRoots i ν
  choose A a ha hMα hDα using fun α : J => h0 k G hsc S i hi ν hν M j hj α.1 α.2
  let Mα : J → GroupScheme (Spec (CommRingCat.of k)) := fun α => subgroupIntersection j (a α)
  let m : ∀ α, Mα α ⟶ M := fun α => subgroupIntersectionFst j (a α)
  have hder : ∀ α : J, ∃ (E : GroupScheme (Spec (CommRingCat.of k))) (e : E ⟶ Mα α),
      IsDerivedSubgroup e := by
    intro α
    have : IsAffineHom (Mα α).X.hom := (hMα α).isAffineHom
    have : Smooth (Mα α).X.hom := (hMα α).smooth
    obtain ⟨E, e, -, -, he⟩ := derivedSubgroupRepresentability k (Mα α)
    exact ⟨E, e, he⟩
  choose Dα dα hdα using hder
  choose Qα qα hQα hqα _ _ using fun α : J =>
    cocenterQuotientExistence k (Mα α) (Dα α) (dα α) (hMα α) (hdα α)
  have hkernel : ∀ α : J, SubgroupFunctor.range (kernelι (qα α)) ≤
      (SubgroupFunctor.range (kernelι q)).comap (m α) := fun α =>
    range_kernelι_le_comap_of_derived (m α) hd (hdα α) hq (hqα α)
  have hflat : ∀ α : J, Flat (qα α).hom.hom.left := fun α => (hqα α).1
  have hsurj : ∀ α : J, Surjective (qα α).hom.hom.left := fun α => (hqα α).2.1
  have hqc : ∀ α : J, QuasiCompact (qα α).hom.hom.left := by
    intro α
    have : IsAffineHom (Mα α).X.hom := (hMα α).isAffineHom
    have : IsAffine (Mα α).X.left := isAffine_of_isAffineHom (Mα α).X.hom
    have : IsAffine (Qα α).X.left := hQα α
    infer_instance
  let φ : ∀ α : J, (Qα α).toGrp ⟶ Q.toGrp := fun α =>
    @SubgroupFunctor.quotientSubgroupHom _ _ _ _ _ (m α) q (qα α) (hkernel α)
      (hflat α) (hsurj α) (hqc α)
  have hsq : ∀ α : J, m α ≫ q = qα α ≫ φ α := fun α =>
    @SubgroupFunctor.quotientSubgroupHom_square _ _ _ _ _ (m α) q (qα α) (hkernel α)
      (hflat α) (hsurj α) (hqc α)
  have hDαsc : ∀ α : J, IsSimplyConnected (Dα α) := fun α => hDα α (Dα α) (dα α) (hdα α)
  refine ⟨χ, M, D, Q.toGrp, j, d, q, J, Mα, Dα, fun α => (Qα α).toGrp, A, m, dα, qα, φ, a,
    fun α => subgroupIntersectionSnd j (a α), hj, hq.2.2.2.symm,
    h1 k G hsc hG hiso S i hi ν hν M j hj A a ha D d hd,
    h2 k G hsc S i hi ν hν M j hj A a ha D d hd Q.toGrp q hq Dα dα hdα
      (fun α => (Qα α).toGrp) qα hqα φ hsq,
    hsq, fun α => (hqα α).2.2.2.symm, fun α => (hdα α).1.mono_hom, ?_,
    hsurj, fun α => (hDαsc α).isSemisimple.isConnectedReductive.isAffineHom, hDαsc,
    fun α => (subgroupIntersection_condition j (a α)).symm,
    fun α => (ha α).2.1.isSemisimple.isConnectedReductive.isAffineHom,
    fun α => (ha α).2.1, fun α => (ha α).2.2.1, fun α => (ha α).2.2.2.1, ?_⟩
  · intro α
    have := hqc α
    have hz : (SubgroupFunctor.range (dα α)).IsRepresentedBy (dα α) :=
      ⟨(hdα α).1.mono_hom, rfl⟩
    exact (hqα α).smooth_of_smooth_kernel hz (hDαsc α).isSemisimple.isConnectedReductive.smooth
  · intro α P U p r hp hr
    exact rationalPoints_range_radical_le_parabolicElementarySubgroup
      (ha α).2.1.isSemisimple.isConnectedReductive hGred (a α) p r hp hr

/-- The conjunction of the three rank-one Levi factor statements gives the
rank-one Levi presentation. -/
theorem rankOneLeviPresentation_of_rankOneLeviFactorStatements
    (h : RankOneLeviFactorStatements.{u}) : RankOneLeviPresentationStatement.{u} :=
  rankOneLeviPresentation_of_rankOneLeviFactors h.1 h.2.1 h.2.2

end Assembly

end Langlands.GroupScheme
