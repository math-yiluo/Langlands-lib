import Langlands.GroupScheme.Reductive.TitsIndex
import Langlands.GroupScheme.Reductive.AbsolutelyAlmostSimple
import Langlands.GroupScheme.SimplyConnected.Basic
import Mathlib.LinearAlgebra.Matrix.Cartan.Basic

/-! # Statement: maximal tori of type `F₄` groups lie in simply connected `D₄` subgroups -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- Every maximal torus of a simply connected absolutely almost-simple group of type `F₄`
over a field of characteristic zero lies in a closed simply connected absolutely
almost-simple subgroup whose Tits index has the Cartan matrix of type `D₄`. The subgroup
generated by the torus and the root groups of the long roots is such a subgroup
(Platonov–Rapinchuk, *Algebraic Groups and Number Theory*, §6.8, printed p. 371). -/
def TypeF4LongRootSubgroupStatement : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k]
    (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom]
    [LocallyOfFiniteType G.X.hom] (d : TitsIndexData G) (e : d.Vertex ≃ Fin 4),
    IsSimplyConnected G → IsAbsolutelyAlmostSimple G →
    (∀ a b, d.cartan a b = CartanMatrix.F₄ (e a) (e b)) →
    ∀ (T : CommGroupScheme (Spec (CommRingCat.of k))) (i : T.toGrp ⟶ G),
      IsMaximalTorus i →
      ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (j : H ⟶ G) (f : T.toGrp ⟶ H),
        IsClosedSubgroup j ∧ f ≫ j = i ∧ IsSimplyConnected H ∧
          IsAbsolutelyAlmostSimple H ∧
          ∃ (_ : IsAffineHom H.X.hom) (_ : LocallyOfFiniteType H.X.hom)
            (dH : TitsIndexData H) (eH : dH.Vertex ≃ Fin 4),
            ∀ a b, dH.cartan a b = CartanMatrix.D 4 (eH a) (eH b)

end Langlands.GroupScheme
