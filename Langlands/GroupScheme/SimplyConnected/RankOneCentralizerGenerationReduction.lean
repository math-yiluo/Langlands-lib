import Langlands.GroupScheme.SimplyConnected.RankOneCentralizerGenerationStatement
import Langlands.GroupScheme.SimplyConnected.KneserTitsCentralizerStatement
import Langlands.GroupScheme.Rational.RootGeneratedCentralizerRankOneStatement

/-!
# Rank-one centralizer generation from Kneser–Tits and root-generated rank-one generation

The rank-one generation statement for split-torus centralizers in simply connected groups
follows from the Kneser–Tits centralizer statement and the field-general statement that the
root-generated part of `Z_G(S)(k)` is generated by its rank-one pieces.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- The rank-one generation statement for split-torus centralizers in simply connected groups
follows from the field-general rank-one generation of the root-generated part of `Z_G(S)(k)`
and the Kneser–Tits centralizer statement. -/
def SimplyConnectedRankOneCentralizerGenerationReductionStatement : Prop :=
  RootGeneratedCentralizerRankOneStatement.{u} →
    SimplyConnectedKneserTitsCentralizerStatement.{u} →
    SimplyConnectedRankOneCentralizerGenerationStatement.{u}

theorem simplyConnectedRankOneCentralizerGeneration_of_kneserTits :
    SimplyConnectedRankOneCentralizerGenerationReductionStatement.{u} := by
  intro hP1 hP2 F _ _ _ _ G _ hsc S i hi Z j hj
  exact le_trans (hP2 F G hsc S i hi Z j hj)
    (sup_le_sup_right (hP1 F G hsc.isSemisimple.isConnectedReductive S i hi) _)

end Langlands.GroupScheme
