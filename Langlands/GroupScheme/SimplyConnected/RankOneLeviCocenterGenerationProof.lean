import Langlands.GroupScheme.SimplyConnected.RankOneLeviCocenterGenerationReduction
import Langlands.GroupScheme.SimplyConnected.LeviCocenterKernelGenerationProof

/-!
# Rank-one Levi factors generate the cocenter of the minimal Levi: proof
-/

universe u

namespace Langlands.GroupScheme

/-- In a simply connected group, the image of the rational points of the minimal Levi subgroup
`M` in its cocenter `Q` lies in the subgroup generated by the images of the rational points of
the cocenters of the intersections of `M` with the rank-one Levi factors. -/
theorem rankOneLeviCocenterGeneration : RankOneLeviCocenterGenerationStatement.{u} :=
  rankOneLeviCocenterGeneration_of_leviCocenterKernelGeneration leviCocenterKernelGeneration

end Langlands.GroupScheme
