import Langlands.GroupScheme.SimplyConnected.RankOneLeviDerivedGenerationReduction
import Langlands.GroupScheme.SimplyConnected.RankOneLeviFactorDichotomyProof
import Langlands.GroupScheme.Rational.SimpleRootSubgroupGenerationProof
import Langlands.GroupScheme.Rational.IsotropicRootSubgroupGenerationProof

/-!
# Rank-one Levi factors generate the derived subgroup of the minimal Levi: proof
-/

universe u

namespace Langlands.GroupScheme

/-- The rational points of the derived subgroup of the centralizer of a maximal split torus of
an isotropic almost-simple simply connected group lie in the subgroup generated by the rational
points of its intersections with the rank-one Levi factors. -/
theorem rankOneLeviDerivedGeneration : RankOneLeviDerivedGenerationStatement.{u} :=
  rankOneLeviDerivedGeneration_of_dichotomy rankOneLeviFactorDichotomy
    simpleRootSubgroupGeneration isotropicRootSubgroupGeneration

end Langlands.GroupScheme
