/-! # Proof of kernel generation for the cocenter of the minimal Levi subgroup

This module proves `LeviCocenterKernelGenerationStatement`. Over a finite Galois
field `E` splitting a maximal torus `T` containing the maximal split torus, the
characters of the cocenter `Q` of the minimal Levi subgroup have the basis of
fundamental weights of the simple roots of a face base not vanishing on the
generic cocharacter. Grouping these weights by the simple relative root to
which their roots restrict gives blocks; the characters pulled back from the
cocenter of the standard Levi subgroup of `α` are those with zero coordinates
in block `α`. Block projection then shows that every rational point of `Q` is a
product of rational points of the kernels.
-/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 1200000

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.LeviCocenterKernelGenerationProof

open LinearAlgebra.RootDatumCoweightFace LinearAlgebra.RootDatumFaceHeight

/-- Any fppf quotient of an affine group by its derived subgroup is commutative. -/
theorem isCommMonObj_cocenter {k : Type u} [Field k]
    {L D R : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom L.X.hom]
    {e : D ⟶ L} (he : IsDerivedSubgroup e)
    {r : L ⟶ R} (hr : RelativeRoot.IsFppfQuotient (SubgroupFunctor.range e) r) :
    IsCommMonObj R.X := by
  let : IsSeparated R.X.hom := fieldSeparated k R
  let : QuasiCompact r.hom.hom.left := by
    have : QuasiCompact (r.hom.hom.left ≫ R.X.hom) := by
      rw [Over.w r.hom.hom]
      infer_instance
    exact QuasiCompact.of_comp _ R.X.hom
  exact hr.isCommMonObj_of_containsCommutators he.containsCommutators

/-- Coordinates of a pulled-back complementary basis are the coordinates of the image. -/
theorem repr_pullbackComplementBasis {R L N I : Type*} [CommRing R]
    [AddCommGroup L] [Module R L] [AddCommGroup N] [Module R N]
    (b : Module.Basis I R L) (s : Set I) (f : N →ₗ[R] L) (hf : Function.Injective f)
    (hrange : LinearMap.range f = PermutationBasis.complementSpan b s)
    (x : N) (i : {i // i ∉ s}) :
    (PermutationBasis.pullbackComplementBasis b s f hf hrange).repr x i = b.repr (f x) i := by
  classical
  have h := (PermutationBasis.pullbackComplementBasis b s f hf hrange).ext
    (f₁ := Finsupp.lapply i ∘ₗ
      (PermutationBasis.pullbackComplementBasis b s f hf hrange).repr.toLinearMap)
    (f₂ := Finsupp.lapply (i : I) ∘ₗ b.repr.toLinearMap ∘ₗ f) (fun t => by
      simp [Finsupp.single_apply, Subtype.ext_iff])
  exact LinearMap.congr_fun h x

/-- **Kernel generation over a splitting field.** Let `f : S ⟶ T` factor the
maximal split torus `i` through a maximal torus `amb` of the simply connected group
`G`, with `T` split by the finite Galois extension `E`, and let `tM : T ⟶ M` be the
inclusion of `T` in the centralizer `M` of the generic cocharacter `ν`. Then every
rational point of the commutative cocenter `Q` of `M` lies in the subgroup
generated by the rational kernels of the maps `π α` to the cocenters `R α` of the
standard Levi subgroups of the simple relative roots. -/
theorem mem_closure_ker_of_splitting {k : Type u} [Field k] (E : Type u) [Field E]
    [Algebra k E] [FiniteDimensional k E] [IsGalois k E]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    [LocallyOfFiniteType G.X.hom] (hG : IsConnectedReductive G) (hsc : IsSimplyConnected G)
    {S T : CommGroupScheme (Spec (CommRingCat.of k))} (f : S ⟶ T) {amb : T.toGrp ⟶ G}
    (hamb : IsMaximalTorus amb)
    (hTE : IsSplitTorus ((CommGroupScheme.baseChange (algebraBaseMap k E)).obj T).toGrp)
    (hambE : IsMaximalTorus (T := (CommGroupScheme.baseChange (algebraBaseMap k E)).obj T)
      ((GroupScheme.baseChange (algebraBaseMap k E)).map amb))
    {i : S.toGrp ⟶ G} (hfi : CommGroupScheme.groupHom f ≫ amb = i)
    (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice S) (hν : IsGenericCocharacter i ν)
    {M D : GroupScheme (Spec (CommRingCat.of k))} (j : M ⟶ G)
    (hj : (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).IsRepresentedBy j)
    (tM : T.toGrp ⟶ M) (htM : tM ≫ j = amb)
    {d : D ⟶ M} (hd : IsDerivedSubgroup d)
    {Q : CommGroupScheme (Spec (CommRingCat.of k))} {q : M ⟶ Q.toGrp}
    (hq : RelativeRoot.IsFppfQuotient (SubgroupFunctor.range d) q)
    (ζ : simpleRelativeRoots i ν → cocharacterLattice S)
    (hζ : ∀ α, IsStandardCocharacter i ν {α.1} (ζ α))
    {L Dα : simpleRelativeRoots i ν → GroupScheme (Spec (CommRingCat.of k))}
    (l : ∀ α, L α ⟶ G)
    (hl : ∀ α,
      (Dynamic.centralizer (CommGroupScheme.groupHom (ζ α) ≫ i)).IsRepresentedBy (l α))
    (m : ∀ α, M ⟶ L α) (hm : ∀ α, m α ≫ l α = j)
    {e : ∀ α, Dα α ⟶ L α} (he : ∀ α, IsDerivedSubgroup (e α))
    {R : simpleRelativeRoots i ν → CommGroupScheme (Spec (CommRingCat.of k))}
    {r : ∀ α, L α ⟶ (R α).toGrp}
    (hr : ∀ α, RelativeRoot.IsFppfQuotient (SubgroupFunctor.range (e α)) (r α))
    (π : ∀ α, Q ⟶ R α)
    (hπ : ∀ α, q ≫ CommGroupScheme.groupHom (π α) = m α ≫ r α)
    (x : rationalPoints Q.toGrp) :
    x ∈ Subgroup.closure (⋃ α, ((rationalPoints.map (CommGroupScheme.groupHom (π α))).ker :
      Set (rationalPoints Q.toGrp))) := by
  classical
  subst hfi
  have : IsAffineHom T.toGrp.X.hom := hamb.2.1.isAffineHom
  have : LocallyOfFiniteType T.toGrp.X.hom := by
    have : IsClosedImmersion amb.hom.hom.left := hamb.2.1
    rw [← Over.w amb.hom.hom]
    infer_instance
  have : IsAffine T.toGrp.X.left := isAffine_of_isAffineHom T.toGrp.X.hom
  have hS : IsSplitTorus S.toGrp := hi.1.1
  have hf : IsLargestSplitSubtorus (CommGroupScheme.groupHom f) :=
    (IsMaximalSplitTorus.of_comp hamb.2.1 hi).isLargestSplitSubtorus
  have hGE := connectedReductiveFieldExtensionStatement k E G hG
  have hscE := isSimplyConnectedFieldExtension k E G hsc
  obtain ⟨J, _, P, hP, hred⟩ := rootDatumExistence E _ hGE _ hTE _ hambE
  have hspan := splitSimplyConnectedCorootSpan E _ hscE _ hTE _ hambE J P hP hred
  let _ : Fintype J := Fintype.ofFinite J
  have := hred
  obtain ⟨ν', hν'⟩ : ∃ ν', cocharacterLattice.baseChange (algebraBaseMap k E) T (ν ≫ f) = ν' :=
    ⟨_, rfl⟩
  let C := coweightFace P ν'
  choose a ha using fun β : J =>
    (hS.characterLattice_baseChange_bijective (algebraBaseMap k E) S).surjective
      ((CommGroupScheme.baseChange (algebraBaseMap k E)).map f ≫ P.root β)
  have hjQ :
      (Dynamic.centralizer (CommGroupScheme.groupHom (ν ≫ f) ≫ amb)).IsRepresentedBy j := by
    rw [show CommGroupScheme.groupHom (ν ≫ f) =
      CommGroupScheme.groupHom ν ≫ CommGroupScheme.groupHom f from rfl, Category.assoc]
    exact hj
  have hlQ (α) : (Dynamic.centralizer
      (CommGroupScheme.groupHom (ζ α ≫ f) ≫ amb)).IsRepresentedBy (l α) := by
    rw [show CommGroupScheme.groupHom (ζ α ≫ f) =
      CommGroupScheme.groupHom (ζ α) ≫ CommGroupScheme.groupHom f from rfl, Category.assoc]
    exact hl α
  have hcQ := DynamicCentralizerCocenterComparison.comparison E hG hamb hTE hP (ν ≫ f) j hjQ
    tM htM d hd q hq
  rw [hν'] at hcQ
  have hcR (α) := DynamicCentralizerCocenterComparison.comparison E hG hamb hTE hP (ζ α ≫ f)
    (l α) (hlQ α) (tM ≫ m α) (by rw [Category.assoc, hm α, htM]) (e α) (he α) (r α) (hr α)
  let g := characterLattice.baseChangePullback k E (Additive.ofMul (tM ≫ q) : T ⟶ Q)
  let s : Set C.base.support := {t | P.root' t ν' = 0}
  have hrange : LinearMap.range g = PermutationBasis.complementSpan
      (Langlands.RootDatum.fundamentalWeightBasis P C.base hspan) s := by
    ext χ
    refine (hcQ.2.2 χ).trans ?_
    rw [Langlands.RootDatum.mem_fundamentalWeight_complement_iff, C.annihilator_iff]
    constructor
    · intro h t ht
      exact h t.1 t.2 ht
    · intro h t ht hz
      exact h ⟨t, ht⟩ hz
  let bQ := PermutationBasis.pullbackComplementBasis
    (Langlands.RootDatum.fundamentalWeightBasis P C.base hspan) s g hcQ.2.1 hrange
  have hrepr (y) (t : {t // t ∉ s}) :
      bQ.repr y t = P.toLinearMap (g y) (P.coroot t.1.1) :=
    (repr_pullbackComplementBasis _ s g hcQ.2.1 hrange y t).trans
      (Langlands.RootDatum.fundamentalWeightBasis_repr P C.base hspan (g y) t.1)
  let θ : {t // t ∉ s} → simpleRelativeRoots (CommGroupScheme.groupHom f ≫ amb) ν := fun t =>
    ⟨a t.1.1, FaceSimpleRootRestriction.restrict_mem_simpleRelativeRoots k E f amb hTE
      hambE.2.1 hP ν hS hf hν' C t.1.2 t.2 (ha t.1.1).symm⟩
  have hcomp (α) : (Additive.ofMul (tM ≫ q) : T ⟶ Q) ≫ π α =
      Additive.ofMul ((tM ≫ m α) ≫ r α) := by
    change Additive.ofMul ((tM ≫ q) ≫ CommGroupScheme.groupHom (π α)) = _
    rw [Category.assoc, hπ α, Category.assoc]
  have hgπ (α) : g ∘ₗ characterLattice.baseChangePullback k E (π α) =
      characterLattice.baseChangePullback k E
        (Additive.ofMul ((tM ≫ m α) ≫ r α) : T ⟶ R α) := by
    rw [← hcomp α]
    refine LinearMap.ext fun y => ?_
    change (CommGroupScheme.baseChange (algebraBaseMap k E)).map _ ≫
        ((CommGroupScheme.baseChange (algebraBaseMap k E)).map (π α) ≫ y) =
      (CommGroupScheme.baseChange (algebraBaseMap k E)).map (_ ≫ π α) ≫ y
    rw [CategoryTheory.Functor.map_comp, Category.assoc]
    rfl
  have hblock (α) (y) : y ∈ LinearMap.range (characterLattice.baseChangePullback k E (π α)) ↔
      ∀ t, θ t = α → bQ.repr y t = 0 := by
    have L1 := fun β (hβ : β ∈ C.base.support) =>
      FaceSimpleRootRestriction.root'_standard k E f amb hTE hambE.2.1 hP ν hS hf hν hν' C hβ
        (ha β).symm (hζ α)
    rw [mem_range_iff_of_dominant (fun β hβ => (L1 β hβ).1) ν' g hcQ.2.1 hcQ.2.2
      (characterLattice.baseChangePullback k E (π α)) (by rw [hgπ α]; exact (hcR α).2.2) y]
    constructor
    · intro h t hθ
      rw [hrepr]
      exact h t.1.1 t.1.2 t.2 ((L1 t.1.1 t.1.2).2.mpr (Or.inr (congrArg Subtype.val hθ)))
    · intro h β hβ hne hz
      have haβ := ((L1 β hβ).2.mp hz).resolve_left hne
      have h' := h ⟨⟨β, hβ⟩, hne⟩ (Subtype.ext haβ)
      rwa [hrepr] at h'
  exact CharacterBlockKernelGeneration.mem_closure_ker k E π bQ θ hcQ.1 (fun α => (hcR α).1)
    hblock x

end Langlands.GroupScheme.LeviCocenterKernelGenerationProof

namespace Langlands.GroupScheme

open LeviCocenterKernelGenerationProof

/-- **Kernel generation for the cocenter of the minimal Levi subgroup.** -/
theorem leviCocenterKernelGeneration : LeviCocenterKernelGenerationStatement.{u} := by
  intro k _ G _ hsc S i hi ν hν M j hj D d hd Q q hq ζ hζ L l hl m hm Eα e he R r hr π hπ
  have hG : IsConnectedReductive G := hsc.isSemisimple.isConnectedReductive
  have : Smooth G.X.hom := hG.smooth
  have hjc := DynamicCentralizerCocenterComparison.isClosedSubgroup i ν j hj
  have hM : IsConnectedReductive M := dynamicCentralizerReductive k G hG _ M j hjc hj
  have : Smooth M.X.hom := hM.smooth
  have : IsAffineHom M.X.hom := hM.isAffineHom
  have hjt : (torusCentralizer i).IsRepresentedBy j := by
    rw [← genericCentralizer k G hG S i hi ν hν]
    exact hj
  let Qc : CommGroupScheme (Spec (CommRingCat.of k)) :=
    { toGrp := Q, comm := isCommMonObj_cocenter hd hq }
  let Rc : simpleRelativeRoots i ν → CommGroupScheme (Spec (CommRingCat.of k)) := fun α =>
    haveI : IsAffineHom (L α).X.hom :=
      (DynamicCentralizerCocenterComparison.isClosedSubgroup i (ζ α) (l α) (hl α)).isAffineHom
    { toGrp := R α, comm := isCommMonObj_cocenter (he α) (hr α) }
  let C := torusCentralizerFiniteGaloisModel (Q := Qc) maximalTorusBaseChange hi.1 hjt
    (suppliedCocenterTorus k M D d hM hd Qc q hq)
  rintro _ ⟨y, rfl⟩
  exact mem_closure_ker_of_splitting C.splitting.carrier hG hsc C.rational.factor
    C.rational.ambient_maximal C.splitting.split_left C.ambient_maximal C.rational.factor_comp
    hi ν hν j hj C.rational.centralizer C.rational.centralizer_comp hd (Q := Qc) hq ζ hζ l hl m hm
    he (R := Rc) hr (fun α => Additive.ofMul (π α)) hπ _

end Langlands.GroupScheme
