import Langlands.GroupScheme.SimplyConnected.Basic
import Langlands.GroupScheme.Reductive.AlmostSimple

/-!
# Rational generation of simply connected groups by almost-simple factors

The rational points of a simply connected group over a field are generated by the rational
points of its closed normal almost-simple subgroups.
This module states a proposition and supplies no proof of it.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Over any field `k`, a subgroup of `G(k)`, for a simply connected `G`, that contains the
image of `A(k)` for every closed normal almost-simple subgroup `a : A ⟶ G` is all of
`G(k)`. -/
def SimplyConnectedAlmostSimpleRationalGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k))), IsSimplyConnected G →
    ∀ H : Subgroup (rationalPoints G),
      (∀ (A : GroupScheme (Spec (CommRingCat.of k))) (a : A ⟶ G),
        IsAlmostSimple A → IsClosedSubgroup a → (SubgroupFunctor.range a).IsNormal →
        (rationalPoints.map a).range ≤ H) →
      H = ⊤

end Langlands.GroupScheme
