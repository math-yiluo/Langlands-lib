import Langlands.GroupScheme.SimplyConnected.LocalRankOneKneserTitsStatement
import Langlands.GroupScheme.SimplyConnected.RankOneLeviFactors
import Langlands.GroupScheme.SimplyConnected.AlmostSimpleWeilRestrictionStatement
import Langlands.GroupScheme.Rational.AffineWeilSplitRankStatement
import Langlands.GroupScheme.Rational.AffineWeilParabolicElementaryStatement
import Langlands.GroupScheme.Rational.ParabolicWhiteheadIsomorphism
import Langlands.GroupScheme.Rational.SplitRankTransport
import Langlands.LocalField.FiniteExtension

/-!
# Reduction of rank-one local Kneser–Tits to absolutely almost-simple groups

This module states local Kneser–Tits for absolutely almost-simple simply
connected groups of split rank one over nonarchimedean local fields, and
proves that it implies `LocalRankOneKneserTitsStatement`, using the Weil
restriction structure of almost-simple simply connected groups and the
transfer of split rank and parabolic radicals under affine Weil
restriction (Prasad–Raghunathan 1985, §2). It also derives
`LocalKneserTitsStatement` from all the open inputs of the published route.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Over any nonarchimedean local field, the rational points of an
absolutely almost-simple simply connected group of split rank one are
generated by the rational points of the unipotent radicals of its rational
parabolic subgroups. This is a statement only. -/
def LocalAbsolutelyAlmostSimpleRankOneKneserTitsStatement : Prop :=
  ∀ (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    (G : GroupScheme (Spec (CommRingCat.of K))) [IsAffineHom G.X.hom],
    IsSimplyConnected G → IsAbsolutelyAlmostSimple G → splitRank G = 1 →
      parabolicElementarySubgroup G = ⊤

/-- The Weil restriction structure of almost-simple simply connected groups,
the transfer of split rank and of parabolic radicals under affine Weil
restriction, and local Kneser–Tits for absolutely almost-simple groups of
split rank one give local Kneser–Tits for almost-simple groups of split
rank one. -/
theorem localRankOneKneserTits_of_absolutelyAlmostSimple
    (hW : SimplyConnectedAlmostSimpleWeilRestrictionStatement.{u})
    (hrank : AffineWeilSplitRankStatement.{u})
    (hpar : AffineWeilParabolicElementarySubgroupStatement.{u})
    (habs : LocalAbsolutelyAlmostSimpleRankOneKneserTitsStatement.{u}) :
    LocalRankOneKneserTitsStatement.{u} := by
  intro F _ _ _ _ G _ hsc has h1
  rw [← parabolicElementarySubgroup_eq_top_iff G]
  obtain ⟨K, _, _, _, _, G', _, _, hsc', habs', ⟨e⟩⟩ := hW F G hsc has
  have hred : IsConnectedReductive G' := hsc'.isSemisimple.isConnectedReductive
  have hrankG' : splitRank G' = 1 := by
    rw [← hrank F K G' hred, ← splitRank_eq_of_iso e, h1]
  let := LocalField.FiniteExtension.normedField F K
  let := LocalField.FiniteExtension.valuativeRel F K
  let := LocalField.FiniteExtension.isLocalField F K
  have : IsAffineHom G'.X.hom := isAffineHom_of_isAffine _
  have htop' : parabolicElementarySubgroup G' = ⊤ := habs K G' hsc' habs' hrankG'
  have htopW : parabolicElementarySubgroup (AffineWeil.groupScheme F K G') = ⊤ := by
    let φ := AffineWeil.rationalPointsEquiv F K G'
    apply Subgroup.map_injective (f := φ.toMonoidHom) φ.injective
    rw [Subgroup.map_top_of_surjective φ.toMonoidHom φ.surjective]
    exact (hpar F K G' hred).trans htop'
  exact (parabolicElementarySubgroup_eq_top_iff_iso e).mpr htopW

/-- Local Kneser–Tits from the open inputs of the published route: the
rank-one Levi factor statements, local cocycle vanishing, the three Weil
restriction statements and local Kneser–Tits for absolutely almost-simple
groups of split rank one. -/
theorem localKneserTits_of_rankOneLeviFactors_of_absolutelyAlmostSimple
    (hfac : RankOneLeviFactorStatements.{u})
    (hloc : LocalSimplyConnectedCocycleVanishingStatement.{u})
    (hW : SimplyConnectedAlmostSimpleWeilRestrictionStatement.{u})
    (hrank : AffineWeilSplitRankStatement.{u})
    (hpar : AffineWeilParabolicElementarySubgroupStatement.{u})
    (habs : LocalAbsolutelyAlmostSimpleRankOneKneserTitsStatement.{u}) :
    LocalKneserTitsStatement.{u} :=
  localKneserTits_of_rankOne_of_reduction
    (localRankOneKneserTits_of_absolutelyAlmostSimple hW hrank hpar habs)
    (localKneserTitsRankOneReduction_of_rankOneLeviPresentation hloc
      (rankOneLeviPresentation_of_rankOneLeviFactorStatements hfac))

end Langlands.GroupScheme
