import Langlands.GroupScheme.SimplyConnected.LocalKneserTitsRankOneReduction
import Langlands.GroupScheme.SimplyConnected.LocalQuotientGeneration
import Langlands.GroupScheme.Rational.CentralizerElementaryProduct

/-!
# Rank-one Levi presentations and the reduction to split rank one

This module states, over every field, the structure of the minimal Levi
subgroup of an isotropic simply connected `k`-simple group that
Prasad–Raghunathan use to prove their Theorem A (§1.3–1.6 of their 1985
paper). It proves that this structure statement and local vanishing of
cocycles of simply connected groups imply
`Langlands.GroupScheme.LocalKneserTitsRankOneReductionStatement`. It proves
neither the structure statement nor the cocycle vanishing.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Over every field, an isotropic almost-simple simply connected group `G` has
a cocharacter `χ` whose centralizer `M = Z_G(χ)`, represented by `j`, carries
the following data. A represented kernel `d : D ⟶ M` of `q : M ⟶ Q`, and for
each index `i` a group `M_i ⟶ M` with a represented simply connected kernel
`D_i ⟶ M_i` of a smooth surjective `q_i : M_i ⟶ Q_i` and a map
`φ_i : Q_i ⟶ Q` with `m_i ≫ q = q_i ≫ φ_i`. The rational points of `D` lie in
the subgroup generated by the images of the `M_i(k)`, and the image of `M(k)`
in `Q(k)` lies in the subgroup generated by the images of the `Q_i(k)`. Each
`M_i ⟶ M ⟶ G` factors through a simply connected almost-simple group `A_i` of
split rank one, mapping to `G`, whose parabolic-radical images lie in the
parabolic elementary subgroup of `G`. -/
def RankOneLeviPresentationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [IsAffineHom G.X.hom],
    IsSimplyConnected G → IsAlmostSimple G → ¬ IsAnisotropic G →
    ∃ (χ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ G)
      (M D Q : GroupScheme (Spec (CommRingCat.of k)))
      (j : M ⟶ G) (d : D ⟶ M) (q : M ⟶ Q)
      (J : Type u) (Mi Di Qi A : J → GroupScheme (Spec (CommRingCat.of k)))
      (m : ∀ i, Mi i ⟶ M) (di : ∀ i, Di i ⟶ Mi i) (qi : ∀ i, Mi i ⟶ Qi i)
      (φ : ∀ i, Qi i ⟶ Q) (a : ∀ i, A i ⟶ G) (e : ∀ i, Mi i ⟶ A i),
      (Dynamic.centralizer χ).IsRepresentedBy j ∧
      SubgroupFunctor.range d = SubgroupFunctor.range (kernelι q) ∧
      (rationalPoints.map d).range ≤
        Subgroup.closure (⋃ i, ((rationalPoints.map (m i)).range : Set (rationalPoints M))) ∧
      (rationalPoints.map q).range ≤
        Subgroup.closure (⋃ i, ((rationalPoints.map (φ i)).range : Set (rationalPoints Q))) ∧
      (∀ i, m i ≫ q = qi i ≫ φ i) ∧
      (∀ i, SubgroupFunctor.range (di i) = SubgroupFunctor.range (kernelι (qi i))) ∧
      (∀ i, Mono (di i).hom.hom) ∧
      (∀ i, Smooth (qi i).hom.hom.left) ∧
      (∀ i, Surjective (qi i).hom.hom.left) ∧
      (∀ i, IsAffineHom (Di i).X.hom) ∧
      (∀ i, IsSimplyConnected (Di i)) ∧
      (∀ i, e i ≫ a i = m i ≫ j) ∧
      (∀ i, IsAffineHom (A i).X.hom) ∧
      (∀ i, IsSimplyConnected (A i)) ∧
      (∀ i, IsAlmostSimple (A i)) ∧
      (∀ i, splitRank (A i) = 1) ∧
      (∀ i (P U : GroupScheme (Spec (CommRingCat.of k))) (p : P ⟶ A i) (r : U ⟶ P),
        IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
        (rationalPoints.map (r ≫ p ≫ a i)).range ≤ parabolicElementarySubgroup G)

/-- Local cocycle vanishing for simply connected groups and rank-one Levi
presentations give the reduction of local Kneser–Tits to split rank one. -/
theorem localKneserTitsRankOneReduction_of_rankOneLeviPresentation
    (hloc : LocalSimplyConnectedCocycleVanishingStatement.{u})
    (hpres : RankOneLeviPresentationStatement.{u}) :
    LocalKneserTitsRankOneReductionStatement.{u} := by
  intro F _ _ _ _ G _ hsc hG hiso N hN hrad habs
  obtain ⟨χ, M, D, Q, j, d, q, J, Mi, Di, Qi, A, m, di, qi, φ, a, e, hj, hker, hD, hQ,
    hcomm, hkeri, hmono, hsmooth, hsurj, haff, hsci, hfac, haffA, hscA, hA, hA1, hradA⟩ :=
    hpres F G hsc hG hiso
  have hE : parabolicElementarySubgroup G ≤ N :=
    (parabolicElementarySubgroup_le_iff N).mpr hrad
  have htop : QuotientGeneration.generatedPoints m = ⊤ := by
    have := hmono
    have := hsmooth
    have := hsurj
    have := haff
    exact QuotientGeneration.generatedPoints_eq_top_of_localCocycleVanishing d q hker m di qi
      φ hcomm hkeri hloc hsci hQ hD
  have hAN : ∀ i, (rationalPoints.map (a i)).range ≤ N := by
    intro i
    have := haffA i
    exact habs (A i) (a i) (hscA i) (hA i) (hA1 i)
      (fun P U p r hp hr => (hradA i P U p r hp hr).trans hE)
  have hgen : QuotientGeneration.generatedPoints m ≤ N.comap (rationalPoints.map j) := by
    rw [Subgroup.closure_le]
    intro y hy
    obtain ⟨i, w, rfl⟩ := Set.mem_iUnion.mp hy
    have hw : rationalPoints.map j (rationalPoints.map (m i) w) =
        rationalPoints.map (a i) (rationalPoints.map (e i) w) := by
      have h := congrArg (fun f : Mi i ⟶ G => w ≫ f.hom.hom) (hfac i)
      simpa [rationalPoints.map_apply] using h.symm
    change rationalPoints.map j (rationalPoints.map (m i) w) ∈ N
    rw [hw]
    exact hAN i ⟨_, rfl⟩
  have hM : (rationalPoints.map j).range ≤ N := by
    rintro _ ⟨x, rfl⟩
    have hx : x ∈ QuotientGeneration.generatedPoints m := by
      rw [htop]
      trivial
    exact hgen hx
  have hR1 := centralizer_rationalPoints_sup_parabolicElementarySubgroup_of_localField F
    hsc.isSemisimple.isConnectedReductive χ
  rw [SubgroupFunctor.rationalPoints_eq_range hj] at hR1
  rw [eq_top_iff, ← hR1]
  exact sup_le hM hE

end Langlands.GroupScheme
