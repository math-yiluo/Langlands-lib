import Langlands.GroupScheme.SimplyConnected.OuterTypeAUnitarySplitCoordinates
import Langlands.GroupScheme.Examples.HermitianHyperbolicSplitRankLower

/-! # Gram entries pair opposite actual split-torus weights -/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.TypeAHermitianTorusCoordinates

open Matrix LaurentPolynomial SpecialLinearTitsCocycle OuterTypeAHermitian

variable {K L : Type u} [Field K] [Field L] [Algebra K L]
  [Algebra.IsQuadraticExtension K L] [Algebra.IsSeparable K L]
  {G : GroupScheme (Spec (CommRingCat.of K))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
  {d : TitsIndexData G} {n : ℕ} {e : d.Vertex ≃ Fin n}
  (p : TypeAHermitianTorusCoordinates L d e)

/-- A Gram entry can be nonzero only between opposite integer weights of any
actual split-torus cocharacter. -/
theorem gram_eq_zero_of_weight_sum_ne (ν : cocharacterLattice d.splitTorus)
    (i j : Fin (n + 1))
    (hij : latticePairing d.splitTorus (p.weights i) ν +
      latticePairing d.splitTorus (p.weights j) ν ≠ 0) : p.form.gram i j = 0 := by
  classical
  let Z := GeneralLinear.laurentScheme (algebraBaseMap K L)
  let a : Z ⟶ cover K L := laurentCoverPoint
  let s : Z ⟶ d.splitTorus.X := genericTorusPoint d.splitTorus ν
  let u : Fin (n + 1) → Γ(Z.left, ⊤) := fun k =>
    (Gm.pointsEquiv _ Z (s ≫ (CommGroupScheme.groupHom (p.weights k)).hom.hom) :
      Γ(Z.left, ⊤)ˣ)
  let D : Matrix (Fin (n + 1)) (Fin (n + 1)) (SpecialLinear.WeilRoot.tensorAlgebra K L Z) :=
    Matrix.diagonal fun k => scalarSections L Z (u k)
  let g := p.presentation.pointsEquiv Z (s ≫ d.splitInclusion.hom.hom)
  have hg : (g.1 : Matrix (Fin (n + 1)) (Fin (n + 1))
      (SpecialLinear.WeilRoot.tensorAlgebra K L Z)) = D := p.torus_coordinates Z s
  have hpres := (Subgroup.mem_inf.mp g.property).1
  change HermitianMatrix.Preserves (HermitianMatrix.SchemeModel.tensorForm K L p.form Z)
    (g.1 : Matrix (Fin (n + 1)) (Fin (n + 1))
      (SpecialLinear.WeilRoot.tensorAlgebra K L Z)) at hpres
  unfold HermitianMatrix.Preserves at hpres
  rw [hg] at hpres
  have hadj : HermitianMatrix.adjoint (SU3Root.SchemeModel.coefficientInvolution K L Z)
      D = D := by
    dsimp only [D]
    rw [HermitianMatrix.adjoint, Matrix.diagonal_map (map_zero _), Matrix.diagonal_transpose]
    congr 1
    funext k
    exact scalarSections_bar Z _
  rw [hadj] at hpres
  have hentry := congrArg (fun A => A i j) hpres
  simp only [D, Matrix.mul_diagonal, Matrix.diagonal_mul,
    HermitianMatrix.SchemeModel.tensorForm_gram, Matrix.map_apply] at hentry
  have h := congrArg (fun z => (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).hom
    (firstCoord L a z)) hentry
  simp only [map_mul, firstCoord_scalarSections, firstCoord_algebraMap,
    Algebra.algebraMap_self_apply] at h
  dsimp only [u, s, a, Z] at h
  rw [coefficients_laurentCoverPoint (K := K) (L := L),
    genericTorusPoint_weight (K := K) (L := L) d.splitTorus ν (p.weights i),
    genericTorusPoint_weight (K := K) (L := L) d.splitTorus ν (p.weights j)] at h
  by_contra hnonzero
  have hs : (AddMonoidAlgebra.single
      (latticePairing d.splitTorus (p.weights i) ν +
        latticePairing d.splitTorus (p.weights j) ν) (p.form.gram i j) : LaurentPolynomial L) =
      AddMonoidAlgebra.single 0 (p.form.gram i j) := by
    rw [single_eq_C_mul_T, single_eq_C_mul_T, T_zero, mul_one, T_add]
    calc _ = T (latticePairing d.splitTorus (p.weights i) ν) *
        C (p.form.gram i j) * T (latticePairing d.splitTorus (p.weights j) ν) := by ring
      _ = _ := h
  exact hij ((AddMonoidAlgebra.single_left_inj hnonzero).mp hs)

/-- The linear map inserting two coordinates at the supplied positions. -/
def coordinatePairMap (i j : Fin (n + 1)) :
    (Fin 2 → L) →ₗ[L] (Fin (n + 1) → L) :=
  (LinearMap.single L (fun _ : Fin (n + 1) => L) i).comp (LinearMap.proj 0) +
    (LinearMap.single L (fun _ : Fin (n + 1) => L) j).comp (LinearMap.proj 1)

/-- The actual coordinate subspace generated by two supplied coordinate vectors. -/
def coordinatePairSubspace (i j : Fin (n + 1)) :
    Submodule L (Fin (n + 1) → L) :=
  (coordinatePairMap (L := L) i j).range

/-- Distinct positions give a two-dimensional coordinate subspace. -/
theorem finrank_coordinatePairSubspace (i j : Fin (n + 1)) (hij : i ≠ j) :
    Module.finrank L (coordinatePairSubspace (L := L) i j) = 2 := by
  have hinj : Function.Injective (coordinatePairMap (L := L) i j) := by
    intro x y h
    have h0 : x 0 = y 0 := by
      simpa [coordinatePairMap, hij, hij.symm] using congrFun h i
    have h1 : x 1 = y 1 := by
      simpa [coordinatePairMap, hij, hij.symm] using congrFun h j
    ext k
    fin_cases k <;> assumption
  simpa [coordinatePairSubspace] using LinearMap.finrank_range_of_inj hinj

private theorem pairing_single (i j : Fin (n + 1)) (a b : L) :
    p.form.pairing (Pi.single i a) (Pi.single j b) =
      (SU3Root.fieldInvolution K L).bar a * p.form.gram i j * b := by
  simp [HermitianMatrix.Form.pairing, Pi.single_apply, apply_ite]

/-- A zero Gram block gives a genuinely totally isotropic coordinate plane. -/
theorem totallyIsotropic_coordinatePairSubspace (i j : Fin (n + 1))
    (hii : p.form.gram i i = 0) (hij : p.form.gram i j = 0)
    (hji : p.form.gram j i = 0) (hjj : p.form.gram j j = 0) :
    p.form.IsTotallyIsotropic (coordinatePairSubspace (L := L) i j) := by
  rintro x ⟨v, rfl⟩ y ⟨w, rfl⟩
  change p.form.pairing (Pi.single i (v 0) + Pi.single j (v 1))
    (Pi.single i (w 0) + Pi.single j (w 1)) = 0
  simp only [HermitianMatrix.Form.pairing_add_left,
    HermitianMatrix.Form.pairing_add_right, p.pairing_single,
    hii, hij, hji, hjj, mul_zero, zero_mul, add_zero]

/-- Two distinct positive coordinates force split rank at least two. -/
theorem two_le_splitRank_of_positive_pair (ν : cocharacterLattice d.splitTorus)
    (i j : Fin (n + 1)) (hij : i ≠ j)
    (hi : 0 < latticePairing d.splitTorus (p.weights i) ν)
    (hj : 0 < latticePairing d.splitTorus (p.weights j) ν) :
    (2 : ℕ∞) ≤ splitRank G := by
  have hii := p.gram_eq_zero_of_weight_sum_ne ν i i (by omega)
  have hij' := p.gram_eq_zero_of_weight_sum_ne ν i j (by omega)
  have hji := p.gram_eq_zero_of_weight_sum_ne ν j i (by omega)
  have hjj := p.gram_eq_zero_of_weight_sum_ne ν j j (by omega)
  have hbound := p.presentation.finrank_le_splitRank
    (coordinatePairSubspace (L := L) i j)
    (p.totallyIsotropic_coordinatePairSubspace i j hii hij' hji hjj)
  simpa [finrank_coordinatePairSubspace i j hij] using hbound

end Langlands.GroupScheme.TypeAHermitianTorusCoordinates
