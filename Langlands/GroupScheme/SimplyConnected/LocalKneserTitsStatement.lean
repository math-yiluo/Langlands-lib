import Langlands.GroupScheme.SimplyConnected.Basic
import Langlands.GroupScheme.Reductive.AlmostSimple
import Langlands.GroupScheme.Rational.Characters
import Langlands.GroupScheme.Rational.LeviSubgroup
import Mathlib.NumberTheory.LocalField.Basic

/-!
# Local Kneser–Tits in terms of rational parabolic radicals

This module states the local Kneser–Tits theorem for isotropic almost-simple
simply connected groups, using the universal property of the normal subgroup
generated by the rational points of the unipotent radicals of rational
parabolic subgroups. It supplies no proof.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Over any nonarchimedean local field, a normal subgroup of the rational
points of an isotropic almost-simple simply connected group which contains
the rational unipotent radicals of all rational parabolic subgroups is the
whole group. The radical is the represented geometric unipotent radical,
and the field characteristic and universe are unrestricted. -/
def LocalKneserTitsStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom],
    IsSimplyConnected G → IsAlmostSimple G → ¬ IsAnisotropic G →
    ∀ (N : Subgroup (rationalPoints G)), N.Normal →
      (∀ (P U : GroupScheme (Spec (CommRingCat.of F))) (p : P ⟶ G) (r : U ⟶ P),
        IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical r →
        (rationalPoints.map (r ≫ p)).range ≤ N) →
      N = ⊤

end Langlands.GroupScheme
