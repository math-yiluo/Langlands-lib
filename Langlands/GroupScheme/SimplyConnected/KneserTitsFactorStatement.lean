import Langlands.GroupScheme.SimplyConnected.Basic
import Langlands.GroupScheme.Reductive.AlmostSimple
import Langlands.GroupScheme.Rational.RootSubgroup
import Mathlib.NumberTheory.LocalField.Basic

/-!
# Kneser–Tits for the isotropic almost-simple factors of a simply connected group

Over a nonarchimedean local field, the rational points of an isotropic closed normal
almost-simple subgroup of a simply connected group lie in the subgroup generated by the root
groups of a maximal split torus.
This module states a proposition and supplies no proof of it.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- For a simply connected group `G` over a nonarchimedean local field with maximal split
torus `S`, the image of `A(F)` for every isotropic closed normal almost-simple subgroup
`a : A ⟶ G` lies in the subgroup `G(F)^+` generated by the root groups `U_α(F)` of all
relative roots `α`. -/
def SimplyConnectedKneserTitsFactorStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom], IsSimplyConnected G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
    ∀ (A : GroupScheme (Spec (CommRingCat.of F))) (a : A ⟶ G),
      IsAlmostSimple A → IsClosedSubgroup a → (SubgroupFunctor.range a).IsNormal →
      ¬ IsAnisotropic A →
      (rationalPoints.map a).range ≤
        Subgroup.closure (⋃ α ∈ relativeRoots i,
          ((RelativeRoot.subgroup i α).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G)))

end Langlands.GroupScheme
