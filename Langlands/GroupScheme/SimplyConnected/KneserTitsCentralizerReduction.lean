import Langlands.GroupScheme.SimplyConnected.KneserTitsCentralizerStatement
import Langlands.GroupScheme.SimplyConnected.AlmostSimpleRationalGenerationStatement
import Langlands.GroupScheme.SimplyConnected.KneserTitsFactorStatement
import Langlands.GroupScheme.SimplyConnected.AnisotropicFactorCentralizerStatement
import Langlands.GroupScheme.Rational.AnisotropicCentralizerNormKernel
import Langlands.GroupScheme.Rational.ParabolicPointConjugation
import Langlands.GroupScheme.Dynamic.ParabolicLieCriterion
import Langlands.Representation.Plancherel.RationalUnramifiedRestriction

/-!
# Kneser–Tits for split-torus centralizers from the almost-simple factors

Kneser–Tits for the centralizer of a maximal split torus in a simply connected group follows
from three statements about its closed normal almost-simple subgroups: they generate the
rational points, the isotropic ones have rational points generated by root groups, and the
anisotropic ones centralize the maximal split torus.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Kneser–Tits for split-torus centralizers follows from rational generation by the
almost-simple factors, Kneser–Tits for the isotropic factors, and centralization of the
maximal split torus by the anisotropic factors. -/
def SimplyConnectedKneserTitsCentralizerReductionStatement : Prop :=
  SimplyConnectedAlmostSimpleRationalGenerationStatement.{u} →
    SimplyConnectedKneserTitsFactorStatement.{u} →
    SimplyConnectedAnisotropicFactorCentralizerStatement.{u} →
    SimplyConnectedKneserTitsCentralizerStatement.{u}

theorem simplyConnectedKneserTitsCentralizer_of_factors :
    SimplyConnectedKneserTitsCentralizerReductionStatement.{u} := by
  intro hA hB hC F _ _ _ _ G _ hG S i hi Z j hj
  -- The isotropic closed normal almost-simple subgroups of `G`.
  let Idx := {p : Σ A : GroupScheme (Spec (CommRingCat.of F)), A ⟶ G //
    IsAlmostSimple p.1 ∧ IsClosedSubgroup p.2 ∧ (SubgroupFunctor.range p.2).IsNormal ∧
      ¬ IsAnisotropic p.1}
  let R : Idx → Subgroup (rationalPoints G) := fun p => (rationalPoints.map p.1.2).range
  have hR : ∀ p, (R p).Normal := fun p =>
    ⟨fun x hx g => p.2.2.2.1 _ g x (Subgroup.mem_top g) hx⟩
  let K : Subgroup (rationalPoints G) := ⨆ p, R p
  have hK : K.Normal := Subgroup.iSup_normal R
  let N : Subgroup (rationalPoints G) :=
    (Plancherel.rationalCommonNormKernel Z).map (rationalPoints.map j)
  have hrange : (rationalPoints.map j).range = centralizerPoints i := by
    rw [← SubgroupFunctor.rationalPoints_eq_range hj]
    exact torusCentralizer_carrier_base i
  -- Every factor lies in `K ⊔ N`; anisotropic factors land in the norm kernel of `Z`.
  have hKN : K ⊔ N = ⊤ := by
    refine hA F G hG (K ⊔ N) fun A a hAs ha hn => ?_
    by_cases hAn : IsAnisotropic A
    · refine le_sup_of_le_right ?_
      have hle := hC F G hG S i hi A a hAs ha hn hAn
      let f : A ⟶ Z := hj.liftOfLE a hle
      have hf : f ≫ j = a := hj.liftOfLE_comp a hle
      have htop := hAn.rationalCommonNormKernel_eq_top hAs.isSemisimple.isConnectedReductive
      rintro _ ⟨y, rfl⟩
      refine ⟨rationalPoints.map f y, ?_, ?_⟩
      · exact Plancherel.rationalCommonNormKernel_le_comap f (htop ▸ Subgroup.mem_top y)
      · simp only [rationalPoints.map_apply, ← hf]
        rfl
    · exact le_sup_of_le_left (le_iSup R ⟨⟨A, a⟩, hAs, ha, hn, hAn⟩)
  have hKU : K ≤ Subgroup.closure (⋃ a ∈ relativeRoots i,
      ((RelativeRoot.subgroup i a).carrier (Over.mk (𝟙 _)) : Set (rationalPoints G))) :=
    iSup_le fun p => hB F G hG S i hi p.1.1 p.1.2 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2
  rintro _ ⟨z, rfl⟩
  have hz : rationalPoints.map j z ∈ K ⊔ N := hKN ▸ Subgroup.mem_top _
  obtain ⟨x, hx, y, hy, hxy⟩ := Subgroup.mem_sup_of_normal_left.mp hz
  have hyZ : y ∈ (rationalPoints.map j).range := by
    obtain ⟨w, -, rfl⟩ := Subgroup.mem_map.mp hy
    exact ⟨w, rfl⟩
  have hxZ : x ∈ (rationalPoints.map j).range := by
    rw [eq_mul_inv_of_mul_eq hxy]
    exact mul_mem ⟨z, rfl⟩ (inv_mem hyZ)
  rw [← hxy]
  exact Subgroup.mul_mem_sup ⟨hrange ▸ hxZ, hKU hx⟩ hy

end Langlands.GroupScheme
