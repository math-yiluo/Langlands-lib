import Langlands.GroupScheme.SimplyConnected.RankOneCentralizerGenerationStatement
import Langlands.GroupScheme.SimplyConnected.RankOneCentralizerGenerationReduction
import Langlands.GroupScheme.SimplyConnected.KneserTitsCentralizerProof
import Langlands.GroupScheme.Rational.RootGeneratedCentralizerRankOneProof

/-! # Rank-one generation of split-torus centralizers in simply connected groups: proof -/

universe u

namespace Langlands.GroupScheme

/-- **Rank-one generation of split-torus centralizers.** Over a nonarchimedean local field, the
rational points of the centralizer `Z` of a maximal split torus of a simply connected group lie
in the subgroup generated by the groups `Z(F) ∩ ⟨U_a(F), U_{-a}(F)⟩`, for the relative roots
`a`, together with the common kernel `Z(F)^1` of the absolute values of the rational characters
of `Z`. -/
theorem simplyConnectedRankOneCentralizerGeneration :
    SimplyConnectedRankOneCentralizerGenerationStatement.{u} :=
  simplyConnectedRankOneCentralizerGeneration_of_kneserTits rootGeneratedCentralizerRankOne
    simplyConnectedKneserTitsCentralizer

end Langlands.GroupScheme
