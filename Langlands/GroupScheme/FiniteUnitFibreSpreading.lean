import Mathlib.AlgebraicGeometry.Morphisms.Finite

/-! # Finite group schemes with a trivial fibre -/

noncomputable section

universe u v w

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped TensorProduct
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace Langlands.GroupScheme.FiniteUnitFibreSpreading

section Algebra

variable {R : Type u} [CommRing R] {B : Type u} [CommRing B] [Algebra R B]

private theorem idempotent_certificate {M : Type u} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (e : M →ₗ[R] M) (he : ∀ x, e (e x) = e x)
    (K : Type u) [Field K] [Algebra R K] (h : e.lTensor K = 0) :
    ∃ r : R, IsUnit (algebraMap R K r) ∧ ∀ x, r • e x = 0 := by
  let P := LinearMap.range e
  let i := P.subtype
  let q := e.rangeRestrict
  have hqi : q ∘ₗ i = LinearMap.id := by
    apply LinearMap.ext
    rintro ⟨y, x, rfl⟩
    exact Subtype.ext (he x)
  have hiq : i ∘ₗ q = e := e.subtype_comp_rangeRestrict
  have hsub : Subsingleton (K ⊗[R] P) := by
    have hz (z : K ⊗[R] P) : z = 0 := by
      have h1 : z = (q.lTensor K) ((i.lTensor K) z) := by
        rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hqi,
          LinearMap.lTensor_id, LinearMap.id_apply]
      have h2 : (i.lTensor K) z = (e.lTensor K) ((i.lTensor K) z) := by
        conv_lhs => rw [h1]
        rw [← LinearMap.comp_apply (i.lTensor K), ← LinearMap.lTensor_comp, hiq]
      rw [h, LinearMap.zero_apply] at h2
      rw [h1, h2, map_zero]
    exact ⟨fun x y => (hz x).trans (hz y).symm⟩
  obtain ⟨r, hr, hr0⟩ :=
    Langlands.CommutativeAlgebra.CartierLocusDescent.exists_smul_eq_zero_of_subsingleton hsub
  exact ⟨r, hr, fun x => congrArg Subtype.val (hr0 (q x))⟩

/-- A finite augmented algebra whose residue fibre is generated by the unit
has a principal certificate for being the base algebra. -/
theorem exists_principal_certificate [Module.Finite R B] (ε : B →ₐ[R] R)
    (K : Type u) [Field K] [Algebra R K]
    (h : Function.Surjective (algebraMap K (K ⊗[R] B))) :
    ∃ r : R, IsUnit (algebraMap R K r) ∧ ∀ (A : Type w) [CommRing A] [Algebra R A],
      IsUnit (algebraMap R A r) → Function.Bijective (algebraMap A (A ⊗[R] B)) := by
  let e : B →ₗ[R] B := LinearMap.id - (Algebra.linearMap R B).comp ε.toLinearMap
  have he (b : B) : e b = b - algebraMap R B (ε b) := rfl
  have hee (b : B) : e (e b) = e b := by simp [he]
  have hezero : e.lTensor K = 0 := by
    apply LinearMap.ext
    intro z
    obtain ⟨a, rfl⟩ := h z
    change a ⊗ₜ[R] e 1 = 0
    simp [he]
  obtain ⟨r, hr, hre⟩ := idempotent_certificate e hee K hezero
  refine ⟨r, hr, fun A _ _ hAr => ?_⟩
  let φ : A ⊗[R] B →ₐ[R] A :=
    Algebra.TensorProduct.productMap (AlgHom.id R A) ((Algebra.ofId R A).comp ε)
  have hφ (a : A) : φ (algebraMap A (A ⊗[R] B) a) = a := by
    simp [φ, Algebra.TensorProduct.algebraMap_apply]
  refine ⟨Function.LeftInverse.injective hφ, ?_⟩
  have ht (b : B) : (1 : A) ⊗ₜ[R] b =
      algebraMap A (A ⊗[R] B) (algebraMap R A (ε b)) := by
    have hzero : (1 : A) ⊗ₜ[R] e b = 0 := by
      apply hAr.smul_eq_zero.mp
      have hz : (r • (1 : A)) ⊗ₜ[R] e b = 0 := by
        rw [TensorProduct.smul_tmul, hre, TensorProduct.tmul_zero]
      simpa [Algebra.smul_def] using hz
    simpa [he, TensorProduct.tmul_sub, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, sub_eq_zero,
      Algebra.TensorProduct.one_def] using hzero
  intro z
  induction z using TensorProduct.inductionOn with
  | tmul a b =>
    refine ⟨a * algebraMap R A (ε b), ?_⟩
    rw [map_mul, ← ht]
    simp [Algebra.TensorProduct.algebraMap_apply]
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, map_add _ _ _⟩

end Algebra

section Spectrum

variable {R B A : Type u} [CommRing R] [CommRing B] [CommRing A]
    [Algebra R B] [Algebra R A]

/-- An isomorphic base-changed spectrum has a bijective scalar map. -/
theorem scalar_bijective_of_isIso_pullbackSnd
    [IsIso (pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap R B)))
      (Spec.map (CommRingCat.ofHom (algebraMap R A))))] :
    Function.Bijective (algebraMap A (A ⊗[R] B)) := by
  have : IsIso (pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap R A)))
      (Spec.map (CommRingCat.ofHom (algebraMap R B)))) := by
    rw [← pullbackSymmetry_hom_comp_snd]
    infer_instance
  have : IsIso (Spec.map (CommRingCat.ofHom (algebraMap A (A ⊗[R] B)))) := by
    rw [← pullbackSpecIso_inv_fst']
    infer_instance
  have : IsIso (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (A ⊗[R] B))).op) :=
    ‹IsIso (Spec.map (CommRingCat.ofHom (algebraMap A (A ⊗[R] B))))›
  have : IsIso (CommRingCat.ofHom (algebraMap A (A ⊗[R] B))).op :=
    isIso_of_reflects_iso _ Scheme.Spec
  have : IsIso (CommRingCat.ofHom (algebraMap A (A ⊗[R] B))) := isIso_of_op _
  exact ConcreteCategory.bijective_of_isIso (CommRingCat.ofHom (algebraMap A (A ⊗[R] B)))

/-- A bijective scalar map makes the base-changed spectrum an isomorphism. -/
theorem isIso_pullbackSnd_of_scalar_bijective
    (h : Function.Bijective (algebraMap A (A ⊗[R] B))) :
    IsIso (pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap R B)))
      (Spec.map (CommRingCat.ofHom (algebraMap R A)))) := by
  have : IsIso (CommRingCat.ofHom (algebraMap A (A ⊗[R] B))) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr h
  have : IsIso (pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap R A)))
      (Spec.map (CommRingCat.ofHom (algebraMap R B)))) := by
    rw [← pullbackSpecIso_hom_fst']
    infer_instance
  rw [← pullbackSymmetry_hom_comp_fst]
  infer_instance

end Spectrum

section Groups

open Langlands.GroupScheme

/-- Pullback of a trivial group remains trivial after another base change. -/
theorem isIso_baseChange_comp {S T U : Scheme.{u}} (b : T ⟶ S) (c : U ⟶ T)
    (K : Langlands.GroupScheme S)
    [IsIso ((baseChange b).obj K).X.hom] :
    IsIso ((baseChange (c ≫ b)).obj K).X.hom := by
  have : IsIso ((baseChange c).obj ((baseChange b).obj K)).X.hom := by
    change IsIso (pullback.snd _ _)
    infer_instance
  rw [← Over.w (baseChangeCompIso b c K).hom.hom.hom]
  infer_instance

/-- A finite group over an affine base with trivial residue fibre is trivial
over an open neighbourhood of that base point. -/
theorem exists_isIso_neighbourhood_affine {R : CommRingCat.{u}}
    (K : Langlands.GroupScheme (Spec R)) [IsFinite K.X.hom] (s : Spec R)
    (hs : IsIso ((baseChange ((Spec R).fromSpecResidueField s)).obj K).X.hom) :
    ∃ U : (Spec R).Opens, s ∈ U ∧ IsIso ((baseChange U.ι).obj K).X.hom := by
  have : IsAffine K.X.left := isAffine_of_isAffineHom K.X.hom
  let B := AffineCoordinates.hopfAlgebra K
  let M := (hopfSpec R).obj (Opposite.op B)
  let e : M ≅ K := AffineCoordinates.hopfSpecIso K
  have : Module.Finite R B := by
    have hfin : IsFinite (e.hom.hom.hom.left ≫ K.X.hom) := inferInstance
    rw [Over.w] at hfin
    change IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R B))) at hfin
    exact RingHom.finite_algebraMap.mp ((IsFinite.SpecMap_iff _).mp hfin)
  let k := (Spec R).residueField s
  let φ := (Spec.preimage ((Spec R).fromSpecResidueField s)).hom
  let : Algebra R k := φ.toAlgebra
  let b := Spec.map (CommRingCat.ofHom (algebraMap R k))
  have hb : b = (Spec R).fromSpecResidueField s := Spec.map_preimage _
  have : IsIso ((baseChange b).obj K).X.hom := by rw [hb]; exact hs
  have : IsIso ((baseChange b).obj M).X.hom := by
    rw [← Over.w ((baseChange b).mapIso e).hom.hom.hom]
    infer_instance
  have : IsIso (pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap R B))) b) := ‹IsIso ((baseChange b).obj M).X.hom›
  have hscalar : Function.Bijective (algebraMap k (k ⊗[R] B)) :=
    scalar_bijective_of_isIso_pullbackSnd
  obtain ⟨r, hr, hA⟩ :=
    exists_principal_certificate (Bialgebra.counitAlgHom R B) k hscalar.surjective
  have hrmem : s ∈ PrimeSpectrum.basicOpen r := by
    let zPoint : Spec k := ⟨⊥, Ideal.isPrime_bot⟩
    have hpoint : b zPoint = s := by rw [hb]; exact Scheme.fromSpecResidueField_apply _ _
    rw [← hpoint]
    change algebraMap R k r ∉ (⊥ : Ideal k)
    simpa only [Ideal.mem_bot] using isUnit_iff_ne_zero.mp hr
  let A := Localization.Away r
  let c := Spec.map (CommRingCat.ofHom (algebraMap R A))
  have hbij : Function.Bijective (algebraMap A (A ⊗[R] B)) :=
    hA A (IsLocalization.Away.algebraMap_isUnit r)
  have : IsIso ((baseChange c).obj M).X.hom :=
    isIso_pullbackSnd_of_scalar_bijective hbij
  have : IsIso ((baseChange c).obj K).X.hom := by
    rw [← Over.w ((baseChange c).mapIso e).inv.hom.hom]
    infer_instance
  refine ⟨PrimeSpectrum.basicOpen r, hrmem, ?_⟩
  rw [← basicOpenIsoSpecAway_hom_SpecMap r]
  exact isIso_baseChange_comp c (basicOpenIsoSpecAway r).hom K

/-- A trivial residue fibre stays trivial after arbitrary base change. -/
theorem isIso_fibre_baseChange {S T : Scheme.{u}} (b : T ⟶ S)
    (K : Langlands.GroupScheme S) (t : T)
    [IsIso ((baseChange (S.fromSpecResidueField (b t))).obj K).X.hom] :
    IsIso ((baseChange (T.fromSpecResidueField t)).obj ((baseChange b).obj K)).X.hom := by
  have : IsIso ((baseChange (T.fromSpecResidueField t ≫ b)).obj K).X.hom := by
    rw [← b.SpecMap_residueFieldMap_fromSpecResidueField]
    exact isIso_baseChange_comp (S.fromSpecResidueField (b t))
      (Spec.map (b.residueFieldMap t)) K
  rw [← Over.w (baseChangeCompIso b (T.fromSpecResidueField t) K).inv.hom.hom]
  infer_instance

/-- Triviality of a base change along an open immersion gives a neighbourhood
with the same property in the original base. -/
theorem exists_isIso_neighbourhood_of_openImmersion
    {S T : Scheme.{u}} (b : T ⟶ S) [IsOpenImmersion b]
    (K : Langlands.GroupScheme S) (t : T)
    [IsIso ((baseChange b).obj K).X.hom] :
    ∃ U : S.Opens, b t ∈ U ∧ IsIso ((baseChange U.ι).obj K).X.hom := by
  refine ⟨b.opensRange, ⟨t, rfl⟩, ?_⟩
  have h := isIso_baseChange_comp b b.isoOpensRange.inv K
  rw [← Scheme.Hom.isoOpensRange_inv_comp b]
  exact h

/-- A finite group scheme with trivial residue fibre is trivial over an open
neighbourhood of the base point. No flatness or finite presentation is needed. -/
theorem exists_isIso_neighbourhood {S : Scheme.{u}} (K : Langlands.GroupScheme S)
    [IsFinite K.X.hom] (s : S)
    (hs : IsIso ((baseChange (S.fromSpecResidueField s)).obj K).X.hom) :
    ∃ U : S.Opens, s ∈ U ∧ IsIso ((baseChange U.ι).obj K).X.hom := by
  obtain ⟨a, t, ht⟩ := S.affineCover.exists_eq s
  let b := S.affineCover.f a
  have : IsFinite ((baseChange b).obj K).X.hom := by
    change IsFinite (pullback.snd _ _)
    infer_instance
  have : IsIso ((baseChange (S.fromSpecResidueField (b t))).obj K).X.hom := by
    rw [show b t = s from ht]
    exact hs
  have hs' := isIso_fibre_baseChange b K t
  obtain ⟨V, htV, hV⟩ := exists_isIso_neighbourhood_affine ((baseChange b).obj K) t hs'
  let j := V.ι ≫ b
  have : IsIso ((baseChange j).obj K).X.hom := by
    have : IsIso ((baseChange V.ι).obj ((baseChange b).obj K)).X.hom := hV
    rw [← Over.w (baseChangeCompIso b V.ι K).hom.hom.hom]
    infer_instance
  obtain ⟨U, hsU, hU⟩ := exists_isIso_neighbourhood_of_openImmersion j K ⟨t, htV⟩
  refine ⟨U, ?_, hU⟩
  change b t ∈ U at hsU
  rwa [show b t = s from ht] at hsU

/-- A trivial fibre and a finite neighbourhood give a trivial neighbourhood. -/
theorem exists_isIso_neighbourhood_of_finite_neighbourhood {S : Scheme.{u}}
    (K : Langlands.GroupScheme S) (s : S)
    (hfin : ∃ V : S.Opens, s ∈ V ∧ IsFinite ((baseChange V.ι).obj K).X.hom)
    (hs : IsIso ((baseChange (S.fromSpecResidueField s)).obj K).X.hom) :
    ∃ U : S.Opens, s ∈ U ∧ IsIso ((baseChange U.ι).obj K).X.hom := by
  obtain ⟨V, hsV, hV⟩ := hfin
  let t : V.toScheme := ⟨s, hsV⟩
  have : IsFinite ((baseChange V.ι).obj K).X.hom := hV
  have : IsIso ((baseChange (S.fromSpecResidueField (V.ι t))).obj K).X.hom := hs
  have hs' := isIso_fibre_baseChange V.ι K t
  obtain ⟨W, htW, hW⟩ := exists_isIso_neighbourhood ((baseChange V.ι).obj K) t hs'
  let j := W.ι ≫ V.ι
  have : IsIso ((baseChange j).obj K).X.hom := by
    have : IsIso ((baseChange W.ι).obj ((baseChange V.ι).obj K)).X.hom := hW
    rw [← Over.w (baseChangeCompIso V.ι W.ι K).hom.hom.hom]
    infer_instance
  exact exists_isIso_neighbourhood_of_openImmersion j K ⟨t, htW⟩

/-- A specified open neighbourhood on which the actual group is trivial,
including its structure isomorphism. -/
structure TrivialNeighbourhood {S : Scheme.{u}} (K : Langlands.GroupScheme S) (s : S) where
  neighbourhood : S.Opens
  point_mem : s ∈ neighbourhood
  trivialization : ((baseChange neighbourhood.ι).obj K).X.left ≅ neighbourhood.toScheme
  structure_eq : trivialization.hom = ((baseChange neighbourhood.ι).obj K).X.hom

/-- Choose a neighbourhood with its actual structure isomorphism from an
existence proof. -/
def trivialNeighbourhoodOfExists {S : Scheme.{u}} (K : Langlands.GroupScheme S) (s : S)
    (h : ∃ U : S.Opens, s ∈ U ∧ IsIso ((baseChange U.ι).obj K).X.hom) :
    TrivialNeighbourhood K s := by
  let U := h.choose
  have hU : s ∈ U ∧ IsIso ((baseChange U.ι).obj K).X.hom := h.choose_spec
  let : IsIso ((baseChange U.ι).obj K).X.hom := hU.2
  exact {
    neighbourhood := U
    point_mem := hU.1
    trivialization := asIso ((baseChange U.ι).obj K).X.hom
    structure_eq := rfl }

/-- Construct an actual trivial neighbourhood of a finite group with trivial
residue fibre. -/
def trivialNeighbourhood {S : Scheme.{u}} (K : Langlands.GroupScheme S)
    [IsFinite K.X.hom] (s : S)
    (hs : IsIso ((baseChange (S.fromSpecResidueField s)).obj K).X.hom) :
    TrivialNeighbourhood K s :=
  trivialNeighbourhoodOfExists K s (exists_isIso_neighbourhood K s hs)

end Groups

end Langlands.GroupScheme.FiniteUnitFibreSpreading
