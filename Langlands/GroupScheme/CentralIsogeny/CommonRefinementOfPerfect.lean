import Langlands.GroupScheme.CentralIsogeny.CommonRefinementConstruction
import Langlands.GroupScheme.CentralIsogeny.ProjectionCentralIsogeny
import Langlands.GroupScheme.CentralIsogeny.SemisimpleTransfer
import Langlands.GroupScheme.CentralIsogeny.CommonSemisimpleRefinementStatement

/-! # Common semisimple refinement of two central isogenies with perfect sources

Two central isogenies `π : C ⟶ G` and `q : H ⟶ G` between semisimple field groups have a
common semisimple refinement as soon as `C` and `H` are perfect. The refinement is the closed
subgroup of `C × H` generated by the descended commutators. -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]

/-- Homomorphisms `π : C ⟶ G` and `q : H ⟶ G` of field groups have a common semisimple
refinement: a semisimple `D` with central isogenies `p : D ⟶ C` and `r : D ⟶ H` such that
`p ≫ π = r ≫ q`. -/
def HasCommonSemisimpleRefinement {C H G : GroupScheme (Spec (CommRingCat.of k))}
    (π : C ⟶ G) (q : H ⟶ G) : Prop :=
  ∃ (D : GroupScheme (Spec (CommRingCat.of k))) (p : D ⟶ C) (r : D ⟶ H),
    IsSemisimple D ∧ IsCentralIsogeny p ∧ IsCentralIsogeny r ∧ p ≫ π = r ≫ q

namespace CommonRefinement

/-- Two central isogenies `π : C ⟶ G` and `q : H ⟶ G` between semisimple field groups with
perfect sources have a common semisimple refinement. -/
theorem hasCommonSemisimpleRefinement_of_perfect
    {C H G : GroupScheme (Spec (CommRingCat.of k))} (π : C ⟶ G) (q : H ⟶ G)
    (hC : IsSemisimple C) (hH : IsSemisimple H) (hG : IsSemisimple G) (hπ : IsCentralIsogeny π) (hq : IsCentralIsogeny q)
    (hCp : derivedSubgroup C = ⊤) (hHp : derivedSubgroup H = ⊤) :
    HasCommonSemisimpleRefinement π q := by
  have := hπ.isFinite
  have := hπ.flat
  have := hπ.surjective
  have := hq.isFinite
  have := hq.flat
  have := hq.surjective
  obtain ⟨D, i, hi, hDs, hDa, hDc, hcomm, hfst, hsnd⟩ := exists_closedSubgroup
    hC.isConnectedReductive.smooth hC.isConnectedReductive.isAffineHom
    hC.isConnectedReductive.connectedSpace
    hH.isConnectedReductive.smooth hH.isConnectedReductive.isAffineHom
    hH.isConnectedReductive.connectedSpace
    hG.isConnectedReductive.smooth hG.isConnectedReductive.isAffineHom
    hG.isConnectedReductive.connectedSpace
    π q hπ.isCentral_kernelι hq.isCentral_kernelι hCp hHp
  have hcomm' : i ≫ fst C H ≫ π = i ≫ snd C H ≫ q := by
    simpa only [Category.assoc] using hcomm
  have hp := isCentralIsogeny_fst_of_closedSubgroup hq hC.isConnectedReductive.smooth i hi
    hcomm' hDs hDa hfst
  have hr := isCentralIsogeny_snd_of_closedSubgroup hπ hH.isConnectedReductive.smooth i hi
    hcomm' hDs hDa hsnd
  let : GeometricallyConnected D.X.hom := hDc
  have hDconn : ConnectedSpace D.X.left :=
    GeometricallyConnected.connectedSpace_of_subsingleton (f := D.X.hom)
  exact ⟨D, i ≫ fst C H, i ≫ snd C H, IsSemisimple.of_isCentralIsogeny _ hp hC hDs hDconn,
    hp, hr, hcomm⟩

end CommonRefinement

/-- The common semisimple refinement statement follows from perfectness of every semisimple
field group in universe `u`. -/
theorem centralIsogenyCommonSemisimpleRefinement_of_perfect
    (hperf : ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k))),
      IsSemisimple G → derivedSubgroup G = ⊤) :
    CentralIsogenyCommonSemisimpleRefinement.{u} := by
  intro k _ C H G π q hC hH hG hπ hq
  exact CommonRefinement.hasCommonSemisimpleRefinement_of_perfect π q hC hH hG hπ hq
    (hperf k C hC) (hperf k H hH)

end Langlands.GroupScheme
