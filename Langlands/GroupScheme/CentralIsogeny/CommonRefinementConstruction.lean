import Langlands.GroupScheme.CentralIsogeny.CommutatorDescent
import Langlands.GroupScheme.ImageGenerationPointed
import Langlands.GroupScheme.ImageGenerationSourceTransport
import Langlands.GroupScheme.SmoothConnectedGeometryProof
import Langlands.GroupScheme.Derived.CommutatorEnvelope
import Langlands.AlgebraicGeometry.SmoothReducedProof

/-! # A closed subgroup of `C × H` generated by descended commutators -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace CommonRefinement

section Base

variable {S : Scheme.{u}} {C H G : GroupScheme S} (π : C ⟶ G) (q : H ⟶ G)
  (hπ : IsCentral (kernelι π)) (hq : IsCentral (kernelι q))
  [QuasiCompact π.hom.hom.left] [Flat π.hom.hom.left] [Surjective π.hom.hom.left]
  [QuasiCompact q.hom.hom.left] [Flat q.hom.hom.left] [Surjective q.hom.hom.left]

/-- The pair of descended commutator morphisms, with values in the product group. -/
def ambientMap : G.X ⊗ G.X ⟶ (C ⊗ H).X :=
  lift (CommutatorDescent.hom π hπ) (CommutatorDescent.hom q hq)

@[reassoc (attr := simp)]
theorem ambientMap_fst : ambientMap π q hπ hq ≫ fst C.X H.X = CommutatorDescent.hom π hπ :=
  lift_fst _ _

@[reassoc (attr := simp)]
theorem ambientMap_snd : ambientMap π q hπ hq ≫ snd C.X H.X = CommutatorDescent.hom q hq :=
  lift_snd _ _

/-- The identity pair maps to the identity of the product. -/
theorem one_ambientMap {T : Over S} :
    lift (1 : T ⟶ G.X) 1 ≫ ambientMap π q hπ hq = 1 := by
  apply (productPointsEquiv C H T).injective
  rw [map_one]
  apply Prod.ext
  · rw [productPointsEquiv_fst, Category.assoc, ambientMap_fst, CommutatorDescent.one_hom]
    rfl
  · rw [productPointsEquiv_snd, Category.assoc, ambientMap_snd, CommutatorDescent.one_hom]
    rfl

variable {π q hπ hq} (D : GeneratedImage (ambientMap π q hπ hq))

/-- The generated factor followed by the first projection is the descended commutator. -/
theorem factor_fst :
    D.factor ≫ (D.inclusion ≫ fst C H).hom.hom = CommutatorDescent.hom π hπ := by
  rw [Grp.comp_hom_hom, Grp.fst_hom_hom, ← Category.assoc, D.factor_comp, ambientMap_fst]

/-- The generated factor followed by the second projection is the descended commutator. -/
theorem factor_snd :
    D.factor ≫ (D.inclusion ≫ snd C H).hom.hom = CommutatorDescent.hom q hq := by
  rw [Grp.comp_hom_hom, Grp.snd_hom_hom, ← Category.assoc, D.factor_comp, ambientMap_snd]

/-- The generated factor followed by the first composite to `G` is the commutator of `G`. -/
theorem factor_fst_comp :
    D.factor ≫ ((D.inclusion ≫ fst C H) ≫ π).hom.hom = commutatorMap (𝟙 G) (𝟙 G) := by
  rw [Grp.comp_hom_hom _ π, ← Category.assoc, factor_fst, CommutatorDescent.hom_comp]

/-- The generated factor followed by the second composite to `G` is the commutator of `G`. -/
theorem factor_snd_comp :
    D.factor ≫ ((D.inclusion ≫ snd C H) ≫ q).hom.hom = commutatorMap (𝟙 G) (𝟙 G) := by
  rw [Grp.comp_hom_hom _ q, ← Category.assoc, factor_snd, CommutatorDescent.hom_comp]

/-- Both composites to `G` agree on every ordered power of the generating map. -/
theorem powerMap_comp_eq (n : ℕ) :
    D.powerMap n ≫ ((D.inclusion ≫ fst C H) ≫ π).hom.hom =
      D.powerMap n ≫ ((D.inclusion ≫ snd C H) ≫ q).hom.hom := by
  rw [GeneratedImage.powerMap, orderedPowerMap_comp, orderedPowerMap_comp, factor_fst_comp,
    factor_snd_comp]

/-- If some ordered power is dominant and the source is reduced, the two composites to a
separated `G` coincide. -/
theorem fst_comp_eq_snd_comp [IsReduced D.group.X.left] [IsSeparated G.X.hom] (n : ℕ)
    (hn : IsDominant (D.powerMap n).left) :
    (D.inclusion ≫ fst C H) ≫ π = (D.inclusion ≫ snd C H) ≫ q := by
  apply Grp.hom_ext
  apply Over.OverMorphism.ext
  exact ext_of_isDominant_of_isSeparated G.X.hom (by rw [Over.w, Over.w])
    (D.powerMap n).left (congrArg (fun z => z.left) (powerMap_comp_eq D n))

/-- A generated representative of the commutator envelope of a perfect group is the whole
group. -/
theorem isIso_inclusion_of_perfect {K : GroupScheme S} (hK : derivedSubgroup K = ⊤)
    (E : GeneratedImage (commutatorMap (𝟙 K) (𝟙 K))) : IsIso E.inclusion.hom.hom := by
  have hrange : SubgroupFunctor.range E.inclusion = ⊤ := by
    rw [E.represents.2, ← derivedSubgroup_eq_closedImageEnvelope, hK]
  have hmem : 𝟙 K.X ∈ (SubgroupFunctor.range E.inclusion).carrier K.X := by
    rw [hrange]
    exact Subgroup.mem_top _
  obtain ⟨s, hs⟩ := SubgroupFunctor.mem_range.1 hmem
  have : Mono E.inclusion.hom.hom := E.represents.1
  have : IsSplitEpi E.inclusion.hom.hom := ⟨⟨s, hs⟩⟩
  exact isIso_of_mono_of_isSplitEpi _

/-- Ordered powers of the commutator of a perfect group are dominant as soon as one
generated representative of the commutator envelope has a dominant power. -/
theorem isDominant_orderedPowerMap_of_perfect {K : GroupScheme S} (hK : derivedSubgroup K = ⊤)
    (E : GeneratedImage (commutatorMap (𝟙 K) (𝟙 K))) (m : ℕ)
    (hm : IsDominant (E.powerMap m).left) :
    IsDominant (orderedPowerMap (commutatorMap (𝟙 K) (𝟙 K)) m).left := by
  have : IsIso E.inclusion.hom.hom := isIso_inclusion_of_perfect hK E
  have : IsIso E.inclusion.hom.hom.left := (Over.forget S).map_isIso E.inclusion.hom.hom
  rw [← E.powerMap_comp, Over.comp_left]
  infer_instance

/-- Perfectness of `C` makes the first projection of the generated subgroup dominant. -/
theorem isDominant_fst (hC : derivedSubgroup C = ⊤)
    (E : GeneratedImage (commutatorMap (𝟙 C) (𝟙 C))) (m : ℕ)
    (hm : IsDominant (E.powerMap m).left) :
    IsDominant (D.inclusion ≫ fst C H).hom.hom.left := by
  have h := isDominant_orderedPowerMap_of_perfect hC E m hm
  have h₂ : orderedPowerMap (commutatorMap (𝟙 C) (𝟙 C)) m =
      finitePowerMap (π.hom.hom ⊗ₘ π.hom.hom) m ≫ D.powerMap m ≫
        (D.inclusion ≫ fst C H).hom.hom := by
    rw [GeneratedImage.powerMap, orderedPowerMap_comp, orderedPowerMap_precomp, factor_fst,
      CommutatorDescent.fac]
  rw [h₂, ← Category.assoc, Over.comp_left] at h
  exact IsDominant.of_comp (H := h)

/-- Perfectness of `H` makes the second projection of the generated subgroup dominant. -/
theorem isDominant_snd (hH : derivedSubgroup H = ⊤)
    (E : GeneratedImage (commutatorMap (𝟙 H) (𝟙 H))) (m : ℕ)
    (hm : IsDominant (E.powerMap m).left) :
    IsDominant (D.inclusion ≫ snd C H).hom.hom.left := by
  have h := isDominant_orderedPowerMap_of_perfect hH E m hm
  have h₂ : orderedPowerMap (commutatorMap (𝟙 H) (𝟙 H)) m =
      finitePowerMap (q.hom.hom ⊗ₘ q.hom.hom) m ≫ D.powerMap m ≫
        (D.inclusion ≫ snd C H).hom.hom := by
    rw [GeneratedImage.powerMap, orderedPowerMap_comp, orderedPowerMap_precomp, factor_snd,
      CommutatorDescent.fac]
  rw [h₂, ← Category.assoc, Over.comp_left] at h
  exact IsDominant.of_comp (H := h)

end Base

section Field

variable {k : Type u} [Field k]

set_option backward.isDefEq.respectTransparency.types false in
/-- The product of two smooth field groups is smooth. -/
theorem smooth_tensor {C H : GroupScheme (Spec (CommRingCat.of k))}
    (hC : Smooth C.X.hom) (hH : Smooth H.X.hom) : Smooth (C ⊗ H).X.hom := by
  let : Smooth C.X.hom := hC
  let : Smooth H.X.hom := hH
  change Smooth (pullback.fst C.X.hom H.X.hom ≫ C.X.hom)
  infer_instance

/-- The commutator of the identity pair is the identity. -/
theorem one_commutatorMap {K : GroupScheme (Spec (CommRingCat.of k))}
    {T : Over (Spec (CommRingCat.of k))} :
    lift (1 : T ⟶ K.X) 1 ≫ commutatorMap (𝟙 K) (𝟙 K) = 1 := by
  rw [commutatorMap_lift]
  simp only [MonObj.one_comp, mul_one, inv_one]

/-- Over a field, the descended commutators of two central isogenies with perfect smooth
connected affine sources generate a smooth connected affine closed subgroup of the product of
the sources. On it the two composites to the target agree, and both projections are dominant. -/
theorem exists_closedSubgroup {C H G : GroupScheme (Spec (CommRingCat.of k))}
    (hC : Smooth C.X.hom) (hCa : IsAffineHom C.X.hom) (hCc : ConnectedSpace C.X.left)
    (hH : Smooth H.X.hom) (hHa : IsAffineHom H.X.hom) (hHc : ConnectedSpace H.X.left)
    (hG : Smooth G.X.hom) (hGa : IsAffineHom G.X.hom) (hGc : ConnectedSpace G.X.left)
    (π : C ⟶ G) (q : H ⟶ G) (hπ : IsCentral (kernelι π)) (hq : IsCentral (kernelι q))
    [QuasiCompact π.hom.hom.left] [Flat π.hom.hom.left] [Surjective π.hom.hom.left]
    [QuasiCompact q.hom.hom.left] [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    (hCp : derivedSubgroup C = ⊤) (hHp : derivedSubgroup H = ⊤) :
    ∃ (D : GroupScheme (Spec (CommRingCat.of k))) (i : D ⟶ C ⊗ H),
      IsClosedSubgroup i ∧ Smooth D.X.hom ∧ IsAffineHom D.X.hom ∧
        GeometricallyConnected D.X.hom ∧ (i ≫ fst C H) ≫ π = (i ≫ snd C H) ≫ q ∧
        IsDominant (i ≫ fst C H).hom.hom.left ∧ IsDominant (i ≫ snd C H).hom.hom.left := by
  obtain ⟨hVa, hVf, -, hVi⟩ := smoothConnectedAffineGeometry.2 k G G hG hGa hGc hG hGa hGc
  obtain ⟨hPa, -, -, -⟩ := smoothConnectedAffineGeometry.2 k C H hC hCa hCc hH hHa hHc
  obtain ⟨D, hDs, hDa, hDc, n, -, hn⟩ := ImageGeneration.pointedImageGeneration k (C ⊗ H)
    (smooth_tensor hC hH) hPa (G.X ⊗ G.X) hVa hVf hVi (lift 1 1) (ambientMap π q hπ hq)
    (one_ambientMap π q hπ hq)
  obtain ⟨hCCa, hCCf, -, hCCi⟩ := smoothConnectedAffineGeometry.2 k C C hC hCa hCc hC hCa hCc
  obtain ⟨E, -, -, -, m, -, hm⟩ := ImageGeneration.pointedImageGeneration k C hC hCa
    (C.X ⊗ C.X) hCCa hCCf hCCi (lift 1 1) (commutatorMap (𝟙 C) (𝟙 C)) one_commutatorMap
  obtain ⟨hHHa, hHHf, -, hHHi⟩ := smoothConnectedAffineGeometry.2 k H H hH hHa hHc hH hHa hHc
  obtain ⟨F, -, -, -, l, -, hl⟩ := ImageGeneration.pointedImageGeneration k H hH hHa
    (H.X ⊗ H.X) hHHa hHHf hHHi (lift 1 1) (commutatorMap (𝟙 H) (𝟙 H)) one_commutatorMap
  let : Smooth D.group.X.hom := hDs
  let : IsReduced D.group.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k
      D.group.X.left D.group.X.hom
  let : IsAffineHom G.X.hom := hGa
  exact ⟨D.group, D.inclusion, D.closed, hDs, hDa, hDc, fst_comp_eq_snd_comp D n hn,
    isDominant_fst D hCp E m hm, isDominant_snd D hHp F l hl⟩

end Field

end CommonRefinement

end Langlands.GroupScheme
