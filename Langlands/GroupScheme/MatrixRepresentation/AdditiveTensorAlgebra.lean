import Langlands.GroupScheme.MatrixRepresentation.AdditiveTensorCoefficients
import Mathlib.Data.Matrix.Basis

/-! # Conditional separation of actual additive tensor coefficient algebras -/

noncomputable section

universe u v

open CategoryTheory Opposite AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix Polynomial Kronecker

namespace Langlands.GroupScheme.MatrixRepresentation.AdditiveTensorAlgebra

open AdditiveDividedPowers AdditiveTensorCoefficients
open Finset.HasAntidiagonal

variable {k : Type u} [Field k]
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

/-- The first matrix factor acting on product-basis coordinates. -/
def leftTensor : Matrix n n k →ₐ[k] Matrix (n × m) (n × m) k where
  toFun A := A ⊗ₖ (1 : Matrix m m k)
  map_zero' := Matrix.zero_kronecker _
  map_one' := Matrix.one_kronecker_one
  map_add' A B := Matrix.add_kronecker A B _
  map_mul' A B := by rw [← Matrix.mul_kronecker_mul, Matrix.one_mul]
  commutes' c := by
    simp only [Algebra.algebraMap_eq_smul_one, Matrix.smul_kronecker,
      Matrix.one_kronecker_one]

/-- The second matrix factor acting on product-basis coordinates. -/
def rightTensor : Matrix m m k →ₐ[k] Matrix (n × m) (n × m) k where
  toFun B := (1 : Matrix n n k) ⊗ₖ B
  map_zero' := Matrix.kronecker_zero _
  map_one' := Matrix.one_kronecker_one
  map_add' A B := Matrix.kronecker_add _ A B
  map_mul' A B := by rw [← Matrix.mul_kronecker_mul, Matrix.one_mul]
  commutes' c := by
    simp only [Algebra.algebraMap_eq_smul_one, Matrix.kronecker_smul,
      Matrix.one_kronecker_one]

theorem leftTensor_mul_rightTensor (A : Matrix n n k) (B : Matrix m m k) :
    leftTensor A * rightTensor B = A ⊗ₖ B := by
  change (A ⊗ₖ (1 : Matrix m m k)) * ((1 : Matrix n n k) ⊗ₖ B) = _
  rw [← Matrix.mul_kronecker_mul, Matrix.mul_one, Matrix.one_mul]

/-- Separate full matrix factors generate every matrix on the product coordinates. -/
theorem eq_top_of_leftTensor_mem_of_rightTensor_mem
    (A : Subalgebra k (Matrix (n × m) (n × m) k))
    (hl : ∀ M : Matrix n n k, leftTensor M ∈ A)
    (hr : ∀ M : Matrix m m k, rightTensor M ∈ A) : A = ⊤ := by
  apply top_unique
  intro M _
  rw [Matrix.matrix_eq_sum_single M]
  apply A.sum_mem
  intro i _
  apply A.sum_mem
  intro j _
  rcases i with ⟨i₁, i₂⟩
  rcases j with ⟨j₁, j₂⟩
  have h := A.mul_mem
    (hl (Matrix.single i₁ j₁ (M (i₁, i₂) (j₁, j₂))))
    (hr (Matrix.single i₂ j₂ (1 : k)))
  rw [leftTensor_mul_rightTensor, Matrix.single_kronecker_single, mul_one] at h
  exact h

variable
  (ρ : MatrixRepresentation (VectorGroup.groupScheme (CommRingCat.of k) 1) n)
  (σ : MatrixRepresentation (VectorGroup.groupScheme (CommRingCat.of k) 1) m)

/-- If the first full matrix factor is available, actual diagonal tensor
coefficients determine every second-factor coefficient by triangular subtraction. -/
theorem rightTensor_coefficientMatrix_mem
    (A : Subalgebra k (Matrix (n × m) (n × m) k))
    (hl : ∀ M : Matrix n n k, leftTensor M ∈ A)
    (hd : ∀ d, coefficientMatrix (ρ.tensor σ) d ∈ A) (d : ℕ) :
    rightTensor (coefficientMatrix σ d) ∈ A := by
  induction d using Nat.strong_induction_on with
  | h d ih =>
    have hs :
        (∑ ab ∈ (antidiagonal d).erase (0, d),
          coefficientMatrix ρ ab.1 ⊗ₖ coefficientMatrix σ ab.2) ∈ A := by
      apply A.sum_mem
      intro ab hab
      obtain ⟨hne, hab⟩ := Finset.mem_erase.mp hab
      have hab' := mem_antidiagonal.mp hab
      have hb : ab.2 < d := by
        by_contra h
        have heq : ab = (0, d) := by
          apply Prod.ext <;> dsimp <;> omega
        exact hne heq
      have h := A.mul_mem (hl (coefficientMatrix ρ ab.1)) (ih ab.2 hb)
      rw [leftTensor_mul_rightTensor] at h
      exact h
    have h := A.sub_mem (hd d) hs
    have hmem : (0, d) ∈ antidiagonal d :=
      mem_antidiagonal.mpr (Nat.zero_add d)
    rw [coefficientMatrix_tensor, ← Finset.sum_erase_add _ _
      hmem, add_sub_cancel_left,
      coefficientMatrix_zero] at h
    exact h

section Families

variable {I : Type v}
  (ρs : I → MatrixRepresentation (VectorGroup.groupScheme (CommRingCat.of k) 1) n)
  (σs : I → MatrixRepresentation (VectorGroup.groupScheme (CommRingCat.of k) 1) m)

/-- The algebra of all actual coefficient matrices of an additive family. -/
def coefficientAlgebra : Subalgebra k (Matrix n n k) :=
  Algebra.adjoin k (Set.range fun q : I × ℕ => coefficientMatrix (ρs q.1) q.2)

/-- The algebra generated by the coefficients below a given degree bound. -/
def truncatedCoefficientAlgebra (N : ℕ) : Subalgebra k (Matrix n n k) :=
  Algebra.adjoin k (Set.range fun q : I × Fin N => coefficientMatrix (ρs q.1) q.2.val)

theorem coefficientMatrix_mem_coefficientAlgebra (i : I) (d : ℕ) :
    coefficientMatrix (ρs i) d ∈ coefficientAlgebra ρs :=
  Algebra.subset_adjoin ⟨(i, d), rfl⟩

variable (p : ℕ) [Fact p.Prime] [CharP k p]

/-- Low-degree fullness of the first family makes its entire matrix factor
available inside the diagonal Frobenius tensor coefficient algebra. -/
theorem leftTensor_mem_of_truncatedCoefficientAlgebra_eq_top (e : ℕ)
    (hfull : truncatedCoefficientAlgebra ρs (p ^ e) = ⊤)
    (A : Subalgebra k (Matrix (n × m) (n × m) k))
    (hd : ∀ i d, coefficientMatrix ((ρs i).tensor ((σs i).frobeniusPower p e)) d ∈ A)
    (M : Matrix n n k) : leftTensor M ∈ A := by
  have hle : truncatedCoefficientAlgebra ρs (p ^ e) ≤ A.comap leftTensor := by
    apply Algebra.adjoin_le
    rintro _ ⟨⟨i, d⟩, rfl⟩
    change coefficientMatrix (ρs i) d.val ⊗ₖ (1 : Matrix m m k) ∈ A
    rw [← coefficientMatrix_tensor_frobeniusPower_of_lt
      (ρs i) (σs i) p e d.val d.isLt]
    exact hd i d.val
  rw [hfull] at hle
  exact hle (show M ∈ (⊤ : Subalgebra k (Matrix n n k)) from by trivial)

/-- Full low coefficients of the first actual family and full coefficients
of the Frobenius-powered second family force full diagonal tensor coefficients. -/
theorem coefficientAlgebra_tensor_frobeniusPower_eq_top (e : ℕ)
    (hfirst : truncatedCoefficientAlgebra ρs (p ^ e) = ⊤)
    (hsecond : coefficientAlgebra (fun i => (σs i).frobeniusPower p e) = ⊤) :
    coefficientAlgebra (fun i => (ρs i).tensor ((σs i).frobeniusPower p e)) = ⊤ := by
  let A := coefficientAlgebra (fun i => (ρs i).tensor ((σs i).frobeniusPower p e))
  have hd : ∀ i d,
      coefficientMatrix ((ρs i).tensor ((σs i).frobeniusPower p e)) d ∈ A :=
    coefficientMatrix_mem_coefficientAlgebra _
  have hl : ∀ M : Matrix n n k, leftTensor M ∈ A :=
    leftTensor_mem_of_truncatedCoefficientAlgebra_eq_top ρs σs p e hfirst A hd
  have hrcoeff : ∀ i d,
      rightTensor (coefficientMatrix ((σs i).frobeniusPower p e) d) ∈ A := by
    intro i d
    exact rightTensor_coefficientMatrix_mem (ρs i) ((σs i).frobeniusPower p e)
      A hl (hd i) d
  have hle : coefficientAlgebra (fun i => (σs i).frobeniusPower p e) ≤
      A.comap rightTensor := by
    apply Algebra.adjoin_le
    rintro _ ⟨⟨i, d⟩, rfl⟩
    exact hrcoeff i d
  rw [hsecond] at hle
  exact eq_top_of_leftTensor_mem_of_rightTensor_mem A hl
    (fun M => hle (show M ∈ (⊤ : Subalgebra k (Matrix m m k)) from by trivial))

end Families

end Langlands.GroupScheme.MatrixRepresentation.AdditiveTensorAlgebra
