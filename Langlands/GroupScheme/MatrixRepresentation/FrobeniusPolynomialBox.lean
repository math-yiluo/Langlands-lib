import Langlands.Algebra.PolynomialBoxQuotient
import Langlands.GroupScheme.MatrixRepresentation.FrobeniusPower

/-! # Polynomial boxes and Frobenius neighborhoods of the origin -/

noncomputable section

universe u

namespace Langlands.GroupScheme.MatrixRepresentation.FrobeniusPolynomialBox

open MvPolynomial
open Langlands.Algebra.PolynomialBoxQuotient

variable {k : Type u} [Field k] (p : ℕ) [ExpChar k p] (d r : ℕ)

/-- The constant coordinate bound `p^r - 1`. -/
def bound : Fin d →₀ ℕ :=
  Finsupp.onFinset Finset.univ (fun _ => p ^ r - 1) (by simp)

@[simp]
theorem bound_apply (i : Fin d) : bound p d r i = p ^ r - 1 := rfl

include k in
theorem bound_add_one (i : Fin d) : bound p d r i + 1 = p ^ r := by
  rw [bound_apply, Nat.sub_add_cancel]
  exact Nat.one_le_iff_ne_zero.mpr (pow_ne_zero _ (expChar_ne_zero k p))

section NilpotentEvaluation

variable {A : Type u} [CommRing A] [Algebra k A]

/-- On a tuple annihilated by the characteristic power, that power of every
polynomial value is the corresponding power of its origin value. -/
theorem aeval_pow_eq_origin (t : Fin d → A) (ht : ∀ i, t i ^ p ^ r = 0)
    (P : MvPolynomial (Fin d) k) :
    MvPolynomial.aeval t P ^ p ^ r =
      algebraMap k A (P.coeff 0) ^ p ^ r := by
  let F := characteristicPowerMap k p A r
  have he : F.comp (MvPolynomial.aeval t).toRingHom =
      (F.comp (algebraMap k A)).comp MvPolynomial.constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.aeval_C, MvPolynomial.constantCoeff_C]
    · intro i
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, map_zero, F,
        characteristicPowerMap_apply, ht i]
  exact RingHom.congr_fun he P

/-- Nilpotence of the coordinate tuple is equivalent to the characteristic
power vanishing on every polynomial with zero origin value. -/
theorem forall_aeval_pow_eq_zero_iff (t : Fin d → A) :
    (∀ P : MvPolynomial (Fin d) k, P.coeff 0 = 0 →
      MvPolynomial.aeval t P ^ p ^ r = 0) ↔
        ∀ i, t i ^ p ^ r = 0 := by
  constructor
  · intro h i
    have hi : (MvPolynomial.X i : MvPolynomial (Fin d) k).coeff 0 = 0 := by
      exact MvPolynomial.constantCoeff_X k i
    simpa only [MvPolynomial.aeval_X] using h (MvPolynomial.X i) hi
  · intro ht P hP
    rw [aeval_pow_eq_origin p d r t ht P, hP, map_zero]
    exact zero_pow (pow_ne_zero _ (expChar_ne_zero k p))

end NilpotentEvaluation

/-- The image of the actual origin ideal under the iterated characteristic-power
ring endomorphism: the ideal generated by powers of all origin-vanishing coordinates. -/
def originFrobeniusIdeal : Ideal (MvPolynomial (Fin d) k) :=
  (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin d) k →+* k)).map
    (characteristicPowerMap k p (MvPolynomial (Fin d) k) r)

/-- The Frobenius origin ideal is exactly the ideal of the characteristic box. -/
theorem originFrobeniusIdeal_eq_boxIdeal :
    originFrobeniusIdeal (k := k) p d r = boxIdeal (k := k) (bound p d r) := by
  apply le_antisymm
  · rw [originFrobeniusIdeal, Ideal.map_le_iff_le_comap]
    intro P hP
    change P ^ p ^ r ∈ boxIdeal (k := k) (bound p d r)
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change Ideal.Quotient.mkₐ k (boxIdeal (bound p d r)) (P ^ p ^ r) = 0
    rw [map_pow, ← aeval_parameter]
    have ht (i : Fin d) : parameter (k := k) (bound p d r) i ^ p ^ r = 0 := by
      rw [← bound_add_one (k := k) p d r i]
      exact parameter_pow _ _
    rw [aeval_pow_eq_origin p d r _ ht P]
    have hP0 : P.coeff 0 = 0 := hP
    rw [hP0, map_zero]
    exact zero_pow (pow_ne_zero _ (expChar_ne_zero k p))
  · rw [boxIdeal_eq_span, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ (bound p d r i + 1) ∈
      originFrobeniusIdeal p d r
    rw [bound_add_one (k := k) p d r i]
    have hi :
        (MvPolynomial.X i : MvPolynomial (Fin d) k) ∈
          RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin d) k →+* k) :=
      MvPolynomial.constantCoeff_X k i
    exact Ideal.mem_map_of_mem (characteristicPowerMap k p (MvPolynomial (Fin d) k) r) hi

/-- The actual quotient by the Frobenius image of the origin ideal has the
explicit polynomial box model. -/
def originQuotientEquiv :
    (MvPolynomial (Fin d) k ⧸ originFrobeniusIdeal (k := k) p d r) ≃ₐ[k]
      boxAlgebra (k := k) (bound p d r) :=
  Ideal.quotientEquivAlgOfEq k (originFrobeniusIdeal_eq_boxIdeal p d r)

/-- Its dimension is the expected characteristic power in the number of coordinates. -/
theorem finrank_originQuotient :
    Module.finrank k
      (MvPolynomial (Fin d) k ⧸ originFrobeniusIdeal (k := k) p d r) =
        (p ^ r) ^ d := by
  classical
  rw [(originQuotientEquiv (k := k) p d r).toLinearEquiv.finrank_eq,
    finrank_boxAlgebra]
  calc
    ∏ i ∈ (bound p d r).support, (bound p d r i + 1) =
        ∏ i : Fin d, (bound p d r i + 1) := by
      apply Finset.prod_subset (Finset.subset_univ _)
      intro i _ hi
      rw [Finsupp.notMem_support_iff.mp hi]
      rfl
    _ = (p ^ r) ^ d := by simp only [bound_add_one (k := k), Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]

end Langlands.GroupScheme.MatrixRepresentation.FrobeniusPolynomialBox
