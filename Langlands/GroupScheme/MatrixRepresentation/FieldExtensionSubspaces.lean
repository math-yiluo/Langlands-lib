import Langlands.GroupScheme.MatrixRepresentation.ScalarExtensionStableSubspaces
import Langlands.GroupScheme.Rational.ValuedRepresentationBaseChange
import Langlands.GroupScheme.MatrixRepresentation.CompositionFactors
import Langlands.GroupScheme.MatrixRepresentation.RationalIrreducibility
import Langlands.GroupScheme.Absolute.AlgebraicClosureBaseChange

/-! # Scalar extension of actual stable subspaces -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped Matrix CategoryTheory.MonObj

namespace Langlands.GroupScheme.MatrixRepresentation

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

omit [IsAffineHom G.X.hom] [DecidableEq m] in
/-- Split invariant coordinates extend along the field map. -/
theorem IsStableCoordinates.baseChange {ρ : MatrixRepresentation G n}
    {B : Matrix n m k} {C : Matrix m n k} (h : ρ.IsStableCoordinates B C) :
    (ρ.baseChange (Spec.map (CommRingCat.ofHom (algebraMap k K)))).IsStableCoordinates
      (B.map (algebraMap k K)) (C.map (algebraMap k K)) := by
  intro T x
  have hh := h ((Over.map (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj T)
    (baseChangePointsEquiv (Spec.map (CommRingCat.ofHom (algebraMap k K))) G T x)
  have hB : (B.map (algebraMap k K)).map (scalarMap T) =
      B.map (scalarMap ((Over.map
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj T)) := by
    ext i j
    exact (scalarMap_overMap_specMap (algebraMap k K) T _).symm
  have hC : (C.map (algebraMap k K)).map (scalarMap T) =
      C.map (scalarMap ((Over.map
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj T)) := by
    ext i j
    exact (scalarMap_overMap_specMap (algebraMap k K) T _).symm
  rw [hB, hC, pointMatrix_baseChange]
  exact hh

namespace FieldExtensionSubspaces

/-- The new-field subspace generated by the original vectors. -/
def scalarExtension (W : Submodule k (n → k)) : Submodule K (n → K) :=
  Langlands.LinearAlgebra.GaloisPiDescent.scalarExtension W

omit [Fintype n] [DecidableEq n] in
/-- Every coefficient vector of a vector in an extended subspace is in the
original subspace. -/
theorem coefficients_mem {W : Submodule k (n → k)} {v : n → K}
    (hv : v ∈ scalarExtension (K := K) W) (ℓ : K →ₗ[k] k) :
    (fun i => ℓ (v i)) ∈ W :=
  Langlands.LinearAlgebra.GaloisPiDescent.linearFunctional_mem_scalarExtension hv ℓ

omit [Fintype n] [DecidableEq n] in
/-- Membership of an original vector is reflected by scalar extension. -/
theorem mem_scalarExtension_iff (W : Submodule k (n → k)) (v : n → k) :
    (fun i => algebraMap k K (v i)) ∈ scalarExtension (K := K) W ↔ v ∈ W := by
  constructor
  · intro hv
    obtain ⟨ℓ, hℓ⟩ := Module.Projective.exists_dual_eq_one k (one_ne_zero : (1 : K) ≠ 0)
    have h := coefficients_mem hv ℓ
    convert h using 1
    funext i
    have hh := ℓ.map_smul (v i) (1 : K)
    simpa [Algebra.smul_def, hℓ] using hh.symm
  · intro hv
    exact Submodule.subset_span ⟨v, hv, rfl⟩

omit [DecidableEq n] [DecidableEq m] in
/-- Split inclusion coordinates describe the extended subspace by the same
inclusion matrix over the new field. -/
theorem scalarExtension_eq_range (W : Submodule k (n → k))
    (B : Matrix n m k) (C : Matrix m n k)
    (hcols : ∀ j, (fun i => B i j) ∈ W)
    (hproj : ∀ v, v ∈ W → (B * C) *ᵥ v = v) :
    scalarExtension (K := K) W =
      LinearMap.range (B.map (algebraMap k K)).mulVecLin := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨v, hv, rfl⟩
    refine ⟨fun i => algebraMap k K ((C *ᵥ v) i), ?_⟩
    funext i
    change (B.map (algebraMap k K) *ᵥ
      (fun j => algebraMap k K ((C *ᵥ v) j))) i = algebraMap k K (v i)
    calc
      _ = algebraMap k K ((B *ᵥ (C *ᵥ v)) i) :=
        ((algebraMap k K).map_mulVec B (C *ᵥ v) i).symm
      _ = algebraMap k K (v i) := by rw [Matrix.mulVec_mulVec, hproj v hv]
  · rw [Matrix.range_mulVecLin]
    apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact Submodule.subset_span ⟨_, hcols j, rfl⟩

end FieldExtensionSubspaces

open FieldExtensionSubspaces

/-- Simplicity of an actual representation descends along every field extension. -/
theorem IsIrreducible.of_baseChange {ρ : MatrixRepresentation G n}
    (hρ : (ρ.baseChange
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))).IsIrreducible) :
    ρ.IsIrreducible := by
  let := hρ.nonempty_coordinates
  refine ⟨inferInstance, fun W hW => ?_⟩
  rcases hρ.2 (scalarExtension (K := K) W) hW.scalarExtension with h | h
  · left
    apply le_antisymm ?_ bot_le
    intro v hv
    have hm := (mem_scalarExtension_iff (K := K) W v).mpr hv
    rw [h] at hm
    change (fun i => algebraMap k K (v i)) = 0 at hm
    change v = 0
    funext i
    exact (algebraMap k K).injective
      ((congrFun hm i).trans (map_zero _).symm)
  · right
    apply top_unique
    intro v _
    apply (mem_scalarExtension_iff (K := K) W v).mp
    rw [h]
    trivial

end Langlands.GroupScheme.MatrixRepresentation
