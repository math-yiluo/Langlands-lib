import Langlands.GroupScheme.MatrixRepresentation.FrobeniusDistributionSeparation
import Mathlib.Data.List.FinRange

/-! # Ordered products in the actual Frobenius distribution algebra -/

noncomputable section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix

namespace Langlands.GroupScheme.MatrixRepresentation.FrobeniusOrderedConvolution

open FrobeniusCoordinateModel FrobeniusPolynomialBox FrobeniusOrderedDistributions
open FrobeniusConvolutionAction FrobeniusDistributionSeparation
open OrderedAdditiveCoordinates OrderedAdditiveTruncation AdditiveDividedPowers

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (.of k))} [IsAffineHom G.X.hom]
    (p : ℕ) [ExpChar k p] (r : ℕ) {d : ℕ}
    (x : Fin d → (VectorGroup.groupScheme (.of k) 1 ⟶ G))
    (hx : Function.Bijective (coordinateMap x))

/-- The actual ordered coefficient basis with the convolution algebra type. -/
def convolutionBasis :
    Module.Basis (Set.Iic (bound p d r)) k (DistributionAlgebra (G := G) p r) :=
  (distributionBasis p r x hx).map (WithConv.linearEquiv k _).symm

@[simp]
theorem convolutionBasis_ofConv (b : Set.Iic (bound p d r)) :
    (convolutionBasis p r x hx b).ofConv = distributionBasis p r x hx b := rfl

/-- Retain only one axis exponent of a bounded ordered multi-index. -/
def axisExponent (b : Set.Iic (bound p d r)) (i : Fin d) :
    Set.Iic (bound p d r) :=
  ⟨Finsupp.single i (b.val i), by
    intro j
    by_cases h : i = j
    · subst j
      simpa only [Finsupp.single_eq_same] using b.property i
    · rw [Finsupp.single_eq_of_ne (Ne.symm h)]
      exact Nat.zero_le _⟩

variable {n : Type} [Fintype n] [DecidableEq n]
    (ρ : MatrixRepresentation G n)

/-- The convolution coefficient basis retains the exact original action. -/
theorem actionAlgHom_convolutionBasis (b : Set.Iic (bound p d r)) :
    actionAlgHom p r ρ (convolutionBasis p r x hx b) =
      coefficientOperator ρ x b.val := by
  exact distributionAction_basis p r x hx ρ b

omit [IsAffineHom G.X.hom] [ExpChar k p] in
/-- A one-axis coefficient acts by the corresponding restricted divided power. -/
theorem coefficientOperator_axisExponent (b : Set.Iic (bound p d r)) (i : Fin d) :
    coefficientOperator ρ x (axisExponent p r b i).val =
      dividedPower (ρ.restrict (x i)) (b.val i) := by
  classical
  rw [coefficientOperator, List.ofFn_eq_map]
  have h := List.prod_map_eq_pow_single (l := List.finRange d) i
    (fun j => dividedPower (ρ.restrict (x j)) ((axisExponent p r b i).val j))
    (by
      intro j hji _
      change dividedPower (ρ.restrict (x j)) (Finsupp.single i (b.val i) j) = 1
      rw [Finsupp.single_eq_of_ne hji, dividedPower_zero])
  simpa only [List.count_finRange, pow_one, axisExponent, Finsupp.single_eq_same] using h

/-- Every ordered coefficient distribution is the product, in the same fixed
order, of its one-axis coefficient distributions in the actual algebra. -/
theorem convolutionBasis_eq_orderedProduct (b : Set.Iic (bound p d r)) :
    convolutionBasis p r x hx b =
      (List.ofFn fun i => convolutionBasis p r x hx (axisExponent p r b i)).prod := by
  apply distribution_ext_of_actionAlgHom p r
  intro N σ
  rw [actionAlgHom_convolutionBasis]
  simp only [map_list_prod, List.map_ofFn, Function.comp_def,
    actionAlgHom_convolutionBasis, coefficientOperator_axisExponent]
  rfl

/-- The constant coefficient distribution is the convolution unit. -/
theorem convolutionBasis_zero :
    convolutionBasis p r x hx ⟨0, by intro i; exact Nat.zero_le _⟩ = 1 := by
  apply distribution_ext_of_actionAlgHom p r
  intro N σ
  rw [actionAlgHom_convolutionBasis, map_one]
  simp [coefficientOperator]

/-- The subalgebra generated by the retained one-axis coefficient distributions. -/
def axisSubalgebra : Subalgebra k (DistributionAlgebra (G := G) p r) :=
  Algebra.adjoin k (Set.range fun bi : Set.Iic (bound p d r) × Fin d =>
    convolutionBasis p r x hx (axisExponent p r bi.1 bi.2))

/-- One-axis distributions generate the full actual convolution algebra. -/
theorem axisSubalgebra_eq_top : axisSubalgebra p r x hx = ⊤ := by
  have hspan : (⊤ : Submodule k (DistributionAlgebra (G := G) p r)) ≤
      (axisSubalgebra p r x hx).toSubmodule := by
    rw [← (convolutionBasis p r x hx).span_eq, Submodule.span_le]
    rintro _ ⟨b, rfl⟩
    change convolutionBasis p r x hx b ∈ axisSubalgebra p r x hx
    rw [convolutionBasis_eq_orderedProduct]
    apply Subalgebra.list_prod_mem
    intro a ha
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ha
    exact Algebra.subset_adjoin ⟨(b, i), rfl⟩
  apply top_unique
  intro a _
  exact hspan (Submodule.mem_top)

end Langlands.GroupScheme.MatrixRepresentation.FrobeniusOrderedConvolution
