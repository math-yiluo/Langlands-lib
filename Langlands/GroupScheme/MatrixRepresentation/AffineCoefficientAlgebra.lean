import Langlands.GroupScheme.MatrixRepresentation.AffineCoefficients
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Centralizer

/-! # The operator algebra of an affine matrix representation -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped Matrix CategoryTheory.MonObj

namespace Langlands.GroupScheme.MatrixRepresentation.AffineCoefficientAlgebra

open AffineCoefficients

variable {k : Type u} [Field k]
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  {n : Type} [Fintype n] [DecidableEq n]
  (ρ : MatrixRepresentation G n)

/-- The finite-dimensional operator algebra generated by universal coefficients. -/
def operatorAlgebra : Subalgebra k (Module.End k (n → k)) :=
  Algebra.adjoin k (Set.range fun ℓ => (coefficientMap ρ ℓ).mulVecLin)

/-- The endomorphisms preserving a ground-field subspace form an algebra. -/
def preservingAlgebra (W : Submodule k (n → k)) :
    Subalgebra k (Module.End k (n → k)) where
  carrier := {f | ∀ v ∈ W, f v ∈ W}
  algebraMap_mem' c := fun _ hv => W.smul_mem c hv
  add_mem' hf hg := fun v hv => W.add_mem (hf v hv) (hg v hv)
  mul_mem' hf hg := fun v hv => hf _ (hg v hv)

/-- All-test stability is stability under the generated operator algebra. -/
theorem isStableSubspace_iff (W : Submodule k (n → k)) :
    ρ.IsStableSubspace W ↔ operatorAlgebra ρ ≤ preservingAlgebra W := by
  rw [AffineCoefficients.isStableSubspace_iff, operatorAlgebra, Algebra.adjoin_le_iff]
  constructor
  · rintro h _ ⟨ℓ, rfl⟩
    exact h ℓ
  · intro h ℓ
    exact h ⟨ℓ, rfl⟩

/-- Every operator submodule is an actual stable subspace. -/
theorem stable_restrictScalars (W : Submodule (operatorAlgebra ρ) (n → k)) :
    ρ.IsStableSubspace (W.restrictScalars k) := by
  rw [isStableSubspace_iff]
  intro f hf v hv
  exact W.smul_mem ⟨f, hf⟩ hv

/-- An irreducible actual representation is simple for its operator algebra. -/
theorem isSimpleModule (hρ : ρ.IsIrreducible) :
    IsSimpleModule (operatorAlgebra ρ) (n → k) := by
  let : Nontrivial (n → k) := hρ.1
  refine { eq_bot_or_eq_top := fun W => ?_ }
  rcases hρ.2 (W.restrictScalars k) (stable_restrictScalars ρ W) with h | h
  · left
    exact (Submodule.restrictScalars_eq_bot_iff k _ _).mp h
  · right
    exact (Submodule.restrictScalars_eq_top_iff k _ _).mp h

omit [IsAffineHom G.X.hom] [DecidableEq n] in
/-- Taking a linear coefficient commutes with multiplication on the left by a
constant matrix. -/
theorem map_mul_left {A : Type u} [CommRing A] [Algebra k A]
    (C : Matrix n n k) (M : Matrix n n A) (ℓ : A →ₗ[k] k) :
    (C.map (algebraMap k A) * M).map ℓ = C * M.map ℓ := by
  ext i j
  have hs (c : k) (a : A) : ℓ (algebraMap k A c * a) = c * ℓ a := by
    rw [← Algebra.smul_def, map_smul, smul_eq_mul]
  simp only [Matrix.map_apply, Matrix.mul_apply, map_sum, hs]

omit [IsAffineHom G.X.hom] [DecidableEq n] in
/-- Taking a linear coefficient commutes with multiplication on the right by a
constant matrix. -/
theorem map_mul_right {A : Type u} [CommRing A] [Algebra k A]
    (C : Matrix n n k) (M : Matrix n n A) (ℓ : A →ₗ[k] k) :
    (M * C.map (algebraMap k A)).map ℓ = M.map ℓ * C := by
  ext i j
  have hs (a : A) (c : k) : ℓ (a * algebraMap k A c) = ℓ a * c := by
    rw [mul_comm, ← Algebra.smul_def, map_smul, smul_eq_mul, mul_comm]
  simp only [Matrix.map_apply, Matrix.mul_apply, map_sum, hs]

/-- Actual intertwiners commute with precisely the universal coefficient matrices. -/
theorem intertwines_iff (C : Matrix n n k) :
    Intertwines ρ ρ C ↔ ∀ ℓ, C * coefficientMap ρ ℓ = coefficientMap ρ ℓ * C := by
  constructor
  · intro h ℓ
    have hh := congrArg (fun M : Matrix n n (CharacterUnits.Coord G) => M.map ℓ)
      (h (CharacterUnits.Coord G) (CharacterUnits.universalPoint G))
    rw [map_mul_left, map_mul_right] at hh
    convert hh using 1 <;> rfl
  · intro h A x
    ext i j
    apply sub_eq_zero.mp
    apply (Module.forall_dual_apply_eq_zero_iff k _).mp
    intro ℓ
    have hh := h (ℓ.comp (Lie.pointCoordinates G x).toLinearMap)
    have he : coefficientMap ρ (ℓ.comp (Lie.pointCoordinates G x).toLinearMap) =
        (ρ.affineMatrix A x : Matrix n n A).map ℓ := by
      rw [coefficientMap, ← universalCharacterMatrix_map]
      rfl
    rw [he] at hh
    have hh' := congrArg (fun M : Matrix n n k => M i j) hh
    rw [map_sub]
    exact sub_eq_zero.mpr (by
      simpa only [← map_mul_left, ← map_mul_right, Matrix.map_apply] using hh')

end Langlands.GroupScheme.MatrixRepresentation.AffineCoefficientAlgebra
