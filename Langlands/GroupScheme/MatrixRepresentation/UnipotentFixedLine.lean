import Langlands.GroupScheme.MatrixRepresentation.InvariantCoordinates

/-! # Stable coordinate lines of unipotent group schemes -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped Matrix

namespace Langlands.GroupScheme.MatrixRepresentation

section Coordinates

variable {k : Type u} [CommRing k]
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {n : Type} [Fintype n] [DecidableEq n]

/-- The inclusion of the coordinate line generated by the `j`th unit vector. -/
def coordinateLineInclusion (j : n) : Matrix n PUnit.{1} k :=
  fun r _ => (Pi.single j (1 : k) : n → k) r

/-- Retraction onto the `j`th coordinate. -/
def coordinateLineRetraction (j : n) : Matrix PUnit.{1} n k :=
  fun _ r => (Pi.single j (1 : k) : n → k) r

theorem coordinateLineRetraction_mul_inclusion (j : n) :
    coordinateLineRetraction (k := k) j * coordinateLineInclusion (k := k) j = 1 := by
  ext r s
  simp [coordinateLineRetraction, coordinateLineInclusion, Matrix.mul_apply,
    Pi.single_apply]

/-- A coordinate line invariant up to scalar on every test gives split stable
coordinates. The scalar need not be a unit. -/
theorem isStableCoordinates_coordinateLine (ρ : MatrixRepresentation G n) (j : n)
    (hs : ∀ (T : Over (Spec (CommRingCat.of k))) (x : T ⟶ G.X),
      ∃ a : Γ(T.left, ⊤),
        (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) *ᵥ Pi.single j 1 =
          a • (Pi.single j (1 : Γ(T.left, ⊤)) : n → Γ(T.left, ⊤))) :
    ρ.IsStableCoordinates (coordinateLineInclusion j) (coordinateLineRetraction j) := by
  intro T x
  obtain ⟨a, ha⟩ := hs T x
  have hB : (coordinateLineInclusion (k := k) j).map (scalarMap T) =
      coordinateLineInclusion (k := Γ(T.left, ⊤)) j := by
    ext r s
    by_cases h : r = j <;> simp [coordinateLineInclusion, h]
  have hAB : (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) *
      (coordinateLineInclusion (k := k) j).map (scalarMap T) =
      a • (coordinateLineInclusion (k := k) j).map (scalarMap T) := by
    rw [hB]
    ext r s
    simpa [coordinateLineInclusion, Matrix.mul_apply, Matrix.mulVec, dotProduct]
      using congrFun ha r
  have hCB : (coordinateLineRetraction (k := k) j).map (scalarMap T) *
      (coordinateLineInclusion (k := k) j).map (scalarMap T) = 1 := by
    rw [← Matrix.map_mul, coordinateLineRetraction_mul_inclusion,
      Matrix.map_one _ (map_zero _) (map_one _)]
  rw [Matrix.mul_assoc, hAB, Matrix.mul_smul, hCB, Matrix.mul_smul,
    Matrix.mul_one]

/-- The actual representation on an all-test stable coordinate line. -/
def coordinateLineRepresentation (ρ : MatrixRepresentation G n) (j : n)
    (hs : ∀ (T : Over (Spec (CommRingCat.of k))) (x : T ⟶ G.X),
      ∃ a : Γ(T.left, ⊤),
        (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) *ᵥ Pi.single j 1 =
          a • (Pi.single j (1 : Γ(T.left, ⊤)) : n → Γ(T.left, ⊤))) :
    MatrixRepresentation G PUnit :=
  ρ.restrictCoordinates (coordinateLineInclusion j) (coordinateLineRetraction j)
    (coordinateLineRetraction_mul_inclusion j) (ρ.isStableCoordinates_coordinateLine j hs)

end Coordinates

variable {k : Type u} [Field k]
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {n : Type} [Fintype n] [DecidableEq n]

/-- A stable coordinate line for a unipotent group is fixed pointwise over the
original field and on every relative scheme test. -/
theorem isFixedVector_single_of_isUnipotent (ρ : MatrixRepresentation G n)
    (hG : IsUnipotent G) (j : n)
    (hs : ∀ (T : Over (Spec (CommRingCat.of k))) (x : T ⟶ G.X),
      ∃ a : Γ(T.left, ⊤),
        (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) *ᵥ Pi.single j 1 =
          a • (Pi.single j (1 : Γ(T.left, ⊤)) : n → Γ(T.left, ⊤))) :
    ρ.IsFixedVector (Pi.single j 1) := by
  obtain ⟨v, hv, hfix⟩ := hG PUnit (ρ.coordinateLineRepresentation j hs)
  have hv0 : v PUnit.unit ≠ 0 := by
    intro h
    apply hv
    funext r
    simpa only [Subsingleton.elim r PUnit.unit, Pi.zero_apply] using h
  have hBv : ρ.IsFixedVector (coordinateLineInclusion j *ᵥ v) :=
    ρ.isFixedVector_mulVec_restrictCoordinates _ _ _ _ hfix
  have hscale : (v PUnit.unit)⁻¹ • (coordinateLineInclusion j *ᵥ v) =
      Pi.single j (1 : k) := by
    funext r
    by_cases h : r = j <;>
      simp [coordinateLineInclusion, Matrix.mulVec, dotProduct, h, hv0]
  rw [← hscale]
  exact ρ.fixedSubmodule.smul_mem _ hBv

end Langlands.GroupScheme.MatrixRepresentation
