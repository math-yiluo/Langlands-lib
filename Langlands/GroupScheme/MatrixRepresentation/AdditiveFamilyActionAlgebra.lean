import Langlands.GroupScheme.MatrixRepresentation.AdditiveInvariantSubspaces
import Langlands.GroupScheme.MatrixRepresentation.DenseRationalStability
import Langlands.GroupScheme.Reductive.SplitLeviGluingGeneratedDensity
import Langlands.GroupScheme.FlagCoreTorus
import Langlands.GroupScheme.CorepresentedSmooth
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-! # Action algebras of supplied additive-group families -/

noncomputable section

universe u v

open CategoryTheory Opposite AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix

namespace Langlands.GroupScheme.MatrixRepresentation.AdditiveFamilyActionAlgebra

open AdditiveRestrictedOperators VectorGroupPolynomial

variable {k : Type u} [Field k] {I : Type v}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {n : Type} [Fintype n] [DecidableEq n]
  (ρ : MatrixRepresentation G n)
  (f : I → (VectorGroup.groupScheme (CommRingCat.of k) 1 ⟶ G))

/-- The unital endomorphism algebra generated by the p-power coefficients of
the actual restrictions to a supplied family of additive groups. -/
def coefficientAlgebra (p : ℕ) : Subalgebra k (Module.End k (n → k)) :=
  Algebra.adjoin k (Set.range fun q : I × ℕ =>
    pPowerOperator (ρ.restrict (f q.1)) p q.2)

/-- The defining generators detect containment of the family coefficient algebra. -/
theorem coefficientAlgebra_le_iff (p : ℕ)
    (A : Subalgebra k (Module.End k (n → k))) :
    coefficientAlgebra ρ f p ≤ A ↔
      ∀ i r, pPowerOperator (ρ.restrict (f i)) p r ∈ A := by
  constructor
  · intro h i r
    exact h (Algebra.subset_adjoin ⟨(i, r), rfl⟩)
  · intro h
    apply Algebra.adjoin_le
    rintro _ ⟨⟨i, r⟩, rfl⟩
    exact h i r

variable (p : ℕ) [Fact p.Prime] [CharP k p]

/-- Invariance under the family algebra is exactly stability on every affine
test under each supplied additive subgroup, with no infinitude assumption. -/
theorem invariant_coefficientAlgebra_iff (W : Submodule k (n → k)) :
    (∀ a ∈ coefficientAlgebra ρ f p, ∀ v ∈ W, a v ∈ W) ↔
      ∀ i, (ρ.restrict (f i)).IsStableSubspace W := by
  constructor
  · intro h i
    apply (AdditiveInvariantSubspaces.isStableSubspace_iff_invariant_pPowerOperator
      (ρ.restrict (f i)) p W).mpr
    intro r v hv
    exact h _ (Algebra.subset_adjoin ⟨(i, r), rfl⟩) v hv
  · intro h
    let A : Subalgebra k (Module.End k (n → k)) :=
      { carrier := {a | ∀ v ∈ W, a v ∈ W}
        algebraMap_mem' := by
          intro c v hv
          exact W.smul_mem c hv
        add_mem' := by
          intro a b ha hb v hv
          exact W.add_mem (ha v hv) (hb v hv)
        mul_mem' := by
          intro a b ha hb v hv
          exact ha _ (hb v hv) }
    have hle : coefficientAlgebra ρ f p ≤ A := by
      apply (coefficientAlgebra_le_iff ρ f p A).mpr
      intro i r
      exact (AdditiveInvariantSubspaces.isStableSubspace_iff_invariant_pPowerOperator
        (ρ.restrict (f i)) p W).mp (h i) r
    exact fun a ha => hle ha

omit [Fact p.Prime] [CharP k p] in
/-- The affine point operator of a restriction is the actual ambient rational
action through the canonical identification of the two base tests. -/
theorem pointOperator_eq_rationalAction (i : I)
    (x : (algSpec (CommRingCat.of k)).obj (op (CommAlgCat.of k k)) ⟶
      (VectorGroup.groupScheme (CommRingCat.of k) 1).X) :
    pointOperator (ρ.restrict (f i)) x =
      ρ.rationalAction ((FlagCore.baseAffineTestIso.hom ≫ x) ≫ (f i).hom.hom) := by
  apply LinearMap.ext
  intro v
  change ((ρ.restrict (f i)).affineMatrix (CommAlgCat.of k k) x :
      Matrix n n k) *ᵥ v =
    (ρ.rationalMatrix ((FlagCore.baseAffineTestIso.hom ≫ x) ≫
      (f i).hom.hom) : Matrix n n k) *ᵥ v
  rw [← rationalMatrix_restrict, FlagCore.rationalMatrix_baseAffineTestIso]

/-- Over an infinite field, each supplied source's actual rational actions
belong to the family coefficient algebra. -/
theorem rationalAction_comp_mem_coefficientAlgebra [Infinite k] (i : I)
    (y : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶
      (VectorGroup.groupScheme (CommRingCat.of k) 1).X) :
    ρ.rationalAction (y ≫ (f i).hom.hom) ∈ coefficientAlgebra ρ f p := by
  have hle : Algebra.adjoin k (Set.range (pointOperator (ρ.restrict (f i)))) ≤
      coefficientAlgebra ρ f p := by
    rw [adjoin_range_pointOperator_eq_adjoin_range_pPowerOperator
      (ρ.restrict (f i)) p]
    apply Algebra.adjoin_le
    rintro _ ⟨r, rfl⟩
    exact Algebra.subset_adjoin ⟨(i, r), rfl⟩
  have hy : ρ.rationalAction (y ≫ (f i).hom.hom) =
      pointOperator (ρ.restrict (f i)) (FlagCore.baseAffineTestIso.inv ≫ y) := by
    rw [pointOperator_eq_rationalAction]
    simp only [Iso.hom_inv_id_assoc]
  rw [hy]
  exact hle (Algebra.subset_adjoin ⟨_, rfl⟩)

/-- Over an infinite field, the family coefficients generate exactly the
algebra of the actual rational actions of the generated rational-point group. -/
theorem coefficientAlgebra_eq_adjoin_generatedRationalAction [Infinite k] :
    coefficientAlgebra ρ f p =
      Algebra.adjoin k (Set.range fun g :
        LeviGluing.generatedRationalPoints G
          (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f =>
        ρ.rationalAction g.val) := by
  let Γ := LeviGluing.generatedRationalPoints G
    (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f
  apply le_antisymm
  · apply (coefficientAlgebra_le_iff ρ f p _).mpr
    intro i r
    have hle : Algebra.adjoin k (Set.range (pointOperator (ρ.restrict (f i)))) ≤
        Algebra.adjoin k (Set.range fun g : Γ => ρ.rationalAction g.val) := by
      apply Algebra.adjoin_le
      rintro _ ⟨x, rfl⟩
      rw [pointOperator_eq_rationalAction]
      apply Algebra.subset_adjoin
      refine ⟨⟨_, ?_⟩, rfl⟩
      apply Subgroup.subset_closure
      exact Set.mem_iUnion.mpr
        ⟨i, SubgroupFunctor.mem_range.mpr ⟨FlagCore.baseAffineTestIso.hom ≫ x, rfl⟩⟩
    rw [adjoin_range_pointOperator_eq_adjoin_range_pPowerOperator
      (ρ.restrict (f i)) p] at hle
    exact hle (Algebra.subset_adjoin ⟨r, rfl⟩)
  · apply Algebra.adjoin_le
    rintro _ ⟨g, rfl⟩
    have hgen : ∀ (x : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X),
        x ∈ Γ → ρ.rationalAction x ∈ coefficientAlgebra ρ f p := by
      intro x hx
      change x ∈ Subgroup.closure _ at hx
      induction hx using Subgroup.closure_induction'' with
      | mem x hx =>
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
        obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hi
        exact rationalAction_comp_mem_coefficientAlgebra ρ f p i y
      | inv_mem x hx =>
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
        obtain ⟨y, hy⟩ := SubgroupFunctor.mem_range.mp
          (((SubgroupFunctor.range (f i)).carrier _).inv_mem hi)
        rw [← hy]
        exact rationalAction_comp_mem_coefficientAlgebra ρ f p i y
      | one =>
        rw [map_one]
        exact (coefficientAlgebra ρ f p).one_mem
      | mul x y _ _ hx hy =>
        rw [map_mul]
        exact (coefficientAlgebra ρ f p).mul_mem hx hy
    exact hgen g.val g.property

/-- With reduced ambient group and a dense generated rational-point family,
the coefficient algebra detects ambient stability on every affine test. -/
theorem isStableSubspace_iff_invariant_coefficientAlgebra [Infinite k]
    [IsReduced G.X.left]
    (hdense : Langlands.AlgebraicGeometry.PointTopology.HasDenseRationalPointFamily
      (fun g : LeviGluing.generatedRationalPoints G
        (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f => g.val))
    (W : Submodule k (n → k)) :
    ρ.IsStableSubspace W ↔
      ∀ a ∈ coefficientAlgebra ρ f p, ∀ v ∈ W, a v ∈ W := by
  constructor
  · intro hW
    apply (invariant_coefficientAlgebra_iff ρ f p W).mpr
    intro i A x v hv ℓ
    change (fun j => ℓ ((((ρ.restrict (f i)).affineMatrix A x : Matrix n n A) *ᵥ
      (fun a => algebraMap k A (v a))) j)) ∈ W
    rw [affineMatrix_restrict]
    exact hW A (x ≫ (f i).hom.hom) v hv ℓ
  · intro h
    apply isStableSubspace_of_denseRationalFamily ρ _ hdense W
    intro g v hv
    apply h (ρ.rationalAction g.val) ?_ v hv
    rw [coefficientAlgebra_eq_adjoin_generatedRationalAction ρ f p]
    exact Algebra.subset_adjoin ⟨g, rfl⟩

include p in
/-- Under the same density hypotheses, ambient all-test stability is equivalent
to all-test stability under each supplied additive-group restriction. -/
theorem isStableSubspace_iff_forall_restrict [Infinite k] [IsReduced G.X.left]
    (hdense : Langlands.AlgebraicGeometry.PointTopology.HasDenseRationalPointFamily
      (fun g : LeviGluing.generatedRationalPoints G
        (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f => g.val))
    (W : Submodule k (n → k)) :
    ρ.IsStableSubspace W ↔ ∀ i, (ρ.restrict (f i)).IsStableSubspace W := by
  rw [isStableSubspace_iff_invariant_coefficientAlgebra ρ f p hdense,
    invariant_coefficientAlgebra_iff]

/-- Geometric generation by the supplied additive groups supplies the dense
generated rational-point family over an algebraically closed field. -/
theorem hasDenseRationalPointFamily_of_isGeneratedByFamily [IsAlgClosed k]
    [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
    (hgen : IsGeneratedByFamily
      (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f (𝟙 G)) :
    Langlands.AlgebraicGeometry.PointTopology.HasDenseRationalPointFamily
      (fun g : LeviGluing.generatedRationalPoints G
        (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f => g.val) := by
  have hs : Smooth (VectorGroup.groupScheme (CommRingCat.of k) 1).X.hom :=
    Corepresented.smooth_groupScheme_iff.mpr inferInstance
  have hA : ∀ _ : I,
      IsReduced (VectorGroup.groupScheme (CommRingCat.of k) 1).X.left ∧
        LocallyOfFiniteType (VectorGroup.groupScheme (CommRingCat.of k) 1).X.hom := by
    intro _
    exact ⟨Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field
      k _ (VectorGroup.groupScheme (CommRingCat.of k) 1).X.hom, inferInstance⟩
  have hd := LeviGluing.dense_rationalPointImage_generatedRationalPoints hA hgen
  apply hd.mono
  rintro _ ⟨x, hx, rfl⟩
  exact Set.mem_iUnion.mpr ⟨⟨x, hx⟩, ⟨IsLocalRing.closedPoint k, rfl⟩⟩

include p in
/-- For an affine reduced group locally of finite type over an algebraically
closed field, a supplied generating additive family detects all-test stability. -/
theorem isStableSubspace_iff_forall_restrict_of_isGeneratedByFamily [IsAlgClosed k]
    [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom] [IsReduced G.X.left]
    (hgen : IsGeneratedByFamily
      (fun _ : I => VectorGroup.groupScheme (CommRingCat.of k) 1) f (𝟙 G))
    (W : Submodule k (n → k)) :
    ρ.IsStableSubspace W ↔ ∀ i, (ρ.restrict (f i)).IsStableSubspace W :=
  isStableSubspace_iff_forall_restrict ρ f p
    (hasDenseRationalPointFamily_of_isGeneratedByFamily f hgen) W

end Langlands.GroupScheme.MatrixRepresentation.AdditiveFamilyActionAlgebra
