import Langlands.GroupScheme.OrthogonalMatrix.NumberedBase
import Langlands.GroupScheme.OrthogonalMatrix.CorootLattice
import Langlands.LinearAlgebra.SimplyConnectedRootDatumBase
import Langlands.LinearAlgebra.CorootSpanCartanEquivProof
import Langlands.GroupScheme.Torus.FundamentalWeightPermutation

/-! # The vector morphism from the orthogonal root datum -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.OrthogonalMatrix.TypeDNumbering

open Langlands.LinearAlgebra
open Langlands.TypeDNumberedVectors

variable {n : ℕ} {k : Type u} [Field k]

local notation "𝔻" => splitTorus.commGroupScheme (Spec (CommRingCat.of k)) (ULift (Fin n))

variable {J : Type u} [Finite J]
    (Q : RootDatum J
      (characterLattice (splitTorus.commGroupScheme
        (Spec (CommRingCat.of k)) (ULift (Fin n))))
      (cocharacterLattice (splitTorus.commGroupScheme
        (Spec (CommRingCat.of k)) (ULift (Fin n)))))
    (hQ : IsRootDatumOf (identityTorus (Fin n) k) Q)

include hQ

omit [Finite J] in
/-- The actual orthogonal root lattice has the same coordinate parity description as its
coroot lattice. -/
theorem map_rootSpan_eq_pairLattice (hn : 3 ≤ n) :
    (Q.rootSpan ℤ).map (GeneralLinear.characterCoordEquiv (Fin n) k).toLinearMap =
      TypeDParityLattice.pairLattice (Fin n) := by
  rw [← map_corootSpan_eq_pairLattice hQ (by simpa using hn)]
  change (Submodule.span ℤ (Set.range Q.root)).map _ =
    (Submodule.span ℤ (Set.range Q.coroot)).map _
  rw [Submodule.map_span, Submodule.map_span, ← Set.range_comp, ← Set.range_comp]
  apply congrArg (fun f : J → (Fin n → ℤ) => Submodule.span ℤ (Set.range f))
  funext r
  exact (corootCoord_eq_rootCoord Q hQ hn r).symm

omit [Finite J] in
/-- The full orthogonal character lattice is generated by all roots and the first coordinate
character. -/
theorem rootSpan_sup_firstCoordinate (hn : 3 ≤ n) :
    Q.rootSpan ℤ ⊔ Submodule.span ℤ
      {(GeneralLinear.characterCoordEquiv (Fin n) k).symm
        (Pi.single (⟨0, by omega⟩ : Fin n) 1)} = ⊤ := by
  apply top_unique
  intro x _
  let E := GeneralLinear.characterCoordEquiv (Fin n) k
  let a : Fin n := ⟨0, by omega⟩
  let z : ℤ := ∑ b, E x b
  have hd : E (x - z • E.symm (Pi.single a 1)) ∈ TypeDParityLattice.pairLattice (Fin n) := by
    simpa only [map_sub, map_smul, LinearEquiv.apply_symm_apply] using
      TypeDParityLattice.sub_sum_smul_single_mem (E x) a
  rw [← map_rootSpan_eq_pairLattice Q hQ hn] at hd
  obtain ⟨y, hy, hxy⟩ := hd
  have hyx : y = x - z • E.symm (Pi.single a 1) := E.injective hxy
  rw [hyx] at hy
  have hz : z • E.symm (Pi.single a 1) ∈
      Submodule.span ℤ {E.symm (Pi.single a 1)} :=
    Submodule.smul_mem _ z (Submodule.subset_span (Set.mem_singleton _))
  simpa only [sub_add_cancel] using
    add_mem (Submodule.mem_sup_left hy) (Submodule.mem_sup_right hz)

omit hQ [Finite J] in
/-- The coordinate at zero distinguishes the numbered vector vertex. -/
private theorem simple_firstCoordinate (hn : 3 ≤ n) (i : Fin n) :
    simple (by omega : 2 ≤ n) i (⟨0, by omega⟩ : Fin n) =
      if i = ⟨0, by omega⟩ then 1 else 0 := by
  by_cases hi : i.val + 1 < n
  · rw [simple_chain _ i hi]
    have hnext : (⟨i.val + 1, hi⟩ : Fin n) ≠ ⟨0, by omega⟩ := by
      intro h
      have := congrArg Fin.val h
      simp only at this
      omega
    simp [Pi.single_apply, eq_comm]
  · have hi0 : i ≠ (⟨0, by omega⟩ : Fin n) := by
      intro h
      have hz := congrArg Fin.val h
      simp only at hz
      omega
    have hlast : (⟨n - 1, by omega⟩ : Fin n) ≠ ⟨0, by omega⟩ := by
      intro h
      have := congrArg Fin.val h
      simp only at this
      omega
    have hpenult : (⟨n - 2, by omega⟩ : Fin n) ≠ ⟨0, by omega⟩ := by
      intro h
      have := congrArg Fin.val h
      simp only at this
      omega
    simp [simple, hi, hi0, hlast, hpenult]

variable {I X Y : Type u} [Finite I] [AddCommGroup X] [AddCommGroup Y]
    (P : RootDatum I X Y) [Q.IsReduced] [P.IsReduced]
    (B : P.Base) (hspan : P.corootSpan ℤ = ⊤)
    (hn : 4 ≤ n) (e : B.support ≃ Fin n)
    (he : ∀ a b : B.support, P.pairing a.val b.val = CartanMatrix.D n (e a) (e b))

include hspan he in
/-- The actual orthogonal root datum maps injectively to every full-coroot type-D datum,
matching the supplied simple-root numbering. -/
theorem exists_numberedHom :
    ∃ f : RootPairing.Hom Q P,
      Function.Injective f.weightMap ∧ Function.Injective f.coweightMap ∧
      ∀ a : (base Q hQ (by omega : 3 ≤ n)).support,
        f.indexEquiv a.val = (e.symm (numbering Q hQ (by omega : 3 ≤ n) a)).val := by
  let hfinite : Finite (cocharacterLattice 𝔻 ⧸ Q.corootSpan ℤ) :=
    Finite.of_injective _ (corootQuotientEquiv hQ (by simpa using (show 3 ≤ n by omega))).injective
  let C := SimplyConnectedRootDatum.base Q (base Q hQ (by omega : 3 ≤ n)) hfinite
  let eC : C.support ≃ B.support := (numbering Q hQ (by omega : 3 ≤ n)).trans e.symm
  obtain ⟨c, hc⟩ := corootSpanCartanEquiv J _ _ I X Y
    (SimplyConnectedRootDatum.rootDatum Q) P C B
    (SimplyConnectedRootDatum.corootSpan_rootDatum Q) hspan eC (by
      intro a b
      change P.pairing (e.symm (numbering Q hQ _ a)).val
        (e.symm (numbering Q hQ _ b)).val = Q.pairing a.val b.val
      rw [he, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact (pairing_numbering Q hQ hn a b).symm)
  let f := c.toHom.comp (SimplyConnectedRootDatum.toRootDatum Q)
  refine ⟨f, ?_, ?_, ?_⟩
  · exact c.bijective_weightMap.injective.comp
      (SimplyConnectedRootDatum.injective_toRootDatum_weightMap Q hfinite)
  · exact (SimplyConnectedRootDatum.injective_toRootDatum_coweightMap Q).comp
      c.bijective_coweightMap.injective
  · intro a
    exact hc a

omit hQ [Finite J] [Finite I] [Q.IsReduced] [P.IsReduced] in
/-- Every root-datum morphism maps the full root lattice onto the full root lattice. -/
theorem map_rootSpan (f : RootPairing.Hom Q P) :
    (Q.rootSpan ℤ).map f.weightMap = P.rootSpan ℤ := by
  change (Submodule.span ℤ (Set.range Q.root)).map _ =
    Submodule.span ℤ (Set.range P.root)
  rw [Submodule.map_span, ← Set.range_comp, f.root_weightMap,
    Set.range_comp, Equiv.range_eq_univ, Set.image_univ]

omit [Finite J] [Finite I] [Q.IsReduced] [P.IsReduced] in
/-- A morphism respecting the prescribed simple-root numbering sends the first orthogonal
coordinate character to the fundamental weight at numbered vertex zero. -/
theorem weightMap_firstCoordinate (f : RootPairing.Hom Q P)
    (hf : ∀ a : (base Q hQ (by omega : 3 ≤ n)).support,
      f.indexEquiv a.val = (e.symm (numbering Q hQ (by omega : 3 ≤ n) a)).val) :
    f.weightMap ((GeneralLinear.characterCoordEquiv (Fin n) k).symm
      (Pi.single (⟨0, by omega⟩ : Fin n) 1)) =
      Langlands.RootDatum.fundamentalWeightBasis P B hspan (e.symm ⟨0, by omega⟩) := by
  classical
  apply Langlands.RootDatumSimpleCorootEquiv.eq_of_pairing_simpleCoroot B hspan
  intro j
  let a := (numbering Q hQ (by omega : 3 ≤ n)).symm (e j)
  have ha : f.indexEquiv a.val = j.val := by
    rw [hf a]
    simp [a]
  have htrans (x) : P.toLinearMap (f.weightMap x) (P.coroot j.val) =
      Q.toLinearMap x (Q.coroot a.val) := by
    have ht := LinearMap.congr_fun
      (f.weight_coweight_transpose_apply Q P (P.coroot j.val)) x
    change P.toLinearMap (f.weightMap x) (P.coroot j.val) =
      Q.toLinearMap x (f.coweightMap (P.coroot j.val)) at ht
    rw [← ha, f.coroot_coweightMap_apply, Equiv.symm_apply_apply] at ht
    simpa only [ha] using ht
  rw [htrans, hQ.1, GeneralLinear.latticePairing_coord,
    LinearEquiv.apply_symm_apply, corootCoord_numbering Q hQ (by omega : 3 ≤ n) a]
  simp only [Pi.single_apply]
  simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  rw [simple_firstCoordinate (by omega : 3 ≤ n),
    Langlands.RootDatum.fundamentalWeightBasis_pairing]
  simp [a, Equiv.eq_symm_apply]

omit [Finite J] [Finite I] [Q.IsReduced] [P.IsReduced] in
/-- The integral character image is generated by all roots and the fundamental weight
at numbered vertex zero. -/
theorem range_weightMap (f : RootPairing.Hom Q P)
    (hf : ∀ a : (base Q hQ (by omega : 3 ≤ n)).support,
      f.indexEquiv a.val = (e.symm (numbering Q hQ (by omega : 3 ≤ n) a)).val) :
    LinearMap.range f.weightMap = P.rootSpan ℤ ⊔ Submodule.span ℤ
      {Langlands.RootDatum.fundamentalWeightBasis P B hspan (e.symm ⟨0, by omega⟩)} := by
  have h := congrArg (Submodule.map f.weightMap)
    (rootSpan_sup_firstCoordinate Q hQ (by omega : 3 ≤ n))
  rw [Submodule.map_sup, map_rootSpan Q P, Submodule.map_span, Set.image_singleton,
    weightMap_firstCoordinate Q hQ P B hspan hn e f hf, Submodule.map_top] at h
  exact h.symm

include he in
/-- The actual orthogonal datum admits the injective numbered vector morphism with
its full integral character image. -/
theorem exists_vectorHom :
    ∃ f : RootPairing.Hom Q P,
      Function.Injective f.weightMap ∧ Function.Injective f.coweightMap ∧
      (∀ a : (base Q hQ (by omega : 3 ≤ n)).support,
        f.indexEquiv a.val = (e.symm (numbering Q hQ (by omega : 3 ≤ n) a)).val) ∧
      LinearMap.range f.weightMap = P.rootSpan ℤ ⊔ Submodule.span ℤ
        {Langlands.RootDatum.fundamentalWeightBasis P B hspan (e.symm ⟨0, by omega⟩)} := by
  obtain ⟨f, hfw, hfc, hf⟩ := exists_numberedHom Q hQ P B hspan hn e he
  exact ⟨f, hfw, hfc, hf, range_weightMap Q hQ P B hspan hn e f hf⟩

/-- A chosen injective vector morphism from the actual orthogonal datum. -/
def vectorHom : RootPairing.Hom Q P :=
  Classical.choose (exists_vectorHom Q hQ P B hspan hn e he)

/-- The chosen vector morphism is injective on both lattices and has the prescribed
numbered simple-root map and integral character image. -/
theorem vectorHom_spec :
    Function.Injective (vectorHom Q hQ P B hspan hn e he).weightMap ∧
      Function.Injective (vectorHom Q hQ P B hspan hn e he).coweightMap ∧
      (∀ a : (base Q hQ (by omega : 3 ≤ n)).support,
        (vectorHom Q hQ P B hspan hn e he).indexEquiv a.val =
          (e.symm (numbering Q hQ (by omega : 3 ≤ n) a)).val) ∧
      LinearMap.range (vectorHom Q hQ P B hspan hn e he).weightMap =
        P.rootSpan ℤ ⊔ Submodule.span ℤ
          {Langlands.RootDatum.fundamentalWeightBasis P B hspan (e.symm ⟨0, by omega⟩)} :=
  Classical.choose_spec (exists_vectorHom Q hQ P B hspan hn e he)

omit hQ [Finite J] [Q.IsReduced] in
include he in
/-- Existence of an actual finite reduced orthogonal datum and injective vector morphism,
with its exact integral character image, over any field. -/
theorem exists_vectorRootDatum :
    ∃ (J' : Type u) (_ : Finite J')
      (Q' : RootDatum J' (characterLattice 𝔻) (cocharacterLattice 𝔻))
      (f : RootPairing.Hom Q' P),
      IsRootDatumOf (identityTorus (Fin n) k) Q' ∧ Q'.IsReduced ∧
      Function.Injective f.weightMap ∧ Function.Injective f.coweightMap ∧
      LinearMap.range f.weightMap = P.rootSpan ℤ ⊔ Submodule.span ℤ
        {Langlands.RootDatum.fundamentalWeightBasis P B hspan (e.symm ⟨0, by omega⟩)} := by
  obtain ⟨J', hJ', Q', hQ', hred, _⟩ := exists_numberedRootDatum (k := k) hn
  have : Finite J' := hJ'
  have : Q'.IsReduced := hred
  obtain ⟨f, hfw, hfc, _, hrange⟩ := exists_vectorHom Q' hQ' P B hspan hn e he
  exact ⟨J', hJ', Q', f, hQ', hred, hfw, hfc, hrange⟩

end Langlands.GroupScheme.OrthogonalMatrix.TypeDNumbering
