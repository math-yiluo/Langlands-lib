import Langlands.GroupScheme.VectorGroupQuotient
import Langlands.GroupScheme.Dynamic.SmoothProof
import Mathlib.RingTheory.HopfAlgebra.Quotient
import Mathlib.RingTheory.HopfAlgebra.Primitive

/-! # Quotients of affine groups by primitive functions -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry MvPolynomial
open CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj CategoryTheory.MonoidalCategory

namespace Langlands.GroupScheme.HopfPrimitive

/-! ### The Hopf ideal generated by a primitive element -/

section Algebra

variable {R : Type u} [CommRing R] {A : Type u} [CommRing A] [HopfAlgebra R A] {f : A}

/-- The ideal generated by a primitive element is a Hopf ideal. -/
theorem isHopfIdeal_span (hf : Bialgebra.IsPrimitiveElem R f) :
    (Ideal.span {f}).IsHopfIdeal R where
  counit_eq_zero x hx := by
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    change Bialgebra.counitAlgHom R A (a * f) = 0
    simp only [map_mul, Bialgebra.counitAlgHom_apply, hf.counit_eq_zero, mul_zero]
  map_mkQ_comul_eq_zero x hx := by
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    change (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R (Ideal.span {f}))
      (Ideal.Quotient.mkₐ R (Ideal.span {f}))) (Bialgebra.comulAlgHom R A (a * f)) = 0
    have h0 : Ideal.Quotient.mkₐ R (Ideal.span {f}) f = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)
    simp only [map_mul, Bialgebra.comulAlgHom_apply, hf.comul_eq_tmul_add_tmul, map_add,
      Algebra.TensorProduct.map_tmul, h0, TensorProduct.tmul_zero, TensorProduct.zero_tmul,
      add_zero, mul_zero]
  antipode_mem x hx := by
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [HopfAlgebra.antipode_mul_distrib, hf.antipode_eq_neg, mul_neg]
    exact (Ideal.span {f}).neg_mem (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self f))

end Algebra

/-! ### The Hopf quotient -/

section Quotient

variable {R : CommRingCat.{u}} (A : CommHopfAlgCat.{u} R) {f : A}
  (hf : Bialgebra.IsPrimitiveElem R f)

/-- The quotient Hopf algebra `A ⧸ (f)` of a commutative Hopf algebra by a primitive element. -/
def quotient : CommHopfAlgCat.{u} R :=
  haveI := isHopfIdeal_span hf
  CommHopfAlgCat.of R (A ⧸ Ideal.span {f})

theorem quotient_carrier : (quotient A hf : Type u) = (A ⧸ Ideal.span {f}) := rfl

/-- The quotient map `A ⟶ A ⧸ (f)` of Hopf algebras. -/
def quotientHom : A ⟶ quotient A hf :=
  haveI := isHopfIdeal_span hf
  CommHopfAlgCat.ofHom (Bialgebra.Quotient.mkBialgHom (R := R) (Ideal.span {f}))

theorem quotientHom_apply (a : A) :
    (quotientHom A hf).hom a = Ideal.Quotient.mk (Ideal.span {f}) a := rfl

/-- The closed subgroup `Spec (A ⧸ (f)) ⟶ Spec A`. -/
def subgroupHom : (hopfSpec R).obj (op (quotient A hf)) ⟶ (hopfSpec R).obj (op A) :=
  (hopfSpec R).map (quotientHom A hf).op

theorem subgroupHom_left :
    (subgroupHom A hf).hom.hom.left =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) := rfl

end Quotient

/-- The spectrum of a commutative Hopf algebra is affine over the base. -/
theorem isAffineHom_hopfSpec {R : CommRingCat.{u}} (B : CommHopfAlgCat.{u} R) :
    IsAffineHom ((hopfSpec R).obj (op B)).X.hom := by
  change IsAffineHom (Spec.map (CommRingCat.ofHom (algebraMap R B)))
  infer_instance

/-- Global sections of `Spec` pull back along `Spec.map` as the ring map does. -/
theorem appTop_specMap_inv {R S : CommRingCat.{u}} (φ : R ⟶ S) (r : R) :
    (Spec.map φ).appTop ((Scheme.ΓSpecIso R).inv r) = (Scheme.ΓSpecIso S).inv (φ r) := by
  rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]

/-! ### The coordinate homomorphism to `𝔾ₐ` -/

section Coordinate

variable {R : CommRingCat.{u}} (A : CommHopfAlgCat.{u} R) {f : A}
  (hf : Bialgebra.IsPrimitiveElem R f)

/-- The cogroup object of algebras attached to `A`. -/
abbrev cogroup : Grp (CommAlgCat.{u} R)ᵒᵖ :=
  ((commHopfAlgCatEquivCogrpCommAlgCat R).functor.obj A).unop

include hf in
/-- A primitive element is additive on the points of the cogroup of `A`. -/
theorem mul_unop_hom_apply {X : (CommAlgCat.{u} R)ᵒᵖ} (g h : X ⟶ (cogroup A).X) :
    (g * h).unop.hom f = g.unop.hom f + h.unop.hom f := by
  have key : ∀ φ ψ : A →ₐ[R] X.unop,
      Algebra.TensorProduct.lift φ ψ (fun _ _ ↦ .all _ _) (Bialgebra.comulAlgHom R A f) =
        φ f + ψ f := fun φ ψ ↦ by
    rw [Bialgebra.comulAlgHom_apply, hf.comul_eq_tmul_add_tmul, map_add,
      Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul, map_one, map_one, one_mul,
      mul_one, add_comm]
  rw [CategoryTheory.Hom.mul_def]
  exact key g.unop.hom h.unop.hom

/-- The natural homomorphism `g ↦ g(f)` from points of `Spec A` to `𝔾ₐ`, on algebras. -/
def pointsHom : yonedaGrp.obj (cogroup A) ⟶ Corepresented.presheaf (VectorGroup.functor R 1) where
  app _ := GrpCat.ofHom (MonoidHom.mk' (fun g => Multiplicative.ofAdd fun _ => g.unop.hom f)
    (fun g h => Multiplicative.toAdd.injective (funext fun _ => mul_unop_hom_apply A hf g h)))
  naturality _ _ _ := rfl

/-- The cogroup homomorphism dual to the Hopf algebra map `R[X] ⟶ A`, `X ↦ f`. -/
def cogroupHom :
    cogroup A ⟶ Corepresented.cogroup (VectorGroup.functor R 1) (VectorGroup.corepresentableBy R 1) :=
  yonedaGrpFullyFaithful.preimage
    (pointsHom A hf ≫ (Corepresented.pointsIso _ (VectorGroup.corepresentableBy R 1)).inv)

theorem cogroupHom_hom :
    (cogroupHom A hf).hom.hom = (CommAlgCat.ofHom (aeval fun _ : Fin 1 => f)).op := rfl

/-- The homomorphism `Spec A ⟶ 𝔾ₐ` given by the primitive element `f`. -/
def coordinateHom : (hopfSpec R).obj (op A) ⟶ VectorGroup.groupScheme R 1 :=
  (algSpec R).mapGrp.map (cogroupHom A hf)

theorem coordinateHom_left :
    (coordinateHom A hf).hom.hom.left =
      Spec.map (CommRingCat.ofHom (aeval fun _ : Fin 1 => f).toRingHom) := rfl

/-- The coordinate of the image of a point in `𝔾ₐ` is the pullback of `f`. -/
theorem coordinates_coordinateHom {T : Over (Spec R)} (x : T ⟶ ((hopfSpec R).obj (op A)).X) :
    (VectorGroup.coordinates R 1 T (x ≫ (coordinateHom A hf).hom.hom)).toAdd =
      fun _ => x.left.appTop ((Scheme.ΓSpecIso (CommRingCat.of A)).inv f) := by
  funext i
  rw [VectorGroup.coordinates_apply, Over.comp_left, Scheme.Hom.comp_appTop,
    CommRingCat.comp_apply]
  congr 1
  have key := appTop_specMap_inv
    (CommRingCat.ofHom (aeval fun _ : Fin 1 => f : MvPolynomial (Fin 1) R →ₐ[R] A).toRingHom) (X i)
  exact key.trans (congrArg (Scheme.ΓSpecIso (CommRingCat.of A)).inv (aeval_X _ i))

/-- A point lies in the kernel of the coordinate homomorphism exactly when `f` vanishes on it. -/
theorem mem_range_kernelι_coordinateHom_iff {T : Over (Spec R)}
    (x : T ⟶ ((hopfSpec R).obj (op A)).X) :
    x ∈ (SubgroupFunctor.range (kernelι (coordinateHom A hf))).carrier T ↔
      x.left.appTop ((Scheme.ΓSpecIso (CommRingCat.of A)).inv f) = 0 := by
  rw [mem_range_kernelι_iff]
  constructor
  · intro h
    have := congrFun (coordinates_coordinateHom A hf x) 0
    rw [h, map_one] at this
    exact this.symm
  · intro h
    apply VectorGroup.points_ext
    intro i
    rw [coordinates_coordinateHom, h, map_one]
    rfl

end Coordinate

/-! ### The kernel -/

section Kernel

variable {R : CommRingCat.{u}} (A : CommHopfAlgCat.{u} R) {f : A}
  (hf : Bialgebra.IsPrimitiveElem R f)

/-- A point of `Spec B` on which `g` vanishes factors through `Spec (B ⧸ (g))`. -/
theorem exists_comp_algSpec_map_mk_eq {B : CommAlgCat.{u} R} (g : B) {T : Over (Spec R)}
    (x : T ⟶ (algSpec R).obj (op B))
    (h : x.left.appTop ((Scheme.ΓSpecIso (CommRingCat.of B)).inv g) = 0) :
    ∃ y : T ⟶ (algSpec R).obj (op (CommAlgCat.of R (B ⧸ Ideal.span {g}))),
      y ≫ (algSpec R).map (CommAlgCat.ofHom (Ideal.Quotient.mkₐ R (Ideal.span {g}))).op = x := by
  have hxs : (((algΓAlgSpecAdjunction R).homEquiv T (op B)).symm x).unop.hom g = 0 := by
    rw [Corepresented.adjunction_homEquiv_symm_apply]
    exact h
  have hI : ∀ a ∈ Ideal.span {g},
      (((algΓAlgSpecAdjunction R).homEquiv T (op B)).symm x).unop.hom a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hxs, mul_zero]
  refine ⟨(algΓAlgSpecAdjunction R).homEquiv T _
    (CommAlgCat.ofHom (Ideal.Quotient.liftₐ (Ideal.span {g}) _ hI)).op, ?_⟩
  rw [← Adjunction.homEquiv_naturality_right, ← Equiv.eq_symm_apply]
  apply Quiver.Hom.unop_inj
  ext a
  exact Ideal.Quotient.liftₐ_apply (Ideal.span {g}) _ hI a

/-- A point lies in the subgroup `Spec (A ⧸ (f))` exactly when `f` vanishes on it. -/
theorem mem_range_subgroupHom_iff {T : Over (Spec R)} (x : T ⟶ ((hopfSpec R).obj (op A)).X) :
    x ∈ (SubgroupFunctor.range (subgroupHom A hf)).carrier T ↔
      x.left.appTop ((Scheme.ΓSpecIso (CommRingCat.of A)).inv f) = 0 := by
  rw [SubgroupFunctor.mem_range]
  constructor
  · rintro ⟨y, rfl⟩
    have h0 : (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) f = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)
    have key := appTop_specMap_inv (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) f
    rw [h0, map_zero] at key
    exact (congrArg (fun s => y.left.appTop s) key).trans (map_zero _)
  · intro h
    obtain ⟨y, hy⟩ := exists_comp_algSpec_map_mk_eq (B := CommAlgCat.of R A) f x h
    exact ⟨y, hy⟩

/-- The kernel of the coordinate homomorphism is the subgroup `Spec (A ⧸ (f))`. -/
theorem range_kernelι_coordinateHom :
    SubgroupFunctor.range (kernelι (coordinateHom A hf)) =
      SubgroupFunctor.range (subgroupHom A hf) :=
  SubgroupFunctor.ext fun _ => Subgroup.ext fun x =>
    (mem_range_kernelι_coordinateHom_iff A hf x).trans (mem_range_subgroupHom_iff A hf x).symm

/-- The points of the kernel of a homomorphism form a normal subgroup functor. -/
theorem isNormal_range_kernelι {S : Scheme.{u}} {G H : GroupScheme S} (q : G ⟶ H) :
    (SubgroupFunctor.range (kernelι q)).IsNormal := by
  intro T g x _ hx
  rw [mem_range_kernelι_iff] at hx ⊢
  rw [MonObj.mul_comp, MonObj.mul_comp, GrpObj.inv_comp, hx, mul_one, mul_inv_cancel]

theorem isNormal_range_subgroupHom : (SubgroupFunctor.range (subgroupHom A hf)).IsNormal := by
  rw [← range_kernelι_coordinateHom A hf]
  exact isNormal_range_kernelι _

theorem isClosedSubgroup_subgroupHom : IsClosedSubgroup (subgroupHom A hf) :=
  IsClosedImmersion.spec_of_surjective
    (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) Ideal.Quotient.mk_surjective

end Kernel

/-! ### Splitting off a section -/

section Splitting

variable {C : Type*} [Category C] [CartesianMonoidalCategory C] {K H V : C} [GrpObj H] [GrpObj V]

/-- A homomorphism `q : H ⟶ V` of group objects with a section `s` and with kernel `j` decomposes
`H` as the product `K ⊗ V` compatibly with `q`, and `K` is a retract of `H`. The iso is
`(x, t) ↦ x · s'(t)` for the normalized section `s' = s · s(1)⁻¹`. -/
theorem exists_iso_tensor_of_section (j : K ⟶ H) [Mono j] (q : H ⟶ V) [IsMonHom q]
    (hjq : j ≫ q = 1) (s : V ⟶ H) (hs : s ≫ q = 𝟙 V)
    (hlift : ∀ x : H ⟶ H, x ≫ q = 1 → ∃ y : H ⟶ K, y ≫ j = x) :
    ∃ Θ : K ⊗ V ≅ H, Θ.hom ≫ q = snd K V ∧ j ≫ Θ.inv ≫ fst K V = 𝟙 K := by
  set s' : V ⟶ H := s * (toUnit V ≫ η[V] ≫ s)⁻¹ with hs'_def
  have hs' : s' ≫ q = 𝟙 V := by
    rw [MonObj.mul_comp, GrpObj.inv_comp, hs, Category.assoc, Category.assoc, hs,
      Category.comp_id, ← Hom.one_def, inv_one, mul_one]
  have hηs' : η[V] ≫ s' = η[H] := by
    rw [MonObj.comp_mul, GrpObj.comp_inv, ← Category.assoc η[V] (toUnit V),
      toUnit_unique (η[V] ≫ toUnit V) (𝟙 _), Category.id_comp, mul_inv_cancel, Hom.one_def,
      toUnit_unit, Category.id_comp]
  obtain ⟨r, hr⟩ := hlift (𝟙 H * (q ≫ s')⁻¹) (by
    rw [MonObj.mul_comp, GrpObj.inv_comp, Category.assoc, hs', Category.comp_id, Category.id_comp,
      mul_inv_cancel])
  have h2 : ((fst K V ≫ j) * (snd K V ≫ s')) ≫ q = snd K V := by
    rw [MonObj.mul_comp, Category.assoc, Category.assoc, hjq, hs', MonObj.comp_one, one_mul,
      Category.comp_id]
  have h1 : ((fst K V ≫ j) * (snd K V ≫ s')) ≫ r = fst K V := by
    rw [← cancel_mono j, Category.assoc, hr, MonObj.comp_mul, Category.comp_id, GrpObj.comp_inv,
      ← Category.assoc _ q, h2, mul_inv_cancel_right]
  refine ⟨⟨(fst K V ≫ j) * (snd K V ≫ s'), lift r q, ?_, ?_⟩, h2, ?_⟩
  · apply CartesianMonoidalCategory.hom_ext
    · rw [Category.assoc, lift_fst, h1, Category.id_comp]
    · rw [Category.assoc, lift_snd, h2, Category.id_comp]
  · rw [MonObj.comp_mul, ← Category.assoc, lift_fst, hr, ← Category.assoc, lift_snd,
      inv_mul_cancel_right]
  · change j ≫ lift r q ≫ fst K V = 𝟙 K
    rw [lift_fst, ← cancel_mono j, Category.assoc, hr, MonObj.comp_mul, Category.comp_id,
      Category.id_comp, GrpObj.comp_inv, ← Category.assoc, hjq, Hom.one_def, Category.assoc,
      hηs', ← Hom.one_def, inv_one, mul_one]

end Splitting

/-! ### The kernel as a split subgroup -/

section Lift

variable {R : CommRingCat.{u}} (A : CommHopfAlgCat.{u} R) {f : A}
  (hf : Bialgebra.IsPrimitiveElem R f)

/-- The subgroup `Spec (A ⧸ (f))` maps to the identity of `𝔾ₐ`. -/
theorem subgroupHom_comp_coordinateHom :
    (subgroupHom A hf).hom.hom ≫ (coordinateHom A hf).hom.hom = 1 := by
  rw [← mem_range_kernelι_iff, range_kernelι_coordinateHom, SubgroupFunctor.mem_range]
  exact ⟨𝟙 _, Category.id_comp _⟩

/-- A point of `Spec A` in the kernel of the coordinate homomorphism lifts to the subgroup. -/
theorem exists_comp_subgroupHom_eq {T : Over (Spec R)} (x : T ⟶ ((hopfSpec R).obj (op A)).X)
    (hx : x ≫ (coordinateHom A hf).hom.hom = 1) :
    ∃ y, y ≫ (subgroupHom A hf).hom.hom = x := by
  rw [← mem_range_kernelι_iff, range_kernelι_coordinateHom] at hx
  exact hx

/-- The inclusion of the subgroup is a monomorphism, being a closed immersion. -/
instance mono_subgroupHom : Mono (subgroupHom A hf).hom.hom := by
  have : IsClosedImmersion (subgroupHom A hf).hom.hom.left := isClosedSubgroup_subgroupHom A hf
  exact Over.mono_of_mono_left _

end Lift

/-- `Spec` turns a retraction of algebras into a section of schemes. -/
theorem algSpec_map_comp_map_eq_id {R : CommRingCat.{u}} {B C : CommAlgCat.{u} R} (a : B ⟶ C)
    (b : C ⟶ B) (h : b ≫ a = 𝟙 C) : (algSpec R).map a.op ≫ (algSpec R).map b.op = 𝟙 _ := by
  rw [← Functor.map_comp, ← op_comp, h, op_id, CategoryTheory.Functor.map_id]

/-! ### The split step over a field -/

section Split

variable {k : Type u} [Field k] (A : CommHopfAlgCat.{u} (CommRingCat.of k)) {f : A}
  (hf : Bialgebra.IsPrimitiveElem (CommRingCat.of k) f) (σ : A →ₐ[k] Polynomial k)

/-- The morphism `𝔾ₐ ⟶ Spec A` dual to `σ`, written in the variable of `𝔾ₐ`. -/
def sectionHom :
    (VectorGroup.groupScheme (CommRingCat.of k) 1).X ⟶
      ((hopfSpec (CommRingCat.of k)).obj (op A)).X :=
  (algSpec (CommRingCat.of k)).map
    (CommAlgCat.ofHom ((Polynomial.aeval (X 0 : MvPolynomial (Fin 1) k)).comp σ)).op

variable {σ}

/-- If `σ f = X`, then `sectionHom A σ` is a section of the coordinate homomorphism. -/
theorem sectionHom_comp_coordinateHom (hσ : σ f = Polynomial.X) :
    sectionHom A σ ≫ (coordinateHom A hf).hom.hom = 𝟙 _ := by
  have h : CommAlgCat.ofHom (aeval fun _ : Fin 1 => f) ≫
      CommAlgCat.ofHom ((Polynomial.aeval (X 0 : MvPolynomial (Fin 1) k)).comp σ) =
        𝟙 (VectorGroup.coordinateAlgebra (CommRingCat.of k) 1) := by
    apply CommAlgCat.hom_ext
    apply MvPolynomial.algHom_ext
    intro i
    rw [Subsingleton.elim i 0]
    change (Polynomial.aeval (X 0 : MvPolynomial (Fin 1) k)) (σ (aeval (fun _ : Fin 1 => f) (X 0)))
      = X 0
    rw [aeval_X, hσ, Polynomial.aeval_X]
  exact algSpec_map_comp_map_eq_id (B := CommAlgCat.of (CommRingCat.of k) A) _ _ h

variable (σ)

/-- Over a field, a section `σ` with `σ f = X` decomposes `Spec A` as `Spec (A ⧸ (f)) × 𝔾ₐ`
compatibly with the coordinate homomorphism, and `Spec (A ⧸ (f))` is a retract of `Spec A`. -/
theorem exists_iso_tensor (hσ : σ f = Polynomial.X) :
    ∃ Θ : ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X ⊗
        (VectorGroup.groupScheme (CommRingCat.of k) 1).X ≅
          ((hopfSpec (CommRingCat.of k)).obj (op A)).X,
      Θ.hom ≫ (coordinateHom A hf).hom.hom = snd _ _ ∧
        (subgroupHom A hf).hom.hom ≫ Θ.inv ≫ fst _ _ = 𝟙 _ :=
  exists_iso_tensor_of_section _ _ (subgroupHom_comp_coordinateHom A hf) (sectionHom A σ)
    (sectionHom_comp_coordinateHom A hf hσ) (fun x hx => exists_comp_subgroupHom_eq A hf x hx)

/-- The kernel `Spec (A ⧸ (f))` is smooth when `Spec A` is. -/
theorem smooth_subgroup (hσ : σ f = Polynomial.X)
    (hSmooth : Smooth ((hopfSpec (CommRingCat.of k)).obj (op A)).X.hom) :
    Smooth ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X.hom := by
  obtain ⟨Θ, -, hΘ⟩ := exists_iso_tensor A hf σ hσ
  have : Algebra.Smooth (CommRingCat.of k) (CommAlgCat.of (CommRingCat.of k) A) :=
    (DynamicSmooth.smooth_algSpec_iff _).mp hSmooth
  have h := DynamicSmooth.formallySmooth_of_algSpec_retract
    (A := CommAlgCat.of (CommRingCat.of k) A)
    (A' := CommAlgCat.of (CommRingCat.of k) (A ⧸ Ideal.span {f})) _ _ hΘ
  have h' := (DynamicSmooth.smooth_algSpec_iff
    (CommAlgCat.of (CommRingCat.of k) (A ⧸ Ideal.span {f}))).mpr
      (DynamicSmooth.smooth_quotient (B := CommAlgCat.of (CommRingCat.of k) A) h)
  exact h'

/-- The kernel `Spec (A ⧸ (f))` is connected when `Spec A` is. -/
theorem connectedSpace_subgroup (hσ : σ f = Polynomial.X)
    (hConn : ConnectedSpace ((hopfSpec (CommRingCat.of k)).obj (op A)).X.left) :
    ConnectedSpace ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X.left := by
  obtain ⟨Θ, -, hΘ⟩ := exists_iso_tensor A hf σ hσ
  have : Surjective ((subgroupHom A hf).hom.hom.left ≫ (Θ.inv ≫ fst _ _).left) := by
    rw [← Over.comp_left, hΘ, Over.id_left]
    infer_instance
  have hr := Surjective.of_comp (f := (subgroupHom A hf).hom.hom.left) (g := (Θ.inv ≫ fst _ _).left)
  exact Function.Surjective.connectedSpace hr.surj (Θ.inv ≫ fst _ _).left.base.hom.continuous

set_option backward.isDefEq.respectTransparency.types false in
/-- The coordinate homomorphism is an fppf quotient by `Spec (A ⧸ (f))`. -/
theorem isFppfQuotient_coordinateHom (hσ : σ f = Polynomial.X)
    (hSmooth : Smooth ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X.hom) :
    RelativeRoot.IsFppfQuotient (SubgroupFunctor.range (subgroupHom A hf)) (coordinateHom A hf) := by
  obtain ⟨Θ, hΘ, -⟩ := exists_iso_tensor A hf σ hσ
  have hq : (coordinateHom A hf).hom.hom.left = Θ.inv.left ≫ Limits.pullback.snd _ _ := by
    rw [(Iso.eq_inv_comp Θ).mpr hΘ, Over.comp_left]
    rfl
  have := hSmooth
  refine ⟨?_, ?_, ?_, range_kernelι_coordinateHom A hf⟩
  · rw [hq]
    infer_instance
  · have : Surjective ((sectionHom A σ).left ≫ (coordinateHom A hf).hom.hom.left) := by
      rw [← Over.comp_left, sectionHom_comp_coordinateHom A hf hσ, Over.id_left]
      infer_instance
    exact Surjective.of_comp (f := (sectionHom A σ).left) (g := (coordinateHom A hf).hom.hom.left)
  · rw [hq]
    infer_instance

/-- The vector group `𝔾ₐ` is a vector group of dimension one. -/
theorem isVectorGroupOfDimension_groupScheme_one :
    RelativeRoot.IsVectorGroupOfDimension (VectorGroup.groupScheme (CommRingCat.of k) 1) 1 :=
  ⟨VectorGroup.coordinates _ 1, fun _ _ b x => VectorGroup.coordinates_comp b x⟩

/-- **The split step.** Let `A` be a commutative Hopf algebra over a field `k` with `Spec A` smooth
and connected, `f ∈ A` primitive, and `σ : A →ₐ[k] k[X]` with `σ f = X`. Then the closed subgroup
`K = Spec (A ⧸ (f))` is smooth, connected and affine, and a split series of length `n` for `K`
extends to one of length `n + 1` for `Spec A`, with quotient `𝔾ₐ` given by `f`. -/
theorem splitStep (hσ : σ f = Polynomial.X)
    (hSmooth : Smooth ((hopfSpec (CommRingCat.of k)).obj (op A)).X.hom)
    (hConn : ConnectedSpace ((hopfSpec (CommRingCat.of k)).obj (op A)).X.left) :
    Smooth ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X.hom ∧
      ConnectedSpace ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X.left ∧
        IsAffineHom ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))).X.hom ∧
          ∀ n, RelativeRoot.HasSplitSeries n
              ((hopfSpec (CommRingCat.of k)).obj (op (quotient A hf))) →
            RelativeRoot.HasSplitSeries (n + 1) ((hopfSpec (CommRingCat.of k)).obj (op A)) := by
  have hK := smooth_subgroup A hf σ hσ hSmooth
  have hKc := connectedSpace_subgroup A hf σ hσ hConn
  refine ⟨hK, hKc, isAffineHom_hopfSpec _, fun n hn => ?_⟩
  exact ⟨_, VectorGroup.groupScheme (CommRingCat.of k) 1, subgroupHom A hf, coordinateHom A hf,
    isClosedSubgroup_subgroupHom A hf, hK, hKc, isNormal_range_subgroupHom A hf,
    isFppfQuotient_coordinateHom A hf σ hσ hK, isVectorGroupOfDimension_groupScheme_one, hn⟩

end Split

end Langlands.GroupScheme.HopfPrimitive
