section RootData

variable {J M N Z : Type*} [AddCommGroup M] [AddCommGroup N] [AddCommGroup Z]
  (P : RootDatum J M N)

/-- An additive map killing the roots indexed by `s` is invariant under the
subgroup generated by the reflections in those roots. -/
theorem map_weightMap_of_mem_reflectionSubgroup (s : Set J) (r : M →+ Z)
    (hr : ∀ i ∈ s, r (P.root i) = 0) {w : P.Aut}
    (hw : w ∈ Langlands.RootDatum.reflectionSubgroup P s) (x : M) :
    r (w.weightMap x) = r x := by
  induction hw using Subgroup.closure_induction generalizing x with
  | mem w hw =>
    obtain ⟨i, hi, rfl⟩ := hw
    change r (P.reflection i x) = r x
    rw [RootPairing.reflection_apply, map_sub, map_zsmul, hr i hi, smul_zero, sub_zero]
  | one => rfl
  | mul w₁ w₂ _ _ h₁ h₂ =>
    change r (w₁.weightMap (w₂.weightMap x)) = r x
    rw [h₁, h₂]
  | inv w _ h =>
    have hx : w.weightMap (w⁻¹.weightMap x) = x :=
      congrArg (fun u : P.Aut => u.weightMap x) (mul_inv_cancel w)
    conv_rhs => rw [← hx]
    exact (h _).symm

end RootData

section Pinnings

variable {K : Type u} [Field K]
  {G H : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom] [IsAffineHom H.X.hom]

/-- Correction by the reflections in a set `s` of roots: if positivity is already
matched at every root outside `s`, after any such correction, then some element of
the subgroup generated by the reflections in `s` matches positivity at all roots. -/
theorem exists_reflection_comp_isPos (p : SplitPinning G) (q : SplitPinning H)
    (e₀ : RootPairing.Equiv p.rootDatum q.rootDatum) (s : Set q.rootIndex)
    (hs : ∀ w ∈ Langlands.RootDatum.reflectionSubgroup q.rootDatum s, ∀ j,
      w.indexEquiv (e₀.indexEquiv j) ∉ s →
        (q.base.IsPos (w.indexEquiv (e₀.indexEquiv j)) ↔ p.base.IsPos j)) :
    ∃ w ∈ Langlands.RootDatum.reflectionSubgroup q.rootDatum s, ∀ j,
      q.base.IsPos ((RootPairing.Equiv.comp w e₀).indexEquiv j) ↔ p.base.IsPos j := by
  classical
  let := Fintype.ofFinite q.rootIndex
  let := q.finite_rootDatum_weylGroup
  have hposp (i : p.rootIndex) :
      0 < p.rootDatum.root' i p.positiveCocharacter ↔ p.base.IsPos i := by
    change 0 < p.rootDatum.toLinearMap (p.rootDatum.root i) p.positiveCocharacter ↔ _
    rw [p.isRootDatum.1]
    exact p.latticePairing_root_positiveCocharacter_pos_iff i
  have hposq (i : q.rootIndex) :
      0 < q.rootDatum.root' i q.positiveCocharacter ↔ q.base.IsPos i := by
    change 0 < q.rootDatum.toLinearMap (q.rootDatum.root i) q.positiveCocharacter ↔ _
    rw [q.isRootDatum.1]
    exact q.latticePairing_root_positiveCocharacter_pos_iff i
  have hnep (i : p.rootIndex) : p.rootDatum.root' i p.positiveCocharacter ≠ 0 := by
    change p.rootDatum.toLinearMap (p.rootDatum.root i) p.positiveCocharacter ≠ 0
    rw [p.isRootDatum.1]
    exact p.latticePairing_root_positiveCocharacter_ne_zero i
  have hneq (i : q.rootIndex) : q.rootDatum.root' i q.positiveCocharacter ≠ 0 := by
    change q.rootDatum.toLinearMap (q.rootDatum.root i) q.positiveCocharacter ≠ 0
    rw [q.isRootDatum.1]
    exact q.latticePairing_root_positiveCocharacter_ne_zero i
  let g := e₀.coweightEquiv.symm p.positiveCocharacter
  have hg (i : q.rootIndex) : q.rootDatum.root' i g ≠ 0 := by
    obtain ⟨j, rfl⟩ := e₀.indexEquiv.surjective i
    rw [e₀.root'_coweightEquiv]
    exact hnep j
  obtain ⟨u, hu⟩ := Langlands.LinearAlgebra.RootDatumWeylChambers.exists_same_signs
    q.rootDatum s hneq hg
  have hu' : u.val⁻¹ ∈ Langlands.RootDatum.reflectionSubgroup q.rootDatum s :=
    inv_mem u.property
  refine ⟨u.val⁻¹, hu', fun j => ?_⟩
  change q.base.IsPos (u.val.indexEquiv.symm (e₀.indexEquiv j)) ↔ p.base.IsPos j
  by_cases hj : u.val.indexEquiv.symm (e₀.indexEquiv j) ∈ s
  · have hsign := hu (u.val.indexEquiv.symm (e₀.indexEquiv j)) hj
    have hr := u.val.root'_coweightEquiv (u.val.indexEquiv.symm (e₀.indexEquiv j))
      (u.val.coweightEquiv g)
    rw [LinearEquiv.symm_apply_apply, Equiv.apply_symm_apply] at hr
    rw [← hposq, hsign, ← hr, e₀.root'_coweightEquiv, hposp]
  · exact hs _ hu' j hj

/-- A conjugation between the tori of two split pinnings of the same group, with its
induced root-datum equivalence, may be followed by any Weyl element: the composite
equivalence is again induced by a conjugating point. -/
theorem exists_conj_comp_weyl (p q : SplitPinning H)
    {g : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ H.X} {φ : p.torus ≅ q.torus}
    (hg : p.inclusion ≫ (H.innerIso g).hom = CommGroupScheme.groupHom φ.hom ≫ q.inclusion)
    (e₀ : RootPairing.Equiv p.rootDatum q.rootDatum) (he₀ : ∀ χ, e₀.weightMap χ = φ.inv ≫ χ)
    {w : q.rootDatum.Aut} (hw : w ∈ q.rootDatum.weylGroup) :
    ∃ (g' : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ H.X) (φ' : p.torus ≅ q.torus),
      p.inclusion ≫ (H.innerIso g').hom = CommGroupScheme.groupHom φ'.hom ≫ q.inclusion ∧
      ∀ χ, (RootPairing.Equiv.comp w e₀).weightMap χ = φ'.inv ≫ χ := by
  let : IsClosedImmersion q.inclusion.hom.hom.left := q.isMaximalTorus.2.1
  have hW := (weylGroup K H q.isConnectedReductive q.torus q.isSplitTorus q.inclusion
    q.isMaximalTorus q.rootIndex q.rootDatum q.isRootDatum).1
  have hwi : RootPairing.Equiv.weightHom q.rootDatum w ∈ weylImage q.inclusion := by
    rw [hW]
    exact Subgroup.mem_map_of_mem _ hw
  obtain ⟨n, hn⟩ := MonoidHom.mem_range.1 hwi
  have hτ := isNormalizingPoint_normalizingAut q.inclusion n
  refine ⟨n.val * g, φ ≪≫ normalizingAut q.inclusion n, conj_mul hg hτ, fun χ => ?_⟩
  have h := DFunLike.congr_fun hn (e₀.weightMap χ)
  change (normalizingAut q.inclusion n).inv ≫ e₀.weightMap χ = w.weightMap (e₀.weightMap χ)
    at h
  change w.weightMap (e₀.weightMap χ) = ((normalizingAut q.inclusion n).inv ≫ φ.inv) ≫ χ
  rw [← h, he₀, Category.assoc]

/-- A conjugation between the tori of two split pinnings of the same group induces an
equivalence of their root data acting on characters by the inverse torus isomorphism. -/
theorem exists_equiv_of_conj (p q : SplitPinning H)
    {g : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ H.X} {φ : p.torus ≅ q.torus}
    (hg : p.inclusion ≫ (H.innerIso g).hom = CommGroupScheme.groupHom φ.hom ≫ q.inclusion) :
    ∃ e₀ : RootPairing.Equiv p.rootDatum q.rootDatum, ∀ χ, e₀.weightMap χ = φ.inv ≫ χ := by
  have hsq := conj_inv hg
  exact ⟨rootDatumEquivOfTorusCompatibleIso q.isConnectedReductive p.isConnectedReductive
      q.isSplitTorus p.isSplitTorus q.isMaximalTorus p.isMaximalTorus
      (H.innerIso g⁻¹) φ.symm hsq q.isRootDatum p.isRootDatum,
    fun χ => rootDatumEquivOfTorusCompatibleIso_weightMap q.isConnectedReductive
      p.isConnectedReductive q.isSplitTorus p.isSplitTorus q.isMaximalTorus p.isMaximalTorus
      (H.innerIso g⁻¹) φ.symm hsq q.isRootDatum p.isRootDatum χ⟩

end Pinnings

section Cancel

variable {B : Scheme.{u}} {C C' : CommGroupScheme B} {H : GroupScheme B}

/-- Homomorphisms of commutative group schemes agreeing after a monomorphic subgroup
inclusion are equal. -/
theorem groupHom_cancel_mono (j : C'.toGrp ⟶ H) [Mono j.hom.hom.left] {x y : C ⟶ C'}
    (h : CommGroupScheme.groupHom x ≫ j = CommGroupScheme.groupHom y ≫ j) : x = y := by
  have h' := congrArg (fun f => f.hom.hom.left) h
  simp only [Grp.comp_hom_hom, Over.comp_left] at h'
  have h'' := (cancel_mono _).1 h'
  change Additive.ofMul (CommGroupScheme.groupHom x) = Additive.ofMul (CommGroupScheme.groupHom y)
  congr 1
  apply Grp.hom_ext
  exact Over.OverMorphism.ext h''

end Cancel

section Data

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]

local notation "bK" => algebraBaseMap k (SeparableClosure k)

/-- Two compatible choices have rationally conjugate maximal split tori, and the
conjugation may be chosen so that the transported positive cocharacter of the first
choice lies in the closed dominant chamber of the second. -/
theorem exists_rational_conj (d e : TitsIndexData G) :
    ∃ (m : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) (ψ : d.splitTorus ≅ e.splitTorus),
      d.splitInclusion ≫ (G.innerIso m).hom =
        CommGroupScheme.groupHom ψ.hom ≫ e.splitInclusion ∧
      ∀ α ∈ positiveRelativeRoots e.splitInclusion e.positiveCocharacter,
        0 ≤ latticePairing e.splitTorus α (d.positiveCocharacter ≫ ψ.hom) := by
  have hG : IsConnectedReductive G := d.isSemisimple.isConnectedReductive
  have := hG.smooth
  have := hG.connectedSpace
  obtain ⟨g₁, e₁, h₁⟩ := smoothMaximalSplitTorusConjugacy k G _ _ d.splitInclusion
    e.splitInclusion d.maximalSplit e.maximalSplit
  have := e.maximalSplit.isSplitSubtorus.mono
  have hroot : HasRelativeRootSystem e.splitInclusion :=
    relativeRootSystem k G hG _ _ e.maximalSplit
  obtain ⟨n, hn⟩ := hroot.exists_normalizerPoint_dominant e.splitInclusion
    e.maximalSplit.1.1 e.positiveCocharacter
    (d.positiveCocharacter ≫ (CommGroupScheme.isoOfGroupIso e₁).hom)
  refine ⟨n.val * g₁, CommGroupScheme.isoOfGroupIso e₁ ≪≫ normalizingAut e.splitInclusion n,
    conj_mul h₁ (isNormalizingPoint_normalizingAut _ n), fun α hα => ?_⟩
  have h := hn α hα
  rw [cocharacterAut_apply] at h
  simpa only [Iso.trans_hom, Category.assoc] using h

local instance baseChangeAffine' :
    IsAffineHom ((GroupScheme.baseChange (algebraBaseMap k (SeparableClosure k))).obj G).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom
    (algebraBaseMap k (SeparableClosure k)))
  infer_instance

/-- After a rational conjugation of the maximal split tori, the two maximal tori of the
chosen pinnings become conjugate over the separable closure by a point compatible with
the given identification of the split tori. -/
theorem exists_conj_data (d e : TitsIndexData G)
    {m : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X} {ψ : d.splitTorus ≅ e.splitTorus}
    (hm : d.splitInclusion ≫ (G.innerIso m).hom =
      CommGroupScheme.groupHom ψ.hom ≫ e.splitInclusion) :
    ∃ (g : Over.mk (𝟙 (Spec (CommRingCat.of (SeparableClosure k)))) ⟶
        ((GroupScheme.baseChange (algebraBaseMap k (SeparableClosure k))).obj G).X)
      (φ : d.pinning.toSplitPinning.torus ≅ e.pinning.toSplitPinning.torus),
      d.pinning.toSplitPinning.inclusion ≫
          (((GroupScheme.baseChange (algebraBaseMap k (SeparableClosure k))).obj G).innerIso
            g).hom =
        CommGroupScheme.groupHom φ.hom ≫ e.pinning.toSplitPinning.inclusion ∧
      (CommGroupScheme.baseChange (algebraBaseMap k (SeparableClosure k))).map d.torusMap ≫
          φ.hom =
        (CommGroupScheme.baseChange (algebraBaseMap k (SeparableClosure k))).map
          (ψ.hom ≫ e.torusMap) := by
  have hmK := IsConjugatingPoint.baseChangeBasePoint (algebraBaseMap k (SeparableClosure k)) hm
  have ht₁ : IsMaximalSplitTorus (d.pinning.toSplitPinning.inclusion ≫
      (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m)).hom) :=
    (d.pinning.toSplitPinning.isMaximalTorus.comp_iso (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m))).isMaximalSplitTorus
      d.pinning.toSplitPinning.isSplitTorus
  have ht₂ : IsMaximalSplitTorus e.pinning.toSplitPinning.inclusion :=
    e.pinning.toSplitPinning.isMaximalTorus.isMaximalSplitTorus e.pinning.toSplitPinning.isSplitTorus
  have := ht₂.isSplitSubtorus.mono
  have hA : IsSplitTorus ((CommGroupScheme.baseChange bK).obj e.splitTorus).toGrp :=
    e.maximalSplit.1.1.baseChange bK
  have hsqd : CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map d.torusMap) ≫
      d.pinning.toSplitPinning.inclusion = (GroupScheme.baseChange bK).map d.splitInclusion := by
    change (GroupScheme.baseChange bK).map (CommGroupScheme.groupHom d.torusMap) ≫
      (GroupScheme.baseChange bK).map d.pinning.inclusion = _
    rw [← Functor.map_comp, d.square]
  have hsqe : CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map e.torusMap) ≫
      e.pinning.toSplitPinning.inclusion = (GroupScheme.baseChange bK).map e.splitInclusion := by
    change (GroupScheme.baseChange bK).map (CommGroupScheme.groupHom e.torusMap) ≫
      (GroupScheme.baseChange bK).map e.pinning.inclusion = _
    rw [← Functor.map_comp, e.square]
  have hm' : (GroupScheme.baseChange bK).map d.splitInclusion ≫
      (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m)).hom =
      CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map ψ.hom) ≫
        (GroupScheme.baseChange bK).map e.splitInclusion := hmK
  have hf₁ : CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map ψ.inv ≫
      (CommGroupScheme.baseChange bK).map d.torusMap) ≫
        (d.pinning.toSplitPinning.inclusion ≫ (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m)).hom) =
        (GroupScheme.baseChange bK).map e.splitInclusion := by
    change CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map ψ.inv) ≫
      (CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map d.torusMap) ≫
        d.pinning.toSplitPinning.inclusion) ≫ (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m)).hom = _
    rw [hsqd, hm', ← Category.assoc]
    change CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map ψ.inv ≫
      (CommGroupScheme.baseChange bK).map ψ.hom) ≫ _ = _
    rw [← Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id]
    exact Category.id_comp _
  obtain ⟨z, φ, hz, hza⟩ := exists_centralizing_conj_of_isMaximalSplitTorus
    d.pinning.toSplitPinning.isConnectedReductive hA
    ((GroupScheme.baseChange bK).map e.splitInclusion) ht₁ ht₂ _ _ hf₁ hsqe
  refine ⟨z * baseChangeBasePoint bK G m, φ, ?_, ?_⟩
  · rw [innerIso_mul_hom, ← Category.assoc, hz]
  · apply groupHom_cancel_mono e.pinning.toSplitPinning.inclusion
    have h1 : CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map d.torusMap ≫
          φ.hom) ≫ e.pinning.toSplitPinning.inclusion =
        CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map d.torusMap) ≫
          (d.pinning.toSplitPinning.inclusion ≫
            (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m)).hom) ≫
            (((GroupScheme.baseChange bK).obj G).innerIso z).hom := by
      rw [hz]
      rfl
    have h2 : CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map
          (ψ.hom ≫ e.torusMap)) ≫ e.pinning.toSplitPinning.inclusion =
        CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map ψ.hom) ≫
          (GroupScheme.baseChange bK).map e.splitInclusion := by
      rw [Functor.map_comp, ← hsqe]
      rfl
    have h3 : CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map d.torusMap) ≫
          (d.pinning.toSplitPinning.inclusion ≫
            (((GroupScheme.baseChange bK).obj G).innerIso (baseChangeBasePoint bK G m)).hom) ≫
            (((GroupScheme.baseChange bK).obj G).innerIso z).hom =
        CommGroupScheme.groupHom ((CommGroupScheme.baseChange bK).map ψ.hom) ≫
          (GroupScheme.baseChange bK).map e.splitInclusion := by
      rw [← Category.assoc, ← Category.assoc, hsqd, hm', Category.assoc, hza]
    exact h1.trans (h3.trans h2.symm)

/-- Restrictions to the split tori are transported along a conjugation of the maximal
tori compatible with an identification of the split tori. -/
theorem restriction_transport (d e : TitsIndexData G) {ψ : d.splitTorus ≅ e.splitTorus}
    {φ : d.pinning.toSplitPinning.torus ≅ e.pinning.toSplitPinning.torus}
    (hφ : (CommGroupScheme.baseChange bK).map d.torusMap ≫ φ.hom =
      (CommGroupScheme.baseChange bK).map (ψ.hom ≫ e.torusMap))
    (χ : characterLattice d.pinning.toSplitPinning.torus) :
    (characterLattice.baseChangeEquiv bK e.splitTorus e.maximalSplit.1.1).symm
        ((CommGroupScheme.baseChange bK).map e.torusMap ≫ φ.inv ≫ χ) =
      ψ.inv ≫ (characterLattice.baseChangeEquiv bK d.splitTorus d.maximalSplit.1.1).symm
        ((CommGroupScheme.baseChange bK).map d.torusMap ≫ χ) := by
  have h : (CommGroupScheme.baseChange bK).map e.torusMap ≫ φ.inv =
      (CommGroupScheme.baseChange bK).map ψ.inv ≫
        (CommGroupScheme.baseChange bK).map d.torusMap := by
    rw [Iso.comp_inv_eq, Category.assoc, hφ, Functor.map_comp, ← Category.assoc,
      ← Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id, Category.id_comp]
  apply (characterLattice.baseChangeEquiv bK e.splitTorus e.maximalSplit.1.1).injective
  rw [AddEquiv.apply_symm_apply, characterLattice.baseChangeEquiv_apply,
    characterLattice.baseChange_precomp, ← characterLattice.baseChangeEquiv_apply bK _
      d.maximalSplit.1.1, AddEquiv.apply_symm_apply, ← Category.assoc, h, Category.assoc]

/-- The integral pairing is unchanged by simultaneous transport along an isomorphism. -/
theorem latticePairing_transport {S S' : CommGroupScheme (Spec (CommRingCat.of k))}
    (ψ : S ≅ S') (x : characterLattice S) (ν : cocharacterLattice S) :
    latticePairing S' (ψ.inv ≫ x) (ν ≫ ψ.hom) = latticePairing S x ν := by
  simp only [latticePairing_apply, Category.assoc, Iso.hom_inv_id_assoc]

/-- A nonzero restriction of an absolute root is a relative root. -/
theorem rootRestriction_mem_relativeRoots (d : TitsIndexData G) {a : d.pinning.rootIndex}
    (ha : d.rootRestriction a ≠ 0) : d.rootRestriction a ∈ relativeRoots d.splitInclusion := by
  have h := (mem_roots_iff_exists_splittingField_restriction (K := SeparableClosure k)
    d.maximalSplit.1.1 d.pinning.isSplitTorus d.torusMap d.pinning.inclusion
    (d.rootRestriction a)).2 ⟨ha, d.pinning.rootDatum.root a, ?_, ?_⟩
  · rw [d.square] at h
    exact h
  · rw [← d.pinning.isRootDatum.2.1]
    exact ⟨a, rfl⟩
  · exact (AddEquiv.apply_symm_apply
      (characterLattice.baseChangeEquiv bK _ d.maximalSplit.1.1) _).symm

/-- After the dominant rational conjugation, positivity of an absolute root of `e` with
nonzero restriction agrees with positivity of the absolute root of `d` having the
transported restriction. -/
theorem isPos_iff_of_dominant (d e : TitsIndexData G) {ψ : d.splitTorus ≅ e.splitTorus}
    (hdom : ∀ α ∈ positiveRelativeRoots e.splitInclusion e.positiveCocharacter,
      0 ≤ latticePairing e.splitTorus α (d.positiveCocharacter ≫ ψ.hom))
    {a : d.pinning.rootIndex} {j : e.pinning.rootIndex}
    (hj : e.rootRestriction j = ψ.inv ≫ d.rootRestriction a) (ha : d.rootRestriction a ≠ 0) :
    e.pinning.base.IsPos j ↔ d.pinning.base.IsPos a := by
  have hG : IsConnectedReductive G := d.isSemisimple.isConnectedReductive
  have := e.maximalSplit.isSplitSubtorus.mono
  have hroot : HasRelativeRootSystem e.splitInclusion :=
    relativeRootSystem k G hG _ _ e.maximalSplit
  have hej : e.rootRestriction j ≠ 0 := by
    intro h0
    apply ha
    have h1 : ψ.hom ≫ e.rootRestriction j = d.rootRestriction a := by
      rw [hj, Iso.hom_inv_id_assoc]
    rw [← h1, h0, Limits.comp_zero]
  have hβ := rootRestriction_mem_relativeRoots e hej
  have hpair : latticePairing e.splitTorus (e.rootRestriction j)
      (d.positiveCocharacter ≫ ψ.hom) =
      latticePairing d.splitTorus (d.rootRestriction a) d.positiveCocharacter := by
    rw [hj, latticePairing_transport]
  have hne : latticePairing e.splitTorus (e.rootRestriction j)
      (d.positiveCocharacter ≫ ψ.hom) ≠ 0 := by
    rw [hpair]
    exact d.generic _ (rootRestriction_mem_relativeRoots d ha)
  rw [e.compatible j hej, d.compatible a ha]
  change 0 < latticePairing e.splitTorus (e.rootRestriction j) e.positiveCocharacter ↔
    0 < latticePairing d.splitTorus (d.rootRestriction a) d.positiveCocharacter
  rw [← hpair]
  constructor
  · intro h
    exact lt_of_le_of_ne (hdom _ ⟨hβ, h⟩) (Ne.symm hne)
  · intro h
    by_contra hn
    have hlt : latticePairing e.splitTorus (e.rootRestriction j) e.positiveCocharacter < 0 :=
      lt_of_le_of_ne (not_lt.1 hn) (e.generic _ hβ)
    have hneg := hroot.neg_mem_relativeRoots e.splitInclusion e.maximalSplit.1.1 hβ
    have h2 := hdom _ ⟨hneg, by rw [map_neg, LinearMap.neg_apply]; linarith⟩
    rw [map_neg, LinearMap.neg_apply] at h2
    linarith

/-- Two compatible choices admit a conjugating point over the separable closure whose
root-datum equivalence carries the chosen base to the chosen base and preserves the
vanishing of restrictions to the maximal split tori. -/
theorem exists_based_conj (d e : TitsIndexData G) :
    ∃ (g : Over.mk (𝟙 (Spec (CommRingCat.of (SeparableClosure k)))) ⟶
        ((GroupScheme.baseChange bK).obj G).X)
      (φ : d.pinning.toSplitPinning.torus ≅ e.pinning.toSplitPinning.torus)
      (ε : RootPairing.Equiv d.pinning.toSplitPinning.rootDatum
        e.pinning.toSplitPinning.rootDatum),
      d.pinning.toSplitPinning.inclusion ≫
          (((GroupScheme.baseChange bK).obj G).innerIso g).hom =
        CommGroupScheme.groupHom φ.hom ≫ e.pinning.toSplitPinning.inclusion ∧
      (∀ χ, ε.weightMap χ = φ.inv ≫ χ) ∧
      (∀ a, a ∈ d.pinning.toSplitPinning.base.support ↔
        ε.indexEquiv a ∈ e.pinning.toSplitPinning.base.support) ∧
      (∀ a, d.rootRestriction a = 0 ↔ e.rootRestriction (ε.indexEquiv a) = 0) := by
  obtain ⟨m, ψ, hm, hdom⟩ := exists_rational_conj d e
  obtain ⟨g₀, φ₀, hg₀, hφ₀⟩ := exists_conj_data d e hm
  obtain ⟨e₀, he₀⟩ := exists_equiv_of_conj d.pinning.toSplitPinning e.pinning.toSplitPinning hg₀
  have hres (j : d.pinning.toSplitPinning.rootIndex) (i : e.pinning.toSplitPinning.rootIndex)
      (hi : e.pinning.toSplitPinning.rootDatum.root i =
        φ₀.inv ≫ d.pinning.toSplitPinning.rootDatum.root j) :
      e.rootRestriction i = ψ.inv ≫ d.rootRestriction j := by
    change (characterLattice.baseChangeEquiv bK e.splitTorus e.maximalSplit.1.1).symm
        ((CommGroupScheme.baseChange bK).map e.torusMap ≫
          e.pinning.toSplitPinning.rootDatum.root i) = _
    rw [hi]
    exact restriction_transport d e hφ₀ _
  have hzero (j : d.pinning.toSplitPinning.rootIndex) :
      e.rootRestriction (e₀.indexEquiv j) = ψ.inv ≫ d.rootRestriction j := by
    exact hres j _ ((RootPairing.Hom.root_weightMap_apply _ _ j e₀.toHom).symm.trans (he₀ _))
  let r : characterLattice e.pinning.toSplitPinning.torus →+ characterLattice e.splitTorus :=
    AddMonoidHom.mk' (fun χ => (characterLattice.baseChangeEquiv bK e.splitTorus
      e.maximalSplit.1.1).symm ((CommGroupScheme.baseChange bK).map e.torusMap ≫ χ))
      (fun x y => by rw [Preadditive.comp_add, map_add])
  let s : Set e.pinning.toSplitPinning.rootIndex := {i | e.rootRestriction i = 0}
  have hrs : ∀ i ∈ s, r (e.pinning.toSplitPinning.rootDatum.root i) = 0 := fun i hi => hi
  have hinv : ∀ w ∈ Langlands.RootDatum.reflectionSubgroup
      e.pinning.toSplitPinning.rootDatum s, ∀ i,
        e.rootRestriction (w.indexEquiv i) = e.rootRestriction i := by
    intro w hw i
    have h := map_weightMap_of_mem_reflectionSubgroup e.pinning.toSplitPinning.rootDatum s r
      hrs hw (e.pinning.toSplitPinning.rootDatum.root i)
    have h2 : w.weightMap (e.pinning.toSplitPinning.rootDatum.root i) =
        e.pinning.toSplitPinning.rootDatum.root (w.indexEquiv i) :=
      RootPairing.Hom.root_weightMap_apply _ _ i w.toHom
    rw [h2] at h
    exact h
  have hs : ∀ w ∈ Langlands.RootDatum.reflectionSubgroup
      e.pinning.toSplitPinning.rootDatum s, ∀ j, w.indexEquiv (e₀.indexEquiv j) ∉ s →
        (e.pinning.toSplitPinning.base.IsPos (w.indexEquiv (e₀.indexEquiv j)) ↔
          d.pinning.toSplitPinning.base.IsPos j) := by
    intro w hw j hj
    have h1 : e.rootRestriction (w.indexEquiv (e₀.indexEquiv j)) =
        ψ.inv ≫ d.rootRestriction j := by
      rw [hinv w hw, hzero]
    have ha : d.rootRestriction j ≠ 0 := by
      intro h0
      apply hj
      change e.rootRestriction _ = 0
      rw [h1, h0, Limits.comp_zero]
    exact isPos_iff_of_dominant d e hdom h1 ha
  obtain ⟨w, hw, hpos⟩ := exists_reflection_comp_isPos d.pinning.toSplitPinning
    e.pinning.toSplitPinning e₀ s hs
  obtain ⟨g, φ, hg, he⟩ := exists_conj_comp_weyl d.pinning.toSplitPinning
    e.pinning.toSplitPinning hg₀ e₀ he₀
    (Langlands.RootDatum.reflectionSubgroup_le_weylGroup _ s hw)
  refine ⟨g, φ, RootPairing.Equiv.comp w e₀, hg, he,
    mem_support_iff_of_isPos _ _ _ hpos, fun a => ?_⟩
  change d.rootRestriction a = 0 ↔ e.rootRestriction (w.indexEquiv (e₀.indexEquiv a)) = 0
  rw [hinv w hw, hzero]
  constructor
  · intro h
    rw [h, Limits.comp_zero]
  · intro h
    have h' := congrArg (fun y => ψ.hom ≫ y) h
    simpa only [Iso.hom_inv_id_assoc, Limits.comp_zero] using h'

end Data

end TitsIndexIndependence

open TitsIndexIndependence in
/-- **Independence of the actual Tits index.** Any two compatible choices for the same
semisimple field group give equivalent indices. -/
theorem titsIndexIndependence : TitsIndexIndependenceStatement.{u} := by
  intro k _ G _ _ d e
  obtain ⟨g, φ, ε, hg, he, hb, hz⟩ := exists_based_conj d e
  refine ⟨{
    vertices := ε.indexEquiv.subtypeEquiv hb
    cartan_eq := fun a b => RootPairing.Hom.pairing ε.toHom
    zero_iff := fun a => hz a.val
    star_eq := fun σ a => Subtype.ext ?_ }⟩
  exact congrArg (fun x => x.indexEquiv a.val)
    (StarActionIndependence.starAction_intertwine d.pinning e.pinning ε hg he hb σ)

end Langlands.GroupScheme
