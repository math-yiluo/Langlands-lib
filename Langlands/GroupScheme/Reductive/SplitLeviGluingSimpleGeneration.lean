/-! # Generation by the simple-root Levi subgroups

A closed subgroup of a smooth connected affine group containing the root subgroups of the
simple roots of a generic cocharacter, their negatives, and the centralizer of the cocharacter
is the whole group. -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.LeviGluing

section Lattice

variable {X : Type*} [AddCommGroup X] (f : X →+ ℤ)

/-- On the additive monoid generated by a set where `f` is positive, `f` is nonnegative and
vanishes only at zero. -/
theorem closure_nonneg_and_eq_zero {s : Set X} (hs : ∀ b ∈ s, 0 < f b) {c : X}
    (hc : c ∈ AddSubmonoid.closure s) : 0 ≤ f c ∧ (f c = 0 → c = 0) := by
  induction hc using AddSubmonoid.closure_induction with
  | mem b hb => exact ⟨(hs b hb).le, fun h => absurd h (hs b hb).ne'⟩
  | zero => exact ⟨by simp, fun _ => rfl⟩
  | add x y _ _ hx hy =>
    refine ⟨by rw [map_add]; exact add_nonneg hx.1 hy.1, fun h => ?_⟩
    rw [map_add] at h
    rw [hx.2 (by linarith [hx.1, hy.1]), hy.2 (by linarith [hx.1, hy.1]), add_zero]

/-- If `x` and `z • a - x` both lie in the additive monoid generated by a linearly independent
set `Δ` of `f`-positive elements containing `a`, then `x` is a natural multiple of `a`. -/
theorem exists_eq_nsmul_of_mem_closure {Δ : Set X}
    (hli : LinearIndependent ℤ (fun b : Δ => (b : X))) (hpos : ∀ b ∈ Δ, 0 < f b)
    {a x : X} (ha : a ∈ Δ) (z : ℤ) (hx : x ∈ AddSubmonoid.closure Δ)
    (hy : z • a - x ∈ AddSubmonoid.closure Δ) : ∃ n : ℕ, x = n • a := by
  have hsplit : AddSubmonoid.closure Δ =
      AddSubmonoid.closure {a} ⊔ AddSubmonoid.closure (Δ \ {a}) := by
    rw [← AddSubmonoid.closure_union, Set.union_sdiff_cancel (Set.singleton_subset_iff.mpr ha)]
  rw [hsplit, AddSubmonoid.mem_sup] at hx hy
  obtain ⟨u, hu, c, hc, rfl⟩ := hx
  obtain ⟨n, rfl⟩ := AddSubmonoid.mem_closure_singleton.mp hu
  obtain ⟨u', hu', c', hc', hy⟩ := hy
  obtain ⟨m, rfl⟩ := AddSubmonoid.mem_closure_singleton.mp hu'
  have hc'' : c' = z • a - (n • a + c) - m • a := by rw [← hy]; abel
  have hsum : c + c' = (z - n - m) • a := by
    rw [hc'', sub_smul, sub_smul, natCast_zsmul, natCast_zsmul]
    abel
  have himg : (fun b : Δ => (b : X)) '' (Set.univ \ {⟨a, ha⟩}) = Δ \ {a} := by
    ext y
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact ⟨b.2, fun h => hb.2 (Subtype.ext h)⟩
    · rintro ⟨hy, hya⟩
      exact ⟨⟨y, hy⟩, ⟨Set.mem_univ _, fun h => hya (congrArg Subtype.val h)⟩, rfl⟩
  have hle : AddSubmonoid.closure (Δ \ {a}) ≤ (Submodule.span ℤ (Δ \ {a})).toAddSubmonoid :=
    AddSubmonoid.closure_le.mpr Submodule.subset_span
  have hspan : (z - n - m) • a ∈
      Submodule.span ℤ ((fun b : Δ => (b : X)) '' (Set.univ \ {⟨a, ha⟩})) := by
    rw [himg, ← hsum]
    exact (Submodule.span ℤ (Δ \ {a})).add_mem (hle hc) (hle hc')
  have hz := hli.eq_zero_of_smul_mem_span ⟨a, ha⟩ (z - n - m) hspan
  rw [hz, zero_smul] at hsum
  have hpos' : ∀ b ∈ Δ \ {a}, 0 < f b := fun b hb => hpos b hb.1
  have h1 := closure_nonneg_and_eq_zero f hpos' hc
  have h2 := closure_nonneg_and_eq_zero f hpos' hc'
  have hf : f c + f c' = 0 := by rw [← map_add, hsum, map_zero]
  refine ⟨n, ?_⟩
  rw [h1.2 (by linarith [h1.1, h2.1]), add_zero]

end Lattice

section Combinatorics

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom]
    (i : T.toGrp ⟶ G) {J : Type v}

/-- The character lattice carrying a root datum is torsion free, since its pairing with the
cocharacter lattice is perfect. -/
theorem isAddTorsionFree_of_rootDatum
    (P : RootDatum J (characterLattice T) (cocharacterLattice T)) :
    IsAddTorsionFree (characterLattice T) := by
  refine ⟨fun n hn x y hxy => ?_⟩
  apply (LinearMap.IsPerfPair.bijective_left P.toLinearMap).injective
  apply LinearMap.ext
  intro c
  have h := congrArg (fun z => P.toLinearMap z c) hxy
  simp only [map_nsmul, LinearMap.smul_apply] at h
  exact nsmul_right_injective hn h

variable (P : RootDatum J (characterLattice T) (cocharacterLattice T))

/-- Two linearly dependent roots `α = P.root j` and `β = P.root l` satisfy
`⟨β, α^∨⟩ α = 2 β`, `⟨α, β^∨⟩ β = 2 α` and `⟨β, α^∨⟩ ⟨α, β^∨⟩ = 4`. -/
theorem pairing_relations_of_not_linearIndependent {j l : J}
    (h : ¬ LinearIndependent ℤ ![P.root j, P.root l]) :
    P.pairing l j • P.root j = (2 : ℤ) • P.root l ∧
      P.pairing j l • P.root l = (2 : ℤ) • P.root j ∧
        P.pairing l j * P.pairing j l = 4 := by
  have := isAddTorsionFree_of_rootDatum P
  have h₁ := P.pairing_smul_root_eq_of_not_linearIndependent h
  have h' : ¬ LinearIndependent ℤ ![P.root l, P.root j] := by
    rwa [LinearIndependent.pair_symm_iff]
  have h₂ := P.pairing_smul_root_eq_of_not_linearIndependent h'
  refine ⟨h₁, h₂, ?_⟩
  have h₃ : (P.pairing l j * P.pairing j l) • P.root j = (4 : ℤ) • P.root j := by
    rw [mul_comm, mul_smul, h₁, smul_comm, h₂, smul_smul]
    norm_num
  exact smul_left_injective ℤ (P.ne_zero j) h₃

/-- A positive integer dividing `4` is `1`, `2` or `4`. -/
theorem eq_one_or_two_or_four_of_mul_eq_four {p q : ℤ} (hp : 0 < p) (h : p * q = 4) :
    p = 1 ∨ p = 2 ∨ p = 4 := by
  have hq : 0 < q := by
    by_contra hq
    push Not at hq
    nlinarith
  have hp4 : p ≤ 4 := by nlinarith
  interval_cases p <;> omega

variable {i P}

theorem exists_root_eq (hP : IsRootDatumOf i P) {χ : characterLattice T} (hχ : χ ∈ roots i) :
    ∃ j : J, P.root j = χ := by
  rw [← hP.2.1] at hχ
  exact hχ

theorem latticePairing_smul_left (χ : characterLattice T) (ν : cocharacterLattice T) (p : ℤ) :
    latticePairing T (p • χ) ν = p * latticePairing T χ ν := by
  rw [map_zsmul, LinearMap.smul_apply, smul_eq_mul]

variable (ν : cocharacterLattice T)

/-- A root that is linearly dependent on a simple root and positive on the chamber is that
simple root or its double. The half of a simple root is excluded because a simple root is not
a sum of two positive roots. -/
theorem eq_or_eq_two_smul_of_simple_of_not_linearIndependent (hP : IsRootDatumOf i P)
    {a χ : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν) (hχ : χ ∈ roots i)
    (hχν : 0 < latticePairing T χ ν) (hdep : ¬ LinearIndependent ℤ ![a, χ]) :
    χ = a ∨ χ = 2 • a := by
  have := isAddTorsionFree_of_rootDatum P
  obtain ⟨j, rfl⟩ := exists_root_eq hP ha.1.1
  obtain ⟨l, rfl⟩ := exists_root_eq hP hχ
  obtain ⟨h₁, -, h₃⟩ := pairing_relations_of_not_linearIndependent P hdep
  have hpair := congrArg (fun x => latticePairing T x ν) h₁
  simp only [latticePairing_smul_left] at hpair
  have hpos : 0 < P.pairing l j := by
    have haν : 0 < latticePairing T (P.root j) ν := ha.1.2
    nlinarith
  rcases eq_one_or_two_or_four_of_mul_eq_four hpos h₃ with hp | hp | hp
  · exfalso
    rw [hp, one_smul, two_zsmul] at h₁
    exact ha.2 ⟨P.root l, ⟨⟨hχ, hχν⟩, P.root l, ⟨hχ, hχν⟩, h₁⟩⟩
  · left
    rw [hp] at h₁
    exact (smul_right_injective _ (two_ne_zero : (2 : ℤ) ≠ 0) h₁).symm
  · right
    rw [hp, show (4 : ℤ) = 2 * 2 by norm_num, mul_smul] at h₁
    rw [two_nsmul, ← two_zsmul]
    exact (smul_right_injective _ (two_ne_zero : (2 : ℤ) ≠ 0) h₁).symm

/-- The pairing of a realizing root datum is the lattice pairing. -/
theorem pairing_eq_latticePairing (hP : IsRootDatumOf i P) (j l : J) :
    P.pairing l j = latticePairing T (P.root l) (P.coroot j) := by
  rw [← P.root_coroot_eq_pairing, hP.1]

/-- The roots of a realizing root datum are stable under negation. -/
theorem neg_mem_roots (hP : IsRootDatumOf i P) {χ : characterLattice T} (hχ : χ ∈ roots i) :
    -χ ∈ roots i := by
  obtain ⟨l, rfl⟩ := exists_root_eq hP hχ
  rw [← hP.2.1]
  exact ⟨P.reflectionPerm l l, by rw [P.root_reflectionPerm, P.reflection_apply_self]⟩

/-- The roots of a realizing root datum are stable under its reflections. -/
theorem reflection_mem_roots (hP : IsRootDatumOf i P) (j : J) {χ : characterLattice T}
    (hχ : χ ∈ roots i) : P.reflection j χ ∈ roots i := by
  obtain ⟨l, rfl⟩ := exists_root_eq hP hχ
  rw [← hP.2.1]
  exact ⟨P.reflectionPerm j l, P.root_reflectionPerm j l⟩

/-- Distinct indivisible roots positive on a cocharacter have disjoint positive rays. -/
theorem disjoint_cyclicTail (hP : IsRootDatumOf i P) (ζ : cocharacterLattice T)
    {a b : characterLattice T} (ha : a ∈ RelativeRoot.indivisiblePositiveRoots i ζ)
    (hb : b ∈ RelativeRoot.indivisiblePositiveRoots i ζ) (hne : a ≠ b) :
    Disjoint (RelativeRoot.cyclicTail a 1 : Set (characterLattice T))
      (RelativeRoot.cyclicTail b 1 : Set (characterLattice T)) := by
  have := isAddTorsionFree_of_rootDatum P
  rw [Set.disjoint_left]
  rintro χ ⟨n, -, hn, rfl⟩ ⟨m, -, -, hmb⟩
  obtain ⟨j, rfl⟩ := exists_root_eq hP ha.1.1
  obtain ⟨l, rfl⟩ := exists_root_eq hP hb.1.1
  have hdep : ¬ LinearIndependent ℤ ![P.root j, P.root l] := by
    intro h
    have := (LinearIndependent.pair_iff.mp h (n : ℤ) (-(m : ℤ))
      (by rw [neg_smul, natCast_zsmul, natCast_zsmul, hmb, add_neg_cancel])).1
    omega
  obtain ⟨h₁, -, h₃⟩ := pairing_relations_of_not_linearIndependent P hdep
  have hpair := congrArg (fun x => latticePairing T x ζ) h₁
  simp only [latticePairing_smul_left] at hpair
  have hpos : 0 < P.pairing l j := by
    have := ha.2
    have := hb.2
    nlinarith
  rcases eq_one_or_two_or_four_of_mul_eq_four hpos h₃ with hp | hp | hp
  · rw [hp, one_smul] at h₁
    exact ha.1.2 (P.root l) hb.1.1 2 one_lt_two (by rw [h₁, two_zsmul, two_nsmul])
  · rw [hp] at h₁
    exact hne (smul_right_injective _ (two_ne_zero : (2 : ℤ) ≠ 0) h₁)
  · rw [hp, show (4 : ℤ) = 2 * 2 by norm_num, mul_smul] at h₁
    have h' := smul_right_injective _ (two_ne_zero : (2 : ℤ) ≠ 0) h₁
    exact hb.1.2 (P.root j) ha.1.1 2 one_lt_two (by rw [← h', two_zsmul, two_nsmul])

end Combinatorics

section Positive

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
    {i : T.toGrp ⟶ G} {J : Type v}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)}
    (hP : IsRootDatumOf i P) (hT : IsSplitTorus T.toGrp) {ν : cocharacterLattice T}

include hP hT

/-- Every positive root lies in the additive monoid generated by the simple roots. -/
theorem mem_closure_simple_of_positive {χ : characterLattice T}
    (hχ : χ ∈ positiveRelativeRoots i ν) :
    χ ∈ AddSubmonoid.closure (simpleRelativeRoots i ν) := by
  rw [closure_simpleRoots_eq_positive i P hP ν hT]
  exact AddSubmonoid.subset_closure hχ

/-- A positive root pairs positively with the coroot of some simple root. -/
theorem exists_simple_pairing_pos {l : J} (hl : P.root l ∈ positiveRelativeRoots i ν) :
    ∃ j : J, P.root j ∈ simpleRelativeRoots i ν ∧ 0 < P.pairing l j := by
  have : Finite J := finite_rootIndex i P hP hT
  have hin : ∀ a b : J, P.pairingIn ℤ a b = P.pairing a b := fun a b => by
    have := P.algebraMap_pairingIn ℤ a b
    rwa [Algebra.algebraMap_self, RingHom.id_apply] at this
  by_contra h
  push Not at h
  have hsym : ∀ j : J, P.root j ∈ simpleRelativeRoots i ν → P.pairing j l ≤ 0 := by
    intro j hj
    by_contra hpos
    push Not at hpos
    have hiff := P.zero_lt_pairingIn_iff' ℤ (i := j) (j := l)
    rw [hin, hin] at hiff
    exact absurd (hiff.mp hpos) (not_lt.mpr (h j hj))
  let g : characterLattice T →+ ℤ := (P.toLinearMap.flip (P.coroot l)).toAddMonoidHom
  have hg : ∀ x ∈ AddSubmonoid.closure (simpleRelativeRoots i ν), g x ≤ 0 := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction with
    | mem b hb =>
      obtain ⟨j, rfl⟩ := exists_root_eq hP hb.1.1
      change P.toLinearMap (P.root j) (P.coroot l) ≤ 0
      rw [P.root_coroot_eq_pairing]
      exact hsym j hb
    | zero => simp
    | add x y _ _ hx hy => rw [map_add]; exact add_nonpos hx hy
  have h2 := hg _ (mem_closure_simple_of_positive hP hT hl)
  have h3 : g (P.root l) = 2 := (P.root_coroot_eq_pairing l l).trans (P.pairing_same l)
  omega

/-- Reflecting a positive root in a simple root that is linearly independent from it gives a
positive root. -/
theorem reflection_mem_positive (hν : IsGenericCocharacter i ν) {j l : J}
    (hj : P.root j ∈ simpleRelativeRoots i ν) (hl : P.root l ∈ positiveRelativeRoots i ν)
    (hind : LinearIndependent ℤ ![P.root j, P.root l]) :
    P.reflection j (P.root l) ∈ positiveRelativeRoots i ν := by
  have hr : P.reflection j (P.root l) ∈ roots i := reflection_mem_roots hP j hl.1
  refine ⟨hr, ?_⟩
  rcases lt_trichotomy 0 (latticePairing T (P.reflection j (P.root l)) ν) with h | h | h
  · exact h
  · exact absurd h.symm (hν _ hr)
  · exfalso
    have hneg : -(P.reflection j (P.root l)) ∈ positiveRelativeRoots i ν :=
      ⟨neg_mem_roots hP hr, by rw [map_neg, LinearMap.neg_apply]; linarith⟩
    rw [P.reflection_apply_root, neg_sub] at hneg
    obtain ⟨n, hn⟩ := exists_eq_nsmul_of_mem_closure ((latticePairing T).flip ν).toAddMonoidHom
      (linearIndependent_simpleRoots i P hP ν hT hν) (fun b hb => hb.1.2) hj (P.pairing l j)
      (mem_closure_simple_of_positive hP hT hl) (mem_closure_simple_of_positive hP hT hneg)
    have := (LinearIndependent.pair_iff.mp hind (n : ℤ) (-1)
      (by rw [hn, natCast_zsmul, neg_one_zsmul, add_neg_cancel])).2
    exact absurd this (by norm_num)

/-- Induction over the positive roots: a property of characters holding on the simple roots,
passing from a simple root to its double, and stable under the simple reflections, holds on
every positive root. No reducedness is assumed. -/
theorem positive_induction (hν : IsGenericCocharacter i ν) (Q : characterLattice T → Prop)
    (h1 : ∀ a ∈ simpleRelativeRoots i ν, Q a)
    (h2 : ∀ a ∈ simpleRelativeRoots i ν, Q a → Q (2 • a))
    (h3 : ∀ j : J, P.root j ∈ simpleRelativeRoots i ν → ∀ χ, Q χ → Q (P.reflection j χ)) :
    ∀ χ ∈ positiveRelativeRoots i ν, Q χ := by
  suffices h : ∀ N : ℕ, ∀ χ ∈ positiveRelativeRoots i ν, latticePairing T χ ν ≤ N → Q χ by
    intro χ hχ
    obtain ⟨N, hN⟩ := Int.eq_ofNat_of_zero_le hχ.2.le
    exact h N χ hχ hN.le
  intro N
  induction N with
  | zero =>
    intro χ hχ hle
    have := hχ.2
    push_cast at hle
    omega
  | succ N ih =>
    intro χ hχ hle
    obtain ⟨l, rfl⟩ := exists_root_eq hP hχ.1
    obtain ⟨j, hj, hp⟩ := exists_simple_pairing_pos hP hT hχ
    by_cases hind : LinearIndependent ℤ ![P.root j, P.root l]
    · have hpos := reflection_mem_positive hP hT hν hj hχ hind
      have hle' : latticePairing T (P.reflection j (P.root l)) ν ≤ N := by
        rw [P.reflection_apply_root, map_sub, LinearMap.sub_apply, latticePairing_smul_left]
        have := mul_pos hp hj.1.2
        push_cast at hle
        linarith
      have := h3 j hj _ (ih _ hpos hle')
      rwa [P.reflection_same] at this
    · rcases eq_or_eq_two_smul_of_simple_of_not_linearIndependent ν hP hj hχ.1 hχ.2 hind
        with h | h
      · rw [h]
        exact h1 _ hj
      · rw [h]
        exact h2 _ hj (h1 _ hj)

end Positive

section Weyl

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom]
    {i : T.toGrp ⟶ G} {J : Type v}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)}

/-- The root subgroup of the double of a nonzero character lies in the root subgroup of the
character: both are first weight filtrations, and the positive multiples of `2 • a` are positive
multiples of `a`. -/
theorem subgroup_two_nsmul_le [Smooth G.X.hom] [IsAddTorsionFree (characterLattice T)]
    (hT : IsSplitTorus T.toGrp) (i : T.toGrp ⟶ G) {a : characterLattice T} (ha : a ≠ 0) :
    RelativeRoot.subgroup i (2 • a) ≤ RelativeRoot.subgroup i a := by
  have h2 : 2 • a ≠ 0 := fun h =>
    ha (nsmul_right_injective two_ne_zero (h.trans (nsmul_zero 2).symm))
  rw [← RelativeRoot.weightFiltration_one_eq_subgroup hT i a ha,
    ← RelativeRoot.weightFiltration_one_eq_subgroup hT i (2 • a) h2]
  apply RelativeRoot.semigroupSubgroup_mono
  rintro χ ⟨n, -, hn, rfl⟩
  exact ⟨2 * n, by omega, by omega, by rw [smul_smul, mul_comm]⟩

omit [IsAffineHom G.X.hom] in
/-- A subgroup functor containing the constant points of a normalizing point and the root
subgroup of `χ` contains the root subgroup of the Weyl translate of `χ`. -/
theorem subgroup_weylAction_le [Mono i.hom.hom.left] {F : SubgroupFunctor G}
    (n : normalizerPoints i) (hn : ∀ U, G.constantPoint n U ∈ F.carrier U)
    {χ : characterLattice T} (h : RelativeRoot.subgroup i χ ≤ F) :
    RelativeRoot.subgroup i (weylAction i n χ) ≤ F := by
  intro U g hg
  have hg' : (G.constantPoint n U)⁻¹ * g * G.constantPoint n U ∈
      (RelativeRoot.subgroup i χ).carrier U := by
    apply (RelativeRoot.normalizer_conj_mem_iff i χ n _).mp
    simpa [mul_assoc] using hg
  have hmem := (F.carrier U).mul_mem ((F.carrier U).mul_mem (hn U) (h U hg'))
    ((F.carrier U).inv_mem (hn U))
  simpa [mul_assoc] using hmem

/-- The automorphism of the torus inducing the reflection in a root fixes every cocharacter
orthogonal to that root. -/
theorem cocharacter_comp_eq_of_reflection (hP : IsRootDatumOf i P) {j : J} {σ : T ≅ T}
    (hσ : characterAut σ = P.reflection j) {ζ : cocharacterLattice T}
    (hζ : latticePairing T (P.root j) ζ = 0) : ζ ≫ σ.hom = ζ := by
  apply (LinearMap.IsPerfPair.bijective_right P.toLinearMap).injective
  apply LinearMap.ext
  intro χ
  rw [LinearMap.flip_apply, LinearMap.flip_apply, hP.1]
  have hχ : σ.hom ≫ χ = P.reflection j χ := by
    have h := DFunLike.congr_fun hσ (σ.hom ≫ χ)
    rw [characterAut_apply, Iso.inv_hom_id_assoc] at h
    calc σ.hom ≫ χ = P.reflection j (P.reflection j (σ.hom ≫ χ)) := by
          rw [P.reflection_same]
      _ = P.reflection j χ := by rw [← h]
  calc latticePairing T χ (ζ ≫ σ.hom) = latticePairing T (σ.hom ≫ χ) ζ := by
        simp only [latticePairing_apply, Category.assoc]
    _ = latticePairing T χ ζ := by
        rw [hχ, P.reflection_apply, map_sub, LinearMap.sub_apply, latticePairing_smul_left,
          hζ, mul_zero, sub_zero]

omit [IsAffineHom G.X.hom] in
/-- A point normalizing the torus through an automorphism fixing `ζ` centralizes the
cocharacter `ζ`. -/
theorem constantPoint_mem_centralizer {n : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X}
    {σ : T ≅ T} (hn : IsNormalizingPoint i n σ) {ζ : cocharacterLattice T}
    (hζ : ζ ≫ σ.hom = ζ) (U : Over (Spec (CommRingCat.of k))) :
    G.constantPoint n U ∈
      (Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i)).carrier U := by
  rw [← torusCentralizer_gm_eq_dynamicCentralizer]
  have h0 : n ∈ (torusCentralizer (CommGroupScheme.groupHom ζ ≫ i)).carrier
      (Over.mk (𝟙 _)) := by
    rw [mem_torusCentralizer_base_iff, Category.assoc, hn, ← Category.assoc]
    change CommGroupScheme.groupHom (ζ ≫ σ.hom) ≫ i = _
    rw [hζ]
  have h1 := (torusCentralizer (CommGroupScheme.groupHom ζ ≫ i)).comp_mem
    (Over.homMk U.hom (by simp) : U ⟶ Over.mk (𝟙 (Spec (CommRingCat.of k)))) h0
  exact h1

/-- Each reflection of a realizing root datum is the Weyl action of a normalizing point that
centralizes every cocharacter orthogonal to the reflected root. -/
theorem exists_normalizer_reflection [Mono i.hom.hom.left] (hP : IsRootDatumOf i P) (j : J)
    {ζ : cocharacterLattice T} (hζ : latticePairing T (P.root j) ζ = 0) :
    ∃ n : normalizerPoints i, (∀ χ, weylAction i n χ = P.reflection j χ) ∧
      ∀ U, G.constantPoint n U ∈
        (Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i)).carrier U := by
  obtain ⟨n, σ, hn, hσ⟩ := hP.2.2 j
  refine ⟨⟨n, σ, hn⟩, fun χ => ?_,
    constantPoint_mem_centralizer hn (cocharacter_comp_eq_of_reflection hP hσ hζ)⟩
  rw [weylAction_eq i (n := ⟨n, σ, hn⟩) hn χ, ← characterAut_apply, hσ]

end Weyl

section Geometry

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}

/-- An isomorphism of group schemes has full range on every test scheme. -/
theorem range_eq_top_of_isIso {H : GroupScheme (Spec (CommRingCat.of k))} (d : H ⟶ G)
    [IsIso d] : SubgroupFunctor.range d = ⊤ := by
  apply SubgroupFunctor.ext
  intro U
  apply Subgroup.ext
  intro x
  refine ⟨fun _ => Subgroup.mem_top _, fun _ => SubgroupFunctor.mem_range.mpr
    ⟨x ≫ (inv d).hom.hom, ?_⟩⟩
  rw [Category.assoc, ← Grp.comp_hom_hom, IsIso.inv_hom_id, Grp.id_hom_hom, Category.comp_id]

/-- A smooth connected affine group `Z` mapping to `G` lands in a closed subgroup `q` as soon
as the preimage of `q` contains the three dynamic factors of one cocharacter of `Z`. -/
theorem range_le_of_dynamicFactors {Z K : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth Z.X.hom] [IsAffineHom Z.X.hom] [ConnectedSpace Z.X.left]
    (z : Z ⟶ G) (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (χ : (Gm (Spec (CommRingCat.of k))).toGrp ⟶ Z)
    (hM : Dynamic.unipotent (CommGroupScheme.groupHom
      (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫ χ) ≤ (SubgroupFunctor.range q).comap z)
    (hZ : Dynamic.centralizer χ ≤ (SubgroupFunctor.range q).comap z)
    (hU : Dynamic.unipotent χ ≤ (SubgroupFunctor.range q).comap z) :
    SubgroupFunctor.range z ≤ SubgroupFunctor.range q := by
  rw [← range_subgroupIntersectionFst_eq_comap] at hM hZ hU
  have := Dynamic.isIso_of_contains_dynamicFactors χ (subgroupIntersectionFst z q)
    (isClosedSubgroup_subgroupIntersectionFst z hq) hM hZ hU
  rw [SubgroupFunctor.range_le_iff_comap_eq_top, ← range_subgroupIntersectionFst_eq_comap]
  exact range_eq_top_of_isIso _

variable [Smooth G.X.hom] [IsAffineHom G.X.hom] {i : T.toGrp ⟶ G}

/-- Let `z : Z ⟶ G` be a closed subgroup through which the split torus acts, and `ζ` a
cocharacter. If every root of `Z` positive on `ζ` is a positive multiple of a nonzero
character `b`, then the dynamic unipotent subgroup of `ζ` in `Z` maps into every subgroup
functor of `G` containing the root subgroup of `b`. -/
theorem unipotent_le_comap_of_support {Z : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth Z.X.hom] [IsAffineHom Z.X.hom] [ConnectedSpace Z.X.left]
    (hT : IsSplitTorus T.toGrp) (z : Z ⟶ G) (hzc : IsClosedSubgroup z)
    (t : T.toGrp ⟶ Z) (ht : t ≫ z = i) (ζ : cocharacterLattice T)
    {b : characterLattice T} (hb : b ≠ 0)
    (hsupp : ∀ χ ∈ relativeRoots t, 0 < latticePairing T χ ζ →
      χ ∈ RelativeRoot.cyclicTail b 1)
    {F : SubgroupFunctor G} (hF : RelativeRoot.subgroup i b ≤ F) :
    Dynamic.unipotent (CommGroupScheme.groupHom ζ ≫ t) ≤ F.comap z := by
  rw [(RelativeRoot.dynamicSemigroupComparison k Z inferInstance inferInstance inferInstance
    T hT t ζ).2.2]
  have hmono : RelativeRoot.semigroupSubgroup (AutomorphicAction.conjugation t)
      (RelativeRoot.positiveSemigroup ζ) ≤
      RelativeRoot.semigroupSubgroup (AutomorphicAction.conjugation t)
        (RelativeRoot.cyclicTail b 1) := by
    apply RelativeRoot.semigroupSubgroup_mono_on_weightSupport
    intro χ hχ hpos
    have hpos' : 0 < latticePairing T χ ζ := hpos
    have hχ0 : χ ≠ 0 := by
      rintro rfl
      simp at hpos'
    exact hsupp χ ((RelativeRoot.mem_actionWeightSupport_conjugation_iff t hχ0).mp hχ) hpos'
  have hmap := RelativeRoot.semigroupSubgroup_map_le z hzc (AutomorphicAction.conjugation t)
    (AutomorphicAction.conjugation i)
    (fun _ s x => by rw [AutomorphicAction.conjugation_act_comp, ht])
    (RelativeRoot.cyclicTail b 1)
  have hfil : RelativeRoot.semigroupSubgroup (AutomorphicAction.conjugation i)
      (RelativeRoot.cyclicTail b 1) = RelativeRoot.subgroup i b :=
    RelativeRoot.weightFiltration_one_eq_subgroup hT i b hb
  rw [hfil] at hmap
  exact hmono.trans (SubgroupFunctor.map_le_iff_le_comap.mp (hmap.trans hF))

variable {J : Type v} {P : RootDatum J (characterLattice T) (cocharacterLattice T)}

omit [Smooth G.X.hom] in
/-- A root positive on the chamber and dependent on a simple root `a` lies in the positive
ray of `a`. -/
theorem mem_cyclicTail_of_not_linearIndependent (hP : IsRootDatumOf i P)
    {ν : cocharacterLattice T} {a χ : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν)
    (hχ : χ ∈ roots i) (hχν : 0 < latticePairing T χ ν)
    (hdep : ¬ LinearIndependent ℤ ![a, χ]) : χ ∈ RelativeRoot.cyclicTail a 1 := by
  rcases eq_or_eq_two_smul_of_simple_of_not_linearIndependent ν hP ha hχ hχν hdep with h | h
  · exact ⟨1, le_rfl, one_pos, by rw [h, one_nsmul]⟩
  · exact ⟨2, by norm_num, two_pos, h.symm⟩

variable [ConnectedSpace G.X.left]

/-- **Centralizer of a simple root's kernel.** Let `a` be a simple root for `ν` and `ζ` a
cocharacter such that every root orthogonal to `ζ` is linearly dependent on `a`. A closed
subgroup `q` containing the root subgroups of `a` and `-a` and the centralizer of `ν` contains
the centralizer of `ζ`. -/
theorem centralizer_le_range_of_simple (hP : IsRootDatumOf i P) (hT : IsSplitTorus T.toGrp)
    {ν ζ : cocharacterLattice T} {a : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν)
    (hdep : ∀ χ ∈ roots i, latticePairing T χ ζ = 0 → ¬ LinearIndependent ℤ ![a, χ])
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (hpos : RelativeRoot.subgroup i a ≤ SubgroupFunctor.range q)
    (hneg : RelativeRoot.subgroup i (-a) ≤ SubgroupFunctor.range q)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q) :
    Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i) ≤ SubgroupFunctor.range q := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have ha0 : a ≠ 0 := ha.1.1.1
  let z := Dynamic.Affine.centralizerHom (CommGroupScheme.groupHom ζ ≫ i)
  have hz : (Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i)).IsRepresentedBy z :=
    Dynamic.Affine.isRepresentedBy_centralizerHom _
  have hzc : IsClosedSubgroup z := Dynamic.Affine.isClosedSubgroup_centralizerHom _
  let : IsAffineHom (Dynamic.Affine.centralizerScheme
    (CommGroupScheme.groupHom ζ ≫ i)).X.hom := hzc.isAffineHom
  let : Smooth (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ζ ≫ i)).X.hom :=
    (dynamicSmooth k G _ _ z).2.1 hz
  let : ConnectedSpace
      (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ζ ≫ i)).X.left :=
    DynamicConnected.connectedSpace_of_isRepresentedBy_centralizer G _ hz
  let t := Dynamic.torusFactor i (CommGroupScheme.groupHom ζ) hz
  have ht : t ≫ z = i := Dynamic.torusFactor_comp _ _ _
  have hroots : ∀ χ ∈ relativeRoots t, χ ∈ roots i ∧ latticePairing T χ ζ = 0 :=
    fun χ hχ => ⟨relativeRoots_subset_of_factor hz t ht hχ,
      relativeRoot_pairing_eq_zero_of_le_dynamicCentralizer hz t ht ζ le_rfl hχ⟩
  rw [← hz.2]
  apply range_le_of_dynamicFactors z q hq (CommGroupScheme.groupHom ν ≫ t)
  · have h := unipotent_le_comap_of_support hT z hzc t ht (-ν) (neg_ne_zero.mpr ha0)
      (fun χ hχ hχν => by
        obtain ⟨hχi, hχζ⟩ := hroots χ hχ
        have hχν' : 0 < latticePairing T (-χ) ν := by
          rw [map_neg, LinearMap.neg_apply]
          rw [map_neg] at hχν
          linarith
        have hmem := mem_cyclicTail_of_not_linearIndependent hP ha (neg_mem_roots hP hχi) hχν'
          (hdep _ (neg_mem_roots hP hχi) (by rw [map_neg, LinearMap.neg_apply, hχζ, neg_zero]))
        obtain ⟨n, hn1, hn0, hn⟩ := hmem
        exact ⟨n, hn1, hn0, by rw [smul_neg, hn, neg_neg]⟩) hneg
    rwa [groupHom_neg_comp_eq_oppositeCocharacter] at h
  · intro U g hg
    have heq : (CommGroupScheme.groupHom ν ≫ t) ≫ z = CommGroupScheme.groupHom ν ≫ i := by
      rw [Category.assoc, ht]
    have h1 := Dynamic.centralizer_le_comap (CommGroupScheme.groupHom ν ≫ t) z U hg
    rw [heq] at h1
    exact hZ U h1
  · exact unipotent_le_comap_of_support hT z hzc t ht ν ha0
      (fun χ hχ hχν => mem_cyclicTail_of_not_linearIndependent hP ha (hroots χ hχ).1 hχν
        (hdep χ (hroots χ hχ).1 (hroots χ hχ).2)) hpos

end Geometry

section Radical

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}

open RelativeRoot in
set_option backward.isDefEq.respectTransparency false in
/-- **All-test radical generation.** For a split torus `i : S ⟶ G` of a smooth connected
affine group and a cocharacter `ν` whose indivisible positive roots have pairwise disjoint
positive rays, every subgroup functor containing the root subgroups of those indivisible
roots contains the dynamic unipotent subgroup of `ν`, on every test scheme. This is the
all-test form of `RelativeRoot.dynamicUnipotent_le_of_disjoint_positive_rays`, with the same
proof. -/
theorem unipotent_le_of_disjoint_positive_rays (hS : IsSplitTorus S.toGrp)
    (i : S.toGrp ⟶ G) (ν : cocharacterLattice S)
    (hdisj : ∀ a ∈ indivisiblePositiveRoots i ν,
      ∀ b ∈ indivisiblePositiveRoots i ν, a ≠ b →
        Disjoint (cyclicTail a 1 : Set (characterLattice S))
          (cyclicTail b 1 : Set (characterLattice S)))
    (F : SubgroupFunctor G)
    (hroot : ∀ a ∈ indivisiblePositiveRoots i ν, RelativeRoot.subgroup i a ≤ F) :
    Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) ≤ F := by
  have hfin : (indivisiblePositiveRoots i ν).Finite :=
    (hS.finite_relativeRoots i).subset (fun _ ha => ha.1.1)
  obtain ⟨n, a, hinj, ha⟩ := hfin.fin_param
  let b := AutomorphicAction.conjugation i
  let A := positiveSemigroup ν
  obtain ⟨⟨U, jU, hjU, hjUc, hUs, hUc⟩, hStable, _, hUnip, _, _⟩ :=
    semigroupRealization k G inferInstance inferInstance S hS b A
  have hzero : (0 : characterLattice S) ∉ A := by
    change ¬ 0 < latticePairing S 0 ν
    simp
  obtain ⟨hUu, _⟩ := hUnip U jU hjU hzero
  let : IsAffineHom U.X.hom := hjUc.isAffineHom
  let : Smooth U.X.hom := hUs
  let : ConnectedSpace U.X.left := hUc
  let c := b.onRepresentedSubgroup jU hjU hStable
  have hequiv : ∀ (T : Over (Spec (CommRingCat.of k))) (s : T ⟶ S.X)
      (x : T ⟶ U.X), c.act s x ≫ jU.hom.hom = b.act s (x ≫ jU.hom.hom) :=
    fun _ s x => b.onRepresentedSubgroup_act_comp jU hjU hStable s x
  have htop : (⊤ : SubgroupFunctor U).map jU = semigroupSubgroup b A := by
    rw [SubgroupFunctor.map_top, hjU.2]
  have hsupport : actionWeightSupport c ⊤ = positiveRelativeRoots i ν := by
    rw [← actionWeightSupport_map jU hjU.1 c b hequiv, htop]
    exact actionWeightSupport_positiveSemigroup semigroupRealization inferInstance hS i ν
  have hblocks := rootRayBlock_pairwise i ν a hinj ha hdisj
  have hcover : (⋃ r, rootRayBlock i (a r)) = actionWeightSupport c ⊤ :=
    (iUnion_rootRayBlock i ν a ha
      (fun χ hχ => positive_iff_mem_indivisiblePositiveRoot_ray i ν hχ)).trans hsupport.symm
  obtain ⟨H, jH, hH, hIso⟩ :=
    hasOrderedSemigroupProducts_of_unipotent c hS hUu n
      (fun r => rootRayBlock i (a r)) hcover hblocks.1 hblocks.2
  have hrootmem (r : Fin n) : a r ∈ indivisiblePositiveRoots i ν :=
    ha ▸ Set.mem_range_self r
  have hsemigroup (r : Fin n) :
      ((semigroupSubgroup c (AddSubsemigroup.closure (rootRayBlock i (a r)))).map jU) =
        semigroupSubgroup b (cyclicTail (a r) 1) := by
    rw [closure_rootRayBlock i (hrootmem r).1.1]
    apply semigroupSubgroup_map_eq jU hjUc c b hequiv
    rw [hjU.2]
    exact semigroupSubgroup_mono b (cyclicTail_one_le_positiveSemigroup (hrootmem r).2)
  have hfactor (r : Fin n) : (subgroup i (a r)).IsRepresentedBy (jH r ≫ jU) := by
    have hrep : (semigroupSubgroup b (cyclicTail (a r) 1)).IsRepresentedBy (jH r ≫ jU) := by
      rw [← hsemigroup r]
      exact (hH r).1.comp hjU
    have hcyclic := cyclicRootFunctorComparison k G inferInstance inferInstance
      S hS i (a r) (hrootmem r).1.1.1
    exact hcyclic ▸ hrep
  have hDynamic :
      Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) = semigroupSubgroup b A :=
    (dynamicSemigroupComparison k G inferInstance inferInstance inferInstance S hS i ν).2.2
  let := hIso
  intro V g hg
  have hgA : g ∈ (semigroupSubgroup b A).carrier V := hDynamic ▸ hg
  rw [← hjU.2] at hgA
  obtain ⟨gU, hgU⟩ := SubgroupFunctor.mem_range.mp hgA
  let x : V ⟶ (∏ᶜ H).X := gU ≫ inv (orderedMultiplication jH)
  have hx : x ≫ orderedMultiplication (fun r => jH r ≫ jU) = g := by
    rw [← orderedMultiplication_comp jH jU]
    simp only [x, Category.assoc, IsIso.inv_hom_id_assoc]
    exact hgU
  rw [← hx, comp_orderedMultiplication]
  unfold orderedPoints
  apply (F.carrier V).list_prod_mem
  intro y hy
  obtain ⟨r, rfl⟩ := List.mem_ofFn.mp hy
  apply hroot (a r) (hrootmem r)
  rw [← (hfactor r).2]
  exact ⟨_, rfl⟩

end Radical

section Levi

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]

/-- The Levi cocharacter of a nonzero character `a` of a split torus `i : T ⟶ G`: the kernel
cocharacter of `a` chosen with respect to the finite set of roots of `i`. It pairs to zero with
`a`, and every root of `i` pairing to zero with it is linearly dependent on `a`. -/
def leviCocharacter (hT : IsSplitTorus T.toGrp) (i : T.toGrp ⟶ G) {a : characterLattice T}
    (ha : a ≠ 0) : cocharacterLattice T :=
  RootReducedness.kernelCocharacter hT ha (hT.finite_relativeRoots i)

/-- The Levi cocharacter of `a` pairs to zero with `a`. -/
theorem latticePairing_leviCocharacter (hT : IsSplitTorus T.toGrp) (i : T.toGrp ⟶ G)
    {a : characterLattice T} (ha : a ≠ 0) :
    latticePairing T a (leviCocharacter hT i ha) = 0 :=
  RootReducedness.latticePairing_kernelCocharacter hT ha _

/-- A root pairing to zero with the Levi cocharacter of `a` is linearly dependent on `a`. -/
theorem not_linearIndependent_of_latticePairing_leviCocharacter (hT : IsSplitTorus T.toGrp)
    (i : T.toGrp ⟶ G) {a : characterLattice T} (ha : a ≠ 0) {χ : characterLattice T}
    (hχ : χ ∈ roots i) (hχζ : latticePairing T χ (leviCocharacter hT i ha) = 0) :
    ¬ LinearIndependent ℤ ![a, χ] :=
  RootReducedness.not_linearIndependent_of_latticePairing_kernelCocharacter hT ha _ hχ hχζ

end Levi

section Main

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    {i : T.toGrp ⟶ G} {J : Type v}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)}

/-- **Levi subgroup of a simple root.** A closed subgroup `q` containing the root subgroups of
a simple root `a` for `ν` and of `-a`, and the centralizer of `ν`, contains the centralizer of
the Levi cocharacter of `a`. -/
theorem leviCentralizer_le_range (hT : IsSplitTorus T.toGrp) (hP : IsRootDatumOf i P)
    {ν : cocharacterLattice T} {a : characterLattice T} (ha : a ∈ simpleRelativeRoots i ν)
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (hpos : RelativeRoot.subgroup i a ≤ SubgroupFunctor.range q)
    (hneg : RelativeRoot.subgroup i (-a) ≤ SubgroupFunctor.range q)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q) :
    Dynamic.centralizer (CommGroupScheme.groupHom (leviCocharacter hT i ha.1.1.1) ≫ i) ≤
      SubgroupFunctor.range q :=
  centralizer_le_range_of_simple hP hT ha
    (fun _ hχ hχζ => not_linearIndependent_of_latticePairing_leviCocharacter hT i _ hχ hχζ)
    q hq hpos hneg hZ

/-- **Generation by simple-root Levi subgroups.** Let `i : T ⟶ G` be a closed split torus of a
smooth connected affine group, realized by a root datum `P`, and `ν` a generic cocharacter. A
closed subgroup `q` containing the root subgroups of the simple roots for `ν` and of their
negatives, and the centralizer of `ν`, is all of `G`. -/
theorem isIso_of_simpleRootLevis (hT : IsSplitTorus T.toGrp) (hi : IsClosedSubgroup i)
    (hP : IsRootDatumOf i P) {ν : cocharacterLattice T} (hν : IsGenericCocharacter i ν)
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (hpos : ∀ a ∈ simpleRelativeRoots i ν,
      RelativeRoot.subgroup i a ≤ SubgroupFunctor.range q)
    (hneg : ∀ a ∈ simpleRelativeRoots i ν,
      RelativeRoot.subgroup i (-a) ≤ SubgroupFunctor.range q)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q) :
    IsIso q := by
  have : Mono i.hom.hom.left := hi.mono
  have := isAddTorsionFree_of_rootDatum P
  have hweyl : ∀ j : J, P.root j ∈ simpleRelativeRoots i ν →
      ∃ n : normalizerPoints i, (∀ χ, weylAction i n χ = P.reflection j χ) ∧
        ∀ U, G.constantPoint n U ∈ (SubgroupFunctor.range q).carrier U := by
    intro j hj
    obtain ⟨n, hn, hc⟩ := exists_normalizer_reflection hP j
      (latticePairing_leviCocharacter hT i hj.1.1.1)
    exact ⟨n, hn, fun U =>
      leviCentralizer_le_range hT hP hj q hq (hpos _ hj) (hneg _ hj) hZ U (hc U)⟩
  have hQ : ∀ χ ∈ positiveRelativeRoots i ν,
      RelativeRoot.subgroup i χ ≤ SubgroupFunctor.range q ∧
        RelativeRoot.subgroup i (-χ) ≤ SubgroupFunctor.range q := by
    apply positive_induction hP hT hν
    · exact fun a ha => ⟨hpos a ha, hneg a ha⟩
    · intro a ha h
      have ha0 : a ≠ 0 := ha.1.1.1
      refine ⟨(subgroup_two_nsmul_le hT i ha0).trans h.1, ?_⟩
      rw [← smul_neg]
      exact (subgroup_two_nsmul_le hT i (neg_ne_zero.mpr ha0)).trans h.2
    · intro j hj χ h
      obtain ⟨n, hn, hc⟩ := hweyl j hj
      refine ⟨?_, ?_⟩
      · rw [← hn]
        exact subgroup_weylAction_le n hc h.1
      · rw [← map_neg, ← hn]
        exact subgroup_weylAction_le n hc h.2
  have hU : Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q :=
    unipotent_le_of_disjoint_positive_rays hT i ν
      (fun a ha b hb hne => disjoint_cyclicTail hP ν ha hb hne) _
      (fun a ha => (hQ a ⟨ha.1.1, ha.2⟩).1)
  have hM : Dynamic.unipotent (CommGroupScheme.groupHom (-ν) ≫ i) ≤
      SubgroupFunctor.range q := by
    apply unipotent_le_of_disjoint_positive_rays hT i (-ν)
      (fun a ha b hb hne => disjoint_cyclicTail hP (-ν) ha hb hne)
    intro a ha
    have hneg' : -a ∈ positiveRelativeRoots i ν :=
      ⟨neg_mem_roots hP ha.1.1, by
        have := ha.2
        rw [map_neg] at this
        rw [map_neg, LinearMap.neg_apply]
        linarith⟩
    have h := (hQ (-a) hneg').2
    rwa [neg_neg] at h
  rw [groupHom_neg_comp_eq_oppositeCocharacter] at hM
  exact Dynamic.isIso_of_contains_dynamicFactors (CommGroupScheme.groupHom ν ≫ i) q hq hM hZ hU

/-- Under the hypotheses of `isIso_of_simpleRootLevis`, the closed subgroup `q` has full range
on every test scheme. -/
theorem range_eq_top_of_simpleRootLevis (hT : IsSplitTorus T.toGrp) (hi : IsClosedSubgroup i)
    (hP : IsRootDatumOf i P) {ν : cocharacterLattice T} (hν : IsGenericCocharacter i ν)
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (hpos : ∀ a ∈ simpleRelativeRoots i ν,
      RelativeRoot.subgroup i a ≤ SubgroupFunctor.range q)
    (hneg : ∀ a ∈ simpleRelativeRoots i ν,
      RelativeRoot.subgroup i (-a) ≤ SubgroupFunctor.range q)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q) :
    SubgroupFunctor.range q = ⊤ := by
  have := isIso_of_simpleRootLevis hT hi hP hν q hq hpos hneg hZ
  exact range_eq_top_of_isIso q

end Main

end Langlands.GroupScheme.LeviGluing
