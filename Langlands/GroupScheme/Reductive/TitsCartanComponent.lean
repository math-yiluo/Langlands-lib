import Langlands.GroupScheme.Reductive.TitsIndex
import Mathlib.Logic.Relation

/-! # Connected components of the actual absolute Cartan diagram -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme.TitsIndexData

variable {k : Type u} [Field k]
  {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
  (d : TitsIndexData G)

/-- Connectivity in the actual Cartan diagram: the equivalence relation
generated by the nonzero off-diagonal Cartan entries. -/
def CartanConnected (a b : d.Vertex) : Prop :=
  Relation.EqvGen (fun x y : d.Vertex => x ≠ y ∧ d.cartan x y ≠ 0) a b

theorem cartanConnected_refl (a : d.Vertex) : d.CartanConnected a a :=
  Relation.EqvGen.refl a

theorem CartanConnected.symm {a b : d.Vertex} (h : d.CartanConnected a b) :
    d.CartanConnected b a := Relation.EqvGen.symm _ _ h

theorem CartanConnected.trans {a b c : d.Vertex}
    (h : d.CartanConnected a b) (h' : d.CartanConnected b c) :
    d.CartanConnected a c := Relation.EqvGen.trans _ _ _ h h'

theorem cartanConnected_of_cartan_ne_zero {a b : d.Vertex}
    (h : d.cartan a b ≠ 0) : d.CartanConnected a b := by
  by_cases hab : a = b
  · subst b
    exact d.cartanConnected_refl a
  · exact Relation.EqvGen.rel a b ⟨hab, h⟩

/-- The actual simple vertices in the connected Cartan component of `a`. -/
abbrev CartanComponent (a : d.Vertex) :=
  {b : d.Vertex // d.CartanConnected a b}

/-- The component contains its specified vertex. -/
def cartanComponentSelf (a : d.Vertex) : d.CartanComponent a :=
  ⟨a, d.cartanConnected_refl a⟩

end Langlands.GroupScheme.TitsIndexData
