/-! # Comparison data for the derived group of the centralizer of a split torus -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace Langlands.GroupScheme

/-- The additive closure of a linearly independent integral family is pointed. -/
theorem eq_zero_of_mem_closure_of_neg_mem {ι M : Type*} [Fintype ι] [AddCommGroup M]
    {v : ι → M} (hv : LinearIndependent ℤ v) {x : M}
    (hx : x ∈ AddSubmonoid.closure (Set.range v))
    (hnx : -x ∈ AddSubmonoid.closure (Set.range v)) : x = 0 := by
  classical
  obtain ⟨a, ha⟩ := (AddSubmonoid.mem_closure_range_iff_of_fintype).mp hx
  obtain ⟨c, hc⟩ := (AddSubmonoid.mem_closure_range_iff_of_fintype).mp hnx
  have hsum : ∑ i, ((a i + c i : ℕ) : ℤ) • v i = 0 := by
    have : ∑ i, ((a i + c i : ℕ) : ℤ) • v i = (∑ i, a i • v i) + ∑ i, c i • v i := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [natCast_zsmul, add_smul]
    rw [this, ← ha, ← hc, add_neg_cancel]
  have hzero := (Fintype.linearIndependent_iff.mp hv) _ hsum
  rw [ha]
  refine Finset.sum_eq_zero fun i _ => ?_
  have hi := hzero i
  have : a i = 0 := by omega
  rw [this, zero_smul]

/-- An element of the additive closure of an integral family whose image under an additive
map `f` is zero is zero, when the images `f (v i)` are linearly independent. -/
theorem eq_zero_of_mem_closure_of_map_eq_zero {ι M N : Type*} [Fintype ι] [AddCommGroup M]
    [AddCommGroup N] {v : ι → M} (f : M →+ N) (hv : LinearIndependent ℤ (fun i => f (v i)))
    {x : M} (hx : x ∈ AddSubmonoid.closure (Set.range v)) (hfx : f x = 0) : x = 0 := by
  classical
  obtain ⟨a, ha⟩ := (AddSubmonoid.mem_closure_range_iff_of_fintype).mp hx
  have hsum : ∑ i, ((a i : ℕ) : ℤ) • f (v i) = 0 := by
    rw [← hfx, ha, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [natCast_zsmul, map_nsmul]
  have hzero := (Fintype.linearIndependent_iff.mp hv) _ hsum
  rw [ha]
  refine Finset.sum_eq_zero fun i _ => ?_
  have : a i = 0 := by exact_mod_cast hzero i
  rw [this, zero_smul]

/-- The positive root monoid of a split pinning is pointed. -/
theorem SplitPinning.eq_zero_of_mem_positiveRootMonoid_of_neg_mem {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom] (p : SplitPinning G)
    {x : characterLattice p.torus} (hx : x ∈ p.positiveRootMonoid)
    (hnx : -x ∈ p.positiveRootMonoid) : x = 0 := by
  have hb : LinearIndependent ℤ (fun a : p.base.support => p.rootDatum.root a) :=
    p.base.linearIndepOn_root
  exact eq_zero_of_mem_closure_of_neg_mem hb hx hnx

namespace GaloisPinningData

variable {F K : Type u} [Field F] [Field K] [Algebra F K]
  {G D : GroupScheme (Spec (CommRingCat.of F))}
  [IsAffineHom G.X.hom] [IsAffineHom D.X.hom]

/-- A split torus `S` of `G`, mapped into the pinned torus `T` compatibly with the inclusions,
together with a cocharacter of `S` used to compare positivity of roots. -/
structure SplitTorusDatum (d : GaloisPinningData F K G) where
  /-- The split torus, defined over the ground field. -/
  splitTorus : CommGroupScheme (Spec (CommRingCat.of F))
  /-- Its inclusion into `G`. -/
  splitInclusion : splitTorus.toGrp ⟶ G
  isSplitTorus : IsSplitTorus splitTorus.toGrp
  /-- The map into the pinned torus. -/
  torusMap : splitTorus ⟶ d.torus
  square : CommGroupScheme.groupHom torusMap ≫ d.inclusion = splitInclusion
  /-- A cocharacter of the split torus. -/
  positiveCocharacter : cocharacterLattice splitTorus

/-- Restriction of absolute characters of `T_K` to the split torus `S`: precomposition with the
base change of `S ⟶ T`, then descent of characters of the split torus `S`. -/
def SplitTorusDatum.restriction {d : GaloisPinningData F K G} (s : d.SplitTorusDatum) :
    characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F K)).obj d.torus) →+
      characterLattice s.splitTorus :=
  (characterLattice.baseChangeEquiv (algebraBaseMap F K) s.splitTorus
      s.isSplitTorus).symm.toAddMonoidHom.comp
    (characterPrecompInt ((CommGroupScheme.baseChange (algebraBaseMap F K)).map
      s.torusMap)).toAddMonoidHom

/-- The simple vertices whose roots restrict to zero on the split torus. -/
abbrev SplitTorusDatum.zeroVertex {d : GaloisPinningData F K G} (s : d.SplitTorusDatum) :
    Type u :=
  {a : d.base.support // s.restriction (d.rootDatum.root a) = 0}

/-- The additive monoid generated by the simple roots vanishing on the split torus. -/
def SplitTorusDatum.zeroRootMonoid {d : GaloisPinningData F K G} (s : d.SplitTorusDatum) :
    AddSubmonoid (characterLattice
      ((CommGroupScheme.baseChange (algebraBaseMap F K)).obj d.torus)) :=
  AddSubmonoid.closure (Set.range fun a : s.zeroVertex => d.rootDatum.root a.val.val)

variable [LocallyOfFiniteType G.X.hom] [LocallyOfFiniteType D.X.hom]

/-- The star action on simple vertices. -/
def vertexStar (d : GaloisPinningData F K G) (σ : K ≃ₐ[F] K) (a : d.base.support) :
    d.base.support :=
  ⟨(d.starAction σ).val.indexEquiv a.val, ((d.starAction σ).property a.val).mp a.property⟩

/-- Comparison data between `G` with a split torus datum `s` and a group `D` mapping to `G`
by `ι`: `ι` takes values in the centralizer of `S`, a torus map carries the pinned torus of
`D` into that of `G` compatibly with `ι`, the simple vertices of `D` correspond to the simple
vertices of `G` whose roots vanish on `S`, with matching roots, coroots and star actions, and
the cocharacter of `s` pairs positively with every simple root not vanishing on `S`. This is
satisfied by the derived group of the centralizer of a split torus with compatible pinnings;
neither maximality of `S` nor anisotropy of `D` is required. -/
structure LeviComparison (d : GaloisPinningData F K G) (s : d.SplitTorusDatum) (ι : D ⟶ G)
    (e : GaloisPinningData F K D) where
  /-- The map of pinned tori. -/
  kernelTorusMap : e.torus ⟶ d.torus
  kernelSquare : CommGroupScheme.groupHom kernelTorusMap ≫ d.inclusion = e.inclusion ≫ ι
  centralizes : SubgroupFunctor.range ι ≤ torusCentralizer s.splitInclusion
  /-- The correspondence of simple vertices. -/
  vertexEquiv : e.base.support ≃ s.zeroVertex
  pos : ∀ a : d.base.support, s.restriction (d.rootDatum.root a) ≠ 0 →
    0 < latticePairing s.splitTorus (s.restriction (d.rootDatum.root a)) s.positiveCocharacter
  root_eq : ∀ b, (CommGroupScheme.baseChange (algebraBaseMap F K)).map kernelTorusMap ≫
    d.rootDatum.root (vertexEquiv b).val.val = e.rootDatum.root b.val
  coroot_eq : ∀ b, e.rootDatum.coroot b.val ≫
    (CommGroupScheme.baseChange (algebraBaseMap F K)).map kernelTorusMap =
      d.rootDatum.coroot (vertexEquiv b).val.val
  star_eq : ∀ σ b, (vertexEquiv (e.vertexStar σ b)).val = d.vertexStar σ (vertexEquiv b).val

namespace LeviComparison

variable {d : GaloisPinningData F K G} {s : d.SplitTorusDatum} {ι : D ⟶ G}
  {e : GaloisPinningData F K D}

/-- Restriction of absolute characters of `G` to the pinned torus of `D`. -/
def weightRestriction (L : d.LeviComparison s ι e) :
    characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F K)).obj d.torus) →ₗ[ℤ]
      characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F K)).obj e.torus) :=
  characterPrecompInt ((CommGroupScheme.baseChange (algebraBaseMap F K)).map L.kernelTorusMap)

theorem weightRestriction_root_zero (L : d.LeviComparison s ι e) (a : s.zeroVertex) :
    L.weightRestriction (d.rootDatum.root a.val.val) =
      e.rootDatum.root (L.vertexEquiv.symm a).val := by
  have h := L.root_eq (L.vertexEquiv.symm a)
  rw [Equiv.apply_symm_apply] at h
  exact h

/-- A nonnegative integral combination of simple roots whose restriction to the split torus
vanishes only involves the simple roots vanishing on it. -/
theorem mem_zeroRootMonoid (L : d.LeviComparison s ι e)
    {β : characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F K)).obj d.torus)}
    (hβ : β ∈ d.toSplitPinning.positiveRootMonoid) (h0 : s.restriction β = 0) :
    β ∈ s.zeroRootMonoid := by
  classical
  let g : characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F K)).obj d.torus) →+ ℤ :=
    ((latticePairing s.splitTorus).flip s.positiveCocharacter).toAddMonoidHom.comp
      s.restriction
  have hg (x) : g x = latticePairing s.splitTorus (s.restriction x) s.positiveCocharacter :=
    rfl
  have key : ∀ x ∈ d.toSplitPinning.positiveRootMonoid,
      0 ≤ g x ∧ (g x = 0 → x ∈ s.zeroRootMonoid) := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      by_cases ha : s.restriction (d.rootDatum.root a.val) = 0
      · refine ⟨?_, fun _ => ?_⟩
        · change 0 ≤ latticePairing s.splitTorus
            (s.restriction (d.rootDatum.root a.val)) s.positiveCocharacter
          rw [ha]
          simp
        · exact AddSubmonoid.subset_closure ⟨⟨a, ha⟩, rfl⟩
      · have : 0 < g (d.rootDatum.root a.val) := L.pos a ha
        exact ⟨this.le, fun h => absurd h this.ne'⟩
    | zero => exact ⟨by simp, fun _ => zero_mem _⟩
    | add x y _ _ hx hy =>
      refine ⟨by rw [map_add]; exact add_nonneg hx.1 hy.1, fun h => ?_⟩
      rw [map_add] at h
      have hx0 : g x = 0 := by linarith [hx.1, hy.1]
      have hy0 : g y = 0 := by linarith [hx.1, hy.1]
      exact add_mem (hx.2 hx0) (hy.2 hy0)
  exact (key β hβ).2 (by rw [hg, h0, map_zero, LinearMap.zero_apply])

/-- Restriction carries the zero-vertex root monoid into the positive root monoid of `D`. -/
theorem weightRestriction_mem_positiveRootMonoid (L : d.LeviComparison s ι e) {β}
    (hβ : β ∈ s.zeroRootMonoid) :
    L.weightRestriction β ∈ e.toSplitPinning.positiveRootMonoid := by
  induction hβ using AddSubmonoid.closure_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    rw [L.weightRestriction_root_zero]
    exact SplitPinning.simpleRoot_mem_positiveRootMonoid e.toSplitPinning
      (L.vertexEquiv.symm a)
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy

/-- Restriction is injective on the zero-vertex root monoid. -/
theorem eq_zero_of_weightRestriction_eq_zero (L : d.LeviComparison s ι e) {β}
    (hβ : β ∈ s.zeroRootMonoid) (h0 : L.weightRestriction β = 0) : β = 0 := by
  classical
  have hli : LinearIndependent ℤ (fun a : s.zeroVertex =>
      L.weightRestriction.toAddMonoidHom (d.rootDatum.root a.val.val)) := by
    have hb' : LinearIndependent ℤ (fun b : e.base.support => e.rootDatum.root b.val) :=
      e.base.linearIndepOn_root
    have := hb'.comp (fun a : s.zeroVertex => L.vertexEquiv.symm a)
      L.vertexEquiv.symm.injective
    convert this using 1
    funext a
    exact L.weightRestriction_root_zero a
  exact eq_zero_of_mem_closure_of_map_eq_zero L.weightRestriction.toAddMonoidHom hli hβ h0

/-- Over any field extension of the ground field, `ι` still takes values in the centralizer
of the split torus. -/
theorem centralizes_baseChange (L : d.LeviComparison s ι e) (K' : Type u) [Field K']
    [Algebra F K'] :
    SubgroupFunctor.range ((GroupScheme.baseChange (algebraBaseMap F K')).map ι) ≤
      torusCentralizer (T := (CommGroupScheme.baseChange (algebraBaseMap F K')).obj
        s.splitTorus) ((GroupScheme.baseChange (algebraBaseMap F K')).map s.splitInclusion) :=
  MatrixRepresentation.range_le_torusCentralizer_baseChange _ L.centralizes

end LeviComparison

end GaloisPinningData

namespace TitsIndexData

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]

/-- The maximal split torus of Tits index data, with its positive cocharacter. -/
def splitTorusDatum (d : TitsIndexData G) : d.pinning.SplitTorusDatum where
  splitTorus := d.splitTorus
  splitInclusion := d.splitInclusion
  isSplitTorus := d.maximalSplit.1.1
  torusMap := d.torusMap
  square := d.square
  positiveCocharacter := d.positiveCocharacter

theorem splitTorusDatum_restriction_root (d : TitsIndexData G) (a : d.pinning.rootIndex) :
    d.splitTorusDatum.restriction (d.pinning.rootDatum.root a) = d.rootRestriction a := rfl

/-- The actual anisotropic kernel, the derived group of the actual centralizer of the maximal
split torus, gives Levi comparison data. -/
def AnisotropicKernelIndex.leviComparison {d : TitsIndexData G}
    (p : d.AnisotropicKernelIndex) :
    d.pinning.LeviComparison d.splitTorusDatum (p.derived ≫ p.inclusion) p.index.pinning where
  kernelTorusMap := p.comparison.torusMap
  kernelSquare := p.comparison.choose_spec.choose_spec.1
  centralizes := MatrixRepresentation.range_comp_le_torusCentralizer _ p.represents p.derived
  vertexEquiv := p.comparison.vertexEquiv
  pos a ha := (d.compatible a.val ha).mp (RootPairing.Base.isPos_of_mem_support a.property)
  root_eq b := (p.comparison.choose_spec.choose_spec.2.1 b.val).symm
  coroot_eq b := p.comparison.coroot_comp_torusMap b
  star_eq σ b := congrArg Subtype.val (p.comparison.vertexEquiv_star σ b)

theorem AnisotropicKernelIndex.leviComparison_weightRestriction {d : TitsIndexData G}
    (p : d.AnisotropicKernelIndex) :
    p.leviComparison.weightRestriction = p.comparison.weightRestriction := rfl

end TitsIndexData

end Langlands.GroupScheme
