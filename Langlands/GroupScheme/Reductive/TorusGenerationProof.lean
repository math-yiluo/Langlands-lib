import Langlands.GroupScheme.Cartan.FiniteGeneration
import Langlands.GroupScheme.Cartan.GenerationProof
import Langlands.GroupScheme.Absolute.AlgClosedMaximalTorusCentralizerAssembly
import Langlands.GroupScheme.Dynamic.CentralizerReductiveProof
import Langlands.GroupScheme.Torus.NoTorusUnipotent
import Langlands.GroupScheme.Absolute.SolvableTorusQuotientProof

/-! # Connected reductive groups over infinite fields are generated by finitely many tori -/

universe u

namespace Langlands.GroupScheme

/-- **Milne 17.91 with 17.84.** Over an infinite field, a connected reductive group is
generated by finitely many closed subtori. Cartan generation, together with the
self-centralizing property of maximal tori, gives the finite torus family. -/
theorem reductiveFiniteTorusGeneration : ReductiveFiniteTorusGenerationStatement.{u} :=
  reductiveFiniteTorusGeneration_of_cartanGeneration cartanGenerationStatement
    (maximalTorusCentralizer_of_structuralInputs dynamicCentralizerReductive noTorusUnipotent
      solvableTorusQuotient)

end Langlands.GroupScheme
