import Langlands.GroupScheme.Reductive.LocalSplitBigCellProof
import Langlands.GroupScheme.IdentityComponent
import Langlands.GroupScheme.CocharacterTransport
import Langlands.GroupScheme.Reductive.GenericFiberGeometry
import Langlands.CommutativeAlgebra.HenselianSections
import Langlands.AlgebraicGeometry.PointTopology.SmoothSeparablyClosedDensity

/-!
# Integral points of split reductive groups over strictly Henselian local domains

Let `R` be a Henselian local domain with separably closed residue field, `G` a reductive group
over `R` with a split maximal torus and root parametrizations. Every `R`-point of `G` is a
product of two points of the big cell, hence lies in the subgroup generated by the
`R`-points of the torus and of the root groups.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.GroupScheme.LocalSplitCell

section OpenFactor

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- An `R`-point of a scheme over `Spec R` whose closed point lands in the range of an open
immersion factors through that open immersion. -/
theorem exists_lift_of_closedPoint_mem {X Y : Over (Spec (CommRingCat.of R))} (f : Y ⟶ X)
    [IsOpenImmersion f.left] (x : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ X)
    (hx : x.left (IsLocalRing.closedPoint R) ∈ Set.range f.left) :
    ∃ y : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ Y, y ≫ f = x := by
  have hrange : Set.range x.left ⊆ Set.range f.left := by
    rintro _ ⟨p, rfl⟩
    exact ((IsLocalRing.specializes_closedPoint p).map x.left.continuous).mem_open
      (IsOpenImmersion.isOpen_range f.left) hx
  refine ⟨Over.homMk (IsOpenImmersion.lift f.left x.left hrange) ?_, ?_⟩
  · rw [← Over.w f, ← Category.assoc, IsOpenImmersion.lift_fac]
    exact Over.w x
  · ext1
    exact IsOpenImmersion.lift_fac _ _ _

end OpenFactor

section Field

variable (k : Type u) [Field k] [IsSepClosed k]

/-- In a smooth affine connected group over a separably closed field, an open set containing a
rational point contains, for every rational point `p`, a rational point `q` with `q⁻¹ p` again
in the open set. -/
theorem exists_rationalPoint_mem_inv_mul_mem (H : GroupScheme (Spec (CommRingCat.of k)))
    [Smooth H.X.hom] [IsAffineHom H.X.hom] [ConnectedSpace H.X.left]
    (U : Set H.X.left) (hU : IsOpen U) (u₀ : rationalPoints H)
    (h0 : u₀.left (IsLocalRing.closedPoint k) ∈ U)
    (p : rationalPoints H) :
    ∃ q : rationalPoints H, q.left (IsLocalRing.closedPoint k) ∈ U ∧
      (q⁻¹ * p).left (IsLocalRing.closedPoint k) ∈ U := by
  -- irreducibility from the identity component
  have hirr : IrreducibleSpace H.X.left := by
    have hrange := IdentityComponent.range_identityComponentι H
    rw [PreconnectedSpace.connectedComponent_eq_univ] at hrange
    have h := (IrreducibleSpace.isIrreducible_univ ((identityComponent H).X.left)).image
      _ ((identityComponentι H).hom.hom.left.continuous.continuousOn)
    rw [Set.image_univ, hrange] at h
    exact irreducibleSpace_def _ |>.mpr h
  -- the morphism `y ↦ y⁻¹ p`
  let ψ : H.X ⟶ H.X := (𝟙 H.X)⁻¹ * (toUnit H.X ≫ p)
  have hψ : ∀ q : rationalPoints H, q ≫ ψ = q⁻¹ * p := by
    intro q
    have hq : q ≫ toUnit H.X = 𝟙 _ := toUnit_unique _ _
    simp only [ψ, MonObj.comp_mul, GrpObj.comp_inv, Category.comp_id, ← Category.assoc, hq,
      Category.id_comp]
  let W : Set H.X.left := ψ.left ⁻¹' U
  have hW : IsOpen W := hU.preimage ψ.left.continuous
  have hpW : (p * u₀⁻¹).left (IsLocalRing.closedPoint k) ∈ W := by
    change ((p * u₀⁻¹) ≫ ψ).left (IsLocalRing.closedPoint k) ∈ U
    rw [hψ, mul_inv_rev, inv_inv, inv_mul_cancel_right]
    exact h0
  obtain ⟨z, hzU, hzW⟩ := nonempty_preirreducible_inter hU hW ⟨_, h0⟩ ⟨_, hpW⟩
  have hd := hasDenseRationalPoints_of_smooth_of_isSepClosed k H.X
  obtain ⟨z', ⟨hz'U, hz'W⟩, hz'⟩ :=
    Dense.inter_open_nonempty hd (U ∩ W) (hU.inter hW) ⟨z, hzU, hzW⟩
  obtain ⟨q, x, rfl⟩ := Set.mem_iUnion.mp hz'
  have hx : x = IsLocalRing.closedPoint k := Subsingleton.elim (α := PrimeSpectrum k) _ _
  subst hx
  refine ⟨q, hz'U, ?_⟩
  have h : (q ≫ ψ).left (IsLocalRing.closedPoint k) ∈ U := hz'W
  rwa [hψ] at h

end Field

section Main

variable {R : Type u} [CommRing R]
  {I : Type u} [Fintype I] {G : GroupScheme (Spec (CommRingCat.of R))}
  {J : Type u}

variable (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G) (u : J → (Ga R ⟶ G)) in
/-- The `R`-points of the torus and of the root groups. -/
def generators : Set (𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ G.X) :=
  Set.range (fun t : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ (splitTorus _ I).X =>
      t ≫ i.hom.hom) ∪
    ⋃ α, Set.range (rootPoint (u α) (𝟙_ (Over (Spec (CommRingCat.of R)))))

theorem orderedProduct_mem_closure (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G)
    (u : J → (Ga R ⟶ G)) {r : ℕ} (e : Fin r → J)
    (c : Fin r → Γ((𝟙_ (Over (Spec (CommRingCat.of R)))).left, ⊤)) :
    orderedProduct u e (𝟙_ _) c ∈ Subgroup.closure (generators i u) := by
  refine Subgroup.list_prod_mem _ fun z hz => ?_
  obtain ⟨k, rfl⟩ := List.mem_ofFn.mp hz
  exact Subgroup.subset_closure (Or.inr (Set.mem_iUnion.mpr ⟨e k, c k, rfl⟩))

theorem cellMap_mem_closure (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G)
    (u : J → (Ga R ⟶ G)) {m n : ℕ} (neg : Fin m → J) (pos : Fin n → J)
    (y : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ cellObj R I m n) :
    y ≫ cellMap i u neg pos ∈ Subgroup.closure (generators i u) := by
  rw [comp_cellMap, cellPoint]
  refine mul_mem (mul_mem (orderedProduct_mem_closure i u neg _)
    (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))) (orderedProduct_mem_closure i u pos _)

/-- **Integral generation.** Over a Henselian local domain with separably closed residue
field, every `R`-point of a reductive group with a split maximal torus and root
parametrizations lies in the subgroup generated by the `R`-points of the torus and of the
root groups. -/
theorem mem_closure_generators [IsDomain R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] [IsAffineHom G.X.hom]
    (hG : IsReductive G) (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G)
    (hic : IsClosedSubgroup i)
    (hmax : ∀ s : Spec (CommRingCat.of R),
      IsMaximalTorus
        (T := (CommGroupScheme.baseChange
          ((Spec (CommRingCat.of R)).fromSpecResidueField s)).obj
            (splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I))
        ((GroupScheme.baseChange
          ((Spec (CommRingCat.of R)).fromSpecResidueField s)).map i))
    (P : RootDatum J (I → ℤ) (I → ℤ)) (hP : IsFibrewiseRootDatumOf I G i P) (b : P.Base)
    (u : J → (Ga R ⟶ G)) (hu : ∀ α, IsRootParametrization i (P.root α) (u α))
    (g : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ G.X) :
    g ∈ Subgroup.closure (generators i u) := by
  classical
  have : Finite J := hP.finite
  let κ := IsLocalRing.ResidueField R
  -- the big cell
  obtain ⟨m, ⟨neg⟩⟩ : ∃ m, Nonempty (Fin m ≃ {α // ¬ b.IsPos α}) :=
    ⟨_, ⟨(Finite.equivFin _).symm⟩⟩
  obtain ⟨n, ⟨pos⟩⟩ : ∃ n, Nonempty (Fin n ≃ {α // b.IsPos α}) :=
    ⟨_, ⟨(Finite.equivFin _).symm⟩⟩
  let Ω := cellMap i u (fun k => (neg k : J)) (fun k => (pos k : J))
  have hΩ : IsOpenImmersion Ω.left :=
    localSplitBigCell R G hG I i hic hmax J P hP b u hu m n neg pos
  have : Smooth G.X.hom := hG.smooth
  have hcellSmooth : Smooth (cellObj R I m n).hom := by
    rw [← Over.w Ω]
    infer_instance
  -- the residue field and the special fibre
  let π : Spec (CommRingCat.of κ) ⟶ Spec (CommRingCat.of R) := Spec.algebraMap R κ
  let Gκ := (GroupScheme.baseChange π).obj G
  have : Smooth Gκ.X.hom := inferInstanceAs (Smooth (pullback.snd G.X.hom π))
  have : IsAffineHom Gκ.X.hom := inferInstanceAs (IsAffineHom (pullback.snd G.X.hom π))
  have hκred : IsConnectedReductive Gκ :=
    fieldReductive_of_residueReductive G Set.univ
      (fun s _ => hG.isConnectedReductive_residueFiber s) π (Set.mem_univ _)
  have : ConnectedSpace Gκ.X.left := hκred.connectedSpace
  let e := baseChangeBasePointsEquiv π G
  -- restriction of `R`-points to the residue field
  let τ : Over.mk π ⟶ 𝟙_ (Over (Spec (CommRingCat.of R))) := Over.homMk π (by simp)
  let r : (𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ G.X) →* (Over.mk π ⟶ G.X) :=
    { toFun := fun x => τ ≫ x
      map_one' := MonObj.comp_one τ
      map_mul' := fun x y => MonObj.comp_mul τ x y }
  have hτ : τ.left = π := rfl
  have : IsLocalHom (algebraMap R κ) := inferInstanceAs (IsLocalHom (IsLocalRing.residue R))
  have hπ : π (IsLocalRing.closedPoint κ) = IsLocalRing.closedPoint R :=
    IsLocalRing.comap_closedPoint (algebraMap R κ)
  have hr : ∀ x : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ G.X,
      (r x).left (IsLocalRing.closedPoint κ) = x.left (IsLocalRing.closedPoint R) := by
    intro x
    change x.left (π (IsLocalRing.closedPoint κ)) = _
    rw [hπ]
  have he : ∀ y : rationalPoints Gκ,
      (e y).left (IsLocalRing.closedPoint κ) =
        pullback.fst G.X.hom π (y.left (IsLocalRing.closedPoint κ)) := by
    intro y
    rw [baseChangeBasePointsEquiv_left]
    rfl
  -- the open set of the special fibre lying over the big cell
  let U : Set Gκ.X.left := (pullback.fst G.X.hom π) ⁻¹' Set.range Ω.left
  have hU : IsOpen U := (IsOpenImmersion.isOpen_range Ω.left).preimage
    (pullback.fst G.X.hom π).continuous
  -- a point of the big cell
  let y₁ : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ cellObj R I m n :=
    lift (lift η[(VectorGroup.groupScheme (CommRingCat.of R) _).X]
      η[(splitTorus (Spec (CommRingCat.of R)) I).X])
      η[(VectorGroup.groupScheme (CommRingCat.of R) _).X]
  have h0 : (e.symm (r (y₁ ≫ Ω))).left (IsLocalRing.closedPoint κ) ∈ U := by
    change pullback.fst G.X.hom π _ ∈ Set.range Ω.left
    rw [← he, MulEquiv.apply_symm_apply, hr]
    exact ⟨_, rfl⟩
  obtain ⟨q, hqU, hqpU⟩ := exists_rationalPoint_mem_inv_mul_mem κ Gκ U hU _ h0 (e.symm (r g))
  -- lift `q` to an `R`-point of the big cell
  have hq : (e q).left (IsLocalRing.closedPoint κ) ∈ Set.range Ω.left := by
    rw [he]
    exact hqU
  have hqrange : Set.range (e q).left ⊆ Set.range Ω.left := by
    rintro _ ⟨z, rfl⟩
    rw [Subsingleton.elim (α := PrimeSpectrum κ) z (IsLocalRing.closedPoint κ)]
    exact hq
  let bq : Spec (CommRingCat.of κ) ⟶ (cellObj R I m n).left :=
    IsOpenImmersion.lift Ω.left (e q).left hqrange
  have hbq : bq ≫ (cellObj R I m n).hom = Spec.map (CommRingCat.ofHom (algebraMap R κ)) := by
    rw [← Over.w Ω, ← Category.assoc, IsOpenImmersion.lift_fac]
    exact Over.w (e q)
  obtain ⟨σ, hσ, hσb⟩ :=
    Langlands.CommutativeAlgebra.HenselianSections.exists_section_of_smooth_of_surjective
      (K := κ) IsLocalRing.residue_surjective (cellObj R I m n).hom bq hbq
  let σ' : 𝟙_ (Over (Spec (CommRingCat.of R))) ⟶ cellObj R I m n := Over.homMk σ hσ
  let h := σ' ≫ Ω
  have hrh : r h = e q := by
    change τ ≫ σ' ≫ Ω = e q
    have hτσ : τ ≫ σ' = Over.homMk bq (by rw [hbq]; rfl) := by
      apply Over.OverMorphism.ext
      change π ≫ σ = bq
      exact hσb
    rw [← Category.assoc, hτσ]
    apply Over.OverMorphism.ext
    exact IsOpenImmersion.lift_fac _ _ _
  -- the second factor
  have hk : (h⁻¹ * g).left (IsLocalRing.closedPoint R) ∈ Set.range Ω.left := by
    rw [← hr, map_mul, map_inv, hrh, ← MulEquiv.apply_symm_apply e (r g), ← map_inv,
      ← map_mul, he]
    exact hqpU
  obtain ⟨y, hy⟩ := exists_lift_of_closedPoint_mem Ω (h⁻¹ * g) hk
  have hg : g = h * (h⁻¹ * g) := by group
  rw [hg]
  exact mul_mem (cellMap_mem_closure i u _ _ σ') (hy ▸ cellMap_mem_closure i u _ _ y)

end Main

end Langlands.GroupScheme.LocalSplitCell
