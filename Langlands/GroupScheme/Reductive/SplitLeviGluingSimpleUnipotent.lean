/-! # The simple root subgroups generate the unipotent subgroup of a chamber -/

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry Topology
open scoped CategoryTheory.MonObj Pointwise

namespace Langlands.GroupScheme.LeviGluing

section Points

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)

/-- The group of rational points of the root subgroup of a simple root `a` for `ν`. -/
def simpleRootPoints (a : simpleRelativeRoots i ν) :
    Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) :=
  (RelativeRoot.subgroup i (a : characterLattice T)).carrier (Over.mk (𝟙 _))

/-- The group of rational points of the root subgroup of `-a`, for a simple root `a` for `ν`. -/
def oppositeRootPoints (a : simpleRelativeRoots i ν) :
    Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) :=
  (RelativeRoot.subgroup i (-(a : characterLattice T))).carrier (Over.mk (𝟙 _))

/-- The group of rational points of the centralizer of `ν`. -/
def chamberCentralizerPoints : Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) :=
  (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).carrier (Over.mk (𝟙 _))

/-- The abstract group generated by the rational points of the root subgroups of the simple
roots for `ν`. -/
def simpleRootGenerated : Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) :=
  Subgroup.closure (⋃ a, (simpleRootPoints i ν a : Set _))

/-- The abstract group generated by the rational points of the root subgroups of the negatives
of the simple roots for `ν`. -/
def oppositeRootGenerated : Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X) :=
  Subgroup.closure (⋃ a, (oppositeRootPoints i ν a : Set _))

end Points

section Closure

variable {k : Type u} [Field k]

/-- Over an algebraically closed field, a morphism from a scheme locally of finite type lies in
the closure of the locations of `S` once all its rational points lie in the rational-point
closure of `S`. -/
theorem range_subset_closure_of_rationalPointClosure [IsAlgClosed k]
    {H : GroupScheme (Spec (CommRingCat.of k))}
    {P : Over (Spec (CommRingCat.of k))} [LocallyOfFiniteType P.hom] (f : P ⟶ H.X)
    (S : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X))
    (hS : ∀ y : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ P, y ≫ f ∈ rationalPointClosure H S) :
    Set.range f.left ⊆ closure (rationalPointImage H S) := by
  refine (range_subset_closure_rationalPointImage f (rationalPointClosure H S) hS).trans
    (closure_minimal ?_ isClosed_closure)
  rintro _ ⟨x, hx, rfl⟩
  exact hx

variable {G : GroupScheme (Spec (CommRingCat.of k))}

/-- **Projection to the last factor of an open cell.** Let `m`, `c` and `u` be subgroups of `G`
whose triple multiplication is an open immersion, and `V`, `Y`, `U` sets of rational points of
their ranges. If the products `V * Y * U` have dense locations in `G`, then every rational point
of `u` lies in the rational-point closure of `U`. -/
theorem comp_mem_rationalPointClosure_of_dense_tripleProduct
    {M Z A : GroupScheme (Spec (CommRingCat.of k))} (m : M ⟶ G) (c : Z ⟶ G) (u : A ⟶ G)
    (hopen : IsOpenImmersion (Dynamic.tripleCellMultiplication m c u).left)
    (V Y U : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X))
    (hV : V ⊆ (SubgroupFunctor.range m).carrier (Over.mk (𝟙 _)))
    (hY : Y ⊆ (SubgroupFunctor.range c).carrier (Over.mk (𝟙 _)))
    (hU : U ⊆ (SubgroupFunctor.range u).carrier (Over.mk (𝟙 _)))
    (hdense : Dense (rationalPointImage G (V * Y * U)))
    (y : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ A.X) :
    y ≫ u.hom.hom ∈ rationalPointClosure G U := by
  let C := Dynamic.tripleCellMultiplication m c u
  let pr : M.X ⊗ (Z.X ⊗ A.X) ⟶ G.X :=
    snd M.X (Z.X ⊗ A.X) ≫ snd Z.X A.X ≫ u.hom.hom
  have hpr : ∀ {W : Over (Spec (CommRingCat.of k))} (v : W ⟶ M.X) (s : W ⟶ Z.X)
      (w : W ⟶ A.X), lift v (lift s w) ≫ pr = w ≫ u.hom.hom := by
    intro W v s w
    simp only [pr, lift_snd_assoc]
  change (y ≫ u.hom.hom).left (IsLocalRing.closedPoint k) ∈ closure (rationalPointImage G U)
  rw [mem_closure_iff]
  intro O hO hyO
  let O' := pr.left ⁻¹' O
  have hO' : IsOpen O' := hO.preimage pr.left.continuous
  let p0 : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ M.X ⊗ (Z.X ⊗ A.X) := lift 1 (lift 1 y)
  have hp0 : p0.left (IsLocalRing.closedPoint k) ∈ O' := by
    change (p0 ≫ pr).left (IsLocalRing.closedPoint k) ∈ O
    rw [hpr]
    exact hyO
  have : IsOpenImmersion C.left := hopen
  have hCO : IsOpen (C.left '' O') := C.left.isOpenEmbedding.isOpenMap _ hO'
  obtain ⟨_, ⟨p', hp'O, rfl⟩, g, hg, hgp⟩ :=
    hdense.inter_open_nonempty _ hCO ⟨_, ⟨_, hp0, rfl⟩⟩
  rcases hg with ⟨_, ⟨v, hv, s, hs, rfl⟩, w, hw, rfl⟩
  obtain ⟨v', rfl⟩ := SubgroupFunctor.mem_range.mp (hV hv)
  obtain ⟨s', rfl⟩ := SubgroupFunctor.mem_range.mp (hY hs)
  obtain ⟨w', rfl⟩ := SubgroupFunctor.mem_range.mp (hU hw)
  let Q : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ M.X ⊗ (Z.X ⊗ A.X) := lift v' (lift s' w')
  have hQ : Q ≫ C = v' ≫ m.hom.hom * (s' ≫ c.hom.hom) * (w' ≫ u.hom.hom) := by
    rw [Dynamic.lift_tripleCellMultiplication, mul_assoc]
  have hinj : p' = Q.left (IsLocalRing.closedPoint k) := by
    apply C.left.isOpenEmbedding.injective
    change C.left p' = (Q ≫ C).left (IsLocalRing.closedPoint k)
    rw [hQ]
    exact hgp.symm
  refine ⟨(w' ≫ u.hom.hom).left (IsLocalRing.closedPoint k), ?_, w' ≫ u.hom.hom, hw, rfl⟩
  have h : pr.left p' ∈ O := hp'O
  rw [hinj] at h
  change (Q ≫ pr).left (IsLocalRing.closedPoint k) ∈ O at h
  rwa [hpr] at h

end Closure

section Envelope

variable {k : Type u} [Field k] [IsAlgClosed k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom] [Smooth G.X.hom]

/-- A subgroup functor with a smooth representative whose rational points lie in a group `Γ`
of rational points lies in the closure envelope of `Γ`. -/
theorem le_range_rationalClosureEnvelope
    (Γ : Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X))
    {F : SubgroupFunctor G} {H : GroupScheme (Spec (CommRingCat.of k))} {j : H ⟶ G}
    [Smooth H.X.hom] (hj : F.IsRepresentedBy j)
    (hΓ : ∀ x ∈ F.carrier (Over.mk (𝟙 _)), x ∈ Γ) :
    F ≤ SubgroupFunctor.range (rationalClosureEnvelope G Γ).inclusion := by
  let E := rationalClosureEnvelope G Γ
  have : IsReduced H.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k _ H.X.hom
  obtain ⟨g, hg⟩ : FactorsThrough j.hom.hom E.inclusion := by
    apply factorsThrough_of_range_subset E.closed
    rw [E.range_eq]
    apply range_subset_closure_rationalPointImage
    intro y
    apply hΓ
    rw [← hj.2]
    exact SubgroupFunctor.mem_range.mpr ⟨y, rfl⟩
  rw [← hj.2]
  intro W x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  exact SubgroupFunctor.mem_range.mpr ⟨y ≫ g, by rw [Category.assoc, hg]⟩

variable [ConnectedSpace G.X.left]
    {T : CommGroupScheme (Spec (CommRingCat.of k))} {i : T.toGrp ⟶ G} {J : Type v}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)}

/-- **Rational generation by the simple-root Levi subgroups.** Over an algebraically closed
field, a group of rational points containing the rational points of the root subgroups of the
simple roots for `ν`, of their negatives and of the centralizer of `ν` has dense locations. -/
theorem dense_rationalPointImage_of_simpleRootLevis (hT : IsSplitTorus T.toGrp)
    (hi : IsClosedSubgroup i) (hP : IsRootDatumOf i P) {ν : cocharacterLattice T}
    (hν : IsGenericCocharacter i ν)
    (Γ : Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X))
    (hpos : ∀ a, simpleRootPoints i ν a ≤ Γ) (hneg : ∀ a, oppositeRootPoints i ν a ≤ Γ)
    (hZ : chamberCentralizerPoints i ν ≤ Γ) :
    Dense (rationalPointImage G (Γ : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X))) := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  let E := rationalClosureEnvelope G Γ
  have hroot : ∀ b : characterLattice T, b ≠ 0 →
      (RelativeRoot.subgroup i b).carrier (Over.mk (𝟙 _)) ≤ Γ →
      RelativeRoot.subgroup i b ≤ SubgroupFunctor.range E.inclusion := by
    intro b hb hbΓ
    obtain ⟨U, jU, hjU, _, hUs, _⟩ :=
      RelativeRoot.subgroup_has_smooth_closed_representative hT i b hb
    let : Smooth U.X.hom := hUs
    exact le_range_rationalClosureEnvelope Γ hjU fun x hx => hbΓ hx
  have hcent : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) ≤
      SubgroupFunctor.range E.inclusion := by
    have hz := Dynamic.Affine.isRepresentedBy_centralizerHom (CommGroupScheme.groupHom ν ≫ i)
    let : Smooth (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ν ≫ i)).X.hom :=
      (dynamicSmooth k G _ _ _).2.1 hz
    exact le_range_rationalClosureEnvelope Γ hz fun x hx => hZ hx
  have htop := range_eq_top_of_simpleRootLevis hT hi hP hν E.inclusion E.closed
    (fun a ha => hroot a ha.1.1.1 (hpos ⟨a, ha⟩))
    (fun a ha => hroot (-a) (neg_ne_zero.mpr ha.1.1.1) (hneg ⟨a, ha⟩)) hcent
  have hmem : 𝟙 G.X ∈ (SubgroupFunctor.range E.inclusion).carrier G.X := by
    rw [htop]
    exact Subgroup.mem_top _
  obtain ⟨g, hg⟩ := SubgroupFunctor.mem_range.mp hmem
  rw [dense_iff_closure_eq, ← E.range_eq]
  exact Set.eq_univ_of_forall fun x => ⟨g.left x, congrArg (fun f : G.X ⟶ G.X => f.left x) hg⟩

end Envelope

section LeviPair

variable {k : Type u} [Field k] [IsAlgClosed k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]
    {T : CommGroupScheme (Spec (CommRingCat.of k))} {i : T.toGrp ⟶ G} {J : Type v}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)}

/-- **Rank-one closure in the Levi subgroup of a simple root.** For a simple root `a` for `ν`,
every product `x * y` of rational points of the root subgroups of `a` and `-a` lies in the
rational-point closure of the products `y' * t * x'` of rational points of the root subgroup of
`-a`, the centralizer of `ν` and the root subgroup of `a`. -/
theorem simple_mul_opposite_subset_rationalPointClosure (hT : IsSplitTorus T.toGrp)
    (hP : IsRootDatumOf i P) {ν : cocharacterLattice T} (a : simpleRelativeRoots i ν) :
    (simpleRootPoints i ν a : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)) *
        (oppositeRootPoints i ν a : Set _) ⊆
      rationalPointClosure G ((oppositeRootPoints i ν a : Set _) *
        (chamberCentralizerPoints i ν : Set _) * (simpleRootPoints i ν a : Set _)) := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have ha : (a : characterLattice T) ∈ simpleRelativeRoots i ν := a.2
  have ha0 : (a : characterLattice T) ≠ 0 := ha.1.1.1
  let ζ := leviCocharacter hT i ha0
  have hζa : latticePairing T (a : characterLattice T) ζ = 0 :=
    latticePairing_leviCocharacter hT i ha0
  have hdep : ∀ χ ∈ roots i, latticePairing T χ ζ = 0 →
      ¬ LinearIndependent ℤ ![(a : characterLattice T), χ] :=
    fun _ hχ hχζ => not_linearIndependent_of_latticePairing_leviCocharacter hT i ha0 hχ hχζ
  let z := Dynamic.Affine.centralizerHom (CommGroupScheme.groupHom ζ ≫ i)
  have hz : (Dynamic.centralizer (CommGroupScheme.groupHom ζ ≫ i)).IsRepresentedBy z :=
    Dynamic.Affine.isRepresentedBy_centralizerHom _
  have hzc : IsClosedSubgroup z := Dynamic.Affine.isClosedSubgroup_centralizerHom _
  let : IsAffineHom (Dynamic.Affine.centralizerScheme
    (CommGroupScheme.groupHom ζ ≫ i)).X.hom := hzc.isAffineHom
  let : Smooth (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ζ ≫ i)).X.hom :=
    (dynamicSmooth k G _ _ z).2.1 hz
  let : ConnectedSpace
      (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ζ ≫ i)).X.left :=
    DynamicConnected.connectedSpace_of_isRepresentedBy_centralizer G _ hz
  have : IsAffine (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ζ ≫ i)).X.left :=
    isAffine_of_isAffineHom
      (Dynamic.Affine.centralizerScheme (CommGroupScheme.groupHom ζ ≫ i)).X.hom
  let t := Dynamic.torusFactor i (CommGroupScheme.groupHom ζ) hz
  have ht : t ≫ z = i := Dynamic.torusFactor_comp _ _ _
  have hroots : ∀ χ ∈ relativeRoots t, χ ∈ roots i ∧ latticePairing T χ ζ = 0 :=
    fun χ hχ => ⟨relativeRoots_subset_of_factor hz t ht hχ,
      relativeRoot_pairing_eq_zero_of_le_dynamicCentralizer hz t ht ζ le_rfl hχ⟩
  have hU : Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ t) ≤
      (RelativeRoot.subgroup i (a : characterLattice T)).comap z :=
    unipotent_le_comap_of_support hT z hzc t ht ν ha0
      (fun χ hχ hχν => mem_cyclicTail_of_not_linearIndependent hP ha (hroots χ hχ).1 hχν
        (hdep χ (hroots χ hχ).1 (hroots χ hχ).2)) le_rfl
  have hM : Dynamic.unipotent (CommGroupScheme.groupHom
      (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫ (CommGroupScheme.groupHom ν ≫ t)) ≤
      (RelativeRoot.subgroup i (-(a : characterLattice T))).comap z := by
    have h := unipotent_le_comap_of_support hT z hzc t ht (-ν) (neg_ne_zero.mpr ha0)
      (fun χ hχ hχν => by
        obtain ⟨hχi, hχζ⟩ := hroots χ hχ
        have hχν' : 0 < latticePairing T (-χ) ν := by
          rw [map_neg, LinearMap.neg_apply]
          rw [map_neg] at hχν
          linarith
        have hmem := mem_cyclicTail_of_not_linearIndependent hP ha (neg_mem_roots hP hχi)
          hχν' (hdep _ (neg_mem_roots hP hχi)
            (by rw [map_neg, LinearMap.neg_apply, hχζ, neg_zero]))
        obtain ⟨n, hn1, hn0, hn⟩ := hmem
        exact ⟨n, hn1, hn0, by rw [smul_neg, hn, neg_neg]⟩) le_rfl
    rwa [groupHom_neg_comp_eq_oppositeCocharacter] at h
  have hC : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ t) ≤
      (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i)).comap z := by
    have heq : (CommGroupScheme.groupHom ν ≫ t) ≫ z = CommGroupScheme.groupHom ν ≫ i := by
      rw [Category.assoc, ht]
    have h := Dynamic.centralizer_le_comap (CommGroupScheme.groupHom ν ≫ t) z
    rwa [heq] at h
  let χM := CommGroupScheme.groupHom (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫
    (CommGroupScheme.groupHom ν ≫ t)
  have hcell := rationalPointClosure_dynamicTripleProduct_eq_univ
    (CommGroupScheme.groupHom ν ≫ t) (Dynamic.Affine.isRepresentedBy_unipotentHom χM)
    (Dynamic.Affine.isRepresentedBy_centralizerHom (CommGroupScheme.groupHom ν ≫ t))
    (Dynamic.Affine.isRepresentedBy_unipotentHom (CommGroupScheme.groupHom ν ≫ t))
  rintro _ ⟨x, hx, y, hy, rfl⟩
  have hxz : x ∈ (SubgroupFunctor.range z).carrier (Over.mk (𝟙 _)) := by
    rw [hz.2]
    exact RelativeRoot.subgroup_le_dynamicCentralizer_of_pairing_eq_zero i _ ζ hζa _ hx
  have hyz : y ∈ (SubgroupFunctor.range z).carrier (Over.mk (𝟙 _)) := by
    rw [hz.2]
    exact RelativeRoot.subgroup_le_dynamicCentralizer_of_pairing_eq_zero i _ ζ
      (by rw [map_neg, LinearMap.neg_apply, hζa, neg_zero]) _ hy
  obtain ⟨x', rfl⟩ := SubgroupFunctor.mem_range.mp hxz
  obtain ⟨y', rfl⟩ := SubgroupFunctor.mem_range.mp hyz
  show (x' ≫ z.hom.hom) * (y' ≫ z.hom.hom) ∈ _
  rw [← MonObj.mul_comp]
  have hmem : x' * y' ∈ rationalPointClosure _
      (rationalTripleProduct (Dynamic.Affine.unipotentHom χM)
        (Dynamic.Affine.centralizerHom (CommGroupScheme.groupHom ν ≫ t))
        (Dynamic.Affine.unipotentHom (CommGroupScheme.groupHom ν ≫ t))) := by
    rw [hcell]
    exact Set.mem_univ _
  apply postcomp_mem_rationalPointClosure z.hom.hom _ hmem
  intro s hs
  apply subset_rationalPointClosure
  rcases hs with ⟨_, ⟨p, hp, q, hq, rfl⟩, r, hr, rfl⟩
  rw [MonObj.mul_comp, MonObj.mul_comp]
  refine Set.mul_mem_mul (Set.mul_mem_mul ?_ ?_) ?_
  · obtain ⟨b, rfl⟩ := SubgroupFunctor.mem_range.mp hp
    have hb : b ≫ (Dynamic.Affine.unipotentHom χM).hom.hom ∈
        (Dynamic.unipotent χM).carrier _ := by
      rw [← (Dynamic.Affine.isRepresentedBy_unipotentHom χM).2]
      exact SubgroupFunctor.mem_range.mpr ⟨b, rfl⟩
    exact hM _ hb
  · obtain ⟨b, rfl⟩ := SubgroupFunctor.mem_range.mp hq
    have hb : b ≫ (Dynamic.Affine.centralizerHom (CommGroupScheme.groupHom ν ≫ t)).hom.hom ∈
        (Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ t)).carrier _ := by
      rw [← (Dynamic.Affine.isRepresentedBy_centralizerHom
        (CommGroupScheme.groupHom ν ≫ t)).2]
      exact SubgroupFunctor.mem_range.mpr ⟨b, rfl⟩
    exact hC _ hb
  · obtain ⟨b, rfl⟩ := SubgroupFunctor.mem_range.mp hr
    have hb : b ≫ (Dynamic.Affine.unipotentHom (CommGroupScheme.groupHom ν ≫ t)).hom.hom ∈
        (Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ t)).carrier _ := by
      rw [← (Dynamic.Affine.isRepresentedBy_unipotentHom (CommGroupScheme.groupHom ν ≫ t)).2]
      exact SubgroupFunctor.mem_range.mpr ⟨b, rfl⟩
    exact hU _ hb

end LeviPair

section Main

variable {k : Type u} [Field k] [IsAlgClosed k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom] [ConnectedSpace G.X.left]
    {T : CommGroupScheme (Spec (CommRingCat.of k))} {i : T.toGrp ⟶ G} {J : Type v}
    {P : RootDatum J (characterLattice T) (cocharacterLattice T)}

/-- **Density of the simple-root cell.** Over an algebraically closed field, if the centralizer
of the generic cocharacter `ν` is the torus, the products `v * t * w` with `v` in the group
generated by the rational points of the root subgroups of the negative simple roots, `t` a
rational point of the centralizer of `ν` and `w` in the group generated by the rational points
of the root subgroups of the simple roots have dense locations in `G`. -/
theorem dense_rationalPointImage_simpleRootCell (hT : IsSplitTorus T.toGrp)
    (hi : IsClosedSubgroup i) (hP : IsRootDatumOf i P) {ν : cocharacterLattice T}
    (hν : IsGenericCocharacter i ν)
    (hZT : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) = SubgroupFunctor.range i) :
    Dense (rationalPointImage G
      ((oppositeRootGenerated i ν : Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ G.X)) *
        (chamberCentralizerPoints i ν : Set _) * (simpleRootGenerated i ν : Set _))) := by
  have hconj : ∀ b : characterLattice T, ∀ s ∈ chamberCentralizerPoints i ν,
      ∀ x ∈ (RelativeRoot.subgroup i b).carrier (Over.mk (𝟙 _)),
        s * x * s⁻¹ ∈ (RelativeRoot.subgroup i b).carrier (Over.mk (𝟙 _)) := by
    intro b s hs x hx
    have hs' : s ∈ (SubgroupFunctor.range i).carrier (Over.mk (𝟙 _)) := by
      rw [← hZT]
      exact hs
    exact RelativeRoot.subgroup_isNormalizedBy_range i b _ s x hs' hx
  have hTV : chamberCentralizerPoints i ν ≤
      Subgroup.normalizer (oppositeRootGenerated i ν : Set _) := by
    apply Subgroup.le_normalizer_closure_iff.mpr
    intro s hs x hx
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
    exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨a, hconj _ s hs x ha⟩)
  have hTU : chamberCentralizerPoints i ν ≤
      Subgroup.normalizer (simpleRootGenerated i ν : Set _) := by
    apply Subgroup.le_normalizer_closure_iff.mpr
    intro s hs x hx
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
    exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨a, hconj _ s hs x ha⟩)
  apply dense_rationalPointImage_tripleProduct G (simpleRootPoints i ν) (oppositeRootPoints i ν)
    (oppositeRootGenerated i ν) (chamberCentralizerPoints i ν) (simpleRootGenerated i ν)
    (fun a x hx => Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨a, hx⟩)) rfl hTV hTU
    (fun a b hab x hx y hy => commute_simple_opposite i P hP ν hT hν a b hab hx hy)
    (fun a => simple_mul_opposite_subset_rationalPointClosure hT hP a)
  apply dense_rationalPointImage_of_simpleRootLevis hT hi hP hν
  · exact fun a x hx => Subgroup.subset_closure (Or.inl (Or.inl (Set.mem_iUnion.mpr ⟨a, hx⟩)))
  · exact fun a x hx => Subgroup.subset_closure
      (Or.inl (Or.inr (Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨a, hx⟩))))
  · exact fun x hx => Subgroup.subset_closure (Or.inr hx)

/-- **Generation of the chamber unipotent subgroup by the simple root subgroups**, assuming
that the centralizer of the generic cocharacter `ν` is the torus. Over an algebraically closed
field, every closed subgroup containing the root subgroups of the simple roots for `ν` contains
the dynamic unipotent subgroup of `ν`, on every test scheme. -/
theorem unipotent_le_range_of_simpleRoots_of_centralizer_eq (hT : IsSplitTorus T.toGrp)
    (hi : IsClosedSubgroup i) (hP : IsRootDatumOf i P) {ν : cocharacterLattice T}
    (hν : IsGenericCocharacter i ν)
    (hZT : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) = SubgroupFunctor.range i)
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (hpos : ∀ a ∈ simpleRelativeRoots i ν,
      RelativeRoot.subgroup i a ≤ SubgroupFunctor.range q) :
    Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  let χ := CommGroupScheme.groupHom ν ≫ i
  let χM := CommGroupScheme.groupHom (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫ χ
  have hm := Dynamic.Affine.isRepresentedBy_unipotentHom χM
  have hc := Dynamic.Affine.isRepresentedBy_centralizerHom χ
  have hu := Dynamic.Affine.isRepresentedBy_unipotentHom χ
  have hopen := Dynamic.isOpenImmersion_tripleCellMultiplication χ hm hc hu
  have hVM : oppositeRootGenerated i ν ≤
      (SubgroupFunctor.range (Dynamic.Affine.unipotentHom χM)).carrier (Over.mk (𝟙 _)) := by
    rw [hm.2]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
    have hpos' : 0 < latticePairing T (-(a : characterLattice T)) (-ν) := by
      simpa only [map_neg, LinearMap.neg_apply, neg_neg] using a.2.1.2
    have h := RelativeRoot.subgroup_le_dynamicUnipotent i (-ν) hpos'
    rw [groupHom_neg_comp_eq_oppositeCocharacter] at h
    exact h _ ha
  have hYC : chamberCentralizerPoints i ν ≤
      (SubgroupFunctor.range (Dynamic.Affine.centralizerHom χ)).carrier (Over.mk (𝟙 _)) := by
    rw [hc.2]
    exact le_rfl
  have hUu : simpleRootGenerated i ν ≤
      (SubgroupFunctor.range (Dynamic.Affine.unipotentHom χ)).carrier (Over.mk (𝟙 _)) := by
    rw [hu.2]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
    exact RelativeRoot.subgroup_le_dynamicUnipotent i ν a.2.1.2 _ ha
  have hUq : simpleRootGenerated i ν ≤ (SubgroupFunctor.range q).carrier (Over.mk (𝟙 _)) := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
    exact hpos a a.2 _ ha
  have hdense := dense_rationalPointImage_simpleRootCell hT hi hP hν hZT
  have hclosed : IsClosedImmersion q.hom.hom.left := hq
  have hrange : Set.range (Dynamic.Affine.unipotentHom χ).hom.hom.left ⊆
      Set.range q.hom.hom.left := by
    let : Smooth (Dynamic.Affine.unipotentScheme χ).X.hom := (dynamicSmooth k G _ _ _).2.2 hu
    refine (range_subset_closure_of_rationalPointClosure _ (simpleRootGenerated i ν : Set _)
      fun y => comp_mem_rationalPointClosure_of_dense_tripleProduct _ _ _ hopen _ _ _
        hVM hYC hUu hdense y).trans
      (closure_minimal ?_ q.hom.hom.left.isClosedEmbedding.isClosed_range)
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp (hUq hx)
    exact ⟨y.left (IsLocalRing.closedPoint k), rfl⟩
  let : Smooth (Dynamic.Affine.unipotentScheme χ).X.hom := (dynamicSmooth k G _ _ _).2.2 hu
  have : IsReduced (Dynamic.Affine.unipotentScheme χ).X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k _
      (Dynamic.Affine.unipotentScheme χ).X.hom
  obtain ⟨g, hg⟩ := factorsThrough_of_range_subset hq _ hrange
  rw [← hu.2]
  intro W x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  exact SubgroupFunctor.mem_range.mpr ⟨y ≫ g, by rw [Category.assoc, hg]⟩

/-- **The simple root subgroups generate the chamber unipotent subgroup.** Let `G` be a
connected reductive group over an algebraically closed field, `i : T ⟶ G` a split maximal torus
realized by a root datum `P`, and `ν` a generic cocharacter. Every closed subgroup of `G` whose
range contains the root subgroups of the simple roots for `ν` contains the dynamic unipotent
subgroup `U(ν)`, on every test scheme. -/
theorem unipotent_le_range_of_simpleRoots (hG : IsConnectedReductive G)
    (hT : IsSplitTorus T.toGrp) (hi : IsMaximalTorus i) (hP : IsRootDatumOf i P)
    {ν : cocharacterLattice T} (hν : IsGenericCocharacter i ν)
    {K : GroupScheme (Spec (CommRingCat.of k))} (q : K ⟶ G) (hq : IsClosedSubgroup q)
    (hpos : ∀ a ∈ simpleRelativeRoots i ν,
      RelativeRoot.subgroup i a ≤ SubgroupFunctor.range q) :
    Dynamic.unipotent (CommGroupScheme.groupHom ν ≫ i) ≤ SubgroupFunctor.range q := by
  have hself := maximalTorusCentralizer_of_structuralInputs dynamicCentralizerReductive
    noTorusUnipotent solvableTorusQuotient k G hG T i hi
  have hZT : Dynamic.centralizer (CommGroupScheme.groupHom ν ≫ i) = SubgroupFunctor.range i :=
    (genericCentralizer k G hG T i (hi.isMaximalSplitTorus hT) ν hν).trans hself
  exact unipotent_le_range_of_simpleRoots_of_centralizer_eq hT hi.2.1 hP hν hZT q hq hpos

end Main

