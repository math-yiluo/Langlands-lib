namespace Langlands.GroupScheme

namespace LocalSplitCell

section Span

variable {R : Type u} [CommRing R] {G : GroupScheme (Spec (CommRingCat.of R))} {J : Type u}

/-- The subgroup functor generated by the root groups `u a` for `a ∈ Ψ`: on a test scheme `Z`
its points are the subgroup of `G(Z)` generated by all `u_a(x)`, `a ∈ Ψ`, `x ∈ Γ(Z, 𝒪_Z)`. -/
def rootSpan (u : J → (Ga R ⟶ G)) (Ψ : Set J) : SubgroupFunctor G where
  carrier Z := ⨆ a : Ψ, (rootPointHom (u a) Z).range
  comp_mem {T T'} f x hx := by
    refine Subgroup.iSup_induction (fun a : Ψ => (rootPointHom (u a) T).range)
      (C := fun x => f ≫ x ∈ ⨆ a : Ψ, (rootPointHom (u a) T').range) hx
      (fun a x hx => ?_) ?_ (fun a b ha hb => ?_)
    · obtain ⟨c, rfl⟩ := hx
      exact Subgroup.mem_iSup_of_mem a
        ⟨Multiplicative.ofAdd (f.left.appTop c.toAdd), (comp_rootPoint _ f _).symm⟩
    · rw [MonObj.comp_one]
      exact one_mem _
    · rw [MonObj.comp_mul]
      exact mul_mem ha hb

variable (u : J → (Ga R ⟶ G)) (Ψ : Set J)

theorem iSup_rootFactor_eq_rootSpan {n : ℕ} (e : Fin n ≃ Ψ) (Z : Over (Spec (CommRingCat.of R))) :
    (⨆ k, rootFactor u (fun k => (e k : J)) Z k) = (rootSpan u Ψ).carrier Z :=
  e.iSup_comp (g := fun a : Ψ => (rootPointHom (u a) Z).range)

/-- If the root factors along an enumeration `e` of `Ψ` satisfy increasing-height commutator
bounds, the points of the span are exactly the ordered products along `e`. -/
theorem mem_rootSpan_iff {n : ℕ} (e : Fin n ≃ Ψ) (w : Fin n → ℕ)
    (Z : Over (Spec (CommRingCat.of R)))
    (hc : ∀ k l, ⁅rootFactor u (fun k => (e k : J)) Z k, rootFactor u (fun k => (e k : J)) Z l⁆ ≤
      ⨆ k', ⨆ (_ : max (w k) (w l) < w k'), rootFactor u (fun k => (e k : J)) Z k')
    (g : Z ⟶ G.X) :
    g ∈ (rootSpan u Ψ).carrier Z ↔ ∃ c, orderedProduct u (fun k => (e k : J)) Z c = g := by
  rw [← iSup_rootFactor_eq_rootSpan u Ψ e Z, ← SetLike.mem_coe,
    ← GroupTheory.HeightCollection.range_orderedProduct_eq_iSup _ w hc]
  constructor
  · rintro ⟨x, rfl⟩
    choose c hc using fun k => (x k).2
    refine ⟨fun k => (c k).toAdd, ?_⟩
    change (List.ofFn fun k => rootPoint (u (e k : J)) Z (c k).toAdd).prod =
      (List.ofFn fun k => ((x k : Z ⟶ G.X))).prod
    congr 1
    apply List.ofFn_inj.mpr
    funext k
    exact hc k
  · rintro ⟨c, rfl⟩
    exact ⟨fun k => ⟨rootPoint (u (e k : J)) Z (c k), mem_rootFactor u _ Z k (c k)⟩, rfl⟩

/-- Points of the span as morphisms factoring through the ordered product map. -/
theorem mem_rootSpan_iff_comp {n : ℕ} (e : Fin n ≃ Ψ)
    (hspan : ∀ (Z : Over (Spec (CommRingCat.of R))) (g : Z ⟶ G.X),
      g ∈ (rootSpan u Ψ).carrier Z ↔ ∃ c, orderedProduct u (fun k => (e k : J)) Z c = g)
    (T : Over (Spec (CommRingCat.of R))) (x : T ⟶ G.X) :
    x ∈ (rootSpan u Ψ).carrier T ↔
      ∃ y : T ⟶ (VectorGroup.groupScheme (CommRingCat.of R) n).X,
        y ≫ positiveProductMap u (fun k => (e k : J)) = x := by
  rw [hspan]
  constructor
  · rintro ⟨c, rfl⟩
    refine ⟨(VectorGroup.coordinates (CommRingCat.of R) n T).symm (Multiplicative.ofAdd c), ?_⟩
    rw [comp_positiveProductMap, MulEquiv.apply_symm_apply, toAdd_ofAdd]
  · rintro ⟨y, rfl⟩
    exact ⟨_, (comp_positiveProductMap _ y).symm⟩

end Span

section Reductive

variable {R : Type u} [CommRing R] {I : Type u} [Fintype I] {J : Type u}
  {G : GroupScheme (Spec (CommRingCat.of R))} [IsAffineHom G.X.hom]
  {i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G} {P : RootDatum J (I → ℤ) (I → ℤ)}
  {u : J → (Ga R ⟶ G)}

/-- **Commutator heights for a closed set of roots.** If `ν` is positive on a closed set `Ψ`
without opposite pairs, the commutator of the root factors of two members of `Ψ` lies in the
subgroup generated by the root factors of members of `Ψ` of strictly larger `ν`-height. -/
theorem commutator_rootFactor_le_of_closed (hG : IsReductive G)
    (hmax : IsFibrewiseMaximalTorus (T := splitTorus.commGroupScheme _ I) i)
    (hP : IsFibrewiseRootDatumOf I G i P) (hv : ∀ α, IsRootParametrization i (P.root α) (u α))
    (Ψ : Set J)
    (hcl : ∀ a ∈ Ψ, ∀ c ∈ Ψ, ∀ d : J, P.root d = P.root a + P.root c → d ∈ Ψ)
    (hopp : ∀ a ∈ Ψ, ∀ c ∈ Ψ, P.root a + P.root c ≠ 0)
    (ν : I → ℤ) (hν : ∀ a ∈ Ψ, 0 < coPairing (P.root a) ν) {n : ℕ} (e : Fin n ≃ Ψ)
    (Z : Over (Spec (CommRingCat.of R))) (k l : Fin n) :
    ⁅rootFactor u (fun k => (e k : J)) Z k, rootFactor u (fun k => (e k : J)) Z l⁆ ≤
      ⨆ k', ⨆ (_ : max (coPairing (P.root (e k : J)) ν).toNat
          (coPairing (P.root (e l : J)) ν).toNat < (coPairing (P.root (e k' : J)) ν).toNat),
        rootFactor u (fun k => (e k : J)) Z k' := by
  classical
  by_cases hkl : k = l
  · subst hkl
    apply Subgroup.commutator_le.mpr
    rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    rw [commutatorElement_eq_one_iff_mul_comm.mpr (by rw [← map_mul, ← map_mul, mul_comm])]
    exact one_mem _
  have := hP.finite
  have : Fintype J := Fintype.ofFinite J
  have ha : (e k : J) ∈ Ψ := (e k).2
  have hc : (e l : J) ∈ Ψ := (e l).2
  have hac : (e k : J) ≠ (e l : J) := fun h => hkl (e.injective (Subtype.ext h))
  have hca : P.root (e l : J) ≠ P.root (e k : J) := fun h => hac (P.root.injective h).symm
  have hcna : P.root (e l : J) ≠ -P.root (e k : J) := fun h =>
    hopp _ ha _ hc (by rw [h, add_neg_cancel])
  let D := {d : J // ∃ p q : ℕ, 0 < p ∧ 0 < q ∧
    P.root d = p • P.root (e k : J) + q • P.root (e l : J)}
  let eD : Fin (Fintype.card D) ≃ D := (Fintype.equivFin D).symm
  obtain ⟨p, q, C, hpq, hcomm⟩ :=
    exists_commutator_orderedProduct hG hmax hP hv (e k : J) (e l : J) hca hcna _ eD
  apply Subgroup.commutator_le.mpr
  rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
  have hstd : ⁅rootPointHom (u (e k : J)) Z x, rootPointHom (u (e l : J)) Z y⁆ =
      orderedProduct u (fun r => (eD r : J)) Z
        (fun r => scalarMap Z (C r) * x.toAdd ^ p r * y.toAdd ^ q r) := by
    rw [← hcomm, commutatorElement_def, rootPoint_neg, rootPoint_neg]
    rfl
  rw [hstd]
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨r, rfl⟩ := List.mem_ofFn.mp hg
  obtain ⟨hp, hq, hroot⟩ := hpq r
  have hmem : (eD r : J) ∈ Ψ :=
    LinearAlgebra.mem_of_root_eq_nsmul_add_nsmul P Ψ hcl ha hc (p r) (q r) hroot
  have hk' : (e (e.symm ⟨eD r, hmem⟩) : J) = eD r := by simp
  refine Subgroup.mem_iSup_of_mem (e.symm ⟨eD r, hmem⟩) (Subgroup.mem_iSup_of_mem ?_ ?_)
  · have hA := hν _ ha
    have hC := hν _ hc
    have hD : coPairing (P.root (e (e.symm ⟨eD r, hmem⟩) : J)) ν =
        (p r : ℤ) * coPairing (P.root (e k : J)) ν + (q r : ℤ) * coPairing (P.root (e l : J)) ν := by
      rw [hk', hroot, ← natCast_zsmul, ← natCast_zsmul, coPairing_combo]
    have hp1 : (1 : ℤ) ≤ p r := by exact_mod_cast hp
    have hq1 : (1 : ℤ) ≤ q r := by exact_mod_cast hq
    have h1 : coPairing (P.root (e k : J)) ν <
        coPairing (P.root (e (e.symm ⟨eD r, hmem⟩) : J)) ν := by
      rw [hD]
      nlinarith
    have h2 : coPairing (P.root (e l : J)) ν <
        coPairing (P.root (e (e.symm ⟨eD r, hmem⟩) : J)) ν := by
      rw [hD]
      nlinarith
    omega
  · change _ ∈ (rootPointHom (u (e (e.symm ⟨eD r, hmem⟩) : J)) Z).range
    rw [hk']
    exact ⟨Multiplicative.ofAdd _, rfl⟩

/-- The base change of a vector group along a ring map to a field is a vector group. -/
theorem isVectorGroupOfDimension_baseChange (n : ℕ) (K : Type u) [Field K]
    (ρ : CommRingCat.of R ⟶ CommRingCat.of K) :
    RelativeRoot.IsVectorGroupOfDimension
      ((GroupScheme.baseChange (Spec.map ρ)).obj
        (VectorGroup.groupScheme (CommRingCat.of R) n)) n :=
  RelativeRoot.isVectorGroupOfDimension_iff_nonempty_iso.mpr
    ⟨VectorGroup.baseChangeIso (n := n) ρ⟩

/-- All field-valued fibres of a vector group, in particular its geometric fibres, are
connected. -/
theorem connectedSpace_baseChange_vectorGroup (n : ℕ) (K : Type u) [Field K]
    (g : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of R)) :
    ConnectedSpace
      ((GroupScheme.baseChange g).obj (VectorGroup.groupScheme (CommRingCat.of R) n)).X.left := by
  have h := (isVectorGroupOfDimension_baseChange n K (Spec.preimage g)).connectedSpace
  rwa [Spec.map_preimage] at h

/-- Connectedness of a base-changed group scheme depends only on the underlying scheme over the
base. -/
theorem connectedSpace_baseChange_of_iso {S S' : Scheme.{u}} {V W : GroupScheme S} (φ : V.X ≅ W.X)
    (g : S' ⟶ S) (hV : ConnectedSpace ((GroupScheme.baseChange g).obj V).X.left) :
    ConnectedSpace ((GroupScheme.baseChange g).obj W).X.left := by
  let e : ((GroupScheme.baseChange g).obj V).X ≅ ((GroupScheme.baseChange g).obj W).X :=
    (Over.pullback g).mapIso φ
  exact (Scheme.homeoOfIso ((Over.forget _).mapIso e)).connectedSpace_iff.mp hV

/-- **Subgroups directly spanned by a closed set of roots** (Conrad, *Reductive group schemes*,
Proposition 5.1.16(1)). For a closed set `Ψ` of roots with `Ψ ∩ -Ψ = ∅` there is a smooth closed
subgroup `U_Ψ` of `G`, normalized by the torus, with connected unipotent geometric fibres, such
that for every enumeration `e` of `Ψ` the ordered product `w ↦ ∏ₖ u_{e k}(wₖ)` is an isomorphism
of `𝔾ₐⁿ` onto `U_Ψ`. -/
theorem exists_closedRootSubgroup (hG : IsReductive G)
    (hmax : IsFibrewiseMaximalTorus (T := splitTorus.commGroupScheme _ I) i)
    (hP : IsFibrewiseRootDatumOf I G i P) (hv : ∀ α, IsRootParametrization i (P.root α) (u α))
    (Ψ : Set J)
    (hcl : ∀ a ∈ Ψ, ∀ c ∈ Ψ, ∀ d : J, P.root d = P.root a + P.root c → d ∈ Ψ)
    (hopp : ∀ a ∈ Ψ, ∀ c ∈ Ψ, P.root a + P.root c ≠ 0) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of R))) (j : H ⟶ G),
      IsClosedSubgroup j ∧ Smooth H.X.hom ∧
      (∀ (Z : Over (Spec (CommRingCat.of R)))
        (t : Z ⟶ (splitTorus (Spec (CommRingCat.of R)) I).X) (h : Z ⟶ H.X),
        ∃ h' : Z ⟶ H.X,
          (t ≫ i.hom.hom) * (h ≫ j.hom.hom) * (t ≫ i.hom.hom)⁻¹ = h' ≫ j.hom.hom) ∧
      (∀ s : Spec (CommRingCat.of R),
        ConnectedSpace (geometricFiber H s).X.left ∧ IsUnipotent (geometricFiber H s)) ∧
      ∀ (n : ℕ) (e : Fin n ≃ Ψ),
        ∃ φ : (VectorGroup.groupScheme (CommRingCat.of R) n).X ≅ H.X,
          φ.hom ≫ j.hom.hom =
            orderedProduct u (fun k => ((e k : Ψ) : J)) _
              (VectorGroup.coordinates (CommRingCat.of R) n _ (𝟙 _)).toAdd := by
  classical
  have := hP.finite
  have : Fintype J := Fintype.ofFinite J
  have : P.IsReduced := hP.isReduced
  have : Smooth G.X.hom := hG.smooth
  obtain ⟨b, hb⟩ := LinearAlgebra.exists_base_isPos_of_closed P Ψ hcl hopp
  obtain ⟨d, hd, ν, hν⟩ := exists_coPairing_eq_height P b
  have hνΨ : ∀ a ∈ Ψ, 0 < coPairing (P.root a) ν := by
    intro a ha
    rw [hν]
    have h1 := hb a ha
    rw [RootPairing.Base.isPos_iff] at h1
    exact mul_pos hd h1
  have hu : TorusEquivariant i (fun α => P.root α) u := fun α Z t c => (hv α).equivariant Z t c
  have hspan : ∀ {n : ℕ} (e : Fin n ≃ Ψ) (T : Over (Spec (CommRingCat.of R))) (x : T ⟶ G.X),
      x ∈ (rootSpan u Ψ).carrier T ↔
        ∃ y : T ⟶ (VectorGroup.groupScheme (CommRingCat.of R) n).X,
          y ≫ positiveProductMap u (fun k => (e k : J)) = x := fun e =>
    mem_rootSpan_iff_comp u Ψ e (fun Z g => mem_rootSpan_iff u Ψ e _ Z
      (commutator_rootFactor_le_of_closed hG hmax hP hv Ψ hcl hopp ν hνΨ e Z) g)
  have hclosed : ∀ {n : ℕ} (e : Fin n ≃ Ψ),
      IsClosedImmersion (positiveProductMap u (fun k => (e k : J))).left := fun e =>
    isClosedImmersion_positiveProductMap hG hmax hP hv b _
      (Subtype.val_injective.comp e.injective) (fun k => hb _ (e k).2)
  have hmono : ∀ {n : ℕ} (e : Fin n ≃ Ψ), Mono (positiveProductMap u (fun k => (e k : J))) :=
    fun e => by
      have := hclosed e
      exact Over.mono_of_mono_left _
  let n0 := Fintype.card Ψ
  let e0 : Fin n0 ≃ Ψ := (Fintype.equivFin Ψ).symm
  have : Mono (positiveProductMap u (fun k => (e0 k : J))) := hmono e0
  have : IsClosedImmersion (positiveProductMap u (fun k => (e0 k : J))).left := hclosed e0
  obtain ⟨H, j, hrep, hjc⟩ := (rootSpan u Ψ).isClosedRepresentable_of_scheme
    (positiveProductMap u (fun k => (e0 k : J))) (hspan e0)
  have hmemH : ∀ (T : Over (Spec (CommRingCat.of R))) (x : T ⟶ G.X),
      x ∈ (rootSpan u Ψ).carrier T ↔ ∃ y : T ⟶ H.X, y ≫ j.hom.hom = x := by
    intro T x
    rw [← hrep.2, SubgroupFunctor.mem_range]
  have hjmono : Mono j.hom.hom := hrep.1
  -- the ordered product along any enumeration is an isomorphism onto `H`
  have hiso : ∀ (n : ℕ) (e : Fin n ≃ Ψ),
      ∃ φ : (VectorGroup.groupScheme (CommRingCat.of R) n).X ≅ H.X,
        φ.hom ≫ j.hom.hom = positiveProductMap u (fun k => (e k : J)) := by
    intro n e
    have hmn : Mono (positiveProductMap u (fun k => (e k : J))) := hmono e
    obtain ⟨f, hf⟩ := (hmemH _ (positiveProductMap u (fun k => (e k : J)))).mp
      ((hspan e _ _).mpr ⟨𝟙 _, Category.id_comp _⟩)
    obtain ⟨g, hg⟩ := (hspan e _ j.hom.hom).mp ((hmemH _ _).mpr ⟨𝟙 _, Category.id_comp _⟩)
    refine ⟨⟨f, g, ?_, ?_⟩, hf⟩
    · apply (cancel_mono (positiveProductMap u (fun k => (e k : J)))).mp
      rw [Category.assoc, hg, hf, Category.id_comp]
    · apply (cancel_mono j.hom.hom).mp
      rw [Category.assoc, hf, hg, Category.id_comp]
  obtain ⟨φ0, hφ0⟩ := hiso n0 e0
  let χ := AffineRegularBorel.cocharacter i ν
  have hle : SubgroupFunctor.range j ≤ Dynamic.unipotent χ := by
    rw [hrep.2, SubgroupFunctor.le_def]
    intro T x hx
    obtain ⟨y, rfl⟩ := (hspan e0 T x).mp hx
    rw [comp_positiveProductMap]
    exact orderedProduct_mem_unipotent hu ν _ (fun k => hνΨ _ (e0 k).2) T _
  refine ⟨H, j, hjc, ?_, ?_, ?_, fun n e => ?_⟩
  · have : Smooth (VectorGroup.groupScheme (CommRingCat.of R) n0).X.hom :=
      Corepresented.smooth_groupScheme_iff.mpr inferInstance
    have : IsIso φ0.inv.left := inferInstance
    rw [← Over.w φ0.inv]
    infer_instance
  · intro Z t h
    have hx : h ≫ j.hom.hom ∈ (rootSpan u Ψ).carrier Z := (hmemH _ _).mpr ⟨h, rfl⟩
    obtain ⟨y, hy⟩ := (hspan e0 Z _).mp hx
    have hconj : (t ≫ i.hom.hom) * (h ≫ j.hom.hom) * (t ≫ i.hom.hom)⁻¹ ∈
        (rootSpan u Ψ).carrier Z := by
      rw [← hy, comp_positiveProductMap, torus_mul_orderedProduct_mul_inv hu _ t _]
      refine (hspan e0 Z _).mpr ⟨(VectorGroup.coordinates (CommRingCat.of R) n0 Z).symm
        (Multiplicative.ofAdd fun k => torusChar (P.root (e0 k : J)) Z t *
          (VectorGroup.coordinates (CommRingCat.of R) n0 Z y).toAdd k), ?_⟩
      rw [comp_positiveProductMap, MulEquiv.apply_symm_apply, toAdd_ofAdd]
    obtain ⟨h', hh'⟩ := (hmemH _ _).mp hconj
    exact ⟨h', hh'.symm⟩
  · intro s
    refine ⟨?_, Dynamic.isUnipotent_geometricFiber_of_range_le_unipotent χ j hjc hle s⟩
    exact connectedSpace_baseChange_of_iso φ0 (geometricPoint _ s)
      (connectedSpace_baseChange_vectorGroup n0 _ (geometricPoint _ s))
  · obtain ⟨φ, hφ⟩ := hiso n e
    exact ⟨φ, hφ⟩

end Reductive

