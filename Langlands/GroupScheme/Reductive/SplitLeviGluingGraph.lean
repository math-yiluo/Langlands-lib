import Langlands.GroupScheme.GeneratedFamily
import Langlands.GroupScheme.SmoothProducts
import Langlands.GroupScheme.HomScheme.Graph

/-! # The smooth subgroup generated by local graphs and a common torus -/

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory

namespace Langlands.GroupScheme.LeviGluing

variable {k : Type u} [Field k]
    {G₁ G₂ T : GroupScheme (Spec (CommRingCat.of k))}
    {I : Type v} (A : I → GroupScheme (Spec (CommRingCat.of k)))
    (a₁ : ∀ j, A j ⟶ G₁) (a₂ : ∀ j, A j ⟶ G₂)
    (i₁ : T ⟶ G₁) (i₂ : T ⟶ G₂)

/-- The common torus is included as a generator even if the local family is empty. -/
abbrev graphSources : Option I → GroupScheme (Spec (CommRingCat.of k))
  | none => T
  | some j => A j

/-- The paired local maps, together with the paired common-torus map. -/
def graphMaps : ∀ j, graphSources (T := T) A j ⟶ G₁ ⊗ G₂
  | none => lift i₁ i₂
  | some j => lift (a₁ j) (a₂ j)

/-- A smooth connected affine representative of the closed subgroup generated by
the supplied paired maps. Neither projection is assumed invertible. -/
structure GraphEnvelope where
  group : GroupScheme (Spec (CommRingCat.of k))
  inclusion : group ⟶ G₁ ⊗ G₂
  smooth : Smooth group.X.hom
  affine : IsAffineHom group.X.hom
  connected : ConnectedSpace group.X.left
  generated : IsGeneratedByFamily (graphSources (T := T) A)
    (graphMaps A a₁ a₂ i₁ i₂) inclusion

set_option backward.isDefEq.respectTransparency.types false in
/-- Construct the actual generated graph subgroup using the published arbitrary
family generation theorem. -/
def graphEnvelope
    [Smooth G₁.X.hom] [IsAffineHom G₁.X.hom]
    [Smooth G₂.X.hom] [IsAffineHom G₂.X.hom]
    [Smooth T.X.hom] [IsAffineHom T.X.hom] [ConnectedSpace T.X.left]
    (hA : ∀ j, Smooth (A j).X.hom ∧ IsAffineHom (A j).X.hom ∧
      ConnectedSpace (A j).X.left) :
    GraphEnvelope A a₁ a₂ i₁ i₂ := by
  let : Smooth (G₁ ⊗ G₂).X.hom :=
    smooth_tensor G₁.X G₂.X inferInstance inferInstance
  let : IsAffineHom (G₁ ⊗ G₂).X.hom := by
    change IsAffineHom (pullback.fst G₁.X.hom G₂.X.hom ≫ G₁.X.hom)
    let : IsAffineHom (pullback.fst G₁.X.hom G₂.X.hom) :=
      MorphismProperty.pullback_fst _ _ inferInstance
    infer_instance
  have hfamily : ∀ j, Smooth (graphSources (T := T) A j).X.hom ∧
      IsAffineHom (graphSources (T := T) A j).X.hom ∧
      ConnectedSpace (graphSources (T := T) A j).X.left := by
    rintro (_ | j)
    · exact ⟨inferInstance, inferInstance, inferInstance⟩
    · exact hA j
  have hexists : Nonempty (GraphEnvelope A a₁ a₂ i₁ i₂) := by
    obtain ⟨D, d, hsm, haff, hconn, hgen⟩ :=
      FiniteGeneration.exists_smooth_generated_family
        (a := graphMaps A a₁ a₂ i₁ i₂) hfamily
    exact ⟨⟨D, d, hsm, haff, hconn, hgen⟩⟩
  exact Classical.choice hexists

namespace GraphEnvelope

variable {A a₁ a₂ i₁ i₂} (D : GraphEnvelope A a₁ a₂ i₁ i₂)

instance : Smooth D.group.X.hom := D.smooth
instance : IsAffineHom D.group.X.hom := D.affine
instance : ConnectedSpace D.group.X.left := D.connected

theorem closed : IsClosedSubgroup D.inclusion := D.generated.1

/-- The closed graph inclusion represents its range on every test scheme. -/
theorem represents : (SubgroupFunctor.range D.inclusion).IsRepresentedBy D.inclusion := by
  let : IsClosedImmersion D.inclusion.hom.hom.left := D.closed
  exact ⟨Over.mono_of_mono_left _, rfl⟩

/-- The first actual graph projection. -/
def first : D.group ⟶ G₁ := D.inclusion ≫ fst G₁ G₂

/-- The second actual graph projection. -/
def second : D.group ⟶ G₂ := D.inclusion ≫ snd G₁ G₂

private theorem generator_range_le (j : Option I) :
    SubgroupFunctor.range (graphMaps A a₁ a₂ i₁ i₂ j) ≤
      SubgroupFunctor.range D.inclusion := by
  obtain ⟨b, hb⟩ := D.generated.2.1 j
  intro U x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  apply SubgroupFunctor.mem_range.mpr
  exact ⟨y ≫ b, by rw [Category.assoc, hb]⟩

/-- The unique group homomorphism lifting a generator into the graph subgroup. -/
def generatorLift (j : Option I) : graphSources (T := T) A j ⟶ D.group :=
  D.represents.factorHom (graphMaps A a₁ a₂ i₁ i₂ j) (D.generator_range_le j)

@[reassoc]
theorem generatorLift_comp (j : Option I) :
    D.generatorLift j ≫ D.inclusion = graphMaps A a₁ a₂ i₁ i₂ j :=
  D.represents.factorHom_comp _ _

/-- The local graph lift. For a local Levi isomorphism `φ`, take
`a₂ j = φ.hom ≫ z₂`. -/
def localLift (j : I) : A j ⟶ D.group := D.generatorLift (some j)

/-- The common-torus lift exists without any nonemptiness assumption on `I`. -/
def torusLift : T ⟶ D.group := D.generatorLift none

@[reassoc (attr := simp)]
theorem localLift_first (j : I) : D.localLift j ≫ D.first = a₁ j := by
  rw [first, ← Category.assoc, localLift, generatorLift_comp]
  simp [graphMaps]

@[reassoc (attr := simp)]
theorem localLift_second (j : I) : D.localLift j ≫ D.second = a₂ j := by
  rw [second, ← Category.assoc, localLift, generatorLift_comp]
  simp [graphMaps]

@[reassoc (attr := simp)]
theorem torusLift_first : D.torusLift ≫ D.first = i₁ := by
  rw [first, ← Category.assoc, torusLift, generatorLift_comp]
  simp [graphMaps]

@[reassoc (attr := simp)]
theorem torusLift_second : D.torusLift ≫ D.second = i₂ := by
  rw [second, ← Category.assoc, torusLift, generatorLift_comp]
  simp [graphMaps]

/-- Equality in the graph subgroup can be tested by its two projections,
on all schemes and hence also on nonreduced tests. -/
theorem points_ext {U : Over (Spec (CommRingCat.of k))}
    {x y : U ⟶ D.group.X}
    (h₁ : x ≫ D.first.hom.hom = y ≫ D.first.hom.hom)
    (h₂ : x ≫ D.second.hom.hom = y ≫ D.second.hom.hom) : x = y := by
  apply D.represents.1.right_cancellation
  apply hom_ext
  · simpa only [first, Grp.comp_hom_hom, Grp.fst_hom_hom, Category.assoc] using h₁
  · simpa only [second, Grp.comp_hom_hom, Grp.snd_hom_hom, Category.assoc] using h₂

/-- Equality of graph-valued homomorphisms can be tested by the projections. -/
theorem hom_ext {H : GroupScheme (Spec (CommRingCat.of k))}
    {f g : H ⟶ D.group}
    (h₁ : f ≫ D.first = g ≫ D.first)
    (h₂ : f ≫ D.second = g ≫ D.second) : f = g := by
  apply Grp.hom_ext
  apply D.points_ext
  · simpa only [Grp.comp_hom_hom] using congrArg (fun h => h.hom.hom) h₁
  · simpa only [Grp.comp_hom_hom] using congrArg (fun h => h.hom.hom) h₂

/-- Any compatible local torus map is the distinguished torus lift. -/
theorem local_torusLift (j : I) (t : T ⟶ A j)
    (h₁ : t ≫ a₁ j = i₁) (h₂ : t ≫ a₂ j = i₂) :
    t ≫ D.localLift j = D.torusLift := by
  apply D.hom_ext <;> simp [Category.assoc, h₁, h₂]

/-- Closedness of a first local inclusion gives closedness of its paired map. -/
private theorem paired_closed {H : GroupScheme (Spec (CommRingCat.of k))}
    (f : H ⟶ G₁) (g : H ⟶ G₂) [IsAffineHom G₂.X.hom]
    (hf : IsClosedSubgroup f) : IsClosedSubgroup (lift f g) := by
  have : IsSeparated (fst G₁.X G₂.X).left := by
    change IsSeparated (pullback.fst G₁.X.hom G₂.X.hom)
    infer_instance
  have he : (lift f g).hom.hom.left ≫ (fst G₁.X G₂.X).left = f.hom.hom.left := by
    change ((lift f g ≫ fst G₁ G₂).hom.hom).left = _
    simp
  have : IsClosedImmersion
      ((lift f g).hom.hom.left ≫ (fst G₁.X G₂.X).left) := he.symm ▸ hf
  exact IsClosedImmersion.of_comp _ (fst G₁.X G₂.X).left

/-- The lifted local Levi is closed whenever its first inclusion is closed. -/
theorem localLift_closed [IsAffineHom G₂.X.hom] (j : I)
    (hj : IsClosedSubgroup (a₁ j)) : IsClosedSubgroup (D.localLift j) := by
  apply IsClosedSubgroup.of_comp D.closed
  rw [localLift, generatorLift_comp]
  exact paired_closed (a₁ j) (a₂ j) hj

/-- The common torus is closed in the graph when it is closed in the first group. -/
theorem torusLift_closed [IsAffineHom G₂.X.hom]
    (hi : IsClosedSubgroup i₁) : IsClosedSubgroup D.torusLift := by
  apply IsClosedSubgroup.of_comp D.closed
  rw [torusLift, generatorLift_comp]
  exact paired_closed i₁ i₂ hi

/-- Minimality against arbitrary closed competitors, including nonsmooth ones. -/
theorem range_le {K : GroupScheme (Spec (CommRingCat.of k))}
    (q : K ⟶ G₁ ⊗ G₂) (hq : IsClosedSubgroup q)
    (ht : FactorsThrough (lift i₁ i₂).hom.hom q)
    (hlocal : ∀ j, FactorsThrough (lift (a₁ j) (a₂ j)).hom.hom q) :
    SubgroupFunctor.range D.inclusion ≤ SubgroupFunctor.range q := by
  apply D.generated.2.2 K q hq
  rintro (_ | j)
  · exact ht
  · exact hlocal j

/-- Once both graph projections are proved invertible, their comparison
isomorphism restricts to the supplied common-torus identification. -/
def comparisonIso [IsIso D.first] [IsIso D.second] : G₁ ≅ G₂ :=
  (asIso D.first).symm ≪≫ asIso D.second

theorem torus_comparisonIso [IsIso D.first] [IsIso D.second] :
    i₁ ≫ D.comparisonIso.hom = i₂ := by
  calc
    i₁ ≫ D.comparisonIso.hom =
        (D.torusLift ≫ D.first) ≫ D.comparisonIso.hom :=
      congrArg (fun f => f ≫ D.comparisonIso.hom) D.torusLift_first.symm
    _ = i₂ := by
      simp only [comparisonIso, Iso.trans_hom, Iso.symm_hom, asIso_hom, asIso_inv,
        Category.assoc, IsIso.hom_inv_id_assoc, torusLift_second]

end GraphEnvelope

end Langlands.GroupScheme.LeviGluing
