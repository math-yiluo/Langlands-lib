import Langlands.GroupScheme.Reductive.LinearlyReductiveIntegral
import Langlands.GroupScheme.Reductive.TensorWeights
import Langlands.GroupScheme.MatrixRepresentation.QuotientCoordinates
import Langlands.GroupScheme.MatrixRepresentation.StableProjection
import Langlands.GroupScheme.MatrixRepresentation.MinimalStableSubrepresentation
import Langlands.GroupScheme.MatrixRepresentation.IrreducibleOrbitRealization

/-! # The highest-weight subquotient generated by a simple maximal weight -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped Matrix

namespace Langlands.GroupScheme.MatrixRepresentation

variable {k : Type u} [Field k] {G H : GroupScheme (Spec (CommRingCat.of k))}
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

theorem isStableSubspace_iff_stabilityMap (ρ : MatrixRepresentation G n)
    (V : Submodule k (n → k)) :
    ρ.IsStableSubspace V ↔ ∀ A x ℓ, ∀ v ∈ V, LinearReductivity.coefficientMap ρ A x ℓ v ∈ V :=
  ⟨fun h A x ℓ v hv => h A x v hv ℓ, fun h A x v hv ℓ => h A x ℓ v hv⟩

theorem isStableSubspace_sInf (ρ : MatrixRepresentation G n) (S : Set (Submodule k (n → k)))
    (hS : ∀ V ∈ S, ρ.IsStableSubspace V) : ρ.IsStableSubspace (sInf S) := by
  intro A x v hv ℓ
  rw [Submodule.mem_sInf] at hv ⊢
  intro V hV
  exact hS V hV A x v (hv V hV) ℓ

/-- A stable subspace of a representation which is the sum of its character spaces is the sum
of its intersections with the character spaces. -/
theorem IsStableSubspace.le_iSup_inf_characterSpace [IsAffineHom G.X.hom]
    {ρ : MatrixRepresentation G n} {V : Submodule k (n → k)} (hV : ρ.IsStableSubspace V)
    (htop : ⨆ χ, ρ.characterSpace χ = ⊤) : V ≤ ⨆ χ, V ⊓ ρ.characterSpace χ := by
  classical
  intro v hv
  have hvt : v ∈ ⨆ χ, ρ.characterSpace χ := by rw [htop]; trivial
  obtain ⟨f, hf, hsum⟩ := (Submodule.mem_iSup_iff_exists_finsupp _ v).mp hvt
  have hproj : ∀ χ, ρ.characterProjector χ v = f χ := by
    intro χ
    rw [← hsum, Finsupp.sum, map_sum]
    rw [Finset.sum_eq_single χ]
    · rw [characterProjector_of_mem ρ χ χ (hf χ)]
      simp
    · intro ψ _ hψ
      rw [characterProjector_of_mem ρ χ ψ (hf ψ)]
      simp [hψ]
    · intro hχ
      rw [Finsupp.notMem_support_iff.mp hχ, map_zero]
  rw [← hsum, Finsupp.sum]
  refine Submodule.sum_mem _ fun χ _ => ?_
  refine (le_iSup (fun χ => V ⊓ ρ.characterSpace χ) χ) ⟨?_, hf χ⟩
  rw [← hproj χ]
  exact hV.characterProjector_mem χ hv

end Langlands.GroupScheme.MatrixRepresentation

namespace Langlands.GroupScheme.SplitPinning

open MatrixRepresentation

variable {F : Type u} [Field F]
  {H : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom H.X.hom]
  (p : SplitPinning H) {N : Type} [Fintype N] [DecidableEq N]

/-- A stable subspace is the sum of its intersections with the weight spaces. -/
theorem IsStableSubspace.le_iSup_inf_weightSpace {ρ : MatrixRepresentation H N}
    {V : Submodule F (N → F)} (hV : ρ.IsStableSubspace V) :
    V ≤ ⨆ mu, V ⊓ p.representationWeightSpace ρ mu := by
  let := p.isSplitTorus.isAffineHom
  have h := (hV.restrict p.inclusion).le_iSup_inf_characterSpace
    (iSup_characterSpace_eq_top_of_isSplitTorus p.isSplitTorus (ρ.restrict p.inclusion))
  refine h.trans (iSup_le fun χ => ?_)
  refine le_trans ?_ (le_iSup _ ((rationalCharacters.equivCharacterLattice p.torus) χ))
  change V ⊓ (ρ.restrict p.inclusion).characterSpace χ ≤ V ⊓
    (ρ.restrict p.inclusion).characterSpace
      ((rationalCharacters.equivCharacterLattice p.torus).symm
        ((rationalCharacters.equivCharacterLattice p.torus) χ))
  rw [AddEquiv.symm_apply_apply]

/-- A stable subspace meeting a weight space trivially lies in the sum of the other weight
spaces. -/
theorem IsStableSubspace.le_iSup_ne {ρ : MatrixRepresentation H N} {V : Submodule F (N → F)}
    (hV : ρ.IsStableSubspace V) {nu : characterLattice p.torus}
    (hnu : V ⊓ p.representationWeightSpace ρ nu = ⊥) :
    V ≤ ⨆ (mu) (_ : mu ≠ nu), p.representationWeightSpace ρ mu := by
  refine (IsStableSubspace.le_iSup_inf_weightSpace p hV).trans (iSup_le fun mu => ?_)
  by_cases h : mu = nu
  · subst h
    rw [hnu]
    exact bot_le
  · exact inf_le_right.trans (le_iSup₂_of_le mu h le_rfl)

/-- The smallest stable subspace containing the `nu` weight space. -/
def highestGenerated (ρ : MatrixRepresentation H N) (nu : characterLattice p.torus) :
    Submodule F (N → F) :=
  sInf {V | ρ.IsStableSubspace V ∧ p.representationWeightSpace ρ nu ≤ V}

/-- The largest stable subspace of `highestGenerated` meeting the `nu` weight space trivially. -/
def highestRadical (ρ : MatrixRepresentation H N) (nu : characterLattice p.torus) :
    Submodule F (N → F) :=
  sSup {V | ρ.IsStableSubspace V ∧ V ≤ p.highestGenerated ρ nu ∧
    V ⊓ p.representationWeightSpace ρ nu = ⊥}

variable (ρ : MatrixRepresentation H N) (nu : characterLattice p.torus)

theorem isStableSubspace_highestGenerated : ρ.IsStableSubspace (p.highestGenerated ρ nu) :=
  isStableSubspace_sInf ρ _ fun _ hV => hV.1

theorem weightSpace_le_highestGenerated :
    p.representationWeightSpace ρ nu ≤ p.highestGenerated ρ nu :=
  le_sInf fun _ hV => hV.2

theorem highestGenerated_le {V : Submodule F (N → F)} (hV : ρ.IsStableSubspace V)
    (hle : p.representationWeightSpace ρ nu ≤ V) : p.highestGenerated ρ nu ≤ V :=
  sInf_le ⟨hV, hle⟩

theorem isStableSubspace_highestRadical : ρ.IsStableSubspace (p.highestRadical ρ nu) :=
  LinearReductivity.isStableSubspace_sSup ρ _ fun _ hV => hV.1

theorem highestRadical_le : p.highestRadical ρ nu ≤ p.highestGenerated ρ nu :=
  sSup_le fun _ hV => hV.2.1

theorem le_highestRadical {V : Submodule F (N → F)} (hV : ρ.IsStableSubspace V)
    (hle : V ≤ p.highestGenerated ρ nu) (hnu : V ⊓ p.representationWeightSpace ρ nu = ⊥) :
    V ≤ p.highestRadical ρ nu :=
  le_sSup ⟨hV, hle, hnu⟩

theorem highestRadical_inf_weightSpace :
    p.highestRadical ρ nu ⊓ p.representationWeightSpace ρ nu = ⊥ := by
  have hle : p.highestRadical ρ nu ≤ ⨆ (mu) (_ : mu ≠ nu), p.representationWeightSpace ρ mu :=
    sSup_le fun V hV => IsStableSubspace.le_iSup_ne p hV.1 hV.2.2
  have hd := (iSupIndep_def.mp (iSupIndep_representationWeightSpace (p := p) ρ) nu).symm
  exact (hd.mono_left hle).eq_bot

/-- Every stable subspace between the radical and the generated subspace is one of them, when
the weight `nu` has multiplicity one. -/
theorem eq_highestRadical_or_eq_highestGenerated
    (hmult : Module.finrank F (p.representationWeightSpace ρ nu) = 1)
    {V : Submodule F (N → F)} (hV : ρ.IsStableSubspace V) (hYV : p.highestRadical ρ nu ≤ V)
    (hVX : V ≤ p.highestGenerated ρ nu) :
    V = p.highestRadical ρ nu ∨ V = p.highestGenerated ρ nu := by
  by_cases h : V ⊓ p.representationWeightSpace ρ nu = ⊥
  · exact Or.inl (le_antisymm (p.le_highestRadical ρ nu hV hVX h) hYV)
  · right
    refine le_antisymm hVX (p.highestGenerated_le ρ nu hV ?_)
    have hpos : 0 < Module.finrank F (V ⊓ p.representationWeightSpace ρ nu :
        Submodule F (N → F)) := by
      rw [Module.finrank_pos_iff, Submodule.nontrivial_iff_ne_bot]
      exact h
    have heq : V ⊓ p.representationWeightSpace ρ nu = p.representationWeightSpace ρ nu :=
      Submodule.eq_of_le_of_finrank_le inf_le_right (by rw [hmult]; exact hpos)
    rw [← heq]
    exact inf_le_left

end Langlands.GroupScheme.SplitPinning
