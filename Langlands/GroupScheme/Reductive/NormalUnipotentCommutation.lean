import Langlands.GroupScheme.Reductive.NormalUnipotentRadicalInclusion
import Langlands.GroupScheme.Reductive.ToPseudoReductive
import Langlands.GroupScheme.Reductive.Semisimple
import Langlands.GroupScheme.ImageGenerationPointed
import Langlands.GroupScheme.ImageEnvelopeStabilityProof
import Langlands.GroupScheme.SmoothConnectedGeometryProof
import Langlands.GroupScheme.UnipotentClosedSubgroupProof

/-! # Normal unipotent subgroups commute with normal reductive subgroups -/

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

universe u

open CategoryTheory AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

section GeneralBase

variable {B : Scheme.{u}} {G U H : GroupScheme B}

/-- A normal left input contains the actual two-input commutator morphism. -/
theorem factorsThrough_commutatorMap_left
    (r : U ⟶ G) (i : H ⟶ G) (hn : (SubgroupFunctor.range r).IsNormal) :
    FactorsThrough (commutatorMap r i) r := by
  apply (factorsThrough_iff_containsImage _ _).2
  intro T z
  rw [commutatorMap_points]
  have hx : (z ≫ fst U.X H.X) ≫ r.hom.hom ∈
      (SubgroupFunctor.range r).carrier T :=
    SubgroupFunctor.mem_range.2 ⟨z ≫ fst U.X H.X, rfl⟩
  have hh := hn T ((z ≫ snd U.X H.X) ≫ i.hom.hom)
    (((z ≫ fst U.X H.X) ≫ r.hom.hom)⁻¹) (Subgroup.mem_top _)
      ((SubgroupFunctor.range r).carrier T |>.inv_mem hx)
  simpa only [mul_assoc] using (SubgroupFunctor.range r).carrier T |>.mul_mem hx hh

/-- A normal right input contains the actual two-input commutator morphism. -/
theorem factorsThrough_commutatorMap_right
    (r : U ⟶ G) (i : H ⟶ G) (hn : (SubgroupFunctor.range i).IsNormal) :
    FactorsThrough (commutatorMap r i) i := by
  apply (factorsThrough_iff_containsImage _ _).2
  intro T z
  rw [commutatorMap_points]
  have hx : (z ≫ snd U.X H.X) ≫ i.hom.hom ∈
      (SubgroupFunctor.range i).carrier T :=
    SubgroupFunctor.mem_range.2 ⟨z ≫ snd U.X H.X, rfl⟩
  exact (SubgroupFunctor.range i).carrier T |>.mul_mem
    (hn T ((z ≫ fst U.X H.X) ≫ r.hom.hom)
      ((z ≫ snd U.X H.X) ≫ i.hom.hom) (Subgroup.mem_top _) hx)
    ((SubgroupFunctor.range i).carrier T |>.inv_mem hx)

end GeneralBase

section Field

variable {k : Type u} [Field k]
    {G U H : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    [Smooth U.X.hom] [ConnectedSpace U.X.left]
    [Smooth H.X.hom] [ConnectedSpace H.X.left]

/-- The actual smooth connected normal closed subgroup generated by the
commutator of two smooth connected normal closed subgroups. -/
def normalCommutator
    (r : U ⟶ G) (i : H ⟶ G)
    (hr : IsClosedSubgroup r) (hi : IsClosedSubgroup i)
    (hrn : (SubgroupFunctor.range r).IsNormal)
    (hin : (SubgroupFunctor.range i).IsNormal) :
    {D : GeneratedImage (commutatorMap r i) //
      D.HasSmoothConnectedGeneration ∧ (SubgroupFunctor.range D.inclusion).IsNormal} := by
  let : IsClosedImmersion r.hom.hom.left := hr
  let : IsClosedImmersion i.hom.hom.left := hi
  let : Mono r.hom.hom := Over.mono_of_mono_left _
  let : Mono i.hom.hom := Over.mono_of_mono_left _
  let : IsAffineHom U.X.hom := by
    rw [← r.hom.hom.w]
    infer_instance
  let : IsAffineHom H.X.hom := by
    rw [← i.hom.hom.w]
    infer_instance
  obtain ⟨hAff, hFin, _, hInt⟩ :=
    smoothConnectedAffineGeometry.2 k U H inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance
  let hgen := ImageGeneration.pointedImageGeneration k G inferInstance inferInstance
    (U.X ⊗ H.X) hAff hFin hInt (lift 1 1) (commutatorMap r i)
    (commutatorMap_one_left r i 1)
  let D := Classical.choose hgen
  have hD : D.HasSmoothConnectedGeneration := Classical.choose_spec hgen
  let aU := AutomorphicAction.ofNormalizedConjugation r (𝟙 G)
    (fun T g h _ hh => hrn T g h (Subgroup.mem_top _) hh)
  let aH := AutomorphicAction.ofNormalizedConjugation i (𝟙 G)
    (fun T g h _ hh => hin T g h (Subgroup.mem_top _) hh)
  let aG := AutomorphicAction.conjugation (𝟙 G)
  have heU : aU.toPointwiseSchemeAction.IsEquivariant
      aG.toPointwiseSchemeAction r.hom.hom := by
    intro T g x
    simpa only [aU, aG, AutomorphicAction.toPointwiseSchemeAction_act,
      AutomorphicAction.conjugation_act, Grp.id_hom_hom, Category.comp_id] using
      AutomorphicAction.ofNormalizedConjugation_act_comp r (𝟙 G) _ g x
  have heH : aH.toPointwiseSchemeAction.IsEquivariant
      aG.toPointwiseSchemeAction i.hom.hom := by
    intro T g x
    simpa only [aH, aG, AutomorphicAction.toPointwiseSchemeAction_act,
      AutomorphicAction.conjugation_act, Grp.id_hom_hom, Category.comp_id] using
      AutomorphicAction.ofNormalizedConjugation_act_comp i (𝟙 G) _ g x
  have hstable := aG.closedImageEnvelope_isStable inferInstance
    (aU.toPointwiseSchemeAction.prod aH.toPointwiseSchemeAction) (commutatorMap r i)
      (commutatorMap_equivariant aU aH aG r i heU heH)
  refine ⟨D, hD, ?_⟩
  rw [D.represents.2]
  intro T g x _ hx
  simpa only [aG, AutomorphicAction.conjugation_act, Grp.id_hom_hom,
    Category.comp_id] using hstable T g x hx

/-- A smooth connected normal unipotent closed subgroup commutes with a
smooth connected normal closed subgroup with trivial unipotent radical. -/
theorem commute_of_normal_unipotent_of_trivialRadical
    (r : U ⟶ G) (i : H ⟶ G)
    (hr : IsClosedSubgroup r) (hi : IsClosedSubgroup i)
    (hrn : (SubgroupFunctor.range r).IsNormal)
    (hin : (SubgroupFunctor.range i).IsNormal)
    (hU : IsUnipotent U) (hH : HasTrivialUnipotentRadical H)
    {T : Over (Spec (CommRingCat.of k))} (u : T ⟶ U.X) (h : T ⟶ H.X) :
    Commute (u ≫ r.hom.hom) (h ≫ i.hom.hom) := by
  let : IsClosedImmersion r.hom.hom.left := hr
  let : IsClosedImmersion i.hom.hom.left := hi
  let : Mono i.hom.hom := Over.mono_of_mono_left _
  let : IsAffineHom U.X.hom := by
    rw [← r.hom.hom.w]
    infer_instance
  let D := (normalCommutator r i hr hi hrn hin).val
  have hD := (normalCommutator r i hr hi hrn hin).property
  let : Smooth D.group.X.hom := hD.1.1
  let : GeometricallyConnected D.group.X.hom := hD.1.2.2.1
  have hDc : ConnectedSpace D.group.X.left :=
    GeometricallyConnected.connectedSpace_of_subsingleton (f := D.group.X.hom)
  let p := D.minimalHom r hr (factorsThrough_commutatorMap_left r i hrn)
  let q := D.minimalHom i hi (factorsThrough_commutatorMap_right r i hin)
  have hp : p ≫ r = D.inclusion :=
    D.minimalHom_comp r hr (factorsThrough_commutatorMap_left r i hrn)
  have hq : q ≫ i = D.inclusion :=
    D.minimalHom_comp i hi (factorsThrough_commutatorMap_right r i hin)
  have hq' : q.hom.hom ≫ i.hom.hom = D.inclusion.hom.hom :=
    congrArg (fun f => f.hom.hom) hq
  have hpc : IsClosedSubgroup p :=
    IsClosedSubgroup.of_comp hr (by rw [hp]; exact D.closed)
  have hqc : IsClosedSubgroup q :=
    IsClosedSubgroup.of_comp hi (by rw [hq]; exact D.closed)
  have hDu : IsUnipotent D.group :=
    unipotentClosedSubgroup k U D.group p hpc hU
  have hqn : (SubgroupFunctor.range q).IsNormal := by
    intro W g x _ hx
    obtain ⟨v, rfl⟩ := SubgroupFunctor.mem_range.1 hx
    have hx' : (v ≫ q.hom.hom) ≫ i.hom.hom ∈
        (SubgroupFunctor.range D.inclusion).carrier W := by
      apply SubgroupFunctor.mem_range.2
      refine ⟨v, ?_⟩
      rw [← hq, Grp.comp_hom_hom, Category.assoc]
    have hn := hD.2 W (g ≫ i.hom.hom) _ (Subgroup.mem_top _) hx'
    obtain ⟨v', hv'⟩ := SubgroupFunctor.mem_range.1 hn
    apply SubgroupFunctor.mem_range.2
    refine ⟨v', ?_⟩
    apply (cancel_mono i.hom.hom).mp
    change v' ≫ D.inclusion.hom.hom = _ at hv'
    simpa only [MonObj.mul_comp, GrpObj.inv_comp,
      Category.assoc, hq'] using hv'
  have hbot : SubgroupFunctor.range q = ⊥ :=
    hH D.group q hqc inferInstance hDc hDu hqn
  have hx : (lift u h ≫ D.factor) ≫ q.hom.hom ∈
      (SubgroupFunctor.range q).carrier T :=
    SubgroupFunctor.mem_range.2 ⟨lift u h ≫ D.factor, rfl⟩
  rw [hbot, SubgroupFunctor.bot_carrier, Subgroup.mem_bot] at hx
  have he := congrArg (fun x => x ≫ i.hom.hom) hx
  have hcomm : (u ≫ r.hom.hom) * (h ≫ i.hom.hom) *
      (u ≫ r.hom.hom)⁻¹ * (h ≫ i.hom.hom)⁻¹ = 1 := by
    rw [Category.assoc _ q.hom.hom i.hom.hom, hq',
      D.factor_comp_points, commutatorMap_lift, MonObj.one_comp] at he
    exact he
  apply (commute_iff_eq _ _).2
  exact (mul_inv_eq_iff_eq_mul).mp (mul_inv_eq_one.mp hcomm)

/-- The intersection with a normal unipotent subgroup is contained in the
full centre of a normal connected reductive subgroup, on every test scheme. -/
theorem unipotent_comap_le_center_of_normal_reductive
    (r : U ⟶ G) (i : H ⟶ G)
    (hr : IsClosedSubgroup r) (hi : IsClosedSubgroup i)
    (hrn : (SubgroupFunctor.range r).IsNormal)
    (hin : (SubgroupFunctor.range i).IsNormal)
    (hU : IsUnipotent U) (hH : IsConnectedReductive H) :
    (SubgroupFunctor.range r).comap i ≤ center H := by
  let : IsClosedImmersion i.hom.hom.left := hi
  let : Mono i.hom.hom := Over.mono_of_mono_left _
  intro T x hx W a y
  change x ≫ i.hom.hom ∈ (SubgroupFunctor.range r).carrier T at hx
  obtain ⟨u, hu⟩ := SubgroupFunctor.mem_range.1 hx
  apply (commute_iff_eq _ _).2
  apply (cancel_mono i.hom.hom).mp
  rw [MonObj.mul_comp, MonObj.mul_comp, Category.assoc, ← hu, ← Category.assoc]
  exact (commute_of_normal_unipotent_of_trivialRadical r i hr hi hrn hin hU
    hH.hasTrivialUnipotentRadical (a ≫ u) y).eq

end Field

end Langlands.GroupScheme
