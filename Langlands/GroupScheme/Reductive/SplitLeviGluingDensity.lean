import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Topology.Algebra.Monoid
import Mathlib.Tactic.Group

/-! # The word induction for the Levi graph cell -/

noncomputable section

universe u v

open scoped Pointwise

namespace Langlands.GroupScheme.LeviGluing

variable {G : Type u} [Group G] [TopologicalSpace G] [SeparatelyContinuousMul G]

private theorem left_mul_mem_closure {s : Set G} (a : G)
    (ha : ∀ x ∈ s, a * x ∈ s) {x : G} (hx : x ∈ closure s) :
    a * x ∈ closure s :=
  (isClosed_closure.preimage (continuous_const_mul a)).closure_subset_iff.mpr
    (fun x hx => subset_closure (ha x hx)) hx

private theorem right_mul_mem_closure {s : Set G} (a : G)
    (ha : ∀ x ∈ s, x * a ∈ s) {x : G} (hx : x ∈ closure s) :
    x * a ∈ closure s :=
  (isClosed_closure.preimage (continuous_mul_const a)).closure_subset_iff.mpr
    (fun x hx => subset_closure (ha x hx)) hx

/-- The abstract word-induction part of Milne 23.22. Left multiplication by
the subgroup generated by the positive root groups, negative factor and middle
factor preserves the closure of the three-factor cell. -/
theorem generated_mul_mem_closure_tripleProduct
    {I : Type v} (A B : I → Subgroup G) (V T U : Subgroup G)
    (hA : ∀ i, A i ≤ U)
    (hV : V = Subgroup.closure (⋃ i, (B i : Set G)))
    (hTV : T ≤ Subgroup.normalizer (V : Set G))
    (hTU : T ≤ Subgroup.normalizer (U : Set G))
    (hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ B j, Commute a b)
    (hpair : ∀ i, (A i : Set G) * (B i : Set G) ⊆
      closure ((B i : Set G) * (T : Set G) * (A i : Set G))) :
    ∀ g ∈ Subgroup.closure ((⋃ i, (A i : Set G)) ∪ (V : Set G) ∪ (T : Set G)),
      ∀ x ∈ closure ((V : Set G) * (T : Set G) * (U : Set G)),
        g * x ∈ closure ((V : Set G) * (T : Set G) * (U : Set G)) := by
  classical
  let C : Set G := (V : Set G) * (T : Set G) * (U : Set G)
  have hB : ∀ i, B i ≤ V := by
    intro i b hb
    rw [hV]
    exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, hb⟩)
  have leftV : ∀ b ∈ V, ∀ x ∈ closure C, b * x ∈ closure C := by
    intro b hb x hx
    apply left_mul_mem_closure b ?_ hx
    rintro _ ⟨vt, ⟨v, hv, t, ht, rfl⟩, u, hu, rfl⟩
    exact ⟨(b * v) * t, ⟨b * v, V.mul_mem hb hv, t, ht, rfl⟩,
      u, hu, by group⟩
  have leftT : ∀ b ∈ T, ∀ x ∈ closure C, b * x ∈ closure C := by
    intro b hb x hx
    apply left_mul_mem_closure b ?_ hx
    rintro _ ⟨vt, ⟨v, hv, t, ht, rfl⟩, u, hu, rfl⟩
    have hconj : b * v * b⁻¹ ∈ V :=
      (Subgroup.mem_normalizer_iff.mp (hTV hb) v).mp hv
    exact ⟨(b * v * b⁻¹) * (b * t),
      ⟨b * v * b⁻¹, hconj, b * t, T.mul_mem hb ht, rfl⟩,
      u, hu, by group⟩
  have rightU : ∀ b ∈ U, ∀ x ∈ closure C, x * b ∈ closure C := by
    intro b hb x hx
    apply right_mul_mem_closure b ?_ hx
    rintro _ ⟨vt, ⟨v, hv, t, ht, rfl⟩, u, hu, rfl⟩
    exact ⟨v * t, ⟨v, hv, t, ht, rfl⟩, u * b, U.mul_mem hu hb, by group⟩
  have rightT : ∀ b ∈ T, ∀ x ∈ closure C, x * b ∈ closure C := by
    intro b hb x hx
    apply right_mul_mem_closure b ?_ hx
    rintro _ ⟨vt, ⟨v, hv, t, ht, rfl⟩, u, hu, rfl⟩
    have hconj : b⁻¹ * u * b ∈ U := by
      simpa using (Subgroup.mem_normalizer_iff.mp (hTU (T.inv_mem hb)) u).mp hu
    exact ⟨v * (t * b), ⟨v, hv, t * b, T.mul_mem ht hb, rfl⟩,
      b⁻¹ * u * b, hconj, by group⟩
  have hAV : ∀ v ∈ Subgroup.closure (⋃ i, (B i : Set G)),
      ∀ i, ∀ a ∈ A i, a * v ∈ closure C := by
    have step : ∀ j, ∀ b ∈ B j, ∀ v : G,
        (∀ i, ∀ a ∈ A i, a * v ∈ closure C) →
        ∀ i, ∀ a ∈ A i, a * (b * v) ∈ closure C := by
      intro j b hb v ih i a ha
      by_cases hij : i = j
      · subst j
        have hclosed : closure ((B i : Set G) * (T : Set G) * (A i : Set G)) ⊆
            (fun z => z * v) ⁻¹' closure C := by
          apply (isClosed_closure.preimage (continuous_mul_const v)).closure_subset_iff.mpr
          rintro _ ⟨bt, ⟨b', hb', t, ht, rfl⟩, a', ha', rfl⟩
          change (b' * t * a') * v ∈ closure C
          simpa only [mul_assoc] using
            leftV b' (hB i hb') (t * (a' * v)) (leftT t ht (a' * v) (ih i a' ha'))
        have h := hclosed (hpair i ⟨a, ha, b, hb, rfl⟩)
        change (a * b) * v ∈ closure C at h
        simpa only [mul_assoc] using h
      · have hc := leftV b (hB j hb) (a * v) (ih i a ha)
        simpa only [← mul_assoc, (hcomm i j hij a ha b hb).eq] using hc
    intro v hv
    refine Subgroup.closure_induction_left
      (p := fun v _ => ∀ i, ∀ a ∈ A i, a * v ∈ closure C) ?_ ?_ ?_ hv
    · intro i a ha
      apply subset_closure
      exact ⟨1, ⟨1, V.one_mem, 1, T.one_mem, by simp⟩,
        a, hA i ha, by simp⟩
    · intro b hb v _ ih
      obtain ⟨j, hb⟩ := Set.mem_iUnion.mp hb
      exact step j b hb v ih
    · intro b hb v _ ih
      obtain ⟨j, hb⟩ := Set.mem_iUnion.mp hb
      exact step j b⁻¹ ((B j).inv_mem hb) v ih
  have leftA : ∀ i, ∀ a ∈ A i, ∀ x ∈ closure C, a * x ∈ closure C := by
    intro i a ha x hx
    apply (isClosed_closure.preimage (continuous_const_mul a)).closure_subset_iff.mpr ?_ hx
    rintro _ ⟨vt, ⟨v, hv, t, ht, rfl⟩, u, hu, rfl⟩
    have hav := hAV v (hV ▸ hv) i a ha
    change a * (v * t * u) ∈ closure C
    simpa only [mul_assoc] using rightU u hu ((a * v) * t) (rightT t ht (a * v) hav)
  let S : Set G := (⋃ i, (A i : Set G)) ∪ (V : Set G) ∪ (T : Set G)
  have hstable : ∀ a ∈ S, ∀ x ∈ closure C, a * x ∈ closure C := by
    intro a ha
    rcases ha with (ha | ha) | ha
    · obtain ⟨i, ha⟩ := Set.mem_iUnion.mp ha
      exact leftA i a ha
    · exact leftV a ha
    · exact leftT a ha
  have hinv : ∀ a ∈ S, a⁻¹ ∈ S := by
    intro a ha
    rcases ha with (ha | ha) | ha
    · obtain ⟨i, ha⟩ := Set.mem_iUnion.mp ha
      exact Or.inl (Or.inl (Set.mem_iUnion.mpr ⟨i, (A i).inv_mem ha⟩))
    · exact Or.inl (Or.inr (V.inv_mem ha))
    · exact Or.inr (T.inv_mem ha)
  intro g hg
  have hstab : ∀ x ∈ closure C, g * x ∈ closure C := by
    refine Subgroup.closure_induction_left
      (p := fun g _ => ∀ x ∈ closure C, g * x ∈ closure C) ?_ ?_ ?_ hg
    · intro x hx
      simpa using hx
    · intro a ha b _ ih x hx
      simpa only [mul_assoc] using hstable a ha (b * x) (ih x hx)
    · intro a ha b _ ih x hx
      simpa only [mul_assoc] using hstable a⁻¹ (hinv a ha) (b * x) (ih x hx)
  exact hstab

/-- The left action on the cell closure supplied by the word induction.
This is an action of the abstractly generated subgroup, with no density premise. -/
@[instance_reducible]
def tripleProductClosureAction
    {I : Type v} (A B : I → Subgroup G) (V T U : Subgroup G)
    (hA : ∀ i, A i ≤ U)
    (hV : V = Subgroup.closure (⋃ i, (B i : Set G)))
    (hTV : T ≤ Subgroup.normalizer (V : Set G))
    (hTU : T ≤ Subgroup.normalizer (U : Set G))
    (hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ B j, Commute a b)
    (hpair : ∀ i, (A i : Set G) * (B i : Set G) ⊆
      closure ((B i : Set G) * (T : Set G) * (A i : Set G))) :
    MulAction (Subgroup.closure
      ((⋃ i, (A i : Set G)) ∪ (V : Set G) ∪ (T : Set G)))
      (closure ((V : Set G) * (T : Set G) * (U : Set G))) where
  smul g x := ⟨g.1 * x.1,
    generated_mul_mem_closure_tripleProduct A B V T U hA hV hTV hTU hcomm hpair
      g.1 g.2 x.1 x.2⟩
  one_smul x := Subtype.ext (one_mul x.1)
  mul_smul g h x := Subtype.ext (mul_assoc g.1 h.1 x.1)

/-- The closure of the cell contains the abstractly generated subgroup. -/
theorem generated_subset_closure_tripleProduct
    {I : Type v} (A B : I → Subgroup G) (V T U : Subgroup G)
    (hA : ∀ i, A i ≤ U)
    (hV : V = Subgroup.closure (⋃ i, (B i : Set G)))
    (hTV : T ≤ Subgroup.normalizer (V : Set G))
    (hTU : T ≤ Subgroup.normalizer (U : Set G))
    (hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ B j, Commute a b)
    (hpair : ∀ i, (A i : Set G) * (B i : Set G) ⊆
      closure ((B i : Set G) * (T : Set G) * (A i : Set G))) :
    (Subgroup.closure ((⋃ i, (A i : Set G)) ∪ (V : Set G) ∪ (T : Set G)) : Set G) ⊆
      closure ((V : Set G) * (T : Set G) * (U : Set G)) := by
  intro g hg
  have hone : (1 : G) ∈ closure ((V : Set G) * (T : Set G) * (U : Set G)) :=
    subset_closure
      ⟨1, ⟨1, V.one_mem, 1, T.one_mem, by simp⟩, 1, U.one_mem, by simp⟩
  simpa using generated_mul_mem_closure_tripleProduct A B V T U hA hV hTV hTU
    hcomm hpair g hg 1 hone

/-- A dense generated family and the mixed rank-one closure relations make the
three-factor cell dense. There is no assumption of joint continuity. -/
theorem dense_tripleProduct
    {I : Type v} (A B : I → Subgroup G) (V T U : Subgroup G)
    (hA : ∀ i, A i ≤ U)
    (hV : V = Subgroup.closure (⋃ i, (B i : Set G)))
    (hTV : T ≤ Subgroup.normalizer (V : Set G))
    (hTU : T ≤ Subgroup.normalizer (U : Set G))
    (hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ B j, Commute a b)
    (hpair : ∀ i, (A i : Set G) * (B i : Set G) ⊆
      closure ((B i : Set G) * (T : Set G) * (A i : Set G)))
    (hgen : Dense (Subgroup.closure
      ((⋃ i, (A i : Set G)) ∪ (V : Set G) ∪ (T : Set G)) : Set G)) :
    Dense ((V : Set G) * (T : Set G) * (U : Set G)) := by
  intro x
  have h := closure_mono
    (generated_subset_closure_tripleProduct A B V T U hA hV hTV hTU hcomm hpair) (hgen x)
  simpa only [closure_closure] using h

end Langlands.GroupScheme.LeviGluing
