import Langlands.GroupScheme.Reductive.CorootTorusProjectionGeometry
import Langlands.GroupScheme.Reductive.LocalSplitPositiveLawGluing

/-! # The coroot quotient map on a split big cell -/

noncomputable section
universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.GroupScheme.LocalSplitCell

variable {R : Type u} [CommRing R] {I : Type u} [Fintype I] {J : Type u}
  {H : GroupScheme (Spec (CommRingCat.of R))}

/-- The zero homomorphism of group objects is the identity-valued map on schemes. -/
@[simp] theorem trivialRootMap_hom :
    (0 : Ga R ⟶ H).hom.hom = (1 : (Ga R).X ⟶ H.X) := rfl

/-- An ordered product of trivial root maps is the identity. -/
theorem orderedProduct_trivial {r : ℕ} (e : Fin r → J)
    (Z : Over (Spec (CommRingCat.of R))) (c : Fin r → Γ(Z.left, ⊤)) :
    orderedProduct (fun _ : J => (0 : Ga R ⟶ H)) e Z c = 1 := by
  simp only [orderedProduct, rootPoint, trivialRootMap_hom, MonObj.comp_one,
    List.ofFn_const, List.prod_replicate, one_pow]

/-- With trivial root maps, the cell map is its torus coordinate. -/
theorem cellMap_trivial (q : splitTorus (Spec (CommRingCat.of R)) I ⟶ H)
    {m n : ℕ} (neg : Fin m → J) (pos : Fin n → J) :
    cellMap q (fun _ : J => (0 : Ga R ⟶ H)) neg pos =
      (fst _ _ ≫ snd _ _) ≫ q.hom.hom := by
  simp only [cellMap, cellPoint, orderedProduct_trivial, one_mul, mul_one,
    torusCoord, Category.id_comp]

/-- Trivial root maps are equivariant for every exponent character family. -/
theorem torusEquivariant_trivial
    (q : splitTorus (Spec (CommRingCat.of R)) I ⟶ H) (ch : J → I → ℤ) :
    TorusEquivariant q ch (fun _ : J => (0 : Ga R ⟶ H)) := by
  intro α Z t c
  simp only [rootPoint, trivialRootMap_hom, MonObj.comp_one, mul_one, mul_inv_cancel]

omit [Fintype I] in
/-- Weyl conjugation preserves the trivial root map. -/
theorem wordConj_trivial (P : RootDatum J (I → ℤ) (I → ℤ)) (l : List J) :
    wordConj P (fun _ : J => (0 : Ga R ⟶ H)) l (0 : Ga R ⟶ H) = 0 := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [wordConj, ih, zero_comp]

omit [Fintype I] in
/-- The Weyl family generated by trivial root maps is trivial. -/
@[simp] theorem weylFamily_trivial (P : RootDatum J (I → ℤ) (I → ℤ))
    (b : P.Base) (W : ∀ α, SimpleWord P b α) (α : J) :
    weylFamily P W (fun _ : J => (0 : Ga R ⟶ H)) α = 0 :=
  wordConj_trivial P (W α).word

variable {G : GroupScheme (Spec (CommRingCat.of R))}
  {i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G}
  {i' : splitTorus (Spec (CommRingCat.of R)) I ⟶ H}
  {u : J → (Ga R ⟶ G)} {u' : J → (Ga R ⟶ H)}
  {m n : ℕ} {neg : Fin m → J} {pos : Fin n → J}

/-- Generator relations give cell compatibility with an arbitrary affine target.
Only the source cell is required to be an open immersion. -/
theorem cellCompatible_of_generatorRelations (hG : IsReductive G)
    [IsAffine H.X.left] [IsOpenImmersion (cellMap i u neg pos).left]
    (hT : TorusRelations (cellMap i u neg pos) (cellMap i' u' neg pos) i i')
    (hR : RootRelations (cellMap i u neg pos) (cellMap i' u' neg pos) u u') :
    CellGluing.CellCompatible (cellMap i u neg pos) (cellMap i' u' neg pos) := by
  apply CellGluing.cellCompatible_of_closedResidueLocalRingPoints
  intro A _ _ _ s x y c hxy
  have h := (rightGood_cellMap (hasCellFactors_cellMap hG) hT hR y)
    A s (𝟙 _) x c (by simpa only [Category.id_comp] using hxy)
  simpa only [Category.id_comp] using h

end Langlands.GroupScheme.LocalSplitCell

namespace Langlands.GroupScheme.RelativeDerived

open LocalSplitCell

variable (R : Type u) [CommRing R] (I : Type u) [Fintype I] [DecidableEq I]
  {J : Type u} (P : RootDatum J (I → ℤ) (I → ℤ))

/-- Projection of a split big cell to the torus quotient by the coroots. -/
def corootCellProjection (m n : ℕ) :
    cellObj R I m n ⟶ (corootQuotient (CommRingCat.of R) P).X :=
  (fst _ _ ≫ snd _ _) ≫ (corootProjection (CommRingCat.of R) P).hom.hom

/-- On every test scheme the cell map applies the coroot projection to the
torus coordinate. -/
theorem comp_corootCellProjection {m n : ℕ}
    {Z : Over (Spec (CommRingCat.of R))} (x : Z ⟶ cellObj R I m n) :
    x ≫ corootCellProjection R I P m n =
      torusCoord x ≫ (corootProjection (CommRingCat.of R) P).hom.hom := by
  simp only [corootCellProjection, torusCoord, Category.assoc]

/-- The quotient cell map is the cell formula with all target root maps trivial. -/
theorem corootCellProjection_eq_cellMap {m n : ℕ} (neg : Fin m → J) (pos : Fin n → J) :
    corootCellProjection R I P m n =
      cellMap (corootProjection (CommRingCat.of R) P)
        (fun _ : J => (0 : Ga R ⟶ (corootQuotient (CommRingCat.of R) P).toGrp))
        neg pos :=
  (cellMap_trivial _ neg pos).symm

/-- The identity cell point maps to the identity of the quotient torus. -/
theorem cellUnit_comp_corootCellProjection (m n : ℕ) :
    cellUnit R I m n ≫ corootCellProjection R I P m n = 1 := by
  rw [comp_corootCellProjection, torusCoord, cellUnit, lift_fst_assoc, lift_snd,
    MonObj.one_comp]

/-- The torus embeds as the cell points with zero root coordinates. -/
def torusCellSection (m n : ℕ) :
    (splitTorus (Spec (CommRingCat.of R)) I).X ⟶ cellObj R I m n :=
  lift (lift 1 (𝟙 _)) 1

/-- The cell quotient restricts to the original projection on the torus section. -/
theorem torusCellSection_comp_corootCellProjection (m n : ℕ) :
    torusCellSection R I m n ≫ corootCellProjection R I P m n =
      (corootProjection (CommRingCat.of R) P).hom.hom := by
  simp only [corootCellProjection, torusCellSection, lift_fst_assoc, lift_snd_assoc,
    Category.id_comp, Category.assoc]

section Geometry

variable [Finite J]

/-- The cell projection to the coroot quotient is smooth over every ring. -/
theorem smooth_corootCellProjection (m n : ℕ) :
    Smooth (corootCellProjection R I P m n).left := by
  have hV (d : ℕ) : Smooth (VectorGroup.groupScheme (CommRingCat.of R) d).X.hom :=
    Corepresented.smooth_groupScheme_iff.mpr inferInstance
  let : Smooth (VectorGroup.groupScheme (CommRingCat.of R) m).X.hom := hV m
  let : Smooth (VectorGroup.groupScheme (CommRingCat.of R) n).X.hom := hV n
  have hfst : Smooth (fst
      ((VectorGroup.groupScheme (CommRingCat.of R) m).X ⊗
        (splitTorus (Spec (CommRingCat.of R)) I).X)
      (VectorGroup.groupScheme (CommRingCat.of R) n).X).left := by
    change Smooth (pullback.fst _ _)
    infer_instance
  have hsnd : Smooth (snd (VectorGroup.groupScheme (CommRingCat.of R) m).X
      (splitTorus (Spec (CommRingCat.of R)) I).X).left := by
    change Smooth (pullback.snd _ _)
    infer_instance
  let : Smooth (corootProjection (CommRingCat.of R) P).hom.hom.left :=
    smooth_corootProjection (CommRingCat.of R) P
  change Smooth (((fst
      ((VectorGroup.groupScheme (CommRingCat.of R) m).X ⊗
        (splitTorus (Spec (CommRingCat.of R)) I).X)
      (VectorGroup.groupScheme (CommRingCat.of R) n).X).left ≫
    (snd (VectorGroup.groupScheme (CommRingCat.of R) m).X
      (splitTorus (Spec (CommRingCat.of R)) I).X).left) ≫
        (corootProjection (CommRingCat.of R) P).hom.hom.left)
  infer_instance

/-- The cell projection to the coroot quotient is surjective over every ring. -/
theorem surjective_corootCellProjection (m n : ℕ) :
    Surjective (corootCellProjection R I P m n).left := by
  have h : Surjective ((torusCellSection R I m n).left ≫
      (corootCellProjection R I P m n).left) := by
    change Surjective (torusCellSection R I m n ≫ corootCellProjection R I P m n).left
    rw [torusCellSection_comp_corootCellProjection]
    exact surjective_corootProjection (CommRingCat.of R) P
  exact Surjective.of_comp (torusCellSection R I m n).left
    (corootCellProjection R I P m n).left

end Geometry

section Translation

variable {G : GroupScheme (Spec (CommRingCat.of R))} [IsAffineHom G.X.hom]
  {i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G}
  {u : J → (Ga R ⟶ G)} {m n : ℕ}

omit [IsAffineHom G.X.hom] in
/-- Torus equivariance gives the torus translation law for the coroot cell map. -/
theorem torusRelations_corootCellProjection {neg : Fin m → J} {pos : Fin n → J}
    [Mono (cellMap i u neg pos)]
    (hu : TorusEquivariant i (fun α => P.root α) u) :
    TorusRelations (cellMap i u neg pos) (corootCellProjection R I P m n) i
      (corootProjection (CommRingCat.of R) P) := by
  rw [corootCellProjection_eq_cellMap R I P neg pos]
  exact torusRelations_of_equivariant hu
    (torusEquivariant_trivial _ (fun α => P.root α))

/-- Right translation by a positive root point preserves the coroot cell map,
on spectra of arbitrary local rings. -/
theorem corootCellProjection_mul_positiveRoot (hG : IsReductive G)
    (hmax : IsFibrewiseMaximalTorus (T := splitTorus.commGroupScheme _ I) i)
    (hP : IsFibrewiseRootDatumOf I G i P) (b : P.Base)
    (hu : ∀ α, IsRootParametrization i (P.root α) (u α))
    (neg : Fin m ≃ {α // ¬ b.IsPos α}) (pos : Fin n ≃ {α // b.IsPos α})
    {A : Type u} [CommRing A] [IsLocalRing A]
    (s : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of R))
    (x y : Over.mk s ⟶ cellObj R I m n) {α : J} (hα : b.IsPos α)
    (c : Γ((Over.mk s).left, ⊤))
    (hxy : (x ≫ cellMap i u (fun k => (neg k : J)) (fun k => (pos k : J))) *
      rootPoint (u α) (Over.mk s) c =
        y ≫ cellMap i u (fun k => (neg k : J)) (fun k => (pos k : J))) :
    x ≫ corootCellProjection R I P m n = y ≫ corootCellProjection R I P m n := by
  have := LocalSplitBigCell.isOpenImmersion_cellMap hG hmax hP b u hu neg pos
  have : Mono (cellMap i u (fun k => (neg k : J)) (fun k => (pos k : J))) :=
    Over.mono_of_mono_left _
  obtain ⟨z, hz⟩ := exists_comp_cellMap_mul_rootPoint_of_isPos
    hG hmax hP b hu neg pos s x hα c
  have hy : y = mkCellPoint (Over.mk s) (negCoord x)
      (splitTorus.pointsEquiv I _ (torusCoord x)) z :=
    (cancel_mono (cellMap i u (fun k => (neg k : J)) (fun k => (pos k : J)))).mp
      (hxy.symm.trans hz)
  have ht : torusCoord (mkCellPoint (Over.mk s) (negCoord x)
      (splitTorus.pointsEquiv I _ (torusCoord x)) z) = torusCoord x :=
    (splitTorus.pointsEquiv I _).injective
      (torusCoord_mkCellPoint _ _ _ _)
  rw [hy, comp_corootCellProjection, comp_corootCellProjection, ht]

end Translation

end Langlands.GroupScheme.RelativeDerived
