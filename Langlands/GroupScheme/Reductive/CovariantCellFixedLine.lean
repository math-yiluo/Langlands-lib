import Langlands.GroupScheme.HomogeneousCharacterCoordinates
import Langlands.GroupScheme.Reductive.CellExhaustion

/-! # Fixed covariant functions on a supplied dense product cell -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Opposite
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.AffineCoordinates

variable {k : Type u} [Field k]
  {G H U : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom]

local instance : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom

/-- The coordinate functions invariant under right multiplication through a
supplied group-scheme morphism, on every relative scheme test. -/
def rightInvariantSubspace (j : U ⟶ G) : Submodule k (algebra G) where
  carrier := {f | ∀ (T : Over (Spec (CommRingCat.of k))) (u : T ⟶ U.X)
    (g : T ⟶ G.X),
    pointAlgebraHom G T (g * (u ≫ j.hom.hom)) f = pointAlgebraHom G T g f}
  zero_mem' := by
    intro T u g
    simp only [map_zero]
  add_mem' := by
    intro f f' hf hf' T u g
    simp only [map_add, hf T u g, hf' T u g]
  smul_mem' := by
    intro a f hf T u g
    simp only [map_smul, hf T u g]

theorem mem_rightInvariantSubspace (j : U ⟶ G) (f : algebra G) :
    f ∈ rightInvariantSubspace j ↔
      ∀ (T : Over (Spec (CommRingCat.of k))) (u : T ⟶ U.X) (g : T ⟶ G.X),
        pointAlgebraHom G T (g * (u ≫ j.hom.hom)) f = pointAlgebraHom G T g f :=
  Iff.rfl

/-- Evaluation at an identity test point is scalar extension of the coordinate
counit. -/
theorem pointAlgebraHom_one_apply
    (T : Over (Spec (CommRingCat.of k))) (f : algebra G) :
    pointAlgebraHom G T 1 f =
      algebraMap k ((algΓ (CommRingCat.of k)).obj T).unop
        (AffineLinearEmbedding.counit (corepresentation G) f) := by
  rw [pointAlgebraHom_one]
  rfl

/-- Coordinates agreeing wherever a supplied nonzerodivisor is a unit are
equal. The hypothesis quantifies over all original relative scheme tests. -/
theorem eq_of_pointAlgebraHom_eq_on_unit_locus {q f f' : algebra G}
    (hq : q ∈ nonZeroDivisors (algebra G))
    (h : ∀ (T : Over (Spec (CommRingCat.of k))) (g : T ⟶ G.X),
      IsUnit (pointAlgebraHom G T g q) →
        pointAlgebraHom G T g f = pointAlgebraHom G T g f') :
    f = f' := by
  obtain ⟨m, hm⟩ := Chevalley.CellExhaustion.exists_pow_mul_eq_of_forall_isUnit
    (k := k) (Q := q) (E := f) (E' := f') (by
      intro R _ _ τ hτ
      let B : CommAlgCat (CommRingCat.of k) := CommAlgCat.of _ R
      let ε := ((algΓAlgSpecAdjunction (CommRingCat.of k)).counit.app (op B)).unop.hom
      apply counit_unop_injective B
      have hu : IsUnit (pointAlgebraHom G _ (algPoint G (CommAlgCat.ofHom τ)) q) := by
        rw [pointAlgebraHom_algPoint]
        exact hτ.map ε
      have he := h _ (algPoint G (CommAlgCat.ofHom τ)) hu
      have heval := pointAlgebraHom_algPoint G (CommAlgCat.ofHom τ)
      exact (AlgHom.congr_fun heval f).symm.trans
        (he.trans (AlgHom.congr_fun heval f')))
  exact ((isRegular_iff_mem_nonZeroDivisors.mpr hq).left.pow m) hm

variable [IsAffineHom H.X.hom]

local instance : IsAffine H.X.left := isAffine_of_isAffineHom H.X.hom

/-- On a supplied product cell, a right-invariant covariant function is its
identity value times the supplied normalized right-invariant covariant. -/
theorem eq_counit_smul_of_covariant_rightInvariant
    (i : H ⟶ G) (j : U ⟶ G) (χ : algebra H) {q d f : algebra G}
    (hq : q ∈ nonZeroDivisors (algebra G))
    (hcell : ∀ (T : Over (Spec (CommRingCat.of k))) (g : T ⟶ G.X),
      IsUnit (pointAlgebraHom G T g q) →
        ∃ (b : T ⟶ H.X) (u : T ⟶ U.X),
          g = (b ≫ i.hom.hom) * (u ≫ j.hom.hom))
    (hd : d ∈ leftCovariantSubspace i χ) (hdU : d ∈ rightInvariantSubspace j)
    (hd1 : AffineLinearEmbedding.counit (corepresentation G) d = 1)
    (hf : f ∈ leftCovariantSubspace i χ) (hfU : f ∈ rightInvariantSubspace j) :
    f = AffineLinearEmbedding.counit (corepresentation G) f • d := by
  apply eq_of_pointAlgebraHom_eq_on_unit_locus hq
  intro T g hg
  obtain ⟨b, u, rfl⟩ := hcell T g hg
  have hdf : pointAlgebraHom G T (b ≫ i.hom.hom) d =
      pointAlgebraHom H T b χ := by
    have he := pointAlgebraHom_leftCovariant i χ hd T b 1
    rw [mul_one, pointAlgebraHom_one_apply, hd1, map_one, mul_one] at he
    exact he
  have hff : pointAlgebraHom G T (b ≫ i.hom.hom) f =
      pointAlgebraHom H T b χ *
        algebraMap k ((algΓ (CommRingCat.of k)).obj T).unop
          (AffineLinearEmbedding.counit (corepresentation G) f) := by
    have he := pointAlgebraHom_leftCovariant i χ hf T b 1
    rwa [mul_one, pointAlgebraHom_one_apply] at he
  rw [hfU T u _, map_smul, hdU T u _, hdf, hff]
  exact mul_comm _ _

/-- The entire space of left covariants fixed by right translation on a
supplied dense product cell is the line generated by the normalized
covariant. No finite-dimensionality hypothesis is needed. -/
theorem leftCovariant_inf_rightInvariant_eq_span
    (i : H ⟶ G) (j : U ⟶ G) (χ : algebra H) {q d : algebra G}
    (hq : q ∈ nonZeroDivisors (algebra G))
    (hcell : ∀ (T : Over (Spec (CommRingCat.of k))) (g : T ⟶ G.X),
      IsUnit (pointAlgebraHom G T g q) →
        ∃ (b : T ⟶ H.X) (u : T ⟶ U.X),
          g = (b ≫ i.hom.hom) * (u ≫ j.hom.hom))
    (hd : d ∈ leftCovariantSubspace i χ) (hdU : d ∈ rightInvariantSubspace j)
    (hd1 : AffineLinearEmbedding.counit (corepresentation G) d = 1) :
    leftCovariantSubspace i χ ⊓ rightInvariantSubspace j =
      Submodule.span k {d} := by
  apply le_antisymm
  · intro f hf
    rw [eq_counit_smul_of_covariant_rightInvariant i j χ hq hcell hd hdU hd1 hf.1 hf.2]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton d))
  · apply Submodule.span_le.mpr
    intro f hf
    rcases Set.mem_singleton_iff.mp hf with rfl
    exact ⟨hd, hdU⟩

end Langlands.GroupScheme.AffineCoordinates
