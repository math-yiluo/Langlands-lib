import Langlands.GroupScheme.Reductive.AlmostSimple
import Langlands.GroupScheme.Reductive.CommutingMultiplication
import Langlands.GroupScheme.SimplyConnected.AlmostSimpleProductFactors

/-! # The decomposition theorem for semisimple groups over a field -/

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

/-- Conrad, *Reductive group schemes*, Theorem 5.1.19: the minimal nontrivial
smooth connected closed normal subgroups `G_i` of a connected semisimple group `G`
over a field form a finite family of almost-simple (`k`-simple), pairwise commuting
subgroups whose product multiplication `∏ G_i → G` is a central isogeny. For every
subset `J` of the index set, the closed subgroup `G_J` generated by the `G_i` with
`i ∈ J` is a semisimple smooth connected closed normal subgroup whose minimal
nontrivial smooth connected closed normal subgroups are exactly the `G_i` with
`i ∈ J`, and every smooth connected closed normal subgroup of `G` is `G_J` for a
unique `J`. Finally, every such subgroup `N` has a unique smooth connected closed
normal subgroup `N'` commuting with it for which `N × N' → G` is a central isogeny.
This module states the proposition and does not prove it. -/
def SimpleFactorDecompositionStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k))),
    IsSemisimple G →
    -- smooth connected closed normal subgroups of an ambient field group
    let IsNormalSubgroup : ∀ {H K : GroupScheme (Spec (CommRingCat.of k))},
        (K ⟶ H) → Prop := fun {_ K} n =>
      IsClosedSubgroup n ∧ Smooth K.X.hom ∧ ConnectedSpace K.X.left ∧
        (SubgroupFunctor.range n).IsNormal
    -- minimal nontrivial ones among them
    let IsMinimalNormalSubgroup : ∀ {H K : GroupScheme (Spec (CommRingCat.of k))},
        (K ⟶ H) → Prop := fun {H _} n =>
      IsNormalSubgroup n ∧ SubgroupFunctor.range n ≠ ⊥ ∧
        ∀ (K' : GroupScheme (Spec (CommRingCat.of k))) (n' : K' ⟶ H),
          IsNormalSubgroup n' → SubgroupFunctor.range n' ≠ ⊥ →
          SubgroupFunctor.range n' ≤ SubgroupFunctor.range n →
          SubgroupFunctor.range n' = SubgroupFunctor.range n
    ∃ (I : Type u) (_ : Finite I) (A : I → GroupScheme (Spec (CommRingCat.of k)))
      (a : ∀ i, A i ⟶ G),
      -- the `G_i` are exactly the minimal ones, listed without repetition
      (∀ i, IsMinimalNormalSubgroup (a i)) ∧
      Function.Injective (fun i => SubgroupFunctor.range (a i)) ∧
      (∀ (K : GroupScheme (Spec (CommRingCat.of k))) (n : K ⟶ G),
        IsMinimalNormalSubgroup n → ∃ i, SubgroupFunctor.range n = SubgroupFunctor.range (a i)) ∧
      -- each `G_i` is `k`-simple
      (∀ i, IsAlmostSimple (A i)) ∧
      -- the `G_i` pairwise commute
      (∀ i j, i ≠ j → ∀ (T : Over (Spec (CommRingCat.of k))) (x : T ⟶ (A i).X)
        (y : T ⟶ (A j).X), Commute (x ≫ (a i).hom.hom) (y ≫ (a j).hom.hom)) ∧
      -- the multiplication homomorphism `∏ G_i → G` is a central isogeny
      (∃ p : pi A ⟶ G, (∀ i, piFactorInclusionHom A i ≫ p = a i) ∧ IsCentralIsogeny p) ∧
      -- the subgroups `G_J`
      ∃ (B : Set I → GroupScheme (Spec (CommRingCat.of k))) (b : ∀ J, B J ⟶ G),
        (∀ J, IsNormalSubgroup (b J) ∧ IsSemisimple (B J)) ∧
        -- `G_J` is the smallest closed subgroup containing the `G_i` with `i ∈ J`
        (∀ J, ∀ i ∈ J, SubgroupFunctor.range (a i) ≤ SubgroupFunctor.range (b J)) ∧
        (∀ J (K : GroupScheme (Spec (CommRingCat.of k))) (n : K ⟶ G), IsClosedSubgroup n →
          (∀ i ∈ J, SubgroupFunctor.range (a i) ≤ SubgroupFunctor.range n) →
          SubgroupFunctor.range (b J) ≤ SubgroupFunctor.range n) ∧
        -- the minimal ones in `G_J` are exactly the `G_i` with `i ∈ J`
        (∀ J, ∀ i ∈ J, ∃ c : A i ⟶ B J, c ≫ b J = a i ∧ IsMinimalNormalSubgroup c) ∧
        (∀ J (K : GroupScheme (Spec (CommRingCat.of k))) (n : K ⟶ B J),
          IsMinimalNormalSubgroup n →
            ∃ i ∈ J, SubgroupFunctor.range (n ≫ b J) = SubgroupFunctor.range (a i)) ∧
        -- every smooth connected closed normal subgroup is a unique `G_J`
        (∀ (K : GroupScheme (Spec (CommRingCat.of k))) (n : K ⟶ G), IsNormalSubgroup n →
          ∃! J : Set I, SubgroupFunctor.range n = SubgroupFunctor.range (b J)) ∧
        -- the unique commuting complement with central-isogeny multiplication
        ∀ (K : GroupScheme (Spec (CommRingCat.of k))) (n : K ⟶ G), IsNormalSubgroup n →
          ∃ (K' : GroupScheme (Spec (CommRingCat.of k))) (n' : K' ⟶ G),
            IsNormalSubgroup n' ∧
            (∃ hc : ∀ (T : Over (Spec (CommRingCat.of k))) (x : T ⟶ K.X) (y : T ⟶ K'.X),
              Commute (x ≫ n.hom.hom) (y ≫ n'.hom.hom),
              IsCentralIsogeny (commutingSubgroupMultiplicationHom n n' hc)) ∧
            ∀ (K'' : GroupScheme (Spec (CommRingCat.of k))) (n'' : K'' ⟶ G),
              IsNormalSubgroup n'' →
              ∀ hc : ∀ (T : Over (Spec (CommRingCat.of k))) (x : T ⟶ K.X) (y : T ⟶ K''.X),
                Commute (x ≫ n.hom.hom) (y ≫ n''.hom.hom),
              IsCentralIsogeny (commutingSubgroupMultiplicationHom n n'' hc) →
              SubgroupFunctor.range n'' = SubgroupFunctor.range n'

end Langlands.GroupScheme
