import Langlands.GroupScheme.GeneratedFamily
import Langlands.GroupScheme.Absolute.RationalPointClosureProof
import Langlands.AlgebraicGeometry.SmoothReducedProof
import Mathlib.AlgebraicGeometry.AlgClosed.Basic
import Mathlib.AlgebraicGeometry.PullbackCarrier

/-! # Rational points of a generated group have dense locations -/

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Topology
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.LeviGluing

variable {k : Type u} [Field k] (H : GroupScheme (Spec (CommRingCat.of k)))

local notation "HPoints" => (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ H.X)

/-- A smooth closed subgroup of `H` whose underlying set is the Zariski closure
of the locations of a group `Γ` of rational points. -/
structure RationalClosureEnvelope (Γ : Subgroup HPoints) where
  group : GroupScheme (Spec (CommRingCat.of k))
  inclusion : group ⟶ H
  closed : IsClosedSubgroup inclusion
  smooth : Smooth group.X.hom
  range_eq : Set.range inclusion.hom.hom.left = closure (rationalPointImage H (Γ : Set HPoints))

/-- The closure envelope supplied by the published `rationalPointClosureSubgroup`. -/
def rationalClosureEnvelope [IsAlgClosed k] [IsAffineHom H.X.hom]
    [LocallyOfFiniteType H.X.hom] (Γ : Subgroup HPoints) : RationalClosureEnvelope H Γ :=
  Classical.choice <| by
    obtain ⟨Z, ζ, hζ, hs, hr⟩ := rationalPointClosureSubgroup k H Γ
    exact ⟨⟨Z, ζ, hζ, hs, hr⟩⟩

variable {H}

/-- A morphism from a reduced scheme whose image lies in the image of a closed
subgroup factors through that subgroup, as an actual morphism over `k`. -/
theorem factorsThrough_of_range_subset {K : GroupScheme (Spec (CommRingCat.of k))}
    {j : K ⟶ H} (hj : IsClosedSubgroup j) {P : Over (Spec (CommRingCat.of k))}
    [IsReduced P.left] (g : P ⟶ H.X)
    (hg : Set.range g.left ⊆ Set.range j.hom.hom.left) : FactorsThrough g j := by
  let f := g.left
  let c := j.hom.hom.left
  let p := pullback.fst f c
  have : IsClosedImmersion c := hj
  have hprange : Set.range p = Set.univ := by
    rw [Scheme.Pullback.range_fst]
    exact Set.eq_univ_of_forall fun x => hg ⟨x, rfl⟩
  have : Surjective p := ⟨Set.range_eq_univ.mp hprange⟩
  have : IsIso p := isIso_of_isClosedImmersion_of_surjective p
  let a := inv p ≫ pullback.snd f c
  have ha : a ≫ c = f := by
    dsimp [a]
    rw [Category.assoc, ← pullback.condition, ← Category.assoc, IsIso.inv_hom_id,
      Category.id_comp]
  refine ⟨Over.homMk a ?_, ?_⟩
  · rw [← Over.w j.hom.hom, ← Category.assoc, ha]
    exact Over.w g
  · apply Over.OverMorphism.ext
    exact ha

/-- Over an algebraically closed field, a morphism from a scheme locally of finite
type maps into the closure of the locations of any set of rational points that
contains the images of all its rational points. -/
theorem range_subset_closure_rationalPointImage [IsAlgClosed k]
    {P : Over (Spec (CommRingCat.of k))} [LocallyOfFiniteType P.hom] (f : P ⟶ H.X)
    (S : Set HPoints) (hS : ∀ y : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ P, y ≫ f ∈ S) :
    Set.range f.left ⊆ closure (rationalPointImage H S) := by
  have : JacobsonSpace P.left := LocallyOfFiniteType.jacobsonSpace P.hom
  have hpts : f.left '' closedPoints P.left ⊆ rationalPointImage H S := by
    rintro _ ⟨x, hx, rfl⟩
    let y : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ P :=
      Over.homMk (pointOfClosedPoint P.hom x hx) (pointOfClosedPoint_comp P.hom x hx)
    refine ⟨y ≫ f, hS y, ?_⟩
    change f.left (pointOfClosedPoint P.hom x hx (IsLocalRing.closedPoint k)) = f.left x
    exact congrArg f.left (pointOfClosedPoint_apply P.hom x hx (IsLocalRing.closedPoint k))
  rintro _ ⟨x, rfl⟩
  have hx : x ∈ closure (closedPoints P.left) := by
    rw [closure_closedPoints]
    trivial
  exact closure_mono hpts (image_closure_subset_closure_image f.left.continuous ⟨x, hx, rfl⟩)

variable (H) {I : Type v} (A : I → GroupScheme (Spec (CommRingCat.of k))) (a : ∀ j, A j ⟶ H)

/-- The group of rational points of `H` generated by the rational points of the
ranges of the family `a`. -/
def generatedRationalPoints : Subgroup HPoints :=
  Subgroup.closure
    (⋃ j, ((SubgroupFunctor.range (a j)).carrier (Over.mk (𝟙 (Spec (CommRingCat.of k)))) :
      Set HPoints))

variable {H A a}

/-- Every member of the family factors through the closure envelope of the
generated rational points, on every test scheme. -/
theorem factorsThrough_rationalClosureEnvelope [IsAlgClosed k] [IsAffineHom H.X.hom]
    [LocallyOfFiniteType H.X.hom]
    (hA : ∀ j, IsReduced (A j).X.left ∧ LocallyOfFiniteType (A j).X.hom) (j : I) :
    FactorsThrough (a j).hom.hom
      (rationalClosureEnvelope H (generatedRationalPoints H A a)).inclusion := by
  obtain ⟨_, _⟩ := hA j
  let E := rationalClosureEnvelope H (generatedRationalPoints H A a)
  apply factorsThrough_of_range_subset E.closed
  rw [E.range_eq]
  apply range_subset_closure_rationalPointImage
  intro y
  apply Subgroup.subset_closure
  exact Set.mem_iUnion.mpr ⟨j, SubgroupFunctor.mem_range.mpr ⟨y, rfl⟩⟩

/-- If the family generates `H`, the closure envelope of the generated rational
points is surjective. -/
theorem range_rationalClosureEnvelope_eq_univ [IsAlgClosed k] [IsAffineHom H.X.hom]
    [LocallyOfFiniteType H.X.hom]
    (hA : ∀ j, IsReduced (A j).X.left ∧ LocallyOfFiniteType (A j).X.hom)
    (hgen : IsGeneratedByFamily A a (𝟙 H)) :
    Set.range (rationalClosureEnvelope H (generatedRationalPoints H A a)).inclusion.hom.hom.left =
      Set.univ := by
  let E := rationalClosureEnvelope H (generatedRationalPoints H A a)
  have hle := hgen.2.2 E.group E.inclusion E.closed
    (factorsThrough_rationalClosureEnvelope hA)
  obtain ⟨g, hg⟩ := hle H.X (SubgroupFunctor.mem_range.mpr ⟨𝟙 _, Category.id_comp _⟩)
  change g ≫ E.inclusion.hom.hom = 𝟙 _ ≫ (𝟙 H : H ⟶ H).hom.hom at hg
  refine Set.eq_univ_of_forall fun x => ⟨g.left x, ?_⟩
  have h := congrArg (fun q : H.X ⟶ H.X => q.left x) hg
  exact h

/-- Over an algebraically closed field, if a family of reduced sources locally of
finite type generates `H` (an affine group scheme locally of finite type), then
the locations of the rational points generated by the family are dense. -/
theorem dense_rationalPointImage_generatedRationalPoints [IsAlgClosed k]
    [IsAffineHom H.X.hom] [LocallyOfFiniteType H.X.hom]
    (hA : ∀ j, IsReduced (A j).X.left ∧ LocallyOfFiniteType (A j).X.hom)
    (hgen : IsGeneratedByFamily A a (𝟙 H)) :
    Dense (rationalPointImage H (generatedRationalPoints H A a : Set HPoints)) := by
  rw [dense_iff_closure_eq, ← (rationalClosureEnvelope H _).range_eq]
  exact range_rationalClosureEnvelope_eq_univ hA hgen

/-- The specialization to smooth affine connected sources and a smooth affine
group `H`, in the expanded form of the generated rational points. -/
theorem dense_rationalPointImage_closure_of_isGeneratedByFamily [IsAlgClosed k]
    [Smooth H.X.hom] [IsAffineHom H.X.hom]
    (hA : ∀ j, Smooth (A j).X.hom ∧ IsAffineHom (A j).X.hom ∧ ConnectedSpace (A j).X.left)
    (hgen : IsGeneratedByFamily A a (𝟙 H)) :
    Dense (rationalPointImage H (Subgroup.closure
      (⋃ j, ((SubgroupFunctor.range (a j)).carrier (Over.mk (𝟙 (Spec (CommRingCat.of k)))) :
        Set HPoints)) : Set HPoints)) := by
  refine dense_rationalPointImage_generatedRationalPoints (fun j => ?_) hgen
  let : Smooth (A j).X.hom := (hA j).1
  exact ⟨Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field
    k _ (A j).X.hom, inferInstance⟩

end Langlands.GroupScheme.LeviGluing
