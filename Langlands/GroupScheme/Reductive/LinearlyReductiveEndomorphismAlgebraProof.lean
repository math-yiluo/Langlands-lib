/-! ## Regular elements of semisimple rings -/

/-- In a semisimple ring every element `x` has some `y` with `x * y * x = x`. -/
theorem exists_mul_mul_eq_self {R : Type*} [Ring R] [IsSemisimpleRing R] (x : R) :
    ∃ y : R, x * y * x = x := by
  obtain ⟨L, hL⟩ := exists_isCompl (Submodule.span R {x})
  have h1 : (1 : R) ∈ Submodule.span R {x} ⊔ L := by
    rw [hL.sup_eq_top]
    exact Submodule.mem_top
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
  obtain ⟨y, rfl⟩ := Submodule.mem_span_singleton.mp ha
  refine ⟨y, ?_⟩
  have hxb : x * b = x - x * y * x := by
    have h := congrArg (x * ·) hab
    simp only [smul_eq_mul, mul_add, mul_one] at h
    rw [mul_assoc, eq_sub_iff_add_eq, add_comm]
    exact h
  have hL' : x * b ∈ L := by
    simpa only [smul_eq_mul] using L.smul_mem x hb
  have hS : x * b ∈ Submodule.span R {x} := by
    rw [hxb]
    refine sub_mem (Submodule.mem_span_singleton_self x) ?_
    simpa only [smul_eq_mul] using
      (Submodule.span R {x}).smul_mem (x * y) (Submodule.mem_span_singleton_self x)
  have h0 : x * b = 0 := (Submodule.disjoint_def.mp hL.disjoint) _ hS hL'
  rw [hxb] at h0
  exact (sub_eq_zero.mp h0).symm

end LinearlyReductiveEndomorphismAlgebraProof

namespace MatrixRepresentation.LinearlyReductiveEndomorphismAlgebraProof

/-! ## The endomorphism algebra -/

section Intertwiners

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

theorem intertwines_one (ρ : MatrixRepresentation G n) :
    Intertwines ρ ρ (1 : Matrix n n k) := by
  intro S x
  rw [Matrix.map_one _ (map_zero _) (map_one _), Matrix.one_mul, Matrix.mul_one]

theorem Intertwines.add {ρ : MatrixRepresentation G n} {σ : MatrixRepresentation G m}
    {C D : Matrix m n k} (hC : Intertwines ρ σ C) (hD : Intertwines ρ σ D) :
    Intertwines ρ σ (C + D) := by
  intro S x
  rw [Matrix.map_add _ (map_add _), Matrix.add_mul, Matrix.mul_add, hC S x, hD S x]

theorem Intertwines.smul {ρ : MatrixRepresentation G n} {σ : MatrixRepresentation G m}
    {C : Matrix m n k} (hC : Intertwines ρ σ C) (c : k) :
    Intertwines ρ σ (c • C) := by
  intro S x
  have h : (c • C).map (algebraMap k S) = algebraMap k S c • C.map (algebraMap k S) := by
    ext i j
    simp only [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_mul]
  rw [h, Matrix.smul_mul, Matrix.mul_smul, hC S x]

/-- The intertwining matrices of a representation form a subalgebra. -/
def endSubalgebra (ρ : MatrixRepresentation G n) : Subalgebra k (Matrix n n k) where
  carrier := {C | Intertwines ρ ρ C}
  mul_mem' {a b} ha hb := (show Intertwines ρ ρ b from hb).comp (show Intertwines ρ ρ a from ha)
  add_mem' ha hb := Intertwines.add ha hb
  algebraMap_mem' c := by
    change Intertwines ρ ρ (algebraMap k (Matrix n n k) c)
    rw [Algebra.algebraMap_eq_smul_one]
    exact Intertwines.smul (intertwines_one ρ) c

theorem mem_endSubalgebra {ρ : MatrixRepresentation G n} {C : Matrix n n k} :
    C ∈ endSubalgebra ρ ↔ Intertwines ρ ρ C := Iff.rfl

/-- The subalgebra generated by the intertwiners is the set of intertwiners. -/
theorem adjoin_intertwines_eq (ρ : MatrixRepresentation G n) :
    Algebra.adjoin k {C : Matrix n n k | Intertwines ρ ρ C} = endSubalgebra ρ :=
  Algebra.adjoin_eq (endSubalgebra ρ)

end Intertwiners

/-! ## Binary direct sums -/

section BinarySumConstruction

variable {R : CommRingCat.{u}} {G : GroupScheme (Spec R)}
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]
  (ρ : MatrixRepresentation G n) (σ : MatrixRepresentation G m)

/-- The block diagonal point matrices of two representations. -/
def binarySumMatrixHom (T : Over (Spec R)) :
    (T ⟶ G.X) →* Matrix (n ⊕ m) (n ⊕ m) Γ(T.left, ⊤) where
  toFun x := Matrix.fromBlocks (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) 0 0
    (σ.pointMatrix T x : Matrix m m Γ(T.left, ⊤))
  map_one' := by
    simp only [map_one, Matrix.GeneralLinearGroup.coe_one]
    exact Matrix.fromBlocks_one
  map_mul' x y := by
    simp only [map_mul, Matrix.GeneralLinearGroup.coe_mul, Matrix.fromBlocks_multiply,
      Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]

theorem binarySumMatrixHom_naturality {T T' : Over (Spec R)} (a : T' ⟶ T)
    (x : T ⟶ G.X) :
    binarySumMatrixHom ρ σ T' (a ≫ x) =
      (binarySumMatrixHom ρ σ T x).map a.left.appTop.hom := by
  change Matrix.fromBlocks (ρ.pointMatrix T' (a ≫ x) : Matrix n n Γ(T'.left, ⊤)) 0 0
      (σ.pointMatrix T' (a ≫ x) : Matrix m m Γ(T'.left, ⊤)) =
    (Matrix.fromBlocks (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) 0 0
      (σ.pointMatrix T x : Matrix m m Γ(T.left, ⊤))).map a.left.appTop.hom
  rw [Matrix.fromBlocks_map, Matrix.map_zero _ (map_zero _), Matrix.map_zero _ (map_zero _),
    pointMatrix_naturality, pointMatrix_naturality]
  rfl

/-- The general-linear point family of the binary direct sum. -/
def binarySumPoints (T : Over (Spec R)) :
    (T ⟶ G.X) →* (T ⟶ (GeneralLinear.groupScheme (n ⊕ m) R).X) :=
  (GeneralLinear.pointsEquiv (n ⊕ m) R T).symm.toMonoidHom.comp
    (binarySumMatrixHom ρ σ T).toHomUnits

theorem binarySumPoints_naturality {T T' : Over (Spec R)} (a : T' ⟶ T)
    (x : T ⟶ G.X) :
    binarySumPoints ρ σ T' (a ≫ x) = a ≫ binarySumPoints ρ σ T x := by
  apply (GeneralLinear.pointsEquiv (n ⊕ m) R T').injective
  rw [GeneralLinear.pointsEquiv_naturality]
  simp only [binarySumPoints, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.apply_symm_apply]
  change (binarySumMatrixHom ρ σ T').toHomUnits (a ≫ x) =
    Matrix.GeneralLinearGroup.map a.left.appTop.hom
      ((binarySumMatrixHom ρ σ T).toHomUnits x)
  apply Units.ext
  exact binarySumMatrixHom_naturality ρ σ a x

/-- The direct sum of two representations, on the disjoint union of the coordinates. -/
def binarySum : MatrixRepresentation G (n ⊕ m) :=
  homOfPoints (binarySumPoints ρ σ) (binarySumPoints_naturality ρ σ)

theorem binarySum_pointMatrix_val (T : Over (Spec R)) (x : T ⟶ G.X) :
    ((binarySum ρ σ).pointMatrix T x : Matrix (n ⊕ m) (n ⊕ m) Γ(T.left, ⊤)) =
      Matrix.fromBlocks (ρ.pointMatrix T x : Matrix n n Γ(T.left, ⊤)) 0 0
        (σ.pointMatrix T x : Matrix m m Γ(T.left, ⊤)) := by
  have h : (binarySum ρ σ).pointMatrix T x = (binarySumMatrixHom ρ σ T).toHomUnits x := by
    rw [pointMatrix_apply, binarySum, comp_homOfPoints]
    exact (GeneralLinear.pointsEquiv (n ⊕ m) R T).apply_symm_apply _
  rw [h]
  rfl

end BinarySumConstruction

section BinarySumField

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

/-- The affine section comparison, as a function on global sections. -/
def sectionsFun (A : CommAlgCat.{u} (CommRingCat.of k)) :
    Γ(((algSpec (CommRingCat.of k)).obj (op A)).left, ⊤) → A :=
  fun s => Corepresented.affineSectionsAlgEquiv A s

theorem sectionsFun_zero (A : CommAlgCat.{u} (CommRingCat.of k)) :
    sectionsFun A 0 = 0 :=
  map_zero (Corepresented.affineSectionsAlgEquiv A)

/-- Affine matrices are the point matrices read through the affine section isomorphism. -/
theorem affineMatrix_eq_map_pointMatrix (τ : MatrixRepresentation G n)
    (A : CommAlgCat.{u} (CommRingCat.of k))
    (x : (algSpec (CommRingCat.of k)).obj (op A) ⟶ G.X) :
    (τ.affineMatrix A x : Matrix n n A) =
      (τ.pointMatrix ((algSpec (CommRingCat.of k)).obj (op A)) x :
        Matrix n n Γ(((algSpec (CommRingCat.of k)).obj (op A)).left, ⊤)).map
          (sectionsFun A) := by
  rw [pointMatrix_eq_affineMatrix]
  ext i j
  exact ((Corepresented.affineSectionsAlgEquiv A).apply_symm_apply _).symm

variable (ρ : MatrixRepresentation G n) (σ : MatrixRepresentation G m)

theorem binarySum_affineMatrix (A : CommAlgCat.{u} (CommRingCat.of k))
    (x : (algSpec (CommRingCat.of k)).obj (op A) ⟶ G.X) :
    ((binarySum ρ σ).affineMatrix A x : Matrix (n ⊕ m) (n ⊕ m) A) =
      Matrix.fromBlocks (ρ.affineMatrix A x : Matrix n n A) 0 0
        (σ.affineMatrix A x : Matrix m m A) := by
  rw [affineMatrix_eq_map_pointMatrix (binarySum ρ σ), binarySum_pointMatrix_val,
    Matrix.fromBlocks_map, ← affineMatrix_eq_map_pointMatrix ρ,
    ← affineMatrix_eq_map_pointMatrix σ, Matrix.map_zero _ (sectionsFun_zero A),
    Matrix.map_zero _ (sectionsFun_zero A)]

theorem intertwines_binarySum_inl :
    Intertwines ρ (binarySum ρ σ) (Matrix.fromRows (1 : Matrix n n k) 0) := by
  intro A x
  rw [binarySum_affineMatrix, Matrix.fromRows_map, Matrix.map_one _ (map_zero _) (map_one _),
    Matrix.map_zero _ (map_zero _), Matrix.fromRows_mul, Matrix.fromBlocks_mul_fromRows]
  simp only [Matrix.one_mul, Matrix.zero_mul, Matrix.mul_one, Matrix.mul_zero, add_zero]

theorem intertwines_binarySum_inr :
    Intertwines σ (binarySum ρ σ) (Matrix.fromRows (0 : Matrix n m k) 1) := by
  intro A x
  rw [binarySum_affineMatrix, Matrix.fromRows_map, Matrix.map_one _ (map_zero _) (map_one _),
    Matrix.map_zero _ (map_zero _), Matrix.fromRows_mul, Matrix.fromBlocks_mul_fromRows]
  simp only [Matrix.one_mul, Matrix.zero_mul, Matrix.mul_one, Matrix.mul_zero, add_zero,
    zero_add]

theorem intertwines_binarySum_fst :
    Intertwines (binarySum ρ σ) ρ (Matrix.fromCols (1 : Matrix n n k) 0) := by
  intro A x
  rw [binarySum_affineMatrix, Matrix.fromCols_map, Matrix.map_one _ (map_zero _) (map_one _),
    Matrix.map_zero _ (map_zero _), Matrix.mul_fromCols, Matrix.fromCols_mul_fromBlocks]
  simp only [Matrix.one_mul, Matrix.zero_mul, Matrix.mul_one, Matrix.mul_zero, add_zero]

theorem intertwines_binarySum_snd :
    Intertwines (binarySum ρ σ) σ (Matrix.fromCols (0 : Matrix m n k) 1) := by
  intro A x
  rw [binarySum_affineMatrix, Matrix.fromCols_map, Matrix.map_one _ (map_zero _) (map_one _),
    Matrix.map_zero _ (map_zero _), Matrix.mul_fromCols, Matrix.fromCols_mul_fromBlocks]
  simp only [Matrix.one_mul, Matrix.zero_mul, Matrix.mul_one, Matrix.mul_zero, add_zero,
    zero_add]

/-- Every representation on a finite coordinate type is isomorphic, through
intertwiners, to one on standard coordinates `Fin N`. -/
theorem exists_fin_intertwined [IsAffineHom G.X.hom] {o : Type} [Fintype o] [DecidableEq o]
    (τ₀ : MatrixRepresentation G o) :
    ∃ (N : ℕ) (τ : MatrixRepresentation G (Fin N)) (B : Matrix o (Fin N) k)
      (C : Matrix (Fin N) o k),
      Intertwines τ τ₀ B ∧ Intertwines τ₀ τ C ∧ B * C = 1 := by
  obtain ⟨d, B, C, hCB, hcols, hproj⟩ :=
    exists_subspace_split_coordinates (⊤ : Submodule k (o → k))
  have hV : IsStableSubspace τ₀ ⊤ := fun _ _ _ _ _ => Submodule.mem_top
  have hstable := hV.isStableCoordinates B C hcols hproj
  have hB := intertwines_restrictCoordinates τ₀ B C hCB hstable
  have hBC : B * C = 1 := by
    apply Matrix.ext_of_mulVec_single
    intro j
    rw [Matrix.one_mulVec]
    exact hproj _ Submodule.mem_top
  refine ⟨d, restrictCoordinates τ₀ B C hCB hstable, B, C, hB, ?_, hBC⟩
  apply hB.of_comp_injective (coordinateInclusion_injective (R := CommRingCat.of k) B C hCB)
  rw [hBC]
  exact intertwines_one τ₀

/-- Two representations on standard coordinates have a direct sum on standard
coordinates, with intertwining inclusions and retractions. -/
theorem exists_binarySum_fin [IsAffineHom G.X.hom] {a b : ℕ}
    (ρ : MatrixRepresentation G (Fin a)) (σ : MatrixRepresentation G (Fin b)) :
    ∃ (N : ℕ) (τ : MatrixRepresentation G (Fin N)) (i₁ : Matrix (Fin N) (Fin a) k)
      (i₂ : Matrix (Fin N) (Fin b) k) (p₁ : Matrix (Fin a) (Fin N) k)
      (p₂ : Matrix (Fin b) (Fin N) k),
      Intertwines ρ τ i₁ ∧ Intertwines σ τ i₂ ∧ Intertwines τ ρ p₁ ∧
        Intertwines τ σ p₂ ∧ p₁ * i₁ = 1 ∧ p₂ * i₂ = 1 := by
  obtain ⟨N, τ, B, C, hB, hC, hBC⟩ := exists_fin_intertwined (binarySum ρ σ)
  refine ⟨N, τ, C * Matrix.fromRows (1 : Matrix (Fin a) (Fin a) k) 0,
    C * Matrix.fromRows (0 : Matrix (Fin a) (Fin b) k) 1,
    Matrix.fromCols (1 : Matrix (Fin a) (Fin a) k) 0 * B,
    Matrix.fromCols (0 : Matrix (Fin b) (Fin a) k) 1 * B,
    (intertwines_binarySum_inl ρ σ).comp hC, (intertwines_binarySum_inr ρ σ).comp hC,
    hB.comp (intertwines_binarySum_fst ρ σ), hB.comp (intertwines_binarySum_snd ρ σ), ?_, ?_⟩
  · calc Matrix.fromCols (1 : Matrix (Fin a) (Fin a) k) 0 * B *
          (C * Matrix.fromRows (1 : Matrix (Fin a) (Fin a) k) 0) =
          Matrix.fromCols (1 : Matrix (Fin a) (Fin a) k) 0 * (B * C) *
            Matrix.fromRows (1 : Matrix (Fin a) (Fin a) k) 0 := by
          simp only [Matrix.mul_assoc]
      _ = 1 := by
          rw [hBC, Matrix.mul_one, Matrix.fromCols_mul_fromRows]
          simp only [Matrix.one_mul, Matrix.zero_mul, add_zero]
  · calc Matrix.fromCols (0 : Matrix (Fin b) (Fin a) k) 1 * B *
          (C * Matrix.fromRows (0 : Matrix (Fin a) (Fin b) k) 1) =
          Matrix.fromCols (0 : Matrix (Fin b) (Fin a) k) 1 * (B * C) *
            Matrix.fromRows (0 : Matrix (Fin a) (Fin b) k) 1 := by
          simp only [Matrix.mul_assoc]
      _ = 1 := by
          rw [hBC, Matrix.mul_one, Matrix.fromCols_mul_fromRows]
          simp only [Matrix.one_mul, Matrix.zero_mul, zero_add]

end BinarySumField

/-! ## Coefficient operators and the coefficient subalgebra -/

section CoefficientModule

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}
  {n m : Type} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

variable (G) in
/-- A test algebra, a point of `G` with values in it, and a `k`-linear functional on it. -/
def CoefficientIndex : Type (u + 1) :=
  Σ A : CommAlgCat.{u} (CommRingCat.of k),
    ((algSpec (CommRingCat.of k)).obj (op A) ⟶ G.X) × (A →ₗ[k] k)

/-- The coefficient operator `v ↦ ℓ(ρ(x) v)` of a test datum `(A, x, ℓ)`. -/
def coefficientOperator (ρ : MatrixRepresentation G n) (ξ : CoefficientIndex G) :
    Module.End k (n → k) where
  toFun v i := ξ.2.2 (((ρ.affineMatrix ξ.1 ξ.2.1 : Matrix n n ξ.1) *ᵥ
    (fun j => algebraMap k ξ.1 (v j))) i)
  map_add' v w := by
    funext i
    have hv : (fun j => algebraMap k ξ.1 ((v + w) j)) =
        (fun j => algebraMap k ξ.1 (v j)) + fun j => algebraMap k ξ.1 (w j) :=
      funext fun j => map_add _ _ _
    rw [hv, Matrix.mulVec_add, Pi.add_apply, map_add]
    rfl
  map_smul' c v := by
    funext i
    have hv : (fun j => algebraMap k ξ.1 ((c • v) j)) =
        algebraMap k ξ.1 c • fun j => algebraMap k ξ.1 (v j) := by
      funext j
      simp only [Pi.smul_apply, smul_eq_mul, map_mul]
    rw [hv, Matrix.mulVec_smul, Pi.smul_apply, smul_eq_mul, ← Algebra.smul_def,
      map_smul]
    rfl

theorem coefficientOperator_apply (ρ : MatrixRepresentation G n) (ξ : CoefficientIndex G)
    (v : n → k) :
    coefficientOperator ρ ξ v = fun i => ξ.2.2 (((ρ.affineMatrix ξ.1 ξ.2.1 : Matrix n n ξ.1) *ᵥ
      (fun j => algebraMap k ξ.1 (v j))) i) := rfl

theorem isStableSubspace_iff (ρ : MatrixRepresentation G n) (W : Submodule k (n → k)) :
    IsStableSubspace ρ W ↔ ∀ ξ v, v ∈ W → coefficientOperator ρ ξ v ∈ W :=
  ⟨fun h ξ v hv => h ξ.1 ξ.2.1 v hv ξ.2.2, fun h A x v hv ℓ => h ⟨A, x, ℓ⟩ v hv⟩

theorem Intertwines.mulVec_coefficientOperator {ρ : MatrixRepresentation G n}
    {σ : MatrixRepresentation G m} {C : Matrix m n k} (hC : Intertwines ρ σ C)
    (ξ : CoefficientIndex G) (v : n → k) :
    C *ᵥ coefficientOperator ρ ξ v = coefficientOperator σ ξ (C *ᵥ v) :=
  hC.linearFunctional_mulVec ξ.1 ξ.2.1 v ξ.2.2

/-- A matrix commuting with all coefficient operators intertwines. -/
theorem intertwines_of_mulVec_coefficientOperator {ρ : MatrixRepresentation G n}
    {σ : MatrixRepresentation G m} {C : Matrix m n k}
    (h : ∀ ξ v, C *ᵥ coefficientOperator ρ ξ v = coefficientOperator σ ξ (C *ᵥ v)) :
    Intertwines ρ σ C := by
  intro S x
  ext i j
  rw [← sub_eq_zero]
  apply (Module.forall_dual_apply_eq_zero_iff k _).mp
  intro ℓ
  have hij : (C *ᵥ fun l => ℓ (((ρ.affineMatrix S x : Matrix n n S) *ᵥ
        fun j' => algebraMap k S ((Pi.single j (1 : k) : n → k) j')) l)) i =
      ℓ (((σ.affineMatrix S x : Matrix m m S) *ᵥ
        fun l => algebraMap k S ((C *ᵥ (Pi.single j (1 : k) : n → k)) l)) i) :=
    congrFun (h ⟨S, x, ℓ⟩ (Pi.single j 1)) i
  have he : (fun l => algebraMap k S ((Pi.single j (1 : k) : n → k) l)) = Pi.single j 1 := by
    funext l
    by_cases hl : l = j
    · subst hl; simp
    · simp [hl]
  have hC : (fun l => algebraMap k S ((C *ᵥ (Pi.single j (1 : k) : n → k)) l)) =
      C.map (algebraMap k S) *ᵥ Pi.single j 1 := by
    rw [← he]
    funext l
    exact (algebraMap k S).map_mulVec C _ l
  rw [he, hC, ← linearFunctional_mulVec_rectangular, Matrix.mulVec_mulVec,
    Matrix.mulVec_mulVec, Matrix.mulVec_single_one, Matrix.mulVec_single_one] at hij
  rw [map_sub, sub_eq_zero]
  exact hij

/-- The subalgebra of `End_k(kⁿ)` generated by the coefficient operators of `ρ`. -/
def coefficientSubalgebra (ρ : MatrixRepresentation G n) :
    Subalgebra k (Module.End k (n → k)) :=
  Algebra.adjoin k (Set.range (coefficientOperator ρ))

theorem coefficientOperator_mem (ρ : MatrixRepresentation G n) (ξ : CoefficientIndex G) :
    coefficientOperator ρ ξ ∈ coefficientSubalgebra ρ :=
  Algebra.subset_adjoin ⟨ξ, rfl⟩

instance (ρ : MatrixRepresentation G n) :
    Module.Finite (coefficientSubalgebra ρ) (n → k) :=
  Module.Finite.of_restrictScalars_finite k _ _

variable (ρ : MatrixRepresentation G n)

/-- Elements of the coefficient subalgebra preserve every stable subspace. -/
theorem apply_mem_of_isStableSubspace {W : Submodule k (n → k)} (hW : IsStableSubspace ρ W)
    {f : Module.End k (n → k)} (hf : f ∈ coefficientSubalgebra ρ) :
    ∀ v ∈ W, f v ∈ W := by
  rw [isStableSubspace_iff] at hW
  refine Algebra.adjoin_induction (p := fun f _ => ∀ v ∈ W, f v ∈ W) ?_ ?_ ?_ ?_ hf
  · rintro f ⟨ξ, rfl⟩ v hv
    exact hW ξ v hv
  · intro c v hv
    rw [Module.algebraMap_end_apply]
    exact W.smul_mem c hv
  · intro f g _ _ hf hg v hv
    rw [LinearMap.add_apply]
    exact W.add_mem (hf v hv) (hg v hv)
  · intro f g _ _ hf hg v hv
    rw [Module.End.mul_apply]
    exact hf _ (hg v hv)

/-- Elements of the coefficient subalgebra commute with every self-intertwiner. -/
theorem Intertwines.mulVec_apply_of_mem {C : Matrix n n k} (hC : Intertwines ρ ρ C)
    {f : Module.End k (n → k)} (hf : f ∈ coefficientSubalgebra ρ) :
    ∀ v, C *ᵥ f v = f (C *ᵥ v) := by
  refine Algebra.adjoin_induction (p := fun f _ => ∀ v, C *ᵥ f v = f (C *ᵥ v))
    ?_ ?_ ?_ ?_ hf
  · rintro f ⟨ξ, rfl⟩ v
    exact Intertwines.mulVec_coefficientOperator hC ξ v
  · intro c v
    rw [Module.algebraMap_end_apply, Module.algebraMap_end_apply]
    exact Matrix.mulVec_smul C c v
  · intro f g _ _ hf hg v
    rw [LinearMap.add_apply, LinearMap.add_apply, Matrix.mulVec_add, hf, hg]
  · intro f g _ _ hf hg v
    rw [Module.End.mul_apply, Module.End.mul_apply, hf, hg]

/-- The additive group of a submodule over the coefficient subalgebra. Instance search
does not find `Submodule.addCommGroup` here unaided, because the semiring structure of a
subalgebra is not syntactically the one underlying its ring structure. -/
instance (p : Submodule (coefficientSubalgebra ρ) (n → k)) : AddCommGroup p :=
  @Submodule.addCommGroup (coefficientSubalgebra ρ) (n → k) _ _ _ p

/-- The coordinate subspace underlying a submodule over the coefficient subalgebra. -/
def toSubspace (p : Submodule (coefficientSubalgebra ρ) (n → k)) : Submodule k (n → k) :=
  p.restrictScalars k

theorem mem_toSubspace {p : Submodule (coefficientSubalgebra ρ) (n → k)} {v : n → k} :
    v ∈ toSubspace ρ p ↔ v ∈ p := Iff.rfl

theorem isStableSubspace_toSubspace (p : Submodule (coefficientSubalgebra ρ) (n → k)) :
    IsStableSubspace ρ (toSubspace ρ p) := by
  rw [isStableSubspace_iff]
  intro ξ v hv
  exact p.smul_mem (⟨coefficientOperator ρ ξ, coefficientOperator_mem ρ ξ⟩ :
    coefficientSubalgebra ρ) hv

/-- The submodule over the coefficient subalgebra with a stable underlying subspace. -/
def ofStable (W : Submodule k (n → k)) (hW : IsStableSubspace ρ W) :
    Submodule (coefficientSubalgebra ρ) (n → k) where
  carrier := {v | v ∈ W}
  add_mem' := W.add_mem
  zero_mem' := W.zero_mem
  smul_mem' r v hv := apply_mem_of_isStableSubspace ρ hW r.2 v hv

theorem toSubspace_ofStable (W : Submodule k (n → k)) (hW : IsStableSubspace ρ W) :
    toSubspace ρ (ofStable ρ W hW) = W := rfl

theorem toSubspace_injective : Function.Injective (toSubspace ρ) := fun p q h => by
  ext v
  exact (mem_toSubspace ρ).symm.trans ((SetLike.ext_iff.mp h v).trans (mem_toSubspace ρ))

theorem toSubspace_le_iff {p q : Submodule (coefficientSubalgebra ρ) (n → k)} :
    toSubspace ρ p ≤ toSubspace ρ q ↔ p ≤ q := Iff.rfl

theorem toSubspace_eq_bot_iff {p : Submodule (coefficientSubalgebra ρ) (n → k)} :
    toSubspace ρ p = ⊥ ↔ p = ⊥ :=
  Submodule.restrictScalars_eq_bot_iff k (coefficientSubalgebra ρ) (n → k)

theorem toSubspace_sSup (s : Set (Submodule (coefficientSubalgebra ρ) (n → k))) :
    toSubspace ρ (sSup s) = sSup (toSubspace ρ '' s) :=
  Submodule.restrictScalars_sSup k s

theorem toSubspace_eq_top_iff {p : Submodule (coefficientSubalgebra ρ) (n → k)} :
    toSubspace ρ p = ⊤ ↔ p = ⊤ :=
  Submodule.restrictScalars_eq_top_iff k (coefficientSubalgebra ρ) (n → k)

/-- The simple stable subspaces are the subspaces underlying simple submodules. -/
theorem simpleStableSubspaces_eq :
    {W : Submodule k (n → k) | IsStableSubspace ρ W ∧ W ≠ ⊥ ∧
        ∀ U : Submodule k (n → k), IsStableSubspace ρ U → U ≤ W → U = ⊥ ∨ U = W} =
      toSubspace ρ '' {p | IsSimpleModule (coefficientSubalgebra ρ) p} := by
  ext W
  constructor
  · rintro ⟨hW, hne, hmin⟩
    refine ⟨ofStable ρ W hW, ?_, toSubspace_ofStable ρ W hW⟩
    show IsSimpleModule (coefficientSubalgebra ρ) (ofStable ρ W hW)
    rw [isSimpleModule_iff_isAtom]
    refine ⟨fun h => hne ?_, fun q hq => ?_⟩
    · rw [← toSubspace_ofStable ρ W hW, h]
      exact (toSubspace_eq_bot_iff ρ).mpr rfl
    · rcases hmin (toSubspace ρ q) (isStableSubspace_toSubspace ρ q)
        ((toSubspace_le_iff ρ).mpr hq.le) with h | h
      · exact (toSubspace_eq_bot_iff ρ).mp h
      · exact absurd (toSubspace_injective ρ (h.trans (toSubspace_ofStable ρ W hW).symm))
          hq.ne
  · rintro ⟨p, hp, rfl⟩
    have hp' : IsAtom p := (isSimpleModule_iff_isAtom).mp hp
    refine ⟨isStableSubspace_toSubspace ρ p, fun h => hp'.1 ((toSubspace_eq_bot_iff ρ).mp h),
      fun U hU hle => ?_⟩
    have hle' : ofStable ρ U hU ≤ p := (toSubspace_le_iff ρ).mp hle
    rcases hp'.le_iff.mp hle' with h | h
    · left
      rw [← toSubspace_ofStable ρ U hU, h]
      exact (toSubspace_eq_bot_iff ρ).mpr rfl
    · right
      rw [← toSubspace_ofStable ρ U hU, h]

/-- The linear-reductivity condition for `ρ` is semisimplicity of `kⁿ` over the
coefficient subalgebra. -/
theorem sSup_simpleStableSubspaces_eq_top_iff :
    sSup {W : Submodule k (n → k) | IsStableSubspace ρ W ∧ W ≠ ⊥ ∧
        ∀ U : Submodule k (n → k), IsStableSubspace ρ U → U ≤ W → U = ⊥ ∨ U = W} = ⊤ ↔
      IsSemisimpleModule (coefficientSubalgebra ρ) (n → k) := by
  rw [simpleStableSubspaces_eq, ← toSubspace_sSup, toSubspace_eq_top_iff]
  exact sSup_simples_eq_top_iff_isSemisimpleModule (R := coefficientSubalgebra ρ) (M := n → k)

/-- A self-intertwiner is linear over the coefficient subalgebra. -/
def Intertwines.toLinearMap {C : Matrix n n k} (hC : Intertwines ρ ρ C) :
    (n → k) →ₗ[coefficientSubalgebra ρ] (n → k) where
  toFun v := C *ᵥ v
  map_add' v w := Matrix.mulVec_add C v w
  map_smul' r v := Intertwines.mulVec_apply_of_mem ρ hC r.2 v

/-- An endomorphism over the coefficient subalgebra has an intertwining matrix. -/
theorem intertwines_toMatrix'
    (f : Module.End (coefficientSubalgebra ρ) (n → k)) :
    Intertwines ρ ρ (LinearMap.toMatrix' (f.restrictScalars k)) := by
  apply intertwines_of_mulVec_coefficientOperator
  intro ξ v
  rw [LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
  exact f.map_smul (⟨coefficientOperator ρ ξ, coefficientOperator_mem ρ ξ⟩ :
    coefficientSubalgebra ρ) v

/-- Matrices of endomorphisms over the coefficient subalgebra. -/
def endRingHom :
    Module.End (coefficientSubalgebra ρ) (n → k) →+* endSubalgebra ρ where
  toFun f := ⟨LinearMap.toMatrix' (f.restrictScalars k), intertwines_toMatrix' ρ f⟩
  map_one' := by
    apply Subtype.ext
    exact LinearMap.toMatrix'_id
  map_mul' f g := by
    apply Subtype.ext
    exact LinearMap.toMatrix'_comp (f.restrictScalars k) (g.restrictScalars k)
  map_zero' := by
    apply Subtype.ext
    exact map_zero LinearMap.toMatrix'
  map_add' f g := by
    apply Subtype.ext
    exact map_add LinearMap.toMatrix' (f.restrictScalars k) (g.restrictScalars k)

theorem endRingHom_surjective : Function.Surjective (endRingHom ρ) := by
  rintro ⟨C, hC⟩
  refine ⟨Intertwines.toLinearMap ρ (show Intertwines ρ ρ C from hC), ?_⟩
  apply Subtype.ext
  have h : ((Intertwines.toLinearMap ρ (show Intertwines ρ ρ C from hC)).restrictScalars k :
      (n → k) →ₗ[k] (n → k)) = Matrix.toLin' C :=
    LinearMap.ext fun v => (Matrix.toLin'_apply C v).symm
  change LinearMap.toMatrix' _ = C
  rw [h, LinearMap.toMatrix'_toLin']

/-- A semisimple coefficient module has a semisimple endomorphism algebra. -/
theorem isSemisimpleRing_endSubalgebra
    [IsSemisimpleModule (coefficientSubalgebra ρ) (n → k)] :
    IsSemisimpleRing (endSubalgebra ρ) := by
  have := IsSemisimpleRing.moduleEnd (coefficientSubalgebra ρ) (n → k)
  exact (endRingHom ρ).isSemisimpleRing_of_surjective (endRingHom_surjective ρ)

/-- If every stable subspace has a stable complement, `kⁿ` is semisimple over the
coefficient subalgebra. -/
theorem isSemisimpleModule_of_stable_complements
    (h : ∀ W : Submodule k (n → k), IsStableSubspace ρ W →
      ∃ W' : Submodule k (n → k), IsStableSubspace ρ W' ∧ IsCompl W W') :
    IsSemisimpleModule (coefficientSubalgebra ρ) (n → k) := by
  refine { toComplementedLattice := ⟨fun p => ?_⟩ }
  obtain ⟨W', hW', hc⟩ := h (toSubspace ρ p) (isStableSubspace_toSubspace ρ p)
  refine ⟨ofStable ρ W' hW', ?_, ?_⟩
  · rw [Submodule.disjoint_def]
    intro v hp hq
    exact (Submodule.disjoint_def.mp hc.disjoint) v hp hq
  · rw [codisjoint_iff, Submodule.eq_top_iff']
    intro v
    have hv : v ∈ toSubspace ρ p ⊔ W' := by
      rw [codisjoint_iff.mp hc.codisjoint]
      exact Submodule.mem_top
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hv
    exact Submodule.mem_sup.mpr ⟨y, hy, z, hz, hyz⟩

end CoefficientModule

/-! ## Stable complements from semisimple endomorphism algebras -/

section Complements

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}

/-- If all endomorphism algebras are semisimple, every stable subspace has a stable
complement: the regular-element property in the endomorphism algebra of
`ρ ⊕ ρ/W` produces an equivariant section of the quotient map. -/
theorem exists_stable_complement [IsAffineHom G.X.hom]
    (H : ∀ (N : ℕ) (τ : MatrixRepresentation G (Fin N)),
      IsSemisimpleRing (Algebra.adjoin k {C : Matrix (Fin N) (Fin N) k | Intertwines τ τ C}))
    {a : ℕ} (ρ : MatrixRepresentation G (Fin a)) (W : Submodule k (Fin a → k))
    (hW : IsStableSubspace ρ W) :
    ∃ W' : Submodule k (Fin a → k), IsStableSubspace ρ W' ∧ IsCompl W W' := by
  obtain ⟨q⟩ := nonempty_quotientRepresentation ρ W hW
  obtain ⟨N, τ, i₁, i₂, p₁, p₂, hi₁, hi₂, hp₁, hp₂, h₁, h₂⟩ :=
    exists_binarySum_fin ρ q.representation
  have hX : Intertwines τ τ (i₂ * (q.projection * p₁)) := (hp₁.comp q.intertwines).comp hi₂
  have := H N τ
  obtain ⟨y, hy⟩ := LinearlyReductiveEndomorphismAlgebraProof.exists_mul_mul_eq_self
    (⟨i₂ * (q.projection * p₁), Algebra.subset_adjoin hX⟩ :
      Algebra.adjoin k {C : Matrix (Fin N) (Fin N) k | Intertwines τ τ C})
  have hY : Intertwines τ τ (y : Matrix (Fin N) (Fin N) k) := by
    have hy2 : (y : Matrix (Fin N) (Fin N) k) ∈ endSubalgebra τ := by
      rw [← adjoin_intertwines_eq]
      exact y.2
    exact hy2
  have hXYX : i₂ * (q.projection * p₁) * (y : Matrix (Fin N) (Fin N) k) *
      (i₂ * (q.projection * p₁)) = i₂ * (q.projection * p₁) := congrArg Subtype.val hy
  have hβ : Intertwines q.representation ρ (p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂)) :=
    (hi₂.comp hY).comp hp₁
  have hPβP : q.projection * (p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂)) * q.projection =
      q.projection := by
    have h := congrArg (fun M => p₂ * M * i₁) hXYX
    simp only [Matrix.mul_assoc, h₁, Matrix.mul_one] at h
    rw [← Matrix.mul_assoc p₂ i₂, h₂, Matrix.one_mul, ← Matrix.mul_assoc p₂ i₂, h₂,
      Matrix.one_mul] at h
    simpa only [Matrix.mul_assoc] using h
  have hPβ : q.projection * (p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂)) = 1 := by
    calc q.projection * (p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂)) =
          q.projection * (p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂)) *
            (q.projection * q.sectionMap) := by
          rw [q.right_inverse, Matrix.mul_one]
      _ = q.projection * (p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂)) * q.projection *
            q.sectionMap := by
          simp only [Matrix.mul_assoc]
      _ = 1 := by rw [hPβP, q.right_inverse]
  set β := p₁ * ((y : Matrix (Fin N) (Fin N) k) * i₂) with hβdef
  have hsec : ∀ w, q.projection *ᵥ (β *ᵥ w) = w := fun w => by
    rw [Matrix.mulVec_mulVec, hPβ, Matrix.one_mulVec]
  have hk : ∀ v, v ∈ W ↔ q.projection *ᵥ v = 0 := fun v =>
    (SetLike.ext_iff.mp q.ker_projection v).symm.trans LinearMap.mem_ker
  refine ⟨LinearMap.range β.mulVecLin, hβ.isStableSubspace_range, ?_, ?_⟩
  · rw [Submodule.disjoint_def]
    rintro v hv ⟨w, rfl⟩
    rw [hk, Matrix.mulVecLin_apply, hsec] at hv
    rw [Matrix.mulVecLin_apply, hv, Matrix.mulVec_zero]
  · rw [codisjoint_iff, Submodule.eq_top_iff']
    intro v
    refine Submodule.mem_sup.mpr ⟨v - β *ᵥ (q.projection *ᵥ v), ?_,
      β *ᵥ (q.projection *ᵥ v), ⟨q.projection *ᵥ v, rfl⟩, sub_add_cancel _ _⟩
    rw [hk, Matrix.mulVec_sub, hsec, sub_self]

end Complements

end MatrixRepresentation.LinearlyReductiveEndomorphismAlgebraProof

open MatrixRepresentation MatrixRepresentation.LinearlyReductiveEndomorphismAlgebraProof in
/-- **Linear reductivity via endomorphism algebras** (Milne, Remark 12.53(b)). -/
theorem linearlyReductiveEndomorphismAlgebra :
    LinearlyReductiveEndomorphismAlgebraStatement.{u} := by
  intro k _ G _ _
  constructor
  · intro h n ρ
    rw [adjoin_intertwines_eq]
    have := (sSup_simpleStableSubspaces_eq_top_iff ρ).mp (h n ρ)
    exact isSemisimpleRing_endSubalgebra ρ
  · intro h n ρ
    rw [sSup_simpleStableSubspaces_eq_top_iff]
    exact isSemisimpleModule_of_stable_complements ρ fun W hW =>
      exists_stable_complement h ρ W hW

end Langlands.GroupScheme
