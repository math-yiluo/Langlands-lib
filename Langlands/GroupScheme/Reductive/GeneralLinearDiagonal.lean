import Langlands.GroupScheme.Reductive.RootDatum
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-! # The diagonal torus of `GL_n` is a closed subgroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Opposite
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.GeneralLinear

variable (n : Type) [Fintype n] [DecidableEq n]

/-! ### Diagonal invertible matrices -/

section DiagonalMatrices

variable {n} {A : Type*} [CommRing A]

/-- An invertible matrix is diagonal when its off-diagonal entries vanish. -/
def IsDiagonalGL (M : GL n A) : Prop := ∀ a b, a ≠ b → (M : Matrix n n A) a b = 0

theorem diag_mul_inv_diag {M : GL n A} (hM : IsDiagonalGL M) (c : n) :
    (M : Matrix n n A) c c * ((M⁻¹ : GL n A) : Matrix n n A) c c = 1 := by
  have h : ((M : Matrix n n A) * ((M⁻¹ : GL n A) : Matrix n n A)) c c = 1 := by
    rw [Units.mul_inv, Matrix.one_apply_eq]
  rwa [Matrix.mul_apply, Finset.sum_eq_single c (fun b _ hb => by rw [hM c b (Ne.symm hb),
    zero_mul]) (by simp)] at h

theorem inv_diag_mul_diag {M : GL n A} (hM : IsDiagonalGL M) (c : n) :
    ((M⁻¹ : GL n A) : Matrix n n A) c c * (M : Matrix n n A) c c = 1 := by
  rw [mul_comm]
  exact diag_mul_inv_diag hM c

/-- The diagonal entries of a diagonal invertible matrix, as units indexed by `ULift n`. -/
def diagUnits {M : GL n A} (hM : IsDiagonalGL M) : ULift.{u} n → Aˣ :=
  fun c => ⟨(M : Matrix n n A) c.down c.down, ((M⁻¹ : GL n A) : Matrix n n A) c.down c.down,
    diag_mul_inv_diag hM c.down, inv_diag_mul_diag hM c.down⟩

theorem diagUnits_val {M : GL n A} (hM : IsDiagonalGL M) (c : ULift.{u} n) :
    ((diagUnits hM c : Aˣ) : A) = (M : Matrix n n A) c.down c.down := rfl

theorem diagonalTorusUnits_diagUnits {M : GL n A} (hM : IsDiagonalGL M) :
    diagonalTorusUnits n A (diagUnits.{u} hM) = M := by
  ext a b
  rw [coe_diagonalTorusUnits, Matrix.diagonal_apply]
  split_ifs with h
  · subst h
    rfl
  · exact (hM a b h).symm

theorem isDiagonalGL_diagonalTorusUnits (t : ULift.{u} n → Aˣ) :
    IsDiagonalGL (diagonalTorusUnits n A t) := by
  intro a b hab
  rw [coe_diagonalTorusUnits, Matrix.diagonal_apply_ne _ hab]

theorem diagonalTorusUnits_injective :
    Function.Injective (diagonalTorusUnits.{u} n A) := by
  intro s t h
  funext c
  apply Units.ext
  have h' := congrArg (fun M : GL n A => (M : Matrix n n A) c.down c.down) h
  simpa only [coe_diagonalTorusUnits, Matrix.diagonal_apply_eq] using h'

theorem IsDiagonalGL.map {B : Type*} [CommRing B] (f : A →+* B) {M : GL n A}
    (hM : IsDiagonalGL M) : IsDiagonalGL (Matrix.GeneralLinearGroup.map f M) := by
  intro a b hab
  rw [Matrix.GeneralLinearGroup.map_apply, hM a b hab, map_zero]

end DiagonalMatrices

/-! ### The diagonal locus -/

section Locus

variable (R : CommRingCat.{u})

/-- The ideal of the coordinate ring of `GL_n` generated by the off-diagonal entries. -/
def offDiagonalIdeal : Ideal (CoordinateRing n R) :=
  Ideal.span (Set.range fun p : {p : n × n // p.1 ≠ p.2} =>
    quotient n R (MvPolynomial.X (Coordinate.entry p.1.1 p.1.2)))

/-- The coordinate ring of the diagonal locus. -/
abbrev DiagonalRing : Type u := CoordinateRing n R ⧸ offDiagonalIdeal n R

/-- The quotient map onto the coordinate ring of the diagonal locus. -/
abbrev diagonalQuotient : CoordinateRing n R →ₐ[R] DiagonalRing n R :=
  Ideal.Quotient.mkₐ R (offDiagonalIdeal n R)

/-- The diagonal locus of `GL_n` over `Spec R`, the spectrum of the quotient of its coordinate
ring by the off-diagonal entries. -/
abbrev diagonalLocus : Over (Spec R) :=
  (algSpec R).obj (op (CommAlgCat.of R (DiagonalRing n R)))

/-- The inclusion of the diagonal locus into `GL_n`. -/
def diagonalLocusι : diagonalLocus n R ⟶ (groupScheme n R).X :=
  (algSpec R).map (CommAlgCat.ofHom (diagonalQuotient n R)).op

instance isClosedImmersion_diagonalLocusι : IsClosedImmersion (diagonalLocusι n R).left := by
  rw [diagonalLocusι, algSpec_map_left]
  exact IsClosedImmersion.spec_of_surjective _ (Ideal.Quotient.mk_surjective (I := offDiagonalIdeal n R))

instance mono_diagonalLocusι : Mono (diagonalLocusι n R) :=
  Over.mono_of_mono_left _

variable {n R}

/-- The off-diagonal entries of the inclusion of the diagonal locus vanish. -/
theorem isDiagonalGL_diagonalLocusι :
    IsDiagonalGL (pointsEquiv n R (diagonalLocus n R) (diagonalLocusι n R)) := by
  rw [pointsEquiv_eq_affinePointsEquiv, diagonalLocusι, affinePointsEquiv_map]
  refine IsDiagonalGL.map _ ?_
  intro a b hab
  change diagonalQuotient n R (quotient n R (MvPolynomial.X (Coordinate.entry a b))) = 0
  rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨⟨(a, b), hab⟩, rfl⟩

/-- The algebra map classifying a point of `GL_n`, through the relative `Spec`/`Γ`
adjunction. -/
abbrev classifyingMap {U : Over (Spec R)} (x : U ⟶ (groupScheme n R).X) :
    CoordinateRing n R →ₐ[R] ((algΓ R).obj U).unop :=
  (((algΓAlgSpecAdjunction R).homEquiv U (op (coordinateAlgebra n R))).symm x).unop.hom

theorem classifyingMap_entry {U : Over (Spec R)} (x : U ⟶ (groupScheme n R).X) (a b : n) :
    classifyingMap x (quotient n R (MvPolynomial.X (Coordinate.entry a b))) =
      pointsEquiv n R U x a b :=
  (adjunction_homEquiv_symm_apply U x _).trans (pointsEquiv_apply_apply U x a b).symm

/-- The algebra map out of the coordinate ring of the diagonal locus classifying a point of
`GL_n` with diagonal matrix. -/
def diagonalLocusLiftAlg {U : Over (Spec R)} (x : U ⟶ (groupScheme n R).X)
    (hx : IsDiagonalGL (pointsEquiv n R U x)) :
    DiagonalRing n R →ₐ[R] ((algΓ R).obj U).unop :=
  Ideal.Quotient.liftₐ (offDiagonalIdeal n R) (classifyingMap x) (by
    intro r hr
    refine (Ideal.span_le (I := RingHom.ker (classifyingMap x))).2 ?_ hr
    rintro _ ⟨p, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, classifyingMap_entry]
    exact hx _ _ p.2)

/-- A point of `GL_n` with diagonal matrix lifts to the diagonal locus. -/
def diagonalLocusLift {U : Over (Spec R)} (x : U ⟶ (groupScheme n R).X)
    (hx : IsDiagonalGL (pointsEquiv n R U x)) : U ⟶ diagonalLocus n R :=
  (algΓAlgSpecAdjunction R).homEquiv U _ (CommAlgCat.ofHom (diagonalLocusLiftAlg x hx)).op

theorem diagonalLocusLift_comp {U : Over (Spec R)} (x : U ⟶ (groupScheme n R).X)
    (hx : IsDiagonalGL (pointsEquiv n R U x)) :
    diagonalLocusLift x hx ≫ diagonalLocusι n R = x := by
  have key := (algΓAlgSpecAdjunction R).homEquiv_naturality_right
    (CommAlgCat.ofHom (diagonalLocusLiftAlg x hx)).op
    (CommAlgCat.ofHom (diagonalQuotient n R) :
      coordinateAlgebra n R ⟶ CommAlgCat.of R (DiagonalRing n R)).op
  refine key.symm.trans ?_
  have h : (CommAlgCat.ofHom (diagonalQuotient n R) :
      coordinateAlgebra n R ⟶ CommAlgCat.of R (DiagonalRing n R)) ≫
      CommAlgCat.ofHom (diagonalLocusLiftAlg x hx) =
      (((algΓAlgSpecAdjunction R).homEquiv U (op (coordinateAlgebra n R))).symm x).unop := by
    apply CommAlgCat.hom_ext
    exact Ideal.Quotient.liftₐ_comp _ _ _
  have h2 := (op_comp.symm.trans (congrArg Quiver.Hom.op h)).trans (Quiver.Hom.op_unop _)
  exact (congrArg ((algΓAlgSpecAdjunction R).homEquiv U _) h2).trans (Equiv.apply_symm_apply _ _)

end Locus

/-! ### The diagonal torus is a closed subgroup -/

section Closed

variable (R : CommRingCat.{u})

theorem isDiagonalGL_diagonalTorus {U : Over (Spec R)}
    (x : U ⟶ (splitTorus (Spec R) (ULift.{u} n)).X) :
    IsDiagonalGL (pointsEquiv n R U (x ≫ (diagonalTorus n R).hom.hom)) := by
  rw [pointsEquiv_diagonalTorus]
  exact isDiagonalGL_diagonalTorusUnits _

/-- The diagonal torus, as a morphism to the diagonal locus. -/
def diagonalTorusToLocus : (splitTorus (Spec R) (ULift.{u} n)).X ⟶ diagonalLocus n R :=
  diagonalLocusLift (diagonalTorus n R).hom.hom (by
    simpa only [Category.id_comp] using isDiagonalGL_diagonalTorus n R (𝟙 _))

theorem diagonalTorusToLocus_comp :
    diagonalTorusToLocus n R ≫ diagonalLocusι n R = (diagonalTorus n R).hom.hom :=
  diagonalLocusLift_comp _ _

/-- The inverse map from the diagonal locus to the diagonal torus, given by the diagonal
entries of its inclusion into `GL_n`. -/
def locusToDiagonalTorus : diagonalLocus n R ⟶ (splitTorus (Spec R) (ULift.{u} n)).X :=
  (splitTorus.pointsEquiv (ULift.{u} n) (diagonalLocus n R)).symm
    (diagUnits isDiagonalGL_diagonalLocusι)

theorem locusToDiagonalTorus_comp :
    locusToDiagonalTorus n R ≫ (diagonalTorus n R).hom.hom = diagonalLocusι n R := by
  apply (pointsEquiv n R _).injective
  rw [pointsEquiv_diagonalTorus, locusToDiagonalTorus, MulEquiv.apply_symm_apply,
    diagonalTorusUnits_diagUnits]

/-- The diagonal torus is isomorphic to the diagonal locus, over `GL_n`. -/
def diagonalTorusLocusIso : (splitTorus (Spec R) (ULift.{u} n)).X ≅ diagonalLocus n R where
  hom := diagonalTorusToLocus n R
  inv := locusToDiagonalTorus n R
  hom_inv_id := by
    rw [← cancel_mono (diagonalTorus n R).hom.hom, Category.assoc, locusToDiagonalTorus_comp,
      diagonalTorusToLocus_comp, Category.id_comp]
  inv_hom_id := by
    rw [← cancel_mono (diagonalLocusι n R), Category.assoc, diagonalTorusToLocus_comp,
      locusToDiagonalTorus_comp, Category.id_comp]

/-- The diagonal torus is a closed subgroup of `GL_n` over any base ring. -/
theorem isClosedSubgroup_diagonalTorus : IsClosedSubgroup (diagonalTorus n R) := by
  change IsClosedImmersion (diagonalTorus n R).hom.hom.left
  rw [← diagonalTorusToLocus_comp, Over.comp_left]
  change IsClosedImmersion ((diagonalTorusLocusIso n R).hom.left ≫ (diagonalLocusι n R).left)
  have : IsIso (diagonalTorusLocusIso n R).hom.left :=
    inferInstanceAs (IsIso ((Over.forget _).map (diagonalTorusLocusIso n R).hom))
  infer_instance

end Closed

end Langlands.GroupScheme.GeneralLinear
