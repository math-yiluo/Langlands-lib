import Langlands.GroupScheme.Reductive.SplitLeviGluingGraph
import Langlands.GroupScheme.Reductive.SplitLeviGluingLocal
import Langlands.GroupScheme.Rational.RootSubgroupStability
import Langlands.GroupScheme.Rational.RootSubgroupConjugation
import Langlands.GroupScheme.Rational.SplitRankTransport
import Langlands.GroupScheme.Torus.SplitReductiveProof

/-! # Root subgroups of the local Levis inside the graph subgroup -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.LeviGluing

variable {k : Type u} [Field k]
    {G₁ G₂ : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))} {I : Type v}
    {i₁ : T.toGrp ⟶ G₁} {i₂ : T.toGrp ⟶ G₂} {ν : I → cocharacterLattice T}

section Family

variable (C : ∀ j, LocalComparison i₁ i₂ (ν j))

/-- The local Levis of a family of local comparisons. -/
abbrev localGroups : I → GroupScheme (Spec (CommRingCat.of k)) := fun j => (C j).left

/-- The inclusions of the local Levis into the first group. -/
abbrev localFirst : ∀ j, localGroups C j ⟶ G₁ := fun j => (C j).leftInclusion

/-- The local Levi isomorphisms followed by the inclusions into the second group. -/
abbrev localSecond : ∀ j, localGroups C j ⟶ G₂ :=
  fun j => (C j).iso.hom ≫ (C j).rightInclusion

/-- Graph subgroups generated by the graphs of the local Levi isomorphisms of `C`
and by the common torus. -/
abbrev LocalGraphEnvelope :=
  GraphEnvelope (T := T.toGrp) (localGroups C) (localFirst C) (localSecond C) i₁ i₂

/-- The actual graph subgroup generated by the local graphs of `C` and the
common torus. -/
def localGraphEnvelope
    [Smooth G₁.X.hom] [IsAffineHom G₁.X.hom] [ConnectedSpace G₁.X.left]
    [Smooth G₂.X.hom] [IsAffineHom G₂.X.hom]
    (hT : IsSplitTorus T.toGrp) : LocalGraphEnvelope C :=
  let : Smooth T.toGrp.X.hom := hT.smooth
  let : IsAffineHom T.toGrp.X.hom := hT.isAffineHom
  let : ConnectedSpace T.toGrp.X.left := hT.connectedSpace
  graphEnvelope _ _ _ _ _ fun _ => ⟨inferInstance, inferInstance, inferInstance⟩

end Family

variable (i₁ i₂ ν) in
/-- The local comparisons supplied by the local gluing premise along a family of
rank-one directions. -/
def canonicalLocalComparisons [IsAffineHom G₁.X.hom] [IsAffineHom G₂.X.hom]
    (hlocal : RankOneLeviHypothesis i₁ i₂) (hν : ∀ j, IsRankOneDirection i₁ (ν j)) :
    ∀ j, LocalComparison i₁ i₂ (ν j) :=
  fun j => localComparison i₁ i₂ hlocal (ν j) (hν j)

/-- Representability of a subgroup functor is unchanged by precomposing the
representative with an isomorphism. -/
private theorem isRepresentedBy_iso_comp {S : Scheme.{u}} {H H' G : GroupScheme S}
    {F : SubgroupFunctor G} {i : H ⟶ G} (hi : F.IsRepresentedBy i) (e : H' ≅ H) :
    F.IsRepresentedBy (e.hom ≫ i) := by
  refine ⟨?_, by rw [SubgroupFunctor.range_iso_comp]; exact hi.2⟩
  have : Mono i.hom.hom := hi.1
  have : IsIso e.hom.hom.hom := (inferInstance : IsIso ((Grp.forget _).mapIso e).hom)
  change Mono (e.hom.hom.hom ≫ i.hom.hom)
  infer_instance

namespace GraphEnvelope

variable {C : ∀ j, LocalComparison i₁ i₂ (ν j)} (D : LocalGraphEnvelope C)

/-- The local torus factor lifts to the distinguished torus of the graph subgroup. -/
@[reassoc (attr := simp)]
theorem leftTorus_localLift (j : I) : (C j).leftTorus ≫ D.localLift j = D.torusLift :=
  D.local_torusLift j (C j).leftTorus (C j).leftTorusComp (by
    change (C j).leftTorus ≫ (C j).iso.hom ≫ (C j).rightInclusion = i₂
    rw [← Category.assoc, (C j).torusIsoComp, (C j).rightTorusComp])

/-- The lift of a root subgroup of the `j`-th local Levi into the graph subgroup. -/
def rootLift (j : I) {α : characterLattice T} (R : (C j).RootComparison α) :
    R.left ⟶ D.group :=
  R.leftInclusion ≫ D.localLift j

@[reassoc (attr := simp)]
theorem rootLift_first (j : I) {α : characterLattice T} (R : (C j).RootComparison α) :
    D.rootLift j R ≫ D.first = R.leftInclusion ≫ (C j).leftInclusion := by
  rw [rootLift, Category.assoc, D.localLift_first]

@[reassoc (attr := simp)]
theorem rootLift_second (j : I) {α : characterLattice T} (R : (C j).RootComparison α) :
    D.rootLift j R ≫ D.second = R.iso.hom ≫ R.rightInclusion ≫ (C j).rightInclusion := by
  rw [rootLift, Category.assoc, D.localLift_second, ← Category.assoc R.iso.hom,
    R.isoComp, Category.assoc]

/-- The lifted root subgroup is closed in the graph subgroup. -/
theorem rootLift_closed [IsAffineHom G₂.X.hom] (j : I) {α : characterLattice T}
    (R : (C j).RootComparison α) : IsClosedSubgroup (D.rootLift j R) :=
  IsClosedSubgroup.comp R.leftClosed (D.localLift_closed j (C j).leftClosed)

/-- The first projection of the lifted root subgroup represents the intrinsic
root subgroup of the first group. -/
theorem rootLift_first_rep (hT : IsSplitTorus T.toGrp) (j : I) {α : characterLattice T}
    (R : (C j).RootComparison α) (hα : α ≠ 0) (hαν : latticePairing T α (ν j) = 0) :
    (RelativeRoot.subgroup i₁ α).IsRepresentedBy (D.rootLift j R ≫ D.first) := by
  rw [rootLift_first]
  exact R.left_ambientRep hT hα hαν

/-- The second projection of the lifted root subgroup represents the intrinsic
root subgroup of the second group. -/
theorem rootLift_second_rep (hT : IsSplitTorus T.toGrp) (j : I) {α : characterLattice T}
    (R : (C j).RootComparison α) (hα : α ≠ 0) (hαν : latticePairing T α (ν j) = 0) :
    (RelativeRoot.subgroup i₂ α).IsRepresentedBy (D.rootLift j R ≫ D.second) := by
  rw [rootLift_second]
  exact isRepresentedBy_iso_comp (R.right_ambientRep hT hα hαν) R.iso

/-- The action of the common torus on the lifted root subgroup: the action of
the local torus factor on its root subgroup representative. -/
def rootTorusAction (j : I) {α : characterLattice T} (R : (C j).RootComparison α) :
    AutomorphicAction T.toGrp R.left :=
  RelativeRoot.subgroupAction (C j).leftTorus α R.leftInclusion R.leftRep

/-- The lifted root subgroup intertwines the torus action with conjugation by
the distinguished torus of the graph subgroup. -/
theorem rootTorusAction_act_comp (j : I) {α : characterLattice T}
    (R : (C j).RootComparison α) {U : Over (Spec (CommRingCat.of k))}
    (s : U ⟶ T.X) (g : U ⟶ R.left.X) :
    (rootTorusAction j R).act s g ≫ (D.rootLift j R).hom.hom =
      (s ≫ D.torusLift.hom.hom) * (g ≫ (D.rootLift j R).hom.hom) *
        (s ≫ D.torusLift.hom.hom)⁻¹ := by
  have h := congrArg (· ≫ (D.localLift j).hom.hom)
    (RelativeRoot.subgroupAction_act_comp (C j).leftTorus α R.leftInclusion R.leftRep s g)
  simp only [Category.assoc, MonObj.mul_comp, GrpObj.inv_comp] at h
  simp only [rootTorusAction, rootLift, Grp.comp_hom_hom, ← D.leftTorus_localLift j]
  exact h

/-- The distinguished torus normalizes the lifted root subgroup on every test. -/
theorem range_rootLift_isNormalizedBy (j : I) {α : characterLattice T}
    (R : (C j).RootComparison α) :
    (SubgroupFunctor.range (D.rootLift j R)).IsNormalizedBy
      (SubgroupFunctor.range D.torusLift) := by
  intro U g x hg hx
  obtain ⟨s, rfl⟩ := SubgroupFunctor.mem_range.mp hg
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  exact SubgroupFunctor.mem_range.mpr
    ⟨(rootTorusAction j R).act s y, D.rootTorusAction_act_comp j R s y⟩

/-- The lifted root subgroup lies in the intrinsic root subgroup of the graph
subgroup for the distinguished torus. -/
theorem range_rootLift_le (j : I) {α : characterLattice T} (R : (C j).RootComparison α) :
    SubgroupFunctor.range (D.rootLift j R) ≤ RelativeRoot.subgroup D.torusLift α := by
  intro U x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  have hy : y ≫ R.leftInclusion.hom.hom ∈
      (RelativeRoot.subgroup (C j).leftTorus α).carrier U := by
    rw [← R.leftRep.2]
    exact SubgroupFunctor.mem_range.mpr ⟨y, rfl⟩
  have h := RelativeRoot.comp_mem_subgroup (C j).leftTorus α (D.localLift j) hy
  rw [D.leftTorus_localLift j] at h
  simpa only [rootLift, Grp.comp_hom_hom, Category.assoc] using h

end GraphEnvelope

end Langlands.GroupScheme.LeviGluing
