import Langlands.GroupScheme.Reductive.FibrewiseRootDatum
import Langlands.GroupScheme.Torus.GeometricAdjointWeightRanks
import Langlands.GroupScheme.Torus.ExponentKernel
import Langlands.GroupScheme.Lie.SmoothScalarExtension

/-! # Trivial adjoint action of the full root-character kernel -/

noncomputable section

universe u v

set_option maxHeartbeats 1200000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj TensorProduct

namespace Langlands.GroupScheme

namespace CoordinateRootDatum

/-- The subgroup generated by all roots, without saturation. -/
def rootExponentSpan {I : Type u} [Fintype I] {J : Type v}
    (P : RootDatum J (I → ℤ) (I → ℤ)) : AddSubgroup (I → ℤ) :=
  AddSubgroup.closure (Set.range P.root)

end CoordinateRootDatum

namespace splitTorus

section Kernel

variable {R : Type u} [CommRing R] (I : Type u) [Fintype I] [DecidableEq I]
  (G : GroupScheme (Spec (CommRingCat.of R)))
  (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G)
  {J : Type v} (P : RootDatum J (I → ℤ) (I → ℤ))

/-- The full diagonalizable kernel of all root exponent characters. -/
abbrev rootKernel : CommGroupScheme (Spec (CommRingCat.of R)) :=
  Diagonalizable.exponentKernel (CommRingCat.of R) I (CoordinateRootDatum.rootExponentSpan P)

/-- The full root-character kernel mapped into the ambient group. -/
def rootKernelHom : (rootKernel (R := R) I P).toGrp ⟶ G :=
  Diagonalizable.exponentKernelHom (CommRingCat.of R) I (CoordinateRootDatum.rootExponentSpan P) ≫ i

end Kernel

variable {R : Type u} [CommRing R] (I : Type u) [Fintype I] [DecidableEq I]
  (G : GroupScheme (Spec (CommRingCat.of R))) [IsAffineHom G.X.hom]
  [Smooth G.X.hom] (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ G)
  {J : Type v} (P : RootDatum J (I → ℤ) (I → ℤ))
  (hP : IsFibrewiseRootDatumOf I G i P)

local instance rootKernelLieAction_affine_fieldPullback {k : Type u} [Field k] [Algebra R k] :
    IsAffineHom ((baseChange (algebraBaseMap R k)).obj G).X.hom :=
  inferInstanceAs (IsAffineHom (Limits.pullback.snd G.X.hom (algebraBaseMap R k)))

include hP

/-- A nonzero exponent outside the common fibrewise root set has zero
actual relative weight space over the whole base ring. -/
theorem exponentWeightSpace_eq_bot_of_not_root
    (m : I → ℤ) (hm : m ≠ 0) (hmP : m ∉ Set.range P.root) :
    exponentWeightSpace I G i m = ⊥ := by
  apply Submodule.subsingleton_iff_eq_bot.mp
  apply (Module.rankAtStalk_eq_zero_iff_subsingleton
    (R := R) (M := exponentWeightSpace I G i m)).mp
  funext s
  let S := Spec (CommRingCat.of R)
  let k := AlgebraicClosure (S.residueField s)
  obtain ⟨φ, hφ⟩ := Spec.map_surjective (geometricPoint S s)
  let : Algebra R k := φ.hom.toAlgebra
  have hb : algebraBaseMap R k = geometricPoint S s := hφ
  have himage : (algebraBaseMap R k) (IsLocalRing.closedPoint k) = s := by
    rw [hb]
    change S.fromSpecResidueField s _ = s
    exact Scheme.fromSpecResidueField_apply _ _
  have hnot : exponentCharacter (Spec (CommRingCat.of k)) I m ∉
      roots (baseChangeHom (K := k) G I i) :=
    fun h => hmP ((hP.mem_roots_iff k m).mp h)
  have hnonzero : exponentCharacter (Spec (CommRingCat.of k)) I m ≠ 0 := by
    rw [exponentCharacter_eq_characterLatticeEquiv_symm]
    exact fun h => hm ((AddEquiv.map_eq_zero_iff _).mp h)
  have hbot : exponentWeightSpace I ((baseChange (algebraBaseMap R k)).obj G)
      (baseChangeHom (K := k) G I i) m = ⊥ := by
    rw [exponentWeightSpace_eq_weightSpace_exponentCharacter]
    exact Classical.byContradiction fun h => hnot (mem_roots.mpr ⟨hnonzero, h⟩)
  have hdim := finrank_exponentWeightSpace_fieldBaseChange I G i (k := k) m
  rw [himage, hbot] at hdim
  exact hdim.symm.trans (finrank_bot k _)

/-- Killing the common root characters fixes the scalar extensions of all
actual base-ring Lie vectors. -/
theorem adjoint_const_eq_self_of_kills_roots
    {A : Type u} [CommRing A] [Algebra R A] (t : I → Aˣ)
    (ht : ∀ α : J, exponentValue I t (.ofAdd (P.root α)) = 1)
    (X : Additive (lieKernel G (CommRingCat.of R))) :
    adjoint G A ((algebraPointsEquiv I A).symm t ≫ i.hom.hom)
        (lieKernelMapLinear G (Algebra.ofId (CommRingCat.of R) A) X) =
      lieKernelMapLinear G (Algebra.ofId (CommRingCat.of R) A) X := by
  classical
  let c := universalAdjointCoefficients I G i X
  have hfix (m : I → ℤ) :
      adjoint G A ((algebraPointsEquiv I A).symm t ≫ i.hom.hom)
          (lieKernelMapLinear G (Algebra.ofId (CommRingCat.of R) A) (c m)) =
        lieKernelMapLinear G (Algebra.ofId (CommRingCat.of R) A) (c m) := by
    have hw := universalAdjointCoefficients_weight I G i t X m
    change adjoint G A _ (lieKernelMapLinear G _ (c m)) =
      (exponentValue I t (.ofAdd m) : A) • lieKernelMapLinear G _ (c m) at hw
    by_cases hm : m = 0
    · subst m
      simpa only [ofAdd_zero, map_one, Units.val_one, one_smul] using hw
    · by_cases hmP : m ∈ Set.range P.root
      · obtain ⟨α, rfl⟩ := hmP
        simpa only [ht, Units.val_one, one_smul] using hw
      · have hc : c m = 0 := by
          have hc := universalAdjointCoefficients_mem_exponentWeightSpace I G i X m
          rw [exponentWeightSpace_eq_bot_of_not_root I G i P hP m hm hmP] at hc
          exact hc
        rw [hc, map_zero, map_zero]
  have hsum := universalAdjointCoefficients_sum I G i X
  change c.sum (fun _ Y => Y) = X at hsum
  rw [← hsum, map_finsuppSum, map_finsuppSum]
  apply Finset.sum_congr rfl
  intro m _
  exact hfix m

/-- Killing the common root characters gives the identity on the entire
actual Lie module over every test algebra. -/
theorem adjoint_eq_self_of_kills_roots
    {A : Type u} [CommRing A] [Algebra R A] (t : I → Aˣ)
    (ht : ∀ α : J, exponentValue I t (.ofAdd (P.root α)) = 1)
    (X : Additive (lieKernel G A)) :
    adjoint G A ((algebraPointsEquiv I A).symm t ≫ i.hom.hom) X = X := by
  obtain ⟨Y, rfl⟩ := (Lie.smoothKernelScalarExtension G A).surjective X
  induction Y using TensorProduct.inductionOn with
  | tmul a Y =>
    rw [Lie.smoothKernelScalarExtension_tmul, map_smul,
      adjoint_const_eq_self_of_kills_roots I G i P hP t ht Y]
  | add Y Z hY hZ =>
    simp only [map_add, hY, hZ]

/-- Every full exponent kernel whose relation subgroup contains all roots
acts trivially on the actual Lie module over every test algebra. -/
theorem adjoint_exponentKernelHom_eq_self
    (N : AddSubgroup (I → ℤ)) (hN : Set.range P.root ⊆ N)
    {A : Type u} [CommRing A] [Algebra R A]
    (x : Lie.AffinePoints
      (Diagonalizable.exponentKernel (CommRingCat.of R) I N).toGrp A)
    (X : Additive (lieKernel G A)) :
    adjoint G A
        ((x ≫ (Diagonalizable.exponentKernelHom (CommRingCat.of R) I N).hom.hom) ≫
          i.hom.hom) X = X := by
  let t := x ≫ (Diagonalizable.exponentKernelHom (CommRingCat.of R) I N).hom.hom
  have ht (α : J) :
      exponentValue I (algebraPointsEquiv I A t) (.ofAdd (P.root α)) = 1 := by
    rw [← characterValue_exponentCharacter]
    let q := Units.mapEquiv
      (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv.toMulEquiv
    change q (Gm.pointsEquiv _ _
      (t ≫ (CommGroupScheme.groupHom
        (exponentCharacter (Spec (CommRingCat.of R)) I (P.root α))).hom.hom)) = 1
    rw [pointsEquiv_exponentCharacter]
    change q (exponentValue I (pointsEquiv I _ t) (.ofAdd (P.root α))) = 1
    rw [Diagonalizable.exponentValue_exponentKernelHom_eq_one x
      (hN ⟨α, rfl⟩)]
    exact map_one q
  have h := adjoint_eq_self_of_kills_roots I G i P hP
    (algebraPointsEquiv I A t) ht X
  rw [MulEquiv.symm_apply_apply] at h
  exact h

/-- The full root-character kernel fixes every actual Lie vector over
every test algebra, with its original algebra structure. -/
theorem adjoint_rootKernelHom_eq_self
    {A : Type u} [CommRing A] [Algebra R A]
    (x : Lie.AffinePoints (rootKernel (R := R) I P).toGrp A)
    (X : Additive (lieKernel G A)) :
    adjoint G A (x ≫ (rootKernelHom I G i P).hom.hom) X = X := by
  change adjoint G A
    ((x ≫ (Diagonalizable.exponentKernelHom (CommRingCat.of R) I
      (CoordinateRootDatum.rootExponentSpan P)).hom.hom) ≫ i.hom.hom) X = X
  exact adjoint_exponentKernelHom_eq_self I G i P hP (CoordinateRootDatum.rootExponentSpan P)
    (fun _ h => AddSubgroup.subset_closure h) x X

end splitTorus

end Langlands.GroupScheme
