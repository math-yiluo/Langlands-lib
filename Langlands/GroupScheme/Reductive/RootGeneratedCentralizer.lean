import Langlands.GroupScheme.Reductive.RootGenerationStatement
import Langlands.GroupScheme.Reductive.NormalCentralizer
import Langlands.GroupScheme.Rational.RootSubgroupCentralizerAction
import Langlands.GroupScheme.Rational.VectorGroupCoordinates
import Langlands.GroupScheme.RepresentedSubgroup

/-! # From centralizing a torus to centralizing its root-generated group -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace AutomorphicAction

variable {k : Type u} [Field k] [IsAlgClosed k]
    {H K : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom H.X.hom]
    (b : AutomorphicAction K H)
    (hRoots : SemisimpleRootGenerationStatement.{u}) (hH : IsSemisimple H)
    (S : CommGroupScheme (Spec (CommRingCat.of k))) (s : S.toGrp ⟶ H)
    (hSplit : IsSplitSubtorus s) (hMax : IsMaximalTorus s)

include hRoots hH hSplit hMax

/-- Closed representability and generation by roots extend fixedness from
every intrinsic root functor to the entire semisimple group. -/
theorem fixedSubgroup_eq_top_of_rootGeneration
    (hK : IsAffineHom K.X.hom)
    (hfixed : ∀ β ∈ relativeRoots s,
      RelativeRoot.subgroup s β ≤ b.fixedSubgroup) :
    b.fixedSubgroup = ⊤ := by
  obtain ⟨C, c, hc, hclosed⟩ :=
    fieldFixedSubgroupRepresentability k K H hK b
  have he := hRoots k H hH S s hSplit hMax C c hclosed (by
    intro β hβ
    rw [hc.2]
    exact hfixed β hβ)
  rw [hc.2] at he
  exact he

/-- An actual vector-line action fixing a split maximal torus is trivial
when the semisimple group is generated by represented vector root lines. -/
theorem eq_trivial_of_rootGeneration_vectorLines
    (hK : RelativeRoot.IsVectorGroupOfDimension K 1)
    (hfix : ∀ (T : Over (Spec (CommRingCat.of k)))
      (q : T ⟶ K.X) (t : T ⟶ S.X),
      b.act q (t ≫ s.hom.hom) = t ≫ s.hom.hom)
    (hLines : ∀ β ∈ relativeRoots s,
      ∃ (V : GroupScheme (Spec (CommRingCat.of k))) (j : V ⟶ H),
        (RelativeRoot.subgroup s β).IsRepresentedBy j ∧
          RelativeRoot.IsVectorGroupOfDimension V 1) :
    b = AutomorphicAction.trivial K H := by
  have he := b.fixedSubgroup_eq_top_of_rootGeneration hRoots hH S s hSplit hMax
    hK.isAffineHom (by
      intro β hβ
      obtain ⟨V, j, hj, hV⟩ := hLines β hβ
      exact RelativeRoot.subgroup_le_fixedSubgroup_of_vectorLines
        b s hfix β j hj hK hV)
  apply b.eq_trivial_of_act_eq
  intro T q g
  have hg : g ∈ b.fixedSubgroup.carrier T := by
    rw [he]
    trivial
  simpa only [Category.id_comp] using hg T (𝟙 T) q

end AutomorphicAction

section Ambient

variable {k : Type u} [Field k] [IsAlgClosed k]
    {G H K : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom H.X.hom]
    (hRoots : SemisimpleRootGenerationStatement.{u}) (hH : IsSemisimple H)
    (S : CommGroupScheme (Spec (CommRingCat.of k))) (s : S.toGrp ⟶ H)
    (hSplit : IsSplitSubtorus s) (hMax : IsMaximalTorus s)
    (h : H ⟶ G) (a : K ⟶ G)
    (hn : (SubgroupFunctor.range h).IsNormalizedBy (SubgroupFunctor.range a))
    [Mono h.hom.hom]
    (hc : SubgroupFunctor.range a ≤
      (AutomorphicAction.conjugation (s ≫ h)).fixedSubgroup)
    (hK : RelativeRoot.IsVectorGroupOfDimension K 1)
    (hLines : ∀ β ∈ relativeRoots s,
      ∃ (V : GroupScheme (Spec (CommRingCat.of k))) (j : V ⟶ H),
        (RelativeRoot.subgroup s β).IsRepresentedBy j ∧
          RelativeRoot.IsVectorGroupOfDimension V 1)

include hRoots hH hSplit hMax hn hc hK hLines

/-- Ambient normalized conjugation centralizing the torus centralizes the
whole semisimple subgroup, under the explicit root-generation and vector-line
premises. The conclusion includes every test scheme and refinement. -/
theorem range_le_centralizer_of_rootGeneration_vectorLines :
    SubgroupFunctor.range a ≤ (AutomorphicAction.conjugation h).fixedSubgroup := by
  have he :=
    (AutomorphicAction.ofNormalizedConjugation h a hn).eq_trivial_of_rootGeneration_vectorLines
      hRoots hH S s hSplit hMax hK
      (fun _ q t => RelativeRoot.normalizedConjugation_fixes_torus h a hn s hc q t)
      hLines
  apply (range_le_conjugation_fixedSubgroup_iff h a).mpr
  intro T x q
  have e := SubgroupFunctor.lift_comp_normalizedConjugation_comp h a hn q x
  change (AutomorphicAction.ofNormalizedConjugation h a hn).act q x ≫ h.hom.hom =
    (q ≫ a.hom.hom) * (x ≫ h.hom.hom) * (q ≫ a.hom.hom)⁻¹ at e
  rw [he, AutomorphicAction.trivial_act] at e
  exact (mul_inv_eq_iff_eq_mul.mp e.symm).symm

variable {C : GroupScheme (Spec (CommRingCat.of k))} (c : C ⟶ G)
    (hC : (AutomorphicAction.conjugation h).fixedSubgroup.IsRepresentedBy c)
    [Mono a.hom.hom]

/-- The actual map from the ambient vector line into any supplied
representative of the full centralizer of the semisimple subgroup. -/
def rootGeneratedCentralizerLift : K ⟶ C :=
  SubgroupFunctor.IsRepresentedBy.lift
    (⟨inferInstance, rfl⟩ :
      (SubgroupFunctor.range a).IsRepresentedBy a) hC
    (fun T => Subgroup.inclusion
      (range_le_centralizer_of_rootGeneration_vectorLines
        hRoots hH S s hSplit hMax h a hn hc hK hLines T))
    (fun _ _ => rfl)

include hC

/-- The centralizer lift has precisely the original ambient inclusion as
its composite, on the actual group schemes. -/
theorem rootGeneratedCentralizerLift_comp :
    rootGeneratedCentralizerLift hRoots hH S s hSplit hMax h a hn hc hK hLines c hC ≫
      c = a :=
  SubgroupFunctor.IsRepresentedBy.lift_comp_eq
    (⟨inferInstance, rfl⟩ : (SubgroupFunctor.range a).IsRepresentedBy a) hC
    (fun T => Subgroup.inclusion
      (range_le_centralizer_of_rootGeneration_vectorLines
        hRoots hH S s hSplit hMax h a hn hc hK hLines T))
    (fun _ _ => rfl) (fun _ _ => rfl)

end Ambient

end Langlands.GroupScheme
