import Langlands.GroupScheme.ImageGeneration
import Langlands.GroupScheme.Torus.Lattice

/-! # Connected reductive groups over infinite fields are generated by finitely many tori -/

universe u

open CategoryTheory
open _root_.AlgebraicGeometry

namespace Langlands.GroupScheme

/-- Over an infinite field `k`, every connected reductive group scheme `G` has finitely many
tori `T j` embedded as closed subgroups `ι j : T j ⟶ G` that generate `G`: every closed
subgroup `i : H ⟶ G` through which all the `ι j` factor has all points of `G`. -/
def ReductiveFiniteTorusGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] [Infinite k]
    (G : GroupScheme (Spec (CommRingCat.of k))),
    IsConnectedReductive G →
    ∃ (m : ℕ) (T : Fin m → GroupScheme (Spec (CommRingCat.of k))) (ι : ∀ j, T j ⟶ G),
      (∀ j, IsTorus (T j)) ∧ (∀ j, IsClosedSubgroup (ι j)) ∧
      ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G), IsClosedSubgroup i →
        (∀ j, FactorsThrough (ι j).hom.hom i) → SubgroupFunctor.range i = ⊤

end Langlands.GroupScheme
