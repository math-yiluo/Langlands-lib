import Langlands.GroupScheme.Rational.RootCommutingPartition
import Langlands.GroupScheme.Reductive.RootGenerationProof
import Langlands.GroupScheme.Reductive.NormalSemisimpleProof

/-! # Normal semisimple subgroups generated by commuting root partitions -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.GroupScheme

variable {k : Type u} [Field k] [IsAlgClosed k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    (i : T.toGrp ⟶ G)

/-- In a semisimple group over an algebraically closed field, root generation
forces a closed subgroup normalized by every root group to be normal. -/
theorem isNormal_range_of_semisimpleRootGroups_normalize (hG : IsSemisimple G)
    (hsplit : IsSplitSubtorus i) (hmax : IsMaximalTorus i)
    {H : GroupScheme (Spec (CommRingCat.of k))} (h : H ⟶ G)
    (hclosed : IsClosedSubgroup h)
    (hroot : letI := hG.isConnectedReductive.isAffineHom
      ∀ α ∈ relativeRoots i,
        RelativeRoot.subgroup i α ≤ (SubgroupFunctor.range h).normalizer) :
    (SubgroupFunctor.range h).IsNormal := by
  let : IsAffineHom G.X.hom := hG.isConnectedReductive.isAffineHom
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  obtain ⟨N, n, hn, hrep⟩ :=
    (hasClosedRepresentative_normalizer_centralizer_range h hclosed).1
  have htop : (SubgroupFunctor.range h).normalizer = ⊤ := by
    rw [← hrep.2]
    apply semisimpleRootGeneration k G hG T i hsplit hmax N n hn
    intro α hα
    rw [hrep.2]
    exact hroot α hα
  intro Z g x _ hx
  apply SubgroupFunctor.conj_mem_of_mem_normalizer (F := SubgroupFunctor.range h) _ hx
  rw [htop]
  trivial

/-- An actual closed semisimple normal subgroup generated by a specified
commuting part of the roots, retaining minimality and complement centrality. -/
structure RootPartitionNormalModel [IsAffineHom G.X.hom]
    (s : Set (characterLattice T)) where
  group : GroupScheme (Spec (CommRingCat.of k))
  inclusion : group ⟶ G
  closed : IsClosedSubgroup inclusion
  semisimple : IsSemisimple group
  normal : (SubgroupFunctor.range inclusion).IsNormal
  root_subset : s ⊆ relativeRoots i
  contains : ∀ α ∈ s, RelativeRoot.subgroup i α ≤ SubgroupFunctor.range inclusion
  minimal : ∀ (H : GroupScheme (Spec (CommRingCat.of k))) (h : H ⟶ G),
    IsClosedSubgroup h →
    (∀ α ∈ s, RelativeRoot.subgroup i α ≤ SubgroupFunctor.range h) →
    SubgroupFunctor.range inclusion ≤ SubgroupFunctor.range h
  centralizes_complement : ∀ β ∈ relativeRoots i, β ∉ s →
    RelativeRoot.subgroup i β ≤ (SubgroupFunctor.range inclusion).centralizer

/-- Every commuting subset of the actual roots generates an actual normal
semisimple subgroup. No almost-simplicity hypothesis is imposed. -/
theorem nonempty_rootPartitionNormalModel (hG : IsSemisimple G)
    (hsplit : IsSplitSubtorus i) (hmax : IsMaximalTorus i)
    (s : Set (characterLattice T))
    (hs : letI := hG.isConnectedReductive.isAffineHom; s ⊆ relativeRoots i)
    (hcomm : letI := hG.isConnectedReductive.isAffineHom; IsCommutingRootPartition i s) :
    letI := hG.isConnectedReductive.isAffineHom
    Nonempty (RootPartitionNormalModel i s) := by
  classical
  let : IsAffineHom G.X.hom := hG.isConnectedReductive.isAffineHom
  let : Smooth G.X.hom := hG.isConnectedReductive.smooth
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have hmaxSplit : IsMaximalSplitTorus i :=
    ⟨hsplit, fun T' j hj f hf => hmax.2.2 T' j f hj.1.isTorus hj.2 hf⟩
  choose A a hrep hclosed hsm hconn hu hsplitA hstable hLie using
    (fun r : s => RelativeRoot.rootSubgroupRealization k G hG.isConnectedReductive
      T i hmaxSplit r.val (hs r.property))
  obtain ⟨H, h, hsmH, haffH, hconnH, hgen⟩ :=
    FiniteGeneration.exists_smooth_generated_family
      (A := A) (a := a) (fun r => ⟨hsm r, (hclosed r).isAffineHom, hconn r⟩)
  let : Smooth H.X.hom := hsmH
  let : IsAffineHom H.X.hom := haffH
  let : ConnectedSpace H.X.left := hconnH
  have hcontains (α : characterLattice T) (hα : α ∈ s) :
      RelativeRoot.subgroup i α ≤ SubgroupFunctor.range h := by
    rw [← (hrep ⟨α, hα⟩).2]
    exact hgen.family_range_le ⟨α, hα⟩
  have hcentral (β : characterLattice T) (hβ : β ∈ relativeRoots i) (hβs : β ∉ s) :
      RelativeRoot.subgroup i β ≤ (SubgroupFunctor.range h).centralizer := by
    apply SubgroupFunctor.le_centralizer_iff.mp
    obtain ⟨B, j, hj, hjclosed, hsmB, hconnB, huB, hsplitB, hstableB, hLieB⟩ :=
      RelativeRoot.rootSubgroupRealization k G hG.isConnectedReductive T i hmaxSplit β hβ
    rw [← hj.2]
    apply hgen.range_le_centralizer j hjclosed
    intro r
    rw [(hrep r).2, hj.2]
    intro Z x hx V f y hy
    exact hcomm r.val r.property β hβ hβs V (f ≫ x) y
      ((RelativeRoot.subgroup i r.val).comp_mem f hx) hy
  have hnormal : (SubgroupFunctor.range h).IsNormal := by
    apply isNormal_range_of_semisimpleRootGroups_normalize i hG hsplit hmax h hgen.1
    intro β hβ
    by_cases hβs : β ∈ s
    · exact (hcontains β hβs).trans (SubgroupFunctor.le_normalizer _)
    · exact (hcentral β hβ hβs).trans (SubgroupFunctor.centralizer_le_normalizer _)
  refine ⟨⟨H, h, hgen.1, hG.of_normalSubgroup h hgen.1 hnormal,
    hnormal, hs, hcontains, ?_, hcentral⟩⟩
  intro K q hq hK
  exact hgen.range_le_of_family_range_le q hq (fun r => by
    rw [(hrep r).2]
    exact hK r.val r.property)

namespace RootPartitionNormalModel

variable [IsAffineHom G.X.hom] {s t : Set (characterLattice T)}
    (M : RootPartitionNormalModel i s) (N : RootPartitionNormalModel i t)

omit [IsAlgClosed k] in
/-- Generated subgroups for disjoint commuting root parts centralize each
other on the full point functor. -/
theorem range_le_centralizer (hdisj : Disjoint s t) :
    SubgroupFunctor.range M.inclusion ≤ (SubgroupFunctor.range N.inclusion).centralizer := by
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  obtain ⟨C, c, hc, hrep⟩ :=
    (hasClosedRepresentative_normalizer_centralizer_range N.inclusion N.closed).2
  rw [← hrep.2]
  apply M.minimal C c hc
  intro α hα
  rw [hrep.2]
  exact N.centralizes_complement α (M.root_subset hα)
    (fun hαt => Set.disjoint_left.mp hdisj hα hαt)

end RootPartitionNormalModel

end Langlands.GroupScheme
