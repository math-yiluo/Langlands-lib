import Langlands.GroupScheme.Reductive.SimpleFactorDecompositionStatement
import Langlands.GroupScheme.Reductive.SimpleFactorPresentation
import Langlands.GroupScheme.Reductive.SimpleFactorSubgroups
import Langlands.GroupScheme.Reductive.NormalIsogenyComplementProof

/-! # The decomposition theorem for semisimple groups over a field: proof -/

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

open SimpleFactor

/-- Conrad, *Reductive group schemes*, Theorem 5.1.19: the minimal nontrivial smooth
connected closed normal subgroups of a semisimple group over a field are almost simple,
pairwise commuting and finite in number, their product maps onto the group by a central
isogeny, every smooth connected closed normal subgroup is generated by a unique subfamily of
them, and every such subgroup has a unique commuting complement with central-isogeny
multiplication. -/
theorem simpleFactorDecomposition : SimpleFactorDecompositionStatement.{u} := by
  intro k _ G hG IsNormalSubgroup IsMinimalNormalSubgroup
  obtain ⟨I, _, A, mul, has, hcl, -, hm⟩ := exists_almostSimplePresentation G hG
  have : QuasiCompact mul.hom.hom.left := by
    have := hm.isFinite
    infer_instance
  have := hm.flat
  have := hm.surjective
  let D : AlmostSimpleCover G :=
    { Index := I
      factor := A
      isAlmostSimple := has
      mul := mul
      isClosedSubgroup := hcl }
  choose B b fac hb using fun J : Set D.Index => D.exists_isSubfamilyImage hG J
  refine ⟨D.Index, D.finite, D.factor, D.inclusion,
    fun i => D.isMinimalNormalSmooth_inclusion hG i, D.injective_range_inclusion hG,
    fun K n hn => D.exists_range_eq_inclusion hG n hn, D.isAlmostSimple,
    fun i j hij T x y => D.commute_inclusion hij x y, ⟨D.mul, fun i => rfl, hm⟩,
    B, b, fun J => ⟨(hb J).isNormalSmooth, (hb J).isSemisimple hG⟩,
    fun J i hi => (hb J).range_inclusion_le hi,
    fun J K n hn hle => (hb J).range_le_of_isClosedSubgroup hn hle,
    fun J i hi => (hb J).exists_isMinimalNormalSmooth hG hi,
    fun J K n hn => (hb J).exists_range_eq_of_isMinimalNormalSmooth hG n hn,
    fun K n hn => ⟨D.support n, (hb _).range_eq_of_support hG hn rfl,
      fun J hJ => ((hb J).support_eq hG hJ).symm⟩, ?_⟩
  intro K n hn
  obtain ⟨-, K', n', hK', hcl', hnor', -, hc, hci⟩ :=
    semisimpleNormalIsogenyComplement k G K hG n hn.1 hn.2.1 hn.2.2.1 hn.2.2.2
  have hn' : IsNormalSmooth n' :=
    ⟨hcl', hK'.isConnectedReductive.smooth, hK'.isConnectedReductive.connectedSpace, hnor'⟩
  refine ⟨K', n', hn', ⟨hc, hci⟩, ?_⟩
  intro K'' n'' hn'' hc'' hci''
  have hs : D.support n'' = D.support n' := by
    ext i
    rw [D.mem_support_complement_iff hG hn hn'' hc'' hci'' i,
      D.mem_support_complement_iff hG hn hn' hc hci i]
  rw [(hb _).range_eq_of_support hG hn'' rfl, (hb _).range_eq_of_support hG hn' hs]

end Langlands.GroupScheme
