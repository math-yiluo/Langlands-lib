import Langlands.GroupScheme.MatrixRepresentation.StableSubrepresentation
import Langlands.GroupScheme.Reductive.InvariantPolynomialDescent
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.AlgebraicGeometry.Morphisms.FiniteType

/-! # Statement: finite generation of invariants of linearly reductive groups
(Milne 12.57, 12.58) -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- **Hilbert's finiteness theorem for linearly reductive groups** (Milne, *Algebraic
Groups*, Theorem 12.57 and Aside 12.58). Let `G` be an affine group scheme of finite type over
a field `k` that is linearly reductive (every representation of `G` on `kᵐ` is semisimple: the
sum of its simple stable subspaces is everything). Then for every representation `ρ` of `G` on
`kⁿ`, the `k`-algebra of polynomials `F` in `n` variables that are invariant under `ρ`
(`F (ρ(g) x) = F x` for all points `g` and vectors `x` over every test scheme) is finitely
generated: it is generated by finitely many invariant polynomials.

This is a statement only; nothing is proved here. -/
def LinearlyReductiveInvariantFiniteGenerationStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [LocallyOfFiniteType G.X.hom] [IsAffineHom G.X.hom],
    (∀ (m : ℕ) (σ : MatrixRepresentation G (Fin m)),
        sSup {W : Submodule k (Fin m → k) | σ.IsStableSubspace W ∧ W ≠ ⊥ ∧
          ∀ U : Submodule k (Fin m → k), σ.IsStableSubspace U → U ≤ W →
            U = ⊥ ∨ U = W} = ⊤) →
      ∀ (n : ℕ) (ρ : MatrixRepresentation G (Fin n)),
        ∃ s : Finset (MvPolynomial (Fin n) k),
          (∀ F ∈ s, ρ.IsInvariantPolynomial F) ∧
            ∀ F : MvPolynomial (Fin n) k, ρ.IsInvariantPolynomial F →
              F ∈ Algebra.adjoin k (s : Set (MvPolynomial (Fin n) k))

end Langlands.GroupScheme
