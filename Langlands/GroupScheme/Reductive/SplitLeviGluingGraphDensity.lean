import Langlands.GroupScheme.Reductive.SplitLeviGluingGraphGeneration
import Langlands.GroupScheme.Reductive.SplitLeviGluingRationalDensity

/-! # The actual rational root families and dense three-factor graph cell -/

noncomputable section

universe u v w

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise

namespace Langlands.GroupScheme.LeviGluing

variable {k : Type u} [Field k]
    {G₁ G₂ : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G₁.X.hom] [Smooth G₁.X.hom]
    [IsAffineHom G₂.X.hom] [Smooth G₂.X.hom]
    {i₁ : T.toGrp ⟶ G₁} {i₂ : T.toGrp ⟶ G₂}
    (D : SimpleComparisonGraph i₁ i₂)

namespace SimpleComparisonGraph

abbrev GraphPoints := Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ D.envelope.group.X

/-- The actual rational range of one positive simple-root graph map. -/
def positiveRational (a : D.SimpleIndex) : Subgroup D.GraphPoints :=
  (SubgroupFunctor.range (D.positiveHom a)).carrier (Over.mk (𝟙 _))

/-- The actual rational range of the corresponding negative map. -/
def negativeRational (a : D.SimpleIndex) : Subgroup D.GraphPoints :=
  (SubgroupFunctor.range (D.negativeHom a)).carrier (Over.mk (𝟙 _))

/-- The rational range of the distinguished common-torus graph lift. -/
def torusRational : Subgroup D.GraphPoints :=
  (SubgroupFunctor.range D.envelope.torusLift).carrier (Over.mk (𝟙 _))

/-- The abstract subgroup generated by the actual positive simple-root ranges. -/
def positiveGenerated : Subgroup D.GraphPoints :=
  Subgroup.closure (⋃ a, (D.positiveRational a : Set D.GraphPoints))

/-- The abstract subgroup generated by the actual negative simple-root ranges. -/
def negativeGenerated : Subgroup D.GraphPoints :=
  Subgroup.closure (⋃ a, (D.negativeRational a : Set D.GraphPoints))

/-- The actual negative-generated, torus, positive-generated rational cell. -/
def rationalGraphCell : Set D.GraphPoints :=
  (D.negativeGenerated : Set D.GraphPoints) * (D.torusRational : Set D.GraphPoints) *
    (D.positiveGenerated : Set D.GraphPoints)

theorem positiveRational_le (a : D.SimpleIndex) :
    D.positiveRational a ≤ D.positiveGenerated :=
  fun _ hx => Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨a, hx⟩)

theorem negativeRational_le (a : D.SimpleIndex) :
    D.negativeRational a ≤ D.negativeGenerated :=
  fun _ hx => Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨a, hx⟩)

theorem positiveGenerated_le_unipotent :
    D.positiveGenerated ≤ (Dynamic.unipotent
      (CommGroupScheme.groupHom D.directions.chamber ≫ D.envelope.torusLift)).carrier
        (Over.mk (𝟙 _)) := by
  rw [positiveGenerated, Subgroup.closure_le]
  exact Set.iUnion_subset fun a => D.positive_le_unipotent a _

theorem negativeGenerated_le_unipotent :
    D.negativeGenerated ≤ (Dynamic.unipotent
      (CommGroupScheme.groupHom (-D.directions.chamber) ≫ D.envelope.torusLift)).carrier
        (Over.mk (𝟙 _)) := by
  rw [negativeGenerated, Subgroup.closure_le]
  exact Set.iUnion_subset fun a => D.negative_le_unipotent a _

theorem torus_normalizes_positiveGenerated :
    D.torusRational ≤ Subgroup.normalizer (D.positiveGenerated : Set D.GraphPoints) := by
  apply Subgroup.le_normalizer_closure_iff.mpr
  intro t ht x hx
  obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
  exact Subgroup.subset_closure
    (Set.mem_iUnion.mpr ⟨a, D.positive_normalized a _ t x ht ha⟩)

theorem torus_normalizes_negativeGenerated :
    D.torusRational ≤ Subgroup.normalizer (D.negativeGenerated : Set D.GraphPoints) := by
  apply Subgroup.le_normalizer_closure_iff.mpr
  intro t ht x hx
  obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
  exact Subgroup.subset_closure
    (Set.mem_iUnion.mpr ⟨a, D.negative_normalized a _ t x ht ha⟩)

/-- The actual family-generated rational subgroup has exactly the form used
by the abstract three-factor word induction. -/
theorem rootFamilyRationalPoints_eq_closure :
    D.rootFamilyRationalPoints =
      Subgroup.closure ((⋃ a, (D.positiveRational a : Set D.GraphPoints)) ∪
        (D.negativeGenerated : Set D.GraphPoints) ∪ (D.torusRational : Set D.GraphPoints)) := by
  have hs :
      (⋃ j, ((SubgroupFunctor.range (D.rootFamilyMaps j)).carrier (Over.mk (𝟙 _)) :
        Set D.GraphPoints)) =
      (⋃ a, (D.positiveRational a : Set D.GraphPoints)) ∪
        (⋃ a, (D.negativeRational a : Set D.GraphPoints)) ∪
          (D.torusRational : Set D.GraphPoints) := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_union, SetLike.mem_coe]
    constructor
    · rintro ⟨(_ | (a | a)), hx⟩
      · exact Or.inr hx
      · exact Or.inl (Or.inl ⟨a, hx⟩)
      · exact Or.inl (Or.inr ⟨a, hx⟩)
    · rintro ((⟨a, ha⟩ | ⟨a, ha⟩) | ht)
      · exact ⟨some (.inl a), ha⟩
      · exact ⟨some (.inr a), ha⟩
      · exact ⟨none, ht⟩
  unfold rootFamilyRationalPoints generatedRationalPoints
  rw [hs]
  simp only [negativeGenerated, Subgroup.closure_union, Subgroup.closure_eq]

variable [ConnectedSpace G₁.X.left] [IsAlgClosed k]
    (hi₁ : IsClosedSubgroup i₁)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom D.directions.chamber ≫ i₁) =
      SubgroupFunctor.range i₁)
    {J₁ : Type v} {J₂ : Type w}
    (P₁ : RootDatum J₁ (characterLattice T) (cocharacterLattice T))
    (P₂ : RootDatum J₂ (characterLattice T) (cocharacterLattice T))
    (hP₁ : IsRootDatumOf i₁ P₁) (hP₂ : IsRootDatumOf i₂ P₂)
    (hroots : roots i₁ = roots i₂)

/-- The constructed generated rational subgroup acts by left multiplication
on the rational-point closure of the actual graph cell. -/
@[instance_reducible]
def rationalGraphCellClosureAction :
    MulAction D.rootFamilyRationalPoints
      (rationalPointClosure D.envelope.group D.rationalGraphCell) := by
  rw [D.rootFamilyRationalPoints_eq_closure]
  exact rationalTripleProductClosureAction D.envelope.group
    D.positiveRational D.negativeRational D.negativeGenerated D.torusRational D.positiveGenerated
    D.positiveRational_le rfl D.torus_normalizes_negativeGenerated
    D.torus_normalizes_positiveGenerated
    (fun a b hab _ hx _ hy =>
      D.commute_positive_negative P₁ P₂ hP₁ hP₂ hroots a b hab hx hy)
    (D.positive_mul_negative_subset_rationalPointClosure hi₁ hZ P₁ hP₁)

include hi₁ hZ hP₁ hP₂ hroots in
/-- The actual three-factor rational graph cell has dense locations in the
graph. Every family and density input is constructed or proved above. -/
theorem dense_rationalGraphCell :
    Dense (rationalPointImage D.envelope.group D.rationalGraphCell) := by
  have hgen := D.dense_rootFamilyRationalPoints hi₁ hZ P₁ hP₁
  rw [D.rootFamilyRationalPoints_eq_closure] at hgen
  exact dense_rationalPointImage_tripleProduct D.envelope.group
    D.positiveRational D.negativeRational D.negativeGenerated D.torusRational D.positiveGenerated
    D.positiveRational_le rfl D.torus_normalizes_negativeGenerated
    D.torus_normalizes_positiveGenerated
    (fun a b hab _ hx _ hy =>
      D.commute_positive_negative P₁ P₂ hP₁ hP₂ hroots a b hab hx hy)
    (D.positive_mul_negative_subset_rationalPointClosure hi₁ hZ P₁ hP₁) hgen

end SimpleComparisonGraph

end Langlands.GroupScheme.LeviGluing
