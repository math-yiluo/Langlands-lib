import Langlands.GroupScheme.MatrixRepresentation.StableSubrepresentation
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.AlgebraicGeometry.Morphisms.FiniteType

/-! # Statement: linear reductivity via semisimple endomorphism algebras -/

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

/-- **Linear reductivity via endomorphism algebras** (Milne, *Algebraic Groups*,
Remark 12.53(b)). An affine group scheme `G` of finite type over a field `k` is linearly
reductive (every representation of `G` on `kⁿ` is semisimple: the sum of its simple stable
subspaces is everything) if and only if, for every representation `ρ` of `G` on `kⁿ`, the
endomorphism algebra of `ρ` is a semisimple ring. The endomorphism algebra is the
subalgebra of `Matrix (Fin n) (Fin n) k` generated by (in fact equal to) the matrices
intertwining `ρ` with itself.

This is a statement only; nothing is proved here. -/
def LinearlyReductiveEndomorphismAlgebraStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    [LocallyOfFiniteType G.X.hom] [IsAffineHom G.X.hom],
    (∀ (n : ℕ) (ρ : MatrixRepresentation G (Fin n)),
        sSup {W : Submodule k (Fin n → k) | ρ.IsStableSubspace W ∧ W ≠ ⊥ ∧
          ∀ U : Submodule k (Fin n → k), ρ.IsStableSubspace U → U ≤ W →
            U = ⊥ ∨ U = W} = ⊤) ↔
      ∀ (n : ℕ) (ρ : MatrixRepresentation G (Fin n)),
        IsSemisimpleRing (Algebra.adjoin k
          {C : Matrix (Fin n) (Fin n) k | MatrixRepresentation.Intertwines ρ ρ C})

end Langlands.GroupScheme
