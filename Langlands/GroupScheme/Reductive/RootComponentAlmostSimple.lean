import Langlands.GroupScheme.Reductive.RootComponentNormalSupport
import Langlands.GroupScheme.Reductive.RootPartitionNormalSubgroup
import Langlands.GroupScheme.Reductive.LinkedRootsAlmostSimple
import Langlands.GroupScheme.Reductive.MinimalNormalFactor

/-! # Almost-simple groups generated by one actual Cartan component -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.GroupScheme

section NonemptySupport

variable {k : Type u} [Field k] [IsAlgClosed k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {T : CommGroupScheme (Spec (CommRingCat.of k))}

/-- A nontrivial smooth connected closed normal subgroup of a semisimple
group contains at least one full root group of a supplied split maximal torus. -/
theorem exists_rootSubgroup_le_of_normal_range_ne_bot
    (hG : IsSemisimple G) (i : T.toGrp ⟶ G)
    (hsplit : IsSplitSubtorus i) (hmax : IsMaximalTorus i)
    {H : GroupScheme (Spec (CommRingCat.of k))}
    [Smooth H.X.hom] [ConnectedSpace H.X.left]
    (h : H ⟶ G) (hc : IsClosedSubgroup h)
    (hn : (SubgroupFunctor.range h).IsNormal)
    (hnt : SubgroupFunctor.range h ≠ ⊥) :
    letI := hG.isConnectedReductive.isAffineHom
    ∃ a ∈ relativeRoots i, RelativeRoot.subgroup i a ≤ SubgroupFunctor.range h := by
  let : IsAffineHom G.X.hom := hG.isConnectedReductive.isAffineHom
  let : IsAffineHom H.X.hom := hc.isAffineHom
  let : IsClosedImmersion h.hom.hom.left := hc
  let : Mono h.hom.hom := Over.mono_of_mono_left _
  by_contra hex
  have hfixed : ∀ a ∈ relativeRoots i,
      RelativeRoot.subgroup i a ≤ (AutomorphicAction.conjugation h).fixedSubgroup := by
    intro a ha
    exact (semisimpleNormalRootDichotomy k G hG T i hsplit hmax H h hc hn a ha).resolve_left
      (fun hin => hex ⟨a, ha, hin⟩)
  have hcentral : (AutomorphicAction.conjugation h).fixedSubgroup = ⊤ :=
    (AutomorphicAction.conjugation h).fixedSubgroup_eq_top_of_rootGeneration
      semisimpleRootGeneration hG T i hsplit hmax inferInstance hfixed
  have hH : IsSemisimple H := hG.of_normalSubgroup h hc hn
  have hcomm : ∀ (U : Over (Spec (CommRingCat.of k))) (x y : U ⟶ H.X), Commute x y := by
    intro U x y
    apply (commute_iff_eq _ _).mpr
    apply (cancel_mono h.hom.hom).mp
    have hm : y ≫ h.hom.hom ∈
        (AutomorphicAction.conjugation h).fixedSubgroup.carrier U := by
      rw [hcentral]
      trivial
    have he := (mem_conjugation_fixedSubgroup_iff h _).mp hm U (𝟙 U) x
    simpa only [Category.id_comp, MonObj.mul_comp] using he.eq
  have hntId : SubgroupFunctor.range (𝟙 H) ≠ ⊥ := by
    intro hz
    apply hnt
    simpa only [Category.id_comp] using
      (SubgroupFunctor.range_comp_eq_bot_iff (𝟙 H) h).mpr hz
  exact hH.noncommutative_of_range_ne_bot hntId hcomm

end NonemptySupport

namespace RootComponentCoordinates

open Langlands.LinearAlgebra.SimplyConnectedCartanComponents

variable {M : AffinePinnedModel.{u}} (D : RootComponentCoordinates M)

local instance : Smooth M.group.X.hom := M.reductive.smooth

variable (k : Type u) [Field k] [IsAlgClosed k] [Algebra M.ring k]

local instance : IsAffineHom ((baseChange (algebraBaseMap M.ring k)).obj M.group).X.hom :=
  (M.reductive.isConnectedReductive_algebraMap k).isAffineHom
local instance : Smooth ((baseChange (algebraBaseMap M.ring k)).obj M.group).X.hom :=
  (M.reductive.isConnectedReductive_algebraMap k).smooth

variable (hG : IsSemisimple ((baseChange (algebraBaseMap M.ring k)).obj M.group))

/-- Choose the actual closed normal semisimple subgroup generated by a
specified Cartan component of a semisimple algebraically closed field fibre. -/
def fieldComponentNormalModel (c : Component M.basis) :
    RootPartitionNormalModel
      (T := splitTorus.commGroupScheme (Spec (CommRingCat.of k)) M.coordinates)
      (D.fieldTorusInclusion k) (D.componentRoots k c) := by
  have hmax := splitTorus.isMaximalTorus_baseChangeHom_of_fibrewise
    M.coordinates M.group M.inclusion M.maximal k
  exact Classical.choice (nonempty_rootPartitionNormalModel
    (T := splitTorus.commGroupScheme (Spec (CommRingCat.of k)) M.coordinates)
    (D.fieldTorusInclusion k) hG
    ⟨isSplitTorus_splitTorus M.coordinates, hmax.2.1⟩ hmax
    (D.componentRoots k c) (D.componentRoots_subset k c)
    (D.componentRoots_isCommutingRootPartition k c))

include hG in
/-- Every supplied normal root-generated model for one Cartan component is
almost simple. This does not require simple connectedness or adjointness. -/
theorem componentNormalModel_isAlmostSimple (c : Component M.basis)
    (N : RootPartitionNormalModel
      (T := splitTorus.commGroupScheme (Spec (CommRingCat.of k)) M.coordinates)
      (D.fieldTorusInclusion k) (D.componentRoots k c)) : IsAlmostSimple N.group := by
  classical
  let T := splitTorus.commGroupScheme (Spec (CommRingCat.of k)) M.coordinates
  let i : T.toGrp ⟶ _ := D.fieldTorusInclusion k
  let P := CoordinateRootDatum.fieldRealization k M.rootDatum
  have hmax : IsMaximalTorus (T := T) i :=
    splitTorus.isMaximalTorus_baseChangeHom_of_fibrewise
      M.coordinates M.group M.inclusion M.maximal k
  have hsplit : IsSplitSubtorus (T := T) i :=
    ⟨isSplitTorus_splitTorus M.coordinates, hmax.2.1⟩
  have hP : IsRootDatumOf (T := T) i P := M.fibrewiseRootDatum.field k
  let : Smooth N.group.X.hom := N.semisimple.isConnectedReductive.smooth
  let : IsAffineHom N.group.X.hom := N.semisimple.isConnectedReductive.isAffineHom
  let : ConnectedSpace N.group.X.left := N.semisimple.isConnectedReductive.connectedSpace
  let : IsClosedImmersion N.inclusion.hom.hom.left := N.closed
  let : Mono N.inclusion.hom.hom := Over.mono_of_mono_left _
  have hnt : SubgroupFunctor.range (𝟙 N.group) ≠ ⊥ := by
    intro hz
    have hzN : SubgroupFunctor.range N.inclusion = ⊥ := by
      simpa only [Category.id_comp] using
        (SubgroupFunctor.range_comp_eq_bot_iff (𝟙 N.group) N.inclusion).mpr hz
    obtain ⟨a, ha⟩ := D.componentRoots_nonempty k c
    obtain ⟨x, hx, hx1⟩ := RelativeRoot.exists_rootPoint_actual hsplit.1 i
      (D.componentRoots_subset k c ha)
    have hm := N.contains a ha _ hx
    rw [hzN] at hm
    exact hx1 hm
  refine ⟨N.semisimple, N.semisimple.noncommutative_of_range_ne_bot hnt, ?_⟩
  intro H a ha hsm hconn han
  let : Smooth H.X.hom := hsm
  let : ConnectedSpace H.X.left := hconn
  let : IsClosedImmersion a.hom.hom.left := ha
  let : Mono a.hom.hom := Over.mono_of_mono_left _
  by_cases hzero : SubgroupFunctor.range a = ⊥
  · exact Or.inl hzero
  right
  let j : H ⟶ (baseChange (algebraBaseMap M.ring k)).obj M.group := a ≫ N.inclusion
  have hjc : IsClosedSubgroup j := ha.comp N.closed
  have hjn : (SubgroupFunctor.range j).IsNormal :=
    isNormal_range_comp_of_actual_roots semisimpleRootGeneration
      semisimpleNormalRootDichotomy hG T i hsplit hmax
      N.inclusion N.closed N.normal a ha han
  have hjnt : SubgroupFunctor.range j ≠ ⊥ :=
    fun hz => hzero ((SubgroupFunctor.range_comp_eq_bot_iff a N.inclusion).mp hz)
  obtain ⟨alpha, halpha, hcontain⟩ :=
    exists_rootSubgroup_le_of_normal_range_ne_bot hG i hsplit hmax j hjc hjn hjnt
  rw [relativeRoots_eq_roots, ← hP.2.1] at halpha
  obtain ⟨r, rfl⟩ := halpha
  have hr : r ∈ D.fieldNormalRootSupport k (SubgroupFunctor.range j) := hcontain
  have hrc : D.rootComponent r = c := by
    by_contra hrc
    have hout : P.root r ∉ D.componentRoots k c := by
      rintro ⟨s, hsc, hs⟩
      have he : P.root s = P.root r := by
        change (CoordinateRootDatum.fieldRealization k M.rootDatum).root s = _
        rw [CoordinateRootDatum.fieldRealization_root]
        exact hs
      have hsr := P.root.injective he
      subst s
      exact hrc hsc
    have hcN := N.centralizes_complement (P.root r) (by
      rw [relativeRoots_eq_roots, ← hP.2.1]
      exact Set.mem_range_self r) hout
    have hcj : RelativeRoot.subgroup i (P.root r) ≤
        (SubgroupFunctor.range j).centralizer := by
      intro U x hx V f y hy
      exact hcN U hx V f y ((SubgroupFunctor.range_comp_le a N.inclusion) V hy)
    have hz := hP.pairing_eq_zero_of_normalRootSupport_centralizer
      (T := T) i hG.isConnectedReductive hsplit.1 hmax hjn r r hr hcj
    rw [P.pairing_same] at hz
    norm_num at hz
  have hunion := D.fieldNormalRootSupport_isComponentUnion k hG j hjc hjn
  have hle : SubgroupFunctor.range N.inclusion ≤ SubgroupFunctor.range j := by
    apply N.minimal H j hjc
    rintro beta ⟨s, hsc, rfl⟩
    have hs : s ∈ D.fieldNormalRootSupport k (SubgroupFunctor.range j) :=
      (hunion r s (hrc.trans hsc.symm)).mp hr
    change RelativeRoot.subgroup (D.fieldTorusInclusion k)
      ((CoordinateRootDatum.fieldRealization k M.rootDatum).root s) ≤
        SubgroupFunctor.range j at hs
    simpa only [CoordinateRootDatum.fieldRealization_root] using hs
  apply SubgroupFunctor.ext
  intro U
  change (SubgroupFunctor.range a).carrier U = ⊤
  apply top_unique
  intro y _
  have hy := hle U (SubgroupFunctor.mem_range.mpr ⟨y, rfl⟩)
  obtain ⟨z, hz⟩ := SubgroupFunctor.mem_range.mp hy
  apply SubgroupFunctor.mem_range.mpr
  refine ⟨z, (cancel_mono N.inclusion.hom.hom).mp ?_⟩
  simpa only [j, Grp.comp_hom_hom, ← Category.assoc] using hz

/-- The chosen actual group generated by a Cartan component has almost-simple
geometric structure over the algebraically closed field. -/
theorem fieldComponentNormalModel_isAlmostSimple (c : Component M.basis) :
    IsAlmostSimple (D.fieldComponentNormalModel k hG c).group :=
  D.componentNormalModel_isAlmostSimple k hG c _

end RootComponentCoordinates

end Langlands.GroupScheme
