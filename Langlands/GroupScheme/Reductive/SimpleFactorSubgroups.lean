import Langlands.GroupScheme.Reductive.SimpleFactorCover
import Langlands.GroupScheme.HomImage
import Langlands.GroupScheme.Derived.SemisimplePerfectProof
import Langlands.GroupScheme.ProductProperties

/-! # The subgroups generated by families of almost-simple factors -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.SimpleFactor

private instance smoothGeometricallyConnected_comp :
    ((@Smooth ⊓ @GeometricallyConnected :
      MorphismProperty Scheme.{u})).IsStableUnderComposition where
  comp_mem f g hf hg := by
    let : Smooth f := hf.1
    let : Smooth g := hg.1
    let : GeometricallyConnected f := hf.2
    let : GeometricallyConnected g := hg.2
    exact ⟨inferInstance, GeometricallyConnected.comp f g⟩

private instance smoothGeometricallyConnected_id :
    ((@Smooth ⊓ @GeometricallyConnected :
      MorphismProperty Scheme.{u})).ContainsIdentities where
  id_mem X := by
    refine ⟨inferInstance, ⟨?_⟩⟩
    intro K _ x Y a b hp
    have : IsIso b := hp.isIso_snd_of_isIso
    exact b.homeomorph.connectedSpace_iff.mpr inferInstance

variable {k : Type u} [Field k] {G K : GroupScheme (Spec (CommRingCat.of k))}

namespace AlmostSimpleCover

variable (D : AlmostSimpleCover G)

/-- The product of the factors indexed by a subset. -/
abbrev subproduct (s : Set D.Index) : GroupScheme (Spec (CommRingCat.of k)) :=
  pi (fun i : s => D.factor i)

set_option backward.isDefEq.respectTransparency false in
/-- Every subproduct of the factors is smooth, geometrically connected and affine. -/
theorem subproduct_geometry (s : Set D.Index) :
    Smooth (D.subproduct s).X.hom ∧ GeometricallyConnected (D.subproduct s).X.hom ∧
      IsAffineHom (D.subproduct s).X.hom := by
  have h1 : (@Smooth ⊓ @GeometricallyConnected : MorphismProperty Scheme.{u})
      (D.subproduct s).X.hom := by
    apply prop_pi_hom (@Smooth ⊓ @GeometricallyConnected) (fun i : s => D.factor i)
    intro i
    have h := (D.isAlmostSimple i).isSemisimple.isConnectedReductive
    let : Smooth (D.factor i).X.hom := h.smooth
    let : IsAffineHom (D.factor i).X.hom := h.isAffineHom
    let : ConnectedSpace (D.factor i).X.left := h.connectedSpace
    exact ⟨inferInstance, (D.factor i).geometricallyConnected_of_connected⟩
  refine ⟨h1.1, h1.2, ?_⟩
  apply prop_pi_hom (@IsAffineHom : MorphismProperty Scheme.{u}) (fun i : s => D.factor i)
  intro i
  exact (D.isAlmostSimple i).isSemisimple.isConnectedReductive.isAffineHom

/-- A closed subgroup `b : B ⟶ G` that is the image of the subproduct on `s` under the
multiplication, through a quasi-compact, flat, surjective homomorphism `fac`, with `B`
smooth and connected. -/
structure IsSubfamilyImage (s : Set D.Index) {B : GroupScheme (Spec (CommRingCat.of k))}
    (b : B ⟶ G) (fac : D.subproduct s ⟶ B) : Prop where
  isClosedSubgroup : IsClosedSubgroup b
  fac_comp : fac ≫ b = piSubsetInclusionHom D.factor s ≫ D.mul
  quasiCompact : QuasiCompact fac.hom.hom.left
  flat : Flat fac.hom.hom.left
  surjective : Surjective fac.hom.hom.left
  smooth : Smooth B.X.hom
  connectedSpace : ConnectedSpace B.X.left

/-- The image of every subproduct exists. -/
theorem exists_isSubfamilyImage (hG : IsSemisimple G) (s : Set D.Index) :
    ∃ (B : GroupScheme (Spec (CommRingCat.of k))) (b : B ⟶ G) (fac : D.subproduct s ⟶ B),
      D.IsSubfamilyImage s b fac := by
  obtain ⟨h1, h2, h3⟩ := D.subproduct_geometry s
  have : ConnectedSpace (D.subproduct s).X.left :=
    GeometricallyConnected.connectedSpace_of_subsingleton (f := (D.subproduct s).X.hom)
  have : Smooth G.X.hom := hG.isConnectedReductive.smooth
  have : IsAffineHom G.X.hom := hG.isConnectedReductive.isAffineHom
  obtain ⟨B, b, fac, hb, hfac, hf, hs, hq, -, hsm, hcon, -⟩ :=
    HomImage.exists_image (piSubsetInclusionHom D.factor s ≫ D.mul)
  exact ⟨B, b, fac, ⟨hb, hfac, hq, hf, hs, hsm, hcon⟩⟩

namespace IsSubfamilyImage

variable {D} {s : Set D.Index} {B : GroupScheme (Spec (CommRingCat.of k))} {b : B ⟶ G}
  {fac : D.subproduct s ⟶ B} (h : D.IsSubfamilyImage s b fac)

include h

theorem mono : Mono b.hom.hom := h.isClosedSubgroup.mono_overHom

/-- The image of a subproduct is normal. -/
theorem isNormal_range : (SubgroupFunctor.range b).IsNormal := by
  have := h.quasiCompact
  have := h.flat
  have := h.surjective
  have := h.mono
  exact isNormal_range_of_image D.mul fac (piSubsetInclusionHom D.factor s)
    (isNormal_range_piSubsetInclusionHom D.factor s) b h.fac_comp

theorem isNormalSmooth : IsNormalSmooth b :=
  ⟨h.isClosedSubgroup, h.smooth, h.connectedSpace, h.isNormal_range⟩

/-- The image of a subproduct is semisimple. -/
theorem isSemisimple (hG : IsSemisimple G) : IsSemisimple B := by
  have := h.smooth
  have := h.connectedSpace
  exact hG.of_normalSubgroup b h.isClosedSubgroup h.isNormal_range

/-- A selected factor followed by the image map is the corresponding embedding into `G`. -/
theorem factor_comp (i : s) :
    (piFactorInclusionHom (fun j : s => D.factor j) i ≫ fac) ≫ b = D.inclusion i := by
  rw [Category.assoc, h.fac_comp, ← Category.assoc,
    piFactorInclusionHom_comp_piSubsetInclusionHom]
  rfl

/-- The image contains every selected factor. -/
theorem range_inclusion_le {i : D.Index} (hi : i ∈ s) :
    SubgroupFunctor.range (D.inclusion i) ≤ SubgroupFunctor.range b := by
  rw [← h.factor_comp ⟨i, hi⟩]
  exact range_comp_le_range _ _

/-- The image is contained in every closed subgroup containing the selected factors. -/
theorem range_le_of_isClosedSubgroup {n : K ⟶ G} (hn : IsClosedSubgroup n)
    (hle : ∀ i ∈ s, SubgroupFunctor.range (D.inclusion i) ≤ SubgroupFunctor.range n) :
    SubgroupFunctor.range b ≤ SubgroupFunctor.range n := by
  have := h.quasiCompact
  have := h.flat
  have := h.surjective
  have := hn.mono_overHom
  apply range_le_of_comp_le fac b n
  rw [h.fac_comp]
  exact (range_piSubsetInclusionHom_comp_le_iff D.factor D.mul s _).2 hle

/-- The image lies in the commutant of a subgroup functor when the selected factors do. -/
theorem range_le_commutant (F : SubgroupFunctor G)
    (hle : ∀ i ∈ s, SubgroupFunctor.range (D.inclusion i) ≤ commutant F) :
    SubgroupFunctor.range b ≤ commutant F := by
  have := h.quasiCompact
  have := h.flat
  have := h.surjective
  apply range_le_commutant_of_comp fac b F
  rw [h.fac_comp]
  exact (range_piSubsetInclusionHom_comp_le_iff D.factor D.mul s _).2 hle

/-- A factor lies in the image exactly when it is selected. -/
theorem mem_iff (hG : IsSemisimple G) (i : D.Index) :
    i ∈ s ↔ SubgroupFunctor.range (D.inclusion i) ≤ SubgroupFunctor.range b := by
  refine ⟨h.range_inclusion_le, fun hle => ?_⟩
  by_contra hi
  have hc : SubgroupFunctor.range b ≤ commutant (SubgroupFunctor.range (D.inclusion i)) :=
    h.range_le_commutant _ fun j hj => D.range_inclusion_le_commutant fun hji => hi (hji ▸ hj)
  exact D.range_inclusion_ne_bot i
    (range_eq_bot_of_le_commutant hG _ (D.isNormalSmooth_inclusion i) (hle.trans hc))

/-- The selected factors form an almost-simple cover of the image. -/
def subcover : AlmostSimpleCover B where
  Index := s
  factor := fun j => D.factor j
  isAlmostSimple := fun j => D.isAlmostSimple j
  mul := fac
  quasiCompact := h.quasiCompact
  flat := h.flat
  surjective := h.surjective
  isClosedSubgroup := fun j =>
    IsClosedSubgroup.of_comp h.isClosedSubgroup (by
      rw [h.factor_comp j]
      exact D.isClosedSubgroup_inclusion j)

theorem subcover_inclusion_comp (j : s) : h.subcover.inclusion j ≫ b = D.inclusion j :=
  h.factor_comp j

/-- Each selected factor is a minimal nontrivial smooth connected closed normal subgroup of
the image. -/
theorem exists_isMinimalNormalSmooth (hG : IsSemisimple G) {i : D.Index} (hi : i ∈ s) :
    ∃ c : D.factor i ⟶ B, c ≫ b = D.inclusion i ∧ IsMinimalNormalSmooth c :=
  ⟨h.subcover.inclusion ⟨i, hi⟩, h.subcover_inclusion_comp ⟨i, hi⟩,
    h.subcover.isMinimalNormalSmooth_inclusion (h.isSemisimple hG) ⟨i, hi⟩⟩

/-- Every minimal nontrivial smooth connected closed normal subgroup of the image is a
selected factor. -/
theorem exists_range_eq_of_isMinimalNormalSmooth (hG : IsSemisimple G) (n : K ⟶ B)
    (hn : IsMinimalNormalSmooth n) :
    ∃ i ∈ s, SubgroupFunctor.range (n ≫ b) = SubgroupFunctor.range (D.inclusion i) := by
  obtain ⟨⟨j, hjs⟩, hj⟩ := h.subcover.exists_range_eq_inclusion (h.isSemisimple hG) n hn
  refine ⟨j, hjs, ?_⟩
  rw [range_comp_eq_of_range_eq b hj]
  exact congrArg SubgroupFunctor.range (h.subcover_inclusion_comp ⟨j, hjs⟩)

/-- The selected set is determined by the range of the image. -/
theorem support_eq (hG : IsSemisimple G) {n : K ⟶ G}
    (hn : SubgroupFunctor.range n = SubgroupFunctor.range b) : D.support n = s := by
  ext i
  rw [mem_support, hn, ← h.mem_iff hG]

/-- A smooth connected closed normal subgroup is the image of the subproduct of the factors it
contains. -/
theorem range_eq_of_support (hG : IsSemisimple G) {n : K ⟶ G} (hn : IsNormalSmooth n)
    (hs : s = D.support n) : SubgroupFunctor.range n = SubgroupFunctor.range b := by
  refine le_antisymm ?_ (h.range_le_of_isClosedSubgroup hn.1 fun i hi => by
    rw [hs] at hi
    exact hi)
  have hc := hn.1
  have : Smooth K.X.hom := hn.2.1
  have : ConnectedSpace K.X.left := hn.2.2.1
  have hnor := hn.2.2.2
  have hK : IsSemisimple K := hG.of_normalSubgroup n hc hnor
  have hperf : derivedSubgroup K = ⊤ := semisimplePerfect k K hK
  have := h.mono
  have hJc : SubgroupFunctor.range (piSubsetInclusionHom D.factor sᶜ ≫ D.mul) ≤
      commutant (SubgroupFunctor.range n) :=
    (range_piSubsetInclusionHom_comp_le_iff D.factor D.mul sᶜ _).2
      fun i hi => D.range_le_commutant_of_notMem_support hG hn (hs ▸ hi)
  have hJJc : SubgroupFunctor.range (piSubsetInclusionHom D.factor sᶜ ≫ D.mul) ≤
      commutant (SubgroupFunctor.range (piSubsetInclusionHom D.factor s ≫ D.mul)) := by
    apply (range_piSubsetInclusionHom_comp_le_iff D.factor D.mul sᶜ _).2
    intro i hi
    apply le_commutant_comm
    apply (range_piSubsetInclusionHom_comp_le_iff D.factor D.mul s _).2
    intro j hj
    exact D.range_inclusion_le_commutant fun hji => hi (hji ▸ hj)
  have hJb : SubgroupFunctor.range (piSubsetInclusionHom D.factor s ≫ D.mul) ≤
      SubgroupFunctor.range b := by
    rw [← h.fac_comp]
    exact range_comp_le_range fac b
  apply range_le_of_derivedSubgroup_eq_top n hperf b h.isClosedSubgroup
  intro T x y
  obtain ⟨W₁, w₁, u₁, q₁, f₁, s₁, h₁⟩ := exists_refinement_lift D.mul.hom.hom (x ≫ n.hom.hom)
  obtain ⟨W₂, w₂, u₂, q₂, f₂, s₂, h₂⟩ :=
    exists_refinement_lift D.mul.hom.hom (w₁ ≫ y ≫ n.hom.hom)
  have := effectiveEpi_comp_left w₁ w₂
  apply SubgroupFunctor.mem_range_of_comp_mem_range b (w₂ ≫ w₁)
  obtain ⟨a₁, c₁, e₁, ha₁, hc₁⟩ := exists_mul_mem_range_piSubset D.factor D.mul s (w₂ ≫ u₁)
  obtain ⟨a₂, c₂, e₂, ha₂, hc₂⟩ := exists_mul_mem_range_piSubset D.factor D.mul s u₂
  have hg : (w₂ ≫ w₁) ≫ x ≫ n.hom.hom = a₁ * c₁ := by
    rw [Category.assoc, h₁, ← Category.assoc, e₁]
  have hh : (w₂ ≫ w₁) ≫ y ≫ n.hom.hom = a₂ * c₂ := by
    rw [Category.assoc, h₂, e₂]
  have hexp : (w₂ ≫ w₁) ≫ (x * y * x⁻¹ * y⁻¹) ≫ n.hom.hom =
      a₁ * c₁ * (a₂ * c₂) * (a₁ * c₁)⁻¹ * (a₂ * c₂)⁻¹ := by
    simp only [MonObj.mul_comp, GrpObj.inv_comp, MonObj.comp_mul, GrpObj.comp_inv]
    rw [hg, hh]
  have hmem : (w₂ ≫ w₁) ≫ y ≫ n.hom.hom ∈ (SubgroupFunctor.range n).carrier W₂ :=
    SubgroupFunctor.mem_range.2 ⟨(w₂ ≫ w₁) ≫ y, Category.assoc _ _ _⟩
  rw [hh] at hmem
  rw [hexp, commutator_mul_mul_eq a₁ c₁ a₂ c₂
    (commute_of_mem_commutant (hJc W₂ hc₁) hmem)
    (commute_of_mem_commutant (hJJc W₂ hc₂) ha₁)]
  exact hJb W₂ (mul_mem (mul_mem (mul_mem ha₁ ha₂) (inv_mem ha₁)) (inv_mem ha₂))

end IsSubfamilyImage

end AlmostSimpleCover

end Langlands.GroupScheme.SimpleFactor
