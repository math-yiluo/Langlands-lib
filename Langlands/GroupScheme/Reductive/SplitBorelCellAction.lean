import Langlands.GroupScheme.Reductive.SplitBorelCell
import Langlands.GroupScheme.Rational.TorusUnipotence.StandardUnipotentAction
import Langlands.GroupScheme.Rational.TorusUnipotence.PositiveWeightCoordinates

/-! # The torus action on the positive unipotent subgroup of a split pinning -/

set_option backward.isDefEq.respectTransparency false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme
namespace SplitPinning

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (p : SplitPinning G)

/-! ### Positive roots -/

/-- A positive root of the supplied base is a nonnegative integral combination of
simple roots. -/
theorem root_mem_positiveRootMonoid {i : p.rootIndex} (hi : p.base.IsPos i) :
    p.rootDatum.root i ∈ p.positiveRootMonoid := by
  classical
  obtain ⟨f, -, hf | hf⟩ := p.base.exists_root_eq_sum_nat_or_neg i
  · rw [hf]
    exact AddSubmonoid.sum_mem _ fun j hj =>
      AddSubmonoid.nsmul_mem _ (p.simpleRoot_mem_positiveRootMonoid ⟨j, hj⟩) _
  · exfalso
    have hh : p.base.height i = ∑ j ∈ p.base.support, -(f j : ℤ) := by
      apply RootPairing.Base.height_eq_sum
      rw [hf, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [neg_smul, natCast_zsmul]
    have hle : p.base.height i ≤ 0 := by
      rw [hh]
      exact Finset.sum_nonpos fun j _ => neg_nonpos.mpr (Int.natCast_nonneg _)
    exact absurd hi (by rw [RootPairing.Base.isPos_iff]; omega)

/-- A relative root pairing positively with the chosen positive cocharacter lies in
the monoid generated by the simple roots. -/
theorem mem_positiveRootMonoid_of_mem_positiveRelativeRoots {χ : characterLattice p.torus}
    (hχ : χ ∈ positiveRelativeRoots p.inclusion p.positiveCocharacter) :
    χ ∈ p.positiveRootMonoid := by
  obtain ⟨i, rfl⟩ : ∃ i, p.rootDatum.root i = χ := by
    rw [← Set.mem_range, p.isRootDatum.2.1]
    exact hχ.1
  exact p.root_mem_positiveRootMonoid
    ((p.latticePairing_root_positiveCocharacter_pos_iff i).mp hχ.2)

/-! ### The conjugation action on the positive unipotent subgroup -/

/-- The conjugation action of the supplied torus on the positive unipotent subgroup. -/
def positiveUnipotentAction : AutomorphicAction p.torus.toGrp p.positiveUnipotent :=
  (AutomorphicAction.conjugation p.inclusion).onRepresentedSubgroup p.positiveUnipotentHom
    p.isRepresentedBy_positiveUnipotentHom
    (Dynamic.unipotent_isStable_conjugation p.inclusion
      (CommGroupScheme.groupHom p.positiveCocharacter))

/-- The inclusion of the positive unipotent subgroup intertwines the action with
conjugation in `G`. -/
theorem positiveUnipotentAction_act_comp {T : Over (Spec (CommRingCat.of k))}
    (s : T ⟶ p.torus.X) (x : T ⟶ p.positiveUnipotent.X) :
    p.positiveUnipotentAction.act s x ≫ p.positiveUnipotentHom.hom.hom =
      (s ≫ p.inclusion.hom.hom) * (x ≫ p.positiveUnipotentHom.hom.hom) *
        (s ≫ p.inclusion.hom.hom)⁻¹ := by
  rw [positiveUnipotentAction, AutomorphicAction.onRepresentedSubgroup_act_comp,
    AutomorphicAction.conjugation_act]

/-- The inclusion of the positive unipotent subgroup is equivariant for the action
and for conjugation in `G`. -/
theorem isEquivariant_positiveUnipotentHom :
    CoordinateWeights.IsEquivariant p.positiveUnipotentAction
      (AutomorphicAction.conjugation p.inclusion) p.positiveUnipotentHom.hom.hom :=
  CoordinateWeights.represented_inclusion_equivariant _ _ _ _

theorem smooth_positiveUnipotent : Smooth p.positiveUnipotent.X.hom := by
  have := p.isConnectedReductive.smooth
  exact (dynamicSmooth k G p.positiveGm _ _).2.2 p.isRepresentedBy_positiveUnipotentHom

theorem connectedSpace_positiveUnipotent : ConnectedSpace p.positiveUnipotent.X.left :=
  DynamicConnected.connectedSpace_of_isRepresentedBy_unipotent G p.positiveGm
    p.isRepresentedBy_positiveUnipotentHom

/-! ### Lie and coordinate weights -/

/-- The Lie weights of the action are the relative roots pairing positively with the
chosen positive cocharacter. -/
theorem actionWeightSpace_positiveUnipotentAction_ne_bot_iff (χ : characterLattice p.torus) :
    RelativeRoot.actionWeightSpace p.positiveUnipotentAction χ ≠ ⊥ ↔
      χ ∈ positiveRelativeRoots p.inclusion p.positiveCocharacter := by
  have := p.isConnectedReductive.smooth
  rw [positiveUnipotentAction, ← RelativeRoot.mem_actionWeightSupport_iff_onRepresentedSubgroup]
  exact Set.ext_iff.mp (Standard.actionWeightSupport_dynamicUnipotent p.inclusion
    p.positiveCocharacter p.isSplitTorus) χ

/-- The augmentation weights of the action form the additive semigroup generated by
the relative roots pairing positively with the chosen positive cocharacter. -/
theorem support_positiveUnipotentAction :
    CoordinateWeights.support p.positiveUnipotentAction =
      (AddSubsemigroup.closure (positiveRelativeRoots p.inclusion p.positiveCocharacter) :
        Set (characterLattice p.torus)) := by
  rw [CoordinateWeights.coordinateSemigroupComparison.1 k p.positiveUnipotent
    p.smooth_positiveUnipotent inferInstance p.connectedSpace_positiveUnipotent p.torus
    p.isSplitTorus p.positiveUnipotentAction, RelativeRoot.actionWeightSupport_top]
  congr 2
  ext χ
  exact p.actionWeightSpace_positiveUnipotentAction_ne_bot_iff χ

variable {p} in
/-- Every augmentation weight of the action lies in the monoid generated by the simple
roots. -/
theorem mem_positiveRootMonoid_of_mem_support {χ : characterLattice p.torus}
    (hχ : χ ∈ CoordinateWeights.support p.positiveUnipotentAction) :
    χ ∈ p.positiveRootMonoid := by
  rw [support_positiveUnipotentAction] at hχ
  refine AddSubsemigroup.closure_induction (fun x hx => ?_) (fun x y _ _ hx hy => ?_) hχ
  · exact p.mem_positiveRootMonoid_of_mem_positiveRelativeRoots hx
  · exact add_mem hx hy

variable {p} in
/-- Every augmentation weight of the action pairs positively with the chosen positive
cocharacter. -/
theorem latticePairing_pos_of_mem_support {χ : characterLattice p.torus}
    (hχ : χ ∈ CoordinateWeights.support p.positiveUnipotentAction) :
    0 < latticePairing p.torus χ p.positiveCocharacter := by
  rw [support_positiveUnipotentAction] at hχ
  refine AddSubsemigroup.closure_induction (fun x hx => hx.2) (fun x y _ _ hx hy => ?_) hχ
  rw [map_add, LinearMap.add_apply]
  exact add_pos hx hy

/-- The zero character is not an augmentation weight of the action. -/
theorem zero_notMem_support :
    (0 : characterLattice p.torus) ∉ CoordinateWeights.support p.positiveUnipotentAction :=
  fun h => by simpa using latticePairing_pos_of_mem_support h

/-- The coordinates of weight zero for the action are the constants. -/
theorem weightSpace_zero_positiveUnipotentAction :
    CoordinateWeights.weightSpace p.positiveUnipotentAction 0 =
      LinearMap.range (Algebra.linearMap k (CharacterUnits.Coord p.positiveUnipotent)) :=
  TorusUnipotence.weightSpace_zero_eq _ p.zero_notMem_support

variable {p} in
/-- The weight of every nonzero eigenfunction for the action lies in the monoid
generated by the simple roots. -/
theorem mem_positiveRootMonoid_of_mem_weightSpace {χ : characterLattice p.torus}
    {f : CharacterUnits.Coord p.positiveUnipotent}
    (hf : f ∈ CoordinateWeights.weightSpace p.positiveUnipotentAction χ) (hf0 : f ≠ 0) :
    χ ∈ p.positiveRootMonoid := by
  by_cases hχ : χ = 0
  · rw [hχ]
    exact zero_mem _
  · exact mem_positiveRootMonoid_of_mem_support
      (TorusUnipotence.mem_support_of_mem_weightSpace p.isSplitTorus _ hχ hf hf0)

end SplitPinning
end Langlands.GroupScheme
