import Langlands.GroupScheme.Reductive.SplitIsogenySimpleGraph
import Langlands.GroupScheme.Reductive.SplitLeviGluingGraphGeneration

/-! # Source root cells and generation of local-isogeny graphs -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise

namespace Langlands.GroupScheme.RootDatumIsogenyRealization

variable {k : Type u} [Field k]
    {G G' : GroupScheme (Spec (CommRingCat.of k))}
    {T T' : CommGroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom] [Smooth G.X.hom]
    [IsAffineHom G'.X.hom]
    {i : T.toGrp ⟶ G} {i' : T'.toGrp ⟶ G'} {t : T ⟶ T'}

namespace SimpleIsogenyGraph

variable (D : SimpleIsogenyGraph i i' t)

/-- The distinguished source torus and both source simple-root representatives. -/
abbrev rootFamilySources : Option (Sum D.SimpleIndex D.SimpleIndex) →
    GroupScheme (Spec (CommRingCat.of k))
  | none => T.toGrp
  | some (.inl a) => D.positiveGroup a
  | some (.inr a) => D.negativeGroup a

/-- Their actual maps into the local-isogeny graph. -/
def rootFamilyMaps : ∀ j, D.rootFamilySources j ⟶ D.envelope.group
  | none => D.envelope.torusLift
  | some (.inl a) => D.positiveHom a
  | some (.inr a) => D.negativeHom a

theorem rootFamily_geometry (j : Option (Sum D.SimpleIndex D.SimpleIndex)) :
    Smooth (D.rootFamilySources j).X.hom ∧
      IsAffineHom (D.rootFamilySources j).X.hom ∧
        ConnectedSpace (D.rootFamilySources j).X.left := by
  rcases j with _ | (a | a)
  · exact ⟨D.split.smooth, D.split.isAffineHom, D.split.connectedSpace⟩
  · exact ⟨inferInstance, inferInstance, inferInstance⟩
  · exact ⟨inferInstance, inferInstance, inferInstance⟩

/-- The actual rational subgroup generated by the source root and torus lifts. -/
def rootFamilyRationalPoints :
    Subgroup (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ D.envelope.group.X) :=
  LeviGluing.generatedRationalPoints D.envelope.group D.rootFamilySources D.rootFamilyMaps

variable [ConnectedSpace G.X.left]
    {J : Type v}
    (P : RootDatum J (characterLattice T) (cocharacterLattice T))
    (hP : IsRootDatumOf i P)

omit [IsAffineHom G'.X.hom] in
include hP in
/-- The positive source root is the entire positive dynamic factor of its
chosen local Levi for the source chamber. -/
theorem local_positive_rep (a : D.SimpleIndex) :
    (Dynamic.unipotent (CommGroupScheme.groupHom D.directions.chamber ≫
      (D.comparisons a).leftTorus)).IsRepresentedBy (D.positiveRoot a).inclusion := by
  rw [LeviGluing.rankOne_unipotent_eq_positiveRoot i P hP D.directions.chamber
    D.split D.directions.generic (D.directions.direction a) (D.directions.rankOne a)
    a (D.directions.annihilates a) (D.comparisons a).leftInclusion
    (D.comparisons a).leftRep (D.comparisons a).leftTorus (D.comparisons a).leftTorusComp]
  exact (D.positiveRoot a).rep

omit [IsAffineHom G'.X.hom] in
include hP in
/-- The paired negative source root is the full opposite dynamic factor in
that same actual local Levi. -/
theorem local_negative_rep (a : D.SimpleIndex) :
    (Dynamic.unipotent (CommGroupScheme.groupHom
      (Gm.powerHom (Spec (CommRingCat.of k)) (-1)) ≫
      (CommGroupScheme.groupHom D.directions.chamber ≫
        (D.comparisons a).leftTorus))).IsRepresentedBy (D.negativeRoot a).inclusion := by
  have hneg : Gm.powerHom (Spec (CommRingCat.of k)) (-1) ≫ D.directions.chamber =
      -D.directions.chamber := by
    simp only [Gm.powerHom_apply, neg_one_zsmul, Preadditive.neg_comp, Category.id_comp]
  rw [← Category.assoc]
  change (Dynamic.unipotent (CommGroupScheme.groupHom
    (Gm.powerHom (Spec (CommRingCat.of k)) (-1) ≫ D.directions.chamber) ≫
      (D.comparisons a).leftTorus)).IsRepresentedBy _
  rw [hneg, LeviGluing.rankOne_unipotent_eq_negativeRoot i P hP D.directions.chamber
    D.split D.directions.generic (D.directions.direction a) (D.directions.rankOne a)
    a (D.directions.annihilates a) (D.comparisons a).leftInclusion
    (D.comparisons a).leftRep (D.comparisons a).leftTorus (D.comparisons a).leftTorusComp]
  exact (D.negativeRoot a).rep

variable (hi : IsClosedSubgroup i)
    (hZ : Dynamic.centralizer (CommGroupScheme.groupHom D.directions.chamber ≫ i) =
      SubgroupFunctor.range i)

omit [ConnectedSpace G.X.left] [Smooth G.X.hom] [IsAffineHom G'.X.hom] in
include hZ hi in
/-- The whole local middle factor is the distinguished source torus, on all
test schemes, once the ambient chamber centralizer is that torus. -/
theorem local_torus_rep (a : D.SimpleIndex) :
    (Dynamic.centralizer (CommGroupScheme.groupHom D.directions.chamber ≫
      (D.comparisons a).leftTorus)).IsRepresentedBy (D.comparisons a).leftTorus := by
  have htclosed := (D.comparisons a).leftTorus_closed hi
  let : IsClosedImmersion (D.comparisons a).leftTorus.hom.hom.left := htclosed
  let : Mono (D.comparisons a).leftTorus.hom.hom := Over.mono_of_mono_left _
  let : Mono (D.comparisons a).leftInclusion.hom.hom := (D.comparisons a).leftRep.1
  refine ⟨inferInstance, ?_⟩
  rw [Dynamic.centralizer_eq_comap_of_mono
    (CommGroupScheme.groupHom D.directions.chamber ≫ (D.comparisons a).leftTorus)
      (D.comparisons a).leftInclusion,
    Category.assoc, (D.comparisons a).leftTorusComp, hZ]
  apply SubgroupFunctor.ext
  intro W
  apply Subgroup.ext
  intro x
  constructor
  · intro hx
    obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
    apply SubgroupFunctor.mem_comap.mpr
    apply SubgroupFunctor.mem_range.mpr
    refine ⟨y, ?_⟩
    rw [Category.assoc, ← Grp.comp_hom_hom, (D.comparisons a).leftTorusComp]
  · intro hx
    obtain ⟨y, hy⟩ := SubgroupFunctor.mem_range.mp (SubgroupFunctor.mem_comap.mp hx)
    apply SubgroupFunctor.mem_range.mpr
    refine ⟨y, (cancel_mono (D.comparisons a).leftInclusion.hom.hom).mp ?_⟩
    rw [Category.assoc, ← Grp.comp_hom_hom, (D.comparisons a).leftTorusComp]
    exact hy

omit [IsAffineHom G'.X.hom] in
include hi hZ hP in
/-- The source root groups and source torus generate the entire graph as an
algebraic closed subgroup over every field. -/
theorem isGeneratedByRootFamily :
    IsGeneratedByFamily D.rootFamilySources D.rootFamilyMaps (𝟙 D.envelope.group) := by
  refine ⟨?_, ?_, ?_⟩
  · change IsClosedImmersion (𝟙 D.envelope.group.X.left)
    infer_instance
  · intro j
    exact ⟨(D.rootFamilyMaps j).hom.hom, by simp⟩
  · intro Q q hq hfamily
    apply D.envelope.isGeneratedByLifts.2.2 Q q hq
    rintro (_ | a)
    · exact hfamily none
    · change FactorsThrough (D.envelope.localLift a).hom.hom q
      apply LeviGluing.factorsThrough_of_contains_tripleCellImages
        (CommGroupScheme.groupHom D.directions.chamber ≫ (D.comparisons a).leftTorus)
        (D.local_negative_rep P hP a) (D.local_torus_rep hi hZ a)
        (D.local_positive_rep P hP a) (D.envelope.localLift a) q hq
      · exact (factorsThrough_hom_iff_range_le _ _).1 (hfamily (some (.inr a)))
      · rw [D.envelope.leftTorus_localLift]
        exact (factorsThrough_hom_iff_range_le _ _).1 (hfamily none)
      · exact (factorsThrough_hom_iff_range_le _ _).1 (hfamily (some (.inl a)))

include hi hZ hP in
/-- Over an algebraically closed field the generated rational subgroup is
dense in the actual graph. -/
theorem dense_rootFamilyRationalPoints [IsAlgClosed k] :
    Dense (rationalPointImage D.envelope.group
      (D.rootFamilyRationalPoints : Set _)) :=
  LeviGluing.dense_rationalPointImage_closure_of_isGeneratedByFamily D.rootFamily_geometry
    (D.isGeneratedByRootFamily P hP hi hZ)

omit [IsAffineHom G'.X.hom] in
include hi hZ hP in
/-- Every point of a local lift lies in the closure of its negative-root,
source-torus, positive-root products over an algebraically closed field. -/
theorem range_localLift_subset_rationalPointClosure [IsAlgClosed k] (a : D.SimpleIndex) :
    ((SubgroupFunctor.range (D.envelope.localLift a)).carrier (Over.mk (𝟙 _)) :
      Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ D.envelope.group.X)) ⊆
      rationalPointClosure D.envelope.group
        (LeviGluing.rationalTripleProduct
          (D.negativeHom a) D.envelope.torusLift (D.positiveHom a)) := by
  intro x hx
  obtain ⟨y, rfl⟩ := SubgroupFunctor.mem_range.mp hx
  have hy : y ∈ rationalPointClosure (D.comparisons a).left
      (LeviGluing.rationalTripleProduct (D.negativeRoot a).inclusion
        (D.comparisons a).leftTorus (D.positiveRoot a).inclusion) := by
    rw [LeviGluing.rationalPointClosure_dynamicTripleProduct_eq_univ
      (CommGroupScheme.groupHom D.directions.chamber ≫ (D.comparisons a).leftTorus)
      (D.local_negative_rep P hP a) (D.local_torus_rep hi hZ a)
      (D.local_positive_rep P hP a)]
    exact Set.mem_univ _
  apply LeviGluing.postcomp_mem_rationalPointClosure (D.envelope.localLift a).hom.hom _ hy
  intro s hs
  apply subset_rationalPointClosure
  have h := LeviGluing.postcomp_mem_rationalTripleProduct
    (D.negativeRoot a).inclusion (D.comparisons a).leftTorus
    (D.positiveRoot a).inclusion (D.envelope.localLift a) hs
  rw [D.envelope.leftTorus_localLift] at h
  exact h

omit [IsAffineHom G'.X.hom] in
include hi hZ hP in
/-- The equal-index product required by the three-factor word argument lies
in the closure of that same actual local root cell. -/
theorem positive_mul_negative_subset_rationalPointClosure [IsAlgClosed k] (a : D.SimpleIndex) :
    (((SubgroupFunctor.range (D.positiveHom a)).carrier (Over.mk (𝟙 _)) :
        Set (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ D.envelope.group.X)) *
      ((SubgroupFunctor.range (D.negativeHom a)).carrier (Over.mk (𝟙 _)) : Set _)) ⊆
      rationalPointClosure D.envelope.group
        (LeviGluing.rationalTripleProduct
          (D.negativeHom a) D.envelope.torusLift (D.positiveHom a)) := by
  rintro x ⟨y, hy, z, hz, rfl⟩
  apply D.range_localLift_subset_rationalPointClosure P hP hi hZ a
  exact ((SubgroupFunctor.range (D.envelope.localLift a)).carrier _).mul_mem
    (SubgroupFunctor.range_comp_le (D.positiveRoot a).inclusion
      (D.envelope.localLift a) _ hy)
    (SubgroupFunctor.range_comp_le (D.negativeRoot a).inclusion
      (D.envelope.localLift a) _ hz)

end SimpleIsogenyGraph

/-- The same actual source-simple graph with its proved algebraic generation
certificate. This records no target-root or dense-cell assumption. -/
structure GeneratedSimpleIsogenyGraph where
  graph : SimpleIsogenyGraph i i' t
  generated : IsGeneratedByFamily graph.rootFamilySources graph.rootFamilyMaps
    (𝟙 graph.envelope.group)

/-- Certify source-root generation from source reductivity, maximality and
the actual source root datum, with no condition on target simple systems. -/
def generatedSimpleIsogenyGraph (D : SimpleIsogenyGraph i i' t)
    (hG : IsConnectedReductive G) (hi : IsMaximalTorus i)
    {J : Type v} (P : RootDatum J (characterLattice T) (cocharacterLattice T))
    (hP : IsRootDatumOf i P) : GeneratedSimpleIsogenyGraph (i := i) (i' := i') (t := t) := by
  let : ConnectedSpace G.X.left := hG.connectedSpace
  exact ⟨D, D.isGeneratedByRootFamily P hP hi.2.1
    (LocalIsogenyGraphEnvelope.chamber_centralizer_eq_range hG D.split hi
      D.directions.chamber D.directions.generic)⟩

end Langlands.GroupScheme.RootDatumIsogenyRealization
