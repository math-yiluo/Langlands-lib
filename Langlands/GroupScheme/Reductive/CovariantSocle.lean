import Langlands.GroupScheme.Reductive.CovariantUnipotentFixedLine

/-! # The least nonzero covariant regular subspace -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Opposite Module
open scoped Matrix CategoryTheory.MonObj

namespace Langlands.GroupScheme.Chevalley

open AffineCoordinates AffineLinearEmbedding MatrixRepresentation

section Coalgebra

variable {K B : Type*} [Field K] [AddCommGroup B] [Module K B] [Coalgebra K B]

/-- A right-stable subspace containing a finite family contains its regular span. -/
theorem regularSpan_le_of_rightAct_mem (S : Finset B) (W : Submodule K B)
    (hS : (S : Set B) ⊆ W)
    (hW : ∀ (ψ : Module.Dual K B) (w : B), w ∈ W → rightAct ψ w ∈ W) :
    regularSpan (K := K) S ≤ W := by
  rw [regularSpan, Submodule.span_le]
  rintro _ ⟨⟨w, ψ⟩, rfl⟩
  exact hW ψ w (hS w.2)

end Coalgebra

variable {k : Type u} [Field k]
  (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom]

local instance : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom

/-- The finite regular subspace generated by one actual affine coordinate.
Under the product-cell and invariance hypotheses below, it is the covariant socle. -/
def affineCovariantSocle (f : algebra G) : Submodule k (algebra G) :=
  letI := (bialgebra (corepresentation G)).toCoalgebra
  regularSpan {f}

instance finite_affineCovariantSocle (f : algebra G) :
    Module.Finite k (affineCovariantSocle G f) := by
  let := (bialgebra (corepresentation G)).toCoalgebra
  exact finite_regularSpan {f}

theorem mem_affineCovariantSocle (f : algebra G) :
    f ∈ affineCovariantSocle G f := by
  let := (bialgebra (corepresentation G)).toCoalgebra
  exact subset_regularSpan {f} (Finset.mem_singleton_self f)

theorem rightAct_mem_affineCovariantSocle (f : algebra G) :
    letI := (bialgebra (corepresentation G)).toCoalgebra
    ∀ (ψ : Module.Dual k (algebra G)) (w : algebra G),
      w ∈ affineCovariantSocle G f → rightAct ψ w ∈ affineCovariantSocle G f := by
  let := (bialgebra (corepresentation G)).toCoalgebra
  exact fun ψ _ hw => rightAct_mem_regularSpan {f} ψ hw

theorem affineCovariantSocle_ne_bot {f : algebra G}
    (hf1 : counit (corepresentation G) f = 1) :
    affineCovariantSocle G f ≠ ⊥ := by
  intro he
  have hf0 : f = 0 := by
    have hm := mem_affineCovariantSocle G f
    rwa [he, Submodule.mem_bot] at hm
  rw [hf0, map_zero] at hf1
  exact zero_ne_one hf1

variable {H U : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom H.X.hom]

local instance : IsAffine H.X.left := isAffine_of_isAffineHom H.X.hom

theorem affineCovariantSocle_le_leftCovariantSubspace
    (i : H ⟶ G) (χ : algebra H) {f : algebra G}
    (hf : f ∈ AffineCoordinates.leftCovariantSubspace i χ) :
    affineCovariantSocle G f ≤ AffineCoordinates.leftCovariantSubspace i χ := by
  let := (bialgebra (corepresentation G)).toCoalgebra
  apply regularSpan_le_leftCovariantSubspace _ χ {f}
  intro w hw
  obtain rfl := Finset.mem_singleton.mp hw
  exact hf

/-- No finite-dimensionality hypothesis on W is needed: the regular span of a
nonzero coordinate gives a finite nonzero regular subspace inside it. -/
theorem normalized_covariant_mem_of_rightAct_mem
    (i : H ⟶ G) (j : U ⟶ G) (hU : IsUnipotent U) (χ : algebra H)
    (W : Submodule k (algebra G))
    (hW : letI := (bialgebra (corepresentation G)).toCoalgebra
      ∀ (ψ : Module.Dual k (algebra G)) (w : algebra G),
        w ∈ W → rightAct ψ w ∈ W)
    (hcov : W ≤ AffineCoordinates.leftCovariantSubspace i χ) (hW0 : W ≠ ⊥)
    {q f : algebra G} (hq : q ∈ nonZeroDivisors (algebra G))
    (hcell : ∀ (T : Over (Spec (CommRingCat.of k))) (g : T ⟶ G.X),
      IsUnit (pointAlgebraHom G T g q) →
        ∃ (a : T ⟶ H.X) (u : T ⟶ U.X),
          g = (a ≫ i.hom.hom) * (u ≫ j.hom.hom))
    (hf : f ∈ AffineCoordinates.leftCovariantSubspace i χ)
    (hfU : f ∈ rightInvariantSubspace j)
    (hf1 : counit (corepresentation G) f = 1) :
    f ∈ W := by
  classical
  let := (bialgebra (corepresentation G)).toCoalgebra
  obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW0
  let V := affineCovariantSocle G w
  have hVW : V ≤ W := by
    apply regularSpan_le_of_rightAct_mem {w} W _ hW
    intro z hz
    obtain rfl := Finset.mem_singleton.mp hz
    exact hw
  have hV0 : V ≠ ⊥ := by
    intro he
    apply hw0
    have hm := mem_affineCovariantSocle G w
    rwa [show affineCovariantSocle G w = ⊥ from he, Submodule.mem_bot] at hm
  let b := Module.finBasis k V
  obtain ⟨v, hv, -, -⟩ :=
    affineRegularRepresentation_exists_fixedVector_of_normalized_covariant G V b
      (rightAct_mem_affineCovariantSocle G w) i j hU χ (hVW.trans hcov) hV0
      hq hcell hf hfU hf1
  rw [← hv]
  exact hVW (affineRegularCoordinateMap_mem G V b v)

/-- The constructed finite subspace is contained in every nonzero covariant
regular subspace. This does not identify it with the entire covariant space. -/
theorem affineCovariantSocle_le_of_nonzero_rightAct_mem
    (i : H ⟶ G) (j : U ⟶ G) (hU : IsUnipotent U) (χ : algebra H)
    (W : Submodule k (algebra G))
    (hW : letI := (bialgebra (corepresentation G)).toCoalgebra
      ∀ (ψ : Module.Dual k (algebra G)) (w : algebra G),
        w ∈ W → rightAct ψ w ∈ W)
    (hcov : W ≤ AffineCoordinates.leftCovariantSubspace i χ) (hW0 : W ≠ ⊥)
    {q f : algebra G} (hq : q ∈ nonZeroDivisors (algebra G))
    (hcell : ∀ (T : Over (Spec (CommRingCat.of k))) (g : T ⟶ G.X),
      IsUnit (pointAlgebraHom G T g q) →
        ∃ (a : T ⟶ H.X) (u : T ⟶ U.X),
          g = (a ≫ i.hom.hom) * (u ≫ j.hom.hom))
    (hf : f ∈ AffineCoordinates.leftCovariantSubspace i χ)
    (hfU : f ∈ rightInvariantSubspace j)
    (hf1 : counit (corepresentation G) f = 1) :
    affineCovariantSocle G f ≤ W := by
  let := (bialgebra (corepresentation G)).toCoalgebra
  apply regularSpan_le_of_rightAct_mem {f} W _ hW
  intro w hw
  have he : w = f := Finset.mem_singleton.mp hw
  rw [he]
  exact normalized_covariant_mem_of_rightAct_mem G i j hU χ W hW hcov hW0
    hq hcell hf hfU hf1

end Langlands.GroupScheme.Chevalley
