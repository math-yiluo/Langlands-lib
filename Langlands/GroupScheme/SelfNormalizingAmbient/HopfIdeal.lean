import Langlands.GroupScheme.SelfNormalizingAmbient.Stabilizer
import Mathlib.RingTheory.Flat.Basic

/-! # Subgroups of flat groups with domain fibres containing a neighbourhood of the unit

Let `F` be a group-valued functor on commutative `R`-algebras corepresented by `C`, with `C`
flat over `R` and every fibre `K ⊗[R] C` over a field `K` an integral domain. Over an
`R`-algebra `S`, an ideal `L` of `S ⊗[R] C` whose points form a multiplicatively closed family
and which is killed by an element `f` with counit `1` is zero.
-/

noncomputable section

universe u

open CategoryTheory
open scoped TensorProduct
open Algebra.TensorProduct (includeLeft includeRight)

namespace Langlands.GroupScheme.Corepresented

/-- Flatness of `C'` turns a relation `g * (l ⊗ 1) = 0` into membership of `g` in the ideal
generated by the annihilator of `l`. -/
theorem mem_map_annihilator_of_mul_eq_zero {R D C' : Type u} [CommRing R] [CommRing D]
    [CommRing C'] [Algebra R D] [Algebra R C'] [Module.Flat R C'] {l : D}
    {g : D ⊗[R] C'} (h : g * (l ⊗ₜ[R] (1 : C')) = 0) :
    g ∈ (Submodule.span D {l}).annihilator.map (includeLeft : D →ₐ[R] D ⊗[R] C') := by
  let μ : D →ₗ[R] D := LinearMap.mulRight R l
  have hμ : ∀ x : D ⊗[R] C', μ.rTensor C' x = x * (l ⊗ₜ[R] (1 : C')) := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul a c =>
      rw [LinearMap.rTensor_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      rfl
    | add x y hx hy => rw [map_add, add_mul, hx, hy]
  have hex := Module.Flat.rTensor_exact C' (LinearMap.exact_subtype_ker_map μ)
  obtain ⟨y, rfl⟩ := (hex g).1 (by rw [hμ, h])
  clear h hex
  induction y using TensorProduct.inductionOn with
  | tmul a c =>
    rw [LinearMap.rTensor_tmul, Submodule.subtype_apply]
    have ha : (a : D) ∈ (Submodule.span D {l}).annihilator := by
      rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]
      exact a.2
    have hac : (a : D) ⊗ₜ[R] c =
        (includeLeft : D →ₐ[R] D ⊗[R] C') (a : D) * ((1 : D) ⊗ₜ[R] c) := by
      rw [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        one_mul]
    rw [hac]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ha)
  | add x y hx hy => rw [map_add]; exact add_mem hx hy

/-- If `a` kills an ideal `L`, then its image kills the extension of `L`. -/
theorem mul_eq_zero_of_mem_map {A B G : Type u} [CommRing A] [CommRing B] [FunLike G A B]
    [RingHomClass G A B] (g : G) {L : Ideal A} {a : A} (h : ∀ l ∈ L, a * l = 0) {y : B}
    (hy : y ∈ L.map g) :
    g a * y = 0 := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
  · rintro _ ⟨l, hl, rfl⟩
    rw [← map_mul, h l hl, map_zero]
  · exact mul_zero _
  · intro x y _ _ hx hy
    rw [mul_add, hx, hy, add_zero]
  · intro r x _ hx
    rw [smul_eq_mul, mul_left_comm, hx, mul_zero]

variable {R : CommRingCat.{u}} {F : CommAlgCat.{u} R ⥤ GrpCat.{u}} {C : CommAlgCat.{u} R}
  (e : (F ⋙ forget GrpCat).CorepresentableBy C)

/-- The algebra map `S ⊗[R] C ⟶ T` that is `s` on `S` and the classifying map of `x ∈ F T`
on `C`. -/
def tensorPairMap {S T : CommAlgCat.{u} R} (s : S ⟶ T) (x : F.obj T) :
    CommAlgCat.of R (S ⊗[R] C) ⟶ T :=
  CommAlgCat.ofHom (Algebra.TensorProduct.lift s.hom (e.homEquiv.symm x).hom
    fun _ _ => Commute.all _ _)

variable {e}

@[simp]
theorem tensorPairMap_tmul {S T : CommAlgCat.{u} R} (s : S ⟶ T) (x : F.obj T) (a : S) (c : C) :
    (tensorPairMap e s x).hom (a ⊗ₜ c) = s.hom a * (e.homEquiv.symm x).hom c := by
  simp only [tensorPairMap, CommAlgCat.hom_ofHom, Algebra.TensorProduct.lift_tmul]

/-- Two algebra maps out of `S ⊗[R] C` agree once they agree on `S` and on `C`. -/
theorem tensor_hom_ext {S T : CommAlgCat.{u} R} {φ ψ : CommAlgCat.of R (S ⊗[R] C) ⟶ T}
    (h₁ : ∀ a : S, φ.hom (a ⊗ₜ 1) = ψ.hom (a ⊗ₜ 1))
    (h₂ : ∀ c : C, φ.hom (1 ⊗ₜ c) = ψ.hom (1 ⊗ₜ c)) : φ = ψ := by
  apply CommAlgCat.hom_ext
  apply Algebra.TensorProduct.ext'
  intro a c
  have hac : a ⊗ₜ[R] c = (a ⊗ₜ[R] (1 : C)) * ((1 : S) ⊗ₜ[R] c) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  rw [hac, map_mul, map_mul, h₁, h₂]

theorem tensorPairMap_comp {S T T' : CommAlgCat.{u} R} (s : S ⟶ T) (x : F.obj T) (h : T ⟶ T') :
    tensorPairMap e s x ≫ h = tensorPairMap e (s ≫ h) (F.map h x) := by
  apply tensor_hom_ext
  · intro a
    rw [CommAlgCat.hom_comp, AlgHom.comp_apply, tensorPairMap_tmul, tensorPairMap_tmul]
    simp only [homEquiv_symm_map, map_one, mul_one, CommAlgCat.hom_comp, AlgHom.comp_apply]
  · intro c
    rw [CommAlgCat.hom_comp, AlgHom.comp_apply, tensorPairMap_tmul, tensorPairMap_tmul]
    simp only [homEquiv_symm_map, map_one, one_mul, CommAlgCat.hom_comp, AlgHom.comp_apply]

/-- **An ideal of a flat group with domain fibres that cuts out a multiplicatively closed family
of points and is killed by an element with counit `1` is zero.** -/
theorem eq_bot_of_mul_closed [Module.Flat R C]
    (hdom : ∀ (K : Type u) [Field K] [Algebra R K], IsDomain (K ⊗[R] C))
    {S : CommAlgCat.{u} R} (L : Ideal (S ⊗[R] C))
    (hL : ∀ (T : CommAlgCat.{u} R) (s : S ⟶ T) (x y : F.obj T),
      (∀ l ∈ L, (tensorPairMap e s x).hom l = 0) → (∀ l ∈ L, (tensorPairMap e s y).hom l = 0) →
        ∀ l ∈ L, (tensorPairMap e s (x * y)).hom l = 0)
    {f : S ⊗[R] C} (hf : (tensorPairMap e (𝟙 S) 1).hom f = 1) (hfL : ∀ l ∈ L, f * l = 0) :
    L = ⊥ := by
  classical
  have hcomp {T T' : CommAlgCat.{u} R} (f : C ⟶ T) (g : T ⟶ T') :
      e.homEquiv (f ≫ g) = F.map g (e.homEquiv f) :=
    LinearEmbedding.pt_comp e f g
  let D : CommAlgCat.{u} R := CommAlgCat.of R (S ⊗[R] C)
  let E : CommAlgCat.{u} R := CommAlgCat.of R ((S ⊗[R] C) ⊗[R] C)
  let ι₁ : D ⟶ E := CommAlgCat.ofHom includeLeft
  let jS : S ⟶ D := CommAlgCat.ofHom includeLeft
  let jC : C ⟶ D := CommAlgCat.ofHom includeRight
  let jE : C ⟶ E := CommAlgCat.ofHom includeRight
  let sE : S ⟶ E := jS ≫ ι₁
  let P₁ : F.obj E := e.homEquiv (jC ≫ ι₁)
  let P₂ : F.obj E := e.homEquiv jE
  let Δ : D ⟶ E := tensorPairMap e sE (P₁ * P₂)
  let φ : D ⟶ E := tensorPairMap e sE (P₁ * P₂⁻¹)
  let ι₂ : D ⟶ E := tensorPairMap e sE P₂
  have hι₁ : tensorPairMap e sE P₁ = ι₁ := by
    apply tensor_hom_ext
    · intro a
      rw [tensorPairMap_tmul, map_one, mul_one]
      rfl
    · intro c
      rw [tensorPairMap_tmul, map_one, one_mul]
      change (e.homEquiv.symm (e.homEquiv (jC ≫ ι₁))).hom c = _
      rw [Equiv.symm_apply_apply]
      rfl
  -- the shear `σ`, classifying `(p₁, p₂) ↦ (p₁ p₂⁻¹, p₂)`
  let σ : E ⟶ E := CommAlgCat.ofHom
    (Algebra.TensorProduct.lift φ.hom jE.hom fun _ _ => Commute.all _ _)
  have hσ₁ : ∀ d, σ.hom (ι₁.hom d) = φ.hom d := by
    intro d
    simp [D, E, σ, ι₁, Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.lift_tmul]
  have hσE : jE ≫ σ = jE := by
    apply CommAlgCat.hom_ext
    ext c
    simp [D, E, σ, jE, Algebra.TensorProduct.includeRight_apply]
  have hsE : sE ≫ σ = sE := by
    apply CommAlgCat.hom_ext
    ext a
    rw [CommAlgCat.hom_comp, AlgHom.comp_apply]
    change σ.hom (ι₁.hom (jS.hom a)) = _
    rw [hσ₁]
    change (tensorPairMap e sE (P₁ * P₂⁻¹)).hom (a ⊗ₜ 1) = _
    rw [tensorPairMap_tmul, map_one, mul_one]
  have hP₁ : F.map σ P₁ = P₁ * P₂⁻¹ := by
    change F.map σ (e.homEquiv (jC ≫ ι₁)) = _
    rw [← hcomp]
    have : (jC ≫ ι₁) ≫ σ = jC ≫ φ := by
      apply CommAlgCat.hom_ext
      ext c
      simp only [CommAlgCat.hom_comp, AlgHom.comp_apply]
      exact hσ₁ _
    rw [this]
    have h' : jC ≫ φ = e.homEquiv.symm (P₁ * P₂⁻¹) := by
      apply CommAlgCat.hom_ext
      ext c
      change (tensorPairMap e sE (P₁ * P₂⁻¹)).hom (1 ⊗ₜ c) = _
      rw [tensorPairMap_tmul, map_one, one_mul]
    rw [h', Equiv.apply_symm_apply]
  have hP₂ : F.map σ P₂ = P₂ := by
    change F.map σ (e.homEquiv jE) = e.homEquiv jE
    rw [← hcomp, hσE]
  have hΔσ : Δ ≫ σ = ι₁ := by
    rw [tensorPairMap_comp, hsE, map_mul, hP₁, hP₂, inv_mul_cancel_right, hι₁]
  have hι₂σ : ι₂ ≫ σ = ι₂ := by
    rw [tensorPairMap_comp, hsE, hP₂]
  -- the comultiplication of an element of `L` lies in the ideal generated by both copies of `L`
  have hΔ : ∀ l ∈ L, Δ.hom l ∈ L.map ι₁.hom ⊔ L.map ι₂.hom := by
    intro l hl
    set N : Ideal E := L.map ι₁.hom ⊔ L.map ι₂.hom
    let π : E ⟶ CommAlgCat.of R (E ⧸ N) := CommAlgCat.ofHom (Ideal.Quotient.mkₐ R N)
    have h₁ : ∀ l ∈ L, (tensorPairMap e (sE ≫ π) (F.map π P₁)).hom l = 0 := by
      intro l hl
      rw [← tensorPairMap_comp, hι₁, CommAlgCat.hom_comp, AlgHom.comp_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hl))
    have h₂ : ∀ l ∈ L, (tensorPairMap e (sE ≫ π) (F.map π P₂)).hom l = 0 := by
      intro l hl
      rw [← tensorPairMap_comp, CommAlgCat.hom_comp, AlgHom.comp_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hl))
    have h := hL _ (sE ≫ π) _ _ h₁ h₂ l hl
    rw [← map_mul, ← tensorPairMap_comp, CommAlgCat.hom_comp, AlgHom.comp_apply] at h
    exact Ideal.Quotient.eq_zero_iff_mem.1 h
  have hkill : ∀ l ∈ L, ι₁.hom f * ι₂.hom f * Δ.hom l = 0 := by
    intro l hl
    obtain ⟨y₁, hy₁, y₂, hy₂, hy⟩ := Submodule.mem_sup.1 (hΔ l hl)
    have e₁ := mul_eq_zero_of_mem_map ι₁.hom hfL hy₁
    have e₂ := mul_eq_zero_of_mem_map ι₂.hom hfL hy₂
    rw [← hy]
    linear_combination ι₂.hom f * e₁ + ι₁.hom f * e₂
  -- after the shear: `φ f * ι₂ f * (l ⊗ 1) = 0`
  have hkill' : ∀ l ∈ L, φ.hom f * ι₂.hom f * (l ⊗ₜ[R] (1 : C)) = 0 := by
    intro l hl
    have h := congrArg σ.hom (hkill l hl)
    have hΔ' : σ.hom (Δ.hom l) = ι₁.hom l := by
      rw [← AlgHom.comp_apply, ← CommAlgCat.hom_comp, hΔσ]
    have hι₂' : σ.hom (ι₂.hom f) = ι₂.hom f := by
      rw [← AlgHom.comp_apply, ← CommAlgCat.hom_comp, hι₂σ]
    rw [map_mul, map_mul, hσ₁, hι₂', hΔ', map_zero] at h
    exact h
  by_contra hne
  obtain ⟨l, hl, hl0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  let Ann : Ideal (S ⊗[R] C) := (Submodule.span (S ⊗[R] C) {l}).annihilator
  have hAnn : Ann ≠ ⊤ := by
    intro h
    apply hl0
    have h1 : (1 : S ⊗[R] C) ∈ Ann := h ▸ Submodule.mem_top
    rw [Submodule.mem_annihilator_span_singleton, one_smul] at h1
    exact h1
  have hgmem := mem_map_annihilator_of_mul_eq_zero (hkill' l hl)
  obtain ⟨Q, hQ, hAQ⟩ := Ideal.exists_le_maximal Ann hAnn
  let _ : Field ((S ⊗[R] C) ⧸ Q) := Ideal.Quotient.field Q
  have := hdom ((S ⊗[R] C) ⧸ Q)
  let K : CommAlgCat.{u} R := CommAlgCat.of R ((S ⊗[R] C) ⧸ Q)
  let q : D ⟶ K := CommAlgCat.ofHom (Ideal.Quotient.mkₐ R Q)
  let KC : CommAlgCat.{u} R := CommAlgCat.of R (((S ⊗[R] C) ⧸ Q) ⊗[R] C)
  let Ψ : E ⟶ KC := CommAlgCat.ofHom (Algebra.TensorProduct.map q.hom (AlgHom.id R C))
  have hΨ : Ψ.hom (φ.hom f * ι₂.hom f) = 0 := by
    have hle : Ann.map (includeLeft : (S ⊗[R] C) →ₐ[R] (S ⊗[R] C) ⊗[R] C) ≤
        RingHom.ker Ψ.hom := by
      refine Ideal.map_le_iff_le_comap.2 fun a ha => ?_
      rw [Ideal.mem_comap, RingHom.mem_ker]
      change Algebra.TensorProduct.map q.hom (AlgHom.id R C) (a ⊗ₜ 1) = 0
      rw [Algebra.TensorProduct.map_tmul]
      change Ideal.Quotient.mk Q a ⊗ₜ[R] _ = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.2 (hAQ ha), TensorProduct.zero_tmul]
    exact hle hgmem
  -- the value at `f` of the map `S ⊗[R] C ⟶ K` given by `S ⟶ K` and the unit is `1`
  have hone : (tensorPairMap e (jS ≫ q) 1).hom f = 1 := by
    have h := tensorPairMap_comp (e := e) (𝟙 S) 1 (jS ≫ q)
    rw [map_one, Category.id_comp] at h
    rw [← h, CommAlgCat.hom_comp, AlgHom.comp_apply, hf, map_one]
  rw [map_mul] at hΨ
  rcases mul_eq_zero.1 hΨ with h | h
  · -- evaluate at the point where both copies agree
    let ρ : KC ⟶ K := CommAlgCat.ofHom (Algebra.TensorProduct.lift (AlgHom.id R K)
      (q.hom.comp jC.hom) fun _ _ => Commute.all _ _)
    have hρ : φ ≫ Ψ ≫ ρ = tensorPairMap e (jS ≫ q) 1 := by
      rw [tensorPairMap_comp]
      have h₁ : sE ≫ Ψ ≫ ρ = jS ≫ q := by
        apply CommAlgCat.hom_ext
        ext a
        simp [D, E, K, KC, sE, jS, ι₁, Ψ, ρ, q, Algebra.TensorProduct.includeLeft_apply,
          Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul]
      have h₂ : jC ≫ ι₁ ≫ Ψ ≫ ρ = jE ≫ Ψ ≫ ρ := by
        apply CommAlgCat.hom_ext
        ext c
        simp [D, E, K, KC, jC, ι₁, Ψ, ρ, q, jE, Algebra.TensorProduct.includeLeft_apply,
          Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul,
          Algebra.TensorProduct.map_tmul]
        rw [← Algebra.TensorProduct.one_def, map_one, mul_one]
      rw [h₁, map_mul, map_inv]
      congr 1
      change F.map (Ψ ≫ ρ) (e.homEquiv (jC ≫ ι₁)) * (F.map (Ψ ≫ ρ) (e.homEquiv jE))⁻¹ = 1
      rw [← hcomp, ← hcomp, Category.assoc, h₂, mul_inv_cancel]
    have h' := congrArg ρ.hom h
    rw [map_zero, ← AlgHom.comp_apply, ← CommAlgCat.hom_comp, ← AlgHom.comp_apply,
      ← CommAlgCat.hom_comp, hρ, hone] at h'
    exact one_ne_zero h'
  · -- evaluate at the unit of the second copy
    let ev : KC ⟶ K := CommAlgCat.ofHom (Algebra.TensorProduct.lift (AlgHom.id R K)
      ((Algebra.ofId R K).comp (LinearEmbedding.counit e).hom) fun _ _ => Commute.all _ _)
    have hev : ι₂ ≫ Ψ ≫ ev = tensorPairMap e (jS ≫ q) 1 := by
      rw [tensorPairMap_comp]
      have h₁ : sE ≫ Ψ ≫ ev = jS ≫ q := by
        apply CommAlgCat.hom_ext
        ext a
        simp [D, E, K, KC, sE, jS, ι₁, Ψ, ev, q, Algebra.TensorProduct.includeLeft_apply,
          Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul]
      have h₂ : jE ≫ Ψ ≫ ev = e.homEquiv.symm 1 := by
        have hunit := LinearEmbedding.cls_one e K
        dsimp only [LinearEmbedding.cls, LinearEmbedding.unitMap] at hunit
        rw [hunit]
        apply CommAlgCat.hom_ext
        ext c
        simp [D, E, K, KC, Ψ, ev, jE, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul]
      rw [h₁]
      congr 1
      change F.map (Ψ ≫ ev) (e.homEquiv jE) = 1
      rw [← hcomp, h₂, Equiv.apply_symm_apply]
    have h' := congrArg ev.hom h
    rw [map_zero, ← AlgHom.comp_apply, ← CommAlgCat.hom_comp, ← AlgHom.comp_apply,
      ← CommAlgCat.hom_comp, hev, hone] at h'
    exact one_ne_zero h'

end Langlands.GroupScheme.Corepresented
