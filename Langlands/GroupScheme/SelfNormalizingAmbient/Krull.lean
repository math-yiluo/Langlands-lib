import Mathlib.RingTheory.Smooth.NoetherianDescent
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.TensorProduct.Quotient
import Mathlib.RingTheory.Flat.Basic
import Mathlib.RingTheory.FiniteType

/-! # A Krull intersection theorem for smooth algebras with a section

Let `C` be a smooth algebra over an arbitrary commutative ring `R`, with an `R`-algebra section
`ε : C →ₐ[R] R` and augmentation ideal `I = ker ε`. If every jet quotient `C₀ ⧸ I₀ ^ (n + 1)`
of a smooth algebra with a section is flat, then every `l ∈ ⋂ₙ I ^ n` is killed by `1 - j` for
some `j ∈ I`. The proof descends `C`, `ε` and `l` to a smooth algebra over a Noetherian subring
of `R` and applies the Krull intersection theorem there.
-/

noncomputable section

universe u

open TensorProduct Algebra.TensorProduct

namespace Langlands.GroupScheme.SelfNormalizingAmbient

section Transfer

variable {A R B : Type u} [CommRing A] [CommRing R] [CommRing B] [Algebra A R] [Algebra A B]

/-- The base change `R ⊗[A] B ⟶ R` of a section `ε : B ⟶ A`. -/
def baseSection (ε : B →ₐ[A] A) : R ⊗[A] B →ₐ[R] R :=
  Algebra.TensorProduct.lift (AlgHom.id R R) ((Algebra.ofId A R).comp ε) fun _ _ => Commute.all _ _

variable (ε : B →ₐ[A] A)

@[simp]
theorem baseSection_tmul (r : R) (b : B) :
    baseSection ε (r ⊗ₜ[A] b) = r * algebraMap A R (ε b) := by
  simp [baseSection]

theorem sub_mem_map_ker (x : R ⊗[A] B) :
    x - algebraMap R (R ⊗[A] B) (baseSection ε x) ∈
      (RingHom.ker ε).map (includeRight : B →ₐ[A] R ⊗[A] B) := by
  induction x using TensorProduct.inductionOn with
  | tmul r b =>
    have hb : b - algebraMap A B (ε b) ∈ RingHom.ker ε := by
      rw [RingHom.mem_ker, map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply,
        sub_self]
    have h : r ⊗ₜ[A] b - algebraMap R (R ⊗[A] B) (baseSection ε (r ⊗ₜ[A] b)) =
        (r ⊗ₜ[A] (1 : B)) * includeRight (b - algebraMap A B (ε b)) := by
      rw [baseSection_tmul, map_sub, mul_sub, includeRight_apply, includeRight_apply,
        tmul_mul_tmul, tmul_mul_tmul, mul_one, one_mul, one_mul]
      congr 1
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.algebraMap_eq_smul_one (A := B), ← TensorProduct.smul_tmul, Algebra.smul_def,
        mul_comm]
    rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hb)
  | add x y hx hy =>
    have h : x + y - algebraMap R (R ⊗[A] B) (baseSection ε (x + y)) =
        (x - algebraMap R (R ⊗[A] B) (baseSection ε x)) +
          (y - algebraMap R (R ⊗[A] B) (baseSection ε y)) := by
      rw [map_add, map_add]
      abel
    rw [h]
    exact add_mem hx hy

/-- The kernel of the base-changed section is generated by the kernel of `ε`. -/
theorem ker_baseSection :
    RingHom.ker (baseSection (R := R) ε) =
      (RingHom.ker ε).map (includeRight : B →ₐ[A] R ⊗[A] B) := by
  refine le_antisymm (fun x hx => ?_) (Ideal.map_le_iff_le_comap.2 fun b hb => ?_)
  · have h := sub_mem_map_ker ε x
    rwa [RingHom.mem_ker.1 hx, map_zero, sub_zero] at h
  · rw [Ideal.mem_comap, RingHom.mem_ker, includeRight_apply, baseSection_tmul,
      RingHom.mem_ker.1 hb, map_zero, mul_zero]

/-- An `R`-algebra map `R ⊗[A] B ⟶ R` is the base-changed section once it agrees with `ε` on `B`. -/
theorem eq_baseSection {f : R ⊗[A] B →ₐ[R] R}
    (h : ∀ b : B, f (1 ⊗ₜ b) = algebraMap A R (ε b)) : f = baseSection ε :=
  Algebra.TensorProduct.ext (Subsingleton.elim _ _) (AlgHom.ext fun b => by
    change f (1 ⊗ₜ b) = baseSection ε (1 ⊗ₜ b)
    rw [h, baseSection_tmul, one_mul])

/-- Flat base change along an injective map reflects membership in extended ideals. -/
theorem mem_of_includeRight_mem (hinj : Function.Injective (algebraMap A R)) {K : Ideal B}
    [Module.Flat A (B ⧸ K)] {b : B}
    (h : (includeRight : B →ₐ[A] R ⊗[A] B) b ∈ K.map (includeRight : B →ₐ[A] R ⊗[A] B)) :
    b ∈ K := by
  have h1 : (1 : R) ⊗ₜ[A] Ideal.Quotient.mk K b = 0 := by
    apply (Algebra.TensorProduct.tensorQuotientEquiv (R := A) R B R K).injective
    rw [Algebra.TensorProduct.tensorQuotientEquiv_apply_tmul, map_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact h
  have hinj' : Function.Injective ((Algebra.linearMap A R).rTensor (B ⧸ K)) :=
    Module.Flat.rTensor_preserves_injective_linearMap _ hinj
  have h2 : (1 : A) ⊗ₜ[A] Ideal.Quotient.mk K b = 0 := by
    apply hinj'
    rw [LinearMap.rTensor_tmul, Algebra.linearMap_apply, map_one, map_zero]
    exact h1
  have h3 := congrArg (TensorProduct.lid A (B ⧸ K)) h2
  rw [TensorProduct.lid_tmul, one_smul, map_zero, Ideal.Quotient.eq_zero_iff_mem] at h3
  exact h3

/-- **Krull intersection theorem after flat base change.** -/
theorem exists_one_sub_mul_eq_zero_of_baseChange [IsNoetherianRing B]
    (hinj : Function.Injective (algebraMap A R))
    (hflat : ∀ n : ℕ, Module.Flat A (B ⧸ RingHom.ker ε ^ (n + 1))) (b : B)
    (hb : ∀ n : ℕ, (includeRight : B →ₐ[A] R ⊗[A] B) b ∈
      RingHom.ker (baseSection (R := R) ε) ^ n) :
    ∃ j ∈ RingHom.ker (baseSection (R := R) ε),
      (1 - j) * (includeRight : B →ₐ[A] R ⊗[A] B) b = 0 := by
  have hb' : ∀ n : ℕ, b ∈ RingHom.ker ε ^ (n + 1) := fun n => by
    have := hflat n
    apply mem_of_includeRight_mem hinj
    rw [Ideal.map_pow, ← ker_baseSection]
    exact hb (n + 1)
  have hmem : b ∈ (⨅ i : ℕ, RingHom.ker ε ^ i • ⊤ : Submodule B B) := by
    simp only [Submodule.mem_iInf, smul_eq_mul, Ideal.mul_top]
    intro i
    cases i with
    | zero => simp
    | succ n => exact hb' n
  obtain ⟨⟨r, hr⟩, hrb⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff _ b).1 hmem
  refine ⟨includeRight r, ?_, ?_⟩
  · rw [ker_baseSection]
    exact Ideal.mem_map_of_mem _ hr
  · rw [sub_mul, one_mul, ← map_mul, ← smul_eq_mul, hrb, sub_self]

end Transfer

section Descent

/-- Every element of `R ⊗[A₀] B₀` comes from `A₁ ⊗[A₀] B₀` for every subalgebra `A₁` containing a
suitable finite set. -/
theorem exists_finset_mem_range_map {A₀ R B₀ : Type u} [CommRing A₀] [CommRing R] [CommRing B₀]
    [Algebra A₀ R] [Algebra A₀ B₀] (x : R ⊗[A₀] B₀) :
    ∃ S : Finset R, ∀ A₁ : Subalgebra A₀ R, (S : Set R) ⊆ A₁ →
      x ∈ (Algebra.TensorProduct.map A₁.val (AlgHom.id A₀ B₀)).range := by
  classical
  induction x using TensorProduct.inductionOn with
  | tmul r b => exact ⟨{r}, fun A₁ h => ⟨⟨r, h (by simp)⟩ ⊗ₜ b, by simp⟩⟩
  | add x y hx hy =>
    obtain ⟨S, hS⟩ := hx
    obtain ⟨T, hT⟩ := hy
    refine ⟨S ∪ T, fun A₁ h => add_mem (hS A₁ ?_) (hT A₁ ?_)⟩
    · exact subset_trans (by simp) h
    · exact subset_trans (by simp) h

variable {R C : Type u} [CommRing R] [CommRing C] [Algebra R C]

/-- **Descent of a smooth algebra with a section and an element** to a smooth algebra over a
Noetherian subring. -/
theorem exists_descent [Algebra.Smooth R C] (ε : C →ₐ[R] R) (l : C) :
    ∃ (A : Type u) (B : Type u) (_ : CommRing A) (_ : CommRing B) (_ : Algebra A R)
      (_ : Algebra A B), IsNoetherianRing A ∧ Function.Injective (algebraMap A R) ∧
      Algebra.Smooth A B ∧ ∃ (ε₁ : B →ₐ[A] A) (b : B) (Φ : R ⊗[A] B ≃ₐ[R] C),
        Φ (1 ⊗ₜ b) = l ∧ ∀ y : B, ε (Φ (1 ⊗ₜ y)) = algebraMap A R (ε₁ y) := by
  obtain ⟨A₀, B₀, _, _, hA₀, hsm₀, ⟨e⟩⟩ := Algebra.Smooth.exists_subalgebra_fg ℤ R C
  have : Algebra.FinitePresentation A₀ B₀ := hsm₀.finitePresentation
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A₀ B₀).FG)
  let ε₀ : B₀ →ₐ[A₀] R :=
    ((ε.comp e.symm.toAlgHom).restrictScalars A₀).comp
      (includeRight : B₀ →ₐ[A₀] R ⊗[A₀] B₀)
  obtain ⟨S, hS⟩ := exists_finset_mem_range_map (e l)
  classical
  let A₁ : Subalgebra A₀ R := Algebra.adjoin A₀ ((S : Set R) ∪ ε₀ '' (s : Set B₀))
  have hε₀ : ∀ b, ε₀ b ∈ A₁ := by
    intro b
    have hb : b ∈ Algebra.adjoin A₀ (s : Set B₀) := hs ▸ Algebra.mem_top
    exact (Algebra.adjoin_le fun y hy => Algebra.subset_adjoin (Or.inr ⟨y, hy, rfl⟩) :
      Algebra.adjoin A₀ (s : Set B₀) ≤ A₁.comap ε₀) hb
  let ε₀' : B₀ →ₐ[A₀] A₁ := ε₀.codRestrict A₁ hε₀
  let ε₁ : A₁ ⊗[A₀] B₀ →ₐ[A₁] A₁ :=
    Algebra.TensorProduct.lift (AlgHom.id A₁ A₁) ε₀' fun _ _ => Commute.all _ _
  obtain ⟨b, hb⟩ := hS A₁ fun x hx => Algebra.subset_adjoin (Or.inl hx)
  let Φ : R ⊗[A₁] (A₁ ⊗[A₀] B₀) ≃ₐ[R] C :=
    (Algebra.TensorProduct.cancelBaseChange A₀ A₁ R R B₀).trans e.symm
  have hcancel : ∀ y : A₁ ⊗[A₀] B₀,
      Algebra.TensorProduct.cancelBaseChange A₀ A₁ R R B₀ (1 ⊗ₜ y) =
        Algebra.TensorProduct.map A₁.val (AlgHom.id A₀ B₀) y := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul a c =>
      rw [cancelBaseChange_tmul, Algebra.TensorProduct.map_tmul, Algebra.smul_def, mul_one]
      rfl
    | add y z hy hz => rw [tmul_add, map_add, map_add, hy, hz]
  have hA₀fg : Algebra.FiniteType ℤ A₀ := ⟨(Subalgebra.fg_top A₀).2 hA₀⟩
  have : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing ℤ A₀
  have hA₁fg : (A₁ : Subalgebra A₀ R).FG := by
    have : ((S : Set R) ∪ ε₀ '' (s : Set B₀)) = ↑(S ∪ s.image ε₀) := by
      rw [Finset.coe_union, Finset.coe_image]
    rw [show A₁ = Algebra.adjoin A₀ ((S : Set R) ∪ ε₀ '' (s : Set B₀)) from rfl, this]
    exact Subalgebra.fg_adjoin_finset _
  have : Algebra.FiniteType A₀ A₁ := ⟨(Subalgebra.fg_top A₁).2 hA₁fg⟩
  refine ⟨A₁, A₁ ⊗[A₀] B₀, inferInstance, inferInstance, inferInstance, inferInstance,
    Algebra.FiniteType.isNoetherianRing A₀ A₁, Subtype.val_injective, inferInstance, ε₁, b, Φ,
    ?_, ?_⟩
  · have hb' : Algebra.TensorProduct.map A₁.val (AlgHom.id A₀ B₀) b = e l := hb
    change e.symm (Algebra.TensorProduct.cancelBaseChange A₀ A₁ R R B₀ (1 ⊗ₜ b)) = l
    rw [hcancel, hb', AlgEquiv.symm_apply_apply]
  · have hε : ∀ (r : R) (c : B₀), ε (e.symm (r ⊗ₜ c)) = r * ε₀ c := by
      intro r c
      have : r ⊗ₜ[A₀] c = r • (includeRight : B₀ →ₐ[A₀] R ⊗[A₀] B₀) c := by
        rw [includeRight_apply, smul_tmul', smul_eq_mul, mul_one]
      rw [this, map_smul, map_smul, smul_eq_mul]
      rfl
    intro y
    change ε (e.symm (Algebra.TensorProduct.cancelBaseChange A₀ A₁ R R B₀ (1 ⊗ₜ y))) =
      ((ε₁ y : A₁) : R)
    rw [hcancel]
    induction y using TensorProduct.inductionOn with
    | tmul a c =>
      rw [Algebra.TensorProduct.map_tmul, hε, Algebra.TensorProduct.lift_tmul]
      rfl
    | add y z hy hz => rw [map_add, map_add, map_add, hy, hz, map_add, Subalgebra.coe_add]

/-- **Krull intersection theorem for smooth algebras with a section**, assuming flatness of the
jet quotients of smooth algebras with a section. -/
theorem exists_one_sub_mul_eq_zero_of_mem_pow
    (hJ : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.Smooth A B]
      (ε : B →ₐ[A] A) (n : ℕ), Module.Flat A (B ⧸ RingHom.ker ε ^ (n + 1)))
    [Algebra.Smooth R C] (ε : C →ₐ[R] R) {l : C} (hl : ∀ n : ℕ, l ∈ RingHom.ker ε ^ n) :
    ∃ j ∈ RingHom.ker ε, (1 - j) * l = 0 := by
  obtain ⟨A, B, _, _, _, _, hA, hinj, hsm, ε₁, b, Φ, hb, hε⟩ := exists_descent ε l
  have : Algebra.FinitePresentation A B := hsm.finitePresentation
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  have hε' : ε.comp (Φ : R ⊗[A] B →ₐ[R] C) = baseSection ε₁ := eq_baseSection ε₁ hε
  have hker : RingHom.ker ε = (RingHom.ker (baseSection (R := R) ε₁)).map Φ := by
    ext x
    rw [Ideal.mem_map_of_equiv Φ, RingHom.mem_ker]
    constructor
    · intro hx
      refine ⟨Φ.symm x, ?_, Φ.apply_symm_apply x⟩
      rw [RingHom.mem_ker, ← hε']
      change ε (Φ (Φ.symm x)) = 0
      rw [Φ.apply_symm_apply, hx]
    · rintro ⟨y, hy, rfl⟩
      rw [RingHom.mem_ker, ← hε'] at hy
      exact hy
  have hb' : ∀ n : ℕ, (includeRight : B →ₐ[A] R ⊗[A] B) b ∈
      RingHom.ker (baseSection (R := R) ε₁) ^ n := by
    intro n
    have h := hl n
    rw [hker, ← Ideal.map_pow, ← hb] at h
    obtain ⟨x, hx, hxb⟩ := (Ideal.mem_map_of_equiv Φ _).1 h
    rwa [Φ.injective hxb] at hx
  obtain ⟨j, hj, hjb⟩ :=
    exists_one_sub_mul_eq_zero_of_baseChange ε₁ hinj (hJ A B ε₁) b hb'
  refine ⟨Φ j, ?_, ?_⟩
  · rw [hker]
    exact Ideal.mem_map_of_mem _ hj
  · rw [← hb, ← map_one Φ, ← map_sub, ← map_mul]
    change Φ ((1 - j) * (includeRight : B →ₐ[A] R ⊗[A] B) b) = 0
    rw [hjb, map_zero]

end Descent

end Langlands.GroupScheme.SelfNormalizingAmbient
