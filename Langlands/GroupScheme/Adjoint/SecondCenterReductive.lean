/-! # Connected reductive groups have trivial second centre

If a point `g` of a connected reductive group `G` over a field has all its commutators in the
centre, then `x ↦ x g x⁻¹ g⁻¹` is a homomorphism into the centre. It kills the central torus,
kills every commutator, hence kills the derived subgroup (which is schematically generated by
commutators), and therefore kills `G` because the central torus and the derived subgroup
generate `G`. The last input is `ReductiveCentralDerivedProductStatement`, taken here as an
explicit hypothesis of the final theorem. -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

namespace SecondCenter

/-! ### Group theory -/

/-- If every commutator `x g x⁻¹ g⁻¹` with a fixed element `g` is central, then every
commutator `a b a⁻¹ b⁻¹` commutes with `g`. -/
theorem commute_commutator_of_forall_mem_center {Γ : Type*} [Group Γ] (g : Γ)
    (hg : ∀ x : Γ, x * g * x⁻¹ * g⁻¹ ∈ Subgroup.center Γ) (a b : Γ) :
    Commute (a * b * a⁻¹ * b⁻¹) g := by
  let φ : Γ →* Subgroup.center Γ :=
    { toFun := fun x => ⟨x * g * x⁻¹ * g⁻¹, hg x⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x y => by
        apply Subtype.ext
        have hy := Subgroup.mem_center_iff.mp (hg y) x
        have hxy := Subgroup.mem_center_iff.mp (hg y) (x * g * x⁻¹ * g⁻¹)
        change x * y * g * (x * y)⁻¹ * g⁻¹ =
          (x * g * x⁻¹ * g⁻¹) * (y * g * y⁻¹ * g⁻¹)
        calc x * y * g * (x * y)⁻¹ * g⁻¹
            = (x * (y * g * y⁻¹ * g⁻¹)) * g * x⁻¹ * g⁻¹ := by group
          _ = ((y * g * y⁻¹ * g⁻¹) * x) * g * x⁻¹ * g⁻¹ := by rw [hy]
          _ = (y * g * y⁻¹ * g⁻¹) * (x * g * x⁻¹ * g⁻¹) := by group
          _ = (x * g * x⁻¹ * g⁻¹) * (y * g * y⁻¹ * g⁻¹) := hxy.symm }
  have hab : φ a * φ b = φ b * φ a :=
    Subtype.ext (Subgroup.mem_center_iff.mp (φ b).2 (φ a).1)
  have h1 : φ (a * b * a⁻¹ * b⁻¹) = 1 := by
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hab]
    group
  have h2 : (a * b * a⁻¹ * b⁻¹) * g * (a * b * a⁻¹ * b⁻¹)⁻¹ * g⁻¹ = 1 :=
    congrArg Subtype.val h1
  exact mul_inv_eq_iff_eq_mul.mp (mul_inv_eq_one.mp h2)

/-- Under the same hypothesis, every finite product of commutators commutes with `g`. -/
theorem commute_prod_of_forall_mem_center {Γ : Type*} [Group Γ] (g : Γ)
    (hg : ∀ x : Γ, x * g * x⁻¹ * g⁻¹ ∈ Subgroup.center Γ) (l : List Γ)
    (hl : ∀ y ∈ l, ∃ a b : Γ, y = a * b * a⁻¹ * b⁻¹) : Commute l.prod g := by
  have hmem : l.prod ∈ Subgroup.centralizer ({g} : Set Γ) := by
    refine Subgroup.list_prod_mem _ fun y hy => ?_
    obtain ⟨a, b, rfl⟩ := hl y hy
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (commute_commutator_of_forall_mem_center g hg a b).eq
  exact Subgroup.mem_centralizer_singleton_iff.mp hmem

/-! ### Schemes -/

variable {S : Scheme.{u}}

/-- Two morphisms into a separated object over the base agree if they agree after a
scheme-theoretically dominant morphism. -/
theorem over_ext_of_dominant {W X Y : Over S} [IsSeparated Y.hom] {f f' : X ⟶ Y}
    (j : W ⟶ X) [IsSchemeTheoreticallyDominant j.left] (hj : j ≫ f = j ≫ f') : f = f' :=
  Over.OverMorphism.ext (ext_of_isSchemeTheoreticallyDominant Y.hom
    (by rw [Over.w f, Over.w f']) j.left
    (by rw [← Over.comp_left, hj, Over.comp_left]))

/-- A morphism to an affine scheme that is injective on global sections is
scheme-theoretically dominant. -/
theorem isSchemeTheoreticallyDominant_of_appTop_injective {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsAffine Y] (hinj : Function.Injective f.appTop) : IsSchemeTheoreticallyDominant f := by
  rw [isSchemeTheoreticallyDominant_iff, Scheme.ker_of_isAffine,
    (RingHom.injective_iff_ker_eq_bot _).mp hinj,
    ← Scheme.IdealSheafData.equivOfIsAffine_symm_apply, map_bot]

/-- An epimorphism over the base onto an affine scheme is scheme-theoretically dominant. -/
theorem isSchemeTheoreticallyDominant_of_epi {X Y : Over S} (f : X ⟶ Y) [Epi f]
    [IsAffine Y.left] : IsSchemeTheoreticallyDominant f.left := by
  have : Epi f.left := (Over.forget S).map_epi f
  exact isSchemeTheoreticallyDominant_of_appTop_injective f.left
    (Langlands.Scheme.UnitCocycleDescent.appTop_injective_of_epi f.left)

set_option backward.isDefEq.respectTransparency.types false in
/-- The product of two affine objects over the base is affine over the base. -/
theorem isAffineHom_tensor (X Y : Over S) [IsAffineHom X.hom] [IsAffineHom Y.hom] :
    IsAffineHom (X ⊗ Y).hom := by
  change IsAffineHom (pullback.fst X.hom Y.hom ≫ X.hom)
  let : IsAffineHom (pullback.fst X.hom Y.hom) :=
    MorphismProperty.pullback_fst _ _ (inferInstance : IsAffineHom Y.hom)
  infer_instance

/-! ### Commutators with a point having central commutators -/

variable {G : GroupScheme S}

/-- The hypothesis of `SecondCenterTrivial`, after any base change, in group form. -/
theorem forall_mem_center_of_hyp {T : Over S} {g : T ⟶ G.X}
    (hg : ∀ (T' : Over S) (a : T' ⟶ T) (h : T' ⟶ G.X),
      (a ≫ g) * h * (a ≫ g)⁻¹ * h⁻¹ ∈ (center G).carrier T')
    {Y : Over S} (b : Y ⟶ T) (x : Y ⟶ G.X) :
    x * (b ≫ g) * x⁻¹ * (b ≫ g)⁻¹ ∈ Subgroup.center (Y ⟶ G.X) := by
  have hc := hg Y b x
  have hc' : (b ≫ g) * x * (b ≫ g)⁻¹ * x⁻¹ ∈ Subgroup.center (Y ⟶ G.X) :=
    Subgroup.mem_center_iff.mpr fun z => (commute_of_mem_center hc z).eq.symm
  have heq : x * (b ≫ g) * x⁻¹ * (b ≫ g)⁻¹ = ((b ≫ g) * x * (b ≫ g)⁻¹ * x⁻¹)⁻¹ := by
    group
  rw [heq]
  exact Subgroup.inv_mem _ hc'

/-- Precomposition preserves commuting pairs of points. -/
theorem commute_comp {Y W : Over S} (a : Y ⟶ W) {x y : W ⟶ G.X} (h : Commute x y) :
    Commute (a ≫ x) (a ≫ y) := by
  change (a ≫ x) * (a ≫ y) = (a ≫ y) * (a ≫ x)
  rw [← MonObj.comp_mul, ← MonObj.comp_mul, h.eq]

/-- The actual commutator morphism evaluates to the commutator of the two coordinates. -/
theorem comp_commutatorMap_id {Y : Over S} (x : Y ⟶ G.X ⊗ G.X) :
    x ≫ commutatorMap (𝟙 G) (𝟙 G) =
      (x ≫ fst G.X G.X) * (x ≫ snd G.X G.X) * (x ≫ fst G.X G.X)⁻¹ * (x ≫ snd G.X G.X)⁻¹ := by
  simp only [commutatorMap_points, Grp.id_hom_hom, Category.comp_id]

end SecondCenter

namespace SecondCenter

variable {k : Type u} [Field k] {G : GroupScheme (Spec (CommRingCat.of k))}

/-- Points of a smooth connected representative of the commutator envelope commute with a
point `g` whose commutators are central: after the flat base change to the test scheme,
the ordered products of commutators are schematically dense in the representative. -/
theorem commute_inclusion_of_hyp [IsAffineHom G.X.hom]
    (E : GeneratedImage (commutatorMap (𝟙 G) (𝟙 G))) (hE : E.HasSmoothConnectedGeneration)
    {T : Over (Spec (CommRingCat.of k))} {g : T ⟶ G.X}
    (hg : ∀ (T' : Over (Spec (CommRingCat.of k))) (a : T' ⟶ T) (h : T' ⟶ G.X),
      (a ≫ g) * h * (a ≫ g)⁻¹ * h⁻¹ ∈ (center G).carrier T') :
    Commute (fst E.group.X T ≫ E.inclusion.hom.hom) (snd E.group.X T ≫ g) := by
  obtain ⟨hsm, haff, -, n, -, hdom⟩ := hE
  have : IsReduced E.group.X.left := Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field k _ E.group.X.hom
  have : IsSchemeTheoreticallyDominant (E.powerMap n).left := .of_isDominant _
  have : IsAffine E.group.X.left := isAffine_of_isAffineHom E.group.X.hom
  have : IsAffineHom (G.X ⊗ G.X).hom := isAffineHom_tensor G.X G.X
  have : IsAffine (finitePower (G.X ⊗ G.X) n).left :=
    isAffine_of_isAffineHom (finitePower (G.X ⊗ G.X) n).hom
  have : QuasiCompact (E.powerMap n).left := inferInstance
  have : IsSchemeTheoreticallyDominant (E.powerMap n ▷ T).left :=
    ImageGeneration.isSchemeTheoreticallyDominant_whiskerRight _ T
  change _ * _ = _ * _
  apply over_ext_of_dominant (E.powerMap n ▷ T)
  rw [MonObj.comp_mul, MonObj.comp_mul, whiskerRight_fst_assoc, whiskerRight_snd_assoc,
    E.powerMap_comp, orderedPowerMap_points]
  refine (commute_prod_of_forall_mem_center _
    (fun x => forall_mem_center_of_hyp hg (snd _ T) x) _ ?_).eq
  intro y hy
  obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hy
  exact ⟨_, _, comp_commutatorMap_id _⟩

/-- If the central subgroup and the derived subgroup have epimorphic multiplication map, and
every point of the derived subgroup commutes with `g`, then every point of `G` commutes
with `g`. -/
theorem commute_of_epi_subgroupProductMap [IsAffineHom G.X.hom]
    {Z D : GroupScheme (Spec (CommRingCat.of k))} (i : Z ⟶ G) (d : D ⟶ G)
    [IsAffineHom Z.X.hom] (hi : IsCentral i) (hd : IsDerivedSubgroup d)
    [Epi (subgroupProductMap i d)] {T : Over (Spec (CommRingCat.of k))} {g : T ⟶ G.X}
    (hD : ∀ (Y : Over (Spec (CommRingCat.of k))) (x : Y ⟶ D.X) (b : Y ⟶ T),
      Commute (x ≫ d.hom.hom) (b ≫ g)) :
    Commute (fst G.X T) (snd G.X T ≫ g) := by
  have : IsClosedImmersion d.hom.hom.left := hd.1
  have : IsAffineHom D.X.hom := by
    rw [← Over.w d.hom.hom]
    infer_instance
  have : IsAffineHom (Z.X ⊗ D.X).hom := isAffineHom_tensor Z.X D.X
  have : IsAffine (Z.X ⊗ D.X).left := isAffine_of_isAffineHom (Z.X ⊗ D.X).hom
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have : QuasiCompact (subgroupProductMap i d).left := inferInstance
  have : IsSchemeTheoreticallyDominant (subgroupProductMap i d).left :=
    isSchemeTheoreticallyDominant_of_epi _
  have : IsSchemeTheoreticallyDominant (subgroupProductMap i d ▷ T).left :=
    ImageGeneration.isSchemeTheoreticallyDominant_whiskerRight _ T
  change _ * _ = _ * _
  apply over_ext_of_dominant (subgroupProductMap i d ▷ T)
  rw [MonObj.comp_mul, MonObj.comp_mul, whiskerRight_fst, whiskerRight_snd_assoc,
    subgroupProductMap, MonObj.comp_mul]
  refine Commute.eq (Commute.mul_left ?_ ?_)
  · rw [← Category.assoc]
    exact commute_of_mem_center (hi _ _) _
  · rw [← Category.assoc]
    exact hD _ _ _

/-- A smooth connected affine group over a field, generated by a central subgroup and its
derived subgroup in the sense that the multiplication map is an epimorphism, has trivial
second centre. -/
theorem secondCenterTrivial_of_epi_subgroupProductMap (hsm : Smooth G.X.hom)
    (haff : IsAffineHom G.X.hom) (hconn : ConnectedSpace G.X.left)
    {Z D : GroupScheme (Spec (CommRingCat.of k))} (i : Z ⟶ G) (d : D ⟶ G)
    [IsAffineHom Z.X.hom] (hi : IsCentral i) (hd : IsDerivedSubgroup d)
    [Epi (subgroupProductMap i d)] : SecondCenterTrivial G := by
  intro T g hg
  let E := smoothConnectedCommutatorImage k G hsm haff hconn
  have hE := commute_inclusion_of_hyp E.1 E.2 hg
  have hD : ∀ (Y : Over (Spec (CommRingCat.of k))) (x : Y ⟶ D.X) (b : Y ⟶ T),
      Commute (x ≫ d.hom.hom) (b ≫ g) := by
    intro Y x b
    have hx : x ≫ d.hom.hom ∈ (SubgroupFunctor.range E.1.inclusion).carrier Y := by
      rw [E.1.isDerivedSubgroup.2, ← hd.2]
      exact ⟨x, rfl⟩
    obtain ⟨y, hy⟩ := SubgroupFunctor.mem_range.mp hx
    rw [← hy]
    have h' := commute_comp (lift y b) hE
    rwa [← Category.assoc, ← Category.assoc, lift_fst, lift_snd] at h'
  have hG := commute_of_epi_subgroupProductMap i d hi hd hD
  rw [mem_center]
  intro T' a h
  have h' := commute_comp (lift h a) hG
  rw [lift_fst, ← Category.assoc, lift_snd] at h'
  exact h'.symm

/-- Every connected reductive group over a field has trivial second centre, given that it
is generated by a central torus and its derived subgroup. -/
theorem secondCenterTrivial_of_centralDerivedProduct
    (hDP : ReductiveCentralDerivedProductStatement.{u})
    (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k)))
    (hG : IsConnectedReductive G) : SecondCenterTrivial G := by
  obtain ⟨Z, D, i, d, hZ, -, -, -, hi, hd, hepi⟩ := hDP k G hG
  exact secondCenterTrivial_of_epi_subgroupProductMap hG.smooth hG.isAffineHom
    hG.connectedSpace i d hi hd

end SecondCenter

end Langlands.GroupScheme
