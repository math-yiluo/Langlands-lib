import Langlands.GroupScheme.Adjoint.CenterQuotientConjugation
import Langlands.GroupScheme.Absolute.UnipotentAllBorelsEnvelope
import Langlands.GroupScheme.ImageGenerationFinitePower
import Langlands.GroupScheme.ImageGenerationPointed
import Langlands.GroupScheme.AffineLinearEmbeddingProof

/-! # Normal subgroups with commuting rational points are central

Over an algebraically closed field, let `G` be a smooth connected affine group with trivial
unipotent radical and `a : A ⟶ G` a closed normal subgroup whose rational points commute.
For a rational point `h` of `A`, the closed subgroup `D` generated by the image of
`(g, y) ↦ g (y h y⁻¹ h⁻¹) g⁻¹` is smooth, connected and normal, lies in `A`, and acts
unipotently in a closed linear embedding of `G`: every value at a rational point is
conjugate to a commutator `y h y⁻¹ h⁻¹`, which is unipotent by `CenterQuotientConjugation`,
and these values commute. Hence `D` is trivial and `h` is central. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.CenterQuotient

open CentralIntersection

section Ring

variable {A : Type*} [Ring A]

/-- A product of pairwise commuting elements `x` with `x - 1` nilpotent has this property. -/
theorem isNilpotent_list_prod_sub_one (P : A → Prop) (hP : ∀ x, P x → IsNilpotent (x - 1))
    (hc : ∀ x y, P x → P y → Commute x y) :
    ∀ l : List A, (∀ x ∈ l, P x) → IsNilpotent (l.prod - 1)
  | [], _ => by simp
  | x :: l, hl => by
    rw [List.prod_cons]
    have hx := hl x List.mem_cons_self
    have hl' : ∀ y ∈ l, P y := fun y hy => hl y (List.mem_cons_of_mem _ hy)
    exact isNilpotent_mul_sub_one
      (Commute.list_prod_right _ _ fun y hy => hc x y hx (hl' y hy)) (hP x hx)
      (isNilpotent_list_prod_sub_one P hP hc l hl')

/-- Conjugation by a unit preserves nilpotence of `x - 1`. -/
theorem isNilpotent_units_conj_sub_one (u : Aˣ) {x : A} (hx : IsNilpotent (x - 1)) :
    IsNilpotent ((u : A) * x * ((u⁻¹ : Aˣ) : A) - 1) := by
  obtain ⟨m, hm⟩ := hx
  refine ⟨m, ?_⟩
  have h : (u : A) * x * ((u⁻¹ : Aˣ) : A) - 1 = (u : A) * (x - 1) * ((u⁻¹ : Aˣ) : A) := by
    rw [mul_sub, sub_mul, mul_one, Units.mul_inv]
  rw [h, Units.conj_pow, hm, mul_zero, zero_mul]

end Ring

section Map

variable {K : Type u} [Field K] {G : GroupScheme (Spec (CommRingCat.of K))}
  (h : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X)

/-- The morphism `(g, y) ↦ g (y h y⁻¹ h⁻¹) g⁻¹` for a rational point `h`. -/
def conjCommutatorMap : G.X ⊗ G.X ⟶ G.X :=
  fst G.X G.X * (snd G.X G.X * (toUnit _ ≫ h) * (snd G.X G.X)⁻¹ * (toUnit _ ≫ h)⁻¹) *
    (fst G.X G.X)⁻¹

theorem comp_conjCommutatorMap {T : Over (Spec (CommRingCat.of K))} (v : T ⟶ G.X ⊗ G.X) :
    v ≫ conjCommutatorMap h = (v ≫ fst G.X G.X) * ((v ≫ snd G.X G.X) * (toUnit T ≫ h) *
      (v ≫ snd G.X G.X)⁻¹ * (toUnit T ≫ h)⁻¹) * (v ≫ fst G.X G.X)⁻¹ := by
  simp only [conjCommutatorMap, MonObj.comp_mul, GrpObj.comp_inv]
  rw [← Category.assoc v (toUnit _) h, comp_toUnit]

theorem lift_comp_conjCommutatorMap {T : Over (Spec (CommRingCat.of K))} (g y : T ⟶ G.X) :
    lift g y ≫ conjCommutatorMap h =
      g * (y * (toUnit T ≫ h) * y⁻¹ * (toUnit T ≫ h)⁻¹) * g⁻¹ := by
  rw [comp_conjCommutatorMap, lift_fst, lift_snd]

/-- The map is equivariant for left translation on the first factor and conjugation. -/
theorem conjCommutatorMap_isEquivariant :
    (UnipotentAllBorelsEnvelope.leftTranslation G G.X).IsEquivariant
      (AutomorphicAction.conjugation (𝟙 G)).toPointwiseSchemeAction (conjCommutatorMap h) := by
  intro T g v
  rw [UnipotentAllBorelsEnvelope.leftTranslation_act, AutomorphicAction.toPointwiseSchemeAction_act,
    AutomorphicAction.conjugation_act, lift_comp_conjCommutatorMap, comp_conjCommutatorMap]
  simp only [Grp.id_hom_hom, Category.comp_id]
  group

theorem lift_one_one_comp_conjCommutatorMap :
    (lift 1 1 : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X ⊗ G.X) ≫ conjCommutatorMap h = 1 := by
  rw [lift_comp_conjCommutatorMap]
  group

end Map

section Vanishing

variable {K : Type u} [Field K] [IsAlgClosed K] {H : GroupScheme (Spec (CommRingCat.of K))}

/-- A global function on `H` vanishes if its pullback along a morphism `p` from a reduced
scheme of finite type, injective on global sections, vanishes at all rational points. -/
theorem eq_zero_of_forall_evalPoint_comp_eq_zero {X : Over (Spec (CommRingCat.of K))}
    [IsReduced X.left] [LocallyOfFiniteType X.hom] (p : X ⟶ H.X)
    (hp : Function.Injective p.left.appTop) (F : Γ(H.X.left, ⊤))
    (hF : ∀ w : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ X, CentralIntersection.evalPoint (H := H) (w ≫ p) F = 0) :
    F = 0 := by
  apply hp
  rw [map_zero]
  refine eq_zero_of_forall_appTop_eq_zero X.hom _ fun q hq => ?_
  have h1 := hF (Over.homMk q hq)
  rw [CentralIntersection.evalPoint_apply] at h1
  have h2 := congrArg (Scheme.ΓSpecIso (CommRingCat.of K)).inv h1
  rw [Iso.hom_inv_id_apply, map_zero, Over.comp_left] at h2
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply] at h2
  exact h2

end Vanishing

section Main

variable {K : Type u} [Field K] [IsAlgClosed K] {G : GroupScheme (Spec (CommRingCat.of K))}

/-- **Normal subgroups with commuting rational points are central.** Over an algebraically
closed field, let `G` be smooth, affine and connected with trivial unipotent radical, and let
`a : A ⟶ G` be a closed normal subgroup whose rational points commute. Then every rational
point of `A` is central in `G`. -/
theorem mem_center_of_isNormal_of_commute [Smooth G.X.hom] [IsAffineHom G.X.hom]
    [ConnectedSpace G.X.left] (hG : HasTrivialUnipotentRadical G)
    {A : GroupScheme (Spec (CommRingCat.of K))} (a : A ⟶ G) (ha : IsClosedSubgroup a)
    (hn : (SubgroupFunctor.range a).IsNormal)
    (hcomm : ∀ x y : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A.X,
      Commute (x ≫ a.hom.hom) (y ≫ a.hom.hom))
    (x : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A.X) :
    x ≫ a.hom.hom ∈ (center G).carrier _ := by
  set h := x ≫ a.hom.hom with hh
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have : IsReduced G.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field K
      G.X.left G.X.hom
  have e1 : ∀ y : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X, toUnit _ ≫ y = y := by
    intro y
    have e0 : toUnit (Over.mk (𝟙 (Spec (CommRingCat.of K)))) =
        (𝟙 (Over.mk (𝟙 (Spec (CommRingCat.of K)))) : _ ⟶ 𝟙_ _) :=
      toUnit_unique _ _
    rw [e0, Category.id_comp]
  -- Points of `A`.
  have hcommG : ∀ y y' : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X,
      y ∈ (SubgroupFunctor.range a).carrier _ → y' ∈ (SubgroupFunctor.range a).carrier _ →
        Commute y y' := by
    rintro _ _ ⟨z, rfl⟩ ⟨z', rfl⟩
    exact hcomm z z'
  have hmemh : h ∈ (SubgroupFunctor.range a).carrier _ := ⟨x, rfl⟩
  have hconj : ∀ (T : Over (Spec (CommRingCat.of K))) (g y : T ⟶ G.X),
      y ∈ (SubgroupFunctor.range a).carrier T →
        g * y * g⁻¹ ∈ (SubgroupFunctor.range a).carrier T :=
    fun T g y hy => hn T g y trivial hy
  set f := conjCommutatorMap h with hf
  have hval : ∀ (T : Over (Spec (CommRingCat.of K))) (v : T ⟶ G.X ⊗ G.X),
      v ≫ f ∈ (SubgroupFunctor.range a).carrier T := by
    intro T v
    rw [hf, comp_conjCommutatorMap]
    have hh' : toUnit T ≫ h ∈ (SubgroupFunctor.range a).carrier T :=
      (SubgroupFunctor.range a).comp_mem (toUnit T) hmemh
    exact hconj _ _ _ (Subgroup.mul_mem _ (hconj _ _ _ hh') (Subgroup.inv_mem _ hh'))
  -- A closed linear embedding and unipotence of the values.
  obtain ⟨N, ρ, hρ⟩ := affineLinearEmbeddingStatement K G inferInstance inferInstance
  have : IsClosedImmersion ρ.hom.hom.left := hρ
  have hcommρ : ∀ g : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X,
      Commute (ρ.rationalMatrix h : Matrix (Fin N) (Fin N) K) (ρ.rationalMatrix (g * h * g⁻¹)) := by
    intro g
    exact ((hcommG h _ hmemh (hconj _ g h hmemh)).map ρ.rationalMatrix).map (Units.coeHom _)
  have hvalu : ∀ v : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X ⊗ G.X,
      IsNilpotent ((ρ.rationalMatrix (v ≫ f) : Matrix (Fin N) (Fin N) K) - 1) := by
    intro v
    rw [hf, comp_conjCommutatorMap, e1, map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul]
    exact isNilpotent_units_conj_sub_one _
      (isNilpotent_rationalMatrix_commutator_sub_one ρ h hcommρ _)
  have hvalc : ∀ v v' : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X ⊗ G.X,
      Commute (ρ.rationalMatrix (v ≫ f) : Matrix (Fin N) (Fin N) K)
        (ρ.rationalMatrix (v' ≫ f)) := fun v v' =>
    ((hcommG _ _ (hval _ v) (hval _ v')).map ρ.rationalMatrix).map (Units.coeHom _)
  -- The closed subgroup generated by the image of `f`.
  have : Smooth (G.X ⊗ G.X).hom := smooth_tensor _ _ inferInstance inferInstance
  have : IsReduced (G.X ⊗ G.X).left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field K _
      (G.X ⊗ G.X).hom
  obtain ⟨hVAff, hVFin, -, hVInt⟩ := smoothConnectedAffineGeometry.2 K G G
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
  have : LocallyOfFiniteType (G.X ⊗ G.X).hom := hVFin
  obtain ⟨D, hD⟩ := ImageGeneration.pointedImageGeneration K G inferInstance inferInstance
    (G.X ⊗ G.X) hVAff hVFin hVInt _ f (lift_one_one_comp_conjCommutatorMap h)
  have : Smooth D.group.X.hom := hD.1
  have : IsAffineHom D.group.X.hom := hD.2.1
  have : GeometricallyConnected D.group.X.hom := hD.2.2.1
  have hDc : ConnectedSpace D.group.X.left :=
    GeometricallyConnected.connectedSpace_of_subsingleton (f := D.group.X.hom)
  have : IsAffine D.group.X.left := isAffine_of_isAffineHom D.group.X.hom
  have : IsReduced D.group.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field K
      D.group.X.left D.group.X.hom
  obtain ⟨n, -, hDom⟩ := hD.2.2.2
  -- It is normal, by equivariance of `f`.
  have hDn : (SubgroupFunctor.range D.inclusion).IsNormal := by
    intro T g y _ hy
    rw [D.represents.2] at hy ⊢
    have hst := AutomorphicAction.closedImageEnvelope_isStable
      (AutomorphicAction.conjugation (𝟙 G)) inferInstance
      (UnipotentAllBorelsEnvelope.leftTranslation G G.X) f
      (conjCommutatorMap_isEquivariant h) T g y hy
    simpa only [AutomorphicAction.conjugation_act, Grp.id_hom_hom, Category.comp_id]
      using hst
  -- It lies in `A`, so its rational points commute.
  have hfac : FactorsThrough f a :=
    UnipotentAllBorelsEnvelope.exists_factor_of_algClosed_points f ha (fun v => hval _ v)
  have hmin := D.minimalHom_comp a ha hfac
  have : Mono D.inclusion.hom.hom := D.represents.1
  have hDcomm : ∀ d d' : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ D.group.X, Commute d d' := by
    intro d d'
    have e : ∀ d : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ D.group.X,
        d ≫ D.inclusion.hom.hom = (d ≫ (D.minimalHom a ha hfac).hom.hom) ≫ a.hom.hom := by
      intro d
      rw [← hmin, Grp.comp_hom_hom, Category.assoc]
    have hc := hcomm (d ≫ (D.minimalHom a ha hfac).hom.hom)
      (d' ≫ (D.minimalHom a ha hfac).hom.hom)
    rw [← e, ← e] at hc
    show d * d' = d' * d
    refine (cancel_mono D.inclusion.hom.hom).1 ?_
    rw [MonObj.mul_comp, MonObj.mul_comp]
    exact hc.eq
  -- Unipotence: values of the restricted embedding on ordered products of values of `f`.
  have hprod : ∀ l : List (Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ G.X),
      (∀ y ∈ l, ∃ v, y = v ≫ f) →
        IsNilpotent ((ρ.rationalMatrix l.prod : Matrix (Fin N) (Fin N) K) - 1) := by
    intro l hl
    have e : (ρ.rationalMatrix l.prod : Matrix (Fin N) (Fin N) K) =
        (l.map fun y => (ρ.rationalMatrix y : Matrix (Fin N) (Fin N) K)).prod :=
      map_list_prod ((Units.coeHom _).comp ρ.rationalMatrix) l
    rw [e]
    refine isNilpotent_list_prod_sub_one
      (fun z => ∃ v, z = (ρ.rationalMatrix (v ≫ f) : Matrix (Fin N) (Fin N) K)) ?_ ?_ _ ?_
    · rintro _ ⟨v, rfl⟩
      exact hvalu v
    · rintro _ _ ⟨v, rfl⟩ ⟨v', rfl⟩
      exact hvalc v v'
    · intro z hz
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hz
      obtain ⟨v, rfl⟩ := hl y hy
      exact ⟨v, rfl⟩
  let ρD := ρ.restrict D.inclusion
  have : IsClosedImmersion D.inclusion.hom.hom.left := D.closed
  have : IsClosedImmersion ρD.hom.hom.left := by
    change IsClosedImmersion (D.inclusion.hom.hom.left ≫ ρ.hom.hom.left)
    infer_instance
  let M : Matrix (Fin N) (Fin N) Γ(D.group.X.left, ⊤) :=
    (ρD.pointMatrix D.group.X (𝟙 _) : Matrix (Fin N) (Fin N) Γ(D.group.X.left, ⊤))
  have hev : ∀ d : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ D.group.X,
      (CentralIntersection.evalPoint d).mapMatrix ((M - 1) ^ Fintype.card (Fin N)) =
        ((ρD.rationalMatrix d : Matrix (Fin N) (Fin N) K) - 1) ^ Fintype.card (Fin N) := by
    intro d
    rw [map_pow, map_sub, map_one, RingHom.mapMatrix_apply, evalPoint_mapMatrix_pointMatrix]
  -- The power map is dominant, so global functions on `D` are detected on its source.
  let p := D.powerMap n
  have hgood := ImageGeneration.finitePowerGood_finitePower _
    (ImageGeneration.finitePowerGood_of_geometricallyIntegral _ hVAff hVFin hVInt) n
  have : IsIntegral (finitePower (G.X ⊗ G.X) n).left := hgood.isIntegral
  have : IsAffine (finitePower (G.X ⊗ G.X) n).left := hgood.isAffine
  have : LocallyOfFiniteType (finitePower (G.X ⊗ G.X) n).hom := hgood.2.1
  have : IsDominant p.left := hDom
  have : IsSchemeTheoreticallyDominant p.left := IsSchemeTheoreticallyDominant.of_isDominant _
  have : QuasiCompact p.left := inferInstance
  have hM : (M - 1) ^ Fintype.card (Fin N) = 0 := by
    ext i j
    refine eq_zero_of_forall_evalPoint_comp_eq_zero p (p.left.app_injective ⊤) _ fun w => ?_
    have h1 := congrFun (congrFun (hev (w ≫ p)) i) j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply] at h1
    rw [h1]
    have hrw : (ρD.rationalMatrix (w ≫ p) : Matrix (Fin N) (Fin N) K) =
        ρ.rationalMatrix (List.ofFn fun i : Fin n =>
          (w ≫ Limits.Pi.π (fun _ : Fin n => G.X ⊗ G.X) i) ≫ f).prod := by
      rw [MatrixRepresentation.rationalMatrix_restrict, D.powerMap_comp_points, orderedPowerMap_points]
    rw [hrw, pow_card_eq_zero_of_isNilpotent (hprod _ fun y hy => ?_), Matrix.zero_apply]
    obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hy
    exact ⟨_, rfl⟩
  have hnilD : ∀ d : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ D.group.X,
      IsNilpotent ((ρD.rationalMatrix d : Matrix (Fin N) (Fin N) K) - 1) := by
    intro d
    refine ⟨Fintype.card (Fin N), ?_⟩
    rw [← hev d, hM, map_zero]
  have hunip : IsUnipotent D.group :=
    isUnipotent_of_eigenvalues ρD hDcomm one_ne_zero fun d c hc => by
      rw [pow_one]
      exact eq_one_of_mem_roots_of_isNilpotent_sub_one (hnilD d) hc
  -- Hence `D` is trivial, `f = 1`, and `h` commutes with every point.
  have hDbot := hG D.group D.inclusion D.closed hD.1 hDc hunip hDn
  have hincl : D.inclusion.hom.hom = 1 := by
    have h1 : 𝟙 D.group.X ≫ D.inclusion.hom.hom ∈
        (SubgroupFunctor.range D.inclusion).carrier D.group.X :=
      SubgroupFunctor.mem_range.mpr ⟨𝟙 _, rfl⟩
    rw [hDbot, SubgroupFunctor.bot_carrier, Subgroup.mem_bot, Category.id_comp] at h1
    exact h1
  have hf1 : f = 1 := by
    rw [← D.factor_comp, hincl, MonObj.comp_one]
  rw [mem_center]
  intro T b y
  have hb : b = toUnit T := toUnit_unique _ _
  have hy := lift_comp_conjCommutatorMap h 1 y
  rw [← hf, hf1, MonObj.comp_one, one_mul, inv_one, mul_one, ← commutatorElement_def] at hy
  rw [hb]
  exact (commutatorElement_eq_one_iff_commute.mp hy.symm).symm

end Main

end Langlands.GroupScheme.CenterQuotient
