import Langlands.GroupScheme.CentralSimpleBinaryDynamic
import Langlands.GroupScheme.CentralSimpleBinaryGeneration
import Langlands.GroupScheme.Rational.DynamicElementarySubgroup

/-! # Actual binary norm-one images in the parabolic elementary subgroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.CentralSimpleUnits.BinaryRoot

variable (k D : Type u) [Field k] [Ring D] [Algebra k D]
  [FiniteDimensional k D] [Algebra.IsCentral k D] [IsSimpleRing D]
  {d : ℕ} (bD : Module.Basis (Fin d) k D)
  {G : GroupScheme (Spec (CommRingCat.of k))}

/-- Each actual elementary rational point maps to an actual geometric
parabolic-radical generator in any connected reductive target. -/
theorem map_elementaryPoint_mem_parabolicUnipotentPointSet
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G) (neg : Bool)
    (x : rationalPoints (FiniteAlgebraUnits.BinaryRoot.additiveScheme k (d := d))) :
    rationalPoints.map f (rationalPoints.map (elementaryMap k D bD neg) x) ∈
      parabolicUnipotentPointSet G := by
  have hx : rationalPoints.map (elementaryMap k D bD neg) x ∈
      (Dynamic.unipotent (cocharacter k D neg)).carrier (Over.mk (𝟙 _)) :=
    elementary_range_le_dynamicUnipotent k D bD neg _
      (SubgroupFunctor.mem_range.mpr ⟨x, rfl⟩)
  exact mem_parabolicUnipotentPointSet_of_dynamicUnipotent hG (cocharacter k D neg ≫ f)
    (Dynamic.unipotent_le_comap (cocharacter k D neg) f _ hx)

/-- Both actual elementary rational images lie in the target's actual
parabolic elementary subgroup. -/
theorem map_elementary_range_le_parabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G) (neg : Bool) :
    ((rationalPoints.map (elementaryMap k D bD neg)).range).map (rationalPoints.map f) ≤
      parabolicElementarySubgroup G := by
  rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
  exact Subgroup.subset_closure
    (map_elementaryPoint_mem_parabolicUnipotentPointSet k D bD hG f neg x)

/-- The whole subgroup generated by the two actual elementary families maps
into the target's actual parabolic elementary subgroup. -/
theorem map_rationalElementarySubgroup_le_parabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G) :
    (rationalElementarySubgroup k D bD).map (rationalPoints.map f) ≤
      parabolicElementarySubgroup G := by
  rw [rationalElementarySubgroup, Subgroup.map_sup]
  exact sup_le
    (map_elementary_range_le_parabolicElementarySubgroup k D bD hG f false)
    (map_elementary_range_le_parabolicElementarySubgroup k D bD hG f true)

/-- The original rational map on the generated elementary subgroup, with
codomain restricted to the target's actual parabolic elementary subgroup. -/
def rationalElementaryPointsToParabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G) :
    rationalElementarySubgroup k D bD →* parabolicElementarySubgroup G :=
  ((rationalPoints.map f).comp (rationalElementarySubgroup k D bD).subtype).codRestrict
    (parabolicElementarySubgroup G) fun x =>
      map_rationalElementarySubgroup_le_parabolicElementarySubgroup k D bD hG f
        ⟨x.val, x.property, rfl⟩

@[simp]
theorem rationalElementaryPointsToParabolicElementarySubgroup_apply_coe
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G)
    (x : rationalElementarySubgroup k D bD) :
    (rationalElementaryPointsToParabolicElementarySubgroup k D bD hG f x :
      rationalPoints G) = rationalPoints.map f x.val := rfl

section DivisionRing

variable {D : Type u} [DivisionRing D] [Algebra k D]
  [FiniteDimensional k D] [Algebra.IsCentral k D]

/-- Coefficient SK1 vanishing puts the full actual binary rational image in the
target's parabolic elementary subgroup. The arithmetic premise is explicit. -/
theorem rationalPoints_range_le_parabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm k D).ker = commutator Dˣ) :
    (rationalPoints.map f).range ≤ parabolicElementarySubgroup G := by
  have h := map_rationalElementarySubgroup_le_parabolicElementarySubgroup
    k D (Module.finBasis k D) hG f
  rw [(rationalElementarySubgroup_eq_top_iff k (Module.finBasis k D)).mpr hSK,
    Subgroup.map_top] at h
  exact h

/-- The actual full point homomorphism with restricted codomain under the
explicit coefficient SK1 equality. -/
def rationalPointsToParabolicElementarySubgroup
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm k D).ker = commutator Dˣ) :
    rationalPoints (groupScheme k D) →* parabolicElementarySubgroup G :=
  (rationalPoints.map f).codRestrict (parabolicElementarySubgroup G) fun x =>
    rationalPoints_range_le_parabolicElementarySubgroup k hG f hSK ⟨x, rfl⟩

@[simp]
theorem rationalPointsToParabolicElementarySubgroup_apply_coe
    (hG : IsConnectedReductive G) (f : groupScheme k D ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm k D).ker = commutator Dˣ)
    (x : rationalPoints (groupScheme k D)) :
    (rationalPointsToParabolicElementarySubgroup k hG f hSK x : rationalPoints G) =
      rationalPoints.map f x := rfl

/-- The full-image containment also holds for any actual ground-field model
identified with the canonical binary norm-one group. -/
theorem rationalPoints_range_le_parabolicElementarySubgroup_of_iso
    {A : GroupScheme (Spec (CommRingCat.of k))}
    (hG : IsConnectedReductive G) (e : A ≅ groupScheme k D) (a : A ⟶ G)
    (hSK : (Langlands.BinaryElementary.Reduced.coefficientNorm k D).ker = commutator Dˣ) :
    (rationalPoints.map a).range ≤ parabolicElementarySubgroup G := by
  have h := rationalPoints_range_le_parabolicElementarySubgroup k hG (e.inv ≫ a) hSK
  rintro _ ⟨x, rfl⟩
  have hx := h ⟨rationalPoints.map e.hom x, rfl⟩
  simpa only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc,
    ← Grp.comp_hom_hom, e.hom_inv_id_assoc] using hx

end DivisionRing

end Langlands.GroupScheme.CentralSimpleUnits.BinaryRoot
