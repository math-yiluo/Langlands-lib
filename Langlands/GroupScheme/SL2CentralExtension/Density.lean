import Mathlib.AlgebraicGeometry.Morphisms.Separated
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.Algebra.Polynomial.Div
import Mathlib.RingTheory.Coprime.Lemmas

/-! # Density helpers for central extensions of `SL₂` -/

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace Langlands.GroupScheme.SL2CentralExtension

/-- Maps into a relatively separated scheme agree if they agree modulo a family of
ideals whose intersection is zero. -/
theorem eq_of_eq_on_quotients {S Z : Scheme.{u}} (p : Z ⟶ S) [IsSeparated p]
    {B : CommRingCat.{u}} {ι : Type u} (I : ι → Ideal B) (hI : ⨅ i, I i = ⊥)
    (f g : Spec B ⟶ Z) (hfg : f ≫ p = g ≫ p)
    (h : ∀ i, Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i))) ≫ f =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i))) ≫ g) : f = g := by
  let X : Over S := Over.mk (f ≫ p)
  let Y : Over S := Over.mk p
  let f' : X ⟶ Y := Over.homMk f
  let g' : X ⟶ Y := Over.homMk g (by exact hfg.symm)
  have : IsSeparated Y.hom := ‹IsSeparated p›
  have : IsAffine X.left := by change IsAffine (Spec B); infer_instance
  let e := (equalizer.ι f' g').left
  have he : IsClosedImmersion e := inferInstance
  have hfactors (i : ι) :
      ∃ k : Spec (.of (B ⧸ I i)) ⟶ (equalizer f' g').left,
        k ≫ e = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i))) := by
    let a : Spec (.of (B ⧸ I i)) ⟶ Spec B :=
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i)))
    let A : Over S := Over.mk (a ≫ f ≫ p)
    let a' : A ⟶ X := Over.homMk a
    have ha : a' ≫ f' = a' ≫ g' := by
      ext1
      exact h i
    exact ⟨(equalizer.lift a' ha).left,
      congrArg CommaMorphism.left (equalizer.lift_ι a' ha)⟩
  have hinj : Function.Injective e.appTop := by
    change Function.Injective e.appTop.hom
    rw [RingHom.injective_iff_ker_eq_bot,
      RingHom.ker_eq_bot_iff_eq_zero]
    intro x hx
    have hxI : (Scheme.ΓSpecIso B).hom x ∈ ⨅ i, I i := by
      simp only [Ideal.mem_iInf]
      intro i
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      obtain ⟨k, hk⟩ := hfactors i
      have hz : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i)))).appTop x = 0 := by
        rw [← hk, Scheme.Hom.comp_appTop]
        change k.appTop.hom (e.appTop.hom x) = 0
        rw [hx, map_zero]
      have hn := congrArg (fun φ => CommRingCat.Hom.hom φ x)
        (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (Ideal.Quotient.mk (I i))))
      change (Scheme.ΓSpecIso (.of (B ⧸ I i))).hom.hom
        ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i)))).appTop.hom x) =
        Ideal.Quotient.mk (I i) ((Scheme.ΓSpecIso B).hom.hom x) at hn
      change (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I i)))).appTop.hom x = 0 at hz
      simpa only [hz, map_zero] using hn.symm
    have hx0 : (Scheme.ΓSpecIso B).hom x = 0 := by
      simpa [hI] using hxI
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso B).hom).1
      (by simpa using hx0)
  have : IsIso e := IsClosedImmersion.isIso_of_injective_of_isAffine hinj
  rw [← cancel_epi e]
  exact congrArg CommaMorphism.left (equalizer.condition f' g')

open Polynomial

/-- The equation cutting out `(n+1)`st roots of unity in the multiplicative group
over the coefficient ring. -/
noncomputable def rootsOfUnityIdeal (A : Type u) [CommRing A] (n : ℕ) :
    Ideal (Localization.Away (X : A[X])) :=
  Ideal.span {algebraMap A[X] (Localization.Away (X : A[X])) (X ^ (n + 1) - 1)}

/-- No nonzero polynomial belongs to every ideal generated by `X^(n+1) - 1`. -/
theorem polynomial_iInf_span_X_pow_sub_one (A : Type u) [CommRing A] :
    (⨅ n : ℕ, Ideal.span {((X : A[X]) ^ (n + 1) - 1)}) = ⊥ := by
  nontriviality A
  apply le_antisymm ?_ bot_le
  intro p hp
  rw [Ideal.mem_bot]
  by_contra hp0
  have hd : (((X : A[X]) ^ (p.natDegree + 1) - 1)).natDegree = p.natDegree + 1 := by
    simpa only [C_1] using
      (natDegree_X_pow_sub_C (R := A) (n := p.natDegree + 1) (r := 1))
  have hdiv : (X : A[X]) ^ (p.natDegree + 1) - 1 ∣ p :=
    Ideal.mem_span_singleton.mp (Ideal.mem_iInf.mp hp p.natDegree)
  exact (monic_X_pow_sub_one (Nat.succ_ne_zero p.natDegree)).not_dvd_of_natDegree_lt
    hp0 (by rw [hd]; omega) hdiv

/-- The roots-of-unity equations are schematically dense in the Laurent polynomial
ring over any commutative ring. -/
theorem iInf_span_X_pow_sub_one (A : Type u) [CommRing A] :
    (⨅ n : ℕ, Ideal.span {algebraMap A[X] (Localization.Away (X : A[X]))
                            (X ^ (n + 1) - 1)}) = ⊥ := by
  let L := Localization.Away (X : A[X])
  apply le_antisymm ?_ bot_le
  intro z hz
  rw [Ideal.mem_bot]
  obtain ⟨p, s, rfl⟩ := IsLocalization.exists_mk'_eq (Submonoid.powers (X : A[X])) z
  have hpI : p ∈ ⨅ n : ℕ, Ideal.span {((X : A[X]) ^ (n + 1) - 1)} := by
    rw [Ideal.mem_iInf]
    intro n
    have hzn : IsLocalization.mk' L p s ∈
        (Ideal.span {((X : A[X]) ^ (n + 1) - 1)}).map (algebraMap A[X] L) := by
      simpa only [Ideal.map_span, Set.image_singleton] using Ideal.mem_iInf.mp hz n
    obtain ⟨t, ht, htp⟩ :=
      (IsLocalization.mk'_mem_map_algebraMap_iff (Submonoid.powers (X : A[X])) L
        (Ideal.span {((X : A[X]) ^ (n + 1) - 1)}) p s).mp hzn
    obtain ⟨k, rfl⟩ := ht
    rw [Ideal.mem_span_singleton] at htp ⊢
    have hc : IsCoprime ((X : A[X]) ^ (n + 1) - 1) X :=
      IsCoprime.sub_one_left_of_dvd (dvd_pow_self X (Nat.succ_ne_zero n))
    exact hc.pow_right.dvd_of_dvd_mul_left htp
  have hp0 : p = 0 := by simpa [polynomial_iInf_span_X_pow_sub_one A] using hpI
  simp [hp0]

end Langlands.GroupScheme.SL2CentralExtension
