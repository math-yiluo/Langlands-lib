import Langlands.GroupScheme.FiniteGeneration
import Langlands.GroupScheme.ImageGenerationPointed

/-! # Smooth connected subgroups generated by arbitrary families -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme

variable {k : Type u} [Field k]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {I : Type v} (A : I → GroupScheme (Spec (CommRingCat.of k))) (a : ∀ j, A j ⟶ G)

/-- A closed subgroup generated by a family, with minimality among arbitrary
closed competitors on every test scheme. -/
def IsGeneratedByFamily {H : GroupScheme (Spec (CommRingCat.of k))} (i : H ⟶ G) : Prop :=
  IsClosedSubgroup i ∧
    (∀ j, FactorsThrough (a j).hom.hom i) ∧
    ∀ (K : GroupScheme (Spec (CommRingCat.of k))) (q : K ⟶ G), IsClosedSubgroup q →
      (∀ j, FactorsThrough (a j).hom.hom q) →
        SubgroupFunctor.range i ≤ SubgroupFunctor.range q

namespace FiniteGeneration

variable {A a}

private theorem family_dimension_le {H : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom] [IsAffineHom H.X.hom] [Smooth G.X.hom]
    (i : H ⟶ G) (hi : IsClosedSubgroup i) :
    Lie.dimension H ≤ Lie.dimension G := by
  let : IsClosedImmersion i.hom.hom.left := hi
  let : Mono i.hom.hom := Over.mono_of_mono_left _
  exact LinearMap.finrank_le_finrank_of_injective (Lie.targetMapLinear_injective i k)

private theorem family_range_represents {H : GroupScheme (Spec (CommRingCat.of k))}
    (i : H ⟶ G) (hi : IsClosedSubgroup i) :
    (SubgroupFunctor.range i).IsRepresentedBy i := by
  let : IsClosedImmersion i.hom.hom.left := hi
  exact ⟨Over.mono_of_mono_left _, rfl⟩

/-- Bounded Lie dimension extracts a smooth connected generated representative
for an arbitrary family from generated representatives for finite subfamilies. -/
theorem exists_generated_family
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (hfinite : ∀ s : Finset I,
      ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
        Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left ∧
          IsGeneratedBySubfamily A a s i) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left ∧
        IsGeneratedByFamily A a i := by
  classical
  let P (n : ℕ) : Prop :=
    ∃ (s : Finset I) (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G)
      (_ : Smooth H.X.hom) (hAff : IsAffineHom H.X.hom)
      (_ : ConnectedSpace H.X.left),
      IsGeneratedBySubfamily A a s i ∧ @Lie.dimension k _ H hAff = n
  have hbound : ∀ n, P n → n ≤ Lie.dimension G := by
    rintro n ⟨s, H, i, hsm, haff, hconn, hi, rfl⟩
    let : Smooth H.X.hom := hsm
    let : IsAffineHom H.X.hom := haff
    exact family_dimension_le i hi.1
  obtain ⟨H₀, i₀, hsm₀, haff₀, hconn₀, hi₀⟩ := hfinite ∅
  let : IsAffineHom H₀.X.hom := haff₀
  have hp₀ : P (Lie.dimension H₀) := ⟨∅, H₀, i₀, hsm₀, haff₀, hconn₀, hi₀, rfl⟩
  obtain ⟨s, H, i, hsm, haff, hconn, hi, hdim⟩ :=
    Nat.findGreatest_spec (P := P) (hbound _ hp₀) hp₀
  let : Smooth H.X.hom := hsm
  let : IsAffineHom H.X.hom := haff
  let : ConnectedSpace H.X.left := hconn
  have hmax : ∀ n, P n → n ≤ Lie.dimension H := by
    intro n hn
    rw [hdim]
    exact Nat.le_findGreatest (hbound n hn) hn
  have hall : ∀ t, FactorsThrough (a t).hom.hom i := by
    intro t
    obtain ⟨E, e, hsmE, haffE, hconnE, he⟩ := hfinite (insert t s)
    let : Smooth E.X.hom := hsmE
    let : IsAffineHom E.X.hom := haffE
    let : ConnectedSpace E.X.left := hconnE
    have hle : SubgroupFunctor.range i ≤ SubgroupFunctor.range e :=
      hi.2.2 E e he.1 (fun j hj => he.2.1 j (Finset.mem_insert_of_mem hj))
    let f : H ⟶ E := (family_range_represents e he.1).factorHom i hle
    have hf : f ≫ e = i := (family_range_represents e he.1).factorHom_comp i hle
    have hclosed : IsClosedSubgroup f :=
      IsClosedSubgroup.of_comp he.1 (by rw [hf]; exact hi.1)
    have hdimE : Lie.dimension E ≤ Lie.dimension H :=
      hmax _ ⟨insert t s, E, e, hsmE, haffE, hconnE, he, rfl⟩
    have hfiso : IsIso f := by
      by_contra hnot
      have hlt := Lie.dimension_lt_of_proper_closedSubgroup f hclosed hnot
      omega
    let : IsIso f := hfiso
    have hinv : inv f ≫ i = e := by
      rw [← hf, IsIso.inv_hom_id_assoc]
    obtain ⟨b, hb⟩ := he.2.1 t (Finset.mem_insert_self _ _)
    refine ⟨b ≫ (inv f).hom.hom, ?_⟩
    rw [Category.assoc, ← Grp.comp_hom_hom, hinv, hb]
  refine ⟨H, i, hsm, haff, hconn, hi.1, hall, ?_⟩
  intro K q hq hfamily
  exact hi.2.2 K q hq (fun j _ => hfamily j)

/-- Pointed-image generation supplies the required finite representatives. -/
theorem exists_generated_family_of_pointedImageGeneration
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (hGeneration : PointedImageGenerationStatement.{u})
    (hA : ∀ j, Smooth (A j).X.hom ∧ IsAffineHom (A j).X.hom ∧
      ConnectedSpace (A j).X.left) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left ∧
        IsGeneratedByFamily A a i :=
  exists_generated_family (fun s => exists_generated_subfamily hGeneration hA s)

/-- Any family of smooth connected affine group schemes has a smooth connected
closed generated subgroup in a smooth affine ambient group. -/
theorem exists_smooth_generated_family
    [Smooth G.X.hom] [IsAffineHom G.X.hom]
    (hA : ∀ j, Smooth (A j).X.hom ∧ IsAffineHom (A j).X.hom ∧
      ConnectedSpace (A j).X.left) :
    ∃ (H : GroupScheme (Spec (CommRingCat.of k))) (i : H ⟶ G),
      Smooth H.X.hom ∧ IsAffineHom H.X.hom ∧ ConnectedSpace H.X.left ∧
        IsGeneratedByFamily A a i :=
  exists_generated_family_of_pointedImageGeneration ImageGeneration.pointedImageGeneration hA

end FiniteGeneration

end Langlands.GroupScheme
