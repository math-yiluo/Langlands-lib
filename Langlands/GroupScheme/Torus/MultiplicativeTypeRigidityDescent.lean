import Langlands.GroupScheme.Torus.CentralRigidityReduction
import Langlands.GroupScheme.Torus.MultiplicativeTypeInfinitesimalRigidityStatement
import Langlands.GroupScheme.FppfHomLocality
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Fppf reduction of infinitesimal rigidity to diagonalizable sources -/

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 800000

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.MultiplicativeTypeRigidity

variable {S T S₀ T₀ : Scheme.{u}} {H G : GroupScheme S}

/-- The zero homomorphism is the unit in the group of underlying maps. -/
theorem eq_zero_iff (f : H ⟶ G) : f = 0 ↔ f.hom.hom = 1 :=
  (CentralRigidity.hom_eq_one_iff_eq_zero f).symm

/-- Triviality after base change propagates along every commutative base square. -/
theorem baseChange_eq_zero_of_square (f : H ⟶ G)
    (b : T ⟶ S) (i : S₀ ⟶ S) (j : T₀ ⟶ T) (b₀ : T₀ ⟶ S₀)
    (hsq : j ≫ b = b₀ ≫ i) (hf : (baseChange i).map f = 0) :
    (baseChange j).map ((baseChange b).map f) = 0 := by
  have hi : (baseChange b₀).map ((baseChange i).map f) = 0 := by
    rw [hf, Functor.map_zero]
  have hd : (baseChange (j ≫ b)).map f = 0 := by
    have he := Descent.pullbackComparison_naturality i b₀ (j ≫ b) hsq.symm f
    rw [hi, zero_comp] at he
    exact (cancel_epi (Descent.pullbackComparison i b₀ (j ≫ b) hsq.symm H).hom).mp
      (he.symm.trans (by simp only [comp_zero]))
  apply (cancel_mono (Descent.pullbackComparison b j (j ≫ b) rfl G).hom).mp
  rw [zero_comp, Descent.pullbackComparison_naturality, hd, comp_zero]

/-- An ideal generated by a nilpotent ideal remains nilpotent under every ring map. -/
theorem isNilpotent_map {A B : Type u} [CommRing A] [CommRing B]
    (φ : A →+* B) (J : Ideal A) (hJ : IsNilpotent J) : IsNilpotent (J.map φ) := by
  obtain ⟨n, hn⟩ := hJ
  refine ⟨n, ?_⟩
  rw [← Ideal.map_pow, hn]
  simp only [Ideal.zero_eq_bot, Ideal.map_bot]

/-- Restricting a homomorphism trivial modulo `J` to an arbitrary affine base
makes it trivial modulo the ideal generated by `J` on that base. -/
theorem baseChange_quotient_eq_zero {A B : Type u} [CommRing A] [CommRing B]
    {H G : GroupScheme (Spec (CommRingCat.of A))} (f : H ⟶ G)
    (J : Ideal A) (b : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of A))
    (hf : (baseChange (Spec.algebraMap A (A ⧸ J))).map f = 0) :
    (baseChange (Spec.algebraMap B (B ⧸ J.map (Spec.preimage b).hom))).map
      ((baseChange b).map f) = 0 := by
  let φ : A →+* B := (Spec.preimage b).hom
  let K := J.map φ
  let φ₀ : A ⧸ J →+* B ⧸ K := Ideal.quotientMap K φ Ideal.le_comap_map
  apply baseChange_eq_zero_of_square f b (Spec.algebraMap A (A ⧸ J))
    (Spec.algebraMap B (B ⧸ K)) (Spec.map (CommRingCat.ofHom φ₀)) ?_ hf
  rw [← Spec.map_preimage b]
  change Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K)) ≫
      Spec.map (CommRingCat.ofHom φ) =
    Spec.map (CommRingCat.ofHom φ₀) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1

/-- An affine-local test for a multiplicative-type-source homomorphism to be trivial.
The test is needed only where the source becomes diagonalizable. -/
theorem eq_zero_of_affine_diagonalizable_baseChanges (f : H ⟶ G)
    (hH : RelativeMultiplicativeType.IsMultiplicativeType H)
    (hlocal : ∀ (B : CommRingCat.{u}) (b : Spec B ⟶ S),
      RelativeMultiplicativeType.IsDiagonalizable ((baseChange b).obj H) →
        (baseChange b).map f = 0) : f = 0 := by
  obtain ⟨𝒰, h𝒰⟩ := hH
  apply hom_ext_of_baseChange_fppfCover 𝒰
  intro k
  rw [Functor.map_zero]
  let 𝒱 : Scheme.Cover.{u} Scheme.fppfPrecoverage (𝒰.X k) :=
    (𝒰.X k).affineOpenCover.openCover.changeProp
      (fun _ => ⟨inferInstance, inferInstance⟩)
  apply hom_ext_of_baseChange_fppfCover 𝒱
  intro l
  rw [Functor.map_zero]
  let b := (𝒰.X k).affineOpenCover.f l ≫ 𝒰.f k
  have hdiag : RelativeMultiplicativeType.IsDiagonalizable ((baseChange b).obj H) := by
    apply RelativeMultiplicativeType.IsDiagonalizable.of_iso
      (Descent.pullbackComparison (𝒰.f k) ((𝒰.X k).affineOpenCover.f l) b rfl H).symm
    exact (h𝒰 k).baseChange ((𝒰.X k).affineOpenCover.f l)
  have hzero := hlocal ((𝒰.X k).affineOpenCover.X l) b hdiag
  apply (cancel_mono (Descent.pullbackComparison (𝒰.f k)
    ((𝒰.X k).affineOpenCover.f l) b rfl G).hom).mp
  have he := Descent.pullbackComparison_naturality (𝒰.f k)
    ((𝒰.X k).affineOpenCover.f l) b rfl f
  exact he.trans (by rw [hzero, comp_zero, zero_comp])

/-- Infinitesimal rigidity for diagonalizable sources over every affine base
implies the unchanged multiplicative-type rigidity proposition. -/
theorem of_diagonalizable
    (hdiag : ∀ (A : Type u) [CommRing A] (J : Ideal A), IsNilpotent J →
      ∀ (G H : GroupScheme (Spec (CommRingCat.of A))) (f : H ⟶ G),
        RelativeMultiplicativeType.IsDiagonalizable H →
          ((baseChange (Spec.algebraMap A (A ⧸ J))).map f).hom.hom = 1 →
            f.hom.hom = 1) : MultiplicativeTypeInfinitesimalRigidityStatement.{u} := by
  intro A _ J hJ G H f hH hf
  apply (eq_zero_iff f).mp
  apply eq_zero_of_affine_diagonalizable_baseChanges f hH
  intro B b hB
  apply (eq_zero_iff _).mpr
  exact hdiag B (J.map (Spec.preimage b).hom)
    (isNilpotent_map (Spec.preimage b).hom J hJ)
    _ _ ((baseChange b).map f) hB
    ((eq_zero_iff _).mp (baseChange_quotient_eq_zero f J b ((eq_zero_iff _).mpr hf)))

end Langlands.GroupScheme.MultiplicativeTypeRigidity
