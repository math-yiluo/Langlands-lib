import Langlands.GroupScheme.Torus.FundamentalWeightPermutation
import Langlands.GroupScheme.Reductive.StarAction
import Langlands.LinearAlgebra.DominantTriangularInvariants

/-! # Star-fixed fundamental weights and Galois-stable integral lattices -/

set_option backward.isDefEq.respectTransparency false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.RootDatum

variable {J X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
    (P : RootDatum J X Y)

/-- Weyl automorphisms act trivially modulo the integral root lattice. -/
theorem weightEquiv_sub_mem_rootSpan_of_weyl (w : P.Aut)
    (hw : w ∈ P.weylGroup) (x : X) :
    w.weightEquiv x - x ∈ P.rootSpan ℤ := by
  apply Langlands.LinearAlgebra.DominantTriangular.sub_mem_rootSpan_of_mem_reflectionGroup
  change w.weightEquiv ∈ Subgroup.closure (Set.range P.reflection)
  rw [← RootPairing.range_weylGroup_weightHom]
  exact ⟨⟨w, hw⟩, rfl⟩

/-- Two root-datum automorphisms with a left Weyl correction induce the same
map modulo the integral root lattice. -/
theorem weightEquiv_sub_mem_rootSpan_of_weyl_correction (θ δ : P.Aut)
    (h : θ * δ⁻¹ ∈ P.weylGroup) (x : X) :
    θ.weightEquiv x - δ.weightEquiv x ∈ P.rootSpan ℤ := by
  have hc := weightEquiv_sub_mem_rootSpan_of_weyl P (θ * δ⁻¹) h (δ.weightEquiv x)
  change θ.weightEquiv ((δ⁻¹).weightEquiv (δ.weightEquiv x)) -
    δ.weightEquiv x ∈ P.rootSpan ℤ at hc
  change θ.weightEquiv (δ.weightEquiv.symm (δ.weightEquiv x)) -
    δ.weightEquiv x ∈ P.rootSpan ℤ at hc
  simpa only [LinearEquiv.symm_apply_apply] using hc

/-- Every full root-datum automorphism preserves the integral root lattice. -/
theorem map_rootSpan_weightEquiv (δ : P.Aut) :
    (P.rootSpan ℤ).map δ.weightEquiv.toLinearMap = P.rootSpan ℤ := by
  change (Submodule.span ℤ (Set.range P.root)).map δ.weightEquiv.toLinearMap = _
  rw [Submodule.map_span, ← Set.range_comp]
  change Submodule.span ℤ (Set.range (δ.weightEquiv ∘ P.root)) = _
  have he : δ.weightEquiv ∘ P.root = P.root ∘ δ.indexEquiv := δ.root_weightMap
  rw [he, δ.indexEquiv.surjective.range_comp]

variable (B : P.Base) (hspan : P.corootSpan ℤ = ⊤)

/-- Based automorphisms carry the fundamental weights by their permutation
of the supplied simple vertices. -/
theorem fundamentalWeightBasis_aut (δ : P.Aut)
    (hb : ∀ a, a ∈ B.support ↔ δ.indexEquiv a ∈ B.support) (v : B.support) :
    δ.weightEquiv (fundamentalWeightBasis P B hspan v) =
      fundamentalWeightBasis P B hspan (δ.indexEquiv.subtypeEquiv hb v) := by
  apply fundamentalWeightBasis_permutation P B hspan
    δ.weightEquiv.toLinearMap δ.coweightEquiv.symm.toLinearMap
    (δ.indexEquiv.subtypeEquiv hb)
  · intro x y
    rw [LinearEquiv.coe_coe, LinearEquiv.coe_coe, δ.toLinearMap_weightEquiv,
      LinearEquiv.apply_symm_apply]
  · intro i
    apply δ.coweightEquiv.injective
    rw [LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply,
      RootPairing.Equiv.coweightEquiv_apply, δ.coroot_coweightMap_apply P P]
    simp only [Equiv.subtypeEquiv_apply, Equiv.symm_apply_apply]

/-- A based automorphism fixing one simple vertex fixes its actual
fundamental weight. -/
theorem fundamentalWeightBasis_fixed_of_based (δ : P.Aut)
    (hb : ∀ a, a ∈ B.support ↔ δ.indexEquiv a ∈ B.support) (v : B.support)
    (hv : δ.indexEquiv v = v) :
    δ.weightEquiv (fundamentalWeightBasis P B hspan v) =
      fundamentalWeightBasis P B hspan v := by
  rw [fundamentalWeightBasis_aut P B hspan δ hb]
  congr 1
  exact Subtype.ext hv

/-- The integral lattice generated by all roots and one fundamental weight
of a supplied base. -/
def fundamentalWeightRootSpan (v : B.support) : Submodule ℤ X :=
  P.rootSpan ℤ ⊔ Submodule.span ℤ {fundamentalWeightBasis P B hspan v}

/-- If an automorphism fixes a fundamental weight modulo the root lattice,
it preserves the lattice generated by the roots and that weight. -/
theorem map_fundamentalWeightRootSpan (δ : P.Aut) (v : B.support)
    (hv : δ.weightEquiv (fundamentalWeightBasis P B hspan v) -
      fundamentalWeightBasis P B hspan v ∈ P.rootSpan ℤ) :
    (fundamentalWeightRootSpan P B hspan v).map δ.weightEquiv.toLinearMap =
      fundamentalWeightRootSpan P B hspan v := by
  let x := fundamentalWeightBasis P B hspan v
  change (P.rootSpan ℤ ⊔ Submodule.span ℤ {x}).map δ.weightEquiv.toLinearMap =
    P.rootSpan ℤ ⊔ Submodule.span ℤ {x}
  rw [Submodule.map_sup, map_rootSpan_weightEquiv, Submodule.map_span]
  simp only [Set.image_singleton, LinearEquiv.coe_coe]
  apply le_antisymm
  · apply sup_le le_sup_left
    apply Submodule.span_le.mpr
    rintro y (rfl : y = δ.weightEquiv x)
    have hx : x ∈ P.rootSpan ℤ ⊔ Submodule.span ℤ {x} :=
      Submodule.mem_sup_right (Submodule.subset_span (Set.mem_singleton x))
    have hdiff : δ.weightEquiv x - x ∈ P.rootSpan ℤ ⊔ Submodule.span ℤ {x} :=
      Submodule.mem_sup_left hv
    change δ.weightEquiv x ∈ P.rootSpan ℤ ⊔ Submodule.span ℤ {x}
    simpa only [sub_add_cancel] using add_mem hdiff hx
  · apply sup_le le_sup_left
    apply Submodule.span_le.mpr
    rintro y (rfl : y = x)
    have hx : δ.weightEquiv x ∈
        P.rootSpan ℤ ⊔ Submodule.span ℤ {δ.weightEquiv x} :=
      Submodule.mem_sup_right (Submodule.subset_span (Set.mem_singleton _))
    have hdiff : δ.weightEquiv x - x ∈
        P.rootSpan ℤ ⊔ Submodule.span ℤ {δ.weightEquiv x} :=
      Submodule.mem_sup_left hv
    change x ∈ P.rootSpan ℤ ⊔ Submodule.span ℤ {δ.weightEquiv x}
    simpa only [sub_sub_cancel] using sub_mem hx hdiff

end Langlands.RootDatum

namespace Langlands.GroupScheme.GaloisPinningData

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
    {G : GroupScheme (Spec (CommRingCat.of k))}
    [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
    (d : GaloisPinningData k K G)
    (hspan : d.toSplitPinning.rootDatum.corootSpan ℤ = ⊤)

/-- When the star action fixes a simple vertex, ordinary Galois action
fixes its fundamental weight modulo the integral root lattice. -/
theorem galoisAction_fundamentalWeight_sub_mem_rootSpan
    (σ : K ≃ₐ[k] K) (v : d.toSplitPinning.base.support)
    (hv : (d.starAction σ).val.indexEquiv v = v) :
    (d.galoisAction σ).weightEquiv
        (Langlands.RootDatum.fundamentalWeightBasis
          d.toSplitPinning.rootDatum d.toSplitPinning.base hspan v) -
      Langlands.RootDatum.fundamentalWeightBasis
        d.toSplitPinning.rootDatum d.toSplitPinning.base hspan v ∈
        d.toSplitPinning.rootDatum.rootSpan ℤ := by
  have hs := Langlands.RootDatum.fundamentalWeightBasis_fixed_of_based
    d.toSplitPinning.rootDatum d.toSplitPinning.base hspan
    (d.starAction σ).val (d.starAction σ).property v hv
  have hc := Langlands.RootDatum.weightEquiv_sub_mem_rootSpan_of_weyl_correction
    d.toSplitPinning.rootDatum (d.starAction σ).val (d.galoisAction σ)
    (d.starAction_mul_galoisAction_inv_mem σ)
    (Langlands.RootDatum.fundamentalWeightBasis
      d.toSplitPinning.rootDatum d.toSplitPinning.base hspan v)
  rw [hs] at hc
  simpa only [neg_sub] using neg_mem hc

/-- A star-fixed vertex gives an ordinary-Galois-stable lattice generated
by the roots and its fundamental weight. -/
theorem galoisAction_map_fundamentalWeightRootSpan
    (σ : K ≃ₐ[k] K) (v : d.toSplitPinning.base.support)
    (hv : (d.starAction σ).val.indexEquiv v = v) :
    (Langlands.RootDatum.fundamentalWeightRootSpan
      d.toSplitPinning.rootDatum d.toSplitPinning.base hspan v).map
        (d.galoisAction σ).weightEquiv.toLinearMap =
      Langlands.RootDatum.fundamentalWeightRootSpan
        d.toSplitPinning.rootDatum d.toSplitPinning.base hspan v :=
  Langlands.RootDatum.map_fundamentalWeightRootSpan
    d.toSplitPinning.rootDatum d.toSplitPinning.base hspan
    (d.galoisAction σ) v (d.galoisAction_fundamentalWeight_sub_mem_rootSpan hspan σ v hv)

end Langlands.GroupScheme.GaloisPinningData
