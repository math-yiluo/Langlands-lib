import Langlands.GroupScheme.Torus.DiagonalizableSourceBaseChange
import Langlands.GroupScheme.Torus.DiagonalizableReductionCoordinates
import Langlands.GroupScheme.Torus.CompleteLocalDeformation.FiniteRigidity

/-! # Rigidity of group-scheme homomorphisms out of diagonalizable groups

Let `R` be a commutative ring, `I` an ideal, `H` a diagonalizable group over `Spec R`, and `G`
an affine group over `Spec R` whose reduction over `R ⧸ I` is diagonalizable. If `R` is
`I`-adically separated, two homomorphisms `H ⟶ G` with equal base change to `Spec (R ⧸ I)` are
equal. The separation hypothesis holds when `R` is noetherian and `I` lies in the Jacobson
radical, and in particular when `R` is finite over a noetherian local ring `A` and `I` is
generated by the maximal ideal of `A`. -/

noncomputable section

universe u

open CategoryTheory Opposite AlgebraicGeometry
open scoped TensorProduct

namespace Langlands.GroupScheme.CompleteLocalDeformation

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

section TensorMap

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- Equal base changes of maps of affine spectra have equal tensor coordinate maps. -/
theorem tensorMap_eq_of_baseChange_eq {A B : Type u} [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (f g : A →ₐ[R] B)
    (h : ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))).map
        ((algSpec (CommRingCat.of R)).map (CommAlgCat.ofHom f).op)).left =
      ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))).map
        ((algSpec (CommRingCat.of R)).map (CommAlgCat.ofHom g).op)).left) :
    Algebra.TensorProduct.map (AlgHom.id S S) f =
      Algebra.TensorProduct.map (AlgHom.id S S) g := by
  rw [HopfMorphismBaseChange.tensorSpecIso_naturality,
    HopfMorphismBaseChange.tensorSpecIso_naturality] at h
  have h' := Spec.map_injective ((cancel_mono _).mp ((cancel_epi _).mp h))
  have h'' := congrArg CommRingCat.Hom.hom h'
  simp only [CommRingCat.hom_ofHom] at h''
  exact AlgHom.coe_ringHom_injective h''

end TensorMap

variable {R : Type u} [CommRing R]

section Standard

variable {M : Type u} [AddCommGroup M]
  {G : GroupScheme (Spec (CommRingCat.of R))} [IsAffine G.X.left]

/-- Homomorphisms from the standard diagonalizable group with equal base change along
`R → S` have equal scalar-extended coordinate maps. -/
theorem tensorMap_diagonalSourceCoordinateMap_eq (S : Type u) [CommRing S] [Algebra R S]
    (f g : (Diagonalizable.groupScheme (CommRingCat.of R) M).toGrp ⟶ G)
    (h : (GroupScheme.baseChange (Spec.algebraMap R S)).map f =
      (GroupScheme.baseChange (Spec.algebraMap R S)).map g) :
    Algebra.TensorProduct.map (AlgHom.id S S) (diagonalSourceCoordinateMap f).hom.toAlgHom =
      Algebra.TensorProduct.map (AlgHom.id S S) (diagonalSourceCoordinateMap g).hom.toAlgHom := by
  apply tensorMap_eq_of_baseChange_eq
  have hm : ∀ φ : (Diagonalizable.groupScheme (CommRingCat.of R) M).toGrp ⟶ G,
      (GroupScheme.baseChange (Spec.algebraMap R S)).map
          ((hopfSpec (CommRingCat.of R)).map (diagonalSourceCoordinateMap φ).op) =
        (GroupScheme.baseChange (Spec.algebraMap R S)).map
            (Diagonalizable.hopfSpecIso (CommRingCat.of R) M).hom ≫
          (GroupScheme.baseChange (Spec.algebraMap R S)).map φ ≫
            (GroupScheme.baseChange (Spec.algebraMap R S)).map
              (AffineCoordinates.hopfSpecIso G).inv := by
    intro φ
    rw [diagonalSourceCoordinateMap_spec, Functor.map_comp, Functor.map_comp]
  have hb : (GroupScheme.baseChange (Spec.algebraMap R S)).map
        ((hopfSpec (CommRingCat.of R)).map (diagonalSourceCoordinateMap f).op) =
      (GroupScheme.baseChange (Spec.algebraMap R S)).map
        ((hopfSpec (CommRingCat.of R)).map (diagonalSourceCoordinateMap g).op) := by
    rw [hm f, hm g, h]
  exact congrArg (fun φ => (Grp.forget _ ⋙ Over.forget _).map φ) hb

/-- Homomorphisms from the standard diagonalizable group with equal base change to
`Spec (R ⧸ I)` have coordinate maps that agree modulo `I`. -/
theorem diagonalSourceCoordinateMap_sub_mem (I : Ideal R)
    (f g : (Diagonalizable.groupScheme (CommRingCat.of R) M).toGrp ⟶ G)
    (h : (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map f =
      (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map g)
    (a : AffineCoordinates.hopfAlgebra G) :
    (diagonalSourceCoordinateMap f).hom a - (diagonalSourceCoordinateMap g).hom a ∈
      I • (⊤ : Submodule R (AddMonoidAlgebra R M)) := by
  have ht := congrArg (fun φ => φ ((1 : R ⧸ I) ⊗ₜ[R] a))
    (tensorMap_diagonalSourceCoordinateMap_eq (R ⧸ I) f g h)
  simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply] at ht
  rw [← one_tmul_eq_zero_iff, TensorProduct.tmul_sub, sub_eq_zero]
  exact ht

/-- **Rigidity for the standard diagonalizable source.** Over an `I`-adically separated base,
homomorphisms from the standard diagonalizable group into an affine group whose coordinate
bialgebra is cocommutative modulo `I` are determined by their base change to `Spec (R ⧸ I)`. -/
theorem diagonalSource_eq_of_baseChange_eq (I : Ideal R)
    (hsep : ∀ x : R, (∀ k : ℕ, x ∈ I ^ k) → x = 0)
    (hcomm : ∀ c : AffineCoordinates.hopfAlgebra G,
      Coalgebra.comul (R := R) c - TensorProduct.comm R _ _ (Coalgebra.comul (R := R) c) ∈
        I • (⊤ : Submodule R
          (AffineCoordinates.hopfAlgebra G ⊗[R] AffineCoordinates.hopfAlgebra G)))
    (f g : (Diagonalizable.groupScheme (CommRingCat.of R) M).toGrp ⟶ G)
    (h : (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map f =
      (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map g) :
    f = g :=
  eq_of_diagonalSourceCoordinates_eq
    (eq_of_sub_mem_smul_top I hsep hcomm _ _ (diagonalSourceCoordinateMap_sub_mem I f g h))

end Standard

variable {G : GroupScheme (Spec (CommRingCat.of R))} [IsAffine G.X.left]

/-- The coordinate bialgebra of an affine group with diagonalizable reduction over `R ⧸ J` is
cocommutative modulo `J`. -/
theorem comul_sub_comm_mem_of_reduction_isDiagonalizable (J : Ideal R)
    (hG : RelativeMultiplicativeType.IsDiagonalizable
      ((GroupScheme.baseChange (Spec.algebraMap R (R ⧸ J))).obj G))
    (c : AffineCoordinates.hopfAlgebra G) :
    Coalgebra.comul (R := R) c - TensorProduct.comm R _ _ (Coalgebra.comul (R := R) c) ∈
      J • (⊤ : Submodule R
        (AffineCoordinates.hopfAlgebra G ⊗[R] AffineCoordinates.hopfAlgebra G)) :=
  comul_sub_comm_mem_of_bialgEquiv J (diagonalizableReductionPresentation G J hG).equiv c

/-- **Rigidity of homomorphisms out of a diagonalizable group.** Let `R` be `I`-adically
separated, `H` diagonalizable, and `G` affine with diagonalizable reduction over `R ⧸ I`.
Homomorphisms `H ⟶ G` with equal base change to `Spec (R ⧸ I)` are equal. -/
theorem eq_of_baseChange_eq_of_isDiagonalizable (I : Ideal R)
    (hsep : ∀ x : R, (∀ k : ℕ, x ∈ I ^ k) → x = 0)
    {H : GroupScheme (Spec (CommRingCat.of R))}
    (hH : RelativeMultiplicativeType.IsDiagonalizable H)
    (hG : RelativeMultiplicativeType.IsDiagonalizable
      ((GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).obj G))
    (f g : H ⟶ G)
    (h : (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map f =
      (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map g) :
    f = g := by
  obtain ⟨M, _, _, ⟨eH⟩⟩ := hH
  let eH' := eH ≪≫ (Diagonalizable.relativeModelIso (CommRingCat.of R) M).symm
  have hcomp : eH'.inv ≫ f = eH'.inv ≫ g := by
    apply diagonalSource_eq_of_baseChange_eq I hsep
      (comul_sub_comm_mem_of_reduction_isDiagonalizable I hG)
    rw [Functor.map_comp, Functor.map_comp, h]
  exact (cancel_epi eH'.inv).mp hcomp

/-- Rigidity over a noetherian base, for an ideal contained in the Jacobson radical. -/
theorem eq_of_baseChange_eq_of_le_jacobson [IsNoetherianRing R] (I : Ideal R)
    (hI : I ≤ Ideal.jacobson ⊥)
    {H : GroupScheme (Spec (CommRingCat.of R))}
    (hH : RelativeMultiplicativeType.IsDiagonalizable H)
    (hG : RelativeMultiplicativeType.IsDiagonalizable
      ((GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).obj G))
    (f g : H ⟶ G)
    (h : (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map f =
      (GroupScheme.baseChange (Spec.algebraMap R (R ⧸ I))).map g) :
    f = g :=
  eq_of_baseChange_eq_of_isDiagonalizable I (eq_zero_of_mem_pow_of_le_jacobson I hI) hH hG f g h

/-- Rigidity over a finite algebra `R` over a noetherian local ring `A`, modulo the extension
of the maximal ideal of `A`. Neither `A` nor `R` needs to be complete, and `R` need not be
local. -/
theorem eq_of_baseChange_eq_of_finite {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] [Algebra A R] [Module.Finite A R]
    {H : GroupScheme (Spec (CommRingCat.of R))}
    (hH : RelativeMultiplicativeType.IsDiagonalizable H)
    (hG : RelativeMultiplicativeType.IsDiagonalizable
      ((GroupScheme.baseChange (Spec.algebraMap R
        (R ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A R)))).obj G))
    (f g : H ⟶ G)
    (h : (GroupScheme.baseChange (Spec.algebraMap R
        (R ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A R)))).map f =
      (GroupScheme.baseChange (Spec.algebraMap R
        (R ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A R)))).map g) :
    f = g :=
  eq_of_baseChange_eq_of_isDiagonalizable _ (eq_zero_of_mem_map_maximalIdeal_pow (A := A))
    hH hG f g h

end Langlands.GroupScheme.CompleteLocalDeformation
