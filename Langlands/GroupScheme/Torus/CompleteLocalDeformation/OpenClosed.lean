import Langlands.Algebra.GroupAlgebraCoaction
import Mathlib.RingTheory.Finiteness.Nakayama
import Mathlib.RingTheory.Jacobson.Ideal
import Mathlib.RingTheory.Noetherian.Defs

/-! # Bialgebra maps to group algebras that are isomorphisms modulo a small ideal

Let `π : A → K[N]` be a bialgebra map from a noetherian commutative bialgebra. Suppose that
`π` is surjective and injective modulo an ideal `I` contained in the Jacobson radical of `K`.
Then `π` is surjective and its kernel is generated by an idempotent. Geometrically,
`Spec π : D(N) → Spec A` is both a closed and an open immersion. -/

noncomputable section

universe u v w

open TensorProduct Coalgebra

namespace Langlands.GroupScheme.CompleteLocalDeformation

open Langlands.GroupAlgebraCoaction

section Module

variable {K : Type u} [CommRing K]

/-- Linear maps send `I • ⊤` into `I • ⊤`. -/
theorem map_mem_smul_top {M M' : Type*} [AddCommGroup M] [Module K M] [AddCommGroup M']
    [Module K M'] (f : M →ₗ[K] M') (I : Ideal K) {x : M} (hx : x ∈ I • (⊤ : Submodule K M)) :
    f x ∈ I • (⊤ : Submodule K M') := by
  refine Submodule.smul_induction_on hx (fun r hr y _ => ?_) (fun a b ha hb => ?_)
  · rw [map_smul]; exact Submodule.smul_mem_smul hr trivial
  · rw [map_add]; exact add_mem ha hb

/-- Linear forms send `I • ⊤` into `I`. -/
theorem form_mem_of_mem_smul_top {M : Type*} [AddCommGroup M] [Module K M] (f : M →ₗ[K] K)
    (I : Ideal K) {x : M} (hx : x ∈ I • (⊤ : Submodule K M)) : f x ∈ I := by
  refine Submodule.smul_induction_on hx (fun r hr y _ => ?_) (fun a b ha hb => ?_)
  · rw [map_smul, smul_eq_mul]; exact I.mul_mem_right _ hr
  · rw [map_add]; exact I.add_mem ha hb

end Module

section Bialgebra

variable {K : Type u} [CommRing K] {N : Type w} [AddCommGroup N]
variable {A : Type v} [CommRing A] [Bialgebra K A] (π : A →ₐc[K] AddMonoidAlgebra K N)

/-- A homogeneous element of degree `n` is sent by `π` to its counit times `xⁿ`. -/
theorem apply_of_mem_grade {n : N} {b : A} (hb : b ∈ grade π n) :
    π b = AddMonoidAlgebra.single n (counit (R := K) b) := by
  classical
  ext m
  rw [← counit_proj, proj_of_mem π hb, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  by_cases h : m = n
  · subst h; simp
  · simp [h, Ne.symm h]

/-- The kernel of `π` is stable under the homogeneous projections. -/
theorem proj_mem_ker {a : A} (ha : π a = 0) (m : N) : π (proj π m a) = 0 := by
  rw [apply_of_mem_grade π (proj_mem π m a), counit_proj, ha]
  simp

/-- If every degree contains an element whose image has a unit coefficient in that degree,
then every degree contains an element sent to `xⁿ`. -/
theorem exists_mem_grade_apply_eq_single (hsurj : ∀ n : N, ∃ a : A, IsUnit ((π a).coeff n))
    (n : N) : ∃ y ∈ grade π n, π y = AddMonoidAlgebra.single n 1 := by
  obtain ⟨a, ha⟩ := hsurj n
  refine ⟨(↑ha.unit⁻¹ : K) • proj π n a, (grade π n).smul_mem _ (proj_mem π n a), ?_⟩
  rw [apply_of_mem_grade π ((grade π n).smul_mem _ (proj_mem π n a)), map_smul, counit_proj,
    smul_eq_mul, IsUnit.val_inv_mul]

/-- **Open and closed immersion criterion.** Let `π : A → K[N]` be a bialgebra map from a
noetherian bialgebra and `I` an ideal in the Jacobson radical of `K`. If every degree `n`
contains an element whose image has a unit `n`-th coefficient, and `π` is injective modulo
`I`, then `π` is surjective and its kernel is generated by an idempotent. -/
theorem surjective_and_ker_eq_span_idempotent [IsNoetherianRing A] (I : Ideal K)
    (hI : I ≤ Ideal.jacobson (⊥ : Ideal K))
    (hsurj : ∀ n : N, ∃ a : A, IsUnit ((π a).coeff n))
    (hinj : ∀ a : A, π a ∈ I • (⊤ : Submodule K (AddMonoidAlgebra K N)) →
      a ∈ I • (⊤ : Submodule K A)) :
    Function.Surjective π ∧ ∃ e : A, IsIdempotentElem e ∧
      RingHom.ker (π : A →ₐ[K] AddMonoidAlgebra K N) = Ideal.span {e} := by
  classical
  choose y hy hπy using exists_mem_grade_apply_eq_single π hsurj
  -- a linear section of `π`
  let s : AddMonoidAlgebra K N →ₗ[K] A :=
    Finsupp.linearCombination K y ∘ₗ (AddMonoidAlgebra.coeffLinearEquiv K).toLinearMap
  have hs : ∀ p, π (s p) = p := by
    intro p
    induction p using AddMonoidAlgebra.induction_linear with
    | zero => simp
    | add p q hp hq => rw [map_add, map_add, hp, hq]
    | single n c =>
      simp only [s, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe]
      rw [show (AddMonoidAlgebra.coeffLinearEquiv K) (AddMonoidAlgebra.single n c) =
          Finsupp.single n c from rfl, Finsupp.linearCombination_single, map_smul, hπy,
        AddMonoidAlgebra.smul_single', mul_one]
  refine ⟨fun p => ⟨s p, hs p⟩, ?_⟩
  set ker := RingHom.ker (π : A →ₐ[K] AddMonoidAlgebra K N) with hker
  have mem_ker : ∀ a : A, a ∈ ker ↔ π a = 0 := fun a => RingHom.mem_ker
  -- the projection onto the kernel along the section
  let P : A →ₗ[K] A := LinearMap.id - s ∘ₗ (π : A →ₗ[K] AddMonoidAlgebra K N)
  have hP : ∀ a, P a ∈ ker := by
    intro a
    rw [mem_ker]
    simp [P, hs]
  have hPk : ∀ k ∈ ker, P k = k := by
    intro k hk
    rw [mem_ker] at hk
    simp [P, hk]
  -- `ker = I • ker`
  have hle : ker ≤ (I.map (algebraMap K A)) • ker := by
    intro k hk
    have hk' : k ∈ I • (⊤ : Submodule K A) := by
      apply hinj
      rw [(mem_ker k).mp hk]
      exact zero_mem _
    rw [← hPk k hk]
    refine Submodule.smul_induction_on hk' (fun r hr a _ => ?_) (fun a b ha hb => ?_)
    · rw [map_smul, Algebra.smul_def r (P a)]
      exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem (algebraMap K A) hr) (hP a)
    · rw [map_add]; exact add_mem ha hb
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
    (I.map (algebraMap K A)) ker (IsNoetherian.noetherian ker) hle
  -- the degree-zero part of `r` also kills the kernel
  set r₀ := proj π 0 r with hr₀
  have hr₀k : ∀ k ∈ ker, r₀ * k = 0 := by
    intro k hk
    have hhom : ∀ m, r₀ * proj π m k = 0 := by
      intro m
      have h1 : r * proj π m k = 0 := by
        have := hr (proj π m k) ((mem_ker _).mpr (proj_mem_ker π ((mem_ker k).mp hk) m))
        rwa [smul_eq_mul] at this
      have h2 := proj_mul_of_mem π m r (proj_mem π m k)
      rw [h1, map_zero, sub_self] at h2
      exact h2.symm
    rw [← sum_proj π k, Finset.mul_sum]
    exact Finset.sum_eq_zero fun m _ => hhom m
  -- the counit of `r₀` is a unit
  have hu : IsUnit (counit (R := K) r₀) := by
    apply Ideal.isUnit_of_sub_one_mem_jacobson_bot
    apply hI
    rw [hr₀, counit_proj]
    have hr1' : r - 1 ∈ I • (⊤ : Submodule K A) := by
      rw [Ideal.smul_top_eq_map]; exact hr1
    have := form_mem_of_mem_smul_top (coeffForm π 0) I hr1'
    simpa [AddMonoidAlgebra.one_def] using this
  set r' := (↑hu.unit⁻¹ : K) • r₀ with hr'
  have hr'grade : r' ∈ grade π 0 := (grade π 0).smul_mem _ (proj_mem π 0 r)
  have hπr' : π r' = 1 := by
    rw [apply_of_mem_grade π hr'grade, hr', map_smul, smul_eq_mul, IsUnit.val_inv_mul,
      AddMonoidAlgebra.one_def]
  have hr'k : ∀ k ∈ ker, r' * k = 0 := by
    intro k hk
    rw [hr', smul_mul_assoc, hr₀k k hk, smul_zero]
  have hr'1 : r' - 1 ∈ ker := by
    rw [mem_ker, map_sub, hπr', map_one, sub_self]
  have hidem : IsIdempotentElem r' := by
    have := hr'k _ hr'1
    rw [mul_sub, mul_one, sub_eq_zero] at this
    exact this
  refine ⟨1 - r', hidem.one_sub, le_antisymm (fun k hk => ?_) ?_⟩
  · rw [Ideal.mem_span_singleton']
    refine ⟨k, ?_⟩
    rw [mul_sub, mul_one, mul_comm, hr'k k hk, sub_zero]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have : 1 - r' = -(r' - 1) := by abel
    rw [SetLike.mem_coe, this]
    exact neg_mem hr'1

end Bialgebra

end Langlands.GroupScheme.CompleteLocalDeformation
