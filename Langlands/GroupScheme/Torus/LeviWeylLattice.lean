import Langlands.GroupScheme.Torus.FundamentalWeightPermutation
import Mathlib.LinearAlgebra.RootSystem.WeylGroup

/-! # Reflection-generated subgroups fix Levi character complements -/

noncomputable section

namespace Langlands.RootDatum

variable {J X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  (P : RootDatum J X Y)

/-- The root-datum automorphisms generated by reflections with indices in `s`. -/
def reflectionSubgroup (s : Set J) : Subgroup P.Aut :=
  Subgroup.closure (RootPairing.Equiv.reflection P '' s)

theorem reflectionSubgroup_le_weylGroup (s : Set J) :
    reflectionSubgroup P s ≤ P.weylGroup := by
  rw [reflectionSubgroup, Subgroup.closure_le]
  rintro _ ⟨i, _, rfl⟩
  exact P.reflection_mem_weylGroup i

/-- A vector annihilating the selected coroots is fixed by the subgroup
generated by the corresponding reflections. -/
theorem reflectionSubgroup_fixed (s : Set J) (x : X)
    (hx : ∀ i ∈ s, P.toLinearMap x (P.coroot i) = 0)
    {w : P.Aut} (hw : w ∈ reflectionSubgroup P s) :
    w.weightEquiv x = x := by
  have hsub : reflectionSubgroup P s ≤ MulAction.stabilizer P.Aut x := by
    rw [reflectionSubgroup, Subgroup.closure_le]
    rintro _ ⟨i, hi, rfl⟩
    change P.reflection i x = x
    rw [RootPairing.reflection_apply]
    change x - P.toLinearMap x (P.coroot i) • P.root i = x
    rw [hx i hi, zero_smul, sub_zero]
  exact hsub hw

variable (B : P.Base) (hspan : P.corootSpan ℤ = ⊤)

/-- The subgroup generated by selected simple reflections fixes the
complementary fundamental-weight span pointwise. -/
theorem reflectionSubgroup_fixes_complement (s : Set B.support)
    {w : P.Aut} (hw : w ∈ reflectionSubgroup P (Subtype.val '' s))
    {x : X}
    (hx : x ∈ Langlands.PermutationBasis.complementSpan
      (fundamentalWeightBasis P B hspan) s) :
    w.weightEquiv x = x := by
  apply reflectionSubgroup_fixed P _ x _ hw
  rintro _ ⟨i, hi, rfl⟩
  exact (mem_fundamentalWeight_complement_iff P B hspan s x).mp hx i hi

/-- A map whose range is the complementary fundamental-weight span has
pointwise fixed image under every selected-reflection correction. -/
theorem reflectionSubgroup_fixes_image
    {N : Type*} [AddCommGroup N] (s : Set B.support) (f : N →ₗ[ℤ] X)
    (hrange : f.range = Langlands.PermutationBasis.complementSpan
      (fundamentalWeightBasis P B hspan) s)
    {w : P.Aut} (hw : w ∈ reflectionSubgroup P (Subtype.val '' s)) (x : N) :
    w.weightEquiv (f x) = f x := by
  apply reflectionSubgroup_fixes_complement P B hspan s hw
  rw [← hrange]
  exact LinearMap.mem_range_self f x

end Langlands.RootDatum
