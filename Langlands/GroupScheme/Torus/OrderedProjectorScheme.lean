import Langlands.AlgebraicGeometry.PolynomialSpecPoints
import Mathlib.Data.Matrix.Basic
import Mathlib.RingTheory.Ideal.IdempotentFG

/-! # Ordered complete families of matrix projectors -/

noncomputable section

open CategoryTheory AlgebraicGeometry Opposite MvPolynomial

universe u

namespace Langlands.GroupScheme.OrderedProjectorScheme

section EntryIdeal

variable {A B : Type*} [CommRing A] [CommRing B] {n : Type*}

/-- The ideal generated by all entries of a matrix. -/
def entryIdeal (P : Matrix n n A) : Ideal A :=
  Ideal.span (Set.range fun ij : n × n => P ij.1 ij.2)

/-- Entry ideals commute with scalar extension. -/
theorem entryIdeal_map [Fintype n] [DecidableEq n] (f : A →+* B) (P : Matrix n n A) :
    entryIdeal (f.mapMatrix P) = (entryIdeal P).map f := by
  rw [entryIdeal, entryIdeal, Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨ij, rfl⟩
    exact ⟨P ij.1 ij.2, ⟨ij, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨ij, rfl⟩, rfl⟩
    exact ⟨ij, rfl⟩

/-- A matrix is zero exactly when its entry ideal is zero. -/
theorem entryIdeal_eq_bot (P : Matrix n n A) : entryIdeal P = ⊥ ↔ P = 0 := by
  rw [entryIdeal, Ideal.span_eq_bot]
  constructor
  · intro h
    ext i j
    exact h _ ⟨(i, j), rfl⟩
  · rintro rfl _ ⟨⟨i, j⟩, rfl⟩
    rfl

variable [Fintype n]

/-- The entry ideal of an idempotent matrix is idempotent. -/
theorem entryIdeal_isIdempotent (P : Matrix n n A) (hP : P * P = P) :
    IsIdempotentElem (entryIdeal P) := by
  apply le_antisymm Ideal.mul_le_left
  apply Ideal.span_le.mpr
  rintro _ ⟨⟨i, j⟩, rfl⟩
  change P i j ∈ entryIdeal P * entryIdeal P
  rw [← congrFun (congrFun hP i) j, Matrix.mul_apply]
  exact (entryIdeal P * entryIdeal P).sum_mem fun k _ =>
    Ideal.mul_mem_mul
      (show P i k ∈ entryIdeal P from Ideal.subset_span ⟨(i, k), rfl⟩)
      (show P k j ∈ entryIdeal P from Ideal.subset_span ⟨(k, j), rfl⟩)

/-- The entry ideal of an idempotent matrix admits an idempotent generator. -/
theorem exists_entryIdeal_generator (P : Matrix n n A) (hP : P * P = P) :
    ∃ e : A, IsIdempotentElem e ∧ entryIdeal P = Ideal.span {e} := by
  have hfg : (entryIdeal P).FG := Submodule.fg_span (Set.finite_range _)
  obtain ⟨e, he, hgen⟩ :=
    ((entryIdeal P).isIdempotentElem_iff_of_fg hfg).mp (entryIdeal_isIdempotent P hP)
  exact ⟨e, he, hgen⟩

end EntryIdeal

variable (ι n : Type) [Fintype ι] [DecidableEq ι] [Fintype n] [DecidableEq n]

/-- An ordered complete family of pairwise orthogonal projectors, each of which is nonzero
in every residue field. The unit entry ideal expresses the last condition. -/
@[ext]
structure Family (A : Type u) [CommRing A] where
  matrix : ι → Matrix n n A
  mul_eq : ∀ i j, matrix i * matrix j = if i = j then matrix i else 0
  sum_eq : ∑ i, matrix i = 1
  entryIdeal_eq_top : ∀ i, entryIdeal (matrix i) = ⊤

variable {ι n}

/-- Scalar extension of an ordered projector family. -/
def Family.map {A B : Type u} [CommRing A] [CommRing B]
    (f : A →+* B) (P : Family ι n A) : Family ι n B where
  matrix i := f.mapMatrix (P.matrix i)
  mul_eq i j := by
    rw [← map_mul, P.mul_eq]
    split_ifs <;> simp
  sum_eq := by rw [← map_sum, P.sum_eq, map_one]
  entryIdeal_eq_top i := by rw [entryIdeal_map, P.entryIdeal_eq_top, Ideal.map_top]

variable (ι n) (R : Type u) [CommRing R]

/-- The generic matrices indexed by the prescribed labels. -/
private def generic (i : ι) : Matrix n n (MvPolynomial (ι × n × n) R) :=
  Matrix.of fun a b => X (i, a, b)

/-- The equations of completeness and orthogonality in the generic coordinates. -/
private def relationIdeal : Ideal (MvPolynomial (ι × n × n) R) :=
  Ideal.span
    (Set.range (fun ijab : ι × ι × n × n =>
      (generic ι n R ijab.1 * generic ι n R ijab.2.1 -
        if ijab.1 = ijab.2.1 then generic ι n R ijab.1 else 0) ijab.2.2.1 ijab.2.2.2) ∪
      Set.range (fun ab : n × n => ((∑ i, generic ι n R i) - 1) ab.1 ab.2))

private abbrev RawRing := MvPolynomial (ι × n × n) R ⧸ relationIdeal ι n R

private abbrev rawQuotient : MvPolynomial (ι × n × n) R →ₐ[R] RawRing ι n R :=
  Ideal.Quotient.mkₐ R (relationIdeal ι n R)

private def rawMatrix (i : ι) : Matrix n n (RawRing ι n R) :=
  (rawQuotient ι n R).mapMatrix (generic ι n R i)

private theorem rawMatrix_mul (i j : ι) :
    rawMatrix ι n R i * rawMatrix ι n R j = if i = j then rawMatrix ι n R i else 0 := by
  have h : (rawQuotient ι n R).mapMatrix
      (generic ι n R i * generic ι n R j - if i = j then generic ι n R i else 0) = 0 := by
    ext a b
    rw [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.zero_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Or.inl ⟨(i, j, a, b), rfl⟩)
  simp only [map_sub, map_mul, sub_eq_zero, rawMatrix] at h ⊢
  split_ifs at h ⊢ <;> simpa only [map_zero] using h

private theorem rawMatrix_sum : ∑ i, rawMatrix ι n R i = 1 := by
  have h : (rawQuotient ι n R).mapMatrix ((∑ i, generic ι n R i) - 1) = 0 := by
    ext a b
    rw [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.zero_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Or.inr ⟨(a, b), rfl⟩)
  rwa [map_sub, map_sum, map_one, sub_eq_zero] at h

private def support (i : ι) : RawRing ι n R :=
  (exists_entryIdeal_generator (rawMatrix ι n R i) (by rw [rawMatrix_mul, ite_eq_left rfl])).choose

private theorem support_spec (i : ι) :
    IsIdempotentElem (support ι n R i) ∧
      entryIdeal (rawMatrix ι n R i) = Ideal.span {support ι n R i} :=
  (exists_entryIdeal_generator (rawMatrix ι n R i)
    (by rw [rawMatrix_mul, ite_eq_left rfl])).choose_spec

private def supportIdeal : Ideal (RawRing ι n R) :=
  Ideal.span (Set.range fun i => 1 - support ι n R i)

/-- The coordinate ring of ordered complete orthogonal projectors that are nonzero in every
residue field. -/
abbrev CoordinateRing := RawRing ι n R ⧸ supportIdeal ι n R

private abbrev supportQuotient : RawRing ι n R →ₐ[R] CoordinateRing ι n R :=
  Ideal.Quotient.mkₐ R (supportIdeal ι n R)

private theorem supportQuotient_apply_support (i : ι) :
    supportQuotient ι n R (support ι n R i) = 1 := by
  have h : supportQuotient ι n R (1 - support ι n R i) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  rw [map_sub, map_one, sub_eq_zero] at h
  exact h.symm

/-- The universal ordered family over the coordinate ring. -/
def universal : Family ι n (CoordinateRing ι n R) where
  matrix i := (supportQuotient ι n R).toRingHom.mapMatrix (rawMatrix ι n R i)
  mul_eq i j := by
    let f := (supportQuotient ι n R).toRingHom.mapMatrix (m := n)
    change f (rawMatrix ι n R i) * f (rawMatrix ι n R j) =
      if i = j then f (rawMatrix ι n R i) else 0
    rw [← map_mul f, rawMatrix_mul]
    split_ifs <;> simp only [map_zero]
  sum_eq := by rw [← map_sum, rawMatrix_sum, map_one]
  entryIdeal_eq_top i := by
    rw [entryIdeal_map, (support_spec ι n R i).2, Ideal.map_span, Set.image_singleton,
      show (supportQuotient ι n R).toRingHom (support ι n R i) = 1 from
        supportQuotient_apply_support ι n R i, Ideal.span_singleton_one]

variable {ι n R} {A : Type u} [CommRing A] [Algebra R A]

private def value (P : Family ι n A) (iab : ι × n × n) : A := P.matrix iab.1 iab.2.1 iab.2.2

private theorem aeval_generic (P : Family ι n A) (i : ι) :
    (aeval (R := R) (value P)).mapMatrix (generic ι n R i) = P.matrix i := by
  ext a b
  simp [value, generic]

private theorem relationIdeal_le_ker (P : Family ι n A) :
    relationIdeal ι n R ≤ RingHom.ker (aeval (R := R) (value P)) := by
  refine Ideal.span_le.mpr ?_
  rintro _ (⟨⟨i, j, a, b⟩, rfl⟩ | ⟨⟨a, b⟩, rfl⟩)
  · change (aeval (R := R) (value P)).mapMatrix
      (generic ι n R i * generic ι n R j - if i = j then generic ι n R i else 0) a b = 0
    rw [map_sub, map_mul, aeval_generic, aeval_generic, P.mul_eq]
    split_ifs
    · rw [aeval_generic, sub_self, Matrix.zero_apply]
    · rw [map_zero, sub_self, Matrix.zero_apply]
  · change (aeval (R := R) (value P)).mapMatrix ((∑ i, generic ι n R i) - 1) a b = 0
    rw [map_sub, map_sum, map_one]
    simp only [aeval_generic, P.sum_eq, sub_self, Matrix.zero_apply]

private def rawClassify (P : Family ι n A) : RawRing ι n R →ₐ[R] A :=
  Ideal.Quotient.liftₐ _ (aeval (value P)) fun _ h => RingHom.mem_ker.mp (relationIdeal_le_ker P h)

private theorem rawClassify_matrix (P : Family ι n A) (i : ι) :
    (rawClassify (R := R) P).toRingHom.mapMatrix (rawMatrix ι n R i) = P.matrix i := by
  ext a b
  change ((rawClassify (R := R) P).comp (rawQuotient ι n R)) (generic ι n R i a b) =
    P.matrix i a b
  rw [rawClassify, Ideal.Quotient.liftₐ_comp]
  exact congrFun (congrFun (aeval_generic (R := R) P i) a) b

private theorem rawClassify_support (P : Family ι n A) (i : ι) :
    rawClassify (R := R) P (support ι n R i) = 1 := by
  have h := P.entryIdeal_eq_top i
  rw [← rawClassify_matrix (R := R) P i, entryIdeal_map, (support_spec ι n R i).2,
    Ideal.map_span, Set.image_singleton, Ideal.span_singleton_eq_top] at h
  have hidem := (support_spec ι n R i).1.map (rawClassify P)
  exact (IsIdempotentElem.iff_eq_one_of_isUnit h).mp hidem

/-- The algebra map classifying an ordered projector family. -/
def classify (P : Family ι n A) : CoordinateRing ι n R →ₐ[R] A :=
  Ideal.Quotient.liftₐ _ (rawClassify P) fun x hx => by
    have hker : supportIdeal ι n R ≤ RingHom.ker (rawClassify P) := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_one, rawClassify_support, sub_self]
    exact RingHom.mem_ker.mp (hker hx)

private theorem classify_matrix (P : Family ι n A) (i : ι) :
    (classify (R := R) P).toRingHom.mapMatrix ((universal ι n R).matrix i) = P.matrix i := by
  ext a b
  change ((classify (R := R) P).comp (supportQuotient ι n R)) (rawMatrix ι n R i a b) =
    P.matrix i a b
  rw [classify, Ideal.Quotient.liftₐ_comp]
  exact congrFun (congrFun (rawClassify_matrix (R := R) P i) a) b

/-- Algebra maps from the coordinate ring are determined by the universal projector entries. -/
theorem hom_ext {f g : CoordinateRing ι n R →ₐ[R] A}
    (h : ∀ i a b, f ((universal ι n R).matrix i a b) = g ((universal ι n R).matrix i a b)) :
    f = g := by
  apply Ideal.Quotient.algHom_ext
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  rintro ⟨i, a, b⟩
  exact h i a b

/-- An algebra point of the chart is equivalently an ordered projector family. -/
def homEquiv : (CoordinateRing ι n R →ₐ[R] A) ≃ Family ι n A where
  toFun f := (universal ι n R).map f.toRingHom
  invFun := classify (R := R)
  left_inv f := by
    apply hom_ext (R := R)
    intro i a b
    let P := (universal ι n R).map f.toRingHom
    change (classify (R := R) P) ((universal ι n R).matrix i a b) = P.matrix i a b
    exact congrFun (congrFun (classify_matrix (R := R) P i) a) b
  right_inv P := by
    apply Family.ext
    funext i
    change (classify (R := R) P).toRingHom.mapMatrix ((universal ι n R).matrix i) = P.matrix i
    exact classify_matrix (R := R) P i

section Scheme

variable (R : CommRingCat.{u}) (ι n)

/-- The affine scheme of ordered projector families over `Spec R`. -/
abbrev scheme : Over (Spec R) :=
  (algSpec R).obj (op (CommAlgCat.of R (CoordinateRing ι n R)))

instance : IsAffine (scheme ι n R).left := inferInstanceAs (IsAffine (Spec _))

/-- The points on an arbitrary test scheme are the projector families over its global functions. -/
def pointsEquiv (T : Over (Spec R)) : (T ⟶ scheme ι n R) ≃ Family ι n Γ(T.left, ⊤) :=
  ((algΓAlgSpecAdjunction R).homEquiv T (op (CommAlgCat.of R (CoordinateRing ι n R)))).symm.trans
    (Equiv.mk (fun f => f.unop.hom) (fun f => (CommAlgCat.ofHom f).op) (fun _ => rfl)
      (fun _ => rfl)) |>.trans (OrderedProjectorScheme.homEquiv (R := R))

/-- Classifying projectors is natural in the test scheme. -/
theorem pointsEquiv_naturality {T T' : Over (Spec R)} (b : T' ⟶ T) (x : T ⟶ scheme ι n R) :
    pointsEquiv ι n R T' (b ≫ x) = (pointsEquiv ι n R T x).map b.left.appTop.hom := by
  apply Family.ext
  funext i
  ext a c
  change (((algΓAlgSpecAdjunction R).homEquiv T' _).symm (b ≫ x)).unop.hom
      ((universal ι n R).matrix i a c) =
    b.left.appTop ((((algΓAlgSpecAdjunction R).homEquiv T _).symm x).unop.hom
      ((universal ι n R).matrix i a c))
  rw [Langlands.AlgebraicGeometry.PolynomialSpecPoints.adjunction_homEquiv_symm_apply,
    Langlands.AlgebraicGeometry.PolynomialSpecPoints.adjunction_homEquiv_symm_apply,
    Over.comp_left, Scheme.Hom.comp_appTop]
  rfl

end Scheme

end Langlands.GroupScheme.OrderedProjectorScheme
