import Langlands.GroupScheme.Torus.Lattice
import Langlands.Geometry.Building.CocharacterUniformizerEvaluation

/-! # Rational points of a split torus are products of cocharacter values -/

set_option autoImplicit false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

variable {K : Type u} [Field K]

/-- Every rational point of the standard split torus is the product of the values of the
coordinate cocharacters at its coordinates. -/
theorem splitTorus.eq_prod_single {I : Type u} [Fintype I]
    (y : rationalPoints (splitTorus (Spec (CommRingCat.of K)) I)) :
    y = ∏ j, (Gm.pointsEquiv _ (Over.mk (𝟙 (Spec (CommRingCat.of K))))).symm
        (splitTorus.pointsEquiv I (Over.mk (𝟙 _)) y j) ≫
      (CommGroupScheme.groupHom (splitTorus.single _ I j)).hom.hom := by
  classical
  apply (splitTorus.pointsEquiv I (Over.mk (𝟙 (Spec (CommRingCat.of K))))).injective
  rw [map_prod]
  simp only [splitTorus.pointsEquiv_comp_single, MulEquiv.apply_symm_apply]
  exact (Finset.univ_prod_mulSingle _).symm

/-- **Split tori are generated by cocharacter values.** For a split torus `S` over a field
there are finitely many cocharacters `ν_j` such that every rational point is a product
`∏ ν_j(x_j)`. -/
theorem IsSplitTorus.exists_cocharacterPoints_prod
    {S : CommGroupScheme (Spec (CommRingCat.of K))} (hS : IsSplitTorus S.toGrp) :
    ∃ (J : Type u) (_ : Fintype J) (ν : J → cocharacterLattice S),
      ∀ t : rationalPoints S.toGrp, ∃ x : J → Kˣ,
        t = ∏ j, CocharacterUniformizer.cocharacterPoints K S (ν j) (x j) := by
  obtain ⟨I, hI, ⟨e⟩⟩ := hS
  let := Fintype.ofFinite I
  let eC : S ≅ splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I :=
    { hom := Additive.ofMul e.hom
      inv := Additive.ofMul e.inv
      hom_inv_id := congrArg Additive.ofMul e.hom_inv_id
      inv_hom_id := congrArg Additive.ofMul e.inv_hom_id }
  refine ⟨I, inferInstance, fun j => splitTorus.single _ I j ≫ eC.inv, fun t => ?_⟩
  let y := rationalPoints.map e.hom t
  refine ⟨fun j => Gm.affinePointsEquiv (𝟙 _)
    ((Gm.pointsEquiv _ (Over.mk (𝟙 (Spec (CommRingCat.of K))))).symm
      (splitTorus.pointsEquiv I (Over.mk (𝟙 _)) y j)), ?_⟩
  have ht : t = rationalPoints.map e.inv y := by
    change t = (t ≫ e.hom.hom.hom) ≫ e.inv.hom.hom
    rw [Category.assoc]
    change t = t ≫ (e.hom ≫ e.inv).hom.hom
    rw [Iso.hom_inv_id]
    exact (Category.comp_id t).symm
  conv_lhs => rw [ht, splitTorus.eq_prod_single y, map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  simp only [CocharacterUniformizer.cocharacterPoints, MonoidHom.comp_apply,
    MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply, rationalPoints.map_apply,
    Category.assoc]
  rfl

end Langlands.GroupScheme
