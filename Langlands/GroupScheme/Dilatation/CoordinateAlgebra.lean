import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.AlgebraicGeometry.Scheme

/-!
# The coordinate algebra for affine dilatation

This constructs `A[I/π]` inside `A[1/π]`. It does not assert the flat-test
representability, finite type, smoothness, or group structure of a dilatation.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme.Dilatation

universe u

variable {A : Type u} [CommRing A]

/-- The fraction `f / π` in the actual localization of `A` away from `π`. -/
def divided (π f : A) : Localization.Away π :=
  IsLocalization.Away.invSelf π * algebraMap A (Localization.Away π) f

/-- The subalgebra `A[I/π]` of `A[1/π]`, with its canonical `A`-algebra structure. -/
def coordinateAlgebra (π : A) (I : Ideal A) : Subalgebra A (Localization.Away π) :=
  Algebra.adjoin A (divided π '' (I : Set A))

theorem divided_mem (π : A) (I : Ideal A) {f : A} (hf : f ∈ I) :
    divided π f ∈ coordinateAlgebra π I :=
  Algebra.subset_adjoin ⟨f, hf, rfl⟩

/-- An element of the centre ideal divided by `π`, now in `A[I/π]`. -/
def dividedElement (π : A) (I : Ideal A) (f : I) : coordinateAlgebra π I :=
  ⟨divided π f, divided_mem π I f.property⟩

@[simp]
theorem coe_dividedElement (π : A) (I : Ideal A) (f : I) :
    (dividedElement π I f : Localization.Away π) = divided π f := rfl

theorem mul_divided (π f : A) :
    algebraMap A (Localization.Away π) π * divided π f =
      algebraMap A (Localization.Away π) f := by
  rw [divided, ← mul_assoc, IsLocalization.Away.mul_invSelf, one_mul]

theorem mul_dividedElement (π : A) (I : Ideal A) (f : I) :
    algebraMap A (coordinateAlgebra π I) π * dividedElement π I f =
      algebraMap A (coordinateAlgebra π I) f := by
  apply Subtype.ext
  exact mul_divided π f

/-- The image of the centre ideal is contained in the ideal generated by `π`. -/
theorem ideal_map_le_span (π : A) (I : Ideal A) :
    I.map (algebraMap A (coordinateAlgebra π I)) ≤
      Ideal.span {algebraMap A (coordinateAlgebra π I) π} := by
  rw [Ideal.map_le_iff_le_comap]
  intro f hf
  apply Ideal.mem_span_singleton.mpr
  exact ⟨dividedElement π I ⟨f, hf⟩, (mul_dividedElement π I ⟨f, hf⟩).symm⟩

theorem coordinateAlgebra_le_iff (π : A) (I : Ideal A)
    (B : Subalgebra A (Localization.Away π)) :
    coordinateAlgebra π I ≤ B ↔ ∀ f ∈ I, divided π f ∈ B := by
  rw [coordinateAlgebra, Algebra.adjoin_le_iff]
  constructor
  · intro h f hf
    exact h ⟨f, hf, rfl⟩
  · rintro h _ ⟨f, hf, rfl⟩
    exact h f hf

theorem coordinateAlgebra_mono (π : A) {I J : Ideal A} (h : I ≤ J) :
    coordinateAlgebra π I ≤ coordinateAlgebra π J :=
  (coordinateAlgebra_le_iff π I _).mpr fun _ hf => divided_mem π J (h hf)

/-- The actual inclusion of the coordinate algebra into the localized ring. -/
def inclusion (π : A) (I : Ideal A) :
    coordinateAlgebra π I →ₐ[A] Localization.Away π :=
  (coordinateAlgebra π I).val

theorem inclusion_injective (π : A) (I : Ideal A) :
    Function.Injective (inclusion π I) :=
  Subtype.val_injective

/-- The affine scheme with the constructed coordinate algebra. -/
def scheme (π : A) (I : Ideal A) : Scheme :=
  Spec (CommRingCat.of (coordinateAlgebra π I))

/-- The scheme morphism induced by the canonical map `A → A[I/π]`. -/
def toOriginal (π : A) (I : Ideal A) :
    scheme π I ⟶ Spec (CommRingCat.of A) :=
  Spec.map (CommRingCat.ofHom (algebraMap A (coordinateAlgebra π I)))

end Langlands.GroupScheme.Dilatation
