import Langlands.AnthropicFLT.P2M.Sol.S_IsRegularLocalRing_spanFinrank_ker_add_ringKrullDim_eq
import StacksFrontier.RingTheory.RegularLocalRing.Basic
import StacksFrontier.RingTheory.CohenMacaulay.RegularSequence.DimensionCriterion

/-! # Regular generators for the centre in local coordinates -/

noncomputable section

open RingTheory.Sequence

namespace Langlands.GroupScheme.Dilatation

/-- In a regular local ring, an ideal with regular local quotient is generated by a
regular sequence. -/
theorem exists_regular_generators {A : Type*} [CommRing A] [IsRegularLocalRing A]
    (I : Ideal A) [IsRegularLocalRing (A ⧸ I)] :
    ∃ xs : List A, Ideal.ofList xs = I ∧ IsRegular A xs := by
  classical
  obtain ⟨s, hcard, hspan⟩ := (IsNoetherian.noetherian I).exists_span_finset_card_eq_spanFinrank
  let xs := s.toList
  have hgen : Ideal.ofList xs = I := by
    change Submodule.span A {x | x ∈ s.toList} = (I : Submodule A A)
    rw [show {x | x ∈ s.toList} = (s : Set A) from Set.ext fun _ => Finset.mem_toList]
    exact hspan
  have hmem (x : A) (hx : x ∈ xs) : x ∈ IsLocalRing.maximalIdeal A := by
    have hx' : x ∈ Ideal.ofList xs := Ideal.subset_span (s := {a : A | a ∈ xs}) hx
    exact IsLocalRing.le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance) (hgen ▸ hx')
  have hd := P2MW.S_IsRegularLocalRing_spanFinrank_ker_add_ringKrullDim_eq.solution
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  rw [Ideal.mk_ker] at hd
  have hCM := (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay A).2
  refine ⟨xs, hgen, (hCM.isRegular_iff_ringKrullDim_add_length_eq_ringKrullDim xs hmem).1.mpr ?_⟩
  rw [hgen]
  simpa only [xs, Finset.length_toList, hcard, add_comm] using hd

/-- Lifting generators of the centre ideal modulo the denominator gives generators
of the centre together with the denominator. -/
theorem exists_lifted_regular_generators {A : Type*} [CommRing A] (t : A) (I : Ideal A)
    (ht : t ∈ I) [IsRegularLocalRing (A ⧸ Ideal.span {t})] [IsRegularLocalRing (A ⧸ I)] :
    ∃ xs : List A, Ideal.span {t} ⊔ Ideal.ofList xs = I ∧
      IsWeaklyRegular (A ⧸ Ideal.span {t}) (xs.map (Ideal.Quotient.mk (Ideal.span {t}))) := by
  let J : Ideal A := Ideal.span {t}
  let q := Ideal.Quotient.mk J
  have hJI : J ≤ I := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht)
  let e : ((A ⧸ J) ⧸ I.map q) ≃+* (A ⧸ I) := DoubleQuot.quotQuotEquivQuotOfLE hJI
  let : IsRegularLocalRing ((A ⧸ J) ⧸ I.map q) := IsRegularLocalRing.of_ringEquiv e.symm
  obtain ⟨ys, hygen, hy⟩ := exists_regular_generators (I.map q)
  let s := Function.surjInv (Ideal.Quotient.mk_surjective (I := J))
  have hs : Function.RightInverse s q := Function.rightInverse_surjInv Ideal.Quotient.mk_surjective
  have hmap : (ys.map s).map q = ys := by rw [List.map_map, hs.comp_eq_id, List.map_id]
  refine ⟨ys.map s, ?_, hmap.symm ▸ hy.1⟩
  rw [← hmap, ← Ideal.map_ofList] at hygen
  have h := congrArg (Ideal.comap q) hygen
  rw [Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
    Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
    Ideal.mk_ker, sup_eq_left.mpr hJI, sup_comm] at h
  exact h

end Langlands.GroupScheme.Dilatation
