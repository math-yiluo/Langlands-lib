import Mathlib.RingTheory.Coalgebra.Basic
import Mathlib.LinearAlgebra.TensorProduct.Basis
import Mathlib.LinearAlgebra.TensorProduct.RightExactness
import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.RingTheory.Flat.Basic
import Mathlib.RingTheory.Flat.TorsionFree

/-! # Finitely generated free subcomodules of a coalgebra over a principal ideal domain -/

noncomputable section

open TensorProduct Coalgebra Module

namespace Langlands.GroupScheme.IntegralLinearEmbedding

section CommRing

variable {R : Type*} [CommRing R] {B : Type*} [AddCommGroup B] [Module R B] [Coalgebra R B]

/-- The right translation operator of a functional: `b ↦ ∑ f (b₂) • b₁` for
`comul b = ∑ b₁ ⊗ b₂`. -/
def rightAct (f : Module.Dual R B) : B →ₗ[R] B :=
  TensorProduct.rid R B ∘ₗ f.lTensor B ∘ₗ comul

theorem rightAct_apply (f : Module.Dual R B) (b : B) :
    rightAct f b = TensorProduct.rid R B (f.lTensor B (comul b)) := rfl

@[simp] theorem rightAct_counit (b : B) : rightAct (counit (R := R)) b = b := by
  simp [rightAct_apply]

/-- Coassociativity: right translations compose. -/
theorem rightAct_rightAct (g f : Module.Dual R B) (a : B) :
    rightAct g (rightAct f a) = rightAct (g ∘ₗ rightAct f) a := by
  have h1 : rightAct g ∘ₗ ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B) =
      ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B) ∘ₗ (rightAct g).rTensor B := by
    ext x y
    simp
  have h3 : ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B) ∘ₗ
        (((TensorProduct.rid R B).toLinearMap ∘ₗ g.lTensor B).rTensor B) ∘ₗ
          (TensorProduct.assoc R B B B).symm.toLinearMap =
      (TensorProduct.rid R B).toLinearMap ∘ₗ g.lTensor B ∘ₗ
        ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B).lTensor B := by
    apply TensorProduct.ext_threefold'
    intro x y z
    simp [smul_comm (f z) (g y) x]
  calc rightAct g (rightAct f a)
      = (rightAct g ∘ₗ ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B)) (comul a) := rfl
    _ = ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B)
          ((((TensorProduct.rid R B).toLinearMap ∘ₗ g.lTensor B).rTensor B)
            ((comul (R := R)).rTensor B (comul a))) := by
        rw [h1]
        simp only [rightAct, LinearMap.rTensor_comp, LinearMap.comp_apply, LinearEquiv.coe_coe]
    _ = ((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B)
          ((((TensorProduct.rid R B).toLinearMap ∘ₗ g.lTensor B).rTensor B)
            ((TensorProduct.assoc R B B B).symm ((comul (R := R)).lTensor B (comul a)))) := by
        rw [coassoc_symm_apply]
    _ = TensorProduct.rid R B (g.lTensor B
          (((TensorProduct.rid R B).toLinearMap ∘ₗ f.lTensor B).lTensor B
            ((comul (R := R)).lTensor B (comul a)))) :=
        LinearMap.congr_fun h3 _
    _ = rightAct (g ∘ₗ rightAct f) a := by
        simp only [rightAct, LinearMap.lTensor_comp, LinearMap.comp_apply, LinearEquiv.coe_coe]

/-- All right translates of a fixed element lie in a finitely generated submodule. -/
theorem exists_fg_rightAct (a : B) :
    ∃ U : Submodule R B, U.FG ∧ ∀ f : Module.Dual R B, rightAct f a ∈ U := by
  classical
  obtain ⟨T, hT⟩ := TensorProduct.exists_finset (R := R) (comul (R := R) a)
  refine ⟨Submodule.span R ((T.image Prod.fst : Finset B) : Set B),
    Submodule.fg_span (Finset.finite_toSet _), fun f => ?_⟩
  rw [rightAct_apply, hT, map_sum, map_sum]
  refine Submodule.sum_mem _ fun x hx => ?_
  simp only [LinearMap.lTensor_tmul, TensorProduct.rid_tmul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_coe.mpr
    (Finset.mem_image_of_mem _ hx)))

/-- The submodule generated by all right translates of a finite set. -/
def translateSpan (S : Finset B) : Submodule R B :=
  Submodule.span R (Set.range fun p : S × Module.Dual R B => rightAct p.2 (p.1 : B))

theorem subset_translateSpan (S : Finset B) : (S : Set B) ⊆ translateSpan (R := R) S := by
  intro a ha
  have := Submodule.subset_span (R := R)
    (Set.mem_range_self (f := fun p : S × Module.Dual R B => rightAct p.2 (p.1 : B))
      (⟨a, ha⟩, counit))
  simpa [translateSpan] using this

theorem rightAct_mem_translateSpan (S : Finset B) (g : Module.Dual R B) {w : B}
    (hw : w ∈ translateSpan (R := R) S) : rightAct g w ∈ translateSpan (R := R) S := by
  have hle : translateSpan (R := R) S ≤ (translateSpan (R := R) S).comap (rightAct g) := by
    rw [translateSpan, Submodule.span_le]
    rintro _ ⟨⟨a, f⟩, rfl⟩
    exact Submodule.subset_span ⟨⟨a, g ∘ₗ rightAct f⟩, (rightAct_rightAct g f a).symm⟩
  exact hle hw

end CommRing

section Domain

variable {R : Type*} [CommRing R] [IsDomain R] {B : Type*} [AddCommGroup B] [Module R B]

/-- The saturation of a submodule: the elements having a nonzero multiple in it. -/
def saturation (W : Submodule R B) : Submodule R B where
  carrier := {b | ∃ r : R, r ≠ 0 ∧ r • b ∈ W}
  add_mem' := by
    rintro a b ⟨r, hr, ha⟩ ⟨s, hs, hb⟩
    refine ⟨r * s, mul_ne_zero hr hs, ?_⟩
    rw [smul_add, mul_comm r s, mul_smul, mul_comm s r, mul_smul]
    exact W.add_mem (W.smul_mem s ha) (W.smul_mem r hb)
  zero_mem' := ⟨1, one_ne_zero, by simp⟩
  smul_mem' := by
    rintro c b ⟨r, hr, hb⟩
    refine ⟨r, hr, ?_⟩
    rw [smul_comm]
    exact W.smul_mem c hb

theorem mem_saturation {W : Submodule R B} {b : B} :
    b ∈ saturation W ↔ ∃ r : R, r ≠ 0 ∧ r • b ∈ W := Iff.rfl

theorem le_saturation (W : Submodule R B) : W ≤ saturation W :=
  fun b hb => ⟨1, one_ne_zero, by simpa using hb⟩

/-- The quotient by a saturation is torsion-free. -/
theorem isTorsionFree_quotient_saturation (W : Submodule R B) :
    IsTorsionFree R (B ⧸ saturation W) := by
  refine Module.IsTorsionFree.of_smul_eq_zero fun r q hrq => ?_
  induction q using Submodule.Quotient.induction_on with
  | H b =>
    by_cases hr : r = 0
    · exact Or.inl hr
    right
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hrq
    obtain ⟨s, hs, hsb⟩ := hrq
    rw [Submodule.Quotient.mk_eq_zero]
    exact ⟨s * r, mul_ne_zero hs hr, by rwa [mul_smul]⟩

end Domain

section PID

variable {R : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
  {B : Type*} [AddCommGroup B] [Module R B]

/-- If the functionals separate the elements of `B`, finitely many of them separate the
elements of a finitely generated submodule. -/
theorem exists_finset_separating
    (hsep : ∀ b : B, b ≠ 0 → ∃ f : Module.Dual R B, f b ≠ 0)
    {W : Submodule R B} (hW : W.FG) :
    ∃ T : Finset (Module.Dual R B), ∀ w ∈ W, (∀ f ∈ T, f w = 0) → w = 0 := by
  classical
  have : Module.Finite R W := Module.Finite.iff_fg.mpr hW
  let res : Module.Dual R B →ₗ[R] Module.Dual R W := LinearMap.lcomp R R W.subtype
  have hfg : (LinearMap.range res).FG :=
    Submodule.FG.of_le (Module.Finite.fg_top (R := R) (M := Module.Dual R W)) le_top
  obtain ⟨s, hs⟩ := hfg
  have hpre : ∀ x ∈ s, ∃ f : Module.Dual R B, res f = x := by
    intro x hx
    have : x ∈ LinearMap.range res := hs ▸ Submodule.subset_span hx
    exact this
  choose! pre hpre using hpre
  refine ⟨s.image pre, fun w hw hzero => ?_⟩
  by_contra hne
  obtain ⟨f, hf⟩ := hsep w hne
  have hle : Submodule.span R (s : Set (Module.Dual R W)) ≤
      LinearMap.ker (Module.Dual.eval R W ⟨w, hw⟩) := by
    rw [Submodule.span_le]
    intro x hx
    rw [SetLike.mem_coe, LinearMap.mem_ker, Module.Dual.eval_apply, ← hpre x hx]
    exact hzero _ (Finset.mem_image_of_mem pre hx)
  have hmem : res f ∈ Submodule.span R (s : Set (Module.Dual R W)) := by
    rw [hs]
    exact LinearMap.mem_range_self res f
  exact hf (hle hmem)

/-- The saturation of a finitely generated submodule is finitely generated, when the
functionals separate the elements of `B`. -/
theorem saturation_fg [IsTorsionFree R B] (hsep : ∀ b : B, b ≠ 0 → ∃ f : Module.Dual R B, f b ≠ 0)
    {W : Submodule R B} (hW : W.FG) : (saturation W).FG := by
  classical
  obtain ⟨T, hT⟩ := exists_finset_separating hsep hW
  let ev : saturation W →ₗ[R] (T → R) := LinearMap.pi fun f => (f : Module.Dual R B).comp
    (saturation W).subtype
  have hinj : Function.Injective ev := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    rintro ⟨b, r, hr, hb⟩ hev
    have hzero : ∀ f ∈ T, f b = 0 := fun f hf => congrFun hev ⟨f, hf⟩
    have hrb : r • b = 0 := hT _ hb fun f hf => by rw [map_smul, hzero f hf, smul_zero]
    ext
    exact (smul_eq_zero.1 hrb).resolve_left hr
  have : IsNoetherian R (saturation W) := isNoetherian_of_injective ev hinj
  exact (Module.Finite.iff_fg.mp inferInstance)

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Coordinates of a contraction, in a basis of the left factor. -/
theorem repr_rid_lTensor {Q : Type*} [AddCommGroup Q] [Module R Q] {ι : Type*}
    [DecidableEq ι] (e : Basis ι R Q) (f : Module.Dual R B) (x : Q ⊗[R] B) (i : ι) :
    e.repr (TensorProduct.rid R Q (f.lTensor Q x)) i =
      f (TensorProduct.equivFinsuppOfBasisLeft e x i) := by
  induction x using TensorProduct.inductionOn with
  | tmul m n =>
    rw [TensorProduct.equivFinsuppOfBasisLeft_apply_tmul_apply]
    simp [mul_comm]
  | add x y hx hy => simp only [map_add, Finsupp.add_apply, hx, hy]

/-- Tensors with a torsion-free left factor are separated by contracting the right factor with
functionals, when these functionals separate the elements of `B`. -/
theorem tensor_eq_zero_of_contract (hsep : ∀ b : B, b ≠ 0 → ∃ f : Module.Dual R B, f b ≠ 0)
    {Q : Type*} [AddCommGroup Q] [Module R Q] [IsTorsionFree R Q] (u : Q ⊗[R] B)
    (hu : ∀ f : Module.Dual R B, TensorProduct.rid R Q (f.lTensor Q u) = 0) : u = 0 := by
  classical
  obtain ⟨T, hT⟩ := TensorProduct.exists_finset (R := R) u
  let Q₀ : Submodule R Q := Submodule.span R ((T.image Prod.fst : Finset Q) : Set Q)
  have : Module.Finite R Q₀ :=
    Module.Finite.iff_fg.mpr (Submodule.fg_span (Finset.finite_toSet _))
  have : IsTorsionFree R Q₀ :=
    Function.Injective.moduleIsTorsionFree Q₀.subtype Subtype.val_injective (fun _ _ => rfl)
  have hmem : ∀ x ∈ T, x.1 ∈ Q₀ := fun x hx =>
    Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
  let u₀ : Q₀ ⊗[R] B := ∑ x ∈ T.attach, (⟨x.1.1, hmem x.1 x.2⟩ : Q₀) ⊗ₜ x.1.2
  have hu₀ : Q₀.subtype.rTensor B u₀ = u := by
    rw [hT, map_sum]
    rw [← Finset.sum_attach T]
    rfl
  obtain ⟨n, e⟩ := Module.basisOfFiniteTypeTorsionFree' (R := R) (M := Q₀)
  have hzero : ∀ f : Module.Dual R B, TensorProduct.rid R Q₀ (f.lTensor Q₀ u₀) = 0 := by
    intro f
    apply Subtype.val_injective
    have h := hu f
    rw [← hu₀] at h
    have hnat : TensorProduct.rid R Q (f.lTensor Q (Q₀.subtype.rTensor B u₀)) =
        Q₀.subtype (TensorProduct.rid R Q₀ (f.lTensor Q₀ u₀)) := by
      induction u₀ using TensorProduct.inductionOn with
      | tmul m b => simp
      | add x y hx hy => simp only [map_add, hx, hy]
    rw [hnat] at h
    simpa using h
  have hc : TensorProduct.equivFinsuppOfBasisLeft e u₀ = 0 := by
    ext i
    by_contra hne
    obtain ⟨f, hf⟩ := hsep _ hne
    apply hf
    rw [← repr_rid_lTensor e f u₀ i, hzero f, map_zero, Finsupp.zero_apply]
  have : u₀ = 0 := (TensorProduct.equivFinsuppOfBasisLeft e).injective (by rw [hc, map_zero])
  rw [← hu₀, this, map_zero]

end PID

section Comodule

variable {R : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
  {B : Type*} [AddCommGroup B] [Module R B] [Coalgebra R B]

omit [IsPrincipalIdealRing R] in
/-- The saturation of a submodule stable under right translations is stable under them. -/
theorem rightAct_mem_saturation {W : Submodule R B}
    (hW : ∀ (g : Module.Dual R B) (w : B), w ∈ W → rightAct g w ∈ W)
    (g : Module.Dual R B) {b : B} (hb : b ∈ saturation W) : rightAct g b ∈ saturation W := by
  obtain ⟨r, hr, hrb⟩ := hb
  exact ⟨r, hr, by rw [← map_smul]; exact hW g _ hrb⟩

/-- A saturated submodule stable under all right translations is a subcomodule. -/
theorem comul_mem_range_rTensor (hsep : ∀ b : B, b ≠ 0 → ∃ f : Module.Dual R B, f b ≠ 0)
    {W : Submodule R B} (hW : ∀ (g : Module.Dual R B) (w : B), w ∈ W → rightAct g w ∈ W)
    {b : B} (hb : b ∈ saturation W) :
    comul (R := R) b ∈ LinearMap.range ((saturation W).subtype.rTensor B) := by
  have : IsTorsionFree R (B ⧸ saturation W) := isTorsionFree_quotient_saturation W
  have hexact := rTensor_exact B (LinearMap.exact_subtype_mkQ (saturation W))
    (Submodule.mkQ_surjective _)
  refine (hexact (comul b)).1 (tensor_eq_zero_of_contract hsep _ fun f => ?_)
  have hnat : TensorProduct.rid R (B ⧸ saturation W)
      (f.lTensor _ ((saturation W).mkQ.rTensor B (comul b))) =
        (saturation W).mkQ (TensorProduct.rid R B (f.lTensor B (comul b))) := by
    generalize (comul (R := R) b : B ⊗[R] B) = t
    induction t using TensorProduct.inductionOn with
    | tmul m n => simp
    | add x y hx hy => simp only [map_add, hx, hy]
  rw [hnat, ← rightAct_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact rightAct_mem_saturation hW f hb

end Comodule



section Matrix

variable {R : Type*} [CommRing R] {B : Type*} [AddCommGroup B] [Module R B] [Coalgebra R B]
  {Λ : Submodule R B} {N : ℕ} (e : Basis (Fin N) R Λ)
  (hΛ : ∀ b ∈ Λ, comul (R := R) b ∈ LinearMap.range (Λ.subtype.rTensor B))

/-- The matrix coefficients of a basis of a subcomodule: `comul (e j) = ∑ i, e i ⊗ M i j`. -/
def coefficientMatrix : Matrix (Fin N) (Fin N) B := fun i j =>
  TensorProduct.equivFinsuppOfBasisLeft e (hΛ _ (e j).2).choose i

theorem comul_basis (j : Fin N) :
    comul (R := R) (e j : B) = ∑ i, (e i : B) ⊗ₜ[R] coefficientMatrix e hΛ i j := by
  rw [← (hΛ _ (e j).2).choose_spec]
  conv_lhs =>
    rw [← (TensorProduct.equivFinsuppOfBasisLeft e).symm_apply_apply (hΛ _ (e j).2).choose]
  rw [TensorProduct.equivFinsuppOfBasisLeft_symm_apply,
    Finsupp.sum_fintype _ _ (fun i => by simp), map_sum]
  rfl

omit [Coalgebra R B] in
include e in
/-- Coefficients against a basis of a submodule are unique after tensoring with a flat
module. -/
theorem sum_basis_tmul_inj {X : Type*} [AddCommGroup X] [Module R X] [Module.Flat R X]
    {x y : Fin N → X} (h : ∑ i, (e i : B) ⊗ₜ[R] x i = ∑ i, (e i : B) ⊗ₜ[R] y i) : x = y := by
  have hinj := Module.Flat.rTensor_preserves_injective_linearMap (M := X) Λ.subtype
    Subtype.val_injective
  have h' : ∑ i, e i ⊗ₜ[R] x i = ∑ i, e i ⊗ₜ[R] y i := hinj (by simpa [map_sum] using h)
  funext j
  have := congrArg (fun t => TensorProduct.equivFinsuppOfBasisLeft e t j) h'
  simpa [map_sum, TensorProduct.equivFinsuppOfBasisLeft_apply_tmul_apply, Finsupp.single_apply]
    using this

/-- The counit of the matrix coefficients is the identity matrix. -/
theorem counit_coefficientMatrix [Module.Flat R B] (i j : Fin N) :
    counit (R := R) (coefficientMatrix e hΛ i j) = (1 : Matrix (Fin N) (Fin N) R) i j := by
  have h := lTensor_counit_comul (R := R) (e j : B)
  rw [comul_basis e hΛ j, map_sum] at h
  simp only [LinearMap.lTensor_tmul] at h
  have h1 : (e j : B) ⊗ₜ[R] (1 : R) =
      ∑ i, (e i : B) ⊗ₜ[R] (1 : Matrix (Fin N) (Fin N) R) i j := by
    rw [Finset.sum_eq_single j (fun i _ hi => by simp [Matrix.one_apply_ne hi]) (by simp)]
    simp
  rw [h1] at h
  exact congrFun (sum_basis_tmul_inj e h) i

/-- The comultiplication of the matrix coefficients is matrix multiplication. -/
theorem comul_coefficientMatrix [Module.Flat R B] (i j : Fin N) :
    comul (R := R) (coefficientMatrix e hΛ i j) =
      ∑ l, coefficientMatrix e hΛ i l ⊗ₜ[R] coefficientMatrix e hΛ l j := by
  have h := coassoc_apply (R := R) (e j : B)
  rw [comul_basis e hΛ j, map_sum, map_sum, map_sum] at h
  simp only [LinearMap.rTensor_tmul, LinearMap.lTensor_tmul, comul_basis e hΛ, TensorProduct.sum_tmul,
    map_sum, TensorProduct.assoc_tmul] at h
  rw [Finset.sum_comm] at h
  simp only [← TensorProduct.tmul_sum] at h
  exact (congrFun (sum_basis_tmul_inj e h) i).symm

/-- Every basis vector is a combination of the matrix coefficients. -/
theorem basis_mem_span_coefficientMatrix (j : Fin N) :
    (e j : B) ∈ Submodule.span R
      (Set.range fun p : Fin N × Fin N => coefficientMatrix e hΛ p.1 p.2) := by
  have h := rTensor_counit_comul (R := R) (e j : B)
  rw [comul_basis e hΛ j, map_sum] at h
  have h' := congrArg (TensorProduct.lid R B) h
  simp only [LinearMap.rTensor_tmul, map_sum, TensorProduct.lid_tmul, one_smul] at h'
  rw [← h']
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨(i, j), rfl⟩)

end Matrix

section Main

variable {R : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
  {B : Type*} [AddCommGroup B] [Module R B] [Coalgebra R B]

theorem translateSpan_fg (S : Finset B) : (translateSpan (R := R) S).FG := by
  classical
  choose U hUfg hU using exists_fg_rightAct (R := R) (B := B)
  have hle : translateSpan (R := R) S ≤ S.sup U := by
    rw [translateSpan, Submodule.span_le]
    rintro _ ⟨⟨a, f⟩, rfl⟩
    exact Finset.le_sup (f := U) a.2 (hU a f)
  exact Submodule.FG.of_le (Submodule.fg_finset_sup S U fun a _ => hUfg a) hle

/-- **Matrix coefficients over a principal ideal domain** (Serre; Bruhat–Tits II, 1.4.5).
Let `B` be a flat coalgebra over a principal ideal domain `R` whose `R`-valued functionals
separate its elements. Every finite subset of `B` lies in the span of the entries of a square
matrix `M` with `comul (M i j) = ∑ l, M i l ⊗ M l j` and `counit (M i j) = δᵢⱼ`. -/
theorem exists_matrix_coefficients [Module.Flat R B]
    (hsep : ∀ b : B, b ≠ 0 → ∃ f : Module.Dual R B, f b ≠ 0) (S : Finset B) :
    ∃ (N : ℕ) (M : Matrix (Fin N) (Fin N) B),
      (∀ i j, comul (R := R) (M i j) = ∑ l, M i l ⊗ₜ[R] M l j) ∧
      (∀ i j, counit (R := R) (M i j) = (1 : Matrix (Fin N) (Fin N) R) i j) ∧
      (S : Set B) ⊆ Submodule.span R (Set.range fun p : Fin N × Fin N => M p.1 p.2) := by
  classical
  set Λ := saturation (translateSpan (R := R) S)
  have hfg : Λ.FG := saturation_fg hsep (translateSpan_fg S)
  have : Module.Finite R Λ := Module.Finite.iff_fg.mpr hfg
  have : IsTorsionFree R Λ :=
    Function.Injective.moduleIsTorsionFree Λ.subtype Subtype.val_injective (fun _ _ => rfl)
  obtain ⟨N, e⟩ := Module.basisOfFiniteTypeTorsionFree' (R := R) (M := Λ)
  have hΛ : ∀ b ∈ Λ, comul (R := R) b ∈ LinearMap.range (Λ.subtype.rTensor B) :=
    fun b hb => comul_mem_range_rTensor hsep (rightAct_mem_translateSpan S) hb
  refine ⟨N, coefficientMatrix e hΛ, comul_coefficientMatrix e hΛ,
    counit_coefficientMatrix e hΛ, fun a ha => ?_⟩
  have haΛ : a ∈ Λ := le_saturation _ (subset_translateSpan S ha)
  have hspan : Λ ≤ Submodule.span R
      (Set.range fun p : Fin N × Fin N => coefficientMatrix e hΛ p.1 p.2) := by
    intro b hb
    have h := congrArg Subtype.val (e.sum_repr ⟨b, hb⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul] at h
    rw [← h]
    exact Submodule.sum_mem _ fun j _ =>
      Submodule.smul_mem _ _ (basis_mem_span_coefficientMatrix e hΛ j)
  exact hspan haΛ

end Main

end Langlands.GroupScheme.IntegralLinearEmbedding
