import Langlands.GroupScheme.HomogeneousQuotientPrincipalOpens

/-! # Ambient unit certificates from quotient principal neighborhoods -/

noncomputable section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.GroupScheme.HomogeneousQuotientFromEmbedding.HomogeneousQuotient

variable {k : Type u} [Field k]
  {J H : GroupScheme (Spec (CommRingCat.of k))} {i : H ⟶ J}
  (Q : HomogeneousQuotient i)

/-- Pullbacks of actual quotient sections with affine principal opens. -/
def affinePrincipalPullbacks : Set Γ(J.X.left, ⊤) :=
  Q.projection.left.appTop '' Q.affinePrincipalSections

variable [IsAffine J.X.left]

/-- An affine principal cover of the quotient gives the unit ideal in the
ambient coordinate ring generated by the pulled-back sections. -/
theorem span_affinePrincipalPullbacks_eq_top_of_cover
    (hcov : ∀ q : Q.scheme.left, ∃ t : Γ(Q.scheme.left, ⊤),
      q ∈ Q.scheme.left.basicOpen t ∧ IsAffineOpen (Q.scheme.left.basicOpen t)) :
    Ideal.span Q.affinePrincipalPullbacks = ⊤ := by
  apply (isAffineOpen_top J.X.left).iSup_basicOpen_eq_self_iff.mp
  apply top_unique
  intro x _
  obtain ⟨t, hxt, ht⟩ := hcov (Q.projection.left x)
  have hx : x ∈ J.X.left.basicOpen (Q.projection.left.appTop t) := by
    rw [← Q.projection.left.preimage_basicOpen_top]
    exact hxt
  exact (le_iSup (fun f : Q.affinePrincipalPullbacks => J.X.left.basicOpen f.val)
    ⟨_, ⟨t, ht, rfl⟩⟩) hx

/-- A finite family of affine principal quotient sections has an ambient
coefficient certificate for the unit ideal whenever such opens cover. -/
theorem exists_finite_affine_principal_ambient_certificate_of_cover
    (hcov : ∀ q : Q.scheme.left, ∃ t : Γ(Q.scheme.left, ⊤),
      q ∈ Q.scheme.left.basicOpen t ∧ IsAffineOpen (Q.scheme.left.basicOpen t)) :
    ∃ (n : ℕ) (t : Fin n → Γ(Q.scheme.left, ⊤)) (a : Fin n → Γ(J.X.left, ⊤)),
      (∀ j, IsAffineOpen (Q.scheme.left.basicOpen (t j))) ∧
        ∑ j, a j * Q.projection.left.appTop (t j) = 1 := by
  classical
  obtain ⟨S, hS, hSspan⟩ := (Ideal.span_eq_top_iff_finite Q.affinePrincipalPullbacks).mp
    (Q.span_affinePrincipalPullbacks_eq_top_of_cover hcov)
  have hrange : Set.range (fun x : S => (x : Γ(J.X.left, ⊤))) = (S : Set Γ(J.X.left, ⊤)) := by
    ext x
    simp
  have h1 : (1 : Γ(J.X.left, ⊤)) ∈
      Ideal.span (Set.range (fun x : S => (x : Γ(J.X.left, ⊤)))) := by
    rw [hrange, hSspan]
    trivial
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
  choose t ht htpull using fun x : S => hS x.property
  refine ⟨S.card, fun j => t (S.equivFin.symm j),
    fun j => a (S.equivFin.symm j), fun j => ht _, ?_⟩
  simp_rw [htpull]
  exact (Equiv.sum_comp S.equivFin.symm (fun x : S => a x * (x : Γ(J.X.left, ⊤)))).trans ha

/-- Explicit geometric reductivity supplies affine principal quotient sections
and a finite unit certificate with ambient, possibly noninvariant coefficients. -/
theorem exists_finite_affine_principal_ambient_certificate
    [IsAlgClosed k] [Smooth H.X.hom] (hH : IsGeometricallyReductive H) :
    ∃ (n : ℕ) (t : Fin n → Γ(Q.scheme.left, ⊤)) (a : Fin n → Γ(J.X.left, ⊤)),
      (∀ j, IsAffineOpen (Q.scheme.left.basicOpen (t j))) ∧
        ∑ j, a j * Q.projection.left.appTop (t j) = 1 :=
  Q.exists_finite_affine_principal_ambient_certificate_of_cover
    (Q.exists_affine_basicOpen_mem hH)

end Langlands.GroupScheme.HomogeneousQuotientFromEmbedding.HomogeneousQuotient
