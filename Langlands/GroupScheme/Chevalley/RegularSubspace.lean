import Langlands.GroupScheme.AffineLinearEmbedding.Comodule
import Mathlib.RingTheory.Flat.Basic

/-! # Finite regular subspaces and their scalar extensions -/

noncomputable section

open TensorProduct Coalgebra Module

namespace Langlands.GroupScheme.Chevalley

open AffineLinearEmbedding

variable {K : Type*} [Field K] {B : Type*} [AddCommGroup B] [Module K B]
  [Coalgebra K B]

/-- The subspace generated by the right translates of a finite set. -/
def regularSpan (S : Finset B) : Submodule K B :=
  Submodule.span K (Set.range fun p : S × Module.Dual K B => rightAct p.2 (p.1 : B))

theorem subset_regularSpan (S : Finset B) : (S : Set B) ⊆ regularSpan (K := K) S := by
  intro a ha
  have h := Submodule.subset_span (R := K)
    (Set.mem_range_self (f := fun p : S × Module.Dual K B => rightAct p.2 (p.1 : B))
      (⟨a, ha⟩, counit))
  simpa [regularSpan] using h

theorem rightAct_mem_regularSpan (S : Finset B) (f : Module.Dual K B)
    {b : B} (hb : b ∈ regularSpan (K := K) S) : rightAct f b ∈ regularSpan (K := K) S := by
  have hle : regularSpan (K := K) S ≤ (regularSpan (K := K) S).comap (rightAct f) := by
    rw [regularSpan, Submodule.span_le]
    rintro _ ⟨⟨a, g⟩, rfl⟩
    exact Submodule.subset_span ⟨⟨a, f ∘ₗ rightAct g⟩, (rightAct_rightAct f g a).symm⟩
  exact hle hb

instance finite_regularSpan (S : Finset B) : Module.Finite K (regularSpan (K := K) S) := by
  classical
  choose U hUfg hU using exists_fg_rightAct (K := K) (B := B)
  have hle : regularSpan (K := K) S ≤ S.sup U := by
    rw [regularSpan, Submodule.span_le]
    rintro _ ⟨⟨a, f⟩, rfl⟩
    exact Finset.le_sup (f := U) a.2 (hU a f)
  have : Module.Finite K ↥(S.sup U) :=
    Module.Finite.iff_fg.mpr (Submodule.fg_finset_sup S U fun a _ => hUfg a)
  exact Submodule.finiteDimensional_of_le hle

/-- Scalar extension of a subspace, viewed inside the tensor product of the ambient space. -/
def tensorSubspace (V : Submodule K B) (A : Type*) [AddCommGroup A] [Module K A] :
    Submodule K (B ⊗[K] A) :=
  LinearMap.range (V.subtype.rTensor A)

/-- Right translation evaluated at an arbitrary coefficient-valued linear map. -/
def translate {A : Type*} [AddCommGroup A] [Module K A] (f : B →ₗ[K] A) :
    B →ₗ[K] B ⊗[K] A :=
  f.lTensor B ∘ₗ comul

/-- Functional stability is actual coaction stability, using a linear retraction of the
subspace inclusion and separation of tensors by functionals. -/
theorem exists_subspace_coaction (V : Submodule K B)
    (hV : ∀ (f : Module.Dual K B) (v : B), v ∈ V → rightAct f v ∈ V) :
    ∃ d : V →ₗ[K] V ⊗[K] B,
      V.subtype.rTensor B ∘ₗ d = comul ∘ₗ V.subtype := by
  obtain ⟨P, hP⟩ := V.subtype.exists_leftInverse_of_injective V.ker_subtype
  refine ⟨P.rTensor B ∘ₗ comul ∘ₗ V.subtype, ?_⟩
  apply LinearMap.ext
  intro v
  apply tensor_ext
  intro f
  have hcomm :
      (TensorProduct.rid K B).toLinearMap ∘ₗ f.lTensor B ∘ₗ
          V.subtype.rTensor B ∘ₗ P.rTensor B =
        V.subtype ∘ₗ P ∘ₗ (TensorProduct.rid K B).toLinearMap ∘ₗ f.lTensor B := by
    ext x y
    simp
  change (TensorProduct.rid K B)
      (f.lTensor B ((V.subtype.rTensor B) ((P.rTensor B) (comul (v : B))))) =
    rightAct f (v : B)
  rw [show (TensorProduct.rid K B)
      (f.lTensor B ((V.subtype.rTensor B) ((P.rTensor B) (comul (v : B))))) =
      V.subtype (P (rightAct f (v : B))) from LinearMap.congr_fun hcomm _]
  have hp := LinearMap.congr_fun hP
    (⟨rightAct f (v : B), hV f v v.2⟩ : V)
  exact congrArg Subtype.val hp

/-- A regular subspace stays inside its scalar extension under every coefficient-valued
translation, including nonreduced coefficient algebras. -/
theorem translate_mem_tensorSubspace (V : Submodule K B)
    (hV : ∀ (f : Module.Dual K B) (v : B), v ∈ V → rightAct f v ∈ V)
    {A : Type*} [AddCommGroup A] [Module K A] (f : B →ₗ[K] A)
    {v : B} (hv : v ∈ V) :
    translate f v ∈ tensorSubspace V A := by
  obtain ⟨d, hd⟩ := exists_subspace_coaction V hV
  refine ⟨f.lTensor V (d ⟨v, hv⟩), ?_⟩
  have hcomm : V.subtype.rTensor A ∘ₗ f.lTensor V =
      f.lTensor B ∘ₗ V.subtype.rTensor B := by
    ext x y
    rfl
  change (V.subtype.rTensor A ∘ₗ f.lTensor V) (d ⟨v, hv⟩) = _
  rw [hcomm, LinearMap.comp_apply]
  rw [show (V.subtype.rTensor B) (d ⟨v, hv⟩) = comul v from
    LinearMap.congr_fun hd ⟨v, hv⟩]
  rfl

end Langlands.GroupScheme.Chevalley
