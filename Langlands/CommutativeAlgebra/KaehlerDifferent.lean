import Langlands.MathlibBase

noncomputable section

open Polynomial KaehlerDifferential

namespace Langlands.CommutativeAlgebra.KaehlerDifferent

section Monogenic

variable {A C O : Type*} [CommRing A] [CommRing C] [CommRing O] [Algebra A C] [Algebra C O]
  [Algebra A O] [IsScalarTower A C O]

theorem exists_aeval_eq {x : C} (hx : Algebra.adjoin A {x} = ⊤) (c : C) :
    ∃ h : A[X], aeval x h = c := by
  have : c ∈ Algebra.adjoin A {x} := hx ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at this
  obtain ⟨h, rfl⟩ := this
  exact ⟨h, rfl⟩

variable (O) in
/-- The ideal of `O` generated by the image of `g'(x)`. -/
abbrev derivIdeal (x : C) (g : A[X]) : Ideal O :=
  Ideal.span {algebraMap C O (aeval x (derivative g))}

omit [Algebra A O] [IsScalarTower A C O] in
theorem mk_aeval_derivative_eq {x : C} {g : A[X]} (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h)
    (hgx : aeval x g = 0) {h₁ h₂ : A[X]} (h : aeval x h₁ = aeval x h₂) :
    Ideal.Quotient.mk (derivIdeal O x g) (algebraMap C O (aeval x (derivative h₁))) =
      Ideal.Quotient.mk (derivIdeal O x g) (algebraMap C O (aeval x (derivative h₂))) := by
  rw [Ideal.Quotient.eq, ← map_sub, ← map_sub, ← derivative_sub]
  obtain ⟨q, hq⟩ := hg (h₁ - h₂) (by rw [map_sub, h, sub_self])
  rw [hq, derivative_mul, map_add, map_mul, map_mul, hgx, zero_mul, add_zero, map_mul]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

variable (O) in
/-- The derivation `C → O ⧸ (g'(x))` sending `h(x)` to `h'(x)`, for `C` generated by `x` and `g`
generating the polynomials vanishing at `x`. -/
def quotDerivation {x : C} (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]}
    (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h) (hgx : aeval x g = 0) :
    Derivation A C (O ⧸ derivIdeal O x g) :=
  Derivation.mk'
    { toFun c := Ideal.Quotient.mk _ (algebraMap C O
        (aeval x (derivative (exists_aeval_eq hx c).choose)))
      map_add' c₁ c₂ := by
        rw [mk_aeval_derivative_eq hg hgx (h₂ := (exists_aeval_eq hx c₁).choose +
          (exists_aeval_eq hx c₂).choose)]
        · rw [derivative_add, map_add, map_add, map_add]
        · rw [map_add, (exists_aeval_eq hx c₁).choose_spec, (exists_aeval_eq hx c₂).choose_spec,
            (exists_aeval_eq hx (c₁ + c₂)).choose_spec]
      map_smul' a c := by
        rw [mk_aeval_derivative_eq hg hgx (h₂ := a • (exists_aeval_eq hx c).choose)]
        · rw [derivative_smul, map_smul, Algebra.smul_def, map_mul, map_mul,
            ← IsScalarTower.algebraMap_apply A C O, Ideal.Quotient.mk_algebraMap, Algebra.smul_def]
          rfl
        · rw [map_smul, (exists_aeval_eq hx c).choose_spec, (exists_aeval_eq hx (a • c)).choose_spec] }
    fun c₁ c₂ ↦ by
      dsimp only [LinearMap.coe_mk, AddHom.coe_mk]
      rw [mk_aeval_derivative_eq hg hgx (h₂ := (exists_aeval_eq hx c₁).choose *
          (exists_aeval_eq hx c₂).choose)]
      · rw [derivative_mul, map_add, map_mul, map_mul, (exists_aeval_eq hx c₁).choose_spec,
          (exists_aeval_eq hx c₂).choose_spec, map_add, map_mul, map_mul, map_add, map_mul, map_mul,
          Algebra.smul_def, Algebra.smul_def]
        simp only [IsScalarTower.algebraMap_apply C O (O ⧸ derivIdeal O x g),
          Ideal.Quotient.algebraMap_eq]
        ring
      · rw [map_mul, (exists_aeval_eq hx c₁).choose_spec, (exists_aeval_eq hx c₂).choose_spec,
          (exists_aeval_eq hx (c₁ * c₂)).choose_spec]

theorem quotDerivation_apply {x : C} (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]}
    (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h) (hgx : aeval x g = 0) (h : A[X]) :
    quotDerivation O hx hg hgx (aeval x h) =
      Ideal.Quotient.mk _ (algebraMap C O (aeval x (derivative h))) :=
  mk_aeval_derivative_eq hg hgx (exists_aeval_eq hx (aeval x h)).choose_spec

section Localization

/-- If `O` is a localization of `C = A[x]`, the differential `dx` generates `Ω[O⁄A]`. -/
theorem span_D_eq_top (M : Submonoid C) [IsLocalization M O] {x : C} (hx : Algebra.adjoin A {x} = ⊤) :
    Submodule.span O {D A O (algebraMap C O x)} = ⊤ := by
  rw [eq_top_iff, ← span_range_map_derivation_of_isLocalization A C O M, Submodule.span_le]
  rintro _ ⟨c, rfl⟩
  obtain ⟨h, rfl⟩ := exists_aeval_eq hx c
  rw [Function.comp_apply, Derivation.map_aeval, LinearMap.map_smul_of_tower, map_D,
    algebra_compatible_smul O]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

theorem aeval_derivative_smul_D_eq_zero {x : C} {g : A[X]}
    (hgx : aeval x g = 0) :
    algebraMap C O (aeval x (derivative g)) • D A O (algebraMap C O x) = 0 := by
  rw [← algebra_compatible_smul, ← map_D A A C O, ← LinearMap.map_smul_of_tower,
    ← Derivation.map_aeval, hgx, map_zero, map_zero]

variable (O) in
/-- The `O`-linear map `Ω[O⁄A] → O ⧸ (g'(x))` sending `dx` to `1`, obtained from the derivation
`quotDerivation` by base change along the localization `C → O`. -/
def kaehlerToQuot (M : Submonoid C) [IsLocalization M O] {x : C}
    (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]} (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h)
    (hgx : aeval x g = 0) : Ω[O⁄A] →ₗ[O] O ⧸ derivIdeal O x g :=
  haveI := Algebra.FormallyEtale.of_isLocalization (Rₘ := O) M
  ((quotDerivation O hx hg hgx).liftKaehlerDifferential.liftBaseChange O) ∘ₗ
    (tensorKaehlerEquivOfFormallyEtale A C O).symm.toLinearMap

theorem kaehlerToQuot_D (M : Submonoid C) [IsLocalization M O] {x : C}
    (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]} (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h)
    (hgx : aeval x g = 0) : kaehlerToQuot O M hx hg hgx (D A O (algebraMap C O x)) = 1 := by
  have := Algebra.FormallyEtale.of_isLocalization (Rₘ := O) M
  have h1 := quotDerivation_apply (O := O) hx hg hgx X
  rw [aeval_X, derivative_X, map_one, map_one, map_one] at h1
  rw [kaehlerToQuot, LinearMap.comp_apply, LinearEquiv.coe_coe,
    tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap, LinearMap.liftBaseChange_tmul, one_smul,
    Derivation.liftKaehlerDifferential_comp_D, h1]

theorem torsionOf_D_eq (M : Submonoid C) [IsLocalization M O] {x : C}
    (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]} (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h)
    (hgx : aeval x g = 0) :
    Ideal.torsionOf O Ω[O⁄A] (D A O (algebraMap C O x)) = derivIdeal O x g := by
  ext a
  rw [Ideal.mem_torsionOf_iff]
  constructor
  · intro ha
    have h1 := congrArg (kaehlerToQuot O M hx hg hgx) ha
    rw [map_smul, kaehlerToQuot_D, map_zero, ← Algebra.algebraMap_eq_smul_one,
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem] at h1
    exact h1
  · intro ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [mul_smul, aeval_derivative_smul_D_eq_zero hgx, smul_zero]

variable (O) in
/-- For `O` a localization of `C = A[x]` and `g` generating the ideal of polynomials vanishing at
`x`, the module `Ω[O⁄A]` is cyclic, generated by `dx`, with annihilator `(g'(x))`. -/
def quotEquivKaehler (M : Submonoid C) [IsLocalization M O] {x : C}
    (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]} (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h)
    (hgx : aeval x g = 0) : (O ⧸ derivIdeal O x g) ≃ₗ[O] Ω[O⁄A] :=
  (Submodule.quotEquivOfEq _ _ (torsionOf_D_eq M hx hg hgx).symm).trans
    ((Ideal.quotTorsionOfEquivSpanSingleton O Ω[O⁄A] _).trans
      (LinearEquiv.ofTop _ (span_D_eq_top M hx)))

theorem length_kaehler_eq (M : Submonoid C) [IsLocalization M O] {x : C}
    (hx : Algebra.adjoin A {x} = ⊤) {g : A[X]} (hg : ∀ h : A[X], aeval x h = 0 → g ∣ h)
    (hgx : aeval x g = 0) :
    Module.length O Ω[O⁄A] = Module.length O (O ⧸ derivIdeal O x g) :=
  (quotEquivKaehler O M hx hg hgx).length_eq.symm

end Localization

end Monogenic

section Length

open UniqueFactorizationMonoid

/-- For `B` a Dedekind domain, `P` a nonzero prime of `B` and `O` the localization of `B` at `P`,
the length of `O ⧸ I O` is the exponent of `P` in the factorization of the nonzero ideal `I`. -/
theorem length_quotient_map_eq_count {B O : Type*} [CommRing B] [IsDedekindDomain B] [CommRing O]
    [Algebra B O] (P : Ideal B) [P.IsPrime] (hP : P ≠ ⊥) [IsLocalization.AtPrime O P]
    {I : Ideal B} (hI : I ≠ ⊥) :
    Module.length O (O ⧸ I.map (algebraMap B O)) = (normalizedFactors I).count P := by
  have : P.IsMaximal := Ideal.IsPrime.isMaximal ‹_› hP
  obtain ⟨J, hPJ, h⟩ := Ideal.eq_prime_pow_mul_coprime hI P
  have hJ : ¬ J ≤ P := by
    intro hle
    rw [sup_of_le_left hle] at hPJ
    exact Ideal.IsPrime.ne_top ‹_› hPJ
  have : IsDomain O := IsLocalization.isDomain_of_le_nonZeroDivisors (S := O) (M := P.primeCompl)
    P.primeCompl_le_nonZeroDivisors
  have : IsLocalRing O := IsLocalization.AtPrime.isLocalRing O P
  have hdvr := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B hP O
  conv_lhs => rw [h, Ideal.map_mul, Ideal.map_pow, IsLocalization.AtPrime.map_eq_top_of_not_le O hJ,
    Ideal.mul_top, IsLocalization.AtPrime.map_eq_maximalIdeal P O]
  rw [hdvr.length_quotient_pow_maximalIdeal]

end Length

section Conductor

variable {A B O : Type*} [CommRing A] [CommRing B] [CommRing O] [Algebra A B] [Algebra B O]
  [Algebra A O] [IsScalarTower A B O]

omit [Algebra A O] [IsScalarTower A B O] in
/-- If the conductor of `A[x]` in `B` is not contained in the prime `P`, the localization `B_P` is
also the localization of `A[x]` at the prime `P ∩ A[x]`. -/
theorem isLocalization_adjoin (P : Ideal B) [P.IsPrime] [IsLocalization.AtPrime O P] {x : B}
    (hc : ¬ conductor A x ≤ P) :
    IsLocalization (P.comap (algebraMap (Algebra.adjoin A {x}) B)).primeCompl O := by
  obtain ⟨r, hr, hrP⟩ := IsConcreteLE.not_le_iff_exists.mp hc
  refine (isLocalization_iff _ _).mpr ⟨fun c ↦ IsLocalization.map_units O
    (⟨(c : B), c.2⟩ : P.primeCompl), fun z ↦ ?_, fun {c₁ c₂} h ↦ ?_⟩
  · obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl z
    refine ⟨(⟨r * b, hr b⟩, ⟨⟨r * s, hr s⟩, ?_⟩), ?_⟩
    · exact (inferInstance : P.IsPrime).mul_notMem hrP s.2
    · simp only [Subalgebra.algebraMap_mk, map_mul]
      rw [mul_left_comm, IsLocalization.mk'_spec]
  · obtain ⟨s, hs⟩ := IsLocalization.exists_of_eq (M := P.primeCompl) h
    refine ⟨⟨⟨r * s, hr s⟩, (inferInstance : P.IsPrime).mul_notMem hrP s.2⟩, Subtype.ext ?_⟩
    simp only [Subalgebra.coe_mul, mul_assoc]
    exact congrArg (r * ·) hs

theorem adjoin_singleton_mk_eq_top (x : B) :
    Algebra.adjoin A {(⟨x, Algebra.self_mem_adjoin_singleton A x⟩ : Algebra.adjoin A {x})} =
      ⊤ := by
  convert Algebra.adjoin_adjoin_coe_preimage (R := A) (s := {x})
  ext c
  simp [Subtype.ext_iff]

omit [Algebra A O] [IsScalarTower A B O] in
/-- **Nakayama's lemma for the conductor**: if `A[x] → B ⧸ P` is surjective and `P = pB + h₀(x) B`
for an ideal `p` of `A` below `P`, then some `r ∈ A[x]` with `r ≡ 1 mod P` satisfies `r B ⊆ A[x]`,
so the conductor of `A[x]` is not contained in `P`. -/
theorem not_conductor_le_of_eq_sup [Module.Finite A B] (p : Ideal A) (P : Ideal B) [P.IsPrime]
    (hpP : p ≤ P.comap (algebraMap A B)) {x : B} (hsurj : ∀ b : B, ∃ h : A[X], b - aeval x h ∈ P)
    {h₀ : A[X]} (hP : P = p.map (algebraMap A B) ⊔ Ideal.span {aeval x h₀}) :
    ¬ conductor A x ≤ P := by
  have : Module.Finite (Algebra.adjoin A {x}) B :=
    Module.Finite.of_restrictScalars_finite A (Algebra.adjoin A {x}) B
  set I : Ideal (Algebra.adjoin A {x}) := P.comap (algebraMap (Algebra.adjoin A {x}) B)
  have hI : I.map (algebraMap (Algebra.adjoin A {x}) B) = P := by
    refine le_antisymm Ideal.map_comap_le ?_
    conv_lhs => rw [hP]
    refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply A (Algebra.adjoin A {x}) B]
      refine Ideal.mem_map_of_mem _ ?_
      rw [Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
      exact hpP ha
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
      have hmem : aeval x h₀ ∈ Algebra.adjoin A {x} := aeval_mem_adjoin_singleton A x
      change algebraMap (Algebra.adjoin A {x}) B ⟨_, hmem⟩ ∈ _
      refine Ideal.mem_map_of_mem _ ?_
      rw [Ideal.mem_comap]
      change aeval x h₀ ∈ P
      rw [hP]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup (I := I)
    (N := Submodule.span (Algebra.adjoin A {x}) {(1 : B)}) (N' := ⊤) (P := ⊤)
    Module.Finite.fg_top le_rfl (by
      rw [Ideal.smul_top_eq_map, hI]
      intro b _
      obtain ⟨h, hh⟩ := hsurj b
      have hmem : aeval x h ∈ Algebra.adjoin A {x} := aeval_mem_adjoin_singleton A x
      refine Submodule.mem_sup.mpr ⟨aeval x h, ?_, b - aeval x h, hh, add_sub_cancel _ _⟩
      refine Submodule.mem_span_singleton.mpr ⟨⟨_, hmem⟩, ?_⟩
      rw [Subalgebra.smul_def, smul_eq_mul, mul_one])
  intro hle
  have hrc : (r : B) ∈ conductor A x := by
    rw [mem_conductor_iff]
    intro b
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hr (Submodule.smul_mem_pointwise_smul b r ⊤
      Submodule.mem_top))
    rw [Subalgebra.smul_def, smul_eq_mul, mul_one, Subalgebra.smul_def, smul_eq_mul] at hc
    rw [← hc]
    exact c.2
  have h1 : (r : B) - 1 ∈ P := by
    have := hr1
    rw [Ideal.mem_comap, map_sub, map_one] at this
    exact this
  exact (inferInstance : P.IsPrime).ne_top ((Ideal.eq_top_iff_one _).mpr (by
    simpa using P.sub_mem (hle hrc) h1))

omit [CommRing O] [Algebra B O] [Algebra A O] [IsScalarTower A B O] in
/-- If the conductor of `A[x]` in `B` is nonzero, `x` generates the fraction field `L` of `B` over
the field `K`: `L` is a localization of `B` at nonzero elements of `A`, and any `b / s` equals
`(r b) / (r s)` with `r b, r s ∈ A[x]` for a nonzero `r` in the conductor. -/
theorem adjoin_eq_top_of_mem_conductor {K L : Type*} [Field K] [Field L] [Algebra A K]
    [Algebra B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [IsDomain B] [IsFractionRing B L] [Algebra.IsAlgebraic K L] (M : Submonoid A)
    [IsLocalization (Algebra.algebraMapSubmonoid B M) L] {x r : B} (hr : r ∈ conductor A x)
    (hr0 : r ≠ 0) : Algebra.adjoin K {algebraMap B L x} = ⊤ := by
  have hmem : ∀ z ∈ Algebra.adjoin A {x}, algebraMap B L z ∈ Algebra.adjoin K {algebraMap B L x} := by
    intro z hz
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
    obtain ⟨h, rfl⟩ := hz
    rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ← aeval_algebraMap_apply,
      ← aeval_map_algebraMap K]
    exact aeval_mem_adjoin_singleton K _
  rw [eq_top_iff]
  intro ℓ _
  obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid B M) ℓ
  have hs := IsLocalization.map_units L s
  have hrs : algebraMap B L (r * s) ≠ 0 := by
    rw [map_mul]
    exact mul_ne_zero ((map_ne_zero_iff _ (IsFractionRing.injective B L)).mpr hr0) hs.ne_zero
  have : IsLocalization.mk' L b s = algebraMap B L (r * b) * (algebraMap B L (r * s))⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ hrs, map_mul, map_mul, mul_left_comm, IsLocalization.mk'_spec,
      mul_comm]
  change IsLocalization.mk' L b s ∈ _
  rw [this]
  have hrs' := hmem _ (hr s)
  exact Subalgebra.mul_mem _ (hmem _ (hr b))
    ((Algebra.adjoin K {algebraMap B L x}).inv_mem_of_algebraic (x := ⟨_, hrs'⟩)
      (Algebra.IsAlgebraic.isAlgebraic _))

omit [CommRing O] [Algebra B O] [Algebra A O] [IsScalarTower A B O] in
theorem mk_aeval_eq (p : Ideal A) (P : Ideal B) [P.LiesOver p] (θ : B) (g : A[X]) :
    Ideal.Quotient.mk P (aeval θ g) =
      aeval (Ideal.Quotient.mk P θ) (g.map (algebraMap A (A ⧸ p))) := by
  rw [aeval_map_algebraMap, ← Ideal.Quotient.mkₐ_eq_mk A, aeval_algHom_apply]

attribute [local instance] Ideal.Quotient.field

open IntermediateField in
omit [CommRing O] [Algebra B O] [Algebra A O] [IsScalarTower A B O] in
/-- **Choice of a generator modulo `P`**: for a nonzero maximal ideal `P` of a Dedekind domain `B`,
finite over `A`, lying over a maximal ideal `p` with `B ⧸ P` separable over `A ⧸ p`, there is
`x ∈ B` such that `A[x] → B ⧸ P` is surjective and `P = pB + h₀(x) B` for some `h₀ ∈ A[X]`.
One takes a lift `θ` of a nonzero primitive element of `B ⧸ P`, a lift `g₀` of its minimal
polynomial, adjusts `θ` by a uniformizer so that `g₀(θ) ∉ P²`, and moves it by an element of `P²`
into the part of `pB` prime to `P`. -/
theorem exists_surjective_and_eq_sup [IsDedekindDomain B] [Module.Finite A B] (p : Ideal A)
    [p.IsMaximal] (P : Ideal B) [P.IsMaximal] [P.LiesOver p] (hP : P ≠ ⊥)
    (hpB : p.map (algebraMap A B) ≠ ⊥) [Algebra.IsSeparable (A ⧸ p) (B ⧸ P)] :
    ∃ (x : B) (h₀ : A[X]), (∀ b : B, ∃ h : A[X], b - aeval x h ∈ P) ∧
      P = p.map (algebraMap A B) ⊔ Ideal.span {aeval x h₀} := by
  -- a nonzero primitive element of the residue extension
  obtain ⟨α₀, hα₀⟩ := Field.exists_primitive_element (A ⧸ p) (B ⧸ P)
  obtain ⟨α, hα0, hαtop⟩ : ∃ α : B ⧸ P, α ≠ 0 ∧ (A ⧸ p)⟮α⟯ = ⊤ := by
    by_cases h : α₀ = 0
    · refine ⟨1, one_ne_zero, ?_⟩
      rw [IntermediateField.adjoin_one, ← hα₀, h, IntermediateField.adjoin_zero]
    · exact ⟨α₀, h, hα₀⟩
  have hαint : IsIntegral (A ⧸ p) α := Algebra.IsIntegral.isIntegral α
  have hαadj : Algebra.adjoin (A ⧸ p) {α} = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hαint.isAlgebraic, hαtop,
      IntermediateField.top_toSubalgebra]
  have hsurjA : Function.Surjective (algebraMap A (A ⧸ p)) := by
    rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective
  obtain ⟨θ, rfl⟩ := Ideal.Quotient.mk_surjective α
  obtain ⟨g₀, hg₀⟩ := Polynomial.map_surjective _ hsurjA
    (minpoly (A ⧸ p) (Ideal.Quotient.mk P θ))
  -- basic properties of `g₀`
  have hroot : ∀ z : B, z - θ ∈ P → aeval z g₀ ∈ P := by
    intro z hz
    rw [← Ideal.Quotient.eq_zero_iff_mem, mk_aeval_eq p, Ideal.Quotient.eq.mpr hz, hg₀,
      minpoly.aeval]
  have hderiv : aeval θ (derivative g₀) ∉ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, mk_aeval_eq p, ← derivative_map, hg₀]
    exact (Algebra.IsSeparable.isSeparable (A ⧸ p) _).aeval_derivative_ne_zero (minpoly.aeval _ _)
  have hcoeff : g₀.coeff 0 ∉ p := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.algebraMap_eq, ← coeff_map, hg₀]
    exact minpoly.coeff_zero_ne_zero hαint hα0
  have heval : ∀ z : B, aeval z g₀ = (g₀.map (algebraMap A B)).eval z := fun z ↦ by
    rw [aeval_def, eval₂_eq_eval_map]
  -- a uniformizer
  obtain ⟨π, hπ, hπ2⟩ := Ideal.exists_mem_pow_notMem_pow_succ P hP
    (Ideal.IsPrime.ne_top inferInstance) 1
  rw [pow_one] at hπ
  -- `y ≡ θ mod P` with `g₀(y) ∉ P²`
  obtain ⟨y, hyθ, hy⟩ : ∃ y : B, y - θ ∈ P ∧ aeval y g₀ ∉ P ^ 2 := by
    by_cases h : aeval θ g₀ ∈ P ^ 2
    · refine ⟨θ + π, by simpa using hπ, fun h' ↦ hπ2 ?_⟩
      obtain ⟨k, hk⟩ := binomExpansion (g₀.map (algebraMap A B)) θ π
      have hmem : (g₀.map (algebraMap A B)).derivative.eval θ * π ∈ P ^ 2 := by
        have : (g₀.map (algebraMap A B)).derivative.eval θ * π =
            aeval (θ + π) g₀ - aeval θ g₀ - k * π ^ 2 := by
          rw [heval, heval, hk]; ring
        rw [this]
        refine sub_mem (sub_mem h' h) (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hπ 2))
      rw [derivative_map, ← eval₂_eq_eval_map, ← aeval_def] at hmem
      exact (Ideal.IsMaximal.mul_mem_pow P hmem).resolve_left hderiv
    · exact ⟨θ, by simp, h⟩
  -- the part of `pB` prime to `P`, and the Chinese remainder theorem
  obtain ⟨Q, hPQ, hpQ⟩ := Ideal.eq_prime_pow_mul_coprime hpB P
  have hP2Q : P ^ 2 ⊔ Q = ⊤ := by
    rw [sup_comm]; exact Ideal.sup_pow_eq_top (sup_comm P Q ▸ hPQ)
  obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.mp (hP2Q ▸ Submodule.mem_top : (1 : B) ∈ P ^ 2 ⊔ Q)
  set x := y * j with hx
  have hxy : x - y ∈ P ^ 2 := by
    rw [show x - y = -(y * i) by rw [hx]; linear_combination y * hij]
    exact neg_mem (Ideal.mul_mem_left _ _ hi)
  have hxθ : x - θ ∈ P := by
    rw [show x - θ = (x - y) + (y - θ) by ring]
    exact add_mem (Ideal.pow_le_self two_ne_zero hxy) hyθ
  set t := aeval x g₀ with ht
  have htP : t ∈ P := hroot x hxθ
  have ht2 : t ∉ P ^ 2 := by
    intro h
    obtain ⟨c, hc⟩ := sub_dvd_eval_sub x y (g₀.map (algebraMap A B))
    rw [← heval, ← heval] at hc
    refine hy ?_
    rw [show aeval y g₀ = t - (x - y) * c by rw [← hc]; ring]
    exact sub_mem h (Ideal.mul_mem_right _ _ hxy)
  have htM : ∀ M : Ideal B, M.IsMaximal → M ≠ P → p.map (algebraMap A B) ≤ M → t ∉ M := by
    intro M hM hMP hpM htM
    have hQM : Q ≤ M := by
      rw [hpQ] at hpM
      refine ((hM.isPrime.mul_le).mp hpM).resolve_left fun h ↦ hMP ?_
      exact ((inferInstance : P.IsMaximal).eq_of_le hM.ne_top (hM.isPrime.le_of_pow_le h)).symm
    have hxM : x ∈ M := Ideal.mul_mem_left _ _ (hQM hj)
    obtain ⟨c, hc⟩ := sub_dvd_eval_sub x 0 (g₀.map (algebraMap A B))
    rw [← heval, ← coeff_zero_eq_eval_zero, coeff_map, sub_zero] at hc
    have h0 : algebraMap A B (g₀.coeff 0) ∈ M := by
      rw [show algebraMap A B (g₀.coeff 0) = t - x * c by rw [← hc]; ring]
      exact sub_mem htM (Ideal.mul_mem_right _ _ hxM)
    have hcomap : M.comap (algebraMap A B) = p :=
      ((inferInstance : p.IsMaximal).eq_of_le (Ideal.IsPrime.comap _ (hK := hM.isPrime)).ne_top
        (Ideal.map_le_iff_le_comap.mp hpM)).symm
    exact hcoeff (hcomap ▸ h0)
  refine ⟨x, g₀, fun b ↦ ?_, ?_⟩
  · have hb : Ideal.Quotient.mk P b ∈ Algebra.adjoin (A ⧸ p) {Ideal.Quotient.mk P θ} :=
      hαadj ▸ Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨h', hh'⟩ := hb
    obtain ⟨h, rfl⟩ := Polynomial.map_surjective _ hsurjA h'
    refine ⟨h, Ideal.Quotient.eq.mp ?_⟩
    rw [mk_aeval_eq p, Ideal.Quotient.eq.mpr hxθ]
    exact hh'.symm
  · have hJP : p.map (algebraMap A B) ⊔ Ideal.span {t} ≤ P := by
      refine sup_le ?_ ?_
      · rw [Ideal.map_le_iff_le_comap]; exact le_of_eq (Ideal.over_def P p)
      · rw [Ideal.span_le, Set.singleton_subset_iff]; exact htP
    obtain ⟨I', hI'⟩ := Ideal.dvd_iff_le.mpr hJP
    by_cases hI'top : I' = ⊤
    · rw [hI', hI'top, Ideal.mul_top]
    obtain ⟨M, hM, hI'M⟩ := Ideal.exists_le_maximal I' hI'top
    have htJ : t ∈ p.map (algebraMap A B) ⊔ Ideal.span {t} :=
      Ideal.mem_sup_right (Ideal.mem_span_singleton_self t)
    by_cases hMP : M = P
    · refine absurd ?_ ht2
      rw [hI', pow_two] at *
      exact Ideal.mul_mono_right (hMP ▸ hI'M) htJ
    · have hJM : p.map (algebraMap A B) ⊔ Ideal.span {t} ≤ M := hI' ▸ (show P * I' ≤ I' from Ideal.mul_le_right).trans hI'M
      exact absurd (hJM htJ) (htM M hM hMP (le_sup_left.trans hJM))

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

open UniqueFactorizationMonoid

/-- **The length of `Ω[B_P⁄A]` is the exponent of `P` in the different**, for `x ∈ B` generating
the fraction field of `B` over that of `A` whose conductor is prime to `P`: then `B_P` is a
localization of `A[x]`, so that `Ω[B_P⁄A] ≅ B_P ⧸ (g'(x))` for the minimal polynomial `g` of `x`
(`quotEquivKaehler`), and `(g'(x)) B_P = 𝔇_{B/A} B_P` by `conductor_mul_differentIdeal`. -/
theorem length_kaehler_eq_count_of_not_conductor_le [IsDomain A] [IsIntegrallyClosed A]
    [IsDedekindDomain B] [Module.IsTorsionFree A B] [Module.Finite A B]
    [Algebra.IsSeparable (FractionRing A) (FractionRing B)]
    (P : Ideal B) [P.IsPrime] (hP : P ≠ ⊥) [IsLocalization.AtPrime O P] {x : B}
    (hx : Algebra.adjoin (FractionRing A) {algebraMap B (FractionRing B) x} = ⊤)
    (hc : ¬ conductor A x ≤ P) :
    Module.length O Ω[O⁄A] = (normalizedFactors (differentIdeal A B)).count P := by
  have : IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (FractionRing B) :=
    IsIntegralClosure.isLocalization _ (FractionRing A) _ _
  have : FiniteDimensional (FractionRing A) (FractionRing B) :=
    .of_isLocalization A B (nonZeroDivisors A)
  have := isLocalization_adjoin (A := A) (O := O) P hc
  have hxi : IsIntegral A x := Algebra.IsIntegral.isIntegral x
  set xC : Algebra.adjoin A {x} := ⟨x, Algebra.self_mem_adjoin_singleton A x⟩
  have hg : ∀ h : A[X], aeval xC h = 0 → minpoly A x ∣ h := fun h hh ↦
    minpoly.isIntegrallyClosed_dvd hxi (by
      change aeval (xC : B) h = 0
      rw [← aeval_subalgebra_coe, hh, ZeroMemClass.coe_zero])
  have hgx : aeval xC (minpoly A x) = 0 := Subtype.ext (by
    rw [aeval_subalgebra_coe, ZeroMemClass.coe_zero]; exact minpoly.aeval A x)
  rw [length_kaehler_eq (P.comap (algebraMap (Algebra.adjoin A {x}) B)).primeCompl
    (adjoin_singleton_mk_eq_top x) hg hgx]
  have hd : derivIdeal O xC (minpoly A x) = (differentIdeal A B).map (algebraMap B O) := by
    have h1 := congrArg (Ideal.map (algebraMap B O))
      (conductor_mul_differentIdeal A (FractionRing A) (FractionRing B) x hx)
    rw [Ideal.map_mul, IsLocalization.AtPrime.map_eq_top_of_not_le O hc, Ideal.top_mul,
      Ideal.map_span, Set.image_singleton] at h1
    rw [h1, derivIdeal, Subalgebra.algebraMap_def, aeval_subalgebra_coe]
  rw [hd, length_quotient_map_eq_count P hP differentIdeal_ne_bot]

/-- **The length of `Ω[B_P⁄A]` is the exponent of `P` in the different** (Serre, *Local Fields*,
III §7, Prop. 14, localized at `P`): for `B` a Dedekind domain finite over the integrally closed
domain `A` with separable fraction field extension, `P` a nonzero maximal ideal of `B` over the
maximal ideal `p ≠ 0` of `A` with separable residue extension, and `O = B_P`. -/
theorem length_kaehler_eq_count [IsDomain A] [IsIntegrallyClosed A]
    [IsDedekindDomain B] [Module.IsTorsionFree A B] [Module.Finite A B]
    [Algebra.IsSeparable (FractionRing A) (FractionRing B)] (p : Ideal A) [p.IsMaximal]
    (hp : p ≠ ⊥) (P : Ideal B) [P.IsMaximal] [P.LiesOver p] (hP : P ≠ ⊥)
    [Algebra.IsSeparable (A ⧸ p) (B ⧸ P)] [IsLocalization.AtPrime O P] :
    Module.length O Ω[O⁄A] = (normalizedFactors (differentIdeal A B)).count P := by
  have : IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (FractionRing B) :=
    IsIntegralClosure.isLocalization _ (FractionRing A) _ _
  have : FiniteDimensional (FractionRing A) (FractionRing B) :=
    .of_isLocalization A B (nonZeroDivisors A)
  obtain ⟨x, h₀, hsurj, hPeq⟩ :=
    exists_surjective_and_eq_sup p P hP (Ideal.map_ne_bot_of_ne_bot hp)
  have hc := not_conductor_le_of_eq_sup p P (le_of_eq (Ideal.over_def P p)) hsurj hPeq
  obtain ⟨r, hr, hrP⟩ := IsConcreteLE.not_le_iff_exists.mp hc
  have hx := adjoin_eq_top_of_mem_conductor (K := FractionRing A) (L := FractionRing B)
    (nonZeroDivisors A) hr (fun h ↦ hrP (h ▸ zero_mem P))
  exact length_kaehler_eq_count_of_not_conductor_le P hP hx hc

