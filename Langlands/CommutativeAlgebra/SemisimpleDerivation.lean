import Langlands.CommutativeAlgebra.GradedFixedQuotientSmooth
import Mathlib.LinearAlgebra.Eigenspace.Semisimple
import Mathlib.RingTheory.Derivation.Basic

/-! # Smooth quotients by the image of a locally semisimple derivation -/

noncomputable section

universe u v

namespace Langlands.Algebra.SemisimpleDerivation

section Linear

variable {k : Type u} [Field k] {M : Type v} [AddCommGroup M] [Module k M]

/-- Every vector belongs to a finite-dimensional invariant subspace on which the
endomorphism is semisimple. -/
def LocallySemisimple (f : Module.End k M) : Prop :=
  ∀ x : M, ∃ (V : Submodule k M) (hV : ∀ y ∈ V, f y ∈ V),
    x ∈ V ∧ FiniteDimensional k V ∧ Module.End.IsSemisimple (f.restrict hV)

/-- The eigenspaces of an endomorphism span the entire vector space. -/
def HasEigenDecomposition (f : Module.End k M) : Prop :=
  (⨆ μ : k, Module.End.eigenspace f μ) = ⊤

/-- Local finite-dimensional semisimplicity supplies an eigenspace decomposition
over an algebraically closed field, even for an infinite-dimensional space. -/
theorem LocallySemisimple.hasEigenDecomposition [IsAlgClosed k]
    {f : Module.End k M} (hf : LocallySemisimple f) :
    HasEigenDecomposition f := by
  apply top_unique
  intro x _
  obtain ⟨V, hV, hx, hfin, hsem⟩ := hf x
  let := hfin
  have hle : V ≤ ⨆ μ : k, Module.End.eigenspace f μ := by
    calc
      V = (⊤ : Submodule k V).map V.subtype := by simp
      _ = (⨆ μ : k, Module.End.eigenspace (f.restrict hV) μ).map V.subtype := by
        rw [hsem.iSup_eigenspace_eq_top]
      _ = ⨆ μ : k, (Module.End.eigenspace (f.restrict hV) μ).map V.subtype := by
        rw [Submodule.map_iSup]
      _ ≤ ⨆ μ : k, Module.End.eigenspace f μ := iSup_le fun μ =>
        (Module.End.eigenspace_restrict_le_eigenspace f hV μ).trans (le_iSup _ μ)
  exact hle hx

end Linear

section Derivation

variable {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
  (D : Derivation k A A)

/-- Leibniz makes products of eigenvectors homogeneous for addition of
eigenvalues. -/
theorem eigenspaceGradedMonoid :
    SetLike.GradedMonoid (fun μ : k => Module.End.eigenspace D.toLinearMap μ) where
  one_mem := by
    rw [Module.End.mem_eigenspace_iff]
    exact D.map_one_eq_zero.trans (zero_smul k (1 : A)).symm
  mul_mem μ ν x y hx hy := by
    rw [Module.End.mem_eigenspace_iff] at hx hy ⊢
    change D (x * y) = (μ + ν) • (x * y)
    change D x = μ • x at hx
    change D y = ν • y at hy
    rw [D.leibniz, hx, hy]
    simp only [smul_eq_mul, Algebra.mul_smul_comm, add_smul]
    rw [mul_comm y x, add_comm]

/-- Independent eigenspaces and the spanning premise give an actual grading
by the additive group of the ground field. -/
@[instance_reducible] def eigenGrading [DecidableEq k]
    (hD : HasEigenDecomposition D.toLinearMap) :
    GradedAlgebra (fun μ : k => Module.End.eigenspace D.toLinearMap μ) := by
  classical
  letI := eigenspaceGradedMonoid D
  exact (DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    (Module.End.eigenspaces_iSupIndep D.toLinearMap) hD).gradedAlgebra

/-- The ideal generated by all values of the derivation. -/
def imageIdeal : Ideal A :=
  Ideal.span (Set.range D)

/-- For a derivation with spanning eigenspaces, its image ideal is exactly the
ideal generated by nonzero eigenvectors. -/
theorem imageIdeal_eq_fixedIdeal (hD : HasEigenDecomposition D.toLinearMap) :
    imageIdeal D =
      GradedFixedQuotient.fixedIdeal
        (fun μ : k => Module.End.eigenspace D.toLinearMap μ) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨x, rfl⟩
    have hx : x ∈ ⨆ μ : k, Module.End.eigenspace D.toLinearMap μ := by
      rw [hD]
      trivial
    refine Submodule.iSup_induction _
      (motive := fun y => D y ∈ GradedFixedQuotient.fixedIdeal
        (fun μ : k => Module.End.eigenspace D.toLinearMap μ)) hx ?_ ?_ ?_
    · intro μ y hy
      have he : D y = μ • y := Module.End.mem_eigenspace_iff.mp hy
      rw [he]
      by_cases hμ : μ = 0
      · simp [hμ]
      · simpa only [Algebra.smul_def] using
          Ideal.mul_mem_left _ (algebraMap k A μ)
            (GradedFixedQuotient.mem_fixedIdeal _ hμ hy)
    · simp
    · intro y z hy hz
      simpa only [map_add] using Ideal.add_mem _ hy hz
  · apply Ideal.span_le.mpr
    rintro x ⟨μ, hμ, hx⟩
    have he : D x = μ • x := Module.End.mem_eigenspace_iff.mp hx
    apply Ideal.subset_span
    refine ⟨μ⁻¹ • x, ?_⟩
    rw [D.map_smul, he, smul_smul, inv_mul_cancel₀ hμ, one_smul]

/-- A quotient by the image ideal of an eigenspace-spanned derivation of a
formally smooth algebra is formally smooth. -/
theorem formallySmooth_quotient_imageIdeal
    (hD : HasEigenDecomposition D.toLinearMap) [Algebra.FormallySmooth k A] :
    Algebra.FormallySmooth k (A ⧸ imageIdeal D) := by
  classical
  let := eigenGrading D hD
  rw [imageIdeal_eq_fixedIdeal D hD]
  exact GradedFixedQuotient.formallySmooth _

/-- A quotient by the image ideal of an eigenspace-spanned derivation of a
smooth algebra over a field is smooth. -/
theorem smooth_quotient_imageIdeal
    (hD : HasEigenDecomposition D.toLinearMap) [Algebra.Smooth k A] :
    Algebra.Smooth k (A ⧸ imageIdeal D) := by
  classical
  let := eigenGrading D hD
  rw [imageIdeal_eq_fixedIdeal D hD]
  exact GradedFixedQuotient.smooth _

/-- Over an algebraically closed field, local finite-dimensional
semisimplicity is enough for formal smoothness of the image-ideal quotient. -/
theorem formallySmooth_quotient_imageIdeal_of_locallySemisimple [IsAlgClosed k]
    (hD : LocallySemisimple D.toLinearMap) [Algebra.FormallySmooth k A] :
    Algebra.FormallySmooth k (A ⧸ imageIdeal D) :=
  formallySmooth_quotient_imageIdeal D hD.hasEigenDecomposition

/-- Over an algebraically closed field, local finite-dimensional
semisimplicity is enough for smoothness of the image-ideal quotient. -/
theorem smooth_quotient_imageIdeal_of_locallySemisimple [IsAlgClosed k]
    (hD : LocallySemisimple D.toLinearMap) [Algebra.Smooth k A] :
    Algebra.Smooth k (A ⧸ imageIdeal D) :=
  smooth_quotient_imageIdeal D hD.hasEigenDecomposition

end Derivation

end Langlands.Algebra.SemisimpleDerivation
