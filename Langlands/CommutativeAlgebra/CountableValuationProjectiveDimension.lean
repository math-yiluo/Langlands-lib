import Langlands.CommutativeAlgebra.SequentialSubmoduleResolution
import Langlands.CommutativeAlgebra.ValuationFiniteFreePresentation
import Langlands.CommutativeAlgebra.PolynomialProjectiveDimension
import Mathlib.Algebra.Polynomial.Basis
import Mathlib.LinearAlgebra.Finsupp.VectorSpace
import Mathlib.Data.Set.Countable

/-! # Countable spanning families over valuation domains -/

universe u v w

namespace Langlands.CommutativeAlgebra

open CategoryTheory Module Polynomial

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-- Existence of a natural-number-indexed spanning family. -/
def CountablySpanned (R : Type u) [CommRing R] (M : Type v)
    [AddCommGroup M] [Module R M] : Prop :=
  ∃ g : ℕ → M, Submodule.span R (Set.range g) = ⊤

/-- The submodule generated by the first `n` members of a sequence. -/
def finiteGeneratorSpan (g : ℕ → M) (n : ℕ) : Submodule R M :=
  Submodule.span R (g '' (Finset.range n : Set ℕ))

theorem finiteGeneratorSpan_monotone (g : ℕ → M) :
    Monotone (finiteGeneratorSpan (R := R) g) := by
  intro n m hnm
  apply Submodule.span_mono
  exact Set.image_mono (by simpa using Finset.range_mono hnm)

theorem finiteGeneratorSpan_fg (g : ℕ → M) (n : ℕ) :
    (finiteGeneratorSpan (R := R) g n).FG :=
  Submodule.fg_span ((Finset.range n).finite_toSet.image g)

theorem iSup_finiteGeneratorSpan (g : ℕ → M) :
    iSup (finiteGeneratorSpan (R := R) g) = Submodule.span R (Set.range g) := by
  apply le_antisymm
  · apply iSup_le
    intro n
    exact Submodule.span_mono (Set.image_subset_range _ _)
  · apply Submodule.span_le.2
    rintro _ ⟨n, rfl⟩
    apply (le_iSup (finiteGeneratorSpan (R := R) g) (n + 1))
    exact Submodule.subset_span ⟨n, by simp, rfl⟩

theorem countablySpanned_of_countable_spanning_set (s : Set M) (hs : s.Countable)
    (hspan : Submodule.span R s = ⊤) : CountablySpanned R M := by
  obtain ⟨g, hg⟩ := (hs.insert 0).exists_eq_range (Set.insert_nonempty 0 s)
  refine ⟨g, top_unique ?_⟩
  rw [← hg]
  exact hspan.ge.trans (Submodule.span_mono (Set.subset_insert 0 s))

theorem CountablySpanned.of_surjective {N : Type w} [AddCommGroup N] [Module R N]
    (hM : CountablySpanned R M) (f : M →ₗ[R] N) (hf : Function.Surjective f) :
    CountablySpanned R N := by
  obtain ⟨g, hg⟩ := hM
  refine ⟨f ∘ g, ?_⟩
  rw [Set.range_comp, ← Submodule.map_span, hg, Submodule.map_top]
  exact LinearMap.range_eq_top.2 hf

theorem countablySpanned_of_countable_basis {ι : Type w} [Countable ι]
    (b : Basis ι R M) : CountablySpanned R M :=
  countablySpanned_of_countable_spanning_set (Set.range b) (Set.countable_range b) b.span_eq

/-- Finite modules over `R[X]` have a countable spanning family over `R`. -/
theorem countablySpanned_of_finite_polynomial (M : Type v) [AddCommGroup M]
    [Module R M] [Module R[X] M] [IsScalarTower R R[X] M] [Module.Finite R[X] M] :
    CountablySpanned R M := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R[X] M
  let b : Basis (Σ _ : Fin n, ℕ) R (Fin n → R[X]) :=
    (Finsupp.basis (fun _ : Fin n => Polynomial.basisMonomials R)).map
      (Finsupp.linearEquivFunOnFinite R R[X] (Fin n))
  exact (countablySpanned_of_countable_basis b).of_surjective (f.restrictScalars R) hf

/-- A countably spanned torsion-free module over a valuation domain has dimension at most one. -/
theorem hasProjectiveDimensionLE_one_of_countablySpanned_of_valuationRing
    [IsDomain R] [ValuationRing R] [Module.IsTorsionFree R M]
    (hM : CountablySpanned R M) :
    HasProjectiveDimensionLE (ModuleCat.of R M) 1 := by
  obtain ⟨g, hg⟩ := hM
  let F := finiteGeneratorSpan (R := R) g
  have (n : ℕ) : Module.Finite R (F n) :=
    Module.Finite.of_fg (finiteGeneratorSpan_fg g n)
  have (n : ℕ) : Module.Free R (F n) :=
    free_of_finite_of_isTorsionFree_of_valuationRing (F n)
  exact hasProjectiveDimensionLE_one_of_sequential_projective_submodules F
    (finiteGeneratorSpan_monotone g) ((iSup_finiteGeneratorSpan g).trans hg)

/-- A finite polynomial module torsion-free over the valuation domain has dimension at most two. -/
theorem hasProjectiveDimensionLE_two_of_finite_polynomial_of_valuationRing
    [Small.{v} R] [IsDomain R] [ValuationRing R]
    (M : Type v) [AddCommGroup M] [Module R M] [Module R[X] M]
    [IsScalarTower R R[X] M] [Module.Finite R[X] M] [Module.IsTorsionFree R M] :
    HasProjectiveDimensionLE (ModuleCat.of R[X] M) 2 := by
  have := hasProjectiveDimensionLE_one_of_countablySpanned_of_valuationRing
    (countablySpanned_of_finite_polynomial (R := R) M)
  exact polynomialAction_hasProjectiveDimensionLE 1 M

/-- Finitely presented modules over a valuation domain's polynomial ring have dimension at most three. -/
theorem hasProjectiveDimensionLE_three_of_finitePresentation_polynomial_of_valuationRing
    [IsDomain R] [ValuationRing R]
    (M : Type u) [AddCommGroup M] [Module R[X] M] [Module.FinitePresentation R[X] M] :
    HasProjectiveDimensionLE (ModuleCat.of R[X] M) 3 := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R[X] M
  have : Module.Finite R[X] (LinearMap.ker f) :=
    Module.Finite.of_fg (Module.FinitePresentation.fg_ker f hf)
  have hK := hasProjectiveDimensionLE_two_of_finite_polynomial_of_valuationRing
    (R := R) (LinearMap.ker f)
  have hF : HasProjectiveDimensionLT (ModuleCat.of R[X] (Fin n → R[X])) 4 :=
    inferInstance
  exact (LinearMap.shortExact_shortComplexKer hf).hasProjectiveDimensionLT_X₃ 3 hK hF

/-- The finite-dimension predicate holds for a polynomial ring over any valuation domain. -/
theorem finiteProjectiveDimensionForFinitelyPresentedModules_polynomial_of_valuationRing
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] :
    FiniteProjectiveDimensionForFinitelyPresentedModules R[X] := by
  intro M _ _ _
  exact ⟨3,
    hasProjectiveDimensionLE_three_of_finitePresentation_polynomial_of_valuationRing M⟩

end Langlands.CommutativeAlgebra
