import Langlands.MathlibBase

/-!
# The integral closure of a local ring at the center of a discrete valuation ring

Let `A` be a local ring with nonzero maximal ideal, `O` a discrete valuation ring with fraction
field `K` and `A → O` a local homomorphism, with `A → K` injective and `K` algebraic over `A`, and
suppose that the integral closure `B` of `A` in `K` is a Dedekind domain. Then `B` lies in `O`
(`toRing`), the ideal `B ∩ 𝔪_O` (`centerIdeal`) is a maximal ideal of `B` over `𝔪_A`
(`centerIdeal_isMaximal`, `centerIdeal_liesOver`), and:

* `isLocalization_atPrime`: `O` is the localization of `B` at `B ∩ 𝔪_O`;
* `isLeast_count_normalizedFactors`: the exponent of `B ∩ 𝔪_O` in a nonzero ideal `I` of `B` is
  the least valuation in `O` of a nonzero element of `I`;
* `ramificationIdx_centerIdeal`: if `𝔪_A = (t)`, the ramification index of `B ∩ 𝔪_O` over `𝔪_A`
  is the valuation of `t` in `O`.
-/

noncomputable section

open IsLocalRing UniqueFactorizationMonoid

namespace Langlands.CommutativeAlgebra.IntegralClosureDvrCenter

variable (A O K : Type*) [CommRing A] [CommRing O] [Field K] [Algebra A K] [Algebra O K]

/-- The ideal `B ∩ 𝔪_O` of the integral closure `B` of `A` in `K`: the ideal of `B` generated by
the elements of `B` that are images of elements of the maximal ideal of `O`. When `B` lies in
the image of `O` it is the set of those elements (`mem_centerIdeal_iff`). -/
def centerIdeal [IsLocalRing O] : Ideal (integralClosure A K) :=
  Ideal.span {b | ∃ m ∈ maximalIdeal O, algebraMap O K m = (b : K)}

variable [IsFractionRing O K] [Algebra A O] [IsScalarTower A O K]

/-- If `O` is integrally closed with fraction field `K` and `A → K` factors through `O`, the
integral closure of `A` in `K` lies in the image of `O`. -/
theorem mem_range_of_mem_integralClosure [IsIntegrallyClosed O] (b : integralClosure A K) :
    (b : K) ∈ (algebraMap O K).range := by
  obtain ⟨o, ho⟩ := IsIntegrallyClosed.isIntegral_iff.mp (b.2.tower_top (A := O))
  exact ⟨o, ho⟩

/-- The inclusion of the integral closure of `A` in `K` into `O`. -/
def toRing [IsIntegrallyClosed O] : integralClosure A K →+* O :=
  (RingEquiv.ofBijective (algebraMap O K).rangeRestrict
    ⟨fun _ _ h ↦ IsFractionRing.injective O K (congrArg Subtype.val h),
      (algebraMap O K).rangeRestrict_surjective⟩).symm.toRingHom.comp
    ((integralClosure A K).val.toRingHom.codRestrict _
      (mem_range_of_mem_integralClosure A O K))

variable {A O K}

@[simp]
theorem algebraMap_toRing [IsIntegrallyClosed O] (b : integralClosure A K) :
    algebraMap O K (toRing A O K b) = b := by
  let e := RingEquiv.ofBijective (algebraMap O K).rangeRestrict
    ⟨fun _ _ h ↦ IsFractionRing.injective O K (congrArg Subtype.val h),
      (algebraMap O K).rangeRestrict_surjective⟩
  have := e.apply_symm_apply
    ((integralClosure A K).val.toRingHom.codRestrict _
      (mem_range_of_mem_integralClosure A O K) b)
  exact congrArg Subtype.val this

theorem toRing_injective [IsIntegrallyClosed O] : Function.Injective (toRing A O K) := by
  intro b c h
  have := congrArg (algebraMap O K) h
  rw [algebraMap_toRing, algebraMap_toRing] at this
  exact Subtype.val_injective this

theorem toRing_algebraMap [IsIntegrallyClosed O] (a : A) :
    toRing A O K (algebraMap A (integralClosure A K) a) = algebraMap A O a := by
  apply IsFractionRing.injective O K
  rw [algebraMap_toRing, ← IsScalarTower.algebraMap_apply]
  rfl

theorem centerIdeal_eq_comap [IsLocalRing O] [IsIntegrallyClosed O] :
    centerIdeal A O K = (maximalIdeal O).comap (toRing A O K) := by
  have : {b : integralClosure A K | ∃ m ∈ maximalIdeal O, algebraMap O K m = (b : K)} =
      ((maximalIdeal O).comap (toRing A O K) : Set (integralClosure A K)) := by
    ext b
    simp only [Set.mem_ofPred_eq, SetLike.mem_coe, Ideal.mem_comap]
    constructor
    · rintro ⟨m, hm, hmb⟩
      rwa [IsFractionRing.injective O K ((algebraMap_toRing b).trans hmb.symm)]
    · exact fun h ↦ ⟨_, h, algebraMap_toRing b⟩
  rw [centerIdeal, this, Ideal.span_eq]

theorem mem_centerIdeal_iff [IsLocalRing O] [IsIntegrallyClosed O] (b : integralClosure A K) :
    b ∈ centerIdeal A O K ↔ ∃ m ∈ maximalIdeal O, algebraMap O K m = (b : K) := by
  rw [centerIdeal_eq_comap, Ideal.mem_comap]
  constructor
  · exact fun h ↦ ⟨_, h, algebraMap_toRing b⟩
  · rintro ⟨m, hm, hmb⟩
    rwa [IsFractionRing.injective O K ((algebraMap_toRing b).trans hmb.symm)]

section Local

variable [IsLocalRing O] [IsIntegrallyClosed O] [IsLocalRing A] [IsLocalHom (algebraMap A O)]

theorem centerIdeal_under :
    (centerIdeal A O K).under A = maximalIdeal A := by
  rw [centerIdeal_eq_comap, Ideal.under, Ideal.comap_comap]
  have : (toRing A O K).comp (algebraMap A (integralClosure A K)) = algebraMap A O :=
    RingHom.ext toRing_algebraMap
  rw [this, IsLocalRing.maximalIdeal_comap]

instance centerIdeal_liesOver : (centerIdeal A O K).LiesOver (maximalIdeal A) :=
  ⟨centerIdeal_under.symm⟩

instance centerIdeal_isPrime : (centerIdeal A O K).IsPrime := by
  rw [centerIdeal_eq_comap]; exact Ideal.comap_isPrime _ _

variable (A O K) in
theorem centerIdeal_ne_bot (hA : maximalIdeal A ≠ ⊥)
    (hinj : Function.Injective (algebraMap A K)) : centerIdeal A O K ≠ ⊥ := by
  obtain ⟨t, ht, ht0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hA
  intro h
  have : algebraMap A (integralClosure A K) t ∈ centerIdeal A O K := by
    rw [← Ideal.mem_comap, ← Ideal.under_def, centerIdeal_under]; exact ht
  rw [h, Ideal.mem_bot] at this
  apply ht0
  apply hinj
  rw [map_zero, IsScalarTower.algebraMap_apply A (integralClosure A K) K, this, map_zero]

theorem centerIdeal_isMaximal [IsDedekindDomain (integralClosure A K)] (hA : maximalIdeal A ≠ ⊥)
    (hinj : Function.Injective (algebraMap A K)) : (centerIdeal A O K).IsMaximal :=
  Ideal.IsPrime.isMaximal inferInstance (centerIdeal_ne_bot A O K hA hinj)

end Local

section DVR

variable [IsDomain O] [IsDiscreteValuationRing O] [IsLocalRing A] [IsLocalHom (algebraMap A O)]
  [IsDedekindDomain (integralClosure A K)] [Algebra.IsAlgebraic A K]

/-- An element of a discrete valuation ring lies in the `m`-th power of the maximal ideal if and
only if its valuation is at least `m`. -/
theorem mem_maximalIdeal_pow_iff (x : O) (m : ℕ) :
    x ∈ maximalIdeal O ^ m ↔ (m : ℕ∞) ≤ IsDiscreteValuationRing.addVal O x := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
    ← IsDiscreteValuationRing.addVal_le_iff_dvd, IsDiscreteValuationRing.addVal_pow,
    IsDiscreteValuationRing.addVal_uniformizer hϖ, nsmul_one]

variable (A O K) in
/-- **`O` is the localization of `B` at `B ∩ 𝔪_O`.** Let `A` be a local ring with nonzero
maximal ideal, `A → O` a local homomorphism to a discrete valuation ring with fraction field
`K`, algebraic over `A` with `A → K` injective, and suppose the integral closure `B` of `A` in
`K` is a Dedekind domain. Then `O` is the localization of `B` at `centerIdeal A O K`, for the
algebra structure given by the inclusion `toRing A O K`. -/
theorem isLocalization_atPrime (hA : maximalIdeal A ≠ ⊥)
    (hinj : Function.Injective (algebraMap A K)) :
    letI := (toRing A O K).toAlgebra
    IsLocalization.AtPrime O (centerIdeal A O K) := by
  let := (toRing A O K).toAlgebra
  set P := centerIdeal A O K with hPdef
  have hP : P = (maximalIdeal O).comap (toRing A O K) := centerIdeal_eq_comap
  have hP0 : P ≠ ⊥ := centerIdeal_ne_bot A O K hA hinj
  have := centerIdeal_isMaximal (O := O) hA hinj
  have hunit : ∀ s : P.primeCompl, IsUnit (toRing A O K s) := fun s ↦ by
    have hs : (s : integralClosure A K) ∉ (maximalIdeal O).comap (toRing A O K) := by
      rw [← centerIdeal_eq_comap]; exact s.2
    exact IsLocalRing.notMem_maximalIdeal.mp hs
  refine ⟨hunit, fun z ↦ ?_, fun {x y} hxy ↦ ⟨1, by rw [toRing_injective hxy]⟩⟩
  -- surjectivity, through the discrete valuation ring `V = B_P`
  let V := Localization.AtPrime P
  have : IsDiscreteValuationRing V :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain _ hP0 V
  let lam : V →+* O := IsLocalization.lift (M := P.primeCompl) (S := V) hunit
  have hlam : ∀ b, lam (algebraMap _ V b) = toRing A O K b := IsLocalization.lift_eq hunit
  -- it suffices to write `z` as `lam c`
  suffices h : ∃ c : V, lam c = z by
    obtain ⟨c, rfl⟩ := h
    obtain ⟨⟨b', s'⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl c
    refine ⟨(b', s'), ?_⟩
    have := (IsLocalization.lift_mk'_spec (S := V) (hg := hunit) b' _ s').mp rfl
    change _ = toRing A O K b'
    rw [this, mul_comm]
    rfl
  by_cases hz : z = 0
  · exact ⟨0, by rw [hz, map_zero]⟩
  -- write `z = b / a` with `b ∈ B` and `0 ≠ a ∈ A`
  obtain ⟨a, ha0, hint⟩ :=
    IsAlgebraic.exists_integral_multiple
      (Algebra.IsAlgebraic.isAlgebraic (R := A) (algebraMap O K z))
  let b : integralClosure A K := ⟨a • algebraMap O K z, hint⟩
  let s : integralClosure A K := algebraMap A _ a
  have hs0 : toRing A O K s ≠ 0 := by
    rw [toRing_algebraMap]
    intro h
    apply ha0
    apply hinj
    rw [IsScalarTower.algebraMap_apply A O K, h, map_zero, map_zero]
  have hzs : z * toRing A O K s = toRing A O K b := by
    apply IsFractionRing.injective O K
    rw [map_mul, algebraMap_toRing, algebraMap_toRing]
    change _ = a • algebraMap O K z
    rw [Algebra.smul_def, mul_comm]
    rfl
  -- compare `b` and `s` in the valuation ring `V`
  obtain ⟨c, hc | hc⟩ := ValuationRing.cond (algebraMap _ V s) (algebraMap _ V b)
  · refine ⟨c, ?_⟩
    have := congrArg lam hc
    rw [map_mul, hlam, hlam, ← hzs, mul_comm z] at this
    exact mul_left_cancel₀ hs0 this
  · have hc' := congrArg lam hc
    rw [map_mul, hlam, hlam, ← hzs] at hc'
    -- `z * lam c = 1`, so `lam c` and hence `c` are units
    have hzc : z * lam c = 1 := by
      apply mul_left_cancel₀ hs0
      calc toRing A O K s * (z * lam c) = z * toRing A O K s * lam c := by ring
        _ = toRing A O K s * 1 := by rw [hc', mul_one]
    have hcu : IsUnit c := by
      obtain ⟨⟨b', s'⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl c
      rw [IsLocalization.AtPrime.isUnit_mk'_iff]
      intro hb'
      have hu : IsUnit (lam (IsLocalization.mk' V b' s')) := IsUnit.of_mul_eq_one_right _ hzc
      have := (IsLocalization.lift_mk'_spec (S := V) (hg := hunit) b' _ s').mp rfl
      have hb'u : IsUnit (toRing A O K b') := by
        rw [this]; exact (hunit s').mul hu
      rw [hP] at hb'
      exact (IsLocalRing.notMem_maximalIdeal.mpr hb'u) hb'
    refine ⟨↑hcu.unit⁻¹, ?_⟩
    have : algebraMap _ V b = algebraMap _ V s * ↑hcu.unit⁻¹ := by
      rw [← hc, mul_assoc, IsUnit.mul_val_inv, mul_one]
    have h2 := congrArg lam this
    rw [map_mul, hlam, hlam, ← hzs, mul_comm z] at h2
    exact (mul_left_cancel₀ hs0 h2).symm

variable (hA : maximalIdeal A ≠ ⊥) (hinj : Function.Injective (algebraMap A K))
include hA hinj

/-- An element `b` of `B` lies in `(B ∩ 𝔪_O) ^ m` if and only if it lies in `𝔪_O ^ m`. -/
theorem mem_centerIdeal_pow_iff (b : integralClosure A K) (m : ℕ) :
    b ∈ centerIdeal A O K ^ m ↔ toRing A O K b ∈ maximalIdeal O ^ m := by
  let := (toRing A O K).toAlgebra
  have := isLocalization_atPrime A O K hA hinj
  have := centerIdeal_isMaximal (O := O) hA hinj
  rw [← IsLocalization.AtPrime.under_maximalIdeal_pow (centerIdeal A O K) O m]
  rfl

/-- `(B ∩ 𝔪_O) ^ m` divides an ideal `I` of `B` if and only if every element of `I` has valuation
at least `m` in `O`. -/
theorem pow_dvd_iff (I : Ideal (integralClosure A K)) (m : ℕ) :
    centerIdeal A O K ^ m ∣ I ↔
      ∀ d ∈ I, (m : ℕ∞) ≤ IsDiscreteValuationRing.addVal O (toRing A O K d) := by
  rw [Ideal.dvd_iff_le]
  constructor
  · intro h d hd
    rw [← mem_maximalIdeal_pow_iff, ← mem_centerIdeal_pow_iff hA hinj]
    exact h hd
  · intro h d hd
    rw [mem_centerIdeal_pow_iff hA hinj, mem_maximalIdeal_pow_iff]
    exact h d hd

/-- The exponent of `B ∩ 𝔪_O` in a nonzero ideal `I` of `B` is the least valuation in `O` of a
nonzero element of `I`. -/
theorem isLeast_count_normalizedFactors (I : Ideal (integralClosure A K)) (hI : I ≠ ⊥) :
    IsLeast {v : ℕ∞ | ∃ d ∈ I, d ≠ 0 ∧ IsDiscreteValuationRing.addVal O (toRing A O K d) = v}
      ((normalizedFactors I).count (centerIdeal A O K) : ℕ∞) := by
  have hP0 := centerIdeal_ne_bot A O K hA hinj
  have := centerIdeal_isMaximal (O := O) hA hinj
  have hirr : Irreducible (centerIdeal A O K) :=
    (Ideal.prime_of_isPrime hP0 inferInstance).irreducible
  set n := (normalizedFactors I).count (centerIdeal A O K)
  have hmul := emultiplicity_eq_count_normalizedFactors hirr hI
  rw [normalize_eq] at hmul
  have h1 : centerIdeal A O K ^ n ∣ I := (pow_dvd_iff_le_emultiplicity).mpr (by rw [hmul])
  have h2 : ¬ centerIdeal A O K ^ (n + 1) ∣ I := by
    rw [pow_dvd_iff_le_emultiplicity, hmul, Nat.cast_le]; omega
  rw [pow_dvd_iff hA hinj] at h1 h2
  push Not at h2
  obtain ⟨d, hd, hdlt⟩ := h2
  have hge := h1 d hd
  refine ⟨⟨d, hd, ?_, ?_⟩, ?_⟩
  · rintro rfl
    rw [map_zero, IsDiscreteValuationRing.addVal_zero] at hdlt
    exact absurd hdlt (not_lt.mpr le_top)
  · refine le_antisymm ?_ hge
    rw [Nat.cast_add, Nat.cast_one] at hdlt
    exact Order.le_of_lt_add_one hdlt
  · rintro v ⟨d', hd', -, rfl⟩
    exact h1 d' hd'

/-- The exponent of `B ∩ 𝔪_O` in the principal ideal of a nonzero `b` is the valuation of `b`
in `O`. -/
theorem count_normalizedFactors_span_singleton (b : integralClosure A K) (hb : b ≠ 0) :
    ((normalizedFactors (Ideal.span {b})).count (centerIdeal A O K) : ℕ∞) =
      IsDiscreteValuationRing.addVal O (toRing A O K b) := by
  have hI : Ideal.span {b} ≠ ⊥ := by simpa using hb
  refine (isLeast_count_normalizedFactors hA hinj _ hI).unique ⟨⟨b, Ideal.mem_span_singleton_self b,
    hb, rfl⟩, ?_⟩
  rintro v ⟨d, hd, -, rfl⟩
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hd
  rw [map_mul, IsDiscreteValuationRing.addVal_mul]
  exact le_add_self

/-- **The ramification index of `B ∩ 𝔪_O`** over the maximal ideal `(t)` of `A` is the
valuation of `t` in `O`. -/
theorem ramificationIdx_centerIdeal (t : A) (ht : maximalIdeal A = Ideal.span {t}) :
    ((centerIdeal A O K).ramificationIdx A : ℕ∞) =
      IsDiscreteValuationRing.addVal O (algebraMap A O t) := by
  have ht0 : t ≠ 0 := by rintro rfl; exact hA (by rw [ht, Ideal.span_singleton_eq_bot])
  have hb0 : algebraMap A (integralClosure A K) t ≠ 0 := by
    intro h
    apply ht0
    apply hinj
    rw [IsScalarTower.algebraMap_apply A (integralClosure A K) K, h, map_zero, map_zero]
  have hmap : (maximalIdeal A).map (algebraMap A (integralClosure A K)) =
      Ideal.span {algebraMap A (integralClosure A K) t} := by
    rw [ht, Ideal.map_span, Set.image_singleton]
  have hne : (maximalIdeal A).map (algebraMap A (integralClosure A K)) ≠ ⊥ := by
    rw [hmap]; simpa using hb0
  rw [Ideal.IsDedekindDomain.ramificationIdx_eq_normalizedFactors_count (maximalIdeal A) _ hne,
    hmap, count_normalizedFactors_span_singleton hA hinj _ hb0, toRing_algebraMap]

end DVR

end Langlands.CommutativeAlgebra.IntegralClosureDvrCenter
