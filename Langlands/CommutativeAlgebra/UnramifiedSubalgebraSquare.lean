import Mathlib.RingTheory.Unramified.LocalRing
import Mathlib.RingTheory.Artinian.Ring
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-! # Unramified algebras over a local ring and finite-type models -/

universe u v w

open IsLocalRing

namespace Langlands.CommutativeAlgebra.UnramifiedSubalgebraSquare

section Idempotent

variable {P : Type u} {E : Type v} [CommRing P] [IsLocalRing P] [CommRing E] [Algebra P E]
  [Algebra.FormallyUnramified P E] [Algebra.FiniteType P E]

set_option backward.inferInstanceAs.wrap.data false in
/-- Modulo the maximal ideal of the base, a finite-type unramified algebra is reduced
Artinian, so every element divides its square there. -/
theorem exists_sub_sq_mul_mem (x : E) :
    ∃ y : E, x - x ^ 2 * y ∈ (maximalIdeal P).map (algebraMap P E) := by
  let mR := (maximalIdeal P).map (algebraMap P E)
  let : Algebra (ResidueField P) (E ⧸ mR) := (inferInstanceAs <| Algebra (P ⧸ _) _)
  have : IsScalarTower P (ResidueField P) (E ⧸ mR) :=
    (inferInstanceAs <| IsScalarTower P (P ⧸ _) _)
  have : Algebra.FormallyUnramified (ResidueField P) (E ⧸ mR) := .of_restrictScalars P _ _
  have : Algebra.EssFiniteType (ResidueField P) (E ⧸ mR) := .of_comp P _ _
  have : Module.Finite (ResidueField P) (E ⧸ mR) :=
    Algebra.FormallyUnramified.finite_of_free _ _
  have : IsReduced (E ⧸ mR) :=
    Algebra.FormallyUnramified.isReduced_of_field (ResidueField P) (E ⧸ mR)
  have : IsArtinianRing (E ⧸ mR) := isArtinian_of_tower (ResidueField P) inferInstance
  obtain ⟨n, y, hy⟩ := IsArtinian.exists_pow_succ_smul_dvd (Ideal.Quotient.mk mR x)
    (1 : E ⧸ mR)
  obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
  refine ⟨y', ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  set X := Ideal.Quotient.mk mR x
  set Y := Ideal.Quotient.mk mR y'
  simp only [smul_eq_mul, mul_one] at hy
  have hnil : IsNilpotent (X * (1 - X * Y)) := by
    refine ⟨n + 1, ?_⟩
    have : (X * (1 - X * Y)) ^ (n + 1) = (X ^ n - X ^ (n + 1) * Y) * (X * (1 - X * Y) ^ n) := by
      rw [mul_pow, pow_succ (1 - X * Y)]
      generalize (1 - X * Y) ^ n = W
      ring
    rw [this, hy, sub_self, zero_mul]
  have := hnil.eq_zero
  rw [map_sub, map_mul, map_pow]
  linear_combination this

end Idempotent

section Model

variable {S : Type u} [CommRing S] (𝔪 : Ideal S) [𝔪.IsMaximal]
  {E : Type v} [CommRing E] [Algebra (Localization.AtPrime 𝔪) E]
  [Algebra.FormallyUnramified (Localization.AtPrime 𝔪) E]
  [Algebra.FiniteType (Localization.AtPrime 𝔪) E]
  {T₀ : Type w} [CommRing T₀] (σT : S →+* T₀) (j : T₀ →+* E)
  (hj : Function.Injective j)
  (hjσ : ∀ s, j (σT s) = algebraMap _ E (algebraMap S (Localization.AtPrime 𝔪) s))
  (hden : ∀ e : E, ∃ w ∉ 𝔪, ∃ t : T₀, j t = j (σT w) * e)
  (u₀ : Ideal T₀) (hres : ∀ t, ∃ s, t - σT s ∈ u₀) (h𝔪 : 𝔪.map σT ≤ u₀)
include hj hjσ hden hres h𝔪

/-- A model `T₀` of an unramified algebra over the localization, in which every element
has a denominator from outside `𝔪`, is unramified at any ideal `u₀` with residue ring
generated by `S`: every element is congruent modulo `u₀ ^ 2` to an element of `S`. -/
theorem exists_sub_mem_sq (t : T₀) : ∃ s, t - σT s ∈ u₀ ^ 2 := by
  -- first, `u₀ ≤ 𝔪 T₀ + u₀ ^ 2`
  have key : ∀ t ∈ u₀, t ∈ 𝔪.map σT ⊔ u₀ ^ 2 := by
    intro t ht
    obtain ⟨y, hy⟩ := exists_sub_sq_mul_mem (P := Localization.AtPrime 𝔪) (j t)
    obtain ⟨wy, hwy, ty, hty⟩ := hden y
    -- clear denominators in the maximal ideal of the localization
    have hclear : ∀ z ∈ (maximalIdeal (Localization.AtPrime 𝔪)).map
        (algebraMap (Localization.AtPrime 𝔪) E),
        ∃ w ∉ 𝔪, ∃ tz ∈ 𝔪.map σT, j tz = j (σT w) * z := by
      intro z hz
      rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map] at hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨m, hm, rfl⟩
        refine ⟨1, fun h => (Ideal.IsMaximal.ne_top ‹_›) ((Ideal.eq_top_iff_one _).mpr h),
          σT m, Ideal.mem_map_of_mem _ hm, ?_⟩
        rw [map_one, map_one, one_mul, hjσ]
        rfl
      · exact ⟨1, fun h => (Ideal.IsMaximal.ne_top ‹_›) ((Ideal.eq_top_iff_one _).mpr h),
          0, Ideal.zero_mem _, by simp⟩
      · rintro z₁ z₂ - - ⟨w₁, hw₁, t₁, ht₁, e₁⟩ ⟨w₂, hw₂, t₂, ht₂, e₂⟩
        refine ⟨w₁ * w₂, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hw₁ hw₂,
          σT w₂ * t₁ + σT w₁ * t₂,
          Ideal.add_mem _ (Ideal.mul_mem_left _ _ ht₁) (Ideal.mul_mem_left _ _ ht₂), ?_⟩
        simp only [map_add, map_mul, e₁, e₂]
        ring
      · rintro a z - ⟨w₁, hw₁, t₁, ht₁, e₁⟩
        obtain ⟨wa, hwa, ta, hta⟩ := hden a
        refine ⟨wa * w₁, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hwa hw₁,
          ta * t₁, Ideal.mul_mem_left _ _ ht₁, ?_⟩
        simp only [smul_eq_mul, map_mul, hta, e₁]
        ring
    obtain ⟨w, hw, tz, htz, hz⟩ := hclear _ hy
    -- `σT (w * wy) * t ∈ 𝔪 T₀ + u₀ ^ 2`
    have heq : σT (w * wy) * t = σT w * t ^ 2 * ty + σT wy * tz := by
      apply hj
      simp only [map_mul, map_add, map_pow, hty, hz]
      ring
    have hmem : σT (w * wy) * t ∈ 𝔪.map σT ⊔ u₀ ^ 2 := by
      rw [heq]
      refine Ideal.add_mem _ (Ideal.mem_sup_right ?_) (Ideal.mem_sup_left
        (Ideal.mul_mem_left _ _ htz))
      refine Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ ?_)
      exact Ideal.pow_mem_pow ht 2
    have hv : w * wy ∉ 𝔪 := fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hw hwy
    obtain ⟨v', i, hi, hv'⟩ := Ideal.IsMaximal.exists_inv ‹_› hv
    have : t = σT v' * (σT (w * wy) * t) + σT i * t := by
      rw [← mul_assoc, ← map_mul, ← add_mul, ← map_add, hv', map_one, one_mul]
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hmem)
      (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hi)))
  -- elements of `𝔪 T₀` are congruent to images modulo `u₀ ^ 2`
  have hmap : ∀ z ∈ 𝔪.map σT, ∃ s, z - σT s ∈ u₀ ^ 2 := by
    intro z hz
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨m, -, rfl⟩
      exact ⟨m, by simp⟩
    · exact ⟨0, by simp⟩
    · rintro z₁ z₂ - - ⟨s₁, h₁⟩ ⟨s₂, h₂⟩
      refine ⟨s₁ + s₂, ?_⟩
      have : z₁ + z₂ - σT (s₁ + s₂) = (z₁ - σT s₁) + (z₂ - σT s₂) := by rw [map_add]; ring
      rw [this]; exact Ideal.add_mem _ h₁ h₂
    · rintro a z hz ⟨s₂, h₂⟩
      obtain ⟨s₁, h₁⟩ := hres a
      refine ⟨s₁ * s₂, ?_⟩
      have hzu : z ∈ u₀ := h𝔪 hz
      have : a • z - σT (s₁ * s₂) = σT s₁ * (z - σT s₂) + (a - σT s₁) * z := by
        rw [smul_eq_mul, map_mul]; ring
      rw [this]
      refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ h₂) ?_
      rw [pow_two]
      exact Ideal.mul_mem_mul h₁ hzu
  obtain ⟨s, hs⟩ := hres t
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (key _ hs)
  obtain ⟨s', hs'⟩ := hmap a ha
  refine ⟨s + s', ?_⟩
  have : t - σT (s + s') = (a - σT s') + b := by
    rw [map_add]; linear_combination -hab
  rw [this]
  exact Ideal.add_mem _ hs' hb

end Model

end Langlands.CommutativeAlgebra.UnramifiedSubalgebraSquare
