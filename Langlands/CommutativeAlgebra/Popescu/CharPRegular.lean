import Langlands.CommutativeAlgebra.Popescu.RegularLocalParametersStatement
import Langlands.CommutativeAlgebra.Popescu.RegularSequencePowersStatement
import Langlands.CommutativeAlgebra.Popescu.CharPTools
import Langlands.MathlibBase

/-! # Regularity of powers of regular parameters (for Stacks Lemma 16.11.4, 07FJ) -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu.CharP

open RingTheory.Sequence IsLocalRing

/-- A list permutation putting the elements of `T`, then `i`, first. -/
theorem perm_finRange_filter {d : ℕ} (T : Finset (Fin d)) (i : Fin d) (hi : i ∉ T) :
    ∃ rest : List (Fin d), List.Perm (List.finRange d)
      (((List.finRange d).filter (fun j => decide (j ∈ T)) ++ [i]) ++ rest) := by
  have h1 := (List.filter_append_perm (fun j => decide (j ∈ T)) (List.finRange d)).symm
  have hmem : i ∈ (List.finRange d).filter (fun j => !decide (j ∈ T)) := by
    rw [List.mem_filter]
    exact ⟨List.mem_finRange i, by simpa using hi⟩
  have h2 := List.perm_cons_erase hmem
  refine ⟨((List.finRange d).filter (fun j => !decide (j ∈ T))).erase i, ?_⟩
  refine h1.trans ?_
  rw [List.append_assoc, List.singleton_append]
  exact h2.append_left _

/-- In a regular local ring with minimal generators `x₁, …, x_d` of the maximal ideal, for
`i ∉ T` and `e > 0`, the sequence `(xⱼᵉ)_{j ∈ T}, xᵢ` is regular. -/
theorem isWeaklyRegular_pow_append (h00NQ : RegularLocalParametersStatement.{u})
    (h07DV : RegularSequencePowersStatement.{u}) {L : Type u} [CommRing L] [IsRegularLocalRing L]
    {d : ℕ} (x : Fin d → L) (hd : (maximalIdeal L).spanFinrank = d)
    (hx : Ideal.span (Set.range x) = maximalIdeal L) (T : Finset (Fin d)) (i : Fin d)
    (hi : i ∉ T) (e : ℕ) (he : 0 < e) :
    IsWeaklyRegular L
      (((List.finRange d).filter (fun j => decide (j ∈ T))).map (fun j => x j ^ e) ++ [x i]) := by
  subst hd
  classical
  have hreg := h00NQ L x hx
  let ε : Fin (maximalIdeal L).spanFinrank → ℕ := fun j => if j ∈ T then e else 1
  have hε : ∀ j, 0 < ε j := fun j => by
    simp only [ε]; split_ifs <;> omega
  have hreg' := (h07DV L L _ x ε hε).mp hreg
  rw [List.ofFn_eq_map] at hreg'
  obtain ⟨rest, hperm⟩ := perm_finRange_filter T i hi
  have hperm' := hperm.map (fun j => x j ^ ε j)
  have hmax : ∀ r ∈ (List.finRange _).map (fun j => x j ^ ε j), r ∈ maximalIdeal L := by
    intro r hr
    obtain ⟨j, -, rfl⟩ := List.mem_map.mp hr
    have hj : x j ∈ maximalIdeal L := by rw [← hx]; exact Ideal.subset_span ⟨j, rfl⟩
    exact Ideal.pow_mem_of_mem _ hj _ (hε j)
  have h3 := IsLocalRing.isWeaklyRegular_of_perm_of_subset_maximalIdeal hreg'.toIsWeaklyRegular
    hperm' hmax
  rw [List.map_append, isWeaklyRegular_append_iff] at h3
  have h4 := h3.1
  rw [List.map_append] at h4
  convert h4 using 2
  · refine List.map_congr_left fun j hj => ?_
    have : j ∈ T := by simpa using (List.mem_filter.mp hj).2
    simp only [ε, this, ↓reduceIte]
  · simp only [List.map_cons, List.map_nil, ε, hi, ↓reduceIte, pow_one]

/-- The ideal generated by a list obtained by filtering `finRange`. -/
theorem ofList_map_filter {L : Type*} [CommRing L] {d : ℕ} (g : Fin d → L) (T : Finset (Fin d)) :
    Ideal.ofList (((List.finRange d).filter (fun j => decide (j ∈ T))).map g) =
      Ideal.span (g '' (T : Set (Fin d))) := by
  unfold Ideal.ofList
  congr 1
  ext r
  simp only [List.mem_map, List.mem_filter, List.mem_finRange, true_and, decide_eq_true_eq,
    Set.mem_ofPred_eq, Set.mem_image, Finset.mem_coe]

/-- If `rs ++ [r]` is weakly regular, then `r` is a nonzerodivisor modulo the ideal of `rs`. -/
theorem mem_of_mul_mem_of_isWeaklyRegular {L : Type*} [CommRing L] (rs : List L) (r : L)
    (h : IsWeaklyRegular L (rs ++ [r])) (y : L) (hy : r * y ∈ Ideal.ofList rs) :
    y ∈ Ideal.ofList rs := by
  rw [isWeaklyRegular_append_iff, isWeaklyRegular_singleton_iff] at h
  have h2 := h.2
  have hy' : r • (Submodule.Quotient.mk y : L ⧸ (Ideal.ofList rs • ⊤ : Submodule L L)) =
      r • (0 : L ⧸ (Ideal.ofList rs • ⊤ : Submodule L L)) := by
    rw [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    simp only [smul_eq_mul, Ideal.mul_top]
    exact hy
  have := h2 hy'
  rw [Submodule.Quotient.mk_eq_zero] at this
  simpa only [smul_eq_mul, Ideal.mul_top] using this

/-- Regular parameters stay regular after a flat base change: for `i ∉ T` and `e > 0`, the image
of `xᵢ` is a nonzerodivisor modulo the ideal generated by the images of `xⱼᵉ`, `j ∈ T`. -/
theorem mem_of_mul_mem_span_pow (h00NQ : RegularLocalParametersStatement.{u})
    (h07DV : RegularSequencePowersStatement.{u}) {L : Type u} [CommRing L] [IsRegularLocalRing L]
    {d : ℕ} (x : Fin d → L) (hd : (maximalIdeal L).spanFinrank = d)
    (hx : Ideal.span (Set.range x) = maximalIdeal L) (e : ℕ) (he : 0 < e)
    {L' : Type*} [CommRing L'] [Algebra L L'] [Module.Flat L L'] (T : Finset (Fin d)) (i : Fin d)
    (hi : i ∉ T) (y : L')
    (hy : algebraMap L L' (x i) * y ∈
      Ideal.span ((fun j => algebraMap L L' (x j) ^ e) '' (T : Set (Fin d)))) :
    y ∈ Ideal.span ((fun j => algebraMap L L' (x j) ^ e) '' (T : Set (Fin d))) := by
  have h1 := (isWeaklyRegular_pow_append h00NQ h07DV x hd hx T i hi e he).of_flat (S := L')
  rw [List.map_append, List.map_map, List.map_cons, List.map_nil] at h1
  have h2 := mem_of_mul_mem_of_isWeaklyRegular _ _ h1 y
  have e1 : (⇑(algebraMap L L') ∘ fun j => x j ^ e) = fun j => algebraMap L L' (x j) ^ e := by
    funext j; simp
  rw [e1, ofList_map_filter] at h2
  exact h2 hy

/-- The local hypothesis of Ogoma's lemma (Stacks 07FC) for `π = v pᵢ` on
`Λ ⧸ ((uⱼ pⱼ)ᵉ : j ∈ T)` with `S = Λ \ q`, from regularity of `pᵢ` modulo `(pⱼᵉ : j ∈ T)` in
`Λ_q` and `uⱼ, v ∉ q`. -/
theorem ogoma_hyp {Λ : Type*} [CommRing Λ] (q : Ideal Λ) [q.IsPrime] {d : ℕ} (p : Fin d → Λ)
    (e : ℕ) (T : Finset (Fin d)) (i : Fin d)
    (hreg : ∀ y : Localization.AtPrime q,
      algebraMap Λ (Localization.AtPrime q) (p i) * y ∈
        Ideal.span ((fun j => algebraMap Λ (Localization.AtPrime q) (p j) ^ e) ''
          (T : Set (Fin d))) →
      y ∈ Ideal.span ((fun j => algebraMap Λ (Localization.AtPrime q) (p j) ^ e) ''
          (T : Set (Fin d))))
    (u : Fin d → Λ) (hu : ∀ j, u j ∉ q) (v : Λ) (hv : v ∉ q)
    (m : Λ ⧸ Ideal.span ((fun j => (u j * p j) ^ e) '' (T : Set (Fin d))))
    (hm : ∃ s ∈ q.primeCompl, (s * (v * p i) ^ 2) • m = 0) :
    ∃ s ∈ q.primeCompl, (s * (v * p i)) • m = 0 := by
  obtain ⟨s, hs, hsm⟩ := hm
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective m
  set J := Ideal.span ((fun j => (u j * p j) ^ e) '' (T : Set (Fin d))) with hJ
  set L := Localization.AtPrime q
  rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
    Ideal.Quotient.eq_zero_iff_mem] at hsm
  have hunit : ∀ j, IsUnit (algebraMap Λ L (u j) ^ e) := fun j =>
    (IsLocalization.map_units L (⟨u j, hu j⟩ : q.primeCompl)).pow e
  have hJL : J.map (algebraMap Λ L) =
      Ideal.span ((fun j => algebraMap Λ L (p j) ^ e) '' (T : Set (Fin d))) := by
    rw [hJ, Ideal.map_span, ← Set.image_comp]
    have : (⇑(algebraMap Λ L) ∘ fun j => (u j * p j) ^ e) =
        fun j => algebraMap Λ L (u j) ^ e * algebraMap Λ L (p j) ^ e := by
      funext j; simp [mul_pow]
    rw [this]
    exact span_image_unit_mul _ _ hunit _
  have h1 : algebraMap Λ L (s * (v * p i) ^ 2 * y) ∈ J.map (algebraMap Λ L) :=
    Ideal.mem_map_of_mem _ hsm
  rw [hJL] at h1
  have h2 := hreg (algebraMap Λ L (s * v ^ 2 * p i * y)) (by
    convert h1 using 1
    simp only [map_mul, map_pow]
    ring)
  rw [← hJL] at h2
  obtain ⟨⟨a, t⟩, ht⟩ := (IsLocalization.mem_map_algebraMap_iff q.primeCompl L).mp h2
  rw [← map_mul, IsLocalization.eq_iff_exists q.primeCompl L] at ht
  obtain ⟨c, hc⟩ := ht
  refine ⟨c * s * v * t, ?_, ?_⟩
  · exact q.primeCompl.mul_mem (q.primeCompl.mul_mem (q.primeCompl.mul_mem c.2 hs) hv) t.2
  · rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
      Ideal.Quotient.eq_zero_iff_mem]
    have : c * s * v * t * (v * p i) * y = c * (s * v ^ 2 * p i * y * t) := by ring
    rw [this, hc]
    exact J.mul_mem_left _ a.2

end Langlands.CommutativeAlgebra.Popescu.CharP
