import Langlands.MathlibBase
import Langlands.CommutativeAlgebra.Popescu.ArtinianFlatClaim

/-! # The subalgebra `σ(F)[t₁, …, t_d]` in the proof of Stacks 07FG

Let `(L, 𝔪, κ)` be a local ring with nilpotent maximal ideal `𝔪 = (t₁, …, t_d)`, `σ : κ → L` a
section of the residue map and `F ⊂ κ` a subfield. This file proves the properties of a subalgebra
`A ⊂ L` whose elements are the polynomials in the `t_i` with coefficients in `σ(F)`, used in the
proof of Stacks, Smoothing Ring Maps, Lemma 16.11.1 (07FG): `A` is local with `𝔪_A L = 𝔪`, it is
Artinian if it is Noetherian, `L` is free over `A` if the kernel of `κ[x] → L` is generated by
polynomials over `F`, and `A` is essentially of finite type over `k` if `F` is finitely
generated over `k`. -/

namespace Langlands.CommutativeAlgebra.Popescu.ArtinianFlat

open IsLocalRing MvPolynomial Module

section Local

variable {k L : Type*} [Field k] [CommRing L] [Algebra k L] [IsLocalRing L]

/-- Elements of `A` with nonzero residue are units of `A`, if `A` contains `σ(F)` and its
residues lie in `F`. -/
theorem isUnit_of_residue_ne_zero (A : Subalgebra k L) (σ : ResidueField L →+* L)
    (hσ : ∀ x, residue L (σ x) = x) (F : IntermediateField k (ResidueField L))
    (hres : ∀ x ∈ A, residue L x ∈ F) (hσA : ∀ c ∈ F, σ c ∈ A)
    (hnil : ∀ x ∈ maximalIdeal L, IsNilpotent x) (a : A) (ha : residue L a ≠ 0) :
    IsUnit a := by
  set c := residue L a with hc_def
  have hc : c ∈ F := hres a a.2
  let s : A := ⟨σ c⁻¹, hσA _ (inv_mem hc)⟩
  have hm : ((1 - s * a : A) : L) ∈ maximalIdeal L := by
    rw [← residue_eq_zero_iff]
    change residue L (1 - σ c⁻¹ * a) = 0
    rw [map_sub, map_mul, map_one, hσ, ← hc_def, inv_mul_cancel₀ ha, sub_self]
  obtain ⟨n, hn⟩ := hnil _ hm
  have hnA : IsNilpotent (1 - s * a) :=
    ⟨n, Subtype.ext (by rw [SubmonoidClass.coe_pow, ZeroMemClass.coe_zero]; exact hn)⟩
  have hu : IsUnit (s * a) := by simpa using hnA.isUnit_one_sub
  exact isUnit_of_mul_isUnit_right hu

theorem isLocalRing_of_residue (A : Subalgebra k L)
    (hunit : ∀ a : A, residue L a ≠ 0 → IsUnit a) : IsLocalRing A := by
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun a ↦ ?_
  by_cases ha : residue L a = 0
  · right
    apply hunit
    change residue L (1 - a) ≠ 0
    rw [map_sub, map_one, ha, sub_zero]
    exact one_ne_zero
  · exact Or.inl (hunit a ha)

theorem mem_maximalIdeal_iff_of_residue (A : Subalgebra k L) [IsLocalRing A]
    (hunit : ∀ a : A, residue L a ≠ 0 → IsUnit a) (a : A) :
    a ∈ maximalIdeal A ↔ (a : L) ∈ maximalIdeal L := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← residue_eq_zero_iff]
  constructor
  · intro h
    by_contra h'
    exact h (hunit a h')
  · intro h hu
    have := hu.map A.val
    rw [← residue_ne_zero_iff_isUnit] at this
    exact this h

theorem map_maximalIdeal_eq (A : Subalgebra k L) [IsLocalRing A]
    (hmem : ∀ a : A, a ∈ maximalIdeal A ↔ (a : L) ∈ maximalIdeal L) {d : ℕ} (t : Fin d → L)
    (ht : Ideal.span (Set.range t) = maximalIdeal L) (htA : ∀ i, t i ∈ A) :
    (maximalIdeal A).map (algebraMap A L) = maximalIdeal L := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    exact (hmem a).mp ha
  · rw [← ht, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    have hti : t i ∈ maximalIdeal L := by
      rw [← ht]
      exact Ideal.subset_span ⟨i, rfl⟩
    exact Ideal.mem_map_of_mem (algebraMap A L) (x := ⟨t i, htA i⟩) ((hmem _).mpr hti)

theorem isArtinianRing_of_residue (A : Subalgebra k L) [IsLocalRing A] [IsNoetherianRing A]
    (hmem : ∀ a : A, a ∈ maximalIdeal A ↔ (a : L) ∈ maximalIdeal L) {n : ℕ}
    (hn : maximalIdeal L ^ n = ⊥) : IsArtinianRing A := by
  rw [isArtinianRing_iff_isNilpotent_maximalIdeal]
  refine ⟨n, ?_⟩
  rw [Ideal.zero_eq_bot, eq_bot_iff]
  intro x hx
  have h1 : (maximalIdeal A).map (algebraMap A L) ≤ maximalIdeal L := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    exact (hmem a).mp ha
  have h2 : (x : L) ∈ maximalIdeal L ^ n := by
    have := Ideal.mem_map_of_mem (algebraMap A L) hx
    rw [Ideal.map_pow] at this
    exact Ideal.pow_right_mono h1 n this
  rw [hn, Ideal.mem_bot] at h2
  exact (Ideal.mem_bot).mpr (Subtype.ext h2)

end Local

section CoeffMap

variable {ι κ K : Type*} [Field κ] [Field K] [Algebra K κ]

/-- Apply a `K`-linear map `κ → K` to the coefficients of a polynomial. -/
noncomputable def coeffMap (φ : κ →ₗ[K] K) (P : MvPolynomial ι κ) : MvPolynomial ι K :=
  AddMonoidAlgebra.ofCoeff (Finsupp.mapRange φ φ.map_zero P.coeff)

theorem coeff_coeffMap (φ : κ →ₗ[K] K) (P : MvPolynomial ι κ) (m : ι →₀ ℕ) :
    (coeffMap φ P).coeff m = φ (P.coeff m) := rfl

theorem coeffMap_zero (φ : κ →ₗ[K] K) : coeffMap φ (0 : MvPolynomial ι κ) = 0 := by
  ext m
  rw [coeff_coeffMap]
  simp

theorem coeffMap_add (φ : κ →ₗ[K] K) (P Q : MvPolynomial ι κ) :
    coeffMap φ (P + Q) = coeffMap φ P + coeffMap φ Q := by
  ext m
  rw [coeff_coeffMap]
  simp [coeff_coeffMap]

theorem coeffMap_X_mul [DecidableEq ι] (φ : κ →ₗ[K] K) (i : ι) (P : MvPolynomial ι κ) :
    coeffMap φ (X i * P) = X i * coeffMap φ P := by
  ext m
  rw [coeff_coeffMap, coeff_X_mul', coeff_X_mul']
  split_ifs
  · rfl
  · exact φ.map_zero

theorem coeffMap_C_mul (φ : κ →ₗ[K] K) (c : κ) (P : MvPolynomial ι κ) :
    coeffMap φ (C c * P) = coeffMap (φ ∘ₗ LinearMap.mulLeft K c) P := by
  ext m
  rw [coeff_coeffMap, coeff_coeffMap, coeff_C_mul, LinearMap.comp_apply,
    LinearMap.mulLeft_apply]

theorem coeffMap_map (φ : κ →ₗ[K] K) (Q : MvPolynomial ι K) :
    coeffMap φ (map (algebraMap K κ) Q) = C (φ 1) * Q := by
  ext m
  rw [coeff_coeffMap, coeff_map, coeff_C_mul, Algebra.algebraMap_eq_smul_one, map_smul,
    smul_eq_mul, mul_comm]

theorem coeffMap_mul_mem (J : Ideal (MvPolynomial ι K)) (a : MvPolynomial ι κ) :
    ∀ P, (∀ φ : κ →ₗ[K] K, coeffMap φ P ∈ J) → ∀ φ : κ →ₗ[K] K, coeffMap φ (a * P) ∈ J := by
  classical
  induction a using MvPolynomial.induction_on with
  | C c =>
    intro P hP φ
    rw [coeffMap_C_mul]
    exact hP _
  | add a₁ a₂ h₁ h₂ =>
    intro P hP φ
    rw [add_mul, coeffMap_add]
    exact J.add_mem (h₁ P hP φ) (h₂ P hP φ)
  | mul_X a i h =>
    intro P hP φ
    rw [mul_assoc]
    refine h (X i * P) (fun ψ ↦ ?_) φ
    rw [coeffMap_X_mul]
    exact J.mul_mem_left _ (hP ψ)

/-- If `P` lies in the ideal of `κ[x]` generated by an ideal `J` of `K[x]`, then applying any
`K`-linear map `κ → K` to the coefficients of `P` gives an element of `J`. -/
theorem coeffMap_mem_of_mem_map (J : Ideal (MvPolynomial ι K)) {P : MvPolynomial ι κ}
    (hP : P ∈ J.map (map (algebraMap K κ))) (φ : κ →ₗ[K] K) : coeffMap φ P ∈ J := by
  revert φ
  change P ∈ Ideal.span _ at hP
  induction hP using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨Q, hQ, rfl⟩ := hx
    intro φ
    rw [coeffMap_map]
    exact J.mul_mem_left _ hQ
  | zero =>
    intro φ
    rw [coeffMap_zero]
    exact J.zero_mem
  | add x y _ _ hx hy =>
    intro φ
    rw [coeffMap_add]
    exact J.add_mem (hx φ) (hy φ)
  | smul a x _ hx =>
    rw [smul_eq_mul]
    exact coeffMap_mul_mem J a x hx

end CoeffMap

section Free

/-- If every element of `L` is a polynomial in the `t_i` with coefficients in `σ(κ)`, `A` consists
of the polynomials with coefficients in `σ(K)`, and the relations between the `t_i` over `κ` are
generated by relations over `K`, then `L` is free over `A` (with basis `σ` of a `K`-basis of
`κ`). -/
theorem free_of_ker_le {k κ K L : Type*} [Field k] [Field κ] [Field K] [Algebra K κ]
    [CommRing L] [Algebra k L] (σ : κ →+* L) {d : ℕ} (t : Fin d → L) (A : Subalgebra k L)
    (hA : ∀ x, x ∈ A ↔ ∃ h : MvPolynomial (Fin d) K, eval₂ (σ.comp (algebraMap K κ)) t h = x)
    (hsurj : Function.Surjective (eval₂Hom σ t : MvPolynomial (Fin d) κ →+* L))
    (hker : RingHom.ker (eval₂Hom σ t : MvPolynomial (Fin d) κ →+* L) ≤
      (RingHom.ker (eval₂Hom (σ.comp (algebraMap K κ)) t)).map (map (algebraMap K κ))) :
    Module.Free A L := by
  classical
  let b := Basis.ofVectorSpace K κ
  have hσA : ∀ c : K, σ (algebraMap K κ c) ∈ A := fun c ↦ (hA _).mpr ⟨C c, by simp⟩
  have htA : ∀ i, t i ∈ A := fun i ↦ (hA _).mpr ⟨X i, by simp⟩
  let v : Basis.ofVectorSpaceIndex K κ → L := fun i ↦ σ (b i)
  have hsp : ⊤ ≤ Submodule.span A (Set.range v) := by
    rintro x -
    obtain ⟨h, rfl⟩ := hsurj x
    induction h using MvPolynomial.induction_on with
    | C c =>
      rw [eval₂Hom_C]
      have hc := b.mem_span c
      induction hc using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact Submodule.subset_span ⟨i, rfl⟩
      | zero => rw [map_zero]; exact zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | smul r x _ hx =>
        rw [Algebra.smul_def, map_mul]
        exact Submodule.smul_mem _ (⟨_, hσA r⟩ : A) hx
    | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul, eval₂Hom_X', mul_comm]
      exact Submodule.smul_mem _ (⟨t i, htA i⟩ : A) hp
  have hli : LinearIndependent A v := by
    rw [linearIndependent_iff']
    intro s g hg l hl
    choose H hH using fun i ↦ (hA (g i : L)).mp (g i).2
    let P : MvPolynomial (Fin d) κ := ∑ i ∈ s, C (b i) * map (algebraMap K κ) (H i)
    have hP : eval₂Hom σ t P = 0 := by
      rw [← hg, map_sum]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [map_mul, eval₂Hom_C, coe_eval₂Hom, eval₂_map, hH i, mul_comm]
      rfl
    have key := coeffMap_mem_of_mem_map _ (hker hP) (b.coord l)
    have hHl : coeffMap (b.coord l) P = H l := by
      ext m
      rw [coeff_coeffMap]
      simp only [P, coeff_sum, coeff_C_mul, coeff_map, map_sum]
      have h3 : ∀ i ∈ s, b.coord l (b i * algebraMap K κ ((H i).coeff m)) =
          if i = l then (H l).coeff m else 0 := by
        intro i _
        rw [mul_comm, ← Algebra.smul_def, map_smul, Basis.coord_apply, Basis.repr_self,
          Finsupp.single_apply]
        split_ifs with h
        · subst h; rw [smul_eq_mul, mul_one]
        · rw [smul_zero]
      rw [Finset.sum_congr rfl h3, Finset.sum_ite_eq' s l]
      simp [hl]
    rw [hHl, RingHom.mem_ker, coe_eval₂Hom, hH l] at key
    exact Subtype.ext key
  exact Module.Free.of_basis (Basis.mk hli hsp)

end Free

section EssFiniteType

/-- If `A ⊂ L` consists of the polynomials in the `t_i` with coefficients in `σ(F)`, where `F` is
generated over `k` by a finite set `S`, the `t_i` have zero residue, `𝔪` is nilpotent, and
elements of `A` with nonzero residue are units of `A`, then `A` is essentially of finite type
over `k`. -/
theorem essFiniteType_of_residue {k L : Type*} [Field k] [CommRing L] [Algebra k L]
    [IsLocalRing L] (σ : ResidueField L →+* L) (hσ : ∀ x, residue L (σ x) = x)
    (F : IntermediateField k (ResidueField L)) (S : Finset (ResidueField L))
    (hS : IntermediateField.adjoin k (S : Set (ResidueField L)) = F) {d : ℕ} (t : Fin d → L)
    (ht0 : ∀ i, residue L (t i) = 0) (A : Subalgebra k L)
    (hA : ∀ x, x ∈ A ↔
      ∃ h : MvPolynomial (Fin d) F, eval₂ (σ.comp (algebraMap F (ResidueField L))) t h = x)
    (hunit : ∀ a : A, residue L a ≠ 0 → IsUnit a) {n : ℕ} (hn : maximalIdeal L ^ n = ⊥) :
    Algebra.EssFiniteType k A := by
  classical
  let Ψ₁ : MvPolynomial (Fin d) F →+* L := eval₂Hom (σ.comp (algebraMap F (ResidueField L))) t
  have hΨA : ∀ h, Ψ₁ h ∈ A := fun h ↦ (hA _).mpr ⟨h, rfl⟩
  let ΨA : MvPolynomial (Fin d) F →+* A := Ψ₁.codRestrict A hΨA
  have hres : ∀ h, residue L (Ψ₁ h) = algebraMap F (ResidueField L) (constantCoeff h) :=
    fun h ↦ residue_eval₂ (residue L) σ hσ t ht0 (algebraMap F (ResidueField L)) h
  have hSF : ∀ c ∈ S, c ∈ F := fun c hc ↦ hS ▸ IntermediateField.subset_adjoin k _ hc
  let sc : S → A := fun c ↦ ΨA (C ⟨c.1, hSF c.1 c.2⟩)
  have hsc : ∀ c : S, residue L (sc c) = c := by
    intro c
    change residue L (Ψ₁ (C _)) = _
    rw [hres, constantCoeff_C]
    rfl
  let s0 : Finset A := S.attach.image sc ∪ Finset.univ.image (fun i ↦ ΨA (X i))
  let Adj := Algebra.adjoin k (s0 : Set A)
  let R : Subring A :=
    { carrier := {x | ∃ u ∈ Adj, IsUnit u ∧ x * u ∈ Adj}
      mul_mem' := by
        rintro x y ⟨u, hu, hu', hxu⟩ ⟨v, hv, hv', hyv⟩
        refine ⟨u * v, mul_mem hu hv, hu'.mul hv', ?_⟩
        have : x * y * (u * v) = (x * u) * (y * v) := by ring
        rw [this]
        exact mul_mem hxu hyv
      one_mem' := ⟨1, Adj.one_mem, isUnit_one, by rw [one_mul]; exact Adj.one_mem⟩
      add_mem' := by
        rintro x y ⟨u, hu, hu', hxu⟩ ⟨v, hv, hv', hyv⟩
        refine ⟨u * v, mul_mem hu hv, hu'.mul hv', ?_⟩
        have : (x + y) * (u * v) = (x * u) * v + (y * v) * u := by ring
        rw [this]
        exact add_mem (mul_mem hxu hv) (mul_mem hyv hu)
      zero_mem' := ⟨1, Adj.one_mem, isUnit_one, by rw [zero_mul]; exact Adj.zero_mem⟩
      neg_mem' := by
        rintro x ⟨u, hu, hu', hxu⟩
        refine ⟨u, hu, hu', ?_⟩
        rw [neg_mul]
        exact neg_mem hxu }
  let π : A →ₐ[k] ResidueField L := (IsScalarTower.toAlgHom k L (ResidueField L)).comp A.val
  have hπ : ∀ a : A, π a = residue L a := fun a ↦ rfl
  let J : Ideal A := RingHom.ker π
  have hJL : J.map (algebraMap A L) ≤ maximalIdeal L := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, ← residue_eq_zero_iff]
    exact ha
  have hN : J ^ n = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have h1 := Ideal.mem_map_of_mem (algebraMap A L) hx
    rw [Ideal.map_pow] at h1
    have h2 := Ideal.pow_right_mono hJL n h1
    rw [hn, Ideal.mem_bot] at h2
    exact (Ideal.mem_bot).mpr (Subtype.ext h2)
  have hsub : ∀ h, ΨA h - ΨA (C (constantCoeff h)) ∈
      Ideal.span (Set.range fun i ↦ ΨA (X i)) := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a =>
      rw [constantCoeff_C, sub_self]
      exact zero_mem _
    | add p q hp hq =>
      rw [map_add, map_add, map_add, map_add, add_sub_add_comm]
      exact add_mem hp hq
    | mul_X p i hp =>
      simp only [map_mul, constantCoeff_X, mul_zero, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  have hAdj : ∀ x ∈ s0, x ∈ Adj := fun x hx ↦ Algebra.subset_adjoin hx
  have hSR : (Set.range fun i ↦ ΨA (X i)) ⊆ R := by
    rintro _ ⟨i, rfl⟩
    refine ⟨1, Adj.one_mem, isUnit_one, ?_⟩
    rw [mul_one]
    exact hAdj _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
  have hSJ : (Set.range fun i ↦ ΨA (X i)) ⊆ J := by
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, hπ]
    change residue L (Ψ₁ (X i)) = 0
    rw [eval₂Hom_X']
    exact ht0 i
  have hJ : J ≤ Ideal.span (Set.range fun i ↦ ΨA (X i)) := by
    intro x hx
    obtain ⟨h, hh⟩ := (hA x).mp x.2
    have hx' : x = ΨA h := Subtype.ext hh.symm
    rw [RingHom.mem_ker, hπ, ← hh] at hx
    have h0 : constantCoeff h = 0 := by
      apply (algebraMap F (ResidueField L)).injective
      rw [map_zero, ← hres]
      exact hx
    have := hsub h
    rwa [h0, map_zero, map_zero, sub_zero, ← hx'] at this
  have hπAdj : Algebra.adjoin k (S : Set (ResidueField L)) ≤ Adj.map π := by
    rw [Algebra.adjoin_le_iff]
    intro c hc
    refine ⟨sc ⟨c, hc⟩, hAdj _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _
      (Finset.mem_attach _ _))), ?_⟩
    exact (hπ _).trans (hsc _)
  have hR : ∀ b, ∃ r ∈ R, b - r ∈ J := by
    intro b
    have hb : π b ∈ IntermediateField.adjoin k (S : Set (ResidueField L)) := by
      rw [hS]
      obtain ⟨h, hh⟩ := (hA b).mp b.2
      rw [hπ, ← hh]
      change residue L (Ψ₁ h) ∈ F
      rw [hres]
      exact (constantCoeff h).2
    obtain ⟨u, hu, v, hv, huv⟩ := IntermediateField.mem_adjoin_iff_div.mp hb
    obtain ⟨a0, ha0, hπa0⟩ := hπAdj hu
    obtain ⟨b0, hb0, hπb0⟩ := hπAdj hv
    have hπa0' : π a0 = u := hπa0
    have hπb0' : π b0 = v := hπb0
    by_cases hv0 : v = 0
    · refine ⟨0, R.zero_mem, ?_⟩
      rw [sub_zero, RingHom.mem_ker, huv, hv0, div_zero]
    · have hb0u : IsUnit b0 := hunit b0 (by rw [← hπ, hπb0']; exact hv0)
      refine ⟨a0 * ↑hb0u.unit⁻¹, ⟨b0, hb0, hb0u, ?_⟩, ?_⟩
      · rw [mul_assoc, hb0u.val_inv_mul, mul_one]
        exact ha0
      · rw [RingHom.mem_ker, map_sub, map_mul, map_units_inv, hb0u.unit_spec, hπa0', hπb0', huv,
          div_eq_mul_inv, sub_self]
  rw [Algebra.essFiniteType_iff]
  exact ⟨s0, fun b ↦ mem_subring_of_nilpotent R J hN _ hSR hSJ hJ hR b⟩

end EssFiniteType

end Langlands.CommutativeAlgebra.Popescu.ArtinianFlat
