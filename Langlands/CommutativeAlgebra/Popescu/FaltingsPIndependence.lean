import Langlands.CommutativeAlgebra.Popescu.FaltingsCartier

/-! # `p`-independence: adjoining `p`-th roots of elements with independent differentials -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

namespace Faltings

open scoped TensorProduct

/-- The differentials of algebra generators span the module of differentials. -/
theorem kaehler_span_of_adjoin {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {ι : Type*}
    (v : ι → S) (h : Algebra.adjoin R (Set.range v) = ⊤) :
    Submodule.span S (Set.range fun i => KaehlerDifferential.D R S (v i)) = ⊤ := by
  rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation, Submodule.span_le]
  rintro _ ⟨x, rfl⟩
  have hx : x ∈ Algebra.adjoin R (Set.range v) := h ▸ Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    exact Submodule.subset_span ⟨i, rfl⟩
  | algebraMap r =>
    rw [Derivation.map_algebraMap]
    exact zero_mem _
  | add y z _ _ hy hz =>
    rw [map_add]
    exact add_mem hy hz
  | mul y z _ _ hy hz =>
    rw [Derivation.leibniz]
    exact add_mem (Submodule.smul_mem _ _ hz) (Submodule.smul_mem _ _ hy)

theorem isIntegral_of_pow_mem {k L : Type*} [Field k] [Field L] [Algebra k L] (p : ℕ)
    [Fact p.Prime] (x : L) (c : k) (hc : x ^ p = algebraMap k L c) : IsIntegral k x := by
  refine ⟨Polynomial.X ^ p - Polynomial.C c,
    Polynomial.monic_X_pow_sub_C c (Fact.out : p.Prime).ne_zero, ?_⟩
  rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hc, sub_self]

/-- **Non-triviality of the tower steps.** Let `M/k` be generated by `β₁, …, β_n` with
`β_j^p = a_j`, and let `a_{n+1} ∈ k`. If `da₁, …, da_{n+1}` are linearly independent in `Ω_{k/ℤ}`,
then `a_{n+1}` is not a `p`-th power in `M`. -/
theorem not_pow_of_independent (p : ℕ) [Fact p.Prime] {k M : Type u} [Field k] [CharP k p]
    [Field M] [Algebra k M] {n : ℕ} (a : Fin (n + 1) → k)
    (hind : LinearIndependent k fun j => KaehlerDifferential.D ℤ k (a j)) (β : Fin n → M)
    (hgen : Algebra.adjoin k (Set.range β) = ⊤)
    (hβ : ∀ j, β j ^ p = algebraMap k M (a j.castSucc)) (m : M) :
    m ^ p ≠ algebraMap k M (a (Fin.last n)) := by
  classical
  intro hm
  have : CharP M p := charP_of_injective_algebraMap' k p
  -- the `n + 1` vectors `1 ⊗ da_j` lie in the kernel of `M ⊗ Ω_k → Ω_M`
  have hli : LinearIndependent M fun j =>
      (1 : M) ⊗ₜ[k] KaehlerDifferential.D ℤ k (a j) :=
    Module.Flat.linearIndependent_one_tmul hind
  have hpow : ∀ x : M, KaehlerDifferential.D ℤ M (x ^ p) = 0 := by
    intro x
    rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul M, CharP.cast_eq_zero, zero_smul]
  have hker : ∀ j, (1 : M) ⊗ₜ[k] KaehlerDifferential.D ℤ k (a j) ∈
      LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k M) := by
    intro j
    rw [LinearMap.mem_ker, KaehlerDifferential.mapBaseChange_tmul, one_smul,
      KaehlerDifferential.map_D]
    rcases Fin.eq_castSucc_or_eq_last j with ⟨i, rfl⟩ | rfl
    · rw [← hβ i]
      exact hpow _
    · rw [← hm]
      exact hpow _
  have hspan : Submodule.span M (Set.range fun j =>
      (1 : M) ⊗ₜ[k] KaehlerDifferential.D ℤ k (a j)) ≤
      LinearMap.range (Algebra.H1Cotangent.δ ℤ k M) := by
    rw [← (Algebra.H1Cotangent.exact_δ_mapBaseChange ℤ k M).linearMap_ker_eq, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact hker j
  have h1 : Module.rank M (Submodule.span M (Set.range fun j =>
      (1 : M) ⊗ₜ[k] KaehlerDifferential.D ℤ k (a j))) = (n + 1 : ℕ) := by
    have : Module.Finite M (Submodule.span M (Set.range fun j =>
        (1 : M) ⊗ₜ[k] KaehlerDifferential.D ℤ k (a j))) :=
      FiniteDimensional.span_of_finite M (Set.finite_range _)
    rw [← Module.finrank_eq_rank, finrank_span_eq_card hli, Fintype.card_fin]
  have h2 := Submodule.rank_mono hspan
  have h3 := rank_range_le (Algebra.H1Cotangent.δ ℤ k M)
  have hroots : ∀ j, β j ^ p ∈ Set.range (algebraMap k M) := fun j => ⟨_, (hβ j).symm⟩
  obtain ⟨hcart, -⟩ := rank_eq_of_pRoots p n M β hgen hroots
  have h4 : Module.rank M Ω[M⁄k] ≤ n := by
    have := kaehler_span_of_adjoin β hgen
    rw [← rank_top, ← this]
    refine (rank_span_le _).trans ?_
    rw [Cardinal.mk_fintype]
    exact_mod_cast (Fintype.card_range_le _).trans (Fintype.card_fin n).le
  have : ((n + 1 : ℕ) : Cardinal) ≤ n := by
    rw [← h1]
    exact h2.trans (h3.trans (hcart.trans_le h4))
  norm_cast at this
  omega

/-- Adjoining `p`-th roots `β_j` of `a_j` with `da_j` independent gives degree `p^n`. -/
theorem finrank_pRoots (p : ℕ) [Fact p.Prime] {k : Type u} [Field k] [CharP k p] :
    ∀ (n : ℕ) (a : Fin n → k), (LinearIndependent k fun j => KaehlerDifferential.D ℤ k (a j)) →
      ∀ (L : Type u) [Field L] [Algebra k L] (β : Fin n → L),
        Algebra.adjoin k (Set.range β) = ⊤ → (∀ j, β j ^ p = algebraMap k L (a j)) →
        Module.finrank k L = p ^ n := by
  intro n
  induction n with
  | zero =>
    intro a _ L _ _ β hgen _
    have hsurj : Function.Surjective (algebraMap k L) := by
      intro x
      have hx : x ∈ Algebra.adjoin k (Set.range β) := hgen ▸ Algebra.mem_top
      rw [Set.range_eq_empty, Algebra.adjoin_empty] at hx
      exact Algebra.mem_bot.mp hx
    let e : k ≃ₐ[k] L :=
      AlgEquiv.ofBijective (Algebra.ofId k L) ⟨(algebraMap k L).injective, hsurj⟩
    rw [← e.toLinearEquiv.finrank_eq, Module.finrank_self, pow_zero]
  | succ n ih =>
    intro a hind L _ _ β hgen hβ
    have hint : ∀ j, IsIntegral k (β j) := fun j => isIntegral_of_pow_mem p _ _ (hβ j)
    let M : IntermediateField k L :=
      IntermediateField.adjoin k (Set.range fun j : Fin n => β j.castSucc)
    let β' : Fin n → M := fun j => ⟨β j.castSucc, IntermediateField.subset_adjoin k _ ⟨j, rfl⟩⟩
    have hMgen : Algebra.adjoin k (Set.range β') = ⊤ :=
      adjoin_subtype_eq_top (fun j => β j.castSucc) (fun j => (hint j.castSucc).isAlgebraic)
    have hβ' : ∀ j, β' j ^ p = algebraMap k M (a j.castSucc) := fun j => Subtype.ext (hβ _)
    have hM : Module.finrank k M = p ^ n :=
      ih (fun j => a j.castSucc) (hind.comp _ (Fin.castSucc_injective n)) M β' hMgen hβ'
    have : CharP M p := charP_of_injective_algebraMap' k p
    let γ := β (Fin.last n)
    have hLgen : Algebra.adjoin M {γ} = ⊤ :=
      adjoin_last_eq_top (M := M) β hgen (fun i => ⟨β' i, rfl⟩)
    have hc : γ ^ p = algebraMap M L (algebraMap k M (a (Fin.last n))) := by
      rw [← IsScalarTower.algebraMap_apply]
      exact hβ _
    have hγ : γ ∉ Set.range (algebraMap M L) := by
      rintro ⟨m, hm⟩
      refine not_pow_of_independent p a hind β' hMgen hβ' m ?_
      apply (algebraMap M L).injective
      rw [map_pow, hm, ← hc]
    have hmin := minpoly_eq_X_pow_sub_C p γ hγ _ hc
    have hγint : IsIntegral M γ := isIntegral_of_pow_mem p γ _ hc
    have htop : IntermediateField.adjoin M {γ} = ⊤ := by
      apply IntermediateField.toSubalgebra_injective
      rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hγint.isAlgebraic, hLgen,
        IntermediateField.top_toSubalgebra]
    have hML : Module.finrank M L = p := by
      rw [← IntermediateField.finrank_top', ← htop, IntermediateField.adjoin.finrank hγint, hmin,
        Polynomial.natDegree_X_pow_sub_C]
    rw [← Module.finrank_mul_finrank k M L, hM, hML, pow_succ]

end Faltings

end Langlands.CommutativeAlgebra.Popescu
