import Mathlib

/-! # Auxiliary lemmas for the proof of Stacks, Smoothing Ring Maps, Lemma 16.11.1 (07FG) -/

namespace Langlands.CommutativeAlgebra.Popescu.ArtinianFlat

/-- A Nakayama-type lemma for subrings: if `J` is a nilpotent ideal generated by a subset `S` of a
subring `R`, and `R` maps onto `B ⧸ J`, then `R` is everything. -/
theorem mem_subring_of_nilpotent {B : Type*} [CommRing B] (R : Subring B) (J : Ideal B) {N : ℕ}
    (hN : J ^ N = ⊥) (S : Set B) (hSR : S ⊆ R) (hSJ : S ⊆ J) (hJ : J ≤ Ideal.span S)
    (hR : ∀ b, ∃ r ∈ R, b - r ∈ J) (b : B) : b ∈ R := by
  have hmul : ∀ {a c : B} {m n : ℕ}, a ∈ J ^ m → c ∈ J ^ n → a * c ∈ J ^ (m + n) := by
    intro a c m n ha hc
    rw [pow_add]
    exact Ideal.mul_mem_mul ha hc
  have hmono : ∀ {a : B} {m n : ℕ}, m ≤ n → a ∈ J ^ n → a ∈ J ^ m :=
    fun h ha ↦ Ideal.pow_le_pow_right h ha
  have hJ1 : ∀ {a : B}, a ∈ J → a ∈ J ^ 1 := fun ha ↦ by rwa [pow_one]
  have P1' : ∀ y ∈ Ideal.span S, ∃ r ∈ R, r ∈ J ∧ y - r ∈ J ^ 2 := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem s hs => exact ⟨s, hSR hs, hSJ hs, by rw [sub_self]; exact zero_mem _⟩
    | zero => exact ⟨0, R.zero_mem, J.zero_mem, by rw [sub_self]; exact zero_mem _⟩
    | add x y _ _ hx hy =>
      obtain ⟨r₁, h₁, h₁', e₁⟩ := hx
      obtain ⟨r₂, h₂, h₂', e₂⟩ := hy
      refine ⟨r₁ + r₂, R.add_mem h₁ h₂, J.add_mem h₁' h₂', ?_⟩
      rw [show x + y - (r₁ + r₂) = (x - r₁) + (y - r₂) by ring]
      exact add_mem e₁ e₂
    | smul a x _ hx =>
      obtain ⟨r, hr, hr', e⟩ := hx
      obtain ⟨ra, hra, ea⟩ := hR a
      refine ⟨ra * r, R.mul_mem hra hr, J.mul_mem_left _ hr', ?_⟩
      rw [smul_eq_mul, show a * x - ra * r = a * (x - r) + (a - ra) * r by ring]
      exact add_mem (Ideal.mul_mem_left _ _ e) (hmul (m := 1) (n := 1) (hJ1 ea) (hJ1 hr'))
  have P1 : ∀ y ∈ J, ∃ r ∈ R, r ∈ J ∧ y - r ∈ J ^ 2 := fun y hy ↦ P1' y (hJ hy)
  have Pt : ∀ t : ℕ, ∀ y ∈ J ^ t, ∃ r ∈ R, r ∈ J ^ t ∧ y - r ∈ J ^ (t + 1) := by
    intro t
    induction t with
    | zero =>
      intro y _
      obtain ⟨r, hr, e⟩ := hR y
      exact ⟨r, hr, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top,
        by rwa [zero_add, pow_one]⟩
    | succ t ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha c hc
        obtain ⟨r, hr, hr', e⟩ := ih a ha
        obtain ⟨r', hr₂, hr₂', e'⟩ := P1 c hc
        refine ⟨r * r', R.mul_mem hr hr₂, hmul hr' (hJ1 hr₂'), ?_⟩
        rw [show a * c - r * r' = (a - r) * c + r * (c - r') by ring]
        refine add_mem (hmul e (hJ1 hc)) ?_
        exact hmono (by omega) (hmul hr' e')
      · rintro x z ⟨r₁, h₁, h₁', e₁⟩ ⟨r₂, h₂, h₂', e₂⟩
        refine ⟨r₁ + r₂, R.add_mem h₁ h₂, add_mem h₁' h₂', ?_⟩
        rw [show x + z - (r₁ + r₂) = (x - r₁) + (z - r₂) by ring]
        exact add_mem e₁ e₂
  have approx : ∀ t : ℕ, ∃ r ∈ R, b - r ∈ J ^ t := by
    intro t
    induction t with
    | zero => exact ⟨0, R.zero_mem, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top⟩
    | succ t ih =>
      obtain ⟨r, hr, e⟩ := ih
      obtain ⟨r', hr', -, e'⟩ := Pt t _ e
      exact ⟨r + r', R.add_mem hr hr', by rwa [sub_sub] at e'⟩
  obtain ⟨r, hr, e⟩ := approx N
  rw [hN, Ideal.mem_bot, sub_eq_zero] at e
  exact e ▸ hr

end Langlands.CommutativeAlgebra.Popescu.ArtinianFlat
