import Langlands.MathlibBase
import Langlands.CommutativeAlgebra.Popescu.ArtinianFlatLift
import Langlands.CommutativeAlgebra.Popescu.ArtinianFlatTools
import Langlands.CommutativeAlgebra.Popescu.ArtinianFlatDerivation

/-! # The coefficient claim in the proof of Stacks 07FG

In the proof of Stacks, Smoothing Ring Maps, Lemma 16.11.1 (07FG) one shows: for an Artinian
local `k`-algebra `(L, 𝔪, κ)` with `𝔪 = (t₁, …, t_d)` and `H₁(L_{κ/k})` finite, there are a
section `σ : κ → L` of the residue map and a finitely generated subextension `F` of `κ/k` such that
`k ⊂ σ(F)[t₁, …, t_d]`. This file proves the inductive step along a square-zero extension. -/

namespace Langlands.CommutativeAlgebra.Popescu.ArtinianFlat

open MvPolynomial

section Eval

variable {R κ B : Type*} [CommRing R] [CommRing κ] [CommRing B] {d : ℕ}

/-- The residue of `h(t)` is the constant coefficient of `h`, if the `t_i` have zero residue. -/
theorem residue_eval₂ (π : B →+* κ) (σ : κ →+* B) (hσ : ∀ x, π (σ x) = x) (t : Fin d → B)
    (ht : ∀ i, π (t i) = 0) (ι : R →+* κ) (h : MvPolynomial (Fin d) R) :
    π (eval₂ (σ.comp ι) t h) = ι (constantCoeff h) := by
  induction h using MvPolynomial.induction_on with
  | C a => simp [hσ]
  | add p q hp hq => simp [eval₂_add, hp, hq]
  | mul_X p i hp => simp [eval₂_mul, ht]

/-- Changing the coefficient map by a map killing all `t_i` only changes the constant term. -/
theorem eval₂_eq_add (σ σ₁ : κ →+* B) (t : Fin d → B) (ht : ∀ x i, (σ₁ x - σ x) * t i = 0)
    (ι : R →+* κ) (h : MvPolynomial (Fin d) R) :
    eval₂ (σ₁.comp ι) t h =
      eval₂ (σ.comp ι) t h + (σ₁ (ι (constantCoeff h)) - σ (ι (constantCoeff h))) := by
  induction h using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    simp only [eval₂_add, hp, hq, map_add]
    ring
  | mul_X p i hp =>
    simp only [eval₂_mul, eval₂_X, hp, map_mul, constantCoeff_X, mul_zero, map_zero, sub_self,
      add_zero]
    linear_combination ht (ι (constantCoeff p)) i

/-- If the kernel of `π` is nilpotent and generated by the `t_i`, then every element is a
polynomial in the `t_i` with coefficients in the image of a section `σ`. -/
theorem eval₂_surjective (π : B →+* κ) (σ : κ →+* B) (hσ : ∀ x, π (σ x) = x) (t : Fin d → B)
    (ht : ∀ i, π (t i) = 0) {n : ℕ} (hn : RingHom.ker π ^ n = ⊥)
    (hspan : RingHom.ker π ≤ Ideal.span (Set.range t)) :
    Function.Surjective (eval₂Hom σ t : MvPolynomial (Fin d) κ →+* B) := by
  intro b
  have := mem_subring_of_nilpotent (eval₂Hom σ t).range (RingHom.ker π) hn (Set.range t)
    (by
      rintro _ ⟨i, rfl⟩
      exact RingHom.mem_range.mpr ⟨X i, by simp⟩)
    (by
      rintro _ ⟨i, rfl⟩
      exact ht i)
    hspan
    (fun b ↦ ⟨σ (π b), RingHom.mem_range.mpr ⟨C (π b), by simp⟩,
      by rw [RingHom.mem_ker, map_sub, hσ, sub_self]⟩) b
  exact RingHom.mem_range.mp this

end Eval

/-- The claim in the proof of Stacks 07FG for a `k`-algebra `B` with residue map `π : B → κ` and
elements `t`: there are a section `σ` of `π` and a finitely generated subextension `F` of `κ/k`
such that the image of `k` in `B` consists of polynomials in the `t_i` with coefficients in
`σ(F)`. -/
def CoeffClaim (k κ B : Type*) [Field k] [Field κ] [Algebra k κ] [CommRing B] [Algebra k B]
    (π : B →+* κ) {d : ℕ} (t : Fin d → B) : Prop :=
  ∃ σ : κ →+* B, (∀ x, π (σ x) = x) ∧ ∃ F : IntermediateField k κ, F.FG ∧
    ∀ a : k, ∃ h : MvPolynomial (Fin d) F,
      eval₂ (σ.comp (algebraMap F κ)) t h = algebraMap k B a

/-- The inductive step of the claim in the proof of Stacks 07FG: the claim lifts along a surjection
`g : B → B'` whose kernel `I` satisfies `I² = 0` and `𝔪_B I = 0`. -/
theorem coeffClaim_of_surjective {k κ B B' : Type*} [Field k] [Field κ] [Algebra k κ]
    [CommRing B] [Algebra k B] [CommRing B'] [Algebra k B']
    (p : ℕ) [Fact p.Prime] [CharP k p]
    (hV : (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k κ)).FG)
    (g : B →ₐ[k] B') (hg : Function.Surjective g)
    (π : B →+* κ) (π' : B' →+* κ) (hπ : ∀ x, π' (g x) = π x)
    (hπk : ∀ a, π (algebraMap k B a) = algebraMap k κ a)
    {d : ℕ} (t : Fin d → B) (ht : ∀ i, π (t i) = 0) {n : ℕ} (hn : RingHom.ker π ^ n = ⊥)
    (hspan : RingHom.ker π ≤ Ideal.span (Set.range t))
    (hsq : ∀ x y, g x = 0 → g y = 0 → x * y = 0)
    (hNI : ∀ x y, π x = 0 → g y = 0 → x * y = 0)
    (h' : CoeffClaim k κ B' π' (fun i ↦ g (t i))) : CoeffClaim k κ B π t := by
  classical
  obtain ⟨σ', hσ', F', hF'fg, hF'⟩ := h'
  have hp : p.Prime := Fact.out
  have : Nontrivial B := π.domain_nontrivial
  have : CharP B p := (CharP.charP_iff_prime_eq_zero hp).mpr (by
    rw [← map_natCast (algebraMap k B), CharP.cast_eq_zero, map_zero])
  have : CharP κ p := charP_of_injective_algebraMap (algebraMap k κ).injective p
  -- Step 1: lift the section `σ'` of `π'` to a section `σ₀` of `π`.
  obtain ⟨σ₀, hσ₀⟩ := exists_lift_of_sq_zero p g.toRingHom hg
    (fun a b ha hb ↦ hsq a b ha hb) σ'
  have hσ₀g : ∀ x, g (σ₀ x) = σ' x := fun x ↦ RingHom.congr_fun hσ₀ x
  have hσ₀π : ∀ x, π (σ₀ x) = x := fun x ↦ by rw [← hπ, hσ₀g, hσ']
  -- Step 2: lift `k → σ'(F')[t]` to `τ : k → σ₀(F')[t]`.
  let Ψ₀ : MvPolynomial (Fin d) F' →+* B := eval₂Hom (σ₀.comp (algebraMap F' κ)) t
  let Ψ' : MvPolynomial (Fin d) F' →+* B' :=
    eval₂Hom (σ'.comp (algebraMap F' κ)) (fun i ↦ g (t i))
  have hΨ : ∀ h, g (Ψ₀ h) = Ψ' h := by
    intro h
    change g.toRingHom (eval₂ _ t h) = eval₂ _ _ h
    rw [eval₂_comp_left]
    congr 1
    exact RingHom.ext fun x ↦ hσ₀g _
  let A : Subring B := Ψ₀.range
  let A' : Subring B' := Ψ'.range
  let gA : A →+* A' := (g.toRingHom.comp A.subtype).codRestrict A' (by
    rintro ⟨_, h, rfl⟩
    exact RingHom.mem_range.mpr ⟨h, (hΨ h).symm⟩)
  have hgA : Function.Surjective gA := by
    rintro ⟨_, h, rfl⟩
    exact ⟨⟨Ψ₀ h, h, rfl⟩, Subtype.ext (hΨ h)⟩
  have hsqA : ∀ x y : A, gA x = 0 → gA y = 0 → x * y = 0 := by
    intro x y hx hy
    apply Subtype.ext
    exact hsq x y (congrArg Subtype.val hx) (congrArg Subtype.val hy)
  have : CharP A p := (CharP.charP_iff_prime_eq_zero hp).mpr (Subtype.ext (by simp))
  let g₀ : k →+* A' := (algebraMap k B').codRestrict A' (fun a ↦ by
    obtain ⟨h, hh⟩ := hF' a
    exact RingHom.mem_range.mpr ⟨h, hh⟩)
  obtain ⟨τ₀, hτ₀⟩ := exists_lift_of_sq_zero p gA hgA hsqA g₀
  let τ : k →+* B := A.subtype.comp τ₀
  have hτg : ∀ a, g (τ a) = algebraMap k B' a := fun a ↦
    congrArg Subtype.val (RingHom.congr_fun hτ₀ a)
  have hτA : ∀ a, ∃ h : MvPolynomial (Fin d) F', Ψ₀ h = τ a := fun a ↦ (τ₀ a).2
  have hτπ : ∀ a, π (τ a) = algebraMap k κ a := fun a ↦ by
    rw [← hπ, hτg, ← g.commutes a, hπ, hπk]
  -- Step 3: the derivation `θ = algebraMap - τ : k → I` and its approximation.
  let I := RingHom.ker g
  let _ : Module κ I := Module.compHom I σ₀
  have hI : ∀ y : I, g (y : B) = 0 := fun y ↦ y.2
  have hact : ∀ (a : k) (y : B), g y = 0 →
      σ₀ (algebraMap k κ a) * y = algebraMap k B a * y := by
    intro a y hy
    have := hNI (σ₀ (algebraMap k κ a) - algebraMap k B a) y
      (by rw [map_sub, hσ₀π, hπk, sub_self]) hy
    linear_combination this
  have hθg : ∀ a, g (algebraMap k B a - τ a) = 0 := fun a ↦ by
    rw [map_sub, hτg, g.commutes, sub_self]
  let θ : k → I := fun a ↦ ⟨algebraMap k B a - τ a, hθg a⟩
  have hadd : ∀ a b, θ (a + b) = θ a + θ b := by
    intro a b
    apply Subtype.ext
    change algebraMap k B (a + b) - τ (a + b) = (algebraMap k B a - τ a) + (algebraMap k B b - τ b)
    rw [map_add, map_add]
    ring
  have hmul : ∀ a b, θ (a * b) = algebraMap k κ a • θ b + algebraMap k κ b • θ a := by
    intro a b
    apply Subtype.ext
    change algebraMap k B (a * b) - τ (a * b) =
      σ₀ (algebraMap k κ a) * (algebraMap k B b - τ b) +
        σ₀ (algebraMap k κ b) * (algebraMap k B a - τ a)
    rw [hact a _ (hθg b), hact b _ (hθg a), map_mul, map_mul]
    have := hsq _ _ (hθg a) (hθg b)
    linear_combination (-1 : B) * this
  obtain ⟨D, S, hDS⟩ := exists_derivation_approx' hV θ hadd hmul
  -- Step 4: the new section `σ₁ = σ₀ + D`.
  have hDI : ∀ x, g (D x : B) = 0 := fun x ↦ (D x).2
  have hDD : ∀ x y, (D x : B) * (D y : B) = 0 := fun x y ↦ hsq _ _ (hDI x) (hDI y)
  have hDt : ∀ x i, (D x : B) * t i = 0 := fun x i ↦ by
    rw [mul_comm]
    exact hNI _ _ (ht i) (hDI x)
  let σ₁ : κ →+* B :=
    { toFun := fun x ↦ σ₀ x + (D x : B)
      map_one' := by
        simp only [map_one, Derivation.map_one_eq_zero, ZeroMemClass.coe_zero, add_zero]
      map_mul' := fun x y ↦ by
        have h1 : ((D (x * y) : I) : B) = σ₀ x * D y + σ₀ y * D x := by
          rw [Derivation.leibniz]
          rfl
        rw [map_mul, h1]
        linear_combination (-1 : B) * hDD x y
      map_zero' := by simp
      map_add' := fun x y ↦ by
        simp only [map_add, Submodule.coe_add]
        ring }
  have hσ₁ : ∀ x, σ₁ x = σ₀ x + D x := fun x ↦ rfl
  have hσ₁π : ∀ x, π (σ₁ x) = x := fun x ↦ by
    rw [hσ₁, map_add, hσ₀π, ← hπ (D x : B), hDI x, map_zero, add_zero]
  have hσσ : ∀ x i, (σ₁ x - σ₀ x) * t i = 0 := fun x i ↦ by
    rw [hσ₁, add_sub_cancel_left]
    exact hDt x i
  -- Step 5: write the elements of `S` as polynomials in `t` with zero constant term.
  have hsurj := eval₂_surjective π σ₀ hσ₀π t ht hn hspan
  choose H hH using fun s : I ↦ hsurj s
  have hHe : ∀ s : I, eval₂ σ₀ t (H s) = s := fun s ↦ hH s
  have hH0 : ∀ s : I, constantCoeff (H s) = 0 := by
    intro s
    have := residue_eval₂ π σ₀ hσ₀π t ht (RingHom.id κ) (H s)
    rw [RingHom.comp_id, hHe s, ← hπ, hI s, map_zero, RingHom.id_apply] at this
    exact this.symm
  have hHσ₁ : ∀ s : I, eval₂ σ₁ t (H s) = s := by
    intro s
    have := eval₂_eq_add σ₀ σ₁ t hσσ (RingHom.id κ) (H s)
    simp only [RingHom.comp_id, hH0 s, map_zero, sub_self, add_zero] at this
    rw [this, hHe s]
  -- Step 6: the new subextension `F`.
  let F : IntermediateField k κ :=
    F' ⊔ IntermediateField.adjoin k (↑(S.biUnion fun s ↦ (H s).coeffs) : Set κ)
  have hF'F : F' ≤ F := le_sup_left
  have hHF : ∀ s ∈ S, ∀ m, (H s).coeff m ∈ F := by
    intro s hs m
    by_cases h0 : (H s).coeff m = 0
    · rw [h0]
      exact zero_mem _
    · refine (le_sup_right : IntermediateField.adjoin k _ ≤ F)
        (IntermediateField.subset_adjoin k _ ?_)
      exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨s, hs, coeff_mem_coeffs m h0⟩)
  have hlift : ∀ s ∈ S, ∃ H' : MvPolynomial (Fin d) F, map (algebraMap F κ) H' = H s := by
    intro s hs
    have : H s ∈ Set.range (map (algebraMap F κ) : MvPolynomial (Fin d) F → _) := by
      rw [mem_range_map_iff_coeffs_subset]
      intro c hc
      obtain ⟨m, -, rfl⟩ := mem_coeffs_iff.mp hc
      exact ⟨⟨_, hHF s hs m⟩, rfl⟩
    exact this
  choose! H' hH' using hlift
  refine ⟨σ₁, hσ₁π, F, IntermediateField.fg_sup hF'fg (IntermediateField.fg_adjoin_finset _),
    fun a ↦ ?_⟩
  -- Step 7: `a = τ(a) + D(a) + ∑ c_s s` is a polynomial in `t` over `σ₁(F)`.
  obtain ⟨c, hc⟩ := hDS a
  obtain ⟨ha, hha⟩ := hτA a
  have hc' : algebraMap k B a - τ a - D (algebraMap k κ a) =
      ∑ s ∈ S, σ₀ (algebraMap k κ (c s)) * s := by
    have := congrArg Subtype.val hc
    rw [Submodule.coe_sub, Submodule.coe_sum] at this
    exact this
  have hca : algebraMap F' κ (constantCoeff ha) = algebraMap k κ a := by
    have := residue_eval₂ π σ₀ hσ₀π t ht (algebraMap F' κ) ha
    rw [← hτπ a, ← hha]
    exact this.symm
  let ι : F' →+* F := (IntermediateField.inclusion hF'F).toRingHom
  have hι : (algebraMap F κ).comp ι = algebraMap F' κ := RingHom.ext fun x ↦ rfl
  have hterm : ∀ s ∈ S, eval₂ (σ₁.comp (algebraMap F κ)) t (H' s) = s := by
    intro s hs
    rw [← eval₂_map, hH' s hs, hHσ₁ s]
  refine ⟨map ι ha + ∑ s ∈ S, C ⟨algebraMap k κ (c s), F.algebraMap_mem (c s)⟩ * H' s, ?_⟩
  rw [eval₂_add, eval₂_map, RingHom.comp_assoc, hι, eval₂_sum]
  have h2 : ∀ s ∈ S, eval₂ (σ₁.comp (algebraMap F κ)) t
      (C ⟨algebraMap k κ (c s), F.algebraMap_mem (c s)⟩ * H' s) =
        σ₀ (algebraMap k κ (c s)) * s := by
    intro s hs
    rw [eval₂_mul, eval₂_C, hterm s hs]
    change (σ₀ _ + (D _ : B)) * s = _
    rw [add_mul, hsq _ _ (hDI _) (hI s), add_zero]
    rfl
  rw [Finset.sum_congr rfl h2]
  have h1 := eval₂_eq_add σ₀ σ₁ t hσσ (algebraMap F' κ) ha
  rw [hca, hσ₁, add_sub_cancel_left] at h1
  have h3 : eval₂ (σ₀.comp (algebraMap F' κ)) t ha = τ a := hha
  rw [h1, h3, ← hc']
  ring

end Langlands.CommutativeAlgebra.Popescu.ArtinianFlat
