import Langlands.CommutativeAlgebra.Popescu.FaltingsCore
import Langlands.CommutativeAlgebra.Popescu.FaltingsEmbdim
import Langlands.CommutativeAlgebra.Popescu.FaltingsLinear
import Langlands.CommutativeAlgebra.Popescu.PurelyInseparableTensorLocal

/-! # Faltings' argument: independence of differentials after a regular base change -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

namespace Faltings

open IsLocalRing MvPolynomial

open scoped TensorProduct

/-- A finite purely inseparable extension `k'/k` generated by `p`-th roots `β_j` of the `a_j`. -/
theorem exists_pRoots (p : ℕ) [hp : Fact p.Prime] {k : Type u} [Field k] [CharP k p] {n : ℕ}
    (a : Fin n → k) :
    ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k') (β : Fin n → k'),
      Algebra.adjoin k (Set.range β) = ⊤ ∧ (∀ j, β j ^ p = algebraMap k k' (a j)) ∧
        FiniteDimensional k k' ∧ IsPurelyInseparable k k' := by
  have hroot : ∀ j, ∃ z : AlgebraicClosure k, z ^ p = algebraMap k (AlgebraicClosure k) (a j) :=
    fun j => IsAlgClosed.exists_pow_nat_eq _ hp.out.pos
  choose β hβ using hroot
  have hint : ∀ j, IsIntegral k (β j) := fun j => isIntegral_of_pow_mem p (β j) (a j) (hβ j)
  have : ExpChar k p := ExpChar.prime hp.out
  refine ⟨IntermediateField.adjoin k (Set.range β), inferInstance, inferInstance,
    fun j => ⟨β j, IntermediateField.subset_adjoin k _ ⟨j, rfl⟩⟩,
    adjoin_subtype_eq_top β fun j => (hint j).isAlgebraic, fun j => Subtype.ext ?_, ?_, ?_⟩
  · simp only [IntermediateField.coe_pow, IntermediateField.coe_algebraMap_apply, hβ j]
  · exact IntermediateField.finiteDimensional_adjoin fun x ⟨j, hj⟩ => hj ▸ hint j
  · rw [IntermediateField.isPurelyInseparable_adjoin_iff_pow_mem k (AlgebraicClosure k) p]
    rintro _ ⟨j, rfl⟩
    exact ⟨1, by rw [pow_one, hβ j]; exact ⟨a j, rfl⟩⟩

section main

variable {k A : Type u} [Field k] [CommRing A] [IsLocalRing A] [Algebra k A]

theorem residue_adjoin_eq_top {A' : Type u} [CommRing A'] [IsLocalRing A'] [Algebra A A']
    [IsLocalHom (algebraMap A A')] {n : ℕ} (γ : Fin n → A')
    (hsurj : Function.Surjective (aeval γ : MvPolynomial (Fin n) A →ₐ[A] A')) :
    Algebra.adjoin (ResidueField A) (Set.range fun j => residue A' (γ j)) = ⊤ := by
  let φ : A' →ₐ[A] ResidueField A' := IsScalarTower.toAlgHom A A' (ResidueField A')
  have hγ : Algebra.adjoin A (Set.range γ) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval, AlgHom.range_eq_top]
    exact hsurj
  have hA : Algebra.adjoin A (Set.range fun j => residue A' (γ j)) = ⊤ := by
    have h1 := AlgHom.map_adjoin φ (Set.range γ)
    rw [hγ, Algebra.map_top, ← Set.range_comp] at h1
    have hφ : φ.range = ⊤ := by
      rw [AlgHom.range_eq_top]
      exact fun z => residue_surjective z
    rw [← hφ, h1]
    rfl
  rw [eq_top_iff]
  intro x _
  have hx : x ∈ Algebra.adjoin A (Set.range fun j => residue A' (γ j)) := hA ▸ Algebra.mem_top
  have hle : Algebra.adjoin A (Set.range fun j => residue A' (γ j)) ≤
      (Algebra.adjoin (ResidueField A) (Set.range fun j => residue A' (γ j))).restrictScalars A :=
    Algebra.adjoin_le Algebra.subset_adjoin
  exact hle hx

/-- **Faltings.** Let `A` be a local `k`-algebra, `char k = p`, such that `A ⊗_k k'` is a regular
local ring for every finite purely inseparable `k'/k`. If `da₁, …, da_n` are linearly independent
in `Ω_{k/ℤ}`, then the `1 ⊗ da_j` are linearly independent in `κ ⊗_A Ω_{A/ℤ}`. -/
theorem independent_of_regular (p : ℕ) [Fact p.Prime] [CharP k p]
    (hreg : ∀ (k' : Type u) [Field k'] [Algebra k k'] [FiniteDimensional k k']
      [IsPurelyInseparable k k'], IsRegularLocalRing (A ⊗[k] k'))
    {n : ℕ} (a : Fin n → k) (hind : LinearIndependent k fun j => KaehlerDifferential.D ℤ k (a j)) :
    LinearIndependent (ResidueField A) fun j =>
      (1 : ResidueField A) ⊗ₜ[A] KaehlerDifferential.D ℤ A (algebraMap k A (a j)) := by
  obtain ⟨k', _, _, β, hgen, hβ, _, _⟩ := exists_pRoots p a
  have : IsRegularLocalRing A := by
    have := hreg k
    exact IsRegularLocalRing.of_ringEquiv (Algebra.TensorProduct.rid k k A).toRingEquiv
  have hregA' := hreg k'
  have : Algebra.IsIntegral A (A ⊗[k] k') := isIntegral_tensor k k' A
  have : FaithfulSMul A (A ⊗[k] k') := (faithfulSMul_iff_algebraMap_injective _ _).mpr
    (Algebra.TensorProduct.includeLeft_injective (R := k) (S := k) (algebraMap k k').injective)
  have : CharP A p := charP_of_algebra p (R := k)
  have : CharP (ResidueField A) p := charP_of_algebra p (R := k)
  -- the presentation `A ⊗_k k' = A[x]/(x_j^p − a_j)`
  have hsurjβ : Function.Surjective (aeval β : MvPolynomial (Fin n) k →ₐ[k] k') := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hgen]
  have hkerβ := ker_aeval_eq_rootIdeal p a hind β hgen hβ
  have hsurj := aeval_one_tmul_surjective (A := A) β hsurjβ
  let Q : Algebra.Generators A (A ⊗[k] k') (Fin n) := Algebra.Generators.ofSurjective _ hsurj
  have hker : Q.ker = rootIdeal p (fun j => algebraMap k A (a j)) := by
    rw [Algebra.Generators.ker_eq_ker_aeval_val]
    exact ker_aeval_one_tmul β p a hsurjβ hkerβ
  -- the residue field extension
  have hcart := rank_eq_of_pRoots p (K := ResidueField A) n (ResidueField (A ⊗[k] k'))
    (fun j => residue _ (Q.val j)) (residue_adjoin_eq_top Q.val hsurj) (fun j => by
      refine ⟨residue A (algebraMap k A (a j)), ?_⟩
      rw [IsLocalRing.ResidueField.algebraMap_residue, ← map_pow, val_pow_eq p _ Q hker j])
  -- embedding dimensions
  have hX₁ : Module.rank (ResidueField A) (Algebra.H1Cotangent A (ResidueField A)) <
      Cardinal.aleph0 := by
    rw [rank_h1Cotangent_residueField_eq_finrank]
    exact Cardinal.natCast_lt_aleph0
  have hX : Module.rank (ResidueField (A ⊗[k] k'))
      (Algebra.H1Cotangent (A ⊗[k] k') (ResidueField (A ⊗[k] k'))) ≤
      Module.rank (ResidueField A) (Algebra.H1Cotangent A (ResidueField A)) := by
    rw [rank_h1Cotangent_residueField_eq_finrank, rank_h1Cotangent_residueField_eq_finrank]
    have h1 := (IsRegularLocalRing.iff_finrank_cotangentSpace (A ⊗[k] k')).mp hregA'
    have h2 := (IsRegularLocalRing.iff_finrank_cotangentSpace A).mp inferInstance
    have h3 := ringKrullDim_tensor_le k k' A
    rw [← h1, ← h2] at h3
    exact_mod_cast h3
  exact faltings_core p _ Q hker hX₁ hX hcart.1 hcart.2

end main

end Faltings

end Langlands.CommutativeAlgebra.Popescu
