import Langlands.CommutativeAlgebra.Popescu.AnnihilatorStabilizationStatement
import Langlands.CommutativeAlgebra.Popescu.CharPRegular
import Mathlib

/-! # Step (13) of the proof of Stacks Lemma 16.11.4 (07FJ) -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu.CharP

open IsLocalRing

section Adm

variable {Λ : Type u} [CommRing Λ] (q : Ideal Λ) [q.IsPrime] (n N : ℕ) {r : ℕ} (g : Fin r → Λ)
  {D : Type*} [CommRing D] (ψ : D →+* localTruncation q n)

/-- `l` is an admissible multiplier for `x`: `(l x)^{2N} = Σⱼ λⱼ gⱼ` in `Λ` where each `λⱼ`
maps to `l^{2N}` times an element of the image of `ψ` in `Λ_q/qⁿΛ_q`. -/
def Adm (l x : Λ) : Prop :=
  ∃ lam : Fin r → Λ, (l * x) ^ (2 * N) = ∑ j, lam j * g j ∧
    ∀ j, ∃ w : D, toLocalTruncation q n (lam j) = toLocalTruncation q n l ^ (2 * N) * ψ w

variable {q n N g ψ}

theorem Adm.mul {l x : Λ} (h : Adm q n N g ψ l x) (s : Λ) : Adm q n N g ψ (s * l) x := by
  obtain ⟨lam, h1, h2⟩ := h
  refine ⟨fun j => s ^ (2 * N) * lam j, ?_, fun j => ?_⟩
  · rw [mul_assoc, mul_pow, h1, Finset.mul_sum]
    simp only [mul_assoc]
  · obtain ⟨w, hw⟩ := h2 j
    refine ⟨w, ?_⟩
    rw [map_mul, map_pow, hw, map_mul, mul_pow]
    ring

end Adm

theorem toLocalTruncation_apply {Λ : Type u} [CommRing Λ] (q : Ideal Λ) [q.IsPrime] (n : ℕ)
    (x : Λ) : toLocalTruncation q n x =
      Ideal.Quotient.mk _ (algebraMap Λ (Localization.AtPrime q) x) := rfl

theorem isLocalRing_localTruncation {Λ : Type u} [CommRing Λ] (q : Ideal Λ) [q.IsPrime] {n : ℕ}
    (hn : 0 < n) : IsLocalRing (localTruncation q n) := by
  have hne : maximalIdeal (Localization.AtPrime q) ^ n ≠ ⊤ :=
    ne_top_of_le_ne_top (maximalIdeal.isMaximal _).ne_top (Ideal.pow_le_self hn.ne')
  have : Nontrivial (localTruncation q n) := Ideal.Quotient.nontrivial_iff.mpr hne
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- Step (13)(a) of Stacks 07FJ: if `xᴺ ∈ HΛ_q` (via `q^NΛ_q ⊆ (gⱼ)Λ_q`), `x ∈ q`, and `x`
and the `gⱼ` have images in `Λ_q/qⁿΛ_q` lying in the image of the flat local map `ψ`, then some
`l ∉ q` is an admissible multiplier for `x`. -/
theorem exists_adm {Λ : Type u} [CommRing Λ] (q : Ideal Λ) [q.IsPrime] {n N : ℕ} (hN : 1 ≤ N)
    (hNn : N ≤ n) {r : ℕ} (g : Fin r → Λ)
    (hH : maximalIdeal (Localization.AtPrime q) ^ N ≤
      Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime q) (g j)))
    {D : Type*} [CommRing D] [IsLocalRing D] (ψ : D →+* localTruncation q n) [IsLocalHom ψ]
    (hψ : ψ.Flat) (hg : ∀ j, ∃ b, ψ b = toLocalTruncation q n (g j)) {x : Λ} (hxq : x ∈ q)
    (hx : ∃ b, ψ b = toLocalTruncation q n x) :
    ∃ l ∉ q, Adm q n N g ψ l x := by
  classical
  set L := Localization.AtPrime q
  set m := maximalIdeal L
  have hn : 0 < n := by omega
  have := isLocalRing_localTruncation q hn
  choose a' ha' using hg
  obtain ⟨b, hb⟩ := hx
  have hxm : algebraMap Λ L x ∈ m := by
    have h := Ideal.mem_map_of_mem (algebraMap Λ L) hxq
    rwa [Localization.AtPrime.map_eq_maximalIdeal] at h
  have hxN : algebraMap Λ L x ^ N ∈ Ideal.span (Set.range fun j => algebraMap Λ L (g j)) :=
    hH (Ideal.pow_mem_pow hxm N)
  -- `b^N` lies in the ideal of `D` generated by the `a'ⱼ`
  have hbN : b ^ N ∈ Ideal.span (Set.range a') := by
    rw [← SmoothApprox.comap_map_of_flat_of_isLocalHom ψ hψ (Ideal.span (Set.range a'))]
    rw [Ideal.mem_comap, map_pow, hb, Ideal.map_span, ← Set.range_comp]
    have h1 := Ideal.mem_map_of_mem (Ideal.Quotient.mk (m ^ n)) hxN
    rw [Ideal.map_span, ← Set.range_comp] at h1
    convert h1 using 3
    · funext j
      simp only [Function.comp_apply, ha', toLocalTruncation_apply]
      rfl
    · rw [toLocalTruncation_apply, map_pow]
  obtain ⟨dd, hdd⟩ := Ideal.mem_span_range_iff_exists_fun.mp hbN
  -- lifts `c j ∈ L` of `ψ (dd j)`
  choose c hc using fun j => Ideal.Quotient.mk_surjective (I := m ^ n) (ψ (dd j))
  -- the error term
  set ε := algebraMap Λ L x ^ N - ∑ j, c j * algebraMap Λ L (g j) with hε
  have hεm : ε ∈ m ^ n := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, hε, map_sub, map_sum]
    have e1 : Ideal.Quotient.mk (m ^ n) (algebraMap Λ L x ^ N) = ψ (b ^ N) := by
      rw [map_pow, map_pow, hb, toLocalTruncation_apply]
    rw [e1, ← hdd, map_sum]
    simp only [map_mul, hc, ha', toLocalTruncation_apply]
    exact sub_self _
  have hεm' : ε ∈ m ^ (n - N) • Submodule.span L (Set.range fun j => algebraMap Λ L (g j)) := by
    have : m ^ n ≤ m ^ (n - N) * m ^ N := by
      rw [← pow_add, Nat.sub_add_cancel hNn]
    exact Ideal.mul_mono_right hH (this hεm)
  obtain ⟨c', hc'm, hc'⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp hεm'
  rw [Finsupp.sum_fintype c' (fun i c => c • algebraMap Λ L (g i)) (fun i => zero_smul _ _)] at hc'
  -- `μ'ⱼ = xᴺ (cⱼ + c'ⱼ)`
  set μ' : Fin r → L := fun j => algebraMap Λ L x ^ N * (c j + c' j) with hμ'
  have hμ'eq : algebraMap Λ L x ^ (2 * N) = ∑ j, μ' j * algebraMap Λ L (g j) := by
    have h1 : algebraMap Λ L x ^ N =
        ∑ j, c j * algebraMap Λ L (g j) + ∑ j, c' j * algebraMap Λ L (g j) := by
      simp only [smul_eq_mul] at hc'
      rw [hc', hε]; ring
    have h2 : ∑ j, μ' j * algebraMap Λ L (g j) = algebraMap Λ L x ^ N *
        (∑ j, c j * algebraMap Λ L (g j) + ∑ j, c' j * algebraMap Λ L (g j)) := by
      rw [← Finset.sum_add_distrib, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [hμ']; ring
    rw [h2, ← h1, two_mul, pow_add]
  have hμ'mk : ∀ j, Ideal.Quotient.mk (m ^ n) (μ' j) = ψ (b ^ N * dd j) := by
    intro j
    have h0 : algebraMap Λ L x ^ N * c' j ∈ m ^ n := by
      have : m ^ N * m ^ (n - N) ≤ m ^ n := by rw [← pow_add, Nat.add_sub_cancel' hNn]
      exact this (Ideal.mul_mem_mul (Ideal.pow_mem_pow hxm N) (hc'm j))
    show Ideal.Quotient.mk (m ^ n) (algebraMap Λ L x ^ N * (c j + c' j)) = _
    rw [mul_add, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr h0, add_zero, map_mul,
      map_mul, hc, map_pow, map_pow, hb, toLocalTruncation_apply]
  -- clear denominators
  obtain ⟨s₁, hs₁⟩ := IsLocalization.exist_integer_multiples_of_finite q.primeCompl μ'
  choose μ'' hμ'' using hs₁
  have heq : algebraMap Λ L ((s₁ : Λ) * x ^ (2 * N)) = algebraMap Λ L (∑ j, μ'' j * g j) := by
    rw [map_mul, map_pow, hμ'eq, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, hμ'' j, Algebra.smul_def]
    simp only [hμ']
    ring
  obtain ⟨s₂, hs₂⟩ := IsLocalization.exists_of_eq (M := q.primeCompl) heq
  refine ⟨(s₁ : Λ) * s₂, q.primeCompl.mul_mem s₁.2 s₂.2, ?_⟩
  obtain ⟨M, hM⟩ : ∃ M, 2 * N = M + 1 := ⟨2 * N - 1, by omega⟩
  refine ⟨fun j => ((s₁ : Λ) * s₂) ^ M * s₂ * μ'' j, ?_, fun j => ⟨b ^ N * dd j, ?_⟩⟩
  · rw [mul_pow, hM, pow_succ]
    have : ((s₁ : Λ) * s₂) ^ M * ((s₁ : Λ) * s₂) * x ^ (M + 1) =
        ((s₁ : Λ) * s₂) ^ M * ((s₂ : Λ) * ((s₁ : Λ) * x ^ (2 * N))) := by
      rw [hM]; ring
    rw [this, hs₂, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  · have h1 : toLocalTruncation q n (μ'' j) = toLocalTruncation q n (s₁ : Λ) * ψ (b ^ N * dd j) := by
      rw [toLocalTruncation_apply, hμ'' j, Algebra.smul_def, map_mul, hμ'mk,
        toLocalTruncation_apply]
    simp only [map_mul, map_pow, h1]
    rw [hM, pow_succ]
    ring

/-- Step (13) of Stacks 07FJ (without enlarging `D`): there are `δᵢ ∉ q` such that each `δᵢ` is an
admissible multiplier for `pᵢ` and, with `p'ᵢ = δᵢ pᵢ`,
`Ann_{Λ/(p'ⱼᵉ : j < i)}(p'ᵢ) = Ann_{Λ/(p'ⱼᵉ : j < i)}(p'ᵢ²)`. -/
theorem exists_step13 (hOg : AnnihilatorStabilizationStatement.{u}) {Λ : Type u} [CommRing Λ]
    [IsNoetherianRing Λ] (q : Ideal Λ) [q.IsPrime] {n N : ℕ} (hN : 1 ≤ N) (hNn : N ≤ n) {r : ℕ}
    (g : Fin r → Λ)
    (hH : maximalIdeal (Localization.AtPrime q) ^ N ≤
      Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime q) (g j)))
    {D : Type*} [CommRing D] [IsLocalRing D] (ψ : D →+* localTruncation q n) [IsLocalHom ψ]
    (hψ : ψ.Flat) (hg : ∀ j, ∃ b, ψ b = toLocalTruncation q n (g j)) {d : ℕ} (p : Fin d → Λ)
    (hpq : ∀ i, p i ∈ q) (hp : ∀ i, ∃ b, ψ b = toLocalTruncation q n (p i)) (e : ℕ)
    (hreg : ∀ (T : Finset (Fin d)) (i : Fin d), i ∉ T → ∀ y : Localization.AtPrime q,
      algebraMap Λ (Localization.AtPrime q) (p i) * y ∈
        Ideal.span ((fun j => algebraMap Λ (Localization.AtPrime q) (p j) ^ e) ''
          (T : Set (Fin d))) →
      y ∈ Ideal.span ((fun j => algebraMap Λ (Localization.AtPrime q) (p j) ^ e) ''
          (T : Set (Fin d)))) :
    ∃ δ : Fin d → Λ, (∀ i, δ i ∉ q) ∧ (∀ i, Adm q n N g ψ (δ i) (p i)) ∧
      ∀ (i : Fin d) (y : Λ), (δ i * p i) ^ 2 * y ∈
          Ideal.span ((fun j => (δ j * p j) ^ e) '' {j | j < i}) →
        δ i * p i * y ∈ Ideal.span ((fun j => (δ j * p j) ^ e) '' {j | j < i}) := by
  classical
  choose l hlq hl using fun i => exists_adm q hN hNn g hH ψ hψ hg (hpq i) (hp i)
  suffices H : ∀ t ≤ d, ∃ δ : Fin d → Λ, (∀ i, δ i ∉ q) ∧ (∀ i, Adm q n N g ψ (δ i) (p i)) ∧
      ∀ (i : Fin d), i.val < t → ∀ y : Λ, (δ i * p i) ^ 2 * y ∈
          Ideal.span ((fun j => (δ j * p j) ^ e) '' {j | j < i}) →
        δ i * p i * y ∈ Ideal.span ((fun j => (δ j * p j) ^ e) '' {j | j < i}) by
    obtain ⟨δ, h1, h2, h3⟩ := H d le_rfl
    exact ⟨δ, h1, h2, fun i => h3 i i.2⟩
  intro t
  induction t with
  | zero => exact fun _ => ⟨l, hlq, hl, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  | succ t ih =>
    intro ht
    obtain ⟨δ, hδq, hδ, h⟩ := ih (Nat.le_of_succ_le ht)
    let i₀ : Fin d := ⟨t, ht⟩
    set T : Finset (Fin d) := Finset.univ.filter (· < i₀) with hT
    have hTset : ({j | j < i₀} : Set (Fin d)) = (T : Set (Fin d)) := by
      rw [hT, Finset.coe_filter_univ]
    have hi₀T : i₀ ∉ T := by simp [hT]
    obtain ⟨σ, hσ, hσ'⟩ := hOg Λ (Λ ⧸ Ideal.span ((fun j => (δ j * p j) ^ e) '' (T : Set (Fin d))))
      q.primeCompl (δ i₀ * p i₀)
      (fun m hm => ogoma_hyp q p e T i₀ (hreg T i₀ hi₀T) δ hδq (δ i₀) (hδq i₀) m hm)
    refine ⟨Function.update δ i₀ (σ * δ i₀), ?_, ?_, ?_⟩
    · intro i
      by_cases hi : i = i₀
      · subst hi
        rw [Function.update_self]
        exact q.primeCompl.mul_mem hσ (hδq _)
      · rw [Function.update_of_ne hi]
        exact hδq i
    · intro i
      by_cases hi : i = i₀
      · subst hi
        rw [Function.update_self]
        exact (hδ _).mul σ
      · rw [Function.update_of_ne hi]
        exact hδ i
    · intro i hi y hy
      have hJ : (fun j => (Function.update δ i₀ (σ * δ i₀) j * p j) ^ e) '' {j | j < i} =
          (fun j => (δ j * p j) ^ e) '' {j | j < i} := by
        refine Set.image_congr fun j hj => ?_
        have hji : j.val < t := lt_of_lt_of_le (show j.val < i.val from hj) (Nat.le_of_lt_succ hi)
        have hne : j ≠ i₀ := fun h' => by rw [h'] at hji; exact lt_irrefl _ hji
        simp only [Function.update_of_ne hne]
      rw [hJ] at hy ⊢
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
      · have hne : i ≠ i₀ := fun h' => by rw [h'] at hlt; exact lt_irrefl _ hlt
        rw [Function.update_of_ne hne] at hy ⊢
        exact h i hlt y hy
      · have hii : i = i₀ := Fin.ext heq
        subst hii
        rw [Function.update_self] at hy ⊢
        rw [hTset] at hy ⊢
        have key := hσ' 1 q.primeCompl.one_mem (Ideal.Quotient.mk _ y)
        simp only [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
          Ideal.Quotient.eq_zero_iff_mem, one_mul] at key
        have e1 : σ * δ i₀ * p i₀ = σ * (δ i₀ * p i₀) := by ring
        rw [e1] at hy ⊢
        exact key hy

end Langlands.CommutativeAlgebra.Popescu.CharP
