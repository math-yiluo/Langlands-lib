import Mathlib

/-! # Tools for the proof of Stacks Lemma 16.11.4 (07FJ) -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu.CharP

open MvPolynomial

section Pigeonhole

variable {L : Type*} [CommRing L]

/-- If `x₁, …, x_d` generate `I`, then `I ^ (d e + 1) ⊆ (x₁ᵉ, …, x_dᵉ)`. -/
theorem span_pow_le_span_pow (e : ℕ) : ∀ {d : ℕ} (x : Fin d → L),
    Ideal.span (Set.range x) ^ (d * e + 1) ≤ Ideal.span (Set.range fun i => x i ^ e)
  | 0, x => by
    rw [Set.range_eq_empty, Ideal.span_empty, zero_mul, zero_add, pow_one]
    exact bot_le
  | d + 1, x => by
    have h1 : Ideal.span (Set.range x) =
        Ideal.span {x 0} ⊔ Ideal.span (Set.range (Fin.tail x)) := by
      rw [Fin.range_fin_succ, Ideal.span_insert]
    have h2 : Ideal.span (Set.range fun i => x i ^ e) =
        Ideal.span {x 0 ^ e} ⊔ Ideal.span (Set.range fun i => Fin.tail x i ^ e) := by
      rw [Fin.range_fin_succ, Ideal.span_insert]
      rfl
    rw [h1, h2, show (d + 1) * e + 1 = e + (d * e + 1) by ring]
    refine Ideal.sup_pow_add_le_pow_sup_pow.trans (sup_le_sup ?_ (span_pow_le_span_pow e _))
    rw [Ideal.span_singleton_pow]

/-- The ideal generated by unit multiples of a family is the ideal generated by the family. -/
theorem span_image_unit_mul {ι : Type*} (x u : ι → L) (hu : ∀ i, IsUnit (u i)) (s : Set ι) :
    Ideal.span ((fun i => u i * x i) '' s) = Ideal.span (x '' s) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, hi, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    obtain ⟨v, hv⟩ := (hu i).exists_left_inv
    have : x i = v * (u i * x i) := by rw [← mul_assoc, hv, one_mul]
    rw [SetLike.mem_coe, this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, hi, rfl⟩)

end Pigeonhole

section EssentiallySmooth

open MvPolynomial

/-- A finitely presented algebra map into an essentially smooth algebra factors through a
smooth algebra (a basic open of the smooth algebra). -/
theorem hasSmoothFactorizations_of_essentiallySmooth {P D : Type u} [CommRing P] [CommRing D]
    [Algebra P D] (h : EssentiallySmooth P D) : HasSmoothFactorizations P D := by
  obtain ⟨T₀, _, _, _, _, M, hsm, hloc⟩ := h
  intro B _ _ _ g
  classical
  obtain ⟨n, f, hfs, S, hS⟩ := Algebra.FinitePresentation.out (R := P) (A := B)
  -- a common denominator for the images of the variables
  obtain ⟨m, hm⟩ := IsLocalization.exist_integer_multiples_of_finite M
    (fun k : Fin n => g (f (X k)))
  choose t ht using hm
  let T₁ := Localization.Away (m : T₀)
  have hmD : IsUnit (algebraMap T₀ D m) := IsLocalization.map_units D m
  let l₁ : T₁ →ₐ[P] D :=
    IsLocalization.Away.liftAlgHom (m : T₀) (f := IsScalarTower.toAlgHom P T₀ D) hmD
  let e₁ : MvPolynomial (Fin n) P →ₐ[P] T₁ := aeval fun k =>
    IsLocalization.mk' T₁ (t k) (⟨m, Submonoid.mem_powers _⟩ : Submonoid.powers (m : T₀))
  have he₁ : l₁.comp e₁ = g.comp f := by
    apply MvPolynomial.algHom_ext
    intro k
    simp only [AlgHom.comp_apply, e₁, aeval_X]
    show IsLocalization.lift _ _ = _
    rw [IsLocalization.lift_mk'_spec]
    show algebraMap T₀ D (t k) = algebraMap T₀ D m * g (f (X k))
    rw [ht k, Algebra.smul_def]
  -- each relation becomes zero after inverting some element of `M`
  have hrel : ∀ ρ : S, ∃ (m' : M) (τ : T₀) (j : ℕ),
      e₁ ρ * algebraMap T₀ T₁ ((m : T₀) ^ j) = algebraMap T₀ T₁ τ ∧ (m' : T₀) * τ = 0 := by
    intro ρ
    obtain ⟨⟨τ, ⟨_, j, rfl⟩⟩, hτ⟩ := IsLocalization.surj (Submonoid.powers (m : T₀)) (e₁ ρ)
    have hρ : f ρ = 0 := by
      have : (ρ : MvPolynomial (Fin n) P) ∈ RingHom.ker f.toRingHom := by
        rw [← hS]; exact Ideal.subset_span ρ.2
      exact this
    have h0 : algebraMap T₀ D τ = 0 := by
      have := congrArg l₁ hτ
      rw [map_mul, ← AlgHom.comp_apply, he₁, AlgHom.comp_apply, hρ, map_zero, zero_mul] at this
      rw [← IsLocalization.Away.lift_eq (S := T₁) (m : T₀) hmD τ]
      exact this.symm
    obtain ⟨m', hm'⟩ := (IsLocalization.map_eq_zero_iff M D τ).mp h0
    exact ⟨m', τ, j, hτ, hm'⟩
  choose m' τ j hτ hm' using hrel
  set s : T₀ := (m : T₀) * ∏ ρ : S, (m' ρ : T₀) with hs
  have hsM : s ∈ M := M.mul_mem m.2 (M.prod_mem fun ρ _ => (m' ρ).2)
  let T' := Localization.Away s
  have : Algebra.Smooth T₀ T' := Algebra.Smooth.of_isLocalization_Away s
  have : Algebra.Smooth P T' := Algebra.Smooth.comp P T₀ T'
  have hmT' : IsUnit (algebraMap T₀ T' (m : T₀)) :=
    IsLocalization.Away.isUnit_of_dvd s (dvd_mul_right _ _)
  let j₁ : T₁ →ₐ[P] T' := IsLocalization.Away.liftAlgHom (m : T₀)
    (f := IsScalarTower.toAlgHom P T₀ T') hmT'
  let e' : MvPolynomial (Fin n) P →ₐ[P] T' := j₁.comp e₁
  have hker : RingHom.ker f.toRingHom ≤ RingHom.ker e'.toRingHom := by
    rw [← hS, Ideal.span_le]
    intro ρ hρ
    let ρ' : S := ⟨ρ, hρ⟩
    have h1 := congrArg j₁ (hτ ρ')
    have hu : IsUnit (algebraMap T₀ T' (m' ρ')) := IsLocalization.Away.isUnit_of_dvd s
      (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ (Finset.mem_univ ρ')) _)
    have h2 : algebraMap T₀ T' (τ ρ') = 0 := by
      have := congrArg (algebraMap T₀ T') (hm' ρ')
      rw [map_mul, map_zero] at this
      exact (hu.mul_right_eq_zero).mp this
    have hu' : IsUnit (algebraMap T₀ T' ((m : T₀) ^ j ρ')) := by
      rw [map_pow]
      exact (IsLocalization.Away.isUnit_of_dvd s (dvd_mul_right _ _)).pow _
    rw [map_mul] at h1
    have e3 : j₁ (algebraMap T₀ T₁ ((m : T₀) ^ j ρ')) = algebraMap T₀ T' ((m : T₀) ^ j ρ') :=
      IsLocalization.Away.lift_eq (S := T₁) (m : T₀) hmT' _
    have e4 : j₁ (algebraMap T₀ T₁ (τ ρ')) = algebraMap T₀ T' (τ ρ') :=
      IsLocalization.Away.lift_eq (S := T₁) (m : T₀) hmT' _
    rw [e3, e4, h2] at h1
    exact (hu'.mul_left_eq_zero).mp h1
  let ē : (MvPolynomial (Fin n) P ⧸ RingHom.ker f.toRingHom) →ₐ[P] T' :=
    Ideal.Quotient.liftₐ (RingHom.ker f.toRingHom) e' fun x hx => hker hx
  let G : B →ₐ[P] T' := ē.comp (Ideal.quotientKerAlgEquivOfSurjective hfs).symm.toAlgHom
  let H : T' →ₐ[P] D := IsLocalization.Away.liftAlgHom s (f := IsScalarTower.toAlgHom P T₀ D)
    (IsLocalization.map_units D ⟨s, hsM⟩)
  have hHj : H.comp j₁ = l₁ := by
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (Submonoid.powers (m : T₀))
    ext x
    show H (j₁ (algebraMap T₀ T₁ x)) = l₁ (algebraMap T₀ T₁ x)
    have e5 : j₁ (algebraMap T₀ T₁ x) = algebraMap T₀ T' x :=
      IsLocalization.Away.lift_eq (S := T₁) (m : T₀) hmT' x
    rw [e5]
    exact (IsLocalization.Away.lift_eq (S := T') s (IsLocalization.map_units D ⟨s, hsM⟩) x).trans
      (IsLocalization.Away.lift_eq (S := T₁) (m : T₀) hmD x).symm
  refine ⟨T', inferInstance, inferInstance, inferInstance, G, H, ?_⟩
  ext b
  obtain ⟨x, rfl⟩ := hfs b
  have e6 : (Ideal.quotientKerAlgEquivOfSurjective hfs).symm (f x) =
      Ideal.Quotient.mk (RingHom.ker f.toRingHom) x :=
    (AlgEquiv.symm_apply_eq _).mpr rfl
  show H (ē ((Ideal.quotientKerAlgEquivOfSurjective hfs).symm (f x))) = g (f x)
  rw [e6]
  show H (j₁ (e₁ x)) = g (f x)
  rw [← AlgHom.comp_apply H j₁, hHj, ← AlgHom.comp_apply, he₁, AlgHom.comp_apply]

end EssentiallySmooth

section Dimension

open IsLocalRing

/-- A finitely generated ideal is generated by a family indexed by `Fin` of its `spanFinrank`. -/
theorem exists_fin_span_eq_of_fg {L : Type*} [CommRing L] {I : Ideal L} (hI : I.FG) :
    ∃ x : Fin I.spanFinrank → L, Ideal.span (Set.range x) = I := by
  obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hI
  have hrange : Set.range (fun i : Fin I.spanFinrank => (s.equivFin.symm (Fin.cast hs.symm i)).1)
      = (s : Set L) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm (Fin.cast hs.symm i)).2
    · intro hy
      refine ⟨Fin.cast hs (s.equivFin ⟨y, hy⟩), ?_⟩
      simp
  exact ⟨_, (congrArg Ideal.span hrange).trans hspan⟩

/-- Along a flat local homomorphism from a regular local ring to a Noetherian local ring, the
minimal number of generators of the maximal ideal does not decrease (going down). -/
theorem spanFinrank_le_of_flat (L L' : Type*) [CommRing L] [CommRing L'] [IsRegularLocalRing L]
    [IsLocalRing L'] [IsNoetherianRing L'] [Algebra L L'] [Module.Flat L L']
    [IsLocalHom (algebraMap L L')] :
    (maximalIdeal L).spanFinrank ≤ (maximalIdeal L').spanFinrank := by
  have h1 : (((maximalIdeal L).spanFinrank : ℕ∞) : WithBot ℕ∞) = ringKrullDim L :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  have h2 : ringKrullDim L ≤ ringKrullDim L' := by
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal L) (maximalIdeal L')]
    exact WithBot.coe_le_coe.mpr le_self_add
  have h3 := ringKrullDim_le_spanFinrank_maximalIdeal L'
  have h4 := h1 ▸ h2.trans h3
  exact_mod_cast h4

end Dimension

section SmoothingLift

open SmoothingAlgebra

variable {A : Type u} [CommRing A] (d : ℕ) {r : ℕ} (n : ℕ) (a : Fin r → A)
variable {T : Type*} [CommRing T]

/-- The ring map `Alg → T` with `xᵢ ↦ πᵢ` and `zᵢⱼ ↦ λᵢⱼ`, where `πᵢⁿ = Σⱼ λᵢⱼ f(aⱼ)`. -/
noncomputable def liftHom (fA : A →+* T) (π : Fin d → T) (lam : Fin d → Fin r → T)
    (hπ : ∀ i, π i ^ n = ∑ j, lam i j * fA (a j)) : Alg d n a →+* T :=
  let ρ₀ : MvPolynomial (Fin d ⊕ (Fin d × Fin r)) A →+* T :=
    eval₂Hom fA (Sum.elim π fun p => lam p.1 p.2)
  have hle : Ideal.span (Set.range (rel d n a)) ≤ RingHom.ker ρ₀ := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker, rel, ρ₀, map_sub, map_pow, map_sum, map_mul,
      eval₂Hom_X', eval₂Hom_C, Sum.elim_inl, Sum.elim_inr, hπ]
    exact sub_self _
  Ideal.Quotient.lift _ ρ₀ fun p hp => hle hp

variable {d n a}

theorem liftHom_mk (fA : A →+* T) (π : Fin d → T) (lam : Fin d → Fin r → T)
    (hπ : ∀ i, π i ^ n = ∑ j, lam i j * fA (a j)) (p : MvPolynomial (Fin d ⊕ (Fin d × Fin r)) A) :
    liftHom d n a fA π lam hπ (mk d n a p) = eval₂Hom fA (Sum.elim π fun p => lam p.1 p.2) p :=
  rfl

theorem liftHom_algebraMap (fA : A →+* T) (π : Fin d → T) (lam : Fin d → Fin r → T)
    (hπ : ∀ i, π i ^ n = ∑ j, lam i j * fA (a j)) (x : A) :
    liftHom d n a fA π lam hπ (algebraMap A (Alg d n a) x) = fA x := by
  rw [← mk_C, liftHom_mk, eval₂Hom_C]

theorem liftHom_X (fA : A →+* T) (π : Fin d → T) (lam : Fin d → Fin r → T)
    (hπ : ∀ i, π i ^ n = ∑ j, lam i j * fA (a j)) (i : Fin d) :
    liftHom d n a fA π lam hπ (mk d n a (X (Sum.inl i))) = π i := by
  rw [liftHom_mk, eval₂Hom_X']
  rfl

theorem liftHom_Z (fA : A →+* T) (π : Fin d → T) (lam : Fin d → Fin r → T)
    (hπ : ∀ i, π i ^ n = ∑ j, lam i j * fA (a j)) (i : Fin d) (j : Fin r) :
    liftHom d n a fA π lam hπ (mk d n a (X (Sum.inr (i, j)))) = lam i j := by
  rw [liftHom_mk, eval₂Hom_X']
  rfl

/-- Ring maps out of `Alg` agree when they agree on `A` and on the variables. -/
theorem ringHom_ext {f g : Alg d n a →+* T}
    (hA : ∀ x, f (algebraMap A (Alg d n a) x) = g (algebraMap A (Alg d n a) x))
    (hX : ∀ i, f (mk d n a (X (Sum.inl i))) = g (mk d n a (X (Sum.inl i))))
    (hZ : ∀ i j, f (mk d n a (X (Sum.inr (i, j)))) = g (mk d n a (X (Sum.inr (i, j))))) :
    f = g := by
  have h : f.comp (mk d n a).toRingHom = g.comp (mk d n a).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, mk_C]
      exact hA x
    · rintro (i | ⟨i, j⟩)
      · exact hX i
      · exact hZ i j
  ext x
  obtain ⟨p, rfl⟩ := mk_surjective d n a x
  exact RingHom.congr_fun h p

end SmoothingLift

end Langlands.CommutativeAlgebra.Popescu.CharP
