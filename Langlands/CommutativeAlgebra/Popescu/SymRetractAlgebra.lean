import Langlands.MathlibBase

/-! # The symmetric-algebra retract of Stacks Lemma 3.1: definitions and basic identities -/

namespace Langlands.CommutativeAlgebra.Popescu.SymRetract

open MvPolynomial

variable {R : Type*} [CommRing R] {n m : ℕ}

/-- The inclusion of the variables `x_1, …, x_n` into `R[x_1, …, x_n, y_1, …, y_m]`. -/
noncomputable abbrev ιx : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + m)) R :=
  rename (Fin.castAdd m)

/-- The variable `y_j`. -/
noncomputable def yv (j : Fin m) : MvPolynomial (Fin (n + m)) R := X (Fin.natAdd n j)

theorem pderiv_rename_of_notMem_range' {σ' τ' R₀ : Type*} [CommSemiring R₀] [DecidableEq τ']
    {f : σ' → τ'} {v : τ'} (hv : v ∉ Set.range f) (p : MvPolynomial σ' R₀) :
    pderiv v (rename f p) = 0 := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p w hp =>
    rw [map_mul, Derivation.leibniz, hp, rename_X, pderiv_X_of_ne (fun h => hv ⟨w, h⟩)]
    simp

theorem pderiv_x_ιx (i : Fin n) (p : MvPolynomial (Fin n) R) :
    pderiv (Fin.castAdd m i) (ιx (m := m) p) = ιx (pderiv i p) :=
  pderiv_rename (Fin.castAdd_injective n m) i p

theorem pderiv_y_ιx (j : Fin m) (p : MvPolynomial (Fin n) R) :
    pderiv (Fin.natAdd n j) (ιx (m := m) p) = 0 := by
  apply pderiv_rename_of_notMem_range'
  rintro ⟨i, hi⟩
  have := congrArg Fin.val hi
  simp at this
  omega

theorem pderiv_x_yv (i : Fin n) (j : Fin m) :
    pderiv (Fin.castAdd m i) (yv (R := R) j) = 0 := by
  rw [yv, pderiv_X_of_ne]
  intro h
  have := congrArg Fin.val h
  simp at this
  omega

theorem pderiv_y_yv (j j' : Fin m) :
    pderiv (Fin.natAdd n j') (yv (R := R) j) = if j = j' then 1 else 0 := by
  split_ifs with h
  · subst h; rw [yv, pderiv_X_self]
  · rw [yv, pderiv_X_of_ne]
    intro h'
    exact h (Fin.natAdd_injective m n h')

/-- The relation `Σ_j κ_j y_j` attached to `κ`. -/
noncomputable def symGen (κ : Fin m → MvPolynomial (Fin n) R) : MvPolynomial (Fin (n + m)) R :=
  ∑ j, ιx (κ j) * yv j

/-- The ideal of `Sym(I/I²)` presented over `R[x, y]`: it is generated by `I` and by the elements
`Σ_j κ_j y_j` with `Σ_j κ_j f_j ∈ I²`. -/
noncomputable def symIdeal (I : Ideal (MvPolynomial (Fin n) R)) (F : Fin m → MvPolynomial (Fin n) R) :
    Ideal (MvPolynomial (Fin (n + m)) R) :=
  I.map (ιx (m := m)) ⊔ Ideal.span (symGen '' {κ | ∑ j, κ j * F j ∈ I ^ 2})

theorem ιx_mem_symIdeal (I : Ideal (MvPolynomial (Fin n) R)) (F : Fin m → MvPolynomial (Fin n) R)
    {p : MvPolynomial (Fin n) R} (hp : p ∈ I) : ιx (m := m) p ∈ symIdeal I F :=
  Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hp)

theorem ιx_mem_symIdeal_sq (I : Ideal (MvPolynomial (Fin n) R))
    (F : Fin m → MvPolynomial (Fin n) R) {p : MvPolynomial (Fin n) R} (hp : p ∈ I ^ 2) :
    ιx (m := m) p ∈ symIdeal I F ^ 2 := by
  have h1 : (I ^ 2).map (ιx (m := m)) ≤ symIdeal I F ^ 2 := by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr fun x hx =>
      Ideal.mem_comap.mpr (ιx_mem_symIdeal (m := m) I F hx)) 2
  exact h1 (Ideal.mem_map_of_mem _ hp)

theorem symGen_mem_symIdeal (I : Ideal (MvPolynomial (Fin n) R))
    (F : Fin m → MvPolynomial (Fin n) R) {κ : Fin m → MvPolynomial (Fin n) R}
    (hκ : ∑ j, κ j * F j ∈ I ^ 2) : symGen κ ∈ symIdeal I F :=
  Ideal.mem_sup_right (Ideal.subset_span ⟨κ, hκ, rfl⟩)

/-- Partial derivatives of elements of `I²` lie in `I`. -/
theorem pderiv_mem_of_mem_sq {σ : Type*} (I : Ideal (MvPolynomial σ R)) (i : σ)
    {p : MvPolynomial σ R} (hp : p ∈ I ^ 2) : pderiv i p ∈ I := by
  rw [pow_two] at hp
  refine Submodule.mul_induction_on hp (fun a ha b hb => ?_) (fun x y hx hy => ?_)
  · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact I.add_mem (I.mul_mem_right _ ha) (I.mul_mem_right _ hb)
  · rw [map_add]
    exact I.add_mem hx hy

end Langlands.CommutativeAlgebra.Popescu.SymRetract
