import Langlands.CommutativeAlgebra.Popescu.FaltingsSimpleStep
import Langlands.CommutativeAlgebra.Popescu.FieldH1CotangentInjectiveProof

/-! # Cartier's equality for extensions generated by `p`-th roots -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

namespace Faltings

open scoped TensorProduct

/-- `H₁` and `Ω` vanish when `M → L` is surjective. -/
theorem rank_eq_zero_of_surjective {M L : Type u} [Field M] [Field L] [Algebra M L]
    (h : Function.Surjective (algebraMap M L)) :
    Module.rank L (Algebra.H1Cotangent M L) = 0 ∧ Module.rank L Ω[L⁄M] = 0 := by
  have : Subsingleton Ω[L⁄M] := KaehlerDifferential.subsingleton_of_surjective M L h
  let e : M ≃ₐ[M] L := AlgEquiv.ofBijective (Algebra.ofId M L) ⟨(algebraMap M L).injective, h⟩
  have : Algebra.FormallyEtale M L := Algebra.FormallyEtale.of_equiv e
  exact ⟨rank_subsingleton' _ _, rank_subsingleton' _ _⟩

/-- **Additivity** of `dim H₁ − dim Ω` along a tower of fields `K → M → L`, from the six-term
Jacobi–Zariski sequence, whose left end is injective by Stacks 07E2. -/
theorem rank_tower {K M L : Type u} [Field K] [Field M] [Field L] [Algebra K M] [Algebra K L]
    [Algebra M L] [IsScalarTower K M L]
    (hM : Module.rank M (Algebra.H1Cotangent K M) = Module.rank M Ω[M⁄K])
    (hMf : Module.rank M Ω[M⁄K] < Cardinal.aleph0)
    (hL : Module.rank L (Algebra.H1Cotangent M L) = Module.rank L Ω[L⁄M])
    (hLf : Module.rank L Ω[L⁄M] < Cardinal.aleph0) :
    Module.rank L (Algebra.H1Cotangent K L) = Module.rank L Ω[L⁄K] ∧
      Module.rank L Ω[L⁄K] < Cardinal.aleph0 := by
  let f1 := (Algebra.H1Cotangent.map K K M L).liftBaseChange L
  let f2 := Algebra.H1Cotangent.map K M L L
  let f3 := Algebra.H1Cotangent.δ K M L
  let f4 := KaehlerDifferential.mapBaseChange K M L
  let f5 := KaehlerDifferential.map K M L L
  have hf1 : Function.Injective f1 := FieldH1.fieldH1CotangentInjective K M L
  have e12 : Function.Exact f1 f2 := Algebra.H1Cotangent.exact_liftBaseChange_map_of_flat K M L
  have e23 : Function.Exact f2 f3 := Algebra.H1Cotangent.exact_map_δ K M L
  have e34 : Function.Exact f3 f4 := Algebra.H1Cotangent.exact_δ_mapBaseChange K M L
  have e45 : Function.Exact f4 f5 := KaehlerDifferential.exact_mapBaseChange_map K M L
  have hf5 : Function.Surjective f5 := KaehlerDifferential.map_surjective K M L
  -- ranks of the base changes
  have hV1 : Module.rank L (L ⊗[M] Algebra.H1Cotangent K M) =
      Module.rank M (Algebra.H1Cotangent K M) := by
    rw [Module.rank_baseChange, Cardinal.lift_id]
  have hV4 : Module.rank L (L ⊗[M] Ω[M⁄K]) = Module.rank M Ω[M⁄K] := by
    rw [Module.rank_baseChange, Cardinal.lift_id]
  -- rank–nullity
  have R1 := LinearMap.rank_range_add_rank_ker f1
  have R2 := LinearMap.rank_range_add_rank_ker f2
  have R3 := LinearMap.rank_range_add_rank_ker f3
  have R4 := LinearMap.rank_range_add_rank_ker f4
  have R5 := LinearMap.rank_range_add_rank_ker f5
  rw [LinearMap.ker_eq_bot.mpr hf1, rank_bot, add_zero] at R1
  rw [e12.linearMap_ker_eq] at R2
  rw [e23.linearMap_ker_eq] at R3
  rw [e34.linearMap_ker_eq] at R4
  rw [e45.linearMap_ker_eq, LinearMap.range_eq_top.mpr hf5, rank_top] at R5
  -- everything is finite
  obtain ⟨a, ha⟩ := Cardinal.lt_aleph0.mp hMf
  obtain ⟨b, hb⟩ := Cardinal.lt_aleph0.mp hLf
  have hr1 : Module.rank L (LinearMap.range f1) = a := by
    rw [R1, hV1, hM, ha]
  have hV3 : Module.rank L (Algebra.H1Cotangent M L) = b := by rw [hL, hb]
  have hV4' : Module.rank L (L ⊗[M] Ω[M⁄K]) = a := by rw [hV4, ha]
  have hr2lt : Module.rank L (LinearMap.range f2) < Cardinal.aleph0 := by
    refine lt_of_le_of_lt (le_add_self.trans_eq R3) ?_
    rw [hV3]
    exact Cardinal.natCast_lt_aleph0
  have hr3lt : Module.rank L (LinearMap.range f3) < Cardinal.aleph0 := by
    refine lt_of_le_of_lt (le_add_self.trans_eq R4) ?_
    rw [hV4']
    exact Cardinal.natCast_lt_aleph0
  have hr4lt : Module.rank L (LinearMap.range f4) < Cardinal.aleph0 := by
    refine lt_of_le_of_lt (le_self_add.trans_eq R4) ?_
    rw [hV4']
    exact Cardinal.natCast_lt_aleph0
  obtain ⟨r2, hr2⟩ := Cardinal.lt_aleph0.mp hr2lt
  obtain ⟨r3, hr3⟩ := Cardinal.lt_aleph0.mp hr3lt
  obtain ⟨r4, hr4⟩ := Cardinal.lt_aleph0.mp hr4lt
  have hΩ : Module.rank L Ω[L⁄M] = b := hb
  rw [hr2, hr1] at R2
  rw [hr3, hr2, hV3] at R3
  rw [hr4, hr3, hV4'] at R4
  rw [hr4, hΩ] at R5
  rw [← R2, ← R5]
  refine ⟨?_, ?_⟩
  · norm_cast at R3 R4 ⊢
    omega
  · rw [← Nat.cast_add]
    exact Cardinal.natCast_lt_aleph0

/-- The generators of `F(S)` (as elements of `F(S)`) generate it as an algebra, when `S` is
algebraic. -/
theorem adjoin_subtype_eq_top {K L : Type u} [Field K] [Field L] [Algebra K L] {n : ℕ}
    (β : Fin n → L) (halg : ∀ j, IsAlgebraic K (β j)) :
    Algebra.adjoin K (Set.range fun j =>
      (⟨β j, IntermediateField.subset_adjoin K _ ⟨j, rfl⟩⟩ :
        IntermediateField.adjoin K (Set.range β))) = ⊤ := by
  let M := IntermediateField.adjoin K (Set.range β)
  apply Subalgebra.map_injective (f := M.val) M.val.toRingHom.injective
  rw [AlgHom.map_adjoin, Algebra.map_top, IntermediateField.range_val, ← Set.range_comp]
  refine (IntermediateField.adjoin_toSubalgebra_of_isAlgebraic ?_).symm
  rintro x ⟨j, rfl⟩
  exact halg j

/-- If `K[α₀, …, α_n] = L` and `M ⊇ K` contains `α₀, …, α_{n-1}`, then `M[α_n] = L`. -/
theorem adjoin_last_eq_top {K M L : Type u} [Field K] [Field M] [Field L] [Algebra K M]
    [Algebra K L] [Algebra M L] [IsScalarTower K M L] {n : ℕ} (α : Fin (n + 1) → L)
    (hgen : Algebra.adjoin K (Set.range α) = ⊤)
    (hM : ∀ i : Fin n, α i.castSucc ∈ Set.range (algebraMap M L)) :
    Algebra.adjoin M {α (Fin.last n)} = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  have hx : x ∈ Algebra.adjoin K (Set.range α) := hgen ▸ Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨j, rfl⟩ := hy
    rcases Fin.eq_castSucc_or_eq_last j with ⟨i, rfl⟩ | rfl
    · obtain ⟨m, hm⟩ := hM i
      rw [← hm]
      exact Subalgebra.algebraMap_mem _ m
    · exact Algebra.subset_adjoin (Set.mem_singleton _)
  | algebraMap r =>
    rw [IsScalarTower.algebraMap_apply K M L]
    exact Subalgebra.algebraMap_mem _ _
  | add _ _ _ _ h1 h2 => exact add_mem h1 h2
  | mul _ _ _ _ h1 h2 => exact mul_mem h1 h2

set_option maxHeartbeats 1000000 in
/-- **Cartier's equality for `p`-root extensions.** If `L/K` (characteristic `p`) is generated as a
`K`-algebra by finitely many elements whose `p`-th powers lie in `K`, then `H₁(L_{L/K})` and
`Ω_{L/K}` have the same finite dimension over `L`. -/
theorem rank_eq_of_pRoots (p : ℕ) [Fact p.Prime] {K : Type u} [Field K] [CharP K p] :
    ∀ (n : ℕ) (L : Type u) [Field L] [Algebra K L] (α : Fin n → L),
      Algebra.adjoin K (Set.range α) = ⊤ → (∀ j, α j ^ p ∈ Set.range (algebraMap K L)) →
      Module.rank L (Algebra.H1Cotangent K L) = Module.rank L Ω[L⁄K] ∧
        Module.rank L Ω[L⁄K] < Cardinal.aleph0 := by
  intro n
  induction n with
  | zero =>
    intro L _ _ α hgen _
    have hsurj : Function.Surjective (algebraMap K L) := by
      intro x
      have hx : x ∈ Algebra.adjoin K (Set.range α) := hgen ▸ Algebra.mem_top
      rw [Set.range_eq_empty, Algebra.adjoin_empty] at hx
      exact Algebra.mem_bot.mp hx
    obtain ⟨h1, h2⟩ := rank_eq_zero_of_surjective hsurj
    exact ⟨h1.trans h2.symm, h2 ▸ Cardinal.aleph0_pos⟩
  | succ n ih =>
    intro L _ _ α hgen hroots
    let β : Fin n → L := fun j => α j.castSucc
    let γ : L := α (Fin.last n)
    have hint : ∀ j, IsIntegral K (α j) := by
      intro j
      obtain ⟨c, hc⟩ := hroots j
      refine ⟨Polynomial.X ^ p - Polynomial.C c,
        Polynomial.monic_X_pow_sub_C c (Fact.out : p.Prime).ne_zero, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hc, sub_self]
    let M : IntermediateField K L := IntermediateField.adjoin K (Set.range β)
    let β' : Fin n → M := fun j => ⟨β j, IntermediateField.subset_adjoin K _ ⟨j, rfl⟩⟩
    have hMgen : Algebra.adjoin K (Set.range β') = ⊤ :=
      adjoin_subtype_eq_top β (fun j => (hint j.castSucc).isAlgebraic)
    have hMroots : ∀ j, β' j ^ p ∈ Set.range (algebraMap K M) := by
      intro j
      obtain ⟨c, hc⟩ := hroots j.castSucc
      exact ⟨c, Subtype.ext hc⟩
    obtain ⟨hM, hMf⟩ := ih M β' hMgen hMroots
    have : CharP M p := charP_of_injective_algebraMap' K p
    have hLgen : Algebra.adjoin M {γ} = ⊤ :=
      adjoin_last_eq_top (M := M) α hgen (fun i => ⟨β' i, rfl⟩)
    obtain ⟨c, hc⟩ := hroots (Fin.last n)
    have hc' : γ ^ p = algebraMap M L (algebraMap K M c) := by
      rw [← IsScalarTower.algebraMap_apply]
      exact hc.symm
    have hL : Module.rank L (Algebra.H1Cotangent M L) = Module.rank L Ω[L⁄M] ∧
        Module.rank L Ω[L⁄M] < Cardinal.aleph0 := by
      by_cases hγ : γ ∈ Set.range (algebraMap M L)
      · have hsurj : Function.Surjective (algebraMap M L) := by
          intro x
          have hx : x ∈ Algebra.adjoin M {γ} := hLgen ▸ Algebra.mem_top
          have hle : Algebra.adjoin M {γ} ≤ ⊥ := by
            rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
            exact Algebra.mem_bot.mpr hγ
          exact Algebra.mem_bot.mp (hle hx)
        obtain ⟨h1, h2⟩ := rank_eq_zero_of_surjective hsurj
        exact ⟨h1.trans h2.symm, h2 ▸ Cardinal.aleph0_pos⟩
      · obtain ⟨h1, h2⟩ := rank_simple_step p γ hLgen hγ (algebraMap K M c) hc'
        exact ⟨h1.trans h2.symm, h2 ▸ Cardinal.one_lt_aleph0⟩
    exact rank_tower hM hMf hL.1 hL.2

end Faltings

end Langlands.CommutativeAlgebra.Popescu
