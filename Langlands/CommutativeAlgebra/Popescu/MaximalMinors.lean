import Langlands.MathlibBase

/-! # Determinants of products and maximal minors (Cauchy–Binet inclusion) -/

namespace Langlands.CommutativeAlgebra.Popescu

open Matrix Equiv

variable {S : Type*} [CommRing S] {c N : ℕ}

/-- The determinant of `A` with columns chosen by an injective map lies in the ideal generated by
the maximal minors of `A` taken along order embeddings. -/
theorem det_submatrix_mem_span_minors (A : Matrix (Fin c) (Fin N) S) (σ : Fin c → Fin N)
    (hσ : Function.Injective σ) :
    (A.submatrix id σ).det ∈
      Ideal.span (Set.range fun e : Fin c ↪o Fin N => (A.submatrix id e).det) := by
  classical
  set s : Finset (Fin N) := Finset.univ.image σ
  have hs : s.card = c := by
    rw [Finset.card_image_of_injective _ hσ, Finset.card_univ, Fintype.card_fin]
  set e := s.orderEmbOfFin hs
  have hmem : ∀ i, ∃ j, e j = σ i := fun i => by
    have : σ i ∈ Set.range e := by
      rw [Finset.range_orderEmbOfFin]
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem σ (Finset.mem_univ i))
    exact this
  choose π hπ using hmem
  have hπinj : Function.Injective π := fun i j h => hσ (by rw [← hπ i, ← hπ j, h])
  let πe : Perm (Fin c) := Equiv.ofBijective π (Finite.injective_iff_bijective.mp hπinj)
  have hsub : A.submatrix id σ = (A.submatrix id e).submatrix id πe := by
    ext i j
    simp [πe, hπ]
  rw [hsub, det_permute']
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨e, rfl⟩)

/-- The determinant of `A * B` (with `A` of size `c × N`) lies in the ideal of maximal minors
of `A`. This is the inclusion given by the Cauchy–Binet formula. -/
theorem det_mul_mem_span_minors (A : Matrix (Fin c) (Fin N) S) (B : Matrix (Fin N) (Fin c) S) :
    (A * B).det ∈
      Ideal.span (Set.range fun e : Fin c ↪o Fin N => (A.submatrix id e).det) := by
  classical
  have hexp : (A * B).det =
      ∑ σ : Fin c → Fin N, (∏ i, B (σ i) i) * (A.submatrix id σ).det := by
    simp only [det_apply, mul_apply, Finset.mul_sum, submatrix_apply, id]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [Finset.prod_univ_sum, Fintype.piFinset_univ, Finset.smul_sum]
    refine Finset.sum_congr rfl fun σ _ => ?_
    rw [Finset.prod_mul_distrib, mul_comm (∏ i, B (σ i) i), smul_mul_assoc]
  rw [hexp]
  refine Ideal.sum_mem _ fun σ _ => Ideal.mul_mem_left _ _ ?_
  by_cases hσ : Function.Injective σ
  · exact det_submatrix_mem_span_minors A σ hσ
  · obtain ⟨i, j, hij, hne⟩ : ∃ i j, σ i = σ j ∧ i ≠ j := by
      simp only [Function.Injective, not_forall] at hσ
      obtain ⟨i, j, h, hne⟩ := hσ
      exact ⟨i, j, h, hne⟩
    rw [det_zero_of_column_eq hne fun k => by simp [hij]]
    exact Ideal.zero_mem _

/-- If `A * B = t • 1` for a `c × N` matrix `A`, then `t ^ c` lies in the ideal of maximal minors
of `A`. -/
theorem pow_mem_span_minors_of_mul_eq (A : Matrix (Fin c) (Fin N) S) (B : Matrix (Fin N) (Fin c) S)
    (t : S) (h : A * B = t • (1 : Matrix (Fin c) (Fin c) S)) :
    t ^ c ∈ Ideal.span (Set.range fun e : Fin c ↪o Fin N => (A.submatrix id e).det) := by
  have := det_mul_mem_span_minors A B
  rwa [h, det_smul, det_one, mul_one, Fintype.card_fin] at this

end Langlands.CommutativeAlgebra.Popescu
