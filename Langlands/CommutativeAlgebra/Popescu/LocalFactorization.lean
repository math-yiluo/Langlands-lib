import Langlands.MathlibBase

/-! # Factoring a finitely presented map into `Λ_q` through a finite-level localization -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

open MvPolynomial

/-- Elements of the submonoid generated by a set of units are units. -/
theorem isUnit_of_mem_closure {Λ L : Type*} [CommRing Λ] [CommRing L] (g : Λ →+* L) {s : Set Λ}
    (hs : ∀ x ∈ s, IsUnit (g x)) {x : Λ} (hx : x ∈ Submonoid.closure s) : IsUnit (g x) := by
  have : Submonoid.closure s ≤ (IsUnit.submonoid L).comap g.toMonoidHom := by
    rw [Submonoid.closure_le]
    intro y hy
    exact hs y hy
  exact this hx

/-- A divisor of a unit image is a unit image. -/
theorem isUnit_of_dvd' {Λ L : Type*} [CommRing Λ] [CommRing L] (g : Λ →+* L) {x y : Λ}
    (h : x ∣ y) (hy : IsUnit (g y)) : IsUnit (g x) := by
  obtain ⟨z, rfl⟩ := h
  rw [map_mul] at hy
  exact isUnit_of_mul_isUnit_left hy

/-- A finitely presented `R_p`-algebra map into `Λ_q` (compatible with `f : A → Λ`) factors through
the localization of `Λ` at any submonoid containing the image of `R \ p` and a suitable `ℓ ∉ q`. -/
theorem exists_localization_factor {R A Λ T : Type u} [CommRing R] [CommRing A] [CommRing Λ]
    [CommRing T] [Algebra R A] [Algebra R Λ] [Algebra.FiniteType R A] (f : A →ₐ[R] Λ)
    (q : Ideal Λ) [q.IsPrime] [Algebra (Localization.AtPrime (q.comap (algebraMap R Λ))) T]
    [Algebra.FinitePresentation (Localization.AtPrime (q.comap (algebraMap R Λ))) T]
    (u : A →+* T) (v : T →+* Localization.AtPrime q)
    (hu : u.comp (algebraMap R A) =
      (algebraMap (Localization.AtPrime (q.comap (algebraMap R Λ))) T).comp (algebraMap R _))
    (hv : v.comp u = (algebraMap Λ (Localization.AtPrime q)).comp f.toRingHom) :
    ∃ ℓ ∉ q, ∀ M : Submonoid Λ,
      (∀ s ∈ (q.comap (algebraMap R Λ)).primeCompl, algebraMap R Λ s ∈ M) → ℓ ∈ M →
      M ≤ q.primeCompl →
      ∃ w : T →+* Localization M, w.comp u = (algebraMap Λ (Localization M)).comp f.toRingHom := by
  classical
  set p := q.comap (algebraMap R Λ)
  set Rp := Localization.AtPrime p
  set Lq := Localization.AtPrime q
  have hpq : ∀ s ∈ p.primeCompl, algebraMap R Λ s ∈ q.primeCompl := fun s hs => hs
  have hvR : ∀ r : R, v (algebraMap Rp T (algebraMap R Rp r)) =
      algebraMap Λ Lq (algebraMap R Λ r) := fun r => by
    have h1 : u (algebraMap R A r) = algebraMap Rp T (algebraMap R Rp r) := RingHom.congr_fun hu r
    rw [← h1]
    have h2 := RingHom.congr_fun hv (algebraMap R A r)
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
      AlgHom.coe_toRingHom, f.commutes] at h2
    exact h2
  -- a presentation of `T`
  obtain ⟨N, P, hP, hPfg⟩ := Algebra.FinitePresentation.out (R := Rp) (A := T)
  obtain ⟨m, G, hG⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hPfg
  have hGker : ∀ j, P (G j) = 0 := fun j => by
    have : G j ∈ RingHom.ker P.toRingHom := by rw [← hG]; exact Submodule.subset_span ⟨j, rfl⟩
    exact this
  -- generators of `A`
  obtain ⟨K, ψA, hψA⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  -- the values of `v` on the generators of `T`
  have hw' : ∀ i : Fin N, ∃ (a : Λ) (w : q.primeCompl), IsLocalization.mk' Lq a w = v (P (X i)) :=
    fun i => by
      obtain ⟨⟨a, w⟩, h⟩ := IsLocalization.mk'_surjective q.primeCompl (v (P (X i)))
      exact ⟨a, w, h⟩
  choose a w hw using hw'
  set ℓ₁ : Λ := ∏ i, (w i : Λ)
  have hℓ₁ : ℓ₁ ∈ q.primeCompl := q.primeCompl.prod_mem fun i _ => (w i).2
  set M₀ : Submonoid Λ := Submonoid.closure (algebraMap R Λ '' p.primeCompl ∪ {ℓ₁})
  have hM₀ : M₀ ≤ q.primeCompl := by
    rw [Submonoid.closure_le]
    rintro x (⟨s, hs, rfl⟩ | hx)
    · exact hpq s hs
    · rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hℓ₁
  set L₀ := Localization M₀
  have hu₀ : ∀ x ∈ M₀, IsUnit (algebraMap Λ L₀ x) := fun x hx =>
    IsLocalization.map_units L₀ (⟨x, hx⟩ : M₀)
  have hwu : ∀ i, IsUnit (algebraMap Λ L₀ (w i)) := fun i =>
    isUnit_of_dvd' _ (Finset.dvd_prod_of_mem (fun i => (w i : Λ)) (Finset.mem_univ i))
      (hu₀ ℓ₁ (Submonoid.subset_closure (Or.inr rfl)))
  let can₀ : Rp →+* L₀ := IsLocalization.lift (M := p.primeCompl)
    (g := (algebraMap Λ L₀).comp (algebraMap R Λ))
    (fun s => hu₀ _ (Submonoid.subset_closure (Or.inl ⟨s, s.2, rfl⟩)))
  have hcan₀ : ∀ r, can₀ (algebraMap R Rp r) = algebraMap Λ L₀ (algebraMap R Λ r) :=
    fun r => IsLocalization.lift_eq _ r
  let xval₀ : Fin N → L₀ := fun i => algebraMap Λ L₀ (a i) * ↑(hwu i).unit⁻¹
  let ε₀ : MvPolynomial (Fin N) Rp →+* L₀ := eval₂Hom can₀ xval₀
  let κ₀ : L₀ →+* Lq := IsLocalization.lift (M := M₀) (g := algebraMap Λ Lq)
    (fun x => IsLocalization.map_units Lq (⟨x, hM₀ x.2⟩ : q.primeCompl))
  have hκ₀ : ∀ y, κ₀ (algebraMap Λ L₀ y) = algebraMap Λ Lq y := fun y => IsLocalization.lift_eq _ y
  have hK1 : κ₀.comp ε₀ = v.comp P.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro r
      have h : κ₀.comp can₀ = v.comp (algebraMap Rp T) := by
        apply IsLocalization.ringHom_ext p.primeCompl
        ext r
        simp only [RingHom.coe_comp, Function.comp_apply, hcan₀, hκ₀, hvR]
      have := RingHom.congr_fun h r
      simp only [RingHom.coe_comp, Function.comp_apply] at this ⊢
      simp only [ε₀, eval₂Hom_C, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      rw [this, ← MvPolynomial.algebraMap_eq, P.commutes]
    · intro i
      simp only [RingHom.coe_comp, Function.comp_apply, ε₀, eval₂Hom_X', xval₀, map_mul,
        AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, hκ₀]
      rw [← hw i]
      have hwq : IsUnit (algebraMap Λ Lq (w i)) := IsLocalization.map_units Lq (w i)
      rw [← hwq.mul_left_inj, IsLocalization.mk'_spec, mul_assoc,
        show κ₀ ↑(hwu i).unit⁻¹ * algebraMap Λ Lq (w i) = 1 by
          rw [← hκ₀, ← map_mul, IsUnit.val_inv_mul, map_one], mul_one]
  let _ : Algebra L₀ Lq := κ₀.toAlgebra
  have : IsScalarTower Λ L₀ Lq := .of_algebraMap_eq fun x => (hκ₀ x).symm
  have hloc : IsLocalization (q.primeCompl.map (algebraMap Λ L₀)) Lq :=
    IsLocalization.isLocalization_of_submonoid_le L₀ Lq M₀ q.primeCompl hM₀
  have hzero : ∀ y : L₀, κ₀ y = 0 → ∃ c ∈ q.primeCompl, algebraMap Λ L₀ c * y = 0 := by
    intro y hy
    obtain ⟨⟨_, ⟨c, hc, rfl⟩⟩, h⟩ :=
      (IsLocalization.map_eq_zero_iff (q.primeCompl.map (algebraMap Λ L₀)) Lq y).mp hy
    exact ⟨c, hc, h⟩
  have hrel : ∀ j, ∃ c ∈ q.primeCompl, algebraMap Λ L₀ c * ε₀ (G j) = 0 := fun j =>
    hzero _ (by
      rw [← RingHom.comp_apply κ₀ ε₀, hK1, RingHom.comp_apply]
      simp [hGker])
  choose c hc hcz using hrel
  choose z hz using fun k => hP (u (ψA (X k)))
  have hA : ∀ k, ∃ c' ∈ q.primeCompl, algebraMap Λ L₀ c' *
      (ε₀ (z k) - algebraMap Λ L₀ (f (ψA (X k)))) = 0 := fun k => hzero _ (by
    rw [map_sub, ← RingHom.comp_apply κ₀ ε₀, hK1, RingHom.comp_apply, hκ₀]
    simp only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, hz]
    have := RingHom.congr_fun hv (ψA (X k))
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
      AlgHom.coe_toRingHom] at this
    rw [this, sub_self])
  choose c' hc' hcz' using hA
  refine ⟨ℓ₁ * (∏ j, c j) * ∏ k, c' k, ?_, ?_⟩
  · exact q.primeCompl.mul_mem (q.primeCompl.mul_mem hℓ₁
      (q.primeCompl.prod_mem fun j _ => hc j)) (q.primeCompl.prod_mem fun k _ => hc' k)
  intro M hMp hℓM hMq
  set L := Localization M
  set ℓ := ℓ₁ * (∏ j, c j) * ∏ k, c' k
  have huL : ∀ x ∈ M, IsUnit (algebraMap Λ L x) := fun x hx =>
    IsLocalization.map_units L (⟨x, hx⟩ : M)
  have hdvd : ∀ x, x ∣ ℓ → IsUnit (algebraMap Λ L x) := fun x hx =>
    isUnit_of_dvd' _ hx (huL ℓ hℓM)
  have hℓ₁d : ℓ₁ ∣ ℓ := ⟨(∏ j, c j) * ∏ k, c' k, by
    show ℓ₁ * (∏ j, c j) * ∏ k, c' k = _
    rw [mul_assoc]⟩
  have hcd : ∀ j, c j ∣ ℓ := fun j =>
    Dvd.dvd.mul_right (Dvd.dvd.mul_left (Finset.dvd_prod_of_mem c (Finset.mem_univ j)) ℓ₁) _
  have hc'd : ∀ k, c' k ∣ ℓ := fun k =>
    Dvd.dvd.mul_left (Finset.dvd_prod_of_mem c' (Finset.mem_univ k)) _
  let ι : L₀ →+* L := IsLocalization.lift (M := M₀) (g := algebraMap Λ L) (fun x =>
    isUnit_of_mem_closure (algebraMap Λ L) (s := algebraMap R Λ '' p.primeCompl ∪ {ℓ₁}) (by
      rintro y (⟨s, hs, rfl⟩ | hy)
      · exact huL _ (hMp s hs)
      · rw [Set.mem_singleton_iff] at hy; rw [hy]; exact hdvd _ hℓ₁d) x.2)
  have hι : ∀ y, ι (algebraMap Λ L₀ y) = algebraMap Λ L y := fun y => IsLocalization.lift_eq _ y
  let ε : MvPolynomial (Fin N) Rp →+* L := ι.comp ε₀
  have hεG : ∀ j, ε (G j) = 0 := fun j => by
    have h1 := congrArg ι (hcz j)
    rw [map_mul, map_zero, hι] at h1
    exact ((hdvd (c j) (hcd j)).mul_right_eq_zero).mp h1
  have hker : RingHom.ker P.toRingHom ≤ RingHom.ker ε := by
    rw [← hG, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact hεG j
  let wmap : T →+* L := RingHom.liftOfRightInverse P.toRingHom (Function.surjInv hP)
    (Function.rightInverse_surjInv hP) ⟨ε, hker⟩
  have hwP : ∀ x, wmap (P x) = ε x := fun x =>
    RingHom.liftOfRightInverse_comp_apply _ _ _ _ x
  refine ⟨wmap, ?_⟩
  have key : (wmap.comp u).comp ψA.toRingHom =
      ((algebraMap Λ L).comp f.toRingHom).comp ψA.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        AlgHom.coe_toRingHom]
      rw [show ψA (C r) = algebraMap R A r from ψA.commutes r,
        show u (algebraMap R A r) = algebraMap Rp T (algebraMap R Rp r) from
          RingHom.congr_fun hu r, ← P.commutes, hwP, f.commutes]
      simp only [ε, RingHom.coe_comp, Function.comp_apply, ε₀, MvPolynomial.algebraMap_eq,
        eval₂Hom_C, hcan₀, hι]
    · intro k
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        AlgHom.coe_toRingHom]
      rw [← hz k, hwP]
      have h1 := congrArg ι (hcz' k)
      rw [map_mul, map_zero, hι] at h1
      have h2 := ((hdvd (c' k) (hc'd k)).mul_right_eq_zero).mp h1
      rw [map_sub, sub_eq_zero, hι] at h2
      exact h2
  exact RingHom.ext fun x => by
    obtain ⟨y, rfl⟩ := hψA x
    exact RingHom.congr_fun key y

end Langlands.CommutativeAlgebra.Popescu
