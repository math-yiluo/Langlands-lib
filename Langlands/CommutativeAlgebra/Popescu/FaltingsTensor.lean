import Langlands.CommutativeAlgebra.Popescu.FaltingsRootKernel

/-! # The presentation of `A ⊗_k k(β)` over `A` -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

namespace Faltings

open MvPolynomial

open scoped TensorProduct

variable {k A L : Type u} [Field k] [CommRing A] [Algebra k A] [Field L] [Algebra k L] {n : ℕ}
  (β : Fin n → L)

theorem aeval_one_tmul_eq (f : MvPolynomial (Fin n) A) :
    aeval (fun j => (1 : A) ⊗ₜ[k] β j) f =
      Algebra.TensorProduct.map (AlgHom.id k A) (aeval β : MvPolynomial (Fin n) k →ₐ[k] L)
        ((algebraTensorAlgEquiv k A).symm f) := by
  have : ((aeval fun j => (1 : A) ⊗ₜ[k] β j : MvPolynomial (Fin n) A →ₐ[A] A ⊗[k] L) :
      MvPolynomial (Fin n) A →+* A ⊗[k] L) =
      ((Algebra.TensorProduct.map (AlgHom.id k A) (aeval β : MvPolynomial (Fin n) k →ₐ[k] L) :
        A ⊗[k] MvPolynomial (Fin n) k →+* A ⊗[k] L)).comp
        ((algebraTensorAlgEquiv (σ := Fin n) k A).symm.toAlgHom.toRingHom) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      have h1 : (algebraTensorAlgEquiv (σ := Fin n) k A).symm (C c) = c ⊗ₜ[k] 1 := by
        rw [MvPolynomial.C_apply, algebraTensorAlgEquiv_symm_monomial, ← MvPolynomial.C_apply,
          map_one]
      simp only [RingHom.coe_coe, aeval_C, RingHom.coe_comp, Function.comp_apply,
        AlgHom.toRingHom_eq_coe, AlgEquiv.coe_toAlgHom, h1, Algebra.TensorProduct.map_tmul,
        AlgHom.id_apply, map_one, Algebra.TensorProduct.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply]
    · intro j
      simp
  exact congrArg (fun φ : MvPolynomial (Fin n) A →+* A ⊗[k] L => φ f) this

theorem aeval_one_tmul_surjective
    (hsurj : Function.Surjective (aeval β : MvPolynomial (Fin n) k →ₐ[k] L)) :
    Function.Surjective (aeval (fun j => (1 : A) ⊗ₜ[k] β j) :
      MvPolynomial (Fin n) A →ₐ[A] A ⊗[k] L) := by
  intro y
  have hΦ : Function.Surjective (Algebra.TensorProduct.map (AlgHom.id k A)
      (aeval β : MvPolynomial (Fin n) k →ₐ[k] L)) :=
    LinearMap.lTensor_surjective A (g := (aeval β : MvPolynomial (Fin n) k →ₐ[k] L).toLinearMap)
      hsurj
  obtain ⟨x, rfl⟩ := hΦ y
  refine ⟨algebraTensorAlgEquiv k A x, ?_⟩
  rw [aeval_one_tmul_eq, AlgEquiv.symm_apply_apply]

/-- The kernel of `A[x] → A ⊗_k L`, `x_j ↦ 1 ⊗ β_j`, is generated by `x_j^p − a_j` when the
kernel of `k[x] → L` is. -/
theorem ker_aeval_one_tmul (p : ℕ) (a : Fin n → k)
    (hsurj : Function.Surjective (aeval β : MvPolynomial (Fin n) k →ₐ[k] L))
    (hker : RingHom.ker (aeval β : MvPolynomial (Fin n) k →ₐ[k] L) = rootIdeal p a) :
    RingHom.ker (aeval (fun j => (1 : A) ⊗ₜ[k] β j) : MvPolynomial (Fin n) A →ₐ[A] A ⊗[k] L) =
      rootIdeal p (fun j => algebraMap k A (a j)) := by
  let e := algebraTensorAlgEquiv (σ := Fin n) k A
  let Φ := Algebra.TensorProduct.map (AlgHom.id k A) (aeval β : MvPolynomial (Fin n) k →ₐ[k] L)
  have hΦ : RingHom.ker Φ = (rootIdeal p a).map
      (Algebra.TensorProduct.includeRight : MvPolynomial (Fin n) k →ₐ[k] A ⊗[k] _) := by
    rw [Algebra.TensorProduct.lTensor_ker _ hsurj, hker]
  have himg : (rootIdeal p a).map
      ((e : A ⊗[k] MvPolynomial (Fin n) k →+* MvPolynomial (Fin n) A).comp
        (Algebra.TensorProduct.includeRight : MvPolynomial (Fin n) k →ₐ[k] A ⊗[k] _).toRingHom) =
      rootIdeal p (fun j => algebraMap k A (a j)) := by
    have hcomp : (e : A ⊗[k] MvPolynomial (Fin n) k →+* MvPolynomial (Fin n) A).comp
        (Algebra.TensorProduct.includeRight : MvPolynomial (Fin n) k →ₐ[k] A ⊗[k] _).toRingHom =
        MvPolynomial.map (algebraMap k A) := by
      ext x
      · simp [e]
      · simp [e]
    rw [hcomp, Ideal.map_span, ← Set.range_comp]
    congr 1
    ext x
    simp
  ext f
  rw [RingHom.mem_ker, aeval_one_tmul_eq, ← himg, ← Ideal.map_map]
  change (e.symm f) ∈ RingHom.ker Φ ↔ _
  rw [hΦ]
  constructor
  · intro h
    have := Ideal.mem_map_of_mem (e : A ⊗[k] MvPolynomial (Fin n) k →+* MvPolynomial (Fin n) A) h
    rwa [show (e : A ⊗[k] MvPolynomial (Fin n) k →+* MvPolynomial (Fin n) A) (e.symm f) = f from
      e.apply_symm_apply f] at this
  · intro h
    have := Ideal.mem_map_of_mem
      (e.symm : MvPolynomial (Fin n) A →+* A ⊗[k] MvPolynomial (Fin n) k) h
    rwa [Ideal.map_map, show (e.symm : MvPolynomial (Fin n) A →+* A ⊗[k] _).comp
        (e : A ⊗[k] MvPolynomial (Fin n) k →+* MvPolynomial (Fin n) A) = RingHom.id _ from
      RingHom.ext fun x => e.symm_apply_apply x, Ideal.map_id] at this

end Faltings

end Langlands.CommutativeAlgebra.Popescu
