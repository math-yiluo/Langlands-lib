import Langlands.CommutativeAlgebra.Popescu.RegularParameterExtensionStatement
import Langlands.CommutativeAlgebra.Popescu.RegularSequenceFlatStatement
import Langlands.CommutativeAlgebra.Popescu.RegularLocalParametersStatement
import Langlands.CommutativeAlgebra.Popescu.RegularSequenceFlat
import Langlands.CommutativeAlgebra.Popescu.RegularLocalParametersProof
import Langlands.Algebra.IdealLocalFlatnessCriterion
import Langlands.Algebra.NoetherianFiberwiseFlatness
import Langlands.CommutativeAlgebra.Popescu.RegularParameterTools
import Langlands.CommutativeAlgebra.Popescu.RegularParameterFibre

/-! # Adding variables that map to a regular system of parameters of the closed fibre -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

namespace RegularParameter

open MvPolynomial IsLocalRing

open scoped TensorProduct

/-- The "property (1)" step of Stacks 07FH, from Stacks 07DY (`RegularSequenceFlatStatement`) and
00NQ (`RegularLocalParametersStatement`). -/
theorem regularParameterExtension_of (hN3 : RegularSequenceFlatStatement.{u})
    (h00NQ : RegularLocalParametersStatement.{u}) : RegularParameterExtensionStatement.{u} := by
  intro k Λ _ _ _ _ q _ t r φ 𝔭₀ _ h₀ hflat₀ _ hz hrank hgen 𝔭 _ h𝔭
  classical
  -- notation
  let ρR : MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k :=
    ((rename (Fin.castAdd r) : MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
      MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)
  let I₀ : Ideal (Localization.AtPrime q) :=
    𝔭₀.map ((algebraMap Λ (Localization.AtPrime q)).comp
      (φ.comp (rename (Fin.castAdd r)) : MvPolynomial (Fin t) k →+* Λ))
  let g : Localization.AtPrime 𝔭 →+* Localization.AtPrime q := Localization.localRingHom 𝔭 q φ h𝔭
  let g₀ : Localization.AtPrime 𝔭₀ →+* Localization.AtPrime q :=
    Localization.localRingHom 𝔭₀ q (φ.comp (rename (Fin.castAdd r))) h₀
  have hρ : 𝔭₀ = 𝔭.comap ρR := by rw [h₀, h𝔭]; rfl
  let i₀ : Localization.AtPrime 𝔭₀ →+* Localization.AtPrime 𝔭 :=
    Localization.localRingHom 𝔭₀ 𝔭 ρR hρ
  have htower : g.comp i₀ = g₀ := by
    apply IsLocalization.ringHom_ext 𝔭₀.primeCompl
    refine RingHom.ext fun y => ?_
    simp only [RingHom.coe_comp, Function.comp_apply, i₀, g, g₀,
      Localization.localRingHom_to_map]
    rfl
  -- the prime `𝔭` is generated by `𝔭₀` and the `z_j`
  have h𝔭eq : 𝔭 = extIdeal k t r 𝔭₀ ⊔ Ideal.span (Set.range (zVar k t r)) := by
    rw [h𝔭, h₀]
    exact comap_eq_map_sup_span k t r q φ hz
  -- the second conclusion
  have hmaxq : 𝔭.map ((algebraMap Λ (Localization.AtPrime q)).comp
      (φ : MvPolynomial (Fin (t + r)) k →+* Λ)) = maximalIdeal (Localization.AtPrime q) := by
    have h1 : (extIdeal k t r 𝔭₀).map ((algebraMap Λ (Localization.AtPrime q)).comp
        (φ : MvPolynomial (Fin (t + r)) k →+* Λ)) = I₀ := by
      rw [Ideal.map_map]
      rfl
    have h2 : (Ideal.span (Set.range (zVar k t r))).map ((algebraMap Λ (Localization.AtPrime q)).comp
        (φ : MvPolynomial (Fin (t + r)) k →+* Λ)) =
        Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime q) (φ (zVar k t r j))) := by
      rw [Ideal.map_span, ← Set.range_comp]
      rfl
    rw [h𝔭eq, Ideal.map_sup, h1, h2]
    have h3 := Ideal.comap_map_of_surjective (Ideal.Quotient.mk I₀) Ideal.Quotient.mk_surjective
      (Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime q) (φ (zVar k t r j))))
    rw [Ideal.map_span, ← Set.range_comp] at h3
    have h4 : Ideal.span (Set.range ((Ideal.Quotient.mk I₀) ∘
        fun j => algebraMap Λ (Localization.AtPrime q) (φ (zVar k t r j)))) =
        maximalIdeal (Localization.AtPrime q ⧸ I₀) := hgen
    have h5 : (maximalIdeal (Localization.AtPrime q ⧸ I₀)).comap (Ideal.Quotient.mk I₀) =
        maximalIdeal (Localization.AtPrime q) :=
      IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
    rw [h4, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, h5] at h3
    rw [h3, sup_comm]
  refine ⟨?_, hmaxq⟩
  -- flatness by the local flatness criterion along `J = 𝔭₀ B`
  let _ : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime q) := g.toAlgebra
  let J : Ideal (Localization.AtPrime 𝔭) :=
    (extIdeal k t r 𝔭₀).map (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭))
  have hmaxB : maximalIdeal (Localization.AtPrime 𝔭) =
      J ⊔ Ideal.span (Set.range fun j =>
        algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭) (zVar k t r j)) := by
    have h1 := congrArg
      (Ideal.map (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭))) h𝔭eq
    rw [Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_sup, Ideal.map_span,
      ← Set.range_comp] at h1
    exact h1
  have hJle : J ≤ maximalIdeal (Localization.AtPrime 𝔭) := by
    rw [hmaxB]
    exact le_sup_left
  have hJtop : J ≠ ⊤ := ne_top_of_le_ne_top (maximalIdeal.isMaximal _).ne_top hJle
  -- (ii) injectivity of `J ⊗ Λ_q → Λ_q`, from flatness over `B₀`
  let _ : Algebra (Localization.AtPrime 𝔭₀) (Localization.AtPrime 𝔭) := i₀.toAlgebra
  let _ : Algebra (Localization.AtPrime 𝔭₀) (Localization.AtPrime q) := g₀.toAlgebra
  have : IsScalarTower (Localization.AtPrime 𝔭₀) (Localization.AtPrime 𝔭)
      (Localization.AtPrime q) := .of_algebraMap_eq fun x => (RingHom.congr_fun htower x).symm
  have : Module.Flat (Localization.AtPrime 𝔭₀) (Localization.AtPrime q) := hflat₀
  have hJeq : J = (maximalIdeal (Localization.AtPrime 𝔭₀)).map
      (algebraMap (Localization.AtPrime 𝔭₀) (Localization.AtPrime 𝔭)) := by
    show (𝔭₀.map ρR).map (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭)) = _
    rw [← Localization.AtPrime.map_eq_maximalIdeal (I := 𝔭₀), Ideal.map_map, Ideal.map_map]
    congr 1
    refine RingHom.ext fun y => ?_
    show algebraMap _ _ (ρR y) = i₀ (algebraMap _ _ y)
    rw [Localization.localRingHom_to_map]
  have hinj : Function.Injective (LinearMap.rTensor (Localization.AtPrime q) J.subtype) := by
    rw [hJeq]
    exact Langlands.Algebra.extendedIdeal_rTensor_injective (Localization.AtPrime 𝔭₀) (Localization.AtPrime 𝔭)
      (Localization.AtPrime q) _
  -- (iii) the closed fibre
  have hJq : J.map (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime q)) = I₀ := by
    show ((𝔭₀.map ρR).map (algebraMap (MvPolynomial (Fin (t + r)) k)
      (Localization.AtPrime 𝔭))).map g = I₀
    rw [Ideal.map_map, Ideal.map_map]
    have hc : (g.comp (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭))).comp ρR =
        (algebraMap Λ (Localization.AtPrime q)).comp
          (φ.comp (rename (Fin.castAdd r)) : MvPolynomial (Fin t) k →+* Λ) := by
      refine RingHom.ext fun y => ?_
      show g (algebraMap _ _ (ρR y)) = _
      rw [Localization.localRingHom_to_map]
      rfl
    rw [hc]
  have hβ : RingTheory.Sequence.IsWeaklyRegular (Localization.AtPrime 𝔭 ⧸ J)
      (List.ofFn fun j => Ideal.Quotient.mk J
        (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭) (zVar k t r j))) := by
    have hC := isWeaklyRegular_quot k t r 𝔭₀
    have : Module.Flat (MvPolynomial (Fin (t + r)) k ⧸ extIdeal k t r 𝔭₀)
        (Localization.AtPrime 𝔭 ⧸ J) :=
      IsLocalization.flat (Localization.AtPrime 𝔭 ⧸ J)
        (Algebra.algebraMapSubmonoid (MvPolynomial (Fin (t + r)) k ⧸ extIdeal k t r 𝔭₀)
          𝔭.primeCompl)
    have h1 := hC.isWeaklyRegular_lTensor (M₂ := Localization.AtPrime 𝔭 ⧸ J)
    have h2 := ((TensorProduct.rid (MvPolynomial (Fin (t + r)) k ⧸ extIdeal k t r 𝔭₀)
      (Localization.AtPrime 𝔭 ⧸ J)).isWeaklyRegular_congr _).mp h1
    have h3 := (RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff
      (S := Localization.AtPrime 𝔭 ⧸ J) (M := Localization.AtPrime 𝔭 ⧸ J) _).mpr h2
    rw [List.map_ofFn] at h3
    exact h3
  have hγ : RingTheory.Sequence.IsWeaklyRegular (Localization.AtPrime q ⧸
      J.map (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime q)))
      (List.ofFn fun j => Ideal.Quotient.mk
        (J.map (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime q)))
        (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime q)
          (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭) (zVar k t r j)))) := by
    have hpt : ∀ j, algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime q)
        (algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭) (zVar k t r j)) =
        algebraMap Λ (Localization.AtPrime q) (φ (zVar k t r j)) := by
      intro j
      show g (algebraMap _ _ (zVar k t r j)) = _
      rw [Localization.localRingHom_to_map]
      rfl
    simp only [hpt]
    apply isWeaklyRegular_transport hJq
    let x' : Fin (maximalIdeal (Localization.AtPrime q ⧸ I₀)).spanFinrank →
        Localization.AtPrime q ⧸ I₀ := fun i =>
      Ideal.Quotient.mk I₀ (algebraMap Λ _ (φ (zVar k t r (Fin.cast hrank i))))
    have hspan' : Ideal.span (Set.range x') = maximalIdeal (Localization.AtPrime q ⧸ I₀) := by
      refine Eq.trans ?_ hgen
      congr 1
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨_, rfl⟩
      · rintro ⟨j, rfl⟩
        exact ⟨Fin.cast hrank.symm j, by simp only [x', Fin.cast_cast, Fin.cast_eq_self]; rfl⟩
    have hreg := h00NQ _ x' hspan'
    have hof : List.ofFn x' = List.ofFn fun j => Ideal.Quotient.mk I₀
        (algebraMap Λ (Localization.AtPrime q) (φ (zVar k t r j))) := by
      rw [List.ofFn_congr hrank]
      simp [x']
    rw [← hof]
    exact hreg.toIsWeaklyRegular
  have : IsLocalHom (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime q)) :=
    Localization.isLocalHom_localRingHom 𝔭 q φ h𝔭
  exact flat_of_fibre hN3 J hJtop hinj
    (fun j => algebraMap (MvPolynomial (Fin (t + r)) k) (Localization.AtPrime 𝔭) (zVar k t r j))
    hmaxB hβ hγ

end RegularParameter

/-- The "property (1)" step of Stacks 07FH (`RegularParameterExtensionStatement`): adding variables
that map to a regular system of parameters of the closed fibre `Λ_q/𝔭₀Λ_q` gives a flat local map
`k[y, z]_𝔭 → Λ_q` with `𝔭Λ_q = qΛ_q`. -/
theorem regularParameterExtension : RegularParameterExtensionStatement.{u} :=
  RegularParameter.regularParameterExtension_of regularSequenceFlat
    regularLocalParameters

end Langlands.CommutativeAlgebra.Popescu
