namespace LocalizationStandardDescent

section Criterion

variable {R : Type u} [CommRing R]

/-- A presentation criterion for strictly standard elements: if `B = R[V]/(F, G)` and `s ∈ R`
satisfies `s ∈ (det(∂F_j/∂x_{emb k})) + (F)` and `s G ⊆ (F)`, then `s` is strictly standard
in `B` over `R`. -/
theorem isStrictlyStandard_of_presentation {B : Type*} [CommRing B] [Algebra R B]
    {V κ τ : Type*} [Fintype V] [Fintype κ] [Fintype τ] [DecidableEq κ]
    (F : κ → MvPolynomial V R) (G : τ → MvPolynomial V R) (emb : κ → V)
    (hemb : Function.Injective emb)
    (φ : MvPolynomial V R →ₐ[R] B) (hφ : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span (Set.range F ∪ Set.range G)) (s : R)
    (hdet : C s ∈ Ideal.span {(Matrix.of fun j k => pderiv (emb k) (F j)).det} ⊔
      Ideal.span (Set.range F))
    (hG : ∀ l, C s * G l ∈ Ideal.span (Set.range F)) :
    IsStrictlyStandard R (algebraMap R B s) := by
  classical
  set N := Fintype.card V
  set c := Fintype.card κ
  set t := Fintype.card τ
  let eV : V ≃ Fin N := Fintype.equivFin V
  let eτ : τ ≃ Fin t := Fintype.equivFin τ
  let T : Finset (Fin N) := Finset.univ.image fun k => eV (emb k)
  have hT : T.card = c := by
    rw [Finset.card_image_of_injective (f := fun k => eV (emb k)) _
      (fun a b h => hemb (eV.injective h))]
    rfl
  have hcN : c ≤ N := by
    rw [← hT]; simpa using Finset.card_le_univ T
  let e : Fin c ↪o Fin N := T.orderEmbOfFin hT
  have hmemT : ∀ k, eV (emb k) ∈ T := fun k => Finset.mem_image_of_mem _ (Finset.mem_univ k)
  let κc : κ → Fin c := fun k => (T.orderIsoOfFin hT).symm ⟨eV (emb k), hmemT k⟩
  have he : ∀ k, e (κc k) = eV (emb k) := by
    intro k
    simp only [e, κc, ← Finset.coe_orderIsoOfFin_apply, OrderIso.apply_symm_apply]
  have hκc : Function.Injective κc := by
    intro k₁ k₂ h
    have := congrArg e h
    rw [he, he] at this
    exact hemb (eV.injective this)
  let eκ : κ ≃ Fin c := Equiv.ofBijective κc
    ((Fintype.bijective_iff_injective_and_card _).mpr ⟨hκc, by simp [c]⟩)
  have he' : ∀ k, e k = eV (emb (eκ.symm k)) := by
    intro k
    conv_lhs => rw [← eκ.apply_symm_apply k]
    exact he _
  let F' : Fin (c + t) → MvPolynomial (Fin N) R :=
    Fin.append (fun j => rename eV (F (eκ.symm j))) (fun j => rename eV (G (eτ.symm j)))
  let ρ : MvPolynomial (Fin N) R ≃ₐ[R] MvPolynomial V R := renameEquiv R eV.symm
  let φ' : MvPolynomial (Fin N) R →ₐ[R] B := φ.comp ρ.toAlgHom
  have hφ'V : ∀ p, φ' (rename eV p) = φ p := by
    intro p
    change φ (rename eV.symm (rename eV p)) = φ p
    rw [rename_rename, Equiv.symm_comp_self, rename_id, AlgHom.id_apply]
  have hcast : ∀ j : Fin c, Fin.castLE (Nat.le_add_right c t) j = Fin.castAdd t j :=
    fun j => Fin.ext rfl
  have hF'l : ∀ j : Fin c, F' (Fin.castAdd t j) = rename eV (F (eκ.symm j)) := by
    intro j; simp [F']
  have hF'r : ∀ j : Fin t, F' (Fin.natAdd c j) = rename eV (G (eτ.symm j)) := by
    intro j; simp [F']
  -- the image of the ideal generated by `F`
  have hspanF : Ideal.map (rename eV) (Ideal.span (Set.range F)) ≤
      Ideal.span (F' '' {i | (i : ℕ) < c}) := by
    rw [Ideal.map_span]
    apply Ideal.span_mono
    rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
    refine ⟨Fin.castAdd t (eκ k), by simp, ?_⟩
    rw [hF'l, eκ.symm_apply_apply]
  refine ⟨N, c + t, c, hcN, Nat.le_add_right c t, F', φ', hφ.comp ρ.surjective, ?_, ?_,
    C s, ?_, ?_⟩
  · -- the kernel
    have h1 : RingHom.ker φ = Ideal.comap (rename eV) (RingHom.ker φ') := by
      ext p; simp [RingHom.mem_ker, hφ'V]
    have h2 : RingHom.ker φ' = Ideal.map (rename eV) (RingHom.ker φ) := by
      have hsurj : Function.Surjective (rename eV : MvPolynomial V R → MvPolynomial (Fin N) R) :=
        (renameEquiv R eV).surjective
      rw [h1, Ideal.map_comap_of_surjective _ hsurj]
    rw [h2, hker, Ideal.map_span]
    congr 1
    ext p
    simp only [Set.mem_image, Set.mem_union, Set.mem_range]
    constructor
    · rintro ⟨q, hq | hq, rfl⟩
      · obtain ⟨k, rfl⟩ := hq
        refine ⟨Fin.castAdd t (eκ k), ?_⟩
        rw [hF'l, eκ.symm_apply_apply]
      · obtain ⟨l, rfl⟩ := hq
        refine ⟨Fin.natAdd c (eτ l), ?_⟩
        rw [hF'r, eτ.symm_apply_apply]
    · rintro ⟨j, rfl⟩
      refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · exact ⟨_, Or.inl ⟨eκ.symm j, rfl⟩, by rw [hF'l]⟩
      · exact ⟨_, Or.inr ⟨eτ.symm j, rfl⟩, by rw [hF'r]⟩
  · -- `s` lies in the ideal of minors
    set M : Matrix κ κ (MvPolynomial V R) := Matrix.of fun j k => pderiv (emb k) (F j)
    have hdetM : (Matrix.of fun j k : Fin c =>
        pderiv (e k) (F' (Fin.castLE (Nat.le_add_right c t) j))).det = rename eV M.det := by
      rw [AlgHom.map_det, ← Matrix.det_submatrix_equiv_self eκ.symm]
      congr 1
      refine Matrix.ext fun j k => ?_
      simp only [hcast, hF'l, he', Matrix.submatrix_apply, AlgHom.mapMatrix_apply,
        Matrix.map_apply, M, Matrix.of_apply]
      exact pderiv_rename eV.injective _ _
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hdet
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    have hz0 : φ z = 0 := by
      rw [← RingHom.mem_ker, hker]
      exact Ideal.span_mono Set.subset_union_left hz
    have : algebraMap R B s = φ a * φ' (Matrix.of fun j k : Fin c =>
        pderiv (e k) (F' (Fin.castLE (Nat.le_add_right c t) j))).det := by
      rw [hdetM, hφ'V, ← map_mul, ← add_zero (φ (a * M.det)), ← hz0, ← map_add, hyz,
        ← algebraMap_eq, AlgHom.commutes]
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨e, rfl⟩)
  · rw [← algebraMap_eq, AlgHom.commutes]
  · intro j hj
    obtain ⟨l, rfl⟩ : ∃ l : Fin t, Fin.natAdd c l = j :=
      ⟨⟨j - c, by omega⟩, Fin.ext (by simp; omega)⟩
    rw [hF'r]
    refine Ideal.mem_sup_left (hspanF ?_)
    rw [← rename_C eV s, ← map_mul]
    exact Ideal.mem_map_of_mem _ (hG _)

end Criterion

section Descent

attribute [local instance] MvPolynomial.algebraMvPolynomial

variable {R R' Λ Λ' : Type u} [CommRing R] [CommRing R'] [CommRing Λ] [CommRing Λ']
  [Algebra R R'] [Algebra R Λ] [Algebra R' Λ'] [Algebra Λ Λ'] [Algebra R Λ']
  [IsScalarTower R R' Λ'] [IsScalarTower R Λ Λ']
  (S : Submonoid R) [IsLocalization S R'] [IsLocalization (Algebra.algebraMapSubmonoid Λ S) Λ']

/-- Clearing denominators in a system of equations over `S⁻¹R` whose Jacobian minor is a
unit modulo the equations and which vanishes at a point of `Λ`, keeping the extra equations
`G` in the ideal up to an element of `S`. -/
theorem exists_descent {V κ τ : Type*} [Fintype V] [Fintype κ] [Fintype τ] [DecidableEq κ]
    (emb : κ → V) (E : κ → MvPolynomial V R') (μ : V → Λ) (G : τ → MvPolynomial V R)
    (hE : ∀ k, aeval (fun v => algebraMap Λ Λ' (μ v)) (E k) = 0)
    (hG : ∀ l, MvPolynomial.map (algebraMap R R') (G l) ∈ Ideal.span (Set.range E))
    (hdet : (1 : MvPolynomial V R') ∈
      Ideal.span {(Matrix.of fun j k => pderiv (emb k) (E j)).det} ⊔ Ideal.span (Set.range E)) :
    ∃ (F : κ → MvPolynomial V R) (s : R), s ∈ S ∧ (∀ k, aeval μ (F k) = 0) ∧
      C s ∈ Ideal.span {(Matrix.of fun j k => pderiv (emb k) (F j)).det} ⊔
        Ideal.span (Set.range F) ∧
      ∀ l, C s * G l ∈ Ideal.span (Set.range F) := by
  classical
  have hmapF : ∀ p : MvPolynomial V R, algebraMap (MvPolynomial V R) (MvPolynomial V R') p =
      MvPolynomial.map (algebraMap R R') p := fun p => rfl
  -- clear denominators of each equation
  have h1 : ∀ k, ∃ (F0 : MvPolynomial V R) (s : R), s ∈ S ∧
      E k * C (algebraMap R R' s) = MvPolynomial.map (algebraMap R R') F0 := by
    intro k
    obtain ⟨⟨F0, ⟨m, hm⟩⟩, h⟩ := IsLocalization.surj (S.map (C (σ := V))) (E k)
    obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hm
    exact ⟨F0, s, hs, by simpa [hmapF] using h⟩
  choose F0 s₁ hs₁ hF0 using h1
  -- make each equation vanish at `μ`
  have h2 : ∀ k, ∃ s : R, s ∈ S ∧ algebraMap R Λ s * aeval μ (F0 k) = 0 := by
    intro k
    have : algebraMap Λ Λ' (aeval μ (F0 k)) = 0 := by
      rw [← aeval_algebraMap_apply, ← aeval_map_algebraMap R' _ (F0 k), ← hF0, map_mul,
        Function.comp_def, hE, zero_mul]
    obtain ⟨⟨_, ⟨s, hs, rfl⟩⟩, h⟩ :=
      (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid Λ S) Λ' _).mp this
    exact ⟨s, hs, h⟩
  choose s₂ hs₂ hF0μ using h2
  let F : κ → MvPolynomial V R := fun k => C (s₂ k) * F0 k
  have hunit : ∀ k, IsUnit (C (σ := V) (algebraMap R R' (s₂ k * s₁ k))) :=
    fun k => (IsLocalization.map_units R' ⟨_, S.mul_mem (hs₂ k) (hs₁ k)⟩).map C
  have hFE : ∀ k, MvPolynomial.map (algebraMap R R') (F k) =
      C (algebraMap R R' (s₂ k * s₁ k)) * E k := by
    intro k
    simp only [F, map_mul, map_C, ← hF0]
    ring
  -- the ideal of `F` generates the ideal of `E`
  have hEmem : ∀ (I : Ideal (MvPolynomial V R)), Ideal.span (Set.range F) ≤ I →
      Ideal.span (Set.range E) ≤ I.map (algebraMap _ (MvPolynomial V R')) := by
    intro I hI
    rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    rw [SetLike.mem_coe, ← Ideal.unit_mul_mem_iff_mem _ (hunit k), ← hFE]
    exact Ideal.mem_map_of_mem _ (hI (Ideal.subset_span ⟨k, rfl⟩))
  set I := Ideal.span {(Matrix.of fun j k => pderiv (emb k) (F j)).det} ⊔ Ideal.span (Set.range F)
  have hItop : (1 : MvPolynomial V R') ∈ I.map (algebraMap _ (MvPolynomial V R')) := by
    refine (sup_le ?_ (hEmem I le_sup_right)) hdet
    rw [Ideal.span_le, Set.singleton_subset_iff]
    have hd : algebraMap _ (MvPolynomial V R') (Matrix.of fun j k => pderiv (emb k) (F j)).det =
        (∏ k, C (algebraMap R R' (s₂ k * s₁ k))) *
          (Matrix.of fun j k => pderiv (emb k) (E j)).det := by
      rw [hmapF, RingHom.map_det, ← Matrix.det_mul_column]
      congr 1
      refine Matrix.ext fun j k => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
      rw [← pderiv_map, hFE, Derivation.leibniz, pderiv_C, smul_zero, add_zero, smul_eq_mul]
    have hu : IsUnit (∏ k, C (σ := V) (algebraMap R R' (s₂ k * s₁ k))) :=
      IsUnit.prod_univ_iff.mpr hunit
    rw [SetLike.mem_coe, ← Ideal.unit_mul_mem_iff_mem _ hu, ← hd]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span rfl))
  obtain ⟨_, ⟨s₀, hs₀, rfl⟩, h₀⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff (S.map (C (σ := V)))
      (S := MvPolynomial V R') I 1).mp (by rw [map_one]; exact hItop)
  have h3 : ∀ l, ∃ s : R, s ∈ S ∧ C s * G l ∈ Ideal.span (Set.range F) := by
    intro l
    obtain ⟨_, ⟨s, hs, rfl⟩, h⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff (S.map (C (σ := V)))
        (S := MvPolynomial V R') _ (G l)).mp (hEmem _ le_rfl (hG l))
    exact ⟨s, hs, h⟩
  choose s₃ hs₃ hG3 using h3
  refine ⟨F, s₀ * ∏ l, s₃ l, S.mul_mem hs₀ (S.prod_mem fun l _ => hs₃ l), ?_, ?_, ?_⟩
  · intro k
    simp only [F, map_mul, aeval_C, hF0μ]
  · rw [map_mul]
    exact I.mul_mem_right _ (by simpa using h₀)
  · intro l
    obtain ⟨q, hq⟩ : C (σ := V) (s₃ l) ∣ C (∏ l, s₃ l) :=
      map_dvd C (Finset.dvd_prod_of_mem _ (Finset.mem_univ l))
    rw [map_mul, hq, show C s₀ * (C (s₃ l) * q) * G l = (C (s₃ l) * G l) * (C s₀ * q) by ring]
    exact Ideal.mul_mem_right _ _ (hG3 l)

end Descent

section Scaling

variable {R' : Type*} [CommRing R'] {V : Type*}

/-- The rescaling of variables `X v ↦ d v * X v`. -/
noncomputable def scaleVars (d : V → R') : MvPolynomial V R' →ₐ[R'] MvPolynomial V R' :=
  aeval fun v => C (d v) * X v

theorem scaleVars_X (d : V → R') (v : V) : scaleVars d (X v) = C (d v) * X v := aeval_X _ _

theorem pderiv_scaleVars [DecidableEq V] (d : V → R') (v : V) (p : MvPolynomial V R') :
    pderiv v (scaleVars d p) = C (d v) * scaleVars d (pderiv v p) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [scaleVars]
  | add p q hp hq => simp only [map_add, hp, hq, mul_add]
  | mul_X p w hp =>
    simp only [map_mul, Derivation.leibniz, hp, scaleVars_X, smul_eq_mul, map_add, pderiv_C,
      mul_zero, add_zero]
    by_cases h : v = w
    · subst h; simp only [pderiv_X_self, mul_one, map_one]; ring
    · simp only [pderiv_X_of_ne (Ne.symm h), map_zero, mul_zero, zero_add]; ring

end Scaling

section ScaledDescent

attribute [local instance] MvPolynomial.algebraMvPolynomial

variable {R R' Λ Λ' : Type u} [CommRing R] [CommRing R'] [CommRing Λ] [CommRing Λ']
  [Algebra R R'] [Algebra R Λ] [Algebra R' Λ'] [Algebra Λ Λ'] [Algebra R Λ']
  [IsScalarTower R R' Λ'] [IsScalarTower R Λ Λ']
  (S : Submonoid R) [IsLocalization S R'] [IsLocalization (Algebra.algebraMapSubmonoid Λ S) Λ']

/-- `exists_descent` for a point of `Λ'` of the form `d • μ` with `d` a family of units of
`S⁻¹R` and `μ` a point of `Λ`, provided the rescaling by `d` fixes the extra equations. -/
theorem exists_descent_scaled {V κ τ : Type*} [Fintype V] [Fintype κ] [Fintype τ] [DecidableEq κ]
    [DecidableEq V] (emb : κ → V) (E : κ → MvPolynomial V R') (μ : V → Λ) (d : V → R')
    (hd : ∀ v, IsUnit (d v)) (G : τ → MvPolynomial V R)
    (hE : ∀ k, aeval (fun v => algebraMap R' Λ' (d v) * algebraMap Λ Λ' (μ v)) (E k) = 0)
    (hG : ∀ l, MvPolynomial.map (algebraMap R R') (G l) ∈ Ideal.span (Set.range E))
    (hGd : ∀ l, scaleVars d (MvPolynomial.map (algebraMap R R') (G l)) =
      MvPolynomial.map (algebraMap R R') (G l))
    (hdet : (1 : MvPolynomial V R') ∈
      Ideal.span {(Matrix.of fun j k => pderiv (emb k) (E j)).det} ⊔ Ideal.span (Set.range E)) :
    ∃ (F : κ → MvPolynomial V R) (s : R), s ∈ S ∧ (∀ k, aeval μ (F k) = 0) ∧
      C s ∈ Ideal.span {(Matrix.of fun j k => pderiv (emb k) (F j)).det} ⊔
        Ideal.span (Set.range F) ∧
      ∀ l, C s * G l ∈ Ideal.span (Set.range F) := by
  classical
  set τd := scaleVars d
  have hr : Set.range (fun k => τd (E k)) = τd '' Set.range E := by
    rw [← Set.range_comp]; rfl
  apply exists_descent (R' := R') (Λ' := Λ') S emb (fun k => τd (E k)) μ G
  · intro k
    change aeval _ (aeval (fun v => C (d v) * X v) (E k)) = 0
    rw [← AlgHom.comp_apply, comp_aeval]
    simpa only [map_mul, aeval_C, aeval_X, algebraMap_eq] using hE k
  · intro l
    rw [← hGd l, hr, ← Ideal.map_span]
    exact Ideal.mem_map_of_mem _ (hG l)
  · have hM : (Matrix.of fun j k => pderiv (emb k) (τd (E j))).det =
        (∏ k, C (d (emb k))) * τd (Matrix.of fun j k => pderiv (emb k) (E j)).det := by
      rw [AlgHom.map_det, ← Matrix.det_mul_row]
      congr 1
      refine Matrix.ext fun j k => ?_
      simp only [Matrix.of_apply, AlgHom.mapMatrix_apply, Matrix.map_apply, τd,
        pderiv_scaleVars]
    have hu : IsUnit (∏ k, C (σ := V) (d (emb k))) :=
      IsUnit.prod_univ_iff.mpr fun k => (hd _).map C
    have := Ideal.mem_map_of_mem τd hdet
    rw [map_one, Ideal.map_sup, Ideal.map_span, Ideal.map_span, Set.image_singleton] at this
    rw [hM, Ideal.span_singleton_mul_left_unit hu, hr]
    exact this

end ScaledDescent

section Core

variable {R R' Λ Λ' : Type u} [CommRing R] [CommRing R'] [CommRing Λ] [CommRing Λ']
  [Algebra R R'] [Algebra R Λ] [Algebra R' Λ'] [Algebra Λ Λ'] [Algebra R Λ']
  [IsScalarTower R R' Λ'] [IsScalarTower R Λ Λ']
  (S : Submonoid R) [IsLocalization S R'] [IsLocalization (Algebra.algebraMapSubmonoid Λ S) Λ']

/-- Stacks Lemma 8.3 (07F4) when `B'` is standard smooth over `S⁻¹R`. -/
theorem localizationStandardDescent_core {A : Type u} [CommRing A] [Algebra R A]
    [Algebra.FinitePresentation R A] (f : A →ₐ[R] Λ)
    (B' : Type u) [CommRing B'] [Algebra R' B'] [Algebra R B'] [IsScalarTower R R' B']
    [Algebra.IsStandardSmooth R' B'] (u : A →ₐ[R] B') (v : B' →ₐ[R'] Λ')
    (huv : (v.restrictScalars R).comp u = (IsScalarTower.toAlgHom R Λ Λ').comp f) :
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B),
      Algebra.FinitePresentation R B ∧
        ∃ (g : A →ₐ[R] B) (h : B →ₐ[R] Λ), h.comp g = f ∧
          ∃ s ∈ S, IsStrictlyStandard R (algebraMap R B s) := by
  classical
  obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := Algebra.IsStandardSmooth.out (R := R') (S := B')
  let := Fintype.ofFinite ι
  let := Fintype.ofFinite σ
  obtain ⟨n, φA, hφA, T, hT⟩ := Algebra.FinitePresentation.out (R := R) (A := A)
  let a : Fin n → A := fun i => φA (X i)
  have hφa : ∀ p, aeval a p = φA p := fun p => by
    rw [show (aeval a : MvPolynomial (Fin n) R →ₐ[R] A) = φA from
      algHom_ext fun i => aeval_X _ _]
  have hφT : ∀ q ∈ T, φA q = 0 := by
    intro q hq
    have : q ∈ RingHom.ker φA.toRingHom := by rw [← hT]; exact Ideal.subset_span hq
    exact this
  have hvu : ∀ x : A, v (u x) = algebraMap Λ Λ' (f x) := fun x =>
    congrArg (fun φ : A →ₐ[R] Λ' => φ x) huv
  -- lifts of the generators of `A` to polynomials over the presentation of `B'`
  let b : Fin n → MvPolynomial ι R' := fun i => P.σ (u (a i))
  have hb : ∀ i, aeval P.val (b i) = u (a i) := fun i => P.aeval_val_σ _
  -- clearing the denominators of the point `v ∘ P.val` of `Λ'`
  have hden : ∀ x : ι, ∃ (l : Λ) (s : R), s ∈ S ∧
      v (P.val x) * algebraMap R Λ' s = algebraMap Λ Λ' l := by
    intro x
    obtain ⟨⟨l, ⟨_, ⟨s, hs, rfl⟩⟩⟩, h⟩ :=
      IsLocalization.surj (Algebra.algebraMapSubmonoid Λ S) (v (P.val x))
    refine ⟨l, s, hs, ?_⟩
    rw [IsScalarTower.algebraMap_apply R Λ Λ']
    exact h
  choose l s hs hl using hden
  have hsu : ∀ x, IsUnit (algebraMap R R' (s x)) := fun x =>
    IsLocalization.map_units R' ⟨s x, hs x⟩
  let d : Fin n ⊕ ι → R' := Sum.elim 1 fun x => ↑(hsu x).unit⁻¹
  have hd : ∀ w, IsUnit (d w) := by
    rintro (i | x)
    · exact isUnit_one
    · exact Units.isUnit _
  let μ : Fin n ⊕ ι → Λ := Sum.elim (fun i => f (a i)) l
  have hpt : (fun w => algebraMap R' Λ' (d w) * algebraMap Λ Λ' (μ w)) =
      Sum.elim (fun i => algebraMap Λ Λ' (f (a i))) fun x => v (P.val x) := by
    funext w
    rcases w with i | x
    · simp [d, μ]
    · simp only [d, μ, Sum.elim_inr]
      rw [← hl x, IsScalarTower.algebraMap_apply R R' Λ', mul_comm (v _), ← mul_assoc,
        ← map_mul, IsUnit.val_inv_mul, map_one, one_mul]
  -- the equations over `S⁻¹R`
  let E : Fin n ⊕ σ → MvPolynomial (Fin n ⊕ ι) R' :=
    Sum.elim (fun i => X (Sum.inl i) - rename Sum.inr (b i))
      fun j => rename Sum.inr (P.relation j)
  let emb : Fin n ⊕ σ → Fin n ⊕ ι := Sum.map id P.map
  have hemb : Function.Injective emb := Function.injective_id.sumMap P.map_inj
  have hv : ∀ p : MvPolynomial ι R', aeval (fun x => v (P.val x)) p = v (aeval P.val p) :=
    fun p => (comp_aeval_apply P.val v p).symm
  have hE : ∀ k, aeval (fun w => algebraMap R' Λ' (d w) * algebraMap Λ Λ' (μ w)) (E k) = 0 := by
    rw [hpt]
    rintro (i | j)
    · simp only [E, Sum.elim_inl, map_sub, aeval_X, aeval_rename, Sum.elim_comp_inr]
      rw [hv, hb, hvu, sub_self]
    · simp only [E, Sum.elim_inr, aeval_rename, Sum.elim_comp_inr]
      rw [hv, P.aeval_val_relation, map_zero]
  set J := Ideal.span (Set.range E) with hJ
  have hrel : ∀ q' : MvPolynomial ι R', aeval P.val q' = 0 → rename Sum.inr q' ∈ J := by
    intro q' hq'
    have h1 : q' ∈ Ideal.span (Set.range P.relation) := by
      rw [P.span_range_relation_eq_ker, P.ker_eq_ker_aeval_val]
      exact hq'
    have h2 := Ideal.mem_map_of_mem
      (rename Sum.inr : MvPolynomial ι R' →ₐ[R'] MvPolynomial (Fin n ⊕ ι) R') h1
    rw [Ideal.map_span] at h2
    refine Ideal.span_mono ?_ h2
    rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    exact ⟨Sum.inr j, rfl⟩
  have hmodJ : (Ideal.Quotient.mkₐ R' J).comp (rename Sum.inl) =
      (Ideal.Quotient.mkₐ R' J).comp ((rename Sum.inr).comp (aeval b)) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, rename_X, aeval_X, Ideal.Quotient.mkₐ_eq_mk]
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact Ideal.subset_span ⟨Sum.inl i, rfl⟩
  -- the equations of `A`, as extra equations
  let G : T → MvPolynomial (Fin n ⊕ ι) R := fun q => rename Sum.inl q.1
  have hmapG : ∀ q : T, MvPolynomial.map (algebraMap R R') (G q) =
      rename Sum.inl (MvPolynomial.map (algebraMap R R') q.1) := fun q => map_rename _ _ _
  have hG : ∀ q : T, MvPolynomial.map (algebraMap R R') (G q) ∈ J := by
    intro q
    rw [hmapG, ← Ideal.Quotient.eq_zero_iff_mem]
    have := congrArg (fun φ => φ (MvPolynomial.map (algebraMap R R') q.1)) hmodJ
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
    rw [this, Ideal.Quotient.eq_zero_iff_mem]
    apply hrel
    rw [comp_aeval_apply, aeval_map_algebraMap]
    simp only [hb]
    rw [← comp_aeval_apply, hφa, hφT q.1 q.2, map_zero]
  have hGd : ∀ q : T, scaleVars d (MvPolynomial.map (algebraMap R R') (G q)) =
      MvPolynomial.map (algebraMap R R') (G q) := by
    intro q
    have : (scaleVars d).comp (rename (R := R') (Sum.inl : Fin n → Fin n ⊕ ι)) =
        rename Sum.inl := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [scaleVars, d]
    rw [hmapG]
    exact congrArg (fun φ : MvPolynomial (Fin n) R' →ₐ[R'] MvPolynomial (Fin n ⊕ ι) R' =>
      φ (MvPolynomial.map (algebraMap R R') q.1)) this
  -- the Jacobian condition
  have hdet : (1 : MvPolynomial (Fin n ⊕ ι) R') ∈
      Ideal.span {(Matrix.of fun j k => pderiv (emb k) (E j)).det} ⊔ J := by
    have hM : (Matrix.of fun j k => pderiv (emb k) (E j)) =
        Matrix.fromBlocks 1 (Matrix.of fun i j' => pderiv (Sum.inr (P.map j')) (E (Sum.inl i))) 0
          ((rename Sum.inr).mapMatrix P.jacobiMatrix.transpose) := by
      ext (i | j) (i' | j')
      · have hnot : (Sum.inl i' : Fin n ⊕ ι) ∉ Set.range Sum.inr := by simp
        simp only [Matrix.of_apply, E, emb, Sum.elim_inl, Sum.map_inl, id, map_sub,
          SymRetract.pderiv_rename_of_notMem_range' hnot, sub_zero, Matrix.fromBlocks_apply₁₁,
          Matrix.one_apply]
        by_cases h : i = i'
        · subst h; simp
        · rw [pderiv_X_of_ne (by simpa using h)]; simp [h]
      · simp [emb]
      · have hnot : (Sum.inl i' : Fin n ⊕ ι) ∉ Set.range Sum.inr := by simp
        simp only [Matrix.of_apply, E, emb, Sum.elim_inr, Sum.map_inl, id,
          SymRetract.pderiv_rename_of_notMem_range' hnot, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
      · simp only [Matrix.of_apply, E, emb, Sum.elim_inr, Sum.map_inr,
          pderiv_rename Sum.inr_injective, Matrix.fromBlocks_apply₂₂, AlgHom.mapMatrix_apply,
          Matrix.map_apply, Matrix.transpose_apply, P.jacobiMatrix_apply]
    have hdetM : (Matrix.of fun j k => pderiv (emb k) (E j)).det =
        rename Sum.inr P.jacobiMatrix.det := by
      rw [hM, Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, one_mul, ← AlgHom.map_det,
        Matrix.det_transpose]
    obtain ⟨y, hy⟩ := P.jacobian_isUnit.exists_left_inv
    obtain ⟨h0, rfl⟩ := P.algebraMap_surjective y
    have h0J : rename Sum.inr (h0 * P.jacobiMatrix.det - 1) ∈ J := by
      apply hrel
      rw [map_sub, map_mul, map_one, ← P.algebraMap_apply, ← P.algebraMap_apply,
        ← P.jacobian_eq_jacobiMatrix_det, hy, sub_self]
    have h1 : (1 : MvPolynomial (Fin n ⊕ ι) R') = rename Sum.inr h0 *
        (Matrix.of fun j k => pderiv (emb k) (E j)).det -
          rename Sum.inr (h0 * P.jacobiMatrix.det - 1) := by
      rw [hdetM, map_sub, map_mul, map_one]; ring
    rw [h1]
    exact Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)))
      (Ideal.mem_sup_right h0J)
  -- descend to `R`
  obtain ⟨F, s₀, hs₀, hFμ, hdetF, hGF⟩ :=
    exists_descent_scaled (R' := R') (Λ' := Λ') S emb E μ d hd G hE hG hGd hdet
  let I : Ideal (MvPolynomial (Fin n ⊕ ι) R) := Ideal.span (Set.range F ∪ Set.range G)
  have hIfg : I.FG := Submodule.fg_span ((Set.finite_range F).union (Set.finite_range G))
  have hGμ : ∀ q : MvPolynomial (Fin n) R, aeval μ (rename Sum.inl q) = f (φA q) := by
    intro q
    rw [aeval_rename, ← hφa, comp_aeval_apply]
    rfl
  have hIμ : ∀ p ∈ I, aeval μ p = 0 := by
    intro p hp
    have : I ≤ RingHom.ker (aeval μ : MvPolynomial (Fin n ⊕ ι) R →ₐ[R] Λ) := by
      rw [Ideal.span_le]
      rintro _ (⟨k, rfl⟩ | ⟨q, rfl⟩)
      · exact hFμ k
      · change aeval μ (rename Sum.inl q.1) = 0
        rw [hGμ, hφT q.1 q.2, map_zero]
    exact this hp
  have hIA : RingHom.ker φA.toRingHom ≤
      RingHom.ker ((Ideal.Quotient.mkₐ R I).comp (rename Sum.inl)).toRingHom := by
    rw [← hT, Ideal.span_le]
    intro q hq
    change Ideal.Quotient.mk I (rename Sum.inl q) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Or.inr ⟨⟨q, hq⟩, rfl⟩)
  let g : A →ₐ[R] MvPolynomial (Fin n ⊕ ι) R ⧸ I :=
    AlgHom.liftOfSurjective φA hφA ((Ideal.Quotient.mkₐ R I).comp (rename Sum.inl)) hIA
  let h : MvPolynomial (Fin n ⊕ ι) R ⧸ I →ₐ[R] Λ := Ideal.Quotient.liftₐ I (aeval μ) hIμ
  have hcomp : h.comp g = f := by
    ext x
    obtain ⟨p, rfl⟩ := hφA x
    rw [AlgHom.comp_apply, AlgHom.liftOfSurjective_apply, AlgHom.comp_apply,
      Ideal.Quotient.mkₐ_eq_mk]
    exact hGμ p
  exact ⟨MvPolynomial (Fin n ⊕ ι) R ⧸ I, inferInstance, inferInstance,
    Algebra.FinitePresentation.quotient hIfg, g, h, hcomp, s₀, hs₀,
    isStrictlyStandard_of_presentation F G emb hemb (Ideal.Quotient.mkₐ R I)
      (Ideal.Quotient.mkₐ_surjective R I) (Ideal.Quotient.mkₐ_ker R I) s₀ hdetF hGF⟩

end Core

end LocalizationStandardDescent

open LocalizationStandardDescent in
/-- Stacks Lemma 8.3 (07F4), strictly standard form, from Stacks Lemma 3.4 (07CH). -/
theorem localizationStandardDescent_of (h4 : StandardSmoothRetractStatement.{u}) :
    LocalizationStandardDescentStatement.{u} := by
  intro R A Λ R' Λ' _ _ _ _ _ _ _ _ _ _ _ _ _ _ S _ _ f B' _ _ _ _ _ u v huv
  obtain ⟨B'', _, _, _, _, -, _, ⟨r⟩⟩ := h4 R' B'
  let : Algebra R B'' := ((algebraMap R' B'').comp (algebraMap R R')).toAlgebra
  have : IsScalarTower R R' B'' := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower R B' B'' := IsScalarTower.of_algebraMap_eq' (by
    rw [IsScalarTower.algebraMap_eq R R' B', ← RingHom.comp_assoc,
      ← IsScalarTower.algebraMap_eq R' B' B'']
    rfl)
  let u' : A →ₐ[R] B'' := (IsScalarTower.toAlgHom R B' B'').comp u
  let v' : B'' →ₐ[R'] Λ' := v.comp (r.restrictScalars R')
  have huv' : (v'.restrictScalars R).comp u' = (IsScalarTower.toAlgHom R Λ Λ').comp f := by
    rw [← huv]
    ext x
    simp [u', v']
  exact localizationStandardDescent_core S f B'' u' v' huv'

