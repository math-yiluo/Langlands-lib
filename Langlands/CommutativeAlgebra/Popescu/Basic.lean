import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.RingTheory.FinitePresentation
import Mathlib.RingTheory.Smooth.Locus

/-! # Basic notions for the proof of Popescu's theorem

Definitions from the Stacks Project chapter "Smoothing ring maps" (smoothing.pdf):
the singular ideal (07C5), strictly standard elements (07C7), the radical
`h_A` of Situation 9.1 (07F7), resolutions in the sense following 07F7, and the
mapping form of property PT (Situation 8.1, 07F2). -/

universe u v

namespace Langlands.CommutativeAlgebra.Popescu

open MvPolynomial

/-- The mapping form of property PT of Situation 8.1 (Stacks 07F2): every
`R`-algebra map from a finitely presented `R`-algebra to `Λ` factors through a
smooth `R`-algebra (Stacks, Algebra, Lemma 10.127.4). -/
def HasSmoothFactorizations (R : Type u) (Λ : Type u) [CommRing R] [CommRing Λ]
    [Algebra R Λ] : Prop :=
  ∀ (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A]
    (f : A →ₐ[R] Λ),
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B),
      Algebra.Smooth R B ∧ ∃ (g : A →ₐ[R] B) (h : B →ₐ[R] Λ), h.comp g = f

/-- The singular ideal `H_{A/R}` of Stacks 07C5: the ideal of functions vanishing
on every prime of `A` at which `A` is not smooth over `R`. For a finitely
presented algebra this is the unique radical ideal whose zero locus is the
complement of the (open) smooth locus. -/
def singularIdeal (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A] :
    Ideal A :=
  PrimeSpectrum.vanishingIdeal (Algebra.smoothLocus R A)ᶜ

/-- The ideal `h_A = √(H_{A/R} Λ)` of Situation 9.1 (Stacks 07F7), attached to an
`R`-algebra map `f : A → Λ`. -/
def singularRadical (R : Type u) {A : Type v} {Λ : Type*} [CommRing R] [CommRing A]
    [CommRing Λ] [Algebra R A] [Algebra R Λ] (f : A →ₐ[R] Λ) : Ideal Λ :=
  ((singularIdeal R A).map f).radical

/-- An element `a` of `A` is strictly standard in `A` over `R` (Stacks 07C7,
conditions (2.3.3) and (2.3.4)): there is a presentation
`φ : R[x₁, …, xₙ] → A` with kernel `(f₁, …, f_m)` and `0 ≤ c ≤ min(n, m)` such that
`a` lies in the ideal generated by the images of the `c × c` minors
`det(∂f_j/∂x_i)_{j ≤ c, i ∈ I}` (`I` ranging over `c`-element subsets of the
variables, listed increasingly by `e`), and some lift `g` of `a` satisfies
`g f_{j} ∈ (f₁, …, f_c) + (f₁, …, f_m)²` for every `j > c`. Indices are
zero-based in Lean. -/
def IsStrictlyStandard (R : Type u) {A : Type v} [CommRing R] [CommRing A]
    [Algebra R A] (a : A) : Prop :=
  ∃ (n m c : ℕ) (_ : c ≤ n) (hcm : c ≤ m) (f : Fin m → MvPolynomial (Fin n) R)
    (φ : MvPolynomial (Fin n) R →ₐ[R] A),
    Function.Surjective φ ∧ RingHom.ker φ = Ideal.span (Set.range f) ∧
      a ∈ Ideal.span (Set.range fun e : Fin c ↪o Fin n =>
        φ (Matrix.det fun j k : Fin c => pderiv (e k) (f (Fin.castLE hcm j)))) ∧
      ∃ g : MvPolynomial (Fin n) R, φ g = a ∧
        ∀ j : Fin m, c ≤ (j : ℕ) →
          g * f j ∈ Ideal.span (f '' {i | (i : ℕ) < c}) ⊔ Ideal.span (Set.range f) ^ 2

/-- The factorization problem `R → A → Λ ⊃ q` of Situation 9.1 can be resolved
(Stacks, text after 07F7): there is a factorization `A → B → Λ` of `f` with `B`
finitely presented over `R` and `h_A ⊆ h_B ⊄ q`. -/
def CanBeResolved (R : Type u) {A : Type v} {Λ : Type*} [CommRing R] [CommRing A]
    [CommRing Λ] [Algebra R A] [Algebra R Λ] (f : A →ₐ[R] Λ) (q : Ideal Λ) : Prop :=
  ∃ (B : Type v) (_ : CommRing B) (_ : Algebra R B),
    Algebra.FinitePresentation R B ∧
      ∃ (g : A →ₐ[R] B) (h : B →ₐ[R] Λ), h.comp g = f ∧
        singularRadical R f ≤ singularRadical R h ∧ ¬ singularRadical R h ≤ q

end Langlands.CommutativeAlgebra.Popescu
