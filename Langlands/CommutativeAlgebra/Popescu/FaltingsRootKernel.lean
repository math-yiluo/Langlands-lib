import Langlands.CommutativeAlgebra.Popescu.FaltingsPresentation

/-! # Differentials of an algebra presented by `x_j^p = b_j` in characteristic `p` -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu

namespace Faltings

open MvPolynomial

open scoped TensorProduct

theorem pow_char_D (p : ℕ) {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (hp : (p : S) = 0) (x : S) : KaehlerDifferential.D R S (x ^ p) = 0 := by
  rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul S, hp, zero_smul]

/-- `δAux` of an element of the ideal generated by elements of the kernel lies in any submodule
containing their `δAux`. -/
theorem δAux_mem_of_mem_span {R S T ι κ : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T] [Fintype κ]
    (Q : Algebra.Generators S T ι) (N : Submodule T (T ⊗[S] Ω[S⁄R])) (f : κ → Q.Ring)
    (hf : ∀ j, aeval Q.val (f j) = 0)
    (hfN : ∀ j, Algebra.Generators.H1Cotangent.δAux R Q (f j) ∈ N) (g : Q.Ring)
    (hg : g ∈ Ideal.span (Set.range f)) : Algebra.Generators.H1Cotangent.δAux R Q g ∈ N := by
  obtain ⟨h, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hg
  rw [map_sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  rw [Algebra.Generators.H1Cotangent.δAux_mul, ← algebraMap_smul T (f j),
    Algebra.Generators.algebraMap_apply, hf j, zero_smul, add_zero, ← algebraMap_smul T (h j)]
  exact N.smul_mem _ (hfN j)

variable (p : ℕ) {B B' : Type u} [CommRing B] [CommRing B'] [Algebra B B'] {n : ℕ}
  (b : Fin n → B) (Q : Algebra.Generators B B' (Fin n)) (hker : Q.ker = rootIdeal p b)

include hker in
theorem val_pow_eq (j : Fin n) : Q.val j ^ p = algebraMap B B' (b j) := by
  have hmem : (X j ^ p - C (b j) : MvPolynomial (Fin n) B) ∈ Q.ker :=
    hker ▸ Ideal.subset_span ⟨j, rfl⟩
  rw [Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker, map_sub, map_pow, aeval_X,
    aeval_C, sub_eq_zero] at hmem
  exact hmem

include hker in
/-- The elements `1 ⊗ db_j` lie in the kernel of `B' ⊗_B Ω_{B/ℤ} → Ω_{B'/ℤ}`. -/
theorem mapBaseChange_one_tmul_D (hp : (p : B') = 0) (j : Fin n) :
    KaehlerDifferential.mapBaseChange ℤ B B'
      ((1 : B') ⊗ₜ[B] KaehlerDifferential.D ℤ B (b j)) = 0 := by
  rw [KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D,
    ← val_pow_eq p b Q hker j, pow_char_D p hp, smul_zero]

include hker in
/-- The image of the connecting map `δ : H₁(L_{B'/B}) → B' ⊗_B Ω_{B/ℤ}` is spanned by the
`1 ⊗ db_j`. -/
theorem range_δ_le_span :
    LinearMap.range (Algebra.H1Cotangent.δ ℤ B B') ≤
      Submodule.span B' (Set.range fun j => (1 : B') ⊗ₜ[B] KaehlerDifferential.D ℤ B (b j)) := by
  set S : Submodule B' (B' ⊗[B] Ω[B⁄ℤ]) := Submodule.span B'
    (Set.range fun j => (1 : B') ⊗ₜ[B] KaehlerDifferential.D ℤ B (b j))
  rintro _ ⟨y, rfl⟩
  have hcomp := Algebra.Generators.H1Cotangent.δ_comp_equiv Q (Algebra.Generators.self ℤ B)
    (Algebra.Generators.self B B') (Algebra.Generators.self ℤ B)
  have hy : Algebra.H1Cotangent.δ ℤ B B' y = Algebra.Generators.H1Cotangent.δ Q
      (Algebra.Generators.self ℤ B) (Algebra.Generators.H1Cotangent.equiv _ _ y) :=
    (LinearMap.congr_fun hcomp y).symm
  rw [hy]
  generalize Algebra.Generators.H1Cotangent.equiv _ _ y = z
  obtain ⟨xv, hx⟩ := z
  obtain ⟨⟨g, hg⟩, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective xv
  obtain ⟨g₀, rfl⟩ : ∃ g₀ : MvPolynomial (Fin n) B, g₀ = g := ⟨g, rfl⟩
  have key : Algebra.Generators.H1Cotangent.δAux ℤ Q g₀ ∈ S := by
    have hg' : g₀ ∈ rootIdeal p b := hker ▸ hg
    refine δAux_mem_of_mem_span (R := ℤ) Q S
      (fun j => (X j ^ p - C (b j) : MvPolynomial (Fin n) B)) (fun j => ?_) (fun j => ?_) g₀ hg'
    · rw [map_sub, map_pow, aeval_X, aeval_C, val_pow_eq p b Q hker j, sub_self]
    · have hfj : Algebra.Generators.H1Cotangent.δAux ℤ Q (X j ^ p - C (b j)) =
          -((1 : B') ⊗ₜ[B] KaehlerDifferential.D ℤ B (b j)) := by
        rw [map_sub, Algebra.Generators.H1Cotangent.δAux_C, X_pow_eq_monomial,
          Algebra.Generators.H1Cotangent.δAux_monomial, Derivation.map_one_eq_zero,
          TensorProduct.tmul_zero, zero_sub]
      rw [hfj]
      exact neg_mem (Submodule.subset_span (Set.mem_range_self j))
  exact (Algebra.Generators.H1Cotangent.δ_eq_δAux (R := ℤ) Q (Algebra.Generators.self ℤ B)
    ⟨g₀, hg⟩ hx).symm ▸ key

include hker in
/-- `Ω_{B'/B}` is free on the `d(val j)` (characteristic `p`). -/
theorem exists_kaehler_basis (hp : (p : B') = 0) :
    ∃ e : Module.Basis (Fin n) B' Ω[B'⁄B], ∀ j, e j = KaehlerDifferential.D B B' (Q.val j) := by
  have hspan := Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker (P := Q.toExtension)
    (fun j => (X j ^ p - C (b j) : MvPolynomial (Fin n) B)) hker.symm
  have hcc : Q.toExtension.cotangentComplex = 0 := by
    refine LinearMap.ext_on hspan ?_
    rintro _ ⟨j, rfl⟩
    rw [Algebra.Extension.cotangentComplex_mk, LinearMap.zero_apply]
    have hpd : ∀ i, aeval Q.val (pderiv i (X j ^ p - C (b j) : MvPolynomial (Fin n) B)) = 0 := by
      intro i
      rw [map_sub, Derivation.leibniz_pow, pderiv_C, sub_zero, map_nsmul,
        ← Nat.cast_smul_eq_nsmul B', hp, smul_eq_mul, zero_mul]
    apply Q.cotangentSpaceBasis.repr.injective
    ext i : 1
    rw [Algebra.Generators.cotangentSpaceBasis_repr_one_tmul, map_zero, Finsupp.coe_zero,
      Pi.zero_apply]
    exact hpd i
  have hinj : Function.Injective Q.toExtension.toKaehler := by
    rw [← LinearMap.ker_eq_bot, Q.toExtension.exact_cotangentComplex_toKaehler.linearMap_ker_eq,
      hcc, LinearMap.range_zero]
  let eK := LinearEquiv.ofBijective Q.toExtension.toKaehler
    ⟨hinj, Q.toExtension.toKaehler_surjective⟩
  refine ⟨Q.cotangentSpaceBasis.map eK, fun j => ?_⟩
  rw [Module.Basis.map_apply]
  exact Algebra.Generators.toKaehler_cotangentSpaceBasis j

end Faltings

end Langlands.CommutativeAlgebra.Popescu
