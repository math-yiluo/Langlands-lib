import Mathlib

/-! # Polynomial tools for adding variables mapping to regular parameters -/

namespace Langlands.CommutativeAlgebra.Popescu

namespace RegularParameter

open MvPolynomial

section Monomial

variable {σ R : Type*} [CommSemiring R]

/-- Monomial ideals not involving `X i` are saturated with respect to `X i`
(adapted from Worker 6's draft `ArtinianBottom`). -/
theorem mem_span_monomial_of_X_mul {S : Set (σ →₀ ℕ)} {i : σ} (hS : ∀ m ∈ S, m i = 0)
    {p : MvPolynomial σ R} (h : X i * p ∈ Ideal.span ((fun m => monomial m (1 : R)) '' S)) :
    p ∈ Ideal.span ((fun m => monomial m (1 : R)) '' S) := by
  classical
  rw [mem_ideal_span_monomial_image] at h ⊢
  intro m hm
  obtain ⟨s, hs, hle⟩ := h (Finsupp.single i 1 + m) (by
    rw [support_X_mul]
    exact Finset.mem_map_of_mem _ hm)
  refine ⟨s, hs, fun j => ?_⟩
  by_cases hj : j = i
  · subst hj
    rw [hS s hs]
    exact Nat.zero_le _
  · have := hle j
    simpa [Finsupp.single_apply, Ne.symm hj] using this

end Monomial

/-- The variables of a polynomial ring over any commutative ring form a weakly regular sequence
(adapted from Worker 6's draft `ArtinianBottom`). -/
theorem isWeaklyRegular_X (A : Type*) [CommRing A] (d : ℕ) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin d) A)
      (List.ofFn fun i => (X i : MvPolynomial (Fin d) A)) := by
  rw [RingTheory.Sequence.isWeaklyRegular_iff_Fin]
  intro i
  have hi : (i : ℕ) < d := by simpa using i.2
  set i' : Fin d := ⟨i, hi⟩
  have hget : (List.ofFn fun i => (X i : MvPolynomial (Fin d) A))[i] = X i' := by
    simp [i']
  have hI : Ideal.ofList (List.take (i : ℕ) (List.ofFn fun i => (X i : MvPolynomial (Fin d) A))) =
      Ideal.span ((fun m => monomial m (1 : A)) ''
        ((fun j => Finsupp.single j 1) '' {j : Fin d | j < i'})) := by
    rw [Ideal.ofList]
    congr 1
    ext x
    simp only [Set.mem_ofPred_eq, Set.image_image, Set.mem_image, List.mem_take_iff_getElem,
      List.getElem_ofFn, List.length_ofFn]
    constructor
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨j, by omega⟩, by simp [i', Fin.lt_def]; omega, by simp [X]⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨j, by simp [i', Fin.lt_def] at hj; omega, by simp [X]⟩
  rw [hget, hI]
  intro a b hab
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ b
  simp only [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq, smul_eq_mul] at hab ⊢
  rw [Ideal.mul_top] at hab ⊢
  rw [← mul_sub] at hab
  refine mem_span_monomial_of_X_mul (i := i') ?_ hab
  rintro _ ⟨j, hj, rfl⟩
  rw [Finsupp.single_apply, ite_eq_right_iff.mpr fun h => absurd h (ne_of_lt hj)]

variable (k : Type*) [CommRing k] (t r : ℕ)

/-- The variables `z_j = X (Fin.natAdd t j)` of `k[y₁, …, y_t, z₁, …, z_r]`. -/
noncomputable abbrev zVar (j : Fin r) : MvPolynomial (Fin (t + r)) k := X (Fin.natAdd t j)

/-- The retraction `k[y, z] → k[y]` killing the `z_j`. -/
noncomputable def killZ : MvPolynomial (Fin (t + r)) k →ₐ[k] MvPolynomial (Fin t) k :=
  aeval (Fin.append (fun i => X i) (fun _ => 0))

theorem killZ_castAdd (i : Fin t) : killZ k t r (X (Fin.castAdd r i)) = X i := by
  simp [killZ, Fin.append_left]

theorem killZ_natAdd (j : Fin r) : killZ k t r (X (Fin.natAdd t j)) = 0 := by
  simp [killZ, Fin.append_right]

/-- Every polynomial is congruent modulo the `z_j` to its image in `k[y]`. -/
theorem sub_rename_killZ_mem (f : MvPolynomial (Fin (t + r)) k) :
    f - rename (Fin.castAdd r) (killZ k t r f) ∈ Ideal.span (Set.range (zVar k t r)) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    rw [map_add, map_add, add_sub_add_comm]
    exact add_mem hp hq
  | mul_X p n hp =>
    have hX : X n - rename (Fin.castAdd r) (killZ k t r (X n)) ∈
        Ideal.span (Set.range (zVar k t r)) := by
      refine Fin.addCases (fun i => ?_) (fun j => ?_) n
      · rw [killZ_castAdd, rename_X, sub_self]
        exact zero_mem _
      · rw [killZ_natAdd, map_zero, sub_zero]
        exact Ideal.subset_span ⟨j, rfl⟩
    have : p * X n - rename (Fin.castAdd r) (killZ k t r (p * X n)) =
        (p - rename (Fin.castAdd r) (killZ k t r p)) * X n +
          rename (Fin.castAdd r) (killZ k t r p) *
            (X n - rename (Fin.castAdd r) (killZ k t r (X n))) := by
      rw [map_mul, map_mul]
      ring
    rw [this]
    exact add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ hX)

/-- The preimage of a prime, when the `z_j` map into it, is generated by the preimage in `k[y]`
and the `z_j`. -/
theorem comap_eq_map_sup_span {Λ : Type*} [CommRing Λ] [Algebra k Λ] (q : Ideal Λ)
    (φ : MvPolynomial (Fin (t + r)) k →ₐ[k] Λ) (hz : ∀ j, φ (zVar k t r j) ∈ q) :
    q.comap (φ : MvPolynomial (Fin (t + r)) k →+* Λ) =
      (q.comap ((φ.comp (rename (Fin.castAdd r))) : MvPolynomial (Fin t) k →+* Λ)).map
        ((rename (Fin.castAdd r) : MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
          MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k) ⊔
      Ideal.span (Set.range (zVar k t r)) := by
  apply le_antisymm
  · intro f hf
    have hZ := sub_rename_killZ_mem k t r f
    have hZq : Ideal.span (Set.range (zVar k t r)) ≤
        q.comap (φ : MvPolynomial (Fin (t + r)) k →+* Λ) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hz j
    have h1 : killZ k t r f ∈
        q.comap ((φ.comp (rename (Fin.castAdd r))) : MvPolynomial (Fin t) k →+* Λ) := by
      have h2 : rename (Fin.castAdd r) (killZ k t r f) =
          f - (f - rename (Fin.castAdd r) (killZ k t r f)) := by ring
      show φ (rename (Fin.castAdd r) (killZ k t r f)) ∈ q
      rw [h2, map_sub]
      exact q.sub_mem hf (hZq hZ)
    have h3 : f = rename (Fin.castAdd r) (killZ k t r f) +
        (f - rename (Fin.castAdd r) (killZ k t r f)) := by ring
    rw [h3]
    exact Submodule.add_mem_sup (Ideal.mem_map_of_mem _ h1) hZ
  · apply sup_le
    · rw [Ideal.map_le_iff_le_comap]
      intro g hg
      exact hg
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hz j

/-- The isomorphism `k[y, z] ≃ (k[y])[z]`. -/
noncomputable def splitEquiv :
    MvPolynomial (Fin (t + r)) k ≃ₐ[k] MvPolynomial (Fin r) (MvPolynomial (Fin t) k) :=
  (renameEquiv k (finSumFinEquiv.symm.trans (Equiv.sumComm (Fin t) (Fin r)))).trans
    (sumAlgEquiv k (Fin r) (Fin t))

theorem splitEquiv_castAdd (i : Fin t) :
    splitEquiv k t r (X (Fin.castAdd r i)) = C (X i) := by
  simp [splitEquiv, finSumFinEquiv_symm_apply_castAdd, sumAlgEquiv_X_inr]

theorem splitEquiv_natAdd (j : Fin r) : splitEquiv k t r (X (Fin.natAdd t j)) = X j := by
  simp [splitEquiv, finSumFinEquiv_symm_apply_natAdd, sumAlgEquiv_X_inl]

theorem splitEquiv_comp_rename :
    ((splitEquiv k t r).toRingEquiv : MvPolynomial (Fin (t + r)) k →+*
        MvPolynomial (Fin r) (MvPolynomial (Fin t) k)).comp
      ((rename (Fin.castAdd r) : MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
        MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k) = C := by
  apply MvPolynomial.ringHom_ext
  · intro a
    simp [splitEquiv]
  · intro i
    simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe, rename_X]
    exact splitEquiv_castAdd k t r i

/-- The extension `I k[y, z]` of an ideal `I ⊂ k[y]`. -/
noncomputable abbrev extIdeal (I : Ideal (MvPolynomial (Fin t) k)) :
    Ideal (MvPolynomial (Fin (t + r)) k) :=
  I.map ((rename (Fin.castAdd r) : MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
    MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)

/-- The `z_j` form a weakly regular sequence on `k[y, z]/I k[y, z]` for any ideal `I ⊂ k[y]`. -/
theorem isWeaklyRegular_quot (I : Ideal (MvPolynomial (Fin t) k)) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin (t + r)) k ⧸ extIdeal k t r I)
      (List.ofFn fun j => Ideal.Quotient.mk (extIdeal k t r I) (zVar k t r j)) := by
  have hmap : I.map (C : MvPolynomial (Fin t) k →+* MvPolynomial (Fin r) (MvPolynomial (Fin t) k)) =
      (I.map ((rename (Fin.castAdd r) :
        MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
          MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)).map
        ((splitEquiv k t r).toRingEquiv : MvPolynomial (Fin (t + r)) k →+* _) := by
    rw [Ideal.map_map, splitEquiv_comp_rename]
  let χ₁ := Ideal.quotientEquiv (I.map ((rename (Fin.castAdd r) :
        MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
          MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k))
    (I.map (C : MvPolynomial (Fin t) k →+* MvPolynomial (Fin r) (MvPolynomial (Fin t) k)))
    (splitEquiv k t r).toRingEquiv hmap
  let χ₂ := (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin r) I).symm.toRingEquiv
  let χ := χ₁.trans χ₂
  have hχ : ∀ j, χ (Ideal.Quotient.mk (extIdeal k t r I) (zVar k t r j)) = X j := by
    intro j
    show χ₂ (Ideal.Quotient.mk _ (splitEquiv k t r (X (Fin.natAdd t j)))) = X j
    rw [splitEquiv_natAdd]
    show (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin r) I).symm
      (Ideal.Quotient.mk _ (X j)) = X j
    rw [AlgEquiv.symm_apply_eq]
    simp [MvPolynomial.quotientEquivQuotientMvPolynomial]
  have h := isWeaklyRegular_X (MvPolynomial (Fin t) k ⧸ I) r
  have hlist : (List.ofFn fun i => (X i : MvPolynomial (Fin r) (MvPolynomial (Fin t) k ⧸ I))) =
      (List.ofFn fun j => Ideal.Quotient.mk (extIdeal k t r I) (zVar k t r j)).map χ := by
    rw [List.map_ofFn]
    congr 1
    funext j
    exact (hχ j).symm
  rw [hlist] at h
  exact (χ.toAddEquiv.isWeaklyRegular_congr (List.forall₂_map_right_iff.mpr
    (List.forall₂_same.mpr fun a _ x => map_mul χ a x))).mpr h

/-- Transport of a weakly regular family on a quotient along an equality of ideals. -/
theorem isWeaklyRegular_transport {R : Type*} [CommRing R] {I J : Ideal R} (h : I = J) {n : ℕ}
    (f : Fin n → R)
    (hreg : RingTheory.Sequence.IsWeaklyRegular (R ⧸ J)
      (List.ofFn fun j => Ideal.Quotient.mk J (f j))) :
    RingTheory.Sequence.IsWeaklyRegular (R ⧸ I) (List.ofFn fun j => Ideal.Quotient.mk I (f j)) := by
  subst h
  exact hreg

end RegularParameter

end Langlands.CommutativeAlgebra.Popescu
