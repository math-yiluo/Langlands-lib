import Langlands.CommutativeAlgebra.Popescu.AnnihilatorStabilizationStatement
import Langlands.CommutativeAlgebra.Popescu.CharPRegular
import Langlands.MathlibBase

/-! # Step (12) of the proof of Stacks Lemma 16.11.4 (07FJ): annihilators of `γᵢ = πᵢ tᵢ` -/

universe u

namespace Langlands.CommutativeAlgebra.Popescu.CharP

open MvPolynomial

section Coefficients

variable {K : Type*} [CommRing K] {d : ℕ}

theorem gamma_pow_eq (ρ : Fin d → K) (e : ℕ) (j : Fin d) :
    (C (ρ j) * X j : MvPolynomial (Fin d) K) ^ e = monomial (Finsupp.single j e) (ρ j ^ e) := by
  rw [mul_pow, ← map_pow, X_pow_eq_monomial, C_mul_monomial, mul_one]

/-- Membership in the ideal `((ρⱼ tⱼ)ᵉ : j ∈ T)` of `K[t₁, …, t_d]`, coefficientwise: the
coefficient of `t^α` must lie in the ideal of `K` generated by the `ρⱼᵉ` with `j ∈ T` and
`e ≤ αⱼ`. -/
theorem mem_span_gamma_iff (ρ : Fin d → K) (e : ℕ) (T : Finset (Fin d))
    (x : MvPolynomial (Fin d) K) :
    x ∈ Ideal.span ((fun j => (C (ρ j) * X j) ^ e) '' (T : Set (Fin d))) ↔
      ∀ α : Fin d →₀ ℕ, x.coeff α ∈
        Ideal.span ((fun j => ρ j ^ e) '' ((T.filter (fun j => e ≤ α j) : Finset (Fin d)) :
          Set (Fin d))) := by
  classical
  constructor
  · intro hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      intro α
      dsimp only
      rw [gamma_pow_eq, coeff_monomial]
      split_ifs with h
      · apply Ideal.subset_span
        refine ⟨j, ?_, rfl⟩
        rw [Finset.coe_filter]
        refine ⟨hj, ?_⟩
        rw [← h, Finsupp.single_eq_same]
      · exact zero_mem _
    | zero => intro α; simp
    | add y z _ _ hy hz =>
      intro α
      have : (y + z).coeff α = y.coeff α + z.coeff α := by simp
      rw [this]; exact add_mem (hy α) (hz α)
    | smul a y _ hy =>
      intro α
      rw [smul_eq_mul, coeff_mul]
      refine Ideal.sum_mem _ fun p hp => ?_
      refine Ideal.mul_mem_left _ _ ?_
      have hle : p.2 ≤ α := by
        rw [← (Finset.HasAntidiagonal.mem_antidiagonal.mp hp)]; exact le_add_self
      refine Ideal.span_mono ?_ (hy p.2)
      refine Set.image_mono ?_
      intro j hj
      rw [Finset.coe_filter] at hj ⊢
      exact ⟨hj.1, hj.2.trans (hle j)⟩
  · intro hx
    have key : ∀ (α : Fin d →₀ ℕ) (c : K),
        c ∈ Ideal.span ((fun j => ρ j ^ e) '' ((T.filter (fun j => e ≤ α j) : Finset (Fin d)) :
          Set (Fin d))) →
        monomial α c ∈ Ideal.span ((fun j => (C (ρ j) * X j) ^ e) '' (T : Set (Fin d))) := by
      intro α c hc
      induction hc using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨j, hj, rfl⟩ := hy
        rw [Finset.coe_filter] at hj
        have hle : Finsupp.single j e ≤ α := Finsupp.single_le_iff.mpr hj.2
        have : monomial α (ρ j ^ e) =
            monomial (α - Finsupp.single j e) (1 : K) * (C (ρ j) * X j) ^ e := by
          rw [gamma_pow_eq, monomial_mul_monomial, tsub_add_cancel_of_le hle, one_mul]
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, hj.1, rfl⟩)
      | zero => rw [map_zero]; exact zero_mem _
      | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
      | smul a y _ hy =>
        rw [smul_eq_mul, ← C_mul_monomial]
        exact Ideal.mul_mem_left _ _ hy
    rw [x.as_sum]
    exact Ideal.sum_mem _ fun α _ => key α _ (hx α)

/-- Step (12), transfer from `K` to `K[t₁, …, t_d]`: if `ρᵢ` satisfies the annihilator condition
modulo `(ρⱼᵉ : j ∈ T')` in `K` for every `T' ⊆ T` (with `i ∉ T`), then `γᵢ = ρᵢ tᵢ` satisfies it
modulo `(γⱼᵉ : j ∈ T)` in `K[t₁, …, t_d]`. -/
theorem gamma_annihilator (ρ : Fin d → K) (e : ℕ) (T : Finset (Fin d)) (i : Fin d) (hi : i ∉ T)
    (h : ∀ T' ⊆ T, ∀ y : K, ρ i ^ 2 * y ∈ Ideal.span ((fun j => ρ j ^ e) '' (T' : Set (Fin d))) →
      ρ i * y ∈ Ideal.span ((fun j => ρ j ^ e) '' (T' : Set (Fin d))))
    (x : MvPolynomial (Fin d) K)
    (hx : (C (ρ i) * X i) ^ 2 * x ∈
      Ideal.span ((fun j => (C (ρ j) * X j) ^ e) '' (T : Set (Fin d)))) :
    C (ρ i) * X i * x ∈ Ideal.span ((fun j => (C (ρ j) * X j) ^ e) '' (T : Set (Fin d))) := by
  classical
  rw [mem_span_gamma_iff] at hx ⊢
  intro β
  have e1 : (C (ρ i) * X i : MvPolynomial (Fin d) K) = monomial (Finsupp.single i 1) (ρ i) := by
    rw [X, C_mul_monomial, mul_one]
  rw [e1, coeff_monomial_mul']
  split_ifs with hle
  · have h1 : 1 ≤ β i := Finsupp.single_le_iff.mp hle
    have h2 : Finsupp.single i 2 ≤ β + Finsupp.single i 1 := by
      rw [Finsupp.single_le_iff, Finsupp.add_apply, Finsupp.single_eq_same]; omega
    have h3 : β + Finsupp.single i 1 - Finsupp.single i 2 = β - Finsupp.single i 1 := by
      ext j
      rcases eq_or_ne i j with rfl | hij
      · simp only [Finsupp.coe_tsub, Finsupp.coe_add, Pi.sub_apply, Pi.add_apply,
          Finsupp.single_eq_same]
        omega
      · simp only [Finsupp.coe_tsub, Finsupp.coe_add, Pi.sub_apply, Pi.add_apply,
          Finsupp.single_eq_of_ne hij.symm]
        omega
    have h4 : T.filter (fun j => e ≤ (β + Finsupp.single i 1 : Fin d →₀ ℕ) j) =
        T.filter (fun j => e ≤ β j) := by
      refine Finset.filter_congr fun j hj => ?_
      have hij : j ≠ i := fun h => hi (h ▸ hj)
      rw [Finsupp.add_apply, Finsupp.single_eq_of_ne hij, add_zero]
    have := hx (β + Finsupp.single i 1)
    rw [gamma_pow_eq, coeff_monomial_mul'] at this
    split_ifs at this
    rw [h3, h4] at this
    exact h _ (Finset.filter_subset _ _) _ this
  · exact zero_mem _

end Coefficients

/-- Step (12) of Stacks 07FJ in `K`: after multiplying each `πᵢ` by some `sᵢ ∉ 𝔭`, `sᵢπᵢ`
satisfies the annihilator condition modulo `((sⱼπⱼ)ᵉ : j ∈ T)` for every `T` with `j < i` for
all `j ∈ T`, given regularity of `πᵢ` modulo `(πⱼᵉ : j ∈ T)` in `K_𝔭` for `i ∉ T`. -/
theorem exists_step12 (hOg : AnnihilatorStabilizationStatement.{u}) {K : Type u} [CommRing K]
    [IsNoetherianRing K] (𝔭 : Ideal K) [𝔭.IsPrime] {d : ℕ} (π : Fin d → K) (e : ℕ)
    (hreg : ∀ (T : Finset (Fin d)) (i : Fin d), i ∉ T → ∀ y : Localization.AtPrime 𝔭,
      algebraMap K (Localization.AtPrime 𝔭) (π i) * y ∈
        Ideal.span ((fun j => algebraMap K (Localization.AtPrime 𝔭) (π j) ^ e) ''
          (T : Set (Fin d))) →
      y ∈ Ideal.span ((fun j => algebraMap K (Localization.AtPrime 𝔭) (π j) ^ e) ''
          (T : Set (Fin d)))) :
    ∃ s : Fin d → K, (∀ i, s i ∉ 𝔭) ∧ ∀ (i : Fin d) (T : Finset (Fin d)), (∀ j ∈ T, j < i) →
      ∀ y : K, (s i * π i) ^ 2 * y ∈ Ideal.span ((fun j => (s j * π j) ^ e) '' (T : Set (Fin d))) →
        s i * π i * y ∈ Ideal.span ((fun j => (s j * π j) ^ e) '' (T : Set (Fin d))) := by
  classical
  suffices H : ∀ t ≤ d, ∃ s : Fin d → K, (∀ i, s i ∉ 𝔭) ∧ ∀ (i : Fin d), i.val < t →
      ∀ (T : Finset (Fin d)), (∀ j ∈ T, j < i) → ∀ y : K,
        (s i * π i) ^ 2 * y ∈ Ideal.span ((fun j => (s j * π j) ^ e) '' (T : Set (Fin d))) →
        s i * π i * y ∈ Ideal.span ((fun j => (s j * π j) ^ e) '' (T : Set (Fin d))) by
    obtain ⟨s, hs, h⟩ := H d le_rfl
    exact ⟨s, hs, fun i => h i i.2⟩
  intro t
  induction t with
  | zero =>
    intro _
    exact ⟨fun _ => 1, fun _ => 𝔭.primeCompl.one_mem, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  | succ t ih =>
    intro ht
    obtain ⟨s, hs, h⟩ := ih (Nat.le_of_succ_le ht)
    let i₀ : Fin d := ⟨t, ht⟩
    have hO : ∀ T : Finset (Fin d), ∃ σ ∈ 𝔭.primeCompl, i₀ ∉ T → ∀ τ ∈ 𝔭.primeCompl,
        ∀ m : K ⧸ Ideal.span ((fun j => (s j * π j) ^ e) '' (T : Set (Fin d))),
          (τ * σ * (s i₀ * π i₀)) ^ 2 • m = 0 → (τ * σ * (s i₀ * π i₀)) • m = 0 := by
      intro T
      by_cases hT : i₀ ∈ T
      · exact ⟨1, 𝔭.primeCompl.one_mem, fun h' => absurd hT h'⟩
      · obtain ⟨σ, hσ, hσ'⟩ := hOg K
          (K ⧸ Ideal.span ((fun j => (s j * π j) ^ e) '' (T : Set (Fin d)))) 𝔭.primeCompl
          (s i₀ * π i₀) (fun m hm => ogoma_hyp 𝔭 π e T i₀ (hreg T i₀ hT) s hs (s i₀) (hs i₀) m hm)
        exact ⟨σ, hσ, fun _ => hσ'⟩
    choose σ hσ hσ' using hO
    have hσ₀ : (∏ T, σ T) ∈ 𝔭.primeCompl := prod_mem fun T _ => hσ T
    refine ⟨Function.update s i₀ ((∏ T, σ T) * s i₀), ?_, ?_⟩
    · intro i
      by_cases hi : i = i₀
      · subst hi
        rw [Function.update_self]
        exact 𝔭.primeCompl.mul_mem hσ₀ (hs _)
      · rw [Function.update_of_ne hi]
        exact hs i
    · intro i hi T hT y hy
      have hJ : (fun j => (Function.update s i₀ ((∏ T, σ T) * s i₀) j * π j) ^ e) ''
          (T : Set (Fin d)) = (fun j => (s j * π j) ^ e) '' (T : Set (Fin d)) := by
        refine Set.image_congr fun j hj => ?_
        have hji : j.val < t := lt_of_lt_of_le (hT j hj) (Nat.le_of_lt_succ hi)
        have hne : j ≠ i₀ := fun h' => by rw [h'] at hji; exact lt_irrefl _ hji
        simp only [Function.update_of_ne hne]
      rw [hJ] at hy ⊢
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
      · have hne : i ≠ i₀ := fun h' => by rw [h'] at hlt; exact lt_irrefl _ hlt
        rw [Function.update_of_ne hne] at hy ⊢
        exact h i hlt T hT y hy
      · have hii : i = i₀ := Fin.ext heq
        subst hii
        rw [Function.update_self] at hy ⊢
        have hi₀T : i₀ ∉ T := fun h' => lt_irrefl _ (hT _ h')
        have hprod : (∏ T, σ T) = (∏ T' ∈ Finset.univ.erase T, σ T') * σ T :=
          (Finset.prod_erase_mul _ _ (Finset.mem_univ T)).symm
        have hτ : (∏ T' ∈ Finset.univ.erase T, σ T') ∈ 𝔭.primeCompl :=
          prod_mem fun T' _ => hσ T'
        have key := hσ' T hi₀T _ hτ (Ideal.Quotient.mk _ y)
        simp only [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
          Ideal.Quotient.eq_zero_iff_mem] at key
        have e1 : (∏ T, σ T) * s i₀ * π i₀ =
            (∏ T' ∈ Finset.univ.erase T, σ T') * σ T * (s i₀ * π i₀) := by
          rw [hprod]; ring
        rw [e1] at hy ⊢
        exact key hy

/-- Step (12) of Stacks 07FJ in `R = K[t₁, …, t_d]` with `γᵢ = sᵢπᵢtᵢ`:
`Ann_{R/(γⱼᵉ : j < i)}(γᵢ) = Ann_{R/(γⱼᵉ : j < i)}(γᵢ²)`. -/
theorem exists_step12_poly (hOg : AnnihilatorStabilizationStatement.{u}) {K : Type u}
    [CommRing K] [IsNoetherianRing K] (𝔭 : Ideal K) [𝔭.IsPrime] {d : ℕ} (π : Fin d → K) (e : ℕ)
    (hreg : ∀ (T : Finset (Fin d)) (i : Fin d), i ∉ T → ∀ y : Localization.AtPrime 𝔭,
      algebraMap K (Localization.AtPrime 𝔭) (π i) * y ∈
        Ideal.span ((fun j => algebraMap K (Localization.AtPrime 𝔭) (π j) ^ e) ''
          (T : Set (Fin d))) →
      y ∈ Ideal.span ((fun j => algebraMap K (Localization.AtPrime 𝔭) (π j) ^ e) ''
          (T : Set (Fin d)))) :
    ∃ s : Fin d → K, (∀ i, s i ∉ 𝔭) ∧ ∀ (i : Fin d) (x : MvPolynomial (Fin d) K),
      (C (s i * π i) * X i) ^ 2 * x ∈
        Ideal.span ((fun j => (C (s j * π j) * X j) ^ e) '' {j | j < i}) →
      C (s i * π i) * X i * x ∈
        Ideal.span ((fun j => (C (s j * π j) * X j) ^ e) '' {j | j < i}) := by
  classical
  obtain ⟨s, hs, h⟩ := exists_step12 hOg 𝔭 π e hreg
  refine ⟨s, hs, fun i x hx => ?_⟩
  have hset : ({j | j < i} : Set (Fin d)) = ((Finset.univ.filter (· < i) : Finset (Fin d)) :
      Set (Fin d)) := by
    rw [Finset.coe_filter_univ]
  rw [hset] at hx ⊢
  refine gamma_annihilator (fun j => s j * π j) e _ i (by simp) (fun T' hT' y hy => ?_) x hx
  refine h i T' (fun j hj => ?_) y hy
  simpa using hT' hj

end Langlands.CommutativeAlgebra.Popescu.CharP
