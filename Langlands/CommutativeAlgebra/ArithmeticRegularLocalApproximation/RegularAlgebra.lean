import Langlands.CommutativeAlgebra.RegularRingMaps
import Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation.ResidueFields

/-! # Regular maps from rings generated by the integers to regular local rings -/

universe u v

open IsLocalRing TensorProduct

namespace Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation

/-- A quotient of a localization of a regular local ring by the extension of `⊥`, of the
maximal ideal, or of `⊤` is a regular local ring as soon as it is nontrivial. -/
theorem isRegularLocalRing_quotient_map_localization {Λ : Type v} [CommRing Λ] [IsLocalRing Λ]
    [IsRegularRing Λ] (I : Ideal Λ) (hI : I = ⊥ ∨ I = maximalIdeal Λ ∨ I = ⊤)
    (r : Ideal Λ) [r.IsPrime]
    [Nontrivial (Localization.AtPrime r ⧸ I.map (algebraMap Λ (Localization.AtPrime r)))] :
    IsRegularLocalRing (Localization.AtPrime r ⧸ I.map (algebraMap Λ (Localization.AtPrime r))) := by
  rcases hI with rfl | rfl | rfl
  · rw [Ideal.map_bot]
    exact IsRegularLocalRing.of_ringEquiv (RingEquiv.quotientBot _).symm
  · have hne : (maximalIdeal Λ).map (algebraMap Λ (Localization.AtPrime r)) ≠ ⊤ :=
      Ideal.Quotient.nontrivial_iff.mp ‹_›
    have hle : (maximalIdeal Λ).map (algebraMap Λ (Localization.AtPrime r)) ≤
        maximalIdeal (Localization.AtPrime r) := le_maximalIdeal hne
    have hge : maximalIdeal (Localization.AtPrime r) ≤
        (maximalIdeal Λ).map (algebraMap Λ (Localization.AtPrime r)) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.map_mono (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›))
    have heq := le_antisymm hle hge
    have : IsRegularLocalRing (ResidueField (Localization.AtPrime r)) := inferInstance
    exact IsRegularLocalRing.of_ringEquiv (R := ResidueField (Localization.AtPrime r))
      (Ideal.quotEquivOfEq heq.symm)
  · exact (Ideal.Quotient.nontrivial_iff.mp ‹_› (Ideal.map_top _)).elim

/-- Let `R₀` be a ring all of whose elements are integers and `Λ` a regular local ring which is
flat over `R₀`. If every prime of `R₀` extends to `⊥`, to the maximal ideal or to `⊤` in `Λ`,
then `R₀ → Λ` is a regular map. -/
theorem regularAlgebra_of_isLocalRing {R₀ : Type u} {Λ : Type v} [CommRing R₀] [CommRing Λ]
    [Algebra R₀ Λ] [IsLocalRing Λ] [IsRegularRing Λ] [Module.Flat R₀ Λ]
    (hR₀ : Function.Surjective (Int.castRingHom R₀))
    (hΛ : ∀ 𝔭 : Ideal R₀, 𝔭.IsPrime → 𝔭.map (algebraMap R₀ Λ) = ⊥ ∨
      𝔭.map (algebraMap R₀ Λ) = maximalIdeal Λ ∨ 𝔭.map (algebraMap R₀ Λ) = ⊤) :
    RegularAlgebra R₀ Λ := by
  refine ⟨‹_›, fun 𝔭 h𝔭 => ?_⟩
  have hperf : PerfectField 𝔭.ResidueField := perfectField_residueField hR₀ 𝔭
  let _ : Algebra Λ (𝔭.Fiber Λ) := Algebra.TensorProduct.rightAlgebra
  have hnoeth : IsNoetherianRing (𝔭.Fiber Λ) :=
    isNoetherianRing_of_ringEquiv _ (Ideal.Fiber.algEquivAux₁ 𝔭).symm.toRingEquiv
  have hreg : IsRegularRing (𝔭.Fiber Λ) := by
    rw [isRegularRing_iff]
    intro q hq
    let e := Ideal.Fiber.algEquivAux₂ 𝔭 (S := Λ) q
    have : Nontrivial (Localization.AtPrime (q.comap Algebra.TensorProduct.includeRight) ⧸
        (𝔭.map (algebraMap R₀ Λ)).map
          (algebraMap Λ (Localization.AtPrime (q.comap Algebra.TensorProduct.includeRight)))) :=
      e.toRingEquiv.symm.nontrivial
    have := isRegularLocalRing_quotient_map_localization (𝔭.map (algebraMap R₀ Λ)) (hΛ 𝔭 h𝔭)
      (q.comap Algebra.TensorProduct.includeRight)
    exact IsRegularLocalRing.of_ringEquiv e.toRingEquiv.symm
  refine ⟨hnoeth, fun k' _ _ _ _ => ?_⟩
  have hb : Function.Bijective (algebraMap 𝔭.ResidueField k') :=
    IsPurelyInseparable.bijective_algebraMap_of_isSeparable _ _
  let e : 𝔭.ResidueField ≃ₐ[𝔭.ResidueField] k' := AlgEquiv.ofBijective (Algebra.ofId _ _) hb
  exact IsRegularRing.of_ringEquiv ((Algebra.TensorProduct.lid _ (𝔭.Fiber Λ)).symm.trans
    (Algebra.TensorProduct.congr e AlgEquiv.refl)).toRingEquiv

/-- Let `R₀` be a ring all of whose elements are integers. If every prime number `n` becomes
zero, a unit, or a generator of the maximal ideal in the local ring `Λ`, then every prime of `R₀`
extends to `⊥`, to the maximal ideal or to `⊤` in `Λ`. -/
theorem map_prime_eq_of_intCast {R₀ : Type u} {Λ : Type v} [CommRing R₀] [CommRing Λ]
    [Algebra R₀ Λ] [IsLocalRing Λ] (hR₀ : Function.Surjective (Int.castRingHom R₀))
    (hΛ : ∀ n : ℤ, Prime n →
      (n : Λ) = 0 ∨ IsUnit (n : Λ) ∨ Ideal.span {(n : Λ)} = maximalIdeal Λ)
    (𝔭 : Ideal R₀) (h𝔭 : 𝔭.IsPrime) : 𝔭.map (algebraMap R₀ Λ) = ⊥ ∨
      𝔭.map (algebraMap R₀ Λ) = maximalIdeal Λ ∨ 𝔭.map (algebraMap R₀ Λ) = ⊤ := by
  have h1 : (𝔭.comap (Int.castRingHom R₀)).map (Int.castRingHom R₀) = 𝔭 :=
    Ideal.map_comap_of_surjective _ hR₀ 𝔭
  obtain ⟨n, hn⟩ := (IsPrincipalIdealRing.principal (𝔭.comap (Int.castRingHom R₀))).principal
  have hmap : 𝔭.map (algebraMap R₀ Λ) = Ideal.span {(n : Λ)} := by
    rw [← h1, Ideal.map_map, hn, Ideal.submodule_span_eq, Ideal.map_span, Set.image_singleton]
    simp
  have hprime : (Ideal.span {n}).IsPrime := by
    rw [← Ideal.submodule_span_eq, ← hn]
    exact Ideal.comap_isPrime _ _
  rw [hmap]
  by_cases hn0 : n = 0
  · left
    simp [hn0]
  rcases hΛ n ((Ideal.span_singleton_prime hn0).mp hprime) with h | h | h
  · left
    simp [h]
  · right; right
    exact Ideal.span_singleton_eq_top.mpr h
  · right; left
    exact h

end Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation
