import Langlands.CommutativeAlgebra.Popescu.PopescuFactorizationProof
import Langlands.CommutativeAlgebra.SmoothDVRFactorialLocalizationsProof
import Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation.Chart
import Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation.LocalChart
import Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation.Factorization
import Mathlib.Algebra.Polynomial.Lifts

/-! # Regular local charts from a presentation of a complete discrete valuation ring -/

universe u w

open IsLocalRing Polynomial

namespace Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation

/-- A polynomial all of whose coefficients lie in a subalgebra comes from a polynomial over
that subalgebra. -/
theorem exists_map_eq_of_coeff_mem {R₀ Λ : Type*} [CommRing R₀] [CommRing Λ] [Algebra R₀ Λ]
    (E : Subalgebra R₀ Λ) (q : Λ[X]) (hq : ∀ k, q.coeff k ∈ E) :
    ∃ q' : E[X], q'.map (algebraMap E Λ) = q :=
  (mem_lifts q).mp ((lifts_iff_coeff_lifts q).mpr fun k => ⟨⟨_, hq k⟩, rfl⟩)

/-- Let `W'` be a complete discrete valuation ring with uniformizer `ϖ`, let `R₀` be a regular
ring all of whose elements are integers, and let `Λ` be a Noetherian local ring with a regular
algebra map `R₀ → Λ` and a local homomorphism `ψ : Λ → W'`. Suppose that `W'` is presented
over `Λ` by `ϖ` and one monic equation `F ∈ Λ[X]`: evaluation at `ϖ` maps `Λ[X]` onto `W'`,
its kernel is generated by `F`, and the constant coefficient of `F` is not in `𝔪_Λ²`. Then
every ring map from a finite type `ℤ`-algebra to `Frac W'` factors through a regular local
chart as in `ChartConclusion`. -/
theorem chartConclusion_of_presentation
    {W' : Type u} [CommRing W'] [IsDomain W'] [IsDiscreteValuationRing W']
    [IsAdicComplete (maximalIdeal W') W'] {ϖ : W'} (hϖ : Irreducible ϖ)
    {R₀ : Type u} [CommRing R₀] [IsRegularRing R₀]
    (hR₀ : Function.Surjective (Int.castRingHom R₀))
    {Λ : Type u} [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ] [Algebra R₀ Λ]
    (hΛ : RegularAlgebra R₀ Λ) (ψ : Λ →+* W') [IsLocalHom ψ]
    (F : Λ[X]) (hFm : F.Monic) (hFϖ : eval₂ ψ ϖ F = 0) (hF0 : F.coeff 0 ∉ maximalIdeal Λ ^ 2)
    (hsurj : ∀ y : W', ∃ q : Λ[X], eval₂ ψ ϖ q = y)
    (hdvd : ∀ q : Λ[X], eval₂ ψ ϖ q = 0 → F ∣ q)
    (C : Type w) [CommRing C] [Algebra.FiniteType ℤ C] (F' : C →+* FractionRing W') :
    ChartConclusion W' C F' := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := ℤ) (A := C)
  have hfrac (c : C) : ∃ (a : W') (n : ℕ),
      F' c * algebraMap W' (FractionRing W') (ϖ ^ n) = algebraMap W' (FractionRing W') a :=
    exists_mul_pow_eq_algebraMap hϖ (F' c)
  choose a n ha using hfrac
  choose q hq using fun c => hsurj (a c)
  -- The finitely generated subalgebra `E ⊆ Λ` containing all coefficients involved.
  let T : Finset Λ := F.coeffs ∪ s.biUnion fun c => (q c).coeffs
  let E : Subalgebra R₀ Λ := Algebra.adjoin R₀ (T : Set Λ)
  have hcoeff (p : Λ[X]) (hp : p.coeffs ⊆ T) (k : ℕ) : p.coeff k ∈ E := by
    by_cases hk : p.coeff k = 0
    · rw [hk]
      exact zero_mem E
    · exact Algebra.subset_adjoin (hp (coeff_mem_coeffs hk))
  have : Algebra.FiniteType R₀ E :=
    (Subalgebra.fg_iff_finiteType E).mp (Subalgebra.fg_adjoin_finset T)
  -- Popescu: `E → Λ` factors through a smooth `R₀`-algebra `D`.
  obtain ⟨D, _, _, hsm, g, h, hgh⟩ := Popescu.popescuFactorization R₀ Λ hΛ E E.val
  have : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing R₀ D
  have : IsRegularRing D := (isRegularRing_iff (R := D)).mpr fun p _ =>
    SmoothDVRFactorialLocalizationsProof.regularLocal_localization_of_smooth R₀ D p
  let ιE : E →+* Λ := algebraMap E Λ
  have hιE : Function.Injective ιE := Subtype.val_injective
  have hhg : (h : D →+* Λ).comp (g : E →+* D) = ιE :=
    RingHom.ext fun x => AlgHom.congr_fun hgh x
  obtain ⟨FE, hFE⟩ := exists_map_eq_of_coeff_mem E F (hcoeff F Finset.subset_union_left)
  have hFEm : FE.Monic := monic_of_injective hιE (by rw [hFE]; exact hFm)
  have hq' (c : C) (hc : c ∈ s) : ∃ q' : E[X], q'.map ιE = q c :=
    exists_map_eq_of_coeff_mem E (q c) (hcoeff _ fun x hx =>
      Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨c, hc, hx⟩))
  let Θ : E[X] →+* W' := eval₂RingHom (ψ.comp ιE) ϖ
  have hΘ (p : E[X]) : Θ p = eval₂ ψ ϖ (p.map ιE) := by
    rw [eval₂_map]
    rfl
  have hΘX : Θ X = ϖ := eval₂_X _ _
  -- The regular local chart.
  have hFD : eval₂ (ψ.comp (h : D →+* Λ)) ϖ (FE.map (g : E →+* D)) = 0 := by
    rw [eval₂_map, RingHom.comp_assoc, hhg, ← eval₂_map, hFE, hFϖ]
  have hFD0 : (h : D →+* Λ) ((FE.map (g : E →+* D)).coeff 0) ∉ maximalIdeal Λ ^ 2 := by
    rw [coeff_map, ← RingHom.comp_apply, hhg, ← coeff_map, hFE]
    exact hF0
  have hϖm : ϖ ∈ maximalIdeal W' := (mem_maximalIdeal _).mpr hϖ.not_isUnit
  obtain ⟨P, _, _, _, hP, _, π, hπ, hπF⟩ :=
    exists_regularChart hR₀ hϖm ψ (h : D →+* Λ) (FE.map (g : E →+* D)) hFD hFD0
  let Ψ : E[X] →+* P := π.comp (mapRingHom (g : E →+* D))
  have hPΨ : hP.comp Ψ = Θ := by
    rw [← RingHom.comp_assoc, hπ]
    apply Polynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, coe_mapRingHom, map_C, coe_eval₂RingHom, eval₂_C, Θ]
      rw [← RingHom.comp_apply (h : D →+* Λ), hhg]
    · simp [Θ]
  have hker : RingHom.ker Θ ≤ RingHom.ker Ψ := by
    intro p hp
    rw [RingHom.mem_ker, hΘ] at hp
    have hdiv : FE.map ιE ∣ p.map ιE := by
      rw [hFE]
      exact hdvd _ hp
    obtain ⟨r, rfl⟩ := (map_dvd_map ιE hιE hFEm).mp hdiv
    rw [RingHom.mem_ker]
    change π ((FE * r).map (g : E →+* D)) = 0
    rw [Polynomial.map_mul, map_mul, hπF, zero_mul]
  obtain ⟨jAway₀, g₀, hj₀, hg₀⟩ := exists_away_factorization Θ Ψ hP hPΨ hker X
    (hΘX ▸ hϖ.ne_zero) F' (s : Set C) hs (by
      intro c hc
      obtain ⟨q', hq'c⟩ := hq' c hc
      refine ⟨q', n c, ?_⟩
      rw [hΘX, ha c, hΘ, hq'c, hq c])
  have hPt : hP (Ψ X) = ϖ := by
    rw [← RingHom.comp_apply, hPΨ, hΘX]
  exact chartConclusion_of_regularLocal F' P hP (Ψ X) (hPt ▸ hϖ) jAway₀ g₀ hj₀ hg₀

end Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation
