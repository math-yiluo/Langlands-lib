import Mathlib.Algebra.CharP.Algebra
import Mathlib.FieldTheory.Perfect
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal

/-! # Residue fields over rings generated by the integers -/

namespace Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation

/-- A field all of whose elements are quotients of integers is perfect. -/
theorem perfectField_of_forall_eq_intCast_div {K : Type*} [Field K]
    (h : ∀ x : K, ∃ a b : ℤ, x = (a : K) / b) : PerfectField K := by
  obtain ⟨p, hp⟩ := CharP.exists K
  rcases CharP.char_is_prime_or_zero K p with hpp | rfl
  · have : Fact p.Prime := ⟨hpp⟩
    have : ExpChar K p := ExpChar.prime hpp
    have : PerfectRing K p := PerfectRing.ofSurjective K p fun x => by
      obtain ⟨a, b, rfl⟩ := h x
      exact ⟨(a : K) / b, by rw [map_div₀, map_intCast, map_intCast]⟩
    exact PerfectRing.toPerfectField K p
  · have : CharZero K := CharP.charP_to_charZero K
    infer_instance

/-- If every element of `R` is an integer, every element of the residue field at a prime of `R`
is a quotient of integers. -/
theorem residueField_eq_intCast_div {R : Type*} [CommRing R]
    (hR : Function.Surjective (Int.castRingHom R)) (𝔭 : Ideal R) [𝔭.IsPrime]
    (x : 𝔭.ResidueField) : ∃ a b : ℤ, x = (a : 𝔭.ResidueField) / b := by
  obtain ⟨y, z, -, rfl⟩ := IsFractionRing.div_surjective (R ⧸ 𝔭) x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨a, rfl⟩ := hR y
  obtain ⟨b, rfl⟩ := hR z
  exact ⟨a, b, by simp⟩

/-- If every element of `R` is an integer, the residue fields of `R` are perfect. -/
theorem perfectField_residueField {R : Type*} [CommRing R]
    (hR : Function.Surjective (Int.castRingHom R)) (𝔭 : Ideal R) [𝔭.IsPrime] :
    PerfectField 𝔭.ResidueField :=
  perfectField_of_forall_eq_intCast_div (residueField_eq_intCast_div hR 𝔭)

/-- Let `D` be a finite type algebra over a ring `R₀` all of whose elements are integers. A
field all of whose elements are quotients of values of a ring map `D → K` is finitely
generated. -/
theorem fieldFG_of_forall_eq_div {R₀ D K : Type*} [CommRing R₀] [CommRing D] [Algebra R₀ D]
    [Algebra.FiniteType R₀ D] [Field K] (hR₀ : Function.Surjective (Int.castRingHom R₀))
    (φ : D →+* K) (h : ∀ x : K, ∃ a b : D, x = φ a / φ b) : Field.FG K := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R₀) (A := D)
  have hmem (a : D) : φ a ∈ Subfield.closure (φ '' (s : Set D)) := by
    have ha : a ∈ Algebra.adjoin R₀ (s : Set D) := hs ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact Subfield.subset_closure ⟨x, hx, rfl⟩
    | algebraMap r =>
      obtain ⟨n, rfl⟩ := hR₀ r
      simp
    | add x y _ _ hx hy => simpa using add_mem hx hy
    | mul x y _ _ hx hy => simpa using mul_mem hx hy
  refine ⟨⟨s.image φ, ?_⟩⟩
  rw [Finset.coe_image, eq_top_iff]
  intro x _
  obtain ⟨a, b, rfl⟩ := h x
  exact div_mem (hmem a) (hmem b)

end Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation
