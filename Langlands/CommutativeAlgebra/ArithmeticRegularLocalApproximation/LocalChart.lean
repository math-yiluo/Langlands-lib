import Langlands.CommutativeAlgebra.RegularLocalFactorialTools
import Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation.ResidueFields
import Mathlib.RingTheory.RegularLocalRing.Polynomial
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-! # A regular local chart cut out by one equation in a localized polynomial ring -/

universe u

open IsLocalRing Polynomial

namespace Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation

section LocalLift

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing B]

/-- Elements outside the contraction of the maximal ideal of a local ring map to units. -/
theorem isUnit_of_mem_primeCompl_comap (f : A →+* B) (Q : Ideal A) [Q.IsPrime]
    (hQ : Q = (maximalIdeal B).comap f) (s : Q.primeCompl) : IsUnit (f s) := by
  subst hQ
  by_contra h
  exact s.2 (Ideal.mem_comap.mpr ((mem_maximalIdeal _).mpr h))

/-- The extension of `f : A → B` to the localization of `A` at the contraction of the maximal
ideal of the local ring `B` is a local homomorphism. -/
theorem isLocalHom_lift_atPrime (f : A →+* B) (Q : Ideal A) [Q.IsPrime]
    (hQ : Q = (maximalIdeal B).comap f) :
    IsLocalHom (IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q)
      (isUnit_of_mem_primeCompl_comap f Q hQ)) := by
  constructor
  intro y hy
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl y
  have hfa : f a = IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q)
      (isUnit_of_mem_primeCompl_comap f Q hQ) (IsLocalization.mk' _ a s) * f s := by
    rw [← IsLocalization.lift_eq (M := Q.primeCompl) (S := Localization.AtPrime Q)
      (isUnit_of_mem_primeCompl_comap f Q hQ) (s : A), ← map_mul, IsLocalization.mk'_spec,
      IsLocalization.lift_eq]
  have hu : IsUnit (f a) := hfa ▸ hy.mul (isUnit_of_mem_primeCompl_comap f Q hQ s)
  rw [IsLocalization.AtPrime.isUnit_mk'_iff]
  intro ha
  have ha' : a ∈ (maximalIdeal B).comap f := hQ ▸ ha
  exact (mem_maximalIdeal _).mp (Ideal.mem_comap.mp ha') hu

/-- A local homomorphism factors through a quotient as a local homomorphism. -/
theorem isLocalHom_quotient_lift {A B : Type*} [CommRing A] [CommRing B] (I : Ideal A)
    (f : A →+* B) [IsLocalHom f] (hI : ∀ a ∈ I, f a = 0) :
    IsLocalHom (Ideal.Quotient.lift I f hI) := by
  constructor
  intro y hy
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [Ideal.Quotient.lift_mk] at hy
  exact (isUnit_of_map_unit f a hy).map _

end LocalLift

/-- Let `ψ : Λ → W'` be a local homomorphism of local rings, `ϖ` an element of the maximal
ideal of `W'`, and `h : D → Λ` a ring map from a regular finite type algebra over a ring `R₀`
generated by the integers. Let `F_D ∈ D[X]` be such that `F_D(ϖ) = 0` under `ψ ∘ h`, and such
that `h` of its constant coefficient is not in the square of the maximal ideal of `Λ`. Then
there is a regular local ring `P` with finitely generated residue field, a local homomorphism
`P → W'` and a ring map `π : D[X] → P` killing `F_D`, through which evaluation at `ϖ` factors. -/
theorem exists_regularChart {R₀ : Type u} [CommRing R₀]
    (hR₀ : Function.Surjective (Int.castRingHom R₀))
    {W' : Type u} [CommRing W'] [IsLocalRing W'] {ϖ : W'} (hϖ : ϖ ∈ maximalIdeal W')
    {Λ : Type u} [CommRing Λ] [IsLocalRing Λ] (ψ : Λ →+* W') [IsLocalHom ψ]
    {D : Type u} [CommRing D] [Algebra R₀ D] [Algebra.FiniteType R₀ D] [IsRegularRing D]
    (h : D →+* Λ) (FD : D[X]) (hF : eval₂ (ψ.comp h) ϖ FD = 0)
    (hF0 : h (FD.coeff 0) ∉ maximalIdeal Λ ^ 2) :
    ∃ (P : Type u) (_ : CommRing P) (_ : IsRegularLocalRing P) (_ : Field.FG (ResidueField P))
      (hP : P →+* W') (_ : IsLocalHom hP) (π : D[X] →+* P),
      hP.comp π = eval₂RingHom (ψ.comp h) ϖ ∧ π FD = 0 := by
  classical
  set Φ : D[X] →+* W' := eval₂RingHom (ψ.comp h) ϖ with hΦ
  set ev₀ : D[X] →+* Λ := eval₂RingHom h 0 with hev₀
  set Q : Ideal D[X] := (maximalIdeal W').comap Φ with hQdef
  -- `Φ s` and `ψ (ev₀ s)` agree modulo `ϖ`.
  have hcong (s : D[X]) : Φ s - ψ (ev₀ s) ∈ maximalIdeal W' := by
    have h1 : Φ s = (s.map (ψ.comp h)).eval ϖ := by
      simp [hΦ, eval₂_eq_eval_map]
    have h2 : ψ (ev₀ s) = (s.map (ψ.comp h)).eval 0 := by
      show ψ (eval₂ h 0 s) = _
      rw [hom_eval₂, map_zero, eval₂_eq_eval_map]
    rw [h1, h2]
    obtain ⟨c, hc⟩ := sub_dvd_eval_sub ϖ 0 (s.map (ψ.comp h))
    rw [hc, sub_zero]
    exact Ideal.mul_mem_right _ _ hϖ
  have hQ' : Q = (maximalIdeal Λ).comap ev₀ := by
    ext s
    simp only [hQdef, Ideal.mem_comap]
    rw [mem_maximalIdeal (ev₀ s), ← map_mem_nonunits_iff ψ, ← mem_maximalIdeal]
    constructor
    · intro hs
      simpa using sub_mem hs (hcong s)
    · intro hs
      simpa using add_mem (hcong s) hs
  have hQprime : Q.IsPrime := Ideal.comap_isPrime _ _
  set R' := Localization.AtPrime Q
  set Φ' : R' →+* W' := IsLocalization.lift (M := Q.primeCompl) (S := R')
    (isUnit_of_mem_primeCompl_comap Φ Q rfl) with hΦ'
  have hΦ'loc : IsLocalHom Φ' := isLocalHom_lift_atPrime Φ Q rfl
  set ev : R' →+* Λ := IsLocalization.lift (M := Q.primeCompl) (S := R')
    (isUnit_of_mem_primeCompl_comap ev₀ Q hQ') with hev
  have hevloc : IsLocalHom ev := isLocalHom_lift_atPrime ev₀ Q hQ'
  set x : R' := algebraMap D[X] R' FD with hx
  have hΦx : Φ' x = 0 := by
    rw [hx, hΦ', IsLocalization.lift_eq]
    exact hF
  have hxm : x ∈ maximalIdeal R' := by
    rw [hx, IsLocalization.AtPrime.to_map_mem_maximal_iff R' Q]
    show Φ FD ∈ maximalIdeal W'
    rw [show Φ FD = 0 from hF]
    exact zero_mem _
  have hx2 : x ∉ maximalIdeal R' ^ 2 := by
    intro hmem
    apply hF0
    have h1 := Ideal.mem_map_of_mem ev hmem
    rw [Ideal.map_pow] at h1
    have h2 := Ideal.pow_right_mono (map_maximalIdeal_le ev) 2 h1
    rwa [hx, hev, IsLocalization.lift_eq, hev₀, coe_eval₂RingHom, eval₂_at_zero] at h2
  have hRreg : IsRegularLocalRing R' := inferInstance
  have hPreg : IsRegularLocalRing (R' ⧸ Ideal.span {x}) :=
    RegularLocalFactorial.isRegularLocalRing_quotient_span_singleton hxm hx2
  have hker : ∀ a ∈ Ideal.span {x}, Φ' a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hΦx, mul_zero]
  let hP : R' ⧸ Ideal.span {x} →+* W' := Ideal.Quotient.lift _ Φ' hker
  have hPloc : IsLocalHom hP := isLocalHom_quotient_lift _ Φ' hker
  let π : D[X] →+* R' ⧸ Ideal.span {x} := (Ideal.Quotient.mk _).comp (algebraMap D[X] R')
  have hπ : hP.comp π = Φ := by
    refine RingHom.ext fun a => ?_
    change (Ideal.Quotient.lift _ Φ' hker) (Ideal.Quotient.mk _ (algebraMap D[X] R' a)) = Φ a
    rw [Ideal.Quotient.lift_mk, hΦ', IsLocalization.lift_eq]
  have hπF : π FD = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
  have hFG : Field.FG (ResidueField (R' ⧸ Ideal.span {x})) := by
    refine fieldFG_of_forall_eq_div (R₀ := R₀) (D := D[X]) hR₀ ((residue _).comp π) ?_
    intro z
    obtain ⟨y, rfl⟩ := residue_surjective z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl y
    refine ⟨a, s, ?_⟩
    have hs : IsUnit (residue _ (π s)) :=
      ((IsLocalization.map_units R' s).map (Ideal.Quotient.mk _)).map _
    change residue _ (Ideal.Quotient.mk _ (IsLocalization.mk' R' a s)) =
      residue _ (Ideal.Quotient.mk _ (algebraMap _ R' a)) /
        residue _ (Ideal.Quotient.mk _ (algebraMap _ R' (s : D[X])))
    rw [eq_div_iff (show residue _ (Ideal.Quotient.mk _ (algebraMap _ R' (s : D[X]))) ≠ 0 from
      hs.ne_zero)]
    rw [← map_mul, ← map_mul, IsLocalization.mk'_spec]
  exact ⟨R' ⧸ Ideal.span {x}, inferInstance, hPreg, hFG, hP, hPloc, π, hπ, hπF⟩

end Langlands.CommutativeAlgebra.ArithmeticRegularLocalApproximation
