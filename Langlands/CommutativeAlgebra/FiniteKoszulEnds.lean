import Langlands.CommutativeAlgebra.FiniteKoszulCochain
import Langlands.CommutativeAlgebra.PunctualReversedDualTopHomology

/-! # End homology of the finite subset Koszul complex -/

universe u

open CategoryTheory CategoryTheory.Limits HomologicalComplex IsLocalRing
open Langlands.Cohomology.ModuleComplex
open scoped BigOperators

noncomputable section

namespace Langlands.CommutativeAlgebra

variable {R : Type u} [CommRing R] {g : ℕ}

/-- Evaluate the degree-zero subset module at the empty subset. -/
def finiteKoszulEmptyEquiv (R : Type u) [CommRing R] (g : ℕ) :
    FiniteKoszulModule R (Fin g) 0 ≃ₗ[R] R where
  toFun x := x ⟨∅, rfl⟩
  invFun r _ := r
  left_inv x := by
    funext s
    have hs : s = ⟨∅, rfl⟩ := Subtype.ext (Finset.card_eq_zero.mp s.property)
    rw [hs]
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Evaluate the top subset module at the full subset. -/
def finiteKoszulFullEquiv (R : Type u) [CommRing R] (g : ℕ) :
    FiniteKoszulModule R (Fin g) g ≃ₗ[R] R where
  toFun x := x ⟨Finset.univ, by simp⟩
  invFun r _ := r
  left_inv x := by
    funext s
    have hs : s = ⟨Finset.univ, by simp⟩ := by
      apply Subtype.ext
      apply Finset.eq_univ_of_card
      simpa using s.property
    rw [hs]
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

lemma finiteKoszulDifferential_empty (a : Fin g → R)
    (x : FiniteKoszulModule R (Fin g) 1) :
    finiteKoszulEmptyEquiv R g (finiteKoszulDifferential a 0 x) =
      ∑ j, a j * x ⟨{j}, by simp⟩ := by
  simp [finiteKoszulEmptyEquiv, finiteKoszulDifferential, koszulRestrict,
    koszulAmbientDifferential, koszulCoefficient, koszulSign, koszulExtend]

/-- At the empty-subset end the image ideal is generated by the parameters. -/
lemma finiteKoszulDifferential_empty_range (a : Fin g → R) :
    LinearMap.range ((finiteKoszulEmptyEquiv R g).toLinearMap.comp
      (finiteKoszulDifferential a 0)) = Ideal.span (Set.range a) := by
  classical
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    change finiteKoszulEmptyEquiv R g (finiteKoszulDifferential a 0 x) ∈ _
    rw [finiteKoszulDifferential_empty]
    apply Submodule.sum_mem
    intro j _
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    refine ⟨(fun s ↦ if j ∈ s.val then 1 else 0), ?_⟩
    change finiteKoszulEmptyEquiv R g (finiteKoszulDifferential a 0 _) = a j
    rw [finiteKoszulDifferential_empty]
    simp

/-- The degree-`g` term is canonically rank one. -/
def finiteKoszulCochainTopEquiv (a : Fin g → R) :
    (finiteKoszulCochain a).X (g : ℤ) ≃ₗ[R] R :=
  (finiteKoszulCochainXIso a 0 (by simp)).toLinearEquiv ≪≫ₗ finiteKoszulEmptyEquiv R g

/-- The degree-zero term is canonically rank one. -/
def finiteKoszulCochainZeroEquiv (a : Fin g → R) :
    (finiteKoszulCochain a).X 0 ≃ₗ[R] R :=
  (finiteKoszulCochainXIso a g (by simp)).toLinearEquiv ≪≫ₗ finiteKoszulFullEquiv R g

/-- The top Koszul homology is the cokernel at the empty-subset end. -/
def finiteKoszulCochainTopHomologyIsoCokernel (a : Fin g → R) :
    (finiteKoszulCochain a).homology (g : ℤ) ≅
      cokernel (ModuleCat.ofHom (finiteKoszulDifferential a 0)) := by
  let K := finiteKoszulCochain a
  have hLE := finiteKoszulCochain_isStrictlyLE a
  have hn : K.d (g : ℤ) ((g : ℤ) + 1) = 0 :=
    (K.isZero_of_isStrictlyLE (g : ℤ) ((g : ℤ) + 1) (by omega)).eq_of_tgt _ _
  let e := K.isoHomologyι (g : ℤ) ((g : ℤ) + 1)
    (CochainComplex.next ℤ (g : ℤ)) hn ≪≫ (K.sc (g : ℤ)).opcyclesIsoCokernel
  let e₀ := finiteKoszulCochainXIso a 0 (show (g : ℤ) - 0 = (g : ℤ) by omega)
  let e₁ := finiteKoszulCochainXIso a 1
    (show (g : ℤ) - 1 = (ComplexShape.up ℤ).prev (g : ℤ) by simp)
  refine e ≪≫ cokernel.mapIso _ _ e₁ e₀ ?_
  change K.d ((ComplexShape.up ℤ).prev (g : ℤ)) (g : ℤ) ≫ e₀.hom =
    e₁.hom ≫ ModuleCat.ofHom (finiteKoszulDifferential a 0)
  dsimp only [K, finiteKoszulCochain]
  rw [extend_d_eq _ _ (show (g : ℤ) - (1 : ℕ) =
      (ComplexShape.up ℤ).prev (g : ℤ) by simp)
    (show (g : ℤ) - (0 : ℕ) = (g : ℤ) by simp)]
  change (e₁.hom ≫ ModuleCat.ofHom (finiteKoszulDifferential a 0) ≫ e₀.inv) ≫
    e₀.hom = e₁.hom ≫ ModuleCat.ofHom (finiteKoszulDifferential a 0)
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]

/-- The top Koszul homology is the quotient by the parameter ideal. -/
def finiteKoszulCochainTopHomologyIsoQuotient (a : Fin g → R) :
    (finiteKoszulCochain a).homology (g : ℤ) ≅
      ModuleCat.of R (R ⧸ Ideal.span (Set.range a)) :=
  finiteKoszulCochainTopHomologyIsoCokernel a ≪≫
    ModuleCat.cokernelIsoRangeQuotient _ ≪≫
      (Submodule.Quotient.equiv _ _ (finiteKoszulEmptyEquiv R g) (by
        rw [← LinearMap.range_comp]
        exact finiteKoszulDifferential_empty_range a)).toModuleIso

/-- Parameters generating the maximal ideal give residue field at the top. -/
def finiteKoszulCochainTopHomologyIsoResidueField [IsLocalRing R] (a : Fin g → R)
    (ha : Ideal.span (Set.range a) = maximalIdeal R) :
    (finiteKoszulCochain a).homology (g : ℤ) ≅ ModuleCat.of R (ResidueField R) :=
  finiteKoszulCochainTopHomologyIsoQuotient a ≪≫
    (Submodule.quotEquivOfEq _ _ ha).toModuleIso

lemma vectorOrderIdeal_linearEquiv {M N : Type u} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) (v : M) :
    vectorOrderIdeal (R := R) (e v) = vectorOrderIdeal (R := R) v := by
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    exact ⟨φ.comp e.toLinearMap, rfl⟩
  · rintro _ ⟨φ, rfl⟩
    exact ⟨φ.comp e.symm.toLinearMap, by simp⟩

lemma finiteKoszulDifferential_full_apply {n : ℕ} (a : Fin (n + 1) → R)
    (s : {s : Finset (Fin (n + 1)) // s.card = n}) :
    finiteKoszulDifferential a n (fun _ ↦ 1) s =
      ∑ i, koszulCoefficient a s.val i := by
  classical
  change (∑ i, koszulCoefficient a s.val i *
    koszulExtend (n + 1) (fun _ ↦ 1) (insert i s.val)) = _
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : i ∈ s.val
  · simp [koszulCoefficient, hi]
  · simp [koszulExtend, Finset.card_insert_of_notMem hi, s.property]

lemma finiteKoszulDifferential_full_erase {n : ℕ} (a : Fin (n + 1) → R)
    (j : Fin (n + 1)) :
    finiteKoszulDifferential a n (fun _ ↦ 1)
      ⟨Finset.univ.erase j, by simp⟩ =
        koszulSign R (Finset.univ.erase j) j * a j := by
  classical
  rw [finiteKoszulDifferential_full_apply, Finset.sum_eq_single j]
  · simp [koszulCoefficient]
  · intro i _ hij
    simp [koszulCoefficient, Finset.mem_erase, hij]
  · simp

/-- The first Koszul vector at the full-subset end has parameter order ideal. -/
lemma finiteKoszulDifferential_full_orderIdeal {n : ℕ} (a : Fin (n + 1) → R) :
    vectorOrderIdeal (finiteKoszulDifferential a n (fun _ ↦ 1)) =
      Ideal.span (Set.range a) := by
  classical
  let v := finiteKoszulDifferential a n (fun _ ↦ 1)
  have hcoord (s : {s : Finset (Fin (n + 1)) // s.card = n}) :
      v s ∈ Ideal.span (Set.range a) := by
    change finiteKoszulDifferential a n (fun _ ↦ 1) s ∈ _
    rw [finiteKoszulDifferential_full_apply]
    apply Submodule.sum_mem
    intro i _
    by_cases hi : i ∈ s.val
    · simp [koszulCoefficient, hi]
    · simpa [koszulCoefficient, hi] using
        (Ideal.span (Set.range a)).mul_mem_left (koszulSign R s.val i)
          (Ideal.subset_span ⟨i, rfl⟩)
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    change φ v ∈ _
    rw [pi_eq_sum_univ' v, map_sum]
    apply Submodule.sum_mem
    intro s _
    rw [map_smul, smul_eq_mul]
    exact Ideal.mul_mem_right _ _ (hcoord s)
  · apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    have hv : koszulSign R (Finset.univ.erase j) j * a j ∈ vectorOrderIdeal v := by
      refine ⟨LinearMap.proj ⟨Finset.univ.erase j, by simp⟩, ?_⟩
      exact finiteKoszulDifferential_full_erase a j
    have hs : koszulSign R (Finset.univ.erase j) j *
        koszulSign R (Finset.univ.erase j) j = 1 := by
      unfold koszulSign
      rw [← mul_pow]
      simp
    change a j ∈ vectorOrderIdeal (R := R) v
    simpa only [← mul_assoc, hs, one_mul] using
      (vectorOrderIdeal v).mul_mem_left (koszulSign R (Finset.univ.erase j) j) hv

lemma finiteKoszulCochain_firstDifferentialOrderIdeal (a : Fin g → R) :
    firstDifferentialOrderIdeal (finiteKoszulCochain a)
      (finiteKoszulCochainZeroEquiv a) = Ideal.span (Set.range a) := by
  cases g with
  | zero =>
    have := finiteKoszulCochain_isStrictlyLE a
    have hz : IsZero ((finiteKoszulCochain a).X 1) :=
      (finiteKoszulCochain a).isZero_of_isStrictlyLE 0 1 (by norm_num)
    have hd : (finiteKoszulCochain a).d 0 1 = 0 := hz.eq_of_tgt _ _
    simp [firstDifferentialOrderIdeal, hd, vectorOrderIdeal]
  | succ n =>
    let e₀ := finiteKoszulCochainXIso a (n + 1)
      (show ((n + 1 : ℕ) : ℤ) - (n + 1 : ℕ) = 0 by omega)
    let e₁ := finiteKoszulCochainXIso a n
      (show ((n + 1 : ℕ) : ℤ) - n = 1 by omega)
    have hdcat : (finiteKoszulCochain a).d 0 1 ≫ e₁.hom =
        e₀.hom ≫ ModuleCat.ofHom (finiteKoszulDifferential a n) := by
      dsimp only [finiteKoszulCochain]
      rw [extend_d_eq _ _ (show ((n + 1 : ℕ) : ℤ) - (n + 1 : ℕ) = 0 by omega)
        (show ((n + 1 : ℕ) : ℤ) - n = 1 by omega)]
      rw [finiteKoszulChain_d]
      change (e₀.hom ≫ ModuleCat.ofHom (finiteKoszulDifferential a n) ≫ e₁.inv) ≫
        e₁.hom = e₀.hom ≫ ModuleCat.ofHom (finiteKoszulDifferential a n)
      simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have hz : e₀.hom.hom ((finiteKoszulCochainZeroEquiv a).symm 1) =
        (fun _ ↦ 1) := by
      change e₀.toLinearEquiv
        ((e₀.toLinearEquiv ≪≫ₗ finiteKoszulFullEquiv R (n + 1)).symm 1) = _
      simp only [LinearEquiv.trans_symm, LinearEquiv.trans_apply,
        LinearEquiv.apply_symm_apply]
      rfl
    have hd : e₁.toLinearEquiv (((finiteKoszulCochain a).d 0 1).hom
        ((finiteKoszulCochainZeroEquiv a).symm 1)) =
        finiteKoszulDifferential a n (fun _ ↦ 1) := by
      have h := congrArg (fun f ↦ f.hom ((finiteKoszulCochainZeroEquiv a).symm 1))
        hdcat
      change e₁.hom.hom (((finiteKoszulCochain a).d 0 1).hom
        ((finiteKoszulCochainZeroEquiv a).symm 1)) =
        finiteKoszulDifferential a n
          (e₀.hom.hom ((finiteKoszulCochainZeroEquiv a).symm 1)) at h
      rw [hz] at h
      exact h
    change vectorOrderIdeal _ = _
    rw [← vectorOrderIdeal_linearEquiv e₁.toLinearEquiv _, hd]
    exact finiteKoszulDifferential_full_orderIdeal a

/-- Parameters generating the maximal ideal also give residue field in top dual homology. -/
def finiteKoszulCochainReversedDualTopHomologyIsoResidueField [IsLocalRing R]
    (a : Fin g → R) (ha : Ideal.span (Set.range a) = maximalIdeal R) :
    (reversedDual (g : ℤ) (finiteKoszulCochain a)).homology (g : ℤ) ≅
      ModuleCat.of R (ResidueField R) :=
  reversedDualTopHomologyIsoResidueField (g : ℤ) (finiteKoszulCochain a)
    (finiteKoszulCochain_isStrictlyGE a) (finiteKoszulCochainZeroEquiv a)
    ((finiteKoszulCochain_firstDifferentialOrderIdeal a).trans ha)

end Langlands.CommutativeAlgebra
