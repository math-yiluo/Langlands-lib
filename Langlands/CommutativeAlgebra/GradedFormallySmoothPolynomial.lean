import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.Finiteness.Nakayama
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.Polynomial.Basic

/-! # Positively graded formally smooth algebras are polynomial algebras -/

noncomputable section

open MvPolynomial Finsupp

namespace Langlands.Algebra.GradedFormallySmooth

/-- A monomial whose `w`-weight is at most the weight of a variable it contains is that
variable, provided all weights are positive. -/
theorem eq_single_of_weight_le {σ : Type*} {w : σ → ℕ} (hw : ∀ j, 0 < w j) {m : σ →₀ ℕ}
    {i : σ} (hi : m i ≠ 0) (h : weight w m ≤ w i) : m = single i 1 := by
  have h1 := weight_sub_single_add (w := w) hi
  have h2 : m - single i 1 = 0 := by
    ext j
    by_contra hj
    have := le_weight_of_ne_zero' w hj
    have := hw j
    simp only [Finsupp.coe_zero, Pi.zero_apply] at hj ⊢
    omega
  rw [← sub_add_single_one_cancel hi, h2, zero_add]

section Components

variable {k C σ : Type*} [CommRing k] [CommRing C] [Algebra k C]
  (𝒜 : ℕ → Submodule k C) [GradedAlgebra 𝒜]

/-- Evaluation at homogeneous elements carries weighted homogeneous components to graded
components. -/
theorem decompose_aeval {w : σ → ℕ} {y : σ → C} (hy : ∀ j, y j ∈ 𝒜 (w j))
    (f : MvPolynomial σ k) (d : ℕ) :
    (DirectSum.decompose 𝒜 (aeval y f) d : C) =
      aeval y (weightedHomogeneousComponent w d f) := by
  classical
  induction f using MvPolynomial.induction_on' with
  | monomial m a =>
    have hm : aeval y (monomial m a) ∈ 𝒜 (weight w m) := by
      rw [aeval_monomial, ← Algebra.smul_def, weight_apply]
      exact Submodule.smul_mem _ a
        (SetLike.prod_pow_mem_graded 𝒜 w y m (fun j _ => hy j))
    have hmon := isWeightedHomogeneous_monomial (R := k) w m a rfl
    by_cases hd : weight w m = d
    · subst hd
      rw [hmon.weightedHomogeneousComponent_same, DirectSum.decompose_of_mem_same _ hm]
    · rw [hmon.weightedHomogeneousComponent_ne d (Ne.symm hd),
        DirectSum.decompose_of_mem_ne _ hm hd, map_zero]
  | add p q hp hq =>
    rw [map_add, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, hp, hq,
      map_add, map_add]

end Components

section Relations

variable {k C σ : Type*} [Field k] [CommRing C] [Algebra k C]
  (𝒜 : ℕ → Submodule k C) [GradedAlgebra 𝒜] {w : σ → ℕ} {y : σ → C}

/-- A relation among homogeneous elements of positive degree has no constant term. -/
theorem coeff_zero_eq_zero [Nontrivial C] (hw : ∀ j, 0 < w j) (hy : ∀ j, y j ∈ 𝒜 (w j))
    {f : MvPolynomial σ k} (hf : aeval y f = 0) : f.coeff 0 = 0 := by
  have h := decompose_aeval 𝒜 hy f 0
  rw [hf, weightedHomogeneousComponent_zero _ (fun j => (hw j).ne'), aeval_C] at h
  apply (algebraMap k C).injective
  rw [← h, (algebraMap k C).map_zero, DirectSum.decompose_zero, DirectSum.zero_apply,
    ZeroMemClass.coe_zero]

/-- If a relation among homogeneous elements of positive degree has a nonzero linear
coefficient at `i`, then `y i` lies in the subalgebra generated by the other `y j`. -/
theorem mem_adjoin_of_coeff_single_ne_zero (hw : ∀ j, 0 < w j) (hy : ∀ j, y j ∈ 𝒜 (w j))
    {f : MvPolynomial σ k} (hf : aeval y f = 0) {i : σ} (hi : f.coeff (single i 1) ≠ 0) :
    y i ∈ Algebra.adjoin k (y '' {j | j ≠ i}) := by
  classical
  set f₀ := weightedHomogeneousComponent w (w i) f with hf₀
  set c := f.coeff (single i 1) with hc_def
  have h0 : aeval y f₀ = 0 := by
    rw [hf₀, ← decompose_aeval 𝒜 hy, hf]
    simp
  have hc : f₀.coeff (single i 1) = c := by
    rw [hf₀, coeff_weightedHomogeneousComponent, ite_eq_left (by simp [weight_single])]
  set g := f₀ - monomial (single i 1) c with hg_def
  have hg : aeval y g ∈ Algebra.adjoin k (y '' {j | j ≠ i}) := by
    rw [g.as_sum, map_sum]
    refine Subalgebra.sum_mem _ fun m hm => ?_
    have hmem : ∀ j ∈ m.support, y j ∈ Algebra.adjoin k (y '' {j | j ≠ i}) := by
      intro j hj
      refine Algebra.subset_adjoin (Set.mem_image_of_mem y ?_)
      intro hji
      subst hji
      rw [MvPolynomial.mem_support_iff] at hm
      rw [Finsupp.mem_support_iff] at hj
      have hm' : m ≠ single j 1 := by
        rintro rfl
        apply hm
        rw [hg_def, coeff_sub, coeff_monomial, ite_eq_left rfl, hc, sub_self]
      rw [hg_def, coeff_sub, coeff_monomial, ite_eq_right (Ne.symm hm'), sub_zero] at hm
      have hwm : weight w m = w j :=
        weightedHomogeneousComponent_isWeightedHomogeneous (w j) f hm
      exact hm' (eq_single_of_weight_le hw hj hwm.le)
    rw [aeval_monomial]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.prod_mem _ fun j hj => Subalgebra.pow_mem _ (hmem j hj) _)
  have key : aeval y f₀ = aeval y g + algebraMap k C c * y i := by
    rw [hg_def, map_sub, aeval_monomial, Finsupp.prod_single_index (by simp), pow_one]
    ring
  rw [h0] at key
  have hyi : y i = algebraMap k C c⁻¹ * -aeval y g := by
    calc y i = algebraMap k C c⁻¹ * (algebraMap k C c * y i) := by
          rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hi, map_one, one_mul]
      _ = algebraMap k C c⁻¹ * -aeval y g := by
          rw [eq_neg_of_add_eq_zero_right key.symm]
  rw [hyi]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (neg_mem hg)

end Relations

section Generators

variable {k C : Type*} [Field k] [CommRing C] [Algebra k C]
  (𝒜 : ℕ → Submodule k C) [GradedAlgebra 𝒜]

/-- `C` is generated as a `k`-algebra by `N` homogeneous elements of positive degree. -/
def HasHomogeneousGenerators (N : ℕ) : Prop :=
  ∃ (e : Fin N → ℕ) (y : Fin N → C), (∀ i, 0 < e i) ∧ (∀ i, y i ∈ 𝒜 (e i)) ∧
    Algebra.adjoin k (Set.range y) = ⊤

/-- A finitely generated `ℕ`-graded algebra whose degree-zero part is `k` is generated by
finitely many homogeneous elements of positive degree. -/
theorem exists_hasHomogeneousGenerators [Algebra.FiniteType k C]
    (h0 : 𝒜 0 = LinearMap.range (Algebra.linearMap k C)) :
    ∃ N, HasHomogeneousGenerators 𝒜 N := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k) (A := C)
  let ι := Σ c : s, ((DirectSum.decompose 𝒜 c.1).support.filter (· ≠ 0))
  let e : ι → ℕ := fun p => p.2.1
  let y : ι → C := fun p => DirectSum.decompose 𝒜 p.1.1 p.2.1
  refine ⟨Fintype.card ι, e ∘ (Fintype.equivFin ι).symm, y ∘ (Fintype.equivFin ι).symm,
    fun i => ?_, fun i => ?_, ?_⟩
  · exact Nat.pos_of_ne_zero (Finset.mem_filter.1 ((Fintype.equivFin ι).symm i).2.2).2
  · exact (DirectSum.decompose 𝒜 _ _).2
  · rw [EquivLike.range_comp, ← top_le_iff, ← hs, Algebra.adjoin_le_iff]
    intro c hc
    rw [← DirectSum.sum_support_decompose 𝒜 c]
    refine Subalgebra.sum_mem _ fun d hd => ?_
    by_cases hd0 : d = 0
    · subst hd0
      obtain ⟨a, ha⟩ : (DirectSum.decompose 𝒜 c 0 : C) ∈
          LinearMap.range (Algebra.linearMap k C) := h0 ▸ (DirectSum.decompose 𝒜 c 0).2
      rw [← ha]
      exact Subalgebra.algebraMap_mem _ a
    · exact Algebra.subset_adjoin ⟨⟨⟨c, hc⟩, ⟨d, Finset.mem_filter.2 ⟨hd, hd0⟩⟩⟩, rfl⟩

variable [Nontrivial C]

/-- For a generating family of homogeneous elements of positive degree of minimal length,
every relation lies in the square of the ideal of variables. -/
theorem mem_pow_two_of_minimal {N : ℕ} {e : Fin N → ℕ} {y : Fin N → C} (he : ∀ i, 0 < e i)
    (hy : ∀ i, y i ∈ 𝒜 (e i)) (hgen : Algebra.adjoin k (Set.range y) = ⊤)
    (hmin : ∀ M < N, ¬ HasHomogeneousGenerators 𝒜 M) {f : MvPolynomial (Fin N) k}
    (hf : aeval y f = 0) : f ∈ idealOfVars (Fin N) k ^ 2 := by
  rw [mem_pow_idealOfVars_iff']
  intro m hm
  by_cases hm0 : m = 0
  · subst hm0
    exact coeff_zero_eq_zero 𝒜 he hy hf
  obtain ⟨i, hi⟩ : ∃ i, m i ≠ 0 := by
    by_contra h
    push Not at h
    exact hm0 (Finsupp.ext h)
  have hmi : m = single i 1 := by
    refine eq_single_of_weight_le (w := fun _ => 1) (fun _ => Nat.one_pos) hi ?_
    rw [← degree_eq_weight_one]
    omega
  subst hmi
  by_contra hc
  have hyi := mem_adjoin_of_coeff_single_ne_zero 𝒜 he hy hf hc
  obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by have := i.pos; omega⟩
  refine hmin M (Nat.lt_succ_self M) ⟨e ∘ i.succAbove, y ∘ i.succAbove, fun j => he _,
    fun j => hy _, ?_⟩
  rw [← top_le_iff, ← hgen, Algebra.adjoin_le_iff]
  rintro _ ⟨j, rfl⟩
  by_cases hj : j = i
  · subst hj
    refine Algebra.adjoin_mono ?_ hyi
    rintro _ ⟨l, hl, rfl⟩
    obtain ⟨z, rfl⟩ := Fin.exists_succAbove_eq hl
    exact ⟨z, rfl⟩
  · obtain ⟨z, rfl⟩ := Fin.exists_succAbove_eq hj
    exact Algebra.subset_adjoin ⟨z, rfl⟩

end Generators

section Injectivity

variable {k C : Type*} [Field k] [CommRing C] [Algebra k C]

/-- A surjection from a polynomial ring onto a formally smooth algebra whose kernel lies in
the square of the ideal of variables is injective. -/
theorem aeval_injective_of_ker_le [Algebra.FormallySmooth k C] {n : ℕ} {x : Fin n → C}
    (hsurj : Function.Surjective (aeval x : MvPolynomial (Fin n) k →ₐ[k] C))
    (hK : RingHom.ker (aeval x : MvPolynomial (Fin n) k →ₐ[k] C) ≤
      idealOfVars (Fin n) k ^ 2) :
    Function.Injective (aeval x : MvPolynomial (Fin n) k →ₐ[k] C) := by
  set φ : MvPolynomial (Fin n) k →ₐ[k] C := aeval x with hφ_def
  set K := RingHom.ker φ with hK_def
  set I := idealOfVars (Fin n) k with hI_def
  let ψ : (MvPolynomial (Fin n) k ⧸ K ^ 2) →ₐ[k] C :=
    Ideal.Quotient.liftₐ (K ^ 2) φ fun a ha => RingHom.mem_ker.1 (Ideal.pow_le_self two_ne_zero ha)
  have hψ : ∀ p, ψ (Ideal.Quotient.mk _ p) = φ p := fun p => rfl
  have hψsurj : Function.Surjective ψ := fun c => by
    obtain ⟨p, rfl⟩ := hsurj c
    exact ⟨Ideal.Quotient.mk _ p, hψ p⟩
  have hnil : IsNilpotent (RingHom.ker (ψ : MvPolynomial (Fin n) k ⧸ K ^ 2 →+* C)) := by
    refine ⟨2, ?_⟩
    rw [Submodule.zero_eq_bot, eq_bot_iff]
    have hle : RingHom.ker (ψ : MvPolynomial (Fin n) k ⧸ K ^ 2 →+* C) ≤ K.map (Ideal.Quotient.mk (K ^ 2)) := by
      intro q hq
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      exact Ideal.mem_map_of_mem _ (RingHom.mem_ker.2 ((hψ p).symm.trans (RingHom.mem_ker.1 hq)))
    calc RingHom.ker (ψ : MvPolynomial (Fin n) k ⧸ K ^ 2 →+* C) ^ 2 ≤ (K.map (Ideal.Quotient.mk (K ^ 2))) ^ 2 :=
          Ideal.pow_right_mono hle 2
      _ = (K ^ 2).map (Ideal.Quotient.mk (K ^ 2)) := (Ideal.map_pow _ _ _).symm
      _ = ⊥ := Ideal.map_quotient_self _
      _ ≤ ⊥ := le_rfl
  let s : C →ₐ[k] MvPolynomial (Fin n) k ⧸ K ^ 2 :=
    Algebra.FormallySmooth.liftOfSurjective (AlgHom.id k C) ψ hψsurj hnil
  have hs : ∀ c, ψ (s c) = c := fun c =>
    Algebra.FormallySmooth.liftOfSurjective_apply (AlgHom.id k C) ψ hψsurj hnil c
  choose y hy using fun i => Ideal.Quotient.mk_surjective (I := K ^ 2) (s (x i))
  let τ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k := aeval y
  have hφτ : φ.comp τ = φ := by
    refine MvPolynomial.algHom_ext fun i => ?_
    change φ (aeval y (X i)) = φ (X i)
    rw [aeval_X, ← hψ, hy, hs, hφ_def, aeval_X]
  have hmkτ : (Ideal.Quotient.mkₐ k (K ^ 2)).comp τ = s.comp φ := by
    refine MvPolynomial.algHom_ext fun i => ?_
    change Ideal.Quotient.mk _ (aeval y (X i)) = s (φ (X i))
    rw [aeval_X, hy, hφ_def, aeval_X]
  have hτK : ∀ f ∈ K, τ f ∈ K ^ 2 := fun f hf => by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have := AlgHom.congr_fun hmkτ f
    change Ideal.Quotient.mk _ (τ f) = s (φ f) at this
    rw [this, RingHom.mem_ker.1 hf, map_zero]
  have hτsub : ∀ a, τ a - a ∈ K := fun a => by
    rw [RingHom.mem_ker, map_sub, sub_eq_zero]
    exact AlgHom.congr_fun hφτ a
  have hKI : K ≤ I := hK.trans (Ideal.pow_le_self two_ne_zero)
  have hτI : ∀ b ∈ I, τ b ∈ I := fun b hb => by
    have := I.add_mem hb (hKI (hτsub b))
    rwa [add_sub_cancel] at this
  have hsq : ∀ f ∈ I * I, τ f - f ∈ I * K := fun f hf => by
    refine Submodule.mul_induction_on hf (fun a ha b hb => ?_) (fun p q hp hq => ?_)
    · have : τ (a * b) - a * b = τ b * (τ a - a) + a * (τ b - b) := by
        rw [map_mul]; ring
      rw [this]
      exact add_mem (Ideal.mul_mem_mul (hτI b hb) (hτsub a)) (Ideal.mul_mem_mul ha (hτsub b))
    · rw [map_add, add_sub_add_comm]
      exact add_mem hp hq
  have hKle : K ≤ I • K := by
    intro f hf
    rw [Ideal.smul_eq_mul]
    have h1 := hsq f (by rw [← pow_two]; exact hK hf)
    have h2 : τ f ∈ I * K := by
      have := hτK f hf
      rw [pow_two] at this
      exact Ideal.mul_mono_left hKI this
    have := sub_mem h2 h1
    rwa [sub_sub_cancel] at this
  obtain ⟨r, hrI, hr⟩ := Submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul I K
    (IsNoetherian.noetherian K) hKle
  have hr1 : (1 : MvPolynomial (Fin n) k) - r ≠ 0 := by
    intro h
    have h0 := (mem_pow_idealOfVars_iff' 1 r).1 (by rwa [pow_one]) 0 (by simp)
    rw [← sub_eq_zero.1 h, AddMonoidAlgebra.coeff_one_zero] at h0
    exact one_ne_zero h0
  refine (injective_iff_map_eq_zero φ).2 fun f hf => ?_
  have hfK : f ∈ K := RingHom.mem_ker.2 hf
  have : (1 - r) * f = 0 := by
    rw [sub_mul, one_mul, ← smul_eq_mul, hr f hfK, sub_self]
  exact (mul_eq_zero.1 this).resolve_left hr1

end Injectivity

/-- A finitely generated, formally smooth, positively `ℕ`-graded algebra over a field `k`
whose degree-zero part is `k` is a polynomial algebra on finitely many homogeneous
generators of positive degree. -/
theorem exists_homogeneous_aeval_bijective {k : Type*} [Field k] {C : Type*} [CommRing C]
    [Nontrivial C] [Algebra k C] [Algebra.FiniteType k C] [Algebra.FormallySmooth k C]
    (𝒜 : ℕ → Submodule k C) [GradedAlgebra 𝒜]
    (h0 : 𝒜 0 = LinearMap.range (Algebra.linearMap k C)) :
    ∃ (n : ℕ) (d : Fin n → ℕ) (x : Fin n → C), (∀ i, 0 < d i) ∧ (∀ i, x i ∈ 𝒜 (d i)) ∧
      Function.Bijective (MvPolynomial.aeval x : MvPolynomial (Fin n) k →ₐ[k] C) := by
  classical
  have hex := exists_hasHomogeneousGenerators 𝒜 h0
  obtain ⟨e, y, he, hy, hgen⟩ := Nat.find_spec hex
  have hsurj : Function.Surjective (aeval y : MvPolynomial (Fin (Nat.find hex)) k →ₐ[k] C) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
    exact hgen
  refine ⟨Nat.find hex, e, y, he, hy, aeval_injective_of_ker_le hsurj fun f hf => ?_, hsurj⟩
  exact mem_pow_two_of_minimal 𝒜 he hy hgen (fun M hM => Nat.find_min hex hM)
    (RingHom.mem_ker.1 hf)

end Langlands.Algebra.GradedFormallySmooth
