import Mathlib.Algebra.CharP.Lemmas
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.RingTheory.Derivation.Basic

/-! # Constants of Euler derivations on algebras generated by p-torsion units -/

universe u v w

namespace Langlands.CommutativeAlgebra

variable {k : Type u} [Field k] {A : Type v} [CommRing A] [Algebra k A]
  {ι : Type w} [Fintype ι] [DecidableEq ι]

private theorem pow_apply_of_apply_eq_smul (D : Module.End k A) (a : A) (c : k)
    (h : D a = c • a) (m : ℕ) : (D ^ m) a = c ^ m • a := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ', Module.End.mul_apply, ih, map_smul, h, smul_smul, pow_succ]

/-- If an algebra is generated by p-torsion units with dual Euler derivations,
then their common kernel consists of ground-field scalars. -/
theorem exists_algebraMap_eq_of_eulerDerivations (p : ℕ) [CharP k p] (hp : 1 < p)
    (x : ι → A) (hx : ∀ i, x i ^ p = 1)
    (hgen : Function.Surjective (MvPolynomial.aeval x : MvPolynomial ι k →ₐ[k] A))
    (D : ι → Derivation k A A)
    (hD : ∀ i j, D i (x j) = (if i = j then (1 : k) else 0) • x j)
    {y : A} (hy : ∀ i, D i y = 0) : ∃ c : k, algebraMap k A c = y := by
  classical
  let : ExpChar k p := ExpChar.prime (CharP.char_is_prime_of_two_le k p hp)
  let m (a : ι → ℕ) : A := ∏ j, x j ^ a j
  have hpow (i j : ι) (n : ℕ) :
      D i (x j ^ n) = (if i = j then (n : k) else 0) • x j ^ n := by
    cases n with
    | zero => simp
    | succ n =>
      rw [Derivation.leibniz_pow, hD]
      by_cases hij : i = j
      · simp [hij, Algebra.smul_def, smul_eq_mul, pow_succ]
      · simp [hij]
  have hprod (i : ι) (a : ι → ℕ) (s : Finset ι) :
      D i (∏ j ∈ s, x j ^ a j) =
        (if i ∈ s then (a i : k) else 0) • ∏ j ∈ s, x j ^ a j := by
    induction s using Finset.induction_on with
    | empty => simp
    | insert j s hj ih =>
      rw [Finset.prod_insert hj, Derivation.leibniz, ih, hpow]
      by_cases hij : i = j
      · subst j
        simp [hj, smul_eq_mul, Algebra.smul_def, mul_assoc, mul_left_comm, mul_comm]
      · by_cases his : i ∈ s
        · simp [hij, his, smul_eq_mul, Algebra.smul_def, mul_left_comm]
        · simp [hij, his]
  have hm (i : ι) (a : ι → ℕ) : D i (m a) = (a i : k) • m a := by
    simpa only [m, Finset.mem_univ, ite_true] using hprod i a Finset.univ
  let P (i : ι) : Module.End k A := 1 - (D i).toLinearMap ^ (p - 1)
  have hp0 : p - 1 ≠ 0 := by omega
  have hP_y (i : ι) : P i y = y := by
    change y - ((D i).toLinearMap ^ (p - 1)) y = y
    rw [pow_apply_of_apply_eq_smul _ _ 0 (by simpa using hy i), zero_pow hp0,
      zero_smul, sub_zero]
  have hP_m (i : ι) (a : ι → ℕ) : P i (m a) = if (a i : k) = 0 then m a else 0 := by
    change m a - ((D i).toLinearMap ^ (p - 1)) (m a) = _
    rw [pow_apply_of_apply_eq_smul _ _ _ (hm i a)]
    by_cases h : (a i : k) = 0
    · simp [h, zero_pow hp0]
    · have hfermat : (a i : k) ^ (p - 1) = 1 := by
        apply mul_right_cancel₀ h
        rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ p), one_mul]
        exact map_natCast (frobenius k p) (a i)
      simp [h, hfermat]
  have hyprod (l : List ι) : (l.map P).prod y = y := by
    induction l with
    | nil => rfl
    | cons i l ih =>
      rw [List.map_cons, List.prod_cons, Module.End.mul_apply, ih, hP_y]
  have hmprod (l : List ι) (a : ι → ℕ) :
      (l.map P).prod (m a) = if ∀ i ∈ l, (a i : k) = 0 then m a else 0 := by
    induction l with
    | nil => simp
    | cons i l ih =>
      rw [List.map_cons, List.prod_cons, Module.End.mul_apply, ih]
      by_cases h : ∀ j ∈ l, (a j : k) = 0
      · rw [ite_eq_left h, hP_m]
        have he : (∀ j ∈ i :: l, (a j : k) = 0) ↔ (a i : k) = 0 := by
          refine ⟨fun H => H i (by simp), fun hi j hj => ?_⟩
          rcases List.mem_cons.mp hj with rfl | hj
          · exact hi
          · exact h j hj
        simp only [he]
      · have h' : ¬∀ j ∈ i :: l, (a j : k) = 0 :=
          fun H => h fun j hj => H j (List.mem_cons_of_mem i hj)
        rw [ite_eq_right h, ite_eq_right h', map_zero]
  let l := (Finset.univ : Finset ι).toList
  let Q : Module.End k A := (l.map P).prod
  have hQ (a : ι → ℕ) : Q (m a) ∈ LinearMap.range (Algebra.linearMap k A) := by
    rw [show Q (m a) = _ from hmprod l a]
    split_ifs with h
    · have hmain : m a = 1 := by
        apply Finset.prod_eq_one
        intro i _
        have hi := h i (by simp [l])
        obtain ⟨b, hb⟩ := (CharP.cast_eq_zero_iff k p _).mp hi
        rw [hb, pow_mul, hx, one_pow]
      rw [hmain]
      exact ⟨1, map_one (algebraMap k A)⟩
    · exact Submodule.zero_mem _
  obtain ⟨f, hf⟩ := hgen y
  have hf' : (MvPolynomial.aeval x : MvPolynomial ι k →ₐ[k] A) f = y := hf
  have hQy : Q y ∈ LinearMap.range (Algebra.linearMap k A) := by
    rw [← hf', f.as_sum, map_sum, map_sum]
    apply Submodule.sum_mem
    intro a _
    rw [MvPolynomial.aeval_monomial, a.prod_fintype _ (fun i => pow_zero _)]
    rw [← Algebra.smul_def]
    change Q ((f.coeff a) • m a) ∈ _
    rw [map_smul]
    exact Submodule.smul_mem _ _ (hQ a)
  rw [show Q y = y from hyprod l] at hQy
  exact hQy

end Langlands.CommutativeAlgebra
