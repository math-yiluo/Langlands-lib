import Mathlib
import Langlands.CommutativeAlgebra.RegularLocalLocalizationsProof
import Langlands.CommutativeAlgebra.FiniteTypeIntGRing.CompletionRegular
import Langlands.CommutativeAlgebra.FiniteTypeIntGRing.LocalDerivation
import Langlands.CommutativeAlgebra.FiniteTypeIntGRing.PolynomialFiber
import Langlands.CommutativeAlgebra.FiniteTypeIntGRing.SurjectiveCompletion

/-! # Regularity of the formal fibres after a finite field extension -/

universe u v

namespace Langlands.CommutativeAlgebra.FiniteTypeIntGRing

open IsLocalRing MvPolynomial TensorProduct

attribute [local instance] RingHom.ker_isPrime

section SumExtend

variable {R₀ : Type*} [CommRing R₀] {σ μ : Type*} {T : Type*} [CommRing T]

/-- The ring map `R₀[X_σ, Y_μ] → T` extending `φ : R₀[X_σ] → T` by `Y_j ↦ y j`. -/
noncomputable def sumExtend (φ : MvPolynomial σ R₀ →+* T) (y : μ → T) :
    MvPolynomial (σ ⊕ μ) R₀ →+* T :=
  eval₂Hom (φ.comp C) (Sum.elim (fun i => φ (X i)) y)

@[simp]
theorem sumExtend_rename_inl (φ : MvPolynomial σ R₀ →+* T) (y : μ → T) (p : MvPolynomial σ R₀) :
    sumExtend φ y (rename Sum.inl p) = φ p := by
  have : (sumExtend φ y).comp (rename Sum.inl).toRingHom = φ :=
    MvPolynomial.ringHom_ext (fun r => by simp [sumExtend]) (fun i => by simp [sumExtend])
  exact RingHom.congr_fun this p

@[simp]
theorem sumExtend_X_inr (φ : MvPolynomial σ R₀ →+* T) (y : μ → T) (j : μ) :
    sumExtend φ y (X (Sum.inr j)) = y j := by
  simp [sumExtend]

end SumExtend

section Base

variable {R₀ : Type*} [CommRing R₀] {A' : Type*} [CommRing A'] [IsLocalRing A'] {n : ℕ}
  (g : MvPolynomial (Fin n) R₀ →+* A')

/-- The map from the localization of `R₀[X]` at the prime under the maximal ideal of `A'`. -/
noncomputable def baseLift :
    Localization.AtPrime ((maximalIdeal A').comap g) →+* A' :=
  IsLocalization.lift (M := ((maximalIdeal A').comap g).primeCompl) fun v =>
    notMem_maximalIdeal.mp v.2

theorem baseLift_algebraMap (p : MvPolynomial (Fin n) R₀) :
    baseLift g (algebraMap _ _ p) = g p :=
  IsLocalization.lift_eq _ p

theorem baseLift_surjective (hg : ∀ a, ∃ u v, IsUnit (g v) ∧ a * g v = g u) :
    Function.Surjective (baseLift g) := by
  intro a
  obtain ⟨u, v, hv, h⟩ := hg a
  have hv' : v ∈ ((maximalIdeal A').comap g).primeCompl := notMem_maximalIdeal.mpr hv
  refine ⟨IsLocalization.mk' _ u ⟨v, hv'⟩, ?_⟩
  rw [baseLift, IsLocalization.lift_mk'_spec]
  exact h.symm.trans (mul_comm _ _)

end Base

section Generation

variable {R₀ : Type*} [CommRing R₀] {A' : Type*} [CommRing A'] {κ k : Type*} [Field κ] [Field k]
  [Algebra A' κ] [IsFractionRing A' κ] [Algebra κ k] [Algebra A' k] [IsScalarTower A' κ k]
  {n m : ℕ} (g : MvPolynomial (Fin n) R₀ →+* A')

/-- If `A'` is generated by the values of `g` up to units, and `b` is a basis of `k` over the
fraction field `κ` of `A'`, then every element of `k` is a quotient of values of the extension of
`g` by `Y_j ↦ b j`. -/
theorem exists_eq_div_sumExtend (hg : ∀ a, ∃ u v, IsUnit (g v) ∧ a * g v = g u)
    (b : Module.Basis (Fin m) κ k) (z : k) :
    ∃ u v, sumExtend ((algebraMap A' k).comp g) b v ≠ 0 ∧
      z = sumExtend ((algebraMap A' k).comp g) b u /
        sumExtend ((algebraMap A' k).comp g) b v := by
  set ψ := sumExtend ((algebraMap A' k).comp g) b
  set F := Subfield.closure (Set.range ψ)
  have hψ (p : MvPolynomial (Fin n) R₀) : algebraMap A' k (g p) ∈ F :=
    Subfield.subset_closure ⟨rename Sum.inl p, by simp [ψ]⟩
  have h₁ (a : A') : algebraMap A' k a ∈ F := by
    obtain ⟨u, v, hv, h⟩ := hg a
    have hne : algebraMap A' k (g v) ≠ 0 := (hv.map (algebraMap A' k)).ne_zero
    have : algebraMap A' k a = algebraMap A' k (g u) / algebraMap A' k (g v) := by
      rw [eq_div_iff hne, ← map_mul, h]
    rw [this]
    exact div_mem (hψ u) (hψ v)
  have h₂ (c : κ) : algebraMap κ k c ∈ F := by
    obtain ⟨a, s, -, rfl⟩ := IsFractionRing.div_surjective (A := A') c
    rw [map_div₀, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    exact div_mem (h₁ a) (h₁ s)
  have hz : z ∈ F := by
    rw [← b.sum_repr z]
    refine sum_mem fun j _ => ?_
    rw [Algebra.smul_def]
    exact mul_mem (h₂ _) (Subfield.subset_closure ⟨X (Sum.inr j), by simp [ψ]⟩)
  obtain ⟨y, hy, w, hw, rfl⟩ := Subfield.mem_closure_iff.mp hz
  rw [← RingHom.coe_range, Subring.closure_eq] at hy hw
  obtain ⟨u, rfl⟩ := hy
  obtain ⟨v, rfl⟩ := hw
  by_cases hv : ψ v = 0
  · exact ⟨0, 1, by simp, by simp [hv]⟩
  · exact ⟨u, v, hv, rfl⟩

end Generation

/-- **Regularity of formal fibres after finite base field extension.** Let `A` be a Noetherian
local ring, `q` a prime of `A` and `k'` a finite extension of `κ(q)`. Suppose that `A ⧸ q` is
generated, up to units, by the values of a ring map `g : R₀[X_1, …, X_n] → A ⧸ q` from a polynomial
ring over a regular ring `R₀`, and that every essentially finite type field extension of `R₀` of
the characteristic of `κ(q)` is formally smooth over `R₀`. Then `k' ⊗_{κ(q)} (κ(q) ⊗_A Â)` is a
regular ring. -/
theorem isRegularRing_tensor_fiber_adicCompletion {R₀ : Type v} [CommRing R₀] [IsRegularRing R₀]
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (q : Ideal A) [q.IsPrime]
    {n : ℕ} (g : MvPolynomial (Fin n) R₀ →+* A ⧸ q)
    (hg : ∀ a, ∃ u v, IsUnit (g v) ∧ a * g v = g u)
    (hsmooth : ∀ (K : Type v) [Field K] [Algebra R₀ K] [Algebra.EssFiniteType R₀ K],
      ringChar K = ringChar q.ResidueField → Algebra.FormallySmooth R₀ K)
    (k' : Type*) [Field k'] [Algebra q.ResidueField k'] [FiniteDimensional q.ResidueField k'] :
    IsRegularRing (k' ⊗[q.ResidueField] q.Fiber (AdicCompletion (maximalIdeal A) A)) := by
  classical
  have : IsLocalRing (A ⧸ q) := .of_surjective' (Ideal.Quotient.mk q) Ideal.Quotient.mk_surjective
  let : Algebra (A ⧸ q) k' :=
    ((algebraMap q.ResidueField k').comp (algebraMap (A ⧸ q) q.ResidueField)).toAlgebra
  have : IsScalarTower (A ⧸ q) q.ResidueField k' := .of_algebraMap_eq fun _ => rfl
  let : Algebra A k' := ((algebraMap q.ResidueField k').comp (algebraMap A q.ResidueField)).toAlgebra
  have : IsScalarTower A q.ResidueField k' := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A (A ⧸ q) k' := .of_algebraMap_eq fun a =>
    congrArg (algebraMap q.ResidueField k')
      (IsScalarTower.algebraMap_apply A (A ⧸ q) q.ResidueField a)
  set P := (maximalIdeal (A ⧸ q)).comap g
  set A₀ := Localization.AtPrime P
  let : Algebra A₀ (A ⧸ q) := (baseLift g).toAlgebra
  let : Algebra A₀ k' := ((algebraMap (A ⧸ q) k').comp (baseLift g)).toAlgebra
  have : IsScalarTower A₀ (A ⧸ q) k' := .of_algebraMap_eq fun _ => rfl
  set m := Module.finrank q.ResidueField k'
  set b := Module.finBasis q.ResidueField k'
  set ψ := sumExtend ((algebraMap (A ⧸ q) k').comp g) b
  have hψ (p : MvPolynomial (Fin n) R₀) :
      ψ (rename Sum.inl p) = algebraMap A₀ k' (algebraMap _ A₀ p) := by
    rw [sumExtend_rename_inl]
    change _ = algebraMap (A ⧸ q) k' (baseLift g (algebraMap _ _ p))
    rw [baseLift_algebraMap]
    rfl
  have hsurj := exists_eq_div_sumExtend (κ := q.ResidueField) g hg b
  set Â₀ := AdicCompletion (maximalIdeal A₀) A₀
  let : Algebra (MvPolynomial (Fin n ⊕ Fin m) R₀) (MvPolynomial (Fin m) Â₀) :=
    (sumExtend (C.comp ((algebraMap A₀ Â₀).comp (algebraMap _ A₀))) X).toAlgebra
  have hB₁ (p : MvPolynomial (Fin n) R₀) :
      algebraMap (MvPolynomial (Fin n ⊕ Fin m) R₀) (MvPolynomial (Fin m) Â₀) (rename Sum.inl p) =
        C (algebraMap A₀ Â₀ (algebraMap _ A₀ p)) := by
    rw [RingHom.algebraMap_toAlgebra, sumExtend_rename_inl]
    rfl
  have hB₂ (j : Fin m) :
      algebraMap (MvPolynomial (Fin n ⊕ Fin m) R₀) (MvPolynomial (Fin m) Â₀) (X (Sum.inr j)) =
        X j := by
    rw [RingHom.algebraMap_toAlgebra, sumExtend_X_inr]
  have : IsRegularLocalRing A₀ := IsRegularRing.isRegularLocalRing_localization P
  have : IsRegularLocalRing Â₀ := isRegularLocalRing_adicCompletion A₀
  have : IsRegularRing Â₀ := regularLocalLocalizations _ inferInstance
  have : Algebra.EssFiniteType R₀ (RingHom.ker ψ).ResidueField :=
    .comp R₀ (MvPolynomial (Fin n ⊕ Fin m) R₀) _
  have : Algebra.FormallySmooth R₀ (RingHom.ker ψ).ResidueField := by
    refine hsmooth _ (ringChar.eq_iff.mpr ?_)
    refine ((residueFieldKerEquiv ψ hsurj).toRingHom.charP_iff_charP _).mpr ?_
    exact (Algebra.charP_iff q.ResidueField k' _).mp (ringChar.charP _)
  have := isRegularRing_fiber_completedPolynomial P.primeCompl (maximalIdeal A₀) hB₁ hB₂
    (RingHom.ker ψ)
  let e₄ := fiberEquivTensor ψ hψ hB₁ hB₂ hsurj P.primeCompl
  let e₃ := tensorAdicCompletionEquivOfSurjective (A := A₀) (A' := A ⧸ q)
    (baseLift_surjective g hg) k'
  let e₂ := tensorAdicCompletionEquivOfSurjective (A := A) (A' := A ⧸ q)
    Ideal.Quotient.mk_surjective k'
  let e₁ := (Algebra.TensorProduct.cancelBaseChange A q.ResidueField k' k'
    (AdicCompletion (maximalIdeal A) A)).toRingEquiv
  exact IsRegularRing.of_ringEquiv (e₄.trans (e₃.trans (e₂.symm.trans e₁.symm)))

end Langlands.CommutativeAlgebra.FiniteTypeIntGRing
