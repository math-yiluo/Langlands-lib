import Mathlib

/-! # Quotients of regular local rings by part of a regular system of parameters -/

namespace Langlands.CommutativeAlgebra.FiniteTypeIntGRing

open IsLocalRing

/-- If `f : ι → R` is a finite family in the maximal ideal of a regular local ring whose images in
the cotangent space are linearly independent, then `R ⧸ (f)` is a regular local ring. -/
theorem isRegularLocalRing_quotient_span_of_linearIndependent {R : Type*} [CommRing R]
    [IsRegularLocalRing R] {ι : Type*} [Fintype ι] (f : ι → R)
    (hfm : ∀ i, f i ∈ maximalIdeal R)
    (hf : LinearIndependent (ResidueField R)
      (fun i => (maximalIdeal R).toCotangent ⟨f i, hfm i⟩)) :
    IsRegularLocalRing (R ⧸ Ideal.span (Set.range f)) := by
  classical
  set κ := ResidueField R
  set V := CotangentSpace R
  set v : ι → V := fun i => (maximalIdeal R).toCotangent ⟨f i, hfm i⟩ with hv
  set W : Submodule κ V := Submodule.span κ (Set.range v) with hWdef
  have hW : Module.finrank κ W = Fintype.card ι := finrank_span_eq_card hf
  have hWV := Submodule.finrank_quotient_add_finrank W
  set d := Module.finrank κ V with hd
  set m := Module.finrank κ (V ⧸ W) with hm
  let bq := Module.finBasis κ (V ⧸ W)
  have hsurj : Function.Surjective
      (fun t : maximalIdeal R => W.mkQ ((maximalIdeal R).toCotangent t)) := by
    intro y
    obtain ⟨x, rfl⟩ := W.mkQ_surjective y
    obtain ⟨t, rfl⟩ := (maximalIdeal R).toCotangent_surjective x
    exact ⟨t, rfl⟩
  choose t ht using fun j : Fin m => hsurj (bq j)
  -- the images of the `f i` and the `t j` span the cotangent space
  have hspanV : Submodule.span κ ((maximalIdeal R).toCotangent ''
      (Set.range (fun i => (⟨f i, hfm i⟩ : maximalIdeal R)) ∪ Set.range t)) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    set U := Submodule.span κ ((maximalIdeal R).toCotangent ''
      (Set.range (fun i => (⟨f i, hfm i⟩ : maximalIdeal R)) ∪ Set.range t))
    have hWU : W ≤ U := by
      rw [hWdef, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact Submodule.subset_span ⟨_, Or.inl ⟨i, rfl⟩, rfl⟩
    have htU : ∀ j, (maximalIdeal R).toCotangent (t j) ∈ U := fun j =>
      Submodule.subset_span ⟨_, Or.inr ⟨j, rfl⟩, rfl⟩
    have hx := bq.sum_repr (W.mkQ x)
    set y : V := ∑ j, bq.repr (W.mkQ x) j • (maximalIdeal R).toCotangent (t j)
    have hy : W.mkQ y = W.mkQ x := by
      rw [← hx, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_smul]
      congr 1
      exact ht j
    have hxy : x - y ∈ W := by
      rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub]
      simpa [sub_eq_zero] using hy.symm
    have hyU : y ∈ U := Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (htU j)
    have := U.add_mem (hWU hxy) hyU
    simpa using this
  have hspanR := (CotangentSpace.span_image_eq_top_iff (R := R)).mp hspanV
  -- hence the maximal ideal is generated by the `f i` and the `t j`
  have hmax : maximalIdeal R = Ideal.span (Set.range f ∪ Set.range (fun j => (t j : R))) := by
    have := congrArg (Submodule.map (maximalIdeal R).subtype) hspanR
    rw [Submodule.map_top, Submodule.range_subtype, Submodule.map_span] at this
    refine this.symm.trans ?_
    rw [Set.image_union, ← Set.range_comp, ← Set.range_comp]
    rfl
  -- the quotient
  set Rb := R ⧸ Ideal.span (Set.range f)
  have hle : Ideal.span (Set.range f) ≤ maximalIdeal R := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hfm i
  have hne : Ideal.span (Set.range f) ≠ ⊤ := fun htop =>
    (maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (htop ▸ hle))
  have : Nontrivial Rb := Ideal.Quotient.nontrivial_iff.mpr hne
  have : IsLocalRing Rb :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  let mk := Ideal.Quotient.mk (Ideal.span (Set.range f))
  have hmaxb : maximalIdeal Rb = Ideal.span (Set.range (fun j => mk (t j : R))) := by
    rw [← map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective]
    conv_lhs => rw [hmax]
    rw [Ideal.map_span, Set.image_union]
    have h0 : mk '' Set.range f ⊆ {0} := by
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      simp only [Set.mem_singleton_iff, mk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨i, rfl⟩
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro x (hx | hx)
      · rw [h0 hx]
        exact zero_mem _
      · obtain ⟨_, ⟨j, rfl⟩, rfl⟩ := hx
        exact Ideal.subset_span ⟨j, rfl⟩
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact Ideal.subset_span (Or.inr ⟨_, ⟨j, rfl⟩, rfl⟩)
  have hspanb : (maximalIdeal Rb).spanFinrank ≤ m := by
    rw [hmaxb]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    simp
  -- dimension estimate
  have hdim : ringKrullDim R ≤ ringKrullDim Rb + (Finset.univ.image f).card := by
    have := ringKrullDim_le_ringKrullDim_quotient_add_card (Finset.univ.image f) (by
      intro x hx
      simp only [Finset.coe_image, Finset.coe_univ, Set.image_univ, Set.mem_range] at hx
      obtain ⟨i, rfl⟩ := hx
      rw [SetLike.mem_coe, IsLocalRing.ringJacobson_eq_maximalIdeal]
      exact hfm i)
    rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ] at this
  have hcard : (Finset.univ.image f).card ≤ Fintype.card ι := Finset.card_image_le
  have hreg : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) = ringKrullDim R :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace] at hreg
  obtain ⟨e, he⟩ : ∃ e : ℕ, ringKrullDim Rb = (e : WithBot ℕ∞) := by
    have h1 : ringKrullDim Rb ≠ ⊤ := ringKrullDim_ne_top
    have h2 : ringKrullDim Rb ≠ ⊥ := ringKrullDim_ne_bot
    cases hd' : ringKrullDim Rb with
    | bot => exact absurd hd' h2
    | coe d' =>
      cases d' with
      | top => exact absurd hd' (by simpa using h1)
      | coe d' => exact ⟨d', rfl⟩
  have hde : d ≤ e + Fintype.card ι := by
    have h := hdim
    rw [← hreg, he] at h
    have h' : ((d : ℕ) : WithBot ℕ∞) ≤ ((e + Fintype.card ι : ℕ) : WithBot ℕ∞) := by
      refine h.trans ?_
      have : ((Finset.univ.image f).card : WithBot ℕ∞) ≤ (Fintype.card ι : WithBot ℕ∞) := by
        exact_mod_cast hcard
      calc (e : WithBot ℕ∞) + ((Finset.univ.image f).card : WithBot ℕ∞)
          ≤ (e : WithBot ℕ∞) + (Fintype.card ι : WithBot ℕ∞) := by gcongr
        _ = ((e + Fintype.card ι : ℕ) : WithBot ℕ∞) := by push_cast; rfl
    exact_mod_cast h'
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
  rw [he]
  have : (maximalIdeal Rb).spanFinrank ≤ e := by omega
  exact_mod_cast this

end Langlands.CommutativeAlgebra.FiniteTypeIntGRing
