import Mathlib
import Langlands.AnthropicFLT.Definitions.Def_AdicCompletionLocalRing
import Langlands.AnthropicFLT.Theorems.Thm_AdicCompletion_exists_ringEquiv_of_forall_quotient_mk_comp_surjective_of_forall_ker_eq_pow
import Langlands.AnthropicFLT.Theorems.Thm_AdicCompletion_isNoetherianRing_of_isNoetherianRing
import Langlands.AnthropicFLT.Theorems.Thm_IsAdicComplete_of_finite_of_isNoetherianRing

/-! # Completion of a quotient of a Noetherian local ring -/

namespace Langlands.CommutativeAlgebra.FiniteTypeIntGRing

open IsLocalRing TensorProduct

/-- Adic completeness for the extension of an ideal of the base ring is invariant under
isomorphisms of algebras. -/
theorem isAdicComplete_map_algebraMap_of_algEquiv {R S S' : Type*} [CommRing R] [CommRing S]
    [CommRing S'] [Algebra R S] [Algebra R S'] (e : S ≃ₐ[R] S') (I : Ideal R)
    (h : IsAdicComplete (I.map (algebraMap R S)) S) :
    IsAdicComplete (I.map (algebraMap R S')) S' := by
  have h' := (IsAdicComplete.congr_ringEquiv _ e.toRingEquiv).mpr h
  convert h' using 1
  change _ = Ideal.map (e.toRingEquiv : S →+* S') _
  rw [Ideal.map_map]
  congr 1
  ext a
  exact (e.commutes a).symm

variable {A A' : Type*} [CommRing A] [CommRing A'] [IsLocalRing A] [IsNoetherianRing A]
    [Algebra A A']

/-- For a finite algebra `A'` over a Noetherian local ring `A`, the ring `A' ⊗[A] Â` is complete
for the ideal generated by the maximal ideal of `A`. -/
theorem isAdicComplete_tensor_adicCompletion [Module.Finite A A'] :
    IsAdicComplete
      ((maximalIdeal A).map (algebraMap A (A' ⊗[A] AdicCompletion (maximalIdeal A) A)))
      (A' ⊗[A] AdicCompletion (maximalIdeal A) A) := by
  have : IsNoetherianRing (AdicCompletion (maximalIdeal A) A) :=
    AdicCompletion.isNoetherianRing_of_isNoetherianRing _
  have h₁ : IsAdicComplete (maximalIdeal (AdicCompletion (maximalIdeal A) A))
      (AdicCompletion (maximalIdeal A) A ⊗[A] A') :=
    IsAdicComplete.of_finite_of_isNoetherianRing _ _
  rw [AdicCompletion.maximalIdeal_eq_map, IsAdicComplete.map_algebraMap_iff,
    ← IsAdicComplete.map_algebraMap_iff (S := AdicCompletion (maximalIdeal A) A ⊗[A] A')] at h₁
  exact isAdicComplete_map_algebraMap_of_algEquiv
    (Algebra.TensorProduct.comm A (AdicCompletion (maximalIdeal A) A) A') _ h₁

variable [IsLocalRing A'] (h : Function.Surjective (algebraMap A A'))

include h in
/-- For a surjection `A → A'` of Noetherian local rings, `Â'` is isomorphic to `A' ⊗[A] Â`
as an `A'`-algebra. -/
theorem nonempty_adicCompletion_algEquiv_tensor :
    Nonempty (AdicCompletion (maximalIdeal A') A' ≃ₐ[A']
      A' ⊗[A] AdicCompletion (maximalIdeal A) A) := by
  set T := A' ⊗[A] AdicCompletion (maximalIdeal A) A
  set J : Ideal T := (maximalIdeal A').map (algebraMap A' T) with hJdef
  have : Module.Finite A A' := Module.Finite.of_surjective (Algebra.linearMap A A') h
  have hm : (maximalIdeal A).map (algebraMap A A') = maximalIdeal A' :=
    map_maximalIdeal_of_surjective _ h
  have hJ : J = (maximalIdeal A).map (algebraMap A T) := by
    rw [hJdef, ← hm, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  have hJk (k : ℕ) : J ^ k = ((maximalIdeal A ^ k).map
      (algebraMap A (AdicCompletion (maximalIdeal A) A))).map
        (Algebra.TensorProduct.includeRight :
          AdicCompletion (maximalIdeal A) A →ₐ[A] T).toRingHom := by
    rw [hJ, ← Ideal.map_pow, Ideal.map_map]
    congr 1
    ext a
    exact (Algebra.TensorProduct.includeRight.commutes a).symm
  have : IsAdicComplete J T := by
    rw [hJ]
    exact isAdicComplete_tensor_adicCompletion
  have hsurj (k : ℕ) :
      Function.Surjective ((Ideal.Quotient.mk (J ^ k)).comp (algebraMap A' T)) := by
    intro y
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    induction t using TensorProduct.inductionOn with
    | tmul a' x =>
      obtain ⟨a, z, hz, rfl⟩ := AdicCompletion.exists_eq_algebraMap_add (maximalIdeal A)
        (maximalIdeal A).fg_of_isNoetherianRing k x
      refine ⟨a' * algebraMap A A' a, ?_⟩
      rw [RingHom.comp_apply, Ideal.Quotient.eq]
      have hz' : (1 : A') ⊗ₜ[A] z ∈ J ^ k := by
        rw [hJk]
        exact Ideal.mem_map_of_mem _ hz
      have e₁ : algebraMap A' T (a' * algebraMap A A' a) =
          a • (a' ⊗ₜ[A] (1 : AdicCompletion (maximalIdeal A) A)) := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          smul_tmul', Algebra.smul_def, mul_comm]
      have key : algebraMap A' T (a' * algebraMap A A' a) - a' ⊗ₜ[A] (algebraMap A _ a + z) =
          -((a' ⊗ₜ[A] (1 : AdicCompletion (maximalIdeal A) A)) * (1 ⊗ₜ[A] z)) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, tmul_add,
          Algebra.algebraMap_eq_smul_one (A := AdicCompletion (maximalIdeal A) A), tmul_smul, e₁]
        abel
      rw [key]
      exact neg_mem (Ideal.mul_mem_left _ _ hz')
    | add x y hx hy =>
      obtain ⟨u, hu⟩ := hx
      obtain ⟨v, hv⟩ := hy
      exact ⟨u + v, by rw [map_add, hu, hv, map_add]⟩
  have hker (k : ℕ) :
      RingHom.ker ((Ideal.Quotient.mk (J ^ k)).comp (algebraMap A' T)) = maximalIdeal A' ^ k := by
    apply le_antisymm
    · intro a' ha'
      have hle : maximalIdeal A ^ k ≤ (maximalIdeal A' ^ k).comap (Algebra.ofId A A') := by
        rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
        exact (congrArg (· ^ k) hm).le
      let ψ : AdicCompletion (maximalIdeal A) A →ₐ[A] A' ⧸ maximalIdeal A' ^ k :=
        (Ideal.quotientMapₐ (maximalIdeal A' ^ k) (Algebra.ofId A A') hle).comp
          (AdicCompletion.evalₐ (maximalIdeal A) k)
      let ρ : T →ₐ[A'] A' ⧸ maximalIdeal A' ^ k :=
        Algebra.TensorProduct.lift (Algebra.ofId A' _) ψ (fun _ _ ↦ Commute.all _ _)
      have hρ : J ^ k ≤ RingHom.ker ρ := by
        rw [hJdef, ← Ideal.map_pow, Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hx
      have h0 : ρ (algebraMap A' T a') = 0 := by
        apply hρ
        rwa [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem] at ha'
      rwa [AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem] at h0
    · intro a' ha'
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hJdef,
        ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ ha'
  obtain ⟨e, he⟩ :=
    AdicCompletion.exists_ringEquiv_of_forall_quotient_mk_comp_surjective_of_forall_ker_eq_pow
      (maximalIdeal A') J (algebraMap A' T) hsurj hker
  let e' : AdicCompletion (maximalIdeal A') A' ≃+* T :=
    e.trans (AdicCompletion.ofAlgEquiv J).symm.toRingEquiv
  have he' (r : A') : e' (algebraMap A' _ r) = algebraMap A' T r := by
    simp only [e', RingEquiv.trans_apply]
    rw [he, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    exact AdicCompletion.ofAlgEquiv_symm_of J _
  exact ⟨AlgEquiv.ofRingEquiv he'⟩

/-- For a surjection `A → A'` of Noetherian local rings and an `A'`-algebra `K`, base change of
the completions: `K ⊗[A] Â ≃+* K ⊗[A'] Â'`. -/
noncomputable def tensorAdicCompletionEquivOfSurjective
    (K : Type*) [CommRing K] [Algebra A' K] [Algebra A K] [IsScalarTower A A' K] :
    K ⊗[A] AdicCompletion (maximalIdeal A) A ≃+*
      K ⊗[A'] AdicCompletion (maximalIdeal A') A' :=
  ((Algebra.TensorProduct.cancelBaseChange A A' A' K
      (AdicCompletion (maximalIdeal A) A)).symm.trans
    (Algebra.TensorProduct.congr AlgEquiv.refl
      (nonempty_adicCompletion_algEquiv_tensor h).some.symm)).toRingEquiv

end Langlands.CommutativeAlgebra.FiniteTypeIntGRing
