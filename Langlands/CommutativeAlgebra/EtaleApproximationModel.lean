import Langlands.CommutativeAlgebra.EtaleCompletionApproximation
import Langlands.CommutativeAlgebra.MaximalLocalizationCompletion
import Langlands.CommutativeAlgebra.UnramifiedSubalgebraSquare
import Mathlib.RingTheory.Etale.Basic
import Mathlib.RingTheory.MvPolynomial.Basic

/-! # Finite-type unramified models of etale approximations

Let `S = R[x_i]` be a polynomial ring in finitely many variables over a Noetherian ring,
`𝔪` a maximal ideal and `P̂` the completion of `S` at `𝔪`. If the localization `S_𝔪`
has etale approximation, then every solution in `P̂` of finitely many polynomial
equations with coefficients in `R` is approximated, to any given order, by a solution
in a finite-type `S`-algebra `T₀` with a map `T₀ → P̂` over `S`, and `T₀` is unramified
at the preimage of the maximal ideal: `T₀ = S + u₀ ^ 2`. -/

universe u

open IsLocalRing

namespace Langlands.CommutativeAlgebra.EtaleApproximationModel

open MaximalLocalizationCompletion

variable {R : Type u} [CommRing R] [IsNoetherianRing R] {ι : Type u} [Fintype ι]
  (𝔪 : Ideal (MvPolynomial ι R)) [𝔪.IsMaximal]

local notation "S" => MvPolynomial ι R
local notation "P" => Localization.AtPrime 𝔪
local notation "P̂" => AdicCompletion (maximalIdeal (Localization.AtPrime 𝔪))
  (Localization.AtPrime 𝔪)

/-- **Unramified finite-type models of approximate solutions.** -/
theorem exists_model (happrox : EtaleCompletionApproximation (Localization.AtPrime 𝔪))
    {V : Type} [Fintype V] (val : V → P̂) {q : ℕ} (rel : Fin q → MvPolynomial V R)
    (hrel : ∀ k, MvPolynomial.eval₂ ((algebraMap S P̂).comp MvPolynomial.C) val (rel k) = 0)
    (N : ℕ) :
    ∃ (T₀ : Type u) (_ : CommRing T₀) (_ : Algebra R T₀), Algebra.FiniteType R T₀ ∧
      ∃ (σT : S →ₐ[R] T₀) (vT : MvPolynomial V R →ₐ[R] T₀) (ι₀ : T₀ →+* P̂),
        (∀ s, ι₀ (σT s) = algebraMap S P̂ s) ∧ (∀ k, vT (rel k) = 0) ∧
        (∀ v, ι₀ (vT (MvPolynomial.X v)) - val v ∈ maximalIdeal P̂ ^ N) ∧
        (∀ t, ∃ s, t - σT s ∈ ((maximalIdeal P̂).comap ι₀) ^ 2) := by
  classical
  let rP : R →+* P := (algebraMap S P).comp MvPolynomial.C
  -- the finite-type subalgebra of the completion generated by `val`
  let C : Subalgebra P P̂ := Algebra.adjoin P (Set.range val)
  have hCft : Algebra.FiniteType P C := by
    rw [← Subalgebra.fg_iff_finiteType]
    have := Subalgebra.fg_adjoin_finset (R := P) (Finset.univ.image val)
    simpa using this
  obtain ⟨E, _, _, hEt, g, ιE, hcong⟩ := happrox C C.val N
  have : Algebra.FormallyUnramified P E := inferInstance
  have : Algebra.FiniteType P E := inferInstance
  let valC : V → C := fun v => ⟨val v, Algebra.subset_adjoin ⟨v, rfl⟩⟩
  let evC : MvPolynomial V R →+* C := MvPolynomial.eval₂Hom ((algebraMap P C).comp rP) valC
  have hevC : ∀ x, (evC x : P̂) =
      MvPolynomial.eval₂ ((algebraMap S P̂).comp MvPolynomial.C) val x := by
    intro x
    have : C.val.toRingHom.comp evC =
        MvPolynomial.eval₂Hom ((algebraMap S P̂).comp MvPolynomial.C) val := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [evC, rP, algebraMap_completion_eq 𝔪]
      · intro v; simp [evC, valC]
    exact DFunLike.congr_fun this x
  -- the relations hold for the images in `E`
  let gR : MvPolynomial V R →+* E := g.toRingHom.comp evC
  have hgR : ∀ k, gR (rel k) = 0 := by
    intro k
    have : evC (rel k) = 0 := Subtype.ext (by rw [hevC, hrel k]; rfl)
    change g (evC (rel k)) = 0
    rw [this, map_zero]
  have hcongv : ∀ v, ιE (g (valC v)) - val v ∈ maximalIdeal P̂ ^ N := by
    intro v
    rw [mem_pow_iff_evalₐ_eq_zero, map_sub, sub_eq_zero]
    have := DFunLike.congr_fun hcong (valC v)
    simp only [AlgHom.comp_apply] at this
    rw [this]
    rfl
  -- generators of `E` over the localization
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := P) (A := E)
  let W := ι ⊕ V ⊕ ↥s
  let rE : R →+* E := (algebraMap P E).comp rP
  let w : W → E := Sum.elim (fun i => algebraMap P E (algebraMap S P (MvPolynomial.X i)))
    (Sum.elim (fun v => g (valC v)) (fun e => e.1))
  let ν : MvPolynomial W R →+* E := MvPolynomial.eval₂Hom rE w
  let T₀ := MvPolynomial W R ⧸ RingHom.ker ν
  let jT : T₀ →+* E := RingHom.kerLift ν
  have hj : Function.Injective jT := RingHom.kerLift_injective ν
  let σT : S →ₐ[R] T₀ :=
    (Ideal.Quotient.mkₐ R (RingHom.ker ν)).comp (MvPolynomial.rename Sum.inl)
  let vT : MvPolynomial V R →ₐ[R] T₀ :=
    (Ideal.Quotient.mkₐ R (RingHom.ker ν)).comp (MvPolynomial.rename (Sum.inr ∘ Sum.inl))
  let ι₀ : T₀ →+* P̂ := ιE.toRingHom.comp jT
  have hjσ : ∀ x, jT (σT x) = algebraMap P E (algebraMap S P x) := by
    intro x
    change ν (MvPolynomial.rename Sum.inl x) = _
    simp only [ν, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename]
    have : MvPolynomial.eval₂Hom rE (w ∘ Sum.inl) =
        (algebraMap P E).comp (algebraMap S P) := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [rE, rP]
      · intro i; simp [w]
    exact DFunLike.congr_fun this x
  have hjv : ∀ x, jT (vT x) = gR x := by
    intro x
    change ν (MvPolynomial.rename (Sum.inr ∘ Sum.inl) x) = gR x
    simp only [ν, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename]
    have : MvPolynomial.eval₂Hom rE (w ∘ Sum.inr ∘ Sum.inl) = gR := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, gR, rE, RingHom.comp_apply,
          evC, MvPolynomial.coe_eval₂Hom]
        exact (g.commutes (rP r)).symm
      · intro v
        simp [gR, w, evC]
    exact DFunLike.congr_fun this x
  have hισ : ∀ x, ι₀ (σT x) = algebraMap S P̂ x := by
    intro x
    change ιE (jT (σT x)) = _
    rw [hjσ, AlgHom.commutes]
    rfl
  refine ⟨T₀, inferInstance, inferInstance, inferInstance, σT, vT, ι₀, hισ, ?_, ?_, ?_⟩
  · intro k
    apply hj
    rw [hjv, hgR, map_zero]
  · intro v
    change ιE (jT (vT (MvPolynomial.X v))) - val v ∈ _
    rw [hjv]
    have : gR (MvPolynomial.X v) = g (valC v) := by simp [gR, evC]
    rw [this]
    exact hcongv v
  · -- unramifiedness at the preimage of the maximal ideal
    have hden : ∀ e : E, ∃ x ∉ 𝔪, ∃ t : T₀, jT t = jT (σT.toRingHom x) * e := by
      intro e
      have he : e ∈ Algebra.adjoin P (s : Set E) := by rw [hs]; trivial
      induction he using Algebra.adjoin_induction with
      | mem e he =>
        refine ⟨1, fun h => (Ideal.IsMaximal.ne_top ‹_›) ((Ideal.eq_top_iff_one _).mpr h),
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr (Sum.inr ⟨e, he⟩))), ?_⟩
        rw [map_one, map_one, one_mul]
        change ν _ = e
        simp [ν, w]
      | algebraMap p =>
        obtain ⟨⟨a, x⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl p
        refine ⟨x, x.2, σT a, ?_⟩
        change jT (σT a) = jT (σT (x : S)) * _
        rw [hjσ, hjσ, ← map_mul, IsLocalization.mk'_spec'_mk]
      | add e₁ e₂ _ _ h₁ h₂ =>
        obtain ⟨x₁, hx₁, t₁, ht₁⟩ := h₁
        obtain ⟨x₂, hx₂, t₂, ht₂⟩ := h₂
        refine ⟨x₁ * x₂, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hx₁ hx₂,
          σT x₂ * t₁ + σT x₁ * t₂, ?_⟩
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at ht₁ ht₂ ⊢
        simp only [map_add, map_mul, ht₁, ht₂]
        ring
      | mul e₁ e₂ _ _ h₁ h₂ =>
        obtain ⟨x₁, hx₁, t₁, ht₁⟩ := h₁
        obtain ⟨x₂, hx₂, t₂, ht₂⟩ := h₂
        refine ⟨x₁ * x₂, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hx₁ hx₂,
          t₁ * t₂, ?_⟩
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at ht₁ ht₂ ⊢
        simp only [map_mul, ht₁, ht₂]
        ring
    have hres : ∀ t : T₀, ∃ x, t - σT.toRingHom x ∈ (maximalIdeal P̂).comap ι₀ := by
      intro t
      obtain ⟨x, hx⟩ := exists_sub_algebraMap_mem_pow_completion 𝔪 (ι₀ t) 1
      refine ⟨x, ?_⟩
      rw [Ideal.mem_comap, map_sub]
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hισ]
      simpa using hx
    have h𝔪 : 𝔪.map σT.toRingHom ≤ (maximalIdeal P̂).comap ι₀ := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, Ideal.mem_comap]
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hισ, maximalIdeal_completion_eq_map]
      exact Ideal.mem_map_of_mem _ hm
    exact UnramifiedSubalgebraSquare.exists_sub_mem_sq 𝔪 σT.toRingHom jT hj
      (fun x => by simpa using hjσ x) hden _ hres h𝔪

end Langlands.CommutativeAlgebra.EtaleApproximationModel
