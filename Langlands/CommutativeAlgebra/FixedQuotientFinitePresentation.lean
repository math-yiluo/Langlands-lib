import Langlands.CommutativeAlgebra.GradedFixedQuotient
import Mathlib.RingTheory.FinitePresentation

/-! # Finite equations for the actual fixed quotient of a group-algebra action -/

noncomputable section

universe u v w

set_option maxHeartbeats 800000

namespace Langlands.CommutativeAlgebra.GradedFixedQuotient

variable {R : Type u} {B : Type v} {M : Type w}
  [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup M]
  (c : B →ₐ[R] AddMonoidAlgebra B M)

open AddMonoidAlgebra

/-- The finite coefficient equations imposing fixedness on a finite family
of algebra elements. -/
def generatorFixedCoefficients (s : Finset B) : Finset B := by
  classical
  exact s.biUnion (fun b =>
    (c b - single 0 b).coeff.support.image (fun m => (c b - single 0 b).coeff m))

/-- The ideal generated by the finite coefficient equations for the given
family of algebra elements. -/
def generatorFixedIdeal (s : Finset B) : Ideal B :=
  Ideal.span (generatorFixedCoefficients c s : Set B)

theorem fg_generatorFixedIdeal (s : Finset B) : (generatorFixedIdeal c s).FG :=
  Submodule.fg_span (generatorFixedCoefficients c s).finite_toSet

theorem coefficient_mem_generatorFixedIdeal {s : Finset B} {b : B} (hb : b ∈ s) (m : M) :
    (c b - single 0 b).coeff m ∈ generatorFixedIdeal c s := by
  classical
  by_cases hm : m ∈ (c b - single 0 b).coeff.support
  · apply Ideal.subset_span
    exact Finset.mem_biUnion.mpr ⟨b, hb, Finset.mem_image.mpr ⟨m, hm, rfl⟩⟩
  · rw [Finsupp.notMem_support_iff.mp hm]
    exact Ideal.zero_mem _

theorem generatorFixedIdeal_le (s : Finset B) :
    generatorFixedIdeal c s ≤ fixedIdeal c.toRingHom := by
  classical
  apply Ideal.span_le.mpr
  intro d hd
  obtain ⟨b, _, hd⟩ := Finset.mem_biUnion.mp hd
  obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp hd
  exact Ideal.subset_span ⟨b, m, rfl⟩

/-- Fixedness on algebra generators imposes the full actual fixed ideal.
No grading identities or noetherian hypothesis are needed. -/
theorem generatorFixedIdeal_eq_fixedIdeal (s : Finset B)
    (hs : Algebra.adjoin R (s : Set B) = ⊤) :
    generatorFixedIdeal c s = fixedIdeal c.toRingHom := by
  classical
  apply le_antisymm (generatorFixedIdeal_le c s)
  let J := generatorFixedIdeal c s
  let q := Ideal.Quotient.mkₐ R J
  let f : B →ₐ[R] AddMonoidAlgebra (B ⧸ J) M :=
    (AddMonoidAlgebra.mapAlgHom M q).comp c
  let g : B →ₐ[R] AddMonoidAlgebra (B ⧸ J) M :=
    (AddMonoidAlgebra.singleZeroAlgHom :
      (B ⧸ J) →ₐ[R] AddMonoidAlgebra (B ⧸ J) M).comp q
  have hfg : f = g := by
    apply AlgHom.ext_of_adjoin_eq_top hs
    intro b hb
    ext m
    have hzero : q ((c b - single 0 b).coeff m) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (coefficient_mem_generatorFixedIdeal c hb m)
    rw [coeff_sub, Finsupp.sub_apply, map_sub, sub_eq_zero] at hzero
    change q ((c b).coeff m) = (single 0 (q b)).coeff m
    simpa only [coeff_single, Finsupp.single_apply, apply_ite, map_zero] using hzero
  have hker : fixedIdeal c.toRingHom ≤ RingHom.ker q.toRingHom :=
    (fixedIdeal_le_ker_iff c.toRingHom q.toRingHom).mpr
      (fun b => AlgHom.congr_fun hfg b)
  exact hker.trans (by
    change RingHom.ker (Ideal.Quotient.mk J) ≤ J
    rw [Ideal.mk_ker])

/-- The ideal imposing actual fixedness is finitely generated for every
finite-type algebra over an arbitrary commutative ring. -/
theorem fg_fixedIdeal [Algebra.FiniteType R B] : (fixedIdeal c.toRingHom).FG := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := B)
  rw [← generatorFixedIdeal_eq_fixedIdeal c s hs]
  exact fg_generatorFixedIdeal c s

/-- The actual fixed quotient of a finitely presented algebra remains
finitely presented over an arbitrary commutative base ring. -/
theorem finitePresentation_fixedQuotient [Algebra.FinitePresentation R B] :
    Algebra.FinitePresentation R (B ⧸ fixedIdeal c.toRingHom) :=
  Algebra.FinitePresentation.quotient (fg_fixedIdeal c)

/-- The fixed quotient of a smooth group-graded algebra is smooth over an
arbitrary commutative base ring. -/
theorem smooth_fixedQuotient [Algebra.Smooth R B]
    (hδ : ∀ b m, c ((c b).coeff m) = single m ((c b).coeff m)) :
    Algebra.Smooth R (B ⧸ fixedIdeal c.toRingHom) where
  finitePresentation := finitePresentation_fixedQuotient c
  formallySmooth := formallySmooth_quotient_fixedIdeal c.toRingHom
    (fun r => c.commutes r) hδ

end Langlands.CommutativeAlgebra.GradedFixedQuotient
