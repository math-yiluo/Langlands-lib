import Langlands.GroupScheme.Dynamic.Representability
import Mathlib.RingTheory.Smooth.Basic
import Mathlib.Algebra.Polynomial.Laurent
import Mathlib.RingTheory.Polynomial.Basic

/-! # Formal smoothness of quotients cut out by a `ℤ`-grading

Let `B` be an `R`-algebra with a `ℤ`-grading, given as a ring map `c : B →+* B[T, T⁻¹]` with
`c (c(b)ₙ) = c(b)ₙ Tⁿ` and `∑ₙ c(b)ₙ = b`, compatible with `R`. If `B` is formally smooth over
`R`, then so are the quotients of `B` by the ideal generated by the homogeneous components of
negative degree, and by the ideal generated by the homogeneous components of nonzero degree.
A retract of a formally smooth algebra is formally smooth.
-/

noncomputable section

universe u v

open Polynomial

namespace Langlands.CommutativeAlgebra.GradedFormallySmooth

section Laurent

variable {D : Type*} [CommRing D]

theorem mapRingHom_toLaurent {D' : Type*} [CommRing D'] (f : D →+* D') (p : D[X]) :
    AddMonoidAlgebra.mapRingHom ℤ f (toLaurent p) = toLaurent (p.map f) := by
  have h : (AddMonoidAlgebra.mapRingHom ℤ f).comp toLaurent =
      toLaurent.comp (Polynomial.mapRingHom f) := by
    apply Polynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        Polynomial.toLaurent_C]
      rw [← LaurentPolynomial.single_eq_C, ← LaurentPolynomial.single_eq_C,
        AddMonoidAlgebra.mapRingHom_single]
    · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
        Polynomial.toLaurent_X, LaurentPolynomial.T, AddMonoidAlgebra.mapRingHom_single, map_one]
  exact RingHom.congr_fun h p

/-- If all coefficients of `q` away from degree `i` and all coefficients of `q'` away from
degree `j` lie in an ideal `J` with `J * J = 0`, then the coefficient of degree `i + j` of
`q * q'` is `qᵢ * q'ⱼ`. -/
theorem coeff_mul_add_of_coeff_mem {J : Ideal D} (hJ : ∀ a ∈ J, ∀ b ∈ J, a * b = 0)
    {q q' : LaurentPolynomial D} {i j : ℤ} (hq : ∀ k, k ≠ i → q.coeff k ∈ J)
    (hq' : ∀ k, k ≠ j → q'.coeff k ∈ J) :
    (q * q').coeff (i + j) = q.coeff i * q'.coeff j := by
  classical
  rw [AddMonoidAlgebra.coeff_mul]
  have key : ∀ m₁ m₂, (if m₁ + m₂ = i + j then q.coeff m₁ * q'.coeff m₂ else 0) =
      if m₁ = i then (if m₂ = j then q.coeff m₁ * q'.coeff m₂ else 0) else 0 := by
    intro m₁ m₂
    by_cases h1 : m₁ = i
    · subst h1
      by_cases h2 : m₂ = j
      · simp [h2]
      · have h : ¬ m₁ + m₂ = m₁ + j := fun h => h2 (by omega)
        simp [h, h2]
    · by_cases h : m₁ + m₂ = i + j
      · have h2 : m₂ ≠ j := fun h2 => h1 (by omega)
        rw [ite_eq_left h, ite_eq_right h1]
        exact hJ _ (hq _ h1) _ (hq' _ h2)
      · simp [h, h1]
  simp only [Finsupp.sum, key]
  rw [Finset.sum_eq_single i]
  · rw [Finset.sum_eq_single j]
    · simp
    · intro m₂ _ h
      simp [h]
    · intro hj
      simp [Finsupp.notMem_support_iff.1 hj]
  · intro m₁ _ h
    simp [h]
  · intro hi
    simp [Finsupp.notMem_support_iff.1 hi]

end Laurent

section Diagonal

variable {B D : Type*} [CommRing B] [CommRing D]

/-- The additive map `∑ₙ aₙ Tⁿ ↦ ∑ₙ (L aₙ)ₙ`, taking for each `n` the coefficient of degree `n`
of `L aₙ`. -/
def diag (L : B →+* LaurentPolynomial D) : LaurentPolynomial B →+ D where
  toFun q := q.coeff.sum fun n a => (L a).coeff n
  map_zero' := by simp
  map_add' q q' := by
    rw [AddMonoidAlgebra.coeff_add]
    exact Finsupp.sum_add_index' (fun n => by simp)
      (fun n a a' => by simp [AddMonoidAlgebra.coeff_add])

theorem diag_apply (L : B →+* LaurentPolynomial D) (q : LaurentPolynomial B) :
    diag L q = q.coeff.sum fun n a => (L a).coeff n :=
  rfl

theorem diag_single (L : B →+* LaurentPolynomial D) (n : ℤ) (a : B) :
    diag L (AddMonoidAlgebra.single n a) = (L a).coeff n := by
  rw [diag_apply, AddMonoidAlgebra.coeff_single]
  exact Finsupp.sum_single_index (by simp)

theorem diag_C_comp (Y : B →+* D) (q : LaurentPolynomial B) :
    diag (LaurentPolynomial.C.comp Y) q = Y (q.coeff 0) := by
  classical
  rw [diag_apply, Finsupp.sum, Finset.sum_eq_single 0]
  · simp
  · intro n _ hn
    simp [hn]
  · intro h
    simp [Finsupp.notMem_support_iff.1 h]

/-- `q` is *diagonal for `L` modulo `J`*: for every `i`, the image under `L` of the coefficient of
degree `i` of `q` has all its coefficients away from degree `i` in `J`. -/
def IsDiagonalMod (L : B →+* LaurentPolynomial D) (J : Ideal D) (q : LaurentPolynomial B) :
    Prop :=
  ∀ i k, k ≠ i → (L (q.coeff i)).coeff k ∈ J

theorem diag_mul {L : B →+* LaurentPolynomial D} {J : Ideal D}
    (hJ : ∀ a ∈ J, ∀ b ∈ J, a * b = 0) {q q' : LaurentPolynomial B}
    (hq : IsDiagonalMod L J q) (hq' : IsDiagonalMod L J q') :
    diag L (q * q') = diag L q * diag L q' := by
  classical
  have e : q * q' = ∑ i ∈ q.coeff.support, ∑ j ∈ q'.coeff.support,
      AddMonoidAlgebra.single (i + j) (q.coeff i * q'.coeff j) := by
    conv_lhs => rw [← AddMonoidAlgebra.sum_coeff_single q,
      ← AddMonoidAlgebra.sum_coeff_single q']
    rw [Finsupp.sum, Finsupp.sum, Finset.sum_mul_sum]
    simp only [AddMonoidAlgebra.single_mul_single]
  rw [e, diag_apply L q, diag_apply L q', Finsupp.sum, Finsupp.sum, Finset.sum_mul_sum, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [diag_single, map_mul]
  exact coeff_mul_add_of_coeff_mem hJ (hq i) (hq' j)

variable (c : B →+* LaurentPolynomial B)

/-- The ring map `b ↦ ∑ₙ (L (c(b)ₙ))ₙ`, when all values of `c` are diagonal for `L` modulo a
square-zero ideal. -/
def diagRingHom (L : B →+* LaurentPolynomial D) {J : Ideal D}
    (hJ : ∀ a ∈ J, ∀ b ∈ J, a * b = 0) (hL : ∀ b, IsDiagonalMod L J (c b)) : B →+* D where
  toFun b := diag L (c b)
  map_one' := by
    rw [map_one, AddMonoidAlgebra.one_def, diag_single, map_one]
    simp
  map_mul' b b' := by
    rw [map_mul]
    exact diag_mul hJ (hL b) (hL b')
  map_zero' := by rw [map_zero, map_zero]
  map_add' b b' := by rw [map_add, map_add]

theorem diagRingHom_apply (L : B →+* LaurentPolynomial D) {J : Ideal D}
    (hJ : ∀ a ∈ J, ∀ b ∈ J, a * b = 0) (hL : ∀ b, IsDiagonalMod L J (c b)) (b : B) :
    diagRingHom c L hJ hL b = diag L (c b) :=
  rfl

end Diagonal

section PolynomialLift

variable {B A : Type*} [CommRing B] [CommRing A]

/-- A ring map into Laurent polynomials whose values have no terms of negative degree, as a ring
map into polynomials. -/
def polynomialLift (g : B →+* LaurentPolynomial A) (hg : ∀ b, ∀ n < 0, (g b).coeff n = 0) :
    B →+* A[X] where
  toFun b := LaurentPolynomial.trunc (g b)
  map_one' := toLaurent_injective (by rw [Langlands.GroupScheme.AffineLine.toLaurent_trunc (hg 1), map_one, map_one])
  map_mul' b b' := toLaurent_injective (by
    rw [Langlands.GroupScheme.AffineLine.toLaurent_trunc (hg _), map_mul, map_mul, Langlands.GroupScheme.AffineLine.toLaurent_trunc (hg b), Langlands.GroupScheme.AffineLine.toLaurent_trunc (hg b')])
  map_zero' := by rw [map_zero, map_zero]
  map_add' b b' := by rw [map_add, map_add]

theorem toLaurent_polynomialLift (g : B →+* LaurentPolynomial A)
    (hg : ∀ b, ∀ n < 0, (g b).coeff n = 0) (b : B) :
    toLaurent (polynomialLift g hg b) = g b :=
  Langlands.GroupScheme.AffineLine.toLaurent_trunc (hg b)

end PolynomialLift

section Grading

variable {R : Type u} {B : Type v} [CommRing R] [CommRing B] [Algebra R B]
  (c : B →+* LaurentPolynomial B)

/-- The ideal generated by the coefficients of negative degree of the values of `c`. -/
def negIdeal : Ideal B :=
  Ideal.span {d | ∃ b, ∃ n < 0, (c b).coeff n = d}

/-- The ideal generated by the coefficients of `c b - b`, for all `b`. -/
def offIdeal : Ideal B :=
  Ideal.span {d | ∃ b n, (c b - LaurentPolynomial.C b).coeff n = d}

variable {c}

theorem mul_eq_zero_of_sq_eq_bot {D : Type*} [CommRing D] {J : Ideal D} (hJ : J ^ 2 = ⊥) :
    ∀ a ∈ J, ∀ b ∈ J, a * b = 0 := by
  intro a ha b hb
  have h : a * b ∈ J ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul ha hb
  rw [hJ] at h
  exact (Ideal.mem_bot).1 h

/-- If `B` is formally smooth over `R`, then so is its quotient by the ideal generated by the
homogeneous components of negative degree. -/
theorem formallySmooth_quotient_negIdeal [Algebra.FormallySmooth R B]
    (hR : ∀ r : R, c (algebraMap R B r) = LaurentPolynomial.C (algebraMap R B r))
    (hε : ∀ b, ((c b).coeff.sum fun _ a => a) = b)
    (hδ : ∀ b n, c ((c b).coeff n) = AddMonoidAlgebra.single n ((c b).coeff n)) :
    Algebra.FormallySmooth R (B ⧸ negIdeal c) := by
  refine Algebra.FormallySmooth.of_comp_surjective fun D _ _ J hJ x => ?_
  have hJ' := mul_eq_zero_of_sq_eq_bot hJ
  set y : B →ₐ[R] D ⧸ J := x.comp (Ideal.Quotient.mkₐ R (negIdeal c)) with hy_def
  have hy : ∀ b, ∀ n < 0, y ((c b).coeff n) = 0 := fun b n hn => by
    have h : (c b).coeff n ∈ negIdeal c := Ideal.subset_span ⟨b, n, hn, rfl⟩
    rw [hy_def, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.2 h, map_zero]
  let g : B →+* LaurentPolynomial (D ⧸ J) :=
    (AddMonoidAlgebra.mapRingHom ℤ (y : B →+* D ⧸ J)).comp c
  have hg_apply : ∀ b n, (g b).coeff n = y ((c b).coeff n) := fun b n =>
    AddMonoidAlgebra.coeff_mapRingHom _ _ _
  have hg : ∀ b, ∀ n < 0, (g b).coeff n = 0 := fun b n hn => by
    rw [hg_apply, hy b n hn]
  let θ : B →ₐ[R] (D ⧸ J)[X] :=
    { polynomialLift g hg with
      commutes' := fun r => toLaurent_injective (by
        change toLaurent (polynomialLift g hg (algebraMap R B r)) = _
        rw [toLaurent_polynomialLift, Polynomial.algebraMap_apply, Polynomial.toLaurent_C]
        change AddMonoidAlgebra.mapRingHom ℤ (y : B →+* D ⧸ J) (c (algebraMap R B r)) = _
        rw [hR, ← LaurentPolynomial.single_eq_C, AddMonoidAlgebra.mapRingHom_single,
          LaurentPolynomial.single_eq_C]
        simp) }
  have hθ : ∀ b, toLaurent (θ b) = g b := toLaurent_polynomialLift g hg
  have hsurj : Function.Surjective (Polynomial.mapAlgHom (Ideal.Quotient.mkₐ R J)) :=
    Polynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hnil : IsNilpotent (RingHom.ker
      (Polynomial.mapAlgHom (Ideal.Quotient.mkₐ R J) : D[X] →+* (D ⧸ J)[X])) := by
    refine ⟨2, ?_⟩
    rw [Polynomial.mapAlgHom_coe_ringHom]
    change RingHom.ker (Polynomial.mapRingHom (Ideal.Quotient.mk J)) ^ 2 = 0
    rw [Polynomial.ker_mapRingHom, Ideal.mk_ker, ← Ideal.map_pow, hJ, Ideal.map_bot]
    rfl
  let Θ : B →ₐ[R] D[X] := Algebra.FormallySmooth.liftOfSurjective θ _ hsurj hnil
  have hΘ : ∀ b, (Θ b).map (Ideal.Quotient.mk J) = θ b := fun b =>
    Algebra.FormallySmooth.liftOfSurjective_apply θ _ hsurj hnil b
  let L : B →+* LaurentPolynomial D := toLaurent.comp (Θ : B →+* D[X])
  have hmk : ∀ b k, Ideal.Quotient.mk J ((L b).coeff k) = y ((c b).coeff k) := fun b k => by
    rw [← hg_apply, ← hθ, ← hΘ, ← mapRingHom_toLaurent, AddMonoidAlgebra.coeff_mapRingHom]
    rfl
  have hL : ∀ b, IsDiagonalMod L J (c b) := fun b i k hk => by
    rw [← Ideal.Quotient.eq_zero_iff_mem, hmk, hδ, AddMonoidAlgebra.coeff_single,
      Finsupp.single_eq_of_ne hk, map_zero]
  let z : B →ₐ[R] D :=
    { diagRingHom c L hJ' hL with
      commutes' := fun r => by
        change diag L (c (algebraMap R B r)) = _
        rw [hR, ← LaurentPolynomial.single_eq_C, diag_single]
        change (toLaurent (Θ (algebraMap R B r))).coeff 0 = _
        rw [AlgHom.commutes, Polynomial.algebraMap_apply, Polynomial.toLaurent_C]
        simp }
  have hz : ∀ d ∈ negIdeal c, z d = 0 := by
    intro d hd
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hd
    · rintro _ ⟨b, n, hn, rfl⟩
      change diag L (c ((c b).coeff n)) = 0
      rw [hδ, diag_single]
      exact Langlands.GroupScheme.AffineLine.coeff_toLaurent_of_neg _ hn
    · exact map_zero z
    · intro a a' _ _ ha ha'
      rw [map_add, ha, ha', add_zero]
    · intro a a' _ ha'
      rw [smul_eq_mul, map_mul, ha', mul_zero]
  refine ⟨Ideal.Quotient.liftₐ (negIdeal c) z hz, ?_⟩
  apply Ideal.Quotient.algHom_ext
  refine AlgHom.ext fun b => ?_
  change Ideal.Quotient.mk J (diag L (c b)) = y b
  rw [diag_apply, map_finsuppSum]
  conv_rhs => rw [← hε b, map_finsuppSum]
  refine Finsupp.sum_congr fun n _ => ?_
  rw [hmk, hδ, AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same]

/-- If `B` is formally smooth over `R`, then so is its quotient by the ideal generated by the
homogeneous components of nonzero degree. -/
theorem formallySmooth_quotient_offIdeal [Algebra.FormallySmooth R B]
    (hR : ∀ r : R, c (algebraMap R B r) = LaurentPolynomial.C (algebraMap R B r))
    (hδ : ∀ b n, c ((c b).coeff n) = AddMonoidAlgebra.single n ((c b).coeff n)) :
    Algebra.FormallySmooth R (B ⧸ offIdeal c) := by
  refine Algebra.FormallySmooth.of_comp_surjective fun D _ _ J hJ x => ?_
  have hJ' := mul_eq_zero_of_sq_eq_bot hJ
  set y : B →ₐ[R] D ⧸ J := x.comp (Ideal.Quotient.mkₐ R (offIdeal c)) with hy_def
  have hy : ∀ b n, y ((c b - LaurentPolynomial.C b).coeff n) = 0 := fun b n => by
    have h : (c b - LaurentPolynomial.C b).coeff n ∈ offIdeal c := Ideal.subset_span ⟨b, n, rfl⟩
    rw [hy_def, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.2 h, map_zero]
  have hyn : ∀ b n, n ≠ 0 → y ((c b).coeff n) = 0 := fun b n hn => by
    have h := hy b n
    rwa [AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply, LaurentPolynomial.C_apply,
      ite_eq_right hn, sub_zero] at h
  have hy0 : ∀ b, y ((c b).coeff 0) = y b := fun b => by
    have h := hy b 0
    rwa [AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply, LaurentPolynomial.C_apply,
      ite_eq_left rfl, map_sub, sub_eq_zero] at h
  have hnil : IsNilpotent J := ⟨2, hJ⟩
  let Y : B →ₐ[R] D := Algebra.FormallySmooth.lift J hnil y
  have hY : ∀ b, Ideal.Quotient.mk J (Y b) = y b :=
    Algebra.FormallySmooth.mk_lift J hnil y
  let L : B →+* LaurentPolynomial D := LaurentPolynomial.C.comp (Y : B →+* D)
  have hL : ∀ b, IsDiagonalMod L J (c b) := fun b i k hk => by
    change (LaurentPolynomial.C (Y ((c b).coeff i))).coeff k ∈ J
    rw [LaurentPolynomial.C_apply]
    split_ifs with hk0
    · rw [← Ideal.Quotient.eq_zero_iff_mem, hY]
      exact hyn b i (fun hi => hk (hk0.trans hi.symm))
    · exact J.zero_mem
  have hdiag : ∀ b, diagRingHom c L hJ' hL b = Y ((c b).coeff 0) := fun b =>
    diag_C_comp (Y : B →+* D) (c b)
  let z : B →ₐ[R] D :=
    { diagRingHom c L hJ' hL with
      commutes' := fun r => by
        change diagRingHom c L hJ' hL (algebraMap R B r) = _
        rw [hdiag, hR, LaurentPolynomial.C_apply, ite_eq_left rfl]
        exact Y.commutes r }
  have hz : ∀ d ∈ offIdeal c, z d = 0 := by
    intro d hd
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hd
    · rintro _ ⟨b, n, rfl⟩
      change diagRingHom c L hJ' hL _ = 0
      rw [hdiag, AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply, LaurentPolynomial.C_apply]
      by_cases hn : n = 0
      · subst hn
        rw [ite_eq_left rfl, map_sub, hδ, AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply,
          AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same, sub_self, map_zero]
      · rw [ite_eq_right hn, sub_zero, hδ, AddMonoidAlgebra.coeff_single,
          Finsupp.single_eq_of_ne (Ne.symm hn), map_zero]
    · exact map_zero z
    · intro a a' _ _ ha ha'
      rw [map_add, ha, ha', add_zero]
    · intro a a' _ ha'
      rw [smul_eq_mul, map_mul, ha', mul_zero]
  refine ⟨Ideal.Quotient.liftₐ (offIdeal c) z hz, ?_⟩
  apply Ideal.Quotient.algHom_ext
  refine AlgHom.ext fun b => ?_
  change Ideal.Quotient.mk J (diagRingHom c L hJ' hL b) = y b
  rw [hdiag, hY, hy0]

end Grading

section Retract

variable {R : Type u} {A : Type v} {A' : Type*} [CommRing R] [CommRing A] [Algebra R A]
  [CommRing A'] [Algebra R A']

/-- A retract of a formally smooth algebra is formally smooth. -/
theorem formallySmooth_of_retract [Algebra.FormallySmooth R A] (s : A' →ₐ[R] A)
    (r : A →ₐ[R] A') (hrs : r.comp s = AlgHom.id R A') : Algebra.FormallySmooth R A' := by
  refine Algebra.FormallySmooth.of_comp_surjective fun D _ _ J hJ f => ?_
  obtain ⟨g, hg⟩ := Algebra.FormallySmooth.comp_surjective R A J hJ (f.comp r)
  exact ⟨g.comp s, by rw [← AlgHom.comp_assoc, hg, AlgHom.comp_assoc, hrs, AlgHom.comp_id]⟩

end Retract

end Langlands.CommutativeAlgebra.GradedFormallySmooth
