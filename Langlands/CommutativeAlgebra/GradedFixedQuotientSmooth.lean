import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.FinitePresentation

/-! # Smoothness of the fixed quotient of a graded algebra -/

noncomputable section

universe u v w

namespace Langlands.Algebra.GradedFixedQuotient

open DirectSum

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]
  {ι : Type w} [AddCommGroup ι] [DecidableEq ι]
  (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]

/-- The ideal generated by all homogeneous elements of nonzero degree. -/
def fixedIdeal : Ideal A :=
  Ideal.span {x | ∃ i : ι, i ≠ 0 ∧ x ∈ 𝒜 i}

omit [DecidableEq ι] [GradedAlgebra 𝒜] in
theorem mem_fixedIdeal {i : ι} (hi : i ≠ 0) {x : A} (hx : x ∈ 𝒜 i) :
    x ∈ fixedIdeal 𝒜 :=
  Ideal.subset_span ⟨i, hi, hx⟩

variable {𝒜}

/-- After a lift across a square-zero extension, degree-zero projection is multiplicative. -/
def averagedLift {B : Type*} [CommRing B] [Algebra R B] (J : Ideal B) (hJ : J ^ 2 = ⊥)
    (f : A →ₐ[R] B) (hf : ∀ i, i ≠ 0 → ∀ x ∈ 𝒜 i, f x ∈ J) : A →ₐ[R] B where
  toFun x := f (GradedAlgebra.proj 𝒜 0 x)
  map_zero' := by simp
  map_add' x y := by simp
  map_one' := by
    change f (↑(decompose 𝒜 (1 : A) 0)) = 1
    rw [decompose_of_mem_same 𝒜 SetLike.GradedOne.one_mem, map_one]
  commutes' r := by
    have hr : algebraMap R A r ∈ 𝒜 0 := by
      simpa only [Algebra.smul_def, mul_one] using (𝒜 0).smul_mem r SetLike.GradedOne.one_mem
    change f (↑(decompose 𝒜 (algebraMap R A r) 0)) = _
    rw [decompose_of_mem_same 𝒜 hr, f.commutes]
  map_mul' := by
    refine DirectSum.Decomposition.inductionOn 𝒜 (fun x => ?_) ?_ ?_
    · simp
    · rintro i ⟨x, hx⟩
      refine DirectSum.Decomposition.inductionOn 𝒜 ?_ ?_ ?_
      · simp
      · rintro j ⟨y, hy⟩
        change f (↑(decompose 𝒜 (x * y) 0)) =
          f (↑(decompose 𝒜 x 0)) * f (↑(decompose 𝒜 y 0))
        by_cases hi : i = 0
        · subst i
          rw [coe_decompose_mul_of_left_mem_zero 𝒜 hx, map_mul,
            decompose_of_mem_same 𝒜 hx]
        · by_cases hj : j = 0
          · subst j
            rw [coe_decompose_mul_of_right_mem_zero 𝒜 hy, map_mul,
              decompose_of_mem_same 𝒜 hy]
          · rw [decompose_of_mem_ne 𝒜 hx hi, decompose_of_mem_ne 𝒜 hy hj,
              map_zero, zero_mul]
            by_cases hij : i + j = 0
            · rw [decompose_of_mem_same 𝒜 (hij ▸ SetLike.GradedMul.mul_mem hx hy), map_mul]
              apply Ideal.mem_bot.mp
              rw [← hJ, pow_two]
              exact Ideal.mul_mem_mul (hf i hi x hx) (hf j hj y hy)
            · rw [decompose_of_mem_ne 𝒜 (SetLike.GradedMul.mul_mem hx hy) hij, map_zero]
      · intro y z hy hz
        simp only [mul_add, map_add, hy, hz]
    · intro x y hx hy z
      simp only [add_mul, map_add, hx, hy]

@[simp] theorem averagedLift_apply {B : Type*} [CommRing B] [Algebra R B]
    (J : Ideal B) (hJ : J ^ 2 = ⊥) (f : A →ₐ[R] B)
    (hf : ∀ i, i ≠ 0 → ∀ x ∈ 𝒜 i, f x ∈ J) (x : A) :
    averagedLift J hJ f hf x = f (GradedAlgebra.proj 𝒜 0 x) := rfl

/-- A map annihilating the nonzero homogeneous components is unchanged by the
degree-zero projection. -/
theorem map_proj_zero {B : Type*} [CommRing B] [Algebra R B] (f : A →ₐ[R] B)
    (hf : ∀ i, i ≠ 0 → ∀ x ∈ 𝒜 i, f x = 0) (x : A) :
    f (GradedAlgebra.proj 𝒜 0 x) = f x := by
  refine DirectSum.Decomposition.inductionOn 𝒜 ?_ ?_ ?_ x
  · simp
  · rintro i ⟨x, hx⟩
    change f (↑(decompose 𝒜 x 0)) = f x
    by_cases hi : i = 0
    · subst i
      rw [decompose_of_mem_same 𝒜 hx]
    · rw [decompose_of_mem_ne 𝒜 hx hi, map_zero, hf i hi x hx]
  · intro x y hx hy
    simp only [map_add, hx, hy]

/-- The averaged lift annihilates the ideal defining the fixed quotient. -/
theorem fixedIdeal_le_ker_averagedLift {B : Type*} [CommRing B] [Algebra R B]
    (J : Ideal B) (hJ : J ^ 2 = ⊥) (f : A →ₐ[R] B)
    (hf : ∀ i, i ≠ 0 → ∀ x ∈ 𝒜 i, f x ∈ J) :
    fixedIdeal 𝒜 ≤ RingHom.ker (averagedLift J hJ f hf) := by
  apply Ideal.span_le.mpr
  rintro x ⟨i, hi, hx⟩
  change f (↑(decompose 𝒜 x 0)) = 0
  rw [decompose_of_mem_ne 𝒜 hx hi, map_zero]

/-- Taking the quotient by the nonzero homogeneous elements preserves formal
smoothness. No finiteness assumption on the grading group is needed. -/
theorem formallySmooth (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]
    [Algebra.FormallySmooth R A] :
    Algebra.FormallySmooth R (A ⧸ fixedIdeal 𝒜) := by
  apply Algebra.FormallySmooth.of_comp_surjective
  intro B _ _ J hJ f₀
  let q := Ideal.Quotient.mkₐ R (fixedIdeal 𝒜)
  obtain ⟨f, hf⟩ := Algebra.FormallySmooth.comp_surjective R A J hJ (f₀.comp q)
  have hfJ : ∀ i, i ≠ 0 → ∀ x ∈ 𝒜 i, f x ∈ J := by
    intro i hi x hx
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have he := AlgHom.congr_fun hf x
    change Ideal.Quotient.mk J (f x) = _ at he
    rw [he]
    change f₀ (Ideal.Quotient.mk (fixedIdeal 𝒜) x) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (mem_fixedIdeal 𝒜 hi hx), map_zero]
  let g := averagedLift J hJ f hfJ
  refine ⟨Ideal.Quotient.liftₐ (fixedIdeal 𝒜) g
    (fun x hx => fixedIdeal_le_ker_averagedLift J hJ f hfJ hx), ?_⟩
  apply AlgHom.ext
  intro x
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  change (Ideal.Quotient.mkₐ R J) (g x) = f₀ (q x)
  change (Ideal.Quotient.mkₐ R J) (f (GradedAlgebra.proj 𝒜 0 x)) = f₀ (q x)
  apply (AlgHom.congr_fun hf (GradedAlgebra.proj 𝒜 0 x)).trans
  exact map_proj_zero (f₀.comp q) (by
    intro i hi y hy
    change f₀ (Ideal.Quotient.mk (fixedIdeal 𝒜) y) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (mem_fixedIdeal 𝒜 hi hy), map_zero]) x

/-- Over a noetherian base, the fixed quotient of a smooth graded algebra is
smooth. In particular this applies over every field, including when the grading
group has torsion divisible by the characteristic. -/
theorem smooth (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]
    [IsNoetherianRing R] [Algebra.Smooth R A] :
    Algebra.Smooth R (A ⧸ fixedIdeal 𝒜) where
  formallySmooth := formallySmooth 𝒜
  finitePresentation := Algebra.FinitePresentation.of_finiteType.mp inferInstance

end Langlands.Algebra.GradedFixedQuotient
