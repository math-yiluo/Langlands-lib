import Langlands.CommutativeAlgebra.GradedLineLocal

/-! # Epimorphisms of connected positively graded algebras -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.CommutativeAlgebra.GradedLine

variable {R A B : Type u} [CommRing R] [CommRing A] [CommRing B]
  [Algebra R A] [Algebra R B]
  {cA : A →+* LaurentPolynomial A} {cB : B →+* LaurentPolynomial B}
  (hA : IsGrading R cA) (hB : IsGrading R cB)

/-- A homogeneous element together with its strictly positive degree. -/
def PositiveElement := {p : ℤ × B // 0 < p.1 ∧ p.2 ∈ homog hB p.1}

/-- The ideal generated by the images of all positive homogeneous elements. -/
def positiveImageIdeal (φ : B →ₐ[R] A) : Ideal A :=
  Ideal.span (Set.range fun p : PositiveElement hB => φ p.1.2)

/-- Induction on degree upgrades ideal generation by positive homogeneous images to
surjectivity. No finite generation assumption is needed. -/
theorem surjective_of_positiveImageIdeal (φ : B →ₐ[R] A)
    (hnegA : ∀ a, ∀ n < 0, (cA a).coeff n = 0)
    (hzeroA : ∀ a, (cA a).coeff 0 ∈ Set.range (algebraMap R A))
    (hφ : ∀ n b, b ∈ homog hB n → φ b ∈ homog hA n)
    (hI : ∀ n, 0 < n → ∀ a ∈ homog hA n, a ∈ positiveImageIdeal hB φ) :
    Function.Surjective φ := by
  classical
  have h : ∀ k : ℕ, ∀ n : ℤ, n < k → ∀ a ∈ homog hA n, a ∈ φ.range := by
    intro k
    induction k with
    | zero =>
      intro n hn a ha
      have ha0 : a = 0 := by
        rw [← comp_self hA ha]
        exact hnegA a n (by omega)
      rw [ha0]
      exact φ.range.zero_mem
    | succ k ih =>
      intro n hn a ha
      by_cases hn0 : n < 0
      · have ha0 : a = 0 := by
          rw [← comp_self hA ha]
          exact hnegA a n hn0
        rw [ha0]
        exact φ.range.zero_mem
      by_cases hnz : n = 0
      · subst n
        obtain ⟨r, hr⟩ := hzeroA a
        rw [← comp_self hA ha, comp_apply, ← hr]
        exact φ.range.algebraMap_mem r
      have hnpos : 0 < n := by omega
      obtain ⟨d, hd⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp
        (hI n hnpos a ha)
      rw [← comp_self hA ha, ← hd]
      change comp hA n (∑ p ∈ d.support, d p * φ p.1.2) ∈ φ.range
      rw [map_sum]
      refine φ.range.sum_mem fun p _ => ?_
      rw [mul_comm, comp_mul_of_mem hA (hφ p.1.1 p.1.2 p.2.2)]
      exact φ.range.mul_mem ⟨p.1.2, rfl⟩
        (ih (n - p.1.1) (by have := p.2.1; push_cast at hn; omega)
          _ (comp_mem_homog hA _ _))
  intro a
  have ha : a ∈ φ.range := by
    rw [← sum_comp hA a]
    exact φ.range.sum_mem fun n _ => h (n.toNat + 1) n (by omega)
      _ (comp_mem_homog hA n a)
  exact ha

/-- Modulo the positive-image ideal, the map from the source is constant along
its augmentation. -/
theorem quotient_image_eq_scalar (φ : B →ₐ[R] A) (ε : A →ₐ[R] R)
    (hnegB : ∀ b, ∀ n < 0, (cB b).coeff n = 0)
    (hzeroB : ∀ b, comp hB 0 b = algebraMap R B (ε (φ b))) (b : B) :
    Ideal.Quotient.mk (positiveImageIdeal hB φ) (φ b) =
      Ideal.Quotient.mk (positiveImageIdeal hB φ) (algebraMap R A (ε (φ b))) := by
  classical
  let q := Ideal.Quotient.mk (positiveImageIdeal hB φ)
  have hsum : (∑ n ∈ (cB b).coeff.support, q (φ (comp hB n b))) = q (φ b) := by
    simpa only [map_sum] using congrArg (fun b => q (φ b)) (sum_comp hB b)
  change q (φ b) = _
  rw [← hsum]
  calc
    (∑ n ∈ (cB b).coeff.support, q (φ (comp hB n b))) = q (φ (comp hB 0 b)) := by
      apply Finset.sum_eq_single 0
      · intro n _ hn
        by_cases hneg : n < 0
        · simp only [comp_apply, hnegB b n hneg, map_zero]
        · apply Ideal.Quotient.eq_zero_iff_mem.mpr
          exact Ideal.subset_span ⟨⟨(n, comp hB n b),
            by omega, comp_mem_homog hB n b⟩, rfl⟩
      · intro hn
        have h0 : comp hB 0 b = 0 := Finsupp.notMem_support_iff.mp hn
        simp only [h0, map_zero]
    _ = q (algebraMap R A (ε (φ b))) := by rw [hzeroB, φ.commutes]

/-- Epimorphy and a compatible augmentation force every element of the target
to be a scalar modulo the positive-image ideal. -/
theorem sub_scalar_mem_positiveImageIdeal_of_epi (φ : B →ₐ[R] A) (ε : A →ₐ[R] R)
    [Epi (CommRingCat.ofHom φ.toRingHom)]
    (hnegB : ∀ b, ∀ n < 0, (cB b).coeff n = 0)
    (hzeroB : ∀ b, comp hB 0 b = algebraMap R B (ε (φ b))) (a : A) :
    a - algebraMap R A (ε a) ∈ positiveImageIdeal hB φ := by
  let I := positiveImageIdeal hB φ
  let q := Ideal.Quotient.mk I
  let s : A →+* A ⧸ I := (algebraMap R (A ⧸ I)).comp ε.toRingHom
  have hcomp : CommRingCat.ofHom φ.toRingHom ≫ CommRingCat.ofHom q =
      CommRingCat.ofHom φ.toRingHom ≫ CommRingCat.ofHom s := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro b
    exact quotient_image_eq_scalar hB φ ε hnegB hzeroB b
  have heq := (cancel_epi (CommRingCat.ofHom φ.toRingHom)).mp hcomp
  have heval : q a = q (algebraMap R A (ε a)) :=
    congrArg (fun f : CommRingCat.of A ⟶ CommRingCat.of (A ⧸ I) => f a) heq
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q (a - algebraMap R A (ε a)) = 0
  rw [map_sub, heval, sub_self]

/-- An augmentation-compatible epimorphism of connected nonnegatively graded
commutative algebras is surjective. -/
theorem surjective_of_epi (φ : B →ₐ[R] A) (ε : A →ₐ[R] R)
    [Epi (CommRingCat.ofHom φ.toRingHom)]
    (hnegA : ∀ a, ∀ n < 0, (cA a).coeff n = 0)
    (hzeroA : ∀ a, comp hA 0 a = algebraMap R A (ε a))
    (hnegB : ∀ b, ∀ n < 0, (cB b).coeff n = 0)
    (hzeroB : ∀ b, comp hB 0 b = algebraMap R B (ε (φ b)))
    (hφ : ∀ n b, b ∈ homog hB n → φ b ∈ homog hA n) :
    Function.Surjective φ := by
  apply surjective_of_positiveImageIdeal hA hB φ hnegA
    (fun a => ⟨ε a, (hzeroA a).symm⟩) hφ
  intro n hn a ha
  have hs := sub_scalar_mem_positiveImageIdeal_of_epi hB φ ε hnegB hzeroB a
  have h0 : algebraMap R A (ε a) = 0 := by
    rw [← hzeroA, comp_of_mem hA ha]
    simp [ne_of_lt hn]
  simpa only [h0, sub_zero] using hs

/-- A grading-preserving monomorphism between connected contracting affine schemes
with compatible augmentation is a closed immersion. -/
theorem isClosedImmersion_specMap_of_mono (φ : B →ₐ[R] A) (ε : A →ₐ[R] R)
    [Mono (Spec.map (CommRingCat.ofHom φ.toRingHom))]
    (hnegA : ∀ a, ∀ n < 0, (cA a).coeff n = 0)
    (hzeroA : ∀ a, comp hA 0 a = algebraMap R A (ε a))
    (hnegB : ∀ b, ∀ n < 0, (cB b).coeff n = 0)
    (hzeroB : ∀ b, comp hB 0 b = algebraMap R B (ε (φ b)))
    (hφ : ∀ n b, b ∈ homog hB n → φ b ∈ homog hA n) :
    IsClosedImmersion (Spec.map (CommRingCat.ofHom φ.toRingHom)) := by
  have : Mono (CommRingCat.ofHom φ.toRingHom).op :=
    (Functor.mono_map_iff_mono Scheme.Spec _).mp
      (show Mono (Spec.map (CommRingCat.ofHom φ.toRingHom)) from inferInstance)
  have : Epi (CommRingCat.ofHom φ.toRingHom) :=
    show Epi (CommRingCat.ofHom φ.toRingHom).op.unop from inferInstance
  exact IsClosedImmersion.spec_of_surjective _
    (surjective_of_epi hA hB φ ε hnegA hzeroA hnegB hzeroB hφ)

end Langlands.CommutativeAlgebra.GradedLine
