import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.RingTheory.Localization.Integral
import Mathlib.RingTheory.Localization.Finiteness
import Mathlib.RingTheory.Localization.BaseChange

/-! # Integral models of finite separable extensions of a fraction field -/

universe u v w

open scoped nonZeroDivisors TensorProduct
open Algebra IntermediateField

namespace Langlands.CommutativeAlgebra

variable (R : Type u) (K : Type v) (L : Type w)
  [CommRing R] [IsDomain R] [Field K] [Field L]
  [Algebra R K] [IsFractionRing R K] [Algebra R L] [Algebra K L]
  [IsScalarTower R K L]

/-- A finite separable extension of the fraction field has a primitive element
integral over the original domain. -/
theorem exists_integral_primitive_element
    [FiniteDimensional K L] [Algebra.IsSeparable K L] :
    ∃ b : L, IsIntegral R b ∧ K⟮b⟯ = ⊤ := by
  obtain ⟨a, ha⟩ := Field.exists_primitive_element K L
  obtain ⟨r, hr⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
    (Rₘ := K) R⁰ a (Algebra.IsIntegral.isIntegral a)
  refine ⟨r • a, hr, ?_⟩
  have hr0 : algebraMap R K r ≠ 0 := by
    exact fun h => (mem_nonZeroDivisors_iff_ne_zero.mp r.property)
      ((IsFractionRing.to_map_eq_zero_iff (R := R) (K := K)).mp h)
  simp only [Submonoid.smul_def, Algebra.smul_def]
  rw [mul_comm, IsScalarTower.algebraMap_apply R K L,
    IntermediateField.adjoin_simple_mul_algebraMap a _ hr0, ha]

omit [IsDomain R] in
/-- Localizing the actual monogenic subalgebra at the nonzero elements of the
original domain recovers an algebraic extension generated by that element. -/
theorem isLocalization_adjoin_primitive_element
    [Algebra.IsAlgebraic K L] (b : L) (hb : K⟮b⟯ = ⊤) :
    IsLocalization (R⁰.map (algebraMap R (Algebra.adjoin R {b}))) L := by
  let S := Algebra.adjoin R {b}
  refine
    { map_units := ?_
      surj := ?_
      exists_of_eq := ?_ }
  · rintro ⟨s, r, hr, rfl⟩
    change IsUnit (algebraMap R L r)
    rw [IsScalarTower.algebraMap_apply R K L]
    exact (IsLocalization.map_units K (⟨r, hr⟩ : R⁰)).map (algebraMap K L)
  · intro z
    have hz : z ∈ Algebra.adjoin K {b} := by
      rw [Algebra.adjoin_eq_top_of_primitive_element
        (Algebra.IsAlgebraic.isAlgebraic b) hb]
      trivial
    obtain ⟨r, hr⟩ := multiple_mem_adjoin_of_mem_localization_adjoin
      R⁰ K {b} z hz
    refine ⟨(⟨r • z, hr⟩, ⟨algebraMap R S r, r, r.property, rfl⟩), ?_⟩
    change z * algebraMap R L r = r • z
    simp [Submonoid.smul_def, Algebra.smul_def, mul_comm]
  · intro x y h
    exact ⟨1, by simpa using (Subtype.ext h : x = y)⟩

/-- An integral primitive element for the specified extension. The chosen
subalgebra is an actual subalgebra of `L`, rather than an abstract model. -/
structure FiniteSeparableIntegralModel where
  generator : L
  integral : IsIntegral R generator
  primitive : K⟮generator⟯ = ⊤

namespace FiniteSeparableIntegralModel

variable {R K L}

/-- The finite monogenic domain model inside the original extension field. -/
abbrev Carrier (d : FiniteSeparableIntegralModel R K L) :=
  Algebra.adjoin R {d.generator}

instance finite (d : FiniteSeparableIntegralModel R K L) : Module.Finite R d.Carrier :=
  Algebra.finite_adjoin_simple_of_isIntegral d.integral

instance localized (d : FiniteSeparableIntegralModel R K L)
    [Algebra.IsAlgebraic K L] :
    IsLocalization (Algebra.algebraMapSubmonoid d.Carrier R⁰) L :=
  isLocalization_adjoin_primitive_element R K L d.generator d.primitive

/-- The generic base change of the finite domain model is the original field
extension, with its original `K`-algebra structure. -/
noncomputable def genericEquiv (d : FiniteSeparableIntegralModel R K L)
    [Algebra.IsAlgebraic K L] : K ⊗[R] d.Carrier ≃ₐ[K] L := by
  letI := d.localized
  letI : Algebra.IsPushout R d.Carrier K L :=
    Algebra.isPushout_of_isLocalization R⁰ K d.Carrier L
  letI : Algebra.IsPushout R K d.Carrier L := Algebra.IsPushout.symm inferInstance
  exact Algebra.IsPushout.equiv R K d.Carrier L

omit [IsDomain R] in
@[simp]
theorem genericEquiv_tmul (d : FiniteSeparableIntegralModel R K L)
    [Algebra.IsAlgebraic K L] (k : K) (s : d.Carrier) :
    d.genericEquiv (k ⊗ₜ[R] s) = algebraMap K L k * (s : L) := by
  have := d.localized
  have : Algebra.IsPushout R d.Carrier K L :=
    Algebra.isPushout_of_isLocalization R⁰ K d.Carrier L
  have : Algebra.IsPushout R K d.Carrier L := Algebra.IsPushout.symm inferInstance
  exact Algebra.IsPushout.equiv_tmul R K d.Carrier L k s

end FiniteSeparableIntegralModel

/-- Choose the proved finite integral model of a finite separable extension. -/
noncomputable def finiteSeparableIntegralModel
    [FiniteDimensional K L] [Algebra.IsSeparable K L] :
    FiniteSeparableIntegralModel R K L := by
  let h := exists_integral_primitive_element R K L
  exact ⟨Classical.choose h, (Classical.choose_spec h).1, (Classical.choose_spec h).2⟩

end Langlands.CommutativeAlgebra
