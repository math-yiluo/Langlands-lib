import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
import Mathlib.CategoryTheory.Sites.CoverPreserving
import Mathlib.CategoryTheory.Functor.Flat

/-! # Flat functors out of sites generated by precoverages

A representably flat functor `F : C ⥤ D` sends the covering sieves of the topology generated by
a precoverage `P` on `C` to covering sieves of a topology `K` on `D` as soon as it sends the
covering presieves of `P` to covering presieves of a precoverage generating `K`. -/

universe v₁ v₂ u₁ u₂

namespace Langlands.CategoryTheory

open _root_.CategoryTheory

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] (F : C ⥤ D)

/-- For a representably flat functor, the pullback along `F f` of the pushforward of a sieve
is contained in the pushforward of its pullback along `f`. -/
theorem functorPushforward_pullback_le [RepresentablyFlat F] {X Y : C} (S : Sieve X)
    (f : Y ⟶ X) :
    (S.functorPushforward F).pullback (F.map f) ≤ (S.pullback f).functorPushforward F := by
  rintro W h ⟨Z, g, k, hg, hk⟩
  let A : StructuredArrow W F := StructuredArrow.mk k
  let B : StructuredArrow W F := StructuredArrow.mk h
  let E : StructuredArrow W F := StructuredArrow.mk (h ≫ F.map f)
  let a : A ⟶ E := StructuredArrow.homMk g hk.symm
  let b : B ⟶ E := StructuredArrow.homMk f rfl
  obtain ⟨V, a', b', e⟩ := IsCofiltered.cospan a b
  have e' : a'.right ≫ g = b'.right ≫ f := congrArg CommaMorphism.right e
  refine ⟨V.right, b'.right, V.hom, ?_, (StructuredArrow.w b').symm⟩
  change S (b'.right ≫ f)
  rw [← e']
  exact S.downward_closed hg _

/-- The pullback along `k` of the pushforward of the pullback of `R` along `g` is contained in
the pullback along `k ≫ F g` of the pushforward of `R`. -/
theorem pullback_functorPushforward_pullback_le {X Z : C} {W : D} (R : Sieve X) (g : Z ⟶ X)
    (k : W ⟶ F.obj Z) :
    ((R.pullback g).functorPushforward F).pullback k ≤
      (R.functorPushforward F).pullback (k ≫ F.map g) := by
  rintro W' e ⟨Z', r, l, hr, hl⟩
  refine ⟨Z', r ≫ g, l, hr, ?_⟩
  rw [← Category.assoc, hl, Category.assoc, F.map_comp]

variable {F} {P : Precoverage C} {Q : Precoverage D}

/-- A representably flat functor sending covering presieves of `P` to covering presieves of `Q`
is cover-preserving for the generated topologies. -/
theorem coverPreserving_toGrothendieck [RepresentablyFlat F]
    (h : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ P X → R.map F ∈ Q (F.obj X)) :
    CoverPreserving P.toGrothendieck Q.toGrothendieck F where
  cover_preserve {X S} hS := by
    induction hS with
    | of X R hR =>
      rw [← Sieve.generate_map_eq_functorPushforward]
      exact Precoverage.generate_mem_toGrothendieck (h R hR)
    | top X =>
      rw [Sieve.functorPushforward_top]
      exact Q.toGrothendieck.top_mem _
    | pullback X S _ Y f ih =>
      exact Q.toGrothendieck.superset_covering (functorPushforward_pullback_le F S f)
        (Q.toGrothendieck.pullback_stable (F.map f) ih)
    | transitive X S R _ _ ihS ihR =>
      refine Q.toGrothendieck.transitive ihS _ ?_
      rintro W h ⟨Z, g, k, hg, rfl⟩
      exact Q.toGrothendieck.superset_covering
        (pullback_functorPushforward_pullback_le F R g k)
        (Q.toGrothendieck.pullback_stable k (ihR hg))

/-- A representably flat functor sending covering presieves of `P` to covering presieves of `Q`
is continuous for the generated topologies. -/
theorem isContinuous_toGrothendieck [RepresentablyFlat F]
    (h : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ P X → R.map F ∈ Q (F.obj X)) :
    F.IsContinuous P.toGrothendieck Q.toGrothendieck :=
  Functor.isContinuous_iff_coverPreserving.2 (coverPreserving_toGrothendieck h)

end Langlands.CategoryTheory
