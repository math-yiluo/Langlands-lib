import Langlands.CategoryTheory.Renard.SmallProjectiveFiniteSupportStatements
import Langlands.CategoryTheory.Renard.SmallProjectiveFiniteType
import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Products
import Mathlib.LinearAlgebra.Quotient.Defs
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Renard A.VIII.2: small projectives and finite-subcoproduct factorization

Proof of `Langlands.Renard.SmallProjectiveFiniteSupportStatement`. The projectivity conjunct is
carried along unchanged; the content is that the integer-module Hom functor of `P` preserves
`w`-indexed coproducts exactly when every morphism from `P` to such a coproduct factors through
a finite subcoproduct.

* Preservation to factorization: the quotient of `P ⟶ ∐ M` by the submodule generated by the
  images of the summand inclusions vanishes on every leg of the colimit cofan, so it is zero;
  every element of that submodule factors through a finite subcoproduct.
* Factorization to preservation: the published `preservesCoproduct_of_finiteFactor` of
  `Langlands.CategoryTheory.Renard.SmallProjectiveFiniteType`, applied to each coproduct.

See the paired Markdown for the proof route.
-/

open CategoryTheory CategoryTheory.Limits
open Langlands.CategoryTheory.Renard (preadditiveCoyonedaInt)

universe w v u

namespace Langlands.Renard

noncomputable section

section Helpers

variable {C : Type u} [Category.{v} C] [Abelian C] [HasCoproducts.{w} C]

omit [Abelian C] in
/-- The canonical map of a finite subcoproduct factors through that of a larger finite
subcoproduct. -/
theorem finiteSubcoproduct_desc_comp {I : Type w} (M : I → C) {s t : Finset I} (h : s ⊆ t) :
    (Sigma.desc fun j : s => Sigma.ι (fun k : t => M k.val) ⟨j.val, h j.2⟩) ≫
        Sigma.desc (fun k : t => Sigma.ι M k.val) =
      Sigma.desc fun j : s => Sigma.ι M j.val := by
  ext
  simp

/-- If the integer-module Hom functor of `P` preserves `w`-indexed coproducts, every morphism
from `P` to a `w`-indexed coproduct factors through a finite subcoproduct. -/
theorem exists_finiteSubcoproduct_factor_of_homPreservesCoproducts {P : C}
    (hP : HomPreservesCoproducts.{w} P) {I : Type w} (M : I → C) (φ : P ⟶ ∐ M) :
    ∃ (s : Finset I) (g : P ⟶ ∐ (fun j : s => M j.val)),
      g ≫ Sigma.desc (fun j : s => Sigma.ι M j.val) = φ := by
  classical
  have := hP I
  let G := preadditiveCoyonedaInt P
  have hc := isColimitOfHasCoproductOfPreservesColimit G M
  -- `N` is typed through linear maps of `ModuleCat ℤ`, so it carries the restricted
  -- `ℤ`-module structure; the quotient module structure is likewise named explicitly.
  let N := ⨆ j, LinearMap.range (G.map (Sigma.ι M j)).hom
  let Q : ModuleCat ℤ := @ModuleCat.of ℤ _ (_ ⧸ N) _ (Submodule.Quotient.module N)
  let q : G.obj (∐ M) ⟶ Q := ConcreteCategory.ofHom N.mkQ
  have hq : q = 0 := by
    refine Cofan.IsColimit.hom_ext hc _ _ fun j => ?_
    refine ConcreteCategory.hom_ext _ _ fun y => ?_
    exact (Submodule.Quotient.mk_eq_zero N).2
      (Submodule.mem_iSup_of_mem j (LinearMap.mem_range_self _ y))
  have hφN : φ ∈ N :=
    (Submodule.Quotient.mk_eq_zero N).1 (ConcreteCategory.congr_hom hq φ)
  -- Instance search would otherwise give the Hom group's canonical `ℤ`-module structure.
  let : Module ℤ (G.obj (∐ M)) := (G.obj (∐ M)).isModule
  refine Submodule.iSup_induction _
    (motive := fun x : G.obj (∐ M) => ∃ (s : Finset I) (g : P ⟶ ∐ (fun j : s => M j.val)),
      g ≫ Sigma.desc (fun j : s => Sigma.ι M j.val) = x) hφN ?_ ?_ ?_
  · rintro i _ ⟨y, rfl⟩
    have hι : ∀ y' : P ⟶ M i,
        (y' ≫ Sigma.ι (fun j : ({i} : Finset I) => M j.val) ⟨i, Finset.mem_singleton_self i⟩) ≫
          Sigma.desc (fun j : ({i} : Finset I) => Sigma.ι M j.val) = y' ≫ Sigma.ι M i :=
      fun y' => by simp
    exact ⟨{i}, _, hι y⟩
  · refine ⟨∅, 0, ?_⟩
    change _ = (0 : P ⟶ ∐ M)
    simp
  · rintro x y ⟨s, a, ha⟩ ⟨t, b, hb⟩
    refine ⟨s ∪ t,
      a ≫ (Sigma.desc fun j : s => Sigma.ι (fun k : (s ∪ t : Finset I) => M k.val)
          ⟨j.val, Finset.subset_union_left j.2⟩) +
        b ≫ (Sigma.desc fun j : t => Sigma.ι (fun k : (s ∪ t : Finset I) => M k.val)
          ⟨j.val, Finset.subset_union_right j.2⟩), ?_⟩
    rw [Preadditive.add_comp, Category.assoc, Category.assoc,
      finiteSubcoproduct_desc_comp M Finset.subset_union_left,
      finiteSubcoproduct_desc_comp M Finset.subset_union_right, ha, hb]
    rfl

/-- If every morphism from `P` to a `w`-indexed coproduct factors through a finite
subcoproduct, the integer-module Hom functor of `P` preserves `w`-indexed coproducts. Each
coproduct is handled by the published `preservesCoproduct_of_finiteFactor`. -/
theorem homPreservesCoproducts_of_finiteSubcoproduct_factor {P : C}
    (hfac : ∀ (I : Type w) (M : I → C) (φ : P ⟶ ∐ M),
      ∃ (s : Finset I) (g : P ⟶ ∐ (fun j : s => M j.val)),
        g ≫ Sigma.desc (fun j : s => Sigma.ι M j.val) = φ) :
    HomPreservesCoproducts.{w} P := by
  intro I
  have : ∀ M : I → C, PreservesColimit (Discrete.functor M) (preadditiveCoyonedaInt P) :=
    fun M => preservesCoproduct_of_finiteFactor M (hfac I M)
  exact preservesColimitsOfShape_of_discrete _

/-- Renard A.VIII.2, forward direction: every morphism from a small projective object to a
`w`-indexed coproduct factors through a finite subcoproduct. -/
theorem homSmallProjective_finiteSupport {P : C} (hP : HomSmallProjective.{w} P) :
    ∀ (I : Type w) (M : I → C) (φ : P ⟶ ∐ M),
      ∃ (s : Finset I) (g : P ⟶ ∐ (fun j : s => M j.val)),
        g ≫ Sigma.desc (fun j : s => Sigma.ι M j.val) = φ :=
  fun _ M φ => exists_finiteSubcoproduct_factor_of_homPreservesCoproducts hP.2 M φ

/-- Renard A.VIII.2, converse: a projective object all of whose morphisms to `w`-indexed
coproducts factor through finite subcoproducts is small projective. -/
theorem homSmallProjective_of_finiteSupport {P : C} (hproj : HomProjective P)
    (hfac : ∀ (I : Type w) (M : I → C) (φ : P ⟶ ∐ M),
      ∃ (s : Finset I) (g : P ⟶ ∐ (fun j : s => M j.val)),
        g ≫ Sigma.desc (fun j : s => Sigma.ι M j.val) = φ) :
    HomSmallProjective.{w} P :=
  ⟨hproj, homPreservesCoproducts_of_finiteSubcoproduct_factor hfac⟩

end Helpers

end

/-- Renard A.VIII.2: in an abelian category with `w`-indexed coproducts, a projective object
is small exactly when every morphism from it to a `w`-indexed coproduct factors through a
finite subcoproduct. -/
theorem smallProjectiveFiniteSupport (C : Type u) [Category.{v} C] [Abelian C]
    [HasCoproducts.{w} C] : SmallProjectiveFiniteSupportStatement.{w, v, u} C :=
  fun _ => ⟨fun hP => ⟨hP.1, homSmallProjective_finiteSupport hP⟩,
    fun h => homSmallProjective_of_finiteSupport h.1 h.2⟩

end Langlands.Renard
