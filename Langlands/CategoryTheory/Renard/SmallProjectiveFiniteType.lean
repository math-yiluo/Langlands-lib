import Langlands.CategoryTheory.Renard.SmallProjectiveFiniteTypeStatements
import Langlands.CategoryTheory.Renard.HomExactnessComparison
import Langlands.CategoryTheory.Renard.IndexedSubobjectSums
import Langlands.CategoryTheory.Renard.FiniteTypeFiniteSubcover
import Mathlib.Algebra.BigOperators.Finprod
import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Products

/-!
# Renard A.VIII.2: small projectives are the projective finite-type objects

Proof of `Langlands.Renard.SmallProjectiveFiniteTypeStatement`. Both directions keep the
projectivity hypothesis and compare coproduct preservation by the integer-module Hom functor
with finite type.

* Finite type to small: by the source AB5 law and the finite-subcover form of finite type,
  every morphism from `P` to a `w`-indexed coproduct factors through a finite subcoproduct.
  The colimit cocone of integer modules is then built directly from finite sums.
* Small to finite type: unions of subobjects are subobject sums reindexed at `w`. A section
  of the coproduct of the members of a chain lies in the submodule generated by the summand
  inclusions, so by directedness some member of the chain has a section and is `⊤`.

The helper lemmas are private; see the paired Markdown for the proof route.
-/

open CategoryTheory CategoryTheory.Limits
open Langlands.CategoryTheory.Renard (preadditiveCoyonedaInt)

universe w v u

namespace Langlands.Renard

noncomputable section

variable {C : Type u} [Category.{v} C] [Abelian C]

section FiniteSubcoproducts

variable [HasCoproducts.{w} C] {I : Type w} (f : I → C)

/-- The canonical map from a finite subcoproduct has a retraction. -/
private theorem finIncl_retraction [DecidableEq I] (T : Finset I) :
    (Sigma.desc fun j : T => Sigma.ι f j.1) ≫
      Sigma.desc (fun i => if h : i ∈ T then Sigma.ι (fun j : T => f j) ⟨i, h⟩ else 0) =
        𝟙 _ := by
  ext ⟨j, hj⟩
  simp [hj]

private instance mono_finIncl (T : Finset I) : Mono (Sigma.desc fun j : T => Sigma.ι f j.1) := by
  classical
  exact mono_of_mono_fac (finIncl_retraction f T)

/-- The finite subcoproduct indexed by `T`, as a subobject of the full coproduct. -/
private abbrev finSub (T : Finset I) : Subobject (∐ f) :=
  Subobject.mk (Sigma.desc fun j : T => Sigma.ι f j.1)

private theorem finSub_mono {T T' : Finset I} (h : T ⊆ T') : finSub f T ≤ finSub f T' :=
  Subobject.mk_le_mk_of_comm
    (Sigma.desc fun j : T => Sigma.ι (fun j : T' => f j) ⟨j.1, h j.2⟩) (by ext; simp)

/-- An upper bound of all finite subcoproducts is the whole coproduct. -/
private theorem eq_top_of_finSub_le {U : Subobject (∐ f)} (hU : ∀ T : Finset I, finSub f T ≤ U) :
    U = ⊤ := by
  have hfac : ∀ i, U.Factors (Sigma.ι f i) := fun i => by
    apply Subobject.factors_of_le _ (hU {i})
    have := Subobject.factors_of_factors_right
      (Sigma.ι (fun j : ({i} : Finset I) => f j) ⟨i, Finset.mem_singleton_self i⟩)
      (Subobject.mk_factors_self (Sigma.desc fun j : ({i} : Finset I) => Sigma.ι f j.1))
    simpa using this
  let s : ∐ f ⟶ (U : C) := Sigma.desc fun i => U.factorThru (Sigma.ι f i) (hfac i)
  have hs : s ≫ U.arrow = 𝟙 _ := by
    ext i
    simp [s]
  have : IsSplitEpi U.arrow := IsSplitEpi.mk' ⟨s, hs⟩
  exact (Subobject.isIso_arrow_iff_eq_top U).1 (isIso_of_mono_of_epi _)

end FiniteSubcoproducts

/-- Pulling back along `g` a family whose meets with the image of `g` have the image
as least upper bound gives a family with least upper bound `⊤`. -/
private theorem isLUB_pullback_top {P X : C} (g : P ⟶ X) {J : Type*} [Nonempty J]
    (A : J → Subobject X)
    (hA : IsLUB (Set.range fun j => imageSubobject g ⊓ A j) (imageSubobject g)) :
    IsLUB (Set.range fun j => (Subobject.pullback g).obj (A j)) ⊤ := by
  refine ⟨fun _ _ => le_top, fun V hV => ?_⟩
  have hV' : ∀ j, (Subobject.pullback g).obj (A j) ≤ V := fun j => hV ⟨j, rfl⟩
  have hz : ∀ {Z : C} (z : Z ⟶ P) (j : J) (y : Z ⟶ (A j : C)),
      y ≫ (A j).arrow = z ≫ g → z ≫ cokernel.π V.arrow = 0 := by
    intro Z z j y h
    have hl := (Subobject.isPullback g (A j)).lift_snd y z h
    have h0 : ((Subobject.pullback g).obj (A j)).arrow ≫ cokernel.π V.arrow = 0 := by
      rw [← Subobject.ofLE_arrow (hV' j), Category.assoc, cokernel.condition, comp_zero]
    rw [← hl, Category.assoc, h0, comp_zero]
  have hker : kernel.ι g ≫ cokernel.π V.arrow = 0 :=
    hz (kernel.ι g) (Classical.arbitrary J) 0 (by simp)
  have hke : kernel.ι (factorThruImage g) ≫ cokernel.π V.arrow = 0 := by
    have h0 : kernel.ι (factorThruImage g) ≫ g = 0 := by
      calc kernel.ι (factorThruImage g) ≫ g
          = kernel.ι (factorThruImage g) ≫ factorThruImage g ≫ image.ι g := by simp
        _ = 0 := by rw [kernel.condition_assoc, zero_comp]
    rw [← kernel.lift_ι g (kernel.ι (factorThruImage g)) h0, Category.assoc, hker, comp_zero]
  -- The cokernel of `V.arrow` factors through the epimorphism `P ⟶ image g` as `q'`.
  set q' := Abelian.epiDesc (factorThruImage g) (cokernel.π V.arrow) hke
  have hq' : factorThruImage g ≫ q' = cokernel.π V.arrow := Abelian.comp_epiDesc _ _ hke
  have hq'0 : q' = 0 := by
    have hle : ∀ j, imageSubobject g ⊓ A j ≤ Subobject.mk (kernel.ι q' ≫ image.ι g) := by
      intro j
      let a : ((imageSubobject g ⊓ A j : Subobject X) : C) ⟶ image g :=
        Subobject.ofLE _ (imageSubobject g) inf_le_left ≫ (imageSubobjectIso g).hom
      have ha : a ≫ image.ι g = (imageSubobject g ⊓ A j).arrow := by simp [a]
      have h1 : pullback.fst (factorThruImage g) a ≫ cokernel.π V.arrow = 0 := by
        refine hz (pullback.fst (factorThruImage g) a) j
          (pullback.snd (factorThruImage g) a ≫ Subobject.ofLE _ (A j) inf_le_right) ?_
        rw [Category.assoc, Subobject.ofLE_arrow, ← ha, ← Category.assoc, ← pullback.condition,
          Category.assoc, image.fac]
      rw [← hq', ← Category.assoc, pullback.condition, Category.assoc] at h1
      have haq : a ≫ q' = 0 :=
        (cancel_epi (pullback.snd (factorThruImage g) a)).1 (by rw [h1, comp_zero])
      exact Subobject.le_mk_of_comm (kernel.lift q' a haq) (by simp [ha])
    have htop : imageSubobject g ≤ Subobject.mk (kernel.ι q' ≫ image.ι g) :=
      hA.2 (by rintro _ ⟨j, rfl⟩; exact hle j)
    have key : ((imageSubobjectIso g).inv ≫ Subobject.ofLE _ _ htop ≫
        (Subobject.underlyingIso (kernel.ι q' ≫ image.ι g)).hom ≫ kernel.ι q') ≫ image.ι g =
          𝟙 _ ≫ image.ι g := by
      simp only [Category.assoc]
      rw [Subobject.underlyingIso_hom_comp_eq_mk, Subobject.ofLE_arrow, imageSubobject_arrow',
        Category.id_comp]
    have key' := (cancel_mono (image.ι g)).1 key
    calc q' = 𝟙 _ ≫ q' := (Category.id_comp _).symm
      _ = 0 := by rw [← key']; simp
  have hq : cokernel.π V.arrow = 0 := by rw [← hq', hq'0, comp_zero]
  have : Epi V.arrow := Abelian.epi_of_cokernel_π_eq_zero _ hq
  have : IsIso V.arrow := isIso_of_mono_of_epi _
  exact (Subobject.eq_top_of_isIso_arrow V).ge

section Preservation

variable [HasCoproducts.{w} C]

/-- In a source AB5 category, every map from a finite-type object to a coproduct factors
through a finite subcoproduct. -/
private theorem exists_finite_factor {P : C} (hft : IsFiniteTypeObject P)
    (hAB5 : DirectedSubobjectSumsDistribute.{w} C) {I : Type w} (f : I → C) (g : P ⟶ ∐ f) :
    ∃ (T : Finset I) (g' : P ⟶ ∐ fun j : T => f j),
      g' ≫ Sigma.desc (fun j : T => Sigma.ι f j.1) = g := by
  classical
  obtain ⟨U, hU, hNU⟩ := hAB5 (∐ f) (Finset I) ⟨∅⟩ (finSub f)
    (Monotone.directed_le fun _ _ h => finSub_mono f h) (imageSubobject g)
  have hUtop : U = ⊤ := eq_top_of_finSub_le f (fun T => hU.1 ⟨T, rfl⟩)
  rw [hUtop, inf_top_eq] at hNU
  have hlub := isLUB_pullback_top g (finSub f) hNU
  obtain ⟨-, hcov⟩ := (finiteTypeFiniteSubcover C P).1 hft
  obtain ⟨F, hFS, hFt⟩ := hcov _ hlub
  have hmem : ∀ x ∈ F, ∃ T : Finset I, (Subobject.pullback g).obj (finSub f T) = x :=
    fun x hx => hFS hx
  choose! τ hτ using hmem
  have htop : (Subobject.pullback g).obj (finSub f (F.sup τ)) = ⊤ := by
    refine le_antisymm le_top (hFt.2 ?_)
    intro x hx
    rw [← hτ x hx]
    exact ((Subobject.pullback g).map (homOfLE (finSub_mono f (Finset.le_sup hx)))).le
  have : IsIso ((Subobject.pullback g).obj (finSub f (F.sup τ))).arrow :=
    (Subobject.isIso_arrow_iff_eq_top _).2 htop
  refine ⟨F.sup τ, inv ((Subobject.pullback g).obj (finSub f (F.sup τ))).arrow ≫
    Subobject.pullbackπ g (finSub f (F.sup τ)) ≫ (Subobject.underlyingIso _).hom, ?_⟩
  have hw := (Subobject.isPullback g (finSub f (F.sup τ))).w
  rw [Category.assoc, Category.assoc, Subobject.underlyingIso_hom_comp_eq_mk]
  rw [hw, IsIso.inv_hom_id_assoc]

/-- A map into a coproduct which factors through finite subcoproducts is the finite sum of its
components, and its components vanish outside a finite set. -/
private theorem finite_decomp {P : C} {I : Type w} (f : I → C) [DecidableEq I]
    (hfact : ∀ g : P ⟶ ∐ f, ∃ (T : Finset I) (g' : P ⟶ ∐ fun j : T => f j),
      g' ≫ Sigma.desc (fun j : T => Sigma.ι f j.1) = g) (x : P ⟶ ∐ f) :
    ∃ T : Finset I, (∀ j ∉ T, x ≫ Sigma.π f j = 0) ∧
      x = ∑ j ∈ T, (x ≫ Sigma.π f j) ≫ Sigma.ι f j := by
  obtain ⟨T, g', rfl⟩ := hfact x
  refine ⟨T, fun j hj => ?_, ?_⟩
  · have : (Sigma.desc fun k : T => Sigma.ι f k.1) ≫ Sigma.π f j = 0 := by
      ext ⟨k, hk⟩
      simp [Sigma.ι_π_of_ne f (show k ≠ j from fun h => hj (h ▸ hk))]
    rw [Category.assoc, this, comp_zero]
  · have : (Sigma.desc fun k : T => Sigma.ι f k.1) = ∑ j ∈ T,
        (Sigma.desc fun k : T => Sigma.ι f k.1) ≫ Sigma.π f j ≫ Sigma.ι f j := by
      ext ⟨k, hk⟩
      rw [Preadditive.comp_sum]
      simp only [Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc]
      rw [Finset.sum_eq_single k]
      · simp
      · intro b _ hb
        rw [Sigma.ι_π_of_ne_assoc f (Ne.symm hb), zero_comp]
      · intro h
        exact absurd hk h
    conv_lhs => rw [this]
    rw [Preadditive.comp_sum]
    simp only [Category.assoc]

/-- An additive map between `ℤ`-modules commutes with the integer actions, whatever
`ℤ`-module structures are given. -/
private theorem map_int_smul {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (hM : Module ℤ M) (hN : Module ℤ N) (φ : M →+ N) (n : ℤ) (x : M) :
    φ (hM.smul n x) = hN.smul n (φ x) := by
  rw [int_smul_eq_zsmul, int_smul_eq_zsmul, map_zsmul]

/-- If every map from `P` into the coproduct factors through a finite subcoproduct, the
integer-module Hom functor of `P` preserves this coproduct. -/
private theorem preservesCoproduct_of_finiteFactor {P : C} {I : Type w} (f : I → C)
    (hfact : ∀ g : P ⟶ ∐ f, ∃ (T : Finset I) (g' : P ⟶ ∐ fun j : T => f j),
      g' ≫ Sigma.desc (fun j : T => Sigma.ι f j.1) = g) :
    PreservesColimit (Discrete.functor f) (preadditiveCoyonedaInt P) := by
  classical
  apply preservesColimit_of_preserves_colimit_cocone (coproductIsCoproduct f)
  refine (isColimitMapCoconeCofanMkEquiv (preadditiveCoyonedaInt P) f (Sigma.ι f)).symm ?_
  -- Linear maps are taken from morphisms of `ModuleCat ℤ`, so that they carry the restricted
  -- `ℤ`-module structures of the objects rather than the canonical ones of the Hom groups.
  let G := preadditiveCoyonedaInt P
  have hdec : ∀ x : G.obj (∐ f), ∃ T : Finset I,
      (∀ j ∉ T, (G.map (Sigma.π f j)).hom x = 0) ∧
        x = ∑ j ∈ T, (G.map (Sigma.ι f j)).hom ((G.map (Sigma.π f j)).hom x) :=
    fun x => finite_decomp f hfact x
  -- The descending map to a cofan `t`: the finitely supported sum of the components.
  let Φ : ∀ t : Cofan fun j => G.obj (f j), G.obj (∐ f) → t.pt :=
    fun t x => ∑ᶠ j, (t.inj j).hom ((G.map (Sigma.π f j)).hom x)
  have hΦ : ∀ t x (T : Finset I), (∀ j ∉ T, (G.map (Sigma.π f j)).hom x = 0) →
      Φ t x = ∑ j ∈ T, (t.inj j).hom ((G.map (Sigma.π f j)).hom x) := by
    intro t x T hT
    apply finsum_eq_sum_of_support_subset
    intro j hj
    by_contra hjT
    exact Function.mem_support.1 hj (by rw [hT j hjT, map_zero])
  have hadd : ∀ t x y, Φ t (x + y) = Φ t x + Φ t y := by
    intro t x y
    obtain ⟨Tx, hx, -⟩ := hdec x
    obtain ⟨Ty, hy, -⟩ := hdec y
    have hx' : ∀ j ∉ Tx ∪ Ty, (G.map (Sigma.π f j)).hom x = 0 := fun j hj =>
      hx j fun h => hj (Finset.mem_union_left _ h)
    have hy' : ∀ j ∉ Tx ∪ Ty, (G.map (Sigma.π f j)).hom y = 0 := fun j hj =>
      hy j fun h => hj (Finset.mem_union_right _ h)
    have hxy : ∀ j ∉ Tx ∪ Ty, (G.map (Sigma.π f j)).hom (x + y) = 0 := fun j hj => by
      rw [map_add, hx' j hj, hy' j hj, add_zero]
    rw [hΦ t _ _ hxy, hΦ t _ _ hx', hΦ t _ _ hy', ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_add, map_add]
  let L : ∀ t : Cofan fun j => G.obj (f j), G.obj (∐ f) ⟶ t.pt := fun t =>
    ConcreteCategory.ofHom
      { toFun := Φ t
        map_add' := hadd t
        map_smul' := fun n x =>
          map_int_smul (G.obj (∐ f)).isModule t.pt.isModule (AddMonoidHom.mk' (Φ t) (hadd t))
            n x }
  refine Cofan.IsColimit.mk _ L ?_ ?_
  · intro t j
    ext y
    change Φ t ((G.map (Sigma.ι f j)).hom y) = (t.inj j).hom y
    refine (finsum_eq_single _ j fun k hk => ?_).trans ?_
    · have h0 : ∀ y' : P ⟶ f j, (y' ≫ Sigma.ι f j) ≫ Sigma.π f k = 0 := fun y' => by
        rw [Category.assoc, Sigma.ι_π_of_ne f (Ne.symm hk), comp_zero]
      exact (congrArg (t.inj k).hom (h0 y)).trans (map_zero _)
    · have h1 : ∀ y' : P ⟶ f j, (y' ≫ Sigma.ι f j) ≫ Sigma.π f j = y' := fun y' => by
        rw [Category.assoc, Sigma.ι_π_eq_id, Category.comp_id]
      exact congrArg (t.inj j).hom (h1 y)
  · intro t m hm
    ext x
    obtain ⟨T, hT, hx⟩ := hdec x
    change m.hom x = Φ t x
    rw [hΦ t x T hT]
    conv_lhs => rw [hx]
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← hm j]
    rfl

/-- In a source AB5 category, the Hom functor of a finite-type object preserves coproducts. -/
private theorem homPreservesCoproducts_of_finiteType
    (hAB5 : DirectedSubobjectSumsDistribute.{w} C) {P : C} (hft : IsFiniteTypeObject P) :
    HomPreservesCoproducts.{w} P := by
  intro I
  have : ∀ f : I → C, PreservesColimit (Discrete.functor f) (preadditiveCoyonedaInt P) :=
    fun f => preservesCoproduct_of_finiteFactor f (exists_finite_factor hft hAB5 f)
  exact preservesColimitsOfShape_of_discrete _

end Preservation

omit [Abelian C] in
/-- A `Shrink`-indexed family enumerating a set of subobjects. -/
private theorem range_shrink {P : C} (S : Set (Subobject P)) [Small.{w} S] :
    Set.range (fun j : Shrink.{w} S => ((equivShrink S).symm j : Subobject P)) = S := by
  ext x
  constructor
  · rintro ⟨j, rfl⟩
    exact ((equivShrink S).symm j).2
  · intro hx
    exact ⟨equivShrink S ⟨x, hx⟩, by simp⟩

/-- A small projective object with `w`-small subobject type is of finite type. -/
private theorem finiteType_of_smallProjective [HasCoproducts.{w} C] {P : C}
    [Small.{w} (Subobject P)] (hproj : HomProjective P) (hpres : HomPreservesCoproducts.{w} P) :
    IsFiniteTypeObject P := by
  have hunions : HasSubobjectUnions P := by
    intro S
    refine ⟨subobjectSum (fun j : Shrink.{w} S => ((equivShrink S).symm j : Subobject P)), ?_⟩
    have := isLUB_subobjectSum (fun j : Shrink.{w} S => ((equivShrink S).symm j : Subobject P))
    rwa [range_shrink S] at this
  refine ⟨hunions, fun S hSn hSc hprop htop => ?_⟩
  let F : Shrink.{w} S → Subobject P := fun j => ((equivShrink S).symm j : Subobject P)
  have hF : Set.range F = S := range_shrink S
  have : Nonempty (Shrink.{w} S) := ⟨equivShrink S ⟨_, hSn.some_mem⟩⟩
  have hdir : Directed (· ≤ ·) F := by
    intro a b
    rcases hSc.total ((equivShrink S).symm a).2 ((equivShrink S).symm b).2 with h | h
    · exact ⟨b, h, le_rfl⟩
    · exact ⟨a, le_rfl, h⟩
  have hsum : subobjectSum F = ⊤ := subobjectSum_eq_of_isLUB F (by rw [hF]; exact htop)
  have : IsIso (subobjectSum F).arrow := (Subobject.isIso_arrow_iff_eq_top _).2 hsum
  have : Epi (subobjectSumDesc F) := by
    rw [← subobjectSumπ_arrow]
    infer_instance
  have : Projective P := (homProjectiveComparison P).1 hproj
  have hs : Projective.factorThru (𝟙 P) (subobjectSumDesc F) ≫ subobjectSumDesc F = 𝟙 P :=
    Projective.factorThru_comp _ _
  have := hpres (Shrink.{w} S)
  let G := preadditiveCoyonedaInt P
  have hc := isColimitOfHasCoproductOfPreservesColimit G (fun j => (F j : C))
  -- `N` is typed through linear maps of `ModuleCat ℤ`, so it carries the restricted
  -- `ℤ`-module structure; the quotient module structure is likewise named explicitly.
  let N := ⨆ j, LinearMap.range (G.map (Sigma.ι (fun j => (F j : C)) j)).hom
  let Q : ModuleCat ℤ := @ModuleCat.of ℤ _ (_ ⧸ N) _ (Submodule.Quotient.module N)
  let q : G.obj (∐ fun j => (F j : C)) ⟶ Q := ConcreteCategory.ofHom N.mkQ
  have hq : q = 0 := by
    refine Cofan.IsColimit.hom_ext hc _ _ fun j => ?_
    refine ConcreteCategory.hom_ext _ _ fun y => ?_
    exact (Submodule.Quotient.mk_eq_zero N).2
      (Submodule.mem_iSup_of_mem j (LinearMap.mem_range_self _ y))
  let s : P ⟶ ∐ fun j => (F j : C) := Projective.factorThru (𝟙 P) (subobjectSumDesc F)
  have hsN : s ∈ N :=
    (Submodule.Quotient.mk_eq_zero N).1 (ConcreteCategory.congr_hom hq s)
  -- Instance search would otherwise give the Hom group's canonical `ℤ`-module structure.
  let : Module ℤ (G.obj (∐ fun j => (F j : C))) := (G.obj (∐ fun j => (F j : C))).isModule
  obtain ⟨j, t, hjt⟩ : ∃ j, ∃ t : P ⟶ (F j : C), s ≫ subobjectSumDesc F = t ≫ (F j).arrow := by
    refine Submodule.iSup_induction _
      (motive := fun x : G.obj (∐ fun j => (F j : C)) => ∃ j, ∃ t : P ⟶ (F j : C),
        (x : P ⟶ ∐ fun j => (F j : C)) ≫ subobjectSumDesc F = t ≫ (F j).arrow) hsN ?_ ?_ ?_
    · rintro i _ ⟨y, rfl⟩
      have hι : ∀ y' : P ⟶ (F i : C),
          (y' ≫ Sigma.ι (fun j => (F j : C)) i) ≫ subobjectSumDesc F = y' ≫ (F i).arrow :=
        fun y' => by simp
      exact ⟨i, y, hι y⟩
    · refine ⟨Classical.arbitrary _, 0, ?_⟩
      change (0 : P ⟶ ∐ fun j => (F j : C)) ≫ subobjectSumDesc F = _
      simp
    · rintro x y ⟨i, a, ha⟩ ⟨i', b, hb⟩
      obtain ⟨k, hik, hi'k⟩ := hdir i i'
      refine ⟨k, a ≫ Subobject.ofLE _ _ hik + b ≫ Subobject.ofLE _ _ hi'k, ?_⟩
      have key : ∀ x' y' : P ⟶ ∐ fun j => (F j : C),
          x' ≫ subobjectSumDesc F = a ≫ (F i).arrow →
          y' ≫ subobjectSumDesc F = b ≫ (F i').arrow →
          (x' + y') ≫ subobjectSumDesc F =
            (a ≫ Subobject.ofLE _ _ hik + b ≫ Subobject.ofLE _ _ hi'k) ≫ (F k).arrow := by
        intro x' y' hx hy
        rw [Preadditive.add_comp, hx, hy, Preadditive.add_comp, Category.assoc, Category.assoc,
          Subobject.ofLE_arrow, Subobject.ofLE_arrow]
      exact key x y ha hb
  rw [show s ≫ subobjectSumDesc F = 𝟙 P from hs] at hjt
  have hFj : F j = ⊤ := by
    have : IsSplitEpi (F j).arrow := IsSplitEpi.mk' ⟨t, hjt.symm⟩
    exact (Subobject.isIso_arrow_iff_eq_top _).1 (isIso_of_mono_of_epi _)
  exact hprop (F j) (hF ▸ ⟨j, rfl⟩) hFj

end

/-- Renard A.VIII.2: in a source Grothendieck category, an object with `w`-small subobject
type is small projective exactly when it is projective of finite type. -/
theorem smallProjectiveFiniteType (C : Type u) [Category.{v} C] [Abelian C] :
    SmallProjectiveFiniteTypeStatement.{w, v, u} C := by
  intro hG
  have : HasCoproducts.{w} C := hG.1
  intro P _
  constructor
  · rintro ⟨hproj, hpres⟩
    exact ⟨hproj, finiteType_of_smallProjective hproj hpres⟩
  · rintro ⟨hproj, hft⟩
    exact ⟨hproj, homPreservesCoproducts_of_finiteType hG.2 hft⟩

end Langlands.Renard
