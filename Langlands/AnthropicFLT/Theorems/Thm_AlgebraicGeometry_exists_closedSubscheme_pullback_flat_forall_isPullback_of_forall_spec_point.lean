      ∀ (S' : Type u) [CommRing S'] (s : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of S))
        (Z : Scheme.{u}) (ιZ : Z ⟶ pullback f s) (hι : IsClosedImmersion ιZ) (hfl : Flat (ιZ ≫ pullback.snd f s))
        (hfp : LocallyOfFinitePresentation (ιZ ≫ pullback.snd f s)),
        ∃ e : Z ⟶ 𝒵,
