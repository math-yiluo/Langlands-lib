import Langlands.Representation.Hecke.IwahoriHeckeDecompositionStatement

/-! # The finiteness Lemma for the generated subalgebra `M` (Renard V.5.3)

Renard V.5.3 defines `M` as the subalgebra of `H(G, K)` generated by the `a_{zf}` and asserts
"L'algèbre `M` est un `A`-module de type fini". The published
`IwahoriHeckeDecompositionStatement` states only the module form. This file states the
subalgebra form under one explicit additional hypothesis: the dominant representatives
`C̃⁺` contract `K ∩ N_∅`, their inverses contract `K ∩ N̄_∅`, and they normalize `K ∩ M_∅`,
as `C_∅⁺` does by Renard V.5.2 (ii).
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry MeasureTheory
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Hecke

/-- Renard V.5.3, finiteness Lemma for the generated subalgebra, under the positivity of the
dominant representatives `C̃⁺` with respect to `K`.

Data and hypotheses are those of `IwahoriHeckeDecompositionStatement`: a nonarchimedean
local field `F`, a connected reductive `G` with the canonical topology on `G(F)`, available
corrected Kaletha–Prasad data with base datum `B` (maximal split torus `B.i : S → G`,
centralizer `j : Z → G`, `s : S → Z`), a generic cocharacter `ν`, a special vertex `x` with
special compact `K₀`, a compact open `K ⊆ K₀` normal in `K₀` with the V.5.2 (ii) properties
for every standard parabolic, a finite transversal `F₀ ⊆ Z(F)` of `Λ(Z)/Λ(S)` and a Haar
measure. In addition, every `t ∈ C̃⁺ = (C_∅ F₀) ∩ Z(F)^+` (mapped to `G(F)` by `j`)
satisfies `t (K ∩ N_∅) t⁻¹ ⊆ K ∩ N_∅`, `t⁻¹ (K ∩ N̄_∅) t ⊆ K ∩ N̄_∅` and
`t (K ∩ M_∅) t⁻¹ = K ∩ M_∅`, for the minimal standard parabolic `P_∅ = M_∅ N_∅`.

Write `a g` for `e_K ∗ δ_g ∗ e_K`, `A` for the subalgebra generated by the `a z`, `z ∈ C⁺`,
and `M` for the subalgebra generated by the `a t`, `t ∈ C̃⁺`. Then `A ≤ M`, so that `M` is a
left `A`-module under multiplication, and there are finitely many `D_k ∈ M` such that every
element of `M` is a linear combination of products `u * D_k`, `u ∈ A`: `M = ∑ₖ A D_k`. -/
def IwahoriHeckeSubalgebraFinitenessStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    haveI : IsAffineHom G.X.hom := hG.isAffineHom
    haveI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    haveI := hG.smooth
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    haveI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    ∀ [T2Space (rationalPoints G)] [MeasurableSpace (rationalPoints G)]
      [BorelSpace (rationalPoints G)]
      (𝔅 : KPBuildingAssignment.{u}), 𝔅.IsAvailableFor F G hG →
      let B := (𝔅.datum F G hG).base
      ∀ ν : cocharacterLattice B.S, IsGenericCocharacter B.i ν →
        ∀ x : B.Apartment, B.apartment.IsSpecialApartmentVertex x →
          let K₀ := B.apartment.specialCompactSubgroup x
          ∀ (K : OpenSubgroup (rationalPoints G)) (hK : IsCompact (K : Set (rationalPoints G))),
            K.toSubgroup ≤ K₀ →
            (∀ k₀ ∈ K₀, ∀ k ∈ K, k₀ * k * k₀⁻¹ ∈ K) →
            (∀ J : Set (characterLattice B.S), J ⊆ simpleRelativeRoots B.i ν →
              ∃ (A : CommGroupScheme (Spec (CommRingCat.of F))) (q : A.toGrp ⟶ B.S.toGrp),
                BruhatTits.SpecialCompact.IsCompatibleStandardSplitComponent B.i ν J A q ∧
                  BruhatTits.SpecialCompact.StandardParabolicBasisMember B.i ν J q K.toSubgroup) →
            ∀ F₀ : Set (rationalPoints B.centralizer.Z),
              Plancherel.RenardCartan.IsFiniteLatticeTransversal B.centralizer.s F₀ →
            ∀ (haar : Measure (rationalPoints G)) [haar.IsHaarMeasure],
              let j := rationalPoints.map B.centralizer.j
              let dom := BruhatTits.Cartan.parahoricDominantSet B ν
              let Cplus : Set (rationalPoints B.centralizer.Z) :=
                (Plancherel.RenardCartan.C0 B.S B.centralizer.s : Set _) ∩ dom
              let Ctilde : Set (rationalPoints B.centralizer.Z) :=
                Plancherel.RenardCartan.tildeC0Plus B.centralizer.s F₀ dom
              BruhatTits.SpecialCompact.WeakChamberContraction K.toSubgroup
                  (standardUnipotentPoints B.i ν ∅)
                  (BruhatTits.SpecialCompact.standardOppositeUnipotentPoints B.i ν ∅)
                  (j '' Ctilde) →
              BruhatTits.SpecialCompact.LeviIntersectionNormalization K.toSubgroup
                  (standardLeviPoints B.i ν ∅) (j '' Ctilde) →
              let a : rationalPoints G → HeckeAlgebra.Corner haar K hK :=
                HeckeAlgebra.Corner.massIndicator K hK haar
              let Aalg := Algebra.adjoin ℂ (a '' (j '' Cplus))
              let Malg := Algebra.adjoin ℂ (a '' (j '' Ctilde))
              Aalg ≤ Malg ∧
                ∃ (n : ℕ) (D : Fin n → HeckeAlgebra.Corner haar K hK), (∀ k, D k ∈ Malg) ∧
                  ∀ m ∈ Malg, m ∈ Submodule.span ℂ {y | ∃ u ∈ Aalg, ∃ k, y = u * D k}

end Langlands.Hecke
