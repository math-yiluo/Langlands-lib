import Langlands.Representation.Hecke.IwahoriHeckeDecompositionStatement

/-! # The finiteness Lemma for the generated subalgebra `M` (Renard V.5.3)

Renard V.5.3 defines `M` as the subalgebra of `H(G, K)` generated by the `a_{zf}`,
`z ∈ C_∅^+`, `f ∈ F_∅`, and asserts "L'algèbre `M` est un `A`-module de type fini". This
file states that Lemma for Renard's chamber-compatible transversal `F_∅` (V.3.23), with no
hypothesis beyond the standing data of V.5.3. `A` is generated by the `a_z`, `z ∈ C_∅^+`:
this corrects the printed `z ∈ C_∅`, as the paired Markdown explains. The published
`IwahoriHeckeSubalgebraFinitenessStatement` states a conclusion of the same form under an
additional positivity hypothesis on the dominant representatives; no such hypothesis is made
here.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry MeasureTheory
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Hecke

/-- Renard V.5.3, finiteness Lemma for the generated subalgebra, for a chamber-compatible
transversal and without hypotheses beyond those of V.5.3.

Data and hypotheses are those of `IwahoriHeckeDecompositionStatement`, except for the
transversal: a nonarchimedean local field `F`, a connected reductive `G` with the canonical
topology on `G(F)`, available corrected Kaletha–Prasad data with base datum `B` (maximal
split torus `B.i : S → G`, centralizer `j : Z → G`, `s : S → Z`), a generic cocharacter `ν`,
a special vertex `x` with special compact `K₀`, a compact open `K ⊆ K₀` normal in `K₀` with
the published V.5.2 (ii)–(iv) properties for every standard parabolic, a Haar measure, and a
finite transversal `F₀ ⊆ Z(F)` of `Λ(Z)/Λ(S)` that is chamber-compatible in the sense of
V.3.23: `F₀ ⊆ Z(F)^+` and `(C_∅ F₀) ∩ Z(F)^+ = C_∅^+ F₀`.

Write `a g` for `e_K ∗ δ_g ∗ e_K`, `C_∅^+ = C_∅ ∩ Z(F)^+`, `A` for the subalgebra generated
by the `a z`, `z ∈ C_∅^+`, and `M` for the subalgebra generated by the `a (z f)`,
`z ∈ C_∅^+`, `f ∈ F₀` (mapped to `G(F)` by `j`). Then `A ≤ M`, so that `M` is a left
`A`-module under multiplication, and there are finitely many `D_k ∈ M` such that every element
of `M` is a linear combination of products `u * D k`, `u ∈ A`: `M = ∑ₖ A D_k`. -/
def RenardIwahoriHeckeSubalgebraFinitenessStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    haveI : IsAffineHom G.X.hom := hG.isAffineHom
    haveI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    haveI := hG.smooth
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    haveI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    ∀ [T2Space (rationalPoints G)] [MeasurableSpace (rationalPoints G)]
      [BorelSpace (rationalPoints G)]
      (𝔅 : KPBuildingAssignment.{u}), 𝔅.IsAvailableFor F G hG →
      let B := (𝔅.datum F G hG).base
      ∀ ν : cocharacterLattice B.S, IsGenericCocharacter B.i ν →
        ∀ x : B.Apartment, B.apartment.IsSpecialApartmentVertex x →
          let K₀ := B.apartment.specialCompactSubgroup x
          ∀ (K : OpenSubgroup (rationalPoints G)) (hK : IsCompact (K : Set (rationalPoints G))),
            K.toSubgroup ≤ K₀ →
            (∀ k₀ ∈ K₀, ∀ k ∈ K, k₀ * k * k₀⁻¹ ∈ K) →
            (∀ J : Set (characterLattice B.S), J ⊆ simpleRelativeRoots B.i ν →
              ∃ (A : CommGroupScheme (Spec (CommRingCat.of F))) (q : A.toGrp ⟶ B.S.toGrp),
                BruhatTits.SpecialCompact.IsCompatibleStandardSplitComponent B.i ν J A q ∧
                  BruhatTits.SpecialCompact.StandardParabolicBasisMember B.i ν J q K.toSubgroup) →
            ∀ F₀ : Set (rationalPoints B.centralizer.Z),
              Plancherel.RenardCartan.IsChamberCompatibleTransversal B.centralizer.s
                (positiveRelativeRoots B.i ν) (BruhatTits.Cartan.parahoricDominantSet B ν) F₀ →
            ∀ (haar : Measure (rationalPoints G)) [haar.IsHaarMeasure],
              let j := rationalPoints.map B.centralizer.j
              let dom := BruhatTits.Cartan.parahoricDominantSet B ν
              let Cplus : Set (rationalPoints B.centralizer.Z) :=
                (Plancherel.RenardCartan.C0 B.S B.centralizer.s : Set _) ∩ dom
              let a : rationalPoints G → HeckeAlgebra.Corner haar K hK :=
                HeckeAlgebra.Corner.massIndicator K hK haar
              let Aalg := Algebra.adjoin ℂ (a '' (j '' Cplus))
              let Malg := Algebra.adjoin ℂ (a '' (j '' (Cplus * F₀)))
              Aalg ≤ Malg ∧
                ∃ (n : ℕ) (D : Fin n → HeckeAlgebra.Corner haar K hK), (∀ k, D k ∈ Malg) ∧
                  ∀ m ∈ Malg, m ∈ Submodule.span ℂ {y | ∃ u ∈ Aalg, ∃ k, y = u * D k}

end Langlands.Hecke
