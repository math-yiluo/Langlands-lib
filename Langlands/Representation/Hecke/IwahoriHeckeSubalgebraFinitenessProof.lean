import Langlands.Representation.Hecke.IwahoriHeckeSubalgebraFinitenessStatement
import Langlands.Representation.Hecke.IwahoriHeckeDecompositionProof
import Langlands.Representation.Hecke.IwahoriSandwich

/-!
# Proof of the finiteness Lemma for the generated subalgebra `M` (Renard V.5.3)

The theorem `iwahoriHeckeSubalgebraFiniteness` proves the published proposition
`IwahoriHeckeSubalgebraFinitenessStatement`. Under the positivity hypothesis (P) on the
dominant representatives `C̃⁺`, every element of the monoid generated by `C̃⁺` lies in the
positive Iwahori monoid, so `M` is spanned by the `a t`, `t` in that monoid. Each such `a t`
is exactly `a (j z) * D_k` with `z ∈ C⁺` and `D_k` one of finitely many elements of `M`,
by a finiteness argument on lattice points with finitely many labels.
-/

noncomputable section

universe u

namespace Langlands.Hecke

section Restricted

open MeasureTheory HeckeAlgebra.Corner
open scoped Pointwise

universe uG

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [MeasurableSpace G] [BorelSpace G] [T2Space G]
  {K : OpenSubgroup G} (hK : IsCompact (K : Set G)) (μ : Measure G) [μ.IsHaarMeasure]

namespace IwahoriLatticeData

variable {Λ : Type*} [AddCommGroup Λ] {ι : Type*} [Finite ι] (L : IwahoriLatticeData K Λ ι)

include hK in
/-- **Finiteness lemma on a subset.** For a fixed right factor `g` and a set `S` of lattice
points that are admissible for the shifts `e`, finitely many `t ∈ S` suffice: every
`a (c y * g)`, `y ∈ S`, is `a (c (y - t)) * a (c t * g)` with `y - t` dominant. -/
theorem exists_finite_left_of_subset (g : G) (e : ι → ℝ) (S : Set Λ)
    (hS : ∀ y ∈ S, ∀ α, 0 ≤ (L.pair α y : ℝ) + e α) :
    ∃ T : Set Λ, T.Finite ∧ T ⊆ S ∧ ∀ y ∈ S, ∃ t ∈ T, (∀ α, 0 ≤ L.pair α (y - t)) ∧
      massIndicator K hK μ (L.c (y - t)) * massIndicator K hK μ (L.c t * g) =
        massIndicator K hK μ (L.c y * g) := by
  classical
  obtain ⟨T, hTfin, hTS, hT⟩ : ∃ T : Set Λ, T.Finite ∧ T ⊆ S ∧
      ∀ y ∈ S, ∃ t ∈ T, (∀ α, 0 ≤ L.pair α (y - t)) ∧
        {x | ∃ nb ∈ L.Knb, ∃ k ∈ K, x = (L.c t)⁻¹ * nb * L.c t * g * k} =
          {x | ∃ nb ∈ L.Knb, ∃ k ∈ K, x = (L.c y)⁻¹ * nb * L.c y * g * k} := by
    refine exists_finite_stable_representatives S
      (fun y α => ⌊(L.pair α y : ℝ) + e α⌋₊) (fun t y => ∀ α, 0 ≤ L.pair α (y - t))
      (fun t ht y hy hle α => by
        rw [map_sub, sub_nonneg]
        exact int_le_of_natFloor_add_le (hS y hy α) (hS t ht α) (hle α))
      (fun y => {x | ∃ nb ∈ L.Knb, ∃ k ∈ K, x = (L.c y)⁻¹ * nb * L.c y * g * k})
      (fun t => (fun p : G × G => (L.c t)⁻¹ * p.1 * L.c t * g * p.2) ''
        ((K : Set G) ×ˢ (K : Set G)))
      (fun t => (hK.prod hK).image (by fun_prop)) ?_ ?_
    · rintro t y - hty _ ⟨nb, hnb, k, hk, rfl⟩
      refine ⟨((L.c (y - t))⁻¹ * nb * L.c (y - t), k),
        ⟨L.Knb_subset (L.conj_Knb _ hty nb hnb), hk⟩, ?_⟩
      simp only [← L.c_sub_mul y t]
      group
    · intro W hW
      obtain ⟨tW, htW⟩ := exists_finset_test_rightInvariant K hW
      refine ⟨tW, fun y _ y' _ hy hy' hiff => htW _ _ hy hy' ?_ ?_ hiff⟩
      · rintro _ ⟨nb, hnb, k, hk, rfl⟩ k' hk'
        exact ⟨nb, hnb, k * k', K.mul_mem hk hk', by group⟩
      · rintro _ ⟨nb, hnb, k, hk, rfl⟩ k' hk'
        exact ⟨nb, hnb, k * k', K.mul_mem hk hk', by group⟩
  refine ⟨T, hTfin, hTS, fun y hy => ?_⟩
  obtain ⟨t, ht, hdom, hV⟩ := hT y hy
  refine ⟨t, ht, hdom, ?_⟩
  have hprod : L.c (y - t) * (L.c t * g) = L.c y * g := by
    rw [← mul_assoc, L.c_sub_mul]
  rw [← hprod]
  apply massIndicator_mul K hK μ
  refine TestFunction.mul_mem_doubleCosetSet_of_factor_left K L.Kn L.Km L.Knb L.decomp
    (fun n hn => L.Kn_subset (L.conj_Kn _ hdom n hn))
    (fun m hm => (L.conj_Km _ hdom m hm).1) ?_
  intro nb hnb
  have hmem : (L.c t)⁻¹ * nb * L.c t * g ∈
      {x | ∃ nb ∈ L.Knb, ∃ k ∈ K, x = (L.c y)⁻¹ * nb * L.c y * g * k} := by
    rw [← hV]
    exact ⟨nb, hnb, 1, K.one_mem, by group⟩
  obtain ⟨nb', hnb', k, hk, hk'⟩ := hmem
  rw [hprod]
  refine (TestFunction.mem_doubleCosetSet K _ _).2 ⟨nb', L.Knb_subset hnb', k, hk, ?_⟩
  calc L.c (y - t) * nb * (L.c t * g)
      = L.c (y - t) * L.c t * ((L.c t)⁻¹ * nb * L.c t * g) := by group
    _ = nb' * (L.c y * g) * k := by
      rw [hk', L.c_sub_mul]
      group

end IwahoriLatticeData

end Restricted

end Langlands.Hecke

open CategoryTheory AlgebraicGeometry MeasureTheory
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Hecke

open HeckeAlgebra.Corner

set_option maxHeartbeats 1000000 in
/-- **Renard V.5.3, finiteness Lemma for the generated subalgebra**, under the positivity (P)
of the dominant representatives `C̃⁺`: `A ≤ M`, and `M = ∑ₖ A D_k` for finitely many
`D_k ∈ M`. -/
theorem iwahoriHeckeSubalgebraFiniteness : IwahoriHeckeSubalgebraFinitenessStatement.{u} := by
  intro F _ _ _ _ G hG
  let : IsAffineHom G.X.hom := hG.isAffineHom
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  let : Smooth G.X.hom := hG.smooth
  let : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
  let : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
  intro _ _ _ 𝔅 h𝔅 B ν hν x hx K₀ K hK hKK₀ hnorm hbasis F₀ hF₀ haar _ j dom Cplus Ctilde
    hWC hLN a Aalg Malg
  classical
  -- basic structure (as in the published proof of `IwahoriHeckeDecompositionStatement`)
  have hi : IsMaximalSplitTorus B.i := B.isMaximalSplitTorus
  have hΦ : (positiveRelativeRoots B.i ν).Finite :=
    hi.isSplitSubtorus.1.finite_positiveRelativeRoots B.i ν
  have : Finite (positiveRelativeRoots B.i ν) := hΦ.to_subtype
  have : Finite F₀ := hF₀.1.to_subtype
  have hK₀c : IsCompact (K₀ : Set (rationalPoints G)) :=
    (BruhatTits.SpecialCompact.availableCompactCore (𝔅.datum F G hG) h𝔅.groupAxioms ν hν x
      hx).2.1.1
  -- the minimal parabolic and its basis member
  obtain ⟨A, q, hA, hIw, hcon⟩ := hbasis ∅ (Set.empty_subset _)
  have hstd : IsStandardCocharacter B.i ν ∅ ν :=
    ⟨Set.empty_subset _, by simp, fun α hα _ => hα.1.2⟩
  let c : cocharacterLattice B.S → rationalPoints G := fun y =>
    Aubert.General.uniformizerPowers B.i (.ofAdd y)
  have hchamber : ∀ y : cocharacterLattice B.S,
      (∀ α ∈ positiveRelativeRoots B.i ν, 0 ≤ latticePairing B.S α y) →
      c y ∈ BruhatTits.SpecialCompact.standardComponentCA B.i q ∧
        c y ∈ BruhatTits.SpecialCompact.standardComponentCAplus B.i ν ∅ q := fun y hy =>
    BruhatTits.SpecialCompact.uniformizerPowers_mem_standardComponentChambers hi ⟨ν, hstd⟩ hA y
      (fun _ h => by simp at h) (fun β hβ => hy β hβ.1)
  -- the Iwahori factorization and contraction data of `K` for `P_∅`
  let M := standardLeviPoints B.i ν ∅
  let N := standardUnipotentPoints B.i ν ∅
  let Nb := BruhatTits.SpecialCompact.standardOppositeUnipotentPoints B.i ν ∅
  have hdec : ∀ k ∈ K, ∃ n ∈ ((K.toSubgroup ⊓ N : Subgroup (rationalPoints G)) : Set _),
      ∃ m ∈ ((K.toSubgroup ⊓ M : Subgroup (rationalPoints G)) : Set _),
      ∃ nb ∈ ((K.toSubgroup ⊓ Nb : Subgroup (rationalPoints G)) : Set _), k = n * m * nb := by
    intro k hk
    obtain ⟨⟨nb, m, n⟩, hprod⟩ := hIw.2 ⟨k⁻¹, K.inv_mem hk⟩
    have h : (nb : rationalPoints G) * m * n = k⁻¹ := congrArg Subtype.val hprod
    refine ⟨(n : rationalPoints G)⁻¹, inv_mem n.2, (m : rationalPoints G)⁻¹, inv_mem m.2,
      (nb : rationalPoints G)⁻¹, inv_mem nb.2, ?_⟩
    rw [← inv_inv k, ← h]
    group
  have hfactor : ∀ k ∈ K, ∃ l ∈ K.toSubgroup ⊓ Nb, ∃ m ∈ K.toSubgroup ⊓ M,
      ∃ n ∈ K.toSubgroup ⊓ N, k = l * m * n := by
    intro k hk
    obtain ⟨⟨nb, m, n⟩, hprod⟩ := hIw.2 ⟨k, hk⟩
    have h : (nb : rationalPoints G) * m * n = k := congrArg Subtype.val hprod
    exact ⟨nb, nb.2, m, m.2, n, n.2, h.symm⟩
  have hconjM : ∀ y : cocharacterLattice B.S,
      (∀ α ∈ positiveRelativeRoots B.i ν, 0 ≤ latticePairing B.S α y) →
      ∀ m ∈ ((K.toSubgroup ⊓ M : Subgroup (rationalPoints G)) : Set _),
        c y * m * (c y)⁻¹ ∈ K ∧ (c y)⁻¹ * m * c y ∈ K := by
    intro y hy m hm
    have heq := hcon.1 (c y) (hchamber y hy).1
    constructor
    · have hm' : c y * m * (c y)⁻¹ ∈
          ((K.toSubgroup ⊓ M : Subgroup (rationalPoints G)) : Set _) := by
        rw [← heq]
        exact ⟨m, hm, rfl⟩
      exact (Subgroup.mem_inf.1 hm').1
    · rw [← heq] at hm
      obtain ⟨m', hm', rfl⟩ := hm
      have h : (c y)⁻¹ * (c y * m' * (c y)⁻¹) * c y = m' := by group
      rw [h]
      exact (Subgroup.mem_inf.1 hm').1
  have hconjN : ∀ y : cocharacterLattice B.S,
      (∀ α ∈ positiveRelativeRoots B.i ν, 0 ≤ latticePairing B.S α y) →
      ∀ n ∈ ((K.toSubgroup ⊓ N : Subgroup (rationalPoints G)) : Set _),
        c y * n * (c y)⁻¹ ∈ ((K.toSubgroup ⊓ N : Subgroup (rationalPoints G)) : Set _) :=
    fun y hy n hn => (hcon.2.1 (c y) (hchamber y hy).2).1 ⟨n, hn, rfl⟩
  have hconjNb : ∀ y : cocharacterLattice B.S,
      (∀ α ∈ positiveRelativeRoots B.i ν, 0 ≤ latticePairing B.S α y) →
      ∀ nb ∈ ((K.toSubgroup ⊓ Nb : Subgroup (rationalPoints G)) : Set _),
        (c y)⁻¹ * nb * c y ∈ ((K.toSubgroup ⊓ Nb : Subgroup (rationalPoints G)) : Set _) := by
    intro y hy nb hnb
    have h := (hcon.2.1 (c y) (hchamber y hy).2).2 ⟨nb, hnb, rfl⟩
    simpa only [inv_inv] using h
  let L : IwahoriLatticeData K (cocharacterLattice B.S) (positiveRelativeRoots B.i ν) :=
    { Kn := ((K.toSubgroup ⊓ N : Subgroup (rationalPoints G)) : Set _)
      Km := ((K.toSubgroup ⊓ M : Subgroup (rationalPoints G)) : Set _)
      Knb := ((K.toSubgroup ⊓ Nb : Subgroup (rationalPoints G)) : Set _)
      Kn_subset := fun _ h => (Subgroup.mem_inf.1 h).1
      Km_subset := fun _ h => (Subgroup.mem_inf.1 h).1
      Knb_subset := fun _ h => (Subgroup.mem_inf.1 h).1
      decomp := hdec
      c := c
      c_add := fun y y' => by simp only [c, ofAdd_add, map_mul]
      pair := fun α => (latticePairing B.S α.1).toAddMonoidHom
      conj_Km := fun y hy => hconjM y fun α hα => hy ⟨α, hα⟩
      conj_Kn := fun y hy => hconjN y fun α hα => hy ⟨α, hα⟩
      conj_Knb := fun y hy => hconjNb y fun α hα => hy ⟨α, hα⟩ }
  -- the centralizer side
  let σ : cocharacterLattice B.S → rationalPoints B.centralizer.Z := fun y =>
    rationalPoints.map B.centralizer.s
      (Plancherel.RenardCartan.uniformizerSection B.S (Multiplicative.ofAdd y))
  have hjs : ∀ y, j (σ y) = c y := by
    intro y
    change rationalPoints.map B.centralizer.j (rationalPoints.map B.centralizer.s _) =
      rationalPoints.map B.i _
    have h := B.centralizer.comp_eq
    calc rationalPoints.map B.centralizer.j (rationalPoints.map B.centralizer.s
          (Plancherel.RenardCartan.uniformizerSection B.S (Multiplicative.ofAdd y))) =
        rationalPoints.map (B.centralizer.s ≫ B.centralizer.j)
          (Plancherel.RenardCartan.uniformizerSection B.S (Multiplicative.ofAdd y)) := by
          simp only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc]
      _ = _ := by rw [h]
  have hLc : ∀ y, L.c y = j (σ y) := fun y => (hjs y).symm
  let cv := BruhatTits.Cartan.centralizerValuation B.centralizer.s B.centralizer.bijective
  have hval : ∀ (y : cocharacterLattice B.S) (f : rationalPoints B.centralizer.Z)
      (α : characterLattice B.S),
      RealTorusSpace.eval B.S α (cv (σ y * f)).toAdd =
        (latticePairing B.S α y : ℝ) + RealTorusSpace.eval B.S α (cv f).toAdd := by
    intro y f α
    rw [map_mul, toAdd_mul, map_add,
      Plancherel.RenardCartan.centralizerValuation_uniformizerSection,
      RealTorusSpace.eval_tmul, one_mul]
  let e : positiveRelativeRoots B.i ν → F₀ → ℝ := fun α f =>
    RealTorusSpace.eval B.S α.1 (cv f.1).toAdd
  have hCt : ∀ t', t' ∈ Ctilde ↔ ∃ y, ∃ f : F₀, t' = σ y * f.1 ∧
      ∀ α : positiveRelativeRoots B.i ν, 0 ≤ (L.pair α y : ℝ) + e α f := by
    intro t'
    constructor
    · rintro ⟨ht, hdom⟩
      obtain ⟨c', hc', f, hf, rfl⟩ := (Plancherel.RenardCartan.mem_tildeC0 _ _ _).1 ht
      obtain ⟨y, rfl⟩ := (Plancherel.RenardCartan.mem_C0 _ _ _).1 hc'
      refine ⟨y, ⟨f, hf⟩, rfl, fun α => ?_⟩
      have h := hdom α.1 α.2
      change 0 ≤ RealTorusSpace.eval B.S α.1 (cv (σ y * f)).toAdd at h
      rw [hval] at h
      exact h
    · rintro ⟨y, f, rfl, hadm⟩
      refine ⟨(Plancherel.RenardCartan.mem_tildeC0 _ _ _).2
        ⟨σ y, (Plancherel.RenardCartan.mem_C0 _ _ _).2 ⟨y, rfl⟩, f.1, f.2, rfl⟩, ?_⟩
      intro α hα
      change 0 ≤ RealTorusSpace.eval B.S α (cv (σ y * f.1)).toAdd
      rw [hval]
      exact hadm ⟨α, hα⟩
  have hCp : ∀ z, z ∈ Cplus ↔ ∃ y : cocharacterLattice B.S,
      (∀ α ∈ positiveRelativeRoots B.i ν, 0 ≤ latticePairing B.S α y) ∧ σ y = z := by
    intro z
    change z ∈ (Plancherel.RenardCartan.C0 B.S B.centralizer.s : Set _) ∩
      BruhatTits.Cartan.dominantCentralizer B.i ν B.centralizer.s B.centralizer.bijective ↔ _
    rw [← Plancherel.RenardCartan.C0Plus_eq_inter_dominant]
    exact Iff.rfl
  -- `j(Z(F)^1) ⊆ K₀`
  have hjK₀ : ∀ u ∈ Plancherel.rationalCommonNormKernel B.centralizer.Z, j u ∈ K₀ :=
    fun u hu => B.isOmegaCompatible.map_mem_compactStabilizer hu x
  -- every dominant `d` is `t' u` with `t' ∈ C̃⁺` and `u ∈ Z(F)^1`
  have hdecomp : ∀ d ∈ dom, ∃ t' ∈ Ctilde,
      ∃ u ∈ Plancherel.rationalCommonNormKernel B.centralizer.Z, t' * u = d := by
    intro d hd
    let rr := (Plancherel.rationalCharacterValuation B.centralizer.Z).rangeRestrict
    obtain ⟨f, hf⟩ := hF₀.2.2 (Plancherel.RenardCartan.latticeResidue B.centralizer.s d)
    have hdiff : rr d / rr f.1 ∈ Plancherel.RenardCartan.splitValuationImage B.centralizer.s :=
      (QuotientGroup.eq_iff_div_mem
        (N := Plancherel.RenardCartan.splitValuationImage B.centralizer.s)).mp hf.symm
    obtain ⟨σ', hσ'⟩ := hdiff
    obtain ⟨y, hy, -⟩ := (CocharacterUniformizer.isUniformizerLatticeSection F B.S
      hi.isSplitSubtorus.1).2.2 σ'
    have hker : ∀ w ∈ Plancherel.rationalCommonNormKernel B.centralizer.Z, rr w = 1 := by
      intro w hw
      rw [← Plancherel.rationalCharacterValuation_ker] at hw
      exact Subtype.ext (MonoidHom.mem_ker.1 hw)
    have hσy : rr (σ y.toAdd) = rr d / rr f.1 := by
      rw [← hσ']
      have h1 := hker _ (map_mem_rationalCommonNormKernel B.centralizer.s hy)
      have h2 : rationalPoints.map B.centralizer.s σ' =
          rationalPoints.map B.centralizer.s
              (σ' * (CocharacterUniformizer.latticeSection F B.S y)⁻¹) *
            rationalPoints.map B.centralizer.s (CocharacterUniformizer.latticeSection F B.S y) := by
        rw [← map_mul, inv_mul_cancel_right]
      change rr (rationalPoints.map B.centralizer.s
        (CocharacterUniformizer.latticeSection F B.S y)) =
          rr (rationalPoints.map B.centralizer.s σ')
      rw [h2, map_mul, h1, one_mul]
    have hval' : rr (σ y.toAdd * f.1) = rr d := by
      rw [map_mul, hσy, div_mul_cancel]
    refine ⟨σ y.toAdd * f.1, ?_, (σ y.toAdd * f.1)⁻¹ * d, ?_, mul_inv_cancel_left _ _⟩
    · refine ⟨(Plancherel.RenardCartan.mem_tildeC0 _ _ _).2
        ⟨σ y.toAdd, (Plancherel.RenardCartan.mem_C0 _ _ _).2 ⟨y.toAdd, rfl⟩, f.1, f.2, rfl⟩, ?_⟩
      exact (Plancherel.RenardCartan.dominantCentralizer_mem_iff_of_characterValuation_eq
        B.centralizer.s B.centralizer.bijective B.i ν (congrArg Subtype.val hval')).2 hd
    · rw [← Plancherel.rationalCharacterValuation_ker, MonoidHom.mem_ker]
      have h : rr ((σ y.toAdd * f.1)⁻¹ * d) = 1 := by
        rw [map_mul, map_inv, hval', inv_mul_cancel]
      exact congrArg Subtype.val h
  -- dominance is preserved by products
  have hdom1 : (1 : rationalPoints B.centralizer.Z) ∈ dom := by
    intro α hα
    change 0 ≤ RealTorusSpace.eval B.S α (cv 1).toAdd
    simp only [map_one, toAdd_one, map_zero, le_refl]
  have hdommul : ∀ t₁ ∈ dom, ∀ t₂ ∈ dom, t₁ * t₂ ∈ dom := by
    intro t₁ h₁ t₂ h₂ α hα
    have e₁ := h₁ α hα
    have e₂ := h₂ α hα
    change 0 ≤ RealTorusSpace.eval B.S α (cv t₁).toAdd at e₁
    change 0 ≤ RealTorusSpace.eval B.S α (cv t₂).toAdd at e₂
    change 0 ≤ RealTorusSpace.eval B.S α (cv (t₁ * t₂)).toAdd
    rw [map_mul, toAdd_mul, map_add]
    exact add_nonneg e₁ e₂
  -- products of mass indicators
  have ha1 : a 1 = 1 := massIndicator_one K hK haar
  have h2 : ∀ (g : rationalPoints G), ∀ x₁ ∈ K₀, a g * a x₁ = a (g * x₁) := by
    intro g x₁ hx₁
    exact massIndicator_mul_of_normalizes K hK haar fun k hk => by
      simpa using hnorm _ (K₀.inv_mem hx₁) k hk
  have h1eq : ∀ x₁ ∈ K₀, ∀ x₂ ∈ K₀, a x₁ = a x₂ → x₁⁻¹ * x₂ ∈ K := by
    intro x₁ hx₁ x₂ hx₂ h
    change massIndicator K hK haar x₁ = massIndicator K hK haar x₂ at h
    rw [massIndicator_eq_iff, TestFunction.mem_doubleCosetSet] at h
    obtain ⟨k₁, hk₁, k₂, hk₂, h⟩ := h
    have h' : x₁⁻¹ * x₂ = k₂⁻¹ * (x₂⁻¹ * k₁⁻¹ * x₂⁻¹⁻¹) := by
      rw [h]
      group
    rw [h']
    exact K.mul_mem (K.inv_mem hk₂) (hnorm _ (K₀.inv_mem hx₂) _ (K.inv_mem hk₁))
  -- the positive Iwahori monoid and its products
  let P := iwahoriPositiveMonoid K.toSubgroup N M Nb
  have hPmul : ∀ p ∈ P, ∀ p' ∈ P, a p * a p' = a (p * p') := by
    intro p hp p' hp'
    exact massIndicator_mul K hK haar fun k hk =>
      TestFunction.mul_mem_doubleCosetSet_of_iwahori K N M Nb hfactor p p'
        (fun n hn => (hp.1 n hn).1) (fun l hl => (hp'.2.1 l hl).1)
        (fun m hm => (hp'.2.2 m hm).1) k hk
  -- hypothesis (P): `j(C̃⁺)` lies in the positive monoid
  have hCtP : ∀ t ∈ Ctilde, j t ∈ P := by
    intro t ht
    have hW := hWC (j t) ⟨t, ht, rfl⟩
    have hL := hLN (j t) ⟨t, ht, rfl⟩
    show _ ∧ _ ∧ _
    refine ⟨fun n hn => ?_, fun l hl => ?_, fun m hm => ?_⟩
    · have h : j t * n * (j t)⁻¹ ∈
          ((K.toSubgroup ⊓ N : Subgroup (rationalPoints G)) : Set _) := hW.1 ⟨n, hn, rfl⟩
      exact h
    · have h : (j t)⁻¹ * l * (j t)⁻¹⁻¹ ∈
          ((K.toSubgroup ⊓ Nb : Subgroup (rationalPoints G)) : Set _) := hW.2 ⟨l, hl, rfl⟩
      rw [inv_inv] at h
      exact h
    · have hm' : m ∈ BruhatTits.SpecialCompact.ambientConjugate (j t)
          ((K.toSubgroup ⊓ M : Subgroup (rationalPoints G)) : Set _) := by
        rw [hL]
        exact hm
      obtain ⟨m', hm'', rfl⟩ := hm'
      have h : (j t)⁻¹ * (j t * m' * (j t)⁻¹) * j t = m' := by group
      rw [h]
      exact hm''
  have hMgen : ∀ t ∈ Ctilde, a (j t) ∈ Malg := fun t ht =>
    Algebra.subset_adjoin ⟨j t, ⟨t, ht, rfl⟩, rfl⟩
  have hAgen : ∀ z ∈ Cplus, a (j z) ∈ Aalg := fun z hz =>
    Algebra.subset_adjoin ⟨j z, ⟨z, hz, rfl⟩, rfl⟩
  -- the monoid generated by `C̃⁺`
  have hQ : ∀ t ∈ Submonoid.closure Ctilde, t ∈ dom ∧ j t ∈ P ∧ a (j t) ∈ Malg := by
    intro t ht
    induction ht using Submonoid.closure_induction with
    | mem t ht => exact ⟨ht.2, hCtP t ht, hMgen t ht⟩
    | one =>
      refine ⟨hdom1, ?_, ?_⟩
      · rw [map_one]
        exact Submonoid.one_mem _
      · rw [map_one, ha1]
        exact Subalgebra.one_mem _
    | mul t₁ t₂ _ _ h₁ h₂ =>
      refine ⟨hdommul _ h₁.1 _ h₂.1, ?_, ?_⟩
      · rw [map_mul]
        exact Submonoid.mul_mem _ h₁.2.1 h₂.2.1
      · rw [map_mul, ← hPmul _ h₁.2.1 _ h₂.2.1]
        exact Subalgebra.mul_mem _ h₁.2.2 h₂.2.2
  -- `M` is spanned by the `a (j t)`, `t` in the generated monoid
  have hMspan : ∀ m ∈ Malg,
      m ∈ Submodule.span ℂ (a '' (j '' (Submonoid.closure Ctilde : Set _))) := by
    intro m hm
    have hm' : m ∈ Subalgebra.toSubmodule (Algebra.adjoin ℂ (a '' (j '' Ctilde))) := hm
    rw [Algebra.adjoin_eq_span] at hm'
    refine Submodule.span_mono ?_ hm'
    intro y hy
    induction hy using Submonoid.closure_induction with
    | mem y hy =>
      obtain ⟨_, ⟨t, ht, rfl⟩, rfl⟩ := hy
      exact ⟨j t, ⟨t, Submonoid.subset_closure ht, rfl⟩, rfl⟩
    | one =>
      refine ⟨j 1, ⟨1, Submonoid.one_mem _, rfl⟩, ?_⟩
      rw [map_one]
      exact ha1
    | mul y₁ y₂ _ _ h₁ h₂ =>
      obtain ⟨_, ⟨t₁, ht₁, rfl⟩, rfl⟩ := h₁
      obtain ⟨_, ⟨t₂, ht₂, rfl⟩, rfl⟩ := h₂
      refine ⟨j (t₁ * t₂), ⟨t₁ * t₂, Submonoid.mul_mem _ ht₁ ht₂, rfl⟩, ?_⟩
      rw [map_mul, hPmul _ (hQ t₁ ht₁).2.1 _ (hQ t₂ ht₂).2.1]
  -- finitely many labels `a x`, `x ∈ K₀`
  let Λ' := a '' (K₀ : Set (rationalPoints G))
  have hΛfin : Λ'.Finite := finite_image_massIndicator K hK haar hK₀c
  have : Finite Λ' := hΛfin.to_subtype
  have hxℓ : ∀ ℓ : Λ', ∃ x₁ ∈ K₀, a x₁ = ℓ.1 := by
    intro ℓ
    obtain ⟨x₁, hx₁, h⟩ := ℓ.2
    exact ⟨x₁, hx₁, h⟩
  choose xℓ hxℓK₀ hxℓa using hxℓ
  -- part 1: `A ≤ M`
  obtain ⟨w, hw, u₀, hu₀, hwu⟩ := hdecomp 1 hdom1
  have hwZ : w ∈ Plancherel.rationalCommonNormKernel B.centralizer.Z := by
    rw [eq_inv_of_mul_eq_one_left hwu]
    exact inv_mem hu₀
  have hjwK₀ : j w ∈ K₀ := hjK₀ w hwZ
  have hw1 : Plancherel.rationalCharacterValuation B.centralizer.Z w = 1 := by
    have h := hwZ
    rw [← Plancherel.rationalCharacterValuation_ker] at h
    exact MonoidHom.mem_ker.1 h
  obtain ⟨N₀, hN₀pos, hN₀K⟩ : ∃ N₀ : ℕ, 0 < N₀ ∧ (j w) ^ N₀ ∈ K := by
    have key : ∀ m₁ m₂ : ℕ, m₁ < m₂ → ((j w) ^ m₁)⁻¹ * (j w) ^ m₂ ∈ K →
        ∃ N₀ : ℕ, 0 < N₀ ∧ (j w) ^ N₀ ∈ K := by
      intro m₁ m₂ hlt hmem
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hlt
      refine ⟨d + 1, Nat.succ_pos d, ?_⟩
      have h : ((j w) ^ m₁)⁻¹ * (j w) ^ (m₁ + d + 1) = (j w) ^ (d + 1) := by
        rw [add_assoc, pow_add (j w) m₁ (d + 1), inv_mul_cancel_left]
      rwa [h] at hmem
    obtain ⟨m₁, m₂, hne, heq⟩ := Finite.exists_ne_map_eq_of_infinite
      (fun n : ℕ => (⟨a ((j w) ^ n), (j w) ^ n, pow_mem hjwK₀ n, rfl⟩ : Λ'))
    have heq' : a ((j w) ^ m₁) = a ((j w) ^ m₂) := congrArg Subtype.val heq
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · exact key m₁ m₂ hlt (h1eq _ (pow_mem hjwK₀ m₁) _ (pow_mem hjwK₀ m₂) heq')
    · exact key m₂ m₁ hlt (h1eq _ (pow_mem hjwK₀ m₂) _ (pow_mem hjwK₀ m₁) heq'.symm)
  have hpow : ∀ (g : rationalPoints G) (n : ℕ), a (g * (j w) ^ n) = a g * (a (j w)) ^ n := by
    intro g n
    induction n with
    | zero => simp only [pow_zero, mul_one]
    | succ n ih =>
      rw [pow_succ (j w) n, ← mul_assoc, ← h2 _ _ hjwK₀, ih, pow_succ (a (j w)) n, mul_assoc]
  have haM : ∀ z ∈ Cplus, a (j z) ∈ Malg := by
    intro z hz
    have hzw : z * w ∈ Ctilde := by
      obtain ⟨c', hc', f, hf, hcf⟩ := (Plancherel.RenardCartan.mem_tildeC0 _ _ _).1 hw.1
      refine ⟨(Plancherel.RenardCartan.mem_tildeC0 _ _ _).2
        ⟨z * c', Subgroup.mul_mem _ hz.1 hc', f, hf, by rw [mul_assoc, hcf]⟩, ?_⟩
      exact (Plancherel.RenardCartan.dominantCentralizer_mem_iff_of_characterValuation_eq
        B.centralizer.s B.centralizer.bijective B.i ν
        (by rw [map_mul, hw1, mul_one])).2 hz.2
    have hz' : a (j z) = a (j (z * w)) * (a (j w)) ^ (N₀ - 1) := by
      rw [← hpow, map_mul, mul_assoc, ← pow_succ', Nat.sub_add_cancel hN₀pos]
      exact (massIndicator_eq_of_mem K hK haar
        ((TestFunction.mem_doubleCosetSet K (j z) (j z * (j w) ^ N₀)).2
          ⟨1, K.one_mem, (j w) ^ N₀, hN₀K, by rw [one_mul]⟩)).symm
    rw [hz']
    exact Subalgebra.mul_mem _ (hMgen _ hzw) (Subalgebra.pow_mem _ (hMgen w hw) _)
  have hAM : Aalg ≤ Malg := Algebra.adjoin_le (by
    rintro _ ⟨_, ⟨z, hz, rfl⟩, rfl⟩
    exact haM z hz)
  -- part 2: the finite family `D`
  let fe : F₀ × Λ' → rationalPoints G := fun p => j p.1.1 * xℓ p.2
  let S : F₀ × Λ' → Set (cocharacterLattice B.S) := fun p =>
    {y | (∀ α, 0 ≤ (L.pair α y : ℝ) + e α p.1) ∧
      ∃ u ∈ Plancherel.rationalCommonNormKernel B.centralizer.Z, a (j u) = p.2.1 ∧
        σ y * p.1.1 * u ∈ Submonoid.closure Ctilde}
  have hgen : ∀ (p : F₀ × Λ') (y : cocharacterLattice B.S) (u : rationalPoints B.centralizer.Z),
      u ∈ Plancherel.rationalCommonNormKernel B.centralizer.Z → a (j u) = p.2.1 →
      a (L.c y * fe p) = a (j (σ y * p.1.1 * u)) := by
    intro p y u hu hua
    calc a (L.c y * fe p) = a (L.c y * j p.1.1 * xℓ p.2) := congrArg a (mul_assoc _ _ _).symm
      _ = a (L.c y * j p.1.1) * a (xℓ p.2) := (h2 _ _ (hxℓK₀ p.2)).symm
      _ = a (L.c y * j p.1.1) * a (j u) := by rw [hxℓa, hua]
      _ = a (L.c y * j p.1.1 * j u) := h2 _ _ (hjK₀ u hu)
      _ = a (j (σ y * p.1.1 * u)) := by rw [hLc, map_mul, map_mul]
  choose T hTfin hTS hT using fun p : F₀ × Λ' =>
    L.exists_finite_left_of_subset hK haar (fe p) (fun α => e α p.1) (S p) (fun y hy => hy.1)
  have hEfin : (⋃ p : F₀ × Λ', (fun t => a (L.c t * fe p)) '' T p).Finite :=
    Set.finite_iUnion fun p => (hTfin p).image _
  obtain ⟨n, D, hD⟩ := hEfin.fin_embedding
  have hDM : ∀ k, D k ∈ Malg := by
    intro k
    have hk : D k ∈ ⋃ p : F₀ × Λ', (fun t => a (L.c t * fe p)) '' T p :=
      hD ▸ Set.mem_range_self k
    obtain ⟨p, hk⟩ := Set.mem_iUnion.1 hk
    obtain ⟨t, ht, hpt⟩ := hk
    rw [← hpt]
    obtain ⟨-, u, hu, hua, hQt⟩ := hTS p ht
    show a (L.c t * fe p) ∈ Malg
    rw [hgen p t u hu hua]
    exact (hQ _ hQt).2.2
  refine ⟨hAM, n, D, hDM, fun m hm => ?_⟩
  refine (Submodule.span_le.2 ?_) (hMspan m hm)
  rintro _ ⟨_, ⟨t, ht, rfl⟩, rfl⟩
  obtain ⟨htdom, -, -⟩ := hQ t ht
  obtain ⟨t', ht', u, hu, htu⟩ := hdecomp t htdom
  obtain ⟨y, f, rfl, hadm⟩ := (hCt t').1 ht'
  subst htu
  let ℓ : Λ' := ⟨a (j u), j u, hjK₀ u hu, rfl⟩
  have hyS : y ∈ S (f, ℓ) := ⟨hadm, u, hu, rfl, ht⟩
  obtain ⟨t₀, ht₀, hdom₀, heq⟩ := hT (f, ℓ) y hyS
  obtain ⟨k, hk⟩ : a (L.c t₀ * fe (f, ℓ)) ∈ Set.range D := by
    rw [hD]
    exact Set.mem_iUnion.2 ⟨(f, ℓ), t₀, ht₀, rfl⟩
  apply Submodule.subset_span
  refine ⟨a (j (σ (y - t₀))),
    hAgen _ ((hCp _).2 ⟨y - t₀, fun α hα => hdom₀ ⟨α, hα⟩, rfl⟩), k, ?_⟩
  rw [hk]
  calc a (j (σ y * f.1 * u)) = a (L.c y * fe (f, ℓ)) := (hgen (f, ℓ) y u hu rfl).symm
    _ = a (L.c (y - t₀)) * a (L.c t₀ * fe (f, ℓ)) := heq.symm
    _ = a (j (σ (y - t₀))) * a (L.c t₀ * fe (f, ℓ)) := by rw [hLc (y - t₀)]

end Langlands.Hecke
