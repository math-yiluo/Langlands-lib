import Langlands.BruhatTits.Cartan.AvailableCartanStatement
import Langlands.BruhatTits.SpecialCompact.StandardBasisProperty
import Langlands.Representation.Plancherel.RenardRepresentativeData
import Langlands.Representation.Hecke.DoubleCosetSandwich
import Langlands.AlgebraicGeometry.PointTopology.RationalPointGroups

/-! # The decomposition of the Hecke algebra `H(G, K)` (Renard V.5.3)

For a connected reductive group over a nonarchimedean local field, available corrected
Kaletha–Prasad data, the special maximal compact subgroup `K₀` of a special vertex, and a
compact open subgroup `K` normal in `K₀` with Iwahori decompositions along the standard
parabolic subgroups: the elements `a_g = e_K ∗ δ_g ∗ e_K` of `H(G, K)` satisfy Renard's product
rules, the algebra `A` generated by the dominant `a_z` is commutative, finitely many `a_t`
generate all dominant Cartan elements over `A`, and `H(G, K) = ∑ⱼ H₀ A Dⱼ H₀`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry MeasureTheory
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Hecke

/-- Renard V.5.3: the two lemmas on products, the Corollary, the finiteness Lemma, the Theorem
and the Remark, together with the finite-dimensional subalgebra `H₀ = H(K₀, K)`.

Data: a nonarchimedean local field `F`, a connected reductive `G` with the canonical topology
on `G(F)`, an assignment `𝔅` of corrected Kaletha–Prasad building data available for `G`,
with base datum `B` (maximal split torus `B.i : S → G`, centralizer `j : Z → G`, `s : S → Z`),
a generic cocharacter `ν` (the positive system and minimal parabolic `P_∅`), a special vertex
`x` with special compact `K₀`, a compact open subgroup `K ⊆ K₀` normal in `K₀` that has,
for every standard parabolic, the Iwahori decomposition and contraction properties of
Renard V.5.2 (ii) (`StandardParabolicBasisMember`), a finite transversal `F₀ ⊆ Z(F)` of the
lattice `Λ(Z)/Λ(S)`, and a Haar measure `haar` on `G(F)`.

Write `a g` for the mass-one indicator of `K g K` (Renard's `a_{g,K} = e_K ∗ δ_g ∗ e_K`),
`C⁺ = C_∅ ∩ Z(F)^+` for the dominant elements of Renard's `C_∅ ⊆ Z(F)`, and
`C̃⁺ = (C_∅ F₀) ∩ Z(F)^+` for the dominant representatives of `Λ(Z)` (Renard V.3.23), all
mapped to `G(F)` by `j`. Then:

1. `H₀ = span {a x | x ∈ K₀}` is finite-dimensional, the distinct `a x` are linearly
   independent, and `a x = a x'` exactly when `x⁻¹ x' ∈ K`;
2. `a g * a x = a (g x)` and `a x * a g = a (x g)` for `g ∈ G(F)`, `x ∈ K₀`;
3. `a z₁ * a z₂ = a (z₁ z₂)` for `z₁, z₂ ∈ C⁺`;
4. the subalgebra `A` generated by the `a z`, `z ∈ C⁺`, is commutative;
5. there are finitely many `t_k ∈ C̃⁺` such that every `a t`, `t ∈ C̃⁺`, is a linear
   combination of products `a z * a t_k`, `z ∈ C⁺` (the `A`-module generated by these `a t`
   is finitely generated);
6. for every finite family `D_k` of elements such that every `a t`, `t ∈ C̃⁺`, is a linear
   combination of products `a z * D_k`, the products `a x * a z * D_k * a x'`
   (`x, x' ∈ K₀`, `z ∈ C⁺`) span `H(G, K)`: `H(G, K) = ∑ₖ H₀ A D_k H₀`;
7. there are finitely many `t_k ∈ C̃⁺` such that every `a t` is a linear combination of
   products `a t_k * a z`, and the products `a x * a t_k * a z * a x'` span `H(G, K)`:
   `H(G, K) = ∑ₖ H₀ E_k A H₀`. -/
def IwahoriHeckeDecompositionStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    haveI : IsAffineHom G.X.hom := hG.isAffineHom
    haveI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    haveI := hG.smooth
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    haveI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    ∀ [T2Space (rationalPoints G)] [MeasurableSpace (rationalPoints G)]
      [BorelSpace (rationalPoints G)]
      (𝔅 : KPBuildingAssignment.{u}), 𝔅.IsAvailableFor F G hG →
      let B := (𝔅.datum F G hG).base
      ∀ ν : cocharacterLattice B.S, IsGenericCocharacter B.i ν →
        ∀ x : B.Apartment, B.apartment.IsSpecialApartmentVertex x →
          let K₀ := B.apartment.specialCompactSubgroup x
          ∀ (K : OpenSubgroup (rationalPoints G)) (hK : IsCompact (K : Set (rationalPoints G))),
            K.toSubgroup ≤ K₀ →
            (∀ k₀ ∈ K₀, ∀ k ∈ K, k₀ * k * k₀⁻¹ ∈ K) →
            (∀ J : Set (characterLattice B.S), J ⊆ simpleRelativeRoots B.i ν →
              ∃ (A : CommGroupScheme (Spec (CommRingCat.of F))) (q : A.toGrp ⟶ B.S.toGrp),
                BruhatTits.SpecialCompact.IsCompatibleStandardSplitComponent B.i ν J A q ∧
                  BruhatTits.SpecialCompact.StandardParabolicBasisMember B.i ν J q K.toSubgroup) →
            ∀ F₀ : Set (rationalPoints B.centralizer.Z),
              Plancherel.RenardCartan.IsFiniteLatticeTransversal B.centralizer.s F₀ →
            ∀ (haar : Measure (rationalPoints G)) [haar.IsHaarMeasure],
              let j := rationalPoints.map B.centralizer.j
              let dom := BruhatTits.Cartan.parahoricDominantSet B ν
              let Cplus : Set (rationalPoints B.centralizer.Z) :=
                (Plancherel.RenardCartan.C0 B.S B.centralizer.s : Set _) ∩ dom
              let Ctilde : Set (rationalPoints B.centralizer.Z) :=
                Plancherel.RenardCartan.tildeC0Plus B.centralizer.s F₀ dom
              let a : rationalPoints G → HeckeAlgebra.Corner haar K hK :=
                HeckeAlgebra.Corner.massIndicator K hK haar
              (FiniteDimensional ℂ (Submodule.span ℂ (a '' (K₀ : Set (rationalPoints G)))) ∧
                LinearIndepOn ℂ id (a '' (K₀ : Set (rationalPoints G))) ∧
                ∀ x₁ ∈ K₀, ∀ x₂ ∈ K₀, a x₁ = a x₂ ↔ x₁⁻¹ * x₂ ∈ K) ∧
              (∀ g : rationalPoints G, ∀ x₁ ∈ K₀,
                a g * a x₁ = a (g * x₁) ∧ a x₁ * a g = a (x₁ * g)) ∧
              (∀ z₁ ∈ Cplus, ∀ z₂ ∈ Cplus, a (j z₁) * a (j z₂) = a (j (z₁ * z₂))) ∧
              (∀ u ∈ Algebra.adjoin ℂ (a '' (j '' Cplus)),
                ∀ v ∈ Algebra.adjoin ℂ (a '' (j '' Cplus)), u * v = v * u) ∧
              (∃ (n : ℕ) (t : Fin n → rationalPoints B.centralizer.Z), (∀ k, t k ∈ Ctilde) ∧
                ∀ t' ∈ Ctilde, a (j t') ∈ Submodule.span ℂ
                  {y | ∃ z ∈ Cplus, ∃ k, y = a (j z) * a (j (t k))}) ∧
              (∀ (n : ℕ) (D : Fin n → HeckeAlgebra.Corner haar K hK),
                (∀ t' ∈ Ctilde, a (j t') ∈ Submodule.span ℂ
                  {y | ∃ z ∈ Cplus, ∃ k, y = a (j z) * D k}) →
                Submodule.span ℂ
                  {y | ∃ x₁ ∈ K₀, ∃ z ∈ Cplus, ∃ k, ∃ x₂ ∈ K₀,
                    y = a x₁ * a (j z) * D k * a x₂} = ⊤) ∧
              ∃ (n : ℕ) (t : Fin n → rationalPoints B.centralizer.Z), (∀ k, t k ∈ Ctilde) ∧
                (∀ t' ∈ Ctilde, a (j t') ∈ Submodule.span ℂ
                  {y | ∃ z ∈ Cplus, ∃ k, y = a (j (t k)) * a (j z)}) ∧
                Submodule.span ℂ
                  {y | ∃ x₁ ∈ K₀, ∃ k, ∃ z ∈ Cplus, ∃ x₂ ∈ K₀,
                    y = a x₁ * a (j (t k)) * a (j z) * a x₂} = ⊤

end Langlands.Hecke
