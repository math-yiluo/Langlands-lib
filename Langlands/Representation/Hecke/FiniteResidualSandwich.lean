import Langlands.Representation.Hecke.ResidualIwahoriSandwich

/-! # Finite sandwich data with arbitrary Cartan residuals -/

noncomputable section

namespace Langlands.Hecke

open MeasureTheory

universe uG uΔ

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [T2Space G] [MeasurableSpace G] [BorelSpace G]
  (K : OpenSubgroup G) (hK : IsCompact (K : Set G))
  (μ : Measure G) [μ.IsHaarMeasure]
  (N M Nbar : Subgroup G)
  (hfactor : ∀ k ∈ K, ∃ l ∈ K.toSubgroup ⊓ Nbar,
    ∃ m ∈ K.toSubgroup ⊓ M, ∃ u ∈ K.toSubgroup ⊓ N, k = l * m * u)
  {Δ : Type uΔ}
  (e : Multiplicative (Δ → ℕ) →* G)
  (he : ∀ n, e (Multiplicative.ofAdd n) ∈
    iwahoriPositiveMonoid K.toSubgroup N M Nbar)

namespace HeckeAlgebra.Corner

/-- The actual mass-one positive indicators form a monoid homomorphism. -/
def iwahoriOrthantMassHom : Multiplicative (Δ → ℕ) →* Corner μ K hK where
  toFun n := massIndicator K hK μ (e n)
  map_one' := by rw [map_one, massIndicator_one]
  map_mul' a b := by
    rw [map_mul]
    symm
    apply massIndicator_mul K hK μ
    exact TestFunction.mul_mem_doubleCosetSet_of_iwahori K N M Nbar hfactor _ _
      (fun u hu => ((he a.toAdd).1 u hu).1)
      (fun l hl => ((he b.toAdd).2.1 l hl).1)
      (fun m hm => ((he b.toAdd).2.2 m hm).1)

variable [Finite Δ] [DecidableEq Δ]

include hfactor he

/-- All positive orthant indicators lie in the algebra generated by
the finitely many coordinate indicators. -/
theorem iwahoriOrthantMassHom_mem_adjoin (n : Δ → ℕ) :
    iwahoriOrthantMassHom K hK μ N M Nbar hfactor e he (Multiplicative.ofAdd n) ∈
      Algebra.adjoin ℂ (Set.range (fun i : Δ =>
        massIndicator K hK μ (e (Multiplicative.ofAdd (Pi.single i 1))))) := by
  let H := iwahoriOrthantMassHom K hK μ N M Nbar hfactor e he
  let A := Algebra.adjoin ℂ (Set.range (fun i : Δ =>
    massIndicator K hK μ (e (Multiplicative.ofAdd (Pi.single i 1)))))
  change H (Multiplicative.ofAdd n) ∈ A
  apply Pi.single_induction (fun n => H (Multiplicative.ofAdd n) ∈ A) n
  · change H 1 ∈ A
    rw [map_one]
    exact one_mem _
  · intro n m hn hm
    change H (Multiplicative.ofAdd n * Multiplicative.ofAdd m) ∈ A
    rw [map_mul]
    exact mul_mem hn hm
  · intro i m
    have hs : (Multiplicative.ofAdd (Pi.single i m : Δ → ℕ)) =
        (Multiplicative.ofAdd (Pi.single i 1 : Δ → ℕ)) ^ m := by
      change (Pi.single i m : Δ → ℕ) = m • (Pi.single i 1 : Δ → ℕ)
      funext j
      by_cases h : j = i <;> simp [h]
    rw [hs, map_pow]
    apply pow_mem
    exact Algebra.subset_adjoin ⟨i, rfl⟩

omit [Finite Δ] in
/-- The coordinate mass-one indicators commute because the orthant does. -/
theorem commute_iwahoriOrthantMass (i j : Δ) :
    Commute
      (massIndicator K hK μ (e (Multiplicative.ofAdd (Pi.single i 1))))
      (massIndicator K hK μ (e (Multiplicative.ofAdd (Pi.single j 1)))) := by
  exact (Commute.all (Multiplicative.ofAdd (Pi.single i 1))
    (Multiplicative.ofAdd (Pi.single j 1))).map
      (iwahoriOrthantMassHom K hK μ N M Nbar hfactor e he)

/-- Finitely many residuals yield finitely many actual Hecke factors
on the right of the positive coordinate algebra. -/
theorem exists_finite_residual_hecke_generators
    (hmid : ∀ n, ∀ m ∈ K.toSubgroup ⊓ M,
      e (Multiplicative.ofAdd n) * m * (e (Multiplicative.ofAdd n))⁻¹ ∈ K)
    (T : Set G) (hT : T.Finite) :
    ∃ E : Set (Corner μ K hK), E.Finite ∧
      ∀ f ∈ T, ∀ n : Δ → ℕ, ∃ x ∈ E,
        ∃ a ∈ Algebra.adjoin ℂ (Set.range (fun i : Δ =>
          massIndicator K hK μ (e (Multiplicative.ofAdd (Pi.single i 1))))),
          massIndicator K hK μ (e (Multiplicative.ofAdd n) * f) = a * x := by
  classical
  have : Finite T := hT.to_subtype
  have hfront (f : T) := exists_finite_residual_massIndicator_frontier
    K hK μ N M Nbar hfactor e he hmid f.val
  choose S hS hmul using hfront
  let E := ⋃ f : T, (fun m => massIndicator K hK μ (e (Multiplicative.ofAdd m) * f.val)) '' S f
  refine ⟨E, Set.finite_iUnion (fun f => (hS f).image _), ?_⟩
  intro f hf n
  obtain ⟨m, hm, _, hprod⟩ := hmul ⟨f, hf⟩ n
  refine ⟨massIndicator K hK μ (e (Multiplicative.ofAdd m) * f),
    Set.mem_iUnion.2 ⟨⟨f, hf⟩, ⟨m, hm, rfl⟩⟩,
    massIndicator K hK μ (e (Multiplicative.ofAdd (n - m))), ?_, hprod.symm⟩
  exact iwahoriOrthantMassHom_mem_adjoin K hK μ N M Nbar hfactor e he _

end HeckeAlgebra.Corner

open HeckeAlgebra.Corner

variable [Finite Δ] [DecidableEq Δ]

include hfactor he

/-- A finite-residual Cartan decomposition supplies actual finite sandwich
data. No residual normalization or commutativity is required. -/
theorem nonempty_fixedLevelSandwich_of_residual_iwahoriCartan
    (hmid : ∀ n, ∀ m ∈ K.toSubgroup ⊓ M,
      e (Multiplicative.ofAdd n) * m * (e (Multiplicative.ofAdd n))⁻¹ ∈ K)
    (Γ : Subgroup G) (hΓc : IsCompact (Γ : Set G))
    (hΓ : Γ ≤ Subgroup.normalizer (K.toSubgroup : Set G))
    (T : Set G) (hT : T.Finite)
    (hdecomp : ∀ g : G, ∃ γ ∈ Γ, ∃ γ' ∈ Γ, ∃ f ∈ T,
      ∃ n : Δ → ℕ, g = γ * (e (Multiplicative.ofAdd n) * f) * γ') :
    Nonempty (FixedLevelSandwich μ K hK) := by
  classical
  let := Fintype.ofFinite Δ
  obtain ⟨E, hE, hgen⟩ :=
    exists_finite_residual_hecke_generators K hK μ N M Nbar hfactor e he hmid T hT
  obtain ⟨t, ht⟩ := hΓc.elim_finite_subcover
    (fun γ : Γ => (fun y : G => (γ : G)⁻¹ * y) ⁻¹' (K : Set G))
    (fun γ => K.isOpen.preimage (continuous_const.mul continuous_id))
    (fun y hy => Set.mem_iUnion.2 ⟨⟨y, hy⟩, by simp⟩)
  let R : Fin t.card → G := fun i => ((t.equivFin.symm i : t) : Γ)
  have hR : ∀ i, R i ∈ Subgroup.normalizer (K.toSubgroup : Set G) :=
    fun i => hΓ ((t.equivFin.symm i : t) : Γ).2
  have hcover : ∀ γ ∈ Γ, ∃ i, (R i)⁻¹ * γ ∈ K := by
    intro γ hγ
    have := ht hγ
    simp only [Set.mem_iUnion, Set.mem_preimage, SetLike.mem_coe] at this
    obtain ⟨r, hr, hγr⟩ := this
    exact ⟨t.equivFin ⟨r, hr⟩, by simpa [R] using hγr⟩
  let middle : Fin (Fintype.card Δ) → HeckeAlgebra.Corner μ K hK :=
    fun i => massIndicator K hK μ
      (e (Multiplicative.ofAdd (Pi.single ((Fintype.equivFin Δ).symm i) 1)))
  have hrange : Set.range middle = Set.range (fun i : Δ =>
      massIndicator K hK μ (e (Multiplicative.ofAdd (Pi.single i 1)))) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨(Fintype.equivFin Δ).symm i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨(Fintype.equivFin Δ) i, by simp [middle]⟩
  let U : Set (HeckeAlgebra.Corner μ K hK) :=
    Set.range (fun i => doubleCoset K hK μ (R i)) ∪
      Set.image2 (· * ·) E (Set.range (fun i => doubleCoset K hK μ (R i)))
  have hU : U.Finite := (Set.finite_range _).union
    (Set.Finite.image2 (· * ·) hE (Set.finite_range _))
  let := hU.fintype
  let edge : Fin (Fintype.card U) → HeckeAlgebra.Corner μ K hK :=
    fun i => ((Fintype.equivFin U).symm i).val
  have hedge (x : HeckeAlgebra.Corner μ K hK) (hx : x ∈ U) :
      ∃ i, edge i = x :=
    ⟨(Fintype.equivFin U) ⟨x, hx⟩, by simp [edge]⟩
  refine ⟨⟨Fintype.card U, Fintype.card Δ, edge, middle, ?_, ?_⟩⟩
  · intro i j
    exact commute_iwahoriOrthantMass K hK μ N M Nbar hfactor e he _ _
  · rw [eq_top_iff, ← span_range_doubleCoset K hK μ, Submodule.span_le]
    rintro _ ⟨g, rfl⟩
    obtain ⟨γ, hγ, γ', hγ', f, hf, n, hg⟩ := hdecomp g
    obtain ⟨p, hp⟩ := hcover γ hγ
    obtain ⟨q, hq⟩ := hcover γ' hγ'
    obtain ⟨x, hx, a, ha, hprod⟩ := hgen f hf n
    obtain ⟨i, hi⟩ := hedge (doubleCoset K hK μ (R p)) (Or.inl ⟨p, rfl⟩)
    obtain ⟨j, hj⟩ := hedge (x * doubleCoset K hK μ (R q))
      (Or.inr ⟨x, hx, doubleCoset K hK μ (R q), ⟨q, rfl⟩, rfl⟩)
    have hmem : g ∈ TestFunction.doubleCosetSet K
        (R p * (e (Multiplicative.ofAdd n) * f) * R q) := by
      refine (TestFunction.mem_doubleCosetSet K _ _).2
        ⟨R p * ((R p)⁻¹ * γ) * (R p)⁻¹,
          (Subgroup.mem_normalizer_iff.mp (hR p) _).1 hp,
          (R q)⁻¹ * γ', hq, ?_⟩
      rw [hg]
      group
    have hbase : doubleCoset K hK μ g =
        doubleCoset K hK μ (R p) *
          doubleCoset K hK μ (e (Multiplicative.ofAdd n) * f) *
          doubleCoset K hK μ (R q) := by
      rw [doubleCoset_eq_of_mem K hK μ hmem,
        doubleCoset_mul_mul_of_mem_normalizer K hK μ (hR p) (hR q)]
    rw [hbase, doubleCoset_eq_smul_massIndicator K hK μ (e (Multiplicative.ofAdd n) * f),
      hprod]
    apply Submodule.subset_span
    refine ⟨i, j,
      ((μ.real (TestFunction.doubleCosetSet K (e (Multiplicative.ofAdd n) * f)) : ℂ) *
        (μ.real (K : Set G) : ℂ)⁻¹) • a, ?_, ?_⟩
    · rw [hrange]
      exact Subalgebra.smul_mem _ ha _
    · rw [hi, hj]
      simp only [mul_smul_comm, smul_mul_assoc, mul_assoc]

end Langlands.Hecke
