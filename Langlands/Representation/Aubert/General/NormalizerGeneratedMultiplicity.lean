import Langlands.Representation.Aubert.General.NormalizerRegularity
import Langlands.Representation.Smooth.Schur.Proof
import Mathlib.LinearAlgebra.Dimension.Basic

/-! # Multiplicity bounds for representations generated by actual normalizer conjugates -/

noncomputable section

namespace Langlands.Aubert.General

universe uG uV uW uJ

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {M : Subgroup G}
  (σ : SmoothRep.{0, uG, uV} ℂ M) (τ : SmoothRep.{0, uG, uW} ℂ M)

/-- Restrict a map into `σ` to the distinguished supplied copy of `σ` in the
source. The carriers of the source and `σ` need not have equal universes. -/
def normalizerGeneratedRestriction
    (i₀ : σ.representation.IntertwiningMap τ.representation) :
    (τ.representation.IntertwiningMap σ.representation) →ₗ[ℂ]
      (σ.representation.IntertwiningMap σ.representation) where
  toFun f := f.comp i₀
  map_add' _ _ := by ext x; rfl
  map_smul' _ _ := by ext x; rfl

/-- If the source is generated by one copy of `σ` and any family of noninner
normalizer conjugates, restriction to that copy detects every map into `σ`.
No finiteness, injectivity of the supplied maps or direct sum is assumed. -/
theorem normalizerGeneratedRestriction_injective
    (hσ : σ.IsIrreducible) (hreg : IsNormalizerRegular σ)
    (i₀ : σ.representation.IntertwiningMap τ.representation)
    {J : Type uJ} (g : J → Subgroup.normalizer (M : Set G))
    (hg : ∀ j, (g j : G) ∉ M)
    (i : ∀ j, (normalizerConjugate (g j) σ).representation.IntertwiningMap τ.representation)
    (hspan : LinearMap.range i₀.toLinearMap ⊔
      (⨆ j, LinearMap.range (i j).toLinearMap) = ⊤) :
    Function.Injective (normalizerGeneratedRestriction σ τ i₀) := by
  intro f k hfk
  have hker : LinearMap.range i₀.toLinearMap ⊔
      (⨆ j, LinearMap.range (i j).toLinearMap) ≤ (f - k).toLinearMap.ker := by
    apply sup_le
    · rintro y ⟨x, rfl⟩
      change f (i₀ x) - k (i₀ x) = 0
      exact sub_eq_zero.mpr (congrArg (fun T => T x) hfk)
    · refine iSup_le fun j => ?_
      rintro y ⟨x, rfl⟩
      have hz := normalizerConjugate_hom_eq_zero σ hσ hreg (g j) (hg j)
        ((f - k).comp (i j))
      exact congrArg (fun T => T x) hz
  rw [hspan] at hker
  apply Representation.IntertwiningMap.ext
  apply LinearMap.ext
  intro x
  exact sub_eq_zero.mp (hker (Submodule.mem_top : x ∈ (⊤ : Submodule ℂ τ)))

/-- Admissible Schur and the preceding restriction injection bound the entire
intertwining space by one, with independent group, source, target and index
universes. This is a consequence of the supplied generating maps. -/
theorem normalizerGeneratedHom_rank_le_one
    (hσ : σ.IsIrreducible) (hadm : σ.IsAdmissible) (hreg : IsNormalizerRegular σ)
    (i₀ : σ.representation.IntertwiningMap τ.representation)
    {J : Type uJ} (g : J → Subgroup.normalizer (M : Set G))
    (hg : ∀ j, (g j : G) ∉ M)
    (i : ∀ j, (normalizerConjugate (g j) σ).representation.IntertwiningMap τ.representation)
    (hspan : LinearMap.range i₀.toLinearMap ⊔
      (⨆ j, LinearMap.range (i j).toLinearMap) = ⊤) :
    Module.rank ℂ (τ.representation.IntertwiningMap σ.representation) ≤ 1 := by
  obtain ⟨e⟩ := admissibleSchur_homEquiv σ.representation hadm hσ
    σ.representation (Representation.Equiv.refl _)
  let L : (τ.representation.IntertwiningMap σ.representation) →ₗ[ℂ] ℂ :=
    e.toLinearMap.comp (normalizerGeneratedRestriction σ τ i₀)
  have hinj : Function.Injective L :=
    e.injective.comp (normalizerGeneratedRestriction_injective σ τ hσ hreg i₀ g hg i hspan)
  have hrank := LinearMap.lift_rank_le_of_injective L hinj
  simpa using hrank

end Langlands.Aubert.General
