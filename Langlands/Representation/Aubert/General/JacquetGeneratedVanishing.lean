import Langlands.Representation.Aubert.General.SupportCategoryReductions

/-! # Jacquet vanishing from generating families and their subquotients -/

noncomputable section

open CategoryTheory

universe uR uG uI uV uW

namespace Langlands.Jacquet.Localization

variable {R : Type uR} [CommRing R] {G : Type uG} [Group G]
  {ι : Type uI} {V : Type uV} [AddCommGroup V] [Module R V]
  {W : ι → Type uW} [∀ i, AddCommGroup (W i)] [∀ i, Module R (W i)]

/-- Character coinvariants vanish if the module is generated by images of
modules whose character coinvariants vanish. The family can be infinite. -/
theorem subsingleton_coinvariants_of_iSup_range_eq_top
    (ρ : Representation R G V) (σ : ∀ i, Representation R G (W i))
    (U : Subgroup G) (θ : U →* Rˣ)
    (f : ∀ i, (σ i).IntertwiningMap ρ)
    (hgen : (⨆ i, LinearMap.range (f i).toLinearMap) = ⊤)
    (hvan : ∀ i, Subsingleton (Coinvariants (σ i) U θ)) :
    Subsingleton (Coinvariants ρ U θ) := by
  have hkill : ∀ i v, mk ρ U θ (f i v) = 0 := by
    intro i v
    have he : mk (σ i) U θ v = 0 := @Subsingleton.elim _ (hvan i) _ _
    have hm := congrArg (mapLinear U θ (f i)) he
    simpa only [mapLinear, lift_mk, LinearMap.comp_apply,
      Representation.IntertwiningMap.toLinearMap_apply, map_zero] using hm
  have htop : (⊤ : Submodule R V) ≤ LinearMap.ker (mk ρ U θ) := by
    rw [← hgen]
    refine iSup_le fun i => ?_
    rintro _ ⟨v, rfl⟩
    exact hkill i v
  have hzero : ∀ v, mk ρ U θ v = 0 := fun v => htop (Submodule.mem_top : v ∈ ⊤)
  refine ⟨fun a b => ?_⟩
  obtain ⟨v, rfl⟩ := mk_surjective ρ U θ a
  obtain ⟨w, rfl⟩ := mk_surjective ρ U θ b
  rw [hzero v, hzero w]

/-- Identify the character coinvariants with the zero submodule when a
generating family has zero character coinvariants. -/
def coinvariantsEquivBotOfGeneratingFamily
    (ρ : Representation R G V) (σ : ∀ i, Representation R G (W i))
    (U : Subgroup G) (θ : U →* Rˣ)
    (f : ∀ i, (σ i).IntertwiningMap ρ)
    (hgen : (⨆ i, LinearMap.range (f i).toLinearMap) = ⊤)
    (hvan : ∀ i, Subsingleton (Coinvariants (σ i) U θ)) :
    Coinvariants ρ U θ ≃ₗ[R] (⊥ : Submodule R V) := by
  letI := subsingleton_coinvariants_of_iSup_range_eq_top ρ σ U θ f hgen hvan
  exact LinearEquiv.ofSubsingleton _ _

end Langlands.Jacquet.Localization

namespace Langlands.Aubert.General

open SmoothRep

variable {G : Type uG} [Group G] [TopologicalSpace G]
  [LocallyCompactSpace G] [NonarchimedeanGroup G]
  {P M U : Subgroup G} {ι : Type uI}

/-- The actual normalized Jacquet functor kills any smooth module generated
by images of modules which it kills. No compact-limit premise is needed. -/
theorem jacquet_subsingleton_of_iSup_range_eq_top
    (h : IsSemidirectDecomposition P M U) (hU : IsClosed (U : Set G))
    {A : SmoothRep.{0, uG, uV} ℂ G} {B : ι → SmoothRep.{0, uG, uV} ℂ G}
    (f : ∀ i, B i ⟶ A)
    (hgen : (⨆ i, LinearMap.range (hom (f i)).toLinearMap) = ⊤)
    (hvan : ∀ i, Subsingleton ((jacquetFunctor h hU).obj (B i))) :
    Subsingleton ((jacquetFunctor h hU).obj A) :=
  Jacquet.Localization.subsingleton_coinvariants_of_iSup_range_eq_top
    A.representation (fun i => (B i).representation) U 1 (fun i => hom (f i)) hgen hvan

/-- Exactness passes the vanishing for a generating family to every actual
subquotient of the generated module. This applies to arbitrary smooth objects. -/
theorem jacquet_subsingleton_of_isSubquotient_of_iSup_range_eq_top
    (h : IsSemidirectDecomposition P M U) (hU : IsClosed (U : Set G))
    (hUc : Jacquet.Localization.IsLimitOfCompactSubgroups U)
    {A E : SmoothRep.{0, uG, uV} ℂ G} {B : ι → SmoothRep.{0, uG, uV} ℂ G}
    (f : ∀ i, B i ⟶ A)
    (hgen : (⨆ i, LinearMap.range (hom (f i)).toLinearMap) = ⊤)
    (hvan : ∀ i, Subsingleton ((jacquetFunctor h hU).obj (B i)))
    (hEA : IsSubquotient E A) :
    Subsingleton ((jacquetFunctor h hU).obj E) :=
  jacquet_subsingleton_of_isSubquotient h hU hUc hEA
    (jacquet_subsingleton_of_iSup_range_eq_top h hU f hgen hvan)

end Langlands.Aubert.General
