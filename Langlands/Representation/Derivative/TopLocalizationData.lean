import Langlands.Representation.Whittaker.MirabolicQuotientMeasure
import Langlands.Representation.Derivative.MirabolicCharacter
import Langlands.Representation.Whittaker.EntrywiseCharacter
import Langlands.Group.GL.NormalizedCharacter
import Langlands.Representation.Twist.RealPower

/-! # Concrete matrix data for top character localization -/

noncomputable section

namespace Langlands.Derivative.TopLocalization

open GeneralLinear GeneralLinear.Mirabolic HarmonicAnalysis

universe uF

variable {F : Type uF} [Field F] {n : ℕ}

/-- The smaller full upper-unipotent group embedded by `diag(-,1)`. -/
def upperLeviSubgroup (n : ℕ) (F : Type uF) [Field F] :
    Subgroup (mirabolic n F) :=
  (GeneralLinear.upperUnipotent n F).map levi

theorem upperLeviSubgroup_le_upper :
    upperLeviSubgroup n F ≤ Mirabolic.upperUnipotent n F := by
  rintro _ ⟨g, hg, rfl⟩
  exact Whittaker.MirabolicQuotient.levi_mem_upperUnipotent hg

/-- The actual upper-unipotent group is generated by its final-column radical
and its smaller upper-unipotent Levi subgroup, including rank zero. -/
theorem upper_eq_radical_sup :
    Mirabolic.upperUnipotent n F = radical n F ⊔ upperLeviSubgroup n F := by
  apply le_antisymm
  · intro g hg
    rw [eq_radicalElement_mul_levi g]
    exact mul_mem (Subgroup.mem_sup_left (radicalElement _).property)
      (Subgroup.mem_sup_right
        ⟨projection g, Whittaker.MirabolicQuotient.projection_mem_upperUnipotent hg, rfl⟩)
  · exact sup_le radical_le_upperUnipotent upperLeviSubgroup_le_upper

/-- Restrict the actual upper-left projection to full upper unipotents. -/
def upperProjection :
    Mirabolic.upperUnipotent n F →* GeneralLinear.upperUnipotent n F :=
  (projection.comp (Mirabolic.upperUnipotent n F).subtype).codRestrict _ fun u =>
    Whittaker.MirabolicQuotient.projection_mem_upperUnipotent u.property

@[simp] theorem upperProjection_val (u : Mirabolic.upperUnipotent n F) :
    (upperProjection u).val = projection u.val := rfl

/-- Embed smaller upper unipotents into the actual mirabolic upper group. -/
def upperLevi :
    GeneralLinear.upperUnipotent n F →* Mirabolic.upperUnipotent n F :=
  (levi.comp (GeneralLinear.upperUnipotent n F).subtype).codRestrict _ fun u =>
    Whittaker.MirabolicQuotient.levi_mem_upperUnipotent u.property

@[simp] theorem upperLevi_val (u : GeneralLinear.upperUnipotent n F) :
    (upperLevi u).val = levi u.val := rfl

@[simp] theorem upperProjection_upperLevi (u : GeneralLinear.upperUnipotent n F) :
    upperProjection (upperLevi u) = u :=
  Subtype.ext (projection_levi u.val)

/-- The same embedding, now between the two ambient full unipotent groups. -/
def leviUpper :
    GeneralLinear.upperUnipotent n F →* GeneralLinear.upperUnipotent (n + 1) F :=
  upperUnipotentEquiv.toMonoidHom.comp upperLevi

@[simp] theorem leviUpper_val (u : GeneralLinear.upperUnipotent n F) :
    (leviUpper u).val = (levi u.val).val := rfl

/-- The smaller full upper group is canonically its actual Levi image. -/
def upperLeviEquiv :
    GeneralLinear.upperUnipotent n F ≃* upperLeviSubgroup n F where
  toFun u := ⟨levi u.val, ⟨u.val, u.property, rfl⟩⟩
  invFun u := upperProjection ⟨u.val, upperLeviSubgroup_le_upper u.property⟩
  left_inv u := upperProjection_upperLevi u
  right_inv u := by
    apply Subtype.ext
    obtain ⟨g, hg, he⟩ := u.property
    change levi (projection u.val) = u.val
    rw [← he, projection_levi]
  map_mul' u v := Subtype.ext (map_mul levi u.val v.val)

@[simp] theorem upperLeviEquiv_val (u : GeneralLinear.upperUnipotent n F) :
    (upperLeviEquiv u).val = levi u.val := rfl

@[simp] theorem upperLeviEquiv_symm_val (u : upperLeviSubgroup n F) :
    (upperLeviEquiv.symm u).val = projection u.val := rfl

/-- In the positive induction step this subgroup lies in the published
successor mirabolic range. -/
theorem upperLeviSubgroup_le_successor :
    upperLeviSubgroup (n + 1) F ≤ successorSubgroup n F := by
  rintro _ ⟨g, hg, rfl⟩
  exact ⟨⟨g, upperUnipotent_le_mirabolic hg⟩, rfl⟩

/-- The smaller full upper group as a subgroup of the actual successor range. -/
def successorUpperSubgroup (n : ℕ) (F : Type uF) [Field F] :
    Subgroup (successorSubgroup n F) :=
  (upperLeviSubgroup (n + 1) F).subgroupOf (successorSubgroup n F)

/-- The canonical subgroup copy needed by the generic localization tower. -/
def successorUpperEquiv :
    GeneralLinear.upperUnipotent (n + 1) F ≃* successorUpperSubgroup n F where
  toFun u := ⟨⟨levi u.val, upperLeviSubgroup_le_successor
    (show levi u.val ∈ upperLeviSubgroup (n + 1) F from ⟨u.val, u.property, rfl⟩)⟩,
      ⟨u.val, u.property, rfl⟩⟩
  invFun u := upperLeviEquiv.symm ⟨u.val.val, u.property⟩
  left_inv u := upperLeviEquiv.left_inv u
  right_inv u := by
    apply Subtype.ext
    apply Subtype.ext
    change levi (projection u.val.val) = u.val.val
    obtain ⟨g, hg, he⟩ := u.property
    change levi g = u.val.val at he
    rw [← he, projection_levi]
  map_mul' u v := Subtype.ext (Subtype.ext (map_mul levi u.val v.val))

@[simp] theorem successorUpperEquiv_val (u : GeneralLinear.upperUnipotent (n + 1) F) :
    (successorUpperEquiv u).val.val = levi u.val := rfl

/-- The subgroup copy maps back to precisely the actual smaller upper group. -/
theorem successorUpperSubgroup_map :
    (successorUpperSubgroup n F).map (successorSubgroup n F).subtype =
      upperLeviSubgroup (n + 1) F := by
  ext g
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact hu
  · intro hg
    exact ⟨⟨g, upperLeviSubgroup_le_successor hg⟩, hg, rfl⟩

section Characters

variable (ψ : AddChar F ℂ)

/-- `diag(u,1)` preserves the sum of adjacent entries. -/
theorem superdiagonalSum_levi (u : GeneralLinear.upperUnipotent (n + 1) F) :
    (∑ i : Fin (n + 1), (leviUpper u).val.val i.castSucc i.succ) =
      ∑ i : Fin n, u.val.val i.castSucc i.succ := by
  rw [Fin.sum_univ_castSucc]
  have hlast :
      (leviUpper u).val.val (Fin.last n).castSucc (Fin.last n).succ = 0 :=
    levi_last u.val (Fin.last n)
  rw [hlast, add_zero]
  apply Finset.sum_congr rfl
  intro i _
  exact levi_first u.val i.castSucc i.succ

/-- Exact compatibility of the all-ranks entrywise character with the Levi map. -/
theorem entrywiseCharacter_levi :
    (Whittaker.entrywiseCharacter ψ (n + 1)).comp leviUpper =
      Whittaker.entrywiseCharacter ψ n := by
  cases n with
  | zero => simp
  | succ n =>
    ext u
    change ψ (∑ i : Fin (n + 1), (leviUpper u).val.val i.castSucc i.succ) =
      ψ (∑ i : Fin n, u.val.val i.castSucc i.succ)
    rw [superdiagonalSum_levi]

variable [TopologicalSpace F] (χ : UnitaryAdditiveCharacter F)

/-- Exact radical compatibility with the published positive minus character. -/
theorem entrywiseCharacter_radical :
    (Whittaker.entrywiseCharacter χ.complex (n + 1 + 1)).comp radicalToUpperUnipotent =
      Mirabolic.theta χ n := by
  rw [Whittaker.entrywiseCharacter_eq_standardCharacter]
  exact (Mirabolic.theta_eq_standardCharacter_comp χ n).symm

end Characters

section Topology

variable [TopologicalSpace F]

theorem continuous_upperProjection :
    Continuous (upperProjection (n := n) (F := F)) :=
  (continuous_projection.comp continuous_subtype_val).subtype_mk _

theorem continuous_upperLevi :
    Continuous (upperLevi (n := n) (F := F)) :=
  (continuous_levi.comp continuous_subtype_val).subtype_mk _

theorem continuous_leviUpper :
    Continuous (leviUpper (n := n) (F := F)) :=
  upperUnipotentContinuousEquiv.continuous.comp continuous_upperLevi

/-- The canonical copy preserves the inherited subgroup topologies. -/
def upperLeviContinuousEquiv :
    GeneralLinear.upperUnipotent n F ≃ₜ* upperLeviSubgroup n F where
  toMulEquiv := upperLeviEquiv
  continuous_toFun := (continuous_levi.comp continuous_subtype_val).subtype_mk _
  continuous_invFun :=
    ((continuous_projection.comp continuous_subtype_val).subtype_mk _)

/-- Both levels of subgroup copies preserve their actual topologies. -/
def successorUpperContinuousEquiv :
    GeneralLinear.upperUnipotent (n + 1) F ≃ₜ* successorUpperSubgroup n F where
  toMulEquiv := successorUpperEquiv
  continuous_toFun :=
    ((continuous_levi.comp continuous_subtype_val).subtype_mk _).subtype_mk _
  continuous_invFun :=
    ((continuous_projection.comp
      (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk _)

end Topology

/-- Every full upper-unipotent determinant is one, also at rank zero. -/
theorem determinant_upper (u : GeneralLinear.upperUnipotent n F) :
    GeneralLinear.determinant u.val = 1 := by
  apply Units.ext
  change Matrix.det u.val.val = 1
  rw [Matrix.det_of_isUpperTriangular u.property.1]
  simp only [UpperUnipotent.entry_diag, Finset.prod_const_one]

section Padic

variable {p : ℕ} [Fact p.Prime] {K : PadicField.{uF} p} (T : K.TopologicalData)

/-- The residue-normalized determinant norm is trivial on every full upper group. -/
theorem determinantNorm_upper (u : GeneralLinear.upperUnipotent n K.Carrier) :
    T.determinantNorm n u.val = 1 := by
  change T.normalizedAbsUnits (GeneralLinear.determinant u.val) = 1
  rw [determinant_upper, map_one]

/-- All determinant powers, in particular the inverse half, are trivial there. -/
theorem realPowerCharacter_upper (s : ℝ)
    (u : GeneralLinear.upperUnipotent n K.Carrier) :
    realPowerCharacter (T.determinantNorm n) s u.val = 1 := by
  apply ker_le_realPowerCharacter_ker
  exact determinantNorm_upper T u

/-- The exact determinant character used on the smaller mirabolic by `Φ⁻`
is trivial on its full upper-unipotent subgroup. -/
theorem realPowerCharacter_mirabolicUpper (s : ℝ)
    (u : Mirabolic.upperUnipotent n K.Carrier) :
    realPowerCharacter ((T.determinantNorm (n + 1)).comp (mirabolic n K.Carrier).subtype)
      s u.val = 1 := by
  apply ker_le_realPowerCharacter_ker
  exact determinantNorm_upper T (upperUnipotentEquiv u)

end Padic

end Langlands.Derivative.TopLocalization
