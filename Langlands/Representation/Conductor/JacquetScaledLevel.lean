import Langlands.Representation.Conductor.JacquetLevelInvariance

/-! # The source's scaled Jacquet group and the actual natural-number level -/

noncomputable section

namespace Langlands.Conductor

open Matrix Langlands.GeneralLinear

universe uF uΓ uK uV

variable {F : Type uF} [Field F] {n : ℕ}

private theorem dilation_conjugate_entry (q : Fˣ)
    (g : Langlands.GeneralLinear (n + 1) F) (i j : Fin (n + 1)) :
    (jacquetRowDilation n q * g * (jacquetRowDilation n q)⁻¹).val i j =
      (if i = Fin.last n then (q : F) else 1) * g.val i j *
        (if j = Fin.last n then ((q⁻¹ : Fˣ) : F) else 1) := by
  change (Matrix.diagonal _ * g.val * Matrix.diagonal _ :
    Matrix (Fin (n + 1)) (Fin (n + 1)) F) i j = _
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]

private theorem dilation_conjugate_mem_opposite (q : Fˣ)
    (g : Langlands.GeneralLinear (n + 1) F) (hg : g ∈ oppositeMirabolic n F) :
    jacquetRowDilation n q * g * (jacquetRowDilation n q)⁻¹ ∈
      oppositeMirabolic n F := by
  intro i
  rw [dilation_conjugate_entry, hg i]
  by_cases hi : i = Fin.last n <;> simp [hi]

private theorem dilation_conjugate_map_entries (O : Subring F) (I : Ideal O)
    (q : Fˣ) (hI : ∀ x ∈ I, (q : F) * (x : F) ∈ O)
    (g : Langlands.GeneralLinear (n + 1) O) (hg : g ∈ integralCongruence n I)
    (hop : GeneralLinearGroup.map O.subtype g ∈ oppositeMirabolic n F) :
    ∀ i j,
      (jacquetRowDilation n q * GeneralLinearGroup.map O.subtype g *
        (jacquetRowDilation n q)⁻¹).val i j ∈ O := by
  intro i j
  by_cases hj : j = Fin.last n
  · subst j
    have he := dilation_conjugate_mem_opposite q _ hop i
    rw [he]
    split_ifs <;> simp
  · rw [dilation_conjugate_entry]
    by_cases hi : i = Fin.last n
    · subst i
      simp only [ite_true, ite_eq_right hj, mul_one, GeneralLinearGroup.map_apply]
      apply hI
      have he := (mem_integralCongruence n I g).1 hg j
      simpa only [Matrix.one_apply, Ne.symm hj, ite_false, sub_zero] using he
    · simp only [ite_eq_right hi, ite_eq_right hj, one_mul, mul_one,
        GeneralLinearGroup.map_apply]
      change (g i j : F) ∈ O
      exact (g i j).property

/-- Every congruent opposite mirabolic lies in the source's scaled group when
multiplication by the scale sends the ideal into the integer ring. -/
theorem congruent_opposite_le_scaledOpposite (O : Subring F) (I : Ideal O)
    (q : Fˣ) (hI : ∀ x ∈ I, (q : F) * (x : F) ∈ O) :
    congruenceSubgroup O n I ⊓ oppositeMirabolic n F ≤
      scaledOppositeJacquetMirabolic O n q := by
  rintro _ ⟨⟨g, hg, rfl⟩, hop⟩
  change jacquetRowDilation n q * GeneralLinearGroup.map O.subtype g *
    (jacquetRowDilation n q)⁻¹ ∈ integralSubgroup O n ⊓ oppositeMirabolic n F
  refine ⟨(mem_integralSubgroup O n _).2 ⟨?_, ?_⟩,
    dilation_conjugate_mem_opposite q _ hop⟩
  · exact dilation_conjugate_map_entries O I q hI g hg hop
  · have hi := dilation_conjugate_map_entries O I q hI g⁻¹
      ((integralCongruence n I).inv_mem hg)
      (by simpa only [map_inv] using (oppositeMirabolic n F).inv_mem hop)
    simpa only [_root_.mul_inv_rev, inv_inv, mul_assoc, map_inv] using hi

section Uniformizer

variable {Γ₀ : Type uΓ} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation F Γ₀)

/-- The given Iwasawa uniformizer regarded as an element of its integer ring. -/
def jacquetUniformizerInteger (ϖ : Fˣ) (hϖ : Iwasawa.IsUniformizingElement v ϖ) :
    v.integer :=
  ⟨ϖ, hϖ.1.le⟩

private theorem valuation_lt_one_iff_le_uniformizer {ϖ : Fˣ}
    (hϖ : Iwasawa.IsUniformizingElement v ϖ) (x : F) :
    v x < 1 ↔ v x ≤ v (ϖ : F) := by
  refine ⟨fun hx => ?_, fun hx => hx.trans_lt hϖ.1⟩
  by_cases hx0 : x = 0
  · simp only [hx0, map_zero]
    exact zero_le
  obtain ⟨m, hm⟩ := hϖ.2 x hx0
  have hanti := zpow_right_strictAnti₀ (Iwasawa.valuation_pos v ϖ) hϖ.1
  rw [hm] at hx ⊢
  have hmpos : (0 : ℤ) < m := by
    rw [← zpow_zero (v (ϖ : F))] at hx
    exact hanti.lt_iff_gt.mp hx
  calc v (ϖ : F) ^ m ≤ v (ϖ : F) ^ (1 : ℤ) := hanti.antitone (by omega)
    _ = v (ϖ : F) := zpow_one _

/-- An Iwasawa uniformizing element generates the actual maximal ideal. -/
theorem maximalIdeal_eq_span_jacquetUniformizer (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement v ϖ) :
    IsLocalRing.maximalIdeal v.integer = Ideal.span {jacquetUniformizerInteger v ϖ hϖ} := by
  ext x
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    Valuation.Integer.not_isUnit_iff_valuation_lt_one,
    Ideal.mem_span_singleton, (Valuation.integer.integers v).dvd_iff_le]
  exact valuation_lt_one_iff_le_uniformizer v hϖ x

/-- Powers of the actual maximal ideal are generated by the same natural power
of the supplied uniformizer, including exponent zero. -/
theorem maximalIdeal_pow_eq_span_jacquetUniformizer (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement v ϖ) (a : ℕ) :
    IsLocalRing.maximalIdeal v.integer ^ a =
      Ideal.span {jacquetUniformizerInteger v ϖ hϖ ^ a} := by
  rw [maximalIdeal_eq_span_jacquetUniformizer v ϖ hϖ, Ideal.span_singleton_pow]

/-- Multiplication by `ϖ^(-a)` makes every element of the actual level ideal
integral. -/
theorem uniformizer_neg_pow_mul_mem_integer (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement v ϖ) (a : ℕ)
    (x : v.integer) (hx : x ∈ IsLocalRing.maximalIdeal v.integer ^ a) :
    ((ϖ ^ (-(a : ℤ)) : Fˣ) : F) * (x : F) ∈ v.integer := by
  rw [maximalIdeal_pow_eq_span_jacquetUniformizer v ϖ hϖ a,
    Ideal.mem_span_singleton] at hx
  obtain ⟨y, hy⟩ := hx
  have he := congrArg (fun z : v.integer => (z : F)) hy
  change (x : F) = (ϖ : F) ^ a * (y : F) at he
  rw [he]
  simpa only [zpow_neg, zpow_natCast, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val,
    ← mul_assoc, inv_mul_cancel₀ (pow_ne_zero a ϖ.ne_zero), one_mul] using y.property

end Uniformizer

/-- The actual opposite level subgroup is contained in the scaled group with
the source convention `q = ϖ^(-a)`. -/
theorem level_opposite_le_scaledOpposite [ValuativeRel F] (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation F) ϖ) (a : ℕ) :
    levelSubgroup F n a ⊓ oppositeMirabolic n F ≤
      scaledOppositeJacquetMirabolic (ValuativeRel.valuation F).integer n
        (ϖ ^ (-(a : ℤ))) :=
  congruent_opposite_le_scaledOpposite _ _ _ (uniformizer_neg_pow_mul_mem_integer _ ϖ hϖ a)

/-- The two source groups contain the actual natural-number level they generate. -/
theorem levelSubgroup_le_jacquetGenerated [ValuativeRel F] (hn : 0 < n) (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation F) ϖ) (a : ℕ) :
    levelSubgroup F n a ≤
      jacquetNegativeGenerated (ValuativeRel.valuation F).integer n
        (ϖ ^ (-(a : ℤ))) := by
  change congruenceSubgroup (ValuativeRel.valuation F).integer n
    (IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer ^ a) ≤ _
  rw [← fieldJacquetMirabolic_sup_congruent_opposite _ hn]
  exact sup_le_sup_left (level_opposite_le_scaledOpposite ϖ hϖ a) _

section Representation

variable [ValuativeRel F] {K : Type uK} [CommRing K]
  {V : Type uV} [AddCommGroup V] [Module K V]
  (π : Representation K (Langlands.GeneralLinear (n + 1) F) V)

/-- Both source invariances imply membership in the unchanged level-fixed
submodule on the original representation carrier. -/
theorem mem_levelFixedVectors_of_scaled_jacquet_invariant (hn : 0 < n) (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation F) ϖ) (a : ℕ)
    (x : V)
    (hP : x ∈ fixedVectors π
      (fieldJacquetMirabolic (ValuativeRel.valuation F).integer n))
    (hQ : x ∈ fixedVectors π
      (scaledOppositeJacquetMirabolic (ValuativeRel.valuation F).integer n
        (ϖ ^ (-(a : ℤ))))) :
    x ∈ levelFixedVectors π a := by
  rw [← jacquetInvariantSpace_eq_levelFixedVectors π hn a]
  exact ⟨hP, fun h => hQ ⟨h.val, level_opposite_le_scaledOpposite ϖ hϖ a h.property⟩⟩

end Representation

/-- The source's two right invariances imply right invariance under every
element of the actual natural-number level subgroup. -/
theorem right_level_invariant_of_scaled_jacquet_invariant [ValuativeRel F]
    (hn : 0 < n) (ϖ : Fˣ)
    (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation F) ϖ) (a : ℕ)
    (f : Langlands.GeneralLinear (n + 1) F → ℂ)
    (hP : ∀ h ∈ fieldJacquetMirabolic (ValuativeRel.valuation F).integer n,
      ∀ g, f (g * h) = f g)
    (hQ : ∀ h ∈ scaledOppositeJacquetMirabolic (ValuativeRel.valuation F).integer n
      (ϖ ^ (-(a : ℤ))), ∀ g, f (g * h) = f g) :
    ∀ h ∈ levelSubgroup F n a, ∀ g, f (g * h) = f g := by
  have hf := mem_levelFixedVectors_of_scaled_jacquet_invariant
    (Langlands.Whittaker.rightTranslation ℂ (Langlands.GeneralLinear (n + 1) F))
    hn ϖ hϖ a f (fun h => funext (hP h h.property))
      (fun h => funext (hQ h h.property))
  intro h hh g
  exact congrFun ((mem_levelFixedVectors _ a f).1 hf h hh) g

section Whittaker

variable [ValuativeRel F] [ValuativeRel.IsRankLeOne F] [TopologicalSpace F]
  (ψ : Langlands.HarmonicAnalysis.UnitaryAdditiveCharacter F)

/-- A nonzero standard Whittaker function with both source invariances has a
nonnegative scale exponent and is right invariant under its actual natural level. -/
theorem right_level_toNat_invariant_of_uniformizer_jacquet_invariant (hn : 0 < n)
    (ϖ : Fˣ) (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation F) ϖ) (m : ℤ)
    (W : (Langlands.Whittaker.equivariantFunctions (upperUnipotent (n + 1) F)
      (Langlands.Whittaker.standardCharacter ψ n)).toSubmodule) (hW : W ≠ 0)
    (hP : ∀ h ∈ fieldJacquetMirabolic (ValuativeRel.valuation F).integer n,
      ∀ g, W.val (g * h) = W.val g)
    (hQ : ∀ h ∈ scaledOppositeJacquetMirabolic (ValuativeRel.valuation F).integer n
      (ϖ ^ (-m)), ∀ g, W.val (g * h) = W.val g) :
    0 ≤ m ∧ ∀ h ∈ levelSubgroup F n m.toNat, ∀ g, W.val (g * h) = W.val g := by
  have hm := nonneg_of_uniformizer_jacquet_invariant ψ hn ϖ hϖ m W hW hP hQ
  refine ⟨hm, right_level_invariant_of_scaled_jacquet_invariant hn ϖ hϖ m.toNat
    W.val hP ?_⟩
  simpa only [Int.toNat_of_nonneg hm] using hQ

end Whittaker

end Langlands.Conductor
