import Langlands.Representation.Conductor.Congruence
import Langlands.Group.GL.MirabolicGeneration
import Langlands.Group.GL.OppositeRootNonsolvable
import Mathlib.GroupTheory.ArchimedeanDensely
import Langlands.Representation.Whittaker.GeneralLinear

/-! # Elementary generation at a negative Jacquet level -/

noncomputable section

namespace Langlands.Conductor

open Matrix Langlands.GeneralLinear
open Langlands.GeneralLinear.OppositeRootNonsolvable

universe uF

variable {F : Type uF} [Field F] {n : ℕ}

/-- The diagonal matrix with final entry `q` and all earlier entries `1`. -/
def jacquetRowDilation (n : ℕ) (q : Fˣ) : Langlands.GeneralLinear (n + 1) F where
  val := Matrix.diagonal (fun i => if i = Fin.last n then (q : F) else 1)
  inv := Matrix.diagonal (fun i => if i = Fin.last n then ((q⁻¹ : Fˣ) : F) else 1)
  val_inv := by
    rw [Matrix.diagonal_mul_diagonal]
    ext i j
    by_cases hi : i = Fin.last n <;> simp [Matrix.diagonal_apply, Matrix.one_apply, hi]
  inv_val := by
    rw [Matrix.diagonal_mul_diagonal]
    ext i j
    by_cases hi : i = Fin.last n <;> simp [Matrix.diagonal_apply, Matrix.one_apply, hi]

/-- The field image of the integral last-row mirabolic, namely JPSS's `H(0)`. -/
def fieldJacquetMirabolic (O : Subring F) (n : ℕ) :
    Subgroup (Langlands.GeneralLinear (n + 1) F) :=
  integralSubgroup O n ⊓ mirabolic n F

/-- The opposite Jacquet group with lower coordinates in `q⁻¹ O`.
Conjugating by `diag(1,...,1,q)` makes it integral. -/
def scaledOppositeJacquetMirabolic (O : Subring F) (n : ℕ) (q : Fˣ) :
    Subgroup (Langlands.GeneralLinear (n + 1) F) :=
  (integralSubgroup O n ⊓ oppositeMirabolic n F).comap
    (MulAut.conj (jacquetRowDilation n q)).toMonoidHom

/-- The subgroup generated by the two concrete Jacquet mirabolics. -/
def jacquetNegativeGenerated (O : Subring F) (n : ℕ) (q : Fˣ) :
    Subgroup (Langlands.GeneralLinear (n + 1) F) :=
  fieldJacquetMirabolic O n ⊔ scaledOppositeJacquetMirabolic O n q

private theorem transvection_integral {O : Subring F} {k : ℕ}
    (i j : Fin (k + 1)) (hij : i ≠ j) {c : F} (hc : c ∈ O) :
    transvectionUnit i j hij c ∈ integralSubgroup O k := by
  apply (mem_integralSubgroup O k _).2
  constructor
  · intro r s
    change (Matrix.transvection i j c) r s ∈ O
    simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply,
      Matrix.single_apply]
    split_ifs <;> simp_all
  · intro r s
    rw [transvection_inv]
    change (Matrix.transvection i j (-c)) r s ∈ O
    simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply,
      Matrix.single_apply]
    split_ifs <;> simp_all

private theorem upperRoot_mem_fieldJacquetMirabolic {O : Subring F}
    (i : Fin (n + 1)) (hi : i ≠ Fin.last n) {c : F} (hc : c ∈ O) :
    transvectionUnit i (Fin.last n) hi c ∈ fieldJacquetMirabolic O n := by
  refine ⟨transvection_integral _ _ hi hc, ?_⟩
  intro j
  simp [transvectionUnit, Matrix.transvection, Matrix.one_apply, hi, eq_comm]

private theorem dilation_conjugate_lowerRoot (q : Fˣ)
    (i : Fin (n + 1)) (hi : i ≠ Fin.last n) (c : F) :
    jacquetRowDilation n q * transvectionUnit (Fin.last n) i hi.symm c *
        (jacquetRowDilation n q)⁻¹ =
      transvectionUnit (Fin.last n) i hi.symm ((q : F) * c) := by
  apply Units.ext
  change (Matrix.diagonal _ * Matrix.transvection _ _ _ * Matrix.diagonal _) =
    Matrix.transvection (Fin.last n) i ((q : F) * c)
  ext r s
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
  by_cases hr : r = Fin.last n <;> by_cases hs : s = Fin.last n <;>
    simp_all [Matrix.transvection, Matrix.single_apply, Matrix.one_apply, eq_comm]

private theorem lowerRoot_mem_scaledOpposite {O : Subring F} (q : Fˣ)
    (i : Fin (n + 1)) (hi : i ≠ Fin.last n) {c : F} (hc : (q : F) * c ∈ O) :
    transvectionUnit (Fin.last n) i hi.symm c ∈ scaledOppositeJacquetMirabolic O n q := by
  change jacquetRowDilation n q * transvectionUnit (Fin.last n) i hi.symm c *
    (jacquetRowDilation n q)⁻¹ ∈ integralSubgroup O n ⊓ oppositeMirabolic n F
  rw [dilation_conjugate_lowerRoot q i hi c]
  refine ⟨transvection_integral _ _ hi.symm hc, ?_⟩
  intro j
  simp [transvectionUnit, Matrix.transvection, Matrix.one_apply, hi, eq_comm]

/-- A root diagonal propagates membership from a small coefficient to a large one. -/
private theorem root_mem_of_scaled_mem
    (H : Subgroup (Langlands.GeneralLinear (n + 1) F))
    (i j : Fin (n + 1)) (hij : i ≠ j) (q : Fˣ)
    (hd : rootDiagonal i j hij (q : F) ∈ H) (c : F)
    (hc : transvectionUnit i j hij ((q : F) * q * c) ∈ H) :
    transvectionUnit i j hij c ∈ H := by
  have he := rootDiagonal_mul_transvection i j hij (q : F) c q.ne_zero
  have hm := H.mul_mem (H.mul_mem (H.inv_mem hd) hc) hd
  rw [mul_assoc, ← he, inv_mul_cancel_left] at hm
  exact hm

private theorem root_mem_of_power_scaled_mem
    (H : Subgroup (Langlands.GeneralLinear (n + 1) F))
    (i j : Fin (n + 1)) (hij : i ≠ j) (q : Fˣ)
    (hd : rootDiagonal i j hij (q : F) ∈ H) (c : F) (k : ℕ)
    (hc : transvectionUnit i j hij (((q : F) * q) ^ k * c) ∈ H) :
    transvectionUnit i j hij c ∈ H := by
  induction k with
  | zero => simpa using hc
  | succ k ih =>
    apply ih
    apply root_mem_of_scaled_mem H i j hij q hd (((q : F) * q) ^ k * c)
    convert hc using 1
    congr 1
    ring

/-- Small powers make any coefficient integral in a rank-one valued field. -/
theorem exists_integral_power_multiple [ValuativeRel F] [ValuativeRel.IsRankLeOne F]
    (q : Fˣ) (hq : ValuativeRel.valuation F (q : F) < 1) (c : F) :
    ∃ k : ℕ, (((q : F) * q) ^ k * c) ∈ (ValuativeRel.valuation F).integer := by
  let v := ValuativeRel.valuation F
  let : MulArchimedean (ValuativeRel.ValueGroupWithZero F) :=
    ValuativeRel.isRankLeOne_iff_mulArchimedean.mp inferInstance
  by_cases hc : c = 0
  · exact ⟨0, by simp [hc]⟩
  have hqq : v ((q : F) * q) < 1 := by
    rw [map_mul]
    exact (mul_le_of_le_one_right zero_le hq.le).trans_lt hq
  obtain ⟨k, hk⟩ := exists_pow_lt₀ hqq (Units.mk0 (v c) (by simpa [v] using hc))⁻¹
  refine ⟨k, ?_⟩
  change v (((q : F) * q) ^ k * c) ≤ 1
  rw [map_mul, map_pow]
  have hc0 : 0 < v c := lt_of_le_of_ne zero_le (Ne.symm (by simpa [v] using hc))
  apply le_of_lt
  simpa [hc0.ne'] using mul_lt_mul_of_pos_right hk hc0


/-- Every final-column root subgroup lies in the concrete negative-level group. -/
theorem upperRoot_mem_jacquetNegativeGenerated [ValuativeRel F]
    [ValuativeRel.IsRankLeOne F] (q : Fˣ)
    (hq : ValuativeRel.valuation F (q : F) < 1)
    (i : Fin (n + 1)) (hi : i ≠ Fin.last n) (c : F) :
    transvectionUnit i (Fin.last n) hi c ∈
      jacquetNegativeGenerated (ValuativeRel.valuation F).integer n q := by
  let O := (ValuativeRel.valuation F).integer
  let H := jacquetNegativeGenerated O n q
  have hqO : (q : F) ∈ O := hq.le
  have hU (a : F) (ha : a ∈ O) : transvectionUnit i (Fin.last n) hi a ∈ H :=
    (show fieldJacquetMirabolic O n ≤ H from le_sup_left)
      (upperRoot_mem_fieldJacquetMirabolic i hi ha)
  have hL (a : F) (ha : (q : F) * a ∈ O) :
      transvectionUnit (Fin.last n) i hi.symm a ∈ H :=
    (show scaledOppositeJacquetMirabolic O n q ≤ H from le_sup_right)
      (lowerRoot_mem_scaledOpposite q i hi ha)
  have hwq : rootWeyl i (Fin.last n) hi (q : F) ∈ H := by
    apply H.mul_mem (H.mul_mem (hU _ hqO) (hL _ ?_)) (hU _ hqO)
    simp
  have hwm : rootWeyl i (Fin.last n) hi (-1 : F) ∈ H := by
    apply H.mul_mem (H.mul_mem (hU _ (O.neg_mem O.one_mem)) (hL _ ?_))
      (hU _ (O.neg_mem O.one_mem))
    simpa using hqO
  have hd : rootDiagonal i (Fin.last n) hi (q : F) ∈ H := H.mul_mem hwq hwm
  obtain ⟨k, hk⟩ := exists_integral_power_multiple q hq c
  exact root_mem_of_power_scaled_mem H i (Fin.last n) hi q hd c k (hU _ hk)

/-- Every final-row root subgroup lies in the concrete negative-level group. -/
theorem lowerRoot_mem_jacquetNegativeGenerated [ValuativeRel F]
    [ValuativeRel.IsRankLeOne F] (q : Fˣ)
    (hq : ValuativeRel.valuation F (q : F) < 1)
    (i : Fin (n + 1)) (hi : i ≠ Fin.last n) (c : F) :
    transvectionUnit (Fin.last n) i hi.symm c ∈
      jacquetNegativeGenerated (ValuativeRel.valuation F).integer n q := by
  let O := (ValuativeRel.valuation F).integer
  let H := jacquetNegativeGenerated O n q
  have hqO : (q : F) ∈ O := hq.le
  have hU (a : F) : transvectionUnit i (Fin.last n) hi a ∈ H :=
    upperRoot_mem_jacquetNegativeGenerated q hq i hi a
  have hL (a : F) (ha : a ∈ O) : transvectionUnit (Fin.last n) i hi.symm a ∈ H :=
    (show scaledOppositeJacquetMirabolic O n q ≤ H from le_sup_right)
      (lowerRoot_mem_scaledOpposite q i hi (O.mul_mem hqO ha))
  have hwq : rootWeyl (Fin.last n) i hi.symm (q : F) ∈ H :=
    H.mul_mem (H.mul_mem (hL _ hqO) (hU _)) (hL _ hqO)
  have hwm : rootWeyl (Fin.last n) i hi.symm (-1 : F) ∈ H :=
    H.mul_mem (H.mul_mem (hL _ (O.neg_mem O.one_mem)) (hU _))
      (hL _ (O.neg_mem O.one_mem))
  have hd : rootDiagonal (Fin.last n) i hi.symm (q : F) ∈ H := H.mul_mem hwq hwm
  obtain ⟨k, hk⟩ := exists_integral_power_multiple q hq c
  exact root_mem_of_power_scaled_mem H (Fin.last n) i hi.symm q hd c k (hL _ hk)

private theorem transvection_commutator_factor (i j l : Fin (n + 1))
    (hij : i ≠ j) (hil : i ≠ l) (hlj : l ≠ j) (c : F) :
    transvectionUnit i l hil c * transvectionUnit l j hlj 1 *
        transvectionUnit i l hil (-c) * transvectionUnit l j hlj (-1) =
      transvectionUnit i j hij c := by
  apply Units.ext
  change ((Matrix.transvection i l c * Matrix.transvection l j 1) *
    Matrix.transvection i l (-c)) * Matrix.transvection l j (-1) =
      Matrix.transvection i j c
  simp only [Matrix.transvection, Matrix.add_mul, Matrix.mul_add,
    Matrix.one_mul, Matrix.mul_one, Matrix.single_mul_single_same,
    Matrix.single_mul_single_of_ne _ _ _ _ hil.symm,
    Matrix.single_mul_single_of_ne _ _ _ _ hlj.symm,
    Matrix.single_mul_single_of_ne _ _ _ _ hij.symm, add_zero]
  ext r s
  simp only [Matrix.add_apply, Matrix.single_apply]
  split_ifs <;> ring

/-- All elementary root subgroups are generated by the two concrete Jacquet
mirabolics at a negative Jacquet level. This does not assert full GL generation. -/
theorem transvection_mem_jacquetNegativeGenerated [ValuativeRel F]
    [ValuativeRel.IsRankLeOne F] (q : Fˣ)
    (hq : ValuativeRel.valuation F (q : F) < 1)
    (i j : Fin (n + 1)) (hij : i ≠ j) (c : F) :
    transvectionUnit i j hij c ∈
      jacquetNegativeGenerated (ValuativeRel.valuation F).integer n q := by
  by_cases hi : i = Fin.last n
  · subst i
    exact lowerRoot_mem_jacquetNegativeGenerated q hq j hij.symm c
  by_cases hj : j = Fin.last n
  · subst j
    exact upperRoot_mem_jacquetNegativeGenerated q hq i hij c
  rw [← transvection_commutator_factor i j (Fin.last n) hij hi (Ne.symm hj) c]
  exact mul_mem (mul_mem (mul_mem
    (upperRoot_mem_jacquetNegativeGenerated q hq i hi c)
    (lowerRoot_mem_jacquetNegativeGenerated q hq j hj 1))
    (upperRoot_mem_jacquetNegativeGenerated q hq i hi (-c)))
    (lowerRoot_mem_jacquetNegativeGenerated q hq j hj (-1))


private theorem det_ker_le_of_transvections (hn : 0 < n)
    (H : Subgroup (Langlands.GeneralLinear (n + 1) F))
    (hroot : ∀ (i j : Fin (n + 1)) (hij : i ≠ j) (c : F),
      transvectionUnit i j hij c ∈ H) :
    (Matrix.GeneralLinearGroup.det : Langlands.GeneralLinear (n + 1) F →* Fˣ).ker ≤ H := by
  let : Nontrivial (Fin (n + 1)) := Fin.nontrivial_iff_two_le.mpr (by omega)
  rw [← Matrix.SpecialLinearGroup.range_toGL_eq_ker_det]
  rintro _ ⟨g, rfl⟩
  apply Matrix.SpecialLinearGroup.diagonal_transvection_induction'
    (fun s => Matrix.SpecialLinearGroup.toGL s ∈ H) g
  · intro i j hij c hc
    have he : Matrix.SpecialLinearGroup.toGL (Matrix.SpecialLinearGroup.diag2n hij c hc) =
        rootDiagonal i j hij c := by
      apply Units.ext
      exact (rootDiagonal_val i j hij c hc).symm
    rw [he]
    exact rootDiagonal_mem H i j hij (hroot i j hij) (hroot j i hij.symm) c
  · intro i j hij c
    have he : Matrix.SpecialLinearGroup.toGL (Matrix.SpecialLinearGroup.transvection hij c) =
        transvectionUnit i j hij c := Units.ext rfl
    rw [he]
    exact hroot i j hij c
  · intro a b ha hb
    simpa only [map_mul] using H.mul_mem ha hb

/-- The generated negative-level subgroup contains the actual determinant-one subgroup. -/
theorem det_ker_le_jacquetNegativeGenerated [ValuativeRel F]
    [ValuativeRel.IsRankLeOne F] (hn : 0 < n) (q : Fˣ)
    (hq : ValuativeRel.valuation F (q : F) < 1) :
    (Matrix.GeneralLinearGroup.det : Langlands.GeneralLinear (n + 1) F →* Fˣ).ker ≤
      jacquetNegativeGenerated (ValuativeRel.valuation F).integer n q :=
  det_ker_le_of_transvections hn _ (transvection_mem_jacquetNegativeGenerated q hq)

private def adjacentRoot (i : Fin n) (c : F) : upperUnipotent (n + 1) F :=
  ⟨transvectionUnit i.castSucc i.succ (ne_of_lt i.castSucc_lt_succ) c, by
    constructor
    · intro r s hsr
      change Matrix.transvection i.castSucc i.succ c r s = 0
      have hrs : r ≠ s := ne_of_gt hsr
      have hroot : ¬ (i.castSucc = r ∧ i.succ = s) := by
        rintro ⟨rfl, rfl⟩
        exact (not_lt_of_ge i.castSucc_lt_succ.le) hsr
      simp [Matrix.transvection, hrs, hroot]
    · intro r
      change Matrix.transvection i.castSucc i.succ c r r = 1
      simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, ite_true,
        Matrix.single_apply]
      split_ifs with h
      · exact False.elim ((ne_of_lt i.castSucc_lt_succ) (h.1.trans h.2.symm))
      · simp⟩

private theorem adjacentRoot_character [TopologicalSpace F]
    (ψ : Langlands.HarmonicAnalysis.UnitaryAdditiveCharacter F) (i : Fin n) (c : F) :
    (Langlands.Whittaker.standardCharacter ψ n (adjacentRoot i c) : ℂ) = ψ.complex c := by
  rw [Langlands.Whittaker.standardCharacter_apply]
  congr 1
  change (∑ j : Fin n, Matrix.transvection i.castSucc i.succ c j.castSucc j.succ) = c
  have hentry (j : Fin n) :
      Matrix.transvection i.castSucc i.succ c j.castSucc j.succ =
        if j = i then c else 0 := by
    simp [Matrix.transvection, Matrix.single_apply, ne_of_lt j.castSucc_lt_succ, eq_comm]
  simp_rw [hentry]
  simp

/-- A standard Whittaker function invariant on the right under both concrete
negative-level Jacquet groups is zero in rank at least two. -/
theorem whittaker_eq_zero_of_negativeLevel_invariant [ValuativeRel F]
    [ValuativeRel.IsRankLeOne F] [TopologicalSpace F] (hn : 0 < n) (q : Fˣ)
    (hq : ValuativeRel.valuation F (q : F) < 1)
    (ψ : Langlands.HarmonicAnalysis.UnitaryAdditiveCharacter F)
    (W : (Langlands.Whittaker.equivariantFunctions (upperUnipotent (n + 1) F)
      (Langlands.Whittaker.standardCharacter ψ n)).toSubmodule)
    (hP : ∀ h ∈ fieldJacquetMirabolic (ValuativeRel.valuation F).integer n,
      ∀ g, W.val (g * h) = W.val g)
    (hQ : ∀ h ∈ scaledOppositeJacquetMirabolic (ValuativeRel.valuation F).integer n q,
      ∀ g, W.val (g * h) = W.val g) : W = 0 := by
  let S : Subgroup (Langlands.GeneralLinear (n + 1) F) :=
    { carrier := {h | ∀ g, W.val (g * h) = W.val g}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb g
        rw [← mul_assoc, hb, ha]
      inv_mem' := by
        intro a ha g
        have he := ha (g * a⁻¹)
        simpa only [inv_mul_cancel_right] using he.symm }
  have hgen : jacquetNegativeGenerated (ValuativeRel.valuation F).integer n q ≤ S :=
    sup_le hP hQ
  obtain ⟨c, hc⟩ : ∃ c : F, ψ.complex c ≠ 1 := by
    by_contra! h
    apply ψ.nontrivial
    ext x
    exact h x
  let i : Fin n := ⟨0, hn⟩
  let u := adjacentRoot i c
  have hdet : Matrix.GeneralLinearGroup.det u.val = 1 := by
    apply Units.ext
    exact Matrix.det_transvection_of_ne _ _ (ne_of_lt i.castSucc_lt_succ) c
  apply Subtype.ext
  funext g
  change W.val g = 0
  by_contra hg
  have hconj : g⁻¹ * u.val * g ∈
      (Matrix.GeneralLinearGroup.det : Langlands.GeneralLinear (n + 1) F →* Fˣ).ker := by
    change Matrix.GeneralLinearGroup.det (g⁻¹ * u.val * g) = 1
    simp only [map_mul, map_inv, hdet, mul_one, inv_mul_cancel]
  have hfix : W.val (u.val * g) = W.val g := by
    simpa only [mul_assoc, mul_inv_cancel_left] using
      (hgen (det_ker_le_jacquetNegativeGenerated hn q hq hconj)) g
  have he := W.property u g
  rw [hfix, adjacentRoot_character] at he
  exact hc (mul_right_cancel₀ hg (he.symm.trans (one_mul _).symm))

end Langlands.Conductor
