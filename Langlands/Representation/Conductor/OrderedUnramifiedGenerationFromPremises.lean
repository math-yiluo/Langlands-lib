/-!
# Jacquet's Lemma 3 from the classification, (8.4) and (9.3)

Over a nonarchimedean local field `F`, the three results of JPSS 1983, Section 9, give
`L(s, π × I(x)) = ∏_j L(s + t_j, π)` for norm-ordered `x`
(`lPolynomial_principalSeries_eq_prod`). The span of the corank-one integrals of
`π × I(x)` is the fractional ideal generated by this L-factor (JPSS 1983, Theorem (2.7)).
Since the span is stable under translation of both arguments, which multiplies the
integral by a power of `q^(-s)`, the L-factor itself is a finite sum of integrals: this
is Jacquet 2012, Lemma 3, in the form `OrderedUnramifiedCorankOneGenerationStatement`.
-/

noncomputable section

namespace Langlands.Conductor.OrderedUnramifiedTemperedType

open Langlands.GeneralLinear Langlands.Whittaker Langlands.HarmonicAnalysis
open Langlands.RankinSelberg MeasureTheory Polynomial QuotientIntegration
open Langlands.Conductor.UnramifiedPrincipalSeries Langlands.GeneralLinear.Iwasawa

universe uF uV uW

section Span

variable {F : Type uF} [Field F] [TopologicalSpace F] {n : ℕ}
  [MeasurableSpace (LeftUnipotentQuotient n F)]
  (ψ : UnitaryAdditiveCharacter F) (abv : AbsoluteValue F ℝ)
  (μ : Measure (LeftUnipotentQuotient n F))
  {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {W : Type uW} [AddCommGroup W] [Module ℂ W]
  (π : Representation ℂ (GeneralLinear ((n + 1) + 1) F) V)
  (ℓ : glFunctionals ψ (n + 1) π)
  (ρ : Representation ℂ (GeneralLinear (n + 1) F) W)
  (ℓ' : glInverseFunctionals ψ n ρ)

/-- `R` agrees on a right half-plane with a finite sum `∑_j Ψ(s, W_j, W'_j)` with `W_j`
in the model of `ℓ` and `W'_j` in the model of `ℓ'`. -/
def IsPairIntegralSpan (R : ℂ → ℂ) : Prop :=
  ∃ (k : ℕ) (Wf : Fin k → (coefficientModel π ℓ).toSubmodule)
    (Wf' : Fin k → (coefficientModel ρ ℓ').toSubmodule) (a : ℝ),
    ∀ s : ℂ, a < s.re → R s = ∑ j, corankOneIntegral ψ abv μ (Wf j).val (Wf' j).val s

variable {ψ abv μ π ℓ ρ ℓ'}

theorem IsPairIntegralSpan.zero : IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' (fun _ => 0) :=
  ⟨0, Fin.elim0, Fin.elim0, 0, fun _ _ => by simp⟩

theorem IsPairIntegralSpan.add {R R' : ℂ → ℂ}
    (hR : IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' R)
    (hR' : IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' R') :
    IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' (fun s => R s + R' s) := by
  obtain ⟨k, W, W', a, h⟩ := hR
  obtain ⟨k₂, W₂, W₂', a₂, h₂⟩ := hR'
  refine ⟨k + k₂, Fin.append W W₂, Fin.append W' W₂', max a a₂, fun s hs => ?_⟩
  show R s + R' s = _
  rw [h s (lt_of_le_of_lt (le_max_left _ _) hs), h₂ s (lt_of_le_of_lt (le_max_right _ _) hs),
    Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right]

theorem IsPairIntegralSpan.finset_sum {ι : Type*} (T : Finset ι) {R : ι → ℂ → ℂ}
    (hR : ∀ i ∈ T, IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' (R i)) :
    IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' (fun s => ∑ i ∈ T, R i s) := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa using IsPairIntegralSpan.zero
  | @insert i T hi ih =>
    simp only [Finset.sum_insert hi]
    exact (hR i (Finset.mem_insert_self i T)).add
      (ih fun j hj => hR j (Finset.mem_insert_of_mem hj))

theorem IsPairIntegralSpan.congr {R R' : ℂ → ℂ}
    (hR : IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' R) {b : ℝ}
    (hRR' : ∀ s : ℂ, b < s.re → R' s = R s) :
    IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ' R' := by
  obtain ⟨k, W, W', a, h⟩ := hR
  refine ⟨k, W, W', max a b, fun s hs => ?_⟩
  rw [hRR' s (lt_of_le_of_lt (le_max_right _ _) hs), h s (lt_of_le_of_lt (le_max_left _ _) hs)]

theorem IsPairIntegralSpan.smul (κ : ℂ) (w : (coefficientModel π ℓ).toSubmodule)
    (w' : (coefficientModel ρ ℓ').toSubmodule) :
    IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ'
      (fun s => κ * corankOneIntegral ψ abv μ w.val w'.val s) := by
  refine ⟨1, fun _ => κ • w, fun _ => w', 0, fun s _ => ?_⟩
  simp only [Finset.univ_unique, Finset.sum_singleton, SetLike.val_smul,
    corankOneIntegral_smul]

end Span

section Translation

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F] {n : ℕ}
  [MeasurableSpace (Langlands.GeneralLinear (n + 1) F)]
  [BorelSpace (Langlands.GeneralLinear (n + 1) F)]
  [MeasurableSpace (upperUnipotent (n + 1) F)] [BorelSpace (upperUnipotent (n + 1) F)]
  [MeasurableSpace (LeftUnipotentQuotient n F)] [MeasurableSpace (LeftUnipotentQuotient 0 F)]
  {q : ℕ} {ψ : UnitaryAdditiveCharacter F} {abv : AbsoluteValue F ℝ} {ϖ : Fˣ}
  {μ : Measure (LeftUnipotentQuotient n F)}
  {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {W : Type uW} [AddCommGroup W] [Module ℂ W]
  {π : Representation ℂ (GeneralLinear ((n + 1) + 1) F) V}
  {ℓ : glFunctionals ψ (n + 1) π}
  {ρ : Representation ℂ (GeneralLinear (n + 1) F) W}
  {ℓ' : glInverseFunctionals ψ n ρ}

/-- The diagonal element `diag(ϖ^m, 1, …, 1)`. -/
def cornerPower (ϖ : Fˣ) (m : ℤ) : GeneralLinear (n + 1) F :=
  Iwasawa.diagonalUnits (fun i : Fin (n + 1) => if i = 0 then ϖ ^ m else 1)

theorem abv_det_cornerPower_inv (h : IsJacquetNormalization q ψ abv ϖ μ) (m : ℤ) :
    abv (Matrix.det ((cornerPower (n := n) ϖ m)⁻¹ : GeneralLinear (n + 1) F).val) =
      (q : ℝ) ^ (-(-m)) := by
  have hdet : Matrix.det ((cornerPower (n := n) ϖ m)⁻¹ : GeneralLinear (n + 1) F).val =
      ((ϖ : F) ^ m)⁻¹ := by
    have h1 : Matrix.det ((cornerPower (n := n) ϖ m)⁻¹ : GeneralLinear (n + 1) F).val =
        (Matrix.det (cornerPower (n := n) ϖ m : GeneralLinear (n + 1) F).val)⁻¹ := by
      rw [Matrix.coe_units_inv, Matrix.det_nonsing_inv, Ring.inverse_eq_inv']
    rw [h1, cornerPower, Iwasawa.diagonalUnits_val, Matrix.det_diagonal]
    congr 1
    rw [Fin.prod_univ_succ]
    simp
  rw [hdet, map_inv₀, map_zpow₀, h.abv_uniformizer, neg_neg, inv_zpow, inv_inv]

/-- Right translation of both arguments by `diag(ϖ^(-m), 1, …, 1)` multiplies a corank-one
integral by `q^(-ms)` up to a constant, so a monomial times an integral is again an
integral of a pair in the two models. -/
theorem IsPairIntegralSpan.monomial (h : IsJacquetNormalization q ψ abv ϖ μ) (κ : ℂ) (m : ℤ)
    (w : (coefficientModel π ℓ).toSubmodule) (w' : (coefficientModel ρ ℓ').toSubmodule)
    (hconv : ∃ a : ℝ, ∀ s : ℂ, a < s.re → CorankOneConverges ψ abv μ w.val w'.val s) :
    IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ'
      (fun s => (κ * spectralPoint q s ^ m) * corankOneIntegral ψ abv μ w.val w'.val s) := by
  classical
  have := h.borel
  have hq : 0 < q := residueCardinality_pos h.residueCardinality
  set t : GeneralLinear (n + 1) F := cornerPower ϖ m
  let X₀ : (coefficientModel ρ ℓ').toSubmodule := modelRepresentation ρ ℓ' t⁻¹ w'
  let Wt : GeneralLinear (n + 1) F → (coefficientModel π ℓ).toSubmodule :=
    fun u => modelRepresentation π ℓ (rankInclusion 1 u⁻¹) w
  have hW' : ∀ g, w'.val.val g = ∑ u ∈ ({t} : Finset _), (fun _ => (1 : ℂ)) u *
      X₀.val.val (g * u) := by
    intro g
    simp only [Finset.sum_singleton, one_mul]
    change w'.val.val g = w'.val.val (g * t * t⁻¹)
    rw [mul_inv_cancel_right]
  have hWt : ∀ u g, (Wt u).val.val (rankInclusion 1 g) =
      w.val.val (rankInclusion 1 (g * u⁻¹)) := by
    intro u g
    change w.val.val (rankInclusion 1 g * rankInclusion 1 u⁻¹) = _
    rw [map_mul]
  obtain ⟨a, ha⟩ := hconv
  have hbase : ((abv (Matrix.det (t⁻¹ : GeneralLinear (n + 1) F).val) : ℝ) : ℂ) ≠ 0 := by
    rw [abv_det_cornerPower_inv h m]
    exact_mod_cast (zpow_pos (by exact_mod_cast hq : (0 : ℝ) < q) _).ne'
  have hdw0 : ∀ s : ℂ, determinantWeight abv t⁻¹ s ≠ 0 :=
    fun s hz => hbase ((Complex.cpow_eq_zero_iff _ _).mp hz).1
  have hdw : ∀ s : ℂ, determinantWeight abv t⁻¹ (s - 1 / 2) =
      determinantWeight abv t⁻¹ (-(1 / 2)) * spectralPoint q s ^ (-m) := by
    intro s
    rw [sub_eq_add_neg, determinantWeight_add,
      determinantWeight_eq_spectralPoint_zpow q hq abv _ (-m) (abv_det_cornerPower_inv h m) s,
      mul_comm]
  have hconvT : ∀ s : ℂ, a < s.re →
      ∀ u ∈ ({t} : Finset _), CorankOneConverges ψ abv μ (Wt u).val X₀.val s := by
    intro s hs u hu
    rw [Finset.mem_singleton] at hu
    subst hu
    have he := corankOneIntegrand_eq_sum_translate ψ abv w.val w'.val X₀.val {t}
      (fun _ => 1) hW' (fun u => (Wt u).val) hWt s
    have hint : Integrable (fun y => corankOneIntegrand ψ abv (Wt t).val X₀.val s
        (rightTranslate (upperUnipotent (n + 1) F) t y)) μ := by
      refine ((ha s hs).const_mul (determinantWeight abv t⁻¹ (s - 1 / 2))⁻¹).congr
        (Filter.Eventually.of_forall fun y => ?_)
      have hy := congrFun he y
      simp only [Finset.sum_singleton, one_mul] at hy
      change (determinantWeight abv t⁻¹ (s - 1 / 2))⁻¹ *
          corankOneIntegrand ψ abv w.val w'.val s y = _
      rw [hy, ← mul_assoc, inv_mul_cancel₀ (hdw0 _), one_mul]
    exact ((h.measure.right_invariant t).integrable_comp_emb
      (rightTranslate (upperUnipotent (n + 1) F) t).measurableEmbedding).mp hint
  refine (IsPairIntegralSpan.smul (κ * determinantWeight abv t⁻¹ (-(1 / 2))) (Wt t) X₀).congr
    (b := a) fun s hs => ?_
  rw [corankOneIntegral_eq_sum_translate ψ abv h.measure w.val w'.val X₀.val {t}
    (fun _ => 1) hW' (fun u => (Wt u).val) hWt s (hconvT s hs)]
  simp only [Finset.sum_singleton, one_mul]
  rw [hdw s, zpow_neg]
  have hz : spectralPoint q s ^ m ≠ 0 := zpow_ne_zero _ (spectralPoint_ne_zero_of_pos hq s)
  field_simp

/-- A Laurent polynomial in `q^(-s)` times an integral is a finite sum of integrals of
pairs in the two models. -/
theorem IsPairIntegralSpan.laurent (h : IsJacquetNormalization q ψ abv ϖ μ)
    (c : LaurentCoefficients)
    (w : (coefficientModel π ℓ).toSubmodule) (w' : (coefficientModel ρ ℓ').toSubmodule)
    (hconv : ∃ a : ℝ, ∀ s : ℂ, a < s.re → CorankOneConverges ψ abv μ w.val w'.val s) :
    IsPairIntegralSpan ψ abv μ π ℓ ρ ℓ'
      (fun s => laurentEval (spectralUnit (residueCardinality_pos h.residueCardinality) s) c *
        corankOneIntegral ψ abv μ w.val w'.val s) := by
  induction c using LaurentPolynomial.induction_on' with
  | add p r hp hr =>
    refine (hp.add hr).congr (b := 0) fun s _ => ?_
    rw [map_add, add_mul]
  | C_mul_T m a =>
    refine (IsPairIntegralSpan.monomial h a m w w' hconv).congr (b := 0) fun s _ => ?_
    rw [map_mul, laurentEval_C, laurentEval_T, coe_spectralUnit]

end Translation

section Evaluation

open Langlands.RankinSelberg.RationalEvaluation

/-- Evaluating `∑_i c_i R_i = P⁻¹` at a point where every `R_i` is regular. -/
theorem sum_laurentEval_mul_eval_mul_eq_one {N : ℕ} (c : Fin N → LaurentCoefficients)
    (R : Fin N → RationalFunctions) {P : ℂ[X]} (hP : P ≠ 0)
    (hsum : ∑ i, c i • R i = (algebraMap ℂ[X] RationalFunctions P)⁻¹) (z : ℂˣ)
    (hR : ∀ i, (R i).denom.eval (z : ℂ) ≠ 0) :
    (∑ i, laurentEval z (c i) * RatFunc.eval (RingHom.id ℂ) (z : ℂ) (R i)) *
      P.eval (z : ℂ) = 1 := by
  classical
  have hterm : ∀ i, RegularAt (c i • R i) (z : ℂ) ∧
      RatFunc.eval (RingHom.id ℂ) (z : ℂ) (c i • R i) =
        laurentEval z (c i) * RatFunc.eval (RingHom.id ℂ) (z : ℂ) (R i) := by
    intro i
    rw [Algebra.smul_def, algebraMap_laurent]
    have h1 : RegularAt (laurentToRatFunc (c i)) (z : ℂ) := laurentToRatFunc_regular z (c i)
    refine ⟨h1.mul (hR i), ?_⟩
    rw [eval_mul h1 (hR i), eval_laurentToRatFunc]
  have hpart : ∀ S : Finset (Fin N), RegularAt (∑ i ∈ S, c i • R i) (z : ℂ) ∧
      RatFunc.eval (RingHom.id ℂ) (z : ℂ) (∑ i ∈ S, c i • R i) =
        ∑ i ∈ S, laurentEval z (c i) * RatFunc.eval (RingHom.id ℂ) (z : ℂ) (R i) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      refine ⟨?_, by simp⟩
      simpa using (RegularAt.polynomial (z := (z : ℂ)) (0 : ℂ[X]))
    | @insert i S hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi]
      refine ⟨(hterm i).1.add ih.1, ?_⟩
      rw [eval_add (hterm i).1 ih.1, (hterm i).2, ih.2]
  obtain ⟨hreg, heval⟩ := hpart Finset.univ
  rw [← heval]
  exact eval_mul_eval_eq_one_of_eq_inv hsum hP hreg

end Evaluation

section PrincipalSeries

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {ϖ : Fˣ} (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation F) ϖ)
  (n : ℕ) {q : ℕ} (hq : IsResidueCardinality (F := F) q)

/-- The unramified principal series is of Whittaker type for the inverse character. -/
theorem principalSeries_isOfInverseWhittakerType (ψ : UnitaryAdditiveCharacter F)
    (x : Fin (n + 1) → ℂˣ) :
    IsOfWhittakerType n (inverseStandardCharacter ψ n) (principalSeries hϖ n hq x) := by
  have h1 := Langlands.AllField.RankinSelberg.normalizedProductWhittakerType F ψ n (n + 1)
    (fun _ => 0) (by simp) (Langlands.AllField.Conductor.UnramifiedPrincipalSeries.blocks hϖ n x)
    (fun i => Langlands.AllField.RankinSelberg.rankOneCharacter_isOfWhittakerType F ψ
      (Langlands.AllField.Conductor.UnramifiedPrincipalSeries.quasicharacter hϖ (x i)))
  have h2 := h1.of_equiv
    (Langlands.AllField.Conductor.UnramifiedPrincipalSeries.principalSeriesEquiv hϖ n hq x).symm
  exact (isOfWhittakerType_standard_iff_inverse ψ _).mp h2

end PrincipalSeries

end Langlands.Conductor.OrderedUnramifiedTemperedType

namespace Langlands.Conductor

open Langlands.GeneralLinear Langlands.Whittaker Langlands.HarmonicAnalysis
open Langlands.RankinSelberg MeasureTheory Polynomial
open Langlands.Conductor.UnramifiedPrincipalSeries

universe uF uV

/-- `OrderedUnramifiedCorankOneGenerationStatement` for one nonarchimedean local field `F`,
given by its instances: Jacquet 2012, Lemma 3, for norm-ordered parameters. -/
def OrderedUnramifiedCorankOneGenerationAt (F : Type uF) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] : Prop :=
  ∀ (n : ℕ)
    [MeasurableSpace (Langlands.GeneralLinear (n + 1) F)]
    [BorelSpace (Langlands.GeneralLinear (n + 1) F)]
    [MeasurableSpace (upperUnipotent (n + 1) F)] [BorelSpace (upperUnipotent (n + 1) F)]
    [MeasurableSpace (LeftUnipotentQuotient n F)] [MeasurableSpace (LeftUnipotentQuotient 0 F)]
    [MeasurableSpace (Langlands.GeneralLinear 1 F)] [BorelSpace (Langlands.GeneralLinear 1 F)]
    (q : ℕ) (ψ : UnitaryAdditiveCharacter F) (abv : AbsoluteValue F ℝ) (ϖ : Fˣ)
    (μ : Measure (LeftUnipotentQuotient n F)) (h : IsJacquetNormalization q ψ abv ϖ μ)
    {V : Type uV} [AddCommGroup V] [Module ℂ V]
    (π : Representation ℂ (Langlands.GeneralLinear ((n + 1) + 1) F) V),
    IsGeneric ψ (n + 1) π →
    ∀ ℓ : glFunctionals ψ (n + 1) π, ℓ.val ≠ 0 →
    ∀ P : ℂ[X], IsCharacterLPolynomial q ψ abv (rankOneQuotientHaar F) 1 π P →
    ∀ x : Fin (n + 1) → ℂˣ, Monotone (fun i => ‖(x i : ℂ)‖) →
    ∀ ℓ' : glInverseFunctionals ψ n
        (principalSeries h.uniformizer n h.residueCardinality x), ℓ'.val ≠ 0 →
      ∃ (k : ℕ) (W : Fin k → (coefficientModel π ℓ).toSubmodule)
        (W' : Fin k → (coefficientModel
          (principalSeries h.uniformizer n h.residueCardinality x) ℓ').toSubmodule) (a : ℝ),
        ∀ s : ℂ, a < s.re →
          (∑ j, corankOneIntegral ψ abv μ (W j).val (W' j).val s) *
            (∏ i, P.comp (C (x i : ℂ) * X)).eval (spectralPoint q s) = 1

/-- The general statement is the field-by-field statement for every field. -/
theorem orderedUnramifiedCorankOneGenerationStatement_iff :
    OrderedUnramifiedCorankOneGenerationStatement.{uF, uV} ↔
      ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
        [IsNonarchimedeanLocalField F], OrderedUnramifiedCorankOneGenerationAt.{uF, uV} F :=
  Iff.rfl

/-- The p-adic statement is the field-by-field statement for the canonical structures of
every p-adic field. -/
theorem padicOrderedUnramifiedCorankOneGenerationStatement_iff :
    PadicOrderedUnramifiedCorankOneGenerationStatement.{uF, uV} ↔
      ∀ (p : ℕ) [Fact p.Prime] (K : PadicField.{uF} p),
        letI := K.canonicalTopologicalData.topology
        letI := K.canonicalTopologicalData.valuativeRel
        letI := K.canonicalTopologicalData.localField
        OrderedUnramifiedCorankOneGenerationAt.{uF, uV} K.Carrier :=
  Iff.rfl

open Langlands.Conductor.OrderedUnramifiedTemperedType
open Langlands.AllField.RankinSelberg (GenericStandardModuleStatement TemperedPoleBoundStatement
  InducedTailLFactorAt)

set_option maxHeartbeats 1600000 in
/-- Jacquet 2012, Lemma 3, over one nonarchimedean local field `F`, from three results of
JPSS 1983, Section 9, over `F`: the classification of generic representations with the
identification of Whittaker models, the pole bound (8.4) and the tail divisibility
(9.3). -/
theorem orderedUnramifiedCorankOneGenerationAt_of_premises (F : Type uF) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hclass : GenericStandardModuleStatement.{uF, uV} F)
    (hpole : TemperedPoleBoundStatement.{uF, max uF uV, uF} F)
    (htail₁ : InducedTailLFactorAt.{uF, max uF uV, max uF uV, uF} F)
    (htail₂ : InducedTailLFactorAt.{uF, uF, uF, max uF uV} F) :
    OrderedUnramifiedCorankOneGenerationAt.{uF, uV} F := by
  intro n mG bG mU bU mQ mQ₀ mG₁ bG₁ q ψ abv ϖ μ h V _ _ π hπ ℓ hℓ P hP x hx ℓ' hℓ'
  have bQ : BorelSpace (LeftUnipotentQuotient n F) := h.borel
  have bQ₀ : BorelSpace (LeftUnipotentQuotient 0 F) := h.borel_rankOne
  obtain rfl := bG.measurable_eq
  obtain rfl := bU.measurable_eq
  obtain rfl := bG₁.measurable_eq
  obtain rfl := bQ.measurable_eq
  obtain rfl := bQ₀.measurable_eq
  let : MeasurableSpace (Langlands.GeneralLinear (n + 1) F) := borel _
  have : BorelSpace (Langlands.GeneralLinear (n + 1) F) := ⟨rfl⟩
  let : MeasurableSpace (upperUnipotent (n + 1) F) := borel _
  have : BorelSpace (upperUnipotent (n + 1) F) := ⟨rfl⟩
  let : MeasurableSpace (Langlands.GeneralLinear 1 F) := borel _
  have : BorelSpace (Langlands.GeneralLinear 1 F) := ⟨rfl⟩
  let : MeasurableSpace (LeftUnipotentQuotient n F) := borel _
  let : MeasurableSpace (LeftUnipotentQuotient 0 F) := borel _
  have hT2 : T2Space F := Langlands.BruhatTits.localField_t2Space F
  have hTD : TotallyDisconnectedSpace F :=
    Langlands.BruhatTits.localField_totallyDisconnectedSpace F
  let : MeasurableSpace F := borel F
  have : BorelSpace F := ⟨rfl⟩
  have hq1 : 1 < q := h.one_lt_q
  have hq0 : 0 < q := lt_trans Nat.zero_lt_one hq1
  have hq : IsResidueCardinality (F := F) q := h.residueCardinality
  have hsdF := Langlands.AllField.HarmonicAnalysis.padicSelfDualMeasureExists F
    (LocalFieldData.ofInstances F)
  dsimp only [Langlands.AllField.HarmonicAnalysis.PadicSelfDualMeasureExistsStatement,
    LocalFieldData.ofInstances] at hsdF
  obtain ⟨htd, hsd⟩ := hsdF
  obtain ⟨ν, hν⟩ := hsd ψ
  have hπW : IsOfWhittakerType (n + 1) (standardCharacter ψ (n + 1)) π :=
    isOfWhittakerType_of_isGeneric_localField hπ
  -- The L-polynomials of `π × I(x)` and of `π × χ_(x_i)`.
  obtain ⟨PI, Pi, hPI, hPi, -, -, -⟩ :=
    localFieldPrincipalSeriesLFactorMultiplicativity F q hq abv ϖ h.uniformizer
      h.abv_uniformizer h.abv_unit ψ ν hν (n + 1) n π hπW x
  -- `PI = ∏ Pi` from the three premises.
  have hPIeq : PI = ∏ j, Pi j := by
    have habvT := AllField.RankinSelberg.eq_normalizedAbsoluteValue_ofInstances q hq abv ϖ
      h.uniformizer h.abv_uniformizer h.abv_unit
    have hqT : q = (LocalFieldData.ofInstances F).residueCardinality :=
      hq.trans AllField.RankinSelberg.residueCardinality_ofInstances.symm
    subst habvT
    subst hqT
    exact lPolynomial_principalSeries_eq_prod h.uniformizer hq hclass hpole htail₁ htail₂ ψ
      ⟨ν, hν⟩ π hπ x hx hPI hPi
  -- The rank-one factors are the unramified rescalings of `P`.
  have hPi_eq : ∀ i, Pi i = P.comp (C (x i : ℂ) * X) := by
    intro i
    have h1 := (isGeneralSymmetricLPolynomial_of_le (Nat.zero_le (n + 1))).1 (hPi i)
    obtain ⟨-, h2⟩ := h1
    let : MeasurableSpace (upperUnipotent (0 + 1) F) := borel _
    have : BorelSpace (upperUnipotent (0 + 1) F) := ⟨rfl⟩
    have h3 :=
      (h2 (rankOneQuotientHaar F) (rankOneQuotientHaar_isCompatible F)).isCharacterLPolynomial
    have h4 := isCharacterLPolynomial_unramified hq1 ψ h.uniformizer h.abv_uniformizer
      h.abv_unit (rankOneQuotientHaar F) π hP (x i)
    exact IsNormalizedGenerator.unique h3 h4
  have hPIprod : (∏ i, P.comp (C (x i : ℂ) * X)) = PI := by
    rw [hPIeq]
    exact Finset.prod_congr rfl fun i _ => (hPi_eq i).symm
  -- The generator of the zeta values of the block `j = k = 0`.
  have hPIp := (isGeneralSymmetricLPolynomial_of_le (Nat.le_succ n)).1 hPI
  obtain ⟨⟨hinv, -⟩, hPIall⟩ := hPIp
  have hPIμ := @hPIall hinv μ h.measure
  have hgen : IsNormalizedGenerator
      (unequalRankZetaValues q ψ abv 0 0 μ (rectangularMeasure ν 0 (n + 1)) π
        (principalSeries h.uniformizer n h.residueCardinality x)) PI :=
    (isPairLPolynomial_of_lt (Nat.lt_succ_self n)).1 hPIμ 0 0 rfl
  have hrec : (algebraMap ℂ[X] RationalFunctions PI)⁻¹ ∈
      zetaSpan (unequalRankZetaValues q ψ abv 0 0 μ (rectangularMeasure ν 0 (n + 1)) π
        (principalSeries h.uniformizer n h.residueCardinality x)) := by
    rw [hgen.2]
    exact Submodule.mem_span_singleton_self _
  obtain ⟨N, c, R, hsum⟩ := Submodule.mem_span_set'.mp hrec
  -- The two Whittaker sets are the two models.
  have hset : whittakerSet ψ (n + 1) π = (coefficientModel π ℓ).toSubmodule :=
    whittakerSet_eq_coefficientModel ℓ fun ℓ₁ => hπW.eq_smul hℓ ℓ₁
  have hset' : inverseWhittakerSet ψ n (principalSeries h.uniformizer n h.residueCardinality x) =
      (coefficientModel (principalSeries h.uniformizer n h.residueCardinality x) ℓ').toSubmodule :=
    inverseWhittakerSet_eq_coefficientModel ℓ' fun ℓ₁ =>
      (principalSeries_isOfInverseWhittakerType h.uniformizer n h.residueCardinality ψ x).eq_smul
        hℓ' ℓ₁
  have hdata : ∀ i, ∃ (w : (coefficientModel π ℓ).toSubmodule)
      (w' : (coefficientModel (principalSeries h.uniformizer n h.residueCardinality x)
        ℓ').toSubmodule),
      (∃ a : ℝ, ∀ s : ℂ, a < s.re → CorankOneConverges ψ abv μ w.val w'.val s) ∧
        HasRationalContinuation q (corankOneIntegral ψ abv μ w.val w'.val) (R i : _) := by
    intro i
    obtain ⟨W, hW, W', hW', ⟨a, ha⟩, hcont⟩ := (R i).property
    rw [hset] at hW
    rw [hset'] at hW'
    refine ⟨⟨W, hW⟩, ⟨W', hW'⟩, ⟨a, fun s hs =>
      (unequalRankConverges_rectangular_zero_iff ψ abv μ ν W W' s).1 (ha s hs)⟩, ?_⟩
    have hfun : unequalRankIntegral ψ abv 0 0 μ (rectangularMeasure ν 0 (n + 1)) W W' =
        corankOneIntegral ψ abv μ W W' :=
      funext fun s => unequalRankIntegral_rectangular_zero ψ abv μ ν W W' s
    rw [← hfun]
    exact hcont
  choose w w' hconv hcont using hdata
  choose a ha using hcont
  -- The Laurent combination of the integrals is a finite sum of integrals.
  have hspan := IsPairIntegralSpan.finset_sum (ψ := ψ) (abv := abv) (μ := μ) (π := π) (ℓ := ℓ)
    (ρ := principalSeries h.uniformizer n h.residueCardinality x) (ℓ' := ℓ') Finset.univ
    (R := fun i s => laurentEval (spectralUnit (residueCardinality_pos h.residueCardinality) s)
      (c i) * corankOneIntegral ψ abv μ (w i).val (w' i).val s)
    fun i _ => IsPairIntegralSpan.laurent h (c i) (w i) (w' i) (hconv i)
  obtain ⟨k, Wf, Wf', b, hb⟩ := hspan
  refine ⟨k, Wf, Wf', max b (∑ i, |a i|), fun s hs => ?_⟩
  rw [← hb s (lt_of_le_of_lt (le_max_left _ _) hs), hPIprod]
  have hsi : ∀ i, a i < s.re := fun i =>
    lt_of_le_of_lt ((le_abs_self (a i)).trans (Finset.single_le_sum
      (f := fun i => |a i|) (fun i _ => abs_nonneg (a i)) (Finset.mem_univ i)))
      (lt_of_le_of_lt (le_max_right _ _) hs)
  set z := spectralUnit (residueCardinality_pos h.residueCardinality) s with hz
  have hzs : (z : ℂ) = spectralPoint q s := coe_spectralUnit _ s
  have hPI0 : PI ≠ 0 := by
    intro h0
    have := hgen.polynomial_ne_zero
    exact this h0
  have hkey := sum_laurentEval_mul_eval_mul_eq_one c (fun i => (R i : RationalFunctions)) hPI0
    hsum z (fun i => by rw [hzs]; exact (ha i s (hsi i)).1)
  rw [← hzs]
  convert hkey using 2
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [(ha i s (hsi i)).2, hzs]

/-- `OrderedUnramifiedCorankOneGenerationStatement` from the three premises at every
nonarchimedean local field. -/
theorem orderedUnramifiedCorankOneGeneration_of_premises
    (hprem : ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F],
      GenericStandardModuleStatement.{uF, uV} F ∧
        TemperedPoleBoundStatement.{uF, max uF uV, uF} F ∧
        InducedTailLFactorAt.{uF, max uF uV, max uF uV, uF} F ∧
        InducedTailLFactorAt.{uF, uF, uF, max uF uV} F) :
    OrderedUnramifiedCorankOneGenerationStatement.{uF, uV} := by
  intro F _ _ _ _
  obtain ⟨h1, h2, h3, h4⟩ := hprem F
  exact orderedUnramifiedCorankOneGenerationAt_of_premises F h1 h2 h3 h4

