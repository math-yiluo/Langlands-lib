import Langlands.Representation.Unramified.ConstituentHeckeScalarStatement
import Langlands.Representation.Unramified.SphericalHeckeGenerationStatement
import Langlands.Representation.Unramified.SphericalHeckeSpectrumDeterminationStatement
import Langlands.Representation.Unramified.SphericalClassificationStatement
import Langlands.Representation.Hecke.CornerDetermination

/-! # Standard Hecke scalars determine spherical irreducible representations -/

noncomputable section

namespace Langlands.Unramified

open Correspondence

universe uF uV uW

variable {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)

local instance determinationFieldTopology : TopologicalSpace F.Carrier :=
  F.canonicalTopologicalData.topology
local instance determinationFieldValuativeRel : ValuativeRel F.Carrier :=
  F.canonicalTopologicalData.valuativeRel
local instance determinationFieldLocalField : IsNonarchimedeanLocalField F.Carrier :=
  F.canonicalTopologicalData.localField
local instance determinationGeneralLinearTopology (n : ℕ) :
    TopologicalSpace (GeneralLinear n F.Carrier) := F.canonicalGeneralLinearTopology n
local instance determinationGeneralLinearTopologicalGroup (n : ℕ) :
    IsTopologicalGroup (GeneralLinear n F.Carrier) := F.canonicalGeneralLinearTopologicalGroup n
local instance determinationGeneralLinearT2 (n : ℕ) : T2Space (GeneralLinear n F.Carrier) :=
  F.canonicalGeneralLinearT2Space n
local instance determinationGeneralLinearMeasurable (n : ℕ) :
    MeasurableSpace (GeneralLinear n F.Carrier) := borel _
local instance determinationGeneralLinearBorel (n : ℕ) :
    BorelSpace (GeneralLinear n F.Carrier) := ⟨rfl⟩

/-- The action of the whole actual spherical corner on the spherical fixed vectors. -/
def sphericalCornerAction {r : ℕ} (A : AutomorphicObject.{uF, uV} F r.succPNat) :
    SphericalHeckeAlgebra F r →ₐ[ℂ]
      Module.End ℂ (fixedVectors A.obj.representation (sphericalSubgroup F r)) :=
  @Hecke.cornerAction (GeneralLinear (r + 1) F.Carrier) _
    (F.canonicalGeneralLinearTopology (r + 1))
    (F.canonicalGeneralLinearTopologicalGroup (r + 1)) _ _ _ _ _
    (sphericalHaar F r) _ A.obj.representation A.obj.isSmooth
    (sphericalOpenSubgroup F r) (sphericalOpenSubgroup_isCompact F r)

@[simp] theorem sphericalCornerAction_standardHeckeElement {r : ℕ}
    (A : AutomorphicObject.{uF, uV} F r.succPNat) (i : Fin (r + 2)) :
    sphericalCornerAction F A (standardHeckeElement F r i) = standardHeckeOperator F A i :=
  rfl

/-- Under the Hecke spectral relation each standard element acts by its scalar. -/
theorem sphericalCornerAction_standardHeckeElement_of_hasSpectrum {r : ℕ}
    {A : AutomorphicObject.{uF, uV} F r.succPNat} {s : Eigenvalues (r + 1)}
    (hA : HasSphericalHeckeSpectrum F A s) (i : Fin (r + 2)) :
    sphericalCornerAction F A (standardHeckeElement F r i) =
      algebraMap ℂ _ (standardHeckeScalar F s i) := by
  apply LinearMap.ext
  intro v
  rw [Module.algebraMap_end_apply, sphericalCornerAction_standardHeckeElement]
  exact hA.2 i v

/-- The scalar of the last standard element, the double coset of the central
uniformizer scalar matrix, is the signed top Euler coefficient and is nonzero. -/
theorem standardHeckeScalar_last_ne_zero {r : ℕ} (s : Eigenvalues (r + 1)) :
    standardHeckeScalar F s (Fin.last (r + 1)) ≠ 0 := by
  have hc : (Eigenvalues.eulerPolynomial s).coeff (r + 1) ≠ 0 := by
    have h := Polynomial.leadingCoeff_ne_zero.mpr (Eigenvalues.eulerPolynomial_ne_zero s)
    rwa [Polynomial.leadingCoeff, Eigenvalues.eulerPolynomial_natDegree] at h
  rw [standardHeckeScalar, elementaryCoefficient, Fin.val_last, Nat.sub_self, mul_zero,
    pow_zero, one_mul]
  exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hc

/-- For two objects with the same standard Hecke scalars, every element of the
subalgebra generated by the standard elements acts on both spherical fixed spaces
by one common scalar. -/
theorem exists_common_scalar_of_mem_adjoin {r : ℕ}
    {A : AutomorphicObject.{uF, uV} F r.succPNat} {B : AutomorphicObject.{uF, uW} F r.succPNat}
    {s : Eigenvalues (r + 1)} (hA : HasSphericalHeckeSpectrum F A s)
    (hB : HasSphericalHeckeSpectrum F B s) {f : SphericalHeckeAlgebra F r}
    (hf : f ∈ Algebra.adjoin ℂ (Set.range (standardHeckeElement F r))) :
    ∃ c : ℂ, sphericalCornerAction F A f = algebraMap ℂ _ c ∧
      sphericalCornerAction F B f = algebraMap ℂ _ c := by
  let P := (sphericalCornerAction F A).prod (sphericalCornerAction F B)
  have hle : Algebra.adjoin ℂ (Set.range (standardHeckeElement F r)) ≤
      (⊥ : Subalgebra ℂ _).comap P := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_comap, Algebra.mem_bot]
    refine ⟨standardHeckeScalar F s i, ?_⟩
    rw [Prod.algebraMap_apply, AlgHom.prod_apply,
      sphericalCornerAction_standardHeckeElement_of_hasSpectrum F hA,
      sphericalCornerAction_standardHeckeElement_of_hasSpectrum F hB]
  obtain ⟨c, hc⟩ := Algebra.mem_bot.mp (hle hf)
  exact ⟨c, (congrArg Prod.fst hc).symm, (congrArg Prod.snd hc).symm⟩

/-- Cancelling a nonzero scalar factor in a complex algebra. -/
theorem eq_algebraMap_inv_mul_of_algebraMap_mul {M : Type*} [Ring M] [Algebra ℂ M] (X : M)
    {t c : ℂ} (ht : t ≠ 0) (h : algebraMap ℂ M t * X = algebraMap ℂ M c) :
    X = algebraMap ℂ M (t⁻¹ * c) := by
  rw [map_mul, ← h, ← mul_assoc, ← map_mul, inv_mul_cancel₀ ht, map_one, one_mul]

/-- Given the generation statement, two objects with the same standard Hecke scalars
have every element of the spherical corner acting on both fixed spaces by one common
scalar. -/
theorem exists_common_scalar (hgen : SphericalHeckeGenerationStatement.{uF}) {r : ℕ}
    {A : AutomorphicObject.{uF, uV} F r.succPNat} {B : AutomorphicObject.{uF, uW} F r.succPNat}
    {s : Eigenvalues (r + 1)} (hA : HasSphericalHeckeSpectrum F A s)
    (hB : HasSphericalHeckeSpectrum F B s) (f : SphericalHeckeAlgebra F r) :
    ∃ c : ℂ, sphericalCornerAction F A f = algebraMap ℂ _ c ∧
      sphericalCornerAction F B f = algebraMap ℂ _ c := by
  obtain ⟨m, hm⟩ := hgen p F r f
  obtain ⟨c, hcA, hcB⟩ := exists_common_scalar_of_mem_adjoin F hA hB hm
  set t := standardHeckeScalar F s (Fin.last (r + 1))
  have ht : t ^ m ≠ 0 := pow_ne_zero _ (standardHeckeScalar_last_ne_zero F s)
  refine ⟨(t ^ m)⁻¹ * c, eq_algebraMap_inv_mul_of_algebraMap_mul _ ht ?_,
    eq_algebraMap_inv_mul_of_algebraMap_mul _ ht ?_⟩
  · rw [← hcA, map_mul, map_pow, map_pow,
      sphericalCornerAction_standardHeckeElement_of_hasSpectrum F hA]
  · rw [← hcB, map_mul, map_pow, map_pow,
      sphericalCornerAction_standardHeckeElement_of_hasSpectrum F hB]

/-- Given the generation statement, irreducible admissible objects with the same
standard spherical Hecke scalars are equivalent. -/
theorem nonempty_equiv_of_hasSphericalHeckeSpectrum
    (hgen : SphericalHeckeGenerationStatement.{uF}) {r : ℕ}
    {A : AutomorphicObject.{uF, uV} F r.succPNat} {B : AutomorphicObject.{uF, uW} F r.succPNat}
    {s : Eigenvalues (r + 1)} (hA : HasSphericalHeckeSpectrum F A s)
    (hB : HasSphericalHeckeSpectrum F B s) :
    Nonempty (A.obj.representation.Equiv B.obj.representation) := by
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hA.1
  obtain ⟨b, hb, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hB.1
  refine @Hecke.nonempty_equiv_of_cornerAction_eq_zero_iff (GeneralLinear (r + 1) F.Carrier) _
    (F.canonicalGeneralLinearTopology (r + 1))
    (F.canonicalGeneralLinearTopologicalGroup (r + 1)) _ _ _ _ _ _ _ _
    (sphericalHaar F r) _ (sphericalOpenSubgroup F r) (sphericalOpenSubgroup_isCompact F r)
    A.obj.representation A.obj.isSmooth A.property.1
    B.obj.representation B.obj.isSmooth B.property.1 ⟨a, ha⟩ ⟨b, hb⟩ ha0 hb0 ?_
  intro e
  obtain ⟨c, hcA, hcB⟩ := exists_common_scalar F hgen hA hB e
  change sphericalCornerAction F A e ⟨a, ha⟩ = 0 ↔ sphericalCornerAction F B e ⟨b, hb⟩ = 0
  rw [hcA, hcB, Module.algebraMap_end_apply, Module.algebraMap_end_apply, smul_eq_zero,
    smul_eq_zero]
  have ha' : (⟨a, ha⟩ : fixedVectors A.obj.representation (sphericalSubgroup F r)) ≠ 0 :=
    fun h => ha0 (congrArg Subtype.val h)
  have hb' : (⟨b, hb⟩ : fixedVectors B.obj.representation (sphericalSubgroup F r)) ≠ 0 :=
    fun h => hb0 (congrArg Subtype.val h)
  rw [or_iff_left ha', or_iff_left hb']

/-- The generation statement implies the determination statement. -/
theorem sphericalHeckeSpectrumDetermination_of (hgen : SphericalHeckeGenerationStatement.{uF}) :
    SphericalHeckeSpectrumDeterminationStatement.{uF, uV, uW} :=
  fun _ _ F _ _ _ _ hA hB => nonempty_equiv_of_hasSphericalHeckeSpectrum F hgen hA hB

/-- Spherical constituent uniqueness follows from the constituent Hecke-scalar statement
at both carrier universes and the determination statement. -/
theorem sphericalConstituentUniqueness_of
    (hscalarV : SphericalConstituentHeckeScalarStatement.{uF, uV})
    (hscalarW : SphericalConstituentHeckeScalarStatement.{uF, uW})
    (hdet : SphericalHeckeSpectrumDeterminationStatement.{uF, uV, uW}) :
    SphericalConstituentUniquenessStatement.{uF, uV, uW} := by
  intro p _ F r z w hzw A B hA hB
  have hsA := hscalarV p F r z A hA
  have hsB := hscalarW p F r w B hB
  rw [← hzw] at hsB
  exact hdet p F r A B _ hsA hsB

end Langlands.Unramified
