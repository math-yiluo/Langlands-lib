import Langlands.Representation.Unramified.HeckeOperators

/-! # Generation of the spherical Hecke algebra by the standard elements -/

noncomputable section

namespace Langlands.Unramified

open Correspondence

universe uF

local instance generationFieldTopology {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p) :
    TopologicalSpace F.Carrier :=
  F.canonicalTopologicalData.topology
local instance generationFieldValuativeRel {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p) :
    ValuativeRel F.Carrier :=
  F.canonicalTopologicalData.valuativeRel
local instance generationFieldLocalField {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p) :
    IsNonarchimedeanLocalField F.Carrier :=
  F.canonicalTopologicalData.localField
local instance generationGeneralLinearTopology {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)
    (n : ℕ) : TopologicalSpace (GeneralLinear n F.Carrier) :=
  F.canonicalGeneralLinearTopology n
local instance generationGeneralLinearTopologicalGroup {p : ℕ} [Fact p.Prime]
    (F : PadicField.{uF} p) (n : ℕ) : IsTopologicalGroup (GeneralLinear n F.Carrier) :=
  F.canonicalGeneralLinearTopologicalGroup n
local instance generationGeneralLinearT2 {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)
    (n : ℕ) : T2Space (GeneralLinear n F.Carrier) :=
  F.canonicalGeneralLinearT2Space n
local instance generationGeneralLinearMeasurable {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)
    (n : ℕ) : MeasurableSpace (GeneralLinear n F.Carrier) :=
  borel _
local instance generationGeneralLinearBorel {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)
    (n : ℕ) : BorelSpace (GeneralLinear n F.Carrier) :=
  ⟨rfl⟩

/-- Every element of the actual spherical Hecke algebra lies in the complex
subalgebra generated by the standard double-coset elements after multiplication
on the left by a power of the last standard element, the double coset of the
central uniformizer scalar matrix. -/
def SphericalHeckeGenerationStatement : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (F : PadicField.{uF} p) (r : ℕ)
    (f : SphericalHeckeAlgebra F r),
    ∃ m : ℕ, standardHeckeElement F r (Fin.last (r + 1)) ^ m * f ∈
      Algebra.adjoin ℂ (Set.range (standardHeckeElement F r))

end Langlands.Unramified
