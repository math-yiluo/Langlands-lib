import Langlands.Representation.Unramified.PrincipalSeriesHecke
import Langlands.Representation.Classification.RegularLanglandsHeadReduction
import Langlands.Representation.Compact.SurjectivityProof
import Mathlib.RingTheory.PiTensorProduct

/-! Fixed-line and strong-head criteria for spherical generation. -/

noncomputable section

namespace Langlands.Unramified.SphericalGeneration

universe uG uV

private theorem injective_of_scalar_embedding
    {X Y : Type*} [AddCommGroup X] [Module ℂ X]
    [AddCommGroup Y] [Module ℂ Y]
    (e : X →ₗ[ℂ] ℂ) (he : Function.Injective e)
    (f : X →ₗ[ℂ] Y) (hf : ∃ w, f w ≠ 0) :
    Function.Injective f := by
  apply (LinearMap.ker_eq_bot).mp
  apply le_antisymm _ bot_le
  intro v hv
  change v = 0
  by_contra hv0
  have hev : e v ≠ 0 := by
    intro h
    exact hv0 (he (h.trans e.map_zero.symm))
  obtain ⟨w, hw⟩ := hf
  have hwv : w = (e w / e v) • v := by
    apply he
    simp [map_smul, div_mul_cancel₀ _ hev]
  apply hw
  rw [hwv, map_smul]
  have hfv : f v = 0 := hv
  rw [hfv, smul_zero]

/-- A coatomic smooth representation with a scalar-detected fixed line and a
spherical strong irreducible head is generated by each nonzero fixed vector. -/
theorem eq_top_of_coatomic_spherical_head
    {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (A B : SmoothRep.{0, uG, uV} ℂ G)
    (hco : IsCoatomic (Subrepresentation A.representation))
    (hhead : Classification.IsIrreducibleHead A.representation B.representation)
    (K : OpenSubgroup G) (hK : IsCompact (K : Set G))
    (e : fixedVectors A.representation K.toSubgroup →ₗ[ℂ] ℂ)
    (he : Function.Injective e)
    (hB : fixedVectors B.representation K.toSubgroup ≠ ⊥)
    (S : Subrepresentation A.representation)
    (hS : fixedVectors S.toRepresentation K.toSubgroup ≠ ⊥) :
    S = ⊤ := by
  obtain ⟨-, q, hq, huniq⟩ := hhead
  have hfixed_surj := Compact.fixedVectorSurjectivity G A B
    A.representation B.representation A.isSmooth B.isSmooth K hK q hq
  have hfixed_nonzero :
      ∃ w, Compact.fixedVectorMap A.representation B.representation q K.toSubgroup w ≠ 0 := by
    obtain ⟨b, hb, hb0⟩ := (Submodule.ne_bot_iff _).mp hB
    obtain ⟨a, ha⟩ := hfixed_surj ⟨b, hb⟩
    refine ⟨a, ?_⟩
    rw [ha]
    exact fun h => hb0 (congrArg Subtype.val h)
  have hfixed_inj := injective_of_scalar_embedding e he
    (Compact.fixedVectorMap A.representation B.representation q K.toSubgroup)
    hfixed_nonzero
  rcases hco.eq_top_or_exists_le_coatom S with htop | ⟨M, hM, hSM⟩
  · exact htop
  let Q := SmoothRep.quotient A M
  let qM : A.representation.IntertwiningMap Q.representation :=
    SmoothRep.hom (SmoothRep.mkQ A M)
  have hqM : Function.Surjective qM := SmoothRep.mkQ_surjective A M
  have hQ : Representation.IsIrreducible Q.representation :=
    CuspidalSupport.QuasicuspidalEmbedding.isIrreducible_of_isCoatom qM hqM M hM
      (fun x => Submodule.Quotient.mk_eq_zero _)
  have hker := huniq Q Q.representation hQ qM hqM
  obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).mp hS
  let a : fixedVectors A.representation K.toSubgroup :=
    ⟨v.val, fun k => congrArg Subtype.val (hv k)⟩
  have ha0 : a ≠ 0 := by
    intro h
    apply hv0
    apply Subtype.ext
    exact congrArg
      (fun x : fixedVectors A.representation K.toSubgroup => (x : A)) h
  have hqMa : qM a.val = 0 :=
    (Submodule.Quotient.mk_eq_zero _).mpr (hSM v.property)
  have hqa : q a.val = 0 := by
    change a.val ∈ LinearMap.ker q.toLinearMap
    rw [← hker]
    exact hqMa
  exact False.elim (ha0 (hfixed_inj (by
    apply Subtype.ext
    exact hqa.trans (map_zero q).symm)))

/-- Finite length supplies the coatomicity in the fixed-line generation
criterion. The spherical-head premise is retained explicitly. -/
theorem eq_top_of_finiteLength_spherical_head
    {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (A B : SmoothRep.{0, uG, uV} ℂ G)
    (hA : A.HasFiniteLength)
    (hhead : Classification.IsIrreducibleHead A.representation B.representation)
    (K : OpenSubgroup G) (hK : IsCompact (K : Set G))
    (e : fixedVectors A.representation K.toSubgroup →ₗ[ℂ] ℂ)
    (he : Function.Injective e)
    (hB : fixedVectors B.representation K.toSubgroup ≠ ⊥)
    (S : Subrepresentation A.representation)
    (hS : fixedVectors S.toRepresentation K.toSubgroup ≠ ⊥) :
    S = ⊤ := by
  have : IsNoetherian (MonoidAlgebra ℂ G) A.representation.asModule :=
    (isFiniteLength_iff_isNoetherian_isArtinian.mp hA).1
  have hco : IsCoatomic (Subrepresentation A.representation) :=
    (Subrepresentation.subrepresentationSubmoduleOrderIso
      (ρ := A.representation)).isCoatomic_iff.mpr inferInstance
  exact eq_top_of_coatomic_spherical_head A B hco hhead K hK e he hB S hS

universe uF

variable {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)

local instance fieldTopology : TopologicalSpace F.Carrier :=
  F.canonicalTopologicalData.topology

local instance glTopology (n : ℕ) : TopologicalSpace (GeneralLinear n F.Carrier) :=
  F.canonicalGeneralLinearTopology n

/-- Scalar evaluation at the identity on the actual spherical principal-series
fixed space, using the canonical tensor-of-scalars equivalence. -/
def scalarEvaluation {r : ℕ} (z : Fin (r + 1) → ℂˣ) :
    fixedVectors (principalSeriesOfTuple F z) (Correspondence.sphericalSubgroup F r) →ₗ[ℂ] ℂ :=
  (PiTensorProduct.constantBaseRingEquiv (Fin (Correspondence.borelShape r).length) ℂ).toLinearMap.comp
    ((evalAt F z 1).comp
      (fixedVectors (principalSeriesOfTuple F z) (Correspondence.sphericalSubgroup F r)).subtype)

/-- A spherical vector of the actual principal series is determined by its
scalar value at the identity. This holds for every tuple. -/
theorem scalarEvaluation_injective {r : ℕ} (z : Fin (r + 1) → ℂˣ) :
    Function.Injective (scalarEvaluation F z) := by
  apply (LinearMap.ker_eq_bot).mp
  apply le_antisymm _ bot_le
  intro v hv
  change v = 0
  apply eq_zero_of_eval_one F v
  apply (PiTensorProduct.constantBaseRingEquiv
    (Fin (Correspondence.borelShape r).length) ℂ).injective
  exact (show scalarEvaluation F z v = 0 from hv).trans (map_zero _).symm

end Langlands.Unramified.SphericalGeneration
