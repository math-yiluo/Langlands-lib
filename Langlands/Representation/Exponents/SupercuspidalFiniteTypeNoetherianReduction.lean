/-!
# Finitely generated supercuspidal representations are Noetherian

The first step of Renard's proof of the VI.7.5 Proposition: a supercuspidal
block is equivalent to a module category over a Noetherian ring (VI.4.1,
VI.4.4), and a finitely generated object has only finitely many nonzero block
components. This module proves `SupercuspidalFiniteTypeNoetherianStatement` in
carrier universe `max u v` from the published VI.3.3.1, VI.3.4, VI.3.2(ii),
VI.4.1 and VI.4.4 statements in that universe, and the standard-cocharacter and
relative-root-system statements. All of these remain explicit premises. It also
shows that the Proposition in carrier universe `max u v` gives the Proposition
in carrier universe `v`.
-/

noncomputable section

universe u v w

open CategoryTheory Limits AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology
open scoped CategoryTheory.MonObj

namespace Langlands.SmoothRep

section FixedVectorsGeneration

variable {H : Type u} [Group H] [TopologicalSpace H]

/-- The zero morphism has zero underlying map. -/
theorem hom_zero_apply {X B : SmoothRep.{0, u, w} ℂ H} (x : X) :
    hom (0 : X ⟶ B) x = 0 :=
  rfl

/-- An intertwiner sends `K`-fixed vectors to `K`-fixed vectors. -/
theorem hom_mem_fixedVectors {K : Subgroup H} {X B : SmoothRep.{0, u, w} ℂ H}
    (f : X ⟶ B) {x : X} (hx : x ∈ fixedVectors X.representation K) :
    hom f x ∈ fixedVectors B.representation K := fun k => by
  change B.representation (k : H) (hom f x) = hom f x
  rw [← Representation.IntertwiningMap.isIntertwining]
  exact congrArg (hom f) (hx k)

/-- The `K`-fixed vectors generate `X`: every intertwiner out of `X` that kills
them is zero. -/
def FixedVectorsGenerate (K : Subgroup H) (X : SmoothRep.{0, u, w} ℂ H) : Prop :=
  ∀ (B : SmoothRep.{0, u, w} ℂ H) (f : X ⟶ B),
    (∀ x ∈ fixedVectors X.representation K, hom f x = 0) → f = 0

/-- Generation by `K`-fixed vectors passes to quotients. -/
theorem FixedVectorsGenerate.of_surjective {K : Subgroup H}
    {X Y : SmoothRep.{0, u, w} ℂ H} (hX : FixedVectorsGenerate K X)
    (q : X ⟶ Y) (hq : Function.Surjective (hom q)) : FixedVectorsGenerate K Y := by
  intro B f hf
  have : Epi q := (epi_iff_surjective q).mpr hq
  rw [← cancel_epi q, comp_zero]
  exact hX B (q ≫ f) (fun x hx => hf _ (hom_mem_fixedVectors q hx))

/-- A nonzero quotient of a representation generated by `K`-fixed vectors has
nonzero `K`-fixed vectors. -/
theorem FixedVectorsGenerate.nontrivial_fixedVectors {K : Subgroup H}
    {X τ : SmoothRep.{0, u, w} ℂ H} (hX : FixedVectorsGenerate K X)
    (q : X ⟶ τ) (hq : Function.Surjective (hom q)) [Nontrivial τ] :
    Nontrivial (fixedVectors τ.representation K) := by
  by_contra h
  rw [not_nontrivial_iff_subsingleton] at h
  have hq0 : q = 0 := hX τ q (fun x hx => congrArg Subtype.val
    (Subsingleton.elim (⟨hom q x, hom_mem_fixedVectors q hx⟩ :
      fixedVectors τ.representation K) 0))
  obtain ⟨y, hy⟩ := exists_ne (0 : τ)
  obtain ⟨x, rfl⟩ := hq y
  exact hy (by rw [hq0]; rfl)

/-- A spanning set of `K`-fixed vectors generates. -/
theorem fixedVectorsGenerate_of_span {K : Subgroup H} {X : SmoothRep.{0, u, w} ℂ H}
    (s : Set X.representation.asModule)
    (hs : Submodule.span (MonoidAlgebra ℂ H) s = ⊤)
    (hsK : ∀ x ∈ s, X.representation.asModuleEquiv x ∈ fixedVectors X.representation K) :
    FixedVectorsGenerate K X := by
  intro B f hf
  let L := Representation.IntertwiningMap.equivLinearMapAsModule
    X.representation B.representation (hom f)
  have hle : Submodule.span (MonoidAlgebra ℂ H) s ≤ LinearMap.ker L :=
    Submodule.span_le.mpr fun x hx => hf _ (hsK x hx)
  rw [hs, top_le_iff] at hle
  apply hom_ext'
  ext x
  have hx : X.representation.asModuleEquiv.symm x ∈ LinearMap.ker L := by
    rw [hle]
    exact Submodule.mem_top
  exact hx

/-- A finitely generated nonzero smooth representation has an irreducible
quotient. -/
theorem exists_irreducible_quotient_of_finite (A : SmoothRep.{0, u, w} ℂ H)
    [Nontrivial A] [Module.Finite (MonoidAlgebra ℂ H) A.representation.asModule] :
    ∃ (τ : SmoothRep.{0, u, w} ℂ H) (q : A ⟶ τ),
      τ.IsIrreducible ∧ Function.Surjective (hom q) := by
  classical
  have hco : IsCoatomic (Subrepresentation A.representation) :=
    (Subrepresentation.subrepresentationSubmoduleOrderIso
      (ρ := A.representation)).isCoatomic_iff.mpr inferInstance
  rcases hco.eq_top_or_exists_le_coatom ⊥ with he | ⟨S, hS, _⟩
  · exfalso
    obtain ⟨x, hx⟩ := exists_ne (0 : A)
    apply hx
    have hxS : x ∈ (⊥ : Subrepresentation A.representation) := by
      rw [he]
      exact Submodule.mem_top
    exact hxS
  · exact ⟨quotient A S, mkQ A S,
      RenardIrreducibleExistence.quotient_isIrreducible_of_isCoatom A S hS,
      mkQ_surjective A S⟩

end FixedVectorsGeneration

end Langlands.SmoothRep

namespace Langlands.Renard

section BoolCofan

variable {C : Type*} [Category C] [Preadditive C] {X : C} {Y : Bool → C}
  {inj : ∀ b, Y b ⟶ X}

/-- The retraction of a `Bool`-indexed coproduct onto one summand. -/
def boolCofanRetraction (hc : IsColimit (Cofan.mk X inj)) (b : Bool) : X ⟶ Y b :=
  Cofan.IsColimit.desc hc (fun c => if h : c = b then eqToHom (congrArg Y h) else 0)

@[reassoc (attr := simp)]
theorem inj_boolCofanRetraction (hc : IsColimit (Cofan.mk X inj)) (b : Bool) :
    inj b ≫ boolCofanRetraction hc b = 𝟙 _ := by
  have := Cofan.IsColimit.fac hc
    (fun c => if h : c = b then eqToHom (congrArg Y h) else 0) b
  simpa [boolCofanRetraction] using this

theorem inj_boolCofanRetraction_ne (hc : IsColimit (Cofan.mk X inj)) {b c : Bool} (h : c ≠ b) :
    inj c ≫ boolCofanRetraction hc b = 0 := by
  have := Cofan.IsColimit.fac hc
    (fun c => if h : c = b then eqToHom (congrArg Y h) else 0) c
  simpa [boolCofanRetraction, h] using this

/-- The identity of a `Bool`-indexed coproduct is the sum of the two
retraction-injection composites. -/
theorem boolCofan_id_eq (hc : IsColimit (Cofan.mk X inj)) :
    𝟙 X = boolCofanRetraction hc true ≫ inj true + boolCofanRetraction hc false ≫ inj false := by
  apply Cofan.IsColimit.hom_ext hc
  intro c
  change inj c ≫ 𝟙 X = inj c ≫ (_ + _)
  rw [Preadditive.comp_add, ← Category.assoc, ← Category.assoc, Category.comp_id]
  cases c
  · rw [inj_boolCofanRetraction_ne hc (b := true) (c := false) (by decide),
      inj_boolCofanRetraction, zero_comp, zero_add, Category.id_comp]
  · rw [inj_boolCofanRetraction_ne hc (b := false) (c := true) (by decide),
      inj_boolCofanRetraction, zero_comp, add_zero, Category.id_comp]

end BoolCofan

end Langlands.Renard

namespace Langlands.SmoothRep

section BoolCofan

variable {H : Type u} [Group H] [TopologicalSpace H] {X : SmoothRep.{0, u, w} ℂ H}
  {Y : Bool → SmoothRep.{0, u, w} ℂ H} {inj : ∀ b, Y b ⟶ X}

/-- Each summand of a `Bool`-indexed coproduct is a quotient of the coproduct. -/
theorem boolCofanRetraction_surjective (hc : IsColimit (Cofan.mk X inj)) (b : Bool) :
    Function.Surjective (hom (Renard.boolCofanRetraction hc b)) := fun y =>
  ⟨hom (inj b) y, congrArg (fun φ : Y b ⟶ Y b => hom φ y)
    (Renard.inj_boolCofanRetraction hc b)⟩

/-- A `Bool`-indexed coproduct of Noetherian representations is Noetherian. -/
theorem isNoetherian_of_boolCofan (hc : IsColimit (Cofan.mk X inj))
    (hY : ∀ b, IsNoetherian (MonoidAlgebra ℂ H) (Y b).representation.asModule) :
    IsNoetherian (MonoidAlgebra ℂ H) X.representation.asModule := by
  have key : ∀ x : X, x = hom (inj true) (hom (Renard.boolCofanRetraction hc true) x) +
      hom (inj false) (hom (Renard.boolCofanRetraction hc false) x) := fun x =>
    congrArg (fun φ : X ⟶ X => hom φ x) (Renard.boolCofan_id_eq hc)
  have := hY
  exact NoetherianRepresentation.of_jointlyInjective
    (fun b => hom (Renard.boolCofanRetraction hc b))
    (fun x y h => by rw [key x, key y, h true, h false])

end BoolCofan

end Langlands.SmoothRep

namespace Langlands.CuspidalSupport

open Aubert.General Aubert.General.RationalPointFamily GroupScheme

section Block

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffine G.X.left]
  [LocallyOfFiniteType G.X.hom]

local instance blockNoetherianTopology : TopologicalSpace (GroupScheme.rationalPoints G) :=
  rationalPointTopology F G.X

/-- A smooth representation is isomorphic to its carrier lift when the target
universe is already absorbed. -/
def rationalInertiaBaseLiftIso (π : SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G)) :
    π ≅ rationalInertiaBaseLift G π :=
  SmoothRep.mkIso (SmoothRep.universeLiftEquiv π)

/-- The endomorphism ring of an object of a full subcategory is the
endomorphism ring of the underlying ambient object. -/
def fullSubcategoryEndRingEquiv {C : Type*} [Category C] [Preadditive C]
    (P : ObjectProperty C) (X : P.FullSubcategory) : End X ≃+* End X.obj :=
  { P.fullyFaithfulι.mulEquivEnd X with
    map_add' := fun _ _ => rfl }

/-- Noetherianity in an inertia block with a progenerator: if `Hom(Π, •)` is
an equivalence from the block of the lifted `π` to modules over `(End Π)ᵐᵒᵖ`
and this ring is Noetherian, then every finitely generated object of the block
of `π` is a Noetherian `ℂ[G(F)]`-module. -/
theorem isNoetherian_of_rationalInertiaBlockProperty
    (π Pi : SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G))
    (hmem : rationalInertiaBlockProperty G (rationalInertiaBaseLift G π) Pi)
    (hEq : (preadditiveCoyonedaObj
      (⟨Pi, hmem⟩ : RationalInertiaBlock G (rationalInertiaBaseLift G π))).IsEquivalence)
    (hR : IsNoetherianRing (End Pi)ᵐᵒᵖ)
    (Y : SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G))
    (hY : rationalInertiaBlockProperty G π Y)
    (hfin : Module.Finite (MonoidAlgebra ℂ (GroupScheme.rationalPoints G))
      Y.representation.asModule) :
    IsNoetherian (MonoidAlgebra ℂ (GroupScheme.rationalPoints G))
      Y.representation.asModule := by
  classical
  let Q := rationalInertiaBlockProperty G (rationalInertiaBaseLift G π)
  let P : Q.FullSubcategory := ⟨Pi, hmem⟩
  let Yb : Q.FullSubcategory := ⟨Y, (rationalInertiaBlockProperty_iff_of_related
    (IsRationalInertiaRelated.of_iso (rationalInertiaBaseLiftIso π))).mp hY⟩
  let E := preadditiveCoyonedaObj P
  have : E.IsEquivalence := hEq
  let e₁ : Subobject Yb ≃o Subobject Y :=
    Renard.functorSubobjectOrderIso Q.ι Yb (Renard.subobjectSurjective_ι Q Yb)
  let e₂ : Subobject Yb ≃o Subobject (E.obj Yb) :=
    Renard.functorSubobjectOrderIso E Yb (Renard.subobjectSurjective_of_isEquivalence E Yb)
  have hRP : IsNoetherianRing (End P)ᵐᵒᵖ :=
    isNoetherianRing_of_ringEquiv _ (fullSubcategoryEndRingEquiv Q P).op.symm
  have hft : Renard.IsFiniteTypeObject Y := (SmoothRep.renardFiniteType_iff Y).mpr hfin
  have hftE : Renard.IsFiniteTypeObject (E.obj Yb) :=
    Renard.isFiniteTypeObject_of_orderIso (e₂.symm.trans e₁) hft
  have : Module.Finite (End P)ᵐᵒᵖ (E.obj Yb) :=
    (Renard.ModuleFiniteType.finiteType_iff_finite _).mp hftE
  have hnE : Renard.IsNoetherianObject (E.obj Yb) :=
    (Renard.ModuleNoetherian.object_iff _ _).mpr inferInstance
  exact (SmoothRep.renardNoetherian_iff Y).mp
    (Renard.isNoetherianObject_of_orderIso (e₁.symm.trans e₂) hnE)

end Block

section Induction

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffine G.X.left]
  [LocallyOfFiniteType G.X.hom]

local instance inductionTopology : TopologicalSpace (GroupScheme.rationalPoints G) :=
  rationalPointTopology F G.X

/-- The splitting induction: a finitely generated smooth representation `X`,
generated by its `K`-fixed vectors, all of whose irreducible subquotients with
nonzero `K`-fixed vectors are inertia-related to some `π a` with `a ∈ s`, is
Noetherian, provided each `π a` splits the category and finitely generated
objects of its block are Noetherian. -/
theorem isNoetherian_of_inertiaSplittings {J : Type*}
    (π : J → SmoothRep.{0, u, w} ℂ (GroupScheme.rationalPoints G))
    (hsplit : ∀ a, IsRationalInertiaCategoryDecomposition G (π a))
    (hblock : ∀ a (Y : SmoothRep.{0, u, w} ℂ (GroupScheme.rationalPoints G)),
      rationalInertiaBlockProperty G (π a) Y →
      Module.Finite (MonoidAlgebra ℂ (GroupScheme.rationalPoints G)) Y.representation.asModule →
      IsNoetherian (MonoidAlgebra ℂ (GroupScheme.rationalPoints G)) Y.representation.asModule)
    (K : Subgroup (GroupScheme.rationalPoints G)) (s : Finset J) :
    ∀ X : SmoothRep.{0, u, w} ℂ (GroupScheme.rationalPoints G),
      Module.Finite (MonoidAlgebra ℂ (GroupScheme.rationalPoints G)) X.representation.asModule →
      SmoothRep.FixedVectorsGenerate K X →
      (∀ D : SmoothRep.{0, u, w} ℂ (GroupScheme.rationalPoints G), D.IsIrreducible →
        SmoothRep.IsSubquotient D X → Nontrivial (fixedVectors D.representation K) →
          ∃ a ∈ s, IsRationalInertiaRelated G (π a) D) →
      IsNoetherian (MonoidAlgebra ℂ (GroupScheme.rationalPoints G)) X.representation.asModule := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro X hfin hK hX
    rcases subsingleton_or_nontrivial X with h | h
    · have : Subsingleton X.representation.asModule := h
      exact ⟨fun N => by rw [Subsingleton.elim N ⊥]; exact Submodule.fg_bot⟩
    · obtain ⟨τ, q, hτ, hq⟩ := SmoothRep.exists_irreducible_quotient_of_finite X
      have : τ.representation.IsIrreducible := hτ
      have : Nontrivial τ :=
        IsSimpleModule.nontrivial (MonoidAlgebra ℂ (GroupScheme.rationalPoints G))
          τ.representation.asModule
      obtain ⟨a, ha, -⟩ := hX τ hτ (SmoothRep.IsQuotient.isSubquotient ⟨q, hq⟩)
        (hK.nontrivial_fixedVectors q hq)
      exact absurd ha (Finset.notMem_empty a)
  | insert a s ha ih =>
    intro X hfin hK hX
    obtain ⟨Y, inj, hY, ⟨hc⟩⟩ := (hsplit a).1 X
    have hr := SmoothRep.boolCofanRetraction_surjective hc
    have hfinY : ∀ b, Module.Finite (MonoidAlgebra ℂ (GroupScheme.rationalPoints G))
        (Y b).representation.asModule := fun b =>
      Module.Finite.of_surjective (Representation.IntertwiningMap.equivLinearMapAsModule _ _
        (SmoothRep.hom (Renard.boolCofanRetraction hc b))) (hr b)
    refine SmoothRep.isNoetherian_of_boolCofan hc ?_
    intro b
    cases b
    · have hYf : rationalInertiaComplementProperty G (π a) (Y false) := hY false
      apply ih (Y false) (hfinY false) (hK.of_surjective _ (hr false))
      intro D hD hDY hDK
      obtain ⟨c, hcs, hrel⟩ := hX D hD (smoothSubquotientTransitivity ℂ _ X (Y false) D hDY
        (SmoothRep.IsQuotient.isSubquotient ⟨_, hr false⟩)) hDK
      rcases Finset.mem_insert.mp hcs with rfl | hcs
      · exact absurd hrel (hYf D hD hDY)
      · exact ⟨c, hcs, hrel⟩
    · exact hblock a (Y true) (hY true) (hfinY true)

end Induction

section Assembly

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffine G.X.left]
  [LocallyOfFiniteType G.X.hom]

local instance assemblyTopology : TopologicalSpace (GroupScheme.rationalPoints G) :=
  rationalPointTopology F G.X

variable [LocallyCompactSpace (GroupScheme.rationalPoints G)]
  [NonarchimedeanGroup (GroupScheme.rationalPoints G)]
  [T2Space (GroupScheme.rationalPoints G)]

/-- A finitely generated smooth representation all of whose subquotients are
cuspidal for the proper standard parabolics is Noetherian, given VI.3.3.1,
the finiteness remark of VI.3.4, VI.3.2(ii), VI.4.1 and VI.4.4. -/
theorem isNoetherian_of_allCuspidalSubquotients
    (hSplit : RationalCuspidalInertiaDecompositionStatement.{u, max u v})
    (hFinite : RationalCuspidalInertiaFinitenessStatement.{u, max u v})
    (hRes : RationalNormKernelFiniteRestrictionStatement.{u, max u v})
    (hHom : RationalSummandHomEquivalenceStatement.{u, max u v})
    (hEnd : RationalSummandEndNoetherianStatement.{u, max u v})
    (hG : IsConnectedReductive G) {T : CommGroupScheme (Spec (CommRingCat.of F))}
    (i : T.toGrp ⟶ G) (hi : IsMaximalSplitTorus i) [Mono i.hom.hom.left]
    (ν : cocharacterLattice T) (hν : IsGenericCocharacter i ν)
    (hStandard : StandardCocharacterStatement.{u}) (hRoots : HasRelativeRootSystem i)
    (hU : ∀ I, IsClosed (unipotent i ν I : Set (GroupScheme.rationalPoints G)))
    (A : SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G))
    (hcusp : letI := simpleRelativeRootFintype i hRoots hi.isSplitSubtorus.1 ν
      ∀ D : SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G),
        SmoothRep.IsSubquotient D A →
          IsCuspidal (parabolic i ν) (levi i ν) (unipotent i ν)
            (isSemidirectDecomposition_of_standardCocharacterStatement i ν hStandard hG hi hν)
            hU D)
    (hfin : Module.Finite (MonoidAlgebra ℂ (GroupScheme.rationalPoints G))
      A.representation.asModule) :
    IsNoetherian (MonoidAlgebra ℂ (GroupScheme.rationalPoints G)) A.representation.asModule := by
  classical
  let := simpleRelativeRootFintype i hRoots hi.isSplitSubtorus.1 ν
  -- A compact open subgroup fixing a finite generating set.
  obtain ⟨S, hS⟩ := hfin.fg_top
  obtain ⟨K, hKc, -, hKfix⟩ := exists_compactOpen_fixing_finite A.representation A.isSmooth
    (fun x : S => A.representation.asModuleEquiv x.1) Set.univ Filter.univ_mem
  have hgen : SmoothRep.FixedVectorsGenerate K.toSubgroup A :=
    SmoothRep.fixedVectorsGenerate_of_span (S : Set A.representation.asModule) hS
      (fun x hx => hKfix ⟨x, hx⟩)
  -- The finitely many cuspidal inertia classes with nonzero `K`-fixed vectors.
  have hfinC := hFinite F G hG T i hi ν hν hStandard hRoots hU K hKc
  let C := {c : RationalIrreducibleInertiaClass.{u, max u v} G |
    ∃ (π : SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G))
      (hπ : π.IsIrreducible),
      IsCuspidal (parabolic i ν) (levi i ν) (unipotent i ν)
        (isSemidirectDecomposition_of_standardCocharacterStatement i ν hStandard hG hi hν)
        hU π ∧
      rationalIrreducibleInertiaClass G π hπ = c ∧
      Nontrivial (fixedVectors π.representation K.toSubgroup)}
  have : Fintype C := hfinC.fintype
  let π : C → SmoothRep.{0, u, max u v} ℂ (GroupScheme.rationalPoints G) :=
    fun c => Classical.choose c.2
  have hπ : ∀ c : C, ∃ hπ : (π c).IsIrreducible,
      IsCuspidal (parabolic i ν) (levi i ν) (unipotent i ν)
        (isSemidirectDecomposition_of_standardCocharacterStatement i ν hStandard hG hi hν)
        hU (π c) ∧
      rationalIrreducibleInertiaClass G (π c) hπ = c.1 ∧
      Nontrivial (fixedVectors (π c).representation K.toSubgroup) :=
    fun c => Classical.choose_spec c.2
  refine isNoetherian_of_inertiaSplittings π (fun c => ?_) (fun c Y hY hYfin => ?_)
    K.toSubgroup Finset.univ A hfin hgen (fun D hD hDA hDK => ?_)
  · obtain ⟨hirr, hc, -, -⟩ := hπ c
    exact hSplit F G hG T i hi ν hν hStandard hRoots hU (π c) hirr hc
  · obtain ⟨hirr, hc, -, -⟩ := hπ c
    obtain ⟨W, hW⟩ := rationalNormKernelConstituent_of_finiteRestriction hRes F G hG (π c) hirr
    let H := Plancherel.rationalCommonNormKernel G
    let ρ := SmoothRep.subrepresentation (SmoothRep.restrictSubgroup H (π c)) W
    have hρ : ρ.IsIrreducible := hW
    let j : ρ ⟶ SmoothRep.restrictSubgroup H (π c) :=
      SmoothRep.subtype (SmoothRep.restrictSubgroup H (π c)) W
    have hj : Function.Injective (SmoothRep.hom j) :=
      SmoothRep.subtype_injective (SmoothRep.restrictSubgroup H (π c)) W
    obtain ⟨hmem, hEq⟩ :=
      hHom F G hG T i hi ν hν hStandard hRoots hU (π c) hirr hc ρ hρ j hj
    have hR := (hEnd F G hG T i hi ν hν hStandard hRoots hU (π c) hirr hc ρ hρ j hj).2
    exact isNoetherian_of_rationalInertiaBlockProperty (π c) _ hmem hEq hR Y hY hYfin
  · have hDc := hcusp D hDA
    let c : C := ⟨rationalIrreducibleInertiaClass G D hD, D, hD, hDc, rfl, hDK⟩
    refine ⟨c, Finset.mem_univ c, ?_⟩
    obtain ⟨hirr, -, hcls, -⟩ := hπ c
    exact (rationalIrreducibleInertiaClass_eq_iff G (π c) D hirr hD).mp hcls

end Assembly

end Langlands.CuspidalSupport

namespace Langlands.Aubert.General.RepresentedParabolic

open GroupScheme RationalPointFamily

/-- Renard's VI.4.4 consequence used in VI.7.5: finitely generated supercuspidal
representations are Noetherian, in carrier universe `max u v`, from the
standard-cocharacter and relative-root-system structural statements, the
VI.3.3.1 splittings, the finiteness remark of VI.3.4, VI.3.2(ii), VI.4.1 and
VI.4.4. -/
theorem supercuspidalFiniteTypeNoetherian_of_inputs
    (hStandard : StandardCocharacterStatement.{u})
    (hRoot : RelativeRootSystemStatement.{u})
    (hSplit : CuspidalSupport.RationalCuspidalInertiaDecompositionStatement.{u, max u v})
    (hFinite : CuspidalSupport.RationalCuspidalInertiaFinitenessStatement.{u, max u v})
    (hRes : CuspidalSupport.RationalNormKernelFiniteRestrictionStatement.{u, max u v})
    (hHom : CuspidalSupport.RationalSummandHomEquivalenceStatement.{u, max u v})
    (hEnd : CuspidalSupport.RationalSummandEndNoetherianStatement.{u, max u v}) :
    SupercuspidalFiniteTypeNoetherianStatement.{u, max u v} := by
  intro k _ _ _ _ _ G hG _ _ A hA hfin
  have := hG.isAffineHom
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have := hG.smooth
  let : TopologicalSpace (rationalPoints G) := pointTopology
  have : T2Space (rationalPoints G) := rationalPoint_t2Space k G
  obtain ⟨T, i, ν, hi, hν⟩ := exists_maximalSplitTorus_genericCocharacter hG
  have := hi.isSplitSubtorus.mono
  have hRoots := hRoot k G hG T i hi
  let := simpleRelativeRootFintype i hRoots hi.isSplitSubtorus.1 ν
  have hU := isClosed_unipotent_of_isNonarchimedeanLocalField i ν
  exact CuspidalSupport.isNoetherian_of_allCuspidalSubquotients hSplit hFinite hRes hHom hEnd
    hG i hi ν hν hStandard hRoots hU A
    (fun D hD => isCuspidal_of_all_represented_parabolics_of_standardCocharacter
      i ν hStandard hG hi hν hRoots hU D (IsSupercuspidal.of_isSubquotient hD hA)) hfin

/-- The Proposition of VI.7.5 in carrier universe `v` follows from the
Proposition in carrier universe `max u v`, by raising carriers: finite
generation and Noetherianity are unchanged by the universe lift. -/
theorem smoothRepNoetherianCategory_of_universeLift
    (h : SmoothRepNoetherianCategoryStatement.{u, max u v}) :
    SmoothRepNoetherianCategoryStatement.{u, v} := by
  intro k _ _ _ _ _ G hG _ _
  have := hG.isAffineHom
  let : TopologicalSpace (rationalPoints G) := pointTopology
  refine ⟨SmoothRep.hasAllSubobjectUnions, fun X hX => ?_⟩
  have hLfin : Module.Finite (MonoidAlgebra ℂ (rationalPoints G))
      (SmoothRep.universeLift.{u} X).representation.asModule :=
    (SmoothRep.moduleFinite_universeLift_iff X).mpr ((SmoothRep.renardFiniteType_iff X).mp hX)
  have hL : IsNoetherian (MonoidAlgebra ℂ (rationalPoints G))
      (SmoothRep.universeLift.{u} X).representation.asModule :=
    (SmoothRep.renardNoetherian_iff _).mp
      ((h k G hG).2 _ ((SmoothRep.renardFiniteType_iff _).mpr hLfin))
  exact (SmoothRep.renardNoetherian_iff X).mpr
    (isNoetherian_of_surjective
      (Representation.IntertwiningMap.equivLinearMapAsModule _ _
        (SmoothRep.universeLiftEquiv.{u} X).symm.toIntertwiningMap)
      (LinearMap.range_eq_top.mpr (SmoothRep.universeLiftEquiv.{u} X).symm.surjective))

/-- The Proposition of VI.7.5 in every carrier universe, from Worker 1582's
reduction `smoothRepNoetherianCategory_of_inputs` in carrier universe
`max u v`, with its supercuspidal input supplied by
`supercuspidalFiniteTypeNoetherian_of_inputs`. -/
theorem smoothRepNoetherianCategory_of_blockInputs
    (hStandard : StandardCocharacterStatement.{u})
    (hRoot : RelativeRootSystemStatement.{u})
    (hSplit : CuspidalSupport.RationalCuspidalInertiaDecompositionStatement.{u, max u v})
    (hFinite : CuspidalSupport.RationalCuspidalInertiaFinitenessStatement.{u, max u v})
    (hRes : CuspidalSupport.RationalNormKernelFiniteRestrictionStatement.{u, max u v})
    (hHom : CuspidalSupport.RationalSummandHomEquivalenceStatement.{u, max u v})
    (hEnd : CuspidalSupport.RationalSummandEndNoetherianStatement.{u, max u v})
    (h1 : LeviJacquetFiniteTypeStatement.{u, max u v})
    (h2 : RepresentedCuspidalRemainderSplittingStatement.{u, max u v})
    (h4 : FiniteProperParabolicSupercuspidalTestStatement.{u, max u v}) :
    SmoothRepNoetherianCategoryStatement.{u, v} :=
  smoothRepNoetherianCategory_of_universeLift
    (smoothRepNoetherianCategory_of_inputs h1 h2
      (supercuspidalFiniteTypeNoetherian_of_inputs hStandard hRoot hSplit hFinite hRes hHom hEnd)
      h4)

end Langlands.Aubert.General.RepresentedParabolic
