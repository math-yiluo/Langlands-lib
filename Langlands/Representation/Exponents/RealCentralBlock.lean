import Langlands.Representation.Exponents.Central
import Langlands.Representation.Classification.ProductLeviCentralCharacter
import Mathlib.LinearAlgebra.Span.Basic

/-! Actual subrepresentations obtained by grouping generalized central characters. -/

noncomputable section

namespace Langlands

universe uR uG uV uW uF

section Generic

variable {R : Type uR} [CommRing R] {G : Type uG} [Group G]
  {V : Type uV} [AddCommGroup V] [Module R V]
  {W : Type uW} [AddCommGroup W] [Module R W]

/-- The actual subrepresentation generated by generalized central-character
spaces whose characters satisfy `P`. -/
def groupedCentralCharacterSpace (ρ : Representation R G V)
    (P : (Subgroup.center G →* Rˣ) → Prop) : Subrepresentation ρ where
  toSubmodule := ⨆ χ : {χ : Subgroup.center G →* Rˣ // P χ},
    (generalizedCentralCharacterSpace ρ χ.val).toSubmodule
  apply_mem_toSubmodule g := by
    intro v hv
    refine Submodule.iSup_induction
      (fun χ : {χ : Subgroup.center G →* Rˣ // P χ} =>
        (generalizedCentralCharacterSpace ρ χ.val).toSubmodule)
      (motive := fun w => ρ g w ∈ ⨆ χ : {χ : Subgroup.center G →* Rˣ // P χ},
        (generalizedCentralCharacterSpace ρ χ.val).toSubmodule)
      hv ?_ ?_ ?_
    · intro χ w hw
      exact Submodule.mem_iSup_of_mem χ
        ((generalizedCentralCharacterSpace ρ χ.val).apply_mem_toSubmodule g hw)
    · simp
    · intro v w hv hw
      simpa using Submodule.add_mem _ hv hw

theorem generalizedCentralCharacterSpace_le_grouped
    (ρ : Representation R G V) (P : (Subgroup.center G →* Rˣ) → Prop)
    (χ : Subgroup.center G →* Rˣ) (hχ : P χ) :
    generalizedCentralCharacterSpace ρ χ ≤ groupedCentralCharacterSpace ρ P := by
  intro v hv
  exact Submodule.mem_iSup_of_mem ⟨χ, hχ⟩ hv

theorem groupedCentralCharacterSpace_mono (ρ : Representation R G V)
    {P Q : (Subgroup.center G →* Rˣ) → Prop} (hPQ : ∀ χ, P χ → Q χ) :
    groupedCentralCharacterSpace ρ P ≤ groupedCentralCharacterSpace ρ Q := by
  intro v hv
  change v ∈ ⨆ χ : {χ : Subgroup.center G →* Rˣ // P χ},
    (generalizedCentralCharacterSpace ρ χ.val).toSubmodule at hv
  refine Submodule.iSup_induction _ (motive := fun w =>
    w ∈ groupedCentralCharacterSpace ρ Q) hv ?_ ?_ ?_
  · intro χ w hw
    exact generalizedCentralCharacterSpace_le_grouped ρ Q χ.val
      (hPQ χ.val χ.property) hw
  · exact Submodule.zero_mem _
  · intro v w hv hw
    exact Submodule.add_mem _ hv hw

variable {ρ : Representation R G V} {σ : Representation R G W}

/-- Intertwiners preserve every group of generalized central characters. -/
theorem map_mem_groupedCentralCharacterSpace (f : ρ.IntertwiningMap σ)
    (P : (Subgroup.center G →* Rˣ) → Prop) {v : V}
    (hv : v ∈ groupedCentralCharacterSpace ρ P) :
    f v ∈ groupedCentralCharacterSpace σ P := by
  change v ∈ ⨆ χ : {χ : Subgroup.center G →* Rˣ // P χ},
    (generalizedCentralCharacterSpace ρ χ.val).toSubmodule at hv
  refine Submodule.iSup_induction _ (motive := fun w =>
    f w ∈ groupedCentralCharacterSpace σ P) hv ?_ ?_ ?_
  · intro χ w hw
    exact generalizedCentralCharacterSpace_le_grouped σ P χ.val χ.property
      (map_mem_generalizedCentralCharacterSpace f χ.val hw)
  · change f (0 : V) ∈ (groupedCentralCharacterSpace σ P).toSubmodule
    rw [map_zero]
    exact Submodule.zero_mem _
  · intro v w hv hw
    change f (v + w) ∈ (groupedCentralCharacterSpace σ P).toSubmodule
    rw [map_add]
    exact Submodule.add_mem _ hv hw

/-- The restriction of an actual intertwiner to grouped generalized spaces. -/
def groupedCentralCharacterMap (f : ρ.IntertwiningMap σ)
    (P : (Subgroup.center G →* Rˣ) → Prop) :
    (groupedCentralCharacterSpace ρ P).toRepresentation.IntertwiningMap
      (groupedCentralCharacterSpace σ P).toRepresentation where
  toFun v := ⟨f v, map_mem_groupedCentralCharacterSpace f P v.property⟩
  map_add' v w := Subtype.ext (map_add f (v : V) (w : V))
  map_smul' c v := Subtype.ext (map_smul f c (v : V))
  isIntertwining' g := by
    apply LinearMap.ext
    intro v
    apply Subtype.ext
    exact Representation.IntertwiningMap.isIntertwining ρ σ f g (v : V)

@[simp]
theorem groupedCentralCharacterMap_apply (f : ρ.IntertwiningMap σ)
    (P : (Subgroup.center G →* Rˣ) → Prop)
    (v : (groupedCentralCharacterSpace ρ P).toSubmodule) :
    ((groupedCentralCharacterMap f P v :
      (groupedCentralCharacterSpace σ P).toSubmodule) : W) = f (v : V) := rfl

/-- An actual ambient equivalence restricts to the same grouped characters. -/
def groupedCentralCharacterEquiv (e : ρ.Equiv σ)
    (P : (Subgroup.center G →* Rˣ) → Prop) :
    (groupedCentralCharacterSpace ρ P).toRepresentation.Equiv
      (groupedCentralCharacterSpace σ P).toRepresentation where
  __ := groupedCentralCharacterMap e.toIntertwiningMap P
  invFun := groupedCentralCharacterMap e.symm.toIntertwiningMap P
  left_inv v := Subtype.ext (e.symm_apply_apply v)
  right_inv v := Subtype.ext (e.apply_symm_apply v)

/-- A selected exact scalar character places the entire representation in
the corresponding grouped generalized space. -/
theorem groupedCentralCharacterSpace_eq_top_of_scalar
    (ρ : Representation R G V) (P : (Subgroup.center G →* Rˣ) → Prop)
    (χ : Subgroup.center G →* Rˣ) (hχ : P χ)
    (hscalar : ∀ (z : Subgroup.center G) (v : V),
      ρ (z : G) v = (χ z : R) • v) :
    groupedCentralCharacterSpace ρ P = ⊤ := by
  apply le_antisymm le_top
  intro v _
  apply generalizedCentralCharacterSpace_le_grouped ρ P χ hχ
  exact (mem_generalizedCentralCharacterSpace ρ χ v).mpr
    ⟨1, (mem_centralCharacterSpace ρ χ 1 v).mp
      ((mem_centralCharacterSpace_one ρ χ v).mpr fun z => hscalar z v)⟩

end Generic

namespace PadicField.TopologicalData

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{uF} p} (T : F.TopologicalData)
  {n : ℕ} (B : GeneralLinear.BlockShape n)
  {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {W : Type uW} [AddCommGroup W] [Module ℂ W]

/-- The actual sum of the generalized full-central-character spaces for
open-kernel characters whose block-scalar restrictions have real part `x`. -/
def realCentralBlock (ρ : Representation ℂ (B.Levi F.Carrier) V)
    (x : Fin B.length → ℝ) : Subrepresentation ρ :=
  groupedCentralCharacterSpace ρ
    (fun χ => letI := T.topology
      IsOpen (χ.ker : Set (Subgroup.center (B.Levi F.Carrier))) ∧
        T.IsRealPartOf (χ.comp (B.blockScalarToCenter F.Carrier)) x)

/-- The generalized space of a qualifying full central character lies in the
real central block. -/
theorem generalizedCentralCharacterSpace_le_realCentralBlock
    (ρ : Representation ℂ (B.Levi F.Carrier) V) (x : Fin B.length → ℝ)
    (χ : Subgroup.center (B.Levi F.Carrier) →* ℂˣ)
    (hopen : letI := T.topology
      IsOpen (χ.ker : Set (Subgroup.center (B.Levi F.Carrier))))
    (hx : T.IsRealPartOf (χ.comp (B.blockScalarToCenter F.Carrier)) x) :
    generalizedCentralCharacterSpace ρ χ ≤ T.realCentralBlock B ρ x :=
  generalizedCentralCharacterSpace_le_grouped ρ _ χ ⟨hopen, hx⟩

/-- Restrict an actual intertwiner to one real central block. -/
def realCentralBlockMap
    {ρ : Representation ℂ (B.Levi F.Carrier) V}
    {σ : Representation ℂ (B.Levi F.Carrier) W} (f : ρ.IntertwiningMap σ)
    (x : Fin B.length → ℝ) :
    (T.realCentralBlock B ρ x).toRepresentation.IntertwiningMap
      (T.realCentralBlock B σ x).toRepresentation :=
  groupedCentralCharacterMap f _

/-- Restrict an actual equivariant equivalence to one real central block. -/
def realCentralBlockEquiv
    {ρ : Representation ℂ (B.Levi F.Carrier) V}
    {σ : Representation ℂ (B.Levi F.Carrier) W} (e : ρ.Equiv σ)
    (x : Fin B.length → ℝ) :
    (T.realCentralBlock B ρ x).toRepresentation.Equiv
      (T.realCentralBlock B σ x).toRepresentation :=
  groupedCentralCharacterEquiv e _

end PadicField.TopologicalData

end Langlands
