import Langlands.GroupScheme.Rational.WallCharacterSum
import Langlands.GroupScheme.Rational.CharacterRestrictionRational
import Langlands.GroupScheme.Rational.RelativeCharacterComplementReduction
import Langlands.GroupScheme.Rational.SplitTorusCharacterRestriction

/-! # A single rational character direction for a maximal proper Levi -/

noncomputable section

open CategoryTheory AlgebraicGeometry TensorProduct
open Langlands.GroupScheme Langlands.LinearAlgebra.RationalSpan
open Langlands.LinearAlgebra.InvariantFormComplements
open scoped CategoryTheory.MonObj

namespace Langlands.Plancherel.MaximalLeviCharacterDirection

universe u

variable {k : Type u} [Field k]
  {A T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G P M : GroupScheme (Spec (CommRingCat.of k))}

/-- A rationalized character annihilating the integral kernel of an
integral character lies on that character's rational line. -/
theorem mem_line_of_pair_kernel
    (hA : IsSplitTorus A.toGrp) (alpha : characterLattice A)
    (x : ℚ ⊗[ℤ] characterLattice A)
    (hx : ∀ nu : cocharacterLattice A, latticePairing A alpha nu = 0 →
      WallCharacterSum.ratPairing nu x = 0) :
    x ∈ Submodule.span ℚ {toRat alpha} := by
  by_cases hall : ∀ nu : cocharacterLattice A, latticePairing A alpha nu = 0
  · have hx0 : x = 0 := WallCharacterSum.eq_zero_of_ratPairing hA (fun nu => hx nu (hall nu))
    rw [hx0]
    exact Submodule.zero_mem _
  · push Not at hall
    obtain ⟨nu0, hnu0⟩ := hall
    have hn : ((latticePairing A alpha nu0 : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hnu0
    apply Submodule.mem_span_singleton.mpr
    refine ⟨WallCharacterSum.ratPairing nu0 x / (latticePairing A alpha nu0 : ℚ), ?_⟩
    apply sub_eq_zero.mp
    apply WallCharacterSum.eq_zero_of_ratPairing hA
    intro nu
    have hw : latticePairing A alpha
        (latticePairing A alpha nu0 • nu - latticePairing A alpha nu • nu0) = 0 := by
      rw [map_sub, map_zsmul, map_zsmul, smul_eq_mul, smul_eq_mul, mul_comm, sub_self]
    have hh := hx _ hw
    rw [WallCharacterSum.ratPairing_zsmul_sub, sub_eq_zero] at hh
    rw [map_sub, map_smul, toRat_apply, WallCharacterSum.ratPairing_tmul, one_mul, smul_eq_mul]
    apply sub_eq_zero.mpr
    rw [div_mul_eq_mul_div, div_eq_iff hn]
    nlinarith [hh]

/-- The rational character space is generated by ambient restrictions and
one integral character. -/
abbrev HasOneRationalDirection (f : M ⟶ G) : Prop :=
  ∃ chi0 : rationalCharacters M,
    ∀ x : ℚ ⊗[ℤ] rationalCharacters M,
      ∃ c : ℚ, ∃ y : ℚ ⊗[ℤ] rationalCharacters G,
        x = c • toRat chi0 + rationalCharacterRestrictRat f y

variable (hG : IsConnectedReductive G)
  {p : P ⟶ G} {l : M ⟶ P} {a : A.toGrp ⟶ M}
  (hp : IsParabolicSubgroup p) (hl : IsRationalLeviSubgroup l)
  (hproper : ¬ IsIso p)
  (hmax : ∀ (Q : GroupScheme (Spec (CommRingCat.of k))) (q : Q ⟶ G) (j : P ⟶ Q),
    IsParabolicSubgroup q → j ≫ q = p → IsIso j ∨ IsIso q)
  (ha : IsSplitComponent a)

include hG hp hl hproper hmax ha

/-- Every rationalized character of the actual Levi of a maximal proper
parabolic is an ambient restriction plus one rational character direction. -/
theorem exists_one_rational_direction :
    HasOneRationalDirection (l ≫ p) := by
  have : IsAffineHom G.X.hom := hG.isAffineHom
  have : Smooth G.X.hom := hG.smooth
  have : LocallyOfFiniteType G.X.hom := inferInstance
  have hM := hl.isConnectedReductive
  have : IsAffineHom M.X.hom := hM.isAffineHom
  have hA : IsSplitTorus A.toGrp := ha.1.1.1
  obtain ⟨alpha, halpha⟩ :=
    hasCentralKernelCharacter_of_maximal parabolicDynamic hG hp hl hproper hmax ha
  obtain ⟨T, iG, hiG, iM, hiM⟩ :=
    ParabolicLeviTorus.exists_maximalSplitTorus_factor parabolicDynamic hG hp hl
  have hj : IsClosedSubgroup (l ≫ p) := hl.isClosedSubgroup.comp hp.isClosedSubgroup
  have ht : IsMaximalSplitTorus (iM ≫ (l ≫ p)) := by
    simpa only [Category.assoc, hiM] using hiG
  obtain ⟨g, hg⟩ := ha.isCentralSplitTorus.exists_factor_of_isMaximalSplitTorus hj ht
  let af : A ⟶ T := Additive.ofMul g
  have hmonoA : Mono a.hom.hom.left := ha.isCentralSplitTorus.1.mono
  have hmonoG : Mono g.hom.hom.left := by
    apply mono_of_mono_fac (congrArg (fun z => z.hom.hom.left) hg)
  let := hmonoG
  have hfactor : CommGroupScheme.groupHom af ≫ iG = a ≫ l ≫ p := by
    rw [← hiM]
    change g ≫ iM ≫ l ≫ p = _
    rw [← Category.assoc g iM, hg]
  have hsurj : Function.Surjective (rationalCharacterRestrictRat (CommGroupScheme.groupHom af)) :=
    hA.rationalCharacterRestrictRat_surjective_of_mono hiG.isSplitSubtorus.1 g
  have hrootline (s : ℚ ⊗[ℤ] characterLattice T) (hs : s ∈ relativeRootSpan iG) :
      rationalCharacterRestrictRat (CommGroupScheme.groupHom af) s ∈
        Submodule.span ℚ {toRat alpha} := by
    apply mem_line_of_pair_kernel hA alpha
    intro nu hnu
    exact WallCharacterSum.ratPairing_restrict_eq_zero_of_isCentral iG af hfactor
      (halpha nu hnu) hs
  have hdecomp (x : ℚ ⊗[ℤ] characterLattice A) :
      ∃ c : ℚ, ∃ y : ℚ ⊗[ℤ] rationalCharacters G,
        x = c • toRat alpha + rationalCharacterRestrictRat (a ≫ l ≫ p) y := by
    obtain ⟨s, hs⟩ := hsurj x
    have hmem : s ∈ relativeRootSpan iG ⊔ (rationalCharacterRestrictRat iG).range := by
      rw [hG.relativeRootSpan_isCompl_restrictionRange iG hiG |>.sup_eq_top]
      exact Submodule.mem_top
    obtain ⟨r, hr, _, ⟨y, rfl⟩, hsum⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hrootline r hr)
    refine ⟨c, y, ?_⟩
    calc
      x = rationalCharacterRestrictRat (CommGroupScheme.groupHom af) s := hs.symm
      _ = rationalCharacterRestrictRat (CommGroupScheme.groupHom af)
          (r + rationalCharacterRestrictRat iG y) := congrArg _ hsum.symm
      _ = c • toRat alpha + rationalCharacterRestrictRat (a ≫ l ≫ p) y := by
        rw [map_add, ← hc, ← LinearMap.comp_apply, ← rationalCharacterRestrictRat_comp,
          hfactor]
  obtain ⟨hinj, hindex⟩ := characterRestriction k M hM A a ha
  let e := rationalCharacterRestrictRatEquiv a hinj hindex
  obtain ⟨n, hn, chi0, hchi0⟩ := exists_nsmul_eq_one_tmul (e.symm (toRat alpha))
  have hnq : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
  have he0 : rationalCharacterRestrictRat a (toRat chi0) = (n : ℚ) • toRat alpha := by
    rw [toRat_apply, ← hchi0, map_smul]
    change (n : ℚ) • e (e.symm (toRat alpha)) = _
    rw [LinearEquiv.apply_symm_apply]
  refine ⟨chi0, fun x => ?_⟩
  obtain ⟨c, y, hxy⟩ := hdecomp (rationalCharacterRestrictRat a x)
  refine ⟨c / (n : ℚ), y, e.injective ?_⟩
  change rationalCharacterRestrictRat a x =
    rationalCharacterRestrictRat a
      ((c / (n : ℚ)) • toRat chi0 + rationalCharacterRestrictRat (l ≫ p) y)
  rw [map_add, map_smul, he0, smul_smul, div_mul_cancel₀ _ hnq,
    ← LinearMap.comp_apply, ← rationalCharacterRestrictRat_comp]
  exact hxy

end Langlands.Plancherel.MaximalLeviCharacterDirection
