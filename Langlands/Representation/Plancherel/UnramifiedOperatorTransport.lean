import Langlands.Representation.Plancherel.UnramifiedCharacterTransport
import Langlands.Representation.Plancherel.UnramifiedOperatorFamilies

/-! # Regular operator families under actual character transport -/

noncomputable section

open scoped NNReal

namespace Langlands.Plancherel

universe uA uB uI uV uW

variable {A : Type uA} [Group A] [TopologicalSpace A]
  {B : Type uB} [Group B] [TopologicalSpace B] {I : Type uI}
  (e : A ≃ₜ* B) (ν : I → (A →* ℝ≥0ˣ))

private def functionTransport :
    (unramifiedCharacters ν → ℂ) ≃ₐ[ℂ]
      (unramifiedCharacters (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom) → ℂ) where
  toFun f χ := f ((unramifiedCharactersHomeomorph e ν).symm χ)
  invFun f χ := f (unramifiedCharactersHomeomorph e ν χ)
  left_inv f := by
    funext χ
    exact congrArg f ((unramifiedCharactersHomeomorph e ν).symm_apply_apply χ)
  right_inv f := by
    funext χ
    exact congrArg f ((unramifiedCharactersHomeomorph e ν).apply_symm_apply χ)
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

private theorem functionTransport_evaluation (a : A) :
    functionTransport e ν (unramifiedEvaluation ν a) =
      unramifiedEvaluation (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom) (e a) := by
  funext χ
  rfl

private theorem regularFunctions_map :
    (unramifiedRegularFunctions ν).map (functionTransport e ν).toAlgHom =
      unramifiedRegularFunctions (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom) := by
  unfold unramifiedRegularFunctions
  rw [AlgHom.map_adjoin]
  congr 1
  ext f
  constructor
  · rintro ⟨_, ⟨a, rfl⟩, rfl⟩
    exact ⟨e a, (functionTransport_evaluation e ν a).symm⟩
  · rintro ⟨b, rfl⟩
    refine ⟨unramifiedEvaluation ν (e.symm b), ⟨e.symm b, rfl⟩, ?_⟩
    change functionTransport e ν (unramifiedEvaluation ν (e.symm b)) = _
    rw [functionTransport_evaluation, e.apply_symm_apply]

/-- Precomposition by the inverse character homeomorphism restricts to an
equivalence of the algebras generated by all actual evaluations. -/
def unramifiedRegularFunctionsEquiv :
    unramifiedRegularFunctions ν ≃ₐ[ℂ]
      unramifiedRegularFunctions (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom) :=
  ((functionTransport e ν).subalgebraMap (unramifiedRegularFunctions ν)).trans
    (Subalgebra.equivOfEq _ _ (regularFunctions_map e ν))

@[simp]
theorem unramifiedRegularFunctionsEquiv_apply (b : unramifiedRegularFunctions ν)
    (χ : unramifiedCharacters (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom)) :
    (unramifiedRegularFunctionsEquiv e ν b).val χ =
      b.val ((unramifiedCharactersHomeomorph e ν).symm χ) := rfl

@[simp]
theorem unramifiedRegularFunctionsEquiv_symm_apply
    (b : unramifiedRegularFunctions (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom))
    (χ : unramifiedCharacters ν) :
    ((unramifiedRegularFunctionsEquiv e ν).symm b).val χ =
      b.val (unramifiedCharactersHomeomorph e ν χ) := by
  have h := congrArg
    (fun c => c.val (unramifiedCharactersHomeomorph e ν χ))
    ((unramifiedRegularFunctionsEquiv e ν).apply_symm_apply b)
  simpa only [unramifiedRegularFunctionsEquiv_apply,
    (unramifiedCharactersHomeomorph e ν).symm_apply_apply] using h

@[simp]
theorem unramifiedRegularFunctionsEquiv_evaluation (a : A) :
    unramifiedRegularFunctionsEquiv e ν (unramifiedEvaluationRegular ν a) =
      unramifiedEvaluationRegular
        (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom) (e a) := by
  apply Subtype.ext
  exact functionTransport_evaluation e ν a

/-- The exact parameter-subset identification for pullback along the
canonical character homeomorphism. -/
def unramifiedParameterPreimageEquiv
    (Ω : Set (unramifiedCharacters (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom))) :
    ((unramifiedCharactersHomeomorph e ν) ⁻¹' Ω) ≃ Ω :=
  (unramifiedCharactersHomeomorph e ν).toEquiv.subtypeEquiv (fun _ => Iff.rfl)

@[simp]
theorem unramifiedParameterPreimageEquiv_apply
    (Ω : Set (unramifiedCharacters (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom)))
    (χ : (unramifiedCharactersHomeomorph e ν) ⁻¹' Ω) :
    (unramifiedParameterPreimageEquiv e ν Ω χ).val =
      unramifiedCharactersHomeomorph e ν χ.val := rfl

@[simp]
theorem unramifiedParameterPreimageEquiv_symm_apply
    (Ω : Set (unramifiedCharacters (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom)))
    (χ : Ω) :
    ((unramifiedParameterPreimageEquiv e ν Ω).symm χ).val =
      (unramifiedCharactersHomeomorph e ν).symm χ.val := rfl

namespace UnramifiedOperatorFamily

variable {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {W : Type uW} [AddCommGroup W] [Module ℂ W]
  (Ω : Set (unramifiedCharacters (fun j => (ν j).comp e.symm.toMulEquiv.toMonoidHom)))

/-- Polynomial finite expansions are preserved in both directions on the
exact corresponding parameter subsets. -/
theorem isPolynomialOn_transport_iff (f : Ω → V) :
    IsPolynomialOn ((unramifiedCharactersHomeomorph e ν) ⁻¹' Ω)
        (fun χ => f (unramifiedParameterPreimageEquiv e ν Ω χ)) ↔
      IsPolynomialOn Ω f := by
  constructor
  · rintro ⟨n, b, v, hf⟩
    refine ⟨n, fun i => unramifiedRegularFunctionsEquiv e ν (b i), v, ?_⟩
    intro χ
    have h := hf ((unramifiedParameterPreimageEquiv e ν Ω).symm χ)
    simp only [Equiv.apply_symm_apply] at h
    simpa only [unramifiedRegularFunctionsEquiv_apply,
      unramifiedParameterPreimageEquiv_symm_apply] using h
  · rintro ⟨n, b, v, hf⟩
    refine ⟨n, fun i => (unramifiedRegularFunctionsEquiv e ν).symm (b i), v, ?_⟩
    intro χ
    simpa only [unramifiedRegularFunctionsEquiv_symm_apply,
      unramifiedParameterPreimageEquiv_apply] using
        hf (unramifiedParameterPreimageEquiv e ν Ω χ)

theorem isPolynomialOperatorOn_transport_iff (T : Ω → V →ₗ[ℂ] W) :
    IsPolynomialOperatorOn ((unramifiedCharactersHomeomorph e ν) ⁻¹' Ω)
        (fun χ => T (unramifiedParameterPreimageEquiv e ν Ω χ)) ↔
      IsPolynomialOperatorOn Ω T :=
  forall_congr' (fun v => isPolynomialOn_transport_iff e ν Ω (fun χ => T χ v))

/-- Rationality transports a single denominator for the entire operator,
with the same finite numerator expansions and fixed vectors. -/
theorem isRationalOperatorOn_transport_iff (T : Ω → V →ₗ[ℂ] W) :
    IsRationalOperatorOn ((unramifiedCharactersHomeomorph e ν) ⁻¹' Ω)
        (fun χ => T (unramifiedParameterPreimageEquiv e ν Ω χ)) ↔
      IsRationalOperatorOn Ω T := by
  constructor
  · rintro ⟨b, hb, hT⟩
    refine ⟨unramifiedRegularFunctionsEquiv e ν b, ?_, ?_⟩
    · intro χ
      simpa only [unramifiedRegularFunctionsEquiv_apply,
        unramifiedParameterPreimageEquiv_symm_apply] using
          hb ((unramifiedParameterPreimageEquiv e ν Ω).symm χ)
    · apply (isPolynomialOperatorOn_transport_iff e ν Ω _).mp
      simpa only [unramifiedRegularFunctionsEquiv_apply,
        unramifiedParameterPreimageEquiv_apply,
        (unramifiedCharactersHomeomorph e ν).symm_apply_apply] using hT
  · rintro ⟨b, hb, hT⟩
    refine ⟨(unramifiedRegularFunctionsEquiv e ν).symm b, ?_, ?_⟩
    · intro χ
      simpa only [unramifiedRegularFunctionsEquiv_symm_apply,
        unramifiedParameterPreimageEquiv_apply] using
          hb (unramifiedParameterPreimageEquiv e ν Ω χ)
    · simpa only [unramifiedRegularFunctionsEquiv_symm_apply,
        unramifiedParameterPreimageEquiv_apply] using
          (isPolynomialOperatorOn_transport_iff e ν Ω
            (fun χ => b.val χ.val • T χ)).mpr hT

end UnramifiedOperatorFamily

end Langlands.Plancherel
