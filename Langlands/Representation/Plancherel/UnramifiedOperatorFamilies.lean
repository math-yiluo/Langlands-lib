import Langlands.Representation.Plancherel.UnramifiedCharacters
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.Module.LinearMap.Basic

/-!
# Polynomial and rational families on actual unramified characters

The scalar algebra is generated by actual character evaluations. Polynomial
vector families have finite expansions in fixed vectors. A rational operator
family has one denominator for all input vectors, as in Waldspurger IV.1.
No convergence or continuation theorem is asserted.
-/

noncomputable section

open scoped NNReal BigOperators

namespace Langlands.Plancherel

universe uG uI uV uW uZ

variable {G : Type uG} [Group G] [TopologicalSpace G]
  {I : Type uI} (ν : I → (G →* ℝ≥0ˣ))

/-- The evaluation polynomial `b_g(χ) = χ(g)` on actual unramified characters. -/
def unramifiedEvaluation (g : G) : unramifiedCharacters ν → ℂ :=
  fun χ => (χ.val g : ℂ)

/-- The concrete scalar algebra generated by all actual character evaluations.
The rational-character specialization and its algebraic-torus comparison are
separate from this construction for an arbitrary family of norm characters. -/
def unramifiedRegularFunctions : Subalgebra ℂ (unramifiedCharacters ν → ℂ) :=
  Algebra.adjoin ℂ (Set.range (unramifiedEvaluation ν))

/-- An actual character evaluation, as an element of the generated algebra. -/
def unramifiedEvaluationRegular (g : G) : unramifiedRegularFunctions ν :=
  ⟨unramifiedEvaluation ν g, Algebra.subset_adjoin ⟨g, rfl⟩⟩

@[simp]
theorem unramifiedEvaluationRegular_apply (g : G) (χ : unramifiedCharacters ν) :
    (unramifiedEvaluationRegular ν g).val χ = (χ.val g : ℂ) := rfl

@[simp]
theorem unramifiedEvaluationRegular_mul (g h : G) :
    unramifiedEvaluationRegular ν (g * h) =
      unramifiedEvaluationRegular ν g * unramifiedEvaluationRegular ν h := by
  apply Subtype.ext
  funext χ
  simp [unramifiedEvaluationRegular, unramifiedEvaluation]

@[simp]
theorem unramifiedEvaluationRegular_one :
    unramifiedEvaluationRegular ν (1 : G) = 1 := by
  apply Subtype.ext
  funext χ
  simp [unramifiedEvaluationRegular, unramifiedEvaluation]

/-- Inverse evaluations are already in the algebra; these are Laurent
generators, rather than only nonnegative powers of coordinates. -/
theorem unramifiedEvaluationRegular_inv_mul (g : G) :
    unramifiedEvaluationRegular ν g⁻¹ * unramifiedEvaluationRegular ν g = 1 := by
  rw [← unramifiedEvaluationRegular_mul, inv_mul_cancel, unramifiedEvaluationRegular_one]

namespace UnramifiedOperatorFamily

variable {ν}
  {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {W : Type uW} [AddCommGroup W] [Module ℂ W]
  {Z : Type uZ} [AddCommGroup Z] [Module ℂ Z]
  {U : Set (unramifiedCharacters ν)}

/-- A finite expansion in fixed vectors, with regular scalar coefficients.
This is the restriction condition on any parameter subset; openness and descent
to a representation orbit are separate conditions in source applications. -/
def IsPolynomialOn (U : Set (unramifiedCharacters ν)) (f : U → V) : Prop :=
  ∃ (n : ℕ) (b : Fin n → unramifiedRegularFunctions ν) (v : Fin n → V),
    ∀ χ : U, f χ = ∑ i, (b i).val χ.val • v i

/-- Polynomiality is tested on each fixed input vector. -/
def IsPolynomialOperatorOn (U : Set (unramifiedCharacters ν))
    (A : U → V →ₗ[ℂ] W) : Prop :=
  ∀ v, IsPolynomialOn U (fun χ => A χ v)

/-- One scalar regular denominator is chosen for the entire operator family.
It is nonzero everywhere on the given parameter subset; each input vector may
have its own finite numerator expansion. -/
def IsRationalOperatorOn (U : Set (unramifiedCharacters ν))
    (A : U → V →ₗ[ℂ] W) : Prop :=
  ∃ b : unramifiedRegularFunctions ν,
    (∀ χ : U, b.val χ.val ≠ 0) ∧
      IsPolynomialOperatorOn U (fun χ => b.val χ.val • A χ)

theorem isPolynomialOn_const (v : V) :
    IsPolynomialOn U (fun _ => v) := by
  refine ⟨1, fun _ => 1, fun _ => v, ?_⟩
  intro χ
  simp

theorem IsPolynomialOn.add {f g : U → V}
    (hf : IsPolynomialOn U f) (hg : IsPolynomialOn U g) :
    IsPolynomialOn U (fun χ => f χ + g χ) := by
  obtain ⟨n, b, v, hf⟩ := hf
  obtain ⟨m, c, w, hg⟩ := hg
  refine ⟨n + m, Fin.addCases b c, Fin.addCases v w, ?_⟩
  intro χ
  dsimp only
  rw [hf, hg, Fin.sum_univ_add]
  simp

/-- Multiplication by any one scalar regular function preserves a finite
vector expansion. -/
theorem IsPolynomialOn.regular_smul {f : U → V}
    (hf : IsPolynomialOn U f) (c : unramifiedRegularFunctions ν) :
    IsPolynomialOn U (fun χ => c.val χ.val • f χ) := by
  obtain ⟨n, b, v, hf⟩ := hf
  refine ⟨n, fun i => c * b i, v, ?_⟩
  intro χ
  dsimp only
  rw [hf, Finset.smul_sum]
  simp only [Subalgebra.coe_mul, Pi.mul_apply, mul_smul]

theorem IsPolynomialOn.linearMap {f : U → V}
    (hf : IsPolynomialOn U f) (T : V →ₗ[ℂ] W) :
    IsPolynomialOn U (fun χ => T (f χ)) := by
  obtain ⟨n, b, v, hf⟩ := hf
  refine ⟨n, b, fun i => T (v i), ?_⟩
  intro χ
  dsimp only
  rw [hf, map_sum]
  simp only [map_smul]

theorem IsPolynomialOn.restrict {f : U → V}
    (hf : IsPolynomialOn U f) {U' : Set (unramifiedCharacters ν)} (hU' : U' ⊆ U) :
    IsPolynomialOn U' (fun χ => f ⟨χ.val, hU' χ.property⟩) := by
  obtain ⟨n, b, v, hf⟩ := hf
  exact ⟨n, b, v, fun χ => hf ⟨χ.val, hU' χ.property⟩⟩

theorem isPolynomialOperatorOn_const (T : V →ₗ[ℂ] W) :
    IsPolynomialOperatorOn U (fun _ => T) :=
  fun v => isPolynomialOn_const (T v)

theorem IsPolynomialOperatorOn.add {A B : U → V →ₗ[ℂ] W}
    (hA : IsPolynomialOperatorOn U A) (hB : IsPolynomialOperatorOn U B) :
    IsPolynomialOperatorOn U (fun χ => A χ + B χ) :=
  fun v => (hA v).add (hB v)

theorem IsPolynomialOperatorOn.regular_smul {A : U → V →ₗ[ℂ] W}
    (hA : IsPolynomialOperatorOn U A) (b : unramifiedRegularFunctions ν) :
    IsPolynomialOperatorOn U (fun χ => b.val χ.val • A χ) :=
  fun v => (hA v).regular_smul b

theorem IsPolynomialOperatorOn.precomp {A : U → V →ₗ[ℂ] W}
    (hA : IsPolynomialOperatorOn U A) (T : Z →ₗ[ℂ] V) :
    IsPolynomialOperatorOn U (fun χ => (A χ).comp T) :=
  fun v => hA (T v)

theorem IsPolynomialOperatorOn.postcomp {A : U → V →ₗ[ℂ] W}
    (hA : IsPolynomialOperatorOn U A) (T : W →ₗ[ℂ] Z) :
    IsPolynomialOperatorOn U (fun χ => T.comp (A χ)) :=
  fun v => (hA v).linearMap T

theorem IsPolynomialOperatorOn.isRationalOperatorOn {A : U → V →ₗ[ℂ] W}
    (hA : IsPolynomialOperatorOn U A) :
    IsRationalOperatorOn U A := by
  refine ⟨1, ?_, ?_⟩
  · intro χ
    exact one_ne_zero
  · simpa using hA

theorem IsRationalOperatorOn.restrict {A : U → V →ₗ[ℂ] W}
    (hA : IsRationalOperatorOn U A)
    {U' : Set (unramifiedCharacters ν)} (hU' : U' ⊆ U) :
    IsRationalOperatorOn U' (fun χ => A ⟨χ.val, hU' χ.property⟩) := by
  obtain ⟨b, hb, hA⟩ := hA
  exact ⟨b, fun χ => hb ⟨χ.val, hU' χ.property⟩,
    fun v => (hA v).restrict hU'⟩

theorem IsRationalOperatorOn.precomp {A : U → V →ₗ[ℂ] W}
    (hA : IsRationalOperatorOn U A) (T : Z →ₗ[ℂ] V) :
    IsRationalOperatorOn U (fun χ => (A χ).comp T) := by
  obtain ⟨b, hb, hA⟩ := hA
  exact ⟨b, hb, fun v => hA (T v)⟩

theorem IsRationalOperatorOn.postcomp {A : U → V →ₗ[ℂ] W}
    (hA : IsRationalOperatorOn U A) (T : W →ₗ[ℂ] Z) :
    IsRationalOperatorOn U (fun χ => T.comp (A χ)) := by
  obtain ⟨b, hb, hA⟩ := hA
  refine ⟨b, hb, fun v => ?_⟩
  simpa only [LinearMap.smul_apply, LinearMap.comp_apply, map_smul] using
    (hA v).linearMap T

end UnramifiedOperatorFamily

end Langlands.Plancherel
