import Langlands.Representation.Plancherel.RationalImageRealPart
import Langlands.Representation.Plancherel.RationalUnramifiedCharacterCoordinates
import Langlands.Representation.Plancherel.UnramifiedOperatorFamilies
import Mathlib.Algebra.Algebra.Pi
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.LinearAlgebra.LinearIndependent.Basic

/-!
# The coordinate algebra of actual unramified characters

The complex group algebra of the actual integer valuation image evaluates
faithfully on its character group. Pullback identifies its image with the
previously constructed algebra generated by actual unramified evaluations.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry
open scoped NNReal CategoryTheory.MonObj

namespace Langlands.Plancherel

universe u

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  (G : GroupScheme (Spec (CommRingCat.of F)))

/-- Actual image elements are separated by continuous complex characters.
The separating characters may be taken positive real-valued. -/
theorem rationalImageCharacters_separate :
    Function.Injective (fun a : rationalDiscreteValuationImage G =>
      fun χ : rationalImageCharacters G => (χ a : ℂ)) := by
  intro a b hab
  apply Subtype.ext
  change a.val.toAdd = b.val.toAdd
  apply AddMonoidHom.ext
  intro ψ
  let phi : rationalImageRealFunctionals G :=
    { toFun := fun x => ((x.toMul.val.toAdd ψ : ℤ) : ℝ)
      map_zero' := by
        change ((0 : ℤ) : ℝ) = 0
        exact Int.cast_zero
      map_add' := by
        intro x y
        change (((x.toMul.val.toAdd ψ + y.toMul.val.toAdd ψ : ℤ) : ℝ)) = _
        exact Int.cast_add _ _ }
  have he := congrFun hab (rationalImagePositiveCharacter G phi)
  have hl := congrArg
    (fun z : ℂ => -Real.log ‖z‖ / Real.log (LocalField.residueCardinality F)) he
  change rationalImageRealPart G (rationalImagePositiveCharacter G phi)
      (Additive.ofMul a) =
    rationalImageRealPart G (rationalImagePositiveCharacter G phi)
      (Additive.ofMul b) at hl
  rw [rationalImageRealPart_positive] at hl
  exact Int.cast_injective hl

/-- Evaluation at an image element is a complex-valued character of the
actual character group. -/
def rationalImageEvaluationHom (a : rationalDiscreteValuationImage G) :
    rationalImageCharacters G →* ℂ where
  toFun χ := (χ a : ℂ)
  map_one' := rfl
  map_mul' _ _ := rfl

/-- Dedekind independence applied to distinct evaluation characters. -/
theorem rationalImageEvaluations_linearIndependent :
    LinearIndependent ℂ (fun a : rationalDiscreteValuationImage G =>
      fun χ : rationalImageCharacters G => (χ a : ℂ)) := by
  apply (linearIndependent_monoidHom (rationalImageCharacters G) ℂ).comp
    (rationalImageEvaluationHom G)
  intro a b hab
  apply rationalImageCharacters_separate G
  exact congrArg (fun f : rationalImageCharacters G →* ℂ => (f : _ → ℂ)) hab

/-- The monomials of the group algebra as actual scalar evaluation functions. -/
def rationalImageEvaluationMonoidHom :
    Multiplicative (Additive (rationalDiscreteValuationImage G)) →*
      (rationalImageCharacters G → ℂ) where
  toFun a χ := (χ a.toAdd.toMul : ℂ)
  map_one' := by
    funext χ
    simp
  map_mul' a b := by
    funext χ
    change (χ (a.toAdd.toMul * b.toAdd.toMul) : ℂ) = _
    simp

/-- Evaluate finite formal Laurent combinations on actual image characters. -/
def rationalImageCoordinateEvaluation :
    AddMonoidAlgebra ℂ (Additive (rationalDiscreteValuationImage G)) →ₐ[ℂ]
      (rationalImageCharacters G → ℂ) :=
  AddMonoidAlgebra.lift ℂ _ _ (rationalImageEvaluationMonoidHom G)

@[simp]
theorem rationalImageCoordinateEvaluation_single
    (a : Additive (rationalDiscreteValuationImage G)) (c : ℂ)
    (χ : rationalImageCharacters G) :
    rationalImageCoordinateEvaluation G (AddMonoidAlgebra.single a c) χ =
      c * (χ a.toMul : ℂ) := by
  simp [rationalImageCoordinateEvaluation, rationalImageEvaluationMonoidHom]

/-- No nonzero finite Laurent combination vanishes on the character group. -/
theorem rationalImageCoordinateEvaluation_injective :
    Function.Injective (rationalImageCoordinateEvaluation G) := by
  have hi : LinearIndependent ℂ
      (fun a : Additive (rationalDiscreteValuationImage G) =>
        fun χ : rationalImageCharacters G => (χ a.toMul : ℂ)) :=
    (rationalImageEvaluations_linearIndependent G).comp Additive.toMul
      (fun _ _ h => h)
  intro x y hxy
  apply (AddMonoidAlgebra.coeffLinearEquiv ℂ).injective
  apply hi.finsuppLinearCombination_injective
  change rationalImageCoordinateEvaluation G x = rationalImageCoordinateEvaluation G y
  exact hxy

/-- Integer basis coordinates identify the actual image group algebra with a
finite-variable Laurent algebra. The rank is that of the actual image. -/
def rationalImageLaurentAlgebraEquiv (hG : GroupScheme.IsConnectedReductive G) :
    AddMonoidAlgebra ℂ (Fin (rationalImageRank G) → ℤ) ≃ₐ[ℂ]
      AddMonoidAlgebra ℂ (Additive (rationalDiscreteValuationImage G)) :=
  AddMonoidAlgebra.domCongr ℂ ℂ
    (rationalReductiveValuationBasis G hG).equivFun.symm.toAddEquiv

/-- Every actual image character evaluates by its basis Laurent monomial. -/
theorem rationalImageCharacter_basis_formula
    (hG : GroupScheme.IsConnectedReductive G)
    (χ : rationalImageCharacters G) (a : rationalDiscreteValuationImage G) :
    χ a = ∏ i, χ ((rationalReductiveValuationBasis G hG i).toMul) ^
      ((rationalReductiveValuationBasis G hG).repr (Additive.ofMul a) i) := by
  let _ := (GroupScheme.rationalCharacterLattice F G hG).2
  calc
    χ a = rationalImageCharacterOfCoordinates G
        (rationalImageCharacterCoordinates G χ) a := by
      exact (congrArg (fun ξ : rationalImageCharacters G => ξ a)
        ((rationalImageCharacterCoordinates G).symm_apply_apply χ)).symm
    _ = _ := rationalImageCharacterOfCoordinates_apply G _ a

section PointTopology

variable [TopologicalSpace (GroupScheme.rationalPoints G)]
  (hp : Continuous (rationalValuationImageProjection G))

/-- Pull back formal Laurent combinations to actual unramified characters. -/
def rationalUnramifiedCoordinateEvaluation :
    AddMonoidAlgebra ℂ (Additive (rationalDiscreteValuationImage G)) →ₐ[ℂ]
      (unramifiedCharacters (fun ψ => (rationalNormCharacters G ψ).toMul) → ℂ) :=
  (AlgEquiv.piCongrLeft' ℂ (fun _ : rationalImageCharacters G => ℂ)
    (rationalImageUnramifiedEquiv G hp).toEquiv).toAlgHom.comp
      (rationalImageCoordinateEvaluation G)

/-- The formal monomial indexed by an actual point evaluates at that point. -/
@[simp]
theorem rationalUnramifiedCoordinateEvaluation_single_projection
    (g : GroupScheme.rationalPoints G) (c : ℂ)
    (χ : unramifiedCharacters (fun ψ => (rationalNormCharacters G ψ).toMul)) :
    rationalUnramifiedCoordinateEvaluation G hp
      (AddMonoidAlgebra.single (Additive.ofMul (rationalValuationImageProjection G g)) c) χ =
      c * (χ.val g : ℂ) := by
  change rationalImageCoordinateEvaluation G _ (rationalImageUnramifiedDescend G χ) = _
  rw [rationalImageCoordinateEvaluation_single]
  change c * (rationalImageUnramifiedDescend G χ
    (rationalValuationImageProjection G g) : ℂ) = _
  rw [rationalImageUnramifiedDescend_projection]

theorem rationalUnramifiedCoordinateEvaluation_injective :
    Function.Injective (rationalUnramifiedCoordinateEvaluation G hp) :=
  (AlgEquiv.piCongrLeft' ℂ (fun _ : rationalImageCharacters G => ℂ)
    (rationalImageUnramifiedEquiv G hp).toEquiv).injective.comp
      (rationalImageCoordinateEvaluation_injective G)

/-- The image is exactly the algebra generated by actual point evaluations. -/
theorem rationalUnramifiedCoordinateEvaluation_range :
    (rationalUnramifiedCoordinateEvaluation G hp).range =
      unramifiedRegularFunctions (fun ψ => (rationalNormCharacters G ψ).toMul) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    refine AddMonoidAlgebra.induction_on
      (motive := fun z => rationalUnramifiedCoordinateEvaluation G hp z ∈
        unramifiedRegularFunctions (fun ψ => (rationalNormCharacters G ψ).toMul))
      x ?_ ?_ ?_
    · intro a
      obtain ⟨g, hg⟩ := rationalValuationImageProjection_surjective G a.toMul
      have ha : Additive.ofMul (rationalValuationImageProjection G g) = a :=
        congrArg Additive.ofMul hg
      change rationalUnramifiedCoordinateEvaluation G hp
        (AddMonoidAlgebra.single a 1) ∈ _
      rw [← ha]
      have he : rationalUnramifiedCoordinateEvaluation G hp
          (AddMonoidAlgebra.single
            (Additive.ofMul (rationalValuationImageProjection G g)) 1) =
          unramifiedEvaluation (fun ψ => (rationalNormCharacters G ψ).toMul) g := by
        funext χ
        simp [unramifiedEvaluation]
      rw [he]
      exact Algebra.subset_adjoin ⟨g, rfl⟩
    · intro x y hx hy
      rw [map_add]
      exact Subalgebra.add_mem _ hx hy
    · intro c x hx
      rw [map_smul]
      exact Subalgebra.smul_mem _ hx c
  · apply Algebra.adjoin_le
    rintro _ ⟨g, rfl⟩
    refine ⟨AddMonoidAlgebra.single
      (Additive.ofMul (rationalValuationImageProjection G g)) 1, ?_⟩
    funext χ
    simp [unramifiedEvaluation]

/-- The actual regular scalar algebra is the complex group algebra of the
actual valuation image, under the displayed continuity prerequisite. -/
def rationalUnramifiedCoordinateAlgebraEquiv :
    AddMonoidAlgebra ℂ (Additive (rationalDiscreteValuationImage G)) ≃ₐ[ℂ]
      unramifiedRegularFunctions (fun ψ => (rationalNormCharacters G ψ).toMul) :=
  (AlgEquiv.ofInjective (rationalUnramifiedCoordinateEvaluation G hp)
    (rationalUnramifiedCoordinateEvaluation_injective G hp)).trans
      (Subalgebra.equivOfEq _ _ (rationalUnramifiedCoordinateEvaluation_range G hp))

@[simp]
theorem rationalUnramifiedCoordinateAlgebraEquiv_apply
    (x : AddMonoidAlgebra ℂ (Additive (rationalDiscreteValuationImage G)))
    (χ : unramifiedCharacters (fun ψ => (rationalNormCharacters G ψ).toMul)) :
    (rationalUnramifiedCoordinateAlgebraEquiv G hp x).val χ =
      rationalUnramifiedCoordinateEvaluation G hp x χ := rfl

/-- The scalar algebra used by the actual rational-family predicate is a
finite-variable Laurent algebra for a connected reductive group. -/
def rationalUnramifiedLaurentAlgebraEquiv
    (hG : GroupScheme.IsConnectedReductive G) :
    AddMonoidAlgebra ℂ (Fin (rationalImageRank G) → ℤ) ≃ₐ[ℂ]
      unramifiedRegularFunctions (fun ψ => (rationalNormCharacters G ψ).toMul) :=
  (rationalImageLaurentAlgebraEquiv G hG).trans
    (rationalUnramifiedCoordinateAlgebraEquiv G hp)

/-- The algebra equivalence sends a formal monomial to the corresponding
Laurent monomial in actual character coordinates. -/
theorem rationalUnramifiedLaurentAlgebraEquiv_single
    (hG : GroupScheme.IsConnectedReductive G)
    (m : Fin (rationalImageRank G) → ℤ) (c : ℂ)
    (χ : unramifiedCharacters (fun ψ => (rationalNormCharacters G ψ).toMul)) :
    (rationalUnramifiedLaurentAlgebraEquiv G hp hG
      (AddMonoidAlgebra.single m c)).val χ =
      c * ((∏ i, rationalImageUnramifiedDescend G χ
        ((rationalReductiveValuationBasis G hG i).toMul) ^ m i : ℂˣ) : ℂ) := by
  change rationalUnramifiedCoordinateEvaluation G hp
    (rationalImageLaurentAlgebraEquiv G hG (AddMonoidAlgebra.single m c)) χ = _
  rw [rationalImageLaurentAlgebraEquiv, AddMonoidAlgebra.domCongr_single]
  change rationalImageCoordinateEvaluation G _ (rationalImageUnramifiedDescend G χ) = _
  rw [rationalImageCoordinateEvaluation_single, rationalImageCharacter_basis_formula G hG]
  congr 2
  apply Finset.prod_congr rfl
  intro i _
  congr 1
  exact congrFun
    ((rationalReductiveValuationBasis G hG).equivFun.apply_symm_apply m) i

end PointTopology

section CanonicalTopology

open Langlands.AlgebraicGeometry.PointTopology

variable [IsAffine G.X.left] [LocallyOfFiniteType G.X.hom]

local instance : TopologicalSpace (GroupScheme.rationalPoints G) :=
  rationalPointTopology F G.X

/-- In the canonical rational-point topology the continuity prerequisite is
proved, so the actual scalar algebra is the valuation-image group algebra. -/
def rationalCanonicalUnramifiedCoordinateAlgebraEquiv :
    AddMonoidAlgebra ℂ (Additive (rationalDiscreteValuationImage G)) ≃ₐ[ℂ]
      unramifiedRegularFunctions (fun ψ => (rationalNormCharacters G ψ).toMul) :=
  rationalUnramifiedCoordinateAlgebraEquiv G (continuous_rationalValuationImageProjection G)

/-- Canonical finite Laurent coordinates on the actual regular scalar algebra. -/
def rationalCanonicalUnramifiedLaurentAlgebraEquiv
    (hG : GroupScheme.IsConnectedReductive G) :
    AddMonoidAlgebra ℂ (Fin (rationalImageRank G) → ℤ) ≃ₐ[ℂ]
      unramifiedRegularFunctions (fun ψ => (rationalNormCharacters G ψ).toMul) :=
  rationalUnramifiedLaurentAlgebraEquiv G (continuous_rationalValuationImageProjection G) hG

/-- Canonical finite character coordinates give the same monomial evaluation
as the Laurent-algebra equivalence. -/
theorem rationalCanonicalUnramifiedLaurentAlgebraEquiv_single
    (hG : GroupScheme.IsConnectedReductive G)
    (m : Fin (rationalImageRank G) → ℤ) (c : ℂ)
    (χ : unramifiedCharacters (fun ψ => (rationalNormCharacters G ψ).toMul)) :
    (rationalCanonicalUnramifiedLaurentAlgebraEquiv G hG
      (AddMonoidAlgebra.single m c)).val χ =
      c * ((∏ i, rationalCanonicalUnramifiedCharacterCoordinates G hG χ i ^ m i :
        ℂˣ) : ℂ) :=
  rationalUnramifiedLaurentAlgebraEquiv_single G
    (continuous_rationalValuationImageProjection G) hG m c χ

end CanonicalTopology

end Langlands.Plancherel
