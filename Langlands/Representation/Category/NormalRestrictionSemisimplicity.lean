import Langlands.Representation.Category.NormalRestrictionSemisimplicityStatement
import Langlands.Representation.SubrepresentationLattice
import Mathlib.RingTheory.Artinian.Module

/-! A finite-dimensional Clifford/socle proof of normal restriction semisimplicity. -/

namespace Langlands

universe uR uG uV

namespace NormalRestrictionSemisimplicity

variable {R : Type uR} [Field R] {G : Type uG} [Group G]
  {V : Type uV} [AddCommGroup V] [Module R V]
  (ρ : Representation R G V) (H : Subgroup G) [H.Normal]

/-- Pullback under `ρ g` preserves `H`-invariance by normality. -/
private def pullback (g : G) (W : Subrepresentation (ρ.comp H.subtype)) :
    Subrepresentation (ρ.comp H.subtype) where
  toSubmodule := W.toSubmodule.comap (ρ g)
  apply_mem_toSubmodule h v hv := by
    have hw := W.apply_mem_toSubmodule
      ⟨g * (h : G) * g⁻¹, Subgroup.Normal.conj_mem inferInstance _ h.property g⟩ hv
    change ρ (g * (h : G) * g⁻¹) (ρ g v) ∈ W.toSubmodule at hw
    change ρ g (ρ (h : G) v) ∈ W.toSubmodule
    simpa only [map_mul, Module.End.mul_apply, Representation.inv_self_apply] using hw

/-- Invertibility makes pullback an order automorphism of restricted subrepresentations. -/
private def pullbackOrderIso (g : G) :
    Subrepresentation (ρ.comp H.subtype) ≃o Subrepresentation (ρ.comp H.subtype) where
  toFun := pullback ρ H g
  invFun := pullback ρ H g⁻¹
  left_inv W := by
    apply _root_.Subrepresentation.toSubmodule_injective
    ext v
    change (ρ g (ρ g⁻¹ v) ∈ W.toSubmodule) ↔ v ∈ W.toSubmodule
    rw [Representation.self_inv_apply]
  right_inv W := by
    apply _root_.Subrepresentation.toSubmodule_injective
    ext v
    change (ρ g⁻¹ (ρ g v) ∈ W.toSubmodule) ↔ v ∈ W.toSubmodule
    rw [Representation.inv_self_apply]
  map_rel_iff' := by
    intro W U
    constructor
    · intro h v hv
      change v ∈ W.toSubmodule at hv
      change v ∈ U.toSubmodule
      have hw := h (show ρ g⁻¹ v ∈ pullback ρ H g W from by
        change ρ g (ρ g⁻¹ v) ∈ W.toSubmodule
        simpa only [Representation.self_inv_apply] using hv)
      change ρ g (ρ g⁻¹ v) ∈ U.toSubmodule at hw
      simpa only [Representation.self_inv_apply] using hw
    · intro h v hv
      exact h hv

end NormalRestrictionSemisimplicity

open NormalRestrictionSemisimplicity in
/-- A semisimple finite-dimensional representation stays semisimple on a normal subgroup. -/
theorem finiteDimensionalNormalRestrictionSemisimplicity :
    FiniteDimensionalNormalRestrictionSemisimplicity.{uR, uG, uV} := by
  intro R _ G _ V _ _ _ H _ ρ hss
  classical
  let σ := ρ.comp H.subtype
  let S : Subrepresentation σ := sSup {W : Subrepresentation σ | IsAtom W}
  -- The sum of all simple H-submodules is G-stable: pullback permutes its atoms.
  have hstable (g : G) : ∀ v ∈ S.toSubmodule, ρ g v ∈ S.toSubmodule := by
    let e := pullbackOrderIso ρ H g
    have he : e S = S := by
      change e (sSup {W | IsAtom W}) = sSup {W | IsAtom W}
      rw [e.map_sSup_eq_sSup_symm_preimage]
      congr 1
      ext W
      exact e.symm.isAtom_iff W
    intro v hv
    have hv' : v ∈ e S := by rw [he]; exact hv
    exact hv'
  let T : Subrepresentation ρ := ⟨S.toSubmodule, fun g v hv => hstable g v hv⟩
  -- The input semisimplicity supplies a G-invariant complement.
  let : Representation.IsSemisimpleRepresentation ρ := hss
  obtain ⟨C, hC⟩ := exists_isCompl T
  let C' : Subrepresentation σ :=
    ⟨C.toSubmodule, fun h _ hv => C.apply_mem_toSubmodule (h : G) hv⟩
  -- Finite dimension makes the restricted subrepresentation lattice atomic.
  let emb : Subrepresentation σ ↪o Submodule R V :=
    ⟨⟨_root_.Subrepresentation.toSubmodule,
      _root_.Subrepresentation.toSubmodule_injective⟩, Iff.rfl⟩
  let : WellFoundedLT (Subrepresentation σ) := emb.wellFoundedLT
  have hCbot : C' = ⊥ := by
    rcases eq_bot_or_exists_atom_le C' with h | ⟨A, hA, hAC⟩
    · exact h
    · have hAS : A ≤ S := le_sSup hA
      have hbot : A.toSubmodule ≤ (⊥ : Submodule R V) := by
        have hdis : T.toSubmodule ⊓ C.toSubmodule = ⊥ :=
          congrArg _root_.Subrepresentation.toSubmodule hC.inf_eq_bot
        rw [← hdis]
        exact le_inf hAS hAC
      exact False.elim (hA.ne_bot (_root_.Subrepresentation.toSubmodule_injective
        (le_antisymm hbot bot_le)))
  have hCzero : C = ⊥ :=
    _root_.Subrepresentation.toSubmodule_injective
      (congrArg (fun X : Subrepresentation σ => X.toSubmodule) hCbot)
  have hTtop : T = ⊤ := by simpa only [hCzero, sup_bot_eq] using hC.sup_eq_top
  have hStop : S = ⊤ :=
    _root_.Subrepresentation.toSubmodule_injective
      (congrArg (fun X : Subrepresentation ρ => X.toSubmodule) hTtop)
  -- A module generated by its simple submodules is semisimple.
  rw [Representation.isSemisimpleRepresentation_iff_isSemisimpleModule_asModule]
  apply IsSemisimpleModule.of_sSup_simples_eq_top
  let e := _root_.Subrepresentation.subrepresentationSubmoduleOrderIso (ρ := σ)
  have he := congrArg e hStop
  rw [e.map_top] at he
  change e (sSup {W : Subrepresentation σ | IsAtom W}) = ⊤ at he
  rw [e.map_sSup_eq_sSup_symm_preimage] at he
  convert he using 2
  ext W
  exact (isSimpleModule_iff_isAtom).trans (e.symm.isAtom_iff W).symm

end Langlands
