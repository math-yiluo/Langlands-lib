import Langlands.Representation.Category.Subquotients
import Langlands.Representation.CuspidalSupport.QuasicuspidalEmbeddingProof
import Langlands.Representation.CompactCoefficient.AdmissibleComplement

/-!
# Every nonzero smooth representation has an irreducible subquotient

For any topological group `G` and any nonzero smooth complex representation `A`,
the subrepresentation spanned by the orbit of a nonzero vector `v` is generated by
`v`, so it has a maximal proper subrepresentation, and the quotient by it is an
actual irreducible subquotient of `A`. No finite length is assumed.
-/

open CategoryTheory

namespace Langlands.SmoothRep

universe uG uV

variable {G : Type uG} [Group G] [TopologicalSpace G]

/-- Every nonzero smooth representation has an actual irreducible subquotient in
the same carrier universe: the quotient of the cyclic subrepresentation generated
by a nonzero vector by a maximal proper subrepresentation. -/
theorem exists_isIrreducible_isSubquotient_of_nontrivial
    (A : SmoothRep.{0, uG, uV} ℂ G) [Nontrivial A] :
    ∃ D : SmoothRep.{0, uG, uV} ℂ G, D.IsIrreducible ∧ IsSubquotient D A := by
  classical
  obtain ⟨v, hv⟩ := exists_ne (0 : A)
  let S : Subrepresentation A.representation :=
    CompactSplitting.orbitSpan A.representation v
  have hvS : v ∈ S.toSubmodule := CompactSplitting.mem_orbitSpan_self _ v
  let B := subrepresentation A S
  let v' : B := ⟨v, hvS⟩
  have hv' : v' ≠ 0 := fun h => hv (congrArg Subtype.val h)
  have : Nontrivial B := ⟨⟨v', 0, hv'⟩⟩
  have hgen : ∀ T : Subrepresentation B.representation,
      (∀ x ∈ ({v'} : Finset B), x ∈ T) → T = ⊤ := by
    intro T hT
    have hvT : v' ∈ T := hT v' (Finset.mem_singleton_self v')
    rw [eq_top_iff]
    rintro ⟨x, hx⟩ -
    have hx' : x ∈ Submodule.span ℂ (Set.range fun g : G => A.representation g v) := hx
    refine Submodule.span_induction
      (p := fun x hx => (⟨x, hx⟩ : B) ∈ T) ?_ ?_ ?_ ?_ hx'
    · rintro _ ⟨g, rfl⟩
      have h : (⟨A.representation g v, Submodule.subset_span ⟨g, rfl⟩⟩ : B) =
          B.representation g v' := rfl
      rw [h]
      exact T.apply_mem_toSubmodule g hvT
    · exact T.toSubmodule.zero_mem
    · intro y z hy hz ihy ihz
      exact T.toSubmodule.add_mem ihy ihz
    · intro a y hy ihy
      exact T.toSubmodule.smul_mem a ihy
  obtain ⟨T, hT⟩ :=
    CuspidalSupport.QuasicuspidalEmbedding.exists_isCoatom_subrepresentation
      B.representation {v'} hgen
  refine ⟨quotient B T, ?_, S, T, ⟨Iso.refl _⟩⟩
  exact CuspidalSupport.QuasicuspidalEmbedding.isIrreducible_of_isCoatom
    (hom (mkQ B T)) (mkQ_surjective B T) T hT
    (fun x => Submodule.Quotient.mk_eq_zero _)

end Langlands.SmoothRep
