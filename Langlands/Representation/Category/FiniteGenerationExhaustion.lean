import Langlands.Representation.Category.Subquotients
import Langlands.Representation.SubrepresentationLattice
import Mathlib.RingTheory.Finiteness.Basic

/-!
# Exhaustion by finitely generated actual invariant submodules

Finite spans are taken over the group algebra, not over the coefficient field.
-/

noncomputable section

open CategoryTheory

namespace Langlands.SmoothRep

universe uR uG uV

variable {R : Type uR} [Field R] {G : Type uG} [Group G] [TopologicalSpace G]

/-- The actual invariant submodule generated by a finite set of vectors. -/
def finiteSpanSubrepresentation (A : SmoothRep.{uR, uG, uV} R G)
    (s : Finset A.representation.asModule) : Subrepresentation A.representation :=
  Subrepresentation.ofSubmodule'
    (Submodule.span (MonoidAlgebra R G) (s : Set A.representation.asModule))

/-- The representation on a finite invariant span is finitely generated over
the group algebra. -/
theorem finiteSpanSubrepresentation_finite (A : SmoothRep.{uR, uG, uV} R G)
    (s : Finset A.representation.asModule) :
    Module.Finite (MonoidAlgebra R G)
      (subrepresentation A (finiteSpanSubrepresentation A s)).representation.asModule := by
  let N : Submodule (MonoidAlgebra R G) A.representation.asModule :=
    Submodule.span (MonoidAlgebra R G) (s : Set A.representation.asModule)
  let B := subrepresentation A (finiteSpanSubrepresentation A s)
  let j : B.representation.asModule →ₗ[MonoidAlgebra R G] N :=
    (Representation.IntertwiningMap.equivLinearMapAsModule _ _
      (hom (subtype A (finiteSpanSubrepresentation A s)))).codRestrict N
      (fun v => v.property)
  have hj : Function.Bijective j :=
    ⟨fun _ _ h => Subtype.ext (congrArg Subtype.val h),
      fun v => ⟨⟨v.val, v.property⟩, rfl⟩⟩
  have : Module.Finite (MonoidAlgebra R G) N :=
    Module.Finite.span_of_finite _ s.finite_toSet
  exact Module.Finite.equiv (LinearEquiv.ofBijective j hj).symm

/-- Enlarging the finite set enlarges its actual invariant span. -/
theorem finiteSpanSubrepresentation_mono (A : SmoothRep.{uR, uG, uV} R G)
    {s t : Finset A.representation.asModule} (hst : s ⊆ t) :
    finiteSpanSubrepresentation A s ≤ finiteSpanSubrepresentation A t := by
  change Submodule.span (MonoidAlgebra R G) (s : Set A.representation.asModule) ≤
    Submodule.span (MonoidAlgebra R G) (t : Set A.representation.asModule)
  exact Submodule.span_mono hst

/-- The finite invariant spans form a directed family. -/
theorem finiteSpanSubrepresentation_directed (A : SmoothRep.{uR, uG, uV} R G) :
    Directed (· ≤ ·) (finiteSpanSubrepresentation A) := by
  classical
  intro s t
  exact ⟨s ∪ t, finiteSpanSubrepresentation_mono A Finset.subset_union_left,
    finiteSpanSubrepresentation_mono A Finset.subset_union_right⟩

/-- Every smooth representation is the invariant sum of its finite invariant
spans, at the original carrier universe. -/
theorem iSup_finiteSpanSubrepresentation (A : SmoothRep.{uR, uG, uV} R G) :
    (⨆ s, finiteSpanSubrepresentation A s) = ⊤ := by
  classical
  apply top_unique
  intro v _
  apply (le_iSup (finiteSpanSubrepresentation A) {A.representation.asModuleEquiv.symm v})
  change A.representation.asModuleEquiv.symm v ∈
    Submodule.span (MonoidAlgebra R G)
      (({A.representation.asModuleEquiv.symm v} :
        Finset A.representation.asModule) : Set A.representation.asModule)
  exact Submodule.subset_span (by simp)

/-- The actual image of an intertwiner is an actual quotient of its source. -/
theorem image_isQuotient {A B : SmoothRep.{uR, uG, uV} R G} (f : A ⟶ B) :
    IsQuotient (image f) A := by
  let q : A ⟶ image f := ofHom {
    toLinearMap := (hom f).toLinearMap.rangeRestrict
    isIntertwining' g := by
      ext v
      exact Subtype.ext (Representation.IntertwiningMap.isIntertwining _ _ (hom f) g v) }
  exact ⟨q, LinearMap.surjective_rangeRestrict _⟩

end Langlands.SmoothRep
