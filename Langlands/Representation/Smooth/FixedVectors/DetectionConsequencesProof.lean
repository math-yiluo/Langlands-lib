import Langlands.Representation.Smooth.FixedVectors.DetectionConsequencesStatement
import Langlands.Representation.Smooth.FixedVectors.LengthCriterionProof
import Langlands.Representation.Category.IrreducibleSubquotientExistence
import Langlands.Representation.Filtration.SubquotientAlgebraProof
import Langlands.Representation.Compact.SurjectivityProof
import Langlands.Representation.Smooth.FixedVectors.LawsProof

/-! # Generation and length from compact-open irreducible detection -/

set_option autoImplicit false

noncomputable section

namespace Langlands.SmoothRep

universe uG uV

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  (A : SmoothRep.{0, uG, uV} ℂ G)
  (K : OpenSubgroup G) (hK : IsCompact (K : Set G))

include hK in
/-- Lift a detected vector from an irreducible subquotient of a nonzero
subquotient, using the actual injective/surjective presentation. -/
theorem fixedVector_of_irreducible_subquotient_detection
    (hdet : ∀ E : SmoothRep.{0, uG, uV} ℂ G,
      E.IsIrreducible → IsSubquotient E A →
        ∃ v : E, v ∈ fixedVectors E.representation K.toSubgroup ∧ v ≠ 0)
    (D : SmoothRep.{0, uG, uV} ℂ G) (hDA : IsSubquotient D A)
    (hD : Nontrivial D) :
    ∃ v : D, v ∈ fixedVectors D.representation K.toSubgroup ∧ v ≠ 0 := by
  let := hD
  obtain ⟨E, hE, hED⟩ := exists_isIrreducible_isSubquotient_of_nontrivial D
  obtain ⟨w, hwK, hw0⟩ := hdet E hE
    (smoothSubquotientTransitivity ℂ G A D E hED hDA)
  obtain ⟨C, i, q, hi, hq⟩ := isSubquotient_iff_exists.mp hED
  obtain ⟨v, hv⟩ := Compact.fixedVectorSurjectivity G C E
    C.representation E.representation C.isSmooth E.isSmooth K hK (hom q) hq ⟨w, hwK⟩
  refine ⟨hom i v.val, map_mem_fixedVectors (hom i) v.property, ?_⟩
  intro hz
  have hv0 : v.val = 0 := hi (hz.trans (map_zero (hom i)).symm)
  apply hw0
  have hval := congrArg Subtype.val hv
  exact hval.symm.trans ((congrArg (hom q) hv0).trans (map_zero (hom q)))

include hK in
/-- Detection on all nonzero actual subquotients forces every actual
subquotient to be generated by its fixed vectors. -/
theorem fixedVectors_generate_subquotients_of_detection
    (hdet : ∀ D : SmoothRep.{0, uG, uV} ℂ G,
      IsSubquotient D A → Nontrivial D →
        ∃ v : D, v ∈ fixedVectors D.representation K.toSubgroup ∧ v ≠ 0)
    (D : SmoothRep.{0, uG, uV} ℂ G) (hDA : IsSubquotient D A)
    (S : Subrepresentation D.representation)
    (hS : fixedVectors D.representation K.toSubgroup ≤ S.toSubmodule) :
    S = ⊤ := by
  classical
  by_contra hn
  have hSmod : S.toSubmodule ≠ ⊤ := by
    intro h
    apply hn
    apply top_unique
    intro v _
    change v ∈ S.toSubmodule
    rw [h]
    trivial
  let Q := quotient D S
  have hQ : Nontrivial Q := Submodule.Quotient.nontrivial_iff.mpr hSmod
  have hQA : IsSubquotient Q A :=
    smoothSubquotientTransitivity ℂ G A D Q
      (quotient_isQuotient (A := D) S).isSubquotient hDA
  obtain ⟨w, hwK, hw0⟩ := hdet Q hQA hQ
  obtain ⟨v, hv⟩ := Compact.fixedVectorSurjectivity G D Q
    D.representation Q.representation D.isSmooth Q.isSmooth K hK
      (hom (mkQ D S)) (mkQ_surjective D S) ⟨w, hwK⟩
  apply hw0
  exact (congrArg Subtype.val hv).symm.trans
    ((Submodule.Quotient.mk_eq_zero S.toSubmodule).mpr (hS v.property))

omit [IsTopologicalGroup G] in
/-- Generation of all actual subquotients supplies the witnesses for the
published fixed-vector strict-chain length criterion. -/
theorem fixedVectors_length_of_subquotient_generation
    (hgen : ∀ D : SmoothRep.{0, uG, uV} ℂ G,
      IsSubquotient D A →
        ∀ S : Subrepresentation D.representation,
          fixedVectors D.representation K.toSubgroup ≤ S.toSubmodule → S = ⊤)
    [FiniteDimensional ℂ (fixedVectors A.representation K.toSubgroup)] :
    HasCompositionLengthAtMost A.obj
      (Module.finrank ℂ (fixedVectors A.representation K.toSubgroup)) ∧
      A.HasFiniteLength := by
  apply fixedVectorsStrictInclusionLength ℂ G A A.representation K.toSubgroup
  intro S T hST
  classical
  by_contra hn
  push Not at hn
  let B := subrepresentation A T
  let L : Subrepresentation B.representation :=
    { toSubmodule := LengthCriterionProof.lower S T
      apply_mem_toSubmodule := LengthCriterionProof.lower_le_comap S T }
  have hBA : IsSubquotient B A :=
    (subrepresentation_isSubrepresentation (A := A) T).isSubquotient
  have hL : L = ⊤ := hgen B hBA L (by
    intro v hv
    exact hn v.val v.property (fun k => congrArg Subtype.val (hv k)))
  apply hST.not_ge
  intro v hv
  have hmem : (⟨v, hv⟩ : B) ∈ L := by rw [hL]; trivial
  exact hmem

end Langlands.SmoothRep

namespace Langlands

/-- The complete detection-to-generation and actual length reduction. -/
theorem compactOpenDetectionConsequences.{uG, uV} :
    CompactOpenDetectionConsequencesStatement.{uG, uV} := by
  intro G _ _ _ A K hK hdet
  have hall := SmoothRep.fixedVector_of_irreducible_subquotient_detection A K hK hdet
  have hgen := SmoothRep.fixedVectors_generate_subquotients_of_detection A K hK hall
  refine ⟨hall, hgen, ?_⟩
  intro _
  exact SmoothRep.fixedVectors_length_of_subquotient_generation A K hgen

end Langlands
