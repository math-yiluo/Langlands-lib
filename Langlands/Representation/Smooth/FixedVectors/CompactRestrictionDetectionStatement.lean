import Langlands.Representation.CompactCoefficient.Classes
import Langlands.Representation.CompactCoefficient.AmbientProjector
import Langlands.Representation.Category.Subquotients
import Mathlib.MeasureTheory.Group.Measure

/-!
# Fixed-vector detection from a finite compact restriction

The finite compact-restriction input is explicit. This is an internal
prerequisite for the supercuspidal detection step in Renard VI.6.3.
-/

set_option autoImplicit false

namespace Langlands

universe uG uV uI

/-- A subquotient whose restriction is spanned by a nonempty finite family of
compact irreducible representations has nonzero `K`-fixed vectors if the
ambient representation is generated by its `K`-fixed vectors and `K ≤ N`. -/
def CompactRestrictionFixedVectorDetectionStatement : Prop :=
  ∀ (G : Type uG) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (N : Subgroup G) [N.Normal]
    [T2Space N] [LocallyCompactSpace N] [TotallyDisconnectedSpace N]
    [MeasurableSpace N] [BorelSpace N]
    (μ : MeasureTheory.Measure N) [μ.IsHaarMeasure]
    (A D : SmoothRep.{0, uG, uV} ℂ G) (K : Subgroup G),
    K ≤ N →
    (∀ S : Subrepresentation A.representation,
      fixedVectors A.representation K ≤ S.toSubmodule → S = ⊤) →
    ∀ (ι : Type uI) [Fintype ι] [Nonempty ι]
      (V : ι → Subrepresentation (SmoothRep.restrictSubgroup N D).representation),
      (∀ i, Representation.IsIrreducible (V i).toRepresentation) →
      (∀ i, HasCompactSmoothDualCoefficients (V i).toRepresentation) →
      (⨆ i, (V i).toSubmodule) = ⊤ →
      SmoothRep.IsSubquotient D A →
      ∃ v : D, v ∈ fixedVectors D.representation K ∧ v ≠ 0

end Langlands
