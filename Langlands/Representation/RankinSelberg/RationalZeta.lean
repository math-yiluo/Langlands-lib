import Mathlib.Algebra.Polynomial.Laurent
import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.RingTheory.FractionalIdeal.Operations
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.Basic.Complex.Basic

/-!
The Laurent coefficient ring and fractional ideals generated by rational zeta
values. Rationality and a common denominator are explicit prerequisites; this
module does not assert the analytic JPSS theorem or choose a local factor.
-/

noncomputable section

open Polynomial
open scoped nonZeroDivisors

namespace Langlands.RankinSelberg

/-- The coefficient ring in the formal spectral variable `X = q^(-s)`. -/
abbrev LaurentCoefficients := LaurentPolynomial ℂ

/-- The ambient field in which rational continuations of zeta integrals lie. -/
abbrev RationalFunctions := RatFunc ℂ

/-- Embed Laurent polynomials in the rational function field by sending `T` to `X`. -/
def laurentToRatFunc : LaurentCoefficients →+* RationalFunctions :=
  LaurentPolynomial.eval₂ RatFunc.C (Units.mk0 RatFunc.X RatFunc.X_ne_zero)

@[simp]
theorem laurentToRatFunc_toLaurent (p : ℂ[X]) :
    laurentToRatFunc p.toLaurent = algebraMap ℂ[X] RationalFunctions p := by
  change LaurentPolynomial.eval₂ RatFunc.C
    (Units.mk0 RatFunc.X RatFunc.X_ne_zero) p.toLaurent = _
  rw [LaurentPolynomial.eval₂_toLaurent]
  exact RatFunc.aeval_X_left_eq_algebraMap p

@[simp]
theorem laurentToRatFunc_T (n : ℤ) :
    laurentToRatFunc (LaurentPolynomial.T n) = (RatFunc.X : RationalFunctions) ^ n := by
  simp [laurentToRatFunc]

theorem laurentToRatFunc_injective : Function.Injective laurentToRatFunc := by
  apply (injective_iff_map_eq_zero laurentToRatFunc).2
  intro f hf
  induction f using LaurentPolynomial.induction_on_mul_T with
  | mul_T p n =>
    have hn : (RatFunc.X : RationalFunctions) ^ (-(n : ℤ)) ≠ 0 :=
      zpow_ne_zero _ RatFunc.X_ne_zero
    have hp : algebraMap ℂ[X] RationalFunctions p = 0 := by
      simpa only [map_mul, laurentToRatFunc_toLaurent, laurentToRatFunc_T,
        mul_eq_zero, hn, or_false] using hf
    have hp0 : p = 0 := (RatFunc.algebraMap_injective ℂ) (by simpa using hp)
    simp [hp0]

/-- The scalar action is multiplication through the genuine Laurent embedding. -/
instance laurentRatFuncAlgebra : Algebra LaurentCoefficients RationalFunctions :=
  laurentToRatFunc.toAlgebra

@[simp]
theorem algebraMap_laurent (p : LaurentCoefficients) :
    algebraMap LaurentCoefficients RationalFunctions p = laurentToRatFunc p := rfl

/-- The ambient field is the fraction field of the actual Laurent coefficient ring. -/
instance laurentRatFuncIsFractionRing :
    IsFractionRing LaurentCoefficients RationalFunctions := by
  let : FaithfulSMul LaurentCoefficients RationalFunctions :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr laurentToRatFunc_injective
  apply IsFractionRing.of_field
  intro f
  refine ⟨f.num.toLaurent, f.denom.toLaurent, ?_⟩
  simpa only [algebraMap_laurent, laurentToRatFunc_toLaurent] using
    (RatFunc.num_div_denom f).symm

/-- Localizing the polynomial PID at the powers of `X` preserves principality. -/
instance laurentCoefficientsIsPrincipalIdealRing : IsPrincipalIdealRing LaurentCoefficients where
  principal I := by
    have h := (IsPrincipalIdealRing.principal (I.under ℂ[X])).map_ringHom
      (algebraMap ℂ[X] LaurentCoefficients)
    simpa only [IsLocalization.map_under (Submonoid.powers (X : ℂ[X]))
      LaurentCoefficients] using h

/-- The Laurent module generated by a set of already rational zeta values. -/
def zetaSpan (values : Set RationalFunctions) :
    Submodule LaurentCoefficients RationalFunctions :=
  Submodule.span LaurentCoefficients values

theorem mem_zetaSpan {values : Set RationalFunctions} {f : RationalFunctions}
    (hf : f ∈ values) : f ∈ zetaSpan values :=
  Submodule.subset_span hf

theorem zetaSpan_mono {values other : Set RationalFunctions} (h : values ⊆ other) :
    zetaSpan values ≤ zetaSpan other :=
  Submodule.span_mono h

/-- A single nonzero Laurent polynomial clears the denominators of every value.
This is an explicit hypothesis, not a consequence of pointwise rationality. -/
def HasCommonDenominator (values : Set RationalFunctions) : Prop :=
  ∃ d : LaurentCoefficients, d ≠ 0 ∧
    ∀ f ∈ values, ∃ p : LaurentCoefficients,
      laurentToRatFunc p = laurentToRatFunc d * f

theorem hasCommonDenominator_iff_isFractional (values : Set RationalFunctions) :
    HasCommonDenominator values ↔
      IsFractional LaurentCoefficients⁰ (zetaSpan values) := by
  rw [zetaSpan, FractionalIdeal.isFractional_span_iff]
  simp only [HasCommonDenominator, mem_nonZeroDivisors_iff_ne_zero,
    IsLocalization.IsInteger, RingHom.mem_rangeS, Algebra.smul_def, algebraMap_laurent]

/-- The fractional ideal of zeta values, constructed only after the common
denominator obligation has been proved for that set. -/
def fractionalZetaIdeal (values : Set RationalFunctions)
    (h : HasCommonDenominator values) :
    FractionalIdeal LaurentCoefficients⁰ RationalFunctions :=
  ⟨zetaSpan values, (hasCommonDenominator_iff_isFractional values).mp h⟩

@[simp]
theorem coe_fractionalZetaIdeal (values : Set RationalFunctions)
    (h : HasCommonDenominator values) :
    (fractionalZetaIdeal values h : Submodule LaurentCoefficients RationalFunctions) =
      zetaSpan values := rfl

/-- Principality is an algebraic consequence of a common denominator. It does
not yet give the special normalized reciprocal-polynomial generator. -/
theorem zetaSpan_isPrincipal (values : Set RationalFunctions)
    (h : HasCommonDenominator values) : (zetaSpan values).IsPrincipal :=
  FractionalIdeal.isPrincipal (fractionalZetaIdeal values h)

/-- A rational generator exists once the common denominator has been established. -/
theorem exists_rationalGenerator (values : Set RationalFunctions)
    (h : HasCommonDenominator values) :
    ∃ g : RationalFunctions, zetaSpan values = Submodule.span LaurentCoefficients {g} := by
  let := zetaSpan_isPrincipal values h
  exact ⟨Submodule.IsPrincipal.generator (zetaSpan values),
    (Submodule.IsPrincipal.span_singleton_generator (zetaSpan values)).symm⟩

/-- A normalized polynomial generator is a property of the actual zeta module,
not an independently supplied factor function. -/
def IsNormalizedGenerator (values : Set RationalFunctions) (P : ℂ[X]) : Prop :=
  P.coeff 0 = 1 ∧
    zetaSpan values = Submodule.span LaurentCoefficients
      {(algebraMap ℂ[X] RationalFunctions P)⁻¹}

theorem IsNormalizedGenerator.polynomial_ne_zero
    {values : Set RationalFunctions} {P : ℂ[X]}
    (h : IsNormalizedGenerator values P) : P ≠ 0 := by
  intro hP
  have hzero := h.1
  simp [hP] at hzero

theorem IsNormalizedGenerator.clearsDenominators
    {values : Set RationalFunctions} {P : ℂ[X]}
    (h : IsNormalizedGenerator values P) {f : RationalFunctions}
    (hf : f ∈ zetaSpan values) :
    ∃ a : LaurentCoefficients,
      laurentToRatFunc a = algebraMap ℂ[X] RationalFunctions P * f := by
  have hmem : f ∈ Submodule.span LaurentCoefficients
      {(algebraMap ℂ[X] RationalFunctions P)⁻¹} := h.2 ▸ hf
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hmem
  refine ⟨a, ?_⟩
  rw [← ha, Algebra.smul_def, algebraMap_laurent]
  rw [mul_left_comm, mul_inv_cancel₀ (RatFunc.algebraMap_ne_zero h.polynomial_ne_zero),
    mul_one]

theorem IsNormalizedGenerator.hasCommonDenominator
    {values : Set RationalFunctions} {P : ℂ[X]}
    (h : IsNormalizedGenerator values P) : HasCommonDenominator values := by
  refine ⟨P.toLaurent, Polynomial.toLaurent_ne_zero.mpr h.polynomial_ne_zero, ?_⟩
  intro f hf
  simpa only [laurentToRatFunc_toLaurent] using h.clearsDenominators (mem_zetaSpan hf)

/-- A normalization can be established by clearing all generating values and
showing that the proposed reciprocal itself belongs to the generated module. -/
theorem isNormalizedGenerator_iff (values : Set RationalFunctions) (P : ℂ[X]) :
    IsNormalizedGenerator values P ↔
      P.coeff 0 = 1 ∧
      (∀ f ∈ values, ∃ a : LaurentCoefficients,
        laurentToRatFunc a = algebraMap ℂ[X] RationalFunctions P * f) ∧
      (algebraMap ℂ[X] RationalFunctions P)⁻¹ ∈ zetaSpan values := by
  constructor
  · intro h
    refine ⟨h.1, fun f hf => h.clearsDenominators (mem_zetaSpan hf), ?_⟩
    rw [h.2]
    exact Submodule.mem_span_singleton_self _
  · rintro ⟨hP, hclear, hmem⟩
    have hP0 : P ≠ 0 := by
      intro hzero
      simp [hzero] at hP
    refine ⟨hP, le_antisymm (Submodule.span_le.mpr ?_)
      ((Submodule.span_singleton_le_iff_mem _ _).mpr hmem)⟩
    intro f hf
    obtain ⟨a, ha⟩ := hclear f hf
    refine Submodule.mem_span_singleton.mpr ⟨a, ?_⟩
    rw [Algebra.smul_def, algebraMap_laurent, ha, mul_right_comm,
      mul_inv_cancel₀ (RatFunc.algebraMap_ne_zero hP0), one_mul]

private theorem polynomial_dvd_of_laurent_multiple {P Q : ℂ[X]}
    (hP : P.coeff 0 = 1) (a : LaurentCoefficients)
    (ha : laurentToRatFunc a * algebraMap ℂ[X] RationalFunctions P =
      algebraMap ℂ[X] RationalFunctions Q) : P ∣ Q := by
  obtain ⟨n, A, hA⟩ := LaurentPolynomial.exists_T_pow a
  have hmap : algebraMap ℂ[X] RationalFunctions (A * P) =
      algebraMap ℂ[X] RationalFunctions (Q * X ^ n) := by
    rw [map_mul, map_mul, map_pow, RatFunc.algebraMap_X]
    rw [← laurentToRatFunc_toLaurent A, hA, map_mul, laurentToRatFunc_T,
      zpow_natCast, mul_right_comm, ha]
  have hpoly : A * P = Q * X ^ n := RatFunc.algebraMap_injective ℂ hmap
  have hcop : IsCoprime P X := by
    refine ⟨1, -P.divX, ?_⟩
    have hx := Polynomial.X_mul_divX_add P
    rw [hP, Polynomial.C_1] at hx
    calc
      1 * P + -P.divX * X = P - X * P.divX := by ring
      _ = 1 := sub_eq_iff_eq_add.mpr (by simpa only [add_comm] using hx.symm)
  have hcopn : IsCoprime P (X ^ n) := hcop.pow_right
  exact hcopn.dvd_of_dvd_mul_right ⟨A, by rw [← hpoly, mul_comm]⟩

private theorem polynomial_dvd_of_reciprocal_mem {P Q : ℂ[X]}
    (hP : P.coeff 0 = 1) (hQ : Q ≠ 0)
    (hmem : (algebraMap ℂ[X] RationalFunctions P)⁻¹ ∈
      Submodule.span LaurentCoefficients {(algebraMap ℂ[X] RationalFunctions Q)⁻¹}) :
    P ∣ Q := by
  have hP0 : P ≠ 0 := by
    intro hzero
    simp [hzero] at hP
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hmem
  change laurentToRatFunc a * (algebraMap ℂ[X] RationalFunctions Q)⁻¹ =
    (algebraMap ℂ[X] RationalFunctions P)⁻¹ at ha
  have ha' := (mul_inv_eq_iff_eq_mul₀ (RatFunc.algebraMap_ne_zero hQ)).mp ha
  apply polynomial_dvd_of_laurent_multiple hP a
  rw [ha', mul_right_comm, inv_mul_cancel₀ (RatFunc.algebraMap_ne_zero hP0), one_mul]

/-- The condition `P(0)=1` removes the unit ambiguity of the reciprocal generator. -/
theorem IsNormalizedGenerator.unique {values : Set RationalFunctions} {P Q : ℂ[X]}
    (hP : IsNormalizedGenerator values P) (hQ : IsNormalizedGenerator values Q) : P = Q := by
  have hPQ : P ∣ Q := by
    apply polynomial_dvd_of_reciprocal_mem hP.1 hQ.polynomial_ne_zero
    rw [← hQ.2, hP.2]
    exact Submodule.mem_span_singleton_self _
  have hQP : Q ∣ P := by
    apply polynomial_dvd_of_reciprocal_mem hQ.1 hP.polynomial_ne_zero
    rw [← hP.2, hQ.2]
    exact Submodule.mem_span_singleton_self _
  obtain ⟨u, hu⟩ := associated_of_dvd_dvd hPQ hQP
  obtain ⟨c, _, hc⟩ := Polynomial.isUnit_iff.mp u.isUnit
  have hc1 : c = 1 := by
    have hzero := congrArg (fun p : ℂ[X] => p.coeff 0) hu
    simpa only [← hc, Polynomial.mul_coeff_zero, Polynomial.coeff_C_zero,
      hP.1, hQ.1, one_mul] using hzero
  simpa only [← hc, hc1, Polynomial.C_1, mul_one] using hu

/-- The remaining existence prerequisite for a normalized reciprocal generator. -/
def NormalizedGeneratorExists (values : Set RationalFunctions) : Prop :=
  ∃ P : ℂ[X], IsNormalizedGenerator values P

/-- Select the unique polynomial only from a proof of its defining existence relation. -/
def normalizedPolynomial (values : Set RationalFunctions)
    (h : NormalizedGeneratorExists values) : ℂ[X] :=
  h.choose

theorem normalizedPolynomial_spec (values : Set RationalFunctions)
    (h : NormalizedGeneratorExists values) :
    IsNormalizedGenerator values (normalizedPolynomial values h) :=
  h.choose_spec

theorem normalizedPolynomial_eq {values : Set RationalFunctions}
    (h : NormalizedGeneratorExists values) {P : ℂ[X]}
    (hP : IsNormalizedGenerator values P) : normalizedPolynomial values h = P :=
  (normalizedPolynomial_spec values h).unique hP

/-- The normalized rational factor of a proven normalized zeta module.
Applying this to representations still requires the analytic existence theorem
for their actual zeta values. -/
def normalizedFactor (values : Set RationalFunctions)
    (h : NormalizedGeneratorExists values) : RationalFunctionsˣ :=
  (Units.mk0 (algebraMap ℂ[X] RationalFunctions (normalizedPolynomial values h))
    (RatFunc.algebraMap_ne_zero (normalizedPolynomial_spec values h).polynomial_ne_zero))⁻¹

@[simp]
theorem coe_normalizedFactor (values : Set RationalFunctions)
    (h : NormalizedGeneratorExists values) :
    (normalizedFactor values h : RationalFunctions) =
      (algebraMap ℂ[X] RationalFunctions (normalizedPolynomial values h))⁻¹ := rfl

theorem normalizedFactor_generates (values : Set RationalFunctions)
    (h : NormalizedGeneratorExists values) :
    zetaSpan values = Submodule.span LaurentCoefficients
      {(normalizedFactor values h : RationalFunctions)} :=
  (normalizedPolynomial_spec values h).2

end Langlands.RankinSelberg
