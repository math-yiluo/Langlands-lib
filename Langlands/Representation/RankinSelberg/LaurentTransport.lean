import Langlands.Representation.RankinSelberg.LocalFactor

/-!
# Laurent monomial transport of rational continuations and zeta modules

This algebraic bridge constructs the invertible Laurent monomial and proves
transport of continuation and generated modules. No analytic existence or
change-of-measure property is assumed implicitly.
-/

noncomputable section

namespace Langlands.RankinSelberg

open Polynomial

/-- The actual Laurent unit with coefficient c and exponent m. -/
def laurentMonomialUnit (c : ℂˣ) (m : ℤ) : LaurentCoefficientsˣ where
  val := LaurentPolynomial.C (c : ℂ) * LaurentPolynomial.T m
  inv := LaurentPolynomial.C (↑c⁻¹ : ℂ) * LaurentPolynomial.T (-m)
  val_inv := by
    rw [mul_mul_mul_comm, ← map_mul, ← LaurentPolynomial.T_add]
    simp
  inv_val := by
    rw [mul_mul_mul_comm, ← map_mul, ← LaurentPolynomial.T_add]
    simp

@[simp] theorem laurentToRatFunc_monomialUnit (c : ℂˣ) (m : ℤ) :
    laurentToRatFunc (laurentMonomialUnit c m : LaurentCoefficients) =
      RatFunc.C (c : ℂ) * (RatFunc.X : RationalFunctions) ^ m := by
  simp [laurentMonomialUnit, laurentToRatFunc_C]

@[simp] theorem laurentMonomialUnit_inv (c : ℂˣ) (m : ℤ) :
    (laurentMonomialUnit c m)⁻¹ = laurentMonomialUnit c⁻¹ (-m) := by
  apply Units.ext
  rfl

/-- Multiplication by a unit of the coefficient ring does not change a
submodule generated by a set, provided both directions of transport are given. -/
theorem zetaSpan_eq_of_unit_mul {S T : Set RationalFunctions} (u : LaurentCoefficientsˣ)
    (hST : ∀ R ∈ S, laurentToRatFunc (u : LaurentCoefficients) * R ∈ T)
    (hTS : ∀ R ∈ T, laurentToRatFunc (↑u⁻¹ : LaurentCoefficients) * R ∈ S) :
    zetaSpan S = zetaSpan T := by
  have key : ∀ {A B : Set RationalFunctions} (v : LaurentCoefficientsˣ),
      (∀ R ∈ A, laurentToRatFunc (v : LaurentCoefficients) * R ∈ B) →
      zetaSpan A ≤ zetaSpan B := by
    intro A B v hAB
    refine Submodule.span_le.2 fun R hR => ?_
    change R ∈ zetaSpan B
    have hmem := Submodule.smul_mem (zetaSpan B) (↑v⁻¹ : LaurentCoefficients)
      (mem_zetaSpan (hAB R hR))
    simpa only [Algebra.smul_def, algebraMap_laurent, ← mul_assoc, ← map_mul,
      Units.inv_mul, map_one, one_mul] using hmem
  exact le_antisymm (key u hST) (key u⁻¹ (by simpa using hTS))

/-- In particular, multiplication by a nonzero Laurent monomial preserves the
Laurent span when it transports the generating sets in both directions. -/
theorem zetaSpan_eq_of_monomial_mul {S T : Set RationalFunctions} (c : ℂˣ) (m : ℤ)
    (hST : ∀ R ∈ S, RatFunc.C (c : ℂ) * (RatFunc.X : RationalFunctions) ^ m * R ∈ T)
    (hTS : ∀ R ∈ T, RatFunc.C (↑c⁻¹ : ℂ) * (RatFunc.X : RationalFunctions) ^ (-m) * R ∈ S) :
    zetaSpan S = zetaSpan T := by
  apply zetaSpan_eq_of_unit_mul (laurentMonomialUnit c m)
  · simpa only [laurentToRatFunc_monomialUnit] using hST
  · simpa only [laurentMonomialUnit_inv, laurentToRatFunc_monomialUnit] using hTS

private theorem denom_eval_mul_ne_zero {R S : RationalFunctions} {x : ℂ}
    (hR : R.denom.eval x ≠ 0) (hS : S.denom.eval x ≠ 0) :
    (R * S).denom.eval x ≠ 0 := by
  intro h0
  have h := Polynomial.eval₂_eq_zero_of_dvd_of_eval₂_eq_zero (RingHom.id ℂ) x
    (RatFunc.denom_mul_dvd R S) h0
  simp only [eval₂_id, eval_mul, mul_eq_zero, hR, hS, or_self] at h

/-- Products of continuations agree on the intersection of their right half-planes. -/
theorem HasRationalContinuation.mul {q : ℕ} {f g : ℂ → ℂ} {R S : RationalFunctions}
    (hR : HasRationalContinuation q f R) (hS : HasRationalContinuation q g S) :
    HasRationalContinuation q (fun s => f s * g s) (R * S) := by
  obtain ⟨a, ha⟩ := hR
  obtain ⟨b, hb⟩ := hS
  refine ⟨max a b, fun s hs => ?_⟩
  obtain ⟨hdR, heR⟩ := ha s ((le_max_left a b).trans_lt hs)
  obtain ⟨hdS, heS⟩ := hb s ((le_max_right a b).trans_lt hs)
  exact ⟨denom_eval_mul_ne_zero hdR hdS,
    (congrArg₂ (· * ·) heR heS).trans (RatFunc.eval_mul _ _ hdR hdS).symm⟩

/-- Natural powers preserve the continuation relation. -/
theorem HasRationalContinuation.pow {q : ℕ} {f : ℂ → ℂ} {R : RationalFunctions}
    (h : HasRationalContinuation q f R) (m : ℕ) :
    HasRationalContinuation q (fun s => f s ^ m) (R ^ m) := by
  induction m with
  | zero => exact ⟨0, by simp [RatFunc.denom_one]⟩
  | succ m ih => simpa only [pow_succ] using ih.mul h

/-- The spectral point itself continues to the formal variable X. -/
theorem hasRationalContinuation_spectralPoint (q : ℕ) :
    HasRationalContinuation q (spectralPoint q) (RatFunc.X : RationalFunctions) := by
  exact ⟨0, by simp [RatFunc.denom_X]⟩

private theorem hasRationalContinuation_spectralPoint_inv {q : ℕ} (hq : 0 < q) :
    HasRationalContinuation q (fun s => (spectralPoint q s)⁻¹)
      ((RatFunc.X : RationalFunctions)⁻¹) := by
  refine ⟨0, fun s _ => ?_⟩
  have hx : spectralPoint q s ≠ 0 := Complex.cpow_ne_zero_iff.mpr
    (Or.inl (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hq)))
  have hd : (RatFunc.X⁻¹ : RationalFunctions).denom.eval (spectralPoint q s) ≠ 0 := by
    intro h0
    have h := Polynomial.eval₂_eq_zero_of_dvd_of_eval₂_eq_zero (RingHom.id ℂ)
      (spectralPoint q s) (RatFunc.denom_inv_dvd RatFunc.X_ne_zero) h0
    exact hx (by simpa [RatFunc.num_X] using h)
  refine ⟨hd, ?_⟩
  have he := RatFunc.eval_mul (RingHom.id ℂ) (spectralPoint q s)
    (x := (RatFunc.X : RationalFunctions)) (y := RatFunc.X⁻¹)
    (by simp [RatFunc.denom_X]) hd
  rw [mul_inv_cancel₀ RatFunc.X_ne_zero, RatFunc.eval_one, RatFunc.eval_X] at he
  exact (eq_inv_of_mul_eq_one_right he.symm).symm

/-- Every integer spectral power has its Laurent rational continuation.
Positive q ensures that the spectral point is never zero. -/
theorem hasRationalContinuation_spectralPoint_zpow {q : ℕ} (hq : 0 < q) (m : ℤ) :
    HasRationalContinuation q (fun s => spectralPoint q s ^ m)
      ((RatFunc.X : RationalFunctions) ^ m) := by
  cases m with
  | ofNat m => simpa only [Int.ofNat_eq_natCast, zpow_natCast] using
      (hasRationalContinuation_spectralPoint q).pow m
  | negSucc m => simpa only [zpow_negSucc, inv_pow] using
      (hasRationalContinuation_spectralPoint_inv hq).pow (m + 1)

/-- Multiplying a scalar family by c q^(-ms) multiplies its continuation by c X^m. -/
theorem HasRationalContinuation.monomial_mul {q : ℕ} (hq : 0 < q)
    {f : ℂ → ℂ} {R : RationalFunctions} (h : HasRationalContinuation q f R)
    (c : ℂ) (m : ℤ) :
    HasRationalContinuation q (fun s => c * spectralPoint q s ^ m * f s)
      (RatFunc.C c * (RatFunc.X : RationalFunctions) ^ m * R) := by
  simpa only [mul_assoc] using hasRationalContinuation_const_mul c
    ((hasRationalContinuation_spectralPoint_zpow hq m).mul h)

end Langlands.RankinSelberg
