import Langlands.Representation.Classification.TadicBlockReductionStatement
import Langlands.Representation.Aubert.SegmentPolynomialSurjectivity
import Langlands.Representation.Aubert.SegmentPolynomialComparisonProof
import Langlands.Representation.Classification.MultisegmentSocleExhaustionProof
import Langlands.Representation.Classification.LinkedSegmentSocleReverseProductStructureProof
import Langlands.Representation.Classification.DistinctCuspidalProductMultiplicityFreeProof
import Langlands.Representation.Classification.SupercuspidalSupport
import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# The ring `R` in the segment-monomial coordinates

Tools for Tadić's Proposition 3.8. Through the comparison `ℤ[segments] ≅ R` of
Zelevinsky's Corollary 7.5, the class of a label of `b` is a polynomial whose monomial
`X^b` has coefficient one and whose other monomials `X^e` satisfy `e ≼ b` in the rank
order (Zelevinsky 1980, Theorem 7.1). Products of effective classes are effective, and by
Proposition 4.6 the product `ζ(Δ') ζ(Δ)` of a pair with `Δ` preceding `Δ'` dominates
`ζ(Δ ∪ Δ') ζ(Δ ∩ Δ')`.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory

namespace Langlands.Classification.TadicRectanglePrime

open Aubert Aubert.SegmentPolynomialSurjectivity PadicField.TopologicalData
open SmoothRep SmoothRep.IrreducibleGrothendieckProof VirtualRepresentation

universe uF uV

variable {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p) (T : F.TopologicalData)

/-- Tadić's ring `R`: the published graded induction ring with its proved laws. -/
abbrev ringR : CommRing (GradedGrothendieckGroup.{uF, uV} F T) :=
  gradedInductionRing F T (binaryProductExactness.{uF, uV} F T)
    (gradedInductionRingLaws F T (binaryProductExactness.{uF, uV} F T))

attribute [local instance] ringR

/-- A fixed unitary additive character, used only to invoke the published triangularity. -/
def ψ₀ : @HarmonicAnalysis.UnitaryAdditiveCharacter F.Carrier _ T.topology :=
  Classical.choice (HarmonicAnalysis.padicUnitaryAdditiveCharacterExists F T)

/-- Zelevinsky's `ζ(a)` in `R`. -/
abbrev zetaR (a : T.Multisegment.{max uF uV, uF}) : GradedGrothendieckGroup.{uF, uV} F T :=
  zeta F T (binaryProductExactness.{uF, uV} F T)
    (gradedInductionRingLaws F T (binaryProductExactness.{uF, uV} F T)) a

/-- The ring equivalence `ℤ[segments] ≃ R` of Zelevinsky's Corollary 7.5. -/
abbrev segmentEquiv : MvPolynomial T.Segment.{max uF uV, uF} ℤ ≃+*
    GradedGrothendieckGroup.{uF, uV} F T :=
  segmentPolynomialEquiv F T _ _ (segmentPolynomialComparison F T _ _)

/-- The polynomial in the segment variables representing a class of `R`. -/
abbrev poly (x : GradedGrothendieckGroup.{uF, uV} F T) : MvPolynomial T.Segment.{max uF uV, uF} ℤ :=
  (segmentEquiv F T).symm x

/-- The coefficient of the monomial `μ` in the polynomial of a class, as a functional. -/
def polyCoeff (μ : T.Segment.{max uF uV, uF} →₀ ℕ) :
    GradedGrothendieckGroup.{uF, uV} F T →ₗ[ℤ] ℤ :=
  (MvPolynomial.lcoeff ℤ μ).comp (segmentEquiv F T).symm.toAddMonoidHom.toIntLinearMap

theorem polyCoeff_apply (μ : T.Segment.{max uF uV, uF} →₀ ℕ)
    (x : GradedGrothendieckGroup.{uF, uV} F T) :
    polyCoeff F T μ x = (poly F T x).coeff μ := rfl

/-! ### Monomials -/

open Classical in
theorem prod_map_X_eq_monomial {σ : Type*} (s : Multiset σ) :
    (s.map (MvPolynomial.X (R := ℤ))).prod = MvPolynomial.monomial (Multiset.toFinsupp s) 1 := by
  induction s using Multiset.induction_on with
  | empty => simp
  | cons a s ih =>
    rw [Multiset.map_cons, Multiset.prod_cons, ih, ← Multiset.singleton_add,
      Multiset.toFinsupp_add, Multiset.toFinsupp_singleton, MvPolynomial.X,
      MvPolynomial.monomial_mul_monomial, one_mul]

open Classical in
/-- `ζ(b)` is the monomial `X^b`. -/
theorem poly_zetaR (b : T.Multisegment.{max uF uV, uF}) :
    poly F T (zetaR F T b) = MvPolynomial.monomial (Multiset.toFinsupp b) 1 := by
  rw [← prod_map_X_eq_monomial]
  apply (segmentEquiv F T).injective
  rw [RingEquiv.apply_symm_apply]
  rfl

/-! ### Effective classes -/

/-- The additive submonoid generated by the basis classes. -/
def basisSpan : AddSubmonoid (GradedGrothendieckGroup.{uF, uV} F T) :=
  AddSubmonoid.closure {y | ∃ m c, y = basisClass F T m c}

theorem mem_basisSpan_of_isEffective {x : GradedGrothendieckGroup.{uF, uV} F T}
    (hx : IsEffective F T x) : x ∈ basisSpan F T := by
  classical
  let := T.topology
  rw [eq_sum_basisClass F T x]
  refine AddSubmonoid.sum_mem _ fun m _ => ?_
  rw [Finsupp.sum]
  refine AddSubmonoid.sum_mem _ fun c _ => ?_
  have hz : 0 ≤ factorMap (x m) c := hx m c
  have : factorMap (x m) c • basisClass F T m c =
      (factorMap (x m) c).toNat • basisClass F T m c := by
    conv_lhs => rw [← Int.toNat_of_nonneg hz]
    rw [natCast_zsmul]
  rw [this]
  exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure
    (show basisClass F T m c ∈ {y | ∃ m c, y = basisClass F T m c} from ⟨m, c, rfl⟩)) _

/-- The product of two basis classes is effective: it is the class of an actual product. -/
theorem isEffective_basisClass_mul (m : ℕ) (c : Label.{uF, uV} F T m) (m' : ℕ)
    (c' : Label.{uF, uV} F T m') :
    IsEffective F T (basisClass F T m c * basisClass F T m' c') := by
  let := T.topology
  obtain ⟨A, hA, rfl⟩ := IrreducibleIsoClass.exists_eq c
  obtain ⟨B, hB, rfl⟩ := IrreducibleIsoClass.exists_eq c'
  rw [basisClass_irreducibleIsoClass, basisClass_irreducibleIsoClass]
  change IsEffective F T (gradedMultiplication F T (binaryProductExactness F T) _ _)
  rw [gradedMultiplication_homogeneous]
  have hA' := SmoothRep.hasFiniteLength_of_isIrreducible hA
  have hB' := SmoothRep.hasFiniteLength_of_isIrreducible hB
  have := binaryProductK0_classes F T (binaryProductExactness F T) m m' ⟨A, hA'⟩ ⟨B, hB'⟩
  change IsEffective F T (gradedInclusion F T (m + m')
    (binaryProductK0 F T (binaryProductExactness F T) m m'
      (SmoothRep.FiniteLengthGrothendieckGroup.ofObject ⟨A, hA'⟩)
      (SmoothRep.FiniteLengthGrothendieckGroup.ofObject ⟨B, hB'⟩)))
  rw [this]
  exact isEffective_gradedInclusion_ofRepresentation F T _ _ _

/-- Products of effective classes are effective. -/
theorem isEffective_mul {x y : GradedGrothendieckGroup.{uF, uV} F T}
    (hx : IsEffective F T x) (hy : IsEffective F T y) : IsEffective F T (x * y) := by
  have hx' := mem_basisSpan_of_isEffective F T hx
  have hy' := mem_basisSpan_of_isEffective F T hy
  clear hx hy
  induction hx' using AddSubmonoid.closure_induction with
  | mem u hu =>
    obtain ⟨m, c, rfl⟩ := hu
    induction hy' using AddSubmonoid.closure_induction with
    | mem v hv =>
      obtain ⟨m', c', rfl⟩ := hv
      exact isEffective_basisClass_mul F T m c m' c'
    | zero => rw [mul_zero]; exact isEffective_zero F T
    | add v w _ _ hv hw => rw [mul_add]; exact hv.add F T hw
  | zero => rw [zero_mul]; exact isEffective_zero F T
  | add u w _ _ hu hw => rw [add_mul]; exact hu.add F T hw

theorem coeff_le_of_isEffective_sub {x y : GradedGrothendieckGroup.{uF, uV} F T}
    (h : IsEffective F T (y - x)) (m : ℕ) (c : Label.{uF, uV} F T m) :
    coeff F T m c x ≤ coeff F T m c y := by
  have := h m c
  rw [map_sub] at this
  omega

/-- Two functionals agreeing on the basis classes occurring in `x` agree on `x`. -/
theorem apply_eq_of_coeff {φ χ : GradedGrothendieckGroup.{uF, uV} F T →ₗ[ℤ] ℤ}
    {x : GradedGrothendieckGroup.{uF, uV} F T}
    (h : ∀ m c, coeff F T m c x ≠ 0 → φ (basisClass F T m c) = χ (basisClass F T m c)) :
    φ x = χ x := by
  classical
  let := T.topology
  rw [apply_eq_sum F T φ, apply_eq_sum F T χ]
  refine Finset.sum_congr rfl fun m _ => Finsupp.sum_congr fun c hc => ?_
  rw [h m c (Finsupp.mem_support_iff.mp hc)]

/-! ### Labels -/

theorem rankLE_of_isLabel_of_coeff_pos {a b : T.Multisegment.{max uF uV, uF}} {m : ℕ}
    {c : Label.{uF, uV} F T m} (hb : IsLabel F T b m c) (h : 0 < coeff F T m c (zetaR F T a)) :
    Multisegment.RankLE b a :=
  rankLE_of_coeff_zeta_pos F T _ _ (ψ₀ F T) (highestDerivativeLabelStep F T (ψ₀ F T)) m c b a hb h

theorem coeff_zetaR_pos_of_isLabel {a : T.Multisegment.{max uF uV, uF}} {m : ℕ}
    {c : Label.{uF, uV} F T m} (h : IsLabel F T a m c) : 0 < coeff F T m c (zetaR F T a) :=
  lt_of_lt_of_le one_pos (one_le_coeff_zeta_of_isLabel F T _ _ h)

/-- A label determines its multisegment. -/
theorem eq_of_isLabel {a b : T.Multisegment.{max uF uV, uF}} {m : ℕ}
    {c : Label.{uF, uV} F T m} (ha : IsLabel F T a m c) (hb : IsLabel F T b m c) : a = b :=
  Multisegment.RankLE.antisymm
    (rankLE_of_isLabel_of_coeff_pos F T ha (coeff_zetaR_pos_of_isLabel F T hb))
    (rankLE_of_isLabel_of_coeff_pos F T hb (coeff_zetaR_pos_of_isLabel F T ha))

theorem isEffective_zetaR_sub_basisClass {a : T.Multisegment.{max uF uV, uF}} {m : ℕ}
    {c : Label.{uF, uV} F T m} (hc : IsLabel F T a m c) :
    IsEffective F T (zetaR F T a - basisClass F T m c) :=
  isEffective_sub_basisClass F T (isEffective_zeta F T _ _ a)
    (one_le_coeff_zeta_of_isLabel F T _ _ hc)

/-- A label of `a` occurs exactly once in `ζ(a)`, and no other label of `a` occurs. -/
theorem coeff_zetaR_sub_basisClass_eq_zero {a : T.Multisegment.{max uF uV, uF}} {m : ℕ}
    {c : Label.{uF, uV} F T m} (hc : IsLabel F T a m c) {m' : ℕ} {c' : Label.{uF, uV} F T m'}
    (hc' : IsLabel F T a m' c') : coeff F T m' c' (zetaR F T a - basisClass F T m c) = 0 := by
  have hx := isEffective_zetaR_sub_basisClass F T hc
  have h1 := coeff_mul_le_weightedCount F T (w := labelWeight F T a) (labelWeight_nonneg F T a)
    hx m' c'
  rw [labelWeight_of_isLabel F T hc', mul_one] at h1
  have h4 : weightedCount F T (labelWeight F T a) (zetaR F T a - basisClass F T m c) =
      weightedCount F T (labelWeight F T a) (zetaR F T a) - 1 := by
    rw [map_sub (weightedCount F T (labelWeight F T a)), weightedCount_basisClass,
      labelWeight_of_isLabel F T hc]
  have h2 : weightedCount F T (labelWeight F T a) (zetaR F T a) ≤ 1 :=
    labelCount_zeta_le_one F T (binaryProductExactness F T)
    (gradedInductionRingLaws F T (binaryProductExactness F T)) (ψ₀ F T) (highestDerivativeLabelStep F T (ψ₀ F T)) a
  have h3 := hx m' c'
  omega

/-! ### Triangularity in the monomial basis -/

open Classical in
/-- **Zelevinsky 1980, Theorem 7.1, in the monomial basis.** The polynomial of the class
of a label of `b` has coefficient one at `X^b`, and each of its monomials `X^e` satisfies
`e ≼ b`. -/
theorem poly_basisClass (b : T.Multisegment.{max uF uV, uF}) :
    ∀ (m : ℕ) (c : Label.{uF, uV} F T m), IsLabel F T b m c →
      (poly F T (basisClass F T m c)).coeff (Multiset.toFinsupp b) = 1 ∧
        ∀ μ, (poly F T (basisClass F T m c)).coeff μ ≠ 0 →
          Multisegment.RankLE (Finsupp.toMultiset μ) b := by
  refine (Multisegment.wellFounded_rankLT (T := T)).induction
    (C := fun b => ∀ (m : ℕ) (c : Label.{uF, uV} F T m), IsLabel F T b m c →
      (poly F T (basisClass F T m c)).coeff (Multiset.toFinsupp b) = 1 ∧
        ∀ μ, (poly F T (basisClass F T m c)).coeff μ ≠ 0 →
          Multisegment.RankLE (Finsupp.toMultiset μ) b) b ?_
  intro b ih m c hb
  set y := zetaR F T b - basisClass F T m c with hy
  have hyeff : IsEffective F T y := isEffective_zetaR_sub_basisClass F T hb
  let S : AddSubgroup (GradedGrothendieckGroup.{uF, uV} F T) :=
    (MvPolynomial.restrictSupport ℤ
      {μ | Multisegment.RankLE (Finsupp.toMultiset μ) b ∧ Finsupp.toMultiset μ ≠ b}).toAddSubgroup.comap
      (segmentEquiv F T).symm.toAddMonoidHom
  have hyS : y ∈ S := by
    refine mem_of_coeff F T fun m' c' hc' => ?_
    have hpos : 0 < coeff F T m' c' y := lt_of_le_of_ne (hyeff m' c') (Ne.symm hc')
    obtain ⟨b', hb'⟩ := exists_isLabel F T (multisegmentSocleExhaustion F T) m' c'
    have hz : 0 < coeff F T m' c' (zetaR F T b) := by
      have := isEffective_basisClass F T m c m' c'
      rw [hy, map_sub] at hpos
      omega
    have hrank : Multisegment.RankLE b' b := rankLE_of_isLabel_of_coeff_pos F T hb' hz
    have hne : b' ≠ b := by
      rintro rfl
      have := coeff_zetaR_sub_basisClass_eq_zero F T hb hb'
      rw [← hy] at this
      omega
    have hlow := (ih b' ⟨hrank, hne⟩ m' c' hb').2
    rw [AddSubgroup.mem_comap, Submodule.mem_toAddSubgroup, MvPolynomial.mem_restrictSupport_iff]
    intro μ hμ
    have hμ' := hlow μ (MvPolynomial.mem_support_iff.mp hμ)
    refine ⟨hμ'.trans hrank, fun h => hne ?_⟩
    rw [h] at hμ'
    exact Multisegment.RankLE.antisymm hrank hμ'
  have hsupp : ∀ μ, (poly F T y).coeff μ ≠ 0 →
      Multisegment.RankLE (Finsupp.toMultiset μ) b ∧ Finsupp.toMultiset μ ≠ b := by
    intro μ hμ
    have := hyS
    rw [AddSubgroup.mem_comap, Submodule.mem_toAddSubgroup,
      MvPolynomial.mem_restrictSupport_iff] at this
    exact this (MvPolynomial.mem_support_iff.mpr hμ)
  have he : poly F T (basisClass F T m c) =
      MvPolynomial.monomial (Multiset.toFinsupp b) 1 - poly F T y := by
    have h1 : poly F T y = poly F T (zetaR F T b) - poly F T (basisClass F T m c) := by
      rw [hy]
      exact map_sub (segmentEquiv F T).symm _ _
    rw [h1, poly_zetaR, sub_sub_cancel]
  have hb0 : (poly F T y).coeff (Multiset.toFinsupp b) = 0 := by
    by_contra h
    exact (hsupp _ h).2 (Multiset.toFinsupp_toMultiset b)
  refine ⟨?_, fun μ hμ => ?_⟩
  · rw [he, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial, ite_eq_left rfl, hb0, sub_zero]
  · by_cases hμb : Multiset.toFinsupp b = μ
    · rw [← hμb, Multiset.toFinsupp_toMultiset]
      exact Multisegment.RankLE.refl b
    · rw [he, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial, ite_eq_right hμb, zero_sub,
        neg_ne_zero] at hμ
      exact (hsupp μ hμ).1

/-! ### Proposition 4.6 -/

/-- **Zelevinsky 1980, Proposition 4.6, in `R`.** If `Δ` precedes `Γ`, then
`ζ(Γ) ζ(Δ) - ζ(Δ ∪ Γ) ζ(Δ ∩ Γ)` is effective (the intersection omitted when empty). -/
theorem exists_isEffective_zetaR_pair_sub {Δ Γ : T.Segment.{max uF uV, uF}}
    (h : Δ.Precedes Γ) :
    ∃ (U : T.Segment.{max uF uV, uF}) (I : Option T.Segment.{max uF uV, uF}),
      Γ.IsUnionIntersectionReplacement Δ U I ∧
        IsEffective F T (zetaR F T ({Γ, Δ} : T.Multisegment.{max uF uV, uF}) -
          zetaR F T ((U :: I.toList : List _) : T.Multisegment.{max uF uV, uF})) := by
  let := T.topology
  obtain ⟨d, hd, hs⟩ := SegmentProductDatum.exists_of_list
    (segmentZelevinskyConstituentExistence.{uF, max uF uV} F T) [Γ, Δ]
    (n := Γ.degree + Δ.degree) (by simp)
  have hlen : d.length = 2 := by
    have := congrArg List.length hd
    simpa using this
  have h0 : d.segments ⟨0, by omega⟩ = Γ := by
    have := congrArg (fun l => l[0]?) hd
    simp at this
    obtain ⟨_, h⟩ := this
    exact h
  have h1 : d.segments ⟨1, by omega⟩ = Δ := by
    have := congrArg (fun l => l[1]?) hd
    simp at this
    obtain ⟨_, h⟩ := this
    exact h
  obtain ⟨U, I, e, hrep, he, hes, hirr, s, -, ⟨φ⟩, -, -⟩ :=
    linkedSegmentSocleReverseProductStructure.{uF, max uF uV} F T _ d hlen hs
      (by rw [h0, h1]; exact h)
  rw [h0, h1] at hrep
  refine ⟨U, I, hrep, ?_⟩
  have hdm : d.multisegment = ({Γ, Δ} : T.Multisegment.{max uF uV, uF}) := by
    rw [SegmentProductDatum.multisegment, hd]
    rfl
  have hem : e.multisegment = ((U :: I.toList : List _) : T.Multisegment.{max uF uV, uF}) := by
    rw [SegmentProductDatum.multisegment, he]
  obtain ⟨hk, hsub⟩ := DistinctCuspidalProduct.exists_isSubquotient_graded T d.induced s 1
  have hsub' : SmoothRep.IsSubquotient e.induced d.induced :=
    SmoothRep.IsSubquotient.of_iso_left (SmoothRep.mkIso φ) hsub
  have hirr' : e.induced.IsIrreducible := hirr
  have hfl := SegmentProductClass.hasFiniteLength_induced F T d hs
  have hpos : 0 < compositionMultiplicity ⟨_, hfl⟩ e.induced :=
    (compositionMultiplicity_pos_iff_isSubquotient ⟨_, hfl⟩ e.induced hirr').mpr hsub'
  have hc := coeff_gradedInclusion_ofRepresentation F T _ _ hfl e.induced hirr'
  rw [← zeta_multisegment F T (binaryProductExactness F T)
    (gradedInductionRingLaws F T (binaryProductExactness F T)) d hs, hdm] at hc
  have hbe : zetaR F T ((U :: I.toList : List _) : T.Multisegment.{max uF uV, uF}) =
      basisClass F T _ (GeneralLinear.irreducibleIsoClass _ F.Carrier e.induced hirr') := by
    rw [← hem, zetaR, zeta_multisegment F T (binaryProductExactness F T)
      (gradedInductionRingLaws F T (binaryProductExactness F T)) e hes,
      basisClass_irreducibleIsoClass]
  rw [hbe]
  refine isEffective_sub_basisClass F T (isEffective_zeta F T _ _ _) ?_
  rw [hc]
  exact_mod_cast hpos

end Langlands.Classification.TadicRectanglePrime
