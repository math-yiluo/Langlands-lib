import Langlands.Representation.RankinSelberg.RationalZeta
import Mathlib.Algebra.Algebra.Operations

/-!
# Products of rational-value families and their normalized generators

These are algebraic lemmas for the finite-product step of analytic induction.
They make no assertion that an induced integral has a product expansion.
-/

noncomputable section

namespace Langlands.GodementJacquet

open RankinSelberg
open scoped Pointwise

/-- Products of two rational-value families, before taking their Laurent span. -/
def productRationalValues (A B : Set RationalFunctions) : Set RationalFunctions :=
  A * B

@[simp]
theorem mem_productRationalValues {A B : Set RationalFunctions} {r : RationalFunctions} :
    r ∈ productRationalValues A B ↔ ∃ a ∈ A, ∃ b ∈ B, a * b = r :=
  Set.mem_mul

/-- The span of all products is the product of the two Laurent submodules. -/
theorem zetaSpan_productRationalValues (A B : Set RationalFunctions) :
    zetaSpan (productRationalValues A B) = zetaSpan A * zetaSpan B := by
  exact (Submodule.span_mul_span LaurentCoefficients A B).symm

/-- Multiplication preserves the prescribed normalization and multiplies the
two reciprocal-polynomial generators. Both span inclusions are included. -/
theorem normalizedGenerator_productRationalValues
    {A B : Set RationalFunctions} {P Q : Polynomial ℂ}
    (hP : IsNormalizedGenerator A P) (hQ : IsNormalizedGenerator B Q) :
    IsNormalizedGenerator (productRationalValues A B) (P * Q) := by
  refine ⟨by simp only [Polynomial.mul_coeff_zero, hP.1, hQ.1, one_mul], ?_⟩
  rw [zetaSpan_productRationalValues, hP.2, hQ.2, Submodule.span_mul_span]
  simp only [Set.singleton_mul_singleton, map_mul, mul_inv_rev, mul_comm]

/-- An equality of the actual Laurent spans transports a normalized generator.
The equality is a separate mathematical obligation. -/
theorem normalizedGenerator_of_span_eq
    {A B : Set RationalFunctions} {P : Polynomial ℂ}
    (hP : IsNormalizedGenerator A P) (hspan : zetaSpan B = zetaSpan A) :
    IsNormalizedGenerator B P :=
  ⟨hP.1, hspan.trans hP.2⟩

/-- The algebraic conclusion for two blocks, once the actual value module is
proved equal to the module generated by products of block values. -/
theorem normalizedGenerator_twoBlock_of_span_eq
    (values : Fin 2 → Set RationalFunctions) (P : Fin 2 → Polynomial ℂ)
    (hP : ∀ i, IsNormalizedGenerator (values i) (P i))
    {inducedValues : Set RationalFunctions}
    (hspan : zetaSpan inducedValues =
      zetaSpan (values 0) * zetaSpan (values 1)) :
    IsNormalizedGenerator inducedValues (∏ i, P i) := by
  rw [Fin.prod_univ_two]
  exact normalizedGenerator_of_span_eq
    (normalizedGenerator_productRationalValues (hP 0) (hP 1))
    (hspan.trans (zetaSpan_productRationalValues _ _).symm)

end Langlands.GodementJacquet
