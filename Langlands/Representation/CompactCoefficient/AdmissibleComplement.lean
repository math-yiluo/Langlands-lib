import Langlands.Representation.CompactCoefficient.AdmissibleRetraction
import Langlands.Representation.CompactCoefficient.Isotypic
import Langlands.Representation.CompactCoefficient.FixedVectorsFiniteDimensional
import Langlands.Representation.Smooth.Factorization.MultiplicityDefinitions

/-!
# Isotypic complements for compact irreducible admissible representations

Let `ρ` be an irreducible admissible representation with compact smooth-dual
coefficients and `σ` a smooth representation. The sum of the ranges of all
intertwiners `ρ → σ` and the common kernel of all intertwiners `σ → ρ` are
complementary subspaces of `σ`. Disjointness uses the retractions of
`AdmissibleRetraction`. Exhaustion uses the sections of `AdmissibleLifting`
and an induction on the dimension of `Hom(τ, ρ)`, starting from the cyclic
subrepresentation generated by a vector.

Finite-dimensionality of compact fixed vectors makes every irreducible
representation with compact smooth-dual coefficients admissible, so the
intrinsic isotypic and annihilator subrepresentations of every
compact-coefficient class are complementary.
-/

noncomputable section

namespace Langlands.CompactSplitting

open MeasureTheory Representation

universe uG uV uW uU

variable {G : Type uG} [Group G]
variable {V : Type uV} [AddCommGroup V] [Module ℂ V]
variable {W : Type uW} [AddCommGroup W] [Module ℂ W]
variable {U : Type uU} [AddCommGroup U] [Module ℂ U]

section Parts

/-- The sum of the ranges of all intertwiners from `ρ` to `σ`. -/
def isotypicPart (ρ : Representation ℂ G V) (σ : Representation ℂ G W) : Submodule ℂ W :=
  ⨆ f : ρ.IntertwiningMap σ, LinearMap.range f.toLinearMap

/-- The common kernel of all intertwiners from `σ` to `ρ`. -/
def annihilatorPart (ρ : Representation ℂ G V) (σ : Representation ℂ G W) : Submodule ℂ W :=
  ⨅ f : σ.IntertwiningMap ρ, LinearMap.ker f.toLinearMap

theorem range_le_isotypicPart (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (f : ρ.IntertwiningMap σ) : LinearMap.range f.toLinearMap ≤ isotypicPart ρ σ :=
  le_iSup (fun f : ρ.IntertwiningMap σ => LinearMap.range f.toLinearMap) f

theorem mem_annihilatorPart_iff (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (w : W) : w ∈ annihilatorPart ρ σ ↔ ∀ f : σ.IntertwiningMap ρ, f w = 0 := by
  simp only [annihilatorPart, Submodule.mem_iInf, LinearMap.mem_ker,
    IntertwiningMap.toLinearMap_apply]

/-- If there is no nonzero intertwiner `τ → ρ`, every intertwiner `τ → σ` lands
in the common kernel of the intertwiners `σ → ρ`. -/
theorem range_le_annihilatorPart_of_forall_eq_zero (ρ : Representation ℂ G V)
    {σ : Representation ℂ G W} {τ : Representation ℂ G U} (ι : τ.IntertwiningMap σ)
    (h : ∀ e : τ.IntertwiningMap ρ, e = 0) :
    LinearMap.range ι.toLinearMap ≤ annihilatorPart ρ σ := by
  rintro _ ⟨u, rfl⟩
  rw [mem_annihilatorPart_iff]
  intro φ
  exact congrArg (fun ψ : τ.IntertwiningMap ρ => ψ u) (h (φ.comp ι))

/-- The subrepresentation spanned by the orbit of a vector. -/
def orbitSpan (σ : Representation ℂ G W) (w : W) : Subrepresentation σ where
  toSubmodule := Submodule.span ℂ (Set.range fun g : G => σ g w)
  apply_mem_toSubmodule g := by
    intro x hx
    have hle : Submodule.span ℂ (Set.range fun h : G => σ h w) ≤
        (Submodule.span ℂ (Set.range fun h : G => σ h w)).comap (σ g) := by
      rw [Submodule.span_le]
      rintro _ ⟨h, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap]
      exact Submodule.subset_span ⟨g * h, by simp [map_mul, Module.End.mul_apply]⟩
    exact hle hx

theorem mem_orbitSpan_self (σ : Representation ℂ G W) (w : W) :
    w ∈ (orbitSpan σ w).toSubmodule :=
  Submodule.subset_span ⟨1, by simp⟩

/-- An intertwiner out of the cyclic subrepresentation generated by `w` is
determined by its value at `w`. -/
theorem eq_zero_of_apply_orbitSpan_eq_zero {σ : Representation ℂ G W} {w : W}
    {ρ : Representation ℂ G V} (φ : (orbitSpan σ w).toRepresentation.IntertwiningMap ρ)
    (hφ : φ ⟨w, mem_orbitSpan_self σ w⟩ = 0) : φ = 0 := by
  apply IntertwiningMap.ext
  apply LinearMap.ext
  rintro ⟨x, hx⟩
  change φ ⟨x, hx⟩ = 0
  have hx' : x ∈ Submodule.span ℂ (Set.range fun g : G => σ g w) := hx
  refine Submodule.span_induction
    (p := fun x hx => φ ⟨x, hx⟩ = 0) ?_ ?_ ?_ ?_ hx'
  · rintro _ ⟨g, rfl⟩
    have h : (⟨σ g w, Submodule.subset_span ⟨g, rfl⟩⟩ : (orbitSpan σ w).toSubmodule) =
        (orbitSpan σ w).toRepresentation g ⟨w, mem_orbitSpan_self σ w⟩ := rfl
    rw [h, IntertwiningMap.isIntertwining, hφ, map_zero]
  · exact map_zero φ
  · intro y z hy hz ihy ihz
    have h : (⟨y + z, Submodule.add_mem _ hy hz⟩ : (orbitSpan σ w).toSubmodule) =
        ⟨y, hy⟩ + ⟨z, hz⟩ := rfl
    rw [h, map_add, ihy, ihz, add_zero]
  · intro a y hy ihy
    have h : (⟨a • y, Submodule.smul_mem _ a hy⟩ : (orbitSpan σ w).toSubmodule) =
        a • ⟨y, hy⟩ := rfl
    rw [h, map_smul, ihy, smul_zero]

end Parts

variable [TopologicalSpace G]

/-- Smoothness passes to subrepresentations. -/
theorem isSmooth_subrepresentation {σ : Representation ℂ G W} (hσ : IsSmooth σ)
    (P : Subrepresentation σ) : IsSmooth P.toRepresentation := by
  intro v
  obtain ⟨K, hK⟩ := hσ v
  refine ⟨K, ?_⟩
  rw [fixedVectors, Representation.mem_invariants] at hK ⊢
  intro k
  exact Subtype.ext (hK k)

variable [IsTopologicalGroup G] [MeasurableSpace G] [BorelSpace G]

section Disjoint

/-- A finite sum of vectors in images of `ρ` that is killed by every
intertwiner to `ρ` vanishes. Induction on the number of terms: a retraction of
the first nonzero embedding expresses its term through the others. -/
theorem sum_eq_zero_of_mem_annihilatorPart (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (ρ : Representation ℂ G V) (hρ : IsAdmissible ρ) (hirr : ρ.IsIrreducible)
    (hc : HasCompactSmoothDualCoefficients ρ) {σ : Representation ℂ G W} (hσ : IsSmooth σ)
    {ι : Type*} (s : Finset ι) (f : ι → ρ.IntertwiningMap σ) (v : ι → V)
    (hx : ∑ i ∈ s, f i (v i) ∈ annihilatorPart ρ σ) : ∑ i ∈ s, f i (v i) = 0 := by
  classical
  induction s using Finset.induction generalizing f with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.sum_insert ha] at hx ⊢
    rcases IsIrreducible.injective_or_eq_zero (f a) with hinj | hzero
    · obtain ⟨r, hr⟩ := exists_retraction hcof μ ρ hρ hirr hc hσ (f a) hinj
      have hra (u : V) : r (f a u) = u :=
        congrArg (fun φ : ρ.IntertwiningMap ρ => φ u) hr
      have hrx : r (f a (v a) + ∑ i ∈ s, f i (v i)) = 0 :=
        (mem_annihilatorPart_iff ρ σ _).1 hx r
      rw [map_add, hra] at hrx
      have hva : v a = -r (∑ i ∈ s, f i (v i)) := eq_neg_of_add_eq_zero_left hrx
      have key : f a (v a) + ∑ i ∈ s, f i (v i) =
          ∑ i ∈ s, (f i - (f a).comp (r.comp (f i))) (v i) := by
        simp only [IntertwiningMap.coe_sub, Pi.sub_apply, IntertwiningMap.comp_apply,
          Finset.sum_sub_distrib]
        rw [← map_sum (f a), ← map_sum r, hva, map_neg]
        abel
      rw [key] at hx ⊢
      exact ih _ hx
    · have h0 : f a (v a) = 0 := by rw [hzero]; rfl
      rw [h0, zero_add] at hx ⊢
      exact ih f hx

/-- The images of `ρ` meet the common kernel of the maps to `ρ` trivially. -/
theorem isotypicPart_inf_annihilatorPart (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (ρ : Representation ℂ G V) (hρ : IsAdmissible ρ) (hirr : ρ.IsIrreducible)
    (hc : HasCompactSmoothDualCoefficients ρ) {σ : Representation ℂ G W} (hσ : IsSmooth σ) :
    isotypicPart ρ σ ⊓ annihilatorPart ρ σ = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨hxI, hxN⟩ := Submodule.mem_inf.1 hx
  rw [Submodule.mem_bot]
  obtain ⟨s, hs⟩ := Submodule.mem_iSup_iff_exists_finset.1 hxI
  obtain ⟨m, hm⟩ := (Submodule.mem_iSup_finset_iff_exists_sum _ x).1 hs
  choose v hv using fun f : ρ.IntertwiningMap σ => LinearMap.mem_range.1 (m f).property
  have hxs : x = ∑ f ∈ s, f (v f) := by
    rw [← hm]
    exact Finset.sum_congr rfl fun f _ => (hv f).symm
  rw [hxs] at hxN ⊢
  exact sum_eq_zero_of_mem_annihilatorPart μ hcof ρ hρ hirr hc hσ s (fun f => f) v hxN

end Disjoint

section Exhaustion

/-- Induction on `dim Hom(τ, ρ)`: the image of every intertwiner `τ → σ` from a
smooth `τ` with finite-dimensional `Hom(τ, ρ)` lies in the sum of the images of
`ρ` and the common kernel of the maps to `ρ`. A nonzero `e : τ → ρ` is
surjective; a section splits off a copy of `ρ`, and `Hom(ker e, ρ)` embeds into
`Hom(τ, ρ)` with `e` outside the image. -/
theorem range_le_isotypicPart_sup_annihilatorPart (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (ρ : Representation ℂ G V) (hρ : IsAdmissible ρ) (hirr : ρ.IsIrreducible)
    (hc : HasCompactSmoothDualCoefficients ρ) (σ : Representation ℂ G W) (n : ℕ) :
    ∀ {X : Type uU} [AddCommGroup X] [Module ℂ X] (τ : Representation ℂ G X),
      IsSmooth τ → ∀ ι : τ.IntertwiningMap σ,
      FiniteDimensional ℂ (τ.IntertwiningMap ρ) →
      Module.finrank ℂ (τ.IntertwiningMap ρ) ≤ n →
      LinearMap.range ι.toLinearMap ≤ isotypicPart ρ σ ⊔ annihilatorPart ρ σ := by
  have : Nontrivial V := IsSimpleModule.nontrivial (MonoidAlgebra ℂ G) ρ.asModule
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  induction n with
  | zero =>
    intro X _ _ τ _ ι hfin hn
    refine (range_le_annihilatorPart_of_forall_eq_zero ρ ι fun e => ?_).trans le_sup_right
    have : Subsingleton (τ.IntertwiningMap ρ) := Module.finrank_zero_iff.1 (Nat.le_zero.1 hn)
    exact Subsingleton.elim _ _
  | succ n ih =>
    intro X _ _ τ hτ ι hfin hn
    by_cases hall : ∀ e : τ.IntertwiningMap ρ, e = 0
    · exact (range_le_annihilatorPart_of_forall_eq_zero ρ ι hall).trans le_sup_right
    push Not at hall
    obtain ⟨e, he⟩ := hall
    have hsurj : Function.Surjective e :=
      (IsIrreducible.surjective_or_eq_zero e).resolve_right he
    obtain ⟨s, hs⟩ := exists_section μ hcof ρ hρ hirr hc hτ e hsurj
    have hes (v : V) : e (s v) = v := congrArg (fun φ : ρ.IntertwiningMap ρ => φ v) hs
    let K : Subrepresentation τ := e.ker
    let πl : X →ₗ[ℂ] K.toSubmodule :=
      LinearMap.codRestrict K.toSubmodule (LinearMap.id - s.toLinearMap ∘ₗ e.toLinearMap)
        (fun u => by
          change e (u - s (e u)) = 0
          rw [map_sub, hes, sub_self])
    let π : τ.IntertwiningMap K.toRepresentation :=
      πl.intertwiningMap_of_isIntertwiningMap τ K.toRepresentation (fun g u => by
        apply Subtype.ext
        change τ g u - s (e (τ g u)) = τ g (u - s (e u))
        rw [e.isIntertwining, s.isIntertwining, map_sub])
    have hπ (u : X) : (π u : X) = u - s (e u) := rfl
    let ext : K.toRepresentation.IntertwiningMap ρ →ₗ[ℂ] τ.IntertwiningMap ρ :=
      (IntertwiningMap.llcomp _ _ _).flip π
    have hext (φ : K.toRepresentation.IntertwiningMap ρ) (u : X) : ext φ u = φ (π u) := rfl
    have hπK (k : K.toSubmodule) : π k = k := by
      apply Subtype.ext
      rw [hπ, show e (k : X) = 0 from k.property, map_zero, sub_zero]
    have hinj : Function.Injective ext := by
      refine (injective_iff_map_eq_zero ext).2 fun φ hφ => ?_
      apply IntertwiningMap.ext
      apply LinearMap.ext
      intro k
      have h := congrArg (fun ψ : τ.IntertwiningMap ρ => ψ (k : X)) hφ
      change ext φ (k : X) = 0 at h
      rw [hext, hπK] at h
      exact h
    have hne : LinearMap.range ext ≠ ⊤ := by
      intro htop
      have hmem : e ∈ LinearMap.range ext := by rw [htop]; exact Submodule.mem_top
      obtain ⟨φ, hφ⟩ := LinearMap.mem_range.1 hmem
      have hπs : π (s v₀) = 0 := by
        apply Subtype.ext
        rw [hπ, hes, sub_self]
        rfl
      have h := congrArg (fun ψ : τ.IntertwiningMap ρ => ψ (s v₀)) hφ
      change ext φ (s v₀) = e (s v₀) at h
      rw [hext, hπs, map_zero, hes] at h
      exact hv₀ h.symm
    have hfin' : FiniteDimensional ℂ (K.toRepresentation.IntertwiningMap ρ) :=
      FiniteDimensional.of_injective ext hinj
    have hlt : Module.finrank ℂ (K.toRepresentation.IntertwiningMap ρ) <
        Module.finrank ℂ (τ.IntertwiningMap ρ) := by
      rw [← LinearMap.finrank_range_of_inj hinj]
      exact Submodule.finrank_lt hne
    have hrange := ih K.toRepresentation (isSmooth_subrepresentation hτ K)
      (ι.comp (ProductFactorization.subrepresentationInclusion K)) hfin' (by omega)
    rintro _ ⟨u, rfl⟩
    have hu : ι.toLinearMap u =
        (ι.comp s) (e u) + (ι.comp (ProductFactorization.subrepresentationInclusion K)) (π u) := by
      change ι u = ι (s (e u)) + ι (π u : X)
      rw [hπ, ← map_add]
      congr 1
      abel
    rw [hu]
    exact Submodule.add_mem _
      (Submodule.mem_sup_left (range_le_isotypicPart ρ σ (ι.comp s) ⟨e u, rfl⟩))
      (hrange ⟨π u, rfl⟩)

/-- Every vector of `σ` lies in the sum of the images of `ρ` and the common
kernel of the maps to `ρ`. -/
theorem isotypicPart_sup_annihilatorPart (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (ρ : Representation ℂ G V) (hρ : IsAdmissible ρ) (hirr : ρ.IsIrreducible)
    (hc : HasCompactSmoothDualCoefficients ρ) {σ : Representation ℂ G W} (hσ : IsSmooth σ) :
    isotypicPart ρ σ ⊔ annihilatorPart ρ σ = ⊤ := by
  rw [eq_top_iff]
  intro w _
  obtain ⟨K, hK⟩ := hσ w
  rw [fixedVectors, Representation.mem_invariants] at hK
  let P := orbitSpan σ w
  let x₀ : P.toSubmodule := ⟨w, mem_orbitSpan_self σ w⟩
  let ev : P.toRepresentation.IntertwiningMap ρ →ₗ[ℂ] fixedVectors ρ K.toSubgroup :=
    { toFun := fun φ => ⟨φ x₀, by
        rw [fixedVectors, Representation.mem_invariants]
        intro k
        change ρ (k : G) (φ x₀) = φ x₀
        rw [← IntertwiningMap.isIntertwining]
        congr 1
        exact Subtype.ext (hK k)⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hinj : Function.Injective ev := by
    refine (injective_iff_map_eq_zero ev).2 fun φ hφ => ?_
    exact eq_zero_of_apply_orbitSpan_eq_zero φ (congrArg Subtype.val hφ)
  have : Module.Finite ℂ (fixedVectors ρ K.toSubgroup) := hρ.2 K
  have hfin : FiniteDimensional ℂ (P.toRepresentation.IntertwiningMap ρ) :=
    FiniteDimensional.of_injective ev hinj
  exact range_le_isotypicPart_sup_annihilatorPart μ hcof ρ hρ hirr hc σ _
    P.toRepresentation (isSmooth_subrepresentation hσ P)
    (ProductFactorization.subrepresentationInclusion P)
    hfin le_rfl ⟨x₀, rfl⟩

end Exhaustion

/-- The sum of the images of `ρ` and the common kernel of the maps to `ρ` are
complementary in every smooth representation. -/
theorem isCompl_isotypicPart_annihilatorPart (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (ρ : Representation ℂ G V) (hρ : IsAdmissible ρ) (hirr : ρ.IsIrreducible)
    (hc : HasCompactSmoothDualCoefficients ρ) {σ : Representation ℂ G W} (hσ : IsSmooth σ) :
    IsCompl (isotypicPart ρ σ) (annihilatorPart ρ σ) :=
  IsCompl.of_eq (isotypicPart_inf_annihilatorPart μ hcof ρ hρ hirr hc hσ)
    (isotypicPart_sup_annihilatorPart μ hcof ρ hρ hirr hc hσ)

/-- When compact open subgroups are cofinal among open subgroups, an
irreducible smooth representation with compact smooth-dual coefficients is
admissible. -/
theorem isAdmissible_of_compactCoefficients (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (ρ : Representation ℂ G V) (hρ : IsSmooth ρ) (hirr : ρ.IsIrreducible)
    (hc : HasCompactSmoothDualCoefficients ρ) : IsAdmissible ρ := by
  refine ⟨hρ, fun K => ?_⟩
  obtain ⟨L, hL, hLK⟩ := hcof K
  have : FiniteDimensional ℂ (fixedVectors ρ L.toSubgroup) :=
    CompactCoefficientClass.finiteDimensional_fixedVectors μ ρ hρ L hL hirr hc
  have hle : fixedVectors ρ K.toSubgroup ≤ fixedVectors ρ L.toSubgroup := by
    intro v hv
    rw [fixedVectors, Representation.mem_invariants] at hv ⊢
    intro l
    exact hv ⟨l.val, hLK l.property⟩
  exact Submodule.finiteDimensional_of_le hle

/-- For an actual representative `D` of a class `c`, the published intrinsic
isotypic and annihilator subrepresentations of `c` are complementary. -/
theorem isCompl_isotypicSubrepresentation_annihilatorSubrepresentation_of_rep
    (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    {c : CompactCoefficientClass.{uG, uV} G} (D : IrreducibleCompactCoefficientRep.{uG, uV} G)
    (hD : CompactCoefficientClass.ofRep D = c) (A : SmoothRep.{0, uG, uW} ℂ G) :
    IsCompl (CompactCoefficientClass.isotypicSubrepresentation c A).toSubmodule
      (CompactCoefficientClass.annihilatorSubrepresentation c A).toSubmodule := by
  rw [CompactCoefficientClass.isotypicSubrepresentation_eq_iSup_range D hD,
    CompactCoefficientClass.annihilatorSubrepresentation_eq_iInf_ker D hD,
    Subrepresentation.toSubmodule_iSup, Subrepresentation.toSubmodule_iInf]
  exact isCompl_isotypicPart_annihilatorPart μ hcof D.obj.representation
    (isAdmissible_of_compactCoefficients μ hcof D.obj.representation D.obj.isSmooth
      D.property.1 D.property.2)
    D.property.1 D.property.2 A.isSmooth

/-- For every compact-coefficient class `c` and smooth representation `A`, the
published intrinsic isotypic and annihilator subrepresentations are
complementary. -/
theorem isCompl_isotypicSubrepresentation_annihilatorSubrepresentation
    (μ : Measure G) [μ.IsHaarMeasure]
    (hcof : ∀ K : OpenSubgroup G, ∃ L : OpenSubgroup G, IsCompact (L : Set G) ∧ L ≤ K)
    (c : CompactCoefficientClass.{uG, uV} G) (A : SmoothRep.{0, uG, uW} ℂ G) :
    IsCompl (CompactCoefficientClass.isotypicSubrepresentation c A).toSubmodule
      (CompactCoefficientClass.annihilatorSubrepresentation c A).toSubmodule := by
  induction c using Quotient.inductionOn with
  | h D =>
    exact isCompl_isotypicSubrepresentation_annihilatorSubrepresentation_of_rep μ hcof D rfl A

end Langlands.CompactSplitting
