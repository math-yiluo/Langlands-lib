import Langlands.Representation.CompactCoefficient.SelectedProjector
import Mathlib.RepresentationTheory.Semisimple

/-!
# Pure algebraic semisimplicity of intrinsic isotypic sums

This module states a proposition; it does not prove it. The three intrinsic
sums are generated by ranges of irreducible representations. Compact
coefficients select the classes but supply no analytic premise for this target.
-/

namespace Langlands.CompactCoefficientClass

universe uG uC uV

/-- Every intrinsic single-class, finite selected-class, and total isotypic
subrepresentation is algebraically semisimple. The group, representative-carrier,
and ambient-carrier universes are independent. -/
def IsotypicSemisimplicityTheorem : Prop :=
  ∀ (G : Type uG) [Group G] [TopologicalSpace G]
    (A : SmoothRep.{0, uG, uV} ℂ G),
    (∀ c : CompactCoefficientClass.{uG, uC} G,
      Representation.IsSemisimpleRepresentation
        (isotypicSubrepresentation c A).toRepresentation) ∧
    (∀ t : Finset (CompactCoefficientClass.{uG, uC} G),
      Representation.IsSemisimpleRepresentation
        (selectedIsotypicSubrepresentation t A).toRepresentation) ∧
    Representation.IsSemisimpleRepresentation
      (totalIsotypicSubrepresentation.{uG, uC} A).toRepresentation

end Langlands.CompactCoefficientClass
