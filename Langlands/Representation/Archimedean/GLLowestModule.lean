import Langlands.Representation.Archimedean.GLLowestWeight
import Mathlib.RingTheory.MvPolynomial.EulerIdentity
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.RingTheory.Derivation.Lie
import Mathlib.LinearAlgebra.Matrix.MvPolynomial

/-!
# Finite-dimensional lowest weight modules from minors

`𝔤𝔩_n(ℂ)` acts on the polynomial ring `P = ℂ[x_ab]` in the entries of an `n × n` matrix by the
derivations `e_pq = Σ_b x_pb ∂/∂x_qb` (`polyFam`, `isGlFamily_polyFam`). For `r < n` let
`Δ_r = det (x_ij)_{i,j > r}` be the bottom right minor of size `n - 1 - r` (`minor`). It is killed
by `e_pq` for `q < p` (replacing row `q` by row `p` creates two equal rows) and has weight
`(0, …, 0, 1, …, 1)` with ones in the positions `> r`. Hence `v₀ = Π_r Δ_r ^ A` (`lowVec`) is a
nonzero lowest weight vector of weight `A · (0, 1, …, n - 1)`.

`lowMod n A` is the subspace generated by `v₀`. It is finite-dimensional (it consists of
polynomials of total degree at most `deg v₀`), has integral weights, is generated by the lowest
weight vector `v₀`, and is irreducible (`eq_top_of_isStable_lowMod`).
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean

namespace GLReynolds

open ComplexJacquetFinite Module MvPolynomial

/-- Polynomial functions on `n × n` matrices. -/
abbrev Pol (n : ℕ) := MvPolynomial (Fin n × Fin n) ℂ

variable {n : ℕ}

/-! ### The polynomial representation -/

section Poly

/-- The derivation `e_pq = Σ_b x_pb ∂/∂x_qb` of `P`. -/
def polyDer (p q : Fin n) : Derivation ℂ (Pol n) (Pol n) :=
  mkDerivation ℂ fun ab => if ab.1 = q then X (p, ab.2) else 0

theorem polyDer_X (p q a b : Fin n) :
    polyDer p q (X (a, b)) = if a = q then X (p, b) else 0 := by
  rw [polyDer, mkDerivation_X]

variable (n) in
/-- The family of operators `e_pq` on `P`. -/
def polyFam : Fin n → Fin n → Module.End ℂ (Pol n) := fun p q => (polyDer p q).toLinearMap

theorem polyFam_apply (p q : Fin n) (f : Pol n) : polyFam n p q f = polyDer p q f := rfl

theorem isGlFamily_polyFam : IsGlFamily (polyFam n) := by
  intro a b c d
  have key : ⁅polyDer a b, polyDer c d⁆ =
      (if b = c then polyDer a d else 0) - (if d = a then polyDer c b else 0) := by
    apply MvPolynomial.derivation_ext
    rintro ⟨i, j⟩
    have e1 : ∀ (D : Derivation ℂ (Pol n) (Pol n)) (P : Prop) [Decidable P] (x : Pol n),
        D (if P then x else 0) = if P then D x else 0 := by
      intro D P _ x; split_ifs <;> simp
    have e2 : ∀ (P : Prop) [Decidable P] (D : Derivation ℂ (Pol n) (Pol n)) (x : Pol n),
        (if P then D else 0) x = if P then D x else 0 := by
      intro P _ D x; split_ifs <;> simp
    rw [Derivation.commutator_apply, Derivation.sub_apply]
    simp only [polyDer_X, e1, e2]
    split_ifs <;> subst_vars <;> simp_all
  apply LinearMap.ext
  intro f
  have := congrArg (fun D : Derivation ℂ (Pol n) (Pol n) => D f) key
  simp only [Derivation.commutator_apply] at this
  simp only [LinearMap.sub_apply, Module.End.mul_apply, polyFam_apply, this]
  split_ifs <;> simp [polyFam_apply]

/-- `e_pq` as a sum of partial derivatives. -/
theorem polyDer_apply (p q : Fin n) (f : Pol n) :
    polyDer p q f = ∑ b, X (p, b) * pderiv (q, b) f := by
  classical
  have key : polyDer p q = ∑ b, (X (p, b) : Pol n) • pderiv (q, b) := by
    apply MvPolynomial.derivation_ext
    rintro ⟨i, j⟩
    rw [polyDer_X, ← Derivation.coeFn_coe, Derivation.coe_sum_linearMap, LinearMap.sum_apply]
    simp only [Derivation.coeFn_coe, Derivation.smul_apply, pderiv_X, smul_eq_mul]
    by_cases hi : i = q
    · subst hi
      rw [Finset.sum_eq_single j]
      · simp
      · intro b _ hb
        simp [Prod.ext_iff, Ne.symm hb]
      · simp
    · rw [ite_eq_right hi]
      symm
      apply Finset.sum_eq_zero
      intro b _
      simp [Prod.ext_iff, hi]
  rw [key, ← Derivation.coeFn_coe, Derivation.coe_sum_linearMap, LinearMap.sum_apply]
  simp only [Derivation.coeFn_coe, Derivation.smul_apply, smul_eq_mul]

/-- `e_pq` preserves homogeneity. -/
theorem isHomogeneous_polyDer {f : Pol n} {k : ℕ} (hf : f.IsHomogeneous k) (p q : Fin n) :
    (polyDer p q f).IsHomogeneous k := by
  rw [polyDer_apply]
  apply IsHomogeneous.sum
  intro b _
  rcases k with _ | k
  · rw [← totalDegree_zero_iff_isHomogeneous, totalDegree_eq_zero_iff_eq_C] at hf
    rw [hf, pderiv_C, mul_zero]
    exact isHomogeneous_zero _ _ _
  · have h := (isHomogeneous_X ℂ (p, b)).mul (hf.pderiv (i := (q, b)))
    simpa [add_comm] using h

/-- The polynomials of total degree at most `D` form an `e`-stable subspace. -/
theorem isStable_restrictTotalDegree (D : ℕ) :
    IsStable (polyFam n) (restrictTotalDegree (Fin n × Fin n) ℂ D) := by
  intro p q f hf
  rw [mem_restrictTotalDegree] at hf ⊢
  rw [polyFam_apply, ← sum_homogeneousComponent f, map_sum]
  refine (totalDegree_finsetSum _ _).trans (Finset.sup_le fun i hi => ?_)
  refine (isHomogeneous_polyDer (homogeneousComponent_isHomogeneous i f) p q).totalDegree_le.trans ?_
  have := Finset.mem_range.mp hi
  omega

end Poly

/-! ### Derivations and eigenvectors -/

section Eigen

variable {B : Type*} [CommRing B] [Algebra ℂ B]

theorem der_prod_eigen (D : Derivation ℂ B B) {ι : Type*} (s : Finset ι) (g : ι → B)
    (c : ι → ℂ) (hg : ∀ i ∈ s, D (g i) = c i • g i) :
    D (∏ i ∈ s, g i) = (∑ i ∈ s, c i) • ∏ i ∈ s, g i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, Derivation.leibniz,
      ih (fun i hi => hg i (Finset.mem_insert_of_mem hi)), hg a (Finset.mem_insert_self a s)]
    simp only [smul_eq_mul, Algebra.smul_def, map_add]
    ring

theorem der_pow_eigen (D : Derivation ℂ B B) {a : B} {c : ℂ} (h : D a = c • a) (k : ℕ) :
    D (a ^ k) = ((k : ℂ) * c) • a ^ k := by
  have := der_prod_eigen D (Finset.range k) (fun _ => a) (fun _ => c) (fun _ _ => h)
  simpa [Finset.prod_const, Finset.card_range, Finset.sum_const, nsmul_eq_mul] using this

end Eigen

/-! ### Minors -/

section Minor

/-- The algebra map `x_ab ↦ x_ab + [a = q] x_pb T` into `P[T]`; its coefficient of `T` is
`e_pq` (`flow_coeff`). -/
def flow (p q : Fin n) : Pol n →ₐ[ℂ] Polynomial (Pol n) :=
  aeval fun ab => Polynomial.C (X ab) +
    Polynomial.C (if ab.1 = q then X (p, ab.2) else 0) * Polynomial.X

theorem flow_X (p q : Fin n) (ab : Fin n × Fin n) :
    flow p q (X ab) = Polynomial.C (X ab) +
      Polynomial.C (if ab.1 = q then X (p, ab.2) else 0) * Polynomial.X :=
  aeval_X _ _

theorem flow_coeff (p q : Fin n) (f : Pol n) :
    (flow p q f).coeff 0 = f ∧ (flow p q f).coeff 1 = polyDer p q f := by
  induction f using MvPolynomial.induction_on with
  | C a =>
    have h1 : flow p q (C a) = Polynomial.C (C a) := by
      rw [flow, aeval_C]; rfl
    have h2 : polyDer p q (C a) = 0 := (polyDer p q).map_algebraMap a
    rw [h1, h2, Polynomial.coeff_C_zero, Polynomial.coeff_C]
    simp
  | add f g hf hg =>
    rw [map_add, Polynomial.coeff_add, Polynomial.coeff_add, hf.1, hf.2, hg.1, hg.2, map_add]
    exact ⟨rfl, rfl⟩
  | mul_X f ab hf =>
    obtain ⟨a, b⟩ := ab
    have hX : polyDer p q (X (a, b)) = if a = q then X (p, b) else 0 := polyDer_X p q a b
    rw [map_mul, flow_X, Derivation.leibniz, hX, smul_eq_mul, smul_eq_mul]
    set g : Pol n := if a = q then X (p, b) else 0
    have e1 : flow p q f * (Polynomial.C (X (a, b)) + Polynomial.C g * Polynomial.X) =
        flow p q f * Polynomial.C (X (a, b)) + flow p q f * Polynomial.C g * Polynomial.X := by
      ring
    rw [e1, Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_mul_C,
      Polynomial.coeff_mul_C, Polynomial.coeff_mul_X_zero, hf.1]
    refine ⟨by simp, ?_⟩
    have e2 : (flow p q f * Polynomial.C g * Polynomial.X).coeff 1 =
        (flow p q f * Polynomial.C g).coeff 0 := Polynomial.coeff_mul_X _ 0
    rw [e2, Polynomial.coeff_mul_C, hf.1, hf.2]
    ring

/-- The bottom right minor `Δ_r = det (x_ij)_{i,j > r}`. -/
def minorMat (r : Fin n) : Matrix {s : Fin n // r < s} {s : Fin n // r < s} (Pol n) :=
  Matrix.of fun i j => X (i.1, j.1)

/-- The bottom right minor `Δ_r = det (x_ij)_{i,j > r}`. -/
def minor (r : Fin n) : Pol n := (minorMat r).det

theorem flow_minor_lower {p q : Fin n} (hqp : q < p) (r : Fin n) :
    flow p q (minor r) = Polynomial.C (minor r) := by
  classical
  rw [minor, AlgHom.map_det, RingHom.map_det]
  set M' := (Polynomial.C : Pol n →+* Polynomial (Pol n)).mapMatrix (minorMat r) with hM'
  by_cases hq : r < q
  · have hp : r < p := hq.trans hqp
    have hne : (⟨q, hq⟩ : {s : Fin n // r < s}) ≠ ⟨p, hp⟩ := fun h =>
      (ne_of_lt hqp) (congrArg Subtype.val h)
    have hM : (flow p q).mapMatrix (minorMat r) =
        Matrix.updateRow M' ⟨q, hq⟩ (M' ⟨q, hq⟩ + (Polynomial.X : Polynomial (Pol n)) • M' ⟨p, hp⟩) := by
      ext i j : 1
      rw [Matrix.updateRow_apply]
      by_cases hi : i = ⟨q, hq⟩
      · subst hi
        simp [hM', minorMat, flow_X]
        try ring
      · have hi' : ¬ i.1 = q := fun h => hi (Subtype.ext h)
        simp [hM', minorMat, flow_X, hi, hi']
    rw [hM, Matrix.det_updateRow_add_smul_self _ hne]
  · have hM : (flow p q).mapMatrix (minorMat r) = M' := by
      ext i j : 1
      have hi' : ¬ i.1 = q := fun h => hq (h ▸ i.2)
      simp [hM', minorMat, flow_X, hi']
    rw [hM]

theorem flow_minor_diag (t r : Fin n) :
    flow t t (minor r) = (if r < t then 1 + Polynomial.X else 1) * Polynomial.C (minor r) := by
  classical
  rw [minor, AlgHom.map_det, RingHom.map_det]
  set M' := (Polynomial.C : Pol n →+* Polynomial (Pol n)).mapMatrix (minorMat r) with hM'
  by_cases ht : r < t
  · have hM : (flow t t).mapMatrix (minorMat r) =
        Matrix.updateRow M' ⟨t, ht⟩ ((1 + (Polynomial.X : Polynomial (Pol n))) • M' ⟨t, ht⟩) := by
      ext i j : 1
      rw [Matrix.updateRow_apply]
      by_cases hi : i = ⟨t, ht⟩
      · subst hi
        simp [hM', minorMat, flow_X]
        ring
      · have hi' : ¬ i.1 = t := fun h => hi (Subtype.ext h)
        simp [hM', minorMat, flow_X, hi, hi']
    rw [hM, Matrix.det_updateRow_smul, Matrix.updateRow_eq_self, ite_eq_left ht]
  · have hM : (flow t t).mapMatrix (minorMat r) = M' := by
      ext i j : 1
      have hi' : ¬ i.1 = t := fun h => ht (h ▸ i.2)
      simp [hM', minorMat, flow_X, hi']
    rw [hM]; simp [ht]

theorem polyDer_minor_lower {p q : Fin n} (hqp : q < p) (r : Fin n) :
    polyDer p q (minor r) = 0 := by
  rw [← (flow_coeff p q _).2, flow_minor_lower hqp, Polynomial.coeff_C]
  simp

theorem polyDer_minor_diag (t r : Fin n) :
    polyDer t t (minor r) = (if r < t then (1 : ℂ) else 0) • minor r := by
  rw [← (flow_coeff t t _).2, flow_minor_diag]
  split_ifs
  · rw [add_mul, one_mul, Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_X_mul,
      Polynomial.coeff_C_zero]
    simp
  · rw [one_mul, Polynomial.coeff_C]
    simp

theorem minor_ne_zero (r : Fin n) : minor r ≠ 0 := by
  classical
  have hinj : Function.Injective
      (fun ij : {s : Fin n // r < s} × {s : Fin n // r < s} => ((ij.1 : Fin n), (ij.2 : Fin n))) := by
    rintro ⟨a, b⟩ ⟨c, d⟩ h
    simp only [Prod.mk.injEq] at h
    rw [Subtype.ext h.1, Subtype.ext h.2]
  have h : minor r = rename (fun ij : {s : Fin n // r < s} × {s : Fin n // r < s} =>
      ((ij.1 : Fin n), (ij.2 : Fin n))) (Matrix.mvPolynomialX _ _ ℂ).det := by
    rw [minor, AlgHom.map_det]
    congr 1
    ext i j : 1
    simp [minorMat, Matrix.mvPolynomialX_apply]
  rw [h]
  intro h0
  apply Matrix.det_mvPolynomialX_ne_zero {s : Fin n // r < s} ℂ
  exact rename_injective _ hinj (by rw [h0, map_zero])

end Minor

/-! ### The lowest weight vector and its module -/

section LowMod

variable (n) in
/-- The lowest weight vector `v₀ = Π_r Δ_r ^ A`. -/
def lowVec (A : ℕ) : Pol n := ∏ r : Fin n, minor r ^ A

/-- The weight `A · (0, 1, …, n - 1)`. -/
def lowWt (A : ℕ) : Fin n → ℤ := fun p => (A : ℤ) * (p : ℕ)

theorem lowVec_ne_zero (A : ℕ) : lowVec n A ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun r _ => pow_ne_zero _ (minor_ne_zero r)

theorem isLowest_lowVec (A : ℕ) : IsLowest (polyFam n) (lowWt A) (lowVec n A) := by
  constructor
  · intro t
    rw [polyFam_apply, lowVec,
      der_prod_eigen (polyDer t t) Finset.univ _ (fun r => (A : ℂ) * (if r < t then 1 else 0))
        (fun r _ => der_pow_eigen _ (polyDer_minor_diag t r) A)]
    congr 1
    simp only [mul_ite, mul_one, mul_zero]
    rw [← Finset.sum_filter, Finset.sum_const, Finset.filter_gt_eq_Iio, Fin.card_Iio,
      nsmul_eq_mul, lowWt]
    push_cast
    ring
  · intro p q hqp
    rw [polyFam_apply, lowVec,
      der_prod_eigen (polyDer p q) Finset.univ _ (fun _ => (0 : ℂ))
        (fun r _ => by rw [der_pow_eigen _ (c := 0) (by rw [polyDer_minor_lower hqp, zero_smul]) A,
          mul_zero])]
    simp

variable (n) in
/-- The submodule of `P` generated by `v₀`. -/
def lowSub (A : ℕ) : Submodule ℂ (Pol n) := genSub (polyFam n) {lowVec n A}

theorem lowSub_le (A : ℕ) :
    lowSub n A ≤ restrictTotalDegree (Fin n × Fin n) ℂ (lowVec n A).totalDegree := by
  apply genSub_le _ (isStable_restrictTotalDegree _)
  rintro _ rfl
  exact (mem_restrictTotalDegree _ _ _).mpr le_rfl

variable (n) in
/-- The lowest weight module generated by `v₀`. -/
abbrev LowMod (A : ℕ) := lowSub n A

instance (A : ℕ) : FiniteDimensional ℂ (LowMod n A) :=
  Submodule.finiteDimensional_of_le (lowSub_le A)

variable (n) in
/-- The action of `e_pq` on `LowMod n A`. -/
def lowFam (A : ℕ) : Fin n → Fin n → Module.End ℂ (LowMod n A) :=
  resFam (lowSub n A) (isStable_genSub _)

variable (n) in
/-- `v₀` as an element of `LowMod n A`. -/
def lowGen (A : ℕ) : LowMod n A := ⟨lowVec n A, mem_genSub_self _⟩

theorem isGlFamily_lowFam (A : ℕ) : IsGlFamily (lowFam n A) :=
  isGlFamily_resFam isGlFamily_polyFam _ _

theorem intWeights_lowFam (A : ℕ) : IntWeights (lowFam n A) :=
  intWeights_resFam_genSub isGlFamily_polyFam (isLowest_lowVec A)

theorem lowGen_ne_zero (A : ℕ) : lowGen n A ≠ 0 := fun h =>
  lowVec_ne_zero (n := n) A (congrArg Subtype.val h)

theorem isLowest_lowGen (A : ℕ) : IsLowest (lowFam n A) (lowWt A) (lowGen n A) := by
  constructor
  · exact isWeightVec_resFam_iff.mpr (isLowest_lowVec A).1
  · intro p q hqp
    apply Subtype.ext
    exact (isLowest_lowVec A).2 p q hqp

theorem genSub_lowGen (A : ℕ) : genSub (lowFam n A) {lowGen n A} = ⊤ :=
  genSub_resFam_eq_top _

/-- `LowMod n A` is irreducible. -/
theorem eq_top_of_isStable_lowMod (A : ℕ) {Z : Submodule ℂ (LowMod n A)}
    (hZ : IsStable (lowFam n A) Z) (hZ0 : Z ≠ ⊥) : Z = ⊤ :=
  eq_top_of_lowest (isGlFamily_lowFam A) (intWeights_lowFam A) (isLowest_lowGen A)
    (lowGen_ne_zero A) (genSub_lowGen A) hZ hZ0

end LowMod

end GLReynolds

end Langlands.Archimedean
