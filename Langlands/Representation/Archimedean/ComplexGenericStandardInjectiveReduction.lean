import Mathlib.Algebra.Lie.UniversalEnveloping
import Langlands.Representation.Archimedean.ComplexGenericParameterReduction

/-!
# Reduction of the irreducibility of generic standard modules for `GL_n(ℂ)`

`ComplexGenericStandardInjectiveStatement` (S2) says that a surjective intertwining map from the
`U(n)`-finite functions of a Langlands-ordered standard module onto an irreducible admissible
generic `(𝔤𝔩_n(ℂ), U(n))`-module is injective. This file splits S2 into three statements
with separate sources:

* `ComplexGenericLargeStatement` (Kostant 1978, Theorem 3.9 = Theorem D; Matumoto 1987,
  Corollary 5): an irreducible admissible generic module is *large*
  (`IsComplexLargeGKModule`): its annihilator in the enveloping algebra is the minimal
  primitive ideal, generated by central elements;
* `ComplexLargePrincipalSeriesStatement` (Vogan 1978, Theorem 6.2 (a) ⇒ (f)): an irreducible
  admissible large module has the standard-module parameter of some list of `n` complex
  characters;
* `ComplexStandardSurjectionInjectiveStatement` (Knapp 1994, Theorem 4; Želobenko–Naimark):
  if an irreducible admissible module has a standard-module parameter, every surjective
  intertwining map onto it from a Langlands-ordered standard module is injective.

`complexGenericStandardInjectiveReduction` proves that the three imply S2, and
`complexGenericStandardParameter_of_large` that the first two alone imply
`ComplexGenericStandardParameterStatement`.
-/

noncomputable section

open scoped TensorProduct Matrix

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.LocalFactor.Archimedean
open scoped Matrix.Norms.Operator

-- As in `GKModule`: the charts on units need reduction through the normed-ring instances of
-- matrices.
set_option backward.isDefEq.respectTransparency false

universe uV

section Large

variable (n : ℕ) {V : Type uV} [AddCommGroup V] [Module ℂ V]

/-- `π` is *large* (Vogan 1978, Definition 6.1; Kostant 1978, (3.9.7)): every element `u` of
the universal enveloping algebra `U` of `ℂ ⊗[ℝ] 𝔤𝔩_n(ℂ)` that acts by zero on `V` (through the
algebra map `UniversalEnvelopingAlgebra.lift ℂ π` extending `π`) lies in the left ideal of
`U` generated by the central elements of `U` that act by zero. That is, the annihilator of `V`
is `U · (Z ∩ Ann V)`, with `Z` the centre of `U`; when `Z` acts on `V` by an infinitesimal
character `χ`, this is the minimal primitive ideal `U · ker χ`. -/
def IsComplexLargeGKModule (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) →ₗ⁅ℂ⁆ Module.End ℂ V) :
    Prop :=
  ∀ u : UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ),
    UniversalEnvelopingAlgebra.lift ℂ π u = 0 →
      u ∈ Submodule.span (UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ))
        {z | z ∈ Subalgebra.center ℂ
            (UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ)) ∧
          UniversalEnvelopingAlgebra.lift ℂ π z = 0}

end Large

/-- Generic implies large (Kostant 1978, Theorem 3.9 = Theorem D, applied to the nonzero
Whittaker vector `ℓ` in the full dual; Matumoto 1987, Corollary 5): every irreducible
admissible generic `(𝔤𝔩_n(ℂ), U(n))`-module is large. -/
def ComplexGenericLargeStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℂ) V)
    (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) →ₗ⁅ℂ⁆ Module.End ℂ V),
    IsComplexGKModule n ρ π → IsIrreducibleGKModule ρ π → IsAdmissibleGKModule ρ →
      IsComplexGenericGKModule n π → IsComplexLargeGKModule n π

/-- Large modules are principal series (Vogan 1978, Theorem 6.2 (a) ⇒ (f), for the quasisplit
group `GL_n(ℂ)`, whose only cuspidal parabolic subgroup containing the upper triangular
subgroup is that subgroup itself): every irreducible admissible large
`(𝔤𝔩_n(ℂ), U(n))`-module has the standard-module parameter of some list of complex
characters. -/
def ComplexLargePrincipalSeriesStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℂ) V)
    (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) →ₗ⁅ℂ⁆ Module.End ℂ V),
    IsComplexGKModule n ρ π → IsIrreducibleGKModule ρ π → IsAdmissibleGKModule ρ →
      IsComplexLargeGKModule n π →
        ∃ ds : List ComplexCharacterData, HasComplexStandardParameter n ρ π ds

/-- Langlands-ordered standard modules onto principal series (Knapp 1994, Theorem 4 (a), (c),
due to Želobenko and Naimark): if an irreducible admissible `(𝔤𝔩_n(ℂ), U(n))`-module has the
standard-module parameter of some list of complex characters, then for every list `ds` of `n`
complex characters in the Langlands order, every surjective intertwining map from the
`U(n)`-finite functions of the standard module of `ds` onto it is injective. -/
def ComplexStandardSurjectionInjectiveStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℂ) V)
    (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) →ₗ⁅ℂ⁆ Module.End ℂ V)
    (ds : List ComplexCharacterData)
    (A : kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n) →ₗ[ℂ] V),
    IsComplexGKModule n ρ π → IsIrreducibleGKModule ρ π → IsAdmissibleGKModule ρ →
      (∃ ds' : List ComplexCharacterData, HasComplexStandardParameter n ρ π ds') →
        ds.length = n → IsComplexLanglandsOrdered ds →
          Function.Surjective A → IsComplexStandardIntertwining n ρ π ds A →
            Function.Injective A

/-- The three statements above imply `ComplexGenericStandardInjectiveStatement`. -/
def ComplexGenericStandardInjectiveReductionStatement : Prop :=
  ComplexGenericLargeStatement.{uV} → ComplexLargePrincipalSeriesStatement.{uV} →
    ComplexStandardSurjectionInjectiveStatement.{uV} →
      ComplexGenericStandardInjectiveStatement.{uV}

/-- Proof of the reduction: a generic module is large, hence has a standard-module parameter,
hence every surjection onto it from a Langlands-ordered standard module is injective. -/
theorem complexGenericStandardInjectiveReduction :
    ComplexGenericStandardInjectiveReductionStatement.{uV} := by
  intro hK hP hS n V _ _ ρ π ds A hgk hirr hadm hgen hlen hord hsurj hA
  exact hS n V ρ π ds A hgk hirr hadm (hP n V ρ π hgk hirr hadm (hK n V ρ π hgk hirr hadm hgen))
    hlen hord hsurj hA

/-- The first two statements alone already give `ComplexGenericStandardParameterStatement`,
without the Langlands classification: a generic module is large, hence has a standard-module
parameter. -/
theorem complexGenericStandardParameter_of_large
    (hK : ComplexGenericLargeStatement.{uV}) (hP : ComplexLargePrincipalSeriesStatement.{uV}) :
    ComplexGenericStandardParameterStatement.{uV} := by
  intro n V _ _ ρ π hgk hirr hadm hgen
  exact hP n V ρ π hgk hirr hadm (hK n V ρ π hgk hirr hadm hgen)

end Langlands.Archimedean
