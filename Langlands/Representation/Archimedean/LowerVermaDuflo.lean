import Langlands.Representation.Archimedean.LowerVermaPBW
import Langlands.Representation.Archimedean.RealWhittakerMaximallyFaithfulProof
import Langlands.Representation.Archimedean.Kostant.Transport

/-!
# Duflo's theorem for lower Verma modules of `𝔤𝔩_n(ℂ)`

`lowerVermaDuflo : VermaGL.LowerVermaDufloStatement`: the annihilator of `M⁻(λ)` in
`U(𝔤𝔩_n(ℂ))` is generated by central elements. The module `M⁻(λ)` has an infinitesimal
character and a nonzero Whittaker functional, so Kostant's theorem applies. See the paired
Markdown.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean.VermaPBW

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Algebra.UniversalEnveloping

variable (n : ℕ) (lam : Fin n → ℂ)

/-- The center of `U(𝔤𝔩_n(ℂ))` acts on `M⁻(λ)` by scalars. -/
theorem hasInfinitesimalCharacter_action :
    HasInfinitesimalCharacter (VermaGL.action n lam) := by
  intro z hz
  have hcomm : ∀ u : VermaGL.glU n, u * z = z * u := fun u =>
    Subalgebra.mem_center_iff.mp hz u
  have hw : ∀ p, VermaGL.unitU n p p • (z • VermaGL.gen n lam) =
      lam p • (z • VermaGL.gen n lam) := by
    intro p
    rw [smul_smul, hcomm, mul_smul, unitU_smul_gen, smul_comm]
  obtain ⟨c, hc⟩ := (lowerVermaWeight n lam).2 _ hw
  refine ⟨c, LinearMap.ext fun m => ?_⟩
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [BGChase.envelopingAction_action, Module.algebraMap_end_apply, mk_eq_smul_gen, smul_smul, ← hcomm,
    mul_smul, hc, smul_comm]

/-- The superdiagonal coefficients used for the Whittaker functional. -/
def oneCoeff : Fin n → ℂ := fun _ => 1

/-- `Ψ_{λ,1}` descends to `M⁻(λ)`. -/
def whitFun : VermaGL.LowerVerma n lam →ₗ[ℂ] ℂ :=
  ((VermaGL.lowerVermaIdeal n lam).restrictScalars ℂ).liftQ (Psi n (vVal n lam (oneCoeff n)))
      (fun x hx => by
        have h := Psi_mul_mem_lowerVermaIdeal n lam (oneCoeff n) hx 1
        rwa [one_mul] at h) ∘ₗ
    (Submodule.Quotient.restrictScalarsEquiv ℂ (VermaGL.lowerVermaIdeal n lam)).symm.toLinearMap

theorem whitFun_mk (u : VermaGL.glU n) :
    whitFun n lam (Submodule.Quotient.mk u) = Psi n (vVal n lam (oneCoeff n)) u := by
  simp only [whitFun, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    Submodule.Quotient.restrictScalarsEquiv_symm_mk]
  rfl

theorem whitFun_gen : whitFun n lam (VermaGL.gen n lam) = 1 := by
  rw [VermaGL.gen, whitFun_mk, Psi_one]

/-- The Whittaker property: `ℓ(X m) = η(X) ℓ(m)` for strictly upper triangular `X`. -/
theorem whitFun_action (X : Matrix (Fin n) (Fin n) ℂ) (hX : ∀ p q : Fin n, (q : ℕ) ≤ p → X p q = 0)
    (m : VermaGL.LowerVerma n lam) :
    whitFun n lam (VermaGL.action n lam X m) =
      (∑ p : Fin n, ∑ q : Fin n, if (q : ℕ) = p + 1 then oneCoeff n p * X p q else 0) *
        whitFun n lam m := by
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  have hmem : X ∈ nUp n := by
    intro i j h
    exact hX i j (by rw [not_lt] at h; exact Fin.le_def.mp h)
  have h := Psi_ι_mul n (vVal n lam (oneCoeff n)) (muUp n (oneCoeff n)) (muLo n lam)
    (muUp_subBasis n (oneCoeff n) lam) (muLo_subBasis n (oneCoeff n) lam) u ⟨X, hmem⟩
  change whitFun n lam (UniversalEnvelopingAlgebra.ι ℂ X • Submodule.Quotient.mk u) = _
  rw [← Submodule.Quotient.mk_smul, smul_eq_mul, whitFun_mk, whitFun_mk, h]
  congr 1
  change ∑ p, ∑ q, supCoeff n (oneCoeff n) p q * X p q = _
  refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
  rw [supCoeff]
  split_ifs <;> simp

/-- `𝔤𝔩_n(ℂ)` as the one-block product of the Library's Kostant theorem. -/
def toUnitProd : Matrix (Fin n) (Fin n) ℂ ≃ₗ⁅ℂ⁆ (∀ _ : Unit, Matrix (Fin n) (Fin n) ℂ) where
  toFun X := fun _ => X
  invFun f := f ()
  map_add' X Y := rfl
  map_smul' c X := rfl
  map_lie' {X Y} := by
    funext u
    rfl
  left_inv X := rfl
  right_inv f := by
    funext u
    cases u
    rfl

/-- **Duflo's theorem for lower Verma modules.** -/
theorem lowerVermaDuflo : VermaGL.LowerVermaDufloStatement := by
  intro n lam
  apply Kostant.isMaximallyFaithful_of_comp (toUnitProd n)
  refine Kostant.glProductWhittakerMaximallyFaithful.{0} Unit (fun _ => n)
    (VermaGL.LowerVerma n lam) _
    (Kostant.hasInfinitesimalCharacter_comp (toUnitProd n) (hasInfinitesimalCharacter_action n lam))
    (whitFun n lam) ?_ (fun _ _ => 1) (fun _ _ _ => one_ne_zero) ?_
  · intro h
    have := LinearMap.congr_fun h (VermaGL.gen n lam)
    rw [whitFun_gen, LinearMap.zero_apply] at this
    exact one_ne_zero this
  · intro X hX v
    change whitFun n lam (VermaGL.action n lam (X ()) v) = _
    rw [whitFun_action n lam (X ()) (hX ()) v]
    simp [oneCoeff]

end Langlands.Archimedean.VermaPBW
