import Langlands.Representation.Archimedean.RealInducedTorusCore
import Langlands.Representation.Archimedean.RealBlockFourierPropagation

/-!
# Reduction of torus averages to the block coordinates

Let `p_1, …, p_r` be pairwise disjoint blocks of `GL_N(ℝ)` and let `T` be the torus generated by
the block rotations `r_{p_i}(θ)`. This module provides the algebra that reduces a torus average
`∫_T F(τ y) dτ` at an arbitrary point `y` to block coordinates:

* every `y` factors as `y = c · b_1 ⋯ b_r · k` with `k ∈ O(N)`, `b_i = b(x_i, y_i, w_i)` upper
  triangular on the block `p_i`, and `c` upper triangular with positive diagonal which is the
  identity on every block (`exists_decomp`);
* conjugation by an element of `T` preserves such `c` together with their diagonal
  (`isAdapted_conj_of_mem_torus`), so for `φ` with `IsExpEquivariant α φ` and `τ ∈ T`,
  `φ(τ c g) = χ_α(c) φ(τ g)` with `χ_α(c) = exp(Σ_i α_i log c_ii)` (`apply_mul_mul_of_mem_torus`);
* torus averages only depend on the values on the orbit `T · g` (`coeffs_congr_torus`).
-/

noncomputable section

open scoped Manifold ContDiff Matrix.Norms.Operator

set_option autoImplicit false

namespace Langlands.Archimedean

open Langlands.GeneralLinear Langlands.LocalFactor.Archimedean

set_option backward.isDefEq.respectTransparency false

namespace RealInducedTorusReduction

open RealBlockRotation RealBlockFourierFinite RealInducedBlockSlice RealInducedBlockBound
  RealInducedTorusCore RealBlockJacquet

variable {N : ℕ}

/-! ## The torus of block rotations -/

/-- The rotations along the blocks of the list. -/
def rotations (L : List (Slot N)) : Set (Langlands.GeneralLinear N ℝ) :=
  {x | ∃ s ∈ L, ∃ θ : ℝ, x = blockRotation N s.p θ}

/-- The torus of block rotations, as the submonoid generated by the rotations. -/
def torus (L : List (Slot N)) : Submonoid (Langlands.GeneralLinear N ℝ) :=
  Submonoid.closure (rotations L)

theorem blockRotation_mem_torus {L : List (Slot N)} {s : Slot N} (hs : s ∈ L) (θ : ℝ) :
    blockRotation N s.p θ ∈ torus L :=
  Submonoid.subset_closure ⟨s, hs, θ, rfl⟩

theorem torus_mono {L L' : List (Slot N)} (h : ∀ s ∈ L, s ∈ L') : torus L ≤ torus L' :=
  Submonoid.closure_mono fun _ ⟨s, hs, θ, hx⟩ => ⟨s, h s hs, θ, hx⟩

theorem torus_le_unitaryCompact (L : List (Slot N)) :
    torus L ≤ (unitaryCompact ℝ N).toSubmonoid :=
  Submonoid.closure_le.mpr fun _ ⟨s, _, θ, hx⟩ => hx ▸ blockRotation_mem_unitaryCompact N s.p θ

/-- Iterated coefficients only depend on the values on the torus orbit. -/
theorem coeffs_congr_torus : ∀ (L : List (Slot N)) {F F' : Langlands.GeneralLinear N ℝ → ℂ}
    (g : Langlands.GeneralLinear N ℝ), (∀ x ∈ torus L, F (x * g) = F' (x * g)) →
      coeffs L F g = coeffs L F' g
  | [], F, F', g, h => by
    simpa [coeffs] using h 1 (one_mem _)
  | s :: L, F, F', g, h => by
    simp only [coeffs]
    unfold blockFourierCoefficient
    refine intervalIntegral.integral_congr fun θ _ => ?_
    refine congrArg (· * _) (coeffs_congr_torus L _ fun x hx => ?_)
    rw [← mul_assoc]
    exact h _ (mul_mem (torus_mono (fun t ht => List.mem_cons_of_mem _ ht) hx)
      (blockRotation_mem_torus List.mem_cons_self θ))

theorem coeffs_const_mul (a : ℂ) : ∀ (L : List (Slot N)) (F : Langlands.GeneralLinear N ℝ → ℂ)
    (g : Langlands.GeneralLinear N ℝ), coeffs L (fun x => a * F x) g = a * coeffs L F g
  | [], _, _ => rfl
  | s :: L, F, g => by
    simp only [coeffs]
    have e : coeffs L (fun x => a * F x) = fun y => a * coeffs L F y :=
      funext fun y => coeffs_const_mul a L F y
    rw [e]
    unfold blockFourierCoefficient
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr fun θ _ => ?_
    exact mul_assoc _ _ _

/-- Iterated coefficients only depend on the blocks and modes of the slots. -/
theorem coeffs_congr_map : ∀ (L L' : List (Slot N)),
    L.map (fun s => (s.p, s.j)) = L'.map (fun s => (s.p, s.j)) →
      ∀ F : Langlands.GeneralLinear N ℝ → ℂ, coeffs L F = coeffs L' F
  | [], [], _, _ => rfl
  | [], _ :: _, h, _ => by simp at h
  | _ :: _, [], h, _ => by simp at h
  | s :: L, t :: L', h, F => by
    simp only [List.map_cons, List.cons.injEq, Prod.mk.injEq] at h
    simp only [coeffs]
    rw [h.1.1, h.1.2, coeffs_congr_map L L' h.2 F]

/-! ## Upper triangular matrices adapted to the blocks -/

/-- `c` is upper triangular with positive diagonal and is the identity on every block. -/
def IsAdapted (L : List (Slot N)) (c : Langlands.GeneralLinear N ℝ) : Prop :=
  (c : Matrix (Fin N) (Fin N) ℝ).IsUpperTriangular ∧
    (∀ i, 0 < (c : Matrix (Fin N) (Fin N) ℝ) i i) ∧
    ∀ s ∈ L, (c : Matrix (Fin N) (Fin N) ℝ) (ia s.hp) (ia s.hp) = 1 ∧
      (c : Matrix (Fin N) (Fin N) ℝ) (ib s.hp) (ib s.hp) = 1 ∧
      (c : Matrix (Fin N) (Fin N) ℝ) (ia s.hp) (ib s.hp) = 0

theorem ne_of_disjoint {s t : Slot N} (hd : s.p + 1 < t.p ∨ t.p + 1 < s.p) :
    ia t.hp ≠ ia s.hp ∧ ia t.hp ≠ ib s.hp ∧ ib t.hp ≠ ia s.hp ∧ ib t.hp ≠ ib s.hp := by
  simp only [ne_eq, Fin.ext_iff, ia, ib]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> omega

theorem ia_lt_ib {p : ℕ} (h : p + 1 < N) : ia h < ib h := by
  simp only [Fin.lt_def, ia, ib]
  omega

theorem val_conj (p : ℕ) (θ : ℝ) (c : Langlands.GeneralLinear N ℝ) :
    ((blockRotation N p θ * c * (blockRotation N p θ)⁻¹ : Langlands.GeneralLinear N ℝ) :
      Matrix (Fin N) (Fin N) ℝ) =
      RealBlockDerivative.conj N p θ (c : Matrix (Fin N) (Fin N) ℝ) := by
  rw [← blockRotation_neg, Units.val_mul, Units.val_mul]
  rfl

/-- The entry `(p, p + 1)` of a conjugate of a matrix which is the identity on the block. -/
theorem conj_ia_ib {p : ℕ} (h : p + 1 < N) (θ : ℝ) {A : Matrix (Fin N) (Fin N) ℝ}
    (hU : A.IsUpperTriangular) (hpp : A (ia h) (ia h) = 1) (hqq : A (ib h) (ib h) = 1)
    (hpq : A (ia h) (ib h) = 0) : RealBlockDerivative.conj N p θ A (ia h) (ib h) = 0 := by
  have hqp : A (ib h) (ia h) = 0 := hU (ia_lt_ib h)
  rw [RealBlockDerivative.conj_apply h, RealBlockDerivative.blockRotation_mul_apply h,
    RealBlockDerivative.blockRotation_mul_apply h]
  have e1 : ((ib h : Fin N) : ℕ) = p + 1 := rfl
  have e2 : ((ia h : Fin N) : ℕ) = p := rfl
  rw [e1, e2, ite_eq_right (by omega : ¬ p + 1 = p), ite_eq_left rfl, ite_eq_left rfl,
    hpp, hqq, hpq, hqp]
  simp only [↓reduceIte]
  ring

/-- Entries away from the block are unchanged by conjugation. -/
theorem conj_apply_of_ne {p : ℕ} (h : p + 1 < N) (θ : ℝ) (A : Matrix (Fin N) (Fin N) ℝ)
    {i k : Fin N} (hi : (i : ℕ) ≠ p ∧ (i : ℕ) ≠ p + 1) (hk : (k : ℕ) ≠ p ∧ (k : ℕ) ≠ p + 1) :
    RealBlockDerivative.conj N p θ A i k = A i k := by
  rw [RealBlockDerivative.conj_apply h, ite_eq_right hk.1, ite_eq_right hk.2,
    RealBlockDerivative.blockRotation_mul_apply h, ite_eq_right hi.1, ite_eq_right hi.2]

/-- Conjugation by a block rotation of the list preserves adapted matrices and their diagonal. -/
theorem isAdapted_conj {L : List (Slot N)} (hpw : L.Pairwise Slot.Disjoint) {s : Slot N}
    (hs : s ∈ L) (θ : ℝ) {c : Langlands.GeneralLinear N ℝ} (hc : IsAdapted L c) :
    IsAdapted L (blockRotation N s.p θ * c * (blockRotation N s.p θ)⁻¹) ∧
      ∀ i, ((blockRotation N s.p θ * c * (blockRotation N s.p θ)⁻¹ :
        Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) i i =
          (c : Matrix (Fin N) (Fin N) ℝ) i i := by
  obtain ⟨hU, hpos, hblk⟩ := hc
  obtain ⟨hpp, hqq, hpq⟩ := hblk s hs
  unfold IsAdapted
  rw [val_conj]
  have hdiag : ∀ i, RealBlockDerivative.conj N s.p θ (c : Matrix (Fin N) (Fin N) ℝ) i i =
      (c : Matrix (Fin N) (Fin N) ℝ) i i := by
    intro i
    rw [RealBlockDerivative.conj_diag s.hp θ hU, hpp, hqq, hpq]
    split_ifs with h1 h2
    · rw [show i = ia s.hp from Fin.ext h1, hpp]
      linear_combination Real.sin_sq_add_cos_sq θ
    · rw [show i = ib s.hp from Fin.ext h2, hqq]
      linear_combination Real.sin_sq_add_cos_sq θ
    · rfl
  refine ⟨⟨fun i k hik => ?_, fun i => by rw [hdiag]; exact hpos i, fun t ht => ?_⟩, hdiag⟩
  · have hik' : k < i := hik
    rw [RealBlockDerivative.conj_lower s.hp θ hU hik', RealBlockDerivative.kappa, hpp, hqq, hpq]
    simp
  · obtain ⟨tpp, tqq, tpq⟩ := hblk t ht
    refine ⟨by rw [hdiag, tpp], by rw [hdiag, tqq], ?_⟩
    by_cases hst : t.p = s.p
    · have ea : ia t.hp = ia s.hp := Fin.ext hst
      have eb : ib t.hp = ib s.hp := Fin.ext (by simp only [ib]; omega)
      rw [ea, eb]
      exact conj_ia_ib s.hp θ hU hpp hqq hpq
    · have hd : s.p + 1 < t.p ∨ t.p + 1 < s.p := by
        have : Std.Symm (Slot.Disjoint (N := N)) :=
          ⟨fun a b hab => by unfold Slot.Disjoint at hab ⊢; omega⟩
        exact hpw.forall hs ht (fun e => hst (congrArg Slot.p e).symm)
      rw [conj_apply_of_ne s.hp θ _ (by simp only [ia]; omega) (by simp only [ib]; omega), tpq]

/-- Conjugation by an element of the torus preserves adapted matrices and their diagonal. -/
theorem isAdapted_conj_of_mem_torus {L : List (Slot N)} (hpw : L.Pairwise Slot.Disjoint)
    {x : Langlands.GeneralLinear N ℝ} (hx : x ∈ torus L) :
    ∀ c : Langlands.GeneralLinear N ℝ, IsAdapted L c → IsAdapted L (x * c * x⁻¹) ∧
      ∀ i, ((x * c * x⁻¹ : Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) i i =
        (c : Matrix (Fin N) (Fin N) ℝ) i i := by
  induction hx using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨s, hs, θ, rfl⟩ := hx
    exact fun c hc => isAdapted_conj hpw hs θ hc
  | one => exact fun c hc => by simpa using hc
  | mul x y _ _ hx hy =>
    intro c hc
    obtain ⟨hc1, hd1⟩ := hy c hc
    obtain ⟨hc2, hd2⟩ := hx _ hc1
    have e : x * y * c * (x * y)⁻¹ = x * (y * c * y⁻¹) * x⁻¹ := by group
    rw [e]
    exact ⟨hc2, fun i => (hd2 i).trans (hd1 i)⟩

/-! ## The character of an upper triangular matrix -/

/-- `χ_α(c) = exp(Σ_i α_i log c_ii)`. -/
def chi (α : Fin N → ℂ) (c : Langlands.GeneralLinear N ℝ) : ℂ :=
  Complex.exp (∑ i, α i * (Real.log ((c : Matrix (Fin N) (Fin N) ℝ) i i) : ℂ))

theorem norm_chi (α : Fin N → ℂ) (c : Langlands.GeneralLinear N ℝ) :
    ‖chi α c‖ = Real.exp (∑ i, (α i).re * Real.log ((c : Matrix (Fin N) (Fin N) ℝ) i i)) := by
  rw [chi, Complex.norm_exp, Complex.re_sum]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]

/-- Equivariant functions transform by `χ_α` under upper triangular matrices with positive
diagonal. -/
theorem apply_mul_of_upper {α : Fin N → ℂ} {φ : Langlands.GeneralLinear N ℝ → ℂ}
    (hφ : RealBlockDerivative.IsExpEquivariant α φ) {c : Langlands.GeneralLinear N ℝ}
    (hU : (c : Matrix (Fin N) (Fin N) ℝ).IsUpperTriangular)
    (hpos : ∀ i, 0 < (c : Matrix (Fin N) (Fin N) ℝ) i i) (g : Langlands.GeneralLinear N ℝ) :
    φ (c * g) = chi α c * φ g := by
  obtain ⟨x, hx⟩ : ∃ x : Fin N → ℝ, ∀ i, x i = Real.log ((c : Matrix (Fin N) (Fin N) ℝ) i i) :=
    ⟨_, fun _ => rfl⟩
  set d : Fin N → ℝˣ := fun i => Units.mk0 ((c : Matrix (Fin N) (Fin N) ℝ) i i) (hpos i).ne'
    with hd
  have hE : matrixExpUnit N (Matrix.diagonal x) =
      (Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ) := by
    rw [RealPrincipalSeriesDuality.matrixExpUnit_diagonal]
    congr 1
    funext i
    ext
    simp only [hd, Units.val_mk0, hx, Real.exp_log (hpos i)]
  have hEinv : (((Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ)⁻¹ :
      Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) =
        Matrix.diagonal fun i => ((c : Matrix (Fin N) (Fin N) ℝ) i i)⁻¹ := by
    rw [← map_inv, Iwasawa.diagonalUnits_val]
    congr 1
  have hn : (Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ)⁻¹ * c ∈
      upperUnipotent N ℝ := by
    refine ⟨fun i j hij => ?_, fun i => ?_⟩
    · show (((Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ)⁻¹ * c :
        Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) i j = 0
      rw [Units.val_mul, hEinv, Matrix.diagonal_mul, hU hij, mul_zero]
    · show (((Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ)⁻¹ * c :
        Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) i i = 1
      rw [Units.val_mul, hEinv, Matrix.diagonal_mul, inv_mul_cancel₀ (hpos i).ne']
  have key := hφ x ⟨_, hn⟩ g
  rw [hE] at key
  have e : (Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ) *
      ((⟨_, hn⟩ : upperUnipotent N ℝ) : Langlands.GeneralLinear N ℝ) * g = c * g := by
    show (Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ) *
      ((Iwasawa.diagonalUnits d : Langlands.GeneralLinear N ℝ)⁻¹ * c) * g = c * g
    rw [mul_inv_cancel_left]
  rw [e] at key
  rw [key, chi]
  simp_rw [hx]

/-- **Reduction.** For `τ` in the torus and `c` adapted, `φ(τ c g) = χ_α(c) φ(τ g)`. -/
theorem apply_mul_mul_of_mem_torus {L : List (Slot N)} (hpw : L.Pairwise Slot.Disjoint)
    {α : Fin N → ℂ} {φ : Langlands.GeneralLinear N ℝ → ℂ}
    (hφ : RealBlockDerivative.IsExpEquivariant α φ) {c : Langlands.GeneralLinear N ℝ}
    (hc : IsAdapted L c) {x : Langlands.GeneralLinear N ℝ} (hx : x ∈ torus L)
    (g : Langlands.GeneralLinear N ℝ) : φ (x * (c * g)) = chi α c * φ (x * g) := by
  obtain ⟨hc', hdiag⟩ := isAdapted_conj_of_mem_torus hpw hx c hc
  have e : x * (c * g) = x * c * x⁻¹ * (x * g) := by group
  rw [e, apply_mul_of_upper hφ hc'.1 hc'.2.1]
  congr 1
  unfold chi
  simp_rw [hdiag]

/-- The torus average of `x ↦ φ(x c g) H(x)` is `χ_α(c)` times that of `x ↦ φ(x g) H(x)`. -/
theorem coeffs_mul_adapted {L : List (Slot N)} (hpw : L.Pairwise Slot.Disjoint)
    {α : Fin N → ℂ} {φ : Langlands.GeneralLinear N ℝ → ℂ}
    (hφ : RealBlockDerivative.IsExpEquivariant α φ) {c : Langlands.GeneralLinear N ℝ}
    (hc : IsAdapted L c) (g : Langlands.GeneralLinear N ℝ)
    (H : Langlands.GeneralLinear N ℝ → ℂ) :
    coeffs L (fun x => φ (x * (c * g)) * H x) 1 =
      chi α c * coeffs L (fun x => φ (x * g) * H x) 1 := by
  rw [← coeffs_const_mul]
  refine coeffs_congr_torus L 1 fun x hx => ?_
  simp only [mul_one]
  rw [apply_mul_mul_of_mem_torus hpw hφ hc hx, mul_assoc]

/-- The same with the equivariant function in the second factor. -/
theorem coeffs_mul_adapted' {L : List (Slot N)} (hpw : L.Pairwise Slot.Disjoint)
    {α : Fin N → ℂ} {φ : Langlands.GeneralLinear N ℝ → ℂ}
    (hφ : RealBlockDerivative.IsExpEquivariant α φ) {c : Langlands.GeneralLinear N ℝ}
    (hc : IsAdapted L c) (g : Langlands.GeneralLinear N ℝ)
    (H : Langlands.GeneralLinear N ℝ → ℂ) :
    coeffs L (fun x => H x * φ (x * (c * g))) 1 =
      chi α c * coeffs L (fun x => H x * φ (x * g)) 1 := by
  rw [← coeffs_const_mul]
  refine coeffs_congr_torus L 1 fun x hx => ?_
  simp only [mul_one]
  rw [apply_mul_mul_of_mem_torus hpw hφ hc hx]
  ring

/-! ## Factorization along the blocks -/

theorem diagEntry_ia {p : ℕ} (h : p + 1 < N) (x y : ℝ) : diagEntry h x y (ia h) = Real.exp x := by
  rw [diagEntry, RealInducedBlockInvariance.diagVec_ia]

theorem diagEntry_ib {p : ℕ} (h : p + 1 < N) (x y : ℝ) : diagEntry h x y (ib h) = Real.exp y := by
  rw [diagEntry, RealInducedBlockInvariance.diagVec_ib]

theorem diagEntry_of_ne {p : ℕ} (h : p + 1 < N) (x y : ℝ) {k : Fin N} (ha : k ≠ ia h)
    (hb : k ≠ ib h) : diagEntry h x y k = 1 := by
  rw [diagEntry, diagVec, ite_eq_right ha, ite_eq_right hb, Real.exp_zero]

theorem mul_blockB_apply {p : ℕ} (h : p + 1 < N) (x y w : ℝ) (A : Matrix (Fin N) (Fin N) ℝ)
    (i k : Fin N) :
    (A * (blockB h x y w : Matrix (Fin N) (Fin N) ℝ)) i k =
      A i k * diagEntry h x y k + if k = ib h then A i (ia h) * w else 0 := by
  rw [Matrix.mul_apply]
  simp_rw [blockB_apply, mul_add, Finset.sum_add_distrib, mul_ite, mul_zero]
  congr 1
  · rw [Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ _)]
  · by_cases hk : k = ib h
    · simp only [hk, and_true, ite_true]
      rw [Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ _)]
    · simp [hk]

theorem blockB_inv {p : ℕ} (h : p + 1 < N) (x y w : ℝ) :
    (blockB h x y w)⁻¹ = blockB h (-x) (-y) (-(w * Real.exp (-x - y))) := by
  refine inv_eq_of_mul_eq_one_right (Units.ext ?_)
  rw [Units.val_mul, blockB_eq_blockMat, blockB_eq_blockMat, blockMat_mul, Units.val_one,
    blockMat_eq_one_add]
  have h1 : Real.exp x * Real.exp (-x) + w * 0 - 1 = 0 := by
    rw [← Real.exp_add]; simp
  have h2 : Real.exp x * -(w * Real.exp (-x - y)) + w * Real.exp (-y) = 0 := by
    rw [show -x - y = -x + -y by ring, Real.exp_add]
    have := Real.exp_add x (-x)
    rw [add_neg_cancel, Real.exp_zero] at this
    linear_combination (w * Real.exp (-y)) * this
  have h3 : 0 * Real.exp (-x) + Real.exp y * 0 = 0 := by ring
  have h4 : 0 * -(w * Real.exp (-x - y)) + Real.exp y * Real.exp (-y) - 1 = 0 := by
    rw [← Real.exp_add]; simp
  rw [h1, h2, h3, h4]
  ext i j
  simp [blockDelta]

/-- The slot `s` with the coordinates `x = log c_pp`, `y = log c_qq`, `w = c_pq` read off from
the matrix `c`. -/
def readSlot (c : Matrix (Fin N) (Fin N) ℝ) (s : Slot N) : Slot N :=
  { s with
    x := Real.log (c (ia s.hp) (ia s.hp))
    y := Real.log (c (ib s.hp) (ib s.hp))
    w := c (ia s.hp) (ib s.hp) }

/-- The slots with coordinates read off from `c`. -/
def readSlots (c : Matrix (Fin N) (Fin N) ℝ) (L : List (Slot N)) : List (Slot N) :=
  L.map (readSlot c)

theorem pairwise_readSlots (c : Matrix (Fin N) (Fin N) ℝ) {L : List (Slot N)}
    (hpw : L.Pairwise Slot.Disjoint) : (readSlots c L).Pairwise Slot.Disjoint :=
  List.pairwise_map.mpr (hpw.imp fun h => h)

theorem coeffs_readSlots (c : Matrix (Fin N) (Fin N) ℝ) (L : List (Slot N))
    (F : Langlands.GeneralLinear N ℝ → ℂ) : coeffs (readSlots c L) F = coeffs L F :=
  coeffs_congr_map _ _ (by simp [readSlots, readSlot, Function.comp_def]) F

/-- **Factorization.** An upper triangular matrix with positive diagonal factors as
`c = c'' · b_1 ⋯ b_r` with `c''` adapted to the blocks and `b_i` read off from `c`. -/
theorem exists_factor (c : Langlands.GeneralLinear N ℝ)
    (hU : (c : Matrix (Fin N) (Fin N) ℝ).IsUpperTriangular)
    (hpos : ∀ i, 0 < (c : Matrix (Fin N) (Fin N) ℝ) i i) :
    ∀ L : List (Slot N), L.Pairwise Slot.Disjoint →
      ∃ c'' : Langlands.GeneralLinear N ℝ,
        c = c'' * point (readSlots (c : Matrix (Fin N) (Fin N) ℝ) L) ∧ IsAdapted L c'' ∧
          ∀ i k : Fin N, (∀ s ∈ L, k ≠ ia s.hp ∧ k ≠ ib s.hp) →
            (c'' : Matrix (Fin N) (Fin N) ℝ) i k = (c : Matrix (Fin N) (Fin N) ℝ) i k
  | [], _ => ⟨c, by simp [readSlots, point], ⟨hU, hpos, by simp⟩, fun _ _ _ => rfl⟩
  | s :: rest, hpw => by
    obtain ⟨hsd, hrest⟩ := List.pairwise_cons.mp hpw
    obtain ⟨c1, hc1, ⟨hU1, hpos1, hblk1⟩, hcol1⟩ := exists_factor c hU hpos rest hrest
    set C := (c : Matrix (Fin N) (Fin N) ℝ) with hC
    set A := (c1 : Matrix (Fin N) (Fin N) ℝ) with hA
    -- the columns of the block `s` are unchanged
    have hcolS : ∀ i, A i (ia s.hp) = C i (ia s.hp) ∧ A i (ib s.hp) = C i (ib s.hp) := by
      intro i
      refine ⟨hcol1 i _ fun t ht => ?_, hcol1 i _ fun t ht => ?_⟩
      · have := ne_of_disjoint (hsd t ht)
        exact ⟨fun e => this.1 e.symm, fun e => this.2.2.1 e.symm⟩
      · have := ne_of_disjoint (hsd t ht)
        exact ⟨fun e => this.2.1 e.symm, fun e => this.2.2.2 e.symm⟩
    set x := Real.log (C (ia s.hp) (ia s.hp))
    set y := Real.log (C (ib s.hp) (ib s.hp))
    set w := C (ia s.hp) (ib s.hp)
    have hpp : 0 < C (ia s.hp) (ia s.hp) := hpos _
    have hqq : 0 < C (ib s.hp) (ib s.hp) := hpos _
    have hex : Real.exp (-x) = (C (ia s.hp) (ia s.hp))⁻¹ := by
      rw [Real.exp_neg, Real.exp_log hpp]
    have hey : Real.exp (-y) = (C (ib s.hp) (ib s.hp))⁻¹ := by
      rw [Real.exp_neg, Real.exp_log hqq]
    refine ⟨c1 * (blockB s.hp x y w)⁻¹, ?_, ?_, ?_⟩
    · rw [hc1]
      show c1 * point (readSlots C rest) = c1 * (blockB s.hp x y w)⁻¹ *
        (blockB s.hp x y w * point (readSlots C rest))
      rw [mul_assoc, inv_mul_cancel_left]
    all_goals
      have hentry : ∀ i k, ((c1 * (blockB s.hp x y w)⁻¹ : Langlands.GeneralLinear N ℝ) :
          Matrix (Fin N) (Fin N) ℝ) i k =
            A i k * diagEntry s.hp (-x) (-y) k +
              if k = ib s.hp then A i (ia s.hp) * -(w * Real.exp (-x - y)) else 0 := by
        intro i k
        rw [blockB_inv, Units.val_mul, mul_blockB_apply]
      have hcol : ∀ i k, k ≠ ia s.hp → k ≠ ib s.hp →
          ((c1 * (blockB s.hp x y w)⁻¹ : Langlands.GeneralLinear N ℝ) :
            Matrix (Fin N) (Fin N) ℝ) i k = A i k := by
        intro i k ha hb
        rw [hentry, diagEntry_of_ne s.hp _ _ ha hb, ite_eq_right hb, mul_one, add_zero]
      have hqp : A (ib s.hp) (ia s.hp) = 0 := hU1 (ia_lt_ib s.hp)
    · -- adaptedness
      have hpa : ((c1 * (blockB s.hp x y w)⁻¹ : Langlands.GeneralLinear N ℝ) :
          Matrix (Fin N) (Fin N) ℝ) (ia s.hp) (ia s.hp) = 1 := by
        rw [hentry, diagEntry_ia, ite_eq_right (ia_ne_ib s.hp), add_zero, hex,
          (hcolS _).1, mul_inv_cancel₀ hpp.ne']
      have hqb : ((c1 * (blockB s.hp x y w)⁻¹ : Langlands.GeneralLinear N ℝ) :
          Matrix (Fin N) (Fin N) ℝ) (ib s.hp) (ib s.hp) = 1 := by
        rw [hentry, diagEntry_ib, ite_eq_left rfl, hqp, zero_mul, add_zero, hey,
          (hcolS _).2, mul_inv_cancel₀ hqq.ne']
      have hpq : ((c1 * (blockB s.hp x y w)⁻¹ : Langlands.GeneralLinear N ℝ) :
          Matrix (Fin N) (Fin N) ℝ) (ia s.hp) (ib s.hp) = 0 := by
        rw [hentry, diagEntry_ib, ite_eq_left rfl, (hcolS _).1, (hcolS _).2,
          show -x - y = -x + -y by ring, Real.exp_add, hex, hey]
        field_simp
        ring
      refine ⟨fun i k hik => ?_, fun i => ?_, fun t ht => ?_⟩
      · rw [hentry]
        have hk : A i k = 0 := hU1 hik
        by_cases hkb : k = ib s.hp
        · subst hkb
          have : A i (ia s.hp) = 0 := hU1 (lt_trans (ia_lt_ib s.hp) hik)
          rw [hk, this]
          simp
        · rw [hk, ite_eq_right hkb]
          simp
      · by_cases hia : i = ia s.hp
        · rw [hia, hpa]; exact one_pos
        · by_cases hib : i = ib s.hp
          · rw [hib, hqb]; exact one_pos
          · rw [hcol i i hia hib]; exact hpos1 i
      · rcases List.mem_cons.mp ht with rfl | ht
        · exact ⟨hpa, hqb, hpq⟩
        · obtain ⟨tpp, tqq, tpq⟩ := hblk1 t ht
          have hne := ne_of_disjoint (hsd t ht)
          exact ⟨by rw [hcol _ _ hne.1 hne.2.1, tpp], by rw [hcol _ _ hne.2.2.1 hne.2.2.2, tqq],
            by rw [hcol _ _ hne.2.2.1 hne.2.2.2, tpq]⟩
    · intro i k hk
      obtain ⟨ha, hb⟩ := hk s List.mem_cons_self
      rw [hcol i k ha hb]
      exact hcol1 i k fun t ht => hk t (List.mem_cons_of_mem _ ht)

/-- **Decomposition.** Every `y ∈ GL_N(ℝ)` is `c · b_1 ⋯ b_r · k` with `c` adapted to the blocks,
`b_i` read off from an upper triangular matrix, and `k ∈ O(N)`. -/
theorem exists_decomp {L : List (Slot N)} (hpw : L.Pairwise Slot.Disjoint)
    (y : Langlands.GeneralLinear N ℝ) :
    ∃ (C : Matrix (Fin N) (Fin N) ℝ) (c k : Langlands.GeneralLinear N ℝ),
      k ∈ unitaryCompact ℝ N ∧ IsAdapted L c ∧ y = c * (point (readSlots C L) * k) := by
  obtain ⟨l, n, k, hk, rfl⟩ :=
    RealBlockPropagation.exists_expDiagonal_mul_upperUnipotent_mul_unitaryCompact y
  set b : Langlands.GeneralLinear N ℝ := matrixExpUnit N (Matrix.diagonal l) * n with hb
  have hbval : (b : Matrix (Fin N) (Fin N) ℝ) =
      Matrix.diagonal (fun i => Real.exp (l i)) *
        ((n : Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) := by
    rw [hb, Units.val_mul, RealPrincipalSeriesDuality.matrixExpUnit_diagonal,
      Iwasawa.diagonalUnits_val]
    rfl
  have hU : (b : Matrix (Fin N) (Fin N) ℝ).IsUpperTriangular := by
    intro i j hij
    rw [hbval, Matrix.diagonal_mul, n.2.1 hij, mul_zero]
  have hpos : ∀ i, 0 < (b : Matrix (Fin N) (Fin N) ℝ) i i := by
    intro i
    rw [hbval, Matrix.diagonal_mul]
    have : ((n : Langlands.GeneralLinear N ℝ) : Matrix (Fin N) (Fin N) ℝ) i i = 1 := n.2.2 i
    rw [this, mul_one]
    exact Real.exp_pos _
  obtain ⟨c, hc, hadapt, -⟩ := exists_factor b hU hpos L hpw
  refine ⟨b, c, k, hk, hadapt, ?_⟩
  rw [← mul_assoc c, ← hc, hb, mul_assoc]

end RealInducedTorusReduction

end Langlands.Archimedean
