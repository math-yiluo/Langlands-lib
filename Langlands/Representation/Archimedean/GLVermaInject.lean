import Langlands.Representation.Archimedean.GLVermaTheta
import Langlands.Representation.Archimedean.GLLowestModule

/-!
# Independence of the lowest weight vectors `R(c)(ξ ⊗ v₀)`

Let `λ = A·(0, 1, …, n-1)`, `L = LowMod n A` the finite-dimensional module generated by the
lowest weight vector `v₀ = lowGen n A` of weight `λ`, and `M⁻(λ)` the lower Verma module.

* `piM n A : M⁻(λ) → L` is the equivariant map `gen ↦ v₀`.
* `vermaKer`: a weight vector `z ∈ M⁻(λ)` with `π z = 0` whose weight `ν` satisfies
  `ht λ - ht ν < A + 1` vanishes. (Its lowering images vanish by induction on the height, so `z`
  is a lowest weight vector; the Casimir operator then forces `ν = λ + wordWt l` with
  `casVal ν = casVal λ`, impossible for a nonempty short upper word `l`, and `ν = λ` is excluded
  by the weight statement for `M⁻(λ)`.)
* `hom_eq_zero`: postcomposition with `π` is injective on vectors of weight `λ` in
  `Hom(W, M⁻(λ))` when `A` is large compared with the weights of `W`.
* `ys_eq_zero`: for `A` large, the vectors `ys k = R(c)(b_k^* ⊗ v₀) ∈ Hom(W, L)` with `μ_k = 0`
  are linearly independent. The proof lifts `Σ c_k ys k` to `Hom(W, M⁻(λ))`, uses `hom_eq_zero`,
  and applies the trace functional `lamFun` of `GLVermaTheta`, which turns `R(c)` into the
  nonzero scalar `R(casVal λ)`.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

namespace GLReynolds

open ComplexJacquetFinite Module Polynomial

/-! ### Estimates on words and weights -/

section Estimates

variable {n : ℕ}

theorem ht_add (a b : Fin n → ℤ) : ht (a + b) = ht a + ht b := by
  simp only [ht, Pi.add_apply, mul_add, Finset.sum_add_distrib]

theorem ht_wordWt (l : List (Fin n × Fin n)) :
    ht (wordWt l) = (l.map fun a => ((a.1 : ℕ) : ℤ) - ((a.2 : ℕ) : ℤ)).sum := by
  have h : ∑ p, wordWt l p * ((p : ℕ) : ℤ) =
      (l.map fun a => ((a.1 : ℕ) : ℤ) - ((a.2 : ℕ) : ℤ)).sum :=
    sum_wordWt_mul (fun p : Fin n => ((p : ℕ) : ℤ)) l
  rw [ht, ← h]
  exact Finset.sum_congr rfl fun p _ => mul_comm _ _

/-- Each letter of an upper word lowers the height by at least `1`. -/
theorem ht_wordWt_add_length_le {l : List (Fin n × Fin n)} (hl : IsUpperWord l) :
    ht (wordWt l) + l.length ≤ 0 := by
  rw [ht_wordWt]
  induction l with
  | nil => simp
  | cons a l ih =>
    rw [List.map_cons, List.sum_cons, List.length_cons]
    have h1 := ih hl.tail
    have h2 : ((a.1 : ℕ) : ℤ) < ((a.2 : ℕ) : ℤ) := by exact_mod_cast hl.head
    push_cast
    omega

theorem abs_wordWt_le {l : List (Fin n × Fin n)} (hl : IsUpperWord l) (p : Fin n) :
    |wordWt l p| ≤ l.length := by
  induction l with
  | nil => simp [wordWt]
  | cons a l ih =>
    have h1 := abs_le.mp (ih hl.tail)
    have hne : a.1 ≠ a.2 := ne_of_lt hl.head
    have key : wordWt (a :: l) p =
        (if p = a.1 then 1 else 0) - (if p = a.2 then 1 else 0) + wordWt l p := by
      simp [wordWt, Pi.single_apply]
    rw [key, List.length_cons, abs_le]
    by_cases h2 : p = a.1
    · have h3 : ¬ p = a.2 := fun h => hne (h2.symm.trans h)
      rw [ite_eq_left h2, ite_eq_right h3]
      push_cast
      omega
    · by_cases h3 : p = a.2
      · rw [ite_eq_right h2, ite_eq_left h3]
        push_cast
        omega
      · rw [ite_eq_right h2, ite_eq_right h3]
        push_cast
        omega

/-- For a nonempty upper word `l` with fewer than `A + 1` letters,
`casVal (λ + wordWt l) < casVal λ`, `λ = A·(0, 1, …, n-1)`. -/
theorem casVal_lowWt_add_lt (A : ℕ) {l : List (Fin n × Fin n)} (hl : IsUpperWord l)
    (hne : l ≠ []) (hlen : (l.length : ℤ) ≤ A) :
    casVal (lowWt (n := n) A + wordWt l) < casVal (lowWt (n := n) A) := by
  have h := casVal_add_sub (lowWt (n := n) A) (wordWt l)
  rw [sum_wordWt_mul] at h
  set z : Fin n → ℤ := fun p => lowWt A p + (lowWt (n := n) A + wordWt l) p + 2 * (p : ℤ) + 1 - n
    with hz
  have hterm : ∀ a ∈ l, z a.1 - z a.2 ≤ -2 := by
    intro a ha
    have hab := hl a ha
    have h3 : (a.1 : ℤ) + 1 ≤ a.2 := by exact_mod_cast hab
    have h4 := abs_le.mp (abs_wordWt_le hl a.1)
    have h5 := abs_le.mp (abs_wordWt_le hl a.2)
    have h6 : (A : ℤ) * ((a.1 : ℤ) + 1) ≤ (A : ℤ) * (a.2 : ℤ) :=
      mul_le_mul_of_nonneg_left h3 (Int.natCast_nonneg A)
    simp only [hz, lowWt, Pi.add_apply]
    nlinarith
  have hsum : ∀ l' : List (Fin n × Fin n), (∀ a ∈ l', z a.1 - z a.2 ≤ -2) →
      (l'.map fun a => z a.1 - z a.2).sum ≤ -2 * l'.length := by
    intro l' hl'
    induction l' with
    | nil => simp
    | cons a l' ih =>
      rw [List.map_cons, List.sum_cons, List.length_cons]
      have := hl' a (by simp)
      have := ih fun b hb => hl' b (List.mem_cons_of_mem a hb)
      push_cast
      linarith
  have h1 := hsum l hterm
  have h2 : 1 ≤ l.length := List.length_pos_iff.mpr hne
  have h2' : (1 : ℤ) ≤ l.length := by exact_mod_cast h2
  linarith

/-- `-ht μ ≤ (n - 1) Σ_p |μ_p|`. -/
theorem neg_ht_le (μ : Fin n → ℤ) : -ht μ ≤ ((n : ℤ) - 1) * ∑ p, |μ p| := by
  rw [ht, Finset.mul_sum, ← Finset.sum_neg_distrib]
  refine Finset.sum_le_sum fun p _ => ?_
  have h1 : ((p : ℕ) : ℤ) ≤ (n : ℤ) - 1 := by
    have := p.isLt
    omega
  have h2 := neg_abs_le (μ p)
  have h3 := abs_nonneg (μ p)
  have h4 : (0 : ℤ) ≤ (p : ℕ) := Int.natCast_nonneg _
  nlinarith [mul_nonneg (sub_nonneg.mpr h1) h3,
    mul_nonneg h4 (by linarith : (0 : ℤ) ≤ μ p + |μ p|)]

/-- For `ht μ < 0` and `(n - 1) Σ_p |μ_p| ≤ A`, `casVal λ < casVal (λ - μ)`,
`λ = A·(0, 1, …, n-1)`. -/
theorem casVal_lowWt_lt_sub (A : ℕ) {μ : Fin n → ℤ} (hμ : ht μ < 0)
    (hA : ((n : ℤ) - 1) * ∑ p, |μ p| ≤ A) :
    casVal (lowWt (n := n) A) < casVal (lowWt (n := n) A - μ) := by
  have h := casVal_add_sub (lowWt (n := n) A) (-μ)
  have hsub : lowWt (n := n) A + -μ = lowWt A - μ := (sub_eq_add_neg _ _).symm
  rw [hsub] at h
  have hexp : ∑ p, (-μ) p * (lowWt A p + (lowWt (n := n) A - μ) p + 2 * (p : ℤ) + 1 - n) =
      (2 * (A : ℤ) + 2) * (-ht μ) + ∑ p, (μ p ^ 2 + ((n : ℤ) - 1) * μ p) := by
    rw [ht, ← Finset.sum_neg_distrib, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp only [Pi.neg_apply, Pi.sub_apply, lowWt]
    ring
  have hlow : -(((n : ℤ) - 1) * ∑ p, |μ p|) ≤ ∑ p, (μ p ^ 2 + ((n : ℤ) - 1) * μ p) := by
    rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_le_sum fun p _ => ?_
    have h1 : (0 : ℤ) ≤ (n : ℤ) - 1 := by
      have := p.isLt
      omega
    have h2 := neg_abs_le (μ p)
    nlinarith [sq_nonneg (μ p), mul_le_mul_of_nonneg_left h2 h1]
  have hht : (1 : ℤ) ≤ -ht μ := by omega
  have hA0 : (0 : ℤ) ≤ A := Int.natCast_nonneg A
  rw [hexp] at h
  nlinarith [mul_le_mul_of_nonneg_left hht (by linarith : (0 : ℤ) ≤ 2 * A + 2)]

end Estimates

/-! ### Intertwining maps and the Casimir operator -/

section Intertwine

variable {Y : Type*} [AddCommGroup Y] [Module ℂ Y] {Z : Type*} [AddCommGroup Z] [Module ℂ Z]
  {n : ℕ} {h : Fin n → Fin n → Module.End ℂ Y} {h' : Fin n → Fin n → Module.End ℂ Z}

theorem map_cas_comm (f : Y →ₗ[ℂ] Z) (hf : ∀ p q y, f (h p q y) = h' p q (f y)) (y : Y) :
    f (cas h y) = cas h' (f y) := by
  simp only [cas, LinearMap.sum_apply, map_sum, Module.End.mul_apply, hf]

theorem map_aeval_cas_comm (f : Y →ₗ[ℂ] Z) (hf : ∀ p q y, f (h p q y) = h' p q (f y))
    (Q : ℂ[X]) (y : Y) : f (aeval (cas h) Q y) = aeval (cas h') Q (f y) := by
  have hpow : ∀ k : ℕ, ∀ y, f ((cas h ^ k) y) = (cas h' ^ k) (f y) := by
    intro k
    induction k with
    | zero => intro y; simp
    | succ k ih =>
      intro y
      rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply, map_cas_comm f hf,
        ih]
  induction Q using Polynomial.induction_on' with
  | add P Q hP hQ => rw [map_add, LinearMap.add_apply, map_add, hP, hQ, map_add,
      LinearMap.add_apply]
  | monomial k c =>
    rw [aeval_monomial, Module.End.mul_apply, Module.algebraMap_end_apply, map_smul, hpow,
      aeval_monomial, Module.End.mul_apply, Module.algebraMap_end_apply]

end Intertwine

/-! ### The map `M⁻(λ) → L` -/

section Verma

variable (n : ℕ) (A : ℕ)

/-- The complex weight `λ = A·(0, 1, …, n-1)`. -/
def lamA : Fin n → ℂ := fun p => ((lowWt A p : ℤ) : ℂ)

/-- The family `E_pq` acting on `M⁻(λ)`. -/
abbrev famM : Fin n → Fin n → Module.End ℂ (VermaGL.LowerVerma n (lamA n A)) :=
  famOf (VermaGL.action n (lamA n A))

theorem famM_apply (p q : Fin n) (m : VermaGL.LowerVerma n (lamA n A)) :
    famM n A p q m = VermaGL.unitU n p q • m := rfl

theorem isLowest_genM : IsLowest (famM n A) (lowWt A) (VermaGL.gen n (lamA n A)) := by
  refine ⟨fun p => ?_, fun p q hqp => ?_⟩
  · rw [famM_apply, BGChase.unitU_smul_gen_diag]
    rfl
  · rw [famM_apply, BGChase.unitU_smul_gen_of_lt _ hqp]

theorem genSub_genM : genSub (famM n A) {VermaGL.gen n (lamA n A)} = ⊤ := by
  set G := genSub (famM n A) {VermaGL.gen n (lamA n A)}
  have key : ∀ u : VermaGL.glU n, ∀ m ∈ G, u • m ∈ G := by
    intro u
    induction u using InfinitesimalCharacter.envInduction with
    | algebraMap c =>
      intro m hm
      rw [algebraMap_smul]
      exact G.smul_mem c hm
    | ι Y =>
      intro m hm
      induction Y using Matrix.induction_on' with
      | h_zero => rw [map_zero, zero_smul]; exact G.zero_mem
      | h_add Y₁ Y₂ h₁ h₂ => rw [map_add, add_smul]; exact G.add_mem h₁ h₂
      | h_std_basis i j x =>
        have hx : Matrix.single i j x = x • Matrix.single i j (1 : ℂ) := by
          rw [Matrix.smul_single, smul_eq_mul, mul_one]
        rw [hx, map_smul, smul_assoc]
        exact G.smul_mem x (isStable_genSub _ i j m hm)
    | mul a b ha hb =>
      intro m hm
      rw [mul_smul]
      exact ha _ (hb m hm)
    | add a b ha hb =>
      intro m hm
      rw [add_smul]
      exact G.add_mem (ha m hm) (hb m hm)
  rw [eq_top_iff]
  intro m _
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [← BGChase.smul_gen]
  exact key u _ (mem_genSub_self _)

theorem mem_upperSpan_genM (m : VermaGL.LowerVerma n (lamA n A)) :
    m ∈ upperSpan (famM n A) (VermaGL.gen n (lamA n A)) :=
  genSub_le_upperSpan (isGlFamily_famOf _) (isLowest_genM n A) (by rw [genSub_genM]; trivial)

/-- The weights of `M⁻(λ)` are `λ + wordWt l`, `l` upper. -/
theorem exists_word_of_weight {ν : Fin n → ℤ} {z : VermaGL.LowerVerma n (lamA n A)}
    (hz : z ≠ 0) (hν : IsWeightVec (famM n A) ν z) :
    ∃ l, IsUpperWord l ∧ ν = lowWt A + wordWt l :=
  weight_mem_of_mem_span (isGlFamily_famOf _)
    (S := {y | ∃ l, IsUpperWord l ∧ y = word (famM n A) l (VermaGL.gen n (lamA n A))})
    (Ω := {ν | ∃ l, IsUpperWord l ∧ ν = lowWt A + wordWt l})
    (fun y ⟨l, hl, hy⟩ => ⟨_, ⟨l, hl, rfl⟩, by
      rw [hy]
      exact isWeightVec_word (isGlFamily_famOf _) (isLowest_genM n A).1 l hl⟩)
    (mem_upperSpan_genM n A z) hz hν

/-- `u ↦ u · v₀` from `U(𝔤𝔩_n)` to `L`. -/
def piU : VermaGL.glU n →ₗ[ℂ] LowMod n A where
  toFun u := envOf (lowFam n A) (isGlFamily_lowFam A) u (lowGen n A)
  map_add' u u' := by rw [map_add, LinearMap.add_apply]
  map_smul' c u := by rw [map_smul, LinearMap.smul_apply, RingHom.id_apply]

theorem piU_apply (u : VermaGL.glU n) :
    piU n A u = envOf (lowFam n A) (isGlFamily_lowFam A) u (lowGen n A) := rfl

theorem piU_mem {x : VermaGL.glU n} (hx : x ∈ VermaGL.lowerVermaIdeal n (lamA n A)) :
    piU n A x = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    rcases hx with ⟨p, q, hqp, rfl⟩ | ⟨p, rfl⟩
    · rw [piU_apply, envOf_unitU]
      exact (isLowest_lowGen A).2 p q hqp
    · rw [piU_apply, map_sub, AlgHom.commutes, LinearMap.sub_apply, envOf_unitU,
        Module.algebraMap_end_apply, (isLowest_lowGen A).1 p]
      exact sub_self _
  | zero => rw [map_zero]
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul r _ _ hx =>
    rw [smul_eq_mul, piU_apply, map_mul, Module.End.mul_apply, ← piU_apply, hx, map_zero]

/-- The equivariant map `π : M⁻(λ) → L`, `gen ↦ v₀`. -/
def piM : VermaGL.LowerVerma n (lamA n A) →ₗ[ℂ] LowMod n A :=
  ((VermaGL.lowerVermaIdeal n (lamA n A)).restrictScalars ℂ).liftQ (piU n A)
      (fun _ hx => LinearMap.mem_ker.mpr (piU_mem n A hx)) ∘ₗ
    (Submodule.Quotient.restrictScalarsEquiv ℂ
      (VermaGL.lowerVermaIdeal n (lamA n A))).symm.toLinearMap

theorem piM_mk (u : VermaGL.glU n) : piM n A (Submodule.Quotient.mk u) = piU n A u := by
  simp only [piM, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    Submodule.Quotient.restrictScalarsEquiv_symm_mk]
  rfl

theorem piM_gen : piM n A (VermaGL.gen n (lamA n A)) = lowGen n A := by
  rw [VermaGL.gen, piM_mk, piU_apply, map_one, Module.End.one_apply]

theorem piM_fam (p q : Fin n) (m : VermaGL.LowerVerma n (lamA n A)) :
    piM n A (famM n A p q m) = lowFam n A p q (piM n A m) := by
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [famM_apply, ← Submodule.Quotient.mk_smul, smul_eq_mul, piM_mk, piM_mk, piU_apply,
    piU_apply, map_mul, Module.End.mul_apply, envOf_unitU]

/-- **The kernel of `π` has only deep weights.** A weight vector `z ∈ M⁻(λ)` of weight `ν` with
`π z = 0` and `ht λ - ht ν < d ≤ A + 1` vanishes. -/
theorem vermaKer : ∀ d : ℕ, d ≤ A + 1 → ∀ (ν : Fin n → ℤ) (z : VermaGL.LowerVerma n (lamA n A)),
    IsWeightVec (famM n A) ν z → piM n A z = 0 → ht (lowWt (n := n) A) - ht ν < d → z = 0 := by
  intro d
  induction d with
  | zero =>
    intro _ ν z hν _ hd
    by_contra hz
    obtain ⟨l, hl, rfl⟩ := exists_word_of_weight n A hz hν
    have h1 := ht_wordWt_add_length_le hl
    rw [ht_add] at hd
    push_cast at hd
    omega
  | succ d ih =>
    intro hdA ν z hν hπ hd
    have hlow : ∀ p q, q < p → famM n A p q z = 0 := by
      intro p q hqp
      refine ih (by omega) _ _ (isWeightVec_shift (isGlFamily_famOf _) hν (ne_of_gt hqp)) ?_ ?_
      · rw [piM_fam, hπ, map_zero]
      · rw [ht_shift]
        have : ((q : ℕ) : ℤ) < ((p : ℕ) : ℤ) := by exact_mod_cast hqp
        push_cast at hd ⊢
        omega
    by_contra hz
    obtain ⟨l, hl, rfl⟩ := exists_word_of_weight n A hz hν
    have hc1 := cas_apply_lowest (isGlFamily_famOf _) hν hlow
    have hc2 := cas_apply_of_mem_genSub (isGlFamily_famOf _) (isLowest_genM n A) (v := z)
      (by rw [genSub_genM]; trivial)
    rw [hc1] at hc2
    have hcas : casVal (lowWt (n := n) A + wordWt l) = casVal (lowWt (n := n) A) := by
      have h3 := sub_eq_zero.mpr hc2
      rw [← sub_smul, smul_eq_zero] at h3
      rcases h3 with h3 | h3
      · rw [sub_eq_zero] at h3
        have h4 : ((casVal (lowWt (n := n) A + wordWt l) : ℤ) : ℂ) =
            ((casVal (lowWt (n := n) A) : ℤ) : ℂ) := h3
        exact Int.cast_injective h4
      · exact absurd h3 hz
    by_cases hne : l = []
    · subst hne
      obtain ⟨c, hc⟩ := (VermaPBW.lowerVermaWeight n (lamA n A)).2 z fun p => by
        have h5 := hν p
        rw [famM_apply] at h5
        rw [h5]
        simp only [wordWt, add_zero]
        rfl
      apply hz
      rw [hc] at hπ ⊢
      rw [map_smul, piM_gen] at hπ
      rcases smul_eq_zero.mp hπ with h | h
      · rw [h, zero_smul]
      · exact absurd h (lowGen_ne_zero A)
    · have hlen := ht_wordWt_add_length_le hl
      rw [ht_add] at hd
      push_cast at hd
      have := casVal_lowWt_add_lt A hl hne (by omega)
      omega

end Verma

/-! ### Independence -/

section Independence

variable {n : ℕ} (A : ℕ) {W : Type*} [AddCommGroup W] [Module ℂ W]
  {ι : Type*} (b : Module.Basis ι ℂ W) {μ : ι → Fin n → ℤ}

/-- **Injectivity of `π_*` at weight `λ`.** If `A` is large compared with the weights of `W`,
a vector `y ∈ Hom(W, M⁻(λ))` of weight `λ` with `π ∘ y = 0` vanishes. -/
theorem hom_eq_zero {s : Fin n → Fin n → Module.End ℂ W} (hb : ∀ i, IsWeightVec s (μ i) (b i))
    (hA : ∀ i, ((n : ℤ) - 1) * ∑ p, |μ i p| ≤ A)
    {y : W →ₗ[ℂ] VermaGL.LowerVerma n (lamA n A)}
    (hy : IsWeightVec (homFam s (famM n A)) (lowWt A) y) (hπ : piM n A ∘ₗ y = 0) : y = 0 := by
  refine b.ext fun i => ?_
  rw [LinearMap.zero_apply]
  refine vermaKer n A (A + 1) le_rfl (lowWt A + μ i) (y (b i)) (fun p => ?_) ?_ ?_
  · have h1 := LinearMap.congr_fun (hy p) (b i)
    rw [homFam_apply, LinearMap.smul_apply, hb i p, map_smul] at h1
    rw [Pi.add_apply, Int.cast_add, add_smul, ← h1]
    abel
  · have := LinearMap.congr_fun hπ (b i)
    simpa using this
  · rw [ht_add]
    have := neg_ht_le (μ i)
    have := hA i
    push_cast
    linarith

theorem polR_eval_ne_zero [Fintype ι] (hA : ∀ i, ((n : ℤ) - 1) * ∑ p, |μ i p| ≤ A) :
    (polR μ (lowWt A)).eval ((casVal (lowWt (n := n) A) : ℤ) : ℂ) ≠ 0 := by
  rw [polR, Polynomial.eval_prod]
  refine Finset.prod_ne_zero_iff.mpr fun i hi => ?_
  rw [eval_sub, eval_X, eval_C, sub_ne_zero]
  intro h
  have h' : casVal (lowWt A) = casVal (lowWt A - μ i) := Int.cast_injective h
  have := casVal_lowWt_lt_sub A (Finset.mem_filter.mp hi).2 (hA i)
  omega

/-- **Independence of the lowest weight vectors `ys k`, `μ_k = 0`.** For `A` large compared with
the weights of `W`, if `Σ_k c_k ys k = 0` with `c_k = 0` whenever `μ_k ≠ 0`, then `c = 0`. -/
theorem ys_eq_zero [Fintype ι] [FiniteDimensional ℂ W]
    (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W)
    (hb : ∀ i, IsWeightVec (famOf σ) (μ i) (b i))
    (hA : ∀ i, ((n : ℤ) - 1) * ∑ p, |μ i p| ≤ A) (c : ι → ℂ) (hc : ∀ k, μ k ≠ 0 → c k = 0)
    (hsum : ∑ k, c k • ys b (famOf σ) (lowFam n A) μ (lowWt A) (lowGen n A) k = 0) :
    c = 0 := by
  classical
  set s := famOf σ with hs_def
  have hs : IsGlFamily s := isGlFamily_famOf σ
  set η : W →ₗ[ℂ] ℂ := ∑ k, c k • b.coord k with hη
  set xt : W →ₗ[ℂ] VermaGL.LowerVerma n (lamA n A) := η.smulRight (VermaGL.gen n (lamA n A))
    with hxt
  have hxt_sum : xt = ∑ k, c k • xs b (VermaGL.gen n (lamA n A)) k := by
    ext w
    simp [hxt, hη, xs_apply, LinearMap.sum_apply, Finset.sum_smul, smul_smul]
  -- `xt` has weight `λ`
  have hxtw : IsWeightVec (homFam s (famM n A)) (lowWt A) xt := by
    intro p
    rw [hxt_sum, map_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    by_cases hk : μ k = 0
    · rw [map_smul, isWeightVec_xs b hb (isLowest_genM n A).1 k p, hk, sub_zero, smul_comm]
    · rw [hc k hk, zero_smul, map_zero, smul_zero]
  set Q := polR μ (lowWt A)
  set yt := aeval (cas (homFam s (famM n A))) Q xt with hyt
  -- postcomposition with `π`
  set post : (W →ₗ[ℂ] VermaGL.LowerVerma n (lamA n A)) →ₗ[ℂ] (W →ₗ[ℂ] LowMod n A) :=
    LinearMap.llcomp ℂ W (VermaGL.LowerVerma n (lamA n A)) (LowMod n A) (piM n A) with hpost_def
  have hpost : ∀ p q y, post (homFam s (famM n A) p q y) = homFam s (lowFam n A) p q (post y) := by
    intro p q y
    ext w
    simp only [post, LinearMap.llcomp_apply, homFam_apply, map_sub, piM_fam]
  have hpost_xt : post xt = ∑ k, c k • xs b (lowGen n A) k := by
    rw [hxt_sum, map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_smul]
    congr 1
    ext w
    simp only [post, LinearMap.llcomp_apply, xs_apply, map_smul, piM_gen]
  have hpost_yt : post yt = 0 := by
    have key := map_aeval_cas_comm (Y := W →ₗ[ℂ] VermaGL.LowerVerma n (lamA n A))
      (Z := W →ₗ[ℂ] LowMod n A) (h := homFam s (famM n A)) (h' := homFam s (lowFam n A))
      post hpost Q xt
    rw [hyt, key, hpost_xt, map_sum]
    rw [← hsum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_smul]
    rfl
  have hytw : IsWeightVec (homFam s (famM n A)) (lowWt A) yt :=
    isWeightVec_aeval_cas (isGlFamily_homFam hs (isGlFamily_famOf _)) Q hxtw
  have hyt0 : yt = 0 := hom_eq_zero A b hb hA hytw hpost_yt
  -- apply the trace functional
  have hlam := lamFun_aeval_cas σ (lamA n A) hxtw Q
  rw [← hyt, hyt0, map_zero, hxt, lamFun_smulRight_gen] at hlam
  have hη0 : η = 0 := by
    rcases smul_eq_zero.mp hlam.symm with h | h
    · exact absurd h (polR_eval_ne_zero A hA)
    · exact h
  funext k
  have h1 := LinearMap.congr_fun hη0 (b k)
  simp only [hη, LinearMap.sum_apply, LinearMap.smul_apply, Module.Basis.coord_apply,
    Module.Basis.repr_self, Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq, Finset.mem_univ, ite_true, LinearMap.zero_apply] at h1
  exact h1

end Independence

end GLReynolds

end Langlands.Archimedean
