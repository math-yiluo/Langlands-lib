import Langlands.Representation.Archimedean.PrincipalSeriesGKModule
import Mathlib.Analysis.CStarAlgebra.Matrix
import Mathlib.Analysis.Matrix.MeasurableSpace
import Mathlib.MeasureTheory.Function.LpSpace.ContinuousFunctions
import Mathlib.MeasureTheory.Group.Integral
import Mathlib.MeasureTheory.Measure.Haar.Basic
import Mathlib.Topology.Algebra.Star.Unitary
import Mathlib.Topology.ContinuousMap.StoneWeierstrass

/-!
# `U(n)`-finite continuous functions on `U(n)` are polynomial in the entries and their conjugates

A continuous function `f` on the unitary group `U(n)` whose right translates span a
finite-dimensional space is the restriction of a polynomial in the matrix entries `k_{ij}` and
their complex conjugates `conj k_{ij}` (`exists_mvPolynomial_of_finiteDimensional_span`). The same
holds on cosets `g · U(n) ⊂ GL_n(ℂ)` for a continuous `U(n)`-finite function on `GL_n(ℂ)`
(`exists_mvPolynomial_of_mem_kFiniteVectors`).

This is the unitary counterpart of the Library module `OrthogonalFinitePolynomial`, with the same
proof: Stone–Weierstrass density, averaging against polynomials, and separation of variables.
-/

noncomputable section

open MeasureTheory

namespace Langlands.Archimedean

namespace UnitaryFinitePolynomial

set_option autoImplicit false

variable {n : ℕ}

/-! ## Compactness -/

theorem isCompact_unitary (n : ℕ) :
    IsCompact (Matrix.unitaryGroup (Fin n) ℂ : Set (Matrix (Fin n) (Fin n) ℂ)) := by
  apply (isCompact_closedBall (0 : ℂ) 1).matrix.of_isClosed_subset isClosed_unitary
  intro U hU i j
  exact mem_closedBall_zero_iff.mpr (entry_norm_bound_of_unitary hU i j)

instance compactSpace_unitary (n : ℕ) : CompactSpace (Matrix.unitaryGroup (Fin n) ℂ) :=
  isCompact_iff_compactSpace.mp (isCompact_unitary n)

/-! ## Coordinate functions and polynomial functions -/

/-- The coordinates of `U(n)`: `Sum.inl (i, j)` is the matrix entry `k ↦ k_{ij}` and
`Sum.inr (i, j)` is its complex conjugate `k ↦ conj k_{ij}`, as continuous functions. -/
def coord (n : ℕ) : (Fin n × Fin n) ⊕ (Fin n × Fin n) → C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)
  | Sum.inl ij =>
    ⟨fun k => (k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2,
      continuous_subtype_val.matrix_elem ij.1 ij.2⟩
  | Sum.inr ij =>
    ⟨fun k => star ((k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2),
      continuous_star.comp (continuous_subtype_val.matrix_elem ij.1 ij.2)⟩

/-- The value of the coordinates at `k`: the entries of `k` and their conjugates. -/
def coordValue (k : Matrix.unitaryGroup (Fin n) ℂ) : (Fin n × Fin n) ⊕ (Fin n × Fin n) → ℂ :=
  Sum.elim (fun ij => (k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2)
    (fun ij => star ((k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2))

@[simp]
theorem coord_inl_apply (ij : Fin n × Fin n) (k : Matrix.unitaryGroup (Fin n) ℂ) :
    coord n (Sum.inl ij) k = (k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2 :=
  rfl

@[simp]
theorem coord_inr_apply (ij : Fin n × Fin n) (k : Matrix.unitaryGroup (Fin n) ℂ) :
    coord n (Sum.inr ij) k = star ((k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2) :=
  rfl

theorem coord_apply (a : (Fin n × Fin n) ⊕ (Fin n × Fin n)) (k : Matrix.unitaryGroup (Fin n) ℂ) :
    coord n a k = coordValue k a := by
  cases a <;> rfl

/-- The star subalgebra of `C(U(n), ℂ)` generated by the matrix entries. -/
def polynomialStar (n : ℕ) : StarSubalgebra ℂ C(Matrix.unitaryGroup (Fin n) ℂ, ℂ) :=
  StarAlgebra.adjoin ℂ (Set.range fun ij : Fin n × Fin n => coord n (Sum.inl ij))

theorem star_coord_inl (ij : Fin n × Fin n) : star (coord n (Sum.inl ij)) = coord n (Sum.inr ij) := by
  ext k
  rfl

theorem range_coord :
    Set.range (coord n) = (Set.range fun ij : Fin n × Fin n => coord n (Sum.inl ij)) ∪
      star (Set.range fun ij : Fin n × Fin n => coord n (Sum.inl ij)) := by
  ext φ
  constructor
  · rintro ⟨a, rfl⟩
    cases a with
    | inl ij => exact Or.inl ⟨ij, rfl⟩
    | inr ij =>
      refine Or.inr ?_
      rw [Set.mem_star]
      exact ⟨ij, by rw [← star_coord_inl, star_star]⟩
  · rintro (⟨ij, rfl⟩ | h)
    · exact ⟨Sum.inl ij, rfl⟩
    · rw [Set.mem_star] at h
      obtain ⟨ij, hij⟩ := h
      simp only at hij
      exact ⟨Sum.inr ij, by rw [← star_coord_inl, hij, star_star]⟩

theorem polynomialStar_toSubalgebra :
    (polynomialStar n).toSubalgebra = Algebra.adjoin ℂ (Set.range (coord n)) := by
  rw [polynomialStar, StarAlgebra.adjoin_toSubalgebra, range_coord]

theorem polynomialStar_separatesPoints : (polynomialStar n).SeparatesPoints := by
  intro x y hxy
  have hne : (x : Matrix (Fin n) (Fin n) ℂ) ≠ y := fun h => hxy (Subtype.ext h)
  obtain ⟨i, j, hij⟩ : ∃ i j, (x : Matrix (Fin n) (Fin n) ℂ) i j ≠
      (y : Matrix (Fin n) (Fin n) ℂ) i j := by
    by_contra h
    push Not at h
    exact hne (Matrix.ext h)
  refine ⟨coord n (Sum.inl (i, j)), ⟨coord n (Sum.inl (i, j)),
    StarAlgebra.subset_adjoin ℂ _ ⟨(i, j), rfl⟩, rfl⟩, ?_⟩
  simpa using hij

/-- Polynomial functions in the matrix entries and their conjugates, as a subalgebra of all
functions on `U(n)`. -/
def polynomialFunctions (n : ℕ) : Subalgebra ℂ (Matrix.unitaryGroup (Fin n) ℂ → ℂ) :=
  Algebra.adjoin ℂ (Set.range fun a => (coord n a : _ → ℂ))

theorem coord_mem_polynomialFunctions (a : (Fin n × Fin n) ⊕ (Fin n × Fin n)) :
    (coord n a : Matrix.unitaryGroup (Fin n) ℂ → ℂ) ∈ polynomialFunctions n :=
  Algebra.subset_adjoin ⟨a, rfl⟩

/-- Membership in `polynomialFunctions` is evaluation of a multivariate polynomial at the
matrix entries and their conjugates. -/
theorem exists_mvPolynomial_of_mem_polynomialFunctions
    {h : Matrix.unitaryGroup (Fin n) ℂ → ℂ} (hh : h ∈ polynomialFunctions n) :
    ∃ P : MvPolynomial ((Fin n × Fin n) ⊕ (Fin n × Fin n)) ℂ,
      ∀ k : Matrix.unitaryGroup (Fin n) ℂ, h k = MvPolynomial.eval (coordValue k) P := by
  rw [polynomialFunctions, Algebra.adjoin_range_eq_range_aeval] at hh
  obtain ⟨P, rfl⟩ := hh
  refine ⟨P, fun k => ?_⟩
  have := MvPolynomial.comp_aeval (R := ℂ)
    (fun a => (coord n a : Matrix.unitaryGroup (Fin n) ℂ → ℂ))
    (Pi.evalAlgHom ℂ (fun _ : Matrix.unitaryGroup (Fin n) ℂ => ℂ) k)
  have h2 := congrArg (fun φ => φ P) this
  simp only [AlgHom.comp_apply, Pi.evalAlgHom_apply] at h2
  change (MvPolynomial.aeval (fun a => (coord n a : Matrix.unitaryGroup (Fin n) ℂ → ℂ)) P) k = _
  rw [h2]
  have hval : (fun a => (coord n a : Matrix.unitaryGroup (Fin n) ℂ → ℂ) k) = coordValue k :=
    funext fun a => coord_apply a k
  show (MvPolynomial.aeval (fun a => (coord n a : Matrix.unitaryGroup (Fin n) ℂ → ℂ) k)) P = _
  rw [hval]
  rfl

/-! ## Vanishing by density -/

section Measure

variable (μ : Measure (Matrix.unitaryGroup (Fin n) ℂ)) [μ.IsHaarMeasure]

theorem integrable_of_continuous {E : Type*} [NormedAddCommGroup E]
    {f : Matrix.unitaryGroup (Fin n) ℂ → E} (hf : Continuous f) : Integrable f μ :=
  integrableOn_univ.mp (hf.continuousOn.integrableOn_compact isCompact_univ)

/-- A continuous function orthogonal to all polynomial functions vanishes. -/
theorem eq_zero_of_integral_polynomial_mul_eq_zero (g : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ))
    (hg : ∀ φ ∈ polynomialStar n, ∫ k, φ k * g k ∂μ = 0) : g = 0 := by
  let Φ : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ) → ℂ := fun φ => ∫ k, (φ * g) k ∂μ
  have hΦ : Continuous Φ := by
    have h1 : Continuous fun φ : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ) => φ * g :=
      continuous_id.mul continuous_const
    have h2 : Continuous fun F : Lp ℂ 1 μ => ∫ k, F k ∂μ := continuous_integral
    have h3 := (ContinuousMap.toLp (E := ℂ) 1 μ ℂ).continuous
    have hcomp : Φ = (fun F : Lp ℂ 1 μ => ∫ k, F k ∂μ) ∘
        (ContinuousMap.toLp (E := ℂ) 1 μ ℂ) ∘ (fun φ => φ * g) := by
      funext φ
      simp only [Function.comp_apply, Φ]
      exact (integral_congr_ae (ContinuousMap.coeFn_toLp (E := ℂ) (p := 1) (𝕜 := ℂ) μ
        (φ * g))).symm
    rw [hcomp]
    exact h2.comp (h3.comp h1)
  have hclosed : IsClosed {φ | Φ φ = 0} := isClosed_eq hΦ continuous_const
  have hsub : (polynomialStar n : Set C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)) ⊆ {φ | Φ φ = 0} :=
    fun φ hφ => hg φ hφ
  have htop := ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints
    (polynomialStar n) polynomialStar_separatesPoints
  have hall : ∀ φ, Φ φ = 0 := by
    intro φ
    have hmem : φ ∈ (polynomialStar n).topologicalClosure := by
      rw [htop]
      exact StarSubalgebra.mem_top
    rw [← SetLike.mem_coe, StarSubalgebra.topologicalClosure_coe] at hmem
    exact closure_minimal hsub hclosed hmem
  have h0 := hall (star g)
  have hpt : ∀ k, (star g * g) k = ((‖g k‖ ^ 2 : ℝ) : ℂ) := by
    intro k
    simp only [ContinuousMap.mul_apply, ContinuousMap.star_apply]
    rw [Complex.star_def, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hre : ∫ k, ‖g k‖ ^ 2 ∂μ = 0 := by
    have h0' : ∫ k, ((‖g k‖ ^ 2 : ℝ) : ℂ) ∂μ = 0 := by
      simpa only [Φ, hpt] using h0
    rw [integral_complex_ofReal] at h0'
    exact_mod_cast h0'
  have hcont : Continuous fun k => ‖g k‖ ^ 2 := (g.continuous.norm.pow 2)
  have hae : (fun k => ‖g k‖ ^ 2) =ᵐ[μ] 0 :=
    (integral_eq_zero_iff_of_nonneg (fun k => by positivity)
      (integrable_of_continuous μ hcont)).mp hre
  have heq : (fun k => ‖g k‖ ^ 2) = 0 :=
    (Continuous.ae_eq_iff_eq μ hcont continuous_const).mp hae
  ext k
  have := congrFun heq k
  simp only [Pi.zero_apply, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, pow_eq_zero_iff,
    norm_eq_zero] at this
  simp [this]

end Measure

/-! ## Right translates -/

/-- The span of the right translates `x ↦ f (x * k)`, `k ∈ U(n)`, of a function `f` on `U(n)`. -/
def translateSpan (f : Matrix.unitaryGroup (Fin n) ℂ → ℂ) :
    Submodule ℂ (Matrix.unitaryGroup (Fin n) ℂ → ℂ) :=
  Submodule.span ℂ (Set.range fun k : Matrix.unitaryGroup (Fin n) ℂ => fun x => f (x * k))

theorem translate_mem_translateSpan (f : Matrix.unitaryGroup (Fin n) ℂ → ℂ)
    (k : Matrix.unitaryGroup (Fin n) ℂ) : (fun x => f (x * k)) ∈ translateSpan f :=
  Submodule.subset_span ⟨k, rfl⟩

theorem self_mem_translateSpan (f : Matrix.unitaryGroup (Fin n) ℂ → ℂ) :
    f ∈ translateSpan f := by
  simpa using translate_mem_translateSpan f 1

/-- On a finite-dimensional space of functions, every linear functional is a finite
combination of point evaluations. -/
theorem exists_sum_eval (V : Submodule ℂ (Matrix.unitaryGroup (Fin n) ℂ → ℂ))
    [FiniteDimensional ℂ V] (ℓ : (Matrix.unitaryGroup (Fin n) ℂ → ℂ) →ₗ[ℂ] ℂ) :
    ∃ (m : ℕ) (p : Fin m → Matrix.unitaryGroup (Fin n) ℂ) (c : Fin m → ℂ),
      ∀ s ∈ V, ℓ s = ∑ i, c i * s (p i) :=
  exists_sum_of_separating (fun x => LinearMap.proj (R := ℂ)
    (φ := fun _ : Matrix.unitaryGroup (Fin n) ℂ => ℂ) x) V (fun _ _ hs => funext fun x => hs x) ℓ

/-- For `f` continuous with finite-dimensional `translateSpan f`, every linear functional
applied to the right translates of `f` is continuous in the translation parameter. -/
theorem continuous_functional_translate {f : Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hf : Continuous f) [FiniteDimensional ℂ (translateSpan f)]
    (ℓ : (Matrix.unitaryGroup (Fin n) ℂ → ℂ) →ₗ[ℂ] ℂ) :
    Continuous fun k : Matrix.unitaryGroup (Fin n) ℂ => ℓ (fun x => f (x * k)) := by
  obtain ⟨m, p, c, h⟩ := exists_sum_eval (translateSpan f) ℓ
  have hfun : (fun k : Matrix.unitaryGroup (Fin n) ℂ => ℓ (fun x => f (x * k))) =
      fun k => ∑ i, c i * f (p i * k) :=
    funext fun k => h _ (translate_mem_translateSpan f k)
  rw [hfun]
  exact continuous_finsetSum _ fun i _ =>
    continuous_const.mul (hf.comp (continuous_const.mul continuous_id))

/-! ## Functions of two variables with separated variables -/

/-- Finite sums of functions `(x, k) ↦ α(x) β(k)` with `α` polynomial in the matrix entries and
their conjugates and `β` continuous. -/
def separated (n : ℕ) :
    Submodule ℂ (Matrix.unitaryGroup (Fin n) ℂ → Matrix.unitaryGroup (Fin n) ℂ → ℂ) :=
  Submodule.span ℂ {h | ∃ α ∈ polynomialFunctions n, ∃ β : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ),
    h = fun x k => α x * β k}

theorem mul_mem_separated
    {h h' : Matrix.unitaryGroup (Fin n) ℂ → Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hh : h ∈ separated n) (hh' : h' ∈ separated n) : h * h' ∈ separated n := by
  have hle : separated n * separated n ≤ separated n := by
    rw [separated, Submodule.span_mul_span]
    apply Submodule.span_le.mpr
    rintro _ ⟨u, ⟨α, hα, β, rfl⟩, v, ⟨α', hα', β', rfl⟩, rfl⟩
    refine Submodule.subset_span ⟨α * α', mul_mem hα hα', β * β', ?_⟩
    funext x k
    simp only [Pi.mul_apply, ContinuousMap.mul_apply]
    ring
  exact hle (Submodule.mul_mem_mul hh hh')

/-- `(x, k) ↦ φ(x⁻¹ k)` has separated variables for `φ` in the algebra generated by the
coordinates: `(x⁻¹ k)_{ab} = Σ_c conj(x_{ca}) k_{cb}` since `x⁻¹ = x*`, and
`conj((x⁻¹ k)_{ab}) = Σ_c x_{ca} conj(k_{cb})`. -/
theorem inv_mul_mem_separated {φ : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)}
    (hφ : φ ∈ Algebra.adjoin ℂ (Set.range (coord n))) :
    (fun x k => φ (x⁻¹ * k)) ∈ separated n := by
  induction hφ using Algebra.adjoin_induction with
  | mem φ hφ =>
    obtain ⟨a, rfl⟩ := hφ
    cases a with
    | inl ab =>
      obtain ⟨a, b⟩ := ab
      have hfun : (fun x k : Matrix.unitaryGroup (Fin n) ℂ => coord n (Sum.inl (a, b)) (x⁻¹ * k)) =
          ∑ c, fun x k => (coord n (Sum.inr (c, a)) : Matrix.unitaryGroup (Fin n) ℂ → ℂ) x *
            coord n (Sum.inl (c, b)) k := by
        funext x k
        simp only [coord_inl_apply, coord_inr_apply, Matrix.UnitaryGroup.mul_val,
          Matrix.UnitaryGroup.inv_val, Matrix.mul_apply, Matrix.star_apply, Finset.sum_apply]
      rw [hfun]
      exact Submodule.sum_mem _ fun c _ => Submodule.subset_span
        ⟨_, coord_mem_polynomialFunctions (Sum.inr (c, a)), coord n (Sum.inl (c, b)), rfl⟩
    | inr ab =>
      obtain ⟨a, b⟩ := ab
      have hfun : (fun x k : Matrix.unitaryGroup (Fin n) ℂ => coord n (Sum.inr (a, b)) (x⁻¹ * k)) =
          ∑ c, fun x k => (coord n (Sum.inl (c, a)) : Matrix.unitaryGroup (Fin n) ℂ → ℂ) x *
            coord n (Sum.inr (c, b)) k := by
        funext x k
        simp only [coord_inl_apply, coord_inr_apply, Matrix.UnitaryGroup.mul_val,
          Matrix.UnitaryGroup.inv_val, Matrix.mul_apply, Matrix.star_apply, Finset.sum_apply,
          star_sum, star_mul', star_star]
      rw [hfun]
      exact Submodule.sum_mem _ fun c _ => Submodule.subset_span
        ⟨_, coord_mem_polynomialFunctions (Sum.inl (c, a)), coord n (Sum.inr (c, b)), rfl⟩
  | algebraMap r =>
    have hfun : (fun x k : Matrix.unitaryGroup (Fin n) ℂ =>
        (algebraMap ℂ C(Matrix.unitaryGroup (Fin n) ℂ, ℂ) r) (x⁻¹ * k)) =
        r • fun x k => (1 : Matrix.unitaryGroup (Fin n) ℂ → ℂ) x *
          (1 : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)) k := by
      funext x k
      simp
    rw [hfun]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, one_mem _, 1, rfl⟩)
  | add φ ψ _ _ hφ hψ =>
    exact Submodule.add_mem _ hφ hψ
  | mul φ ψ _ _ hφ hψ =>
    exact mul_mem_separated hφ hψ

section Measure

variable (μ : Measure (Matrix.unitaryGroup (Fin n) ℂ)) [μ.IsHaarMeasure]

/-- For `f` continuous with finite-dimensional `translateSpan f` and `φ` continuous,
`x ↦ ∫ φ(k) f(x k) dk` lies in `translateSpan f`. -/
theorem integral_translate_mem_translateSpan {f : Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hf : Continuous f) [FiniteDimensional ℂ (translateSpan f)]
    {φ : Matrix.unitaryGroup (Fin n) ℂ → ℂ} (hφ : Continuous φ) :
    (fun x => ∫ k, φ k * f (x * k) ∂μ) ∈ translateSpan f := by
  set V := translateSpan f
  let b := Module.finBasis ℂ V
  choose ℓ hℓ using fun i => LinearMap.exists_extend (b.coord i)
  have hc : ∀ i (u : V), ℓ i (u : Matrix.unitaryGroup (Fin n) ℂ → ℂ) = b.repr u i := by
    intro i u
    rw [← b.coord_apply, ← hℓ i]
    rfl
  have hrepr : ∀ k x, f (x * k) =
      ∑ i, ℓ i (fun y => f (y * k)) * (b i : Matrix.unitaryGroup (Fin n) ℂ → ℂ) x := by
    intro k x
    have h1 := b.sum_repr ⟨fun y => f (y * k), translate_mem_translateSpan f k⟩
    have h2 := congrArg (fun v : V => (v : Matrix.unitaryGroup (Fin n) ℂ → ℂ) x) h1
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul] at h2
    rw [← h2]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hc i ⟨fun y => f (y * k), translate_mem_translateSpan f k⟩]
  have hcont : ∀ i, Continuous fun k => ℓ i (fun y => f (y * k)) :=
    fun i => continuous_functional_translate hf (ℓ i)
  have hF : (fun x => ∫ k, φ k * f (x * k) ∂μ) =
      ∑ i, (∫ k, φ k * ℓ i (fun y => f (y * k)) ∂μ) •
        (b i : Matrix.unitaryGroup (Fin n) ℂ → ℂ) := by
    funext x
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    have hpt : ∀ k, φ k * f (x * k) =
        ∑ i, φ k * ℓ i (fun y => f (y * k)) * (b i : Matrix.unitaryGroup (Fin n) ℂ → ℂ) x := by
      intro k
      rw [hrepr k x, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by ring
    simp_rw [hpt]
    rw [integral_finsetSum]
    · exact Finset.sum_congr rfl fun i _ => integral_mul_const _ _
    · intro i _
      exact integrable_of_continuous μ ((hφ.mul (hcont i)).mul continuous_const)
  rw [hF]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (b i).2

/-- Integrating a separated function against a continuous `f` in the second variable gives a
polynomial function of the first variable. -/
theorem integral_separated_mem_polynomialFunctions {f : Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hf : Continuous f)
    {h : Matrix.unitaryGroup (Fin n) ℂ → Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hh : h ∈ separated n) :
    (∀ x, Continuous (h x)) ∧
      (fun x => ∫ k, h x k * f k ∂μ) ∈ polynomialFunctions n := by
  induction hh using Submodule.span_induction with
  | mem h hh =>
    obtain ⟨α, hα, β, rfl⟩ := hh
    refine ⟨fun x => continuous_const.mul β.continuous, ?_⟩
    have hfun : (fun x => ∫ k, α x * β k * f k ∂μ) = (∫ k, β k * f k ∂μ) • α := by
      funext x
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [← integral_mul_const]
      refine integral_congr_ae (Filter.Eventually.of_forall fun k => ?_)
      simp only
      ring
    rw [hfun]
    exact Subalgebra.smul_mem _ hα _
  | zero =>
    refine ⟨fun x => continuous_const, ?_⟩
    simp only [Pi.zero_apply, zero_mul, integral_zero]
    exact zero_mem _
  | add h h' _ _ ih ih' =>
    refine ⟨fun x => (ih.1 x).add (ih'.1 x), ?_⟩
    have hfun : (fun x => ∫ k, (h + h') x k * f k ∂μ) =
        (fun x => ∫ k, h x k * f k ∂μ) + (fun x => ∫ k, h' x k * f k ∂μ) := by
      funext x
      simp only [Pi.add_apply, add_mul]
      exact integral_add (integrable_of_continuous μ ((ih.1 x).mul hf))
        (integrable_of_continuous μ ((ih'.1 x).mul hf))
    rw [hfun]
    exact add_mem ih.2 ih'.2
  | smul c h _ ih =>
    refine ⟨fun x => (ih.1 x).const_smul c, ?_⟩
    have hfun : (fun x => ∫ k, (c • h) x k * f k ∂μ) =
        c • (fun x => ∫ k, h x k * f k ∂μ) := by
      funext x
      simp only [Pi.smul_apply, smul_eq_mul, mul_assoc]
      exact integral_const_mul c _
    rw [hfun]
    exact Subalgebra.smul_mem _ ih.2 c

/-- For `φ` in `polynomialStar n` and `f` continuous, `x ↦ ∫ φ(k) f(x k) dk` is polynomial. -/
theorem convolution_mem_polynomialFunctions {f : Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hf : Continuous f) {φ : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)} (hφ : φ ∈ polynomialStar n) :
    (fun x => ∫ k, φ k * f (x * k) ∂μ) ∈ polynomialFunctions n := by
  have hsub : φ ∈ (polynomialStar n).toSubalgebra := hφ
  rw [polynomialStar_toSubalgebra] at hsub
  have key := (integral_separated_mem_polynomialFunctions μ hf (inv_mul_mem_separated hsub)).2
  convert key using 1
  funext x
  rw [← integral_mul_left_eq_self (fun k => φ (x⁻¹ * k) * f k) x]
  simp only [inv_mul_cancel_left]

end Measure

/-! ## The main theorem -/

/-- A continuous function on `U(n)` whose right translates span a finite-dimensional space is
polynomial in the matrix entries and their conjugates. -/
theorem mem_polynomialFunctions_of_finiteDimensional {f : Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hf : Continuous f) [FiniteDimensional ℂ (translateSpan f)] :
    f ∈ polynomialFunctions n := by
  let μ : Measure (Matrix.unitaryGroup (Fin n) ℂ) := Measure.haar
  let S : Submodule ℂ (Matrix.unitaryGroup (Fin n) ℂ → ℂ) :=
    Submodule.span ℂ (Set.range fun φ : polynomialStar n =>
      fun x => ∫ k, (φ : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)) k * f (x * k) ∂μ)
  have hSV : S ≤ translateSpan f := by
    apply Submodule.span_le.mpr
    rintro _ ⟨φ, rfl⟩
    exact integral_translate_mem_translateSpan μ hf
      (φ : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ)).continuous
  have hSP : S ≤ Subalgebra.toSubmodule (polynomialFunctions n) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨φ, rfl⟩
    exact convolution_mem_polynomialFunctions μ hf φ.2
  suffices hfS : f ∈ S from hSP hfS
  by_contra hfS
  obtain ⟨ℓ, hℓf, hSℓ⟩ := Submodule.exists_le_ker_of_notMem hfS
  obtain ⟨m, p, c, hℓ⟩ := exists_sum_eval (translateSpan f) ℓ
  let g : C(Matrix.unitaryGroup (Fin n) ℂ, ℂ) :=
    ⟨fun k => ∑ i, c i * f (p i * k), continuous_finsetSum _ fun i _ =>
      continuous_const.mul (hf.comp (continuous_const.mul continuous_id))⟩
  have hg : g = 0 := by
    apply eq_zero_of_integral_polynomial_mul_eq_zero μ g
    intro φ hφ
    have hmem : (fun x => ∫ k, φ k * f (x * k) ∂μ) ∈ S :=
      Submodule.subset_span ⟨⟨φ, hφ⟩, rfl⟩
    have h1 : ℓ (fun x => ∫ k, φ k * f (x * k) ∂μ) = 0 := hSℓ hmem
    rw [hℓ _ (hSV hmem)] at h1
    rw [← h1]
    simp only [g, ContinuousMap.coe_mk, Finset.mul_sum]
    rw [integral_finsetSum]
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [← integral_const_mul]
      refine integral_congr_ae (Filter.Eventually.of_forall fun k => ?_)
      simp only
      ring
    · intro i _
      exact integrable_of_continuous μ (φ.continuous.mul (continuous_const.mul
        (hf.comp (continuous_const.mul continuous_id))))
  have hval : ℓ f = g 1 := by
    rw [hℓ f (self_mem_translateSpan f)]
    simp [g]
  exact hℓf (by rw [hval, hg]; rfl)

/-- **`U(n)`-finite functions are polynomial.** A continuous function on `U(n)` whose right
translates span a finite-dimensional space is the restriction of a polynomial in the matrix
entries and their complex conjugates. -/
theorem exists_mvPolynomial_of_finiteDimensional_span {f : Matrix.unitaryGroup (Fin n) ℂ → ℂ}
    (hf : Continuous f)
    (hfin : FiniteDimensional ℂ (Submodule.span ℂ
      (Set.range fun k : Matrix.unitaryGroup (Fin n) ℂ => fun x => f (x * k)))) :
    ∃ P : MvPolynomial ((Fin n × Fin n) ⊕ (Fin n × Fin n)) ℂ,
      ∀ k : Matrix.unitaryGroup (Fin n) ℂ, f k = MvPolynomial.eval (coordValue k) P :=
  have : FiniteDimensional ℂ (translateSpan f) := hfin
  exists_mvPolynomial_of_mem_polynomialFunctions (mem_polynomialFunctions_of_finiteDimensional hf)

/-- **`U(n)`-finite functions on `GL_n(ℂ)` are polynomial on cosets of `U(n)`.** If a continuous
function `f` on `GL_n(ℂ)` is `U(n)`-finite under right translation, then for every `g`, the
function `k ↦ f(g k)` on `U(n)` is polynomial in the matrix entries of `k` and their
conjugates. -/
theorem exists_mvPolynomial_of_mem_kFiniteVectors {f : Langlands.GeneralLinear n ℂ → ℂ}
    (hf : Continuous f)
    (hfK : f ∈ kFiniteVectors (Whittaker.rightTranslation ℂ (Langlands.GeneralLinear n ℂ))
      (unitaryCompact ℂ n))
    (g : Langlands.GeneralLinear n ℂ) :
    ∃ P : MvPolynomial ((Fin n × Fin n) ⊕ (Fin n × Fin n)) ℂ,
      ∀ k : Matrix.unitaryGroup (Fin n) ℂ,
        f (g * Unitary.toUnits k) = MvPolynomial.eval (coordValue k) P := by
  rw [mem_kFiniteVectors_iff] at hfK
  let f' : Matrix.unitaryGroup (Fin n) ℂ → ℂ := fun x => f (g * Unitary.toUnits x)
  have hf' : Continuous f' := hf.comp (continuous_const.mul continuous_unitary_toUnits)
  let Φ : (Langlands.GeneralLinear n ℂ → ℂ) →ₗ[ℂ] (Matrix.unitaryGroup (Fin n) ℂ → ℂ) :=
    LinearMap.funLeft ℂ ℂ (fun x => g * Unitary.toUnits x)
  have hle : translateSpan f' ≤ (Submodule.span ℂ (Set.range fun k : unitaryCompact ℂ n =>
      Whittaker.rightTranslation ℂ (Langlands.GeneralLinear n ℂ) (k : Langlands.GeneralLinear n ℂ)
        f)).map Φ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k, rfl⟩
    refine ⟨_, Submodule.subset_span ⟨⟨Unitary.toUnits k, k.2⟩, rfl⟩, ?_⟩
    funext x
    show f (g * Unitary.toUnits x * Unitary.toUnits k) = f (g * Unitary.toUnits (x * k))
    rw [map_mul, mul_assoc]
  have : FiniteDimensional ℂ (translateSpan f') := Submodule.finiteDimensional_of_le hle
  exact exists_mvPolynomial_of_mem_polynomialFunctions
    (mem_polynomialFunctions_of_finiteDimensional hf')

end UnitaryFinitePolynomial

/-- **Statement.** For every `n`, a continuous function `f : U(n) → ℂ` whose right translates
`x ↦ f (x * k)`, `k ∈ U(n)`, span a finite-dimensional space is the restriction to `U(n)` of a
polynomial with complex coefficients in the `n²` matrix entries and their `n²` complex
conjugates: the variable `Sum.inl (i, j)` is evaluated at `k_{ij}` and `Sum.inr (i, j)` at
`conj k_{ij}`. -/
def UnitaryFinitePolynomialStatement : Prop :=
  ∀ (n : ℕ) (f : Matrix.unitaryGroup (Fin n) ℂ → ℂ), Continuous f →
    FiniteDimensional ℂ (Submodule.span ℂ
      (Set.range fun k : Matrix.unitaryGroup (Fin n) ℂ => fun x => f (x * k))) →
    ∃ P : MvPolynomial ((Fin n × Fin n) ⊕ (Fin n × Fin n)) ℂ,
      ∀ k : Matrix.unitaryGroup (Fin n) ℂ,
        f k = MvPolynomial.eval (Sum.elim (fun ij => (k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2)
          (fun ij => star ((k : Matrix (Fin n) (Fin n) ℂ) ij.1 ij.2))) P

theorem unitaryFinitePolynomial : UnitaryFinitePolynomialStatement :=
  fun _ _ hf hfin =>
    UnitaryFinitePolynomial.exists_mvPolynomial_of_finiteDimensional_span hf hfin

end Langlands.Archimedean
