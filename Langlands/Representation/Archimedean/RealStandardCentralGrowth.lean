import Langlands.Representation.Archimedean.Kostant.BorelCentralGrowth
import Langlands.Representation.Archimedean.Kostant.RealTransfer
import Langlands.Representation.Archimedean.RealLinkedQuotientGrowth
import Langlands.Representation.Archimedean.MaximallyFaithfulAnnihilator

/-!
# Growth of the enveloping algebra modulo the central ideal of a real standard module

`realStandardCentralIdeal n ds` is the ideal of `U(ℂ ⊗_ℝ 𝔤𝔩_n(ℝ))` generated by the central
elements acting by `0` on the real standard module `I(ds)` (its `O(n)`-finite functions).

`realStandardCentralGrowth`: for a nonzero real standard module `I(ds)` of `GL_n(ℝ)` there is
`c > 0` such that for every `d` and every linear map `T` on `U(ℂ ⊗_ℝ 𝔤𝔩_n(ℝ))` that vanishes
on an element `u` of degree at most `d` only if `u ∈ realStandardCentralIdeal n ds`, the image
of the degree-`≤ d` part under `T` has dimension at least `c (d + 1)^(n (n - 1))`.

`realLinkedLanglandsQuotientNotLarge_of_quotientGrowth` combines it with
`RealLinkedQuotientGrowthStatement` to prove `RealLinkedLanglandsQuotientNotLargeStatement`.
-/

noncomputable section

open scoped TensorProduct

set_option autoImplicit false

-- Entries of tuples of matrices are applied through the `Matrix` definition.
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.LocalFactor.Archimedean Langlands.Algebra.UniversalEnveloping
  Langlands.Algebra.LieEnvelopingEquiv

namespace RealStandardCentralGrowth

/-! ## Transport along Lie algebra equivalences -/

section Transport

variable {L L' : Type*} [LieRing L] [LieAlgebra ℂ L] [LieRing L'] [LieAlgebra ℂ L']

/-- The enveloping equivalence of a Lie algebra equivalence maps the degree filtration onto
the degree filtration. -/
theorem map_degreeFiltration (e : L ≃ₗ⁅ℂ⁆ L') (d : ℕ) :
    (degreeFiltration ℂ L d).map (enveloping e).toLinearMap = degreeFiltration ℂ L' d := by
  have hι : (enveloping e).toLinearMap ∘ₗ
      (UniversalEnvelopingAlgebra.ι ℂ (L := L)).toLinearMap =
      (UniversalEnvelopingAlgebra.ι ℂ (L := L')).toLinearMap ∘ₗ e.toLinearEquiv.toLinearMap := by
    refine LinearMap.ext fun x => ?_
    exact enveloping_generator e x
  have hone : (1 : Submodule ℂ (UniversalEnvelopingAlgebra ℂ L)).map
      (enveloping e).toLinearMap = 1 := Submodule.map_one (enveloping e).toAlgHom
  have h1 : (degreeOne ℂ L).map (enveloping e).toLinearMap = degreeOne ℂ L' := by
    rw [degreeOne, degreeOne, Submodule.map_sup, ← LinearMap.range_comp, hι,
      LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _), hone]
  have hpow : (degreeOne ℂ L ^ d).map (enveloping e).toLinearMap =
      (degreeOne ℂ L).map (enveloping e).toLinearMap ^ d :=
    Submodule.map_pow (degreeOne ℂ L) (enveloping e).toAlgHom d
  rw [degreeFiltration, degreeFiltration, hpow, h1]

/-- The inverse enveloping equivalence maps the degree filtration onto the degree filtration. -/
theorem map_symm_degreeFiltration (e : L ≃ₗ⁅ℂ⁆ L') (d : ℕ) :
    (degreeFiltration ℂ L' d).map (enveloping e).symm.toLinearMap = degreeFiltration ℂ L d := by
  rw [← map_degreeFiltration e d, ← Submodule.map_comp]
  convert Submodule.map_id (degreeFiltration ℂ L d)
  refine LinearMap.ext fun u => ?_
  simp

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The enveloping equivalence maps the ideal generated by the central elements acting by `0`
under `π` into the corresponding ideal for `π ∘ e⁻¹`. -/
theorem enveloping_mem_span_center (e : L ≃ₗ⁅ℂ⁆ L') (π : L →ₗ⁅ℂ⁆ Module.End ℂ V)
    {u : UniversalEnvelopingAlgebra ℂ L}
    (hu : u ∈ Ideal.span {z | z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L) ∧
      envelopingAction π z = 0}) :
    enveloping e u ∈ Ideal.span {z | z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L') ∧
      envelopingAction (π.comp e.symm.toLieHom) z = 0} := by
  induction hu using Submodule.span_induction with
  | mem z hz =>
    refine Ideal.subset_span ⟨Kostant.mem_center_enveloping e hz.1, ?_⟩
    rw [Kostant.envelopingAction_comp_enveloping, hz.2]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Ideal.add_mem _ hx hy
  | smul r x _ hx => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hx

open Kostant Kostant.BorelCentralGrowth in
/-- **Growth modulo the central ideal, transported.** If `L ≅ ∏ᵢ 𝔤𝔩_{n i}(ℂ)` and `ℓ ≠ 0` is a
Borel eigenfunctional for the transported representation `π ∘ e⁻¹`, then every linear map `T`
on `U(L)` whose kernel on `U(L)_d` lies in the ideal generated by the central elements acting by
`0` under `π` maps `U(L)_d` onto a space of dimension at least `(d + 1)^m / (m + 1)^m`. -/
theorem pow_le_finrank_map_of_equiv {ι : Type} [Fintype ι] [DecidableEq ι] {n : ι → ℕ}
    (e : L ≃ₗ⁅ℂ⁆ GLProd ℂ n) (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) {ℓ : V →ₗ[ℂ] ℂ} {μ : Coord n → ℂ}
    (hℓ : BorelCentralIdeal.IsBorelEigen (π.comp e.symm.toLieHom) ℓ μ) (hℓ0 : ℓ ≠ 0)
    {F : Type*} [AddCommGroup F] [Module ℂ F] (T : UniversalEnvelopingAlgebra ℂ L →ₗ[ℂ] F)
    (d : ℕ) (hT : ∀ u ∈ degreeFiltration ℂ L d, T u = 0 →
      u ∈ Ideal.span {z | z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L) ∧
        envelopingAction π z = 0}) :
    ((d : ℝ) + 1) ^ (offLast n).card ≤
      ((offLast n).card + 1 : ℝ) ^ (offLast n).card *
        Module.finrank ℂ ((degreeFiltration ℂ L d).map T) := by
  have h := pow_le_finrank_map hℓ hℓ0 (T ∘ₗ (enveloping e).symm.toLinearMap) d
    fun u hu hTu => by
      have hu' : (enveloping e).symm u ∈ degreeFiltration ℂ L d := by
        rw [← map_symm_degreeFiltration e d]
        exact Submodule.mem_map_of_mem hu
      have := enveloping_mem_span_center e π (hT _ hu' hTu)
      rwa [AlgEquiv.apply_symm_apply] at this
  rwa [Submodule.map_comp, map_symm_degreeFiltration] at h

end Transport

/-! ## The Borel eigenfunctional of evaluation at `1` -/

section Borel

open Kostant Kostant.BorelCentralIdeal JacquetCenter

variable {n : ℕ} {W : Type*} [AddCommGroup W] [Module ℂ W]

/-- A complex upper triangular matrix, pulled back to `ℂ ⊗_ℝ 𝔤𝔩_n(ℝ)`, is `1 ⊗ X_re + i ⊗ X_im`
with real upper triangular parts. If every `c ⊗ X`, `X` real upper triangular, acts on `ℓ` by a
scalar, then `ℓ` is a Borel eigenfunctional of the transported representation. -/
theorem exists_isBorelEigen (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ⁅ℂ⁆ Module.End ℂ W)
    (ℓ : W →ₗ[ℂ] ℂ)
    (h : ∀ (c : ℂ) (X : Matrix (Fin n) (Fin n) ℝ), X.IsUpperTriangular →
      c ⊗ₜ[ℝ] X ∈ scalarSubmodule π ℓ) :
    ∃ μ : Coord (fun _ : Unit => n) → ℂ, IsBorelEigen (π.comp (toGL n).symm.toLieHom) ℓ μ := by
  have key : ∀ X : GLProd ℂ (fun _ : Unit => n), IsBUpper _ X →
      (toGL n).symm X ∈ scalarSubmodule π ℓ := by
    intro X hX
    set Xr : Matrix (Fin n) (Fin n) ℝ := (X ()).map Complex.re
    set Xi : Matrix (Fin n) (Fin n) ℝ := (X ()).map Complex.im
    have hXr : Xr.IsUpperTriangular := fun i j hij => by simp [Xr, hX () hij]
    have hXi : Xi.IsUpperTriangular := fun i j hij => by simp [Xi, hX () hij]
    have hsplit : (toGL n).symm X = (1 : ℂ) ⊗ₜ Xr + Complex.I ⊗ₜ Xi := by
      apply (toGL n).injective
      change toGL n ((toGL n).symm X) = toGL n _
      rw [LieEquiv.apply_symm_apply]
      funext u
      cases u
      ext i j
      rw [map_add, Pi.add_apply, toGL_tmul, toGL_tmul]
      simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.map_apply, one_smul, smul_eq_mul,
        Xr, Xi, Complex.coe_algebraMap]
      rw [mul_comm]
      exact (Complex.re_add_im _).symm
    rw [hsplit]
    exact add_mem (h 1 Xr hXr) (h Complex.I Xi hXi)
  have hex : ∀ c : Coord (fun _ : Unit => n), ∃ a : ℂ, c ∈ upper _ →
      ℓ ∘ₗ π ((toGL n).symm (glBasis ℂ _ c)) = a • ℓ := by
    intro c
    by_cases hc : c ∈ upper _
    · obtain ⟨a, ha⟩ := (mem_scalarSubmodule π ℓ).1 (key _ (isBUpper_glBasis hc))
      exact ⟨a, fun _ => ha⟩
    · exact ⟨0, fun h => absurd h hc⟩
  choose μ hμ using hex
  refine ⟨μ, fun c hc v => ?_⟩
  have := LinearMap.congr_fun (hμ c hc) v
  simpa using this

end Borel

/-! ## Real standard modules -/

open RealPrincipalSeriesInfChar

/-- Evaluation at `1` is a nonzero functional on a nonzero real standard module: a nonzero
`O(n)`-finite function `f` does not vanish at some `k ∈ O(n)`, and `(ρ(k) f)(1) = f(k)`. -/
theorem kFiniteEval_one_ne_zero {n : ℕ} {ds : List RealBlock}
    {f : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n)} (hf : f ≠ 0) :
    kFiniteEval (realStandardModule n ds) 1 ≠ 0 := by
  intro h0
  apply hf
  apply Subtype.ext
  refine eq_zero_of_mem_principalSeries_of_eqOn_unitaryCompact
    (realStandardModule_le_principalSeries n ds f.2.1) fun g hg => ?_
  let k : Matrix.unitaryGroup (Fin n) ℝ :=
    ⟨((g : Langlands.GeneralLinear n ℝ) : Matrix (Fin n) (Fin n) ℝ), hg⟩
  have hk : (Unitary.toUnits k : Langlands.GeneralLinear n ℝ) = g := Units.ext rfl
  have h1 := LinearMap.congr_fun h0 (realStandardRep n ds k f)
  rw [kFiniteEval_apply, LinearMap.zero_apply] at h1
  change (f : Langlands.GeneralLinear n ℝ → ℂ) (1 * Unitary.toUnits k) = 0 at h1
  rwa [one_mul, hk] at h1

end RealStandardCentralGrowth

/-- The *central ideal* of the real standard module `I(ds)`: the ideal of `U(ℂ ⊗_ℝ 𝔤𝔩_n(ℝ))`
generated by the central elements acting by `0` on `I(ds)`. -/
def realStandardCentralIdeal (n : ℕ) (ds : List RealBlock) :
    Ideal (UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ)) :=
  Ideal.span {z | z ∈ Subalgebra.center ℂ
    (UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ)) ∧
      envelopingAction (realStandardLie n ds) z = 0}

open RealStandardCentralGrowth Kostant Kostant.BorelCentralGrowth RealPrincipalSeriesInfChar in
/-- **Growth modulo the central ideal of a real standard module.** For a nonzero real standard
module `I(ds)` of `GL_n(ℝ)` there is `c > 0` such that for every `d` and every linear map `T`
on `U(ℂ ⊗_ℝ 𝔤𝔩_n(ℝ))` vanishing on an element `u` of degree at most `d` only if `u` lies in
`realStandardCentralIdeal n ds`, the image under `T` of the degree-`≤ d` part has dimension at
least `c (d + 1)^(n (n - 1))`. -/
theorem realStandardCentralGrowth (n : ℕ) (ds : List RealBlock)
    (hne : ∃ f : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n), f ≠ 0) :
    ∃ c : ℝ, 0 < c ∧ ∀ (d : ℕ) {F : Type*} [AddCommGroup F] [Module ℂ F]
      (T : UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ[ℂ] F),
      (∀ u ∈ degreeFiltration ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) d, T u = 0 →
        u ∈ realStandardCentralIdeal n ds) →
      c * ((d : ℝ) + 1) ^ (n * (n - 1)) ≤
        (Module.finrank ℂ ((degreeFiltration ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) d).map T) : ℝ) := by
  obtain ⟨f, hf⟩ := hne
  obtain ⟨μ, hμ⟩ := exists_isBorelEigen (realStandardLie n ds)
    (kFiniteEval (realStandardModule n ds) 1) fun c X hX =>
      tmul_mem_scalarSubmodule (realStandardModule n ds) _ _ _
        (realStandardModule_le_principalSeries n ds) c hX
  have hm : (offLast (fun _ : Unit => n)).card = n * (n - 1) := by
    rw [card_offLast, Fintype.univ_unit, Finset.sum_singleton]
  have hpos : (0 : ℝ) < ((n * (n - 1) : ℕ) + 1 : ℝ) ^ (n * (n - 1)) := by positivity
  refine ⟨1 / ((n * (n - 1) : ℕ) + 1 : ℝ) ^ (n * (n - 1)), by positivity, ?_⟩
  intro d F _ _ T hT
  have h := pow_le_finrank_map_of_equiv (toGL n) (realStandardLie n ds) hμ
    (kFiniteEval_one_ne_zero hf) T d hT
  rw [hm] at h
  rw [one_div, inv_mul_le_iff₀ hpos]
  exact h

open RealStandardCentralGrowth RealLinkedQuotientGrowth in
/-- **Non-largeness of linked real Langlands quotients from slow quotient growth.** The upper
bound `RealLinkedQuotientGrowthStatement` for a quotient `I(ds) / W` contradicts the lower bound
`realStandardCentralGrowth` applied to `T(u) = (v ↦ u v mod W)` when `I(ds) / R` is maximally
faithful: `T(u) = 0` puts `u · I(ds)` in `W ⊆ R`, so `u` lies in
`realStandardCentralIdeal n ds`. -/
theorem realLinkedLanglandsQuotientNotLarge_of_quotientGrowth
    (hU : RealLinkedQuotientGrowthStatement) : RealLinkedLanglandsQuotientNotLargeStatement := by
  intro n ds R hrank hord hlink _ hRtop hRmax hmf
  obtain ⟨W, hWgk, hWtop, C, hC⟩ := hU n ds hrank hord hlink
  have hWR := hRmax W hWgk hWtop
  have hne : ∃ f : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n), f ≠ 0 := by
    by_contra h0
    push Not at h0
    exact hRtop (eq_top_iff.2 fun v _ => by rw [h0 v]; exact R.zero_mem)
  obtain ⟨c, hc, hcd⟩ := realStandardCentralGrowth n ds hne
  have hn := two_le_of_not_unlinked hrank hlink
  have hN : 1 ≤ n * (n - 1) := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  have hspan : Ideal.span {z | z ∈ Subalgebra.center ℂ
      (UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ)) ∧
        ∀ v, envelopingAction (realStandardLie n ds) z v ∈ R} ≤
      realStandardCentralIdeal n ds :=
    Ideal.span_mono fun z hz => ⟨hz.1, MaximallyFaithfulAnnihilator.envelopingAction_eq_zero_of_center
      (realStandardLie_hasInfinitesimalCharacter n ds) hRtop hz.1 hz.2⟩
  refine not_forall_le hc hN (fun d => hcd d
      (LinearMap.llcomp ℂ _ _ _ W.mkQ ∘ₗ (envelopingAction (realStandardLie n ds)).toLinearMap)
      fun u _ hu => hspan (hmf u fun v => hWR ?_)) hC fun _ => le_rfl
  have := LinearMap.congr_fun hu v
  rwa [LinearMap.comp_apply, LinearMap.llcomp_apply, LinearMap.zero_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero] at this

end Langlands.Archimedean
