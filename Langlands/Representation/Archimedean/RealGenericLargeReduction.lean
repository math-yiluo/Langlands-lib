import Mathlib.Algebra.Lie.UniversalEnveloping
import Langlands.Representation.Archimedean.RealGenericParameterReduction

/-!
# Reduction of the injectivity of generic Langlands quotient maps to Kostant and Vogan

`RealGenericLanglandsQuotientInjectiveStatement` says that a nonzero `(𝔤, K)`-intertwiner from
the `O(n)`-finite part of a Langlands-ordered real standard module onto an irreducible
admissible generic `(𝔤𝔩_n(ℝ), O(n))`-module is injective. This file splits it into three
statements about the action of the universal enveloping algebra `U(𝔤)` of
`𝔤 = ℂ ⊗_ℝ 𝔤𝔩_n(ℝ)`:

* `RealGKModuleInfinitesimalCharacterStatement`: the center `Z(𝔤)` of `U(𝔤)` acts by scalars
  on an irreducible admissible `(𝔤𝔩_n(ℝ), O(n))`-module;
* `RealWhittakerMaximallyFaithfulStatement` (Kostant 1978, Theorem 3.9, for the reductive Lie
  algebra `𝔤𝔩_n(ℂ)`): a `𝔤`-module with an infinitesimal character whose algebraic dual has a
  nonzero Whittaker vector for a nondegenerate character of the upper triangular nilpotent
  radical is maximally faithful, that is, its annihilator in `U(𝔤)` is generated by its
  intersection with `Z(𝔤)`;
* `RealLargeLanglandsQuotientInjectiveStatement` (Vogan 1978, Theorem 6.2, proof of
  (a) ⇒ (f)): the standard module of a large Langlands quotient is irreducible, so a nonzero
  intertwiner from it onto a maximally faithful irreducible admissible module is injective.

`realGenericLargeReduction` proves that the three imply the target.
-/

noncomputable section

open scoped TensorProduct Matrix

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.LocalFactor.Archimedean
open scoped Matrix.Norms.Operator

-- As in `RealGenericParameterReduction`: the charts on units need reduction through the
-- normed-ring instances of matrices.
set_option backward.isDefEq.respectTransparency false

universe uL uV

/-! ## Infinitesimal characters and maximal faithfulness -/

section Enveloping

variable {L : Type uL} [LieRing L] [LieAlgebra ℂ L] {V : Type uV} [AddCommGroup V] [Module ℂ V]

/-- The action of the universal enveloping algebra `U(L)` on `V` extending the Lie algebra
action `π`: the unique algebra map `U(L) → End(V)` that is `π` on `L`. -/
abbrev envelopingAction (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) :
    UniversalEnvelopingAlgebra ℂ L →ₐ[ℂ] Module.End ℂ V :=
  UniversalEnvelopingAlgebra.lift ℂ π

/-- `π` admits an infinitesimal character (Kostant 1978, §3.9): every element `z` of the
center `Z(L)` of `U(L)` acts on `V` by a scalar `c`. -/
def HasInfinitesimalCharacter (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) : Prop :=
  ∀ z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L),
    ∃ c : ℂ, envelopingAction π z = algebraMap ℂ (Module.End ℂ V) c

/-- `π` is maximally faithful (Kostant 1978, §3.9, p. 142): the annihilator `U_V` of `V` in
`U(L)` is the ideal `U(L) · Z_V` generated by `Z_V = U_V ∩ Z(L)`. The inclusion
`U(L) · Z_V ⊆ U_V` always holds, so the condition asks that every element of `U(L)` acting by
`0` on `V` lie in the ideal generated by the central elements acting by `0`. -/
def IsMaximallyFaithful (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) : Prop :=
  ∀ u : UniversalEnvelopingAlgebra ℂ L, envelopingAction π u = 0 →
    u ∈ Ideal.span {z | z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L) ∧
      envelopingAction π z = 0}

end Enveloping

/-! ## The three statements and the reduction -/

/-- The center of `U(𝔤)`, `𝔤 = ℂ ⊗_ℝ 𝔤𝔩_n(ℝ)`, acts by scalars on every irreducible admissible
`(𝔤𝔩_n(ℝ), O(n))`-module `(ρ, π)`: it has an infinitesimal character. -/
def RealGKModuleInfinitesimalCharacterStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℝ) V)
    (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ⁅ℂ⁆ Module.End ℂ V),
    IsRealGKModule n ρ π → IsIrreducibleGKModule ρ π → IsAdmissibleGKModule ρ →
      HasInfinitesimalCharacter π

/-- Kostant's theorem (1978, Theorem 3.9) for `𝔤 = ℂ ⊗_ℝ 𝔤𝔩_n(ℝ)`: if the `𝔤`-module `π` has
an infinitesimal character and a nonzero linear functional on which the upper triangular
nilpotent radical acts by a nondegenerate character (`IsRealGenericGKModule`, a Whittaker
vector in the algebraic dual), then `π` is maximally faithful. No `K`-action is involved. -/
def RealWhittakerMaximallyFaithfulStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ⁅ℂ⁆ Module.End ℂ V),
    HasInfinitesimalCharacter π → IsRealGenericGKModule n π → IsMaximallyFaithful π

/-- Vogan's theorem (1978, Theorem 6.2, proof of (a) ⇒ (f)) for `GL_n(ℝ)` and the Library's
standard modules: if `(ρ, π)` is an irreducible admissible maximally faithful (Vogan's
"large") `(𝔤𝔩_n(ℝ), O(n))`-module and `ds` is a list of real blocks of total rank `n` in
Langlands order, then every nonzero intertwiner from the `O(n)`-finite functions of the
standard module of `ds` into `(ρ, π)` is injective. -/
def RealLargeLanglandsQuotientInjectiveStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℝ) V)
    (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ⁅ℂ⁆ Module.End ℂ V) (ds : List RealBlock)
    (B : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n) →ₗ[ℂ] V),
    IsRealGKModule n ρ π → IsIrreducibleGKModule ρ π → IsAdmissibleGKModule ρ →
      IsMaximallyFaithful π → realRank ds = n → IsRealLanglandsOrdered ds → B ≠ 0 →
        IsRealStandardIntertwiner n ρ π ds B → Function.Injective B

/-- The existence of infinitesimal characters, Kostant's theorem and Vogan's theorem imply
that nonzero intertwiners from Langlands-ordered standard modules onto generic irreducible
admissible `(𝔤𝔩_n(ℝ), O(n))`-modules are injective. -/
def RealGenericLargeReductionStatement : Prop :=
  RealGKModuleInfinitesimalCharacterStatement.{uV} →
    RealWhittakerMaximallyFaithfulStatement.{uV} →
      RealLargeLanglandsQuotientInjectiveStatement.{uV} →
        RealGenericLanglandsQuotientInjectiveStatement.{uV}

/-- The reduction: the module has an infinitesimal character, so by genericity it is
maximally faithful, and Vogan's theorem applies. -/
theorem realGenericLargeReduction : RealGenericLargeReductionStatement.{uV} := by
  intro hK1 hK2 hV n V _ _ ρ π ds B hgk hirr hadm hgen hrank hord hB0 hBint
  exact hV n V ρ π ds B hgk hirr hadm (hK2 n V π (hK1 n V ρ π hgk hirr hadm) hgen) hrank hord
    hB0 hBint

end Langlands.Archimedean
