import Langlands.Representation.Archimedean.BGChaseSetup
import Langlands.Representation.Archimedean.BGChaseKS

/-!
# The Bernstein–Gelfand chase: the abstract core

Let `κ` be a finite-dimensional representation of `𝔤𝔩_n(ℂ)` on `E` with integral weights, let
`M = M⁻(λ)` be a lower Verma module with `λ` `Z`-extremal, and let `F` be a finite-dimensional
representation with integral weights together with an equivariant map `ι_F : F → E ⊗ U`
(`U = U(𝔤𝔩_n(ℂ))` with the adjoint action) such that every `e ⊗ gen` is `c_gen(ι_F x)` for some
`x ∈ F`, where `c_m(e ⊗ u) = e ⊗ u • m`. Projectivity of `M` and the lifting of equivariant maps
into `End M` produce, for each `e ∈ E`, an element `h` of the right `U`-submodule generated by
`ι_F(F)` with `c_m(h) = e ⊗ m` for every `m ∈ M` (Bernstein–Gelfand 1980, proof of 5.10).

Everything is stated over abstract types `E`, `F` (rather than subspaces) to keep instance
synthesis on `Hom(E, F)` and `End F` cheap.
-/

noncomputable section

open scoped TensorProduct Matrix

set_option autoImplicit false

namespace Langlands.Archimedean.BGChase

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Algebra.UniversalEnveloping VermaGL

universe uE

variable {n : ℕ}

local notation "gl" => Matrix (Fin n) (Fin n) ℂ
local notation "U" => UniversalEnvelopingAlgebra ℂ (Matrix (Fin n) (Fin n) ℂ)

/-! ## The lower Verma module -/

section Verma

variable (lam : Fin n → ℂ)

theorem smul_gen (u : glU n) : u • gen n lam = Submodule.Quotient.mk u := by
  rw [gen, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]

theorem unitU_smul_gen_of_lt {p q : Fin n} (h : q < p) : unitU n p q • gen n lam = 0 := by
  rw [smul_gen, Submodule.Quotient.mk_eq_zero]
  exact Submodule.subset_span (Or.inl ⟨p, q, h, rfl⟩)

theorem unitU_smul_gen_diag (p : Fin n) : unitU n p p • gen n lam = lam p • gen n lam := by
  have h : unitU n p p - algebraMap ℂ (glU n) (lam p) ∈ lowerVermaIdeal n lam :=
    Submodule.subset_span (Or.inr ⟨p, rfl⟩)
  rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, sub_eq_zero] at h
  rw [smul_gen, h, Algebra.algebraMap_eq_smul_one, Submodule.Quotient.mk_smul]
  rfl

theorem action_apply (Y : gl) (m : LowerVerma n lam) :
    action n lam Y m = UniversalEnvelopingAlgebra.ι ℂ Y • m := rfl

/-- The evaluation pairing `m ↦ (u ↦ u • m)`. -/
def evalBil : LowerVerma n lam →ₗ[ℂ] (glU n →ₗ[ℂ] LowerVerma n lam) :=
  ((Algebra.lsmul ℂ ℂ (LowerVerma n lam) :
    glU n →ₐ[ℂ] Module.End ℂ (LowerVerma n lam)).toLinearMap).flip

theorem evalBil_apply (m : LowerVerma n lam) (u : glU n) : evalBil lam m u = u • m := rfl

end Verma

/-! ## Pairing `E ⊗ U` with `M⁻(λ)` -/

section Pair

-- The local notations are not used inside `variable`: there they lose the binding of `n`.
variable {E : Type uE} [AddCommGroup E] [Module ℂ E]
  (kE : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ E) (lam : Fin n → ℂ)

/-- The map `c_m : E ⊗ U → E ⊗ M`, `e ⊗ u ↦ e ⊗ u • m`, linear in `m`. -/
def cM : LowerVerma n lam →ₗ[ℂ] (E ⊗[ℂ] U →ₗ[ℂ] E ⊗[ℂ] LowerVerma n lam) :=
  LinearMap.lTensorHom (M := E) ∘ₗ evalBil lam

theorem cM_tmul (m : LowerVerma n lam) (e : E) (u : U) : cM lam m (e ⊗ₜ[ℂ] u) = e ⊗ₜ[ℂ] (u • m) := rfl

theorem cM_apply (m : LowerVerma n lam) (x : E ⊗[ℂ] U) :
    cM lam m x = LinearMap.lTensor E (evalBil lam m) x := rfl

/-- Right multiplication by `u` on the second factor of `E ⊗ U`. -/
def rmulE (u : U) : Module.End ℂ (E ⊗[ℂ] U) := LinearMap.lTensor E (LinearMap.mulRight ℂ u)

theorem rmulE_tmul (u : U) (e : E) (a : U) : rmulE u (e ⊗ₜ[ℂ] a) = e ⊗ₜ[ℂ] (a * u) := rfl

theorem cM_rmulE (m : LowerVerma n lam) (u : U) (x : E ⊗[ℂ] U) :
    cM lam m (rmulE u x) = cM lam (u • m) x := by
  induction x with
  | tmul e a => rw [rmulE_tmul, cM_tmul, cM_tmul, mul_smul]
  | add a b ha hb => simp only [map_add, ha, hb]

/-- The tensor product representation `κ ⊗ M` on `E ⊗ M`. -/
def Tlie (kE : gl →ₗ⁅ℂ⁆ Module.End ℂ E) (lam : Fin n → ℂ) :
    gl →ₗ⁅ℂ⁆ Module.End ℂ (E ⊗[ℂ] LowerVerma n lam) :=
  tensorLie kE (action n lam)

theorem Tlie_tmul (Y : gl) (e : E) (m : LowerVerma n lam) :
    Tlie kE lam Y (e ⊗ₜ[ℂ] m) = kE Y e ⊗ₜ[ℂ] m + e ⊗ₜ[ℂ] (UniversalEnvelopingAlgebra.ι ℂ Y • m) := rfl

theorem cM_adP (Y : gl) (m : LowerVerma n lam) (x : E ⊗[ℂ] U) :
    cM lam m (tensorLie kE adU Y x) + cM lam (UniversalEnvelopingAlgebra.ι ℂ Y • m) x =
      Tlie kE lam Y (cM lam m x) := by
  induction x with
  | tmul e a =>
    rw [tensorLie_tmul, map_add, cM_tmul, cM_tmul, cM_tmul, cM_tmul, Tlie_tmul, adU_apply,
      sub_smul, mul_smul, mul_smul, TensorProduct.tmul_sub]
    abel
  | add a b ha hb =>
    simp only [map_add]
    rw [← ha, ← hb]
    abel

/-- `θ_m : E → E ⊗ M`, `e ↦ e ⊗ m`. -/
def theta : LowerVerma n lam →ₗ[ℂ] (E →ₗ[ℂ] E ⊗[ℂ] LowerVerma n lam) :=
  (TensorProduct.mk ℂ E (LowerVerma n lam)).flip

theorem theta_apply (m : LowerVerma n lam) (e : E) : theta lam m e = e ⊗ₜ[ℂ] m := rfl

theorem homLie_theta (Y : gl) (m : LowerVerma n lam) :
    homLie kE (Tlie kE lam) Y (theta lam m) = theta lam (action n lam Y m) := by
  refine LinearMap.ext fun e => ?_
  rw [homLie_apply, theta_apply, theta_apply, theta_apply, Tlie_tmul, action_apply,
    add_sub_cancel_left]

end Pair

/-! ## The map `f : Hom(E, F) ⊗ M → Hom(E, E ⊗ M)` -/

section FMap

variable {E : Type uE} [AddCommGroup E] [Module ℂ E]
  (kE : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ E)
  (lam : Fin n → ℂ) {F : Type uE} [AddCommGroup F] [Module ℂ F]
  (sF : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ F)
  (iF : F →ₗ[ℂ] E ⊗[ℂ] UniversalEnvelopingAlgebra ℂ (Matrix (Fin n) (Fin n) ℂ))

/-- The map `f(ψ ⊗ m)(e) = c_m(ι_F(ψ(e)))`. -/
def fmap (iF : F →ₗ[ℂ] E ⊗[ℂ] U) :
    (E →ₗ[ℂ] F) ⊗[ℂ] LowerVerma n lam →ₗ[ℂ] (E →ₗ[ℂ] E ⊗[ℂ] LowerVerma n lam) :=
  TensorProduct.lift (LinearMap.mk₂ ℂ (fun ψ m => cM lam m ∘ₗ iF ∘ₗ ψ)
    (fun ψ₁ ψ₂ m => by rw [LinearMap.comp_add, LinearMap.comp_add])
    (fun c ψ m => by rw [LinearMap.comp_smul, LinearMap.comp_smul])
    (fun ψ m₁ m₂ => by rw [map_add, LinearMap.add_comp])
    (fun c ψ m => by rw [map_smul, LinearMap.smul_comp]))

theorem fmap_tmul (ψ : E →ₗ[ℂ] F) (m : LowerVerma n lam) (e : E) :
    fmap lam iF (ψ ⊗ₜ[ℂ] m) e = cM lam m (iF (ψ e)) := rfl

variable (hiF : ∀ Y x, iF (sF Y x) = tensorLie kE adU Y (iF x))
include hiF

theorem fmap_equivariant (Y : gl) (t : (E →ₗ[ℂ] F) ⊗[ℂ] LowerVerma n lam) :
    fmap lam iF (tensorLie (homLie kE sF) (action n lam) Y t) =
      homLie kE (Tlie kE lam) Y (fmap lam iF t) := by
  induction t with
  | tmul ψ m =>
    refine LinearMap.ext fun e => ?_
    rw [tensorLie_tmul, map_add, LinearMap.add_apply, fmap_tmul, fmap_tmul, homLie_apply,
      homLie_apply, fmap_tmul, fmap_tmul, action_apply, map_sub, hiF, map_sub, ← cM_adP]
    abel
  | add a b ha hb => simp only [map_add, ha, hb]

/-- The span `I` of the `c_m(ι_F x)`. -/
def Ispan (iF : F →ₗ[ℂ] E ⊗[ℂ] U) : Submodule ℂ (E ⊗[ℂ] LowerVerma n lam) :=
  Submodule.span ℂ {z | ∃ m, ∃ x : F, z = cM lam m (iF x)}

omit hiF in
theorem mem_Ispan (m : LowerVerma n lam) (x : F) : cM lam m (iF x) ∈ Ispan lam iF :=
  Submodule.subset_span ⟨m, x, rfl⟩

theorem Tlie_mem_Ispan (Y : gl) {z : E ⊗[ℂ] LowerVerma n lam} (hz : z ∈ Ispan lam iF) :
    Tlie kE lam Y z ∈ Ispan lam iF := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨m, x, rfl⟩ := hz
    rw [← cM_adP, ← hiF]
    exact Submodule.add_mem _ (mem_Ispan lam iF _ _) (mem_Ispan lam iF _ _)
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

theorem Ispan_eq_top (hFgen : ∀ e : E, ∃ x : F, cM lam (gen n lam) (iF x) = e ⊗ₜ[ℂ] gen n lam) :
    Ispan lam iF = ⊤ := by
  have H : ∀ u : U, ∀ m : LowerVerma n lam, (∀ e : E, e ⊗ₜ[ℂ] m ∈ Ispan lam iF) →
      ∀ e : E, e ⊗ₜ[ℂ] (u • m) ∈ Ispan lam iF := by
    intro u
    induction u using InfinitesimalCharacter.envInduction with
    | algebraMap c =>
      intro m hm e
      rw [algebraMap_smul, TensorProduct.tmul_smul]
      exact Submodule.smul_mem _ c (hm e)
    | ι Y =>
      intro m hm e
      have h1 := Tlie_mem_Ispan kE lam sF iF hiF Y (hm e)
      rw [Tlie_tmul] at h1
      have h2 := Submodule.sub_mem _ h1 (hm (kE Y e))
      rwa [add_sub_cancel_left] at h2
    | mul a b ha hb =>
      intro m hm e
      rw [mul_smul]
      exact ha _ (hb m hm) e
    | add a b ha hb =>
      intro m hm e
      rw [add_smul, TensorProduct.tmul_add]
      exact Submodule.add_mem _ (ha m hm e) (hb m hm e)
  have hgen : ∀ e : E, e ⊗ₜ[ℂ] gen n lam ∈ Ispan lam iF := by
    intro e
    obtain ⟨x, hcx⟩ := hFgen e
    rw [← hcx]
    exact mem_Ispan lam iF _ _
  rw [eq_top_iff]
  rintro z -
  induction z with
  | tmul e m =>
    obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
    rw [← smul_gen]
    exact H u _ hgen e
  | add a b ha hb => exact Submodule.add_mem _ ha hb

theorem fmap_surjective [FiniteDimensional ℂ E]
    (hFgen : ∀ e : E, ∃ x : F, cM lam (gen n lam) (iF x) = e ⊗ₜ[ℂ] gen n lam) :
    Function.Surjective (fmap lam iF) := by
  have hI0 := Ispan_eq_top kE lam sF iF hiF hFgen
  intro φ
  let bE := Module.finBasis ℂ E
  have hI : ∀ (c : E →ₗ[ℂ] ℂ) (z : E ⊗[ℂ] LowerVerma n lam), z ∈ Ispan lam iF →
      c.smulRight z ∈ LinearMap.range (fmap lam iF) := by
    intro c z hz
    have h := Submodule.mem_map_of_mem (f := LinearMap.smulRightₗ c) hz
    rw [Ispan, Submodule.map_span] at h
    refine Submodule.span_le.2 ?_ h
    rintro _ ⟨_, ⟨m, x, rfl⟩, rfl⟩
    refine ⟨(c.smulRight x) ⊗ₜ[ℂ] m, LinearMap.ext fun e => ?_⟩
    rw [fmap_tmul, LinearMap.smulRight_apply, LinearMap.smulRightₗ_apply,
      LinearMap.smulRight_apply, map_smul, map_smul]
  rw [eq_sum_coord_smulRight bE φ]
  exact LinearMap.mem_range.1 (Submodule.sum_mem _ fun j _ =>
    hI _ _ (hI0.symm ▸ Submodule.mem_top))

end FMap

/-! ## The map `Θ : M⁻(λ) → A ⊗ M⁻(λ)` attached to a vector `t` of weight `λ` -/

section Theta

variable {A : Type uE} [AddCommGroup A] [Module ℂ A]
  (sA : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ A) (lam : Fin n → ℂ)

/-- `u ↦ Λ(u) t`, `Λ` the enveloping action of `σ_A ⊗ M⁻(λ)`. -/
def phiT (sA : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ A) (lam : Fin n → ℂ)
    (t : A ⊗[ℂ] LowerVerma n lam) : U →ₗ[ℂ] A ⊗[ℂ] LowerVerma n lam where
  toFun u := envelopingAction (tensorLie sA (action n lam)) u t
  map_add' a b := by rw [map_add, LinearMap.add_apply]
  map_smul' c a := by rw [map_smul, LinearMap.smul_apply, RingHom.id_apply]

theorem phiT_apply (t : A ⊗[ℂ] LowerVerma n lam) (u : U) :
    phiT sA lam t u = envelopingAction (tensorLie sA (action n lam)) u t := rfl

/-- If `t` is killed by the strictly lower triangular matrix units and has weight `λ`, then
`u ↦ Λ(u) t` vanishes on the ideal defining `M⁻(λ)`. -/
theorem phiT_ker (t : A ⊗[ℂ] LowerVerma n lam)
    (hlow : ∀ p q : Fin n, q < p → tensorEnd (sA (Matrix.single p q 1))
      (action n lam (Matrix.single p q 1)) t = 0)
    (hdiag : ∀ p, tensorEnd (sA (Matrix.single p p 1)) (action n lam (Matrix.single p p 1)) t =
      lam p • t) :
    (lowerVermaIdeal n lam).restrictScalars ℂ ≤ LinearMap.ker (phiT sA lam t) := by
  intro x hx
  rw [Submodule.restrictScalars_mem] at hx
  rw [LinearMap.mem_ker]
  induction hx using Submodule.span_induction with
  | mem x hx =>
    rcases hx with ⟨p, q, hpq, rfl⟩ | ⟨p, rfl⟩
    · rw [phiT_apply, UniversalEnvelopingAlgebra.lift_ι_apply]
      exact hlow p q hpq
    · rw [phiT_apply, map_sub, AlgHom.commutes, LinearMap.sub_apply, Module.algebraMap_end_apply,
        UniversalEnvelopingAlgebra.lift_ι_apply]
      exact sub_eq_zero.2 (hdiag p)
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul a x _ hx =>
    rw [phiT_apply] at hx
    rw [phiT_apply, smul_eq_mul, map_mul, Module.End.mul_apply, hx, map_zero]

/-- The map `Θ : M⁻(λ) → A ⊗ M⁻(λ)`, `u • gen ↦ Λ(u) t`. -/
def Theta (sA : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ A) (lam : Fin n → ℂ)
    (t : A ⊗[ℂ] LowerVerma n lam)
    (hker : (lowerVermaIdeal n lam).restrictScalars ℂ ≤ LinearMap.ker (phiT sA lam t)) :
    LowerVerma n lam →ₗ[ℂ] A ⊗[ℂ] LowerVerma n lam :=
  ((lowerVermaIdeal n lam).restrictScalars ℂ).liftQ (phiT sA lam t) hker ∘ₗ
    (Submodule.Quotient.restrictScalarsEquiv ℂ (lowerVermaIdeal n lam)).symm.toLinearMap

variable (t : A ⊗[ℂ] LowerVerma n lam)
  (hker : (lowerVermaIdeal n lam).restrictScalars ℂ ≤ LinearMap.ker (phiT sA lam t))

theorem Theta_mk (u : U) :
    Theta sA lam t hker (Submodule.Quotient.mk u) =
      envelopingAction (tensorLie sA (action n lam)) u t := rfl

theorem Theta_smul (u : U) (m : LowerVerma n lam) :
    Theta sA lam t hker (u • m) =
      envelopingAction (tensorLie sA (action n lam)) u (Theta sA lam t hker m) := by
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [← Submodule.Quotient.mk_smul, smul_eq_mul, Theta_mk, Theta_mk, map_mul,
    Module.End.mul_apply]

theorem Theta_action (Y : gl) (m : LowerVerma n lam) :
    Theta sA lam t hker (action n lam Y m) =
      tensorLie sA (action n lam) Y (Theta sA lam t hker m) := by
  rw [action_apply, Theta_smul, UniversalEnvelopingAlgebra.lift_ι_apply]

/-- `g(α) = (α ⊗ 1) ∘ Θ : M⁻(λ) → M⁻(λ)` for `α ∈ A*`, linear in `α`. -/
def gmap (Θ : LowerVerma n lam →ₗ[ℂ] A ⊗[ℂ] LowerVerma n lam) :
    (A →ₗ[ℂ] ℂ) →ₗ[ℂ] Module.End ℂ (LowerVerma n lam) :=
  LinearMap.lcomp ℂ _ Θ ∘ₗ
    LinearMap.llcomp ℂ _ _ _ (TensorProduct.lid ℂ (LowerVerma n lam)).toLinearMap ∘ₗ
      LinearMap.rTensorHom (LowerVerma n lam)

theorem gmap_apply (Θ : LowerVerma n lam →ₗ[ℂ] A ⊗[ℂ] LowerVerma n lam) (α : A →ₗ[ℂ] ℂ)
    (m : LowerVerma n lam) :
    gmap lam Θ α m = TensorProduct.lid ℂ _ (LinearMap.rTensor _ α (Θ m)) := rfl

theorem gmap_equivariant (Θ : LowerVerma n lam →ₗ[ℂ] A ⊗[ℂ] LowerVerma n lam)
    (hΘ : ∀ Y m, Θ (action n lam Y m) = tensorLie sA (action n lam) Y (Θ m)) (Y : gl)
    (α : A →ₗ[ℂ] ℂ) :
    gmap lam Θ (homLie sA 0 Y α) =
      action n lam Y * gmap lam Θ α - gmap lam Θ α * action n lam Y := by
  refine LinearMap.ext fun m => ?_
  rw [LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply, gmap_apply, gmap_apply,
    gmap_apply, hΘ]
  generalize Θ m = z
  induction z with
  | tmul a m' =>
    simp only [LinearMap.rTensor_tmul, TensorProduct.lid_tmul, homLie_apply, tensorLie_tmul,
      map_add, map_smul, zero_apply, LinearMap.zero_apply, zero_sub, neg_smul]
    abel
  | add a b ha hb =>
    simp only [map_add, ha, hb]
    abel

end Theta

/-! ## The element `h` -/

section Chase

variable {E : Type uE} [AddCommGroup E] [Module ℂ E]
  (kE : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ E)
  (lam : Fin n → ℂ) {F : Type uE} [AddCommGroup F] [Module ℂ F]
  (sF : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ F)
  (iF : F →ₗ[ℂ] E ⊗[ℂ] UniversalEnvelopingAlgebra ℂ (Matrix (Fin n) (Fin n) ℂ))
  (hiF : ∀ Y x, iF (sF Y x) = tensorLie kE adU Y (iF x))
include hiF

theorem fmap_Theta (t : (E →ₗ[ℂ] F) ⊗[ℂ] LowerVerma n lam)
    (hker : (lowerVermaIdeal n lam).restrictScalars ℂ ≤
      LinearMap.ker (phiT (homLie kE sF) lam t))
    (ht : fmap lam iF t = theta lam (gen n lam)) (m : LowerVerma n lam) :
    fmap lam iF (Theta (homLie kE sF) lam t hker m) = theta lam m := by
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [Theta_mk, env_intertwine _ _ (fmap lam iF) (fmap_equivariant kE lam sF iF hiF), ht,
    ← env_intertwine (action n lam) _ (theta lam) (fun Y m => (homLie_theta kE lam Y m).symm),
    envelopingAction_action, smul_gen]

/-- Bernstein–Gelfand 1980, proof of 5.10: for every `e ∈ E` there is `h` in the right
`U`-module generated by `ι_F(F)` with `c_m(h) = e ⊗ m` for all `m ∈ M⁻(λ)`. -/
theorem exists_h (hWt : LowerVermaWeightStatement) (hDuflo : LowerVermaDufloStatement)
    (hK : KostantMultiplicityStatement.{uE}) (hB : LowerVermaHomBoundStatement.{uE})
    (hP : LowerVermaProjectiveStatement.{uE, uE}) (hlam : IsZExtremal n lam)
    (χ : center n →ₐ[ℂ] ℂ) (hχ : ∀ z : center n, (z : glU n) • gen n lam = χ z • gen n lam)
    [FiniteDimensional ℂ E] (hkE : HasIntegralWeights kE) [FiniteDimensional ℂ F]
    (hsF : HasIntegralWeights sF)
    (hFgen : ∀ e : E, ∃ x : F, cM lam (gen n lam) (iF x) = e ⊗ₜ[ℂ] gen n lam) (e : E) :
    ∃ h ∈ Submodule.span ℂ {y : E ⊗[ℂ] U | ∃ (u : U) (x : F), y = rmulE u (iF x)},
      ∀ m : LowerVerma n lam, cM lam m h = e ⊗ₜ[ℂ] m := by
  have hA : HasIntegralWeights (homLie kE sF) := intSpan_homLie hkE hsF
  obtain ⟨t, ht, hlow, hdiag⟩ := hP n lam hlam (E →ₗ[ℂ] F) (homLie kE sF) hA
    (E →ₗ[ℂ] E ⊗[ℂ] LowerVerma n lam) (homLie kE (Tlie kE lam)) (fmap lam iF)
    (fmap_surjective kE lam sF iF hiF hFgen) (fmap_equivariant kE lam sF iF hiF)
    (theta lam (gen n lam))
    (fun p q hpq => by
      rw [homLie_theta, action_apply]
      exact (congrArg (theta lam) (unitU_smul_gen_of_lt lam hpq)).trans (map_zero _))
    (fun p => by
      rw [homLie_theta, action_apply]
      exact (congrArg (theta lam) (unitU_smul_gen_diag lam p)).trans (map_smul _ _ _))
  have hker := phiT_ker (homLie kE sF) lam t hlow hdiag
  have hΘf := fmap_Theta kE lam sF iF hiF t hker ht
  have hW : HasIntegralWeights
      (homLie (homLie kE sF) (0 : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ ℂ)) :=
    intSpan_homLie hA intSpan_trivial
  obtain ⟨g', hg'⟩ := exists_lift hWt hDuflo hK hB hlam χ hχ _ hW
    (gmap lam (Theta (homLie kE sF) lam t hker))
    (gmap_equivariant (homLie kE sF) lam _ (Theta_action (homLie kE sF) lam t hker))
  have hg'm : ∀ (α : (E →ₗ[ℂ] F) →ₗ[ℂ] ℂ) (m : LowerVerma n lam), g' α • m =
      TensorProduct.lid ℂ _ (LinearMap.rTensor _ α (Theta (homLie kE sF) lam t hker m)) := by
    intro α m
    rw [← envelopingAction_action, hg']
    rfl
  let bA := Module.finBasis ℂ (E →ₗ[ℂ] F)
  refine ⟨∑ k, rmulE (g' (bA.coord k)) (iF (bA k e)),
    Submodule.sum_mem _ fun k _ => Submodule.subset_span ⟨_, _, rfl⟩, fun m => ?_⟩
  have h1 : e ⊗ₜ[ℂ] m = ∑ k, cM lam (TensorProduct.lid ℂ _ (LinearMap.rTensor _ (bA.coord k)
      (Theta (homLie kE sF) lam t hker m))) (iF (bA k e)) := by
    rw [← theta_apply lam m e, ← hΘf m]
    conv_lhs => rw [eq_sum_basis_tmul bA (Theta (homLie kE sF) lam t hker m)]
    rw [map_sum, LinearMap.sum_apply]
    simp only [fmap_tmul]
  rw [h1, map_sum]
  simp only [cM_rmulE, hg'm]

end Chase

end Langlands.Archimedean.BGChase
