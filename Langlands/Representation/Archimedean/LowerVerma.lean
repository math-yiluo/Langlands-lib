import Mathlib.Algebra.Lie.UniversalEnveloping
import Langlands.Representation.Archimedean.RealGenericLargeReduction

/-!
# Lower Verma modules for `𝔤𝔩_n(ℂ)` and the Bernstein–Gelfand inputs

This file defines the lower Verma modules `M⁻(λ)` of `𝔤𝔩_n(ℂ)` and states six standard facts
about them and about the universal enveloping algebra `U = U(𝔤𝔩_n(ℂ))`. Together they drive the
Bernstein–Gelfand comparison between Harish-Chandra bimodules and category `𝒪`
(Bernstein–Gelfand 1980, Theorem 5.9 and its proof 5.10).

`M⁻(λ) = U / (U 𝔫⁻ + Σ_p U (E_pp - λ_p))` is the Verma module for the *lower* triangular Borel
subalgebra: its generator is killed by the strictly lower triangular matrix units and has weight
`λ`, so its weights lie in `λ + Q₊`, where `Q₊` is the cone of `ℕ`-combinations of the positive
roots `ε_p - ε_q`, `p < q`.

Definitions:

* `glU n`, `unitU n p q`, `center n`: `U(𝔤𝔩_n(ℂ))`, the image of `E_pq` in it, and its center;
* `lowerVermaIdeal n λ`, `LowerVerma n λ`, `gen n λ`, `action n λ`: `M⁻(λ)`, its generator and
  the `𝔤𝔩_n(ℂ)`-action on it;
* `posRootCone n`: the cone `Q₊`;
* `IsZExtremal n λ`: no `μ ∈ λ - Q₊` other than `λ` has the central character of `λ`
  (`λ` is minimal in its linkage class for the order given by `Q₊`);
* `HasIntegralWeights σ`, `zeroWeightSpace σ`: a representation whose diagonal matrix units act
  diagonalizably with integer eigenvalues, and its zero weight space;
* `tensorEnd a b = a ⊗ 1 + 1 ⊗ b`.

Statements:

* `LowerVermaWeightStatement`: `M⁻(λ) ≠ 0` and its `λ`-weight space is spanned by the generator;
* `LowerVermaDufloStatement`: Duflo's theorem, the annihilator of `M⁻(λ)` is generated by central
  elements;
* `KostantMultiplicityStatement`: Kostant's lower bound for the multiplicity of a
  finite-dimensional representation `W` in `U / U ker χ`, by `dim W₀`;
* `CentralCharacterStatement`: every central character is that of `M⁻(λ)` for a `Z`-extremal `λ`;
* `LowerVermaHomBoundStatement`: for `Z`-extremal `λ`, at most `dim W₀` linearly independent
  equivariant maps `W → End M⁻(λ)`;
* `LowerVermaProjectiveStatement`: for `Z`-extremal `λ`, lowest weight vectors of weight `λ` lift
  along surjections out of `W ⊗ M⁻(λ)` (projectivity of `M⁻(λ)`);
* `BernsteinGelfandInputsStatement`: their conjunction.

Bernstein–Gelfand work with a semisimple Lie algebra and the upper Borel subalgebra; here the
Lie algebra is the reductive `𝔤𝔩_n(ℂ)` and the Borel subalgebra is the lower one. The
finite-dimensional representations are restricted by the algebraic condition
`HasIntegralWeights`.
-/

noncomputable section

open scoped TensorProduct

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

namespace VermaGL

universe uW uN

variable (n : ℕ)

/-- The universal enveloping algebra `U(𝔤𝔩_n(ℂ))`. -/
abbrev glU : Type := UniversalEnvelopingAlgebra ℂ (Matrix (Fin n) (Fin n) ℂ)

/-- The image `E_pq ∈ U(𝔤𝔩_n(ℂ))` of the matrix unit `E_pq`. -/
abbrev unitU (p q : Fin n) : glU n := UniversalEnvelopingAlgebra.ι ℂ (Matrix.single p q 1)

/-- The center `Z(𝔤𝔩_n(ℂ))` of `U(𝔤𝔩_n(ℂ))`. -/
abbrev center : Subalgebra ℂ (glU n) := Subalgebra.center ℂ (glU n)

/-- The left ideal of `U(𝔤𝔩_n(ℂ))` generated by the strictly lower triangular matrix units
`E_pq` (`q < p`) and the elements `E_pp - λ_p`. -/
def lowerVermaIdeal (lam : Fin n → ℂ) : Submodule (glU n) (glU n) :=
  Submodule.span (glU n)
    ({x | ∃ p q : Fin n, q < p ∧ x = unitU n p q} ∪
      {x | ∃ p : Fin n, x = unitU n p p - algebraMap ℂ (glU n) (lam p)})

/-- The lower Verma module `M⁻(λ) = U(𝔤𝔩_n) / (U 𝔫⁻ + Σ_p U (E_pp - λ_p))`, a left
`U(𝔤𝔩_n(ℂ))`-module. -/
abbrev LowerVerma (lam : Fin n → ℂ) : Type := glU n ⧸ lowerVermaIdeal n lam

/-- The canonical generator `1 + U 𝔫⁻ + Σ_p U (E_pp - λ_p)` of `M⁻(λ)`. -/
def gen (lam : Fin n → ℂ) : LowerVerma n lam := Submodule.Quotient.mk 1

/-- The action of `𝔤𝔩_n(ℂ)` on `M⁻(λ)`: `X` acts by left multiplication by its image in
`U(𝔤𝔩_n(ℂ))`. -/
def action (lam : Fin n → ℂ) : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ (LowerVerma n lam) :=
  (Algebra.lsmul ℂ ℂ (LowerVerma n lam) :
      glU n →ₐ[ℂ] Module.End ℂ (LowerVerma n lam)).toLieHom.comp
    (UniversalEnvelopingAlgebra.ι ℂ)

/-- The cone `Q₊ ⊆ ℂⁿ` of `ℕ`-combinations of the positive roots `ε_p - ε_q`, `p < q`. -/
def posRootCone : AddSubmonoid (Fin n → ℂ) :=
  AddSubmonoid.closure {β | ∃ p q : Fin n, p < q ∧ β = Pi.single p 1 - Pi.single q 1}

/-- `λ` is `Z`-extremal: for every `μ ∈ λ - Q₊` with `μ ≠ λ` some central element `z` acts on
the generators of `M⁻(λ)` and `M⁻(μ)` by different scalars, i.e. it acts on `gen λ` by a scalar
`c` and does not act on `gen μ` by `c`. Thus no `μ < λ` has the central character of `λ`. -/
def IsZExtremal (lam : Fin n → ℂ) : Prop :=
  ∀ μ : Fin n → ℂ, lam - μ ∈ posRootCone n → μ ≠ lam →
    ∃ z ∈ center n, ∃ c : ℂ, z • gen n lam = c • gen n lam ∧ z • gen n μ ≠ c • gen n μ

section Weights

variable {n} {W : Type uW} [AddCommGroup W] [Module ℂ W]

/-- `σ` has integral weights: `W` is spanned by vectors `w` with `σ(E_pp) w = m_p w` for all `p`,
for some integers `m_p`. -/
def HasIntegralWeights (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W) : Prop :=
  Submodule.span ℂ {w : W | ∃ m : Fin n → ℤ, ∀ p, σ (Matrix.single p p 1) w = (m p : ℂ) • w} = ⊤

/-- The zero weight space `W₀ = ⋂_p ker σ(E_pp)` of `σ`. -/
def zeroWeightSpace (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W) : Submodule ℂ W :=
  ⨅ p : Fin n, LinearMap.ker (σ (Matrix.single p p 1))

end Weights

/-- `tensorEnd a b = a ⊗ 1 + 1 ⊗ b` on `W ⊗ N`; for representations `σ`, `τ` of a Lie algebra,
`Y ↦ tensorEnd (σ Y) (τ Y)` is the tensor product representation. -/
def tensorEnd {W : Type uW} [AddCommGroup W] [Module ℂ W] {N : Type uN} [AddCommGroup N]
    [Module ℂ N] (a : Module.End ℂ W) (b : Module.End ℂ N) : Module.End ℂ (W ⊗[ℂ] N) :=
  LinearMap.rTensor N a + LinearMap.lTensor W b

/-- The generator of `M⁻(λ)` is nonzero, and every vector of weight `λ` (`E_pp m = λ_p m` for
all `p`) is a multiple of it (Bernstein–Gelfand 1980, 1.9(c); Poincaré–Birkhoff–Witt). -/
def LowerVermaWeightStatement : Prop :=
  ∀ (n : ℕ) (lam : Fin n → ℂ), gen n lam ≠ 0 ∧
    ∀ m : LowerVerma n lam, (∀ p, unitU n p p • m = lam p • m) → ∃ c : ℂ, m = c • gen n lam

/-- Duflo's theorem (Bernstein–Gelfand 1980, 1.13(b)) for lower Verma modules of `𝔤𝔩_n(ℂ)`:
every element of `U(𝔤𝔩_n(ℂ))` acting by zero on `M⁻(λ)` lies in the ideal generated by the
central elements acting by zero. -/
def LowerVermaDufloStatement : Prop :=
  ∀ (n : ℕ) (lam : Fin n → ℂ), IsMaximallyFaithful (action n lam)

/-- Kostant's multiplicity theorem (Bernstein–Gelfand 1980, 1.7), lower bound: for a
finite-dimensional representation `σ` of `𝔤𝔩_n(ℂ)` with integral weights and a character `χ` of
the center there are `dim W₀` linear maps `f_i : W → U(𝔤𝔩_n(ℂ))`, equivariant for the adjoint
action (`f_i(σ(Y) w) = Y f_i(w) - f_i(w) Y`), whose images in `U / U ker χ` are linearly
independent: if `Σ_i c_i f_i(w)` lies in the ideal generated by the `z - χ(z)` for every `w`,
then `c = 0`. -/
def KostantMultiplicityStatement : Prop :=
  ∀ (n : ℕ) (W : Type uW) [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
    (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W), HasIntegralWeights σ →
    ∀ χ : center n →ₐ[ℂ] ℂ,
      ∃ f : Fin (Module.finrank ℂ (zeroWeightSpace σ)) → (W →ₗ[ℂ] glU n),
        (∀ i Y w, f i (σ Y w) = UniversalEnvelopingAlgebra.ι ℂ Y * f i w -
          f i w * UniversalEnvelopingAlgebra.ι ℂ Y) ∧
        ∀ c : Fin (Module.finrank ℂ (zeroWeightSpace σ)) → ℂ,
          (∀ w, ∑ i, c i • f i w ∈
            Ideal.span {x | ∃ z : center n, x = (z : glU n) - algebraMap ℂ (glU n) (χ z)}) →
          c = 0

/-- Every character `χ` of the center of `U(𝔤𝔩_n(ℂ))` is the central character of a lower Verma
module `M⁻(λ)` with `λ` `Z`-extremal (Harish-Chandra's theorem, Bernstein–Gelfand 1980, 1.6, and
finiteness of linkage classes). -/
def CentralCharacterStatement : Prop :=
  ∀ (n : ℕ) (χ : center n →ₐ[ℂ] ℂ), ∃ lam : Fin n → ℂ, IsZExtremal n lam ∧
    ∀ z : center n, (z : glU n) • gen n lam = χ z • gen n lam

/-- For `Z`-extremal `λ` and a finite-dimensional representation `σ` with integral weights, a
linearly independent family of `d` equivariant maps `g_i : W → End M⁻(λ)`
(`g_i(σ(Y) w) = [Y, g_i(w)]`) has `d ≤ dim W₀` (Bernstein–Gelfand 1980, 1.9(f), 1.11(c)). -/
def LowerVermaHomBoundStatement : Prop :=
  ∀ (n : ℕ) (lam : Fin n → ℂ), IsZExtremal n lam →
    ∀ (W : Type uW) [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
      (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W), HasIntegralWeights σ →
      ∀ (d : ℕ) (g : Fin d → (W →ₗ[ℂ] Module.End ℂ (LowerVerma n lam))),
        (∀ i Y w, g i (σ Y w) = action n lam Y * g i w - g i w * action n lam Y) →
        LinearIndependent ℂ g → d ≤ Module.finrank ℂ (zeroWeightSpace σ)

/-- Projectivity of `M⁻(λ)` for `Z`-extremal `λ` (Bernstein–Gelfand 1980, 1.11; proof of 5.10):
let `σ` be a finite-dimensional representation with integral weights, `τ` any representation on
`N` and `f : W ⊗ M⁻(λ) → N` a surjective equivariant map. Every `x ∈ N` of weight `λ` killed by
the strictly lower triangular matrix units is `f(t)` for some `t ∈ W ⊗ M⁻(λ)` of weight `λ`
killed by them. -/
def LowerVermaProjectiveStatement : Prop :=
  ∀ (n : ℕ) (lam : Fin n → ℂ), IsZExtremal n lam →
    ∀ (W : Type uW) [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
      (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W), HasIntegralWeights σ →
      ∀ (N : Type uN) [AddCommGroup N] [Module ℂ N]
        (τ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ N)
        (f : W ⊗[ℂ] LowerVerma n lam →ₗ[ℂ] N), Function.Surjective f →
        (∀ Y t, f (tensorEnd (σ Y) (action n lam Y) t) = τ Y (f t)) →
        ∀ x : N, (∀ p q : Fin n, q < p → τ (Matrix.single p q 1) x = 0) →
          (∀ p, τ (Matrix.single p p 1) x = lam p • x) →
          ∃ t, f t = x ∧
            (∀ p q : Fin n, q < p → tensorEnd (σ (Matrix.single p q 1))
              (action n lam (Matrix.single p q 1)) t = 0) ∧
            ∀ p, tensorEnd (σ (Matrix.single p p 1)) (action n lam (Matrix.single p p 1)) t =
              lam p • t

/-- The conjunction of the six inputs of the Bernstein–Gelfand argument. -/
def BernsteinGelfandInputsStatement : Prop :=
  LowerVermaWeightStatement ∧ LowerVermaDufloStatement ∧ KostantMultiplicityStatement.{uW} ∧
    CentralCharacterStatement ∧ LowerVermaHomBoundStatement.{uW} ∧
    LowerVermaProjectiveStatement.{uW, uN}

end VermaGL

end Langlands.Archimedean
