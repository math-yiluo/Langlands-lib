import Langlands.Representation.Archimedean.GLReynolds
import Mathlib.LinearAlgebra.Eigenspace.Semisimple

/-!
# Modules generated by a lowest weight vector

Let `e_pq` (`p, q < n`) be operators on a complex vector space `V` satisfying the commutation
relations of the matrix units of `𝔤𝔩_n(ℂ)` (`IsGlFamily`). A *lowest weight vector* of weight
`λ ∈ ℤⁿ` is a weight vector killed by all `e_pq` with `q < p`.

* `genSub e S` is the smallest `e`-stable subspace containing `S`; for a lowest weight vector
  `x` it is spanned by the vectors `e_{a₁b₁} ⋯ e_{a_kb_k} x` with `a_i < b_i`
  (`genSub_le_upperSpan`), which are weight vectors of weight `λ + Σ (ε_{a_i} - ε_{b_i})`.
* `intWeights_resFam`: in a finite-dimensional module with integral weights, every stable
  subspace is again spanned by weight vectors.
* `eq_top_of_lowest`: a finite-dimensional module with integral weights generated by a
  lowest weight vector is irreducible. The proof compares the scalar by which the Casimir
  operator acts on lowest weight vectors (`casVal`) and uses that `casVal` strictly decreases
  along `λ ↦ λ + ε_a - ε_b` (`a < b`) between dominant weights (`casVal_wordWt_le`).
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

namespace GLReynolds

open ComplexJacquetFinite Module

/-! ### Words and their weights -/

section Words

variable {n : ℕ}

/-- The weight shift `Σ (ε_a - ε_b)` of a word `[(a₁, b₁), …, (a_k, b_k)]`. -/
def wordWt : List (Fin n × Fin n) → Fin n → ℤ
  | [] => 0
  | a :: l => Pi.single a.1 1 - Pi.single a.2 1 + wordWt l

/-- A word is upper if all its letters `(a, b)` have `a < b`. -/
def IsUpperWord (l : List (Fin n × Fin n)) : Prop := ∀ a ∈ l, a.1 < a.2

theorem IsUpperWord.tail {a : Fin n × Fin n} {l : List (Fin n × Fin n)}
    (h : IsUpperWord (a :: l)) : IsUpperWord l :=
  fun b hb => h b (List.mem_cons_of_mem a hb)

theorem IsUpperWord.head {a : Fin n × Fin n} {l : List (Fin n × Fin n)}
    (h : IsUpperWord (a :: l)) : a.1 < a.2 :=
  h a (by simp)

theorem isUpperWord_nil : IsUpperWord ([] : List (Fin n × Fin n)) := fun _ h => by simp at h

theorem sum_wordWt_mul (c : Fin n → ℤ) : ∀ l : List (Fin n × Fin n),
    ∑ p, wordWt l p * c p = (l.map fun a => c a.1 - c a.2).sum
  | [] => by simp [wordWt]
  | a :: l => by
    rw [List.map_cons, List.sum_cons, ← sum_wordWt_mul c l]
    simp only [wordWt, Pi.add_apply, Pi.sub_apply, add_mul, sub_mul, Finset.sum_add_distrib,
      Finset.sum_sub_distrib, Pi.single_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true]

/-- The double sum in `casVal` is the linear functional `μ ↦ Σ_p (2p + 1 - n) μ_p`. -/
theorem sum_sum_ite_lt (f : Fin n → ℤ) :
    ∑ p, ∑ q, (if q < p then f p - f q else 0) = ∑ p, f p * (2 * (p : ℤ) + 1 - n) := by
  have h1 : ∀ p : Fin n, ∑ q, (if q < p then f p else 0) = f p * (p : ℤ) := by
    intro p
    rw [← Finset.sum_filter, Finset.sum_const, Finset.filter_gt_eq_Iio, Fin.card_Iio,
      nsmul_eq_mul, mul_comm]
  have h2 : ∀ q : Fin n, ∑ p, (if q < p then f q else 0) = f q * ((n : ℤ) - 1 - q) := by
    intro q
    rw [← Finset.sum_filter, Finset.sum_const, Finset.filter_lt_eq_Ioi, Fin.card_Ioi,
      nsmul_eq_mul, mul_comm]
    congr 1
    have := q.isLt
    omega
  have h3 : ∀ p q : Fin n, (if q < p then f p - f q else 0) =
      (if q < p then f p else 0) - (if q < p then f q else 0) := by
    intro p q; split_ifs <;> ring
  simp only [h3, Finset.sum_sub_distrib, h1]
  rw [Finset.sum_comm (f := fun p q => if q < p then f q else 0)]
  simp only [h2, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun p _ => ?_
  ring

/-- The scalar `Σ_p μ_p² + Σ_{q<p} (μ_p - μ_q)` by which the Casimir operator acts on a lowest
weight vector of weight `μ` (`cas_apply_lowest`). -/
def casVal (μ : Fin n → ℤ) : ℤ := ∑ p, μ p ^ 2 + ∑ p, ∑ q, if q < p then μ p - μ q else 0

theorem casVal_add_sub (lam β : Fin n → ℤ) :
    casVal (lam + β) - casVal lam =
      ∑ p, β p * (lam p + (lam + β) p + 2 * (p : ℤ) + 1 - n) := by
  have hL : ∀ μ : Fin n → ℤ,
      casVal μ = ∑ p, (μ p ^ 2 + μ p * (2 * (p : ℤ) + 1 - n)) := by
    intro μ; rw [casVal, sum_sum_ite_lt, Finset.sum_add_distrib]
  rw [hL, hL, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun p _ => ?_
  simp only [Pi.add_apply]
  ring

/-- `casVal` decreases by at least `2` for each letter of an upper word, between weights that
are dominant (`μ_q ≤ μ_p` for `q < p`). -/
theorem casVal_wordWt_le {lam : Fin n → ℤ} {l : List (Fin n × Fin n)} (hl : IsUpperWord l)
    (hlam : ∀ p q, q < p → lam q ≤ lam p)
    (hnu : ∀ p q, q < p → (lam + wordWt l) q ≤ (lam + wordWt l) p) :
    casVal (lam + wordWt l) + 2 * l.length ≤ casVal lam := by
  have h := casVal_add_sub lam (wordWt l)
  rw [sum_wordWt_mul] at h
  set z : Fin n → ℤ := fun p => lam p + (lam + wordWt l) p + 2 * (p : ℤ) + 1 - n with hz
  have hterm : ∀ a ∈ l, z a.1 - z a.2 ≤ -2 := by
    intro a ha
    have hab := hl a ha
    have h1 := hlam a.2 a.1 hab
    have h2 := hnu a.2 a.1 hab
    have h3 : (a.1 : ℤ) + 1 ≤ a.2 := by exact_mod_cast hab
    simp only [hz]
    omega
  have hsum : ∀ l' : List (Fin n × Fin n), (∀ a ∈ l', z a.1 - z a.2 ≤ -2) →
      (l'.map fun a => z a.1 - z a.2).sum ≤ -2 * l'.length := by
    intro l' hl'
    induction l' with
    | nil => simp
    | cons a l' ih =>
      rw [List.map_cons, List.sum_cons, List.length_cons]
      have := hl' a (by simp)
      have := ih fun b hb => hl' b (List.mem_cons_of_mem a hb)
      push_cast
      linarith
  have := hsum l hterm
  linarith

end Words

/-! ### Generated subspaces -/

section Gen

variable {V : Type*} [AddCommGroup V] [Module ℂ V] {n : ℕ}

/-- A subspace stable under all `e_pq`. -/
def IsStable (e : Fin n → Fin n → Module.End ℂ V) (Z : Submodule ℂ V) : Prop :=
  ∀ p q, ∀ v ∈ Z, e p q v ∈ Z

/-- The smallest `e`-stable subspace containing `S`. -/
def genSub (e : Fin n → Fin n → Module.End ℂ V) (S : Set V) : Submodule ℂ V :=
  sInf {T | S ⊆ T ∧ IsStable e T}

/-- `x` is a lowest weight vector of weight `μ`: a weight vector killed by all `e_pq`, `q < p`. -/
def IsLowest (e : Fin n → Fin n → Module.End ℂ V) (μ : Fin n → ℤ) (x : V) : Prop :=
  IsWeightVec e μ x ∧ ∀ p q, q < p → e p q x = 0

/-- The operator `e_{a₁b₁} ⋯ e_{a_kb_k}` of a word `[(a₁, b₁), …, (a_k, b_k)]`. -/
def word (e : Fin n → Fin n → Module.End ℂ V) : List (Fin n × Fin n) → Module.End ℂ V
  | [] => 1
  | a :: l => e a.1 a.2 * word e l

/-- The span of the vectors `e_{a₁b₁} ⋯ e_{a_kb_k} x` over upper words. -/
def upperSpan (e : Fin n → Fin n → Module.End ℂ V) (x : V) : Submodule ℂ V :=
  Submodule.span ℂ {y | ∃ l, IsUpperWord l ∧ y = word e l x}

variable {e : Fin n → Fin n → Module.End ℂ V}

theorem subset_genSub (S : Set V) : S ⊆ genSub e S := by
  intro x hx
  rw [SetLike.mem_coe, genSub, Submodule.mem_sInf]
  rintro T ⟨hST, -⟩
  exact hST hx

theorem isStable_genSub (S : Set V) : IsStable e (genSub e S) := by
  intro p q v hv
  rw [genSub, Submodule.mem_sInf] at hv ⊢
  rintro T ⟨hST, hT⟩
  exact hT p q v (hv T ⟨hST, hT⟩)

theorem genSub_le {S : Set V} {T : Submodule ℂ V} (hS : S ⊆ T) (hT : IsStable e T) :
    genSub e S ≤ T :=
  sInf_le ⟨hS, hT⟩

theorem mem_genSub_self (x : V) : x ∈ genSub e {x} := subset_genSub {x} rfl

@[simp] theorem word_nil_apply (x : V) : word e [] x = x := rfl

theorem word_cons_apply (a : Fin n × Fin n) (l : List (Fin n × Fin n)) (x : V) :
    word e (a :: l) x = e a.1 a.2 (word e l x) := rfl

theorem isWeightVec_word (he : IsGlFamily e) {μ : Fin n → ℤ} {x : V} (hx : IsWeightVec e μ x) :
    ∀ l : List (Fin n × Fin n), IsUpperWord l → IsWeightVec e (μ + wordWt l) (word e l x)
  | [], _ => by simpa [wordWt] using hx
  | a :: l, hl => by
    have h := isWeightVec_shift he (isWeightVec_word he hx l hl.tail) (ne_of_lt hl.head)
    have heq : μ + wordWt (a :: l) = μ + wordWt l + Pi.single a.1 1 - Pi.single a.2 1 := by
      simp only [wordWt]; abel
    rw [heq, word_cons_apply]
    exact h

theorem word_mem_genSub (x : V) :
    ∀ l : List (Fin n × Fin n), word e l x ∈ genSub e {x}
  | [] => mem_genSub_self x
  | a :: l => by
    rw [word_cons_apply]
    exact isStable_genSub _ a.1 a.2 _ (word_mem_genSub x l)

theorem word_mem_upperSpan (x : V) {l : List (Fin n × Fin n)} (hl : IsUpperWord l) :
    word e l x ∈ upperSpan e x :=
  Submodule.subset_span ⟨l, hl, rfl⟩

theorem apply_mem_upperSpan_of_lt {x : V} {a b : Fin n} (hab : a < b) {y : V}
    (hy : y ∈ upperSpan e x) : e a b y ∈ upperSpan e x := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, hl, rfl⟩ := hy
    have hl' : IsUpperWord ((a, b) :: l) := by
      intro c hc
      rcases List.mem_cons.mp hc with rfl | hc
      · exact hab
      · exact hl c hc
    have := word_mem_upperSpan (e := e) x hl'
    rwa [word_cons_apply] at this
  | zero => simp
  | add y z _ _ hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
  | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy

theorem isStable_upperSpan (he : IsGlFamily e) {μ : Fin n → ℤ} {x : V} (hx : IsLowest e μ x) :
    IsStable e (upperSpan e x) := by
  have key : ∀ l : List (Fin n × Fin n), IsUpperWord l → ∀ p q,
      e p q (word e l x) ∈ upperSpan e x := by
    intro l
    induction l with
    | nil =>
      intro _ p q
      rw [word_nil_apply]
      have hx0 : x ∈ upperSpan e x := word_mem_upperSpan (e := e) x isUpperWord_nil
      rcases lt_trichotomy p q with hpq | rfl | hqp
      · exact apply_mem_upperSpan_of_lt hpq hx0
      · rw [hx.1 p]; exact Submodule.smul_mem _ _ hx0
      · rw [hx.2 p q hqp]; exact Submodule.zero_mem _
    | cons a l ih =>
      intro hl p q
      have hc := he p q a.1 a.2
      have hsplit : e p q (word e (a :: l) x) = e a.1 a.2 (e p q (word e l x)) +
          ((if q = a.1 then e p a.2 else 0) - (if a.2 = p then e a.1 q else 0))
            (word e l x) := by
        rw [← hc, word_cons_apply]
        simp only [LinearMap.sub_apply, Module.End.mul_apply]
        abel
      rw [hsplit]
      refine Submodule.add_mem _ (apply_mem_upperSpan_of_lt hl.head (ih hl.tail p q)) ?_
      rw [LinearMap.sub_apply]
      refine Submodule.sub_mem _ ?_ ?_
      · split_ifs
        · exact ih hl.tail p a.2
        · simp
      · split_ifs
        · exact ih hl.tail a.1 q
        · simp
  intro p q v hv
  induction hv using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, hl, rfl⟩ := hy
    exact key l hl p q
  | zero => simp
  | add y z _ _ hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
  | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy

theorem genSub_le_upperSpan (he : IsGlFamily e) {μ : Fin n → ℤ} {x : V} (hx : IsLowest e μ x) :
    genSub e {x} ≤ upperSpan e x := by
  apply genSub_le _ (isStable_upperSpan he hx)
  rintro _ rfl
  exact word_mem_upperSpan (e := e) _ isUpperWord_nil

theorem upperSpan_le_genSub (x : V) : upperSpan e x ≤ genSub e {x} := by
  rw [upperSpan, Submodule.span_le]
  rintro _ ⟨l, -, rfl⟩
  exact word_mem_genSub x l

end Gen

/-! ### Weight spaces -/

section Weights

variable {V : Type*} [AddCommGroup V] [Module ℂ V] {n : ℕ} {e : Fin n → Fin n → Module.End ℂ V}

theorem commute_diag (he : IsGlFamily e) (i j : Fin n) : Commute (e i i) (e j j) := by
  by_cases hij : i = j
  · subst hij; exact Commute.refl _
  · have h := he i i j j
    have hji : ¬ j = i := fun h => hij h.symm
    simp only [hij, hji, ite_false, sub_zero] at h
    exact sub_eq_zero.mp h

/-- The generalized weight space of an integral weight. -/
def wtSpace (e : Fin n → Fin n → Module.End ℂ V) (μ : Fin n → ℤ) : Submodule ℂ V :=
  ⨅ r, (e r r).maxGenEigenspace ((μ r : ℤ) : ℂ)

theorem mem_wtSpace {μ : Fin n → ℤ} {v : V} (hv : IsWeightVec e μ v) : v ∈ wtSpace e μ := by
  rw [wtSpace, Submodule.mem_iInf]
  intro r
  rw [Module.End.mem_maxGenEigenspace]
  exact ⟨1, by simp [hv r]⟩

/-- A vector of the generalized weight space of `ν` lying in the span of weight vectors whose
weights avoid `ν` vanishes. -/
theorem eq_zero_of_mem_span (he : IsGlFamily e) {S : Set V} {Ω : Set (Fin n → ℤ)}
    (hS : ∀ y ∈ S, ∃ μ ∈ Ω, IsWeightVec e μ y) {z : V} (hz : z ∈ Submodule.span ℂ S)
    {ν : Fin n → ℤ} (hν : z ∈ wtSpace e ν) (hνΩ : ν ∉ Ω) : z = 0 := by
  classical
  let t : (Fin n → ℂ) → Submodule ℂ V := fun χ => ⨅ r, (e r r).maxGenEigenspace (χ r)
  have hind : iSupIndep t := Module.End.independent_iInf_maxGenEigenspace_of_forall_mapsTo
    (fun r => e r r)
    (fun i j φ => Module.End.mapsTo_maxGenEigenspace_of_comm (commute_diag he j i) φ)
  let c : (Fin n → ℤ) → (Fin n → ℂ) := fun μ r => ((μ r : ℤ) : ℂ)
  have hcinj : Function.Injective c := by
    intro μ μ' h; funext r; exact Int.cast_injective (congr_fun h r)
  have hnot : c ν ∉ c '' Ω := fun ⟨μ, hμ, h⟩ => hνΩ (hcinj h ▸ hμ)
  have hspan : Submodule.span ℂ S ≤ ⨆ χ ∈ c '' Ω, t χ := by
    rw [Submodule.span_le]
    intro y hy
    obtain ⟨μ, hμ, hyμ⟩ := hS y hy
    exact (le_biSup t (Set.mem_image_of_mem c hμ)) (mem_wtSpace hyμ)
  have hmem : z ∈ t (c ν) ⊓ ⨆ χ ∈ c '' Ω, t χ := ⟨hν, hspan hz⟩
  rw [(hind.disjoint_biSup hnot).eq_bot] at hmem
  exact (Submodule.mem_bot ℂ).mp hmem

/-- A nonzero weight vector in the span of weight vectors with weights in `Ω` has its weight
in `Ω`. -/
theorem weight_mem_of_mem_span (he : IsGlFamily e) {S : Set V} {Ω : Set (Fin n → ℤ)}
    (hS : ∀ y ∈ S, ∃ μ ∈ Ω, IsWeightVec e μ y) {z : V} (hz : z ∈ Submodule.span ℂ S)
    (hz0 : z ≠ 0) {ν : Fin n → ℤ} (hν : IsWeightVec e ν z) : ν ∈ Ω := by
  by_contra hνΩ
  exact hz0 (eq_zero_of_mem_span he hS hz (mem_wtSpace hν) hνΩ)

/-- The family restricted to a stable subspace. -/
def resFam (Z : Submodule ℂ V) (hZ : IsStable e Z) : Fin n → Fin n → Module.End ℂ Z :=
  fun p q => (e p q).restrict (hZ p q)

theorem resFam_coe (Z : Submodule ℂ V) (hZ : IsStable e Z) (p q : Fin n) (z : Z) :
    ((resFam Z hZ p q z : Z) : V) = e p q z := rfl

theorem isGlFamily_resFam (he : IsGlFamily e) (Z : Submodule ℂ V) (hZ : IsStable e Z) :
    IsGlFamily (resFam Z hZ) := by
  intro a b c d
  apply LinearMap.ext
  intro z
  apply Subtype.ext
  have h := LinearMap.congr_fun (he a b c d) (z : V)
  simp only [LinearMap.sub_apply, Module.End.mul_apply] at h
  simp only [LinearMap.sub_apply, Module.End.mul_apply, Submodule.coe_sub, resFam_coe, h]
  split_ifs <;> simp [resFam_coe]

theorem isWeightVec_resFam_iff {Z : Submodule ℂ V} {hZ : IsStable e Z} {μ : Fin n → ℤ}
    {z : Z} : IsWeightVec (resFam Z hZ) μ z ↔ IsWeightVec e μ (z : V) := by
  simp only [IsWeightVec, Subtype.ext_iff, resFam_coe, Submodule.coe_smul]

/-- On a finite-dimensional module with integral weights, each `e_rr` is semisimple. -/
theorem isSemisimple_diag [FiniteDimensional ℂ V] (hw : IntWeights e) (r : Fin n) :
    (e r r).IsSemisimple := by
  classical
  obtain ⟨s, hs0, hs⟩ := exists_poly_eq_zero hw r
  have heq : Polynomial.X * ∏ k ∈ s, (Polynomial.X - Polynomial.C ((k : ℤ) : ℂ)) =
      ∏ k ∈ insert 0 s, (Polynomial.X - Polynomial.C ((k : ℤ) : ℂ)) := by
    rw [Finset.prod_insert hs0]; simp
  rw [heq] at hs
  refine Module.End.isSemisimple_of_squarefree_aeval_eq_zero ?_ hs
  apply Polynomial.Separable.squarefree
  rw [Polynomial.separable_prod_X_sub_C_iff']
  intro x _ y _ hxy
  exact_mod_cast hxy

/-- Eigenvalues of `e_rr` on a finite-dimensional module with integral weights are integers. -/
theorem exists_int_of_eigen [FiniteDimensional ℂ V] (hw : IntWeights e) (r : Fin n) {v : V}
    (hv : v ≠ 0) {c : ℂ} (hc : e r r v = c • v) : ∃ m : ℤ, c = m := by
  classical
  obtain ⟨s, -, hs⟩ := exists_poly_eq_zero hw r
  have h := LinearMap.congr_fun hs v
  rw [LinearMap.zero_apply, Module.End.aeval_apply_of_mem_apply_eq_smul hc] at h
  have h' := (smul_eq_zero.mp h).resolve_right hv
  rw [Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_prod] at h'
  rcases mul_eq_zero.mp h' with h0 | h0
  · exact ⟨0, by simp [h0]⟩
  · obtain ⟨k, -, hk⟩ := Finset.prod_eq_zero_iff.mp h0
    refine ⟨k, ?_⟩
    simpa [sub_eq_zero] using hk

/-- In a finite-dimensional module with integral weights, every stable subspace is spanned by
weight vectors. -/
theorem intWeights_resFam [FiniteDimensional ℂ V] (he : IsGlFamily e) (hw : IntWeights e)
    (Z : Submodule ℂ V) (hZ : IsStable e Z) : IntWeights (resFam Z hZ) := by
  classical
  let f : Fin n → Module.End ℂ Z := fun r => resFam Z hZ r r
  have hcomm : ∀ i j, Commute (f i) (f j) := fun i j =>
    commute_diag (e := resFam Z hZ) (isGlFamily_resFam he Z hZ) i j
  have htop := Module.End.iSup_iInf_maxGenEigenspace_eq_top_of_forall_mapsTo f
    (fun i j φ => Module.End.mapsTo_maxGenEigenspace_of_comm (hcomm j i) φ)
    (fun i => Module.End.iSup_maxGenEigenspace_eq_top (f i))
  have hss : ∀ r, (f r).IsSemisimple := fun r => (isSemisimple_diag hw r).restrict (hZ r r)
  rw [IntWeights, eq_top_iff, ← htop]
  refine iSup_le fun χ => ?_
  intro z hz
  have hz' : ∀ r, f r z = χ r • z := by
    intro r
    have := (Submodule.mem_iInf _).mp hz r
    rw [Module.End.IsFinitelySemisimple.maxGenEigenspace_eq_eigenspace
      (Module.End.IsSemisimple.isFinitelySemisimple (hss r))] at this
    exact Module.End.mem_eigenspace_iff.mp this
  by_cases hz0 : z = 0
  · rw [hz0]; exact Submodule.zero_mem _
  · have hint : ∀ r, ∃ m : ℤ, χ r = m := by
      intro r
      refine exists_int_of_eigen hw r (v := (z : V)) ?_ ?_
      · intro h; exact hz0 (Subtype.ext h)
      · have := congrArg Subtype.val (hz' r)
        simpa [f, resFam_coe] using this
    choose μ hμ using hint
    exact Submodule.subset_span ⟨μ, fun r => by rw [hz' r, hμ r]⟩

/-- The submodule generated by a lowest weight vector is spanned by weight vectors. -/
theorem intWeights_resFam_genSub (he : IsGlFamily e) {μ : Fin n → ℤ} {x : V}
    (hx : IsLowest e μ x) : IntWeights (resFam (genSub e {x}) (isStable_genSub {x})) := by
  have hle : upperSpan e x ≤ (Submodule.span ℂ {v | ∃ ν : Fin n → ℤ,
      IsWeightVec (resFam (genSub e {x}) (isStable_genSub {x})) ν v}).map
        (genSub e {x}).subtype := by
    rw [upperSpan, Submodule.span_le]
    rintro _ ⟨l, hl, rfl⟩
    refine ⟨⟨word e l x, word_mem_genSub x l⟩, Submodule.subset_span ⟨μ + wordWt l, ?_⟩, rfl⟩
    exact isWeightVec_resFam_iff.mpr (isWeightVec_word he hx.1 l hl)
  rw [IntWeights, eq_top_iff]
  intro y _
  obtain ⟨g, hg, hgy⟩ := hle (genSub_le_upperSpan he hx y.2)
  have : g = y := Subtype.ext hgy
  rwa [← this]

/-- The subspace generated by `x` inside `genSub e {x}` is everything. -/
theorem genSub_resFam_eq_top (x : V) :
    genSub (resFam (genSub e {x}) (isStable_genSub {x})) {⟨x, mem_genSub_self x⟩} = ⊤ := by
  have hle : genSub e {x} ≤ (genSub (resFam (genSub e {x}) (isStable_genSub {x}))
      {⟨x, mem_genSub_self x⟩}).map (genSub e {x}).subtype := by
    apply genSub_le
    · rintro y (hy : y = x)
      rw [hy]
      exact ⟨⟨x, mem_genSub_self x⟩, mem_genSub_self _, rfl⟩
    · rintro p q _ ⟨g, hg, rfl⟩
      exact ⟨resFam (genSub e {x}) (isStable_genSub {x}) p q g, isStable_genSub _ p q g hg, rfl⟩
  rw [eq_top_iff]
  intro y _
  obtain ⟨g, hg, hgy⟩ := hle y.2
  have : g = y := Subtype.ext hgy
  rwa [← this]

end Weights

/-! ### Irreducibility -/

section Irreducible

variable {V : Type*} [AddCommGroup V] [Module ℂ V] {n : ℕ} {e : Fin n → Fin n → Module.End ℂ V}

/-- The weight of a nonzero lowest weight vector in a finite-dimensional module is dominant. -/
theorem dominant_of_lowest [FiniteDimensional ℂ V] (he : IsGlFamily e) {μ : Fin n → ℤ} {v : V}
    (hv : IsLowest e μ v) (hv0 : v ≠ 0) : ∀ p q, q < p → μ q ≤ μ p := by
  intro p q hqp
  obtain ⟨h1, h2, h3⟩ := sl2_rel he (ne_of_gt hqp)
  have hh : (e p p - e q q) v = (((μ p - μ q : ℤ)) : ℂ) • v := by
    rw [LinearMap.sub_apply, hv.1 p, hv.1 q, ← sub_smul]; push_cast; rfl
  obtain ⟨⟨k, hk⟩, -⟩ := sl2_nat h1 h2 h3 hv0 hh (hv.2 p q hqp)
  have : μ p - μ q = k := by exact_mod_cast hk
  omega

/-- The Casimir operator acts on the submodule generated by a lowest weight vector of weight
`λ` by `casVal λ`. -/
theorem cas_apply_of_mem_genSub (he : IsGlFamily e) {lam : Fin n → ℤ} {x : V}
    (hx : IsLowest e lam x) {v : V} (hv : v ∈ genSub e {x}) :
    cas e v = ((casVal lam : ℤ) : ℂ) • v := by
  set T : Submodule ℂ V := LinearMap.ker (cas e - ((casVal lam : ℤ) : ℂ) • 1)
  have hT : genSub e {x} ≤ T := by
    apply genSub_le
    · rintro _ rfl
      simp only [T, SetLike.mem_coe, LinearMap.mem_ker, LinearMap.sub_apply,
        LinearMap.smul_apply, Module.End.one_apply, sub_eq_zero]
      exact cas_apply_lowest he hx.1 hx.2
    · intro p q w hw
      simp only [T, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
        Module.End.one_apply, sub_eq_zero] at hw ⊢
      rw [← cas_apply_comm he, hw, map_smul]
  have := hT hv
  simpa [T, sub_eq_zero] using this

/-- **Irreducibility.** A finite-dimensional module with integral weights generated by a lowest
weight vector has no nonzero proper stable subspace. -/
theorem eq_top_of_lowest [FiniteDimensional ℂ V] (he : IsGlFamily e) (hw : IntWeights e)
    {lam : Fin n → ℤ} {x : V} (hx : IsLowest e lam x) (hx0 : x ≠ 0)
    (hgen : genSub e {x} = ⊤) {Z : Submodule ℂ V} (hZ : IsStable e Z) (hZ0 : Z ≠ ⊥) :
    Z = ⊤ := by
  classical
  have : Nontrivial Z := Submodule.nontrivial_iff_ne_bot.mpr hZ0
  obtain ⟨z, hz0, ν, hν, hlow⟩ :=
    exists_lowest (isGlFamily_resFam he Z hZ) (intWeights_resFam he hw Z hZ)
  have hz0' : (z : V) ≠ 0 := fun h => hz0 (Subtype.ext h)
  have hν' : IsWeightVec e ν (z : V) := isWeightVec_resFam_iff.mp hν
  have hlow' : ∀ p q, q < p → e p q (z : V) = 0 := by
    intro p q hqp
    have := congrArg Subtype.val (hlow p q hqp)
    simpa [resFam_coe] using this
  have hzx : (z : V) ∈ upperSpan e x :=
    genSub_le_upperSpan he hx (by rw [hgen]; trivial)
  -- the Casimir scalars agree
  have hcas : casVal ν = casVal lam := by
    have h1 := cas_apply_lowest he hν' hlow'
    have h2 := cas_apply_of_mem_genSub he hx (v := (z : V)) (by rw [hgen]; trivial)
    rw [h1, ← casVal] at h2
    have := sub_eq_zero.mpr h2
    rw [← sub_smul] at this
    have := (smul_eq_zero.mp this).resolve_right hz0'
    exact_mod_cast sub_eq_zero.mp this
  -- the weight of `z` is `λ + wordWt l` for an upper word `l`
  have hΩ : ν ∈ {μ | ∃ l, IsUpperWord l ∧ μ = lam + wordWt l} := by
    refine weight_mem_of_mem_span he ?_ hzx hz0' hν'
    rintro _ ⟨l, hl, rfl⟩
    exact ⟨_, ⟨l, hl, rfl⟩, isWeightVec_word he hx.1 l hl⟩
  obtain ⟨l, hl, rfl⟩ := hΩ
  have hlen := casVal_wordWt_le hl (dominant_of_lowest he hx hx0)
    (dominant_of_lowest he ⟨hν', hlow'⟩ hz0')
  have hl0 : l = [] := by
    rw [← List.length_eq_zero_iff]
    rw [hcas] at hlen
    omega
  subst hl0
  -- `z` is a multiple of `x`
  set S' : Set V := {y | ∃ l, IsUpperWord l ∧ l ≠ [] ∧ y = word e l x}
  have hsup : upperSpan e x ≤ Submodule.span ℂ {x} ⊔ Submodule.span ℂ S' := by
    rw [upperSpan, Submodule.span_le]
    rintro _ ⟨l, hl, rfl⟩
    by_cases hl0 : l = []
    · subst hl0
      exact Submodule.mem_sup_left (Submodule.subset_span rfl)
    · exact Submodule.mem_sup_right (Submodule.subset_span ⟨l, hl, hl0, rfl⟩)
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hsup hzx)
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp ha
  have hb0 : b = 0 := by
    refine eq_zero_of_mem_span he (Ω := {μ | ∃ l, IsUpperWord l ∧ l ≠ [] ∧ μ = lam + wordWt l})
      ?_ hb (ν := lam) ?_ ?_
    · rintro _ ⟨l, hl, hl0, rfl⟩
      exact ⟨_, ⟨l, hl, hl0, rfl⟩, isWeightVec_word he hx.1 l hl⟩
    · have : b = (z : V) - c • x := by rw [← hab]; abel
      rw [this]
      refine Submodule.sub_mem _ (mem_wtSpace ?_) (Submodule.smul_mem _ _ (mem_wtSpace hx.1))
      simpa [wordWt] using hν'
    · rintro ⟨l, hl, hl0, hlam⟩
      have hw0 : wordWt l = 0 := by
        have := congrArg (fun μ => μ - lam) hlam
        simpa using this.symm
      have := sum_wordWt_mul (fun p => (p : ℤ)) l
      rw [hw0] at this
      simp only [Pi.zero_apply, zero_mul, Finset.sum_const_zero] at this
      have hneg : ∀ l' : List (Fin n × Fin n), IsUpperWord l' → l' ≠ [] →
          (l'.map fun a => ((a.1 : ℕ) : ℤ) - ((a.2 : ℕ) : ℤ)).sum < 0 := by
        intro l' hl' hl'0
        induction l' with
        | nil => exact absurd rfl hl'0
        | cons a l' ih =>
          rw [List.map_cons, List.sum_cons]
          have h1 : ((a.1 : ℕ) : ℤ) < ((a.2 : ℕ) : ℤ) := by exact_mod_cast hl'.head
          by_cases hl'' : l' = []
          · subst hl''; simp; omega
          · have := ih hl'.tail hl''
            omega
      have := hneg l hl hl0
      omega
  rw [hb0, add_zero] at hab
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hab
    exact hz0' hab.symm
  have hxZ : x ∈ Z := by
    have : x = c⁻¹ • (z : V) := by rw [← hab, smul_smul, inv_mul_cancel₀ hc0, one_smul]
    rw [this]
    exact Z.smul_mem _ z.2
  rw [eq_top_iff, ← hgen]
  exact genSub_le (by simpa using hxZ) hZ

end Irreducible

end GLReynolds

end Langlands.Archimedean
