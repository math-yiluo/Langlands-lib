import Langlands.Representation.Archimedean.BGChaseWeighted
import Langlands.Representation.Archimedean.LowerVermaSimple

/-!
# The kernel of `u ↦ u · T` for a vector `T` with `ℓ(Y) T = r(Yᵀ) T`

Let `ℓ`, `r` be commuting actions of `𝔤𝔩_n(ℂ)` on `V` and `T ≠ 0` a vector with
`ℓ(Y) T = r(Yᵀ) T`, on which `ℓ(trU z)` acts by the central character of `M⁻(μ)`, where
`Re(μ_p) + p` does not depend on `p`. Then every `x ∈ U(𝔤𝔩_n(ℂ))` with `x · T = 0` lies in the
left ideal generated by the `z - χ(z)`, `z` central, `χ` the central character of `T`.
See the paired Markdown.
-/

noncomputable section

open scoped Matrix

set_option autoImplicit false

namespace Langlands.Archimedean.SphericalKernel

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Algebra.UniversalEnveloping MvPolynomial VermaGL BGChase

universe uV

variable {n : ℕ}

local notation "gl" => Matrix (Fin n) (Fin n) ℂ

/-! ## Central characters -/

/-- The central character `z ↦ eval μ (γ(z))` of `M⁻(μ)`. -/
def chiV (μ : Fin n → ℂ) : center n →ₐ[ℂ] ℂ := (MvPolynomial.aeval μ).comp (VermaCentral.gamC n)

theorem chiV_apply (μ : Fin n → ℂ) (z : center n) :
    chiV μ z = eval μ (VermaCentral.gamC n z) := by
  simp [chiV]

theorem chiV_smul_gen (μ : Fin n → ℂ) (z : center n) :
    (z : glU n) • gen n μ = chiV μ z • gen n μ := by
  rw [chiV_apply]
  exact VermaCentral.eval_gamC_smul_gen n z μ

/-- The transpose anti-automorphism `trU`, restricted to the (commutative) center. -/
def trC : center n →ₐ[ℂ] center n where
  toFun z := ⟨trU (z : glU n), trU_mem_center z.2⟩
  map_one' := Subtype.ext trU_one
  map_mul' a b := Subtype.ext (by
    change trU ((a : glU n) * (b : glU n)) = trU (a : glU n) * trU (b : glU n)
    rw [trU_mul]
    exact Subalgebra.mem_center_iff.1 (trU_mem_center a.2) _)
  map_zero' := Subtype.ext (map_zero trU)
  map_add' a b := Subtype.ext (map_add trU (a : glU n) b)
  commutes' c := Subtype.ext (trU_algebraMap c)

theorem coe_trC (z : center n) : ((trC z : center n) : glU n) = trU (z : glU n) := rfl

theorem trC_trC (z : center n) : trC (trC z) = z := Subtype.ext (trU_trU (z : glU n))

/-- The left ideal generated by the `z - χ(z)`. -/
def kerSpan (χ : center n →ₐ[ℂ] ℂ) : Ideal (glU n) :=
  Ideal.span {x | ∃ z : center n, x = (z : glU n) - algebraMap ℂ (glU n) (χ z)}

/-- `trU` maps the ideal of `χ` into the ideal of `χ ∘ trC`. -/
theorem trU_mem_kerSpan (χ : center n →ₐ[ℂ] ℂ) {y : glU n} (hy : y ∈ kerSpan χ) :
    trU y ∈ kerSpan (χ.comp trC) := by
  suffices h : ∀ b, trU y * b ∈ kerSpan (χ.comp trC) by simpa using h 1
  induction hy using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨z, rfl⟩ := hx
    intro b
    have hmem : trU ((z : glU n) - algebraMap ℂ (glU n) (χ z)) ∈ kerSpan (χ.comp trC) := by
      refine Ideal.subset_span ⟨trC z, ?_⟩
      rw [map_sub, trU_algebraMap, coe_trC, AlgHom.comp_apply, trC_trC]
    have hc : trU ((z : glU n) - algebraMap ℂ (glU n) (χ z)) ∈ center n := by
      rw [map_sub, trU_algebraMap]
      exact Subalgebra.sub_mem _ (trU_mem_center z.2) (Subalgebra.algebraMap_mem _ _)
    rw [← Subalgebra.mem_center_iff.1 hc b]
    exact Ideal.mul_mem_left _ b hmem
  | zero => intro b; rw [map_zero, zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => intro b; rw [map_add, add_mul]; exact add_mem (hx b) (hy b)
  | smul a x _ hx =>
    intro b
    rw [smul_eq_mul, trU_mul, mul_assoc]
    exact hx _

/-! ## The transposed lower Verma ideal -/

/-- A subspace of `U` containing the `E_pq b` (`p < q`) and the `(E_pp - μ_p) b` contains
`trU(v) b` for every `v` in the ideal of `M⁻(μ)`. -/
theorem trU_mul_mem (μ : Fin n → ℂ) (S : Submodule ℂ (glU n))
    (h1 : ∀ p q : Fin n, p < q → ∀ b, unitU n p q * b ∈ S)
    (h2 : ∀ (p : Fin n) b, (unitU n p p - algebraMap ℂ (glU n) (μ p)) * b ∈ S)
    {v : glU n} (hv : v ∈ lowerVermaIdeal n μ) (b : glU n) : trU v * b ∈ S := by
  induction hv using Submodule.span_induction generalizing b with
  | mem x hx =>
    rcases hx with ⟨p, q, hqp, rfl⟩ | ⟨p, rfl⟩
    · rw [trU_ι, Matrix.transpose_single]
      exact h1 q p hqp b
    · rw [map_sub, trU_ι, Matrix.transpose_single, trU_algebraMap]
      exact h2 p b
  | zero => rw [map_zero, zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add, add_mul]; exact add_mem (hx b) (hy b)
  | smul a x _ hx =>
    rw [smul_eq_mul, trU_mul, mul_assoc]
    exact hx _

theorem sub_mem_lowerVermaIdeal (μ : Fin n → ℂ) (z : center n) :
    (z : glU n) - algebraMap ℂ (glU n) (chiV μ z) ∈ lowerVermaIdeal n μ := by
  rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, VermaPBW.mk_eq_smul_gen,
    VermaPBW.mk_eq_smul_gen, algebraMap_smul, chiV_smul_gen, sub_self]

/-! ## The orbit map -/

section Main

variable {V : Type uV} [AddCommGroup V] [Module ℂ V]

/-- The orbit map `u ↦ Λ_ℓ(u) T`. -/
def orbitMap (ℓ : gl →ₗ⁅ℂ⁆ Module.End ℂ V) (T : V) : glU n →ₗ[ℂ] V where
  toFun u := envelopingAction ℓ u T
  map_add' a b := by rw [map_add, LinearMap.add_apply]
  map_smul' c a := by rw [map_smul, LinearMap.smul_apply]; rfl

theorem orbitMap_apply (ℓ : gl →ₗ⁅ℂ⁆ Module.End ℂ V) (T : V) (u : glU n) :
    orbitMap ℓ T u = envelopingAction ℓ u T := rfl

/-- The enveloping actions of two commuting representations commute. -/
theorem env_comm (ℓ r : gl →ₗ⁅ℂ⁆ Module.End ℂ V) (hcomm : ∀ X Y, ℓ X * r Y = r Y * ℓ X)
    (a c : glU n) :
    envelopingAction ℓ a * envelopingAction r c = envelopingAction r c * envelopingAction ℓ a := by
  have h1 : ∀ Y, r Y * envelopingAction ℓ a = envelopingAction ℓ a * r Y := fun Y =>
    (env_commute ℓ (r Y) (fun X => hcomm X Y) a).symm
  exact (env_commute r (envelopingAction ℓ a) h1 c).symm

/-- If `ℓ(Y) T = r(Yᵀ) T`, then `Λ_ℓ(b) T = Λ_r(trU b) T`. -/
theorem env_left_eq_right (ℓ r : gl →ₗ⁅ℂ⁆ Module.End ℂ V) (hcomm : ∀ X Y, ℓ X * r Y = r Y * ℓ X)
    (T : V) (hκ : ∀ Y : gl, ℓ Y T = r Yᵀ T) (b : glU n) :
    envelopingAction ℓ b T = envelopingAction r (trU b) T := by
  induction b using InfinitesimalCharacter.envInduction with
  | algebraMap c => rw [trU_algebraMap, AlgHom.commutes, AlgHom.commutes]
  | ι x =>
    rw [trU_ι, UniversalEnvelopingAlgebra.lift_ι_apply, UniversalEnvelopingAlgebra.lift_ι_apply, hκ]
  | mul a b ha hb =>
    rw [trU_mul, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, hb, ← ha]
    exact LinearMap.congr_fun (env_comm ℓ r hcomm a (trU b)) T
  | add a b ha hb => rw [map_add, map_add, map_add, LinearMap.add_apply, LinearMap.add_apply, ha, hb]

/-- **Central character from a highest-weight functional.** If `α(T) = 1`, `α ∘ ℓ(E_pq) = 0`
(`p < q`), `α ∘ ℓ(E_pp) = μ_p α`, and central elements act on `T` by scalars, then `ℓ(trU z)` acts
on `T` by the central character of `M⁻(μ)`. -/
theorem env_trU_center_of_functional (ℓ : gl →ₗ⁅ℂ⁆ Module.End ℂ V) (T : V) (μ : Fin n → ℂ)
    (α : V →ₗ[ℂ] ℂ) (hαT : α T = 1)
    (hα1 : ∀ p q : Fin n, p < q → ∀ v, α (ℓ (Matrix.single p q 1) v) = 0)
    (hα2 : ∀ (p : Fin n) v, α (ℓ (Matrix.single p p 1) v) = μ p * α v)
    (hsc : ∀ z : center n, ∃ c : ℂ, envelopingAction ℓ (z : glU n) T = c • T)
    (z : center n) : envelopingAction ℓ (trU (z : glU n)) T = chiV μ z • T := by
  obtain ⟨c, hc⟩ := hsc (trC z)
  rw [coe_trC] at hc
  have hS := trU_mul_mem μ (LinearMap.ker (α ∘ₗ orbitMap ℓ T))
    (fun p q hpq b => by
      rw [LinearMap.mem_ker, LinearMap.comp_apply, orbitMap_apply, map_mul, Module.End.mul_apply,
        UniversalEnvelopingAlgebra.lift_ι_apply]
      exact hα1 p q hpq _)
    (fun p b => by
      rw [LinearMap.mem_ker, LinearMap.comp_apply, orbitMap_apply, sub_mul, map_sub, map_mul,
        LinearMap.sub_apply, Module.End.mul_apply, UniversalEnvelopingAlgebra.lift_ι_apply,
        map_sub, hα2, map_mul, AlgHom.commutes, Module.End.mul_apply,
        Module.algebraMap_end_apply, map_smul, smul_eq_mul, sub_self])
    (sub_mem_lowerVermaIdeal μ z) 1
  rw [mul_one, LinearMap.mem_ker, LinearMap.comp_apply, orbitMap_apply, map_sub, trU_algebraMap,
    map_sub, LinearMap.sub_apply, hc, AlgHom.commutes, Module.algebraMap_end_apply, map_sub,
    map_smul, map_smul, hαT, smul_eq_mul, smul_eq_mul, mul_one, mul_one, sub_eq_zero] at hS
  rw [hc, hS]

/-- **The kernel of the orbit map.** Let `ℓ`, `r` be commuting representations of `𝔤𝔩_n(ℂ)` on
`V`, `T ≠ 0` with `ℓ(Y) T = r(Yᵀ) T`, and `μ` with `Re(μ_p) + p` independent of `p`, such that
`ℓ(trU z)` acts on `T` by the central character of `M⁻(μ)`. If `x · T = 0`, then `x` lies in the
left ideal generated by the `z - χ(z)`, `χ = χ_μ ∘ trU` the central character of `T`. -/
theorem mem_kerSpan (ℓ r : gl →ₗ⁅ℂ⁆ Module.End ℂ V) (hcomm : ∀ X Y, ℓ X * r Y = r Y * ℓ X)
    (T : V) (hT0 : T ≠ 0) (hκ : ∀ Y : gl, ℓ Y T = r Yᵀ T) (μ : Fin n → ℂ)
    (hre : ∀ p q : Fin n, (μ p).re + ((p : ℕ) : ℝ) = (μ q).re + ((q : ℕ) : ℝ))
    (hcen : ∀ z : center n, envelopingAction ℓ (trU (z : glU n)) T = chiV μ z • T)
    {x : glU n} (hx : envelopingAction ℓ x T = 0) :
    x ∈ kerSpan ((chiV μ).comp trC) := by
  classical
  have hLR := env_left_eq_right ℓ r hcomm T hκ
  have hright : ∀ y b, envelopingAction ℓ y T = 0 → envelopingAction ℓ (y * b) T = 0 := by
    intro y b hy
    rw [map_mul, Module.End.mul_apply, hLR b, ← Module.End.mul_apply, env_comm ℓ r hcomm,
      Module.End.mul_apply, hy, map_zero]
  have hleft : ∀ a y, envelopingAction ℓ y T = 0 → envelopingAction ℓ (a * y) T = 0 := by
    intro a y hy
    rw [map_mul, Module.End.mul_apply, hy, map_zero]
  set Φ := orbitMap ℓ T with hΦdef
  have hΦ : ∀ u, Φ u = envelopingAction ℓ u T := fun u => rfl
  set V' := LinearMap.range Φ with hV'
  have hSℓ : ∀ Y, ∀ s ∈ V', ℓ Y s ∈ V' := by
    rintro Y _ ⟨u, rfl⟩
    refine ⟨UniversalEnvelopingAlgebra.ι ℂ Y * u, ?_⟩
    rw [hΦ, hΦ, map_mul, Module.End.mul_apply, UniversalEnvelopingAlgebra.lift_ι_apply]
  have hSr : ∀ Y, ∀ s ∈ V', r Y s ∈ V' := by
    rintro Y _ ⟨u, rfl⟩
    refine ⟨u * UniversalEnvelopingAlgebra.ι ℂ Yᵀ, ?_⟩
    rw [hΦ, hΦ, map_mul, Module.End.mul_apply, UniversalEnvelopingAlgebra.lift_ι_apply, hκ,
      Matrix.transpose_transpose]
    exact LinearMap.congr_fun (env_commute ℓ (r Y) (fun X => hcomm X Y) u) T
  set ℓ' := restrictLie ℓ V' hSℓ with hℓ'
  set r' := restrictLie r V' hSr with hr'
  have hcomm' : ∀ X Y, ℓ' X * r' Y = r' Y * ℓ' X := by
    intro X Y
    refine LinearMap.ext fun s => Subtype.ext ?_
    exact LinearMap.congr_fun (hcomm X Y) s
  have henv' : ∀ u (s : V'), ((envelopingAction ℓ' u s : V') : V) = envelopingAction ℓ u s :=
    fun u s => env_intertwine ℓ' ℓ V'.subtype (fun _ _ => rfl) u s
  have hTmem : T ∈ V' := ⟨1, by rw [hΦ, map_one, Module.End.one_apply]⟩
  set T' : V' := ⟨T, hTmem⟩ with hT'
  have hT'0 : T' ≠ 0 := fun h => hT0 (congrArg Subtype.val h)
  have hκ' : ∀ Y : gl, ℓ' Y T' = r' Yᵀ T' := fun Y => Subtype.ext (hκ Y)
  set E : Submodule ℂ V' := Submodule.span ℂ {T'} with hE
  have hE0 : E ≠ ⊥ := by
    rw [hE, Ne, Submodule.span_singleton_eq_bot]
    exact hT'0
  have hstable : ∀ Y : gl, ∀ e ∈ E, ℓ' Y e - r' Yᵀ e ∈ E := by
    intro Y e he
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 he
    rw [map_smul, map_smul, hκ', sub_self]
    exact zero_mem _
  have hW : E ≤ Submodule.span ℂ {e | e ∈ E ∧ ∃ m : Fin n → ℤ, ∀ p : Fin n,
      ℓ' (Matrix.single p p 1) e - r' (Matrix.single p p 1) e = (m p : ℂ) • e} := by
    refine Submodule.span_le.2 ?_
    rintro _ rfl
    refine Submodule.subset_span ⟨Submodule.mem_span_singleton_self _, 0, fun p => ?_⟩
    have h := hκ' (Matrix.single p p 1)
    rw [Matrix.transpose_single] at h
    rw [h, sub_self, Pi.zero_apply, Int.cast_zero, zero_smul]
  have hgen : ∀ S : Submodule ℂ V', E ≤ S → (∀ X, ∀ s ∈ S, ℓ' X s ∈ S) → S = ⊤ := by
    intro S hES hSℓ'
    have hpres : ∀ u, ∀ s ∈ S, envelopingAction ℓ' u s ∈ S := by
      intro u
      induction u using InfinitesimalCharacter.envInduction with
      | algebraMap c =>
        intro s hs
        rw [AlgHom.commutes, Module.algebraMap_end_apply]
        exact S.smul_mem c hs
      | ι x =>
        intro s hs
        rw [UniversalEnvelopingAlgebra.lift_ι_apply]
        exact hSℓ' x s hs
      | mul a b ha hb =>
        intro s hs
        rw [map_mul, Module.End.mul_apply]
        exact ha _ (hb s hs)
      | add a b ha hb =>
        intro s hs
        rw [map_add, LinearMap.add_apply]
        exact S.add_mem (ha s hs) (hb s hs)
    rw [eq_top_iff]
    rintro ⟨_, u, rfl⟩ -
    have h1 : envelopingAction ℓ' u T' ∈ S :=
      hpres u T' (hES (Submodule.mem_span_singleton_self _))
    have h2 : envelopingAction ℓ' u T' = ⟨Φ u, u, rfl⟩ := Subtype.ext (henv' u T')
    rwa [h2] at h1
  have hχR : ∀ z : center n, rhoR ℓ' z = algebraMap ℂ (Module.End ℂ V') (chiV μ z) := by
    intro z
    refine LinearMap.ext fun s => Subtype.ext ?_
    obtain ⟨_, u, rfl⟩ := s
    have hzc := Subalgebra.mem_center_iff.1 (trU_mem_center z.2) u
    rw [rhoR_apply, henv', Module.algebraMap_end_apply, Submodule.coe_smul]
    change envelopingAction ℓ (trU (z : glU n)) (Φ u) = chiV μ z • Φ u
    rw [hΦ, ← Module.End.mul_apply, ← map_mul, ← hzc, map_mul, Module.End.mul_apply, hcen,
      map_smul]
  have hne := wtSpan_ne_top ℓ' r' hcomm' E inferInstance hE0 hstable hW hgen μ
    (VermaSimple.isZExtremal_of_re hre) (chiV μ) hχR (chiV_smul_gen μ)
  set S : Submodule ℂ (glU n) := (Submodule.map V'.subtype (wtSpan ℓ' μ)).comap Φ with hSdef
  have hS : ∀ v ∈ lowerVermaIdeal n μ, ∀ b, trU v * b ∈ S := by
    intro v hv b
    refine trU_mul_mem μ S ?_ ?_ hv b
    · intro p q hpq c
      refine Submodule.mem_comap.2 (Submodule.mem_map.2 ⟨ℓ' (Matrix.single p q 1) ⟨Φ c, c, rfl⟩,
        Submodule.subset_span (Or.inl ⟨p, q, _, hpq, rfl⟩), ?_⟩)
      show ℓ (Matrix.single p q 1) (Φ c) = Φ (unitU n p q * c)
      rw [hΦ, hΦ, map_mul, Module.End.mul_apply, UniversalEnvelopingAlgebra.lift_ι_apply]
    · intro p c
      refine Submodule.mem_comap.2 (Submodule.mem_map.2 ⟨ℓ' (Matrix.single p p 1) ⟨Φ c, c, rfl⟩ -
        μ p • ⟨Φ c, c, rfl⟩, Submodule.subset_span (Or.inr ⟨p, _, rfl⟩), ?_⟩)
      show ℓ (Matrix.single p p 1) (Φ c) - μ p • Φ c =
        Φ ((unitU n p p - algebraMap ℂ (glU n) (μ p)) * c)
      rw [hΦ, hΦ, sub_mul, map_sub, map_mul, LinearMap.sub_apply, Module.End.mul_apply,
        UniversalEnvelopingAlgebra.lift_ι_apply, map_mul, AlgHom.commutes,
        Module.End.mul_apply, Module.algebraMap_end_apply]
  let N : Submodule (glU n) (LowerVerma n μ) :=
    { carrier := {m | ∃ y, envelopingAction ℓ y T = 0 ∧ trU y • gen n μ = m}
      add_mem' := by
        rintro _ _ ⟨y₁, h₁, rfl⟩ ⟨y₂, h₂, rfl⟩
        exact ⟨y₁ + y₂, by rw [map_add, LinearMap.add_apply, h₁, h₂, add_zero], by
          rw [map_add, add_smul]⟩
      zero_mem' := ⟨0, by rw [map_zero, LinearMap.zero_apply], by rw [map_zero, zero_smul]⟩
      smul_mem' := by
        rintro a _ ⟨y, hy, rfl⟩
        refine ⟨y * trU a, hright y _ hy, ?_⟩
        rw [trU_mul, trU_trU, mul_smul] }
  have hgenN : gen n μ ∉ N := by
    rintro ⟨y, hy, hgy⟩
    have hmem : 1 - trU y ∈ lowerVermaIdeal n μ := by
      rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, VermaPBW.mk_eq_smul_gen,
        VermaPBW.mk_eq_smul_gen, one_smul, hgy, sub_self]
    apply hne
    rw [eq_top_iff]
    rintro ⟨_, b, rfl⟩ -
    obtain ⟨w, hw, hwb⟩ := Submodule.mem_map.1 (Submodule.mem_comap.1 (hS _ hmem b))
    have hval : Φ (trU (1 - trU y) * b) = Φ b := by
      rw [map_sub, trU_one, trU_trU, sub_mul, one_mul, map_sub, hΦ (y * b), hright y b hy,
        sub_zero]
    have hwe : w = ⟨Φ b, b, rfl⟩ := Subtype.ext (hwb.trans hval)
    rwa [hwe] at hw
  have hN : N = ⊥ := VermaSimple.eq_bot_of_gen_not_mem hre N hgenN
  have hact : envelopingAction (action n μ) (trU x) = 0 := by
    refine LinearMap.ext fun m => ?_
    obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
    rw [envelopingAction_action, VermaPBW.mk_eq_smul_gen, smul_smul, LinearMap.zero_apply]
    have hm : (trU x * u) • gen n μ ∈ N :=
      ⟨trU u * x, hleft _ _ hx, by rw [trU_mul, trU_trU]⟩
    rw [hN] at hm
    exact (Submodule.mem_bot _).1 hm
  have h1 := mem_span_of_action_eq_zero VermaPBW.lowerVermaWeight VermaPBW.lowerVermaDuflo
    (chiV μ) (chiV_smul_gen μ) hact
  have h2 := trU_mem_kerSpan (chiV μ) h1
  rwa [trU_trU] at h2

end Main

/-- **Statement (the kernel of the orbit map).** Let `ℓ`, `r` be commuting Lie algebra actions of
`𝔤𝔩_n(ℂ)` on a complex vector space `V`, and `T ≠ 0` a vector with `ℓ(Y) T = r(Yᵀ) T` for all `Y`.
Let `μ : Fin n → ℂ` be such that `Re(μ_p) + p` does not depend on `p`, and suppose `ℓ(trU z)` acts
on `T` by the central character `chiV μ z` of `M⁻(μ)` for every central `z`. If `x ∈ U(𝔤𝔩_n(ℂ))`
satisfies `x · T = 0`, then `x` lies in the left ideal generated by the `z - χ(z)`, `z` central,
where `χ = chiV μ ∘ trC`. -/
def SphericalKernelStatement : Prop :=
  ∀ (n : ℕ) (V : Type uV) [AddCommGroup V] [Module ℂ V]
    (ℓ r : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ V),
    (∀ X Y, ℓ X * r Y = r Y * ℓ X) →
    ∀ T : V, T ≠ 0 → (∀ Y : Matrix (Fin n) (Fin n) ℂ, ℓ Y T = r Yᵀ T) →
    ∀ μ : Fin n → ℂ, (∀ p q : Fin n, (μ p).re + ((p : ℕ) : ℝ) = (μ q).re + ((q : ℕ) : ℝ)) →
    (∀ z : center n, envelopingAction ℓ (trU (z : glU n)) T = chiV μ z • T) →
    ∀ x : glU n, envelopingAction ℓ x T = 0 → x ∈ kerSpan ((chiV μ).comp trC)

theorem sphericalKernel : SphericalKernelStatement.{uV} :=
  fun _ _ _ _ ℓ r hcomm T hT0 hκ μ hre hcen _ hx => mem_kerSpan ℓ r hcomm T hT0 hκ μ hre hcen hx

end Langlands.Archimedean.SphericalKernel
