import Langlands.Representation.Archimedean.GLSymbolTransport

/-!
# Kostant's multiplicity theorem for `𝔤𝔩_n(ℂ)` at every central character

Let `σ` be a finite-dimensional representation of `𝔤𝔩_n(ℂ)` on `W` with integral weights. For
every character `χ` of the center of `U = U(𝔤𝔩_n(ℂ))` we construct `d = dim W₀` covariants
`f_i : W → U` (`f_i(σ(Y) w) = [Y, f_i(w)]`) whose images modulo the left ideal `K_χ` generated by
the `z - χ(z)` are linearly independent, assuming that every `χ` is the central character of a
lower Verma module (`VermaGL.CentralCharacterStatement`).

The construction is uniform in `χ`. For each degree `N` let `Cov N` be the space of covariants
with values in `U_N`, and `τ_N(f) = (w ↦ σ_N(f(w))(ψ))` the evaluation of the degree-`N` symbols at
the Whittaker point `ψ`. Choose covariants `g_{N,i} ∈ Cov N` whose images under `τ_N` form a basis
of `τ_N(Cov N)`.

* `allCov_indep` (independence): if `χ` is the central character of `M⁻(λ)`, the `g_{N,i}`
  (`N ≤ N_max`) are linearly independent modulo `K_χ`. The left ideal `K_χ` acts by zero on
  `M⁻(λ)`, so by Matumoto's lemma the top-degree symbols of a combination in `K_χ` vanish at `ψ`.
* `exists_mem_span` (spanning): for every `χ`, every covariant with values in `U_N + K_χ`,
  `N ≤ N_max`, is congruent modulo `K_χ` to a combination of the `g_{N',i}`. After subtracting a
  combination of the `g_{N,i}`, the symbols of degree `N` span a coadjoint-stable space vanishing
  at `ψ`; by Kostant's orbit and nilpotent cone theorems they lie in the ideal of the nilpotent
  cone, so the covariant lies in `U_{N-1} + K_χ`; `exists_cov_lift` lifts it back to a covariant
  with values in `U_{N-1}`.
* `kostantMultiplicity_of_central`: comparing with the `d` covariants of `exists_kostantOne`
  (independent modulo `K_{χ₀}`, spanned modulo `K_{χ₀}` by the `g_{N,i}`) shows that there are at
  least `d` of the `g_{N,i}`; these are independent modulo every `K_χ`.
-/

noncomputable section

set_option autoImplicit false

-- Entries of tuples of matrices are applied through the `Matrix` definition.
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

namespace GLReynolds

universe uW

open Langlands.Algebra.UniversalEnveloping MvPolynomial Module

variable {n : ℕ}

local notation "Fil" N:max => degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N
local notation "ιU" => UniversalEnvelopingAlgebra.ι ℂ

/-! ### Covariants -/

section Covariant

variable {W : Type*} [AddCommGroup W] [Module ℂ W]
  {σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W}

variable (σ) in
/-- Covariance: `f(σ(Y) w) = [Y, f(w)]`. -/
def IsCov (f : W →ₗ[ℂ] VermaGL.glU n) : Prop :=
  ∀ Y w, f (σ Y w) = ιU Y * f w - f w * ιU Y

/-- Covariance follows from covariance under the matrix units. -/
theorem isCov_of_single {f : W →ₗ[ℂ] VermaGL.glU n}
    (h : ∀ p q w, f (σ (Matrix.single p q (1 : ℂ)) w) =
      ιU (Matrix.single p q (1 : ℂ)) * f w - f w * ιU (Matrix.single p q (1 : ℂ))) :
    IsCov σ f := by
  intro Y w
  induction Y using Matrix.induction_on' with
  | h_zero => simp
  | h_add Y₁ Y₂ h₁ h₂ =>
    rw [map_add σ, LinearMap.add_apply, map_add f, h₁, h₂,
      map_add (UniversalEnvelopingAlgebra.ι ℂ)]
    noncomm_ring
  | h_std_basis i j c =>
    have hc : Matrix.single i j c = c • Matrix.single i j (1 : ℂ) := by
      rw [Matrix.smul_single, smul_eq_mul, mul_one]
    rw [hc, map_smul σ, LinearMap.smul_apply, map_smul f, h,
      map_smul (UniversalEnvelopingAlgebra.ι ℂ), smul_mul_assoc, mul_smul_comm, smul_sub]

variable (σ) in
/-- The covariants with values in `U_N`. -/
def Cov (N : ℕ) : Submodule ℂ (W →ₗ[ℂ] VermaGL.glU n) where
  carrier := {f | IsCov σ f ∧ ∀ w, f w ∈ Fil N}
  add_mem' := by
    rintro f g ⟨hf, hf'⟩ ⟨hg, hg'⟩
    refine ⟨fun Y w => ?_, fun w => Submodule.add_mem _ (hf' w) (hg' w)⟩
    rw [LinearMap.add_apply, LinearMap.add_apply, hf, hg]
    noncomm_ring
  zero_mem' := ⟨fun Y w => by simp, fun w => Submodule.zero_mem _⟩
  smul_mem' := by
    rintro c f ⟨hf, hf'⟩
    refine ⟨fun Y w => ?_, fun w => Submodule.smul_mem _ c (hf' w)⟩
    rw [LinearMap.smul_apply, LinearMap.smul_apply, hf, smul_sub, mul_smul_comm, smul_mul_assoc]

theorem mem_Cov {N : ℕ} {f : W →ₗ[ℂ] VermaGL.glU n} :
    f ∈ Cov σ N ↔ IsCov σ f ∧ ∀ w, f w ∈ Fil N := Iff.rfl

/-- A linear map from a finite-dimensional space has values in some `U_N`. -/
theorem exists_degree_bound [FiniteDimensional ℂ W] (f : W →ₗ[ℂ] VermaGL.glU n) :
    ∃ N, ∀ w, f w ∈ Fil N := by
  classical
  set b := Module.finBasis ℂ W
  choose d hd using fun j => exists_mem_degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) (f (b j))
  refine ⟨Finset.univ.sup d, fun w => ?_⟩
  rw [← b.sum_repr w, map_sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  rw [map_smul]
  exact Submodule.smul_mem _ _
    (degreeFiltration_mono ℂ _ (Finset.le_sup (Finset.mem_univ j)) (hd j))

end Covariant

/-! ### Lifting covariants modulo the central ideal -/

section Lift

variable {W : Type*} [AddCommGroup W] [Module ℂ W]
  {σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W}

/-- The left ideal `K_χ` is stable under the adjoint action. -/
theorem adU_mem_cenIdeal (χ : VermaGL.center n →ₐ[ℂ] ℂ) (Y : Matrix (Fin n) (Fin n) ℂ)
    {x : VermaGL.glU n} (hx : x ∈ cenIdeal χ) : ιU Y * x - x * ιU Y ∈ cenIdeal χ := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨z, rfl⟩ := hx
    have h : ιU Y * ((z : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (χ z)) -
        ((z : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (χ z)) * ιU Y = 0 := by
      rw [mul_sub, sub_mul, Subalgebra.mem_center_iff.mp z.2 (ιU Y), Algebra.commutes]
      abel
    rw [h]
    exact Submodule.zero_mem _
  | zero => simp
  | add x y _ _ hx hy =>
    have h : ιU Y * (x + y) - (x + y) * ιU Y = (ιU Y * x - x * ιU Y) + (ιU Y * y - y * ιU Y) := by
      noncomm_ring
    rw [h]
    exact Submodule.add_mem _ hx hy
  | smul a x hx' ih =>
    have h : ιU Y * (a • x) - (a • x) * ιU Y =
        (ιU Y * a - a * ιU Y) * x + a * (ιU Y * x - x * ιU Y) := by
      rw [smul_eq_mul]
      noncomm_ring
    rw [h]
    exact Submodule.add_mem _ (Ideal.mul_mem_left _ _ hx') (Ideal.mul_mem_left _ _ ih)

/-- **Lifting covariants modulo `K_χ`.** A covariant `f` with values in `U_M + K_χ` is congruent
modulo `K_χ` to a covariant with values in `U_M`. -/
theorem exists_cov_lift [FiniteDimensional ℂ W] (hσ : VermaGL.HasIntegralWeights σ)
    (χ : VermaGL.center n →ₐ[ℂ] ℂ) (M : ℕ) {f : W →ₗ[ℂ] VermaGL.glU n} (hf : IsCov σ f)
    (hfM : ∀ w, ∃ u ∈ Fil M, f w - u ∈ cenIdeal χ) :
    ∃ g ∈ Cov σ M, ∀ w, f w - g w ∈ cenIdeal χ := by
  classical
  set S : Submodule ℂ (VermaGL.glU n) := Fil M with hS_def
  have hS : ∀ Y, ∀ s ∈ S, BGChase.adU Y s ∈ S := fun Y _ hs =>
    BGChase.adU_mem_degreeFiltration Y hs
  set τ := BGChase.restrictLie BGChase.adU S hS with hτ_def
  have hτ : BGChase.intSpan (BGChase.diagOps τ) = ⊤ :=
    BGChase.intSpan_restrictLie_of_le S hS (by rw [BGChase.intSpan_adU]; exact le_top)
  have hH : VermaGL.HasIntegralWeights (BGChase.homLie σ τ) := BGChase.intSpan_homLie hσ hτ
  set K : Submodule ℂ S := ((cenIdeal χ).restrictScalars ℂ).comap S.subtype with hK_def
  have hτapp : ∀ p q (s : S), ((famOf τ p q s : S) : VermaGL.glU n) =
      ιU (Matrix.single p q (1 : ℂ)) * s - s * ιU (Matrix.single p q (1 : ℂ)) :=
    fun p q s => BGChase.adU_apply _ _
  have hK : ∀ p q, K ≤ K.comap (famOf τ p q) := by
    intro p q s hs
    have hs' : (s : VermaGL.glU n) ∈ cenIdeal χ := hs
    change ((famOf τ p q s : S) : VermaGL.glU n) ∈ cenIdeal χ
    rw [hτapp]
    exact adU_mem_cenIdeal χ _ hs'
  set φ : (W →ₗ[ℂ] S) →ₗ[ℂ] (W →ₗ[ℂ] S ⧸ K) := LinearMap.llcomp ℂ W S (S ⧸ K) K.mkQ
    with hφ_def
  have hφ : Function.Surjective φ := (Submodule.mkQ_surjective K).surjective_linearMapComp_left
  have hφ_apply : ∀ x w, φ x w = Submodule.Quotient.mk (x w) := fun x w => rfl
  have hφe : ∀ p q x, φ (famOf (BGChase.homLie σ τ) p q x) =
      homFam (famOf σ) (qFam K hK) p q (φ x) := by
    intro p q x
    refine LinearMap.ext fun w => ?_
    simp only [homFam_apply, hφ_apply, qFam_mk]
    rw [← Submodule.Quotient.mk_sub]
    rfl
  -- a linear representative `x₀` of `f` modulo `K_χ` with values in `U_M`
  set b := Module.finBasis ℂ W
  choose u hu hu' using fun j => hfM (b j)
  obtain ⟨x₀, hx₀b⟩ : ∃ x₀ : W →ₗ[ℂ] S, ∀ j, x₀ (b j) = ⟨u j, hu j⟩ :=
    ⟨b.constr ℂ fun j => ⟨u j, hu j⟩, fun j => b.constr_basis ℂ _ j⟩
  have hx₀ : ∀ w, f w - (x₀ w : VermaGL.glU n) ∈ cenIdeal χ := by
    intro w
    have h1 : f w - (x₀ w : VermaGL.glU n) = ∑ j, b.repr w j • (f (b j) - u j) := by
      conv_lhs => rw [← b.sum_repr w]
      rw [map_sum, map_sum, Submodule.coe_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_smul, map_smul, hx₀b, Submodule.coe_smul, smul_sub]
    rw [h1]
    exact Submodule.sum_mem _ fun j _ => Submodule.smul_of_tower_mem _ _ (hu' j)
  -- the class of `x₀` is invariant
  have hy : ∀ p q, homFam (famOf σ) (qFam K hK) p q (φ x₀) = 0 := by
    intro p q
    refine LinearMap.ext fun w => ?_
    simp only [homFam_apply, hφ_apply, qFam_mk, LinearMap.zero_apply]
    rw [← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero]
    change ((famOf τ p q (x₀ w) - x₀ (famOf σ p q w) : S) : VermaGL.glU n) ∈ cenIdeal χ
    rw [Submodule.coe_sub, hτapp, famOf_apply]
    have e1 := adU_mem_cenIdeal χ (Matrix.single p q (1 : ℂ)) (hx₀ w)
    have e2 := hx₀ (σ (Matrix.single p q (1 : ℂ)) w)
    rw [hf] at e2
    have heq : ιU (Matrix.single p q (1 : ℂ)) * (x₀ w : VermaGL.glU n) -
        (x₀ w : VermaGL.glU n) * ιU (Matrix.single p q (1 : ℂ)) -
        (x₀ (σ (Matrix.single p q (1 : ℂ)) w) : VermaGL.glU n) =
        -((ιU (Matrix.single p q (1 : ℂ)) * (f w - x₀ w) -
            (f w - x₀ w) * ιU (Matrix.single p q (1 : ℂ))) -
          (ιU (Matrix.single p q (1 : ℂ)) * f w - f w * ιU (Matrix.single p q (1 : ℂ)) -
            x₀ (σ (Matrix.single p q (1 : ℂ)) w))) := by
      noncomm_ring
    rw [heq]
    exact Submodule.neg_mem _ (Submodule.sub_mem _ e1 e2)
  obtain ⟨x, hx, hφx⟩ :=
    exists_invariant_lift (isGlFamily_famOf _) (intWeights_famOf hH) φ hφ hφe hy
  refine ⟨S.subtype ∘ₗ x, ⟨isCov_of_single fun p q w => ?_, fun w => (x w).2⟩, fun w => ?_⟩
  · have h := LinearMap.congr_fun (hx p q) w
    rw [famOf_apply, BGChase.homLie_apply, LinearMap.zero_apply, sub_eq_zero] at h
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.subtype_apply]
    rw [← h]
    exact BGChase.adU_apply _ _
  · have h := LinearMap.congr_fun hφx w
    rw [hφ_apply, hφ_apply, Submodule.Quotient.eq] at h
    have h' : ((x w - x₀ w : S) : VermaGL.glU n) ∈ cenIdeal χ := h
    have heq : f w - (S.subtype ∘ₗ x) w =
        (f w - x₀ w) - ((x w - x₀ w : S) : VermaGL.glU n) := by
      simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.subtype_apply,
        Submodule.coe_sub]
      abel
    rw [heq]
    exact Submodule.sub_mem _ (hx₀ w) h'

end Lift

/-! ### Symbols at the Whittaker point -/

section Top

variable {W : Type*} [AddCommGroup W] [Module ℂ W]
  {σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W}

variable (n) in
/-- Evaluation at the Whittaker point `ψ`. -/
def evPsi : MvPolynomial (Kostant.Coord (nU n)) ℂ →ₗ[ℂ] ℂ := (aeval (psiPt n)).toLinearMap

theorem evPsi_apply (p : MvPolynomial (Kostant.Coord (nU n)) ℂ) :
    evPsi n p = eval (psiPt n) p := rfl

/-- `τ_N(f) = (w ↦ σ_N(f(w))(ψ))`. -/
def tauMap (N : ℕ) : (W →ₗ[ℂ] VermaGL.glU n) →ₗ[ℂ] Module.Dual ℂ W :=
  LinearMap.llcomp ℂ W (VermaGL.glU n) ℂ (evPsi n ∘ₗ symb n N)

theorem tauMap_apply (N : ℕ) (f : W →ₗ[ℂ] VermaGL.glU n) (w : W) :
    tauMap N f w = evPsi n (symb n N (f w)) := rfl

variable (σ) in
/-- The space `τ_N(Cov N)` of top-degree symbol values at `ψ`. -/
def topSpace (N : ℕ) : Submodule ℂ (Module.Dual ℂ W) := (Cov σ N).map (tauMap N)

variable [FiniteDimensional ℂ W]

variable (σ) in
/-- The dimension of `τ_N(Cov N)`. -/
abbrev topRank (N : ℕ) : ℕ := finrank ℂ (topSpace σ N)

variable (σ) in
/-- A basis of `τ_N(Cov N)`. -/
def topBasis (N : ℕ) : Basis (Fin (topRank σ N)) ℂ (topSpace σ N) :=
  Module.finBasis ℂ (topSpace σ N)

variable (σ) in
/-- Covariants `g_{N,i} ∈ Cov N` with `τ_N(g_{N,i})` the basis `topBasis σ N`. -/
def topCov (N : ℕ) (i : Fin (topRank σ N)) : W →ₗ[ℂ] VermaGL.glU n :=
  (Submodule.mem_map.mp (topBasis σ N i).2).choose

variable (σ) in
theorem topCov_mem (N : ℕ) (i : Fin (topRank σ N)) : topCov σ N i ∈ Cov σ N :=
  (Submodule.mem_map.mp (topBasis σ N i).2).choose_spec.1

variable (σ) in
theorem tauMap_topCov (N : ℕ) (i : Fin (topRank σ N)) :
    tauMap N (topCov σ N i) = (topBasis σ N i : Module.Dual ℂ W) :=
  (Submodule.mem_map.mp (topBasis σ N i).2).choose_spec.2

variable (σ) in
/-- The index set `{(N, i) : N ≤ N_max, i < dim τ_N(Cov N)}`. -/
abbrev CovIdx (Nmax : ℕ) : Type := Σ N : Fin (Nmax + 1), Fin (topRank σ N)

variable (σ) in
/-- All the covariants `g_{N,i}`, `N ≤ N_max`. -/
def allCov (Nmax : ℕ) (k : CovIdx σ Nmax) : W →ₗ[ℂ] VermaGL.glU n := topCov σ k.1 k.2

variable (σ) in
theorem allCov_mem (Nmax : ℕ) (k : CovIdx σ Nmax) : allCov σ Nmax k ∈ Cov σ k.1 :=
  topCov_mem σ k.1 k.2

/-- Subtracting a combination of the `g_{N,i}` makes `τ_N` vanish. -/
theorem exists_sub_tau_zero {N : ℕ} {f : W →ₗ[ℂ] VermaGL.glU n} (hf : f ∈ Cov σ N) :
    ∃ h ∈ Submodule.span ℂ (Set.range (topCov σ N)), f - h ∈ Cov σ N ∧ tauMap N (f - h) = 0 := by
  obtain ⟨e, he⟩ : ∃ e : topSpace σ N, (e : Module.Dual ℂ W) = tauMap N f :=
    ⟨⟨_, Submodule.mem_map_of_mem hf⟩, rfl⟩
  refine ⟨∑ i, (topBasis σ N).repr e i • topCov σ N i,
    Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩),
    Submodule.sub_mem _ hf
      (Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (topCov_mem σ N i)), ?_⟩
  have h' := congrArg (fun x : topSpace σ N => (x : Module.Dual ℂ W))
    ((topBasis σ N).sum_repr e)
  simp only [Submodule.coe_sum, Submodule.coe_smul] at h'
  rw [map_sub, map_sum]
  simp only [map_smul, tauMap_topCov]
  rw [h', he, sub_self]

omit [FiniteDimensional ℂ W] in
/-- In degree `0`, `τ_0` is injective on `Cov 0`. -/
theorem eq_zero_of_tau_zero {f : W →ₗ[ℂ] VermaGL.glU n} (hf : f ∈ Cov σ 0)
    (ht : tauMap 0 f = 0) (w : W) : f w = 0 := by
  have h0 := (mem_Cov.mp hf).2 w
  rw [degreeFiltration_zero] at h0
  obtain ⟨c, hc⟩ := Submodule.mem_one.mp h0
  have h := LinearMap.congr_fun ht w
  rw [tauMap_apply, ← hc, symb_zero_algebraMap, evPsi_apply, eval_C, LinearMap.zero_apply] at h
  rw [← hc, h, map_zero]

omit [FiniteDimensional ℂ W] in
/-- **Reduction of degree.** If `f ∈ Cov (M+1)` and `τ_{M+1}(f) = 0`, then `f` has values in
`U_M + K_χ`, for every `χ`. -/
theorem exists_lower_of_tau_zero (χ : VermaGL.center n →ₐ[ℂ] ℂ) {M : ℕ}
    {f : W →ₗ[ℂ] VermaGL.glU n} (hf : f ∈ Cov σ (M + 1)) (ht : tauMap (M + 1) f = 0) (w : W) :
    ∃ u ∈ Fil M, f w - u ∈ cenIdeal χ := by
  obtain ⟨hfc, hfN⟩ := mem_Cov.mp hf
  set Ssp : Submodule ℂ (MvPolynomial (Kostant.Coord (nU n)) ℂ) :=
    LinearMap.range (symb n (M + 1) ∘ₗ f) with hSsp
  have hstab : ∀ (i : Unit) (a b : Fin (nU n i)), a ≠ b → ∀ g ∈ Ssp,
      Kostant.coadDer ℂ (nU n) (Kostant.unit ℂ (nU n) i a b) g ∈ Ssp := by
    rintro ⟨⟩ a b - _ ⟨v, rfl⟩
    refine ⟨σ (Matrix.single a b (1 : ℂ)) v, ?_⟩
    simp only [LinearMap.coe_comp, Function.comp_apply]
    rw [hfc (Matrix.single a b (1 : ℂ)) v, ← coadDer_symb _ (hfN v), unitEquiv_single]
  have hvan : ∀ g ∈ Ssp, eval (fun v : Kostant.Coord (nU n) =>
      if (v.2.2 : ℕ) = v.2.1 + 1 then (fun (_ : Unit) (_ : Fin n) => (1 : ℂ)) v.1 v.2.1 else 0)
        g = 0 := by
    rintro _ ⟨v, rfl⟩
    have h := LinearMap.congr_fun ht v
    rw [tauMap_apply, evPsi_apply, LinearMap.zero_apply] at h
    exact h
  have hnil := Kostant.orbitVanishing (nU n) Ssp hstab (fun _ _ => 1)
    (fun _ _ _ => one_ne_zero) hvan _ ⟨w, rfl⟩
  have hK := Kostant.nilpotentConeIdeal (nU n) _ hnil
  obtain ⟨R, hR, hPR⟩ := exists_sub_mem_of_symb χ (hfN w) hK
  exact ⟨f w - R, hPR, by rw [sub_sub_cancel]; exact hR⟩

end Top

/-! ### Spanning and independence -/

section Main

variable {W : Type*} [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
  {σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W}

/-- **Spanning.** For every `χ`, a covariant with values in `U_N + K_χ`, `N ≤ N_max`, is
congruent modulo `K_χ` to a combination of the `g_{N',i}`, `N' ≤ N_max`. -/
theorem exists_mem_span (hσ : VermaGL.HasIntegralWeights σ) (χ : VermaGL.center n →ₐ[ℂ] ℂ)
    (Nmax : ℕ) : ∀ N ≤ Nmax, ∀ f : W →ₗ[ℂ] VermaGL.glU n, IsCov σ f →
      (∀ w, ∃ u ∈ Fil N, f w - u ∈ cenIdeal χ) →
      ∃ h ∈ Submodule.span ℂ (Set.range (allCov σ Nmax)), ∀ w, f w - h w ∈ cenIdeal χ := by
  have hle : ∀ N ≤ Nmax, Submodule.span ℂ (Set.range (topCov σ N)) ≤
      Submodule.span ℂ (Set.range (allCov σ Nmax)) := by
    intro N hN
    apply Submodule.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨⟨⟨N, by omega⟩, i⟩, rfl⟩
  intro N
  induction N with
  | zero =>
    intro hN f hf hfN
    obtain ⟨f₁, hf₁, hff₁⟩ := exists_cov_lift hσ χ 0 hf hfN
    obtain ⟨h, hh, hf₂, ht⟩ := exists_sub_tau_zero hf₁
    refine ⟨h, hle 0 hN hh, fun w => ?_⟩
    have h0 := eq_zero_of_tau_zero hf₂ ht w
    rw [LinearMap.sub_apply, sub_eq_zero] at h0
    rw [← h0]
    exact hff₁ w
  | succ M ih =>
    intro hN f hf hfN
    obtain ⟨f₁, hf₁, hff₁⟩ := exists_cov_lift hσ χ (M + 1) hf hfN
    obtain ⟨h, hh, hf₂, ht⟩ := exists_sub_tau_zero hf₁
    obtain ⟨h₂, hh₂, hf₂h₂⟩ := ih (by omega) (f₁ - h) (mem_Cov.mp hf₂).1
      (exists_lower_of_tau_zero χ hf₂ ht)
    refine ⟨h₂ + h, Submodule.add_mem _ hh₂ (hle _ hN hh), fun w => ?_⟩
    have heq : f w - (h₂ + h) w = (f w - f₁ w) + ((f₁ - h) w - h₂ w) := by
      simp only [LinearMap.add_apply, LinearMap.sub_apply]
      abel
    rw [heq]
    exact Submodule.add_mem _ (hff₁ w) (hf₂h₂ w)

variable (σ) in
/-- **Independence.** If `χ` is the central character of `M⁻(λ)`, the `g_{N,i}` are linearly
independent modulo `K_χ`. -/
theorem allCov_indep {lam : Fin n → ℂ} {χ : VermaGL.center n →ₐ[ℂ] ℂ}
    (hχ : ∀ z : VermaGL.center n,
      (z : VermaGL.glU n) • VermaGL.gen n lam = χ z • VermaGL.gen n lam)
    (Nmax : ℕ) (c : CovIdx σ Nmax → ℂ)
    (hc : ∀ w, ∑ k, c k • allCov σ Nmax k w ∈ cenIdeal χ) : c = 0 := by
  classical
  have key : ∀ j : ℕ, ∀ k : CovIdx σ Nmax, Nmax + 1 - j ≤ (k.1 : ℕ) → c k = 0 := by
    intro j
    induction j with
    | zero =>
      intro k hk
      have := k.1.isLt
      omega
    | succ j ih =>
      intro k hk
      by_cases hk' : Nmax + 1 - j ≤ (k.1 : ℕ)
      · exact ih k hk'
      have hlow : ∀ k' : CovIdx σ Nmax, c k' ≠ 0 → (k'.1 : ℕ) ≤ k.1 := by
        intro k' h0
        by_contra hlt
        exact h0 (ih k' (by omega))
      have hP : ∀ w, ∑ k', c k' • allCov σ Nmax k' w ∈ Fil (k.1 : ℕ) := by
        intro w
        refine Submodule.sum_mem _ fun k' _ => ?_
        by_cases h0 : c k' = 0
        · rw [h0, zero_smul]
          exact Submodule.zero_mem _
        · exact Submodule.smul_mem _ _ (degreeFiltration_mono ℂ _ (hlow k' h0)
            ((mem_Cov.mp (allCov_mem σ Nmax k')).2 w))
      have hev : ∀ w, ∑ i : Fin (topRank σ k.1),
          c ⟨k.1, i⟩ • evPsi n (symb n k.1 (allCov σ Nmax ⟨k.1, i⟩ w)) = 0 := by
        intro w
        have h1 := eval_symb_eq_zero lam (hP w)
          (fun m => smul_eq_zero_of_mem_cenIdeal hχ (hc w) m)
        rw [← evPsi_apply, map_sum, map_sum, Fintype.sum_sigma,
          Finset.sum_eq_single k.1] at h1
        · simp only [map_smul] at h1
          exact h1
        · intro a _ ha
          refine Finset.sum_eq_zero fun i _ => ?_
          by_cases h0 : c ⟨a, i⟩ = 0
          · rw [h0, zero_smul, map_zero, map_zero]
          · have hlt : (a : ℕ) < k.1 := lt_of_le_of_ne (hlow _ h0) (fun h => ha (Fin.ext h))
            rw [map_smul, map_smul,
              symb_eq_zero_of_mem hlt ((mem_Cov.mp (allCov_mem σ Nmax ⟨a, i⟩)).2 w), map_zero,
              smul_zero]
        · intro h
          exact absurd (Finset.mem_univ _) h
      have hzero : ∑ i, c ⟨k.1, i⟩ • topBasis σ k.1 i = 0 := by
        apply Subtype.ext
        refine LinearMap.ext fun w => ?_
        rw [Submodule.coe_sum, LinearMap.sum_apply, Submodule.coe_zero, LinearMap.zero_apply]
        simp only [Submodule.coe_smul, LinearMap.smul_apply, ← tauMap_topCov]
        exact hev w
      exact Fintype.linearIndependent_iff.mp (topBasis σ k.1).linearIndependent _ hzero k.2
  funext k
  exact key (Nmax + 1) k (by omega)

end Main

/-! ### Kostant's multiplicity theorem -/

/-- **Kostant's multiplicity theorem** for `𝔤𝔩_n(ℂ)`, assuming that every character of the
center is the central character of a lower Verma module. -/
theorem kostantMultiplicity_of_central (hC : VermaGL.CentralCharacterStatement) :
    VermaGL.KostantMultiplicityStatement.{uW} := by
  intro n W _ _ _ σ hσ χ
  classical
  obtain ⟨χ₀, F, hFcov, hFind⟩ := exists_kostantOne σ hσ
  choose NF hNF using fun i => exists_degree_bound (F i)
  set Nmax := Finset.univ.sup NF with hNmax
  have hspan : ∀ i, ∃ h ∈ Submodule.span ℂ (Set.range (allCov σ Nmax)),
      ∀ w, F i w - h w ∈ cenIdeal χ₀ := fun i =>
    exists_mem_span hσ χ₀ Nmax Nmax le_rfl (F i) (hFcov i) fun w =>
      ⟨F i w, degreeFiltration_mono ℂ _ (Finset.le_sup (Finset.mem_univ i)) (hNF i w),
        by rw [sub_self]; exact Submodule.zero_mem _⟩
  choose h hh hFh using hspan
  choose A hA using fun i => (Submodule.mem_span_range_iff_exists_fun ℂ).mp (hh i)
  -- at least `d` of the `g_{N,i}`
  have hcard : finrank ℂ (VermaGL.zeroWeightSpace σ) ≤ Fintype.card (CovIdx σ Nmax) := by
    by_contra hlt
    push Not at hlt
    have hnot : ¬ LinearIndependent ℂ A := by
      intro hli
      have := hli.fintype_card_le_finrank
      rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at this
      omega
    obtain ⟨c, hc, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.mp hnot
    have hc0 : c = 0 := by
      refine hFind c fun w => ?_
      have h0 : ∑ i, c i • h i w = 0 := by
        simp only [← hA, LinearMap.sum_apply, LinearMap.smul_apply, Finset.smul_sum, smul_smul]
        rw [Finset.sum_comm]
        simp only [← Finset.sum_smul]
        refine Finset.sum_eq_zero fun k _ => ?_
        have hk := congrFun hc k
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hk
        rw [hk, zero_smul]
      have hsum : ∑ i, c i • F i w = ∑ i, c i • (F i w - h i w) := by
        simp only [smul_sub, Finset.sum_sub_distrib, h0, sub_zero]
      rw [hsum]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_of_tower_mem _ _ (hFh i w)
    exact hi₀ (by rw [hc0]; rfl)
  obtain ⟨emb⟩ := Function.Embedding.nonempty_of_card_le
    (by rwa [Fintype.card_fin] : Fintype.card (Fin (finrank ℂ (VermaGL.zeroWeightSpace σ))) ≤
      Fintype.card (CovIdx σ Nmax))
  obtain ⟨lam, -, hlam⟩ := hC n χ
  refine ⟨fun i => allCov σ Nmax (emb i),
    fun i Y w => (mem_Cov.mp (allCov_mem σ Nmax (emb i))).1 Y w, fun c hc => ?_⟩
  have hc' : ∀ w, ∑ k, (∑ i, if emb i = k then c i else 0) • allCov σ Nmax k w ∈ cenIdeal χ := by
    intro w
    have heq : ∑ k, (∑ i, if emb i = k then c i else 0) • allCov σ Nmax k w =
        ∑ i, c i • allCov σ Nmax (emb i) w := by
      simp only [Finset.sum_smul, ite_smul, zero_smul]
      rw [Finset.sum_comm]
      simp only [Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
    rw [heq]
    exact hc w
  have h0 := allCov_indep σ hlam Nmax _ hc'
  funext i
  have := congrFun h0 (emb i)
  simp only [Pi.zero_apply, EmbeddingLike.apply_eq_iff_eq, Finset.sum_ite_eq', Finset.mem_univ,
    ↓reduceIte] at this
  exact this

end GLReynolds

end Langlands.Archimedean
