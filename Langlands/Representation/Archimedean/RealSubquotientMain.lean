import Langlands.Representation.Archimedean.RealSubquotientKType
import Langlands.Representation.Archimedean.RealJacquetSubquotientReduction

/-!
# Harish-Chandra's subquotient theorem for `GL_n(ℝ)`: the graph argument

Helper results for Harish-Chandra's subquotient theorem (`RealPrincipalSeriesSubquotientStatement`).

* `act_T0_eq_zero_of_kill`: a `K`-invariant matrix killing the `K`-intertwiners from `τ` into the
  principal series at the finitely many points of the fibre kills `T₀` (nilpotency and
  simplicity).
* `exists_subquotient_of_kill` (**graph argument**): if every `K`-invariant matrix killing an
  intertwiner `S₀` into a principal series kills `T₀`, then the `(𝔤, K)`-module generated by the
  graph of `S₀ ↦ T₀` exhibits `V` as a quotient of a stable space of principal-series functions.
-/

noncomputable section

open scoped Matrix TensorProduct Matrix.Norms.Operator

set_option autoImplicit false

namespace Langlands.Archimedean

namespace RealSubquotient

open Kostant MvPolynomial Langlands.Algebra.UniversalEnveloping InfinitesimalCharacter

set_option backward.isDefEq.respectTransparency false

attribute [local instance 100] LieRing.ofAssociativeRing

variable {n : ℕ}

section Kill

variable {d : ℕ} {M : Type*} [AddCommGroup M] [Module ℂ M] (P : UU n →ₐ[ℂ] Module.End ℂ M)

theorem act_eq_self_pow {x : Matrix (Fin d) (Fin d) (UU n)} {T : (Fin d → ℂ) →ₗ[ℂ] M}
    (h : act P x T = T) (m : ℕ) : act P (x ^ m) T = T := by
  induction m with
  | zero => rw [pow_zero, act_one]
  | succ m ih => rw [pow_succ, act_mul, h, ih]

theorem act_add_right (b : Matrix (Fin d) (Fin d) (UU n)) (T T' : (Fin d → ℂ) →ₗ[ℂ] M) :
    act P b (T + T') = act P b T + act P b T' := by
  refine LinearMap.pi_ext fun i c => ?_
  simp [act_single, Finset.sum_add_distrib, smul_add]

theorem act_smul_right (b : Matrix (Fin d) (Fin d) (UU n)) (r : ℂ) (T : (Fin d → ℂ) →ₗ[ℂ] M) :
    act P b (r • T) = r • act P b T := by
  refine LinearMap.pi_ext fun i c => ?_
  simp [act_single, Finset.smul_sum, smul_comm r c]

end Kill

variable {d : ℕ} {τ : Matrix.unitaryGroup (Fin n) ℝ →* Matrix (Fin d) (Fin d) ℂ}
  {D : Matrix (Fin n) (Fin n) ℝ →ₗ[ℝ] Matrix (Fin d) (Fin d) ℂ}
  (hτ : Continuous τ) (hD : IsTypeDerivative τ D)

include hτ hD in
/-- If `x` kills every `K`-intertwiner from `τ` into the principal series at `a` (all signs),
then `ĉ(x)(a) = 0`. -/
theorem chat_eval_eq_zero_of_kill {x : Matrix (Fin d) (Fin d) (UU n)} (a : Fin n → ℂ)
    (hkill : ∀ (e : Fin n → Fin 2) (T : (Fin d → ℂ) →ₗ[ℂ] PS a e),
      T ∈ gkIntertwiners (realStandardRep n (psList a e)) d τ → act (psAct a e) x T = 0) :
    (chat τ x).map (eval a) = 0 := by
  have hv : ∀ v : Fin d → ℂ, (chat τ x).map (eval a) *ᵥ v = 0 := by
    intro v
    refine eq_zero_of_signFunctional τ fun e φ hφ => ?_
    obtain ⟨T, hT, hT1⟩ := exists_frobenius_intertwiner hτ a e hφ
    rw [← hT1, ← eval_one_act_psAct hD hT x v, hkill e T hT]
    rfl
  refine Matrix.ext fun i j => ?_
  have := congrFun (hv (Pi.single j 1)) i
  simpa [Matrix.mulVec_single_one] using this

section Module

variable {V : Type*} [AddCommGroup V] [Module ℂ V]
  {ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℝ) V}
  {π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ⁅ℂ⁆ Module.End ℂ V}

include hτ hD in
/-- **Killing `T₀`.** Let the Gelfand elements act on the irreducible module `V` by `λ_l`. A
`K`-invariant `b` killing every `K`-intertwiner from `τ` into the principal series at every point
of the fibre `{ξ_l = λ_l}` kills every nonzero `K`-intertwiner `T₀` into `V`. -/
theorem act_T0_eq_zero_of_kill (hd : 0 < d) (hgk : IsRealGKModule n ρ π)
    (hirr : IsIrreducibleGKModule ρ π) (lam : ℕ → ℂ)
    (hlam : ∀ l, envelopingAction π (Cgel n l) = algebraMap ℂ _ (lam l))
    {T0 : (Fin d → ℂ) →ₗ[ℂ] V} (hT0 : T0 ∈ gkIntertwiners ρ d τ) (hT0ne : T0 ≠ 0)
    {b : Matrix (Fin d) (Fin d) (UU n)} (hb : b ∈ Bsub τ)
    (hbk : ∀ a : Fin n → ℂ, (∀ l, eval a (xiPoly τ (Cgel n l)) = lam l) →
      ∀ (e : Fin n → Fin 2) (T : (Fin d → ℂ) →ₗ[ℂ] PS a e),
        T ∈ gkIntertwiners (realStandardRep n (psList a e)) d τ → act (psAct a e) b T = 0) :
    act (envelopingAction π) b T0 = 0 := by
  by_contra hne
  have hρP : ∀ k u, ρ k * envelopingAction π u = envelopingAction π (AdU k u) * ρ k :=
    fun k u => rho_mul_envelopingAction hgk.2.2.2 k u
  have hbT0 := act_mem (envelopingAction π) hρP hb hT0
  obtain ⟨c, hc⟩ := exists_act_eq_of_irreducible hgk hirr hbT0 hne (T' := T0)
  have hc' := act_avg hτ (envelopingAction π) hρP hbT0 hT0 hc
  set x := avg τ c * b
  have hx : x ∈ Bsub τ := Subalgebra.mul_mem _ (avg_mem_Bsub hτ c) hb
  have hxT0 : act (envelopingAction π) x T0 = T0 := by rw [act_mul, hc']
  obtain ⟨m, hm⟩ := exists_pow_act_eq_zero hτ hD hd hgk lam hlam hT0 hx fun a ha =>
    chat_eval_eq_zero_of_kill hτ hD a fun e T hT => by
      rw [act_mul, hbk a ha e T hT, act_zero_right]
  rw [act_eq_self_pow _ hxT0 m] at hm
  exact hT0ne hm

include hτ in
/-- **The graph argument.** If every `K`-invariant matrix killing the `K`-intertwiner `S₀` into
the principal series of `chars a e` kills the nonzero `K`-intertwiner `T₀` into the irreducible
module `V`, then `V` is a quotient of a stable space of `O(n)`-finite principal-series functions. -/
theorem exists_subquotient_of_kill (hgk : IsRealGKModule n ρ π) (hirr : IsIrreducibleGKModule ρ π)
    {a : Fin n → ℂ} {e : Fin n → Fin 2} {S0 : (Fin d → ℂ) →ₗ[ℂ] PS a e}
    (hS0 : S0 ∈ gkIntertwiners (realStandardRep n (psList a e)) d τ)
    {T0 : (Fin d → ℂ) →ₗ[ℂ] V} (hT0 : T0 ∈ gkIntertwiners ρ d τ) (hT0ne : T0 ≠ 0)
    (hann : ∀ b ∈ Bsub τ, act (psAct a e) b S0 = 0 → act (envelopingAction π) b T0 = 0) :
    ∃ W : Submodule ℂ (Langlands.GeneralLinear n ℝ → ℂ), W ≤ PS a e ∧
      ∃ T : W →ₗ[ℂ] V, Function.Surjective T ∧ IsRealSubquotientMap n ρ π W T := by
  classical
  set Ps := psAct a e
  set Pv := envelopingAction π
  have hρPs : ∀ k u, realStandardRep n (psList a e) k * Ps u =
      Ps (AdU k u) * realStandardRep n (psList a e) k := fun k u =>
    rho_mul_envelopingAction (isRealGKModule_realStandardModule n (psList a e)).2.2.2 k u
  have hρPv : ∀ k u, ρ k * Pv u = Pv (AdU k u) * ρ k := fun k u =>
    rho_mul_envelopingAction hgk.2.2.2 k u
  let Ψ : (Fin d → UU n) →ₗ[ℂ] (PS a e × V) := (PhiT Ps S0).prod (PhiT Pv T0)
  set Z := LinearMap.range Ψ
  have hΨ : ∀ w, Ψ w = ∑ j, (Ps (w j) (S0 (Pi.single j 1)), Pv (w j) (T0 (Pi.single j 1))) := by
    intro w
    refine Prod.ext ?_ ?_
    · simp [Ψ, PhiT_apply, Prod.fst_sum]
    · simp [Ψ, PhiT_apply, Prod.snd_sum]
  have hgen : ∀ (u : UU n) (x : Fin d → ℂ), (Ps u (S0 x), Pv u (T0 x)) ∈ Z := by
    intro u x
    refine ⟨fun j => x j • u, ?_⟩
    rw [hΨ]
    refine Prod.ext ?_ ?_
    · simp only [Prod.fst_sum, map_smul, LinearMap.smul_apply]
      rw [apply_eq_sum_single S0 x, map_sum]
      simp [map_smul]
    · simp only [Prod.snd_sum, map_smul, LinearMap.smul_apply]
      rw [apply_eq_sum_single T0 x, map_sum]
      simp [map_smul]
  -- stability of `Z`
  have hZmap : ∀ (f : PS a e × V →ₗ[ℂ] PS a e × V) (g : UU n → UU n) (h : (Fin d → ℂ) → (Fin d → ℂ)),
      (∀ u x, f (Ps u (S0 x), Pv u (T0 x)) = (Ps (g u) (S0 (h x)), Pv (g u) (T0 (h x)))) →
      ∀ z ∈ Z, f z ∈ Z := by
    rintro f g h hf _ ⟨w, rfl⟩
    rw [hΨ, map_sum]
    exact Submodule.sum_mem _ fun j _ => by rw [hf]; exact hgen _ _
  have hZK : ∀ k, ∀ z ∈ Z, (realStandardRep n (psList a e) k z.1, ρ k z.2) ∈ Z := by
    intro k
    refine hZmap ((realStandardRep n (psList a e) k).prodMap (ρ k)) (AdU k) (fun x => τ k *ᵥ x)
      fun u x => ?_
    simp only [LinearMap.prodMap_apply]
    rw [← Module.End.mul_apply, hρPs, Module.End.mul_apply, ← Module.End.mul_apply (ρ k), hρPv,
      Module.End.mul_apply, hS0 k x, hT0 k x]
  have hZX : ∀ X : LL n, ∀ z ∈ Z,
      (realStandardLie n (psList a e) X z.1, π X z.2) ∈ Z := by
    intro X
    refine hZmap ((realStandardLie n (psList a e) X).prodMap (π X))
      (fun u => UniversalEnvelopingAlgebra.ι ℂ X * u) id fun u x => ?_
    simp only [LinearMap.prodMap_apply, id, map_mul, Module.End.mul_apply]
    rw [psAct_ι]
    simp [Pv, envelopingAction]
  -- the graph meets `0 × V` trivially
  set V' : Submodule ℂ V := Z.comap (LinearMap.inr ℂ (PS a e) V)
  have hV' : V' = ⊥ := by
    have hρ' : ∀ k, ∀ v ∈ V', ρ k v ∈ V' := by
      intro k v hv
      have := hZK k _ hv
      rw [Submodule.mem_comap]
      simpa using this
    have hπ' : ∀ X, ∀ v ∈ V', π X v ∈ V' := by
      intro X v hv
      have := hZX X _ hv
      rw [Submodule.mem_comap]
      simpa using this
    rcases hirr.2 V' hρ' hπ' with h | h
    · exact h
    · exfalso
      have hmem : ∀ i, ∃ w : Fin d → UU n, Ψ w = (0, T0 (Pi.single i 1)) := fun i => by
        have : T0 (Pi.single i 1) ∈ V' := by rw [h]; trivial
        exact this
      choose w hw using hmem
      set c : Matrix (Fin d) (Fin d) (UU n) := Matrix.of fun i j => w i j
      have hcS : act Ps c S0 = 0 := by
        refine LinearMap.pi_ext fun i t => ?_
        rw [act_single, LinearMap.zero_apply]
        have := congrArg Prod.fst (hw i)
        change PhiT Ps S0 (w i) = 0 at this
        rw [PhiT_apply] at this
        simp only [c, Matrix.of_apply]
        rw [this, smul_zero]
      have hcT : act Pv c T0 = T0 := by
        refine LinearMap.pi_ext fun i t => ?_
        rw [act_single]
        have := congrArg Prod.snd (hw i)
        change PhiT Pv T0 (w i) = T0 (Pi.single i 1) at this
        rw [PhiT_apply] at this
        simp only [c, Matrix.of_apply]
        rw [this, ← map_smul, ← Pi.single_smul, smul_eq_mul, mul_one]
      have h1 := act_avg hτ Ps hρPs hS0 (Submodule.zero_mem _) hcS
      have h2 := act_avg hτ Pv hρPv hT0 hT0 hcT
      exact hT0ne (h2 ▸ hann _ (avg_mem_Bsub hτ c) h1)
  -- the projection to the first factor is injective on `Z`
  let fstF : Z →ₗ[ℂ] (Langlands.GeneralLinear n ℝ → ℂ) :=
    (PS a e).subtype ∘ₗ LinearMap.fst ℂ (PS a e) V ∘ₗ Z.subtype
  have hker : ∀ z : Z, fstF z = 0 → z = 0 := by
    rintro ⟨z, hz⟩ hz0
    have h1 : z.1 = 0 := Subtype.ext hz0
    have h2 : z.2 ∈ V' := by
      change (0, z.2) ∈ Z
      rw [← h1]
      exact hz
    rw [hV'] at h2
    have h2' : z.2 = 0 := h2
    exact Subtype.ext (Prod.ext h1 h2')
  have hinj : Function.Injective fstF := fun z₁ z₂ h =>
    sub_eq_zero.mp (hker _ (by rw [map_sub, h, sub_self]))
  set W := LinearMap.range fstF
  obtain ⟨eW, heW⟩ : ∃ eW : Z ≃ₗ[ℂ] W,
      ∀ z : Z, ((eW z : W) : Langlands.GeneralLinear n ℝ → ℂ) = fstF z :=
    ⟨LinearEquiv.ofInjective fstF hinj, fun z => LinearEquiv.ofInjective_apply fstF z⟩
  let T : W →ₗ[ℂ] V := (LinearMap.snd ℂ (PS a e) V ∘ₗ Z.subtype) ∘ₗ eW.symm.toLinearMap
  have hTeW : ∀ z : Z, T (eW z) = (z : PS a e × V).2 := fun z => by
    simp [T]
  refine ⟨W, ?_, T, ?_, ?_⟩
  · rintro _ ⟨z, rfl⟩
    exact ((z : PS a e × V).1).2
  · -- surjectivity
    set V'' : Submodule ℂ V := Z.map (LinearMap.snd ℂ (PS a e) V)
    have hρ'' : ∀ k, ∀ v ∈ V'', ρ k v ∈ V'' := by
      rintro k _ ⟨z, hz, rfl⟩
      exact ⟨_, hZK k z hz, rfl⟩
    have hπ'' : ∀ X, ∀ v ∈ V'', π X v ∈ V'' := by
      rintro X _ ⟨z, hz, rfl⟩
      exact ⟨_, hZX X z hz, rfl⟩
    have hV'' : V'' = ⊤ := by
      rcases hirr.2 V'' hρ'' hπ'' with h | h
      · exfalso
        apply hT0ne
        refine LinearMap.ext fun x => ?_
        have : T0 x ∈ V'' := ⟨_, hgen 1 x, by simp⟩
        rw [h] at this
        simpa using this
      · exact h
    intro v
    have hv : v ∈ V'' := by rw [hV'']; trivial
    obtain ⟨z, hz, rfl⟩ := hv
    exact ⟨eW ⟨z, hz⟩, hTeW ⟨z, hz⟩⟩
  · -- the intertwining properties
    constructor
    · intro k w
      set k' : Matrix.unitaryGroup (Fin n) ℝ :=
        ⟨((k : Langlands.GeneralLinear n ℝ) : Matrix (Fin n) (Fin n) ℝ), k.2⟩
      set z := eW.symm w
      have hw : (w : Langlands.GeneralLinear n ℝ → ℂ) = (((z : PS a e × V).1 : PS a e) :
          Langlands.GeneralLinear n ℝ → ℂ) := by
        have := congrArg Subtype.val (eW.apply_symm_apply w)
        rw [← this, heW]
        rfl
      have hz' := hZK k' _ z.2
      have hfst : fstF ⟨_, hz'⟩ = Whittaker.rightTranslation ℂ (Langlands.GeneralLinear n ℝ)
          (k : Langlands.GeneralLinear n ℝ) (w : Langlands.GeneralLinear n ℝ → ℂ) := by
        rw [hw]
        change ((realStandardRep n (psList a e) k' (z : PS a e × V).1 : PS a e) :
          Langlands.GeneralLinear n ℝ → ℂ) = _
        rw [realStandardRep_apply_coe,
          show Unitary.toUnits k' = (k : Langlands.GeneralLinear n ℝ) from Units.ext rfl]
      have hmemW : Whittaker.rightTranslation ℂ (Langlands.GeneralLinear n ℝ)
          (k : Langlands.GeneralLinear n ℝ) (w : Langlands.GeneralLinear n ℝ → ℂ) ∈ W :=
        ⟨⟨_, hz'⟩, hfst⟩
      refine ⟨hmemW, ?_⟩
      have hT' : T ⟨_, hmemW⟩ = ρ k' (z : PS a e × V).2 := by
        have : (⟨_, hmemW⟩ : W) = eW ⟨_, hz'⟩ :=
          Subtype.ext (by rw [heW]; exact hfst.symm)
        rw [this, hTeW]
      rw [hT']
      rfl
    · intro X w
      set z := eW.symm w
      have hw : (w : Langlands.GeneralLinear n ℝ → ℂ) = (((z : PS a e × V).1 : PS a e) :
          Langlands.GeneralLinear n ℝ → ℂ) := by
        have := congrArg Subtype.val (eW.apply_symm_apply w)
        rw [← this, heW]
        rfl
      have hz' := hZX ((1 : ℂ) ⊗ₜ X) _ z.2
      have hfst : fstF ⟨_, hz'⟩ = rightDerivative (matrixModel ℝ n) X
          (w : Langlands.GeneralLinear n ℝ → ℂ) := by
        rw [hw]
        change ((realStandardLie n (psList a e) ((1 : ℂ) ⊗ₜ X) (z : PS a e × V).1 : PS a e) :
          Langlands.GeneralLinear n ℝ → ℂ) = _
        rw [realStandardLie_one_tmul_apply_coe]
      have hmemW : rightDerivative (matrixModel ℝ n) X (w : Langlands.GeneralLinear n ℝ → ℂ) ∈ W :=
        ⟨⟨_, hz'⟩, hfst⟩
      refine ⟨hmemW, ?_⟩
      have hT' : T ⟨_, hmemW⟩ = π ((1 : ℂ) ⊗ₜ X) (z : PS a e × V).2 := by
        have : (⟨_, hmemW⟩ : W) = eW ⟨_, hz'⟩ :=
          Subtype.ext (by rw [heW]; exact hfst.symm)
        rw [this, hTeW]
      rw [hT']
      rfl

end Module

end RealSubquotient

end Langlands.Archimedean
