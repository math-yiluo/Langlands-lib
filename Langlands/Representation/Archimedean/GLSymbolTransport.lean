import Langlands.Representation.Archimedean.GLKostantOne
import Langlands.Representation.Archimedean.LowerVermaDuflo
import Langlands.Representation.Archimedean.Kostant.Assembly
import Langlands.Representation.Archimedean.Kostant.OrbitVanishing

/-!
# Symbols on `U(𝔤𝔩_n(ℂ))` through the one-block product

The Library's symbol calculus (`Kostant.glSymbol`, Matumoto's lemma, the orbit and nilpotent
cone statements) is stated for `U(∏ᵢ 𝔤𝔩_{n i}(ℂ))`. We transport it to `U(𝔤𝔩_n(ℂ))` along the
Lie algebra isomorphism `𝔤𝔩_n(ℂ) ≅ ∏_{i : Unit} 𝔤𝔩_n(ℂ)`.

* `map_mem_degreeFiltration`: enveloping maps of Lie algebra maps preserve the degree filtration.
* `symb N : U(𝔤𝔩_n) → ℂ[X_c]`: the transported degree-`N` symbol.
* `eval_symb_eq_zero`: Matumoto's lemma for `M⁻(λ)`.
* `coadDer_symb`: the symbol of `[Y, P]` is the coadjoint derivation of the symbol of `P`.
* `exists_sub_mem_of_symb`: if the degree-`(M+1)` symbol of `P` lies in the ideal of the
  nilpotent cone, then `P` is congruent modulo the left ideal generated by the `z - χ(z)` to an
  element of `U_M`, for every character `χ` of the center.
-/

noncomputable section

set_option autoImplicit false

-- Entries of tuples of matrices are applied through the `Matrix` definition.
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

namespace GLReynolds

open Langlands.Algebra.UniversalEnveloping Langlands.Algebra.LieEnvelopingEquiv MvPolynomial

/-! ### Enveloping maps and the degree filtration -/

section Filtration

variable {A B : Type*} [LieRing A] [LieAlgebra ℂ A] [LieRing B] [LieAlgebra ℂ B]

theorem map_mem_degreeOne (φ : A →ₗ⁅ℂ⁆ B) {P : UniversalEnvelopingAlgebra ℂ A}
    (hP : P ∈ degreeOne ℂ A) : map φ P ∈ degreeOne ℂ B := by
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hP
  rw [map_add]
  refine Submodule.add_mem _ ?_ ?_
  · obtain ⟨c, rfl⟩ := Submodule.mem_one.mp ha
    exact Submodule.mem_sup_left (Submodule.mem_one.mpr ⟨c, (AlgHom.commutes _ c).symm⟩)
  · obtain ⟨x, rfl⟩ := hb
    refine Submodule.mem_sup_right ⟨φ x, ?_⟩
    change UniversalEnvelopingAlgebra.ι ℂ (φ x) = map φ (UniversalEnvelopingAlgebra.ι ℂ x)
    rw [map_generator]

theorem map_mem_degreeFiltration (φ : A →ₗ⁅ℂ⁆ B) :
    ∀ (N : ℕ) {P : UniversalEnvelopingAlgebra ℂ A}, P ∈ degreeFiltration ℂ A N →
      map φ P ∈ degreeFiltration ℂ B N := by
  intro N
  induction N with
  | zero =>
    intro P hP
    rw [degreeFiltration_zero] at hP ⊢
    obtain ⟨c, rfl⟩ := Submodule.mem_one.mp hP
    exact Submodule.mem_one.mpr ⟨c, (AlgHom.commutes _ c).symm⟩
  | succ N ih =>
    intro P hP
    have hsplit : degreeFiltration ℂ A (N + 1) = degreeFiltration ℂ A N * degreeOne ℂ A := by
      rw [degreeFiltration, degreeFiltration, pow_succ]
    rw [hsplit] at hP
    refine Submodule.mul_induction_on hP (fun a ha b hb => ?_) (fun x y hx hy => ?_)
    · rw [map_mul]
      have hb' : map φ b ∈ degreeFiltration ℂ B 1 := by
        rw [degreeFiltration_one]; exact map_mem_degreeOne φ hb
      exact mul_mem_degreeFiltration ℂ B (ih ha) hb'
    · rw [map_add]; exact Submodule.add_mem _ hx hy

end Filtration

/-! ### The one-block product -/

section Transport

variable (n : ℕ)

/-- The block sizes of the one-block product. -/
abbrev nU : Unit → ℕ := fun _ => n

/-- The induced isomorphism of enveloping algebras. -/
abbrev envEquiv : VermaGL.glU n ≃ₐ[ℂ] UniversalEnvelopingAlgebra ℂ (Kostant.GLProd ℂ (nU n)) :=
  enveloping (VermaPBW.toUnitProd n)

variable {n}

theorem envEquiv_ι (Y : Matrix (Fin n) (Fin n) ℂ) :
    envEquiv n (UniversalEnvelopingAlgebra.ι ℂ Y) =
      UniversalEnvelopingAlgebra.ι ℂ (VermaPBW.toUnitProd n Y) :=
  enveloping_generator _ _

theorem unitEquiv_single (a b : Fin n) :
    VermaPBW.toUnitProd n (Matrix.single a b 1) = Kostant.unit ℂ (nU n) () a b := by
  funext u
  cases u
  simp only [Kostant.unit, Pi.single_eq_same]
  rfl

theorem envEquiv_mem {N : ℕ} {P : VermaGL.glU n}
    (hP : P ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N) :
    envEquiv n P ∈ degreeFiltration ℂ (Kostant.GLProd ℂ (nU n)) N :=
  map_mem_degreeFiltration (VermaPBW.toUnitProd n).toLieHom N hP

theorem envEquiv_symm_mem {N : ℕ} {Q : UniversalEnvelopingAlgebra ℂ (Kostant.GLProd ℂ (nU n))}
    (hQ : Q ∈ degreeFiltration ℂ (Kostant.GLProd ℂ (nU n)) N) :
    (envEquiv n).symm Q ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N :=
  map_mem_degreeFiltration (VermaPBW.toUnitProd n).symm.toLieHom N hQ

variable (n) in
/-- The degree-`N` symbol on `U(𝔤𝔩_n(ℂ))`. -/
def symb (N : ℕ) : VermaGL.glU n →ₗ[ℂ] MvPolynomial (Kostant.Coord (nU n)) ℂ :=
  (Kostant.glSymbol ℂ (nU n)).symbol N ∘ₗ (envEquiv n).toLinearMap

theorem symb_apply (N : ℕ) (P : VermaGL.glU n) :
    symb n N P = (Kostant.glSymbol ℂ (nU n)).symbol N (envEquiv n P) := rfl

theorem symb_eq_zero_of_mem {M N : ℕ} (hMN : M < N) {P : VermaGL.glU n}
    (hP : P ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) M) : symb n N P = 0 :=
  (Kostant.glSymbol ℂ (nU n)).symbol_eq_zero_of_mem hMN (envEquiv_mem hP)

theorem symb_zero_algebraMap (c : ℂ) :
    symb n 0 (algebraMap ℂ (VermaGL.glU n) c) = C c := by
  rw [symb_apply, AlgEquiv.commutes, (Kostant.glSymbol ℂ (nU n)).symbol_zero_algebraMap]
  rfl

/-- The coadjoint derivations and commutators. -/
theorem coadDer_symb (Y : Matrix (Fin n) (Fin n) ℂ) {N : ℕ} {P : VermaGL.glU n}
    (hP : P ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N) :
    Kostant.coadDer ℂ (nU n) (VermaPBW.toUnitProd n Y) (symb n N P) =
      symb n N (UniversalEnvelopingAlgebra.ι ℂ Y * P - P * UniversalEnvelopingAlgebra.ι ℂ Y) := by
  rw [symb_apply, symb_apply, map_sub, map_mul, map_mul, envEquiv_ι]
  exact ((Kostant.glSymbol ℂ (nU n)).symbol_commutator _
    (Kostant.coadDer ℂ (nU n) _).toLinearMap (Kostant.coadDer_isLeibniz ℂ (nU n) _)
    (Kostant.coadDer_ξ ℂ (nU n) _) (envEquiv_mem hP)).symm

variable (n) in
/-- The Whittaker point `ψ`: `1` on the superdiagonal, `0` elsewhere. -/
def psiPt : Kostant.Coord (nU n) → ℂ := fun v => if (v.2.2 : ℕ) = v.2.1 + 1 then 1 else 0

/-- **Matumoto's lemma for `M⁻(λ)`.** If `P ∈ U_N` acts by `0` on `M⁻(λ)`, its degree-`N` symbol
vanishes at `ψ`. -/
theorem eval_symb_eq_zero (lam : Fin n → ℂ) {N : ℕ} {P : VermaGL.glU n}
    (hP : P ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N)
    (hPV : ∀ m : VermaGL.LowerVerma n lam, P • m = 0) :
    eval (psiPt n) (symb n N P) = 0 := by
  set π' := (VermaGL.action n lam).comp (VermaPBW.toUnitProd n).symm.toLieHom
  have hW : Kostant.IsWhittaker (nU n) π' (fun _ _ => 1) (VermaPBW.whitFun n lam) := by
    intro X hX v
    change VermaPBW.whitFun n lam (VermaGL.action n lam (X ()) v) = _
    rw [VermaPBW.whitFun_action n lam (X ()) (hX ()) v]
    simp [VermaPBW.oneCoeff, Kostant.whitChar]
  have h0 : VermaPBW.whitFun n lam ≠ 0 := by
    intro h
    have := LinearMap.congr_fun h (VermaGL.gen n lam)
    rw [VermaPBW.whitFun_gen, LinearMap.zero_apply] at this
    exact one_ne_zero this
  have hPV' : envelopingAction π' (envEquiv n P) = 0 := by
    rw [Kostant.envelopingAction_comp_enveloping]
    refine LinearMap.ext fun m => ?_
    rw [BGChase.envelopingAction_action, hPV, LinearMap.zero_apply]
  have h := Kostant.eval_symbol_eq_zero (nU n) hW h0 (envEquiv_mem hP) hPV'
  exact h

end Transport

/-! ### Reduction modulo the central ideal -/

section Reduction

variable {ι : Type} [Fintype ι] [DecidableEq ι] (m : ι → ℕ)

local notation "U'" => UniversalEnvelopingAlgebra ℂ (Kostant.GLProd ℂ m)

/-- If the degree-`(M+1)` symbol of `P` lies in the ideal of the nilpotent cone, then for any
scalars `c_j` there are `A_j` with `P - Σ_j A_j (Z_j - c_j) ∈ U_M`, where `Z_j` are the central
elements `zk` with symbols the generators of the ideal (as in Library `Kostant.Assembly`). -/
theorem exists_reduction {M : ℕ} {P : U'} (hP : P ∈ degreeFiltration ℂ (Kostant.GLProd ℂ m) (M + 1))
    (hK : (Kostant.glSymbol ℂ m).symbol (M + 1) P ∈ Kostant.charpolyIdeal m)
    (c : Kostant.Gen m → ℂ) :
    ∃ A : Kostant.Gen m → U', P - ∑ j, A j * (Kostant.zk ℂ m j.1 (Kostant.genDeg m j) -
      algebraMap ℂ U' (c j)) ∈ degreeFiltration ℂ (Kostant.GLProd ℂ m) M := by
  classical
  set N := M + 1 with hN
  set σP := (Kostant.glSymbol ℂ m).symbol N P
  have hK' : σP ∈ Ideal.span (Set.range (Kostant.gens m)) := by
    rw [← Kostant.charpolyIdeal_eq]; exact hK
  obtain ⟨f, hf⟩ := Ideal.mem_span_range_iff_exists_fun.mp hK'
  set coef : Kostant.Gen m → MvPolynomial (Kostant.Coord m) ℂ := fun j =>
    if Kostant.genDeg m j ≤ N then homogeneousComponent (N - Kostant.genDeg m j) (f j) else 0
  have hcoef : ∀ j, (coef j).IsHomogeneous (N - Kostant.genDeg m j) := by
    intro j
    simp only [coef]
    split_ifs
    · exact homogeneousComponent_isHomogeneous _ _
    · exact isHomogeneous_zero _ _ _
  have hdecomp : σP = ∑ j, coef j * Kostant.gens m j := by
    have h1 : σP = homogeneousComponent N σP :=
      (homogeneousComponent_of_mem (Kostant.symbol_isHomogeneous m hP) ▸ ite_eq_left rfl).symm
    rw [h1, ← hf, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Kostant.homogeneousComponent_mul_of_isHomogeneous _ (Kostant.gens_isHomogeneous m j)]
    simp only [coef]
    split_ifs <;> simp
  choose A hAmem hAsym using fun j => Kostant.exists_symbol_eq m (hcoef j)
  set A' : Kostant.Gen m → U' := fun j => if Kostant.genDeg m j ≤ N then A j else 0
  refine ⟨A', ?_⟩
  set Z' : Kostant.Gen m → U' := fun j =>
    Kostant.zk ℂ m j.1 (Kostant.genDeg m j) - algebraMap ℂ U' (c j)
  have hZ'mem : ∀ j, Z' j ∈ degreeFiltration ℂ (Kostant.GLProd ℂ m) (Kostant.genDeg m j) :=
    fun j => Submodule.sub_mem _ (Kostant.zk_mem ℂ m j.1 (Kostant.genDeg m j))
      (algebraMap_mem_degreeFiltration ℂ _ _ _)
  have hR'filt : ∑ j, A' j * Z' j ∈ degreeFiltration ℂ (Kostant.GLProd ℂ m) N := by
    refine Submodule.sum_mem _ fun j _ => ?_
    simp only [A']
    split_ifs with hj
    · have := mul_mem_degreeFiltration ℂ _ (hAmem j) (hZ'mem j)
      rwa [show N - Kostant.genDeg m j + Kostant.genDeg m j = N by omega] at this
    · rw [zero_mul]; exact Submodule.zero_mem _
  have hR'sym : (Kostant.glSymbol ℂ m).symbol N (∑ j, A' j * Z' j) = σP := by
    rw [hdecomp, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [A']
    split_ifs with hj
    · have hAlow : (Kostant.glSymbol ℂ m).symbol N (A j) = 0 :=
        (Kostant.glSymbol ℂ m).symbol_eq_zero_of_mem
          (by have := Kostant.genDeg_pos m j; omega) (hAmem j)
      have hmul := (Kostant.glSymbol ℂ m).symbol_mul (hAmem j)
        (Kostant.zk_mem ℂ m j.1 (Kostant.genDeg m j))
      rw [show N - Kostant.genDeg m j + Kostant.genDeg m j = N by omega] at hmul
      simp only [Z', mul_sub, map_sub, hmul, hAsym, Kostant.symbol_zk_gens, ← Algebra.commutes,
        ← Algebra.smul_def, map_smul, hAlow, smul_zero, sub_zero, coef, hj, ite_true]
    · simp only [coef, ite_eq_right hj, zero_mul, map_zero]
  exact Kostant.mem_degreeFiltration_of_symbol_eq_zero ℂ (Kostant.GLProd ℂ m)
    (Kostant.glBasis ℂ m) (Kostant.glSymbol ℂ m)
    (fun c => Kostant.AssocSymbol.symbolData_ξ_basis _ c) (Kostant.sortedCoords_nodup m)
    (Kostant.mem_sortedCoords m) (Submodule.sub_mem _ hP hR'filt)
    (by rw [map_sub, hR'sym, sub_self])

end Reduction

section CentralIdeal

variable {n : ℕ}

/-- The left ideal of `U(𝔤𝔩_n(ℂ))` generated by the elements `z - χ(z)`, `z` central. -/
abbrev cenIdeal (χ : VermaGL.center n →ₐ[ℂ] ℂ) : Ideal (VermaGL.glU n) :=
  Ideal.span {x | ∃ z : VermaGL.center n, x = (z : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (χ z)}

/-- **Reduction.** If `P ∈ U_{M+1}` has degree-`(M+1)` symbol in the ideal of the nilpotent
cone, then `P ∈ U_M + U·ker χ` for every character `χ` of the center. -/
theorem exists_sub_mem_of_symb (χ : VermaGL.center n →ₐ[ℂ] ℂ) {M : ℕ} {P : VermaGL.glU n}
    (hP : P ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) (M + 1))
    (hK : symb n (M + 1) P ∈ Kostant.charpolyIdeal (nU n)) :
    ∃ R ∈ cenIdeal χ, P - R ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) M := by
  classical
  set Zc : Kostant.Gen (nU n) → VermaGL.center n := fun j =>
    ⟨(envEquiv n).symm (Kostant.zk ℂ (nU n) j.1 (Kostant.genDeg (nU n) j)),
      Kostant.mem_center_enveloping_symm (VermaPBW.toUnitProd n)
        (Kostant.zk_mem_center ℂ (nU n) j.1 (Kostant.genDeg (nU n) j))⟩ with hZc
  obtain ⟨A, hA⟩ := exists_reduction (nU n) (envEquiv_mem hP) hK (fun j => χ (Zc j))
  refine ⟨∑ j, (envEquiv n).symm (A j) *
    ((Zc j : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (χ (Zc j))), ?_, ?_⟩
  · refine Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨Zc j, rfl⟩)
  · have h := envEquiv_symm_mem hA
    have heq : (envEquiv n).symm (envEquiv n P - ∑ j, A j *
        (Kostant.zk ℂ (nU n) j.1 (Kostant.genDeg (nU n) j) -
          algebraMap ℂ _ (χ (Zc j)))) =
        P - ∑ j, (envEquiv n).symm (A j) *
          ((Zc j : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (χ (Zc j))) := by
      simp only [map_sub, map_sum, map_mul, AlgEquiv.symm_apply_apply, AlgEquiv.commutes, Zc]
    rwa [heq] at h

/-- Elements of `U·ker χ` act by `0` on a module on which the center acts through `χ`. -/
theorem smul_eq_zero_of_mem_cenIdeal {lam : Fin n → ℂ} {χ : VermaGL.center n →ₐ[ℂ] ℂ}
    (hχ : ∀ z : VermaGL.center n, (z : VermaGL.glU n) • VermaGL.gen n lam = χ z • VermaGL.gen n lam)
    {P : VermaGL.glU n} (hP : P ∈ cenIdeal χ) (m : VermaGL.LowerVerma n lam) : P • m = 0 := by
  induction hP using Submodule.span_induction generalizing m with
  | mem x hx =>
    obtain ⟨z, rfl⟩ := hx
    obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ m
    rw [← BGChase.smul_gen, sub_smul, ← mul_smul, ← Subalgebra.mem_center_iff.mp z.2 u, mul_smul,
      hχ z, algebraMap_smul, smul_comm u (χ z), sub_self]
  | zero => rw [zero_smul]
  | add x y _ _ hx hy => rw [add_smul, hx, hy, add_zero]
  | smul r x _ hx => rw [smul_eq_mul, mul_smul, hx, smul_zero]

end CentralIdeal

end GLReynolds

end Langlands.Archimedean
