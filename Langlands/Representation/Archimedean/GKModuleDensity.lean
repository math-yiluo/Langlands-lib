import Langlands.Representation.Archimedean.GKModule
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.LinearAlgebra.Eigenspace.Triangularizable
import Mathlib.Algebra.FreeAlgebra
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# Schur's lemma and Jacobson density for irreducible admissible `(𝔤, K)`-modules

Let `(ρ, π)` be an irreducible `(𝔤, K)`-module on a complex vector space `V` (Library
`IsIrreducibleGKModule`) that is admissible (`IsAdmissibleGKModule`), whose vectors lie in
finite-dimensional `ρ`-stable subspaces, and whose matrix coefficients `k ↦ ℓ(ρ(k) v)` are
continuous. Then every linear map commuting with all `ρ(k)` and `π(X)` is a scalar
(`GKModuleDensity.exists_eq_scalar`), and every linear map of `V` agrees on any finite set with
an element of the algebra generated by the `ρ(k)` and `π(X)`, written as a noncommutative
polynomial in these generators (`GKModuleDensity.exists_freeAlgebra_eq`).
-/

noncomputable section

open Module

open scoped Matrix

namespace Langlands.Archimedean

set_option autoImplicit false

attribute [local instance 100] LieRing.ofAssociativeRing

namespace GKModuleDensity

universe uK uL uV

variable {K : Type uK} [Group K] [TopologicalSpace K] {L : Type uL} [LieRing L] [LieAlgebra ℂ L]
  {V : Type uV} [AddCommGroup V] [Module ℂ V]
  (ρ : Representation ℂ K V) (π : L →ₗ⁅ℂ⁆ Module.End ℂ V)

/-- The generators `ρ(k)` and `π(X)` of the Hecke-type algebra acting on `V`. -/
def gens : K ⊕ L → Module.End ℂ V := Sum.elim (fun k => ρ k) (fun X => π X)

/-- The subalgebra of `End_ℂ V` generated by the `ρ(k)` and `π(X)`. -/
abbrev heckeAlgebra : Subalgebra ℂ (Module.End ℂ V) := Algebra.adjoin ℂ (Set.range (gens ρ π))

/-- The hypotheses: irreducible, admissible, `K`-finite with continuous matrix coefficients. -/
structure Hyp : Prop where
  irreducible : IsIrreducibleGKModule ρ π
  admissible : IsAdmissibleGKModule ρ
  finite : ∀ v : V, ∃ F : Submodule ℂ V, v ∈ F ∧ FiniteDimensional ℂ F ∧
    ∀ (k : K), ∀ w ∈ F, ρ k w ∈ F
  continuous : ∀ (v : V) (ℓ : V →ₗ[ℂ] ℂ), Continuous fun k : K => ℓ (ρ k v)

variable {ρ π}

/-! ## A finite-dimensional `ρ`-stable subspace as a matrix representation -/

section MatrixRep

variable (F : Submodule ℂ V) (hF : ∀ (k : K), ∀ w ∈ F, ρ k w ∈ F) {d : ℕ} (b : Basis (Fin d) ℂ F)

/-- The matrix of `ρ(k)` on `F` in the basis `b`. -/
def matrixRep : K →* Matrix (Fin d) (Fin d) ℂ where
  toFun k := LinearMap.toMatrix b b ((ρ k).restrict (hF k))
  map_one' := by
    have : (ρ 1).restrict (hF 1) = LinearMap.id := by
      ext w
      simp
    rw [this]
    exact LinearMap.toMatrix_id b
  map_mul' k k' := by
    have : (ρ (k * k')).restrict (hF (k * k')) =
        ((ρ k).restrict (hF k)) ∘ₗ ((ρ k').restrict (hF k')) := by
      ext w
      simp
    rw [this]
    exact LinearMap.toMatrix_comp b b b _ _

/-- The inclusion `ℂ^d → V` along the basis `b` of `F`. -/
def inclusion : (Fin d → ℂ) →ₗ[ℂ] V := F.subtype ∘ₗ (b.equivFun.symm : (Fin d → ℂ) →ₗ[ℂ] F)

omit [TopologicalSpace K] in
theorem inclusion_mem (k : K) (x : Fin d → ℂ) :
    inclusion F b (matrixRep F hF b k *ᵥ x) = ρ k (inclusion F b x) := by
  have h := LinearMap.toMatrix_mulVec_repr b b ((ρ k).restrict (hF k)) (b.equivFun.symm x)
  rw [← Basis.equivFun_apply, ← Basis.equivFun_apply, LinearEquiv.apply_symm_apply] at h
  have h2 : b.equivFun.symm (LinearMap.toMatrix b b ((ρ k).restrict (hF k)) *ᵥ x) =
      (ρ k).restrict (hF k) (b.equivFun.symm x) := by
    rw [h, LinearEquiv.symm_apply_apply]
  simp only [inclusion, matrixRep, MonoidHom.coe_mk, OneHom.coe_mk, LinearMap.coe_comp,
    Submodule.coe_subtype, LinearEquiv.coe_coe, Function.comp_apply]
  rw [h2]
  rfl

theorem continuous_matrixRep (hcont : ∀ (v : V) (ℓ : V →ₗ[ℂ] ℂ), Continuous fun k : K => ℓ (ρ k v)) :
    Continuous (matrixRep F hF b) := by
  refine continuous_pi fun i => continuous_pi fun j => ?_
  obtain ⟨ℓ, hℓ⟩ := LinearMap.exists_extend (b.coord i)
  have heq : (fun k : K => matrixRep F hF b k i j) = fun k => ℓ (ρ k (b j : V)) := by
    funext k
    simp only [matrixRep, MonoidHom.coe_mk, OneHom.coe_mk, LinearMap.toMatrix_apply]
    have := congrArg (fun g => g ((ρ k).restrict (hF k) (b j))) hℓ
    simp only [LinearMap.coe_comp, Submodule.coe_subtype, Function.comp_apply] at this
    change _ = ℓ (((ρ k).restrict (hF k) (b j) : F) : V)
    rw [this, Basis.coord_apply]
  rw [heq]
  exact hcont _ ℓ

end MatrixRep

/-! ## Schur's lemma -/

theorem exists_eq_scalar (h : Hyp ρ π) (T : Module.End ℂ V)
    (hTρ : ∀ (k : K) (v : V), T (ρ k v) = ρ k (T v))
    (hTπ : ∀ (X : L) (v : V), T (π X v) = π X (T v)) :
    ∃ c : ℂ, ∀ v, T v = c • v := by
  have : Nontrivial V := h.irreducible.1
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  obtain ⟨F, hvF, hFfin, hF⟩ := h.finite v₀
  set d := finrank ℂ F
  let b : Basis (Fin d) ℂ F := Module.finBasis ℂ F
  set τ := matrixRep F hF b
  have hτ : Continuous τ := continuous_matrixRep F hF b h.continuous
  have hI : FiniteDimensional ℂ (gkIntertwiners ρ d τ) := h.admissible d τ hτ
  set r := finrank ℂ (gkIntertwiners ρ d τ)
  let bI : Basis (Fin r) ℂ (gkIntertwiners ρ d τ) := Module.finBasis ℂ _
  -- the finite-dimensional `T`-stable subspace
  set W : Submodule ℂ V := Submodule.span ℂ (Set.range fun p : Fin r × Fin d =>
    ((bI p.1 : gkIntertwiners ρ d τ) : (Fin d → ℂ) →ₗ[ℂ] V) (Pi.single p.2 1)) with hWdef
  have hWfin : FiniteDimensional ℂ W := FiniteDimensional.span_of_finite ℂ (Set.finite_range _)
  have hmemW : ∀ S ∈ gkIntertwiners ρ d τ, ∀ j : Fin d, S (Pi.single j 1) ∈ W := by
    intro S hS j
    have hev : S (Pi.single j 1) = ∑ i, bI.repr ⟨S, hS⟩ i •
        ((bI i : gkIntertwiners ρ d τ) : (Fin d → ℂ) →ₗ[ℂ] V) (Pi.single j 1) := by
      have h1 : S = ((⟨S, hS⟩ : gkIntertwiners ρ d τ) : (Fin d → ℂ) →ₗ[ℂ] V) := rfl
      conv_lhs => rw [h1, ← bI.sum_repr ⟨S, hS⟩]
      rw [Submodule.coe_sum, LinearMap.sum_apply]
      rfl
    rw [hev]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
      (Submodule.subset_span ⟨(i, j), rfl⟩)
  have hTW : ∀ w ∈ W, T w ∈ W := by
    intro w hw
    refine Submodule.span_induction (fun x hx => ?_) (by simp) (fun x y _ _ hx hy => ?_)
      (fun c x _ hx => ?_) hw
    · obtain ⟨⟨i, j⟩, rfl⟩ := hx
      have hTS : T ∘ₗ ((bI i : gkIntertwiners ρ d τ) : (Fin d → ℂ) →ₗ[ℂ] V) ∈
          gkIntertwiners ρ d τ := by
        intro k x
        simp only [LinearMap.coe_comp, Function.comp_apply]
        rw [(bI i).2 k x, hTρ]
      exact hmemW _ hTS j
    · rw [map_add]
      exact add_mem hx hy
    · rw [map_smul]
      exact Submodule.smul_mem _ _ hx
  have hincl : inclusion F b ∈ gkIntertwiners ρ d τ := fun k x => inclusion_mem F hF b k x
  have hd : 0 < d := by
    have : Nontrivial F := ⟨⟨⟨v₀, hvF⟩, 0, fun h0 => hv₀ (congrArg Subtype.val h0)⟩⟩
    exact Module.finrank_pos
  have hW0 : W ≠ ⊥ := by
    intro hbot
    have hmem := hmemW _ hincl ⟨0, hd⟩
    rw [hbot, Submodule.mem_bot] at hmem
    have : (b ⟨0, hd⟩ : V) = 0 := by
      simpa [inclusion] using hmem
    exact b.ne_zero ⟨0, hd⟩ (Subtype.ext this)
  have : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hW0
  obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue (T.restrict hTW)
  obtain ⟨w, hw⟩ := hc.exists_hasEigenvector
  refine ⟨c, fun v => ?_⟩
  set N : Submodule ℂ V := LinearMap.ker (T - c • LinearMap.id) with hNdef
  have hNρ : ∀ (k : K), ∀ x ∈ N, ρ k x ∈ N := by
    intro k x hx
    simp only [hNdef, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
      LinearMap.id_apply] at hx ⊢
    rw [hTρ, ← map_smul, ← map_sub, hx, map_zero]
  have hNπ : ∀ (X : L), ∀ x ∈ N, π X x ∈ N := by
    intro X x hx
    simp only [hNdef, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
      LinearMap.id_apply] at hx ⊢
    rw [hTπ, ← map_smul, ← map_sub, hx, map_zero]
  rcases h.irreducible.2 N hNρ hNπ with hbot | htop
  · exfalso
    have hwN : (w : V) ∈ N := by
      have := hw.apply_eq_smul
      simp only [hNdef, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
        LinearMap.id_apply]
      have h2 := congrArg Subtype.val this
      simp only [LinearMap.restrict_apply, SetLike.val_smul] at h2
      rw [h2, sub_self]
    rw [hbot, Submodule.mem_bot] at hwN
    exact hw.2 (Subtype.ext hwN)
  · have hvN : v ∈ N := by rw [htop]; trivial
    simp only [hNdef, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
      LinearMap.id_apply] at hvN
    exact sub_eq_zero.mp hvN

/-! ## Jacobson density -/

omit [TopologicalSpace K] in
theorem gens_mem (g : K ⊕ L) : gens ρ π g ∈ heckeAlgebra ρ π :=
  Algebra.subset_adjoin ⟨g, rfl⟩

omit [TopologicalSpace K] in
theorem heckeAlgebra_smul_def (a : heckeAlgebra ρ π) (v : V) :
    a • v = (a : Module.End ℂ V) v := rfl

theorem isSimpleModule (h : Hyp ρ π) : IsSimpleModule (heckeAlgebra ρ π) V := by
  have : Nontrivial V := h.irreducible.1
  suffices hso : ∀ N : Submodule (heckeAlgebra ρ π) V, N = ⊥ ∨ N = ⊤ by
    have : IsSimpleOrder (Submodule (heckeAlgebra ρ π) V) := { eq_bot_or_eq_top := hso }
    exact ⟨⟩
  intro N
  let N' : Submodule ℂ V :=
    { carrier := N
      add_mem' := N.add_mem
      zero_mem' := N.zero_mem
      smul_mem' := fun c x hx => by
        have := N.smul_mem (algebraMap ℂ (heckeAlgebra ρ π) c) hx
        rw [heckeAlgebra_smul_def] at this
        simpa using this }
  have hρ : ∀ (k : K), ∀ w ∈ N', ρ k w ∈ N' := fun k w hw => by
    have := N.smul_mem ⟨ρ k, gens_mem (Sum.inl k)⟩ hw
    rw [heckeAlgebra_smul_def] at this
    exact this
  have hπ : ∀ (X : L), ∀ w ∈ N', π X w ∈ N' := fun X w hw => by
    have := N.smul_mem ⟨π X, gens_mem (Sum.inr X)⟩ hw
    rw [heckeAlgebra_smul_def] at this
    exact this
  rcases h.irreducible.2 N' hρ hπ with hbot | htop
  · left
    ext x
    have := congrArg (fun S : Submodule ℂ V => x ∈ S) hbot
    simpa [N'] using this
  · right
    ext x
    have := congrArg (fun S : Submodule ℂ V => x ∈ S) htop
    simpa [N'] using this

/-- **Jacobson density.** Every linear map of `V` agrees on a finite set with a noncommutative
polynomial in the `ρ(k)` and `π(X)`. -/
theorem exists_freeAlgebra_eq (h : Hyp ρ π) (s : Finset V) (f : Module.End ℂ V) :
    ∃ a : FreeAlgebra ℂ (K ⊕ L), ∀ v ∈ s, FreeAlgebra.lift ℂ (gens ρ π) a v = f v := by
  have := isSimpleModule h
  let f' : Module.End (Module.End (heckeAlgebra ρ π) V) V :=
    { toFun := f
      map_add' := f.map_add
      map_smul' := fun T v => by
        have hTℂ : ∀ (c : ℂ) (x : V), T (c • x) = c • T x := fun c x => by
          simp
        let T' : Module.End ℂ V := ⟨⟨T, T.map_add⟩, hTℂ⟩
        obtain ⟨c, hc⟩ := exists_eq_scalar h T'
          (fun k x => by
            have := T.map_smul ⟨ρ k, gens_mem (Sum.inl k)⟩ x
            simp only [heckeAlgebra_smul_def] at this
            exact this)
          (fun X x => by
            have := T.map_smul ⟨π X, gens_mem (Sum.inr X)⟩ x
            simp only [heckeAlgebra_smul_def] at this
            exact this)
        change f (T v) = T (f v)
        have h1 : T v = c • v := hc v
        have h2 : T (f v) = c • f v := hc (f v)
        rw [h1, h2, map_smul] }
  obtain ⟨r, hr⟩ := jacobson_density f' s
  have hr' : (r : Module.End ℂ V) ∈ (FreeAlgebra.lift ℂ (gens ρ π)).range := by
    rw [← Algebra.adjoin_range_eq_range_freeAlgebra_lift]
    exact r.2
  obtain ⟨a, ha⟩ := hr'
  have ha' : FreeAlgebra.lift ℂ (gens ρ π) a = (r : Module.End ℂ V) := ha
  refine ⟨a, fun v hv => ?_⟩
  rw [ha', ← heckeAlgebra_smul_def, ← hr v hv]
  rfl

end GKModuleDensity

open GKModuleDensity

/-- **Statement (Schur's lemma and Jacobson density for irreducible admissible
`(𝔤, K)`-modules).** Let `(ρ, π)` be an irreducible (`IsIrreducibleGKModule`) and admissible
(`IsAdmissibleGKModule`) `(𝔤, K)`-module on a complex vector space `V` such that every vector
lies in a finite-dimensional `ρ`-stable subspace and every matrix coefficient `k ↦ ℓ(ρ(k) v)` is
continuous. Then for every finite set `s ⊆ V` and every linear map `f : V → V` there is a
noncommutative polynomial `a` in the generators `ρ(k)` (`k ∈ K`) and `π(X)` (`X ∈ L`) whose
value agrees with `f` on `s`. -/
def GKModuleDensityStatement : Prop :=
  ∀ (K : Type) [Group K] [TopologicalSpace K] (L : Type) [LieRing L] [LieAlgebra ℂ L]
    (V : Type) [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ K V)
    (π : L →ₗ⁅ℂ⁆ Module.End ℂ V),
    IsIrreducibleGKModule ρ π → IsAdmissibleGKModule ρ →
    (∀ v : V, ∃ F : Submodule ℂ V, v ∈ F ∧ FiniteDimensional ℂ F ∧
      ∀ (k : K), ∀ w ∈ F, ρ k w ∈ F) →
    (∀ (v : V) (ℓ : V →ₗ[ℂ] ℂ), Continuous fun k : K => ℓ (ρ k v)) →
    ∀ (s : Finset V) (f : Module.End ℂ V),
      ∃ a : FreeAlgebra ℂ (K ⊕ L), ∀ v ∈ s, FreeAlgebra.lift ℂ (gens ρ π) a v = f v

theorem gkModuleDensity : GKModuleDensityStatement := by
  intro K _ _ L _ _ V _ _ ρ π hirr hadm hfin hcont s f
  exact exists_freeAlgebra_eq ⟨hirr, hadm, hfin, hcont⟩ s f

end Langlands.Archimedean
