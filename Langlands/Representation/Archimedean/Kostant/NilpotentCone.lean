import Langlands.Representation.Archimedean.Kostant.Coordinates
import Langlands.Representation.Archimedean.Kostant.CharpolyOrder
import Langlands.Representation.Archimedean.Kostant.CharpolyLeading
import Langlands.Representation.Archimedean.Kostant.CoprimeGroebner
import Mathlib.RingTheory.Nullstellensatz
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# The ideal of the nilpotent cone of `∏ᵢ 𝔤𝔩_{n i}(ℂ)`

`charpolyIdeal n` is the ideal of `ℂ[X_c]` generated by the coefficients of `t^k`, `k < n i`,
of the characteristic polynomials of the generic blocks. `NilpotentConeIdealStatement n`
(Kostant 1963) says that every polynomial vanishing at all tuples of nilpotent matrices lies
in `charpolyIdeal n`.

`nilpotentConeIdeal_of_charpolyLeading` proves it from `CharpolyLeadingStatement n`. The
normalized coefficients `gen n j` are monic for `ord n` with pairwise disjoint squarefree
leading monomials `antidiag n b k`. By `CoprimeGroebner.isRadical` the ideal they generate,
which is `charpolyIdeal n`, is radical. Its zero locus consists of the tuples of nilpotent
matrices (Cayley–Hamilton), so Hilbert's Nullstellensatz gives the statement.
`nilpotentConeIdeal` combines it with `charpolyLeading`.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean.Kostant

open MvPolynomial

variable {ι : Type} [Fintype ι] (n : ι → ℕ)

/-- The ideal generated by the coefficients of `t^k`, `k < n i`, of the characteristic
polynomials of all generic blocks. -/
def charpolyIdeal : Ideal (MvPolynomial (Coord n) ℂ) :=
  Ideal.span {f | ∃ (i : ι) (k : ℕ), k < n i ∧ f = (genericBlock n i).charpoly.coeff k}

/-- Kostant: a polynomial vanishing on all tuples of nilpotent matrices lies in
`charpolyIdeal`. -/
def NilpotentConeIdealStatement : Prop :=
  ∀ f : MvPolynomial (Coord n) ℂ,
    (∀ M : ∀ i, Matrix (Fin (n i)) (Fin (n i)) ℂ, (∀ i, IsNilpotent (M i)) →
      eval (fun c : Coord n => M c.1 c.2.1 c.2.2) f = 0) →
    f ∈ charpolyIdeal n

namespace NilpotentCone

/-! ## The zero locus of `charpolyIdeal n` -/

/-- A square matrix whose characteristic polynomial has vanishing coefficients below the top
degree is nilpotent. -/
theorem isNilpotent_of_charpoly_coeff {N : ℕ} (A : Matrix (Fin N) (Fin N) ℂ)
    (h : ∀ k < N, A.charpoly.coeff k = 0) : IsNilpotent A := by
  have hd : A.charpoly.natDegree = N := by
    rw [Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  have hX : A.charpoly = Polynomial.X ^ N := by
    ext k
    rw [Polynomial.coeff_X_pow]
    rcases lt_trichotomy k N with hk | rfl | hk
    · rw [h k hk, ite_eq_right hk.ne]
    · rw [ite_eq_left rfl]
      have h1 := A.charpoly_monic.coeff_natDegree
      rwa [hd] at h1
    · rw [ite_eq_right hk.ne', Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hd]; exact hk)]
  have hCH := Matrix.aeval_self_charpoly A
  rw [hX, Polynomial.aeval_X_pow] at hCH
  exact ⟨N, hCH⟩

omit [Fintype ι] in
/-- At a zero of `charpolyIdeal n`, every block is a nilpotent matrix. -/
theorem isNilpotent_of_mem_zeroLocus {x : Coord n → ℂ}
    (hx : x ∈ zeroLocus ℂ (charpolyIdeal n)) (i : ι) :
    IsNilpotent (Matrix.of fun p q => x ⟨i, p, q⟩ : Matrix (Fin (n i)) (Fin (n i)) ℂ) := by
  have hmap : (genericBlock n i).map (eval x) = Matrix.of fun p q => x ⟨i, p, q⟩ := by
    ext p q
    simp [genericBlock]
  refine isNilpotent_of_charpoly_coeff _ fun k hk => ?_
  rw [← hmap, Matrix.charpoly_map, Polynomial.coeff_map]
  exact hx _ (Ideal.subset_span ⟨i, k, hk, rfl⟩)

/-! ## Normalized generators -/

/-- Index of the generators: a block `b` and an exponent `k < n b`. -/
abbrev Gen := Σ b : ι, Fin (n b)

/-- The coefficient of `t^k` of the characteristic polynomial of block `b`, for `j = ⟨b, k⟩`. -/
def charCoeff (j : Gen n) : MvPolynomial (Coord n) ℂ :=
  (genericBlock n j.1).charpoly.coeff j.2

/-- `charCoeff n j` divided by its leading coefficient for `ord n`. -/
def gen (j : Gen n) : MvPolynomial (Coord n) ℂ :=
  ((ord n).leadingCoeff (charCoeff n j))⁻¹ • charCoeff n j

variable {n}

theorem leadingCoeff_charCoeff_ne_zero (hL : CharpolyLeadingStatement n) (j : Gen n) :
    (ord n).leadingCoeff (charCoeff n j) ≠ 0 :=
  (hL j.1 j.2 j.2.isLt).2.ne_zero

theorem degree_gen (hL : CharpolyLeadingStatement n) (j : Gen n) :
    (ord n).degree (gen n j) = antidiag n j.1 j.2 := by
  rw [gen, MonomialOrder.degree_smul_of_isRegular
    (IsUnit.mk0 _ (inv_ne_zero (leadingCoeff_charCoeff_ne_zero hL j))).isRegular]
  exact (hL j.1 j.2 j.2.isLt).1

theorem monic_gen (hL : CharpolyLeadingStatement n) (j : Gen n) : (ord n).Monic (gen n j) := by
  rw [MonomialOrder.Monic, MonomialOrder.leadingCoeff, gen,
    MonomialOrder.degree_smul_of_isRegular
      (IsUnit.mk0 _ (inv_ne_zero (leadingCoeff_charCoeff_ne_zero hL j))).isRegular,
    coeff_smul, smul_eq_mul]
  exact inv_mul_cancel₀ (leadingCoeff_charCoeff_ne_zero hL j)

theorem degree_gen_disjoint (hL : CharpolyLeadingStatement n) (j j' : Gen n) (hjj : j ≠ j')
    (v : Coord n) : (ord n).degree (gen n j) v = 0 ∨ (ord n).degree (gen n j') v = 0 := by
  classical
  rw [degree_gen hL, degree_gen hL, antidiag_apply, antidiag_apply]
  split_ifs with h1 h2
  · exfalso
    apply hjj
    obtain ⟨b, k⟩ := j
    obtain ⟨b', k'⟩ := j'
    obtain ⟨hb, hs⟩ := h1
    obtain ⟨hb', hs'⟩ := h2
    obtain rfl : b = b' := hb.symm.trans hb'
    have hk : (k : ℕ) = k' := by
      simp only at hs hs'
      omega
    rw [Fin.ext hk]
  · exact Or.inr rfl
  · exact Or.inl rfl
  · exact Or.inl rfl

theorem degree_gen_le_one (hL : CharpolyLeadingStatement n) (j : Gen n) (v : Coord n) :
    (ord n).degree (gen n j) v ≤ 1 := by
  classical
  rw [degree_gen hL, antidiag_apply]
  split_ifs <;> simp

theorem charpolyIdeal_eq_span_gen (hL : CharpolyLeadingStatement n) :
    charpolyIdeal n = Ideal.span (Set.range (gen n)) := by
  apply le_antisymm
  · rw [charpolyIdeal, Ideal.span_le]
    rintro f ⟨i, k, hk, rfl⟩
    have hlc := leadingCoeff_charCoeff_ne_zero hL ⟨i, ⟨k, hk⟩⟩
    have h : (genericBlock n i).charpoly.coeff k =
        C ((ord n).leadingCoeff (charCoeff n ⟨i, ⟨k, hk⟩⟩)) * gen n ⟨i, ⟨k, hk⟩⟩ := by
      rw [gen, smul_eq_C_mul, ← mul_assoc, ← C_mul, mul_inv_cancel₀ hlc, C_1, one_mul]
      rfl
    rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, rfl⟩)
  · rw [Ideal.span_le]
    rintro f ⟨j, rfl⟩
    rw [gen, smul_eq_C_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j.1, j.2, j.2.isLt, rfl⟩)

/-- `charpolyIdeal n` is a radical ideal. -/
theorem isRadical_charpolyIdeal (hL : CharpolyLeadingStatement n) :
    (charpolyIdeal n).IsRadical := by
  rw [charpolyIdeal_eq_span_gen hL]
  exact CoprimeGroebner.isRadical (ord n) (gen n) (monic_gen hL) (degree_gen_disjoint hL)
    (degree_gen_le_one hL)

end NilpotentCone

open NilpotentCone in
/-- **Kostant's theorem on the nilpotent cone**, from the leading terms of the
characteristic polynomial coefficients. -/
theorem nilpotentConeIdeal_of_charpolyLeading (hL : CharpolyLeadingStatement n) :
    NilpotentConeIdealStatement n := by
  intro f hf
  refine isRadical_charpolyIdeal hL ?_
  rw [← vanishingIdeal_zeroLocus_eq_radical (K := ℂ)]
  refine mem_vanishingIdeal_iff.2 fun x hx => ?_
  change eval x f = 0
  exact hf (fun i => Matrix.of fun p q => x ⟨i, p, q⟩) (isNilpotent_of_mem_zeroLocus n hx)

/-- **Kostant's theorem on the nilpotent cone** of `∏ᵢ 𝔤𝔩_{n i}(ℂ)`. -/
theorem nilpotentConeIdeal : NilpotentConeIdealStatement n :=
  nilpotentConeIdeal_of_charpolyLeading n (charpolyLeading n)

end Langlands.Archimedean.Kostant
