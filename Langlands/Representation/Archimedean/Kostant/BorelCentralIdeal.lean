import Langlands.Representation.Archimedean.Kostant.Assembly
import Langlands.Representation.Archimedean.Kostant.OrbitVanishing

/-!
# Symbols of the central ideal of a module with a Borel eigenfunctional

Let `π` be a representation of `𝔤 = ∏ᵢ 𝔤𝔩_{n i}(ℂ)` on `V` and `ℓ ≠ 0` a linear functional on
`V` with `ℓ(π(E_c) v) = μ_c ℓ(v)` for the blockwise upper triangular matrix units `E_c`.
The main result, `symbol_mem_charpolyIdeal`, says that for every element `u` of degree at most
`N` of the ideal of `U(𝔤)` generated by the central elements acting by `0`, the degree-`N`
symbol `σ_N(u)` lies in the ideal generated by the coefficients of the characteristic
polynomials of the generic blocks.
-/

noncomputable section

set_option autoImplicit false

-- Entries of tuples of matrices are applied through the `Matrix` definition.
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Archimedean.Kostant

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Algebra.UniversalEnveloping MvPolynomial

namespace BorelCentralIdeal

/-! ## Syzygies of variables -/

section Koszul

variable {σ : Type*} [DecidableEq σ]

/-- The substitution setting the variables of `T` to `0`. -/
def killVars (T : Finset σ) : MvPolynomial σ ℂ →ₐ[ℂ] MvPolynomial σ ℂ :=
  aeval fun i => if i ∈ T then 0 else X i

theorem killVars_X_of_mem {T : Finset σ} {i : σ} (hi : i ∈ T) : killVars T (X i) = 0 := by
  simp [killVars, hi]

theorem killVars_X_of_not_mem {T : Finset σ} {i : σ} (hi : i ∉ T) : killVars T (X i) = X i := by
  simp [killVars, hi]

/-- `g - killVars T g` is a combination of the variables of `T`. -/
theorem exists_sub_killVars (T : Finset σ) (g : MvPolynomial σ ℂ) :
    ∃ a : σ → MvPolynomial σ ℂ, g - killVars T g = ∑ c ∈ T, a c * X c := by
  induction g using MvPolynomial.induction_on with
  | C r => exact ⟨0, by simp [killVars]⟩
  | add p q hp hq =>
    obtain ⟨a, ha⟩ := hp
    obtain ⟨b, hb⟩ := hq
    refine ⟨a + b, ?_⟩
    rw [map_add, add_sub_add_comm, ha, hb, ← Finset.sum_add_distrib]
    simp only [Pi.add_apply, add_mul]
  | mul_X p i hp =>
    obtain ⟨a, ha⟩ := hp
    by_cases hi : i ∈ T
    · refine ⟨fun c => a c * X i + if c = i then killVars T p else 0, ?_⟩
      rw [map_mul, killVars_X_of_mem hi, mul_zero, sub_zero]
      calc p * X i = (p - killVars T p) * X i + killVars T p * X i := by ring
        _ = (∑ c ∈ T, a c * X c) * X i + killVars T p * X i := by rw [ha]
        _ = ∑ c ∈ T, (a c * X i + if c = i then killVars T p else 0) * X c := by
          simp only [add_mul, Finset.sum_add_distrib, Finset.sum_mul, ite_mul, zero_mul,
            Finset.sum_ite_eq', ite_eq_left hi]
          congr 1
          exact Finset.sum_congr rfl fun c _ => by ring
    · refine ⟨fun c => a c * X i, ?_⟩
      rw [map_mul, killVars_X_of_not_mem hi]
      calc p * X i - killVars T p * X i = (p - killVars T p) * X i := by ring
        _ = ∑ c ∈ T, a c * X i * X c := by
          rw [ha, Finset.sum_mul]
          exact Finset.sum_congr rfl fun c _ => by ring

/-- **Syzygies of variables.** If `∑_{c ∈ T} X_c f_c = 0`, then `f_c = ∑_{c' ∈ T} s_{c c'} X_{c'}`
for an antisymmetric family `s`. -/
theorem exists_antisymm_of_sum_X_mul_eq_zero (T : Finset σ) (f : σ → MvPolynomial σ ℂ)
    (h : ∑ c ∈ T, X c * f c = 0) :
    ∃ s : σ → σ → MvPolynomial σ ℂ, (∀ c c', s c c' = -s c' c) ∧
      ∀ c ∈ T, f c = ∑ c' ∈ T, s c c' * X c' := by
  induction T using Finset.induction_on generalizing f with
  | empty => exact ⟨0, fun _ _ => by simp, fun _ hc => absurd hc (Finset.notMem_empty _)⟩
  | insert t T ht ih =>
    rw [Finset.sum_insert ht] at h
    have hk : killVars T (f t) = 0 := by
      have h1 := congrArg (killVars T) h
      rw [map_add, map_mul, map_sum, map_zero, killVars_X_of_not_mem ht] at h1
      have h0 : ∑ c ∈ T, killVars T (X c * f c) = 0 := Finset.sum_eq_zero fun c hc => by
        rw [map_mul, killVars_X_of_mem hc, zero_mul]
      rw [h0, add_zero] at h1
      exact (mul_eq_zero.mp h1).resolve_left (X_ne_zero t)
    obtain ⟨a, ha⟩ := exists_sub_killVars T (f t)
    rw [hk, sub_zero] at ha
    have h' : ∑ c ∈ T, X c * (f c + a c * X t) = 0 := by
      calc ∑ c ∈ T, X c * (f c + a c * X t) =
            X t * (∑ c ∈ T, a c * X c) + ∑ c ∈ T, X c * f c := by
            rw [Finset.mul_sum, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun c _ => by ring
        _ = 0 := by rw [← ha]; exact h
    obtain ⟨s, hs, hsT⟩ := ih (fun c => f c + a c * X t) h'
    refine ⟨fun c c' => if c = t ∧ c' = t then 0 else if c = t then a c' else
      if c' = t then -a c else s c c', ?_, ?_⟩
    · intro c c'
      by_cases hc : c = t <;> by_cases hc' : c' = t
      · simp [hc, hc']
      · simp [hc, hc']
      · simp [hc, hc']
      · simp only [hc, hc', and_false, ite_false]
        exact hs c c'
    · intro c hc
      rw [Finset.sum_insert ht]
      rcases Finset.mem_insert.mp hc with rfl | hcT
      · simp only [and_self, ite_true, zero_mul, zero_add, true_and]
        rw [ha]
        refine Finset.sum_congr rfl fun c' hc' => ?_
        have hc't : c' ≠ c := fun h => ht (h ▸ hc')
        simp [hc't]
      · have hct : c ≠ t := fun h => ht (h ▸ hcT)
        have h2 := hsT c hcT
        simp only [hct, false_and, ite_false, ite_true]
        have h3 : ∑ c' ∈ T, (if c' = t then -a c else s c c') * X c' =
            ∑ c' ∈ T, s c c' * X c' := Finset.sum_congr rfl fun c' hc' => by
          have hc't : c' ≠ t := fun h => ht (h ▸ hc')
          simp [hc't]
        rw [h3, ← h2]
        ring

/-- The homogeneous version: if every `f_c` is homogeneous of degree `M + 1`, then `s` can be
chosen homogeneous of degree `M`. -/
theorem exists_antisymm_homogeneous (T : Finset σ) (f : σ → MvPolynomial σ ℂ) (M : ℕ)
    (hf : ∀ c ∈ T, (f c).IsHomogeneous (M + 1)) (h : ∑ c ∈ T, X c * f c = 0) :
    ∃ s : σ → σ → MvPolynomial σ ℂ, (∀ c c', s c c' = -s c' c) ∧
      (∀ c c', (s c c').IsHomogeneous M) ∧ ∀ c ∈ T, f c = ∑ c' ∈ T, s c c' * X c' := by
  obtain ⟨s, hs, hsT⟩ := exists_antisymm_of_sum_X_mul_eq_zero T f h
  refine ⟨fun c c' => homogeneousComponent M (s c c'), fun c c' => by dsimp only; rw [hs, map_neg],
    fun c c' => homogeneousComponent_isHomogeneous _ _, fun c hc => ?_⟩
  have h1 : homogeneousComponent (M + 1) (f c) = f c := by
    rw [homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).mpr (hf c hc)), ite_eq_left rfl]
  rw [← h1, hsT c hc, map_sum]
  refine Finset.sum_congr rfl fun c' _ => ?_
  rw [homogeneousComponent_mul_of_isHomogeneous _ (isHomogeneous_X ℂ c'), ite_eq_left (by omega),
    Nat.add_sub_cancel]

end Koszul

/-! ## Upper triangular coordinates and Borel eigenfunctionals -/

section Borel

variable {ι : Type} [Fintype ι] [DecidableEq ι] (n : ι → ℕ)

local notation "U" => UniversalEnvelopingAlgebra ℂ (GLProd ℂ n)

/-- The coordinates on or above the diagonal of their block. -/
def upper : Finset (Coord n) := Finset.univ.filter fun c => c.2.1 ≤ c.2.2

omit [DecidableEq ι] in
variable {n} in
theorem mem_upper {c : Coord n} : c ∈ upper n ↔ c.2.1 ≤ c.2.2 := by simp [upper]

/-- Blockwise upper triangular elements of `∏ᵢ 𝔤𝔩_{n i}(ℂ)`. -/
def IsBUpper (x : GLProd ℂ n) : Prop := ∀ i, (x i).BlockTriangular id

variable {n}

omit [Fintype ι] [DecidableEq ι] in
theorem IsBUpper.lie {x y : GLProd ℂ n} (hx : IsBUpper n x) (hy : IsBUpper n y) :
    IsBUpper n ⁅x, y⁆ := by
  intro i
  rw [Ring.lie_def, Pi.sub_apply, Pi.mul_apply, Pi.mul_apply]
  exact ((hx i).mul (hy i)).sub ((hy i).mul (hx i))

theorem glBasis_apply_coord (c e : Coord n) :
    glBasis ℂ n c e.1 e.2.1 e.2.2 = if e = c then 1 else 0 := by
  rw [← glBasis_repr ℂ n (glBasis ℂ n c) e, Module.Basis.repr_self, Finsupp.single_apply]
  by_cases h : e = c
  · simp [h]
  · simp [h, Ne.symm h]

theorem isBUpper_glBasis {c : Coord n} (hc : c ∈ upper n) : IsBUpper n (glBasis ℂ n c) := by
  intro i p q hqp
  have h := glBasis_apply_coord (n := n) c ⟨i, p, q⟩
  simp only at h
  rw [h, ite_eq_right_iff]
  rintro rfl
  exact absurd (mem_upper.mp hc) (not_le.mpr hqp)

/-- An upper triangular element is a combination of the upper triangular matrix units. -/
theorem eq_sum_upper {x : GLProd ℂ n} (hx : IsBUpper n x) :
    x = ∑ e ∈ upper n, x e.1 e.2.1 e.2.2 • glBasis ℂ n e := by
  conv_lhs => rw [← (glBasis ℂ n).sum_repr x]
  simp only [glBasis_repr]
  symm
  refine Finset.sum_subset (Finset.subset_univ _) fun e _ he => ?_
  have : e.2.2 < e.2.1 := not_le.mp fun h => he (mem_upper.mpr h)
  rw [hx e.1 this, zero_smul]

variable (n) in
/-- The linear form `x ↦ ∑_{e upper} x_e μ_e`. -/
def muLin (μ : Coord n → ℂ) (x : GLProd ℂ n) : ℂ := ∑ e ∈ upper n, x e.1 e.2.1 e.2.2 * μ e

theorem muLin_glBasis (μ : Coord n → ℂ) {c : Coord n} (hc : c ∈ upper n) :
    muLin n μ (glBasis ℂ n c) = μ c := by
  rw [muLin, Finset.sum_eq_single c]
  · rw [glBasis_apply_coord, ite_eq_left rfl, one_mul]
  · intro e _ he
    rw [glBasis_apply_coord, ite_eq_right he, zero_mul]
  · exact fun h => absurd hc h

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- `ℓ` is an eigenfunctional of the upper triangular matrix units with eigenvalues `μ`. -/
def IsBorelEigen (π : GLProd ℂ n →ₗ⁅ℂ⁆ Module.End ℂ V) (ℓ : V →ₗ[ℂ] ℂ) (μ : Coord n → ℂ) :
    Prop :=
  ∀ c ∈ upper n, ∀ v : V, ℓ (π (glBasis ℂ n c) v) = μ c * ℓ v

variable {π : GLProd ℂ n →ₗ⁅ℂ⁆ Module.End ℂ V} {ℓ : V →ₗ[ℂ] ℂ} {μ : Coord n → ℂ}

theorem IsBorelEigen.apply (h : IsBorelEigen π ℓ μ) {x : GLProd ℂ n} (hx : IsBUpper n x)
    (v : V) : ℓ (π x v) = muLin n μ x * ℓ v := by
  conv_lhs => rw [eq_sum_upper hx]
  rw [map_sum, LinearMap.sum_apply, map_sum, muLin, Finset.sum_mul]
  refine Finset.sum_congr rfl fun e he => ?_
  rw [map_smul, LinearMap.smul_apply, map_smul, h e he, smul_eq_mul, mul_assoc]

theorem exists_ne_zero_of_ne_zero (hℓ0 : ℓ ≠ 0) : ∃ v, ℓ v ≠ 0 := by
  by_contra h
  push Not at h
  exact hℓ0 (LinearMap.ext h)

/-- `μ` is a character of the Borel subalgebra. -/
theorem IsBorelEigen.muLin_lie (h : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) {x y : GLProd ℂ n}
    (hx : IsBUpper n x) (hy : IsBUpper n y) : muLin n μ ⁅x, y⁆ = 0 := by
  obtain ⟨v, hv⟩ := exists_ne_zero_of_ne_zero hℓ0
  have h1 := h.apply (hx.lie hy) v
  rw [LieHom.map_lie, Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply,
    Module.End.mul_apply, map_sub] at h1
  simp only [h.apply hx, h.apply hy] at h1
  have h2 : muLin n μ ⁅x, y⁆ * ℓ v = 0 := by rw [← h1]; ring
  exact (mul_eq_zero.mp h2).resolve_right hv

omit [Fintype ι] in
theorem lie_unit_diag (i : ι) {p q : Fin (n i)} (hpq : p ≠ q) :
    ⁅unit ℂ n i p p, unit ℂ n i p q⁆ = unit ℂ n i p q := by
  rw [Ring.lie_def, unit, unit, ← Pi.single_mul, ← Pi.single_mul,
    Matrix.single_mul_single_same, Matrix.single_mul_single_of_ne _ p q p hpq.symm, Pi.single_zero,
    sub_zero, mul_one]

/-- The eigenvalues of the strictly upper triangular matrix units vanish. -/
theorem IsBorelEigen.eq_zero (h : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) {c : Coord n}
    (hc : c.2.1 < c.2.2) : μ c = 0 := by
  obtain ⟨i, p, q⟩ := c
  have hcu : (⟨i, p, q⟩ : Coord n) ∈ upper n := mem_upper.mpr hc.le
  have hdu : (⟨i, p, p⟩ : Coord n) ∈ upper n := mem_upper.mpr le_rfl
  rw [← muLin_glBasis μ hcu, glBasis_apply, ← lie_unit_diag i hc.ne]
  have := h.muLin_lie hℓ0 (isBUpper_glBasis hdu) (isBUpper_glBasis hcu)
  rwa [glBasis_apply, glBasis_apply] at this

end Borel

/-! ## The right ideal of a Borel character -/

section RightIdeal

variable {ι : Type} [Fintype ι] [DecidableEq ι] (n : ι → ℕ)

local notation "U" => UniversalEnvelopingAlgebra ℂ (GLProd ℂ n)

local notation "UF" => degreeFiltration ℂ (GLProd ℂ n)

variable (μ : Coord n → ℂ)

/-- The shifted generator `E_c - μ_c`. -/
def shiftGen (c : Coord n) : U :=
  UniversalEnvelopingAlgebra.ι ℂ (glBasis ℂ n c) - algebraMap ℂ U (μ c)

/-- `P` lies in `∑_{c upper} (E_c - μ_c) U_M`. -/
def InJ (M : ℕ) (P : U) : Prop :=
  ∃ w : Coord n → U, (∀ c ∈ upper n, w c ∈ UF M) ∧ P = ∑ c ∈ upper n, shiftGen n μ c * w c

variable {n μ}

omit [DecidableEq ι] in
theorem ι_basis_mem (c : Coord n) : UniversalEnvelopingAlgebra.ι ℂ (glBasis ℂ n c) ∈ UF 1 := by
  rw [degreeFiltration_one]
  exact generator_mem_degreeOne ℂ _ _

omit [DecidableEq ι] in
theorem shiftGen_mem (c : Coord n) : shiftGen n μ c ∈ UF 1 :=
  Submodule.sub_mem _ (ι_basis_mem c) (algebraMap_mem_degreeFiltration ℂ _ _ _)

omit [DecidableEq ι] in
theorem InJ.zero (M : ℕ) : InJ n μ M 0 :=
  ⟨0, fun _ _ => Submodule.zero_mem _, by simp⟩

omit [DecidableEq ι] in
theorem InJ.add {M : ℕ} {P Q : U} (hP : InJ n μ M P) (hQ : InJ n μ M Q) :
    InJ n μ M (P + Q) := by
  obtain ⟨w, hw, rfl⟩ := hP
  obtain ⟨w', hw', rfl⟩ := hQ
  exact ⟨w + w', fun c hc => Submodule.add_mem _ (hw c hc) (hw' c hc), by
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]⟩

omit [DecidableEq ι] in
theorem InJ.smul {M : ℕ} {P : U} (hP : InJ n μ M P) (a : ℂ) : InJ n μ M (a • P) := by
  obtain ⟨w, hw, rfl⟩ := hP
  exact ⟨a • w, fun c hc => Submodule.smul_mem _ a (hw c hc), by
    simp only [Pi.smul_apply, mul_smul_comm, Finset.smul_sum]⟩

omit [DecidableEq ι] in
theorem InJ.sub {M : ℕ} {P Q : U} (hP : InJ n μ M P) (hQ : InJ n μ M Q) :
    InJ n μ M (P - Q) := by
  rw [sub_eq_add_neg, ← neg_one_smul ℂ Q]
  exact hP.add (hQ.smul _)

omit [DecidableEq ι] in
theorem InJ.mono {M M' : ℕ} (h : M ≤ M') {P : U} (hP : InJ n μ M P) : InJ n μ M' P := by
  obtain ⟨w, hw, rfl⟩ := hP
  exact ⟨w, fun c hc => degreeFiltration_mono ℂ _ h (hw c hc), rfl⟩

omit [DecidableEq ι] in
theorem InJ.mul_right {M K : ℕ} {P Q : U} (hP : InJ n μ M P) (hQ : Q ∈ UF K) :
    InJ n μ (M + K) (P * Q) := by
  obtain ⟨w, hw, rfl⟩ := hP
  exact ⟨fun c => w c * Q, fun c hc => mul_mem_degreeFiltration ℂ _ (hw c hc) hQ, by
    rw [Finset.sum_mul]; simp only [mul_assoc]⟩

omit [DecidableEq ι] in
theorem InJ.sum {α : Type*} (s : Finset α) {M : ℕ} {f : α → U} (h : ∀ a ∈ s, InJ n μ M (f a)) :
    InJ n μ M (∑ a ∈ s, f a) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using InJ.zero M
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact (h a (Finset.mem_insert_self a s)).add (ih fun b hb => h b (Finset.mem_insert_of_mem hb))

theorem inJ_shiftGen_mul {M : ℕ} {c : Coord n} (hc : c ∈ upper n) {w : U} (hw : w ∈ UF M) :
    InJ n μ M (shiftGen n μ c * w) := by
  refine ⟨fun c' => if c' = c then w else 0, fun c' _ => ?_, ?_⟩
  · dsimp only
    split_ifs
    exacts [hw, Submodule.zero_mem _]
  · simp only [mul_ite, mul_zero, Finset.sum_ite_eq', hc, ↓reduceIte]

/-! ### Symbols -/

theorem symbol_ι_basis_mul {M : ℕ} (c : Coord n) {w : U} (hw : w ∈ UF M) :
    (glSymbol ℂ n).symbol (M + 1) (UniversalEnvelopingAlgebra.ι ℂ (glBasis ℂ n c) * w) =
      X c * (glSymbol ℂ n).symbol M w := by
  have h1 := (glSymbol ℂ n).symbol_mul (ι_basis_mem c) hw
  rw [Nat.add_comm 1 M] at h1
  rw [h1, SymbolData.symbol_one_ι, AssocSymbol.symbolData_ξ_basis]

theorem symbol_shiftGen_mul {M : ℕ} (c : Coord n) {w : U} (hw : w ∈ UF M) :
    (glSymbol ℂ n).symbol (M + 1) (shiftGen n μ c * w) = X c * (glSymbol ℂ n).symbol M w := by
  rw [shiftGen, sub_mul, map_sub, ← Algebra.smul_def, map_smul,
    (glSymbol ℂ n).symbol_eq_zero_of_mem (Nat.lt_succ_self M) hw, smul_zero, sub_zero,
    symbol_ι_basis_mul c hw]

theorem symbol_sum_shiftGen {M : ℕ} {w : Coord n → U} (hw : ∀ c ∈ upper n, w c ∈ UF M) :
    (glSymbol ℂ n).symbol (M + 1) (∑ c ∈ upper n, shiftGen n μ c * w c) =
      ∑ c ∈ upper n, X c * (glSymbol ℂ n).symbol M (w c) := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun c hc => symbol_shiftGen_mul c (hw c hc)

/-! ### Commutators -/

omit [Fintype ι] [DecidableEq ι] in
theorem sub_algebraMap_comm (a b : U) (r s : ℂ) :
    (a - algebraMap ℂ U r) * (b - algebraMap ℂ U s) - (b - algebraMap ℂ U s) * (a - algebraMap ℂ U r) =
      a * b - b * a := by
  have hR : ∀ x : U, algebraMap ℂ U r * x = x * algebraMap ℂ U r := Algebra.commutes r
  have hS : ∀ x : U, algebraMap ℂ U s * x = x * algebraMap ℂ U s := Algebra.commutes s
  simp only [sub_mul, mul_sub]
  rw [hR b, hS a, hR (algebraMap ℂ U s)]
  abel

/-- `⁅E_c - μ_c, E_{c'} - μ_{c'}⁆ = ∑_e ⁅E_c, E_{c'}⁆_e (E_e - μ_e)` when `μ` is a character. -/
theorem shiftGen_comm
    (hμ : ∀ x y : GLProd ℂ n, IsBUpper n x → IsBUpper n y → muLin n μ ⁅x, y⁆ = 0)
    {c c' : Coord n} (hc : c ∈ upper n) (hc' : c' ∈ upper n) :
    shiftGen n μ c * shiftGen n μ c' - shiftGen n μ c' * shiftGen n μ c =
      ∑ e ∈ upper n, shiftGen n μ e *
        algebraMap ℂ U (⁅glBasis ℂ n c, glBasis ℂ n c'⁆ e.1 e.2.1 e.2.2) := by
  set x := ⁅glBasis ℂ n c, glBasis ℂ n c'⁆ with hxdef
  have hx : IsBUpper n x := (isBUpper_glBasis hc).lie (isBUpper_glBasis hc')
  have h1 : shiftGen n μ c * shiftGen n μ c' - shiftGen n μ c' * shiftGen n μ c =
      UniversalEnvelopingAlgebra.ι ℂ x := by
    rw [shiftGen, shiftGen, sub_algebraMap_comm, hxdef, LieHom.map_lie, Ring.lie_def]
  have h2 : ∀ e : Coord n, UniversalEnvelopingAlgebra.ι ℂ (x e.1 e.2.1 e.2.2 • glBasis ℂ n e) =
      shiftGen n μ e * algebraMap ℂ U (x e.1 e.2.1 e.2.2) +
        algebraMap ℂ U (x e.1 e.2.1 e.2.2 * μ e) := by
    intro e
    rw [map_smul, shiftGen, sub_mul, ← Algebra.commutes, ← Algebra.smul_def, ← map_mul,
      mul_comm (μ e), sub_add_cancel]
  rw [h1]
  conv_lhs => rw [eq_sum_upper hx]
  rw [map_sum]
  simp only [h2, Finset.sum_add_distrib, ← map_sum]
  have h3 : ∑ e ∈ upper n, x e.1 e.2.1 e.2.2 * μ e = 0 := hμ _ _ (isBUpper_glBasis hc)
    (isBUpper_glBasis hc')
  rw [h3, map_zero, add_zero]

/-! ### Descent -/

/-- One step of the descent: an element of `∑ (E_c - μ_c) U_{K+1}` lying in `U_{K+1}` lies in
`∑ (E_c - μ_c) U_K`. -/
theorem InJ.descend
    (hμ : ∀ x y : GLProd ℂ n, IsBUpper n x → IsBUpper n y → muLin n μ ⁅x, y⁆ = 0)
    {K : ℕ} {P : U} (h : InJ n μ (K + 1) P) (hP : P ∈ UF (K + 1)) : InJ n μ K P := by
  obtain ⟨w, hw, rfl⟩ := h
  let σ := (glSymbol ℂ n).symbol
  have h0 : ∑ c ∈ upper n, X c * σ (K + 1) (w c) = 0 := by
    rw [← symbol_sum_shiftGen hw]
    exact (glSymbol ℂ n).symbol_eq_zero_of_mem (by omega) hP
  obtain ⟨S, hSanti, hShom, hS⟩ := exists_antisymm_homogeneous (upper n)
    (fun c => σ (K + 1) (w c)) K (fun c hc => symbol_isHomogeneous n (hw c hc)) h0
  choose A hAmem hAsym using fun c c' => exists_symbol_eq n (hShom c c')
  set A' : Coord n → Coord n → U := fun c c' => (1 / 2 : ℂ) • (A c c' - A c' c) with hA'def
  have hA'anti : ∀ c c', A' c' c = -A' c c' := by
    intro c c'
    simp only [hA'def]
    rw [← smul_neg, neg_sub]
  have hA'mem : ∀ c c', A' c c' ∈ UF K := fun c c' =>
    Submodule.smul_mem _ _ (Submodule.sub_mem _ (hAmem c c') (hAmem c' c))
  have hA'sym : ∀ c c', σ K (A' c c') = S c c' := by
    intro c c'
    simp only [hA'def, map_smul, map_sub]
    erw [hAsym, hAsym]
    rw [hSanti c' c, sub_neg_eq_add, ← two_smul ℂ (S c c'), smul_smul]
    norm_num
  set w' : Coord n → U := fun c => w c - ∑ c' ∈ upper n, shiftGen n μ c' * A' c c' with hw'def
  have hw' : ∀ c ∈ upper n, w' c ∈ UF K := by
    intro c hc
    have hmem : w' c ∈ UF (K + 1) := Submodule.sub_mem _ (hw c hc) (Submodule.sum_mem _
      fun c' _ => by
        have := mul_mem_degreeFiltration ℂ _ (shiftGen_mem (μ := μ) c') (hA'mem c c')
        rwa [Nat.add_comm] at this)
    refine mem_degreeFiltration_of_symbol_eq_zero ℂ (GLProd ℂ n) (glBasis ℂ n) (glSymbol ℂ n)
      (fun c => AssocSymbol.symbolData_ξ_basis _ c) (sortedCoords_nodup n) (mem_sortedCoords n)
      hmem ?_
    have hSc := hS c hc
    rw [hw'def]
    simp only
    rw [map_sub, map_sum, hSc, sub_eq_zero]
    refine Finset.sum_congr rfl fun c' _ => ?_
    rw [symbol_shiftGen_mul c' (hA'mem c c'), hA'sym, mul_comm]
  set D : U := ∑ c ∈ upper n, ∑ c' ∈ upper n, shiftGen n μ c * shiftGen n μ c' * A' c c' with hD
  have hcomm : ∀ c ∈ upper n, ∀ c' ∈ upper n,
      InJ n μ K ((shiftGen n μ c * shiftGen n μ c' - shiftGen n μ c' * shiftGen n μ c) *
        A' c c') := by
    intro c hc c' hc'
    rw [shiftGen_comm hμ hc hc', Finset.sum_mul]
    refine InJ.sum _ fun e he => ?_
    rw [mul_assoc]
    exact inJ_shiftGen_mul he (by rw [← Algebra.smul_def]; exact Submodule.smul_mem _ _ (hA'mem c c'))
  have hswap : ∑ c ∈ upper n, ∑ c' ∈ upper n, shiftGen n μ c' * shiftGen n μ c * A' c c' = -D := by
    rw [Finset.sum_comm, hD, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun c' _ => ?_
    rw [hA'anti, mul_neg]
  have h2D : (2 : ℂ) • D = ∑ c ∈ upper n, ∑ c' ∈ upper n,
      (shiftGen n μ c * shiftGen n μ c' - shiftGen n μ c' * shiftGen n μ c) * A' c c' := by
    simp only [sub_mul, Finset.sum_sub_distrib]
    rw [hswap, ← hD, sub_neg_eq_add, two_smul]
  have hDJ : InJ n μ K D := by
    have h := (InJ.sum _ fun c hc => InJ.sum _ fun c' hc' => hcomm c hc c' hc').smul (1 / 2 : ℂ)
    rwa [← h2D, smul_smul, show (1 / 2 : ℂ) * 2 = 1 by norm_num, one_smul] at h
  have hsplit : ∑ c ∈ upper n, shiftGen n μ c * w c =
      ∑ c ∈ upper n, shiftGen n μ c * w' c + D := by
    rw [hD, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [hw'def]
    simp only [mul_sub, Finset.mul_sum, mul_assoc, sub_add_cancel]
  rw [hsplit]
  exact InJ.add ⟨w', hw', rfl⟩ hDJ

/-- **Descent.** An element of `∑ (E_c - μ_c) U_K` lying in `U_{N+1}` lies in
`∑ (E_c - μ_c) U_N`. -/
theorem InJ.descend_le
    (hμ : ∀ x y : GLProd ℂ n, IsBUpper n x → IsBUpper n y → muLin n μ ⁅x, y⁆ = 0)
    {N : ℕ} {P : U} (hP : P ∈ UF (N + 1)) : ∀ K, InJ n μ K P → InJ n μ N P := by
  intro K
  induction K with
  | zero => exact fun h => h.mono (Nat.zero_le _)
  | succ K ih =>
    intro h
    by_cases hK : K + 1 ≤ N
    · exact h.mono hK
    · exact ih (h.descend hμ (degreeFiltration_mono ℂ _ (by omega) hP))

/-! ### Annihilation by the eigenfunctional -/

variable {V : Type*} [AddCommGroup V] [Module ℂ V] {π : GLProd ℂ n →ₗ⁅ℂ⁆ Module.End ℂ V}
  {ℓ : V →ₗ[ℂ] ℂ}

omit [DecidableEq ι] in
theorem IsBorelEigen.apply_shiftGen (h : IsBorelEigen π ℓ μ) {c : Coord n} (hc : c ∈ upper n)
    (v : V) : ℓ (envelopingAction π (shiftGen n μ c) v) = 0 := by
  rw [shiftGen, map_sub, AlgHom.commutes, UniversalEnvelopingAlgebra.lift_ι_apply,
    LinearMap.sub_apply, map_sub, h c hc v, Module.algebraMap_end_apply, map_smul, smul_eq_mul,
    sub_self]

omit [DecidableEq ι] in
theorem IsBorelEigen.apply_of_inJ (h : IsBorelEigen π ℓ μ) {M : ℕ} {P : U} (hP : InJ n μ M P)
    (v : V) : ℓ (envelopingAction π P v) = 0 := by
  obtain ⟨w, -, rfl⟩ := hP
  rw [map_sum, LinearMap.sum_apply, map_sum]
  refine Finset.sum_eq_zero fun c hc => ?_
  rw [map_mul, Module.End.mul_apply]
  exact h.apply_shiftGen hc _

theorem IsBorelEigen.muLin_lie' (h : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) :
    ∀ x y : GLProd ℂ n, IsBUpper n x → IsBUpper n y → muLin n μ ⁅x, y⁆ = 0 :=
  fun _ _ hx hy => h.muLin_lie hℓ0 hx hy

/-! ### Central elements acting by zero -/

omit [DecidableEq ι] in
theorem upper_of_deg_eq_zero {c : Coord n} (hc : deg n c = 0) : c ∈ upper n := by
  rw [mem_upper, Fin.le_def]
  unfold deg at hc
  omega

/-- A word sorted by decreasing degree with total degree `0` is congruent to the product of the
eigenvalues of its letters. -/
theorem inJ_word_sub_prod (hμ0 : ∀ c : Coord n, 0 < deg n c → μ c = 0) :
    ∀ l : List (Coord n), l.Pairwise (fun c c' => deg n c' ≤ deg n c) →
      (l.map (deg n)).sum = 0 →
      InJ n μ l.length (word ℂ (GLProd ℂ n) (l.map (glBasis ℂ n)) -
        algebraMap ℂ U (l.map μ).prod)
  | [], _, _ => by simpa [word] using InJ.zero (n := n) (μ := μ) 0
  | c :: l, hsort, hsum => by
    rw [List.pairwise_cons] at hsort
    simp only [List.map_cons, List.sum_cons] at hsum
    simp only [List.map_cons, word_cons, List.prod_cons, List.length_cons]
    have hw := word_mem_degreeFiltration ℂ (GLProd ℂ n) (l.map (glBasis ℂ n))
    rw [List.length_map] at hw
    have hι : UniversalEnvelopingAlgebra.ι ℂ (glBasis ℂ n c) =
        shiftGen n μ c + algebraMap ℂ U (μ c) := by rw [shiftGen, sub_add_cancel]
    by_cases hc : 0 < deg n c
    · have hcu : c ∈ upper n := by
        rw [mem_upper, Fin.le_def]; unfold deg at hc; omega
      rw [hμ0 c hc, zero_mul, map_zero, sub_zero, hι, hμ0 c hc, map_zero, add_zero]
      exact (inJ_shiftGen_mul hcu hw).mono (Nat.le_succ _)
    · have hle : ∀ x ∈ l.map (deg n), x ≤ 0 := by
        intro x hx
        obtain ⟨c', hc', rfl⟩ := List.mem_map.mp hx
        exact (hsort.1 c' hc').trans (not_lt.mp hc)
      have hl0 : (l.map (deg n)).sum ≤ 0 := by simpa using List.sum_le_length_nsmul _ 0 hle
      have hc0 : deg n c = 0 := by omega
      have hl : (l.map (deg n)).sum = 0 := by omega
      have ih := inJ_word_sub_prod hμ0 l hsort.2 hl
      have he : UniversalEnvelopingAlgebra.ι ℂ (glBasis ℂ n c) *
            word ℂ (GLProd ℂ n) (l.map (glBasis ℂ n)) - algebraMap ℂ U (μ c * (l.map μ).prod) =
          shiftGen n μ c * word ℂ (GLProd ℂ n) (l.map (glBasis ℂ n)) +
            μ c • (word ℂ (GLProd ℂ n) (l.map (glBasis ℂ n)) - algebraMap ℂ U (l.map μ).prod) := by
        rw [hι, add_mul, map_mul, smul_sub, Algebra.smul_def, Algebra.smul_def]
        abel
      rw [he]
      exact ((inJ_shiftGen_mul (upper_of_deg_eq_zero hc0) hw).add (ih.smul _)).mono
        (Nat.le_succ _)

/-- **Central elements acting by `0` lie in the right ideal.** -/
theorem inJ_of_mem_center (hℓ : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) {z : U}
    (hz : z ∈ Subalgebra.center ℂ U) (hzV : envelopingAction π z = 0) : ∃ M, InJ n μ M z := by
  have hμ0 : ∀ c : Coord n, 0 < deg n c → μ c = 0 := fun c hc =>
    hℓ.eq_zero hℓ0 (by rw [Fin.lt_def]; unfold deg at hc; omega)
  obtain ⟨N, hN⟩ := exists_mem_degreeFiltration ℂ (GLProd ℂ n) z
  set bs := sortedCoords n
  set E := orderedMonomial ℂ (GLProd ℂ n) (glBasis ℂ n) bs
  have hz' := degreeFiltration_le_orderedSpan ℂ (GLProd ℂ n) (glBasis ℂ n)
    (sortedCoords_nodup n) (mem_sortedCoords n) N hN
  obtain ⟨c, hc, hzc⟩ := (Finsupp.mem_span_image_iff_linearCombination ℂ).mp hz'
  rw [Finsupp.linearCombination_apply, Finsupp.sum] at hzc
  have hgz : gradDer n z = 0 := by
    rw [gradDer_apply, Subalgebra.mem_center_iff.mp hz, sub_self]
  -- the Lagrange projection onto `D`-degree `0`
  set T : Finset ℂ := (c.support.image fun α => (wdeg n α : ℂ)).erase 0
  set lag : Polynomial ℂ := ∏ m ∈ T,
    (Polynomial.C ((0 : ℂ) - m)⁻¹ * (Polynomial.X - Polynomial.C m))
  have hlag : ∀ α ∈ c.support, lag.eval (wdeg n α : ℂ) = if wdeg n α = 0 then 1 else 0 := by
    intro α hα
    split_ifs with h
    · rw [h, Polynomial.eval_prod]
      refine Finset.prod_eq_one fun m hm => ?_
      have hm' : (0 : ℂ) - m ≠ 0 := sub_ne_zero.mpr (Finset.ne_of_mem_erase hm).symm
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_X]
      push_cast
      exact inv_mul_cancel₀ hm'
    · rw [Polynomial.eval_prod]
      refine Finset.prod_eq_zero (i := (wdeg n α : ℂ)) ?_ ?_
      · refine Finset.mem_erase.mpr ⟨?_, Finset.mem_image.mpr ⟨α, hα, rfl⟩⟩
        exact_mod_cast h
      · simp
  have hlag0 : lag.eval 0 = 1 := by
    rw [Polynomial.eval_prod]
    refine Finset.prod_eq_one fun m hm => ?_
    have hm' : (0 : ℂ) - m ≠ 0 := sub_ne_zero.mpr (Finset.ne_of_mem_erase hm).symm
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_X]
    exact inv_mul_cancel₀ hm'
  have hz0 : z = ∑ α ∈ c.support, (if wdeg n α = 0 then c α else 0) • E α := by
    have h1 : Polynomial.aeval (gradDer n) lag z = z := by
      rw [Module.End.aeval_apply_of_mem_apply_eq_smul (μ := (0 : ℂ)) (by rw [hgz, zero_smul]),
        hlag0, one_smul]
    rw [← h1, ← hzc, map_sum]
    refine Finset.sum_congr rfl fun α hα => ?_
    rw [map_smul, Module.End.aeval_apply_of_mem_apply_eq_smul
      (gradDer_orderedMonomial n α), hlag α hα, smul_smul]
    split_ifs <;> simp [E, bs]
  have hdegα : ∀ α ∈ c.support, α.degree ≤ N := fun α hα => hc hα
  have hexp : ∀ α : Coord n →₀ ℕ, (expand bs α).length = α.degree :=
    length_expand (sortedCoords_nodup n) (mem_sortedCoords n)
  have hsorted : ∀ α : Coord n →₀ ℕ,
      (expand bs α).Pairwise fun c c' => deg n c' ≤ deg n c := by
    intro α
    unfold expand
    refine List.pairwise_flatMap.mpr ⟨fun c _ => ?_, ?_⟩
    · exact List.pairwise_replicate.mpr (Or.inr le_rfl)
    · refine (sortedCoords_pairwise n).imp_of_mem fun {c c'} _ _ h => ?_
      intro x hx y hy
      rw [List.eq_of_mem_replicate hx, List.eq_of_mem_replicate hy]
      exact h
  set C : ℂ := ∑ α ∈ c.support, (if wdeg n α = 0 then c α else 0) * ((expand bs α).map μ).prod
  have hJ : InJ n μ N (z - algebraMap ℂ U C) := by
    have he : z - algebraMap ℂ U C = ∑ α ∈ c.support, (if wdeg n α = 0 then c α else 0) •
        (E α - algebraMap ℂ U ((expand bs α).map μ).prod) := by
      conv_lhs => rw [hz0]
      simp only [C, mul_sub, Finset.sum_sub_distrib, map_sum, map_mul, Algebra.smul_def]
    rw [he]
    refine InJ.sum _ fun α hα => ?_
    split_ifs with h
    · have := inJ_word_sub_prod hμ0 (expand bs α) (hsorted α) h
      rw [hexp] at this
      exact (this.mono (hdegα α hα)).smul _
    · rw [zero_smul]
      exact InJ.zero N
  obtain ⟨v, hv⟩ := exists_ne_zero_of_ne_zero hℓ0
  have hC : C = 0 := by
    have h := hℓ.apply_of_inJ hJ v
    rw [map_sub, hzV, AlgHom.commutes, zero_sub, LinearMap.neg_apply,
      Module.algebraMap_end_apply, map_neg, map_smul, smul_eq_mul, neg_eq_zero] at h
    exact (mul_eq_zero.mp h).resolve_right hv
  refine ⟨N, ?_⟩
  rwa [hC, map_zero, sub_zero] at hJ

/-- **The central ideal lies in the right ideal.** -/
theorem inJ_of_mem_centralIdeal (hℓ : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) {u : U}
    (hu : u ∈ centralIdeal n π) : ∃ M, InJ n μ M u := by
  have key : ∀ a : U, ∃ M, InJ n μ M (a * u) := by
    induction hu using Submodule.span_induction with
    | mem z hz =>
      intro a
      obtain ⟨M, hM⟩ := inJ_of_mem_center hℓ hℓ0 hz.1 hz.2
      obtain ⟨K, hK⟩ := exists_mem_degreeFiltration ℂ (GLProd ℂ n) a
      refine ⟨M + K, ?_⟩
      rw [Subalgebra.mem_center_iff.mp hz.1 a]
      exact hM.mul_right hK
    | zero => exact fun a => ⟨0, by rw [mul_zero]; exact InJ.zero 0⟩
    | add x y _ _ hx hy =>
      intro a
      obtain ⟨M, hM⟩ := hx a
      obtain ⟨M', hM'⟩ := hy a
      exact ⟨M + M', by rw [mul_add]; exact (hM.mono (by omega)).add (hM'.mono (by omega))⟩
    | smul b x _ hx =>
      intro a
      obtain ⟨M, hM⟩ := hx (a * b)
      exact ⟨M, by rw [smul_eq_mul, ← mul_assoc]; exact hM⟩
  simpa using key 1

omit [Fintype ι] [DecidableEq ι] in
variable (π) in
theorem mul_mem_centralIdeal {u : U} (hu : u ∈ centralIdeal n π) (a : U) :
    u * a ∈ centralIdeal n π := by
  induction hu using Submodule.span_induction generalizing a with
  | mem z hz =>
    rw [← Subalgebra.mem_center_iff.mp hz.1 a]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span hz)
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [add_mul]; exact Submodule.add_mem _ (hx a) (hy a)
  | smul b x _ hx => rw [smul_eq_mul, mul_assoc]; exact Ideal.mul_mem_left _ _ (hx a)

end RightIdeal

/-! ## Symbols of the central ideal -/

section Symbols

variable {ι : Type} [Fintype ι] [DecidableEq ι] {n : ι → ℕ}

local notation "U" => UniversalEnvelopingAlgebra ℂ (GLProd ℂ n)

local notation "UF" => degreeFiltration ℂ (GLProd ℂ n)

variable {μ : Coord n → ℂ} {V : Type*} [AddCommGroup V] [Module ℂ V]
  {π : GLProd ℂ n →ₗ⁅ℂ⁆ Module.End ℂ V} {ℓ : V →ₗ[ℂ] ℂ}

/-- The degree-`N` symbol of an element of degree at most `N` of the central ideal vanishes at
every point whose coordinates on and above the diagonal vanish. -/
theorem eval_symbol_eq_zero (hℓ : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) {N : ℕ} {u : U}
    (hu : u ∈ UF N) (huZ : u ∈ centralIdeal n π) {y : Coord n → ℂ}
    (hy : ∀ c ∈ upper n, y c = 0) : eval y ((glSymbol ℂ n).symbol N u) = 0 := by
  obtain ⟨K, hK⟩ := inJ_of_mem_centralIdeal hℓ hℓ0 huZ
  rcases N with _ | M
  · rw [degreeFiltration_zero] at hu
    obtain ⟨a, rfl⟩ := Submodule.mem_one.mp hu
    obtain ⟨v, hv⟩ := exists_ne_zero_of_ne_zero hℓ0
    have h := hℓ.apply_of_inJ hK v
    rw [AlgHom.commutes, Module.algebraMap_end_apply, map_smul, smul_eq_mul] at h
    rw [(mul_eq_zero.mp h).resolve_right hv, map_zero, map_zero, map_zero]
  · obtain ⟨w, hw, rfl⟩ := InJ.descend_le (hℓ.muLin_lie' hℓ0) hu K hK
    rw [symbol_sum_shiftGen hw, map_sum]
    refine Finset.sum_eq_zero fun c hc => ?_
    rw [map_mul, eval_X, hy c hc, zero_mul]

open Matrix in
/-- **Symbols of the central ideal.** If `ℓ ≠ 0` is an eigenfunctional of the upper triangular
matrix units, the degree-`N` symbol of every element of degree at most `N` of the ideal generated
by the central elements acting by `0` lies in the ideal generated by the coefficients of the
characteristic polynomials of the generic blocks. -/
theorem symbol_mem_charpolyIdeal (hℓ : IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) {N : ℕ} {u : U}
    (hu : u ∈ UF N) (huZ : u ∈ centralIdeal n π) :
    (glSymbol ℂ n).symbol N u ∈ charpolyIdeal n := by
  set W : Submodule ℂ (MvPolynomial (Coord n) ℂ) :=
    (UF N ⊓ (centralIdeal n π).restrictScalars ℂ).map ((glSymbol ℂ n).symbol N)
  have hWstab : ∀ (i : ι) (a b : Fin (n i)), a ≠ b → ∀ f ∈ W,
      coadDer ℂ n (unit ℂ n i a b) f ∈ W := by
    intro i a' b' _ f hf
    obtain ⟨Q, ⟨hQ, hQZ⟩, rfl⟩ := hf
    have hQZ' : Q ∈ centralIdeal n π := hQZ
    refine ⟨UniversalEnvelopingAlgebra.ι ℂ (unit ℂ n i a' b') * Q -
      Q * UniversalEnvelopingAlgebra.ι ℂ (unit ℂ n i a' b'), ⟨?_, ?_⟩, ?_⟩
    · have := commutator_mem_degreeFiltration ℂ (GLProd ℂ n)
        (show UniversalEnvelopingAlgebra.ι ℂ (unit ℂ n i a' b') ∈ UF 1 from gen_mem ℂ n i a' b') hQ
      simpa [Nat.add_comm] using this
    · exact Submodule.sub_mem _ (Ideal.mul_mem_left _ _ hQZ') (mul_mem_centralIdeal π hQZ' _)
    · exact (glSymbol ℂ n).symbol_commutator _ (coadDer ℂ n _).toLinearMap
        (coadDer_isLeibniz ℂ n _) (coadDer_ξ ℂ n _) hQ
  have hWvan : ∀ Y : ∀ i, Matrix (Fin (n i)) (Fin (n i)) ℂ,
      (∀ (i : ι) (p q : Fin (n i)), p ≤ q → Y i p q = 0) → Y ∈ zeroSet n W := by
    intro Y hY f hf
    obtain ⟨Q, ⟨hQ, hQZ⟩, rfl⟩ := hf
    exact eval_symbol_eq_zero hℓ hℓ0 hQ hQZ fun c hc => hY c.1 c.2.1 c.2.2 (mem_upper.mp hc)
  refine nilpotentConeIdeal n _ fun Mt hMt => ?_
  have hMtT : ∀ i, IsNilpotent (Mt i)ᵀ := fun i => by
    obtain ⟨k, hk⟩ := hMt i
    exact ⟨k, by rw [← Matrix.transpose_pow, hk, Matrix.transpose_zero]⟩
  choose g hg using fun i => exists_conj_strictUpper_field (Mt i)ᵀ (hMtT i)
  set G : ∀ i, Matrix (Fin (n i)) (Fin (n i)) ℂ := fun i => (g i : Matrix _ _ ℂ)ᵀ
  have hG : ∀ i, IsUnit (G i).det := fun i => by
    rw [Matrix.det_transpose]
    exact (Matrix.isUnit_iff_isUnit_det _).mp (g i).isUnit
  set Y : ∀ i, Matrix (Fin (n i)) (Fin (n i)) ℂ := fun i => (G i)⁻¹ * Mt i * G i
  have hY : Y ∈ zeroSet n W := by
    refine hWvan Y fun i p q hpq => ?_
    have h := hg i q p hpq
    rw [Matrix.coe_units_inv] at h
    have hT : Y i = ((g i : Matrix _ _ ℂ) * (Mt i)ᵀ * (g i : Matrix _ _ ℂ)⁻¹)ᵀ := by
      simp only [Y, G, Matrix.transpose_mul, Matrix.transpose_transpose,
        Matrix.transpose_nonsing_inv, Matrix.mul_assoc]
    rw [hT, Matrix.transpose_apply, h]
  have hconj := conj_mem_zeroSet hWstab G hG hY
  have hMt' : (fun i => G i * Y i * (G i)⁻¹) = Mt := by
    funext i
    simp only [Y, Matrix.mul_assoc]
    rw [Matrix.mul_nonsing_inv _ (hG i), Matrix.mul_one,
      Matrix.mul_nonsing_inv_cancel_left _ _ (hG i)]
  rw [hMt'] at hconj
  exact hconj _ ⟨u, ⟨hu, huZ⟩, rfl⟩

end Symbols

end BorelCentralIdeal

end Langlands.Archimedean.Kostant
