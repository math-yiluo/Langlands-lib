import Langlands.Representation.Archimedean.Kostant.BorelCentralIdeal

/-!
# Growth of `U(𝔤)` modulo the central ideal of a module with a Borel eigenfunctional

Let `π` be a representation of `𝔤 = ∏ᵢ 𝔤𝔩_{n i}(ℂ)` with a nonzero eigenfunctional `ℓ` of the
blockwise upper triangular matrix units, and let `m` be the number of coordinates outside the
last row of their block. `pow_le_finrank_map` says that the elements of degree at most `d` of
`U(𝔤)` span a space of dimension at least `(d + 1)^m / (m + 1)^m` modulo the ideal generated
by the central elements acting by `0`.

The ordered monomials `E^α` in the coordinates outside the last rows are linearly independent
modulo that ideal: the top-degree symbol of a combination is a nonzero polynomial in these
coordinates, it would lie in the ideal generated by the characteristic polynomial coefficients
(`BorelCentralIdeal.symbol_mem_charpolyIdeal`), and every nonzero element of that ideal has a
leading monomial divisible by a leading monomial `antidiag n b k` of a generator, which involves
the coordinate in the last row of block `b` and column `k`.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean.Kostant

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Algebra.UniversalEnveloping MvPolynomial

namespace BorelCentralGrowth

variable {ι : Type} [Fintype ι] [DecidableEq ι] (n : ι → ℕ)

local notation "U" => UniversalEnvelopingAlgebra ℂ (GLProd ℂ n)

local notation "UF" => degreeFiltration ℂ (GLProd ℂ n)

/-- The coordinates outside the last row of their block. -/
def offLast : Finset (Coord n) := Finset.univ.filter fun c => (c.2.1 : ℕ) + 1 < n c.1

variable {n}

omit [DecidableEq ι] in
theorem mem_offLast {c : Coord n} : c ∈ offLast n ↔ (c.2.1 : ℕ) + 1 < n c.1 := by
  simp [offLast]

omit [DecidableEq ι] in
/-- Block `i` has `n i (n i - 1)` coordinates outside its last row. -/
theorem card_offLast : (offLast n).card = ∑ i, n i * (n i - 1) := by
  have h : offLast n = Finset.univ.sigma fun i =>
      (Finset.univ.filter fun p : Fin (n i) => (p : ℕ) < n i - 1) ×ˢ Finset.univ := by
    ext ⟨i, p, q⟩
    simp only [offLast, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_sigma,
      Finset.mem_product, and_true]
    omega
  rw [h, Finset.card_sigma]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.card_product, Finset.card_univ, Fintype.card_fin, Fin.card_filter_val_lt, mul_comm]
  congr 1
  omega

/-! ## Polynomials in the coordinates outside the last rows -/

omit [DecidableEq ι] in
/-- A nonzero polynomial in the coordinates outside the last rows does not lie in the ideal
generated by the characteristic polynomial coefficients. -/
theorem not_mem_charpolyIdeal {f : MvPolynomial (Coord n) ℂ} (hf0 : f ≠ 0)
    (hf : ∀ α ∈ f.support, ∀ c, c ∉ offLast n → α c = 0) : f ∉ charpolyIdeal n := by
  intro h
  have hL := charpolyLeading n
  rw [NilpotentCone.charpolyIdeal_eq_span_gen hL] at h
  obtain ⟨j, hj⟩ := CoprimeGroebner.exists_degree_le (ord n) (NilpotentCone.gen n)
    (NilpotentCone.monic_gen hL) (NilpotentCone.degree_gen_disjoint hL) h hf0
  have hpos : 0 < n j.1 := Nat.lt_of_le_of_lt (Nat.zero_le _) j.2.isLt
  set c : Coord n := ⟨j.1, ⟨n j.1 - 1, by omega⟩, j.2⟩
  have hc : c ∉ offLast n := by
    rw [mem_offLast]
    simp only [c]
    omega
  have h1 : (ord n).degree (NilpotentCone.gen n j) c = 1 := by
    classical
    rw [NilpotentCone.degree_gen hL, antidiag_apply, ite_eq_left]
    exact ⟨rfl, by simp only [c]⟩
  have h2 := hf _ ((ord n).degree_mem_support_iff f |>.mpr hf0) c hc
  have := hj c
  omega

/-! ## Linear independence modulo the central ideal -/

variable {μ : Coord n → ℂ} {V : Type*} [AddCommGroup V] [Module ℂ V]
  {π : GLProd ℂ n →ₗ⁅ℂ⁆ Module.End ℂ V} {ℓ : V →ₗ[ℂ] ℂ}

/-- The ordered monomial `E^α` for the basis of matrix units, in decreasing degree order. -/
abbrev E (α : Coord n →₀ ℕ) : U := orderedMonomial ℂ (GLProd ℂ n) (glBasis ℂ n) (sortedCoords n) α

theorem E_mem (α : Coord n →₀ ℕ) {d : ℕ} (hd : α.degree ≤ d) : E α ∈ UF d :=
  degreeFiltration_mono ℂ _ hd (orderedMonomial_mem_degreeFiltration ℂ (GLProd ℂ n) (glBasis ℂ n)
    (sortedCoords_nodup n) (mem_sortedCoords n) α)

/-- The coefficients of the top degree `N` of a combination of ordered monomials outside the
last rows lying in the central ideal vanish. -/
theorem top_coeff_eq_zero (hℓ : BorelCentralIdeal.IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0)
    {S : Finset (Coord n →₀ ℕ)} (hS : ∀ α ∈ S, ∀ c, c ∉ offLast n → α c = 0) {N : ℕ}
    (hN : ∀ α ∈ S, α.degree ≤ N) (a : (Coord n →₀ ℕ) → ℂ)
    (h : ∑ α ∈ S, a α • E α ∈ centralIdeal n π) : ∀ α ∈ S, α.degree = N → a α = 0 := by
  have hP : ∑ α ∈ S, a α • E α ∈ UF N :=
    Submodule.sum_mem _ fun α hα => Submodule.smul_mem _ _ (E_mem α (hN α hα))
  have hmem := BorelCentralIdeal.symbol_mem_charpolyIdeal hℓ hℓ0 hP h
  set f := (glSymbol ℂ n).symbol N (∑ α ∈ S, a α • E α) with hfdef
  have hf : f = ∑ α ∈ S, a α • if α.degree = N then monomial α (1 : ℂ) else 0 := by
    rw [hfdef, map_sum]
    refine Finset.sum_congr rfl fun α hα => ?_
    rw [map_smul, symbol_orderedMonomial ℂ (GLProd ℂ n) (glBasis ℂ n) (glSymbol ℂ n)
      (fun c => AssocSymbol.symbolData_ξ_basis _ c) (sortedCoords_nodup n)
      (mem_sortedCoords n) (hN α hα)]
  have hcoeff : ∀ β, f.coeff β = if β ∈ S ∧ β.degree = N then a β else 0 := by
    intro β
    rw [hf, coeff_sum]
    by_cases hβ : β ∈ S
    · rw [Finset.sum_eq_single β]
      · by_cases hd : β.degree = N <;> simp [hβ, hd]
      · intro α _ hαβ
        split_ifs <;> simp [coeff_monomial, hαβ]
      · exact fun h => absurd hβ h
    · rw [Finset.sum_eq_zero, ite_eq_right (fun h => hβ h.1)]
      intro α hα
      have : α ≠ β := fun h => hβ (h ▸ hα)
      split_ifs <;> simp [coeff_monomial, this]
  intro α hα hαN
  by_contra hne
  refine not_mem_charpolyIdeal ?_ ?_ hmem
  · intro hf0
    have := hcoeff α
    rw [hf0, ite_eq_left ⟨hα, hαN⟩] at this
    exact hne (by simpa using this.symm)
  · intro β hβ c hc
    have hβS : β ∈ S := by
      by_contra hβS
      apply (mem_support_iff.mp hβ)
      rw [hcoeff, ite_eq_right fun h => hβS h.1]
    exact hS β hβS c hc

/-- **Linear independence.** A combination of ordered monomials in the coordinates outside the
last rows lying in the central ideal has vanishing coefficients. -/
theorem coeff_eq_zero (hℓ : BorelCentralIdeal.IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0) :
    ∀ (N : ℕ) (S : Finset (Coord n →₀ ℕ)), (∀ α ∈ S, ∀ c, c ∉ offLast n → α c = 0) →
      (∀ α ∈ S, α.degree ≤ N) → ∀ a : (Coord n →₀ ℕ) → ℂ,
        ∑ α ∈ S, a α • E α ∈ centralIdeal n π → ∀ α ∈ S, a α = 0 := by
  intro N
  induction N with
  | zero =>
    intro S hS hN a h α hα
    exact top_coeff_eq_zero hℓ hℓ0 hS hN a h α hα (Nat.le_zero.mp (hN α hα))
  | succ M ih =>
    intro S hS hN a h
    have htop := top_coeff_eq_zero hℓ hℓ0 hS hN a h
    set S' := S.filter fun α => α.degree ≤ M
    have hsum : ∑ α ∈ S, a α • E α = ∑ α ∈ S', a α • E α := by
      rw [Finset.sum_filter_of_ne]
      intro α hα hne
      by_contra hle
      exact hne (by rw [htop α hα (by have := hN α hα; omega), zero_smul])
    rw [hsum] at h
    have ih' := ih S' (fun α hα => hS α (Finset.mem_of_mem_filter α hα))
      (fun α hα => (Finset.mem_filter.mp hα).2) a h
    intro α hα
    by_cases hd : α.degree ≤ M
    · exact ih' α (Finset.mem_filter.mpr ⟨hα, hd⟩)
    · exact htop α hα (by have := hN α hα; omega)

/-! ## Counting -/

variable (n) in
/-- The exponents supported outside the last rows with all entries at most `e`. -/
def box (e : ℕ) : Finset (Coord n →₀ ℕ) :=
  (Fintype.piFinset fun c : Coord n => if c ∈ offLast n then Finset.range (e + 1) else {0}).map
    Finsupp.equivFunOnFinite.symm.toEmbedding

theorem mem_box {e : ℕ} {α : Coord n →₀ ℕ} :
    α ∈ box n e ↔ ∀ c, (c ∈ offLast n → α c ≤ e) ∧ (c ∉ offLast n → α c = 0) := by
  simp only [box, Finset.mem_map_equiv, Fintype.mem_piFinset, Equiv.symm_symm]
  refine forall_congr' fun c => ?_
  simp only [Finsupp.equivFunOnFinite_apply]
  split_ifs with hc
  · simp [hc]
  · simp [hc]

theorem card_box (e : ℕ) : (box n e).card = (e + 1) ^ (offLast n).card := by
  rw [box, Finset.card_map, Fintype.card_piFinset]
  simp only [apply_ite Finset.card, Finset.card_range, Finset.card_singleton]
  rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one]
  congr 1
  simp [offLast]

theorem degree_le_of_mem_box {e : ℕ} {α : Coord n →₀ ℕ} (hα : α ∈ box n e) :
    α.degree ≤ (offLast n).card * e := by
  rw [mem_box] at hα
  rw [Finsupp.degree_eq_sum, ← Finset.sum_filter_add_sum_filter_not Finset.univ
    (fun c => c ∈ offLast n)]
  have h1 : ∑ c ∈ Finset.univ.filter (fun c => c ∈ offLast n), α c ≤
      ∑ c ∈ Finset.univ.filter (fun c => c ∈ offLast n), e :=
    Finset.sum_le_sum fun c hc => (hα c).1 (Finset.mem_filter.mp hc).2
  have h2 : ∑ c ∈ Finset.univ.filter (fun c => c ∉ offLast n), α c = 0 :=
    Finset.sum_eq_zero fun c hc => (hα c).2 (Finset.mem_filter.mp hc).2
  rw [h2, add_zero]
  refine h1.trans (le_of_eq ?_)
  rw [Finset.sum_const, smul_eq_mul, Finset.filter_mem_eq_inter, Finset.univ_inter]

/-- **Growth modulo the central ideal.** If a linear map `T` on `U(𝔤)` vanishes on an element
`u` of degree at most `d` only if `u` lies in the ideal generated by the central elements acting
by `0`, then `T(U_d)` has dimension at least `(d + 1)^m / (m + 1)^m`, where `m` is the number of
coordinates outside the last rows. -/
theorem pow_le_finrank_map (hℓ : BorelCentralIdeal.IsBorelEigen π ℓ μ) (hℓ0 : ℓ ≠ 0)
    {F : Type*} [AddCommGroup F] [Module ℂ F] (T : U →ₗ[ℂ] F) (d : ℕ)
    (hT : ∀ u ∈ UF d, T u = 0 → u ∈ centralIdeal n π) :
    ((d : ℝ) + 1) ^ (offLast n).card ≤
      ((offLast n).card + 1 : ℝ) ^ (offLast n).card * Module.finrank ℂ ((UF d).map T) := by
  set m := (offLast n).card
  set e := d / (m + 1)
  have hme : m * e ≤ d := (Nat.mul_le_mul_right e (Nat.le_succ m)).trans (Nat.mul_div_le d (m + 1))
  have hde : d + 1 ≤ (m + 1) * (e + 1) := by
    have := Nat.lt_mul_div_succ d (Nat.succ_pos m)
    rw [Nat.mul_comm] at this
    simp only [e]
    linarith [Nat.mul_comm (m + 1) (d / (m + 1) + 1)]
  -- the family `T (E α)`, `α ∈ box n e`, is linearly independent
  set v : box n e → F := fun α => T (E α.1)
  have hv : LinearIndependent ℂ v := by
    rw [linearIndependent_iff']
    intro s g hg i hi
    set g' : (Coord n →₀ ℕ) → ℂ := fun α => if h : α ∈ box n e then g ⟨α, h⟩ else 0
    have hsum : ∑ i ∈ s, g i • E i.1 = ∑ α ∈ s.map (Function.Embedding.subtype _), g' α • E α := by
      rw [Finset.sum_map]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [Function.Embedding.subtype_apply, g', dite_eq_left j.2]
    have hS : ∀ α ∈ s.map (Function.Embedding.subtype _), α ∈ box n e := by
      intro α hα
      obtain ⟨j, -, rfl⟩ := Finset.mem_map.mp hα
      exact j.2
    have hmemd : ∑ i ∈ s, g i • E i.1 ∈ UF d :=
      Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _
        (E_mem _ ((degree_le_of_mem_box j.2).trans hme))
    have hT0 : T (∑ i ∈ s, g i • E i.1) = 0 := by
      rw [map_sum]
      simpa only [map_smul] using hg
    have hZ := hT _ hmemd hT0
    rw [hsum] at hZ
    have := coeff_eq_zero hℓ hℓ0 (m * e) _
      (fun α hα => fun c hc => ((mem_box.mp (hS α hα)) c).2 hc)
      (fun α hα => degree_le_of_mem_box (hS α hα)) g' hZ i.1
      (Finset.mem_map_of_mem _ hi)
    simpa only [g', dite_eq_left i.2] using this
  have hspan : Submodule.span ℂ (Set.range v) ≤ (UF d).map T := by
    rw [Submodule.span_le]
    rintro _ ⟨α, rfl⟩
    exact ⟨E α.1, E_mem _ ((degree_le_of_mem_box α.2).trans hme), rfl⟩
  have hcard : (e + 1) ^ m ≤ Module.finrank ℂ ((UF d).map T) := by
    have h1 := finrank_span_eq_card hv
    rw [Fintype.card_coe, card_box] at h1
    rw [← h1]
    exact Submodule.finrank_mono hspan
  have hde' : ((d : ℝ) + 1) ≤ ((m : ℝ) + 1) * ((e : ℝ) + 1) := by exact_mod_cast hde
  calc ((d : ℝ) + 1) ^ m ≤ (((m : ℝ) + 1) * ((e : ℝ) + 1)) ^ m :=
        pow_le_pow_left₀ (by positivity) hde' m
    _ = ((m : ℝ) + 1) ^ m * ((e : ℝ) + 1) ^ m := mul_pow _ _ _
    _ ≤ ((m : ℝ) + 1) ^ m * Module.finrank ℂ ((UF d).map T) := by
        gcongr
        exact_mod_cast hcard

end BorelCentralGrowth

end Langlands.Archimedean.Kostant
