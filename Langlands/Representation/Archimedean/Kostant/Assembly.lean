import Langlands.Representation.Archimedean.Kostant.Matumoto
import Langlands.Representation.Archimedean.Kostant.NilpotentCone
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.LinearAlgebra.Matrix.Charpoly.Univ

/-!
# Kostant's theorem for `∏ᵢ 𝔤𝔩_{n i}(ℂ)` from the nilpotent cone and the orbit statements

`maximallyFaithful_of` proves maximal faithfulness of a module with an infinitesimal character
and a nonzero Whittaker functional, assuming `NilpotentConeIdealStatement n` and
`OrbitVanishingStatement n`. Induction on the filtration degree `N`. For `P ∈ U_N` acting by `0`:

1. The symbols `σ_N(Q)` of the elements `Q ∈ U_N` acting by `0` form a space `W` that is stable
   under the coadjoint derivations (`symbol_commutator`, `coadDer_ξ`) and vanishes at the
   Whittaker point (Matumoto's lemma). By the orbit statement they vanish on the nilpotent cone,
   so by the nilpotent cone statement `σ_N(P)` lies in the ideal generated by the coefficients
   `χ_{i,k}` of the characteristic polynomials of the generic blocks.
2. `σ_N(P)` is homogeneous of degree `N` and `χ_{i,k}` of degree `n i - k`, so
   `σ_N(P) = ∑ a_{i,k} χ_{i,k}` with `a_{i,k}` homogeneous of degree `N - (n i - k)`; each
   `a_{i,k}` is the symbol of some `A_{i,k} ∈ U_{N - (n i - k)}`.
3. `χ_{i,k}` is the symbol of the central element `Z_{i,k} = zk i (n i - k)`, acting by a scalar
   `c_{i,k}`. Then `P' = P - ∑ A_{i,k} (Z_{i,k} - c_{i,k})` acts by `0` and has vanishing
   degree-`N` symbol, so `P' ∈ U_{N-1}`; by induction `P'` lies in the ideal generated by the
   central elements acting by `0`, hence so does `P`.
-/

noncomputable section

set_option autoImplicit false

-- Entries of tuples of matrices are applied through the `Matrix` definition.
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Archimedean.Kostant

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Algebra.UniversalEnveloping MvPolynomial

/-! ## Homogeneous components of products -/

section Homogeneous

variable {σ : Type*} {R : Type*} [CommRing R]

theorem homogeneousComponent_mul_of_isHomogeneous (f : MvPolynomial σ R)
    {g : MvPolynomial σ R} {e : ℕ} (hg : g.IsHomogeneous e) (d : ℕ) :
    homogeneousComponent d (f * g) =
      if e ≤ d then homogeneousComponent (d - e) f * g else 0 := by
  conv_lhs => rw [← sum_homogeneousComponent f, Finset.sum_mul, map_sum]
  have hterm : ∀ m, homogeneousComponent d (homogeneousComponent m f * g) =
      if m + e = d then homogeneousComponent m f * g else 0 := by
    intro m
    rw [homogeneousComponent_of_mem
      ((homogeneousComponent_isHomogeneous m f).mul hg : _ ∈ homogeneousSubmodule σ R (m + e))]
    simp only [eq_comm]
  simp only [hterm]
  split_ifs with hed
  · by_cases hmem : d - e ∈ Finset.range (f.totalDegree + 1)
    · rw [Finset.sum_eq_single (d - e)]
      · rw [ite_eq_left (by omega)]
      · intro m _ hm; rw [ite_eq_right (by omega)]
      · intro h; exact absurd hmem h
    · rw [Finset.sum_eq_zero, homogeneousComponent_eq_zero, zero_mul]
      · simp only [Finset.mem_range, not_lt] at hmem; omega
      · intro m hm
        rw [ite_eq_right]
        intro h
        apply hmem
        simp only [Finset.mem_range] at hm ⊢
        omega
  · refine Finset.sum_eq_zero fun m _ => ?_
    rw [ite_eq_right (by omega)]

end Homogeneous

/-! ## Symbols in `∏ᵢ 𝔤𝔩_{n i}(ℂ)` -/

variable {ι : Type} [Fintype ι] [DecidableEq ι] (n : ι → ℕ)

local notation "U" => UniversalEnvelopingAlgebra ℂ (GLProd ℂ n)

theorem symbol_isHomogeneous {N : ℕ} {P : U} (hP : P ∈ degreeFiltration ℂ (GLProd ℂ n) N) :
    ((glSymbol ℂ n).symbol N P).IsHomogeneous N := by
  have hP' := degreeFiltration_le_orderedSpan ℂ (GLProd ℂ n) (glBasis ℂ n)
    (sortedCoords_nodup n) (mem_sortedCoords n) N hP
  clear hP
  rw [← mem_homogeneousSubmodule]
  induction hP' using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨α, hα, rfl⟩ := hu
    rw [symbol_orderedMonomial ℂ (GLProd ℂ n) (glBasis ℂ n) (glSymbol ℂ n)
      (fun c => AssocSymbol.symbolData_ξ_basis _ c) (sortedCoords_nodup n)
      (mem_sortedCoords n) hα]
    split_ifs with h
    · exact isHomogeneous_monomial _ h
    · exact Submodule.zero_mem _
  | zero => simp
  | add u v _ _ hu hv => rw [map_add]; exact Submodule.add_mem _ hu hv
  | smul c u _ hu => rw [map_smul]; exact Submodule.smul_mem _ c hu

theorem exists_symbol_eq {m : ℕ} {a : MvPolynomial (Coord n) ℂ} (ha : a.IsHomogeneous m) :
    ∃ A ∈ degreeFiltration ℂ (GLProd ℂ n) m, (glSymbol ℂ n).symbol m A = a := by
  set E := orderedMonomial ℂ (GLProd ℂ n) (glBasis ℂ n) (sortedCoords n)
  have hdeg : ∀ α ∈ a.support, α.degree = m := by
    intro α hα
    have := ha (mem_support_iff.mp hα)
    rw [Finsupp.degree_eq_weight_one]
    exact this
  refine ⟨∑ α ∈ a.support, a.coeff α • E α, ?_, ?_⟩
  · refine Submodule.sum_mem _ fun α hα => Submodule.smul_mem _ _ ?_
    have := orderedMonomial_mem_degreeFiltration ℂ (GLProd ℂ n) (glBasis ℂ n)
      (sortedCoords_nodup n) (mem_sortedCoords n) α
    rwa [hdeg α hα] at this
  · conv_rhs => rw [as_sum a]
    rw [map_sum]
    refine Finset.sum_congr rfl fun α hα => ?_
    rw [map_smul, symbol_orderedMonomial ℂ (GLProd ℂ n) (glBasis ℂ n) (glSymbol ℂ n)
      (fun c => AssocSymbol.symbolData_ξ_basis _ c) (sortedCoords_nodup n)
      (mem_sortedCoords n) (hdeg α hα).le, ite_eq_left (hdeg α hα), smul_monomial, smul_eq_mul,
      mul_one]

/-! ## The generators of the nilpotent cone ideal -/

/-- The index set of the generators: block `i` and `k < n i`. -/
abbrev Gen := Σ i : ι, Fin (n i)

/-- The generator `χ_{i,k}`, the coefficient of `t^k` in the characteristic polynomial of the
generic block `i`. -/
def gens (j : Gen n) : MvPolynomial (Coord n) ℂ := (genericBlock n j.1).charpoly.coeff j.2

/-- The degree `n i - k` of `χ_{i,k}`. -/
def genDeg (j : Gen n) : ℕ := n j.1 - j.2

omit [Fintype ι] [DecidableEq ι] in
theorem genDeg_pos (j : Gen n) : 1 ≤ genDeg n j := by
  have := j.2.isLt; simp only [genDeg]; omega

omit [Fintype ι] [DecidableEq ι] in
theorem charpolyIdeal_eq : charpolyIdeal n = Ideal.span (Set.range (gens n)) := by
  rw [charpolyIdeal]
  congr 1
  ext f
  simp only [Set.mem_ofPred_eq, Set.mem_range]
  constructor
  · rintro ⟨i, k, hk, rfl⟩
    exact ⟨⟨i, ⟨k, hk⟩⟩, rfl⟩
  · rintro ⟨⟨i, k⟩, rfl⟩
    exact ⟨i, k, k.isLt, rfl⟩

omit [Fintype ι] [DecidableEq ι] in
theorem gens_isHomogeneous (j : Gen n) : (gens n j).IsHomogeneous (genDeg n j) := by
  have hmap : genericBlock n j.1 = (Matrix.mvPolynomialX (Fin (n j.1)) (Fin (n j.1)) ℂ).map
      ((rename fun pq : Fin (n j.1) × Fin (n j.1) => (⟨j.1, pq⟩ : Coord n)).toRingHom) := by
    ext p q
    simp [genericBlock, Matrix.mvPolynomialX]
  have h := Matrix.charpoly.univ_coeff_isHomogeneous ℂ (Fin (n j.1)) j.2 (genDeg n j)
    (by simp only [genDeg, Fintype.card_fin]; have := j.2.isLt; omega)
  rw [gens, hmap, Matrix.charpoly_map, Polynomial.coeff_map]
  exact h.rename_isHomogeneous

theorem symbol_zk_gens (j : Gen n) :
    (glSymbol ℂ n).symbol (genDeg n j) (zk ℂ n j.1 (genDeg n j)) = gens n j := by
  rw [symbol_zk ℂ n j.1 (genDeg n j) (by simp only [genDeg]; omega), gens, ← blockMatrix_complex]
  congr 1
  simp only [genDeg]
  have := j.2.isLt
  omega

/-! ## The induction -/

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (π : GLProd ℂ n →ₗ⁅ℂ⁆ Module.End ℂ V)

/-- The ideal generated by the central elements acting by `0`. -/
abbrev centralIdeal : Ideal U :=
  Ideal.span {z | z ∈ Subalgebra.center ℂ U ∧ envelopingAction π z = 0}

variable {π}

theorem mem_centralIdeal_of (hNC : NilpotentConeIdealStatement n)
    (hOrb : OrbitVanishingStatement n) (hχ : HasInfinitesimalCharacter π) {ℓ : V →ₗ[ℂ] ℂ}
    (hℓ0 : ℓ ≠ 0) {a : ∀ i, Fin (n i) → ℂ}
    (ha : ∀ (i : ι) (p : Fin (n i)), (p : ℕ) + 1 < n i → a i p ≠ 0)
    (hW : IsWhittaker n π a ℓ) :
    ∀ (N : ℕ) (P : U), P ∈ degreeFiltration ℂ (GLProd ℂ n) N → envelopingAction π P = 0 →
      P ∈ centralIdeal n π := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro P hP hPV
  rcases N with _ | M
  · -- `P` is a scalar acting by `0`
    rw [degreeFiltration_zero] at hP
    obtain ⟨c, rfl⟩ := Submodule.mem_one.mp hP
    exact Ideal.subset_span ⟨Subalgebra.algebraMap_mem _ c, hPV⟩
  set N := M + 1
  set σP := (glSymbol ℂ n).symbol N P
  -- the space of symbols of elements of `U_N` acting by `0`
  set W : Submodule ℂ (MvPolynomial (Coord n) ℂ) :=
    (degreeFiltration ℂ (GLProd ℂ n) N ⊓
      LinearMap.ker (envelopingAction π).toLinearMap).map ((glSymbol ℂ n).symbol N)
  have hWstab : ∀ (i : ι) (a b : Fin (n i)), a ≠ b → ∀ f ∈ W,
      coadDer ℂ n (unit ℂ n i a b) f ∈ W := by
    intro i a' b' _ f hf
    obtain ⟨Q, ⟨hQ, hQV⟩, rfl⟩ := hf
    refine ⟨UniversalEnvelopingAlgebra.ι ℂ (unit ℂ n i a' b') * Q -
      Q * UniversalEnvelopingAlgebra.ι ℂ (unit ℂ n i a' b'), ⟨?_, ?_⟩, ?_⟩
    · have := commutator_mem_degreeFiltration ℂ (GLProd ℂ n)
        (show UniversalEnvelopingAlgebra.ι ℂ (unit ℂ n i a' b') ∈
          degreeFiltration ℂ (GLProd ℂ n) 1 from gen_mem ℂ n i a' b') hQ
      simpa [Nat.add_comm] using this
    · have hQV' : envelopingAction π Q = 0 := LinearMap.mem_ker.mp hQV
      rw [SetLike.mem_coe, LinearMap.mem_ker, AlgHom.toLinearMap_apply, map_sub, map_mul, map_mul,
        hQV', mul_zero, zero_mul, sub_zero]
    · exact (glSymbol ℂ n).symbol_commutator _ (coadDer ℂ n _).toLinearMap
        (coadDer_isLeibniz ℂ n _) (coadDer_ξ ℂ n _) hQ
  have hWvan : ∀ f ∈ W, eval (whitPoint n a) f = 0 := by
    intro f hf
    obtain ⟨Q, ⟨hQ, hQV⟩, rfl⟩ := hf
    exact eval_symbol_eq_zero n hW hℓ0 hQ (LinearMap.mem_ker.mp hQV)
  have hσW : σP ∈ W := ⟨P, ⟨hP, LinearMap.mem_ker.mpr hPV⟩, rfl⟩
  have hnil := hOrb W hWstab a ha hWvan σP hσW
  have hK : σP ∈ Ideal.span (Set.range (gens n)) := by
    rw [← charpolyIdeal_eq]; exact hNC σP hnil
  obtain ⟨f, hf⟩ := Ideal.mem_span_range_iff_exists_fun.mp hK
  -- homogeneous decomposition
  set coef : Gen n → MvPolynomial (Coord n) ℂ := fun j =>
    if genDeg n j ≤ N then homogeneousComponent (N - genDeg n j) (f j) else 0
  have hcoef : ∀ j, (coef j).IsHomogeneous (N - genDeg n j) := by
    intro j
    simp only [coef]
    split_ifs
    · exact homogeneousComponent_isHomogeneous _ _
    · exact isHomogeneous_zero _ _ _
  have hdecomp : σP = ∑ j, coef j * gens n j := by
    have h1 : σP = homogeneousComponent N σP :=
      (homogeneousComponent_of_mem (symbol_isHomogeneous n hP) ▸ ite_eq_left rfl).symm
    rw [h1, ← hf, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [homogeneousComponent_mul_of_isHomogeneous _ (gens_isHomogeneous n j)]
    simp only [coef]
    split_ifs <;> simp
  -- lifts and central elements
  choose A hAmem hAsym using fun j => exists_symbol_eq n (hcoef j)
  choose cst hcst using fun j : Gen n =>
    hχ (zk ℂ n j.1 (genDeg n j)) (zk_mem_center ℂ n j.1 (genDeg n j))
  set Z' : Gen n → U := fun j => zk ℂ n j.1 (genDeg n j) - algebraMap ℂ U (cst j)
  have hZ'mem : ∀ j, Z' j ∈ centralIdeal n π := by
    intro j
    refine Ideal.subset_span ⟨Subalgebra.sub_mem _ (zk_mem_center ℂ n j.1 (genDeg n j))
      (Subalgebra.algebraMap_mem _ _), ?_⟩
    simp only [Z', map_sub, hcst, AlgHom.commutes, sub_self]
  set R' : U := ∑ j, (if genDeg n j ≤ N then A j * Z' j else 0)
  have hR'mem : R' ∈ centralIdeal n π := by
    refine Ideal.sum_mem _ fun j _ => ?_
    split_ifs
    · exact Ideal.mul_mem_left _ _ (hZ'mem j)
    · exact Submodule.zero_mem _
  have hR'filt : R' ∈ degreeFiltration ℂ (GLProd ℂ n) N := by
    refine Submodule.sum_mem _ fun j _ => ?_
    split_ifs with hj
    · have hZ : Z' j ∈ degreeFiltration ℂ (GLProd ℂ n) (genDeg n j) :=
        Submodule.sub_mem _ (zk_mem ℂ n j.1 (genDeg n j))
          (algebraMap_mem_degreeFiltration ℂ _ _ _)
      have := mul_mem_degreeFiltration ℂ _ (hAmem j) hZ
      rwa [show N - genDeg n j + genDeg n j = N by omega] at this
    · exact Submodule.zero_mem _
  have hR'V : envelopingAction π R' = 0 := by
    simp only [R', map_sum]
    refine Finset.sum_eq_zero fun j _ => ?_
    split_ifs
    · rw [map_mul]
      have : envelopingAction π (Z' j) = 0 := by
        simp only [Z', map_sub, hcst, AlgHom.commutes, sub_self]
      rw [this, mul_zero]
    · exact map_zero _
  have hR'sym : (glSymbol ℂ n).symbol N R' = σP := by
    rw [hdecomp, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    split_ifs with hj
    · have hAlow : (glSymbol ℂ n).symbol N (A j) = 0 :=
        (glSymbol ℂ n).symbol_eq_zero_of_mem (by have := genDeg_pos n j; omega) (hAmem j)
      have hmul := (glSymbol ℂ n).symbol_mul (hAmem j) (zk_mem ℂ n j.1 (genDeg n j))
      rw [show N - genDeg n j + genDeg n j = N by omega] at hmul
      simp only [Z', mul_sub, map_sub, hmul, hAsym, symbol_zk_gens, ← Algebra.commutes,
        ← Algebra.smul_def, map_smul, hAlow, smul_zero, sub_zero]
    · simp only [coef, ite_eq_right hj, zero_mul, map_zero]
  -- the remainder lies in lower degree
  have hP'filt : P - R' ∈ degreeFiltration ℂ (GLProd ℂ n) M :=
    mem_degreeFiltration_of_symbol_eq_zero ℂ (GLProd ℂ n) (glBasis ℂ n) (glSymbol ℂ n)
      (fun c => AssocSymbol.symbolData_ξ_basis _ c) (sortedCoords_nodup n) (mem_sortedCoords n)
      (Submodule.sub_mem _ hP hR'filt) (by rw [map_sub, hR'sym, sub_self])
  have hP'V : envelopingAction π (P - R') = 0 := by rw [map_sub, hPV, hR'V, sub_zero]
  have := ih M (Nat.lt_succ_self M) (P - R') hP'filt hP'V
  simpa using Ideal.add_mem _ this hR'mem

/-- Kostant's theorem for `∏ᵢ 𝔤𝔩_{n i}(ℂ)`, assuming the nilpotent cone and orbit statements. -/
theorem maximallyFaithful_of (hNC : NilpotentConeIdealStatement n)
    (hOrb : OrbitVanishingStatement n) (hχ : HasInfinitesimalCharacter π) {ℓ : V →ₗ[ℂ] ℂ}
    (hℓ0 : ℓ ≠ 0) {a : ∀ i, Fin (n i) → ℂ}
    (ha : ∀ (i : ι) (p : Fin (n i)), (p : ℕ) + 1 < n i → a i p ≠ 0)
    (hW : IsWhittaker n π a ℓ) : IsMaximallyFaithful π := by
  intro u hu
  obtain ⟨N, hN⟩ := exists_mem_degreeFiltration ℂ (GLProd ℂ n) u
  exact mem_centralIdeal_of n hNC hOrb hχ hℓ0 ha hW N u hN hu

end Langlands.Archimedean.Kostant
