import Langlands.Representation.Archimedean.PrincipalSeriesExtension
import Langlands.Representation.Archimedean.ComplexStandardNontrivialProof

/-!
# Gram expressions are `O(n)`-finite principal-series functions

The Library module `PrincipalSeriesGramFormula` shows that every `O(n)`-finite function of a
real principal series is a Gram expression `gramExpression s P` with
`s = shiftedExponent n e`. This module proves the converse construction: for every polynomial
`P` with the sign parity of the characters, `g ↦ gramExpression s P (g)` is a smooth
`O(n)`-finite function of the principal series (`gramFunction_mem_kFiniteFunctions`), and its
value at the identity is `P(1)` (`gramFunction_one`).

* Right translation by `k ∈ O(n)` leaves the Gram determinants unchanged and multiplies the
  normalized Gram columns `κ̂_{ij}` on the right by `k` (`gramEntry_mul`), so the function lies
  in the subalgebra generated by finitely many `O(n)`-finite functions.
* Smoothness and the left `B`-equivariance come from the Library module
  `PrincipalSeriesExtension`: the Gram function is the extension of the polynomial function
  `κ ↦ P(κ)` on `O(n)` (`gramFunction_eq_extension`), and the sign parity of `P` is the
  equivariance hypothesis of `PrincipalSeriesExtension.extension_mul_left`.
-/

noncomputable section

open Matrix

open scoped Manifold ContDiff Matrix.Norms.Operator

namespace Langlands.Archimedean

open Langlands.GeneralLinear Langlands.LocalFactor.Archimedean GramFormula

namespace RealGramFunction

set_option autoImplicit false

-- The charts on units need reduction through the normed-ring instances of matrices.
set_option backward.isDefEq.respectTransparency false

/-! ## Right multiplication by orthogonal matrices -/

section Ring

variable {R : Type*} [CommRing R] {n : ℕ}

theorem paddedGram_mul_orthogonal {k : Matrix (Fin n) (Fin n) R} (hk : k * kᵀ = 1)
    (x : Matrix (Fin n) (Fin n) R) (i : ℕ) : paddedGram i (x * k) = paddedGram i x := by
  ext p q
  simp only [paddedGram, Matrix.of_apply]
  rw [Matrix.transpose_mul, Matrix.mul_assoc, ← Matrix.mul_assoc k, hk, Matrix.one_mul]

theorem gram_mul_orthogonal {k : Matrix (Fin n) (Fin n) R} (hk : k * kᵀ = 1)
    (x : Matrix (Fin n) (Fin n) R) (i : ℕ) : gram i (x * k) = gram i x := by
  rw [gram, gram, paddedGram_mul_orthogonal hk]

theorem gramColumnVector_mul (i j : Fin n) (x k : Matrix (Fin n) (Fin n) R) :
    gramColumnVector i j (x * k) = ∑ m, k m j • gramColumnVector i m x := by
  funext p
  simp only [gramColumnVector, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  split_ifs
  · rw [Matrix.mul_apply]
    exact Finset.sum_congr rfl fun m _ => mul_comm _ _
  · simp

/-- The determinant is linear in a column. -/
theorem det_updateCol_sum_smul (M : Matrix (Fin n) (Fin n) R) (i : Fin n) {ι : Type*}
    (s : Finset ι) (c : ι → R) (v : ι → Fin n → R) :
    (M.updateCol i (∑ m ∈ s, c m • v m)).det = ∑ m ∈ s, c m * (M.updateCol i (v m)).det := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty, Finset.sum_empty]
    exact Matrix.det_eq_zero_of_column_eq_zero i fun p => by simp
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, Matrix.det_updateCol_add,
      Matrix.det_updateCol_smul, ih]

theorem gramColumn_mul_orthogonal {k : Matrix (Fin n) (Fin n) R} (hk : k * kᵀ = 1)
    (x : Matrix (Fin n) (Fin n) R) (i j : Fin n) :
    gramColumn i j (x * k) = ∑ m, k m j * gramColumn i m x := by
  rw [gramColumn, paddedGram_mul_orthogonal hk, gramColumnVector_mul, det_updateCol_sum_smul]
  rfl

end Ring

/-! ## The function on `GL_n(ℝ)` -/

variable {n : ℕ}

/-- The normalized Gram column `κ̂_{ij}(Z) = gramColumn i j Z · G_i(Z)^(-1/2) G_{i+1}(Z)^(-1/2)`. -/
def gramEntry (Z : Matrix (Fin n) (Fin n) ℂ) (i j : Fin n) : ℂ :=
  gramColumn i j Z * gram (i : ℕ) Z ^ (-(1 / 2 : ℂ)) * gram ((i : ℕ) + 1) Z ^ (-(1 / 2 : ℂ))

/-- The Gram-determinant factor `∏ₗ G_l(Z)^(s_l/2) G_{l+1}(Z)^(-s_l/2)`. -/
def gramFactor (s : Fin n → ℂ) (Z : Matrix (Fin n) (Fin n) ℂ) : ℂ :=
  ∏ l : Fin n, gram (l : ℕ) Z ^ (s l / 2) * gram ((l : ℕ) + 1) Z ^ (-(s l / 2))

theorem gramExpression_eq (s : Fin n → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ)
    (Z : Matrix (Fin n) (Fin n) ℂ) :
    gramExpression s P Z =
      gramFactor s Z * MvPolynomial.eval (fun ij : Fin n × Fin n => gramEntry Z ij.1 ij.2) P :=
  rfl

/-- The Gram expression of `s` and `P` as a function on `GL_n(ℝ)`. -/
def gramFunction (s : Fin n → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ) :
    Langlands.GeneralLinear n ℝ → ℂ :=
  fun g => gramExpression s P (complexify (g : Matrix (Fin n) (Fin n) ℝ))

theorem complexify_mul (x y : Matrix (Fin n) (Fin n) ℝ) :
    complexify (x * y) = complexify x * complexify y :=
  Matrix.map_mul

theorem complexify_orthogonal {k : Matrix (Fin n) (Fin n) ℝ} (hk : k * kᵀ = 1) :
    complexify k * (complexify k)ᵀ = 1 := by
  rw [← Matrix.transpose_map, ← complexify_mul, hk]
  exact Matrix.map_one _ (map_zero _) (map_one _)

theorem gramEntry_mul {k : Matrix (Fin n) (Fin n) ℝ} (hk : k * kᵀ = 1)
    (x : Matrix (Fin n) (Fin n) ℝ) (i j : Fin n) :
    gramEntry (complexify (x * k)) i j =
      ∑ m, ((k m j : ℝ) : ℂ) * gramEntry (complexify x) i m := by
  have hk' := complexify_orthogonal hk
  rw [gramEntry, complexify_mul, gramColumn_mul_orthogonal hk', gram_mul_orthogonal hk',
    gram_mul_orthogonal hk', Finset.sum_mul, Finset.sum_mul]
  refine Finset.sum_congr rfl fun m _ => ?_
  simp only [gramEntry, Matrix.map_apply, Complex.ofRealHom_eq_coe]
  ring

theorem gramFactor_mul {k : Matrix (Fin n) (Fin n) ℝ} (hk : k * kᵀ = 1) (s : Fin n → ℂ)
    (x : Matrix (Fin n) (Fin n) ℝ) :
    gramFactor s (complexify (x * k)) = gramFactor s (complexify x) := by
  have hk' := complexify_orthogonal hk
  simp only [gramFactor, complexify_mul, gram_mul_orthogonal hk']

/-! ## `O(n)`-finiteness -/

/-- Polynomials in functions of a subalgebra lie in the subalgebra. -/
theorem eval_mem_subalgebra {G σ : Type*} (S : Subalgebra ℂ (G → ℂ)) {v : σ → G → ℂ}
    (hv : ∀ i, v i ∈ S) (P : MvPolynomial σ ℂ) :
    (fun x => MvPolynomial.eval (fun i => v i x) P) ∈ S := by
  induction P using MvPolynomial.induction_on with
  | C a =>
    have e : (fun x : G => MvPolynomial.eval (fun i => v i x) (MvPolynomial.C a)) =
        algebraMap ℂ (G → ℂ) a := by
      ext x
      simp
    rw [e]
    exact S.algebraMap_mem a
  | add p q hp hq =>
    have e : (fun x : G => MvPolynomial.eval (fun i => v i x) (p + q)) =
        (fun x => MvPolynomial.eval (fun i => v i x) p) +
          fun x => MvPolynomial.eval (fun i => v i x) q := by
      ext x
      simp
    rw [e]
    exact S.add_mem hp hq
  | mul_X p i hp =>
    have e : (fun x : G => MvPolynomial.eval (fun i => v i x) (p * MvPolynomial.X i)) =
        (fun x => MvPolynomial.eval (fun i => v i x) p) * v i := by
      ext x
      simp
    rw [e]
    exact S.mul_mem hp (hv i)

theorem gramEntryFn_mem (i j : Fin n) :
    (fun g : Langlands.GeneralLinear n ℝ =>
      gramEntry (complexify (g : Matrix (Fin n) (Fin n) ℝ)) i j) ∈
        kFiniteSubalgebra (unitaryCompact ℝ n) := by
  have : FiniteDimensional ℂ (Submodule.span ℂ (Set.range fun m : Fin n =>
      fun g : Langlands.GeneralLinear n ℝ =>
        gramEntry (complexify (g : Matrix (Fin n) (Fin n) ℝ)) i m)) :=
    FiniteDimensional.span_of_finite ℂ (Set.finite_range _)
  refine mem_kFiniteSubalgebra_of_le _ (Submodule.span ℂ (Set.range fun m : Fin n =>
    fun g : Langlands.GeneralLinear n ℝ =>
      gramEntry (complexify (g : Matrix (Fin n) (Fin n) ℝ)) i m)) fun k hk => ?_
  have e : Whittaker.rightTranslation ℂ _ k (fun g : Langlands.GeneralLinear n ℝ =>
        gramEntry (complexify (g : Matrix (Fin n) (Fin n) ℝ)) i j) =
      ∑ m : Fin n, (((k : Matrix (Fin n) (Fin n) ℝ) m j : ℝ) : ℂ) •
        fun g : Langlands.GeneralLinear n ℝ =>
          gramEntry (complexify (g : Matrix (Fin n) (Fin n) ℝ)) i m := by
    ext g
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    show gramEntry (complexify ((g * k : Langlands.GeneralLinear n ℝ) :
      Matrix (Fin n) (Fin n) ℝ)) i j = _
    rw [Units.val_mul, gramEntry_mul (mul_transpose_eq_one_of_mem hk)]
  rw [e]
  exact Submodule.sum_mem _ fun m _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨m, rfl⟩)

theorem gramFactorFn_mem (s : Fin n → ℂ) :
    (fun g : Langlands.GeneralLinear n ℝ =>
      gramFactor s (complexify (g : Matrix (Fin n) (Fin n) ℝ))) ∈
        kFiniteSubalgebra (unitaryCompact ℝ n) := by
  refine mem_kFiniteSubalgebra_of_invariant _ fun k hk => ?_
  ext g
  show gramFactor s (complexify ((g * k : Langlands.GeneralLinear n ℝ) :
    Matrix (Fin n) (Fin n) ℝ)) = _
  rw [Units.val_mul, gramFactor_mul (mul_transpose_eq_one_of_mem hk)]

theorem gramFunction_mem_kFiniteVectors (s : Fin n → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ) :
    gramFunction s P ∈
      kFiniteVectors (Whittaker.rightTranslation ℂ (Langlands.GeneralLinear n ℝ))
        (unitaryCompact ℝ n) := by
  let v : Fin n × Fin n → Langlands.GeneralLinear n ℝ → ℂ := fun ij g =>
    gramEntry (complexify (g : Matrix (Fin n) (Fin n) ℝ)) ij.1 ij.2
  have h₁ := gramFactorFn_mem (n := n) s
  have h₂ : (fun g => MvPolynomial.eval (fun ij => v ij g) P) ∈
      kFiniteSubalgebra (unitaryCompact ℝ n) :=
    eval_mem_subalgebra (kFiniteSubalgebra (unitaryCompact ℝ n)) (v := v)
      (fun ij => gramEntryFn_mem ij.1 ij.2) P
  have h := Subalgebra.mul_mem _ h₁ h₂
  exact h

/-! ## Smoothness and the principal-series law -/

/-- The polynomial function `κ ↦ P(κ)` on `O(n)`. -/
def orthogonalEval (P : MvPolynomial (Fin n × Fin n) ℂ) (κ : Matrix.unitaryGroup (Fin n) ℝ) : ℂ :=
  MvPolynomial.eval (fun ij => ((κ : Matrix (Fin n) (Fin n) ℝ) ij.1 ij.2 : ℂ)) P

/-- The Gram function is the Library's extension of the polynomial function `κ ↦ P(κ)`. -/
theorem gramFunction_eq_extension (s : Fin n → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ) :
    gramFunction s P = PrincipalSeriesExtension.extension s (orthogonalEval P) :=
  funext fun g => (PrincipalSeriesExtension.extension_eq_gramExpression s (fun _ => rfl) g).symm

theorem contMDiff_gramFunction (s : Fin n → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ) :
    ContMDiff (matrixModel ℝ n) 𝓘(ℝ, ℂ) ∞ (gramFunction s P) :=
  contMDiff_of_contDiffOn (PrincipalSeriesExtension.contDiffOn_gramExpression s P) fun _ => rfl

/-- `P` has the sign parity of the characters `χ`: changing the signs of the rows of the argument
by the signs of `a` multiplies the value by `∏ₗ χ_l(sgn a_l)`. -/
def HasSignParity (χ : ℕ → ℝˣ → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ) : Prop :=
  ∀ (a : Fin n → ℝˣ) (Y : Fin n × Fin n → ℂ),
    MvPolynomial.eval (fun ij => ((signReal (a ij.1) : ℝ) : ℂ) * Y ij) P =
      (∏ l : Fin n, χ l (signUnit (a l))) * MvPolynomial.eval Y P

theorem principalSeriesCharacter_signUnit (χ : ℕ → ℝˣ → ℂ) (a : Fin n → ℝˣ) :
    principalSeriesCharacter ℝ n χ (fun l => signUnit (a l)) =
      ∏ l : Fin n, χ l (signUnit (a l)) := by
  simp only [principalSeriesCharacter, Module.finrank_self, pow_one, Real.norm_eq_abs,
    abs_signUnit, Complex.ofReal_one, Complex.one_cpow, mul_one]

theorem orthogonalEval_signDiagonal_mul {χ : ℕ → ℝˣ → ℂ} {P : MvPolynomial (Fin n × Fin n) ℂ}
    (hP : HasSignParity χ P) (a : Fin n → ℝˣ) (κ : Matrix.unitaryGroup (Fin n) ℝ) :
    orthogonalEval P (PrincipalSeriesExtension.signDiagonal (fun i => (a i : ℝ)) * κ) =
      principalSeriesCharacter ℝ n χ (fun i => signUnit (a i)) * orthogonalEval P κ := by
  rw [principalSeriesCharacter_signUnit, orthogonalEval, orthogonalEval, ← hP a]
  refine congrArg (fun v => MvPolynomial.eval v P) (funext fun ij => ?_)
  change ((((Matrix.diagonal fun i => signReal (a i)) * (κ : Matrix (Fin n) (Fin n) ℝ))
    ij.1 ij.2 : ℝ) : ℂ) = _
  rw [Matrix.diagonal_mul, Complex.ofReal_mul]

/-- **The principal-series law.** If `χ_l(x) = χ_l(sgn x) |x|^(e_l)` and `P` has the sign
parity of `χ`, the Gram expression of `shiftedExponent n e` and `P` lies in the smooth principal
series of `χ`. -/
theorem gramFunction_mem_principalSeries {χ : ℕ → ℝˣ → ℂ} (e : ℕ → ℂ)
    (hχ : ∀ (l : ℕ) (x : ℝˣ), χ l x = χ l (signUnit x) * ((|(x : ℝ)| : ℝ) : ℂ) ^ e l)
    {P : MvPolynomial (Fin n × Fin n) ℂ} (hP : HasSignParity χ P) :
    gramFunction (shiftedExponent n e) P ∈ principalSeries ℝ n χ := by
  refine ⟨contMDiff_gramFunction _ P, fun a u g => ?_⟩
  rw [gramFunction_eq_extension]
  exact PrincipalSeriesExtension.extension_mul_left e hχ (orthogonalEval_signDiagonal_mul hP) a u g

/-! ## Summary -/

/-- The Gram expression of a polynomial with the sign parity of `χ` is an `O(n)`-finite function
of the principal series of `χ`. -/
theorem gramFunction_mem_kFiniteFunctions {χ : ℕ → ℝˣ → ℂ} (e : ℕ → ℂ)
    (hχ : ∀ (l : ℕ) (x : ℝˣ), χ l x = χ l (signUnit x) * ((|(x : ℝ)| : ℝ) : ℂ) ^ e l)
    {P : MvPolynomial (Fin n × Fin n) ℂ} (hP : HasSignParity χ P) :
    gramFunction (shiftedExponent n e) P ∈
      kFiniteFunctions (principalSeries ℝ n χ) (unitaryCompact ℝ n) :=
  ⟨gramFunction_mem_principalSeries e hχ hP, gramFunction_mem_kFiniteVectors _ P⟩

/-- The value at the identity is `P(1)`. -/
theorem gramFunction_one (s : Fin n → ℂ) (P : MvPolynomial (Fin n × Fin n) ℂ) :
    gramFunction s P 1 = MvPolynomial.eval (fun ij : Fin n × Fin n =>
      (((1 : Matrix (Fin n) (Fin n) ℝ) ij.1 ij.2 : ℝ) : ℂ)) P := by
  have h := PrincipalSeriesExtension.extension_unitary s (orthogonalEval P) 1
  rw [map_one, ← gramFunction_eq_extension] at h
  rw [h]
  rfl

end RealGramFunction

end Langlands.Archimedean
