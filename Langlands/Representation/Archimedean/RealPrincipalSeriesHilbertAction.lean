import Langlands.Representation.Archimedean.RealPrincipalSeriesHilbertNorm
import Langlands.Representation.Archimedean.SmoothVectors
import Mathlib.Analysis.Normed.Operator.Extend

/-! # The jointly continuous real principal series on the compact Hilbert closure -/

noncomputable section

open scoped Topology Matrix.Norms.Operator
open Filter MeasureTheory

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Archimedean.RealPrincipalSeriesHilbert

open RealPrincipalSeriesDuality

attribute [local instance] measurableSpaceK borelSpaceK

variable {n : ℕ} (a : Fin n → ℂ) (e : Fin n → Fin 2)

local notation "GL" => Langlands.GeneralLinear n ℝ

/-- The closed subspace of `L²(O(n))` generated by smooth principal-series functions. -/
def closureSubmodule : Submodule ℂ (Lp ℂ 2 (haarK n)) :=
  (LinearMap.range (restrictToL2 a e)).topologicalClosure

/-- The real principal series completed in its compact Hilbert norm. -/
abbrev Hilbert := ↥(closureSubmodule a e)

instance : CompleteSpace (Hilbert a e) :=
  (LinearMap.range (restrictToL2 a e)).isClosed_topologicalClosure.isComplete.completeSpace_coe

/-- The linear inclusion of the smooth principal series into its Hilbert completion. -/
def embed : PrincipalSeries a e →ₗ[ℂ] Hilbert a e :=
  (Submodule.inclusion (LinearMap.range (restrictToL2 a e)).le_topologicalClosure).comp
    (restrictToL2 a e).rangeRestrict

@[simp]
theorem coe_embed (f : PrincipalSeries a e) :
    (embed a e f : Lp ℂ 2 (haarK n)) = restrictToL2 a e f :=
  rfl

theorem embed_injective : Function.Injective (embed a e) := fun _ _ he =>
  restrictToL2_injective a e (congrArg Subtype.val he)

theorem denseRange_embed : DenseRange (embed a e) := by
  have hrange : Subtype.val '' Set.range (embed a e) = Set.range (restrictToL2 a e) := by
    rw [← Set.range_comp]
    rfl
  intro x
  rw [closure_subtype, hrange]
  exact x.2

private theorem norm_translation_bound (g : GL) :
    ∃ C : ℝ, ∀ f : PrincipalSeries a e,
      ‖embed a e (translation a e g f)‖ ≤ C * ‖embed a e f‖ := by
  obtain ⟨C, -, hC⟩ := exists_norm_translation_le a e (isCompact_singleton (x := g))
  exact ⟨C, hC g (Set.mem_singleton _)⟩

private def extendedTranslation (g : GL) : Hilbert a e →L[ℂ] Hilbert a e :=
  ((embed a e).comp (translation a e g)).extendOfNorm (embed a e)

@[simp]
private theorem extendedTranslation_embed (g : GL) (f : PrincipalSeries a e) :
    extendedTranslation a e g (embed a e f) = embed a e (translation a e g f) :=
  LinearMap.extendOfNorm_eq (denseRange_embed a e) (norm_translation_bound a e g) f

private theorem ext_of_embed {S T : Hilbert a e →L[ℂ] Hilbert a e}
    (h : ∀ f : PrincipalSeries a e, S (embed a e f) = T (embed a e f)) : S = T :=
  ContinuousLinearMap.ext (congrFun
    ((denseRange_embed a e).equalizer S.continuous T.continuous (funext h)))

/-- The bounded extension of the genuine right translation action. -/
def representation : GL →* (Hilbert a e →L[ℂ] Hilbert a e) where
  toFun := extendedTranslation a e
  map_one' := by
    apply ext_of_embed a e
    intro f
    simp only [extendedTranslation_embed, map_one, Module.End.one_apply, one_apply_eq_self]
  map_mul' g h := by
    apply ext_of_embed a e
    intro f
    simp only [mul_apply_eq_comp, extendedTranslation_embed, map_mul, Module.End.mul_apply]

@[simp]
theorem representation_embed (g : GL) (f : PrincipalSeries a e) :
    representation a e g (embed a e f) = embed a e (translation a e g f) :=
  extendedTranslation_embed a e g f

/-- The operator norms of the extended actions are bounded on compact sets. -/
theorem exists_opNorm_representation_le {S : Set GL} (hS : IsCompact S) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ g ∈ S, ‖representation a e g‖ ≤ C := by
  obtain ⟨C, hC, hCS⟩ := exists_norm_translation_le a e hS
  refine ⟨C, hC, fun g hg => ?_⟩
  exact LinearMap.opNorm_extendOfNorm_le (denseRange_embed a e) hC (hCS g hg)

private theorem continuous_orbit_embed (f : PrincipalSeries a e) :
    Continuous (fun g : GL => representation a e g (embed a e f)) := by
  apply continuous_induced_rng.mpr
  simp only [Function.comp_def, representation_embed, coe_embed]
  have h : Continuous (fun g : GL => compactRestriction a e (translation a e g f)) := by
    apply ContinuousMap.continuous_of_continuous_uncurry
    change Continuous (fun p : GL × unitaryCompact ℝ n => f.1 ((p.2 : GL) * p.1))
    exact f.2.1.continuous.comp ((continuous_subtype_val.comp continuous_snd).mul continuous_fst)
  exact (ContinuousMap.toLp 2 (haarK n) ℂ).continuous.comp h

private theorem dist_representation_le (g : GL) {C : ℝ} (hC : ‖representation a e g‖ ≤ C)
    (x y : Hilbert a e) :
    dist (representation a e g x) (representation a e g y) ≤ C * dist x y := by
  simp only [dist_eq_norm, ← map_sub]
  exact (representation a e g).le_of_opNorm_le hC _

/-- The extended action is jointly continuous in the group element and Hilbert vector. -/
theorem isContinuousRepresentation : IsContinuousRepresentation (representation a e) := by
  apply continuous_iff_continuousAt.mpr
  intro p
  obtain ⟨S, hS, hS0⟩ := exists_compact_mem_nhds p.1
  obtain ⟨C, hC, hCS⟩ := exists_opNorm_representation_le a e hS
  have hCp : ‖representation a e p.1‖ ≤ C := hCS _ (mem_of_mem_nhds hS0)
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  let δ := ε / (4 * (C + 1))
  have hδ : 0 < δ := by
    dsimp only [δ]
    positivity
  have hδC : (C + 1) * δ = ε / 4 := by
    have hC1 : C + 1 ≠ 0 := by positivity
    dsimp only [δ]
    field_simp
  obtain ⟨f, hf⟩ := (Metric.denseRange_iff.mp (denseRange_embed a e)) p.2 δ hδ
  have hS' : ∀ᶠ q : GL × Hilbert a e in 𝓝 p, q.1 ∈ S :=
    continuous_fst.continuousAt.eventually hS0
  have hδ' : ∀ᶠ q : GL × Hilbert a e in 𝓝 p, dist q.2 p.2 < δ :=
    (Metric.tendsto_nhds.mp continuous_snd.continuousAt) δ hδ
  have hε' : ∀ᶠ q : GL × Hilbert a e in 𝓝 p,
      dist (representation a e q.1 (embed a e f)) (representation a e p.1 (embed a e f)) < ε / 4 :=
    (Metric.tendsto_nhds.mp ((continuous_orbit_embed a e f).comp continuous_fst).continuousAt)
      (ε / 4) (by positivity)
  filter_upwards [hS', hδ', hε'] with q hqS hqδ hqε
  have hqC : ‖representation a e q.1‖ ≤ C := hCS _ hqS
  have hqf : dist q.2 (embed a e f) ≤ δ + δ :=
    (dist_triangle _ p.2 _).trans (add_le_add hqδ.le hf.le)
  have hfirst : dist (representation a e q.1 q.2) (representation a e q.1 (embed a e f)) ≤ ε / 2 := by
    calc
      _ ≤ C * dist q.2 (embed a e f) := dist_representation_le a e _ hqC _ _
      _ ≤ C * (δ + δ) := mul_le_mul_of_nonneg_left hqf hC
      _ ≤ _ := by nlinarith
  have hlast : dist (representation a e p.1 (embed a e f)) (representation a e p.1 p.2) ≤ ε / 4 := by
    calc
      _ ≤ C * dist (embed a e f) p.2 := dist_representation_le a e _ hCp _ _
      _ ≤ C * δ := mul_le_mul_of_nonneg_left (by rw [dist_comm]; exact hf.le) hC
      _ ≤ _ := by nlinarith
  calc
    _ ≤ dist (representation a e q.1 q.2) (representation a e q.1 (embed a e f)) +
        (dist (representation a e q.1 (embed a e f)) (representation a e p.1 (embed a e f)) +
          dist (representation a e p.1 (embed a e f)) (representation a e p.1 p.2)) :=
      (dist_triangle _ _ _).trans (add_le_add le_rfl (dist_triangle _ _ _))
    _ < ε := by linarith

end Langlands.Archimedean.RealPrincipalSeriesHilbert
