import Langlands.Representation.Archimedean.FormalAdjointCommutant
import Langlands.Representation.Archimedean.SmoothVectorEnvelopingAction
import Langlands.Representation.Archimedean.ClosedSubspaceFunctionalOrbit
import Langlands.Representation.Archimedean.SmoothFixedSubspace

/-!
# Infinitesimal characters of irreducible unitary representations of product groups

Let `Γ` be a group containing the commuting images of a real Lie group `M` and of a topological
group `Φ` which together generate it (for `G(𝔸) = G(F_∞) × G(𝔸_f)`), and `ρ` a topologically
irreducible unitary representation of `Γ` on a complex Hilbert space `E`. A vector is *smooth*
when it is a smooth vector for `M` and is fixed by an open subgroup of `Φ`.

* The smooth vectors form a `ρ`-invariant subspace, stable under the enveloping algebra of `M`.
* (Segal.) If an element `z` of the enveloping algebra is fixed by an extension of `Ad(g)` for
  every `g ∈ M` (for instance a central element when `Ad(M)` fixes the center), then `z` acts on
  the smooth vectors by a scalar. The proof applies Schur's lemma with a formal adjoint
  (`exists_eq_smul_of_formalAdjoint_commute`) to the action of `z`.
* For a linear form `ξ` bounded, on the smooth vectors fixed by each open subgroup, by finitely
  many derivative seminorms, the coefficients `a ↦ ξ (ρ (a b) w)` are smooth on `M`, and an
  action `Θ` of the enveloping algebra on functions on `M` by right differentiation maps the
  coefficient of `w` to the coefficient of `dρ(y) w`.
-/

noncomputable section

open scoped Manifold ContDiff InnerProductSpace TensorProduct

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option linter.unusedSectionVars false

namespace Langlands.Archimedean.ProductSmoothVectors

open Langlands.Geometry.Manifold Langlands.Archimedean.SmoothVectorEnveloping

attribute [local instance 100] LieRing.ofAssociativeRing

variable {A : Type*} [NormedAddCommGroup A] [NormedSpace ℝ A]
  {M : Type*} [Group M] [TopologicalSpace M] [ChartedSpace A M] [LieGroup 𝓘(ℝ, A) ∞ M]
  {Φ : Type*} [Group Φ] [TopologicalSpace Φ] [IsTopologicalGroup Φ]
  {Γ : Type*} [Group Γ]
  (ιinf : M →* Γ) (ιfin : Φ →* Γ)
  {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  (ρ : Γ →* (E →L[ℂ] E))

local notation "I" => 𝓘(ℝ, A)

variable (A) in
/-- The smooth vectors: smooth for `M` and fixed by an open subgroup of `Φ`. -/
def smoothSubspace : Submodule ℂ E where
  carrier := {v | IsSmoothVector I (ρ.comp ιinf) v ∧
    ∃ L : Subgroup Φ, IsOpen (L : Set Φ) ∧ ∀ l ∈ L, ρ (ιfin l) v = v}
  zero_mem' := ⟨(smoothVectors I (ρ.comp ιinf)).zero_mem, ⊤, isOpen_univ, fun _ _ => map_zero _⟩
  add_mem' := by
    rintro v w ⟨hv, L₁, hL₁, hv₁⟩ ⟨hw, L₂, hL₂, hw₂⟩
    refine ⟨(smoothVectors I (ρ.comp ιinf)).add_mem hv hw, L₁ ⊓ L₂, hL₁.inter hL₂, ?_⟩
    intro l hl
    rw [map_add, hv₁ l hl.1, hw₂ l hl.2]
  smul_mem' := by
    rintro c v ⟨hv, L, hL, hvL⟩
    refine ⟨(smoothVectors I (ρ.comp ιinf)).smul_mem c hv, L, hL, ?_⟩
    intro l hl
    rw [map_smul, hvL l hl]

variable (hcomm : ∀ a b, Commute (ιinf a) (ιfin b))
include hcomm

theorem finite_comm (b : Φ) (a : M) (v : E) :
    ρ (ιfin b) ((ρ.comp ιinf) a v) = (ρ.comp ιinf) a (ρ (ιfin b) v) := by
  simp only [MonoidHom.comp_apply]
  rw [← mul_apply_eq_comp, ← mul_apply_eq_comp,
    ← map_mul, ← map_mul, (hcomm a b).eq]

/-- The smooth vectors are invariant under `ρ`, provided `Γ` is generated by the two factors. -/
theorem smoothSubspace_invariant (hgen : ∀ γ : Γ, ∃ a b, γ = ιinf a * ιfin b) (γ : Γ) (v : E)
    (hv : v ∈ smoothSubspace A ιinf ιfin ρ) : ρ γ v ∈ smoothSubspace A ιinf ιfin ρ := by
  obtain ⟨a, b, rfl⟩ := hgen γ
  obtain ⟨hvs, L, hL, hvL⟩ := hv
  have hσ := finite_comm ιinf ιfin ρ hcomm b
  have hbs : IsSmoothVector I (ρ.comp ιinf) (ρ (ιfin b) v) :=
    isSmoothVector_comm (ρ.comp ιinf) (ρ (ιfin b)) hσ hvs
  let L' : Subgroup Φ := L.comap (MulAut.conj b⁻¹).toMonoidHom
  have hL' : IsOpen (L' : Set Φ) := by
    have hc : Continuous fun x : Φ => b⁻¹ * x * b⁻¹⁻¹ :=
      (continuous_const.mul continuous_id).mul continuous_const
    exact hL.preimage hc
  rw [map_mul, mul_apply_eq_comp]
  refine ⟨isSmoothVector_apply I (ρ.comp ιinf) hbs a, L', hL', fun l hl => ?_⟩
  have hl' : b⁻¹ * l * b ∈ L := by simpa [L', MulAut.conj_apply] using hl
  have hfix : ρ (ιfin l) (ρ (ιfin b) v) = ρ (ιfin b) v := by
    have h := hvL _ hl'
    calc ρ (ιfin l) (ρ (ιfin b) v) = ρ (ιfin b) (ρ (ιfin (b⁻¹ * l * b)) v) := by
          rw [← mul_apply_eq_comp, ← mul_apply_eq_comp,
            ← map_mul, ← map_mul, ← map_mul, ← map_mul]
          congr 2
          group
      _ = ρ (ιfin b) v := by rw [h]
  change ρ (ιfin l) ((ρ.comp ιinf) a (ρ (ιfin b) v)) = (ρ.comp ιinf) a (ρ (ιfin b) v)
  rw [finite_comm ιinf ιfin ρ hcomm l, hfix]

variable [CompleteSpace A] [LieGroup 𝓘(ℝ, A) (minSmoothness ℝ 3) M]
  (hcalc : smoothVectorFieldCommutator 𝓘(ℝ, A) M)

local notation "𝔘" => UniversalEnvelopingAlgebra ℂ (ℂ ⊗[ℝ] GroupLieAlgebra 𝓘(ℝ, A) M)

/-- The enveloping action preserves the vectors fixed by a subgroup of `Φ`. -/
theorem envelopingAction_fixed (y : 𝔘) (l : Φ) (v : smoothVectors I (ρ.comp ιinf))
    (hv : ρ (ιfin l) v = v) :
    ρ (ιfin l) (envelopingAction (ρ.comp ιinf) hcalc y v) =
      envelopingAction (ρ.comp ιinf) hcalc y v := by
  rw [envelopingAction_comm (ρ.comp ιinf) (ρ (ιfin l)) (finite_comm ιinf ιfin ρ hcomm l) hcalc y v]
  congr 2
  exact Subtype.ext hv

/-- The enveloping action on the smooth vectors. -/
def smoothSubspaceAction (y : 𝔘) :
    smoothSubspace A ιinf ιfin ρ →ₗ[ℂ] smoothSubspace A ιinf ιfin ρ where
  toFun w := ⟨envelopingAction (ρ.comp ιinf) hcalc y ⟨w, w.2.1⟩,
    (envelopingAction (ρ.comp ιinf) hcalc y ⟨w, w.2.1⟩).2,
    by
      obtain ⟨L, hL, hwL⟩ := w.2.2
      exact ⟨L, hL, fun l hl => envelopingAction_fixed ιinf ιfin ρ hcomm hcalc y l _ (hwL l hl)⟩⟩
  map_add' w w' := by
    apply Subtype.ext
    change ((envelopingAction (ρ.comp ιinf) hcalc y (⟨w, w.2.1⟩ + ⟨w', w'.2.1⟩) :
      smoothVectors I (ρ.comp ιinf)) : E) = _
    rw [map_add]
    rfl
  map_smul' c w := by
    apply Subtype.ext
    change ((envelopingAction (ρ.comp ιinf) hcalc y (c • ⟨w, w.2.1⟩) :
      smoothVectors I (ρ.comp ιinf)) : E) = _
    rw [map_smul]
    rfl

@[simp]
theorem smoothSubspaceAction_apply (y : 𝔘) (w : smoothSubspace A ιinf ιfin ρ) :
    (smoothSubspaceAction ιinf ιfin ρ hcomm hcalc y w : E) =
      envelopingAction (ρ.comp ιinf) hcalc y ⟨w, w.2.1⟩ := rfl

/-- **Segal's theorem, in the form used here.** Let `ρ` be unitary and topologically
irreducible, and `z` an element of the enveloping algebra fixed, for every `g ∈ M`, by some
algebra endomorphism extending `Ad(g)`. If some smooth vector is nonzero, `z` acts on the smooth
vectors by a scalar. -/
theorem exists_smul_of_adjointInvariant [CompleteSpace E]
    (hgen : ∀ γ : Γ, ∃ a b, γ = ιinf a * ιfin b)
    (hunit : ∀ γ u v, ⟪ρ γ u, ρ γ v⟫_ℂ = ⟪u, v⟫_ℂ)
    (hirr : IsTopologicallyIrreducible ρ) (hne : smoothSubspace A ιinf ιfin ρ ≠ ⊥) (z : 𝔘)
    (hz : ∀ g : M, ∃ φ : 𝔘 →ₐ[ℂ] 𝔘,
      (∀ (c : ℂ) (X : GroupLieAlgebra I M),
        φ (UniversalEnvelopingAlgebra.ι ℂ (c ⊗ₜ[ℝ] X)) =
          UniversalEnvelopingAlgebra.ι ℂ (c ⊗ₜ[ℝ] groupTangentConjugation I g X)) ∧ φ z = z) :
    ∃ c : ℂ, ∀ w : smoothSubspace A ιinf ιfin ρ,
      (envelopingAction (ρ.comp ιinf) hcalc z ⟨w, w.2.1⟩ : E) = c • (w : E) := by
  have hunitinf : ∀ g u v, ⟪(ρ.comp ιinf) g u, (ρ.comp ιinf) g v⟫_ℂ = ⟪u, v⟫_ℂ :=
    fun g u v => hunit (ιinf g) u v
  obtain ⟨z', hz'⟩ := exists_formalAdjoint (ρ.comp ιinf) hcalc hunitinf z
  have hinv := smoothSubspace_invariant (A := A) ιinf ιfin ρ hcomm hgen
  obtain ⟨c, hc⟩ := FormalAdjointCommutant.exists_eq_smul_of_formalAdjoint_commute ρ hunit hirr
    (smoothSubspace A ιinf ιfin ρ) hinv hne
    (smoothSubspaceAction ιinf ιfin ρ hcomm hcalc z)
    (smoothSubspaceAction ιinf ιfin ρ hcomm hcalc z')
    (fun v w => hz' ⟨v, v.2.1⟩ ⟨w, w.2.1⟩)
    (by
      intro γ w
      obtain ⟨a, b, rfl⟩ := hgen γ
      obtain ⟨φ, hφ, hφz⟩ := hz a
      have hσ := finite_comm ιinf ιfin ρ hcomm b
      rw [smoothSubspaceAction_apply]
      have hw1 : (⟨ρ (ιinf a * ιfin b) w, (hinv _ w w.2).1⟩ : smoothVectors I (ρ.comp ιinf)) =
          smoothRepresentation I (ρ.comp ιinf) a
            (smoothCommuting (ρ.comp ιinf) (ρ (ιfin b)) hσ ⟨w, w.2.1⟩) := by
        apply Subtype.ext
        simp [smoothCommuting, map_mul, mul_apply_eq_comp]
      rw [hw1]
      have h1 := apply_envelopingAction (ρ.comp ιinf) hcalc a φ hφ z
        (smoothCommuting (ρ.comp ιinf) (ρ (ιfin b)) hσ ⟨w, w.2.1⟩)
      rw [hφz] at h1
      rw [← h1, ← envelopingAction_comm (ρ.comp ιinf) (ρ (ιfin b)) hσ hcalc z ⟨w, w.2.1⟩,
        map_mul, mul_apply_eq_comp]
      rfl)
  exact ⟨c, hc⟩

/-- The conjugate `b L b⁻¹` of an open subgroup, which fixes `ρ (ιfin b) v` when `L` fixes `v`. -/
def conjugateSubgroup (b : Φ) (L : Subgroup Φ) : Subgroup Φ :=
  L.comap (MulAut.conj b⁻¹).toMonoidHom

omit hcomm in
theorem isOpen_conjugateSubgroup (b : Φ) {L : Subgroup Φ} (hL : IsOpen (L : Set Φ)) :
    IsOpen (conjugateSubgroup b L : Set Φ) := by
  have hc : Continuous fun x : Φ => b⁻¹ * x * b⁻¹⁻¹ :=
    (continuous_const.mul continuous_id).mul continuous_const
  exact hL.preimage hc

omit hcomm in
theorem fixed_conjugateSubgroup (b : Φ) {L : Subgroup Φ} {v : E}
    (hv : ∀ l ∈ L, ρ (ιfin l) v = v) :
    ∀ l ∈ conjugateSubgroup b L, ρ (ιfin l) (ρ (ιfin b) v) = ρ (ιfin b) v := by
  intro l hl
  have hl' : b⁻¹ * l * b ∈ L := by simpa [conjugateSubgroup, MulAut.conj_apply] using hl
  calc ρ (ιfin l) (ρ (ιfin b) v) = ρ (ιfin b) (ρ (ιfin (b⁻¹ * l * b)) v) := by
        rw [← mul_apply_eq_comp, ← mul_apply_eq_comp, ← map_mul, ← map_mul, ← map_mul, ← map_mul]
        congr 2
        group
    _ = ρ (ιfin b) v := by rw [hv _ hl']

/-- A linear form bounded by derivative seminorms on the smooth vectors fixed by each open
subgroup of `Φ` (a distribution vector). -/
def IsDistributionForm (ξ : E →ₗ[ℂ] ℂ) : Prop :=
  ∀ L : Subgroup Φ, IsOpen (L : Set Φ) →
    ∃ (S : Finset (List A)) (C : ℝ), ∀ v ∈ smoothVectors I (ρ.comp ιinf),
      (∀ l ∈ L, ρ (ιfin l) v = v) →
        ‖ξ v‖ ≤ C * ∑ Xs ∈ S, ‖iteratedLieDerivative I (ρ.comp ιinf) Xs v‖

/-- Smoothness and differentiation of the coefficients of a distribution form. -/
theorem coefficient_contMDiff_and_mfderiv [CompleteSpace E]
    (hunit : ∀ γ u v, ⟪ρ γ u, ρ γ v⟫_ℂ = ⟪u, v⟫_ℂ) (ξ : E →ₗ[ℂ] ℂ)
    (hξ : IsDistributionForm (A := A) ιinf ιfin ρ ξ) {w : E}
    (hw : IsSmoothVector I (ρ.comp ιinf) w) {L : Subgroup Φ} (hL : IsOpen (L : Set Φ))
    (hwL : ∀ l ∈ L, ρ (ιfin l) w = w) :
    ContMDiff I 𝓘(ℝ, ℂ) ∞ (fun a => ξ ((ρ.comp ιinf) a w)) ∧
      ∀ (g : M) (X : A), mfderiv I 𝓘(ℝ, ℂ) (fun h => ξ ((ρ.comp ιinf) (g * h) w)) 1 X =
        ξ ((ρ.comp ιinf) g (lieDerivative I (ρ.comp ιinf) X w)) := by
  let σ : Φ →* (E →L[ℂ] E) := ρ.comp ιfin
  have hσ : ∀ (g : M) (l : Φ) (v : E), (ρ.comp ιinf) g (σ l v) = σ l ((ρ.comp ιinf) g v) :=
    fun g l v => (finite_comm ιinf ιfin ρ hcomm l g v).symm
  obtain ⟨S, C, hSC⟩ := hξ L hL
  refine ClosedSubspaceFunctionalOrbit.contMDiff_and_mfderiv (ρ.comp ιinf)
    (fun g u v => hunit (ιinf g) u v) (SmoothInvariantSubspace.fixedSubspace σ L)
    (SmoothInvariantSubspace.isClosed_fixedSubspace σ L)
    (fun g v hv => SmoothInvariantSubspace.fixedSubspace_invariant σ L (ρ.comp ιinf) hσ g v hv)
    ξ S C (fun v hv hvF => hSC v hv (fun l hl => hvF ⟨l, hl⟩)) hw (fun j => hwL j j.2)

/-- The slices `a ↦ ξ (ρ (ιinf a * ιfin b) v)` of the coefficient of a smooth vector are
smooth. -/
theorem coefficient_contMDiff [CompleteSpace E]
    (hunit : ∀ γ u v, ⟪ρ γ u, ρ γ v⟫_ℂ = ⟪u, v⟫_ℂ) (ξ : E →ₗ[ℂ] ℂ)
    (hξ : IsDistributionForm (A := A) ιinf ιfin ρ ξ)
    (v : E) (hv : v ∈ smoothSubspace A ιinf ιfin ρ) (b : Φ) :
    ContMDiff I 𝓘(ℝ, ℂ) ∞ (fun a => ξ (ρ (ιinf a * ιfin b) v)) := by
  obtain ⟨hvs, L, hL, hvL⟩ := hv
  have hσ := finite_comm ιinf ιfin ρ hcomm b
  have h := (coefficient_contMDiff_and_mfderiv ιinf ιfin ρ hcomm hunit ξ hξ
    (isSmoothVector_comm (ρ.comp ιinf) (ρ (ιfin b)) hσ hvs) (isOpen_conjugateSubgroup b hL)
    (fixed_conjugateSubgroup ιfin ρ b hvL)).1
  convert h using 2 with a
  simp [map_mul, mul_apply_eq_comp]

/-- **Coefficients of a distribution form under the enveloping algebra.** Let `Θ` act on a space
`S` of functions on `M` containing the smooth functions, with `ι (1 ⊗ X)` acting by
`groupDirectionalValue X`. For a smooth vector `v` and `b ∈ Φ`, `Θ y` maps the coefficient
`a ↦ ξ (ρ (ιinf a * ιfin b) v)` to the coefficient of `dρ(y) v`. -/
theorem coefficient_envelopingAction [CompleteSpace E]
    (hunit : ∀ γ u v, ⟪ρ γ u, ρ γ v⟫_ℂ = ⟪u, v⟫_ℂ) (ξ : E →ₗ[ℂ] ℂ)
    (hξ : IsDistributionForm (A := A) ιinf ιfin ρ ξ)
    (S : Submodule ℂ (M → ℂ)) (hSmem : ∀ f : M → ℂ, ContMDiff I 𝓘(ℝ, ℂ) ∞ f → f ∈ S)
    (Θ : 𝔘 →ₐ[ℂ] Module.End ℂ S)
    (hΘ : ∀ (X : GroupLieAlgebra I M) (f : S),
      ((Θ (UniversalEnvelopingAlgebra.ι ℂ ((1 : ℂ) ⊗ₜ[ℝ] X)) f : S) : M → ℂ) =
        groupDirectionalValue I X f)
    (v : E) (hv : v ∈ smoothSubspace A ιinf ιfin ρ) (b : Φ) (y : 𝔘)
    (hmem : (fun a => ξ (ρ (ιinf a * ιfin b) v)) ∈ S) :
    ((Θ y ⟨fun a => ξ (ρ (ιinf a * ιfin b) v), hmem⟩ : S) : M → ℂ) =
      fun a => ξ (ρ (ιinf a * ιfin b) (envelopingAction (ρ.comp ιinf) hcalc y ⟨v, hv.1⟩)) := by
  obtain ⟨hvs, L, hL, hvL⟩ := hv
  let π := ρ.comp ιinf
  let σ : Φ →* (E →L[ℂ] E) := ρ.comp ιfin
  have hσ := finite_comm ιinf ιfin ρ hcomm b
  set L' := conjugateSubgroup b L
  have hL' : IsOpen (L' : Set Φ) := isOpen_conjugateSubgroup b hL
  let W : Submodule ℂ (smoothVectors I π) :=
    { carrier := {u | ∀ l ∈ L', ρ (ιfin l) (u : E) = u}
      zero_mem' := fun l _ => map_zero _
      add_mem' := fun {u u'} hu hu' l hl => by
        simp only [Submodule.coe_add, map_add, hu l hl, hu' l hl]
      smul_mem' := fun c u hu l hl => by
        simp only [Submodule.coe_smul, map_smul, hu l hl] }
  have hW : ∀ X, ∀ u ∈ W, smoothLieDerivative I π X u ∈ W := by
    intro X u hu l hl
    simp only [smoothLieDerivative_apply]
    rw [← lieDerivative_comm π (ρ (ιfin l)) (finite_comm ιinf ιfin ρ hcomm l) X u.2]
    congr 1
    exact hu l hl
  have hcoef := fun (u : smoothVectors I π) (hu : u ∈ W) =>
    coefficient_contMDiff_and_mfderiv ιinf ιfin ρ hcomm hunit ξ hξ u.2 hL' hu
  let w : smoothVectors I π := ⟨ρ (ιfin b) v, isSmoothVector_comm π (ρ (ιfin b)) hσ hvs⟩
  have hw : w ∈ W := fixed_conjugateSubgroup ιfin ρ b hvL
  have hT := envelopingAction_coefficient π hcalc S Θ hΘ W hW ξ
    (fun u hu => hSmem _ (hcoef u hu).1)
    (fun u hu X g => (hcoef u hu).2 g X) y w hw
  have hfun : (fun a => ξ (ρ (ιinf a * ιfin b) v)) = fun a => ξ (π a (w : E)) := by
    funext a
    simp [π, w, map_mul, mul_apply_eq_comp]
  have hDw : (envelopingAction π hcalc y w : E) =
      ρ (ιfin b) (envelopingAction π hcalc y ⟨v, hvs⟩) := by
    rw [envelopingAction_comm π (ρ (ιfin b)) hσ hcalc y ⟨v, hvs⟩]
    rfl
  have hsub : (⟨fun a => ξ (ρ (ιinf a * ιfin b) v), hmem⟩ : S) =
      ⟨fun a => ξ (π a (w : E)), hSmem _ (hcoef w hw).1⟩ := Subtype.ext hfun
  rw [hsub, hT.2]
  funext a
  simp only [π, MonoidHom.comp_apply, map_mul, mul_apply_eq_comp]
  rw [hDw]

end Langlands.Archimedean.ProductSmoothVectors
