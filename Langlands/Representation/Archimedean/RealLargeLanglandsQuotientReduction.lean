import Mathlib.Algebra.Lie.UniversalEnveloping
import Langlands.Representation.Archimedean.RealGenericLargeReduction
import Langlands.Representation.Archimedean.RealStandardModuleGKModule

/-!
# Reduction of Vogan's theorem for large Langlands quotients of `GL_n(ℝ)`

`RealLargeLanglandsQuotientInjectiveStatement` (Vogan 1978, Theorem 6.2, proof of (a) ⇒ (f))
says that a nonzero `(𝔤, K)`-intertwiner from the `O(n)`-finite functions of a
Langlands-ordered real standard module onto an irreducible admissible maximally faithful
`(𝔤𝔩_n(ℝ), O(n))`-module is injective. This file splits it into two statements about the
`(𝔤𝔩_n(ℝ), O(n))`-module `(realStandardRep n ds, realStandardLie n ds)` of a standard module:

* `RealStandardLanglandsQuotientStatement` (Langlands quotient; Knapp 1994, Theorem 1(a),
  with Langlands' multiplicity-one theorem): a Langlands-ordered standard module has a
  largest proper `(𝔤, K)`-submodule `R`, so that `I / R` is its Langlands quotient;
* `RealLargeStandardIrreducibleStatement` (Vogan 1978, Theorem 6.2, proof of (a) ⇒ (f)): if
  the Langlands quotient `I / R` is maximally faithful (Vogan's "large"), then `R = 0`, that
  is, the standard module is irreducible.

`realLargeLanglandsQuotientReduction` proves that the two imply the target: a nonzero
intertwiner `B` onto an irreducible module is onto, its kernel is the largest proper
submodule `R`, and `I / ker B ≅ V` is maximally faithful, so `ker B = R = 0`.
-/

noncomputable section

open scoped TensorProduct Matrix

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.LocalFactor.Archimedean
open scoped Matrix.Norms.Operator

-- As in `RealGenericLargeReduction`: the charts on units need reduction through the
-- normed-ring instances of matrices.
set_option backward.isDefEq.respectTransparency false

universe uK uL uX uV

/-! ## Submodules and maximal faithfulness of quotients -/

section General

variable {K : Type uK} [Group K] {L : Type uL} [LieRing L] [LieAlgebra ℂ L]

/-- `W` is a `(𝔤, K)`-submodule of `(ρ, π)`: a subspace stable under every `ρ(k)` and every
`π(X)`. These are the subspaces that `IsIrreducibleGKModule` quantifies over. -/
def IsGKSubmodule {V : Type uV} [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ K V)
    (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) (W : Submodule ℂ V) : Prop :=
  (∀ (k : K), ∀ w ∈ W, ρ k w ∈ W) ∧ ∀ (X : L), ∀ w ∈ W, π X w ∈ W

/-- The quotient `V / R` of the `L`-module `π` by a `π`-stable subspace `R` is maximally
faithful (`IsMaximallyFaithful`, Kostant 1978, §3.9), stated without forming the quotient:
an element `u` of `U(L)` annihilates `V / R` when `u · v ∈ R` for every `v ∈ V`, and the
condition asks that every such `u` lie in the ideal of `U(L)` generated by the central
elements annihilating `V / R`. For `R = ⊥` this is `IsMaximallyFaithful π`
(`isMaximallyFaithfulModulo_bot_iff`). -/
def IsMaximallyFaithfulModulo {V : Type uV} [AddCommGroup V] [Module ℂ V]
    (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) (R : Submodule ℂ V) : Prop :=
  ∀ u : UniversalEnvelopingAlgebra ℂ L, (∀ v : V, envelopingAction π u v ∈ R) →
    u ∈ Ideal.span {z | z ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ L) ∧
      ∀ v : V, envelopingAction π z v ∈ R}

/-- Maximal faithfulness modulo `⊥` is maximal faithfulness. -/
theorem isMaximallyFaithfulModulo_bot_iff {V : Type uV} [AddCommGroup V] [Module ℂ V]
    (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) : IsMaximallyFaithfulModulo π ⊥ ↔ IsMaximallyFaithful π := by
  have key : ∀ u : UniversalEnvelopingAlgebra ℂ L,
      (∀ v : V, envelopingAction π u v ∈ (⊥ : Submodule ℂ V)) ↔ envelopingAction π u = 0 := by
    intro u
    simp only [Submodule.mem_bot]
    exact ⟨fun h => LinearMap.ext h, fun h v => by rw [h, LinearMap.zero_apply]⟩
  unfold IsMaximallyFaithfulModulo IsMaximallyFaithful
  simp only [key]

/-- A linear map that intertwines two `L`-actions intertwines the actions of `U(L)`. -/
theorem envelopingAction_intertwine {X : Type uX} [AddCommGroup X] [Module ℂ X]
    {V : Type uV} [AddCommGroup V] [Module ℂ V]
    (σ : L →ₗ⁅ℂ⁆ Module.End ℂ X) (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) (B : X →ₗ[ℂ] V)
    (h : ∀ (Y : L) (f : X), B (σ Y f) = π Y (B f)) (u : UniversalEnvelopingAlgebra ℂ L)
    (f : X) : B (envelopingAction σ u f) = envelopingAction π u (B f) := by
  have hs : Function.Surjective (UniversalEnvelopingAlgebra.mkAlgHom ℂ L) :=
    RingCon.mkₐ_surjective _
  obtain ⟨t, rfl⟩ := hs u
  revert f
  induction t using TensorAlgebra.induction with
  | algebraMap r => intro f; simp [AlgHom.commutes, Module.algebraMap_end_apply]
  | ι x => intro f; simp [h]
  | mul a b ha hb => intro f; simp only [map_mul, Module.End.mul_apply, ha, hb]
  | add a b ha hb => intro f; simp only [map_add, LinearMap.add_apply, ha, hb]

/-- If `B : X → V` is onto and intertwines the `L`-actions, then `X / ker B` is maximally
faithful exactly when `V` is: both conditions concern the same elements of `U(L)`. -/
theorem isMaximallyFaithfulModulo_ker_iff {X : Type uX} [AddCommGroup X] [Module ℂ X]
    {V : Type uV} [AddCommGroup V] [Module ℂ V]
    (σ : L →ₗ⁅ℂ⁆ Module.End ℂ X) (π : L →ₗ⁅ℂ⁆ Module.End ℂ V) (B : X →ₗ[ℂ] V)
    (h : ∀ (Y : L) (f : X), B (σ Y f) = π Y (B f)) (hB : Function.Surjective B) :
    IsMaximallyFaithfulModulo σ (LinearMap.ker B) ↔ IsMaximallyFaithful π := by
  have key : ∀ u : UniversalEnvelopingAlgebra ℂ L,
      (∀ f : X, envelopingAction σ u f ∈ LinearMap.ker B) ↔ envelopingAction π u = 0 := by
    intro u
    constructor
    · intro hu
      refine LinearMap.ext fun v => ?_
      obtain ⟨f, rfl⟩ := hB v
      have hf := hu f
      rw [LinearMap.mem_ker, envelopingAction_intertwine σ π B h] at hf
      rw [hf, LinearMap.zero_apply]
    · intro hu f
      rw [LinearMap.mem_ker, envelopingAction_intertwine σ π B h, hu, LinearMap.zero_apply]
  unfold IsMaximallyFaithfulModulo IsMaximallyFaithful
  simp only [key]

end General

/-! ## Intertwiners out of a real standard module -/

section Standard

variable {n : ℕ} {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℝ) V}
  {π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) →ₗ⁅ℂ⁆ Module.End ℂ V} {ds : List RealBlock}
  {B : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n) →ₗ[ℂ] V}

/-- An `IsRealStandardIntertwiner` map carries `realStandardRep` to `ρ`. -/
theorem IsRealStandardIntertwiner.map_realStandardRep
    (hB : IsRealStandardIntertwiner n ρ π ds B) (k : Matrix.unitaryGroup (Fin n) ℝ)
    (f : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n)) :
    B (realStandardRep n ds k f) = ρ k (B f) := by
  obtain ⟨hf, hBf⟩ := hB.1 ⟨Unitary.toUnits k, k.2⟩ f
  have h1 : realStandardRep n ds k f = ⟨_, hf⟩ :=
    Subtype.ext (realStandardRep_apply_coe n ds k f)
  rw [h1, hBf]
  rfl

/-- An `IsRealStandardIntertwiner` map carries `realStandardLie` to `π` on all of
`ℂ ⊗_ℝ 𝔤𝔩_n(ℝ)`, by `ℂ`-linearity from the real directions `1 ⊗ X`. -/
theorem IsRealStandardIntertwiner.map_realStandardLie
    (hB : IsRealStandardIntertwiner n ρ π ds B) (Y : ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ)
    (f : kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n)) :
    B (realStandardLie n ds Y f) = π Y (B f) := by
  induction Y using TensorProduct.inductionOn with
  | tmul c X =>
    have hc : (c ⊗ₜ[ℝ] X : ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℝ) = c • ((1 : ℂ) ⊗ₜ[ℝ] X) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    obtain ⟨hf, hBf⟩ := hB.2 X f
    have h1 : realStandardLie n ds (1 ⊗ₜ X) f = ⟨_, hf⟩ :=
      Subtype.ext (realStandardLie_one_tmul_apply_coe n ds X f)
    rw [hc, map_smul, LinearMap.smul_apply, map_smul, h1, hBf, map_smul, LinearMap.smul_apply]
  | add Y Z hY hZ =>
    rw [map_add, LinearMap.add_apply, map_add, hY, hZ, map_add, LinearMap.add_apply]

/-- The kernel of an `IsRealStandardIntertwiner` map is a `(𝔤, K)`-submodule. -/
theorem IsRealStandardIntertwiner.isGKSubmodule_ker
    (hB : IsRealStandardIntertwiner n ρ π ds B) :
    IsGKSubmodule (realStandardRep n ds) (realStandardLie n ds) (LinearMap.ker B) :=
  ⟨fun k w hw => by
      rw [LinearMap.mem_ker, hB.map_realStandardRep, LinearMap.mem_ker.1 hw, map_zero],
    fun Y w hw => by
      rw [LinearMap.mem_ker, hB.map_realStandardLie, LinearMap.mem_ker.1 hw, map_zero]⟩

/-- The image of a `(𝔤, K)`-submodule under an `IsRealStandardIntertwiner` map is a
`(𝔤, K)`-submodule. -/
theorem IsRealStandardIntertwiner.isGKSubmodule_map
    (hB : IsRealStandardIntertwiner n ρ π ds B)
    {W : Submodule ℂ (kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n))}
    (hW : IsGKSubmodule (realStandardRep n ds) (realStandardLie n ds) W) :
    IsGKSubmodule ρ π (W.map B) := by
  constructor
  · rintro k _ ⟨w, hw, rfl⟩
    exact ⟨realStandardRep n ds k w, hW.1 k w hw, hB.map_realStandardRep k w⟩
  · rintro Y _ ⟨w, hw, rfl⟩
    exact ⟨realStandardLie n ds Y w, hW.2 Y w hw, hB.map_realStandardLie Y w⟩

/-- A nonzero `IsRealStandardIntertwiner` map into an irreducible module is onto. -/
theorem IsRealStandardIntertwiner.surjective (hB : IsRealStandardIntertwiner n ρ π ds B)
    (hirr : IsIrreducibleGKModule ρ π) (hB0 : B ≠ 0) : Function.Surjective B := by
  have hW := hB.isGKSubmodule_map (W := ⊤)
    ⟨fun _ _ _ => Submodule.mem_top, fun _ _ _ => Submodule.mem_top⟩
  rw [Submodule.map_top] at hW
  rcases hirr.2 _ hW.1 hW.2 with h | h
  · exact absurd (LinearMap.range_eq_bot.1 h) hB0
  · exact LinearMap.range_eq_top.1 h

end Standard

/-! ## The two statements and the reduction -/

/-- The Langlands quotient of a real standard module (Knapp 1994, Theorem 1(a), with
Langlands' theorem that the Langlands quotient occurs with multiplicity one): for a list
`ds` of real blocks of total rank `n` in Langlands order, the `(𝔤𝔩_n(ℝ), O(n))`-module of
`O(n)`-finite functions of the standard module of `ds` has a largest proper
`(𝔤, K)`-submodule `R`: a proper `(𝔤, K)`-submodule containing every proper
`(𝔤, K)`-submodule. The quotient by `R` is the Langlands quotient. -/
def RealStandardLanglandsQuotientStatement : Prop :=
  ∀ (n : ℕ) (ds : List RealBlock), realRank ds = n → IsRealLanglandsOrdered ds →
    ∃ R : Submodule ℂ (kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n)),
      IsGKSubmodule (realStandardRep n ds) (realStandardLie n ds) R ∧ R ≠ ⊤ ∧
        ∀ W : Submodule ℂ (kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n)),
          IsGKSubmodule (realStandardRep n ds) (realStandardLie n ds) W → W ≠ ⊤ → W ≤ R

/-- Vogan's theorem (1978, Theorem 6.2, proof of (a) ⇒ (f)) for `GL_n(ℝ)` in submodule form:
let `ds` be a list of real blocks of total rank `n` in Langlands order and `R` the largest
proper `(𝔤, K)`-submodule of the `O(n)`-finite functions of its standard module. If the
Langlands quotient by `R` is maximally faithful (Vogan's "large"), then `R = 0`: the
standard module is irreducible. -/
def RealLargeStandardIrreducibleStatement : Prop :=
  ∀ (n : ℕ) (ds : List RealBlock)
    (R : Submodule ℂ (kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n))),
    realRank ds = n → IsRealLanglandsOrdered ds →
      IsGKSubmodule (realStandardRep n ds) (realStandardLie n ds) R → R ≠ ⊤ →
        (∀ W : Submodule ℂ (kFiniteFunctions (realStandardModule n ds) (unitaryCompact ℝ n)),
          IsGKSubmodule (realStandardRep n ds) (realStandardLie n ds) W → W ≠ ⊤ → W ≤ R) →
          IsMaximallyFaithfulModulo (realStandardLie n ds) R → R = ⊥

/-- The Langlands quotient statement and Vogan's irreducibility statement imply that nonzero
intertwiners from Langlands-ordered standard modules onto large irreducible admissible
`(𝔤𝔩_n(ℝ), O(n))`-modules are injective. -/
def RealLargeLanglandsQuotientReductionStatement : Prop :=
  RealStandardLanglandsQuotientStatement → RealLargeStandardIrreducibleStatement →
    RealLargeLanglandsQuotientInjectiveStatement.{uV}

/-- The reduction: `B` is onto, so its kernel is the largest proper submodule `R`; the
quotient by `ker B` is maximally faithful because `V` is, so `ker B = R = 0`. -/
theorem realLargeLanglandsQuotientReduction :
    RealLargeLanglandsQuotientReductionStatement.{uV} := by
  intro hL hV n V _ _ ρ π ds B _hgk hirr _hadm hmf hrank hord hB0 hBint
  have hsurj := hBint.surjective hirr hB0
  obtain ⟨R, hRgk, hRtop, hRmax⟩ := hL n ds hrank hord
  have hker := hBint.isGKSubmodule_ker
  have hkerR : LinearMap.ker B ≤ R :=
    hRmax _ hker fun h => hB0 (LinearMap.ker_eq_top.1 h)
  have hRker : R ≤ LinearMap.ker B := by
    have hmap := hBint.isGKSubmodule_map hRgk
    rcases hirr.2 _ hmap.1 hmap.2 with h | h
    · intro r hr
      have hBr : B r ∈ R.map B := Submodule.mem_map_of_mem hr
      rw [h, Submodule.mem_bot] at hBr
      exact hBr
    · refine absurd (eq_top_iff.2 fun f _ => ?_) hRtop
      obtain ⟨r, hr, hrf⟩ : B f ∈ R.map B := h ▸ Submodule.mem_top
      have hfr : f - r ∈ R := hkerR (by rw [LinearMap.mem_ker, map_sub, hrf, sub_self])
      simpa using R.add_mem hfr hr
  have hR : R = LinearMap.ker B := le_antisymm hRker hkerR
  have hmfR : IsMaximallyFaithfulModulo (realStandardLie n ds) R := by
    rw [hR]
    exact (isMaximallyFaithfulModulo_ker_iff _ π B hBint.map_realStandardLie hsurj).2 hmf
  rw [← LinearMap.ker_eq_bot, ← hR]
  exact hV n ds R hrank hord hRgk hRtop hRmax hmfR

end Langlands.Archimedean
