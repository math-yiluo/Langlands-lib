import Langlands.Representation.Archimedean.GLVermaInject
import Langlands.Representation.Archimedean.BGChaseEnveloping

/-!
# Kostant's lower bound at one central character

For a finite-dimensional representation `σ` of `𝔤𝔩_n(ℂ)` on `W` with integral weights we
construct `d = dim W₀` covariants `f_i : W → U(𝔤𝔩_n(ℂ))` (`f_i(σ(Y) w) = [Y, f_i(w)]`) whose
images modulo the left ideal generated by `z - χ(z)` are linearly independent, for one character
`χ` of the center: the central character of the finite-dimensional irreducible module
`L = LowMod n A` with lowest weight `A·(0, 1, …, n-1)`, `A` large compared with the weights of
`W`.

* `finrank_zeroWeightSpace`: `dim W₀` is the number of weight basis vectors of weight `0`.
* `exists_lift_covariant`: a covariant `g : W → End V` into a finite-dimensional irreducible
  module lifts to a covariant `f : W → U(𝔤𝔩_n(ℂ))` (Burnside's theorem gives a degree `N` with
  `U_N ↠ End V`; the invariant lifting theorem of `GLReynolds` applied to
  `Hom(W, U_N) ↠ Hom(W, End V)` lifts the invariant `g`).
* `envOf_eq_zero_of_mem_span`: the left ideal generated by the `z - χ_V(z)` acts by zero on `V`.
* `exists_kostantOne`: the lower bound at the central character of `L`.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

namespace GLReynolds

open ComplexJacquetFinite Module Polynomial

/-! ### The dimension of the zero weight space -/

section ZeroWeight

variable {n : ℕ} {W : Type*} [AddCommGroup W] [Module ℂ W]
  {ι : Type*} [Fintype ι] (b : Module.Basis ι ℂ W) {μ : ι → Fin n → ℤ}

theorem zeroWeightSpace_eq_span (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W)
    (hb : ∀ i, IsWeightVec (famOf σ) (μ i) (b i)) :
    VermaGL.zeroWeightSpace σ =
      Submodule.span ℂ (Set.range fun k : {k // μ k = 0} => b k) := by
  classical
  apply le_antisymm
  · intro w hw
    have hw' : ∀ p, famOf σ p p w = 0 := fun p =>
      LinearMap.mem_ker.mp ((Submodule.mem_iInf _).mp hw p)
    rw [← b.sum_repr w]
    refine Submodule.sum_mem _ fun i _ => ?_
    by_cases hi : μ i = 0
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩)
    · have hc : b.repr w i = 0 := by
        obtain ⟨p, hp⟩ : ∃ p, μ i p ≠ 0 := by
          by_contra h
          exact hi (funext fun p => by_contra fun hp => h ⟨p, hp⟩)
        have h1 := coord_diag b hb i p w
        rw [hw' p, map_zero, Module.Basis.coord_apply] at h1
        have h2 : ((μ i p : ℤ) : ℂ) ≠ 0 := by exact_mod_cast hp
        exact (mul_eq_zero.mp h1.symm).resolve_left h2
      rw [hc, zero_smul]
      exact Submodule.zero_mem _
  · rw [Submodule.span_le]
    rintro _ ⟨⟨k, hk⟩, rfl⟩
    refine (Submodule.mem_iInf _).mpr fun p => LinearMap.mem_ker.mpr ?_
    have h := hb k p
    rw [hk] at h
    change famOf σ p p (b k) = 0
    rw [h]
    simp

theorem finrank_zeroWeightSpace (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W)
    (hb : ∀ i, IsWeightVec (famOf σ) (μ i) (b i)) :
    finrank ℂ (VermaGL.zeroWeightSpace σ) = Fintype.card {k // μ k = 0} := by
  rw [zeroWeightSpace_eq_span b σ hb]
  exact finrank_span_eq_card (b.linearIndependent.comp _ Subtype.val_injective)

end ZeroWeight

/-! ### Lifting covariants to the enveloping algebra -/

section Lift

open Langlands.Algebra.UniversalEnveloping

variable {n : ℕ} {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
  [Nontrivial V] {e : Fin n → Fin n → Module.End ℂ V}

/-- Burnside's theorem with a degree bound: some `U_N` maps onto `End V`. -/
theorem exists_degree_surjective (he : IsGlFamily e)
    (hirr : ∀ Z : Submodule ℂ V, IsStable e Z → Z ≠ ⊥ → Z = ⊤) :
    ∃ N : ℕ, ∀ T : Module.End ℂ V, ∃ u ∈ degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N,
      envOf e he u = T := by
  classical
  set B := Module.finBasis ℂ (Module.End ℂ V)
  have hs := envOf_surjective he hirr
  choose u hu using fun j => hs (B j)
  choose d hd using fun j => exists_mem_degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) (u j)
  refine ⟨Finset.univ.sup d, fun T => ?_⟩
  set S := degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) (Finset.univ.sup d)
  have hle : Submodule.span ℂ (Set.range B) ≤ S.map (envOf e he).toLinearMap := by
    rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact ⟨u j, degreeFiltration_mono ℂ _ (Finset.le_sup (Finset.mem_univ j)) (hd j), hu j⟩
  rw [B.span_eq] at hle
  obtain ⟨x, hx, hxT⟩ := hle (Submodule.mem_top (x := T))
  exact ⟨x, hx, hxT⟩

/-- **Lifting covariants.** Let `V` be a finite-dimensional irreducible module and `σ` a
finite-dimensional representation with integral weights. A covariant `g : W → End V`
(`g(σ(E_pq) w) = e_pq g(w) - g(w) e_pq`) is the image of a covariant `f : W → U(𝔤𝔩_n(ℂ))`. -/
theorem exists_lift_covariant (he : IsGlFamily e)
    (hirr : ∀ Z : Submodule ℂ V, IsStable e Z → Z ≠ ⊥ → Z = ⊤)
    {W : Type*} [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
    (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W) (hσ : VermaGL.HasIntegralWeights σ)
    (g : W →ₗ[ℂ] Module.End ℂ V)
    (hg : ∀ p q w, g (famOf σ p q w) = e p q * g w - g w * e p q) :
    ∃ f : W →ₗ[ℂ] VermaGL.glU n,
      (∀ Y w, f (σ Y w) = UniversalEnvelopingAlgebra.ι ℂ Y * f w -
        f w * UniversalEnvelopingAlgebra.ι ℂ Y) ∧ ∀ w, envOf e he (f w) = g w := by
  classical
  obtain ⟨N, hN⟩ := exists_degree_surjective he hirr
  set S := degreeFiltration ℂ (Matrix (Fin n) (Fin n) ℂ) N with hS_def
  have hS : ∀ Y, ∀ s ∈ S, BGChase.adU Y s ∈ S := fun Y _ hs =>
    BGChase.adU_mem_degreeFiltration Y hs
  set τ := BGChase.restrictLie BGChase.adU S hS with hτ_def
  have hτ : BGChase.intSpan (BGChase.diagOps τ) = ⊤ :=
    BGChase.intSpan_restrictLie_of_le S hS (by rw [BGChase.intSpan_adU]; exact le_top)
  have hH : VermaGL.HasIntegralWeights (BGChase.homLie σ τ) := BGChase.intSpan_homLie hσ hτ
  set ψ : S →ₗ[ℂ] Module.End ℂ V := (envOf e he).toLinearMap ∘ₗ S.subtype with hψ_def
  have hψ : Function.Surjective ψ := by
    intro T
    obtain ⟨u, hu, huT⟩ := hN T
    exact ⟨⟨u, hu⟩, huT⟩
  set φ : (W →ₗ[ℂ] S) →ₗ[ℂ] (W →ₗ[ℂ] Module.End ℂ V) :=
    LinearMap.llcomp ℂ W S (Module.End ℂ V) ψ with hφ_def
  have hφ : Function.Surjective φ := hψ.surjective_linearMapComp_left
  set adL : Fin n → Fin n → Module.End ℂ (Module.End ℂ V) := fun p q =>
    LinearMap.mulLeft ℂ (e p q) - LinearMap.mulRight ℂ (e p q) with hadL
  have hφe : ∀ p q x, φ (famOf (BGChase.homLie σ τ) p q x) =
      homFam (famOf σ) adL p q (φ x) := by
    intro p q x
    ext w
    rw [homFam_apply]
    simp only [φ, LinearMap.llcomp_apply, LinearMap.comp_apply, famOf_apply,
      BGChase.homLie_apply, map_sub, adL, LinearMap.sub_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply, ψ, Submodule.subtype_apply, AlgHom.toLinearMap_apply]
    rw [hτ_def, BGChase.restrictLie_apply, BGChase.adU_apply, map_sub, map_mul, map_mul, envOf_ι,
      lieOf_single, LinearMap.sub_apply]
  have hy : ∀ p q, homFam (famOf σ) adL p q g = 0 := by
    intro p q
    ext w
    rw [homFam_apply, hg]
    simp [adL]
  obtain ⟨x, hx, hφx⟩ := exists_invariant_lift (isGlFamily_famOf _) (intWeights_famOf hH) φ hφ
    hφe hy
  refine ⟨S.subtype ∘ₗ x, fun Y w => ?_, fun w => ?_⟩
  · have hpq : ∀ p q w, ((x (σ (Matrix.single p q (1 : ℂ)) w) : S) : VermaGL.glU n) =
        UniversalEnvelopingAlgebra.ι ℂ (Matrix.single p q (1 : ℂ)) * ((x w : S) : VermaGL.glU n) -
          ((x w : S) : VermaGL.glU n) * UniversalEnvelopingAlgebra.ι ℂ (Matrix.single p q (1 : ℂ)) := by
      intro p q w
      have h := LinearMap.congr_fun (hx p q) w
      rw [famOf_apply, BGChase.homLie_apply, LinearMap.zero_apply, sub_eq_zero] at h
      rw [← h, BGChase.restrictLie_apply, BGChase.adU_apply]
    induction Y using Matrix.induction_on' with
    | h_zero => simp
    | h_add Y₁ Y₂ h₁ h₂ =>
      simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.subtype_apply] at h₁ h₂ ⊢
      rw [map_add σ, LinearMap.add_apply, map_add x, Submodule.coe_add, h₁, h₂,
        map_add (UniversalEnvelopingAlgebra.ι ℂ)]
      noncomm_ring
    | h_std_basis i j c =>
      have hc : Matrix.single i j c = c • Matrix.single i j (1 : ℂ) := by
        rw [Matrix.smul_single, smul_eq_mul, mul_one]
      simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.subtype_apply]
      rw [hc, map_smul σ, LinearMap.smul_apply, map_smul x, Submodule.coe_smul, hpq,
        map_smul (UniversalEnvelopingAlgebra.ι ℂ), smul_mul_assoc, mul_smul_comm, smul_sub]
  · have := LinearMap.congr_fun hφx w
    simpa [φ, ψ] using this

/-- The left ideal generated by the elements `z - χ_V(z)` acts by zero on `V`. -/
theorem envOf_eq_zero_of_mem_span (he : IsGlFamily e)
    (hirr : ∀ Z : Submodule ℂ V, IsStable e Z → Z ≠ ⊥ → Z = ⊤) {u : VermaGL.glU n}
    (hu : u ∈ Ideal.span {x | ∃ z : VermaGL.center n,
      x = (z : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (centChar he hirr z)}) :
    envOf e he u = 0 := by
  induction hu using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨z, rfl⟩ := hx
    rw [map_sub, envOf_center_eq he hirr z, AlgHom.commutes, Algebra.algebraMap_eq_smul_one]
    exact sub_self _
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul r x _ hx => rw [smul_eq_mul, map_mul, hx, mul_zero]

end Lift

/-! ### The lower bound at one central character -/

section KostantOne

variable {n : ℕ}

/-- **Kostant's lower bound at one central character.** For a finite-dimensional representation
`σ` of `𝔤𝔩_n(ℂ)` with integral weights there are a character `χ` of the center and
`d = dim W₀` covariants `f_i : W → U(𝔤𝔩_n(ℂ))` whose images modulo the left ideal generated by
the `z - χ(z)` are linearly independent. -/
theorem exists_kostantOne {W : Type*} [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
    (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W) (hσ : VermaGL.HasIntegralWeights σ) :
    ∃ χ : VermaGL.center n →ₐ[ℂ] ℂ,
      ∃ f : Fin (finrank ℂ (VermaGL.zeroWeightSpace σ)) → (W →ₗ[ℂ] VermaGL.glU n),
        (∀ i Y w, f i (σ Y w) = UniversalEnvelopingAlgebra.ι ℂ Y * f i w -
          f i w * UniversalEnvelopingAlgebra.ι ℂ Y) ∧
        ∀ c : Fin (finrank ℂ (VermaGL.zeroWeightSpace σ)) → ℂ,
          (∀ w, ∑ i, c i • f i w ∈
            Ideal.span {x | ∃ z : VermaGL.center n,
              x = (z : VermaGL.glU n) - algebraMap ℂ (VermaGL.glU n) (χ z)}) →
          c = 0 := by
  classical
  obtain ⟨ι, _, b, μ, hb'⟩ := BGChase.exists_wtBasis (H := BGChase.diagOps σ) hσ
  have hb : ∀ i, IsWeightVec (famOf σ) (μ i) (b i) := fun i p => hb' i p
  set s := famOf σ with hs_def
  have hs : IsGlFamily s := isGlFamily_famOf σ
  -- the parameter `A`
  set A : ℕ := n * ∑ i, ∑ p, (μ i p).natAbs with hA_def
  have hA : ∀ i, ((n : ℤ) - 1) * ∑ p, |μ i p| ≤ A := by
    intro i
    have h1 : ∑ p, |μ i p| ≤ ∑ j, ∑ p, |μ j p| :=
      Finset.single_le_sum (f := fun j => ∑ p, |μ j p|)
        (fun j _ => Finset.sum_nonneg fun p _ => abs_nonneg _) (Finset.mem_univ i)
    have h2 : ((A : ℕ) : ℤ) = (n : ℤ) * ∑ j, ∑ p, |μ j p| := by
      simp only [hA_def, Nat.cast_mul, Nat.cast_sum, Int.natCast_natAbs]
    rw [h2]
    have h3 : (0 : ℤ) ≤ ∑ p, |μ i p| := Finset.sum_nonneg fun p _ => abs_nonneg _
    have h4 : (0 : ℤ) ≤ n := Int.natCast_nonneg n
    nlinarith
  -- the irreducible module `L`
  have he := isGlFamily_lowFam (n := n) A
  have : Nontrivial (LowMod n A) := nontrivial_of_ne _ _ (lowGen_ne_zero A)
  have hirr : ∀ Z : Submodule ℂ (LowMod n A), IsStable (lowFam n A) Z → Z ≠ ⊥ → Z = ⊤ :=
    fun Z hZ hZ0 => eq_top_of_isStable_lowMod A hZ hZ0
  set χ := centChar he hirr
  -- the covariants indexed by the zero weight basis vectors
  have hF : ∀ k : {k // μ k = 0}, ∃ f : W →ₗ[ℂ] VermaGL.glU n,
      (∀ Y w, f (σ Y w) = UniversalEnvelopingAlgebra.ι ℂ Y * f w -
        f w * UniversalEnvelopingAlgebra.ι ℂ Y) ∧
      ∀ w, envOf (lowFam n A) he (f w) (lowGen n A) =
        ys b s (lowFam n A) μ (lowWt A) (lowGen n A) k w := by
    intro k
    obtain ⟨g, hg, hgv⟩ := exists_covariant hs he (isLowest_lowGen A) (lowGen_ne_zero A)
      (genSub_lowGen A) (isLowest_ys b hs he hb (isLowest_lowGen A) k.2)
    obtain ⟨f, hf, hfg⟩ := exists_lift_covariant he hirr σ hσ g hg
    exact ⟨f, hf, fun w => by rw [hfg, hgv]⟩
  choose F hFcov hFv using hF
  have hcard : Fintype.card {k // μ k = 0} = finrank ℂ (VermaGL.zeroWeightSpace σ) :=
    (finrank_zeroWeightSpace b σ hb).symm
  set eqv := Fintype.equivFinOfCardEq hcard
  refine ⟨χ, fun i => F (eqv.symm i), fun i Y w => hFcov _ Y w, fun c hc => ?_⟩
  -- transfer to `L`
  set c' : ι → ℂ := fun k => if h : μ k = 0 then c (eqv ⟨k, h⟩) else 0 with hc'
  have hsum : ∑ k, c' k • ys b s (lowFam n A) μ (lowWt A) (lowGen n A) k = 0 := by
    refine LinearMap.ext fun w => ?_
    have h1 := envOf_eq_zero_of_mem_span he hirr (hc w)
    have h2 := LinearMap.congr_fun h1 (lowGen n A)
    simp only [map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply, hFv,
      LinearMap.zero_apply] at h2
    simp only [LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.zero_apply]
    have h3 : ∑ k, c' k • ys b s (lowFam n A) μ (lowWt A) (lowGen n A) k w =
        ∑ k : {k // μ k = 0}, c (eqv k) • ys b s (lowFam n A) μ (lowWt A) (lowGen n A) k w := by
      rw [← Finset.sum_filter_of_ne (p := fun k => μ k = 0) fun k _ hk => by
        by_contra h
        exact hk (by simp [hc', h])]
      rw [Finset.sum_subtype (p := fun k => μ k = 0) _ fun k => by simp]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp [hc', k.2]
    rw [h3, ← h2, ← eqv.sum_comp]
    simp
  have hc'0 := ys_eq_zero A b σ hb hA c' (fun k hk => by simp [hc', hk]) hsum
  funext i
  have h := congr_fun hc'0 (eqv.symm i)
  simp only [hc', (eqv.symm i).2, dite_true, Subtype.coe_eta, Equiv.apply_symm_apply,
    Pi.zero_apply] at h
  exact h

end KostantOne

end GLReynolds

end Langlands.Archimedean
