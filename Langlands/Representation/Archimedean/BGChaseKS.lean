import Langlands.Representation.Archimedean.LowerVerma
import Langlands.Representation.Archimedean.BGChaseEnveloping

/-!
# Lifting equivariant maps into `End M⁻(λ)` to `U(𝔤𝔩_n(ℂ))`

For `Z`-extremal `λ`, Duflo's theorem, Kostant's multiplicity lower bound and the upper bound
for equivariant maps into `End M⁻(λ)` show that every equivariant map `W → End M⁻(λ)` from a
finite-dimensional representation with integral weights is the composite of an equivariant map
`W → U(𝔤𝔩_n(ℂ))` with the action (Bernstein–Gelfand 1980, 1.11 and proof of 5.10).
-/

noncomputable section

open scoped TensorProduct

set_option autoImplicit false

namespace Langlands.Archimedean.BGChase

attribute [local instance 100] LieRing.ofAssociativeRing

open VermaGL

universe uW

variable {n : ℕ}

/-- The enveloping action of the `𝔤𝔩_n(ℂ)`-action on `M⁻(λ)` is the module structure. -/
theorem envelopingAction_action (lam : Fin n → ℂ) (u : glU n) (m : LowerVerma n lam) :
    envelopingAction (action n lam) u m = u • m := by
  induction u using InfinitesimalCharacter.envInduction generalizing m with
  | algebraMap c =>
    rw [AlgHom.commutes, Module.algebraMap_end_apply, algebraMap_smul]
  | ι a =>
    rw [UniversalEnvelopingAlgebra.lift_ι_apply]
    rfl
  | mul a b ha hb =>
    rw [map_mul, Module.End.mul_apply, hb, ha, mul_smul]
  | add a b ha hb =>
    rw [map_add, LinearMap.add_apply, ha, hb, add_smul]

/-- Elements of `U` acting by zero on `M⁻(λ)` lie in the left ideal generated by the `z - χ(z)`,
`χ` the central character of `M⁻(λ)` (Duflo's theorem). -/
theorem mem_span_of_action_eq_zero (hWt : LowerVermaWeightStatement)
    (hDuflo : LowerVermaDufloStatement) {lam : Fin n → ℂ} (χ : center n →ₐ[ℂ] ℂ)
    (hχ : ∀ z : center n, (z : glU n) • gen n lam = χ z • gen n lam) {u : glU n}
    (hu : envelopingAction (action n lam) u = 0) :
    u ∈ Ideal.span {x | ∃ z : center n, x = (z : glU n) - algebraMap ℂ (glU n) (χ z)} := by
  refine Ideal.span_mono ?_ (hDuflo n lam u hu)
  rintro z ⟨hz, hz0⟩
  refine ⟨⟨z, hz⟩, ?_⟩
  have h1 : z • gen n lam = 0 := by
    rw [← envelopingAction_action, hz0, LinearMap.zero_apply]
  have h2 : χ ⟨z, hz⟩ = 0 := by
    have h := hχ ⟨z, hz⟩
    rw [h1] at h
    exact (smul_eq_zero.1 h.symm).resolve_right (hWt n lam).1
  rw [h2, map_zero, sub_zero]

/-- A vector satisfying a property `P` lies in the span of a linearly independent family
`G : Fin d → X` of vectors satisfying `P`, provided no `d + 1` linearly independent vectors satisfy
`P`. Stated for an additive commutative monoid so that it applies without instance unification
through `AddCommGroup`. -/
theorem mem_span_of_linearIndependent_bound {X : Type*} [AddCommMonoid X] [Module ℂ X]
    (P : X → Prop) {d : ℕ} (G : Fin d → X) (hG : ∀ i, P (G i))
    (hGind : ∀ c : Fin d → ℂ, ∑ i, c i • G i = 0 → c = 0)
    (hB : ∀ F : Fin (d + 1) → X, (∀ i, P (F i)) → LinearIndependent ℂ F → False)
    (g : X) (hg : P g) : g ∈ Submodule.span ℂ (Set.range G) := by
  let _ : AddCommGroup X := Module.addCommMonoidToAddCommGroup ℂ
  by_contra hgn
  have hGi : LinearIndependent ℂ G :=
    Fintype.linearIndependent_iff.2 fun c hc => congr_fun (hGind c hc)
  refine hB (Fin.cons g G) (fun i => ?_) (linearIndependent_finCons.2 ⟨hGi, hgn⟩)
  refine Fin.cases ?_ (fun j => ?_) i
  · simpa using hg
  · simpa using hG j

/-- Lifting of equivariant maps (Bernstein–Gelfand 1980, 1.11, proof of 5.10): for `Z`-extremal
`λ`, every equivariant map `g : W → End M⁻(λ)` from a finite-dimensional representation with
integral weights is `u ↦ (action of u)` composed with a linear map `W → U`. -/
theorem exists_lift (hWt : LowerVermaWeightStatement) (hDuflo : LowerVermaDufloStatement)
    (hK : KostantMultiplicityStatement.{uW}) (hB : LowerVermaHomBoundStatement.{uW})
    {lam : Fin n → ℂ} (hlam : IsZExtremal n lam) (χ : center n →ₐ[ℂ] ℂ)
    (hχ : ∀ z : center n, (z : glU n) • gen n lam = χ z • gen n lam)
    {W : Type uW} [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
    (σ : Matrix (Fin n) (Fin n) ℂ →ₗ⁅ℂ⁆ Module.End ℂ W) (hσ : HasIntegralWeights σ)
    (g : W →ₗ[ℂ] Module.End ℂ (LowerVerma n lam))
    (hg : ∀ Y w, g (σ Y w) = action n lam Y * g w - g w * action n lam Y) :
    ∃ g' : W →ₗ[ℂ] glU n, ∀ w, envelopingAction (action n lam) (g' w) = g w := by
  obtain ⟨f, hfeq, hfind⟩ := hK n W σ hσ χ
  have hB' := hB n lam hlam W σ hσ
  generalize Module.finrank ℂ (zeroWeightSpace σ) = d at f hfeq hfind hB'
  let Λ := envelopingAction (action n lam)
  let G : Fin d → (W →ₗ[ℂ] Module.End ℂ (LowerVerma n lam)) := fun i =>
    Λ.toLinearMap ∘ₗ f i
  have hG : ∀ i w, G i w = Λ (f i w) := fun _ _ => rfl
  have hGeq : ∀ i Y w, G i (σ Y w) = action n lam Y * G i w - G i w * action n lam Y := by
    intro i Y w
    rw [hG, hG, hfeq, map_sub, map_mul, map_mul, UniversalEnvelopingAlgebra.lift_ι_apply]
  have hGind : ∀ c : Fin d → ℂ, ∑ i, c i • G i = 0 → c = 0 := by
    intro c hc
    refine hfind c fun w => mem_span_of_action_eq_zero hWt hDuflo χ hχ ?_
    have h := LinearMap.congr_fun hc w
    simp only [LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.zero_apply, hG] at h
    rw [map_sum]
    simpa only [map_smul] using h
  have hmem : g ∈ Submodule.span ℂ (Set.range G) :=
    mem_span_of_linearIndependent_bound
      (fun F => ∀ Y w, F (σ Y w) = action n lam Y * F w - F w * action n lam Y) G hGeq hGind
      (fun F hF hind => by have := hB' (d + 1) F hF hind; omega) g hg
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).1 hmem
  refine ⟨∑ i, c i • f i, fun w => ?_⟩
  rw [← hc]
  simp only [LinearMap.sum_apply, LinearMap.smul_apply, map_sum, map_smul, hG]
  rfl

end Langlands.Archimedean.BGChase
