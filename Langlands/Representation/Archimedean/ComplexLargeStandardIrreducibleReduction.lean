import Langlands.Representation.Archimedean.RealLargeLanglandsQuotientReduction
import Langlands.Representation.Archimedean.ComplexLargePrincipalSeriesReduction

/-!
# Reduction of Vogan's theorem for large Langlands quotients of `GL_n(ℂ)`

`ComplexLargeLanglandsQuotientInjectiveStatement` (V1′; Vogan 1978, Theorem 6.2, proof of
(a) ⇒ (f)) says that a nonzero `(𝔤, K)`-intertwining map from the `U(n)`-finite functions of a
Langlands-ordered complex standard module into an irreducible admissible large
`(𝔤𝔩_n(ℂ), U(n))`-module is injective. This file splits it into two statements about the
`(𝔤𝔩_n(ℂ), U(n))`-module `(complexStandardRep n ds, complexStandardLie n ds)` of a standard
module, in the same way as `RealLargeLanglandsQuotientReduction` does for `GL_n(ℝ)`:

* `ComplexStandardLanglandsQuotientStatement` (Langlands quotient; Badulescu–Renard 2010,
  Theorem 3.3 (i), and Knapp 1994, Theorem 4 (a)): a Langlands-ordered standard module
  has a largest proper `(𝔤, K)`-submodule `R`, so that `I / R` is its Langlands quotient;
* `ComplexLargeStandardIrreducibleStatement` (Vogan 1978, Theorem 6.2, proof of (a) ⇒ (f)):
  if the Langlands quotient `I / R` is large (maximally faithful), then `R = 0`, that is, the
  standard module is irreducible.

`complexLargeStandardIrreducibleReduction` proves that the two imply V1′: a nonzero intertwining
map `A` into an irreducible module is onto, its kernel is the largest proper submodule `R`,
and `I / ker A ≅ V` is maximally faithful, so `ker A = R = 0`.
-/

noncomputable section

open scoped TensorProduct Matrix

set_option autoImplicit false

namespace Langlands.Archimedean

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.LocalFactor.Archimedean
open scoped Matrix.Norms.Operator

-- As in `GKModule`: the charts on units need reduction through the normed-ring instances of
-- matrices.
set_option backward.isDefEq.respectTransparency false

universe uK uL uX uV

/-! ## Intertwining maps and largest proper submodules -/

section General

variable {K : Type uK} [Group K] {L : Type uL} [LieRing L] [LieAlgebra ℂ L]
  {X : Type uX} [AddCommGroup X] [Module ℂ X] {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {σ : Representation ℂ K X} {τ : L →ₗ⁅ℂ⁆ Module.End ℂ X}
  {ρ : Representation ℂ K V} {π : L →ₗ⁅ℂ⁆ Module.End ℂ V} {B : X →ₗ[ℂ] V}

/-- The kernel of a linear map that intertwines `(σ, τ)` with `(ρ, π)` is a
`(𝔤, K)`-submodule. -/
theorem isGKSubmodule_ker_of_intertwine (hρ : ∀ (k : K) (f : X), B (σ k f) = ρ k (B f))
    (hπ : ∀ (Y : L) (f : X), B (τ Y f) = π Y (B f)) :
    IsGKSubmodule σ τ (LinearMap.ker B) :=
  ⟨fun k w hw => by rw [LinearMap.mem_ker, hρ, LinearMap.mem_ker.1 hw, map_zero],
    fun Y w hw => by rw [LinearMap.mem_ker, hπ, LinearMap.mem_ker.1 hw, map_zero]⟩

/-- A linear map that intertwines `(σ, τ)` with `(ρ, π)` carries `(𝔤, K)`-submodules to
`(𝔤, K)`-submodules. -/
theorem isGKSubmodule_map_of_intertwine (hρ : ∀ (k : K) (f : X), B (σ k f) = ρ k (B f))
    (hπ : ∀ (Y : L) (f : X), B (τ Y f) = π Y (B f)) {W : Submodule ℂ X}
    (hW : IsGKSubmodule σ τ W) : IsGKSubmodule ρ π (W.map B) := by
  constructor
  · rintro k _ ⟨w, hw, rfl⟩
    exact ⟨σ k w, hW.1 k w hw, hρ k w⟩
  · rintro Y _ ⟨w, hw, rfl⟩
    exact ⟨τ Y w, hW.2 Y w hw, hπ Y w⟩

/-- Let `B` be a nonzero linear map that intertwines `(σ, τ)` with an irreducible `(ρ, π)`,
and let `R` be a largest proper `(𝔤, K)`-submodule of `(σ, τ)`. Then `R = ker B`: the kernel
is a proper submodule, so it lies in `R`; and `B(R)` is a submodule of the irreducible
module, which cannot be everything since `R` is proper and contains `ker B`, so it is `0`. -/
theorem eq_ker_of_largest_proper (hρ : ∀ (k : K) (f : X), B (σ k f) = ρ k (B f))
    (hπ : ∀ (Y : L) (f : X), B (τ Y f) = π Y (B f)) (hirr : IsIrreducibleGKModule ρ π)
    (hB0 : B ≠ 0) {R : Submodule ℂ X} (hR : IsGKSubmodule σ τ R) (hRtop : R ≠ ⊤)
    (hRmax : ∀ W : Submodule ℂ X, IsGKSubmodule σ τ W → W ≠ ⊤ → W ≤ R) :
    R = LinearMap.ker B := by
  have hkerR : LinearMap.ker B ≤ R :=
    hRmax _ (isGKSubmodule_ker_of_intertwine hρ hπ) fun h => hB0 (LinearMap.ker_eq_top.1 h)
  refine le_antisymm ?_ hkerR
  have hmap := isGKSubmodule_map_of_intertwine hρ hπ hR
  rcases hirr.2 _ hmap.1 hmap.2 with h | h
  · intro r hr
    have hBr : B r ∈ R.map B := Submodule.mem_map_of_mem hr
    rw [h, Submodule.mem_bot] at hBr
    exact hBr
  · refine absurd (eq_top_iff.2 fun f _ => ?_) hRtop
    obtain ⟨r, hr, hrf⟩ : B f ∈ R.map B := h ▸ Submodule.mem_top
    have hfr : f - r ∈ R := hkerR (by rw [LinearMap.mem_ker, map_sub, hrf, sub_self])
    simpa using R.add_mem hfr hr

end General

/-! ## Large modules are maximally faithful -/

/-- `IsComplexLargeGKModule n π` is `IsMaximallyFaithful π`: both say that every element of the
enveloping algebra acting by zero lies in the left ideal generated by the central elements
acting by zero (`Ideal.span` is `Submodule.span` over the ring itself). -/
theorem isComplexLargeGKModule_iff_isMaximallyFaithful (n : ℕ) {V : Type uV} [AddCommGroup V]
    [Module ℂ V] (π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) →ₗ⁅ℂ⁆ Module.End ℂ V) :
    IsComplexLargeGKModule n π ↔ IsMaximallyFaithful π :=
  Iff.rfl

/-! ## Intertwining maps out of a complex standard module -/

section Standard

variable {n : ℕ} {V : Type uV} [AddCommGroup V] [Module ℂ V]
  {ρ : Representation ℂ (Matrix.unitaryGroup (Fin n) ℂ) V}
  {π : (ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) →ₗ⁅ℂ⁆ Module.End ℂ V} {ds : List ComplexCharacterData}
  {A : kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n) →ₗ[ℂ] V}

/-- An `IsComplexStandardIntertwining` map carries `complexStandardRep` to `ρ`. -/
theorem IsComplexStandardIntertwining.map_complexStandardRep
    (hA : IsComplexStandardIntertwining n ρ π ds A) (k : Matrix.unitaryGroup (Fin n) ℂ)
    (f : kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n)) :
    A (complexStandardRep n ds k f) = ρ k (A f) := by
  obtain ⟨hf, hAf⟩ := hA.1 ⟨Unitary.toUnits k, k.2⟩ f
  have h1 : complexStandardRep n ds k f = ⟨_, hf⟩ :=
    Subtype.ext (principalSeriesRep_apply_coe ℂ n (complexPositionCharacter ds) k f)
  rw [h1, hAf]
  rfl

/-- An `IsComplexStandardIntertwining` map carries `complexStandardLie` to `π` on all of
`ℂ ⊗_ℝ 𝔤𝔩_n(ℂ)`, by `ℂ`-linearity from the real directions `1 ⊗ X`. -/
theorem IsComplexStandardIntertwining.map_complexStandardLie
    (hA : IsComplexStandardIntertwining n ρ π ds A) (Y : ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ)
    (f : kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n)) :
    A (complexStandardLie n ds Y f) = π Y (A f) := by
  induction Y using TensorProduct.inductionOn with
  | tmul c X =>
    have hc : (c ⊗ₜ[ℝ] X : ℂ ⊗[ℝ] Matrix (Fin n) (Fin n) ℂ) = c • ((1 : ℂ) ⊗ₜ[ℝ] X) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    obtain ⟨hf, hAf⟩ := hA.2 X f
    have h1 : complexStandardLie n ds (1 ⊗ₜ X) f = ⟨_, hf⟩ :=
      Subtype.ext (principalSeriesLie_one_tmul_apply_coe ℂ n (complexPositionCharacter ds) X f)
    rw [hc, map_smul, LinearMap.smul_apply, map_smul, h1, hAf, map_smul, LinearMap.smul_apply]
  | add Y Z hY hZ =>
    rw [map_add, LinearMap.add_apply, map_add, hY, hZ, map_add, LinearMap.add_apply]

end Standard

/-! ## The two statements and the reduction -/

/-- The Langlands quotient of a complex standard module (Badulescu–Renard 2010, Theorem 3.3 (i):
a unique irreducible quotient, of multiplicity one; Knapp 1994, Theorem 4 (a)): for a list `ds`
of `n` complex characters in the Langlands order, the `(𝔤𝔩_n(ℂ), U(n))`-module of `U(n)`-finite
functions of the standard module of `ds` has a largest proper `(𝔤, K)`-submodule `R`: a proper `(𝔤, K)`-submodule containing
every proper `(𝔤, K)`-submodule. The quotient by `R` is the Langlands quotient. -/
def ComplexStandardLanglandsQuotientStatement : Prop :=
  ∀ (n : ℕ) (ds : List ComplexCharacterData), ds.length = n → IsComplexLanglandsOrdered ds →
    ∃ R : Submodule ℂ (kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n)),
      IsGKSubmodule (complexStandardRep n ds) (complexStandardLie n ds) R ∧ R ≠ ⊤ ∧
        ∀ W : Submodule ℂ (kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n)),
          IsGKSubmodule (complexStandardRep n ds) (complexStandardLie n ds) W → W ≠ ⊤ → W ≤ R

/-- Vogan's theorem (1978, Theorem 6.2, proof of (a) ⇒ (f)) for `GL_n(ℂ)` in submodule form:
let `ds` be a list of `n` complex characters in the Langlands order and `R` the largest proper
`(𝔤, K)`-submodule of the `U(n)`-finite functions of its standard module. If the Langlands
quotient by `R` is maximally faithful (Vogan's "large"), then `R = 0`: the standard module is
irreducible. -/
def ComplexLargeStandardIrreducibleStatement : Prop :=
  ∀ (n : ℕ) (ds : List ComplexCharacterData)
    (R : Submodule ℂ (kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n))),
    ds.length = n → IsComplexLanglandsOrdered ds →
      IsGKSubmodule (complexStandardRep n ds) (complexStandardLie n ds) R → R ≠ ⊤ →
        (∀ W : Submodule ℂ (kFiniteFunctions (complexStandardModule n ds) (unitaryCompact ℂ n)),
          IsGKSubmodule (complexStandardRep n ds) (complexStandardLie n ds) W → W ≠ ⊤ → W ≤ R) →
          IsMaximallyFaithfulModulo (complexStandardLie n ds) R → R = ⊥

/-- The Langlands quotient statement and Vogan's irreducibility statement imply that nonzero
intertwining maps from Langlands-ordered standard modules into large irreducible admissible
`(𝔤𝔩_n(ℂ), U(n))`-modules are injective. -/
def ComplexLargeStandardIrreducibleReductionStatement : Prop :=
  ComplexStandardLanglandsQuotientStatement → ComplexLargeStandardIrreducibleStatement →
    ComplexLargeLanglandsQuotientInjectiveStatement.{uV}

/-- The reduction: `A` is onto, so its kernel is the largest proper submodule `R`; the quotient
by `ker A` is maximally faithful because `V` is large, so `ker A = R = 0`. -/
theorem complexLargeStandardIrreducibleReduction :
    ComplexLargeStandardIrreducibleReductionStatement.{uV} := by
  intro hL hV n V _ _ ρ π ds A _hgk hirr _hadm hlarge hlen hord hA0 hA
  have hsurj := surjective_of_isComplexStandardIntertwining n hirr hA hA0
  obtain ⟨R, hRgk, hRtop, hRmax⟩ := hL n ds hlen hord
  have hR : R = LinearMap.ker A :=
    eq_ker_of_largest_proper hA.map_complexStandardRep hA.map_complexStandardLie hirr hA0 hRgk
      hRtop hRmax
  have hmfR : IsMaximallyFaithfulModulo (complexStandardLie n ds) R := by
    rw [hR]
    exact (isMaximallyFaithfulModulo_ker_iff _ π A hA.map_complexStandardLie hsurj).2
      ((isComplexLargeGKModule_iff_isMaximallyFaithful n π).1 hlarge)
  rw [← LinearMap.ker_eq_bot, ← hR]
  exact hV n ds R hlen hord hRgk hRtop hRmax hmfR

end Langlands.Archimedean
