import Langlands.Representation.CyclicSpan
import Mathlib.RepresentationTheory.Irreducible

/-! # Transport of cyclic representations under commuting refinements -/

noncomputable section

namespace Langlands.Cyclic

universe uK uG uH uV uW

variable {K : Type uK} [Field K] {G : Type uG} [Monoid G]
variable {H : Type uH} [Monoid H]
variable {V : Type uV} [AddCommGroup V] [Module K V]
variable {W : Type uW} [AddCommGroup W] [Module K W]
variable (ρ : Representation K G V) (v : V)

/-- Restricting an intertwiner to a cyclic subrepresentation is surjective onto
 the cyclic subrepresentation generated by the image of the generator. -/
theorem map_surjective {τ : Representation K G W} (f : ρ.IntertwiningMap τ) :
    Function.Surjective (map ρ v f) := by
  intro x
  have hx : (x : W) ∈ (FiniteVectors.orbitSpan ρ v).map f.toLinearMap := by
    rw [FiniteVectors.map_orbitSpan]
    exact x.prop
  obtain ⟨y, hy, hxy⟩ := hx
  exact ⟨⟨y, hy⟩, Subtype.ext hxy⟩

/-- A nonzero image of an irreducible cyclic representation is an equivalent
cyclic representation, with the equivalence given by the original intertwiner. -/
def mapEquiv {τ : Representation K G W} (f : ρ.IntertwiningMap τ)
    [hirr : (orbitSpan ρ v).toRepresentation.IsIrreducible] (hv : f v ≠ 0) :
    (orbitSpan ρ v).toRepresentation.Equiv (orbitSpan τ (f v)).toRepresentation := by
  refine (map ρ v f).ofBijective ⟨?_, map_surjective ρ v f⟩
  rcases Representation.IsIrreducible.injective_or_eq_zero (map ρ v f) with hi | hz
  · exact hi
  · exfalso
    apply hv
    have h := congrArg (fun T => ((T (generator ρ v) : (orbitSpan τ (f v)).toSubmodule) : W)) hz
    exact h

@[simp] theorem mapEquiv_generator {τ : Representation K G W}
    (f : ρ.IntertwiningMap τ) [(orbitSpan ρ v).toRepresentation.IsIrreducible]
    (hv : f v ≠ 0) :
    mapEquiv ρ v f hv (generator ρ v) = generator τ (f v) := rfl

/-- Any group-algebra element for a commuting action is an intertwiner. -/
def commutingAlgebraMap (σ : Representation K H V)
    (hcomm : ∀ g h x, σ h (ρ g x) = ρ g (σ h x))
    (a : MonoidAlgebra K H) : ρ.IntertwiningMap ρ where
  toLinearMap := σ.asAlgebraHom a
  isIntertwining' g := by
    apply LinearMap.ext
    intro x
    change σ.asAlgebraHom a (ρ g x) = ρ g (σ.asAlgebraHom a x)
    induction a using MonoidAlgebra.induction_linear with
    | zero => simp
    | add a b ha hb => simp [ha, hb]
    | single h c => simp [Representation.asAlgebraHom_single, hcomm]

@[simp] theorem commutingAlgebraMap_apply (σ : Representation K H V)
    (hcomm : ∀ g h x, σ h (ρ g x) = ρ g (σ h x))
    (a : MonoidAlgebra K H) (x : V) :
    commutingAlgebraMap ρ σ hcomm a x = σ.asAlgebraHom a x := rfl

/-- A nonzero refinement by a commuting action preserves an irreducible cyclic
representation, including the distinguished vector under the equivalence. -/
theorem exists_equiv_of_mem_commuting_orbitSpan (σ : Representation K H V)
    (hcomm : ∀ g h x, σ h (ρ g x) = ρ g (σ h x))
    [(orbitSpan ρ v).toRepresentation.IsIrreducible]
    {w : V} (hw : w ∈ orbitSpan σ v) (hw0 : w ≠ 0) :
    ∃ e : (orbitSpan ρ v).toRepresentation.Equiv (orbitSpan ρ w).toRepresentation,
      e (generator ρ v) = generator ρ w := by
  obtain ⟨a, ha⟩ := presentation_surjective σ v ⟨w, hw⟩
  have haw : σ.asAlgebraHom a v = w := congrArg Subtype.val ha
  subst w
  exact ⟨mapEquiv ρ v (commutingAlgebraMap ρ σ hcomm a) hw0, rfl⟩

end Langlands.Cyclic
