import Langlands.Representation.CuspidalSupport.BernsteinBlock
import Mathlib.CategoryTheory.Center.Basic

/-! # Characterization of representations of finite type (Renard VI.10.7, Lemma and Proposition)

A smooth representation of `G(F)` is of finite type if and only if it is `ℨ(G)`-admissible and
only finitely many Bernstein components occur in it, a component occurring when some
irreducible subquotient has that inertial support.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology
open Langlands.Aubert.General Langlands.Aubert.General.RationalPointFamily
open Langlands.GroupScheme
open scoped CategoryTheory.MonObj

namespace Langlands.CuspidalSupport

universe uF uV

/-- Renard VI.10.7, Lemma and Proposition, for the actual standard cuspidal data of a standard
family: a smooth representation `τ` of `G(F)` (carrier universe `max uF uV`) is finitely
generated over `ℂ[G(F)]` if and only if

* it is `ℨ(G)`-admissible: for every compact open `K`, the `K`-fixed vectors are generated by
  finitely many of them over the centre `ℨ(G) = CatCenter` of the category of smooth
  representations; and
* only finitely many inertial classes are the inertial support of an irreducible subquotient
  of `τ`.

The forward implication contains the Lemma (finitely many nonzero components) and the
Theorem of VI.10.7. -/
def FiniteTypeComponentCharacterizationStatement : Prop :=
  ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    [LocallyOfFiniteType G.X.hom]
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (i : T.toGrp ⟶ G)
    (ν : cocharacterLattice T),
    letI : TopologicalSpace (rationalPoints G) := pointTopology
    ∀ [LocallyCompactSpace (rationalPoints G)] [NonarchimedeanGroup (rationalPoints G)]
      (family : BernsteinStandardFamily i ν)
      (τ : SmoothRep.{0, uF, max uF uV} ℂ (rationalPoints G)),
      Module.Finite (MonoidAlgebra ℂ (rationalPoints G)) τ.representation.asModule ↔
        (∀ K : OpenSubgroup (rationalPoints G), IsCompact (K : Set (rationalPoints G)) →
          ∃ (n : ℕ) (s : Fin n → τ),
            (∀ j, ∀ g ∈ K, τ.representation g (s j) = s j) ∧
            ∀ x : τ, (∀ g ∈ K, τ.representation g x = x) →
              ∃ z : Fin n → CatCenter (SmoothRep.{0, uF, max uF uV} ℂ (rationalPoints G)),
                x = ∑ j, SmoothRep.hom ((z j).app τ) (s j)) ∧
        {s : BernsteinInertialClass.{uF, max uF uV} i ν family |
          ∃ π : SmoothRep.{0, uF, max uF uV} ℂ (rationalPoints G),
            SmoothRep.IsSubquotient π τ ∧ IsBernsteinInertialSupport i ν family s π}.Finite

end Langlands.CuspidalSupport
