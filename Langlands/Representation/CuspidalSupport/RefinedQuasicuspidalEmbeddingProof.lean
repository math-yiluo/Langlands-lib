import Langlands.Representation.CuspidalSupport.RefinedQuasicuspidalEmbeddingStatement
import Langlands.Representation.CuspidalSupport.MinimalRefinedJacquetProof
import Langlands.Representation.CuspidalSupport.QuasicuspidalEmbeddingProof
import Langlands.Representation.Parabolic.NaturalFirstAdjointness
import Langlands.Representation.Parabolic.RefinedInductionAdmissibility
import Langlands.Representation.Smooth.Transfer.PullbackProof

/-!
# Normalized quasicuspidal embedding in a product Levi

A proof of `NormalizedRefinedQuasicuspidalEmbeddingTheorem` (BZ76 Proposition
3.19, in the normalized conventions of BZ77 1.8). Descent gives a refinement
whose refined Jacquet module is nonzero and quasicuspidal on the flattened
Levi. Compactness of the refined parabolic coset space makes that module
finitely generated, so it has an irreducible quotient. Refined first
adjointness turns the quotient map into an intertwiner into normalized refined
induction, which is injective because the source is irreducible.
-/

noncomputable section

namespace Langlands.CuspidalSupport

open GeneralLinear Geometric

universe u uF uV

namespace RefinedQuasicuspidalEmbedding

section Coordinates

variable (R : Type u) [CommRing R] {n : ℕ} (B : BlockShape n) (S : BlockRefinement B)

/-- The flattened-Levi coordinates of the embedding target agree with the
explicit nested-refinement coordinates of the descent theorem. -/
theorem flattenedLeviEquiv_eq_leviRefinementEquiv :
    flattenedLeviEquiv R B S =
      BlockShape.leviRefinementEquiv (B.flatten S) B S (B.flattenBlockEquiv S)
        (fun q => (B.flatten_size_flattenBlockEquiv S q).symm) R := by
  ext m : 1
  apply (refinedLeviEquiv R B S).symm.injective
  funext i j
  rw [flattenedLeviEquiv_component]
  simp only [BlockShape.leviRefinementEquiv, MulEquiv.trans_apply, MulEquiv.symm_apply_apply,
    BlockShape.nestedLeviEquiv_apply]

end Coordinates

section Generation

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{uF} p} (T : F.TopologicalData) {n : ℕ}
  (B : BlockShape n) (S : BlockRefinement B) {V : Type uV} [AddCommGroup V] [Module ℂ V]

/-- The normalized refined Jacquet action pulled back to the flattened Levi
along the target's coordinate equivalence. -/
abbrev flattenedJacquet (ρ : Representation ℂ (B.Levi F.Carrier) V) :
    Representation ℂ ((B.flatten S).Levi F.Carrier) (RefinedJacquetModule B S ρ) :=
  (T.normalizedRefinedJacquet B S ρ).comp (flattenedLeviEquiv F.Carrier B S).toMonoidHom

theorem flattenedJacquet_symm (ρ : Representation ℂ (B.Levi F.Carrier) V)
    (m : refinedLevi F.Carrier B S) (x : RefinedJacquetModule B S ρ) :
    flattenedJacquet T B S ρ ((flattenedLeviEquiv F.Carrier B S).symm m) x =
      T.normalizedRefinedJacquet B S ρ m x := by
  change T.normalizedRefinedJacquet B S ρ
    (flattenedLeviEquiv F.Carrier B S ((flattenedLeviEquiv F.Carrier B S).symm m)) x = _
  rw [MulEquiv.apply_symm_apply]

/-- An invariant subspace for the flattened action containing the class of `v`
contains the class of every refined parabolic translate of `v`. -/
theorem refinedJacquetMk_parabolic_mem {ρ : Representation ℂ (B.Levi F.Carrier) V}
    (U : Subrepresentation (flattenedJacquet T B S ρ)) (q : refinedParabolic F.Carrier B S)
    {v : V} (hv : refinedJacquetMk B S ρ v ∈ U) :
    refinedJacquetMk B S ρ (ρ q.val v) ∈ U := by
  rw [Parabolic.FirstAdjointness.refinedJacquetMk_parabolic,
    Parabolic.FirstAdjointness.refinedJacquetMk_levi T, ← flattenedJacquet_symm]
  exact U.toSubmodule.smul_mem _ (U.apply_mem_toSubmodule _ hv)

/-- The refined Jacquet module of a representation generated by one smooth
vector is generated, for the flattened action, by finitely many vectors. -/
theorem exists_finset_generating {ρ : Representation ℂ (B.Levi F.Carrier) V}
    (hρ : letI := T.topology
      letI := T.leviTopologicalGroup B
      IsSmooth ρ) (v₀ : V)
    (hgen : ∀ v : V, v ∈ Submodule.span ℂ (Set.range fun g => ρ g v₀)) :
    ∃ s : Finset (RefinedJacquetModule B S ρ),
      ∀ U : Subrepresentation (flattenedJacquet T B S ρ), (∀ x ∈ s, x ∈ U) → U = ⊤ := by
  let := T.topology
  let := T.leviTopologicalGroup B
  have : CompactSpace (Induction.LeftQuotient (refinedParabolic F.Carrier B S)) :=
    Parabolic.refinedParabolicQuotientCompact F T B S
  obtain ⟨K, hK⟩ := hρ v₀
  obtain ⟨t, ht⟩ := Induction.exists_finset_doubleCoset_cover (refinedParabolic F.Carrier B S) K
  classical
  refine ⟨t.image fun i => refinedJacquetMk B S ρ (ρ i v₀), ?_⟩
  intro U hU
  have hmem : ∀ g : B.Levi F.Carrier, refinedJacquetMk B S ρ (ρ g v₀) ∈ U := by
    intro g
    obtain ⟨i, hi, q, hq, k, hk, rfl⟩ := ht g
    have hk' : ρ k v₀ = v₀ := hK ⟨k, hk⟩
    rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, hk']
    exact refinedJacquetMk_parabolic_mem T B S U ⟨q, hq⟩ (hU _ (Finset.mem_image_of_mem _ hi))
  have hle : Submodule.span ℂ (Set.range fun g => ρ g v₀) ≤
      U.toSubmodule.comap (refinedJacquetMk B S ρ) := by
    rw [Submodule.span_le]
    rintro _ ⟨g, rfl⟩
    exact hmem g
  apply SetLike.ext
  intro x
  refine ⟨fun _ => Submodule.mem_top, fun _ => ?_⟩
  obtain ⟨v, rfl⟩ := Jacquet.mk_surjective ρ _ x
  exact hle (hgen v)

end Generation

end RefinedQuasicuspidalEmbedding

open RefinedQuasicuspidalEmbedding QuasicuspidalEmbedding

/-- Every irreducible smooth representation of a product Levi embeds into the
normalized refined induction of an irreducible quasicuspidal representation of
a flattened Levi. -/
theorem normalizedRefinedQuasicuspidalEmbedding {p : ℕ} [Fact p.Prime]
    (F : PadicField.{uF} p) (T : F.TopologicalData) :
    NormalizedRefinedQuasicuspidalEmbeddingTheorem.{uF, uV} F T := by
  let := T.topology
  intro n B ω hω
  have hωne : Nontrivial ω := nontrivial_of_isIrreducible ω.representation hω
  obtain ⟨S, hJne, hJq⟩ := minimalNonzeroRefinedJacquet F T n B ω hωne
  let ρ := ω.representation
  let τ := flattenedJacquet T B S ρ
  have hτ : IsSmooth τ := by
    let := T.valuativeRel
    let := T.localField
    exact isSmooth_comp _ (flattenedLeviEquivContinuous F.Carrier B S).continuous
      (T.isSmooth_normalizedRefinedJacquet B S ω.isSmooth)
  let J := SmoothRep.of τ hτ
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : ω)
  obtain ⟨s, hs⟩ := exists_finset_generating T B S ω.isSmooth v₀ (mem_span_orbit ρ hω hv₀)
  have : Nontrivial J := hJne
  obtain ⟨U, hU⟩ := exists_isCoatom_subrepresentation J.representation s hs
  let σ := SmoothRep.quotient J U
  let q : J.representation.IntertwiningMap σ.representation := SmoothRep.hom (SmoothRep.mkQ J U)
  have hq : Function.Surjective q := SmoothRep.mkQ_surjective J U
  have hqker : ∀ x, q x = 0 ↔ x ∈ U := fun x => Submodule.Quotient.mk_eq_zero _
  have hσ : σ.IsIrreducible := isIrreducible_of_isCoatom q hq U hU hqker
  have hτq : IsLeviQuasicuspidal (B.flatten S) τ := by
    change IsLeviQuasicuspidal (B.flatten S)
      ((T.normalizedRefinedJacquet B S ρ).comp (flattenedLeviEquiv F.Carrier B S).toMonoidHom)
    rw [flattenedLeviEquiv_eq_leviRefinementEquiv]
    exact hJq
  have hσq : IsLeviQuasicuspidal (B.flatten S) σ.representation := fun R hR =>
    coinvariants_subsingleton_of_surjective q hq _ (hτq R hR)
  let A : (T.normalizedRefinedJacquet B S ρ).IntertwiningMap
      (σ.representation.comp (flattenedLeviEquiv F.Carrier B S).symm.toMonoidHom) :=
    { toLinearMap := q.toLinearMap
      isIntertwining' := fun m => LinearMap.ext fun x => by
        change q (T.normalizedRefinedJacquet B S ρ m x) =
          σ.representation ((flattenedLeviEquiv F.Carrier B S).symm m) (q x)
        rw [← flattenedJacquet_symm T B S ρ m x]
        exact Representation.IntertwiningMap.isIntertwining _ _ q _ x }
  let := T.leviTopologicalGroup B
  let j := Parabolic.FirstAdjointness.refinedFrobenius T B S ω.isSmooth A
  refine ⟨S, σ, hσ, hσq, j, ?_⟩
  have : Representation.IsIrreducible ω.representation := hω
  rcases Representation.IsIrreducible.injective_or_eq_zero j with h | h
  · exact h
  · exfalso
    obtain ⟨x, hx⟩ : ∃ x, x ∉ U := by
      by_contra hall
      push Not at hall
      apply hU.1
      apply SetLike.ext
      intro x
      exact ⟨fun _ => Submodule.mem_top, fun _ => hall x⟩
    obtain ⟨v, rfl⟩ := Jacquet.mk_surjective ρ _ x
    have h1 := Parabolic.FirstAdjointness.refinedFrobenius_eval T B S ω.isSmooth A v 1
    rw [map_one, Module.End.one_apply] at h1
    change Induction.eval _ _ (j v) 1 = _ at h1
    rw [h] at h1
    have h0 : q (refinedJacquetMk B S ρ v) = 0 := h1.symm.trans rfl
    exact hx ((hqker _).mp h0)

/-- The specialization to the saturated carrier universe. -/
example {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p) (T : F.TopologicalData) :
    NormalizedRefinedQuasicuspidalEmbeddingTheorem.{uF, max uF uV} F T :=
  normalizedRefinedQuasicuspidalEmbedding.{uF, max uF uV} F T

end Langlands.CuspidalSupport
