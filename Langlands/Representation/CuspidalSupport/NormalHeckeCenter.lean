import Langlands.Representation.CuspidalSupport.NormalHeckeModule

/-!
# The center of `End(ind_H^G ρ)`

Let `H` be an open normal subgroup of `G`, `ρ` an irreducible smooth representation of `H` of
countable dimension, and `p : G → ι` a degree for `H`. Let `B` be a smooth representation of
`G` such that `M = Hom(ind_H^G ρ, B)` is nonzero, finite-dimensional, and generated by each of
its nonzero elements under `End(ind_H^G ρ)`. Assume moreover that every equivariant bijection
`Hom(ind ρ, B ⊗ ω) ≃ Hom(ind ρ, B)`, for `ω` trivial on `H`, comes from an isomorphism
`B ⊗ ω ≅ B`.

Let `T` be the group of `g` with `ω(g) = 1` for every character `ω` with open kernel containing
`H` and `B ⊗ ω ≅ B`. Then:

* `mem_center_iff_endValue`: an endomorphism `α` is central if and only if `α(f_w)(g) = 0` for
  every `g ∉ T`;
* `exists_basis_center`: `End(ind ρ)` is free over its center of rank `(dim M)²`;
* `isNoetherianRing_end`: `End(ind ρ)` is left and right noetherian when `ι` is a finitely
  generated abelian group;
* `exists_algEquiv_center_quotient`: the center is the group algebra of `T / (H ∩ T)`, the
  class of `t` going to an element supported on `H t⁻¹` acting on `Hom(ind ρ, B ⊗ ω)` by `ω(t)`.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory

namespace Langlands.CuspidalSupport.NormalHecke

universe uG uV

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
variable {H : Subgroup G} (ρ : SmoothRep.{0, uG, uV} ℂ H) (hH : IsOpen (H : Set G))
variable {ι : Type*} [AddCommGroup ι] {p : G → ι} (hp : IsDegree H p)

section Character

/-- The character `g ↦ χ(p g)` of `G`, for an additive character `χ` of `ι` with values in
`ℂˣ`. -/
def degreeCharacter (χ : ι →+ Additive ℂˣ) : G →* ℂˣ where
  toFun g := Additive.toMul (χ (p g))
  map_one' := by rw [hp.map_one, map_zero, toMul_zero]
  map_mul' x y := by rw [hp.map_mul, map_add, toMul_add]

omit [TopologicalSpace G] [IsTopologicalGroup G] in
theorem degreeCharacter_apply (χ : ι →+ Additive ℂˣ) (g : G) :
    degreeCharacter hp χ g = Additive.toMul (χ (p g)) :=
  rfl

omit [TopologicalSpace G] [IsTopologicalGroup G] in
theorem le_ker_degreeCharacter (χ : ι →+ Additive ℂˣ) : H ≤ (degreeCharacter hp χ).ker :=
  fun h hh => by
    rw [MonoidHom.mem_ker, degreeCharacter_apply, hp.map_mem hh, map_zero, toMul_zero]

include hH in
theorem isOpen_ker_degreeCharacter (χ : ι →+ Additive ℂˣ) :
    IsOpen ((degreeCharacter hp χ).ker : Set G) :=
  Subgroup.isOpen_mono (le_ker_degreeCharacter hp χ) hH

end Character

omit [AddCommGroup ι] in
/-- A nonzero element of the piece of degree `a` forces `a` to be a value of `p`. -/
theorem exists_degree_eq {a : ι} {α : End (inducedRep H ρ)}
    (hα : α ∈ component H ρ hH p a) (h0 : α ≠ 0) : ∃ g, p g = a := by
  by_contra hc
  push Not at hc
  exact h0 (eq_zero_of_mem_component ρ hH hα hc)

variable [DecidableEq ι] [hN : H.Normal] [ρ.representation.IsIrreducible]
variable (hrank : Module.rank ℂ ρ ≤ Cardinal.aleph0)
variable (B : SmoothRep.{0, uG, max uG uV} ℂ G)
variable [FiniteDimensional ℂ (inducedRep H ρ ⟶ B)] [Nontrivial (inducedRep H ρ ⟶ B)]
variable (hcyc : ∀ φ : inducedRep H ρ ⟶ B, φ ≠ 0 → ∀ ψ : inducedRep H ρ ⟶ B,
  ∃ α : End (inducedRep H ρ), α ≫ φ = ψ)

include hH hp hrank hcyc

section Radical

variable (hiso : ∀ (ω : G →* ℂˣ) (hω : IsOpen (ω.ker : Set G)), H ≤ ω.ker →
  ∀ Ψ : (inducedRep H ρ ⟶ B.twist ω hω) ≃ₗ[ℂ] (inducedRep H ρ ⟶ B),
    (∀ (α : End (inducedRep H ρ)) φ, Ψ (α ≫ φ) = α ≫ Ψ φ) → Nonempty (B.twist ω hω ≅ B))

include hiso

/-- **The radical is the twist group.** The degree of `g` lies in the radical of the grading
if and only if `ω(g) = 1` for every character `ω` trivial on `H` with `B ⊗ ω ≅ B`. -/
theorem mem_radical_iff (g : G) :
    letI := gradedAlgebra ρ hH hp
    haveI := nontrivial_end H ρ hH
    p g ∈ (isRankOneGrading ρ hH hp hrank).radical ↔
      ∀ (ω : G →* ℂˣ) (hω : IsOpen (ω.ker : Set G)), H ≤ ω.ker →
        Nonempty (B.twist ω hω ≅ B) → ω g = 1 := by
  let _ := gradedAlgebra ρ hH hp
  have := nontrivial_end H ρ hH
  have h𝒜 := isRankOneGrading ρ hH hp hrank
  have hsurj := surjective_homAction H ρ B hcyc
  constructor
  · rintro hg ω hω hωH ⟨e⟩
    obtain ⟨u, hu, hu1⟩ := h𝒜.exists_mem_map_eq_one (homAction_one H ρ B)
      (isMulOrAntiMul_homAction H ρ B) hsurj hg
    let Ψ := Linear.homCongr ℂ (Iso.refl (inducedRep H ρ)) e
    have hΨ : ∀ (α : End (inducedRep H ρ)) φ, Ψ (α ≫ φ) = α ≫ Ψ φ := fun α φ => by
      simp only [Ψ, Linear.homCongr_apply, Iso.refl_inv, Category.id_comp, Category.assoc]
    exact eq_one_of_homEquiv ρ hH ω hω hωH B hp Ψ hΨ hu fun φ => LinearMap.congr_fun hu1 φ
  · intro h
    by_contra hg
    by_cases hs : p g ∈ h𝒜.support
    · obtain ⟨w, hw, hw0⟩ := h𝒜.mem_support_iff.mp hs
      obtain ⟨j, v, hv, hv0, c, hc1, hc⟩ := h𝒜.exists_mul_eq_smul_mul hw hw0 hg
      obtain ⟨β, hβ⟩ := h𝒜.exists_commutation_hom hv hv0
      obtain ⟨χ, hχ⟩ := exists_addMonoidHom_extend h𝒜.support β
      have hβg : ((Additive.toMul (β ⟨p g, hs⟩) : ℂˣ) : ℂ) = c := by
        have h1 := hβ ⟨p g, hs⟩ w hw
        rw [hc] at h1
        exact (smul_left_injective ℂ (h𝒜.mul_ne_zero hv hv0 hw0) h1).symm
      obtain ⟨V, rfl⟩ := h𝒜.isUnit_of_mem _ v hv hv0
      have hconj : ∀ (g' : G) (α : End (inducedRep H ρ)), α ∈ component H ρ hH p (p g') →
          α * V = (degreeCharacter hp χ g' : ℂ) • ((V : End (inducedRep H ρ)) * α) := by
        intro g' α hα
        by_cases hs' : p g' ∈ h𝒜.support
        · rw [hβ ⟨p g', hs'⟩ α hα, degreeCharacter_apply, hχ ⟨p g', hs'⟩]
        · have hα0 : α = 0 := by
            by_contra h0
            exact hs' (h𝒜.mem_support_iff.mpr ⟨α, hα, h0⟩)
          rw [hα0, zero_mul, mul_zero, smul_zero]
      have hω := isOpen_ker_degreeCharacter hH hp χ
      have hωH := le_ker_degreeCharacter hp χ
      have h1 := h _ hω hωH (hiso _ hω hωH (twistModuleEquiv ρ hH _ hω hωH B V)
        (twistModuleEquiv_comp ρ hH _ hω hωH B hp V hconj))
      apply hc1
      rw [← hβg, ← hχ ⟨p g, hs⟩, ← degreeCharacter_apply hp χ g, h1, Units.val_one]
    · obtain ⟨χ, hχ0, hχg⟩ := exists_addMonoidHom_ne_zero h𝒜.support hs
      have hconj : ∀ (g' : G) (α : End (inducedRep H ρ)), α ∈ component H ρ hH p (p g') →
          α * ((1 : (End (inducedRep H ρ))ˣ) : End (inducedRep H ρ)) =
            (degreeCharacter hp χ g' : ℂ) •
              (((1 : (End (inducedRep H ρ))ˣ) : End (inducedRep H ρ)) * α) := by
        intro g' α hα
        by_cases hs' : p g' ∈ h𝒜.support
        · rw [degreeCharacter_apply, hχ0 _ hs', toMul_zero]
          simp only [Units.val_one, one_smul, mul_one, one_mul]
        · have hα0 : α = 0 := by
            by_contra h0
            exact hs' (h𝒜.mem_support_iff.mpr ⟨α, hα, h0⟩)
          rw [hα0, zero_mul, mul_zero, smul_zero]
      have hω := isOpen_ker_degreeCharacter hH hp χ
      have hωH := le_ker_degreeCharacter hp χ
      have h1 := h _ hω hωH (hiso _ hω hωH (twistModuleEquiv ρ hH _ hω hωH B 1)
        (twistModuleEquiv_comp ρ hH _ hω hωH B hp 1 hconj))
      rw [degreeCharacter_apply, toMul_eq_one] at h1
      exact hχg h1

variable {T : Subgroup G} (hT : ∀ g, g ∈ T ↔ ∀ (ω : G →* ℂˣ) (hω : IsOpen (ω.ker : Set G)),
  H ≤ ω.ker → Nonempty (B.twist ω hω ≅ B) → ω g = 1)

include hT

/-- **The center.** An endomorphism of `ind_H^G ρ` is central if and only if its values
`α(f_w)(g)` vanish for `g ∉ T`. -/
theorem mem_center_iff_endValue (α : End (inducedRep H ρ)) :
    α ∈ Subalgebra.center ℂ (End (inducedRep H ρ)) ↔
      ∀ g, g ∉ T → endValue H ρ hH α g = 0 := by
  let _ := gradedAlgebra ρ hH hp
  have := nontrivial_end H ρ hH
  have h𝒜 := isRankOneGrading ρ hH hp hrank
  have hT' : ∀ g, g ∈ T ↔ p g ∈ h𝒜.radical := fun g =>
    (hT g).trans (mem_radical_iff ρ hH hp hrank B hcyc hiso g).symm
  rw [h𝒜.mem_center_iff]
  constructor
  · intro h g hg
    have h1 := endValue_decompose hH hp α (p g) g
    rw [ite_eq_left rfl, h (p g) fun hm => hg ((hT' g).mpr hm), endValue_zero] at h1
    exact h1.symm
  · intro h i hi
    refine end_ext H ρ hH fun g w => ?_
    rw [endValue_decompose hH hp α i g, endValue_zero]
    split_ifs with hgi
    · subst hgi
      rw [h g fun hm => hi ((hT' g).mp hm)]
    · rfl

/-- **The center is a group algebra.** The center of `End(ind_H^G ρ)` is the group algebra of
`T / (H ∩ T)`; the image `ψ_t` of the class of `t` has every `ψ_t(f_w)` supported on `H t⁻¹`,
and `ψ_t ≫ φ = ω(t) φ` for every character `ω` trivial on `H` and every
`φ : ind ρ → B ⊗ ω`. -/
theorem exists_algEquiv_center_quotient :
    ∃ e : MonoidAlgebra ℂ (T ⧸ H.subgroupOf T) ≃ₐ[ℂ]
        Subalgebra.center ℂ (End (inducedRep H ρ)),
      ∀ t : T,
        (∀ g, g * (t : G) ∉ H →
          endValue H ρ hH (e (MonoidAlgebra.of ℂ _ (QuotientGroup.mk t))) g = 0) ∧
        ∀ (ω : G →* ℂˣ) (hω : IsOpen (ω.ker : Set G)), H ≤ ω.ker →
          ∀ φ : inducedRep H ρ ⟶ B.twist ω hω,
            (e (MonoidAlgebra.of ℂ _ (QuotientGroup.mk t)) : End (inducedRep H ρ)) ≫ φ =
              (ω t : ℂ) • φ := by
  let _ := gradedAlgebra ρ hH hp
  have := nontrivial_end H ρ hH
  have h𝒜 := isRankOneGrading ρ hH hp hrank
  have hT' : ∀ g, g ∈ T ↔ p g ∈ h𝒜.radical := fun g =>
    (hT g).trans (mem_radical_iff ρ hH hp hrank B hcyc hiso g).symm
  obtain ⟨e₀, he₀⟩ := h𝒜.exists_algEquiv_center (homAction_one H ρ B)
    (isMulOrAntiMul_homAction H ρ B) (surjective_homAction H ρ B hcyc)
  let f : T →* Multiplicative h𝒜.radical :=
    { toFun := fun t => Multiplicative.ofAdd ⟨-p t, h𝒜.radical.neg_mem ((hT' t).mp t.2)⟩
      map_one' := by
        apply Multiplicative.toAdd.injective
        apply Subtype.ext
        change -p 1 = 0
        rw [hp.map_one, neg_zero]
      map_mul' := fun s t => by
        apply Multiplicative.toAdd.injective
        apply Subtype.ext
        change -p (s * t : G) = -p s + -p t
        rw [hp.map_mul, neg_add] }
  have hf : Function.Surjective f := by
    intro a
    have ha : -(a.toAdd : ι) ∈ h𝒜.radical := h𝒜.radical.neg_mem a.toAdd.2
    obtain ⟨α, hα, hα0⟩ := h𝒜.mem_support_iff.mp (h𝒜.radical_le_support ha)
    obtain ⟨g, hg⟩ := exists_degree_eq ρ hH hα hα0
    refine ⟨⟨g, (hT' g).mpr (hg ▸ ha)⟩, ?_⟩
    apply Multiplicative.toAdd.injective
    apply Subtype.ext
    change -p g = (a.toAdd : ι)
    rw [hg, neg_neg]
  have hker : H.subgroupOf T = f.ker := by
    ext t
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, ← hp.eq_zero_iff]
    constructor
    · intro h
      apply Multiplicative.toAdd.injective
      apply Subtype.ext
      change -p t = 0
      rw [h, neg_zero]
    · intro h
      have h1 := congrArg (fun x : Multiplicative h𝒜.radical => ((x.toAdd : h𝒜.radical) : ι)) h
      exact neg_eq_zero.mp h1
  let φ₀ : T ⧸ H.subgroupOf T ≃* Multiplicative h𝒜.radical :=
    (QuotientGroup.quotientMulEquivOfEq hker).trans (QuotientGroup.quotientKerEquivOfSurjective f hf)
  have hφ₀ : ∀ t : T, φ₀ (QuotientGroup.mk t) = f t := fun t => rfl
  refine ⟨(MonoidAlgebra.domCongr ℂ ℂ φ₀).trans e₀, fun t => ?_⟩
  have hψ : (MonoidAlgebra.domCongr ℂ ℂ φ₀).trans e₀ (MonoidAlgebra.of ℂ _ (QuotientGroup.mk t)) =
      e₀ (MonoidAlgebra.of ℂ _ (f t)) := by
    rw [AlgEquiv.trans_apply, MonoidAlgebra.of_apply, MonoidAlgebra.domCongr_single, hφ₀]
    rfl
  rw [hψ]
  obtain ⟨hmem, h1⟩ := he₀ (f t)
  have hmem' : (e₀ (MonoidAlgebra.of ℂ _ (f t)) : End (inducedRep H ρ)) ∈
      component H ρ hH p (-p t) := hmem
  refine ⟨fun g hg => hmem' g fun hpg => hg ?_, fun ω hω hωH φ => ?_⟩
  · rw [← hp.eq_zero_iff, hp.map_mul, hpg, neg_add_cancel]
  · have hmem'' : (e₀ (MonoidAlgebra.of ℂ _ (f t)) : End (inducedRep H ρ)) ∈
        component H ρ hH p (p (t : G)⁻¹) := by
      rw [hp.map_inv]
      exact hmem'
    have h2 := twistHomEquiv_comp hH hωH hp hmem'' rfl φ
    apply (twistHomEquiv ρ hH ω hω hωH B).injective
    rw [h2, ← homAction_apply, LinearMap.congr_fun h1 (twistHomEquiv ρ hH ω hω hωH B φ),
      map_smul, map_inv, Units.val_inv_eq_inv_val, inv_inv]
    rfl

end Radical

/-- **Freeness over the center.** `End(ind_H^G ρ)` is free over its center, of rank
`(dim Hom(ind ρ, B))²`. -/
theorem exists_basis_center :
    Nonempty (Module.Basis (Fin (Module.finrank ℂ (inducedRep H ρ ⟶ B) ^ 2))
      (Subalgebra.center ℂ (End (inducedRep H ρ))) (End (inducedRep H ρ))) := by
  let _ := gradedAlgebra ρ hH hp
  have := nontrivial_end H ρ hH
  have h𝒜 := isRankOneGrading ρ hH hp hrank
  obtain ⟨hfin, hcard⟩ := h𝒜.finite_cosets_and_card_eq (homAction_one H ρ B)
    (isMulOrAntiMul_homAction H ρ B) (surjective_homAction H ρ B hcyc)
  exact ⟨h𝒜.basis.reindex ((Finite.equivFin _).trans (finCongr hcard))⟩

/-- **Noetherianity.** If `ι` is a finitely generated abelian group, `End(ind_H^G ρ)` is left
and right noetherian. -/
theorem isNoetherianRing_end [Module.Finite ℤ ι] :
    IsNoetherianRing (End (inducedRep H ρ)) ∧ IsNoetherianRing (End (inducedRep H ρ))ᵐᵒᵖ := by
  let _ := gradedAlgebra ρ hH hp
  have := nontrivial_end H ρ hH
  have h𝒜 := isRankOneGrading ρ hH hp hrank
  obtain ⟨hfin, -⟩ := h𝒜.finite_cosets_and_card_eq (homAction_one H ρ B)
    (isMulOrAntiMul_homAction H ρ B) (surjective_homAction H ρ B hcyc)
  obtain ⟨e, -⟩ := h𝒜.exists_algEquiv_center (homAction_one H ρ B)
    (isMulOrAntiMul_homAction H ρ B) (surjective_homAction H ρ B hcyc)
  have : IsNoetherian ℤ ι := isNoetherian_of_isNoetherianRing_of_finite ℤ ι
  have : Module.Finite ℤ h𝒜.radical :=
    Module.Finite.of_injective h𝒜.radical.subtype.toIntLinearMap Subtype.val_injective
  have : AddGroup.FG h𝒜.radical := Module.Finite.iff_addGroup_fg.mp inferInstance
  have : IsNoetherianRing (Subalgebra.center ℂ (End (inducedRep H ρ))) :=
    RankOneGraded.isNoetherianRing_of_algEquiv_monoidAlgebra e
  exact h𝒜.isNoetherianRing_of_finite

end Langlands.CuspidalSupport.NormalHecke
