import Langlands.Group.GL.CartanProof
import Langlands.Group.GL.DominantExponentGeneration
import Langlands.Group.GL.PrincipalLevelDominance
import Langlands.LocalField.Normalization.Proof
import Langlands.LocalField.Topology
import Langlands.Representation.CuspidalSupport.DeterminantUnitCornerStructureStatement
import Langlands.Representation.Hecke.DoubleCosetSandwich

/-!
# Proof of the sandwich structure of compact-open Hecke corners of `G°`

Bernstein--Zelevinsky (1976), Lemma 4.9, page 39, for the determinant-unit subgroup `G°`
of a product Levi. The level is the blockwise principal congruence subgroup `N` of a large
positive level inside `K`. Block-integral elements normalize `N`; dominant block-torus
elements satisfy `m₁ N m₂ ⊆ N m₁ m₂ N`; and the blockwise Cartan decomposition writes every
element of `G°` as `γ m γ'` with `γ, γ'` block-integral and `m` in the monoid generated by
finitely many dominant zero-sum block-torus elements. The generic Hecke sandwich theorem
then gives the corner structure.
-/

noncomputable section

namespace Langlands.GeneralLinear

open Matrix Topology MeasureTheory

universe u

/-! ### Determinants of integral and torus elements -/

section Determinant

variable {k : Type u} [Field k] [ValuativeRel k]

private theorem prod_zpow_eq_zpow_sum' {ι H : Type*} [CommGroup H] (s : Finset ι) (f : ι → ℤ)
    (a : H) : ∏ i ∈ s, a ^ f i = a ^ ∑ i ∈ s, f i := by
  induction s using Finset.cons_induction with
  | empty => simp
  | cons j s hj ih => rw [Finset.prod_cons, Finset.sum_cons, ih, zpow_add]

omit [ValuativeRel k] in
/-- The determinant of `diag(ϖ ^ lam i)` is `ϖ ^ ∑ lam i`. -/
theorem determinant_torus {m : ℕ} (ϖ : kˣ) (lam : Fin m → ℤ) :
    determinant (Iwasawa.torus ϖ lam) = ϖ ^ ∑ i, lam i := by
  apply Units.ext
  rw [Matrix.GeneralLinearGroup.val_det_apply, Iwasawa.torus_val, Matrix.det_diagonal,
    ← Units.coe_prod, prod_zpow_eq_zpow_sum']

/-- Integral invertible matrices have determinant of valuation one. -/
theorem valuation_determinant_of_mem_integralRange {m : ℕ} {γ : GeneralLinear m k}
    (hγ : γ ∈ Iwasawa.integralRange (ValuativeRel.valuation k) m) :
    ValuativeRel.valuation k (determinant γ : k) = 1 := by
  obtain ⟨γ₀, rfl⟩ := MonoidHom.mem_range.mp hγ
  rw [Matrix.GeneralLinearGroup.map_det]
  exact (Valuation.integer.integers (ValuativeRel.valuation k)).one_of_isUnit
    (Matrix.GeneralLinearGroup.det γ₀).isUnit

/-- A torus element whose determinant has valuation one has zero exponent sum. -/
theorem sum_eq_zero_of_valuation_determinant_torus {m : ℕ} {ϖ : kˣ}
    (hϖ : ValuativeRel.valuation k (ϖ : k) < 1) {lam : Fin m → ℤ}
    (h : ValuativeRel.valuation k (determinant (Iwasawa.torus ϖ lam) : k) = 1) :
    ∑ i, lam i = 0 := by
  rw [determinant_torus, Units.val_zpow_eq_zpow_val, map_zpow₀] at h
  exact (zpow_eq_one_iff_right₀ zero_le hϖ.ne).mp h

/-- A torus element with zero exponent sum has determinant of valuation one. -/
theorem valuation_determinant_torus_of_sum_eq_zero {m : ℕ} (ϖ : kˣ) {lam : Fin m → ℤ}
    (h : ∑ i, lam i = 0) :
    ValuativeRel.valuation k (determinant (Iwasawa.torus ϖ lam) : k) = 1 := by
  rw [determinant_torus, h, zpow_zero, Units.val_one, map_one]

end Determinant

/-! ### Blockwise subgroups, dominant monoid and generators -/

section Levi

variable (k : Type u) [Field k] [ValuativeRel k] {n : ℕ} (B : BlockShape n)

/-- Block-integral elements of the Levi. -/
def integralLevi : Subgroup (B.Levi k) :=
  Subgroup.pi Set.univ fun i => Iwasawa.integralRange (ValuativeRel.valuation k) (B.size i)

/-- The blockwise principal congruence subgroup of level `a`. -/
def principalLevi (a : ℕ) : Subgroup (B.Levi k) :=
  Subgroup.pi Set.univ fun i => rankPrincipalLevel k (B.size i) a

theorem principalLevi_le_integralLevi (a : ℕ) : principalLevi k B a ≤ integralLevi k B :=
  fun _ hg => (Subgroup.mem_pi _).2 fun i _ =>
    rankPrincipalLevel_le_integralRange k _ a ((Subgroup.mem_pi _).1 hg i (Set.mem_univ i))

/-- Blocks paired with a dominant zero-sum generator tuple of that block. -/
abbrev GeneratorIndex := Σ i : Fin B.length, dominantGenerators (B.size i)

instance : Finite (GeneratorIndex B) := by
  have : ∀ i : Fin B.length, Finite (dominantGenerators (B.size i)) :=
    fun i => (dominantGenerators_finite (B.size i)).to_subtype
  infer_instance

variable {k B}

/-- The Levi element with the generator torus element in one block and identity elsewhere. -/
def leviGenerator (ϖ : kˣ) (j : GeneratorIndex B) : B.Levi k :=
  Pi.mulSingle j.1 (Iwasawa.torus ϖ j.2.1)

omit [ValuativeRel k] in
/-- Every block of a generator is a dominant zero-sum torus element. -/
theorem leviGenerator_apply (ϖ : kˣ) (j : GeneratorIndex B) (i : Fin B.length) :
    ∃ lam ∈ zeroSumDominant (B.size i), leviGenerator ϖ j i = Iwasawa.torus ϖ lam := by
  obtain ⟨i₀, s, hs⟩ := j
  by_cases h : i = i₀
  · subst h
    exact ⟨s, dominantGenerators_subset _ hs, Pi.mulSingle_eq_same _ _⟩
  · refine ⟨0, ⟨fun _ _ _ => le_rfl, by simp⟩, ?_⟩
    rw [leviGenerator, Pi.mulSingle_eq_of_ne h, torus_zero]

omit [ValuativeRel k] in
/-- A single dominant zero-sum block torus element lies in the generated monoid. -/
theorem mulSingle_torus_mem_closure (ϖ : kˣ) (i : Fin B.length) {lam : Fin (B.size i) → ℤ}
    (hlam : lam ∈ zeroSumDominant (B.size i)) :
    (Pi.mulSingle i (Iwasawa.torus ϖ lam) : B.Levi k) ∈
      Submonoid.closure (Set.range (leviGenerator (B := B) ϖ)) := by
  have h := mem_closure_dominantGenerators hlam
  clear hlam
  induction h using AddSubmonoid.closure_induction with
  | mem mu hmu => exact Submonoid.subset_closure ⟨⟨i, mu, hmu⟩, rfl⟩
  | zero =>
    rw [torus_zero, Pi.mulSingle_one]
    exact one_mem _
  | add mu nu _ _ ih₁ ih₂ =>
    rw [torus_add, Pi.mulSingle_mul]
    exact mul_mem ih₁ ih₂

omit [ValuativeRel k] in
/-- A family of dominant zero-sum block torus elements lies in the generated monoid. -/
theorem torusFamily_mem_closure (ϖ : kˣ) {lam : ∀ i, Fin (B.size i) → ℤ}
    (hlam : ∀ i, lam i ∈ zeroSumDominant (B.size i)) :
    (fun i => Iwasawa.torus ϖ (lam i) : B.Levi k) ∈
      Submonoid.closure (Set.range (leviGenerator (B := B) ϖ)) := by
  classical
  have key : ∀ s : Finset (Fin B.length),
      (fun i => if i ∈ s then Iwasawa.torus ϖ (lam i) else 1 : B.Levi k) ∈
        Submonoid.closure (Set.range (leviGenerator (B := B) ϖ)) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      have h1 : (fun i => if i ∈ (∅ : Finset (Fin B.length)) then Iwasawa.torus ϖ (lam i)
          else 1 : B.Levi k) = 1 := by
        funext i
        simp
      rw [h1]
      exact one_mem _
    | insert j s hj ih =>
      have hins : (fun i => if i ∈ insert j s then Iwasawa.torus ϖ (lam i) else 1 : B.Levi k) =
          Pi.mulSingle j (Iwasawa.torus ϖ (lam j)) *
            (fun i => if i ∈ s then Iwasawa.torus ϖ (lam i) else 1 : B.Levi k) := by
        funext i
        rw [Pi.mul_apply]
        by_cases hij : i = j
        · subst hij
          simp [hj]
        · simp [hij]
      rw [hins]
      exact mul_mem (mulSingle_torus_mem_closure ϖ j (hlam j)) ih
  simpa using key Finset.univ

variable (G : Subgroup (B.Levi k))
  (hG : ∀ g : B.Levi k, g ∈ G ↔ ∀ i, ValuativeRel.valuation k (determinant (g i) : k) = 1)

include hG in
/-- Block-integral elements have determinants of valuation one. -/
theorem integralLevi_le : integralLevi k B ≤ G := fun g hg =>
  (hG g).2 fun i =>
    valuation_determinant_of_mem_integralRange ((Subgroup.mem_pi _).1 hg i (Set.mem_univ i))

include hG in
theorem leviGenerator_mem (ϖ : kˣ) (j : GeneratorIndex B) : leviGenerator ϖ j ∈ G :=
  (hG _).2 fun i => by
    obtain ⟨lam, hlam, e⟩ := leviGenerator_apply ϖ j i
    rw [e]
    exact valuation_determinant_torus_of_sum_eq_zero ϖ hlam.2

/-- The elements of `G` all of whose blocks are dominant torus elements. -/
def dominantMonoid (ϖ : kˣ) : Submonoid G where
  carrier := {g | ∀ i, ∃ lam : Fin (B.size i) → ℤ, Antitone lam ∧
    (g : B.Levi k) i = Iwasawa.torus ϖ lam}
  mul_mem' {g h} hg hh i := by
    obtain ⟨lam, hlam, hgi⟩ := hg i
    obtain ⟨mu, hmu, hhi⟩ := hh i
    refine ⟨lam + mu, hlam.add hmu, ?_⟩
    rw [Subgroup.coe_mul, Pi.mul_apply, hgi, hhi, torus_add]
  one_mem' i := ⟨0, fun _ _ _ => le_rfl, by rw [OneMemClass.coe_one, Pi.one_apply, torus_zero]⟩

omit [ValuativeRel k] in
theorem mem_dominantMonoid (ϖ : kˣ) (g : G) :
    g ∈ dominantMonoid G ϖ ↔
      ∀ i, ∃ lam : Fin (B.size i) → ℤ, Antitone lam ∧ (g : B.Levi k) i = Iwasawa.torus ϖ lam :=
  Iff.rfl

omit [ValuativeRel k] in
/-- Dominant block-torus elements commute. -/
theorem dominantMonoid_commute (ϖ : kˣ) {g h : G} (hg : g ∈ dominantMonoid G ϖ)
    (hh : h ∈ dominantMonoid G ϖ) : Commute g h := by
  change g * h = h * g
  apply Subtype.ext
  funext i
  obtain ⟨lam, -, hgi⟩ := (mem_dominantMonoid G ϖ g).1 hg i
  obtain ⟨mu, -, hhi⟩ := (mem_dominantMonoid G ϖ h).1 hh i
  change (g : B.Levi k) i * (h : B.Levi k) i = (h : B.Levi k) i * (g : B.Levi k) i
  rw [hgi, hhi]
  exact torus_commute ϖ lam mu

include hG in
/-- **Dominant sandwich in `G`.** For a positive level, `m₁ x m₂ ∈ N (m₁ m₂) N` for dominant
`m₁, m₂` and `x` in the blockwise principal level `N`. -/
theorem dominantMonoid_sandwich {a : ℕ} (ha : 0 < a) {ϖ : kˣ}
    (hϖ : ValuativeRel.valuation k (ϖ : k) ≤ 1) {m₁ m₂ : G}
    (h₁ : m₁ ∈ dominantMonoid G ϖ) (h₂ : m₂ ∈ dominantMonoid G ϖ) {x : G}
    (hx : x ∈ (principalLevi k B a).subgroupOf G) :
    ∃ y ∈ (principalLevi k B a).subgroupOf G, ∃ z ∈ (principalLevi k B a).subgroupOf G,
      m₁ * x * m₂ = y * (m₁ * m₂) * z := by
  have hx' := Subgroup.mem_subgroupOf.mp hx
  have key : ∀ i, ∃ y ∈ rankPrincipalLevel k (B.size i) a,
      ∃ z ∈ rankPrincipalLevel k (B.size i) a,
        (m₁ : B.Levi k) i * (x : B.Levi k) i * (m₂ : B.Levi k) i =
          y * ((m₁ : B.Levi k) i * (m₂ : B.Levi k) i) * z := by
    intro i
    obtain ⟨lam₁, hlam₁, e₁⟩ := (mem_dominantMonoid G ϖ m₁).1 h₁ i
    obtain ⟨lam₂, hlam₂, e₂⟩ := (mem_dominantMonoid G ϖ m₂).1 h₂ i
    rw [e₁, e₂]
    exact exists_dominant_sandwich ha hϖ hlam₁ hlam₂
      ((Subgroup.mem_pi _).1 hx' i (Set.mem_univ i))
  choose y hy z hz hyz using key
  have hyP : (y : B.Levi k) ∈ principalLevi k B a := (Subgroup.mem_pi _).2 fun i _ => hy i
  have hzP : (z : B.Levi k) ∈ principalLevi k B a := (Subgroup.mem_pi _).2 fun i _ => hz i
  have hyG := integralLevi_le G hG (principalLevi_le_integralLevi k B a hyP)
  have hzG := integralLevi_le G hG (principalLevi_le_integralLevi k B a hzP)
  refine ⟨⟨y, hyG⟩, Subgroup.mem_subgroupOf.mpr hyP, ⟨z, hzG⟩,
    Subgroup.mem_subgroupOf.mpr hzP, ?_⟩
  apply Subtype.ext
  funext i
  exact hyz i

include hG in
/-- **Blockwise Cartan decomposition in `G`.** Every element of `G` is `γ m γ'` with `γ, γ'`
block-integral and `m` in the monoid generated by the generators. -/
theorem exists_levi_cartan {ϖ : kˣ}
    (hϖ : Iwasawa.IsUniformizingElement (ValuativeRel.valuation k) ϖ) (g : G) :
    ∃ γ ∈ (integralLevi k B).subgroupOf G, ∃ γ' ∈ (integralLevi k B).subgroupOf G,
      ∃ m ∈ Submonoid.closure (Set.range fun j : GeneratorIndex B =>
          (⟨leviGenerator ϖ j, leviGenerator_mem G hG ϖ j⟩ : G)),
        g = γ * m * γ' := by
  have hc : ∀ i, ∃ lam : Fin (B.size i) → ℤ, Antitone lam ∧
      ∃ k₁ ∈ Iwasawa.integralRange (ValuativeRel.valuation k) (B.size i),
        ∃ k₂ ∈ Iwasawa.integralRange (ValuativeRel.valuation k) (B.size i),
          (g : B.Levi k) i = k₁ * Iwasawa.torus ϖ lam * k₂ :=
    fun i => (Cartan.cartanDecomposition k _ (ValuativeRel.valuation k) ϖ hϖ (B.size i)
      ((g : B.Levi k) i)).exists
  choose lam hlam k₁ hk₁ k₂ hk₂ hg using hc
  have hk₁L : (k₁ : B.Levi k) ∈ integralLevi k B := (Subgroup.mem_pi _).2 fun i _ => hk₁ i
  have hk₂L : (k₂ : B.Levi k) ∈ integralLevi k B := (Subgroup.mem_pi _).2 fun i _ => hk₂ i
  let γ : G := ⟨k₁, integralLevi_le G hG hk₁L⟩
  let γ' : G := ⟨k₂, integralLevi_le G hG hk₂L⟩
  let t : G := γ⁻¹ * g * γ'⁻¹
  have ht : ∀ i, (t : B.Levi k) i = Iwasawa.torus ϖ (lam i) := by
    intro i
    change (k₁ i)⁻¹ * (g : B.Levi k) i * (k₂ i)⁻¹ = _
    rw [hg i]
    group
  have hsum : ∀ i, lam i ∈ zeroSumDominant (B.size i) := fun i =>
    ⟨hlam i, sum_eq_zero_of_valuation_determinant_torus hϖ.1
      (by rw [← ht i]; exact (hG _).1 t.2 i)⟩
  have hmem := torusFamily_mem_closure ϖ hsum
  rw [show (fun i => Iwasawa.torus ϖ (lam i) : B.Levi k) = (t : B.Levi k) from
    funext fun i => (ht i).symm] at hmem
  have hrange : Set.range (leviGenerator (B := B) ϖ) =
      G.subtype '' Set.range fun j : GeneratorIndex B =>
        (⟨leviGenerator ϖ j, leviGenerator_mem G hG ϖ j⟩ : G) := by
    rw [← Set.range_comp]
    rfl
  rw [hrange, ← MonoidHom.map_mclosure] at hmem
  obtain ⟨m, hm, hmt⟩ := Submonoid.mem_map.mp hmem
  refine ⟨γ, Subgroup.mem_subgroupOf.mpr hk₁L, γ', Subgroup.mem_subgroupOf.mpr hk₂L, m, hm, ?_⟩
  rw [Subtype.val_injective hmt]
  change g = γ * (γ⁻¹ * g * γ'⁻¹) * γ'
  group

end Levi

/-! ### The corner structure over a nonarchimedean local field -/

section Corner

variable {k : Type u} [Field k] [ValuativeRel k] [TopologicalSpace k]
  [IsNonarchimedeanLocalField k] [T2Space k] {n : ℕ} {B : BlockShape n}
  (G : Subgroup (B.Levi k))
  (hG : ∀ g : B.Levi k, g ∈ G ↔ ∀ i, ValuativeRel.valuation k (determinant (g i) : k) = 1)
  [MeasurableSpace G] [BorelSpace G]

include hG in
/-- **Corner sandwich structure** (Bernstein--Zelevinsky 1976, Lemma 4.9) for a subgroup `G`
of the Levi cut out by valuation-one block determinants. -/
theorem exists_cornerStructure (K : OpenSubgroup G) (_hK : IsCompact (K : Set G)) :
    ∃ (N : OpenSubgroup G) (hN : IsCompact (N : Set G)), N ≤ K ∧
      ∀ (μ : Measure G) [μ.IsHaarMeasure],
        ∃ (q l : ℕ) (x : Fin q → Hecke.HeckeAlgebra.Corner μ N hN)
          (a : Fin l → Hecke.HeckeAlgebra.Corner μ N hN),
          (∀ i j, Commute (a i) (a j)) ∧
          Submodule.span ℂ
            {y | ∃ i j, ∃ m ∈ Algebra.adjoin ℂ (Set.range a), y = x i * m * x j} = ⊤ := by
  classical
  obtain ⟨ϖ, hϖ⟩ := Iwasawa.exists_isUniformizingElement k
  have hind : IsInducing (Subtype.val : G → B.Levi k) := ⟨rfl⟩
  -- an open set of the Levi cutting out `K`, and a blockwise principal level inside it
  obtain ⟨U, hUo, hUK⟩ := isOpen_induced_iff.mp K.isOpen
  have hU1 : U ∈ 𝓝 (1 : B.Levi k) := by
    refine hUo.mem_nhds ?_
    have h1 : (1 : G) ∈ Subtype.val ⁻¹' U := by
      rw [hUK]
      exact K.one_mem
    exact h1
  rw [nhds_pi, Filter.mem_pi] at hU1
  obtain ⟨I, -, t, ht, htU⟩ := hU1
  have hlev : ∀ i, ∃ c : ℕ, 0 < c ∧
      (rankPrincipalLevel k (B.size i) c : Set (GeneralLinear (B.size i) k)) ⊆ t i :=
    fun i => exists_pos_rankPrincipalLevel_subset k (B.size i) (ht i)
  choose c' _ hct using hlev
  set r := Finset.univ.sup c' + 1 with hr
  have hr0 : 0 < r := Nat.succ_pos _
  have hPU : (principalLevi k B r : Set (B.Levi k)) ⊆ U := by
    intro g hg
    apply htU
    intro i _
    apply hct i
    exact rankPrincipalLevel_antitone k (B.size i)
      (Nat.le_succ_of_le (Finset.le_sup (Finset.mem_univ i)))
      ((Subgroup.mem_pi _).1 hg i (Set.mem_univ i))
  have hPG : principalLevi k B r ≤ G :=
    le_trans (principalLevi_le_integralLevi k B r) (integralLevi_le G hG)
  -- the level `N`
  let N : OpenSubgroup G :=
    { toSubgroup := (principalLevi k B r).subgroupOf G
      isOpen' := by
        change IsOpen ((Subtype.val : G → B.Levi k) ⁻¹' (principalLevi k B r : Set (B.Levi k)))
        exact (isOpen_set_pi Set.finite_univ fun i _ =>
          isOpen_rankPrincipalLevel k (B.size i) r).preimage continuous_subtype_val }
  have hNimage : Subtype.val '' (N : Set G) = (principalLevi k B r : Set (B.Levi k)) := by
    ext g
    constructor
    · rintro ⟨h, hh, rfl⟩
      exact Subgroup.mem_subgroupOf.mp hh
    · intro hg
      exact ⟨⟨g, hPG hg⟩, Subgroup.mem_subgroupOf.mpr hg, rfl⟩
  have hN : IsCompact (N : Set G) := by
    rw [hind.isCompact_iff, hNimage]
    exact isCompact_univ_pi fun i => isCompact_rankPrincipalLevel k (B.size i) r
  have hNK : N ≤ K := by
    intro g hg
    have hgU : g ∈ Subtype.val ⁻¹' U := hPU (Subgroup.mem_subgroupOf.mp hg)
    rw [hUK] at hgU
    exact hgU
  -- the compact subgroup `Γ` of block-integral elements normalizes `N`
  let Γ : Subgroup G := (integralLevi k B).subgroupOf G
  have hΓimage : Subtype.val '' (Γ : Set G) = (integralLevi k B : Set (B.Levi k)) := by
    ext g
    constructor
    · rintro ⟨h, hh, rfl⟩
      exact Subgroup.mem_subgroupOf.mp hh
    · intro hg
      exact ⟨⟨g, integralLevi_le G hG hg⟩, Subgroup.mem_subgroupOf.mpr hg, rfl⟩
  have hΓc : IsCompact (Γ : Set G) := by
    rw [hind.isCompact_iff, hΓimage]
    exact isCompact_univ_pi fun i => isCompact_integralRange k (B.size i)
  have hΓ : Γ ≤ Subgroup.normalizer (N.toSubgroup : Set G) := by
    intro γ hγ
    rw [Subgroup.mem_normalizer_iff]
    intro h
    have hγ' := (Subgroup.mem_pi _).1 (Subgroup.mem_subgroupOf.mp hγ)
    change h ∈ (principalLevi k B r).subgroupOf G ↔
      γ * h * γ⁻¹ ∈ (principalLevi k B r).subgroupOf G
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf, principalLevi, Subgroup.mem_pi,
      Subgroup.mem_pi]
    refine forall_congr' fun i => imp_congr_right fun _ => ?_
    exact (conj_mem_rankPrincipalLevel_iff (hγ' i (Set.mem_univ i)) _).symm
  -- the dominant monoid and its finitely many generators
  let M := dominantMonoid G ϖ
  have hM : ∀ m₁ ∈ M, ∀ m₂ ∈ M, ∀ x ∈ N,
      m₁ * x * m₂ ∈ Hecke.TestFunction.doubleCosetSet N (m₁ * m₂) := by
    intro m₁ h₁ m₂ h₂ x hx
    obtain ⟨y, hy, z, hz, e⟩ := dominantMonoid_sandwich G hG hr0 hϖ.1.le h₁ h₂ hx
    exact (Hecke.TestFunction.mem_doubleCosetSet N _ _).2 ⟨y, hy, z, hz, e⟩
  let D₀ : GeneratorIndex B → G := fun j => ⟨leviGenerator ϖ j, leviGenerator_mem G hG ϖ j⟩
  obtain ⟨l, ⟨e⟩⟩ := Finite.exists_equiv_fin (GeneratorIndex B)
  let D : Fin l → G := D₀ ∘ e.symm
  have hrange : Set.range D = Set.range D₀ := e.symm.surjective.range_comp D₀
  have hDM : ∀ j, D j ∈ M := fun j => (mem_dominantMonoid G ϖ _).2 fun i => by
    obtain ⟨lam, hlam, e'⟩ := leviGenerator_apply ϖ (e.symm j) i
    exact ⟨lam, hlam.1, e'⟩
  have hdecomp : ∀ g : G, ∃ γ ∈ Γ, ∃ γ' ∈ Γ, ∃ m ∈ Submonoid.closure (Set.range D),
      g = γ * m * γ' := by
    intro g
    obtain ⟨γ, hγ, γ', hγ', m, hm, hg⟩ := exists_levi_cartan G hG hϖ g
    exact ⟨γ, hγ, γ', hγ', m, by rw [hrange]; exact hm, hg⟩
  refine ⟨N, hN, hNK, fun μ _ => ?_⟩
  obtain ⟨q, x, a, hcomm, hspan⟩ :=
    Hecke.HeckeAlgebra.Corner.exists_sandwich_of_decomposition N hN μ Γ hΓc hΓ M hM D hDM
      (fun i j => dominantMonoid_commute G ϖ (hDM i) (hDM j)) hdecomp
  exact ⟨q, l, x, a, hcomm, hspan⟩

end Corner

end Langlands.GeneralLinear

namespace Langlands.CuspidalSupport

open GeneralLinear

universe uF

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{uF} p}

/-- Normalized absolute value one is valuation one. -/
theorem normalizedAbs_eq_one_iff (T : F.TopologicalData) {x : F.Carrier} (hx : x ≠ 0) :
    letI := T.valuativeRel
    T.normalizedAbs x = 1 ↔ ValuativeRel.valuation F.Carrier x = 1 := by
  let := T.valuativeRel
  have key : ∀ y : F.Carrier,
      T.normalizedAbs y ≤ 1 ↔ ValuativeRel.valuation F.Carrier y ≤ 1 := fun y =>
    (T.normalizedAbs_le_one_iff_mem_integers y).trans
      (Valuation.mem_integer_iff (ValuativeRel.valuation F.Carrier) y)
  have hmul : T.normalizedAbs x * T.normalizedAbs x⁻¹ = 1 := by
    rw [← T.normalizedAbs_mul, mul_inv_cancel₀ hx, T.normalizedAbs_one]
  have hv : ValuativeRel.valuation F.Carrier x * ValuativeRel.valuation F.Carrier x⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ hx, map_one]
  have hpos := T.normalizedAbs_pos hx
  constructor
  · intro h
    rw [h, one_mul] at hmul
    have h₁ := (key x).1 h.le
    have h₂ := (key x⁻¹).1 hmul.le
    refine le_antisymm h₁ ?_
    calc (1 : ValuativeRel.ValueGroupWithZero F.Carrier)
        = ValuativeRel.valuation F.Carrier x * ValuativeRel.valuation F.Carrier x⁻¹ := hv.symm
      _ ≤ ValuativeRel.valuation F.Carrier x := mul_le_of_le_one_right' h₂
  · intro h
    rw [h, one_mul] at hv
    have h₁ := (key x).2 h.le
    have h₂ := (key x⁻¹).2 hv.le
    refine le_antisymm h₁ ?_
    nlinarith [mul_le_mul_of_nonneg_left h₂ hpos.le]

/-- Membership in `G°` through the valuation of the block determinants. -/
theorem mem_determinantUnitSubgroup_iff_valuation (T : F.TopologicalData) {n : ℕ}
    (B : BlockShape n) (g : B.Levi F.Carrier) :
    letI := T.valuativeRel
    g ∈ determinantUnitSubgroup T B ↔
      ∀ i, ValuativeRel.valuation F.Carrier (determinant (g i) : F.Carrier) = 1 := by
  let := T.valuativeRel
  rw [mem_determinantUnitSubgroup_iff_normalizedAbs]
  exact forall_congr' fun i => normalizedAbs_eq_one_iff T (Units.ne_zero _)

/-- **Sandwich structure of compact-open Hecke corners of `G°`**
(Bernstein--Zelevinsky 1976, Lemma 4.9, page 39). -/
theorem determinantUnitCornerStructure : DeterminantUnitCornerStructureStatement.{uF} := by
  intro p _ F T n B K hK
  let := T.topology
  let := T.valuativeRel
  let := T.localField
  let := T.fieldT2
  let : MeasurableSpace (determinantUnitSubgroup T B) := borel _
  have : BorelSpace (determinantUnitSubgroup T B) := ⟨rfl⟩
  exact GeneralLinear.exists_cornerStructure (determinantUnitSubgroup T B)
    (mem_determinantUnitSubgroup_iff_valuation T B) K hK

end Langlands.CuspidalSupport
