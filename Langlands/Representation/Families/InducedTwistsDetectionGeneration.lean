import Langlands.Representation.Families.InducedTwistsDetectionJacquetLift
import Langlands.Representation.Exponents.ArbitraryParabolicLeviPoints
import Langlands.Representation.Exponents.LeviParabolicFunctorsExactProof
import Langlands.Representation.Category.ExactFunctor
import Langlands.Representation.Compact.SurjectivityProof

/-! # Generation of an induced representation by fixed vectors from second adjointness

Let `i_P^G ⊣ r_{P̄}^G` and let `K` have an Iwahori contraction relative to the
radical and Levi of `P̄`. If an irreducible `σ` has a nonzero vector fixed by the
Levi points lying in `K`, then `i_P^G σ` is generated by its `K`-fixed vectors.
The quotient by the span of the fixed vectors has no fixed vector, so the weak
Jacquet lemma applies to it without any admissibility hypothesis.
-/

set_option autoImplicit false

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.Renard.AlgebraicFamily.InducedTwistsDetection

open Langlands.GroupScheme Langlands.Aubert.General Langlands.Aubert.General.RepresentedParabolic

variable {k : Type u} [Field k] [ValuativeRel k] [TopologicalSpace k]
  [IsNonarchimedeanLocalField k] [T2Space k]
  {G P M U Pbar Nbar : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]

local instance inducedTwistsDetectionPointTopology : TopologicalSpace (rationalPoints G) :=
  RationalPointFamily.pointTopology

variable [LocallyCompactSpace (rationalPoints G)] [NonarchimedeanGroup (rationalPoints G)]

/-- Second adjointness and an Iwahori contraction relative to the opposite parabolic
make `i_P^G σ` generated by its `K`-fixed vectors. -/
theorem leviInduction_fixedVectors_generate
    (hG : IsConnectedReductive G)
    (p : P ⟶ G) (l : M ⟶ P) (r : U ⟶ P)
    (hp : IsParabolicSubgroup p) (hl : IsRationalLeviSubgroup l)
    (hr : LeviSubgroup.IsGeometricUnipotentRadical r)
    (hmul : IsIso (subgroupMultiplication l r))
    (pbar : Pbar ⟶ G) (mbar : M ⟶ Pbar) (nbar : Nbar ⟶ Pbar)
    (hpbar : IsParabolicSubgroup pbar) (hmbar : IsRationalLeviSubgroup mbar)
    (hnbar : LeviSubgroup.IsGeometricUnipotentRadical nbar)
    (hmulbar : IsIso (subgroupMultiplication mbar nbar)) :
    haveI := hl.isConnectedReductive.isAffineHom
    letI : TopologicalSpace (rationalPoints M) := leviPointTopology l hl
    haveI : LocallyCompactSpace (rationalPoints M) := leviPoints_locallyCompactSpace p l hp hl
    haveI : NonarchimedeanGroup (rationalPoints M) := leviPoints_nonarchimedeanGroup p l hp hl
    ∀ (_adj : leviInductionFunctor.{u, max u v} p l r hp hr hl hmul ⊣
        leviJacquetFunctor.{u, max u v} pbar mbar nbar hpbar hnbar hmbar hmulbar)
      (K : OpenSubgroup (rationalPoints G)) (_hK : IsCompact (K : Set (rationalPoints G)))
      (X : Subgroup (rationalPoints G)) (g : rationalPoints G)
      (_hcon : Jacquet.IsIwahoriContraction K (pointImage (nbar ≫ pbar))
        (pointImage (mbar ≫ pbar)) X g)
      (σ : SmoothRep.{0, u, max u v} ℂ (rationalPoints M)) (_hσ : σ.IsIrreducible)
      (v₀ : σ) (_hv₀ : v₀ ≠ 0)
      (_hfix : ∀ m : rationalPoints M, rationalPoints.map (mbar ≫ pbar) m ∈ K →
        σ.representation m v₀ = v₀),
      ∀ S : Subrepresentation
          ((leviInductionFunctor.{u, max u v} p l r hp hr hl hmul).obj σ).representation,
        fixedVectors ((leviInductionFunctor.{u, max u v} p l r hp hr hl hmul).obj σ).representation
          K.toSubgroup ≤ S.toSubmodule → S = ⊤ := by
  have := hl.isConnectedReductive.isAffineHom
  let : TopologicalSpace (rationalPoints M) := leviPointTopology l hl
  have : LocallyCompactSpace (rationalPoints M) := leviPoints_locallyCompactSpace p l hp hl
  have : NonarchimedeanGroup (rationalPoints M) := leviPoints_nonarchimedeanGroup p l hp hl
  intro adj K hK X g hcon σ hσ v₀ hv₀ hfix S hS
  by_contra hne
  let I := leviInductionFunctor.{u, max u v} p l r hp hr hl hmul
  let R := leviJacquetFunctor.{u, max u v} pbar mbar nbar hpbar hnbar hmbar hmulbar
  let π := I.obj σ
  let Q := SmoothRep.quotient π S
  let q : π ⟶ Q := SmoothRep.mkQ π S
  -- The quotient has no nonzero `K`-fixed vector.
  have hQK : ∀ x ∈ fixedVectors Q.representation K.toSubgroup, x = 0 := by
    intro x hx
    obtain ⟨y, hy⟩ := Compact.fixedVectorSurjectivity (rationalPoints G) π Q
      π.representation Q.representation π.isSmooth Q.isSmooth K hK (SmoothRep.hom q)
      (SmoothRep.mkQ_surjective π S) ⟨x, hx⟩
    have hyx : SmoothRep.hom q y.val = x := congrArg Subtype.val hy
    have hyS : y.val ∈ S.toSubmodule := hS y.property
    rw [← hyx]
    exact (Submodule.Quotient.mk_eq_zero S.toSubmodule).mpr hyS
  -- The quotient map is nonzero.
  have hq0 : q ≠ 0 := by
    intro hq
    apply hne
    apply Subrepresentation.toSubmodule_injective
    apply top_unique
    intro y _
    have hy : SmoothRep.hom q y = 0 := by rw [hq]; rfl
    exact (Submodule.Quotient.mk_eq_zero S.toSubmodule).mp hy
  -- The right adjoint preserves zero morphisms, by exactness.
  have hRexact : SmoothRep.PreservesShortExact R :=
    (leviParabolicFunctorsExact.{u, max u v} k G hG Pbar M Nbar pbar mbar nbar hpbar hmbar
      hnbar hmulbar).2
  have : R.PreservesZeroMorphisms := hRexact.preservesZeroMorphisms
  let φ : σ ⟶ R.obj Q := adj.homEquiv σ Q q
  have hφ0 : φ ≠ 0 := by
    intro hφ
    apply hq0
    apply (adj.homEquiv σ Q).injective
    change φ = adj.homEquiv σ Q 0
    rw [hφ, Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hφinj : Function.Injective (SmoothRep.hom φ) := by
    rcases Representation.IsIrreducible.injective_or_eq_zero (SmoothRep.hom φ) with h | h
    · exact h
    · exact absurd (SmoothRep.hom_ext' (h.trans rfl)) hφ0
  let w : R.obj Q := SmoothRep.hom φ v₀
  have hw0 : w ≠ 0 := fun h => hv₀ (hφinj (h.trans (map_zero (SmoothRep.hom φ)).symm))
  -- The image of `v₀` is fixed by the Levi points in `K`.
  let N' := pointImage (nbar ≫ pbar)
  let M' := pointImage (mbar ≫ pbar)
  have hN' : IsClosed (N' : Set (rationalPoints G)) :=
    isClosed_pointImage_comp pbar nbar hpbar.isClosedSubgroup hnbar.1.isClosedSubgroup
  have hM' : IsClosed (M' : Set (rationalPoints G)) :=
    isClosed_pointImage_comp pbar mbar hpbar.isClosedSubgroup hmbar.isClosedSubgroup
  have hMN' : M' ≤ Subgroup.normalizer N' := pointImage_le_normalizer pbar mbar nbar hnbar
  have hwfix : w ∈ fixedVectors
      ((normalizedJacquetFunctor N' M' hN' hMN').obj Q).representation
      (K.toSubgroup.comap M'.subtype) := by
    rintro ⟨⟨x, ⟨m, rfl⟩⟩, hxK⟩
    have hmK : rationalPoints.map (mbar ≫ pbar) m ∈ K := hxK
    have heq := Representation.IntertwiningMap.isIntertwining σ.representation
      (R.obj Q).representation (SmoothRep.hom φ) m v₀
    change SmoothRep.hom φ (σ.representation m v₀) =
      ((normalizedJacquetFunctor N' M' hN' hMN').obj Q).representation
        (leviPointsEquiv pbar mbar hpbar hmbar m) (SmoothRep.hom φ v₀) at heq
    rw [hfix m hmK] at heq
    exact heq.symm
  have hfin : FiniteDimensional ℂ (fixedVectors Q.representation K.toSubgroup) := by
    have hbot : fixedVectors Q.representation K.toSubgroup = ⊥ :=
      (Submodule.eq_bot_iff _).mpr hQK
    rw [hbot]
    infer_instance
  obtain ⟨x, hx, hx0⟩ := exists_fixed_of_normalizedJacquet_fixed N' M' X hN' hMN' hM' K hK g
    hcon Q hfin ⟨w, hwfix, hw0⟩
  exact hx0 (hQK x hx)

end Langlands.Renard.AlgebraicFamily.InducedTwistsDetection
