import Langlands.Representation.Families.InducedTwistsUniformDetectionStatement
import Langlands.Representation.Jacquet.StandardFixedVectorSubquotientGenerationStatement
import Langlands.Representation.Exponents.LeviSecondAdjointnessStatement
import Langlands.BruhatTits.SpecialCompact.JointBasisStatement

/-! # The uniform induced-twist detector from its remaining inputs

The proof of Renard 2026, VI.8.4 Proposition (first paragraph of printed p.193 / PDF
p.199) uses one compact open subgroup `K` with nonzero fixed vectors in every irreducible
subquotient of every induced unramified twist `i_P^G(ρ ⊗ ψ)`. This module states that the
published `InducedTwistsUniformDetectionStatement` follows from three published
statements that remain unproved: the VI.9.4 Corollary, the VI.9.6.1 second adjointness and
the V.5.1–V.5.2 joint special-compact basis.
The implication is neither assumed nor proved here.
-/

noncomputable section

set_option autoImplicit false

universe u v

namespace Langlands.Renard.AlgebraicFamily

/-- The uniform induced-twist detector of Renard VI.8.4 holds for fields in universe `u`
and Levi carriers in `v`, provided these hold: the VI.9.4 Corollary (subquotients of a
representation generated by `K`-fixed vectors are generated by theirs) for carriers in
`max u v`; second adjointness `i_P ⊣ r_{P̄}` (VI.9.6.1) for carriers in `max u v`; and the
V.5.1–V.5.2 special compact subgroup with its Iwasawa products and simultaneous
standard-parabolic basis at one geometric witness. -/
def InducedTwistsUniformDetectionFromInputsStatement : Prop :=
  Langlands.Jacquet.StandardFixedVectorSubquotientGenerationStatement.{u, max u v} →
  Langlands.Aubert.General.RepresentedParabolic.LeviSecondAdjointnessStatement.{u, v} →
  Langlands.BruhatTits.SpecialCompact.JointSpecialCompactBasisExistenceStatement.{u} →
  InducedTwistsUniformDetectionStatement.{u, v}

end Langlands.Renard.AlgebraicFamily
