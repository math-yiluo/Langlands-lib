import Langlands.Representation.Families.RenardFamilyParabolicFunctors
import Langlands.Representation.Plancherel.UnramifiedNormalizedModels

/-!
# Renard VI.8.1 Example: the fibers of the universal unramified family

Let `(π, V)` be a representation of `G`, `B` the published algebra of functions on the
unramified characters generated by the evaluations at elements of `G`, and
`(π_B, V_B)` the universal unramified family `B ⊗ V`, on which `g` acts by
`χ_un(g) ⊗ π(g)`. For an unramified character `χ`, let `ℂ_χ` be `ℂ` regarded as a
`B`-algebra through evaluation at `χ`. The specialization `ℂ_χ ⊗_B V_B` of `V_B` at `χ`,
with the base-changed action, is isomorphic to the twist `π ⊗ χ` by the map
`c ⊗ (b ⊗ v) ↦ c b(χ) v`.
-/

noncomputable section

open scoped TensorProduct NNReal

namespace Langlands.Renard.AlgebraicFamily

universe uG uI uV

/-- VI.8.1 Example, last claim: the specialization at an unramified character `χ` of the
universal unramified family `(π_B, B ⊗ V)` of a representation `π` is isomorphic to the twist
`π ⊗ χ`, by the map `c ⊗ (b ⊗ v) ↦ c b(χ) v`. Here `ℂ` is a `B`-algebra through evaluation
at `χ`. -/
def UniversalSpecializationStatement : Prop :=
  ∀ (G : Type uG) [Group G] [TopologicalSpace G] (I : Type uI) (ν : I → (G →* ℝ≥0ˣ))
    (V : Type uV) [AddCommGroup V] [Module ℂ V] (π : Representation ℂ G V)
    (χ : Plancherel.unramifiedCharacters ν),
    letI : AddCommGroup (Plancherel.unramifiedRegularFunctions ν ⊗[ℂ] V) :=
      TensorProduct.addCommGroup
    letI : Module (Plancherel.unramifiedRegularFunctions ν)
        (Plancherel.unramifiedRegularFunctions ν ⊗[ℂ] V) := TensorProduct.leftModule
    letI : Algebra (Plancherel.unramifiedRegularFunctions ν) ℂ :=
      (Plancherel.UnramifiedNormalized.evaluation ν χ).toAlgebra
    ∃ e : ℂ ⊗[Plancherel.unramifiedRegularFunctions ν]
        (Plancherel.unramifiedRegularFunctions ν ⊗[ℂ] V) ≃ₗ[ℂ] V,
      (∀ (g : G) (x : ℂ ⊗[Plancherel.unramifiedRegularFunctions ν]
          (Plancherel.unramifiedRegularFunctions ν ⊗[ℂ] V)),
        e (baseChange ℂ (Plancherel.universalUnramifiedRepresentation ν π) g x) =
          Langlands.twist χ.val.toMonoidHom π g (e x)) ∧
      ∀ (c : ℂ) (b : Plancherel.unramifiedRegularFunctions ν) (v : V),
        e (c ⊗ₜ[Plancherel.unramifiedRegularFunctions ν] (b ⊗ₜ[ℂ] v)) = (c * b.val χ) • v

end Langlands.Renard.AlgebraicFamily
