import Langlands.Representation.Exponents.ArbitraryParabolicLeviPoints
import Langlands.Representation.Plancherel.RationalCharacterTopology
import Langlands.Representation.Plancherel.UnramifiedOperatorTransport

/-! # Unramified parameters on an actual rational Levi and its point image -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj NNReal

namespace Langlands.Renard.AlgebraicFamily.ActualLevi

open GroupScheme Langlands.AlgebraicGeometry.PointTopology
open Langlands.Aubert.General Langlands.Aubert.General.RepresentedParabolic
open Langlands.Plancherel

variable {k : Type u} [Field k] [ValuativeRel k] [TopologicalSpace k]
  [IsNonarchimedeanLocalField k]
  {G P M : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  [IsAffineHom M.X.hom]
  (p : P ⟶ G) (l : M ⟶ P) (hp : IsParabolicSubgroup p)
  (hl : IsRationalLeviSubgroup l)

local instance ambientPointTopology : TopologicalSpace (rationalPoints G) :=
  RationalPointFamily.pointTopology

local instance actualLeviPointTopology : TopologicalSpace (rationalPoints M) :=
  RationalPointFamily.pointTopology

/-- All actual rational-character norms, read on the literal Levi point image. -/
def normFamily : rationalCharacters M → (pointImage (l ≫ p) →* ℝ≥0ˣ) :=
  fun χ => (rationalNormCharacters M χ).toMul.comp
    (leviPointsEquiv p l hp hl).symm.toMulEquiv.toMonoidHom

omit [IsAffineHom M.X.hom] in
@[simp] theorem normFamily_apply (χ : rationalCharacters M)
    (m : pointImage (l ≫ p)) :
    normFamily p l hp hl χ m =
      (rationalNormCharacters M χ).toMul ((leviPointsEquiv p l hp hl).symm m) := rfl

/-- Continuity comes from the canonical point topology and the Levi homeomorphism. -/
theorem continuous_normFamily (χ : rationalCharacters M) :
    Continuous (normFamily p l hp hl χ) := by
  let : IsAffine M.X.left := isAffine_of_isAffineHom M.X.hom
  exact (rationalNormContinuousCharacter M χ).continuous.comp
    (leviPointsEquiv p l hp hl).symm.continuous

/-- The parameter group on `M(k)` is canonically the parameter group on its image. -/
def parameterEquiv :
    unramifiedCharacters (fun χ : rationalCharacters M =>
      (rationalNormCharacters M χ).toMul) ≃ₜ*
      unramifiedCharacters (normFamily p l hp hl) :=
  unramifiedCharactersHomeomorph (leviPointsEquiv p l hp hl) _

@[simp] theorem parameterEquiv_apply
    (ψ : unramifiedCharacters (fun χ : rationalCharacters M =>
      (rationalNormCharacters M χ).toMul)) (m : pointImage (l ≫ p)) :
    (parameterEquiv p l hp hl ψ).val m =
      ψ.val ((leviPointsEquiv p l hp hl).symm m) := rfl

@[simp] theorem parameterEquiv_symm_apply
    (ψ : unramifiedCharacters (normFamily p l hp hl)) (m : rationalPoints M) :
    ((parameterEquiv p l hp hl).symm ψ).val m =
      ψ.val (leviPointsEquiv p l hp hl m) := rfl

/-- The two algebras generated by actual evaluations are canonically equivalent. -/
def regularAlgebraEquiv :
    unramifiedRegularFunctions (fun χ : rationalCharacters M =>
      (rationalNormCharacters M χ).toMul) ≃ₐ[ℂ]
      unramifiedRegularFunctions (normFamily p l hp hl) :=
  unramifiedRegularFunctionsEquiv (leviPointsEquiv p l hp hl) _

@[simp] theorem regularAlgebraEquiv_apply
    (b : unramifiedRegularFunctions (fun χ : rationalCharacters M =>
      (rationalNormCharacters M χ).toMul))
    (ψ : unramifiedCharacters (normFamily p l hp hl)) :
    (regularAlgebraEquiv p l hp hl b).val ψ =
      b.val ((parameterEquiv p l hp hl).symm ψ) := rfl

@[simp] theorem regularAlgebraEquiv_symm_apply
    (b : unramifiedRegularFunctions (normFamily p l hp hl))
    (ψ : unramifiedCharacters (fun χ : rationalCharacters M =>
      (rationalNormCharacters M χ).toMul)) :
    ((regularAlgebraEquiv p l hp hl).symm b).val ψ =
      b.val (parameterEquiv p l hp hl ψ) :=
  unramifiedRegularFunctionsEquiv_symm_apply (leviPointsEquiv p l hp hl) _ b ψ

@[simp] theorem regularAlgebraEquiv_evaluation (m : rationalPoints M) :
    regularAlgebraEquiv p l hp hl
        (unramifiedEvaluationRegular (fun χ : rationalCharacters M =>
          (rationalNormCharacters M χ).toMul) m) =
      unramifiedEvaluationRegular (normFamily p l hp hl) (leviPointsEquiv p l hp hl m) :=
  unramifiedRegularFunctionsEquiv_evaluation (leviPointsEquiv p l hp hl) _ m

end Langlands.Renard.AlgebraicFamily.ActualLevi
