import Langlands.Representation.Families.InducedTwistsUniformDetectionStatement
import Langlands.Representation.Families.InducedTwistsDetectionGeneration
import Langlands.Representation.Families.InducedTwistsDetectionOpposite
import Langlands.Representation.Families.InducedTwistsDetectionHelpers
import Langlands.Representation.Exponents.LeviSecondAdjointnessStatement
import Langlands.Representation.Jacquet.StandardFixedVectorSubquotientGenerationStatement
import Langlands.Representation.Jacquet.DynamicCasselmanConstantTerm
import Langlands.Representation.Aubert.General.StandardFamilyStructure
import Langlands.Representation.Plancherel.RationalCharacterTopology
import Langlands.Representation.Category.UniverseLift
import Langlands.BruhatTits.SpecialCompact.JointBasisStatement

/-! # The uniform induced-twist detector from three structural inputs

Renard VI.8.4 needs one compact open subgroup `K` with nonzero fixed vectors in every
irreducible subquotient of every `i_P^G(ρ ⊗ ψ)`. This module derives it from the
VI.9.4 Corollary, VI.9.6 second adjointness and the V.5.2 joint special-compact basis.
-/

set_option autoImplicit false

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.Renard.AlgebraicFamily.InducedTwistsDetection

open Langlands.GroupScheme Langlands.Aubert.General Langlands.Aubert.General.RepresentedParabolic

/-- Generation by fixed vectors passes to a smaller subgroup. -/
theorem generate_of_le {H : Type*} [Group H] {V : Type*} [AddCommGroup V] [Module ℂ V]
    {ρ : Representation ℂ H V} {K K' : Subgroup H} (hle : K ≤ K')
    (hgen : ∀ S : Subrepresentation ρ, fixedVectors ρ K' ≤ S.toSubmodule → S = ⊤) :
    ∀ S : Subrepresentation ρ, fixedVectors ρ K ≤ S.toSubmodule → S = ⊤ := by
  intro S hS
  apply hgen S
  intro w hw
  apply hS
  intro k
  exact hw ⟨k.val, hle k.property⟩

/-- An irreducible representation generated by its `K`-fixed vectors has a nonzero one. -/
theorem exists_fixed_ne_zero_of_generate {H : Type*} [Group H] {V : Type*} [AddCommGroup V]
    [Module ℂ V] {ρ : Representation ℂ H V} (hρ : ρ.IsIrreducible) {K : Subgroup H}
    (hgen : ∀ S : Subrepresentation ρ, fixedVectors ρ K ≤ S.toSubmodule → S = ⊤) :
    ∃ w : V, w ∈ fixedVectors ρ K ∧ w ≠ 0 := by
  by_contra hno
  push Not at hno
  apply (bot_ne_top : (⊥ : Subrepresentation ρ) ≠ ⊤)
  apply hgen ⊥
  intro w hw
  rw [hno w hw]
  exact Submodule.zero_mem _

/-- An irreducible representation has a nonzero vector. -/
theorem exists_ne_zero_of_isIrreducible {H : Type*} [Group H] {V : Type*} [AddCommGroup V]
    [Module ℂ V] {ρ : Representation ℂ H V} (hρ : ρ.IsIrreducible) : ∃ w : V, w ≠ 0 := by
  by_contra hno
  push Not at hno
  apply (bot_ne_top : (⊥ : Subrepresentation ρ) ≠ ⊤)
  apply Subrepresentation.toSubmodule_injective
  ext w
  simp [hno w]

end Langlands.Renard.AlgebraicFamily.InducedTwistsDetection

namespace Langlands.Renard.AlgebraicFamily

open Langlands.GroupScheme Langlands.Aubert.General Langlands.Aubert.General.RepresentedParabolic
open InducedTwistsDetection

/-- The uniform induced-twist detector follows from the VI.9.4 Corollary, VI.9.6 second
adjointness and the V.5.2 joint special-compact basis. -/
theorem inducedTwistsUniformDetection_of_inputs
    (hCor : Jacquet.StandardFixedVectorSubquotientGenerationStatement.{u, max u v})
    (hAdj : LeviSecondAdjointnessStatement.{u, v})
    (hJoint : BruhatTits.SpecialCompact.JointSpecialCompactBasisExistenceStatement.{u}) :
    InducedTwistsUniformDetectionStatement.{u, v} := by
  intro k _ _ _ _ _ G hG
  have := hG.isAffineHom
  let : TopologicalSpace (rationalPoints G) := RationalPointFamily.pointTopology
  intro _ _ P M U p l r hp hl hr hmul
  have := hl.isConnectedReductive.isAffineHom
  have : IsAffine M.X.left := isAffine_of_isAffineHom M.X.hom
  let : TopologicalSpace (rationalPoints M) := leviPointTopology l hl
  have : LocallyCompactSpace (rationalPoints M) := leviPoints_locallyCompactSpace p l hp hl
  have : NonarchimedeanGroup (rationalPoints M) := leviPoints_nonarchimedeanGroup p l hp hl
  intro ρ hρ
  -- The opposite parabolic `P̄ = P(χ)` and second adjointness `i_P ⊣ r_{P̄}`.
  obtain ⟨Pbar, Nbar, pbar, mbar, nbar, χ, hpbar, hmbar, hnbar, hmulbar, hcomp, hinf, -, hMχ,
    hNχ⟩ := exists_opposite_parabolic hG hp hl
  obtain ⟨adj⟩ := hAdj k G hG P Pbar M U Nbar p l r hp hl hr hmul pbar mbar nbar hpbar hmbar
    hnbar hmulbar hcomp hinf
  -- A nonzero vector of `ρ` fixed by a compact open subgroup `Cρ` of `M(k)`.
  obtain ⟨v₀, hv₀⟩ := exists_ne_zero_of_isIrreducible hρ
  obtain ⟨Kρ, hKρ⟩ := ρ.isSmooth v₀
  obtain ⟨Cρ, hCρc, hCρ⟩ := Jacquet.exists_isCompact_openSubgroup_subset
    (Kρ.isOpen.mem_nhds Kρ.one_mem)
  -- An open subset `O` of `G(k)` whose Levi points lie in `Cρ`.
  have hind : Topology.IsInducing (fun m : rationalPoints M => rationalPoints.map (l ≫ p) m) :=
    Topology.IsInducing.subtypeVal.comp (leviPointsEquiv p l hp hl).toHomeomorph.isInducing
  obtain ⟨O, hO, hOpre⟩ := hind.isOpen_iff.mp Cρ.isOpen
  have h1O : (1 : rationalPoints G) ∈ O := by
    have h1 : (1 : rationalPoints M) ∈ (fun m => rationalPoints.map (l ≫ p) m) ⁻¹' O := by
      rw [hOpre]
      exact Cρ.one_mem
    simpa using h1
  -- A compact open `K' ⊆ O` with an Iwahori contraction relative to `P̄`.
  have := hG.smooth
  obtain ⟨t, ht⟩ := BruhatTits.DynamicUnipotentContainment.exists_unit_tendsto_pow_zero (F := k)
  obtain ⟨K', hK'c, hK'O, hcon, -⟩ :=
    Jacquet.hasOppositeIwahoriContractionBasis_cocharPoint χ t ht O hO h1O
  have hcon' : Jacquet.IsIwahoriContraction K' (pointImage (nbar ≫ pbar))
      (pointImage (mbar ≫ pbar))
      (BruhatTits.DynamicUnipotentContainment.unipotentPoints (Dynamic.inverseCocharacter χ))
      (BruhatTits.DynamicUnipotentContainment.cocharPoint χ t) := by
    rw [hcomp, pointImage_eq_range_carrier, pointImage_eq_range_carrier, hNχ, hMχ]
    exact hcon
  -- The V.5.2 basis at the joint special compact subgroup `K₀`; choose `K ⊆ K'` in it.
  obtain ⟨S, i, ν, hi, hν⟩ := RationalPointFamily.exists_maximalSplitTorus_genericCocharacter hG
  have := hi.isSplitSubtorus.mono
  obtain ⟨D, x, Z, j, s, -, -, -, h, -, hprops, -, hIw, -, -, -, B, hB, hBJ⟩ :=
    hJoint k G hG S i hi ν hν
  obtain ⟨K, hKB, hKK'⟩ := hB.2.mem_iff.mp (K'.isOpen.mem_nhds K'.one_mem)
  obtain ⟨hKK0, hKnormal, hKopen, hKcompact⟩ := hB.1 K hKB
  let Ko : OpenSubgroup (rationalPoints G) := ⟨K, hKopen⟩
  refine ⟨Ko, hKcompact, ?_⟩
  intro ψ Dq hDirr hDsub
  let τ := ρ.twist ψ.val.toMonoidHom (Plancherel.unramifiedCharacter_isOpen_ker _ ψ)
  -- The lifted induction `i_P(τ)` is generated by its `K'`-fixed vectors.
  have hfix : ∀ m : rationalPoints M, rationalPoints.map (mbar ≫ pbar) m ∈ K' →
      (SmoothRep.universeLift.{u} τ).representation m (SmoothRep.universeLiftEquiv τ v₀) =
        SmoothRep.universeLiftEquiv τ v₀ := by
    intro m hm
    have hmC : m ∈ Cρ := by
      have hmO : m ∈ (fun m => rationalPoints.map (l ≫ p) m) ⁻¹' O := by
        rw [hcomp] at hm
        exact hK'O hm
      rw [hOpre] at hmO
      exact hmO
    have hψ : ψ.val m = 1 :=
      ψ.property (Plancherel.compactSubgroup_le_rationalCommonNormKernel M Cρ.toSubgroup hCρc hmC)
    have hρm : ρ.representation m v₀ = v₀ := hKρ ⟨m, hCρ hmC⟩
    show ULift.up (((ψ.val.toMonoidHom m : ℂˣ) : ℂ) • ρ.representation m v₀) = ULift.up v₀
    rw [hρm]
    change ULift.up (((ψ.val m : ℂˣ) : ℂ) • v₀) = ULift.up v₀
    rw [hψ, Units.val_one, one_smul]
  have hσ : (SmoothRep.universeLift.{u} τ).IsIrreducible :=
    (SmoothRep.isIrreducible_universeLift_iff τ).mpr
      ((SmoothRep.isIrreducible_twist_iff _ _ ρ).mpr hρ)
  have hv₀' : SmoothRep.universeLiftEquiv τ v₀ ≠ 0 := by
    intro hz
    apply hv₀
    exact (SmoothRep.universeLiftEquiv τ).injective (hz.trans (map_zero _).symm)
  have hgen' := leviInduction_fixedVectors_generate hG p l r hp hl hr hmul pbar mbar nbar
    hpbar hmbar hnbar hmulbar adj K' hK'c _ _ hcon' (SmoothRep.universeLift.{u} τ) hσ
    (SmoothRep.universeLiftEquiv τ v₀) hv₀' hfix
  -- Hence it is generated by its `K`-fixed vectors, and so is `i_P(ρ ⊗ ψ)`.
  have hgenK := generate_of_le (K := Ko.toSubgroup) hKK' hgen'
  have hgen := leviInduction_generate_of_universeLift p l r hp hr hl hmul τ Ko.toSubgroup hgenK
  -- The VI.9.4 Corollary at `K ⊆ K₀` gives generation of `Dq` by `Dq^K`.
  have hIwasawa := exists_standard_minimal_factorization hG i hi ν hν
    (D.specialCompactSubgroup x) hIw.2.2.1
  have hstandard : ∀ J ⊆ simpleRelativeRoots i ν, ∃ zeta, IsStandardCocharacter i ν J zeta :=
    fun J hJ => (standardCocharacter k G hG S i hi ν hν J hJ).1
  have hIwahori : ∀ J ⊆ simpleRelativeRoots i ν,
      ∃ (A : CommGroupScheme (Spec (CommRingCat.of k))) (q : A.toGrp ⟶ S.toGrp),
        BruhatTits.SpecialCompact.IsCompatibleStandardSplitComponent i ν J A q ∧
          BruhatTits.SpecialCompact.StandardParabolicBasisMember i ν J q Ko.toSubgroup := by
    intro J hJ
    obtain ⟨-, A, q, hA, hmem⟩ := hBJ J hJ
    exact ⟨A, q, hA, hmem K hKB⟩
  have hDgen := hCor k G hG S i hi ν hν hstandard (D.specialCompactSubgroup x) hprops.2.1.1
    hIwasawa Ko hKcompact hKK0 (le_normalizer_of_subgroupOf_normal hKK0 hKnormal) hIwahori _
    hgen Dq hDsub
  exact exists_fixed_ne_zero_of_generate hDirr hDgen

end Langlands.Renard.AlgebraicFamily
