import Langlands.Representation.Unitary.DiscretePart
import Mathlib.Analysis.InnerProductSpace.Projection.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-! # Criteria for membership in the discrete part of a unitary representation

For a representation `ρ` of a group on a complex Hilbert space by norm-preserving operators:

* `discretePart_le_of_forall_le`: a closed subspace containing every irreducible
  subrepresentation contains the discrete part;
* `mem_discretePart_of_starProjection_mem`: a vector whose orthogonal projections onto all
  closed invariant subspaces lie in one finite-dimensional subspace belongs to the discrete
  part. The closed invariant subspace it generates is then a finite sum of irreducible
  subrepresentations. -/

noncomputable section

set_option autoImplicit false

namespace Langlands.Analysis

open Submodule

universe uH uE

section Monoid

variable {H : Type uH} [Monoid H] {E : Type uE} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- A closed subspace containing every irreducible subrepresentation contains the discrete
part. -/
theorem discretePart_le_of_forall_le (ρ : Representation ℂ H E) {S : Submodule ℂ E}
    (hS : IsClosed (S : Set E)) (h : ∀ V, IsIrreducibleSubrepresentation ρ V → V ≤ S) :
    discretePart ρ ≤ S :=
  Submodule.topologicalClosure_minimal _ (sSup_le h) hS

/-- Every irreducible subrepresentation lies in the discrete part. -/
theorem le_discretePart (ρ : Representation ℂ H E) {V : Submodule ℂ E}
    (hV : IsIrreducibleSubrepresentation ρ V) : V ≤ discretePart ρ :=
  (le_sSup (s := {V | IsIrreducibleSubrepresentation ρ V}) hV).trans
    (Submodule.le_topologicalClosure _)

end Monoid

section Group

variable {H : Type uH} [Group H] {E : Type uE} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- A norm-preserving representation preserves inner products. -/
theorem inner_map_map_of_norm {ρ : Representation ℂ H E} (hρ : ∀ (h : H) (x : E), ‖ρ h x‖ = ‖x‖)
    (h : H) (x y : E) : inner ℂ (ρ h x) (ρ h y) = inner ℂ x y :=
  (LinearMap.norm_map_iff_inner_map_map (ρ h)).1 (hρ h) x y

theorem map_map_inv (ρ : Representation ℂ H E) (h : H) (x : E) : ρ h (ρ h⁻¹ x) = x := by
  rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]

/-- The orthogonal complement of an invariant subspace is invariant. -/
theorem orthogonal_invariant {ρ : Representation ℂ H E} (hρ : ∀ (h : H) (x : E), ‖ρ h x‖ = ‖x‖)
    {V : Submodule ℂ E} (hV : ∀ (h : H), ∀ x ∈ V, ρ h x ∈ V) :
    ∀ (h : H), ∀ x ∈ Vᗮ, ρ h x ∈ Vᗮ := by
  intro h x hx
  rw [Submodule.mem_orthogonal]
  intro u hu
  rw [← map_map_inv ρ h u, inner_map_map_of_norm hρ]
  exact (Submodule.mem_orthogonal _ _).1 hx _ (hV _ _ hu)

variable [CompleteSpace E]

private theorem exists_decomposition {V : Submodule ℂ E} (hV : IsClosed (V : Set E)) (x : E) :
    ∃ y ∈ V, x - y ∈ Vᗮ := by
  have : CompleteSpace V := completeSpace_coe_iff_isComplete.2 hV.isComplete
  exact ⟨V.starProjection x, V.starProjection_apply_mem x, V.sub_starProjection_mem_orthogonal x⟩

omit [CompleteSpace E] in
private theorem eq_bot_of_le_orthogonal {V : Submodule ℂ E} (h : V ≤ Vᗮ) : V = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  have := (Submodule.mem_orthogonal _ _).1 (h hx) x hx
  rw [inner_self_eq_zero] at this
  simp [this]

/-- A vector whose orthogonal projections onto all closed invariant subspaces lie in one
finite-dimensional subspace `W` belongs to the discrete part. -/
theorem mem_discretePart_of_starProjection_mem (ρ : Representation ℂ H E)
    (hρ : ∀ (h : H) (x : E), ‖ρ h x‖ = ‖x‖) (v : E) (W : Submodule ℂ E) [FiniteDimensional ℂ W]
    (hW : ∀ (V : Submodule ℂ E) [V.HasOrthogonalProjection], (∀ (h : H), ∀ x ∈ V, ρ h x ∈ V) →
      V.starProjection v ∈ W) :
    v ∈ discretePart ρ := by
  classical
  -- closed invariant subspaces
  let CI : Submodule ℂ E → Prop := fun V => IsClosed (V : Set E) ∧ ∀ (h : H), ∀ x ∈ V, ρ h x ∈ V
  have hCIinf : ∀ {X Y : Submodule ℂ E}, CI X → CI Y → CI (X ⊓ Y) := fun hX hY =>
    ⟨by rw [Submodule.coe_inf]; exact hX.1.inter hY.1,
      fun h x hx => ⟨hX.2 h x hx.1, hY.2 h x hx.2⟩⟩
  have hCIorth : ∀ {X : Submodule ℂ E}, CI X → CI Xᗮ := fun hX =>
    ⟨Submodule.isClosed_orthogonal _, orthogonal_invariant hρ hX.2⟩
  -- projection-free form of the hypothesis
  have hW' : ∀ V, CI V → ∀ w ∈ V, v - w ∈ Vᗮ → w ∈ W := by
    intro V hV w hw hvw
    have : CompleteSpace V := completeSpace_coe_iff_isComplete.2 hV.1.isComplete
    have h1 := hW V hV.2
    rwa [eq_starProjection_of_mem_orthogonal hw hvw] at h1
  -- the closed invariant subspace generated by `v`
  let C : Submodule ℂ E := sInf {Y | CI Y ∧ v ∈ Y}
  have hCv : v ∈ C := Submodule.mem_sInf.2 fun Y hY => hY.2
  have hCmin : ∀ Y, CI Y → v ∈ Y → C ≤ Y := fun Y hY hv => sInf_le ⟨hY, hv⟩
  -- nonzero closed invariant subspaces of `C` see a nonzero projection of `v`
  have hne : ∀ X, CI X → X ≤ C → X ≠ ⊥ → ∀ w ∈ X, v - w ∈ Xᗮ → w ≠ 0 := by
    intro X hX hXC hXb w _ hvw hw0
    subst hw0
    rw [sub_zero] at hvw
    exact hXb (eq_bot_of_le_orthogonal (hXC.trans (hCmin _ (hCIorth hX) hvw)))
  -- the span of the projections of `v` onto closed invariant subspaces of `X`
  let T : Submodule ℂ E → Submodule ℂ E := fun X =>
    span ℂ {w | ∃ Y, CI Y ∧ Y ≤ X ∧ w ∈ Y ∧ v - w ∈ Yᗮ}
  have hTW : ∀ X, T X ≤ W := fun X =>
    span_le.2 fun w ⟨Y, hY, _, hw, hvw⟩ => hW' Y hY w hw hvw
  have hTfin : ∀ X, FiniteDimensional ℂ (T X) := fun X =>
    Submodule.finiteDimensional_of_le (hTW X)
  let d : Submodule ℂ E → ℕ := fun X => Module.finrank ℂ (T X)
  -- strict monotonicity of `d` on closed invariant subspaces of `C`
  have hdlt : ∀ X Y, CI X → CI Y → Y ≤ X → X ≤ C → Y ≠ X → d Y < d X := by
    intro X Y hX hY hYX hXC hYne
    have hZ : CI (X ⊓ Yᗮ) := hCIinf hX (hCIorth hY)
    have hZb : X ⊓ Yᗮ ≠ ⊥ := by
      intro hZb
      apply hYne
      refine le_antisymm hYX fun x hx => ?_
      obtain ⟨y, hy, hxy⟩ := exists_decomposition hY.1 x
      have hmem : x - y ∈ X ⊓ Yᗮ := ⟨X.sub_mem hx (hYX hy), hxy⟩
      rw [hZb, Submodule.mem_bot, sub_eq_zero] at hmem
      exact hmem ▸ hy
    obtain ⟨w, hw, hvw⟩ := exists_decomposition hZ.1 v
    have hw0 : w ≠ 0 := hne _ hZ (inf_le_left.trans hXC) hZb w hw hvw
    have hwX : w ∈ T X := subset_span ⟨_, hZ, inf_le_left, hw, hvw⟩
    have hTY : T Y ≤ (ℂ ∙ w)ᗮ := by
      refine span_le.2 fun u ⟨Y', _, hY'Y, hu, _⟩ => ?_
      rw [SetLike.mem_coe, Submodule.mem_orthogonal_singleton_iff_inner_right]
      exact inner_eq_zero_symm.1 ((Submodule.mem_orthogonal _ _).1 hw.2 u (hY'Y hu))
    have hwY : w ∉ T Y := by
      intro hwY
      have := (Submodule.mem_orthogonal_singleton_iff_inner_right).1 (hTY hwY)
      rw [inner_self_eq_zero] at this
      exact hw0 this
    have hle : T Y ≤ T X := span_mono fun u ⟨Y', hY', hY'Y, hu, hvu⟩ =>
      ⟨Y', hY', hY'Y.trans hYX, hu, hvu⟩
    have := hTfin X
    exact Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hle fun h => hwY (h ▸ hwX))
  -- every nonzero closed invariant subspace of `C` contains an irreducible one
  have hirr : ∀ X, CI X → X ≤ C → X ≠ ⊥ → ∃ Y ≤ X, IsIrreducibleSubrepresentation ρ Y := by
    intro X hX hXC hXb
    have hex : ∃ n, ∃ Y, CI Y ∧ Y ≤ X ∧ Y ≠ ⊥ ∧ d Y = n := ⟨_, X, hX, le_rfl, hXb, rfl⟩
    obtain ⟨Y, hY, hYX, hYb, hYd⟩ := Nat.find_spec hex
    refine ⟨Y, hYX, hY.1, hYb, hY.2, fun Y' hY'Y hY'c hY'i => ?_⟩
    by_cases hb : Y' = ⊥
    · exact Or.inl hb
    by_cases he : Y' = Y
    · exact Or.inr he
    exfalso
    have hlt := hdlt Y Y' hY ⟨hY'c, hY'i⟩ hY'Y (hYX.trans hXC) he
    rw [hYd] at hlt
    exact Nat.find_min hex hlt ⟨Y', ⟨hY'c, hY'i⟩, hY'Y.trans hYX, hb, rfl⟩
  -- every closed invariant subspace of `C` lies in the sum of the irreducible ones
  have hmain : ∀ n, ∀ X, CI X → X ≤ C → d X = n →
      X ≤ sSup {V | IsIrreducibleSubrepresentation ρ V} := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro X hX hXC hXd
      by_cases hXb : X = ⊥
      · rw [hXb]; exact bot_le
      obtain ⟨Y, hYX, hYi⟩ := hirr X hX hXC hXb
      have hY : CI Y := ⟨hYi.1, hYi.2.2.1⟩
      have hX' : CI (X ⊓ Yᗮ) := hCIinf hX (hCIorth hY)
      have hX'ne : X ⊓ Yᗮ ≠ X := by
        intro h
        exact hYi.2.1 (eq_bot_of_le_orthogonal (hYX.trans (h ▸ inf_le_right)))
      have hlt := hdlt X (X ⊓ Yᗮ) hX hX' inf_le_left hXC hX'ne
      have h' := ih _ (hXd ▸ hlt) (X ⊓ Yᗮ) hX' (inf_le_left.trans hXC) rfl
      intro x hx
      obtain ⟨y, hy, hxy⟩ := exists_decomposition hY.1 x
      have hsum : x ∈ Y ⊔ (X ⊓ Yᗮ) :=
        Submodule.mem_sup.2 ⟨y, hy, x - y, ⟨X.sub_mem hx (hYX hy), hxy⟩, add_sub_cancel _ _⟩
      exact sup_le (le_sSup (s := {V | IsIrreducibleSubrepresentation ρ V}) hYi) h' hsum
  have hCci : CI C := by
    refine ⟨?_, fun h x hx => Submodule.mem_sInf.2 fun Y hY => hY.1.2 h x
      (Submodule.mem_sInf.1 hx Y hY)⟩
    rw [Submodule.coe_sInf]
    exact isClosed_biInter fun Y hY => hY.1.1
  exact Submodule.le_topologicalClosure _ (hmain _ C hCci le_rfl rfl hCv)

end Group

end Langlands.Analysis
