import Langlands.Representation.Unitary.TestFunctionOperators
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Topology.Algebra.StarSubalgebra
import Mathlib.Topology.UniformSpace.UniformApproximation

/-! # The operator algebra of the integrated test operators

Let `π` be a unitary, jointly continuous representation of a second countable locally compact
group on a complex Hilbert space `H`. This module introduces

* the closed unital `*`-subalgebra `algebra` of `H →L[ℂ] H` generated by the integrated operators
  `π(φ)` of test functions;
* the closed subspace `leftIdeal` spanned by the products `π(φ) y`, `y ∈ algebra`.

Every `x ∈ leftIdeal` has a norm-continuous left orbit `g ↦ π(g) x`, `leftIdeal` is stable under
left multiplication by `algebra` and by every `π(g)`, and `π(φ) x` and `π(φ)^* x` are Bochner
integrals of left translates of `x`. It also defines words in group elements and test functions
and their operators.
-/

noncomputable section

open MeasureTheory Filter Topology
open scoped InnerProductSpace ComplexConjugate

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Langlands.Analysis.TemperedComponent

open Langlands.Archimedean

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [LocallyCompactSpace G]
  [T2Space G] [SecondCountableTopology G] [MeasurableSpace G] [BorelSpace G]
  {μ : Measure G} [μ.IsHaarMeasure]

/-! ### Words -/

/-- Test functions as a type. -/
def TestFn (G : Type*) [Group G] [TopologicalSpace G] [MeasurableSpace G] : Type _ :=
  {φ : G → ℂ // IsTestFunction φ}

/-- Words in group elements and test functions. -/
abbrev Word (G : Type*) [Group G] [TopologicalSpace G] [MeasurableSpace G] : Type _ :=
  List (G ⊕ TestFn G)

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]

/-- The operator of a letter. -/
def letterOp (μ : Measure G) [μ.IsHaarMeasure] (ρ : G →* (E →L[ℂ] E))
    (hρ : IsContinuousRepresentation ρ) : G ⊕ TestFn G → (E →L[ℂ] E)
  | Sum.inl g => ρ g
  | Sum.inr φ => testOp μ ρ hρ φ.1 φ.2

/-- The operator of a word: the product of the operators of its letters. -/
def wordOp (μ : Measure G) [μ.IsHaarMeasure] (ρ : G →* (E →L[ℂ] E))
    (hρ : IsContinuousRepresentation ρ) : Word G → (E →L[ℂ] E)
  | [] => 1
  | a :: w => letterOp μ ρ hρ a * wordOp μ ρ hρ w

@[simp] theorem wordOp_nil (ρ : G →* (E →L[ℂ] E)) (hρ : IsContinuousRepresentation ρ) :
    wordOp μ ρ hρ [] = 1 := rfl

@[simp] theorem wordOp_cons (ρ : G →* (E →L[ℂ] E)) (hρ : IsContinuousRepresentation ρ)
    (a : G ⊕ TestFn G) (w : Word G) :
    wordOp μ ρ hρ (a :: w) = letterOp μ ρ hρ a * wordOp μ ρ hρ w := rfl

/-- An intertwiner intertwines the word operators. -/
theorem intertwiner_comp_wordOp {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F]
    [CompleteSpace F] (ρ : G →* (E →L[ℂ] E)) (hρ : IsContinuousRepresentation ρ)
    (ρ' : G →* (F →L[ℂ] F)) (hρ' : IsContinuousRepresentation ρ') (j : E →L[ℂ] F)
    (hj : ∀ g x, j (ρ g x) = ρ' g (j x)) (w : Word G) :
    j.comp (wordOp μ ρ hρ w) = (wordOp μ ρ' hρ' w).comp j := by
  induction w with
  | nil => rfl
  | cons a w ih =>
    rw [wordOp_cons, wordOp_cons, ContinuousLinearMap.mul_def, ContinuousLinearMap.mul_def,
      ← ContinuousLinearMap.comp_assoc, ContinuousLinearMap.comp_assoc _ _ j, ← ih,
      ← ContinuousLinearMap.comp_assoc]
    congr 1
    rcases a with g | φ
    · ext x; exact hj g x
    · exact intertwiner_comp_testOp ρ hρ ρ' hρ' j hj φ.1 φ.2

/-- A closed invariant submodule is invariant under the word operators. -/
theorem wordOp_mem (ρ : G →* (E →L[ℂ] E)) (hρ : IsContinuousRepresentation ρ)
    (S : Submodule ℂ E) (hS : IsClosed (S : Set E)) (hSinv : ∀ g, ∀ v ∈ S, ρ g v ∈ S)
    (w : Word G) {v : E} (hv : v ∈ S) : wordOp μ ρ hρ w v ∈ S := by
  induction w with
  | nil => exact hv
  | cons a w ih =>
    rw [wordOp_cons, mul_apply_eq_comp]
    rcases a with g | φ
    · exact hSinv g _ ih
    · exact testOp_mem ρ hρ φ.1 φ.2 S hS hSinv ih

/-! ### The algebra -/

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The integrated operators of all test functions. -/
def testOps (μ : Measure G) [μ.IsHaarMeasure] (π : G →* (H →L[ℂ] H))
    (hπ : IsContinuousRepresentation π) : Set (H →L[ℂ] H) :=
  {T | ∃ φ : G → ℂ, ∃ hφ : IsTestFunction φ, T = testOp μ π hπ φ hφ}

/-- The closed unital `*`-subalgebra generated by the integrated test operators. -/
def algebra (μ : Measure G) [μ.IsHaarMeasure] (π : G →* (H →L[ℂ] H))
    (hπ : IsContinuousRepresentation π) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (testOps μ π hπ)).topologicalClosure

/-- The generators `π(φ) y`, `y ∈ algebra`, of the left ideal. -/
def leftGenerators (μ : Measure G) [μ.IsHaarMeasure] (π : G →* (H →L[ℂ] H))
    (hπ : IsContinuousRepresentation π) : Set (H →L[ℂ] H) :=
  {T | ∃ φ : G → ℂ, ∃ hφ : IsTestFunction φ, ∃ y ∈ algebra μ π hπ, T = testOp μ π hπ φ hφ * y}

/-- The closed subspace spanned by the products `π(φ) y`, `y ∈ algebra`. -/
def leftIdeal (μ : Measure G) [μ.IsHaarMeasure] (π : G →* (H →L[ℂ] H))
    (hπ : IsContinuousRepresentation π) : Submodule ℂ (H →L[ℂ] H) :=
  (Submodule.span ℂ (leftGenerators μ π hπ)).topologicalClosure

variable (π : G →* (H →L[ℂ] H)) (hπ : IsContinuousRepresentation π)

theorem algebra_isClosed : IsClosed (algebra μ π hπ : Set (H →L[ℂ] H)) :=
  StarSubalgebra.isClosed_topologicalClosure _

theorem leftIdeal_isClosed : IsClosed (leftIdeal μ π hπ : Set (H →L[ℂ] H)) :=
  Submodule.isClosed_topologicalClosure _

theorem testOp_mem_algebra (φ : G → ℂ) (hφ : IsTestFunction φ) :
    testOp μ π hπ φ hφ ∈ algebra μ π hπ :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨φ, hφ, rfl⟩)

theorem leftIdeal_le_algebra :
    (leftIdeal μ π hπ : Set (H →L[ℂ] H)) ⊆ algebra μ π hπ := by
  have h : Submodule.span ℂ (leftGenerators μ π hπ) ≤ (algebra μ π hπ).toSubalgebra.toSubmodule := by
    rw [Submodule.span_le]
    rintro _ ⟨φ, hφ, y, hy, rfl⟩
    exact (algebra μ π hπ).mul_mem (testOp_mem_algebra π hπ φ hφ) hy
  exact Submodule.topologicalClosure_minimal _ h (algebra_isClosed π hπ)

theorem testOp_mul_mem_leftIdeal (φ : G → ℂ) (hφ : IsTestFunction φ) {y : H →L[ℂ] H}
    (hy : y ∈ algebra μ π hπ) : testOp μ π hπ φ hφ * y ∈ leftIdeal μ π hπ :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨φ, hφ, y, hy, rfl⟩)

theorem testOp_mem_leftIdeal (φ : G → ℂ) (hφ : IsTestFunction φ) :
    testOp μ π hπ φ hφ ∈ leftIdeal μ π hπ := by
  simpa using testOp_mul_mem_leftIdeal π hπ φ hφ (algebra μ π hπ).one_mem

/-- A left multiplication preserving the generators preserves the left ideal. -/
theorem mul_mem_leftIdeal_of_generators (c : H →L[ℂ] H)
    (hc : ∀ T ∈ leftGenerators μ π hπ, c * T ∈ leftIdeal μ π hπ) {x : H →L[ℂ] H}
    (hx : x ∈ leftIdeal μ π hπ) : c * x ∈ leftIdeal μ π hπ := by
  let t : Submodule ℂ (H →L[ℂ] H) := (leftIdeal μ π hπ).comap (LinearMap.mulLeft ℂ c)
  have ht : IsClosed (t : Set (H →L[ℂ] H)) :=
    (leftIdeal_isClosed π hπ).preimage (continuous_const.mul continuous_id)
  have hspan : Submodule.span ℂ (leftGenerators μ π hπ) ≤ t := by
    rw [Submodule.span_le]
    intro T hT
    exact hc T hT
  exact Submodule.topologicalClosure_minimal _ hspan ht hx

variable (hπu : ∀ g, π g ∈ unitary (H →L[ℂ] H))
include hπu

theorem norm_map_rep (g : G) (v : H) : ‖π g v‖ = ‖v‖ :=
  ContinuousLinearMap.norm_map_of_mem_unitary (hπu g) v

theorem inner_rep_left (g : G) (u v : H) : ⟪π g u, v⟫_ℂ = ⟪u, π g⁻¹ v⟫_ℂ := by
  rw [← ContinuousLinearMap.inner_map_map_of_mem_unitary (hπu g) u (π g⁻¹ v),
    ← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]

theorem norm_rep_le (g : G) : ‖π g‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun v => by
    rw [norm_map_rep π hπu, one_mul]

/-- Left multiplication by `π(g)` preserves the left ideal. -/
theorem rep_mul_mem_leftIdeal (g : G) {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) :
    π g * x ∈ leftIdeal μ π hπ := by
  refine mul_mem_leftIdeal_of_generators π hπ (π g) ?_ hx
  rintro _ ⟨φ, hφ, y, hy, rfl⟩
  have h := comp_testOp (μ := μ) π hπ φ hφ g
  rw [← ContinuousLinearMap.mul_def] at h
  rw [← mul_assoc, h]
  exact testOp_mul_mem_leftIdeal π hπ _ _ hy

/-- Elements of the left ideal have norm-continuous left orbits. -/
theorem continuous_rep_mul {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) :
    Continuous fun g => π g * x := by
  let C : Submodule ℂ (H →L[ℂ] H) :=
    { carrier := {x | Continuous fun g => π g * x}
      add_mem' := fun {a b} ha hb => by
        have ha' : Continuous fun g => π g * a := ha
        have hb' : Continuous fun g => π g * b := hb
        change Continuous fun g => π g * (a + b)
        simp only [mul_add]
        exact ha'.add hb'
      zero_mem' := by
        change Continuous fun g => π g * 0
        simpa only [mul_zero] using continuous_const
      smul_mem' := fun c x hx => by
        have hx' : Continuous fun g => π g * x := hx
        change Continuous fun g => π g * (c • x)
        simp only [mul_smul_comm]
        exact hx'.const_smul c }
  have hC : IsClosed (C : Set (H →L[ℂ] H)) := by
    refine isClosed_of_closure_subset fun x hx => ?_
    change Continuous fun g => π g * x
    refine continuous_of_uniform_approx_of_continuous fun u hu => ?_
    obtain ⟨ε, hε, hεu⟩ := Metric.mem_uniformity_dist.mp hu
    obtain ⟨y, hyC, hxy⟩ := Metric.mem_closure_iff.mp hx ε hε
    refine ⟨fun g => π g * y, hyC, fun g => hεu ?_⟩
    calc dist (π g * x) (π g * y) = ‖π g * (x - y)‖ := by rw [dist_eq_norm, mul_sub]
      _ ≤ ‖π g‖ * ‖x - y‖ := norm_mul_le _ _
      _ ≤ 1 * ‖x - y‖ := mul_le_mul_of_nonneg_right (norm_rep_le π hπu g) (norm_nonneg _)
      _ < ε := by rw [one_mul, ← dist_eq_norm]; exact hxy
  have hspan : Submodule.span ℂ (leftGenerators μ π hπ) ≤ C := by
    rw [Submodule.span_le]
    rintro _ ⟨φ, hφ, y, -, rfl⟩
    change Continuous fun g => π g * (testOp μ π hπ φ hφ * y)
    simp only [← mul_assoc]
    exact (continuous_comp_testOp π hπ (norm_map_rep π hπu) φ hφ).mul continuous_const
  exact Submodule.topologicalClosure_minimal _ hspan hC hx

theorem integrable_smul_rep_mul {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) {φ : G → ℂ}
    (hφ : IsTestFunction φ) : Integrable (fun g => φ g • (π g * x)) μ := by
  refine (hφ.integrable.norm.mul_const ‖x‖).mono'
    (hφ.1.aestronglyMeasurable.smul (continuous_rep_mul π hπ hπu hx).aestronglyMeasurable)
    (Eventually.of_forall fun g => ?_)
  rw [norm_smul]
  exact mul_le_mul_of_nonneg_left ((norm_mul_le _ _).trans
    (by simpa using mul_le_mul_of_nonneg_right (norm_rep_le π hπu g) (norm_nonneg x)))
    (norm_nonneg _)

/-- `π(φ) x` as a Bochner integral of left translates. -/
theorem testOp_mul_eq_integral {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) (φ : G → ℂ)
    (hφ : IsTestFunction φ) :
    testOp μ π hπ φ hφ * x = ∫ g, φ g • (π g * x) ∂μ := by
  ext v
  rw [ContinuousLinearMap.integral_apply (integrable_smul_rep_mul π hπ hπu hx hφ),
    mul_apply_eq_comp, testOp_apply]
  rfl

/-- The adjoint of an integrated operator. -/
theorem star_testOp_apply (φ : G → ℂ) (hφ : IsTestFunction φ) (u : H) :
    star (testOp μ π hπ φ hφ) u = ∫ g, conj (φ g) • π g⁻¹ u ∂μ := by
  have hint : Integrable (fun g => conj (φ g) • π g⁻¹ u) μ := by
    refine (hφ.integrable.norm.mul_const ‖u‖).mono'
      ((Complex.continuous_conj.measurable.comp hφ.1).aestronglyMeasurable.smul
        ((continuous_orbit hπ u).comp continuous_inv).aestronglyMeasurable)
      (Eventually.of_forall fun g => ?_)
    rw [norm_smul, Complex.norm_conj, norm_map_rep π hπu]
  refine ext_inner_right ℂ fun w => ?_
  rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_left, testOp_apply]
  have h1 : ⟪u, ∫ g, φ g • π g w ∂μ⟫_ℂ = ∫ g, ⟪u, φ g • π g w⟫_ℂ ∂μ :=
    (ContinuousLinearMap.integral_comp_comm (innerSL ℂ u) (integrable_smul_orbit hπ hφ w)).symm
  have h2 : ⟪∫ g, conj (φ g) • π g⁻¹ u ∂μ, w⟫_ℂ = ∫ g, ⟪conj (φ g) • π g⁻¹ u, w⟫_ℂ ∂μ := by
    have h := ContinuousLinearMap.integral_comp_comm (innerSL ℂ w) hint
    simp only [innerSL_apply_apply] at h
    rw [← inner_conj_symm, ← h, ← integral_conj]
    refine integral_congr_ae (Eventually.of_forall fun g => ?_)
    simp only [inner_conj_symm]
  rw [h1, h2]
  refine integral_congr_ae (Eventually.of_forall fun g => ?_)
  simp only [inner_smul_right, inner_smul_left, Complex.conj_conj]
  rw [inner_rep_left π hπu, inv_inv]

theorem integrable_conj_smul_rep_inv_mul {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ)
    {φ : G → ℂ} (hφ : IsTestFunction φ) :
    Integrable (fun g => conj (φ g) • (π g⁻¹ * x)) μ := by
  refine (hφ.integrable.norm.mul_const ‖x‖).mono'
    ((Complex.continuous_conj.measurable.comp hφ.1).aestronglyMeasurable.smul
      ((continuous_rep_mul π hπ hπu hx).comp continuous_inv).aestronglyMeasurable)
    (Eventually.of_forall fun g => ?_)
  rw [norm_smul, Complex.norm_conj]
  exact mul_le_mul_of_nonneg_left ((norm_mul_le _ _).trans
    (by simpa using mul_le_mul_of_nonneg_right (norm_rep_le π hπu g⁻¹) (norm_nonneg x)))
    (norm_nonneg _)

/-- `π(φ)^* x` as a Bochner integral of left translates. -/
theorem star_testOp_mul_eq_integral {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) (φ : G → ℂ)
    (hφ : IsTestFunction φ) :
    star (testOp μ π hπ φ hφ) * x = ∫ g, conj (φ g) • (π g⁻¹ * x) ∂μ := by
  ext v
  rw [ContinuousLinearMap.integral_apply (integrable_conj_smul_rep_inv_mul π hπ hπu hx hφ),
    mul_apply_eq_comp, star_testOp_apply π hπ hπu]
  rfl

theorem star_testOp_mul_mem_leftIdeal {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ)
    (φ : G → ℂ) (hφ : IsTestFunction φ) :
    star (testOp μ π hπ φ hφ) * x ∈ leftIdeal μ π hπ := by
  rw [star_testOp_mul_eq_integral π hπ hπu hx]
  exact integral_smul_mem_of_continuous _ (leftIdeal_isClosed π hπ)
    (Complex.continuous_conj.measurable.comp hφ.1)
    ((continuous_rep_mul π hπ hπu hx).comp continuous_inv)
    (fun g => rep_mul_mem_leftIdeal π hπ hπu g⁻¹ hx)
    (integrable_conj_smul_rep_inv_mul π hπ hπu hx hφ)

/-- The left ideal is stable under left multiplication by the algebra. -/
theorem algebra_mul_mem_leftIdeal {c : H →L[ℂ] H} (hc : c ∈ algebra μ π hπ)
    {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) : c * x ∈ leftIdeal μ π hπ := by
  let M : Subalgebra ℂ (H →L[ℂ] H) :=
    { carrier := {c | ∀ x ∈ leftIdeal μ π hπ, c * x ∈ leftIdeal μ π hπ}
      mul_mem' := fun ha hb x hx => by rw [mul_assoc]; exact ha _ (hb x hx)
      add_mem' := fun ha hb x hx => by rw [add_mul]; exact Submodule.add_mem _ (ha x hx) (hb x hx)
      algebraMap_mem' := fun r x hx => by
        rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
        exact Submodule.smul_mem _ r hx }
  have hMclosed : IsClosed (M : Set (H →L[ℂ] H)) := by
    have : (M : Set (H →L[ℂ] H)) =
        ⋂ x ∈ leftIdeal μ π hπ, (fun c => c * x) ⁻¹' (leftIdeal μ π hπ : Set (H →L[ℂ] H)) := by
      ext c; simp [M]
    rw [this]
    exact isClosed_biInter fun x _ =>
      (leftIdeal_isClosed π hπ).preimage (continuous_id.mul continuous_const)
  have hgen : StarAlgebra.adjoin ℂ (testOps μ π hπ) ≤
      StarSubalgebra.topologicalClosure (StarAlgebra.adjoin ℂ (testOps μ π hπ)) := le_rfl.trans
      (StarSubalgebra.le_topologicalClosure _)
  have hadj : ((StarAlgebra.adjoin ℂ (testOps μ π hπ)) : Set (H →L[ℂ] H)) ⊆ M := by
    intro c hc'
    have : c ∈ (StarAlgebra.adjoin ℂ (testOps μ π hπ)).toSubalgebra := hc'
    rw [StarAlgebra.adjoin_toSubalgebra] at this
    refine (Algebra.adjoin_le ?_) this
    rintro _ (⟨φ, hφ, rfl⟩ | ⟨φ, hφ, hstar⟩)
    · intro x hx
      refine mul_mem_leftIdeal_of_generators π hπ _ ?_ hx
      rintro _ ⟨φ', hφ', y, hy, rfl⟩
      rw [← mul_assoc]
      exact testOp_mul_mem_leftIdeal π hπ φ hφ ((algebra μ π hπ).mul_mem
        (testOp_mem_algebra π hπ φ' hφ') hy)
    · intro x hx
      rename_i c₀
      have hc2 : c₀ = star (testOp μ π hπ φ hφ) := by
        rw [← hstar, star_star]
      rw [hc2]
      exact star_testOp_mul_mem_leftIdeal π hπ hπu hx φ hφ
  have hcl : (algebra μ π hπ : Set (H →L[ℂ] H)) ⊆ M := by
    rw [algebra, StarSubalgebra.topologicalClosure_coe]
    exact closure_minimal hadj hMclosed
  exact hcl hc x hx

/-- Word operators preserve the left ideal. -/
theorem wordOp_mul_mem_leftIdeal (w : Word G) {x : H →L[ℂ] H} (hx : x ∈ leftIdeal μ π hπ) :
    wordOp μ π hπ w * x ∈ leftIdeal μ π hπ := by
  induction w with
  | nil => simpa using hx
  | cons a w ih =>
    rw [wordOp_cons, mul_assoc]
    rcases a with g | φ
    · exact rep_mul_mem_leftIdeal π hπ hπu g ih
    · exact algebra_mul_mem_leftIdeal π hπ hπu (testOp_mem_algebra π hπ φ.1 φ.2) ih

end Langlands.Analysis.TemperedComponent
