import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.RepresentationTheory.Basic
import Mathlib.Topology.Algebra.Module.Basic

/-! # Irreducible subrepresentations and the discrete part of a representation

Getz–Hahn §9.1 (9.6) and §10.2: the discrete spectrum of a unitary representation on a Hilbert
space is the closed subspace generated by its irreducible subrepresentations, that is, by its
nonzero closed invariant subspaces without proper nonzero closed invariant subspaces. -/

noncomputable section

set_option autoImplicit false

namespace Langlands.Analysis

universe uH uE

variable {H : Type uH} [Monoid H] {E : Type uE} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- `V` is an irreducible subrepresentation of `ρ`: a nonzero closed `ρ`-invariant subspace whose
only closed `ρ`-invariant subspaces are `0` and `V`. -/
def IsIrreducibleSubrepresentation (ρ : Representation ℂ H E) (V : Submodule ℂ E) : Prop :=
  IsClosed (V : Set E) ∧ V ≠ ⊥ ∧ (∀ (h : H), ∀ x ∈ V, ρ h x ∈ V) ∧
    ∀ W : Submodule ℂ E, W ≤ V → IsClosed (W : Set E) → (∀ (h : H), ∀ x ∈ W, ρ h x ∈ W) →
      W = ⊥ ∨ W = V

/-- The discrete part of `ρ`: the closure of the sum of all irreducible subrepresentations. -/
def discretePart (ρ : Representation ℂ H E) : Submodule ℂ E :=
  (sSup {V : Submodule ℂ E | IsIrreducibleSubrepresentation ρ V}).topologicalClosure

end Langlands.Analysis
