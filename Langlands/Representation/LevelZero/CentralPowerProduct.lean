import Mathlib.Algebra.Group.Subgroup.Ker
import Mathlib.Algebra.Group.Center
import Mathlib.RepresentationTheory.Basic
import Mathlib.Basic.Complex.Basic

/-!
# The subgroup generated by a central element and a subgroup

For a central element `s` of a group `G` and a subgroup `K`, `(a, k) ↦ s ^ a * k` is a
homomorphism `ℤ × K → G`; its image is `powerProduct s K`. If `s ^ a ∈ K` implies `a = 0`
for every integer `a` (equivalently, `s` has infinite order and its cyclic subgroup meets `K`
only in the identity), this homomorphism is injective, so its image is the internal direct
product of `⟨s⟩ ≅ ℤ` and `K`. Under the same hypothesis a representation of `K` extends to
this image, with `s` acting trivially.
-/

noncomputable section

namespace Langlands.LevelZero

universe uG uV

variable {G : Type uG} [Group G] (s : G) (hs : s ∈ Subgroup.center G) (K : Subgroup G)

/-- The homomorphism `(a, k) ↦ s ^ a * k`, a homomorphism because `s` is central. -/
def powerProductHom : Multiplicative ℤ × K →* G where
  toFun x := s ^ (Multiplicative.toAdd x.1) * (x.2 : G)
  map_one' := by simp
  map_mul' x y := by
    have hc : ∀ g : G, s * g = g * s := fun g => (Subgroup.mem_center_iff.mp hs g).symm
    have hz : ∀ (a : ℤ) (g : G), s ^ a * g = g * s ^ a := fun a g =>
      ((Commute.zpow_left (hc g) a))
    simp only [Prod.fst_mul, Prod.snd_mul, toAdd_mul, Subgroup.coe_mul, zpow_add]
    rw [mul_assoc, mul_assoc, ← mul_assoc (s ^ Multiplicative.toAdd y.1),
      hz (Multiplicative.toAdd y.1) (x.2 : G), mul_assoc (x.2 : G)]

/-- The subgroup `⟨s⟩ K`. -/
def powerProduct : Subgroup G := (powerProductHom s hs K).range

theorem powerProductHom_apply (a : Multiplicative ℤ) (k : K) :
    powerProductHom s hs K (a, k) = s ^ (Multiplicative.toAdd a) * (k : G) := rfl

theorem mem_powerProduct_of_mem {k : G} (hk : k ∈ K) : k ∈ powerProduct s hs K :=
  ⟨(1, ⟨k, hk⟩), by simp [powerProductHom_apply]⟩

theorem le_powerProduct : K ≤ powerProduct s hs K := fun _ hk => mem_powerProduct_of_mem s hs K hk

theorem zpow_mul_mem_powerProduct (a : ℤ) {k : G} (hk : k ∈ K) :
    s ^ a * k ∈ powerProduct s hs K :=
  ⟨(Multiplicative.ofAdd a, ⟨k, hk⟩), rfl⟩

theorem zpow_mem_powerProduct (a : ℤ) : s ^ a ∈ powerProduct s hs K := by
  simpa using zpow_mul_mem_powerProduct s hs K a K.one_mem

variable {s K}

/-- The homomorphism `(a, k) ↦ s ^ a * k` is injective when `s ^ a ∈ K` implies `a = 0` for
every integer `a`, that is, when `s` has infinite order and `⟨s⟩ ∩ K = 1`. -/
theorem powerProductHom_injective (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0) :
    Function.Injective (powerProductHom s hs K) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  rintro ⟨a, k⟩ h
  change s ^ (Multiplicative.toAdd a) * (k : G) = 1 at h
  have hsa : s ^ (Multiplicative.toAdd a) = (k : G)⁻¹ := eq_inv_of_mul_eq_one_left h
  have ha : Multiplicative.toAdd a = 0 := hK _ (hsa ▸ K.inv_mem k.property)
  have hk : (k : G) = 1 := by simpa [ha] using h
  have ha' : a = 1 := by
    rw [← ofAdd_toAdd a, ha]
    rfl
  change (a, k) = 1
  rw [ha', show k = 1 from Subtype.ext hk]
  rfl

/-- The product decomposition of `⟨s⟩ K`. -/
def powerProductEquiv (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0) :
    Multiplicative ℤ × K ≃* powerProduct s hs K :=
  MonoidHom.ofInjective (powerProductHom_injective hs hK)

theorem powerProductEquiv_symm_apply (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0) (a : ℤ) (k : K) :
    (powerProductEquiv hs hK).symm ⟨s ^ a * (k : G), zpow_mul_mem_powerProduct s hs K a k.2⟩ =
      (Multiplicative.ofAdd a, k) := by
  apply (powerProductEquiv hs hK).injective
  rw [MulEquiv.apply_symm_apply]
  rfl

variable {V : Type uV} [AddCommGroup V] [Module ℂ V]

/-- The extension of a representation of `K` to `⟨s⟩ K`, with `s` acting trivially. -/
def extendRepresentation (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0) (ρ : Representation ℂ K V) :
    Representation ℂ (powerProduct s hs K) V :=
  ρ.comp ((MonoidHom.snd _ _).comp (powerProductEquiv hs hK).symm.toMonoidHom)

theorem extendRepresentation_zpow_mul (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0)
    (ρ : Representation ℂ K V) (a : ℤ) (k : K) :
    extendRepresentation hs hK ρ ⟨s ^ a * (k : G), zpow_mul_mem_powerProduct s hs K a k.2⟩ =
      ρ k := by
  simp only [extendRepresentation, MonoidHom.coe_comp, Function.comp_apply,
    MulEquiv.coe_toMonoidHom, powerProductEquiv_symm_apply, MonoidHom.coe_snd]

theorem extendRepresentation_of_mem (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0)
    (ρ : Representation ℂ K V) (k : K) :
    extendRepresentation hs hK ρ ⟨k, le_powerProduct s hs K k.2⟩ = ρ k := by
  have h := extendRepresentation_zpow_mul hs hK ρ 0 k
  simpa using h

theorem extendRepresentation_zpow (hK : ∀ a : ℤ, s ^ a ∈ K → a = 0)
    (ρ : Representation ℂ K V) (a : ℤ) :
    extendRepresentation hs hK ρ ⟨s ^ a, zpow_mem_powerProduct s hs K a⟩ = 1 := by
  have h := extendRepresentation_zpow_mul hs hK ρ a 1
  simpa using h

end Langlands.LevelZero
