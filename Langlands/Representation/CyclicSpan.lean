import Langlands.Representation.FiniteVectors

/-! # Cyclic subrepresentations and their group-algebra presentations -/

noncomputable section

namespace Langlands.Cyclic

universe uK uG uV uW

variable {K : Type uK} [Field K] {G : Type uG} [Monoid G]
variable {V : Type uV} [AddCommGroup V] [Module K V]
variable {W : Type uW} [AddCommGroup W] [Module K W]

/-- The subrepresentation generated by a single vector. -/
abbrev orbitSpan (ρ : Representation K G V) (v : V) : Subrepresentation ρ :=
  Langlands.FiniteVectors.orbitSubrepresentation ρ v

variable (ρ : Representation K G V) (v : V)

theorem mem_orbitSpan : v ∈ orbitSpan ρ v :=
  Langlands.FiniteVectors.self_mem_orbitSpan ρ v

theorem orbitSpan_le {P : Subrepresentation ρ} (hv : v ∈ P) : orbitSpan ρ v ≤ P :=
  Langlands.FiniteVectors.orbitSpan_le ρ v P hv

/-- The distinguished vector in its cyclic subrepresentation. -/
def generator : (orbitSpan ρ v).toSubmodule := ⟨v, mem_orbitSpan ρ v⟩

@[simp] theorem generator_val : (generator ρ v : V) = v := rfl

@[simp] theorem generator_ne_zero : generator ρ v ≠ 0 ↔ v ≠ 0 := by
  constructor
  · intro h hv
    apply h
    exact Subtype.ext hv
  · intro h hv
    exact h (congrArg Subtype.val hv)

/-- The inclusion of the cyclic subrepresentation. -/
def inclusion : (orbitSpan ρ v).toRepresentation.IntertwiningMap ρ where
  toLinearMap := (orbitSpan ρ v).toSubmodule.subtype
  isIntertwining' _ := LinearMap.ext fun _ => rfl

@[simp] theorem inclusion_apply (x : (orbitSpan ρ v).toSubmodule) : inclusion ρ v x = x := rfl

/-- Evaluate the group algebra on the chosen vector in the ambient representation. -/
def algebraEvaluation : MonoidAlgebra K G →ₗ[K] V where
  toFun a := ρ.asAlgebraHom a v
  map_add' a b := by simp
  map_smul' c a := by simp

@[simp] theorem algebraEvaluation_single (g : G) (c : K) :
    algebraEvaluation ρ v (MonoidAlgebra.single g c) = c • ρ g v := by
  simp [algebraEvaluation, Representation.asAlgebraHom_single]

theorem range_algebraEvaluation : LinearMap.range (algebraEvaluation ρ v) =
    (orbitSpan ρ v).toSubmodule := by
  apply le_antisymm
  · rintro _ ⟨a, rfl⟩
    induction a using MonoidAlgebra.induction_linear with
    | zero => simp
    | add a b ha hb =>
      rw [map_add]
      exact Submodule.add_mem _ ha hb
    | single g c =>
      rw [algebraEvaluation_single]
      exact Submodule.smul_mem _ c (Submodule.subset_span ⟨g, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨g, rfl⟩
    exact ⟨MonoidAlgebra.single g 1, by simp⟩

/-- The surjective presentation of the cyclic subrepresentation by the group algebra. -/
def presentation : MonoidAlgebra K G →ₗ[K] (orbitSpan ρ v).toSubmodule :=
  (algebraEvaluation ρ v).codRestrict _ fun a => by
    rw [← range_algebraEvaluation]
    exact LinearMap.mem_range_self _ a

@[simp] theorem presentation_val (a : MonoidAlgebra K G) :
    (presentation ρ v a : V) = ρ.asAlgebraHom a v := rfl

theorem presentation_surjective : Function.Surjective (presentation ρ v) := by
  intro x
  have hx : (x : V) ∈ LinearMap.range (algebraEvaluation ρ v) := by
    rw [range_algebraEvaluation]
    exact x.prop
  obtain ⟨a, ha⟩ := hx
  exact ⟨a, Subtype.ext ha⟩

/-- An intertwiner maps one cyclic subrepresentation to the cyclic subrepresentation
of the image of its generator. -/
def map {σ : Representation K G W} (f : ρ.IntertwiningMap σ) :
    (orbitSpan ρ v).toRepresentation.IntertwiningMap
      (orbitSpan σ (f v)).toRepresentation where
  toLinearMap := (f.toLinearMap.comp (orbitSpan ρ v).toSubmodule.subtype).codRestrict _ fun x => by
    rcases x with ⟨x, hx⟩
    change f x ∈ (orbitSpan σ (f v)).toSubmodule
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨g, rfl⟩ := hx
      change f (ρ g v) ∈ Submodule.span K _
      rw [Representation.IntertwiningMap.isIntertwining ρ σ f]
      exact Submodule.subset_span ⟨g, rfl⟩
    | zero => simp
    | add x y _ _ hx hy => simpa using Submodule.add_mem _ hx hy
    | smul c x _ hx => simpa using Submodule.smul_mem _ c hx
  isIntertwining' g := LinearMap.ext fun x => Subtype.ext (Representation.IntertwiningMap.isIntertwining ρ σ f g x)

@[simp] theorem map_generator {σ : Representation K G W} (f : ρ.IntertwiningMap σ) :
    map ρ v f (generator ρ v) = generator σ (f v) := rfl

end Langlands.Cyclic
