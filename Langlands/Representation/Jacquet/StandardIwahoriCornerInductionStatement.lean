import Langlands.Representation.Jacquet.StandardIwahoriDecompositionStatements
import Langlands.Representation.Hecke.NondegenerateModuleFunctor
import Langlands.Representation.Hecke.HomomorphismLeft
import Langlands.Representation.Plancherel.RationalTwistStabilizer
import Langlands.Algebra.NonUnitalModuleCornerInduction

/-! # Renard VI.10.6, Proposition (ii): the inverse of `V ↦ V^K`

Statement only. Renard 2026, VI.10.6, Proposition (ii) (printed p.214 / PDF p.220), which
completes the VI.9.4 Proposition (printed p.201 / PDF p.207): for a compact open subgroup `K`,
contained and normal in `K₀`, with an Iwahori decomposition along every standard parabolic,
the functor `V ↦ V^K` is an equivalence from the representations generated by their
`K`-fixed vectors onto the unital modules over the Haar-measure Hecke algebra
`H(G, K) = e_K ∗ H(G) ∗ e_K`, with inverse `M ↦ H(G) ⊗_{H(G,K)} M`.
-/

noncomputable section

universe uF uV

open CategoryTheory AlgebraicGeometry MeasureTheory
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme
open Langlands.AlgebraicGeometry.PointTopology
open Langlands.BruhatTits.SpecialCompact

namespace Langlands.Jacquet

/-- Renard VI.10.6, Proposition (ii), and the VI.9.4 Proposition with Renard's Hecke algebra:
let `K` be as in `StandardIwahoriFixedVectorHeckeEquivalenceStatement`, `haar` a left Haar
measure on `G(F)`, `e_K` the normalized indicator of `K` (an idempotent of the Haar Hecke
algebra `H(G) = Hecke.HeckeAlgebra haar`) and `H(G, K) = e_K H(G) e_K` its corner. Then there is
an equivalence `E` from the full subcategory of smooth representations generated by their
`K`-fixed vectors onto unital `H(G, K)`-modules such that

* `E.functor` is `V ↦ V^K`: the representation, then its nondegenerate `H(G)`-module (Renard
  III.1.4), then the `e_K`-fixed part `e_K · V = V^K` as an `H(G, K)`-module;
* the `H(G)`-module of `E.inverse M` is naturally isomorphic to the induced nondegenerate
  module `H(G) ⊗_{H(G,K)} M` of I.3.2.

Carriers live in the universe `max uF uV`, which contains the induced modules. -/
def StandardIwahoriCornerInductionEquivalenceStatement : Prop :=
  ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    letI : IsAffineHom G.X.hom := hG.isAffineHom
    letI : Smooth G.X.hom := hG.smooth
    letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    letI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    haveI : T2Space F := Langlands.BruhatTits.localField_t2Space F
    haveI : T2Space (rationalPoints G) := rationalPoint_t2Space F G
    haveI : LocallyCompactSpace (rationalPoints G) := rationalPoint_locallyCompactSpace F G
    haveI : NonarchimedeanGroup (rationalPoints G) :=
      Langlands.Plancherel.rationalPoints_nonarchimedeanGroup G
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G)
      (_hi : IsMaximalSplitTorus i) (ν : cocharacterLattice S)
      (_hν : IsGenericCocharacter i ν)
      (_hstandard : ∀ J ⊆ simpleRelativeRoots i ν, ∃ zeta, IsStandardCocharacter i ν J zeta)
      (K₀ : Subgroup (rationalPoints G)) (_hK₀ : IsCompact (K₀ : Set (rationalPoints G)))
      (_hIwasawa : ∀ g : rationalPoints G, ∃ m ∈ standardLeviPoints i ν ∅,
        ∃ n ∈ standardUnipotentPoints i ν ∅, ∃ k ∈ K₀, g = m * n * k)
      (K : OpenSubgroup (rationalPoints G)) (hK : IsCompact (K : Set (rationalPoints G)))
      (_hKK₀ : K.toSubgroup ≤ K₀) (_hnormal : K₀ ≤ Subgroup.normalizer K.toSubgroup)
      (_hIwahori : ∀ J ⊆ simpleRelativeRoots i ν,
        HasIwahoriIntersectionDecomposition K.toSubgroup (standardLeviPoints i ν J)
          (standardUnipotentPoints i ν J) (standardOppositeUnipotentPoints i ν J))
      [MeasurableSpace (rationalPoints G)] [BorelSpace (rationalPoints G)]
      (haar : Measure (rationalPoints G)) [haar.IsHaarMeasure],
      let P : ObjectProperty (SmoothRep.{0, uF, max uF uV} ℂ (rationalPoints G)) := fun V =>
        ∀ T : Subrepresentation V.representation,
          fixedVectors V.representation K.toSubgroup ≤ T.toSubmodule → T = ⊤
      let e : Algebra.Idempotent (Hecke.HeckeAlgebra haar) :=
        ⟨Hecke.HeckeAlgebra.normalizedIndicator haar K hK,
          Hecke.HeckeAlgebra.normalizedIndicator_idempotent haar K hK⟩
      ∃ E : P.FullSubcategory ≌ ModuleCat.{max uF uV} (Algebra.Idempotent.Corner e),
        E.functor = P.ι ⋙ Hecke.heckeNondegenerateModuleFunctor.{uF, max uF uV} haar ⋙
          Algebra.NonUnitalModuleCorner.nondegenerateFunctor e ∧
        Nonempty (E.inverse ⋙ P.ι ⋙ Hecke.heckeNondegenerateModuleFunctor.{uF, max uF uV} haar ≅
          Algebra.NonUnitalModuleCornerInduction.nondegenerateFunctor
            (Hecke.Homomorphism.isIdempotented haar) e)

end Langlands.Jacquet
