import Langlands.Representation.Jacquet.StandardIwahoriDecompositionStatements
import Langlands.Representation.Jacquet.StandardIwahoriSubquotientGenerationReduction
import Langlands.BruhatTits.SpecialCompact.JointBasisProof

/-! # Renard VI.9.4 Corollary with the Iwahori hypothesis: proof

Every smooth subquotient of a smooth complex representation generated by its `K`-fixed
vectors is generated by its `K`-fixed vectors, for every compact open `K` contained and
normal in a compact `K₀` with the minimal-parabolic Iwasawa factorization and with an
ordered Iwahori decomposition along every standard parabolic. -/

universe uF uV

namespace Langlands.Jacquet

/-- Renard, *Représentations des groupes réductifs p-adiques*, VI.9.4 Corollary, with the
source's Iwahori hypothesis on `K`: for a compact open `K` contained and normal in `K₀`,
with an Iwahori decomposition along every standard parabolic, every smooth subquotient of
a smooth complex representation generated by its `K`-fixed vectors is generated by its
`K`-fixed vectors. The published reduction from the joint special-compact basis existence
is applied to its published proof. -/
theorem standardIwahoriFixedVectorSubquotientGeneration :
    StandardIwahoriFixedVectorSubquotientGenerationStatement.{uF, uV} :=
  standardIwahoriFixedVectorSubquotientGeneration_of_jointBasis
    Langlands.BruhatTits.SpecialCompact.jointSpecialCompactBasisExistence

end Langlands.Jacquet
