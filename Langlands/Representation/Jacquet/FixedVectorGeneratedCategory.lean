import Langlands.Representation.Category.FiniteGenerationCoproducts
import Langlands.Representation.Smooth.FixedVectors.LawsProof
import Mathlib.CategoryTheory.Preadditive.Biproducts

/-! # The full category generated by fixed vectors -/

noncomputable section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject

universe uG uV uW uI

namespace Langlands.Jacquet

variable {G : Type uG} [Group G] [TopologicalSpace G] (K : Subgroup G)

/-- The actual invariant-submodule criterion for generation by fixed vectors. -/
def fixedVectorGenerated : ObjectProperty (SmoothRep.{0,uG,uV} ℂ G) := fun V =>
  ∀ S : Subrepresentation V.representation,
    fixedVectors V.representation K ≤ S.toSubmodule → S = ⊤

/-- The inverse image of an invariant submodule under an intertwiner. -/
def fixedVectorComap {V : Type uV} {W : Type uW}
    [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
    {ρ : Representation ℂ G V} {σ : Representation ℂ G W}
    (f : ρ.IntertwiningMap σ) (S : Subrepresentation σ) : Subrepresentation ρ where
  toSubmodule := S.toSubmodule.comap f.toLinearMap
  apply_mem_toSubmodule g v hv := by
    change f (ρ g v) ∈ S
    rw [f.isIntertwining]
    exact S.apply_mem_toSubmodule g hv

/-- If a subrepresentation contains the images of all fixed vectors of a
fixed-vector-generated source, it contains the entire image. -/
theorem fixedVectorGenerated_image_le
    {V : SmoothRep.{0,uG,uV} ℂ G} {W : SmoothRep.{0,uG,uW} ℂ G}
    (hV : fixedVectorGenerated K V)
    (f : V.representation.IntertwiningMap W.representation)
    (S : Subrepresentation W.representation)
    (hS : ∀ v ∈ fixedVectors V.representation K, f v ∈ S) (v : V) : f v ∈ S := by
  have h : fixedVectorComap f S = ⊤ := hV _ hS
  have hv : v ∈ fixedVectorComap f S := by rw [h]; trivial
  exact hv

/-- Fixed-vector generation passes through an arbitrary surjective intertwiner. -/
theorem fixedVectorGenerated_of_surjective
    {V : SmoothRep.{0,uG,uV} ℂ G} {W : SmoothRep.{0,uG,uW} ℂ G}
    (hV : fixedVectorGenerated K V)
    (f : V.representation.IntertwiningMap W.representation) (hf : Function.Surjective f) :
    fixedVectorGenerated K W := by
  intro S hS
  apply top_unique
  intro w _
  obtain ⟨v, rfl⟩ := hf w
  exact fixedVectorGenerated_image_le K hV f S
    (fun v hv => hS (map_mem_fixedVectors f hv)) v

instance fixedVectorGenerated_isClosedUnderQuotients :
    (fixedVectorGenerated.{uG,uV} K).IsClosedUnderQuotients where
  prop_of_epi f _ hV := fixedVectorGenerated_of_surjective K hV
    (SmoothRep.hom f) ((SmoothRep.epi_iff_surjective f).mp inferInstance)

instance fixedVectorGenerated_containsZero :
    (fixedVectorGenerated.{uG,uV} K).ContainsZero where
  exists_zero := by
    refine ⟨0, isZero_zero _, ?_⟩
    intro S hS
    apply top_unique
    intro v _
    have hv : v = 0 := by
      have h := congrArg (fun f : (0 : SmoothRep.{0,uG,uV} ℂ G) ⟶ 0 => SmoothRep.hom f v)
        ((isZero_zero (SmoothRep.{0,uG,uV} ℂ G)).eq_of_src (𝟙 _) 0)
      exact h
    rw [hv]
    exact S.toSubmodule.zero_mem

/-- An actual direct sum is generated by fixed vectors whenever its summands are. -/
theorem fixedVectorGenerated_directSum {I : Type uI} [DecidableEq I]
    (A : I → SmoothRep.{0,uG,max uI uV} ℂ G)
    (hA : ∀ i, fixedVectorGenerated K (A i)) :
    fixedVectorGenerated K (SmoothRep.directSum A) := by
  intro S hS
  apply top_unique
  intro v hv
  clear hv
  induction v using DirectSum.induction_on with
  | zero => exact S.toSubmodule.zero_mem
  | add v w hv hw => exact S.toSubmodule.add_mem hv hw
  | of i v =>
      exact fixedVectorGenerated_image_le K (hA i) (SmoothRep.hom (SmoothRep.directSumι A i))
        S (fun v hv => hS (map_mem_fixedVectors _ hv)) v

/-- The full subcategory has actual coproducts of the carrier-universe size. -/
instance fixedVectorGenerated_hasCoproducts :
    HasCoproducts.{uV} (fixedVectorGenerated.{uG,uV} K).FullSubcategory := by
  classical
  exact hasCoproducts_of_colimit_cofans
    (fun B => SmoothRep.fullSubcategoryDirectSumCofan _ B
      (fixedVectorGenerated_directSum K _ (fun i => (B i).property)))
    (fun B => SmoothRep.fullSubcategoryDirectSumIsColimit _ B
      (fixedVectorGenerated_directSum K _ (fun i => (B i).property)))

/-- Closure under actual direct sums implies closure under all isomorphic coproducts. -/
instance fixedVectorGenerated_isClosedUnderCoproducts (I : Type uI) :
    (fixedVectorGenerated.{uG,max uI uV} K).IsClosedUnderColimitsOfShape (Discrete I) := by
  classical
  apply ObjectProperty.IsClosedUnderColimitsOfShape.mk'
  rintro _ ⟨F, hF⟩
  let A := fun i : I => F.obj ⟨i⟩
  let c := (Cocone.precompose (Discrete.natIsoFunctor (F := F)).hom).obj
    (SmoothRep.directSumCofan A)
  have hc : IsColimit c := (IsColimit.precomposeHomEquiv _ _).symm
    (SmoothRep.directSumIsColimit A)
  exact (fixedVectorGenerated K).prop_of_iso
    (hc.coconePointUniqueUpToIso (colimit.isColimit F))
    (fixedVectorGenerated_directSum K A (fun i => hF ⟨i⟩))

/-- Binary products are binary coproducts in the ambient preadditive category. -/
instance fixedVectorGenerated_isClosedUnderBinaryProducts :
    (fixedVectorGenerated.{uG,uV} K).IsClosedUnderBinaryProducts := by
  apply ObjectProperty.IsClosedUnderLimitsOfShape.mk'
  rintro _ ⟨F, hF⟩
  let X := F.obj ⟨WalkingPair.left⟩
  let Y := F.obj ⟨WalkingPair.right⟩
  let b := BinaryBicone.ofLimitCone (limit.isLimit (pair X Y))
  have hb := binaryBiconeIsBilimitOfLimitConeOfIsLimit (limit.isLimit (pair X Y))
  have hprod : fixedVectorGenerated K (X ⨯ Y) :=
    (fixedVectorGenerated K).prop_of_isColimit_binaryCofan hb.isColimit
      (hF ⟨WalkingPair.left⟩) (hF ⟨WalkingPair.right⟩)
  exact (fixedVectorGenerated K).prop_of_iso
    (HasLimit.isoOfNatIso (diagramIsoPair F)).symm hprod

instance fixedVectorGenerated_isClosedUnderFiniteProducts :
    (fixedVectorGenerated.{uG,uV} K).IsClosedUnderFiniteProducts :=
  ObjectProperty.IsClosedUnderFiniteProducts.mk'

/-- Subobject closure is the sole extra input needed for abelianness. -/
instance fixedVectorGenerated_abelian
    [(fixedVectorGenerated.{uG,uV} K).IsClosedUnderSubobjects] :
    Abelian (fixedVectorGenerated.{uG,uV} K).FullSubcategory := inferInstance

end Langlands.Jacquet
