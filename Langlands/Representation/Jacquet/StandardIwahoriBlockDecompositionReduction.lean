import Langlands.Representation.Jacquet.BernsteinFixedVectorSplitting
import Langlands.Representation.Jacquet.IrreducibleFixedVectorGeneration
import Langlands.Representation.Category.SpanningDisjointCoproduct
import Langlands.Representation.Category.DecompositionCentralProjectors

/-! # The fixed-level block decomposition from the Bernstein decomposition and visibility -/

noncomputable section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology Langlands.GroupScheme
open Langlands.CuspidalSupport Langlands.Aubert.General.RationalPointFamily
open scoped CategoryTheory.MonObj

universe uF uV

namespace Langlands.Jacquet

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  [LocallyOfFiniteType G.X.hom]
  {T : CommGroupScheme (Spec (CommRingCat.of F))}
  (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)

local instance standardIwahoriBlockAffine : IsAffine G.X.left :=
  isAffine_of_isAffineHom G.X.hom
local instance standardIwahoriBlockTopology : TopologicalSpace (rationalPoints G) :=
  pointTopology

variable [LocallyCompactSpace (rationalPoints G)] [NonarchimedeanGroup (rationalPoints G)]
  (family : BernsteinStandardFamily i ν) (K : OpenSubgroup (rationalPoints G))

/-- The inertial classes `B(G)_K`: some irreducible smooth representation with that inertial
support has a nonzero `K`-fixed vector. -/
abbrev bernsteinFixedClass (s : BernsteinInertialClass.{uF, max uF uV} i ν family) : Prop :=
  ∃ π : SmoothRep.{0, uF, max uF uV} ℂ (rationalPoints G),
    IsBernsteinInertialSupport i ν family s π ∧
      Nontrivial (fixedVectors π.representation K.toSubgroup)

/-- Under fixed-vector visibility, every nonzero object of the block of a class in `B(G)_K`
has a nonzero `K`-fixed vector. -/
theorem nontrivial_fixedVectors_of_bernsteinBlock
    (hK : IsCompact (K : Set (rationalPoints G)))
    (hvis : bernsteinFixedVectorVisibility.{uF, uV} i ν family K)
    (s : BernsteinInertialClass.{uF, max uF uV} i ν family)
    (hs : bernsteinFixedClass.{uF, uV} i ν family K s)
    (Y : SmoothRep.{0, uF, uV} ℂ (rationalPoints G))
    (hY : bernsteinBlockProperty.{uF, uV} i ν family s Y) [Nontrivial Y] :
    Nontrivial (fixedVectors Y.representation K.toSubgroup) := by
  obtain ⟨π, hπ, hπK⟩ := hs
  obtain ⟨v, hv⟩ := exists_ne (0 : Y)
  obtain ⟨K', hK'⟩ := Y.isSmooth v
  have hY' : Nontrivial (fixedVectors Y.representation K'.toSubgroup) :=
    ⟨⟨⟨v, hK'⟩, 0, fun h => hv (congrArg Subtype.val h)⟩⟩
  obtain ⟨D, hD, hDY, -⟩ :=
    SmoothRep.hasFixedVectorConstituent_of_nontrivial Y K'.toSubgroup hY'
  have hDlift := (hvis s π (SmoothRep.universeLift.{uF} D) hπ (hY D hD hDY)).mp hπK
  have hDfix : Nontrivial (fixedVectors D.representation K.toSubgroup) :=
    (fixedVectorsEquiv (SmoothRep.universeLiftEquiv.{uF} D)
      K.toSubgroup).toEquiv.nontrivial_congr.mpr hDlift
  exact SmoothRep.nontrivial_fixedVectors_of_isSubquotient K hK hDY hDfix

/-- Under fixed-vector visibility, every object of the block of a class in `B(G)_K` is
generated by its `K`-fixed vectors. -/
theorem fixedVectorGenerated_of_bernsteinBlock
    (hK : IsCompact (K : Set (rationalPoints G)))
    (hvis : bernsteinFixedVectorVisibility.{uF, uV} i ν family K)
    (s : BernsteinInertialClass.{uF, max uF uV} i ν family)
    (hs : bernsteinFixedClass.{uF, uV} i ν family K s)
    (Y : SmoothRep.{0, uF, uV} ℂ (rationalPoints G))
    (hY : bernsteinBlockProperty.{uF, uV} i ν family s Y) :
    fixedVectorGenerated K.toSubgroup Y := by
  rcases bernsteinBlock_fixedVector_dichotomy i ν family K hK hvis s Y hY with h | h
  · exact h
  · intro S _
    rcases subsingleton_or_nontrivial Y with hY0 | hY0
    · apply top_unique
      intro v _
      rw [Subsingleton.elim v 0]
      exact S.toSubmodule.zero_mem
    · exact absurd h (Submodule.nontrivial_iff_ne_bot.mp
        (nontrivial_fixedVectors_of_bernsteinBlock i ν family K hK hvis s hs Y hY))

/-- Renard VI.10.6 (i), direction (⇐), from visibility: the vertex of a coproduct of objects
of the blocks `M(G)_𝔰`, `𝔰 ∈ B(G)_K`, is generated by its `K`-fixed vectors. -/
theorem fixedVectorGenerated_of_isCoproductOfFixedClasses
    (hK : IsCompact (K : Set (rationalPoints G)))
    (hvis : bernsteinFixedVectorVisibility.{uF, uV} i ν family K)
    (V : SmoothRep.{0, uF, uV} ℂ (rationalPoints G))
    (hV : Renard.IsCoproductOfComponents
      (fun s : {s : BernsteinInertialClass.{uF, max uF uV} i ν family //
          bernsteinFixedClass.{uF, uV} i ν family K s} =>
        bernsteinBlockProperty.{uF, uV} i ν family s.1) V) :
    fixedVectorGenerated K.toSubgroup V := by
  obtain ⟨Y, inj, hY, ⟨hc⟩⟩ := hV
  intro S hS
  have hrange : ∀ t, (SmoothRep.hom (inj t)).range ≤ S := by
    rintro t _ ⟨w, rfl⟩
    exact fixedVectorGenerated_image_le K.toSubgroup
      (fixedVectorGenerated_of_bernsteinBlock i ν family K hK hvis t.1 t.2 (Y t) (hY t))
      (SmoothRep.hom (inj t)) S (fun v hv => hS (map_mem_fixedVectors _ hv)) w
  have htop := SmoothRep.iSup_range_cofan_eq_top Y (Cofan.mk V inj) hc
  exact top_unique (htop ▸ iSup_le hrange)

/-- In a coproduct of block objects whose vertex is generated by its `K`-fixed vectors, the
component of a class outside `B(G)_K` is zero. -/
theorem subsingleton_of_isCoproduct_of_not_bernsteinFixedClass
    {V : SmoothRep.{0, uF, uV} ℂ (rationalPoints G)}
    (hV : fixedVectorGenerated K.toSubgroup V)
    {A : BernsteinInertialClass.{uF, max uF uV} i ν family →
      SmoothRep.{0, uF, uV} ℂ (rationalPoints G)}
    {inj : ∀ s, A s ⟶ V} (hc : IsColimit (Cofan.mk V inj))
    (hA : ∀ s, bernsteinBlockProperty.{uF, uV} i ν family s (A s))
    (s : BernsteinInertialClass.{uF, max uF uV} i ν family)
    (hs : ¬ bernsteinFixedClass.{uF, uV} i ν family K s) :
    Subsingleton (A s) := by
  classical
  have hfix : fixedVectors (A s).representation K.toSubgroup = ⊥ := by
    by_contra hne
    have hnt : Nontrivial (fixedVectors (A s).representation K.toSubgroup) :=
      Submodule.nontrivial_iff_ne_bot.mpr hne
    obtain ⟨D, hD, hDA, hDfix⟩ :=
      SmoothRep.hasFixedVectorConstituent_of_nontrivial (A s) K.toSubgroup hnt
    exact hs ⟨SmoothRep.universeLift.{uF} D, hA s D hD hDA,
      (fixedVectorsEquiv (SmoothRep.universeLiftEquiv.{uF} D)
        K.toSubgroup).toEquiv.nontrivial_congr.mp hDfix⟩
  have hsurj : Function.Surjective (SmoothRep.hom (SmoothRep.cofanProjection hc s)) := by
    intro w
    refine ⟨SmoothRep.hom (inj s) w, ?_⟩
    exact congrArg (fun f => SmoothRep.hom f w) (SmoothRep.inj_cofanProjection_self hc s)
  have hgen : fixedVectorGenerated K.toSubgroup (A s) :=
    fixedVectorGenerated_of_surjective K.toSubgroup hV _ hsurj
  have hbot := hgen ⊥ (by rw [hfix]; exact bot_le)
  refine ⟨fun v w => ?_⟩
  have hv : v ∈ (⊥ : Subrepresentation (A s).representation).toSubmodule := by
    rw [hbot]; trivial
  have hw : w ∈ (⊥ : Subrepresentation (A s).representation).toSubmodule := by
    rw [hbot]; trivial
  exact ((Submodule.mem_bot ℂ).mp hv).trans ((Submodule.mem_bot ℂ).mp hw).symm

/-- Renard VI.10.6 (i), direction (⇒), from a Bernstein decomposition of every object: a
representation generated by its `K`-fixed vectors is the vertex of a coproduct of objects of
the blocks `M(G)_𝔰`, `𝔰 ∈ B(G)_K`. -/
theorem isCoproductOfFixedClasses_of_fixedVectorGenerated
    (hdec : Renard.EveryObjectIsCoproductOfComponents
      (fun s : BernsteinInertialClass.{uF, max uF uV} i ν family =>
        bernsteinBlockProperty.{uF, uV} i ν family s))
    (V : SmoothRep.{0, uF, uV} ℂ (rationalPoints G))
    (hV : fixedVectorGenerated K.toSubgroup V) :
    Renard.IsCoproductOfComponents
      (fun s : {s : BernsteinInertialClass.{uF, max uF uV} i ν family //
          bernsteinFixedClass.{uF, uV} i ν family K s} =>
        bernsteinBlockProperty.{uF, uV} i ν family s.1) V := by
  classical
  obtain ⟨A, inj, hA, ⟨hc⟩⟩ := hdec V
  have hzero := subsingleton_of_isCoproduct_of_not_bernsteinFixedClass i ν family K hV hc hA
  refine ⟨fun t => A t.1, fun t => inj t.1, fun t => hA t.1, ⟨?_⟩⟩
  let ext : ∀ c : Cofan (fun t : {s : BernsteinInertialClass.{uF, max uF uV} i ν family //
      bernsteinFixedClass.{uF, uV} i ν family K s} => A t.1), ∀ s, A s ⟶ c.pt :=
    fun c s => if h : bernsteinFixedClass.{uF, uV} i ν family K s then c.inj ⟨s, h⟩ else 0
  refine Cofan.IsColimit.mk _ (fun c => Cofan.IsColimit.desc hc (ext c)) ?_ ?_
  · intro c t
    change (Cofan.mk V inj).inj t.1 ≫ Cofan.IsColimit.desc hc (ext c) = c.inj t
    rw [Cofan.IsColimit.fac]
    simp [ext, t.2]
  · intro c m hm
    apply Cofan.IsColimit.hom_ext hc
    intro s
    rw [Cofan.IsColimit.fac]
    by_cases h : bernsteinFixedClass.{uF, uV} i ν family K s
    · exact (hm ⟨s, h⟩).trans (by simp [ext, h])
    · have := hzero s h
      ext v
      rw [Subsingleton.elim v 0]
      simp

end Langlands.Jacquet
