import Langlands.Representation.CuspidalSupport.RationalInertia
import Langlands.Representation.Jacquet.FixedVectorGeneratedCategory
import Langlands.Representation.Category.FixedVectorConstituent
import Langlands.Representation.Smooth.FixedVectors.DetectionConsequencesProof

/-! # Compact fixed vectors in actual same-group inertia blocks -/

noncomputable section

open CategoryTheory AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology Langlands.GroupScheme
open Langlands.Plancherel
open scoped CategoryTheory.MonObj

universe uF uV

namespace Langlands.CuspidalSupport

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffine G.X.left]
  [LocallyOfFiniteType G.X.hom]

local instance rationalInertiaFixedVectorsTopology :
    TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X

/-- A full rational unramified twist leaves every compact-subgroup fixed
submodule unchanged, on the original representation carrier. -/
theorem rationalUnramifiedTwist_fixedVectors_eq
    (C : Subgroup (rationalPoints G)) (hC : IsCompact (C : Set (rationalPoints G)))
    (χ : unramifiedCharacters (fun c => (rationalNormCharacters G c).toMul))
    (A : SmoothRep.{0,uF,uV} ℂ (rationalPoints G)) :
    fixedVectors (rationalUnramifiedTwist G χ A).representation C =
      fixedVectors A.representation C := by
  exact fixedVectors_twist_eq_of_le_ker χ.val.toMonoidHom A.representation C
    ((compactSubgroup_le_rationalCommonNormKernel G C hC).trans χ.property)

/-- The actual identity map identifies compact fixed spaces before and after
a full rational unramified twist. -/
def rationalUnramifiedTwistFixedVectorsEquiv
    (C : Subgroup (rationalPoints G)) (hC : IsCompact (C : Set (rationalPoints G)))
    (χ : unramifiedCharacters (fun c => (rationalNormCharacters G c).toMul))
    (A : SmoothRep.{0,uF,uV} ℂ (rationalPoints G)) :
    fixedVectors (rationalUnramifiedTwist G χ A).representation C ≃ₗ[ℂ]
      fixedVectors A.representation C where
  toFun v := ⟨v.val, by
    rw [← rationalUnramifiedTwist_fixedVectors_eq G C hC χ A]
    exact v.property⟩
  invFun v := ⟨v.val, by
    rw [rationalUnramifiedTwist_fixedVectors_eq G C hC χ A]
    exact v.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Actual inertia-related smooth objects have linearly equivalent compact
fixed spaces. No irreducibility or cuspidality premise is needed. -/
def rationalInertiaFixedVectorsEquiv
    (C : Subgroup (rationalPoints G)) (hC : IsCompact (C : Set (rationalPoints G)))
    {A B : SmoothRep.{0,uF,uV} ℂ (rationalPoints G)}
    (hAB : IsRationalInertiaRelated G A B) :
    fixedVectors A.representation C ≃ₗ[ℂ] fixedVectors B.representation C := by
  let χ := hAB.choose
  let e : B ≅ rationalUnramifiedTwist G χ A := Classical.choice hAB.choose_spec
  exact (rationalUnramifiedTwistFixedVectorsEquiv G C hC χ A).symm.trans
    (fixedVectorsEquiv (SmoothRep.equivOfIso e.symm) C)

/-- Compact fixed-vector nontriviality is constant on a same-group rational
inertia orbit. -/
theorem nontrivial_fixedVectors_iff_of_rationalInertiaRelated
    (C : Subgroup (rationalPoints G)) (hC : IsCompact (C : Set (rationalPoints G)))
    {A B : SmoothRep.{0,uF,uV} ℂ (rationalPoints G)}
    (hAB : IsRationalInertiaRelated G A B) :
    Nontrivial (fixedVectors A.representation C) ↔
      Nontrivial (fixedVectors B.representation C) :=
  (rationalInertiaFixedVectorsEquiv G C hC hAB).toEquiv.nontrivial_congr

variable [NonarchimedeanGroup (rationalPoints G)]

/-- Every actual same-group inertia-block object is generated by its compact
open fixed vectors or has none. The block condition quantifies over all
irreducible actual subquotients, without a length or admissibility premise. -/
theorem rationalInertiaBlock_fixedVector_dichotomy
    (K : OpenSubgroup (rationalPoints G)) (hK : IsCompact (K : Set (rationalPoints G)))
    (π V : SmoothRep.{0,uF,uV} ℂ (rationalPoints G))
    (hV : rationalInertiaBlockProperty G π V) :
    Jacquet.fixedVectorGenerated K.toSubgroup V ∨
      fixedVectors V.representation K.toSubgroup = ⊥ := by
  classical
  by_cases hzero : fixedVectors V.representation K.toSubgroup = ⊥
  · exact Or.inr hzero
  · left
    have hfix : Nontrivial (fixedVectors V.representation K.toSubgroup) :=
      Submodule.nontrivial_iff_ne_bot.mpr hzero
    obtain ⟨D, hD, hDV, hDfix⟩ :=
      SmoothRep.hasFixedVectorConstituent_of_nontrivial V K.toSubgroup hfix
    have hdet (E : SmoothRep.{0,uF,uV} ℂ (rationalPoints G))
        (hE : E.IsIrreducible) (hEV : SmoothRep.IsSubquotient E V) :
        ∃ v : E, v ∈ fixedVectors E.representation K.toSubgroup ∧ v ≠ 0 := by
      have hDE : IsRationalInertiaRelated G D E :=
        (hV D hD hDV).symm.trans (hV E hE hEV)
      have hEfix : Nontrivial (fixedVectors E.representation K.toSubgroup) :=
        (nontrivial_fixedVectors_iff_of_rationalInertiaRelated
          G K.toSubgroup hK hDE).mp hDfix
      let := hEfix
      obtain ⟨v, hv⟩ := exists_ne (0 : fixedVectors E.representation K.toSubgroup)
      exact ⟨v.val, v.property, fun hz => hv (Subtype.ext hz)⟩
    exact (compactOpenDetectionConsequences (rationalPoints G) V K hK hdet).2.1 V
      (SmoothRep.IsQuotient.isSubquotient ⟨𝟙 V, Function.surjective_id⟩)

end Langlands.CuspidalSupport
