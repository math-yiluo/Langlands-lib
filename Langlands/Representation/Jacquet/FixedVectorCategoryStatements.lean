import Langlands.BruhatTits.SpecialCompact.StandardBasisProperty
import Langlands.AlgebraicGeometry.PointTopology.RationalPointGroups
import Langlands.Representation.Category.Contragredient
import Langlands.Representation.Jacquet.FixedVectorGeneratedCategory
import Langlands.Shimura.LevelHeckeAlgebra

/-! # Representations generated by fixed vectors: duality and the Hecke algebra
(Renard VI.10.6, Proposition (iii)–(iv))

For a compact open subgroup `K`, contained and normal in `K₀` and with an Iwahori decomposition
along every standard parabolic, a smooth representation is generated by its `K`-fixed vectors
exactly when its smooth contragredient is, and the Hecke algebra of `K` is Noetherian.
-/

noncomputable section

universe uF uV

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme
open Langlands.AlgebraicGeometry.PointTopology
open Langlands.BruhatTits.SpecialCompact

namespace Langlands.Jacquet

/-- Renard VI.10.6, Proposition (iii) and (iv): let `K` be a compact open subgroup of `G(F)`,
contained and normal in a compact subgroup `K₀` with `G(F) = M_∅(F) N_∅(F) K₀`, and with an
Iwahori decomposition along every standard parabolic (the hypotheses of the published VI.9.4
statements). Then

* (iii) a smooth representation `V` is generated by its `K`-fixed vectors if and only if its
  smooth contragredient `Ṽ` is;
* (iv) the Hecke algebra `ℂ[G(F)/K]^K` of `K` is left and right Noetherian. -/
def FixedVectorCategoryStatements : Prop :=
  ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    letI : IsAffineHom G.X.hom := hG.isAffineHom
    letI : Smooth G.X.hom := hG.smooth
    letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    letI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G)
      (_hi : IsMaximalSplitTorus i) (ν : cocharacterLattice S)
      (_hν : IsGenericCocharacter i ν)
      (_hstandard : ∀ J ⊆ simpleRelativeRoots i ν, ∃ zeta, IsStandardCocharacter i ν J zeta)
      (K₀ : Subgroup (rationalPoints G)) (_hK₀ : IsCompact (K₀ : Set (rationalPoints G)))
      (_hIwasawa : ∀ g : rationalPoints G, ∃ m ∈ standardLeviPoints i ν ∅,
        ∃ n ∈ standardUnipotentPoints i ν ∅, ∃ k ∈ K₀, g = m * n * k)
      (K : OpenSubgroup (rationalPoints G)) (_hK : IsCompact (K : Set (rationalPoints G)))
      (_hKK₀ : K.toSubgroup ≤ K₀) (_hnormal : K₀ ≤ Subgroup.normalizer K.toSubgroup)
      (_hIwahori : ∀ J ⊆ simpleRelativeRoots i ν,
        ∃ (A : CommGroupScheme (Spec (CommRingCat.of F))) (q : A.toGrp ⟶ S.toGrp),
          IsCompatibleStandardSplitComponent i ν J A q ∧
            StandardParabolicBasisMember i ν J q K.toSubgroup),
      (∀ V : SmoothRep.{0, uF, uV} ℂ (rationalPoints G),
        fixedVectorGenerated K.toSubgroup V ↔ fixedVectorGenerated K.toSubgroup V.contragredient) ∧
      IsNoetherianRing (Shimura.LevelHecke.LevelHeckeAlgebra ℂ K.toSubgroup) ∧
        IsNoetherianRing (Shimura.LevelHecke.LevelHeckeAlgebra ℂ K.toSubgroup)ᵐᵒᵖ

end Langlands.Jacquet
