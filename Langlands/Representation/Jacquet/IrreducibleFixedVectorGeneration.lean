import Langlands.Representation.Jacquet.FixedVectorGeneratedCategory
import Langlands.Representation.Smooth.FixedVectors.JacquetDetectionProof

/-! # Fixed-vector generation of irreducible representations -/

noncomputable section

universe uG uV

namespace Langlands.Jacquet

/-- An irreducible smooth representation is generated by its fixed vectors
exactly when its fixed space is nonzero. The subgroup is arbitrary. -/
def IrreducibleFixedVectorGenerationStatement : Prop :=
  ∀ (G : Type uG) [Group G] [TopologicalSpace G] (K : Subgroup G)
    (A : SmoothRep.{0, uG, uV} ℂ G), A.IsIrreducible →
      (fixedVectorGenerated K A ↔ Nontrivial (fixedVectors A.representation K))

/-- The bottom/top dichotomy for irreducible subrepresentations gives the
fixed-vector generation criterion without a compactness assumption. -/
theorem irreducibleFixedVectorGeneration :
    IrreducibleFixedVectorGenerationStatement.{uG, uV} := by
  intro G _ _ K A hA
  constructor
  · intro hgen
    by_contra hn
    have : Subsingleton (fixedVectors A.representation K) :=
      not_nontrivial_iff_subsingleton.mp hn
    apply hA.bot_ne_top
    apply hgen
    intro v hv
    exact (Submodule.mem_bot ℂ).mpr
      (congrArg Subtype.val (Subsingleton.elim (⟨v, hv⟩ : fixedVectors A.representation K) 0))
  · intro hfix S hS
    rcases hA.eq_bot_or_eq_top S with hbot | htop
    · let := hfix
      obtain ⟨v, hv⟩ := exists_ne (0 : fixedVectors A.representation K)
      have hmem := hS v.property
      rw [hbot] at hmem
      exact False.elim (hv (Subtype.ext ((Submodule.mem_bot ℂ).mp hmem)))
    · exact htop

end Langlands.Jacquet

namespace Langlands.SmoothRep

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Compact-open exactness transfers nontriviality of the fixed space of an
actual subquotient to that of its ambient representation. -/
theorem nontrivial_fixedVectors_of_isSubquotient
    {A D : SmoothRep.{0, uG, uV} ℂ G} (K : OpenSubgroup G)
    (hK : IsCompact (K : Set G)) (hDA : IsSubquotient D A)
    (hD : Nontrivial (fixedVectors D.representation K.toSubgroup)) :
    Nontrivial (fixedVectors A.representation K.toSubgroup) := by
  let := hD
  obtain ⟨w, hw⟩ := exists_ne (0 : fixedVectors D.representation K.toSubgroup)
  obtain ⟨v, hv, hv0⟩ := exists_nonzero_fixedVector_of_isSubquotient K hK hDA
    ⟨w.val, w.property, fun h => hw (Subtype.ext h)⟩
  exact ⟨⟨⟨v, hv⟩, 0, fun h => hv0 (congrArg Subtype.val h)⟩⟩

end Langlands.SmoothRep
