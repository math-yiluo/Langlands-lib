import Langlands.Representation.Jacquet.PrescribedInductionGeneration
import Langlands.Representation.Jacquet.StandardNormalLevelFixedVectors
import Langlands.Representation.Jacquet.StandardCentralContraction
import Langlands.Representation.Aubert.General.RationalOppositeIwahoriBasisProof
import Langlands.Representation.Aubert.General.RationalUnipotentRegularity

/-! # Actual standard induction generated at the prescribed level -/

noncomputable section

set_option maxHeartbeats 2000000

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

universe uF uV

namespace Langlands.Jacquet

section OrbitSpan

variable {H : Type uF} [Group H] [TopologicalSpace H]

/-- The actual subrepresentation generated by the orbits of the fixed
vectors of a specified subgroup. -/
def fixedVectorOrbitSubrepresentation (L : Subgroup H)
    (A : SmoothRep.{0, uF, uV} ℂ H) : Subrepresentation A.representation where
  toSubmodule := Submodule.span ℂ (Set.range fun x : H × fixedVectors A.representation L =>
    A.representation x.1 x.2.val)
  apply_mem_toSubmodule g v hv := by
    induction hv using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨⟨g', v'⟩, rfl⟩ := hw
      exact Submodule.subset_span ⟨⟨g * g', v'⟩, by
        change A.representation (g * g') v'.val =
          A.representation g (A.representation g' v'.val)
        rw [map_mul, Module.End.mul_apply]⟩
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add v w _ _ hv hw => rw [map_add]; exact Submodule.add_mem _ hv hw
    | smul c v _ hv => rw [map_smul]; exact Submodule.smul_mem _ c hv

/-- The invariant-submodule definition of generation gives the concrete
linear span of the fixed-vector orbits, with no finite-generation premise. -/
theorem mem_span_fixedVector_orbits (L : Subgroup H)
    (A : SmoothRep.{0, uF, uV} ℂ H) (hA : fixedVectorGenerated L A) (v : A) :
    v ∈ Submodule.span ℂ (Set.range fun x : H × fixedVectors A.representation L =>
      A.representation x.1 x.2.val) := by
  have htop : fixedVectorOrbitSubrepresentation L A = ⊤ := by
    apply hA
    intro w hw
    exact Submodule.subset_span ⟨⟨1, ⟨w, hw⟩⟩, by simp⟩
  have hv : v ∈ fixedVectorOrbitSubrepresentation L A := by rw [htop]; trivial
  exact hv

end OrbitSpan

open GroupScheme CuspidalSupport Aubert.General Aubert.General.RationalPointFamily
open Langlands.AlgebraicGeometry.PointTopology
open BruhatTits.SpecialCompact

variable {F : Type uF} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  {T : CommGroupScheme (Spec (CommRingCat.of F))}
  (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)

local instance standardPrescribedGenerationAffine : IsAffine G.X.left :=
  isAffine_of_isAffineHom G.X.hom
local instance standardPrescribedGenerationTopology : TopologicalSpace (rationalPoints G) :=
  pointTopology

variable [LocallyCompactSpace (rationalPoints G)] [NonarchimedeanGroup (rationalPoints G)]
  (family : BernsteinStandardFamily i ν)

include family in
omit [ValuativeRel F] [IsNonarchimedeanLocalField F]
  [LocallyCompactSpace (rationalPoints G)] [NonarchimedeanGroup (rationalPoints G)] in
/-- The literal opposite standard radical is the dynamic opposite radical
of every standard cocharacter of the face. -/
theorem standardFamilyOppositeUnipotentPoints_eq_dynamic
    (I : Finset (SimpleRoot i ν)) {ζ : cocharacterLattice T}
    (hζ : IsStandardCocharacter i ν (rootSet i ν I) ζ) :
    standardOppositeUnipotentPoints i ν (rootSet i ν I) = oppositeUnipotent i ζ := by
  have hνneg : IsGenericCocharacter i (-ν) := by
    intro α hα
    simpa only [map_neg, neg_ne_zero] using family.genericCocharacter α hα
  have hζneg := hζ.neg i ν
    (relativeRootNegation F G family.connectedReductive T i family.maximalSplitTorus)
  have hU := (standard_eq_dynamic_of_relativeRootNegation relativeRootNegation
    F G family.connectedReductive T i family.maximalSplitTorus (-ν) hνneg
      (Neg.neg '' rootSet i ν I) (-ζ) hζneg).2.2
  change (standardUnipotent i (-ν) (Neg.neg '' rootSet i ν I)).carrier _ = _
  rw [hU, groupHom_neg_comp_eq_oppositeCocharacter i ζ]
  rfl

include family in
/-- A cofinal compact open factorized basis for the exact opposite standard
subgroups is supplied by the actual opposite-Iwahori basis theorem. -/
theorem exists_standard_cellFactorized_subgroup
    [T2Space (rationalPoints G)] (I : Finset (SimpleRoot i ν))
    (O : Set (rationalPoints G)) (hO : IsOpen O) (h1 : (1 : rationalPoints G) ∈ O) :
    ∃ L : OpenSubgroup (rationalPoints G), IsCompact (L : Set (rationalPoints G)) ∧
      (L : Set (rationalPoints G)) ⊆ O ∧ Plancherel.IsCellFactorized
        (unipotent i ν I) (levi i ν I)
        (standardOppositeUnipotentPoints i ν (rootSet i ν I)) L.toSubgroup := by
  let := family.maximalSplitTorus.isSplitSubtorus.mono
  obtain ⟨ζ, hζ⟩ := (standardCocharacter F G family.connectedReductive T i
    family.maximalSplitTorus ν family.genericCocharacter (rootSet i ν I)
      (rootSet_subset i ν I)).1
  obtain ⟨g, _, hB⟩ := rationalOppositeIwahoriBasisStatement F G family.connectedReductive
    T i family.maximalSplitTorus ν family.genericCocharacter standardCocharacter I
      (family.closedUnipotent I) ζ hζ
  rw [← standardFamilyOppositeUnipotentPoints_eq_dynamic i ν family I hζ] at hB
  obtain ⟨L, hLc, hLO, _, hOpp⟩ := hB O hO h1
  exact ⟨L, hLc, hLO, fun x hx => hOpp.factor x hx⟩

omit [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
  [LocallyCompactSpace (rationalPoints G)] [NonarchimedeanGroup (rationalPoints G)] in
/-- Inversion reverses the literal Iwahori factorization into the cell order
used by the compact-picture generation theorem. -/
theorem cellFactorized_of_iwahoriIntersection
    (I : Finset (SimpleRoot i ν)) (K : Subgroup (rationalPoints G))
    (hK : HasIwahoriIntersectionDecomposition K (levi i ν I) (unipotent i ν I)
      (standardOppositeUnipotentPoints i ν (rootSet i ν I))) :
    Plancherel.IsCellFactorized (unipotent i ν I) (levi i ν I)
      (standardOppositeUnipotentPoints i ν (rootSet i ν I)) K := by
  intro x hx
  obtain ⟨⟨n, m, u⟩, he⟩ := hK.surjective ⟨x⁻¹, K.inv_mem hx⟩
  have he' := congrArg Subtype.val he
  change (n : rationalPoints G) * (m : rationalPoints G) * (u : rationalPoints G) = x⁻¹ at he'
  refine ⟨(u : rationalPoints G)⁻¹, (K ⊓ unipotent i ν I).inv_mem u.property,
    (m : rationalPoints G)⁻¹, (K ⊓ levi i ν I).inv_mem m.property,
    (n : rationalPoints G)⁻¹,
      (K ⊓ standardOppositeUnipotentPoints i ν (rootSet i ν I)).inv_mem n.property, ?_⟩
  simpa only [mul_inv_rev, inv_inv, mul_assoc] using (congrArg Inv.inv he').symm

/-- Actual standard normalized induction is generated by the prescribed
`K`-fixed vectors whenever the coefficient representation is generated by
its literal `K ∩ M_I`-fixed vectors. All structural inputs are discharged. -/
theorem fixedVectorGenerated_standardInduction_of_coefficientGeneration
    (I : Finset (SimpleRoot i ν))
    (K : OpenSubgroup (rationalPoints G)) (hK : IsCompact (K : Set (rationalPoints G)))
    (K₀ : Subgroup (rationalPoints G)) (hK₀ : IsCompact (K₀ : Set (rationalPoints G)))
    (hKK₀ : K.toSubgroup ≤ K₀)
    (hIwasawa : ∀ x : rationalPoints G, ∃ m ∈ standardLeviPoints i ν ∅,
      ∃ n ∈ standardUnipotentPoints i ν ∅, ∃ k ∈ K₀, x = m * n * k)
    (hBasis : ∃ (B : CommGroupScheme (Spec (CommRingCat.of F))) (q : B.toGrp ⟶ T.toGrp),
      IsCompatibleStandardSplitComponent i ν (rootSet i ν I) B q ∧
        StandardParabolicBasisMember i ν (rootSet i ν I) q K.toSubgroup)
    (A : SmoothRep.{0, uF, uV} ℂ (levi i ν I))
    (hA : fixedVectorGenerated (K.toSubgroup.comap (levi i ν I).subtype) A) :
    fixedVectorGenerated K.toSubgroup
      ((normalizedInductionFunctor (family.decomposition I)
        (family.closedUnipotent I)).obj A) := by
  let : T2Space F := BruhatTits.localField_t2Space F
  let : T2Space (rationalPoints G) := rationalPoint_t2Space F G
  let K₀open : OpenSubgroup (rationalPoints G) :=
    ⟨K₀, Subgroup.isOpen_mono hKK₀ K.isOpen⟩
  obtain ⟨B, q, hB, hBasis⟩ := hBasis
  obtain ⟨ζ, hζ⟩ := (standardCocharacter F G family.connectedReductive T i
    family.maximalSplitTorus ν family.genericCocharacter (rootSet i ν I)
      (rootSet_subset i ν I)).1
  have hOpp := standardFamilyOppositeUnipotentPoints_eq_dynamic i ν family I hζ
  have hMO : levi i ν I ≤ Subgroup.normalizer
      (standardOppositeUnipotentPoints i ν (rootSet i ν I) : Set (rationalPoints G)) := by
    rw [hOpp]
    exact (opposite_isSemidirectDecomposition i ν standardCocharacter family.connectedReductive
      family.maximalSplitTorus family.genericCocharacter I ζ hζ).levi_le_normalizer
  have hPO : ∀ x : rationalPoints G, x ∈ parabolic i ν I →
      x ∈ standardOppositeUnipotentPoints i ν (rootSet i ν I) → x = 1 := by
    intro x hxP hxO
    exact eq_one_of_mem_standardOppositeUnipotent_of_mem_standardParabolic i ν
      (relativeRootNegation F G family.connectedReductive T i family.maximalSplitTorus)
      ⟨ζ, hζ⟩ hxO hxP
  let g := ((hB.centralStrictElement i ν family.maximalSplitTorus hζ : levi i ν I) :
    rationalPoints G)
  have hg : IsIwahoriContraction K (unipotent i ν I) (levi i ν I)
      (standardOppositeUnipotentPoints i ν (rootSet i ν I)) g :=
    hB.centralStrictElement_isIwahoriContraction i ν family.maximalSplitTorus hζ K hBasis
  let v : fixedVectors A.representation (K.toSubgroup.comap (levi i ν I).subtype) → A :=
    Subtype.val
  apply Plancherel.fixedVectorGenerated_normalizedInduction_of_contraction
    (family.decomposition I) (family.closedUnipotent I)
    (standardUnipotent_isUnimodular_of_standardCocharacterStatement i ν standardCocharacter
      family.connectedReductive family.maximalSplitTorus family.genericCocharacter I
        (family.closedUnipotent I)) K₀open
    (isClosed_standard_parabolic i ν standardCocharacter family.connectedReductive
      family.maximalSplitTorus family.genericCocharacter I) hK₀
    (standard_parabolic_factorization_of_minimal i ν family I K₀ hIwasawa)
    (continuous_standard_projection i ν standardCocharacter family.connectedReductive
      family.maximalSplitTorus family.genericCocharacter I) A hMO hPO
      K hK hKK₀ (cellFactorized_of_iwahoriIntersection i ν I K.toSubgroup hBasis.1)
      g hg v (mem_span_fixedVector_orbits _ A hA) ?_
      (exists_standard_cellFactorized_subgroup i ν family I)
  intro j p hp
  exact j.property ⟨(family.decomposition I).projection p,
    standard_projection_mem_of_iwahoriIntersection i ν family I K.toSubgroup hBasis.1 p hp⟩

end Langlands.Jacquet
