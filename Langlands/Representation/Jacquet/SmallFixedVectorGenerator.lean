import Langlands.Shimura.LevelHeckeAlgebra
import Langlands.Representation.Smooth.SmallRealizationProof
import Langlands.Representation.Category.FiniteGenerationCoproducts
import Mathlib.Basic.Countable.Small

/-! # A compact permutation generator in an independent carrier universe -/

noncomputable section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

open CategoryTheory
open Langlands.Shimura.LevelHecke Langlands.Induction
open scoped MonoidAlgebra

universe uG uV uW

namespace Langlands.Jacquet

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  (K : OpenSubgroup G) [Small.{uV} (G ⧸ K.toSubgroup)]

/-- The permutation carrier, with its coset basis resized into the carrier universe. -/
abbrev SmallFixedVectorCarrier := Shrink.{uV} (G ⧸ K.toSubgroup) →₀ ℂ

/-- Reindexing the coset basis does not change the complex vector space. -/
def smallFixedVectorCarrierEquiv :
    (G ⧸ K.toSubgroup →₀ ℂ) ≃ₗ[ℂ] SmallFixedVectorCarrier.{uG,uV} K :=
  Finsupp.domLCongr (equivShrink.{uV} (G ⧸ K.toSubgroup))

/-- Compact induction of the trivial character, realized in `Type uV`. -/
def smallFixedVectorGenerator : SmoothRep.{0,uG,uV} ℂ G :=
  SmoothRep.of (transportRepresentation (permRep ℂ K.toSubgroup)
    (smallFixedVectorCarrierEquiv K))
    (isSmooth_of_surjective
      (transportRepresentationEquiv (permRep ℂ K.toSubgroup)
        (smallFixedVectorCarrierEquiv K)).toIntertwiningMap
      (smallFixedVectorCarrierEquiv K).surjective
      (isSmooth_permutation K.toSubgroup K.isOpen))

/-- The original and resized permutation representations are equivalent. -/
def smallFixedVectorGeneratorEquiv :
    (permRep ℂ K.toSubgroup).Equiv (smallFixedVectorGenerator.{uG,uV} K).representation :=
  transportRepresentationEquiv _ (smallFixedVectorCarrierEquiv K)

/-- The identity-coset vector in the resized compact permutation representation. -/
def smallFixedVectorUnit : fixedVectors
    (smallFixedVectorGenerator.{uG,uV} K).representation K.toSubgroup :=
  fixedVectorsMap (smallFixedVectorGeneratorEquiv K).toIntertwiningMap K.toSubgroup
    (unitElement K.toSubgroup)

/-- The identity-coset vector generates the entire permutation representation. -/
theorem smallFixedVectorUnit_generates
    (S : Subrepresentation (smallFixedVectorGenerator.{uG,uV} K).representation)
    (hS : (smallFixedVectorUnit K : smallFixedVectorGenerator K) ∈ S) : S = ⊤ := by
  apply top_unique
  intro w hw
  clear hw
  obtain ⟨a, rfl⟩ := (smallFixedVectorGeneratorEquiv K).toLinearEquiv.surjective w
  induction a using Finsupp.induction_linear with
  | zero =>
      change smallFixedVectorCarrierEquiv K 0 ∈ S.toSubmodule
      rw [map_zero]
      exact S.toSubmodule.zero_mem
  | add a b ha hb =>
      change smallFixedVectorCarrierEquiv K (a + b) ∈ S.toSubmodule
      rw [map_add]
      exact S.toSubmodule.add_mem ha hb
  | single q r =>
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
      have h := S.toSubmodule.smul_mem r (S.apply_mem_toSubmodule g hS)
      have he : smallFixedVectorCarrierEquiv K (Finsupp.single (g : G ⧸ K.toSubgroup) r) =
          r • (smallFixedVectorGenerator K).representation g (smallFixedVectorUnit K) := by
        change smallFixedVectorCarrierEquiv K (Finsupp.single _ r) =
          r • smallFixedVectorCarrierEquiv K (permutation ℂ G (G ⧸ K.toSubgroup) ℂ g
            ((smallFixedVectorCarrierEquiv K).symm
              (smallFixedVectorCarrierEquiv K (Finsupp.single ((1 : G) : G ⧸ K.toSubgroup) 1))))
        rw [LinearEquiv.symm_apply_apply]
        rw [permutation_single, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one,
          ← map_smul, Finsupp.smul_single_one]
      change smallFixedVectorCarrierEquiv K (Finsupp.single (g : G ⧸ K.toSubgroup) r) ∈ S.toSubmodule
      rw [he]
      exact h

/-- In particular, the compact permutation generator is generated by its fixed vectors. -/
theorem smallFixedVectorGenerator_generated :
    ∀ S : Subrepresentation (smallFixedVectorGenerator.{uG,uV} K).representation,
      fixedVectors (smallFixedVectorGenerator K).representation K.toSubgroup ≤ S.toSubmodule →
        S = ⊤ := by
  intro S hS
  exact smallFixedVectorUnit_generates K S (hS (smallFixedVectorUnit K).property)

/-- The compact permutation generator is cyclic over the actual group algebra. -/
instance smallFixedVectorGenerator_finite :
    Module.Finite (MonoidAlgebra ℂ G)
      (smallFixedVectorGenerator.{uG,uV} K).representation.asModule := by
  apply Module.Finite.of_fg_top
  let v : (smallFixedVectorGenerator.{uG,uV} K).representation.asModule :=
    (smallFixedVectorGenerator K).representation.asModuleEquiv.symm (smallFixedVectorUnit K)
  refine ⟨{v}, ?_⟩
  simp only [Finset.coe_singleton]
  have h := smallFixedVectorUnit_generates K
    (Subrepresentation.ofSubmodule' (ρ := (smallFixedVectorGenerator K).representation) (Submodule.span (MonoidAlgebra ℂ G) ({v} : Set _)))
    (by
      change v ∈ Submodule.span (MonoidAlgebra ℂ G) ({v} : Set _)
      exact Submodule.subset_span (Set.mem_singleton v))
  exact congrArg Subrepresentation.asSubmodule h

variable {V : Type uW} [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ G V)

/-- A fixed vector gives the unique intertwiner from the resized compact permutation module. -/
def smallFixedVectorLift (v : fixedVectors ρ K.toSubgroup) :
    (smallFixedVectorGenerator.{uG,uV} K).representation.IntertwiningMap ρ :=
  (frobenius ρ v).comp (smallFixedVectorGeneratorEquiv K).symm.toIntertwiningMap

@[simp] theorem smallFixedVectorLift_unit (v : fixedVectors ρ K.toSubgroup) :
    smallFixedVectorLift K ρ v (smallFixedVectorUnit K) = v := by
  change frobenius ρ v ((smallFixedVectorCarrierEquiv K).symm
    (smallFixedVectorCarrierEquiv K (unitElement (R := ℂ) K.toSubgroup))) = v
  rw [LinearEquiv.symm_apply_apply, frobenius_unitElement]

/-- An intertwiner from compact induction is determined by its identity-coset value. -/
theorem smallFixedVectorLift_eval
    (f : (smallFixedVectorGenerator.{uG,uV} K).representation.IntertwiningMap ρ) :
    smallFixedVectorLift K ρ (fixedVectorsMap f K.toSubgroup (smallFixedVectorUnit K)) = f := by
  have h := frobenius_eval ρ
    (f.comp (smallFixedVectorGeneratorEquiv K).toIntertwiningMap)
    (fixedVectorsMap f K.toSubgroup (smallFixedVectorUnit K)).property
  apply Representation.IntertwiningMap.ext
  ext w
  obtain ⟨a, rfl⟩ := (smallFixedVectorCarrierEquiv K).surjective w
  have ha := congrArg (fun t => t a) h
  change frobenius ρ (fixedVectorsMap f K.toSubgroup (smallFixedVectorUnit K))
    ((smallFixedVectorCarrierEquiv K).symm ((smallFixedVectorCarrierEquiv K) a)) =
    f ((smallFixedVectorCarrierEquiv K) a)
  rw [LinearEquiv.symm_apply_apply]
  exact ha

end Langlands.Jacquet
