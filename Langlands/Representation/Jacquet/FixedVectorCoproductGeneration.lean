import Langlands.Representation.Jacquet.FixedVectorGeneratedCategory
import Langlands.Representation.Category.CoproductSize
import Langlands.Representation.Category.DecompositionCentralProjectors
import Langlands.Representation.Category.SpanningDisjointCoproduct

/-! # Fixed-vector generation on arbitrary supplied coproducts -/

noncomputable section

open CategoryTheory CategoryTheory.Limits

universe uG uV uI

namespace Langlands.Jacquet

variable {G : Type uG} [Group G] [TopologicalSpace G] (K : Subgroup G)
  {I : Type uI} (A : I → SmoothRep.{0,uG,uV} ℂ G)
  {V : SmoothRep.{0,uG,uV} ℂ G} (ι : ∀ i, A i ⟶ V)

/-- Generation by fixed vectors holds at the vertex of any supplied coproduct
exactly when it holds on all its components, without an index-size restriction. -/
theorem fixedVectorGenerated_iff_of_isColimit_cofan
    (hc : IsColimit (Cofan.mk V ι)) :
    fixedVectorGenerated K V ↔ ∀ i, fixedVectorGenerated K (A i) := by
  classical
  constructor
  · intro hV i
    apply fixedVectorGenerated_of_surjective K hV
      (SmoothRep.hom (SmoothRep.cofanProjection hc i))
    intro v
    refine ⟨SmoothRep.hom (ι i) v, ?_⟩
    exact congrArg (fun f => SmoothRep.hom f v)
      (SmoothRep.inj_cofanProjection_self hc i)
  · intro hA S hS
    apply top_unique
    rw [← SmoothRep.iSup_range_cofan_eq_top A (Cofan.mk V ι) hc]
    apply iSup_le
    intro i v hv
    obtain ⟨x, rfl⟩ := hv
    exact fixedVectorGenerated_image_le K (hA i) (SmoothRep.hom (ι i)) S
      (fun x hx => hS (map_mem_fixedVectors _ hx)) x

set_option linter.defProp false in
/-- The proved arbitrary-index coproduct generation equivalence as a defined
proof term, for reuse as an infrastructure definition. -/
def fixedVectorCoproductGeneration
    (hc : IsColimit (Cofan.mk V ι)) :
    fixedVectorGenerated K V ↔ ∀ i, fixedVectorGenerated K (A i) :=
  fixedVectorGenerated_iff_of_isColimit_cofan K A ι hc

/-- An object generated by its fixed vectors is zero if its fixed subspace
is zero. -/
theorem isZero_of_fixedVectorGenerated_of_fixedVectors_eq_bot
    {V : SmoothRep.{0,uG,uV} ℂ G}
    (hV : fixedVectorGenerated K V)
    (hfix : fixedVectors V.representation K = ⊥) :
    IsZero V := by
  have hbot : (⊥ : Subrepresentation V.representation) = ⊤ :=
    hV ⊥ (by rw [hfix]; exact le_rfl)
  have hz (x : V) : x = 0 := by
    have hx : x ∈ (⊥ : Subrepresentation V.representation) := by
      rw [hbot]
      trivial
    exact hx
  exact (SmoothRep.isZero_iff_subsingleton V).mpr
    ⟨fun x y => (hz x).trans (hz y).symm⟩

end Langlands.Jacquet
