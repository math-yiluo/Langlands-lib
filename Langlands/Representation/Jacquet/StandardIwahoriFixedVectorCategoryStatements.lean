import Langlands.Representation.Jacquet.StandardBernsteinFixedVectorReduction
import Langlands.BruhatTits.SpecialCompact.SmallSubgroupPredicates

/-! # Renard VI.10.6 Proposition for compact open subgroups with an Iwahori decomposition

Statements only, together with one proved comparison. Renard 2026, VI.10.6, Proposition
(printed p.214 / PDF p.220). Let `K` be a compact open subgroup of `G(F)`, contained and
normal in `K₀`, with an Iwahori decomposition `K = (K ∩ N̄_J)(K ∩ M_J)(K ∩ N_J)` along every
standard parabolic `P_J = M_J N_J` (the published `HasIwahoriIntersectionDecomposition`, as
in the Iwahori forms of VI.9.4 in `Jacquet/StandardIwahoriDecompositionStatements`).

* `StandardIwahoriFixedVectorBlockDecompositionStatement`: (i), second assertion,
  `M(G)_K ≃ ∏_{𝔰 ∈ B(G)_K} M(G)_𝔰`, for the actual standard cuspidal data of the standard
  Bernstein family: a smooth representation is generated by its `K`-fixed vectors iff it is
  the vertex of a coproduct of objects of the full Bernstein blocks `M(G)_𝔰`, `𝔰 ∈ B(G)_K`.
* `StandardIwahoriFixedVectorCategoryStatement`: (iii) and (iv), with the conclusion of the
  published `FixedVectorCategoryStatements`.
* `fixedVectorCategoryStatements_of_standardIwahori`: the second statement implies the
  published `FixedVectorCategoryStatements`, whose hypothesis on `K` is the stronger
  `StandardParabolicBasisMember`.
-/

noncomputable section

universe uF uV

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme
open Langlands.AlgebraicGeometry.PointTopology
open Langlands.BruhatTits.SpecialCompact
open Langlands.CuspidalSupport

namespace Langlands.Jacquet

/-- Renard VI.10.6, Proposition (i), second assertion `M(G)_K ≃ ∏_{𝔰 ∈ B(G)_K} M(G)_𝔰`, in
the sense of A.IX, for the actual standard cuspidal data of the standard Bernstein family:
let `K` be a compact open subgroup of `G(F)`, contained and normal in a compact subgroup `K₀`
with `G(F) = M_∅(F) N_∅(F) K₀`, with an Iwahori decomposition along every standard
parabolic. Write `B(G)_K` for the inertial classes `𝔰` such that some irreducible smooth
representation with inertial support `𝔰` has a nonzero `K`-fixed vector. Then a smooth
representation `V` is generated by its `K`-fixed vectors iff `V` is the vertex of a
coproduct cofan whose component of index `𝔰 ∈ B(G)_K` lies in the full Bernstein block
`M(G)_𝔰`. -/
def StandardIwahoriFixedVectorBlockDecompositionStatement : Prop :=
  ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    letI : IsAffineHom G.X.hom := hG.isAffineHom
    letI : Smooth G.X.hom := hG.smooth
    letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    letI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G)
      (hi : IsMaximalSplitTorus i) (ν : cocharacterLattice S)
      (hν : IsGenericCocharacter i ν)
      (_hstandard : ∀ J ⊆ simpleRelativeRoots i ν, ∃ zeta, IsStandardCocharacter i ν J zeta)
      (K₀ : Subgroup (rationalPoints G)) (_hK₀ : IsCompact (K₀ : Set (rationalPoints G)))
      (_hIwasawa : ∀ g : rationalPoints G, ∃ m ∈ standardLeviPoints i ν ∅,
        ∃ n ∈ standardUnipotentPoints i ν ∅, ∃ k ∈ K₀, g = m * n * k)
      (K : OpenSubgroup (rationalPoints G)) (_hK : IsCompact (K : Set (rationalPoints G)))
      (_hKK₀ : K.toSubgroup ≤ K₀) (_hnormal : K₀ ≤ Subgroup.normalizer K.toSubgroup)
      (_hIwahori : ∀ J ⊆ simpleRelativeRoots i ν,
        HasIwahoriIntersectionDecomposition K.toSubgroup (standardLeviPoints i ν J)
          (standardUnipotentPoints i ν J) (standardOppositeUnipotentPoints i ν J)),
      letI : T2Space F := BruhatTits.localField_t2Space F
      letI : LocallyCompactSpace (rationalPoints G) := rationalPoint_locallyCompactSpace F G
      letI : NonarchimedeanGroup (rationalPoints G) :=
        Plancherel.rationalPoints_nonarchimedeanGroup G
      let family := standardBernsteinFamily i ν hG hi hν
      ∀ V : SmoothRep.{0, uF, uV} ℂ (rationalPoints G),
        fixedVectorGenerated K.toSubgroup V ↔
          Renard.IsCoproductOfComponents
            (fun s : {s : BernsteinInertialClass.{uF, max uF uV} i ν family //
                ∃ π : SmoothRep.{0, uF, max uF uV} ℂ (rationalPoints G),
                  IsBernsteinInertialSupport i ν family s π ∧
                    Nontrivial (fixedVectors π.representation K.toSubgroup)} =>
              bernsteinBlockProperty.{uF, uV} i ν family s.1) V

/-- Renard VI.10.6, Proposition (iii) and (iv), under the source's hypothesis on `K`: let `K`
be a compact open subgroup of `G(F)`, contained and normal in a compact subgroup `K₀` with
`G(F) = M_∅(F) N_∅(F) K₀`, with an Iwahori decomposition along every standard parabolic.
Then

* (iii) a smooth representation `V` is generated by its `K`-fixed vectors if and only if its
  smooth contragredient `Ṽ` is;
* (iv) the Hecke algebra `ℂ[G(F)/K]^K` of `K` is left and right Noetherian. -/
def StandardIwahoriFixedVectorCategoryStatement : Prop :=
  ∀ (F : Type uF) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G),
    letI : IsAffineHom G.X.hom := hG.isAffineHom
    letI : Smooth G.X.hom := hG.smooth
    letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
    letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
    letI : IsTopologicalGroup (rationalPoints G) := rationalPoint_isTopologicalGroup F G
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G)
      (_hi : IsMaximalSplitTorus i) (ν : cocharacterLattice S)
      (_hν : IsGenericCocharacter i ν)
      (_hstandard : ∀ J ⊆ simpleRelativeRoots i ν, ∃ zeta, IsStandardCocharacter i ν J zeta)
      (K₀ : Subgroup (rationalPoints G)) (_hK₀ : IsCompact (K₀ : Set (rationalPoints G)))
      (_hIwasawa : ∀ g : rationalPoints G, ∃ m ∈ standardLeviPoints i ν ∅,
        ∃ n ∈ standardUnipotentPoints i ν ∅, ∃ k ∈ K₀, g = m * n * k)
      (K : OpenSubgroup (rationalPoints G)) (_hK : IsCompact (K : Set (rationalPoints G)))
      (_hKK₀ : K.toSubgroup ≤ K₀) (_hnormal : K₀ ≤ Subgroup.normalizer K.toSubgroup)
      (_hIwahori : ∀ J ⊆ simpleRelativeRoots i ν,
        HasIwahoriIntersectionDecomposition K.toSubgroup (standardLeviPoints i ν J)
          (standardUnipotentPoints i ν J) (standardOppositeUnipotentPoints i ν J)),
      (∀ V : SmoothRep.{0, uF, uV} ℂ (rationalPoints G),
        fixedVectorGenerated K.toSubgroup V ↔ fixedVectorGenerated K.toSubgroup V.contragredient) ∧
      IsNoetherianRing (Shimura.LevelHecke.LevelHeckeAlgebra ℂ K.toSubgroup) ∧
        IsNoetherianRing (Shimura.LevelHecke.LevelHeckeAlgebra ℂ K.toSubgroup)ᵐᵒᵖ

/-- The Iwahori-decomposition form of VI.10.6 (iii)–(iv) implies the published form with the
V.5.2 basis-member conditions: the first clause of `StandardParabolicBasisMember` is the
Iwahori decomposition. -/
theorem fixedVectorCategoryStatements_of_standardIwahori
    (h : StandardIwahoriFixedVectorCategoryStatement.{uF, uV}) :
    FixedVectorCategoryStatements.{uF, uV} := by
  intro F _ _ _ _ G hG S i hi ν hν hstandard K₀ hK₀ hIwasawa K hK hKK₀ hnormal hBasis
  exact h F G hG S i hi ν hν hstandard K₀ hK₀ hIwasawa K hK hKK₀ hnormal
    (fun J hJ => (hBasis J hJ).choose_spec.choose_spec.2.1)

end Langlands.Jacquet
