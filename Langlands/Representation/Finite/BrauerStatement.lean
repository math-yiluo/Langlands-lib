import Langlands.Representation.Finite.Virtual
import Mathlib.RepresentationTheory.Irreducible
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Integral Brauer induction for actual complex representations

These proposition definitions use the genuine quotient-induction and split
Grothendieck constructions. None of the character or spanning conclusions is
assumed in the construction of the objects.
-/

noncomputable section

namespace Langlands.FiniteRep

universe uG

/-- Actual representation isomorphism classes admitting an irreducible representative.
The equality is in the genuine isomorphism-class quotient, not a character quotient. -/
def IrreducibleClass (G : Type uG) [Group G] :=
  {a : RepClass ℂ G //
    ∃ V : FDRep ℂ G, classOf V = a ∧ Representation.IsIrreducible V.ρ}

/-- Evaluation of integral irreducible coefficients in the split representation group. -/
def irreducibleExpansion (G : Type uG) [Group G] :
    (IrreducibleClass G →₀ ℤ) →ₗ[ℤ] VirtualRep ℂ G :=
  Finsupp.linearCombination ℤ (fun a : IrreducibleClass G => ofClass a.1)

@[simp]
theorem irreducibleExpansion_single (G : Type uG) [Group G]
    (a : IrreducibleClass G) (n : ℤ) :
    irreducibleExpansion G (Finsupp.single a n) = n • ofClass a.1 := by
  simp [irreducibleExpansion]

/-- Evaluation of signed integral coefficients at genuine rank-one subgroup inductions. -/
def brauerExpansion (G : Type uG) [Group G] [Finite G] :
    (MonomialDatum ℂ G →₀ ℤ) →ₗ[ℤ] VirtualRep ℂ G :=
  Finsupp.linearCombination ℤ (fun d : MonomialDatum ℂ G =>
    ofClass (induce d.1 (classOf (oneDimensional d.2))))

@[simp]
theorem brauerExpansion_single (G : Type uG) [Group G] [Finite G]
    (d : MonomialDatum ℂ G) (n : ℤ) :
    brauerExpansion G (Finsupp.single d n) =
      n • ofClass (induce d.1 (classOf (oneDimensional d.2))) := by
  simp [brauerExpansion]

/-- The scalar characters used in finite-group induction have bounded finite order. -/
def FiniteRankOneOrderStatement (G : Type uG) [Group G] [Fintype G] : Prop :=
  ∀ (S : Subgroup G) (χ : S →* ℂˣ) (s : S), χ s ^ Nat.card S = 1

/-- The trace of actual induction has the normalized conjugation-sum formula.
The inverse is on the conjugating element, not on the subgroup character. -/
def FiniteInducedCharacterFormulaStatement
    (G : Type uG) [Group G] [Fintype G] : Prop := by
  classical
  exact ∀ (S : Subgroup G) (V : FDRep ℂ S) (g : G),
    (induceRep S V).character g =
      (Nat.card S : ℂ)⁻¹ *
        ∑ x : G, if h : x⁻¹ * g * x ∈ S then V.character ⟨x⁻¹ * g * x, h⟩ else 0

/-- Actual finite-index induction multiplies the dimension by the subgroup index. -/
def FiniteInducedDegreeStatement (G : Type uG) [Group G] [Fintype G] : Prop :=
  ∀ (S : Subgroup G) (V : FDRep ℂ S),
    Module.finrank ℂ (induceRep S V) = S.index * Module.finrank ℂ V

/-- Character realization is faithful on the genuine split integral representation group. -/
def FiniteVirtualCharacterFaithfulnessStatement
    (G : Type uG) [Group G] [Fintype G] : Prop :=
  Function.Injective (virtualCharacter (k := ℂ) (G := G))

/-- Actual irreducible classes freely generate the split integral representation group. -/
def FiniteIrreducibleBasisStatement (G : Type uG) [Group G] [Fintype G] : Prop :=
  Function.Bijective (irreducibleExpansion G)

/-- Integral Brauer induction in the representation group: every virtual class is
a finite signed integer sum of classes of rank-one subgroup inductions. -/
def IntegralBrauerSpanningStatement (G : Type uG) [Group G] [Fintype G] : Prop :=
  Function.Surjective (brauerExpansion G)

/-- The integer lattice generated by genuine induced rank-one characters is the
whole virtual-character image. This asserts equality, not merely finite index. -/
def IntegralBrauerCharacterLatticeStatement
    (G : Type uG) [Group G] [Fintype G] : Prop :=
  inducedCharacterLattice (k := ℂ) (G := G) = virtualCharacters (k := ℂ) (G := G)

/-- The finite complex Brauer and character-realization prerequisites.
No conjunct is an assumed instance, field, or project axiom. -/
def FiniteBrauerTheoryStatement (G : Type uG) [Group G] [Fintype G] : Prop :=
  FiniteRankOneOrderStatement G ∧
  FiniteInducedCharacterFormulaStatement G ∧
  FiniteInducedDegreeStatement G ∧
  FiniteVirtualCharacterFaithfulnessStatement G ∧
  FiniteIrreducibleBasisStatement G ∧
  IntegralBrauerSpanningStatement G ∧
  IntegralBrauerCharacterLatticeStatement G

end Langlands.FiniteRep
