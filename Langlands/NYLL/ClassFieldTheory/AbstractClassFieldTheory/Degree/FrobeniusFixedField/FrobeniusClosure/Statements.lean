import Langlands.NYLL.ClassFieldTheory.AbstractClassFieldTheory.Degree.FrobeniusFixedField.FrobeniusClosure.Definitions

/-!
# Targets about the Frobenius exponent and the closed subgroup generated by a Frobenius lift

Modified by Worker 5264: state the source theorems M014.013
`frobeniusExponent_pos`, M014.014 `extensionNormalizedDegree_frobenius_eq_pow`,
M014.027 `frobeniusInClosure_topologicallyGenerates`, M014.038
`frobeniusClosure_totallyDisconnectedSpace` and M014.039
`frobeniusFixedField_finiteIndex` of the pinned NYLL FrobeniusFixedField
source as Prop-valued Statement definitions. Prefix the namespace with
Langlands.NYLL, append `Statement` to each name, expand
`extensionSubgroup K.field L hLK` to `L.toSubgroup.subgroupOf K.field.toSubgroup`,
keep the source universe and variable declarations, parameters and binder
kinds, and omit the proofs. The option `linter.unusedVariables` is disabled
for the M014.039 target, whose source hypothesis `hLfinite` is used only by
the omitted proof.
See the paired Markdown and licenses/NYLL/LICENSE and NOTICE.
-/

namespace Langlands.NYLL.ClassFormation

noncomputable section

universe u

variable {G : Type u} [Group G] [TopologicalSpace G]

namespace DegreeData

/-- Target: the Frobenius exponent attached to a finite extension is strictly positive. -/
def frobeniusExponent_posStatement (D : DegreeData G) (K : FiniteResidueAbstractField D) (L :
  ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) : Prop :=
    0 < D.frobeniusExponent K L hLK σ

/-- Target: the normalized degree of Frobenius is the corresponding natural profinite power. -/
def extensionNormalizedDegree_frobenius_eq_powStatement (D : DegreeData G)
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) : Prop :=
    D.extensionNormalizedDegree K L hLK σ.1 =
      (Multiplicative.ofAdd (1 : ZHat)) ^
          D.frobeniusExponent K L hLK σ

/-- Target: by construction, `σ` topologically generates `Γ`. -/
def frobeniusInClosure_topologicallyGeneratesStatement
    (D : DegreeData G) [IsTopologicalGroup G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) : Prop :=
    TopologicallyGenerates
      ({D.frobeniusInClosure K L hLK σ} : Set
        (D.frobeniusClosure K L hLK σ))

/-- Target: the closed cyclic group `Γ` is totally disconnected. -/
def frobeniusClosure_totallyDisconnectedSpaceStatement (D : DegreeData G)
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    [TotallyDisconnectedSpace G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) : Prop :=
    TotallyDisconnectedSpace (D.frobeniusClosure K L hLK σ)

set_option linter.unusedVariables false in
/-- Target: finiteness of the Frobenius fixed field, in the Galois-dual form: the closed
subgroup `Γ = closure ⟨σ⟩` has finite index in `G(\widetilde L|K)`, hence its
fixed field `Σ` is finite over `K`. -/
def frobeniusFixedField_finiteIndexStatement (D : DegreeData G)
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    [hLfinite : Finite (K.field.toSubgroup ⧸ L.toSubgroup.subgroupOf K.field.toSubgroup)]
    (σ : D.FrobeniusElements K L hLK) : Prop :=
    Finite
      ((K.field.toSubgroup ⧸ D.extensionInertiaWithin K.field L hLK) ⧸
        (D.frobeniusClosure K L hLK σ).toSubgroup)

end DegreeData

end
end Langlands.NYLL.ClassFormation
