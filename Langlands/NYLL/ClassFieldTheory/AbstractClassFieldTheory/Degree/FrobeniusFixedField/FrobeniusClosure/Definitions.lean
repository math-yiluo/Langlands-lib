import Langlands.NYLL.ClassFieldTheory.AbstractClassFieldTheory.Degree.FrobeniusLift.FrobeniusElements.Definitions
import Langlands.NYLL.GaloisCohomology.ProfiniteIntegers.TopologicalGeneration.Definitions

/-!
# The Frobenius exponent and the closed subgroup generated by a Frobenius lift

Modified by Worker 5264: extract M014.012 `frobeniusExponent`, M014.023
`frobeniusClosure`, M014.024 `frobeniusInClosure` and the instance M014.025
`frobeniusClosure_isTopologicalGroup` from the pinned NYLL
FrobeniusFixedField source with the Langlands.NYLL namespace prefix. As in the
published sibling modules, `extensionSubgroup K.field L hLK` is expanded to its
exact Mathlib body `L.toSubgroup.subgroupOf K.field.toSubgroup`. The source
imports are replaced by focused published imports. The source universe and
variable declarations, docstrings, binders and construction bodies are
retained. See the paired Markdown and licenses/NYLL/LICENSE and NOTICE.
-/

namespace Langlands.NYLL.ClassFormation

noncomputable section

universe u

variable {G : Type u} [Group G] [TopologicalSpace G]

namespace DegreeData

/-- The positive integer `d_K(σ)` attached to a Frobenius lift. -/
def frobeniusExponent (D : DegreeData G) (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) : ℕ :=
  Exists.choose σ.2

/-- The closed cyclic subgroup `Γ = closure ⟨σ⟩` fixing the field `Σ`
of the Frobenius fixed-field theorem. -/
def frobeniusClosure (D : DegreeData G) [IsTopologicalGroup G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) :
    ClosedSubgroup
      (K.field.toSubgroup ⧸ D.extensionInertiaWithin K.field L hLK) :=
  closedSubgroupGenerated
    (Set.range (fun _ : Unit => σ.1))

/-- The chosen Frobenius lift, regarded as an element of `Γ`. -/
def frobeniusInClosure (D : DegreeData G) [IsTopologicalGroup G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) :
    D.frobeniusClosure K L hLK σ :=
  closedSubgroupGeneratedMap (fun _ : Unit => σ.1) ()

/-- The closure of the Frobenius-generated subgroup inherits a topological group structure. -/
instance frobeniusClosure_isTopologicalGroup
    (D : DegreeData G) [IsTopologicalGroup G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) :
    IsTopologicalGroup (D.frobeniusClosure K L hLK σ) := by
  change IsTopologicalGroup
    ↑((D.frobeniusClosure K L hLK σ).toSubgroup)
  infer_instance

end DegreeData

end
end Langlands.NYLL.ClassFormation
