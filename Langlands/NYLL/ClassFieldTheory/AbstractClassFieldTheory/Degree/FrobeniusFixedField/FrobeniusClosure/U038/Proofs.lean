import Langlands.NYLL.ClassFieldTheory.AbstractClassFieldTheory.Degree.FrobeniusFixedField.FrobeniusClosure.Statements
import Langlands.NYLL.GaloisCohomology.Topology.TotallyDisconnectedQuotients.U001.Proofs

/-!
# The closed subgroup generated by a Frobenius lift is totally disconnected
-/

namespace Langlands.NYLL.ClassFormation

universe u

variable {G : Type u} [Group G] [TopologicalSpace G]

namespace DegreeData

/-- The closed cyclic group `Γ` is totally disconnected. -/
theorem frobeniusClosure_totallyDisconnectedSpace (D : DegreeData G)
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    [TotallyDisconnectedSpace G]
    (K : FiniteResidueAbstractField D) (L : ClosedSubgroup G)
    (hLK : L.toSubgroup ≤ K.field.toSubgroup)
    [hLnormal : (L.toSubgroup.subgroupOf K.field.toSubgroup).Normal]
    (σ : D.FrobeniusElements K L hLK) :
    frobeniusClosure_totallyDisconnectedSpaceStatement D K L hLK σ := by
  show TotallyDisconnectedSpace (D.frobeniusClosure K L hLK σ)
  let : CompactSpace K.field.toSubgroup := by
    change CompactSpace K.field
    infer_instance
  have hN : IsClosed
      (D.extensionInertiaWithin K.field L hLK : Set K.field.toSubgroup) := by
    have hE : IsClosed
        (L.toSubgroup.subgroupOf K.field.toSubgroup : Set K.field.toSubgroup) := by
      change IsClosed ((fun x : K.field.toSubgroup => (x : G)) ⁻¹' (L : Set G))
      exact L.isClosed'.preimage continuous_subtype_val
    have hI : IsClosed (D.fieldInertiaWithin K.field : Set K.field.toSubgroup) := by
      let : T2Space ZHatMul := by
        change T2Space ZHat
        infer_instance
      change IsClosed {x : K.field.toSubgroup | D.degree x.1 = 1}
      exact isClosed_eq
        (D.restrictedDegree K.field).continuous_toFun continuous_const
    change IsClosed
      ((L.toSubgroup.subgroupOf K.field.toSubgroup ⊓ D.fieldInertiaWithin K.field) :
        Set K.field.toSubgroup)
    exact hE.inter hI
  let Q := K.field.toSubgroup ⧸ D.extensionInertiaWithin K.field L hLK
  let : TotallyDisconnectedSpace Q :=
    QuotientGroup.totallyDisconnectedSpace_of_isClosed
      (D.extensionInertiaWithin K.field L hLK) hN
  infer_instance

end DegreeData

end Langlands.NYLL.ClassFormation
