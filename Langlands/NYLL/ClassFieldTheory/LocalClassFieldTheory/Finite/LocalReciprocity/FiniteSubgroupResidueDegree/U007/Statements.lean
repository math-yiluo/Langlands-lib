import Langlands.NYLL.ClassFieldTheory.LocalClassFieldTheory.Finite.LocalReciprocity.FiniteSubgroupResidueDegree.U001.Definitions
import Langlands.NYLL.ClassFieldTheory.LocalClassFieldTheory.Finite.LocalReciprocity.LocalResidueDatum.U020.Definitions

/-!
# The image of a closed subgroup under the local residue action

A closed proposition: for a nonarchimedean local field `K` and a closed
subgroup `H` of `Gal(SeparableClosure K / K)`, the image of `H` under the
local residue action is the subgroup of automorphisms of the selected
residue field that fix the residue subfield generated by the residue field
of the fixed field of `H`.
-/

namespace Langlands.NYLL.LocalClassFieldTheory

/-- States the theorem `localAbstractFixedResidueAction_map_eq_fixingSubgroup`:
the image of `H` under the local residue action is exactly the subgroup
fixing the residue subfield of its fixed field. -/
def localAbstractFixedResidueAction_map_eq_fixingSubgroupStatement : Prop :=
  ∀ (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    (H : ClosedSubgroup (Gal(SeparableClosure K/K))),
    H.toSubgroup.map (localSeparableResidueAlgAction K).toMonoidHom =
      (localAbstractFixedResidueIntermediateField K H).fixingSubgroup

end Langlands.NYLL.LocalClassFieldTheory
