import Langlands.NYLL.ClassFieldTheory.LocalClassFieldTheory.Finite.LocalReciprocity.FiniteSubgroupResidueDegree.U002.Definitions
import Langlands.NYLL.ClassFieldTheory.AbstractClassFieldTheory.Degree.Fields.U005.Proofs
import Langlands.NYLL.GaloisCohomology.Cyclic.NormKernelVanishing.Extension.Definitions

/-!
# Finite abstract fields have finite residue subfields

A closed proposition: for a nonarchimedean local field `K` and a closed
subgroup `H` of `Gal(SeparableClosure K / K)` whose abstract field is finite
over the distinguished base, the residue subfield of the selected residue
field generated by the residue field of the fixed field of `H` is finite
dimensional over the residue field of `K`.
-/

namespace Langlands.NYLL.LocalClassFieldTheory
open CyclicCohomology RamificationTheory ClassFormation
open HilbertRamification.ValuationSubring

section

attribute [local instance] Langlands.NYLL.PortInternal.M250.d002
  Langlands.NYLL.PortInternal.M250.d003 Langlands.NYLL.PortInternal.M250.d004

/-- States the theorem `localAbstractFixedResidueIntermediateField_finiteDimensional`:
a finite abstract field has a genuinely finite residue subfield inside the
selected residue algebraic closure. -/
def localAbstractFixedResidueIntermediateField_finiteDimensionalStatement : Prop :=
  ∀ (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    (H : ClosedSubgroup (Gal(SeparableClosure K/K)))
    [Finite
      ((baseField (Gal(SeparableClosure K/K))).toSubgroup ⧸
        extensionSubgroup
          (baseField (Gal(SeparableClosure K/K))) H
          (le_baseField H))],
    FiniteDimensional
      (decompositionResidueField K (localSeparableValuationSubring K))
      (localAbstractFixedResidueIntermediateField K H)

end

end Langlands.NYLL.LocalClassFieldTheory
