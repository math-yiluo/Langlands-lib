/-!
# Uniqueness of the chosen valuation ring of the separable closure (NYLL M249.009)

Every valuation ring of `SeparableClosure K` whose valuation extends the
canonical valuation of a nonarchimedean local field `K` is the chosen ring
`localSeparableValuationSubring K`. Equality is checked one element at a
time, on the finite separable intermediate field the element generates,
where any two extensions of the base valuation are equivalent.
-/

namespace Langlands.NYLL.LocalClassFieldTheory

open Langlands.NYLL.LocalFieldTheory

attribute [local instance] Langlands.NYLL.PortInternal.M249.d001
  Langlands.NYLL.PortInternal.M249.d002

/-- The extension valuation on the separable closure is independent of the
auxiliary Chevalley choice.  Equality is checked at the finite separable
field generated by one element and follows there from Henselian uniqueness. -/
theorem localSeparableValuationSubring_eq_of_hasExtension :
    localSeparableValuationSubring_eq_of_hasExtensionStatement := by
  intro K _ _ _ _ B _
  -- Source M249.007 (with the private M249.004 inlined): the chosen ring
  -- pulls back to the valuation ring of the canonical valuation of `K`.
  have hpullback : ∀ x : K,
      algebraMap K (SeparableClosure K) x ∈
          (localSeparableValuationSubring K).toSubring ↔
        x ∈ (localCompleteDVF K).valuation.valuationSubring := by
    intro x
    obtain ⟨_, _, hpb⟩ := Classical.choose_spec
      (Langlands.NYLL.ValuationTheory.DiscreteValuationField.Valuation.exists_extension_valuationSubring
        (L := AlgebraicClosure K) (localCompleteDVF K).valuation)
    change algebraMap (SeparableClosure K) (AlgebraicClosure K)
        (algebraMap K (SeparableClosure K) x) ∈
          Langlands.NYLL.PortInternal.M249.d003 K ↔ _
    rw [← IsScalarTower.algebraMap_apply K (SeparableClosure K) (AlgebraicClosure K)]
    exact hpb x
  -- Source M249.008: the chosen valuation extends the canonical valuation.
  have : (localCompleteDVF K).valuation.HasExtension
      (localSeparableValuationSubring K).valuation :=
    Langlands.NYLL.ValuationTheory.DiscreteValuationField.Valuation.hasExtension_valuation_of_valuationSubring_pullback
      (localCompleteDVF K).valuation (localSeparableValuationSubring K) hpullback
  ext z
  let E : IntermediateField K (SeparableClosure K) :=
    IntermediateField.adjoin K ({z} : Set (SeparableClosure K))
  have : FiniteDimensional K E :=
    IntermediateField.adjoin.finiteDimensional
      (Algebra.IsIntegral.isIntegral z)
  have : Algebra.IsSeparable K E := inferInstance
  let Ares := Langlands.NYLL.RamificationTheory.ValuationSubring.restrictIntermediateField
    (localSeparableValuationSubring K) E
  let Bres := Langlands.NYLL.RamificationTheory.ValuationSubring.restrictIntermediateField B E
  have : (localCompleteDVF K).valuation.HasExtension Ares.valuation :=
    Langlands.NYLL.RamificationTheory.ValuationSubring.restrictIntermediateField_hasExtension
      (localCompleteDVF K).valuation (localSeparableValuationSubring K) E
  have : (localCompleteDVF K).valuation.HasExtension Bres.valuation :=
    Langlands.NYLL.RamificationTheory.ValuationSubring.restrictIntermediateField_hasExtension
      (localCompleteDVF K).valuation B E
  -- Finite-separable uniqueness: both restrictions are equivalent to the
  -- chosen valuation on `E`, hence to each other.
  have hA : (chosenLocalExtensionCompleteDVF K E).valuation.IsEquiv Ares.valuation :=
    chosenLocalExtension_uniqueValuationExtension.{0} K E Ares.valuation
  have hB : (chosenLocalExtensionCompleteDVF K E).valuation.IsEquiv Bres.valuation :=
    chosenLocalExtension_uniqueValuationExtension.{0} K E Bres.valuation
  have hAB : Ares = Bres := by
    have h := (_root_.Valuation.isEquiv_iff_valuationSubring _ _).mp (hA.symm.trans hB)
    rwa [ValuationSubring.valuationSubring_valuation,
      ValuationSubring.valuationSubring_valuation] at h
  let zE : E :=
    ⟨z, IntermediateField.subset_adjoin (F := K)
      (S := ({z} : Set (SeparableClosure K))) (Set.mem_singleton z)⟩
  change zE ∈ Ares ↔ zE ∈ Bres
  rw [hAB]

end Langlands.NYLL.LocalClassFieldTheory
