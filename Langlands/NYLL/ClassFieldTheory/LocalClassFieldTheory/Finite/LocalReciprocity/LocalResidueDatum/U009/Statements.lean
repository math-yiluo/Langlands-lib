import Langlands.NYLL.ClassFieldTheory.LocalClassFieldTheory.Finite.LocalReciprocity.LocalResidueDatum.U006.Definitions
import Langlands.NYLL.ValuedFieldTheory.Ramification.HilbertRamification.ValuationSubring.Definitions

/-!
# Uniqueness of the chosen valuation ring of the separable closure: statements

Two closed propositions about the valuation ring
`localSeparableValuationSubring K` of `SeparableClosure K` chosen for a
nonarchimedean local field `K`: it equals every valuation ring of
`SeparableClosure K` whose valuation extends the canonical discrete
valuation of `K`, and its decomposition group over `K` is the whole group.
-/

namespace Langlands.NYLL.LocalClassFieldTheory

open Langlands.NYLL.LocalFieldTheory
open Langlands.NYLL.RamificationTheory.HilbertRamification.ValuationSubring

/-- The extension valuation on the separable closure is independent of the
auxiliary Chevalley choice.  Equality is checked at the finite separable
field generated by one element and follows there from Henselian uniqueness. -/
def localSeparableValuationSubring_eq_of_hasExtensionStatement : Prop :=
  ∀ (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    (B : ValuationSubring (SeparableClosure K))
    [(localCompleteDVF K).valuation.HasExtension B.valuation],
    localSeparableValuationSubring K = B

/-- Every automorphism of the separable closure preserves the unique
extension of the Henselian local valuation. -/
def localSeparableDecompositionGroup_eq_topStatement : Prop :=
  ∀ (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K],
    decompositionGroup K (localSeparableValuationSubring K) = ⊤

end Langlands.NYLL.LocalClassFieldTheory
