import Mathlib.FieldTheory.Galois.Basic
import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.RepresentationTheory.Homological.TateCohomology.Basic
import Mathlib.RepresentationTheory.Rep.Basic
import Mathlib.RingTheory.Valuation.Extension

/-!
# Finiteness of unit Tate `H⁰` for a cyclic local extension: statement

The exact proposition of the source theorem asserting that, for a finite
Galois extension of nonarchimedean local fields whose Galois group is
generated by a given element, the Tate cohomology group `Ĥ⁰(Gal(L/K), Lˣ)`
is finite.
-/

namespace Langlands.NYLL.LocalClassFieldTheory

noncomputable section

open scoped ValuativeRel

set_option linter.unusedVariables false in
/-- Source M157.004: for a generator `g` of `Gal(L/K)`, the degree-zero Tate
cohomology of the Galois action on `Lˣ` is finite. -/
def localFieldUnitsTateH0FiniteOfGeneratorStatement
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    [ValuativeRel L] [UniformSpace L] [IsUniformAddGroup L]
    [IsNonarchimedeanLocalField L]
    [Valuation.HasExtension (ValuativeRel.valuation K) (ValuativeRel.valuation L)]
    [IsIntegralClosure 𝒪[L] 𝒪[K] L] [Module.Finite 𝒪[K] 𝒪[L]]
    (g : Gal(L/K))
    (hg : ∀ sigma : Gal(L / K), sigma ∈ Subgroup.zpowers g) : Prop :=
  Finite (tateCohomology (Rep.ofAlgebraAutOnUnits K L) 0)

end

end Langlands.NYLL.LocalClassFieldTheory
