import Langlands.NYLL.ClassFieldTheory.LocalClassFieldTheory.ClassFormation.Valuation.IntegerDefinitions
import Langlands.NYLL.GaloisCohomology.Cyclic.Herbrand.HerbrandFiniteness.Definitions
import Langlands.NYLL.GaloisCohomology.Cyclic.Herbrand.HerbrandLowDegree.Core.Definitions
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.RingTheory.Valuation.Extension

/-!
# The integer-unit Herbrand witness of the local class-field axiom: statement

The exact proposition of the source theorem asserting that, for a finite
Galois extension of nonarchimedean local fields whose Galois group is
generated by a given element `g`, the Herbrand quotient of the integer units
`𝒪[L]ˣ` with respect to `g` is defined and equals `1`.
-/

namespace Langlands.NYLL.LocalClassFieldTheory

noncomputable section

open scoped ValuativeRel
open Langlands.NYLL.CyclicCohomology.ProfiniteCohomology.Herbrand

set_option linter.unusedVariables false in
/-- Source M157.001 (the integer-unit Herbrand witness): for a generator `g`
of `Gal(L/K)`, with `Gal(L/K)` acting on `𝒪[L]ˣ` through integral-closure
restriction, the Herbrand quotient of `𝒪[L]ˣ` with respect to `g` is defined
(both low-degree quotients are finite) and equals `1`. -/
def exists_localIntegerUnitsHerbrandDefinedAndEqOneStatement
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    [ValuativeRel L] [UniformSpace L] [IsUniformAddGroup L]
    [IsNonarchimedeanLocalField L]
    [Valuation.HasExtension (ValuativeRel.valuation K) (ValuativeRel.valuation L)]
    [IsIntegralClosure 𝒪[L] 𝒪[K] L] [Module.Finite 𝒪[K] 𝒪[L]]
    (g : Gal(L/K))
    (hg : ∀ sigma : Gal(L / K), sigma ∈ Subgroup.zpowers g) : Prop :=
  letI := galoisGroupIntegerUnitsMulDistribMulActionOfIsIntegralClosure K L
  ∃ hU : HerbrandQuotientDefined (Gal(L / K)) 𝒪[L]ˣ g,
    @herbrandQuotient (Gal(L / K)) 𝒪[L]ˣ _ _ _
      (galoisGroupIntegerUnitsMulDistribMulActionOfIsIntegralClosure K L)
      g hU.1 hU.2 = 1

end

end Langlands.NYLL.LocalClassFieldTheory
