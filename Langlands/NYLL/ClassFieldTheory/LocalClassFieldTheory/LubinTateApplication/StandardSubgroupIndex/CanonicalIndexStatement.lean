import Mathlib.GroupTheory.Index
import Mathlib.SetTheory.Cardinal.Finite
import Langlands.NYLL.ClassFieldTheory.LubinTate.FiniteLevel.StandardLocalField.UniformizerProof
import Langlands.NYLL.ClassFieldTheory.LubinTate.FiniteLevel.NormSubgroup.BaseUniformizerUnit.Definitions
import Langlands.NYLL.ValuedFieldTheory.LocalField.NonarchimedeanLocalField.StandardOpenSubgroups.UniformizerPrincipalSubgroup

/-!
# The canonical standard subgroup index target

The source index formula for the actual canonical Lubin--Tate uniformizer
and the `(n + 1)`-st principal units, packaged as a proposition.
-/

open scoped ValuativeRel

namespace Langlands.NYLL.LubinTate

open LocalFieldTheory

/-- The subgroup generated by the canonical Lubin--Tate uniformizer and
`U^(n+1)` has the expected standard finite-level index. -/
def standardLubinTateCanonicalUniformizerPrincipalSubgroup_indexStatement
    (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K] (n : ℕ) : Prop :=
  (LocalFieldTheory.uniformizerPrincipalSubgroup K
      (standardLubinTateBaseUniformizerUnit
        (standardLocalFieldUniformizer_isUniformizer K))
      1 (n + 1)).index =
    (Nat.card 𝓀[K] - 1) * Nat.card 𝓀[K] ^ n

end Langlands.NYLL.LubinTate
