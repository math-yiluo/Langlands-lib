import Langlands.NYLL.GaloisCohomology.Cyclic.Herbrand.HerbrandLowDegree.Basic.Statements

/-!
# A trivial coboundary for a generator is fixed by the group (NYLL M113.005)

If every element of `G` lies in the cyclic subgroup generated by `σ` and
`a^(σ-1) = 1`, then `g • a = a` for every `g : G`.
-/

namespace Langlands.NYLL.CyclicCohomology.ProfiniteCohomology.Herbrand

universe uG uA

/-- If `σ` generates `G`, then a trivial `σ`-coboundary is genuinely fixed by
all of `G`. -/
theorem fixed_of_forall_mem_zpowers_of_sigmaMinusOne_eq_one :
    fixed_of_forall_mem_zpowers_of_sigmaMinusOne_eq_oneStatement.{uG, uA} := by
  intro G A _ _ _ σ a hgen hσ g
  -- Inlined source proof of M113.004 at `g`, with `hg := hgen g`.
  have hσa : σ • a = a := by
    exact mul_inv_eq_one.mp (by simpa [sigmaMinusOne] using hσ)
  exact smul_eq_self_of_mem_zpowers (hgen g) hσa

end Langlands.NYLL.CyclicCohomology.ProfiniteCohomology.Herbrand
