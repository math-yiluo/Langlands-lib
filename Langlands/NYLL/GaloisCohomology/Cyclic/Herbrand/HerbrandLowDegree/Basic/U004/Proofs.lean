import Langlands.NYLL.GaloisCohomology.Cyclic.Herbrand.HerbrandLowDegree.Basic.Statements

/-!
# A trivial `σ`-coboundary is fixed by `⟨σ⟩` (NYLL M113.004)

If `a^(σ-1) = 1`, then every element `g` of the cyclic subgroup generated by
`σ` fixes `a`.
-/

namespace Langlands.NYLL.CyclicCohomology.ProfiniteCohomology.Herbrand

universe uG uA

/-- A `σ`-coboundary equal to `1` makes every element of the cyclic subgroup
generated by `σ` fix the point. -/
theorem smul_eq_of_mem_zpowers_of_sigmaMinusOne_eq_one :
    smul_eq_of_mem_zpowers_of_sigmaMinusOne_eq_oneStatement.{uG, uA} := by
  intro G A _ _ _ σ g a hg hσ
  have hσa : σ • a = a := by
    exact mul_inv_eq_one.mp (by simpa [sigmaMinusOne] using hσ)
  exact smul_eq_self_of_mem_zpowers hg hσa

end Langlands.NYLL.CyclicCohomology.ProfiniteCohomology.Herbrand
