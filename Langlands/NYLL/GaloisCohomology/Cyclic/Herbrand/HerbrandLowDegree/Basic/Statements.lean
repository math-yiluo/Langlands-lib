import Langlands.NYLL.GaloisCohomology.Cyclic.Herbrand.HerbrandLowDegree.Basic.Definitions

/-!
# Low-degree Herbrand quotients: Tate norm, `σ - 1` and cardinality targets

Modified by Worker 5086: extract the asserted types of M113.004–M113.008,
M113.010–M113.012, M113.015–M113.017, M113.066 and M113.068 from the pinned
NYLL `Nyll/GaloisCohomology/Cyclic/Herbrand/HerbrandLowDegree/Basic.lean` as
closed Prop-valued definitions. Prefix the source namespace with
`Langlands.NYLL`, append `Statement` to each theorem name, and quantify the
complete elaborated telescope (the section variables of source lines 62–64
that each theorem includes after its `omit`, followed by its own binders)
without changing binder kinds or order. Reuse the adapted definitions of the
sibling `Definitions` module through the import above; omit all source proof
bodies and the `@[simp]` attribute of `tateNorm_one`. See the paired Markdown and
`licenses/NYLL/LICENSE` and `licenses/NYLL/NOTICE`.
-/

namespace Langlands.NYLL.CyclicCohomology

noncomputable section

open scoped BigOperators

namespace ProfiniteCohomology
namespace Herbrand

universe uG uA uB uC

-- Preserve the source hypothesis names even when the conclusions do not mention them.
set_option linter.unusedVariables false in
/-- A `σ`-coboundary equal to `1` makes every element of the cyclic subgroup
generated by `σ` fix the point. -/
def smul_eq_of_mem_zpowers_of_sigmaMinusOne_eq_oneStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [CommGroup A]
    [MulDistribMulAction G A]
    {σ g : G} {a : A} (hg : g ∈ Subgroup.zpowers σ)
    (hσ : sigmaMinusOne G A σ a = 1),
    g • a = a

set_option linter.unusedVariables false in
/-- If `σ` generates `G`, then a trivial `σ`-coboundary is genuinely fixed by
all of `G`. -/
def fixed_of_forall_mem_zpowers_of_sigmaMinusOne_eq_oneStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [CommGroup A]
    [MulDistribMulAction G A]
    {σ : G} {a : A} (hgen : ∀ g : G, g ∈ Subgroup.zpowers σ)
    (hσ : sigmaMinusOne G A σ a = 1),
    ∀ g : G, g • a = a

/-- First-isomorphism cardinality source for finite exactness calculations:
the cardinality of the source of a group homomorphism is the product of the
cardinalities of its kernel and range. -/
def monoidHom_card_eq_card_ker_mul_card_rangeStatement : Prop :=
  ∀ {X : Type uA} {Y : Type uB} [Group X] [Group Y] [Finite X] (f : X →* Y),
    Nat.card X = Nat.card (MonoidHom.ker f) * Nat.card (MonoidHom.range f)

set_option linter.unusedVariables false in
/-- Cardinality source for one exact spot of a group-hom sequence.  If
`range f = ker g`, then the middle group has cardinality
`#range(f) * #range(g)`. -/
def monoidHom_card_eq_card_range_mul_card_range_of_exactStatement : Prop :=
  ∀ {X : Type uA} {Y : Type uB} {Z : Type uC} [Group X] [Group Y] [Group Z]
    [Finite Y]
    (f : X →* Y) (g : Y →* Z)
    (hexact : MonoidHom.range f = MonoidHom.ker g),
    Nat.card Y = Nat.card (MonoidHom.range f) * Nat.card (MonoidHom.range g)

set_option linter.unusedVariables false in
/-- If `H ≤ K`, viewing `H` as a subgroup of `K` does not change its
cardinality. -/
def card_subgroupOf_eq_cardStatement : Prop :=
  ∀ {X : Type uA} [Group X] [Finite X] {H K : Subgroup X} (hHK : H ≤ K),
    Nat.card (H.subgroupOf K) = Nat.card H

set_option linter.unusedVariables false in
/-- An equivariant homomorphism commutes with the Tate norm. -/
def map_tateNormStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} {B : Type uB} [Group G] [Fintype G]
    [CommGroup A] [CommGroup B]
    [MulDistribMulAction G A] [MulDistribMulAction G B]
    (f : A →* B)
    (hf : ∀ (g : G) (a : A), f (g • a) = g • f a) (a : A),
    f (tateNorm G A a) = tateNorm G B (f a)

/-- The finite-group norm is multiplicative. -/
def tateNorm_mulStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [Fintype G] [CommGroup A]
    [MulDistribMulAction G A] (a b : A),
    tateNorm G A (a * b) = tateNorm G A a * tateNorm G A b

/-- The Tate norm of the identity is the identity. -/
def tateNorm_oneStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [Fintype G] [CommGroup A]
    [MulDistribMulAction G A],
    tateNorm G A 1 = 1

/-- The Tate norm of an inverse is the inverse Tate norm. -/
def tateNorm_invStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [Fintype G] [CommGroup A]
    [MulDistribMulAction G A] (a : A),
    tateNorm G A a⁻¹ = (tateNorm G A a)⁻¹

set_option linter.unusedVariables false in
/-- An equivariant homomorphism commutes with the sigma-minus-one operator. -/
def map_sigmaMinusOneStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} {B : Type uB} [Group G]
    [CommGroup A] [CommGroup B]
    [MulDistribMulAction G A] [MulDistribMulAction G B]
    (f : A →* B)
    (hf : ∀ (g : G) (a : A), f (g • a) = g • f a) (σ : G) (a : A),
    f (sigmaMinusOne G A σ a) = sigmaMinusOne G B σ (f a)

/-- The multiplicative coboundary `a ↦ a^(σ-1)` is multiplicative. -/
def sigmaMinusOne_mulStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [CommGroup A]
    [MulDistribMulAction G A] (σ : G) (a b : A),
    sigmaMinusOne G A σ (a * b) = sigmaMinusOne G A σ a * sigmaMinusOne G A σ b

/-- The norm of a multiplicative coboundary is trivial. This is the calculation
`N_G(b^(σ-1)) = 1` used in the low-degree cyclic-cohomology exact sequence. -/
def tateNorm_sigmaMinusOne_eq_oneStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [Fintype G] [CommGroup A]
    [MulDistribMulAction G A] (σ : G) (a : A),
    tateNorm G A (sigmaMinusOne G A σ a) = 1

/-- The norm is fixed by every group element, placing `N_G b` in `A^G` in the
low-degree cyclic-cohomology exact sequence. -/
def smul_tateNorm_eqStatement : Prop :=
  ∀ {G : Type uG} {A : Type uA} [Group G] [Fintype G] [CommGroup A]
    [MulDistribMulAction G A] (h : G) (a : A),
    h • tateNorm G A a = tateNorm G A a

end Herbrand
end ProfiniteCohomology

end

end Langlands.NYLL.CyclicCohomology
