import Langlands.NYLL.GaloisCohomology.ProfiniteIntegers.TopologicalGeneration.Definitions

/-!
# Topological generation: density and functoriality targets

Modified by Worker 125: extract the asserted types of M007.002 and M007.005–010
from `Nyll/GaloisCohomology/ProfiniteIntegers/TopologicalGeneration.lean` at
`fbd320cd8b1b06487c58227e92eb135794267709` as closed Prop-valued definitions.
Prefix the source namespace with `Langlands.NYLL`, append `Statement` to each
theorem name, and quantify its complete elaborated telescope without changing
binder kinds. Reuse the published definitions through the import above; omit
all source proof bodies. See the paired Markdown and `licenses/NYLL/LICENSE`
and `licenses/NYLL/NOTICE`.
-/

namespace Langlands.NYLL.ClassFormation

open Set
open scoped Topology Pointwise

universe u v

/-- Topological generation is equivalently density of the generated abstract
subgroup. -/
def topologicallyGenerates_iff_denseStatement : Prop :=
  ∀ {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    {X : Set G},
    TopologicallyGenerates (G := G) X ↔
      Dense ((Subgroup.closure X : Subgroup G) : Set G)

/-- The canonical family topologically generates its closed generated
subgroup. -/
def closedSubgroupGeneratedMap_topologicallyGeneratesStatement : Prop :=
  ∀ {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    {A : Type v} (φ : A → G),
    TopologicallyGenerates
      (G := (closedSubgroupGenerated (G := G) (Set.range φ) : Subgroup G))
      (Set.range (closedSubgroupGeneratedMap (G := G) φ))

-- Preserve the source hypothesis names even when the conclusions do not mention them.
set_option linter.unusedVariables false in
/-- Membership in a closed generated subgroup is preserved by a continuous
homomorphism after mapping the generating set. -/
def map_mem_closedSubgroupGenerated_imageStatement : Prop :=
  ∀ {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (φ : G →ₜ* H) {X : Set G} {y : G}
    (hy : y ∈ (closedSubgroupGenerated (G := G) X : Subgroup G)),
    φ y ∈ (closedSubgroupGenerated (G := H) (φ '' X) : Subgroup H)

set_option linter.unusedVariables false in
/-- The singleton form of functoriality of closed topological generation. -/
def map_mem_closedSubgroupGenerated_singletonStatement : Prop :=
  ∀ {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (φ : G →ₜ* H) (x : G) {y : G}
    (hy : y ∈
      (closedSubgroupGenerated (G := G) ({x} : Set G) : Subgroup G)),
    φ y ∈
      (closedSubgroupGenerated (G := H) ({φ x} : Set H) : Subgroup H)

set_option linter.unusedVariables false in
/-- A dense image of the infinite cyclic group is topologically generated by
the image of `1`. -/
def topologicallyGenerates_singleton_of_denseRange_mintStatement : Prop :=
  ∀ {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (f : Multiplicative ℤ →* H) (hf : DenseRange f),
    TopologicallyGenerates
      (G := H) ({f (Multiplicative.ofAdd 1)} : Set H)

set_option linter.unusedVariables false in
/-- Topological generation pushes forward along a continuous surjective
homomorphism. -/
def topologicallyGenerates_image_of_continuousSurjectiveStatement : Prop :=
  ∀ {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (f : G →* H) (hf : Continuous f) (hfsurj : Function.Surjective f)
    {X : Set G} (hX : TopologicallyGenerates (G := G) X),
    TopologicallyGenerates (G := H) (f '' X)

set_option linter.unusedVariables false in
/-- Topological generation descends to a quotient by a normal subgroup. -/
def topologicallyGenerates_quotient_imageStatement : Prop :=
  ∀ {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (N : Subgroup G) [N.Normal]
    {X : Set G} (hX : TopologicallyGenerates (G := G) X),
    TopologicallyGenerates
      (G := G ⧸ N) ((QuotientGroup.mk' N) '' X)

end Langlands.NYLL.ClassFormation
