import Langlands.NYLL.GaloisCohomology.ProfiniteIntegers.TopologicalGeneration.Statements

/-!
# Continuous homomorphisms preserve closed generated membership

Proof of the published closed proposition that a continuous homomorphism
maps the closed subgroup generated by `X` into the closed subgroup generated
by the image of `X`.
-/

namespace Langlands.NYLL.ClassFormation

universe u v

/-- Membership in a closed generated subgroup is preserved by a continuous
homomorphism after mapping the generating set. -/
theorem map_mem_closedSubgroupGenerated_image :
    map_mem_closedSubgroupGenerated_imageStatement.{u, v} := by
  intro G _ _ _ H _ _ _ φ X y hy
  let K : Subgroup G :=
    (closedSubgroupGenerated (G := H) (φ '' X) : Subgroup H).comap
      (φ : G →* H)
  have hX : X ⊆ K := by
    intro x hx
    exact Subgroup.le_topologicalClosure _
      (Subgroup.subset_closure ⟨x, hx, rfl⟩)
  have hKclosed : IsClosed (K : Set G) := by
    change IsClosed {x : G | φ x ∈
      (closedSubgroupGenerated (G := H) (φ '' X) : Subgroup H)}
    exact (closedSubgroupGenerated (G := H) (φ '' X)).isClosed'.preimage
      φ.continuous
  exact
    (Subgroup.topologicalClosure_minimal _
      ((Subgroup.closure_le (K := K)).2 hX) hKclosed) hy

end Langlands.NYLL.ClassFormation
