import Langlands.NYLL.GaloisCohomology.ProfiniteIntegers.TopologicalGeneration.Statements

/-!
# Singleton functoriality of closed topological generation

A continuous homomorphism sends the closed subgroup generated by `x` into the
closed subgroup generated by its image.
-/

namespace Langlands.NYLL.ClassFormation

open Set
open scoped Topology Pointwise

universe u v

/-- The singleton form of functoriality of closed topological generation. -/
theorem map_mem_closedSubgroupGenerated_singleton :
    map_mem_closedSubgroupGenerated_singletonStatement.{u, v} := by
  intro G _ _ _ H _ _ _ φ x y hy
  -- The source's M007.006 argument, specialised to the generating set `{x}`.
  have himage :
      φ y ∈
        (closedSubgroupGenerated (G := H) (φ '' ({x} : Set G)) : Subgroup H) := by
    let K : Subgroup G :=
      (closedSubgroupGenerated (G := H) (φ '' ({x} : Set G)) : Subgroup H).comap
        (φ : G →* H)
    have hX : ({x} : Set G) ⊆ K := by
      intro z hz
      exact Subgroup.le_topologicalClosure _
        (Subgroup.subset_closure ⟨z, hz, rfl⟩)
    have hKclosed : IsClosed (K : Set G) := by
      change IsClosed {z : G | φ z ∈
        (closedSubgroupGenerated (G := H) (φ '' ({x} : Set G)) : Subgroup H)}
      exact (closedSubgroupGenerated (G := H) (φ '' ({x} : Set G))).isClosed'.preimage
        φ.continuous
    exact
      (Subgroup.topologicalClosure_minimal _
        ((Subgroup.closure_le (K := K)).2 hX) hKclosed) hy
  rw [Set.image_singleton] at himage
  exact himage

end Langlands.NYLL.ClassFormation
