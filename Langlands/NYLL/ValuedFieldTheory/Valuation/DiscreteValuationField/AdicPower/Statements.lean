import Mathlib.RingTheory.AdicCompletion.Functoriality

/-!
# Targets: adic completeness under extension of scalars and positive powers

Modified by Worker 5264, 15 November 2026: state the source theorems M105.002
`mem_map_algebraMap_pow_iff_mem_pow_smul_top`, M105.003
`mem_map_algebraMap_pow_smul_top_iff`, M105.004
`smodEq_map_algebraMap_pow_smul_top_iff`, M105.005
`isPrecomplete_map_algebraMap_iff`, M105.006
`isAdicComplete_map_algebraMap_iff`, M105.007 `isAdicComplete_map_ringEquiv`,
M105.011 `isHausdorff_of_isHausdorff_pow` and M105.012
`isPrecomplete_of_isPrecomplete_pow` of
`Nyll/ValuedFieldTheory/Valuation/DiscreteValuationField/AdicPower.lean` at
fbd320cd8b1b06487c58227e92eb135794267709 as Prop-valued Statement
definitions. Prefix the namespace with `Langlands.NYLL`, append `Statement`
to each name, omit the proofs, the unused variable line for `N` and the
rest of the source file, and turn off the unused-variable linter for the
hypothesis `hn` of M105.012, which the proposition does not mention. See the paired Markdown and
`licenses/NYLL/LICENSE` and `licenses/NYLL/NOTICE`.
-/

namespace Langlands.NYLL.ValuationTheory

noncomputable section

namespace DiscreteValuationField

variable {R : Type*} [CommRing R]
variable {M : Type*} [AddCommGroup M] [Module R M]

/-- Target: membership in a power of the extended ideal is the same as
membership in the corresponding base-adic submodule after restricting
scalars. -/
def mem_map_algebraMap_pow_iff_mem_pow_smul_topStatement
    {S : Type*} [CommRing S] [Algebra R S] (I : Ideal R)
    (n : ℕ) {x : S} : Prop :=
    x ∈ (I.map (algebraMap R S)) ^ n ↔
      x ∈ I ^ n • (⊤ : Submodule R S)

/-- Target: the same scalar-restriction comparison as a submodule-membership
statement. -/
def mem_map_algebraMap_pow_smul_top_iffStatement
    {S : Type*} [CommRing S] [Algebra R S] (I : Ideal R)
    (n : ℕ) {x : S} : Prop :=
    x ∈ ((I.map (algebraMap R S)) ^ n • ⊤ : Submodule S S) ↔
      x ∈ I ^ n • (⊤ : Submodule R S)

/-- Target: congruence modulo powers of an extended ideal is unchanged after
restricting scalars to the base ring. -/
def smodEq_map_algebraMap_pow_smul_top_iffStatement
    {S : Type*} [CommRing S] [Algebra R S] (I : Ideal R)
    {x y : S} (n : ℕ) : Prop :=
    x ≡ y [SMOD ((I.map (algebraMap R S)) ^ n • ⊤ : Submodule S S)] ↔
      x ≡ y [SMOD (I ^ n • ⊤ : Submodule R S)]

/-- Target: restricting scalars along an algebra map does not change
precompleteness for the ideal generated by the base ideal. -/
def isPrecomplete_map_algebraMap_iffStatement
    {S : Type*} [CommRing S] [Algebra R S] (I : Ideal R) : Prop :=
    IsPrecomplete (I.map (algebraMap R S)) S ↔ IsPrecomplete I S

/-- Target: restricting scalars along an algebra map does not change adic
completeness for the ideal generated by the base ideal. -/
def isAdicComplete_map_algebraMap_iffStatement
    {S : Type*} [CommRing S] [Algebra R S] (I : Ideal R) : Prop :=
    IsAdicComplete (I.map (algebraMap R S)) S ↔ IsAdicComplete I S

/-- Target: adic completeness is preserved by transporting the ring and ideal
across a ring equivalence. -/
def isAdicComplete_map_ringEquivStatement
    {S : Type*} [CommRing S] (I : Ideal R) (e : R ≃+* S)
    [IsAdicComplete I R] : Prop :=
    IsAdicComplete (I.map (e : R →+* S)) S

/-- Target: if a module is Hausdorff for a positive power of an ideal, then
it is Hausdorff for the ideal itself. -/
def isHausdorff_of_isHausdorff_powStatement
    (I : Ideal R) {n : ℕ} (_hn : 0 < n)
    [IsHausdorff (I ^ n) M] : Prop :=
    IsHausdorff I M

set_option linter.unusedVariables false in
/-- Target: if a module is precomplete for a positive power of an ideal, then
it is precomplete for the ideal itself. -/
def isPrecomplete_of_isPrecomplete_powStatement
    (I : Ideal R) {n : ℕ} (hn : 0 < n)
    [IsPrecomplete (I ^ n) M] : Prop :=
    IsPrecomplete I M

end DiscreteValuationField

end

end Langlands.NYLL.ValuationTheory
