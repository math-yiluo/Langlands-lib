import Langlands.NYLL.ValuedFieldTheory.Valuation.DiscreteValuationField.FiniteIntegralClosure.MaximalIdeal
import Mathlib.RingTheory.Ideal.Maps

/-!
# Images of the base maximal ideal in a finite integral closure

These closed propositions state NYLL M245.008 and M245.009 with every type,
structure, chosen complete discrete valuation and hypothesis quantified inside
the body. Only universe levels are declaration parameters, and the field,
value-group and extension universes are independent. They state the original
conclusions about the ideal generated by the base maximal ideal in the actual
integral closure of the base valuation subring without proving them. As in the
source, the second target does not assume that the extension is finite.
-/

namespace Langlands.NYLL.ValuationTheory.DiscreteValuationField.ValuedExtension

/-- In a finite separable extension `L` of a field `K` with a chosen complete
discrete valuation, the ideal generated in the actual integral closure of the
valuation subring by the base maximal ideal is contained in the canonical
maximal ideal `CanonicalIntegralClosure.maximalIdeal` (M245.007). This is a
proposition target, not a proof. -/
def IntegralClosureBaseMaximalMapLeMaximalIdealOfFiniteSeparableStatement.{u, v, w} :
    Prop :=
  ∀ (K : Type u) (L : Type w) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] (base : CompleteDVF.{u, v} K) [Algebra.IsSeparable K L],
    (IsLocalRing.maximalIdeal base.valuation.valuationSubring).map
        (algebraMap base.valuation.valuationSubring
          (integralClosure base.valuation.valuationSubring L)) ≤
      CanonicalIntegralClosure.maximalIdeal (K := K) (L := L) base

/-- In a separable algebraic extension `L` of a field `K` with a chosen complete
discrete valuation, the ideal generated in the actual integral closure of the
valuation subring by the base maximal ideal is nonzero. As in the source, `L`
is not assumed finite-dimensional over `K`. This is a proposition target, not a
proof. -/
def IntegralClosureBaseMaximalMapNeBotOfFiniteSeparableStatement.{u, v, w} : Prop :=
  ∀ (K : Type u) (L : Type w) [Field K] [Field L] [Algebra K L]
    (base : CompleteDVF.{u, v} K) [Algebra.IsSeparable K L],
    (IsLocalRing.maximalIdeal base.valuation.valuationSubring).map
        (algebraMap base.valuation.valuationSubring
          (integralClosure base.valuation.valuationSubring L)) ≠ ⊥

end Langlands.NYLL.ValuationTheory.DiscreteValuationField.ValuedExtension
