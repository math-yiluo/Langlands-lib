import Langlands.NYLL.ValuedFieldTheory.Valuation.DiscreteValuationField.Complete.Definitions
import Mathlib.FieldTheory.Separable
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# Completeness of finite integral closures over complete DVFs

These closed propositions state NYLL M245.003 and M245.004 with every type,
structure, chosen complete discrete valuation and hypothesis quantified inside
the body. Only universe levels are declaration parameters, and the base field,
value-group and extension-field universes are independent. For a finite
separable extension `L` of a field `K` with a complete discrete valuation, `A`
is the valuation subring of `K` and `B` is the integral closure of `A` in `L`.
The ideal is the extension to `B` of the maximal ideal of `A`. The definitions
state the original conclusions without proving them.
-/

namespace Langlands.NYLL.ValuationTheory.DiscreteValuationField.ValuedExtension

/-- In a finite separable extension `L` of a field `K` with a complete discrete
valuation, the integral closure `B` in `L` of the valuation subring `A` of `K`
is adically complete for the ideal of `B` generated by the maximal ideal of `A`.
This is a proposition target, not a proof. -/
def IntegralClosureBaseMaximalMapIsAdicCompleteOfFiniteSeparableStatement.{u, v, w} :
    Prop :=
  ∀ (K : Type u) (L : Type w) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] (base : CompleteDVF.{u, v} K) [Algebra.IsSeparable K L],
    let A := base.valuation.valuationSubring
    let B := integralClosure A L
    IsAdicComplete ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) B

/-- In a finite separable extension `L` of a field `K` with a complete discrete
valuation, the integral closure `B` in `L` of the valuation subring `A` of `K`
is Henselian along the ideal of `B` generated by the maximal ideal of `A`.
This is a proposition target, not a proof. -/
def IntegralClosureHenselianRingOfFiniteSeparableStatement.{u, v, w} : Prop :=
  ∀ (K : Type u) (L : Type w) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] (base : CompleteDVF.{u, v} K) [Algebra.IsSeparable K L],
    let A := base.valuation.valuationSubring
    let B := integralClosure A L
    HenselianRing B ((IsLocalRing.maximalIdeal A).map (algebraMap A B))

end Langlands.NYLL.ValuationTheory.DiscreteValuationField.ValuedExtension
