import Langlands.NYLL.ValuedFieldTheory.Valuation.DiscreteValuationField.FiniteIntegralClosure.CompletenessStatements
import Langlands.NYLL.ValuedFieldTheory.Valuation.DiscreteValuationField.HenselianFinite.CompletenessProofs
import Mathlib.RingTheory.DedekindDomain.IntegralClosure
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.Valuation.LocalSubring

/-!
# Proofs of completeness and Henselianity of finite integral closures

This module proves the two closed targets of
`Langlands.NYLL.ValuedFieldTheory.Valuation.DiscreteValuationField.FiniteIntegralClosure.CompletenessStatements`
(NYLL M245.003 and M245.004) with the base-field, value-group and
extension-field universes independent.
-/

namespace Langlands.NYLL.ValuationTheory.DiscreteValuationField.ValuedExtension

/-- In a finite separable extension of a field with a complete discrete
valuation, the integral closure of the valuation subring is adically complete
for the ideal generated by the base maximal ideal (NYLL M245.003). -/
theorem integralClosure_base_maximal_map_isAdicComplete_of_finite_separable.{u, v, w} :
    IntegralClosureBaseMaximalMapIsAdicCompleteOfFiniteSeparableStatement.{u, v, w} := by
  intro K L _ _ _ _ base _ A B
  have : IsNoetherianRing A := inferInstance
  have : IsFractionRing A K := inferInstance
  have : IsIntegrallyClosed A := inferInstance
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : IsAdicComplete (IsLocalRing.maximalIdeal A) A :=
    base.instCompleteDiscrete.isAdicComplete
  have hB : IsAdicComplete (IsLocalRing.maximalIdeal A) B :=
    isAdicComplete_of_moduleFinite.{u, w} A B (IsLocalRing.maximalIdeal A)
  exact (IsAdicComplete.map_algebraMap_iff (IsLocalRing.maximalIdeal A) B).mpr hB

/-- In a finite separable extension of a field with a complete discrete
valuation, the integral closure of the valuation subring is Henselian along
the ideal generated by the base maximal ideal (NYLL M245.004). -/
theorem integralClosure_henselianRing_of_finite_separable.{u, v, w} :
    IntegralClosureHenselianRingOfFiniteSeparableStatement.{u, v, w} := by
  intro K L _ _ _ _ base _ A B
  have : IsAdicComplete ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) B :=
    integralClosure_base_maximal_map_isAdicComplete_of_finite_separable.{u, v, w}
      K L base
  exact IsAdicComplete.henselianRing B _

end Langlands.NYLL.ValuationTheory.DiscreteValuationField.ValuedExtension
