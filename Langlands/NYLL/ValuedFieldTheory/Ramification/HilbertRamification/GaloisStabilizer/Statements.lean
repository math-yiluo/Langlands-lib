import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Finite-Galois stabilizer criterion: statement

Adapted from NYLL source unit M396.001 at commit
`fbd320cd8b1b06487c58227e92eb135794267709`.

Modifications by Worker 328: prefix the source namespace with `Langlands.NYLL`,
extract the theorem's proposition as a `def` with suffix `Statement`, and quantify
its element and stabilizer hypotheses in the body. Retain both source imports.
The unused source `noncomputable section` is omitted. Attribution and license:
`licenses/NYLL/LICENSE` and `licenses/NYLL/NOTICE`.
-/

open scoped IntermediateField

universe u v

namespace Langlands.NYLL.RamificationTheory.HilbertRamification.Higher

/-- In a finite Galois extension, every automorphism fixing `b` fixing `a`
implies that the simple intermediate field generated by `a` is contained in
the one generated by `b`. This definition states the source criterion. -/
def adjoin_le_adjoin_of_forall_fixed_imp_fixedStatement
    {K : Type u} {M : Type v}
    [Field K] [Field M] [Algebra K M]
    [FiniteDimensional K M] [IsGalois K M] : Prop :=
  ∀ (a b : M), (∀ σ : Gal(M / K), σ b = b → σ a = a) → K⟮a⟯ ≤ K⟮b⟯

end Langlands.NYLL.RamificationTheory.HilbertRamification.Higher
