import Langlands.NYLL.ValuedFieldTheory.LocalField.NonarchimedeanLocalField.StandardOpenSubgroups.Definitions
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# Standard uniformizer-principal subgroups

The subgroup generated by a power of a supplied field unit and a principal-unit subgroup.
-/

noncomputable section

namespace Langlands.NYLL.LocalFieldTheory

open scoped ValuativeRel

universe u

/-- The standard subgroup `(ϖ^d) · U^n` used in the existence theorem.
The product of the two commuting subgroups is written as their supremum. -/
def uniformizerPrincipalSubgroup
    (K : Type u) [Field K] [ValuativeRel K]
    (ϖ : Kˣ) (d n : Nat) : Subgroup Kˣ :=
  Subgroup.zpowers (ϖ ^ d) ⊔ fieldPrincipalUnits K n

end Langlands.NYLL.LocalFieldTheory
