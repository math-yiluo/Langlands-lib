import Langlands.Cohomology.SiteCech.FreeNerve
import Mathlib.CategoryTheory.Adjunction.Whiskering

/-! # Sections represented by free module sheaves -/

noncomputable section

namespace Langlands.Cohomology.SiteCech

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

variable {C : Type u} [Category.{v} C]
variable (J : GrothendieckTopology C)
variable (R : Type w) [CommRing R] [HasSheafify J (ModuleCat.{w} R)]

/-- The free module sheaf functor is left adjoint to the underlying set-valued
presheaf of a sheaf of modules. -/
def freeSheafAdjunction :
    freeSheafFunctor J R ⊣
      sheafToPresheaf J (ModuleCat.{w} R) ⋙
        (Functor.whiskeringRight _ _ _).obj (forget (ModuleCat.{w} R)) :=
  ((ModuleCat.adj R).whiskerRight Cᵒᵖ).comp (sheafificationAdjunction J _)

variable [LocallySmall.{w} C]

/-- The free module sheaf generated by a representable presheaf represents
sections of module sheaves on that object. -/
def freeRepresentableHomEquiv (U : C) (F : Sheaf J (ModuleCat.{w} R)) :
    ((freeSheafFunctor J R).obj (shrinkYoneda.{w}.obj U) ⟶ F) ≃
      F.obj.obj (op U) :=
  ((freeSheafAdjunction J R).homEquiv _ F).trans shrinkYonedaEquiv

/-- The representing bijection evaluates a morphism at the sheafified identity
generator. -/
theorem freeRepresentableHomEquiv_apply (U : C) (F : Sheaf J (ModuleCat.{w} R))
    (f : (freeSheafFunctor J R).obj (shrinkYoneda.{w}.obj U) ⟶ F) :
    freeRepresentableHomEquiv J R U F f =
      f.hom.app (op U)
        ((toSheafify J (shrinkYoneda.{w}.obj U ⋙ ModuleCat.free R)).app (op U)
          (ModuleCat.freeMk (equivShrink.{w} (U ⟶ U) (𝟙 U)))) := by
  rfl

/-- The representing equivalence is linear over the coefficient ring. -/
def freeRepresentableHomLinearEquiv (U : C) (F : Sheaf J (ModuleCat.{w} R)) :
    ((freeSheafFunctor J R).obj (shrinkYoneda.{w}.obj U) ⟶ F) ≃ₗ[R]
      F.obj.obj (op U) :=
  { freeRepresentableHomEquiv J R U F with
    map_add' _ _ := rfl
    map_smul' _ _ := rfl }

/-- The representing equivalence commutes with coefficient morphisms. -/
theorem freeRepresentableHomEquiv_naturality_right (U : C)
    {F F' : Sheaf J (ModuleCat.{w} R)}
    (f : (freeSheafFunctor J R).obj (shrinkYoneda.{w}.obj U) ⟶ F)
    (g : F ⟶ F') :
    freeRepresentableHomEquiv J R U F' (f ≫ g) =
      g.hom.app (op U) (freeRepresentableHomEquiv J R U F f) := rfl

/-- The representing equivalence commutes with restriction along site arrows. -/
theorem freeRepresentableHomEquiv_naturality_left {U V : C} (p : V ⟶ U)
    (F : Sheaf J (ModuleCat.{w} R))
    (f : (freeSheafFunctor J R).obj (shrinkYoneda.{w}.obj U) ⟶ F) :
    freeRepresentableHomEquiv J R V F
        ((freeSheafFunctor J R).map (shrinkYoneda.{w}.map p) ≫ f) =
      F.obj.map p.op (freeRepresentableHomEquiv J R U F f) := by
  unfold freeRepresentableHomEquiv
  simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_left]
  exact (shrinkYonedaEquiv_naturality _ p).symm

end Langlands.Cohomology.SiteCech
