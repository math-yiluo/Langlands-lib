import Mathlib.AlgebraicTopology.CechNerve
import Mathlib.AlgebraicTopology.AlternatingFaceMapComplex
import Mathlib.Algebra.Category.ModuleCat.Adjunctions
import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
import Mathlib.CategoryTheory.Sites.Abelian
import Mathlib.CategoryTheory.Sites.LocallySurjective
import Mathlib.CategoryTheory.Linear.FunctorCategory
import Mathlib.CategoryTheory.Linear.Yoneda

/-! # Free sheaf Čech nerves without products in the site category -/

noncomputable section

namespace Langlands.Cohomology.SiteCech

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

variable {C : Type u} [Category.{v} C]
variable (J : GrothendieckTopology C)
variable (R : Type w) [CommRing R] [HasSheafify J (ModuleCat.{w} R)]

/-- Apply the free module functor objectwise and sheafify. -/
def freeSheafFunctor : (Cᵒᵖ ⥤ Type w) ⥤ Sheaf J (ModuleCat.{w} R) :=
  (Functor.whiskeringRight _ _ _).obj (ModuleCat.free R) ⋙ presheafToSheaf J _

/-- The augmented free sheaf Čech nerve of an arrow of set-valued presheaves. -/
def freeAugmentedCechNerve (f : Arrow (Cᵒᵖ ⥤ Type w)) :
    SimplicialObject.Augmented (Sheaf J (ModuleCat.{w} R)) :=
  (SimplicialObject.Augmented.whiskeringObj _ _ (freeSheafFunctor J R)).obj
    f.augmentedCechNerve

/-- The unaugmented free sheaf Čech nerve. -/
abbrev freeCechNerve (f : Arrow (Cᵒᵖ ⥤ Type w)) :
    SimplicialObject (Sheaf J (ModuleCat.{w} R)) :=
  (freeAugmentedCechNerve J R f).left

/-- The chain complex of free sheaves associated to a presheaf Čech nerve. -/
def freeCechChainComplex (f : Arrow (Cᵒᵖ ⥤ Type w)) :
    ChainComplex (Sheaf J (ModuleCat.{w} R)) ℕ :=
  (AlgebraicTopology.alternatingFaceMapComplex _).obj (freeCechNerve J R f)

/-- Augmentation to the free sheaf generated by the target presheaf. -/
def freeCechAugmentation (f : Arrow (Cᵒᵖ ⥤ Type w)) :
    freeCechChainComplex J R f ⟶
      (ChainComplex.single₀ _).obj ((freeSheafFunctor J R).obj f.right) :=
  AlgebraicTopology.AlternatingFaceMapComplex.ε.app (freeAugmentedCechNerve J R f)

/-- The Čech cochain complex, functorially in the coefficient sheaf, obtained by
applying the linear Hom functor to the free sheaf nerve. -/
def cochainComplexFunctor (f : Arrow (Cᵒᵖ ⥤ Type w)) :
    Sheaf J (ModuleCat.{w} R) ⥤ CochainComplex (ModuleCat.{max u w} R) ℕ :=
  linearYoneda R _ ⋙
    (Functor.whiskeringLeft _ _ _).obj (freeCechNerve J R f).rightOp ⋙
    AlgebraicTopology.alternatingCofaceMapComplex _

/-- Degree `q` of the Čech cohomology functor attached to the presheaf arrow. -/
def cohomologyFunctor (f : Arrow (Cᵒᵖ ⥤ Type w)) (q : ℕ) :
    Sheaf J (ModuleCat.{w} R) ⥤ ModuleCat.{max u w} R :=
  cochainComplexFunctor J R f ⋙ HomologicalComplex.homologyFunctor _ _ q

variable [LocallySmall.{w} C]

/-- A family of arrows over `S` gives an arrow from the coproduct of its
representable presheaves to the represented target, without products in `C`. -/
def familyArrow {S : C} {ι : Type w} {U : ι → C} (p : ∀ i, U i ⟶ S) :
    Arrow (Cᵒᵖ ⥤ Type w) :=
  Arrow.mk (Sigma.desc (fun i ↦ shrinkYoneda.{w}.map (p i)))

/-- Covering families give exactly locally surjective presheaf arrows. -/
theorem familyArrow_isLocallySurjective_iff {S : C} {ι : Type w}
    {U : ι → C} (p : ∀ i, U i ⟶ S) :
    Presheaf.IsLocallySurjective J (familyArrow p).hom ↔ Sieve.ofArrows U p ∈ J S :=
  (J.ofArrows_mem_iff_isLocallySurjective_sigmaDesc_shrinkYoneda_map p).symm

end Langlands.Cohomology.SiteCech
