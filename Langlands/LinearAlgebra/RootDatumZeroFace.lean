import Langlands.GroupScheme.SplitExistence.IntegralBase
import Langlands.GroupScheme.Reductive.RootDatumGaloisSimpleRoots
import Mathlib.LinearAlgebra.RootSystem.WeylGroup

/-! # The zero face of a based root datum as a based root datum -/

noncomputable section

universe v w

namespace Langlands.LinearAlgebra.RootDatumZeroFace

open Set Module

section Positivity

variable {ι : Type v} {M N : Type w} [Finite ι] [AddCommGroup M] [AddCommGroup N]
  {P : RootDatum ι M N} (b : P.Base)

omit [Finite ι] in
/-- An element of the additive monoid generated by the simple roots is a natural
combination of the simple roots. -/
theorem exists_nat_of_mem_closure {x : M}
    (hx : x ∈ AddSubmonoid.closure (P.root '' b.support)) :
    ∃ f : ι → ℕ, x = ∑ j ∈ b.support, f j • P.root j := by
  classical
  induction hx using AddSubmonoid.closure_induction with
  | mem y hy =>
    obtain ⟨j, hj, rfl⟩ := hy
    refine ⟨Pi.single j 1, ?_⟩
    rw [Finset.sum_eq_single_of_mem j hj]
    · simp
    · intro i _ hij
      simp [hij]
  | zero => exact ⟨0, by simp⟩
  | add y z _ _ hy hz =>
    obtain ⟨f, rfl⟩ := hy
    obtain ⟨g, rfl⟩ := hz
    exact ⟨f + g, by simp [add_smul, Finset.sum_add_distrib]⟩

omit [Finite ι] in
/-- A root is positive exactly when it lies in the additive monoid generated by
the simple roots. -/
theorem isPos_iff_mem_closure (i : ι) :
    b.IsPos i ↔ P.root i ∈ AddSubmonoid.closure (P.root '' b.support) := by
  constructor
  · intro hi
    rcases b.root_mem_or_neg_mem i with h | h
    · exact h
    · exfalso
      obtain ⟨f, hf⟩ := exists_nat_of_mem_closure b h
      have heq : P.root i = ∑ j ∈ b.support, (-(f j : ℤ)) • P.root j := by
        rw [← neg_neg (P.root i), hf, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [neg_smul, natCast_zsmul]
      rw [RootPairing.Base.isPos_iff, RootPairing.Base.height_eq_sum heq,
        Finset.sum_neg_distrib] at hi
      have : 0 ≤ ∑ j ∈ b.support, (f j : ℤ) := Finset.sum_nonneg fun j _ => by positivity
      omega
  · intro h
    obtain ⟨f, hf⟩ := exists_nat_of_mem_closure b h
    have heq : P.root i = ∑ j ∈ b.support, (f j : ℤ) • P.root j := by
      rw [hf]
      exact Finset.sum_congr rfl fun j _ => (natCast_zsmul _ _).symm
    rw [RootPairing.Base.isPos_iff', RootPairing.Base.height_eq_sum heq]
    exact Finset.sum_nonneg fun j _ => by positivity

omit [Finite ι] in
/-- The negative of a root lies in the monoid generated by the simple roots
exactly when the root is not positive. -/
theorem neg_mem_closure_iff_not_isPos (i : ι) :
    -P.root i ∈ AddSubmonoid.closure (P.root '' b.support) ↔ ¬ b.IsPos i := by
  let := P.indexNeg
  have h : P.root (-i) = -P.root i := by
    change P.root (P.reflectionPerm i i) = -P.root i
    rw [P.root_reflectionPerm, P.reflection_apply_self]
  rw [← h, ← isPos_iff_mem_closure, RootPairing.Base.IsPos.neg_iff_not]

omit [Finite ι] in
/-- The index permutation of a product of automorphisms is the composite. -/
theorem mul_indexEquiv_apply (θ θ' : P.Aut) (i : ι) :
    (θ * θ').indexEquiv i = θ.indexEquiv (θ'.indexEquiv i) := rfl

omit [Finite ι] in
/-- The index permutation of an inverse automorphism is the inverse permutation. -/
theorem inv_indexEquiv_apply (θ : P.Aut) (i : ι) :
    (θ⁻¹).indexEquiv i = θ.indexEquiv.symm i := rfl

omit [Finite ι] in
/-- An automorphism carrying simple roots to simple roots preserves positivity. -/
theorem isPos_indexEquiv_of_mapsTo (θ : P.Aut)
    (hθ : ∀ a ∈ b.support, θ.indexEquiv a ∈ b.support) {i : ι} (hi : b.IsPos i) :
    b.IsPos (θ.indexEquiv i) := by
  rw [isPos_iff_mem_closure] at hi ⊢
  have key : ∀ x ∈ AddSubmonoid.closure (P.root '' b.support),
      θ.weightEquiv x ∈ AddSubmonoid.closure (P.root '' b.support) := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨a, ha, rfl⟩ := hy
      have hr : θ.weightEquiv (P.root a) = P.root (θ.indexEquiv a) :=
        θ.root_weightMap_apply P P a
      rw [hr]
      exact AddSubmonoid.subset_closure ⟨_, hθ a ha, rfl⟩
    | zero => simp
    | add y z _ _ hy hz =>
      rw [map_add]
      exact add_mem hy hz
  have hr : θ.weightEquiv (P.root i) = P.root (θ.indexEquiv i) :=
    θ.root_weightMap_apply P P i
  rw [← hr]
  exact key _ hi

omit [Finite ι] in
/-- An automorphism preserving the simple roots preserves positivity. -/
theorem isPos_indexEquiv_iff_of_based (θ : P.Aut)
    (hθ : ∀ a, a ∈ b.support ↔ θ.indexEquiv a ∈ b.support) (i : ι) :
    b.IsPos (θ.indexEquiv i) ↔ b.IsPos i := by
  refine ⟨fun h => ?_, isPos_indexEquiv_of_mapsTo b θ (fun a ha => (hθ a).mp ha)⟩
  have hinv : ∀ a ∈ b.support, (θ⁻¹).indexEquiv a ∈ b.support := by
    intro a ha
    rw [hθ, inv_indexEquiv_apply, Equiv.apply_symm_apply]
    exact ha
  have := isPos_indexEquiv_of_mapsTo b θ⁻¹ hinv h
  rwa [inv_indexEquiv_apply, Equiv.symm_apply_apply] at this

/-- An automorphism preserving positivity preserves the simple roots. -/
theorem based_of_isPos (θ : P.Aut) (hpos : ∀ a, b.IsPos (θ.indexEquiv a) ↔ b.IsPos a)
    (a : ι) : a ∈ b.support ↔ θ.indexEquiv a ∈ b.support :=
  (RootPairing.Base.mem_support_equiv_iff_of_isPos P b θ.indexEquiv θ.weightEquiv
    (fun j => by rw [RootPairing.Equiv.weightEquiv_apply, θ.root_weightMap_apply P P j])
    hpos a).symm

omit [Finite ι] in
/-- A reflection in a root with zero value on a coweight preserves all values
of roots on that coweight. -/
theorem root'_reflectionPerm_of_root'_eq_zero {ν : N} {j : ι} (hj : P.root' j ν = 0)
    (a : ι) : P.root' (P.reflectionPerm j a) ν = P.root' a ν := by
  change P.toLinearMap (P.root (P.reflectionPerm j a)) ν = P.toLinearMap (P.root a) ν
  change P.toLinearMap (P.root j) ν = 0 at hj
  rw [P.root_reflectionPerm, P.reflection_apply_root, map_sub, map_smul,
    LinearMap.sub_apply, LinearMap.smul_apply, hj, smul_zero, sub_zero]

end Positivity

/-- Inside an additive monoid generated by vectors on which an integral
functional is nonnegative, every element killed by the functional is generated
by the generators that the functional kills. -/
theorem mem_closure_zero_of_mem_closure_nonneg {J Y : Type*} [AddCommGroup Y]
    (v : J → Y) (s : Set J) (g : Dual ℤ Y) (hnonneg : ∀ i ∈ s, 0 ≤ g (v i))
    {y : Y} (hy : y ∈ AddSubmonoid.closure (v '' s)) (hzero : g y = 0) :
    y ∈ AddSubmonoid.closure (v '' {i | i ∈ s ∧ g (v i) = 0}) := by
  have h : ∀ y ∈ AddSubmonoid.closure (v '' s),
      0 ≤ g y ∧ (g y = 0 → y ∈ AddSubmonoid.closure (v '' {i | i ∈ s ∧ g (v i) = 0})) := by
    intro y hy
    induction hy using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨i, hi, rfl⟩ := hy
      exact ⟨hnonneg i hi, fun hz => AddSubmonoid.subset_closure ⟨i, ⟨hi, hz⟩, rfl⟩⟩
    | zero => exact ⟨by simp, fun _ => zero_mem _⟩
    | add y z _ _ ihy ihz =>
      constructor
      · simpa only [map_add] using add_nonneg ihy.1 ihz.1
      · intro hsum
        have hsum' : g y + g z = 0 := by simpa only [map_add] using hsum
        have hgy : g y = 0 := by omega
        have hgz : g z = 0 := by omega
        exact add_mem (ihy.2 hgy) (ihz.2 hgz)
  exact (h y hy).2 hzero

section Face

variable {ι κ : Type v} {M N M' N' : Type w} [Finite ι] [Finite κ]
  [AddCommGroup M] [AddCommGroup N] [AddCommGroup M'] [AddCommGroup N']

/-- A root datum `Q` realizing the roots of a based root datum `(P, b)` that pair
to zero with a coweight `ν`. The coweight is compatible with `b`: a root with
nonzero `ν`-value is positive exactly when that value is positive. Roots of `Q`
are images of the matching roots of `P` under a linear map `weightMap`, coroots
of `Q` map to the matching coroots of `P` under an injective linear map
`coweightMap`, and the two maps are adjoint for the perfect pairings. -/
structure FaceDatum (P : RootDatum ι M N) (b : P.Base) (ν : N) (Q : RootDatum κ M' N') where
  sign : ∀ a, P.root' a ν ≠ 0 → (b.IsPos a ↔ 0 < P.root' a ν)
  weightMap : M →ₗ[ℤ] M'
  coweightMap : N' →ₗ[ℤ] N
  coweightMap_injective : Function.Injective coweightMap
  pairing_comm : ∀ x y, Q.toLinearMap (weightMap x) y = P.toLinearMap x (coweightMap y)
  indexEquiv : κ ≃ {a : ι // P.root' a ν = 0}
  root_eq : ∀ k, Q.root k = weightMap (P.root (indexEquiv k))
  coroot_eq : ∀ k, coweightMap (Q.coroot k) = P.coroot (indexEquiv k)

namespace FaceDatum

variable {P : RootDatum ι M N} {b : P.Base} {ν : N} {Q : RootDatum κ M' N'}
  (F : FaceDatum P b ν Q)

omit [Finite ι] [Finite κ] in
/-- Matched roots of `P` vanish on the coweight. -/
theorem root'_index (k : κ) : P.root' (F.indexEquiv k) ν = 0 := (F.indexEquiv k).property

omit [Finite ι] [Finite κ] in
/-- Every root of `P` vanishing on the coweight is matched by a root of `Q`. -/
theorem exists_index {a : ι} (ha : P.root' a ν = 0) : ∃ k, (F.indexEquiv k : ι) = a :=
  ⟨F.indexEquiv.symm ⟨a, ha⟩, by simp⟩

omit [Finite ι] [Finite κ] in
include F in
/-- Simple roots pair nonnegatively with the compatible coweight. -/
theorem root'_simple_nonneg {s : ι} (hs : s ∈ b.support) : 0 ≤ P.root' s ν := by
  by_cases h : P.root' s ν = 0
  · exact h.ge
  · exact ((F.sign s h).mp (RootPairing.Base.isPos_of_mem_support hs)).le

omit [Finite ι] [Finite κ] in
/-- The Cartan pairings of `Q` are those of the matching roots of `P`. -/
theorem pairing_eq (k l : κ) :
    Q.pairing k l = P.pairing (F.indexEquiv k) (F.indexEquiv l) := by
  rw [← Q.root_coroot_eq_pairing, F.root_eq, F.pairing_comm, F.coroot_eq,
    P.root_coroot_eq_pairing]

omit [Finite ι] [Finite κ] in
/-- Reflections of `Q` permute indices as the matching reflections of `P`. -/
theorem reflectionPerm_eq (k l : κ) :
    P.reflectionPerm (F.indexEquiv k) (F.indexEquiv l) =
      F.indexEquiv (Q.reflectionPerm k l) := by
  apply P.coroot.injective
  rw [← F.coroot_eq (Q.reflectionPerm k l), Q.coroot_reflectionPerm,
    Q.coreflection_apply_coroot, map_sub, map_smul, F.coroot_eq, F.coroot_eq,
    P.coroot_reflectionPerm, P.coreflection_apply_coroot, F.pairing_eq]

omit [Finite ι] [Finite κ] in
/-- Every Weyl element of `Q` is matched by a Weyl element of `P` which permutes
the zero face compatibly and preserves all `ν`-values. -/
theorem exists_weyl_transport {w' : Q.Aut} (hw' : w' ∈ Q.weylGroup) :
    ∃ w ∈ P.weylGroup,
      (∀ k, w.indexEquiv (F.indexEquiv k) = F.indexEquiv (w'.indexEquiv k)) ∧
        ∀ a, P.root' (w.indexEquiv a) ν = P.root' a ν := by
  induction hw' using RootPairing.weylGroup.induction with
  | mem k =>
    refine ⟨RootPairing.Equiv.reflection P (F.indexEquiv k),
      P.reflection_mem_weylGroup _, fun l => ?_, fun a => ?_⟩
    · exact F.reflectionPerm_eq k l
    · exact root'_reflectionPerm_of_root'_eq_zero (F.root'_index k) a
  | one => exact ⟨1, one_mem _, fun k => rfl, fun a => rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨u, hu, hu1, hu2⟩ := hx
    obtain ⟨v, hv, hv1, hv2⟩ := hy
    refine ⟨u * v, mul_mem hu hv, fun k => ?_, fun a => ?_⟩
    · rw [mul_indexEquiv_apply, hv1, hu1]
      rfl
    · rw [mul_indexEquiv_apply, hu2, hv2]

/-- The simple roots of `Q`: those matching simple roots of `P`. -/
def baseSupport : Finset κ :=
  (Set.toFinite {k : κ | (F.indexEquiv k : ι) ∈ b.support}).toFinset

omit [Finite ι] in
/-- Membership in the simple-root support of `Q`. -/
theorem mem_baseSupport (k : κ) :
    k ∈ F.baseSupport ↔ (F.indexEquiv k : ι) ∈ b.support :=
  Set.Finite.mem_toFinset _

omit [Finite ι] in
/-- Elements of the simple-root monoid of `P` with zero `ν`-value map into the
simple-root monoid of `Q`. -/
theorem weightMap_mem_closure {x : M}
    (hx : x ∈ AddSubmonoid.closure (P.root '' b.support))
    (hz : P.toLinearMap x ν = 0) :
    F.weightMap x ∈ AddSubmonoid.closure (Q.root '' F.baseSupport) := by
  have h := mem_closure_zero_of_mem_closure_nonneg P.root b.support
    (P.toLinearMap.flip ν) (fun s hs => F.root'_simple_nonneg hs) hx
    (by simpa using hz)
  have hle : AddSubmonoid.closure
      (P.root '' {i | i ∈ b.support ∧ P.toLinearMap.flip ν (P.root i) = 0}) ≤
      (AddSubmonoid.closure (Q.root '' F.baseSupport)).comap
        F.weightMap.toAddMonoidHom := by
    rw [AddSubmonoid.closure_le]
    rintro _ ⟨s, ⟨hs, hs0⟩, rfl⟩
    obtain ⟨k, hk⟩ := F.exists_index (a := s) (by simpa using hs0)
    change F.weightMap (P.root s) ∈ AddSubmonoid.closure (Q.root '' F.baseSupport)
    rw [← hk, ← F.root_eq]
    exact AddSubmonoid.subset_closure ⟨k, (F.mem_baseSupport k).mpr (hk ▸ hs), rfl⟩
  exact hle h

/-- A coroot of `Q`, or its negative, whose image lies in the simple-coroot
monoid of `P` lies in the simple-coroot monoid of `Q`. -/
theorem coroot_mem_closure_aux (k : κ) {z : N'} (hz : z = Q.coroot k ∨ z = -Q.coroot k)
    (h : F.coweightMap z ∈ AddSubmonoid.closure (P.coroot '' b.support)) :
    z ∈ AddSubmonoid.closure (Q.coroot '' F.baseSupport) := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  let f : Dual ℤ M := P.toLinearMap.flip ν
  let g : Dual ℤ N := f ∘ₗ P.flip.Polarization
  have hg (s : ι) : 2 * g (P.coroot s) =
      P.flip.RootForm (P.coroot s) (P.coroot s) * P.root' s ν :=
    Langlands.GroupScheme.SplitExistence.two_mul_dual_polarization_root P.flip f s
  have h4 (s : ι) : 4 ≤ P.flip.RootForm (P.coroot s) (P.coroot s) :=
    Langlands.GroupScheme.SplitExistence.four_le_rootForm_root P.flip s
  have hnonneg : ∀ s ∈ (b.support : Set ι), 0 ≤ g (P.coroot s) := by
    intro s hs
    have h1 := hg s
    have h2 := h4 s
    have h3 := F.root'_simple_nonneg hs
    nlinarith
  have hzero' (s : ι) (hs : g (P.coroot s) = 0) : P.root' s ν = 0 := by
    have h1 := hg s
    have h2 := h4 s
    rw [hs, mul_zero] at h1
    exact (mul_eq_zero.mp h1.symm).resolve_left (by omega)
  have hgk : g (P.coroot (F.indexEquiv k)) = 0 := by
    have h1 := hg (F.indexEquiv k)
    rw [F.root'_index k, mul_zero] at h1
    omega
  have hzero : g (F.coweightMap z) = 0 := by
    rcases hz with rfl | rfl
    · rw [F.coroot_eq]
      exact hgk
    · rw [map_neg, F.coroot_eq, map_neg, hgk, neg_zero]
  have hm := mem_closure_zero_of_mem_closure_nonneg P.coroot b.support g hnonneg h hzero
  have hle : AddSubmonoid.closure
      (P.coroot '' {i | i ∈ b.support ∧ g (P.coroot i) = 0}) ≤
      (AddSubmonoid.closure (Q.coroot '' F.baseSupport)).map
        F.coweightMap.toAddMonoidHom := by
    rw [AddSubmonoid.closure_le]
    rintro _ ⟨s, ⟨hs, hs0⟩, rfl⟩
    obtain ⟨l, hl⟩ := F.exists_index (hzero' s hs0)
    rw [← hl, ← F.coroot_eq]
    exact AddSubmonoid.mem_map_of_mem _
      (AddSubmonoid.subset_closure ⟨l, (F.mem_baseSupport l).mpr (hl ▸ hs), rfl⟩)
  obtain ⟨w, hw, hwz⟩ := AddSubmonoid.mem_map.mp (hle hm)
  have : w = z := F.coweightMap_injective hwz
  exact this ▸ hw

/-- The simple roots of `Q` are linearly independent. -/
theorem linearIndepOn_root :
    LinearIndepOn ℤ Q.root (F.baseSupport : Set κ) := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  have hli : LinearIndependent ℤ
      (fun k : (F.baseSupport : Set κ) => P.root (F.indexEquiv k)) := by
    have h := b.linearIndepOn_root
    exact h.comp (fun k : (F.baseSupport : Set κ) =>
        (⟨F.indexEquiv k, (F.mem_baseSupport k).mp k.2⟩ : (b.support : Set ι)))
      (fun k l hkl => by
        have h := congrArg Subtype.val hkl
        simp only at h
        exact Subtype.ext (F.indexEquiv.injective (Subtype.ext h)))
  rw [LinearIndepOn, Fintype.linearIndependent_iff]
  intro c hc
  let x : M := ∑ k : (F.baseSupport : Set κ), c k • P.root (F.indexEquiv k)
  have hrx : F.weightMap x = 0 := by
    simp only [x, map_sum, map_zsmul, ← F.root_eq]
    exact hc
  have hcor (l : κ) : P.toLinearMap x (P.coroot (F.indexEquiv l)) = 0 := by
    rw [← F.coroot_eq, ← F.pairing_comm, hrx, map_zero, LinearMap.zero_apply]
  have hform (l : κ) : P.RootForm x (P.root (F.indexEquiv l)) = 0 := by
    have h := Langlands.GroupScheme.SplitExistence.two_mul_rootForm_root P x (F.indexEquiv l)
    rw [hcor l, zero_mul] at h
    omega
  have hxx : P.RootForm x x = 0 := by
    change P.RootForm x (∑ k : (F.baseSupport : Set κ), c k • P.root (F.indexEquiv k)) = 0
    rw [map_sum]
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [map_zsmul, hform, smul_zero]
  have hspan : x ∈ P.rootSpan ℤ :=
    Submodule.sum_mem _ fun k _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)
  have hx0 : x = 0 :=
    Langlands.GroupScheme.SplitExistence.eq_zero_of_mem_rootSpan P hspan hxx
  exact Fintype.linearIndependent_iff.mp hli c hx0

omit [Finite ι] in
/-- The simple coroots of `Q` are linearly independent. -/
theorem linearIndepOn_coroot :
    LinearIndepOn ℤ Q.coroot (F.baseSupport : Set κ) := by
  have hli : LinearIndependent ℤ
      (fun k : (F.baseSupport : Set κ) => P.coroot (F.indexEquiv k)) := by
    have h := b.linearIndepOn_coroot
    exact h.comp (fun k : (F.baseSupport : Set κ) =>
        (⟨F.indexEquiv k, (F.mem_baseSupport k).mp k.2⟩ : (b.support : Set ι)))
      (fun k l hkl => by
        have h := congrArg Subtype.val hkl
        simp only at h
        exact Subtype.ext (F.indexEquiv.injective (Subtype.ext h)))
  have he : (fun k : (F.baseSupport : Set κ) => P.coroot (F.indexEquiv k)) =
      F.coweightMap ∘ (fun k : (F.baseSupport : Set κ) => Q.coroot k) :=
    funext fun k => (F.coroot_eq k).symm
  rw [he] at hli
  exact LinearIndependent.of_comp _ hli

/-- The based root datum structure on `Q` whose simple roots match the simple
roots of `P` with zero `ν`-value. -/
def base : Q.Base where
  support := F.baseSupport
  linearIndepOn_root := F.linearIndepOn_root
  linearIndepOn_coroot := F.linearIndepOn_coroot
  root_mem_or_neg_mem k := by
    rcases b.root_mem_or_neg_mem (F.indexEquiv k) with h | h
    · left
      rw [F.root_eq]
      exact F.weightMap_mem_closure h (F.root'_index k)
    · right
      rw [F.root_eq, ← map_neg]
      refine F.weightMap_mem_closure h ?_
      rw [map_neg, LinearMap.neg_apply]
      change -(P.root' (F.indexEquiv k) ν) = 0
      rw [F.root'_index k, neg_zero]
  coroot_mem_or_neg_mem k := by
    rcases b.coroot_mem_or_neg_mem (F.indexEquiv k) with h | h
    · left
      refine F.coroot_mem_closure_aux k (Or.inl rfl) ?_
      rw [F.coroot_eq]
      exact h
    · right
      refine F.coroot_mem_closure_aux k (Or.inr rfl) ?_
      rw [map_neg, F.coroot_eq]
      exact h

/-- The support of the constructed base. -/
theorem base_support : F.base.support = F.baseSupport := rfl

/-- A root of `Q` is simple exactly when the matching root of `P` is simple. -/
theorem mem_base_support (k : κ) :
    k ∈ F.base.support ↔ (F.indexEquiv k : ι) ∈ b.support :=
  F.mem_baseSupport k

/-- Positivity for the constructed base of `Q` is positivity of the matching root
of `P`. -/
theorem isPos_iff (k : κ) : F.base.IsPos k ↔ b.IsPos (F.indexEquiv k) := by
  constructor
  · intro hk
    by_contra hneg
    have h := (neg_mem_closure_iff_not_isPos b _).mpr hneg
    have h' : -Q.root k ∈ AddSubmonoid.closure (Q.root '' F.base.support) := by
      rw [F.root_eq, ← map_neg]
      refine F.weightMap_mem_closure h ?_
      rw [map_neg, LinearMap.neg_apply]
      change -(P.root' (F.indexEquiv k) ν) = 0
      rw [F.root'_index k, neg_zero]
    exact (neg_mem_closure_iff_not_isPos F.base k).mp h' hk
  · intro hk
    rw [isPos_iff_mem_closure] at hk ⊢
    rw [F.root_eq]
    exact F.weightMap_mem_closure hk (F.root'_index k)

/-- A based correction of an automorphism of `Q` transports to a based correction
of a compatible automorphism of `P`, with a Weyl factor of `P`. -/
theorem exists_based_correction (δ : P.Aut) (δ' : Q.Aut)
    (hδν : ∀ a, P.root' (δ.indexEquiv a) ν = P.root' a ν)
    (hδφ : ∀ k, δ.indexEquiv (F.indexEquiv k) = F.indexEquiv (δ'.indexEquiv k))
    {w' : Q.Aut} (hw' : w' ∈ Q.weylGroup)
    (hb' : ∀ k, k ∈ F.base.support ↔ (w' * δ').indexEquiv k ∈ F.base.support) :
    ∃ w ∈ P.weylGroup, (∀ a, a ∈ b.support ↔ (w * δ).indexEquiv a ∈ b.support) ∧
      ∀ k, (w * δ).indexEquiv (F.indexEquiv k) = F.indexEquiv ((w' * δ').indexEquiv k) := by
  obtain ⟨w, hw, hw1, hw2⟩ := F.exists_weyl_transport hw'
  have hφ : ∀ k, (w * δ).indexEquiv (F.indexEquiv k) =
      F.indexEquiv ((w' * δ').indexEquiv k) := by
    intro k
    rw [mul_indexEquiv_apply, hδφ, hw1]
    rfl
  have hν : ∀ a, P.root' ((w * δ).indexEquiv a) ν = P.root' a ν := by
    intro a
    rw [mul_indexEquiv_apply, hw2, hδν]
  have hpos : ∀ a, b.IsPos ((w * δ).indexEquiv a) ↔ b.IsPos a := by
    intro a
    by_cases ha : P.root' a ν = 0
    · obtain ⟨k, rfl⟩ := F.exists_index ha
      rw [hφ, ← F.isPos_iff, ← F.isPos_iff]
      exact isPos_indexEquiv_iff_of_based F.base (w' * δ') hb' k
    · have ha' : P.root' ((w * δ).indexEquiv a) ν ≠ 0 := by rwa [hν]
      rw [F.sign _ ha', F.sign _ ha, hν]
  exact ⟨w, hw, based_of_isPos b (w * δ) hpos, hφ⟩

end FaceDatum

end Face

end Langlands.LinearAlgebra.RootDatumZeroFace
