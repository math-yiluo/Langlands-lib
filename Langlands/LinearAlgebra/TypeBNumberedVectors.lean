import Langlands.LinearAlgebra.TypeDNumberedVectors

/-! # Integral numbered simple roots and coroots of type B -/

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

namespace Langlands.TypeBNumberedVectors

open TypeDNumberedVectors (prefixSum prefixSum_single)

variable {n : ℕ}

/-- The coordinate-difference chain with final vector `d e_last`. -/
def simpleWithLast (d : ℕ) (i : Fin n) : Fin n → ℤ :=
  if h : i.val + 1 < n then
    Pi.single i 1 - Pi.single ⟨i.val + 1, h⟩ 1
  else
    d • Pi.single i 1

/-- The numbered type-B simple roots. -/
abbrev simple := @simpleWithLast n 1

/-- The numbered type-B simple coroots. -/
abbrev simpleCoroot := @simpleWithLast n 2

/-- The additive cone generated by the difference chain and `d e_last`. -/
def positiveCone (d : ℕ) : AddSubmonoid (Fin n → ℤ) :=
  AddSubmonoid.closure (Set.range (simpleWithLast d))

@[simp] theorem simpleWithLast_chain (d : ℕ) (i : Fin n) (hi : i.val + 1 < n) :
    simpleWithLast d i = Pi.single i 1 - Pi.single ⟨i.val + 1, hi⟩ 1 := by
  simp [simpleWithLast, hi]

@[simp] theorem simpleWithLast_last (d : ℕ) (i : Fin n) (hi : ¬ i.val + 1 < n) :
    simpleWithLast d i = d • Pi.single i 1 := by
  simp [simpleWithLast, hi]

/-- Prefix coordinates distinguish the chain generators integrally. -/
theorem prefixSum_simpleWithLast (d : ℕ) (a i : Fin n) :
    prefixSum a (simpleWithLast d i) =
      if i = a then (if i.val + 1 < n then 1 else (d : ℤ)) else 0 := by
  by_cases hi : i.val + 1 < n
  · rw [simpleWithLast_chain d i hi, map_sub, prefixSum_single, prefixSum_single]
    simp only [Fin.le_def, Fin.ext_iff, hi, ite_true]
    split_ifs <;> omega
  · rw [simpleWithLast_last d i hi, map_nsmul, prefixSum_single]
    simp only [Fin.le_def, Fin.ext_iff, hi, ite_false, nsmul_eq_mul]
    split_ifs <;> omega

/-- A positive final multiplier gives independent integral chain vectors. -/
theorem linearIndependent_simpleWithLast {d : ℕ} (hd : 0 < d) :
    LinearIndependent ℤ (simpleWithLast (n := n) d) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  have h := congrArg (prefixSum i) hc
  simp only [map_sum, map_zsmul, map_zero, prefixSum_simpleWithLast] at h
  have he (j : Fin n) : c j •
      (if j = i then (if j.val + 1 < n then (1 : ℤ) else (d : ℤ)) else 0) =
        if j = i then c i * (if i.val + 1 < n then 1 else (d : ℤ)) else 0 := by
    by_cases hji : j = i <;> simp [hji]
  simp only [he, Finset.sum_ite_eq', Finset.mem_univ, ite_true] at h
  have hf : (if i.val + 1 < n then (1 : ℤ) else (d : ℤ)) ≠ 0 := by
    split_ifs <;> omega
  exact (mul_eq_zero.mp h).resolve_right hf

/-- The numbered simple roots are linearly independent over the integers. -/
theorem linearIndependent_simple : LinearIndependent ℤ (simple (n := n)) :=
  linearIndependent_simpleWithLast (by omega)

/-- The numbered simple coroots are linearly independent over the integers. -/
theorem linearIndependent_simpleCoroot : LinearIndependent ℤ (simpleCoroot (n := n)) :=
  linearIndependent_simpleWithLast (by omega)

theorem simple_mem_positiveCone (d : ℕ) (i : Fin n) : simpleWithLast d i ∈ positiveCone d :=
  AddSubmonoid.subset_closure (Set.mem_range_self _)

/-- Every forward coordinate difference is a sum of chain generators. -/
theorem sub_mem_positiveCone (d : ℕ) (a b : Fin n) (hab : a ≤ b) :
    Pi.single a 1 - Pi.single b 1 ∈ positiveCone d := by
  have aux : ∀ m : ℕ, ∀ a b : Fin n, b.val - a.val = m → a ≤ b →
      Pi.single a 1 - Pi.single b 1 ∈ positiveCone d := by
    intro m
    induction m with
    | zero =>
      intro a b hm hab
      have : a = b := Fin.ext (by omega)
      subst b
      simp
    | succ m ih =>
      intro a b hm hab
      have ha : a.val + 1 < n := by omega
      let a' : Fin n := ⟨a.val + 1, ha⟩
      have hs := (positiveCone d).add_mem (simple_mem_positiveCone d a)
        (ih a' b (by dsimp [a']; omega) (by change a.val + 1 ≤ b.val; omega))
      rw [simpleWithLast_chain d a ha] at hs
      convert hs using 1
      dsimp [a']
      module
  exact aux _ a b rfl hab

/-- Multiplying a coordinate vector by the final multiplier gives a positive vector. -/
theorem nsmul_single_mem_positiveCone (d : ℕ) (a : Fin n) :
    d • Pi.single a (1 : ℤ) ∈ positiveCone d := by
  have hn : 0 < n := by have := a.isLt; omega
  let q : Fin n := ⟨n - 1, by omega⟩
  have haq : a ≤ q := by change a.val ≤ n - 1; omega
  have hs := (positiveCone d).add_mem
    ((positiveCone d).nsmul_mem (sub_mem_positiveCone d a q haq) d) (simple_mem_positiveCone d q)
  rw [simpleWithLast_last d q (by dsimp [q]; omega)] at hs
  convert hs using 1
  module

/-- Every positive short coordinate root lies in the simple-root cone. -/
theorem single_mem_positiveCone (a : Fin n) : Pi.single a (1 : ℤ) ∈ positiveCone 1 := by
  simpa using nsmul_single_mem_positiveCone 1 a

/-- Positive sums of two coordinates lie in either the root or coroot cone. -/
theorem add_mem_positiveCone (d : ℕ) (hd : d = 1 ∨ d = 2) (a b : Fin n) :
    Pi.single a 1 + Pi.single b 1 ∈ positiveCone d := by
  rcases hd with rfl | rfl
  · exact (positiveCone 1).add_mem (single_mem_positiveCone a) (single_mem_positiveCone b)
  · have hn : 0 < n := by have := a.isLt; omega
    let q : Fin n := ⟨n - 1, by omega⟩
    have haq : a ≤ q := by change a.val ≤ n - 1; omega
    have hbq : b ≤ q := by change b.val ≤ n - 1; omega
    have hs := (positiveCone 2).add_mem
      ((positiveCone 2).add_mem (sub_mem_positiveCone 2 a q haq) (sub_mem_positiveCone 2 b q hbq))
      (simple_mem_positiveCone 2 q)
    rw [simpleWithLast_last 2 q (by dsimp [q]; omega)] at hs
    convert hs using 1
    module

/-- A signed long-root coordinate pair is positive or negative in both cones. -/
theorem signed_pair_mem_or_neg_mem (d : ℕ) (hd : d = 1 ∨ d = 2) (a b : Fin n)
    (s t : ℤ) (hs : s = 1 ∨ s = -1) (ht : t = 1 ∨ t = -1) :
    s • Pi.single a 1 + t • Pi.single b 1 ∈ positiveCone d ∨
      -(s • Pi.single a 1 + t • Pi.single b 1) ∈ positiveCone d := by
  rcases hs with rfl | rfl <;> rcases ht with rfl | rfl
  · left; simpa using add_mem_positiveCone d hd a b
  · by_cases h : a ≤ b
    · left; simpa [sub_eq_add_neg] using sub_mem_positiveCone d a b h
    · right; simpa [sub_eq_add_neg, add_comm] using sub_mem_positiveCone d b a (le_of_not_ge h)
  · by_cases h : b ≤ a
    · left; simpa [sub_eq_add_neg, add_comm] using sub_mem_positiveCone d b a h
    · right; simpa [sub_eq_add_neg, add_comm] using sub_mem_positiveCone d a b (le_of_not_ge h)
  · right; simpa [add_comm] using add_mem_positiveCone d hd a b

/-- Pairing numbered simple roots with their simple coroots gives Mathlib's
exact type-B Cartan numbering. -/
theorem dotProduct_simple (hn : 2 ≤ n) (i j : Fin n) :
    simple i ⬝ᵥ simpleCoroot j = CartanMatrix.B n i j := by
  change simpleWithLast 1 i ⬝ᵥ simpleWithLast 2 j = CartanMatrix.B n i j
  by_cases hi : i.val + 1 < n <;> by_cases hj : j.val + 1 < n
  · rw [simpleWithLast_chain 1 i hi, simpleWithLast_chain 2 j hj]
    simp only [sub_dotProduct, dotProduct_sub, single_dotProduct, one_mul,
      Pi.single_apply, CartanMatrix.B, Matrix.of_apply, Fin.ext_iff]
    split_ifs <;> omega
  · rw [simpleWithLast_chain 1 i hi, simpleWithLast_last 2 j hj]
    rw [two_smul]
    simp only [sub_dotProduct, dotProduct_add, single_dotProduct, one_mul,
      Pi.single_apply, CartanMatrix.B, Matrix.of_apply, Fin.ext_iff]
    split_ifs <;> omega
  · rw [simpleWithLast_last 1 i hi, simpleWithLast_chain 2 j hj, one_smul]
    simp only [dotProduct_sub, single_dotProduct, one_mul,
      Pi.single_apply, CartanMatrix.B, Matrix.of_apply, Fin.ext_iff]
    split_ifs <;> omega
  · rw [simpleWithLast_last 1 i hi, simpleWithLast_last 2 j hj, one_smul]
    rw [two_smul]
    simp only [dotProduct_add, single_dotProduct, one_mul,
      Pi.single_apply, CartanMatrix.B, Matrix.of_apply, Fin.ext_iff]
    split_ifs <;> omega

end Langlands.TypeBNumberedVectors
