import Mathlib.Algebra.BigOperators.Pi
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Data.ZMod.Basic
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.Tactic.Module

/-! # The integral lattice generated by type D vectors -/

noncomputable section

namespace Langlands.TypeDParityLattice

variable (l : Type*) [Fintype l] [DecidableEq l]

/-- The sum of the integer coordinates. -/
def coordinateSum : (l → ℤ) →+ ℤ where
  toFun x := ∑ a, x a
  map_zero' := by simp
  map_add' x y := by simp [Finset.sum_add_distrib]

/-- The sum of the coordinates modulo two. -/
def sumParity : (l → ℤ) →ₗ[ℤ] ZMod 2 :=
  ((Int.castAddHom (ZMod 2)).comp (coordinateSum l)).toIntLinearMap

omit [DecidableEq l] in
theorem sumParity_apply (x : l → ℤ) :
    sumParity l x = ((∑ a, x a : ℤ) : ZMod 2) := rfl

@[simp] theorem sumParity_single (a : l) (n : ℤ) :
    sumParity l (Pi.single a n) = (n : ZMod 2) := by
  simp [sumParity_apply, Pi.single_apply]

/-- The lattice generated by `e_a + e_b` and `e_a - e_b` for distinct indices. -/
def pairLattice : Submodule ℤ (l → ℤ) :=
  Submodule.span ℤ {v | ∃ a b : l, a ≠ b ∧
    (v = Pi.single a 1 + Pi.single b 1 ∨ v = Pi.single a 1 - Pi.single b 1)}

variable {l}

omit [Fintype l] in
theorem single_add_single_mem {a b : l} (hab : a ≠ b) :
    Pi.single a 1 + Pi.single b 1 ∈ pairLattice l :=
  Submodule.subset_span ⟨a, b, hab, Or.inl rfl⟩

omit [Fintype l] in
theorem single_sub_single_mem (a b : l) :
    Pi.single a 1 - Pi.single b 1 ∈ pairLattice l := by
  by_cases hab : a = b
  · subst b
    simp
  · exact Submodule.subset_span ⟨a, b, hab, Or.inr rfl⟩

omit [Fintype l] in
theorem two_smul_single_mem [Nontrivial l] (a : l) :
    (2 : ℤ) • Pi.single a 1 ∈ pairLattice l := by
  obtain ⟨b, hba⟩ := exists_ne a
  have h := (pairLattice l).add_mem (single_add_single_mem hba.symm)
    (single_sub_single_mem a b)
  convert h using 1
  module

theorem pairLattice_le_ker_sumParity :
    pairLattice l ≤ LinearMap.ker (sumParity l) := by
  apply Submodule.span_le.mpr
  rintro v ⟨a, b, -, rfl | rfl⟩
  · change sumParity l (Pi.single a 1 + Pi.single b 1) = 0
    rw [map_add, sumParity_single, sumParity_single]
    decide
  · change sumParity l (Pi.single a 1 - Pi.single b 1) = 0
    simp only [map_sub, sumParity_single, sub_self]

/-- Subtracting the coordinate sum at a fixed index leaves a sum of coordinate differences. -/
theorem sub_sum_smul_single_mem (x : l → ℤ) (a : l) :
    x - (∑ b, x b) • Pi.single a 1 ∈ pairLattice l := by
  have h : ∑ b, x b • (Pi.single b 1 - Pi.single a 1) ∈ pairLattice l :=
    (pairLattice l).sum_mem fun b _ =>
      (pairLattice l).smul_mem (x b) (single_sub_single_mem b a)
  simp_rw [smul_sub] at h
  rwa [Finset.sum_sub_distrib, ← pi_eq_sum_univ', ← Finset.sum_smul] at h

/-- The type D lattice consists exactly of the vectors with even coordinate sum. -/
theorem pairLattice_eq_ker_sumParity [Nontrivial l] :
    pairLattice l = LinearMap.ker (sumParity l) := by
  apply le_antisymm pairLattice_le_ker_sumParity
  intro x hx
  have hx' : (2 : ℤ) ∣ ∑ b, x b :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mp hx
  obtain ⟨n, hn⟩ := hx'
  let a : l := Classical.arbitrary l
  have hmem : (∑ b, x b) • Pi.single a 1 ∈ pairLattice l := by
    rw [hn, mul_comm (2 : ℤ) n, mul_smul]
    exact (pairLattice l).smul_mem n (two_smul_single_mem a)
  have h := (pairLattice l).add_mem (sub_sum_smul_single_mem x a) hmem
  simpa using h

theorem mem_pairLattice_iff [Nontrivial l] (x : l → ℤ) :
    x ∈ pairLattice l ↔ Even (∑ b, x b) := by
  rw [pairLattice_eq_ker_sumParity, LinearMap.mem_ker, sumParity_apply,
    ZMod.intCast_eq_zero_iff_even]

theorem sumParity_surjective [Nonempty l] : Function.Surjective (sumParity l) := by
  intro z
  let a : l := Classical.arbitrary l
  refine ⟨Pi.single a (z.val : ℤ), ?_⟩
  simp

/-- The parity map identifies the type D lattice quotient with `ℤ/2ℤ`. -/
def quotientEquiv [Nontrivial l] : ((l → ℤ) ⧸ pairLattice l) ≃ₗ[ℤ] ZMod 2 :=
  (Submodule.quotEquivOfEq _ _ pairLattice_eq_ker_sumParity).trans
    ((sumParity l).quotKerEquivOfSurjective sumParity_surjective)

theorem card_quotient [Nontrivial l] :
    Nat.card ((l → ℤ) ⧸ pairLattice l) = 2 := by
  rw [Nat.card_congr (quotientEquiv (l := l)).toEquiv, Nat.card_eq_fintype_card,
    ZMod.card]

end Langlands.TypeDParityLattice
