import Langlands.GroupScheme.SplitExistence.IntegralBase

/-! # Integral coroot spans on faces of a root datum -/

noncomputable section

namespace Langlands.LinearAlgebra

open Set Submodule Module IsAddIndecomposable
open Langlands.GroupScheme.SplitExistence

variable {J X Y : Type*} [Finite J] [AddCommGroup X] [AddCommGroup Y]

/-- A regular integral functional can be chosen so that its positive vectors
have nonnegative value under a prescribed functional on the same finite family. -/
theorem exists_regular_dual_nonneg (v : J → Y) (g : Dual ℤ Y)
    (h : ∃ q : Dual ℤ Y, ∀ i, q (v i) ≠ 0) :
    ∃ q : Dual ℤ Y, (∀ i, q (v i) ≠ 0) ∧
      ∀ i, 0 < q (v i) → 0 ≤ g (v i) := by
  classical
  let : Fintype J := Fintype.ofFinite J
  obtain ⟨q, hq⟩ := h
  let n : ℤ := ∑ i, |q (v i)| + 1
  have hn : 0 < n := by
    dsimp [n]
    have := Finset.sum_nonneg (s := Finset.univ) (fun i _ => abs_nonneg (q (v i)))
    omega
  have hbound (i : J) : |q (v i)| < n := by
    have := Finset.single_le_sum (f := fun j => |q (v j)|)
      (fun j _ => abs_nonneg (q (v j))) (Finset.mem_univ i)
    dsimp [n]
    omega
  refine ⟨n • g + q, ?_, ?_⟩
  · intro i hi
    have hi' : n * g (v i) + q (v i) = 0 := by simpa [smul_eq_mul] using hi
    have hb := hbound i
    have hlo := neg_abs_le (q (v i))
    have hhi := le_abs_self (q (v i))
    rcases lt_trichotomy (g (v i)) 0 with hneg | hzero | hpos
    · have : g (v i) ≤ -1 := by omega
      nlinarith
    · exact hq i (by simpa [hzero] using hi')
    · have : 1 ≤ g (v i) := by omega
      nlinarith
  · intro i hi
    have hi' : 0 < n * g (v i) + q (v i) := by simpa [smul_eq_mul] using hi
    have hb := hbound i
    have hhi := le_abs_self (q (v i))
    by_contra! hneg
    have : g (v i) ≤ -1 := by omega
    nlinarith

/-- A finite reduced integral root datum has a base of coroots on which a
prescribed integral functional is nonnegative. -/
theorem exists_base_coroot_nonneg (P : RootDatum J X Y) [P.IsReduced]
    (g : Dual ℤ Y) :
    ∃ b : P.Base, ∀ i ∈ b.support, 0 ≤ g (P.coroot i) := by
  classical
  let : Fintype J := Fintype.ofFinite J
  obtain ⟨q, hq, hnonneg⟩ := exists_regular_dual_nonneg P.coroot g
    (exists_dual_coroot_ne_zero P)
  let f : Dual ℤ X := q ∘ₗ P.Polarization
  have hf : ∀ i, f (P.root i) ≠ 0 := dual_polarization_root_ne_zero P hq
  have hfg : ∀ i, 0 < f (P.root i) ↔ 0 < q (P.coroot i) :=
    dual_polarization_root_pos_iff P q
  have heq := baseOf_root_eq_baseOf_coroot P f q hf hq hfg
  let := P.indexNeg
  let b : P.Base :=
    { support := (toFinite (baseOf P.root (f : X →+ ℤ))).toFinset
      linearIndepOn_root := by
        simpa using RootPairing.linearIndepOn_root_baseOf' P (S := ℤ) f hf
      linearIndepOn_coroot := by
        simpa [heq] using RootPairing.linearIndepOn_root_baseOf' P.flip (S := ℤ) q hq
      root_mem_or_neg_mem := fun i => by
        simpa using mem_or_neg_mem_closure_baseOf P.root (f : X →+ ℤ) i (hf i) (by simp)
      coroot_mem_or_neg_mem := fun i => by
        simpa [heq] using
          mem_or_neg_mem_closure_baseOf P.coroot (q : Y →+ ℤ) i (hq i) (by simp) }
  refine ⟨b, fun i hi => hnonneg i ?_⟩
  have hi' : i ∈ baseOf P.root (f : X →+ ℤ) := by simpa [b] using hi
  exact (hfg i).mp hi'.1

omit [Finite J] in
/-- In a monoid generated by vectors on which a functional is nonnegative,
every vector annihilated by the functional is in the span of its zero generators. -/
theorem mem_span_zero_of_mem_closure_nonneg (v : J → Y) (s : Set J)
    (g : Dual ℤ Y) (hnonneg : ∀ i ∈ s, 0 ≤ g (v i))
    {y : Y} (hy : y ∈ AddSubmonoid.closure (v '' s)) (hzero : g y = 0) :
    y ∈ span ℤ (v '' {i | i ∈ s ∧ g (v i) = 0}) := by
  have h : ∀ y ∈ AddSubmonoid.closure (v '' s),
      0 ≤ g y ∧ (g y = 0 → y ∈ span ℤ (v '' {i | i ∈ s ∧ g (v i) = 0})) := by
    intro y hy
    induction hy using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨i, hi, rfl⟩ := hy
      exact ⟨hnonneg i hi, fun hz => subset_span ⟨i, ⟨hi, hz⟩, rfl⟩⟩
    | zero => exact ⟨by simp, fun _ => zero_mem _⟩
    | add y z hy hz ihy ihz =>
      constructor
      · simpa only [map_add] using add_nonneg ihy.1 ihz.1
      · intro hsum
        have hsum' : g y + g z = 0 := by simpa only [map_add] using hsum
        have hgy : g y = 0 := by omega
        have hgz : g z = 0 := by omega
        exact add_mem (ihy.2 hgy) (ihz.2 hgz)
  exact (h y hy).2 hzero

omit [Finite J] in
/-- The coroots annihilated by a functional are generated integrally by the
simple coroots that it annihilates, when it is nonnegative on the simple coroots. -/
theorem coroot_span_zero_eq_span_simple (P : RootDatum J X Y) (b : P.Base)
    (g : Dual ℤ Y) (hnonneg : ∀ i ∈ b.support, 0 ≤ g (P.coroot i)) :
    span ℤ (P.coroot '' {i | g (P.coroot i) = 0}) =
      span ℤ (P.coroot '' {i | i ∈ b.support ∧ g (P.coroot i) = 0}) := by
  apply le_antisymm
  · apply span_le.mpr
    rintro y ⟨i, hi, rfl⟩
    rcases b.coroot_mem_or_neg_mem i with hpos | hneg
    · exact mem_span_zero_of_mem_closure_nonneg P.coroot _ g hnonneg hpos hi
    · have hz : g (-P.coroot i) = 0 := by simpa using hi
      have hmem : -P.coroot i ∈ span ℤ
          (P.coroot '' {i | i ∈ b.support ∧ g (P.coroot i) = 0}) :=
        mem_span_zero_of_mem_closure_nonneg P.coroot _ g hnonneg hneg hz
      exact (neg_mem_iff).mp hmem
  · exact span_mono (image_mono fun _ h => h.2)

/-- Some simple base generates the integral span of the coroots annihilated
by a given integral functional on the coroot lattice. -/
theorem exists_base_coroot_span_zero (P : RootDatum J X Y) [P.IsReduced]
    (g : Dual ℤ Y) :
    ∃ (b : P.Base) (s : Set J), s ⊆ (b.support : Set J) ∧
      span ℤ (P.coroot '' {i | g (P.coroot i) = 0}) = span ℤ (P.coroot '' s) := by
  obtain ⟨b, hb⟩ := exists_base_coroot_nonneg P g
  exact ⟨b, {i | i ∈ b.support ∧ g (P.coroot i) = 0}, fun _ hi => hi.1,
    coroot_span_zero_eq_span_simple P b g hb⟩

omit [Finite J] in
/-- A functional on roots and its canonical counterpart on coroots have the
same zero indices. -/
theorem dual_copolarization_coroot_eq_zero_iff [Fintype J] (P : RootDatum J X Y)
    (f : Dual ℤ X) (i : J) :
    f (P.CoPolarization (P.coroot i)) = 0 ↔ f (P.root i) = 0 := by
  have h := two_mul_dual_polarization_root P.flip f i
  have hn := four_le_rootForm_root P.flip i
  change 2 * f (P.CoPolarization (P.coroot i)) =
    P.flip.RootForm (P.coroot i) (P.coroot i) * f (P.root i) at h
  change 4 ≤ P.flip.RootForm (P.coroot i) (P.coroot i) at hn
  constructor
  · intro hz
    have hprod : P.flip.RootForm (P.coroot i) (P.coroot i) * f (P.root i) = 0 := by
      rw [← h, hz, mul_zero]
    exact (mul_eq_zero.mp hprod).resolve_left (by omega)
  · intro hz
    rw [hz, mul_zero] at h
    omega

/-- The coroots indexed by roots annihilated by an arbitrary integral
functional span exactly a subset of some simple-coroot base. -/
theorem exists_base_coroot_span_root_zero (P : RootDatum J X Y) [P.IsReduced]
    (f : Dual ℤ X) :
    ∃ (b : P.Base) (s : Set J), s ⊆ (b.support : Set J) ∧
      span ℤ (P.coroot '' {i | f (P.root i) = 0}) = span ℤ (P.coroot '' s) := by
  let : Fintype J := Fintype.ofFinite J
  obtain ⟨b, s, hs, heq⟩ := exists_base_coroot_span_zero P (f ∘ₗ P.CoPolarization)
  refine ⟨b, s, hs, ?_⟩
  have hz : {i | (f ∘ₗ P.CoPolarization) (P.coroot i) = 0} =
      {i | f (P.root i) = 0} := by
    ext i
    exact dual_copolarization_coroot_eq_zero_iff P f i
  rwa [hz] at heq

/-- A chosen simple base and subset whose coroots span exactly the coroots
indexed by roots annihilated by an integral functional. -/
structure RootZeroCorootFace (P : RootDatum J X Y) (f : Dual ℤ X) where
  base : P.Base
  support : Set J
  support_subset : support ⊆ (base.support : Set J)
  span_eq : span ℤ (P.coroot '' {i | f (P.root i) = 0}) =
    span ℤ (P.coroot '' support)

/-- Choose a simple-coroot face for the zero roots of an integral functional. -/
noncomputable def rootZeroCorootFace (P : RootDatum J X Y) [P.IsReduced]
    (f : Dual ℤ X) : RootZeroCorootFace P f :=
  Classical.choice <| by
    obtain ⟨b, s, hs, heq⟩ := exists_base_coroot_span_root_zero P f
    exact ⟨⟨b, s, hs, heq⟩⟩

end Langlands.LinearAlgebra
