import Langlands.LinearAlgebra.TypeD4CorootCoordinates
import Langlands.LinearAlgebra.TypeD4CyclicPairGram
import Mathlib.LinearAlgebra.Determinant
import Mathlib.LinearAlgebra.Matrix.BilinearForm

/-! # Two cyclic A2 pairs in an anisotropic D4 coroot lattice -/

noncomputable section

open Matrix

namespace Langlands.LinearAlgebra

/-- The six vectors in the A2 subsystem of a pair of roots with dot product minus one. -/
private abbrev inA2 {Y : Type*} [AddCommGroup Y] (x a b : Y) : Prop :=
  x = a ∨ x = -a ∨ x = b ∨ x = -b ∨ x = a + b ∨ x = -(a + b)

private abbrev simpleD4 := TypeDNumberedVectors.simple (by decide : 2 ≤ 4)

private theorem d4CoordinateRoot_exists_simple_cross_pairing :
    ∀ (i j : Fin 4), i < j → ∀ (s t : Bool) (k l : Fin 4), k < l → ∀ (u v : Bool),
      let a := d4CoordinateRoot i j s t
      let b := d4CoordinateRoot k l u v
      a ⬝ᵥ b = -1 →
      ∃ m : Fin 4, ¬ inA2 (simpleD4 m) a b ∧
        (a ⬝ᵥ simpleD4 m ≠ 0 ∨ b ⬝ᵥ simpleD4 m ≠ 0) := by
  decide

private theorem d4CoordinateRoot_dotProduct_bounds :
    ∀ (i j : Fin 4), i < j → ∀ (s t : Bool) (k l : Fin 4), k < l → ∀ (u v : Bool),
      let a := d4CoordinateRoot i j s t
      let b := d4CoordinateRoot k l u v
      b ≠ a → b ≠ -a →
      -1 ≤ a ⬝ᵥ b ∧ a ⬝ᵥ b ≤ 1 := by
  decide

private def d4A2FaceVector (m : Fin 4) (s : Fin 4 → Bool) : Fin 4 → ℤ :=
  fun j => (if s j then 1 else -1) * (if j = m then 3 else 1)

set_option maxHeartbeats 800000 in
private theorem d4CoordinateRoot_exists_A2FaceVector :
    ∀ (i j : Fin 4), i < j → ∀ (s t : Bool) (k l : Fin 4), k < l → ∀ (u v : Bool),
      let a := d4CoordinateRoot i j s t
      let b := d4CoordinateRoot k l u v
      a ⬝ᵥ b = -1 →
      ∃ (m : Fin 4) (signs : Fin 4 → Bool),
        ∀ (p q : Fin 4), p < q → ∀ (c d : Bool),
          let x := d4CoordinateRoot p q c d
          x ⬝ᵥ d4A2FaceVector m signs = 0 ↔ inA2 x a b := by
  decide

section RootDatum

variable {I X Y : Type*} [Finite I] [AddCommGroup X] [AddCommGroup Y]
  (P : RootDatum I X Y) [P.IsReduced] (b : P.Base) (hspan : P.corootSpan ℤ = ⊤)
  (e : b.support ≃ Fin 4)
  (hD : ∀ i j : b.support, P.pairing i.val j.val = CartanMatrix.D 4 (e i) (e j))

include hD in
private theorem pairing_eq_dotProduct (i j : I) :
    P.pairing i j = d4CorootCoordinates P b hspan e (P.coroot i) ⬝ᵥ
      d4CorootCoordinates P b hspan e (P.coroot j) := by
  symm
  exact d4CorootCoordinates_dotProduct_coroot P b hspan e hD i (P.coroot j)

include hspan hD in
private theorem pairing_bounds (i j : I)
    (hne : P.coroot j ≠ P.coroot i) (hneg : P.coroot j ≠ -P.coroot i) :
    -1 ≤ P.pairing i j ∧ P.pairing i j ≤ 1 := by
  obtain ⟨p, q, hpq, s, t, hi⟩ := d4CorootCoordinates_exists_coordinateRoot P b hspan e hD i
  obtain ⟨r, w, hrw, u, v, hj⟩ := d4CorootCoordinates_exists_coordinateRoot P b hspan e hD j
  have hinj := d4CorootCoordinates_injective P b hspan e
  rw [pairing_eq_dotProduct P b hspan e hD, hi, hj]
  apply d4CoordinateRoot_dotProduct_bounds p q hpq s t r w hrw u v
  · intro h
    exact hne (hinj (hj.trans (h.trans hi.symm)))
  · intro h
    apply hneg
    apply hinj
    rwa [map_neg, hj, hi]

omit [Finite I] [P.IsReduced] in
/-- The six coroots of the A2 plane generated by a pair of coroots of pairing minus one. -/
def d4A2CorootSet (i j : I) : Set I :=
  {k | inA2 (P.coroot k) (P.coroot i) (P.coroot j)}

omit [Finite I] [P.IsReduced] in
private def doubledCoordinateLift (x : Fin 4 → ℤ) : Y :=
  let v : Fin 4 → ℤ := ![2 * x 0, 2 * (x 0 + x 1),
    x 0 + x 1 + x 2 - x 3, x 0 + x 1 + x 2 + x 3]
  ∑ j : Fin 4, v j • P.coroot (e.symm j).val

omit [Finite I] [P.IsReduced] in
private theorem doubledCoordinateLift_coordinates (x : Fin 4 → ℤ) :
    d4CorootCoordinates P b hspan e (doubledCoordinateLift P b e x) = (2 : ℤ) • x := by
  simp only [doubledCoordinateLift, Fin.sum_univ_four]
  funext j
  fin_cases j <;> norm_num [TypeDNumberedVectors.simple, Pi.single_apply, Pi.add_apply,
    Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Fin.ext_iff] <;> ring

include hspan hD in
/-- An A2 pair of type D4 is the full zero face of an integral cocharacter. -/
theorem exists_d4A2_zeroFace (i j : I) (hij : P.pairing i j = -1) :
    ∃ ν : Y, ∀ k, P.root' k ν = 0 ↔ k ∈ d4A2CorootSet P i j := by
  let coord := d4CorootCoordinates P b hspan e
  obtain ⟨p, q, hpq, s, t, hi⟩ := d4CorootCoordinates_exists_coordinateRoot P b hspan e hD i
  obtain ⟨r, w, hrw, u, v, hj⟩ := d4CorootCoordinates_exists_coordinateRoot P b hspan e hD j
  have hdot : d4CoordinateRoot p q s t ⬝ᵥ d4CoordinateRoot r w u v = -1 := by
    rwa [← hi, ← hj, ← pairing_eq_dotProduct P b hspan e hD]
  obtain ⟨m, signs, hm⟩ := d4CoordinateRoot_exists_A2FaceVector p q hpq s t r w hrw u v hdot
  let x := d4A2FaceVector m signs
  refine ⟨doubledCoordinateLift P b e x, fun k => ?_⟩
  obtain ⟨a, c, hac, cs, ct, hk⟩ :=
    d4CorootCoordinates_exists_coordinateRoot P b hspan e hD k
  have he : inA2 (coord (P.coroot k)) (coord (P.coroot i)) (coord (P.coroot j)) ↔
      k ∈ d4A2CorootSet P i j := by
    let h := d4CorootCoordinates_injective P b hspan e
    change inA2 _ _ _ ↔ inA2 _ _ _
    simp only [inA2, ← map_add coord, ← map_neg coord]
    exact or_congr h.eq_iff (or_congr h.eq_iff (or_congr h.eq_iff
      (or_congr h.eq_iff (or_congr h.eq_iff h.eq_iff))))
  rw [← d4CorootCoordinates_dotProduct_coroot P b hspan e hD,
    doubledCoordinateLift_coordinates, dotProduct_smul, smul_eq_mul, mul_eq_zero]
  simp only [OfNat.ofNat_ne_zero, false_or]
  rw [← he, show coord = d4CorootCoordinates P b hspan e from rfl, hk, hi, hj]
  exact hm a c hac cs ct

variable (σ : I ≃ I)
  (hσ : ∀ i j, P.pairing (σ i) (σ j) = P.pairing i j)
  (horder : ∀ i, σ (σ (σ i)) = i)
  (hnorm : ∀ i, P.coroot i + P.coroot (σ i) + P.coroot (σ (σ i)) = 0)

include hspan hD hσ horder hnorm in
/-- A root and its first translate under the cubic action pair to minus one. -/
theorem pairing_cyclic_eq_neg_one (i : I) : P.pairing i (σ i) = -1 := by
  have hback := hσ (σ i) (σ (σ i))
  rw [horder i, hσ i (σ i)] at hback
  have hrev : P.pairing i (σ (σ i)) = P.pairing (σ (σ i)) i := by
    rw [pairing_eq_dotProduct P b hspan e hD, pairing_eq_dotProduct P b hspan e hD (σ (σ i)) i,
      dotProduct_comm]
  have hz := congrArg (P.root' i) (hnorm i)
  simp only [map_add, map_zero] at hz
  change P.pairing i i + P.pairing i (σ i) + P.pairing i (σ (σ i)) = 0 at hz
  rw [P.pairing_same, hrev, hback] at hz
  omega

variable (L : Y ≃ₗ[ℤ] Y) (hL : ∀ i, L (P.coroot i) = P.coroot (σ i))

omit [Finite I] [P.IsReduced] in
include horder hnorm hL in
/-- The cyclic action preserves the full zero-root set of its A2 pair. -/
theorem mem_d4A2CorootSet_cyclic_iff (i k : I) :
    σ k ∈ d4A2CorootSet P i (σ i) ↔ k ∈ d4A2CorootSet P i (σ i) := by
  have h₂ : P.coroot (σ (σ i)) = -(P.coroot i + P.coroot (σ i)) :=
    eq_neg_of_add_eq_zero_right (hnorm i)
  have hone : L (P.coroot i + P.coroot (σ i)) = -P.coroot i := by
    rw [map_add, hL, hL, h₂]
    abel
  have hstep (j : I) (hj : j ∈ d4A2CorootSet P i (σ i)) :
      σ j ∈ d4A2CorootSet P i (σ i) := by
    change inA2 (P.coroot j) _ _ at hj
    change inA2 (P.coroot (σ j)) _ _
    rcases hj with h | h | h | h | h | h
    · exact Or.inr (Or.inr (Or.inl (by rw [← hL, h, hL])))
    · exact Or.inr (Or.inr (Or.inr (Or.inl (by rw [← hL, h, map_neg, hL]))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (by rw [← hL, h, hL, h₂])))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (by rw [← hL, h, map_neg, hL, h₂, neg_neg])))))
    · exact Or.inr (Or.inl (by rw [← hL, h, hone]))
    · exact Or.inl (by rw [← hL, h, map_neg, hone, neg_neg])
  exact ⟨fun h => horder k ▸ hstep _ (hstep _ h), hstep k⟩

include hspan hD hσ horder hnorm hL in
/-- Another cyclic pair has bounded cross pairings with the first pair, and
these cross pairings sum to zero and are not all zero. -/
theorem exists_d4CyclicPair_crossPairings (i : I) :
    ∃ j : b.support,
      let a := P.pairing i j.val
      let b' := P.pairing i (σ j.val)
      let c := P.pairing (σ i) j.val
      (-1 ≤ a ∧ a ≤ 1) ∧ (-1 ≤ b' ∧ b' ≤ 1) ∧ (-1 ≤ c ∧ c ≤ 1) ∧
        a + b' + c = 0 ∧ (a ≠ 0 ∨ c ≠ 0) := by
  let coord := d4CorootCoordinates P b hspan e
  obtain ⟨p, q, hpq, s, t, hi⟩ := d4CorootCoordinates_exists_coordinateRoot P b hspan e hD i
  obtain ⟨r, w, hrw, u, v, hσi⟩ :=
    d4CorootCoordinates_exists_coordinateRoot P b hspan e hD (σ i)
  have hdot : d4CoordinateRoot p q s t ⬝ᵥ d4CoordinateRoot r w u v = -1 := by
    rw [← hi, ← hσi, ← pairing_eq_dotProduct P b hspan e hD]
    exact pairing_cyclic_eq_neg_one P b hspan e hD σ hσ horder hnorm i
  obtain ⟨m, hm, hcross⟩ :=
    d4CoordinateRoot_exists_simple_cross_pairing p q hpq s t r w hrw u v hdot
  let j := e.symm m
  have hj : d4CorootCoordinates P b hspan e (P.coroot j.val) = simpleD4 m := by
    simp [j, simpleD4]
  have hout : ¬ inA2 (coord (P.coroot j.val)) (coord (P.coroot i)) (coord (P.coroot (σ i))) := by
    simpa only [coord, hj, hi, hσi] using hm
  have hj₁ : P.coroot j.val ≠ P.coroot i :=
    fun h => hout (Or.inl (congrArg coord h))
  have hj₂ : P.coroot j.val ≠ -P.coroot i :=
    fun h => hout (Or.inr (Or.inl (by simpa only [map_neg] using congrArg coord h)))
  have hj₃ : P.coroot j.val ≠ P.coroot (σ i) :=
    fun h => hout (Or.inr (Or.inr (Or.inl (congrArg coord h))))
  have hj₄ : P.coroot j.val ≠ -P.coroot (σ i) :=
    fun h => hout (Or.inr (Or.inr (Or.inr (Or.inl (by
      simpa only [map_neg] using congrArg coord h)))))
  have hrel : coord (P.coroot (σ (σ i))) =
      -(coord (P.coroot i) + coord (P.coroot (σ i))) := by
    have h := congrArg coord (hnorm i)
    simp only [map_add, map_zero] at h
    exact eq_neg_of_add_eq_zero_right h
  have hj₅ : P.coroot j.val ≠ P.coroot (σ (σ i)) := by
    intro h
    exact hout (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ((congrArg coord h).trans hrel))))))
  have hj₆ : P.coroot j.val ≠ -P.coroot (σ (σ i)) := by
    intro h
    have h' := congrArg coord h
    rw [map_neg, hrel, neg_neg] at h'
    exact hout (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h')))))
  have hσj₁ : P.coroot (σ j.val) ≠ P.coroot i := by
    intro h
    apply hj₅
    apply L.injective
    rw [hL, hL, horder]
    exact h
  have hσj₂ : P.coroot (σ j.val) ≠ -P.coroot i := by
    intro h
    apply hj₆
    apply L.injective
    rw [map_neg, hL, hL, horder]
    exact h
  refine ⟨j, pairing_bounds P b hspan e hD i j.val hj₁ hj₂,
    pairing_bounds P b hspan e hD i (σ j.val) hσj₁ hσj₂,
    pairing_bounds P b hspan e hD (σ i) j.val hj₃ hj₄, ?_, ?_⟩
  · have hz := congrArg (P.root' i) (hnorm j.val)
    simp only [map_add, map_zero] at hz
    change P.pairing i j.val + P.pairing i (σ j.val) + P.pairing i (σ (σ j.val)) = 0 at hz
    have h := hσ i (σ (σ j.val))
    rw [horder] at h
    rwa [← h] at hz
  · rw [pairing_eq_dotProduct P b hspan e hD, pairing_eq_dotProduct P b hspan e hD (σ i) j.val,
      hi, hσi, hj]
    exact hcross

include hspan hD in
private theorem d4CorootPairingMatrix_eq (z : Fin 4 → I) :
    let B := (IntegralWeylVector.corootBasis P b hspan).reindex e
    let M := B.toMatrix (fun k => P.coroot (z k))
    Mᵀ * CartanMatrix.D 4 * M = Matrix.of (fun k l => P.pairing (z k) (z l)) := by
  intro B M
  let coord := d4CorootCoordinates P b hspan e
  let C : LinearMap.BilinForm ℤ Y := LinearMap.BilinForm.comp (dotProductBilin ℤ ℤ) coord coord
  have hC : C.toMatrix B = CartanMatrix.D 4 := by
    ext k l
    rw [LinearMap.BilinForm.toMatrix_apply]
    change coord (B k) ⬝ᵥ coord (B l) = _
    simp only [B, coord, Module.Basis.reindex_apply, IntegralWeylVector.corootBasis_apply,
      d4CorootCoordinates_simple, Equiv.apply_symm_apply]
    exact TypeDNumberedVectors.dotProduct_simple (by decide : 4 ≤ 4) k l
  let f := B.constr ℕ (fun k => P.coroot (z k))
  have hf (k : Fin 4) : f (B k) = P.coroot (z k) := B.constr_basis ℕ _ k
  have hM' : M = LinearMap.toMatrix B B f := B.toMatrix_eq_toMatrix_constr _
  rw [← hC, hM', ← LinearMap.BilinForm.toMatrix_comp]
  ext k l
  rw [LinearMap.BilinForm.toMatrix_apply]
  change coord (f (B k)) ⬝ᵥ coord (f (B l)) = P.pairing (z k) (z l)
  rw [hf, hf]
  exact (pairing_eq_dotProduct P b hspan e hD (z k) (z l)).symm

include hspan hD hσ horder hnorm hL in
/-- The two cyclic A2 pairs together form an integral basis of the ambient
simply connected D4 cocharacter lattice. -/
theorem exists_d4CyclicPair_integralBasis (i : I) :
    ∃ j : b.support,
      let z : Fin 4 → I := ![i, σ i, j.val, σ j.val]
      LinearIndependent ℤ (fun k => P.coroot (z k)) ∧
        Submodule.span ℤ (Set.range fun k => P.coroot (z k)) = ⊤ := by
  obtain ⟨j, ha, hb, hc, hsum, hcross⟩ :=
    exists_d4CyclicPair_crossPairings P b hspan e hD σ hσ horder hnorm L hL i
  let z : Fin 4 → I := ![i, σ i, j.val, σ j.val]
  let B := (IntegralWeylVector.corootBasis P b hspan).reindex e
  let M := B.toMatrix (fun k => P.coroot (z k))
  have hi := pairing_cyclic_eq_neg_one P b hspan e hD σ hσ horder hnorm i
  have hj := pairing_cyclic_eq_neg_one P b hspan e hD σ hσ horder hnorm j.val
  have hsym (k l : I) : P.pairing k l = P.pairing l k := by
    rw [pairing_eq_dotProduct P b hspan e hD, pairing_eq_dotProduct P b hspan e hD l k,
      dotProduct_comm]
  let a := P.pairing i j.val
  let b' := P.pairing i (σ j.val)
  let c := P.pairing (σ i) j.val
  have hmat : Mᵀ * CartanMatrix.D 4 * M =
      !![2, -1, a, b'; -1, 2, c, a; a, c, 2, -1; b', a, -1, 2] := by
    rw [d4CorootPairingMatrix_eq P b hspan e hD z]
    ext k l
    fin_cases k <;> fin_cases l <;>
      simp [z, a, b', c, hi, hj, hσ, hsym (σ i) i, hsym j.val i, hsym j.val (σ i),
        hsym (σ j.val) i, hsym (σ j.val) j.val]
  have hdet : IsUnit M.det :=
    isUnit_det_of_D4_cyclicPairGram M a b' c ha hb hc hsum
      (hcross.imp id Or.inr) hmat
  refine ⟨j, (B.is_basis_iff_det (v := fun k => P.coroot (z k))).mpr ?_⟩
  rw [Module.Basis.det_apply]
  exact hdet

end RootDatum

end Langlands.LinearAlgebra
