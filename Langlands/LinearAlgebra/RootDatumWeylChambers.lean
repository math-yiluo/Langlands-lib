import Langlands.GroupScheme.Torus.LeviWeylLattice
import Mathlib.LinearAlgebra.RootSystem.Finite.CanonicalBilinear
import Mathlib.LinearAlgebra.RootSystem.WeylGroup
import Mathlib.Data.Fintype.Lattice
import Mathlib.Tactic

/-! # Integral chamber alignment by a specified reflection subgroup -/

set_option backward.isDefEq.respectTransparency false

noncomputable section

open Set Function

namespace Langlands.LinearAlgebra.RootDatumWeylChambers

variable {J M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (P : RootDatum J M N)

/-- The subgroup generated by the reflections with indices in `S`. -/
abbrev reflectionSubgroup (S : Set J) : Subgroup P.Aut :=
  Langlands.RootDatum.reflectionSubgroup P S

theorem reflectionSubgroup_le (S : Set J) :
    reflectionSubgroup P S ≤ P.weylGroup :=
  Langlands.RootDatum.reflectionSubgroup_le_weylGroup P S

instance finite_reflectionSubgroup (S : Set J) [Finite P.weylGroup] :
    Finite (reflectionSubgroup P S) :=
  Finite.of_injective (Subgroup.inclusion (reflectionSubgroup_le P S))
    (Subgroup.inclusion_injective _)

theorem reflection_mem (S : Set J) {i : J} (hi : i ∈ S) :
    RootPairing.Equiv.reflection P i ∈ reflectionSubgroup P S :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

/-- These reflections fix every weight annihilating their coroots, pointwise. -/
theorem fixes_annihilator (S : Set J) (w : reflectionSubgroup P S) (x : M)
    (hx : ∀ i ∈ S, P.toLinearMap x (P.coroot i) = 0) :
    w.val.weightEquiv x = x :=
  Langlands.RootDatum.reflectionSubgroup_fixed P S x hx w.property

variable [Fintype J]

private theorem corootForm_coroot_pos (i : J) :
    0 < P.CorootForm (P.coroot i) (P.coroot i) := by
  rw [P.corootForm_apply_apply]
  apply Finset.sum_pos'
  · intro j _
    exact mul_self_nonneg _
  · exact ⟨i, Finset.mem_univ _, by simp⟩

private theorem two_mul_corootForm_coroot (i : J) (f : N) :
    2 * P.CorootForm f (P.coroot i) =
      P.CorootForm (P.coroot i) (P.coroot i) * P.root' i f := by
  have h := congrArg (fun x : M => P.toLinearMap x f)
    (P.corootForm_self_smul_root i)
  have hs : P.CorootForm (P.coroot i) f = P.CorootForm f (P.coroot i) :=
    P.flip.rootForm_symmetric.eq _ _
  simp only [map_smul, map_nsmul, LinearMap.smul_apply, smul_eq_mul, nsmul_eq_mul,
    Nat.cast_ofNat] at h
  rw [P.toLinearMap_apply_CoPolarization, hs] at h
  exact h.symm

/-- A maximum on the finite subgroup orbit aligns evaluations at every
generating reflection index, allowing singular covectors. -/
theorem exists_nonneg (S : Set J) [Finite (reflectionSubgroup P S)] (f g : N) :
    ∃ w : reflectionSubgroup P S, ∀ i ∈ S,
      0 ≤ P.root' i f * P.root' i (w.val.coweightEquiv g) := by
  obtain ⟨w, hw⟩ := Finite.exists_max
    (fun w : reflectionSubgroup P S => P.CorootForm f (w.val.coweightEquiv g))
  refine ⟨w, fun i hi => ?_⟩
  let r : reflectionSubgroup P S := ⟨_, reflection_mem P S hi⟩
  have hi' := hw (w * r)
  change P.CorootForm f (P.coreflection i (w.val.coweightEquiv g)) ≤
    P.CorootForm f (w.val.coweightEquiv g) at hi'
  rw [P.coreflection_apply, map_sub, map_smul, smul_eq_mul] at hi'
  have hn := corootForm_coroot_pos P i
  have he := two_mul_corootForm_coroot P i f
  have hmul : 0 ≤ P.root' i (w.val.coweightEquiv g) *
      P.CorootForm f (P.coroot i) := by linarith
  have hprod : 0 ≤ P.CorootForm (P.coroot i) (P.coroot i) *
      (P.root' i f * P.root' i (w.val.coweightEquiv g)) := by
    calc
      0 ≤ 2 * (P.root' i (w.val.coweightEquiv g) *
        P.CorootForm f (P.coroot i)) := mul_nonneg (by norm_num) hmul
      _ = P.root' i (w.val.coweightEquiv g) *
        (2 * P.CorootForm f (P.coroot i)) := by ring
      _ = _ := by rw [he]; ring
  exact nonneg_of_mul_nonneg_right hprod hn

omit [Fintype J] in
private theorem regular_coweightEquiv {g : N}
    (hg : ∀ i, P.root' i g ≠ 0) (w : P.Aut) :
    ∀ i, P.root' i (w.coweightEquiv g) ≠ 0 := by
  intro i
  have h := w.root'_coweightEquiv i (w.coweightEquiv g)
  simp only [LinearEquiv.symm_apply_apply] at h
  exact h ▸ hg (w.indexEquiv i)

/-- Any two regular covectors have matching signs on the generating indices
after translating one of them by this finite reflection subgroup. -/
theorem exists_same_signs (S : Set J) [Finite (reflectionSubgroup P S)] {f g : N}
    (hf : ∀ i, P.root' i f ≠ 0) (hg : ∀ i, P.root' i g ≠ 0) :
    ∃ w : reflectionSubgroup P S, ∀ i ∈ S,
      0 < P.root' i f ↔ 0 < P.root' i (w.val.coweightEquiv g) := by
  obtain ⟨w, hw⟩ := exists_nonneg P S f g
  refine ⟨w, fun i hi => ?_⟩
  have hg' := regular_coweightEquiv P hg w.val i
  have hpos : 0 < P.root' i f * P.root' i (w.val.coweightEquiv g) :=
    lt_of_le_of_ne (hw i hi) (Ne.symm (mul_ne_zero (hf i) hg'))
  rcases mul_pos_iff.mp hpos with h | h
  · exact iff_of_true h.1 h.2
  · exact iff_of_false (not_lt.mpr h.1.le) (not_lt.mpr h.2.le)

end Langlands.LinearAlgebra.RootDatumWeylChambers
