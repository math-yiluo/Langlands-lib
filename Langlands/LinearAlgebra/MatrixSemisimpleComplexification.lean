import Langlands.LinearAlgebra.MatrixSemisimpleDirections
import Langlands.LinearAlgebra.RealMatrixComplexification
import Mathlib.FieldTheory.Perfect
import Mathlib.LinearAlgebra.Eigenspace.Semisimple
import Mathlib.LinearAlgebra.Eigenspace.Minpoly

/-! # Polynomial semisimple directions and complexification -/

noncomputable section

open Matrix Polynomial Module

set_option autoImplicit false

namespace Langlands

variable {n : ℕ}

local notation "RMat" => Matrix (Fin n) (Fin n) ℝ
local notation "CMat" => Matrix (Fin n) (Fin n) ℂ

@[simp]
theorem realMatrixComplexification_smul (r : ℝ) (A : RMat) :
    realMatrixComplexification n (r • A) = (r : ℂ) • realMatrixComplexification n A := by
  ext i j
  simp [Matrix.smul_apply, smul_eq_mul]

theorem realMatrixComplexification_aeval (A : RMat) (p : ℝ[X]) :
    realMatrixComplexification n (aeval A p) =
      aeval (realMatrixComplexification n A) (p.map Complex.ofRealHom) := by
  apply Polynomial.map_aeval_eq_aeval_map
  ext1 r
  simp only [RingHom.comp_apply, Algebra.algebraMap_eq_smul_one,
    realMatrixComplexification_smul, map_one]
  rfl

/-- Complexification of a semisimple real matrix is semisimple. -/
theorem isSemisimple_realMatrixComplexification {S : RMat}
    (hS : Module.End.IsSemisimple (Matrix.toLinAlgEquiv' S)) :
    Module.End.IsSemisimple (Matrix.toLinAlgEquiv' (realMatrixComplexification n S)) := by
  have hR := hS.minpoly_squarefree
  change Squarefree (minpoly ℝ (Matrix.toLin' S)) at hR
  rw [Matrix.minpoly_toLin'] at hR
  have hC : Squarefree ((minpoly ℝ S).map Complex.ofRealHom) :=
    (PerfectField.separable_iff_squarefree.mpr hR).map.squarefree
  apply Module.End.isSemisimple_of_squarefree_aeval_eq_zero hC
  rw [aeval_algHom_apply (Matrix.toLinAlgEquiv' : CMat ≃ₐ[ℂ] End ℂ (Fin n → ℂ)),
    ← realMatrixComplexification_aeval, minpoly.aeval, map_zero, map_zero]

/-- On a generalized eigenspace of the complexified real matrix, the complexified polynomial
semisimple part acts as multiplication by the eigenvalue. -/
theorem realMatrixComplexification_semisimplePart_apply (C : RMat) (a : ℂ) (v : Fin n → ℂ)
    (hv : v ∈ Module.End.maxGenEigenspace (Matrix.toLinAlgEquiv' (realMatrixComplexification n C)) a) :
    Matrix.toLinAlgEquiv' (realMatrixComplexification n (matrixSemisimplePart C)) v = a • v := by
  let L : CMat ≃ₐ[ℂ] End ℂ (Fin n → ℂ) := Matrix.toLinAlgEquiv'
  have hcomm : Commute C (matrixSemisimplePart C) :=
    Algebra.commute_of_mem_adjoin_self (matrixSemisimplePart_mem_adjoin C)
  have hn : IsNilpotent (L (realMatrixComplexification n C) -
      L (realMatrixComplexification n (matrixSemisimplePart C))) := by
    rw [← map_sub, ← map_sub]
    exact ((isNilpotent_sub_matrixSemisimplePart C).map (realMatrixComplexification n)).map L
  exact Module.End.apply_eq_of_mem_of_comm_of_isFinitelySemisimple_of_isNil hv
    ((hcomm.map (realMatrixComplexification n)).map L)
    (isSemisimple_realMatrixComplexification (matrixSemisimplePart_isSemisimple C)).isFinitelySemisimple hn

/-- Entrywise complex conjugation on square matrices. -/
def matrixEntryConjugation (n : ℕ) :
    Matrix (Fin n) (Fin n) ℂ →+* Matrix (Fin n) (Fin n) ℂ :=
  (starRingEnd ℂ).mapMatrix

@[simp]
theorem matrixEntryConjugation_apply (A : CMat) (i j : Fin n) :
    matrixEntryConjugation n A i j = star (A i j) := rfl

@[simp]
theorem matrixEntryConjugation_complexification (A : RMat) :
    matrixEntryConjugation n (realMatrixComplexification n A) = realMatrixComplexification n A := by
  ext i j
  simp

theorem matrixEntryConjugation_aeval_complexification (A : RMat) (p : ℂ[X]) :
    matrixEntryConjugation n (aeval (realMatrixComplexification n A) p) =
      aeval (realMatrixComplexification n A) (p.map (starRingEnd ℂ)) := by
  rw [Polynomial.map_aeval_eq_aeval_map (φ := starRingEnd ℂ) (by
    ext1 z
    simp only [RingHom.comp_apply, Algebra.algebraMap_eq_smul_one]
    ext i j
    by_cases hij : i = j <;> simp [Matrix.smul_apply, smul_eq_mul, hij]),
    matrixEntryConjugation_complexification]

theorem realMatrixComplexification_realPart (A : CMat) :
    realMatrixComplexification n (A.map Complex.re) =
      (1 / 2 : ℂ) • (A + matrixEntryConjugation n A) := by
  ext i j
  apply Complex.ext <;>
    simp [Matrix.smul_apply, smul_eq_mul, Complex.mul_re, Complex.mul_im, Complex.add_re,
      Complex.add_im, Matrix.add_apply]
  ring

/-- Taking the real part of a polynomial in a complexified matrix gives a direction in the
real algebra generated by the matrix. -/
theorem realPart_aeval_complexification_mem_adjoin (A : RMat) (p : ℂ[X]) :
    (aeval (realMatrixComplexification n A) p).map Complex.re ∈ Algebra.adjoin ℝ {A} := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    have h : (aeval (realMatrixComplexification n A) (p + q)).map Complex.re =
        (aeval (realMatrixComplexification n A) p).map Complex.re +
          (aeval (realMatrixComplexification n A) q).map Complex.re := by
      ext i j
      simp [Matrix.add_apply, Complex.add_re]
    rw [h]
    exact (Algebra.adjoin ℝ {A}).add_mem hp hq
  | monomial k c =>
    rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, Matrix.smul_mul, one_mul, ← map_pow]
    have h : (c • realMatrixComplexification n (A ^ k)).map Complex.re = c.re • A ^ k := by
      ext i j
      simp only [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, Complex.mul_re,
        realMatrixComplexification_apply, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
    rw [h]
    exact (Algebra.adjoin ℝ {A}).smul_mem (pow_mem (Algebra.subset_adjoin (Set.mem_singleton A)) k) c.re

end Langlands
