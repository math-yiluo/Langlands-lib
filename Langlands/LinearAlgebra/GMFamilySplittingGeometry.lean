import Langlands.LinearAlgebra.GMFamilyRootGeometry
import Langlands.LinearAlgebra.GMFamilySplittingMeasures
import Mathlib.Data.Finset.Sum

/-! # Normal bases and sections for alternate splitting -/

noncomputable section

open Classical Finset
open scoped RealInnerProductSpace

namespace Langlands.GMFamily

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  {R : Finset E} {a : Submodule ℝ E}

/-- The orthogonal complement of the common root kernel in `a`. -/
abbrev effectiveSpace (R : Finset E) (a : Submodule ℝ E) := a ⊓ (centralSpace R)ᗮ

/-- A simple restricted root viewed in the effective space. -/
def simpleNormal {P : Finset E} (hR : IsRootSet R) (ha : IsLeviSpace R a)
    (hP : P ∈ parabolics R a) (i : simpleRoots a P) : effectiveSpace R a :=
  ⟨(i : E), by
    change (i : E) ∈ a ⊓ (centralSpace R)ᗮ
    rw [← span_simpleRoots_eq hR ha hP]
    exact Submodule.subset_span (Set.mem_range_self i)⟩

omit [FiniteDimensional ℝ E] in
private theorem span_eq_top_of_subtype {V : Submodule ℝ E} {ι : Type*} (v : ι → V)
    (h : Submodule.span ℝ (Set.range fun i => (v i : E)) = V) : Submodule.span ℝ (Set.range v) = ⊤ := by
  apply Submodule.map_injective_of_injective V.injective_subtype
  rw [Submodule.map_top, Submodule.range_subtype, ← Submodule.span_image, ← Set.range_comp]
  exact h

/-- The simple normal vectors of a chamber form a basis of the effective space. -/
theorem simpleNormal_basis {P : Finset E} (hR : IsRootSet R) (ha : IsLeviSpace R a)
    (hP : P ∈ parabolics R a) : LinearIndependent ℝ (simpleNormal hR ha hP) ∧
      Submodule.span ℝ (Set.range (simpleNormal hR ha hP)) = ⊤ := by
  constructor
  · apply LinearIndependent.of_comp (effectiveSpace R a).subtype
    exact (linearIndependent_simpleRoots hR ha hP).map' a.subtype (LinearMap.ker_eq_bot.mpr a.injective_subtype)
  · exact span_eq_top_of_subtype _ (span_simpleRoots_eq hR ha hP)

/-- The normal space generated by a specified subset of simple restricted roots. -/
def normalSpan (P : Finset E) (I : Finset (simpleRoots a P)) : Submodule ℝ E :=
  Submodule.span ℝ (Set.range fun i : I => ((i : simpleRoots a P) : E))

/-- The flat cut out by a subset of the simple restricted roots. -/
def normalFlat (P : Finset E) (I : Finset (simpleRoots a P)) : Submodule ℝ E :=
  a ⊓ (normalSpan P I)ᗮ

theorem normalSpan_le {P : Finset E} (hR : IsRootSet R) (ha : IsLeviSpace R a)
    (hP : P ∈ parabolics R a) (I : Finset (simpleRoots a P)) : normalSpan P I ≤ effectiveSpace R a := by
  change normalSpan P I ≤ a ⊓ (centralSpace R)ᗮ
  rw [← span_simpleRoots_eq hR ha hP]
  exact Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨i.val, rfl⟩)

theorem mem_normalFlat_iff {P : Finset E} (I : Finset (simpleRoots a P)) (x : a) :
    (x : E) ∈ normalFlat P I ↔ ∀ i ∈ I, ⟪(i : a), x⟫ = 0 := by
  rw [normalFlat, Submodule.mem_inf, and_iff_right x.property, normalSpan, Submodule.mem_orthogonal]
  constructor
  · intro h i hi
    exact h _ (Submodule.subset_span (Set.mem_range_self (⟨i, hi⟩ : I)))
  · intro h y hy
    induction hy using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨i, rfl⟩ := hv
      exact h i i.property
    | zero => simp
    | add _ _ _ _ h₁ h₂ => simp [inner_add_left, h₁, h₂]
    | smul _ _ _ hz => simp [real_inner_smul_left, hz]

/-- The relative orthogonal complement of the root flat is its defining normal span. -/
theorem inf_orthogonal_normalFlat {P : Finset E} (I : Finset (simpleRoots a P)) :
    a ⊓ (normalFlat P I)ᗮ = normalSpan P I := by
  have hle : normalSpan P I ≤ a := Submodule.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact ((i : simpleRoots a P) : a).property)
  simpa only [normalFlat, inf_comm] using Submodule.orthogonal_inf_orthogonal_inf_of_le hle

/-- A regular point of the chosen flat selects precisely the roots in the chosen subset
among the simple roots of any incident chamber. -/
theorem normalFlat_eq_of_zero_filter (hR : IsRootSet R) (ha : IsLeviSpace R a)
    {P : Finset E} (hP : P ∈ parabolics R a) (x : a) (hx : posSet R (x : E) ⊆ P) :
    normalFlat P (univ.filter fun i : simpleRoots a P => ⟪(i : a), x⟫ = 0) = leviSpaceOf R (x : E) := by
  rw [← faceSpace_posSet_eq_leviSpaceOf hR ha x, faceSpace_eq_orthogonal_simpleRoots hR hP x hx,
    normalFlat, normalSpan]
  congr 3
  ext v
  simp only [Set.mem_range, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i.val, rfl, (mem_filter.mp i.property).2⟩
  · rintro ⟨i, rfl, hi⟩
    exact ⟨⟨i, mem_filter.mpr ⟨mem_univ _, hi⟩⟩, rfl⟩

/-- Every subset of a chamber's simple roots cuts out a Levi flat. -/
theorem normalFlat_mem_leviSpaces (hR : IsRootSet R) (ha : IsLeviSpace R a)
    {P : Finset E} (hP : P ∈ parabolics R a) (I : Finset (simpleRoots a P)) :
    normalFlat P I ∈ leviSpaces R a := by
  let c (i : simpleRoots a P) : ℝ := if i ∈ I then 0 else 1
  obtain ⟨x, hx⟩ := exists_inner_values (linearIndependent_simpleRoots hR ha hP) c
  have hxpos : posSet R (x : E) ⊆ P := (posSet_subset_iff_nonneg hR hP x).mpr
    (nonneg_posSet_of_nonneg_simpleRoots hP x (fun i => by rw [hx]; unfold c; split <;> positivity))
  have hI : univ.filter (fun i : simpleRoots a P => ⟪(i : a), x⟫ = 0) = I := by
    ext i
    simp only [mem_filter, mem_univ, true_and, hx, c]
    by_cases hi : i ∈ I <;> simp [hi]
  rw [← hI, normalFlat_eq_of_zero_filter hR ha hP x hxpos]
  exact (mem_leviSpaces_iff hR ha _).mpr ⟨leviSpaceOf_le_of_mem ha x.property, ⟨x, rfl⟩⟩

omit [FiniteDimensional ℝ E] in
/-- The displayed decomposition determines the section at its regular pair of points. -/
theorem splittingSection_eq_of_unique {ξ : E} {L₁ L₂ : Submodule ℝ E} {x₁ x₂ : E}
    (h₁ : x₁ ∈ L₁ ⊓ (centralSpace R)ᗮ) (h₂ : x₂ ∈ L₂ ⊓ (centralSpace R)ᗮ)
    (he : (2 : ℝ) • ξ = x₁ - x₂)
    (hu : ∀ y₁ y₂ : E, y₁ ∈ L₁ ⊓ (centralSpace R)ᗮ → y₂ ∈ L₂ ⊓ (centralSpace R)ᗮ →
      (2 : ℝ) • ξ = y₁ - y₂ → y₁ = x₁ ∧ y₂ = x₂) :
    splittingSection R ξ L₁ L₂ = (posSet R x₁, posSet R x₂) := by
  have h : ∃ y₁ y₂ : E, y₁ ∈ L₁ ⊓ (centralSpace R)ᗮ ∧ y₂ ∈ L₂ ⊓ (centralSpace R)ᗮ ∧
      (2 : ℝ) • ξ = y₁ - y₂ := ⟨_, _, h₁, h₂, he⟩
  unfold splittingSection
  rw [dite_eq_left h]
  obtain ⟨h₁', h₂'⟩ := hu h.choose h.choose_spec.choose h.choose_spec.choose_spec.1
    h.choose_spec.choose_spec.2.1 h.choose_spec.choose_spec.2.2
  exact Prod.ext (congrArg (posSet R) h₁') (congrArg (posSet R) h₂')

omit [FiniteDimensional ℝ E] in
private theorem normalSpace_le_of_levi {L : Submodule ℝ E} (hL : IsLeviSpace R L) : a ⊓ Lᗮ ≤ effectiveSpace R a :=
  inf_le_inf_left _ (Submodule.orthogonal_le (centralSpace_le_of_isLeviSpace hL))

set_option maxHeartbeats 800000 in
/-- A nonzero splitting determinant yields an existing and unique pair of section points. -/
theorem exists_unique_splitting_points (hR : IsRootSet R) (ha : IsLeviSpace R a)
    {L₁ L₂ : Submodule ℝ E} (hL₁ : L₁ ∈ leviSpaces R a) (hL₂ : L₂ ∈ leviSpaces R a)
    (hd : dCoeff R a L₁ L₂ ≠ 0) (ξ : effectiveSpace R a) :
    ∃ x₁ x₂ : E, x₁ ∈ L₁ ⊓ (centralSpace R)ᗮ ∧ x₂ ∈ L₂ ⊓ (centralSpace R)ᗮ ∧
      (2 : ℝ) • (ξ : E) = x₁ - x₂ ∧
      ∀ y₁ y₂ : E, y₁ ∈ L₁ ⊓ (centralSpace R)ᗮ → y₂ ∈ L₂ ⊓ (centralSpace R)ᗮ →
        (2 : ℝ) • (ξ : E) = y₁ - y₂ → y₁ = x₁ ∧ y₂ = x₂ := by
  let U₁ := a ⊓ L₁ᗮ
  let U₂ := a ⊓ L₂ᗮ
  let V := effectiveSpace R a
  have hLa₁ := (mem_leviSpaces_iff hR ha L₁).mp hL₁
  have hLa₂ := (mem_leviSpaces_iff hR ha L₂).mp hL₂
  have hU₁ : U₁ ≤ V := normalSpace_le_of_levi hLa₁.2
  have hU₂ : U₂ ≤ V := normalSpace_le_of_levi hLa₂.2
  obtain ⟨hdis, hsum⟩ := (measureFactor_ne_zero_iff hU₁ hU₂).mp hd
  let b₁ := (stdOrthonormalBasis ℝ U₁).toBasis
  let b₂ := (stdOrthonormalBasis ℝ U₂).toBasis
  let v₁ (i : Fin (Module.finrank ℝ U₁)) : V := ⟨b₁ i, hU₁ (b₁ i).property⟩
  let v₂ (i : Fin (Module.finrank ℝ U₂)) : V := ⟨b₂ i, hU₂ (b₂ i).property⟩
  have hspan₁ : Submodule.span ℝ (Set.range fun i => (v₁ i : E)) = U₁ := by
    change Submodule.span ℝ (Set.range (U₁.subtype ∘ b₁)) = U₁
    rw [Set.range_comp, Submodule.span_image, b₁.span_eq, Submodule.map_top, Submodule.range_subtype]
  have hspan₂ : Submodule.span ℝ (Set.range fun i => (v₂ i : E)) = U₂ := by
    change Submodule.span ℝ (Set.range (U₂.subtype ∘ b₂)) = U₂
    rw [Set.range_comp, Submodule.span_image, b₂.span_eq, Submodule.map_top, Submodule.range_subtype]
  have hv : LinearIndependent ℝ (Sum.elim v₁ v₂) := by
    apply LinearIndependent.of_comp V.subtype
    have he : V.subtype ∘ Sum.elim v₁ v₂ = Sum.elim (fun i => (v₁ i : E)) (fun i => (v₂ i : E)) := by
      funext i
      cases i <;> rfl
    rw [he]
    apply LinearIndependent.sum_type
    · exact b₁.linearIndependent.map' _ (LinearMap.ker_eq_bot.mpr U₁.injective_subtype)
    · exact b₂.linearIndependent.map' _ (LinearMap.ker_eq_bot.mpr U₂.injective_subtype)
    · rwa [hspan₁, hspan₂]
  let c := Sum.elim (fun i => -⟪v₁ i, ξ⟫) (fun i => ⟪v₂ i, ξ⟫)
  obtain ⟨x, hx⟩ := exists_inner_values hv c
  have hflat₁ : a ⊓ U₁ᗮ = L₁ := by
    simpa only [U₁, inf_comm] using Submodule.orthogonal_inf_orthogonal_inf_of_le hLa₁.1
  have hflat₂ : a ⊓ U₂ᗮ = L₂ := by
    simpa only [U₂, inf_comm] using Submodule.orthogonal_inf_orthogonal_inf_of_le hLa₂.1
  have horth {ι : Type} {U : Submodule ℝ E} (v : ι → V)
      (hs : Submodule.span ℝ (Set.range fun i => (v i : E)) = U) (y : V)
      (hy : ∀ i, ⟪v i, y⟫ = 0) : (y : E) ∈ Uᗮ := by
    rw [← hs, Submodule.mem_orthogonal]
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw => obtain ⟨i, rfl⟩ := hw; exact hy i
    | zero => simp
    | add _ _ _ _ h₁ h₂ => simp [inner_add_left, h₁, h₂]
    | smul _ _ _ h => simp [real_inner_smul_left, h]
  have h₁ : ((x + ξ : V) : E) ∈ L₁ ⊓ (centralSpace R)ᗮ := by
    refine ⟨?_, (x + ξ : V).property.2⟩
    rw [← hflat₁]
    refine ⟨(x + ξ : V).property.1, horth v₁ hspan₁ _ ?_⟩
    intro i
    have h := hx (.inl i)
    change ⟪v₁ i, x⟫ = -⟪v₁ i, ξ⟫ at h
    rw [inner_add_right, h, neg_add_cancel]
  have h₂ : ((x - ξ : V) : E) ∈ L₂ ⊓ (centralSpace R)ᗮ := by
    refine ⟨?_, (x - ξ : V).property.2⟩
    rw [← hflat₂]
    refine ⟨(x - ξ : V).property.1, horth v₂ hspan₂ _ ?_⟩
    intro i
    have h := hx (.inr i)
    change ⟪v₂ i, x⟫ = ⟪v₂ i, ξ⟫ at h
    rw [inner_sub_right, h, sub_self]
  have he : (2 : ℝ) • (ξ : E) = ((x + ξ : V) : E) - ((x - ξ : V) : E) := by
    simp only [Submodule.coe_add, Submodule.coe_sub, two_smul]
    abel
  refine ⟨_, _, h₁, h₂, he, fun y₁ y₂ hy₁ hy₂ hy => ?_⟩
  let z := y₁ - ((x + ξ : V) : E)
  have hz : z = y₂ - ((x - ξ : V) : E) := by
    calc
      z = (y₁ - y₂) - (((x + ξ : V) : E) - ((x - ξ : V) : E)) + (y₂ - ((x - ξ : V) : E)) := by
        dsimp [z]
        abel
      _ = _ := by rw [← hy, ← he, sub_self, zero_add]
  have hz₁ : z ∈ L₁ ⊓ (centralSpace R)ᗮ := Submodule.sub_mem _ hy₁ h₁
  have hz₂ : z ∈ L₂ ⊓ (centralSpace R)ᗮ := hz ▸ Submodule.sub_mem _ hy₂ h₂
  have hzV : z ∈ V := ⟨hLa₁.1 hz₁.1, hz₁.2⟩
  have hzO₁ : z ∈ U₁ᗮ := by
    have h : z ∈ L₁ := hz₁.1
    rw [← hflat₁] at h
    exact h.2
  have hzO₂ : z ∈ U₂ᗮ := by
    have h : z ∈ L₂ := hz₂.1
    rw [← hflat₂] at h
    exact h.2
  have hself : ⟪z, z⟫ = 0 := by
    rw [← hsum, Submodule.mem_sup] at hzV
    obtain ⟨z₁, hz₁', z₂, hz₂', heq⟩ := hzV
    calc
      ⟪z, z⟫ = ⟪z₁ + z₂, z⟫ := congrArg (fun w : E => ⟪w, z⟫) heq.symm
      _ = 0 := by rw [inner_add_left, hzO₁ z₁ hz₁', hzO₂ z₂ hz₂', add_zero]
  have hz0 : z = 0 := by simpa only [inner_self_eq_zero] using hself
  exact ⟨sub_eq_zero.mp hz0, sub_eq_zero.mp (hz ▸ hz0)⟩

end Langlands.GMFamily
