import Mathlib.LinearAlgebra.RootSystem.Finite.Nondegenerate
import Mathlib.LinearAlgebra.RootSystem.Base
import Mathlib.Algebra.Group.Submonoid.Finsupp

/-! # Dominant orbit representatives and triangular spanning of invariants -/

noncomputable section

open Set Function

namespace Langlands.LinearAlgebra.DominantTriangular

variable {ι M N : Type*} [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) (b : P.Base)

/-- The subgroup of linear automorphisms of `M` generated by all root reflections. -/
def reflectionGroup : Subgroup (M ≃ₗ[ℤ] M) :=
  Subgroup.closure (Set.range P.reflection)

/-- The additive monoid of nonnegative integral combinations of the simple roots. -/
def positiveCone : AddSubmonoid M :=
  AddSubmonoid.closure (Set.range fun a : b.support => P.root a)

/-- An element is dominant when its pairing with every simple coroot is nonnegative. -/
def IsDominant (x : M) : Prop :=
  ∀ a : b.support, 0 ≤ P.toLinearMap x (P.coroot a)

/-- A finitely supported function on `M` is invariant under a group of automorphisms. -/
def IsInvariant {k : Type*} [Zero k] (W : Subgroup (M ≃ₗ[ℤ] M)) (f : M →₀ k) : Prop :=
  ∀ w ∈ W, ∀ μ, f (w μ) = f μ

theorem reflection_mem_reflectionGroup (i : ι) : P.reflection i ∈ reflectionGroup P :=
  Subgroup.subset_closure (Set.mem_range_self i)

theorem root_mem_positiveCone (a : b.support) : P.root a ∈ positiveCone P b :=
  AddSubmonoid.subset_closure ⟨a, rfl⟩

/-! ### The positive cone is pointed -/

theorem positiveCone_sum_eq {n : b.support →₀ ℕ} :
    (n.sum fun a m => m • P.root a) =
      Finsupp.linearCombination ℤ (fun a : b.support => P.root a)
        (n.mapRange (fun m : ℕ => (m : ℤ)) Nat.cast_zero) := by
  rw [Finsupp.linearCombination_apply,
    Finsupp.sum_mapRange_index (h := fun (a : b.support) (m : ℤ) => m • P.root a)
      (fun a => zero_smul ℤ _)]
  exact Finsupp.sum_congr fun a _ => (natCast_zsmul _ _).symm

/-- A nonnegative combination of simple roots whose negative is also nonnegative vanishes. -/
theorem eq_zero_of_mem_positiveCone_of_neg_mem {x : M} (hx : x ∈ positiveCone P b)
    (hx' : -x ∈ positiveCone P b) : x = 0 := by
  classical
  obtain ⟨n, rfl⟩ := AddSubmonoid.mem_closure_range_iff.mp hx
  obtain ⟨n', hn'⟩ := AddSubmonoid.mem_closure_range_iff.mp hx'
  have hli : LinearIndependent ℤ (fun a : b.support => P.root a) := b.linearIndepOn_root
  have hsum : Finsupp.linearCombination ℤ (fun a : b.support => P.root a)
      ((n + n').mapRange (fun m : ℕ => (m : ℤ)) Nat.cast_zero) = 0 := by
    rw [Finsupp.mapRange_add (fun _ _ => Nat.cast_add _ _), map_add,
      ← positiveCone_sum_eq, ← positiveCone_sum_eq, ← hn']
    exact add_neg_cancel _
  have h0 := (linearIndependent_iff.mp hli) _ hsum
  have hn : n = 0 := by
    ext a
    have ha := congrArg (fun f : b.support →₀ ℤ => f a) h0
    simp only [Finsupp.mapRange_apply, Finsupp.add_apply, Nat.cast_add,
      Finsupp.coe_zero, Pi.zero_apply] at ha
    simp only [Finsupp.coe_zero, Pi.zero_apply]
    omega
  simp [hn]

theorem positiveCone_le_rootSpan :
    (positiveCone P b : Set M) ⊆ P.rootSpan ℤ := by
  intro x hx
  induction hx using AddSubmonoid.closure_induction with
  | mem y hy =>
    obtain ⟨a, rfl⟩ := hy
    exact Submodule.subset_span (Set.mem_range_self _)
  | zero => exact zero_mem _
  | add y z _ _ hy hz => exact add_mem hy hz

/-! ### Finiteness of the reflection group -/

variable {P}

/-- Every element of the reflection group moves each vector by an element of the root span. -/
theorem sub_mem_rootSpan_of_mem_reflectionGroup {w : M ≃ₗ[ℤ] M} (hw : w ∈ reflectionGroup P)
    (x : M) : w x - x ∈ P.rootSpan ℤ := by
  induction hw using Subgroup.closure_induction generalizing x with
  | mem v hv =>
    obtain ⟨i, rfl⟩ := hv
    rw [RootPairing.reflection_apply, sub_sub_cancel_left, neg_mem_iff]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self i))
  | one => simp
  | mul u v _ _ hu hv =>
    have := add_mem (hu (v x)) (hv x)
    rw [sub_add_sub_cancel] at this
    exact this
  | inv u _ hu =>
    have := neg_mem (hu (u.symm x))
    rw [LinearEquiv.apply_symm_apply, neg_sub] at this
    exact this

/-- Every element of the reflection group permutes the roots, compatibly with the coroot
functionals. -/
theorem exists_perm_of_mem_reflectionGroup {w : M ≃ₗ[ℤ] M} (hw : w ∈ reflectionGroup P) :
    ∃ σ : Equiv.Perm ι, ∀ i, w (P.root i) = P.root (σ i) ∧
      ∀ x, P.coroot' (σ i) (w x) = P.coroot' i x := by
  induction hw using Subgroup.closure_induction with
  | mem v hv =>
    obtain ⟨j, rfl⟩ := hv
    refine ⟨P.reflectionPerm j, fun i => ⟨(P.root_reflectionPerm j i).symm, fun x => ?_⟩⟩
    rw [P.coroot'_reflection, P.reflectionPerm_self]
  | one => exact ⟨1, fun i => ⟨rfl, fun x => rfl⟩⟩
  | mul u v _ _ hu hv =>
    obtain ⟨σ, hσ⟩ := hu
    obtain ⟨τ, hτ⟩ := hv
    refine ⟨σ * τ, fun i => ⟨?_, fun x => ?_⟩⟩
    · change u (v (P.root i)) = P.root (σ (τ i))
      rw [(hτ i).1, (hσ (τ i)).1]
    · change P.coroot' (σ (τ i)) (u (v x)) = _
      rw [(hσ (τ i)).2, (hτ i).2]
  | inv u _ hu =>
    obtain ⟨σ, hσ⟩ := hu
    refine ⟨σ⁻¹, fun i => ⟨?_, fun x => ?_⟩⟩
    · change u.symm (P.root i) = P.root (σ⁻¹ i)
      rw [LinearEquiv.symm_apply_eq, (hσ (σ⁻¹ i)).1, show σ (σ⁻¹ i) = i by simp]
    · change P.coroot' (σ⁻¹ i) (u.symm x) = P.coroot' i x
      rw [← (hσ (σ⁻¹ i)).2, LinearEquiv.apply_symm_apply, show σ (σ⁻¹ i) = i by simp]

/-- An element of the reflection group fixing every root is the identity. -/
theorem eq_one_of_mem_reflectionGroup [Finite ι] {w : M ≃ₗ[ℤ] M} (hw : w ∈ reflectionGroup P)
    (hroot : ∀ i, w (P.root i) = P.root i) : w = 1 := by
  classical
  let _ : Fintype ι := Fintype.ofFinite ι
  obtain ⟨σ, hσ⟩ := exists_perm_of_mem_reflectionGroup hw
  have hσi : ∀ i, σ i = i := fun i => P.root.injective (by rw [← (hσ i).1, hroot])
  ext x
  have hc : ∀ i, P.coroot' i (w x - x) = 0 := by
    intro i
    have h := (hσ i).2 x
    rw [hσi] at h
    rw [map_sub, h, sub_self]
  have h0 : P.RootForm (w x - x) (w x - x) = 0 := by
    rw [RootPairing.rootForm_apply_apply]
    simp [hc]
  have h := P.eq_zero_of_mem_rootSpan_of_rootForm_self_eq_zero
    (sub_mem_rootSpan_of_mem_reflectionGroup hw x) h0
  exact sub_eq_zero.mp h

/-- The reflection group of a root pairing with finitely many roots is finite. -/
instance finite_reflectionGroup [Finite ι] : Finite (reflectionGroup P) := by
  have hmem : ∀ w : reflectionGroup P, ∀ i, (w : M ≃ₗ[ℤ] M) (P.root i) ∈ Set.range P.root := by
    intro w i
    obtain ⟨σ, hσ⟩ := exists_perm_of_mem_reflectionGroup w.2
    exact ⟨σ i, (hσ i).1.symm⟩
  have : Finite (Set.range P.root) := Set.finite_range _
  refine Finite.of_injective (β := ι → Set.range P.root) (fun w i => ⟨_, hmem w i⟩) ?_
  intro v w hvw
  have h : ∀ i, ((v⁻¹ * w : reflectionGroup P) : M ≃ₗ[ℤ] M) (P.root i) = P.root i := by
    intro i
    have h' := congrArg Subtype.val (congrFun hvw i)
    change (v : M ≃ₗ[ℤ] M).symm ((w : M ≃ₗ[ℤ] M) (P.root i)) = P.root i
    rw [LinearEquiv.symm_apply_eq]
    exact h'.symm
  have h1 : v⁻¹ * w = 1 := Subtype.ext (eq_one_of_mem_reflectionGroup (v⁻¹ * w).2 h)
  exact (inv_mul_eq_one.mp h1)

/-! ### Orbits of the reflection group -/

/-- The orbit of `μ` under the reflection group. -/
def orbit (μ : M) : Set M := Set.range fun w : reflectionGroup P => (w : M ≃ₗ[ℤ] M) μ

theorem mem_orbit_iff {μ ν : M} :
    ν ∈ orbit (P := P) μ ↔ ∃ w ∈ reflectionGroup P, w μ = ν := by
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w, w.2, rfl⟩
  · rintro ⟨w, hw, rfl⟩
    exact ⟨⟨w, hw⟩, rfl⟩

theorem mem_orbit_self (μ : M) : μ ∈ orbit (P := P) μ :=
  mem_orbit_iff.mpr ⟨1, one_mem _, rfl⟩

theorem orbit_apply {w : M ≃ₗ[ℤ] M} (hw : w ∈ reflectionGroup P) (μ : M) :
    orbit (P := P) (w μ) = orbit (P := P) μ := by
  ext ν
  simp only [mem_orbit_iff]
  constructor
  · rintro ⟨v, hv, rfl⟩
    exact ⟨v * w, mul_mem hv hw, rfl⟩
  · rintro ⟨v, hv, rfl⟩
    refine ⟨v * w⁻¹, mul_mem hv (inv_mem hw), ?_⟩
    change v (w.symm (w μ)) = v μ
    rw [LinearEquiv.symm_apply_apply]

theorem orbit_eq_of_mem {μ ν : M} (h : ν ∈ orbit (P := P) μ) :
    orbit (P := P) ν = orbit (P := P) μ := by
  obtain ⟨w, hw, rfl⟩ := mem_orbit_iff.mp h
  exact orbit_apply hw μ

theorem finite_orbit [Finite ι] (μ : M) : (orbit (P := P) μ).Finite :=
  Set.finite_range _

open Classical in
/-- The indicator function of an orbit, as a finitely supported function. -/
def orbitSum [Finite ι] (k : Type*) [Zero k] [One k] (μ : M) : M →₀ k :=
  Finsupp.onFinset (finite_orbit μ).toFinset (fun ν => if ν ∈ orbit (P := P) μ then 1 else 0)
    (fun ν hν => by
      by_contra h
      exact hν (ite_eq_right (fun h' => h ((finite_orbit μ).mem_toFinset.mpr h'))))

open Classical in
theorem orbitSum_apply [Finite ι] (k : Type*) [Zero k] [One k] (μ ν : M) :
    orbitSum (P := P) k μ ν = if ν ∈ orbit (P := P) μ then 1 else 0 :=
  Finsupp.onFinset_apply

theorem orbitSum_eq_of_mem [Finite ι] (k : Type*) [Zero k] [One k]
    {μ ν : M} (h : ν ∈ orbit (P := P) μ) : orbitSum (P := P) k ν = orbitSum (P := P) k μ := by
  ext x
  have hx : x ∈ orbit (P := P) ν ↔ x ∈ orbit (P := P) μ := by rw [orbit_eq_of_mem h]
  rw [orbitSum_apply, orbitSum_apply]
  by_cases h' : x ∈ orbit (P := P) μ
  · rw [ite_eq_left (hx.mpr h'), ite_eq_left h']
  · rw [ite_eq_right (fun h'' => h' (hx.mp h'')), ite_eq_right h']

theorem orbitSum_isInvariant [Finite ι] (k : Type*) [Zero k] [One k]
    (μ : M) : IsInvariant (reflectionGroup P) (orbitSum (P := P) k μ) := by
  intro w hw ν
  have : w ν ∈ orbit (P := P) μ ↔ ν ∈ orbit (P := P) μ := by
    constructor
    · intro h
      rw [← orbit_eq_of_mem h, orbit_apply hw]
      exact mem_orbit_self ν
    · intro h
      rw [← orbit_eq_of_mem h]
      exact mem_orbit_iff.mpr ⟨w, hw, rfl⟩
  rw [orbitSum_apply, orbitSum_apply]
  by_cases h : ν ∈ orbit (P := P) μ
  · rw [ite_eq_left (this.mpr h), ite_eq_left h]
  · rw [ite_eq_right (fun h' => h (this.mp h')), ite_eq_right h]

theorem IsInvariant.apply_eq_of_mem {k : Type*} [Zero k] {f : M →₀ k}
    (hf : IsInvariant (reflectionGroup P) f) {μ ν : M} (h : ν ∈ orbit (P := P) μ) :
    f ν = f μ := by
  obtain ⟨w, hw, rfl⟩ := mem_orbit_iff.mp h
  exact hf w hw μ

/-! ### Decomposition of invariant functions into orbit indicators -/

/-- An invariant function lies in a submodule containing the orbit indicators of all
points of its support. -/
theorem isInvariant_mem_of_orbitSum_mem [Finite ι] {k : Type*} [Ring k]
    (S : Submodule k (M →₀ k)) :
    ∀ (f : M →₀ k), IsInvariant (reflectionGroup P) f →
      (∀ ν, f ν ≠ 0 → orbitSum (P := P) k ν ∈ S) → f ∈ S := by
  classical
  intro f
  induction hcard : f.support.card using Nat.strong_induction_on generalizing f with
  | _ n ih =>
    intro hf hS
    by_cases hf0 : f = 0
    · rw [hf0]; exact zero_mem _
    obtain ⟨μ, hμ⟩ : ∃ μ, f μ ≠ 0 := by
      by_contra h
      push Not at h
      exact hf0 (Finsupp.ext h)
    set g := f - f μ • orbitSum (P := P) k μ with hg
    have hgapp : ∀ ν, g ν = if ν ∈ orbit (P := P) μ then 0 else f ν := by
      intro ν
      simp only [hg, Finsupp.coe_sub, Finsupp.coe_smul, Pi.sub_apply, Pi.smul_apply,
        orbitSum_apply, smul_eq_mul]
      split_ifs with h
      · rw [hf.apply_eq_of_mem h, mul_one, sub_self]
      · rw [mul_zero, sub_zero]
    have hginv : IsInvariant (reflectionGroup P) g := by
      intro w hw ν
      simp only [hg, Finsupp.coe_sub, Finsupp.coe_smul, Pi.sub_apply, Pi.smul_apply]
      rw [hf w hw ν, orbitSum_isInvariant k μ w hw ν]
    have hsub : g.support ⊂ f.support := by
      rw [Finset.ssubset_iff_of_subset]
      · refine ⟨μ, Finsupp.mem_support_iff.mpr hμ, ?_⟩
        rw [Finsupp.mem_support_iff, hgapp, ite_eq_left (mem_orbit_self μ)]
        exact fun h => h rfl
      · intro ν hν
        rw [Finsupp.mem_support_iff] at hν ⊢
        rw [hgapp] at hν
        split_ifs at hν
        · exact absurd rfl hν
        · exact hν
    have hgS : g ∈ S := by
      refine ih _ (hcard ▸ Finset.card_lt_card hsub) g rfl hginv ?_
      intro ν hν
      apply hS
      rw [hgapp] at hν
      split_ifs at hν
      · exact absurd rfl hν
      · exact hν
    have : f = g + f μ • orbitSum (P := P) k μ := by
      rw [hg, sub_add_cancel]
    rw [this]
    exact add_mem hgS (Submodule.smul_mem _ _ (hS μ hμ))

/-! ### Dominant representatives of orbits -/

variable (P)

/-- The strict order `x < y` meaning that `y - x` is a nonzero element of the positive cone,
written with the arguments reversed so that a minimal element is a maximal point. -/
private def above (x y : M) : Prop := x - y ∈ positiveCone P b ∧ y ≠ x

private theorem above_trans {x y z : M} (hxy : above P b x y) (hyz : above P b y z) :
    above P b x z := by
  refine ⟨?_, ?_⟩
  · have := add_mem hxy.1 hyz.1
    rwa [sub_add_sub_cancel] at this
  · intro hzx
    apply hxy.2
    have h1 : x - y ∈ positiveCone P b := hxy.1
    have h2 : -(x - y) ∈ positiveCone P b := by rw [neg_sub, ← hzx]; exact hyz.1
    exact (sub_eq_zero.mp (eq_zero_of_mem_positiveCone_of_neg_mem P b h1 h2)).symm

variable {P b}

/-- Every orbit of the reflection group contains a dominant element. -/
theorem exists_dominant_mem_orbit [Finite ι] (μ : M) :
    ∃ ν ∈ orbit (P := P) μ, IsDominant P b ν := by
  classical
  have : Finite (orbit (P := P) μ) := (finite_orbit μ).to_subtype
  let r : orbit (P := P) μ → orbit (P := P) μ → Prop := fun x y => above P b x y
  have htrans : IsTrans (orbit (P := P) μ) r := ⟨fun _ _ _ h₁ h₂ => above_trans P b h₁ h₂⟩
  have hirr : Std.Irrefl r := ⟨fun x h => h.2 rfl⟩
  have hwf : WellFounded r := Finite.wellFounded_of_trans_of_irrefl r
  obtain ⟨x, -, hx⟩ := hwf.has_min Set.univ ⟨⟨μ, mem_orbit_self μ⟩, Set.mem_univ _⟩
  refine ⟨x, x.2, ?_⟩
  intro a
  by_contra hneg
  push Not at hneg
  set c := P.toLinearMap (x : M) (P.coroot a) with hc
  let y : orbit (P := P) μ := ⟨P.reflection a x, by
    have h : P.reflection a (x : M) ∈ orbit (P := P) (x : M) :=
      mem_orbit_iff.mpr ⟨P.reflection a, reflection_mem_reflectionGroup P a, rfl⟩
    rwa [orbit_eq_of_mem x.2] at h⟩
  have hyx : (y : M) - x = (-c).toNat • P.root a := by
    change P.reflection a x - x = _
    rw [RootPairing.reflection_apply, sub_sub_cancel_left, ← neg_smul]
    rw [← natCast_zsmul, Int.toNat_of_nonneg (by omega)]
    rfl
  apply hx y (Set.mem_univ _)
  refine ⟨?_, ?_⟩
  · rw [hyx]
    exact AddSubmonoid.nsmul_mem _ (root_mem_positiveCone P b a) _
  · intro hxy
    have h0 : (y : M) - x = 0 := by rw [hxy, sub_self]
    rw [hyx] at h0
    have h2 := congrArg (fun z => P.toLinearMap z (P.coroot a)) h0
    simp only [map_nsmul, LinearMap.smul_apply, RootPairing.root_coroot_two, map_zero,
      LinearMap.zero_apply, nsmul_eq_mul] at h2
    omega

/-! ### The root form decreases strictly below a dominant element -/

section RootForm

variable [Fintype ι]

theorem rootForm_root_nonneg_of_dominant {x : M} (hx : IsDominant P b x) (a : b.support) :
    0 ≤ P.RootForm (P.root a) x := by
  have h := congrArg (fun n => P.toLinearMap x n) (P.rootForm_self_smul_coroot a)
  simp only [map_smul, map_nsmul, smul_eq_mul, nsmul_eq_mul] at h
  rw [P.toLinearMap_apply_apply_Polarization] at h
  have hpos : 0 ≤ P.RootForm (P.root a) (P.root a) :=
    (P.rootForm_self_sum_of_squares _).nonneg
  have := mul_nonneg hpos (hx a)
  push_cast at h
  linarith

theorem rootForm_nonneg_of_mem_positiveCone {x d : M} (hx : IsDominant P b x)
    (hd : d ∈ positiveCone P b) : 0 ≤ P.RootForm d x := by
  induction hd using AddSubmonoid.closure_induction with
  | mem y hy =>
    obtain ⟨a, rfl⟩ := hy
    exact rootForm_root_nonneg_of_dominant hx a
  | zero => simp
  | add y z _ _ hy hz =>
    rw [map_add, LinearMap.add_apply]
    exact add_nonneg hy hz

theorem rootForm_self_pos_of_mem_positiveCone {d : M} (hd : d ∈ positiveCone P b)
    (hd0 : d ≠ 0) : 0 < P.RootForm d d := by
  have hspan : d ∈ P.rootSpan ℤ := positiveCone_le_rootSpan P b hd
  have hne : (⟨d, hspan⟩ : P.rootSpan ℤ) ≠ 0 := fun h => hd0 (congrArg Subtype.val h)
  have hpos := P.posRootForm_posForm_pos_of_ne_zero ℤ hne
  have heq := P.algebraMap_posRootForm_posForm ℤ ⟨d, hspan⟩ ⟨d, hspan⟩
  rw [Algebra.algebraMap_self_apply] at heq
  rw [← heq]
  exact hpos

/-- For dominant `μ` strictly below a dominant `lam`, the root form of `μ` is smaller. -/
theorem rootForm_lt_of_dominant {lam μ : M} (hμ : IsDominant P b μ)
    (hle : lam - μ ∈ positiveCone P b) (hne : μ ≠ lam) :
    P.RootForm μ μ < P.RootForm lam lam := by
  set d := lam - μ with hd
  have hlam : lam = μ + d := by rw [hd, add_sub_cancel]
  have hd0 : d ≠ 0 := fun h => hne (by rw [hlam, h, add_zero])
  have h1 := rootForm_nonneg_of_mem_positiveCone hμ hle
  have h2 := rootForm_self_pos_of_mem_positiveCone hle hd0
  have hsymm : P.RootForm μ d = P.RootForm d μ := (P.rootForm_symmetric.eq μ d)
  rw [hlam]
  simp only [map_add, LinearMap.add_apply]
  linarith

end RootForm

/-! ### Triangular spanning -/

/-- **Triangular spanning of invariants.** Suppose that every dominant `lam` admits an
invariant element `c` of a submodule `S`, with coefficient `1` at `lam` and support below
`lam`. Then every invariant finitely supported function lies in `S`. -/
theorem isInvariant_mem_of_triangular [Finite ι] {k : Type*} [Ring k]
    (S : Submodule k (M →₀ k))
    (hc : ∀ lam : M, IsDominant P b lam → ∃ c ∈ S, IsInvariant (reflectionGroup P) c ∧
      c lam = 1 ∧ ∀ μ, c μ ≠ 0 → lam - μ ∈ positiveCone P b)
    {f : M →₀ k} (hf : IsInvariant (reflectionGroup P) f) : f ∈ S := by
  classical
  let _ : Fintype ι := Fintype.ofFinite ι
  have hdom : ∀ n : ℕ, ∀ lam : M, IsDominant P b lam → (P.RootForm lam lam).toNat = n →
      orbitSum (P := P) k lam ∈ S := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro lam hlam hn
      obtain ⟨c, hcS, hcinv, hc1, hcle⟩ := hc lam hlam
      set g := c - orbitSum (P := P) k lam with hg
      have hginv : IsInvariant (reflectionGroup P) g := by
        intro w hw ν
        simp only [hg, Finsupp.coe_sub, Pi.sub_apply]
        rw [hcinv w hw ν, orbitSum_isInvariant k lam w hw ν]
      have hgS : g ∈ S := by
        refine isInvariant_mem_of_orbitSum_mem S g hginv ?_
        intro ν hν
        have hνorb : ν ∉ orbit (P := P) lam := by
          intro h
          apply hν
          simp only [hg, Finsupp.coe_sub, Pi.sub_apply, orbitSum_apply, ite_eq_left h]
          rw [hcinv.apply_eq_of_mem h, hc1, sub_self]
        have hcν : c ν ≠ 0 := by
          simpa only [hg, Finsupp.coe_sub, Pi.sub_apply, orbitSum_apply, ite_eq_right hνorb,
            sub_zero] using hν
        obtain ⟨ν', hν'orb, hν'dom⟩ := exists_dominant_mem_orbit (P := P) (b := b) ν
        have hcν' : c ν' ≠ 0 := by rwa [hcinv.apply_eq_of_mem hν'orb]
        have hle := hcle ν' hcν'
        have hne : ν' ≠ lam := by
          rintro rfl
          exact hνorb (by rw [orbit_eq_of_mem hν'orb]; exact mem_orbit_self _)
        have hlt := rootForm_lt_of_dominant hν'dom hle hne
        have hnn : 0 ≤ P.RootForm ν' ν' := (P.rootForm_self_sum_of_squares _).nonneg
        have hlt' : (P.RootForm ν' ν').toNat < n := by
          rw [← hn]
          exact (Int.toNat_lt_toNat (lt_of_le_of_lt hnn hlt)).mpr hlt
        rw [← orbitSum_eq_of_mem k hν'orb]
        exact ih _ hlt' ν' hν'dom rfl
      have : orbitSum (P := P) k lam = c - g := by rw [hg, sub_sub_cancel]
      rw [this]
      exact sub_mem hcS hgS
  refine isInvariant_mem_of_orbitSum_mem S f hf ?_
  intro ν _
  obtain ⟨ν', hν'orb, hν'dom⟩ := exists_dominant_mem_orbit (P := P) (b := b) ν
  rw [← orbitSum_eq_of_mem k hν'orb]
  exact hdom _ ν' hν'dom rfl

end Langlands.LinearAlgebra.DominantTriangular
