import Langlands.LinearAlgebra.TypeDParityLattice
import Mathlib.LinearAlgebra.Matrix.Cartan.Basic
import Mathlib.LinearAlgebra.LinearIndependent.Basic
import Mathlib.Tactic

/-! # Numbered integral coordinate vectors of type D -/

noncomputable section

namespace Langlands.TypeDNumberedVectors

variable {n : ℕ}

/-- The standard simple vector at a chain vertex, with the final vector the sum of the last
 two coordinate vectors. -/
def simple (hn : 2 ≤ n) (i : Fin n) : Fin n → ℤ :=
  if h : i.val + 1 < n then
    Pi.single i 1 - Pi.single ⟨i.val + 1, h⟩ 1
  else
    Pi.single ⟨n - 2, by omega⟩ 1 + Pi.single ⟨n - 1, by omega⟩ 1

/-- The additive monoid generated by the numbered simple vectors. -/
def positiveCone (hn : 2 ≤ n) : AddSubmonoid (Fin n → ℤ) :=
  AddSubmonoid.closure (Set.range (simple hn))

@[simp] theorem simple_chain (hn : 2 ≤ n) (i : Fin n) (hi : i.val + 1 < n) :
    simple hn i = Pi.single i 1 - Pi.single ⟨i.val + 1, hi⟩ 1 := by
  simp [simple, hi]

@[simp] theorem simple_last (hn : 2 ≤ n) :
    simple hn ⟨n - 1, by omega⟩ =
      Pi.single ⟨n - 2, by omega⟩ 1 + Pi.single ⟨n - 1, by omega⟩ 1 := by
  simp [simple, show ¬ n - 1 + 1 < n by omega]

theorem simple_mem_positiveCone (hn : 2 ≤ n) (i : Fin n) :
    simple hn i ∈ positiveCone hn :=
  AddSubmonoid.subset_closure (Set.mem_range_self _)

/-- Every forward coordinate difference is a sum of chain simple vectors. -/
theorem sub_mem_positiveCone (hn : 2 ≤ n) (a b : Fin n) (hab : a ≤ b) :
    Pi.single a 1 - Pi.single b 1 ∈ positiveCone hn := by
  have aux : ∀ d : ℕ, ∀ a b : Fin n, b.val - a.val = d → a ≤ b →
      Pi.single a 1 - Pi.single b 1 ∈ positiveCone hn := by
    intro d
    induction d with
    | zero =>
      intro a b hd hab
      have : a = b := Fin.ext (by omega)
      subst b
      simpa using (positiveCone hn).zero_mem
    | succ d ih =>
      intro a b hd hab
      have ha : a.val + 1 < n := by omega
      let a' : Fin n := ⟨a.val + 1, ha⟩
      have hm := (positiveCone hn).add_mem (simple_mem_positiveCone hn a)
        (ih a' b (by dsimp [a']; omega) (by change a.val + 1 ≤ b.val; omega))
      rw [simple_chain hn a ha] at hm
      convert hm using 1 <;> dsimp [a'] <;> module
  exact aux _ a b rfl hab

/-- Every sum of two different coordinate vectors lies in the positive cone. -/
theorem add_mem_positiveCone (hn : 2 ≤ n) (a b : Fin n) (hab : a ≠ b) :
    Pi.single a 1 + Pi.single b 1 ∈ positiveCone hn := by
  wlog horder : a < b generalizing a b
  · have hba : b < a := lt_of_le_of_ne (le_of_not_gt horder) (Ne.symm hab)
    simpa [add_comm] using this b a (Ne.symm hab) hba
  let p : Fin n := ⟨n - 2, by omega⟩
  let q : Fin n := ⟨n - 1, by omega⟩
  have hp : a ≤ p := by change a.val ≤ n - 2; omega
  have hq : b ≤ q := by change b.val ≤ n - 1; omega
  have hm := (positiveCone hn).add_mem
    ((positiveCone hn).add_mem (sub_mem_positiveCone hn a p hp)
      (sub_mem_positiveCone hn b q hq)) (simple_mem_positiveCone hn q)
  rw [show q = ⟨n - 1, by omega⟩ from rfl, simple_last] at hm
  convert hm using 1 <;> dsimp [p, q] <;> module

/-- A signed pair of distinct coordinate vectors is positive or negative. -/
theorem signed_pair_mem_or_neg_mem (hn : 2 ≤ n) (a b : Fin n) (hab : a ≠ b)
    (s t : ℤ) (hs : s = 1 ∨ s = -1) (ht : t = 1 ∨ t = -1) :
    s • Pi.single a 1 + t • Pi.single b 1 ∈ positiveCone hn ∨
      -(s • Pi.single a 1 + t • Pi.single b 1) ∈ positiveCone hn := by
  rcases hs with rfl | rfl <;> rcases ht with rfl | rfl
  · left
    simpa using add_mem_positiveCone hn a b hab
  · by_cases h : a ≤ b
    · left
      simpa [sub_eq_add_neg] using sub_mem_positiveCone hn a b h
    · right
      simpa [sub_eq_add_neg, add_comm] using sub_mem_positiveCone hn b a (le_of_not_ge h)
  · by_cases h : b ≤ a
    · left
      simpa [sub_eq_add_neg, add_comm] using sub_mem_positiveCone hn b a h
    · right
      simpa [sub_eq_add_neg, add_comm] using sub_mem_positiveCone hn a b (le_of_not_ge h)
  · right
    simpa [add_comm] using add_mem_positiveCone hn a b hab

/-- Summing all coordinates kills the chain vectors and takes value two at the final vertex. -/
theorem coordinateSum_simple (hn : 2 ≤ n) (i : Fin n) :
    TypeDParityLattice.coordinateSum (Fin n) (simple hn i) =
      if i.val + 1 < n then 0 else 2 := by
  unfold simple
  split_ifs <;> simp [TypeDParityLattice.coordinateSum, Finset.sum_add_distrib,
    Finset.sum_sub_distrib, Pi.single_apply]

/-- Sum of the coordinates up through a supplied position. -/
def prefixSum (a : Fin n) : (Fin n → ℤ) →+ ℤ where
  toFun v := ∑ j ∈ Finset.univ.filter (fun j : Fin n => j ≤ a), v j
  map_zero' := by simp
  map_add' v w := by simp [Finset.sum_add_distrib]

@[simp] theorem prefixSum_single (a b : Fin n) (z : ℤ) :
    prefixSum a (Pi.single b z) = if b ≤ a then z else 0 := by
  simp [prefixSum, Pi.single_apply]

theorem prefixSum_simple (hn : 2 ≤ n) (a i : Fin n) (ha : a.val + 1 < n) :
    prefixSum a (simple hn i) =
      (if i = a then 1 else 0) +
        (if i.val + 1 = n ∧ a.val + 2 = n then 1 else 0) := by
  by_cases hi : i.val + 1 < n
  · rw [simple_chain hn i hi, map_sub, prefixSum_single, prefixSum_single]
    simp only [Fin.le_def, Fin.ext_iff]
    split_ifs <;> omega
  · rw [show simple hn i = Pi.single ⟨n - 2, by omega⟩ 1 +
        Pi.single ⟨n - 1, by omega⟩ 1 by simp [simple, hi],
      map_add, prefixSum_single, prefixSum_single]
    simp only [Fin.le_def, Fin.ext_iff]
    split_ifs <;> omega

end Langlands.TypeDNumberedVectors
