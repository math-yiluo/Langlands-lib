import Langlands.LinearAlgebra.MatrixConormalTranspose
import Mathlib.LinearAlgebra.JordanChevalley
import Mathlib.LinearAlgebra.Matrix.Charpoly.Minpoly
import Mathlib.LinearAlgebra.Trace

/-! # Trace-nondegenerate directions from the matrix semisimple part -/

noncomputable section

open Matrix Polynomial

set_option autoImplicit false

namespace Langlands

variable {k : Type*} [Field k] {n : ℕ}

local notation "Mat" => Matrix (Fin n) (Fin n) k

private theorem exists_mul_aeval_idempotent (A : Mat) (hA : A ≠ 0)
    (hs : Squarefree (minpoly k A)) :
    ∃ p : k[X], IsIdempotentElem (A * aeval A p) ∧ A * aeval A p ≠ 0 := by
  by_cases h : (X : k[X]) ∣ minpoly k A
  · obtain ⟨r, hr⟩ := h
    have hXr : ¬ (X : k[X]) ∣ r := by
      rintro ⟨s, hs'⟩
      have hd : (X : k[X]) * X ∣ minpoly k A :=
        ⟨s, by rw [hr, hs', mul_assoc]⟩
      exact Polynomial.irreducible_X.not_isUnit (hs X hd)
    obtain ⟨u, v, huv⟩ := Polynomial.irreducible_X.coprime_iff_not_dvd.mpr hXr
    rw [mul_comm u X] at huv
    have hrA : A * aeval A r = 0 := by
      have hh := minpoly.aeval k A
      rw [hr, map_mul, aeval_X] at hh
      exact hh
    have hsum := congrArg (aeval A) huv
    simp only [map_add, map_mul, aeval_X, map_one] at hsum
    have hAv : Commute A (aeval A v) := by
      have hh := (Commute.all X v).map (aeval A)
      rwa [aeval_X] at hh
    have hz : A * (aeval A v * aeval A r) = 0 := by
      rw [← mul_assoc, hAv.eq, mul_assoc, hrA, mul_zero]
    have hAe : A * (A * aeval A u) = A := by
      calc
        A * (A * aeval A u) = A * (A * aeval A u + aeval A v * aeval A r) := by
          rw [mul_add, hz, add_zero]
        _ = A := by rw [hsum, mul_one]
    have hue : Commute (aeval A u) (A * aeval A u) := by
      have hh := (Commute.all u (X * u)).map (aeval A)
      rwa [map_mul, aeval_X] at hh
    refine ⟨u, ?_, ?_⟩
    · change (A * aeval A u) * (A * aeval A u) = A * aeval A u
      rw [mul_assoc, hue.eq, ← mul_assoc, hAe]
    · intro he
      rw [he, mul_zero] at hAe
      exact hA hAe.symm
  · obtain ⟨u, v, huv⟩ := Polynomial.irreducible_X.coprime_iff_not_dvd.mpr h
    rw [mul_comm u X] at huv
    have he : A * aeval A u = 1 := by
      have hsum := congrArg (aeval A) huv
      simpa only [map_add, map_mul, aeval_X, minpoly.aeval, mul_zero, add_zero, map_one]
        using hsum
    refine ⟨u, he ▸ IsIdempotentElem.one, ?_⟩
    rw [he]
    intro hz
    exact hA (by calc A = A * 1 := (mul_one _).symm
                     _ = 0 := by rw [hz, mul_zero])

/-- The matrix trace form restricts nondegenerately to the polynomial algebra
generated by a semisimple matrix in characteristic zero. -/
theorem matrixTraceBilin_restrict_adjoin_nondegenerate [CharZero k] {S : Mat}
    (hS : Module.End.IsSemisimple (Matrix.toLinAlgEquiv' S)) :
    (matrixTraceBilin.restrict (Algebra.adjoin k {S}).toSubmodule).Nondegenerate := by
  let Z := (Algebra.adjoin k {S}).toSubmodule
  let L : Mat ≃ₐ[k] Module.End k (Fin n → k) := Matrix.toLinAlgEquiv'
  have hleft (A : Z) (h : ∀ B : Z, matrixTraceBilin A.val B.val = 0) : A = 0 := by
    apply Subtype.ext
    change A.val = 0
    by_contra hA
    have hm : A.val ∈ Algebra.adjoin k {S} := A.property
    have hAm := hm
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hAm
    obtain ⟨r, hr⟩ := hAm
    change aeval S r = A.val at hr
    have hAs : (L A.val).IsSemisimple := by
      rw [← hr, ← aeval_algHom_apply]
      exact hS.aeval r
    have hs := hAs.minpoly_squarefree
    change Squarefree (minpoly k (Matrix.toLin' A.val)) at hs
    rw [Matrix.minpoly_toLin'] at hs
    obtain ⟨p, hidem, hne⟩ := exists_mul_aeval_idempotent A.val hA hs
    let B : Z := ⟨aeval A.val p,
      Algebra.adjoin_singleton_le hm (Polynomial.aeval_mem_adjoin_singleton k A.val)⟩
    have htr : trace (A.val * aeval A.val p) = 0 := h B
    have hL : LinearMap.trace k (Fin n → k) (L (A.val * aeval A.val p)) = 0 := by
      change LinearMap.trace k (Fin n → k) (Matrix.toLin' (A.val * aeval A.val p)) = 0
      rwa [Matrix.trace_toLin'_eq]
    apply hne
    apply L.injective
    rw [map_zero]
    exact (LinearMap.IsIdempotentElem.trace_eq_zero_iff (hidem.map L)).mp hL
  constructor
  · exact hleft
  · intro A hA
    apply hleft A
    intro B
    exact (matrixTraceBilin_isSymm.eq A.val B.val).trans (hA B)

private theorem exists_matrixSemisimplePart [PerfectField k] (C : Mat) :
    ∃ S ∈ Algebra.adjoin k {C},
      Module.End.IsSemisimple (Matrix.toLinAlgEquiv' S) ∧ IsNilpotent (C - S) := by
  let L : Mat ≃ₐ[k] Module.End k (Fin n → k) := Matrix.toLinAlgEquiv'
  obtain ⟨N, _, S, hS, hN, hsemisimple, he⟩ := (L C).exists_isNilpotent_isSemisimple
  have hpart : L (C - L.symm S) = N := by
    rw [map_sub, L.apply_symm_apply, he, add_sub_cancel_right]
  refine ⟨L.symm S, ?_, ?_, ?_⟩
  · rw [Algebra.adjoin_singleton_eq_range_aeval] at hS
    obtain ⟨p, hp⟩ := hS
    change aeval (L C) p = S at hp
    have hpoly : aeval C p = L.symm S := by
      apply L.injective
      rw [← aeval_algHom_apply, L.apply_symm_apply, hp]
    rw [← hpoly]
    exact Polynomial.aeval_mem_adjoin_singleton k C
  · change (L (L.symm S)).IsSemisimple
    rwa [L.apply_symm_apply]
  · obtain ⟨r, hr⟩ := hN
    refine ⟨r, L.injective ?_⟩
    rw [map_pow, map_zero, hpart, hr]

/-- The polynomial semisimple part from the Jordan–Chevalley decomposition. -/
def matrixSemisimplePart [PerfectField k] (C : Mat) : Mat :=
  (exists_matrixSemisimplePart C).choose

theorem matrixSemisimplePart_mem_adjoin [PerfectField k] (C : Mat) :
    matrixSemisimplePart C ∈ Algebra.adjoin k {C} :=
  (exists_matrixSemisimplePart C).choose_spec.1

theorem matrixSemisimplePart_isSemisimple [PerfectField k] (C : Mat) :
    Module.End.IsSemisimple (Matrix.toLinAlgEquiv' (matrixSemisimplePart C)) :=
  (exists_matrixSemisimplePart C).choose_spec.2.1

theorem isNilpotent_sub_matrixSemisimplePart [PerfectField k] (C : Mat) :
    IsNilpotent (C - matrixSemisimplePart C) :=
  (exists_matrixSemisimplePart C).choose_spec.2.2

/-- A commuting semisimple part with nilpotent difference agrees with the
polynomial Jordan–Chevalley choice. -/
theorem matrixSemisimplePart_eq_of_commute [PerfectField k] {C S : Mat}
    (hC : Commute C S) (hS : Module.End.IsSemisimple (Matrix.toLinAlgEquiv' S))
    (hN : IsNilpotent (C - S)) : matrixSemisimplePart C = S := by
  let L : Mat ≃ₐ[k] Module.End k (Fin n → k) := Matrix.toLinAlgEquiv'
  let S₀ := matrixSemisimplePart C
  have hC₀ : Commute C S₀ := Algebra.commute_of_mem_adjoin_self (matrixSemisimplePart_mem_adjoin C)
  have he : L (C - S₀) + L S₀ = L (C - S) + L S := by
    rw [← map_add, ← map_add, sub_add_cancel, sub_add_cancel]
  apply L.injective
  exact (Module.End.isNilpotent_isSemisimple_unique
    ((isNilpotent_sub_matrixSemisimplePart C).map L) (matrixSemisimplePart_isSemisimple C)
    (hN.map L) hS ((hC₀.sub_left (Commute.refl S₀)).map L)
    ((hC.sub_left (Commute.refl S)).map L) he).2

/-- For the directions from the semisimple part, the matrix conormal satisfies
adjusted-transpose orbit closure without any further trace hypothesis. -/
theorem mem_closure_conormalConjugacy_of_semisimplePart
    {C A : Matrix (Fin n) (Fin n) ℝ} {q : (Matrix (Fin n) (Fin n) ℝ)ˣ}
    (hq : q.val * C * q.inv = Cᵀ)
    (hA : A ∈ matrixConormalWith C (Algebra.adjoin ℝ {matrixSemisimplePart C}).toSubmodule) :
    (A, q.inv * Aᵀ * q.val) ∈ closure {p : Matrix (Fin n) (Fin n) ℝ × Matrix (Fin n) (Fin n) ℝ |
      p.1 ∈ matrixConormalWith C (Algebra.adjoin ℝ {matrixSemisimplePart C}).toSubmodule ∧
      ∃ b : (Matrix (Fin n) (Fin n) ℝ)ˣ,
        Commute (b : Matrix (Fin n) (Fin n) ℝ) C ∧ b.val * p.1 * b.inv = p.2} :=
  mem_closure_conormalConjugacy_of_polynomialDirections hq _
    (matrixTraceBilin_restrict_adjoin_nondegenerate (matrixSemisimplePart_isSemisimple C))
    (Algebra.adjoin_singleton_le (matrixSemisimplePart_mem_adjoin C)) hA

end Langlands
