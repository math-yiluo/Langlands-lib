import Langlands.LinearAlgebra.RootDatumSimpleCorootEquiv
import Mathlib.Logic.Relation

/-! # Cartan components and coroot support in simply connected root data -/

noncomputable section

universe u v w

open Module

namespace Langlands.LinearAlgebra.SimplyConnectedCartanComponents

variable {J : Type u} {X : Type v} {Y : Type w}
  [AddCommGroup X] [AddCommGroup Y] {P : RootDatum J X Y}

/-- Connectivity of simple indices generated by nonzero Cartan entries. -/
def cartanSetoid (b : P.Base) : Setoid b.support where
  r := Relation.EqvGen (fun i j : b.support => P.pairing i j ≠ 0)
  iseqv := ⟨Relation.EqvGen.refl,
    fun h => Relation.EqvGen.symm _ _ h,
    fun h h' => Relation.EqvGen.trans _ _ _ h h'⟩

/-- The finite type of components of the based Cartan diagram. -/
abbrev Component (b : P.Base) := Quotient (cartanSetoid b)

/-- The component of a specified simple index. -/
def component (b : P.Base) (i : b.support) : Component b := Quotient.mk _ i

instance finite_component (b : P.Base) : Finite (Component b) := inferInstance

/-- Distinct components have zero Cartan pairing. -/
theorem pairing_eq_zero_of_component_ne (b : P.Base) (i j : b.support)
    (h : component b i ≠ component b j) : P.pairing i j = 0 := by
  by_contra hn
  exact h (Quotient.sound (Relation.EqvGen.rel i j hn))

variable (b : P.Base) (hspan : P.corootSpan ℤ = ⊤)

/-- A coweight is supported on a component if its simple-coroot coordinates
vanish outside that component. -/
def CorootSupported (c : Component b) (y : Y) : Prop :=
  ∀ i : b.support, component b i ≠ c →
    (Langlands.RootDatumSimpleCorootEquiv.simpleCorootBasis b hspan).repr y i = 0

/-- A simple coroot is supported on its own Cartan component. -/
theorem corootSupported_simple (i : b.support) :
    CorootSupported b hspan (component b i) (P.coroot i) := by
  intro j hj
  have hji : j ≠ i := fun h => hj (congrArg (component b) h)
  rw [← Langlands.RootDatumSimpleCorootEquiv.simpleCorootBasis_apply b hspan i,
    Basis.repr_self]
  simp [hji]

namespace CorootSupported

variable {b hspan} {c : Component b} {y z : Y}

/-- A component support is closed under negation. -/
theorem neg (hy : CorootSupported b hspan c y) :
    CorootSupported b hspan c (-y) := by
  intro i hi
  simp only [map_neg, Finsupp.neg_apply, hy i hi, neg_zero]

/-- A component support is closed under subtraction. -/
theorem sub (hy : CorootSupported b hspan c y) (hz : CorootSupported b hspan c z) :
    CorootSupported b hspan c (y - z) := by
  intro i hi
  simp only [map_sub, Finsupp.sub_apply, hy i hi, hz i hi, sub_self]

/-- A component support is closed under integral multiplication. -/
theorem smul (hy : CorootSupported b hspan c y) (n : ℤ) :
    CorootSupported b hspan c (n • y) := by
  intro i hi
  simp only [map_smul, Finsupp.smul_apply, hy i hi, smul_zero]

/-- A simple root in another component annihilates a supported coweight. -/
theorem pairing_eq_zero (hy : CorootSupported b hspan c y)
    (i : b.support) (hi : component b i ≠ c) :
    P.toLinearMap (P.root i) y = 0 := by
  classical
  let e := Langlands.RootDatumSimpleCorootEquiv.simpleCorootBasis b hspan
  have he : y = ∑ j : b.support, e.repr y j • e j := (e.sum_repr y).symm
  rw [he, map_sum]
  apply Finset.sum_eq_zero
  intro j _
  by_cases hj : component b j = c
  · have hij : component b i ≠ component b j := fun h => hi (h.trans hj)
    rw [map_smul]
    rw [show e j = P.coroot j from
      Langlands.RootDatumSimpleCorootEquiv.simpleCorootBasis_apply b hspan j]
    rw [P.root_coroot_eq_pairing, pairing_eq_zero_of_component_ne b i j hij, smul_zero]
  · rw [hy j hj, zero_smul, map_zero]

/-- A nonzero coweight cannot be supported on two different components. -/
theorem component_eq {d : Component b} (hy : CorootSupported b hspan c y)
    (hz : CorootSupported b hspan d y) (hne : y ≠ 0) : c = d := by
  classical
  by_contra hcd
  apply hne
  let e := Langlands.RootDatumSimpleCorootEquiv.simpleCorootBasis b hspan
  apply e.repr.injective
  change e.repr y = e.repr 0
  rw [map_zero]
  ext i
  by_cases hi : component b i = c
  · exact hz i (by rwa [hi])
  · exact hy i hi

end CorootSupported

/-- Every coroot of a finite reduced simply connected root datum is supported
on one Cartan component. Simple reflections preserve this property. -/
theorem exists_corootSupported [Finite J] [P.IsReduced] (r : J) :
    ∃ c : Component b, CorootSupported b hspan c (P.coroot r) := by
  classical
  refine b.induction_reflect r
    (p := fun i => ∃ c : Component b, CorootSupported b hspan c (P.coroot i)) ?_ ?_ ?_
  · rintro i ⟨c, hc⟩
    refine ⟨c, ?_⟩
    rw [P.coroot_reflectionPerm, P.coreflection_apply_self]
    exact hc.neg
  · intro i hi
    exact ⟨component b ⟨i, hi⟩, corootSupported_simple b hspan ⟨i, hi⟩⟩
  · rintro i j ⟨c, hc⟩ hj
    by_cases hjc : component b ⟨j, hj⟩ = c
    · refine ⟨c, ?_⟩
      rw [P.coroot_reflectionPerm, P.coreflection_apply_coroot]
      exact hc.sub ((hjc ▸ corootSupported_simple b hspan ⟨j, hj⟩).smul _)
    · have hp : P.pairing j i = 0 := by
        rw [← P.root_coroot_eq_pairing]
        exact hc.pairing_eq_zero ⟨j, hj⟩ hjc
      refine ⟨c, ?_⟩
      rw [P.coroot_reflectionPerm, P.coreflection_apply_coroot, hp, zero_smul, sub_zero]
      exact hc

/-- Every coroot has a unique Cartan component in its simple-coroot support. -/
theorem existsUnique_corootSupported [Finite J] [P.IsReduced] (r : J) :
    ∃! c : Component b, CorootSupported b hspan c (P.coroot r) := by
  obtain ⟨c, hc⟩ := exists_corootSupported b hspan r
  exact ⟨c, hc, fun d hd => hd.component_eq hc (P.ne_zero' r)⟩

/-- The component of an arbitrary root, determined by its coroot coordinates. -/
def rootComponent [Finite J] [P.IsReduced] (r : J) : Component b :=
  Classical.choose (existsUnique_corootSupported b hspan r)

/-- The specified root component supports the whole coroot. -/
theorem corootSupported_rootComponent [Finite J] [P.IsReduced] (r : J) :
    CorootSupported b hspan (rootComponent b hspan r) (P.coroot r) :=
  (Classical.choose_spec (existsUnique_corootSupported b hspan r)).1

/-- On simple roots, the root component agrees with the quotient map on the
Cartan diagram. -/
theorem rootComponent_simple [Finite J] [P.IsReduced] (i : b.support) :
    rootComponent b hspan i = component b i :=
  (corootSupported_rootComponent b hspan i).component_eq
    (corootSupported_simple b hspan i) (P.ne_zero' i)

end Langlands.LinearAlgebra.SimplyConnectedCartanComponents
