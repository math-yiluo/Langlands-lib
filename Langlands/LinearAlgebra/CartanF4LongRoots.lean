import Langlands.LinearAlgebra.RootReflectionCoefficients
import Mathlib.LinearAlgebra.RootSystem.CartanMatrix
import Mathlib.LinearAlgebra.RootSystem.Finite.CanonicalBilinear
import Mathlib.LinearAlgebra.RootSystem.Irreducible

/-! # Long roots and the coroot lattice of a root datum of type F₄ -/

noncomputable section

open Function Set Submodule

namespace Langlands.CartanF4LongRoots

open RootReflectionCoefficients

variable {J X Y : Type*} [AddCommGroup X] [AddCommGroup Y] (P : RootDatum J X Y)

/-- In type F₄ the long roots are the roots giving the `-2` side of a Cartan pair
with entries `-2` and `-1`. This condition uses only the full root pairing. -/
def IsLong (r : J) : Prop := ∃ s : J, P.pairing r s = -2 ∧ P.pairing s r = -1

/-- The integral lattice generated by the long roots. -/
def longRootLattice : Submodule ℤ X := span ℤ (P.root '' {r | IsLong P r})

/-- Root datum equivalences preserve the long-root test. -/
theorem isLong_equiv {K X' Y' : Type*} [AddCommGroup X'] [AddCommGroup Y']
    {Q : RootDatum K X' Y'} (e : RootPairing.Equiv P Q) (r : J) :
    IsLong Q (e.indexEquiv r) ↔ IsLong P r := by
  have he (x y : J) : Q.pairing (e.indexEquiv x) (e.indexEquiv y) = P.pairing x y :=
    e.toHom.pairing
  constructor
  · rintro ⟨s, hs, hs'⟩
    obtain ⟨t, rfl⟩ := e.indexEquiv.surjective s
    exact ⟨t, (he r t).symm.trans hs, (he t r).symm.trans hs'⟩
  · rintro ⟨s, hs, hs'⟩
    exact ⟨e.indexEquiv s, (he r s).trans hs, (he s r).trans hs'⟩

@[simp] private theorem isLong_reflection (r s : J) :
    IsLong P (P.reflectionPerm r s) ↔ IsLong P s :=
  isLong_equiv P (RootPairing.Equiv.reflection P r) s

private abbrev Coefficients := Fin 4 → ℤ

private def evenTail : Submodule ℤ Coefficients where
  carrier := {c | 2 ∣ c 2 ∧ 2 ∣ c 3}
  zero_mem' := ⟨dvd_zero _, dvd_zero _⟩
  add_mem' h₁ h₂ := ⟨dvd_add h₁.1 h₂.1, dvd_add h₁.2 h₂.2⟩
  smul_mem' n _ h := ⟨dvd_mul_of_dvd_right h.1 n, dvd_mul_of_dvd_right h.2 n⟩

private theorem reflect_mem_evenTail (r : Fin 4) {c : Coefficients} (hc : c ∈ evenTail) :
    reflect CartanMatrix.F₄ r c ∈ evenTail := by
  change (2 ∣ c 2) ∧ (2 ∣ c 3) at hc
  change (2 ∣ reflect CartanMatrix.F₄ r c 2) ∧ (2 ∣ reflect CartanMatrix.F₄ r c 3)
  fin_cases r <;>
    simp [reflect, CartanMatrix.F₄, Fin.sum_univ_four] <;> omega

section SimpleCoordinates

variable (b : P.Base) (e : Fin 4 ≃ b.support)

private abbrev simple (r : Fin 4) : J := e r

private abbrev rootCombination : Coefficients →ₗ[ℤ] X :=
  Fintype.linearCombination ℤ fun r => P.root (simple P b e r)

private theorem rootCombination_injective : Function.Injective (rootCombination P b e) :=
  (b.linearIndepOn_root.comp e e.injective).fintypeLinearCombination_injective

private theorem rootCombination_single (r : Fin 4) :
    rootCombination P b e (Pi.single r 1) = P.root (simple P b e r) := by
  simp [rootCombination]

variable (h : ∀ r s, P.pairing (simple P b e r) (simple P b e s) = CartanMatrix.F₄ r s)

include h in
private theorem rootCombination_reflect (r : Fin 4) (c : Coefficients) :
    rootCombination P b e (reflect CartanMatrix.F₄ r c) =
      P.reflection (simple P b e r) (rootCombination P b e c) := by
  classical
  rw [RootPairing.reflection_apply]
  have hp : P.coroot' (simple P b e r) (rootCombination P b e c) =
      ∑ k, c k * CartanMatrix.F₄ k r := by
    simp [Fintype.linearCombination_apply, h]
  rw [hp]
  simp [Fintype.linearCombination_apply, reflect, sub_smul, Finset.sum_sub_distrib, ite_smul]

include h in
private theorem mem_evenTail_reflection (r : Fin 4) (s : J) :
    P.root (P.reflectionPerm (simple P b e r) s) ∈ evenTail.map (rootCombination P b e) ↔
      P.root s ∈ evenTail.map (rootCombination P b e) := by
  have move (t : J) (ht : P.root t ∈ evenTail.map (rootCombination P b e)) :
      P.root (P.reflectionPerm (simple P b e r) t) ∈ evenTail.map (rootCombination P b e) := by
    obtain ⟨c, hc, hct⟩ := ht
    refine ⟨_, reflect_mem_evenTail r hc, ?_⟩
    rw [rootCombination_reflect P b e h, hct, P.root_reflectionPerm]
  exact ⟨fun ht => by simpa using move _ ht, move s⟩

private theorem mem_evenTail_simple (r : Fin 4) :
    P.root (simple P b e r) ∈ evenTail.map (rootCombination P b e) ↔ r = 0 ∨ r = 1 := by
  have hm (c : Coefficients) :
      rootCombination P b e c ∈ evenTail.map (rootCombination P b e) ↔ c ∈ evenTail := by
    constructor
    · rintro ⟨c', hc', heq⟩
      exact (rootCombination_injective P b e heq) ▸ hc'
    · exact fun hc => ⟨c, hc, rfl⟩
  rw [← rootCombination_single P b e r, hm]
  change (2 ∣ (Pi.single r (1 : ℤ) : Coefficients) 2) ∧
    (2 ∣ (Pi.single r (1 : ℤ) : Coefficients) 3) ↔ r = 0 ∨ r = 1
  fin_cases r <;> decide

variable [Finite J] [P.IsReduced]

include h in
private theorem isLong_simple (r : Fin 4) :
    IsLong P (simple P b e r) ↔ r = 0 ∨ r = 1 := by
  classical
  let := Fintype.ofFinite J
  let form := (P.posRootForm ℤ).toInvariantForm
  let length (j : J) : ℤ := form.form (P.root j) (P.root j)
  have hpos (j : J) : 0 < length j := by
    simpa only [length, form, RootPairing.RootPositiveForm.toInvariantForm_form,
      ← (P.posRootForm ℤ).algebraMap_rootLength, Algebra.algebraMap_self_apply] using
      (P.posRootForm ℤ).rootLength_pos j
  have hlen (r s : J) : P.pairing s r * length r = P.pairing r s * length s :=
    form.pairing_mul_eq_pairing_mul_swap r s
  have hrefl (j k : J) : length (P.reflectionPerm j k) = length k := by
    simp only [length, P.root_reflectionPerm, form.apply_reflection_reflection]
  have hmin (j : J) : length (simple P b e 2) ≤ length j := by
    apply b.induction_reflect j
    · intro i hi
      rwa [hrefl]
    · intro i hi
      let v := e.symm ⟨i, hi⟩
      have hv : simple P b e v = i := congrArg Subtype.val (e.apply_symm_apply ⟨i, hi⟩)
      rw [← hv]
      suffices ∀ v : Fin 4, length (simple P b e 2) ≤ length (simple P b e v) from this v
      intro v
      have h01 := hlen (simple P b e 0) (simple P b e 1)
      have h12 := hlen (simple P b e 1) (simple P b e 2)
      have h23 := hlen (simple P b e 2) (simple P b e 3)
      simp only [h] at h01 h12 h23
      norm_num [CartanMatrix.F₄, Matrix.of_apply] at h01 h12 h23
      have h2 := hpos (simple P b e 2)
      fin_cases v
      · change length (simple P b e 2) ≤ length (simple P b e 0)
        omega
      · change length (simple P b e 2) ≤ length (simple P b e 1)
        omega
      · exact le_rfl
      · change length (simple P b e 2) ≤ length (simple P b e 3)
        omega
    · intro i t hi _
      rwa [hrefl]
  have h23 := hlen (simple P b e 2) (simple P b e 3)
  simp only [h] at h23
  norm_num [CartanMatrix.F₄, Matrix.of_apply] at h23
  have hn (j : J) (hj : length j = length (simple P b e 2)) : ¬ IsLong P j := by
    rintro ⟨s, hs, hs'⟩
    have he := hlen j s
    rw [hs, hs', hj] at he
    have hp := hpos s
    have hm := hmin s
    omega
  have h1 : IsLong P (simple P b e 1) := by
    refine ⟨simple P b e 2, ?_, ?_⟩ <;> rw [h] <;> decide
  have h0 : IsLong P (simple P b e 0) := by
    have he : P.reflectionPerm (simple P b e 1) (simple P b e 0) =
        P.reflectionPerm (simple P b e 0) (simple P b e 1) := by
      apply P.root.injective
      simp only [P.root_reflectionPerm, P.reflection_apply_root, h]
      norm_num [CartanMatrix.F₄, Matrix.of_apply, sub_neg_eq_add, add_comm]
    rw [← isLong_reflection P (simple P b e 1), he, isLong_reflection]
    exact h1
  fin_cases r <;> simp [h0, h1, hn _ rfl, hn _ (by omega :
    length (simple P b e 3) = length (simple P b e 2))]

include h in
private theorem mem_evenTail_iff_isLong (r : J) :
    P.root r ∈ evenTail.map (rootCombination P b e) ↔ IsLong P r := by
  apply b.induction_reflect r
  · intro j hj
    rw [isLong_reflection, P.root_reflectionPerm, P.reflection_apply_self]
    simpa only [Submodule.neg_mem_iff] using hj
  · intro j hj
    let v := e.symm ⟨j, hj⟩
    have hv : simple P b e v = j := congrArg Subtype.val (e.apply_symm_apply ⟨j, hj⟩)
    rw [← hv, mem_evenTail_simple, isLong_simple P b e h]
  · intro i j hi hj
    let v := e.symm ⟨j, hj⟩
    have hv : simple P b e v = j := congrArg Subtype.val (e.apply_symm_apply ⟨j, hj⟩)
    rw [← hv, mem_evenTail_reflection P b e h, isLong_reflection]
    exact hi

include h in
/-- No short root is in the integral span of the long roots of a root datum of type F₄. -/
theorem root_mem_longRootLattice_iff (r : J) :
    P.root r ∈ longRootLattice P ↔ IsLong P r := by
  have hle : longRootLattice P ≤ evenTail.map (rootCombination P b e) := by
    apply span_le.mpr
    rintro _ ⟨j, hj, rfl⟩
    exact (mem_evenTail_iff_isLong P b e h j).mpr hj
  exact ⟨fun hr => (mem_evenTail_iff_isLong P b e h r).mp (hle hr),
    fun hr => subset_span ⟨r, hr, rfl⟩⟩

omit [Finite J] [P.IsReduced] in
/-- The four simple long roots in the order of `CartanMatrix.D 4`. -/
def simpleLongRoot : Fin 4 → J :=
  let a := simple P b e
  let s := P.reflectionPerm (a 2) (a 1)
  ![a 1, a 0, s, P.reflectionPerm (a 3) s]

omit [Finite J] [P.IsReduced] in
include h in
private theorem simpleLongRoot_formulas :
    let a := simple P b e
    let v := simpleLongRoot P b e
    (P.root (v 2) = P.root (a 1) + (2 : ℤ) • P.root (a 2)) ∧
    (P.root (v 3) = P.root (a 1) + (2 : ℤ) • P.root (a 2) + (2 : ℤ) • P.root (a 3)) ∧
    (P.coroot (v 2) = P.coroot (a 1) + P.coroot (a 2)) ∧
    (P.coroot (v 3) = P.coroot (a 1) + P.coroot (a 2) + P.coroot (a 3)) := by
  let a := simple P b e
  let s := P.reflectionPerm (a 2) (a 1)
  let t := P.reflectionPerm (a 3) s
  change (P.root s = _) ∧ (P.root t = _) ∧ (P.coroot s = _) ∧ (P.coroot t = _)
  have hr : P.root s = P.root (a 1) + (2 : ℤ) • P.root (a 2) := by
    rw [show s = P.reflectionPerm (a 2) (a 1) from rfl, P.root_reflectionPerm,
      P.reflection_apply_root, h]
    norm_num [CartanMatrix.F₄, Matrix.of_apply, neg_smul, sub_neg_eq_add]
  have hc : P.coroot s = P.coroot (a 1) + P.coroot (a 2) := by
    rw [show s = P.reflectionPerm (a 2) (a 1) from rfl, P.coroot_reflectionPerm,
      P.coreflection_apply_coroot, h]
    norm_num [CartanMatrix.F₄, Matrix.of_apply, neg_smul, sub_neg_eq_add]
  have hst : P.pairing s (a 3) = -2 := by
    rw [← P.root_coroot_eq_pairing, hr, LinearMap.map_add₂, LinearMap.map_smul₂]
    norm_num [P.root_coroot_eq_pairing, a, h, CartanMatrix.F₄, Matrix.of_apply]
  have hts : P.pairing (a 3) s = -1 := by
    rw [← P.root_coroot_eq_pairing, hc, map_add]
    norm_num [P.root_coroot_eq_pairing, a, h, CartanMatrix.F₄, Matrix.of_apply]
  refine ⟨hr, ?_, hc, ?_⟩
  · rw [show t = P.reflectionPerm (a 3) s from rfl, P.root_reflectionPerm,
      P.reflection_apply_root, hst, hr]
    change P.root (a 1) + (2 : ℤ) • P.root (a 2) - (-2 : ℤ) • P.root (a 3) = _
    simp only [neg_smul, sub_neg_eq_add, a]
  · rw [show t = P.reflectionPerm (a 3) s from rfl, P.coroot_reflectionPerm,
      P.coreflection_apply_coroot, hts, hc]
    simp [neg_smul, sub_neg_eq_add, a]

omit [Finite J] [P.IsReduced] in
include h in
/-- The indicated long roots have the ordered Cartan pairings of `D₄`. -/
theorem pairing_simpleLongRoot (r s : Fin 4) :
    P.pairing (simpleLongRoot P b e r) (simpleLongRoot P b e s) = CartanMatrix.D 4 r s := by
  let a := simple P b e
  let v := simpleLongRoot P b e
  obtain ⟨hr, hr', hc, hc'⟩ := simpleLongRoot_formulas P b e h
  change P.root (v 2) = P.root (a 1) + (2 : ℤ) • P.root (a 2) at hr
  change P.root (v 3) = P.root (a 1) + (2 : ℤ) • P.root (a 2) + (2 : ℤ) • P.root (a 3) at hr'
  change P.coroot (v 2) = P.coroot (a 1) + P.coroot (a 2) at hc
  change P.coroot (v 3) = P.coroot (a 1) + P.coroot (a 2) + P.coroot (a 3) at hc'
  have hrvec (r : Fin 4) : P.root (v r) = ![P.root (a 1), P.root (a 0),
      P.root (a 1) + (2 : ℤ) • P.root (a 2),
      P.root (a 1) + (2 : ℤ) • P.root (a 2) + (2 : ℤ) • P.root (a 3)] r := by
    fin_cases r
    · rfl
    · rfl
    · exact hr
    · exact hr'
  have hcvec (s : Fin 4) : P.coroot (v s) = ![P.coroot (a 1), P.coroot (a 0),
      P.coroot (a 1) + P.coroot (a 2), P.coroot (a 1) + P.coroot (a 2) + P.coroot (a 3)] s := by
    fin_cases s
    · rfl
    · rfl
    · exact hc
    · exact hc'
  change P.pairing (v r) (v s) = _
  rw [← P.root_coroot_eq_pairing, hrvec, hcvec]
  fin_cases r <;> fin_cases s <;>
    norm_num [LinearMap.map_add₂, LinearMap.map_smul₂, P.root_coroot_eq_pairing, a, h,
      CartanMatrix.D, CartanMatrix.F₄, Matrix.of_apply]

include h in
/-- Each of the four displayed simple roots is long. -/
theorem isLong_simpleLongRoot (r : Fin 4) : IsLong P (simpleLongRoot P b e r) := by
  have h0 := (isLong_simple P b e h 0).mpr (Or.inl rfl)
  have h1 := (isLong_simple P b e h 1).mpr (Or.inr rfl)
  fin_cases r
  · exact h1
  · exact h0
  · exact (isLong_reflection P _ _).mpr h1
  · exact (isLong_reflection P _ _).mpr ((isLong_reflection P _ _).mpr h1)

omit [Finite J] [P.IsReduced] in
include h in
/-- The four long simple coroots span the original coroot lattice integrally. -/
theorem span_simpleLongCoroot :
    span ℤ (range fun r => P.coroot (simpleLongRoot P b e r)) = P.corootSpan ℤ := by
  let a := simple P b e
  let v := simpleLongRoot P b e
  let Q := span ℤ (range fun r => P.coroot (v r))
  have hv (r : Fin 4) : P.coroot (v r) ∈ Q := subset_span (mem_range_self r)
  obtain ⟨_, _, hc, hc'⟩ := simpleLongRoot_formulas P b e h
  change P.coroot (v 2) = P.coroot (a 1) + P.coroot (a 2) at hc
  change P.coroot (v 3) = P.coroot (a 1) + P.coroot (a 2) + P.coroot (a 3) at hc'
  have h0 : P.coroot (a 0) ∈ Q := hv 1
  have h1 : P.coroot (a 1) ∈ Q := hv 0
  have h2 : P.coroot (a 2) ∈ Q := by
    have hu := Q.sub_mem (hv 2) h1
    rwa [hc, add_sub_cancel_left] at hu
  have h3 : P.coroot (a 3) ∈ Q := by
    have hu := Q.sub_mem (hv 3) (hv 2)
    rwa [hc, hc', add_sub_cancel_left] at hu
  refine le_antisymm (span_mono ?_) ?_
  · rintro _ ⟨r, rfl⟩
    exact mem_range_self (v r)
  · change span ℤ (range P.coroot) ≤ Q
    rw [← b.span_int_coroot_support]
    apply span_le.mpr
    rintro _ ⟨j, hj, rfl⟩
    let r := e.symm ⟨j, hj⟩
    have hjr : a r = j := congrArg Subtype.val (e.apply_symm_apply ⟨j, hj⟩)
    rw [← hjr]
    suffices ∀ r : Fin 4, P.coroot (a r) ∈ Q from this r
    intro r
    fin_cases r <;> assumption

include h in
/-- The four long simple roots generate the full long-root lattice. -/
theorem span_simpleLongRoot :
    span ℤ (range fun r => P.root (simpleLongRoot P b e r)) = longRootLattice P := by
  let a := simple P b e
  let v := simpleLongRoot P b e
  let Q := span ℤ (range fun r => P.root (v r))
  have hv (r : Fin 4) : P.root (v r) ∈ Q := subset_span (mem_range_self r)
  obtain ⟨hr, hr', _, _⟩ := simpleLongRoot_formulas P b e h
  change P.root (v 2) = P.root (a 1) + (2 : ℤ) • P.root (a 2) at hr
  change P.root (v 3) = P.root (a 1) + (2 : ℤ) • P.root (a 2) + (2 : ℤ) • P.root (a 3) at hr'
  have h0 : P.root (a 0) ∈ Q := hv 1
  have h1 : P.root (a 1) ∈ Q := hv 0
  have h2 : (2 : ℤ) • P.root (a 2) ∈ Q := by
    have hu := Q.sub_mem (hv 2) h1
    rwa [hr, add_sub_cancel_left] at hu
  have h3 : (2 : ℤ) • P.root (a 3) ∈ Q := by
    have hu := Q.sub_mem (hv 3) (hv 2)
    rwa [hr, hr', add_sub_cancel_left] at hu
  refine le_antisymm (span_le.mpr ?_) (span_le.mpr ?_)
  · rintro _ ⟨r, rfl⟩
    exact subset_span ⟨v r, isLong_simpleLongRoot P b e h r, rfl⟩
  · rintro _ ⟨r, hrLong, rfl⟩
    obtain ⟨c, hc, hcr⟩ := (mem_evenTail_iff_isLong P b e h r).mpr hrLong
    change (2 ∣ c 2) ∧ (2 ∣ c 3) at hc
    obtain ⟨⟨m, hm⟩, ⟨n, hn⟩⟩ := hc
    rw [← hcr, Fintype.linearCombination_apply, Fin.sum_univ_four, hm, hn, mul_comm 2 m,
      mul_comm 2 n, ← smul_smul, ← smul_smul]
    exact Q.add_mem (Q.add_mem (Q.add_mem (Q.smul_mem _ h0) (Q.smul_mem _ h1))
      (Q.smul_mem _ h2)) (Q.smul_mem _ h3)

omit [Finite J] [P.IsReduced] in
include h in
/-- The four long simple roots are linearly independent over `ℤ`. -/
theorem linearIndependent_simpleLongRoot :
    LinearIndependent ℤ (fun r => P.root (simpleLongRoot P b e r)) := by
  let v := simpleLongRoot P b e
  apply Fintype.linearIndependent_iff.mpr
  intro c hc r
  have hp (s : Fin 4) : ∑ t, c t * CartanMatrix.D 4 t s = 0 := by
    have hs := congrArg (fun x => P.toLinearMap x (P.coroot (v s))) hc
    simpa only [map_sum, LinearMap.sum_apply, map_smul, LinearMap.smul_apply,
      P.root_coroot_eq_pairing, pairing_simpleLongRoot P b e h, smul_eq_mul, map_zero,
      LinearMap.zero_apply, v] using hs
  have h0 := hp 0
  have h1 := hp 1
  have h2 := hp 2
  have h3 := hp 3
  norm_num [Fin.sum_univ_four, CartanMatrix.D, Matrix.of_apply] at h0 h1 h2 h3
  fin_cases r
  · change c 0 = 0
    omega
  · change c 1 = 0
    omega
  · change c 2 = 0
    omega
  · change c 3 = 0
    omega

end SimpleCoordinates

section D4Base

private theorem D4_diag_or_nonpos (a c : Fin 4) : a = c ∨ CartanMatrix.D 4 a c ≤ 0 := by
  fin_cases a <;> fin_cases c <;> decide

variable [Finite J]

/-- A linearly independent D₄ configuration spanning the two root lattices is a base. -/
theorem exists_base_D4_of_spanning (v : Fin 4 → J)
    (hv : LinearIndependent ℤ (fun i => P.root (v i)))
    (hcartan : ∀ i j, P.pairing (v i) (v j) = CartanMatrix.D 4 i j)
    (hr : ∀ r, P.root r ∈ span ℤ (range fun i => P.root (v i)))
    (hc : ∀ r, P.coroot r ∈ span ℤ (range fun i => P.coroot (v i))) :
    ∃ (b : P.Base) (e : Fin 4 ≃ b.support),
      ∀ i j, P.pairing (e i) (e j) = CartanMatrix.D 4 i j := by
  classical
  let s := Finset.univ.image v
  have hs : (s : Set J) = range v := by simp [s]
  have hvinj : Function.Injective v := fun i j hij => hv.injective (congrArg P.root hij)
  let e : Fin 4 ≃ s := Equiv.ofBijective (fun i => ⟨v i, by simp [s]⟩)
    ⟨fun i j hij => hvinj (congrArg Subtype.val hij), by
      intro j
      obtain ⟨i, hi⟩ : j.val ∈ range v := hs ▸ j.property
      exact ⟨i, Subtype.ext hi⟩⟩
  have he (j : s) : v (e.symm j) = j := congrArg Subtype.val (e.apply_symm_apply j)
  have hli : LinearIndepOn ℤ P.root s := by
    change LinearIndependent ℤ (fun j : s => P.root (j : J))
    simpa only [Function.comp_def, he] using hv.comp e.symm e.symm.injective
  have hoff : (s : Set J).Pairwise fun a c => P.pairingIn ℤ a c ≤ 0 := by
    intro a ha c hc' hac
    have hi : v (e.symm ⟨a, ha⟩) = a := he ⟨a, ha⟩
    have hj : v (e.symm ⟨c, hc'⟩) = c := he ⟨c, hc'⟩
    have hne : e.symm ⟨a, ha⟩ ≠ e.symm ⟨c, hc'⟩ := fun h => hac (hi.symm.trans
      ((congrArg v h).trans hj))
    rw [← hi, ← hj]
    change P.pairingIn ℤ (v _) (v _) ≤ 0
    simp only [show ∀ i j : J, P.pairingIn ℤ i j = P.pairing i j from fun i j =>
      P.algebraMap_pairingIn ℤ i j, hcartan]
    exact (D4_diag_or_nonpos _ _).resolve_left hne
  have hroot : ∀ j, P.root j ∈ span ℤ (P.root '' (s : Set J)) := by
    rw [hs, ← range_comp]
    exact hr
  have hcoroot : ∀ j, P.coroot j ∈ span ℤ (P.coroot '' (s : Set J)) := by
    rw [hs, ← range_comp]
    exact hc
  let b := RootPairing.Base.mkOfPairwiseLEZero P hli hoff hcoroot hroot
  exact ⟨b, e, hcartan⟩

end D4Base

/-- Over the rationals, a root system with a D₄ base is irreducible. -/
theorem isIrreducible_of_D4_base {K M N : Type*} [AddCommGroup M] [Module ℚ M]
    [AddCommGroup N] [Module ℚ N] (Q : RootPairing K ℚ M N) [Q.IsRootSystem]
    (b : Q.Base) (e : Fin 4 ≃ b.support)
    (h : ∀ i j, Q.pairing (e i) (e j) = (CartanMatrix.D 4 i j : ℚ)) :
    Q.IsIrreducible := by
  classical
  let a (i : Fin 4) : K := e i
  let : Nontrivial M := ⟨Q.root (a 0), 0, Q.ne_zero (a 0)⟩
  refine RootPairing.IsIrreducible.mk' Q (fun V hV hne => ?_)
  let W : Q.invtRootSubmodule := ⟨V, Q.mem_invtRootSubmodule_iff.mpr hV⟩
  obtain ⟨x, hx, hx₀⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  have hex : ∃ i : Fin 4, Q.root (a i) ∈ V := by
    by_contra! ha
    have hzero : Q.toLinearMap x = 0 := by
      apply b.toCoweightBasis.ext
      intro j
      obtain ⟨i, rfl⟩ := e.surjective j
      have hj : x ∈ LinearMap.ker (Q.coroot' (a i)) :=
        RootPairing.invtRootSubmodule.le_ker_coroot' W (ha i) hx
      rw [RootPairing.Base.toCoweightBasis_apply, LinearMap.zero_apply]
      exact LinearMap.mem_ker.mp hj
    apply hx₀
    apply Q.toPerfPair.injective
    rw [map_zero]
    exact hzero
  have hstep (i j : Fin 4) (hi : Q.root (a i) ∈ V)
      (hij : CartanMatrix.D 4 i j ≠ 0) : Q.root (a j) ∈ V := by
    by_contra hj
    have hpair := RootPairing.invtRootSubmodule.le_ker_coroot' W hj hi
    rw [LinearMap.mem_ker, Q.root_coroot'_eq_pairing, show Q.pairing (a i) (a j) = _ from h i j]
      at hpair
    exact hij (by exact_mod_cast hpair)
  obtain ⟨i, hi⟩ := hex
  have hin : ∀ i : Fin 4, CartanMatrix.D 4 i 1 ≠ 0 := by decide
  have hout : ∀ j : Fin 4, CartanMatrix.D 4 1 j ≠ 0 := by decide
  have hmid : Q.root (a 1) ∈ V := hstep i 1 hi (hin i)
  have hall (j : Fin 4) : Q.root (a j) ∈ V := hstep 1 j hmid (hout j)
  apply top_unique
  rw [← b.toWeightBasis.span_eq]
  refine span_le.mpr ?_
  rintro _ ⟨j, rfl⟩
  obtain ⟨r, rfl⟩ := e.surjective j
  rw [RootPairing.Base.toWeightBasis_apply]
  exact hall r

end Langlands.CartanF4LongRoots
