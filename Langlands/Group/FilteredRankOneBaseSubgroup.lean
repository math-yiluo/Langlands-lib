import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Tactic.Group

/-! # Subgroup criterion for a three-factor rank-one base cell -/

open scoped Pointwise

namespace Langlands.Group.FilteredRankOne

variable {G : Type*} [Group G]

/-- The subgroup generated by the three factors of a rank-one base cell. -/
def baseSubgroup (U V Z : Subgroup G) : Subgroup G := U ⊔ V ⊔ Z

/-- If `Z` normalizes `U,V` and `U V` exchanges into `V Z U`, the latter is
exactly the subgroup generated by the three factors. -/
theorem coe_baseSubgroup_eq_baseCell {U V Z : Subgroup G}
    (hZU : ∀ z ∈ Z, ∀ a ∈ U, z * a * z⁻¹ ∈ U)
    (hZV : ∀ z ∈ Z, ∀ b ∈ V, z * b * z⁻¹ ∈ V)
    (hUV : ∀ a ∈ U, ∀ b ∈ V,
      ∃ c ∈ V, ∃ z ∈ Z, ∃ d ∈ U, a * b = c * z * d) :
    (baseSubgroup U V Z : Set G) =
      (V : Set G) * (Z : Set G) * (U : Set G) := by
  change ((U ⊔ V ⊔ Z : Subgroup G) : Set G) = _
  let C : Set G := (V : Set G) * (Z : Set G) * (U : Set G)
  have hrightU : ∀ g ∈ C, ∀ a ∈ U, g * a ∈ C := by
    rintro _ ⟨_, ⟨b, hb, z, hz, rfl⟩, c, hc, rfl⟩ a ha
    exact ⟨b * z, ⟨b, hb, z, hz, rfl⟩, c * a, U.mul_mem hc ha,
      (mul_assoc _ _ _).symm⟩
  have hrightZ : ∀ g ∈ C, ∀ z ∈ Z, g * z ∈ C := by
    rintro _ ⟨_, ⟨b, hb, t, ht, rfl⟩, a, ha, rfl⟩ z hz
    refine ⟨b * (t * z), ⟨b, hb, t * z, Z.mul_mem ht hz, rfl⟩,
      z⁻¹ * a * z, ?_, ?_⟩
    · change z⁻¹ * a * z ∈ U
      simpa only [inv_inv] using hZU z⁻¹ (Z.inv_mem hz) a ha
    · group
  have hrightV : ∀ g ∈ C, ∀ b ∈ V, g * b ∈ C := by
    rintro _ ⟨_, ⟨b, hb, z, hz, rfl⟩, a, ha, rfl⟩ c hc
    obtain ⟨d, hd, t, ht, e, he, heq⟩ := hUV a ha c hc
    refine ⟨(b * (z * d * z⁻¹)) * (z * t),
      ⟨b * (z * d * z⁻¹), V.mul_mem hb (hZV z hz d hd), z * t,
        Z.mul_mem hz ht, rfl⟩, e, he, ?_⟩
    calc
      b * (z * d * z⁻¹) * (z * t) * e = b * z * (d * t * e) := by group
      _ = b * z * a * c := by rw [← heq]; group
  have hclosure : U ⊔ V ⊔ Z =
      Subgroup.closure (((U : Set G) ∪ (V : Set G)) ∪ (Z : Set G)) := by
    rw [Subgroup.closure_union, Subgroup.closure_union,
      Subgroup.closure_eq, Subgroup.closure_eq, Subgroup.closure_eq]
  apply Set.Subset.antisymm
  · intro g hg
    rw [SetLike.mem_coe, hclosure] at hg
    induction hg using Subgroup.closure_induction_right with
    | one =>
      exact ⟨1, ⟨1, V.one_mem, 1, Z.one_mem, one_mul 1⟩, 1, U.one_mem, one_mul 1⟩
    | mul_right g _ a ha ih =>
      rcases ha with (ha | ha) | ha
      · exact hrightU g ih a ha
      · exact hrightV g ih a ha
      · exact hrightZ g ih a ha
    | mul_inv_cancel g _ a ha ih =>
      rcases ha with (ha | ha) | ha
      · exact hrightU g ih a⁻¹ (U.inv_mem ha)
      · exact hrightV g ih a⁻¹ (V.inv_mem ha)
      · exact hrightZ g ih a⁻¹ (Z.inv_mem ha)
  · have hU : U ≤ U ⊔ V ⊔ Z := le_sup_left.trans le_sup_left
    have hV : V ≤ U ⊔ V ⊔ Z := le_sup_right.trans le_sup_left
    have hZ : Z ≤ U ⊔ V ⊔ Z := le_sup_right
    rintro _ ⟨_, ⟨b, hb, z, hz, rfl⟩, a, ha, rfl⟩
    exact mul_mem (mul_mem (hV hb) (hZ hz)) (hU ha)

end Langlands.Group.FilteredRankOne
