import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Tits systems on actual subgroups

A Tits system (BN pair) of a group `G` in the sense of Tits and Bourbaki, with the Weyl group
given as a group `W` together with a surjective homomorphism `π : N →* W` whose kernel is
`B ⊓ N`. Passing `π` lets a concrete Weyl group, such as the relative Weyl group `N(k) / Z(k)`
of a reductive group, be used literally. Only the predicate, Bruhat cells, standard parabolic
subsets and elementary consequences of the definitions are provided here; no theorem about
Tits systems is assumed.
-/

namespace Langlands.Group

universe u v

namespace TitsSystem

variable {G : Type u} [Group G] {N : Subgroup G} {W : Type v} [Group W]

variable (B : Subgroup G) (π : N →* W)

/-- The Bruhat cell `B w B` of `w ∈ W`: the products `b * n * b'` with `b, b' ∈ B` and `n ∈ N`
mapping to `w`. -/
def cell (w : W) : Set G :=
  {g | ∃ n : N, π n = w ∧ ∃ b ∈ B, ∃ b' ∈ B, g = b * n * b'}

/-- The standard parabolic subset `B W_X B` attached to a subset `X` of `W`: the union of the
cells of the elements of the subgroup `W_X` generated by `X`. -/
def standardParabolic (X : Set W) : Set G :=
  {g | ∃ w ∈ Subgroup.closure X, g ∈ cell B π w}

variable {B π}

theorem mem_cell {w : W} {g : G} :
    g ∈ cell B π w ↔ ∃ n : N, π n = w ∧ ∃ b ∈ B, ∃ b' ∈ B, g = b * n * b' :=
  Iff.rfl

theorem mem_standardParabolic {X : Set W} {g : G} :
    g ∈ standardParabolic B π X ↔ ∃ w ∈ Subgroup.closure X, g ∈ cell B π w :=
  Iff.rfl

/-- Every element of `N` lies in the cell of its image. -/
theorem coe_mem_cell (n : N) : (n : G) ∈ cell B π (π n) :=
  ⟨n, rfl, 1, B.one_mem, 1, B.one_mem, by simp⟩

/-- If `ker π ≤ B`, the cell of `π n` is the double coset `B n B` of the representative `n`. -/
theorem mem_cell_iff (hπ : π.ker ≤ B.subgroupOf N) (n : N) {g : G} :
    g ∈ cell B π (π n) ↔ ∃ b ∈ B, ∃ b' ∈ B, g = b * n * b' := by
  constructor
  · rintro ⟨m, hm, b, hb, b', hb', rfl⟩
    have hk : n⁻¹ * m ∈ π.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hm, inv_mul_cancel]
    refine ⟨b, hb, (n⁻¹ * m : N) * b', B.mul_mem (Subgroup.mem_subgroupOf.1 (hπ hk)) hb', ?_⟩
    simp [mul_assoc]
  · rintro ⟨b, hb, b', hb', rfl⟩
    exact ⟨n, rfl, b, hb, b', hb', rfl⟩

/-- If `ker π ≤ B`, the cell of the identity is `B`. -/
theorem cell_one (hπ : π.ker ≤ B.subgroupOf N) : cell B π 1 = B := by
  ext g
  rw [← map_one π, mem_cell_iff hπ]
  constructor
  · rintro ⟨b, hb, b', hb', rfl⟩
    simpa using B.mul_mem hb hb'
  · intro hg
    exact ⟨g, hg, 1, B.one_mem, by simp⟩

/-- If `ker π ≤ B`, the standard parabolic subset of the empty set is `B`. -/
theorem standardParabolic_empty (hπ : π.ker ≤ B.subgroupOf N) :
    standardParabolic B π ∅ = B := by
  ext g
  simp only [mem_standardParabolic, Subgroup.closure_empty, Subgroup.mem_bot, exists_eq_left,
    cell_one hπ, SetLike.mem_coe]

end TitsSystem

open TitsSystem

/-- `(G, B, N, S)` is a **Tits system** (BN pair), in the form of Bourbaki, *Lie* IV §2.1,
with Weyl group `W` given through a homomorphism `π : N →* W`:

* `surjective`, `ker_eq`: `π` identifies `W` with `N / (B ⊓ N)`; in particular `B ⊓ N` is
  normal in `N`;
* `sup_eq`: `B` and `N` generate `G`;
* `closure_eq`, `ne_one`, `mul_self`: `S` generates `W` and consists of elements of order `2`;
* `mul_mem_cell`: for `s ∈ S` and `w ∈ W`, `s B w ⊆ B w B ∪ B s w B`;
* `conj_not_le`: for `s ∈ S`, `s B s ≠ B`.

Elements of `W` are represented by elements of `N`, and the last two axioms are required for
all representatives; `conj_not_le` says that `n B n⁻¹` is not contained in `B` for each
representative `n` of `s`. -/
structure IsTitsSystem {G : Type u} [Group G] (B N : Subgroup G) {W : Type v} [Group W]
    (π : N →* W) (S : Set W) : Prop where
  surjective : Function.Surjective π
  ker_eq : π.ker = B.subgroupOf N
  sup_eq : B ⊔ N = ⊤
  closure_eq : Subgroup.closure S = ⊤
  ne_one : ∀ s ∈ S, s ≠ 1
  mul_self : ∀ s ∈ S, s * s = 1
  mul_mem_cell : ∀ s ∈ S, ∀ n m : N, π n = s → ∀ b ∈ B,
    (n : G) * b * m ∈ cell B π (π m) ∪ cell B π (s * π m)
  conj_not_le : ∀ s ∈ S, ∀ n : N, π n = s → ∃ b ∈ B, (n : G) * b * (n : G)⁻¹ ∉ B

namespace IsTitsSystem

variable {G : Type u} [Group G] {B N : Subgroup G} {W : Type v} [Group W] {π : N →* W}
  {S : Set W}

/-- If the kernel of `π` is a subgroup `Z ≤ N` (viewed in `N`), then `B ⊓ N = Z`. -/
theorem inf_eq {Z : Subgroup G} (h : IsTitsSystem B N π S) (hπ : π.ker = Z.subgroupOf N)
    (hZ : Z ≤ N) : B ⊓ N = Z := by
  have h' : B.subgroupOf N = Z.subgroupOf N := h.ker_eq.symm.trans hπ
  rw [Subgroup.subgroupOf_inj, inf_eq_left.2 hZ] at h'
  exact h'

/-- In a Tits system the cell of the identity is `B`. -/
theorem cell_one (h : IsTitsSystem B N π S) : cell B π 1 = B :=
  TitsSystem.cell_one h.ker_eq.le

/-- In a Tits system the standard parabolic subset of `∅` is `B`. -/
theorem standardParabolic_empty (h : IsTitsSystem B N π S) :
    standardParabolic B π ∅ = B :=
  TitsSystem.standardParabolic_empty h.ker_eq.le

/-- Rank zero: with no simple reflections the Weyl group is trivial. -/
theorem eq_one_of_empty (h : IsTitsSystem B N π ∅) (w : W) : w = 1 := by
  have hw : w ∈ Subgroup.closure (∅ : Set W) := h.closure_eq ▸ Subgroup.mem_top w
  rwa [Subgroup.closure_empty, Subgroup.mem_bot] at hw

/-- Rank zero: with no simple reflections, `B` is the whole group. -/
theorem eq_top_of_empty (h : IsTitsSystem B N π ∅) : B = ⊤ := by
  have hN : N ≤ B := fun n hn => by
    have h1 : (⟨n, hn⟩ : N) ∈ π.ker := h.eq_one_of_empty _
    rw [h.ker_eq] at h1
    exact Subgroup.mem_subgroupOf.1 h1
  rw [← h.sup_eq, sup_eq_left.2 hN]

end IsTitsSystem

end Langlands.Group
