import Langlands.Group.RelativeWeylMinimalityProof

/-!
# Standard intersections at minimal double-coset representatives

At a least-length element `w` of `W_I w W_J`, the intersection
`W_J ∩ w⁻¹ W_I w` is generated by the simple reflections of `J` that it
contains. Simple exchange shows that a simple left descent of an element of
the intersection is one of these reflections.
-/

namespace Langlands.Group.RelativeWeylIndexing

universe u v
variable {B : Type u} {W : Type v} [Group W]
variable {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

noncomputable section

/-- Membership in the constructed index subset. -/
private theorem mem_intersectionSubset_iff {I J : Finset B} {w : W} {j : B} :
    j ∈ intersectionSubset cs I J w ↔
      j ∈ J ∧ w * cs.simple j * w⁻¹ ∈ standardSubgroup cs I := by
  classical
  simp [intersectionSubset]

/-- Membership in `W_J ∩ w⁻¹ W_I w`, written with conjugation by `w`. -/
private theorem mem_rightIntersection_iff {I J : Finset B} {w x : W} :
    x ∈ rightIntersection cs I J w ↔
      x ∈ standardSubgroup cs J ∧ w * x * w⁻¹ ∈ standardSubgroup cs I := by
  simp only [rightIntersection, conjugateStandardSubgroup, Subgroup.mem_inf,
    Subgroup.mem_map]
  constructor
  · rintro ⟨hx, a, ha, rfl⟩
    refine ⟨hx, ?_⟩
    simpa [MulAut.conj_apply, mul_assoc] using ha
  · rintro ⟨hx, hy⟩
    exact ⟨hx, w * x * w⁻¹, hy, by simp [mul_assoc]⟩

/-- A nontrivial element of `W_J` has a simple left descent indexed by `J`. -/
private theorem exists_left_descent_of_mem {J : Finset B} {x : W}
    (hx : x ∈ standardSubgroup cs J) (hne : x ≠ 1) :
    ∃ j ∈ J, cs.length (cs.simple j * x) < cs.length x := by
  by_contra h
  push Not at h
  have hasc : ∀ j ∈ J, cs.length x < cs.length (cs.simple j * x) := by
    intro j hj
    have h1 := h j hj
    have h2 := cs.length_simple_mul_ne x j
    omega
  have hmin := left_minimal_of_simple cs hasc x⁻¹
    ((standardSubgroup cs J).inv_mem hx)
  rw [inv_mul_cancel, cs.length_one] at hmin
  exact hne (cs.length_eq_zero_iff.mp (by omega))

/-- At a minimal representative, the conjugate of a simple left descent of an
element of the intersection lies in `W_I`. -/
private theorem conj_simple_mem_of_left_descent {I J : Finset B} {w x : W}
    (hw : IsMinimal cs I J w) (hxJ : x ∈ standardSubgroup cs J)
    (hxI : w * x * w⁻¹ ∈ standardSubgroup cs I) {j : B} (hj : j ∈ J)
    (hdesc : cs.length (cs.simple j * x) < cs.length x) :
    w * cs.simple j * w⁻¹ ∈ standardSubgroup cs I := by
  have hv := isMinimal_inv cs hw
  have hvL : ∀ a ∈ standardSubgroup cs J,
      cs.length w⁻¹ ≤ cs.length (a * w⁻¹) := by
    intro a ha
    simpa using hv a ha 1 (standardSubgroup cs I).one_mem
  have hsj : cs.simple j ∈ standardSubgroup cs J := simple_mem_standardSubgroup cs hj
  have h1 := length_mul_of_left_minimal cs hvL hxJ
  have h2 := length_mul_of_left_minimal cs hvL
    ((standardSubgroup cs J).mul_mem hsj hxJ)
  obtain ⟨α, hα, hpα⟩ := exists_standard_word cs hxI
  obtain ⟨β, hβ, hpβ⟩ := cs.exists_isReduced w⁻¹
  have hprod : cs.wordProd (β ++ α) = x * w⁻¹ := by
    rw [cs.wordProd_append, hpα, ← hpβ]
    group
  have hd : cs.length (cs.simple j * cs.wordProd (β ++ α)) <
      cs.length (cs.wordProd (β ++ α)) := by
    rw [hprod, ← mul_assoc, h1, h2]
    omega
  rcases simple_left_exchange_append cs hd with ⟨k, hk, he⟩ | ⟨k, hk, he⟩
  -- Deletion in the reduced word for `w⁻¹` contradicts minimality.
  · exfalso
    have he' : cs.simple j * w⁻¹ = cs.wordProd (β.eraseIdx k) := by
      rw [cs.wordProd_append, cs.wordProd_append, ← hpβ, ← mul_assoc] at he
      exact mul_right_cancel he
    have hbound := hv (cs.simple j) hsj 1 (standardSubgroup cs I).one_mem
    rw [mul_one, he'] at hbound
    have hl := cs.length_wordProd_le (β.eraseIdx k)
    have hlβ := List.length_eraseIdx_add_one hk
    have hr : cs.length w⁻¹ = β.length := by rw [hpβ, hβ.eq]
    omega
  -- Deletion in the word for `w x w⁻¹` places the conjugate in `W_I`.
  · have hz : cs.wordProd (α.eraseIdx k) ∈ standardSubgroup cs I :=
      wordProd_mem_standard cs (fun i hi => hα i (List.mem_of_mem_eraseIdx hi))
    rw [cs.wordProd_append, cs.wordProd_append, ← hpβ, hpα] at he
    have hconj : w * cs.simple j * w⁻¹ =
        cs.wordProd (α.eraseIdx k) * (w * x * w⁻¹)⁻¹ := by
      calc
        w * cs.simple j * w⁻¹ =
            w * (cs.simple j * (w⁻¹ * (w * x * w⁻¹))) * (w * x * w⁻¹)⁻¹ := by
          group
        _ = w * (w⁻¹ * cs.wordProd (α.eraseIdx k)) * (w * x * w⁻¹)⁻¹ := by
          rw [he]
        _ = cs.wordProd (α.eraseIdx k) * (w * x * w⁻¹)⁻¹ := by
          group
    rw [hconj]
    exact (standardSubgroup cs I).mul_mem hz ((standardSubgroup cs I).inv_mem hxI)

/-- Strong induction on length gives the nontrivial inclusion. -/
private theorem mem_standard_of_conj_mem {I J : Finset B} {w : W}
    (hw : IsMinimal cs I J w) (n : ℕ) :
    ∀ x : W, cs.length x = n → x ∈ standardSubgroup cs J →
      w * x * w⁻¹ ∈ standardSubgroup cs I →
      x ∈ standardSubgroup cs (intersectionSubset cs I J w) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro x hxn hxJ hxI
    by_cases hx1 : x = 1
    · rw [hx1]
      exact (standardSubgroup cs _).one_mem
    obtain ⟨j, hj, hdesc⟩ := exists_left_descent_of_mem cs hxJ hx1
    have hjI := conj_simple_mem_of_left_descent cs hw hxJ hxI hj hdesc
    have hjK : j ∈ intersectionSubset cs I J w :=
      (mem_intersectionSubset_iff cs).mpr ⟨hj, hjI⟩
    have hx'J : cs.simple j * x ∈ standardSubgroup cs J :=
      (standardSubgroup cs J).mul_mem (simple_mem_standardSubgroup cs hj) hxJ
    have hx'I : w * (cs.simple j * x) * w⁻¹ ∈ standardSubgroup cs I := by
      have he : w * (cs.simple j * x) * w⁻¹ =
          (w * cs.simple j * w⁻¹) * (w * x * w⁻¹) := by
        group
      rw [he]
      exact (standardSubgroup cs I).mul_mem hjI hxI
    have hx'K := ih (cs.length (cs.simple j * x)) (by omega) (cs.simple j * x) rfl
      hx'J hx'I
    have hx : x = cs.simple j * (cs.simple j * x) := by
      rw [CoxeterSystem.simple_mul_simple_cancel_left]
    rw [hx]
    exact (standardSubgroup cs _).mul_mem (simple_mem_standardSubgroup cs hjK) hx'K

/-- The published standard-intersection theorem for whole-double-coset minima,
with no finiteness premise. -/
theorem standardIntersection_proof : standardIntersection cs := by
  intro I J w hw
  apply le_antisymm
  · intro x hx
    rw [mem_rightIntersection_iff] at hx
    exact mem_standard_of_conj_mem cs hw _ x rfl hx.1 hx.2
  · rw [standardSubgroup, Subgroup.closure_le]
    rintro _ ⟨j, hj, rfl⟩
    rw [Finset.mem_coe, mem_intersectionSubset_iff] at hj
    rw [SetLike.mem_coe, mem_rightIntersection_iff]
    exact ⟨simple_mem_standardSubgroup cs hj.1, hj.2⟩

end
end Langlands.Group.RelativeWeylIndexing
