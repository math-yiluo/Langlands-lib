import Langlands.Group.RelativeWeyl
import Mathlib.GroupTheory.Coxeter.Length
import Mathlib.Data.Finset.Max

/-!
# Intrinsic finite Coxeter indexing for relative Weyl groups

All the combinatorial objects are constructed from a Coxeter system, rather
than supplied as fields. `ActualCoxeterSystem` fixes its group to the actual
normalizer/full-centralizer quotient. Identifying its simple reflections with
the rational-point relative roots is a separate structural obligation.
-/

namespace Langlands.Group.RelativeWeylIndexing

universe u v

variable {B : Type u} {W : Type v} [Group W]
variable {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

/-- The subgroup generated by the simple reflections in `I`. -/
def standardSubgroup (I : Finset B) : Subgroup W :=
  Subgroup.closure (cs.simple '' (I : Set B))

@[simp]
theorem standardSubgroup_empty :
    standardSubgroup cs ∅ = ⊥ := by
  simp [standardSubgroup]

theorem standardSubgroup_mono {I J : Finset B} (h : I ⊆ J) :
    standardSubgroup cs I ≤ standardSubgroup cs J :=
  Subgroup.closure_mono (Set.image_mono h)

theorem simple_mem_standardSubgroup {I : Finset B} {i : B} (hi : i ∈ I) :
    cs.simple i ∈ standardSubgroup cs I :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

@[simp]
theorem standardSubgroup_univ [Fintype B] :
    standardSubgroup cs Finset.univ = ⊤ := by
  simpa [standardSubgroup] using cs.subgroup_closure_range_simple

/-- The actual double coset `W_I w W_J` as a subset of the group. -/
def doubleCoset (I J : Finset B) (w : W) : Set W :=
  {x | ∃ a ∈ standardSubgroup cs I, ∃ b ∈ standardSubgroup cs J,
    x = a * w * b}

theorem mem_doubleCoset_self (I J : Finset B) (w : W) :
    w ∈ doubleCoset cs I J w :=
  ⟨1, (standardSubgroup cs I).one_mem, 1,
    (standardSubgroup cs J).one_mem, by simp⟩

theorem mul_mem_doubleCoset {I J : Finset B} {w x a b : W}
    (hx : x ∈ doubleCoset cs I J w)
    (ha : a ∈ standardSubgroup cs I) (hb : b ∈ standardSubgroup cs J) :
    a * x * b ∈ doubleCoset cs I J w := by
  rcases hx with ⟨a', ha', b', hb', rfl⟩
  exact ⟨a * a', (standardSubgroup cs I).mul_mem ha ha',
    b' * b, (standardSubgroup cs J).mul_mem hb' hb, by simp [mul_assoc]⟩

/-- Minimal length in the entire double coset, with both subgroup actions
visible. -/
def IsMinimal (I J : Finset B) (w : W) : Prop :=
  ∀ a ∈ standardSubgroup cs I, ∀ b ∈ standardSubgroup cs J,
    cs.length w ≤ cs.length (a * w * b)

theorem isMinimal_one (I J : Finset B) : IsMinimal cs I J 1 := by
  intro a ha b hb
  simp

theorem isMinimal_inv {I J : Finset B} {w : W} (h : IsMinimal cs I J w) :
    IsMinimal cs J I w⁻¹ := by
  intro a ha b hb
  have h' := h b⁻¹ ((standardSubgroup cs I).inv_mem hb)
    a⁻¹ ((standardSubgroup cs J).inv_mem ha)
  calc
    cs.length w⁻¹ = cs.length w := cs.length_inv w
    _ ≤ cs.length (b⁻¹ * w * a⁻¹) := h'
    _ = cs.length (a * w⁻¹ * b) := by
      rw [← cs.length_inv (b⁻¹ * w * a⁻¹)]
      simp [mul_assoc]

theorem exists_minimal_in_doubleCoset [Fintype W] (I J : Finset B) (w : W) :
    ∃ x ∈ doubleCoset cs I J w, IsMinimal cs I J x := by
  classical
  let s := Finset.univ.filter (fun x => x ∈ doubleCoset cs I J w)
  have hs : s.Nonempty :=
    ⟨w, Finset.mem_filter.mpr ⟨Finset.mem_univ _, mem_doubleCoset_self cs I J w⟩⟩
  obtain ⟨x, hx, hmin⟩ := s.exists_min_image cs.length hs
  have hx' : x ∈ doubleCoset cs I J w := (Finset.mem_filter.mp hx).2
  refine ⟨x, hx', ?_⟩
  intro a ha b hb
  exact hmin _ (Finset.mem_filter.mpr
    ⟨Finset.mem_univ _, mul_mem_doubleCoset cs hx' ha hb⟩)

/-- The finite set `D(I,J)` of minimal double-coset representatives. -/
noncomputable def minimalReps [Fintype W] (I J : Finset B) : Finset W := by
  classical
  exact Finset.univ.filter (IsMinimal cs I J)

@[simp]
theorem mem_minimalReps [Fintype W] (I J : Finset B) (w : W) :
    w ∈ minimalReps cs I J ↔ IsMinimal cs I J w := by
  classical
  simp [minimalReps]

theorem minimalReps_nonempty [Fintype W] (I J : Finset B) :
    (minimalReps cs I J).Nonempty :=
  ⟨1, (mem_minimalReps cs I J 1).mpr (isMinimal_one cs I J)⟩

/-- A maximal-length member of the source's `D(J,∅)`. The uniqueness of this
maximum is a separate Coxeter assertion, not an input to this construction. -/
noncomputable def longestRep [Fintype W] (J : Finset B) : W :=
  Classical.choose ((minimalReps cs J ∅).exists_max_image cs.length
    (minimalReps_nonempty cs J ∅))

theorem longestRep_mem [Fintype W] (J : Finset B) :
    longestRep cs J ∈ minimalReps cs J ∅ :=
  (Classical.choose_spec ((minimalReps cs J ∅).exists_max_image cs.length
    (minimalReps_nonempty cs J ∅))).1

theorem length_le_longestRep [Fintype W] (J : Finset B) {w : W}
    (hw : w ∈ minimalReps cs J ∅) :
    cs.length w ≤ cs.length (longestRep cs J) :=
  (Classical.choose_spec ((minimalReps cs J ∅).exists_max_image cs.length
    (minimalReps_nonempty cs J ∅))).2 w hw

/-- The conjugate `w W_I w⁻¹`, as an actual mapped subgroup. -/
def conjugateStandardSubgroup (I : Finset B) (w : W) : Subgroup W :=
  (standardSubgroup cs I).map (MulAut.conj w : W →* W)

/-- The source-side intersection `W_J ∩ w⁻¹ W_I w`. -/
def rightIntersection (I J : Finset B) (w : W) : Subgroup W :=
  standardSubgroup cs J ⊓ conjugateStandardSubgroup cs I w⁻¹

/-- The simple indices in `J` whose reflections belong to `w⁻¹ W_I w`.
The assertion that they generate the intersection is stated separately. -/
noncomputable def intersectionSubset (I J : Finset B) (w : W) : Finset B := by
  classical
  exact J.filter (fun j => w * cs.simple j * w⁻¹ ∈ standardSubgroup cs I)

theorem intersectionSubset_subset (I J : Finset B) (w : W) :
    intersectionSubset cs I J w ⊆ J := by
  classical
  exact Finset.filter_subset _ _

/-- The simple indices sent to positive roots, expressed intrinsically by the
strict right-length increase. Its relative-root interpretation is separate. -/
noncomputable def positiveSimpleSet [Fintype B] (w : W) : Finset B := by
  classical
  exact Finset.univ.filter (fun i => cs.length w < cs.length (w * cs.simple i))

/-- Simple reflection labels in the conjugate of `I`. This definition alone
does not distinguish a root from its negative. -/
noncomputable def simpleImage [Fintype B] (w : W) (I : Finset B) : Finset B := by
  classical
  exact Finset.univ.filter (fun j => ∃ i ∈ I, w * cs.simple i * w⁻¹ = cs.simple j)

/-- Every simple reflection indexed by `I` conjugates to one indexed by `J`.
The universal condition also requires that no image has been discarded. -/
def MapsIntoSimple (w : W) (I J : Finset B) : Prop :=
  ∀ i ∈ I, ∃ j ∈ J, w * cs.simple i * w⁻¹ = cs.simple j

/-- The candidate associated subset `J'`, using the source's inverse longest
representative. Its root and Levi interpretations are separate assertions. -/
noncomputable def associatedSubset [Fintype B] [Fintype W] (J : Finset B) : Finset B :=
  simpleImage cs (longestRep cs J)⁻¹ J

/-- A Coxeter system on the actual quotient `N_G(T)/Z_G(T)`, with no
replacement of that group by unrelated Weyl labels. -/
abbrev ActualCoxeterSystem {G : Type v} [Group G] (T : Subgroup G)
    (M : CoxeterMatrix B) :=
  CoxeterSystem M (RelativeWeyl.Weyl T)

include cs in
theorem eq_one_of_isEmpty [IsEmpty B] (w : W) : w = 1 := by
  apply cs.simple_induction w
  · intro i
    exact isEmptyElim i
  · rfl
  · intro a b ha hb
    simp [ha, hb]

include cs in
theorem subsingleton_of_isEmpty [IsEmpty B] : Subsingleton W :=
  ⟨fun a b => (eq_one_of_isEmpty cs a).trans (eq_one_of_isEmpty cs b).symm⟩

@[simp]
theorem longestRep_eq_one_of_isEmpty [IsEmpty B] [Fintype W] (J : Finset B) :
    longestRep cs J = 1 :=
  eq_one_of_isEmpty cs _

end Langlands.Group.RelativeWeylIndexing
