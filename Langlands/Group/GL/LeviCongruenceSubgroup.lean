import Langlands.Group.GL.PrincipalBlockFactorizationProof
import Langlands.Representation.Conductor.PrincipalCongruenceBasisProof
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-! # Principal congruence with an integral block Levi -/

noncomputable section

open Langlands.Conductor
open scoped Pointwise

namespace Langlands.GeneralLinear.BlockShape

universe u

variable (k : Type u) [Field k] [ValuativeRel k] {r : ℕ}
  (B : BlockShape (r + 1))

local notation "L" => GeneralLinear (r + 1) k
local notation "J" => principalLevelSubgroup k r
local notation "M" => B.leviSubgroup k
local notation "N" => B.unipotentSubgroup k
local notation "Nbar" => B.oppositeUnipotentSubgroup k

/-- The subgroup generated by the integral block Levi and the first
principal congruence subgroup. -/
def leviCongruenceSubgroup : Subgroup L := (J 0 ⊓ M) ⊔ J 1

theorem principalLevel_le_leviCongruenceSubgroup :
    J 1 ≤ B.leviCongruenceSubgroup k := le_sup_right

theorem leviCongruenceSubgroup_le_integral :
    B.leviCongruenceSubgroup k ≤ J 0 :=
  sup_le inf_le_left (principalLevelSubgroup_antitone k r (Nat.zero_le 1))

set_option maxHeartbeats 400000 in
theorem integral_le_normalizer_principalLevel (a : ℕ) :
    J 0 ≤ Subgroup.normalizer (J a : Set L) := by
  rw [principalLevelSubgroup_zero]
  rintro _ ⟨g, rfl⟩
  let O := (ValuativeRel.valuation k).integer
  let I := IsLocalRing.maximalIdeal O ^ a
  let q := integralPrincipalCongruence r I
  have hq : q.Normal := (Matrix.GeneralLinearGroup.map (n := Fin (r + 1))
    (Ideal.Quotient.mk I)).normal_ker
  have hg : g ∈ Subgroup.normalizer (q : Set _) := by
    let : q.Normal := hq
    exact Subgroup.le_normalizer_of_normal (show g ∈ (⊤ : Subgroup _) from trivial)
  exact Subgroup.le_normalizer_map (Matrix.GeneralLinearGroup.map O.subtype) ⟨g, hg, rfl⟩

theorem mem_leviCongruenceSubgroup_iff (g : L) :
    g ∈ B.leviCongruenceSubgroup k ↔ ∃ m ∈ J 0 ⊓ M, ∃ v ∈ J 1, g = m * v := by
  have hN : J 0 ⊓ M ≤ Subgroup.normalizer (J 1 : Set L) :=
    inf_le_left.trans (integral_le_normalizer_principalLevel k 1)
  change g ∈ ((↑((J 0 ⊓ M) ⊔ J 1) : Set L)) ↔ _
  rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ hN, Set.mem_mul]
  constructor
  · rintro ⟨m, hm, v, hv, h⟩
    exact ⟨m, hm, v, hv, h.symm⟩
  · rintro ⟨m, hm, v, hv, h⟩
    exact ⟨m, hm, v, hv, h.symm⟩

theorem leviCongruenceSubgroup_inf_levi :
    B.leviCongruenceSubgroup k ⊓ M = J 0 ⊓ M :=
  le_antisymm (inf_le_inf_right _ (B.leviCongruenceSubgroup_le_integral k))
    (le_inf le_sup_left inf_le_right)

/-- A positive principal level factors into its lower, Levi and upper intersections. -/
theorem exists_principalLevel_factor (a : ℕ) (ha : 0 < a) {g : L} (hg : g ∈ J a) :
    ∃ l ∈ J a ⊓ Nbar, ∃ m ∈ J a ⊓ M, ∃ v ∈ J a ⊓ N, g = l * m * v := by
  obtain ⟨⟨l, m, v⟩, he⟩ :=
    (principalLevelSubgroup_iwahoriProduct_bijective k r B a ha).2 ⟨g, hg⟩
  exact ⟨l, l.property, m, m.property, v, v.property, (congrArg Subtype.val he).symm⟩

private theorem exists_leviCongruence_factor_aux {g : L} (hg : g ∈ B.leviCongruenceSubgroup k) :
    ∃ l ∈ J 1 ⊓ Nbar, ∃ m ∈ J 0 ⊓ M, ∃ v ∈ J 1 ⊓ N, g = l * m * v := by
  obtain ⟨m, hm, w, hw, rfl⟩ := (B.mem_leviCongruenceSubgroup_iff k g).mp hg
  obtain ⟨l, hl, c, hc, v, hv, rfl⟩ := B.exists_principalLevel_factor k 1 Nat.one_pos hw
  let l' := m * l * m⁻¹
  have hl' : l' ∈ J 1 ⊓ Nbar := by
    refine ⟨?_, ?_⟩
    · exact (Subgroup.mem_normalizer_iff.mp (integral_le_normalizer_principalLevel k 1 hm.1)
        l).mp hl.1
    · exact (Subgroup.mem_normalizer_iff.mp (B.leviSubgroup_le_normalizer_oppositeUnipotentSubgroup
        k hm.2) l).mp hl.2
  have hJ : J 1 ≤ J 0 := principalLevelSubgroup_antitone k r (Nat.zero_le 1)
  exact ⟨l', hl', m * c, mul_mem hm ⟨hJ hc.1, hc.2⟩, v, hv, by dsimp [l']; group⟩

/-- The integral Levi enlargement still has an Iwahori factorization. -/
theorem exists_leviCongruence_factor {g : L} (hg : g ∈ B.leviCongruenceSubgroup k) :
    ∃ l ∈ B.leviCongruenceSubgroup k ⊓ Nbar, ∃ m ∈ B.leviCongruenceSubgroup k ⊓ M,
      ∃ v ∈ B.leviCongruenceSubgroup k ⊓ N, g = l * m * v := by
  obtain ⟨l, hl, m, hm, v, hv, he⟩ := B.exists_leviCongruence_factor_aux k hg
  have hJ := B.principalLevel_le_leviCongruenceSubgroup k
  have hM : J 0 ⊓ M ≤ B.leviCongruenceSubgroup k := le_sup_left
  exact ⟨l, ⟨hJ hl.1, hl.2⟩, m, ⟨hM hm, hm.2⟩, v, ⟨hJ hv.1, hv.2⟩, he⟩

/-- Adding the integral Levi leaves the upper radical intersection at level one. -/
theorem leviCongruenceSubgroup_inf_upper :
    B.leviCongruenceSubgroup k ⊓ N = J 1 ⊓ N := by
  apply le_antisymm _ (inf_le_inf_right _ le_sup_right)
  intro g hg
  obtain ⟨l, hl, m, hm, v, hv, he⟩ := B.exists_leviCongruence_factor_aux k hg.1
  have hJ : J 1 ≤ J 0 := principalLevelSubgroup_antitone k r (Nat.zero_le 1)
  let g' : B.iwahoriUpper k (J 0) := ⟨g, B.leviCongruenceSubgroup_le_integral k hg.1, hg.2⟩
  let v' : B.iwahoriUpper k (J 0) := ⟨v, hJ hv.1, hv.2⟩
  have eq : B.iwahoriProduct k (J 0) (1, 1, g') =
      B.iwahoriProduct k (J 0) (⟨l, hJ hl.1, hl.2⟩, ⟨m, hm⟩, v') := by
    apply Subtype.ext
    simpa only [iwahoriProduct_val, OneMemClass.coe_one, mul_one, one_mul] using he
  have e := congrArg (fun x => (x.2.2 : L)) (B.iwahoriProduct_injective k _ eq)
  change g = v at e
  rwa [e]

/-- Adding the integral Levi leaves the lower radical intersection at level one. -/
theorem leviCongruenceSubgroup_inf_lower :
    B.leviCongruenceSubgroup k ⊓ Nbar = J 1 ⊓ Nbar := by
  apply le_antisymm _ (inf_le_inf_right _ le_sup_right)
  intro g hg
  obtain ⟨l, hl, m, hm, v, hv, he⟩ := B.exists_leviCongruence_factor_aux k hg.1
  have hJ : J 1 ≤ J 0 := principalLevelSubgroup_antitone k r (Nat.zero_le 1)
  let g' : B.iwahoriLower k (J 0) := ⟨g, B.leviCongruenceSubgroup_le_integral k hg.1, hg.2⟩
  let l' : B.iwahoriLower k (J 0) := ⟨l, hJ hl.1, hl.2⟩
  have eq : B.iwahoriProduct k (J 0) (g', 1, 1) =
      B.iwahoriProduct k (J 0) (l', ⟨m, hm⟩, ⟨v, hJ hv.1, hv.2⟩) := by
    apply Subtype.ext
    simpa only [iwahoriProduct_val, OneMemClass.coe_one, mul_one] using he
  have e := congrArg (fun x => (x.1 : L)) (B.iwahoriProduct_injective k _ eq)
  change g = l at e
  rwa [e]

section Topology

variable [TopologicalSpace k] [IsNonarchimedeanLocalField k]

/-- The Levi enlargement is open because it contains the first principal level. -/
def leviCongruenceOpenSubgroup : OpenSubgroup L where
  toSubgroup := B.leviCongruenceSubgroup k
  isOpen' := Subgroup.isOpen_mono (B.principalLevel_le_leviCongruenceSubgroup k)
    (principalLevelOpenSubgroup k r 1).isOpen

theorem isCompact_leviCongruenceOpenSubgroup :
    IsCompact (B.leviCongruenceOpenSubgroup k : Set L) :=
  (isCompact_principalLevelOpenSubgroup k r 0).of_isClosed_subset
    (B.leviCongruenceOpenSubgroup k).isClosed (B.leviCongruenceSubgroup_le_integral k)

end Topology

/-- The integral Levi enlargement has the same radical intersections as the first
principal level and the full integral Levi intersection. -/
def LeviCongruenceIntersectionsStatement : Prop :=
  ∀ (k : Type u) [Field k] [ValuativeRel k] (r : ℕ) (B : BlockShape (r + 1)),
    (B.leviCongruenceSubgroup k ⊓ B.leviSubgroup k =
      principalLevelSubgroup k r 0 ⊓ B.leviSubgroup k) ∧
    (B.leviCongruenceSubgroup k ⊓ B.unipotentSubgroup k =
      principalLevelSubgroup k r 1 ⊓ B.unipotentSubgroup k) ∧
    (B.leviCongruenceSubgroup k ⊓ B.oppositeUnipotentSubgroup k =
      principalLevelSubgroup k r 1 ⊓ B.oppositeUnipotentSubgroup k)

theorem leviCongruenceIntersections : LeviCongruenceIntersectionsStatement.{u} :=
  fun k _ _ _ B => ⟨B.leviCongruenceSubgroup_inf_levi k,
    B.leviCongruenceSubgroup_inf_upper k, B.leviCongruenceSubgroup_inf_lower k⟩

end Langlands.GeneralLinear.BlockShape
