import Mathlib.Algebra.Group.Submonoid.Basic
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Order.Interval.Finset.Fin
import Mathlib.Data.Int.Interval
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Tactic

/-!
# Finite generation of dominant zero-sum exponent tuples

The antitone integer tuples `lam : Fin m → ℤ` with `∑ i, lam i = 0` form an additive
submonoid generated by the finitely many such tuples whose entries are bounded by `m ^ 2`
in absolute value.
-/

namespace Langlands.GeneralLinear

/-- Antitone integer exponent tuples whose entries sum to zero. -/
def zeroSumDominant (m : ℕ) : Set (Fin m → ℤ) :=
  {lam | Antitone lam ∧ ∑ i, lam i = 0}

/-- The zero-sum dominant tuples with every entry bounded by `m ^ 2` in absolute value. -/
def dominantGenerators (m : ℕ) : Set (Fin m → ℤ) :=
  {lam | lam ∈ zeroSumDominant m ∧ ∀ i, |lam i| ≤ (m : ℤ) ^ 2}

theorem dominantGenerators_subset (m : ℕ) : dominantGenerators m ⊆ zeroSumDominant m :=
  fun _ h => h.1

theorem dominantGenerators_finite (m : ℕ) : (dominantGenerators m).Finite := by
  refine (Set.Finite.pi (t := fun _ : Fin m => Set.Icc (-((m : ℤ) ^ 2)) ((m : ℤ) ^ 2))
    fun _ => Set.finite_Icc _ _).subset ?_
  intro lam hlam i _
  exact abs_le.1 (hlam.2 i)

/-- The step tuple with value `n - k` up to index `k` and `-(k + 1)` afterwards; its only
gap is `n + 1`, between `k` and `k + 1`. -/
def dominantStep {n : ℕ} (k : Fin n) : Fin (n + 1) → ℤ :=
  fun j => if j.val ≤ k.val then (n : ℤ) - k.val else -((k.val : ℤ) + 1)

theorem dominantStep_antitone {n : ℕ} (k : Fin n) : Antitone (dominantStep k) := by
  intro i j hij
  have hij' : i.val ≤ j.val := hij
  unfold dominantStep
  split_ifs <;> omega

theorem dominantStep_sum {n : ℕ} (k : Fin n) : ∑ j, dominantStep k j = 0 := by
  have hsplit : ∀ j : Fin (n + 1), dominantStep k j =
      (if j ∈ Finset.Iic (Fin.castSucc k) then ((n : ℤ) + 1) else 0) - ((k.val : ℤ) + 1) := by
    intro j
    simp only [dominantStep, Finset.mem_Iic, Fin.le_def, Fin.val_castSucc]
    split_ifs <;> ring
  simp only [hsplit, Finset.sum_sub_distrib, Finset.sum_ite_mem, Finset.univ_inter,
    Finset.sum_const, Fin.card_Iic, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    Fin.val_castSucc]
  push_cast
  ring

theorem dominantStep_mem {n : ℕ} (k : Fin n) : dominantStep k ∈ dominantGenerators (n + 1) := by
  refine ⟨⟨dominantStep_antitone k, dominantStep_sum k⟩, fun j => ?_⟩
  have hk := k.isLt
  have hn : (n : ℤ) ≤ ((n + 1 : ℕ) : ℤ) ^ 2 := by push_cast; nlinarith
  unfold dominantStep
  split_ifs
  · rw [abs_le]; constructor <;> omega
  · rw [abs_le]; constructor <;> omega

/-- Without a gap of size at least `n + 1`, the spread of a tuple is at most `j * n`. -/
theorem sub_le_of_gaps {n : ℕ} (lam : Fin (n + 1) → ℤ)
    (hgap : ∀ k : Fin n, lam k.castSucc - lam k.succ ≤ n) (j : Fin (n + 1)) :
    lam 0 - lam j ≤ j.val * n := by
  induction j using Fin.induction with
  | zero => simp
  | succ k ih =>
    have := hgap k
    rw [Fin.val_succ, Fin.val_castSucc] at *
    push_cast
    linarith

theorem zero_le_apply_zero {n : ℕ} {lam : Fin (n + 1) → ℤ} (hlam : lam ∈ zeroSumDominant (n + 1)) :
    0 ≤ lam 0 := by
  have hle : ∑ i, lam i ≤ ∑ _i : Fin (n + 1), lam 0 :=
    Finset.sum_le_sum fun i _ => hlam.1 (Fin.zero_le i)
  rw [hlam.2, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hle
  push_cast at hle
  by_contra h
  push Not at h
  have := mul_neg_of_pos_of_neg (by positivity : (0 : ℤ) < n + 1) h
  linarith

theorem apply_last_nonpos {n : ℕ} {lam : Fin (n + 1) → ℤ} (hlam : lam ∈ zeroSumDominant (n + 1)) :
    lam (Fin.last n) ≤ 0 := by
  have hle : ∑ _i : Fin (n + 1), lam (Fin.last n) ≤ ∑ i, lam i :=
    Finset.sum_le_sum fun i _ => hlam.1 (Fin.le_last i)
  rw [hlam.2, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hle
  push_cast at hle
  by_contra h
  push Not at h
  have := mul_pos (by positivity : (0 : ℤ) < n + 1) h
  linarith

theorem mem_closure_dominantGenerators_succ {n : ℕ} :
    ∀ (d : ℕ) (lam : Fin (n + 1) → ℤ), lam ∈ zeroSumDominant (n + 1) →
      lam 0 - lam (Fin.last n) ≤ d →
        lam ∈ AddSubmonoid.closure (dominantGenerators (n + 1)) := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
    intro lam hlam hd
    by_cases hgap : ∃ k : Fin n, (n : ℤ) + 1 ≤ lam k.castSucc - lam k.succ
    · obtain ⟨k, hk⟩ := hgap
      set w := dominantStep k
      have hk' := k.isLt
      have hw0 : w 0 = (n : ℤ) - k.val := by
        simp [w, dominantStep]
      have hwl : w (Fin.last n) = -((k.val : ℤ) + 1) := by
        simp only [w, dominantStep, Fin.val_last]
        simp only [show ¬ n ≤ k.val by omega, ↓reduceIte]
      -- `lam - w` is again dominant with sum zero and smaller spread
      have hmem : lam - w ∈ zeroSumDominant (n + 1) := by
        refine ⟨fun i j hij => ?_, ?_⟩
        · have hij' : i.val ≤ j.val := hij
          simp only [Pi.sub_apply, w, dominantStep]
          by_cases hi : i.val ≤ k.val
          · by_cases hj : j.val ≤ k.val
            · simp only [hi, hj, ↓reduceIte]
              linarith [hlam.1 hij]
            · simp only [hi, hj, ↓reduceIte]
              have h1 : lam k.succ ≥ lam j := hlam.1 (by
                rw [Fin.le_def, Fin.val_succ]; omega)
              have h2 : lam i ≥ lam k.castSucc := hlam.1 (by
                rw [Fin.le_def, Fin.val_castSucc]; omega)
              linarith
          · simp only [hi, show ¬ j.val ≤ k.val by omega, ↓reduceIte]
            linarith [hlam.1 hij]
        · simp only [Pi.sub_apply]
          rw [Finset.sum_sub_distrib, hlam.2, dominantStep_sum, sub_zero]
      have hspread : (lam - w) 0 - (lam - w) (Fin.last n) =
          lam 0 - lam (Fin.last n) - ((n : ℤ) + 1) := by
        simp only [Pi.sub_apply, hw0, hwl]
        ring
      have hpos : (n : ℤ) + 1 ≤ lam 0 - lam (Fin.last n) := by
        have h1 : lam k.castSucc ≤ lam 0 := hlam.1 (Fin.zero_le _)
        have h2 : lam (Fin.last n) ≤ lam k.succ := hlam.1 (Fin.le_last _)
        linarith
      have hrec := ih (d - (n + 1)) (by omega) (lam - w) hmem (by
        rw [hspread]
        have : ((d - (n + 1) : ℕ) : ℤ) = (d : ℤ) - (n + 1) := by
          rw [Nat.cast_sub (by omega)]
          push_cast
          ring
        rw [this]
        linarith)
      have hlw : lam = (lam - w) + w := by abel
      rw [hlw]
      exact AddSubmonoid.add_mem _ hrec (AddSubmonoid.subset_closure (dominantStep_mem k))
    · push Not at hgap
      apply AddSubmonoid.subset_closure
      refine ⟨hlam, fun j => ?_⟩
      have hspread := sub_le_of_gaps lam (fun k => by linarith [hgap k]) (Fin.last n)
      rw [Fin.val_last] at hspread
      have h0 := zero_le_apply_zero hlam
      have hl := apply_last_nonpos hlam
      have hj0 : lam j ≤ lam 0 := hlam.1 (Fin.zero_le j)
      have hjl : lam (Fin.last n) ≤ lam j := hlam.1 (Fin.le_last j)
      have hnn : (n : ℤ) * n ≤ ((n + 1 : ℕ) : ℤ) ^ 2 := by push_cast; nlinarith
      rw [abs_le]
      constructor <;> nlinarith

/-- Every antitone zero-sum integer tuple is a sum of tuples from the finite set
`dominantGenerators m`. -/
theorem mem_closure_dominantGenerators {m : ℕ} {lam : Fin m → ℤ}
    (hlam : lam ∈ zeroSumDominant m) :
    lam ∈ AddSubmonoid.closure (dominantGenerators m) := by
  cases m with
  | zero =>
    have : lam = 0 := funext fun i => i.elim0
    rw [this]
    exact zero_mem _
  | succ n =>
    exact mem_closure_dominantGenerators_succ _ lam hlam (Int.self_le_toNat _)

end Langlands.GeneralLinear
