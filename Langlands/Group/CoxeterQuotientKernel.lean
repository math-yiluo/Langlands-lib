import Mathlib.GroupTheory.Coxeter.Basic
import Mathlib.GroupTheory.QuotientGroup.Basic

/-! # Kernels for subgroups generated by Coxeter lifts -/

noncomputable section

universe u v w

namespace Langlands.Group.CoxeterQuotient

variable {B : Type u} {N : Type v} {W : Type w} [Group N] [Group W]

/-- The subgroup generated by a given subgroup and a family of lifts. -/
def generatedBy (H : Subgroup N) (m : B → N) : Subgroup N :=
  H ⊔ Subgroup.closure (Set.range m)

variable {M : CoxeterMatrix B} (cs : CoxeterSystem M W)
  (H : Subgroup N) [H.Normal] (m : B → N)

/-- Coxeter relations modulo `H` produce a homomorphism to `N/H`. -/
def sectionHom (hrel : M.IsLiftable (fun a => QuotientGroup.mk' H (m a))) :
    W →* N ⧸ H :=
  cs.lift ⟨_, hrel⟩

@[simp] theorem sectionHom_apply_simple
    (hrel : M.IsLiftable (fun a => QuotientGroup.mk' H (m a))) (a : B) :
    sectionHom cs H m hrel (cs.simple a) = QuotientGroup.mk' H (m a) :=
  cs.lift_apply_simple hrel a

/-- A homomorphism taking the lifts to simple reflections is left inverse
of the Coxeter lift, after passage to the quotient. -/
theorem projection_sectionHom (q : N →* W) (hH : H ≤ q.ker)
    (hm : ∀ a, q (m a) = cs.simple a)
    (hrel : M.IsLiftable (fun a => QuotientGroup.mk' H (m a))) :
    (QuotientGroup.lift H q hH).comp (sectionHom cs H m hrel) = MonoidHom.id W := by
  apply cs.ext_simple
  intro a
  simpa only [MonoidHom.comp_apply, sectionHom_apply_simple, QuotientGroup.mk'_apply,
    QuotientGroup.lift_mk, MonoidHom.id_apply] using hm a

/-- Modulo `H`, every element generated by `H` and the lifts is in the
image of the Coxeter lift. -/
theorem generatedBy_le_comap_range_sectionHom
    (hrel : M.IsLiftable (fun a => QuotientGroup.mk' H (m a))) :
    generatedBy H m ≤ (sectionHom cs H m hrel).range.comap (QuotientGroup.mk' H) := by
  refine sup_le ?_ ?_
  · intro n hn
    change QuotientGroup.mk' H n ∈ (sectionHom cs H m hrel).range
    refine ⟨1, ?_⟩
    rw [map_one]
    exact ((QuotientGroup.eq_one_iff n).2 hn).symm
  · apply (Subgroup.closure_le _).2
    rintro _ ⟨a, rfl⟩
    exact ⟨cs.simple a, sectionHom_apply_simple cs H m hrel a⟩

/-- If the chosen lifts satisfy the Coxeter relations modulo `H`, their
generated subgroup has no additional elements in the kernel of the projection. -/
theorem generatedBy_inf_ker_eq (q : N →* W) (hH : H ≤ q.ker)
    (hm : ∀ a, q (m a) = cs.simple a)
    (hrel : M.IsLiftable (fun a => QuotientGroup.mk' H (m a))) :
    generatedBy H m ⊓ q.ker = H := by
  apply le_antisymm
  · intro n hn
    obtain ⟨w, hw⟩ := generatedBy_le_comap_range_sectionHom cs H m hrel hn.1
    have hw1 : w = 1 := by
      have h := congrArg (QuotientGroup.lift H q hH) hw
      have hsec := DFunLike.congr_fun (projection_sectionHom cs H m q hH hm hrel) w
      simp only [MonoidHom.comp_apply, MonoidHom.id_apply] at hsec
      rw [hsec] at h
      exact h.trans hn.2
    apply (QuotientGroup.eq_one_iff n).1
    change QuotientGroup.mk' H n = 1
    rw [← hw, hw1, map_one]
  · exact le_inf le_sup_left hH

end Langlands.Group.CoxeterQuotient
