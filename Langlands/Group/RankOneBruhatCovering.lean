import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Tactic.Group

/-! # A word argument for the rank-one Bruhat covering -/

namespace Langlands.Group.RankOneBruhat

variable {G : Type*} [Group G]

/-- The union of the `U` double cosets of the elements of `M`. -/
def doubleCosets (U M : Subgroup G) : Set G :=
  {g | ∃ u ∈ U, ∃ n ∈ M, ∃ v ∈ U, g = u * n * v}

variable {U M : Subgroup G}

theorem one_mem_doubleCosets : (1 : G) ∈ doubleCosets U M :=
  ⟨1, U.one_mem, 1, M.one_mem, 1, U.one_mem, by simp⟩

theorem mul_mem_doubleCosets_left {u g : G} (hu : u ∈ U)
    (hg : g ∈ doubleCosets U M) : u * g ∈ doubleCosets U M := by
  obtain ⟨v, hv, n, hn, w, hw, rfl⟩ := hg
  exact ⟨u * v, U.mul_mem hu hv, n, hn, w, hw, by simp [mul_assoc]⟩

/-- A middle-subgroup element normalizing `U` preserves the union of
double cosets by left multiplication. -/
theorem mul_mem_doubleCosets_of_normalizes {h g : G} (hh : h ∈ M)
    (hnorm : ∀ u ∈ U, h * u * h⁻¹ ∈ U)
    (hg : g ∈ doubleCosets U M) : h * g ∈ doubleCosets U M := by
  obtain ⟨u, hu, n, hn, v, hv, rfl⟩ := hg
  refine ⟨h * u * h⁻¹, hnorm u hu, h * n, M.mul_mem hh hn, v, hv, ?_⟩
  simp [mul_assoc]

/-- The rank-one step. Factor `U` into a part carried into `U` by `r`
and a positive root group `A`. Nonidentity points of `A` factor through
the opposite root group `B` and `M`. For each `n ∈ M`, one of `A` and
`B` is carried into `U` by conjugation with `n⁻¹`. -/
theorem mul_mem_doubleCosets_of_rankOne
    {r g : G} (hr : r ∈ M) (A B : Subgroup G) (V : Set G)
    (hfactor : ∀ u ∈ U, ∃ q ∈ V, ∃ a ∈ A, u = q * a)
    (hV : ∀ q ∈ V, r * q * r⁻¹ ∈ U)
    (hB : ∀ b ∈ B, r * b * r⁻¹ ∈ U)
    (hrank : ∀ a ∈ A, a ≠ 1 →
      ∃ x ∈ B, ∃ m ∈ M, ∃ y ∈ B, a = x * m * y)
    (hsign : ∀ n ∈ M,
      (∀ a ∈ A, n⁻¹ * a * n ∈ U) ∨
        (∀ b ∈ B, n⁻¹ * b * n ∈ U))
    (hg : g ∈ doubleCosets U M) : r * g ∈ doubleCosets U M := by
  obtain ⟨u, hu, n, hn, v, hv, rfl⟩ := hg
  obtain ⟨q, hq, a, ha, rfl⟩ := hfactor u hu
  have hqU := hV q hq
  rcases hsign n hn with hpos | hneg
  · refine ⟨r * q * r⁻¹, hqU, r * n, M.mul_mem hr hn,
      (n⁻¹ * a * n) * v, U.mul_mem (hpos a ha) hv, ?_⟩
    group
  · by_cases ha1 : a = 1
    · refine ⟨r * q * r⁻¹, hqU, r * n, M.mul_mem hr hn, v, hv, ?_⟩
      rw [ha1]
      group
    · obtain ⟨x, hx, m, hm, y, hy, rfl⟩ := hrank a ha ha1
      refine ⟨(r * q * r⁻¹) * (r * x * r⁻¹), U.mul_mem hqU (hB x hx),
        r * m * n, M.mul_mem (M.mul_mem hr hm) hn,
        (n⁻¹ * y * n) * v, U.mul_mem (hneg y hy) hv, ?_⟩
      group

/-- Left stability under each generator and its inverse gives stability
under every word in those generators. -/
theorem closure_subset_doubleCosets {X : Set G}
    (hleft : ∀ x ∈ X, ∀ g ∈ doubleCosets U M, x * g ∈ doubleCosets U M)
    (hinv : ∀ x ∈ X, ∀ g ∈ doubleCosets U M, x⁻¹ * g ∈ doubleCosets U M) :
    (Subgroup.closure X : Set G) ⊆ doubleCosets U M := by
  intro x hx
  induction hx using Subgroup.closure_induction_left with
  | one => exact one_mem_doubleCosets
  | mul_left x hx y _ ih => exact hleft x hx y ih
  | inv_mul_cancel x hx y _ ih => exact hinv x hx y ih

/-- Let `H ≤ M` normalize `U`, and let `R ⊆ M` be reflection
representatives preserving `U M U`. If each inverse representative is
`h * r` for some `h ∈ H`, then `U`, `H`, and `R` generate only points of
`U M U`. -/
theorem generated_subset_doubleCosets
    (H : Subgroup G) (hHM : H ≤ M)
    (hHU : ∀ h ∈ H, ∀ u ∈ U, h * u * h⁻¹ ∈ U)
    (R : Set G)
    (hR : ∀ r ∈ R, ∀ g ∈ doubleCosets U M, r * g ∈ doubleCosets U M)
    (hRinv : ∀ r ∈ R, ∃ h ∈ H, r⁻¹ = h * r) :
    (Subgroup.closure ((U : Set G) ∪ (H : Set G) ∪ R) : Set G) ⊆
      doubleCosets U M := by
  apply closure_subset_doubleCosets
  · intro x hx g hg
    rcases hx with (hx | hx) | hx
    · exact mul_mem_doubleCosets_left hx hg
    · exact mul_mem_doubleCosets_of_normalizes (hHM hx) (hHU x hx) hg
    · exact hR x hx g hg
  · intro x hx g hg
    rcases hx with (hx | hx) | hx
    · exact mul_mem_doubleCosets_left (U.inv_mem hx) hg
    · exact mul_mem_doubleCosets_of_normalizes (hHM (H.inv_mem hx))
        (hHU x⁻¹ (H.inv_mem hx)) hg
    · obtain ⟨h, hh, heq⟩ := hRinv x hx
      rw [heq, mul_assoc]
      exact mul_mem_doubleCosets_of_normalizes (hHM hh) (hHU h hh) (hR x hx g hg)

/-- Any subgroup contained in the group generated by `U`, `H`, and the
chosen representatives inherits the rank-one covering. -/
theorem subgroup_subset_doubleCosets
    (H : Subgroup G) (hHM : H ≤ M)
    (hHU : ∀ h ∈ H, ∀ u ∈ U, h * u * h⁻¹ ∈ U)
    (R : Set G)
    (hR : ∀ r ∈ R, ∀ g ∈ doubleCosets U M, r * g ∈ doubleCosets U M)
    (hRinv : ∀ r ∈ R, ∃ h ∈ H, r⁻¹ = h * r)
    (E : Subgroup G) (hE : E ≤ Subgroup.closure ((U : Set G) ∪ (H : Set G) ∪ R)) :
    (E : Set G) ⊆ doubleCosets U M := by
  exact Set.Subset.trans hE (generated_subset_doubleCosets H hHM hHU R hR hRinv)

/-- Uniqueness of the normalizing middle factor reduces a centralizer
intersection to the corresponding intersection with `M`. -/
theorem inf_le_of_doubleCosets
    (Z N E H : Subgroup G) (hZN : Z ≤ N) (hMN : M ≤ N)
    (hcover : (E : Set G) ⊆ doubleCosets U M)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, ∀ u ∈ U, ∀ v ∈ U,
      n' = u * n * v → n' = n)
    (hkernel : Z ⊓ M ≤ H) :
    Z ⊓ E ≤ H := by
  intro z hz
  obtain ⟨u, hu, n, hn, v, hv, heq⟩ := hcover hz.2
  have hzn : z = n := hsep n (hMN hn) z (hZN hz.1) u hu v hv heq
  exact hkernel ⟨hz.1, hzn ▸ hn⟩

end Langlands.Group.RankOneBruhat
