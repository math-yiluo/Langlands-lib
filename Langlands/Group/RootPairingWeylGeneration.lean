import Mathlib.Algebra.Group.Irreducible.Indecomposable
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.RootSystem.BaseExists
import Mathlib.LinearAlgebra.RootSystem.WeylGroup

/-!
# The Weyl group of a finite crystallographic root pairing is generated by simple reflections

Let `P` be a finite crystallographic root pairing over a linearly ordered field `R`, and let
`f : Module.Dual R M` be nonzero on every root. The simple roots relative to `f` are the indices
in `IsAddIndecomposable.baseOf P.root f`. We prove that every element of the Weyl group is a
product of reflections in simple roots.
-/

namespace Langlands.Group

open RootPairing Set

section CommRing

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] (P : RootPairing ι R M N)

/-- Conjugating a reflection by a reflection gives the reflection in the reflected root. -/
private lemma ofIdx_reflectionPerm (b j : ι) :
    weylGroup.ofIdx P (P.reflectionPerm b j) =
      weylGroup.ofIdx P b * weylGroup.ofIdx P j * weylGroup.ofIdx P b := by
  apply Subtype.ext
  apply Equiv.weightHom_injective P
  change Equiv.weightHom P (Equiv.reflection P (P.reflectionPerm b j)) =
    Equiv.weightHom P (Equiv.reflection P b * Equiv.reflection P j * Equiv.reflection P b)
  simp only [map_mul, Equiv.weightHom_apply, Equiv.reflection_weightEquiv]
  exact P.reflection_reflectionPerm

end CommRing

section Field

variable {ι R M N : Type*} [Field R] [CharZero R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] (P : RootPairing ι R M N) [Finite ι]

/-- Proportional roots give the same reflection in the Weyl group. -/
private lemma ofIdx_eq_of_root_eq_smul {i j : ι} {t : R} (h : P.root j = t • P.root i) :
    weylGroup.ofIdx P j = weylGroup.ofIdx P i := by
  have : IsAddTorsionFree N := .of_isTorsionFree R N
  have hc : t • P.coroot j = P.coroot i := P.smul_coroot_eq_of_root_eq_smul i j t h
  apply Subtype.ext
  apply Equiv.weightHom_injective P
  change Equiv.weightHom P (Equiv.reflection P j) = Equiv.weightHom P (Equiv.reflection P i)
  simp only [Equiv.weightHom_apply, Equiv.reflection_weightEquiv]
  ext x
  have hx : P.coroot' i x = P.coroot' j x * t := by simp [coroot', ← hc, mul_comm]
  rw [reflection_apply, reflection_apply, h, smul_smul, hx]

end Field

section Ordered

variable {ι R M N : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι] [P.IsCrystallographic]

/-- The sign of the pairing is symmetric. -/
private lemma zero_lt_pairing_comm (i j : ι) : 0 < P.pairing i j ↔ 0 < P.pairing j i := by
  rw [← P.algebraMap_pairingIn ℤ, ← P.algebraMap_pairingIn ℤ]
  simpa using P.zero_lt_pairingIn_iff' ℤ (i := i) (j := j)

variable (f : Module.Dual R M)

omit [P.IsCrystallographic] in
/-- Positive roots lie in the additive submonoid generated by the simple roots. -/
private lemma root_mem_closure {i : ι} (hi : 0 < f (P.root i)) :
    P.root i ∈ AddSubmonoid.closure
      (P.root '' IsAddIndecomposable.baseOf P.root (f : M →+ R)) := by
  rw [AddSubmonoid.closure_image_isAddIndecomposable_baseOf P.root (f : M →+ R)]
  exact AddSubmonoid.subset_closure ⟨i, hi, rfl⟩

omit [P.IsCrystallographic] in
/-- Negatives of negative roots lie in the additive submonoid generated by the simple roots. -/
private lemma neg_root_mem_closure {i : ι} (hi : f (P.root i) < 0) :
    -P.root i ∈ AddSubmonoid.closure
      (P.root '' IsAddIndecomposable.baseOf P.root (f : M →+ R)) := by
  have h : P.root (P.reflectionPerm i i) = -P.root i := by simp
  rw [← h]
  exact root_mem_closure P f (by rw [h, map_neg]; linarith)

/-- Coordinate functionals on the simple roots. -/
private lemma exists_coord (hf : ∀ i, f (P.root i) ≠ 0) {c : ι}
    (hc : c ∈ IsAddIndecomposable.baseOf P.root (f : M →+ R)) :
    ∃ φ : Module.Dual R M, φ (P.root c) = 1 ∧
      ∀ d ∈ IsAddIndecomposable.baseOf P.root (f : M →+ R), d ≠ c → φ (P.root d) = 0 := by
  have hli : LinearIndepOn R P.root (IsAddIndecomposable.baseOf P.root (f : M →+ R)) :=
    P.linearIndepOn_root_baseOf' (S := R) f hf
  obtain ⟨g, hg, hg'⟩ := Submodule.exists_dual_map_eq_bot_of_notMem (hli.notMem_span hc)
    inferInstance
  refine ⟨(g (P.root c))⁻¹ • g, by simp [hg], fun d hd hdc => ?_⟩
  have hmem : g (P.root d) ∈ (Submodule.span R
      (P.root '' (IsAddIndecomposable.baseOf P.root (f : M →+ R) \ {c}))).map g :=
    Submodule.mem_map_of_mem (Submodule.subset_span ⟨d, ⟨hd, hdc⟩, rfl⟩)
  rw [hg', Submodule.mem_bot] at hmem
  simp [hmem]

/-- If a simple reflection sends a positive root to a negative one, then that root is a multiple
of the simple root. -/
private lemma exists_root_eq_smul_of_reflection (hf : ∀ i, f (P.root i) ≠ 0) {b i : ι}
    (hb : b ∈ IsAddIndecomposable.baseOf P.root (f : M →+ R)) (hi : 0 < f (P.root i))
    (hj : f (P.reflection b (P.root i)) < 0) :
    ∃ t : R, P.root i = t • P.root b := by
  classical
  set Δ := IsAddIndecomposable.baseOf P.root (f : M →+ R) with hΔ
  have hφ : ∀ c, ∃ φ : Module.Dual R M, c ∈ Δ →
      (φ (P.root c) = 1 ∧ ∀ d ∈ Δ, d ≠ c → φ (P.root d) = 0) := by
    intro c
    by_cases hc : c ∈ Δ
    · obtain ⟨φ, h1, h2⟩ := exists_coord P f hf hc
      exact ⟨φ, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨0, fun h => absurd h hc⟩
  choose φ hφ using hφ
  let Δs : Finset ι := (Set.toFinite Δ).toFinset
  have hΔs : ∀ c, c ∈ Δs ↔ c ∈ Δ := fun c => Set.Finite.mem_toFinset _
  have key : ∀ x ∈ AddSubmonoid.closure (P.root '' Δ),
      (∀ c ∈ Δ, 0 ≤ φ c x) ∧ x = ∑ c ∈ Δs, φ c x • P.root c := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction with
    | mem x hx =>
      obtain ⟨d, hd, rfl⟩ := hx
      refine ⟨fun c hc => ?_, ?_⟩
      · by_cases hdc : d = c
        · subst hdc
          rw [(hφ d hd).1]
          exact zero_le_one
        · rw [(hφ c hc).2 d hd hdc]
      · rw [Finset.sum_eq_single d]
        · rw [(hφ d hd).1, one_smul]
        · intro c hc hcd
          rw [(hφ c ((hΔs c).mp hc)).2 d hd (Ne.symm hcd), zero_smul]
        · intro hd'
          exact absurd ((hΔs d).mpr hd) hd'
    | zero => simp
    | add x y _ _ hx hy =>
      refine ⟨fun c hc => ?_, ?_⟩
      · rw [map_add]
        exact add_nonneg (hx.1 c hc) (hy.1 c hc)
      · simp only [map_add, add_smul, Finset.sum_add_distrib]
        rw [← hx.2, ← hy.2]
  have hx := key _ (root_mem_closure P f hi)
  have hy := key _ (neg_root_mem_closure P f (i := P.reflectionPerm b i)
    (by rwa [root_reflectionPerm]))
  have hzero : ∀ c ∈ Δ, c ≠ b → φ c (P.root i) = 0 := by
    intro c hc hcb
    have h1 := hx.1 c hc
    have h2 := hy.1 c hc
    rw [root_reflectionPerm, reflection_apply_root, map_neg, map_sub, map_smul,
      (hφ c hc).2 b hb (Ne.symm hcb), smul_zero, sub_zero] at h2
    linarith
  refine ⟨φ b (P.root i), ?_⟩
  calc P.root i = ∑ c ∈ Δs, φ c (P.root i) • P.root c := hx.2
    _ = φ b (P.root i) • P.root b := by
      refine Finset.sum_eq_single b (fun c hc hcb => ?_) (fun hb' => ?_)
      · rw [hzero c ((hΔs c).mp hc) hcb, zero_smul]
      · exact absurd ((hΔs b).mpr hb) hb'

/-- A positive root pairs positively with some simple coroot. -/
private lemma exists_pairing_pos {i : ι} (hi : 0 < f (P.root i)) :
    ∃ b ∈ IsAddIndecomposable.baseOf P.root (f : M →+ R), 0 < P.pairing i b := by
  by_contra! h
  have key : ∀ x ∈ AddSubmonoid.closure
      (P.root '' IsAddIndecomposable.baseOf P.root (f : M →+ R)), P.coroot' i x ≤ 0 := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction with
    | mem x hx =>
      obtain ⟨b, hb, rfl⟩ := hx
      rw [root_coroot'_eq_pairing]
      exact not_lt.mp fun hpos =>
        absurd ((zero_lt_pairing_comm P b i).mp hpos) (not_lt.mpr (h b hb))
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      exact add_nonpos hx hy
  have := key _ (root_mem_closure P f hi)
  rw [root_coroot'_eq_pairing, pairing_same] at this
  norm_num at this

/-- The reflection in a positive root is a product of simple reflections. -/
private lemma exists_list_prod_ofIdx_of_pos (hf : ∀ i, f (P.root i) ≠ 0) (i : ι)
    (hi : 0 < f (P.root i)) :
    ∃ x : List (IsAddIndecomposable.baseOf P.root (f : M →+ R)),
      (x.map fun b : IsAddIndecomposable.baseOf P.root (f : M →+ R) =>
        weylGroup.ofIdx P (b : ι)).prod = weylGroup.ofIdx P i := by
  by_contra hcon
  let s : Set ι := {i | 0 < f (P.root i) ∧
    ¬ ∃ x : List (IsAddIndecomposable.baseOf P.root (f : M →+ R)),
      (x.map fun b : IsAddIndecomposable.baseOf P.root (f : M →+ R) =>
        weylGroup.ofIdx P (b : ι)).prod = weylGroup.ofIdx P i}
  have hne : s.Nonempty := ⟨i, hi, hcon⟩
  obtain ⟨k, hk⟩ := s.toFinite.exists_minimalFor (fun j => f (P.root j)) s hne
  obtain ⟨hk0, hk1⟩ := hk.prop
  obtain ⟨b, hb, hpos⟩ := exists_pairing_pos P f hk0
  have hroot : P.root (P.reflectionPerm b k) = P.root k - P.pairing k b • P.root b := by
    rw [root_reflectionPerm, reflection_apply_root]
  have hlt : f (P.root (P.reflectionPerm b k)) < f (P.root k) := by
    have hb0 : 0 < f (P.root b) := hb.1
    rw [hroot, map_sub, map_smul, smul_eq_mul]
    nlinarith
  rcases lt_or_gt_of_ne (hf (P.reflectionPerm b k)) with hneg | hpos'
  · obtain ⟨t, ht⟩ := exists_root_eq_smul_of_reflection P f hf hb hk0
      (by rwa [root_reflectionPerm] at hneg)
    exact hk1 ⟨[⟨b, hb⟩], by simp [ofIdx_eq_of_root_eq_smul P ht]⟩
  · obtain ⟨x, hx⟩ : ∃ x : List (IsAddIndecomposable.baseOf P.root (f : M →+ R)),
        (x.map fun b : IsAddIndecomposable.baseOf P.root (f : M →+ R) =>
          weylGroup.ofIdx P (b : ι)).prod = weylGroup.ofIdx P (P.reflectionPerm b k) := by
      by_contra h
      exact absurd hlt (not_lt.mpr (hk.le_of_le ⟨hpos', h⟩ hlt.le))
    have hconj := ofIdx_reflectionPerm P b (P.reflectionPerm b k)
    rw [reflectionPerm_self] at hconj
    refine hk1 ⟨⟨b, hb⟩ :: (x ++ [⟨b, hb⟩]), ?_⟩
    rw [hconj, ← hx]
    simp [mul_assoc]

/-- Every reflection is a product of simple reflections. -/
private lemma exists_list_prod_ofIdx (hf : ∀ i, f (P.root i) ≠ 0) (i : ι) :
    ∃ x : List (IsAddIndecomposable.baseOf P.root (f : M →+ R)),
      (x.map fun b : IsAddIndecomposable.baseOf P.root (f : M →+ R) =>
        weylGroup.ofIdx P (b : ι)).prod = weylGroup.ofIdx P i := by
  rcases lt_or_gt_of_ne (hf i) with hneg | hpos
  · have h : P.root (P.reflectionPerm i i) = (-1 : R) • P.root i := by simp
    obtain ⟨x, hx⟩ := exists_list_prod_ofIdx_of_pos P f hf (P.reflectionPerm i i)
      (by rw [h, map_smul]; simp; linarith)
    exact ⟨x, by rw [hx, ofIdx_eq_of_root_eq_smul P h]⟩
  · exact exists_list_prod_ofIdx_of_pos P f hf i hpos

/-- The Weyl group of a finite crystallographic root pairing over a linearly ordered field is
generated by the reflections in the simple roots relative to any linear form that is nonzero on
every root. -/
theorem exists_list_prod_ofIdx_baseOf (hf : ∀ i, f (P.root i) ≠ 0) (w : P.weylGroup) :
    ∃ x : List (IsAddIndecomposable.baseOf P.root (f : M →+ R)),
      (x.map fun b : IsAddIndecomposable.baseOf P.root (f : M →+ R) =>
        RootPairing.weylGroup.ofIdx P (b : ι)).prod = w := by
  obtain ⟨g, hg⟩ := w
  induction hg using weylGroup.induction with
  | mem i => exact exists_list_prod_ofIdx P f hf i
  | one => exact ⟨[], rfl⟩
  | mul x y hx hy hx' hy' =>
    obtain ⟨a, ha⟩ := hx'
    obtain ⟨c, hc⟩ := hy'
    exact ⟨a ++ c, by rw [List.map_append, List.prod_append, ha, hc]; rfl⟩

end Ordered

end Langlands.Group
