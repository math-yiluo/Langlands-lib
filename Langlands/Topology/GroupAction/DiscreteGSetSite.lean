import Mathlib.CategoryTheory.Action.Concrete
import Mathlib.CategoryTheory.Sites.JointlySurjective
import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
import Mathlib.Topology.Algebra.Group.Basic

/-! # Berkovich's site `P(G)` of discrete `G`-sets -/

universe z

open CategoryTheory

namespace Langlands

variable {G : Type z} [Group G]

/-- The action of `G` on the underlying set of a `G`-set. -/
instance Action.instMulActionType (S : Action (Type z) G) : MulAction G S.V :=
  Action.instMulAction S

theorem Action.smul_eq_ρ_apply (S : Action (Type z) G) (g : G) (s : S.V) : g • s = S.ρ g s :=
  rfl

/-- The `G`-map underlying a morphism of `G`-sets. -/
def Action.gMap {S T : Action (Type z) G} (f : S ⟶ T) : S.V →[G] T.V where
  toFun := f.hom
  map_smul' g x := ConcreteCategory.congr_hom (f.comm g) x

@[simp]
theorem Action.gMap_apply {S T : Action (Type z) G} (f : S ⟶ T) (s : S.V) :
    Action.gMap f s = f.hom s :=
  rfl

theorem Action.gMap_id (S : Action (Type z) G) : Action.gMap (𝟙 S) = MulActionHom.id G :=
  rfl

theorem Action.gMap_comp {S T U : Action (Type z) G} (f : S ⟶ T) (g : T ⟶ U) :
    Action.gMap (f ≫ g) = (Action.gMap g).comp (Action.gMap f) :=
  rfl

variable (G) [TopologicalSpace G]

/-- Discrete `G`-sets: `G`-sets all of whose stabilizers are open. -/
def discreteGSetProperty : ObjectProperty (Action (Type z) G) :=
  fun S => ∀ s : S.V, IsOpen (MulAction.stabilizer G s : Set G)

/-- Berkovich's category `P(G)` of discrete `G`-sets and `G`-maps. -/
abbrev DiscreteGSet := (discreteGSetProperty G).FullSubcategory

namespace DiscreteGSet

/-- The underlying set of a discrete `G`-set. -/
abbrev forget : DiscreteGSet G ⥤ Type z :=
  ObjectProperty.ι _ ⋙ Action.forget _ G

/-- The discrete `G`-set of a set with an action of `G` with open stabilizers. -/
abbrev of (S : Type z) [MulAction G S] (hS : ∀ s : S, IsOpen (MulAction.stabilizer G s : Set G)) :
    DiscreteGSet G :=
  ⟨Action.ofMulAction G S, hS⟩

section Quotient

variable {G} [IsTopologicalGroup G]

/-- The stabilizers of the action of `G` on `G ⧸ N` are open when `N` is open. -/
theorem isOpen_stabilizer_quotient {N : Subgroup G} (hN : IsOpen (N : Set G)) (x : G ⧸ N) :
    IsOpen (MulAction.stabilizer G x : Set G) := by
  induction x using QuotientGroup.induction_on with
  | H g =>
    have h : (MulAction.stabilizer G (g : G ⧸ N) : Set G) = (fun k => g⁻¹ * k⁻¹ * g) ⁻¹' N := by
      ext k
      rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, Set.mem_preimage, SetLike.mem_coe,
        MulAction.Quotient.smul_mk, QuotientGroup.eq, smul_eq_mul, mul_inv_rev]
    rw [h]
    exact hN.preimage (by fun_prop)

variable (G) in
/-- The discrete `G`-set `G ⧸ N` for an open subgroup `N`. -/
abbrev quotient (N : Subgroup G) (hN : IsOpen (N : Set G)) : DiscreteGSet G :=
  of G (G ⧸ N) (isOpen_stabilizer_quotient hN)

end Quotient

/-- Coverings of `P(G)` (Berkovich 1996, §1.2): surjective families of `G`-maps. -/
def precoverage : Precoverage (DiscreteGSet G) :=
  Types.jointlySurjectivePrecoverage.comap (forget G)

/-- The topology of `P(G)`, generated by the surjective families of `G`-maps. -/
def topology : GrothendieckTopology (DiscreteGSet G) :=
  (precoverage G).toGrothendieck

variable {G}

theorem mem_precoverage_iff {S : DiscreteGSet G} {R : Presieve S} :
    R ∈ precoverage G S ↔
      ∀ s : (forget G).obj S, ∃ (T : DiscreteGSet G) (f : T ⟶ S), R f ∧
        s ∈ Set.range ((forget G).map f) :=
  Presieve.mem_comap_jointlySurjectivePrecoverage_iff _

theorem ofArrows_mem_precoverage_iff {S : DiscreteGSet G} {ι : Type*} {T : ι → DiscreteGSet G}
    {f : ∀ i, T i ⟶ S} :
    Presieve.ofArrows T f ∈ precoverage G S ↔
      ∀ s : (forget G).obj S, ∃ i, s ∈ Set.range ((forget G).map (f i)) :=
  Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff _

/-- A surjective family generates a covering sieve of `P(G)`. -/
theorem generate_mem_topology {S : DiscreteGSet G} {R : Presieve S}
    (hR : R ∈ precoverage G S) : Sieve.generate R ∈ topology G S :=
  Precoverage.generate_mem_toGrothendieck hR

end DiscreteGSet

end Langlands
