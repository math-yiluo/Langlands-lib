import Langlands.Correspondence.Laumon.NearbySpecialization

/-!
# Constant base change of the strict target trait

For a finite extension of the constants inside the chosen geometric field, the two
arithmetic traits have a common pointed strict target. The chart comparisons over it
identify specialization and restrict the arithmetic Galois action.
-/

noncomputable section

universe u

open CategoryTheory Limits AlgebraicGeometry

open scoped CategoryTheory.Functor CategoryTheory.Obj

attribute [-instance] CategoryTheory.sfbRegularAbMonoidal CategoryTheory.sfbRegularAbSymmetric

attribute [local instance 20000] HasDerivedCategory.ofIsGrothendieckAbelian

set_option maxHeartbeats 80000

namespace Langlands.Henniart.Laumon

open AlgebraicGeometry.ProEtale AlgebraicGeometry.ProEtale.CondensedRing

variable {k : Type u} [Field k] (k₁ : Subfield (endGenericClosure k))

/-- The fraction field `K₁ = K' k₁` of the constant extension. -/
def constantExtensionField : IntermediateField (endField k) (endGenericClosure k) :=
  IntermediateField.adjoin (endField k) (k₁ : Set (endGenericClosure k))

/-- The ring `R₁ = R^nr ∩ K₁` of the constant extension trait. -/
def constantExtensionRing : Subring (endStrictRing k) :=
  (constantExtensionField k₁).toSubfield.toSubring.comap (strictGenericHom k)

theorem endStrictRingHom_mem_constantExtensionRing (r : endRing k) :
    endStrictRingHom k r ∈ constantExtensionRing k₁ :=
  (constantExtensionField k₁).algebraMap_mem ((r : endRing k) : endField k)

/-- The inclusion `R → R₁`. -/
def constantExtensionMap : endRing k →+* constantExtensionRing k₁ :=
  (endStrictRingHom k).codRestrict _ (endStrictRingHom_mem_constantExtensionRing k₁)

/-- The inclusion `R₁ → K₁`. -/
def constantExtensionGenericHom : constantExtensionRing k₁ →+* constantExtensionField k₁ :=
  ((strictGenericHom k).comp (constantExtensionRing k₁).subtype).codRestrict
    (constantExtensionField k₁).toSubfield fun x => x.property

/-- The inclusion of the extended constants into `R₁`. -/
def constantExtensionConstantsHom (hk₁ : k₁ ≤ endConstants k) :
    k₁ →+* constantExtensionRing k₁ :=
  ((strictConstantsHom k).comp (Subfield.inclusion hk₁)).codRestrict
    (constantExtensionRing k₁) fun c =>
      IntermediateField.subset_adjoin (endField k) (k₁ : Set (endGenericClosure k)) c.property

/-- The ideal generated by the image of `t` in `R₁`. -/
def constantExtensionMaximalIdeal : Ideal (constantExtensionRing k₁) :=
  Ideal.span {constantExtensionMap k₁ (endUniformizer k .zero)}

private def fractionPresentation {A F : Type u} [CommRing A] [Field F]
    (ι : A →+* F) : Prop :=
  ∀ z : F, ∃ a b : A, b ≠ 0 ∧ z = ι a / ι b

private def compositumEq {L : Type u} [Field L] (E F G : Set L) : Prop :=
  E = (Subfield.closure (F ∪ G) : Set L)

private def isIntegralClosureIn {A L : Type u} [CommRing A] [CommRing L]
    (i : A →+* L) (R : Subring L) : Prop :=
  ∀ x : L, x ∈ R ↔ i.IsIntegralElem x

private def contractsTo {A R : Type u} [CommRing A] [CommRing R]
    (ι : A →+* R) (I : Ideal R) (J : Ideal A) : Prop :=
  I.comap ι = J

/-- The henselian trait of the extended constants and its common strict target with `S`. -/
def ConstantExtensionTraitStatement [Finite k] [Finite k₁]
    (hk₁ : k₁ ≤ endConstants k) (_ : ∀ c : k, (endConstantsHom k c : endGenericClosure k) ∈ k₁) :
    Prop :=
  (∃ h : HenselianLocalRing (constantExtensionRing k₁),
    IsDiscreteValuationRing (constantExtensionRing k₁) ∧
      @IsLocalRing.maximalIdeal _ _ h.toIsLocalRing = constantExtensionMaximalIdeal k₁) ∧
  constantExtensionRing k₁ = Subring.closure
    (Set.range (endStrictRingHom k) ∪
      Set.range ((constantExtensionRing k₁).subtype.comp (constantExtensionConstantsHom k₁ hk₁))) ∧
  fractionPresentation (constantExtensionGenericHom k₁) ∧
  Function.Bijective ((Ideal.Quotient.mk (constantExtensionMaximalIdeal k₁)).comp
    (constantExtensionConstantsHom k₁ hk₁)) ∧
  contractsTo (constantExtensionRing k₁).subtype
    (strictMaximalIdeal k) (constantExtensionMaximalIdeal k₁) ∧
  compositumEq (L := endGenericClosure k)
    (endUnramifiedField k : Set (endGenericClosure k))
    (constantExtensionField (k := k) k₁ : Set (endGenericClosure k))
    (endConstants k : Set (endGenericClosure k)) ∧
  isIntegralClosureIn ((endStrictRing k).subtype.comp (constantExtensionRing k₁).subtype)
    (endStrictRing k) ∧
  IsOpen ((constantExtensionField k₁).fixingSubgroup : Set (Gal(endGenericClosure k/endField k))) ∧
  ∀ σ : Gal(endGenericClosure k/endField k),
    let ρ := (strictConstantsResidue k).comp (Subfield.inclusion hk₁)
    σ ∈ (constantExtensionField k₁).fixingSubgroup ↔ (strictResidueGalois σ).comp ρ = ρ

/-- An element of `Gal(Ω_s/K₁)` fixes the inclusion `R₁ → R^nr`. -/
theorem constantExtensionGalois_comp (σ : Gal(endGenericClosure k/endField k))
    (hσ : σ ∈ (constantExtensionField k₁).fixingSubgroup) :
    (strictRingGalois σ).comp (constantExtensionRing k₁).subtype =
      (constantExtensionRing k₁).subtype := by
  refine RingHom.ext fun x => ?_
  exact Subtype.ext (Subtype.ext (hσ (constantExtensionGenericHom k₁ x)))

theorem constantExtensionMap_comp :
    (constantExtensionRing k₁).subtype.comp (constantExtensionMap k₁) = endStrictRingHom k :=
  rfl

section ChartChange

variable {A₀ A₁ : Type u} [CommRing A₀] [CommRing A₁]
  (r : A₀ →+* A₁) {X : Scheme.{u}} (f : X ⟶ Spec (.of A₀))

/-- The chart after base change of the arithmetic target. -/
abbrev chartBaseChange : Scheme.{u} :=
  pullback f (Spec.map (CommRingCat.ofHom r))

/-- The projection of the changed chart to `X`. -/
def chartBaseChangeProjection : chartBaseChange r f ⟶ X :=
  pullback.fst _ _

/-- The structure map of the changed arithmetic chart. -/
abbrev chartBaseChangeMap : chartBaseChange r f ⟶ Spec (.of A₁) :=
  pullback.snd _ _

variable (ι₀ : A₀ →+* endStrictRing k) (ι₁ : A₁ →+* endStrictRing k) (h : ι₁.comp r = ι₀)

include h in
private theorem chartBaseChange_comp :
    Spec.map (CommRingCat.ofHom ι₁) ≫ Spec.map (CommRingCat.ofHom r) =
      Spec.map (CommRingCat.ofHom ι₀) :=
  (Spec.map_comp (CommRingCat.ofHom r) (CommRingCat.ofHom ι₁)).symm.trans
    (congrArg (fun i : A₀ →+* endStrictRing k => Spec.map (CommRingCat.ofHom i)) h)

/-- The identification of the two strict charts. -/
def strictChartBaseChangeIso :
    strictChart ι₁ (chartBaseChangeMap r f) ≅
      strictChart ι₀ f :=
  pullbackLeftPullbackSndIso f (Spec.map (CommRingCat.ofHom r))
      (Spec.map (CommRingCat.ofHom ι₁)) ≪≫
    pullback.congrHom rfl (chartBaseChange_comp r ι₀ ι₁ h)

theorem strictChartBaseChangeIso_hom_structure :
    (strictChartBaseChangeIso r f ι₀ ι₁ h).hom ≫ strictChartStructure ι₀ f =
      strictChartStructure ι₁ (chartBaseChangeMap r f) := by
  simp [strictChartBaseChangeIso, strictChartStructure, pullbackLeftPullbackSndIso_hom_snd]

theorem strictChartBaseChangeIso_hom_projection :
    (strictChartBaseChangeIso r f ι₀ ι₁ h).hom ≫ strictChartProjection ι₀ f =
      strictChartProjection ι₁ (chartBaseChangeMap r f) ≫
        chartBaseChangeProjection r f := by
  simp [strictChartBaseChangeIso, strictChartProjection, chartBaseChangeProjection,
    pullbackLeftPullbackSndIso_hom_fst]

theorem strictChartBaseChangeStructure_comm :
    strictChartStructure ι₁ (chartBaseChangeMap r f) ≫
        𝟙 (endStrictTrait k) =
      (strictChartBaseChangeIso r f ι₀ ι₁ h).hom ≫ strictChartStructure ι₀ f :=
  (Category.comp_id _).trans (strictChartBaseChangeIso_hom_structure r f ι₀ ι₁ h).symm

/-- On special fibres. -/
def strictChartBaseChangeSpecial :
    strictChartSpecial ι₁ (chartBaseChangeMap r f) ⟶
      strictChartSpecial ι₀ f :=
  pullback.map (strictChartStructure ι₁ (chartBaseChangeMap r f)) (strictTraitSpecialPoint k)
    (strictChartStructure ι₀ f) (strictTraitSpecialPoint k)
    (strictChartBaseChangeIso r f ι₀ ι₁ h).hom (𝟙 (Spec (.of (strictResidueRing k))))
    (𝟙 (endStrictTrait k)) (strictChartBaseChangeStructure_comm r f ι₀ ι₁ h)
    ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- On generic fibres over `K^nr`. -/
def strictChartBaseChangeStrictGeneric :
    strictChartGeneric ι₁ (chartBaseChangeMap r f) ⟶
      strictChartGeneric ι₀ f :=
  pullback.map (strictChartStructure ι₁ (chartBaseChangeMap r f)) (strictTraitGenericPoint k)
    (strictChartStructure ι₀ f) (strictTraitGenericPoint k)
    (strictChartBaseChangeIso r f ι₀ ι₁ h).hom (𝟙 (Spec (.of (endUnramifiedField k))))
    (𝟙 (endStrictTrait k)) (strictChartBaseChangeStructure_comm r f ι₀ ι₁ h)
    ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- On geometric generic fibres. -/
def strictChartBaseChangeGeneric :
    traitNearbyGeneric ι₁ (chartBaseChangeMap r f) ⟶
      traitNearbyGeneric ι₀ f :=
  pullback.map _ _ _ _ (strictChartBaseChangeStrictGeneric r f ι₀ ι₁ h)
    (𝟙 (Spec (.of (endGenericClosure k)))) (𝟙 (Spec (.of (endUnramifiedField k))))
    ((Category.comp_id _).trans ((pullback.lift_snd _ _ _).trans (Category.comp_id _)).symm)
    ((Category.comp_id _).trans (Category.id_comp _).symm)

theorem strictChartBaseChangeStrictGeneric_fst :
    strictChartBaseChangeStrictGeneric r f ι₀ ι₁ h ≫
        pullback.fst (strictChartStructure ι₀ f) (strictTraitGenericPoint k) =
      pullback.fst (strictChartStructure ι₁ (chartBaseChangeMap r f)) (strictTraitGenericPoint k) ≫
        (strictChartBaseChangeIso r f ι₀ ι₁ h).hom :=
  pullback.lift_fst _ _ _

theorem strictChartBaseChangeGeneric_fst :
    strictChartBaseChangeGeneric r f ι₀ ι₁ h ≫
        pullback.fst (strictChartGenericPoint ι₀ f)
          (Spec.map (CommRingCat.ofHom (algebraMap (endUnramifiedField k) (endGenericClosure k)))) =
      pullback.fst (strictChartGenericPoint ι₁ (chartBaseChangeMap r f))
          (Spec.map (CommRingCat.ofHom (algebraMap (endUnramifiedField k) (endGenericClosure k)))) ≫
        strictChartBaseChangeStrictGeneric r f ι₀ ι₁ h :=
  pullback.lift_fst _ _ _

theorem strictChartBaseChangeGeneric_comm :
    strictChartBaseChangeGeneric r f ι₀ ι₁ h ≫ (traitNearbyModel ι₀ f).j =
      (traitNearbyModel ι₁ (chartBaseChangeMap r f)).j ≫
        (strictChartBaseChangeIso r f ι₀ ι₁ h).hom := by
  let η := Spec.map (CommRingCat.ofHom (algebraMap (endUnramifiedField k) (endGenericClosure k)))
  let b := strictChartBaseChangeStrictGeneric r f ι₀ ι₁ h
  have genericSquare : CommSq (strictChartBaseChangeGeneric r f ι₀ ι₁ h)
      (pullback.fst (strictChartGenericPoint ι₁ (chartBaseChangeMap r f)) η)
      (pullback.fst (strictChartGenericPoint ι₀ f) η) b :=
    ⟨strictChartBaseChangeGeneric_fst r f ι₀ ι₁ h⟩
  have strictSquare : CommSq b
      (pullback.fst (strictChartStructure ι₁ (chartBaseChangeMap r f)) (strictTraitGenericPoint k))
      (pullback.fst (strictChartStructure ι₀ f) (strictTraitGenericPoint k))
      (strictChartBaseChangeIso r f ι₀ ι₁ h).hom :=
    ⟨strictChartBaseChangeStrictGeneric_fst r f ι₀ ι₁ h⟩
  exact (genericSquare.vert_comp strictSquare).w

/-- The identification of the two nearby-cycles models. -/
def strictChartBaseChangeModelHom :
    (traitNearbyModel ι₁ (chartBaseChangeMap r f)).Hom
      (traitNearbyModel ι₀ f) (strictChartBaseChangeIso r f ι₀ ι₁ h).hom
      (strictChartBaseChangeSpecial r f ι₀ ι₁ h) where
  total := (strictChartBaseChangeIso r f ι₀ ι₁ h).hom
  generic := strictChartBaseChangeGeneric r f ι₀ ι₁ h
  comm_j := strictChartBaseChangeGeneric_comm r f ι₀ ι₁ h
  comm_i := pullback.lift_fst _ _ _
  comm_ε := strictChartBaseChangeGeneric_comm r f ι₀ ι₁ h

private theorem strictChartBaseChangeInputSquare : CommSq
    (strictChartProjection ι₁ (chartBaseChangeMap r f))
    (strictChartBaseChangeIso r f ι₀ ι₁ h).hom (chartBaseChangeProjection r f)
    (strictChartProjection ι₀ f) :=
  ⟨(strictChartBaseChangeIso_hom_projection r f ι₀ ι₁ h).symm⟩

section Complexes

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]

private abbrev CoefficientDerivedCategory (Y : Scheme.{u}) :=
  DerivedCategory (CategoryTheory.Mod (Sheaf (Scheme.ProEt.topology Y) Ab.{u + 1})
    (condensedRingObj Λ Y))

private abbrev derivedPullback {Y Z : Scheme.{u}} (g : Y ⟶ Z) :
    CoefficientDerivedCategory Λ Z ⥤ CoefficientDerivedCategory Λ Y :=
  L((g)^*⟦Λ⟧)

private def inputComparison {Y₁ Y₀ Z₁ Z₀ : Scheme.{u}}
    {g₁ : Y₁ ⟶ Y₀} {p₁ : Y₁ ⟶ Z₁} {p₀ : Y₀ ⟶ Z₀} {g₀ : Z₁ ⟶ Z₀}
    (sq : CommSq g₁ p₁ p₀ g₀) (K : CoefficientDerivedCategory Λ Z₀) :
    (derivedPullback Λ p₁).obj ((derivedPullback Λ g₀).obj K) ≅
      (derivedPullback Λ g₁).obj ((derivedPullback Λ p₀).obj K) :=
  (pullbackSquareComparison Λ sq).app K

private def nearbyInputComparison {T₁ T₀ Y₁ Y₀ : Scheme.{u}}
    {M : NearbyCyclesModel T₁ Y₁} {N : NearbyCyclesModel T₀ Y₀}
    {a : T₁ ⟶ T₀} {b : Y₁ ⟶ Y₀} (φ : M.Hom N a b)
    {K₀ : CoefficientDerivedCategory Λ T₀} {K₁ : CoefficientDerivedCategory Λ T₁}
    (e : (derivedPullback Λ a).obj K₀ ≅ K₁) :
    (derivedPullback Λ b).obj ((N.nearbyCycles Λ).obj K₀) ⟶ (M.nearbyCycles Λ).obj K₁ :=
  (φ.pullbackExchange Λ).app K₀ ≫ (M.nearbyCycles Λ).map e.hom

private def specialInputComparison {T₁ T₀ Y₁ Y₀ : Scheme.{u}}
    {i₁ : Y₁ ⟶ T₁} {i₀ : Y₀ ⟶ T₀}
    {a : T₁ ⟶ T₀} {b : Y₁ ⟶ Y₀} (sq : CommSq i₁ b a i₀)
    {K₀ : CoefficientDerivedCategory Λ T₀} {K₁ : CoefficientDerivedCategory Λ T₁}
    (e : (derivedPullback Λ a).obj K₀ ≅ K₁) :
    (derivedPullback Λ b).obj ((derivedPullback Λ i₀).obj K₀) ⟶
      (derivedPullback Λ i₁).obj K₁ :=
  (inputComparison Λ sq K₀).hom ≫ (derivedPullback Λ i₁).map e.hom

variable (B : CoefficientDerivedCategory Λ X)

/-- The input on the arithmetic chart after constant extension. -/
abbrev chartBaseChangePullback : CoefficientDerivedCategory Λ (chartBaseChange r f) :=
  (derivedPullback Λ (chartBaseChangeProjection r f)).obj B

private abbrev originalInput :=
  strictChartPullback Λ ι₀ f B

private abbrev extendedInput :=
  strictChartPullback Λ ι₁ (chartBaseChangeMap r f)
    (chartBaseChangePullback r f Λ B)

/-- The pullbacks of the arithmetic input along the two factorizations of `X₁^nr → X`. -/
def strictChartBaseChangeInputIso :=
  inputComparison Λ (strictChartBaseChangeInputSquare r f ι₀ ι₁ h) B

/-- Pullback exchange for the constant extension, followed by the input identification. -/
def strictChartBaseChangeNearby :=
  nearbyInputComparison Λ (strictChartBaseChangeModelHom r f ι₀ ι₁ h)
    (K₀ := originalInput f ι₀ Λ B) (K₁ := extendedInput r f ι₁ Λ B)
    (strictChartBaseChangeInputIso r f ι₀ ι₁ h Λ B)

/-- The comparison on the special restriction of the strict input. -/
def strictChartBaseChangeSpecialRestriction :=
  let sq : CommSq
      (pullback.fst (strictChartStructure ι₁ (chartBaseChangeMap r f)) (strictTraitSpecialPoint k))
      (strictChartBaseChangeSpecial r f ι₀ ι₁ h)
      (strictChartBaseChangeIso r f ι₀ ι₁ h).hom
      (pullback.fst (strictChartStructure ι₀ f) (strictTraitSpecialPoint k)) :=
    ⟨(pullback.lift_fst _ _ _).symm⟩
  specialInputComparison Λ sq
    (K₀ := originalInput f ι₀ Λ B) (K₁ := extendedInput r f ι₁ Λ B)
    (strictChartBaseChangeInputIso r f ι₀ ι₁ h Λ B)

private def exchangeIsIso {T₁ T₀ Y₁ Y₀ : Scheme.{u}}
    {M : NearbyCyclesModel T₁ Y₁} {N : NearbyCyclesModel T₀ Y₀}
    {a : T₁ ⟶ T₀} {b : Y₁ ⟶ Y₀} (φ : M.Hom N a b) : Prop :=
  IsIso (φ.pullbackExchange Λ)

private def specializationSquare {Y₁ Y₀ : Scheme.{u}} (b : Y₁ ⟶ Y₀)
    {Q₁ P₁ : CoefficientDerivedCategory Λ Y₁} {Q₀ P₀ : CoefficientDerivedCategory Λ Y₀}
    (sp₁ : Q₁ ⟶ P₁) (sp₀ : Q₀ ⟶ P₀)
    (special : (derivedPullback Λ b).obj Q₀ ⟶ Q₁)
    (nearby : (derivedPullback Λ b).obj P₀ ⟶ P₁) : Prop :=
  IsIso special ∧ IsIso nearby ∧
    (derivedPullback Λ b).map sp₀ ≫ nearby = special ≫ sp₁

/-- The fibre and nearby-cycles comparisons identify the two specialization arrows. -/
def StrictChartBaseChangeSpecializationStatement : Prop :=
  IsIso (strictChartBaseChangeSpecial r f ι₀ ι₁ h) ∧
  IsIso (strictChartBaseChangeStrictGeneric r f ι₀ ι₁ h) ∧
  IsIso (strictChartBaseChangeGeneric r f ι₀ ι₁ h) ∧
  exchangeIsIso Λ (strictChartBaseChangeModelHom r f ι₀ ι₁ h) ∧
  specializationSquare Λ (strictChartBaseChangeSpecial r f ι₀ ι₁ h)
    (nearbySpecialization (ι := ι₁) Λ
      (chartBaseChangeMap r f) (chartBaseChangePullback r f Λ B))
    (nearbySpecialization (ι := ι₀) Λ f B)
    (strictChartBaseChangeSpecialRestriction r f ι₀ ι₁ h Λ B)
    (strictChartBaseChangeNearby r f ι₀ ι₁ h Λ B)

private def pullbackActionSquare {Y₁ Y₀ : Scheme.{u}} (b : Y₁ ⟶ Y₀)
    (a₁ : Y₁ ⟶ Y₁) (a₀ : Y₀ ⟶ Y₀)
    {P₁ : CoefficientDerivedCategory Λ Y₁} {P₀ : CoefficientDerivedCategory Λ Y₀}
    (action₁ : (derivedPullback Λ a₁).obj P₁ ⟶ P₁)
    (action₀ : (derivedPullback Λ a₀).obj P₀ ⟶ P₀)
    (comparison : (derivedPullback Λ b).obj P₀ ⟶ P₁) : Prop :=
  ∃ sq : CommSq b a₁ a₀ b,
    (derivedPullback Λ a₁).map comparison ≫ action₁ =
      (pullbackSquareComparison Λ sq).hom.app P₀ ≫
        (derivedPullback Λ b).map action₀ ≫ comparison

private def intertwines {Y₁ Y₀ : Scheme.{u}} (b : Y₁ ⟶ Y₀)
    (a₁ : Y₁ ⟶ Y₁) (a₀ : Y₀ ⟶ Y₀) : Prop :=
  a₁ ≫ b = b ≫ a₀

/-- The chart comparisons intertwine the model and nearby-cycles actions. -/
def StrictChartBaseChangeGaloisCompatibility (σ : Gal(endGenericClosure k/endField k))
    (h₀ : (strictRingGalois σ).comp ι₀ = ι₀) (h₁ : (strictRingGalois σ).comp ι₁ = ι₁) : Prop :=
  let f₁ := chartBaseChangeMap r f
  let b := strictChartBaseChangeSpecial r f ι₀ ι₁ h
  let a₁ := strictChartSpecialGalois (ι := ι₁) f₁ σ h₁
  let a₀ := strictChartSpecialGalois (ι := ι₀) f σ h₀
  intertwines (strictChartBaseChangeIso r f ι₀ ι₁ h).hom
    (strictChartGalois (ι := ι₁) f₁ σ h₁) (strictChartGalois (ι := ι₀) f σ h₀) ∧
  intertwines (strictChartBaseChangeGeneric r f ι₀ ι₁ h)
    (traitNearbyGenericGalois (ι := ι₁) f₁ σ h₁) (traitNearbyGenericGalois (ι := ι₀) f σ h₀) ∧
  pullbackActionSquare Λ b a₁ a₀
    (P₁ := chartNearbyCycles Λ ι₁ f₁ (chartBaseChangePullback r f Λ B))
    (P₀ := chartNearbyCycles Λ ι₀ f B)
    (nearbyCyclesAction (ι := ι₁) Λ f₁ (chartBaseChangePullback r f Λ B) σ h₁)
    (nearbyCyclesAction (ι := ι₀) Λ f B σ h₀)
    (strictChartBaseChangeNearby r f ι₀ ι₁ h Λ B)

end Complexes

end ChartChange

/-- Constant extension inside the fixed geometric constants preserves the pointed strict
target, the nearby-cycles diagram and specialization, and restricts the action to the
open subgroup over the extended generic field. -/
def StrictTraitConstantBaseChangeStatement : Prop :=
  ∀ (k : Type u) [Field k] [Finite k] (k₁ : Subfield (endGenericClosure k)) [Finite k₁]
    (hk₁ : k₁ ≤ endConstants k) (hk : ∀ c : k, (endConstantsHom k c : endGenericClosure k) ∈ k₁),
    ConstantExtensionTraitStatement k₁ hk₁ hk ∧
    ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of (endRing k)))
      (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]
      (B : CoefficientDerivedCategory Λ X),
      StrictChartBaseChangeSpecializationStatement (constantExtensionMap k₁) f (endStrictRingHom k)
        (constantExtensionRing k₁).subtype (constantExtensionMap_comp k₁) Λ B ∧
      ∀ (σ : Gal(endGenericClosure k/endField k)) (hσ : σ ∈ (constantExtensionField k₁).fixingSubgroup),
        StrictChartBaseChangeGaloisCompatibility (constantExtensionMap k₁) f (endStrictRingHom k)
          (constantExtensionRing k₁).subtype (constantExtensionMap_comp k₁) Λ B σ
          (strictRingGalois_comp_endStrictRingHom σ) (constantExtensionGalois_comp k₁ σ hσ)

end Langlands.Henniart.Laumon
