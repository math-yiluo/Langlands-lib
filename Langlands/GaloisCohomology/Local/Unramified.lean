import Langlands.GaloisCohomology.Local.Duality.Main
import Langlands.Weil.Local.Assembly
import Langlands.Cohomology.Profinite.Dimension.Procyclic
import Langlands.Cohomology.Profinite.InflationRestriction.DegreeOne
import Langlands.Cohomology.Profinite.TorsionDual
import Mathlib.Topology.Algebra.Category.ProfiniteGrp.Completion

/-!
# Unramified classes and their orthogonality

For a nonarchimedean local field `K` with separable closure `Ksep` and the inertia subgroup
`I ⊆ G = Gal(Ksep/K)` (the Library's `LocalGalois.SepClosed.absoluteInertia`), the unramified
classes of a smooth module `M` are the classes of `H¹(G, M)` that vanish on `I`. The quotient `G/I`
is procyclic, topologically generated by a Frobenius (it is the profinite completion of `ℤ`
through the Library's `Weil.localResidueDegree`), so:

- `card_unramifiedClasses`: for finite `M`, the unramified classes are as many as the invariants
  `M^G` (inflation–restriction and `|H¹(Ẑ, A)| = |A^Ẑ|`);
- `cupPairing_eq_zero_of_mem_unramifiedClasses`: the cup product of two unramified classes vanishes
  (it is inflated from `H²(G/I, ·)` with finite coefficients, which is zero);
- `mem_unramifiedClasses_cartierDual_iff`: for `|M|` prime to the residue characteristic, the
  unramified classes of the Cartier dual `M'` are exactly the orthogonal complement of those of
  `M` under the local Tate pairing (counting with the Euler characteristic and duality).
-/

noncomputable section

open CategoryTheory

universe u

namespace Langlands.ProfiniteCohomology

section Generator

variable {G H : Type*} [Group G] [TopologicalSpace G] [Group H] [TopologicalSpace H]

open Langlands.Weil in
/-- The image of `1` is a `Ẑ`-generator of the profinite completion of `ℤ`. -/
theorem isZHatGenerator_frobenius_one :
    IsZHatGenerator (frobenius (Multiplicative.ofAdd (1 : ℤ))) := by
  refine ⟨?_, fun n hn => ?_⟩
  · refine (ProfiniteGrp.ProfiniteCompletion.denseRange (GrpCat.of Degree)).mono ?_
    rintro _ ⟨x, rfl⟩
    refine ⟨Multiplicative.toAdd (α := ℤ) x, ?_⟩
    change frobenius (Multiplicative.ofAdd (1 : ℤ)) ^ (Multiplicative.toAdd (α := ℤ) x) =
      frobenius x
    rw [← map_zpow]
    congr 1
    apply Multiplicative.toAdd.injective
    simp
  · have : NeZero n := ⟨hn.ne'⟩
    let P : ProfiniteGrp.{0} := ProfiniteGrp.ofFiniteGrp (FiniteGrp.of (Multiplicative (ZMod n)))
    let f : GrpCat.of Degree ⟶ GrpCat.of P :=
      GrpCat.ofHom (Int.castAddHom (ZMod n)).toMultiplicative
    let L := ProfiniteGrp.ProfiniteCompletion.lift f
    refine ⟨L.hom.toMonoidHom, ?_, ?_⟩
    · have hc : Continuous L.hom := L.hom.continuous_toFun
      have : DiscreteTopology P := ⟨rfl⟩
      have hopen : IsOpen ((L.hom : ProfiniteIntegers → P) ⁻¹' {1}) :=
        hc.isOpen_preimage _ (isOpen_discrete _)
      convert hopen using 1
      ext x
      exact MonoidHom.mem_ker
    · have h := ProfiniteGrp.ProfiniteCompletion.lift_eta f
      have h1 := congrArg (fun g => g.hom (Multiplicative.ofAdd (1 : ℤ))) h
      simp only at h1
      change L.hom (frobenius (Multiplicative.ofAdd (1 : ℤ))) = _
      refine Eq.trans ?_ (h1.trans ?_)
      · rfl
      · change (Int.castAddHom (ZMod n)).toMultiplicative (Multiplicative.ofAdd 1) = _
        simp

end Generator



end Langlands.ProfiniteCohomology

namespace Langlands.GaloisCohomology.Local

open Langlands.ProfiniteCohomology ClassFieldTheory.Local ValuativeRel

section Inertia

variable (K Ksep : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field Ksep] [Algebra K Ksep] [IsSepClosure K Ksep]

/-- The inertia subgroup of `Gal(Ksep/K)`: the Library's `absoluteInertia`, the kernel of the
action on the residue field of `Ksep`. -/
abbrev inertia : Subgroup Gal(Ksep/K) :=
  LocalGalois.SepClosed.absoluteInertia K Ksep

/-- `Gal(Ksep/K)/I` is procyclic: it has a `Ẑ`-generator (the image of a Frobenius), through the
Library's residue degree `Gal(Ksep/K) → Ẑ`. -/
theorem exists_isZHatGenerator_inertia :
    ∃ σ : Gal(Ksep/K) ⧸ inertia K Ksep, IsZHatGenerator σ := by
  have : IsSepClosed Ksep := IsSepClosure.sep_closed K
  set d := Weil.Local.SepClosed.localResidueDegree K Ksep
  have hker : d.toMonoidHom.ker = inertia K Ksep := Weil.Local.SepClosed.localResidueDegree_ker K Ksep
  have hsurj : Function.Surjective d := Weil.Local.SepClosed.localResidueDegree_surjective K Ksep
  let e : Gal(Ksep/K) ⧸ inertia K Ksep →* Weil.ProfiniteIntegers :=
    QuotientGroup.lift _ d.toMonoidHom hker.ge
  have hinj : Function.Injective e := by
    rw [injective_iff_map_eq_one]
    intro q hq
    induction q using QuotientGroup.induction_on with
    | H g =>
      rw [QuotientGroup.eq_one_iff, ← hker]
      exact hq
  have hsurj' : Function.Surjective e := fun z => by
    obtain ⟨g, hg⟩ := hsurj z
    exact ⟨g, hg⟩
  have hcont : Continuous e :=
    (QuotientGroup.isQuotientMap_mk _).continuous_iff.2 d.continuous_toFun
  let E₀ := MulEquiv.ofBijective e ⟨hinj, hsurj'⟩
  let h := Continuous.homeoOfEquivCompactToT2 (f := E₀.toEquiv) hcont
  let E : (Gal(Ksep/K) ⧸ inertia K Ksep) ≃ₜ* Weil.ProfiniteIntegers :=
    { E₀ with
      continuous_toFun := hcont
      continuous_invFun := h.symm.continuous }
  exact ⟨E.symm (Weil.frobenius (Multiplicative.ofAdd (1 : ℤ))),
    isZHatGenerator_frobenius_one.map_continuousMulEquiv E.symm⟩

/-- The unramified classes of a smooth module `M`: the classes of `H¹(Gal(Ksep/K), M)` whose
restriction to the inertia subgroup vanishes. -/
def unramifiedClasses (M : Rep IntegerScalars.{u} Gal(Ksep/K)) [IsSmoothRep M] :
    AddSubgroup (cohomology M 1) :=
  (LinearMap.ker (res M (inertia K Ksep) 1).hom).toAddSubgroup

theorem mem_unramifiedClasses_iff (M : Rep IntegerScalars.{u} Gal(Ksep/K)) [IsSmoothRep M]
    (x : cohomology M 1) :
    x ∈ unramifiedClasses K Ksep M ↔ (res M (inertia K Ksep) 1).hom x = 0 :=
  Iff.rfl

/-- For finite `M`, there are as many unramified classes as invariants `M^G`. -/
theorem card_unramifiedClasses (M : Rep IntegerScalars.{u} Gal(Ksep/K)) [IsSmoothRep M]
    [Finite M] : Nat.card (unramifiedClasses K Ksep M) = Nat.card M.ρ.invariants := by
  obtain ⟨σ, hσ⟩ := exists_isZHatGenerator_inertia K Ksep
  have : Finite (M.quotientToInvariants (inertia K Ksep)) :=
    Finite.of_injective (fun x : M.quotientToInvariants (inertia K Ksep) => (x : M))
      Subtype.val_injective
  change Nat.card (LinearMap.ker (res M (inertia K Ksep) 1).hom) = _
  rw [card_ker_res_one, card_cohomology_one_eq_card_invariants hσ,
    Nat.card_congr (invariantsQuotientEquiv M (inertia K Ksep))]

end Inertia

section Orthogonality

open MonoidalCategory

variable {K Ksep : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field Ksep] [Algebra K Ksep] [IsSepClosure K Ksep]

attribute [-instance] ULift.module in
/-- The cup product of two unramified classes vanishes: both are inflated from `G/I`, and
`H²(G/I, ·)` vanishes on finite modules (`G/I` is procyclic). -/
theorem cupPairing_eq_zero_of_mem_unramifiedClasses (M N P : Rep IntegerScalars.{u} Gal(Ksep/K))
    [IsSmoothRep M] [IsSmoothRep N] [IsSmoothRep P] [Finite M] (μ : M ⊗ N ⟶ P)
    {x : cohomology M 1} (hx : x ∈ unramifiedClasses K Ksep M)
    {y : cohomology N 1} (hy : y ∈ unramifiedClasses K Ksep N) :
    cupPairing μ (show 1 + 1 = 2 from rfl) x y = 0 := by
  obtain ⟨σ, hσ⟩ := exists_isZHatGenerator_inertia K Ksep
  obtain ⟨x', rfl⟩ := exists_infl_one_eq M (inertia K Ksep) x hx
  obtain ⟨y', rfl⟩ := exists_infl_one_eq N (inertia K Ksep) y hy
  have htors : IsAddTorsion ((M.quotientToInvariants (inertia K Ksep) ⊗
      N.quotientToInvariants (inertia K Ksep) :
        Rep IntegerScalars.{u} (Gal(Ksep/K) ⧸ inertia K Ksep)) : Type u) := fun t => by
    refine isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨Nat.card M, Nat.card_pos, ?_⟩
    have hA : ∀ a : M.quotientToInvariants (inertia K Ksep), Nat.card M • a = 0 := fun a => by
      apply Subtype.ext
      change Nat.card M • (a : M) = 0
      exact card_nsmul_eq_zero'
    induction t using TensorProduct.inductionOn with
    | tmul a b =>
      have key : ∀ m : ℕ, m • (a ⊗ₜ[IntegerScalars.{u}] b) = (m • a) ⊗ₜ b := by
        intro m
        induction m with
        | zero => rw [zero_smul, zero_smul, TensorProduct.zero_tmul]
        | succ m ih => rw [succ_nsmul, ih, succ_nsmul, TensorProduct.add_tmul]
      exact (key _).trans (by rw [hA, TensorProduct.zero_tmul])
    | add x y hx hy => exact (smul_add _ x y).trans (by rw [hx, hy, add_zero])
  have hz : cup (show 1 + 1 = 2 from rfl) x' y' = 0 :=
    (ModuleCat.subsingleton_of_isZero (hσ.isZero_cohomology_two _ htors)).elim _ _
  rw [cupPairing_apply, infl_eq, infl_eq]
  erw [← map_resTensorHom_cup]
  rw [hz, map_zero, map_zero]

/-- Unramified classes of `M` and of its Cartier dual are orthogonal under the Tate pairing. -/
theorem tatePairing_eq_zero_of_mem_unramifiedClasses (M : Rep IntegerScalars.{u} Gal(Ksep/K))
    [IsSmoothRep M] [Finite M] {x : cohomology M 1} (hx : x ∈ unramifiedClasses K Ksep M)
    {y : cohomology (cartierDual K Ksep M) 1}
    (hy : y ∈ unramifiedClasses K Ksep (cartierDual K Ksep M)) :
    tatePairing K Ksep M (show 1 + 1 = 2 from rfl) x y = 0 := by
  rw [tatePairing_apply, cupPairing_eq_zero_of_mem_unramifiedClasses _ _ _ _ hx hy, map_zero]

/-- **Orthogonality of unramified classes.** For a finite smooth module `M` of order prime to the
residue characteristic, a class of `H¹(M')` (`M'` the Cartier dual) is unramified if and only if it
is orthogonal to all unramified classes of `M` under the local Tate pairing. -/
theorem mem_unramifiedClasses_cartierDual_iff (M : Rep IntegerScalars.{u} Gal(Ksep/K))
    [IsSmoothRep M] [Finite M] (hM : (Nat.card M).Coprime (ringChar 𝓀[K]))
    (y : cohomology (cartierDual K Ksep M) 1) :
    y ∈ unramifiedClasses K Ksep (cartierDual K Ksep M) ↔
      ∀ x ∈ unramifiedClasses K Ksep M, tatePairing K Ksep M (show 1 + 1 = 2 from rfl) x y = 0 := by
  refine ⟨fun hy x hx => tatePairing_eq_zero_of_mem_unramifiedClasses M hx hy, fun hy => ?_⟩
  have hk : (Nat.card M : 𝓀[K]) ≠ 0 := by
    rw [Ne, ringChar.spec]
    intro hdvd
    exact CharP.ringChar_ne_one (Nat.Coprime.eq_one_of_dvd (Nat.Coprime.symm hM) hdvd)
  have hK : (Nat.card M : K) ≠ 0 := natCast_ne_zero_of_residueField hk
  set M' := cartierDual K Ksep M
  set P := tatePairing K Ksep M (show 1 + 1 = 2 from rfl)
  have hfin : ∀ r, Finite (cohomology M r) := finite_cohomology K Ksep M hK
  have hfin' : ∀ r, Finite (cohomology M' r) := finite_cohomology_cartierDual M hK
  -- the annihilator of the unramified classes of `M`
  let A : AddSubgroup (cohomology M' 1) :=
    { carrier := {y | ∀ x ∈ unramifiedClasses K Ksep M, P x y = 0}
      add_mem' := fun ha hb x hx => by rw [map_add, ha x hx, hb x hx, add_zero]
      zero_mem' := fun x _ => map_zero (P x)
      neg_mem' := fun ha x hx => by rw [map_neg, ha x hx, neg_zero] }
  have hle : unramifiedClasses K Ksep M' ≤ A := fun y hy x hx =>
    tatePairing_eq_zero_of_mem_unramifiedClasses M hx hy
  -- cardinalities
  have hA : Nat.card A * Nat.card (unramifiedClasses K Ksep M) = Nat.card (cohomology M 1) :=
    card_annihilator_mul_card P (tatePairing_flip_bijective K Ksep M hK _) _
  have hU : Nat.card (unramifiedClasses K Ksep M) = Nat.card (cohomology M 0) := by
    rw [card_unramifiedClasses, Nat.card_congr (zeroIso M).toLinearEquiv.toEquiv]
  have hU' : Nat.card (unramifiedClasses K Ksep M') = Nat.card (cohomology M' 0) := by
    rw [card_unramifiedClasses, Nat.card_congr (zeroIso M').toLinearEquiv.toEquiv]
  have h2 : Nat.card (cohomology M 2) = Nat.card (cohomology M' 0) := by
    rw [Nat.card_congr (Equiv.ofBijective _ (tatePairing_bijective K Ksep M hK
      (show 2 + 0 = 2 from rfl))), card_addMonoidHom_rationalModIntegers]
  have h1 : Nat.card (cohomology M 1) =
      Nat.card (cohomology M 0) * Nat.card (cohomology M 2) := by
    rw [card_cohomology_one K Ksep M hK, card_quotient_span_natCast_eq_one hk, mul_one]
  have hpos : 0 < Nat.card (cohomology M 0) := by
    have := hfin 0
    exact Nat.card_pos
  have hcard : Nat.card A = Nat.card (unramifiedClasses K Ksep M') := by
    rw [hU, h1, mul_comm] at hA
    rw [hU', ← h2]
    exact Nat.eq_of_mul_eq_mul_left hpos hA
  have : Finite A := Finite.of_injective _ Subtype.val_injective
  have heq : unramifiedClasses K Ksep M' = A :=
    AddSubgroup.eq_of_le_of_card_ge hle hcard.le
  rw [heq]
  exact hy

end Orthogonality

end Langlands.GaloisCohomology.Local

namespace Langlands.GaloisCohomology

open CategoryTheory Langlands.ProfiniteCohomology

noncomputable section

section Local

open ClassFieldTheory.Local

variable {K Ksep : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field Ksep] [Algebra K Ksep] [IsSepClosure K Ksep]

/-- A coefficient map sends unramified classes to unramified classes. -/
theorem coeffMap_mem_unramifiedClasses {A B : Rep IntegerScalars.{u} Gal(Ksep/K)} [IsSmoothRep A]
    [IsSmoothRep B] (f : A ⟶ B) {x : cohomology A 1} (hx : x ∈ Local.unramifiedClasses K Ksep A) :
    (coeffMap f 1).hom x ∈ Local.unramifiedClasses K Ksep B := by
  rw [Local.mem_unramifiedClasses_iff] at hx ⊢
  have h := congrArg (fun F => F.hom x) (res_naturality A f (Local.inertia K Ksep) 1)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  rw [coeffMap_eq, h, hx, map_zero]

/-- An isomorphism of coefficients identifies the unramified classes. -/
theorem coeffMap_mem_unramifiedClasses_iff {A B : Rep IntegerScalars.{u} Gal(Ksep/K)}
    [IsSmoothRep A] [IsSmoothRep B] (e : A ≅ B) (x : cohomology A 1) :
    (coeffMap e.hom 1).hom x ∈ Local.unramifiedClasses K Ksep B ↔
      x ∈ Local.unramifiedClasses K Ksep A := by
  refine ⟨fun h => ?_, coeffMap_mem_unramifiedClasses e.hom⟩
  have h' := coeffMap_mem_unramifiedClasses e.inv h
  rwa [← ModuleCat.comp_apply, ← coeffMap_comp, e.hom_inv_id, coeffMap_id] at h'

end Local

end

end Langlands.GaloisCohomology
