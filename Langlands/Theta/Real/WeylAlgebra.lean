import Langlands.Theta.Real.SchrodingerDeriv
import Mathlib.Analysis.CStarAlgebra.Module.Constructions
import Mathlib.Analysis.Distribution.SchwartzSpace.Fourier
import Mathlib.Analysis.Normed.Module.HahnBanach
import Mathlib.LinearAlgebra.Matrix.FiniteDimensional

/-!
# The Weyl algebra and the `L²` control of Schwartz seminorms

`weylAlgebra l` is the algebra of operators on `𝓢(ℝˡ, ℂ)` generated by the derived Schrödinger
operators (`∂ⱼ` and multiplication by `xⱼ`, up to constants). Every Schwartz seminorm is bounded
by a finite sum of `L²` norms of images under elements of the Weyl algebra
(`exists_seminorm_le_sum_norm_toLp`): `sup |x^k D^n f|` is controlled by the `L¹` norm of the Fourier
transform of `(1 + |x|²)^N` times derivatives of `f`, hence by an `L²` norm. Consequently every
continuous linear functional on Schwartz space factors through finitely many maps
`f ↦ (A f) ∈ L²`, `A` in the Weyl algebra (`exists_factor_through_toLp`).
-/

noncomputable section

open MeasureTheory Complex SchwartzMap LineDeriv Matrix
open scoped Real RealInnerProductSpace ContDiff FourierTransform

namespace Langlands.Theta

open Langlands.Theta.Real.Internal

variable {l : Type} [Fintype l]

namespace Real

/-- The Weyl algebra: the subalgebra of operators on Schwartz space generated by the derived
Schrödinger operators `schrodingerDeriv w`. -/
def weylAlgebra (l : Type) [Fintype l] : Subalgebra ℂ (RealSchwartz l →L[ℂ] RealSchwartz l) := Algebra.adjoin ℂ (Set.range schrodingerDeriv)

/-- The derived Schrödinger operators lie in the Weyl algebra. -/
theorem schrodingerDeriv_mem_weylAlgebra (w : l ⊕ l → ℝ) : schrodingerDeriv w ∈ weylAlgebra l := Algebra.subset_adjoin ⟨w, rfl⟩

/-- Induction over the Weyl algebra: a property of `1`, stable under right multiplication by the
generators, sums and scalar multiples holds on the whole algebra. -/
theorem weylAlgebra_induction {P : (RealSchwartz l →L[ℂ] RealSchwartz l) → Prop} (h1 : P 1)
    (hmul : ∀ A w, P A → P (A * schrodingerDeriv w)) (h0 : P 0) (hadd : ∀ A B, P A → P B → P (A + B))
    (hsmul : ∀ (c : ℂ) A, P A → P (c • A)) {A : RealSchwartz l →L[ℂ] RealSchwartz l} (hA : A ∈ weylAlgebra l) : P A := by
  have h : A ∈ Submodule.span ℂ (Submonoid.closure (Set.range (schrodingerDeriv (l := l))) : Set (RealSchwartz l →L[ℂ] RealSchwartz l)) := by
    rw [← Algebra.adjoin_eq_span]; exact hA
  refine Submodule.span_induction (p := fun A _ => P A) (fun B hB => ?_) h0 (fun A B _ _ => hadd A B)
    (fun c A _ => hsmul c A) h
  refine Submonoid.closure_induction_right (motive := fun A _ => P A) h1 ?_ hB
  rintro A _ _ ⟨w, rfl⟩ hA
  exact hmul A w hA

/-- Directional derivatives lie in the Weyl algebra. -/
theorem lineDerivOp_mem_weylAlgebra (v : EuclideanSpace ℝ l) : lineDerivOpCLM ℂ (RealSchwartz l) v ∈ weylAlgebra l := by
  have : lineDerivOpCLM ℂ (RealSchwartz l) v = schrodingerDeriv (Sum.elim (fun i => v i) 0) := by
    ext f x
    have h1 : translationPart (Sum.elim (fun i => v i) 0 : l ⊕ l → ℝ) = v := rfl
    have h2 : modulationPart (Sum.elim (fun i => v i) 0 : l ⊕ l → ℝ) = 0 := rfl
    simp [schrodingerDeriv_apply, h1, h2, lineDerivOp_apply_eq_fderiv]
  rw [this]; exact schrodingerDeriv_mem_weylAlgebra _

/-- Iterated directional derivatives lie in the Weyl algebra. -/
theorem iteratedLineDerivOp_mem_weylAlgebra {n : ℕ} (m : Fin n → EuclideanSpace ℝ l) :
    iteratedLineDerivOpCLM ℂ (RealSchwartz l) m ∈ weylAlgebra l := by
  induction n with
  | zero =>
    have : iteratedLineDerivOpCLM ℂ (RealSchwartz l) m = 1 := by
      ext1 f; simp
    rw [this]; exact one_mem _
  | succ n ih =>
    have : iteratedLineDerivOpCLM ℂ (RealSchwartz l) m =
        lineDerivOpCLM ℂ (RealSchwartz l) (m 0) * iteratedLineDerivOpCLM ℂ (RealSchwartz l) (Fin.tail m) := by
      ext1 f; simp [iteratedLineDerivOp_succ_left]
    rw [this]; exact mul_mem (lineDerivOp_mem_weylAlgebra _) (ih _)

variable [DecidableEq l]

/-- The weight `1 + |x|²` as an element of the Weyl algebra. -/
def weylAlgebra.weight (l : Type) [Fintype l] [DecidableEq l] : RealSchwartz l →L[ℂ] RealSchwartz l :=
  1 - ((4 * π ^ 2 : ℝ) : ℂ)⁻¹ • ∑ j : l, schrodingerDeriv (Pi.single (Sum.inr j) 1) * schrodingerDeriv (Pi.single (Sum.inr j) 1)

/-- The Fourier transform of the weight: `1 - Δ / 4π²`. -/
def weylAlgebra.fourierWeight (l : Type) [Fintype l] [DecidableEq l] : RealSchwartz l →L[ℂ] RealSchwartz l :=
  1 - ((4 * π ^ 2 : ℝ) : ℂ)⁻¹ • ∑ j : l, schrodingerDeriv (Pi.single (Sum.inl j) 1) * schrodingerDeriv (Pi.single (Sum.inl j) 1)

/-- The weight lies in the Weyl algebra. -/
theorem weylAlgebra.weight_mem : weylAlgebra.weight l ∈ weylAlgebra l :=
  sub_mem (one_mem _) (Subalgebra.smul_mem _ (sum_mem fun _ _ => mul_mem (schrodingerDeriv_mem_weylAlgebra _) (schrodingerDeriv_mem_weylAlgebra _)) _)

/-- The Fourier weight lies in the Weyl algebra. -/
theorem weylAlgebra.fourierWeight_mem : weylAlgebra.fourierWeight l ∈ weylAlgebra l :=
  sub_mem (one_mem _) (Subalgebra.smul_mem _ (sum_mem fun _ _ => mul_mem (schrodingerDeriv_mem_weylAlgebra _) (schrodingerDeriv_mem_weylAlgebra _)) _)

/-- The weight is multiplication by `1 + ‖x‖²`. -/
theorem weylAlgebra.weight_apply (f : RealSchwartz l) (x : EuclideanSpace ℝ l) :
    weylAlgebra.weight l f x = ((1 + ‖x‖ ^ 2 : ℝ) : ℂ) * f x := by
  have hπ : (π : ℂ) ≠ 0 := by simp [Real.pi_ne_zero]
  simp only [weylAlgebra.weight, _root_.sub_apply, _root_.smul_apply, _root_.sum_apply,
    mul_apply_eq_comp, one_apply_eq_self, _root_.sub_apply, _root_.smul_apply,
    _root_.sum_apply, schrodingerDeriv_single_inr, smul_eq_mul, EuclideanSpace.real_norm_sq_eq]
  push_cast
  rw [add_mul, one_mul, Finset.mul_sum, Finset.sum_mul, sub_eq_add_neg, ← Finset.sum_neg_distrib]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  field_simp
  rw [I_sq]
  ring

/-- Powers of the weight are multiplications by powers of `1 + ‖x‖²`. -/
theorem weylAlgebra.weight_pow_apply (k : ℕ) (f : RealSchwartz l) (x : EuclideanSpace ℝ l) :
    (weylAlgebra.weight l ^ k) f x = (((1 + ‖x‖ ^ 2) ^ k : ℝ) : ℂ) * f x := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', mul_apply_eq_comp, weylAlgebra.weight_apply, ih]
    push_cast
    ring

/-- The norm of the powers of the weight. -/
theorem weylAlgebra.norm_weight_pow_apply (k : ℕ) (f : RealSchwartz l) (x : EuclideanSpace ℝ l) :
    ‖(weylAlgebra.weight l ^ k) f x‖ = (1 + ‖x‖ ^ 2) ^ k * ‖f x‖ := by
  rw [weylAlgebra.weight_pow_apply, norm_mul, norm_real, Real.norm_of_nonneg (by positivity)]

/-- The inverse Fourier transform turns `∂ⱼ` into multiplication by `2πi xⱼ`. -/
theorem fourierInv_schrodingerDeriv_inl (j : l) (f : RealSchwartz l) :
    𝓕⁻ (schrodingerDeriv (Pi.single (Sum.inl j) 1) f) = -schrodingerDeriv (Pi.single (Sum.inr j) 1) (𝓕⁻ f) := by
  rw [schrodingerDeriv_single_inl, fourierInv_lineDerivOp_eq]
  ext x
  have : (fun y : EuclideanSpace ℝ l => y j).HasTemperateGrowth :=
    (EuclideanSpace.proj (𝕜 := ℝ) j).hasTemperateGrowth
  simp [schrodingerDeriv_single_inr, EuclideanSpace.inner_single_right, this, mul_assoc]

/-- The inverse Fourier transform carries the Fourier weight to the weight. -/
theorem weylAlgebra.fourierInv_fourierWeight (f : RealSchwartz l) : 𝓕⁻ (weylAlgebra.fourierWeight l f) = weylAlgebra.weight l (𝓕⁻ f) := by
  let F : RealSchwartz l →L[ℂ] RealSchwartz l := FourierTransform.fourierInvCLM ℂ (RealSchwartz l)
  have hF : ∀ g : RealSchwartz l, 𝓕⁻ g = F g := fun _ => rfl
  have h := fourierInv_schrodingerDeriv_inl (l := l)
  simp only [hF] at h ⊢
  simp only [weylAlgebra.fourierWeight, weylAlgebra.weight, _root_.sub_apply, _root_.smul_apply,
    _root_.sum_apply, mul_apply_eq_comp, one_apply_eq_self, map_sub, map_smul,
    map_sum, h, map_neg, neg_neg]

/-- The inverse Fourier transform carries powers of the Fourier weight to powers of the weight. -/
theorem weylAlgebra.fourierInv_fourierWeight_pow (k : ℕ) (f : RealSchwartz l) : 𝓕⁻ ((weylAlgebra.fourierWeight l ^ k) f) = (weylAlgebra.weight l ^ k) (𝓕⁻ f) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', pow_succ', mul_apply_eq_comp, mul_apply_eq_comp, weylAlgebra.fourierInv_fourierWeight, ih]

namespace Internal

theorem exists_norm_toLp_one_le :
    ∃ (N : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ f : RealSchwartz l, ‖f.toLp 1 volume‖ ≤ C * ‖((weylAlgebra.weight l ^ N) f).toLp 2 volume‖ := by
  set N := Module.finrank ℝ (EuclideanSpace ℝ l) + 1 with hN
  let u : EuclideanSpace ℝ l → ℂ := fun x => ((((1 + ‖x‖ ^ 2) ^ N)⁻¹ : ℝ) : ℂ)
  have hun : ∀ x, ‖u x‖ = ((1 + ‖x‖ ^ 2) ^ N)⁻¹ := fun x => by
    simp only [u]
    rw [norm_real, Real.norm_of_nonneg (by positivity)]
  have hc : Continuous u := by
    refine continuous_ofReal.comp (Continuous.inv₀ (by fun_prop) fun x => by positivity)
  have hu : MemLp u (ENNReal.ofReal 2) volume := by
    rw [show ENNReal.ofReal 2 = 2 by simp, memLp_two_iff_integrable_sq_norm hc.aestronglyMeasurable]
    have := integrable_rpow_neg_one_add_norm_sq (E := EuclideanSpace ℝ l) (μ := volume) (r := 4 * N)
      (by rw [hN]; push_cast; have := Nat.cast_nonneg (α := ℝ) (Module.finrank ℝ (EuclideanSpace ℝ l)); linarith)
    refine this.congr (.of_forall fun x => ?_)
    simp only [hun]
    rw [show -(4 * (N : ℝ)) / 2 = -((N * 2 : ℕ) : ℝ) by push_cast; ring, Real.rpow_neg (by positivity),
      Real.rpow_natCast, pow_mul, inv_pow]
  refine ⟨N, (∫ x, ‖u x‖ ^ (2 : ℝ)) ^ (1 / 2 : ℝ),
    Real.rpow_nonneg (integral_nonneg fun x => by positivity) _, fun f => ?_⟩
  have := integral_mul_norm_le_Lp_mul_Lq Real.HolderConjugate.two_two hu (((weylAlgebra.weight l ^ N) f).memLp _ volume)
  rw [norm_toLp_one, norm_toLp' (by simp) (by simp)]
  refine le_trans (le_of_eq ?_) (this.trans (le_of_eq (by simp)))
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only [hun, weylAlgebra.norm_weight_pow_apply]
  field_simp

theorem exists_norm_apply_le :
    ∃ A ∈ weylAlgebra l, ∀ (f : RealSchwartz l) (x : EuclideanSpace ℝ l), ‖f x‖ ≤ ‖(A f).toLp 2 volume‖ := by
  obtain ⟨N, C, hC, h⟩ := exists_norm_toLp_one_le (l := l)
  refine ⟨(C : ℂ) • weylAlgebra.fourierWeight l ^ N, Subalgebra.smul_mem _ (pow_mem weylAlgebra.fourierWeight_mem _) _, fun f x => ?_⟩
  have h1 := norm_fourier_apply_le_toLp_one (𝓕⁻ f) x
  rw [FourierTransform.fourier_fourierInv_eq] at h1
  refine h1.trans ((h _).trans (le_of_eq ?_))
  rw [← weylAlgebra.fourierInv_fourierWeight_pow, ← norm_fourier_toL2_eq, FourierTransform.fourier_fourierInv_eq,
    _root_.smul_apply, ← toLpCLM_apply (𝕜 := ℂ), ← toLpCLM_apply (𝕜 := ℂ), map_smul, norm_smul,
    norm_real, Real.norm_of_nonneg hC]

theorem norm_multilinear_le {n : ℕ} (m : ContinuousMultilinearMap ℝ (fun _ : Fin n => EuclideanSpace ℝ l) ℂ) :
    ‖m‖ ≤ ∑ r : Fin n → l, ‖m fun i => EuclideanSpace.single (r i) 1‖ := by
  refine m.opNorm_le_bound (by positivity) fun v => ?_
  have : v = fun i => ∑ j, v i j • (EuclideanSpace.single j 1 : EuclideanSpace ℝ l) := by
    funext i
    ext k
    simp [Pi.single_apply]
  conv_lhs => rw [this, m.map_sum]
  rw [Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun r _ => ?_)
  rw [m.map_smul_univ, norm_smul, mul_comm, norm_prod]
  gcongr with i
  exact PiLp.norm_apply_le _ _

end Internal

/-- Every Schwartz seminorm is bounded by a finite sum of `L²` norms of images under elements of the
Weyl algebra. -/
theorem exists_seminorm_le_sum_norm_toLp (k n : ℕ) :
    ∃ A : (Fin n → l) → (RealSchwartz l →L[ℂ] RealSchwartz l), (∀ r, A r ∈ weylAlgebra l) ∧
      ∀ f : RealSchwartz l, SchwartzMap.seminorm ℂ k n f ≤ ∑ r, ‖(A r f).toLp 2 volume‖ := by
  obtain ⟨A, hA, h⟩ := exists_norm_apply_le (l := l)
  refine ⟨fun r => A * weylAlgebra.weight l ^ k * iteratedLineDerivOpCLM ℂ (RealSchwartz l) fun i => EuclideanSpace.single (r i) 1,
    fun r => mul_mem (mul_mem hA (pow_mem weylAlgebra.weight_mem _)) (iteratedLineDerivOp_mem_weylAlgebra _), fun f => ?_⟩
  refine seminorm_le_bound ℂ k n f (by positivity) fun x => ?_
  refine (mul_le_mul_of_nonneg_left (norm_multilinear_le _) (by positivity)).trans ?_
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun r _ => le_trans ?_ (h _ x)
  refine le_trans ?_ (weylAlgebra.norm_weight_pow_apply k
    (iteratedLineDerivOpCLM ℂ (RealSchwartz l) (fun i => EuclideanSpace.single (r i) 1) f) x).ge
  rw [iteratedLineDerivOpCLM_apply, iteratedLineDerivOp_eq_iteratedFDeriv]
  gcongr
  nlinarith [sq_nonneg (‖x‖ - 1), norm_nonneg x]

namespace Internal

theorem exists_extension_of_bound {V E : Type} [AddCommGroup V] [Module ℂ V] [NormedAddCommGroup E]
    [NormedSpace ℂ E] (T : V →ₗ[ℂ] E) (lam : V →ₗ[ℂ] ℂ) (C : ℝ) (hb : ∀ f, ‖lam f‖ ≤ C * ‖T f‖) :
    ∃ Λ : E →L[ℂ] ℂ, ∀ f, lam f = Λ (T f) := by
  have hker : LinearMap.ker T ≤ LinearMap.ker lam := fun f hf => by
    have := hb f
    rw [LinearMap.mem_ker.1 hf, norm_zero, mul_zero] at this
    exact norm_le_zero_iff.1 this
  let φ : LinearMap.range T →ₗ[ℂ] ℂ := ((LinearMap.ker T).liftQ lam hker) ∘ₗ T.quotKerEquivRange.symm.toLinearMap
  have hφ : ∀ f, φ ⟨T f, f, rfl⟩ = lam f := fun f => by
    change (LinearMap.ker T).liftQ lam hker (T.quotKerEquivRange.symm ⟨T f, LinearMap.mem_range_self T f⟩) = _
    rw [LinearMap.quotKerEquivRange_symm_apply_image]
    rfl
  obtain ⟨Λ, hΛ, -⟩ := exists_extension_norm_eq (LinearMap.range T) (φ.mkContinuous C (by
    rintro ⟨_, f, rfl⟩
    rw [hφ]
    exact hb f))
  refine ⟨Λ, fun f => ?_⟩
  rw [← hφ]
  exact (hΛ ⟨T f, f, rfl⟩).symm

theorem exists_norm_le_sum (lam : RealSchwartz l →L[ℂ] ℂ) :
    ∃ (ι : Type) (_ : Fintype ι) (A : ι → (RealSchwartz l →L[ℂ] RealSchwartz l)) (C : ℝ), 0 ≤ C ∧
      (∀ i, A i ∈ weylAlgebra l) ∧ ∀ f, ‖lam f‖ ≤ C * ∑ i, ‖schwartzToL2 l (A i f)‖ := by
  obtain ⟨s, C, -, hC⟩ := Seminorm.bound_of_continuous (schwartz_withSeminorms ℂ (EuclideanSpace ℝ l) ℂ)
    ((normSeminorm ℂ ℂ).comp lam.toLinearMap) (continuous_norm.comp lam.continuous)
  have hC' : ∀ f, ‖lam f‖ ≤ C * s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ l) ℂ) f := fun f => hC f
  clear hC
  choose A hA hA' using exists_seminorm_le_sum_norm_toLp (l := l)
  simp only [← SchwartzMap.toLpCLM_apply (𝕜 := ℂ)] at hA'
  refine ⟨Σ p : s, (Fin p.1.2 → l), inferInstance, fun i => A i.1.1.1 i.1.1.2 i.2, C, C.2, fun i => hA _ _ _,
    fun f => (hC' f).trans (mul_le_mul_of_nonneg_left ?_ C.2)⟩
  rw [Fintype.sum_sigma]
  refine Seminorm.finset_sup_apply_le (Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _)
    fun p hp => ?_
  rw [schwartzSeminormFamily_apply]
  refine (hA' p.1 p.2 f).trans ?_
  exact Finset.single_le_sum (f := fun q : s => ∑ r, ‖schwartzToL2 l (A q.1.1 q.1.2 r f)‖)
    (fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _) (Finset.mem_univ (⟨p, hp⟩ : s))

end Internal

/-- Every continuous linear functional on Schwartz space factors as `f ↦ Λ ((A i f) ∈ L²)ᵢ` for
finitely many `A i` in the Weyl algebra and a continuous linear `Λ`. -/
theorem exists_factor_through_toLp (lam : RealSchwartz l →L[ℂ] ℂ) :
    ∃ (ι : Type) (_ : Fintype ι) (A : ι → (RealSchwartz l →L[ℂ] RealSchwartz l)) (Λ : (ι → RealL2 l) →L[ℂ] ℂ),
      (∀ i, A i ∈ weylAlgebra l) ∧ ∀ f, lam f = Λ fun i => schwartzToL2 l (A i f) := by
  obtain ⟨ι, _, A, C, hC, hA, h⟩ := exists_norm_le_sum lam
  let T : RealSchwartz l →ₗ[ℂ] (ι → RealL2 l) := LinearMap.pi fun i => (schwartzToL2 l).toLinearMap ∘ₗ (A i).toLinearMap
  have hT : ∀ f, T f = fun i => schwartzToL2 l (A i f) := fun f => by
    funext i
    simp [T]
  clear_value T
  obtain ⟨Λ, hΛ⟩ := exists_extension_of_bound T lam.toLinearMap (C * Fintype.card ι) fun f => by
    refine (h f).trans ?_
    rw [mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ hC
    have h1 : ∀ i, ‖schwartzToL2 l (A i f)‖ ≤ ‖T f‖ := fun i => by
      have := norm_le_pi_norm (T f) i
      rwa [congrFun (hT f) i] at this
    refine (Finset.sum_le_sum fun i _ => h1 i).trans ?_
    simp
  refine ⟨ι, inferInstance, A, Λ, hA, fun f => ?_⟩
  rw [← hT]
  exact hΛ f

end Real

end Langlands.Theta
