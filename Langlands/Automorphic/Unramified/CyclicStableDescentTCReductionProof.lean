/-! # Proof of the totally complex reduction of cyclic stable descent

`cyclicStableDescentTCReduction` proves `CyclicStableDescentTCReductionStatement`. The
unitary weak descent witness is built by induction on the degree, through the bottom prime
step of the cyclic tower; the twists by the powers of the norm-kernel character then
classify the lower cuspidal classes lifting to the upper cusp.
-/

noncomputable section

open scoped BigOperators NumberField

universe uF uE uV uW

set_option autoImplicit false

namespace Langlands.Automorphic.Unramified

open Langlands.Global Langlands.Global.AdelicFunctoriality Langlands.Unramified
open Langlands.Automorphic.CuspidalOperatorRealization
open Langlands.ClassFieldTheory.Global.RelativeWeilGroup (HasUnitaryCentralCharacter)

namespace CyclicStableDescentTC

/-! ### The bottom prime step of a cyclic extension -/

/-- A Galois extension `E/F` whose Galois group is generated by `σ`, of degree neither one
nor prime, has an intermediate field `K` that is Galois of prime degree over `F`, with
`[E : K] < [E : F]`: the fixed field of the subgroup generated by `σ ^ p`, for `p` the least
prime factor of the degree. The group `Gal(E/K)` is generated by an automorphism whose
underlying ring automorphism is a power of `σ`, and `Gal(K/F)` by an automorphism `τ`
compatible with `σ` along the inclusion `K → E`. -/
theorem exists_bottomPrimeStep {F : Type uF} {E : Type uE} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] [IsGalois F E] (σ : E ≃ₐ[F] E)
    (hgen : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (hone : Module.finrank F E ≠ 1) (hnotPrime : ¬ (Module.finrank F E).Prime) :
    ∃ (K : IntermediateField F E) (_ : IsGalois F K) (σK : E ≃ₐ[K] E) (τ : K ≃ₐ[F] K),
      (∀ ρ : E ≃ₐ[K] E, ρ ∈ Subgroup.zpowers σK) ∧
      (∀ ρ : K ≃ₐ[F] K, ρ ∈ Subgroup.zpowers τ) ∧
      (Module.finrank F K).Prime ∧
      Module.finrank K E < Module.finrank F E ∧
      (∀ x : K, σ (algebraMap K E x) = algebraMap K E (τ x)) ∧
      ∃ k : ℕ, σK.toRingEquiv = (σ ^ k).toRingEquiv := by
  classical
  set n := Module.finrank F E with hn
  have hnpos : 0 < n := Module.finrank_pos
  have hn1 : n ≠ 1 := hone
  set p := n.minFac with hpdef
  have hp : p.Prime := Nat.minFac_prime hn1
  have hpn : p ∣ n := Nat.minFac_dvd n
  have hplt : p < n := lt_of_le_of_ne (Nat.minFac_le hnpos) (fun h => hnotPrime (h ▸ hp))
  have horder : orderOf σ = n :=
    (orderOf_eq_card_of_forall_mem_zpowers hgen).trans (IsGalois.card_aut_eq_finrank F E)
  let H : Subgroup (E ≃ₐ[F] E) := Subgroup.zpowers (σ ^ p)
  have hcomm : ∀ a b : E ≃ₐ[F] E, a * b = b * a := by
    intro a b
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hgen a)
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hgen b)
    exact (Commute.zpow_zpow_self σ i j).eq
  have hHnormal : H.Normal := ⟨fun x hx g => by rw [hcomm g x, mul_inv_cancel_right]; exact hx⟩
  let K : IntermediateField F E := IntermediateField.fixedField H
  have hGalK : IsGalois F K := IsGalois.of_fixedField_normal_subgroup H
  have hfix : K.fixingSubgroup = H := IntermediateField.fixingSubgroup_fixedField H
  have hKE : Module.finrank K E = n / p := by
    rw [IntermediateField.finrank_fixedField_eq_card, Nat.card_zpowers,
      orderOf_pow_of_dvd hp.ne_zero (horder ▸ hpn), horder]
  have hFK : Module.finrank F K = p := by
    have hmul := Module.finrank_mul_finrank F K E
    rw [hKE, ← hn] at hmul
    have hdiv : n / p ≠ 0 := (Nat.div_pos (Nat.le_of_dvd hnpos hpn) hp.pos).ne'
    have : Module.finrank F K * (n / p) = p * (n / p) := by
      rw [hmul, Nat.mul_div_cancel' hpn]
    exact Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hdiv) this
  have hmem : σ ^ p ∈ K.fixingSubgroup := by
    rw [hfix]
    exact Subgroup.mem_zpowers _
  let σK : E ≃ₐ[K] E := K.fixingSubgroupEquiv ⟨σ ^ p, hmem⟩
  let τ : K ≃ₐ[F] K := AlgEquiv.restrictNormalHom K σ
  refine ⟨K, hGalK, σK, τ, ?_, ?_, hFK ▸ hp, ?_, ?_, p, ?_⟩
  · intro ρ
    let ρ' := K.fixingSubgroupEquiv.symm ρ
    have hρ' : (ρ' : E ≃ₐ[F] E) ∈ H := hfix ▸ ρ'.2
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hρ'
    refine Subgroup.mem_zpowers_iff.mpr ⟨k, ?_⟩
    have hsub : (⟨σ ^ p, hmem⟩ : K.fixingSubgroup) ^ k = ρ' :=
      Subtype.ext (by rw [Subgroup.coe_zpow]; exact hk)
    change K.fixingSubgroupEquiv ⟨σ ^ p, hmem⟩ ^ k = ρ
    rw [← map_zpow, hsub, MulEquiv.apply_symm_apply]
  · intro ρ
    obtain ⟨ρ', rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := F) (K₁ := K) (E := E) ρ
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hgen ρ')
    exact Subgroup.mem_zpowers_iff.mpr ⟨k, (map_zpow _ σ k).symm⟩
  · rw [hKE]
    exact Nat.div_lt_self hnpos hp.one_lt
  · intro x
    exact (AlgEquiv.restrictNormal_commutes σ K x).symm
  · rfl

/-! ### Galois conjugation of cuspidal classes -/

section Galois

variable {F : Type*} {K : Type*} [Field F] [Field K] [NumberField K]
  [CompactSpace (AdeleQuotient K)] [Algebra F K] {r : ℕ}

/-- A class stable under `σ` is stable under every power of `σ`. -/
theorem galoisConj_pow_eq (σ : K ≃ₐ[F] K) {c : IsoClass K r} (h : c.IsGaloisStable σ) :
    ∀ k : ℕ, IsoClass.galoisConj (σ ^ k) c = c
  | 0 => by rw [pow_zero, IsoClass.galoisConj_one]
  | k + 1 => by
    rw [pow_succ', IsoClass.galoisConj_mul, galoisConj_pow_eq σ h k,
      (IsoClass.isGaloisStable_iff σ c).mp h]

/-- Galois conjugation depends only on the underlying ring automorphism. -/
theorem galoisConj_eq_of_toRingEquiv_eq {F' : Type*} [Field F'] [Algebra F' K]
    (σ : K ≃ₐ[F] K) (σ' : K ≃ₐ[F'] K) (h : σ.toRingEquiv = σ'.toRingEquiv)
    (c : IsoClass K r) : IsoClass.galoisConj σ c = IsoClass.galoisConj σ' c := by
  simp only [IsoClass.galoisConj, h]

end Galois

/-! ### Two weak base changes of one upper class -/

/-- If two lower systems have weak base changes attached to the same upper class,
possibly through presentations in different factor universes, then their residue-degree
powers agree outside a finite set of base places. -/
theorem sameResidueDegreePowers_of_isArithmeticWeakBaseChangeOf
    {F : Type uF} {E : Type uE} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [CompactSpace (AdeleQuotient E)] {r : ℕ} {d : IsoClass E r}
    {s s' : SpectralSystem (FinitePlace F) (r + 1)}
    {t t' : SpectralSystem (FinitePlace E) (r + 1)}
    (ht : IsoClass.HasSpectralSystem.{uE, uV} d t) (ht' : IsoClass.HasSpectralSystem.{uE, uW} d t')
    (h : t.IsArithmeticWeakBaseChangeOf s) (h' : t'.IsArithmeticWeakBaseChangeOf s') :
    SpectralSystem.SameResidueDegreePowers E s s' := by
  filter_upwards [h, h'] with v hv hv'
  obtain ⟨hs, htw, he, hes⟩ := hv
  obtain ⟨hs', htw', -, hes'⟩ := hv'
  exact ⟨hs, hs', fun w => ⟨he w, (hes w).symm.trans
    ((ht.eigenvalues_eq ht' w.1 (htw w) (htw' w)).trans (hes' w))⟩⟩

/-! ### Norm characters fixing a unitary cuspidal descent -/

/-- The self-pair count: for a unitary cuspidal class with a unitary cuspidal weak base
change, the identity is the only power of the norm-kernel character `η` (with exponent
below the degree) fixing the class under determinant twist. -/
theorem eq_zero_of_isFiniteOrderDeterminantTwist_self
    {F : Type uF} {E : Type uE} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E] [IsCyclic (E ≃ₐ[F] E)]
    [CompactSpace (AdeleQuotient F)] [CompactSpace (AdeleQuotient E)]
    (hpairs : CyclicWeakBaseChangePairMultiplicityOver.{uF, uE, uV, uW} F E)
    {η : HeckeCharacter F} (hη : η.HasNormKernel E) {r : ℕ}
    {S : CuspidalOperatorRealization F r} (hS : HasUnitaryCentralCharacter S)
    {T : CuspidalOperatorRealization E r} (hT : HasUnitaryCentralCharacter T)
    (hST : IsoClass.IsWeakBaseChangeOf.{uF, uE, uV, uW} T.isoClass S.isoClass)
    {i : ℕ} (hi : i < Module.finrank F E)
    (hfix : IsoClass.IsFiniteOrderDeterminantTwist (η ^ i) S.isoClass S.isoClass) : i = 0 := by
  classical
  by_contra hne
  let c := PositiveRankCuspidalClass.ofFixedRank S.isoClass
  let d := PositiveRankCuspidalClass.ofFixedRank T.isoClass
  have hfin (k : ℕ) : (η ^ k).HasFiniteOrder :=
    HeckeCharacter.IsTrivialOnNorm.hasFiniteOrder E (by
      intro x
      rw [ContinuousMonoidHom.pow_apply, hη.isTrivialOnNorm x, one_pow])
  have hlower : (IsobaricData.ofCuspidal c).IsUnitary :=
    IsobaricData.isUnitary_ofCuspidal.mpr (S.isUnitarizable_of_hasUnitaryCentralCharacter hS)
  have hupper : (IsobaricData.ofCuspidal d).IsUnitary :=
    IsobaricData.isUnitary_ofCuspidal.mpr (T.isUnitarizable_of_hasUnitaryCentralCharacter hT)
  have hBC : IsobaricData.IsWeakBaseChangeOf.{uF, uE, uV, uW} (IsobaricData.ofCuspidal d)
      (IsobaricData.ofCuspidal c) :=
    (IsobaricData.isWeakBaseChangeOf_ofCuspidal_iff _ _).mpr hST
  have h := hpairs η hη _ _ _ _ hlower hlower hupper hupper hBC hBC
  dsimp only at h
  let f : ℕ → ℕ := fun k => Multiset.count (c.determinantTwist (η ^ k) (hfin k)) {c}
  have hsum : (∑ k ∈ Finset.range (Module.finrank F E), f k) = 1 := by
    simpa only [f, IsobaricData.ofCuspidal, IsobaricData.equalConstituentPairCount,
      Multiset.map_singleton, Multiset.sum_singleton, Multiset.count_singleton_self] using h
  have hf (k : ℕ)
      (hk : IsoClass.IsFiniteOrderDeterminantTwist (η ^ k) S.isoClass S.isoClass) : f k = 1 := by
    have heq : S.isoClass.determinantTwist (η ^ k) (hfin k) = S.isoClass :=
      ((IsoClass.isFiniteOrderDeterminantTwist_iff_eq _ _ _ (hfin k)).mp hk).symm
    simp only [f, c, PositiveRankCuspidalClass.determinantTwist_ofFixedRank, heq,
      Multiset.count_singleton_self]
  have h0 : f 0 = 1 := hf 0 (by
    rw [pow_zero]
    exact IsoClass.IsFiniteOrderDeterminantTwist.refl _)
  have hle : (∑ k ∈ ({0, i} : Finset ℕ), f k) ≤ ∑ k ∈ Finset.range (Module.finrank F E), f k := by
    apply Finset.sum_le_sum_of_subset
    intro k hk
    rw [Finset.mem_insert, Finset.mem_singleton] at hk
    rw [Finset.mem_range]
    rcases hk with rfl | rfl
    · exact Module.finrank_pos
    · exact hi
  rw [Finset.sum_pair (Ne.symm hne), h0, hf i hfix, hsum] at hle
  omega

/-- A norm-trivial character fixing a unitary cuspidal class with a unitary cuspidal
weak base change, along a cyclic extension, is trivial. -/
theorem eq_one_of_isTrivialOnNorm_of_selfTwist
    {F : Type uF} {E : Type uE} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E] [IsCyclic (E ≃ₐ[F] E)]
    [CompactSpace (AdeleQuotient F)] [CompactSpace (AdeleQuotient E)]
    (hpairs : CyclicWeakBaseChangePairMultiplicityOver.{uF, uE, uV, uW} F E) {r : ℕ}
    {S : CuspidalOperatorRealization F r} (hS : HasUnitaryCentralCharacter S)
    {T : CuspidalOperatorRealization E r} (hT : HasUnitaryCentralCharacter T)
    (hST : IsoClass.IsWeakBaseChangeOf.{uF, uE, uV, uW} T.isoClass S.isoClass)
    {χ : HeckeCharacter F} (hχ : χ.IsTrivialOnNorm E)
    (hfix : IsoClass.IsFiniteOrderDeterminantTwist χ S.isoClass S.isoClass) : χ = 1 := by
  obtain ⟨⟨η, hη⟩, hall⟩ := HeckeCharacter.cyclicNormKernelCharacter F E
  obtain ⟨i, hi, rfl⟩ := ((hall η hη).2 χ).mp hχ
  rw [eq_zero_of_isFiniteOrderDeterminantTwist_self hpairs hη hS hT hST hi hfix, pow_zero]

/-! ### Iterated Galois conjugation by a twist -/

/-- If the conjugate of `c` by `τ` is the twist of `c` by a `τ`-invariant character `χ`,
then the conjugate by `τ ^ k` is the twist by `χ ^ k`. -/
theorem isFiniteOrderDeterminantTwist_galoisConj_pow
    (htwist : CuspidalDeterminantTwistArithmeticComapStatement.{uE, uE})
    {F : Type uF} {K : Type uE} [Field F] [Field K] [NumberField K]
    [CompactSpace (AdeleQuotient K)] [Algebra F K] {r : ℕ} (τ : K ≃ₐ[F] K)
    {χ : HeckeCharacter K} (hinv : HeckeCharacter.comap τ.toRingEquiv.symm χ = χ)
    {c : IsoClass K r}
    (h : IsoClass.IsFiniteOrderDeterminantTwist χ c (IsoClass.galoisConj τ c)) :
    ∀ k : ℕ, IsoClass.IsFiniteOrderDeterminantTwist (χ ^ k) c (IsoClass.galoisConj (τ ^ k) c)
  | 0 => by
    simpa only [pow_zero, IsoClass.galoisConj_one] using
      IsoClass.IsFiniteOrderDeterminantTwist.refl c
  | k + 1 => by
    have ih := isFiniteOrderDeterminantTwist_galoisConj_pow htwist τ hinv h k
    have h' := htwist K K τ.toRingEquiv.symm r c (IsoClass.galoisConj (τ ^ k) c) (χ ^ k) ih
    rw [HeckeCharacter.comap_pow, hinv] at h'
    change IsoClass.IsFiniteOrderDeterminantTwist (χ ^ k) (IsoClass.galoisConj τ c)
      (IsoClass.galoisConj τ (IsoClass.galoisConj (τ ^ k) c)) at h'
    rw [← IsoClass.galoisConj_mul, ← pow_succ'] at h'
    rw [pow_succ']
    exact h.trans h'

/-! ### Degree one -/

/-- In an extension of degree one, every ramification index is one. -/
theorem ramificationIdx_eq_one_of_finrank_eq_one {K L : Type*} [Field K] [Field L]
    [NumberField K] [NumberField L] [Algebra K L] (h : Module.finrank K L = 1)
    (u : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) : u.asIdeal.ramificationIdx (𝓞 K) = 1 := by
  classical
  let v := u.under (𝓞 K)
  have hu : u.asIdeal.LiesOver v.asIdeal := ⟨rfl⟩
  have hsum := finitePlacesAbove_sum_ramification_inertia (L := L) v
  rw [h] at hsum
  have hle := Finset.single_le_sum (f := fun q : FinitePlacesAbove L v =>
      q.1.asIdeal.ramificationIdx (𝓞 K) * q.1.asIdeal.inertiaDeg (𝓞 K))
    (fun _ _ => Nat.zero_le _) (Finset.mem_univ (⟨u, hu⟩ : FinitePlacesAbove L v))
  rw [hsum] at hle
  have he : 0 < u.asIdeal.ramificationIdx (𝓞 K) :=
    Ideal.ramificationIdx_pos (R := 𝓞 K) u.asIdeal
  have hf : 0 < u.asIdeal.inertiaDeg (𝓞 K) := Ideal.inertiaDeg_pos (R := 𝓞 K) u.asIdeal
  have hle' : u.asIdeal.ramificationIdx (𝓞 K) * u.asIdeal.inertiaDeg (𝓞 K) ≤ 1 := hle
  nlinarith

/-- Degree one: the arithmetic pullback of a unitary cusp along the algebra isomorphism
`F ≃+* E` is a unitary cuspidal weak descent. Its spectrum is the reindexed spectrum of a
genuine attachment, and an independently attached upper spectrum agrees with it. -/
theorem exists_unitary_weakBaseChange_of_finrank_eq_one
    (hexistV : CuspidalSpectralAttachmentExistenceStatement.{uE, uV})
    (hexistW : CuspidalSpectralAttachmentExistenceStatement.{uE, uW})
    (hcomap : CuspidalSpectralArithmeticComapStatement.{uF, uE, uV})
    {F : Type uF} {E : Type uE} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [CompactSpace (AdeleQuotient F)] [CompactSpace (AdeleQuotient E)]
    (h1 : Module.finrank F E = 1) {r : ℕ} (T : CuspidalOperatorRealization E r)
    (hT : HasUnitaryCentralCharacter T) :
    ∃ S : CuspidalOperatorRealization F r, HasUnitaryCentralCharacter S ∧
      IsoClass.IsWeakBaseChangeOf.{uF, uE, uV, uW} T.isoClass S.isoClass := by
  classical
  let e : F ≃+* E := RingEquiv.ofBijective (algebraMap F E)
    (Module.Free.bijective_algebraMap_of_finrank_eq_one h1)
  have he : ∀ x, algebraMap E E (e x) = algebraMap F E x := fun _ => rfl
  refine ⟨T.arithmeticComap e, ?_, ?_⟩
  · obtain ⟨χ, hχ, hcentral⟩ := hT
    exact ⟨HeckeCharacter.comap e χ, (HeckeCharacter.isUnitary_comap_iff e χ).mpr hχ,
      (T.arithmeticComap_hasCentralCharacter_iff e χ).mpr hcentral⟩
  · obtain ⟨s, hs⟩ := hexistV E r T
    obtain ⟨t, ht⟩ := hexistW E r T
    refine ⟨s.reindex (finitePlaceEquiv e), t, hcomap F E e r T.isoClass s hs, ht, ?_⟩
    filter_upwards [SpectralSystem.eventually_avoidsAbove (F := F) t.exceptional,
      (s.reindex (finitePlaceEquiv e)).exceptional.eventually_cofinite_notMem] with v hv hvs
    refine ⟨hvs, hv, fun w => ramificationIdx_eq_one_of_finrank_eq_one h1 w.1, fun w => ?_⟩
    have hw : (finitePlaceEquiv e).symm v = w.1 := by
      rw [Equiv.symm_apply_eq]
      refine (finitePlacesAbove_under v w).symm.trans
        ((finitePlaceEquiv_under e he w.1).symm.trans ?_)
      congr 1
    have hsv : (finitePlaceEquiv e).symm v ∉ s.exceptional := fun h =>
      hvs (Finset.mem_map.mpr ⟨_, h, Equiv.apply_symm_apply _ v⟩)
    have hsw : w.1 ∉ s.exceptional := hw ▸ hsv
    rw [inertiaDeg_eq_one_of_finrank_eq_one h1 w.1, Eigenvalues.power_one]
    change t.eigenvalues w.1 (hv w) = s.eigenvalues ((finitePlaceEquiv e).symm v) hsv
    have hcongr : ∀ (a b : FinitePlace E) (_ : a = b) (ha : a ∉ s.exceptional)
        (hb : b ∉ s.exceptional), s.eigenvalues a ha = s.eigenvalues b hb := by
      rintro a _ rfl _ _
      rfl
    rw [ht.eigenvalues_eq hs w.1 (hv w) hsw, hcongr _ _ hw.symm hsw hsv]

/-! ### Composite degree through the bottom prime step -/

/-- Composite degree: descend from `E` to the bottom prime step `K` by the supplied
descent for smaller degree, show that the descended cusp is stable under the
generator of `K/F`, then descend from `K` to `F` and compose. -/
theorem exists_unitary_weakBaseChange_composite
    {F : Type uF} {E : Type uE} [Field F] [NumberField F] [NumberField.IsTotallyComplex F]
    [Field E] [NumberField E] [Algebra F E] [IsGalois F E]
    [CompactSpace (AdeleQuotient F)] [CompactSpace (AdeleQuotient E)]
    (hprime : CyclicPrimeStableCuspidalDescentTCStatement.{uF, uE, uV, uW})
    (hobs : CyclicPrimeTwistedCuspidalObstructionTCStatement.{uF, uE})
    (hpairs : CyclicWeakBaseChangePairMultiplicityTCStatement.{uE, uE, uW, uW})
    (hfiber : CyclicCuspidalFiberStatement.{uE, uE, uW, uW})
    (hres : HeckeCharacter.CyclicPrimeNormCharacterRestrictionStatement.{uF, uE, uE})
    (htower : IsobaricWeakBaseChangeTowerStatement.{uF, uE, uE, uV, uW, uW})
    (hequiv : IsobaricWeakBaseChangeEquivarianceStatement.{uE, uE, uW, uW})
    (htwist : CuspidalDeterminantTwistArithmeticComapStatement.{uE, uE})
    (hupper : ∀ (K : Type uE) (L : Type uE) [Field K] [NumberField K]
      [NumberField.IsTotallyComplex K] [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
      [CompactSpace (AdeleQuotient K)] [CompactSpace (AdeleQuotient L)]
      (ρ : L ≃ₐ[K] L), (∀ τ : L ≃ₐ[K] L, τ ∈ Subgroup.zpowers ρ) →
      Module.finrank K L < Module.finrank F E →
      ∀ (r : ℕ) (T : CuspidalOperatorRealization L r), HasUnitaryCentralCharacter T →
        T.isoClass.IsGaloisStable ρ →
        ∃ S : CuspidalOperatorRealization K r, HasUnitaryCentralCharacter S ∧
          IsoClass.IsWeakBaseChangeOf.{uE, uE, uW, uW} T.isoClass S.isoClass)
    (σ : E ≃ₐ[F] E) (hgen : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (hone : Module.finrank F E ≠ 1) (hnotPrime : ¬ (Module.finrank F E).Prime)
    {r : ℕ} (T : CuspidalOperatorRealization E r) (hT : HasUnitaryCentralCharacter T)
    (hstable : T.isoClass.IsGaloisStable σ) :
    ∃ S : CuspidalOperatorRealization F r, HasUnitaryCentralCharacter S ∧
      IsoClass.IsWeakBaseChangeOf.{uF, uE, uV, uW} T.isoClass S.isoClass := by
  classical
  obtain ⟨K, hGalK, σK, τ, hgenK, hgenτ, hFKprime, hdeg, hτσ, k, hσK⟩ :=
    exists_bottomPrimeStep σ hgen hone hnotPrime
  have := hGalK
  have : NumberField.IsTotallyComplex K := NumberField.isTotallyComplex_of_algebra F K
  have : CompactSpace (AdeleQuotient K) := compactSpace_adeleQuotient K
  have : IsCyclic (E ≃ₐ[F] E) := ⟨⟨σ, hgen⟩⟩
  have : IsCyclic (E ≃ₐ[K] E) := ⟨⟨σK, hgenK⟩⟩
  have : IsCyclic (K ≃ₐ[F] K) := ⟨⟨τ, hgenτ⟩⟩
  -- the upper cusp is stable under the generator `σ ^ k` of `E/K`
  have hTK : T.isoClass.IsGaloisStable σK := by
    rw [IsoClass.isGaloisStable_iff, galoisConj_eq_of_toRingEquiv_eq σK (σ ^ k) hσK,
      galoisConj_pow_eq σ hstable k]
  obtain ⟨SK, hSK, hSKT⟩ := hupper K E σK hgenK hdeg r T hT hTK
  -- the conjugate of `SK` by `τ` also lifts to `T`
  have hconj : IsoClass.IsWeakBaseChangeOf.{uE, uE, uW, uW} T.isoClass
      (IsoClass.galoisConj τ SK.isoClass) := by
    have h := hequiv K E τ.toRingEquiv σ.toRingEquiv (fun x => hτσ x)
      (IsobaricData.ofCuspidal (PositiveRankCuspidalClass.ofFixedRank SK.isoClass))
      (IsobaricData.ofCuspidal (PositiveRankCuspidalClass.ofFixedRank T.isoClass))
      ((IsobaricData.isWeakBaseChangeOf_ofCuspidal_iff _ _).mpr hSKT)
    simp only [IsobaricData.ofCuspidal, Multiset.map_singleton,
      PositiveRankCuspidalClass.arithmeticComap_ofFixedRank] at h
    have hT' : T.isoClass.arithmeticComap σ.toRingEquiv.symm = T.isoClass :=
      (IsoClass.isGaloisStable_iff σ _).mp hstable
    rw [hT'] at h
    exact (IsobaricData.isWeakBaseChangeOf_ofCuspidal_iff _ _).mp h
  -- common-fibre comparison over `E/K`
  obtain ⟨s₁, t₁, hs₁, ht₁, h₁⟩ := id hSKT
  obtain ⟨s₂, t₂, hs₂, ht₂, h₂⟩ := hconj
  obtain ⟨χ, hχnorm, hχ⟩ := hfiber K E r SK.isoClass (IsoClass.galoisConj τ SK.isoClass)
    s₁ s₂ hs₁ hs₂ (sameResidueDegreePowers_of_isArithmeticWeakBaseChangeOf ht₁ ht₂ h₁ h₂)
  -- `χ` is invariant under `τ`; iterate the conjugation relation
  obtain ⟨hχinv, hχres⟩ := hres F K E hFKprime χ hχnorm
  have hinv : HeckeCharacter.comap τ.toRingEquiv.symm χ = χ := hχinv τ.symm
  have hpow := isFiniteOrderDeterminantTwist_galoisConj_pow htwist τ hinv hχ
    (Module.finrank F K)
  have hτpow : τ ^ Module.finrank F K = 1 := by
    rw [← IsGalois.card_aut_eq_finrank]
    exact pow_card_eq_one'
  rw [hτpow, IsoClass.galoisConj_one] at hpow
  -- the self-pair count over `E/K` gives `χ ^ p = 1`
  have hχpow : χ ^ Module.finrank F K = 1 :=
    eq_one_of_isTrivialOnNorm_of_selfTwist (hpairs K E) hSK hT hSKT
      (fun x => by rw [ContinuousMonoidHom.pow_apply, hχnorm x, one_pow]) hpow
  -- the twisted obstruction for `K/F` forces `χ = 1`
  have hχone : χ = 1 := by
    by_contra hne
    exact hobs F K hFKprime τ hgenτ χ (hχnorm.hasFiniteOrder E) (hχres hχpow hne) r SK hχ
  have hSKstable : SK.isoClass.IsGaloisStable τ := by
    rw [IsoClass.isGaloisStable_iff]
    rw [hχone] at hχ
    exact ((IsoClass.isFiniteOrderDeterminantTwist_one_iff _ _).mp hχ).symm
  -- prime descent for `K/F` and composition in the tower
  obtain ⟨⟨η, hη⟩, -⟩ := HeckeCharacter.cyclicNormKernelCharacter F K
  obtain ⟨S, hS, hSSK⟩ := hprime F K hFKprime τ hgenτ η hη r SK hSK hSKstable
  refine ⟨S, hS, ?_⟩
  have h := htower F K E
    (IsobaricData.ofCuspidal (PositiveRankCuspidalClass.ofFixedRank S.isoClass))
    (IsobaricData.ofCuspidal (PositiveRankCuspidalClass.ofFixedRank SK.isoClass))
    (IsobaricData.ofCuspidal (PositiveRankCuspidalClass.ofFixedRank T.isoClass))
    ((IsobaricData.isWeakBaseChangeOf_ofCuspidal_iff _ _).mpr hSSK)
    ((IsobaricData.isWeakBaseChangeOf_ofCuspidal_iff _ _).mpr hSKT)
  exact (IsobaricData.isWeakBaseChangeOf_ofCuspidal_iff _ _).mp h

/-! ### The unitary weak descent witness -/

/-- The unitary weak descent witness for fields in one universe, by strong induction on
the degree: degree one, prime degree, and composite degree with the bottom prime step. -/
theorem exists_unitary_weakBaseChange_sameUniverse
    (hprime : CyclicPrimeStableCuspidalDescentTCStatement.{uE, uE, uW, uW})
    (hobs : CyclicPrimeTwistedCuspidalObstructionTCStatement.{uE, uE})
    (hpairs : CyclicWeakBaseChangePairMultiplicityTCStatement.{uE, uE, uW, uW})
    (hfiber : CyclicCuspidalFiberStatement.{uE, uE, uW, uW})
    (hres : HeckeCharacter.CyclicPrimeNormCharacterRestrictionStatement.{uE, uE, uE})
    (htower : IsobaricWeakBaseChangeTowerStatement.{uE, uE, uE, uW, uW, uW})
    (hequiv : IsobaricWeakBaseChangeEquivarianceStatement.{uE, uE, uW, uW})
    (htwist : CuspidalDeterminantTwistArithmeticComapStatement.{uE, uE})
    (hexist : CuspidalSpectralAttachmentExistenceStatement.{uE, uW})
    (hcomap : CuspidalSpectralArithmeticComapStatement.{uE, uE, uW}) :
    ∀ (n : ℕ) (K : Type uE) (L : Type uE) [Field K] [NumberField K]
      [NumberField.IsTotallyComplex K] [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
      [CompactSpace (AdeleQuotient K)] [CompactSpace (AdeleQuotient L)]
      (ρ : L ≃ₐ[K] L), (∀ τ : L ≃ₐ[K] L, τ ∈ Subgroup.zpowers ρ) →
      Module.finrank K L < n →
      ∀ (r : ℕ) (T : CuspidalOperatorRealization L r), HasUnitaryCentralCharacter T →
        T.isoClass.IsGaloisStable ρ →
        ∃ S : CuspidalOperatorRealization K r, HasUnitaryCentralCharacter S ∧
          IsoClass.IsWeakBaseChangeOf.{uE, uE, uW, uW} T.isoClass S.isoClass := by
  intro n
  induction n with
  | zero =>
    intro K L _ _ _ _ _ _ _ _ _ _ _ hlt
    exact absurd hlt (Nat.not_lt_zero _)
  | succ n ih =>
    intro K L _ _ _ _ _ _ _ _ _ ρ hgen hlt r T hT hstable
    by_cases hone : Module.finrank K L = 1
    · exact exists_unitary_weakBaseChange_of_finrank_eq_one hexist hexist hcomap hone T hT
    by_cases hp : (Module.finrank K L).Prime
    · have : IsCyclic (L ≃ₐ[K] L) := ⟨⟨ρ, hgen⟩⟩
      obtain ⟨⟨η, hη⟩, -⟩ := HeckeCharacter.cyclicNormKernelCharacter K L
      exact hprime K L hp ρ hgen η hη r T hT hstable
    · exact exists_unitary_weakBaseChange_composite hprime hobs hpairs hfiber hres htower
        hequiv htwist
        (fun K' L' _ _ _ _ _ _ _ _ _ ρ' hgen' hlt' => ih K' L' ρ' hgen' (by omega))
        ρ hgen hone hp T hT hstable

/-- The unitary weak descent witness with the base field and the lower factors in
independent universes: degree one by arithmetic pullback, prime degree by prime stable
descent, and composite degree through the bottom prime step, using the same-universe
result for the upper part of the tower. -/
theorem exists_unitary_weakBaseChange
    (hprime : CyclicPrimeStableCuspidalDescentTCStatement.{uF, uE, uV, uW})
    (hprime' : CyclicPrimeStableCuspidalDescentTCStatement.{uE, uE, uW, uW})
    (hobs : CyclicPrimeTwistedCuspidalObstructionTCStatement.{uF, uE})
    (hobs' : CyclicPrimeTwistedCuspidalObstructionTCStatement.{uE, uE})
    (hpairs' : CyclicWeakBaseChangePairMultiplicityTCStatement.{uE, uE, uW, uW})
    (hfiber' : CyclicCuspidalFiberStatement.{uE, uE, uW, uW})
    (hres : HeckeCharacter.CyclicPrimeNormCharacterRestrictionStatement.{uF, uE, uE})
    (hres' : HeckeCharacter.CyclicPrimeNormCharacterRestrictionStatement.{uE, uE, uE})
    (htower : IsobaricWeakBaseChangeTowerStatement.{uF, uE, uE, uV, uW, uW})
    (htower' : IsobaricWeakBaseChangeTowerStatement.{uE, uE, uE, uW, uW, uW})
    (hequiv' : IsobaricWeakBaseChangeEquivarianceStatement.{uE, uE, uW, uW})
    (htwist' : CuspidalDeterminantTwistArithmeticComapStatement.{uE, uE})
    (hexistV : CuspidalSpectralAttachmentExistenceStatement.{uE, uV})
    (hexistW : CuspidalSpectralAttachmentExistenceStatement.{uE, uW})
    (hcomap : CuspidalSpectralArithmeticComapStatement.{uF, uE, uV})
    (hcomap' : CuspidalSpectralArithmeticComapStatement.{uE, uE, uW})
    (F : Type uF) (E : Type uE) [Field F] [NumberField F] [NumberField.IsTotallyComplex F]
    [Field E] [NumberField E] [Algebra F E] [IsGalois F E]
    [CompactSpace (AdeleQuotient F)] [CompactSpace (AdeleQuotient E)]
    (σ : E ≃ₐ[F] E) (hgen : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    {r : ℕ} (T : CuspidalOperatorRealization E r) (hT : HasUnitaryCentralCharacter T)
    (hstable : T.isoClass.IsGaloisStable σ) :
    ∃ S : CuspidalOperatorRealization F r, HasUnitaryCentralCharacter S ∧
      IsoClass.IsWeakBaseChangeOf.{uF, uE, uV, uW} T.isoClass S.isoClass := by
  by_cases hone : Module.finrank F E = 1
  · exact exists_unitary_weakBaseChange_of_finrank_eq_one hexistV hexistW hcomap hone T hT
  by_cases hp : (Module.finrank F E).Prime
  · have : IsCyclic (E ≃ₐ[F] E) := ⟨⟨σ, hgen⟩⟩
    obtain ⟨⟨η, hη⟩, -⟩ := HeckeCharacter.cyclicNormKernelCharacter F E
    exact hprime F E hp σ hgen η hη r T hT hstable
  · exact exists_unitary_weakBaseChange_composite hprime hobs hpairs' hfiber' hres htower
      hequiv' htwist'
      (fun K L _ _ _ _ _ _ _ _ _ ρ hgenρ _ =>
        exists_unitary_weakBaseChange_sameUniverse hprime' hobs' hpairs' hfiber' hres' htower'
          hequiv' htwist' hexistW hcomap' (Module.finrank K L + 1) K L ρ hgenρ
          (Nat.lt_succ_self _))
      σ hgen hone hp T hT hstable

end CyclicStableDescentTC

open CyclicStableDescentTC in
/-- Prime stable descent, the prime twisted obstruction and the pair count over totally
complex bases, with the shared fibre, character, transfer, twist and attachment inputs,
imply the totally complex cyclic stable descent proposition. -/
theorem cyclicStableDescentTCReduction :
    CyclicStableDescentTCReductionStatement.{uF, uE, uV, uW} := by
  intro hprime hprime' hobs hobs' hpairs hpairs' hfiber hfiber' hres hres' htower htower'
    hequiv' htwist' hnormTwist hexistV hexistW hcomap hcomap' F E _ _ _ _ _ _ _ _ _ σ hgen
    η hη r T hT hstable
  have : IsCyclic (E ≃ₐ[F] E) := ⟨⟨σ, hgen⟩⟩
  obtain ⟨S, hS, hST⟩ := exists_unitary_weakBaseChange hprime hprime' hobs hobs' hpairs'
    hfiber' hres hres' htower htower' hequiv' htwist' hexistV hexistW hcomap hcomap'
    F E σ hgen T hT hstable
  have hnorm (i : ℕ) : (η ^ i).IsTrivialOnNorm E := fun x => by
    rw [ContinuousMonoidHom.pow_apply, hη.isTrivialOnNorm x, one_pow]
  refine ⟨S.isoClass, hST, fun i _ => ⟨_, IsoClass.isFiniteOrderDeterminantTwist_determinantTwist
    _ _ ((hnorm i).hasFiniteOrder E)⟩, fun c' => ⟨fun hc' => ?_, ?_⟩, ?_⟩
  · -- every lower cuspidal class lifting to `T` is a norm-character twist of `S`
    obtain ⟨s₁, t₁, hs₁, ht₁, h₁⟩ := id hST
    obtain ⟨s₂, t₂, hs₂, ht₂, h₂⟩ := hc'
    obtain ⟨χ, hχnorm, hχ⟩ := hfiber F E r S.isoClass c' s₁ s₂ hs₁ hs₂
      (sameResidueDegreePowers_of_isArithmeticWeakBaseChangeOf ht₁ ht₂ h₁ h₂)
    obtain ⟨-, hall⟩ := HeckeCharacter.cyclicNormKernelCharacter F E
    obtain ⟨i, hi, rfl⟩ := ((hall η hη).2 χ).mp hχnorm
    exact ⟨i, hi, hχ⟩
  · -- every norm-character twist of `S` lifts to `T`
    rintro ⟨i, -, hc'⟩
    exact hnormTwist F E r S.isoClass c' T.isoClass (η ^ i) (hnorm i) hc' hST
  · -- the twists by distinct powers are distinct
    intro i j c' hi hj hci hcj
    rcases le_total i j with hij | hij
    · have h := hcj.trans hci.symm
      rw [← pow_sub η hij] at h
      have := eq_zero_of_isFiniteOrderDeterminantTwist_self (hpairs F E) hη hS hT hST
        (lt_of_le_of_lt (Nat.sub_le j i) hj) h
      omega
    · have h := hci.trans hcj.symm
      rw [← pow_sub η hij] at h
      have := eq_zero_of_isFiniteOrderDeterminantTwist_self (hpairs F E) hη hS hT hST
        (lt_of_le_of_lt (Nat.sub_le i j) hi) h
      omega

end Langlands.Automorphic.Unramified
