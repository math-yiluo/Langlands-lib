import Langlands.Automorphic.OperatorSubquotientPlaceComponentComplex
import Langlands.Global.FiniteAdelicGL.OpenSubgroupInduction

/-!
# The place actions generate the operator algebra of an operator subquotient

The operator algebra `automorphicOperatorAlgebra F n` is generated by the finite adelic
translations, the compact translations at infinity and the universal enveloping algebra. This
module shows that, on any module with a smooth action of the operator algebra, these generators
are in turn controlled by the place actions: the local translations by `GL_n(F_v)` at the finite
places, and the compact translations and complexified Lie actions at the real and complex places.

* `subspaceStabilizer`: the endomorphisms of a module mapping a subspace `Γ` into itself.
* `operator_mem_subspaceStabilizer_of_place`: for an algebra homomorphism `ρ` from the operator
  algebra to `Module.End ℂ V` and a subspace `Γ` of `V` on whose vectors the finite adelic
  translations act smoothly, if `Γ` is stable under the place generators, then it is stable
  under every `ρ a`. Finite adelic translations reduce to local translations by
  `FiniteAdelicGL.induction_localInclusion`, compact translations are products of single-place
  translations, and the enveloping algebra is generated by the complexified Lie algebra, whose
  elements are sums of place Lie elements (`ArchimedeanGL.sum_placeLieInclusions`).
* `OperatorSubquotient.representation_mem_of_placeStable`: a subspace of an operator subquotient
  `Q` stable under the place actions is stable under the operator algebra.
* `OperatorSubquotient.representation_comm_of_placeComm`,
  `OperatorSubquotient.equivalenceOfPlaceComm`: a linear map between operator subquotients
  commuting with the place actions commutes with the operator algebra; a linear isomorphism
  doing so is an equivalence of operator subquotients. The proof applies the stability theorem
  to the graph of the map inside `Q × Q'`, with the operator algebra acting on both factors
  (`OperatorSubquotient.pairAction`).
* `OperatorSubquotient.localRepresentation_comm_of_ne`,
  `OperatorSubquotient.realPlaceCompactRepresentation_comm_of_ne`,
  `OperatorSubquotient.realPlaceCompactRepresentation_comm_complexPlace`,
  `OperatorSubquotient.complexPlaceCompactRepresentation_comm_of_ne`: commutation of the place
  actions at distinct places that are not already in the Library or the place component modules.
-/

noncomputable section

universe u

open scoped Classical TensorProduct

set_option autoImplicit false
set_option maxHeartbeats 400000

namespace Langlands.Automorphic

attribute [local instance 100] LieRing.ofAssociativeRing

open Langlands.Global Langlands.Global.ArchimedeanGL

local instance generationRationalGroup {F : Type u} [Field F] [NumberField F] {n : ℕ} :
    AddCommGroup (RationalInvariantFunctions F n) := Submodule.addCommGroup _
local instance generationContinuousGroup {F : Type u} [Field F] [NumberField F] {n : ℕ} :
    AddCommGroup (ContinuousRationalFunctions F n) := Submodule.addCommGroup _
local instance generationSmoothGroup {F : Type u} [Field F] [NumberField F] {n : ℕ} :
    AddCommGroup (FiniteSmoothRationalFunctions F n) := Submodule.addCommGroup _
local instance generationFormsGroup {F : Type u} [Field F] [NumberField F] {n : ℕ} :
    AddCommGroup (AutomorphicForms F n) := Submodule.addCommGroup _
local instance generationStableGroup {F : Type u} [Field F] [NumberField F] {n : ℕ} :
    AddCommGroup (StableAutomorphicFunctions F n) := Submodule.addCommGroup _
local instance generationSpaceGroup {F : Type u} [Field F] [NumberField F] {n : ℕ}
    (S : OperatorRealization F n) : AddCommGroup S.Space := Submodule.addCommGroup _

variable {F : Type u} [Field F] [NumberField F] {n : ℕ}

local notation "RP" =>
  {v : NumberField.InfinitePlace F // NumberField.InfinitePlace.IsReal v}
local notation "CP" =>
  {v : NumberField.InfinitePlace F // NumberField.InfinitePlace.IsComplex v}
local notation "RK" => Matrix.unitaryGroup (Fin n) ℝ
local notation "CK" => Matrix.unitaryGroup (Fin n) ℂ
local notation "RM" => Matrix (Fin n) (Fin n) ℝ
local notation "CM" => Matrix (Fin n) (Fin n) ℂ

/-! ### Stabilizers of subspaces -/

section Stabilizer

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The endomorphisms of `V` mapping the subspace `Γ` into itself, as a subalgebra of
`Module.End ℂ V`. -/
def subspaceStabilizer (Γ : Submodule ℂ V) : Subalgebra ℂ (Module.End ℂ V) where
  carrier := {A | ∀ x ∈ Γ, A x ∈ Γ}
  mul_mem' hA hB x hx := hA _ (hB x hx)
  one_mem' _ hx := hx
  add_mem' hA hB x hx := Γ.add_mem (hA x hx) (hB x hx)
  zero_mem' _ _ := Γ.zero_mem
  algebraMap_mem' c _ hx := Γ.smul_mem c hx

theorem mem_subspaceStabilizer {Γ : Submodule ℂ V} {A : Module.End ℂ V} :
    A ∈ subspaceStabilizer Γ ↔ ∀ x ∈ Γ, A x ∈ Γ :=
  Iff.rfl

end Stabilizer

/-! ### Generation of the operator algebra by the place actions -/

section Generation

variable {V : Type*} [AddCommGroup V] [Module ℂ V]
  (ρ : automorphicOperatorAlgebra F n →ₐ[ℂ] Module.End ℂ V) (Γ : Submodule ℂ V)

/-- The operator algebra is generated by the finite adelic translations, the compact
translations and the enveloping algebra. -/
theorem operator_mem_subspaceStabilizer
    (hfin : ∀ d : FiniteAdelicGL F n, ρ (finiteOperator F n d) ∈ subspaceStabilizer Γ)
    (hcpt : ∀ k : standardInfiniteCompact F n,
      ρ (compactOperator F n k) ∈ subspaceStabilizer Γ)
    (hdiff : ∀ u : EnvelopingAlgebra F n,
      ρ (differentialOperator F n u) ∈ subspaceStabilizer Γ)
    (a : automorphicOperatorAlgebra F n) : ρ a ∈ subspaceStabilizer Γ := by
  refine Algebra.adjoin_induction
    (p := fun a ha => ρ ⟨a, ha⟩ ∈ subspaceStabilizer Γ) ?_ ?_ ?_ ?_ a.property
  · rintro a ((⟨d, rfl⟩ | ⟨k, rfl⟩) | ⟨u, rfl⟩)
    · exact hfin d
    · exact hcpt k
    · exact hdiff u
  · intro c
    have e : ρ (algebraMap ℂ (automorphicOperatorAlgebra F n) c) =
        algebraMap ℂ (Module.End ℂ V) c := ρ.commutes c
    exact (congrArg (· ∈ subspaceStabilizer Γ) e).mpr
      ((subspaceStabilizer Γ).algebraMap_mem c)
  · intro a b ha hb h₁ h₂
    have e : ρ (⟨a, ha⟩ + ⟨b, hb⟩) = ρ ⟨a, ha⟩ + ρ ⟨b, hb⟩ := map_add ρ _ _
    exact (congrArg (· ∈ subspaceStabilizer Γ) e).mpr (add_mem h₁ h₂)
  · intro a b ha hb h₁ h₂
    have e : ρ (⟨a, ha⟩ * ⟨b, hb⟩) = ρ ⟨a, ha⟩ * ρ ⟨b, hb⟩ := map_mul ρ _ _
    exact (congrArg (· ∈ subspaceStabilizer Γ) e).mpr (mul_mem h₁ h₂)

/-- Finite adelic translations stabilize a subspace stable under the local translations, provided
every vector of the subspace is fixed by an open subgroup. -/
theorem finite_mem_subspaceStabilizer
    (hsm : ∀ x ∈ Γ, ∃ L : OpenSubgroup (FiniteAdelicGL F n),
      ∀ ℓ ∈ L, ρ (finiteOperator F n ℓ) x = x)
    (hloc : ∀ (v : FinitePlace F) (g : FiniteLocalGL F n v),
      ρ (finiteOperator F n (FiniteAdelicGL.localInclusion F n v g)) ∈ subspaceStabilizer Γ)
    (d : FiniteAdelicGL F n) : ρ (finiteOperator F n d) ∈ subspaceStabilizer Γ := by
  intro x hx
  obtain ⟨L, hL⟩ := hsm x hx
  refine FiniteAdelicGL.induction_localInclusion
    (P := fun d => ρ (finiteOperator F n d) x ∈ Γ) L ?_ ?_ d
  · intro ℓ hℓ
    exact (congrArg (· ∈ Γ) (hL ℓ hℓ)).mpr hx
  · intro v g d hd
    have e : ρ (finiteOperator F n (FiniteAdelicGL.localInclusion F n v g * d)) x =
        ρ (finiteOperator F n (FiniteAdelicGL.localInclusion F n v g))
          (ρ (finiteOperator F n d) x) := by
      rw [map_mul, map_mul, Module.End.mul_apply]
    exact (congrArg (· ∈ Γ) e).mpr (hloc v g _ hd)

/-- Compact translations stabilize a subspace stable under the compact translations at the real
and complex places. -/
theorem compact_mem_subspaceStabilizer
    (hrk : ∀ (v : RP) (k : RK),
      ρ (compactOperator F n (realPlaceCompactInclusion F n v k)) ∈ subspaceStabilizer Γ)
    (hck : ∀ (v : CP) (k : CK),
      ρ (compactOperator F n (complexPlaceCompactInclusion F n v k)) ∈ subspaceStabilizer Γ)
    (k : standardInfiniteCompact F n) : ρ (compactOperator F n k) ∈ subspaceStabilizer Γ := by
  let M : Submonoid (ArchimedeanCompactFactors F n) :=
    (subspaceStabilizer Γ).toSubmonoid.comap (ρ.toMonoidHom.comp
      ((compactOperator F n).comp (ArchimedeanCompactFactors.toStandardCompact F n).toMonoidHom))
  have hM : ∀ q : ArchimedeanCompactFactors F n, q ∈ M ↔
      ρ (compactOperator F n (ArchimedeanCompactFactors.toStandardCompact F n q)) ∈
        subspaceStabilizer Γ :=
    fun q => Iff.rfl
  have hreal : ∀ x : RP → RK, MonoidHom.inl (RP → RK) (CP → CK) x ∈ M := by
    intro x
    refine Submonoid.pi_mem_of_mulSingle_mem (H := M.comap (MonoidHom.inl (RP → RK) (CP → CK)))
      x fun v => ?_
    have e : realPlaceCompactInclusion F n v (x v) =
        ArchimedeanCompactFactors.toStandardCompact F n
          (MonoidHom.inl (RP → RK) (CP → CK) (Pi.mulSingle v (x v))) := rfl
    exact (hM _).mpr ((congrArg (fun k => ρ (compactOperator F n k) ∈ subspaceStabilizer Γ)
      e).mp (hrk v (x v)))
  have hcomplex : ∀ x : CP → CK, MonoidHom.inr (RP → RK) (CP → CK) x ∈ M := by
    intro x
    refine Submonoid.pi_mem_of_mulSingle_mem (H := M.comap (MonoidHom.inr (RP → RK) (CP → CK)))
      x fun v => ?_
    have e : complexPlaceCompactInclusion F n v (x v) =
        ArchimedeanCompactFactors.toStandardCompact F n
          (MonoidHom.inr (RP → RK) (CP → CK) (Pi.mulSingle v (x v))) := rfl
    exact (hM _).mpr ((congrArg (fun k => ρ (compactOperator F n k) ∈ subspaceStabilizer Γ)
      e).mp (hck v (x v)))
  obtain ⟨q, rfl⟩ := ArchimedeanCompactFactors.toStandardCompact_surjective F n k
  have hq : q = MonoidHom.inl (RP → RK) (CP → CK) q.1 * MonoidHom.inr (RP → RK) (CP → CK) q.2 :=
    Prod.ext (mul_one q.1).symm (one_mul q.2).symm
  have hmem : q ∈ M := hq ▸ M.mul_mem (hreal q.1) (hcomplex q.2)
  exact (hM q).mp hmem

/-- The enveloping algebra stabilizes a subspace stable under the complexified Lie actions at the
real and complex places. -/
theorem differential_mem_subspaceStabilizer
    (hrl : ∀ (v : RP) (X : ℂ ⊗[ℝ] RM),
      ρ (differentialOperator F n (envelopingGenerator F n (realPlaceComplexLieInclusion F n v X)))
        ∈ subspaceStabilizer Γ)
    (hcl : ∀ (v : CP) (X : ℂ ⊗[ℝ] CM),
      ρ (differentialOperator F n
        (envelopingGenerator F n (complexPlaceComplexLieInclusion F n v X))) ∈
        subspaceStabilizer Γ)
    (u : EnvelopingAlgebra F n) : ρ (differentialOperator F n u) ∈ subspaceStabilizer Γ := by
  let T : Subalgebra ℂ (EnvelopingAlgebra F n) :=
    (subspaceStabilizer Γ).comap (ρ.comp (differentialOperator F n))
  let N : Submodule ℂ (ComplexLieAlgebra F n) :=
    (Subalgebra.toSubmodule T).comap (envelopingGenerator F n).toLinearMap
  have hN : ∀ X : RealLieAlgebra F n, complexify F n X ∈ N := by
    intro X
    have hsum := congrArg (complexify F n) (sum_placeLieInclusions F n X)
    rw [← hsum, map_add, map_sum, map_sum]
    refine N.add_mem (N.sum_mem fun v _ => ?_) (N.sum_mem fun v _ => ?_)
    · have e : complexify F n (realPlaceLieInclusion F n v (realPlaceLieProjection F n v X)) =
          realPlaceComplexLieInclusion F n v
            ((1 : ℂ) ⊗ₜ[ℝ] realPlaceLieProjection F n v X) := rfl
      rw [e]
      exact hrl v _
    · have e : complexify F n
            (complexPlaceLieInclusion F n v (complexPlaceLieProjection F n v X)) =
          complexPlaceComplexLieInclusion F n v
            ((1 : ℂ) ⊗ₜ[ℝ] complexPlaceLieProjection F n v X) := rfl
      rw [e]
      exact hcl v _
  have hgen : ∀ Y : ComplexLieAlgebra F n, Y ∈ N := by
    intro Y
    induction Y using TensorProduct.inductionOn with
    | tmul z X =>
      have hzX : z ⊗ₜ[ℝ] X = z • complexify F n X := by
        rw [complexify_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hzX]
      exact N.smul_mem z (hN X)
    | add Y₁ Y₂ h₁ h₂ => exact N.add_mem h₁ h₂
  have hadj : Algebra.adjoin ℂ
      (Set.range (UniversalEnvelopingAlgebra.ι ℂ :
        ComplexLieAlgebra F n → EnvelopingAlgebra F n)) ≤ T := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨Y, rfl⟩
    exact hgen Y
  have hu : u ∈ Algebra.adjoin ℂ
      (Set.range (UniversalEnvelopingAlgebra.ι ℂ :
        ComplexLieAlgebra F n → EnvelopingAlgebra F n)) := by
    rw [Langlands.Algebra.LieCasimir.enveloping_adjoin_range]
    trivial
  exact hadj hu

/-- **Generation by the place actions.** Let the operator algebra act on `V` through `ρ`, and let
`Γ` be a subspace of `V` each of whose vectors is fixed by the finite adelic translations in some
open subgroup. If `Γ` is stable under the local translations at the finite places and under the
compact translations and complexified Lie actions at the real and complex places, then `Γ` is
stable under `ρ a` for every element `a` of the operator algebra. -/
theorem operator_mem_subspaceStabilizer_of_place
    (hsm : ∀ x ∈ Γ, ∃ L : OpenSubgroup (FiniteAdelicGL F n),
      ∀ ℓ ∈ L, ρ (finiteOperator F n ℓ) x = x)
    (hloc : ∀ (v : FinitePlace F) (g : FiniteLocalGL F n v),
      ρ (finiteOperator F n (FiniteAdelicGL.localInclusion F n v g)) ∈ subspaceStabilizer Γ)
    (hrk : ∀ (v : RP) (k : RK),
      ρ (compactOperator F n (realPlaceCompactInclusion F n v k)) ∈ subspaceStabilizer Γ)
    (hck : ∀ (v : CP) (k : CK),
      ρ (compactOperator F n (complexPlaceCompactInclusion F n v k)) ∈ subspaceStabilizer Γ)
    (hrl : ∀ (v : RP) (X : ℂ ⊗[ℝ] RM),
      ρ (differentialOperator F n (envelopingGenerator F n (realPlaceComplexLieInclusion F n v X)))
        ∈ subspaceStabilizer Γ)
    (hcl : ∀ (v : CP) (X : ℂ ⊗[ℝ] CM),
      ρ (differentialOperator F n
        (envelopingGenerator F n (complexPlaceComplexLieInclusion F n v X))) ∈
        subspaceStabilizer Γ)
    (a : automorphicOperatorAlgebra F n) : ρ a ∈ subspaceStabilizer Γ :=
  operator_mem_subspaceStabilizer ρ Γ (finite_mem_subspaceStabilizer ρ Γ hsm hloc)
    (compact_mem_subspaceStabilizer ρ Γ hrk hck)
    (differential_mem_subspaceStabilizer ρ Γ hrl hcl) a

end Generation

namespace OperatorSubquotient

variable (Q Q' : OperatorSubquotient F n)

/-! ### Commutation of place actions at distinct places -/

/-- Local translations at distinct finite places commute. -/
theorem localRepresentation_comm_of_ne {v w : FinitePlace F} (h : v ≠ w)
    (g : FiniteLocalGL F n v) (g' : FiniteLocalGL F n w) (x : Q.Space) :
    Q.localRepresentation v g (Q.localRepresentation w g' x) =
      Q.localRepresentation w g' (Q.localRepresentation v g x) := by
  have hc := (FiniteAdelicGL.localInclusion_commute F n v w h g g').eq
  calc Q.localRepresentation v g (Q.localRepresentation w g' x)
      = Q.finiteRepresentation (FiniteAdelicGL.localInclusion F n v g *
          FiniteAdelicGL.localInclusion F n w g') x :=
        (LinearMap.congr_fun (map_mul Q.finiteRepresentation _ _) x).symm
    _ = Q.finiteRepresentation (FiniteAdelicGL.localInclusion F n w g' *
          FiniteAdelicGL.localInclusion F n v g) x :=
        congrArg (fun e => Q.finiteRepresentation e x) hc
    _ = Q.localRepresentation w g' (Q.localRepresentation v g x) :=
        LinearMap.congr_fun (map_mul Q.finiteRepresentation _ _) x

/-- Compact translations at distinct real places commute. -/
theorem realPlaceCompactRepresentation_comm_of_ne {v w : RP} (h : w ≠ v) (k l : RK)
    (y : Q.Space) :
    Q.realPlaceCompactRepresentation w l (Q.realPlaceCompactRepresentation v k y) =
      Q.realPlaceCompactRepresentation v k (Q.realPlaceCompactRepresentation w l y) :=
  Q.compact_comm_realPlaceCompact v
    (q := ArchimedeanCompactFactors.realPlaceFactor F n w l)
    (by rw [ArchimedeanCompactFactors.realPlaceFactor_fst, Pi.mulSingle_eq_of_ne h.symm]) k y

/-- Compact translations at a real and at a complex place commute. -/
theorem realPlaceCompactRepresentation_comm_complexPlace (v : RP) (w : CP) (k : RK) (l : CK)
    (y : Q.Space) :
    Q.complexPlaceCompactRepresentation w l (Q.realPlaceCompactRepresentation v k y) =
      Q.realPlaceCompactRepresentation v k (Q.complexPlaceCompactRepresentation w l y) :=
  Q.compact_comm_realPlaceCompact v
    (q := ArchimedeanCompactFactors.complexPlaceFactor F n w l)
    (ArchimedeanCompactFactors.complexPlaceFactor_fst F n w v l) k y

/-- Compact translations at distinct complex places commute. -/
theorem complexPlaceCompactRepresentation_comm_of_ne {v w : CP} (h : w ≠ v) (k l : CK)
    (y : Q.Space) :
    Q.complexPlaceCompactRepresentation w l (Q.complexPlaceCompactRepresentation v k y) =
      Q.complexPlaceCompactRepresentation v k (Q.complexPlaceCompactRepresentation w l y) :=
  Q.compact_comm_complexPlaceCompact v
    (q := ArchimedeanCompactFactors.complexPlaceFactor F n w l)
    (by rw [ArchimedeanCompactFactors.complexPlaceFactor_snd, Pi.mulSingle_eq_of_ne h.symm])
    k y

/-! ### The place generators inside the operator action -/

theorem operatorAction_finite (d : FiniteAdelicGL F n) (x : Q.Space) :
    Q.operatorAction (finiteOperator F n d) x = Q.finiteRepresentation d x :=
  rfl

theorem operatorAction_localInclusion (v : FinitePlace F) (g : FiniteLocalGL F n v)
    (x : Q.Space) :
    Q.operatorAction (finiteOperator F n (FiniteAdelicGL.localInclusion F n v g)) x =
      Q.localRepresentation v g x :=
  rfl

theorem operatorAction_realPlaceCompact (v : RP) (k : RK) (x : Q.Space) :
    Q.operatorAction (compactOperator F n (realPlaceCompactInclusion F n v k)) x =
      Q.realPlaceCompactRepresentation v k x :=
  rfl

theorem operatorAction_complexPlaceCompact (v : CP) (k : CK) (x : Q.Space) :
    Q.operatorAction (compactOperator F n (complexPlaceCompactInclusion F n v k)) x =
      Q.complexPlaceCompactRepresentation v k x :=
  rfl

theorem operatorAction_realPlaceLie (v : RP) (X : ℂ ⊗[ℝ] RM) (x : Q.Space) :
    Q.operatorAction
        (differentialOperator F n (envelopingGenerator F n (realPlaceComplexLieInclusion F n v X)))
        x =
      Q.realPlaceLieAction v X x :=
  rfl

theorem operatorAction_complexPlaceLie (v : CP) (X : ℂ ⊗[ℝ] CM) (x : Q.Space) :
    Q.operatorAction
        (differentialOperator F n
          (envelopingGenerator F n (complexPlaceComplexLieInclusion F n v X))) x =
      Q.complexPlaceLieAction v X x :=
  rfl

theorem operatorAction_apply (a : automorphicOperatorAlgebra F n) (x : Q.Space) :
    Q.operatorAction a x = Q.representation a x :=
  rfl

/-! ### Stable subspaces -/

/-- **Operator stability.** A subspace of `Q` stable under the local translations at the
finite places and under the compact translations and complexified Lie actions at the real and
complex places is stable under the operator algebra. -/
theorem representation_mem_of_placeStable (Z : Submodule ℂ Q.Space)
    (hfin : ∀ (v : FinitePlace F) (g : FiniteLocalGL F n v), ∀ x ∈ Z,
      Q.localRepresentation v g x ∈ Z)
    (hrk : ∀ (v : RP) (k : RK), ∀ x ∈ Z, Q.realPlaceCompactRepresentation v k x ∈ Z)
    (hrl : ∀ (v : RP) (X : ℂ ⊗[ℝ] RM), ∀ x ∈ Z, Q.realPlaceLieAction v X x ∈ Z)
    (hck : ∀ (v : CP) (k : CK), ∀ x ∈ Z, Q.complexPlaceCompactRepresentation v k x ∈ Z)
    (hcl : ∀ (v : CP) (X : ℂ ⊗[ℝ] CM), ∀ x ∈ Z, Q.complexPlaceLieAction v X x ∈ Z)
    (a : automorphicOperatorAlgebra F n) : ∀ x ∈ Z, Q.representation a x ∈ Z := by
  have h := operator_mem_subspaceStabilizer_of_place Q.operatorAction Z
    (fun x _ => Exists.elim (Q.finiteRepresentation_isSmooth x) fun L hL =>
      ⟨L, fun ℓ hℓ => (Q.operatorAction_finite ℓ x).trans (hL ⟨ℓ, hℓ⟩)⟩)
    (fun v g => mem_subspaceStabilizer.mpr fun x hx =>
      (congrArg (· ∈ Z) (Q.operatorAction_localInclusion v g x)).mpr (hfin v g x hx))
    (fun v k => mem_subspaceStabilizer.mpr fun x hx =>
      (congrArg (· ∈ Z) (Q.operatorAction_realPlaceCompact v k x)).mpr (hrk v k x hx))
    (fun v k => mem_subspaceStabilizer.mpr fun x hx =>
      (congrArg (· ∈ Z) (Q.operatorAction_complexPlaceCompact v k x)).mpr (hck v k x hx))
    (fun v X => mem_subspaceStabilizer.mpr fun x hx =>
      (congrArg (· ∈ Z) (Q.operatorAction_realPlaceLie v X x)).mpr (hrl v X x hx))
    (fun v X => mem_subspaceStabilizer.mpr fun x hx =>
      (congrArg (· ∈ Z) (Q.operatorAction_complexPlaceLie v X x)).mpr (hcl v X x hx)) a
  exact fun x hx => (congrArg (· ∈ Z) (Q.operatorAction_apply a x)).mp
    (mem_subspaceStabilizer.mp h x hx)

/-! ### Commuting linear maps -/

/-- The operator algebra acting on both factors of `Q × Q'`. -/
def pairAction :
    automorphicOperatorAlgebra F n →ₐ[ℂ] Module.End ℂ (Q.Space × Q'.Space) :=
  (LinearMap.prodMapAlgHom ℂ Q.Space Q'.Space).comp (Q.operatorAction.prod Q'.operatorAction)

theorem pairAction_fst (a : automorphicOperatorAlgebra F n) (p : Q.Space × Q'.Space) :
    (Q.pairAction Q' a p).1 = Q.operatorAction a p.1 :=
  rfl

theorem pairAction_snd (a : automorphicOperatorAlgebra F n) (p : Q.Space × Q'.Space) :
    (Q.pairAction Q' a p).2 = Q'.operatorAction a p.2 :=
  rfl

/-- An operator commuting with `φ` on both sides maps the graph of `φ` into itself. -/
theorem pairAction_mem_subspaceStabilizer_graph (φ : Q.Space →ₗ[ℂ] Q'.Space)
    (a : automorphicOperatorAlgebra F n)
    (h : ∀ x, φ (Q.operatorAction a x) = Q'.operatorAction a (φ x)) :
    Q.pairAction Q' a ∈ subspaceStabilizer φ.graph := by
  refine mem_subspaceStabilizer.mpr fun p hp => (φ.mem_graph_iff _).mpr ?_
  have hp' : p.2 = φ p.1 := (φ.mem_graph_iff p).mp hp
  have e : Q'.operatorAction a p.2 = φ (Q.operatorAction a p.1) :=
    (congrArg (Q'.operatorAction a) hp').trans (h p.1).symm
  exact ((Q.pairAction_snd Q' a p).trans e).trans
    (congrArg φ (Q.pairAction_fst Q' a p)).symm

/-- **Operator commutation.** A linear map from `Q` to `Q'` commuting with the local
translations at the finite places and with the compact translations and complexified Lie
actions at the real and complex places commutes with the operator algebra. -/
theorem representation_comm_of_placeComm (φ : Q.Space →ₗ[ℂ] Q'.Space)
    (hfin : ∀ (v : FinitePlace F) (g : FiniteLocalGL F n v) (x : Q.Space),
      φ (Q.localRepresentation v g x) = Q'.localRepresentation v g (φ x))
    (hrk : ∀ (v : RP) (k : RK) (x : Q.Space),
      φ (Q.realPlaceCompactRepresentation v k x) = Q'.realPlaceCompactRepresentation v k (φ x))
    (hrl : ∀ (v : RP) (X : ℂ ⊗[ℝ] RM) (x : Q.Space),
      φ (Q.realPlaceLieAction v X x) = Q'.realPlaceLieAction v X (φ x))
    (hck : ∀ (v : CP) (k : CK) (x : Q.Space),
      φ (Q.complexPlaceCompactRepresentation v k x) =
        Q'.complexPlaceCompactRepresentation v k (φ x))
    (hcl : ∀ (v : CP) (X : ℂ ⊗[ℝ] CM) (x : Q.Space),
      φ (Q.complexPlaceLieAction v X x) = Q'.complexPlaceLieAction v X (φ x))
    (a : automorphicOperatorAlgebra F n) (x : Q.Space) :
    φ (Q.representation a x) = Q'.representation a (φ x) := by
  have hsm : ∀ p ∈ φ.graph, ∃ L : OpenSubgroup (FiniteAdelicGL F n),
      ∀ ℓ ∈ L, Q.pairAction Q' (finiteOperator F n ℓ) p = p := fun p _ =>
    Exists.elim (Q.finiteRepresentation_isSmooth p.1) fun L₁ hL₁ =>
      Exists.elim (Q'.finiteRepresentation_isSmooth p.2) fun L₂ hL₂ =>
        ⟨L₁ ⊓ L₂, fun ℓ hℓ => Prod.ext
          (((Q.pairAction_fst Q' _ p).trans (Q.operatorAction_finite ℓ p.1)).trans
            (hL₁ ⟨ℓ, (OpenSubgroup.mem_inf.mp hℓ).1⟩))
          (((Q.pairAction_snd Q' _ p).trans (Q'.operatorAction_finite ℓ p.2)).trans
            (hL₂ ⟨ℓ, (OpenSubgroup.mem_inf.mp hℓ).2⟩))⟩
  have h := operator_mem_subspaceStabilizer_of_place (Q.pairAction Q') φ.graph hsm
    (fun v g => Q.pairAction_mem_subspaceStabilizer_graph Q' φ _ fun x =>
      ((congrArg φ (Q.operatorAction_localInclusion v g x)).trans (hfin v g x)).trans
        (Q'.operatorAction_localInclusion v g (φ x)).symm)
    (fun v k => Q.pairAction_mem_subspaceStabilizer_graph Q' φ _ fun x =>
      ((congrArg φ (Q.operatorAction_realPlaceCompact v k x)).trans (hrk v k x)).trans
        (Q'.operatorAction_realPlaceCompact v k (φ x)).symm)
    (fun v k => Q.pairAction_mem_subspaceStabilizer_graph Q' φ _ fun x =>
      ((congrArg φ (Q.operatorAction_complexPlaceCompact v k x)).trans (hck v k x)).trans
        (Q'.operatorAction_complexPlaceCompact v k (φ x)).symm)
    (fun v X => Q.pairAction_mem_subspaceStabilizer_graph Q' φ _ fun x =>
      ((congrArg φ (Q.operatorAction_realPlaceLie v X x)).trans (hrl v X x)).trans
        (Q'.operatorAction_realPlaceLie v X (φ x)).symm)
    (fun v X => Q.pairAction_mem_subspaceStabilizer_graph Q' φ _ fun x =>
      ((congrArg φ (Q.operatorAction_complexPlaceLie v X x)).trans (hcl v X x)).trans
        (Q'.operatorAction_complexPlaceLie v X (φ x)).symm) a
  have hx : (x, φ x) ∈ φ.graph := (φ.mem_graph_iff _).mpr rfl
  have hmem := (φ.mem_graph_iff _).mp (mem_subspaceStabilizer.mp h (x, φ x) hx)
  have e : Q'.operatorAction a (φ x) = φ (Q.operatorAction a x) :=
    ((Q.pairAction_snd Q' a (x, φ x)).symm.trans hmem).trans
      (congrArg φ (Q.pairAction_fst Q' a (x, φ x)))
  exact (congrArg φ (Q.operatorAction_apply a x)).symm.trans
    (e.symm.trans (Q'.operatorAction_apply a (φ x)))

/-- A linear isomorphism from `Q` to `Q'` commuting with the place actions is an equivalence
of operator subquotients. -/
def equivalenceOfPlaceComm (φ : Q.Space ≃ₗ[ℂ] Q'.Space)
    (hfin : ∀ (v : FinitePlace F) (g : FiniteLocalGL F n v) (x : Q.Space),
      φ (Q.localRepresentation v g x) = Q'.localRepresentation v g (φ x))
    (hrk : ∀ (v : RP) (k : RK) (x : Q.Space),
      φ (Q.realPlaceCompactRepresentation v k x) = Q'.realPlaceCompactRepresentation v k (φ x))
    (hrl : ∀ (v : RP) (X : ℂ ⊗[ℝ] RM) (x : Q.Space),
      φ (Q.realPlaceLieAction v X x) = Q'.realPlaceLieAction v X (φ x))
    (hck : ∀ (v : CP) (k : CK) (x : Q.Space),
      φ (Q.complexPlaceCompactRepresentation v k x) =
        Q'.complexPlaceCompactRepresentation v k (φ x))
    (hcl : ∀ (v : CP) (X : ℂ ⊗[ℝ] CM) (x : Q.Space),
      φ (Q.complexPlaceLieAction v X x) = Q'.complexPlaceLieAction v X (φ x)) :
    Q.Equivalence Q' :=
  Representation.Equiv.mk φ fun a => LinearMap.ext fun x =>
    Q.representation_comm_of_placeComm Q' φ.toLinearMap hfin hrk hrl hck hcl a x

end OperatorSubquotient

end Langlands.Automorphic
