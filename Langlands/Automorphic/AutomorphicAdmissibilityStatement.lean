import Langlands.Automorphic.UnitaryContragredientCriterion
import Langlands.Automorphic.OperatorSubquotient

/-!
# Harish-Chandra finiteness and admissibility of automorphic representations of `GL_n`

Borel and Jacquet (Corvallis 1979), §4.3 (i), Proposition 4.5 (1) ⇒ (4) and §4.6, for
`GL_n` over a number field `F`.

* `centerAnnihilatedForms F n J`: the automorphic forms annihilated by an ideal `J` of the
  center of the archimedean enveloping algebra.
* `annihilatedFormMultiplicitySpace F n J L σ`: the `K_∞`-equivariant maps from `σ` into
  the automorphic forms that are fixed by `L` and annihilated by `J`.
* `HarishChandraFinitenessStatement`: these spaces are finite-dimensional when `J` has
  finite codimension.
* `GeneratedFormAdmissibilityStatement`: the realization generated by any automorphic form
  under finite adelic translations, the standard compact subgroup at infinity and the
  archimedean enveloping algebra is jointly admissible.
* `OperatorSubquotient.IsJointlyAdmissible`: joint admissibility of the finite adelic and
  compact actions on an operator subquotient.
* `IrreducibleSubquotientAdmissibilityStatement`: every irreducible operator subquotient
  (automorphic representation) is jointly admissible.
-/

noncomputable section
universe u
set_option autoImplicit false

namespace Langlands.Automorphic

open Langlands.Global

local instance admissibilityRationalGroup (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (RationalInvariantFunctions F n) := Submodule.addCommGroup _
local instance admissibilityContinuousGroup (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (ContinuousRationalFunctions F n) := Submodule.addCommGroup _
local instance admissibilitySmoothGroup (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (FiniteSmoothRationalFunctions F n) := Submodule.addCommGroup _
local instance admissibilityFormGroup (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (AutomorphicForms F n) := Submodule.addCommGroup _
local instance admissibilityStableGroup (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (StableAutomorphicFunctions F n) := Submodule.addCommGroup _
local instance admissibilityRealizationGroup {F : Type u} [Field F] [NumberField F] {n : ℕ}
    (S : OperatorRealization F n) : AddCommGroup S.Space := Submodule.addCommGroup _

section HarishChandra

variable (F : Type u) [Field F] [NumberField F] (n : ℕ)

/-- The automorphic forms annihilated by every element of an ideal `J` of the center of the
archimedean enveloping algebra. -/
def centerAnnihilatedForms (J : Ideal (ArchimedeanGL.EnvelopingCenter F n)) :
    Submodule ℂ (AutomorphicForms F n) :=
  ⨅ z ∈ J, LinearMap.ker
    (automorphicEnvelopingAction F n (z : ArchimedeanGL.EnvelopingAlgebra F n))

/-- The `K_∞`-equivariant linear maps from a representation `σ` of the standard compact
subgroup at infinity on `Fin m → ℂ` into the automorphic forms that are fixed by `L` under
finite adelic translation and annihilated by `J`. -/
def annihilatedFormMultiplicitySpace (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (L : Subgroup (FiniteAdelicGL F n)) {m : ℕ}
    (σ : Representation ℂ (standardInfiniteCompact F n) (Fin m → ℂ)) :
    Submodule ℂ ((Fin m → ℂ) →ₗ[ℂ] AutomorphicForms F n) :=
  Langlands.jointMultiplicitySpace (automorphicFiniteRightAction F n)
      (automorphicCompactRightAction F n) L σ ⊓
    ⨅ v : Fin m → ℂ, (centerAnnihilatedForms F n J).comap (LinearMap.applyₗ v)

end HarishChandra

/-- **Harish-Chandra's finiteness theorem** in the form of Borel–Jacquet §4.3 (i), for
`GL_n` over a number field: for an ideal `J` of finite codimension in the center of the
archimedean enveloping algebra, every open subgroup `L` of the finite adelic group and every
finite-dimensional representation `σ` of the standard compact subgroup at infinity, the
`σ`-multiplicity space of the `L`-fixed automorphic forms annihilated by `J` is
finite-dimensional. -/
def HarishChandraFinitenessStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F] (n : ℕ)
    (J : Ideal (ArchimedeanGL.EnvelopingCenter F n)),
    Module.Finite ℂ (ArchimedeanGL.EnvelopingCenter F n ⧸ J.restrictScalars ℂ) →
    ∀ (L : OpenSubgroup (FiniteAdelicGL F n)) (m : ℕ)
      (σ : Representation ℂ (standardInfiniteCompact F n) (Fin m → ℂ)),
      FiniteDimensional ℂ (annihilatedFormMultiplicitySpace F n J L.toSubgroup σ)

/-- Joint admissibility of an operator subquotient: its finite adelic action and the action
of the standard compact subgroup at infinity on the quotient space. -/
def OperatorSubquotient.IsJointlyAdmissible {F : Type u} [Field F] [NumberField F] {n : ℕ}
    (Q : OperatorSubquotient F n) : Prop :=
  Langlands.IsJointlyAdmissible Q.finiteRepresentation Q.compactRepresentation

/-- **Borel–Jacquet, Proposition 4.5 (1) ⇒ (4)** for `GL_n` over a number field: the
realization generated by an automorphic form is jointly admissible. -/
def GeneratedFormAdmissibilityStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F] (n : ℕ) (f : AutomorphicForms F n),
    (generatedFormOperatorRealization F n f).IsJointlyAdmissible

/-- **Borel–Jacquet, §4.6** for `GL_n` over a number field: every irreducible operator
subquotient is jointly admissible. -/
def IrreducibleSubquotientAdmissibilityStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F] (n : ℕ) (Q : OperatorSubquotient F n),
    Q.IsIrreducible → Q.IsJointlyAdmissible

end Langlands.Automorphic
