import Langlands.Automorphic.CuspidalWhittaker.QuotientTorus
import Langlands.Automorphic.CuspidalWhittaker.AdelicCharacter
import Mathlib.Topology.ContinuousMap.StoneWeierstrass

/-!
# Fourier uniqueness on powers of `𝔸_K / K`

The characters `y ↦ ψ(∑ᵢ aᵢ yᵢ)`, `a ∈ K^ι`, of `𝔸_K^ι` are trivial on `K^ι`. By the
self-duality of `K` they separate the points of the torus `(𝔸_K / K)^ι`, so by Stone–Weierstrass
their span is dense in the continuous functions. Consequently a continuous periodic function all
of whose Fourier coefficients vanish is zero.
-/

noncomputable section

universe u

open MeasureTheory Complex Submodule Algebra
open scoped ComplexConjugate

namespace Langlands.Automorphic.CuspidalWhittaker

open Langlands.Global

variable {K : Type u} [Field K] [NumberField K] {ι : Type*} [Fintype ι]

/-- The character `y ↦ ψ(∑ᵢ aᵢ yᵢ)` of `𝔸_K^ι`, with complex values. -/
def pairingCharacter (a : ι → K) (y : ι → Adeles K) : ℂ :=
  (adelicCharacter K (∑ i, algebraMap K (Adeles K) (a i) * y i) : ℂ)

theorem pairingCharacter_add_left (a b : ι → K) (y : ι → Adeles K) :
    pairingCharacter (a + b) y = pairingCharacter a y * pairingCharacter b y := by
  simp only [pairingCharacter, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib,
    AddChar.map_add_eq_mul, Circle.coe_mul]

theorem pairingCharacter_neg (a : ι → K) (y : ι → Adeles K) :
    pairingCharacter (-a) y = conj (pairingCharacter a y) := by
  simp only [pairingCharacter, Pi.neg_apply, map_neg, neg_mul, Finset.sum_neg_distrib,
    AddChar.map_neg_eq_inv, Circle.coe_inv_eq_conj]

theorem pairingCharacter_zero (y : ι → Adeles K) : pairingCharacter (0 : ι → K) y = 1 := by
  simp [pairingCharacter]

theorem pairingCharacter_single [DecidableEq ι] (i : ι) (c : K) (y : ι → Adeles K) :
    pairingCharacter (Pi.single i c) y = (adelicCharacter K (algebraMap K (Adeles K) c * y i) : ℂ) := by
  rw [pairingCharacter, Finset.sum_eq_single i]
  · rw [Pi.single_eq_same]
  · intro j _ hj
    rw [Pi.single_eq_of_ne hj, map_zero, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ i) h

theorem isPeriodic_pairingCharacter (a : ι → K) : IsPeriodic (pairingCharacter (K := K) a) := by
  intro y k
  have h : ∑ i, algebraMap K (Adeles K) (a i) * (y + ratVec k) i =
      (∑ i, algebraMap K (Adeles K) (a i) * y i) + algebraMap K (Adeles K) (∑ i, a i * k i) := by
    simp only [Pi.add_apply, ratVec_apply, mul_add, Finset.sum_add_distrib, map_sum, map_mul]
  simp only [pairingCharacter, h, AddChar.map_add_eq_mul, adelicCharacter_algebraMap, mul_one]

theorem continuous_pairingCharacter (a : ι → K) : Continuous (pairingCharacter (K := K) a) :=
  continuous_subtype_val.comp ((continuous_adelicCharacter K).comp
    (continuous_finsetSum _ fun i _ => continuous_const.mul (continuous_apply i)))

theorem norm_pairingCharacter (a : ι → K) (y : ι → Adeles K) : ‖pairingCharacter a y‖ = 1 :=
  Circle.norm_coe _

/-- The Fourier coefficient of `f` at `a ∈ K^ι`. -/
def fourierCoeff [CompactSpace (AdeleQuotient K)] (f : (ι → Adeles K) → ℂ) (a : ι → K) : ℂ :=
  torusIntegral ι (fun y => f y * conj (pairingCharacter a y))

variable [CompactSpace (AdeleQuotient K)]

variable (K ι) in
/-- The characters as continuous functions on the torus. -/
def torusCharacterMap (a : ι → K) : C(ι → AdeleQuotient K, ℂ) :=
  ⟨pairingCharacter a ∘ torusLift,
    (isPeriodic_pairingCharacter a).continuous_lift (continuous_pairingCharacter a)⟩

omit [CompactSpace (AdeleQuotient K)] in
theorem torusCharacterMap_apply (a : ι → K) (t : ι → AdeleQuotient K) :
    torusCharacterMap K ι a t = pairingCharacter a (torusLift t) := rfl

variable (K ι) in
/-- The star subalgebra generated by the characters. -/
def torusCharacterSubalgebra : StarSubalgebra ℂ C(ι → AdeleQuotient K, ℂ) where
  toSubalgebra := Algebra.adjoin ℂ (Set.range (torusCharacterMap K ι))
  star_mem' := by
    change Algebra.adjoin ℂ (Set.range (torusCharacterMap K ι)) ≤
      star (Algebra.adjoin ℂ (Set.range (torusCharacterMap K ι)))
    refine adjoin_le ?_
    rintro _ ⟨a, rfl⟩
    refine subset_adjoin ⟨-a, ?_⟩
    ext1 t
    simp only [torusCharacterMap_apply, pairingCharacter_neg, ContinuousMap.star_apply,
      starRingEnd_apply]

omit [CompactSpace (AdeleQuotient K)] in
theorem torusCharacterSubalgebra_coe :
    (torusCharacterSubalgebra K ι).toSubalgebra.toSubmodule =
      span ℂ (Set.range (torusCharacterMap K ι)) := by
  apply adjoin_eq_span_of_subset
  refine .trans (fun x ↦ Submonoid.closure_induction (fun _ ↦ id) ⟨0, ?_⟩ ?_) subset_span
  · ext t
    simp [torusCharacterMap_apply, pairingCharacter_zero]
  · rintro _ _ _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    refine ⟨a + b, ?_⟩
    ext t
    simp only [torusCharacterMap_apply, pairingCharacter_add_left, ContinuousMap.mul_apply]

omit [CompactSpace (AdeleQuotient K)] in
theorem torusCharacterSubalgebra_separatesPoints :
    (torusCharacterSubalgebra K ι).SeparatesPoints := by
  classical
  intro s t hst
  obtain ⟨i, hi⟩ : ∃ i, s i ≠ t i := Function.ne_iff.mp hst
  set d := torusLift s i - torusLift t i with hd_def
  have hd : ¬∃ δ : K, d = algebraMap K (Adeles K) δ := by
    rintro ⟨δ, hδ⟩
    apply hi
    have hs : s i = adeleQuotientMap K (torusLift s i) := (congrFun (torusMk_torusLift s) i).symm
    have ht : t i = adeleQuotientMap K (torusLift t i) := (congrFun (torusMk_torusLift t) i).symm
    have hst' : torusLift s i = torusLift t i + algebraMap K (Adeles K) δ := by
      rw [← hδ, hd_def]
      abel
    have h0 : adeleQuotientMap K (algebraMap K (Adeles K) δ) = 0 :=
      (QuotientAddGroup.eq_zero_iff _).mpr ⟨δ, rfl⟩
    rw [hs, ht, hst', map_add, h0, add_zero]
  obtain ⟨c, hc⟩ : ∃ c : K, adelicCharacter K (algebraMap K (Adeles K) c * d) ≠ 1 := by
    by_contra! h
    exact hd (exists_eq_algebraMap_of_orthogonal K d h)
  refine ⟨_, ⟨torusCharacterMap K ι (Pi.single i c), subset_adjoin ⟨Pi.single i c, rfl⟩, rfl⟩, ?_⟩
  dsimp only
  rw [torusCharacterMap_apply, torusCharacterMap_apply, pairingCharacter_single,
    pairingCharacter_single, Ne, Circle.coe_inj]
  intro heq
  apply hc
  rw [hd_def, mul_sub, sub_eq_add_neg, AddChar.map_add_eq_mul, heq, AddChar.map_neg_eq_inv,
    mul_inv_cancel]

/-- Density of the span of the characters (Stone–Weierstrass). -/
theorem span_torusCharacterMap_closure_eq_top :
    (span ℂ (Set.range (torusCharacterMap K ι))).topologicalClosure = ⊤ := by
  rw [← torusCharacterSubalgebra_coe]
  exact congr_arg (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
      torusCharacterSubalgebra_separatesPoints)

/-- **Fourier uniqueness**: a continuous periodic function on `𝔸_K^ι` all of whose Fourier
coefficients vanish is zero. -/
theorem eq_zero_of_fourierCoeff_eq_zero {f : (ι → Adeles K) → ℂ} (hf : IsPeriodic f)
    (hfc : Continuous f) (h0 : ∀ a, fourierCoeff f a = 0) (y : ι → Adeles K) : f y = 0 := by
  set μ := torusHaar K ι
  set h : (ι → AdeleQuotient K) → ℂ := f ∘ torusLift with h_def
  have hh : Continuous h := hf.continuous_lift hfc
  suffices hz : h = 0 by
    rw [← hf.lift_mk y]
    exact congrFun hz (torusMk y)
  set H : C(ι → AdeleQuotient K, ℂ) := ⟨h, hh⟩
  have hint : ∀ p : C(ι → AdeleQuotient K, ℂ), Integrable (fun z => h z * p z) μ := fun p =>
    Integrable.of_bound (hh.mul p.continuous).aestronglyMeasurable (‖H‖ * ‖p‖)
      (ae_of_all _ fun z => by
        rw [norm_mul]
        exact mul_le_mul (H.norm_coe_le_norm z) (p.norm_coe_le_norm z) (norm_nonneg _)
          (norm_nonneg _))
  let L : C(ι → AdeleQuotient K, ℂ) →ₗ[ℂ] ℂ :=
    { toFun := fun p => ∫ z, h z * p z ∂μ
      map_add' := fun p q => by
        simp only [ContinuousMap.add_apply, mul_add]
        exact integral_add (hint p) (hint q)
      map_smul' := fun c p => by
        simp only [ContinuousMap.smul_apply, smul_eq_mul, RingHom.id_apply]
        rw [← integral_const_mul]
        congr 1
        funext z
        ring }
  let Lc : C(ι → AdeleQuotient K, ℂ) →L[ℂ] ℂ := L.mkContinuous (‖H‖ * μ.real Set.univ) fun p => by
    calc ‖L p‖ ≤ (‖H‖ * ‖p‖) * μ.real Set.univ :=
          norm_integral_le_of_norm_le_const (ae_of_all _ fun z => by
            rw [norm_mul]
            exact mul_le_mul (H.norm_coe_le_norm z) (p.norm_coe_le_norm z) (norm_nonneg _)
              (norm_nonneg _))
      _ = ‖H‖ * μ.real Set.univ * ‖p‖ := by ring
  have hspan : span ℂ (Set.range (torusCharacterMap K ι)) ≤ LinearMap.ker (Lc : _ →ₗ[ℂ] ℂ) := by
    rw [Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    have := h0 (-a)
    rw [fourierCoeff, torusIntegral] at this
    change ∫ z, h z * pairingCharacter a (torusLift z) ∂μ = 0
    convert this using 3 with z
    rw [pairingCharacter_neg, Complex.conj_conj]
    rfl
  have hker := Submodule.topologicalClosure_minimal _ hspan Lc.isClosed_ker
  rw [span_torusCharacterMap_closure_eq_top] at hker
  have hstar : Lc (star H) = 0 := hker Submodule.mem_top
  have hsq : ∫ z, ‖h z‖ ^ 2 ∂μ = 0 := by
    have heq : Lc (star H) = ((∫ z, ‖h z‖ ^ 2 ∂μ : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      change ∫ z, h z * star (h z) ∂μ = _
      congr 1
      funext z
      rw [← starRingEnd_apply, Complex.mul_conj', Complex.ofReal_pow]
    rw [heq] at hstar
    exact_mod_cast hstar
  have hint2 : Integrable (fun z => ‖h z‖ ^ 2) μ := by
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hh.continuousOn
    refine Integrable.of_bound (hh.norm.pow 2).aestronglyMeasurable (C ^ 2)
      (ae_of_all _ fun z => ?_)
    rw [Real.norm_of_nonneg (by positivity)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hC z (Set.mem_univ z)) 2
  have hae : (fun z => ‖h z‖ ^ 2) =ᵐ[μ] 0 :=
    (integral_eq_zero_iff_of_nonneg (fun z => by positivity) hint2).mp hsq
  have hae' : h =ᵐ[μ] fun _ => 0 := hae.mono fun z hz => by
    simpa using hz
  exact (hh.ae_eq_iff_eq μ continuous_const).mp hae'

end Langlands.Automorphic.CuspidalWhittaker
