import Langlands.Automorphic.StandardBlockConstantTermSelection
import Langlands.Automorphic.TranslatedFunctionCentralQuotient

/-! # The actual cyclic source of the minimal block constant term -/

noncomputable section

universe u v w

open NumberField
open scoped Classical CategoryTheory.MonObj

set_option autoImplicit false

namespace Langlands.Automorphic

section Range

variable {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℂ V]
  {W : Type w} [AddCommGroup W] [Module ℂ W]
  {ρ : Representation ℂ G V} {σ : Representation ℂ G W}

private def subrepresentationModuleEquiv (P : Subrepresentation ρ) :
    P.toRepresentation.asModule ≃ₗ[MonoidAlgebra ℂ G] P.asSubmodule := by
  let i : P.toRepresentation.IntertwiningMap ρ :=
    { toLinearMap := P.toSubmodule.subtype
      isIntertwining' := fun _ => LinearMap.ext fun _ => rfl }
  let j := (Representation.IntertwiningMap.equivLinearMapAsModule _ _ i).codRestrict
    P.asSubmodule (fun v => v.property)
  exact LinearEquiv.ofBijective j
    ⟨fun _ _ h => Subtype.ext (congrArg Subtype.val h), fun v => ⟨⟨v.val, v.property⟩, rfl⟩⟩

private theorem subrepresentationModuleEquiv_symm_apply_val (P : Subrepresentation ρ) (v : P.asSubmodule) :
    ((subrepresentationModuleEquiv P).symm v).val = v.val := by
  exact congrArg Subtype.val ((subrepresentationModuleEquiv P).apply_symm_apply v)

private def intertwiningRangeModuleEquiv (f : ρ.IntertwiningMap σ) (hf : Function.Injective f) :
    ρ.asModule ≃ₗ[MonoidAlgebra ℂ G] f.range.toRepresentation.asModule := by
  let j : ρ.IntertwiningMap f.range.toRepresentation :=
    { toLinearMap := f.toLinearMap.rangeRestrict
      isIntertwining' := fun g => LinearMap.ext fun v => Subtype.ext
        (Representation.IntertwiningMap.isIntertwining ρ σ f g v) }
  exact LinearEquiv.ofBijective (Representation.IntertwiningMap.equivLinearMapAsModule _ _ j)
    ⟨fun _ _ h => hf (congrArg Subtype.val h), fun v => v.property.imp (fun _ h => Subtype.ext h)⟩

end Range

section CyclicQuotient

variable {R V W : Type*} [Ring R] [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]

private theorem exists_cyclicRestriction_surjection (K : Submodule R V) (x : V)
    (p : (R ∙ K.mkQ x) →ₗ[R] W) (hp : Function.Surjective p) :
    ∃ q : (R ∙ x) →ₗ[R] W, Function.Surjective q ∧ ∀ y : R ∙ x, y.val ∈ K → q y = 0 := by
  let f := K.mkQ.domRestrict (R ∙ x)
  have hfv : LinearMap.range f = R ∙ K.mkQ x := by
    change LinearMap.range (K.mkQ.domRestrict (R ∙ x)) = _
    rw [LinearMap.range_domRestrict, Submodule.map_span, Set.image_singleton]
  let j : (R ∙ x) →ₗ[R] (R ∙ K.mkQ x) := f.codRestrict _ (fun y => hfv ▸ LinearMap.mem_range_self f y)
  have hj : Function.Surjective j := by
    intro v
    have hv : v.val ∈ LinearMap.range f := hfv.symm ▸ v.property
    obtain ⟨y, hy⟩ := hv
    exact ⟨y, Subtype.ext hy⟩
  refine ⟨p.comp j, hp.comp hj, fun y hy => ?_⟩
  have hz : j y = 0 := Subtype.ext ((Submodule.Quotient.mk_eq_zero K).mpr hy)
  rw [LinearMap.comp_apply, hz, map_zero]

end CyclicQuotient

open Langlands.Global Langlands.GeneralLinear

variable (F : Type u) [Field F] [NumberField F] {n : ℕ}

local instance cuspidalTermSourceRationalAddCommGroup (d : ℕ) : AddCommGroup (RationalInvariantFunctions F d) :=
  Submodule.addCommGroup _
local instance cuspidalTermSourceContinuousAddCommGroup (d : ℕ) : AddCommGroup (ContinuousRationalFunctions F d) :=
  Submodule.addCommGroup _
local instance cuspidalTermSourceFiniteSmoothAddCommGroup (d : ℕ) : AddCommGroup (FiniteSmoothRationalFunctions F d) :=
  Submodule.addCommGroup _
local instance cuspidalTermSourceFormsAddCommGroup (d : ℕ) : AddCommGroup (AutomorphicForms F d) :=
  Submodule.addCommGroup _
local instance cuspidalTermSourceStableAddCommGroup (d : ℕ) : AddCommGroup (StableAutomorphicFunctions F d) :=
  Submodule.addCommGroup _
local instance cuspidalTermSourceRealizationAddCommGroup {d : ℕ} (S : OperatorRealization F d) :
    AddCommGroup S.Space := Submodule.addCommGroup _

local notation "𝓡(" d ")" => MonoidAlgebra ℂ (automorphicOperatorAlgebra F d)

private def cyclicRealizationInclusion (S : OperatorRealization F n) (x : S.representation.asModule) :
    let P := Subrepresentation.ofSubmodule' (𝓡(n) ∙ x)
    P.toRepresentation.IntertwiningMap (stableAutomorphicAction F n) := by
  let P := Subrepresentation.ofSubmodule' (𝓡(n) ∙ x)
  let i : P.toRepresentation.IntertwiningMap S.representation :=
    { toLinearMap := P.toSubmodule.subtype
      isIntertwining' := fun _ => LinearMap.ext fun _ => rfl }
  exact S.inclusion.comp i

/-- The actual subspace of the stable automorphic space generated by a realized vector. -/
def cyclicOperatorRealization (S : OperatorRealization F n) (x : S.representation.asModule) :
    OperatorRealization F n :=
  (cyclicRealizationInclusion F S x).range

private def cyclicOperatorRealizationEquiv (S : OperatorRealization F n) (x : S.representation.asModule) :
    (𝓡(n) ∙ x) ≃ₗ[𝓡(n)] (cyclicOperatorRealization F S x).representation.asModule := by
  let P := Subrepresentation.ofSubmodule' (𝓡(n) ∙ x)
  let f := cyclicRealizationInclusion F S x
  let e := intertwiningRangeModuleEquiv f (fun _ _ h => Subtype.ext (S.inclusion_injective h))
  exact (subrepresentationModuleEquiv P).symm.trans e

set_option maxHeartbeats 450000 in
private theorem cyclicOperatorRealizationEquiv_ambient (S : OperatorRealization F n)
    (x : S.representation.asModule) (y : 𝓡(n) ∙ x) :
    (cyclicOperatorRealization F S x).ambient (cyclicOperatorRealizationEquiv F S x y) = S.ambient y.val := by
  let P := Subrepresentation.ofSubmodule' (𝓡(n) ∙ x)
  exact congrArg (fun z : S.representation.asModule => S.ambient z)
    (subrepresentationModuleEquiv_symm_apply_val P y)

/-- A true automorphic source whose block term still carries the given quotient and whose
strict refinements have zero period. -/
def HasCuspidalBlockTermSource {r : ℕ} (Q : IrreducibleOperatorSubquotient F r) : Prop :=
  ∃ (B : BlockShape (r + 1)) (S : OperatorRealization F (r + 1))
    (q : S.representation.asModule →ₗ[𝓡(r + 1)] Q.representation.asModule),
    Function.Surjective q ∧
    (∀ v : S.representation.asModule, realizedBlockConstantTerm F B S v = 0 → q v = 0) ∧
    ∀ T : BlockShape (r + 1), B.cuts ⊂ T.cuts →
      ∀ v : S.representation.asModule, realizedBlockConstantTerm F T S v = 0

set_option maxHeartbeats 450000 in
private theorem realizedBlockConstantTerm_eq_zero_iff (B : BlockShape n) (S : OperatorRealization F n)
    (v : S.representation.asModule) :
    realizedBlockConstantTerm F B S v = 0 ↔ v ∈ realizedBlockConstantTermKernel F S (standardBlockWeight B.cuts) := by
  rw [mem_realizedBlockConstantTermKernel]
  let e := GeneralLinearGroupPoints.adelicEquiv F n
  constructor
  · intro h g
    have hz := congrFun h (e g)
    change finiteSmoothBlockConstantTerm F (standardBlockWeight B.cuts) (S.ambient v) (e.symm (e g)) = 0 at hz
    rwa [e.symm_apply_apply] at hz
  · intro h
    funext g
    exact h (e.symm g)

set_option maxHeartbeats 700000 in
/-- Minimal constant-term selection gives an actual cyclic source for each original simple quotient. -/
theorem exists_cuspidalBlockTermSource {r : ℕ} (Q : IrreducibleOperatorSubquotient F r) :
    HasCuspidalBlockTermSource F Q := by
  classical
  let S := Q.subquotient.upper
  obtain ⟨s, x, p, hcuts, hp, -, -⟩ := exists_cyclicBlockConstantTermQuotient F Q
  let D := cyclicOperatorRealization F S x
  let e := cyclicOperatorRealizationEquiv F S x
  let B := (BlockShape.cutEquiv (r + 1)).symm s
  have hB : B.cuts = s := BlockShape.cuts_cutEquiv_symm (n := r + 1) s
  let K := realizedBlockConstantTermKernel F S (standardBlockWeight s)
  let P : Submodule (𝓡(r + 1)) S.representation.asModule := 𝓡(r + 1) ∙ x
  obtain ⟨q₀, hq₀, hq₀ker⟩ := exists_cyclicRestriction_surjection K x p hp
  let q := q₀.comp e.symm.toLinearMap
  refine ⟨B, D, q, hq₀.comp e.symm.surjective, ?_, ?_⟩
  · intro v hv
    let y : P := e.symm v
    have he : D.ambient v = S.ambient y.val := by
      have h := cyclicOperatorRealizationEquiv_ambient F S x y
      change D.ambient (e y) = _ at h
      exact (congrArg D.ambient (e.apply_symm_apply v)).symm.trans h
    have hy : y.val ∈ K := by
      have h := (mem_realizedBlockConstantTermKernel F D _ v).mp
        ((realizedBlockConstantTerm_eq_zero_iff F B D v).mp hv)
      rw [he, hB] at h
      exact (mem_realizedBlockConstantTermKernel F S _ y.val).mpr h
    exact hq₀ker y hy
  · intro T hT v
    let y : P := e.symm v
    have he : D.ambient v = S.ambient y.val := by
      have h := cyclicOperatorRealizationEquiv_ambient F S x y
      change D.ambient (e y) = _ at h
      exact (congrArg D.ambient (e.apply_symm_apply v)).symm.trans h
    rw [hB] at hT
    apply (realizedBlockConstantTerm_eq_zero_iff F T D v).mpr
    apply (mem_realizedBlockConstantTermKernel F D _ v).mpr
    rw [he]
    exact (mem_realizedBlockConstantTermKernel F S _ y.val).mp (hcuts T.cuts hT y.property)

end Langlands.Automorphic
