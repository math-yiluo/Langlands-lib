import Langlands.Automorphic.TranslatedBlockTermAction
import Langlands.Automorphic.CyclicOperatorAlgebra

/-! # The selected cyclic source with a continuous block character -/

noncomputable section
universe u
open NumberField
open scoped Classical CategoryTheory.MonObj
set_option autoImplicit false
set_option quotPrecheck false

namespace Langlands.Automorphic

open Langlands.Global Langlands.Global.ArchimedeanGL Langlands.GeneralLinear

attribute [local instance 100] LieRing.ofAssociativeRing

variable (F : Type u) [Field F] [NumberField F] {n : ℕ}

local instance blockCharacterRationalGroup (d : ℕ) : AddCommGroup (RationalInvariantFunctions F d) :=
  Submodule.addCommGroup _
local instance blockCharacterContinuousGroup (d : ℕ) : AddCommGroup (ContinuousRationalFunctions F d) :=
  Submodule.addCommGroup _
local instance blockCharacterSmoothGroup (d : ℕ) : AddCommGroup (FiniteSmoothRationalFunctions F d) :=
  Submodule.addCommGroup _
local instance blockCharacterFormGroup (d : ℕ) : AddCommGroup (AutomorphicForms F d) := Submodule.addCommGroup _
local instance blockCharacterStableGroup (d : ℕ) : AddCommGroup (StableAutomorphicFunctions F d) :=
  Submodule.addCommGroup _
local instance blockCharacterRealizationGroup {d : ℕ} (S : OperatorRealization F d) : AddCommGroup S.Space :=
  Submodule.addCommGroup _
local instance blockCharacterOperatorRing (d : ℕ) : Ring (automorphicOperatorAlgebra F d) :=
  Subalgebra.toRing _

variable (B : BlockShape n) (S : OperatorRealization F n)

local notation "U" => automorphicOperatorAlgebra F n
local notation "𝓡" => MonoidAlgebra ℂ (automorphicOperatorAlgebra F n)
local notation "Cen" => (Fin B.length → Ideles F)
local notation "T" => TranslatedBlockConstantTerms F B S
local notation "β" => blockConstantTermScalarAction F B
local notation "φ" => realizedBlockConstantTerm F B S
local notation "σ" => translatedFunctionAction β φ
local notation "α" => translatedBlockTermOperatorAction F B S
local notation "Γ" => AlgHom.toMonoidHom' α

variable (v : Representation.asModule (AlgHom.toMonoidHom' (translatedBlockTermOperatorAction F B S)))

/-- The cyclic subspace generated by the selected central eigenvector. -/
abbrev BlockTermCyclicSpace : Type u := (cyclicAlgebraSubrepresentation (R := U) α v).toSubmodule

local notation "C" => BlockTermCyclicSpace F B S v

/-- The restricted full action on the selected cyclic space. -/
abbrev blockTermCyclicAction : U →ₐ[ℂ] Module.End ℂ C :=
  cyclicAlgebraAction (R := U) α v

local notation "A" => blockTermCyclicAction F B S v

/-- The cyclic generator, with its actual ambient constant term. -/
abbrev blockTermCyclicGenerator : C := cyclicAlgebraGenerator (R := U) α v

/-- Inclusion of a cyclic vector in the translated-period quotient. -/
abbrev blockTermCyclicInclusion : Representation.IntertwiningMap (AlgHom.toMonoidHom' A) Γ :=
  cyclicAlgebraInclusion (R := U) α v

local notation "j" => blockTermCyclicInclusion F B S v
local notation "ρf" => (AlgHom.toMonoidHom' A).comp (finiteOperator F n)
local notation "ρc" => (AlgHom.toMonoidHom' A).comp (compactOperator F n)
local notation "L" => ((A).comp (differentialOperator F n)).toLieHom.comp (envelopingGenerator F n)

set_option maxHeartbeats 700000 in
/-- The distinguished translated period generates the restricted full action. -/
theorem blockTermCyclicGenerator_orbitSpan :
    FiniteVectors.orbitSpan (AlgHom.toMonoidHom' A) (blockTermCyclicGenerator F B S v) = ⊤ :=
  cyclicAlgebraGenerator_orbitSpan (R := U) (V := T) α v

set_option maxHeartbeats 1300000 in
/-- The central character of the generator persists through its entire cyclic subspace. -/
theorem blockTermCyclic_eigen (χ : Cen →* ℂˣ) (hχ : ∀ z : Cen, σ z v = (χ z : ℂ) • v)
    (w : C) (z : Cen) : σ z (j w) = (χ z : ℂ) • j w := by
  have hu : ∃ a : U, A a (blockTermCyclicGenerator F B S v) = w :=
    exists_cyclicAlgebraAction_generator (R := U) (V := T) α v w
  obtain ⟨a, ha⟩ := hu
  have h : α a v = j w := congrArg Subtype.val ha
  calc
    _ = σ z (α a v) := congrArg (σ z) h.symm
    _ = α a (σ z v) := LinearMap.congr_fun (translatedBlockTermCenterAction_commute F B S z a).eq v
    _ = α a ((χ z : ℂ) • v) := congrArg (α a) (hχ z)
    _ = (χ z : ℂ) • α a v := (α a).map_smul _ _
    _ = _ := congrArg ((χ z : ℂ) • ·) h

set_option maxHeartbeats 700000 in
/-- The finite action on the selected cyclic space remains smooth. -/
theorem blockTermCyclic_finiteSmooth : IsSmooth ρf := by
  let f : Representation.IntertwiningMap ρf (translatedBlockTermFiniteAction F B S) :=
    { toLinearMap := (j).toLinearMap
      isIntertwining' := fun d => (j).isIntertwining' (finiteOperator F n d) }
  exact isSmooth_of_injective f Subtype.val_injective (translatedBlockTerm_finiteSmooth F B S)

private def blockTermCyclicCompactInclusion :
    Representation.IntertwiningMap ρc (translatedBlockTermCompactAction F B S) where
  toLinearMap := (j).toLinearMap
  isIntertwining' k := (j).isIntertwining' (compactOperator F n k)

set_option maxHeartbeats 700000 in
/-- The selected cyclic space inherits actual compact finiteness. -/
theorem blockTermCyclic_compactFinite (w : C) : FiniteVectors.IsFiniteVector ρc w :=
  (FiniteVectors.isFiniteVector_map_iff (blockTermCyclicCompactInclusion F B S v)
    Subtype.val_injective w).mp (translatedBlockTerm_compactFinite F B S (j w))

set_option maxHeartbeats 850000 in
/-- Compact derivatives restrict to the selected cyclic space and its actual Lie action. -/
theorem blockTermCyclic_compactDualDerivative : CompactDualDerivative ρc L := by
  refine CompactDualDerivative.of_injective_intertwiner
    (translatedBlockTermCompactAction F B S) (translatedBlockTermComplexLieAction F B S)
    (translatedBlockTerm_compactDualDerivative F B S) (blockTermCyclicCompactInclusion F B S v)
    Subtype.val_injective ?_
  intro X w
  rfl

end Langlands.Automorphic
