import Langlands.Automorphic.CuspidalArchimedeanPlaceComponent

/-!
# Irreducible admissible stable subspaces by minimal multiplicity

Let `κ` be a representation of a topological group `K` and `π` a Lie action on a complex
vector space `V`. This module proves two algebraic facts about the predicates of
`Langlands.Automorphic.CuspidalArchimedeanPlaceComponent`.

* `exists_isIrreducible_isAdmissible`: if a nonzero stable admissible subspace `M` has a
  matrix representation `τ₀` of `K` that *detects* every nonzero stable subspace of `M`
  (each has a nonzero `τ₀`-intertwiner into it), then `M` contains an irreducible admissible
  stable subspace. Take a nonzero stable `N ≤ M` with `dim Hom_K(τ₀, N)` minimal and let `N₀`
  be the stable subspace generated by the images of these intertwiners.
* `isIrreducible_map` and `isAdmissible_map`: an equivariant linear map that is nonzero on an
  irreducible stable subspace maps it to an irreducible stable subspace, and keeps
  admissibility.
-/

noncomputable section

open scoped Matrix

set_option autoImplicit false

namespace Langlands.Automorphic.PlaceComponent

attribute [local instance 100] LieRing.ofAssociativeRing

variable {K : Type*} [Group K] {𝔤 : Type*} [LieRing 𝔤] [LieAlgebra ℂ 𝔤]
  {V : Type*} [AddCommGroup V] [Module ℂ V]

theorem intertwiners_mono (κ : Representation ℂ K V) {N M : Submodule ℂ V} (h : N ≤ M)
    (d : ℕ) (τ : K →* Matrix (Fin d) (Fin d) ℂ) :
    intertwiners κ N d τ ≤ intertwiners κ M d τ :=
  fun _ hT => ⟨fun x => h (hT.1 x), hT.2⟩

theorem isStable_sInf (κ : Representation ℂ K V) (π : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V)
    (S : Set (Submodule ℂ V)) (hS : ∀ U ∈ S, IsStable κ π U) : IsStable κ π (sInf S) := by
  refine ⟨fun k x hx => ?_, fun X x hx => ?_⟩
  · rw [Submodule.mem_sInf] at hx ⊢
    exact fun U hU => (hS U hU).1 k x (hx U hU)
  · rw [Submodule.mem_sInf] at hx ⊢
    exact fun U hU => (hS U hU).2 X x (hx U hU)

theorem isAdmissible_mono [TopologicalSpace K] (κ : Representation ℂ K V)
    {N M : Submodule ℂ V} (h : N ≤ M) (hM : IsAdmissible κ M) : IsAdmissible κ N := by
  intro d τ hτ
  have := hM d τ hτ
  exact Submodule.finiteDimensional_of_le (intertwiners_mono κ h d τ)

/-- **Minimal multiplicity.** A nonzero stable admissible subspace `M` on which a matrix
representation `τ₀` detects every nonzero stable subspace contains an irreducible admissible
stable subspace. -/
theorem exists_isIrreducible_isAdmissible [TopologicalSpace K] (κ : Representation ℂ K V)
    (π : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V) {M : Submodule ℂ V} (hMs : IsStable κ π M)
    (hMa : IsAdmissible κ M) (hM0 : M ≠ ⊥) {d : ℕ} (τ₀ : K →* Matrix (Fin d) (Fin d) ℂ)
    (hτ₀ : Continuous τ₀)
    (hdet : ∀ N : Submodule ℂ V, N ≤ M → IsStable κ π N → N ≠ ⊥ →
      intertwiners κ N d τ₀ ≠ ⊥) :
    ∃ W : Submodule ℂ V, W ≤ M ∧ IsIrreducible κ π W ∧ IsAdmissible κ W := by
  classical
  have hfin : FiniteDimensional ℂ (intertwiners κ M d τ₀) := hMa d τ₀ hτ₀
  -- the multiplicity of `τ₀` in a stable subspace of `M`
  let f : Submodule ℂ V → ℕ := fun N => Module.finrank ℂ (intertwiners κ N d τ₀)
  have hex : ∃ n, ∃ N : Submodule ℂ V, N ≤ M ∧ IsStable κ π N ∧ N ≠ ⊥ ∧ f N = n :=
    ⟨_, M, le_rfl, hMs, hM0, rfl⟩
  obtain ⟨N, hNM, hNs, hN0, hNf⟩ := Nat.find_spec hex
  have hmin : ∀ N' : Submodule ℂ V, N' ≤ M → IsStable κ π N' → N' ≠ ⊥ → f N ≤ f N' := by
    intro N' h1 h2 h3
    rw [hNf]
    exact Nat.find_min' hex ⟨N', h1, h2, h3, rfl⟩
  -- the stable subspace generated by the images of the `τ₀`-intertwiners into `N`
  let I := intertwiners κ N d τ₀
  let S : Set (Submodule ℂ V) :=
    {U | IsStable κ π U ∧ ∀ T ∈ I, ∀ x, (T : (Fin d → ℂ) →ₗ[ℂ] V) x ∈ U}
  let N₀ := sInf S
  have hN₀s : IsStable κ π N₀ := isStable_sInf κ π S fun U hU => hU.1
  have himg : ∀ T ∈ I, ∀ x, (T : (Fin d → ℂ) →ₗ[ℂ] V) x ∈ N₀ := fun T hT x => by
    rw [Submodule.mem_sInf]
    exact fun U hU => hU.2 T hT x
  have hN₀N : N₀ ≤ N := sInf_le ⟨hNs, fun T hT x => hT.1 x⟩
  have hI : intertwiners κ N₀ d τ₀ = I := le_antisymm (intertwiners_mono κ hN₀N d τ₀)
    fun T hT => ⟨himg T hT, hT.2⟩
  have hN₀0 : N₀ ≠ ⊥ := by
    intro h0
    apply hdet N hNM hNs hN0
    rw [eq_bot_iff]
    intro T hT
    rw [Submodule.mem_bot]
    refine LinearMap.ext fun x => ?_
    have := himg T hT x
    rw [h0, Submodule.mem_bot] at this
    exact this
  refine ⟨N₀, hN₀N.trans hNM, ⟨hN₀0, hN₀s, fun W' hW' hW's => ?_⟩,
    isAdmissible_mono κ (hN₀N.trans hNM) hMa⟩
  by_cases hW'0 : W' = ⊥
  · exact Or.inl hW'0
  right
  refine le_antisymm hW' ?_
  have hle : intertwiners κ W' d τ₀ ≤ I := hI ▸ intertwiners_mono κ hW' d τ₀
  have : FiniteDimensional ℂ I := Submodule.finiteDimensional_of_le
    (intertwiners_mono κ hNM d τ₀)
  have heq : intertwiners κ W' d τ₀ = I := Submodule.eq_of_le_of_finrank_le hle
    (hmin W' (hW'.trans (hN₀N.trans hNM)) hW's hW'0)
  exact sInf_le ⟨hW's, fun T hT x => by
    rw [← heq] at hT
    exact hT.1 x⟩

/-! ### Images under equivariant maps -/

section Map

variable {V' : Type*} [AddCommGroup V'] [Module ℂ V']

/-- An equivariant map nonzero on an irreducible stable subspace is injective on it. -/
theorem injOn_of_isIrreducible {κ : Representation ℂ K V} {π : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V}
    {κ' : Representation ℂ K V'} {π' : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V'} (Φ : V →ₗ[ℂ] V')
    (hκ : ∀ k x, Φ (κ k x) = κ' k (Φ x)) (hπ : ∀ X x, Φ (π X x) = π' X (Φ x))
    {W : Submodule ℂ V} (hW : IsIrreducible κ π W) (hne : W.map Φ ≠ ⊥) :
    ∀ x ∈ W, Φ x = 0 → x = 0 := by
  have hs : IsStable κ π (W ⊓ LinearMap.ker Φ) := by
    refine ⟨fun k x hx => Submodule.mem_inf.mpr ⟨hW.2.1.1 k x hx.1, ?_⟩,
      fun X x hx => Submodule.mem_inf.mpr ⟨hW.2.1.2 X x hx.1, ?_⟩⟩
    · rw [LinearMap.mem_ker, hκ, LinearMap.mem_ker.mp hx.2, map_zero]
    · rw [LinearMap.mem_ker, hπ, LinearMap.mem_ker.mp hx.2, map_zero]
  rcases hW.2.2 _ inf_le_left hs with h | h
  · intro x hx hΦ
    have : x ∈ W ⊓ LinearMap.ker Φ := Submodule.mem_inf.mpr ⟨hx, hΦ⟩
    rw [h, Submodule.mem_bot] at this
    exact this
  · exfalso
    apply hne
    rw [eq_bot_iff]
    rintro _ ⟨x, hx, rfl⟩
    have : x ∈ W ⊓ LinearMap.ker Φ := by rw [h]; exact hx
    exact (Submodule.mem_bot ℂ).mpr (Submodule.mem_inf.mp this).2

/-- An equivariant map nonzero on an irreducible stable subspace maps it onto an irreducible
stable subspace. -/
theorem isIrreducible_map {κ : Representation ℂ K V} {π : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V}
    {κ' : Representation ℂ K V'} {π' : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V'} (Φ : V →ₗ[ℂ] V')
    (hκ : ∀ k x, Φ (κ k x) = κ' k (Φ x)) (hπ : ∀ X x, Φ (π X x) = π' X (Φ x))
    {W : Submodule ℂ V} (hW : IsIrreducible κ π W) (hne : W.map Φ ≠ ⊥) :
    IsIrreducible κ' π' (W.map Φ) := by
  refine ⟨hne, ⟨?_, ?_⟩, fun W' hW' hW's => ?_⟩
  · rintro k _ ⟨x, hx, rfl⟩
    exact ⟨κ k x, hW.2.1.1 k x hx, hκ k x⟩
  · rintro X _ ⟨x, hx, rfl⟩
    exact ⟨π X x, hW.2.1.2 X x hx, hπ X x⟩
  have hs : IsStable κ π (W ⊓ W'.comap Φ) := by
    refine ⟨fun k x hx => Submodule.mem_inf.mpr ⟨hW.2.1.1 k x hx.1, ?_⟩,
      fun X x hx => Submodule.mem_inf.mpr ⟨hW.2.1.2 X x hx.1, ?_⟩⟩
    · rw [Submodule.mem_comap, hκ]
      exact hW's.1 k _ hx.2
    · rw [Submodule.mem_comap, hπ]
      exact hW's.2 X _ hx.2
  rcases hW.2.2 _ inf_le_left hs with h | h
  · left
    rw [eq_bot_iff]
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hW' hy
    have : x ∈ W ⊓ W'.comap Φ := Submodule.mem_inf.mpr ⟨hx, hy⟩
    rw [h, Submodule.mem_bot] at this
    rw [this, map_zero]
    exact Submodule.zero_mem _
  · right
    refine le_antisymm hW' ?_
    rintro _ ⟨x, hx, rfl⟩
    have : x ∈ W ⊓ W'.comap Φ := by rw [h]; exact hx
    exact (Submodule.mem_inf.mp this).2

/-- An equivariant map injective on a `K`-stable admissible subspace keeps admissibility. -/
theorem isAdmissible_map [TopologicalSpace K] {κ : Representation ℂ K V}
    {κ' : Representation ℂ K V'} (Φ : V →ₗ[ℂ] V')
    (hκ : ∀ k x, Φ (κ k x) = κ' k (Φ x)) {W : Submodule ℂ V}
    (hWs : ∀ (k : K), ∀ x ∈ W, κ k x ∈ W)
    (hinj : ∀ x ∈ W, Φ x = 0 → x = 0) (hW : IsAdmissible κ W) :
    IsAdmissible κ' (W.map Φ) := by
  intro d τ hτ
  have := hW d τ hτ
  have hinj' : Function.Injective (Φ.comp W.subtype) := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.comp_apply] at hx
    rw [Submodule.mem_bot]
    exact Subtype.ext (hinj x x.2 hx)
  let e := LinearEquiv.ofInjective (Φ.comp W.subtype) hinj'
  let C : ((Fin d → ℂ) →ₗ[ℂ] V) →ₗ[ℂ] ((Fin d → ℂ) →ₗ[ℂ] V') :=
    LinearMap.llcomp ℂ (Fin d → ℂ) V V' Φ
  have hle : intertwiners κ' (W.map Φ) d τ ≤ (intertwiners κ W d τ).map C := by
    intro T' hT'
    rw [mem_intertwiners] at hT'
    have hmem : ∀ x, T' x ∈ LinearMap.range (Φ.comp W.subtype) := fun x => by
      obtain ⟨y, hy, hxy⟩ := hT'.1 x
      exact ⟨⟨y, hy⟩, hxy⟩
    let T : (Fin d → ℂ) →ₗ[ℂ] V :=
      W.subtype ∘ₗ e.symm.toLinearMap ∘ₗ (T'.codRestrict _ hmem)
    have hTW : ∀ x, T x ∈ W := fun x => (e.symm _).2
    have hT : ∀ x, Φ (T x) = T' x := fun x =>
      congrArg Subtype.val (e.apply_symm_apply ⟨T' x, hmem x⟩)
    refine ⟨T, ⟨hTW, fun k x => ?_⟩, LinearMap.ext fun x => hT x⟩
    have h1 : T (τ k *ᵥ x) - κ k (T x) ∈ W := W.sub_mem (hTW _) (hWs k _ (hTW x))
    have h2 : Φ (T (τ k *ᵥ x) - κ k (T x)) = 0 := by
      rw [map_sub, hT, hκ, hT, hT'.2 k x, sub_self]
    exact sub_eq_zero.mp (hinj _ h1 h2)
  exact Submodule.finiteDimensional_of_le hle

end Map

end Langlands.Automorphic.PlaceComponent
