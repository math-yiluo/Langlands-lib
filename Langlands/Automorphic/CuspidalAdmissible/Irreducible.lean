import Langlands.Automorphic.ContragredientSphericalSpectrum
import Langlands.Representation.Unitary.CountableDualAdmissible

/-! # Irreducible admissible subrepresentations by minimal fixed dimension -/

noncomputable section
universe u
set_option autoImplicit false

namespace Langlands.Automorphic

open Langlands.Global

namespace CuspidalAdmissible

section Abstract

variable {G : Type*} [Group G] {V : Type*} [AddCommGroup V] [Module ℂ V]
  (ρ : Representation ℂ G V)

/-- The subrepresentation generated by a submodule: the span of all its translates. -/
def generated (M : Submodule ℂ V) : Subrepresentation ρ where
  toSubmodule := Submodule.span ℂ {w | ∃ (g : G) (m : V), m ∈ M ∧ ρ g m = w}
  apply_mem_toSubmodule g w hw := by
    induction hw using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨h, m, hm, rfl⟩ := hx
      exact Submodule.subset_span ⟨g * h, m, hm, by rw [map_mul, Module.End.mul_apply]⟩
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
    | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ c hx

theorem le_generated (M : Submodule ℂ V) : M ≤ (generated ρ M).toSubmodule :=
  fun m hm => Submodule.subset_span ⟨1, m, hm, by rw [map_one, Module.End.one_apply]⟩

theorem generated_le {M : Submodule ℂ V} {Y : Subrepresentation ρ}
    (h : M ≤ Y.toSubmodule) : generated ρ M ≤ Y := by
  intro w hw
  change w ∈ Submodule.span ℂ _ at hw
  refine (Submodule.span_le.mpr ?_) hw
  rintro _ ⟨g, m, hm, rfl⟩
  exact Y.apply_mem_toSubmodule g (h hm)

/-- Fixed vectors of a subrepresentation of `Y` lie in the fixed vectors of `Y`. -/
theorem finite_fixedVectors_toRepresentation (A Y : Subrepresentation ρ) (hAY : A ≤ Y)
    (K : Subgroup G) [Module.Finite ℂ ↥(Y.toSubmodule ⊓ fixedVectors ρ K)] :
    Module.Finite ℂ (fixedVectors A.toRepresentation K) := by
  let ι : fixedVectors A.toRepresentation K →ₗ[ℂ] ↥(Y.toSubmodule ⊓ fixedVectors ρ K) :=
    { toFun := fun x => ⟨x.val.val, hAY x.val.property, fun k => congrArg Subtype.val (x.property k)⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  refine Module.Finite.of_injective ι fun x y hxy => ?_
  exact Subtype.ext (Subtype.ext (congrArg (fun z => (z.val : V)) hxy))

variable [TopologicalSpace G]

theorem isSmooth_toRepresentation (hρ : IsSmooth ρ) (A : Subrepresentation ρ) :
    IsSmooth A.toRepresentation := by
  intro v
  obtain ⟨K, hK⟩ := hρ v.val
  exact ⟨K, fun k => Subtype.ext (hK k)⟩

/-- **Irreducible admissible subrepresentations by minimal fixed dimension.** Let `V₀` be a
subrepresentation of a smooth representation with finite-dimensional fixed vectors for every
open subgroup, and let `U` be an open subgroup with `V₀^U ≠ 0`. If every nonzero
subrepresentation of `V₀` has nonzero `U`-fixed vectors, then `V₀` contains a nonzero
irreducible admissible subrepresentation. -/
theorem exists_irreducible_admissible_le (hρ : IsSmooth ρ) (V₀ : Subrepresentation ρ)
    (hfin : ∀ K : OpenSubgroup G,
      Module.Finite ℂ ↥(V₀.toSubmodule ⊓ fixedVectors ρ K.toSubgroup))
    (U : OpenSubgroup G) (hV₀ : V₀.toSubmodule ⊓ fixedVectors ρ U.toSubgroup ≠ ⊥)
    (hkey : ∀ Z : Subrepresentation ρ, Z ≤ V₀ → Z ≠ ⊥ →
      Z.toSubmodule ⊓ fixedVectors ρ U.toSubgroup ≠ ⊥) :
    ∃ A : Subrepresentation ρ, A ≤ V₀ ∧ A ≠ ⊥ ∧ A.toRepresentation.IsIrreducible ∧
      IsAdmissible A.toRepresentation := by
  classical
  have hP : ∃ k : ℕ, ∃ Y : Subrepresentation ρ, Y ≤ V₀ ∧
      Y.toSubmodule ⊓ fixedVectors ρ U.toSubgroup ≠ ⊥ ∧
      Module.finrank ℂ ↥(Y.toSubmodule ⊓ fixedVectors ρ U.toSubgroup) = k :=
    ⟨_, V₀, le_rfl, hV₀, rfl⟩
  obtain ⟨Y, hYV, hYne, hYk⟩ := Nat.find_spec hP
  have hmin : ∀ Y' : Subrepresentation ρ, Y' ≤ V₀ →
      Y'.toSubmodule ⊓ fixedVectors ρ U.toSubgroup ≠ ⊥ →
      Nat.find hP ≤ Module.finrank ℂ ↥(Y'.toSubmodule ⊓ fixedVectors ρ U.toSubgroup) :=
    fun Y' h1 h2 => Nat.find_min' hP ⟨Y', h1, h2, rfl⟩
  have hfinU := hfin U
  obtain ⟨M, hM⟩ : ∃ M : Submodule ℂ V, M = Y.toSubmodule ⊓ fixedVectors ρ U.toSubgroup :=
    ⟨_, rfl⟩
  have hMV : M ≤ V₀.toSubmodule ⊓ fixedVectors ρ U.toSubgroup :=
    hM ▸ inf_le_inf_right _ hYV
  have hMfin : FiniteDimensional ℂ M := Submodule.finiteDimensional_of_le hMV
  have hAY : generated ρ M ≤ Y := generated_le ρ (hM ▸ inf_le_left)
  have hMA : M ≤ (generated ρ M).toSubmodule := le_generated ρ M
  have hAne : generated ρ M ≠ ⊥ := by
    intro h
    apply hYne
    rw [← hM, eq_bot_iff]
    intro x hx
    have hx' : x ∈ (generated ρ M).toSubmodule := hMA hx
    rw [h] at hx'
    exact hx'
  refine ⟨generated ρ M, hAY.trans hYV, hAne,
    CountableDual.isIrreducible_of_forall ρ hAne fun C hC => ?_,
    isSmooth_toRepresentation ρ hρ _, fun K => ?_⟩
  · by_cases hC0 : C = ⊥
    · exact Or.inl hC0
    refine Or.inr (le_antisymm hC ?_)
    have hCne := hkey C (hC.trans (hAY.trans hYV)) hC0
    have h1 : C.toSubmodule ⊓ fixedVectors ρ U.toSubgroup ≤ M :=
      hM ▸ inf_le_inf_right _ (hC.trans hAY)
    have h2 : Module.finrank ℂ M ≤
        Module.finrank ℂ ↥(C.toSubmodule ⊓ fixedVectors ρ U.toSubgroup) := by
      rw [hM, hYk]
      exact hmin C (hC.trans (hAY.trans hYV)) hCne
    have h3 := Submodule.eq_of_le_of_finrank_le h1 h2
    exact generated_le ρ (h3 ▸ inf_le_left)
  · have := hfin K
    exact finite_fixedVectors_toRepresentation ρ _ V₀ (hAY.trans hYV) K.toSubgroup

end Abstract

end CuspidalAdmissible

namespace OperatorRealization

variable {F : Type u} [Field F] [NumberField F] {n : ℕ} (S : OperatorRealization F n)

local instance cuspidalAdmIrrAddCommGroupRationalInvariant :
    AddCommGroup (RationalInvariantFunctions F n) := Submodule.addCommGroup _
local instance cuspidalAdmIrrAddCommGroupContinuousRational :
    AddCommGroup (ContinuousRationalFunctions F n) := Submodule.addCommGroup _
local instance cuspidalAdmIrrAddCommGroupFiniteSmoothRational :
    AddCommGroup (FiniteSmoothRationalFunctions F n) := Submodule.addCommGroup _
local instance cuspidalAdmIrrAddCommGroupAutomorphicForms :
    AddCommGroup (AutomorphicForms F n) := Submodule.addCommGroup _
local instance cuspidalAdmIrrAddCommGroupStableAutomorphic :
    AddCommGroup (StableAutomorphicFunctions F n) := Submodule.addCommGroup _
local instance cuspidalAdmIrrAddCommGroupSpace : AddCommGroup S.Space := Submodule.addCommGroup _

/-- An endomorphism commuting with the finite action, as a self-intertwiner. -/
def commutingIntertwiner (T : Module.End ℂ S.Space)
    (hT : ∀ (d : FiniteAdelicGL F n) (f : S.Space),
      S.finiteRepresentation d (T f) = T (S.finiteRepresentation d f)) :
    S.finiteRepresentation.IntertwiningMap S.finiteRepresentation where
  toLinearMap := T
  isIntertwining' d := LinearMap.ext fun f => (hT d f).symm

variable (U : OpenSubgroup (FiniteAdelicGL F n)) (hU : IsCompact (U : Set (FiniteAdelicGL F n)))

/-- Averaging over `U` commutes with every endomorphism commuting with the finite action. -/
theorem averageMap_commute_of_commute (T : Module.End ℂ S.Space)
    (hT : ∀ (d : FiniteAdelicGL F n) (f : S.Space),
      S.finiteRepresentation d (T f) = T (S.finiteRepresentation d f)) (f : S.Space) :
    Compact.averageMap S.finiteRepresentation S.finiteRepresentation_isSmooth U hU (T f) =
      T (Compact.averageMap S.finiteRepresentation S.finiteRepresentation_isSmooth U hU f) :=
  (LinearMap.congr_fun (Compact.averageMap_commute S.finiteRepresentation S.finiteRepresentation
    S.finiteRepresentation_isSmooth S.finiteRepresentation_isSmooth U hU
    (S.commutingIntertwiner T hT)) f).symm

/-- The vectors all of whose finite translates have zero `U`-average. -/
def averageKernel : Submodule ℂ S.Space :=
  ⨅ d : FiniteAdelicGL F n, LinearMap.ker
    (Compact.averageMap S.finiteRepresentation S.finiteRepresentation_isSmooth U hU ∘ₗ
      S.finiteRepresentation d)

theorem mem_averageKernel (f : S.Space) :
    f ∈ S.averageKernel U hU ↔ ∀ d : FiniteAdelicGL F n,
      Compact.averageMap S.finiteRepresentation S.finiteRepresentation_isSmooth U hU
        (S.finiteRepresentation d f) = 0 := by
  simp only [averageKernel, Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply]

theorem averageKernel_finite (d : FiniteAdelicGL F n) (f : S.Space)
    (hf : f ∈ S.averageKernel U hU) : S.finiteRepresentation d f ∈ S.averageKernel U hU := by
  rw [mem_averageKernel] at hf ⊢
  intro d'
  have h := hf (d' * d)
  rwa [map_mul, Module.End.mul_apply] at h

set_option maxHeartbeats 1000000 in
theorem averageKernel_compact (k : standardInfiniteCompact F n) (f : S.Space)
    (hf : f ∈ S.averageKernel U hU) : S.compactRepresentation k f ∈ S.averageKernel U hU := by
  rw [mem_averageKernel] at hf ⊢
  intro d
  have h1 := S.finiteRepresentation_compactRepresentation d k f
  have h2 := S.averageMap_commute_of_commute U hU (S.compactRepresentation k)
    (fun d f => S.finiteRepresentation_compactRepresentation d k f) (S.finiteRepresentation d f)
  rw [h1, h2, hf d, map_zero]

set_option maxHeartbeats 1000000 in
theorem averageKernel_enveloping (a : ArchimedeanGL.EnvelopingAlgebra F n) (f : S.Space)
    (hf : f ∈ S.averageKernel U hU) : S.envelopingAction a f ∈ S.averageKernel U hU := by
  rw [mem_averageKernel] at hf ⊢
  intro d
  have h1 := S.finiteRepresentation_envelopingAction d a f
  have h2 := S.averageMap_commute_of_commute U hU (S.envelopingAction a)
    (fun d f => S.finiteRepresentation_envelopingAction d a f) (S.finiteRepresentation d f)
  rw [h1, h2, hf d, map_zero]

/-- A subrepresentation without `U`-fixed vectors lies in the average kernel. -/
theorem le_averageKernel (Z : Subrepresentation S.finiteRepresentation)
    (hZU : Z.toSubmodule ⊓ fixedVectors S.finiteRepresentation U.toSubgroup = ⊥) :
    Z.toSubmodule ≤ S.averageKernel U hU := by
  intro z hz
  rw [mem_averageKernel]
  intro d
  have hmem : Compact.averageMap S.finiteRepresentation S.finiteRepresentation_isSmooth U hU
      (S.finiteRepresentation d z) ∈
      Z.toSubmodule ⊓ fixedVectors S.finiteRepresentation U.toSubgroup :=
    Submodule.mem_inf.mpr ⟨CountableDual.averageMap_mem S.finiteRepresentation
      S.finiteRepresentation_isSmooth Z.toSubmodule
      (fun g v hv => Z.apply_mem_toSubmodule g hv) U hU (Z.apply_mem_toSubmodule d hz),
      Compact.averageMap_mem_fixedVectors _ _ U hU _⟩
  rw [hZU] at hmem
  exact (Submodule.mem_bot ℂ).mp hmem

set_option maxHeartbeats 1000000 in
/-- **Irreducibility forces fixed vectors.** In an irreducible realization with a nonzero
vector fixed by a compact open subgroup `U` of the finite adelic group, every nonzero
subrepresentation of the finite action has a nonzero `U`-fixed vector. -/
theorem inf_fixedVectors_ne_bot (hU : IsCompact (U : Set (FiniteAdelicGL F n)))
    (hS : S.IsIrreducible)
    (hfix : fixedVectors S.finiteRepresentation U.toSubgroup ≠ ⊥)
    (Z : Subrepresentation S.finiteRepresentation) (hZ : Z ≠ ⊥) :
    Z.toSubmodule ⊓ fixedVectors S.finiteRepresentation U.toSubgroup ≠ ⊥ := by
  intro hZU
  have hN : S.averageKernel U hU = ⊤ := by
    refine S.eq_top_of_generatorStable hS _ (S.averageKernel_finite U hU)
      (S.averageKernel_compact U hU) (S.averageKernel_enveloping U hU) ?_
    intro hN0
    apply hZ
    apply Subrepresentation.ext
    change Z.toSubmodule = ⊥
    rw [eq_bot_iff, ← hN0]
    exact S.le_averageKernel U hU Z hZU
  apply hfix
  rw [eq_bot_iff]
  intro f hf
  have hfN : f ∈ S.averageKernel U hU := hN ▸ Submodule.mem_top
  have h1 := (S.mem_averageKernel U hU f).mp hfN 1
  rw [map_one, Module.End.one_apply,
    Compact.averageMap_id _ _ U hU f hf] at h1
  exact (Submodule.mem_bot ℂ).mpr h1

end OperatorRealization

end Langlands.Automorphic
