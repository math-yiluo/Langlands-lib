import Langlands.Automorphic.AutomorphicAdmissibilityStatement
import Langlands.Automorphic.DifferentialCenterFinite
import Langlands.Representation.Smooth.FixedVectors.LawsProof

/-!
# Harish-Chandra finiteness implies admissibility of generated realizations

Borel and Jacquet (Corvallis 1979) derive Proposition 4.5 (1) ⇒ (4) from §4.3 (i).
This module proves the implication
`HarishChandraFinitenessStatement → GeneratedFormAdmissibilityStatement` for `GL_n` over a
number field.

* `CenterSeed.seedSpan c κ v` spans the vectors `c z (κ g v)` for an action `c` of a
  commutative algebra `Z` and a representation `κ` of a group `G` that normalizes it.
* `CenterSeed.seedAnnihilator c κ v` is the ideal of `Z` that kills this span. It has finite
  codimension when `v` is `G`-finite and `Z`-finite, and it is stable under the
  automorphisms of `Z` through which `G` normalizes `c`.
* `centerAnnihilatedRealization F n J hJ` consists of the stable forms annihilated by `J`,
  with `hJ` supplying stability of the ideal under conjugation by the standard compact
  subgroup at infinity.
* `exists_center_ideal_generatedFormOperatorRealization` constructs a finite-codimensional
  ideal of this kind whose realization contains the realization generated by the form.
* `isJointlyAdmissible_of_le_centerAnnihilatedRealization` transfers multiplicity finiteness
  to any realization contained in `centerAnnihilatedRealization F n J hJ`.

The compact action preserves the span of the central translates of the compact orbit.
Covariance of the center action then gives stability of the annihilator ideal.
-/

noncomputable section
universe u
set_option autoImplicit false

namespace Langlands.Automorphic

open Langlands.Global

namespace CenterSeed

variable {Z : Type*} [CommRing Z] [Algebra ℂ Z]
  {V : Type*} [AddCommGroup V] [Module ℂ V] {G : Type*} [Group G]

/-- The span of the vectors `c z (κ g v)`, for `g` in `G` and `z` in `Z`. -/
def seedSpan (c : Z →ₐ[ℂ] Module.End ℂ V) (κ : Representation ℂ G V) (v : V) :
    Submodule ℂ V :=
  Submodule.span ℂ (Set.range fun p : G × Z => c p.2 (κ p.1 v))

variable (c : Z →ₐ[ℂ] Module.End ℂ V) (κ : Representation ℂ G V)

theorem mem_seedSpan (v : V) (g : G) (z : Z) : c z (κ g v) ∈ seedSpan c κ v :=
  Submodule.subset_span ⟨(g, z), rfl⟩

theorem self_mem_seedSpan (v : V) : v ∈ seedSpan c κ v := by
  simpa only [map_one, Module.End.one_apply] using mem_seedSpan c κ v 1 1

/-- The seed is stable under `Z`. -/
theorem center_mem_seedSpan (v : V) (z : Z) {w : V} (hw : w ∈ seedSpan c κ v) :
    c z w ∈ seedSpan c κ v := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨⟨g, y⟩, rfl⟩ := hw
    change c z (c y (κ g v)) ∈ seedSpan c κ v
    have h : c z (c y (κ g v)) = c (z * y) (κ g v) := by
      rw [map_mul, Module.End.mul_apply]
    rw [h]
    exact mem_seedSpan c κ v g (z * y)
  | zero => simp
  | add w w' _ _ ih ih' => simpa only [map_add] using Submodule.add_mem _ ih ih'
  | smul a w _ ih => simpa only [map_smul] using Submodule.smul_mem _ a ih

variable {c κ} {θ : G → Z ≃ₐ[ℂ] Z}

/-- The seed is stable under `G` when `G` normalizes the action of `Z`. -/
theorem compact_mem_seedSpan (hcov : ∀ g z w, κ g (c z w) = c (θ g z) (κ g w))
    (v : V) (g : G) {w : V} (hw : w ∈ seedSpan c κ v) :
    κ g w ∈ seedSpan c κ v := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨⟨h, y⟩, rfl⟩ := hw
    change κ g (c y (κ h v)) ∈ seedSpan c κ v
    have hgh : κ g (κ h v) = κ (g * h) v := by
      rw [map_mul, Module.End.mul_apply]
    rw [hcov, hgh]
    exact mem_seedSpan c κ v (g * h) (θ g y)
  | zero => simp
  | add w w' _ _ ih ih' => simpa only [map_add] using Submodule.add_mem _ ih ih'
  | smul a w _ ih => simpa only [map_smul] using Submodule.smul_mem _ a ih

/-- The seed of a `G`-finite and `Z`-finite vector is finite-dimensional. -/
theorem seedSpan_finite (hcov : ∀ g z w, κ g (c z w) = c (θ g z) (κ g w)) (v : V)
    (hκ : FiniteVectors.IsFiniteVector κ v)
    (hc : FiniteVectors.IsFiniteVector (c.toMonoidHom : Representation ℂ Z V) v) :
    Module.Finite ℂ (seedSpan c κ v) := by
  classical
  have hfin : ∀ g : G,
      Module.Finite ℂ (Submodule.span ℂ (Set.range fun z : Z => c z (κ g v))) := by
    intro g
    have : Module.Finite ℂ
        (FiniteVectors.orbitSpan (c.toMonoidHom : Representation ℂ Z V) v) := hc
    apply Submodule.finiteDimensional_of_le
      (S₂ := (FiniteVectors.orbitSpan (c.toMonoidHom : Representation ℂ Z V) v).map (κ g))
    apply Submodule.span_le.mpr
    rintro _ ⟨z, rfl⟩
    refine ⟨c ((θ g).symm z) v, Submodule.subset_span ⟨(θ g).symm z, rfl⟩, ?_⟩
    change κ g (c ((θ g).symm z) v) = c z (κ g v)
    rw [hcov, AlgEquiv.apply_symm_apply]
  obtain ⟨s, hs, hspan⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset
      (Set.range fun g : G => κ g v)).mp (Module.Finite.iff_fg.mp hκ)
  let k : s → G := fun i => (hs i.property).choose
  have hk (i : s) : κ (k i) v = i.val := (hs i.property).choose_spec
  let S : Submodule ℂ V := ⨆ i : s, Submodule.span ℂ (Set.range fun z : Z => c z (κ (k i) v))
  have : ∀ i : s, Module.Finite ℂ
      (Submodule.span ℂ (Set.range fun z : Z => c z (κ (k i) v))) := fun i => hfin (k i)
  have : Module.Finite ℂ S := Submodule.finite_iSup _
  apply Submodule.finiteDimensional_of_le (S₂ := S)
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨g, z⟩, rfl⟩
  have hle : Submodule.span ℂ (s : Set V) ≤ S.comap (c z) := by
    apply Submodule.span_le.mpr
    intro w hw
    let i : s := ⟨w, hw⟩
    change c z i.val ∈ S
    rw [← hk i]
    exact (le_iSup (fun j : s => Submodule.span ℂ (Set.range fun y : Z => c y (κ (k j) v))) i)
      (Submodule.subset_span ⟨z, rfl⟩)
  apply hle
  rw [← hspan]
  exact Submodule.subset_span ⟨g, rfl⟩

variable (c κ)

/-- The ideal of `Z` that annihilates the whole seed. -/
def seedAnnihilator (v : V) : Ideal Z where
  carrier := {z | ∀ w ∈ seedSpan c κ v, c z w = 0}
  add_mem' {a b} ha hb w hw := by
    rw [map_add, LinearMap.add_apply, ha w hw, hb w hw, add_zero]
  zero_mem' w _ := by rw [map_zero, LinearMap.zero_apply]
  smul_mem' a b hb w hw := by
    rw [smul_eq_mul, map_mul, Module.End.mul_apply, hb w hw, map_zero]

theorem mem_seedAnnihilator {v : V} {z : Z} :
    z ∈ seedAnnihilator c κ v ↔ ∀ w ∈ seedSpan c κ v, c z w = 0 := Iff.rfl

theorem apply_eq_zero_of_mem_seedAnnihilator {v : V} {z : Z}
    (hz : z ∈ seedAnnihilator c κ v) : c z v = 0 :=
  hz v (self_mem_seedSpan c κ v)

/-- The action of `Z` restricted to the seed. -/
def seedRestriction (v : V) : Z →ₗ[ℂ] Module.End ℂ (seedSpan c κ v) where
  toFun z := (c z).restrict (fun _ hw => center_mem_seedSpan c κ v z hw)
  map_add' a b := by
    apply LinearMap.ext
    intro w
    apply Subtype.ext
    simp [LinearMap.restrict_apply]
  map_smul' t a := by
    apply LinearMap.ext
    intro w
    apply Subtype.ext
    simp [LinearMap.restrict_apply]

theorem seedAnnihilator_restrictScalars (v : V) :
    (seedAnnihilator c κ v).restrictScalars ℂ = LinearMap.ker (seedRestriction c κ v) := by
  ext z
  rw [Submodule.restrictScalars_mem, LinearMap.mem_ker, mem_seedAnnihilator]
  constructor
  · intro hz
    apply LinearMap.ext
    intro w
    apply Subtype.ext
    exact hz w.val w.property
  · intro hz w hw
    exact congrArg (fun A : Module.End ℂ (seedSpan c κ v) => (A ⟨w, hw⟩).val) hz

/-- The seed annihilator has finite codimension when the seed is finite-dimensional. -/
theorem seedAnnihilator_finite_quotient (v : V) [Module.Finite ℂ (seedSpan c κ v)] :
    Module.Finite ℂ (Z ⧸ (seedAnnihilator c κ v).restrictScalars ℂ) := by
  rw [seedAnnihilator_restrictScalars]
  have : Module.Finite ℂ (Module.End ℂ (seedSpan c κ v)) := Module.Finite.linearMap ℂ ℂ _ _
  have : Module.Finite ℂ (LinearMap.range (seedRestriction c κ v)) := inferInstance
  exact Module.Finite.of_injective (seedRestriction c κ v).quotKerEquivRange.toLinearMap
    (seedRestriction c κ v).quotKerEquivRange.injective

variable {c κ}

/-- The seed annihilator is stable under the automorphisms through which `G` acts. -/
theorem symm_mem_seedAnnihilator (hcov : ∀ g z w, κ g (c z w) = c (θ g z) (κ g w))
    (v : V) (g : G) {z : Z} (hz : z ∈ seedAnnihilator c κ v) :
    (θ g).symm z ∈ seedAnnihilator c κ v := by
  rw [mem_seedAnnihilator]
  intro w hw
  have h : κ g (c ((θ g).symm z) w) = 0 := by
    rw [hcov, AlgEquiv.apply_symm_apply]
    exact hz _ (compact_mem_seedSpan hcov v g hw)
  have hinv : ∀ x : V, κ g⁻¹ (κ g x) = x := fun x => by
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
  rw [← hinv (c ((θ g).symm z) w), h, map_zero]

end CenterSeed

variable (F : Type u) [Field F] [NumberField F] (n : ℕ)

local instance generatedReductionRationalGroup : AddCommGroup (RationalInvariantFunctions F n) :=
  Submodule.addCommGroup _
local instance generatedReductionContinuousGroup :
    AddCommGroup (ContinuousRationalFunctions F n) := Submodule.addCommGroup _
local instance generatedReductionSmoothGroup :
    AddCommGroup (FiniteSmoothRationalFunctions F n) := Submodule.addCommGroup _
local instance generatedReductionFormGroup : AddCommGroup (AutomorphicForms F n) :=
  Submodule.addCommGroup _
local instance generatedReductionStableGroup : AddCommGroup (StableAutomorphicFunctions F n) :=
  Submodule.addCommGroup _
local instance generatedReductionRealizationGroup (S : OperatorRealization F n) :
    AddCommGroup S.Space := Submodule.addCommGroup _

/-- Compact translation transforms the center action by center conjugation. -/
theorem finiteSmoothCompactRightAction_centerAction (k : standardInfiniteCompact F n)
    (z : ArchimedeanGL.EnvelopingCenter F n) (f : FiniteSmoothRationalFunctions F n) :
    finiteSmoothCompactRightAction F n k (finiteSmoothCenterAction F n z f) =
      finiteSmoothCenterAction F n (ArchimedeanGL.centerConjugation F n k.val z)
        (finiteSmoothCompactRightAction F n k f) :=
  finiteSmoothRightAction_envelopingAction k.val (ArchimedeanGL.centerInclusion F n z) f

/-- The finite-smooth functions annihilated by every element of an ideal of the center. -/
def centerAnnihilatedSmooth (J : Ideal (ArchimedeanGL.EnvelopingCenter F n)) :
    Submodule ℂ (FiniteSmoothRationalFunctions F n) :=
  ⨅ z ∈ J, LinearMap.ker (finiteSmoothCenterAction F n z)

theorem mem_centerAnnihilatedSmooth (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (f : FiniteSmoothRationalFunctions F n) :
    f ∈ centerAnnihilatedSmooth F n J ↔ ∀ z ∈ J, finiteSmoothCenterAction F n z f = 0 := by
  simp only [centerAnnihilatedSmooth, Submodule.mem_iInf, LinearMap.mem_ker]

/-- The annihilated functions form an operator-invariant subspace when the ideal is stable
under conjugation by the standard compact subgroup at infinity. -/
theorem centerAnnihilatedSmooth_invariant (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
      (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J)
    (a : automorphicOperatorAlgebra F n) (f : FiniteSmoothRationalFunctions F n)
    (hf : f ∈ centerAnnihilatedSmooth F n J) :
    a.val f ∈ centerAnnihilatedSmooth F n J := by
  refine (operator_invariant_iff F n (centerAnnihilatedSmooth F n J)).mpr
    ⟨?_, ?_, ?_⟩ a f hf
  · intro d g hg
    rw [mem_centerAnnihilatedSmooth] at hg ⊢
    intro z hz
    change finiteSmoothEnvelopingAction F n (ArchimedeanGL.centerInclusion F n z)
      (finiteSmoothFiniteRightAction F n d g) = 0
    rw [← finiteSmoothFiniteRightAction_envelopingAction]
    exact (congrArg (finiteSmoothFiniteRightAction F n d) (hg z hz)).trans (map_zero _)
  · intro k g hg
    rw [mem_centerAnnihilatedSmooth] at hg ⊢
    intro z hz
    have h := finiteSmoothCompactRightAction_centerAction F n k
      ((ArchimedeanGL.centerConjugation F n k.val).symm z) g
    rw [AlgEquiv.apply_symm_apply] at h
    rw [← h, hg _ (hJ k z hz), map_zero]
  · intro b g hg
    rw [mem_centerAnnihilatedSmooth] at hg ⊢
    intro z hz
    rw [← finiteSmoothEnvelopingAction_center_commute, hg z hz, map_zero]

/-- The stable forms annihilated by a compact-conjugation-stable ideal of the center. -/
def centerAnnihilatedRealization (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
      (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J) :
    OperatorRealization F n where
  toSubmodule := (centerAnnihilatedSmooth F n J).comap (StableAutomorphicFunctions F n).subtype
  apply_mem_toSubmodule a f hf := centerAnnihilatedSmooth_invariant F n J hJ a f.val hf

theorem mem_centerAnnihilatedRealization (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
      (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J)
    (f : StableAutomorphicFunctions F n) :
    f ∈ centerAnnihilatedRealization F n J hJ ↔ f.val ∈ centerAnnihilatedSmooth F n J :=
  Iff.rfl

/-- Every automorphic form has a finite-codimensional ideal of the center, stable under
conjugation by the standard compact subgroup at infinity, that annihilates the whole
realization generated by the form. -/
theorem exists_center_ideal_generatedFormOperatorRealization (f : AutomorphicForms F n) :
    ∃ J : Ideal (ArchimedeanGL.EnvelopingCenter F n),
      Module.Finite ℂ (ArchimedeanGL.EnvelopingCenter F n ⧸ J.restrictScalars ℂ) ∧
      ∃ hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
          (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J,
        generatedFormOperatorRealization F n f ≤ centerAnnihilatedRealization F n J hJ := by
  have hcov : ∀ (k : standardInfiniteCompact F n) (z : ArchimedeanGL.EnvelopingCenter F n)
      (w : FiniteSmoothRationalFunctions F n),
      finiteSmoothCompactRightAction F n k (finiteSmoothCenterAction F n z w) =
        finiteSmoothCenterAction F n (ArchimedeanGL.centerConjugation F n k.val z)
          (finiteSmoothCompactRightAction F n k w) :=
    finiteSmoothCompactRightAction_centerAction F n
  have hκ : FiniteVectors.IsFiniteVector (finiteSmoothCompactRightAction F n) f.val :=
    (automorphicCompactRightAction_isFiniteVector F n f).map
      (automorphicCompactFiniteSmoothInclusion F n)
  have hc : FiniteVectors.IsFiniteVector (finiteSmoothCenterRepresentation F n) f.val :=
    (isCenterFinite_iff_finiteSmoothCenterVector F n f.val).mp
      ((mem_automorphicSubrepresentation F n f.val).mp f.property).2.2.1
  have : Module.Finite ℂ (CenterSeed.seedSpan (finiteSmoothCenterAction F n)
      (finiteSmoothCompactRightAction F n) f.val) :=
    CenterSeed.seedSpan_finite hcov f.val hκ hc
  refine ⟨CenterSeed.seedAnnihilator (finiteSmoothCenterAction F n)
      (finiteSmoothCompactRightAction F n) f.val,
    CenterSeed.seedAnnihilator_finite_quotient _ _ f.val,
    fun k z hz => CenterSeed.symm_mem_seedAnnihilator hcov f.val k hz, ?_⟩
  rw [generatedFormOperatorRealization_le_iff, OperatorRealization.mem_fullFormImage_iff,
    mem_centerAnnihilatedRealization, stableAutomorphicEquiv_symm_val,
    mem_centerAnnihilatedSmooth]
  intro z hz
  exact CenterSeed.apply_eq_zero_of_mem_seedAnnihilator _ _ hz

/-- The inclusion of a realization in the automorphic forms keeps the underlying function. -/
theorem formInclusion_val (S : OperatorRealization F n) (x : S.Space) :
    (S.formInclusion x).val = x.val.val :=
  rfl

/-- The inclusion of a realization in the automorphic forms intertwines compact translation. -/
theorem formInclusion_compactRepresentation (S : OperatorRealization F n)
    (k : standardInfiniteCompact F n) (x : S.Space) :
    S.formInclusion (S.compactRepresentation k x) =
      automorphicCompactRightAction F n k (S.formInclusion x) := by
  apply Subtype.ext
  calc (S.formInclusion (S.compactRepresentation k x)).val
      = (S.inclusion (S.compactRepresentation k x)).val :=
        formInclusion_val F n S (S.compactRepresentation k x)
    _ = (stableAutomorphicCompactAction F n k (S.inclusion x)).val :=
        congrArg Subtype.val (S.inclusion_compactRepresentation k x)
    _ = finiteSmoothRightAction F n (AdelicGL.ofInfinite F n k.val) (S.inclusion x).val :=
        stableAutomorphicCompactAction_val F n k (S.inclusion x)
    _ = finiteSmoothCompactRightAction F n k (S.formInclusion x).val := rfl
    _ = (automorphicCompactRightAction F n k (S.formInclusion x)).val :=
        (automorphicCompactRightAction_val F n k (S.formInclusion x)).symm

/-- A realization contained in `centerAnnihilatedRealization F n J hJ` consists of forms
annihilated by `J`. -/
theorem formInclusion_mem_centerAnnihilatedForms
    (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
      (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J)
    (S : OperatorRealization F n) (hle : S ≤ centerAnnihilatedRealization F n J hJ)
    (x : S.Space) :
    S.formInclusion x ∈ centerAnnihilatedForms F n J := by
  have hx : x.val.val ∈ centerAnnihilatedSmooth F n J :=
    (mem_centerAnnihilatedRealization F n J hJ x.val).mp (hle x.property)
  rw [mem_centerAnnihilatedSmooth] at hx
  simp only [centerAnnihilatedForms, Submodule.mem_iInf, LinearMap.mem_ker]
  intro z hz
  apply Subtype.ext
  rw [automorphicEnvelopingAction_val, formInclusion_val]
  exact hx z hz

/-- Composition with the inclusion of a realization contained in
`centerAnnihilatedRealization F n J hJ` maps its multiplicity spaces into those of the forms
annihilated by `J`. -/
theorem formInclusion_comp_mem_annihilatedFormMultiplicitySpace
    (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
      (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J)
    (S : OperatorRealization F n) (hle : S ≤ centerAnnihilatedRealization F n J hJ)
    (L : Subgroup (FiniteAdelicGL F n)) {m : ℕ}
    (σ : Representation ℂ (standardInfiniteCompact F n) (Fin m → ℂ))
    (φ : (Fin m → ℂ) →ₗ[ℂ] S.Space)
    (hφ : φ ∈ jointMultiplicitySpace S.finiteRepresentation S.compactRepresentation L σ) :
    S.formInclusion.toLinearMap ∘ₗ φ ∈ annihilatedFormMultiplicitySpace F n J L σ := by
  obtain ⟨hfix, heq⟩ := (Langlands.mem_jointMultiplicitySpace _ _ _ _ _).mp hφ
  have h1 : ∀ v, S.formInclusion (φ v) ∈ fixedVectors (automorphicFiniteRightAction F n) L :=
    fun v => Langlands.map_mem_fixedVectors S.formInclusion (hfix v)
  have h2 : ∀ k v, S.formInclusion (φ (σ k v)) =
      automorphicCompactRightAction F n k (S.formInclusion (φ v)) := fun k v =>
    (congrArg S.formInclusion (heq k v)).trans (formInclusion_compactRepresentation F n S k (φ v))
  have h3 : ∀ v, S.formInclusion (φ v) ∈ centerAnnihilatedForms F n J := fun v =>
    formInclusion_mem_centerAnnihilatedForms F n J hJ S hle (φ v)
  exact Submodule.mem_inf.mpr ⟨(Langlands.mem_jointMultiplicitySpace _ _ _ _ _).mpr ⟨h1, h2⟩,
    Submodule.mem_iInf _ |>.mpr fun v => Submodule.mem_comap.mpr (h3 v)⟩

/-- A realization contained in `centerAnnihilatedRealization F n J hJ` is jointly admissible
as soon as the multiplicity spaces of the forms annihilated by `J` are finite-dimensional. -/
theorem isJointlyAdmissible_of_le_centerAnnihilatedRealization
    (J : Ideal (ArchimedeanGL.EnvelopingCenter F n))
    (hJ : ∀ k : standardInfiniteCompact F n, ∀ z ∈ J,
      (ArchimedeanGL.centerConjugation F n k.val).symm z ∈ J)
    (S : OperatorRealization F n) (hle : S ≤ centerAnnihilatedRealization F n J hJ)
    (hfin : ∀ (L : OpenSubgroup (FiniteAdelicGL F n)) (m : ℕ)
      (σ : Representation ℂ (standardInfiniteCompact F n) (Fin m → ℂ)),
      FiniteDimensional ℂ (annihilatedFormMultiplicitySpace F n J L.toSubgroup σ)) :
    S.IsJointlyAdmissible := by
  intro L m σ
  let Φ : jointMultiplicitySpace S.finiteRepresentation S.compactRepresentation
      L.toSubgroup σ →ₗ[ℂ] annihilatedFormMultiplicitySpace F n J L.toSubgroup σ :=
    { toFun := fun φ => ⟨S.formInclusion.toLinearMap ∘ₗ φ.val,
        formInclusion_comp_mem_annihilatedFormMultiplicitySpace F n J hJ S hle L.toSubgroup σ
          φ.val φ.property⟩
      map_add' := fun φ ψ => Subtype.ext (LinearMap.comp_add _ _ _)
      map_smul' := fun a φ => Subtype.ext (LinearMap.comp_smul _ _ _) }
  have hΦ : Function.Injective Φ := by
    intro φ ψ h
    apply Subtype.ext
    apply LinearMap.ext
    intro v
    apply S.formInclusion_injective
    exact congrArg (fun χ : annihilatedFormMultiplicitySpace F n J L.toSubgroup σ =>
      (χ : (Fin m → ℂ) →ₗ[ℂ] AutomorphicForms F n) v) h
  have := hfin L m σ
  exact FiniteDimensional.of_injective
    (V₂ := annihilatedFormMultiplicitySpace F n J L.toSubgroup σ) Φ hΦ

/-- The implication from Borel–Jacquet §4.3 (i) to Proposition 4.5 (1) ⇒ (4) for `GL_n`. -/
def GeneratedFormAdmissibilityReductionStatement : Prop :=
  HarishChandraFinitenessStatement.{u} → GeneratedFormAdmissibilityStatement.{u}

theorem generatedFormAdmissibility_of_harishChandraFiniteness :
    GeneratedFormAdmissibilityReductionStatement.{u} := by
  intro hHC F _ _ n f
  obtain ⟨J, hJfin, hJ, hle⟩ := exists_center_ideal_generatedFormOperatorRealization F n f
  exact isJointlyAdmissible_of_le_centerAnnihilatedRealization F n J hJ _ hle
    (hHC F n J hJfin)

end Langlands.Automorphic
