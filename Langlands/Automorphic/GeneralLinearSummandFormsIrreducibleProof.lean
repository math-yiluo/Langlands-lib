import Langlands.Automorphic.GeneralLinearQuotientJointRecovery
import Langlands.Automorphic.GeneralLinearSummandFormsEnveloping
import Langlands.Automorphic.GeneratedFormAdmissibilityReduction
import Langlands.Automorphic.HarishChandraFinitenessProof
import Langlands.Automorphic.FullOperatorRealization

/-! # Algebraic irreducibility of the forms attached to an irreducible cuspidal summand -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry NumberField MeasureTheory
open scoped CategoryTheory.MonObj Topology

set_option autoImplicit false

namespace Langlands.Automorphic.GroupSchemeFunctions

open Langlands.Global Langlands.Global.AdelicGroupPoints
open Langlands.Global.PositiveRealTorus Langlands.GroupScheme

local instance (F : Type u) [Field F] (n : ℕ) :
    IsAffine (GroupScheme.GeneralLinear.groupScheme (Fin n) (CommRingCat.of F)).X.left :=
  GroupScheme.GeneralLinear.isAffine_groupScheme (Fin n) (CommRingCat.of F)

local instance (F : Type u) [Field F] (n : ℕ) :
    Smooth (GroupScheme.GeneralLinear.groupScheme (Fin n) (CommRingCat.of F)).X.hom :=
  GroupScheme.GeneralLinear.smoothStatement (Fin n) (CommRingCat.of F)

local instance (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (Langlands.Automorphic.RationalInvariantFunctions F n) := Submodule.addCommGroup _
local instance (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (Langlands.Automorphic.ContinuousRationalFunctions F n) := Submodule.addCommGroup _
local instance (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (FiniteSmoothRationalFunctions F n) := Submodule.addCommGroup _
local instance (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (AutomorphicForms F n) := Submodule.addCommGroup _
local instance (F : Type u) [Field F] [NumberField F] (n : ℕ) :
    AddCommGroup (StableAutomorphicFunctions F n) := Submodule.addCommGroup _
local instance (F : Type u) [Field F] [NumberField F] (n : ℕ)
    (R : OperatorRealization F n) : AddCommGroup R.Space := Submodule.addCommGroup R.toSubmodule

set_option maxHeartbeats 4000000 in
set_option synthInstance.maxHeartbeats 400000 in
set_option backward.isDefEq.respectTransparency false in
/-- A nonzero operator realization inside the forms attached to `P` contains the realization
generated by one of its nonzero forms. That realization is jointly admissible by
Harish-Chandra finiteness, its class image has closure `P` by full-group invariance and
minimality, and joint-vector recovery puts every attached form inside it. -/
theorem generalLinearSummandFormsIrreducible :
    GeneralLinearSummandFormsIrreducibleStatement.{u} := by
  intro F _ _ _ r hPD T i hi _ I _ e hc _ hG S πc P hPmin W hW
  obtain ⟨hPne, hPc, hPinv, hPmin'⟩ := hPmin
  by_cases hbot : W = ⊥
  · exact Or.inl hbot
  right
  refine le_antisymm hW ?_
  let G := GroupScheme.GeneralLinear.groupScheme (Fin (r + 1)) (CommRingCat.of F)
  let E := Lp ℂ 2 (positiveRationalQuotientHaarMeasure F G T i)
  let ρ := haarQuotientL2BoundedRightAction F G T i hi I e hc
  let hLie := generalLinearSummandFormsEnveloping.{u}
  let V := summandRealization F r hPD T i hi I e hc hLie P hPc hPinv
  let cm := summandClassMap F r hPD T i hi I e hc hLie P hPc hPinv
  let jV : V.Space →ₗ[ℂ] E := S.subtype ∘ₗ cm
  have hjV : ∀ y, IsGeneralLinearFormClass F r T i (jV y) (V.toContinuous y) :=
    summandClassMap_isClass F r hPD T i hi I e hc hLie P hPc hPinv
  have hcmP : ∀ y, cm y ∈ P := fun y =>
    range_summandClassMap_le F r hPD T i hi I e hc hLie P hPc hPinv (LinearMap.mem_range_self _ y)
  -- a nonzero form of `W` and the realization it generates
  obtain ⟨f, hfW, hf0⟩ : ∃ f ∈ W.toSubmodule, f ≠ 0 := by
    by_contra! h
    exact hbot (Subrepresentation.ext ((Submodule.eq_bot_iff _).mpr h))
  let g := stableAutomorphicEquiv F (r + 1) f
  let R₀ := generatedFormOperatorRealization F (r + 1) g
  have hfR₀ : f ∈ R₀.toSubmodule := by
    have h := (R₀.mem_fullFormImage_iff g).mp (mem_generatedFormOperatorRealization F (r + 1) g)
    simp only [g, ContinuousLinearEquiv.symm_apply_apply] at h
    exact h
  have hR₀W : R₀ ≤ W := (generatedFormOperatorRealization_le_iff F (r + 1) g W).mpr
    ((W.mem_fullFormImage_iff g).mpr (by
      simp only [g, ContinuousLinearEquiv.symm_apply_apply]
      exact hfW))
  have hAd : R₀.IsJointlyAdmissible :=
    generatedFormAdmissibility_of_harishChandraFiniteness harishChandraFiniteness F (r + 1) g
  have hR₀V : R₀.toSubmodule ≤ V.toSubmodule := fun x hx => hW (hR₀W hx)
  let incl : R₀.Space →ₗ[ℂ] V.Space := Submodule.inclusion hR₀V
  let j₀ : R₀.Space →ₗ[ℂ] E := jV ∘ₗ incl
  have hj₀ : ∀ x, IsGeneralLinearFormClass F r T i (j₀ x) (R₀.toContinuous x) := fun x => hjV (incl x)
  -- the closure of the class image of `R₀`
  let H₀ := (LinearMap.range j₀).topologicalClosure
  have hS : IsClosed (S : Set E) :=
    (fullAEL2CuspidalClosedSubmodule F G hPD hG T i hi I e hc).isClosed
  have hA : IsClosed ((P.map S.subtype : Submodule ℂ E) : Set E) :=
    hS.isClosedEmbedding_subtypeVal.isClosedMap _ hPc
  have hH₀A : H₀ ≤ P.map S.subtype := by
    refine Submodule.topologicalClosure_minimal _ ?_ hA
    rintro _ ⟨x, rfl⟩
    exact Submodule.mem_map_of_mem (hcmP (incl x))
  let P' : Submodule ℂ S := H₀.comap S.subtype
  have hP'c : IsClosed (P' : Set S) :=
    (Submodule.isClosed_topologicalClosure _).preimage continuous_subtype_val
  have hP'inv : ∀ a, ∀ x ∈ P', πc a x ∈ P' := fun a x hx =>
    generalLinearQuotientFormClassClosure F r T i hi I e hc R₀ j₀ hj₀ a (x : E) hx
  have hP'P : P' ≤ P := by
    intro x hx
    obtain ⟨p, hp, hpx⟩ := Submodule.mem_map.mp (hH₀A hx)
    rwa [← Subtype.ext hpx]
  let x₀ : R₀.Space := ⟨f, hfR₀⟩
  have hx₀ : j₀ x₀ ≠ 0 := by
    intro h
    have h0 := hj₀ x₀
    rw [h] at h0
    have he := generalLinearFormClass_form_eq F r T i hi I e hc h0
      (isGeneralLinearFormClass_zero F r T i)
    apply hf0
    have hx : x₀ = 0 := R₀.toContinuous_injective (he.trans (map_zero _).symm)
    exact congrArg Subtype.val hx
  have hP'ne : P' ≠ ⊥ := by
    intro h
    have hmem : cm (incl x₀) ∈ P' :=
      (LinearMap.range j₀).le_topologicalClosure (LinearMap.mem_range_self j₀ x₀)
    rw [h, Submodule.mem_bot] at hmem
    exact hx₀ (by change ((cm (incl x₀) : S) : E) = 0; rw [hmem]; rfl)
  have hP'eq : P' = P := (hPmin' P' hP'P hP'c hP'inv).resolve_left hP'ne
  -- every attached class lies in the closure, hence in the image of `R₀`
  have hle : LinearMap.range jV ≤ (LinearMap.range j₀).topologicalClosure := by
    rintro _ ⟨y, rfl⟩
    have hy : cm y ∈ P' := by
      rw [hP'eq]
      exact hcmP y
    exact hy
  have hrec := generalLinearQuotientJointRecovery F r T i hi I e hc R₀ V hAd j₀ jV hj₀ hjV hle
  intro h hh
  let y : V.Space := ⟨h, hh⟩
  obtain ⟨x, hx⟩ := hrec (LinearMap.mem_range_self jV y)
  have hcont : R₀.toContinuous x = V.toContinuous y := by
    have h₁ := hj₀ x
    rw [hx] at h₁
    exact generalLinearFormClass_form_eq F r T i hi I e hc h₁ (hjV y)
  have hxy : incl x = y := V.toContinuous_injective hcont
  have hval : (x : StableAutomorphicFunctions F (r + 1)) = h := congrArg Subtype.val hxy
  exact hR₀W (hval ▸ x.property)

end Langlands.Automorphic.GroupSchemeFunctions
