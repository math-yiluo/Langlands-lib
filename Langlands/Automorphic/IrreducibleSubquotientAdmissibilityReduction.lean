import Langlands.Automorphic.CuspidalArchimedeanGenericComponentReduction
import Langlands.Automorphic.AutomorphicAdmissibilityStatement
import Langlands.Automorphic.OperatorCompactCompletion
import Langlands.Representation.CompactMaschke
import Langlands.Representation.Compact.ProjectionProof

/-!
# Admissibility of irreducible automorphic subquotients from admissibility of generated
realizations

Borel and Jacquet (Corvallis 1979), §4.6: an automorphic representation "is always
admissible", which "follows from 4.5". This module proves the implication
`GeneratedFormAdmissibilityStatement → IrreducibleSubquotientAdmissibilityStatement` for
`GL_n` over a number field.

* `Langlands.jointMultiplicitySpace_mono`: multiplicity spaces grow when the open subgroup
  shrinks.
* `Langlands.isJointlyAdmissible_of_surjective`: joint admissibility passes to quotients.
  The `L`-fixed vectors are lifted by averaging over a compact open subgroup and the
  `K`-equivariance by the compact Maschke lifting lemma.
* `OperatorSubquotient.isJointlyAdmissible_of_surjective`: an operator subquotient that is
  the image of a jointly admissible operator realization under a whole-operator
  intertwiner is jointly admissible.
* `OperatorSubquotient.exists_generatedForm_surjective`: an irreducible operator
  subquotient is the image of the realization generated by one automorphic form.
* `irreducibleSubquotientAdmissibility_of_generatedFormAdmissibility`: the implication.
-/

noncomputable section
universe u
set_option autoImplicit false

open scoped Matrix

namespace Langlands

section Monotone

variable {G : Type*} [Group G] {K : Type*} [Group K]
  {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- A smaller subgroup has a larger joint multiplicity space. -/
theorem jointMultiplicitySpace_mono (ρ : Representation ℂ G V) (κ : Representation ℂ K V)
    {L L' : Subgroup G} (h : L' ≤ L) {m : ℕ} (σ : Representation ℂ K (Fin m → ℂ)) :
    jointMultiplicitySpace ρ κ L σ ≤ jointMultiplicitySpace ρ κ L' σ := by
  intro φ hφ
  refine ⟨fun v => ?_, hφ.2⟩
  intro d
  exact hφ.1 v ⟨d.1, h d.2⟩

end Monotone

section QuotientAdmissibility

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {K : Type*} [Group K] [TopologicalSpace K] [IsTopologicalGroup K] [CompactSpace K]
  {V : Type*} [AddCommGroup V] [Module ℂ V] {W : Type*} [AddCommGroup W] [Module ℂ W]

/-- **Quotients of jointly admissible pairs.** Let `ρ` (smooth) and `κ` be commuting
representations of `G` and of the compact group `K` on `V`, with every vector in a
finite-dimensional `κ`-stable subspace and weakly continuous `κ`-orbits, and suppose every
open subgroup of `G` contains a compact open subgroup. If `p : V → W` is surjective and
intertwines `ρ, κ` with smooth `ρ'` and `κ'`, joint admissibility of `(ρ, κ)` implies joint
admissibility of `(ρ', κ')`. -/
theorem isJointlyAdmissible_of_surjective
    {ρ : Representation ℂ G V} {κ : Representation ℂ K V}
    {ρ' : Representation ℂ G W} {κ' : Representation ℂ K W}
    (hρ : IsSmooth ρ) (hρ' : IsSmooth ρ')
    (hcomm : ∀ g k v, ρ g (κ k v) = κ k (ρ g v))
    (hfin : ∀ x : V, ∃ E : Submodule ℂ V, FiniteDimensional ℂ E ∧ x ∈ E ∧
      ∀ (k : K), ∀ y ∈ E, κ k y ∈ E)
    (hweak : ∀ (μ : V →ₗ[ℂ] ℂ) (x : V), Continuous fun k => μ (κ k x))
    (hcpt : ∀ L : OpenSubgroup G, ∃ L₀ : OpenSubgroup G, L₀ ≤ L ∧ IsCompact (L₀ : Set G))
    (p : V →ₗ[ℂ] W) (hp : Function.Surjective p)
    (hpρ : ∀ g v, p (ρ g v) = ρ' g (p v)) (hpκ : ∀ k v, p (κ k v) = κ' k (p v))
    (hA : IsJointlyAdmissible ρ κ) : IsJointlyAdmissible ρ' κ' := by
  classical
  intro L m σ
  obtain ⟨L₀, hL₀L, hL₀⟩ := hcpt L
  have hfd : FiniteDimensional ℂ (jointMultiplicitySpace ρ κ L₀.toSubgroup σ) := hA L₀ m σ
  let Φ : ((Fin m → ℂ) →ₗ[ℂ] V) →ₗ[ℂ] ((Fin m → ℂ) →ₗ[ℂ] W) :=
    LinearMap.llcomp ℂ (Fin m → ℂ) V W p
  -- the matrix form of `σ`
  let τ : K →* Matrix (Fin m) (Fin m) ℂ :=
    (LinearMap.toMatrixAlgEquiv' : ((Fin m → ℂ) →ₗ[ℂ] (Fin m → ℂ)) ≃ₐ[ℂ] _).toRingEquiv
      |>.toMonoidHom.comp σ
  have hτ : ∀ k x, τ k *ᵥ x = σ k x := fun k x => by
    change LinearMap.toMatrix' (σ k) *ᵥ x = σ k x
    exact LinearMap.toMatrix'_mulVec (σ k) x
  -- averaging over `L₀`
  let A : V →ₗ[ℂ] V := Compact.averageMap ρ hρ L₀ hL₀
  let A' : W →ₗ[ℂ] W := Compact.averageMap ρ' hρ' L₀ hL₀
  have hAκ : ∀ k v, A (κ k v) = κ k (A v) := fun k v => by
    let f : ρ.IntertwiningMap ρ := ⟨κ k, fun g => LinearMap.ext fun w => (hcomm g k w).symm⟩
    have h := Compact.averageMap_commute ρ ρ hρ hρ L₀ hL₀ f
    exact (LinearMap.congr_fun h v).symm
  have hpA : ∀ v, p (A v) = A' (p v) := fun v => by
    let f : ρ.IntertwiningMap ρ' := ⟨p, fun g => LinearMap.ext fun w => hpρ g w⟩
    have h := Compact.averageMap_commute ρ ρ' hρ hρ' L₀ hL₀ f
    exact LinearMap.congr_fun h v
  -- every multiplicity map of the quotient lifts
  have hlift : jointMultiplicitySpace ρ' κ' L₀.toSubgroup σ ≤
      (jointMultiplicitySpace ρ κ L₀.toSubgroup σ).map Φ := by
    intro φ hφ
    have hφK : ∀ k x, φ (τ k *ᵥ x) = κ' k (φ x) := fun k x => by
      rw [hτ]
      exact hφ.2 k x
    obtain ⟨ψ, hψK, hψp⟩ := CompactMaschke.exists_lift_intertwiner κ κ' hfin hweak p hpκ τ φ
      hφK (fun x => LinearMap.mem_range.mpr (hp (φ x)))
    refine ⟨A ∘ₗ ψ, ⟨fun v => Compact.averageMap_mem_fixedVectors ρ hρ L₀ hL₀ (ψ v),
      fun k v => ?_⟩, ?_⟩
    · change A (ψ (σ k v)) = κ k (A (ψ v))
      rw [← hτ, hψK, hAκ]
    · apply LinearMap.ext
      intro v
      change p (A (ψ v)) = φ v
      rw [hpA]
      have hv : p (ψ v) = φ v := LinearMap.congr_fun hψp v
      rw [hv]
      exact Compact.averageMap_id ρ' hρ' L₀ hL₀ (φ v) (hφ.1 v)
  have hle : jointMultiplicitySpace ρ' κ' L.toSubgroup σ ≤
      (jointMultiplicitySpace ρ κ L₀.toSubgroup σ).map Φ :=
    (jointMultiplicitySpace_mono ρ' κ' (fun x hx => hL₀L hx) σ).trans hlift
  exact Submodule.finiteDimensional_of_le hle

end QuotientAdmissibility

namespace Automorphic

open Langlands.Global

local instance subquotientAdmissibilityRationalGroup (F : Type u) [Field F] [NumberField F]
    (n : ℕ) : AddCommGroup (RationalInvariantFunctions F n) := Submodule.addCommGroup _
local instance subquotientAdmissibilityContinuousGroup (F : Type u) [Field F] [NumberField F]
    (n : ℕ) : AddCommGroup (ContinuousRationalFunctions F n) := Submodule.addCommGroup _
local instance subquotientAdmissibilitySmoothGroup (F : Type u) [Field F] [NumberField F]
    (n : ℕ) : AddCommGroup (FiniteSmoothRationalFunctions F n) := Submodule.addCommGroup _
local instance subquotientAdmissibilityFormGroup (F : Type u) [Field F] [NumberField F]
    (n : ℕ) : AddCommGroup (AutomorphicForms F n) := Submodule.addCommGroup _
local instance subquotientAdmissibilityStableGroup (F : Type u) [Field F] [NumberField F]
    (n : ℕ) : AddCommGroup (StableAutomorphicFunctions F n) := Submodule.addCommGroup _
local instance subquotientAdmissibilityRealizationGroup {F : Type u} [Field F]
    [NumberField F] {n : ℕ} (S : OperatorRealization F n) : AddCommGroup S.Space :=
  Submodule.addCommGroup _

variable {F : Type u} [Field F] [NumberField F] {n : ℕ}

namespace OperatorRealization

/-- Every vector of an operator realization lies in a finite-dimensional subspace stable
under the standard compact subgroup at infinity. -/
theorem exists_compactStable_finiteDimensional (S : OperatorRealization F n) (x : S.Space) :
    ∃ E : Submodule ℂ S.Space, FiniteDimensional ℂ E ∧ x ∈ E ∧
      ∀ (k : standardInfiniteCompact F n), ∀ y ∈ E, S.compactRepresentation k y ∈ E :=
  ⟨FiniteVectors.orbitSpan _ x, S.compactRepresentation_isFiniteVector x,
    FiniteVectors.self_mem_orbitSpan _ x,
    fun k _ hy => (FiniteVectors.orbitSubrepresentation _ x).apply_mem_toSubmodule k hy⟩

end OperatorRealization

namespace OperatorSubquotient

/-- An operator subquotient that is the image of a jointly admissible operator realization
under a whole-operator intertwiner is jointly admissible. -/
theorem isJointlyAdmissible_of_surjective (Q : OperatorSubquotient F n)
    (S : OperatorRealization F n) (p : S.representation.IntertwiningMap Q.representation)
    (hp : Function.Surjective p) (hS : S.IsJointlyAdmissible) : Q.IsJointlyAdmissible :=
  Langlands.isJointlyAdmissible_of_surjective S.finiteRepresentation_isSmooth
    Q.finiteRepresentation_isSmooth
    (fun d k f => S.finiteRepresentation_compactRepresentation d k f)
    S.exists_compactStable_finiteDimensional
    S.continuous_dual_compactOrbit
    OperatorRealization.exists_compact_openSubgroup_le p.toLinearMap hp
    (fun d f => Representation.IntertwiningMap.isIntertwining _ _ p (finiteOperator F n d) f)
    (fun k f => Representation.IntertwiningMap.isIntertwining _ _ p (compactOperator F n k) f)
    hS

/-- The inclusion of a smaller operator realization into the numerator, followed by the
quotient map. -/
def generatedProjection (Q : OperatorSubquotient F n) (S : OperatorRealization F n)
    (h : S ≤ Q.upper) : S.representation.IntertwiningMap Q.representation :=
  Q.projection.comp
    { toLinearMap := Submodule.inclusion (fun _ hy => h hy)
      isIntertwining' := fun _ => LinearMap.ext fun _ => Subtype.ext rfl }

theorem generatedProjection_apply (Q : OperatorSubquotient F n) (S : OperatorRealization F n)
    (h : S ≤ Q.upper) (y : S.Space) :
    Q.generatedProjection S h y = Q.projection ⟨y.val, h y.property⟩ := rfl

set_option maxHeartbeats 800000 in
/-- **A cyclic vector.** An irreducible operator subquotient is the image of the
realization generated by a single automorphic form under a whole-operator intertwiner. -/
theorem exists_generatedForm_surjective (Q : OperatorSubquotient F n) (hQ : Q.IsIrreducible) :
    ∃ (f : AutomorphicForms F n)
      (p : (generatedFormOperatorRealization F n f).representation.IntertwiningMap
        Q.representation), Function.Surjective p := by
  have : Q.representation.IsIrreducible := hQ
  have hnt : Nontrivial Q.Space := by
    have : Nontrivial Q.representation.asModule :=
      IsSimpleModule.nontrivial (MonoidAlgebra ℂ (automorphicOperatorAlgebra F n))
        Q.representation.asModule
    exact Q.representation.asModuleEquiv.symm.toEquiv.nontrivial
  obtain ⟨w, hw⟩ := exists_ne (0 : Q.Space)
  obtain ⟨x, hxw⟩ := Q.projection_surjective w
  let f : AutomorphicForms F n := stableAutomorphicEquiv F n x.val
  have hfx : (stableAutomorphicEquiv F n).symm f = x.val :=
    (stableAutomorphicEquiv F n).symm_apply_apply x.val
  have hle : generatedFormOperatorRealization F n f ≤ Q.upper := by
    rw [generatedFormOperatorRealization_le_iff, Q.upper.mem_fullFormImage_iff, hfx]
    exact x.property
  have hxS : x.val ∈ generatedFormOperatorRealization F n f := by
    have h := mem_generatedOperatorRealization F n ((stableAutomorphicEquiv F n).symm f)
    rw [hfx] at h
    exact h
  refine ⟨f, Q.generatedProjection _ hle, ?_⟩
  rcases Representation.IsIrreducible.surjective_or_eq_zero (Q.generatedProjection _ hle) with
    hs | h0
  · exact hs
  · exfalso
    apply hw
    have hx0 : Q.generatedProjection _ hle ⟨x.val, hxS⟩ = 0 := by
      rw [h0]
      rfl
    rw [generatedProjection_apply] at hx0
    rw [← hxw]
    exact hx0

end OperatorSubquotient

/-- **Borel–Jacquet, §4.6, from Proposition 4.5.** If the realization generated by every
automorphic form is jointly admissible, then every irreducible operator subquotient is
jointly admissible. -/
theorem irreducibleSubquotientAdmissibility_of_generatedFormAdmissibility
    (h : GeneratedFormAdmissibilityStatement.{u}) :
    IrreducibleSubquotientAdmissibilityStatement.{u} := by
  intro F _ _ n Q hQ
  obtain ⟨f, p, hp⟩ := Q.exists_generatedForm_surjective hQ
  exact Q.isJointlyAdmissible_of_surjective _ p hp (h F n f)

end Automorphic

end Langlands
