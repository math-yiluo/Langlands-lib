import Langlands.Automorphic.CuspidalArchimedeanPlaceComponent
import Mathlib.RingTheory.SimpleModule.Isotypic

/-! # Isotypic place actions and scalar vectors

Abstract module theory for a vector space `V` with a representation `κ` of a group `K` and a
Lie algebra action `π`. `opAlg κ π` is the subalgebra of `End V` generated by all `κ k` and
`π X`; its submodules are the subspaces stable under `κ` and `π`.

* `isSemisimple_isotypic_of_commutant`: if `V` has an irreducible stable subspace `W₀` and every
  subspace that is stable under `κ`, `π` and every operator commuting with them is `⊥` or `⊤`,
  then `V` is a semisimple `opAlg κ π`-module, isotypic of the type of `W₀`.
* `isSimpleModule_of_scalar`: a semisimple isotypic module with a nonzero vector that every
  endomorphism maps to a multiple of itself is simple.

See the paired Markdown.
-/

noncomputable section

set_option autoImplicit false

namespace Langlands.Automorphic.PlaceIsotypic

attribute [local instance 100] LieRing.ofAssociativeRing

/-! ## Simplicity from a scalar vector -/

section Scalar

variable {R : Type*} [Ring R] [Algebra ℂ R] {M : Type*} [AddCommGroup M] [Module R M]
  [Module ℂ M] [IsScalarTower ℂ R M]

/-- A semisimple `R`-module, isotypic of a simple type `S`, is simple if it has a nonzero vector
`f₀` that every endomorphism maps to a multiple of itself. -/
theorem isSimpleModule_of_scalar [IsSemisimpleModule R M] {S : Type*} [AddCommGroup S]
    [Module R S] [IsSimpleModule R S] (hiso : IsIsotypicOfType R M S) {f₀ : M} (hf₀ : f₀ ≠ 0)
    (hscal : ∀ E : M →ₗ[R] M, ∃ a : ℂ, E f₀ = a • f₀) : IsSimpleModule R M := by
  classical
  obtain ⟨ι, ⟨e⟩⟩ := hiso.linearEquiv_finsupp
  have hφ : e f₀ ≠ 0 := fun h => hf₀ (e.injective (h.trans (map_zero e).symm))
  obtain ⟨i, hi⟩ : ∃ i, e f₀ i ≠ 0 := by
    by_contra h
    push Not at h
    exact hφ (Finsupp.ext h)
  have hsub : ∀ j, j = i := by
    intro j
    by_contra hji
    obtain ⟨a, ha⟩ := hscal (e.symm.toLinearMap ∘ₗ
      ((Finsupp.lsingle j : S →ₗ[R] ι →₀ S) ∘ₗ Finsupp.lapply i) ∘ₗ e.toLinearMap)
    have h1 : Finsupp.single j (e f₀ i) = (algebraMap ℂ R a) • e f₀ := by
      have h := congrArg e ha
      rw [← algebraMap_smul R a f₀, map_smul] at h
      simpa using h
    have hi0 : (algebraMap ℂ R a) • e f₀ i = 0 := by
      have h := congrArg (fun φ : ι →₀ S => φ i) h1
      simp only [Finsupp.coe_smul, Pi.smul_apply] at h
      rw [show (Finsupp.single j (e f₀ i)) i = 0 by simp [hji]] at h
      exact h.symm
    have hj0 : e f₀ i = (algebraMap ℂ R a) • e f₀ j := by
      have h := congrArg (fun φ : ι →₀ S => φ j) h1
      simpa only [Finsupp.single_eq_same, Finsupp.coe_smul, Pi.smul_apply] using h
    by_cases ha0 : a = 0
    · rw [ha0, map_zero, zero_smul] at hj0
      exact hi hj0
    · apply hi
      have h2 : e f₀ i = (algebraMap ℂ R a⁻¹) • ((algebraMap ℂ R a) • e f₀ i) := by
        rw [smul_smul, ← map_mul, inv_mul_cancel₀ ha0, map_one, one_smul]
      rw [h2, hi0, smul_zero]
  have : Subsingleton ι := ⟨fun j j' => (hsub j).trans (hsub j').symm⟩
  exact IsSimpleModule.congr (e.trans (Finsupp.uniqueLinearEquiv R S i))

end Scalar

/-! ## The operator algebra of a place action -/

section Operators

variable {K : Type*} [Group K] {𝔤 : Type*} [LieRing 𝔤] [LieAlgebra ℂ 𝔤]
  {V : Type*} [AddCommGroup V] [Module ℂ V]
  (κ : Representation ℂ K V) (π : 𝔤 →ₗ⁅ℂ⁆ Module.End ℂ V)

/-- The subalgebra of `End V` generated by all `κ k` and all `π X`. -/
abbrev opAlg : Subalgebra ℂ (Module.End ℂ V) :=
  Algebra.adjoin ℂ (Set.range (fun k : K => κ k) ∪ Set.range (fun X : 𝔤 => π X))

theorem compact_mem_opAlg (k : K) : κ k ∈ opAlg κ π :=
  Algebra.subset_adjoin (Or.inl ⟨k, rfl⟩)

theorem lie_mem_opAlg (X : 𝔤) : π X ∈ opAlg κ π :=
  Algebra.subset_adjoin (Or.inr ⟨X, rfl⟩)

variable {κ π}

/-- Every element of `opAlg κ π` preserves a stable subspace. -/
theorem apply_mem_of_isStable {Z : Submodule ℂ V} (hZ : PlaceComponent.IsStable κ π Z)
    {a : Module.End ℂ V} (ha : a ∈ opAlg κ π) {x : V} (hx : x ∈ Z) : a x ∈ Z := by
  induction ha using Algebra.adjoin_induction generalizing x with
  | mem a ha =>
    rcases ha with ⟨k, rfl⟩ | ⟨X, rfl⟩
    · exact hZ.1 k x hx
    · exact hZ.2 X x hx
  | algebraMap c =>
    rw [Module.algebraMap_end_apply]
    exact Z.smul_mem c hx
  | add a b _ _ iha ihb =>
    rw [LinearMap.add_apply]
    exact Z.add_mem (iha hx) (ihb hx)
  | mul a b _ _ iha ihb =>
    rw [Module.End.mul_apply]
    exact iha (ihb hx)

/-- A stable subspace as a submodule over `opAlg κ π`. -/
def toOpSubmodule (Z : Submodule ℂ V) (hZ : PlaceComponent.IsStable κ π Z) :
    Submodule (opAlg κ π) V where
  carrier := Z
  add_mem' := Z.add_mem
  zero_mem' := Z.zero_mem
  smul_mem' a _ hx := apply_mem_of_isStable hZ a.2 hx

theorem mem_toOpSubmodule {Z : Submodule ℂ V} (hZ : PlaceComponent.IsStable κ π Z) {x : V} :
    x ∈ toOpSubmodule Z hZ ↔ x ∈ Z :=
  Iff.rfl

/-- An `opAlg κ π`-submodule is a stable subspace. -/
theorem isStable_restrictScalars (N : Submodule (opAlg κ π) V) :
    PlaceComponent.IsStable κ π (N.restrictScalars ℂ) :=
  ⟨fun k _ hx => N.smul_mem ⟨κ k, compact_mem_opAlg κ π k⟩ hx,
    fun X _ hx => N.smul_mem ⟨π X, lie_mem_opAlg κ π X⟩ hx⟩

/-- A linear map commuting with `κ` and `π` commutes with every element of `opAlg κ π`. -/
theorem comm_of_mem_opAlg {P : V →ₗ[ℂ] V} (hκ : ∀ (k : K) (y : V), P (κ k y) = κ k (P y))
    (hπ : ∀ (X : 𝔤) (y : V), P (π X y) = π X (P y)) {a : Module.End ℂ V}
    (ha : a ∈ opAlg κ π) (y : V) : P (a y) = a (P y) := by
  induction ha using Algebra.adjoin_induction generalizing y with
  | mem a ha =>
    rcases ha with ⟨k, rfl⟩ | ⟨X, rfl⟩
    · exact hκ k y
    · exact hπ X y
  | algebraMap c =>
    rw [Module.algebraMap_end_apply, Module.algebraMap_end_apply, map_smul]
  | add a b _ _ iha ihb =>
    rw [LinearMap.add_apply, map_add, iha, ihb, LinearMap.add_apply]
  | mul a b _ _ iha ihb =>
    rw [Module.End.mul_apply, iha, ihb, Module.End.mul_apply]

/-- A linear map commuting with `κ` and `π` as an `opAlg κ π`-linear map. -/
def toOpLinear (P : V →ₗ[ℂ] V) (hκ : ∀ (k : K) (y : V), P (κ k y) = κ k (P y))
    (hπ : ∀ (X : 𝔤) (y : V), P (π X y) = π X (P y)) : V →ₗ[opAlg κ π] V where
  toFun := P
  map_add' := P.map_add
  map_smul' a y := comm_of_mem_opAlg hκ hπ a.2 y

/-- An irreducible stable subspace is a simple `opAlg κ π`-module. -/
theorem isSimpleModule_toOpSubmodule {W : Submodule ℂ V}
    (hW : PlaceComponent.IsIrreducible κ π W) :
    IsSimpleModule (opAlg κ π) (toOpSubmodule W hW.2.1) := by
  rw [isSimpleModule_iff_isAtom]
  refine ⟨fun h => hW.1 ?_, fun N hN => ?_⟩
  · rw [eq_bot_iff]
    intro x hx
    have : x ∈ toOpSubmodule W hW.2.1 := hx
    rw [h] at this
    exact this
  · rcases hW.2.2 (N.restrictScalars ℂ) (fun x hx => hN.le hx) (isStable_restrictScalars N)
      with h | h
    · rw [eq_bot_iff]
      intro x hx
      have : x ∈ N.restrictScalars ℂ := hx
      rw [h] at this
      exact this
    · exfalso
      apply hN.ne
      ext x
      constructor
      · exact fun hx => hN.le hx
      · intro hx
        have : x ∈ N.restrictScalars ℂ := by rw [h]; exact hx
        exact this

/-- **Semisimplicity and isotypy.** If `W₀` is an irreducible stable subspace and every subspace
stable under `κ`, `π` and the operators commuting with them is `⊥` or `⊤`, then `V` is a
semisimple `opAlg κ π`-module, isotypic of the type of `W₀`. -/
theorem isSemisimple_isotypic_of_commutant {W₀ : Submodule ℂ V}
    (hW₀ : PlaceComponent.IsIrreducible κ π W₀)
    (hcomm : ∀ Z : Submodule ℂ V,
      (∀ P : V →ₗ[ℂ] V, (∀ (k : K) (y : V), P (κ k y) = κ k (P y)) →
        (∀ (X : 𝔤) (y : V), P (π X y) = π X (P y)) → ∀ x ∈ Z, P x ∈ Z) →
      PlaceComponent.IsStable κ π Z → Z = ⊥ ∨ Z = ⊤) :
    IsSemisimpleModule (opAlg κ π) V ∧
      IsIsotypicOfType (opAlg κ π) V (toOpSubmodule W₀ hW₀.2.1) := by
  have := isSimpleModule_toOpSubmodule hW₀
  set C := isotypicComponent (opAlg κ π) V (toOpSubmodule W₀ hW₀.2.1)
  have hC : C = ⊤ := by
    have hZ := hcomm (C.restrictScalars ℂ)
      (fun P hκ hπ x hx => by
        have h := LinearMap.le_comap_isotypicComponent (R := opAlg κ π) (M := V) (N := V)
          (toOpSubmodule W₀ hW₀.2.1) (toOpLinear P hκ hπ) (show x ∈ C from hx)
        exact h)
      (isStable_restrictScalars C)
    rcases hZ with h | h
    · exfalso
      apply hW₀.1
      rw [eq_bot_iff]
      intro x hx
      have hxC : x ∈ C := (toOpSubmodule W₀ hW₀.2.1).le_isotypicComponent hx
      have : x ∈ C.restrictScalars ℂ := hxC
      rw [h] at this
      exact this
    · rw [eq_top_iff]
      intro x _
      have : x ∈ C.restrictScalars ℂ := by rw [h]; exact Submodule.mem_top
      exact this
  have hsemiC : IsSemisimpleModule (opAlg κ π) C := inferInstance
  refine ⟨isSemisimpleModule_of_isSemisimpleModule_submodule' (p := fun _ : Unit => C)
    (fun _ => hsemiC) ?_, IsIsotypicOfType.of_isotypicComponent_eq_top hC⟩
  rw [iSup_const, hC]

end Operators

end Langlands.Automorphic.PlaceIsotypic
