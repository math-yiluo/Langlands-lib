import Langlands.HarmonicAnalysis.TorusFourierDecay
import Mathlib.Analysis.Normed.Group.FunctionSeries
import Mathlib.Analysis.PSeries
import Mathlib.MeasureTheory.Integral.DominatedConvergence
import Mathlib.Topology.ContinuousMap.StoneWeierstrass

/-! # Fourier inversion on a finite product of circles

For a finite invariant measure `μ` on the torus `T = J → Circle` (`J` finite) and a continuous
`f : T → ℂ` whose Fourier coefficients `f̂(n) = ∫ f(z) ∏ⱼ zⱼ^{nⱼ} dμ(z)` are absolutely summable,
`μ(T) f(z) = ∑ₙ f̂(n) conj(χₙ(z))`, where `χₙ(z) = ∏ⱼ zⱼ^{nⱼ}`. Smooth functions have summable
coefficients. For a finite subgroup `K` of `T`, the partial sum over the `n` with `χₙ` trivial
on `K` is `μ(T) |K|⁻¹ ∑_{w ∈ K} f(z w)`.

This is the Fourier inversion used in the proof of Proposition VII.2.1 of Waldspurger's
*La formule de Plancherel pour les groupes p-adiques*, written in torus coordinates.
-/

noncomputable section

open MeasureTheory Complex Set Submodule Algebra
open Langlands.Plancherel (IsSmoothFiniteTorusFunction)
open scoped ComplexConjugate

namespace Langlands.HarmonicAnalysis.TorusFourier

variable {J : Type*} [Fintype J]

section Characters

theorem torusCharacter_zero (z : J → Circle) : torusCharacter 0 z = 1 := by
  simp [torusCharacter]

theorem torusCharacter_add (m n : J → ℤ) (z : J → Circle) :
    torusCharacter (m + n) z = torusCharacter m z * torusCharacter n z := by
  simp only [torusCharacter, Pi.add_apply, zpow_add, Circle.coe_mul, Finset.prod_mul_distrib]

theorem torusCharacter_neg (n : J → ℤ) (z : J → Circle) :
    torusCharacter (-n) z = conj (torusCharacter n z) := by
  rw [torusCharacter, torusCharacter, map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [Pi.neg_apply, zpow_neg, Circle.coe_inv_eq_conj]

theorem torusCharacter_inv (n : J → ℤ) (z : J → Circle) :
    torusCharacter n z⁻¹ = conj (torusCharacter n z) := by
  rw [torusCharacter, torusCharacter, map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [Pi.inv_apply, inv_zpow, Circle.coe_inv_eq_conj]

theorem torusCharacter_single [DecidableEq J] (i : J) (z : J → Circle) :
    torusCharacter (Pi.single i 1) z = z i := by
  rw [torusCharacter, Finset.prod_eq_single i]
  · simp
  · intro j _ hji
    simp [Pi.single_eq_of_ne hji]
  · intro h
    exact absurd (Finset.mem_univ i) h

/-- The character `χₙ` as a continuous function. -/
def torusCharacterMap (n : J → ℤ) : C(J → Circle, ℂ) :=
  ⟨torusCharacter n, continuous_torusCharacter n⟩

@[simp]
theorem torusCharacterMap_apply (n : J → ℤ) (z : J → Circle) :
    torusCharacterMap n z = torusCharacter n z :=
  rfl

variable (J) in
/-- The star subalgebra of `C(J → Circle, ℂ)` generated by the characters `χₙ`. -/
def torusCharacterSubalgebra : StarSubalgebra ℂ C(J → Circle, ℂ) where
  toSubalgebra := Algebra.adjoin ℂ (range torusCharacterMap)
  star_mem' := by
    change Algebra.adjoin ℂ (range torusCharacterMap) ≤
      star (Algebra.adjoin ℂ (range torusCharacterMap))
    refine adjoin_le ?_
    rintro _ ⟨n, rfl⟩
    refine subset_adjoin ⟨-n, ?_⟩
    ext1 z
    simp only [torusCharacterMap_apply, torusCharacter_neg, starRingEnd_apply,
      ContinuousMap.star_apply]

/-- The algebra generated by the characters is their linear span. -/
theorem torusCharacterSubalgebra_coe :
    (torusCharacterSubalgebra J).toSubalgebra.toSubmodule = span ℂ (range torusCharacterMap) := by
  apply adjoin_eq_span_of_subset
  refine .trans (fun x ↦ Submonoid.closure_induction (fun _ ↦ id) ⟨0, ?_⟩ ?_) subset_span
  · ext z
    simp [torusCharacter_zero]
  · rintro _ _ _ _ ⟨m, rfl⟩ ⟨n, rfl⟩
    refine ⟨m + n, ?_⟩
    ext z
    simp only [torusCharacterMap_apply, torusCharacter_add, ContinuousMap.mul_apply]

theorem torusCharacterSubalgebra_separatesPoints :
    (torusCharacterSubalgebra J).SeparatesPoints := by
  classical
  intro x y hxy
  rw [Ne, funext_iff, not_forall] at hxy
  obtain ⟨i, hi⟩ := hxy
  refine ⟨_, ⟨torusCharacterMap (Pi.single i 1), subset_adjoin ⟨Pi.single i 1, rfl⟩, rfl⟩, ?_⟩
  dsimp only
  rw [torusCharacterMap_apply, torusCharacterMap_apply, torusCharacter_single,
    torusCharacter_single, Ne, Circle.coe_inj]
  exact hi

/-- **Density of trigonometric polynomials** (Stone–Weierstrass): the linear span of the
characters `χₙ` is dense in `C(J → Circle, ℂ)`. -/
theorem span_torusCharacterMap_closure_eq_top :
    (span ℂ (range (torusCharacterMap (J := J)))).topologicalClosure = ⊤ := by
  rw [← torusCharacterSubalgebra_coe]
  exact congr_arg (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
      torusCharacterSubalgebra_separatesPoints)

end Characters

section Inversion

variable (μ : Measure (J → Circle)) [IsFiniteMeasure μ]

omit [IsFiniteMeasure μ] in
theorem integrable_mul_torusCharacter [IsFiniteMeasure μ] {f : (J → Circle) → ℂ}
    (hf : Continuous f) (n : J → ℤ) : Integrable (fun z => f z * torusCharacter n z) μ := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
  refine Integrable.of_bound (hf.mul (continuous_torusCharacter n)).aestronglyMeasurable C
    (ae_of_all _ fun z => ?_)
  rw [norm_mul, norm_torusCharacter, mul_one]
  exact hC z (mem_univ z)

omit [IsFiniteMeasure μ] in
/-- **Orthogonality**: `∫ χₙ dμ = μ(T)` if `n = 0` and `0` otherwise. -/
theorem integral_torusCharacter [μ.IsMulLeftInvariant] (n : J → ℤ) :
    ∫ z, torusCharacter n z ∂μ = if n = 0 then (μ.real univ : ℂ) else 0 := by
  classical
  split_ifs with hn
  · subst hn
    simp [torusCharacter_zero]
  · obtain ⟨j, hj⟩ : ∃ j, n j ≠ 0 := by
      by_contra h
      exact hn (funext fun j => not_not.mp fun hj => h ⟨j, hj⟩)
    have hnj : (n j : ℝ) ≠ 0 := by exact_mod_cast hj
    have h := integral_translate_mul_torusCharacter μ (fun _ => (1 : ℂ)) n j (Real.pi / n j)
    simp only [one_mul] at h
    have hc : torusFourierCoeff μ (fun _ => (1 : ℂ)) n = ∫ z, torusCharacter n z ∂μ := by
      simp [torusFourierCoeff]
    have harg : (n j : ℝ) * -(Real.pi / n j) = -Real.pi := by
      field_simp
    rw [hc, harg, Complex.ofReal_neg, neg_mul, Complex.exp_neg, Complex.exp_pi_mul_I] at h
    norm_num at h
    linear_combination h / 2

/-- The Fourier coefficients of `z ↦ ∑ₘ c(m) conj(χₘ(z))` for absolutely summable `c` are
`μ(T) c(n)`. -/
theorem torusFourierCoeff_tsum [μ.IsMulLeftInvariant] {c : (J → ℤ) → ℂ}
    (hc : Summable fun m => ‖c m‖) (n : J → ℤ) :
    torusFourierCoeff μ (fun z => ∑' m, c m * conj (torusCharacter m z)) n =
      μ.real univ * c n := by
  classical
  unfold torusFourierCoeff
  have hpt : ∀ m z, c m * conj (torusCharacter m z) * torusCharacter n z =
      c m * torusCharacter (n - m) z := by
    intro m z
    rw [sub_eq_add_neg, torusCharacter_add, torusCharacter_neg]
    ring
  have hF : ∀ m, Integrable (fun z => c m * conj (torusCharacter m z) * torusCharacter n z) μ := by
    intro m
    simp_rw [hpt]
    exact (integrable_mul_torusCharacter μ continuous_const (n - m))
  have hnorm : ∀ m, ∫ z, ‖c m * conj (torusCharacter m z) * torusCharacter n z‖ ∂μ =
      ‖c m‖ * μ.real univ := by
    intro m
    simp only [norm_mul, RCLike.norm_conj, norm_torusCharacter, mul_one, integral_const,
      smul_eq_mul]
    ring
  have hsum : Summable fun m => ∫ z, ‖c m * conj (torusCharacter m z) * torusCharacter n z‖ ∂μ := by
    simp_rw [hnorm]
    exact hc.mul_right _
  calc ∫ z, (∑' m, c m * conj (torusCharacter m z)) * torusCharacter n z ∂μ
      = ∫ z, ∑' m, c m * conj (torusCharacter m z) * torusCharacter n z ∂μ := by
        congr 1
        funext z
        rw [tsum_mul_right]
    _ = ∑' m, ∫ z, c m * conj (torusCharacter m z) * torusCharacter n z ∂μ :=
        (integral_tsum_of_summable_integral_norm hF hsum).symm
    _ = ∑' m, if m = n then c m * μ.real univ else 0 := by
        congr 1
        funext m
        simp_rw [hpt]
        rw [integral_const_mul, integral_torusCharacter]
        by_cases hmn : m = n
        · subst hmn
          simp
        · simp [sub_eq_zero, hmn, Ne.symm hmn]
    _ = μ.real univ * c n := by
        rw [tsum_ite_eq]
        ring

omit [IsFiniteMeasure μ] in
/-- **Uniqueness**: a continuous function all of whose Fourier coefficients vanish is zero,
for a finite measure positive on open sets. -/
theorem eq_zero_of_torusFourierCoeff_eq_zero [IsFiniteMeasure μ] [μ.IsOpenPosMeasure]
    {h : (J → Circle) → ℂ} (hh : Continuous h) (h0 : ∀ n, torusFourierCoeff μ h n = 0) :
    h = 0 := by
  set H : C(J → Circle, ℂ) := ⟨h, hh⟩
  have hint : ∀ p : C(J → Circle, ℂ), Integrable (fun z => h z * p z) μ := fun p =>
    Integrable.of_bound (hh.mul p.continuous).aestronglyMeasurable (‖H‖ * ‖p‖)
      (ae_of_all _ fun z => by
        rw [norm_mul]
        exact mul_le_mul (H.norm_coe_le_norm z) (p.norm_coe_le_norm z) (norm_nonneg _)
          (norm_nonneg _))
  let L : C(J → Circle, ℂ) →ₗ[ℂ] ℂ :=
    { toFun := fun p => ∫ z, h z * p z ∂μ
      map_add' := fun p q => by
        simp only [ContinuousMap.add_apply, mul_add]
        exact integral_add (hint p) (hint q)
      map_smul' := fun c p => by
        simp only [ContinuousMap.smul_apply, smul_eq_mul, RingHom.id_apply]
        rw [← integral_const_mul]
        congr 1
        funext z
        ring }
  let Lc : C(J → Circle, ℂ) →L[ℂ] ℂ := L.mkContinuous (‖H‖ * μ.real univ) fun p => by
    calc ‖L p‖ ≤ (‖H‖ * ‖p‖) * μ.real univ :=
          norm_integral_le_of_norm_le_const (ae_of_all _ fun z => by
            rw [norm_mul]
            exact mul_le_mul (H.norm_coe_le_norm z) (p.norm_coe_le_norm z) (norm_nonneg _)
              (norm_nonneg _))
      _ = ‖H‖ * μ.real univ * ‖p‖ := by ring
  have hspan : span ℂ (range (torusCharacterMap (J := J))) ≤ LinearMap.ker (Lc : _ →ₗ[ℂ] ℂ) := by
    rw [Submodule.span_le]
    rintro _ ⟨n, rfl⟩
    exact h0 n
  have hker := Submodule.topologicalClosure_minimal _ hspan Lc.isClosed_ker
  rw [span_torusCharacterMap_closure_eq_top] at hker
  have hstar : Lc (star H) = 0 := hker Submodule.mem_top
  have hsq : ∫ z, ‖h z‖ ^ 2 ∂μ = 0 := by
    have heq : Lc (star H) = ((∫ z, ‖h z‖ ^ 2 ∂μ : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      change ∫ z, h z * star (h z) ∂μ = _
      congr 1
      funext z
      rw [← starRingEnd_apply, Complex.mul_conj', Complex.ofReal_pow]
    rw [heq] at hstar
    exact_mod_cast hstar
  have hint2 : Integrable (fun z => ‖h z‖ ^ 2) μ := by
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hh.continuousOn
    refine Integrable.of_bound (hh.norm.pow 2).aestronglyMeasurable (C ^ 2)
      (ae_of_all _ fun z => ?_)
    rw [Real.norm_of_nonneg (by positivity)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hC z (mem_univ z)) 2
  have hae : (fun z => ‖h z‖ ^ 2) =ᵐ[μ] 0 :=
    (integral_eq_zero_iff_of_nonneg (fun z => by positivity) hint2).mp hsq
  have hae' : h =ᵐ[μ] fun _ => 0 := hae.mono fun z hz => by
    simpa using hz
  exact (hh.ae_eq_iff_eq μ continuous_const).mp hae'

/-- **Fourier inversion on the torus**: if `f` is continuous with absolutely summable Fourier
coefficients, then `∑ₙ f̂(n) conj(χₙ(z)) = μ(T) f(z)` for every `z`. -/
theorem hasSum_torusFourierCoeff_mul_conj [μ.IsMulLeftInvariant] {f : (J → Circle) → ℂ}
    (hf : Continuous f) (hs : Summable fun n => ‖torusFourierCoeff μ f n‖) (z : J → Circle) :
    HasSum (fun n => torusFourierCoeff μ f n * conj (torusCharacter n z))
      ((μ.real univ : ℂ) * f z) := by
  have hbound : ∀ n w, ‖torusFourierCoeff μ f n * conj (torusCharacter n w)‖ ≤
      ‖torusFourierCoeff μ f n‖ := fun n w => by
    rw [norm_mul, RCLike.norm_conj, norm_torusCharacter, mul_one]
  refine (Summable.of_norm_bounded hs (hbound · z)).hasSum_iff.mpr ?_
  by_cases hμ : μ = 0
  · subst hμ
    simp [torusFourierCoeff]
  have hpos : μ univ ≠ 0 := by
    rwa [Ne, Measure.measure_univ_eq_zero]
  have : μ.IsOpenPosMeasure := isOpenPosMeasure_of_mulLeftInvariant_of_compact univ
    isCompact_univ hpos
  set g : (J → Circle) → ℂ := fun w => ∑' n, torusFourierCoeff μ f n * conj (torusCharacter n w)
  have hg : Continuous g :=
    continuous_tsum (fun n => continuous_const.mul
      (Complex.continuous_conj.comp (continuous_torusCharacter n))) hs hbound
  have hdiff : (fun w => (μ.real univ : ℂ) * f w - g w) = 0 := by
    refine eq_zero_of_torusFourierCoeff_eq_zero μ (continuous_const.mul hf |>.sub hg) fun n => ?_
    have hgc : ∫ w, g w * torusCharacter n w ∂μ =
        (μ.real univ : ℂ) * ∫ w, f w * torusCharacter n w ∂μ :=
      torusFourierCoeff_tsum μ hs n
    have h1 : ∫ w, (μ.real univ : ℂ) * f w * torusCharacter n w ∂μ =
        (μ.real univ : ℂ) * ∫ w, f w * torusCharacter n w ∂μ := by
      simp_rw [mul_assoc]
      exact integral_const_mul _ _
    unfold torusFourierCoeff
    simp_rw [sub_mul]
    have i1 : Integrable (fun w => (μ.real univ : ℂ) * f w * torusCharacter n w) μ :=
      integrable_mul_torusCharacter μ (continuous_const.mul hf) n
    rw [integral_sub i1 (integrable_mul_torusCharacter μ hg n), h1, hgc, sub_self]
  have hz := congrFun hdiff z
  simp only [Pi.zero_apply] at hz
  linear_combination -hz

/-- Fourier inversion for a probability measure: `∑ₙ f̂(n) conj(χₙ(z)) = f(z)`. -/
theorem hasSum_torusFourierCoeff_mul_conj_of_isProbabilityMeasure [IsProbabilityMeasure μ]
    [μ.IsMulLeftInvariant] {f : (J → Circle) → ℂ} (hf : Continuous f)
    (hs : Summable fun n => ‖torusFourierCoeff μ f n‖) (z : J → Circle) :
    HasSum (fun n => torusFourierCoeff μ f n * conj (torusCharacter n z)) (f z) := by
  simpa using hasSum_torusFourierCoeff_mul_conj μ hf hs z

end Inversion

section Summability

/-- The one-variable series `∑_{k ∈ ℤ} (1 + |k|)^{-2}` converges. -/
theorem summable_one_add_abs_sq_inv : Summable fun k : ℤ => ((1 + |(k : ℝ)|) ^ 2)⁻¹ := by
  classical
  refine Summable.of_nonneg_of_le (fun k => by positivity) (fun k => ?_)
    ((Real.summable_one_div_int_pow.mpr one_lt_two).add (hasSum_ite_eq (0 : ℤ) (1 : ℝ)).summable)
  by_cases hk : k = 0
  · subst hk
    simp
  · have hk' : (0 : ℝ) < (k : ℝ) ^ 2 := by
      have : (k : ℝ) ≠ 0 := by exact_mod_cast hk
      positivity
    simp only [hk, ↓reduceIte, add_zero, one_div]
    refine inv_anti₀ hk' ?_
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (by linarith) 2

/-- The series `∑_{n ∈ ℤ^J} ∏ⱼ (1 + |nⱼ|)^{-2}` converges. -/
theorem summable_prod_one_add_abs_sq_inv :
    Summable fun n : J → ℤ => ∏ j, ((1 + |(n j : ℝ)|) ^ 2)⁻¹ := by
  classical
  set g : ℤ → ℝ := fun k => ((1 + |(k : ℝ)|) ^ 2)⁻¹
  have hg0 : ∀ k, 0 ≤ g k := fun k => by positivity
  refine summable_of_sum_le (c := ∏ _j : J, ∑' k, g k)
    (fun n => Finset.prod_nonneg fun j _ => hg0 _) fun S => ?_
  calc ∑ n ∈ S, ∏ j, g (n j)
      ≤ ∑ n ∈ Fintype.piFinset (fun j => S.image (· j)), ∏ j, g (n j) :=
        Finset.sum_le_sum_of_subset_of_nonneg
          (fun n hn => Fintype.mem_piFinset.mpr fun j => Finset.mem_image_of_mem _ hn)
          (fun n _ _ => Finset.prod_nonneg fun j _ => hg0 _)
    _ = ∏ j, ∑ k ∈ S.image (· j), g k := (Finset.prod_univ_sum _ _).symm
    _ ≤ ∏ _j : J, ∑' k, g k :=
        Finset.prod_le_prod₀ (fun j _ => Finset.sum_nonneg fun k _ => hg0 k)
          (fun j _ => Summable.sum_le_tsum _ (fun k _ => hg0 k) summable_one_add_abs_sq_inv)

variable [DecidableEq J] (μ : Measure (J → Circle)) [IsFiniteMeasure μ] [μ.IsMulLeftInvariant]

/-- The Fourier coefficients of a smooth function on the torus are absolutely summable. -/
theorem summable_norm_torusFourierCoeff {f : (J → Circle) → ℂ}
    (hf : IsSmoothFiniteTorusFunction f) : Summable fun n => ‖torusFourierCoeff μ f n‖ := by
  set k := 2 * Fintype.card J
  obtain ⟨M₀, hM₀⟩ := exists_norm_le_of_isSmooth hf
  choose Mj hMj using fun j =>
    exists_norm_le_of_isSmooth (isSmoothFiniteTorusFunction_iterate_torusPartialDeriv hf j k)
  set M := |M₀| + ∑ j, |Mj j|
  have hsumj : ∀ j, |Mj j| ≤ ∑ i, |Mj i| := fun j =>
    Finset.single_le_sum (f := fun i => |Mj i|) (fun i _ => abs_nonneg _) (Finset.mem_univ j)
  have hM0 : ∀ z, ‖f z‖ ≤ M := fun z =>
    (hM₀ z).trans ((le_abs_self _).trans (le_add_of_nonneg_right
      (Finset.sum_nonneg fun i _ => abs_nonneg _)))
  have hM : ∀ j z, ‖(torusPartialDeriv j)^[k] f z‖ ≤ M := fun j z =>
    (hMj j z).trans ((le_abs_self _).trans ((hsumj j).trans
      (le_add_of_nonneg_left (abs_nonneg _))))
  set C := 2 ^ k * (1 + Fintype.card J) * (M * μ.real univ)
  refine Summable.of_nonneg_of_le (fun n => norm_nonneg _) (fun n => ?_)
    (summable_prod_one_add_abs_sq_inv.mul_left C)
  have hb := one_add_norm_pow_mul_norm_torusFourierCoeff_le μ hf k hM0 hM n
  have hpos : 0 < (1 + ‖n‖) ^ k := by positivity
  have hprodpos : 0 < ∏ j, (1 + |(n j : ℝ)|) ^ 2 := Finset.prod_pos fun j _ => by positivity
  have hprod : ∏ j, (1 + |(n j : ℝ)|) ^ 2 ≤ (1 + ‖n‖) ^ k := by
    have hk : (1 + ‖n‖) ^ k = ∏ _j : J, (1 + ‖n‖) ^ 2 := by
      show (1 + ‖n‖) ^ (2 * Fintype.card J) = _
      rw [Finset.prod_const, Finset.card_univ, ← pow_mul]
    rw [hk]
    refine Finset.prod_le_prod₀ (fun j _ => by positivity) fun j _ => ?_
    refine pow_le_pow_left₀ (by positivity) ?_ 2
    have h := norm_le_pi_norm n j
    rw [Int.norm_eq_abs] at h
    linarith
  have hC : 0 ≤ C := (mul_nonneg hpos.le (norm_nonneg _)).trans hb
  calc ‖torusFourierCoeff μ f n‖
      = (1 + ‖n‖) ^ k * ‖torusFourierCoeff μ f n‖ / (1 + ‖n‖) ^ k := by
        field_simp
    _ ≤ C / (1 + ‖n‖) ^ k := div_le_div_of_nonneg_right hb hpos.le
    _ ≤ C / ∏ j, (1 + |(n j : ℝ)|) ^ 2 := div_le_div_of_nonneg_left hC hprodpos hprod
    _ = C * ∏ j, ((1 + |(n j : ℝ)|) ^ 2)⁻¹ := by
        rw [div_eq_mul_inv, Finset.prod_inv_distrib]

/-- **Fourier inversion for smooth functions on the torus**:
`∑ₙ f̂(n) conj(χₙ(z)) = μ(T) f(z)`. -/
theorem hasSum_torusFourierCoeff_mul_conj_of_isSmooth {f : (J → Circle) → ℂ}
    (hf : IsSmoothFiniteTorusFunction f) (z : J → Circle) :
    HasSum (fun n => torusFourierCoeff μ f n * conj (torusCharacter n z))
      ((μ.real univ : ℂ) * f z) :=
  hasSum_torusFourierCoeff_mul_conj μ hf.continuous (summable_norm_torusFourierCoeff μ hf) z

end Summability

section FiniteSubgroup

/-- `χₙ` is trivial on the subgroup `K`. -/
def IsTrivialOn (K : Subgroup (J → Circle)) (n : J → ℤ) : Prop :=
  ∀ w : K, torusCharacter n w = 1

variable (μ : Measure (J → Circle)) [IsFiniteMeasure μ] [μ.IsMulLeftInvariant]
  (K : Subgroup (J → Circle)) [Fintype K]

omit [Fintype K] in
theorem torusCharacter_mul_mem (n : J → ℤ) (w₁ w₂ : K) :
    torusCharacter n ((w₁ * w₂ : K) : J → Circle) = torusCharacter n w₁ * torusCharacter n w₂ := by
  rw [Subgroup.coe_mul, torusCharacter_mul]

/-- **Orthogonality on a finite subgroup**: `∑_{w ∈ K} χₙ(w) = |K|` if `χₙ` is trivial on `K`,
and `0` otherwise. -/
theorem sum_torusCharacter_subgroup (n : J → ℤ) [Decidable (IsTrivialOn K n)] :
    ∑ w : K, torusCharacter n w = if IsTrivialOn K n then (Fintype.card K : ℂ) else 0 := by
  split_ifs with hn
  · have h1 : ∀ w : K, torusCharacter n w = 1 := hn
    simp [h1]
  · obtain ⟨w₀, hw₀⟩ : ∃ w₀ : K, torusCharacter n w₀ ≠ 1 := by
      by_contra h
      exact hn fun w => not_not.mp fun hw => h ⟨w, hw⟩
    have hshift : torusCharacter n w₀ * ∑ w : K, torusCharacter n w =
        ∑ w : K, torusCharacter n w := by
      rw [Finset.mul_sum]
      simp_rw [← torusCharacter_mul_mem]
      exact Fintype.sum_equiv (Equiv.mulLeft w₀) _ _ fun w => rfl
    have h1 : (1 - torusCharacter n w₀) * ∑ w : K, torusCharacter n w = 0 := by
      rw [sub_mul, one_mul, hshift, sub_self]
    exact (mul_eq_zero.mp h1).resolve_left (sub_ne_zero.mpr hw₀.symm)

omit [IsFiniteMeasure μ] [Fintype K] in
/-- Translating by `w` multiplies the Fourier coefficient at `n` by `conj(χₙ(w))`. -/
theorem integral_mul_right_mul_torusCharacter (f : (J → Circle) → ℂ) (n : J → ℤ)
    (w : J → Circle) :
    ∫ z, f (z * w) * torusCharacter n z ∂μ = torusFourierCoeff μ f n * conj (torusCharacter n w) := by
  have hpt : ∀ z, f (z * w) * torusCharacter n z =
      f (z * w) * torusCharacter n (z * w) * conj (torusCharacter n w) := by
    intro z
    rw [← torusCharacter_inv, mul_assoc, ← torusCharacter_mul, mul_inv_cancel_right]
  simp_rw [hpt]
  rw [integral_mul_const, integral_mul_right_eq_self (fun z => f z * torusCharacter n z) w]
  rfl

/-- **Fourier inversion along a finite subgroup**: for `f` continuous with absolutely summable
Fourier coefficients and `K` a finite subgroup of the torus, the sum of `f̂(n) conj(χₙ(z))` over
the `n` with `χₙ` trivial on `K` is `μ(T) |K|⁻¹ ∑_{w ∈ K} f(z w)`. -/
theorem hasSum_torusFourierCoeff_mul_conj_isTrivialOn [DecidablePred (IsTrivialOn K)]
    {f : (J → Circle) → ℂ} (hf : Continuous f)
    (hs : Summable fun n => ‖torusFourierCoeff μ f n‖) (z : J → Circle) :
    HasSum (fun n => if IsTrivialOn K n then torusFourierCoeff μ f n * conj (torusCharacter n z)
        else 0)
      ((μ.real univ : ℂ) / Fintype.card K * ∑ w : K, f (z * w)) := by
  set F : (J → Circle) → ℂ := fun x => ∑ w : K, f (x * w)
  have hF : Continuous F :=
    continuous_finsetSum _ fun w _ => hf.comp (continuous_id.mul continuous_const)
  have hcoeff : ∀ n, torusFourierCoeff μ F n =
      (if IsTrivialOn K n then (Fintype.card K : ℂ) else 0) * torusFourierCoeff μ f n := by
    intro n
    unfold torusFourierCoeff
    simp only [F, Finset.sum_mul]
    rw [integral_finsetSum _ fun w _ => by
      simpa using integrable_mul_torusCharacter μ (hf.comp (continuous_id.mul continuous_const)) n]
    simp_rw [integral_mul_right_mul_torusCharacter μ f n, ← Finset.mul_sum, ← map_sum,
      sum_torusCharacter_subgroup K n]
    unfold torusFourierCoeff
    split_ifs <;> simp [mul_comm]
  have hFs : Summable fun n => ‖torusFourierCoeff μ F n‖ := by
    refine Summable.of_nonneg_of_le (fun n => norm_nonneg _) (fun n => ?_)
      (hs.mul_left (Fintype.card K : ℝ))
    rw [hcoeff, norm_mul]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    split_ifs <;> simp
  have hinv := hasSum_torusFourierCoeff_mul_conj μ hF hFs z
  have hcard : (Fintype.card K : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have h2 := hinv.mul_left (Fintype.card K : ℂ)⁻¹
  convert h2 using 1
  · funext n
    rw [hcoeff]
    split_ifs
    · field_simp
    · simp
  · simp only [F]
    field_simp

end FiniteSubgroup

end Langlands.HarmonicAnalysis.TorusFourier
