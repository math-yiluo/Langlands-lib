import Langlands.HarmonicAnalysis.Distribution.Basic
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Topology.Algebra.Group.ClosedSubgroup

/-! # Lattice-invariant Schwartz–Bruhat tests and coset indicators -/

noncomputable section

namespace Langlands.HarmonicAnalysis

open Classical Function Filter Set _root_.Topology
open Hecke.TestFunction (characteristic characteristic_apply)

variable {A : Type*} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]

/-- The subspace of tests invariant under translations by `L`. -/
def latticeInvariantTests (L : AddSubgroup A) : Submodule ℂ (SchwartzBruhat A) where
  carrier := {f | ∀ t ∈ L, ∀ x, f (x + t) = f x}
  zero_mem' := by intro t ht x; rfl
  add_mem' := by intro f g hf hg t ht x; simp only [Submodule.coe_add, Pi.add_apply, hf t ht x, hg t ht x]
  smul_mem' := by intro c f hf t ht x; simp only [Submodule.coe_smul, Pi.smul_apply, hf t ht x]

variable (L : AddSubgroup A) (hLo : IsOpen (L : Set A)) (hLc : IsCompact (L : Set A))

include hLo in
private theorem coset_clopen (x : A) : IsClopen (Homeomorph.addLeft x '' (L : Set A)) :=
  ⟨(Homeomorph.addLeft x).isClosedMap _ (L.isClosed_of_isOpen hLo),
    (Homeomorph.addLeft x).isOpenMap _ hLo⟩

/-- The characteristic test of the additive coset `x + L`. -/
def latticeCosetTest (x : A) : SchwartzBruhat A :=
  characteristic (coset_clopen L hLo x) (hLc.image (Homeomorph.addLeft x).continuous)

private theorem eq_quotient_iff_mem_coset (x y : A) :
    QuotientAddGroup.mk' L y = QuotientAddGroup.mk' L x ↔ y ∈ Homeomorph.addLeft x '' (L : Set A) := by
  rw [eq_comm, QuotientAddGroup.mk'_eq_mk']
  rfl

theorem latticeCosetTest_apply (x y : A) :
    latticeCosetTest L hLo hLc x y = if QuotientAddGroup.mk' L y = QuotientAddGroup.mk' L x then 1 else 0 := by
  classical
  by_cases h : QuotientAddGroup.mk' L y = QuotientAddGroup.mk' L x
  · rw [ite_eq_left h, latticeCosetTest, characteristic_apply,
      indicator_of_mem ((eq_quotient_iff_mem_coset L x y).1 h)]
  · rw [ite_eq_right h, latticeCosetTest, characteristic_apply,
      indicator_of_notMem ((eq_quotient_iff_mem_coset L x y).not.1 h)]

theorem latticeCosetTest_mem (x : A) : latticeCosetTest L hLo hLc x ∈ latticeInvariantTests L := by
  intro t ht y
  have h : QuotientAddGroup.mk' L t = 0 := QuotientAddGroup.eq_zero_iff t |>.2 ht
  simp only [latticeCosetTest_apply, map_add, h, add_zero]

/-- The lattice-invariant tests are generated by indicators of individual lattice cosets. -/
def LatticeCosetSpanStatement : Prop :=
  Submodule.span ℂ (range (latticeCosetTest L hLo hLc)) = latticeInvariantTests L

theorem latticeCosetSpan : LatticeCosetSpanStatement L hLo hLc := by
  classical
  let π := QuotientAddGroup.mk' L
  let : TopologicalSpace (A ⧸ L) := ⊥
  let : DiscreteTopology (A ⧸ L) := ⟨rfl⟩
  have hπ : IsLocallyConstant π := (IsLocallyConstant.iff_eventually_eq _).2 fun x => by
    have hO := (coset_clopen L hLo x).2
    have hx : x ∈ Homeomorph.addLeft x '' (L : Set A) := ⟨0, L.zero_mem, by simp⟩
    filter_upwards [hO.mem_nhds hx] with y hy
    exact (eq_quotient_iff_mem_coset L x y).2 hy
  apply le_antisymm
  · exact Submodule.span_le.mpr (by rintro _ ⟨x, rfl⟩; exact latticeCosetTest_mem L hLo hLc x)
  · intro f hf
    have hfc : IsCompact (support (f : A → ℂ)) := by
      have hc : IsClosed (support (f : A → ℂ)) :=
        (f.locallyConstant.isClopen_fiber 0).compl.isClosed
      rw [← hc.closure_eq]
      exact f.hasCompactSupport
    let B := π '' support (f : A → ℂ)
    have hB : B.Finite := (hfc.image hπ.continuous).finite_of_discrete
    let : Fintype B := hB.fintype
    have hr (b : B) : ∃ x : A, x ∈ support (f : A → ℂ) ∧ π x = b.val := b.property
    choose r _ hrep using hr
    have hconst {x y : A} (hxy : π x = π y) : f x = f y := by
      obtain ⟨t, ht, he⟩ := (QuotientAddGroup.mk'_eq_mk' L).1 hxy
      rw [← he]
      exact (hf t ht x).symm
    have hsum : f = ∑ b : B, f (r b) • latticeCosetTest L hLo hLc (r b) := by
      apply Hecke.TestFunction.ext
      intro x
      simp only [Submodule.coe_sum, Finset.sum_apply, Submodule.coe_smul, Pi.smul_apply, smul_eq_mul,
        latticeCosetTest_apply, show QuotientAddGroup.mk' L = π from rfl, hrep]
      by_cases hx : π x ∈ B
      · let b₀ : B := ⟨π x, hx⟩
        rw [Finset.sum_eq_single b₀]
        · simpa [b₀] using hconst (hrep b₀).symm
        · intro b _ hb
          have hbx : π x ≠ b.val := fun h => hb (Subtype.ext h.symm)
          simp [hbx]
        · simp
      · have hx' : f x = 0 := by
          by_contra h
          exact hx ⟨x, h, rfl⟩
        rw [hx', Finset.sum_eq_zero]
        intro b _
        have hbx : π x ≠ b.val := fun h => hx (h ▸ b.property)
        simp [hbx]
    rw [hsum]
    exact Submodule.sum_mem _ (fun b _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨r b, rfl⟩))

end Langlands.HarmonicAnalysis
