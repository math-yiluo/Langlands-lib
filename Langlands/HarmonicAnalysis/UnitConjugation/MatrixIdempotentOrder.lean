import Mathlib.Data.Matrix.Mul
import Mathlib.Data.Matrix.Basic
import Mathlib.RingTheory.Valuation.Basic
import Mathlib.Algebra.Module.Submodule.Basic
import Mathlib.Algebra.BigOperators.Pi

/-!
# Integral idempotent generators of left ideals of matrix algebras

Let `D` be a division ring with a valuation `w`. Gaussian elimination with pivots of maximal
valuation produces, for every left `D`-subspace `U` of the row space `D ^ n`, a matrix `P` with
entries of valuation at most `1` such that `v ↦ v P` is a projection onto `U`
(`exists_integral_projection`). Hence every left ideal of `M_n(D)` is generated by an idempotent
matrix with integral entries (`exists_integral_idempotent_matrix`); idempotent generators of
left ideals of the factors of a finite product combine (`exists_idempotent_pi`).
-/

noncomputable section

namespace Langlands.HarmonicAnalysis.UnitConjugation

open Finset

section Pivot

variable {D : Type*} [DivisionRing D] {Γ : Type*} [LinearOrderedCommGroupWithZero Γ]
  (w : Valuation D Γ) {n : ℕ}

/-- Integral echelon data for a subspace `U` of `D ^ n`: vectors `b p ∈ U` indexed by a set `S`
of pivot coordinates, with entries of valuation at most `1` and `b p q = δ_{p q}` on `S`. -/
structure IsIntegralEchelon (U : Submodule D (Fin n → D)) (S : Finset (Fin n))
    (b : Fin n → Fin n → D) : Prop where
  mem : ∀ p ∈ S, b p ∈ U
  integral : ∀ p ∈ S, ∀ q, w (b p q) ≤ 1
  pivot : ∀ p ∈ S, ∀ q ∈ S, b p q = if q = p then 1 else 0

variable {w}

theorem IsIntegralEchelon.sum_apply_of_mem {U : Submodule D (Fin n → D)} {S : Finset (Fin n)}
    {b : Fin n → Fin n → D} (h : IsIntegralEchelon w U S b) (v : Fin n → D) {q : Fin n}
    (hq : q ∈ S) : (∑ p ∈ S, v p • b p) q = v q := by
  rw [Finset.sum_apply, Finset.sum_eq_single q]
  · simp [h.pivot q hq q hq]
  · intro p hp hpq
    simp [h.pivot p hp q hq, Ne.symm hpq]
  · intro h'; exact absurd hq h'

/-- **The pivot step.** A vector of `U` not reproduced by the echelon data gives echelon data
with one more pivot. -/
theorem IsIntegralEchelon.exists_succ {U : Submodule D (Fin n → D)} {S : Finset (Fin n)}
    {b : Fin n → Fin n → D} (h : IsIntegralEchelon w U S b) {u : Fin n → D} (huU : u ∈ U)
    (hu : ∑ p ∈ S, u p • b p ≠ u) :
    ∃ (S' : Finset (Fin n)) (b' : Fin n → Fin n → D),
      IsIntegralEchelon w U S' b' ∧ S'.card = S.card + 1 := by
  classical
  set u' : Fin n → D := u - ∑ p ∈ S, u p • b p with hu'_def
  have hu'U : u' ∈ U := U.sub_mem huU (U.sum_mem fun p hp => U.smul_mem _ (h.mem p hp))
  have hu'S : ∀ q ∈ S, u' q = 0 := by
    intro q hq
    rw [hu'_def, Pi.sub_apply, h.sum_apply_of_mem u hq, sub_self]
  have hu'0 : u' ≠ 0 := sub_ne_zero.mpr (Ne.symm hu)
  obtain ⟨q₀, hq₀⟩ := Function.ne_iff.mp hu'0
  obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun q => w (u' q))
    ⟨q₀, Finset.mem_univ _⟩
  have hj0 : u' j ≠ 0 := by
    intro h0
    have := hj q₀ (Finset.mem_univ _)
    rw [h0, map_zero, le_zero_iff, Valuation.zero_iff] at this
    exact hq₀ this
  have hjS : j ∉ S := fun hjS => hj0 (hu'S j hjS)
  set bn : Fin n → D := (u' j)⁻¹ • u' with hbn_def
  have hbnj : bn j = 1 := by
    rw [hbn_def, Pi.smul_apply, smul_eq_mul, inv_mul_cancel₀ hj0]
  have hbnS : ∀ q ∈ S, bn q = 0 := by
    intro q hq; rw [hbn_def, Pi.smul_apply, hu'S q hq, smul_zero]
  have hbnU : bn ∈ U := U.smul_mem _ hu'U
  have hbnint : ∀ q, w (bn q) ≤ 1 := by
    intro q
    rw [hbn_def, Pi.smul_apply, smul_eq_mul, map_mul, map_inv₀]
    have hpos : 0 < w (u' j) := (Valuation.pos_iff w).mpr hj0
    rw [inv_mul_le_one₀ hpos]
    exact hj q (Finset.mem_univ _)
  refine ⟨insert j S, fun p => if p = j then bn else b p - b p j • bn, ⟨?_, ?_, ?_⟩,
    Finset.card_insert_of_notMem hjS⟩
  · intro p hp
    by_cases hpj : p = j
    · simp only [hpj, ↓reduceIte]; exact hbnU
    · have hpS : p ∈ S := (Finset.mem_insert.mp hp).resolve_left hpj
      simp only [hpj, ↓reduceIte]
      exact U.sub_mem (h.mem p hpS) (U.smul_mem _ hbnU)
  · intro p hp q
    by_cases hpj : p = j
    · simp only [hpj, ↓reduceIte]; exact hbnint q
    · have hpS : p ∈ S := (Finset.mem_insert.mp hp).resolve_left hpj
      simp only [hpj, ↓reduceIte, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      refine (Valuation.map_sub w _ _).trans (max_le (h.integral p hpS q) ?_)
      rw [map_mul]
      exact mul_le_one' (h.integral p hpS j) (hbnint q)
  · intro p hp q hq
    by_cases hpj : p = j
    · simp only [hpj, ↓reduceIte]
      by_cases hqj : q = j
      · simp [hqj, hbnj]
      · have hqS : q ∈ S := (Finset.mem_insert.mp hq).resolve_left hqj
        simp [hqj, hbnS q hqS]
    · have hpS : p ∈ S := (Finset.mem_insert.mp hp).resolve_left hpj
      simp only [hpj, ↓reduceIte, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      by_cases hqj : q = j
      · subst hqj
        rw [hbnj, mul_one, sub_self, ite_eq_right (fun h' => hpj h'.symm)]
      · have hqS : q ∈ S := (Finset.mem_insert.mp hq).resolve_left hqj
        rw [hbnS q hqS, mul_zero, sub_zero, h.pivot p hpS q hqS]

/-- **Integral echelon data reproducing `U`.** -/
theorem exists_integralEchelon (U : Submodule D (Fin n → D)) :
    ∃ (S : Finset (Fin n)) (b : Fin n → Fin n → D), IsIntegralEchelon w U S b ∧
      ∀ v ∈ U, ∑ p ∈ S, v p • b p = v := by
  classical
  suffices H : ∀ k : ℕ, ∀ (S : Finset (Fin n)) (b : Fin n → Fin n → D),
      IsIntegralEchelon w U S b → n - S.card ≤ k →
      ∃ (S' : Finset (Fin n)) (b' : Fin n → Fin n → D), IsIntegralEchelon w U S' b' ∧
        ∀ v ∈ U, ∑ p ∈ S', v p • b' p = v by
    refine H n ∅ 0 ⟨by simp, by simp, by simp⟩ (by simp)
  intro k
  induction k with
  | zero =>
    intro S b h hk
    by_contra hcon
    push Not at hcon
    obtain ⟨u, huU, hu⟩ := hcon S b h
    obtain ⟨S', b', -, hcard⟩ := h.exists_succ huU hu
    have : S'.card ≤ n := by simpa using Finset.card_le_univ S'
    omega
  | succ k ih =>
    intro S b h hk
    by_cases hdone : ∀ v ∈ U, ∑ p ∈ S, v p • b p = v
    · exact ⟨S, b, h, hdone⟩
    push Not at hdone
    obtain ⟨u, huU, hu⟩ := hdone
    obtain ⟨S', b', h', hcard⟩ := h.exists_succ huU hu
    exact ih S' b' h' (by omega)

/-- **Integral projections onto row subspaces.** For every left subspace `U` of `D ^ n` there is
a matrix `P` with entries of valuation at most `1` such that `v P ∈ U` for every row vector `v`
and `v P = v` for `v ∈ U`. -/
theorem exists_integral_projection (U : Submodule D (Fin n → D)) :
    ∃ P : Matrix (Fin n) (Fin n) D, (∀ q r, w (P q r) ≤ 1) ∧
      (∀ v, Matrix.vecMul v P ∈ U) ∧ ∀ v ∈ U, Matrix.vecMul v P = v := by
  classical
  obtain ⟨S, b, h, hrep⟩ := exists_integralEchelon (w := w) U
  let P : Matrix (Fin n) (Fin n) D := Matrix.of fun q r => if q ∈ S then b q r else 0
  have hP : ∀ v, Matrix.vecMul v P = ∑ p ∈ S, v p • b p := by
    intro v
    funext r
    simp only [Matrix.vecMul, dotProduct, P, Matrix.of_apply, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul, mul_ite, mul_zero]
    rw [← Finset.sum_filter]
    congr 1
    ext q; simp
  refine ⟨P, fun q r => ?_, fun v => ?_, fun v hv => ?_⟩
  · simp only [P, Matrix.of_apply]
    split_ifs with hq
    · exact h.integral q hq r
    · simp
  · rw [hP]; exact U.sum_mem fun p hp => U.smul_mem _ (h.mem p hp)
  · rw [hP]; exact hrep v hv

end Pivot

section MatrixIdeal

variable {D : Type*} [DivisionRing D] {n : ℕ}

/-- The rows of the matrices of a left ideal of `M_n(D)`: the row vectors `v` with
`a ⊗ v ∈ J` for every column `a`. -/
def leftIdealRows (J : Submodule (Matrix (Fin n) (Fin n) D) (Matrix (Fin n) (Fin n) D)) :
    Submodule D (Fin n → D) where
  carrier := {v | ∀ a : Fin n → D, Matrix.vecMulVec a v ∈ J}
  add_mem' := fun {v v'} hv hv' a => by
    simp only [Set.mem_ofPred_eq] at hv hv' ⊢
    rw [Matrix.vecMulVec_add]; exact J.add_mem (hv a) (hv' a)
  zero_mem' := fun a => by simp
  smul_mem' := fun d v hv a => by
    simp only [Set.mem_ofPred_eq] at hv ⊢
    have : Matrix.vecMulVec a (d • v) = Matrix.vecMulVec (fun i => a i * d) v := by
      ext i j; simp [Matrix.vecMulVec_apply, mul_assoc]
    rw [this]; exact hv _

theorem row_mem_leftIdealRows {J : Submodule (Matrix (Fin n) (Fin n) D) (Matrix (Fin n) (Fin n) D)}
    {M : Matrix (Fin n) (Fin n) D} (hM : M ∈ J) (i : Fin n) : M i ∈ leftIdealRows J := by
  classical
  intro a
  have : Matrix.vecMulVec a (M i) = Matrix.vecMulVec a (Pi.single i 1) * M := by
    ext r s
    simp [Matrix.vecMulVec_apply, Matrix.mul_apply, Pi.single_apply]
  rw [this]
  exact J.smul_mem _ hM

theorem mem_of_rows_mem {J : Submodule (Matrix (Fin n) (Fin n) D) (Matrix (Fin n) (Fin n) D)}
    {M : Matrix (Fin n) (Fin n) D} (hM : ∀ i, M i ∈ leftIdealRows J) : M ∈ J := by
  classical
  have : M = ∑ i, Matrix.vecMulVec (Pi.single i 1) (M i) := by
    ext r s
    rw [Matrix.sum_apply, Finset.sum_eq_single r]
    · simp [Matrix.vecMulVec_apply]
    · intro i _ hi
      simp [Matrix.vecMulVec_apply, Ne.symm hi]
    · simp
  rw [this]
  exact J.sum_mem fun i _ => hM i _

theorem mul_row (M P : Matrix (Fin n) (Fin n) D) (i : Fin n) :
    (M * P) i = Matrix.vecMul (M i) P := by
  funext j
  simp [Matrix.mul_apply, Matrix.vecMul, dotProduct]

variable {Γ : Type*} [LinearOrderedCommGroupWithZero Γ] (w : Valuation D Γ)

/-- **Integral idempotent generators of left ideals of `M_n(D)`.** -/
theorem exists_integral_idempotent_matrix
    (J : Submodule (Matrix (Fin n) (Fin n) D) (Matrix (Fin n) (Fin n) D)) :
    ∃ P : Matrix (Fin n) (Fin n) D, (∀ q r, w (P q r) ≤ 1) ∧ P * P = P ∧
      ∀ M, M ∈ J ↔ M * P = M := by
  classical
  obtain ⟨P, hPint, hPU, hPfix⟩ := exists_integral_projection (w := w) (leftIdealRows J)
  have hiff : ∀ M, M ∈ J ↔ M * P = M := by
    intro M
    constructor
    · intro hM
      funext i
      rw [mul_row]
      exact hPfix _ (row_mem_leftIdealRows hM i)
    · intro hM
      apply mem_of_rows_mem
      intro i
      rw [← hM, mul_row]
      exact hPU _
  refine ⟨P, hPint, ?_, hiff⟩
  have hPJ : P ∈ J := by
    apply mem_of_rows_mem
    intro i
    have : P i = Matrix.vecMul (Pi.single i 1) P := by
      funext j
      simp [Matrix.vecMul, dotProduct, Pi.single_apply]
    rw [this]
    exact hPU _
  exact (hiff P).mp hPJ

end MatrixIdeal

section Pi

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {B : ι → Type*} [∀ i, Ring (B i)]

/-- **Idempotent generators in a finite product.** If every left ideal of each factor `B i` is
generated by an idempotent satisfying a condition `Q i`, so is every left ideal of `∏ B i`,
by an idempotent whose components satisfy the conditions. -/
theorem exists_idempotent_pi (Q : ∀ i, B i → Prop)
    (h : ∀ i (J : Submodule (B i) (B i)), ∃ e, Q i e ∧ e * e = e ∧ ∀ z, z ∈ J ↔ z * e = z)
    (J : Submodule (∀ i, B i) (∀ i, B i)) :
    ∃ e : ∀ i, B i, (∀ i, Q i (e i)) ∧ e * e = e ∧ ∀ y, y ∈ J ↔ y * e = y := by
  let Ji : ∀ i, Submodule (B i) (B i) := fun i =>
    { carrier := {z | Pi.single i z ∈ J}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_ofPred_eq, Pi.single_add] at ha hb ⊢
        exact J.add_mem ha hb
      zero_mem' := by simp
      smul_mem' := fun a z hz => by
        simp only [Set.mem_ofPred_eq, smul_eq_mul] at hz ⊢
        rw [Pi.single_mul]
        exact J.smul_mem _ hz }
  have hmemJ : ∀ y, y ∈ J ↔ ∀ i, y i ∈ Ji i := by
    intro y
    constructor
    · intro hy i
      have : Pi.single i (y i) = Pi.single i (1 : B i) * y := by
        funext j
        by_cases hj : j = i
        · subst hj; simp
        · simp [hj]
      change Pi.single i (y i) ∈ J
      rw [this]
      exact J.smul_mem _ hy
    · intro hy
      rw [← Finset.univ_sum_single y]
      exact J.sum_mem fun i _ => hy i
  choose e hQ he hJe using fun i => h i (Ji i)
  refine ⟨e, hQ, funext fun i => he i, fun y => ?_⟩
  rw [hmemJ]
  constructor
  · intro hy
    funext i
    exact (hJe i (y i)).mp (hy i)
  · intro hy i
    exact (hJe i (y i)).mpr (congrFun hy i)

end Pi

end Langlands.HarmonicAnalysis.UnitConjugation
