import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.Topology.Algebra.Module.ModuleTopology

/-!
# A compact open order containing idempotent generators of all left ideals

For a finite-dimensional semisimple algebra `A` over a nonarchimedean local field `F`, with its
module topology, `SemisimpleIdempotentOrderStatement` asserts that there is a compact open
subring `R` of `A`, stable under multiplication by the integers of `F`, such that every left
ideal of `A` is generated by an idempotent lying in `R`. The statement is not proved here.

For `A = M_d(D)` with `D` a division algebra over `F`, the ring `R = M_d(𝔬_D)` of matrices over
the maximal compact subring `𝔬_D` of `D` has this property by the existence of lattice bases
adapted to a subspace (Weil, *Basic Number Theory*, Chapter II, §2, Theorem 1); products of such
rings handle the general case through the Wedderburn–Artin theorem.
-/

namespace Langlands.HarmonicAnalysis.UnitConjugation

open ValuativeRel

/-- **Idempotent generators in a compact open order.** For every nonarchimedean local field `F`
and every finite-dimensional semisimple `F`-algebra `A` with its module topology, there is a
subring `R` of `A` that is compact and open, is stable under multiplication by the integers
`{c : F | valuation F c ≤ 1}` of `F`, and contains, for every left ideal `J` of `A`, an
idempotent `e` with `J = A e`. -/
def SemisimpleIdempotentOrderStatement.{u, v} : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (A : Type v) [Ring A] [Algebra F A] [FiniteDimensional F A] [IsSemisimpleRing A]
    [TopologicalSpace A] [IsModuleTopology F A],
    ∃ R : Subring A, IsCompact (R : Set A) ∧ IsOpen (R : Set A) ∧
      (∀ c : F, valuation F c ≤ 1 → ∀ x ∈ R, c • x ∈ R) ∧
      ∀ J : Submodule A A, ∃ e ∈ R, IsIdempotentElem e ∧ J = Submodule.span A {e}

end Langlands.HarmonicAnalysis.UnitConjugation
