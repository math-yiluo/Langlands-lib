import Langlands.HarmonicAnalysis.PointwiseTestModule
import Langlands.Topology.LocallyProfinite

/-!
# The fibre of the sheaf of a nondegenerate `𝒟(X)`-module (Renard II.2.5, `ℳ_x = M/M(x)`)

For a nondegenerate module `M` over the test algebra `𝒟(X)` of a t.d. space and a point `x`,
the vectors that vanish in the fibre `ℳ_x` (those killed by `χ_U` for a compact open
neighbourhood `U` of `x`) are exactly the elements of
`M(x) = {m | ∃ f ∈ 𝒟(X), f(x) ≠ 0, f · m = 0}`, and also exactly the elements of the subspace
generated by the `f · m` with `f(x) = 0`.
-/

universe uX uM

namespace Langlands.HarmonicAnalysis.PointwiseTestModule

open Langlands.Algebra PointwiseTestAlgebra

/-- Renard II.2.5, the fibre `ℳ_x = M/M(x)`: for a t.d. space `X`, a nondegenerate
`𝒟(X)`-module `M`, a point `x` and `m ∈ M`, the following are equivalent:
`m ∈ M(x)`, that is `f · m = 0` for some `f ∈ 𝒟(X)` with `f(x) ≠ 0`; `χ_U · m = 0` for some
compact open neighbourhood `U` of `x` (the class of `m` in the fibre is zero); and `m` lies in
the additive subgroup generated by the `f · m'` with `f(x) = 0`. -/
def NondegenerateStalkKernelStatement : Prop :=
  ∀ (X : Type uX) [TopologicalSpace X], Langlands.Topology.IsLocallyProfinite X →
    ∀ (M : Type uM) [AddCommGroup M] [NonUnitalModule (Carrier X) M],
      IsNondegenerate (Carrier X) M → ∀ (x : X) (m : M),
        ((∃ f : Carrier X, f x ≠ 0 ∧ f • m = 0) ↔
          ∃ (U : Set X) (hU : IsClopen U) (hc : IsCompact U),
            x ∈ U ∧ characteristic hU hc • m = 0) ∧
        ((∃ f : Carrier X, f x ≠ 0 ∧ f • m = 0) ↔
          m ∈ AddSubgroup.closure
            {y : M | ∃ (f : Carrier X) (m' : M), f x = 0 ∧ f • m' = y})

end Langlands.HarmonicAnalysis.PointwiseTestModule
