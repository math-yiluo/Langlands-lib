import Langlands.HarmonicAnalysis.HarishChandraSchwartz.OrbitSectionFiniteProductTopology

/-! # Proof of the finite-product level and total topology comparison -/

noncomputable section

open Langlands.Aubert.General Langlands.Plancherel Langlands.Induction
open Langlands.HarmonicAnalysis.TorusFourier
open TopologicalSpace Topology
open scoped TensorProduct NNReal

namespace Langlands.HarishChandraSchwartz

universe uG uI uV uJ uB

section Abstract

/-- The topology generated by a seminorm family has these seminorms, with the
topology passed explicitly. -/
theorem withSeminorms_moduleFilterBasis_topology {E ι : Type*} [AddCommGroup E] [Module ℂ E]
    (p : SeminormFamily ℂ E ι) :
    @WithSeminorms ℂ E ι _ _ _ p p.moduleFilterBasis.topology := by
  let _ := p.moduleFilterBasis.topology
  exact ⟨rfl⟩

/-- `WithSeminorms.continuous_of_continuous_comp` with both topologies explicit. -/
theorem continuous_of_withSeminorms_explicit {E F ι : Type*} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F] (tE : TopologicalSpace E) (tF : TopologicalSpace F)
    (hE : @IsTopologicalAddGroup E tE _) {q : SeminormFamily ℂ F ι}
    (hq : @WithSeminorms ℂ F ι _ _ _ q tF) (f : E →ₗ[ℂ] F)
    (hf : ∀ i, Continuous[tE, inferInstance] ((q i).comp f)) : Continuous[tE, tF] f := by
  let _ := tE
  let _ := tF
  exact hq.continuous_of_continuous_comp f hf

/-- Two seminorm topologies on `V`, one given directly and one pulled back
along finitely many coordinates in a seminormed space `S`, agree as soon as each
coordinate seminorm is one of the given seminorms and each given seminorm is the
norm of a fixed linear combination of the coordinates after one of the maps `D k`
computing the seminorms of `S`. -/
theorem topology_eq_induced_pi_of_seminorms
    {V S N B ι κ : Type*} [Fintype B]
    [AddCommGroup V] [Module ℂ V] [AddCommGroup S] [Module ℂ S]
    [NormedAddCommGroup N] [NormedSpace ℂ N]
    (tV : TopologicalSpace V) (tS : TopologicalSpace S)
    {p : SeminormFamily ℂ V ι} {s : SeminormFamily ℂ S κ}
    (hp : @WithSeminorms ℂ V ι _ _ _ p tV) (hs : @WithSeminorms ℂ S κ _ _ _ s tS)
    (D : κ → S →ₗ[ℂ] N) (hD : ∀ k x, s k x = ‖D k x‖)
    (c : V →ₗ[ℂ] (B → S))
    (h₁ : ∀ (j : B) (k : κ), ∃ i : ι, ∀ v, s k (c v j) = p i v)
    (h₂ : ∀ i : ι, ∃ (k : κ) (a : B → ℂ), ∀ v, p i v = ‖∑ j, a j • D k (c v j)‖) :
    tV = induced c (@Pi.topologicalSpace B (fun _ => S) (fun _ => tS)) := by
  let _ := tS
  have hSgrp : IsTopologicalAddGroup S := hs.isTopologicalAddGroup
  have hDcont : ∀ k, Continuous (D k) := fun k =>
    (norm_withSeminorms ℂ N).continuous_of_continuous_comp (D k) fun _ => by
      have heq : ⇑((normSeminorm ℂ N).comp (D k)) = ⇑(s k) :=
        funext fun x => (hD k x).symm
      rw [heq]
      exact hs.continuous_seminorm k
  apply le_antisymm
  · refine continuous_iff_le_induced.1 ?_
    let _ := tV
    have hVgrp : IsTopologicalAddGroup V := hp.isTopologicalAddGroup
    refine continuous_pi fun j => ?_
    exact hs.continuous_of_continuous_comp (LinearMap.proj j ∘ₗ c) fun k => by
      obtain ⟨i, hi⟩ := h₁ j k
      have heq : ⇑((s k).comp (LinearMap.proj j ∘ₗ c)) = ⇑(p i) := funext hi
      rw [heq]
      exact hp.continuous_seminorm i
  · let tVi : TopologicalSpace V := induced c inferInstance
    have hVgrp : IsTopologicalAddGroup V := isTopologicalAddGroup_induced c
    have hcoord : ∀ j, Continuous fun v : V => c v j := fun j =>
      (continuous_apply j).comp continuous_induced_dom
    refine continuous_id_iff_le.1 ?_
    have hid := continuous_of_withSeminorms_explicit tVi tV hVgrp hp LinearMap.id fun i => by
      obtain ⟨k, a, hi⟩ := h₂ i
      have heq : ⇑((p i).comp LinearMap.id) = fun v => ‖∑ j, a j • D k (c v j)‖ :=
        funext fun v => hi v
      rw [heq]
      exact continuous_norm.comp (continuous_finsetSum _ fun j _ =>
        continuous_const.smul ((hDcont k).comp (hcoord j)))
    exact hid

end Abstract

section Scalar

variable (J : Type uJ) [Fintype J] [DecidableEq J]

/-- The independent scalar smooth topology is generated by the ordered angle
seminorms. -/
theorem smoothTorusFunctionTopology_withSeminorms :
    @WithSeminorms ℂ (smoothFiniteTorusFunctions J) (List J) _ _ _
      (smoothTorusSeminorm J) (smoothTorusFunctionTopology J) :=
  withSeminorms_moduleFilterBasis_topology (smoothTorusSeminorm J)

end Scalar

variable {G : Type uG} [Group G] [TopologicalSpace G] [LocallyCompactSpace G]
  [NonarchimedeanGroup G] {P M U : Subgroup G}
  (h : IsSemidirectDecomposition P M U) (K : OpenSubgroup G)
  (π : IrreducibleAdmissibleRep.{0, uG, uV} (k := ℂ) (G := M))
  {I : Type uI} (ν : I → (M →* ℝ≥0ˣ))
  {J : Type uJ} [Fintype J] [DecidableEq J]
  (e : unitaryUnramifiedCharacters ν ≃* (J → Circle))
  (hU : IsClosed (U : Set G)) (hP : IsClosed (P : Set G))
  (hK : IsCompact (K : Set G)) (hν : ∀ i, Continuous (ν i))
  (hr : Continuous h.projection)
  (hPK : ∀ g : G, ∃ p : P, ∃ k : K, g = (p : G) * (k : G))

section Level

variable (H : OpenSubgroup G) (hHK : H ≤ K)
  {B : Type uB} [Fintype B] [DecidableEq B]
  (b : Module.Basis B ℂ (orbitSectionFixedCoefficients h K π H))

omit [DecidableEq J] in
/-- The underlying coefficient of the fixed-valued restriction is the original
compact restriction. -/
theorem orbitSectionLevelFixedRestriction_val
    (q : OrbitSectionLevel ν π e h hU K hP hK hν hr hPK H) (z : J → Circle) :
    (orbitSectionLevelFixedRestriction h K π ν e hU hP hK hν hr hPK H hHK q z :
        ProductInducedCompactPicture h K π.obj) =
      productInducedSmoothOrbitCompactRestriction h hU ν π K hP hK hν hr hPK e
        (OrbitSectionLevel.toSections ν π e h hU K hP hK hν hr hPK H q) z :=
  rfl

omit [DecidableEq J] in
/-- A coordinate is the existing scalar coefficient of the section along any
extension of the coordinate functional to the whole compact picture. -/
theorem orbitSectionLevelCoordinates_eq_orbitSectionCoefficient (i : B)
    (ℓ : Module.Dual ℂ (ProductInducedCompactPicture h K π.obj))
    (hℓ : ∀ x : orbitSectionFixedCoefficients h K π H,
      ℓ (x : ProductInducedCompactPicture h K π.obj) = b.coord i x)
    (q : OrbitSectionLevel ν π e h hU K hP hK hν hr hPK H) :
    orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q i =
      orbitSectionCoefficient ν π e h hU K hP hK hν hr hPK ℓ
        (OrbitSectionLevel.toSections ν π e h hU K hP hK hν hr hPK H q) := by
  apply Subtype.ext
  funext z
  have h1 := orbitSectionLevelCoordinates_apply h K π ν e hU hP hK hν hr hPK H hHK b q i z
  have h2 : (orbitSectionCoefficient ν π e h hU K hP hK hν hr hPK ℓ
        (OrbitSectionLevel.toSections ν π e h hU K hP hK hν hr hPK H q)).val z =
      ℓ (orbitSectionLevelFixedRestriction h K π ν e hU hP hK hν hr hPK H hHK q z :
        ProductInducedCompactPicture h K π.obj) := rfl
  exact h1.trans ((hℓ _).symm.trans h2.symm)

omit [DecidableEq J] in
/-- The existing scalar coefficient along an arbitrary functional is a finite
linear combination of the coordinates. -/
theorem orbitSectionCoefficient_eq_sum_coordinates
    (ℓ : Module.Dual ℂ (ProductInducedCompactPicture h K π.obj))
    (q : OrbitSectionLevel ν π e h hU K hP hK hν hr hPK H) :
    orbitSectionCoefficient ν π e h hU K hP hK hν hr hPK ℓ
        (OrbitSectionLevel.toSections ν π e h hU K hP hK hν hr hPK H q) =
      ∑ i, ℓ (b i : ProductInducedCompactPicture h K π.obj) •
        orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q i := by
  apply Subtype.ext
  funext z
  have h1 : (orbitSectionCoefficient ν π e h hU K hP hK hν hr hPK ℓ
        (OrbitSectionLevel.toSections ν π e h hU K hP hK hν hr hPK H q)).val z =
      ℓ (orbitSectionLevelFixedRestriction h K π ν e hU hP hK hν hr hPK H hHK q z :
        ProductInducedCompactPicture h K π.obj) := rfl
  have h2 : ∀ x : orbitSectionFixedCoefficients h K π H,
      ℓ (x : ProductInducedCompactPicture h K π.obj) =
        ∑ i, ℓ (b i : ProductInducedCompactPicture h K π.obj) * b.coord i x := by
    intro x
    conv_lhs => rw [← b.sum_repr x]
    simp only [Submodule.coe_sum, Submodule.coe_smul, map_sum, map_smul, smul_eq_mul,
      Module.Basis.coord_apply]
    exact Finset.sum_congr rfl fun i _ => mul_comm _ _
  have h3 : ((∑ i, ℓ (b i : ProductInducedCompactPicture h K π.obj) •
        orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q i :
          smoothFiniteTorusFunctions J) : (J → Circle) → ℂ) z =
      ∑ i, ℓ (b i : ProductInducedCompactPicture h K π.obj) *
        (orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q i).val z := by
    simp only [AddSubmonoidClass.coe_finsetSum, Finset.sum_apply, SetLike.val_smul,
      Pi.smul_apply, smul_eq_mul]
  have h4 : ∑ i, ℓ (b i : ProductInducedCompactPicture h K π.obj) *
        b.coord i (orbitSectionLevelFixedRestriction h K π ν e hU hP hK hν hr hPK H hHK q z) =
      ∑ i, ℓ (b i : ProductInducedCompactPicture h K π.obj) *
        (orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q i).val z :=
    Finset.sum_congr rfl fun i _ => by
      rw [orbitSectionLevelCoordinates_apply]
  exact h1.trans ((h2 _).trans (h4.trans h3.symm))

/-- The level comparison for an arbitrary finite coefficient basis. -/
theorem orbitSectionLevelFiniteProductTopologyStatement_holds :
    OrbitSectionLevelFiniteProductTopologyStatement h K π ν e hU hP hK hν hr hPK H hHK b := by
  choose ℓ hℓ using fun i : B => LinearMap.exists_extend (b.coord i)
  have hℓ' : ∀ (i : B) (x : orbitSectionFixedCoefficients h K π H),
      ℓ i (x : ProductInducedCompactPicture h K π.obj) = b.coord i x :=
    fun i x => LinearMap.congr_fun (hℓ i) x
  refine topology_eq_induced_pi_of_seminorms
    (OrbitSectionLevel.topologicalSpace ν π e h hU K hP hK hν hr hPK H)
    (smoothTorusFunctionTopology J)
    (OrbitSectionLevel.withSeminorms ν π e h hU K hP hK hν hr hPK H)
    (smoothTorusFunctionTopology_withSeminorms J) (smoothTorusDerivative J) (fun _ _ => rfl)
    (orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b) ?_ ?_
  · intro j l
    refine ⟨(l, ℓ j), fun q => ?_⟩
    exact (congrArg (smoothTorusSeminorm J l)
      (orbitSectionLevelCoordinates_eq_orbitSectionCoefficient h K π ν e hU hP hK hν hr hPK H hHK b
        j (ℓ j) (hℓ' j) q)).trans rfl
  · rintro ⟨l, ℓ₀⟩
    refine ⟨l, fun j => ℓ₀ (b j : ProductInducedCompactPicture h K π.obj), fun q => ?_⟩
    have hB := orbitSectionCoefficient_eq_sum_coordinates h K π ν e hU hP hK hν hr hPK H hHK b ℓ₀ q
    calc OrbitSectionLevel.seminormFamily ν π e h hU K hP hK hν hr hPK H (l, ℓ₀) q
        = ‖smoothTorusDerivative J l (orbitSectionCoefficient ν π e h hU K hP hK hν hr hPK ℓ₀
            (OrbitSectionLevel.toSections ν π e h hU K hP hK hν hr hPK H q))‖ := rfl
      _ = ‖smoothTorusDerivative J l (∑ j, ℓ₀ (b j : ProductInducedCompactPicture h K π.obj) •
            orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q j)‖ :=
          congrArg (fun f => ‖smoothTorusDerivative J l f‖) hB
      _ = ‖∑ j, ℓ₀ (b j : ProductInducedCompactPicture h K π.obj) •
            smoothTorusDerivative J l
              (orbitSectionLevelCoordinates h K π ν e hU hP hK hν hr hPK H hHK b q j)‖ := by
          rw [map_sum]
          simp only [map_smul]

end Level

section Total

variable
  (d : ∀ H : {H : OpenSubgroup G // H ≤ K},
    FiniteDimensional ℂ (orbitSectionFixedCoefficients h K π H.1))

/-- The finite-product final topology is the existing `originalTop`. -/
theorem orbitSectionFiniteProductOriginalTop_eq :
    OrbitSectionSpace.originalTop ν π e h hU K hP hK hν hr hPK =
      orbitSectionFiniteProductOriginalTop h K π ν e hU hP hK hν hr hPK d := by
  unfold OrbitSectionSpace.originalTop orbitSectionFiniteProductOriginalTop
  refine iSup_congr fun H => ?_
  rw [orbitSectionLevelFiniteProductTopologyStatement_holds h K π ν e hU hP hK hν hr hPK H.1 H.2
    (orbitSectionFixedBasis h K π H.1 (d H))]

/-- The total comparison for the selected bases. -/
theorem orbitSectionTotalFiniteProductTopologyStatement_holds :
    OrbitSectionTotalFiniteProductTopologyStatement h K π ν e hU hP hK hν hr hPK d := by
  unfold OrbitSectionTotalFiniteProductTopologyStatement OrbitSectionSpace.topologicalSpace
    orbitSectionFiniteProductTopology
  rw [orbitSectionFiniteProductOriginalTop_eq h K π ν e hU hP hK hν hr hPK d]

end Total

/-- The published aggregate target. -/
theorem orbitSectionFiniteProductTopologyStatement_holds (hcofinal : CompactOpenCofinal M) :
    OrbitSectionFiniteProductTopologyStatement.{uG, uI, uV, uJ, uB}
      h K π ν e hU hP hK hν hr hPK hcofinal :=
  ⟨fun H => finiteDimensional_orbitSectionFixedCoefficients h K π hK hcofinal H.1 H.2,
    fun H _ _ _ b =>
      orbitSectionLevelFiniteProductTopologyStatement_holds h K π ν e hU hP hK hν hr hPK H.1 H.2 b,
    orbitSectionTotalFiniteProductTopologyStatement_holds h K π ν e hU hP hK hν hr hPK _⟩

end Langlands.HarishChandraSchwartz
