import Mathlib.Topology.Algebra.PontryaginDual
import Mathlib.Topology.ContinuousMap.StoneWeierstrass
import Mathlib.MeasureTheory.Measure.Haar.Basic
import Mathlib.MeasureTheory.Group.Integral
import Mathlib.MeasureTheory.Integral.Bochner.Set

/-! # Completeness of a separating subgroup of compact-group characters -/

noncomputable section

open MeasureTheory Complex Set Submodule Algebra
open scoped ComplexConjugate

universe u

namespace Langlands.HarmonicAnalysis.CompactCharacterCompleteness

variable {G : Type u} [Group G] [TopologicalSpace G]

/-- A circle-valued character viewed as a continuous complex-valued function. -/
def complexMap (χ : PontryaginDual G) : C(G, ℂ) :=
  ⟨fun g => (χ g : ℂ), continuous_subtype_val.comp χ.continuous⟩

@[simp]
theorem complexMap_apply (χ : PontryaginDual G) (g : G) :
    complexMap χ g = (χ g : ℂ) := rfl

@[simp]
theorem complexMap_one : complexMap (1 : PontryaginDual G) = 1 := by
  ext g
  simp

@[simp]
theorem complexMap_mul (χ η : PontryaginDual G) :
    complexMap (χ * η) = complexMap χ * complexMap η := by
  ext g
  rfl

@[simp]
theorem complexMap_inv (χ : PontryaginDual G) :
    complexMap χ⁻¹ = star (complexMap χ) := by
  ext g
  exact Circle.coe_inv_eq_conj (χ g)

/-- The complex star algebra generated by a subgroup of continuous characters. -/
def characterAlgebra (H : Subgroup (PontryaginDual G)) : StarSubalgebra ℂ C(G, ℂ) where
  toSubalgebra := Algebra.adjoin ℂ (range (fun χ : H => complexMap (χ : PontryaginDual G)))
  star_mem' := by
    change Algebra.adjoin ℂ (range (fun χ : H => complexMap (χ : PontryaginDual G))) ≤
      star (Algebra.adjoin ℂ (range (fun χ : H => complexMap (χ : PontryaginDual G))))
    refine adjoin_le ?_
    rintro _ ⟨χ, rfl⟩
    refine subset_adjoin ⟨χ⁻¹, ?_⟩
    exact complexMap_inv (χ : PontryaginDual G)

/-- The algebra generated by a character subgroup is already its linear span. -/
theorem characterAlgebra_toSubmodule (H : Subgroup (PontryaginDual G)) :
    (characterAlgebra H).toSubalgebra.toSubmodule =
      span ℂ (range (fun χ : H => complexMap (χ : PontryaginDual G))) := by
  apply adjoin_eq_span_of_subset
  refine .trans (fun x => Submonoid.closure_induction (fun _ => id) ⟨1, ?_⟩ ?_) subset_span
  · exact complexMap_one
  · rintro _ _ _ _ ⟨χ, rfl⟩ ⟨η, rfl⟩
    exact ⟨χ * η, complexMap_mul (χ : PontryaginDual G) (η : PontryaginDual G)⟩

/-- Stone–Weierstrass for a separating subgroup of circle-valued characters. -/
theorem span_topologicalClosure_eq_top [CompactSpace G]
    (H : Subgroup (PontryaginDual G))
    (hsep : ∀ x y : G, x ≠ y →
      ∃ χ : H, (χ : PontryaginDual G) x ≠ (χ : PontryaginDual G) y) :
    (span ℂ (range (fun χ : H => complexMap (χ : PontryaginDual G)))).topologicalClosure = ⊤ := by
  rw [← characterAlgebra_toSubmodule]
  have hsepAlgebra : (characterAlgebra H).SeparatesPoints := by
    intro x y hxy
    obtain ⟨χ, hχ⟩ := hsep x y hxy
    refine ⟨_, ⟨complexMap (χ : PontryaginDual G), subset_adjoin ⟨χ, rfl⟩, rfl⟩, ?_⟩
    simpa only [complexMap_apply, Ne, Circle.coe_inj] using hχ
  exact congr_arg (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
      hsepAlgebra)

section Integration

variable [IsTopologicalGroup G] [MeasurableSpace G] [BorelSpace G]
    (μ : Measure G) [μ.IsMulLeftInvariant]

/-- The integral of a nontrivial continuous circle-valued character vanishes. -/
theorem integral_eq_zero (χ : PontryaginDual G) (hχ : χ ≠ 1) :
    ∫ g, (χ g : ℂ) ∂μ = 0 := by
  obtain ⟨g, hg⟩ : ∃ g : G, χ g ≠ 1 := by
    by_contra! h
    apply hχ
    exact PontryaginDual.ext h
  have h := integral_mul_left_eq_self (μ := μ) (fun x => (χ x : ℂ)) g
  simp only [map_mul, Circle.coe_mul, integral_const_mul] at h
  have hne : (χ g : ℂ) - 1 ≠ 0 := by
    intro he
    apply hg
    apply Subtype.ext
    simpa using sub_eq_zero.mp he
  apply (mul_eq_zero.mp (show ((χ g : ℂ) - 1) * (∫ x, (χ x : ℂ) ∂μ) = 0 from ?_)).resolve_left hne
  linear_combination h

/-- Every continuous character belongs to a separating subgroup on a compact group.
A left invariant probability measure is supplied explicitly. -/
theorem mem_of_separates [CompactSpace G] [IsProbabilityMeasure μ]
    (H : Subgroup (PontryaginDual G))
    (hsep : ∀ x y : G, x ≠ y →
      ∃ χ : H, (χ : PontryaginDual G) x ≠ (χ : PontryaginDual G) y)
    (χ : PontryaginDual G) :
    χ ∈ H := by
  by_contra hχ
  have hint (p : C(G, ℂ)) : Integrable (fun g => (χ g : ℂ)⁻¹ * p g) μ := by
    refine Integrable.of_bound
      ((continuous_subtype_val.comp χ.continuous).inv₀ (fun g => (χ g).coe_ne_zero) |>.mul p.continuous).aestronglyMeasurable
      ‖p‖ (ae_of_all _ fun g => ?_)
    simpa only [norm_mul, norm_inv, Circle.norm_coe, inv_one, one_mul] using p.norm_coe_le_norm g
  let L : C(G, ℂ) →ₗ[ℂ] ℂ :=
    { toFun := fun p => ∫ g, (χ g : ℂ)⁻¹ * p g ∂μ
      map_add' := fun p q => by
        simp only [ContinuousMap.add_apply, mul_add]
        exact integral_add (hint p) (hint q)
      map_smul' := fun c p => by
        simp only [ContinuousMap.smul_apply, smul_eq_mul, RingHom.id_apply]
        rw [← integral_const_mul]
        congr 1
        funext g
        ring }
  let Lc : C(G, ℂ) →L[ℂ] ℂ := L.mkContinuous 1 fun p => by
    calc
      ‖L p‖ ≤ ‖p‖ * μ.real univ :=
        norm_integral_le_of_norm_le_const (ae_of_all _ fun g => by
          simpa only [norm_mul, norm_inv, Circle.norm_coe, inv_one, one_mul]
            using p.norm_coe_le_norm g)
      _ = 1 * ‖p‖ := by simp
  have hspan : span ℂ (range (fun η : H => complexMap (η : PontryaginDual G))) ≤
      LinearMap.ker (Lc : _ →ₗ[ℂ] ℂ) := by
    rw [Submodule.span_le]
    rintro _ ⟨η, rfl⟩
    have hne : χ⁻¹ * (η : PontryaginDual G) ≠ 1 := by
      intro he
      have heq : χ = (η : PontryaginDual G) := inv_mul_eq_one.mp he
      apply hχ
      rw [heq]
      exact η.property
    change (∫ g, (χ g : ℂ)⁻¹ * ((η : PontryaginDual G) g : ℂ) ∂μ) = 0
    have hz := integral_eq_zero μ (χ⁻¹ * (η : PontryaginDual G)) hne
    change (∫ g, (((χ g)⁻¹ * (η : PontryaginDual G) g : Circle) : ℂ) ∂μ) = 0 at hz
    simpa only [Circle.coe_mul, Circle.coe_inv] using hz
  have hker := Submodule.topologicalClosure_minimal _ hspan Lc.isClosed_ker
  rw [span_topologicalClosure_eq_top H hsep] at hker
  have hone : Lc (complexMap χ) = 0 := hker Submodule.mem_top
  have heval : Lc (complexMap χ) = 1 := by
    change (∫ g, (χ g : ℂ)⁻¹ * (χ g : ℂ) ∂μ) = 1
    simp
  exact one_ne_zero (heval.symm.trans hone)

end Integration

/-- A separating subgroup is the entire continuous dual of a compact Hausdorff group. -/
theorem eq_top_of_separates [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    (H : Subgroup (PontryaginDual G))
    (hsep : ∀ x y : G, x ≠ y →
      ∃ χ : H, (χ : PontryaginDual G) x ≠ (χ : PontryaginDual G) y) : H = ⊤ := by
  let : MeasurableSpace G := borel G
  let : BorelSpace G := ⟨rfl⟩
  let μ : Measure G := Measure.haarMeasure ⊤
  let : IsProbabilityMeasure μ := ⟨by simpa [μ] using
    (Measure.haarMeasure_self (K₀ := (⊤ : TopologicalSpace.PositiveCompacts G)))⟩
  apply top_unique
  intro χ _
  exact mem_of_separates μ H hsep χ

end Langlands.HarmonicAnalysis.CompactCharacterCompleteness
