import Langlands.HarmonicAnalysis.Distribution.NormalizedChartDistribution
import Langlands.HarmonicAnalysis.Distribution.RealMatrixJacobian

/-! # Constant orbit derivatives in affine real matrix conjugation coordinates -/

noncomputable section

open Filter Function Set TopologicalSpace
open scoped ContDiff Distributions Matrix Matrix.Norms.Operator Topology

set_option autoImplicit false

namespace Langlands.HarmonicAnalysis.RealGeneralLinearDistribution

variable {n : ℕ} {E : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
local notation "Mat" => Matrix (Fin n) (Fin n) ℝ

/-- Generator of a constant direction in the affine conjugating frame `1 + J x`. -/
def affineConjugationGenerator (J : E →L[ℝ] Mat) (u x : E) : Mat :=
  J u * Ring.inverse (1 + J x)

theorem contDiffOn_affineConjugationGenerator {Ω : Opens E}
    (J : E →L[ℝ] Mat) (u : E) (hunit : ∀ x ∈ Ω, IsUnit (1 + J x)) :
    ContDiffOn ℝ ∞ (affineConjugationGenerator J u) Ω := by
  intro x hx
  obtain ⟨g, hg⟩ := hunit x hx
  have hJ : ContDiff ℝ ∞ (fun y => 1 + J y) := contDiff_const.add J.contDiff
  have hInv : ContDiffAt ℝ ∞ Ring.inverse (1 + J x) := hg ▸ contDiffAt_ringInverse ℝ g
  exact (contDiffAt_const.mul (hInv.comp x hJ.contDiffAt)).contDiffWithinAt

set_option backward.isDefEq.respectTransparency false in
theorem fderiv_affineConjugation_apply_of_base_derivative_zero (J : E →L[ℝ] Mat)
    {B : E → Mat} {x : E} (hx : IsUnit (1 + J x))
    (hB : DifferentiableAt ℝ B x) (u : E) (hu : fderiv ℝ B x u = 0) :
    let f (p : E) := (1 + J p) * B p * Ring.inverse (1 + J p)
    fderiv ℝ f x u = commutatorVectorCLM (affineConjugationGenerator J u x) (f x) := by
  obtain ⟨g, hg⟩ := hx
  let G (p : E) := 1 + J p
  let Q := (↑g⁻¹ : Mat)
  have hG : HasFDerivAt G J x := J.hasFDerivAt.const_add 1
  have hg' : G x = (g : Mat) := hg.symm
  have hQ : HasFDerivAt Ring.inverse (-(ContinuousLinearMap.mulLeftRight ℝ Mat Q Q)) (G x) := by
    rw [hg']
    exact hasFDerivAt_ringInverse (𝕜 := ℝ) g
  have hd := ((hG.fun_mul' hB.hasFDerivAt).fun_mul' (hQ.comp x hG)).fderiv
  simp only [Function.comp_apply] at hd
  change fderiv ℝ (fun p => G p * B p * Ring.inverse (G p)) x u =
    commutatorVectorCLM (J u * Ring.inverse (G x)) (G x * B x * Ring.inverse (G x))
  rw [hd]
  have hi : Ring.inverse (G x) = Q := by rw [hg', Ring.inverse_unit]
  simp only [add_apply, smul_apply, op_smul_eq_mul, smul_eq_mul, hu, mul_zero, zero_add, hi,
    commutatorVectorCLM_apply, sub_eq_add_neg]
  rw [hg']
  simp only [← mul_assoc]
  rw [mul_assoc (J u) Q (g : Mat), show Q * (g : Mat) = 1 from g.inv_val, mul_one]
  simp only [ContinuousLinearMap.comp_apply, neg_apply,
    ContinuousLinearMap.mulLeftRight_apply, mul_neg, ← mul_assoc]
  abel

variable [FiniteDimensional ℝ E]

variable {e : OpenPartialHomeomorph E (Matrix (Fin n) (Fin n) ℝ)}
  (he : ContDiffOn ℝ ∞ e e.source) (hei : ContDiffOn ℝ ∞ e.symm e.target)
  (L : E ≃L[ℝ] (Matrix (Fin n) (Fin n) ℝ)) {Ω : Opens E} (hΩ : Ω ≤ chartSource e)

/-- A constant chart direction generated by a smooth matrix-valued
commutator field is annihilated after Jacobian normalization. -/
theorem eval_jacobianNormalizedChartDistribution_conjugationDerivative_eq_zero
    (D : FullDistribution n) (hD : IsFullConjugationInvariant (n := n) D)
    (u : E) {M : E → Mat} (hM : ContDiffOn ℝ ∞ M Ω)
    (hu : ∀ x ∈ Ω, fderiv ℝ e x u = commutatorVectorCLM (M x) (e x))
    (f : 𝓓(Ω, ℝ)) :
    (jacobianNormalizedChartDistribution (X := Mat) (F := ℂ) he hei L hΩ D : 𝓓'(Ω, ℂ))
      (smoothVectorFieldDerivativeTest (contDiffOn_const (c := u)) f) = (0 : ℂ) := by
  classical
  let b := Module.Free.chooseBasis ℝ Mat
  let β (j : Module.Free.ChooseBasisIndex ℝ Mat) (x : E) := b.repr (M x) j
  let A (j : Module.Free.ChooseBasisIndex ℝ Mat) := commutatorVectorCLM (b j)
  have hβ (j : Module.Free.ChooseBasisIndex ℝ Mat) : ContDiffOn ℝ ∞ (β j) Ω :=
    (b.coord j).toContinuousLinearMap.contDiff.comp_contDiffOn hM
  refine eval_jacobianNormalizedChartDistribution_constantDerivative_eq_zero he hei L hΩ
    D A (fun j => trace_commutatorVectorCLM (b j)) ?_ u hβ ?_ f
  · intro j φ
    have h : smoothVectorFieldDerivativeTest (A j).contDiff.contDiffOn φ =
        fullConjugationDerivativeTest (b j) φ := by
      ext x
      exact (fullConjugationDerivativeTest_apply (b j) (φ : FullTest n) x).symm
    rw [h]
    exact eval_fullConjugationDerivativeTest_eq_zero D hD (b j) φ
  · intro x hx
    let K := LinearMap.mulRight ℝ (e x) - LinearMap.mulLeft ℝ (e x)
    have hsum : ∑ j, β j x • b j = M x := b.sum_repr (M x)
    calc
      fderiv ℝ e x u = K (M x) := hu x hx
      _ = ∑ j, β j x • A j (e x) := by
        rw [← hsum, map_sum]
        simp only [map_smul]
        rfl

/-- In affine conjugation coordinates, constant directions along which the
base matrix has zero derivative are killed by the normalized distribution. -/
theorem eval_jacobianNormalizedChartDistribution_affineOrbitDerivative_eq_zero
    (D : FullDistribution n) (hD : IsFullConjugationInvariant (n := n) D)
    (J : E →L[ℝ] Mat) {B : E → Mat} (hB : ContDiffOn ℝ ∞ B Ω)
    (hunit : ∀ x ∈ Ω, IsUnit (1 + J x))
    (heq : ∀ x ∈ Ω, e x = (1 + J x) * B x * Ring.inverse (1 + J x))
    (u : E) (hu : ∀ x ∈ Ω, fderiv ℝ B x u = 0) (f : 𝓓(Ω, ℝ)) :
    (jacobianNormalizedChartDistribution (X := Mat) (F := ℂ) he hei L hΩ D : 𝓓'(Ω, ℂ))
      (smoothVectorFieldDerivativeTest (contDiffOn_const (c := u)) f) = (0 : ℂ) := by
  refine eval_jacobianNormalizedChartDistribution_conjugationDerivative_eq_zero he hei L hΩ
    D hD u (contDiffOn_affineConjugationGenerator J u hunit) ?_ f
  intro x hx
  have hnear : (e : E → Mat) =ᶠ[𝓝 x] (fun p => (1 + J p) * B p * Ring.inverse (1 + J p)) := by
    filter_upwards [Ω.isOpen.mem_nhds hx] with p hp
    exact heq p hp
  rw [hnear.fderiv_eq, heq x hx]
  exact fderiv_affineConjugation_apply_of_base_derivative_zero J (hunit x hx)
    ((hB.contDiffAt (Ω.isOpen.mem_nhds hx)).differentiableAt (by simp)) u (hu x hx)

end Langlands.HarmonicAnalysis.RealGeneralLinearDistribution
