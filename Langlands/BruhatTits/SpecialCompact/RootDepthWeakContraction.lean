import Langlands.BruhatTits.SpecialCompact.UniformChamberConsequences
import Langlands.Geometry.Building.KPMoyPrasadFiltration
import Langlands.Geometry.Building.PositiveDepthFieldDescent
import Langlands.GroupScheme.Rational.RootSubgroupPositive
import Langlands.Representation.Jacquet.StandardCasselmanUniformAsymptotics

/-! # Weak-chamber preservation of the original root-depth generators -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Set
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building

namespace Langlands.BruhatTits.SpecialCompact

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {S : CommGroupScheme (Spec (CommRingCat.of F))}
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    {i : S.toGrp ⟶ G} [Mono i.hom.hom.left]
    (D : KPApartmentData i (localFieldOrder F))

/-- Nonnegative character order makes actual torus conjugation preserve the
specified original root filtration, at every real depth. -/
theorem torus_conj_mem_filtration_of_nonneg_order
    (x : D.Apartment) {a : characterLattice S} (ha : a ∈ relativeRoots i)
    (t : rationalPoints S.toGrp)
    (ht : 0 ≤ localFieldOrder F
      (rationalCharacterEval ((rationalCharacters.equivCharacterLattice S).symm a) t))
    {r : ℝ} {g : rationalPoints G} (hg : g ∈ D.filtration x a r) :
    rationalPoints.map i t * g * (rationalPoints.map i t)⁻¹ ∈
      D.filtration x a r := by
  have horder : -localFieldOrder F
      (rationalCharacterEval ((rationalCharacters.equivCharacterLattice S).symm a) t)⁻¹ =
      localFieldOrder F
        (rationalCharacterEval ((rationalCharacters.equivCharacterLattice S).symm a) t) := by
    simp only [localFieldOrder, map_inv, toAdd_inv, Int.cast_neg, neg_neg]
  have hval := x.isSplitTorusCompatible a ha t⁻¹ g hg.1
  simp only [map_inv, inv_inv] at hval
  rw [horder] at hval
  have htcentral : rationalPoints.map i t ∈ centralizerPoints i := by
    rw [← torusCentralizer_carrier_base]
    intro U b y
    change ((b ≫ t) ≫ i.hom.hom) * (y ≫ i.hom.hom) =
      (y ≫ i.hom.hom) * ((b ≫ t) ≫ i.hom.hom)
    rw [← MonObj.mul_comp, ← MonObj.mul_comp, mul_comm]
  have hroot := RelativeRoot.comp_mem_subgroup i a
    (G.innerIso (rationalPoints.map i t)).hom hg.1
  rw [(mem_centralizerPoints i).mp htcentral] at hroot
  refine ⟨?_, ?_⟩
  · simpa only [rootGroupPoints, comp_innerIso_hom, GroupScheme.constantPoint_self]
      using hroot
  · rw [hval]
    exact hg.2.trans (le_add_of_nonneg_right (WithTop.coe_nonneg.mpr ht))

/-- Preservation of every original generator gives preservation of the
subgroup they generate; no collection or product theorem is needed here. -/
theorem map_rootDepthGeneratedSubgroup_conj_le
    (x : D.Apartment) (Psi : Set (characterLattice S))
    (f : characterLattice S → ℝ) (hroots : Psi ⊆ relativeRoots i)
    (t : rationalPoints S.toGrp)
    (ht : ∀ a ∈ Psi, 0 ≤ localFieldOrder F
      (rationalCharacterEval ((rationalCharacters.equivCharacterLattice S).symm a) t)) :
    (rootDepthGeneratedSubgroup i x.val Psi f).map
      (MulAut.conj (rationalPoints.map i t)).toMonoidHom ≤
        rootDepthGeneratedSubgroup i x.val Psi f := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g hg
  obtain ⟨a, hg⟩ := Set.mem_iUnion.mp hg
  apply Subgroup.subset_closure
  apply Set.mem_iUnion.mpr
  refine ⟨a, ?_⟩
  exact torus_conj_mem_filtration_of_nonneg_order D x (hroots a.2) t (ht a a.2) hg

/-- The original character order on a common-uniformizer torus point is its
integral character/cocharacter pairing. -/
theorem localFieldOrder_latticeSection (c : cocharacterLattice S)
    (a : characterLattice S) :
    localFieldOrder F
      (rationalCharacterEval ((rationalCharacters.equivCharacterLattice S).symm a)
        (CocharacterUniformizer.latticeSection F S (Multiplicative.ofAdd c))) =
      (latticePairing S a c : ℝ) := by
  change ((Plancherel.rationalCharacterValuation S.toGrp
    (CocharacterUniformizer.latticeSection F S (Multiplicative.ofAdd c))).toAdd
      ((rationalCharacters.equivCharacterLattice S).symm a) : ℝ) = _
  exact_mod_cast CocharacterUniformizer.rationalCharacterValuation_latticeSection F S a c

variable (B : ValuationBuildingData G)

/-- The depth subgroup generated by precisely the positive roots outside
the selected standard Levi, retaining every selected root and its depth. -/
def standardRadicalDepth (x : B.Apartment) (nu : cocharacterLattice B.S)
    (J : Set (characterLattice B.S)) (r : ℝ) : Subgroup (rationalPoints G) :=
  rootDepthGeneratedSubgroup B.i x.val
    (positiveRelativeRoots B.i nu \ AddSubmonoid.closure J) (fun _ => r)

/-- Every original selected root generator belongs to the actual standard
radical, so the generated depth subgroup belongs to that radical. -/
theorem standardRadicalDepth_le_standardUnipotentPoints
    (x : B.Apartment) (nu : cocharacterLattice B.S)
    (J : Set (characterLattice B.S)) (r : ℝ) :
    standardRadicalDepth B x nu J r ≤ standardUnipotentPoints B.i nu J := by
  apply (Subgroup.closure_le _).mpr
  rintro g hg
  obtain ⟨a, hg⟩ := Set.mem_iUnion.mp hg
  change g ∈ (standardUnipotent B.i nu J).carrier (Over.mk (𝟙 _))
  rw [mem_standardUnipotent]
  intro zeta hzeta
  exact RelativeRoot.subgroup_le_dynamicUnipotent B.i zeta
    ((hzeta.pairing_pos_iff_not_mem_closure B.i nu a.2.1).mpr a.2.2)
    (Over.mk (𝟙 _)) hg.1

/-- The selected root-depth subgroup lies in the same original Moy–Prasad
group. This inclusion needs no filtration axioms or intersection theorem. -/
theorem standardRadicalDepth_le_moyPrasad
    (P : ParahoricBuildingData G) (Zf : P.CentralizerFiltration)
    (x : P.Apartment) (nu : cocharacterLattice P.S)
    (J : Set (characterLattice P.S)) (r : NNReal) :
    standardRadicalDepth P.toValuationBuildingData x nu J r ≤ Zf.moyPrasad x r := by
  apply (Subgroup.closure_le _).mpr
  rintro g hg
  obtain ⟨a, hg⟩ := Set.mem_iUnion.mp hg
  exact Zf.filtration_le_moyPrasad x ⟨a, a.2.1.1⟩ r hg

/-- Each weak component-chamber point preserves the original generated
standard-radical depth subgroup, at every apartment point and real depth. -/
theorem map_standardRadicalDepth_conj_le
    (x : B.Apartment) (nu : cocharacterLattice B.S)
    {J : Set (characterLattice B.S)} (hJ : J ⊆ simpleRelativeRoots B.i nu)
    {A : CommGroupScheme (Spec (CommRingCat.of F))} {q : A.toGrp ⟶ B.S.toGrp}
    (hA : IsCompatibleStandardSplitComponent B.i nu J A q)
    {m : rationalPoints G} (hm : m ∈ standardComponentCAplus B.i nu J q)
    (r : ℝ) :
    (standardRadicalDepth B x nu J r).map (MulAut.conj m).toMonoidHom ≤
      standardRadicalDepth B x nu J r := by
  let : Smooth G.X.hom := B.isConnectedReductive.smooth
  obtain ⟨c, rfl, -, hc⟩ := hA.exists_eq_uniformizerPowers hJ hm
  apply map_rootDepthGeneratedSubgroup_conj_le B.apartment x _ _
    (fun _ ha => ha.1.1)
  intro a ha
  rw [Plancherel.RenardCartan.uniformizerSection_eq_latticeSection,
    localFieldOrder_latticeSection]
  exact_mod_cast positiveRelativeRoots_induction B.i nu
    (P := fun b => 0 ≤ latticePairing B.S b c) hc
    (fun _ _ _ _ hb hd => by simpa using add_nonneg hb hd) ha.1

omit [Mono i.hom.hom.left] in
/-- Inversion carries the weak chamber to the reversed chamber with the
same actual component, just as for the published epsilon chambers. -/
theorem inv_mem_standardComponentCAplus_reversed
    (nu : cocharacterLattice S) {J : Set (characterLattice S)}
    {A : CommGroupScheme (Spec (CommRingCat.of F))} {q : A.toGrp ⟶ S.toGrp}
    (hneg : ∀ a ∈ relativeRoots i, -a ∈ relativeRoots i)
    {m : rationalPoints G} (hm : m ∈ standardComponentCAplus i nu J q) :
    m⁻¹ ∈ standardComponentCAplus i (-nu) (Neg.neg '' J) q := by
  obtain ⟨t, ht, rfl⟩ := hm
  refine ⟨t⁻¹, ⟨(CocharacterUniformizer.CA F A).inv_mem ht.1, ?_⟩, ?_⟩
  · intro b hb
    rw [standardParabolicComponentCharacters_reversed i nu hneg] at hb
    obtain ⟨a, ha, rfl⟩ := hb
    rw [componentCharacterNorm_neg_inv]
    exact ht.2 a ha
  · exact map_inv (rationalPoints.map (q ≫ i)) t

/-- Exact identification of the two literal radical intersections with
the original generated depth subgroups gives weak-chamber preservation. -/
theorem weakChamberContraction_of_intersection_eq_standardRadicalDepth
    (x : B.Apartment) (nu : cocharacterLattice B.S)
    (hnu : IsGenericCocharacter B.i nu)
    {J : Set (characterLattice B.S)} (hJ : J ⊆ simpleRelativeRoots B.i nu)
    {A : CommGroupScheme (Spec (CommRingCat.of F))} {q : A.toGrp ⟶ B.S.toGrp}
    (hA : IsCompatibleStandardSplitComponent B.i nu J A q)
    (K : Subgroup (rationalPoints G)) (r : ℝ)
    (hpos : K ⊓ standardUnipotentPoints B.i nu J = standardRadicalDepth B x nu J r)
    (hneg : K ⊓ standardOppositeUnipotentPoints B.i nu J =
      standardRadicalDepth B x (-nu) (Neg.neg '' J) r) :
    WeakChamberContraction K (standardUnipotentPoints B.i nu J)
      (standardOppositeUnipotentPoints B.i nu J) (standardComponentCAplus B.i nu J q) := by
  intro m hm
  have hroots := relativeRootNegation F G B.isConnectedReductive B.S B.i
    B.isMaximalSplitTorus
  have hJrev : Neg.neg '' J ⊆ simpleRelativeRoots B.i (-nu) := by
    rintro _ ⟨a, ha, rfl⟩
    exact neg_mem_simpleRelativeRoots B.i nu hroots (hJ ha)
  have hrev := map_standardRadicalDepth_conj_le B x (-nu) hJrev
    (hA.reversed B.i nu B.isConnectedReductive B.isMaximalSplitTorus hnu hJ)
    (inv_mem_standardComponentCAplus_reversed nu hroots hm) r
  constructor
  · rintro _ ⟨g, hg, rfl⟩
    rw [hpos] at hg ⊢
    exact map_standardRadicalDepth_conj_le B x nu hJ hA hm r
      (Subgroup.mem_map.mpr ⟨g, hg, rfl⟩)
  · rintro _ ⟨g, hg, rfl⟩
    rw [hneg] at hg ⊢
    exact hrev (Subgroup.mem_map.mpr ⟨g, hg, rfl⟩)

end Langlands.BruhatTits.SpecialCompact
