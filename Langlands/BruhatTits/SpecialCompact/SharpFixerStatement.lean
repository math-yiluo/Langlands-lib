import Langlands.Geometry.Building.KPBuilding
import Langlands.GroupScheme.Reductive.Basic

/-!
# The sharp fixer of an apartment point lies in its compact stabilizer

The part of `P_x ⊆ K_0` that is expressible with the current objects:
`G(F)^♯_x ⊆ G(F)^1 ∩ G(F)_x` (KP Definition 7.4.1 and Theorem 4.2.15).
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.GroupScheme Langlands.Geometry.Building

namespace Langlands.BruhatTits.SpecialCompact

/-- For every connected reductive `G` over a nonarchimedean local field with a maximal split
torus `i : S → G`, all valid apartment data `D` and every point `x` of the reduced apartment, the
group `G(F)^♯_x` generated by the root fixers `U_{a,x,0}` lies in
`K_x = G(F)^1 ∩ G(F)_x = D.compactStabilizer (D.apartmentMap x)`. -/
def SharpFixerLeCompactStabilizer : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (i : S.toGrp ⟶ G)
    (hi : IsMaximalSplitTorus i),
    haveI : IsAffineHom G.X.hom := hG.isAffineHom
    haveI : Mono i.hom.hom.left := hi.isSplitSubtorus.mono
    ∀ (D : KPApartmentData i (localFieldOrder F)) (x : D.Apartment),
      D.sharpFixer {x} ≤ D.compactStabilizer (D.apartmentMap x)

end Langlands.BruhatTits.SpecialCompact
