import Langlands.BruhatTits.Unipotent.CompactOpenContainmentProof

/-! # Open normal subgroups contain dynamic unipotent points -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open Langlands.AlgebraicGeometry.PointTopology
open scoped CategoryTheory.MonObj

namespace Langlands.BruhatTits.RationalPoints

open DynamicUnipotentContainment

variable {F : Type u} [Field F]

/-- The subgroup generated by the actual dynamic unipotent points of all rational
cocharacters. This definition makes no assertion about algebraic derived points. -/
def dynamicUnipotentGeneratedSubgroup
    (G : GroupScheme (Spec (CommRingCat.of F))) : Subgroup (RationalPoint F G.X) :=
  ⨆ χ : (GroupScheme.Gm (Spec (CommRingCat.of F))).toGrp ⟶ G, unipotentPoints χ

variable [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffine G.X.left]

local instance : TopologicalSpace (RationalPoint F G.X) := rationalPointTopology F G.X

/-- Every open normal subgroup contains the actual dynamic unipotent points attached
 to any rational cocharacter. -/
theorem unipotentPoints_le_openNormal
    (χ : (GroupScheme.Gm (Spec (CommRingCat.of F))).toGrp ⟶ G)
    (N : OpenSubgroup (RationalPoint F G.X)) [N.toSubgroup.Normal] :
    unipotentPoints χ ≤ N.toSubgroup := by
  intro x hx
  let x' : unipotentPoints χ := ⟨x, hx⟩
  obtain ⟨t, ht⟩ := exists_conj_mem χ N {x'} isCompact_singleton
  have hc := ht x' (Set.mem_singleton x')
  have hback := (inferInstance : N.toSubgroup.Normal).conj_mem _ hc (cocharPoint χ t)⁻¹
  simpa [mul_assoc, x'] using hback

/-- An ambient homomorphism with open kernel kills actual dynamic unipotent points.
No commutativity or torsion-freeness hypothesis on the codomain is needed. -/
theorem unipotentPoints_le_openKernel {A : Type v} [Group A]
    (χ : (GroupScheme.Gm (Spec (CommRingCat.of F))).toGrp ⟶ G)
    (f : RationalPoint F G.X →* A) (hf : IsOpen (f.ker : Set (RationalPoint F G.X))) :
    unipotentPoints χ ≤ f.ker :=
  unipotentPoints_le_openNormal χ ⟨f.ker, hf⟩

/-- The subgroup generated by all dynamic unipotent points lies in every open normal
subgroup of the ambient point group. -/
theorem dynamicUnipotentGeneratedSubgroup_le_openNormal
    (N : OpenSubgroup (RationalPoint F G.X)) [N.toSubgroup.Normal] :
    dynamicUnipotentGeneratedSubgroup G ≤ N.toSubgroup :=
  iSup_le fun χ => unipotentPoints_le_openNormal χ N

/-- An ambient homomorphism with open kernel kills the subgroup generated by every
actual dynamic unipotent radical. -/
theorem dynamicUnipotentGeneratedSubgroup_le_openKernel {A : Type v} [Group A]
    (f : RationalPoint F G.X →* A) (hf : IsOpen (f.ker : Set (RationalPoint F G.X))) :
    dynamicUnipotentGeneratedSubgroup G ≤ f.ker :=
  iSup_le fun χ => unipotentPoints_le_openKernel χ f hf

end Langlands.BruhatTits.RationalPoints
