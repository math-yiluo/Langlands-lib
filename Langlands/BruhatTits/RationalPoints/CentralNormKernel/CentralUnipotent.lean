import Langlands.BruhatTits.RationalPoints.CentralNormKernel.CentralAlgebra
import Langlands.BruhatTits.RationalPoints.CentralNormKernel.CentralFiniteness
import Langlands.GroupScheme.Torus.SplitReductiveProof
import Langlands.GroupScheme.Reductive.Semisimple

/-! # Finiteness of central unipotent rational points

Over an algebraically closed field, let `G` be an affine group scheme of finite type with
trivial unipotent radical, with a closed linear embedding `ρ`. The central rational points whose
matrices are unipotent form a finite set.

Choose spectral data for the commutative algebra generated by the central matrices, and let `S`
be the kernel, on a closed representative of the centre, of the product of the block-determinant
characters. A rational point of `S` has block determinants `1`; on each block its matrix has one
eigenvalue `c`, and `c ^ a = 1` with `1 ≤ a ≤ N`. So every eigenvalue is an `N!`-th root of unity
and `S` has finitely many rational points. A central unipotent point has eigenvalue `1` on every
block, hence lies in `S`. -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix
open Langlands.GroupScheme Langlands.GroupScheme.CentralIntersection

namespace Langlands.BruhatTits.RationalPoints.CentralNormKernel

variable {K : Type u} [Field K] [IsAlgClosed K] {G : GroupScheme (Spec (CommRingCat.of K))}
  {N : Type} [Fintype N] [DecidableEq N]

/-- **Finiteness of central unipotent points.** -/
theorem finite_centralUnipotent [IsAffine G.X.left] [LocallyOfFiniteType G.X.hom]
    (hG : HasTrivialUnipotentRadical G) {Z : GroupScheme (Spec (CommRingCat.of K))}
    (z : Z ⟶ G) (hz : IsSchemeTheoreticCenter z) (ρ : MatrixRepresentation G N)
    [IsClosedImmersion ρ.hom.hom.left] :
    {g : rationalPoints G | g ∈ (center G).carrier (Over.mk (𝟙 _)) ∧
      IsNilpotent ((ρ.rationalMatrix g : Matrix N N K) - 1)}.Finite := by
  obtain ⟨D⟩ := nonempty_spectralData K (CentralAlgebra ρ)
  let I := ULift.{u} (Fin D.r)
  let Φ : G ⟶ splitTorus (Spec (CommRingCat.of K)) I :=
    Pi.lift fun i : I => blockChar D i.down
  have : IsAffineHom (splitTorus (Spec (CommRingCat.of K)) I).X.hom :=
    isAffineHom_splitTorus _ I
  have : IsClosedImmersion z.hom.hom.left := hz.1
  let S := GroupScheme.kernel (z ≫ Φ)
  let s : S ⟶ G := kernelι (z ≫ Φ) ≫ z
  have hs : IsClosedSubgroup s := by
    change IsClosedImmersion ((kernelι (z ≫ Φ)).hom.hom.left ≫ z.hom.hom.left)
    infer_instance
  have hzc : IsCentral z := fun T x => by
    have : x ≫ z.hom.hom ∈ (SubgroupFunctor.range z).carrier T :=
      SubgroupFunctor.mem_range.2 ⟨x, rfl⟩
    rwa [hz.2] at this
  have hc : IsCentral s := hzc.comp (kernelι (z ≫ Φ))
  -- The components of `Φ` at a rational point.
  have hΦπ : ∀ (g : rationalPoints G) (i : I),
      g ≫ Φ.hom.hom ≫ (Pi.π (fun _ : I => (Gm (Spec (CommRingCat.of K))).toGrp) i).hom.hom =
        g ≫ (blockChar D i.down).hom.hom := by
    intro g i
    rw [← Grp.comp_hom_hom]
    exact congrArg (fun φ : G ⟶ (Gm (Spec (CommRingCat.of K))).toGrp => g ≫ φ.hom.hom)
      (Pi.lift_comp_π (fun i : I => blockChar D i.down) i)
  have hΦ_eq_one : ∀ g : rationalPoints G, g ≫ Φ.hom.hom = 1 ↔
      ∀ i : Fin D.r, g ≫ (blockChar D i).hom.hom = 1 := by
    intro g
    constructor
    · intro h i
      rw [← hΦπ g ⟨i⟩, ← Category.assoc, h, MonObj.one_comp]
    · intro h
      apply (piPointsEquiv (fun _ : I => (Gm (Spec (CommRingCat.of K))).toGrp)
        (Over.mk (𝟙 _))).injective
      rw [map_one]
      funext i
      rw [piPointsEquiv_apply, Category.assoc, hΦπ g i, h i.down]
      rfl
  -- Block determinants of a central point.
  have hdet : ∀ (g : rationalPoints G) (hg : g ∈ (center G).carrier (Over.mk (𝟙 _)))
      (i : Fin D.r), ∃ a : ℕ, 1 ≤ a ∧ a ≤ Fintype.card N ∧
        ((ρ.rationalMatrix g : Matrix N N K) * blockIdem D i + (1 - blockIdem D i)).det =
          D.χ i (centralElement ρ hg) ^ a := by
    intro g hg i
    obtain ⟨a, ha1, haN, ha⟩ := D.det_block (centralVal ρ) (centralVal_injective ρ)
      (centralElement ρ hg) i
    rw [centralVal_block, centralVal_centralElement] at ha
    exact ⟨a, ha1, haN, ha⟩
  have heig : ∀ y : rationalPoints S,
      ∀ c ∈ (ρ.rationalMatrix (y ≫ s.hom.hom) : Matrix N N K).charpoly.roots,
        c ^ (Fintype.card N).factorial = 1 := by
    intro y c hc'
    set g := y ≫ s.hom.hom with hgdef
    have hg : g ∈ (center G).carrier (Over.mk (𝟙 _)) := hc _ y
    have hker : g ≫ Φ.hom.hom = 1 := by
      have h := (kernelPointsEquiv (z ≫ Φ) (Over.mk (𝟙 _)) y).2
      change (y ≫ (kernelι (z ≫ Φ)).hom.hom) ≫ (z ≫ Φ).hom.hom = 1 at h
      rw [hgdef]
      simpa only [s, Grp.comp_hom_hom, Category.assoc] using h
    obtain ⟨i, hi⟩ := D.exists_eq_of_isRoot (centralVal ρ) (x := centralElement ρ hg)
      (Polynomial.isRoot_of_mem_roots hc')
    obtain ⟨a, ha1, haN, ha⟩ := hdet g hg i
    have h1 := ((hΦ_eq_one g).1 hker i)
    rw [blockChar_eq_one_iff, ha, hi] at h1
    obtain ⟨b, hb⟩ := Nat.dvd_factorial ha1 haN
    rw [hb, pow_mul, h1, one_pow]
  have hfin : Finite (rationalPoints S) :=
    finite_rationalPoints_of_eigenvalues s hG hs hc ρ (Nat.factorial_ne_zero _) heig
  refine (Set.finite_range fun y : rationalPoints S => y ≫ s.hom.hom).subset ?_
  rintro g ⟨hg, hnil⟩
  have hgz : g ∈ (SubgroupFunctor.range z).carrier (Over.mk (𝟙 _)) := by rwa [hz.2]
  obtain ⟨w, hw⟩ := SubgroupFunctor.mem_range.1 hgz
  have hχ : ∀ i, D.χ i (centralElement ρ hg) = 1 := by
    intro i
    refine D.χ_eq_one_of_isNilpotent ?_ i
    refine SpectralData.isNilpotent_of_map (centralVal ρ) (centralVal_injective ρ) ?_
    rwa [map_sub, map_one, centralVal_centralElement]
  have hgΦ : g ≫ Φ.hom.hom = 1 := by
    refine (hΦ_eq_one g).2 fun i => ?_
    obtain ⟨a, -, -, ha⟩ := hdet g hg i
    rw [blockChar_eq_one_iff, ha, hχ i, one_pow]
  have hwk : w ∈ ((yonedaGrp.map (z ≫ Φ)).app (.op (Over.mk (𝟙 _)))).hom.ker := by
    change w ≫ (z ≫ Φ).hom.hom = 1
    rw [Grp.comp_hom_hom, ← Category.assoc, hw, hgΦ]
  refine ⟨(kernelPointsEquiv (z ≫ Φ) (Over.mk (𝟙 _))).symm ⟨w, hwk⟩, ?_⟩
  have h := congrArg Subtype.val
    ((kernelPointsEquiv (z ≫ Φ) (Over.mk (𝟙 _))).apply_symm_apply ⟨w, hwk⟩)
  rw [kernelPointsEquiv_val] at h
  change _ ≫ (kernelι (z ≫ Φ) ≫ z).hom.hom = g
  rw [Grp.comp_hom_hom, ← Category.assoc, h, hw]

end Langlands.BruhatTits.RationalPoints.CentralNormKernel
