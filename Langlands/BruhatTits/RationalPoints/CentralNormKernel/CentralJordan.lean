import Langlands.BruhatTits.RationalPoints.CentralNormKernel.CentralAlgebra
import Langlands.BruhatTits.RationalPoints.CentralNormKernel.Laurent
import Langlands.BruhatTits.RationalPoints.CentralNormKernel.PointLifting
import Mathlib.LinearAlgebra.Matrix.CharP

/-! # Jordan decomposition of central rational points

Let `ρ` be a closed linear embedding of an affine group scheme `G` over a field `K`, and fix
spectral data `(e i, χ i)` for the algebra generated by the matrices of central rational points.
For a central rational point `z` with eigenvalues `λ i = χ i (ρ z)`, the block-scalar matrix
`s = ∑ λ i E i` is the matrix of a central rational point `g`, and `g⁻¹ z` is a central rational
point with unipotent matrix. In characteristic `p` this uses `ρ (z ^ (q k)) = s ^ (q k)` for a
large power `q` of `p`; in characteristic zero it uses `ρ (z ^ k) = s ^ k u ^ k` with the
polynomial interpolation of `u ^ k`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix
open Langlands.GroupScheme Langlands.GroupScheme.CentralIntersection

namespace Langlands.BruhatTits.RationalPoints.CentralNormKernel

variable {K : Type u} [Field K] {G : GroupScheme (Spec (CommRingCat.of K))}
  {N : Type} [Fintype N] [DecidableEq N] {ρ : MatrixRepresentation G N}
  (D : SpectralData K (CentralAlgebra ρ))

theorem isUnit_centralElement {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) : IsUnit (centralElement ρ hz) := by
  refine IsUnit.of_mul_eq_one
    (centralElement ρ (((center G).carrier (Over.mk (𝟙 _))).inv_mem hz)) ?_
  apply Subtype.ext
  change (ρ.rationalMatrix z : Matrix N N K) * (ρ.rationalMatrix z⁻¹ : Matrix N N K) = 1
  rw [← Units.val_mul, ← map_mul, mul_inv_cancel, map_one, Units.val_one]

/-- The block eigenvalues of a central rational point, as units. -/
def blockEigenvalues {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    Fin D.r → Kˣ :=
  fun i => Units.mk0 (D.χ i (centralElement ρ hz)) (D.χ_ne_zero_of_isUnit (isUnit_centralElement hz) i)

/-- The block-scalar invertible matrix with the eigenvalues of a central rational point. -/
def semisimpleMatrix {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    GL N K :=
  diagHom (completeOrthogonalIdempotents_blockIdem D) K (blockEigenvalues D hz)

theorem semisimpleMatrix_val {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    (semisimpleMatrix D hz : Matrix N N K) =
      centralVal ρ (D.semisimplePart (centralElement ρ hz)) := by
  rw [semisimpleMatrix, diagHom_val, diagMatrix, SpectralData.semisimplePart,
    SpectralData.diag, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_mul, AlgHom.commutes, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  congr 1

/-- Entries of `s g` as sums over the blocks. -/
theorem semisimpleMatrix_mul_apply {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) (g : GL N K) (k l : N) :
    ((semisimpleMatrix D hz * g : GL N K) : Matrix N N K) k l =
      ∑ i, (blockEigenvalues D hz i : K) * (blockIdem D i * (g : Matrix N N K)) k l := by
  rw [Units.val_mul, semisimpleMatrix, diagHom_val, diagMatrix, Finset.sum_mul, Matrix.sum_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  have hid : (algebraMap K K).mapMatrix (blockIdem D i) = blockIdem D i := by
    ext a b
    rfl
  rw [hid, smul_mul_assoc, Matrix.smul_apply, smul_eq_mul]

theorem semisimpleMatrix_mem {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    (semisimpleMatrix D hz : Matrix N N K) ∈ Algebra.adjoin K (centralMatrices ρ) := by
  rw [semisimpleMatrix_val]
  exact (D.semisimplePart (centralElement ρ hz)).2

/-- The unipotent factor `s⁻¹ ρ(z)`. -/
def unipotentMatrix {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    GL N K :=
  (semisimpleMatrix D hz)⁻¹ * ρ.rationalMatrix z

theorem commute_semisimpleMatrix {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    Commute (semisimpleMatrix D hz) (ρ.rationalMatrix z) := by
  apply Units.ext
  change (semisimpleMatrix D hz : Matrix N N K) * ρ.rationalMatrix z =
    ρ.rationalMatrix z * (semisimpleMatrix D hz : Matrix N N K)
  rw [semisimpleMatrix_val, ← centralVal_centralElement ρ hz, ← map_mul, ← map_mul, mul_comm]

theorem semisimpleMatrix_mul_unipotentMatrix {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    semisimpleMatrix D hz * unipotentMatrix D hz = ρ.rationalMatrix z := by
  rw [unipotentMatrix, mul_inv_cancel_left]

theorem commute_unipotentMatrix {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    Commute (semisimpleMatrix D hz) (unipotentMatrix D hz) :=
  (Commute.refl _).inv_right.mul_right (commute_semisimpleMatrix D hz)

theorem isNilpotent_unipotentMatrix_sub_one {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    IsNilpotent ((unipotentMatrix D hz : Matrix N N K) - 1) := by
  have hnil : IsNilpotent ((ρ.rationalMatrix z : Matrix N N K) -
      (semisimpleMatrix D hz : Matrix N N K)) := by
    rw [semisimpleMatrix_val, ← centralVal_centralElement ρ hz, ← map_sub]
    exact (D.isNilpotent_sub_semisimplePart _).map (centralVal ρ)
  have heq : (unipotentMatrix D hz : Matrix N N K) - 1 =
      (((semisimpleMatrix D hz)⁻¹ : GL N K) : Matrix N N K) *
        ((ρ.rationalMatrix z : Matrix N N K) - (semisimpleMatrix D hz : Matrix N N K)) := by
    rw [unipotentMatrix, mul_sub, ← Units.val_mul, ← Units.val_mul, inv_mul_cancel,
      Units.val_one]
  have hcomm : Commute (((semisimpleMatrix D hz)⁻¹ : GL N K) : Matrix N N K)
      ((ρ.rationalMatrix z : Matrix N N K) - (semisimpleMatrix D hz : Matrix N N K)) := by
    have h' : Commute (((semisimpleMatrix D hz)⁻¹ : GL N K) : Matrix N N K)
        (ρ.rationalMatrix z : Matrix N N K) :=
      (commute_semisimpleMatrix D hz).inv_left.map (Units.coeHom _)
    exact h'.sub_right ((Commute.refl (semisimpleMatrix D hz)).inv_left.map (Units.coeHom _))
  rw [heq]
  exact hcomm.isNilpotent_mul_left hnil

section Closure

/-- In characteristic `p`, the semisimple matrix of a central point kills the kernel of the
coordinate pullback. -/
theorem classify_semisimpleMatrix_eq_zero_of_charP (p : ℕ) [hp : Fact p.Prime] [CharP K p]
    {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    ∀ f ∈ RingHom.ker (coordMap ρ),
      GeneralLinear.classify (R := K) (semisimpleMatrix D hz) f = 0 := by
  rcases isEmpty_or_nonempty N with hN | hN
  · intro f hf
    have : semisimpleMatrix D hz = ρ.rationalMatrix z := Subsingleton.elim _ _
    rw [this]
    exact classify_rationalMatrix_eq_zero ρ z hf
  obtain ⟨k, hk⟩ := isNilpotent_unipotentMatrix_sub_one D hz
  have hq : ∀ x y : K, x ^ p ^ k = y ^ p ^ k → x = y := fun x y h =>
    (iterateFrobenius K p k).injective h
  have hkq : k ≤ p ^ k :=
    (Nat.lt_two_pow_self).le.trans (Nat.pow_le_pow_left hp.out.two_le k)
  have hu : unipotentMatrix D hz ^ p ^ k = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    have h := sub_pow_char_pow_of_commute (R := Matrix N N K) p k
      (Commute.one_right (unipotentMatrix D hz : Matrix N N K))
    rw [one_pow, pow_eq_zero_of_le hkq hk] at h
    exact (sub_eq_zero.1 h.symm)
  refine classify_diagHom_eq_zero_of_pow (completeOrthogonalIdempotents_blockIdem D) hq
    fun k' f hf => ?_
  have hpow : diagHom (completeOrthogonalIdempotents_blockIdem D) K
      ((blockEigenvalues D hz ^ p ^ k) ^ k') = ρ.rationalMatrix (z ^ (p ^ k * k')) := by
    rw [← pow_mul, map_pow, map_pow ρ.rationalMatrix]
    change semisimpleMatrix D hz ^ (p ^ k * k') = _
    rw [← semisimpleMatrix_mul_unipotentMatrix D hz, (commute_unipotentMatrix D hz).mul_pow,
      pow_mul (unipotentMatrix D hz), hu, one_pow, mul_one]
  rw [hpow]
  exact classify_rationalMatrix_eq_zero ρ _ hf

/-- In characteristic zero, the semisimple matrix of a central point kills the kernel of the
coordinate pullback. -/
theorem classify_semisimpleMatrix_eq_zero_of_charZero [CharZero K]
    {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    ∀ f ∈ RingHom.ker (coordMap ρ),
      GeneralLinear.classify (R := K) (semisimpleMatrix D hz) f = 0 := by
  obtain ⟨m, hm⟩ := isNilpotent_unipotentMatrix_sub_one D hz
  have hm' : ((unipotentMatrix D hz : Matrix N N K) - 1) ^ (m + 1) = 0 := by
    rw [pow_succ, hm, zero_mul]
  refine classify_diagHom_eq_zero_of_unipotent (completeOrthogonalIdempotents_blockIdem D)
    (unipotentMatrix D hz) hm' fun k f hf => ?_
  have hpow : diagHom (completeOrthogonalIdempotents_blockIdem D) K (blockEigenvalues D hz ^ k) *
      unipotentMatrix D hz ^ k = ρ.rationalMatrix (z ^ k) := by
    rw [map_pow, map_pow ρ.rationalMatrix]
    change semisimpleMatrix D hz ^ k * _ = _
    rw [← (commute_unipotentMatrix D hz).mul_pow, semisimpleMatrix_mul_unipotentMatrix]
  rw [hpow]
  exact classify_rationalMatrix_eq_zero ρ _ hf

/-- A rational point whose matrix lies in the central algebra is central. -/
theorem mem_center_of_rationalMatrix_mem [Mono ρ.hom.hom] {g : rationalPoints G}
    (hg : (ρ.rationalMatrix g : Matrix N N K) ∈ Algebra.adjoin K (centralMatrices ρ)) :
    g ∈ (center G).carrier (Over.mk (𝟙 _)) := by
  intro T' a h
  have ha : a = toBase T' := by
    apply Over.OverMorphism.ext
    simpa [toBase] using Over.w a
  subst ha
  have hc := commute_scalarMap_of_mem ρ hg T' h
  rw [← pointMatrix_toBase] at hc
  change (toBase T' ≫ g) * h = h * (toBase T' ≫ g)
  apply MatrixRepresentation.pointMatrix_injective ρ T'
  rw [map_mul, map_mul]
  exact Units.ext hc.eq

/-- **Jordan decomposition of central points.** Every central rational point is the product of
the block-scalar matrix of its eigenvalues and the matrix of a central rational point with
unipotent matrix. -/
theorem exists_central_unipotent_decomposition [IsAffine G.X.left]
    [IsClosedImmersion ρ.hom.hom.left]
    {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    ∃ u : rationalPoints G, u ∈ (center G).carrier (Over.mk (𝟙 _)) ∧
      IsNilpotent ((ρ.rationalMatrix u : Matrix N N K) - 1) ∧
        ρ.rationalMatrix z = semisimpleMatrix D hz * ρ.rationalMatrix u := by
  have : Mono ρ.hom.hom := Over.mono_of_mono_left _
  have hker : ∀ f ∈ RingHom.ker (coordMap ρ),
      GeneralLinear.classify (R := K) (semisimpleMatrix D hz) f = 0 := by
    rcases CharP.exists' K with hK | ⟨p, hp, hK⟩
    · exact classify_semisimpleMatrix_eq_zero_of_charZero D hz
    · exact classify_semisimpleMatrix_eq_zero_of_charP D p hz
  obtain ⟨g, hg⟩ := exists_rationalMatrix_eq ρ _ hker
  have hgc : g ∈ (center G).carrier (Over.mk (𝟙 _)) := by
    refine mem_center_of_rationalMatrix_mem (ρ := ρ) ?_
    rw [hg]
    exact semisimpleMatrix_mem D hz
  refine ⟨g⁻¹ * z, ((center G).carrier _).mul_mem (((center G).carrier _).inv_mem hgc) hz,
    ?_, ?_⟩
  · rw [map_mul, map_inv, hg]
    exact isNilpotent_unipotentMatrix_sub_one D hz
  · rw [map_mul, map_inv, hg, mul_inv_cancel_left]

end Closure

end Langlands.BruhatTits.RationalPoints.CentralNormKernel
