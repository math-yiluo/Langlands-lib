import Langlands.BruhatTits.RationalPoints.CentralNormKernel.Decomposition
import Langlands.GroupScheme.Derived.CentralIntersection.BlockCharacter

/-! # The algebra generated by the matrices of central rational points

For a matrix representation `ρ` of a group scheme `G` over a field `K`, the matrices of the
central rational points commute, so they generate a commutative finite-dimensional subalgebra
of the matrix algebra. Every element of this algebra commutes with the matrix of every point of
`G` over every test scheme; hence each of its idempotents defines a block-determinant
character of `G`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Matrix
open Langlands.GroupScheme Langlands.GroupScheme.CentralIntersection

namespace Langlands.BruhatTits.RationalPoints.CentralNormKernel

variable {K : Type u} [Field K] {G : GroupScheme (Spec (CommRingCat.of K))}
  {N : Type} [Fintype N] [DecidableEq N] (ρ : MatrixRepresentation G N)

/-- The matrices of the central rational points. -/
def centralMatrices : Set (Matrix N N K) :=
  {M | ∃ z : rationalPoints G, z ∈ (center G).carrier (Over.mk (𝟙 _)) ∧
    (ρ.rationalMatrix z : Matrix N N K) = M}

theorem rationalMatrix_mem_centralMatrices {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    (ρ.rationalMatrix z : Matrix N N K) ∈ centralMatrices ρ :=
  ⟨z, hz, rfl⟩

theorem centralMatrices_commute :
    ∀ a ∈ centralMatrices ρ, ∀ b ∈ centralMatrices ρ, a * b = b * a := by
  rintro _ ⟨z, hz, rfl⟩ _ ⟨w, -, rfl⟩
  exact (((commute_of_mem_center hz w).map ρ.rationalMatrix).map (Units.coeHom _)).eq

/-- The commutative algebra generated by the matrices of the central rational points. -/
abbrev CentralAlgebra : Type u := Algebra.adjoin K (centralMatrices ρ)

theorem isMulCommutative_centralAlgebra : IsMulCommutative (CentralAlgebra ρ) :=
  Algebra.isMulCommutative_adjoin K fun a ha b hb _ => centralMatrices_commute ρ a ha b hb

instance : CommRing (CentralAlgebra ρ) :=
  { (inferInstance : Ring (CentralAlgebra ρ)) with
    mul_comm := fun a b => (isMulCommutative_centralAlgebra ρ).is_comm.comm a b }

/-- The inclusion of the central algebra into matrices. -/
abbrev centralVal : CentralAlgebra ρ →ₐ[K] Matrix N N K := (Algebra.adjoin K (centralMatrices ρ)).val

theorem centralVal_injective : Function.Injective (centralVal ρ) := Subtype.val_injective

/-- The element of the central algebra given by a central rational point. -/
def centralElement {z : rationalPoints G} (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    CentralAlgebra ρ :=
  ⟨ρ.rationalMatrix z, Algebra.subset_adjoin (rationalMatrix_mem_centralMatrices ρ hz)⟩

@[simp] theorem centralVal_centralElement {z : rationalPoints G}
    (hz : z ∈ (center G).carrier (Over.mk (𝟙 _))) :
    centralVal ρ (centralElement ρ hz) = (ρ.rationalMatrix z : Matrix N N K) := rfl

/-- Every element of the central algebra commutes with the matrix of every point over every test
scheme. -/
theorem commute_scalarMap_of_mem {M : Matrix N N K}
    (hM : M ∈ Algebra.adjoin K (centralMatrices ρ)) (T : Over (Spec (CommRingCat.of K)))
    (g : T ⟶ G.X) :
    Commute ((scalarMap T).mapMatrix M) (ρ.pointMatrix T g : Matrix N N Γ(T.left, ⊤)) := by
  induction hM using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨z, hz, rfl⟩ := hx
    have hxg : Commute (toBase T ≫ z) g := hz T (toBase T) g
    have hρ : Commute (ρ.pointMatrix T (toBase T ≫ z) : Matrix N N Γ(T.left, ⊤))
        (ρ.pointMatrix T g : Matrix N N Γ(T.left, ⊤)) :=
      (hxg.map (ρ.pointMatrix T)).map (Units.coeHom _)
    rwa [pointMatrix_toBase] at hρ
  | algebraMap c =>
    have hsc : (scalarMap T).mapMatrix (algebraMap K (Matrix N N K) c) =
        Matrix.scalar N (scalarMap T c) := by
      rw [Matrix.algebraMap_eq_diagonal, RingHom.mapMatrix_apply, Matrix.diagonal_map (map_zero _)]
      rfl
    rw [hsc]
    exact Matrix.scalar_commute (scalarMap T c) (fun r' => Commute.all _ r') _
  | add x y _ _ hx hy =>
    rw [map_add]
    exact hx.add_left hy
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact hx.mul_left hy

/-- At a rational point, the block matrix of `π` is `ρ(x) π + (1 - π)` with entries in `K`. -/
theorem mapMatrix_blockMatrix (π : Matrix N N K) (x : rationalPoints G) :
    (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom.mapMatrix (blockMatrix ρ π _ x) =
      (ρ.rationalMatrix x : Matrix N N K) * π + (1 - π) := by
  have hs : ∀ M : Matrix N N K, (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom.mapMatrix
      ((scalarMap (Over.mk (𝟙 (Spec (CommRingCat.of K))))).mapMatrix M) = M := by
    intro M
    ext a b
    exact scalarMap_base (R := CommRingCat.of K) (M a b)
  rw [blockMatrix, map_add, map_mul, map_sub, map_one, hs,
    MatrixRepresentation.rationalMatrix_apply]
  rfl

/-- At a rational point, the block determinant is `det (ρ(x) π + (1 - π))`. -/
theorem ΓSpecIso_det_blockMatrix (π : Matrix N N K) (x : rationalPoints G) :
    (Scheme.ΓSpecIso (CommRingCat.of K)).hom (blockMatrix ρ π _ x).det =
      ((ρ.rationalMatrix x : Matrix N N K) * π + (1 - π)).det := by
  rw [← mapMatrix_blockMatrix, ← RingHom.map_det]

variable {ρ}

section Blocks

variable (D : SpectralData K (CentralAlgebra ρ))

/-- The block idempotent matrices. -/
abbrev blockIdem (i : Fin D.r) : Matrix N N K := centralVal ρ (D.e i)

theorem completeOrthogonalIdempotents_blockIdem :
    CompleteOrthogonalIdempotents (blockIdem D) := by
  have h := CompleteOrthogonalIdempotents.map (centralVal ρ).toRingHom D.complete
  exact h

theorem blockIdem_mem (i : Fin D.r) : blockIdem D i ∈ Algebra.adjoin K (centralMatrices ρ) :=
  (D.e i).2

/-- The block-determinant character `g ↦ det (ρ(g) E i + (1 - E i))` of `G`. -/
def blockChar (i : Fin D.r) : G ⟶ (Gm (Spec (CommRingCat.of K))).toGrp :=
  blockCharacter (ρ := ρ) (completeOrthogonalIdempotents_blockIdem D |>.idem i)
    (fun T g => commute_scalarMap_of_mem ρ (blockIdem_mem D i) T g)

/-- At a rational point, the block character is trivial exactly when the block determinant is
`1`. -/
theorem blockChar_eq_one_iff (i : Fin D.r) (x : rationalPoints G) :
    x ≫ (blockChar D i).hom.hom = 1 ↔
      ((ρ.rationalMatrix x : Matrix N N K) * blockIdem D i + (1 - blockIdem D i)).det = 1 := by
  rw [← ΓSpecIso_det_blockMatrix, blockChar, comp_blockCharacter]
  constructor
  · intro h
    have hval := congrArg (fun u => (Gm.pointsEquiv (Spec (CommRingCat.of K)) _ u).val) h
    simp only [blockDetPoints_val, map_one, Units.val_one] at hval
    change (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom _ = 1
    rw [hval, map_one]
  · intro h
    apply (Gm.pointsEquiv (Spec (CommRingCat.of K)) (Over.mk (𝟙 _))).injective
    apply Units.ext
    rw [blockDetPoints_val, map_one, Units.val_one]
    apply (Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.injective
    rw [map_one]
    exact h

theorem centralVal_block (x : CentralAlgebra ρ) (i : Fin D.r) :
    centralVal ρ (D.block x i) = centralVal ρ x * blockIdem D i + (1 - blockIdem D i) := by
  simp only [SpectralData.block, map_add, map_mul, map_sub, map_one]

end Blocks

end Langlands.BruhatTits.RationalPoints.CentralNormKernel
