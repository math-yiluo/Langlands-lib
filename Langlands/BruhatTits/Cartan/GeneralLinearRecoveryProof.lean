/-!
# The `GL_N` Cartan decomposition from the general Cartan theorem

`Langlands.BruhatTits.Cartan.generalLinearCartanRecovery` proves
`GeneralLinearCartanRecoveryStatement`: the vertex comparison
`Geometry.Building.GeneralLinearVertexParahoricStatement` implies the concrete Cartan bijection
`SpecialCompact.GeneralLinearIntegralCartanStatement`. The proof goes through the general Cartan
theorem for one datum (`parahoricCartanConclusions_of_satisfiesGroupAxioms`, corrected KP
Theorem 5.2.1) and the existence of data (`Geometry.Building.groupAxiomsExistence`).

The supporting results are in the namespace `Langlands.BruhatTits.Cartan.GeneralLinearRecovery`:

* matrices of points of `GL_N`: `mem_K_iff`, `rationalPointsEquiv_diagonalTorus`,
  `columnSupported_of_mem_rootGroupPoints` (root subgroups of the diagonal torus),
  `isDiag_of_mem_torusCentralizer` and `exists_map_s_eq` (the centralizer of the diagonal torus);
* `le_closure_columnSupported`: an apartment parahoric `Z(F)^0 ⊔ G(F)^♯_x` of the diagonal torus
  is generated by elements whose matrices `g` have at most one nonzero entry in each column of
  `g - 1`;
* `exists_diagonal_parahoric`: a conjugate `g₀ K g₀⁻¹` of `K = GL_N(𝒪[F])` so generated is a
  conjugate `t K t⁻¹` by a point `t` of the diagonal torus;
* `bijective_of_cartan`: the Cartan conclusions for `P = t K t⁻¹` give the bijection of `C0Plus`
  onto `K \ G(F) / K`;
* `parahoric_facet_eq_parahoricAt`: the parahoric of the facet `{[x]}` is the apartment
  parahoric `P_x`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj ValuativeRel Pointwise
open Langlands.GroupScheme Langlands.Geometry.Building Langlands.Plancherel.RenardCartan

namespace Langlands.BruhatTits.Cartan.GeneralLinearRecovery

/-- `p ∈ g H g⁻¹` exactly when `g⁻¹ p g ∈ H`. -/
theorem mem_map_conj_iff {Γ : Type*} [Group Γ] (H : Subgroup Γ) (g p : Γ) :
    p ∈ H.map (MulAut.conj g).toMonoidHom ↔ g⁻¹ * p * g ∈ H := by
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply]

variable {F : Type u} [Field F] {N : ℕ}

local notation "G" => GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)
local notation "𝔻" => splitTorus.commGroupScheme (Spec (CommRingCat.of F)) (ULift (Fin N))
local notation "iD" => GeneralLinear.diagonalTorus (Fin N) (CommRingCat.of F)
local notation "φ" => GeneralLinear.rationalPointsEquiv N (CommRingCat.of F)
local notation "Kst" =>
  IntegralModel.integralPoints (GeneralLinear.standardIntegralModel 𝒪[F] F (Fin N))
local notation "coords" =>
  splitTorus.affinePointsEquiv (ULift (Fin N)) (𝟙 (Spec (CommRingCat.of F)))

/-! ### Matrices of points -/

/-- `K = GL_N(𝒪[F])` consists of the points whose matrix and inverse matrix are integral. -/
theorem mem_K_iff [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (g : rationalPoints (G)) :
    g ∈ Kst ↔ IsIntegral (ValuativeRel.valuation F) (φ g) := by
  rw [GeneralLinear.mem_standardIntegralModel_integralPoints_iff, mem_range_map_iff]

/-- The matrix of a point of the diagonal torus is the diagonal matrix of its coordinates. -/
theorem rationalPointsEquiv_diagonalTorus (τ : rationalPoints (𝔻).toGrp) :
    ((φ (rationalPoints.map iD τ) : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) =
      Matrix.diagonal fun i => ((coords τ ⟨i⟩ : Fˣ) : F) := by
  change ((GeneralLinear.glRingEquiv (GeneralLinear.globalSectionsEquiv (CommRingCat.of F))
      (GeneralLinear.pointsEquiv (Fin N) (CommRingCat.of F) _ (τ ≫ (iD).hom.hom)) : GL (Fin N) F) :
        Matrix (Fin N) (Fin N) F) = _
  rw [GeneralLinear.pointsEquiv_diagonalTorus]
  ext i j
  rw [GeneralLinear.glRingEquiv_apply, GeneralLinear.coe_diagonalTorusUnits]
  by_cases hij : i = j
  · subst hij
    simp only [Matrix.diagonal_apply_eq]
    rfl
  · simp [Matrix.diagonal_apply_ne _ hij]

/-- Points of a root subgroup of the diagonal torus have matrices `1 + e_a wᵀ`, so each column
of `g - 1` has at most one nonzero entry. -/
theorem columnSupported_of_mem_rootGroupPoints {α : characterLattice 𝔻}
    (hα : α ∈ relativeRoots iD) {u : rationalPoints (G)} (hu : u ∈ rootGroupPoints iD α) :
    ColumnSupported ((φ u : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) := by
  rw [GeneralLinear.relativeRoots_diagonalTorus] at hα
  obtain ⟨a, b, hab, hαab⟩ := hα
  let e : Fin N → ℤ := Pi.single a 1
  have hpair : 0 < latticePairing 𝔻 α
      ((splitTorus.cocharacterLatticeEquiv F (ULift (Fin N))).symm fun i => e i.down) := by
    rw [splitTorus.latticePairing_eq_sum, hαab, AddEquiv.apply_symm_apply]
    rw [Finset.sum_eq_single (ULift.up a)]
    · simp [e, ULift.ext_iff, hab]
    · intro c _ hc
      have hca : c.down ≠ a := fun h => hc (ULift.ext h)
      simp [e, Pi.single_apply, hca]
    · intro h
      exact absurd (Finset.mem_univ _) h
  have hsub := RelativeRoot.subgroup_le_dynamicUnipotent iD _ hpair (Over.mk (𝟙 _)) hu
  rw [GeneralLinear.cocharacterLatticeEquiv_symm_comp_diagonalTorus] at hsub
  have hmem := GeneralLinear.rationalPointsEquiv_mem_blockUnipotentSubgroup e u hsub
  have key : ∀ r j, ((φ u : GL (Fin N) F) - 1 : Matrix (Fin N) (Fin N) F) r j ≠ 0 → r = a := by
    intro r j hr
    by_contra hra
    apply hr
    rw [Matrix.sub_apply, sub_eq_zero]
    apply hmem
    have h0 : e r = 0 := by simp [e, hra]
    rw [h0]
    by_cases hja : j = a
    · subst hja
      simp [e]
    · simp [e, hja]
  intro i i' j hi hi'
  rw [key i j hi, key i' j hi']

/-- Points of the centralizer of the diagonal torus have diagonal matrices. -/
theorem isDiag_of_mem_torusCentralizer {g : rationalPoints (G)}
    (hg : g ∈ (torusCentralizer iD).carrier (Over.mk (𝟙 _))) :
    ((φ g : GL (Fin N) F) : Matrix (Fin N) (Fin N) F).IsDiag := by
  let e : Fin N → ℤ := fun i => (i.val : ℤ)
  have he : Function.Injective e := fun i j h => by
    have h' : ((i : ℕ) : ℤ) = ((j : ℕ) : ℤ) := h
    exact Fin.ext (by exact_mod_cast h')
  have h1 := torusCentralizer_le_dynamicCentralizer iD (CommGroupScheme.groupHom
    ((splitTorus.cocharacterLatticeEquiv F (ULift (Fin N))).symm fun i => e i.down)) _ hg
  rw [GeneralLinear.cocharacterLatticeEquiv_symm_comp_diagonalTorus,
    GeneralLinear.centralizer_diagonalCocharacter] at h1
  have h2 : φ g ∈ GeneralLinear.blockLeviSubgroup F e :=
    (GeneralLinear.glRingEquiv_mem_blockLeviSubgroup_iff e _).2 h1
  exact (GeneralLinear.mem_blockLeviSubgroup_iff_isDiag_of_injective he).1 h2

/-- Every point of the centralizer `Z` of the diagonal torus comes from the torus. -/
theorem exists_map_s_eq (C : CentralizerDatum iD) (z : rationalPoints C.Z) :
    ∃ τ : rationalPoints (𝔻).toGrp, rationalPoints.map C.s τ = z := by
  have hz : rationalPoints.map C.j z ∈ (torusCentralizer iD).carrier (Over.mk (𝟙 _)) := by
    rw [← C.isRepresentedBy.2]
    exact ⟨z, rfl⟩
  have hdiag := isDiag_of_mem_torusCentralizer hz
  obtain ⟨M, hM⟩ : ∃ M : GL (Fin N) F, M = φ (rationalPoints.map C.j z) := ⟨_, rfl⟩
  rw [← hM] at hdiag
  have hunit : ∀ i, (M : Matrix (Fin N) (Fin N) F) i i ≠ 0 := by
    intro i h0
    have h1 := congrArg (fun A : Matrix (Fin N) (Fin N) F => A i i)
      (show (M : Matrix (Fin N) (Fin N) F) * ((M⁻¹ : GL (Fin N) F) : Matrix (Fin N) (Fin N) F)
        = 1 by rw [← Units.val_mul, mul_inv_cancel, Units.val_one])
    simp only [Matrix.mul_apply, Matrix.one_apply_eq] at h1
    rw [Finset.sum_eq_single i (fun r _ hr => by rw [hdiag (Ne.symm hr), zero_mul])
      (fun h => absurd (Finset.mem_univ i) h), h0, zero_mul] at h1
    exact zero_ne_one h1
  obtain ⟨τ, hτ⟩ : ∃ τ : rationalPoints (𝔻).toGrp,
      τ = (coords).symm fun i => Units.mk0 _ (hunit i.down) := ⟨_, rfl⟩
  refine ⟨τ, ?_⟩
  have hj : rationalPoints.map iD τ = rationalPoints.map C.j z := by
    apply (φ).injective
    apply Units.ext
    rw [rationalPointsEquiv_diagonalTorus, ← hM, hτ]
    simp only [MulEquiv.apply_symm_apply, Units.val_mk0]
    exact hdiag.diagonal_diag
  have hcomp : rationalPoints.map C.s τ ≫ C.j.hom.hom = rationalPoints.map iD τ := by
    have h := congrArg (fun f : (𝔻).toGrp ⟶ G => f.hom.hom) C.comp_eq
    simp only [Grp.comp_hom_hom] at h
    rw [rationalPoints.map_apply, rationalPoints.map_apply, Category.assoc, h]
  have : Mono C.j.hom.hom := C.isRepresentedBy.1
  exact (cancel_mono C.j.hom.hom).mp (hcomp.trans hj)

/-- A diagonal matrix satisfies the column condition of `exists_diagonal_conj_bound`. -/
theorem columnSupported_of_isDiag {M : Matrix (Fin N) (Fin N) F} (hM : M.IsDiag) :
    ColumnSupported M := by
  have key : ∀ r j, (M - 1) r j ≠ 0 → r = j := by
    intro r j hr
    by_contra hrj
    apply hr
    rw [Matrix.sub_apply, hM hrj, Matrix.one_apply_ne hrj, sub_zero]
  intro i i' j hi hi'
  rw [key i j hi, key i' j hi']

/-- The `F`-points of `j : Z → G` have diagonal matrices. -/
theorem isDiag_map_j (C : CentralizerDatum iD) (z : rationalPoints C.Z) :
    ((φ (rationalPoints.map C.j z) : GL (Fin N) F) : Matrix (Fin N) (Fin N) F).IsDiag := by
  apply isDiag_of_mem_torusCentralizer
  rw [← C.isRepresentedBy.2]
  exact ⟨z, rfl⟩

theorem map_j_map_s (C : CentralizerDatum iD) (τ : rationalPoints (𝔻).toGrp) :
    rationalPoints.map C.j (rationalPoints.map C.s τ) = rationalPoints.map iD τ := by
  have h := congrArg (fun f : (𝔻).toGrp ⟶ G => f.hom.hom) C.comp_eq
  simp only [Grp.comp_hom_hom] at h
  rw [rationalPoints.map_apply, rationalPoints.map_apply, rationalPoints.map_apply,
    Category.assoc, h]

/-- The parahoric `Z(F)^0 ⊔ G(F)^♯_x` of a point of an apartment of the diagonal torus is
generated by elements satisfying the column condition, together with their inverses. -/
theorem le_closure_columnSupported (C : CentralizerDatum iD)
    (Z0 : Subgroup (rationalPoints C.Z)) {ω : Fˣ → ℝ} (A : KPApartmentData iD ω)
    (x : A.Apartment) (Q : Subgroup (rationalPoints (G)))
    (hQ : Q = Z0.map (rationalPoints.map C.j) ⊔ A.sharpFixer {x}) :
    Q ≤ Subgroup.closure {p | p ∈ Q ∧
      ColumnSupported ((φ p : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) ∧
      ColumnSupported ((φ p⁻¹ : GL (Fin N) F) : Matrix (Fin N) (Fin N) F)} := by
  subst hQ
  apply sup_le
  · rintro _ ⟨z, hz, rfl⟩
    apply Subgroup.subset_closure
    refine ⟨Subgroup.mem_sup_left ⟨z, hz, rfl⟩, columnSupported_of_isDiag (isDiag_map_j C z), ?_⟩
    rw [← map_inv]
    exact columnSupported_of_isDiag (isDiag_map_j C z⁻¹)
  · apply iSup_le
    intro α u hu
    apply Subgroup.subset_closure
    have hroot : u ∈ rootGroupPoints iD α := (A.mem_rootFixer.1 hu).1
    exact ⟨Subgroup.mem_sup_right (A.rootFixer_le_sharpFixer α {x} hu),
      columnSupported_of_mem_rootGroupPoints α.2 hroot,
      columnSupported_of_mem_rootGroupPoints α.2 ((rootGroupPoints iD α).inv_mem hroot)⟩

section LocalField

variable [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]

omit [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- The matrix of `t⁻¹ p t` for a point `t` of the diagonal torus. -/
theorem conj_diagonal_apply (τ : rationalPoints (𝔻).toGrp) (p : rationalPoints (G))
    (i j : Fin N) :
    ((φ ((rationalPoints.map iD τ)⁻¹ * p * rationalPoints.map iD τ) : GL (Fin N) F) :
      Matrix (Fin N) (Fin N) F) i j =
      (((coords τ ⟨i⟩)⁻¹ : Fˣ) : F) * ((φ p : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) i j *
        ((coords τ ⟨j⟩ : Fˣ) : F) := by
  rw [map_mul, map_mul, ← map_inv (rationalPoints.map iD), Units.val_mul, Units.val_mul,
    rationalPointsEquiv_diagonalTorus, rationalPointsEquiv_diagonalTorus, Matrix.mul_diagonal,
    Matrix.diagonal_mul, map_inv]
  rfl

theorem mem_map_conj_diagonal_iff (τ : rationalPoints (𝔻).toGrp) (p : rationalPoints (G)) :
    p ∈ (Kst).map (MulAut.conj (rationalPoints.map iD τ)).toMonoidHom ↔
      ∀ i j, ValuativeRel.valuation F ((((coords τ ⟨i⟩)⁻¹ : Fˣ) : F) *
          ((φ p : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) i j *
            ((coords τ ⟨j⟩ : Fˣ) : F)) ≤ 1 ∧
        ValuativeRel.valuation F ((((coords τ ⟨i⟩)⁻¹ : Fˣ) : F) *
          ((φ p⁻¹ : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) i j *
            ((coords τ ⟨j⟩ : Fˣ) : F)) ≤ 1 := by
  rw [mem_map_conj_iff, mem_K_iff]
  constructor
  · rintro ⟨h1, h2⟩ i j
    refine ⟨?_, ?_⟩
    · rw [← conj_diagonal_apply]
      exact h1 i j
    · rw [← conj_diagonal_apply, show (rationalPoints.map iD τ)⁻¹ * p⁻¹ *
          rationalPoints.map iD τ = ((rationalPoints.map iD τ)⁻¹ * p *
            rationalPoints.map iD τ)⁻¹ by group, map_inv]
      exact h2 i j
  · intro h
    refine ⟨fun i j => ?_, fun i j => ?_⟩
    · rw [conj_diagonal_apply]
      exact (h i j).1
    · rw [← map_inv, show ((rationalPoints.map iD τ)⁻¹ * p *
          rationalPoints.map iD τ)⁻¹ = (rationalPoints.map iD τ)⁻¹ * p⁻¹ *
            rationalPoints.map iD τ by group, conj_diagonal_apply]
      exact (h i j).2

/-- **A conjugate of `K` generated by column-supported elements is a diagonal conjugate.** If
`P = g₀ K g₀⁻¹` is generated by elements whose matrices (and those of their inverses) have
at most one nonzero off-identity entry in each column, then `P = t K t⁻¹` for a point `t` of
the diagonal torus. -/
theorem exists_diagonal_parahoric (P : Subgroup (rationalPoints (G))) (g₀ : rationalPoints (G))
    (hP : P = (Kst).map (MulAut.conj g₀).toMonoidHom)
    (hgen : P ≤ Subgroup.closure {p | p ∈ P ∧
      ColumnSupported ((φ p : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) ∧
      ColumnSupported ((φ p⁻¹ : GL (Fin N) F) : Matrix (Fin N) (Fin N) F)}) :
    ∃ τ : rationalPoints (𝔻).toGrp,
      P = (Kst).map (MulAut.conj (rationalPoints.map iD τ)).toMonoidHom := by
  obtain ⟨l, hl⟩ := exists_diagonal_conj_bound (v := ValuativeRel.valuation F) (φ g₀)
  obtain ⟨τ, hτ⟩ : ∃ τ : rationalPoints (𝔻).toGrp, τ = (coords).symm fun c => l c.down :=
    ⟨_, rfl⟩
  have hcoords : ∀ i : Fin N, coords τ ⟨i⟩ = l i := by
    intro i
    rw [hτ, MulEquiv.apply_symm_apply]
  refine ⟨τ, ?_⟩
  set t := rationalPoints.map iD τ with ht
  have hmemP : ∀ p, p ∈ P ↔ g₀⁻¹ * p * g₀ ∈ Kst := by
    intro p
    rw [hP]
    exact mem_map_conj_iff _ _ _
  have hbound : ∀ p, g₀⁻¹ * p * g₀ ∈ Kst →
      EntryBounded (ValuativeRel.valuation F)
        (((φ g₀)⁻¹ * φ p * φ g₀ : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) 1 := by
    intro p hp
    have h := ((mem_K_iff _).1 hp).1
    rwa [map_mul, map_mul, map_inv] at h
  -- `P ⊆ t K t⁻¹`
  have hle : P ≤ (Kst).map (MulAut.conj t).toMonoidHom := by
    refine hgen.trans ((Subgroup.closure_le _).2 ?_)
    rintro p ⟨hpP, hc1, hc2⟩
    have hp0 := (hmemP p).1 hpP
    have hp0' : g₀⁻¹ * p⁻¹ * g₀ ∈ Kst := by
      rw [show g₀⁻¹ * p⁻¹ * g₀ = (g₀⁻¹ * p * g₀)⁻¹ by group]
      exact (Kst).inv_mem hp0
    have hb1 := hl (φ p) (hbound p hp0) hc1
    have hb2 := hl (φ p⁻¹) (hbound p⁻¹ hp0') hc2
    show p ∈ (Kst).map (MulAut.conj (rationalPoints.map iD τ)).toMonoidHom
    rw [mem_map_conj_diagonal_iff]
    intro i j
    rw [hcoords, hcoords]
    exact ⟨hb1 i j, hb2 i j⟩
  -- `t K t⁻¹ ⊆ P`, from `k K k⁻¹ ⊆ K` for `k = t⁻¹ g₀`
  have hk : ∀ X : GL (Fin N) F, IsIntegral (ValuativeRel.valuation F) X →
      IsIntegral (ValuativeRel.valuation F) (φ (t⁻¹ * g₀) * X * (φ (t⁻¹ * g₀))⁻¹) := by
    intro X hX
    have hx : (φ).symm X ∈ Kst := by
      rw [mem_K_iff, MulEquiv.apply_symm_apply]
      exact hX
    have hPx : g₀ * (φ).symm X * g₀⁻¹ ∈ P := by
      rw [hmemP, show g₀⁻¹ * (g₀ * (φ).symm X * g₀⁻¹) * g₀ = (φ).symm X by group]
      exact hx
    have h := (mem_map_conj_iff _ _ _).1 (hle hPx)
    rw [mem_K_iff] at h
    rw [show t⁻¹ * (g₀ * (φ).symm X * g₀⁻¹) * t =
      (t⁻¹ * g₀) * (φ).symm X * (t⁻¹ * g₀)⁻¹ by group, map_mul, map_mul, map_inv,
      MulEquiv.apply_symm_apply] at h
    exact h
  refine le_antisymm hle ?_
  intro q hq
  have hq0 := (mem_map_conj_iff _ _ _).1 hq
  rw [mem_K_iff] at hq0
  have h := isIntegral_inv_mul_mul_of_conj hk _ hq0
  rw [hmemP, mem_K_iff]
  rw [← map_inv, ← map_mul, ← map_mul,
    show (t⁻¹ * g₀)⁻¹ * (t⁻¹ * q * t) * (t⁻¹ * g₀) = g₀⁻¹ * q * g₀ by group] at h
  exact h

/-- A point of the diagonal torus with unit coordinates lies in `K`. -/
theorem map_mem_K_of_coords (τ : rationalPoints (𝔻).toGrp)
    (h : ∀ c, ValuativeRel.valuation F (coords τ c : F) = 1) :
    rationalPoints.map iD τ ∈ Kst := by
  rw [mem_K_iff]
  refine ⟨fun i j => ?_, fun i j => ?_⟩
  · rw [rationalPointsEquiv_diagonalTorus, Matrix.diagonal_apply]
    split_ifs
    · rw [h]
    · rw [map_zero]
      exact zero_le
  · rw [← map_inv, ← map_inv, rationalPointsEquiv_diagonalTorus, Matrix.diagonal_apply]
    split_ifs
    · rw [map_inv, Pi.inv_apply, Units.val_inv_eq_inv_val, map_inv₀, h, inv_one]
    · rw [map_zero]
      exact zero_le

/-! ### Dominant centralizer points and `C0Plus` -/

/-- On the image of the diagonal torus, the normalized centralizer valuation is the valuation of
the torus coordinates. -/
theorem centralizerValuation_map_s (C : CentralizerDatum iD) (τ : rationalPoints (𝔻).toGrp) :
    centralizerValuation C.s C.bijective (rationalPoints.map C.s τ) =
      SplitTorusValuation.realValuation F (ULift (Fin N)) τ := by
  rw [← torusValuationRestriction_eq_split F (ULift (Fin N)) C.s C.bijective]
  rfl

theorem map_s_mem_dominant_iff (C : CentralizerDatum iD) (ν : cocharacterLattice 𝔻)
    (τ : rationalPoints (𝔻).toGrp) :
    rationalPoints.map C.s τ ∈ dominantCentralizer iD ν C.s C.bijective ↔
      (SplitTorusValuation.valuation F (ULift (Fin N)) τ).toAdd ∈
        nonnegativeCocharacters 𝔻 (positiveRelativeRoots iD ν) := by
  change (∀ α ∈ positiveRelativeRoots iD ν, 0 ≤ RealTorusSpace.eval 𝔻 α
      (centralizerValuation C.s C.bijective (rationalPoints.map C.s τ)).toAdd) ↔
    ∀ α ∈ positiveRelativeRoots iD ν,
      0 ≤ latticePairing 𝔻 α (SplitTorusValuation.valuation F (ULift (Fin N)) τ).toAdd
  rw [centralizerValuation_map_s]
  refine forall₂_congr fun α _ => ?_
  rw [SplitTorusValuation.realValuation_toAdd, RealTorusSpace.eval_latticeEmbedding]
  exact ⟨fun h => by exact_mod_cast h, fun h => by exact_mod_cast h⟩

theorem valuation_uniformizerSection (c : cocharacterLattice 𝔻) :
    (SplitTorusValuation.valuation F (ULift (Fin N))
      (uniformizerSection 𝔻 (Multiplicative.ofAdd c))).toAdd = c :=
  SplitTorusValuation.valuation_cocharacterPoints_uniformizer F (ULift (Fin N)) c

/-- **The Cartan bijection for `K` from the Cartan theorem for `P = t K t⁻¹`.** Let `Z` be the
centralizer of the diagonal torus, `Z0 ⊆ Z(F)` a subgroup of the norm-one kernel, and
`P = t K t⁻¹` with `t` a point of the diagonal torus. If `G(F) = P j(D) P` for the dominant set
`D ⊆ Z(F)` of `ν`, and two dominant points give the same `P`-double coset exactly when they
differ by `Z0`, then `C0Plus` represents `K \ G(F) / K` bijectively. -/
theorem bijective_of_cartan (C : CentralizerDatum iD) (Z0 : Subgroup (rationalPoints C.Z))
    (hZ0 : Z0 ≤ Plancherel.rationalCommonNormKernel C.Z) (P : Subgroup (rationalPoints (G)))
    (τ : rationalPoints (𝔻).toGrp)
    (hP : P = (Kst).map (MulAut.conj (rationalPoints.map iD τ)).toMonoidHom)
    (ν : cocharacterLattice 𝔻)
    (h1 : Set.univ = (P : Set (rationalPoints (G))) *
      (rationalPoints.map C.j '' dominantCentralizer iD ν C.s C.bijective) *
        (P : Set (rationalPoints (G))))
    (h2 : ∀ z z' : dominantCentralizer iD ν C.s C.bijective,
      DoubleCoset.doubleCoset (rationalPoints.map C.j z.val) P P =
          DoubleCoset.doubleCoset (rationalPoints.map C.j z'.val) P P ↔
        z'.val * z.val⁻¹ ∈ Z0) :
    Function.Bijective (fun a : C0Plus 𝔻 iD (positiveRelativeRoots iD ν) =>
      DoubleCoset.mk Kst Kst a.val) := by
  set t := rationalPoints.map iD τ with ht
  have hcomm : ∀ τ' : rationalPoints (𝔻).toGrp,
      t⁻¹ * rationalPoints.map iD τ' * t = rationalPoints.map iD τ' := by
    intro τ'
    have h : τ⁻¹ * τ' * τ = τ' := by
      apply (coords).injective
      rw [map_mul, map_mul, map_inv, mul_comm _ (coords τ), ← mul_assoc, mul_inv_cancel,
        one_mul]
    rw [ht, ← map_inv, ← map_mul, ← map_mul, h]
  have hmemP : ∀ p, p ∈ P ↔ t⁻¹ * p * t ∈ Kst := by
    intro p
    rw [hP]
    exact mem_map_conj_iff _ _ _
  have hdom : ∀ c ∈ nonnegativeCocharacters 𝔻 (positiveRelativeRoots iD ν),
      rationalPoints.map C.s (uniformizerSection 𝔻 (Multiplicative.ofAdd c)) ∈
        dominantCentralizer iD ν C.s C.bijective := by
    intro c hc
    rw [map_s_mem_dominant_iff, valuation_uniformizerSection]
    exact hc
  constructor
  · intro a b hab
    obtain ⟨c, hc, hca⟩ := (mem_C0Plus 𝔻 iD _ a.val).mp a.property
    obtain ⟨d, hd, hdb⟩ := (mem_C0Plus 𝔻 iD _ b.val).mp b.property
    obtain ⟨k, hk, l, hl, hkl⟩ := DoubleCoset.eq.mp hab
    have ha : t⁻¹ * a.val * t = a.val := by
      rw [← hca]
      exact hcomm _
    have hb : t⁻¹ * b.val * t = b.val := by
      rw [← hdb]
      exact hcomm _
    have hmem : b.val ∈ DoubleCoset.doubleCoset a.val P P := by
      rw [DoubleCoset.mem_doubleCoset]
      refine ⟨t * k * t⁻¹, (hmemP _).mpr ?_, t * l * t⁻¹, (hmemP _).mpr ?_, ?_⟩
      · rw [show t⁻¹ * (t * k * t⁻¹) * t = k by group]
        exact hk
      · rw [show t⁻¹ * (t * l * t⁻¹) * t = l by group]
        exact hl
      · calc b.val = t * (t⁻¹ * b.val * t) * t⁻¹ := by group
          _ = t * (k * (t⁻¹ * a.val * t) * l) * t⁻¹ := by rw [hb, ha, ← hkl]
          _ = t * k * t⁻¹ * a.val * (t * l * t⁻¹) := by group
    have hzeq := DoubleCoset.doubleCoset_eq_of_mem hmem
    let za : dominantCentralizer iD ν C.s C.bijective :=
      ⟨rationalPoints.map C.s (uniformizerSection 𝔻 (Multiplicative.ofAdd c)), hdom c hc⟩
    let zb : dominantCentralizer iD ν C.s C.bijective :=
      ⟨rationalPoints.map C.s (uniformizerSection 𝔻 (Multiplicative.ofAdd d)), hdom d hd⟩
    have hja : rationalPoints.map C.j za.val = a.val := by
      rw [map_j_map_s]
      exact hca
    have hjb : rationalPoints.map C.j zb.val = b.val := by
      rw [map_j_map_s]
      exact hdb
    have hZ := (h2 za zb).mp (by rw [hja, hjb]; exact hzeq.symm)
    have hval := (centralizerValuation_eq_iff C.s C.bijective za.val zb.val).mpr (hZ0 hZ)
    rw [centralizerValuation_map_s, centralizerValuation_map_s] at hval
    have hcd : c = d := by
      have h := congrArg Multiplicative.toAdd hval
      rw [SplitTorusValuation.realValuation_toAdd, SplitTorusValuation.realValuation_toAdd,
        valuation_uniformizerSection, valuation_uniformizerSection] at h
      exact RealTorusSpace.latticeEmbedding_injective F (ULift (Fin N)) h
    apply Subtype.ext
    rw [← hca, ← hdb, hcd]
  · intro q
    induction q using _root_.Quotient.inductionOn with
    | h g =>
      have hg : t * g * t⁻¹ ∈ (Set.univ : Set (rationalPoints (G))) := Set.mem_univ _
      rw [h1] at hg
      obtain ⟨y, hy, p₂, hp₂, hpg⟩ := Set.mem_mul.mp hg
      obtain ⟨p₁, hp₁, w, ⟨z, hz, rfl⟩, rfl⟩ := Set.mem_mul.mp hy
      obtain ⟨τ', hτ'⟩ := exists_map_s_eq C z
      have hzτ : rationalPoints.map C.j z = rationalPoints.map iD τ' := by
        rw [← hτ', map_j_map_s]
      obtain ⟨c, hcdef⟩ : ∃ c, c = (SplitTorusValuation.valuation F (ULift (Fin N)) τ').toAdd :=
        ⟨_, rfl⟩
      have hc : c ∈ nonnegativeCocharacters 𝔻 (positiveRelativeRoots iD ν) := by
        rw [hcdef, ← map_s_mem_dominant_iff, hτ']
        exact hz
      obtain ⟨τ₀, hτ₀def⟩ : ∃ τ₀, τ₀ = (uniformizerSection 𝔻 (Multiplicative.ofAdd c))⁻¹ * τ' :=
        ⟨_, rfl⟩
      have hτ₀ : τ₀ ∈ (SplitTorusValuation.valuation F (ULift (Fin N))).ker := by
        rw [MonoidHom.mem_ker, hτ₀def, map_mul, map_inv, inv_mul_eq_one]
        apply Multiplicative.toAdd.injective
        rw [valuation_uniformizerSection, hcdef]
      have hunits : ∀ c', ValuativeRel.valuation F (coords τ₀ c' : F) = 1 := by
        intro c'
        have h := (SplitTorusValuation.mem_valuation_ker F (ULift (Fin N)) τ₀).mp hτ₀ c'
        simpa only [FML.unitGroup, Valuation.mem_unitGroup_iff] using h
      have hK0 := map_mem_K_of_coords τ₀ hunits
      have hsplit : rationalPoints.map iD τ' =
          rationalPoints.map iD (uniformizerSection 𝔻 (Multiplicative.ofAdd c)) *
            rationalPoints.map iD τ₀ := by
        rw [← map_mul, hτ₀def, mul_inv_cancel_left]
      refine ⟨⟨rationalPoints.map iD (uniformizerSection 𝔻 (Multiplicative.ofAdd c)),
        (mem_C0Plus 𝔻 iD _ _).mpr ⟨c, hc, rfl⟩⟩, ?_⟩
      apply DoubleCoset.eq.mpr
      refine ⟨t⁻¹ * p₁ * t, (hmemP p₁).mp hp₁,
        rationalPoints.map iD τ₀ * (t⁻¹ * p₂ * t), mul_mem hK0 ((hmemP p₂).mp hp₂), ?_⟩
      calc g = t⁻¹ * (t * g * t⁻¹) * t := by group
        _ = t⁻¹ * (p₁ * rationalPoints.map C.j z * p₂) * t := by rw [hpg]
        _ = (t⁻¹ * p₁ * t) * (t⁻¹ * rationalPoints.map iD τ' * t) * (t⁻¹ * p₂ * t) := by
          rw [hzτ]
          group
        _ = _ := by
          rw [hcomm, hsplit]
          simp only [mul_assoc]

end LocalField

/-! ### The facet parahoric of a vertex of the apartment -/

/-- The parahoric `D.parahoric 𝓕` of the facet `𝓕 = {[x]}` of a point `x` of the apartment
(the neutral integral points of the facet model, by Axiom 4.1.20 the zero fixer of `𝓕`) is the
apartment parahoric `P_x`. -/
theorem parahoric_facet_eq_parahoricAt {F : Type u} [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {H : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom H.X.hom]
    (D : KPBuildingDatum H) (hD : D.SatisfiesGroupAxioms) (x : D.base.Apartment)
    (𝓕 : BruhatTits.IntegralModels.BuildingFacet D.base.toValuationBuildingData)
    (h𝓕 : 𝓕.val = {D.base.apartmentMap x}) :
    D.parahoric 𝓕 = D.base.parahoricAt x := by
  change (D.models.model
    (BruhatTits.IntegralModels.BuildingModelIndex.ofFacet 𝓕)).neutral.integralPoints = _
  rw [hD.bruhatTitsGroupSchemes.neutral_points]
  apply le_antisymm
  · intro g hg
    rw [BruhatTits.IntegralModels.BuildingModelFamily.zeroFixer, Subgroup.mem_inf] at hg
    apply hD.rootGroupAction.zeroFixerGenerators.zeroFixer_le_parahoric (Set.singleton_nonempty x)
      (fun f => by
        simpa only [Set.image_singleton] using (bddAbove_singleton : BddAbove ({f x} : Set ℝ)))
    rw [ParahoricBuildingData.mem_zeroFixer]
    refine ⟨hg.2, fun y hy => ?_⟩
    rw [Set.mem_singleton_iff] at hy
    subst hy
    apply (D.base.apartment.mem_pointwiseFixer.mp hg.1)
    change _ ∈ 𝓕.val
    rw [h𝓕]
    rfl
  · intro g hg
    have h := D.base.parahoric_le_zeroFixer hD.affineRootSystem.apartmentAxioms {x} hg
    rw [ParahoricBuildingData.mem_zeroFixer] at h
    rw [BruhatTits.IntegralModels.BuildingModelFamily.zeroFixer, Subgroup.mem_inf]
    refine ⟨D.base.apartment.mem_pointwiseFixer.mpr fun y hy => ?_, h.1⟩
    change y ∈ 𝓕.val at hy
    rw [h𝓕, Set.mem_singleton_iff] at hy
    subst hy
    exact h.2 x rfl

end Langlands.BruhatTits.Cartan.GeneralLinearRecovery

namespace Langlands.BruhatTits.Cartan

open GeneralLinearRecovery

/-- **The concrete `GL_N` Cartan decomposition from the general Cartan theorem.** The vertex
comparison `GeneralLinearVertexParahoricStatement`, applied to a datum of `GL_N` based at the
diagonal torus, identifies the parahoric of a special vertex `x` with a diagonal conjugate
`t K t⁻¹` of `K = GL_N(𝒪[F])`. The general Cartan theorem at `x`
(`parahoricCartanConclusions_of_satisfiesGroupAxioms`) is transported along `g ↦ t⁻¹ g t`, which
sends `P_x = t K t⁻¹` onto `K` and fixes the diagonal points; this gives the bijection of
`C0Plus` onto `K \ GL_N(F) / K`. -/
theorem generalLinearCartanRecovery : GeneralLinearCartanRecoveryStatement.{u} := by
  intro hprem F _ _ _ _ N ν i K hν
  obtain ⟨D, hD⟩ := groupAxiomsExistence F (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))
    (isConnectedReductive_generalLinear F (Fin N))
  obtain ⟨g, e, he⟩ := (maximalSplitTorusConjugacy F
    (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))
    (isConnectedReductive_generalLinear F (Fin N))).1 D.base.S
    (splitTorus.commGroupScheme (Spec (CommRingCat.of F)) (ULift (Fin N))) D.base.i
    (GeneralLinear.diagonalTorus (Fin N) (CommRingCat.of F))
    D.base.isMaximalSplitTorus (GeneralLinear.isMaximalSplitTorus_diagonalTorus F)
  let σ : D.base.S ≅ splitTorus.commGroupScheme (Spec (CommRingCat.of F)) (ULift (Fin N)) :=
    { hom := Additive.ofMul e.hom
      inv := Additive.ofMul e.inv
      hom_inv_id := congrArg Additive.ofMul e.hom_inv_id
      inv_hom_id := congrArg Additive.ofMul e.inv_hom_id }
  -- the transported datum, based at the diagonal torus
  let E := D.basedTransport σ
    ((GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)).innerIso g) he
  have hE : E.SatisfiesGroupAxioms := hD.basedTransport σ _ he
  -- a special vertex of the apartment and its facet
  have hΨ := hE.affineRootSystem.apartmentAxioms.isAffineRootSystem_affineRoots
  obtain ⟨x, hx⟩ := hΨ.exists_isSpecialPoint
  have hxv := AffineRootSystem.isVertex_of_isSpecialPoint hΨ hx
  let 𝓕 : BruhatTits.IntegralModels.BuildingFacet E.base.toValuationBuildingData :=
    ⟨E.base.apartmentMap '' {x}, E.base.isFacet_image ⟨x, hxv⟩⟩
  have h𝓕 : 𝓕.val = {E.base.apartmentMap x} := Set.image_singleton
  obtain ⟨g₀, hg₀⟩ := (hprem F N E hE).1 𝓕
    ⟨E.base.apartmentMap x, E.base.isVertex_apartmentMap hxv, h𝓕⟩
  rw [parahoric_facet_eq_parahoricAt E hE x 𝓕 h𝓕] at hg₀
  -- `P_x = t K t⁻¹` for a point `t` of the diagonal torus
  obtain ⟨τ, hτ⟩ := exists_diagonal_parahoric (E.base.parahoricAt x) g₀ hg₀
    (le_closure_columnSupported E.base.centralizer E.base.centralizerZero E.base.apartment x
      _ rfl)
  -- the general Cartan theorem at `x`
  have hC := parahoricCartanConclusions_of_satisfiesGroupAxioms E hE ν hν x ⟨hx, hxv⟩
  exact bijective_of_cartan E.base.centralizer E.base.centralizerZero
    E.base.zeroDatum.centralizerZero_le_rationalCommonNormKernel _ τ hτ ν hC.1 hC.2.1

end Langlands.BruhatTits.Cartan
