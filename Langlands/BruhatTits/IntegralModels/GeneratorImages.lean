import Langlands.BruhatTits.IntegralModels.RelativeComponent
import Langlands.GroupScheme.IntegralModel.HenselianReduction
import Langlands.GroupScheme.IntegralModel.CongruenceTower
import Mathlib.GroupTheory.Index

/-! # Transporting generated model images to generic points -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.IntegralModel

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]
  {G H : GroupScheme (Spec (CommRingCat.of K))}
  {M : IntegralModel R K H} {N : IntegralModel R K G} {f : H ⟶ G}

/-- A compatible model map identifies its section image after generic evaluation
with the specified generic map's image of integral points. -/
theorem Hom.map_sectionRange (φ : M.Hom N f) :
    ((rationalPoints.map φ.hom).range).map N.integralPointMap =
      M.integralPoints.map (rationalPoints.map f) := by
  rw [MonoidHom.map_range, integralPoints, MonoidHom.map_range]
  congr 1
  apply MonoidHom.ext
  intro x
  exact φ.integralPointMap_naturality x

variable {I : Type v}

/-- The subgroup generated by the integral-point images of a family of actual
models under specified generic homomorphisms. -/
def generatedIntegralImages
    (H' : I → GroupScheme (Spec (CommRingCat.of K)))
    (M' : ∀ j, IntegralModel R K (H' j)) (f' : ∀ j, H' j ⟶ G) :
    Subgroup (rationalPoints G) :=
  ⨆ j, (M' j).integralPoints.map (rationalPoints.map (f' j))

variable (N)
  (H' : I → GroupScheme (Spec (CommRingCat.of K)))
  (M' : ∀ j, IntegralModel R K (H' j))
  (f' : ∀ j, H' j ⟶ G) (φ' : ∀ j, (M' j).Hom N (f' j))

/-- Generic evaluation carries the subgroup generated by compatible section
images to the subgroup generated by their integral-point images. -/
theorem map_iSup_sectionRange :
    (⨆ j, (rationalPoints.map (φ' j).hom).range).map N.integralPointMap =
      generatedIntegralImages H' M' f' := by
  unfold generatedIntegralImages
  rw [Subgroup.map_iSup]
  apply iSup_congr
  intro j
  exact (φ' j).map_sectionRange

/-- Generic injectivity identifies that section subgroup with the full inverse
image of the generated subgroup of generic points. -/
theorem comap_iSup_integralPoints :
    (generatedIntegralImages H' M' f').comap N.integralPointMap =
      ⨆ j, (rationalPoints.map (φ' j).hom).range := by
  rw [← N.map_iSup_sectionRange H' M' f' φ']
  exact Subgroup.comap_map_eq_self_of_injective N.integralPointMap_injective _

/-- Finite index on full integral sections is exactly finite relative index in
all integral points of the target model. -/
theorem iSup_sectionRange_finiteIndex_iff :
    (⨆ j, (rationalPoints.map (φ' j).hom).range).FiniteIndex ↔
      (generatedIntegralImages H' M' f').IsFiniteRelIndex
        N.integralPoints := by
  rw [← N.comap_iSup_integralPoints H' M' f' φ', Subgroup.finiteIndex_iff,
    Subgroup.index_comap, Subgroup.isFiniteRelIndex_iff_relIndex_ne_zero]
  rfl

/-- Actual positive congruence containment can be checked in the generic group
without changing the section-generation condition. -/
theorem congruenceKernelAt_le_iSup_sectionRange_iff [IsLocalRing R] (m : ℕ+) :
    N.congruenceKernelAt m ≤ (⨆ j, (rationalPoints.map (φ' j).hom).range) ↔
      N.congruenceSubgroupAt m ≤
        generatedIntegralImages H' M' f' := by
  rw [← Subgroup.map_le_map_iff_of_injective N.integralPointMap_injective,
    N.map_iSup_sectionRange H' M' f' φ']
  rfl

end Langlands.GroupScheme.IntegralModel

namespace Langlands.BruhatTits.IntegralModels.RelativeComponentModelData

open Langlands.GroupScheme

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]
  {G : GroupScheme (Spec (CommRingCat.of K))}
  (D : RelativeComponentModelData R K G)

/-- A section-generation equality for the supplied relative component gives the
corresponding equality with its neutral integral-point subgroup. -/
theorem iSup_integralPoints_eq_neutral_of_sections {I : Type v}
    (H : I → GroupScheme (Spec (CommRingCat.of K)))
    (M : ∀ j, IntegralModel R K (H j)) (f : ∀ j, H j ⟶ G)
    (φ : ∀ j, (M j).Hom D.full (f j))
    (h : (⨆ j, (rationalPoints.map (φ j).hom).range) = D.neutralSections) :
    IntegralModel.generatedIntegralImages H M f =
      D.neutral.integralPoints := by
  rw [← D.full.map_iSup_sectionRange H M f φ, h]
  exact D.neutralPoints_eq

end Langlands.BruhatTits.IntegralModels.RelativeComponentModelData
