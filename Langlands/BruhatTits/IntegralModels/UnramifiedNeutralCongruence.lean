import Langlands.BruhatTits.IntegralModels.DepthZeroCompactOpen
import Langlands.BruhatTits.IntegralModels.IntegralCongruenceRootCentralizerGeneration
import Langlands.BruhatTits.IntegralModels.UnramifiedNeutralIncidentRadicalImage
import Langlands.BruhatTits.IntegralModels.IntegralOppositeNecessity
import Langlands.BruhatTits.IntegralModels.UnramifiedFacetSignDescent
import Langlands.BruhatTits.IntegralModels.ReductiveQuotientExistence
import Langlands.BruhatTits.IntegralModels.RelativeComponentFunctoriality
import Langlands.GroupScheme.Rational.RootRankOneFactorizationProof
import Langlands.Geometry.Building.ChamberRankOne

/-! # Strict root congruence and reduction preimages for actual neutral models -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.LocalGalois.Separable

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1200000

namespace Langlands.BruhatTits.IntegralModels



section Unramified

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
    [IsAffineHom G.X.hom]
    (C : MaximalUnramified.BuildingData F G)
    (M : RelativeComponentModelData (fixedFieldIntegers F) (inertiaFixedField F) G)
    (Ω : Set C.Apartment)
    (hM : M.full.integralPoints =
      characterValuationKernel (MaximalUnramified.valuation F) G ⊓
        C.pointwiseFixer (C.apartmentMap '' Ω))

include hM in
/-- Every prescribed congruence subgroup of the actual neutral model is
exactly generated by its actual generic root and torus-centralizer intersections. -/
theorem unramifiedNeutralRootCentralizerCongruencePoints_eq (n : ℕ+) :
    M.neutral.rootCentralizerCongruencePoints C.i n = M.neutral.congruenceSubgroupAt n := by
  let : Smooth M.neutral.group.X.hom := M.neutral_smooth
  let : GeometricallyConnected M.neutral.group.X.hom := M.neutral_geometricallyConnected
  exact (unramifiedNeutralSplitTorusData C M Ω hM).rootCentralizerCongruencePoints_eq
    C.isConnectedReductive C.isMaximalSplitTorus n

variable {Fa : Set C.Apartment}
    (hFa : AffineRootSystem.IsFacet C.affineRoots Fa)
    (hΩ : Ω.Nonempty) (hsub : Ω ⊆ Fa)

include hM hFa hΩ hsub in
/-- A root point reducing into the actual unipotent radical has strict depth
on every nonempty subset of one facet. Only integral opposite necessity is used. -/
theorem unramifiedNeutralPositivePoints_inf_rootGroupPoints_le_rootFixerPlus
    (Q : SpecialFibreQuotientData M) (hQ : Q.IsReductiveQuotient)
    (a : relativeRoots C.i) :
    Q.positivePoints ⊓ rootGroupPoints C.i a ≤ C.apartment.rootFixerPlus a Ω := by
  intro g hg
  by_contra hgplus
  obtain ⟨x, hx⟩ := hΩ
  have hgroot := hg.2
  have hgfix : g ∈ C.apartment.rootFixer a Ω := by
    rw [← rootGroupPoints_inf_unramifiedNeutral_eq_rootFixer C M Ω hM a]
    exact ⟨hgroot, Q.positivePoints_le_integralPoints hg.1⟩
  have hgval : (0 : WithTop ℝ) ≤ x.val a g :=
    ((C.apartment.mem_rootFixer.mp hgfix).2 x hx).2
  have hgval0 : x.val a g = (0 : WithTop ℝ) := by
    apply le_antisymm _ hgval
    apply not_lt.mp
    intro hpos
    apply hgplus
    rw [C.apartment.rootFixerPlus_eq_of_nonempty_subset_facet
      C.affineRoot_mem_or_two_smul_mem hFa ⟨x, hx⟩ hsub a,
      (C.apartment.rootFixer_eq_filtration_of_isFacet
        C.affineRoot_mem_or_two_smul_mem hFa (hsub hx) a.property).2]
    exact KPApartmentData.mem_filtrationPlus.mpr ⟨hgroot, hpos⟩
  have hg1 : g ≠ 1 := by
    intro he
    apply hgplus
    rw [he]
    exact one_mem _
  obtain ⟨p, hp⟩ :=
    ((rootRankOneFactorization (inertiaFixedField F) G C.isConnectedReductive
      C.S C.i C.isMaximalSplitTorus a a.property g hgroot hg1).1).exists
  have hneg : -a.val ∈ relativeRoots C.i := by
    rw [← hp.weylAction_eq_neg C.i C.isMaximalSplitTorus.isSplitSubtorus.1
      a.property.1 hgroot hg1]
    exact weylAction_mapsTo_relativeRoots C.i _ a.property
  have hrootint : C.apartment.rootFixer (-a.val) Ω ≤ M.neutral.integralPoints := by
    rw [← rootGroupPoints_inf_unramifiedNeutral_eq_rootFixer C M Ω hM ⟨-a.val, hneg⟩]
    exact inf_le_right
  have hp1int : p.1 ∈ M.neutral.integralPoints := by
    apply hrootint
    apply C.apartment.rootFixer_anti (-a.val) hsub
    rw [(C.apartment.rootFixer_eq_filtration_of_isFacet
      C.affineRoot_mem_or_two_smul_mem hFa (hsub hx) hneg).1]
    have h5 := x.isValuation.opposite a a.property g hgroot hg1
      p.1 hp.1 p.2 hp.2.1 hp.2.2
    rw [hgval0] at h5
    refine ⟨hp.1, ?_⟩
    simpa only [neg_zero, WithTop.coe_zero] using (withTop_eq_neg_of_add_eq_zero h5).ge
  have hp2int : p.2 ∈ M.neutral.integralPoints := by
    apply hrootint
    apply C.apartment.rootFixer_anti (-a.val) hsub
    rw [(C.apartment.rootFixer_eq_filtration_of_isFacet
      C.affineRoot_mem_or_two_smul_mem hFa (hsub hx) hneg).1]
    have h5 := x.isValuation.opposite_snd a.property hgroot hg1 hp.1 hp.2.1 hp.2.2
    rw [hgval0] at h5
    refine ⟨hp.2.1, ?_⟩
    simpa only [neg_zero, WithTop.coe_zero] using (withTop_eq_neg_of_add_eq_zero h5).ge
  let A := unramifiedNeutralSplitTorusData C M Ω hM
  exact A.toIntegralTorusData.not_mem_positivePoints_of_integral_oppositeFactors
    A.isSplit Q hQ C.isConnectedReductive C.isMaximalSplitTorus a.property.1
    hgroot hg1 hp.1 hp.2.1 hp.2.2 hp1int hp2int hg.1

local instance neutralCongruence_algClosed :
    IsAlgClosed (IsLocalRing.ResidueField (fixedFieldIntegers F)) :=
  (fixedFieldResidueIsAlgClosure F).1

include hM hFa hΩ hsub in
/-- The residue congruence intersection with every actual root is strict on a
nonempty subset of one facet, with no root-kernel comparison premise. -/
theorem unramifiedNeutralCongruence_inf_rootGroupPoints_le_rootFixerPlus
    (a : relativeRoots C.i) :
    M.neutral.congruenceSubgroup ⊓ rootGroupPoints C.i a ≤
      C.apartment.rootFixerPlus a Ω := by
  obtain ⟨Q, hQ⟩ := SpecialFibreQuotientData.exists_isReductiveQuotient M
  exact (inf_le_inf_right _ Q.congruenceSubgroup_le_positivePoints).trans
    (unramifiedNeutralPositivePoints_inf_rootGroupPoints_le_rootFixerPlus
      C M Ω hM hFa hΩ hsub Q hQ a)

include hM hFa hΩ hsub in
/-- The entire residue congruence subgroup is generated inside the full
actual neutral centralizer and the strict root fixers on the facet subset. -/
theorem unramifiedNeutralCongruence_le_positiveRootCentralizerGroup :
    M.neutral.congruenceSubgroup ≤
      unramifiedNeutralPositiveRootCentralizerGroup C M Ω hM := by
  let : Smooth M.neutral.group.X.hom := M.neutral_smooth
  let : GeometricallyConnected M.neutral.group.X.hom := M.neutral_geometricallyConnected
  let A := unramifiedNeutralSplitTorusData C M Ω hM
  rw [A.congruenceSubgroup_eq_roots_sup_centralizer
    C.isConnectedReductive C.isMaximalSplitTorus]
  apply sup_le
  · apply iSup_le
    intro a
    exact (unramifiedNeutralCongruence_inf_rootGroupPoints_le_rootFixerPlus
      C M Ω hM hFa hΩ hsub a).trans
        (le_sup_of_le_right (le_iSup (fun a : relativeRoots C.i =>
          C.apartment.rootFixerPlus a Ω) a))
  · have hcent :
        M.neutral.integralPoints ⊓ (torusCentralizer C.i).carrier
          (Over.mk (𝟙 (Spec (CommRingCat.of (inertiaFixedField F))))) =
          (unramifiedNeutralCentralizerModel C M Ω hM).integralPoints.map
            (rationalPoints.map C.centralizer.j) :=
      (A.centralizerModel_map_integralPoints_eq
        C.centralizer.j C.centralizer.isRepresentedBy).symm
    exact (inf_le_inf_right _ M.neutral.congruenceSubgroup_le_integralPoints).trans
      (hcent.le.trans le_sup_left)

variable
    (M' : RelativeComponentModelData (fixedFieldIntegers F) (inertiaFixedField F) G)
    (Ω' : Set C.Apartment)
    (hM' : M'.full.integralPoints =
      characterValuationKernel (MaximalUnramified.valuation F) G ⊓
        C.pointwiseFixer (C.apartmentMap '' Ω'))
    {Ca : Set C.Apartment}
    (hCa : AffineRootSystem.IsFacet C.affineRoots Ca)
    (hFaCa : AffineRootSystem.IsFaceOf C.affineRoots Fa Ca)
    (hsub' : Ω' ⊆ Ca)

include hM hM' hCa hFaCa hΩ hsub hsub' in
/-- The congruence subgroup of an actual neutral model on a nonempty facet
subset is integral in an incident source neutral model, without a generation premise. -/
theorem unramifiedNeutralIncidentCongruence_le_neutral_of_facet :
    M.neutral.congruenceSubgroup ≤ M'.neutral.integralPoints :=
  (unramifiedNeutralCongruence_le_positiveRootCentralizerGroup
    C M Ω hM hFaCa.1 hΩ hsub).trans
      (unramifiedNeutralIncidentGeneratedGroup_le_neutral
        C M M' Ω Ω' hM hM' hCa hFaCa hΩ hsub hsub')

local instance neutralCongruence_henselian :
    HenselianLocalRing (fixedFieldIntegers F) :=
  fixedFieldIntegersIsHenselian F

variable (φ : RelativeComponentModelHom M' M)

include hM hM' hCa hFaCa hΩ hsub hsub' in
/-- A full incident component-model comparison has the exact preimage of its
actual residue image, with congruence containment proved from the facet geometry. -/
theorem unramifiedNeutralIncident_hasParabolicReductionPreimage_of_facet :
    φ.HasParabolicReductionPreimage :=
  φ.hasParabolicReductionPreimage_of_congruence
    (unramifiedNeutralIncidentCongruence_le_neutral_of_facet
      C M Ω hM hΩ hsub M' Ω' hM' hCa hFaCa hsub')

/-- The actual source sections are the full reduction preimage of the actual
incident image, preserving the given section map and requiring no generation bound. -/
def unramifiedNeutralIncidentFacetReductionPreimageEquiv :
    M'.neutral.integralSections ≃*
      φ.specialFibreImagePoints.comap M.neutral.reduction :=
  φ.reductionPreimageMulEquiv
    (unramifiedNeutralIncidentCongruence_le_neutral_of_facet
      C M Ω hM hΩ hsub M' Ω' hM' hCa hFaCa hsub')

@[simp]
theorem unramifiedNeutralIncidentFacetReductionPreimageEquiv_apply
    (x : M'.neutral.integralSections) :
    (unramifiedNeutralIncidentFacetReductionPreimageEquiv
        C M Ω hM hΩ hsub M' Ω' hM' hCa hFaCa hsub' φ x :
      M.neutral.integralSections) = rationalPoints.map φ.neutral.hom x :=
  rfl

end Unramified

end Langlands.BruhatTits.IntegralModels
