import Langlands.BruhatTits.IntegralModels.GeneratorImages
import Langlands.GroupScheme.IntegralModel.ConnectedGeneration

/-! # Applying connected generation to a finite family of integral models -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.BruhatTits.IntegralModels

open GroupScheme

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]
  {G : GroupScheme (Spec (CommRingCat.of K))}

/-- A supplied finite family of smooth affine models with geometrically
connected fibres, together with actual compatible maps into one ambient model.
The structure asserts no existence of such models or maps. -/
structure FiniteConnectedModelFamily (N : IntegralModel R K G) where
  size : ℕ
  genericGroup : Fin size → GroupScheme (Spec (CommRingCat.of K))
  model : ∀ j, IntegralModel R K (genericGroup j)
  smooth : ∀ j, (model j).IsSmooth
  geometricallyConnected : ∀ j, (model j).HasGeometricallyConnectedFibres
  genericMap : ∀ j, genericGroup j ⟶ G
  modelMap : ∀ j, (model j).Hom N (genericMap j)

namespace FiniteConnectedModelFamily

variable {N : IntegralModel R K G} (A : FiniteConnectedModelFamily N)

/-- The subgroup generated by the specified generic images of all the
family's integral points. -/
def integralImages : Subgroup (rationalPoints G) :=
  IntegralModel.generatedIntegralImages A.genericGroup A.model A.genericMap

/-- Compatibility of the actual model maps places every generating image
inside the ambient model's integral points. -/
theorem integralImages_le_integralPoints :
    A.integralImages ≤ N.integralPoints := by
  apply iSup_le
  intro j g hg
  obtain ⟨h, hh, rfl⟩ := hg
  exact (A.modelMap j).map_mem_integralPoints hh

variable [IsDiscreteValuationRing R] [HenselianLocalRing R]
  [IsAlgClosed (IsLocalRing.ResidueField R)]

/-- Assuming the general connected-generation theorem, finite relative index
and containment of one actual positive congruence subgroup identify the
generated generic images with the neutral model's integral points. -/
theorem integralImages_eq_neutral
    (hgen : ConnectedGenerationStatement.{u})
    (D : RelativeComponentModelData R K G)
    (A : FiniteConnectedModelFamily D.full)
    (hindex : A.integralImages.IsFiniteRelIndex D.full.integralPoints)
    (hcongruence : ∃ m : ℕ+, D.full.congruenceSubgroupAt m ≤ A.integralImages) :
    A.integralImages = D.neutral.integralPoints := by
  apply D.iSup_integralPoints_eq_neutral_of_sections
    A.genericGroup A.model A.genericMap A.modelMap
  have hindex' :
      (⨆ j, (rationalPoints.map (A.modelMap j).hom).range).FiniteIndex :=
    (D.full.iSup_sectionRange_finiteIndex_iff
      A.genericGroup A.model A.genericMap A.modelMap).mpr hindex
  obtain ⟨m, hm⟩ := hcongruence
  have hcongruence' :
      ConnectedGeneration.sectionCongruenceKernel D.full.group m ≤
        ConnectedGeneration.generatedImages (fun j => (A.modelMap j).hom) :=
    (D.full.congruenceKernelAt_le_iSup_sectionRange_iff
      A.genericGroup A.model A.genericMap A.modelMap m).mpr hm
  exact hgen R D.full.group D.full_smooth A.size
    (fun j => (A.model j).group) A.smooth A.geometricallyConnected
    (fun j => (A.modelMap j).hom) hindex' ⟨m, hcongruence'⟩
    D.neutral.group D.inclusion.hom D.isRelativeComponent

end FiniteConnectedModelFamily

end Langlands.BruhatTits.IntegralModels
