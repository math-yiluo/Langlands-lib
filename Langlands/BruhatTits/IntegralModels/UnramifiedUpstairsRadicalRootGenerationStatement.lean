import Langlands.GroupScheme.IntegralModel.UnramifiedModelDescent
import Langlands.GroupScheme.IntegralModelReduction
import Langlands.GroupScheme.Reductive.UnipotentRadical
import Langlands.Geometry.Building.MaximalUnramifiedBuildingData
import Langlands.Geometry.Building.KPZeroSubgroups

/-! # The full radical preimage over maximal-unramified integers

The statement `UnramifiedUpstairsRadicalRootGenerationStatement` describes, for every smooth
model over the integers of `K = inertiaFixedField F` characterized by a nonempty subset of one
apartment facet, the entire preimage in `G(K)` of the actual unipotent radical of its special
fibre: it is generated by one fixed torus factor `H` and the positive root fixers
`U_{a,Ω,0+}` (derived from Kaletha–Prasad, Corollary 8.4.12, Theorem 8.4.10 and
Appendix B.10). -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped ValuativeRel CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.LocalGalois.Separable

namespace Langlands.BruhatTits.IntegralModels

/-- **Full upstairs radical preimages** (derived from Kaletha–Prasad Corollary 8.4.12,
Theorem 8.4.10, Corollary 8.4.5 and Lemma B.10.11).

Let `F` be a nonarchimedean local field, `K = inertiaFixedField F`, `O = fixedFieldIntegers F`,
`G` an affine `K`-group, `C` any maximal-unramified building datum for `G` and `E` any zero
datum for `G`. There is one subgroup `H` of `G(K)`, contained in the image of the centralizer
inclusion of `C` and in `G(K)^0` intersected with the pointwise fixer of the whole apartment
image, such that the following holds for every nonempty subset `Ω` of one facet of `C`'s
apartment, every smooth `O`-model `N` of `G` with integral points `G(K)^0 ∩ G(K)_Ω`
(pointwise fixer), and every represented unipotent radical `i : U ⟶ N.specialFibre`: the
image in `G(K)` of the integral points reducing into `U` is the subgroup generated by `H` and
all `U_{a,Ω,0+}`. The source's `H` is the image of `T(K)^{mc}_{0+}` for `T = Z_G(S)`; only its
existence is asserted. On the single-facet domain the source's union convention for
`U_{a,Ω,0+}` agrees with `rootFixerPlus`. -/
def UnramifiedUpstairsRadicalRootGenerationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F))))
    [IsAffineHom G.X.hom]
    (C : MaximalUnramified.BuildingData F G) (E : UnramifiedZeroDatum F G),
    ∃ H : Subgroup (rationalPoints G),
      H ≤ (rationalPoints.map C.centralizer.j).range ∧
      H ≤ E.zeroPoints ⊓ C.pointwiseFixer (Set.range C.apartmentMap) ∧
      ∀ (Ω : Set C.Apartment), Ω.Nonempty →
        (∃ x : C.Apartment, Ω ⊆ AffineRootSystem.facet C.affineRoots x) →
      ∀ (N : IntegralModel (fixedFieldIntegers F) (inertiaFixedField F) G),
        N.IsSmooth →
        N.integralPoints =
          E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω) →
      ∀ (U : GroupScheme
          (Spec (CommRingCat.of (IsLocalRing.ResidueField (fixedFieldIntegers F)))))
        (i : U ⟶ N.specialFibre), IsUnipotentRadical i →
        ((rationalPoints.map i).range.comap N.reduction).map N.integralPointMap =
          H ⊔ ⨆ a : relativeRoots C.i, C.apartment.rootFixerPlus a Ω

end Langlands.BruhatTits.IntegralModels
