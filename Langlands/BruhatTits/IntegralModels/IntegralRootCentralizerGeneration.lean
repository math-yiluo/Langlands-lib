import Langlands.BruhatTits.IntegralModels.IntegralTorusCentralizer
import Langlands.GroupScheme.Rational.LocalRootGeneration
import Langlands.GroupScheme.Rational.GenericTorusCocharacter
import Langlands.GroupScheme.Rational.RelativeRootSystemProof
import Langlands.GroupScheme.Torus.UnipotentQuotientMaximalSplit

/-! # Integral points generated by actual generic root and torus intersections -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 1600000

namespace Langlands.GroupScheme.SubgroupFunctor

/-- Restricting a section to a new base preserves membership in the actual
base-changed subgroup functor. -/
theorem baseChangeSectionHom_mem {B B' : Scheme.{u}} (b : B' ⟶ B)
    {G : GroupScheme B} (H : SubgroupFunctor G) {x : Over.mk (𝟙 B) ⟶ G.X}
    (hx : x ∈ H.carrier (𝟙_ (Over B))) :
    baseChangeSectionHom b G x ∈
      (H.baseChange b).carrier (𝟙_ (Over B')) := by
  rw [mem_baseChange]
  change baseChangeBasePointsEquiv b G
    ((baseChangeBasePointsEquiv b G).symm (_ ≫ x)) ∈ _
  rw [MulEquiv.apply_symm_apply]
  exact H.comp_mem _ hx

end Langlands.GroupScheme.SubgroupFunctor

namespace Langlands.GroupScheme.IntegralModel

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
    [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of K))}
    (N : IntegralModel R K G) (i : S.toGrp ⟶ G)

/-- The subgroup generated by the integral intersections with all actual
generic roots and with the whole generic torus centralizer. -/
def rootCentralizerIntegralPoints : Subgroup (rationalPoints G) :=
  (⨆ a : relativeRoots i, N.integralPoints ⊓ rootGroupPoints i a) ⊔
    (N.integralPoints ⊓ (torusCentralizer i).carrier (𝟙_ (Over _)))

theorem rootCentralizerIntegralPoints_le :
    N.rootCentralizerIntegralPoints i ≤ N.integralPoints := by
  apply sup_le
  · exact iSup_le fun _ => inf_le_left
  · exact inf_le_left

end Langlands.GroupScheme.IntegralModel

namespace Langlands.BruhatTits.IntegralModels

section Coordinate

variable {R K : Type u} [CommRing R] [IsDomain R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] [Field K]
    [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of K))}
    {i : S.toGrp ⟶ G}
    (N : IntegralModel R K G)
    [Smooth N.group.X.hom] [GeometricallyConnected N.group.X.hom]
    (I : Type u) [Fintype I] [DecidableEq I]
    (j : (splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I).toGrp ⟶ N.group)
    (e : splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I ≅ S)
    (hsq : splitTorus.baseChangeHom (K := K) N.group I j ≫ N.genericIso.hom =
      CommGroupScheme.groupHom e.hom ≫ i)

private instance : IsAffineHom N.genericFibre.X.hom :=
  inferInstanceAs (IsAffineHom (pullback.snd N.group.X.hom (Spec.algebraMap R K)))

private def groupIsoOfCommIso {B : Scheme.{u}} {T U : CommGroupScheme B}
    (e : T ≅ U) : T.toGrp ≅ U.toGrp where
  hom := CommGroupScheme.groupHom e.hom
  inv := CommGroupScheme.groupHom e.inv
  hom_inv_id := congrArg Additive.toMul e.hom_inv_id
  inv_hom_id := congrArg Additive.toMul e.inv_hom_id

include hsq in
private theorem coordinateRootCentralizer_le
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i) :
    N.integralPoints ≤ N.rootCentralizerIntegralPoints i := by
  classical
  let b := Spec.algebraMap R K
  let jK : (splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I).toGrp ⟶
      N.genericFibre := splitTorus.baseChangeHom (K := K) N.group I j
  have hmax' : IsMaximalSplitTorus (jK ≫ N.genericIso.hom) := by
    rw [hsq]
    exact hi.iso_comp (groupIsoOfCommIso e)
  have hmax : IsMaximalSplitTorus jK :=
    (IsMaximalSplitTorus.comp_iso_iff jK N.genericIso).mp hmax'
  let : Mono jK.hom.hom.left := hmax.isSplitSubtorus.mono
  have hroot := relativeRootSystem K N.genericFibre
    (hG.of_iso N.genericIso) _ jK hmax
  obtain ⟨νK, hνK⟩ :=
    (isSplitTorus_splitTorus (S := Spec (CommRingCat.of K)) I).exists_cocharacter_centralizer jK
  let ν : I → ℤ := splitTorus.cocharacterLatticeEquiv K I νK
  have hν : splitTorus.exponentCocharacter (Spec (CommRingCat.of K)) I ν = νK := by
    rw [splitTorus.exponentCocharacter_eq_cocharacterLatticeEquiv_symm]
    exact AddEquiv.symm_apply_apply _ _
  let χ := CommGroupScheme.groupHom
    (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ j
  have hχ : Dynamic.baseChangeCocharacter b χ =
      CommGroupScheme.groupHom νK ≫ jK := by
    rw [← hν]
    have h := splitTorus.groupHom_exponentCocharacter_baseChange
      (Spec (CommRingCat.of R)) I b ν
    rw [← h]
    change (Gm.baseChangeIso b).inv ≫
        (GroupScheme.baseChange b).map (_ ≫ j) =
      (Dynamic.baseChangeCocharacter b
        (CommGroupScheme.groupHom (splitTorus.exponentCocharacter _ I ν)) ≫
          (splitTorus.baseChangeIso b I).hom) ≫
        ((splitTorus.baseChangeIso b I).inv ≫ (GroupScheme.baseChange b).map j)
    simp only [Functor.map_comp, Dynamic.baseChangeCocharacter,
      Category.assoc, Iso.hom_inv_id_assoc]
  let Q := (N.rootCentralizerIntegralPoints i).comap N.integralPointMap
  have hQ : Q = ⊤ := by
    apply RelativeRoot.eq_top_of_exponentRoots_and_dynamicCentralizer
      (k := K) I j hroot ν Q
    · intro m hm x hx
      have hxK : baseChangeSectionHom b N.group x ∈
          ((RelativeRoot.subgroup
            (S := splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I) j
            (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I m)).baseChange b).carrier
              (Over.mk (𝟙 (Spec (CommRingCat.of K)))) :=
        SubgroupFunctor.baseChangeSectionHom_mem b _ (x := x) hx
      rw [← RelativeRoot.exponentRoot_subgroup_baseChange I j b m] at hxK
      let a := characterLattice.congr e
        (splitTorus.exponentCharacter (Spec (CommRingCat.of K)) I m)
      have ha : a ∈ relativeRoots i :=
        (roots_mem_of_transport_iff e N.genericIso hsq _).mpr hm
      have hxG : N.integralPointMap x ∈ rootGroupPoints i a :=
        RelativeRoot.comp_mem_subgroup_of_transport e N.genericIso.hom hsq _ hxK
      apply (le_sup_left : (⨆ a : relativeRoots i,
        N.integralPoints ⊓ rootGroupPoints i a) ≤ N.rootCentralizerIntegralPoints i)
      exact (le_iSup (fun a : relativeRoots i =>
        N.integralPoints ⊓ rootGroupPoints i a) ⟨a, ha⟩)
          ⟨⟨x, rfl⟩, hxG⟩
    · intro x hx
      have hxK : baseChangeSectionHom b N.group x ∈
          ((Dynamic.centralizer χ).baseChange b).carrier
            (Over.mk (𝟙 (Spec (CommRingCat.of K)))) :=
        SubgroupFunctor.baseChangeSectionHom_mem b _ (x := x) hx
      rw [← Dynamic.centralizer_baseChange, hχ, hνK] at hxK
      have hxG : N.integralPointMap x ∈
          (torusCentralizer i).carrier (𝟙_ (Over _)) := by
        have heq := torusCentralizer_eq_comap_of_iso_square
          jK i (groupIsoOfCommIso e) N.genericIso hsq
        rw [heq] at hxK
        exact hxK
      exact (le_sup_right : (N.integralPoints ⊓
        (torusCentralizer i).carrier (𝟙_ (Over _))) ≤ N.rootCentralizerIntegralPoints i)
          ⟨⟨x, rfl⟩, hxG⟩
  rintro _ ⟨x, rfl⟩
  exact show x ∈ Q from hQ ▸ Subgroup.mem_top x

end Coordinate

section IntegralTorus

variable {R K : Type u} [CommRing R] [IsDomain R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] [Field K]
    [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of K))}
    {i : S.toGrp ⟶ G} {N : IntegralModel R K G}
    [Smooth N.group.X.hom] [GeometricallyConnected N.group.X.hom]

namespace IntegralSplitTorusData

/-- Over a strictly Henselian local domain, a compatible integral split
torus gives generation by actual generic root and centralizer intersections. -/
theorem rootCentralizerIntegralPoints_eq (A : IntegralSplitTorusData N i)
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i) :
    N.rootCentralizerIntegralPoints i = N.integralPoints := by
  classical
  obtain ⟨I, hI, ⟨eR⟩⟩ := A.isSplit
  let : Fintype I := Fintype.ofFinite I
  let b := Spec.algebraMap R K
  let eR' : splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I ≅ A.torus :=
    CommGroupScheme.isoOfGroupIso eR.symm
  let eK : splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I ≅ S :=
    (splitTorus.commBaseChangeIso b I).symm ≪≫
      (CommGroupScheme.baseChange b).mapIso eR' ≪≫ A.genericIso
  let j := eR.inv ≫ A.inclusion
  have hsq : splitTorus.baseChangeHom (K := K) N.group I j ≫ N.genericIso.hom =
      CommGroupScheme.groupHom eK.hom ≫ i := by
    change (splitTorus.baseChangeIso b I).inv ≫
        (GroupScheme.baseChange b).map (eR.inv ≫ A.inclusion) ≫ N.genericIso.hom = _
    rw [Functor.map_comp, Category.assoc]
    change (splitTorus.baseChangeIso b I).inv ≫
      (GroupScheme.baseChange b).map eR.inv ≫ N.genericHom A.inclusion = _
    rw [A.generic_comm]
    rfl
  exact le_antisymm (N.rootCentralizerIntegralPoints_le i)
    (coordinateRootCentralizer_le N I j eK hsq hG hi)

end IntegralSplitTorusData

end IntegralTorus

end Langlands.BruhatTits.IntegralModels
