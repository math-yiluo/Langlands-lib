import Langlands.BruhatTits.IntegralModels.UnramifiedIncidentRootImage
import Langlands.GroupScheme.IntegralModel.SpecialFibreImageContainment
import Langlands.GroupScheme.Reductive.UnipotentRadical
import Langlands.AlgebraicGeometry.SmoothReducedProof

/-! # Conditional radical images for incident unramified facets -/

set_option maxHeartbeats 1600000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj ValuativeRel
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building.KPApartmentData

variable {k : Type u} [Field k]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]
  {ω : kˣ → ℝ} (D : KPApartmentData i ω)

/-- A nonempty part of one facet has the same positive root fixer as the
whole facet. -/
theorem rootFixerPlus_eq_of_nonempty_subset_facet
    (hAS4 : ∀ ψ ∈ D.extendedAffineRoots,
      ψ ∈ D.affineRoots ∨ (2 : ℝ) • ψ ∈ D.affineRoots)
    {Ω F : Set D.Apartment} (hF : AffineRootSystem.IsFacet D.affineRoots F)
    (hΩ : Ω.Nonempty) (hsub : Ω ⊆ F) (a : relativeRoots i) :
    D.rootFixerPlus a Ω = D.rootFixerPlus a F := by
  obtain ⟨x, hx⟩ := hΩ
  apply le_antisymm
  · rw [(D.rootFixer_eq_filtration_of_isFacet hAS4 hF (hsub hx) a.2).2]
    have h := D.rootFixerPlus_anti a (Set.singleton_subset_iff.mpr hx)
    rwa [D.rootFixerPlus_singleton] at h
  · exact D.rootFixerPlus_anti a hsub

/-- Positive root fixers on a nonempty part of the face lie in the zero
root fixers on every subset of the incident facet. -/
theorem rootFixerPlus_le_rootFixer_of_incidentFacets_of_subsets
    (hAS4 : ∀ ψ ∈ D.extendedAffineRoots,
      ψ ∈ D.affineRoots ∨ (2 : ℝ) • ψ ∈ D.affineRoots)
    {Ω Ω' F C : Set D.Apartment}
    (hC : AffineRootSystem.IsFacet D.affineRoots C)
    (hFC : AffineRootSystem.IsFaceOf D.affineRoots F C)
    (hΩ : Ω.Nonempty) (hsub : Ω ⊆ F) (hsub' : Ω' ⊆ C)
    (a : relativeRoots i) :
    D.rootFixerPlus a Ω ≤ D.rootFixer a Ω' := by
  obtain ⟨x, hx⟩ : C.Nonempty := by
    obtain ⟨x, hx⟩ := hC
    exact ⟨x, hx ▸ AffineRootSystem.mem_facet_self D.affineRoots x⟩
  rw [D.rootFixerPlus_eq_of_nonempty_subset_facet hAS4 hFC.1 hΩ hsub a]
  exact (D.rootFixer_comparison_of_incidentFacets hAS4 hC hFC hx a).1.trans
    ((D.rootFixerPlus_le_rootFixer a C).trans (D.rootFixer_anti a hsub'))

end Langlands.Geometry.Building.KPApartmentData

namespace Langlands.BruhatTits.IntegralModels

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
    [IsAffineHom G.X.hom]
    (C : MaximalUnramified.BuildingData F G) (E : UnramifiedZeroDatum F G)
    (Ω Ω' : Set C.Apartment)
    {Fa Ca : Set C.Apartment}
    (hCa : AffineRootSystem.IsFacet C.affineRoots Ca)
    (hFaCa : AffineRootSystem.IsFaceOf C.affineRoots Fa Ca)
    (hΩ : Ω.Nonempty) (hsub : Ω ⊆ Fa) (hsub' : Ω' ⊆ Ca)
    (H : Subgroup (rationalPoints G))
    (hH : H ≤ E.zeroPoints ⊓ C.pointwiseFixer (Set.range C.apartmentMap))

include hCa hFaCa hΩ hsub hsub' hH in
/-- The group generated by a common zero/full-apartment torus bound and the
positive face root fixers lies in the incident facet's zero fixer. -/
theorem unramifiedIncidentGeneratedGroup_le_zeroFixer :
    H ⊔ ⨆ a : relativeRoots C.i, C.apartment.rootFixerPlus a Ω ≤
      E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω') := by
  apply sup_le
  · intro g hg
    obtain ⟨hz, hf⟩ := hH hg
    refine ⟨hz, C.apartment.mem_pointwiseFixer.mpr ?_⟩
    rintro _ ⟨x, _, rfl⟩
    exact C.apartment.mem_pointwiseFixer.mp hf _ ⟨x, rfl⟩
  · apply iSup_le
    intro a
    have hroot : C.apartment.rootFixer a Ω' ≤
        E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω') := by
      rw [← rootGroupPoints_inf_unramifiedZeroFixer_eq_rootFixer C E Ω' a]
      exact inf_le_right
    exact (C.apartment.rootFixerPlus_le_rootFixer_of_incidentFacets_of_subsets
      C.affineRoot_mem_or_two_smul_mem hCa hFaCa hΩ hsub hsub' a).trans hroot

variable (N N' : IntegralModel (fixedFieldIntegers F) (inertiaFixedField F) G)
    (hN' : N'.integralPoints =
      E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω'))
    {U : GroupScheme
      (Spec (CommRingCat.of (IsLocalRing.ResidueField (fixedFieldIntegers F))))}
    (i : U ⟶ N.specialFibre)
    (hgen : ((rationalPoints.map i).range.comap N.reduction).map N.integralPointMap ≤
      H ⊔ ⨆ a : relativeRoots C.i, C.apartment.rootFixerPlus a Ω)

include hCa hFaCa hΩ hsub hsub' hH hN' hgen in
/-- A root-generation upper bound for the entire target reduction preimage
implies generic integrality in the incident source model. -/
theorem unramifiedIncidentReductionPreimage_le_integralPoints :
    ((rationalPoints.map i).range.comap N.reduction).map N.integralPointMap ≤
      N'.integralPoints := by
  rw [hN']
  exact hgen.trans
    (unramifiedIncidentGeneratedGroup_le_zeroFixer
      C E Ω Ω' hCa hFaCa hΩ hsub hsub' H hH)

local instance incidentRadical_henselian :
    HenselianLocalRing (fixedFieldIntegers F) :=
  (Langlands.LocalGalois.Separable.separableUnramifiedArithmetic F).2.2.2.2

local instance incidentRadical_algClosed :
    IsAlgClosed (IsLocalRing.ResidueField (fixedFieldIntegers F)) :=
  (fixedFieldResidueIsAlgClosure F).1

variable (ψ : N'.Hom N (𝟙 G)) (hN : N.IsSmooth) (hi : IsUnipotentRadical i)

/-- An actual represented full radical factors through the actual special-fibre
image, conditional on the explicit root-generation bound above. -/
def unramifiedIncidentRadicalImageFactor :
    U ⟶ SchematicImage.image ψ.specialFibreMap := by
  letI : Smooth U.X.hom := hi.smooth
  letI : IsReduced U.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field
      (IsLocalRing.ResidueField (fixedFieldIntegers F)) U.X.left U.X.hom
  exact ψ.specialFibreImageFactorOfPreimage hN i
    (unramifiedIncidentReductionPreimage_le_integralPoints
      C E Ω Ω' hCa hFaCa hΩ hsub hsub' H hH N N' hN' i hgen)

include hCa hFaCa hΩ hsub hsub' hH hN' hgen hN hi in
@[reassoc]
theorem unramifiedIncidentRadicalImageFactor_comp :
    unramifiedIncidentRadicalImageFactor
        C E Ω Ω' hCa hFaCa hΩ hsub hsub' H hH N N' hN' i hgen ψ hN hi ≫
      SchematicImage.inclusion ψ.specialFibreMap = i := by
  let : Smooth U.X.hom := hi.smooth
  let : IsReduced U.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field
      (IsLocalRing.ResidueField (fixedFieldIntegers F)) U.X.left U.X.hom
  exact ψ.specialFibreImageFactorOfPreimage_comp hN i
    (unramifiedIncidentReductionPreimage_le_integralPoints
      C E Ω Ω' hCa hFaCa hΩ hsub hsub' H hH N N' hN' i hgen)

include hCa hFaCa hΩ hsub hsub' hH hN' hgen hN hi in
/-- The conditional factor gives radical containment on every residue-scheme
test, rather than only on rational points. -/
theorem unramifiedIncidentRadical_range_le_image :
    SubgroupFunctor.range i ≤
      SubgroupFunctor.range (SchematicImage.inclusion ψ.specialFibreMap) := by
  let : Smooth U.X.hom := hi.smooth
  let : IsReduced U.X.left :=
    Langlands.AlgebraicGeometry.SmoothReducedProof.isReduced_of_smooth_over_field
      (IsLocalRing.ResidueField (fixedFieldIntegers F)) U.X.left U.X.hom
  exact ψ.specialFibreImage_contains_of_preimage hN i
    (unramifiedIncidentReductionPreimage_le_integralPoints
      C E Ω Ω' hCa hFaCa hΩ hsub hsub' H hH N N' hN' i hgen)

end Langlands.BruhatTits.IntegralModels
