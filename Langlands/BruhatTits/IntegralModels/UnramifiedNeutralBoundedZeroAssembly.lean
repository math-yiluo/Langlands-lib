import Langlands.BruhatTits.IntegralModels.UnramifiedNeutralZeroAssembly
import Langlands.Geometry.Building.IntegerValuationNormalizerSharpReduction
import Langlands.Geometry.Building.UnramifiedSimplyConnectedNormalizerAffineWeylProof

/-! # Neutral integral points for bounded nonempty apartment subsets -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building.UnramifiedZeroDatum

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
    [IsAffineHom G.X.hom]
    (E : UnramifiedZeroDatum F G)
    (C : MaximalUnramified.BuildingData F G)

/-- The zero fixer of a bounded nonempty subset is generated by its
whole-apartment zero fixer and its root fixers. -/
theorem wholeApartmentZeroFixer_sup_sharpFixer_eq
    {Ω : Set C.Apartment} (hne : Ω.Nonempty)
    (hb : ∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω)) :
    E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω) =
      (E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Set.univ)) ⊔ C.sharpFixer Ω :=
  E.wholeApartmentZeroFixer_sup_sharpFixer_eq_of_simplyConnectedNormalizer C
    MaximalUnramified.simplyConnectedNormalizerAffineWeyl hne hb

end Langlands.Geometry.Building.UnramifiedZeroDatum

namespace Langlands.BruhatTits.IntegralModels

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
    [IsAffineHom G.X.hom]
    (C : MaximalUnramified.BuildingData F G)
    (E : UnramifiedZeroDatum F G)
    (Ω : Set C.Apartment)
    (D : RelativeComponentModelData (fixedFieldIntegers F) (inertiaFixedField F) G)
    (hN : D.full.integralPoints =
      characterValuationKernel (MaximalUnramified.valuation F) G ⊓
        C.pointwiseFixer (C.apartmentMap '' Ω))

include hN in
/-- For bounded nonempty apartment subsets, only the two torus statements
remain as extra inputs to the supplied model's neutral-point equality. -/
theorem unramifiedNeutral_integralPoints_eq_zeroFixer_of_bounded
    (hModel : UnramifiedTorusIwahoriModelStatement.{u})
    (hBound : UnramifiedTorusConnectedBoundStatement.{u})
    (hne : Ω.Nonempty)
    (hb : ∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω)) :
    D.neutral.integralPoints =
      E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω) :=
  unramifiedNeutral_integralPoints_eq_zeroFixer C E Ω D hN hModel hBound
    (E.wholeApartmentZeroFixer_sup_sharpFixer_eq C hne hb)

/-- The bounded neutral/zero-fixer comparison preserves ambient points. -/
def unramifiedNeutralBoundedZeroFixerEquiv
    (hModel : UnramifiedTorusIwahoriModelStatement.{u})
    (hBound : UnramifiedTorusConnectedBoundStatement.{u})
    (hne : Ω.Nonempty)
    (hb : ∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω)) :
    D.neutral.integralPoints ≃*
      ↥(E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω)) :=
  MulEquiv.subgroupCongr
    (unramifiedNeutral_integralPoints_eq_zeroFixer_of_bounded
      C E Ω D hN hModel hBound hne hb)

@[simp]
theorem coe_unramifiedNeutralBoundedZeroFixerEquiv
    (hModel : UnramifiedTorusIwahoriModelStatement.{u})
    (hBound : UnramifiedTorusConnectedBoundStatement.{u})
    (hne : Ω.Nonempty)
    (hb : ∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω))
    (g : D.neutral.integralPoints) :
    (unramifiedNeutralBoundedZeroFixerEquiv C E Ω D hN hModel hBound hne hb g :
      rationalPoints G) = g := rfl

end Langlands.BruhatTits.IntegralModels
