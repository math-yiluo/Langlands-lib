import Langlands.BruhatTits.IntegralModels.FiniteConnectedModelFamily
import Langlands.BruhatTits.IntegralModels.RootFiltrationModel
import Langlands.Geometry.Building.BoundedRootFixerFiltration
import Langlands.Geometry.Building.MaximalUnramifiedBuildingData
import Langlands.Geometry.Building.KPZeroSubgroups
import Langlands.GroupScheme.Rational.RootSupportFiniteness

/-! # Finite connected families from supplied torus and root models -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.LocalGalois.Separable
open Langlands.Geometry.Building

namespace Langlands.BruhatTits.IntegralModels

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
  [IsAffineHom G.X.hom]
  (C : MaximalUnramified.BuildingData F G) (E : UnramifiedZeroDatum F G)
  (x : C.Apartment) (Ω : Set C.Apartment)
  (N : IntegralModel (fixedFieldIntegers F) (inertiaFixedField F) G)

/-- Actual supplied torus and root models, with their geometric properties,
point images, and compatible maps into an ambient integral model. Existence
and compatibility with a given apartment are not asserted. -/
structure TorusRootModelFamilyData where
  torusModel : IntegralModel (fixedFieldIntegers F) (inertiaFixedField F) E.T.toGrp
  torusSmooth : torusModel.IsSmooth
  torusGeometricallyConnected : torusModel.HasGeometricallyConnectedFibres
  torusPoints_eq : torusModel.integralPoints = E.torusIwahori
  torusMap : torusModel.Hom N E.i
  rootModel : ∀ a : relativeRoots C.i,
    RootFiltrationModelData (fixedFieldIntegers F) (inertiaFixedField F)
      C.apartment x a (C.apartment.rootFixerDepth a x Ω)
  rootMap : ∀ a : relativeRoots C.i,
    (rootModel a).model.Hom N (rootModel a).inclusion

namespace TorusRootModelFamilyData

@[instance_reducible] private def rootIndexFintype : Fintype (Option (relativeRoots C.i)) := by
  classical
  have := C.isConnectedReductive.smooth
  letI := relativeRootFintypeOfIsSplitTorus C.i
    C.isMaximalSplitTorus.isSplitSubtorus.1
  infer_instance

private def rootIndexEquiv :
    Fin (@Fintype.card _ (rootIndexFintype C)) ≃ Option (relativeRoots C.i) :=
  (@Fintype.equivFin _ (rootIndexFintype C)).symm

variable {C E x Ω N} (A : TorusRootModelFamilyData C E x Ω N)

/-- `none` selects the torus and `some a` selects the actual relative root `a`. -/
def genericGroup : Option (relativeRoots C.i) →
    GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))
  | none => E.T.toGrp
  | some a => (A.rootModel a).rootGroup

def model : ∀ j, IntegralModel (fixedFieldIntegers F) (inertiaFixedField F)
    (A.genericGroup j)
  | none => A.torusModel
  | some a => (A.rootModel a).model

def genericMap : ∀ j, A.genericGroup j ⟶ G
  | none => E.i
  | some a => (A.rootModel a).inclusion

def modelMap : ∀ j, (A.model j).Hom N (A.genericMap j)
  | none => A.torusMap
  | some a => A.rootMap a

theorem smooth (j : Option (relativeRoots C.i)) : (A.model j).IsSmooth := by
  cases j with
  | none => exact A.torusSmooth
  | some a => exact (A.rootModel a).smooth

theorem geometricallyConnected (j : Option (relativeRoots C.i)) :
    (A.model j).HasGeometricallyConnectedFibres := by
  cases j with
  | none => exact A.torusGeometricallyConnected
  | some a => exact (A.rootModel a).geometricallyConnected

/-- An actual finite connected family, enumerating the torus and every
relative root. Root finiteness follows from the ambient reductive group. -/
def connectedFamily : FiniteConnectedModelFamily N :=
  { size := @Fintype.card _ (rootIndexFintype C)
    genericGroup := fun j => A.genericGroup (rootIndexEquiv C j)
    model := fun j => A.model (rootIndexEquiv C j)
    smooth := fun j => A.smooth (rootIndexEquiv C j)
    geometricallyConnected := fun j => A.geometricallyConnected (rootIndexEquiv C j)
    genericMap := fun j => A.genericMap (rootIndexEquiv C j)
    modelMap := fun j => A.modelMap (rootIndexEquiv C j) }

/-- Reindexing by a finite enumeration preserves the subgroup generated by
the specified generic images. -/
theorem integralImages_connectedFamily :
    A.connectedFamily.integralImages =
      IntegralModel.generatedIntegralImages A.genericGroup A.model A.genericMap := by
  let U : Option (relativeRoots C.i) → Subgroup (rationalPoints G) :=
    fun j => (A.model j).integralPoints.map (rationalPoints.map (A.genericMap j))
  change (⨆ j, U (rootIndexEquiv C j)) = ⨆ j, U j
  exact (rootIndexEquiv C).iSup_comp (g := U)

set_option maxHeartbeats 800000 in
/-- For a nonempty affine-bounded set, the generated image is exactly the
join of the supplied torus Iwahori image and the actual sharp fixer. -/
theorem integralImages_eq_torus_sup_sharpFixer (hne : Ω.Nonempty)
    (hb : ∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω)) :
    A.connectedFamily.integralImages =
      E.torusIwahori.map (rationalPoints.map E.i) ⊔ C.sharpFixer Ω := by
  apply A.integralImages_connectedFamily.trans
  unfold IntegralModel.generatedIntegralImages
  rw [iSup_option]
  dsimp only [model, genericMap, genericGroup]
  rw [A.torusPoints_eq]
  apply congrArg (fun H : Subgroup (rationalPoints G) =>
    E.torusIwahori.map (rationalPoints.map E.i) ⊔ H)
  apply iSup_congr
  intro a
  exact (A.rootModel a).integralPoints_eq.trans
    (C.apartment.rootFixer_eq_filtration_of_bounded a x hne hb).symm

include A in
/-- The compatible model maps place the torus/root generated subgroup in
the ambient model's actual integral points. -/
theorem torus_sup_sharpFixer_le_integralPoints (hne : Ω.Nonempty)
    (hb : ∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω)) :
    E.torusIwahori.map (rationalPoints.map E.i) ⊔ C.sharpFixer Ω ≤ N.integralPoints := by
  rw [← A.integralImages_eq_torus_sup_sharpFixer hne hb]
  exact A.connectedFamily.integralImages_le_integralPoints

end TorusRootModelFamilyData

end Langlands.BruhatTits.IntegralModels
