import Langlands.BruhatTits.IntegralModels.SpecialFibre
import Langlands.GroupScheme.IntegralModel.UnramifiedModelDescent
import Langlands.Geometry.Building.MaximalUnramifiedBuildingData
import Langlands.Geometry.Building.KPZeroSubgroups

/-! # Positive radical preimages generated by one torus factor and positive root groups

The statement `UnramifiedRadicalRootGenerationStatement` describes, for a smooth descended
model characterized by a nonempty subset of one apartment facet over the maximal unramified
extension, the points of `G(F)` reducing into the actual unipotent radical of its special fibre:
they are the points whose image in `G(K)` lies in the `g`-conjugate of the subgroup generated by
one fixed subgroup `H` of the centralizer and the positive root fixers `U_{a,Ω,0+}`
(Kaletha–Prasad, Corollary 8.4.12 and §9.5). -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped ValuativeRel CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.GaloisPointComparison
open Langlands.LocalGalois.Separable Langlands.Geometry.Building

namespace Langlands.BruhatTits.IntegralModels

/-- The base change of an affine group scheme to the maximal unramified extension is affine,
by pullback-stability of affine morphisms. -/
private instance unramifiedRadicalRootGenerationAffineHom {F : Type u} [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] :
    IsAffineHom (baseChanged F (inertiaFixedField F) G).X.hom := by
  change IsAffineHom
    (CategoryTheory.Limits.pullback.snd G.X.hom (baseMap F (inertiaFixedField F)))
  infer_instance

/-- **Positive radical preimages from one torus factor and positive root groups**
(derived from Kaletha–Prasad Corollary 8.4.12, Theorem 8.4.10, Lemma B.10.11 and §9.5).

Let `G` be an affine group over a nonarchimedean local field `F`, `K = inertiaFixedField F`,
`C` any maximal-unramified building datum for `G_K` and `E` any zero datum for `G_K`. There is
a subgroup `H` of `G(K)`, contained in the image of the centralizer of `C`'s maximal split torus,
such that the following holds simultaneously for every nonempty subset `Ωa` of one facet of
`C`'s apartment, every `g ∈ G(K)`, every relative-component model pair `D` over `𝒪[F]` whose
neutral model is smooth and has, after base change to the integers of `K`, exactly the integral
points `G(K)^0 ∩ G(K)_{g·Ωa}` (pointwise fixer), and every actual reductive quotient `Q` of the
special fibre of `D.neutral`: the points of `G(F)` given by integral sections reducing into the
unipotent radical of `Q` are those whose image in `G(K)` lies in
`g · (H ⊔ ⨆ₐ U_{a,Ωa,0+}) · g⁻¹`. The source's `H` is the image of `T(K)_{0+}` for the minimal
congruent filtration of `T = Z_G(S)`; only its existence is asserted. -/
def UnramifiedRadicalRootGenerationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (C : MaximalUnramified.BuildingData F (baseChanged F (inertiaFixedField F) G))
    (E : UnramifiedZeroDatum F (baseChanged F (inertiaFixedField F) G)),
    ∃ H : Subgroup (rationalPoints (baseChanged F (inertiaFixedField F) G)),
      H ≤ (rationalPoints.map C.centralizer.j).range ∧
      ∀ (Ωa : Set C.Apartment), Ωa.Nonempty →
        (∃ x : C.Apartment, Ωa ⊆ AffineRootSystem.facet C.affineRoots x) →
      ∀ (g : rationalPoints (baseChanged F (inertiaFixedField F) G))
        (D : RelativeComponentModelData ↥𝒪[F] F G),
        D.neutral.IsSmooth →
        D.neutral.baseChangeUnramified.integralPoints =
          E.zeroPoints ⊓ C.pointwiseFixer ((fun x => g • C.apartmentMap x) '' Ωa) →
      ∀ Q : SpecialFibreQuotientData D, Q.IsReductiveQuotient →
        Q.positivePoints =
          ((H ⊔ ⨆ a : relativeRoots C.i, C.rootFixerPlus a Ωa).map
            (MulAut.conj g).toMonoidHom).comap (rationalExtend F (inertiaFixedField F) G)

end Langlands.BruhatTits.IntegralModels
