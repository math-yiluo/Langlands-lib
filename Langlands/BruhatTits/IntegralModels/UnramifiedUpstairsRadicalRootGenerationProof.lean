import Langlands.BruhatTits.IntegralModels.UnramifiedSingletonRadicalGeneration
import Langlands.BruhatTits.IntegralModels.UnramifiedZeroFixerCommonCentralizerRadicalExistence
import Langlands.BruhatTits.IntegralModels.UnramifiedSingleFacetReduction

/-! # Full upstairs radical generation over maximal-unramified integers -/

set_option maxHeartbeats 1600000

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.LocalGalois.Separable

namespace Langlands.BruhatTits.IntegralModels

/-- The full actual upstairs radical preimage is generated by one common
centralizer subgroup and the positive root fixers on every nonempty subset
of a single apartment facet. -/
theorem unramifiedUpstairsRadicalRootGeneration :
    UnramifiedUpstairsRadicalRootGenerationStatement.{u} := by
  apply unramifiedUpstairsRadicalRootGeneration_of_singleton
  intro F _ _ _ _ G _ C E
  obtain ⟨H, hHcentralizer, hHfixer, hH⟩ :=
    unramifiedZeroFixerCommonCentralizerRadicalExistence F G C E
  refine ⟨H, hHcentralizer, hHfixer, ?_⟩
  intro x N hs hN U iU hU
  have hcentral := hH {x} (Set.singleton_nonempty x)
    ⟨x, Set.singleton_subset_iff.mpr
      (AffineRootSystem.mem_facet_self C.affineRoots x)⟩ N hs hN U iU hU
  have hgen :=
    unramifiedSingletonRadicalRootCentralizerGeneration F G C E x N hs hN U iU hU
  change ((rationalPoints.map iU).range.comap N.reduction).map N.integralPointMap =
    ((((rationalPoints.map iU).range.comap N.reduction).map N.integralPointMap) ⊓
      (rationalPoints.map C.centralizer.j).range) ⊔
      ⨆ a : relativeRoots C.i, C.apartment.rootFixerPlus a {x} at hgen
  rw [hcentral] at hgen
  exact hgen

end Langlands.BruhatTits.IntegralModels
