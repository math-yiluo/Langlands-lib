import Langlands.BruhatTits.IntegralModels.RelativeComponent
import Langlands.GroupScheme.RelativeIdentityComponent.OpenConstruction

/-! # Connected-source factorization and neutral integral-point images -/

noncomputable section

universe u v

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme.RelativeIdentityComponent

variable {S : Scheme.{u}} {G H N : GroupScheme S}
  [GeometricallyConnected H.X.hom]

/-- A homomorphism from a group with geometrically connected fibres satisfies
the relative identity-component criterion on its entire source. -/
theorem inRelativeIdentityComponent_hom (f : H ⟶ G) :
    InRelativeIdentityComponent G f.hom.hom :=
  inRelativeIdentityComponent_of_geometricallyConnected G f.hom.hom
    η[H.X] (IsMonHom.one_hom _)

variable {i : N ⟶ G}

/-- The image of a connected-source homomorphism lies in any supplied
representative of the relative identity component. -/
theorem range_hom_subset_range (f : H ⟶ G) (hi : IsRelativeIdentityComponent G i) :
    Set.range f.hom.hom.left ⊆ Set.range i.hom.hom.left := by
  rw [hi.range_eq_underlyingSet]
  exact (inRelativeIdentityComponent_iff_range_subset G _).mp
    (inRelativeIdentityComponent_hom f)

/-- The actual group-scheme homomorphism through the supplied component. -/
def factor (f : H ⟶ G) (hi : IsRelativeIdentityComponent G i) : H ⟶ N := by
  letI : IsOpenImmersion i.hom.hom.left := hi.isOpenImmersion
  exact IdentityComponent.liftHom i f (range_hom_subset_range f hi)

@[reassoc (attr := simp)]
theorem factor_comp (f : H ⟶ G) (hi : IsRelativeIdentityComponent G i) :
    factor f hi ≫ i = f := by
  let : IsOpenImmersion i.hom.hom.left := hi.isOpenImmersion
  exact IdentityComponent.liftHom_fac _ _ _

/-- The factorization through the open component is unique. -/
theorem existsUnique_factor (f : H ⟶ G) (hi : IsRelativeIdentityComponent G i) :
    ∃! h : H ⟶ N, h ≫ i = f := by
  let : IsOpenImmersion i.hom.hom.left := hi.isOpenImmersion
  exact ⟨factor f hi, factor_comp f hi, fun h hh =>
    IdentityComponent.hom_ext_of_isOpenImmersion i
      (hh.trans (factor_comp f hi).symm)⟩

end Langlands.GroupScheme.RelativeIdentityComponent

namespace Langlands.BruhatTits.IntegralModels.RelativeComponentModelData

open Langlands.GroupScheme

variable {R K : Type u} [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]
  {G H : GroupScheme (Spec (CommRingCat.of K))}
  (D : RelativeComponentModelData R K G)
  {M : IntegralModel R K H} [GeometricallyConnected M.group.X.hom]
  {f : H ⟶ G}

/-- A connected model mapping to the full model carries its integral points
into the neutral model's integral-point image. -/
theorem map_mem_neutralPoints (φ : M.Hom D.full f)
    {g : rationalPoints H} (hg : g ∈ M.integralPoints) :
    rationalPoints.map f g ∈ D.neutralPoints := by
  obtain ⟨x, rfl⟩ := hg
  apply (D.mem_neutralPoints_iff _).mpr
  refine ⟨rationalPoints.map φ.hom x, ?_, φ.integralPointMap_naturality x⟩
  exact InRelativeIdentityComponent.precomp D.full.group
    (RelativeIdentityComponent.inRelativeIdentityComponent_hom φ.hom) x

/-- The whole subgroup image of a connected model's integral points lies in
the neutral model's integral-point subgroup. -/
theorem map_integralPoints_le_neutral (φ : M.Hom D.full f) :
    M.integralPoints.map (rationalPoints.map f) ≤ D.neutral.integralPoints := by
  rw [← D.neutralPoints_eq]
  rintro _ ⟨g, hg, rfl⟩
  exact D.map_mem_neutralPoints φ hg

/-- The subgroup generated by a family of compatible connected model images
is contained in the neutral integral points. -/
theorem iSup_map_integralPoints_le_neutral
    {I : Type v}
    (H' : I → GroupScheme (Spec (CommRingCat.of K)))
    (M' : ∀ i, IntegralModel R K (H' i))
    [∀ i, GeometricallyConnected (M' i).group.X.hom]
    (f' : ∀ i, H' i ⟶ G)
    (φ' : ∀ i, (M' i).Hom D.full (f' i)) :
    (⨆ i, (M' i).integralPoints.map (rationalPoints.map (f' i))) ≤
      D.neutral.integralPoints :=
  iSup_le fun i => D.map_integralPoints_le_neutral (φ' i)

end Langlands.BruhatTits.IntegralModels.RelativeComponentModelData
