import Langlands.BruhatTits.IntegralModels.IntegralTorusCentralizer
import Langlands.GroupScheme.IntegralModel.AdicCongruenceTopology
import Langlands.GroupScheme.Rational.OpenRootGenerationTopologicalField

/-! # Actual open root-centralizer generation in a neutral unramified model -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building
open Langlands.LocalGalois.Separable
open Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.BruhatTits.IntegralModels

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))}
    [IsAffineHom G.X.hom]
    (C : MaximalUnramified.BuildingData F G)
    (D : RelativeComponentModelData (fixedFieldIntegers F) (inertiaFixedField F) G)
    (Ω : Set C.Apartment)
    (hN : D.full.integralPoints =
      characterValuationKernel (MaximalUnramified.valuation F) G ⊓
        C.pointwiseFixer (C.apartmentMap '' Ω))

/-- The subgroup generated by the actual integral neutral centralizer and
all actual apartment-root fixers. -/
def unramifiedNeutralRootCentralizerGroup : Subgroup (rationalPoints G) :=
  (unramifiedNeutralCentralizerModel C D Ω hN).integralPoints.map
    (rationalPoints.map C.centralizer.j) ⊔ C.sharpFixer Ω

/-- Every generator has its actual compatible map into the neutral model. -/
theorem unramifiedNeutralRootCentralizerGroup_le_neutral :
    unramifiedNeutralRootCentralizerGroup C D Ω hN ≤ D.neutral.integralPoints := by
  apply sup_le
  · rintro _ ⟨z, hz, rfl⟩
    exact (unramifiedNeutralCentralizerModelMap C D Ω hN).map_mem_integralPoints hz
  · exact unramifiedSharpFixer_le_neutral C D Ω hN

private instance : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom

set_option maxHeartbeats 800000 in
/-- The actual generated subgroup is open for the published upper-field
point topology, with no boundedness or nonemptiness premise on the apartment set. -/
theorem isOpen_unramifiedNeutralRootCentralizerGroup :
    letI : TopologicalSpace (inertiaFixedField F) := fixedFieldTopology F
    letI : TopologicalSpace (rationalPoints G) :=
      rationalPointTopology (inertiaFixedField F) G.X
    IsOpen (unramifiedNeutralRootCentralizerGroup C D Ω hN : Set (rationalPoints G)) := by
  rw [← fixedFieldNormedField_topology F]
  let : NontriviallyNormedField (inertiaFixedField F) := fixedFieldNormedField F
  let : TopologicalSpace (rationalPoints G) :=
    rationalPointTopology (inertiaFixedField F) G.X
  have hOpenN := IntegralModel.isOpen_integralPoints_unramified F D.neutral
  rw [← fixedFieldNormedField_topology F] at hOpenN
  have hVle (a : relativeRoots C.i) :
      C.apartment.rootFixer a Ω ≤ rootGroupPoints C.i a := by
    rw [← rootGroupPoints_inf_unramifiedNeutral_eq_rootFixer C D Ω hN a]
    exact inf_le_left
  have hVopen (a : relativeRoots C.i) :
      IsOpen ((C.apartment.rootFixer a Ω).subgroupOf (rootGroupPoints C.i a) :
        Set (rootGroupPoints C.i a)) := by
    have heq :
        ((C.apartment.rootFixer a Ω).subgroupOf (rootGroupPoints C.i a) :
          Set (rootGroupPoints C.i a)) =
        Subtype.val ⁻¹' (D.neutral.integralPoints : Set (rationalPoints G)) := by
      ext g
      change (g : rationalPoints G) ∈ C.apartment.rootFixer a Ω ↔
        (g : rationalPoints G) ∈ D.neutral.integralPoints
      rw [← rootGroupPoints_inf_unramifiedNeutral_eq_rootFixer C D Ω hN a]
      exact and_iff_right g.property
    rw [heq]
    exact hOpenN.preimage continuous_subtype_val
  have : IsClosedImmersion C.centralizer.j.hom.hom.left := C.centralizer.isClosedSubgroup
  have : IsAffine C.centralizer.Z.X.left :=
    isAffine_of_isAffineHom C.centralizer.j.hom.hom.left
  have hZopen := IntegralModel.isOpen_integralPoints_unramified F
    (unramifiedNeutralCentralizerModel C D Ω hN)
  rw [← fixedFieldNormedField_topology F] at hZopen
  exact RelativeRoot.topologicalRootCentralizerGeneration
    (inertiaFixedField F) G C.isConnectedReductive C.S C.i C.isMaximalSplitTorus
    C.centralizer.Z C.centralizer.j C.centralizer.isRepresentedBy
    C.centralizer.isClosedSubgroup
    (fun a => C.apartment.rootFixer a Ω)
    (unramifiedNeutralCentralizerModel C D Ω hN).integralPoints hVle hVopen hZopen

/-- One actual positive congruence subgroup of the original full model lies
in the subgroup generated by the constructed centralizer and all root fixers. -/
theorem exists_congruenceSubgroupAt_le_unramifiedNeutralRootCentralizerGroup :
    ∃ m : ℕ+, D.full.congruenceSubgroupAt m ≤
      unramifiedNeutralRootCentralizerGroup C D Ω hN := by
  let : TopologicalSpace (inertiaFixedField F) := fixedFieldTopology F
  let : TopologicalSpace (rationalPoints G) :=
    rationalPointTopology (inertiaFixedField F) G.X
  exact IntegralModel.congruenceSubgroupAt_cofinal_unramified F D.full
    (unramifiedNeutralRootCentralizerGroup C D Ω hN : Set (rationalPoints G))
    ((isOpen_unramifiedNeutralRootCentralizerGroup C D Ω hN).mem_nhds
      (unramifiedNeutralRootCentralizerGroup C D Ω hN).one_mem)

end Langlands.BruhatTits.IntegralModels
