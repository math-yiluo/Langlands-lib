import Langlands.BruhatTits.IntegralModels.IntegralRootCentralizerGeneration
import Langlands.GroupScheme.Rational.LocalSmoothQuotientRootGeneration
import Langlands.GroupScheme.IntegralModel.QuotientKernelFactors
import Langlands.GroupScheme.IntegralModel.UnramifiedReductionPoints

/-! # Quotient kernels generated by actual generic root intersections -/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Geometry.Building

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 1600000

namespace Langlands.GroupScheme.RelativeRoot

variable {R K : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))}
    (M : IntegralModel R K G)
    [Smooth M.group.X.hom] [GeometricallyConnected M.group.X.hom]
    (I : Type u) [Fintype I] [DecidableEq I]
    (i : splitTorus (Spec (CommRingCat.of R)) I ⟶ M.group)
    {Q : GroupScheme (Spec (CommRingCat.of (IsLocalRing.ResidueField R)))}
    [Smooth Q.X.hom] [IsAffineHom Q.X.hom] [ConnectedSpace Q.X.left]
    (q : M.specialFibre ⟶ Q)
    (hqs : Smooth q.hom.hom.left) (hqsurj : Surjective q.hom.hom.left)
    [ConnectedSpace (Langlands.GroupScheme.kernel q).X.left] (hN : IsUnipotent (Langlands.GroupScheme.kernel q))

include hqs hqsurj hN in
/-- Bounds for the actual integral root intersections and one dynamic
centralizer intersection bound the entire special-fibre quotient kernel. -/
theorem quotientKernel_le_of_exponentRoots_and_dynamicCentralizer
    [Mono (splitTorus.baseChangeHom (K := K) M.group I i).hom.hom.left]
    (hroot : HasRelativeRootSystem
      (T := splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I)
      (splitTorus.baseChangeHom (K := K) M.group I i))
    (ν : I → ℤ) (S : Subgroup M.integralSections)
    (hS : ∀ m : I → ℤ,
      splitTorus.exponentCharacter (Spec (CommRingCat.of K)) I m ∈
        relativeRoots (T := splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I)
          (splitTorus.baseChangeHom (K := K) M.group I i) →
      (subgroup i (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I m)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓
          ((rationalPoints.map q).comp M.reduction).ker ≤ S)
    (hZ : (Dynamic.centralizer (CommGroupScheme.groupHom
      (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i)).carrier
        (𝟙_ (Over (Spec (CommRingCat.of R)))) ⊓
          ((rationalPoints.map q).comp M.reduction).ker ≤ S) :
    ((rationalPoints.map q).comp M.reduction).ker ≤ S := by
  let : ConnectedSpace M.specialFibre.X.left :=
    M.hasConnectedSpecialFibre_of_geometricallyConnected
      (M.hasGeometricallyConnectedSpecialFibre_of_geometricallyConnected
        (by change GeometricallyConnected M.group.X.hom; infer_instance))
  let χ := CommGroupScheme.groupHom
    (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i
  have hneg : Dynamic.oppositeCocharacter χ =
      CommGroupScheme.groupHom
        (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I (-ν)) ≫ i := by
    have hc : Gm.powerHom (Spec (CommRingCat.of R)) (-1) ≫
        splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν =
        splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I (-ν) := by
      rw [Gm.powerHom_apply, neg_one_zsmul, Preadditive.neg_comp, Category.id_comp]
      simp only [splitTorus.exponentCocharacter, Pi.neg_apply,
        neg_smul, Finset.sum_neg_distrib]
    change _ ≫ (_ ≫ i) = _
    rw [← Category.assoc]
    change CommGroupScheme.groupHom (Gm.powerHom _ (-1) ≫
      splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ i = _
    rw [hc]
  apply M.quotientKernel_le_of_dynamicFactors χ q hqs hqsurj hN S
  · rw [hneg]
    exact dynamicUnipotent_inf_baseChangeQuotientKernel_le_of_exponentRoots
      (k := K) I i q hqs hroot (-ν) S hS
  · exact hZ
  · exact dynamicUnipotent_inf_baseChangeQuotientKernel_le_of_exponentRoots
      (k := K) I i q hqs hroot ν S hS

end Langlands.GroupScheme.RelativeRoot

namespace Langlands.GroupScheme.IntegralModel

variable {R K : Type u} [CommRing R] [IsDomain R] [IsLocalRing R] [Field K]
    [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of K))}
    (N : IntegralModel R K G) (i : S.toGrp ⟶ G)
    {H : GroupScheme (Spec (CommRingCat.of (IsLocalRing.ResidueField R)))}
    (q : N.specialFibre ⟶ H)

/-- The subgroup generated by special-fibre quotient-kernel intersections with all
actual generic roots and the whole generic torus centralizer. -/
def rootCentralizerQuotientKernelPoints : Subgroup (rationalPoints G) :=
  (⨆ a : relativeRoots i, N.specialFibreKernelPoints q ⊓ rootGroupPoints i a) ⊔
    (N.specialFibreKernelPoints q ⊓ (torusCentralizer i).carrier (𝟙_ (Over _)))

theorem rootCentralizerQuotientKernelPoints_le :
    N.rootCentralizerQuotientKernelPoints i q ≤ N.specialFibreKernelPoints q := by
  apply sup_le
  · exact iSup_le fun _ => inf_le_left
  · exact inf_le_left

end Langlands.GroupScheme.IntegralModel

namespace Langlands.BruhatTits.IntegralModels

section Coordinate

variable {R K : Type u} [CommRing R] [IsDomain R] [IsLocalRing R] [Field K]
    [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of K))}
    {i : S.toGrp ⟶ G}
    (N : IntegralModel R K G)
    [Smooth N.group.X.hom] [GeometricallyConnected N.group.X.hom]
    (I : Type u) [Fintype I] [DecidableEq I]
    (j : (splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I).toGrp ⟶ N.group)
    (e : splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I ≅ S)
    (hsq : splitTorus.baseChangeHom (K := K) N.group I j ≫ N.genericIso.hom =
      CommGroupScheme.groupHom e.hom ≫ i)
    {H : GroupScheme (Spec (CommRingCat.of (IsLocalRing.ResidueField R)))}
    [Smooth H.X.hom] [IsAffineHom H.X.hom] [ConnectedSpace H.X.left]
    (q : N.specialFibre ⟶ H)
    (hqs : Smooth q.hom.hom.left) (hqsurj : Surjective q.hom.hom.left)
    [ConnectedSpace (Langlands.GroupScheme.kernel q).X.left] (hN : IsUnipotent (Langlands.GroupScheme.kernel q))

private instance : IsAffineHom N.genericFibre.X.hom :=
  inferInstanceAs (IsAffineHom (pullback.snd N.group.X.hom (Spec.algebraMap R K)))

private def groupIsoOfCommIso {B : Scheme.{u}} {T U : CommGroupScheme B}
    (e : T ≅ U) : T.toGrp ≅ U.toGrp where
  hom := CommGroupScheme.groupHom e.hom
  inv := CommGroupScheme.groupHom e.inv
  hom_inv_id := congrArg Additive.toMul e.hom_inv_id
  inv_hom_id := congrArg Additive.toMul e.inv_hom_id

include hsq hqs hqsurj hN in
private theorem coordinateRootCentralizerQuotientKernel_le
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i) :
    N.specialFibreKernelPoints q ≤ N.rootCentralizerQuotientKernelPoints i q := by
  classical
  let b := Spec.algebraMap R K
  let jK : (splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I).toGrp ⟶
      N.genericFibre := splitTorus.baseChangeHom (K := K) N.group I j
  have hmax' : IsMaximalSplitTorus (jK ≫ N.genericIso.hom) := by
    rw [hsq]
    exact hi.iso_comp (groupIsoOfCommIso e)
  have hmax : IsMaximalSplitTorus jK :=
    (IsMaximalSplitTorus.comp_iso_iff jK N.genericIso).mp hmax'
  let : Mono jK.hom.hom.left := hmax.isSplitSubtorus.mono
  have hroot := relativeRootSystem K N.genericFibre
    (hG.of_iso N.genericIso) _ jK hmax
  obtain ⟨νK, hνK⟩ :=
    (isSplitTorus_splitTorus (S := Spec (CommRingCat.of K)) I).exists_cocharacter_centralizer jK
  let ν : I → ℤ := splitTorus.cocharacterLatticeEquiv K I νK
  have hν : splitTorus.exponentCocharacter (Spec (CommRingCat.of K)) I ν = νK := by
    rw [splitTorus.exponentCocharacter_eq_cocharacterLatticeEquiv_symm]
    exact AddEquiv.symm_apply_apply _ _
  let χ := CommGroupScheme.groupHom
    (splitTorus.exponentCocharacter (Spec (CommRingCat.of R)) I ν) ≫ j
  have hχ : Dynamic.baseChangeCocharacter b χ =
      CommGroupScheme.groupHom νK ≫ jK := by
    rw [← hν]
    have h := splitTorus.groupHom_exponentCocharacter_baseChange
      (Spec (CommRingCat.of R)) I b ν
    rw [← h]
    change (Gm.baseChangeIso b).inv ≫
        (GroupScheme.baseChange b).map (_ ≫ j) =
      (Dynamic.baseChangeCocharacter b
        (CommGroupScheme.groupHom (splitTorus.exponentCocharacter _ I ν)) ≫
          (splitTorus.baseChangeIso b I).hom) ≫
        ((splitTorus.baseChangeIso b I).inv ≫ (GroupScheme.baseChange b).map j)
    simp only [Functor.map_comp, Dynamic.baseChangeCocharacter,
      Category.assoc, Iso.hom_inv_id_assoc]
  let Q := (N.rootCentralizerQuotientKernelPoints i q).comap N.integralPointMap
  have hQ : ((rationalPoints.map q).comp N.reduction).ker ≤ Q := by
    apply RelativeRoot.quotientKernel_le_of_exponentRoots_and_dynamicCentralizer
      N I j q hqs hqsurj hN hroot ν Q
    · intro m hm x hx
      have hxK : baseChangeSectionHom b N.group x ∈
          ((RelativeRoot.subgroup
            (S := splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I) j
            (splitTorus.exponentCharacter (Spec (CommRingCat.of R)) I m)).baseChange b).carrier
              (Over.mk (𝟙 (Spec (CommRingCat.of K)))) :=
        SubgroupFunctor.baseChangeSectionHom_mem b _ (x := x) hx.1
      rw [← RelativeRoot.exponentRoot_subgroup_baseChange I j b m] at hxK
      let a := characterLattice.congr e
        (splitTorus.exponentCharacter (Spec (CommRingCat.of K)) I m)
      have ha : a ∈ relativeRoots i :=
        (roots_mem_of_transport_iff e N.genericIso hsq _).mpr hm
      have hxG : N.integralPointMap x ∈ rootGroupPoints i a :=
        RelativeRoot.comp_mem_subgroup_of_transport e N.genericIso.hom hsq _ hxK
      apply (le_sup_left : (⨆ a : relativeRoots i,
        N.specialFibreKernelPoints q ⊓ rootGroupPoints i a) ≤ N.rootCentralizerQuotientKernelPoints i q)
      exact (le_iSup (fun a : relativeRoots i =>
        N.specialFibreKernelPoints q ⊓ rootGroupPoints i a) ⟨a, ha⟩)
          ⟨⟨x, hx.2, rfl⟩, hxG⟩
    · intro x hx
      have hxK : baseChangeSectionHom b N.group x ∈
          ((Dynamic.centralizer χ).baseChange b).carrier
            (Over.mk (𝟙 (Spec (CommRingCat.of K)))) :=
        SubgroupFunctor.baseChangeSectionHom_mem b _ (x := x) hx.1
      rw [← Dynamic.centralizer_baseChange, hχ, hνK] at hxK
      have hxG : N.integralPointMap x ∈
          (torusCentralizer i).carrier (𝟙_ (Over _)) := by
        have heq := torusCentralizer_eq_comap_of_iso_square
          jK i (groupIsoOfCommIso e) N.genericIso hsq
        rw [heq] at hxK
        exact hxK
      exact (le_sup_right : (N.specialFibreKernelPoints q ⊓
        (torusCentralizer i).carrier (𝟙_ (Over _))) ≤ N.rootCentralizerQuotientKernelPoints i q)
          ⟨⟨x, hx.2, rfl⟩, hxG⟩
  rintro _ ⟨x, hx, rfl⟩
  exact hQ hx

end Coordinate

section IntegralTorus

variable {R K : Type u} [CommRing R] [IsDomain R] [IsLocalRing R] [Field K]
    [Algebra R K] [IsFractionRing R K]
    {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]
    {S : CommGroupScheme (Spec (CommRingCat.of K))}
    {i : S.toGrp ⟶ G} {N : IntegralModel R K G}
    [Smooth N.group.X.hom] [GeometricallyConnected N.group.X.hom]
    {H : GroupScheme (Spec (CommRingCat.of (IsLocalRing.ResidueField R)))}
    [Smooth H.X.hom] [IsAffineHom H.X.hom] [ConnectedSpace H.X.left]
    (q : N.specialFibre ⟶ H)
    (hqs : Smooth q.hom.hom.left) (hqsurj : Surjective q.hom.hom.left)
    [ConnectedSpace (Langlands.GroupScheme.kernel q).X.left] (hN : IsUnipotent (Langlands.GroupScheme.kernel q))

namespace IntegralSplitTorusData

include hqs hqsurj hN in
/-- A compatible integral split torus gives generation of the full generic
image of a quotient kernel by its actual root and centralizer intersections. -/
theorem rootCentralizerQuotientKernelPoints_eq (A : IntegralSplitTorusData N i)
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i) :
    N.rootCentralizerQuotientKernelPoints i q = N.specialFibreKernelPoints q := by
  classical
  obtain ⟨I, hI, ⟨eR⟩⟩ := A.isSplit
  let : Fintype I := Fintype.ofFinite I
  let b := Spec.algebraMap R K
  let eR' : splitTorus.commGroupScheme (Spec (CommRingCat.of R)) I ≅ A.torus :=
    CommGroupScheme.isoOfGroupIso eR.symm
  let eK : splitTorus.commGroupScheme (Spec (CommRingCat.of K)) I ≅ S :=
    (splitTorus.commBaseChangeIso b I).symm ≪≫
      (CommGroupScheme.baseChange b).mapIso eR' ≪≫ A.genericIso
  let j := eR.inv ≫ A.inclusion
  have hsq : splitTorus.baseChangeHom (K := K) N.group I j ≫ N.genericIso.hom =
      CommGroupScheme.groupHom eK.hom ≫ i := by
    change (splitTorus.baseChangeIso b I).inv ≫
        (GroupScheme.baseChange b).map (eR.inv ≫ A.inclusion) ≫ N.genericIso.hom = _
    rw [Functor.map_comp, Category.assoc]
    change (splitTorus.baseChangeIso b I).inv ≫
      (GroupScheme.baseChange b).map eR.inv ≫ N.genericHom A.inclusion = _
    rw [A.generic_comm]
    rfl
  exact le_antisymm (N.rootCentralizerQuotientKernelPoints_le i q)
    (coordinateRootCentralizerQuotientKernel_le N I j eK hsq q hqs hqsurj hN hG hi)

include hqs hqsurj hN in
/-- Bounds for the actual generic root and whole torus-centralizer intersections
bound the entire generic image of the special-fibre quotient kernel. -/
theorem specialFibreKernelPoints_le_of_roots_and_centralizer
    (A : IntegralSplitTorusData N i) (hG : IsConnectedReductive G)
    (hi : IsMaximalSplitTorus i) (Q : Subgroup (rationalPoints G))
    (hroot : ∀ a : relativeRoots i, N.specialFibreKernelPoints q ⊓ rootGroupPoints i a ≤ Q)
    (hcentralizer : N.specialFibreKernelPoints q ⊓
      (torusCentralizer i).carrier (𝟙_ (Over _)) ≤ Q) :
    N.specialFibreKernelPoints q ≤ Q := by
  rw [← A.rootCentralizerQuotientKernelPoints_eq q hqs hqsurj hN hG hi]
  exact sup_le (iSup_le hroot) hcentralizer


end IntegralSplitTorusData

end IntegralTorus

end Langlands.BruhatTits.IntegralModels
