import Langlands.TraceFormula.GeneralLinearBaseChangeLocal

/-!
# Local-global principle for norms of regular elliptic elements of `GL_n`

Let `L/K` be a cyclic extension of number fields of degree `l` with Galois group generated by
`σ`.  A regular elliptic `γ ∈ GL_n(K)` that is a norm from `GL_n(E_i)`, `E_i = K_i ⊗_K L`, for
`σ_i = id ⊗ σ` at every place `i` of `K` is a norm from `GL_n(L)`.  This is the regular
elliptic case of Arthur–Clozel (1989), Chapter 1, Lemma 1.2.  The module states the
proposition and does not prove it.  See the paired Markdown.
-/

noncomputable section

universe u

namespace Langlands.TraceFormula

open Langlands.Global Langlands.BaseChange Langlands.JacquetLanglands

open scoped Langlands.TraceFormula.PlaceCompletion

/-- Local-global principle for norms of regular elliptic elements (the regular elliptic case of
Arthur–Clozel, Chapter 1, Lemma 1.2).  For a cyclic extension `L/K` of number fields of degree
`l` with generator `σ` and `γ ∈ GL_n(K)` whose characteristic polynomial is separable and
irreducible over `K`: if, at every place `i` of `K` (infinite places included), the image of `γ`
in `GL_n(K_i)` is a norm for `σ_i = localGalois K L σ i` on `E_i = K_i ⊗_K L`, then `γ` is a
norm for `σ`: some `N(δ) = δ δ^σ ⋯ δ^{σ^{l-1}}`, `δ ∈ GL_n(L)`, is conjugate in `GL_n(L)` to
`γ`. -/
def GeneralLinearLocalGlobalNormStatement : Prop :=
  ∀ (K : Type u) [Field K] [NumberField K] (L : Type u) [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (σ : L ≃ₐ[K] L) (l : ℕ), IsCyclicAlgebra σ l →
    ∀ (n : ℕ) (γ : GeneralLinear n K), IsRegularElliptic γ →
      (∀ i : Place K, IsNorm (localGalois K L σ i) l
        (Matrix.GeneralLinearGroup.map (algebraMap K (placeCompletion K i)) γ)) →
      IsNorm σ l γ

end Langlands.TraceFormula
