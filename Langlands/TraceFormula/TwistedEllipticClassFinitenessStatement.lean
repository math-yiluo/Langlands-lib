import Langlands.BaseChange.Norm
import Langlands.Global.AdelicGLTransport

/-!
# Finiteness of rational σ-elliptic classes meeting a compact adelic set

For a cyclic extension `L/K` of number fields, only finitely many rational σ-twisted
conjugacy classes of σ-elliptic elements of `GL_n(L)` meet a compact set in `GL_n(𝔸_L)`
under adelic σ-twisted conjugation. Ellipticity is for the associated class over `K`,
not for the norm matrix over `L` or any completion of `L`.

Derived from the geometric finiteness used in Getz–Hahn 2024, Theorem 18.2.5 and
Lemma 18.2.6 (printed p. 479) and Corollary 18.5.1 (p. 488), with the norm and
σ-ellipticity conventions of Henniart–Lemaire 2011, I.2.2–I.2.3 (pp. 11–14).
See the paired Markdown.
-/

open Langlands.BaseChange Langlands.Global Langlands.Global.AdelicGLTransport

namespace Langlands.TraceFormula

universe u v

/-- For `L/K` cyclic of degree `l` generated by `σ`, and a compact `Ω ⊆ GL_n(𝔸_L)`, there is a
finite set of rational σ-elliptic elements in `GL_n(L)` whose adelic twisted classes meet `Ω`,
representing every rational σ-elliptic class whose adelic twisted class meets `Ω`. Here `σ` acts
on `GL_n(𝔸_L)` through the Library's `adelicEquiv`. -/
def TwistedEllipticClassFinitenessStatement : Prop :=
  ∀ (K : Type u) [Field K] [NumberField K] (L : Type v) [Field L] [NumberField L]
    [Algebra K L] (σ : L ≃ₐ[K] L) (l : ℕ), IsCyclicAlgebra σ l →
    ∀ (n : ℕ) (Ω : Set (AdelicGL L n)), IsCompact Ω →
      let meets (δ : RationalGL L n) : Prop :=
        ∃ x : AdelicGL L n,
          x⁻¹ * AdelicGL.rational L n δ * adelicEquiv n (σ : L ≃+* L) x ∈ Ω
      ∃ R : Finset (RationalGL L n),
        (∀ r ∈ R, IsSigmaElliptic σ l r ∧ meets r) ∧
        ∀ δ : RationalGL L n, IsSigmaElliptic σ l δ → meets δ →
          ∃ r ∈ R, ∃ y : RationalGL L n, y⁻¹ * δ * entrywiseAut σ n y = r

end Langlands.TraceFormula
