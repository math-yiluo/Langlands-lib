import Langlands.Automorphic.GroupSchemeFullAEL2
import Langlands.Global.AdelicGroupNormOneFunctorial
import Langlands.TraceFormula.TwistedOrbital

/-!
# Twisting by an algebraic automorphism preserves the cuspidal subspace (statement)

Let `G` be a connected reductive group over a number field `F`, presented as in the Library's
full almost-everywhere cuspidal `L²` theory, and let `S` be the full almost-everywhere cuspidal
subspace of `L²([G])`, where `[G]` is the quotient of `G(𝔸_F)` by the subgroup generated by
`G(F)` and the positive real points of the central split torus `T`.

Let `α : G ≅ G` be an automorphism of the group scheme `G` over `F`, and let `Θ` be a
topological group automorphism of `G(𝔸_F)` whose underlying map is the adelic-point map of `α`.
Assume that `Θ` preserves the subgroup defining `[G]` and that the inverse of the induced
homeomorphism of `[G]` preserves the quotient measure. Then pullback by that inverse is the
Library's twisting operator `I_Θ`, and `I_Θ` maps `S` into `S`.

See the paired Markdown for the provenance and the use of the statement.
-/

universe u

open CategoryTheory AlgebraicGeometry NumberField MeasureTheory
open scoped CategoryTheory.MonObj
open Langlands.Global Langlands.Global.AdelicGroupPoints
open Langlands.Global.PositiveRealTorus Langlands.GroupScheme
open Langlands.Automorphic.GroupSchemeFunctions Langlands.QuotientIntegration

namespace Langlands.TraceFormula

/-- **Twisting by an algebraic automorphism preserves the full almost-everywhere cuspidal
subspace.** For a connected reductive `G` over a number field `F` with central split torus
`i : T → G` as in the Library's full almost-everywhere cuspidal `L²` theory, an automorphism
`α : G ≅ G` of group schemes over `F`, and a topological automorphism `Θ` of `G(𝔸_F)` whose
underlying map is the adelic-point map of `α`, assume that `Θ` preserves the subgroup
defining `[G]` and that the induced inverse on `[G]` preserves the quotient measure.
The twisting operator `I_Θ` maps every element of the full almost-everywhere cuspidal
subspace `S` into `S`. -/
def GroupSchemeTwistCuspidalInvarianceStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffine G.X.left]
    [LocallyOfFiniteType G.X.hom]
    (hPD : ParabolicDynamicStatement.{u}) (hG : IsConnectedReductive G)
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (i : T.toGrp ⟶ G)
    (hi : Function.Injective (characterRestrict i))
    [(characterRestrict i).range.FiniteIndex]
    (I : Type u) [Fintype I]
    (e : T.toGrp ≅ splitTorus (Spec (CommRingCat.of F)) I) (hc : IsCentral i)
    (α : G ≅ G) (Θ : AdelicGroupPoints F G ≃ₜ* AdelicGroupPoints F G),
    (∀ x, Θ x = AdelicGroupPoints.map F G G α.hom x) →
    ∀ (hΘ : ∀ x, Θ x ∈ positiveRationalSubgroup F G T i ↔
        x ∈ positiveRationalSubgroup F G T i)
      (hΘμ : MeasurePreserving
        (quotientAutomorphism (positiveRationalSubgroup F G T i) Θ hΘ).symm
        (positiveRationalQuotientHaarMeasure F G T i)
        (positiveRationalQuotientHaarMeasure F G T i)),
      ∀ φ ∈ fullAEL2CuspidalSubmodule F G hPD hG T i hi I e hc,
        twistOperator (positiveRationalSubgroup F G T i) Θ hΘ
            (positiveRationalQuotientHaarMeasure F G T i) hΘμ φ ∈
          fullAEL2CuspidalSubmodule F G hPD hG T i hi I e hc

end Langlands.TraceFormula
