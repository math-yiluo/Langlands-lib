import Langlands.TraceFormula.CyclicDiscreteTraceDistribution
import Langlands.Analysis.HilbertSumTraceStatement

/-! # Fixed-type finite expansions of the discrete trace sum -/

noncomputable section

open MeasureTheory
open scoped CategoryTheory.MonObj BigOperators

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000

namespace Langlands.TraceFormula

open Langlands.Global Langlands.Global.AdelicGroupPoints
open Langlands.Analysis Langlands.Analysis.OperatorIdeals NormOneLeviInduction
open scoped CoordinateLevi.Presentation

variable (F : Type) [Field F] [NumberField F] (n : ℕ)

/-- The actual standard infinite compact with finite component one, in the norm-one group. -/
def normOneInfiniteCompact : Subgroup (normOneSubgroup F (cyclicBaseGroup F n)) :=
  (adelicInfiniteStandardCompact F n).comap
    ((GeneralLinearGroupPoints.adelicHomeomorph F n).toMonoidHom.comp
      (normOneSubgroup F (cyclicBaseGroup F n)).subtype)

/-- The specified finite level with infinite component one, in the norm-one group. -/
def normOneFiniteLevel (J : Subgroup (FiniteAdelicGL F n)) :
    Subgroup (normOneSubgroup F (cyclicBaseGroup F n)) :=
  let e := (GeneralLinearGroupPoints.adelicHomeomorph F n).toMonoidHom.comp
    (normOneSubgroup F (cyclicBaseGroup F n)).subtype
  J.comap ((AdelicGL.finite F n).toMonoidHom.comp e) ⊓
    ((AdelicGL.infinite F n).toMonoidHom.comp e).ker

/-- The left translation action of the compact on functions on the norm-one group. -/
def normOneTestLeftTranslation : Representation ℂ (normOneInfiniteCompact F n)
    (normOneSubgroup F (cyclicBaseGroup F n) → ℂ) where
  toFun k :=
    { toFun := fun f x => f (k.val⁻¹ * x)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  map_one' := by ext f x; simp
  map_mul' k j := by ext f x; simp [mul_assoc]

/-- The right translation action of the compact on functions on the norm-one group. -/
def normOneTestRightTranslation : Representation ℂ (normOneInfiniteCompact F n)
    (normOneSubgroup F (cyclicBaseGroup F n) → ℂ) where
  toFun k :=
    { toFun := fun f x => f (x * k.val)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  map_one' := by ext f x; simp
  map_mul' k j := by ext f x; simp [mul_assoc]

/-- A fixed finite-dimensional continuous compact representation can encode a finite
set of types by taking their direct sum. -/
structure CompactTypeData (K : Type) [Group K] [TopologicalSpace K] where
  dimension : ℕ
  representation : Representation ℂ K (Fin dimension → ℂ)
  continuous_apply (v : Fin dimension → ℂ) : Continuous (fun k => representation k v)

/-- The subspace generated by the images of the fixed compact type data. -/
def CompactTypeData.span {K X : Type} [Group K] [TopologicalSpace K]
    [AddCommGroup X] [Module ℂ X] (T : CompactTypeData K) (ρ : Representation ℂ K X) :
    Submodule ℂ X :=
  ⨆ f : T.representation.IntertwiningMap ρ, f.toLinearMap.range

/-- A norm-one test at fixed finite level and fixed left and right compact types. -/
def HasFixedTraceTypes (J : Subgroup (FiniteAdelicGL F n))
    (A B : CompactTypeData (normOneInfiniteCompact F n)) (f : normOneTraceTestSpace F n) : Prop :=
  f.val ∈ A.span (normOneTestLeftTranslation F n) ∧ f.val ∈ B.span (normOneTestRightTranslation F n) ∧
    ∀ (k : normOneFiniteLevel F n J) (x : normOneSubgroup F (cyclicBaseGroup F n)),
      f.val (k.val * x) = f.val x ∧ f.val (x * k.val) = f.val x

variable {F n} {t : ℝ} (D : DiscreteTraceData F n t) (L : CoordinateLevi n)

/-- The actual induced action forgetting continuity of each operator. -/
def DiscreteTraceData.representation : Representation ℂ
    (normOneSubgroup F (cyclicBaseGroup F n)) ((D.inductionModel L).hilbertSlice t) where
  toFun g := ((D.action L).toHom g.val).toLinearMap
  map_one' := by simp
  map_mul' g h := by simp

/-- A finite orthogonal family of actual irreducible subrepresentations in the induced slice. -/
structure FixedTypeTraceSummands where
  count : ℕ
  summand : Fin count → Submodule ℂ ((D.inductionModel L).hilbertSlice t)
  irreducible (i : Fin count) : IsIrreducibleSubrepresentation (D.representation L) (summand i)
  orthogonal : OrthogonalFamily ℂ (fun i => summand i) (fun i => (summand i).subtypeₗᵢ)

instance (W : FixedTypeTraceSummands D L) (i : Fin W.count) : CompleteSpace (W.summand i) :=
  (W.irreducible i).1.completeSpace_coe

/-- Compression of the genuine summand to a specified irreducible subspace. -/
def FixedTypeTraceSummands.compression {D : DiscreteTraceData F n t} {L : CoordinateLevi n}
    (W : FixedTypeTraceSummands D L) (i : Fin W.count)
    (B : (D.inductionModel L).hilbertSlice t →L[ℂ] (D.inductionModel L).hilbertSlice t) :
    W.summand i →L[ℂ] W.summand i :=
  (W.summand i).orthogonalProjectionOnto.comp (B.comp (W.summand i).subtypeL)

/-- Fixing the compact types and the finite level gives a single finite family of actual
irreducible subspaces for all tests in that range. Each Weyl trace expands into their
compressed traces with the same weight. -/
def CyclicFixedTypeTraceExpansionStatement : Prop :=
  ∀ (F : Type) [Field F] [NumberField F] (n : ℕ), 0 < n → ∀ t : ℝ, 0 ≤ t →
    ∀ (D : DiscreteTraceData F n t), D.IsSpectral →
    ∀ (ν : Measure (normOneSubgroup F (cyclicBaseGroup F n))) [ν.IsHaarMeasure],
    D.HasNormOneDistribution ν →
    ∀ (J : OpenSubgroup (FiniteAdelicGL F n)), IsCompact (J : Set (FiniteAdelicGL F n)) →
    ∀ A B : CompactTypeData (normOneInfiniteCompact F n),
    ∃ W : ∀ L : CoordinateLevi n, FixedTypeTraceSummands D L,
      ∀ (f : normOneTraceTestSpace F n), HasFixedTraceTypes F n J.toSubgroup A B f →
        ∀ (hf : Integrable f.val ν) (L : CoordinateLevi n),
          (∀ v : (D.inductionModel L).hilbertSlice t, (∀ i, v ∈ ((W L).summand i)ᗮ) →
            (D.action L).integrated ν f.val hf v = 0) ∧
          ∀ s : CoordinateLevi.Presentation.RegularWeyl L,
            let op := D.summand ν f.val hf L s
            (∀ i, IsTraceClass (E := (W L).summand i) ((W L).compression i op)) ∧
              operatorTrace op = ∑ i : Fin (W L).count,
                operatorTrace (E := (W L).summand i) ((W L).compression i op)

end Langlands.TraceFormula
