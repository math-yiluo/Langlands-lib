import Langlands.Automorphic.GroupSchemeFullAEL2Integrated
import Langlands.Automorphic.GroupSchemeParabolicMeasure
import Langlands.TraceFormula.TwistedOrbital
import Langlands.TraceFormula.AdelicGroupAutomorphism
import Langlands.Global.AdelicGaloisTwistMap
import Langlands.Global.AdelicSplitCenterHaar
import Langlands.Global.AdelicGroupRationalTopology
import Langlands.Global.AdelicGroupPointTopology
import Langlands.Global.FiniteAdelicGL.LocalFactor
import Langlands.GroupScheme.Reductive.GeneralLinear
import Langlands.BaseChange.Norm
import Langlands.JacquetLanglands.RegularElliptic
/-!
# Twisted centralizers of rational points of `Res_{L/K} GL_n` with regular elliptic norm

Let `L/K` be a cyclic extension of number fields of degree `l` with Galois group generated by
`σ`, and let `W = Res_{L/K} GL_n`. For a rational point whose norm is regular elliptic at a
finite place of `L`, the proposition states finite volume of the rational quotient of its
twisted centralizer and integrability of the twisted orbit function of each continuous,
compactly supported test function. Both assertions use the Library's norm-one group and
quantify over compatible quotient measures.

The proposition is derived from the geometric terms of Getz–Hahn (2024), Corollary 18.5.1
(printed p. 488), and the centralizer comparison of Arthur–Clozel (1989), Chapter 1,
Lemma 1.1 (printed pp. 3–4). See `GeneralLinearTwistedEllipticCentralizerStatement.md`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry NumberField MeasureTheory
open scoped CategoryTheory.MonObj
open Langlands.Global Langlands.Global.AdelicGroupPoints
open Langlands.GroupScheme
open Langlands.QuotientIntegration Langlands.JacquetLanglands
open Langlands.TraceFormula.AdelicGroupAutomorphism
open Langlands.BaseChange

namespace Langlands.TraceFormula

local instance generalLinearTwistedEllipticCentralizerIsAffine (K : Type u) [Field K] (n : ℕ) :
    IsAffine (GroupScheme.GeneralLinear.groupScheme (Fin n) (CommRingCat.of K)).X.left :=
  GroupScheme.GeneralLinear.isAffine_groupScheme (Fin n) (CommRingCat.of K)

local instance generalLinearTwistedEllipticCentralizerSmooth (K : Type u) [Field K] (n : ℕ) :
    Smooth (GroupScheme.GeneralLinear.groupScheme (Fin n) (CommRingCat.of K)).X.hom :=
  GroupScheme.GeneralLinear.smoothStatement (Fin n) (CommRingCat.of K)

set_option hygiene false in
/-- The `GL_n` group scheme over `K`, for the bound variables `K` and `n`. -/
local notation "GLₙ" => GroupScheme.GeneralLinear.groupScheme (Fin n) (CommRingCat.of K)

set_option hygiene false in
/-- The Weil restriction `Res_{L/K} GL_n`, for the bound variables `K`, `L` and `n`. -/
local notation "Wₙ" => weilGroup K L GLₙ

/-- Twisted centralizers of rational points of `W = Res_{L/K} GL_n` whose norm is regular
elliptic at a finite place. For `IsCyclicAlgebra σ l`, let `Θ` be the induced adelic
automorphism, `θ` its restriction to `W(𝔸_K)¹`, and `Φ` the identification of `W(𝔸_K)`
with `GL_n(𝔸_L)`. The norm is `N(g) = g Θ(g) ⋯ Θ^{l-1}(g)`. Let `r` belong to the rational
subgroup `Γ` of `W(𝔸_K)¹`, assume that `Φ(N(r))` has regular elliptic component at a finite
place `w` of `L`, and write `C` for the `θ`-centralizer of `r` in `W(𝔸_K)¹`.

Each assertion quantifies over Borel measurable structures on its quotient and over
right-invariant measures `μC` on `C` that are finite on compacts and positive on nonempty
open sets.

* Every measure `νΓC` on `(Γ ∩ C) \ C` compatible with `μC` and counting measure on `Γ ∩ C`
  has finite total mass.
* For every measure `νC` on `C \ W(𝔸_K)¹` compatible with `Measure.haar` on `W(𝔸_K)¹` and
  `μC`, the function `C x ↦ φ(x⁻¹ r θ(x))` is `νC`-integrable for every continuous,
  compactly supported `φ : W(𝔸_K)¹ → ℂ`. -/
def GeneralLinearTwistedEllipticCentralizerStatement : Prop :=
  ∀ (K : Type u) [Field K] [NumberField K] (L : Type u) [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (σ : L ≃ₐ[K] L) (l : ℕ), IsCyclicAlgebra σ l →
    ∀ (n : ℕ),
    let θ : normOneSubgroup K Wₙ ≃ₜ* normOneSubgroup K Wₙ :=
      normOneAut K (unitGaloisAut K L GLₙ σ)
    let Φ : AdelicGroupPoints K Wₙ → AdelicGL L n := fun g =>
      GeneralLinearGroupPoints.adelicHomeomorph L n
        (AdelicGroupPoints.map L (AffineWeil.unitBaseChange K L GLₙ)
          (GroupScheme.GeneralLinear.groupScheme (Fin n) (CommRingCat.of L))
          (GroupScheme.GeneralLinear.baseChangeIso (Fin n) (Spec.algebraMap K L)).hom
          (AdelicGaloisUnit.weilAdelicEquiv K L GLₙ g))
    let N : AdelicGroupPoints K Wₙ → AdelicGroupPoints K Wₙ := fun g =>
      ((List.range l).map fun k => adelicAut K (unitGaloisAut K L GLₙ σ ^ k) g).prod
    ∀ (w : Langlands.Global.FinitePlace L) (r : rationalNormOneSubgroup K Wₙ),
    IsRegularElliptic (FiniteAdelicGL.localProjection L n w
      (AdelicGL.finite L n (Φ (N ((r : normOneSubgroup K Wₙ) : AdelicGroupPoints K Wₙ))))) →
    (∀ [MeasurableSpace (LeftQuotient ((rationalNormOneSubgroup K Wₙ).subgroupOf
          (twistedCentralizer θ (r : normOneSubgroup K Wₙ))))]
      [BorelSpace (LeftQuotient ((rationalNormOneSubgroup K Wₙ).subgroupOf
          (twistedCentralizer θ (r : normOneSubgroup K Wₙ))))]
      (μC : Measure (twistedCentralizer θ (r : normOneSubgroup K Wₙ)))
      [μC.IsMulRightInvariant] [IsFiniteMeasureOnCompacts μC] [μC.IsOpenPosMeasure]
      (νΓC : Measure (LeftQuotient ((rationalNormOneSubgroup K Wₙ).subgroupOf
          (twistedCentralizer θ (r : normOneSubgroup K Wₙ))))),
      Langlands.QuotientIntegration.IsCompatible
        ((rationalNormOneSubgroup K Wₙ).subgroupOf
          (twistedCentralizer θ (r : normOneSubgroup K Wₙ)))
        μC Measure.count νΓC →
      νΓC Set.univ ≠ ⊤) ∧
    ∀ [MeasurableSpace (LeftQuotient (twistedCentralizer θ (r : normOneSubgroup K Wₙ)))]
      [BorelSpace (LeftQuotient (twistedCentralizer θ (r : normOneSubgroup K Wₙ)))]
      (μC : Measure (twistedCentralizer θ (r : normOneSubgroup K Wₙ)))
      [μC.IsMulRightInvariant] [IsFiniteMeasureOnCompacts μC] [μC.IsOpenPosMeasure]
      (νC : Measure (LeftQuotient (twistedCentralizer θ (r : normOneSubgroup K Wₙ)))),
      Langlands.QuotientIntegration.IsCompatible
        (twistedCentralizer θ (r : normOneSubgroup K Wₙ))
        (Measure.haar : Measure (normOneSubgroup K Wₙ)) μC νC →
      ∀ φ : normOneSubgroup K Wₙ → ℂ, Continuous φ → HasCompactSupport φ →
        Integrable (twistedOrbitFunction θ (r : normOneSubgroup K Wₙ) φ) νC

end Langlands.TraceFormula
