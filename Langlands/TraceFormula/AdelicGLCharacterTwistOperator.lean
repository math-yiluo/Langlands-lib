import Langlands.Automorphic.FiniteGrowthDeterminantMultiplier
import Langlands.Global.AdelicGLTransport
import Langlands.TraceFormula.CyclicSplitCenterMeasureStatement
import Langlands.TraceFormula.TwistedOrbital

/-! # The Galois and determinant operator on the split-centre matrix quotient -/

noncomputable section

universe u

open MeasureTheory
open scoped NNReal
open Langlands.Global Langlands.QuotientIntegration

namespace Langlands.TraceFormula

variable (E : Type u) [Field E] [NumberField E] (n : ℕ)

/-- The subgroup generated by the rational points and the single diagonal positive
scalar group (finite part equal to one). -/
def adelicGLSplitRationalSubgroup : Subgroup (AdelicGL E n) :=
  (AdelicGL.rational E n).range ⊔ (adelicPositiveScalar E n).toMonoidHom.range

/-- The actual quotient used for the square-integrable trace, in matrix coordinates. -/
abbrev AdelicGLSplitQuotient := LeftQuotient (adelicGLSplitRationalSubgroup E n)

variable (χ : HeckeCharacter E)

/-- Finite-order characters kill the positive scalar by divisibility. -/
theorem finiteOrderDeterminant_adelicPositiveScalar (hχ : χ.HasFiniteOrder) (a : ℝ≥0ˣ) :
    χ.adelicDeterminant n (adelicPositiveScalar E n a) = 1 := by
  obtain ⟨m, hm, hpow⟩ := hχ
  let y := Real.log ((a : ℝ≥0) : ℝ)
  let b := PositiveRealTorus.expUnit (y / m)
  have hb : b ^ m = a := by
    apply Units.ext
    apply NNReal.coe_injective
    have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
    rw [Units.val_pow_eq_pow_val, NNReal.coe_pow, show ((b : ℝ≥0) : ℝ) = Real.exp (y / m) by rfl,
      ← Real.exp_nat_mul, mul_comm (m : ℝ), div_mul_cancel₀ _ hm']
    simpa only [PositiveRealTorus.coe_expUnit] using
      congrArg (fun z : ℝ≥0ˣ => ((z : ℝ≥0) : ℝ)) (PositiveRealTorus.expUnit_log a)
  rw [← hb, map_pow, map_pow]
  change (χ (ideleClassMap E (AdelicGL.determinant E n (adelicPositiveScalar E n b)))) ^ m = 1
  simpa only [ContinuousMonoidHom.pow_apply, ContinuousMonoidHom.one_toFun, Pi.one_apply]
    using congrArg (fun η : HeckeCharacter E => η (ideleClassMap E
      (AdelicGL.determinant E n (adelicPositiveScalar E n b)))) hpow

private theorem finiteOrderDeterminant_subgroup (hχ : χ.HasFiniteOrder) :
    adelicGLSplitRationalSubgroup E n ≤ (χ.adelicDeterminant n).toMonoidHom.ker := by
  apply sup_le
  · rintro _ ⟨g, rfl⟩
    exact χ.adelicDeterminant_rational n g
  · rintro _ ⟨a, rfl⟩
    exact finiteOrderDeterminant_adelicPositiveScalar E n χ hχ a

set_option hygiene false in
local notation "Γ" => adelicGLSplitRationalSubgroup E n

set_option hygiene false in
local notation "Q" => AdelicGLSplitQuotient E n

open AdelicFunctoriality in
private theorem adeleEquiv_positiveReal (e : E ≃+* E) (a : ℝ≥0ˣ) :
    adeleEquiv e (PositiveRealIdeles.full E a : Adeles E) = (PositiveRealIdeles.full E a : Adeles E) := by
  have h := Rat.denseRange_cast.equalizer
    ((continuous_infiniteAdeleEquiv e).comp (PositiveRealIdeles.continuous_infiniteRealEmbedding E))
    (PositiveRealIdeles.continuous_infiniteRealEmbedding E) (by
      funext q
      change infiniteAdeleEquiv e (PositiveRealIdeles.infiniteRealEmbedding E (q : ℝ)) =
        PositiveRealIdeles.infiniteRealEmbedding E (q : ℝ)
      simp only [infiniteRealEmbedding_ratCast, infiniteAdeleEquiv_diagonal, map_ratCast])
  apply Prod.ext
  · exact congrFun h ((a : ℝ≥0) : ℝ)
  · exact map_one (finiteAdeleEquiv e)

/-- Arithmetic transport fixes the positive scalar factor, including at real places. -/
theorem adelicEquiv_adelicPositiveScalar (e : E ≃+* E) (a : ℝ≥0ˣ) :
    AdelicGLTransport.adelicEquiv n e (adelicPositiveScalar E n a) = adelicPositiveScalar E n a := by
  apply Units.ext
  apply Matrix.ext
  intro i j
  change AdelicFunctoriality.adeleEquiv e
      ((Matrix.scalar (Fin n) (PositiveRealIdeles.full E a : Adeles E)) i j) =
    (Matrix.scalar (Fin n) (PositiveRealIdeles.full E a : Adeles E)) i j
  simp only [Matrix.scalar_apply, Matrix.diagonal_apply]
  split_ifs <;> simp [adeleEquiv_positiveReal E e a]

private theorem mapsTo_splitRationalSubgroup (e : E ≃+* E) {g : AdelicGL E n} (hg : g ∈ Γ) :
    AdelicGLTransport.adelicEquiv n e g ∈ Γ := by
  let T := (AdelicGLTransport.adelicEquiv n e).toMonoidHom
  have hmap : Subgroup.map T Γ ≤ Γ := by
    rw [adelicGLSplitRationalSubgroup, Subgroup.map_sup]
    apply sup_le
    · rintro _ ⟨_, ⟨γ, rfl⟩, rfl⟩
      change AdelicGLTransport.adelicEquiv n e (AdelicGL.rational E n γ) ∈ Γ
      rw [AdelicGLTransport.adelicEquiv_rational]
      exact Subgroup.mem_sup_left ⟨_, rfl⟩
    · rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
      change AdelicGLTransport.adelicEquiv n e (adelicPositiveScalar E n a) ∈ Γ
      rw [adelicEquiv_adelicPositiveScalar]
      exact Subgroup.mem_sup_right ⟨_, rfl⟩
  exact hmap (Subgroup.mem_map_of_mem T hg)

/-- The actual arithmetic automorphism induces an automorphism on the split quotient. -/
theorem adelicEquiv_mem_splitRationalSubgroup (e : E ≃+* E) (g : AdelicGL E n) :
    AdelicGLTransport.adelicEquiv n e g ∈ Γ ↔ g ∈ Γ := by
  refine ⟨fun hg => ?_, mapsTo_splitRationalSubgroup E n e⟩
  have h := AdelicGLTransport.adelicEquiv_trans n e e.symm
  rw [RingEquiv.self_trans_symm, AdelicGLTransport.adelicEquiv_refl] at h
  have hx := congrArg (fun T : AdelicGL E n ≃ₜ* AdelicGL E n => T g) h
  change g = AdelicGLTransport.adelicEquiv n e.symm (AdelicGLTransport.adelicEquiv n e g) at hx
  rw [hx]
  exact mapsTo_splitRationalSubgroup E n e.symm hg

/-- The determinant multiplier evaluated on the split-centre automorphic quotient. -/
def splitQuotientDeterminant (hχ : χ.HasFiniteOrder) : Q → ℂˣ :=
  descend Γ (χ.adelicDeterminant n) (by
    intro h g
    rw [map_mul, show χ.adelicDeterminant n h.val = 1 from
      finiteOrderDeterminant_subgroup E n χ hχ h.property, one_mul])

@[simp] theorem splitQuotientDeterminant_mk (hχ : χ.HasFiniteOrder) (g : AdelicGL E n) :
    splitQuotientDeterminant E n χ hχ (Quotient.mk _ g) = χ.adelicDeterminant n g := rfl

private theorem continuous_splitQuotientDeterminant (hχ : χ.HasFiniteOrder) :
    Continuous (splitQuotientDeterminant E n χ hχ) :=
  (leftQuotient_isOpenQuotientMap Γ).isQuotientMap.continuous_iff.mpr
    (χ.adelicDeterminant n).continuous

private theorem norm_splitQuotientDeterminant (hχ : χ.HasFiniteOrder) (q : Q) :
    ‖(splitQuotientDeterminant E n χ hχ q : ℂ)‖ = 1 := by
  induction q using Quotient.inductionOn with
  | h g => exact hχ.norm_adelicDeterminant n g

section L2

variable [MeasurableSpace Q] [BorelSpace Q]
variable (ν : Measure Q) (hχ : χ.HasFiniteOrder)

set_option hygiene false in
local notation "w" => (fun q : Q => (splitQuotientDeterminant E n χ hχ q : ℂ)⁻¹)

omit [MeasurableSpace Q] [BorelSpace Q] in
private theorem norm_inverseWeight (q : Q) : ‖w q‖ = 1 := by
  rw [norm_inv, norm_splitQuotientDeterminant, inv_one]

private theorem memLp_inverseWeight (f : Lp ℂ 2 ν) : MemLp (fun q => w q * f q) 2 ν := by
  have hw : Continuous w := (Units.continuous_val.comp
    (continuous_splitQuotientDeterminant E n χ hχ)).inv₀ (fun _ => Units.ne_zero _)
  refine (Lp.memLp f).of_le_mul (c := 1)
    (hw.measurable.aestronglyMeasurable.mul (Lp.aestronglyMeasurable f)) ?_
  exact Filter.Eventually.of_forall fun q => by rw [norm_mul, norm_inverseWeight E n χ hχ]

/-- Multiplication by `χ(det x)⁻¹` in the actual quotient Hilbert space. -/
def inverseDeterminantMultiplier : Lp ℂ 2 ν →ₗᵢ[ℂ] Lp ℂ 2 ν where
  toFun f := (memLp_inverseWeight E n χ ν hχ f).toLp (fun q => w q * f q)
  map_add' f g := by
    apply Lp.ext
    filter_upwards [(memLp_inverseWeight E n χ ν hχ (f+g)).coeFn_toLp,
      (memLp_inverseWeight E n χ ν hχ f).coeFn_toLp,
      (memLp_inverseWeight E n χ ν hχ g).coeFn_toLp, Lp.coeFn_add f g,
      Lp.coeFn_add ((memLp_inverseWeight E n χ ν hχ f).toLp _)
        ((memLp_inverseWeight E n χ ν hχ g).toLp _)] with x hfg hf hg ha hb
    rw [hfg, hb]
    simp only [Pi.add_apply, hf, hg, ha, mul_add]
  map_smul' a f := by
    apply Lp.ext
    filter_upwards [(memLp_inverseWeight E n χ ν hχ (a • f)).coeFn_toLp,
      (memLp_inverseWeight E n χ ν hχ f).coeFn_toLp, Lp.coeFn_smul a f,
      Lp.coeFn_smul a ((memLp_inverseWeight E n χ ν hχ f).toLp _)] with x haf hf ha hb
    simp only [RingHom.id_apply, haf, hb, ha, Pi.smul_apply, hf, smul_eq_mul, mul_left_comm]
  norm_map' f := by
    change ‖(memLp_inverseWeight E n χ ν hχ f).toLp (fun q => w q * f q)‖ = ‖f‖
    rw [Lp.norm_toLp, Lp.norm_def]
    congr 1
    refine eLpNorm_congr_norm_ae (memLp_inverseWeight E n χ ν hχ f).aestronglyMeasurable
      (Lp.aestronglyMeasurable f) (Filter.Eventually.of_forall fun q => ?_)
    rw [norm_mul, norm_inverseWeight E n χ hχ, one_mul]

theorem inverseDeterminantMultiplier_coeFn (f : Lp ℂ 2 ν) :
    (inverseDeterminantMultiplier E n χ ν hχ f : Q → ℂ) =ᵐ[ν] fun q => w q * f q :=
  (memLp_inverseWeight E n χ ν hχ f).coeFn_toLp

variable (e : E ≃+* E)

set_option hygiene false in
local notation "θ" => AdelicGLTransport.adelicEquiv n e
variable (hθ : ∀ x, θ x ∈ Γ ↔ x ∈ Γ)
variable (hν : MeasurePreserving (quotientAutomorphism Γ θ hθ).symm ν ν)

/-- The Mœglin–Waldspurger operator at the rational twisting point, in right
coset coordinates: `A_θ M_(χ⁻¹)`, where `A_θ` pulls back by `θ⁻¹`. -/
def characterTwistingPointOperator : Lp ℂ 2 ν →L[ℂ] Lp ℂ 2 ν :=
  twistOperator Γ θ hθ ν hν ∘L (inverseDeterminantMultiplier E n χ ν hχ).toContinuousLinearMap

/-- The operator on the unshifted cuspidal summand when `σΠ ≃ Π ⊗ χ`:
`M_(χ⁻¹) A_θ`. This global definition does not assert preservation of that summand. -/
def characterTwistUnshiftedOperator : Lp ℂ 2 ν →L[ℂ] Lp ℂ 2 ν :=
  (inverseDeterminantMultiplier E n χ ν hχ).toContinuousLinearMap ∘L twistOperator Γ θ hθ ν hν

theorem characterTwistingPointOperator_coeFn (f : Lp ℂ 2 ν) :
    (characterTwistingPointOperator E n χ ν hχ e hθ hν f : Q → ℂ) =ᵐ[ν]
      fun q => w ((quotientAutomorphism Γ θ hθ).symm q) * f ((quotientAutomorphism Γ θ hθ).symm q) :=
  (twistOperator_coeFn Γ θ hθ ν hν _).trans
    (hν.quasiMeasurePreserving.ae_eq_comp (inverseDeterminantMultiplier_coeFn E n χ ν hχ f))

theorem characterTwistUnshiftedOperator_coeFn (f : Lp ℂ 2 ν) :
    (characterTwistUnshiftedOperator E n χ ν hχ e hθ hν f : Q → ℂ) =ᵐ[ν]
      fun q => w q * f ((quotientAutomorphism Γ θ hθ).symm q) := by
  refine (inverseDeterminantMultiplier_coeFn E n χ ν hχ _).trans ?_
  filter_upwards [twistOperator_coeFn Γ θ hθ ν hν f] with x hx
  exact congrArg (fun z : ℂ => w x * z) hx

/-- Ordinary right translation in the quotient Hilbert space, with the measure
preservation of right translates made explicit. -/
def splitQuotientRightOperator (g : AdelicGL E n)
    (hg : MeasurePreserving (rightTranslate Γ g) ν ν) : Lp ℂ 2 ν →L[ℂ] Lp ℂ 2 ν :=
  (Lp.compMeasurePreservingₗᵢ ℂ (rightTranslate Γ g) hg).toContinuousLinearMap

omit [BorelSpace Q] in
private theorem splitQuotientRightOperator_coeFn (g : AdelicGL E n)
    (hg : MeasurePreserving (rightTranslate Γ g) ν ν) (f : Lp ℂ 2 ν) :
    (splitQuotientRightOperator E n ν g hg f : Q → ℂ) =ᵐ[ν]
      fun q => f (rightTranslate Γ g q) := Lp.coeFn_compMeasurePreserving f hg

/-- The action at `δg`, with `δ` implementing `θ` and MW's character equal to
`χ⁻¹`. The right-coordinate factor is part of the action, not of the test. -/
def characterRightCosetOperator (g : AdelicGL E n)
    (hg : MeasurePreserving (rightTranslate Γ g) ν ν) : Lp ℂ 2 ν →L[ℂ] Lp ℂ 2 ν :=
  ((χ.adelicDeterminant n g : ℂ)⁻¹) •
    (characterTwistingPointOperator E n χ ν hχ e hθ hν ∘L splitQuotientRightOperator E n ν g hg)

omit [MeasurableSpace Q] [BorelSpace Q] in
private theorem invWeight_rightTranslate (g : AdelicGL E n) (q : Q) :
    w (rightTranslate Γ g q) = w q * (χ.adelicDeterminant n g : ℂ)⁻¹ := by
  induction q using Quotient.inductionOn with
  | h x =>
    change (χ.adelicDeterminant n (x * g) : ℂ)⁻¹ =
      (χ.adelicDeterminant n x : ℂ)⁻¹ * (χ.adelicDeterminant n g : ℂ)⁻¹
    rw [map_mul, Units.val_mul, mul_inv]

omit [MeasurableSpace Q] [BorelSpace Q] in
private theorem pullback_rightTranslate (g : AdelicGL E n) (q : Q) :
    (quotientAutomorphism Γ θ hθ).symm (rightTranslate Γ (θ g) q) =
      rightTranslate Γ g ((quotientAutomorphism Γ θ hθ).symm q) := by
  induction q using Quotient.inductionOn with
  | h x => simp [map_mul]

/-- The right-coordinate action at `δg = θ(g)δ` equals right translation by
`θ(g)` after the twisting-point operator. The two formulas account for the
character weight exactly once. -/
theorem characterRightCosetOperator_covariance (g : AdelicGL E n)
    (hg : MeasurePreserving (rightTranslate Γ g) ν ν)
    (hθg : MeasurePreserving (rightTranslate Γ (θ g)) ν ν) :
    characterRightCosetOperator E n χ ν hχ e hθ hν g hg =
      splitQuotientRightOperator E n ν (θ g) hθg ∘L
        characterTwistingPointOperator E n χ ν hχ e hθ hν := by
  ext f : 1
  apply Lp.ext
  let K := characterTwistingPointOperator E n χ ν hχ e hθ hν
  let R := splitQuotientRightOperator E n ν g hg
  let S := splitQuotientRightOperator E n ν (θ g) hθg
  let c := (χ.adelicDeterminant n g : ℂ)⁻¹
  change (↑(c • K (R f)) : Q → ℂ) =ᵐ[ν] (↑(S (K f)) : Q → ℂ)
  filter_upwards [Lp.coeFn_smul c (K (R f)),
    characterTwistingPointOperator_coeFn E n χ ν hχ e hθ hν (R f),
    hν.quasiMeasurePreserving.ae_eq_comp (splitQuotientRightOperator_coeFn E n ν g hg f),
    splitQuotientRightOperator_coeFn E n ν (θ g) hθg (K f),
    hθg.quasiMeasurePreserving.ae_eq_comp
      (characterTwistingPointOperator_coeFn E n χ ν hχ e hθ hν f)] with q hs hk hr hS hK
  rw [hs, hS]
  change c * K (R f) q = K f (rightTranslate Γ (θ g) q)
  change R f ((quotientAutomorphism Γ θ hθ).symm q) =
    f (rightTranslate Γ g ((quotientAutomorphism Γ θ hθ).symm q)) at hr
  change K f (rightTranslate Γ (θ g) q) =
    w ((quotientAutomorphism Γ θ hθ).symm (rightTranslate Γ (θ g) q)) *
      f ((quotientAutomorphism Γ θ hθ).symm (rightTranslate Γ (θ g) q)) at hK
  rw [show K (R f) q = _ from hk, hr, hK, pullback_rightTranslate E n e hθ,
    invWeight_rightTranslate E n χ hχ]
  exact (mul_assoc c _ _).symm.trans (congrArg (fun z : ℂ => z * _) (mul_comm c _))

end L2

end Langlands.TraceFormula
