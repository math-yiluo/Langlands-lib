import Langlands.Geometry.Analytic.EquivariantEtaleSite
import Langlands.Geometry.Analytic.QuasiEtaleSite

/-! # The quasi-étale site `X(G)_qét` of a `G`-space -/

noncomputable section

universe u v z z'

namespace Langlands.Analytic.SaturatedAtlasPresentation

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {G : Type z} [Group G] [TopologicalSpace G]

namespace GSpace

/-- Quasi-étale `G`-morphisms: `G`-morphisms whose underlying morphism of analytic spaces is
quasi-étale. -/
def quasiEtale : MorphismProperty (GSpace.{u, v, v} K G) :=
  SaturatedAtlasPresentation.quasiEtale.inverseImage forget

theorem quasiEtale_iff {U V : GSpace.{u, v, v} K G} (f : U ⟶ V) :
    quasiEtale f ↔ SaturatedAtlasPresentation.quasiEtale (forget.map f) := Iff.rfl

instance : (quasiEtale (K := K) (G := G)).RespectsIso :=
  MorphismProperty.RespectsIso.inverseImage _ _

instance : (quasiEtale (K := K) (G := G)).ContainsIdentities :=
  MorphismProperty.ContainsIdentities.inverseImage _

/-- Étale `G`-morphisms are quasi-étale. -/
theorem etale_le_quasiEtale : etale (K := K) (G := G) ≤ quasiEtale := fun _ _ _ h =>
  SaturatedAtlasPresentation.etale_le_quasiEtale _ h

end GSpace

variable (X : GSpace.{u, v, v} K G)

/-- Berkovich's category `Qét(X(G))` of a `G`-space `X`: quasi-étale `G`-morphisms
`U(G) → X(G)` from `G`-spaces `U`, with all `G`-morphisms over `X`. -/
abbrev EquivariantQuasiEtaleSite := (GSpace.quasiEtale (K := K) (G := G)).Over ⊤ X

namespace EquivariantQuasiEtaleSite

/-- Forgetting the action: `U(G) ↦ U` from `Qét(X(G))` to `Qét(X)`. -/
def toQuasiEtaleSite : EquivariantQuasiEtaleSite X ⥤ QuasiEtaleSite (GSpace.forget.obj X) :=
  MorphismProperty.Comma.lift
    (MorphismProperty.Over.forget _ _ X ⋙ Over.post GSpace.forget)
    (fun U => U.prop) (fun _ => trivial) (fun _ => trivial)

@[simp]
theorem toQuasiEtaleSite_obj_left (U : EquivariantQuasiEtaleSite X) :
    ((toQuasiEtaleSite X).obj U).left = GSpace.forget.obj U.left := rfl

@[simp]
theorem toQuasiEtaleSite_obj_hom (U : EquivariantQuasiEtaleSite X) :
    ((toQuasiEtaleSite X).obj U).hom = GSpace.forget.map U.hom := rfl

@[simp]
theorem toQuasiEtaleSite_map_left {U V : EquivariantQuasiEtaleSite X} (f : U ⟶ V) :
    ((toQuasiEtaleSite X).map f).left = GSpace.forget.map f.left := rfl

/-- The inclusion `Ét(X(G)) → Qét(X(G))`. -/
abbrev ofEquivariantEtaleSite : EquivariantEtaleSite X ⥤ EquivariantQuasiEtaleSite X :=
  MorphismProperty.Over.changeProp X GSpace.etale_le_quasiEtale le_rfl

end EquivariantQuasiEtaleSite

/-- Coverings of `Qét(X(G))` (Berkovich 1996, §1.2): families `{U_i(G) → U(G)}` such that
`{U_i → U}` is a covering in the quasi-étale topology of `X`. -/
def equivariantQuasiEtalePrecoverage : Precoverage (EquivariantQuasiEtaleSite X) :=
  (quasiEtalePrecoverage (GSpace.forget.obj X)).comap
    (EquivariantQuasiEtaleSite.toQuasiEtaleSite X)

/-- The quasi-étale topology on `Qét(X(G))`, generated by its coverings: the site
`X(G)_qét`. -/
def equivariantQuasiEtaleTopology : GrothendieckTopology (EquivariantQuasiEtaleSite X) :=
  (equivariantQuasiEtalePrecoverage X).toGrothendieck

variable {X}

/-- A family is a covering of `Qét(X(G))` exactly when the family of underlying quasi-étale
morphisms is a quasi-étale covering of `X`. -/
theorem mem_equivariantQuasiEtalePrecoverage_iff {U : EquivariantQuasiEtaleSite X}
    {R : Presieve U} :
    R ∈ equivariantQuasiEtalePrecoverage X U ↔
      R.map (EquivariantQuasiEtaleSite.toQuasiEtaleSite X) ∈
        quasiEtalePrecoverage (GSpace.forget.obj X)
          ((EquivariantQuasiEtaleSite.toQuasiEtaleSite X).obj U) :=
  Precoverage.mem_comap_iff

/-- The sieve generated by a covering is a covering sieve of `X(G)_qét`. -/
theorem generate_mem_equivariantQuasiEtaleTopology {U : EquivariantQuasiEtaleSite X}
    {R : Presieve U} (hR : R ∈ equivariantQuasiEtalePrecoverage X U) :
    Sieve.generate R ∈ equivariantQuasiEtaleTopology X U :=
  Precoverage.generate_mem_toGrothendieck hR

/-- The sheaf condition for `X(G)_qét` is the sheaf condition for the pullbacks of the sieves
generated by coverings. -/
theorem isSheaf_equivariantQuasiEtaleTopology_iff
    (P : (EquivariantQuasiEtaleSite X)ᵒᵖ ⥤ Type*) :
    Presieve.IsSheaf (equivariantQuasiEtaleTopology X) P ↔
      ∀ {U V : EquivariantQuasiEtaleSite X} {f : V ⟶ U} (R : Presieve U),
        R ∈ equivariantQuasiEtalePrecoverage X U →
          Presieve.IsSheafFor P ((Sieve.generate R).pullback f).arrows :=
  Precoverage.isSheaf_toGrothendieck_iff P

namespace EquivariantQuasiEtaleSite

variable {H : Type z'} [Group H] [TopologicalSpace H] (f : H →ₜ* G)

/-- Restriction along a continuous homomorphism `f : H → G`: `U(G) ↦ U(H)`. -/
def res : EquivariantQuasiEtaleSite X ⥤ EquivariantQuasiEtaleSite ((GSpace.res f).obj X) :=
  MorphismProperty.Comma.lift
    (MorphismProperty.Over.forget _ _ X ⋙ Over.post (GSpace.res f))
    (fun U => U.prop) (fun _ => trivial) (fun _ => trivial)

@[simp]
theorem res_obj_left (U : EquivariantQuasiEtaleSite X) :
    ((res f).obj U).left = (GSpace.res f).obj U.left := rfl

/-- Restriction does not change the underlying quasi-étale objects. -/
theorem res_comp_toQuasiEtaleSite :
    res f ⋙ toQuasiEtaleSite ((GSpace.res f).obj X) = toQuasiEtaleSite X :=
  rfl

/-- Restriction preserves and reflects coverings. -/
theorem map_res_mem_equivariantQuasiEtalePrecoverage_iff {U : EquivariantQuasiEtaleSite X}
    {R : Presieve U} :
    R.map (res f) ∈ equivariantQuasiEtalePrecoverage ((GSpace.res f).obj X) ((res f).obj U) ↔
      R ∈ equivariantQuasiEtalePrecoverage X U := by
  have h : equivariantQuasiEtalePrecoverage X =
      (equivariantQuasiEtalePrecoverage ((GSpace.res f).obj X)).comap (res f) := by
    rw [equivariantQuasiEtalePrecoverage, equivariantQuasiEtalePrecoverage,
      ← Precoverage.comap_comp, res_comp_toQuasiEtaleSite]
    rfl
  rw [h, Precoverage.mem_comap_iff]

end EquivariantQuasiEtaleSite

end Langlands.Analytic.SaturatedAtlasPresentation
