import Langlands.Geometry.Analytic.EquivariantSitePullbacksStatement
import Langlands.Geometry.Analytic.RestrictionSiteMorphismStatement
import Mathlib.CategoryTheory.Limits.Constructions.LimitsOfProductsAndEqualizers
import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Pullbacks
import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Terminal
import Mathlib.CategoryTheory.Sites.CoverPreserving
import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

/-! # Restriction morphisms of equivariant sites from fibre products

Conditional proof of `RestrictionSiteMorphismStatement` from the fibre-product statements
`EquivariantQuasiEtalePullbacksStatement` and `EquivariantEtalePullbacksStatement`.
-/

noncomputable section

universe u v z z'

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory

/-- A functor preserving pullbacks out of a category with pullbacks is cover-preserving for the
topology generated by a precoverage as soon as the sieves generated by the images of coverings
are covering sieves. -/
theorem coverPreserving_toGrothendieck_of_preservesPullbacks {C : Type*} [Category* C]
    {D : Type*} [Category* D] (F : C ⥤ D) [HasPullbacks C]
    [PreservesLimitsOfShape WalkingCospan F] (J : Precoverage C) (K : GrothendieckTopology D)
    (h : ∀ ⦃U : C⦄ ⦃R : Presieve U⦄, R ∈ J U → Sieve.generate (R.map F) ∈ K (F.obj U)) :
    CoverPreserving J.toGrothendieck K F where
  cover_preserve {U S} hS := by
    rw [Precoverage.mem_toGrothendieck_iff] at hS
    induction hS with
    | of X R hR =>
      rw [← Sieve.generate_map_eq_functorPushforward]
      exact h hR
    | top X =>
      rw [Sieve.functorPushforward_top]
      exact K.top_mem _
    | pullback X S _ Y f ih =>
      refine K.superset_covering ?_ (K.pullback_stable (F.map f) ih)
      rintro Z g ⟨W, a, b, ha, e⟩
      have hP := (IsPullback.of_hasPullback a f).map F
      refine ⟨pullback a f, pullback.snd a f, hP.lift b g e.symm, ?_, (hP.lift_snd _ _ _).symm⟩
      change S (pullback.snd a f ≫ f)
      rw [← pullback.condition]
      exact S.downward_closed ha _
    | transitive X S R _ _ ihS ihR =>
      refine K.transitive ihS _ ?_
      rintro Z g ⟨W, a, b, ha, rfl⟩
      rw [Sieve.pullback_comp]
      refine K.pullback_stable b (K.superset_covering ?_ (ihR ha))
      rintro V c ⟨T, d, e, hd, rfl⟩
      exact ⟨T, d ≫ a, e, hd, by simp⟩

end CategoryTheory

namespace Langlands.Analytic.SaturatedAtlasPresentation

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

namespace GSpace

variable {Γ : Type z} [Group Γ] [TopologicalSpace Γ]

/-- Forgetting the action is faithful. -/
theorem forget_map_injective {A B : GSpace.{u, v, v} K Γ} :
    Function.Injective (forget.map : (A ⟶ B) → (forget.obj A ⟶ forget.obj B)) :=
  forget.map_injective

/-- A `Γ`-morphism with a prescribed underlying morphism of analytic spaces. -/
def homOfForget {A B : GSpace.{u, v, v} K Γ} (φ : forget.obj A ⟶ forget.obj B)
    (hφ : ∀ g : Γ, A.obj.ρ g ≫ φ = φ ≫ B.obj.ρ g) : A ⟶ B :=
  ObjectProperty.homMk ⟨φ, hφ⟩

@[simp]
theorem forget_map_homOfForget {A B : GSpace.{u, v, v} K Γ} (φ : forget.obj A ⟶ forget.obj B)
    (hφ : ∀ g : Γ, A.obj.ρ g ≫ φ = φ ≫ B.obj.ρ g) : forget.map (homOfForget φ hφ) = φ :=
  rfl

/-- The underlying morphism of a `Γ`-morphism commutes with the actions. -/
theorem forget_map_comm {A B : GSpace.{u, v, v} K Γ} (φ : A ⟶ B) (g : Γ) :
    A.obj.ρ g ≫ forget.map φ = forget.map φ ≫ B.obj.ρ g :=
  φ.hom.comm g

variable {P : MorphismProperty (GSpace.{u, v, v} K Γ)} {Y : GSpace.{u, v, v} K Γ}

/-- Construct a limiting cone of `Γ`-spaces over `Y` from a square whose underlying analytic
square is a pullback. Each lift is the analytic lift, with equivariance and the equation over
`Y` recovered from the projections. -/
def isLimitPullbackConeOfForget {W U₁ U₂ U₃ : P.Over ⊤ Y}
    {p₁ : W ⟶ U₁} {p₂ : W ⟶ U₂} {f₁ : U₁ ⟶ U₃} {f₂ : U₂ ⟶ U₃}
    (w : p₁ ≫ f₁ = p₂ ≫ f₂)
    (h : IsPullback (forget.map p₁.left) (forget.map p₂.left) (forget.map f₁.left)
      (forget.map f₂.left)) :
    IsLimit (PullbackCone.mk p₁ p₂ w) := by
  refine PullbackCone.IsLimit.mk _ (fun s => ?_) (fun s => ?_) (fun s => ?_) (fun s m h₁ h₂ => ?_)
  · have hs : forget.map s.fst.left ≫ forget.map f₁.left =
        forget.map s.snd.left ≫ forget.map f₂.left := by
      rw [← forget.map_comp, ← forget.map_comp, ← MorphismProperty.Comma.comp_left,
        ← MorphismProperty.Comma.comp_left, s.condition]
    let l := h.lift _ _ hs
    have hl : ∀ g : Γ, s.pt.left.obj.ρ g ≫ l = l ≫ W.left.obj.ρ g := by
      intro g
      apply h.hom_ext
      · simp only [Category.assoc, l, h.lift_fst]
        rw [forget_map_comm p₁.left, h.lift_fst_assoc, forget_map_comm s.fst.left]
      · simp only [Category.assoc, l, h.lift_snd]
        rw [forget_map_comm p₂.left, h.lift_snd_assoc, forget_map_comm s.snd.left]
    refine MorphismProperty.Over.homMk (homOfForget l hl) ?_ trivial
    apply forget_map_injective
    rw [forget.map_comp, forget_map_homOfForget, ← MorphismProperty.Over.w p₁, forget.map_comp,
      h.lift_fst_assoc, ← forget.map_comp, MorphismProperty.Over.w]
  · apply MorphismProperty.Over.Hom.ext
    apply forget_map_injective
    rw [MorphismProperty.Comma.comp_left, forget.map_comp]
    exact h.lift_fst _ _ _
  · apply MorphismProperty.Over.Hom.ext
    apply forget_map_injective
    rw [MorphismProperty.Comma.comp_left, forget.map_comp]
    exact h.lift_snd _ _ _
  · apply MorphismProperty.Over.Hom.ext
    apply forget_map_injective
    apply h.hom_ext
    · exact (forget.map_comp m.left p₁.left).symm.trans
        ((congrArg (fun φ : s.pt ⟶ U₁ => forget.map φ.left) h₁).trans
          (h.lift_fst _ _ _).symm)
    · exact (forget.map_comp m.left p₂.left).symm.trans
        ((congrArg (fun φ : s.pt ⟶ U₂ => forget.map φ.left) h₂).trans
          (h.lift_snd _ _ _).symm)

/-- In a category of `Γ`-spaces over `Y`, a square whose underlying square of analytic spaces
is a pullback is a pullback. -/
theorem isPullback_of_isPullback_forget {W U₁ U₂ U₃ : P.Over ⊤ Y}
    {p₁ : W ⟶ U₁} {p₂ : W ⟶ U₂} {f₁ : U₁ ⟶ U₃} {f₂ : U₂ ⟶ U₃}
    (h : IsPullback (forget.map p₁.left) (forget.map p₂.left) (forget.map f₁.left)
      (forget.map f₂.left)) :
    IsPullback p₁ p₂ f₁ f₂ := by
  have w : p₁ ≫ f₁ = p₂ ≫ f₂ := by
    apply MorphismProperty.Over.Hom.ext
    apply forget_map_injective
    simpa [MorphismProperty.Comma.comp_left] using h.w
  exact IsPullback.of_isLimit (isLimitPullbackConeOfForget w h)

/-- An object of a category of `Γ`-spaces over `Y` whose structure morphism is an isomorphism
is terminal. -/
def isTerminalOfIsIsoHom (T : P.Over ⊤ Y) [IsIso T.hom] : IsTerminal T :=
  IsTerminal.ofUniqueHom
    (fun U => MorphismProperty.Over.homMk (U.hom ≫ inv T.hom)
      (by rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id]) trivial)
    (fun U m => by
      apply MorphismProperty.Over.Hom.ext
      exact (by rw [← MorphismProperty.Over.w m, Category.assoc, IsIso.hom_inv_id,
        Category.comp_id] : m.left = U.hom ≫ inv T.hom))

/-- A category of `Γ`-spaces over `Y` has pullbacks as soon as every cospan is completed by a
square whose underlying square of analytic spaces is a pullback. -/
theorem hasPullbacks_of_isPullback_forget
    (hpb : ∀ (U₁ U₂ U₃ : P.Over ⊤ Y) (f₁ : U₁ ⟶ U₃) (f₂ : U₂ ⟶ U₃),
      ∃ (W : P.Over ⊤ Y) (p₁ : W ⟶ U₁) (p₂ : W ⟶ U₂),
        IsPullback (forget.map p₁.left) (forget.map p₂.left) (forget.map f₁.left)
          (forget.map f₂.left)) :
    HasPullbacks (P.Over ⊤ Y) :=
  @hasPullbacks_of_hasLimit_cospan _ _ (fun {U₁ U₂ U₃ f₁ f₂} => by
    obtain ⟨W, p₁, p₂, h⟩ := hpb U₁ U₂ U₃ f₁ f₂
    exact (isPullback_of_isPullback_forget h).hasPullback)

variable {Γ' : Type z'} [Group Γ'] [TopologicalSpace Γ']
  {P' : MorphismProperty (GSpace.{u, v, v} K Γ')} {Y' : GSpace.{u, v, v} K Γ'}

/-- A functor `F` between categories of equivariant spaces over `Y` and `Y'` is representably
flat and continuous for the topologies generated by precoverages `J` and `J'` provided that:
every cospan over `Y` is completed by a square whose underlying square of analytic spaces is a
pullback; `F` preserves the pullback property of underlying squares; `F` preserves objects with
invertible structure morphism; and `F` sends coverings of `J` to coverings of `J'`. -/
theorem representablyFlat_and_isContinuous_of_isPullback_forget [P.ContainsIdentities]
    (F : P.Over ⊤ Y ⥤ P'.Over ⊤ Y')
    (hpb : ∀ (U₁ U₂ U₃ : P.Over ⊤ Y) (f₁ : U₁ ⟶ U₃) (f₂ : U₂ ⟶ U₃),
      ∃ (W : P.Over ⊤ Y) (p₁ : W ⟶ U₁) (p₂ : W ⟶ U₂),
        IsPullback (forget.map p₁.left) (forget.map p₂.left) (forget.map f₁.left)
          (forget.map f₂.left))
    (hF : ∀ ⦃W U₁ U₂ U₃ : P.Over ⊤ Y⦄ ⦃p₁ : W ⟶ U₁⦄ ⦃p₂ : W ⟶ U₂⦄ ⦃f₁ : U₁ ⟶ U₃⦄
      ⦃f₂ : U₂ ⟶ U₃⦄,
      IsPullback (forget.map p₁.left) (forget.map p₂.left) (forget.map f₁.left)
          (forget.map f₂.left) →
        IsPullback (forget.map (F.map p₁).left) (forget.map (F.map p₂).left)
          (forget.map (F.map f₁).left) (forget.map (F.map f₂).left))
    (hiso : ∀ U : P.Over ⊤ Y, IsIso U.hom → IsIso (F.obj U).hom)
    (J : Precoverage (P.Over ⊤ Y)) (J' : Precoverage (P'.Over ⊤ Y'))
    (hJ : ∀ ⦃U : P.Over ⊤ Y⦄ ⦃R : Presieve U⦄, R ∈ J U → R.map F ∈ J' (F.obj U)) :
    RepresentablyFlat F ∧ F.IsContinuous J.toGrothendieck J'.toGrothendieck := by
  have : HasPullbacks (P.Over ⊤ Y) := hasPullbacks_of_isPullback_forget hpb
  let T : P.Over ⊤ Y := MorphismProperty.Over.mk ⊤ (𝟙 Y) (P.id_mem Y)
  have hTiso : IsIso T.hom := inferInstanceAs (IsIso (𝟙 Y))
  have hT : IsTerminal T := isTerminalOfIsIsoHom T
  have : HasTerminal (P.Over ⊤ Y) := hT.hasTerminal
  have : IsIso (F.obj T).hom := hiso T hTiso
  have : PreservesLimit (Functor.empty.{0} (P.Over ⊤ Y)) F :=
    preservesLimit_of_preserves_limit_cone hT
      ((isLimitMapConeEmptyConeEquiv F T).symm (isTerminalOfIsIsoHom (F.obj T)))
  have : PreservesLimitsOfShape (Discrete.{0} PEmpty) F :=
    preservesLimitsOfShape_pempty_of_preservesTerminal F
  have hcospan : ∀ {U₁ U₂ U₃ : P.Over ⊤ Y} (f₁ : U₁ ⟶ U₃) (f₂ : U₂ ⟶ U₃),
      PreservesLimit (cospan f₁ f₂) F := by
    intro U₁ U₂ U₃ f₁ f₂
    obtain ⟨W, p₁, p₂, h⟩ := hpb U₁ U₂ U₃ f₁ f₂
    have hP := isPullback_of_isPullback_forget h
    have hP' := isPullback_of_isPullback_forget (hF h)
    exact preservesLimit_of_preserves_limit_cone hP.isLimit
      ((isLimitMapConePullbackConeEquiv F hP.w).symm hP'.isLimit)
  have : PreservesLimitsOfShape WalkingCospan F :=
    ⟨fun {D} => by
      have := hcospan (D.map WalkingCospan.Hom.inl) (D.map WalkingCospan.Hom.inr)
      exact preservesLimit_of_iso_diagram F (diagramIsoCospan D).symm⟩
  have : PreservesFiniteLimits F := preservesFiniteLimits_of_preservesTerminal_and_pullbacks F
  have : HasFiniteLimits (P.Over ⊤ Y) := hasFiniteLimits_of_hasTerminal_and_pullbacks
  have : RepresentablyFlat F := flat_of_preservesFiniteLimits F
  exact ⟨this, Functor.isContinuous_iff_coverPreserving.2
    (coverPreserving_toGrothendieck_of_preservesPullbacks F J _
      fun U R hR => Precoverage.generate_mem_toGrothendieck (hJ hR))⟩

end GSpace

/-- Reduction: if fibre products exist in `Qét(X(G))` and `Ét(X(G))` with underlying squares
pullbacks of analytic spaces, then restriction along continuous homomorphisms gives morphisms of
sites `X(H)_qét → X(G)_qét` and `X(H)_ét → X(G)_ét`. -/
theorem restrictionSiteMorphism_of_equivariantPullbacks
    (hq : EquivariantQuasiEtalePullbacksStatement.{u, v, z})
    (he : EquivariantEtalePullbacksStatement.{u, v, z}) :
    RestrictionSiteMorphismStatement.{u, v, z, z'} := by
  intro K _ _ _ G _ _ H _ _ f X
  refine ⟨GSpace.representablyFlat_and_isContinuous_of_isPullback_forget
      (EquivariantQuasiEtaleSite.res (X := X) f) (hq K G X) (fun _ _ _ _ _ _ _ _ h => h)
      (fun U hU => (inferInstanceAs (IsIso ((GSpace.res f).map U.hom))))
      (equivariantQuasiEtalePrecoverage X) (equivariantQuasiEtalePrecoverage _)
      (fun _ _ hR => (EquivariantQuasiEtaleSite.map_res_mem_equivariantQuasiEtalePrecoverage_iff
        f).2 hR),
    GSpace.representablyFlat_and_isContinuous_of_isPullback_forget
      (EquivariantEtaleSite.res (X := X) f) (he K G X) (fun _ _ _ _ _ _ _ _ h => h)
      (fun U hU => (inferInstanceAs (IsIso ((GSpace.res f).map U.hom))))
      (equivariantEtalePrecoverage X) (equivariantEtalePrecoverage _)
      (fun _ _ hR => (EquivariantEtaleSite.map_res_mem_equivariantEtalePrecoverage_iff
        f).2 hR)⟩

end Langlands.Analytic.SaturatedAtlasPresentation
