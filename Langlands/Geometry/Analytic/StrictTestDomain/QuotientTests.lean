import Langlands.Geometry.Analytic.StrictTestDomain.Definitions
import Langlands.Geometry.Analytic.TateNoetherian
import Langlands.Geometry.Analytic.ClosedIdealsBanach
import Langlands.Geometry.Analytic.BoundedQuotient
import Langlands.Geometry.Analytic.Spectrum.Quotient
import Mathlib.RingTheory.Ideal.IdempotentFG

/-! # Quotient tests for strictly represented subsets -/

noncomputable section

universe u

namespace Langlands.Analytic

namespace PresentedStrictAffinoidAlgebra

variable {K : Type u} [NormedField K] [IsUltrametricDist K]

/-- Over a complete nontrivially valued field every ideal of a presented strict
affinoid algebra is closed: the algebra is a Noetherian Banach algebra. -/
theorem isClosed_ideal [CompleteSpace K] (hK : ∃ c : K, 1 < ‖c‖)
    (A : PresentedStrictAffinoidAlgebra K) (I : Ideal A) : IsClosed (I : Set A) := by
  let _ : NontriviallyNormedField K :=
    { toNormedField := inferInstance, non_trivial := hK }
  exact isClosed_ideal_of_noetherian_banach (K := K) I

/-- A Tate series maps to zero exactly when it lies in the presentation ideal. -/
theorem presentationMap_eq_zero_iff (B : PresentedStrictAffinoidAlgebra K)
    (f : StrictTateAlgebra (Fin B.arity) K) : presentationMap K B f = 0 ↔ f ∈ B.ideal :=
  Ideal.Quotient.eq_zero_iff_mem

variable (K)

/-- The presented quotient by a closed ideal: the same Tate variables, with the
pulled-back ideal of Tate series. -/
def quotient (A : PresentedStrictAffinoidAlgebra K) (I : Ideal A)
    (hI : IsClosed (I : Set A)) : PresentedStrictAffinoidAlgebra K where
  arity := A.arity
  ideal := I.comap (presentationMap K A).toAlgHom.toRingHom
  ideal_closed := hI.preimage (presentationMap K A).continuous

/-- The bounded quotient map onto the presented quotient. -/
def quotientMap (A : PresentedStrictAffinoidAlgebra K) (I : Ideal A)
    (hI : IsClosed (I : Set A)) : BoundedAlgHom K A (A.quotient K I hI) := by
  letI := A.ideal_closed
  exact BoundedAlgHom.liftQuotient K A.ideal (presentationMap K (A.quotient K I hI))
    (fun a ha => (presentationMap_eq_zero_iff (A.quotient K I hI) a).mpr <| by
      change presentationMap K A a ∈ I
      rw [(presentationMap_eq_zero_iff A a).mpr ha]
      exact I.zero_mem)

variable {K}

@[simp]
theorem quotientMap_presentationMap (A : PresentedStrictAffinoidAlgebra K) (I : Ideal A)
    (hI : IsClosed (I : Set A)) (f : StrictTateAlgebra (Fin A.arity) K) :
    quotientMap K A I hI (presentationMap K A f) =
      presentationMap K (A.quotient K I hI) f := rfl

theorem quotientMap_surjective (A : PresentedStrictAffinoidAlgebra K) (I : Ideal A)
    (hI : IsClosed (I : Set A)) : Function.Surjective (quotientMap K A I hI) := by
  intro b
  obtain ⟨f, rfl⟩ := presentationMap_surjective K (A.quotient K I hI) b
  exact ⟨presentationMap K A f, rfl⟩

theorem quotientMap_eq_zero_iff (A : PresentedStrictAffinoidAlgebra K) (I : Ideal A)
    (hI : IsClosed (I : Set A)) (a : A) : quotientMap K A I hI a = 0 ↔ a ∈ I := by
  obtain ⟨f, rfl⟩ := presentationMap_surjective K A a
  rw [quotientMap_presentationMap]
  exact presentationMap_eq_zero_iff (A.quotient K I hI) f

end PresentedStrictAffinoidAlgebra

namespace StrictTestDomain

open PresentedStrictAffinoidAlgebra

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- If an actual map represents `U` for strict tests and every point killing its
kernel lies in `U`, then the kernel is generated by an idempotent and `U` is the
zero locus of that idempotent. The proof tests the representation on the quotient
by the square of the kernel. -/
theorem exists_idempotent_of_zeroLocus_subset (hK : ∃ c : K, 1 < ‖c‖)
    {P Q : PresentedStrictAffinoidAlgebra K} {i : BoundedAlgHom K P Q}
    {U : Set (BanachSpectrum P)} (hU : Represents K i U)
    (hV : BanachSpectrum.zeroLocus (RingHom.ker i.toAlgHom.toRingHom) ⊆ U) :
    ∃ e : P, IsIdempotentElem e ∧
      RingHom.ker i.toAlgHom.toRingHom = Ideal.span {e} ∧
      U = {x | x e = 0} := by
  set I := RingHom.ker i.toAlgHom.toRingHom with hIdef
  have hI2 := isClosed_ideal hK P (I ^ 2)
  let π := quotientMap K P (I ^ 2) hI2
  have himage : HasImageIn K π U := by
    intro z
    apply hV
    intro a ha
    change z (π a) = 0
    have h2 : π (a ^ 2) = 0 :=
      (quotientMap_eq_zero_iff P (I ^ 2) hI2 _).mpr (Ideal.pow_mem_pow ha 2)
    have hsq : z (π a) ^ 2 = 0 := by
      rw [← map_pow z.toMulRingSeminorm]
      rw [← map_pow π.toAlgHom]
      rw [h2, map_zero]
    exact pow_eq_zero_iff two_ne_zero |>.mp hsq
  obtain ⟨ψ, hψ, -⟩ := hU.2.2 (P.quotient K (I ^ 2) hI2) π himage
  have hle : I ≤ I ^ 2 := by
    intro a ha
    rw [← quotientMap_eq_zero_iff P (I ^ 2) hI2]
    have hpa : ψ (i a) = π a := congrArg (fun χ : BoundedAlgHom K P _ => χ a) hψ
    change π a = 0
    rw [← hpa]
    have hia : i a = 0 := ha
    rw [hia]
    exact map_zero ψ.toAlgHom
  have hidem : IsIdempotentElem I := by
    change I * I = I
    rw [← pow_two]
    exact le_antisymm (Ideal.pow_le_self two_ne_zero) hle
  obtain ⟨e, he, hIe⟩ :=
    (Ideal.isIdempotentElem_iff_of_fg I (IsNoetherian.noetherian I)).mp hidem
  have heI : e ∈ I := by
    rw [hIe]
    exact Submodule.mem_span_singleton_self e
  refine ⟨e, he, hIe, ?_⟩
  ext x
  constructor
  · intro hx
    rw [← hU.2.1] at hx
    obtain ⟨y, rfl⟩ := hx
    change y (i e) = 0
    have hie : i e = 0 := heI
    rw [hie, map_zero]
  · intro hx
    apply hV
    change I ≤ x.kernel
    rw [hIe]
    exact (Submodule.span_singleton_le_iff_mem _ _).mpr hx

end StrictTestDomain

end Langlands.Analytic
