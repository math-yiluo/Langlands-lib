import Langlands.Geometry.Analytic.StrictTestDomain.RationalCovering
import Langlands.Geometry.Analytic.StrictTestDomain.RationalPullbackProof
import Mathlib.CategoryTheory.Sites.CoverPreserving

/-! # Rational base change and finite covering preservation -/

noncomputable section

universe u

namespace Langlands.Analytic.StrictTestDomain.RationalData

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {P Q R : PresentedStrictAffinoidAlgebra K}

namespace Inclusion

/-- Inverse images carry an actual rational-locus inclusion to an inclusion. -/
def pullback {d e : RationalData K P} (h : Inclusion d e)
    (φ : BoundedAlgHom K P Q) : Inclusion (d.pullback φ) (e.pullback φ) :=
  ⟨fun x hx => h.subset (a := BanachSpectrum.comap φ.toBoundedRingHom x) hx⟩

/-- Bounded restriction maps commute with the constructed base-change maps. -/
theorem restriction_pullback_comp_comparison {d e : RationalData K P}
    (h : Inclusion d e) (φ : BoundedAlgHom K P Q) :
    (h.pullback φ).restriction.comp (e.comparison φ) =
      (d.comparison φ).comp h.restriction := by
  apply e.hom_ext
  calc
    ((h.pullback φ).restriction.comp (e.comparison φ)).comp e.baseMap =
        (h.pullback φ).restriction.comp ((e.pullback φ).baseMap.comp φ) := by
          rw [BoundedAlgHom.comp_assoc, e.comparison_comp_baseMap]
    _ = ((d.pullback φ).baseMap).comp φ := by
          rw [← BoundedAlgHom.comp_assoc, restriction_comp_baseMap]
    _ = ((d.comparison φ).comp h.restriction).comp e.baseMap := by
          rw [BoundedAlgHom.comp_assoc, restriction_comp_baseMap,
            d.comparison_comp_baseMap]

end Inclusion

/-- Pull back chosen rational presentations and their actual locus inclusions. -/
def pullbackFunctor (φ : BoundedAlgHom K P Q) : RationalData K P ⥤ RationalData K Q where
  obj d := d.pullback φ
  map h := h.pullback φ
  map_id _ := (inferInstance : Subsingleton (Inclusion _ _)).elim _ _
  map_comp _ _ := (inferInstance : Subsingleton (Inclusion _ _)).elim _ _

omit [CompleteSpace K] in
@[simp]
theorem pullbackFunctor_id : pullbackFunctor (BoundedAlgHom.id K P) = 𝟭 (RationalData K P) := by
  exact CategoryTheory.Functor.ext (fun d => d.pullback_id)
    (fun _ _ _ => (inferInstance : Subsingleton (Inclusion _ _)).elim _ _)

omit [CompleteSpace K] in
@[simp]
theorem pullbackFunctor_comp (φ : BoundedAlgHom K P Q) (ψ : BoundedAlgHom K Q R) :
    pullbackFunctor (ψ.comp φ) = pullbackFunctor φ ⋙ pullbackFunctor ψ := by
  exact CategoryTheory.Functor.ext (fun d => d.pullback_comp φ ψ)
    (fun _ _ _ => (inferInstance : Subsingleton (Inclusion _ _)).elim _ _)

/-- The actual affinoid maps from pulled-back domains to original domains are
natural with respect to rational inclusions. -/
def pullbackComparison (φ : BoundedAlgHom K P Q) :
    pullbackFunctor φ ⋙ toAffinoidSpace K Q ⟶ toAffinoidSpace K P where
  app d := Quiver.Hom.op (d.comparison φ)
  naturality d e h := by
    change Quiver.Hom.op (_ : e.algebra ⟶ (d.pullback φ).algebra) =
      Quiver.Hom.op (_ : e.algebra ⟶ (d.pullback φ).algebra)
    exact congrArg Quiver.Hom.op (h.restriction_pullback_comp_comparison φ)

omit [CompleteSpace K] in
/-- Every point of a pulled-back locus pulls back to a point of the original
locus, so inverse images preserve point-covering families. -/
theorem FamilyCovers.pullback {I : Type u} {d : RationalData K P}
    {D : I → RationalData K P} (h : FamilyCovers d D) (φ : BoundedAlgHom K P Q) :
    FamilyCovers (d.pullback φ) (fun i => (D i).pullback φ) := by
  intro x hx
  exact h (BanachSpectrum.comap φ.toBoundedRingHom x) hx

omit [CompleteSpace K] in
/-- The sieve generated by the image of a covering sieve remains covering. -/
theorem IsFiniteCovering.functorPushforward {d : RationalData K P} {S : Sieve d}
    (hS : IsFiniteCovering S) (φ : BoundedAlgHom K P Q) :
    IsFiniteCovering (S.functorPushforward (pullbackFunctor φ)) := by
  obtain ⟨I, hI, D, f, hf, hcover⟩ := hS
  refine ⟨I, hI, fun i => (D i).pullback φ, fun i => (f i).pullback φ, ?_,
    hcover.pullback φ⟩
  intro i
  exact Sieve.image_mem_functorPushforward (pullbackFunctor φ) S (hf i)

/-- Rational base change preserves the finite rational covering topologies. -/
theorem pullbackFunctor_coverPreserving (φ : BoundedAlgHom K P Q) :
    CoverPreserving (finiteRationalTopology K P) (finiteRationalTopology K Q)
      (pullbackFunctor φ) :=
  ⟨fun hS => hS.functorPushforward φ⟩

end Langlands.Analytic.StrictTestDomain.RationalData
