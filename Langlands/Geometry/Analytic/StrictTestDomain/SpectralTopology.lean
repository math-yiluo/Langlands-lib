import Langlands.Geometry.Analytic.StrictTestDomain.SpectralTransport
import Mathlib.Topology.Algebra.FilterBasis
import Mathlib.Topology.Algebra.OpenSubgroup

/-! # The topology generated by finite rational spectral tests -/

noncomputable section

universe u v w

namespace Langlands.Analytic.StrictTestDomain.RationalAutomorphism

open CategoryTheory
open scoped Pointwise Topology

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  (P : PresentedStrictAffinoidAlgebra K)

/-- The sets underlying finite families of actual rational spectral tests.
The finite index types are chosen in `Type`; the test data still lie over `K`. -/
def rationalSpectralBasisSets : Set (Set (Aut P)) :=
  {U | ∃ (ι : Type) (_ : Finite ι) (tests : ι → RationalSpectralTest K P),
    (finiteRationalSpectralSubgroup tests : Set (Aut P)) = U}

/-- The finite rational spectral test subgroups form a group filter basis.
Inverse transport of tests supplies conjugation control. -/
@[instance_reducible]
def rationalSpectralGroupFilterBasis : GroupFilterBasis (Aut P) where
  sets := rationalSpectralBasisSets P
  nonempty := ⟨_, Empty, inferInstance, Empty.elim, rfl⟩
  inter_sets := by
    rintro _ _ ⟨ι, hι, s, rfl⟩ ⟨κ, hκ, t, rfl⟩
    let := hι
    let := hκ
    refine ⟨_, ⟨ι ⊕ κ, inferInstance, Sum.elim s t, rfl⟩, ?_⟩
    rw [finiteRationalSpectralSubgroup_sum]
    exact Set.Subset.rfl
  one' := by
    rintro _ ⟨ι, hι, tests, rfl⟩
    exact (finiteRationalSpectralSubgroup tests).one_mem
  mul' := by
    rintro _ ⟨ι, hι, tests, rfl⟩
    refine ⟨_, ⟨ι, hι, tests, rfl⟩, ?_⟩
    rintro _ ⟨g, hg, h, hh, rfl⟩
    exact (finiteRationalSpectralSubgroup tests).mul_mem hg hh
  inv' := by
    rintro _ ⟨ι, hι, tests, rfl⟩
    refine ⟨_, ⟨ι, hι, tests, rfl⟩, ?_⟩
    intro g hg
    exact (finiteRationalSpectralSubgroup tests).inv_mem hg
  conj' := by
    rintro g _ ⟨ι, hι, tests, rfl⟩
    let moved := fun i => (tests i).transport g⁻¹
    refine ⟨_, ⟨ι, hι, moved, rfl⟩, ?_⟩
    intro h hh
    change h ∈ finiteRationalSpectralSubgroup moved at hh
    rw [finiteRationalSpectralSubgroup_transport] at hh
    rcases hh with ⟨h, hh, rfl⟩
    change g * (g⁻¹ * h * (g⁻¹)⁻¹) * g⁻¹ ∈ finiteRationalSpectralSubgroup tests
    simp only [inv_inv, mul_assoc, mul_inv_cancel,
      mul_one, mul_inv_cancel_left]
    exact hh

/-- The restricted automorphism topology generated by the rational spectral tests.
No comparison with the full analytic automorphism topology is part of this definition. -/
@[instance_reducible]
def rationalSpectralTopology : TopologicalSpace (Aut P) :=
  (rationalSpectralGroupFilterBasis P).topology

/-- The constructed topology makes bounded automorphisms into a topological group. -/
theorem rationalSpectralTopology_isTopologicalGroup :
    @IsTopologicalGroup (Aut P) (rationalSpectralTopology P) _ :=
  (rationalSpectralGroupFilterBasis P).isTopologicalGroup

/-- Exact neighborhood criterion at the identity, including empty families. -/
theorem mem_nhds_one_rationalSpectralTopology (U : Set (Aut P)) :
    U ∈ @nhds (Aut P) (rationalSpectralTopology P) 1 ↔
      ∃ (ι : Type) (_ : Finite ι) (tests : ι → RationalSpectralTest K P),
        (finiteRationalSpectralSubgroup tests : Set (Aut P)) ⊆ U := by
  change U ∈ @nhds (Aut P) (rationalSpectralGroupFilterBasis P).topology 1 ↔ _
  rw [(rationalSpectralGroupFilterBasis P).nhds_one_hasBasis.mem_iff]
  constructor
  · rintro ⟨V, ⟨ι, hι, tests, rfl⟩, hV⟩
    exact ⟨ι, hι, tests, hV⟩
  · rintro ⟨ι, hι, tests, ht⟩
    exact ⟨_, ⟨ι, hι, tests, rfl⟩, ht⟩

/-- Neighborhoods at any automorphism contain a left translate of a finite
rational spectral test subgroup. -/
theorem mem_nhds_rationalSpectralTopology (g : Aut P) (U : Set (Aut P)) :
    U ∈ @nhds (Aut P) (rationalSpectralTopology P) g ↔
      ∃ (ι : Type) (_ : Finite ι) (tests : ι → RationalSpectralTest K P),
        (fun h => g * h) '' (finiteRationalSpectralSubgroup tests : Set (Aut P)) ⊆ U := by
  change U ∈ @nhds (Aut P) (rationalSpectralGroupFilterBasis P).topology g ↔ _
  rw [(rationalSpectralGroupFilterBasis P).nhds_hasBasis g |>.mem_iff]
  constructor
  · rintro ⟨V, ⟨ι, hι, tests, rfl⟩, hV⟩
    exact ⟨ι, hι, tests, hV⟩
  · rintro ⟨ι, hι, tests, ht⟩
    exact ⟨_, ⟨ι, hι, tests, rfl⟩, ht⟩

/-- Reindexing by any equivalence preserves the finite test subgroup. -/
theorem finiteRationalSpectralSubgroup_reindex {ι : Type v} {κ : Type w}
    [Finite ι] [Finite κ] (e : ι ≃ κ) (tests : κ → RationalSpectralTest K P) :
    finiteRationalSpectralSubgroup (tests ∘ e) = finiteRationalSpectralSubgroup tests := by
  ext g
  simp only [finiteRationalSpectralSubgroup, Subgroup.mem_iInf, Function.comp_apply]
  constructor
  · intro h j
    obtain ⟨i, rfl⟩ := e.surjective j
    exact h i
  · intro h i
    exact h (e i)

/-- The fixed small index universe loses no finite family of tests. -/
theorem finiteRationalSpectralSubgroup_mem_basis {ι : Type v} [Finite ι]
    (tests : ι → RationalSpectralTest K P) :
    (finiteRationalSpectralSubgroup tests : Set (Aut P)) ∈ rationalSpectralBasisSets P := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  exact ⟨Fin n, inferInstance, tests ∘ e.symm,
    congrArg (fun H : Subgroup (Aut P) => (H : Set (Aut P)))
      (finiteRationalSpectralSubgroup_reindex P e.symm tests)⟩

/-- A finite rational spectral test subgroup is an identity neighborhood,
with no restriction on the finite index universe. -/
theorem finiteRationalSpectralSubgroup_mem_nhds_one {ι : Type v} [Finite ι]
    (tests : ι → RationalSpectralTest K P) :
    (finiteRationalSpectralSubgroup tests : Set (Aut P)) ∈
      @nhds (Aut P) (rationalSpectralTopology P) 1 :=
  (rationalSpectralGroupFilterBasis P).mem_nhds_one
    (finiteRationalSpectralSubgroup_mem_basis P tests)

/-- Each finite test subgroup is open in the constructed topology. -/
theorem isOpen_finiteRationalSpectralSubgroup {ι : Type v} [Finite ι]
    (tests : ι → RationalSpectralTest K P) :
    @IsOpen (Aut P) (rationalSpectralTopology P)
      (finiteRationalSpectralSubgroup tests : Set (Aut P)) := by
  let := rationalSpectralTopology P
  let := rationalSpectralTopology_isTopologicalGroup P
  exact (finiteRationalSpectralSubgroup tests).isOpen_of_mem_nhds
    (finiteRationalSpectralSubgroup_mem_nhds_one P tests)

end Langlands.Analytic.StrictTestDomain.RationalAutomorphism
