import Langlands.Geometry.Analytic.StrictTestDomain.RationalTransportContinuity

/-! # Normalization of finite rational transport coverings -/

noncomputable section

universe u

namespace Langlands.Analytic.StrictTestDomain.RationalTransport

open CategoryTheory RationalAutomorphism

variable {K : Type u} [NormedField K] [IsUltrametricDist K]
  {P : PresentedStrictAffinoidAlgebra K}

/-- Translate the source of a labelled arrow to obtain an ordinary inclusion. -/
def normalizedInclusion {U V : RationalTransport K P} (f : U ⟶ V) :
    f.label • U.data ⟶ V.data :=
  ⟨by
    intro x hx
    rw [locus_smul] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact f.mapsTo y hy⟩

/-- Every labelled arrow factors through its translated source. -/
theorem translationIso_hom_comp_normalizedInclusion {U V : RationalTransport K P}
    (f : U ⟶ V) :
    (translationIso f.label U).hom ≫ inclusion.map (normalizedInclusion f) = f := by
  apply Hom.ext
  exact one_mul _

/-- Undoing the translation leaves an identity-labelled inclusion. -/
theorem translationIso_inv_comp_eq_normalizedInclusion {U V : RationalTransport K P}
    (f : U ⟶ V) :
    (translationIso f.label U).inv ≫ f = inclusion.map (normalizedInclusion f) := by
  apply Hom.ext
  exact mul_inv_cancel _

/-- The ordinary inclusions belonging to a transport sieve. -/
abbrev inclusionSieve {V : RationalTransport K P} (S : Sieve V) : Sieve V.data :=
  Sieve.functorPullback (X := V.data) inclusion S

/-- Normalization preserves membership in any sieve, not only a covering sieve. -/
theorem normalizedInclusion_mem_iff {U V : RationalTransport K P}
    (S : Sieve V) (f : U ⟶ V) :
    inclusionSieve S (normalizedInclusion f) ↔ S f := by
  constructor
  · intro hf
    have h := S.downward_closed hf (translationIso f.label U).hom
    exact (congrArg (fun g : U ⟶ V => S g)
      (translationIso_hom_comp_normalizedInclusion f)).mp h
  · intro hf
    have h := S.downward_closed hf (translationIso f.label U).inv
    change S (inclusion.map (normalizedInclusion f))
    rwa [translationIso_inv_comp_eq_normalizedInclusion] at h

/-- Every transport sieve is generated by the ordinary inclusions it contains. -/
theorem inclusionSieve_functorPushforward {V : RationalTransport K P} (S : Sieve V) :
    (inclusionSieve S).functorPushforward inclusion = S := by
  apply le_antisymm
  · exact Sieve.functorPullback_pushforward_le inclusion S
  · intro U f hf
    have hi := (normalizedInclusion_mem_iff S f).mpr hf
    have h := Sieve.image_mem_functorPushforward inclusion (inclusionSieve S) hi
    have h' := ((inclusionSieve S).functorPushforward inclusion).downward_closed h
      (translationIso f.label U).hom
    exact (congrArg (fun g : U ⟶ V => (inclusionSieve S).functorPushforward inclusion g)
      (translationIso_hom_comp_normalizedInclusion f)).mp h'

/-- Labelled images cover exactly when the translated source loci cover.
This equivalence itself does not require finiteness of the family. -/
theorem familyCovers_normalized_iff {I : Type u} {V : RationalTransport K P}
    (D : I → RationalTransport K P) (f : ∀ i, D i ⟶ V) :
    FamilyCovers D f ↔
      RationalData.FamilyCovers V.data (fun i => (f i).label • (D i).data) := by
  constructor
  · intro h x hx
    obtain ⟨i, y, hy, heq⟩ := h x hx
    refine ⟨i, ?_⟩
    rw [locus_smul]
    exact ⟨y, hy, heq⟩
  · intro h x hx
    obtain ⟨i, hi⟩ := h x hx
    rw [locus_smul] at hi
    obtain ⟨y, hy, heq⟩ := hi
    exact ⟨i, y, hy, heq⟩

variable [CompleteSpace K]

/-- A transport sieve covers exactly when its ordinary inclusion sieve has
a finite rational cover. The same finite index type works in each direction. -/
theorem mem_finiteTopology_iff_inclusionSieve {V : RationalTransport K P}
    (S : Sieve V) :
    S ∈ finiteTopology K P V ↔
      inclusionSieve S ∈ RationalData.finiteRationalTopology K P V.data := by
  constructor
  · rintro ⟨I, hI, D, f, hf, hcover⟩
    exact ⟨I, hI, fun i => (f i).label • (D i).data,
      fun i => normalizedInclusion (f i),
      fun i => (normalizedInclusion_mem_iff S (f i)).mpr (hf i),
      (familyCovers_normalized_iff D f).mp hcover⟩
  · rintro ⟨I, hI, D, f, hf, hcover⟩
    exact ⟨I, hI, fun i => inclusion.obj (D i), fun i => inclusion.map (f i),
      hf, (familyCovers_inclusion_iff D f).mpr hcover⟩

end Langlands.Analytic.StrictTestDomain.RationalTransport
