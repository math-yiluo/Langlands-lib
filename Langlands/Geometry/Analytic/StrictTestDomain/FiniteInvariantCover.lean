import Langlands.Geometry.Analytic.StrictTestDomain.InvariantRestrictionSite

/-! # Lifting finite rational covers to a common open subgroup -/

noncomputable section

universe u v w

namespace Langlands.Analytic.StrictTestDomain.RationalAutomorphism.RationalSpectralAction

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {P : PresentedStrictAffinoidAlgebra K}
  {G : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  (ρ : RationalSpectralAction G P)

/-- Retain every actual rational presentation in a finite family, now invariant
under the constructed common open subgroup of U. -/
def finiteInvariantFamily (U : OpenSubgroup G) {I : Type w} [Finite I]
    (D : I → RationalData K P) (i : I) :
    ρ.InvariantRationalDomain (ρ.finiteFamilyOpenSubgroup U D) :=
  ⟨D i, ρ.finiteFamilyOpenSubgroup_le_stabilizer U D i⟩

@[simp]
theorem finiteInvariantFamily_obj (U : OpenSubgroup G) {I : Type w} [Finite I]
    (D : I → RationalData K P) (i : I) :
    (ρ.finiteInvariantFamily U D i).obj = D i :=
  rfl

/-- An input inclusion becomes an actual equivariant rational inclusion into
the restricted target, without changing its bounded restriction map. -/
def finiteInvariantFamilyArrow (U : OpenSubgroup G) {I : Type w} [Finite I]
    (d : ρ.InvariantRationalDomain U) (D : I → RationalData K P)
    (f : ∀ i, D i ⟶ d.obj) (i : I) :
    ρ.finiteInvariantFamily U D i ⟶
      (ρ.invariantRestrictionFunctor (ρ.finiteFamilyOpenSubgroup_le U D)).obj d :=
  ObjectProperty.homMk (f i)

@[simp]
theorem finiteInvariantFamilyArrow_hom (U : OpenSubgroup G) {I : Type w} [Finite I]
    (d : ρ.InvariantRationalDomain U) (D : I → RationalData K P)
    (f : ∀ i, D i ⟶ d.obj) (i : I) :
    (ρ.finiteInvariantFamilyArrow U d D f i).hom = f i :=
  rfl

/-- The sieve generated by the lifted finite family at its actual common
open subgroup. No covering hypothesis is needed to construct it. -/
def finiteInvariantFamilySieve (U : OpenSubgroup G) {I : Type w} [Finite I]
    (d : ρ.InvariantRationalDomain U) (D : I → RationalData K P)
    (f : ∀ i, D i ⟶ d.obj) :
    Sieve ((ρ.invariantRestrictionFunctor (ρ.finiteFamilyOpenSubgroup_le U D)).obj d) :=
  Sieve.ofArrows (ρ.finiteInvariantFamily U D) (ρ.finiteInvariantFamilyArrow U d D f)

/-- Forgetting invariance sends the lifted generated sieve to exactly the
original generated rational sieve. -/
theorem finiteInvariantFamilySieve_pushforward (U : OpenSubgroup G)
    {I : Type w} [Finite I] (d : ρ.InvariantRationalDomain U)
    (D : I → RationalData K P) (f : ∀ i, D i ⟶ d.obj) :
    (ρ.finiteInvariantFamilySieve U d D f).functorPushforward
        (ρ.invariantRationalProperty (ρ.finiteFamilyOpenSubgroup U D)).ι =
      Sieve.ofArrows D f := by
  rw [finiteInvariantFamilySieve, Sieve.functorPushforward_ofArrows]
  rfl

/-- A finite lifted family covers exactly when its unchanged actual loci cover.
The finite index type may be empty. -/
theorem finiteInvariantFamilySieve_mem_iff (U : OpenSubgroup G)
    {I : Type u} [Finite I] (d : ρ.InvariantRationalDomain U)
    (D : I → RationalData K P) (f : ∀ i, D i ⟶ d.obj) :
    ρ.finiteInvariantFamilySieve U d D f ∈
        InvariantRationalDomain.finiteRationalTopology ρ (ρ.finiteFamilyOpenSubgroup U D)
          ((ρ.invariantRestrictionFunctor (ρ.finiteFamilyOpenSubgroup_le U D)).obj d) ↔
      RationalData.FamilyCovers d.obj D := by
  exact InvariantRationalDomain.ofArrows_mem_finiteRationalTopology_iff ρ
    (ρ.finiteFamilyOpenSubgroup U D) (ρ.finiteInvariantFamily U D)
    (ρ.finiteInvariantFamilyArrow U d D f)

/-- Generated finite rational covers lift and reflect covering at the
constructed common open subgroup. -/
theorem finiteInvariantFamilySieve_mem_iff_original (U : OpenSubgroup G)
    {I : Type u} [Finite I] (d : ρ.InvariantRationalDomain U)
    (D : I → RationalData K P) (f : ∀ i, D i ⟶ d.obj) :
    ρ.finiteInvariantFamilySieve U d D f ∈
        InvariantRationalDomain.finiteRationalTopology ρ (ρ.finiteFamilyOpenSubgroup U D)
          ((ρ.invariantRestrictionFunctor (ρ.finiteFamilyOpenSubgroup_le U D)).obj d) ↔
      Sieve.ofArrows D f ∈ RationalData.finiteRationalTopology K P d.obj := by
  rw [ρ.finiteInvariantFamilySieve_mem_iff, RationalData.ofArrows_mem_finiteRationalTopology_iff]

/-- The lifted cover condition is joint surjectivity of the actual continuous
equivariant spectrum maps induced by the original bounded restrictions. -/
theorem finiteInvariantFamily_jointly_surjective_iff (U : OpenSubgroup G)
    {I : Type u} [Finite I] (d : ρ.InvariantRationalDomain U)
    (D : I → RationalData K P) (f : ∀ i, D i ⟶ d.obj) :
    RationalData.FamilyCovers d.obj D ↔
      ∀ x : BanachSpectrum d.obj.algebra,
        ∃ (i : I) (y : BanachSpectrum (D i).algebra),
          ((ρ.invariantSpectrumFunctor (ρ.finiteFamilyOpenSubgroup U D)).map
            (ρ.finiteInvariantFamilyArrow U d D f i)).hom.hom y = x :=
  InvariantRationalDomain.familyCovers_iff_jointly_surjective ρ
    (ρ.finiteFamilyOpenSubgroup U D) (ρ.finiteInvariantFamily U D)
    (ρ.finiteInvariantFamilyArrow U d D f)

/-- An ordinary rational sieve is a finite cover exactly when it becomes a
covering sieve of invariant domains after shrinking the prescribed open subgroup.
The forward direction uses the actual common stabilizer of a finite witnessing
family; the reverse direction forgets invariance without changing that family. -/
theorem finiteCovering_iff_exists_invariantPullback (U : OpenSubgroup G)
    (d : ρ.InvariantRationalDomain U) (S : Sieve d.obj) :
    S ∈ RationalData.finiteRationalTopology K P d.obj ↔
      ∃ (V : OpenSubgroup G) (h : V ≤ U),
        S.functorPullback (X := (ρ.invariantRestrictionFunctor h).obj d)
            (ρ.invariantRationalProperty V).ι ∈
          InvariantRationalDomain.finiteRationalTopology ρ V
            ((ρ.invariantRestrictionFunctor h).obj d) := by
  constructor
  · rintro ⟨I, hI, D, f, hf, hcover⟩
    let : Finite I := hI
    refine ⟨ρ.finiteFamilyOpenSubgroup U D, ρ.finiteFamilyOpenSubgroup_le U D,
      I, inferInstance, ρ.finiteInvariantFamily U D,
      ρ.finiteInvariantFamilyArrow U d D f, ?_, hcover⟩
    exact hf
  · rintro ⟨V, h, I, hI, D, f, hf, hcover⟩
    exact ⟨I, hI, fun i => (D i).obj, fun i => (f i).hom, hf, hcover⟩

end Langlands.Analytic.StrictTestDomain.RationalAutomorphism.RationalSpectralAction
