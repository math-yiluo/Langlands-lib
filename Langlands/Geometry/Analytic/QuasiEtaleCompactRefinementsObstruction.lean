import Langlands.Geometry.Analytic.QuasiEtaleCompactRefinementsStatement
import Langlands.CategoryTheory.Sites.PointwiseCovering

/-! # The obstruction from a pulled-back two-piece cover -/

noncomputable section

universe u v

namespace Langlands.Analytic.SaturatedAtlasPresentation

open _root_.CategoryTheory Filter Set
open Langlands.CategoryTheory.PointwiseCovering
open Langlands.Sheaf.Equivariant.Analytic
open scoped Topology

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {X : LocalizedCategory.{u, v, v} (K := K)}

/-- Pull back the sieve generated by the two arrows `d` and `e` along `f`. -/
def twoPiecePullbackSieve {U V D E : QuasiEtaleSite X}
    (f : U ⟶ V) (d : D ⟶ V) (e : E ⟶ V) : Sieve U :=
  (Sieve.generate (Presieve.singleton d ⊔ Presieve.singleton e)).pullback f

private abbrev sitePoints (X : LocalizedCategory.{u, v, v} (K := K)) :
    QuasiEtaleSite X ⥤ Type v :=
  MorphismProperty.Over.forget _ _ X ⋙ Over.forget X ⋙ localizedSpaceFunctor ⋙
    forget TopCat

private theorem isJointlySurjective_of_mem_quasiEtaleTopology
    (hlift : HasPointwiseLiftingSquares (sitePoints X)) {U : QuasiEtaleSite X}
    {S : Sieve U} (hS : S ∈ quasiEtaleTopology X U) :
    IsJointlySurjective (sitePoints X) S := by
  induction hS with
  | of U R hR =>
    intro x
    obtain ⟨σ, _, hn, hσ⟩ := mem_quasiEtalePrecoverage_iff.mp hR x
    obtain ⟨T, hT, hx⟩ := Set.mem_sUnion.mp (mem_of_mem_nhds hn)
    obtain ⟨V, f, i, hf, rfl⟩ := hσ T hT
    obtain ⟨y, _, hy⟩ := hx
    exact ⟨V, f, Sieve.le_generate R _ _ hf, y, hy⟩
  | top U => exact isJointlySurjective_top U
  | pullback U S hS V f ih => exact ih.pullback hlift f
  | transitive U S R hS hR ihS ihR => exact ihS.transitive ihR

private theorem pointMap_comp_apply {U V W : QuasiEtaleSite X}
    (f : U ⟶ V) (g : V ⟶ W) (x : localizedSpaceFunctor.obj U.left) :
    localizedSpaceFunctor.map (f ≫ g).left x =
      localizedSpaceFunctor.map g.left (localizedSpaceFunctor.map f.left x) := by
  change (sitePoints X).map (f ≫ g) x = _
  rw [Functor.map_comp]
  rfl

private theorem range_subset_of_mem_twoPiecePullback {U V D E W : QuasiEtaleSite X}
    (f : U ⟶ V) (d : D ⟶ V) (e : E ⟶ V) (g : W ⟶ U)
    (hg : twoPiecePullbackSieve f d e g) :
    Set.range (localizedSpaceFunctor.map g.left) ⊆
        localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map d.left) ∨
      Set.range (localizedSpaceFunctor.map g.left) ⊆
        localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map e.left) := by
  obtain ⟨T, p, q, hq, hcomp⟩ := hg
  change Presieve.singleton d q ∨ Presieve.singleton e q at hq
  rcases hq with hq | hq
  · cases hq
    left
    rintro _ ⟨y, rfl⟩
    refine ⟨localizedSpaceFunctor.map p.left y, ?_⟩
    rw [← pointMap_comp_apply p d, hcomp, pointMap_comp_apply g f]
  · cases hq
    right
    rintro _ ⟨y, rfl⟩
    refine ⟨localizedSpaceFunctor.map p.left y, ?_⟩
    rw [← pointMap_comp_apply p e, hcomp, pointMap_comp_apply g f]

private theorem not_mem_nhds_sUnion_of_twoPieces {α : Type*} [TopologicalSpace α]
    [T2Space α] {D E : Set α} {x : α} (hd : D ∉ 𝓝 x) (he : x ∉ E)
    {σ : Set (Set α)} (hσ : σ.Finite)
    (hpieces : ∀ T ∈ σ, IsCompact T ∧ (T ⊆ D ∨ T ⊆ E)) : ⋃₀ σ ∉ 𝓝 x := by
  let τ := {T ∈ σ | T ⊆ E}
  have hτ : τ.Finite := hσ.subset fun _ h => h.1
  have hclosed : IsClosed (⋃₀ τ) :=
    hτ.isClosed_sUnion fun T hT => (hpieces T hT.1).1.isClosed
  have hx : x ∈ (⋃₀ τ)ᶜ := by
    rintro ⟨T, hT, hxT⟩
    exact he (hT.2 hxT)
  intro hn
  apply hd (Filter.mem_of_superset (inter_mem hn (hclosed.isOpen_compl.mem_nhds hx)) ?_)
  rintro y ⟨⟨T, hT, hyT⟩, hyτ⟩
  rcases (hpieces T hT).2 with hD | hE
  · exact hD hyT
  · exact False.elim (hyτ ⟨T, ⟨hT, hE⟩, hyT⟩)

/-- The pullback of a two-piece sieve with the indicated boundary contains no
presieve in the defining quasi-étale precoverage. -/
theorem not_exists_precoverage_le_twoPiecePullback {U V D E : QuasiEtaleSite X}
    (f : U ⟶ V) (d : D ⟶ V) (e : E ⟶ V) [T2Space (localizedSpaceFunctor.obj U.left)]
    (x : localizedSpaceFunctor.obj U.left)
    (hd : localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map d.left)
      ∉ 𝓝 x)
    (he : localizedSpaceFunctor.map f.left x ∉ Set.range (localizedSpaceFunctor.map e.left)) :
    ¬ ∃ R : Presieve U, R ∈ quasiEtalePrecoverage X U ∧
      R ≤ (twoPiecePullbackSieve f d e).arrows := by
  rintro ⟨R, hR, hle⟩
  obtain ⟨σ, hσ, hn, hcharts⟩ := mem_quasiEtalePrecoverage_iff.mp hR x
  refine not_mem_nhds_sUnion_of_twoPieces
    (E := localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map e.left))
    hd he hσ (fun T hT => ?_) hn
  obtain ⟨W, g, i, hg, rfl⟩ := hcharts T hT
  let chartSpace := localizedObjectEquiv.symm W.left
  refine ⟨((chartSpace.isCompactDomain_chartDomain i).1.image
    (localizedSpaceFunctor.map g.left).hom.continuous), ?_⟩
  exact (range_subset_of_mem_twoPiecePullback f d e g (hle _ _ hg)).imp
    (fun h => (Set.image_subset_range _ _).trans h)
    (fun h => (Set.image_subset_range _ _).trans h)

/-- The two-piece pullback cannot contain a finite compact family whose
images are dense in the target. -/
theorem not_dense_iUnion_range_of_twoPiecePullback {U V D E : QuasiEtaleSite X}
    (f : U ⟶ V) (d : D ⟶ V) (e : E ⟶ V) [T2Space (localizedSpaceFunctor.obj U.left)]
    (x : localizedSpaceFunctor.obj U.left)
    (hd : localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map d.left)
      ∉ 𝓝 x)
    (he : localizedSpaceFunctor.map f.left x ∉ Set.range (localizedSpaceFunctor.map e.left))
    {n : ℕ} {W : Fin n → QuasiEtaleSite X} (g : ∀ i, W i ⟶ U)
    (hW : ∀ i, IsCompactSpace (W i).left)
    (hg : ∀ i, twoPiecePullbackSieve f d e (g i)) :
    ¬ Dense (⋃ i, Set.range (localizedSpaceFunctor.map (g i).left)) := by
  let images : Fin n → Set (localizedSpaceFunctor.obj U.left) :=
    fun i => Set.range (localizedSpaceFunctor.map (g i).left)
  have hpieces (T) (hT : T ∈ Set.range images) :
      IsCompact T ∧
        (T ⊆ localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map d.left) ∨
          T ⊆ localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map e.left)) := by
    obtain ⟨i, rfl⟩ := hT
    let : CompactSpace (localizedSpaceFunctor.obj (W i).left) := (hW i).1
    exact ⟨isCompact_range (localizedSpaceFunctor.map (g i).left).hom.continuous,
      range_subset_of_mem_twoPiecePullback f d e (g i) (hg i)⟩
  intro hdense
  have hfinite := Set.finite_range images
  have hclosed := hfinite.isClosed_sUnion fun T hT => (hpieces T hT).1.isClosed
  change Dense (⋃ i, images i) at hdense
  rw [← Set.sUnion_range] at hdense
  have huniv := dense_iff_closure_eq.mp hdense
  rw [hclosed.closure_eq] at huniv
  exact not_mem_nhds_sUnion_of_twoPieces hd he hfinite hpieces (huniv.symm ▸ Filter.univ_mem)

/-- Density of covering finite compact families over the source of a
two-piece pullback suffices to rule out finite compact refinement. -/
theorem not_hasFiniteCompactQuasiEtaleRefinements_of_twoPieceCover_of_dense
    {U V D E : QuasiEtaleSite X} (f : U ⟶ V) (d : D ⟶ V) (e : E ⟶ V)
    (hU : IsCompactSpace U.left)
    (hcover : (Presieve.singleton d ⊔ Presieve.singleton e) ∈ quasiEtalePrecoverage X V)
    (x : localizedSpaceFunctor.obj U.left)
    (hd : localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map d.left)
      ∉ 𝓝 x)
    (he : localizedSpaceFunctor.map f.left x ∉ Set.range (localizedSpaceFunctor.map e.left))
    (hdense : ∀ {n : ℕ} (W : Fin n → QuasiEtaleSite X) (g : ∀ i, W i ⟶ U),
      (∀ i, IsCompactSpace (W i).left) → Sieve.ofArrows W g ∈ quasiEtaleTopology X U →
        Dense (⋃ i, Set.range (localizedSpaceFunctor.map (g i).left))) :
    ¬ HasFiniteCompactQuasiEtaleRefinements X := by
  intro hRefine
  have hS : twoPiecePullbackSieve f d e ∈ quasiEtaleTopology X U :=
    (quasiEtaleTopology X).pullback_stable f (generate_mem_quasiEtaleTopology hcover)
  obtain ⟨n, W, g, hW, hg, hGen⟩ := hRefine hU hS
  let : T2Space (localizedSpaceFunctor.obj U.left) := hU.2
  exact not_dense_iUnion_range_of_twoPiecePullback f d e x hd he g hW hg (hdense W g hW hGen)

/-- Pulling back a cover made of two arrows can obstruct finite compact
refinement if one inverse-image locus contains a boundary point and the other
locus misses it. The point-lifting hypothesis ensures that a covering
refinement would have to be jointly surjective. -/
theorem not_hasFiniteCompactQuasiEtaleRefinements_of_twoPieceCover
    (hlift : HasPointwiseLiftingSquares (sitePoints X))
    {U V D E : QuasiEtaleSite X} (f : U ⟶ V) (d : D ⟶ V) (e : E ⟶ V)
    (hU : IsCompactSpace U.left)
    (hcover : (Presieve.singleton d ⊔ Presieve.singleton e) ∈ quasiEtalePrecoverage X V)
    (x : localizedSpaceFunctor.obj U.left)
    (hd : localizedSpaceFunctor.map f.left ⁻¹' Set.range (localizedSpaceFunctor.map d.left)
      ∉ 𝓝 x)
    (he : localizedSpaceFunctor.map f.left x ∉ Set.range (localizedSpaceFunctor.map e.left)) :
    ¬ HasFiniteCompactQuasiEtaleRefinements X := by
  apply not_hasFiniteCompactQuasiEtaleRefinements_of_twoPieceCover_of_dense f d e hU hcover x hd he
  intro n W g _ hGen
  have huniv : (⋃ i, Set.range (localizedSpaceFunctor.map (g i).left)) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro y
    obtain ⟨T, p, hp, z, hz⟩ := isJointlySurjective_of_mem_quasiEtaleTopology hlift hGen y
    obtain ⟨i, q, rfl⟩ := Sieve.ofArrows.exists hp
    exact Set.mem_iUnion.mpr ⟨i, localizedSpaceFunctor.map q.left z,
      (pointMap_comp_apply q (g i) z).symm.trans hz⟩
  rw [huniv]
  exact dense_univ

end Langlands.Analytic.SaturatedAtlasPresentation
