import Langlands.Geometry.Analytic.PolydiscRestriction
import Mathlib.RingTheory.FiniteType

/-! # Actual affinoid charts of a finitely presented polynomial locus -/

noncomputable section

universe u v

namespace Langlands.Analytic

/-- A finite polynomial presentation, retaining the actual algebra map. -/
structure FinitePolynomialPresentation (K : Type u) (A : Type v)
    [CommRing K] [CommRing A] [Algebra K A] where
  arity : ℕ
  map : MvPolynomial (Fin arity) K →ₐ[K] A
  surjective : Function.Surjective map

namespace FinitePolynomialPresentation

variable (K : Type u) (A : Type v) [CommRing K] [CommRing A] [Algebra K A]

/-- Choose a genuine polynomial surjection from finite generation. -/
def ofFiniteType [Algebra.FiniteType K A] : FinitePolynomialPresentation K A := by
  let h := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType K A)
  exact ⟨Classical.choose h, Classical.choose (Classical.choose_spec h),
    Classical.choose_spec (Classical.choose_spec h)⟩

end FinitePolynomialPresentation

namespace PolynomialLocus

open GeneralizedTateAlgebra PresentedAffinoidAlgebra

variable {K : Type u} [NormedField K] [IsUltrametricDist K]
  {A : Type v} [CommRing A] [Algebra K A] (P : FinitePolynomialPresentation K A)

/-- Images of all polynomial kernel elements in the actual weighted Tate algebra. -/
def relations (r : PositivePolyradius (Fin P.arity)) :
    Set (GeneralizedTateAlgebra r K) :=
  GeneralizedTateAlgebra.polynomialMap r K ''
    (RingHom.ker P.map.toRingHom : Set (MvPolynomial (Fin P.arity) K))

/-- The quotient by the closed ideal generated by the polynomial kernel. -/
abbrev chart (r : PositivePolyradius (Fin P.arity)) : PresentedAffinoidAlgebra K :=
  ofRelations K P.arity r (relations P r)

/-- The actual polynomial map into the closed relation quotient. -/
def polynomialMap (r : PositivePolyradius (Fin P.arity)) :
    MvPolynomial (Fin P.arity) K →ₐ[K] chart P r :=
  (presentationMap K (chart P r)).toAlgHom.comp
    (GeneralizedTateAlgebra.polynomialMap r K)

@[simp]
theorem polynomialMap_X (r : PositivePolyradius (Fin P.arity)) (i : Fin P.arity) :
    polynomialMap P r (MvPolynomial.X i) = coordinate K (chart P r) i := by
  exact congrArg (presentationMap K (chart P r))
    (MvPolynomial.aeval_X (fun j => monomial r K (Finsupp.single j 1) 1) i)

theorem polynomialMap_relation (r : PositivePolyradius (Fin P.arity))
    {p : MvPolynomial (Fin P.arity) K} (hp : P.map p = 0) :
    polynomialMap P r p = 0 :=
  presentationMap_relation K P.arity r (relations P r) ⟨p, hp, rfl⟩

/-- Descend the polynomial map along its specified surjection onto `A`. -/
def algebraMap (r : PositivePolyradius (Fin P.arity)) : A →ₐ[K] chart P r :=
  AlgHom.liftOfSurjective P.map P.surjective (polynomialMap P r)
    (fun _ hp => polynomialMap_relation P r hp)

@[simp]
theorem algebraMap_map (r : PositivePolyradius (Fin P.arity))
    (p : MvPolynomial (Fin P.arity) K) :
    algebraMap P r (P.map p) = polynomialMap P r p :=
  AlgHom.liftOfSurjective_apply _ _ _ _ p

theorem algebraMap_comp (r : PositivePolyradius (Fin P.arity)) :
    (algebraMap P r).comp P.map = polynomialMap P r :=
  AlgHom.liftOfSurjective_comp _ _ _ _

variable (s t : PositivePolyradius (Fin P.arity)) (hts : ∀ i, t i ≤ s i)

theorem restrictRadius_polynomial (p : MvPolynomial (Fin P.arity) K) :
    restrictRadius s t hts K (GeneralizedTateAlgebra.polynomialMap s K p) =
      GeneralizedTateAlgebra.polynomialMap t K p := by
  have h : (restrictRadius s t hts K).comp
      (GeneralizedTateAlgebra.polynomialMap s K) =
        GeneralizedTateAlgebra.polynomialMap t K := by
    ext i : 1
    simp only [AlgHom.comp_apply, GeneralizedTateAlgebra.polynomialMap, MvPolynomial.aeval_X]
    exact restrictRadius_monomial s t hts K _ _
  exact DFunLike.congr_fun h p

/-- The bounded coefficient restriction descended through the closed relations. -/
def restriction : BoundedAlgHom K (chart P s) (chart P t) :=
  descendRelations K P.arity s (relations P s) (chart P t)
    ((presentationMap K (chart P t)).comp (boundedRestrictRadius s t hts K))
    (by
      rintro _ ⟨p, hp, rfl⟩
      change presentationMap K (chart P t)
        (restrictRadius s t hts K (GeneralizedTateAlgebra.polynomialMap s K p)) = 0
      rw [restrictRadius_polynomial P s t hts]
      exact polynomialMap_relation P t hp)

@[simp]
theorem restriction_presentationMap (f : GeneralizedTateAlgebra s K) :
    restriction P s t hts (presentationMap K (chart P s) f) =
      presentationMap K (chart P t) (restrictRadius s t hts K f) := rfl

@[simp]
theorem restriction_coordinate (i : Fin P.arity) :
    restriction P s t hts (coordinate K (chart P s) i) =
      coordinate K (chart P t) i := by
  change presentationMap K (chart P t) (restrictRadius s t hts K (X s K i)) = _
  rw [restrictRadius_X]
  rfl

@[simp]
theorem restriction_polynomial (p : MvPolynomial (Fin P.arity) K) :
    restriction P s t hts (polynomialMap P s p) = polynomialMap P t p := by
  change presentationMap K (chart P t)
    (restrictRadius s t hts K (GeneralizedTateAlgebra.polynomialMap s K p)) = _
  rw [restrictRadius_polynomial P s t hts]
  rfl

@[simp]
theorem restriction_algebraMap (a : A) :
    restriction P s t hts (algebraMap P s a) = algebraMap P t a := by
  obtain ⟨p, rfl⟩ := P.surjective a
  rw [algebraMap_map, algebraMap_map, restriction_polynomial]

theorem restriction_self :
    restriction P s s (fun _ => le_rfl) = BoundedAlgHom.id K (chart P s) := by
  apply hom_ext_coordinate
  exact restriction_coordinate P s s (fun _ => le_rfl)

set_option maxHeartbeats 800000 in
theorem restriction_trans (q : PositivePolyradius (Fin P.arity))
    (hqt : ∀ i, q i ≤ t i) :
    restriction P s q (fun i => (hqt i).trans (hts i)) =
      (restriction P t q hqt).comp (restriction P s t hts) := by
  apply hom_ext_coordinate
  intro i
  change _ = restriction P t q hqt
    (restriction P s t hts (coordinate K (chart P s) i))
  exact (restriction_coordinate P s q _ i).trans
    ((restriction_coordinate P t q hqt i).symm.trans
      (congrArg (restriction P t q hqt) (restriction_coordinate P s t hts i).symm))

/-- The coordinate Weierstrass chart inside the larger polynomial locus. -/
def weierstrassChart : RationalChart K (chart P s) where
  arity := P.arity
  radii := t
  denominator := 1
  numerators := fun i => X s K i
  generates := by
    apply Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _))
    rw [map_one]
    exact isUnit_one

theorem weierstrassChart_locus :
    (weierstrassChart P s t).locus =
      {x | ∀ i, x (coordinate K (chart P s) i) ≤ t i} := by
  ext x
  change (∀ i, x (presentationMap K (chart P s) (X s K i)) ≤
    t i * x (presentationMap K (chart P s) 1)) ↔ _
  simp only [map_one, mul_one]
  rfl

private theorem coordinate_bounded :
    HasBoundedMonomials t (chart P t) (coordinate K (chart P t)) :=
  ⟨1, zero_lt_one, fun d => by
    rw [one_mul]
    exact monomialValue_norm_le_weight t _ (norm_one_le K _) _
      (norm_coordinate_le K (chart P t)) d⟩

private theorem fraction_bounded :
    HasBoundedMonomials t (weierstrassChart P s t).algebra
      (PresentedAffinoidAlgebra.RationalPresentation.fraction K (chart P s) t 1 (fun i => X s K i)) :=
  ⟨1, zero_lt_one, fun d => by
    rw [one_mul]
    exact monomialValue_norm_le_weight t _ (norm_one_le K _) _
      (PresentedAffinoidAlgebra.RationalPresentation.norm_fraction_le K (chart P s) t 1 (fun i => X s K i)) d⟩

variable [CompleteSpace K]

/-- The actual map from the coordinate Weierstrass algebra to the smaller quotient. -/
def fromChart : BoundedAlgHom K (weierstrassChart P s t).algebra (chart P t) :=
  PresentedAffinoidAlgebra.RationalPresentation.liftFromBase K (chart P s) t 1 (fun i => X s K i) _
    (restriction P s t hts) (coordinate K (chart P t)) (coordinate_bounded P t)
    (by
      intro i
      rw [map_one, map_one, one_mul]
      exact (restriction_coordinate P s t hts i).symm)

theorem fromChart_comp_baseMap :
    (fromChart P s t hts).comp (weierstrassChart P s t).baseMap =
      restriction P s t hts :=
  PresentedAffinoidAlgebra.RationalPresentation.liftFromBase_comp_baseMap K (chart P s) t 1 (fun i => X s K i) _
    _ _ _ _

private theorem fraction_polynomial (p : MvPolynomial (Fin P.arity) K) :
    evaluateHom t K (weierstrassChart P s t).algebra _
      (fraction_bounded P s t) (GeneralizedTateAlgebra.polynomialMap t K p) =
      (weierstrassChart P s t).baseMap (polynomialMap P s p) := by
  have h : (evaluateHom t K (weierstrassChart P s t).algebra _
      (fraction_bounded P s t)).toAlgHom.comp
        (GeneralizedTateAlgebra.polynomialMap t K) =
      (weierstrassChart P s t).baseMap.toAlgHom.comp (polynomialMap P s) := by
    ext i : 1
    simp only [AlgHom.comp_apply, GeneralizedTateAlgebra.polynomialMap,
      MvPolynomial.aeval_X, polynomialMap_X]
    exact (evaluate_X t K (weierstrassChart P s t).algebra
      (PresentedAffinoidAlgebra.RationalPresentation.fraction K (chart P s) t 1 (fun i => X s K i)) i).trans
      (PresentedAffinoidAlgebra.RationalPresentation.weierstrass_fraction K (chart P s) t (fun i => X s K i) i)
  exact DFunLike.congr_fun h p

/-- Evaluation at the new fraction coordinates descends through every polynomial relation. -/
def toChart : BoundedAlgHom K (chart P t) (weierstrassChart P s t).algebra :=
  descendRelations K P.arity t (relations P t) (weierstrassChart P s t).algebra
    (evaluateHom t K _ _ (fraction_bounded P s t))
    (by
      rintro _ ⟨p, hp, rfl⟩
      rw [fraction_polynomial P s t, polynomialMap_relation P s hp, map_zero])

theorem toChart_coordinate (i : Fin P.arity) :
    toChart P s t (coordinate K (chart P t) i) =
      PresentedAffinoidAlgebra.RationalPresentation.fraction K (chart P s) t 1 (fun i => X s K i) i :=
  evaluate_X t K _ _ i

theorem fromChart_toChart (a : chart P t) :
    fromChart P s t hts (toChart P s t a) = a := by
  have h : (fromChart P s t hts).comp (toChart P s t) =
      BoundedAlgHom.id K (chart P t) := by
    apply hom_ext_coordinate
    intro i
    change fromChart P s t hts (toChart P s t (coordinate K (chart P t) i)) = _
    exact (congrArg (fromChart P s t hts) (toChart_coordinate P s t i)).trans
      (PresentedAffinoidAlgebra.RationalPresentation.liftFromBase_fraction K (chart P s) t 1
        (fun i => X s K i) _ _ _ _ _ i)
  exact congrArg (fun φ : BoundedAlgHom K (chart P t) (chart P t) => φ a) h

theorem toChart_fromChart (b : (weierstrassChart P s t).algebra) :
    toChart P s t (fromChart P s t hts b) = b := by
  have h : (toChart P s t).comp (fromChart P s t hts) =
      BoundedAlgHom.id K (weierstrassChart P s t).algebra := by
    apply PresentedAffinoidAlgebra.RationalPresentation.hom_ext_base K (chart P s) t 1 (fun i => X s K i) _
      (weierstrassChart P s t).generates
    apply hom_ext_coordinate
    intro i
    change toChart P s t (fromChart P s t hts
      ((weierstrassChart P s t).baseMap (coordinate K (chart P s) i))) = _
    have hb := congrArg (fun φ : BoundedAlgHom K (chart P s) (chart P t) =>
      φ (coordinate K (chart P s) i)) (fromChart_comp_baseMap P s t hts)
    change fromChart P s t hts
      ((weierstrassChart P s t).baseMap (coordinate K (chart P s) i)) =
        restriction P s t hts (coordinate K (chart P s) i) at hb
    rw [hb]
    exact (congrArg (toChart P s t) (restriction_coordinate P s t hts i)).trans
      ((toChart_coordinate P s t i).trans
        (PresentedAffinoidAlgebra.RationalPresentation.weierstrass_fraction K (chart P s) t
          (fun i => X s K i) i))
  exact congrArg (fun φ : BoundedAlgHom K _ _ => φ b) h

/-- Bounded inverse maps identify the actual chart algebras over the larger quotient. -/
def chartEquiv :
    BoundedAlgEquiv K (weierstrassChart P s t).algebra (chart P t) :=
  BoundedAlgEquiv.ofHomInv (fromChart P s t hts) (toChart P s t)
    (toChart_fromChart P s t hts) (fromChart_toChart P s t hts)

/-- Radius restriction is an affinoid domain against every presented affinoid test. -/
theorem represents_restriction :
    Represents K (restriction P s t hts)
      {x | ∀ i, x (coordinate K (chart P s) i) ≤ t i} := by
  have h := (RationalChart.represents (weierstrassChart P s t)).postcomp_equiv
    (chartEquiv P s t hts)
  change Represents K ((fromChart P s t hts).comp (weierstrassChart P s t).baseMap) _ at h
  rw [fromChart_comp_baseMap, weierstrassChart_locus] at h
  exact h

theorem range_comap_restriction :
    Set.range (BanachSpectrum.comap (restriction P s t hts).toBoundedRingHom) =
      {x | ∀ i, x (coordinate K (chart P s) i) ≤ t i} :=
  (represents_restriction P s t hts).2.1

end PolynomialLocus

end Langlands.Analytic
