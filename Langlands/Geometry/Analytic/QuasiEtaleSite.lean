import Langlands.Geometry.Analytic.EtaleSite
import Langlands.Geometry.Analytic.AnalyticDomainSpaces

/-! # Quasi-étale morphisms of analytic spaces and the quasi-étale site `Qét(X)` -/

noncomputable section

universe u v

namespace Langlands.Analytic.SaturatedAtlasPresentation

open CategoryTheory Topology

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

section Strong

variable {A B : AffinoidAtlasPresentation.{u, v, v} K}

/-- Berkovich's quasi-étale condition at a point `y` for a strong map `g` between constructed
saturations: finitely many affinoid domains (charts) of the source have a union that is a
neighbourhood of `y`, and each of them is identified, compatibly with `g`, with an affinoid
domain of an analytic space étale over the target. -/
def IsQuasiEtaleAt (g : ofSaturation A ⟶ ofSaturation B) (y : A.space) : Prop :=
  ∃ σ : Set (Set A.space), σ.Finite ∧ ⋃₀ σ ∈ 𝓝 y ∧
    ∀ V ∈ σ, ∃ i : (ofSaturation A).presentation.atlas.Index,
      Set.range ((ofSaturation A).presentation.atlas.chart i) = V ∧
      ∃ (W : LocalizedCategory.{u, v, v} (K := K))
        (w : W ⟶ localizationFunctor.obj (ofSaturation B))
        (j : localizationFunctor.obj ((ofSaturation A).domain ((ofSaturation A).chartDomain i)) ⟶
          W),
        etale w ∧ IsAffinoidDomainEmbedding j ∧
          j ≫ w = (ofSaturation A).localizedDomainInclusion _ ≫ localizationFunctor.map g

/-- Berkovich's quasi-étale strong maps: quasi-étale at every point. -/
def IsQuasiEtale (g : ofSaturation A ⟶ ofSaturation B) : Prop :=
  ∀ y, IsQuasiEtaleAt g y

/-- An étale strong map is quasi-étale: the charts of the source through a point give the
required neighbourhood, and each of them is an affinoid domain of the source, which is étale
over the target. -/
theorem isQuasiEtale_of_isEtaleAllPieces (g : ofSaturation A ⟶ ofSaturation B)
    (hg : AffinoidAtlasPresentation.StrongHom.IsEtaleAllPieces (A := A) (B := B) g) :
    IsQuasiEtale g := by
  intro y
  obtain ⟨σ, hσ, hστ, -, hnhds⟩ :=
    (ofSaturation A).presentation.atlas.isNet_chartFamily.1 y
  refine ⟨σ, hσ, hnhds, fun V hV => ?_⟩
  obtain ⟨i, rfl⟩ := hστ hV
  exact ⟨i, rfl, localizationFunctor.obj (ofSaturation A), localizationFunctor.map g,
    (ofSaturation A).localizedDomainInclusion _, etale_localizationFunctor_map g hg,
    (ofSaturation A).isAffinoidDomainEmbedding_localizedDomainInclusion i, rfl⟩

end Strong

/-- Quasi-étale morphisms in the localized category of analytic spaces: arrows isomorphic, in
the arrow category, to the image of a quasi-étale strong map between constructed
saturations. -/
def quasiEtale : MorphismProperty (LocalizedCategory.{u, v, v} (K := K)) := fun _ _ φ =>
  ∃ (A B : AffinoidAtlasPresentation.{u, v, v} K) (g : ofSaturation A ⟶ ofSaturation B),
    IsQuasiEtale g ∧ Nonempty (Arrow.mk (localizationFunctor.map g) ≅ Arrow.mk φ)

instance : (quasiEtale (K := K)).RespectsIso :=
  MorphismProperty.RespectsIso.of_respects_arrow_iso _ fun _ _ e ⟨A, B, g, hg, ⟨e'⟩⟩ =>
    ⟨A, B, g, hg, ⟨e' ≪≫ e⟩⟩

/-- Étale morphisms are quasi-étale. -/
theorem etale_le_quasiEtale : etale (K := K) ≤ quasiEtale := by
  rintro _ _ φ ⟨A, B, g, hg, he⟩
  exact ⟨A, B, g, isQuasiEtale_of_isEtaleAllPieces g hg, he⟩

instance : (quasiEtale (K := K)).ContainsIdentities where
  id_mem X := etale_le_quasiEtale _ ((etale (K := K)).id_mem X)

variable (X : LocalizedCategory.{u, v, v} (K := K))

/-- Berkovich's category `Qét(X)`: quasi-étale morphisms `U → X`, with all morphisms
over `X`. -/
abbrev QuasiEtaleSite := (quasiEtale (K := K)).Over ⊤ X

/-- The inclusion `Ét(X) → Qét(X)`. -/
abbrev EtaleSite.toQuasiEtaleSite : EtaleSite X ⥤ QuasiEtaleSite X :=
  MorphismProperty.Over.changeProp X etale_le_quasiEtale le_rfl

/-- Quasi-étale coverings (Berkovich 1994, §3): families `{f_i : U_i → U}` such that every
point of `U` has a neighbourhood of the form `f_{i₁}(V₁) ∪ … ∪ f_{iₙ}(Vₙ)` with affinoid
domains `V_k` (charts) of the `U_{i_k}`. -/
def quasiEtalePrecoverage : Precoverage (QuasiEtaleSite X) where
  coverings U := {R | ∀ x : localizedSpaceFunctor.obj U.left,
    ∃ σ : Set (Set (localizedSpaceFunctor.obj U.left)), σ.Finite ∧ ⋃₀ σ ∈ 𝓝 x ∧
      ∀ T ∈ σ, ∃ (V : QuasiEtaleSite X) (f : V ⟶ U)
        (i : (localizedObjectEquiv.symm V.left).presentation.atlas.Index), R f ∧
        T = localizedSpaceFunctor.map f.left ''
          Set.range ((localizedObjectEquiv.symm V.left).presentation.atlas.chart i)}

/-- The quasi-étale topology on `Qét(X)`: the Grothendieck topology generated by the
quasi-étale coverings. -/
def quasiEtaleTopology : GrothendieckTopology (QuasiEtaleSite X) :=
  (quasiEtalePrecoverage X).toGrothendieck

variable {X}

theorem mem_quasiEtalePrecoverage_iff {U : QuasiEtaleSite X} {R : Presieve U} :
    R ∈ quasiEtalePrecoverage X U ↔ ∀ x : localizedSpaceFunctor.obj U.left,
      ∃ σ : Set (Set (localizedSpaceFunctor.obj U.left)), σ.Finite ∧ ⋃₀ σ ∈ 𝓝 x ∧
        ∀ T ∈ σ, ∃ (V : QuasiEtaleSite X) (f : V ⟶ U)
          (i : (localizedObjectEquiv.symm V.left).presentation.atlas.Index), R f ∧
          T = localizedSpaceFunctor.map f.left ''
            Set.range ((localizedObjectEquiv.symm V.left).presentation.atlas.chart i) :=
  Iff.rfl

/-- The sieve generated by a quasi-étale covering is a covering sieve. -/
theorem generate_mem_quasiEtaleTopology {U : QuasiEtaleSite X} {R : Presieve U}
    (hR : R ∈ quasiEtalePrecoverage X U) :
    Sieve.generate R ∈ quasiEtaleTopology X U :=
  Precoverage.generate_mem_toGrothendieck hR

/-- The sheaf condition for the quasi-étale topology is the sheaf condition for the
pullbacks of the sieves generated by quasi-étale coverings. -/
theorem isSheaf_quasiEtaleTopology_iff (P : (QuasiEtaleSite X)ᵒᵖ ⥤ Type*) :
    Presieve.IsSheaf (quasiEtaleTopology X) P ↔
      ∀ {U V : QuasiEtaleSite X} {f : V ⟶ U} (R : Presieve U),
        R ∈ quasiEtalePrecoverage X U →
          Presieve.IsSheafFor P ((Sieve.generate R).pullback f).arrows :=
  Precoverage.isSheaf_toGrothendieck_iff P

end Langlands.Analytic.SaturatedAtlasPresentation
