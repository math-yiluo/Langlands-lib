import Langlands.Geometry.Analytic.FullRecognitionEtaleComposition
import Langlands.Geometry.Analytic.SaturatedStrongLocalization
import Langlands.Geometry.Analytic.SaturatedComparisonEquivalence
import Mathlib.CategoryTheory.MorphismProperty.Comma
import Mathlib.CategoryTheory.Sites.JointlySurjective
import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

/-! # Étale morphisms of analytic spaces and the étale site -/

noncomputable section

universe u v

namespace Langlands.Analytic.SaturatedAtlasPresentation

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- Étale morphisms in the localized category of analytic spaces: arrows isomorphic,
in the arrow category, to the image of a strong map between constructed saturations
that is étale over all affinoid pieces at every point. -/
def etale : MorphismProperty (LocalizedCategory.{u, v, v} (K := K)) := fun _ _ φ =>
  ∃ (A B : AffinoidAtlasPresentation.{u, v, v} K) (g : ofSaturation A ⟶ ofSaturation B),
    AffinoidAtlasPresentation.StrongHom.IsEtaleAllPieces (A := A) (B := B) g ∧
      Nonempty (Arrow.mk (localizationFunctor.map g) ≅ Arrow.mk φ)

/-- The image of an étale strong map between constructed saturations is étale. -/
theorem etale_localizationFunctor_map {A B : AffinoidAtlasPresentation.{u, v, v} K}
    (g : ofSaturation A ⟶ ofSaturation B)
    (hg : AffinoidAtlasPresentation.StrongHom.IsEtaleAllPieces (A := A) (B := B) g) :
    etale (localizationFunctor.map g) :=
  ⟨A, B, g, hg, ⟨Iso.refl _⟩⟩

instance : (etale (K := K)).RespectsIso :=
  MorphismProperty.RespectsIso.of_respects_arrow_iso _ fun _ _ e ⟨A, B, g, hg, ⟨e'⟩⟩ =>
    ⟨A, B, g, hg, ⟨e' ≪≫ e⟩⟩

/-- Every object of the localized category is isomorphic to the image of the
constructed saturation of an atlas presentation. -/
theorem exists_iso_localizationFunctor_obj_ofSaturation
    (X : LocalizedCategory.{u, v, v} (K := K)) :
    ∃ A : AffinoidAtlasPresentation.{u, v, v} K,
      Nonempty (localizationFunctor.obj (ofSaturation A) ≅ X) := by
  obtain ⟨S, rfl⟩ := localizedObjectEquiv.surjective X
  exact ⟨S.presentation, ⟨localizationFunctor.mapIso S.saturationIso⟩⟩

/-- Every isomorphism of analytic spaces is étale. -/
theorem etale_of_isIso {X Y : LocalizedCategory.{u, v, v} (K := K)} (φ : X ⟶ Y) [IsIso φ] :
    etale φ := by
  obtain ⟨A, ⟨e⟩⟩ := exists_iso_localizationFunctor_obj_ofSaturation X
  refine ⟨A, A, 𝟙 _, AffinoidAtlasPresentation.StrongHom.isEtaleAllPieces_id A,
    ⟨Arrow.isoMk e (e ≪≫ asIso φ) ?_⟩⟩
  simp

instance : (etale (K := K)).ContainsIdentities where
  id_mem X := etale_of_isIso (𝟙 X)

variable (X : LocalizedCategory.{u, v, v} (K := K))

/-- Berkovich's category `Ét(X)`: étale morphisms `U ⟶ X` of analytic spaces, with
all morphisms over `X`. -/
abbrev EtaleSite := (etale (K := K)).Over ⊤ X

namespace EtaleSite

/-- The underlying points of an object of `Ét(X)`, and the underlying maps of
morphisms over `X`. -/
def points : EtaleSite X ⥤ Type v :=
  MorphismProperty.Over.forget _ _ X ⋙ Over.forget X ⋙ localizedSpaceFunctor ⋙
    forget TopCat

@[simp]
theorem points_obj (U : EtaleSite X) :
    (points X).obj U = localizedSpaceFunctor.obj U.left := rfl

theorem points_map {U V : EtaleSite X} (f : U ⟶ V) (x : (points X).obj U) :
    (points X).map f x = localizedSpaceFunctor.map f.left x := rfl

end EtaleSite

/-- Étale coverings in `Ét(X)` (Berkovich 1993, §4.1): families of morphisms over
`X` whose underlying point maps are jointly surjective. -/
def etalePrecoverage : Precoverage (EtaleSite X) :=
  Types.jointlySurjectivePrecoverage.comap (EtaleSite.points X)

/-- The étale topology on `Ét(X)`: the Grothendieck topology generated by the
étale coverings. -/
def etaleTopology : GrothendieckTopology (EtaleSite X) :=
  (etalePrecoverage X).toGrothendieck

variable {X}

theorem mem_etalePrecoverage_iff {U : EtaleSite X} {R : Presieve U} :
    R ∈ etalePrecoverage X U ↔
      ∀ x : (EtaleSite.points X).obj U, ∃ (V : EtaleSite X) (f : V ⟶ U), R f ∧
        x ∈ Set.range ((EtaleSite.points X).map f) :=
  Presieve.mem_comap_jointlySurjectivePrecoverage_iff _

theorem ofArrows_mem_etalePrecoverage_iff {U : EtaleSite X} {ι : Type*}
    {V : ι → EtaleSite X} {f : ∀ i, V i ⟶ U} :
    Presieve.ofArrows V f ∈ etalePrecoverage X U ↔
      ∀ x : (EtaleSite.points X).obj U, ∃ i, x ∈ Set.range ((EtaleSite.points X).map (f i)) :=
  Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff _

instance : (etalePrecoverage X).HasIsos :=
  inferInstanceAs (Types.jointlySurjectivePrecoverage.comap (EtaleSite.points X)).HasIsos

instance : (etalePrecoverage X).IsStableUnderComposition :=
  inferInstanceAs
    (Types.jointlySurjectivePrecoverage.comap (EtaleSite.points X)).IsStableUnderComposition

/-- A jointly surjective family generates a covering sieve. -/
theorem generate_mem_etaleTopology {U : EtaleSite X} {R : Presieve U}
    (hR : R ∈ etalePrecoverage X U) : Sieve.generate R ∈ etaleTopology X U :=
  Precoverage.generate_mem_toGrothendieck hR

/-- A sieve whose arrows have jointly surjective underlying point maps is covering. -/
theorem mem_etaleTopology_of_jointlySurjective {U : EtaleSite X} (S : Sieve U)
    (hS : ∀ x : (EtaleSite.points X).obj U, ∃ (V : EtaleSite X) (f : V ⟶ U), S f ∧
      x ∈ Set.range ((EtaleSite.points X).map f)) :
    S ∈ etaleTopology X U := by
  simpa using generate_mem_etaleTopology (mem_etalePrecoverage_iff.2 hS)

/-- The sheaf condition for the étale topology is the sheaf condition for the
pullbacks of the sieves generated by étale coverings. -/
theorem isSheaf_etaleTopology_iff (P : (EtaleSite X)ᵒᵖ ⥤ Type*) :
    Presieve.IsSheaf (etaleTopology X) P ↔
      ∀ {U V : EtaleSite X} {f : V ⟶ U} (R : Presieve U), R ∈ etalePrecoverage X U →
        Presieve.IsSheafFor P ((Sieve.generate R).pullback f).arrows :=
  Precoverage.isSheaf_toGrothendieck_iff P

namespace EtaleSite

variable {Y Z : LocalizedCategory.{u, v, v} (K := K)}

/-- Translation along an isomorphism `e : X ≅ Y`: an étale `U ⟶ X` goes to the
étale composite `U ⟶ X ⟶ Y`, with the same morphisms. For an automorphism `g` of
`X` this is Berkovich's `U ↦ gU = U ×_{X, g⁻¹} X`. -/
def translate (e : X ≅ Y) : EtaleSite X ≌ EtaleSite Y :=
  MorphismProperty.Comma.mapRightIso (𝟭 _) (Discrete.natIso fun _ => e)

@[simp]
theorem translate_functor_obj_left (e : X ≅ Y) (U : EtaleSite X) :
    ((translate e).functor.obj U).left = U.left := rfl

@[simp]
theorem translate_functor_obj_hom (e : X ≅ Y) (U : EtaleSite X) :
    ((translate e).functor.obj U).hom = U.hom ≫ e.hom := rfl

@[simp]
theorem translate_functor_map_left (e : X ≅ Y) {U V : EtaleSite X} (f : U ⟶ V) :
    ((translate e).functor.map f).left = f.left := rfl

/-- Translation does not change underlying points. -/
def translatePoints (e : X ≅ Y) : (translate e).functor ⋙ points Y ≅ points X :=
  Iso.refl _

/-- Translation along a composite is the composite of the translations. -/
def translateTrans (e : X ≅ Y) (e' : Y ≅ Z) :
    (translate (e ≪≫ e')).functor ≅ (translate e).functor ⋙ (translate e').functor :=
  NatIso.ofComponents (fun U => MorphismProperty.Comma.isoMk (Iso.refl _) (Iso.refl _))
    (fun f => by ext; exact (Category.comp_id _).trans (Category.id_comp _).symm)

/-- Translation along the identity is the identity. -/
def translateRefl : (translate (Iso.refl X)).functor ≅ 𝟭 (EtaleSite X) :=
  NatIso.ofComponents (fun U => MorphismProperty.Comma.isoMk (Iso.refl _) (Iso.refl _))
    (fun f => by ext; exact (Category.comp_id _).trans (Category.id_comp _).symm)

/-- Translation preserves and reflects étale coverings. -/
theorem map_translate_mem_etalePrecoverage_iff (e : X ≅ Y) {U : EtaleSite X}
    {R : Presieve U} :
    R.map (translate e).functor ∈ etalePrecoverage Y ((translate e).functor.obj U) ↔
      R ∈ etalePrecoverage X U := by
  have h : etalePrecoverage X = (etalePrecoverage Y).comap (translate e).functor :=
    Precoverage.comap_comp (translate e).functor (points Y) Types.jointlySurjectivePrecoverage
  rw [h, Precoverage.mem_comap_iff]

end EtaleSite

end Langlands.Analytic.SaturatedAtlasPresentation
