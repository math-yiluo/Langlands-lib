  {X : AlgebraicSpace (Spec (CommRingCat.of K))}

set_option backward.isDefEq.respectTransparency false in
/-- A compatible pair of algebra maps factors through a represented affine
pullback, by the presheaf universal property on the spectrum of the value ring. -/
private theorem exists_algHom_of_isPullback
    {A B C L : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing L]
    [Algebra K A] [Algebra K B] [Algebra K C] [Algebra K L]
    {f : A →ₐ[K] C} {g : B →ₐ[K] C} {x : RingPoints K X A} {y : RingPoints K X B}
    (hpb : IsPullback ((schemeYoneda _).map (ringTestMap K f))
      ((schemeYoneda _).map (ringTestMap K g)) (pointHom K x) (pointHom K y))
    (α : A →ₐ[K] L) (β : B →ₐ[K] L)
    (h : (schemeYoneda _).map (ringTestMap K α) ≫ pointHom K x =
      (schemeYoneda _).map (ringTestMap K β) ≫ pointHom K y) :
    ∃ δ : C →ₐ[K] L, δ.comp f = α ∧ δ.comp g = β := by
  obtain ⟨r, hr⟩ := (schemeYoneda _).map_surjective (hpb.lift _ _ h)
  let δ := affineRingPointEquiv K C L r
  have hδ : ringTestMap K δ = r := ringTestMap_affineRingPointEquiv K r
  have faithful {T : Type u} [CommRing T] [Algebra K T] {a b : T →ₐ[K] L}
      (heq : (schemeYoneda _).map (ringTestMap K a) =
        (schemeYoneda _).map (ringTestMap K b)) : a = b := by
    apply AlgHom.coe_ringHom_injective
    have hRing := Spec.map_injective (congrArg (fun k => k.left)
      ((schemeYoneda _).map_injective heq))
    exact congrArg (fun k => k.hom) hRing
  refine ⟨δ, faithful ?_, faithful ?_⟩
  · rw [ringTestMap_comp, Functor.map_comp, hδ, hr]
    exact hpb.lift_fst _ _ h
  · rw [ringTestMap_comp, Functor.map_comp, hδ, hr]
    exact hpb.lift_snd _ _ h

/-- The diagonal section of the affine self-pullback of an étale test point
has kernel generated by an idempotent. -/
private theorem exists_diagonal_idempotent
    {A D : Type u} [CommRing A] [CommRing D] [Algebra K A] [Algebra K D]
    {f g : A →ₐ[K] D} {x : RingPoints K X A} (hx : IsEtale (pointHom K x))
    (hpb : IsPullback ((schemeYoneda _).map (ringTestMap K f))
      ((schemeYoneda _).map (ringTestMap K g)) (pointHom K x) (pointHom K x)) :
    ∃ (d : D →ₐ[K] A) (e : D), d.comp f = AlgHom.id K A ∧ d.comp g = AlgHom.id K A ∧
      IsIdempotentElem e ∧ RingHom.ker d.toRingHom = Ideal.span {e} := by
  obtain ⟨d, hf, hg⟩ := exists_algHom_of_isPullback hpb (AlgHom.id K A) (AlgHom.id K A) rfl
  have hs : ringTestMap K d ≫ ringTestMap K g = 𝟙 (ringTest K A) := by
    rw [← ringTestMap_comp, hg, ringTestMap_id]
  let : Etale (ringTestMap K g).left := hx.projection (pointHom K x) _ _ hpb
  have hd : _root_.AlgebraicGeometry.IsOpenImmersion (ringTestMap K d).left :=
    isOpenImmersion_of_section (ringTestMap K g).left (ringTestMap K d).left
      (congrArg (fun k => k.left) hs)
  have hdSurj : Function.Surjective d := fun a => ⟨g a, AlgHom.congr_fun hg a⟩
  obtain ⟨e, he, hker⟩ :=
    (isOpenImmersion_SpecMap_iff_of_surjective (CommRingCat.ofHom d.toRingHom) hdSurj).mp hd
  exact ⟨d, e, hf, hg, he, hker⟩

variable [IsUltrametricDist K] [CompleteSpace K]
  {Y : LocalizedCategory.{u, u, u} (K := K)} {p : PointFamily K X Y}

/-- A point of a finite-type étale `K`-algebra is either rational or has two
distinct algebraic evaluations over the complete algebraic closure that
realize its seminorm. -/
private theorem finiteEtale_point_realizations
    {C : Type u} [CommRing C] [Algebra K C] [Algebra.Etale K C]
    (R : FinitePolynomialPresentation K C) (t : Space K R) :
    (∃ φ : C →ₐ[K] K, ∀ c, ‖φ c‖ = pointSeminorm K R t c) ∨
    ∃ α β : C →ₐ[K] CompleteAlgebraicClosure K,
      α ≠ β ∧ (∀ c, ‖α c‖ = pointSeminorm K R t c) ∧
        (∀ c, ‖β c‖ = pointSeminorm K R t c) := by
  obtain ⟨L, _, _, _, _, ρ, hρ⟩ :=
    BaseChangeComparison.normedRealization (pointSeminorm K R t) (pointSeminorm_extendsNorm K R t)
  let : Algebra.FiniteType K C := Algebra.FiniteType.of_surjective R.map R.surjective
  let : Module.Finite K C := Algebra.FormallyUnramified.finite_of_free K C
  let : IsArtinianRing C := .of_finite K C
  let I := RingHom.ker ρ.toRingHom
  let : I.IsPrime := RingHom.ker_isPrime ρ.toRingHom
  let E := C ⧸ I
  let : Field E := Ideal.Quotient.field I
  let q : C →ₐ[K] E := Ideal.Quotient.mkₐ K I
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  let : Module.Finite K E := Module.Finite.of_surjective q.toLinearMap hq
  let : Algebra.IsSeparable K E := inferInstanceAs (Algebra.IsSeparable K (C ⧸ I))
  let ι : E →ₐ[K] L := Ideal.Quotient.liftₐ I ρ (fun _ h => h)
  have hι (c : C) : ι (q c) = ρ c := rfl
  by_cases hs : Function.Surjective (algebraMap K E)
  · let e := AlgEquiv.ofBijective (Algebra.ofId K E) ⟨RingHom.injective _, hs⟩
    refine Or.inl ⟨e.symm.toAlgHom.comp q, fun c => ?_⟩
    change ‖e.symm (q c)‖ = pointSeminorm K R t c
    calc
      _ = ‖algebraMap K L (e.symm (q c))‖ := (norm_algebraMap' L _).symm
      _ = ‖ρ c‖ := by
        rw [← ι.commutes, show algebraMap K E (e.symm (q c)) = q c from e.apply_symm_apply _,
          hι]
      _ = _ := hρ c
  · have hn : Module.finrank K E ≠ 1 :=
      fun h => hs (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp h).2
    have hc : 1 < Fintype.card (E →ₐ[K] CompleteAlgebraicClosure K) := by
      rw [AlgHom.card]
      exact lt_of_le_of_ne (Nat.succ_le_of_lt Module.finrank_pos) (Ne.symm hn)
    let : Nontrivial (E →ₐ[K] CompleteAlgebraicClosure K) :=
      Fintype.one_lt_card_iff_nontrivial.mp hc
    obtain ⟨α, β, hab⟩ := exists_pair_ne (E →ₐ[K] CompleteAlgebraicClosure K)
    have hnorm (σ : E →ₐ[K] CompleteAlgebraicClosure K) (c : C) :
        ‖σ (q c)‖ = pointSeminorm K R t c := by
      calc
        ‖σ (q c)‖ = spectralNorm K E (q c) :=
          spectralNorm_unique_field_norm_ext (f := pullbackAbsoluteValue σ.toRingHom)
            (fun k => by change ‖σ (algebraMap K E k)‖ = ‖k‖; rw [σ.commutes, norm_algebraMap']) _
        _ = ‖ι (q c)‖ :=
          (spectralNorm_unique_field_norm_ext (f := pullbackAbsoluteValue ι.toRingHom)
            (fun k => by change ‖ι (algebraMap K E k)‖ = ‖k‖; rw [ι.commutes, norm_algebraMap']) _).symm
        _ = _ := by rw [hι, hρ]
    refine Or.inr ⟨α.comp q, β.comp q, ?_, hnorm α, hnorm β⟩
    intro h
    apply hab
    ext e
    obtain ⟨c, rfl⟩ := hq e
    exact AlgHom.congr_fun h c

omit [IsUltrametricDist K] [CompleteSpace K] in
/-- The norm of a ground-field evaluation determines that evaluation after
extension to any normed field containing `K`. -/
private theorem eq_scalar_comp_of_norm_eq
    {A L : Type u} [CommRing A] [Algebra K A] [NormedField L] [NormedAlgebra K L]
    (φ : AlgPoint K A K) (ρ : A →ₐ[K] L) (h : ∀ a, ‖ρ a‖ = ‖φ a‖) :
    ρ = (Algebra.ofId K L).comp φ.toAlgHom := by
  ext a
  change ρ a = algebraMap K L (φ a)
  apply sub_eq_zero.mp
  apply norm_eq_zero.mp
  rw [← ρ.commutes (φ a), ← map_sub, h]
  change ‖φ.toAlgHom (a - algebraMap K A (φ.toAlgHom a))‖ = 0
  rw [map_sub, φ.toAlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self, norm_zero]

/-- The closed off-diagonal image in the ordinary product misses the repeated
pair formed by a rational point. -/
private theorem rational_diagonal_not_mem_image
    {A D : Type u} [CommRing A] [CommRing D] [Algebra K A] [Algebra K D]
    (P : FinitePolynomialPresentation K A) (S : FinitePolynomialPresentation K D)
    (f g : A →ₐ[K] D) (d : D →ₐ[K] A) (e : D)
    (hf : d.comp f = AlgHom.id K A) (hg : d.comp g = AlgHom.id K A) (hde : d e = 0)
    (hsurj : Function.Surjective (Algebra.TensorProduct.lift f g
      (fun a b => Commute.all (f a) (g b)) : A ⊗[K] A →ₐ[K] D))
    (φ : AlgPoint K A K) :
    (analyticPoint K P φ, analyticPoint K P φ) ∉
      (fun t : Space K S => (baseMap K P S f t, baseMap K P S g t)) ''
        {t | pointSeminorm K S t e = 1} := by
  rintro ⟨t, ht, hpair⟩
  have hfst : baseMap K P S f t = analyticPoint K P φ := congrArg Prod.fst hpair
  have hsnd : baseMap K P S g t = analyticPoint K P φ := congrArg Prod.snd hpair
  obtain ⟨L, _, _, _, _, ρ, hρ⟩ :=
    BaseChangeComparison.normedRealization (pointSeminorm K S t) (pointSeminorm_extendsNorm K S t)
  let ψ := (Algebra.ofId K L).comp φ.toAlgHom
  have hfρ : ρ.comp f = ψ := eq_scalar_comp_of_norm_eq φ (ρ.comp f) fun a => by
    change ‖ρ (f a)‖ = ‖φ a‖
    rw [hρ, ← pointSeminorm_baseMap, hfst, CenterComparison.pointSeminorm_analyticPoint]
  have hgρ : ρ.comp g = ψ := eq_scalar_comp_of_norm_eq φ (ρ.comp g) fun a => by
    change ‖ρ (g a)‖ = ‖φ a‖
    rw [hρ, ← pointSeminorm_baseMap, hsnd, CenterComparison.pointSeminorm_analyticPoint]
  let ℓ : A ⊗[K] A →ₐ[K] D := Algebra.TensorProduct.lift f g (fun a b => Commute.all (f a) (g b))
  have hℓ : ρ.comp ℓ = (ψ.comp d).comp ℓ := by
    apply Algebra.TensorProduct.ext'
    intro a b
    change ρ (ℓ (a ⊗ₜ[K] b)) = ψ (d (ℓ (a ⊗ₜ[K] b)))
    simp only [ℓ, Algebra.TensorProduct.lift_tmul, map_mul]
    rw [show ρ (f a) = ψ a from AlgHom.congr_fun hfρ a,
      show ρ (g b) = ψ b from AlgHom.congr_fun hgρ b,
      show d (f a) = a from AlgHom.congr_fun hf a,
      show d (g b) = b from AlgHom.congr_fun hg b]
  obtain ⟨c, hc⟩ := hsurj e
  have he : ρ e = ψ (d e) := by
    change ℓ c = e at hc
    simpa only [AlgHom.comp_apply, hc] using AlgHom.congr_fun hℓ c
  exact zero_ne_one (show (0 : ℝ) = 1 from by
    simpa only [he, hde, map_zero, norm_zero] using (hρ e).trans ht)

/-- Near a ground-field point of an affine étale chart, every ordinary
analytic point mapping to an algebraic ground-field point is itself rational. -/
def EtaleChartRationalNeighborhoods (p : PointFamily K X Y)
    (P₀ : FinitePolynomialPresentation K K) : Prop :=
  ∀ {A : Type u} [CommRing A] [Algebra K A] (P : FinitePolynomialPresentation K A)
    (x : RingPoints K X A), IsEtale (pointHom K x) → ∀ φ : AlgPoint K A K,
    ∃ U : Set (Space K P), IsOpen U ∧ analyticPoint K P φ ∈ U ∧
      ∀ z ∈ U, ∀ y : RingPoints K X K,
        localizedSpaceFunctor.map (p A P x) z = rationalPoint p P₀ y →
        ∃ ψ : AlgPoint K A K, analyticPoint K P ψ = z

set_option backward.isDefEq.respectTransparency false in
/-- The analytic image of the off-diagonal part of the affine chart relation
detects the nonrational ordinary points of each étale fibre over a `K`-point. -/
theorem IsAnalytification.etaleChartRationalNeighborhoods
    (hp : IsAnalytification K X Y p) (hX : IsSeparated X)
    (P₀ : FinitePolynomialPresentation K K) : EtaleChartRationalNeighborhoods p P₀ := by
  intro A _ _ P x hx φ
  obtain ⟨D, _, _, S, f, g, hsurj, hpb⟩ :=
    hasClosedAffinePointPullbacks_of_isSeparated hX A P A P x x
  obtain ⟨d, e, hf, hg, he, hker⟩ := exists_diagonal_idempotent hx hpb
  have hde : d e = 0 := RingHom.mem_ker.1 (hker.symm ▸ Ideal.subset_span (by simp))
  let H := (fun t : Space K S => (baseMap K P S f t, baseMap K P S g t)) ''
    {t | pointSeminorm K S t e = 1}
  have hH : IsClosed H :=
    isClosedMap_pair_baseMap_of_surjective P P S f g hsurj _
      (isClosed_eq (continuous_pointSeminorm_apply K S e) continuous_const)
  refine ⟨(fun z => (z, z)) ⁻¹' Hᶜ,
    hH.isOpen_compl.preimage (continuous_id.prodMk continuous_id),
    rational_diagonal_not_mem_image P S f g d e hf hg hde hsurj φ, ?_⟩
  intro z hzU y hzy
  obtain ⟨C, _, _, R, f₀, g₀, hsurj₀, hpb₀⟩ :=
    hasClosedAffinePointPullbacks_of_isSeparated hX A P K P₀ x y
  obtain ⟨t, hz, -⟩ := exists_point_of_isPullback _ _ _ _
    (hp.isPullback P P₀ R f₀ g₀ x y hpb₀) z
    (analyticPoint K P₀ (AlgPoint.ofAlgHom (AlgHom.id K K))) hzy
  rw [localizedSpaceFunctor_map_localizedHom] at hz
  change baseMap K P R f₀ t = z at hz
  have hsem (a : A) : pointSeminorm K P z a = pointSeminorm K R t (f₀ a) := by
    rw [← hz, pointSeminorm_baseMap]
  have hg₀ : g₀ = Algebra.ofId K C := AlgHom.ext g₀.commutes
  have hEtale : Etale (Spec.map (CommRingCat.ofHom g₀.toRingHom)) :=
    hx.projection (pointHom K y) _ _ hpb₀
  let : Algebra.Etale K C := by
    have h := (HasRingHomProperty.Spec_iff (P := @Etale)).mp hEtale
    change g₀.toRingHom.Etale at h
    rw [hg₀] at h
    exact RingHom.etale_algebraMap.mp h
  rcases finiteEtale_point_realizations R t with ⟨ψ, hψ⟩ | ⟨α, β, hab, hα, hβ⟩
  · refine ⟨AlgPoint.ofAlgHom (ψ.comp f₀), ?_⟩
    apply SeminormComparison.pointSeminorm_injective K P
    ext a
    exact (CenterComparison.pointSeminorm_analyticPoint K P _ a).trans
      ((hψ (f₀ a)).trans (hsem a).symm)
  · have hf₀ : Function.Surjective f₀ := by
      have hlift : Algebra.TensorProduct.lift f₀ g₀ (fun a k => Commute.all (f₀ a) (g₀ k)) =
          f₀.comp (Algebra.TensorProduct.rid K K A).toAlgHom := by
        apply Algebra.TensorProduct.ext'
        intro a k
        rw [Algebra.TensorProduct.lift_tmul]
        change f₀ a * g₀ k = f₀ (Algebra.TensorProduct.rid K K A (a ⊗ₜ[K] k))
        rw [Algebra.TensorProduct.rid_tmul, Algebra.smul_def, map_mul, f₀.commutes,
          hg₀, Algebra.ofId_apply, mul_comm]
      change Function.Surjective
        (Algebra.TensorProduct.lift f₀ g₀ (fun a k => Commute.all (f₀ a) (g₀ k))) at hsurj₀
      rw [hlift] at hsurj₀
      intro c
      obtain ⟨r, hr⟩ := hsurj₀ c
      exact ⟨Algebra.TensorProduct.rid K K A r, hr⟩
    have hcomp (σ : C →ₐ[K] CompleteAlgebraicClosure K) :
        (schemeYoneda _).map (ringTestMap K (σ.comp f₀)) ≫ pointHom K x =
          (schemeYoneda _).map (ringTestMap K (σ.comp g₀)) ≫ pointHom K y := by
      simp only [ringTestMap_comp, Functor.map_comp, Category.assoc, hpb₀.w]
    have hsame : α.comp g₀ = β.comp g₀ := by
      rw [hg₀]
      exact AlgHom.ext fun k => (α.commutes k).trans (β.commutes k).symm
    obtain ⟨δ, hδf, hδg⟩ := exists_algHom_of_isPullback hpb (α.comp f₀) (β.comp f₀)
      (by rw [hcomp α, hcomp β, hsame])
    have he_ne : δ e ≠ 0 := by
      intro he_zero
      have hle : RingHom.ker d.toRingHom ≤ RingHom.ker δ.toRingHom := by
        rw [hker, Ideal.span_le, Set.singleton_subset_iff]
        exact RingHom.mem_ker.2 he_zero
      have heq : δ.comp f = δ.comp g := by
        ext a
        have hmem : f a - g a ∈ RingHom.ker d.toRingHom := by
          change d (f a - g a) = 0
          rw [map_sub, show d (f a) = a from AlgHom.congr_fun hf a,
            show d (g a) = a from AlgHom.congr_fun hg a, sub_self]
        apply sub_eq_zero.mp
        change δ (f a) - δ (g a) = 0
        rw [← map_sub]
        exact RingHom.mem_ker.1 (hle hmem)
      have heq' := hδf.symm.trans (heq.trans hδg)
      apply hab
      ext c
      obtain ⟨a, rfl⟩ := hf₀ c
      exact AlgHom.congr_fun heq' a
    have he_one : δ e = 1 := (mul_eq_right₀ he_ne).mp (by
      rw [← map_mul]
      exact congrArg δ he)
    let ν := BaseChangeComparison.pullback
      (NormedField.toMulRingNorm (CompleteAlgebraicClosure K)).toMulRingSeminorm δ.toRingHom
    have hν : ν ∈ range (pointSeminorm K S) := by
      rw [SeminormComparison.range_pointSeminorm]
      intro k
      change ‖δ (algebraMap K D k)‖ = ‖k‖
      rw [δ.commutes, norm_algebraMap']
    obtain ⟨r, hr⟩ := hν
    have hnorm (a : D) : pointSeminorm K S r a = ‖δ a‖ :=
      congrArg (fun μ : MulRingSeminorm D => μ a) hr
    have hproj (j : A →ₐ[K] D) (σ : C →ₐ[K] CompleteAlgebraicClosure K)
        (hj : δ.comp j = σ.comp f₀) (hσ : ∀ c, ‖σ c‖ = pointSeminorm K R t c) :
        baseMap K P S j r = z := by
      apply SeminormComparison.pointSeminorm_injective K P
      ext a
      calc
        _ = ‖δ (j a)‖ := (pointSeminorm_baseMap K P S j r a).trans (hnorm _)
        _ = ‖σ (f₀ a)‖ := congrArg norm (AlgHom.congr_fun hj a)
        _ = _ := (hσ (f₀ a)).trans (hsem a).symm
    exact False.elim (hzU ⟨r, by
      change pointSeminorm K S r e = 1
      rw [hnorm, he_one, norm_one], Prod.ext (hproj f α hδf hα) (hproj g β hδg hβ)⟩)

end Langlands.Analytic.SpaceAnalytification
