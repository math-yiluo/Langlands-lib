import Langlands.Geometry.Analytic.GroundFieldChangingSpaceFunctor
import Langlands.Geometry.Analytic.EtaleSiteTranslation
import Langlands.Sheaf.Equivariant.TwistedOver

/-! # Étale test objects and translations in the varying-field analytic category -/

noncomputable section

open CategoryTheory
open Langlands.Analytic.SaturatedAtlasPresentation
open Langlands.Analytic.CompatibleAtlasPresentation (localizedSaturationFunctor)
open Langlands.Sheaf.Equivariant TwistedOver

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000

universe u v z

namespace Langlands.Analytic.SpaceOverField

open CompleteUltrametricField

/-- The varying-field arrow of an actual analytic map over a fixed field. -/
def fixedFieldMap {K : CompleteUltrametricField.{u}}
    {Y X : K.CompatibleAnalyticCategory.{u, v}} (f : Y ⟶ X) :
    withField K Y ⟶ withField K X :=
  homMk (𝟙 K) (f ≫ (localizedExtendId K).inv.app X)

/-- An étale arrow over an isomorphic ground field is an arrow isomorphic to
a fixed-field étale arrow in the actual varying-field category. -/
def varyingFieldEtale : MorphismProperty (SpaceOverField.{u, v}) := fun _ _ a =>
  ∃ (K : CompleteUltrametricField.{u}) (Y X : K.CompatibleAnalyticCategory.{u, v})
    (f : Y ⟶ X), etale ((localizedSaturationFunctor (K := K.carrier)).map f) ∧
      Nonempty (Arrow.mk (fixedFieldMap f) ≅ Arrow.mk a)

instance : (varyingFieldEtale.{u, v}).RespectsIso :=
  MorphismProperty.RespectsIso.of_respects_arrow_iso _ fun _ _ e ⟨K, Y, X, f, hf, ⟨ef⟩⟩ =>
    ⟨K, Y, X, f, hf, ⟨ef ≪≫ e⟩⟩

/-- An actual fixed-field étale map gives an object of the varying-field site. -/
theorem varyingFieldEtale_fixedFieldMap {K : CompleteUltrametricField.{u}}
    {Y X : K.CompatibleAnalyticCategory.{u, v}} (f : Y ⟶ X)
    (hf : etale ((localizedSaturationFunctor (K := K.carrier)).map f)) :
    varyingFieldEtale (fixedFieldMap f) :=
  ⟨K, Y, X, f, hf, ⟨Iso.refl _⟩⟩

/-- The underlying field map of an étale test arrow is an isometric isomorphism. -/
theorem isIso_fieldMap_of_varyingFieldEtale {X Y : SpaceOverField.{u, v}} {f : Y ⟶ X}
    (h : varyingFieldEtale f) : IsIso (fieldMap f) := by
  obtain ⟨K, _, _, g, _, ⟨e⟩⟩ := h
  let P := (MorphismProperty.isomorphisms _).inverseImage (fieldProjection.{u, v})
  have hg : P (fixedFieldMap g) := by
    change IsIso (𝟙 (Opposite.op K))
    infer_instance
  have hf := (MorphismProperty.arrow_mk_iso_iff P e).mp hg
  change IsIso (fieldMap f).op at hf
  exact isIso_of_op (fieldMap f)

/-- The actual étale test objects over the given varying-field space. -/
abbrev VaryingFieldEtaleSite (X : SpaceOverField.{u, v}) :=
  varyingFieldEtale.Over ⊤ X

/-- The actual underlying points of each test object. -/
def varyingFieldEtalePoints (X : SpaceOverField.{u, v}) :
    VaryingFieldEtaleSite X ⥤ Type (max u v) :=
  MorphismProperty.Over.forget varyingFieldEtale ⊤ X ⋙ Over.forget X ⋙
    underlyingSpaceFunctor ⋙ forget _

/-- Families jointly surjective on analytic points. -/
def varyingFieldEtalePrecoverage (X : SpaceOverField.{u, v}) :
    Precoverage (VaryingFieldEtaleSite X) :=
  Types.jointlySurjectivePrecoverage.comap (varyingFieldEtalePoints X)

/-- The topology generated by the jointly surjective covering families. -/
def varyingFieldEtaleTopology (X : SpaceOverField.{u, v}) :
    GrothendieckTopology (VaryingFieldEtaleSite X) :=
  (varyingFieldEtalePrecoverage X).toGrothendieck

variable {X Y : SpaceOverField.{u, v}}

/-- Translation of étale test objects by a varying-field isomorphism. -/
def varyingFieldEtaleTranslate (e : X ≅ Y) : VaryingFieldEtaleSite X ≌ VaryingFieldEtaleSite Y :=
  MorphismProperty.Comma.mapRightIso (𝟭 _) (Discrete.natIso fun _ => e)

/-- The domains and their points are the same after translation. -/
theorem varyingFieldEtaleTranslate_map_mem (e : X ≅ Y) {U : VaryingFieldEtaleSite X}
    {R : Presieve U} (hR : R ∈ varyingFieldEtalePrecoverage X U) :
    R.map (varyingFieldEtaleTranslate e).functor ∈
      varyingFieldEtalePrecoverage Y ((varyingFieldEtaleTranslate e).functor.obj U) := by
  have h : varyingFieldEtalePrecoverage X =
      (varyingFieldEtalePrecoverage Y).comap (varyingFieldEtaleTranslate e).functor :=
    Precoverage.comap_comp (varyingFieldEtaleTranslate e).functor (varyingFieldEtalePoints Y)
      Types.jointlySurjectivePrecoverage
  rw [h, Precoverage.mem_comap_iff] at hR
  exact hR

variable {G : Type z} [Group G] (ρ : G →* Aut X)

instance : IsTranslationInvariant (P := varyingFieldEtale) (ρ := ρ) (varyingFieldEtaleTopology X) where
  isCocontinuous g :=
    isCocontinuous_toGrothendieck_of_equivalence (varyingFieldEtaleTranslate (ρ g).asIso) _ _
      (fun hR => varyingFieldEtaleTranslate_map_mem (ρ g).asIso.symm hR)

/-- On the twisted site the covering condition tests the untwisted arrows. -/
def varyingFieldTwistedEtaleTopology : GrothendieckTopology (TwistedOver varyingFieldEtale ρ) :=
  twistedTopology ρ (varyingFieldEtaleTopology X)

end Langlands.Analytic.SpaceOverField
