import Langlands.Geometry.Analytic.NearIdentitySubgroup
import Langlands.Geometry.Analytic.QuasiEtaleRigidity.RigidityTransport
import Mathlib.Topology.Algebra.Group.Neighborhood

/-! # The chart-test uniformity of analytic morphisms and automorphisms -/

noncomputable section

universe u v w z

namespace Langlands.Analytic.SaturatedAtlasPresentation

open CategoryTheory Filter Set Topology
open scoped SetRel Uniformity

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {W X Y Z : LocalizedCategory.{u, v, w} (K := K)}

/-- A finite family of chart tests defines an entourage by imposing each test. -/
def morphismTestEntourage (Y : LocalizedCategory.{u, v, w} (K := K))
    (tests : Finset (TestTriple (presentationOf X))) : SetRel (Y ⟶ X) (Y ⟶ X) :=
  {p | ∀ τ ∈ tests, IsNear τ p.1 p.2}

private def morphismTestFilterBasis (Y X : LocalizedCategory.{u, v, w} (K := K)) :
    FilterBasis ((Y ⟶ X) × (Y ⟶ X)) where
  sets := Set.range (morphismTestEntourage Y (X := X))
  nonempty := ⟨_, Set.mem_range_self ∅⟩
  inter_sets := by
    classical
    rintro _ _ ⟨E, rfl⟩ ⟨F, rfl⟩
    refine ⟨_, Set.mem_range_self (E ∪ F), fun _ h => ⟨?_, ?_⟩⟩
    · exact fun τ hτ => h τ (Finset.mem_union_left _ hτ)
    · exact fun τ hτ => h τ (Finset.mem_union_right _ hτ)

/-- The uniform structure on analytic morphisms generated by the finite chart tests. -/
@[instance_reducible]
def morphismUniformSpace (Y X : LocalizedCategory.{u, v, w} (K := K)) :
    UniformSpace (Y ⟶ X) :=
  UniformSpace.ofCore (UniformSpace.Core.mkOfBasis (morphismTestFilterBasis Y X)
    (by
      rintro _ ⟨E, rfl⟩ f τ _
      simpa only [Category.comp_id] using (isNear_id τ).precomp f)
    (by
      rintro _ ⟨E, rfl⟩
      exact ⟨_, Set.mem_range_self E, fun _ h τ hτ => (h τ hτ).symm⟩)
    (by
      rintro _ ⟨E, rfl⟩
      refine ⟨_, Set.mem_range_self E, ?_⟩
      rintro _ ⟨_, h, h'⟩ τ hτ
      exact (h τ hτ).trans (h' τ hτ)))

/-- A basis of the uniformity, indexed by finite sets of tests, including the empty set. -/
theorem morphismUniformity_hasBasis (Y X : LocalizedCategory.{u, v, w} (K := K)) :
    𝓤[morphismUniformSpace Y X].HasBasis (fun _ => True) (morphismTestEntourage Y) := by
  change (morphismTestFilterBasis Y X).filter.HasBasis _ _
  refine (morphismTestFilterBasis Y X).hasBasis.to_hasBasis ?_ ?_
  · rintro _ ⟨E, rfl⟩
    exact ⟨E, trivial, Set.Subset.rfl⟩
  · exact fun E _ => ⟨_, Set.mem_range_self E, Set.Subset.rfl⟩

/-- Precomposition by a fixed analytic morphism is uniformly continuous. -/
theorem uniformContinuous_analyticPrecomp (f : W ⟶ Y) :
    @UniformContinuous (Y ⟶ X) (W ⟶ X) (morphismUniformSpace Y X) (morphismUniformSpace W X)
      (fun a => f ≫ a) := by
  let := morphismUniformSpace Y X
  let := morphismUniformSpace W X
  refine ((morphismUniformity_hasBasis Y X).uniformContinuous_iff
    (morphismUniformity_hasBasis W X)).mpr ?_
  exact fun E _ => ⟨E, trivial, fun _ _ h τ hτ => (h τ hτ).precomp f⟩

/-- Postcomposition by a morphism with compact preimages of the test domains
is uniformly continuous. -/
theorem uniformContinuous_analyticPostcomp (g : X ⟶ Z)
    (hc : ∀ τ : TestTriple (presentationOf Z),
      IsCompact (localizedSpaceFunctor.map g ⁻¹' τ.locus)) :
    @UniformContinuous (Y ⟶ X) (Y ⟶ Z) (morphismUniformSpace Y X) (morphismUniformSpace Y Z)
      (fun a => a ≫ g) := by
  classical
  let := morphismUniformSpace Y X
  let := morphismUniformSpace Y Z
  refine ((morphismUniformity_hasBasis Y X).uniformContinuous_iff
    (morphismUniformity_hasBasis Y Z)).mpr ?_
  intro E _
  choose F _ hF using fun τ : E => exists_isNear_postcomp g τ.1 (hc τ.1)
  refine ⟨Finset.univ.biUnion F, trivial, fun a b ha τ hτ => hF ⟨τ, hτ⟩ Y a b ?_⟩
  exact fun σ hσ => ha σ (Finset.mem_biUnion.mpr ⟨⟨τ, hτ⟩, Finset.mem_univ _, hσ⟩)

/-- The automorphism group has the topology induced from the morphism uniformity. -/
@[instance_reducible]
def automorphismTopology (X : LocalizedCategory.{u, v, w} (K := K)) :
    TopologicalSpace (Aut X) :=
  TopologicalSpace.induced (fun σ => σ.asIso.hom) (morphismUniformSpace X X).toTopologicalSpace

/-- Neighbourhoods of an automorphism are generated by the finite chart tests centred at it. -/
theorem automorphismTopology_nhds_hasBasis (σ : Aut X) :
    (@nhds _ (automorphismTopology X) σ).HasBasis (fun _ => True)
      (fun E : Finset (TestTriple (presentationOf X)) =>
        {a | ∀ τ ∈ E, IsNear τ a.asIso.hom σ.asIso.hom}) := by
  let := morphismUniformSpace X X
  change (@nhds _ (TopologicalSpace.induced (fun a : Aut X => a.asIso.hom) inferInstance)
    σ).HasBasis _ _
  rw [nhds_induced]
  exact (nhds_basis_uniformity (morphismUniformity_hasBasis X X)).comap _

private theorem tendsto_automorphismTopology_iff {α : Type*} {l : Filter α}
    {f : α → Aut X} {σ : Aut X} :
    Tendsto f l (@nhds _ (automorphismTopology X) σ) ↔
      ∀ τ, ∀ᶠ a in l, IsNear τ (f a).asIso.hom σ.asIso.hom := by
  rw [(automorphismTopology_nhds_hasBasis σ).tendsto_right_iff]
  constructor
  · intro h τ
    exact (h {τ} trivial).mono fun _ ha => ha τ (Finset.mem_singleton_self τ)
  · intro h E _
    exact E.eventually_all.mpr fun τ _ => h τ

/-- Composition and inversion are continuous for the induced topology. -/
theorem automorphismTopology_isTopologicalGroup (X : LocalizedCategory.{u, v, w} (K := K)) :
    @IsTopologicalGroup (Aut X) (automorphismTopology X) _ := by
  let := automorphismTopology X
  refine { continuous_mul := ?_, continuous_inv := ?_ }
  · refine continuous_iff_continuousAt.mpr fun a => ?_
    apply tendsto_automorphismTopology_iff.mpr
    intro τ
    let e := a.1.asIso
    obtain ⟨E, _, hE⟩ := exists_isNear_postcomp e.hom τ
      ((TopCat.homeoOfIso (localizedSpaceFunctor.mapIso e)).isCompact_preimage.mpr
        τ.isCompact_locus)
    have ha₁ : ∀ᶠ b : Aut X in 𝓝 a.1, IsNear τ b.asIso.hom a.1.asIso.hom :=
      tendsto_automorphismTopology_iff.mp tendsto_id τ
    have ha₂ : ∀ᶠ b : Aut X in 𝓝 a.2, ∀ σ ∈ E, IsNear σ b.asIso.hom a.2.asIso.hom :=
      (automorphismTopology_nhds_hasBasis a.2).mem_of_mem (i := E) trivial
    filter_upwards [continuous_fst.continuousAt (x := a) ha₁,
      continuous_snd.continuousAt (x := a) ha₂] with b hb₁ hb₂
    exact (hb₁.precomp b.2.asIso.hom).trans (hE X _ _ hb₂)
  · refine continuous_iff_continuousAt.mpr fun a => ?_
    apply tendsto_automorphismTopology_iff.mpr
    intro τ
    let e := a.asIso.symm
    obtain ⟨E, _, hE⟩ := exists_isNear_postcomp e.hom τ
      ((TopCat.homeoOfIso (localizedSpaceFunctor.mapIso e)).isCompact_preimage.mpr
        τ.isCompact_locus)
    have ha : ∀ᶠ b : Aut X in 𝓝 a, ∀ σ ∈ E, IsNear σ b.asIso.hom a.asIso.hom :=
      (automorphismTopology_nhds_hasBasis a).mem_of_mem (i := E) trivial
    filter_upwards [ha] with b hb
    have h := (hE X b.asIso.hom a.asIso.hom hb).precomp b.asIso.inv
    change IsNear τ (b.asIso.inv ≫ b.asIso.hom ≫ a.asIso.inv)
      (b.asIso.inv ≫ a.asIso.hom ≫ a.asIso.inv) at h
    rw [Iso.hom_inv_id, Category.comp_id, ← Category.assoc, Iso.inv_hom_id, Category.id_comp] at h
    exact h.symm

/-- The Library's identity-neighbourhood condition is continuity of the action
homomorphism into the automorphism group with its induced topology. -/
theorem isContinuousAction_iff_continuous {G : Type z} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (ρ : G →* Aut X) :
    IsContinuousAction ρ ↔ @Continuous G (Aut X) _ (automorphismTopology X) ρ := by
  let := automorphismTopology X
  let := automorphismTopology_isTopologicalGroup X
  change (∀ τ, ∀ᶠ a in 𝓝 (1 : G),
    IsNear τ (ρ a).asIso.hom (1 : Aut X).asIso.hom) ↔ Continuous ρ
  rw [← tendsto_automorphismTopology_iff (σ := (1 : Aut X)) (f := ρ)]
  exact ⟨continuous_of_tendsto_nhds_one ρ, fun h => by
    simpa only [map_one] using (h.continuousAt (x := (1 : G))).tendsto⟩

end Langlands.Analytic.SaturatedAtlasPresentation
