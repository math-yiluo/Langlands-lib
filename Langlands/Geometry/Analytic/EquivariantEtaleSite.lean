import Langlands.Geometry.Analytic.EtaleSite
import Langlands.Geometry.Analytic.ContinuousAnalyticAction

/-! # The étale site `X(G)_ét` of a `G`-space -/

noncomputable section

universe u v z z'

namespace Langlands.Analytic.SaturatedAtlasPresentation

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {G : Type z} [Group G] [TopologicalSpace G]

namespace GSpace

/-- The underlying analytic space of a `G`-space, and the underlying morphism of a
`G`-morphism. -/
abbrev forget : GSpace.{u, v, v} K G ⥤ LocalizedCategory.{u, v, v} (K := K) :=
  ObjectProperty.ι _ ⋙ Action.forget _ G

/-- Étale `G`-morphisms: `G`-morphisms whose underlying morphism of analytic spaces is
étale. -/
def etale : MorphismProperty (GSpace.{u, v, v} K G) :=
  SaturatedAtlasPresentation.etale.inverseImage forget

theorem etale_iff {U V : GSpace.{u, v, v} K G} (f : U ⟶ V) :
    etale f ↔ SaturatedAtlasPresentation.etale (forget.map f) := Iff.rfl

instance : (etale (K := K) (G := G)).RespectsIso :=
  MorphismProperty.RespectsIso.inverseImage _ _

instance : (etale (K := K) (G := G)).ContainsIdentities :=
  MorphismProperty.ContainsIdentities.inverseImage _

end GSpace

variable (X : GSpace.{u, v, v} K G)

/-- Berkovich's category `Ét(X(G))` of a `G`-space `X`: étale `G`-morphisms `U(G) → X(G)`
from `G`-spaces `U`, with all `G`-morphisms over `X`. -/
abbrev EquivariantEtaleSite := (GSpace.etale (K := K) (G := G)).Over ⊤ X

namespace EquivariantEtaleSite

/-- Forgetting the action: `U(G) ↦ U` from `Ét(X(G))` to `Ét(X)`. -/
def toEtaleSite : EquivariantEtaleSite X ⥤ EtaleSite (GSpace.forget.obj X) :=
  MorphismProperty.Comma.lift
    (MorphismProperty.Over.forget _ _ X ⋙ Over.post GSpace.forget)
    (fun U => U.prop) (fun _ => trivial) (fun _ => trivial)

@[simp]
theorem toEtaleSite_obj_left (U : EquivariantEtaleSite X) :
    ((toEtaleSite X).obj U).left = GSpace.forget.obj U.left := rfl

@[simp]
theorem toEtaleSite_obj_hom (U : EquivariantEtaleSite X) :
    ((toEtaleSite X).obj U).hom = GSpace.forget.map U.hom := rfl

@[simp]
theorem toEtaleSite_map_left {U V : EquivariantEtaleSite X} (f : U ⟶ V) :
    ((toEtaleSite X).map f).left = GSpace.forget.map f.left := rfl

/-- The underlying points of an object of `Ét(X(G))`. -/
def points : EquivariantEtaleSite X ⥤ Type v :=
  toEtaleSite X ⋙ EtaleSite.points _

theorem points_obj (U : EquivariantEtaleSite X) :
    (points X).obj U = localizedSpaceFunctor.obj (GSpace.forget.obj U.left) := rfl

end EquivariantEtaleSite

/-- Coverings of `Ét(X(G))` (Berkovich 1996, §1.2): families `{U_i(G) → U(G)}` whose
underlying point maps are jointly surjective, that is, such that `{U_i → U}` is an étale
covering. -/
def equivariantEtalePrecoverage : Precoverage (EquivariantEtaleSite X) :=
  Types.jointlySurjectivePrecoverage.comap (EquivariantEtaleSite.points X)

/-- The étale topology on `Ét(X(G))`, generated by its coverings: the site `X(G)_ét`. -/
def equivariantEtaleTopology : GrothendieckTopology (EquivariantEtaleSite X) :=
  (equivariantEtalePrecoverage X).toGrothendieck

variable {X}

/-- A family is a covering of `Ét(X(G))` exactly when the family of underlying étale
morphisms is a covering of `Ét(X)`. -/
theorem map_toEtaleSite_mem_etalePrecoverage_iff {U : EquivariantEtaleSite X}
    {R : Presieve U} :
    R.map (EquivariantEtaleSite.toEtaleSite X) ∈
        etalePrecoverage (GSpace.forget.obj X) ((EquivariantEtaleSite.toEtaleSite X).obj U) ↔
      R ∈ equivariantEtalePrecoverage X U := by
  have h : equivariantEtalePrecoverage X =
      (etalePrecoverage (GSpace.forget.obj X)).comap (EquivariantEtaleSite.toEtaleSite X) :=
    Precoverage.comap_comp (EquivariantEtaleSite.toEtaleSite X) (EtaleSite.points _)
      Types.jointlySurjectivePrecoverage
  rw [h, Precoverage.mem_comap_iff]

theorem mem_equivariantEtalePrecoverage_iff {U : EquivariantEtaleSite X} {R : Presieve U} :
    R ∈ equivariantEtalePrecoverage X U ↔
      ∀ x : (EquivariantEtaleSite.points X).obj U, ∃ (V : EquivariantEtaleSite X) (f : V ⟶ U),
        R f ∧ x ∈ Set.range ((EquivariantEtaleSite.points X).map f) :=
  Presieve.mem_comap_jointlySurjectivePrecoverage_iff _

theorem ofArrows_mem_equivariantEtalePrecoverage_iff {U : EquivariantEtaleSite X} {ι : Type*}
    {V : ι → EquivariantEtaleSite X} {f : ∀ i, V i ⟶ U} :
    Presieve.ofArrows V f ∈ equivariantEtalePrecoverage X U ↔
      ∀ x : (EquivariantEtaleSite.points X).obj U, ∃ i,
        x ∈ Set.range ((EquivariantEtaleSite.points X).map (f i)) :=
  Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff _

instance : (equivariantEtalePrecoverage X).HasIsos :=
  inferInstanceAs
    (Types.jointlySurjectivePrecoverage.comap (EquivariantEtaleSite.points X)).HasIsos

instance : (equivariantEtalePrecoverage X).IsStableUnderComposition :=
  inferInstanceAs (Types.jointlySurjectivePrecoverage.comap
    (EquivariantEtaleSite.points X)).IsStableUnderComposition

/-- The sieve generated by a covering is a covering sieve of `X(G)_ét`. -/
theorem generate_mem_equivariantEtaleTopology {U : EquivariantEtaleSite X} {R : Presieve U}
    (hR : R ∈ equivariantEtalePrecoverage X U) :
    Sieve.generate R ∈ equivariantEtaleTopology X U :=
  Precoverage.generate_mem_toGrothendieck hR

/-- The sheaf condition for `X(G)_ét` is the sheaf condition for the pullbacks of the sieves
generated by coverings. -/
theorem isSheaf_equivariantEtaleTopology_iff (P : (EquivariantEtaleSite X)ᵒᵖ ⥤ Type*) :
    Presieve.IsSheaf (equivariantEtaleTopology X) P ↔
      ∀ {U V : EquivariantEtaleSite X} {f : V ⟶ U} (R : Presieve U),
        R ∈ equivariantEtalePrecoverage X U →
          Presieve.IsSheafFor P ((Sieve.generate R).pullback f).arrows :=
  Precoverage.isSheaf_toGrothendieck_iff P

namespace EquivariantEtaleSite

variable {H : Type z'} [Group H] [TopologicalSpace H] (f : H →ₜ* G)

/-- Restriction along a continuous homomorphism `f : H → G`: `U(G) ↦ U(H)`, the functor
underlying the morphism of sites of the morphism `X(H) → X(G)` given by `f`. -/
def res : EquivariantEtaleSite X ⥤ EquivariantEtaleSite ((GSpace.res f).obj X) :=
  MorphismProperty.Comma.lift
    (MorphismProperty.Over.forget _ _ X ⋙ Over.post (GSpace.res f))
    (fun U => U.prop) (fun _ => trivial) (fun _ => trivial)

@[simp]
theorem res_obj_left (U : EquivariantEtaleSite X) :
    ((res f).obj U).left = (GSpace.res f).obj U.left := rfl

@[simp]
theorem res_map_left {U V : EquivariantEtaleSite X} (g : U ⟶ V) :
    ((res f).map g).left = (GSpace.res f).map g.left := rfl

/-- Restriction does not change underlying points. -/
def resPoints : res f ⋙ points ((GSpace.res f).obj X) ≅ points X :=
  Iso.refl _

/-- Restriction preserves and reflects coverings. -/
theorem map_res_mem_equivariantEtalePrecoverage_iff {U : EquivariantEtaleSite X}
    {R : Presieve U} :
    R.map (res f) ∈ equivariantEtalePrecoverage ((GSpace.res f).obj X) ((res f).obj U) ↔
      R ∈ equivariantEtalePrecoverage X U := by
  have h : equivariantEtalePrecoverage X =
      (equivariantEtalePrecoverage ((GSpace.res f).obj X)).comap (res f) :=
    Precoverage.comap_comp (res f) (points _) Types.jointlySurjectivePrecoverage
  rw [h, Precoverage.mem_comap_iff]

end EquivariantEtaleSite

end Langlands.Analytic.SaturatedAtlasPresentation
