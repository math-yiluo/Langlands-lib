import Langlands.Geometry.Analytic.GeneralizedAffinoid.DomainSpectralTests
import Mathlib.Topology.Algebra.FilterBasis
import Mathlib.Topology.Algebra.OpenSubgroup

/-! # The topology generated by finite represented domain spectral tests -/

noncomputable section

universe u v w

namespace Langlands.Analytic.PresentedAffinoidAlgebra.DomainAutomorphism

open CategoryTheory
open scoped Pointwise Topology

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  (A : PresentedAffinoidAlgebra K)

/-- The sets underlying finite families of actual represented domain spectral tests.
The finite index types are chosen in `Type`; the test data still lie over `K`. -/
def domainSpectralBasisSets : Set (Set (Aut A)) :=
  {U | ∃ (ι : Type) (_ : Finite ι) (tests : ι → DomainSpectralTest K A),
    (finiteDomainSpectralSubgroup tests : Set (Aut A)) = U}

/-- The finite represented domain spectral test subgroups form a group filter basis.
Inverse transport of tests supplies conjugation control. -/
@[instance_reducible]
def domainSpectralGroupFilterBasis : GroupFilterBasis (Aut A) where
  sets := domainSpectralBasisSets A
  nonempty := ⟨_, Empty, inferInstance, Empty.elim, rfl⟩
  inter_sets := by
    rintro _ _ ⟨ι, hι, s, rfl⟩ ⟨κ, hκ, t, rfl⟩
    let := hι
    let := hκ
    refine ⟨_, ⟨ι ⊕ κ, inferInstance, Sum.elim s t, rfl⟩, ?_⟩
    rw [finiteDomainSpectralSubgroup_sum]
    exact Set.Subset.rfl
  one' := by
    rintro _ ⟨ι, hι, tests, rfl⟩
    exact (finiteDomainSpectralSubgroup tests).one_mem
  mul' := by
    rintro _ ⟨ι, hι, tests, rfl⟩
    refine ⟨_, ⟨ι, hι, tests, rfl⟩, ?_⟩
    rintro _ ⟨g, hg, h, hh, rfl⟩
    exact (finiteDomainSpectralSubgroup tests).mul_mem hg hh
  inv' := by
    rintro _ ⟨ι, hι, tests, rfl⟩
    refine ⟨_, ⟨ι, hι, tests, rfl⟩, ?_⟩
    intro g hg
    exact (finiteDomainSpectralSubgroup tests).inv_mem hg
  conj' := by
    rintro g _ ⟨ι, hι, tests, rfl⟩
    let moved := fun i => (tests i).transport g⁻¹
    refine ⟨_, ⟨ι, hι, moved, rfl⟩, ?_⟩
    intro h hh
    change h ∈ finiteDomainSpectralSubgroup moved at hh
    rw [finiteDomainSpectralSubgroup_transport] at hh
    rcases hh with ⟨h, hh, rfl⟩
    change g * (g⁻¹ * h * (g⁻¹)⁻¹) * g⁻¹ ∈ finiteDomainSpectralSubgroup tests
    simp only [inv_inv, mul_assoc, mul_inv_cancel,
      mul_one, mul_inv_cancel_left]
    exact hh

/-- The automorphism topology generated by full represented domain spectral tests.
Comparison with all compact analytic domains is a separate obligation. -/
@[instance_reducible]
def domainSpectralTopology : TopologicalSpace (Aut A) :=
  (domainSpectralGroupFilterBasis A).topology

/-- The constructed topology makes bounded automorphisms into a topological group. -/
theorem domainSpectralTopology_isTopologicalGroup :
    @IsTopologicalGroup (Aut A) (domainSpectralTopology A) _ :=
  (domainSpectralGroupFilterBasis A).isTopologicalGroup

/-- Exact neighborhood criterion at the identity, including empty families. -/
theorem mem_nhds_one_domainSpectralTopology (U : Set (Aut A)) :
    U ∈ @nhds (Aut A) (domainSpectralTopology A) 1 ↔
      ∃ (ι : Type) (_ : Finite ι) (tests : ι → DomainSpectralTest K A),
        (finiteDomainSpectralSubgroup tests : Set (Aut A)) ⊆ U := by
  change U ∈ @nhds (Aut A) (domainSpectralGroupFilterBasis A).topology 1 ↔ _
  rw [(domainSpectralGroupFilterBasis A).nhds_one_hasBasis.mem_iff]
  constructor
  · rintro ⟨V, ⟨ι, hι, tests, rfl⟩, hV⟩
    exact ⟨ι, hι, tests, hV⟩
  · rintro ⟨ι, hι, tests, ht⟩
    exact ⟨_, ⟨ι, hι, tests, rfl⟩, ht⟩

/-- Neighborhoods at any automorphism contain a left translate of a finite
represented domain spectral test subgroup. -/
theorem mem_nhds_domainSpectralTopology (g : Aut A) (U : Set (Aut A)) :
    U ∈ @nhds (Aut A) (domainSpectralTopology A) g ↔
      ∃ (ι : Type) (_ : Finite ι) (tests : ι → DomainSpectralTest K A),
        (fun h => g * h) '' (finiteDomainSpectralSubgroup tests : Set (Aut A)) ⊆ U := by
  change U ∈ @nhds (Aut A) (domainSpectralGroupFilterBasis A).topology g ↔ _
  rw [(domainSpectralGroupFilterBasis A).nhds_hasBasis g |>.mem_iff]
  constructor
  · rintro ⟨V, ⟨ι, hι, tests, rfl⟩, hV⟩
    exact ⟨ι, hι, tests, hV⟩
  · rintro ⟨ι, hι, tests, ht⟩
    exact ⟨_, ⟨ι, hι, tests, rfl⟩, ht⟩

/-- Reindexing by any equivalence preserves the finite test subgroup. -/
theorem finiteDomainSpectralSubgroup_reindex {ι : Type v} {κ : Type w}
    [Finite ι] [Finite κ] (e : ι ≃ κ) (tests : κ → DomainSpectralTest K A) :
    finiteDomainSpectralSubgroup (tests ∘ e) = finiteDomainSpectralSubgroup tests := by
  ext g
  simp only [finiteDomainSpectralSubgroup, Subgroup.mem_iInf, Function.comp_apply]
  constructor
  · intro h j
    obtain ⟨i, rfl⟩ := e.surjective j
    exact h i
  · intro h i
    exact h (e i)

/-- The fixed small index universe loses no finite family of tests. -/
theorem finiteDomainSpectralSubgroup_mem_basis {ι : Type v} [Finite ι]
    (tests : ι → DomainSpectralTest K A) :
    (finiteDomainSpectralSubgroup tests : Set (Aut A)) ∈ domainSpectralBasisSets A := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  exact ⟨Fin n, inferInstance, tests ∘ e.symm,
    congrArg (fun H : Subgroup (Aut A) => (H : Set (Aut A)))
      (finiteDomainSpectralSubgroup_reindex A e.symm tests)⟩

/-- A finite represented domain spectral test subgroup is an identity neighborhood,
with no restriction on the finite index universe. -/
theorem finiteDomainSpectralSubgroup_mem_nhds_one {ι : Type v} [Finite ι]
    (tests : ι → DomainSpectralTest K A) :
    (finiteDomainSpectralSubgroup tests : Set (Aut A)) ∈
      @nhds (Aut A) (domainSpectralTopology A) 1 :=
  (domainSpectralGroupFilterBasis A).mem_nhds_one
    (finiteDomainSpectralSubgroup_mem_basis A tests)

/-- Each finite test subgroup is open in the constructed topology. -/
theorem isOpen_finiteDomainSpectralSubgroup {ι : Type v} [Finite ι]
    (tests : ι → DomainSpectralTest K A) :
    @IsOpen (Aut A) (domainSpectralTopology A)
      (finiteDomainSpectralSubgroup tests : Set (Aut A)) := by
  let := domainSpectralTopology A
  let := domainSpectralTopology_isTopologicalGroup A
  exact (finiteDomainSpectralSubgroup tests).isOpen_of_mem_nhds
    (finiteDomainSpectralSubgroup_mem_nhds_one A tests)

/-- A single test is the finite family indexed by `Unit`. -/
@[simp] theorem finiteDomainSpectralSubgroup_unit (t : DomainSpectralTest K A) :
    finiteDomainSpectralSubgroup (fun _ : Unit => t) =
      domainSpectralSubgroup t.domain t.element t.radius t.radius_pos.le := by
  simp [finiteDomainSpectralSubgroup]

/-- Every single positive section test is open in the constructed topology. -/
theorem isOpen_domainSpectralSubgroup (U : Domain K A) (b : U.algebra)
    (r : ℝ) (hr : 0 < r) :
    @IsOpen (Aut A) (domainSpectralTopology A)
      (domainSpectralSubgroup U b r hr.le : Set (Aut A)) := by
  let t : DomainSpectralTest K A := ⟨U, b, r, hr⟩
  simpa only [finiteDomainSpectralSubgroup_unit] using
    isOpen_finiteDomainSpectralSubgroup A (fun _ : Unit => t)

/-- A zero-section test shows that every represented locus stabilizer is open. -/
theorem isOpen_locusStabilizer (U : Domain K A) :
    @IsOpen (Aut A) (domainSpectralTopology A)
      (locusStabilizer U : Set (Aut A)) := by
  simpa only [domainSpectralSubgroup_zero] using
    isOpen_domainSpectralSubgroup A U 0 1 zero_lt_one

end Langlands.Analytic.PresentedAffinoidAlgebra.DomainAutomorphism
