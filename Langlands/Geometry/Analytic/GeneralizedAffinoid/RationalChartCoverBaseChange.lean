import Langlands.Geometry.Analytic.GeneralizedAffinoid.RationalChartCovering
import Langlands.Geometry.Analytic.GeneralizedAffinoid.RationalChartPullbackLimits
import Mathlib.CategoryTheory.Sites.CoverPreserving

/-! # Continuous coefficient change on finite rational chart sites -/

noncomputable section

universe u v w

namespace Langlands.Analytic.PresentedAffinoidAlgebra.RationalChart

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A B : PresentedAffinoidAlgebra K}

omit [CompleteSpace K] in
/-- The exact inverse-image formula carries every point cover to a point cover,
without requiring finiteness or scalar completeness. -/
theorem FamilyCovers.pullback {I : Type u} {d : RationalChart K A}
    {D : I → RationalChart K A} (h : FamilyCovers d D) (φ : BoundedAlgHom K A B) :
    FamilyCovers (pullback φ d) (fun i => pullback φ (D i)) := by
  intro x hx
  rw [pullback_locus] at hx
  obtain ⟨i, hi⟩ := h (BanachSpectrum.comap φ.toBoundedRingHom x) hx
  exact ⟨i, by rw [pullback_locus]; exact hi⟩

/-- The actual pulled-back bounded restrictions witness a finite cover inside
the sieve generated by the image of a covering sieve. -/
theorem IsFiniteCovering.functorPushforward {d : RationalChart K A} {S : Sieve d}
    (hS : IsFiniteCovering S) (φ : BoundedAlgHom K A B) :
    IsFiniteCovering (S.functorPushforward (pullbackFunctor φ)) := by
  obtain ⟨I, hI, D, f, hf, hcover⟩ := hS
  refine ⟨I, hI, fun i => RationalChart.pullback φ (D i),
    fun i => pullbackRestriction φ (f i),
    ?_, hcover.pullback φ⟩
  intro i
  exact Sieve.image_mem_functorPushforward (pullbackFunctor φ) S (hf i)

/-- Coefficient pullback preserves the finite rational covering topologies on
the categories of actual chosen positive-radius rational charts. -/
theorem pullbackFunctor_coverPreserving (φ : BoundedAlgHom K A B) :
    CoverPreserving (finiteRationalTopology K A) (finiteRationalTopology K B)
      (pullbackFunctor φ) :=
  ⟨fun hS => hS.functorPushforward φ⟩

/-- Preservation of the constructed chart pullbacks and covering sieves carries
all one-hypercovers to one-hypercovers of the new finite rational site. -/
instance pullbackFunctor_preservesOneHypercovers (φ : BoundedAlgHom K A B) :
    Functor.PreservesOneHypercovers.{u} (pullbackFunctor φ)
      (finiteRationalTopology K A) (finiteRationalTopology K B) :=
  Functor.PreservesOneHypercovers.of_coverPreserving
    (pullbackFunctor_coverPreserving φ)

/-- Coefficient pullback is a continuous functor between the actual finite
rational chart sites; continuity is proved from constructed maps and covers. -/
instance pullbackFunctor_isContinuous (φ : BoundedAlgHom K A B) :
    Functor.IsContinuous (pullbackFunctor φ)
      (finiteRationalTopology K A) (finiteRationalTopology K B) :=
  Functor.isContinuous_of_preservesOneHypercovers.{u} (pullbackFunctor φ)
    (finiteRationalTopology K A) (finiteRationalTopology K B)

/-- Direct image along the affinoid spectrum map induced by φ, for sheaves
valued in any category E on the actual finite rational chart sites. -/
def coefficientSheafPushforward (φ : BoundedAlgHom K A B)
    (E : Type v) [Category.{w} E] :
    Sheaf (finiteRationalTopology K B) E ⥤ Sheaf (finiteRationalTopology K A) E :=
  (pullbackFunctor φ).sheafPushforwardContinuous E
    (finiteRationalTopology K A) (finiteRationalTopology K B)

/-- The constructed sheaf functor has the actual presheaf restriction along
the opposite coefficient-pullback functor as its underlying presheaf. -/
def coefficientSheafPushforwardCompSheafToPresheafIso (φ : BoundedAlgHom K A B)
    (E : Type v) [Category.{w} E] :
    coefficientSheafPushforward φ E ⋙ sheafToPresheaf (finiteRationalTopology K A) E ≅
      sheafToPresheaf (finiteRationalTopology K B) E ⋙
        (Functor.whiskeringLeft _ _ E).obj (pullbackFunctor φ).op :=
  (pullbackFunctor φ).sheafPushforwardContinuousCompSheafToPresheafIso E
    (finiteRationalTopology K A) (finiteRationalTopology K B)

@[simp]
theorem coefficientSheafPushforward_obj_obj (φ : BoundedAlgHom K A B)
    (E : Type v) [Category.{w} E] (F : Sheaf (finiteRationalTopology K B) E)
    (d : RationalChart K A) :
    ((coefficientSheafPushforward φ E).obj F).obj.obj (Opposite.op d) =
      F.obj.obj (Opposite.op (pullback φ d)) := rfl

end Langlands.Analytic.PresentedAffinoidAlgebra.RationalChart
