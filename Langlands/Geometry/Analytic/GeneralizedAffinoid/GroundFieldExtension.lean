import Langlands.Geometry.Analytic.GeneralizedAffinoid.RelationsUniversalProperty
import Langlands.Geometry.Analytic.GeneralizedTateAlgebra.RelativeAlgebra
import Langlands.Geometry.Analytic.GeneralizedAffinoid.Banach
import Langlands.Geometry.Analytic.BoundedEquivalence.Definitions

/-! # Ground field extension of presented affinoid algebras -/

noncomputable section

universe u v w z

namespace Langlands.Analytic.PresentedAffinoidAlgebra.GroundFieldExtension

open GeneralizedTateAlgebra

section Construction

variable (K : Type u) [NormedField K] [IsUltrametricDist K]
  (L : Type v) [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L]

/-- The isometric structural inclusion of the coefficient field. -/
def coefficientMap : BoundedAlgHom K K L where
  toAlgHom := Algebra.ofId K L
  bounded := ⟨1, zero_lt_one, fun a => by
    change ‖algebraMap K L a‖ ≤ 1 * ‖a‖
    rw [norm_algebraMap', one_mul]⟩

omit [IsUltrametricDist K] [IsUltrametricDist L] in
@[simp] theorem coefficientMap_apply (a : K) :
    coefficientMap K L a = algebraMap K L a := rfl

omit [IsUltrametricDist K] [IsUltrametricDist L] in
theorem norm_coefficientMap (a : K) : ‖coefficientMap K L a‖ = ‖a‖ :=
  norm_algebraMap' L a

variable (A : PresentedAffinoidAlgebra K)

/-- The coefficientwise image in the weighted Tate algebra over `L` of every
element of the closed presentation ideal of `A`. -/
def relations : Set (GeneralizedTateAlgebra A.polyradius L) :=
  mapCoefficientsAlgHom A.polyradius (coefficientMap K L) '' A.ideal

/-- The ground field extension `A_L`: the weighted Tate algebra over `L` with
the arity and radii of `A`, modulo the closure of the ideal generated by the
coefficient extension of the presentation ideal of `A`. -/
def algebra : PresentedAffinoidAlgebra L :=
  ofRelations L A.arity A.polyradius (relations K L A)

@[simp] theorem arity_algebra : (algebra K L A).arity = A.arity := rfl

@[simp] theorem polyradius_algebra : (algebra K L A).polyradius = A.polyradius := rfl

theorem ideal_algebra :
    (algebra K L A).ideal = (Ideal.span (relations K L A)).closure := rfl

/-- `A_L` regarded as a normed `K`-algebra through `K → L`. -/
instance instNormedAlgebraBase : NormedAlgebra K (algebra K L A) :=
  NormedAlgebra.restrictScalars K L (algebra K L A)

instance instIsScalarTower : IsScalarTower K L (algebra K L A) :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- An `L`-linear bounded map regarded as a bounded `K`-algebra map. -/
def overBase {B : Type w} {E : Type z} [NormedCommRing B] [NormedCommRing E]
    [Algebra L B] [Algebra K B] [IsScalarTower K L B]
    [Algebra L E] [Algebra K E] [IsScalarTower K L E]
    (ψ : BoundedAlgHom L B E) : BoundedAlgHom K B E where
  toAlgHom := ψ.toAlgHom.restrictScalars K
  bounded := ψ.bounded

omit [IsUltrametricDist K] [IsUltrametricDist L] in
@[simp] theorem overBase_apply {B : Type w} {E : Type z} [NormedCommRing B] [NormedCommRing E]
    [Algebra L B] [Algebra K B] [IsScalarTower K L B]
    [Algebra L E] [Algebra K E] [IsScalarTower K L E]
    (ψ : BoundedAlgHom L B E) (b : B) : overBase K L ψ b = ψ b := rfl

/-- The presentation map of `A_L`, regarded over `K`. -/
def presentationMapOverBase :
    BoundedAlgHom K (GeneralizedTateAlgebra A.polyradius L) (algebra K L A) where
  toAlgHom := (presentationMap L (algebra K L A)).toAlgHom.restrictScalars K
  bounded := (presentationMap L (algebra K L A)).bounded

/-- Coefficient extension followed by the presentation map of `A_L`. -/
def seriesMap :
    BoundedAlgHom K (GeneralizedTateAlgebra A.polyradius K) (algebra K L A) :=
  (presentationMapOverBase K L A).comp
    (mapCoefficientsAlgHom A.polyradius (coefficientMap K L))

theorem seriesMap_ideal (f : GeneralizedTateAlgebra A.polyradius K) (hf : f ∈ A.ideal) :
    seriesMap K L A f = 0 :=
  presentationMap_relation L A.arity A.polyradius (relations K L A)
    (Set.mem_image_of_mem _ hf)

/-- The structural bounded `K`-algebra map `ι : A → A_L`. -/
def iota : BoundedAlgHom K A (algebra K L A) := by
  letI := A.ideal_closed
  exact BoundedAlgHom.liftQuotient K A.ideal (seriesMap K L A) (seriesMap_ideal K L A)

@[simp] theorem iota_presentationMap (f : GeneralizedTateAlgebra A.polyradius K) :
    iota K L A (presentationMap K A f) =
      presentationMap L (algebra K L A)
        (mapCoefficientsAlgHom A.polyradius (coefficientMap K L) f) := rfl

/-- `ι` sends each presentation coordinate of `A` to the same coordinate of `A_L`. -/
@[simp] theorem iota_coordinate (i : Fin A.arity) :
    iota K L A (coordinate K A i) = coordinate L (algebra K L A) i := by
  change iota K L A (presentationMap K A (X A.polyradius K i)) = _
  rw [iota_presentationMap]
  exact congrArg (presentationMap L (algebra K L A))
    (mapCoefficients_X A.polyradius (coefficientMap K L).toBoundedRingHom i)

/-- `ι` is contractive for the two quotient norms. -/
theorem norm_iota_le (a : A) : ‖iota K L A a‖ ≤ ‖a‖ := by
  let _ := A.ideal_closed
  have h := BoundedAlgHom.quotient_norm_bound A.ideal (iota K L A).toAlgHom.toRingHom 1
    zero_lt_one (fun f => by
      change ‖presentationMap L (algebra K L A)
        (mapCoefficientsAlgHom A.polyradius (coefficientMap K L) f)‖ ≤ 1 * ‖f‖
      refine (norm_presentationMap_le L _ _).trans ?_
      exact norm_mapCoefficientsAlgHom_le A.polyradius (coefficientMap K L) zero_le_one
        (fun a => (norm_coefficientMap K L a).le.trans_eq (one_mul _).symm) f) a
  rw [one_mul] at h
  exact h

/-- The scalar inclusion `L → A_L`, regarded over `K`. -/
def scalarMap : BoundedAlgHom K L (algebra K L A) :=
  overBase K L
    { toAlgHom := Algebra.ofId L (algebra K L A)
      bounded := (BoundedRingHom.scalarHom L (algebra K L A)).bounded }

@[simp] theorem scalarMap_apply (c : L) :
    scalarMap K L A c = algebraMap L (algebra K L A) c := rfl

end Construction

section UniversalProperty

variable (K : Type u) [NormedField K] [IsUltrametricDist K]
  (L : Type v) [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L]
  (A : PresentedAffinoidAlgebra K)

section Uniqueness

variable {E : Type w} [NormedCommRing E] [NormedAlgebra L E] [Algebra K E]
  [IsScalarTower K L E]

/-- Bounded `L`-algebra maps out of `A_L` are determined by their composites
with `ι`. -/
theorem hom_ext (ψ χ : BoundedAlgHom L (algebra K L A) E)
    (h : (overBase K L ψ).comp (iota K L A) = (overBase K L χ).comp (iota K L A)) :
    ψ = χ := by
  apply hom_ext_coordinate L E (algebra K L A)
  intro (i : Fin A.arity)
  have hi := congrArg (fun φ : BoundedAlgHom K A E => φ (coordinate K A i)) h
  change ψ (iota K L A (coordinate K A i)) = χ (iota K L A (coordinate K A i)) at hi
  rw [iota_coordinate] at hi
  exact hi

end Uniqueness

variable (E : Type w) [NormedCommRing E] [IsUltrametricDist E] [CompleteSpace E]
  [NormedAlgebra L E] [NormedAlgebra K E] [IsScalarTower K L E]

/-- Coefficient extension followed by evaluation over `L` at the images of the
coordinates of `A` is the given map on presented series. -/
theorem evaluateHom_comp_mapCoefficients (φ : BoundedAlgHom K A E) :
    (overBase K L (evaluateHom A.polyradius L E (fun i => φ (coordinate K A i))
      (hasBoundedMonomials_coordinate K E A φ))).comp
        (mapCoefficientsAlgHom A.polyradius (coefficientMap K L)) =
      φ.comp (presentationMap K A) := by
  apply GeneralizedTateAlgebra.hom_ext A.polyradius K E
  intro i
  change evaluate A.polyradius L E (fun i => φ (coordinate K A i))
    (mapCoefficients A.polyradius (coefficientMap K L).toBoundedRingHom
      (X A.polyradius K i)) = φ (coordinate K A i)
  rw [mapCoefficients_X]
  exact evaluate_X A.polyradius L E _ i

theorem evaluate_relations (φ : BoundedAlgHom K A E) :
    ∀ f ∈ relations K L A,
      evaluate A.polyradius L E (fun i => φ (coordinate K A i)) f = 0 := by
  rintro f ⟨g, hg, rfl⟩
  have h := congrArg (fun η : BoundedAlgHom K (GeneralizedTateAlgebra A.polyradius K) E => η g)
    (evaluateHom_comp_mapCoefficients K L A E φ)
  change evaluate A.polyradius L E _ _ = φ (presentationMap K A g) at h
  refine h.trans ?_
  rw [(presentationMap_eq_zero_iff K A g).mpr hg]
  exact map_zero φ.toAlgHom

/-- The universal extension of a bounded `K`-algebra map `A → E` to a bounded
`L`-algebra map `A_L → E`. -/
def lift (φ : BoundedAlgHom K A E) : BoundedAlgHom L (algebra K L A) E :=
  evaluateRelations L E A.arity A.polyradius (relations K L A)
    (fun i => φ (coordinate K A i)) (hasBoundedMonomials_coordinate K E A φ)
    (evaluate_relations K L A E φ)

@[simp] theorem lift_coordinate (φ : BoundedAlgHom K A E) (i : Fin A.arity) :
    lift K L A E φ (coordinate L (algebra K L A) i) = φ (coordinate K A i) :=
  evaluateRelations_coordinate L E A.arity A.polyradius (relations K L A) _ _ _ i

theorem lift_comp_iota (φ : BoundedAlgHom K A E) :
    (overBase K L (lift K L A E φ)).comp (iota K L A) = φ := by
  apply hom_ext_coordinate K E A
  intro i
  simp only [BoundedAlgHom.comp_apply, overBase_apply, iota_coordinate, lift_coordinate]

@[simp] theorem lift_iota (φ : BoundedAlgHom K A E) (a : A) :
    lift K L A E φ (iota K L A a) = φ a :=
  congrArg (fun η : BoundedAlgHom K A E => η a) (lift_comp_iota K L A E φ)

theorem lift_unique (φ : BoundedAlgHom K A E) (ψ : BoundedAlgHom L (algebra K L A) E)
    (hψ : (overBase K L ψ).comp (iota K L A) = φ) : ψ = lift K L A E φ :=
  hom_ext K L A ψ _ (hψ.trans (lift_comp_iota K L A E φ).symm)

/-- The universal property of `A_L`: bounded `K`-algebra maps `A → E` extend
uniquely to bounded `L`-algebra maps `A_L → E`. -/
theorem existsUnique_lift (φ : BoundedAlgHom K A E) :
    ∃! ψ : BoundedAlgHom L (algebra K L A) E, (overBase K L ψ).comp (iota K L A) = φ :=
  ⟨lift K L A E φ, lift_comp_iota K L A E φ, fun ψ hψ => lift_unique K L A E φ ψ hψ⟩

/-- Bounded `L`-algebra maps out of `A_L` correspond to bounded `K`-algebra maps
out of `A`. -/
def liftEquiv : BoundedAlgHom K A E ≃ BoundedAlgHom L (algebra K L A) E where
  toFun := lift K L A E
  invFun ψ := (overBase K L ψ).comp (iota K L A)
  left_inv φ := lift_comp_iota K L A E φ
  right_inv ψ := (lift_unique K L A E _ ψ rfl).symm

end UniversalProperty

section Functoriality

variable (K : Type u) [NormedField K] [IsUltrametricDist K]
  (L : Type v) [NormedField L] [IsUltrametricDist L] [CompleteSpace L] [NormedAlgebra K L]

/-- Bounded functoriality: `f : A → B` induces `f_L : A_L → B_L`. -/
def map {A B : PresentedAffinoidAlgebra K} (f : BoundedAlgHom K A B) :
    BoundedAlgHom L (algebra K L A) (algebra K L B) :=
  lift K L A (algebra K L B) ((iota K L B).comp f)

variable {K L}

theorem map_comp_iota {A B : PresentedAffinoidAlgebra K} (f : BoundedAlgHom K A B) :
    (overBase K L (map K L f)).comp (iota K L A) = (iota K L B).comp f :=
  lift_comp_iota K L A _ _

@[simp] theorem map_iota {A B : PresentedAffinoidAlgebra K} (f : BoundedAlgHom K A B)
    (a : A) : map K L f (iota K L A a) = iota K L B (f a) :=
  lift_iota K L A _ _ a

@[simp] theorem map_coordinate {A B : PresentedAffinoidAlgebra K} (f : BoundedAlgHom K A B)
    (i : Fin A.arity) :
    map K L f (coordinate L (algebra K L A) i) = iota K L B (f (coordinate K A i)) :=
  lift_coordinate K L A _ _ i

variable (K L) in
@[simp] theorem map_id (A : PresentedAffinoidAlgebra K) :
    map K L (BoundedAlgHom.id K A) = BoundedAlgHom.id L (algebra K L A) := by
  apply hom_ext K L A
  rw [map_comp_iota]
  rfl

@[simp] theorem map_comp {A B C : PresentedAffinoidAlgebra K}
    (g : BoundedAlgHom K B C) (f : BoundedAlgHom K A B) :
    map K L (g.comp f) = (map K L g).comp (map K L f) := by
  apply hom_ext K L A
  apply BoundedAlgHom.ext
  intro a
  simp only [BoundedAlgHom.comp_apply, overBase_apply, map_iota]

/-- Ground field extension as a functor on presented affinoid algebras. -/
@[simps]
def functor : CategoryTheory.Functor (PresentedAffinoidAlgebra K) (PresentedAffinoidAlgebra L) where
  obj A := algebra K L A
  map f := map K L f
  map_id A := map_id K L A
  map_comp f g := map_comp g f

end Functoriality

section Spectrum

variable (K : Type u) [NormedField K] [IsUltrametricDist K]
  (L : Type v) [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L]

/-- The continuous projection `M(A_L) → M(A)`, restricting multiplicative
seminorms along `ι`. -/
def spectrumProjection (A : PresentedAffinoidAlgebra K) :
    C(BanachSpectrum (algebra K L A), BanachSpectrum A) :=
  BanachSpectrum.comapContinuous (iota K L A).toBoundedRingHom

@[simp] theorem spectrumProjection_apply (A : PresentedAffinoidAlgebra K)
    (x : BanachSpectrum (algebra K L A)) (a : A) :
    spectrumProjection K L A x a = x (iota K L A a) := rfl

variable [CompleteSpace L]

/-- Naturality of the spectrum projection with respect to bounded maps. -/
theorem spectrumProjection_naturality {A B : PresentedAffinoidAlgebra K}
    (f : BoundedAlgHom K A B) (x : BanachSpectrum (algebra K L B)) :
    spectrumProjection K L A (BanachSpectrum.comap (map K L f).toBoundedRingHom x) =
      BanachSpectrum.comap f.toBoundedRingHom (spectrumProjection K L B x) := by
  apply BanachSpectrum.ext
  intro a
  change x (map K L f (iota K L A a)) = x (iota K L B (f a))
  rw [map_iota]

end Spectrum

end Langlands.Analytic.PresentedAffinoidAlgebra.GroundFieldExtension
