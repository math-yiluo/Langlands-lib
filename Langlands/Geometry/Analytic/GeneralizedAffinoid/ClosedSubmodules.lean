import Langlands.Geometry.Analytic.GeneralizedAffinoid.Noetherian
import Langlands.Geometry.Analytic.ClosedSubmodulesBanach

/-! # Closed finite free submodules over general affinoids -/

noncomputable section

universe u v

namespace Langlands.Analytic.PresentedAffinoidAlgebra

section Descent

variable {K : Type u} [NormedField K] [IsUltrametricDist K]
  {L : Type v} [NormedField L] [IsUltrametricDist L]
  (A : PresentedAffinoidAlgebra K) (ι : K →+* L) (hι : ∀ a, ‖ι a‖ = ‖a‖)
  {c : Fin A.arity → L} (hc : ∀ j, ‖c j‖ = A.polyradius j)
  (π : L →+ K) (hπ : ∀ a x, π (ι a * x) = a * π x)
  {D : ℝ} (hD : 0 ≤ D) (hπD : ∀ x, ‖π x‖ ≤ D * ‖x‖)
  {m : ℕ}

/-- Vectors in the strict scalar extension whose every scalar multiple
retracts coordinatewise into the original submodule. -/
def strictBaseChangeDescentSubmodule (S : Submodule A (Fin m → A)) :
    Submodule (strictBaseChange A ι hι hc) (Fin m → strictBaseChange A ι hι hc) where
  carrier := {v | ∀ b, (fun j =>
    strictBaseChangeRetraction A ι hι hc π hπ hD hπD (b * v j)) ∈ S}
  zero_mem' := fun b => by
    convert S.zero_mem using 1
    ext j
    simp
  add_mem' := fun {v w} hv hw b => by
    convert S.add_mem (hv b) (hw b) using 1
    ext j
    simp only [Pi.add_apply, mul_add, map_add]
  smul_mem' := fun a v hv b => by
    simpa only [Pi.smul_apply, smul_eq_mul, ← mul_assoc] using hv (b * a)

include hπ hD hπD in
/-- The submodule generated by coordinatewise base-changed vectors descends
into the original submodule under every scalar multiple of the retraction. -/
theorem span_strictBaseChange_le_descentSubmodule (S : Submodule A (Fin m → A)) :
    Submodule.span (strictBaseChange A ι hι hc)
      ((fun v : Fin m → A => fun j => strictBaseChangeHom A ι hι hc (v j)) ''
        (S : Set (Fin m → A))) ≤
      strictBaseChangeDescentSubmodule A ι hι hc π hπ hD hπD S := by
  apply Submodule.span_le.mpr
  rintro _ ⟨v, hv, rfl⟩ b
  have h := S.smul_mem (strictBaseChangeRetraction A ι hι hc π hπ hD hπD b) hv
  convert h using 1
  ext j
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [mul_comm b, strictBaseChangeRetraction_strictBaseChangeHom_mul, mul_comm]

include hπ hD hπD in
/-- Extension by the strict scalar embedding contracts to the original finite
free submodule, with no flatness assumption on that embedding. -/
theorem preimage_span_strictBaseChange (hπ1 : π 1 = 1)
    (S : Submodule A (Fin m → A)) :
    (fun v : Fin m → A => fun j => strictBaseChangeHom A ι hι hc (v j)) ⁻¹'
      (Submodule.span (strictBaseChange A ι hι hc)
        ((fun v : Fin m → A => fun j => strictBaseChangeHom A ι hι hc (v j)) ''
          (S : Set (Fin m → A))) : Set _) = S := by
  ext v
  constructor
  · intro hv
    have h := span_strictBaseChange_le_descentSubmodule A ι hι hc π hπ hD hπD S hv 1
    have heq : (fun j => strictBaseChangeRetraction A ι hι hc π hπ hD hπD
        (1 * strictBaseChangeHom A ι hι hc (v j))) = v := by
      funext j
      rw [one_mul, strictBaseChangeRetraction_strictBaseChangeHom
        A ι hι hc π hπ hD hπD hπ1]
    rw [heq] at h
    exact h
  · intro hv
    exact Submodule.subset_span ⟨v, hv, rfl⟩

end Descent

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- Every submodule of a finite free module over a general positive-radius
presented affinoid is closed for the original finite-product norm. -/
theorem isClosed_submodule_pi (A : PresentedAffinoidAlgebra K) {m : ℕ}
    (S : Submodule A (Fin m → A)) : IsClosed (S : Set (Fin m → A)) := by
  let t : Fin A.arity ⊕ Unit → ℝ := Sum.elim A.polyradius (fun _ => 2)
  obtain ⟨R⟩ := FiniteRadiusRealization.nonempty (K := K) t (by
    intro j
    cases j with
    | inl j => exact A.polyradius.positive j
    | inr j => norm_num [t])
  let : NontriviallyNormedField R.L :=
    { (inferInstance : NormedField R.L) with
      non_trivial := ⟨R.c (.inr ()), by rw [R.norm_c]; norm_num [t]⟩ }
  let c : Fin A.arity → R.L := fun j => R.c (.inl j)
  have hc : ∀ j, ‖c j‖ = A.polyradius j := fun j => R.norm_c (.inl j)
  let f := strictBaseChangeHom A R.ι R.norm_ι hc
  let F : (Fin m → A) → (Fin m → strictBaseChange A R.ι R.norm_ι hc) :=
    fun v j => f (v j)
  have hclosed := isClosed_submodule_pi_of_noetherian_banach (K := R.L)
      (Submodule.span (strictBaseChange A R.ι R.norm_ι hc) (F '' (S : Set (Fin m → A))))
  have hf : Continuous f := AddMonoidHomClass.continuous_of_bound f 1
    (fun a => by simpa only [one_mul] using
      norm_strictBaseChangeHom_le A R.ι R.norm_ι hc a)
  have hF : Continuous F := continuous_pi fun j => hf.comp (continuous_apply j)
  have hS := preimage_span_strictBaseChange A R.ι R.norm_ι hc
    R.π R.π_ι_mul R.bound_pos.le R.norm_π_le R.π_one S
  exact hS ▸ hclosed.preimage hF

end Langlands.Analytic.PresentedAffinoidAlgebra
