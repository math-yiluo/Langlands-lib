import Langlands.Geometry.Analytic.GeneralizedAffinoid.FiniteAffinoidAlgebraDescent.MatchingAlgebra
import Mathlib.Topology.Constructions

/-! # Actual spectral gluing and the output of finite affinoid algebra descent -/

noncomputable section

universe u

namespace Langlands.Analytic.PresentedAffinoidAlgebra.FiniteAffinoidAlgebraDescent

open CategoryTheory

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {R : PresentedAffinoidAlgebra K}
  {c : Domain.FiniteCover (Domain.whole K R)} {F : LocalAlgebras c}

namespace PairTransitions

variable (t : PairTransitions F)

/-- The actual finite disjoint union of the original local spectra. -/
abbrev SpectrumFamily (_t : PairTransitions F) :=
  Σ i : Fin c.size, BanachSpectrum (F.algebra i)

/-- The generating identifications are exactly the two maps from every actual
closed-quotient overlap spectrum. -/
def OverlapRelation (a b : t.SpectrumFamily) : Prop :=
  ∃ (i j : Fin c.size)
    (z : BanachSpectrum (F.baseChange j (F.overlap i j) (F.overlapRight i j))),
    a = ⟨i, BanachSpectrum.comap (t.leftRestriction i j).toBoundedRingHom z⟩ ∧
      b = ⟨j, BanachSpectrum.comap (t.rightRestriction i j).toBoundedRingHom z⟩

/-- The quotient by the equivalence relation generated by the original overlap
identifications, with the actual quotient topology. -/
abbrev GluedSpectrum := Quot t.OverlapRelation

def glue (i : Fin c.size) : C(BanachSpectrum (F.algebra i), t.GluedSpectrum) where
  toFun x := Quot.mk _ ⟨i, x⟩
  continuous_toFun := continuous_quot_mk.comp continuous_sigmaMk

def componentSpectrumMap (i : Fin c.size) :
    C(BanachSpectrum (F.algebra i), BanachSpectrum t.MatchingAlgebra) :=
  BanachSpectrum.comapContinuous (t.projection i).toBoundedRingHom

theorem componentSpectrumMap_overlap (i j : Fin c.size)
    (z : BanachSpectrum (F.baseChange j (F.overlap i j) (F.overlapRight i j))) :
    t.componentSpectrumMap i
        (BanachSpectrum.comap (t.leftRestriction i j).toBoundedRingHom z) =
      t.componentSpectrumMap j
        (BanachSpectrum.comap (t.rightRestriction i j).toBoundedRingHom z) := by
  apply BanachSpectrum.ext
  intro s
  exact congrArg (fun q : BoundedAlgHom K t.MatchingAlgebra
    (F.baseChange j (F.overlap i j) (F.overlapRight i j)) => z (q s))
      (t.projection_overlap i j)

def spectrumFamilyMap : C(t.SpectrumFamily, BanachSpectrum t.MatchingAlgebra) where
  toFun x := t.componentSpectrumMap x.1 x.2
  continuous_toFun := continuous_sigma fun i => (t.componentSpectrumMap i).continuous

theorem spectrumFamilyMap_respects (a b : t.SpectrumFamily)
    (h : t.OverlapRelation a b) : t.spectrumFamilyMap a = t.spectrumFamilyMap b := by
  obtain ⟨i, j, z, rfl, rfl⟩ := h
  exact t.componentSpectrumMap_overlap i j z

/-- The canonical continuous map to the spectrum of the already constructed
matching Banach algebra. Its bijectivity is an effectiveness obligation. -/
def spectrumMap : C(t.GluedSpectrum, BanachSpectrum t.MatchingAlgebra) where
  toFun := Quot.lift t.spectrumFamilyMap t.spectrumFamilyMap_respects
  continuous_toFun := continuous_quot_lift _ t.spectrumFamilyMap.continuous

@[simp] theorem spectrumMap_glue (i : Fin c.size)
    (x : BanachSpectrum (F.algebra i)) :
    t.spectrumMap (t.glue i x) = t.componentSpectrumMap i x := rfl

end PairTransitions

/-- A presented affinoid realization of the entire matching Banach algebra.
This is output data, never a premise in the effectiveness statement. -/
structure MatchingPresentation (t : PairTransitions F) where
  algebra : PresentedAffinoidAlgebra K
  equiv : BoundedAlgEquiv K algebra t.MatchingAlgebra

namespace MatchingPresentation

variable {t : PairTransitions F} (P : MatchingPresentation t)

/-- Transport of the original structural map, retaining both norm bounds. -/
def baseMap : BoundedAlgHom K R P.algebra :=
  P.equiv.symm.toBoundedAlgHom.comp t.structuralMap

def localMap (i : Fin c.size) : BoundedAlgHom K P.algebra (F.algebra i) :=
  (t.projection i).comp P.equiv.toBoundedAlgHom

theorem localMap_baseMap (i : Fin c.size) :
    (P.localMap i).comp P.baseMap = F.structuralMap i := by
  apply BoundedAlgHom.ext
  intro r
  change t.projection i (P.equiv (P.equiv.symm (t.structuralMap r))) =
    F.structuralMap i r
  rw [P.equiv.apply_symm_apply]
  rfl

/-- The original base change along the stored R to R_i bounded cover map. -/
abbrev originalBaseChange (i : Fin c.size) : PresentedAffinoidAlgebra K :=
  AffinoidPushout.algebra P.baseMap (c.map i).restriction

/-- The comparison is constructed from the original two entire bounded legs. -/
def comparison (i : Fin c.size) :
    BoundedAlgHom K (P.originalBaseChange i) (F.algebra i) :=
  AffinoidPushout.lift P.baseMap (c.map i).restriction (F.algebra i)
    (P.localMap i) (F.map i) (P.localMap_baseMap i)

theorem comparison_left (i : Fin c.size) :
    (P.comparison i).comp (AffinoidPushout.leftMap P.baseMap (c.map i).restriction) =
      P.localMap i :=
  AffinoidPushout.lift_comp_leftMap _ _ _ _ _ _

theorem comparison_right (i : Fin c.size) :
    (P.comparison i).comp (AffinoidPushout.rightMap P.baseMap (c.map i).restriction) =
      F.map i :=
  AffinoidPushout.lift_comp_rightMap _ _ _ _ _ _

/-- The same original global map, changed to any actual full base domain. -/
abbrev domainBaseChange (E : Domain K R) : PresentedAffinoidAlgebra K :=
  AffinoidPushout.algebra P.baseMap E.baseMap

private theorem restrictedComparison_compatible (i : Fin c.size) (E : Domain K R)
    (h : E.locus ⊆ (c.obj i).locus) :
    ((F.localMap i E h).comp (P.localMap i)).comp P.baseMap =
      (F.baseMap i E h).comp E.baseMap := by
  rw [BoundedAlgHom.comp_assoc, P.localMap_baseMap, F.structuralMap_eq,
    ← BoundedAlgHom.comp_assoc, F.condition, BoundedAlgHom.comp_assoc,
    restriction_baseMap]

/-- The induced comparison on an arbitrary actual subdomain, constructed from
the same original global and local structural maps. -/
def restrictedComparison (i : Fin c.size) (E : Domain K R)
    (h : E.locus ⊆ (c.obj i).locus) :
    BoundedAlgHom K (P.domainBaseChange E) (F.baseChange i E h) :=
  AffinoidPushout.lift P.baseMap E.baseMap _
    ((F.localMap i E h).comp (P.localMap i)) (F.baseMap i E h)
    (P.restrictedComparison_compatible i E h)

theorem restrictedComparison_left (i : Fin c.size) (E : Domain K R)
    (h : E.locus ⊆ (c.obj i).locus) :
    (P.restrictedComparison i E h).comp
      (AffinoidPushout.leftMap P.baseMap E.baseMap) =
        (F.localMap i E h).comp (P.localMap i) :=
  AffinoidPushout.lift_comp_leftMap _ _ _ _ _ _

theorem restrictedComparison_right (i : Fin c.size) (E : Domain K R)
    (h : E.locus ⊆ (c.obj i).locus) :
    (P.restrictedComparison i E h).comp
      (AffinoidPushout.rightMap P.baseMap E.baseMap) = F.baseMap i E h :=
  AffinoidPushout.lift_comp_rightMap _ _ _ _ _ _

/-- Equality of the entire comparison maps on every original intersection. -/
def OverlapCompatible : Prop :=
  ∀ i j, (t.equiv i j).toBoundedAlgHom.comp
    (P.restrictedComparison i (F.overlap i j) (F.overlapLeft i j)) =
      P.restrictedComparison j (F.overlap i j) (F.overlapRight i j)

/-- The actual inverse image of the original base-domain locus. -/
def preimageLocus (i : Fin c.size) : Set (BanachSpectrum P.algebra) :=
  (BanachSpectrum.comap P.baseMap.toBoundedRingHom) ⁻¹' (c.obj i).locus

theorem localSpectrumMap_mem (i : Fin c.size) (x : BanachSpectrum (F.algebra i)) :
    BanachSpectrum.comap (P.localMap i).toBoundedRingHom x ∈ P.preimageLocus i := by
  have heq :
      BanachSpectrum.comap P.baseMap.toBoundedRingHom
          (BanachSpectrum.comap (P.localMap i).toBoundedRingHom x) =
        (c.obj i).spectrumMap
          (BanachSpectrum.comap (F.map i).toBoundedRingHom x) := by
    apply BanachSpectrum.ext
    intro r
    exact congrArg (fun q : BoundedAlgHom K R (F.algebra i) => x (q r))
      ((P.localMap_baseMap i).trans (F.structuralMap_eq i))
  change BanachSpectrum.comap P.baseMap.toBoundedRingHom
    (BanachSpectrum.comap (P.localMap i).toBoundedRingHom x) ∈ (c.obj i).locus
  rw [heq]
  exact (c.obj i).represents.hasImageIn _

def localSpectrumMap (i : Fin c.size) :
    C(BanachSpectrum (F.algebra i), P.preimageLocus i) where
  toFun x := ⟨BanachSpectrum.comap (P.localMap i).toBoundedRingHom x,
    P.localSpectrumMap_mem i x⟩
  continuous_toFun := (BanachSpectrum.comapContinuous
    (P.localMap i).toBoundedRingHom).continuous.subtype_mk _

/-- The canonical map from the actual glued spectrum to the presented
realization's spectrum, using the bounded matching-algebra equivalence. -/
def spectrumMap : C(t.GluedSpectrum, BanachSpectrum P.algebra) where
  toFun x := P.equiv.spectrumHomeomorph (t.spectrumMap x)
  continuous_toFun := P.equiv.spectrumHomeomorph.continuous.comp t.spectrumMap.continuous

theorem spectrumMap_glue (i : Fin c.size) (x : BanachSpectrum (F.algebra i)) :
    P.spectrumMap (t.glue i x) =
      BanachSpectrum.comap (P.localMap i).toBoundedRingHom x := rfl

end MatchingPresentation

/-- All effectiveness outputs for the original finite Banach descent data.
No part of this record is required as an input to the descent statement. -/
structure EffectiveRealization (d : DescentData F)
    extends MatchingPresentation d.toPairTransitions where
  finite_matching : d.toPairTransitions.structuralMap.IsFiniteBanach
  finite : toMatchingPresentation.baseMap.IsFiniteBanach
  comparisonEquiv : ∀ i, BoundedAlgEquiv K
    (toMatchingPresentation.originalBaseChange i) (F.algebra i)
  comparison_eq : ∀ i, (comparisonEquiv i).toBoundedAlgHom =
    toMatchingPresentation.comparison i
  overlap_compatible : toMatchingPresentation.OverlapCompatible
  spectrumEquiv : d.toPairTransitions.GluedSpectrum ≃ₜ BanachSpectrum algebra
  spectrumEquiv_eq : ∀ x, spectrumEquiv x = toMatchingPresentation.spectrumMap x
  localSpectrumEquiv : ∀ i, BanachSpectrum (F.algebra i) ≃ₜ
    toMatchingPresentation.preimageLocus i
  localSpectrumEquiv_eq : ∀ i x,
    localSpectrumEquiv i x = toMatchingPresentation.localSpectrumMap i x

end Langlands.Analytic.PresentedAffinoidAlgebra.FiniteAffinoidAlgebraDescent
