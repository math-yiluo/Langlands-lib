import Langlands.Geometry.Analytic.GeneralizedAffinoid.Banach
import Langlands.Geometry.Analytic.GeneralizedAffinoid.Relations
import Langlands.Geometry.Analytic.GeneralizedAffinoid.RelativeSeriesMap
import Langlands.Geometry.Analytic.GeneralizedTateAlgebra.RelativeAlgebra
import Langlands.Geometry.Analytic.GeneralizedTateAlgebra.Completeness
import Langlands.Geometry.Analytic.BoundedQuotient

/-! # Closed-equation quotients of relative weighted restricted series -/

noncomputable section

universe u v

namespace Langlands.Analytic.PresentedAffinoidAlgebra.RelativeRelations

open GeneralizedTateAlgebra

variable (K : Type u) [NormedField K] [IsUltrametricDist K]
  (A : PresentedAffinoidAlgebra K) {m : ℕ} (s : PositivePolyradius (Fin m))
  (E : Set (GeneralizedTateAlgebra s A))

/-- The closure of the ideal generated by the supplied relative series equations. -/
def ideal : Ideal (GeneralizedTateAlgebra s A) := (Ideal.span E).closure

theorem ideal_closed : IsClosed (ideal K A s E : Set (GeneralizedTateAlgebra s A)) :=
  isClosed_closure

instance : IsClosed (ideal K A s E : Set (GeneralizedTateAlgebra s A)) :=
  ideal_closed K A s E

/-- The actual ring quotient of relative weighted series by the closed generated ideal. -/
def QuotientAlgebra := GeneralizedTateAlgebra s A ⧸ ideal K A s E

instance : NormedCommRing (QuotientAlgebra K A s E) :=
  inferInstanceAs (NormedCommRing (GeneralizedTateAlgebra s A ⧸ ideal K A s E))

instance : NormedAlgebra K (QuotientAlgebra K A s E) :=
  inferInstanceAs (NormedAlgebra K (GeneralizedTateAlgebra s A ⧸ ideal K A s E))

instance : Algebra A (QuotientAlgebra K A s E) :=
  inferInstanceAs (Algebra A (GeneralizedTateAlgebra s A ⧸ ideal K A s E))

instance : IsScalarTower K A (QuotientAlgebra K A s E) :=
  inferInstanceAs (IsScalarTower K A (GeneralizedTateAlgebra s A ⧸ ideal K A s E))

instance : IsUltrametricDist (QuotientAlgebra K A s E) :=
  IsUltrametricDist.isUltrametricDist_of_forall_norm_add_le_max_norm fun x y => by
    apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨a, rfl, ha⟩ := Ideal.Quotient.norm_mk_lt x hε
    obtain ⟨b, rfl, hb⟩ := Ideal.Quotient.norm_mk_lt y hε
    calc
      ‖Ideal.Quotient.mk (ideal K A s E) a + Ideal.Quotient.mk (ideal K A s E) b‖
          ≤ ‖a + b‖ := by
            rw [← map_add]
            exact Ideal.Quotient.norm_mk_le (ideal K A s E) _
      _ ≤ max ‖a‖ ‖b‖ := IsUltrametricDist.norm_add_le_max _ _
      _ ≤ max (‖Ideal.Quotient.mk (ideal K A s E) a‖ + ε)
          (‖Ideal.Quotient.mk (ideal K A s E) b‖ + ε) := max_le_max ha.le hb.le
      _ = _ := max_add_add_right _ _ _

/-- Over a complete field, the quotient of the complete relative series algebra
is complete. -/
instance instCompleteSpace [CompleteSpace K] : CompleteSpace (QuotientAlgebra K A s E) :=
  inferInstanceAs (CompleteSpace (GeneralizedTateAlgebra s A ⧸ ideal K A s E))

/-- The contractive quotient map from relative weighted series. -/
def quotientMap : BoundedAlgHom K (GeneralizedTateAlgebra s A) (QuotientAlgebra K A s E) :=
  BoundedAlgHom.quotientMap K (ideal K A s E)

@[simp] theorem quotientMap_apply (f : GeneralizedTateAlgebra s A) :
    quotientMap K A s E f = Ideal.Quotient.mk (ideal K A s E) f := rfl

theorem quotientMap_surjective : Function.Surjective (quotientMap K A s E) :=
  Ideal.Quotient.mk_surjective

/-- The kernel of the quotient map is exactly the displayed closed ideal. -/
theorem quotientMap_eq_zero_iff (f : GeneralizedTateAlgebra s A) :
    quotientMap K A s E f = 0 ↔ f ∈ (Ideal.span E).closure :=
  Ideal.Quotient.eq_zero_iff_mem

theorem ker_quotientMap :
    RingHom.ker (quotientMap K A s E).toAlgHom = (Ideal.span E).closure :=
  Ideal.Quotient.mkₐ_ker K (ideal K A s E)

theorem equation_mem {f : GeneralizedTateAlgebra s A} (hf : f ∈ E) :
    f ∈ (Ideal.span E).closure :=
  subset_closure (Ideal.subset_span hf)

/-- Every supplied equation vanishes in the quotient. -/
@[simp] theorem quotientMap_equation {f : GeneralizedTateAlgebra s A} (hf : f ∈ E) :
    quotientMap K A s E f = 0 :=
  (quotientMap_eq_zero_iff K A s E f).mpr (equation_mem K A s E hf)

theorem norm_quotientMap_le (f : GeneralizedTateAlgebra s A) :
    ‖quotientMap K A s E f‖ ≤ ‖f‖ :=
  Ideal.Quotient.norm_mk_le (ideal K A s E) f

/-- The norm is the quotient norm: representatives have arbitrarily small excess. -/
theorem exists_representative_norm_lt (a : QuotientAlgebra K A s E) {ε : ℝ} (hε : 0 < ε) :
    ∃ f, quotientMap K A s E f = a ∧ ‖f‖ < ‖a‖ + ε :=
  Ideal.Quotient.norm_mk_lt a hε

/-- The coefficient map: constant series followed by the quotient map. -/
def baseMap : BoundedAlgHom K A (QuotientAlgebra K A s E) :=
  (quotientMap K A s E).comp (constantAlgHom s K A)

@[simp] theorem baseMap_apply (a : A) :
    baseMap K A s E a = quotientMap K A s E (constantAlgHom s K A a) := rfl

/-- The coefficient map is the algebra map of the inherited `A`-algebra structure. -/
theorem baseMap_eq_algebraMap (a : A) :
    baseMap K A s E a = algebraMap A (QuotientAlgebra K A s E) a := rfl

theorem norm_baseMap_le (a : A) : ‖baseMap K A s E a‖ ≤ ‖a‖ :=
  (norm_quotientMap_le K A s E _).trans_eq (norm_constantAlgHom s K A a)

/-- The image of a new relative series variable. -/
def newCoordinate (j : Fin m) : QuotientAlgebra K A s E :=
  quotientMap K A s E (X s A j)

/-- Each new coordinate has norm at most its supplied positive radius. -/
theorem norm_newCoordinate_le (j : Fin m) : ‖newCoordinate K A s E j‖ ≤ s j := by
  refine (norm_quotientMap_le K A s E (X s A j)).trans ?_
  rw [norm_X]
  exact mul_le_of_le_one_left (s.positive j).le (norm_one_le K A)

section Descent

variable (B : Type v) [NormedCommRing B] [NormedAlgebra K B]

/-- A bounded map annihilating the equations annihilates their closed generated ideal. -/
theorem annihilates_ideal (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) : ∀ f ∈ (Ideal.span E).closure, φ f = 0 :=
  φ.annihilates_closure (Ideal.span E)
    (Ideal.span_le.mpr hE : Ideal.span E ≤ RingHom.ker φ.toAlgHom.toRingHom)

/-- The bounded descent of a map annihilating the supplied equations. -/
def descend (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) : BoundedAlgHom K (QuotientAlgebra K A s E) B :=
  BoundedAlgHom.liftQuotient K (ideal K A s E) φ (annihilates_ideal K A s E B φ hE)

@[simp] theorem descend_quotientMap (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) (f : GeneralizedTateAlgebra s A) :
    descend K A s E B φ hE (quotientMap K A s E f) = φ f := rfl

/-- The descent is computed by any representative. -/
theorem descend_eq_of_quotientMap_eq (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) {a : QuotientAlgebra K A s E} {f : GeneralizedTateAlgebra s A}
    (hf : quotientMap K A s E f = a) : descend K A s E B φ hE a = φ f := by
  rw [← hf, descend_quotientMap]

theorem descend_comp_quotientMap (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) : (descend K A s E B φ hE).comp (quotientMap K A s E) = φ :=
  BoundedAlgHom.ext fun _ => rfl

@[simp] theorem descend_baseMap (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) (a : A) :
    descend K A s E B φ hE (baseMap K A s E a) = φ (constantAlgHom s K A a) := rfl

@[simp] theorem descend_newCoordinate (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) (j : Fin m) :
    descend K A s E B φ hE (newCoordinate K A s E j) = φ (X s A j) := rfl

/-- Maps out of the quotient are determined by their composites with the quotient map. -/
theorem hom_ext (ψ₁ ψ₂ : BoundedAlgHom K (QuotientAlgebra K A s E) B)
    (h : ∀ f, ψ₁ (quotientMap K A s E f) = ψ₂ (quotientMap K A s E f)) : ψ₁ = ψ₂ :=
  BoundedAlgHom.quotient_hom_ext K (ideal K A s E) ψ₁ ψ₂ h

/-- The descent is the unique map with the given composite. -/
theorem eq_descend (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) (ψ : BoundedAlgHom K (QuotientAlgebra K A s E) B)
    (hψ : ψ.comp (quotientMap K A s E) = φ) : ψ = descend K A s E B φ hE :=
  hom_ext K A s E B _ _ fun f => by
    rw [descend_quotientMap, ← hψ]
    rfl

/-- Descent preserves every supplied positive bound for the actual quotient norm. -/
theorem norm_descend_le (φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B)
    (hE : ∀ f ∈ E, φ f = 0) (C : ℝ) (hC : 0 < C)
    (hbound : ∀ f, ‖φ f‖ ≤ C * ‖f‖) (a : QuotientAlgebra K A s E) :
    ‖descend K A s E B φ hE a‖ ≤ C * ‖a‖ :=
  BoundedAlgHom.quotient_norm_bound (ideal K A s E)
    (descend K A s E B φ hE).toAlgHom.toRingHom C hC hbound a

/-- Bounded maps out of the quotient are exactly bounded relative series maps
annihilating the supplied equations. -/
def homEquiv :
    BoundedAlgHom K (QuotientAlgebra K A s E) B ≃
      {φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B // ∀ f ∈ E, φ f = 0} where
  toFun ψ := ⟨ψ.comp (quotientMap K A s E), fun f hf => by
    change ψ.toAlgHom (quotientMap K A s E f) = 0
    rw [quotientMap_equation K A s E hf, map_zero]⟩
  invFun φ := descend K A s E B φ.val φ.property
  left_inv ψ := hom_ext K A s E B _ _ fun _ => rfl
  right_inv φ := Subtype.ext (BoundedAlgHom.ext fun _ => rfl)

@[simp] theorem homEquiv_apply_coe (ψ : BoundedAlgHom K (QuotientAlgebra K A s E) B) :
    (homEquiv K A s E B ψ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B) =
      ψ.comp (quotientMap K A s E) := rfl

@[simp] theorem homEquiv_symm_apply
    (φ : {φ : BoundedAlgHom K (GeneralizedTateAlgebra s A) B // ∀ f ∈ E, φ f = 0}) :
    (homEquiv K A s E B).symm φ = descend K A s E B φ.val φ.property := rfl

end Descent

end Langlands.Analytic.PresentedAffinoidAlgebra.RelativeRelations
