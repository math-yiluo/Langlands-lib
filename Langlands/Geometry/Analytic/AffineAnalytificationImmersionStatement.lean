import Langlands.Geometry.Analytic.AffineAnalytificationMap
import Mathlib.RingTheory.Localization.Away.Basic

/-! # Statement: analytification of affine closed and open immersions -/

universe u v w x

namespace Langlands.Analytic.AffineAnalytification

open Set Topology

/-- Statement (affine case of the forward implications of Berkovich 1990,
Proposition 3.4.7(2) and Proposition 3.4.6(8), on underlying topological spaces,
together with the identity `|Y^an| = |X^an| \ π⁻¹(T)` from the proof of
Proposition 3.4.4; Conrad 2011, printed p.19, uses that analytification is
compatible with open and closed immersions): for a complete nonarchimedean
nontrivially normed field `K` and a finite polynomial presentation `P` of a
commutative `K`-algebra `A`,
1. for every surjective `K`-algebra map `f : A → B` and every finite polynomial
   presentation `Q` of `B`, the induced map `baseMap K P Q f` of analytic spaces is a
   closed embedding;
2. for every `g : A`, every localization `B` of `A` away from `g` and every finite
   polynomial presentation `Q` of `B`, the map induced by `A → B` is an open
   embedding;
3. if moreover `C` is a quotient of `A` with kernel exactly the ideal generated by
   `g`, with a finite polynomial presentation `R`, then the range of the map
   induced by `A → B` is the complement of the range of the map induced by
   `A → C`. -/
def AffineAnalytificationImmersionStatement : Prop :=
  ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    (A : Type v) [CommRing A] [Algebra K A] (P : FinitePolynomialPresentation K A),
    (∀ (B : Type w) [CommRing B] [Algebra K B] (Q : FinitePolynomialPresentation K B)
        (f : A →ₐ[K] B), Function.Surjective f →
        IsClosedEmbedding (baseMap K P Q f)) ∧
    (∀ (g : A) (B : Type w) [CommRing B] [Algebra K B] [Algebra A B] [IsScalarTower K A B]
        [IsLocalization.Away g B] (Q : FinitePolynomialPresentation K B),
        IsOpenEmbedding (baseMap K P Q (IsScalarTower.toAlgHom K A B))) ∧
    (∀ (g : A) (B : Type w) [CommRing B] [Algebra K B] [Algebra A B] [IsScalarTower K A B]
        [IsLocalization.Away g B] (C : Type x) [CommRing C] [Algebra K C] [Algebra A C]
        [IsScalarTower K A C] (Q : FinitePolynomialPresentation K B)
        (R : FinitePolynomialPresentation K C),
        Function.Surjective (algebraMap A C) →
        RingHom.ker (algebraMap A C) = Ideal.span {g} →
        range (baseMap K P Q (IsScalarTower.toAlgHom K A B)) =
          (range (baseMap K P R (IsScalarTower.toAlgHom K A C)))ᶜ)

end Langlands.Analytic.AffineAnalytification
