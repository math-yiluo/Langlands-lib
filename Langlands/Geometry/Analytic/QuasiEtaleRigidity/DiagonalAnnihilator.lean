import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.LinearAlgebra.Matrix.Charpoly.LinearMap
import Mathlib.RingTheory.Polynomial.Tower

/-! # An annihilator of the diagonal ideal attached to an annihilator of `Ω[S⁄R]` -/

noncomputable section

open TensorProduct Polynomial

namespace Langlands.Analytic.QuasiEtaleRigidity

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The generator `1 ⊗ s - s ⊗ 1` of the diagonal ideal of `S ⊗[R] S`. -/
abbrev diagonalGenerator (R : Type*) [CommRing R] [Algebra R S] (s : S) : S ⊗[R] S :=
  (1 : S) ⊗ₜ[R] s - s ⊗ₜ[R] (1 : S)

/-- If a finite set generates `S` as an `R`-algebra, the diagonal ideal is generated by the
elements `1 ⊗ g - g ⊗ 1` for `g` in that set. -/
theorem ideal_eq_span_of_adjoin_eq_top (G : Finset S)
    (hG : Algebra.adjoin R (G : Set S) = ⊤) :
    KaehlerDifferential.ideal R S =
      Ideal.span (Set.range fun g : G => diagonalGenerator R (g : S)) := by
  apply le_antisymm
  · rw [← KaehlerDifferential.span_range_eq_ideal, Ideal.span_le]
    rintro _ ⟨x, rfl⟩
    set I := Ideal.span (Set.range fun g : G => diagonalGenerator R (g : S))
    change _ - _ ∈ I
    have : (IsScalarTower.toAlgHom R (S ⊗[R] S) (S ⊗[R] S ⧸ I)).comp
          Algebra.TensorProduct.includeRight =
        (IsScalarTower.toAlgHom R (S ⊗[R] S) (S ⊗[R] S ⧸ I)).comp
          Algebra.TensorProduct.includeLeft := by
      apply AlgHom.ext_of_adjoin_eq_top hG
      intro a ha
      simp only [AlgHom.coe_comp, IsScalarTower.coe_toAlgHom', Ideal.Quotient.algebraMap_eq,
        Function.comp_apply, Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.includeRight_apply, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      exact Ideal.subset_span ⟨⟨a, ha⟩, rfl⟩
    simpa [Ideal.Quotient.mk_eq_mk_iff_sub_mem] using AlgHom.congr_fun this x
  · rw [Ideal.span_le]
    rintro _ ⟨g, rfl⟩
    exact KaehlerDifferential.one_smul_sub_smul_one_mem_ideal R (g : S)

/-- An element `e` killing `Ω[S⁄R]` multiplies the diagonal ideal `J` into `J²`, through
`e ⊗ 1`. -/
theorem mul_mem_sq_of_mem_annihilator {e : S} (he : e ∈ Module.annihilator S Ω[S⁄R])
    {x : S ⊗[R] S} (hx : x ∈ KaehlerDifferential.ideal R S) :
    (e ⊗ₜ[R] (1 : S)) * x ∈ KaehlerDifferential.ideal R S ^ 2 := by
  have h0 : e • KaehlerDifferential.fromIdeal R S ⟨x, hx⟩ = 0 :=
    Module.mem_annihilator.mp he _
  rw [← algebraMap_smul (S ⊗[R] S) e, ← map_smul] at h0
  have h1 := (Ideal.toCotangent_eq_zero _ _).mp h0
  simpa [Algebra.TensorProduct.algebraMap_apply] using h1

/-- The diagonal ideal is finitely generated when `S` is generated by a finite set. -/
theorem ideal_fg_of_adjoin_eq_top (G : Finset S) (hG : Algebra.adjoin R (G : Set S) = ⊤) :
    (KaehlerDifferential.ideal R S).FG := by
  rw [ideal_eq_span_of_adjoin_eq_top G hG]
  exact Submodule.fg_span (Set.finite_range _)

/-- **The diagonal trick.** Let `S` be generated over `R` by a finite set `G` and let `e` kill
`Ω[S⁄R]`. By Cayley–Hamilton applied to multiplication by `e ⊗ 1` on the diagonal ideal `J`,
there is an element `t = (e ⊗ 1)ⁿ + ∑_g c_g (1 ⊗ g - g ⊗ 1)` of `S ⊗[R] S` which kills `J`. -/
theorem exists_diagonal_annihilator (G : Finset S) (hG : Algebra.adjoin R (G : Set S) = ⊤)
    {e : S} (he : e ∈ Module.annihilator S Ω[S⁄R]) :
    ∃ (n : ℕ) (c : G → S ⊗[R] S), ∀ x ∈ KaehlerDifferential.ideal R S,
      ((e ⊗ₜ[R] (1 : S)) ^ n + ∑ g, c g * diagonalGenerator R (g : S)) * x = 0 := by
  classical
  set J := KaehlerDifferential.ideal R S with hJdef
  have hJ := ideal_eq_span_of_adjoin_eq_top G hG
  have : Module.Finite (S ⊗[R] S) J :=
    Module.Finite.iff_fg.mpr (ideal_fg_of_adjoin_eq_top G hG)
  let f : Module.End (S ⊗[R] S) J := algebraMap (S ⊗[R] S) _ (e ⊗ₜ[R] (1 : S))
  have hf : LinearMap.range f ≤ J • (⊤ : Submodule (S ⊗[R] S) J) := by
    rintro _ ⟨y, rfl⟩
    rw [Submodule.mem_smul_top_iff]
    have : ((f y : J) : S ⊗[R] S) = (e ⊗ₜ[R] (1 : S)) * (y : S ⊗[R] S) := by
      simp [f, Module.algebraMap_end_apply]
    rw [this, Ideal.smul_eq_mul, ← pow_two]
    exact mul_mem_sq_of_mem_annihilator he y.2
  obtain ⟨p, hp, -, hcoeff, hzero⟩ :=
    LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero
      (S ⊗[R] S) f J hf
  have hkill : ∀ x ∈ J, aeval (e ⊗ₜ[R] (1 : S)) p * x = 0 := by
    intro x hx
    have h := LinearMap.congr_fun hzero ⟨x, hx⟩
    rw [Polynomial.aeval_algebraMap_apply, Module.algebraMap_end_apply] at h
    simpa using congrArg Subtype.val h
  set n := p.natDegree
  let j₀ : S ⊗[R] S := ∑ i ∈ Finset.range n, p.coeff i * (e ⊗ₜ[R] (1 : S)) ^ i
  have hj₀ : j₀ ∈ J := by
    refine Ideal.sum_mem _ fun i hi => Ideal.mul_mem_right _ _ ?_
    have hi' : n - i ≠ 0 := by
      have := Finset.mem_range.mp hi
      omega
    exact Ideal.pow_le_self hi' (hcoeff i)
  rw [hJdef, hJ] at hj₀
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hj₀
  refine ⟨n, c, fun x hx => ?_⟩
  have hp' : aeval (e ⊗ₜ[R] (1 : S)) p = (e ⊗ₜ[R] (1 : S)) ^ n + j₀ := by
    conv_lhs => rw [hp.as_sum]
    simp only [map_add, map_pow, aeval_X, map_sum, map_mul, aeval_C, Algebra.algebraMap_self,
      RingHom.id_apply, j₀, n]
  rw [hc, ← hp']
  exact hkill x hx

/-- **Rigidity from the diagonal trick.** Let `φ₁ φ₂ : S → C` be ring maps agreeing on `R`,
represented on `S ⊗[R] S` by `Ψ` with `Ψ (a ⊗ b) = φ₁ a * φ₂ b`. If the image of the element
`t` of `exists_diagonal_annihilator` is a unit, then `φ₁ = φ₂`. -/
theorem eq_of_isUnit_image (G : Finset S) (hG : Algebra.adjoin R (G : Set S) = ⊤) {e : S}
    {n : ℕ} {c : G → S ⊗[R] S}
    (hc : ∀ x ∈ KaehlerDifferential.ideal R S,
      ((e ⊗ₜ[R] (1 : S)) ^ n + ∑ g, c g * diagonalGenerator R (g : S)) * x = 0)
    {C : Type*} [CommRing C] (φ₁ φ₂ : S →+* C) (hR : φ₁.comp (algebraMap R S) =
      φ₂.comp (algebraMap R S))
    (Ψ : S ⊗[R] S →+* C) (hΨ : ∀ a b, Ψ (a ⊗ₜ[R] b) = φ₁ a * φ₂ b)
    (hunit : IsUnit (φ₁ e ^ n + ∑ g, Ψ (c g) * (φ₂ (g : S) - φ₁ (g : S)))) :
    φ₁ = φ₂ := by
  have hd : ∀ s : S, Ψ (diagonalGenerator R s) = φ₂ s - φ₁ s := by
    intro s
    simp [diagonalGenerator, map_sub, hΨ]
  have ht : Ψ ((e ⊗ₜ[R] (1 : S)) ^ n + ∑ g, c g * diagonalGenerator R (g : S)) =
      φ₁ e ^ n + ∑ g, Ψ (c g) * (φ₂ (g : S) - φ₁ (g : S)) := by
    simp [map_add, map_pow, map_sum, map_mul, hΨ, hd]
  have hgen : ∀ s ∈ G, φ₁ s = φ₂ s := by
    intro s hs
    have h0 := congrArg Ψ (hc _ (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal R s))
    rw [map_mul, map_zero, ht] at h0
    have h1 : Ψ ((1 : S) ⊗ₜ[R] s - s ⊗ₜ[R] (1 : S)) = φ₂ s - φ₁ s := hd s
    rw [h1] at h0
    have := (hunit.mul_right_eq_zero).mp h0
    exact (sub_eq_zero.mp this).symm
  let : Algebra R C := (φ₁.comp (algebraMap R S)).toAlgebra
  let ψ₁ : S →ₐ[R] C := { φ₁ with commutes' := fun r => rfl }
  let ψ₂ : S →ₐ[R] C :=
    { φ₂ with commutes' := fun r => (RingHom.congr_fun hR r).symm }
  have h : ψ₁ = ψ₂ := AlgHom.ext_of_adjoin_eq_top hG fun x hx => hgen x hx
  ext s
  exact AlgHom.congr_fun h s

/-- Ring maps agreeing on `R` are represented on `S ⊗[R] S`. -/
theorem exists_tensorProduct_lift {C : Type*} [CommRing C] (φ₁ φ₂ : S →+* C)
    (hR : φ₁.comp (algebraMap R S) = φ₂.comp (algebraMap R S)) :
    ∃ Ψ : S ⊗[R] S →+* C, ∀ a b, Ψ (a ⊗ₜ[R] b) = φ₁ a * φ₂ b := by
  let : Algebra R C := (φ₁.comp (algebraMap R S)).toAlgebra
  let ψ₁ : S →ₐ[R] C := { φ₁ with commutes' := fun r => rfl }
  let ψ₂ : S →ₐ[R] C :=
    { φ₂ with commutes' := fun r => (RingHom.congr_fun hR r).symm }
  exact ⟨(Algebra.TensorProduct.productMap ψ₁ ψ₂).toRingHom, fun a b => rfl⟩

end Langlands.Analytic.QuasiEtaleRigidity
