import Langlands.Geometry.Analytic.AtlasTopology.CompactSubcover
import Langlands.Geometry.Analytic.CompactProbeQuasiEtaleHausdorffComparisonStatement
import Langlands.Geometry.Analytic.EquivariantQuasiEtaleSite
import Mathlib.CategoryTheory.Sites.InducedTopology

/-! # Equivariant quasi-étale coverings from the compact-probe topology -/

noncomputable section

universe u v z z'

namespace Langlands.Analytic.SaturatedAtlasPresentation

open _root_.CategoryTheory Filter Set Topology

variable {K : Type u} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {G : Type z} [Group G] [TopologicalSpace G]

/-- The chart-neighbourhood condition depends only on the generated sieve. -/
theorem hasQuasiEtaleChartNeighborhoods_generate_iff
    {X : LocalizedCategory.{u, v, v} (K := K)} {U : QuasiEtaleSite X} (R : Presieve U) :
    HasQuasiEtaleChartNeighborhoods (Sieve.generate R).arrows ↔
      HasQuasiEtaleChartNeighborhoods R := by
  classical
  constructor
  · intro h x
    obtain ⟨σ, hf, hn, hs⟩ := h x
    have hpiece (T : Set (localizedSpaceFunctor.obj U.left)) (hT : T ∈ σ) :
        ∃ δ : Set (Set (localizedSpaceFunctor.obj U.left)), δ.Finite ∧ T ⊆ ⋃₀ δ ∧
          ∀ W ∈ δ, ∃ (V : QuasiEtaleSite X) (f : V ⟶ U)
            (i : (presentationOf V.left).presentation.atlas.Index),
            R f ∧ W = localizedSpaceFunctor.map f.left '' ((presentationOf V.left).chartDomain i).carrier := by
      obtain ⟨A, q, i, hq, rfl⟩ := hs T hT
      obtain ⟨B, g, f, hfR, rfl⟩ := hq
      let C := localizedSpaceFunctor.map g.left '' ((presentationOf A.left).chartDomain i).carrier
      have hc : IsCompact C := ((presentationOf A.left).isCompactDomain_chartDomain i).1.image
        (localizedSpaceFunctor.map g.left).hom.continuous
      let a := (presentationOf B.left).presentation.atlas
      obtain ⟨ξ, hξ, hchart, hcover⟩ := a.isNet_chartFamily.1.exists_finite_cover_of_isCompact hc
      refine ⟨Set.image (localizedSpaceFunctor.map f.left) '' ξ, hξ.image _, ?_, ?_⟩
      · rintro _ ⟨y, hy, rfl⟩
        have hm : localizedSpaceFunctor.map g.left y ∈ C := ⟨y, hy, rfl⟩
        obtain ⟨W, hW, hyW⟩ := mem_sUnion.mp (hcover hm)
        refine ⟨_, ⟨W, hW, rfl⟩, localizedSpaceFunctor.map g.left y, hyW, ?_⟩
        rw [MorphismProperty.Comma.comp_left, Functor.map_comp, TopCat.comp_app]
      · rintro _ ⟨W, hW, rfl⟩
        obtain ⟨j, rfl⟩ := hchart hW
        exact ⟨B, f, j, hfR, rfl⟩
    choose! δ hδ hsub hR using hpiece
    refine ⟨⋃ T ∈ σ, δ T, hf.biUnion hδ, Filter.mem_of_superset hn ?_, ?_⟩
    · rintro y ⟨T, hT, hyT⟩
      obtain ⟨W, hW, hyW⟩ := mem_sUnion.mp (hsub T hT hyT)
      exact ⟨W, mem_iUnion₂.mpr ⟨T, hT, hW⟩, hyW⟩
    · intro W hW
      obtain ⟨T, hT, hWT⟩ := mem_iUnion₂.mp hW
      exact hR T hT W hWT
  · intro h x
    obtain ⟨σ, hf, hn, hs⟩ := h x
    refine ⟨σ, hf, hn, fun T hT => ?_⟩
    obtain ⟨V, f, i, hfR, hT⟩ := hs T hT
    exact ⟨V, f, i, Sieve.le_generate R _ _ hfR, hT⟩

variable (X : GSpace.{u, v, v} K G)

/-- A family of equivariant arrows covers when it generates a covering sieve
in the ordinary compact-probe topology after forgetting the action. -/
def equivariantCompactProbeQuasiEtalePrecoverage : Precoverage (EquivariantQuasiEtaleSite X) :=
  (compactProbeQuasiEtaleTopology (GSpace.forget.obj X)).toPrecoverage.comap
    (EquivariantQuasiEtaleSite.toQuasiEtaleSite X)

/-- The equivariant quasi-étale topology generated by the compact-probe coverings. -/
def equivariantCompactProbeQuasiEtaleTopology : GrothendieckTopology (EquivariantQuasiEtaleSite X) :=
  (equivariantCompactProbeQuasiEtalePrecoverage X).toGrothendieck

variable {X}

theorem mem_equivariantCompactProbeQuasiEtalePrecoverage_iff
    {U : EquivariantQuasiEtaleSite X} {R : Presieve U} :
    R ∈ equivariantCompactProbeQuasiEtalePrecoverage X U ↔
      Sieve.generate (R.map (EquivariantQuasiEtaleSite.toQuasiEtaleSite X)) ∈
        compactProbeQuasiEtaleTopology (GSpace.forget.obj X)
          ((EquivariantQuasiEtaleSite.toQuasiEtaleSite X).obj U) := Iff.rfl

/-- Restriction of the acting group preserves and reflects the compact-probe
covering families. -/
theorem map_res_mem_equivariantCompactProbeQuasiEtalePrecoverage_iff
    {H : Type z'} [Group H] [TopologicalSpace H] (f : H →ₜ* G)
    {U : EquivariantQuasiEtaleSite X} {R : Presieve U} :
    R.map (EquivariantQuasiEtaleSite.res f) ∈
        equivariantCompactProbeQuasiEtalePrecoverage ((GSpace.res f).obj X)
          ((EquivariantQuasiEtaleSite.res f).obj U) ↔
      R ∈ equivariantCompactProbeQuasiEtalePrecoverage X U := by
  have h : equivariantCompactProbeQuasiEtalePrecoverage X =
      (equivariantCompactProbeQuasiEtalePrecoverage ((GSpace.res f).obj X)).comap
        (EquivariantQuasiEtaleSite.res f) := by
    rw [equivariantCompactProbeQuasiEtalePrecoverage, equivariantCompactProbeQuasiEtalePrecoverage,
      ← Precoverage.comap_comp, EquivariantQuasiEtaleSite.res_comp_toQuasiEtaleSite]
    rfl
  rw [h, Precoverage.mem_comap_iff]

/-- The Hausdorff comparison identifies the two precoverages on equivariant
objects. Each underlying source of a `G`-space is Hausdorff. -/
theorem equivariantCompactProbeQuasiEtalePrecoverage_eq_of_comparison
    (h : CompactProbeQuasiEtaleHausdorffComparisonStatement.{u, v} K)
    (X : GSpace.{u, v, v} K G) :
    equivariantCompactProbeQuasiEtalePrecoverage X = equivariantQuasiEtalePrecoverage X := by
  ext U R
  rw [mem_equivariantCompactProbeQuasiEtalePrecoverage_iff,
    mem_equivariantQuasiEtalePrecoverage_iff, h _ _ _ U.left.2.1,
    hasQuasiEtaleChartNeighborhoods_generate_iff]
  rfl

/-- With the Hausdorff comparison, both equivariant generating families give
the same Grothendieck topology. -/
theorem equivariantCompactProbeQuasiEtaleTopology_eq_of_comparison
    (h : CompactProbeQuasiEtaleHausdorffComparisonStatement.{u, v} K)
    (X : GSpace.{u, v, v} K G) :
    equivariantCompactProbeQuasiEtaleTopology X = equivariantQuasiEtaleTopology X :=
  congrArg Precoverage.toGrothendieck (equivariantCompactProbeQuasiEtalePrecoverage_eq_of_comparison h X)

end Langlands.Analytic.SaturatedAtlasPresentation
