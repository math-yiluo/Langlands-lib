import Langlands.GroupScheme.Torus.CentralExtensionHopfSpec
import Langlands.Geometry.Analytic.SeparatedAnalytificationReverse
import Langlands.Geometry.Analytic.SchemeAnalytificationMorphismProof
import Langlands.Geometry.Analytic.SchemeAnalytificationGluingReduction
import Langlands.Geometry.Analytic.SchemeAnalytificationHausdorffReduction
import Mathlib.AlgebraicGeometry.Morphisms.Separated

/-! # Separatedness forces a Hausdorff analytification -/

noncomputable section

universe u

namespace Langlands.Analytic.SchemeAnalytification.SeparatedForward

open CategoryTheory CategoryTheory.Limits _root_.AlgebraicGeometry Topology Filter
open Langlands.Analytic.AffineSchemeAnalytification

variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of K)) [LocallyOfFiniteType f]

section Gluing

/-- Restriction along every inclusion of affine opens is an open map of analytifications. -/
theorem isOpenMap_localMap {U V : X.affineOpens} (hVU : (V : X.Opens) ≤ U) :
    IsOpenMap (localMap K f hVU) := by
  intro s hs
  have e : localMap K f hVU '' s = ⋃ (a : Γ(X, U.val))
      (ha : ((X.affineBasicOpen a : X.affineOpens) : X.Opens) ≤ V),
      localMap K f (X.affineBasicOpen_le a) '' (localMap K f ha ⁻¹' s) := by
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩
      have hyV : localCenter K f V y ∈ (V : X.Opens) := center_ι_mem K f V y
      obtain ⟨a, haV, hya⟩ := U.property.exists_basicOpen_le
        (V := (V : X.Opens)) ⟨localCenter K f V y, hyV⟩ (hVU hyV)
      have hD : ((X.affineBasicOpen a : X.affineOpens) : X.Opens) ≤ V := haV
      have hy' : y ∈ Set.range (localMap K f hD) := by
        rw [MorphismExistence.range_localMap]
        exact hya
      obtain ⟨d, rfl⟩ := hy'
      refine Set.mem_iUnion₂.mpr ⟨a, hD, d, hy, ?_⟩
      rw [MorphismExistence.localMap_localMap]
    · intro hz
      obtain ⟨a, ha, d, hd, rfl⟩ := Set.mem_iUnion₂.mp hz
      exact ⟨localMap K f ha d, hd, by rw [MorphismExistence.localMap_localMap]⟩
  rw [e]
  exact isOpen_iUnion fun a => isOpen_iUnion fun ha =>
    (MorphismExistence.isOpenEmbedding_localMap_basicOpen K f U a).isOpenMap _
      (hs.preimage (localMap K f ha).continuous)

/-- Restriction along every inclusion of affine opens is an open embedding of
analytifications. -/
theorem isOpenEmbedding_localMap {U V : X.affineOpens} (hVU : (V : X.Opens) ≤ U) :
    IsOpenEmbedding (localMap K f hVU) :=
  .of_continuous_injective_isOpenMap (localMap K f hVU).continuous
    (MorphismExistence.localMap_injective K f hVU) (isOpenMap_localMap K f hVU)

/-- The local inputs of the quotient gluing argument hold. -/
theorem restrictionGluingData : GluingReduction.RestrictionGluingData K f :=
  ⟨fun U x => MorphismExistence.localMap_self K f U x,
    fun hVU hWV x => MorphismExistence.localMap_localMap K f hVU hWV x,
    fun h => isOpenEmbedding_localMap K f h,
    fun h => MorphismExistence.range_localMap K f h⟩

end Gluing

section Algebra

variable {K} [IsSeparated f]

include f in
omit [IsUltrametricDist K] [CompleteSpace K] [LocallyOfFiniteType f] in
/-- Over a separated base morphism to an affine scheme, the intersection of two affine
opens is affine. -/
theorem isAffineOpen_inf (U V : X.affineOpens) : IsAffineOpen ((U : X.Opens) ⊓ V) :=
  (isAffineHom_diagonal_iff (f := f)).mp inferInstance ⊤ (isAffineOpen_top _)
    (U : X.Opens) (by simp) (V : X.Opens) (by simp) (show IsAffineOpen (U : X.Opens) from U.2)
    (show IsAffineOpen (V : X.Opens) from V.2)

include f in
omit [IsUltrametricDist K] [CompleteSpace K] [LocallyOfFiniteType f] in
/-- The intersection of two affine opens, as an affine open. -/
def inter (U V : X.affineOpens) : X.affineOpens :=
  ⟨(U : X.Opens) ⊓ V, isAffineOpen_inf f U V⟩

omit [IsUltrametricDist K] [CompleteSpace K] [LocallyOfFiniteType f] in
/-- The intersection is contained in the first affine open. -/
theorem inter_le_left (U V : X.affineOpens) : ((inter f U V : X.affineOpens) : X.Opens) ≤ U :=
  inf_le_left

omit [IsUltrametricDist K] [CompleteSpace K] [LocallyOfFiniteType f] in
/-- The intersection is contained in the second affine open. -/
theorem inter_le_right (U V : X.affineOpens) : ((inter f U V : X.affineOpens) : X.Opens) ≤ V :=
  inf_le_right

/-- Surjectivity of a ring map whose spectrum map is a closed immersion. -/
theorem surjective_of_isClosedImmersion {R S : CommRingCat.{u}} (φ : R ⟶ S)
    [IsClosedImmersion (Spec.map φ)] : Function.Surjective φ :=
  Langlands.GroupScheme.CentralExtensionHopfSpec.surjective_of_isClosedImmersion φ

omit [IsUltrametricDist K] [CompleteSpace K] [LocallyOfFiniteType f] in
/-- **Separatedness, algebraically.** The coordinate ring of the intersection of two affine
opens is generated by the restrictions of sections from the two opens. -/
theorem sup_range_restriction_eq_top (U V : X.affineOpens) :
    (restriction f (inter_le_left f U V)).range ⊔
      (restriction f (inter_le_right f U V)).range = ⊤ := by
  set W := inter f U V
  set T := (restriction f (inter_le_left f U V)).range ⊔
    (restriction f (inter_le_right f U V)).range with hT
  let rU : Γ((U : X.Opens), ⊤) ⟶ CommRingCat.of T := CommRingCat.ofHom
    ((restriction f (inter_le_left f U V)).codRestrict T (fun a =>
      (le_sup_left : (restriction f (inter_le_left f U V)).range ≤ T)
        (AlgHom.mem_range_self _ a))).toRingHom
  let rV : Γ((V : X.Opens), ⊤) ⟶ CommRingCat.of T := CommRingCat.ofHom
    ((restriction f (inter_le_right f U V)).codRestrict T (fun a =>
      (le_sup_right : (restriction f (inter_le_right f U V)).range ≤ T)
        (AlgHom.mem_range_self _ a))).toRingHom
  let iT : CommRingCat.of T ⟶ Γ((W : X.Opens), ⊤) := CommRingCat.ofHom T.val.toRingHom
  have hU : rU ≫ iT = (X.homOfLE (inter_le_left f U V)).appTop := by
    ext; rfl
  have hV : rV ≫ iT = (X.homOfLE (inter_le_right f U V)).appTop := by
    ext; rfl
  have hK : ∀ (Y : X.affineOpens) (r : Γ((Y : X.Opens), ⊤) ⟶ CommRingCat.of T),
      (∀ c : K,
        r.hom (algebraMap K (CoordinateRing (structureMap f Y)) c) = algebraMap K T c) →
      (Spec.map r ≫ (Y : X.Opens).toScheme.isoSpec.inv) ≫ (Y : X.Opens).ι ≫ f =
        Spec.algebraMap K T := by
    intro Y r hr
    rw [Category.assoc, ← Category.assoc (Y : X.Opens).toScheme.isoSpec.inv,
      ← affineOpenMap, SeparatedReverse.affineOpenMap_comp, Spec.algebraMap, Spec.algebraMap]
    refine (Spec.map_comp
      (CommRingCat.ofHom (algebraMap K (CoordinateRing (structureMap f Y)))) r).symm.trans ?_
    congr 1
    ext c
    exact congrArg Subtype.val (hr c)
  have hcond : (Spec.map rU ≫ (U : X.Opens).toScheme.isoSpec.inv) ≫ (U : X.Opens).ι ≫ f =
      (Spec.map rV ≫ (V : X.Opens).toScheme.isoSpec.inv) ≫ (V : X.Opens).ι ≫ f := by
    rw [hK U rU (fun c => Subtype.ext ((restriction f (inter_le_left f U V)).commutes c)),
      hK V rV (fun c => Subtype.ext ((restriction f (inter_le_right f U V)).commutes c))]
  let g : Spec (CommRingCat.of T) ⟶ pullback ((U : X.Opens).ι ≫ f) ((V : X.Opens).ι ≫ f) :=
    pullback.lift _ _ hcond
  have hpb := IsOpenImmersion.isPullback (X.homOfLE (inter_le_left f U V))
    (X.homOfLE (inter_le_right f U V)) (U : X.Opens).ι (V : X.Opens).ι (by simp)
    (by ext x; simp; exact ⟨fun h => ⟨h, x.2⟩, fun h => h.1⟩)
  let δ := hpb.isoPullback.hom ≫ pullback.mapDesc (U : X.Opens).ι (V : X.Opens).ι f
  have hδ : (W : X.Opens).toScheme.isoSpec.inv ≫ δ = Spec.map iT ≫ g := by
    apply pullback.hom_ext
    · simp only [δ, g, Category.assoc, pullback.lift_fst, pullback.mapDesc,
        Category.comp_id, IsPullback.isoPullback_hom_fst]
      rw [← Spec.map_comp_assoc, hU, Scheme.isoSpec_inv_naturality]
    · simp only [δ, g, Category.assoc, pullback.lift_snd, pullback.mapDesc,
        Category.comp_id, IsPullback.isoPullback_hom_snd]
      rw [← Spec.map_comp_assoc, hV, Scheme.isoSpec_inv_naturality]
  have : IsClosedImmersion (Spec.map iT ≫ g) := by
    rw [← hδ]
    infer_instance
  have : IsClosedImmersion (Spec.map iT) := IsClosedImmersion.of_comp _ g
  have hiT := surjective_of_isClosedImmersion iT
  rw [eq_top_iff]
  intro c _
  obtain ⟨t, rfl⟩ := hiT c
  exact t.2

end Algebra

section Closed

/-- The seminorm of a restricted point is the seminorm of the point composed with
restriction of sections. -/
theorem pointSeminorm_localMap {U V : X.affineOpens} (h : (V : X.Opens) ≤ U)
    (y : LocalSpace K f V) (a : CoordinateRing (structureMap f U)) :
    AffineAnalytification.pointSeminorm K (chartPresentation K f U) (localMap K f h y) a =
      AffineAnalytification.pointSeminorm K (chartPresentation K f V) y (restriction f h a) :=
  AffineAnalytification.pointSeminorm_baseMap K _ _ (restriction f h) y a

variable [IsSeparated f]

/-- The pair of restrictions of a point of the analytification of `U ∩ V` to the
analytifications of `U` and of `V`. -/
def restrictionPair (U V : X.affineOpens) (w : LocalSpace K f (inter f U V)) :
    LocalSpace K f U × LocalSpace K f V :=
  (localMap K f (inter_le_left f U V) w, localMap K f (inter_le_right f U V) w)

/-- The pairs of chart points identified in the glued space are exactly the pairs of
restrictions of one point of the analytification of the intersection. -/
theorem chartRelation_eq_range (U V : X.affineOpens) :
    {p : LocalSpace K f U × LocalSpace K f V | ι K f U p.1 = ι K f V p.2} =
      Set.range (restrictionPair K f U V) := by
  ext ⟨x, y⟩
  constructor
  · intro h
    obtain ⟨W', hW'U, hW'V, z, hzU, hzV⟩ :=
      (GluingReduction.ι_eq_iff_common_refinement (restrictionGluingData K f) x y).mp h
    dsimp only at hW'U hW'V hzU hzV
    have hW' : ((W' : X.affineOpens) : X.Opens) ≤ inter f U V := le_inf hW'U hW'V
    refine ⟨localMap K f hW' z, ?_⟩
    simp only [restrictionPair, MorphismExistence.localMap_localMap]
    exact Prod.ext hzU hzV
  · rintro ⟨w, hw⟩
    simp only [restrictionPair, Prod.mk.injEq] at hw
    obtain ⟨rfl, rfl⟩ := hw
    change ι K f U (localMap K f (inter_le_left f U V) w) =
      ι K f V (localMap K f (inter_le_right f U V) w)
    rw [ι_localMap, ι_localMap]

/-- **Closedness of the chart relation.** For a separated morphism, the set of pairs of
points of the analytifications of two affine opens with equal images in the glued space
is closed. -/
theorem isClosed_chartRelation (U V : X.affineOpens) :
    IsClosed {p : LocalSpace K f U × LocalSpace K f V | ι K f U p.1 = ι K f V p.2} := by
  rw [chartRelation_eq_range]
  have hQc : Continuous (restrictionPair K f U V) :=
    (localMap K f (inter_le_left f U V)).continuous.prodMk
      (localMap K f (inter_le_right f U V)).continuous
  have hQi : Function.Injective (restrictionPair K f U V) := fun w w' h =>
    MorphismExistence.localMap_injective K f (inter_le_left f U V) (congrArg Prod.fst h)
  refine closure_subset_iff_isClosed.mp ?_
  intro p hp
  obtain ⟨𝒰, h𝒰Q, h𝒰p⟩ := mem_closure_iff_ultrafilter.mp hp
  let 𝒱 : Ultrafilter (LocalSpace K f (inter f U V)) := 𝒰.comap hQi h𝒰Q
  have hQ𝒱 : Tendsto (restrictionPair K f U V) 𝒱 (𝓝 p) :=
    Filter.map_comap_le.trans h𝒰p
  have hU : Tendsto (fun w => localMap K f (inter_le_left f U V) w) 𝒱 (𝓝 p.1) :=
    (continuous_fst.tendsto p).comp hQ𝒱
  have hV : Tendsto (fun w => localMap K f (inter_le_right f U V) w) 𝒱 (𝓝 p.2) :=
    (continuous_snd.tendsto p).comp hQ𝒱
  let ν : LocalSpace K f (inter f U V) →
      MulRingSeminorm (CoordinateRing (structureMap f (inter f U V))) :=
    AffineAnalytification.pointSeminorm K (chartPresentation K f (inter f U V))
  -- Restrictions of sections from `U` or from `V` have eventually bounded seminorms.
  have hbU : ∀ a, ∃ B, ∀ᶠ w in (𝒱 : Filter _),
      ν w (restriction f (inter_le_left f U V) a) ≤ B := by
    intro a
    have ht : Tendsto (fun w => ν w (restriction f (inter_le_left f U V) a)) 𝒱
        (𝓝 (AffineAnalytification.pointSeminorm K (chartPresentation K f U) p.1 a)) :=
      (((AffineAnalytification.continuous_pointSeminorm_apply K
        (chartPresentation K f U) a).tendsto p.1).comp hU).congr
        (fun w => pointSeminorm_localMap K f (inter_le_left f U V) w a)
    exact ⟨_, ht.eventually (eventually_le_nhds (lt_add_one _))⟩
  have hbV : ∀ a, ∃ B, ∀ᶠ w in (𝒱 : Filter _),
      ν w (restriction f (inter_le_right f U V) a) ≤ B := by
    intro a
    have ht : Tendsto (fun w => ν w (restriction f (inter_le_right f U V) a)) 𝒱
        (𝓝 (AffineAnalytification.pointSeminorm K (chartPresentation K f V) p.2 a)) :=
      (((AffineAnalytification.continuous_pointSeminorm_apply K
        (chartPresentation K f V) a).tendsto p.2).comp hV).congr
        (fun w => pointSeminorm_localMap K f (inter_le_right f U V) w a)
    exact ⟨_, ht.eventually (eventually_le_nhds (lt_add_one _))⟩
  -- The eventually bounded sections form a subalgebra, which is everything.
  let S : Subalgebra K (CoordinateRing (structureMap f (inter f U V))) :=
    { carrier := {c | ∃ B, ∀ᶠ w in (𝒱 : Filter _), ν w c ≤ B}
      mul_mem' := by
        rintro a b ⟨A, hA⟩ ⟨B, hB⟩
        exact ⟨A * B, (hA.and hB).mono fun w hw => (map_mul (ν w) a b).le.trans
          (mul_le_mul hw.1 hw.2 (apply_nonneg _ _) ((apply_nonneg _ _).trans hw.1))⟩
      add_mem' := by
        rintro a b ⟨A, hA⟩ ⟨B, hB⟩
        exact ⟨A + B, (hA.and hB).mono fun w hw =>
          (map_add_le_add (ν w) a b).trans (add_le_add hw.1 hw.2)⟩
      algebraMap_mem' := by
        intro c
        obtain ⟨B, hB⟩ := hbU (algebraMap K _ c)
        refine ⟨B, hB.mono fun w hw => ?_⟩
        rwa [AlgHom.commutes] at hw }
  have htop : S = ⊤ := by
    rw [eq_top_iff, ← sup_range_restriction_eq_top f U V]
    refine sup_le ?_ ?_
    · rintro _ ⟨a, rfl⟩
      exact hbU a
    · rintro _ ⟨a, rfl⟩
      exact hbV a
  have hb : ∀ c, ∃ B, ∀ᶠ w in (𝒱 : Filter _), ν w c ∈ Set.Icc 0 B := by
    intro c
    have hc : c ∈ S := by
      rw [htop]
      exact Algebra.mem_top
    obtain ⟨B, hB⟩ := hc
    exact ⟨B, hB.mono fun w hw => ⟨apply_nonneg _ _, hw⟩⟩
  -- A limit seminorm exists, extends the norm of `K`, and is the seminorm of a point.
  obtain ⟨η, hη⟩ := SeparatedAnalytificationDensity.exists_tendsto_of_bounded 𝒱
    (fun w c => ν w c) hb
  have hηmem : η ∈ SeparatedAnalytificationDensity.seminormFunctions _ :=
    (SeparatedAnalytificationDensity.isClosed_seminormFunctions _).mem_of_tendsto hη
      (Eventually.of_forall fun w => SeparatedAnalytificationDensity.mem_seminormFunctions (ν w))
  have hext : AffineAnalytification.ExtendsNorm K
      (SeparatedAnalytificationDensity.ofSeminormFunctions hηmem) := by
    intro c
    have h1 : Tendsto (fun w => ν w (algebraMap K _ c)) 𝒱 (𝓝 (η (algebraMap K _ c))) :=
      tendsto_pi_nhds.mp hη _
    have h2 : Tendsto (fun w => ν w (algebraMap K _ c)) 𝒱 (𝓝 ‖c‖) :=
      tendsto_const_nhds.congr fun w =>
        (AffineAnalytification.pointSeminorm_extendsNorm K _ w c).symm
    exact tendsto_nhds_unique h1 h2
  obtain ⟨w₀, hw₀⟩ : SeparatedAnalytificationDensity.ofSeminormFunctions hηmem ∈
      Set.range (AffineAnalytification.pointSeminorm K
        (chartPresentation K f (inter f U V))) := by
    rw [AffineAnalytification.SeminormComparison.range_pointSeminorm]
    exact hext
  have heq : (fun c => ν w₀ c) = η := by
    funext c
    change AffineAnalytification.pointSeminorm K _ w₀ c = _
    rw [hw₀]
    rfl
  -- The ultrafilter converges to `w₀`, so its image converges to the image of `w₀`.
  have hconv : Tendsto (fun w => w) 𝒱 (𝓝 w₀) := by
    refine ((AffineAnalytification.SeminormComparison.isEmbedding_pointSeminorm K
      (chartPresentation K f (inter f U V))).tendsto_nhds_iff).mpr ?_
    change Tendsto (fun w c => ν w c) 𝒱 (𝓝 (fun c => ν w₀ c))
    rw [heq]
    exact hη
  exact ⟨w₀, tendsto_nhds_unique ((hQc.tendsto w₀).comp hconv) hQ𝒱⟩

/-- **Separated implies Hausdorff.** The analytification of a separated scheme locally
of finite type over `K` is Hausdorff. -/
theorem t2Space_of_isSeparated : T2Space (Space K f) :=
  (t2Space_iff_chartRelationClosed K f
    (GluingReduction.isOpenMap_ι (restrictionGluingData K f))).mpr
    (isClosed_chartRelation K f)

end Closed

end Langlands.Analytic.SchemeAnalytification.SeparatedForward
