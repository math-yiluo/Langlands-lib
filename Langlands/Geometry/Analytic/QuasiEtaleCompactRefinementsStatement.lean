import Langlands.Sheaf.Equivariant.AnalyticQuasiEtaleRefinements

/-! # Statement: covering sieves of compact quasi-étale objects have finite compact refinements -/

universe u v

namespace Langlands.Analytic.SaturatedAtlasPresentation

open Langlands.Sheaf.Equivariant.Analytic

/-- Consequence of Berkovich's description of the quasi-étale topology (1994, §3: the topology
generated by a pretopology of families whose images of finitely many affinoid domains cover a
neighbourhood of each point): for a Hausdorff analytic space `X`, every covering sieve of a
compact object of `Qét(X)` contains a finite family of arrows from compact objects of `Qét(X)`
that generates a covering sieve. This is condition (A) `HasFiniteCompactQuasiEtaleRefinements`
of the equivariant sheaf branch. -/
def QuasiEtaleCompactRefinementsStatement (K : Type u) [NormedField K] [IsUltrametricDist K]
    [CompleteSpace K] : Prop :=
  ∀ X : LocalizedCategory.{u, v, v} (K := K),
    T2Space (localizedSpaceFunctor.obj X) → HasFiniteCompactQuasiEtaleRefinements X

end Langlands.Analytic.SaturatedAtlasPresentation
