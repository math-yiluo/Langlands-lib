import Mathlib.Algebra.Category.ModuleCat.FilteredColimits
import Mathlib.Algebra.Category.ModuleCat.Limits
import Mathlib.Algebra.Category.ModuleCat.EpiMono
import Mathlib.CategoryTheory.Limits.Constructions.EpiMono
import Mathlib.CategoryTheory.Sites.ConcreteSheafification
import Mathlib.CategoryTheory.Sites.LeftExact
import Mathlib.Topology.Sheaves.Sheafify

/-! # Subsheaves generated by section submodules -/

noncomputable section

universe u

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

namespace Langlands.ModuleSheaf

open CategoryTheory TopologicalSpace

variable {R : Type u} [CommRing R] {X : TopCat.{u}}

/-- A family of section submodules stable under restriction, for a fixed coefficient ring. -/
structure SectionSubmodule (M : X.Presheaf (ModuleCat.{u} R)) where
  obj (U : (Opens X)ᵒᵖ) : Submodule R (M.obj U)
  map_mem {U V : (Opens X)ᵒᵖ} (f : U ⟶ V) {s : M.obj U} :
    s ∈ obj U → M.map f s ∈ obj V

namespace SectionSubmodule

variable {M : X.Presheaf (ModuleCat.{u} R)} (P : SectionSubmodule M)

/-- The actual module presheaf of sections in the prescribed submodules. -/
def presheaf : X.Presheaf (ModuleCat.{u} R) where
  obj U := ModuleCat.of R (P.obj U)
  map f := ModuleCat.ofHom (((M.map f).hom.comp (P.obj _).subtype).codRestrict
    (P.obj _) (fun s => P.map_mem f s.property))
  map_id U := by
    ext s
    change M.map (𝟙 U) s.val = s.val
    simp
  map_comp f g := by
    ext s
    change M.map (f ≫ g) s.val = M.map g (M.map f s.val)
    exact congrArg (fun k => k s.val) (M.map_comp f g)

/-- The inclusion into the ambient module presheaf. -/
def inclusion : P.presheaf ⟶ M where
  app U := ModuleCat.ofHom (P.obj U).subtype
  naturality {U V} f := by ext s; rfl

instance : Mono P.inclusion := by
  have (U : (Opens X)ᵒᵖ) : Mono (P.inclusion.app U) :=
    (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
  exact NatTrans.mono_of_mono_app _

/-- The image on an actual stalk, before sheafification. -/
def stalkRange (x : X) : Submodule R (TopCat.Presheaf.stalk (C := ModuleCat.{u} R) M x) :=
  LinearMap.range ((TopCat.Presheaf.stalkFunctor (ModuleCat.{u} R) x).map P.inclusion).hom

/-- A stalk-range element is the germ of a section in one of the original submodules. -/
theorem mem_stalkRange_iff (x : X)
    (v : TopCat.Presheaf.stalk (C := ModuleCat.{u} R) M x) :
    v ∈ P.stalkRange x ↔ ∃ (U : Opens X) (hx : x ∈ U) (s : M.obj (.op U)),
      s ∈ P.obj (.op U) ∧ TopCat.Presheaf.germ M U x hx s = v := by
  constructor
  · rintro ⟨t, rfl⟩
    obtain ⟨U, hx, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq P.presheaf t
    exact ⟨U, hx, s.val, s.property,
      (TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx P.inclusion s).symm⟩
  · rintro ⟨U, hx, s, hs, rfl⟩
    exact ⟨TopCat.Presheaf.germ P.presheaf U x hx ⟨s, hs⟩,
      TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx P.inclusion ⟨s, hs⟩⟩

end SectionSubmodule

namespace SectionSubmodule

variable {M : X.Sheaf (ModuleCat.{u} R)} (P : SectionSubmodule M.obj)

/-- The subsheaf generated by the given section submodules. -/
def sheaf : X.Sheaf (ModuleCat.{u} R) :=
  (presheafToSheaf (Opens.grothendieckTopology X) (ModuleCat.{u} R)).obj P.presheaf

/-- Its actual inclusion is the sheafification of the presheaf inclusion. -/
def sheafInclusion : P.sheaf ⟶ M :=
  (presheafToSheaf (Opens.grothendieckTopology X) (ModuleCat.{u} R)).map P.inclusion ≫
    (sheafificationIso M).inv

instance : Mono P.sheafInclusion := by
  let F := presheafToSheaf (Opens.grothendieckTopology X) (ModuleCat.{u} R)
  have : Mono P.inclusion := inferInstance
  have : HasSheafify (Opens.grothendieckTopology X) (ModuleCat.{u} R) := inferInstance
  have : F.PreservesMonomorphisms := inferInstance
  have : Mono (F.map P.inclusion) := inferInstance
  have : Mono (sheafificationIso M).inv := inferInstance
  exact mono_comp (F.map P.inclusion) (sheafificationIso M).inv

/-- The generated inclusion extends the original sectionwise inclusion. -/
@[reassoc (attr := simp)]
theorem unit_sheafInclusion :
    toSheafify (Opens.grothendieckTopology X) P.presheaf ≫ P.sheafInclusion.hom =
      P.inclusion := by
  change toSheafify _ _ ≫ sheafifyMap _ P.inclusion ≫ (isoSheafify _ M.property).inv = _
  rw [← toSheafify_naturality_assoc]
  simp

/-- The image on stalks of the actual generated subsheaf equals the original stalk image. -/
theorem sheafInclusion_stalk_range (x : X) :
    LinearMap.range ((TopCat.Presheaf.stalkFunctor (ModuleCat.{u} R) x).map
      P.sheafInclusion.hom).hom = P.stalkRange x := by
  let T := TopCat.Presheaf.stalkFunctor (ModuleCat.{u} R) x
  let j := toSheafify (Opens.grothendieckTopology X) P.presheaf
  let := TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x
    (ModuleCat.{u} R) P.presheaf
  have hj : Function.Surjective (T.map j) :=
    (ConcreteCategory.bijective_of_isIso (T.map j)).surjective
  have hcomp : T.map j ≫ T.map P.sheafInclusion.hom = T.map P.inclusion := by
    rw [← T.map_comp, unit_sheafInclusion]
  ext v
  constructor
  · rintro ⟨s, rfl⟩
    obtain ⟨t, rfl⟩ := hj s
    refine ⟨t, ?_⟩
    exact (congrArg (fun f => f t) hcomp).symm
  · rintro ⟨s, rfl⟩
    exact ⟨T.map j s, congrArg (fun f => f s) hcomp⟩

/-- Membership in the generated subsheaf's stalk image has a single-neighborhood witness. -/
theorem mem_sheafInclusion_stalk_range_iff (x : X)
    (v : TopCat.Presheaf.stalk (C := ModuleCat.{u} R) M.obj x) :
    v ∈ LinearMap.range ((TopCat.Presheaf.stalkFunctor (ModuleCat.{u} R) x).map
      P.sheafInclusion.hom).hom ↔
      ∃ (U : Opens X) (hx : x ∈ U) (s : M.obj.obj (.op U)),
        s ∈ P.obj (.op U) ∧ TopCat.Presheaf.germ M.obj U x hx s = v := by
  rw [P.sheafInclusion_stalk_range]
  exact P.mem_stalkRange_iff x v

end SectionSubmodule

end Langlands.ModuleSheaf
