import Langlands.Geometry.Building.AffineRootSystem
import Mathlib.LinearAlgebra.Dual.Lemmas

/-!
# Uniqueness of coroots, the derivative Weyl group and the extended affine Weyl group

Complements to `Langlands.Geometry.Building.AffineRootSystem`: for an affine root system the
coroot vector of AR 2 is unique (KP Remark 1.3.2(2)); the Weyl group `W(Φ)` of the derivative
root system, acting on `V`; and the extended affine Weyl group `W(Ψ)^ext` of KP Definition
1.3.71, the affine automorphisms preserving `Ψ` whose derivative lies in `W(Φ)`.
-/

noncomputable section

namespace Langlands.Geometry.Building.AffineRootSystem

universe uV uA

variable {V : Type uV} {A : Type uA} [AddCommGroup V] [Module ℝ V] [AddTorsor V A]

/-- Every linear functional on `V` is the derivative of an affine functional on `A`. -/
theorem exists_linear_eq (χ : Module.Dual ℝ V) : ∃ ψ : A →ᵃ[ℝ] ℝ, ψ.linear = χ := by
  obtain ⟨p⟩ : Nonempty A := inferInstance
  exact ⟨AffineMap.mk' (fun x => χ (x -ᵥ p)) χ p fun x => by simp, AffineMap.mk'_linear _ _ _ _⟩

/-- The derivative `ψ ↦ ψ̇` as a linear map `A* → V*`. -/
def derivativeMap : (A →ᵃ[ℝ] ℝ) →ₗ[ℝ] Module.Dual ℝ V where
  toFun ψ := ψ.linear
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem derivativeRoots_eq_image (Ψ : Set (A →ᵃ[ℝ] ℝ)) :
    derivativeRoots Ψ = (derivativeMap : (A →ᵃ[ℝ] ℝ) →ₗ[ℝ] Module.Dual ℝ V) '' Ψ :=
  rfl

/-- If `Ψ` spans `A*`, then `∇Ψ` spans `V*`. -/
theorem span_derivativeRoots_eq_top {Ψ : Set (A →ᵃ[ℝ] ℝ)} (h : Submodule.span ℝ Ψ = ⊤) :
    Submodule.span ℝ (derivativeRoots Ψ) = ⊤ := by
  rw [derivativeRoots_eq_image, ← Submodule.map_span, h, Submodule.map_top,
    LinearMap.range_eq_top]
  intro χ
  obtain ⟨ψ, hψ⟩ := exists_linear_eq (A := A) χ
  exact ⟨ψ, hψ⟩

/-- For an affine root system the coroot vector `ψ̇∨` of AR 2 is unique (KP Remark 1.3.2(2),
via Bourbaki's uniqueness lemma, Mathlib's `Module.Dual.eq_of_preReflection_mapsTo`). -/
theorem IsAffineRootSystem.isCoroot_unique {Ψ : Set (A →ᵃ[ℝ] ℝ)} (hΨ : IsAffineRootSystem Ψ)
    {ψ : A →ᵃ[ℝ] ℝ} {v w : V} (hv : IsCoroot Ψ ψ v) (hw : IsCoroot Ψ ψ w) : v = w := by
  have hmaps : ∀ u : V, IsCoroot Ψ ψ u →
      Set.MapsTo (Module.preReflection ψ.linear (Module.Dual.eval ℝ V u))
        (derivativeRoots Ψ) (derivativeRoots Ψ) := by
    rintro u hu _ ⟨η, hη, rfl⟩
    refine ⟨η - η.linear u • ψ, hu.2 η hη, ?_⟩
    simp [Module.preReflection_apply]
  have h := Module.Dual.eq_of_preReflection_mapsTo hΨ.finite_derivativeRoots
    (span_derivativeRoots_eq_top hΨ.span_eq_top) (by simpa using hv.1) (hmaps v hv)
    (by simpa using hw.1) (hmaps w hw)
  exact Module.eval_apply_injective ℝ h

/-- The Weyl group `W(Φ)` of the derivative root system, acting on `V`: the subgroup of
`V ≃ₗ[ℝ] V` generated by the reflections `w ↦ w - ψ̇(w) ψ̇∨` (the derivatives of the affine
reflections, KP Remark 1.3.2(2) and Proposition 1.3.3). -/
def derivativeWeylGroup (Ψ : Set (A →ᵃ[ℝ] ℝ)) : Subgroup (V ≃ₗ[ℝ] V) :=
  Subgroup.closure
    {s | ∃ ψ ∈ Ψ, ∃ (v : V) (hv : IsCoroot Ψ ψ v), s = Module.reflection hv.1}

theorem reflection_mem_derivativeWeylGroup {Ψ : Set (A →ᵃ[ℝ] ℝ)} {ψ : A →ᵃ[ℝ] ℝ} (hψ : ψ ∈ Ψ)
    {v : V} (hv : IsCoroot Ψ ψ v) : Module.reflection hv.1 ∈ derivativeWeylGroup Ψ :=
  Subgroup.subset_closure ⟨ψ, hψ, v, hv, rfl⟩

/-- The extended affine Weyl group `W(Ψ)^ext` (KP Definition 1.3.71): the affine automorphisms
of `A` that preserve `Ψ` and whose derivative lies in `W(Φ)`. -/
def extendedAffineWeylGroup (Ψ : Set (A →ᵃ[ℝ] ℝ)) : Subgroup (A ≃ᵃ[ℝ] A) :=
  rootStabilizer Ψ ⊓ (derivativeWeylGroup Ψ).comap AffineEquiv.linearHom

theorem mem_extendedAffineWeylGroup {Ψ : Set (A →ᵃ[ℝ] ℝ)} {e : A ≃ᵃ[ℝ] A} :
    e ∈ extendedAffineWeylGroup Ψ ↔ e ∈ rootStabilizer Ψ ∧ e.linear ∈ derivativeWeylGroup Ψ :=
  Iff.rfl

theorem extendedAffineWeylGroup_le_rootStabilizer (Ψ : Set (A →ᵃ[ℝ] ℝ)) :
    extendedAffineWeylGroup Ψ ≤ rootStabilizer Ψ :=
  inf_le_left

/-- `W(Ψ) ≤ W(Ψ)^ext`. -/
theorem affineWeylGroup_le_extendedAffineWeylGroup (Ψ : Set (A →ᵃ[ℝ] ℝ)) :
    affineWeylGroup Ψ ≤ extendedAffineWeylGroup Ψ :=
  (Subgroup.closure_le _).2 fun _ ⟨_, hψ, _, hv, he⟩ =>
    he ▸ ⟨affineReflection_mem_rootStabilizer hv, reflection_mem_derivativeWeylGroup hψ hv⟩

/-- The derivative of an element of `W(Ψ)` lies in `W(Φ)`. -/
theorem linear_mem_derivativeWeylGroup {Ψ : Set (A →ᵃ[ℝ] ℝ)} {e : A ≃ᵃ[ℝ] A}
    (he : e ∈ affineWeylGroup Ψ) : e.linear ∈ derivativeWeylGroup Ψ :=
  (affineWeylGroup_le_extendedAffineWeylGroup Ψ he).2

end Langlands.Geometry.Building.AffineRootSystem
