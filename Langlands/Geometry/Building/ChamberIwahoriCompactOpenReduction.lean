import Langlands.Geometry.Building.ChamberIwahoriCompactOpenStatement
import Langlands.Geometry.Building.ChamberIwahoriStatement
import Langlands.Geometry.Building.ChamberParahoricConstancy
import Langlands.Geometry.Building.KPParahoricProductTopology
import Langlands.GroupScheme.Rational.OpenRootGenerationStatement
import Langlands.GroupScheme.Rational.GenericCocharacter

/-!
# Reduction of chamber Iwahori compact openness

Openness of the actual chamber Iwahori follows from KP Corollary 8.2.6,
V 7 and openness of `Z(F)^0`; compactness follows from the ordered product
range of KP 7.4.9, V 7 and compactness of `Z(F)^0`. All three prerequisites
remain explicit premises here.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Geometry.Building.ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]

local instance chamberIwahoriReductionAffine : IsAffine G.X.left :=
  isAffine_of_isAffineHom G.X.hom
local instance chamberIwahoriReductionAmbient : TopologicalSpace (rationalPoints G) :=
  rationalPointTopology F G.X

variable (P : ParahoricBuildingData G)

local instance chamberIwahoriReductionCentralizerAffine :
    IsAffine P.centralizer.Z.X.left := by
  have : IsClosedImmersion P.centralizer.j.hom.hom.left :=
    P.centralizer.isClosedSubgroup
  exact isAffine_of_isAffineHom P.centralizer.j.hom.hom.left

local instance chamberIwahoriReductionCentralizer :
    TopologicalSpace (rationalPoints P.centralizer.Z) :=
  rationalPointTopology F P.centralizer.Z.X

/-! ### Openness -/

/-- KP Corollary 8.2.6, V 7 and openness of `Z(F)^0` make the full point
parahoric `P_x` open: it is generated by `j(Z(F)^0)` and the V 7-open
filtration subgroups `U_{a,x,0}`. -/
theorem isOpen_parahoricAt_of_openRootGeneration
    (hB : P.apartment.IsTopologyCompatible)
    (hgen : RelativeRoot.OpenRootCentralizerGenerationStatement.{u})
    (hZ : IsOpen (P.centralizerZero : Set (rationalPoints P.centralizer.Z)))
    (x : P.Apartment) :
    IsOpen (P.parahoricAt x : Set (rationalPoints G)) := by
  refine hgen F G P.isConnectedReductive P.S P.i P.isMaximalSplitTorus
    P.centralizer.Z P.centralizer.j P.centralizer.isRepresentedBy
    P.centralizer.isClosedSubgroup
    (fun a => P.apartment.rootFixer a {x}) P.centralizerZero
    (fun _ => inf_le_left) (fun a => ?_) hZ
  rw [P.apartment.rootFixer_singleton]
  exact (P.toValuationBuildingData.filtrationOpenSubgroup hB x a 0).isOpen'

/-- A chamber contains the point defining it. -/
theorem exists_mem_of_isChamber {C : Set P.Apartment}
    (hC : AffineRootSystem.IsChamber P.affineRoots C) : ∃ x, x ∈ C := by
  obtain ⟨x, _, hxC⟩ := hC
  exact ⟨x, hxC ▸ AffineRootSystem.mem_facet_self _ x⟩

/-- Under the fixed-apartment axioms, KP Corollary 8.2.6 and openness of
`Z(F)^0` make the actual chamber Iwahori open. -/
theorem isOpen_chamberIwahori_of_openRootGeneration
    (hD : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hgen : RelativeRoot.OpenRootCentralizerGenerationStatement.{u})
    (hZ : IsOpen (P.centralizerZero : Set (rationalPoints P.centralizer.Z)))
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C) :
    IsOpen (P.chamberIwahori C : Set (rationalPoints G)) := by
  obtain ⟨x, hx⟩ := P.exists_mem_of_isChamber hC
  rw [P.chamberIwahori_eq_parahoricAt hD hC hx]
  exact P.isOpen_parahoricAt_of_openRootGeneration hD.topologyCompatible hgen hZ x

/-- The actual chamber Iwahori as an open subgroup of `G(F)`, under the
premises of `isOpen_chamberIwahori_of_openRootGeneration`. -/
def chamberIwahoriOpenSubgroup
    (hD : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hgen : RelativeRoot.OpenRootCentralizerGenerationStatement.{u})
    (hZ : IsOpen (P.centralizerZero : Set (rationalPoints P.centralizer.Z)))
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C) :
    OpenSubgroup (rationalPoints G) where
  toSubgroup := P.chamberIwahori C
  isOpen' := P.isOpen_chamberIwahori_of_openRootGeneration hD hgen hZ hC

@[simp] theorem coe_chamberIwahoriOpenSubgroup
    (hD : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hgen : RelativeRoot.OpenRootCentralizerGenerationStatement.{u})
    (hZ : IsOpen (P.centralizerZero : Set (rationalPoints P.centralizer.Z)))
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C) :
    (P.chamberIwahoriOpenSubgroup hD hgen hZ hC : Set (rationalPoints G)) =
      P.chamberIwahori C := rfl

/-! ### Compactness -/

/-- The indivisible roots positive on `ν` admit an injective enumeration by
actual relative roots. -/
theorem exists_indivisiblePositiveRoots_enumeration (ν : cocharacterLattice P.S) :
    ∃ (n : ℕ) (a : Fin n → relativeRoots P.i),
      Function.Injective (fun j => (a j : characterLattice P.S)) ∧
        Set.range (fun j => (a j : characterLattice P.S)) =
          RelativeRoot.indivisiblePositiveRoots P.i ν := by
  classical
  have := P.isConnectedReductive.smooth
  have : Finite (relativeRoots P.i) :=
    (P.isMaximalSplitTorus.isSplitSubtorus.1.finite_relativeRoots P.i).to_subtype
  let T : Set (relativeRoots P.i) :=
    {a | (a : characterLattice P.S) ∈ RelativeRoot.indivisiblePositiveRoots P.i ν}
  let : Fintype T := Fintype.ofFinite T
  let e : Fin (Fintype.card T) ≃ T := (Fintype.equivFin T).symm
  refine ⟨Fintype.card T, fun j => (e j : relativeRoots P.i),
    Subtype.val_injective.comp (Subtype.val_injective.comp e.injective), ?_⟩
  ext b
  constructor
  · rintro ⟨j, rfl⟩
    exact (e j).property
  · intro hb
    let t : T := ⟨⟨b, hb.1.1⟩, hb⟩
    exact ⟨e.symm t, by simp only [Equiv.apply_symm_apply]; rfl⟩

/-- Under the fixed-apartment axioms, the chamber decomposition target and
compactness of `Z(F)^0` make the actual chamber Iwahori compact. -/
theorem isCompact_chamberIwahori_of_decomposition
    (hD : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hdec : P.ChamberIwahoriDecompositionStatement)
    (hZ : IsCompact (P.centralizerZero : Set (rationalPoints P.centralizer.Z)))
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C) :
    IsCompact (P.chamberIwahori C : Set (rationalPoints G)) := by
  obtain ⟨x, hx⟩ := P.exists_mem_of_isChamber hC
  let : Smooth G.X.hom := P.isConnectedReductive.smooth
  obtain ⟨ν, hν⟩ :=
    P.isMaximalSplitTorus.isSplitSubtorus.1.exists_genericCocharacter P.i
  obtain ⟨-, hconc, -⟩ := hdec hD C x ν hC hx hν
  obtain ⟨nneg, aneg, hnegi, hnegr⟩ := P.exists_indivisiblePositiveRoots_enumeration (-ν)
  obtain ⟨npos, apos, hposi, hposr⟩ := P.exists_indivisiblePositiveRoots_enumeration ν
  have hrange := (hconc.2.2.2.2.2.2 false nneg npos _ _ hnegi hnegr hposi hposr).2.2.2.2.2
  rw [← hrange]
  exact P.isCompact_range_orderedIwahoriChamberProduct hD.topologyCompatible hZ x false
    aneg apos

/-! ### Assembly -/

/-- The published chamber compact-openness target follows from KP
Corollary 8.2.6, the chamber decomposition target, and compact openness of
`Z(F)^0`. -/
theorem chamberIwahoriCompactOpenStatement_of_prerequisites
    (hgen : RelativeRoot.OpenRootCentralizerGenerationStatement.{u})
    (hdec : P.ChamberIwahoriDecompositionStatement)
    (hZc : IsCompact (P.centralizerZero : Set (rationalPoints P.centralizer.Z)))
    (hZo : IsOpen (P.centralizerZero : Set (rationalPoints P.centralizer.Z))) :
    P.ChamberIwahoriCompactOpenStatement := fun hD _ hC =>
  ⟨P.isCompact_chamberIwahori_of_decomposition hD hdec hZc hC,
    P.isOpen_chamberIwahori_of_openRootGeneration hD hgen hZo hC⟩

end Langlands.Geometry.Building.ParahoricBuildingData
