import Langlands.Geometry.Building.ChamberRankOne
import Langlands.Geometry.Building.ChamberPositiveCollection
import Langlands.Geometry.Building.CocharacterUniformizerProof
import Mathlib.Algebra.Module.Submodule.Union

/-!
# Exchange of the opposite root-group products at a chamber point

For a point `x` of a chamber and a generic cocharacter `mu`, the sharp fixer `G(k)^♯_x` is
contained in `X_x(Φ_{-mu}) X_x(Φ_mu) Z(k)^♯_x`, where `X_x(P)` is the subgroup generated by
the `U_{b,x,0}` for `b ∈ P` (the range part of Kaletha–Prasad Proposition 7.3.12 at a
chamber point). The proof moves a real vector `w ∈ V(S)` from `mu` to `-mu`, crossing one ray
of relative roots at a time; at each crossing a rank-one exchange interchanges the two root
groups of the ray.

The core, `sharpFixer_subset_mul_of_exchange`, holds at an arbitrary point `x` and for an
arbitrary subgroup `H` on the right, given the rank-one exchanges
`U_{-c,x,0} U_{c,x,0} ⊆ U_{c,x,0} U_{-c,x,0} H`. At a chamber point these are supplied with
`H = Z(k)^♯_x` by `ChamberRankOne`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise commutatorElement
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.Geometry.Building

/-! ### Subgroup algebra and a chain of real parameters -/

/-- A subgroup `K` whose commutators with every `L j` lie in `⨆ j, L j` normalizes
`⨆ j, L j`. -/
theorem le_normalizer_iSup_of_commutator_le {M : Type*} [Group M] {K : Subgroup M}
    {J : Type*} {L : J → Subgroup M} (h : ∀ j, ⁅K, L j⁆ ≤ ⨆ j, L j) :
    K ≤ Subgroup.normalizer ((⨆ j, L j : Subgroup M) : Set M) := by
  have key : ∀ g ∈ K, ∀ u ∈ ⨆ j, L j, g * u * g⁻¹ ∈ ⨆ j, L j := by
    intro g hg u hu
    have hle : (⨆ j, L j) ≤ (⨆ j, L j).comap (MulAut.conj g).toMonoidHom := by
      refine iSup_le fun j v hv => ?_
      rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      have hc : ⁅g, v⁆ ∈ ⨆ j, L j := h j (Subgroup.commutator_mem_commutator hg hv)
      have hv' : v ∈ ⨆ j, L j := Subgroup.mem_iSup_of_mem j hv
      have heq : g * v * g⁻¹ = ⁅g, v⁆ * v := by rw [commutatorElement_def]; group
      rw [heq]
      exact Subgroup.mul_mem _ hc hv'
    exact hle hu
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro u
  refine ⟨key g hg u, fun hu => ?_⟩
  have h' := key g⁻¹ (K.inv_mem hg) _ hu
  rwa [inv_inv, show g⁻¹ * (g * u * g⁻¹) * g = u by group] at h'

/-- If `f s = f s′` whenever at most one point of the finite set `Λ` lies strictly between
`s < s′` (both outside `Λ`), then `f s = f s′` for all `s < s′` outside `Λ`. -/
theorem eq_of_forall_single_crossing {α : Type*} (Λ : Finset ℝ) (f : ℝ → α)
    (hstep : ∀ s s', s < s' → s ∉ Λ → s' ∉ Λ →
      (∀ a ∈ Λ, ∀ b ∈ Λ, a ∈ Set.Ioo s s' → b ∈ Set.Ioo s s' → a = b) → f s = f s')
    {s s' : ℝ} (hss' : s < s') (hs : s ∉ Λ) (hs' : s' ∉ Λ) : f s = f s' := by
  suffices h : ∀ n : ℕ, ∀ s s', s < s' → s ∉ Λ → s' ∉ Λ →
      (Λ.filter (· ∈ Set.Ioo s s')).card ≤ n → f s = f s' from
    h _ s s' hss' hs hs' le_rfl
  intro n
  induction n with
  | zero =>
    intro s s' hss' hs hs' hcard
    refine hstep s s' hss' hs hs' fun a ha b hb hai hbi => ?_
    have : a ∈ Λ.filter (· ∈ Set.Ioo s s') := Finset.mem_filter.2 ⟨ha, hai⟩
    rw [Finset.card_eq_zero.1 (Nat.le_zero.1 hcard)] at this
    exact absurd this (Finset.notMem_empty _)
  | succ n ih =>
    intro s s' hss' hs hs' hcard
    by_cases hsingle : ∀ a ∈ Λ, ∀ b ∈ Λ, a ∈ Set.Ioo s s' → b ∈ Set.Ioo s s' → a = b
    · exact hstep s s' hss' hs hs' hsingle
    push Not at hsingle
    obtain ⟨a, ha, b, hb, hai, hbi, hab⟩ := hsingle
    set T := Λ.filter (· ∈ Set.Ioo s s') with hT
    have haT : a ∈ T := Finset.mem_filter.2 ⟨ha, hai⟩
    have hbT : b ∈ T := Finset.mem_filter.2 ⟨hb, hbi⟩
    have hTne : T.Nonempty := ⟨a, haT⟩
    set l₁ := T.min' hTne with hl₁
    have hT'ne : (T.erase l₁).Nonempty := by
      by_cases hal : a = l₁
      · exact ⟨b, Finset.mem_erase.2 ⟨fun h => hab (hal.trans h.symm), hbT⟩⟩
      · exact ⟨a, Finset.mem_erase.2 ⟨hal, haT⟩⟩
    set l₂ := (T.erase l₁).min' hT'ne with hl₂
    have hl₁T : l₁ ∈ T := Finset.min'_mem T hTne
    have hl₂T' : l₂ ∈ T.erase l₁ := Finset.min'_mem _ hT'ne
    have hl₂T : l₂ ∈ T := Finset.mem_of_mem_erase hl₂T'
    have hl₁₂ : l₁ < l₂ := lt_of_le_of_ne (Finset.min'_le T l₂ hl₂T)
      (Ne.symm (Finset.ne_of_mem_erase hl₂T'))
    have hl₁I := (Finset.mem_filter.1 hl₁T).2
    have hl₂I := (Finset.mem_filter.1 hl₂T).2
    set s'' := (l₁ + l₂) / 2 with hs''
    have h1 : l₁ < s'' := by rw [hs'']; linarith
    have h2 : s'' < l₂ := by rw [hs'']; linarith
    -- elements of `T` other than `l₁` are at least `l₂`
    have hge : ∀ c ∈ T, c ≠ l₁ → l₂ ≤ c := fun c hc hne =>
      Finset.min'_le _ c (Finset.mem_erase.2 ⟨hne, hc⟩)
    have hs''Λ : s'' ∉ Λ := by
      intro h
      have hT'' : s'' ∈ T := Finset.mem_filter.2 ⟨h, ⟨by linarith [hl₁I.1], by linarith [hl₂I.2]⟩⟩
      have := hge s'' hT'' (ne_of_gt h1)
      linarith
    have hleft : f s = f s'' := by
      refine hstep s s'' (by linarith [hl₁I.1]) hs hs''Λ fun c hc d hd hci hdi => ?_
      have hc' : c = l₁ := by
        by_contra hne
        have := hge c (Finset.mem_filter.2 ⟨hc, ⟨hci.1, by linarith [hci.2, hl₂I.2]⟩⟩) hne
        linarith [hci.2]
      have hd' : d = l₁ := by
        by_contra hne
        have := hge d (Finset.mem_filter.2 ⟨hd, ⟨hdi.1, by linarith [hdi.2, hl₂I.2]⟩⟩) hne
        linarith [hdi.2]
      rw [hc', hd']
    have hright : f s'' = f s' := by
      refine ih s'' s' (by linarith [hl₂I.2]) hs''Λ hs' ?_
      have hsub : Λ.filter (· ∈ Set.Ioo s'' s') ⊆ T.erase l₁ := by
        intro c hc
        obtain ⟨hcΛ, hci⟩ := Finset.mem_filter.1 hc
        refine Finset.mem_erase.2 ⟨ne_of_gt (lt_trans h1 hci.1), Finset.mem_filter.2 ⟨hcΛ, ?_⟩⟩
        exact ⟨by linarith [hci.1, hl₁I.1], hci.2⟩
      have hcardT : (T.erase l₁).card = T.card - 1 := Finset.card_erase_of_mem hl₁T
      have := Finset.card_le_card hsub
      omega
    exact hleft.trans hright

/-- If `X ≠ 0`, `s < s′` and `X(a - s) · X(a - s′) < 0`, then `a ∈ (s, s′)`. -/
theorem mem_Ioo_of_mul_neg {X a s s' : ℝ} (hX : X ≠ 0) (hss' : s < s')
    (h : X * (a - s) * (X * (a - s')) < 0) : a ∈ Set.Ioo s s' := by
  have hX2 : 0 < X ^ 2 := by positivity
  have h' : X ^ 2 * ((a - s) * (a - s')) < 0 := by
    have : X * (a - s) * (X * (a - s')) = X ^ 2 * ((a - s) * (a - s')) := by ring
    rw [← this]
    exact h
  have h'' : (a - s) * (a - s') < 0 := by
    by_contra hc
    push Not at hc
    nlinarith [mul_nonneg hX2.le hc]
  refine ⟨?_, ?_⟩
  · by_contra hc
    push Not at hc
    nlinarith
  · by_contra hc
    push Not at hc
    nlinarith

/-- Sign arithmetic for a combination `E = p A + q B` of a separating value `A` and a
positive value `B`, given that `E` and `E′` have the same sign. -/
theorem combination_pos_of_sameSign {A A' B B' p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hAA : A * A' < 0) (hB : 0 < B) (hB' : 0 < B')
    (hEE : 0 < (p * A + q * B) * (p * A' + q * B')) :
    0 < p * A + q * B ∧ 0 < p * A' + q * B' := by
  rcases lt_or_gt_of_ne (left_ne_zero_of_mul hAA.ne) with hA | hA
  · have hA' : 0 < A' := by
      by_contra hc
      push Not at hc
      nlinarith
    have hE' : 0 < p * A' + q * B' := by positivity
    exact ⟨(pos_iff_pos_of_mul_pos hEE).2 hE', hE'⟩
  · have hE : 0 < p * A + q * B := by positivity
    exact ⟨hE, (pos_iff_pos_of_mul_pos hEE).1 hE⟩

/-! ### Real vectors and their positive roots -/

variable {k : Type u} [Field k] {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

/-- The relative roots that are positive on a real vector `w ∈ V(S)`. -/
def realPositiveRoots [IsAffineHom G.X.hom] (i : S.toGrp ⟶ G) (w : V S) :
    Set (characterLattice S) :=
  {c | c ∈ relativeRoots i ∧ 0 < eval S c w}

/-- A real vector on which no relative root vanishes. -/
def IsRealGeneric [IsAffineHom G.X.hom] (i : S.toGrp ⟶ G) (w : V S) : Prop :=
  ∀ c ∈ relativeRoots i, eval S c w ≠ 0

/-- The relative roots that separate `w` and `w′` are pairwise proportional. -/
def IsRayCrossing [IsAffineHom G.X.hom] (i : S.toGrp ⟶ G) (w w' : V S) : Prop :=
  ∀ c ∈ relativeRoots i, ∀ d ∈ relativeRoots i, eval S c w * eval S c w' < 0 →
    eval S d w * eval S d w' < 0 → ∃ t : ℝ, eval S d = t • eval S c

section RealVectors

variable [IsAffineHom G.X.hom] {i : S.toGrp ⟶ G}

theorem IsRealGeneric.neg {w : V S} (h : IsRealGeneric i w) : IsRealGeneric i (-w) :=
  fun c hc => by rw [map_neg]; exact neg_ne_zero.2 (h c hc)

theorem IsRayCrossing.neg {w w' : V S} (h : IsRayCrossing i w w') :
    IsRayCrossing i (-w) (-w') := by
  intro c hc d hd hcD hdD
  simp only [map_neg, neg_mul_neg] at hcD hdD
  exact h c hc d hd hcD hdD

theorem IsRayCrossing.symm {w w' : V S} (h : IsRayCrossing i w w') : IsRayCrossing i w' w := by
  intro c hc d hd hcD hdD
  rw [mul_comm] at hcD hdD
  exact h c hc d hd hcD hdD

/-- If no relative root separates `w` and `w′`, the crossing condition holds vacuously. -/
theorem isRayCrossing_of_forall_pos {w w' : V S}
    (h : ∀ c ∈ relativeRoots i, 0 < eval S c w * eval S c w') : IsRayCrossing i w w' :=
  fun c hc _ _ hcD _ => absurd hcD (not_lt.2 (h c hc).le)

/-- A root combination `p c + q b` with `c` separating `w, w′` and `b` positive on both is
positive on both. -/
theorem combination_pos_of_crossing {w w' : V S} (hw : IsRealGeneric i w)
    (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w') {c b : characterLattice S}
    (hc : c ∈ relativeRoots i) (hcD : eval S c w * eval S c w' < 0)
    (hbw : 0 < eval S b w) (hbw' : 0 < eval S b w') {p q : ℕ} (hp : 0 < p) (hq : 0 < q)
    (he : p • c + q • b ∈ relativeRoots i) :
    0 < eval S (p • c + q • b) w ∧ 0 < eval S (p • c + q • b) w' := by
  have hp' : (0 : ℝ) < p := by exact_mod_cast hp
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hsame : 0 < eval S (p • c + q • b) w * eval S (p • c + q • b) w' := by
    rcases lt_or_gt_of_ne (mul_ne_zero (hw _ he) (hw' _ he)) with hneg | hpos
    · exfalso
      obtain ⟨t, ht⟩ := hcross c hc _ he hcD hneg
      have h1 := congrArg (fun f : V S →ₗ[ℝ] ℝ => f w) ht
      have h2 := congrArg (fun f : V S →ₗ[ℝ] ℝ => f w') ht
      simp only [LinearMap.smul_apply, smul_eq_mul, eval_add_char, eval_nsmul_char] at h1 h2
      have hB : (q : ℝ) * eval S b w = (t - p) * eval S c w := by linarith
      have hB' : (q : ℝ) * eval S b w' = (t - p) * eval S c w' := by linarith
      have heq : (q : ℝ) * eval S b w * ((q : ℝ) * eval S b w') =
          (t - p) ^ 2 * (eval S c w * eval S c w') := by
        rw [hB, hB']
        ring
      have hl : 0 < (q : ℝ) * eval S b w * ((q : ℝ) * eval S b w') := by positivity
      have hr : (t - p) ^ 2 * (eval S c w * eval S c w') ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (sq_nonneg _) hcD.le
      linarith
    · exact hpos
  rw [eval_add_char, eval_nsmul_char, eval_nsmul_char, eval_add_char, eval_nsmul_char,
    eval_nsmul_char] at hsame
  rw [eval_add_char, eval_nsmul_char, eval_nsmul_char, eval_add_char, eval_nsmul_char,
    eval_nsmul_char]
  exact combination_pos_of_sameSign hp' hq' hcD hbw hbw' hsame

/-- A root `b` positive on `w, w′` is not a negative multiple of a root `c` separating them;
this is the non-opposition hypothesis of V 3. -/
theorem tmul_ne_neg_smul_of_crossing {w w' : V S} {c b : characterLattice S}
    (hcD : eval S c w * eval S c w' < 0) (hbw : 0 < eval S b w) (hbw' : 0 < eval S b w') :
    ∀ t : ℝ, 0 < t → ((1 : ℝ) ⊗ₜ[ℤ] b : Vstar S) ≠ -(t • (1 : ℝ) ⊗ₜ[ℤ] c) := by
  intro t ht heq
  have h1 := congrArg (fun χ => pair S χ w) heq
  have h2 := congrArg (fun χ => pair S χ w') heq
  simp only [map_neg, map_smul, LinearMap.neg_apply, LinearMap.smul_apply, smul_eq_mul,
    ← eval_eq_pair] at h1 h2
  have heq' : eval S b w * eval S b w' = t ^ 2 * (eval S c w * eval S c w') := by
    rw [h1, h2]
    ring
  have hl : 0 < eval S b w * eval S b w' := mul_pos hbw hbw'
  have ht2 : 0 < t ^ 2 := by positivity
  nlinarith

/-- Evaluation on `V(S)` determines a character of a split torus. -/
theorem eval_injective (hT : IsSplitTorus S.toGrp) {a b : characterLattice S}
    (h : eval S a = eval S b) : a = b := by
  have := CocharacterUniformizer.latticePairing_isPerfPair k S hT
  apply (LinearMap.IsPerfPair.bijective_left (latticePairing S)).injective
  refine LinearMap.ext fun ν => ?_
  have h1 := congrArg (fun f : V S →ₗ[ℝ] ℝ => f ((1 : ℝ) ⊗ₜ[ℤ] ν)) h
  simp only [eval_tmul, one_mul, Int.cast_inj] at h1
  exact h1

end RealVectors

namespace KPApartmentData

variable [IsAffineHom G.X.hom] {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] {ω : kˣ → ℝ}
  (D : KPApartmentData i ω)

/-- `X_x(P)`, the subgroup generated by the `U_{b,x,0}` for `b ∈ P`. -/
def rootSpan (x : D.Apartment) (P : Set (characterLattice S)) : Subgroup (rationalPoints G) :=
  ⨆ b : P, D.filtration x b 0

/-- `Y_x(H, w) = X_x(Φ_{-w}) X_x(Φ_w) H` for a subgroup `H` and a real vector `w`. -/
def exchangeSet (x : D.Apartment) (H : Subgroup (rationalPoints G)) (w : V S) :
    Set (rationalPoints G) :=
  (D.rootSpan x (realPositiveRoots i (-w)) : Set (rationalPoints G)) *
    D.rootSpan x (realPositiveRoots i w) * H

variable {D}

theorem filtration_le_rootSpan (x : D.Apartment) {P : Set (characterLattice S)}
    {b : characterLattice S} (hb : b ∈ P) : D.filtration x b 0 ≤ D.rootSpan x P :=
  le_iSup_of_le (⟨b, hb⟩ : P) le_rfl

theorem rootSpan_mono (x : D.Apartment) {P Q : Set (characterLattice S)} (h : P ⊆ Q) :
    D.rootSpan x P ≤ D.rootSpan x Q :=
  iSup_le fun b => filtration_le_rootSpan x (h b.2)

theorem rootSpan_le_sup (x : D.Apartment) {P Q₁ Q₂ : Set (characterLattice S)}
    (h : P ⊆ Q₁ ∪ Q₂) : D.rootSpan x P ≤ D.rootSpan x Q₁ ⊔ D.rootSpan x Q₂ :=
  iSup_le fun b => (h b.2).elim (fun h1 => le_sup_of_le_left (filtration_le_rootSpan x h1))
    (fun h2 => le_sup_of_le_right (filtration_le_rootSpan x h2))

theorem rootSpan_eq_bot (x : D.Apartment) {P : Set (characterLattice S)} (h : P = ∅) :
    D.rootSpan x P = ⊥ := by
  subst h
  exact le_bot_iff.1 (iSup_le fun b => absurd b.2 (Set.notMem_empty _))

/-- A root group of a separating root normalizes the span of the roots positive on both
vectors (V 3). -/
theorem filtration_le_normalizer_rootSpan (x : D.Apartment) {w w' : V S}
    (hw : IsRealGeneric i w) (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w')
    {c : characterLattice S} (hc : c ∈ relativeRoots i)
    (hcD : eval S c w * eval S c w' < 0) :
    D.filtration x c 0 ≤ Subgroup.normalizer
      ((D.rootSpan x (realPositiveRoots i w ∩ realPositiveRoots i w') :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
  refine le_normalizer_iSup_of_commutator_le fun b => ?_
  obtain ⟨⟨hb, hbw⟩, -, hbw'⟩ := b.2
  refine (D.filtration_commutator_le x hc hb (tmul_ne_neg_smul_of_crossing hcD hbw hbw')
    0 0).trans ?_
  refine iSup_le fun p => iSup_le fun q => iSup_le fun hp => iSup_le fun hq =>
    iSup_le fun he => ?_
  rw [show (p : ℝ) * 0 + (q : ℝ) * 0 = 0 by ring]
  obtain ⟨h1, h2⟩ := combination_pos_of_crossing hw hw' hcross hc hcD hbw hbw' hp hq he
  exact filtration_le_rootSpan x ⟨⟨he, h1⟩, he, h2⟩

theorem rootSpan_le_normalizer_rootSpan (x : D.Apartment) {w w' : V S}
    (hw : IsRealGeneric i w) (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w')
    {P : Set (characterLattice S)}
    (hP : ∀ c ∈ P, c ∈ relativeRoots i ∧ eval S c w * eval S c w' < 0) :
    D.rootSpan x P ≤ Subgroup.normalizer
      ((D.rootSpan x (realPositiveRoots i w ∩ realPositiveRoots i w') :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) :=
  iSup_le fun c => filtration_le_normalizer_rootSpan x hw hw' hcross (hP c c.2).1 (hP c c.2).2

/-- Proportional relative roots with a positive ratio are equal or differ by a factor two. -/
theorem eq_or_double_of_eval_eq_smul (D : KPApartmentData i ω) (hT : IsSplitTorus S.toGrp)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    {c d : characterLattice S} (hc : c ∈ relativeRoots i) (hd : d ∈ relativeRoots i)
    {t : ℝ} (ht : 0 < t) (h : eval S d = t • eval S c) :
    d = c ∨ d = 2 • c ∨ c = 2 • d := by
  have hroot (b : relativeRoots i) :
      ∃ ψ ∈ D.extendedAffineRoots, ψ.linear = rootForm i b := by
    apply AffineRootSystem.mem_derivativeRoots.mp
    rw [hderiv]
    exact Set.mem_range_self b
  obtain ⟨ψc, hψc, hψclin⟩ := hroot ⟨c, hc⟩
  obtain ⟨ψd, hψd, hψdlin⟩ := hroot ⟨d, hd⟩
  have hform : rootForm i ⟨d, hd⟩ = t • rootForm i ⟨c, hc⟩ := by
    apply LinearMap.ext
    intro v
    refine Submodule.Quotient.induction_on _ v fun w => ?_
    rw [LinearMap.smul_apply, rootForm_mk, rootForm_mk, h, LinearMap.smul_apply]
  have hlin : ψd.linear = t • ψc.linear := by rw [hψdlin, hψclin, hform]
  obtain ⟨vd, hvd⟩ := hsys.exists_isCoroot ψd hψd
  obtain ⟨z₁, hz₁⟩ := hsys.coroot_integral ψc hψc ψd hψd vd hvd
  obtain ⟨vc, hvc⟩ := hsys.exists_isCoroot ψc hψc
  obtain ⟨z₂, hz₂⟩ := hsys.coroot_integral ψd hψd ψc hψc vc hvc
  have e1 : t * (z₁ : ℝ) = 2 := by
    rw [← hz₁, ← hvd.1, hlin, LinearMap.smul_apply, smul_eq_mul]
  have e2 : (z₂ : ℝ) = t * 2 := by
    rw [← hz₂, hlin, LinearMap.smul_apply, smul_eq_mul, hvc.1]
  have hz : z₁ * z₂ = 4 := by
    have : (z₁ : ℝ) * z₂ = 4 := by rw [e2]; linear_combination 2 * e1
    exact_mod_cast this
  have hz₁pos : 0 < z₁ := by
    have : (0 : ℝ) < z₁ := by
      by_contra hcon
      push Not at hcon
      nlinarith
    exact_mod_cast this
  have hz₂pos : 0 < z₂ := by
    by_contra hcon
    push Not at hcon
    nlinarith
  have hz₁le : z₁ ≤ 4 := by nlinarith
  have hsmul : ∀ (s : ℝ) (a : characterLattice S), eval S a = s • eval S c →
      eval S (2 • a) = (2 * s) • eval S c := by
    intro s a ha
    refine LinearMap.ext fun v => ?_
    rw [eval_nsmul_char, ha, LinearMap.smul_apply, LinearMap.smul_apply, smul_eq_mul,
      smul_eq_mul]
    push_cast
    ring
  interval_cases z₁
  · -- `t = 2`
    have ht2 : t = 2 := by push_cast at e1; linarith
    right; left
    apply eval_injective hT
    rw [h, hsmul 1 c (one_smul _ _).symm, ht2]
    norm_num
  · -- `t = 1`
    have ht1 : t = 1 := by push_cast at e1; linarith
    left
    apply eval_injective hT
    rw [h, ht1, one_smul]
  · omega
  · -- `t = 1 / 2`
    have ht2 : t = 1 / 2 := by push_cast at e1; linarith
    right; right
    apply eval_injective hT
    rw [hsmul t d h, ht2]
    norm_num

/-- The rank-one step: the roots positive on `w` and negative on `w′` form one ray
`{c₁, 2c₁}`, and the assumed rank-one exchange swaps its root group with the opposite one. -/
theorem rootSpan_cross_mul_subset (hT : IsSplitTorus S.toGrp)
    (hfinite : (relativeRoots i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    {x : D.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (D.filtration x (-c) 0 : Set (rationalPoints G)) *
      D.filtration x c 0 ⊆ (D.filtration x c 0 : Set (rationalPoints G)) *
        D.filtration x (-c) 0 * H)
    {w w' : V S} (hcross : IsRayCrossing i w w') :
    (D.rootSpan x (realPositiveRoots i (-w) ∩ realPositiveRoots i w') :
        Set (rationalPoints G)) *
      D.rootSpan x (realPositiveRoots i w ∩ realPositiveRoots i (-w')) *
        (H : Set (rationalPoints G)) ⊆
      (D.rootSpan x (realPositiveRoots i w ∩ realPositiveRoots i (-w')) :
          Set (rationalPoints G)) *
        D.rootSpan x (realPositiveRoots i (-w) ∩ realPositiveRoots i w') * H := by
  have mem₁ : ∀ c, c ∈ realPositiveRoots i w ∩ realPositiveRoots i (-w') ↔
      c ∈ relativeRoots i ∧ 0 < eval S c w ∧ eval S c w' < 0 := by
    intro c
    simp only [realPositiveRoots, Set.mem_inter_iff, Set.mem_ofPred_eq, map_neg, neg_pos]
    tauto
  have mem₂ : ∀ c, c ∈ realPositiveRoots i (-w) ∩ realPositiveRoots i w' ↔
      c ∈ relativeRoots i ∧ eval S c w < 0 ∧ 0 < eval S c w' := by
    intro c
    simp only [realPositiveRoots, Set.mem_inter_iff, Set.mem_ofPred_eq, map_neg, neg_pos]
    tauto
  by_cases hne : (realPositiveRoots i w ∩ realPositiveRoots i (-w')).Nonempty
  · obtain ⟨c₁, hc₁, hmin⟩ := Set.exists_min_image _ (fun c => eval S c w)
      (hfinite.subset fun c hc => ((mem₁ c).1 hc).1) hne
    obtain ⟨hc₁Φ, hc₁w, hc₁w'⟩ := (mem₁ c₁).1 hc₁
    have hray : ∀ d ∈ realPositiveRoots i w ∩ realPositiveRoots i (-w'),
        d = c₁ ∨ d = 2 • c₁ := by
      intro d hd
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₁ d).1 hd
      obtain ⟨t, ht⟩ := hcross c₁ hc₁Φ d hdΦ (mul_neg_of_pos_of_neg hc₁w hc₁w')
        (mul_neg_of_pos_of_neg hdw hdw')
      have htw : eval S d w = t * eval S c₁ w := by rw [ht]; rfl
      have htpos : 0 < t := by
        by_contra hcon
        push Not at hcon
        nlinarith
      rcases D.eq_or_double_of_eval_eq_smul hT hsys hderiv hc₁Φ hdΦ htpos ht with h | h | h
      · exact Or.inl h
      · exact Or.inr h
      · exfalso
        have hm := hmin d hd
        rw [h, eval_nsmul_char] at hm
        push_cast at hm
        linarith
    have hc₁D₂ : -c₁ ∈ realPositiveRoots i (-w) ∩ realPositiveRoots i w' :=
      (mem₂ _).2 ⟨hneg c₁ hc₁Φ, by rw [eval_neg_char]; linarith,
        by rw [eval_neg_char]; linarith⟩
    have hU₁ : D.rootSpan x (realPositiveRoots i w ∩ realPositiveRoots i (-w')) =
        D.filtration x c₁ 0 := by
      refine le_antisymm (iSup_le fun d => ?_) (filtration_le_rootSpan x hc₁)
      rcases hray d d.2 with h | h
      · exact le_of_eq (congrArg (fun a => D.filtration x a 0) h)
      · rw [h]
        exact D.filtration_double_le x hc₁Φ (h ▸ ((mem₁ d).1 d.2).1)
    have hU₂ : D.rootSpan x (realPositiveRoots i (-w) ∩ realPositiveRoots i w') =
        D.filtration x (-c₁) 0 := by
      refine le_antisymm (iSup_le fun d => ?_) (filtration_le_rootSpan x hc₁D₂)
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₂ d).1 d.2
      have hnd : -(d : characterLattice S) ∈ realPositiveRoots i w ∩ realPositiveRoots i (-w') :=
        (mem₁ _).2 ⟨hneg _ hdΦ, by rw [eval_neg_char]; linarith,
          by rw [eval_neg_char]; linarith⟩
      rcases hray _ hnd with h | h
      · have hd' : (d : characterLattice S) = -c₁ := by rw [← h, neg_neg]
        exact le_of_eq (congrArg (fun a => D.filtration x a 0) hd')
      · have hd' : (d : characterLattice S) = 2 • -c₁ := by rw [smul_neg, ← h, neg_neg]
        rw [hd']
        exact D.filtration_double_le x (hneg c₁ hc₁Φ) (hd' ▸ hdΦ)
    rw [hU₁, hU₂]
    calc (D.filtration x (-c₁) 0 : Set (rationalPoints G)) * D.filtration x c₁ 0 * H
        ⊆ (D.filtration x c₁ 0 : Set (rationalPoints G)) * D.filtration x (-c₁) 0 * H * H :=
          Set.mul_subset_mul_right (hex c₁ hc₁Φ)
      _ = (D.filtration x c₁ 0 : Set (rationalPoints G)) * D.filtration x (-c₁) 0 * H := by
          rw [mul_assoc _ (H : Set (rationalPoints G)), coe_mul_coe]
  · have h₁ : realPositiveRoots i w ∩ realPositiveRoots i (-w') = ∅ :=
      Set.not_nonempty_iff_eq_empty.1 hne
    have h₂ : realPositiveRoots i (-w) ∩ realPositiveRoots i w' = ∅ := by
      refine Set.eq_empty_of_forall_notMem fun d hd => hne ⟨-d, ?_⟩
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₂ d).1 hd
      exact (mem₁ _).2 ⟨hneg _ hdΦ, by rw [eval_neg_char]; linarith,
        by rw [eval_neg_char]; linarith⟩
    rw [rootSpan_eq_bot x h₁, rootSpan_eq_bot x h₂]

/-- **Exchange across one ray.** If the relative roots separating two generic real vectors
`w, w′` are pairwise proportional, then `Y_x(H, w) ⊆ Y_x(H, w′)`. -/
theorem exchangeSet_subset (hT : IsSplitTorus S.toGrp)
    (hfinite : (relativeRoots i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    {x : D.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (D.filtration x (-c) 0 : Set (rationalPoints G)) *
      D.filtration x c 0 ⊆ (D.filtration x c 0 : Set (rationalPoints G)) *
        D.filtration x (-c) 0 * H)
    {w w' : V S} (hw : IsRealGeneric i w)
    (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w') :
    D.exchangeSet x H w ⊆ D.exchangeSet x H w' := by
  set R := realPositiveRoots i w ∩ realPositiveRoots i w' with hR
  set Rn := realPositiveRoots i (-w) ∩ realPositiveRoots i (-w') with hRn
  set D₁ := realPositiveRoots i w ∩ realPositiveRoots i (-w') with hD₁
  set D₂ := realPositiveRoots i (-w) ∩ realPositiveRoots i w' with hD₂
  have sep₁ : ∀ c ∈ D₁, c ∈ relativeRoots i ∧ eval S c w * eval S c w' < 0 := by
    intro c hc
    obtain ⟨⟨hcΦ, hcw⟩, -, hcw'⟩ := hc
    rw [map_neg] at hcw'
    exact ⟨hcΦ, mul_neg_of_pos_of_neg hcw (neg_pos.1 hcw')⟩
  have sep₂ : ∀ c ∈ D₂, c ∈ relativeRoots i ∧ eval S c w * eval S c w' < 0 := by
    intro c hc
    obtain ⟨⟨hcΦ, hcw⟩, -, hcw'⟩ := hc
    rw [map_neg] at hcw
    exact ⟨hcΦ, mul_neg_of_neg_of_pos (neg_pos.1 hcw) hcw'⟩
  have sep₂n : ∀ c ∈ D₂, c ∈ relativeRoots i ∧ eval S c (-w) * eval S c (-w') < 0 := by
    intro c hc
    rw [map_neg, map_neg, neg_mul_neg]
    exact sep₂ c hc
  have N1 : D.rootSpan x D₂ ≤ Subgroup.normalizer (D.rootSpan x Rn : Set (rationalPoints G)) :=
    rootSpan_le_normalizer_rootSpan x hw.neg hw'.neg hcross.neg sep₂n
  have N2 : D.rootSpan x D₂ ≤ Subgroup.normalizer (D.rootSpan x R : Set (rationalPoints G)) :=
    rootSpan_le_normalizer_rootSpan x hw hw' hcross sep₂
  have N3 : D.rootSpan x D₁ ≤ Subgroup.normalizer (D.rootSpan x R : Set (rationalPoints G)) :=
    rootSpan_le_normalizer_rootSpan x hw hw' hcross sep₁
  have hcov₁ : realPositiveRoots i (-w) ⊆ Rn ∪ D₂ := by
    intro c hc
    rcases lt_or_gt_of_ne (hw' c hc.1) with h | h
    · left
      exact ⟨hc, hc.1, by rw [map_neg]; linarith⟩
    · right
      exact ⟨hc, hc.1, h⟩
  have hcov₂ : realPositiveRoots i w ⊆ R ∪ D₁ := by
    intro c hc
    rcases lt_or_gt_of_ne (hw' c hc.1) with h | h
    · right
      exact ⟨hc, hc.1, by rw [map_neg]; linarith⟩
    · left
      exact ⟨hc, hc.1, h⟩
  have hPn : (D.rootSpan x (realPositiveRoots i (-w)) : Set (rationalPoints G)) ⊆
      (D.rootSpan x Rn : Set (rationalPoints G)) * D.rootSpan x D₂ := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N1]
    exact rootSpan_le_sup x hcov₁
  have hP : (D.rootSpan x (realPositiveRoots i w) : Set (rationalPoints G)) ⊆
      (D.rootSpan x R : Set (rationalPoints G)) * D.rootSpan x D₁ := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N3]
    exact rootSpan_le_sup x hcov₂
  have hcomm₂ : (D.rootSpan x D₂ : Set (rationalPoints G)) * D.rootSpan x R =
      (D.rootSpan x R : Set (rationalPoints G)) * D.rootSpan x D₂ := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ N2,
      ← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N2, sup_comm]
  have hcomm₁ : (D.rootSpan x R : Set (rationalPoints G)) * D.rootSpan x D₁ =
      (D.rootSpan x D₁ : Set (rationalPoints G)) * D.rootSpan x R := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ N3,
      ← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N3, sup_comm]
  have hQn : (D.rootSpan x Rn : Set (rationalPoints G)) * D.rootSpan x D₁ ⊆
      D.rootSpan x (realPositiveRoots i (-w')) :=
    Set.mul_subset_iff.2 fun a ha b hb => Subgroup.mul_mem _
      (rootSpan_mono x Set.inter_subset_right ha) (rootSpan_mono x Set.inter_subset_right hb)
  have hQ : (D.rootSpan x R : Set (rationalPoints G)) * D.rootSpan x D₂ ⊆
      D.rootSpan x (realPositiveRoots i w') :=
    Set.mul_subset_iff.2 fun a ha b hb => Subgroup.mul_mem _
      (rootSpan_mono x Set.inter_subset_right ha) (rootSpan_mono x Set.inter_subset_right hb)
  have hex₀ := rootSpan_cross_mul_subset hT hfinite hsys hderiv hneg hex hcross
  unfold exchangeSet
  set XR : Set (rationalPoints G) := (D.rootSpan x R : Set (rationalPoints G))
  set XRn : Set (rationalPoints G) := (D.rootSpan x Rn : Set (rationalPoints G))
  set X₁ : Set (rationalPoints G) := (D.rootSpan x D₁ : Set (rationalPoints G))
  set X₂ : Set (rationalPoints G) := (D.rootSpan x D₂ : Set (rationalPoints G))
  set Hs : Set (rationalPoints G) := (H : Set (rationalPoints G))
  calc (D.rootSpan x (realPositiveRoots i (-w)) : Set (rationalPoints G)) *
        D.rootSpan x (realPositiveRoots i w) * Hs
      ⊆ XRn * X₂ * (XR * X₁) * Hs := Set.mul_subset_mul_right (Set.mul_subset_mul hPn hP)
    _ = XRn * XR * (X₂ * X₁ * Hs) := by
        simp only [mul_assoc]
        rw [← mul_assoc X₂ XR, hcomm₂, mul_assoc]
    _ ⊆ XRn * XR * (X₁ * X₂ * Hs) := Set.mul_subset_mul_left hex₀
    _ = XRn * X₁ * (XR * X₂) * Hs := by
        simp only [mul_assoc]
        rw [← mul_assoc XR X₁, hcomm₁, mul_assoc]
    _ ⊆ D.rootSpan x (realPositiveRoots i (-w')) * D.rootSpan x (realPositiveRoots i w') * Hs :=
        Set.mul_subset_mul_right (Set.mul_subset_mul hQn hQ)

theorem exchangeSet_eq (hT : IsSplitTorus S.toGrp)
    (hfinite : (relativeRoots i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    {x : D.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (D.filtration x (-c) 0 : Set (rationalPoints G)) *
      D.filtration x c 0 ⊆ (D.filtration x c 0 : Set (rationalPoints G)) *
        D.filtration x (-c) 0 * H)
    {w w' : V S} (hw : IsRealGeneric i w)
    (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w') :
    D.exchangeSet x H w = D.exchangeSet x H w' :=
  Set.Subset.antisymm
    (exchangeSet_subset hT hfinite hsys hderiv hneg hex hw hw' hcross)
    (exchangeSet_subset hT hfinite hsys hderiv hneg hex hw' hw hcross.symm)

/-- **Opposite exchange.** For a generic cocharacter `mu`, `Y_x(H, mu) = Y_x(H, -mu)`: the path
`s ↦ eta - s mu` from a vector with the positive roots of `mu` to one with those of `-mu`
crosses one ray of relative roots at a time when `eta` avoids finitely many hyperplanes. -/
theorem exchangeSet_tmul_eq_neg (hT : IsSplitTorus S.toGrp)
    (hfinite : (relativeRoots i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    {x : D.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (D.filtration x (-c) 0 : Set (rationalPoints G)) *
      D.filtration x c 0 ⊆ (D.filtration x c 0 : Set (rationalPoints G)) *
        D.filtration x (-c) 0 * H)
    {mu : cocharacterLattice S} (hmu : IsGenericCocharacter i mu) :
    D.exchangeSet x H ((1 : ℝ) ⊗ₜ[ℤ] mu) = D.exchangeSet x H (-((1 : ℝ) ⊗ₜ[ℤ] mu)) := by
  set ν : V S := (1 : ℝ) ⊗ₜ[ℤ] mu with hν
  have hνgen : IsRealGeneric i ν := fun c hc => by
    rw [hν, eval_tmul, one_mul]
    exact_mod_cast hmu c hc
  have : Finite (relativeRoots i) := hfinite.to_subtype
  -- a vector `eta` on which the crossing parameters of non-proportional roots differ
  let ℓ : relativeRoots i × relativeRoots i → Module.Dual ℝ (V S) := fun p =>
    eval S p.2.1 ν • eval S p.1.1 - eval S p.1.1 ν • eval S p.2.1
  obtain ⟨eta, heta⟩ := Module.Dual.exists_forall_ne_zero_of_forall_exists
    (fun p : {p : relativeRoots i × relativeRoots i // ∃ v, ℓ p v ≠ 0} => ℓ p.1)
    (fun p => p.2)
  let lam : characterLattice S → ℝ := fun c => eval S c eta / eval S c ν
  have hlam : ∀ c ∈ relativeRoots i, ∀ d ∈ relativeRoots i, lam c = lam d →
      ∃ t : ℝ, eval S d = t • eval S c := by
    intro c hc d hd hcd
    have h1 := hνgen c hc
    have h2 := hνgen d hd
    by_cases hex : ∃ v, ℓ (⟨c, hc⟩, ⟨d, hd⟩) v ≠ 0
    · exfalso
      apply heta ⟨(⟨c, hc⟩, ⟨d, hd⟩), hex⟩
      simp only [ℓ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]
      simp only [lam] at hcd
      rw [div_eq_div_iff h1 h2] at hcd
      linarith
    · push Not at hex
      refine ⟨eval S d ν / eval S c ν, LinearMap.ext fun v => ?_⟩
      have hv := hex v
      simp only [ℓ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul, sub_eq_zero] at hv
      rw [LinearMap.smul_apply, smul_eq_mul, div_mul_eq_mul_div, eq_div_iff h1]
      linarith
  let w : ℝ → V S := fun s => eta - s • ν
  have hew : ∀ c ∈ relativeRoots i, ∀ s, eval S c (w s) = eval S c ν * (lam c - s) := by
    intro c hc s
    have h1 := hνgen c hc
    simp only [w, lam, map_sub, map_smul, smul_eq_mul]
    field_simp
  set Λ : Finset ℝ := hfinite.toFinset.image lam with hΛ
  have hmemΛ : ∀ c ∈ relativeRoots i, lam c ∈ Λ := fun c hc =>
    Finset.mem_image_of_mem _ (hfinite.mem_toFinset.2 hc)
  have hgen : ∀ s, s ∉ Λ → IsRealGeneric i (w s) := by
    intro s hs c hc
    rw [hew c hc]
    exact mul_ne_zero (hνgen c hc) (sub_ne_zero.2 fun h => hs (h ▸ hmemΛ c hc))
  have hchain : ∀ s s', s < s' → s ∉ Λ → s' ∉ Λ →
      D.exchangeSet x H (w s) = D.exchangeSet x H (w s') := by
    intro s s' hss' hs hs'
    refine eq_of_forall_single_crossing Λ (fun s => D.exchangeSet x H (w s)) ?_ hss' hs hs'
    intro s s' hss' hs hs' hsingle
    refine exchangeSet_eq hT hfinite hsys hderiv hneg hex (hgen s hs)
      (hgen s' hs') ?_
    intro c hc d hd hcD hdD
    rw [hew c hc, hew c hc] at hcD
    rw [hew d hd, hew d hd] at hdD
    exact hlam c hc d hd (hsingle _ (hmemΛ c hc) _ (hmemΛ d hd)
      (mem_Ioo_of_mul_neg (hνgen c hc) hss' hcD) (mem_Ioo_of_mul_neg (hνgen d hd) hss' hdD))
  -- the end points
  obtain ⟨B, hBpos, hB⟩ : ∃ B : ℝ, 0 < B ∧ ∀ c ∈ relativeRoots i, |lam c| < B := by
    obtain ⟨B, hB⟩ := (hfinite.image (fun c => |lam c|)).bddAbove
    refine ⟨max B 0 + 1, by positivity, fun c hc => ?_⟩
    have := hB ⟨c, hc, rfl⟩
    have := le_max_left B 0
    linarith
  have hnotΛ : ∀ s, (∀ c ∈ relativeRoots i, lam c ≠ s) → s ∉ Λ := by
    intro s hs h
    obtain ⟨c, hc, hcl⟩ := Finset.mem_image.1 h
    exact hs c (hfinite.mem_toFinset.1 hc) hcl
  have hB₀ : -B ∉ Λ := hnotΛ _ fun c hc h => by
    have := (abs_lt.1 (hB c hc)).1
    linarith
  have hB₁ : B ∉ Λ := hnotΛ _ fun c hc h => by
    have := (abs_lt.1 (hB c hc)).2
    linarith
  have e1 : D.exchangeSet x H ν = D.exchangeSet x H (w (-B)) := by
    refine exchangeSet_eq hT hfinite hsys hderiv hneg hex hνgen (hgen _ hB₀)
      (isRayCrossing_of_forall_pos fun c hc => ?_)
    rw [hew c hc]
    have h1 := hνgen c hc
    have h2 : 0 < lam c - -B := by linarith [(abs_lt.1 (hB c hc)).1]
    have : eval S c ν * (eval S c ν * (lam c - -B)) = eval S c ν ^ 2 * (lam c - -B) := by ring
    rw [this]
    positivity
  have e3 : D.exchangeSet x H (w B) = D.exchangeSet x H (-ν) := by
    refine exchangeSet_eq hT hfinite hsys hderiv hneg hex (hgen _ hB₁)
      hνgen.neg (isRayCrossing_of_forall_pos fun c hc => ?_)
    rw [hew c hc, map_neg]
    have h1 := hνgen c hc
    have h2 : 0 < B - lam c := by linarith [(abs_lt.1 (hB c hc)).2]
    have : eval S c ν * (lam c - B) * -eval S c ν = eval S c ν ^ 2 * (B - lam c) := by ring
    rw [this]
    positivity
  exact e1.trans ((hchain (-B) B (by linarith) hB₀ hB₁).trans e3)

theorem mul_mem_exchangeSet (x : D.Apartment) (H : Subgroup (rationalPoints G)) {w : V S}
    {g y : rationalPoints G} (hg : g ∈ D.rootSpan x (realPositiveRoots i (-w)))
    (hy : y ∈ D.exchangeSet x H w) : g * y ∈ D.exchangeSet x H w := by
  obtain ⟨_, ⟨a, ha, b, hb, rfl⟩, h, hh, rfl⟩ := hy
  rw [show g * (a * b * h) = g * a * b * h by group]
  exact Set.mul_mem_mul (Set.mul_mem_mul (Subgroup.mul_mem _ hg ha) hb) hh

/-- **Exchange at an arbitrary point.** If every rank-one exchange
`U_{-c,x,0} U_{c,x,0} ⊆ U_{c,x,0} U_{-c,x,0} H` holds with a subgroup `H`, then
`G(k)^♯_x ⊆ X_x(Φ_{-mu}) X_x(Φ_mu) H` for every generic cocharacter `mu`. -/
theorem sharpFixer_subset_mul_of_exchange (hT : IsSplitTorus S.toGrp)
    (hfinite : (relativeRoots i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    {x : D.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (D.filtration x (-c) 0 : Set (rationalPoints G)) *
      D.filtration x c 0 ⊆ (D.filtration x c 0 : Set (rationalPoints G)) *
        D.filtration x (-c) 0 * H)
    (mu : cocharacterLattice S) (hmu : IsGenericCocharacter i mu) :
    (D.sharpFixer {x} : Set (rationalPoints G)) ⊆
      ((⨆ b : positiveRelativeRoots i (-mu), D.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots i mu, D.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        (H : Set (rationalPoints G)) := by
  set ν : V S := (1 : ℝ) ⊗ₜ[ℤ] mu with hν
  have hνgen : IsRealGeneric i ν := fun c hc => by
    rw [hν, eval_tmul, one_mul]
    exact_mod_cast hmu c hc
  have hpos : realPositiveRoots i ν = positiveRelativeRoots i mu := by
    ext c
    simp only [hν, realPositiveRoots, positiveRelativeRoots, Set.mem_ofPred_eq, eval_tmul,
      one_mul, Int.cast_pos]
  have hnegpos : realPositiveRoots i (-ν) = positiveRelativeRoots i (-mu) := by
    ext c
    simp only [hν, realPositiveRoots, positiveRelativeRoots, Set.mem_ofPred_eq, map_neg,
      eval_tmul, one_mul, neg_pos]
    constructor
    · rintro ⟨hc, h⟩
      exact ⟨hc, by exact_mod_cast h⟩
    · rintro ⟨hc, h⟩
      exact ⟨hc, by exact_mod_cast h⟩
  have hY : D.exchangeSet x H ν =
      ((⨆ b : positiveRelativeRoots i (-mu), D.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots i mu, D.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        (H : Set (rationalPoints G)) := by
    unfold exchangeSet rootSpan
    rw [hnegpos, hpos]
    rfl
  rw [← hY]
  have hYeq := exchangeSet_tmul_eq_neg hT hfinite hsys hderiv hneg hex hmu
  rw [← hν] at hYeq
  have hstab : ∀ α ∈ relativeRoots i, ∀ g ∈ D.filtration x α 0, ∀ y ∈ D.exchangeSet x H ν,
      g * y ∈ D.exchangeSet x H ν := by
    intro α hα g hg y hy
    rcases lt_or_gt_of_ne (hνgen α hα) with hlt | hgt
    · exact mul_mem_exchangeSet x H (filtration_le_rootSpan x
        (⟨hα, by rw [map_neg]; linarith⟩ : α ∈ realPositiveRoots i (-ν)) hg) hy
    · rw [hYeq] at hy ⊢
      exact mul_mem_exchangeSet x H (filtration_le_rootSpan x
        (⟨hα, by rw [neg_neg]; exact hgt⟩ : α ∈ realPositiveRoots i (-(-ν))) hg) hy
  let K : Subgroup (rationalPoints G) :=
    { carrier := {g | ∀ y ∈ D.exchangeSet x H ν,
        g * y ∈ D.exchangeSet x H ν ∧ g⁻¹ * y ∈ D.exchangeSet x H ν}
      mul_mem' := fun {a b} ha hb y hy => by
        refine ⟨?_, ?_⟩
        · rw [mul_assoc]
          exact (ha _ (hb y hy).1).1
        · rw [mul_inv_rev, mul_assoc]
          exact (hb _ (ha y hy).2).2
      one_mem' := fun y hy => by simpa only [one_mul, inv_one, and_self] using hy
      inv_mem' := fun {a} ha y hy => by
        refine ⟨(ha y hy).2, ?_⟩
        rw [inv_inv]
        exact (ha y hy).1 }
  have hK : D.sharpFixer {x} ≤ K := by
    refine iSup_le fun α => ?_
    rw [D.rootFixer_singleton]
    intro g hg y hy
    exact ⟨hstab α α.2 g hg y hy, hstab α α.2 g⁻¹ (Subgroup.inv_mem _ hg) y hy⟩
  intro g hg
  have h1 : (1 : rationalPoints G) ∈ D.exchangeSet x H ν :=
    ⟨1, ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, mul_one 1⟩, 1, Subgroup.one_mem _,
      mul_one 1⟩
  have := (hK hg 1 h1).1
  rwa [mul_one] at this

/-- **The sharp fixer of a chamber point is `X_x(Φ_{-mu}) X_x(Φ_mu) Z(k)^♯_x`.** -/
theorem sharpFixer_subset_mul_of_mem_chamber (hT : IsSplitTorus S.toGrp)
    (hfinite : (relativeRoots i).Finite)
    (hspan : Submodule.span ℚ
      (toRat '' (relativeRoots i ∪ Set.range (torusCharacterRestrict i))) = ⊤)
    (hrank : RelativeRoot.HasRankOneFactorization i)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i))
    (hAS4 : ∀ ψ ∈ D.extendedAffineRoots,
      ψ ∈ D.affineRoots ∨ (2 : ℝ) • ψ ∈ D.affineRoots)
    {C : Set D.Apartment} (hC : AffineRootSystem.IsChamber D.affineRoots C)
    {x : D.Apartment} (hx : x ∈ C) (mu : cocharacterLattice S)
    (hmu : IsGenericCocharacter i mu) :
    (D.sharpFixer {x} : Set (rationalPoints G)) ⊆
      ((⨆ b : positiveRelativeRoots i (-mu), D.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots i mu, D.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        (D.sharpCentralizer {x} : Set (rationalPoints G)) := by
  have hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i := fun c hc =>
    neg_mem_relativeRoots_of_rankOne hT hrank x hc
  exact sharpFixer_subset_mul_of_exchange hT hfinite hsys hderiv hneg
    (fun c hc => filtration_neg_mul_filtration_subset hT hfinite hspan hrank hAS4 hC hx hc
      (hneg c hc)) mu hmu

end KPApartmentData

/-- For apartment data over a split torus with finitely many relative roots, spanning roots
and characters, opposite factor pairs, a rank-zero affine root system with derivative roots
the relative roots, and AS 4: at every point `x` of a chamber and for every generic
cocharacter `mu`, `G(k)^♯_x ⊆ X_x(Φ_{-mu}) X_x(Φ_mu) Z(k)^♯_x`, where
`X_x(P) = ⨆_{b ∈ P} U_{b,x,0}`. -/
def ChamberSharpExchangeStatement : Prop :=
  ∀ (k : Type u) [Field k] (S : CommGroupScheme (Spec (CommRingCat.of k)))
    (G : GroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G) [Mono i.hom.hom.left]
    [IsAffineHom G.X.hom] (ω : kˣ → ℝ) (D : KPApartmentData i ω),
    IsSplitTorus S.toGrp → (relativeRoots i).Finite →
    Submodule.span ℚ (toRat '' (relativeRoots i ∪ Set.range (torusCharacterRestrict i))) = ⊤ →
    RelativeRoot.HasRankOneFactorization i →
    AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots →
    AffineRootSystem.derivativeRoots D.extendedAffineRoots = Set.range (rootForm i) →
    (∀ ψ ∈ D.extendedAffineRoots, ψ ∈ D.affineRoots ∨ (2 : ℝ) • ψ ∈ D.affineRoots) →
    ∀ (C : Set D.Apartment) (x : D.Apartment) (mu : cocharacterLattice S),
      AffineRootSystem.IsChamber D.affineRoots C → x ∈ C → IsGenericCocharacter i mu →
      (D.sharpFixer {x} : Set (rationalPoints G)) ⊆
        ((⨆ b : positiveRelativeRoots i (-mu), D.chamberRootGroup x false b :
            Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
          ((⨆ b : positiveRelativeRoots i mu, D.chamberRootGroup x false b :
            Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
          (D.sharpCentralizer {x} : Set (rationalPoints G))

theorem chamberSharpExchange : ChamberSharpExchangeStatement.{u} := by
  intro k _ S G i _ _ ω D hT hfinite hspan hrank hsys hderiv hAS4 C x mu hC hx hmu
  exact KPApartmentData.sharpFixer_subset_mul_of_mem_chamber hT hfinite hspan hrank hsys
    hderiv hAS4 hC hx mu hmu

end Langlands.Geometry.Building
