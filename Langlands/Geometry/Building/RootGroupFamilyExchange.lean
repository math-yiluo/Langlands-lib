import Langlands.Geometry.Building.ChamberExchange

/-!
# Exchange of opposite products for a family of root subgroups

`ChamberExchange` proves, at a point `x` of the apartment, the inclusion
`G(k)^♯_x ⊆ X_x(Φ_{-mu}) X_x(Φ_mu) H` from rank-one exchanges, where `X_x(P)` is generated by
the `U_{b,x,0}` for `b ∈ P`. The argument uses only three properties of the family
`b ↦ U_{b,x,0}`: the commutator relations (V 3), `U_{2b,x,0} ⊆ U_{b,x,0}`, and the rank-one
exchanges. This file repeats the argument for an arbitrary family
`U : characterLattice S → Subgroup G(k)` with these three properties, so that it applies to the
root fixers `U_{b,Ω,0}` of a finite set `Ω`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise commutatorElement
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

namespace RootGroupFamily

variable {k : Type u} [Field k] {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom] {i : S.toGrp ⟶ G}

/-- `X_U(P) = ⨆_{b ∈ P} U b`. -/
def span (U : characterLattice S → Subgroup (rationalPoints G)) (P : Set (characterLattice S)) :
    Subgroup (rationalPoints G) :=
  ⨆ b : P, U b

variable (i) in
/-- `Y_U(H, w) = X_U(Φ_{-w}) X_U(Φ_w) H` for a subgroup `H` and a real vector `w`. -/
def exchangeSet (U : characterLattice S → Subgroup (rationalPoints G))
    (H : Subgroup (rationalPoints G)) (w : V S) : Set (rationalPoints G) :=
  (span U (realPositiveRoots i (-w)) : Set (rationalPoints G)) *
    span U (realPositiveRoots i w) * H

variable (i) in
/-- The commutator relations (V 3) for a family of subgroups indexed by characters: the
commutator of `U c` and `U b` for non-opposite roots lies in the subgroup generated by the
`U (p c + q b)`, `p, q > 0`. -/
def HasCommutatorRelations (U : characterLattice S → Subgroup (rationalPoints G)) : Prop :=
  ∀ ⦃c b : characterLattice S⦄, c ∈ relativeRoots i → b ∈ relativeRoots i →
    (∀ t : ℝ, 0 < t → ((1 : ℝ) ⊗ₜ[ℤ] b : Vstar S) ≠ -(t • (1 : ℝ) ⊗ₜ[ℤ] c)) →
      ⁅U c, U b⁆ ≤ ⨆ (p : ℕ) (q : ℕ) (_ : 0 < p) (_ : 0 < q)
        (_ : p • c + q • b ∈ relativeRoots i), U (p • c + q • b)

variable (i) in
/-- Proportional relative roots with a positive ratio are equal or differ by a factor two. -/
def HasRayProperty : Prop :=
  ∀ ⦃c d : characterLattice S⦄, c ∈ relativeRoots i → d ∈ relativeRoots i →
    ∀ ⦃t : ℝ⦄, 0 < t → eval S d = t • eval S c → d = c ∨ d = 2 • c ∨ c = 2 • d

variable {U : characterLattice S → Subgroup (rationalPoints G)}

omit [IsAffineHom G.X.hom] in

theorem le_span {P : Set (characterLattice S)} {b : characterLattice S} (hb : b ∈ P) :
    U b ≤ span U P :=
  le_iSup_of_le (⟨b, hb⟩ : P) le_rfl

omit [IsAffineHom G.X.hom] in
theorem span_mono {P Q : Set (characterLattice S)} (h : P ⊆ Q) : span U P ≤ span U Q :=
  iSup_le fun b => le_span (h b.2)

omit [IsAffineHom G.X.hom] in
theorem span_le_sup {P Q₁ Q₂ : Set (characterLattice S)} (h : P ⊆ Q₁ ∪ Q₂) :
    span U P ≤ span U Q₁ ⊔ span U Q₂ :=
  iSup_le fun b => (h b.2).elim (fun h1 => le_sup_of_le_left (le_span h1))
    (fun h2 => le_sup_of_le_right (le_span h2))

omit [IsAffineHom G.X.hom] in
theorem span_eq_bot {P : Set (characterLattice S)} (h : P = ∅) : span U P = ⊥ := by
  subst h
  exact le_bot_iff.1 (iSup_le fun b => absurd b.2 (Set.notMem_empty _))

/-- A root subgroup of a separating root normalizes the span of the roots positive on both
vectors (V 3). -/
theorem le_normalizer_span (hcomm : HasCommutatorRelations i U) {w w' : V S}
    (hw : IsRealGeneric i w) (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w')
    {c : characterLattice S} (hc : c ∈ relativeRoots i)
    (hcD : eval S c w * eval S c w' < 0) :
    U c ≤ Subgroup.normalizer
      ((span U (realPositiveRoots i w ∩ realPositiveRoots i w') :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
  refine le_normalizer_iSup_of_commutator_le fun b => ?_
  obtain ⟨⟨hb, hbw⟩, -, hbw'⟩ := b.2
  refine (hcomm hc hb (tmul_ne_neg_smul_of_crossing hcD hbw hbw')).trans ?_
  refine iSup_le fun p => iSup_le fun q => iSup_le fun hp => iSup_le fun hq =>
    iSup_le fun he => ?_
  obtain ⟨h1, h2⟩ := combination_pos_of_crossing hw hw' hcross hc hcD hbw hbw' hp hq he
  exact le_span ⟨⟨he, h1⟩, he, h2⟩

theorem span_le_normalizer_span (hcomm : HasCommutatorRelations i U) {w w' : V S}
    (hw : IsRealGeneric i w) (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w')
    {P : Set (characterLattice S)}
    (hP : ∀ c ∈ P, c ∈ relativeRoots i ∧ eval S c w * eval S c w' < 0) :
    span U P ≤ Subgroup.normalizer
      ((span U (realPositiveRoots i w ∩ realPositiveRoots i w') :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) :=
  iSup_le fun c => le_normalizer_span hcomm hw hw' hcross (hP c c.2).1 (hP c c.2).2

/-- The rank-one step: the roots positive on `w` and negative on `w′` form one ray
`{c₁, 2c₁}`, and the rank-one exchange swaps its root subgroup with the opposite one. -/
theorem span_cross_mul_subset (hfinite : (relativeRoots i).Finite)
    (hray : HasRayProperty i)
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    (hdouble : ∀ c ∈ relativeRoots i, 2 • c ∈ relativeRoots i → U (2 • c) ≤ U c)
    {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (U (-c) : Set (rationalPoints G)) * U c ⊆
      (U c : Set (rationalPoints G)) * U (-c) * H)
    {w w' : V S} (hcross : IsRayCrossing i w w') :
    (span U (realPositiveRoots i (-w) ∩ realPositiveRoots i w') :
        Set (rationalPoints G)) *
      span U (realPositiveRoots i w ∩ realPositiveRoots i (-w')) *
        (H : Set (rationalPoints G)) ⊆
      (span U (realPositiveRoots i w ∩ realPositiveRoots i (-w')) :
          Set (rationalPoints G)) *
        span U (realPositiveRoots i (-w) ∩ realPositiveRoots i w') * H := by
  have mem₁ : ∀ c, c ∈ realPositiveRoots i w ∩ realPositiveRoots i (-w') ↔
      c ∈ relativeRoots i ∧ 0 < eval S c w ∧ eval S c w' < 0 := by
    intro c
    simp only [realPositiveRoots, Set.mem_inter_iff, Set.mem_ofPred_eq, map_neg, neg_pos]
    tauto
  have mem₂ : ∀ c, c ∈ realPositiveRoots i (-w) ∩ realPositiveRoots i w' ↔
      c ∈ relativeRoots i ∧ eval S c w < 0 ∧ 0 < eval S c w' := by
    intro c
    simp only [realPositiveRoots, Set.mem_inter_iff, Set.mem_ofPred_eq, map_neg, neg_pos]
    tauto
  by_cases hne : (realPositiveRoots i w ∩ realPositiveRoots i (-w')).Nonempty
  · obtain ⟨c₁, hc₁, hmin⟩ := Set.exists_min_image _ (fun c => eval S c w)
      (hfinite.subset fun c hc => ((mem₁ c).1 hc).1) hne
    obtain ⟨hc₁Φ, hc₁w, hc₁w'⟩ := (mem₁ c₁).1 hc₁
    have hray' : ∀ d ∈ realPositiveRoots i w ∩ realPositiveRoots i (-w'),
        d = c₁ ∨ d = 2 • c₁ := by
      intro d hd
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₁ d).1 hd
      obtain ⟨t, ht⟩ := hcross c₁ hc₁Φ d hdΦ (mul_neg_of_pos_of_neg hc₁w hc₁w')
        (mul_neg_of_pos_of_neg hdw hdw')
      have htw : eval S d w = t * eval S c₁ w := by rw [ht]; rfl
      have htpos : 0 < t := by
        by_contra hcon
        push Not at hcon
        nlinarith
      rcases hray hc₁Φ hdΦ htpos ht with h | h | h
      · exact Or.inl h
      · exact Or.inr h
      · exfalso
        have hm := hmin d hd
        rw [h, eval_nsmul_char] at hm
        push_cast at hm
        linarith
    have hc₁D₂ : -c₁ ∈ realPositiveRoots i (-w) ∩ realPositiveRoots i w' :=
      (mem₂ _).2 ⟨hneg c₁ hc₁Φ, by rw [eval_neg_char]; linarith,
        by rw [eval_neg_char]; linarith⟩
    have hU₁ : span U (realPositiveRoots i w ∩ realPositiveRoots i (-w')) = U c₁ := by
      refine le_antisymm (iSup_le fun d => ?_) (le_span hc₁)
      rcases hray' d d.2 with h | h
      · exact le_of_eq (congrArg U h)
      · rw [h]
        exact hdouble c₁ hc₁Φ (h ▸ ((mem₁ d).1 d.2).1)
    have hU₂ : span U (realPositiveRoots i (-w) ∩ realPositiveRoots i w') = U (-c₁) := by
      refine le_antisymm (iSup_le fun d => ?_) (le_span hc₁D₂)
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₂ d).1 d.2
      have hnd : -(d : characterLattice S) ∈
          realPositiveRoots i w ∩ realPositiveRoots i (-w') :=
        (mem₁ _).2 ⟨hneg _ hdΦ, by rw [eval_neg_char]; linarith,
          by rw [eval_neg_char]; linarith⟩
      rcases hray' _ hnd with h | h
      · have hd' : (d : characterLattice S) = -c₁ := by rw [← h, neg_neg]
        exact le_of_eq (congrArg U hd')
      · have hd' : (d : characterLattice S) = 2 • -c₁ := by rw [smul_neg, ← h, neg_neg]
        rw [hd']
        exact hdouble (-c₁) (hneg c₁ hc₁Φ) (hd' ▸ hdΦ)
    rw [hU₁, hU₂]
    calc (U (-c₁) : Set (rationalPoints G)) * U c₁ * H
        ⊆ (U c₁ : Set (rationalPoints G)) * U (-c₁) * H * H :=
          Set.mul_subset_mul_right (hex c₁ hc₁Φ)
      _ = (U c₁ : Set (rationalPoints G)) * U (-c₁) * H := by
          rw [mul_assoc _ (H : Set (rationalPoints G)), coe_mul_coe]
  · have h₁ : realPositiveRoots i w ∩ realPositiveRoots i (-w') = ∅ :=
      Set.not_nonempty_iff_eq_empty.1 hne
    have h₂ : realPositiveRoots i (-w) ∩ realPositiveRoots i w' = ∅ := by
      refine Set.eq_empty_of_forall_notMem fun d hd => hne ⟨-d, ?_⟩
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₂ d).1 hd
      exact (mem₁ _).2 ⟨hneg _ hdΦ, by rw [eval_neg_char]; linarith,
        by rw [eval_neg_char]; linarith⟩
    rw [span_eq_bot h₁, span_eq_bot h₂]

/-- **Exchange across one ray.** If the relative roots separating two generic real vectors
`w, w′` are pairwise proportional, then `Y_U(H, w) ⊆ Y_U(H, w′)`. -/
theorem exchangeSet_subset (hcomm : HasCommutatorRelations i U)
    (hfinite : (relativeRoots i).Finite)
    (hray : HasRayProperty i)
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    (hdouble : ∀ c ∈ relativeRoots i, 2 • c ∈ relativeRoots i → U (2 • c) ≤ U c)
    {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (U (-c) : Set (rationalPoints G)) * U c ⊆
      (U c : Set (rationalPoints G)) * U (-c) * H)
    {w w' : V S} (hw : IsRealGeneric i w)
    (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w') :
    exchangeSet i U H w ⊆ exchangeSet i U H w' := by
  set R := realPositiveRoots i w ∩ realPositiveRoots i w' with hR
  set Rn := realPositiveRoots i (-w) ∩ realPositiveRoots i (-w') with hRn
  set D₁ := realPositiveRoots i w ∩ realPositiveRoots i (-w') with hD₁
  set D₂ := realPositiveRoots i (-w) ∩ realPositiveRoots i w' with hD₂
  have sep₁ : ∀ c ∈ D₁, c ∈ relativeRoots i ∧ eval S c w * eval S c w' < 0 := by
    intro c hc
    obtain ⟨⟨hcΦ, hcw⟩, -, hcw'⟩ := hc
    rw [map_neg] at hcw'
    exact ⟨hcΦ, mul_neg_of_pos_of_neg hcw (neg_pos.1 hcw')⟩
  have sep₂ : ∀ c ∈ D₂, c ∈ relativeRoots i ∧ eval S c w * eval S c w' < 0 := by
    intro c hc
    obtain ⟨⟨hcΦ, hcw⟩, -, hcw'⟩ := hc
    rw [map_neg] at hcw
    exact ⟨hcΦ, mul_neg_of_neg_of_pos (neg_pos.1 hcw) hcw'⟩
  have sep₂n : ∀ c ∈ D₂, c ∈ relativeRoots i ∧ eval S c (-w) * eval S c (-w') < 0 := by
    intro c hc
    rw [map_neg, map_neg, neg_mul_neg]
    exact sep₂ c hc
  have N1 : span U D₂ ≤ Subgroup.normalizer (span U Rn : Set (rationalPoints G)) :=
    span_le_normalizer_span hcomm hw.neg hw'.neg hcross.neg sep₂n
  have N2 : span U D₂ ≤ Subgroup.normalizer (span U R : Set (rationalPoints G)) :=
    span_le_normalizer_span hcomm hw hw' hcross sep₂
  have N3 : span U D₁ ≤ Subgroup.normalizer (span U R : Set (rationalPoints G)) :=
    span_le_normalizer_span hcomm hw hw' hcross sep₁
  have hcov₁ : realPositiveRoots i (-w) ⊆ Rn ∪ D₂ := by
    intro c hc
    rcases lt_or_gt_of_ne (hw' c hc.1) with h | h
    · left
      exact ⟨hc, hc.1, by rw [map_neg]; linarith⟩
    · right
      exact ⟨hc, hc.1, h⟩
  have hcov₂ : realPositiveRoots i w ⊆ R ∪ D₁ := by
    intro c hc
    rcases lt_or_gt_of_ne (hw' c hc.1) with h | h
    · right
      exact ⟨hc, hc.1, by rw [map_neg]; linarith⟩
    · left
      exact ⟨hc, hc.1, h⟩
  have hPn : (span U (realPositiveRoots i (-w)) : Set (rationalPoints G)) ⊆
      (span U Rn : Set (rationalPoints G)) * span U D₂ := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N1]
    exact span_le_sup hcov₁
  have hP : (span U (realPositiveRoots i w) : Set (rationalPoints G)) ⊆
      (span U R : Set (rationalPoints G)) * span U D₁ := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N3]
    exact span_le_sup hcov₂
  have hcomm₂ : (span U D₂ : Set (rationalPoints G)) * span U R =
      (span U R : Set (rationalPoints G)) * span U D₂ := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ N2,
      ← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N2, sup_comm]
  have hcomm₁ : (span U R : Set (rationalPoints G)) * span U D₁ =
      (span U D₁ : Set (rationalPoints G)) * span U R := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ N3,
      ← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N3, sup_comm]
  have hQn : (span U Rn : Set (rationalPoints G)) * span U D₁ ⊆
      span U (realPositiveRoots i (-w')) :=
    Set.mul_subset_iff.2 fun a ha b hb => Subgroup.mul_mem _
      (span_mono Set.inter_subset_right ha) (span_mono Set.inter_subset_right hb)
  have hQ : (span U R : Set (rationalPoints G)) * span U D₂ ⊆
      span U (realPositiveRoots i w') :=
    Set.mul_subset_iff.2 fun a ha b hb => Subgroup.mul_mem _
      (span_mono Set.inter_subset_right ha) (span_mono Set.inter_subset_right hb)
  have hex₀ := span_cross_mul_subset hfinite hray hneg hdouble hex hcross
  unfold exchangeSet
  set XR : Set (rationalPoints G) := (span U R : Set (rationalPoints G))
  set XRn : Set (rationalPoints G) := (span U Rn : Set (rationalPoints G))
  set X₁ : Set (rationalPoints G) := (span U D₁ : Set (rationalPoints G))
  set X₂ : Set (rationalPoints G) := (span U D₂ : Set (rationalPoints G))
  set Hs : Set (rationalPoints G) := (H : Set (rationalPoints G))
  calc (span U (realPositiveRoots i (-w)) : Set (rationalPoints G)) *
        span U (realPositiveRoots i w) * Hs
      ⊆ XRn * X₂ * (XR * X₁) * Hs := Set.mul_subset_mul_right (Set.mul_subset_mul hPn hP)
    _ = XRn * XR * (X₂ * X₁ * Hs) := by
        simp only [mul_assoc]
        rw [← mul_assoc X₂ XR, hcomm₂, mul_assoc]
    _ ⊆ XRn * XR * (X₁ * X₂ * Hs) := Set.mul_subset_mul_left hex₀
    _ = XRn * X₁ * (XR * X₂) * Hs := by
        simp only [mul_assoc]
        rw [← mul_assoc XR X₁, hcomm₁, mul_assoc]
    _ ⊆ span U (realPositiveRoots i (-w')) * span U (realPositiveRoots i w') * Hs :=
        Set.mul_subset_mul_right (Set.mul_subset_mul hQn hQ)

theorem exchangeSet_eq (hcomm : HasCommutatorRelations i U)
    (hfinite : (relativeRoots i).Finite)
    (hray : HasRayProperty i)
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    (hdouble : ∀ c ∈ relativeRoots i, 2 • c ∈ relativeRoots i → U (2 • c) ≤ U c)
    {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (U (-c) : Set (rationalPoints G)) * U c ⊆
      (U c : Set (rationalPoints G)) * U (-c) * H)
    {w w' : V S} (hw : IsRealGeneric i w)
    (hw' : IsRealGeneric i w') (hcross : IsRayCrossing i w w') :
    exchangeSet i U H w = exchangeSet i U H w' :=
  Set.Subset.antisymm
    (exchangeSet_subset hcomm hfinite hray hneg hdouble hex hw hw' hcross)
    (exchangeSet_subset hcomm hfinite hray hneg hdouble hex hw' hw hcross.symm)

/-- **Opposite exchange.** For a generic cocharacter `mu`, `Y_U(H, mu) = Y_U(H, -mu)`. -/
theorem exchangeSet_tmul_eq_neg (hcomm : HasCommutatorRelations i U)
    (hfinite : (relativeRoots i).Finite)
    (hray : HasRayProperty i)
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    (hdouble : ∀ c ∈ relativeRoots i, 2 • c ∈ relativeRoots i → U (2 • c) ≤ U c)
    {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (U (-c) : Set (rationalPoints G)) * U c ⊆
      (U c : Set (rationalPoints G)) * U (-c) * H)
    {mu : cocharacterLattice S} (hmu : IsGenericCocharacter i mu) :
    exchangeSet i U H ((1 : ℝ) ⊗ₜ[ℤ] mu) = exchangeSet i U H (-((1 : ℝ) ⊗ₜ[ℤ] mu)) := by
  set ν : V S := (1 : ℝ) ⊗ₜ[ℤ] mu with hν
  have hνgen : IsRealGeneric i ν := fun c hc => by
    rw [hν, eval_tmul, one_mul]
    exact_mod_cast hmu c hc
  have : Finite (relativeRoots i) := hfinite.to_subtype
  let ℓ : relativeRoots i × relativeRoots i → Module.Dual ℝ (V S) := fun p =>
    eval S p.2.1 ν • eval S p.1.1 - eval S p.1.1 ν • eval S p.2.1
  obtain ⟨eta, heta⟩ := Module.Dual.exists_forall_ne_zero_of_forall_exists
    (fun p : {p : relativeRoots i × relativeRoots i // ∃ v, ℓ p v ≠ 0} => ℓ p.1)
    (fun p => p.2)
  let lam : characterLattice S → ℝ := fun c => eval S c eta / eval S c ν
  have hlam : ∀ c ∈ relativeRoots i, ∀ d ∈ relativeRoots i, lam c = lam d →
      ∃ t : ℝ, eval S d = t • eval S c := by
    intro c hc d hd hcd
    have h1 := hνgen c hc
    have h2 := hνgen d hd
    by_cases hex : ∃ v, ℓ (⟨c, hc⟩, ⟨d, hd⟩) v ≠ 0
    · exfalso
      apply heta ⟨(⟨c, hc⟩, ⟨d, hd⟩), hex⟩
      simp only [ℓ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]
      simp only [lam] at hcd
      rw [div_eq_div_iff h1 h2] at hcd
      linarith
    · push Not at hex
      refine ⟨eval S d ν / eval S c ν, LinearMap.ext fun v => ?_⟩
      have hv := hex v
      simp only [ℓ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul, sub_eq_zero] at hv
      rw [LinearMap.smul_apply, smul_eq_mul, div_mul_eq_mul_div, eq_div_iff h1]
      linarith
  let w : ℝ → V S := fun s => eta - s • ν
  have hew : ∀ c ∈ relativeRoots i, ∀ s, eval S c (w s) = eval S c ν * (lam c - s) := by
    intro c hc s
    have h1 := hνgen c hc
    simp only [w, lam, map_sub, map_smul, smul_eq_mul]
    field_simp
  set Λ : Finset ℝ := hfinite.toFinset.image lam with hΛ
  have hmemΛ : ∀ c ∈ relativeRoots i, lam c ∈ Λ := fun c hc =>
    Finset.mem_image_of_mem _ (hfinite.mem_toFinset.2 hc)
  have hgen : ∀ s, s ∉ Λ → IsRealGeneric i (w s) := by
    intro s hs c hc
    rw [hew c hc]
    exact mul_ne_zero (hνgen c hc) (sub_ne_zero.2 fun h => hs (h ▸ hmemΛ c hc))
  have hchain : ∀ s s', s < s' → s ∉ Λ → s' ∉ Λ →
      exchangeSet i U H (w s) = exchangeSet i U H (w s') := by
    intro s s' hss' hs hs'
    refine eq_of_forall_single_crossing Λ (fun s => exchangeSet i U H (w s)) ?_ hss' hs hs'
    intro s s' hss' hs hs' hsingle
    refine exchangeSet_eq hcomm hfinite hray hneg hdouble hex (hgen s hs)
      (hgen s' hs') ?_
    intro c hc d hd hcD hdD
    rw [hew c hc, hew c hc] at hcD
    rw [hew d hd, hew d hd] at hdD
    exact hlam c hc d hd (hsingle _ (hmemΛ c hc) _ (hmemΛ d hd)
      (mem_Ioo_of_mul_neg (hνgen c hc) hss' hcD) (mem_Ioo_of_mul_neg (hνgen d hd) hss' hdD))
  obtain ⟨B, hBpos, hB⟩ : ∃ B : ℝ, 0 < B ∧ ∀ c ∈ relativeRoots i, |lam c| < B := by
    obtain ⟨B, hB⟩ := (hfinite.image (fun c => |lam c|)).bddAbove
    refine ⟨max B 0 + 1, by positivity, fun c hc => ?_⟩
    have := hB ⟨c, hc, rfl⟩
    have := le_max_left B 0
    linarith
  have hnotΛ : ∀ s, (∀ c ∈ relativeRoots i, lam c ≠ s) → s ∉ Λ := by
    intro s hs h
    obtain ⟨c, hc, hcl⟩ := Finset.mem_image.1 h
    exact hs c (hfinite.mem_toFinset.1 hc) hcl
  have hB₀ : -B ∉ Λ := hnotΛ _ fun c hc h => by
    have := (abs_lt.1 (hB c hc)).1
    linarith
  have hB₁ : B ∉ Λ := hnotΛ _ fun c hc h => by
    have := (abs_lt.1 (hB c hc)).2
    linarith
  have e1 : exchangeSet i U H ν = exchangeSet i U H (w (-B)) := by
    refine exchangeSet_eq hcomm hfinite hray hneg hdouble hex hνgen (hgen _ hB₀)
      (isRayCrossing_of_forall_pos fun c hc => ?_)
    rw [hew c hc]
    have h1 := hνgen c hc
    have h2 : 0 < lam c - -B := by linarith [(abs_lt.1 (hB c hc)).1]
    have : eval S c ν * (eval S c ν * (lam c - -B)) = eval S c ν ^ 2 * (lam c - -B) := by ring
    rw [this]
    positivity
  have e3 : exchangeSet i U H (w B) = exchangeSet i U H (-ν) := by
    refine exchangeSet_eq hcomm hfinite hray hneg hdouble hex (hgen _ hB₁)
      hνgen.neg (isRayCrossing_of_forall_pos fun c hc => ?_)
    rw [hew c hc, map_neg]
    have h1 := hνgen c hc
    have h2 : 0 < B - lam c := by linarith [(abs_lt.1 (hB c hc)).2]
    have : eval S c ν * (lam c - B) * -eval S c ν = eval S c ν ^ 2 * (B - lam c) := by ring
    rw [this]
    positivity
  exact e1.trans ((hchain (-B) B (by linarith) hB₀ hB₁).trans e3)

theorem mul_mem_exchangeSet (H : Subgroup (rationalPoints G)) {w : V S}
    {g y : rationalPoints G} (hg : g ∈ span U (realPositiveRoots i (-w)))
    (hy : y ∈ exchangeSet i U H w) : g * y ∈ exchangeSet i U H w := by
  obtain ⟨_, ⟨a, ha, b, hb, rfl⟩, h, hh, rfl⟩ := hy
  rw [show g * (a * b * h) = g * a * b * h by group]
  exact Set.mul_mem_mul (Set.mul_mem_mul (Subgroup.mul_mem _ hg ha) hb) hh

/-- **Exchange for a family of root subgroups.** If the family `U` satisfies the commutator
relations, `U (2c) ⊆ U c`, and the rank-one exchanges `U (-c) U c ⊆ U c U (-c) H`, then the
subgroup generated by all `U a`, `a ∈ Φ`, lies in `X_U(Φ_{-mu}) X_U(Φ_mu) H` for every generic
cocharacter `mu`. -/
theorem iSup_subset_mul_of_exchange (hcomm : HasCommutatorRelations i U)
    (hfinite : (relativeRoots i).Finite)
    (hray : HasRayProperty i)
    (hneg : ∀ c ∈ relativeRoots i, -c ∈ relativeRoots i)
    (hdouble : ∀ c ∈ relativeRoots i, 2 • c ∈ relativeRoots i → U (2 • c) ≤ U c)
    {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots i, (U (-c) : Set (rationalPoints G)) * U c ⊆
      (U c : Set (rationalPoints G)) * U (-c) * H)
    (mu : cocharacterLattice S) (hmu : IsGenericCocharacter i mu) :
    ((⨆ α : relativeRoots i, U α : Subgroup (rationalPoints G)) : Set (rationalPoints G)) ⊆
      ((⨆ b : positiveRelativeRoots i (-mu), U b : Subgroup (rationalPoints G)) :
          Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots i mu, U b : Subgroup (rationalPoints G)) :
          Set (rationalPoints G)) *
        (H : Set (rationalPoints G)) := by
  set ν : V S := (1 : ℝ) ⊗ₜ[ℤ] mu with hν
  have hνgen : IsRealGeneric i ν := fun c hc => by
    rw [hν, eval_tmul, one_mul]
    exact_mod_cast hmu c hc
  have hpos : realPositiveRoots i ν = positiveRelativeRoots i mu := by
    ext c
    simp only [hν, realPositiveRoots, positiveRelativeRoots, Set.mem_ofPred_eq, eval_tmul,
      one_mul, Int.cast_pos]
  have hnegpos : realPositiveRoots i (-ν) = positiveRelativeRoots i (-mu) := by
    ext c
    simp only [hν, realPositiveRoots, positiveRelativeRoots, Set.mem_ofPred_eq, map_neg,
      eval_tmul, one_mul, neg_pos]
    constructor
    · rintro ⟨hc, h⟩
      exact ⟨hc, by exact_mod_cast h⟩
    · rintro ⟨hc, h⟩
      exact ⟨hc, by exact_mod_cast h⟩
  have hY : exchangeSet i U H ν =
      ((⨆ b : positiveRelativeRoots i (-mu), U b : Subgroup (rationalPoints G)) :
          Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots i mu, U b : Subgroup (rationalPoints G)) :
          Set (rationalPoints G)) *
        (H : Set (rationalPoints G)) := by
    unfold exchangeSet span
    rw [hnegpos, hpos]
  rw [← hY]
  have hYeq := exchangeSet_tmul_eq_neg hcomm hfinite hray hneg hdouble hex hmu
  rw [← hν] at hYeq
  have hstab : ∀ α ∈ relativeRoots i, ∀ g ∈ U α, ∀ y ∈ exchangeSet i U H ν,
      g * y ∈ exchangeSet i U H ν := by
    intro α hα g hg y hy
    rcases lt_or_gt_of_ne (hνgen α hα) with hlt | hgt
    · exact mul_mem_exchangeSet H (le_span
        (⟨hα, by rw [map_neg]; linarith⟩ : α ∈ realPositiveRoots i (-ν)) hg) hy
    · rw [hYeq] at hy ⊢
      exact mul_mem_exchangeSet H (le_span
        (⟨hα, by rw [neg_neg]; exact hgt⟩ : α ∈ realPositiveRoots i (-(-ν))) hg) hy
  let K : Subgroup (rationalPoints G) :=
    { carrier := {g | ∀ y ∈ exchangeSet i U H ν,
        g * y ∈ exchangeSet i U H ν ∧ g⁻¹ * y ∈ exchangeSet i U H ν}
      mul_mem' := fun {a b} ha hb y hy => by
        refine ⟨?_, ?_⟩
        · rw [mul_assoc]
          exact (ha _ (hb y hy).1).1
        · rw [mul_inv_rev, mul_assoc]
          exact (hb _ (ha y hy).2).2
      one_mem' := fun y hy => by simpa only [one_mul, inv_one, and_self] using hy
      inv_mem' := fun {a} ha y hy => by
        refine ⟨(ha y hy).2, ?_⟩
        rw [inv_inv]
        exact (ha y hy).1 }
  have hK : (⨆ α : relativeRoots i, U α) ≤ K := by
    refine iSup_le fun α => ?_
    intro g hg y hy
    exact ⟨hstab α α.2 g hg y hy, hstab α α.2 g⁻¹ (Subgroup.inv_mem _ hg) y hy⟩
  intro g hg
  have h1 : (1 : rationalPoints G) ∈ exchangeSet i U H ν :=
    ⟨1, ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, mul_one 1⟩, 1, Subgroup.one_mem _,
      mul_one 1⟩
  have := (hK hg 1 h1).1
  rwa [mul_one] at this

end RootGroupFamily

end Langlands.Geometry.Building
