import Langlands.Geometry.Building.DepthZero.GeneralLinear.Apartment
import Langlands.Geometry.Building.DepthZero.GeneralLinear.Generation
import Langlands.Geometry.Building.ParahoricBuildingAxioms
import Langlands.BruhatTits.IntegralModels.GeneralLinearIwahoriComparison

/-!
# Parahorics at points of the diagonal apartment of `GL_N`

Let `P'` be parahoric building data of `GL_N` over a nonarchimedean local field `F` obtained by
transport (`ParahoricBuildingData.basedTransport`) so that its maximal split torus is the
diagonal torus. For a point `x` of its apartment, with root values `c_{kl}(x)`, the subgroup
`P'.nonnegativeRootSubgroup {x}` (generated by `Z(F)^0` and the groups `U_ψ`, `ψ ∈ Ψ`,
`ψ(x) ≥ 0`) is the subgroup generated by

* the invertible diagonal matrices whose entries have valuation one
  (`diagGL_mem_nonnegativeRootSubgroup`; `Z(F)^0` consists of these,
  `exists_diagGL_of_mem_map_centralizerZero`), and
* the transvections `1 + t E_{kl}` with `t = 0` or `ord t + c_{kl}(x) ≥ 0`
  (`transvectionPoint_mem_nonnegativeRootSubgroup`),

in the sense that it contains them and is contained in every subgroup containing them
(`nonnegativeRootSubgroup_singleton_le`).

If `c_{kl}(x) = y_k − y_l` with integers `y_k`, this subgroup is `d K d⁻¹`, where
`K = GL_N(𝒪_F)` and `d = diag(ϖ^{−y_1}, …, ϖ^{−y_N})`
(`nonnegativeRootSubgroup_singleton_eq_of_intCast_sub`); the inclusion `⊇` uses the generation
of `GL_N(𝒪_F)` by its diagonal and elementary matrices
(`eq_top_of_diagUnit_transvectionUnit_mem`). This is the computation of the hyperspecial
parahoric subgroups of `GL_N` in Kaletha–Prasad, *Bruhat–Tits Theory: A New Approach*, §15.1.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Matrix
open scoped CategoryTheory.MonObj ValuativeRel
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building.GeneralLinearParahoric

open BruhatTits.IntegralModels

variable {F : Type u} [Field F] {N : ℕ}

/-! ### Conjugation by diagonal matrices -/

theorem diagPoint_inv (d : Fin N → Fˣ) :
    (toMatrixGL.symm (diagGL d) :
      rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))⁻¹ =
      toMatrixGL.symm (diagGL d⁻¹) := by
  rw [← map_inv, coe_diagGL_inv]

/-- Diagonal matrices commute. -/
theorem conj_diagPoint_diagPoint (d e : Fin N → Fˣ) :
    MulAut.conj (toMatrixGL.symm (diagGL d) :
      rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))
        (toMatrixGL.symm (diagGL e)) = toMatrixGL.symm (diagGL e) := by
  rw [MulAut.conj_apply]
  apply toMatrixGL.injective
  rw [map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply,
    coe_diagGL_inv, diagGL_mul, diagGL_mul, mul_comm d e, mul_assoc, mul_inv_cancel, mul_one]

/-- `d (1 + t E_{kl}) d⁻¹ = 1 + d_k t d_l⁻¹ E_{kl}`. -/
theorem conj_diagPoint_transvectionPoint (d : Fin N → Fˣ) {k l : Fin N} (hkl : k ≠ l) (t : F) :
    MulAut.conj (toMatrixGL.symm (diagGL d)) (transvectionPoint hkl t) =
      transvectionPoint hkl ((d k : F) * t * ((d l)⁻¹ : Fˣ)) := by
  rw [MulAut.conj_apply]
  apply toMatrixGL.injective
  rw [map_mul, map_mul, map_inv, transvectionPoint, transvectionPoint, MulEquiv.apply_symm_apply,
    MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply, diagGL_conj_transvectionGL]

theorem conj_diagPoint_symm_apply (d : Fin N → Fˣ)
    (g : rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))) :
    (MulAut.conj (toMatrixGL.symm (diagGL d))).symm g =
      MulAut.conj (toMatrixGL.symm (diagGL d⁻¹)) g := by
  rw [MulAut.conj_symm_apply, MulAut.conj_apply, ← diagPoint_inv, inv_inv]

variable [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]

/-! ### Orders, integral units and integral points -/

/-- `ord t ≥ 0` exactly when `t` is integral. -/
theorem localFieldOrder_nonneg_iff (t : Fˣ) : 0 ≤ localFieldOrder F t ↔ (t : F) ∈ 𝒪[F] := by
  rw [← FML.ord_nonneg_iff_mem_integer F, Plancherel.fieldOrderUnits_ord F, WithTop.coe_nonneg,
    localFieldOrder]
  constructor <;> intro h <;> exact_mod_cast h

theorem localFieldOrder_mk0_mul_mul (a b : Fˣ) {t : F} (ht : t ≠ 0)
    (h : (a : F) * t * (b : F) ≠ 0) :
    localFieldOrder F (Units.mk0 ((a : F) * t * (b : F)) h) =
      localFieldOrder F a + localFieldOrder F (Units.mk0 t ht) + localFieldOrder F b := by
  rw [show Units.mk0 ((a : F) * t * (b : F)) h = a * Units.mk0 t ht * b from Units.ext rfl,
    localFieldOrder_mul, localFieldOrder_mul]

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- A unit of `𝒪_F` has valuation one. -/
theorem valuation_algebraMap_unit (u : 𝒪[F]ˣ) :
    ValuativeRel.valuation F (algebraMap 𝒪[F] F u) = 1 :=
  (Valuation.integer.integers _).one_of_isUnit u.isUnit

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- A unit of `F` of valuation one, as a unit of `𝒪_F`. -/
def integralUnit (d : Fˣ) (hd : ValuativeRel.valuation F (d : F) = 1) : 𝒪[F]ˣ where
  val := ⟨d, (Valuation.mem_integer_iff _ _).2 hd.le⟩
  inv := ⟨((d⁻¹ : Fˣ) : F), (Valuation.mem_integer_iff _ _).2
    (by rw [Units.val_inv_eq_inv_val, map_inv₀, hd, inv_one])⟩
  val_inv := Subtype.ext (by simp)
  inv_val := Subtype.ext (by simp)

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem glIntegralInclusion_diagUnit (d : Fin N → 𝒪[F]ˣ) :
    glIntegralInclusion F N (diagUnit d) =
      diagGL fun a => Units.map (algebraMap 𝒪[F] F).toMonoidHom (d a) := by
  ext p q : 2
  rw [Matrix.GeneralLinearGroup.map_apply, coe_diagUnit, coe_diagGL, diagonal_apply,
    diagonal_apply]
  split_ifs <;> simp

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
theorem glIntegralInclusion_transvectionUnit {i j : Fin N} (hij : i ≠ j) (c : 𝒪[F]) :
    glIntegralInclusion F N (transvectionUnit hij c) = transvectionGL hij (c : F) := by
  ext p q : 2
  rw [Matrix.GeneralLinearGroup.map_apply, coe_transvectionUnit, coe_transvectionGL]
  simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
  split_ifs <;> simp <;> rfl

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- A rational point of `GL_N` lies in `GL_N(𝒪_F)` exactly when its matrix is the image of an
invertible matrix over `𝒪_F`. -/
theorem mem_integralPoints_iff
    (g : rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))) :
    g ∈ (GeneralLinear.standardIntegralModel 𝒪[F] F (Fin N)).integralPoints ↔
      ∃ u : GL (Fin N) 𝒪[F], toMatrixGL g = glIntegralInclusion F N u := by
  rw [GeneralLinear.mem_standardIntegralModel_integralPoints_iff 𝒪[F] F g]
  constructor
  · rintro ⟨u, hu⟩
    exact ⟨u, hu.symm⟩
  · rintro ⟨u, hu⟩
    exact ⟨u, hu.symm⟩

/-! ### Linear parts of affine roots -/

section Apartment

variable (A : KPApartmentData (diagTorus F N) (localFieldOrder F))

/-- An affine function `y ↦ c_{kl}(y) + m` has derivative `e_k − e_l`. -/
theorem linear_eq_rootForm_of_apply_eq {k l : Fin N} (hkl : k ≠ l)
    {ψ : A.Apartment →ᵃ[ℝ] ℝ} {m : ℝ} (hψ : ∀ y, ψ y = rootValue A y k l + m) :
    ψ.linear = rootForm _ (rootOf (F := F) hkl) := by
  obtain ⟨x₀⟩ := (inferInstance : Nonempty A.Apartment)
  refine LinearMap.ext fun v => ?_
  have h1 := ψ.map_vadd x₀ v
  rw [hψ, hψ, rootValue_vadd A x₀ v hkl, vadd_eq_add] at h1
  linarith

/-- A transvection `1 + t E_{kl}`, `t ≠ 0`, lies in `U_ψ` when `ψ` has derivative `e_k − e_l`
and `ψ(x) ≤ ord t + c_{kl}(x)`. -/
theorem transvectionPoint_mem_affineRootGroup (x : A.Apartment) {k l : Fin N} (hkl : k ≠ l)
    {t : F} (ht0 : t ≠ 0) {ψ : A.Apartment →ᵃ[ℝ] ℝ}
    (hlin : ψ.linear = rootForm _ (rootOf (F := F) hkl))
    (hle : ψ x ≤ localFieldOrder F (Units.mk0 t ht0) + rootValue A x k l) :
    transvectionPoint hkl t ∈ A.affineRootGroup (rootCharacter k l) ψ := by
  rw [KPApartmentData.mem_affineRootGroup_iff (α := rootOf hkl) hlin x]
  refine ⟨transvectionPoint_mem_rootGroupPoints A hkl t, ?_⟩
  rw [val_transvectionPoint A x hkl ht0]
  exact_mod_cast hle

/-- The root values of a vertex are differences of integers. -/
theorem exists_intCast_sub_of_isVertex (x : A.Apartment)
    (hx : AffineRootSystem.IsVertex A.affineRoots x) :
    ∃ y : Fin N → ℤ, ∀ k l, rootValue A x k l = (y k : ℝ) - y l := by
  rw [isVertex_iff] at hx
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · exact ⟨fun _ => 0, fun k => k.elim0⟩
  choose m hm using hx
  refine ⟨fun k => m k ⟨0, hN⟩, fun k l => ?_⟩
  rw [rootValue_add A x k ⟨0, hN⟩ l, rootValue_swap A x l ⟨0, hN⟩, hm, hm]
  ring

/-- Some point of the apartment has all root values zero. -/
theorem exists_rootValue_eq_zero : ∃ x : A.Apartment, ∀ k l, rootValue A x k l = 0 := by
  obtain ⟨x₀⟩ := (inferInstance : Nonempty A.Apartment)
  obtain ⟨z, hz⟩ := exists_rootValue_eq_sub A x₀
  obtain ⟨w, hw⟩ := exists_eval_coordCharacter (F := F) (-z)
  refine ⟨(Submodule.Quotient.mk w : TranslationSpace (diagTorus F N)) +ᵥ x₀, fun k l => ?_⟩
  rw [rootValue_mk_vadd, hz, hw, hw]
  simp only [Pi.neg_apply]
  ring

end Apartment

/-! ### Generators of the point parahorics -/

section Diagonal

variable (P : ParahoricBuildingData (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))
  (σ : P.S ≅ diagonalSplitTorus F N)
  (f : GeneralLinear.groupScheme (Fin N) (CommRingCat.of F) ≅
    GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))
  (h : P.i ≫ f.hom = CommGroupScheme.groupHom σ.hom ≫ diagTorus F N)

/-- `Z(F)^0` consists of invertible diagonal matrices with entries of valuation one. -/
theorem exists_diagGL_of_mem_map_centralizerZero
    {g : rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))}
    (hg : g ∈ (P.basedTransport σ f h).centralizerZero.map
      (rationalPoints.map (P.basedTransport σ f h).centralizer.j)) :
    ∃ d : Fin N → Fˣ, (∀ a, ValuativeRel.valuation F (d a : F) = 1) ∧
      g = toMatrixGL.symm (diagGL d) := by
  let P' := P.basedTransport σ f h
  obtain ⟨z, hz, rfl⟩ := hg
  have hz1 : z ∈ characterValuationKernel (ValuativeRel.valuation F) P'.centralizer.Z := by
    rw [characterValuationKernel_eq_rationalCommonNormKernel]
    exact P'.zeroDatum.centralizerZero_le_rationalCommonNormKernel hz
  let e := SubgroupFunctor.IsRepresentedBy.isoOfIsRepresentedBy
    isRepresentedBy_torusCentralizer_diagTorus P'.centralizer.isRepresentedBy
  have he : e.hom ≫ P'.centralizer.j = diagTorus F N :=
    SubgroupFunctor.IsRepresentedBy.isoOfIsRepresentedBy_hom_comp _ _
  let t := rationalPoints.map e.inv z
  have ht : t ∈ characterValuationKernel (ValuativeRel.valuation F)
      (diagonalSplitTorus F N).toGrp :=
    map_characterValuationKernel_le _ e.inv ⟨z, hz1, rfl⟩
  have hzt : rationalPoints.map e.hom t = z := by
    show rationalPoints.map e.hom (rationalPoints.map e.inv z) = z
    rw [rationalPoints.map_apply, rationalPoints.map_apply, Category.assoc, ← Grp.comp_hom_hom,
      Iso.inv_hom_id]
    exact Category.comp_id z
  clear_value t
  subst hzt
  rw [characterValuationKernel_eq_rationalCommonNormKernel,
    ← SplitTorusValuation.integralUnitKernel_eq_rationalCommonNormKernel,
    SplitTorusValuation.mem_integralUnitKernel] at ht
  refine ⟨fun a => splitTorus.affinePointsEquiv (ULift.{u} (Fin N))
    (𝟙 (Spec (CommRingCat.of F))) t ⟨a⟩, fun a => (Valuation.mem_unitGroup_iff _ _ _).1 (ht ⟨a⟩),
    ?_⟩
  have hpt : rationalPoints.map P'.centralizer.j (rationalPoints.map e.hom t) =
      rationalPoints.map (diagTorus F N) t := by
    rw [rationalPoints.map_apply, rationalPoints.map_apply, rationalPoints.map_apply,
      Category.assoc, ← Grp.comp_hom_hom, he]
  rw [hpt, ← toMatrixGL_map_diagTorus, MulEquiv.symm_apply_apply]

/-- Every invertible diagonal matrix with entries of valuation one lies in `Z(F)^0`. -/
theorem diagGL_mem_map_centralizerZero (d : Fin N → Fˣ)
    (hd : ∀ a, ValuativeRel.valuation F (d a : F) = 1) :
    toMatrixGL.symm (diagGL d) ∈ (P.basedTransport σ f h).centralizerZero.map
      (rationalPoints.map (P.basedTransport σ f h).centralizer.j) := by
  let P' := P.basedTransport σ f h
  let e := SubgroupFunctor.IsRepresentedBy.isoOfIsRepresentedBy
    isRepresentedBy_torusCentralizer_diagTorus P'.centralizer.isRepresentedBy
  have he : e.hom ≫ P'.centralizer.j = diagTorus F N :=
    SubgroupFunctor.IsRepresentedBy.isoOfIsRepresentedBy_hom_comp _ _
  let t := (splitTorus.affinePointsEquiv (ULift.{u} (Fin N))
    (𝟙 (Spec (CommRingCat.of F)))).symm fun a => d a.down
  have ht : t ∈ characterValuationKernel (ValuativeRel.valuation F)
      (diagonalSplitTorus F N).toGrp := by
    rw [characterValuationKernel_eq_rationalCommonNormKernel,
      ← SplitTorusValuation.integralUnitKernel_eq_rationalCommonNormKernel,
      SplitTorusValuation.mem_integralUnitKernel]
    intro a
    simp only [t, MulEquiv.apply_symm_apply]
    exact (Valuation.mem_unitGroup_iff _ _ _).2 (hd a.down)
  have hz : rationalPoints.map e.hom t ∈ Plancherel.rationalCommonNormKernel P'.centralizer.Z := by
    rw [← characterValuationKernel_eq_rationalCommonNormKernel]
    exact map_characterValuationKernel_le _ e.hom ⟨t, ht, rfl⟩
  refine ⟨_, rationalCommonNormKernel_le_centralizerZero P'.zeroDatum
    (isSplitTorus_centralizer P σ f h) hz, ?_⟩
  have hpt : rationalPoints.map P'.centralizer.j (rationalPoints.map e.hom t) =
      rationalPoints.map (diagTorus F N) t := by
    rw [rationalPoints.map_apply, rationalPoints.map_apply, rationalPoints.map_apply,
      Category.assoc, ← Grp.comp_hom_hom, he]
  change rationalPoints.map P'.centralizer.j (rationalPoints.map e.hom t) = _
  rw [hpt]
  apply toMatrixGL.injective
  rw [MulEquiv.apply_symm_apply, toMatrixGL_map_diagTorus]
  congr 1
  funext a
  simp [t]

/-- The diagonal generators of the point parahoric. -/
theorem diagGL_mem_nonnegativeRootSubgroup (Ω : Set (P.basedTransport σ f h).Apartment)
    (d : Fin N → Fˣ) (hd : ∀ a, ValuativeRel.valuation F (d a : F) = 1) :
    toMatrixGL.symm (diagGL d) ∈ (P.basedTransport σ f h).nonnegativeRootSubgroup Ω :=
  Subgroup.mem_sup_left (diagGL_mem_map_centralizerZero P σ f h d hd)

/-- The transvection generators of the point parahoric: `1 + t E_{kl}` with `t = 0` or
`ord t + c_{kl}(x) ≥ 0`. -/
theorem transvectionPoint_mem_nonnegativeRootSubgroup (x : (P.basedTransport σ f h).Apartment)
    {k l : Fin N} (hkl : k ≠ l) (t : F)
    (ht : ∀ ht0 : t ≠ 0, 0 ≤ localFieldOrder F (Units.mk0 t ht0) +
      rootValue (P.basedTransport σ f h).apartment x k l) :
    transvectionPoint hkl t ∈ (P.basedTransport σ f h).nonnegativeRootSubgroup {x} := by
  let P' := P.basedTransport σ f h
  by_cases ht0 : t = 0
  · rw [ht0, transvectionPoint_zero]
    exact Subgroup.one_mem _
  obtain ⟨ψ, hψ, hψv⟩ := exists_affineRoot_eq P'.apartment hkl ⌈-rootValue P'.apartment x k l⌉
  have hlin := linear_eq_rootForm_of_apply_eq P'.apartment hkl hψv
  have hceil := Int.le_ceil (-rootValue P'.apartment x k l)
  have hΩ : ∀ x' ∈ ({x} : Set P'.Apartment), 0 ≤ ψ x' := by
    intro x' hx'
    rw [Set.mem_singleton_iff] at hx'
    subst hx'
    have h3 := hψv x'
    linarith
  refine Subgroup.mem_sup_right (Subgroup.subset_closure ?_)
  simp only [Set.mem_iUnion]
  refine ⟨rootOf hkl, ψ, hψ, hlin, hΩ,
    transvectionPoint_mem_affineRootGroup P'.apartment x hkl ht0 hlin ?_⟩
  have h1 := ht ht0
  have h2 : (⌈-rootValue P'.apartment x k l⌉ : ℝ) ≤ localFieldOrder F (Units.mk0 t ht0) := by
    rw [localFieldOrder_eq_intCast]
    exact_mod_cast Int.ceil_le.2 (by rw [← localFieldOrder_eq_intCast]; linarith)
  have h3 := hψv x
  linarith

/-- The point parahoric is contained in every subgroup containing its diagonal and
transvection generators. -/
theorem nonnegativeRootSubgroup_singleton_le (x : (P.basedTransport σ f h).Apartment)
    (M : Subgroup (rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))))
    (hdiag : ∀ d : Fin N → Fˣ, (∀ a, ValuativeRel.valuation F (d a : F) = 1) →
      toMatrixGL.symm (diagGL d) ∈ M)
    (htr : ∀ (k l : Fin N) (hkl : k ≠ l) (t : F),
      (∀ ht0 : t ≠ 0, 0 ≤ localFieldOrder F (Units.mk0 t ht0) +
        rootValue (P.basedTransport σ f h).apartment x k l) → transvectionPoint hkl t ∈ M) :
    (P.basedTransport σ f h).nonnegativeRootSubgroup {x} ≤ M := by
  let P' := P.basedTransport σ f h
  refine sup_le ?_ ((Subgroup.closure_le _).2 ?_)
  · rintro _ ⟨z, hz, rfl⟩
    obtain ⟨d, hd, hdz⟩ := exists_diagGL_of_mem_map_centralizerZero P σ f h ⟨z, hz, rfl⟩
    rw [hdz]
    exact hdiag d hd
  · intro u hu
    simp only [Set.mem_iUnion] at hu
    obtain ⟨⟨a, ha⟩, ψ, -, hlin, hΩ, hu⟩ := hu
    obtain ⟨k, l, hkl, rfl⟩ := exists_eq_rootCharacter ha
    have hu' := (KPApartmentData.mem_affineRootGroup_iff hlin x).1 hu
    obtain ⟨t, ht⟩ := exists_eq_transvectionGL_of_mem_rootGroupPoints hkl hu'.1
    have hut : u = transvectionPoint hkl t := by
      rw [transvectionPoint, ← ht, MulEquiv.symm_apply_apply]
    subst hut
    refine htr k l hkl t fun ht0 => ?_
    have h2 := hu'.2
    rw [val_transvectionPoint P'.apartment x hkl ht0] at h2
    exact le_trans (hΩ x (Set.mem_singleton x)) (WithTop.coe_le_coe.1 h2)

/-! ### Vertices -/

/-- The diagonal entries `ϖ^{−y_k}`. -/
def uniformizerDiag (y : Fin N → ℤ) : Fin N → Fˣ :=
  fun k => SplitTorusValuation.uniformizerUnit F ^ (-y k)

omit P σ f h in
theorem localFieldOrder_uniformizerDiag (y : Fin N → ℤ) (k : Fin N) :
    localFieldOrder F (uniformizerDiag (F := F) y k) = -(y k : ℝ) := by
  simp [uniformizerDiag, localFieldOrder, SplitTorusValuation.fieldOrderUnits_uniformizerUnit]

/-- **Hyperspecial point parahorics.** If `c_{kl}(x) = y_k − y_l` with integers `y_k`, the
point parahoric at `x` is `d K d⁻¹` with `K = GL_N(𝒪_F)` and `d = diag(ϖ^{−y_k})`. -/
theorem nonnegativeRootSubgroup_singleton_eq_of_intCast_sub
    (x : (P.basedTransport σ f h).Apartment) (y : Fin N → ℤ)
    (hy : ∀ k l, rootValue (P.basedTransport σ f h).apartment x k l = (y k : ℝ) - y l) :
    (P.basedTransport σ f h).nonnegativeRootSubgroup {x} =
      (GeneralLinear.standardIntegralModel 𝒪[F] F (Fin N)).integralPoints.map
        (MulAut.conj (toMatrixGL.symm (diagGL (uniformizerDiag (F := F) y)))).toMonoidHom := by
  set δ := uniformizerDiag (F := F) y with hδ
  apply le_antisymm
  · apply nonnegativeRootSubgroup_singleton_le P σ f h x
    · intro d hd
      rw [Subgroup.mem_map_equiv, conj_diagPoint_symm_apply, conj_diagPoint_diagPoint,
        mem_integralPoints_iff]
      refine ⟨diagUnit fun a => integralUnit (d a) (hd a), ?_⟩
      rw [MulEquiv.apply_symm_apply, glIntegralInclusion_diagUnit]
      congr 1
    · intro k l hkl t ht
      rw [Subgroup.mem_map_equiv, conj_diagPoint_symm_apply, conj_diagPoint_transvectionPoint,
        mem_integralPoints_iff]
      have hs : ((δ⁻¹ k : Fˣ) : F) * t * (((δ⁻¹ l)⁻¹ : Fˣ) : F) ∈ 𝒪[F] := by
        by_cases ht0 : t = 0
        · simp [ht0]
        · have hs0 : ((δ⁻¹ k : Fˣ) : F) * t * (((δ⁻¹ l)⁻¹ : Fˣ) : F) ≠ 0 := by simp [ht0]
          have h1 := ht ht0
          have h2 := (localFieldOrder_nonneg_iff (Units.mk0 _ hs0)).1 (by
            rw [localFieldOrder_mk0_mul_mul _ _ ht0, Pi.inv_apply, Pi.inv_apply, inv_inv,
              localFieldOrder_inv, hδ, localFieldOrder_uniformizerDiag,
              localFieldOrder_uniformizerDiag]
            rw [hy] at h1
            linarith)
          simpa using h2
      refine ⟨transvectionUnit hkl ⟨_, hs⟩, ?_⟩
      rw [glIntegralInclusion_transvectionUnit, transvectionPoint, MulEquiv.apply_symm_apply]
  · rintro _ ⟨g, hg, rfl⟩
    obtain ⟨u, hu⟩ := (mem_integralPoints_iff g).1 hg
    have hH : ((P.basedTransport σ f h).nonnegativeRootSubgroup {x}).comap
        ((MulAut.conj (toMatrixGL.symm (diagGL δ))).toMonoidHom.comp
          ((toMatrixGL.symm.toMonoidHom).comp (glIntegralInclusion F N))) = ⊤ := by
      apply eq_top_of_diagUnit_transvectionUnit_mem
      · intro d
        rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.comp_apply,
          MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom, glIntegralInclusion_diagUnit,
          conj_diagPoint_diagPoint]
        exact diagGL_mem_nonnegativeRootSubgroup P σ f h _ _ fun a =>
          valuation_algebraMap_unit (d a)
      · intro i j hij c
        rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.comp_apply,
          MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom, glIntegralInclusion_transvectionUnit,
          ← transvectionPoint, conj_diagPoint_transvectionPoint]
        apply transvectionPoint_mem_nonnegativeRootSubgroup
        intro ht0
        have hc0 : (c : F) ≠ 0 := by
          intro hc
          apply ht0
          rw [hc, mul_zero, zero_mul]
        have hc := (localFieldOrder_nonneg_iff (Units.mk0 (c : F) hc0)).2 (by simp)
        rw [localFieldOrder_mk0_mul_mul _ _ hc0, localFieldOrder_inv, hδ,
          localFieldOrder_uniformizerDiag, localFieldOrder_uniformizerDiag, hy]
        linarith
    have hu' : u ∈ ((P.basedTransport σ f h).nonnegativeRootSubgroup {x}).comap
        ((MulAut.conj (toMatrixGL.symm (diagGL δ))).toMonoidHom.comp
          ((toMatrixGL.symm.toMonoidHom).comp (glIntegralInclusion F N))) := by
      rw [hH]
      exact Subgroup.mem_top u
    have hg' : g = toMatrixGL.symm (glIntegralInclusion F N u) := by
      rw [← hu, MulEquiv.symm_apply_apply]
    rw [hg']
    exact hu'

end Diagonal

end Langlands.Geometry.Building.GeneralLinearParahoric
