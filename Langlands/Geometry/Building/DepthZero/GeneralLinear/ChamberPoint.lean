import Langlands.Geometry.Building.DepthZero.GeneralLinear.PointParahoric
import Langlands.Geometry.Building.RootGroupZeroFixer
import Mathlib.Data.Fin.Tuple.Sort

/-!
# Parahorics at chamber points of the diagonal apartment of `GL_N`

Let `P'` be parahoric building data of `GL_N` whose maximal split torus is the diagonal torus
(`ParahoricBuildingData.basedTransport`), and `x` a point of its apartment on no root
hyperplane. Write `c_{kl}(x) = y_k − y_l`. The fractional parts of the `y_k` are distinct.
Let `σ` list the indices in decreasing order of their fractional parts.
With `a_k = ⌊y_k⌋` and `π = σ⁻¹`,
`P'.nonnegativeRootSubgroup {x}` is `(d m) I (d m)⁻¹`, where `I` is the standard Iwahori
subgroup, `d = diag(ϖ^{−a_k})` and `m` is the permutation matrix of `π`
(`nonnegativeRootSubgroup_singleton_eq_of_chamber`, `exists_floor_perm_of_forall_ne_intCast`).
In this matrix convention, `m` sends the `j`-th basis vector to the `π⁻¹(j)`-th.

For general parahoric building data satisfying the apartment axioms and Axiom 4.1.8 (2), the
elements of `G(F)^0` fixing a chamber are those fixing one of its points
(`ParahoricBuildingData.zeroFixer_facet_eq_nonnegativeRootSubgroup_singleton`).

This is the computation of the Iwahori subgroups of `GL_N` (Kaletha–Prasad, *Bruhat–Tits
Theory: A New Approach*, §15.1).
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Matrix
open scoped CategoryTheory.MonObj ValuativeRel
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- The elements of `G(F)^0` fixing the facet of a point `x` on no root hyperplane (a chamber)
are generated by `Z(F)^0` and the `U_ψ` with `ψ(x) ≥ 0`: they fix the chamber pointwise exactly
when they fix `x`. -/
theorem zeroFixer_facet_eq_nonnegativeRootSubgroup_singleton (hP : P.SatisfiesApartmentAxioms)
    (hZ : P.HasZeroFixerGenerators) {x : P.Apartment} (hx : ∀ ψ ∈ P.affineRoots, ψ x ≠ 0) :
    P.zeroFixer (AffineRootSystem.facet P.affineRoots x) = P.nonnegativeRootSubgroup {x} := by
  apply le_antisymm
  · rw [← hZ {x} (Set.singleton_nonempty x) (fun f =>
      ⟨f x, by rintro _ ⟨z, hz, rfl⟩; exact le_of_eq (congrArg f hz)⟩)]
    intro g hg
    refine P.mem_zeroFixer.2 ⟨(P.mem_zeroFixer.1 hg).1, fun z hz => ?_⟩
    rw [Set.mem_singleton_iff.1 hz]
    exact (P.mem_zeroFixer.1 hg).2 x (AffineRootSystem.mem_facet_self _ _)
  · refine le_trans ?_ (P.nonnegativeRootSubgroup_le_zeroFixer hP _)
    refine sup_le_sup_left ((Subgroup.closure_le _).2 fun g hg => Subgroup.subset_closure ?_) _
    simp only [Set.mem_iUnion] at hg ⊢
    obtain ⟨α, ψ, hψ, hlin, hΩ, hg⟩ := hg
    refine ⟨α, ψ, hψ, hlin, fun z hz => ?_, hg⟩
    have hpos : 0 < ψ x := lt_of_le_of_ne (hΩ x (Set.mem_singleton x)) (Ne.symm (hx ψ hψ))
    have hs := (AffineRootSystem.mem_facet.1 hz) ψ hψ
    rw [sign_pos hpos, eq_comm, sign_eq_one_iff] at hs
    exact hs.le

/-- The elements of `G(F)^0` fixing the `g`-translate of a set are the `g`-conjugates of those
fixing the set. -/
theorem pointwiseFixer_smul_image_inf_zeroSubgroup (g : rationalPoints G)
    (Y : Set P.ReducedBuilding) :
    P.pointwiseFixer ((fun z => g • z) '' Y) ⊓ P.zeroSubgroup =
      (P.pointwiseFixer Y ⊓ P.zeroSubgroup).map (MulAut.conj g).toMonoidHom := by
  ext p
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply, Subgroup.mem_inf, Subgroup.mem_inf,
    ValuationBuildingData.pointwiseFixer, ValuationBuildingData.pointwiseFixer,
    KPApartmentData.mem_pointwiseFixer, KPApartmentData.mem_pointwiseFixer,
    Set.forall_mem_image]
  refine and_congr (forall₂_congr fun z _ => ?_) ⟨fun hp => ?_, fun hp => ?_⟩
  · rw [mul_smul, mul_smul, inv_smul_eq_iff]
  · simpa using P.normal_zeroSubgroup.conj_mem p hp g⁻¹
  · have h1 := P.normal_zeroSubgroup.conj_mem _ hp g
    rwa [show g * (g⁻¹ * p * g) * g⁻¹ = p by group] at h1

end ParahoricBuildingData

namespace GeneralLinearParahoric

open BruhatTits.IntegralModels

variable {F : Type u} [Field F] {N : ℕ}

/-! ### Permutation matrices -/

theorem permGL_inv (σ : Equiv.Perm (Fin N)) : (permGL σ : GL (Fin N) F)⁻¹ = permGL σ⁻¹ :=
  Units.ext rfl

/-- `m_σ diag(d) m_σ⁻¹ = diag(d ∘ σ)`. -/
theorem permGL_conj_diagGL (σ : Equiv.Perm (Fin N)) (d : Fin N → Fˣ) :
    permGL σ * diagGL d * (permGL σ)⁻¹ = (diagGL fun k => d (σ k) : GL (Fin N) F) := by
  ext : 1
  change σ.permMatrix F * diagonal (fun k => (d k : F)) * (σ⁻¹).permMatrix F =
    diagonal fun k => (d (σ k) : F)
  rw [Equiv.Perm.permMatrix, Equiv.Perm.permMatrix, PEquiv.toMatrix_toPEquiv_mul,
    PEquiv.mul_toMatrix_toPEquiv]
  ext p q
  have e2 : ∀ y : Fin N, (σ⁻¹).symm y = σ y := fun y => rfl
  simp only [submatrix_apply, id_eq, e2, diagonal_apply, σ.injective.eq_iff]

theorem permPoint_inv (σ : Equiv.Perm (Fin N)) :
    (toMatrixGL.symm (permGL σ) :
      rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))⁻¹ =
      toMatrixGL.symm (permGL σ⁻¹) := by
  rw [← map_inv, permGL_inv]

theorem conj_permPoint_diagPoint (σ : Equiv.Perm (Fin N)) (d : Fin N → Fˣ) :
    MulAut.conj (toMatrixGL.symm (permGL σ) :
      rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))
        (toMatrixGL.symm (diagGL d)) = toMatrixGL.symm (diagGL fun k => d (σ k)) := by
  rw [MulAut.conj_apply]
  apply toMatrixGL.injective
  rw [map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply,
    MulEquiv.apply_symm_apply, permGL_conj_diagGL]

/-- `m_σ (1 + t E_{ab}) m_σ⁻¹ = 1 + t E_{σ⁻¹ a, σ⁻¹ b}`. -/
theorem conj_permPoint_transvectionPoint (σ : Equiv.Perm (Fin N)) {a b : Fin N} (hab : a ≠ b)
    (t : F) :
    MulAut.conj (toMatrixGL.symm (permGL σ)) (transvectionPoint hab t) =
      transvectionPoint (σ⁻¹.injective.ne hab) t := by
  rw [MulAut.conj_apply]
  apply toMatrixGL.injective
  rw [map_mul, map_mul, map_inv, transvectionPoint, transvectionPoint, MulEquiv.apply_symm_apply,
    MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply, permGL_conj_transvectionGL]

theorem conj_permPoint_symm_apply (σ : Equiv.Perm (Fin N))
    (g : rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))) :
    (MulAut.conj (toMatrixGL.symm (permGL σ))).symm g =
      MulAut.conj (toMatrixGL.symm (permGL σ⁻¹)) g := by
  rw [MulAut.conj_symm_apply, MulAut.conj_apply, ← permPoint_inv, inv_inv]

theorem conj_mul_symm_apply {M : Type*} [Group M] (a b g : M) :
    (MulAut.conj (a * b)).symm g = (MulAut.conj b).symm ((MulAut.conj a).symm g) := by
  simp only [MulAut.conj_symm_apply]
  group

theorem perm_apply_inv_self (τ : Equiv.Perm (Fin N)) (x : Fin N) : τ (τ⁻¹ x) = x :=
  τ.apply_symm_apply x

/-! ### The Iwahori subgroup -/

variable [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]

/-- `ord s > 0` exactly when the integral element `s ≠ 0` lies in the maximal ideal. -/
theorem mem_maximalIdeal_iff_localFieldOrder_pos {s : F} (hs : s ∈ 𝒪[F]) (hs0 : s ≠ 0) :
    (⟨s, hs⟩ : 𝒪[F]) ∈ IsLocalRing.maximalIdeal 𝒪[F] ↔
      0 < localFieldOrder F (Units.mk0 s hs0) := by
  rw [FML.mem_maximalIdeal_iff_ord_pos F,
    show ((⟨s, hs⟩ : 𝒪[F]) : F) = ((Units.mk0 s hs0 : Fˣ) : F) from rfl,
    Plancherel.fieldOrderUnits_ord F, localFieldOrder]
  constructor <;> intro h <;> exact_mod_cast h

/-- An invertible diagonal matrix whose entries have valuation one lies in `I`. -/
theorem diagPoint_mem_iwahori (d : Fin N → Fˣ)
    (hd : ∀ a, ValuativeRel.valuation F (d a : F) = 1) :
    toMatrixGL.symm (diagGL d) ∈ generalLinearIwahoriPoints F N := by
  rw [mem_generalLinearIwahoriPoints]
  refine ⟨diagUnit fun a => integralUnit (d a) (hd a), fun i j hji => ?_, ?_⟩
  · rw [coe_diagUnit, diagonal_apply_ne _ hji.ne']
    exact Ideal.zero_mem _
  · rw [MulEquiv.apply_symm_apply, glIntegralInclusion_diagUnit]
    congr 1

/-- A transvection `1 + s E_{ij}` with `s` integral, and `s` in the maximal ideal if `i > j`,
lies in `I`. -/
theorem transvectionPoint_mem_iwahori {i j : Fin N} (hij : i ≠ j) {s : F} (hs : s ∈ 𝒪[F])
    (hm : j < i → (⟨s, hs⟩ : 𝒪[F]) ∈ IsLocalRing.maximalIdeal 𝒪[F]) :
    transvectionPoint hij s ∈ generalLinearIwahoriPoints F N := by
  rw [mem_generalLinearIwahoriPoints]
  refine ⟨transvectionUnit hij ⟨s, hs⟩, fun p q hqp => ?_, ?_⟩
  · rw [coe_transvectionUnit, Matrix.transvection, Matrix.add_apply, one_apply_ne hqp.ne',
      Matrix.single_apply, zero_add]
    split_ifs with h
    · obtain ⟨rfl, rfl⟩ := h
      exact hm hqp
    · exact Ideal.zero_mem _
  · rw [glIntegralInclusion_transvectionUnit, transvectionPoint, MulEquiv.apply_symm_apply]

/-! ### Coordinates of a chamber point -/

/-- Suppose `y_k − y_l` is nonintegral for `k ≠ l`, and let `σ` list the indices in decreasing
order of their fractional parts. With `a_k = ⌊y_k⌋` and `π = σ⁻¹`, the inequality
`n + y_k − y_l ≥ 0` for `n ∈ ℤ` holds exactly when `n ≥ a_l − a_k + [π l < π k]`. -/
theorem exists_floor_perm_of_forall_ne_intCast (y : Fin N → ℝ)
    (hy : ∀ k l, k ≠ l → ∀ m : ℤ, y k - y l ≠ m) :
    ∃ (a : Fin N → ℤ) (π : Equiv.Perm (Fin N)), ∀ k l, k ≠ l → ∀ n : ℤ,
      (0 ≤ (n : ℝ) + (y k - y l) ↔ a l - a k + (if π l < π k then 1 else 0) ≤ n) := by
  have hf : ∀ k l, k ≠ l → Int.fract (y k) ≠ Int.fract (y l) := fun k l hkl h => by
    obtain ⟨z, hz⟩ := Int.fract_eq_fract.1 h
    exact hy k l hkl z hz
  obtain ⟨σ, hmono⟩ : ∃ σ : Equiv.Perm (Fin N), Monotone ((fun k => -Int.fract (y k)) ∘ σ) :=
    ⟨_, Tuple.monotone_sort fun k => -Int.fract (y k)⟩
  refine ⟨fun k => ⌊y k⌋, σ⁻¹, fun k l hkl n => ?_⟩
  show (0 ≤ (n : ℝ) + (y k - y l) ↔ ⌊y l⌋ - ⌊y k⌋ + (if σ⁻¹ l < σ⁻¹ k then 1 else 0) ≤ n)
  have hπ : σ⁻¹ l < σ⁻¹ k ↔ Int.fract (y k) < Int.fract (y l) := by
    constructor
    · intro h
      have h1 := hmono h.le
      simp only [Function.comp_apply, perm_apply_inv_self] at h1
      exact lt_of_le_of_ne (by linarith) (hf k l hkl)
    · intro h
      by_contra hle
      push Not at hle
      have h1 := hmono hle
      simp only [Function.comp_apply, perm_apply_inv_self] at h1
      linarith
  have hyk := Int.floor_add_fract (y k)
  have hyl := Int.floor_add_fract (y l)
  have hk0 := Int.fract_nonneg (y k)
  have hk1 := Int.fract_lt_one (y k)
  have hl0 := Int.fract_nonneg (y l)
  have hl1 := Int.fract_lt_one (y l)
  by_cases hlt : Int.fract (y k) < Int.fract (y l)
  · rw [ite_eq_left_of_eq_true _ _ (eq_true (hπ.2 hlt))]
    constructor
    · intro h
      have h2 : (0 : ℝ) < n + ⌊y k⌋ - ⌊y l⌋ := by linarith
      have h3 : (0 : ℤ) < n + ⌊y k⌋ - ⌊y l⌋ := by exact_mod_cast h2
      omega
    · intro h
      have h2 : ((⌊y l⌋ - ⌊y k⌋ + 1 : ℤ) : ℝ) ≤ n := by exact_mod_cast h
      push_cast at h2
      linarith
  · rw [ite_eq_right_of_eq_false _ _ (eq_false (fun h => hlt (hπ.1 h)))]
    have hgt : Int.fract (y l) < Int.fract (y k) :=
      lt_of_le_of_ne (not_lt.1 hlt) (hf l k (Ne.symm hkl))
    constructor
    · intro h
      have h2 : (-1 : ℝ) < n + ⌊y k⌋ - ⌊y l⌋ := by linarith
      have h3 : (-1 : ℤ) < n + ⌊y k⌋ - ⌊y l⌋ := by exact_mod_cast h2
      omega
    · intro h
      have h2 : ((⌊y l⌋ - ⌊y k⌋ + 0 : ℤ) : ℝ) ≤ n := by exact_mod_cast h
      push_cast at h2
      linarith

/-- Some real coordinates have no integral difference: `y_k = k / (N + 1)`. -/
theorem exists_forall_sub_ne_intCast :
    ∃ y : Fin N → ℝ, ∀ k l, k ≠ l → ∀ m : ℤ, y k - y l ≠ m := by
  refine ⟨fun k => (k : ℕ) / ((N : ℝ) + 1), fun k l hkl m h => ?_⟩
  have hN : (0 : ℝ) < (N : ℝ) + 1 := by positivity
  have h1 : ((k : ℕ) : ℝ) - (l : ℕ) = m * ((N : ℝ) + 1) := by
    field_simp at h
    linarith
  have h2 : ((k : ℕ) : ℤ) - (l : ℕ) = m * ((N : ℤ) + 1) := by exact_mod_cast h1
  have hk := k.isLt
  have hl := l.isLt
  have hkl' : (k : ℕ) ≠ l := fun h' => hkl (Fin.ext h')
  rcases lt_trichotomy m 0 with hm | rfl | hm
  · have h3 : m * ((N : ℤ) + 1) ≤ -1 * ((N : ℤ) + 1) :=
      Int.mul_le_mul_of_nonneg_right (by omega) (by positivity)
    omega
  · omega
  · have h3 : 1 * ((N : ℤ) + 1) ≤ m * ((N : ℤ) + 1) :=
      Int.mul_le_mul_of_nonneg_right (by omega) (by positivity)
    omega

section Apartment

variable (A : KPApartmentData (diagTorus F N) (localFieldOrder F))

/-- Every family of root values `z_k − z_l` is realized by a point of the apartment. -/
theorem exists_rootValue_eq_sub_of (z : Fin N → ℝ) :
    ∃ x : A.Apartment, ∀ k l, rootValue A x k l = z k - z l := by
  obtain ⟨x₀⟩ := (inferInstance : Nonempty A.Apartment)
  obtain ⟨y, hy⟩ := exists_rootValue_eq_sub A x₀
  obtain ⟨w, hw⟩ := exists_eval_coordCharacter (F := F) (z - y)
  refine ⟨(Submodule.Quotient.mk w : TranslationSpace (diagTorus F N)) +ᵥ x₀, fun k l => ?_⟩
  rw [rootValue_mk_vadd, hy, hw, hw]
  simp only [Pi.sub_apply]
  ring

end Apartment

/-! ### Chamber point parahorics -/

section Diagonal

variable (P : ParahoricBuildingData (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))
  (σ : P.S ≅ diagonalSplitTorus F N)
  (f : GeneralLinear.groupScheme (Fin N) (CommRingCat.of F) ≅
    GeneralLinear.groupScheme (Fin N) (CommRingCat.of F))
  (h : P.i ≫ f.hom = CommGroupScheme.groupHom σ.hom ≫ diagTorus F N)

/-- **Iwahori point parahorics.** If, for `k ≠ l` and `n ∈ ℤ`,
`n + c_{kl}(x) ≥ 0 ⟺ n ≥ a_l − a_k + [π l < π k]`, then the point parahoric at `x` is
`(d m) I (d m)⁻¹` with `d = diag(ϖ^{−a_k})` and `m` the permutation matrix of `π`. -/
theorem nonnegativeRootSubgroup_singleton_eq_of_chamber
    (x : (P.basedTransport σ f h).Apartment) (a : Fin N → ℤ) (π : Equiv.Perm (Fin N))
    (hx : ∀ k l, k ≠ l → ∀ n : ℤ,
      (0 ≤ (n : ℝ) + rootValue (P.basedTransport σ f h).apartment x k l ↔
        a l - a k + (if π l < π k then 1 else 0) ≤ n)) :
    (P.basedTransport σ f h).nonnegativeRootSubgroup {x} =
      (generalLinearIwahoriPoints F N).map
        (MulAut.conj (toMatrixGL.symm (diagGL (uniformizerDiag (F := F) a)) *
          toMatrixGL.symm (permGL π))).toMonoidHom := by
  set δ := uniformizerDiag (F := F) a with hδ
  -- The condition of `hx` in terms of orders.
  have hxR : ∀ k l, k ≠ l → ∀ t : Fˣ,
      (0 ≤ localFieldOrder F t + rootValue (P.basedTransport σ f h).apartment x k l ↔
        ((a l : ℝ) - a k + (if π l < π k then 1 else 0)) ≤ localFieldOrder F t) := by
    intro k l hkl t
    rw [localFieldOrder_eq_intCast, hx k l hkl]
    by_cases hπ : π l < π k <;> simp only [hπ, ↓reduceIte] <;> constructor <;> intro h' <;>
      exact_mod_cast h'
  apply le_antisymm
  · apply nonnegativeRootSubgroup_singleton_le P σ f h x
    · intro d hd
      rw [Subgroup.mem_map_equiv, conj_mul_symm_apply, conj_diagPoint_symm_apply,
        conj_diagPoint_diagPoint, conj_permPoint_symm_apply, conj_permPoint_diagPoint]
      exact diagPoint_mem_iwahori _ fun k => hd _
    · intro k l hkl t ht
      rw [Subgroup.mem_map_equiv, conj_mul_symm_apply, conj_diagPoint_symm_apply,
        conj_diagPoint_transvectionPoint, conj_permPoint_symm_apply,
        conj_permPoint_transvectionPoint]
      by_cases ht0 : t = 0
      · simp only [ht0, mul_zero, zero_mul]
        rw [transvectionPoint_zero]
        exact Subgroup.one_mem _
      have hs0 : ((δ⁻¹ k : Fˣ) : F) * t * (((δ⁻¹ l)⁻¹ : Fˣ) : F) ≠ 0 := by simp [ht0]
      have hord : localFieldOrder F (Units.mk0 _ hs0) =
          localFieldOrder F (Units.mk0 t ht0) + a k - a l := by
        rw [localFieldOrder_mk0_mul_mul _ _ ht0, Pi.inv_apply, Pi.inv_apply, inv_inv,
          localFieldOrder_inv, hδ, localFieldOrder_uniformizerDiag,
          localFieldOrder_uniformizerDiag]
        ring
      have hcond := (hxR k l hkl (Units.mk0 t ht0)).1 (ht ht0)
      have hint : 0 ≤ localFieldOrder F (Units.mk0 _ hs0) := by
        rw [hord]
        split_ifs at hcond <;> linarith
      have hs := (localFieldOrder_nonneg_iff (Units.mk0 _ hs0)).1 hint
      rw [Units.val_mk0] at hs
      refine transvectionPoint_mem_iwahori _ hs fun hlt => ?_
      rw [inv_inv] at hlt
      rw [mem_maximalIdeal_iff_localFieldOrder_pos hs hs0, hord]
      rw [ite_eq_left_of_eq_true _ _ (eq_true hlt)] at hcond
      linarith
  · rintro _ ⟨g, hg, rfl⟩
    obtain ⟨u, hu_low, hu⟩ := (mem_generalLinearIwahoriPoints g).1 hg
    have hmem := mem_of_iwahori (((P.basedTransport σ f h).nonnegativeRootSubgroup {x}).comap
        ((MulAut.conj (toMatrixGL.symm (diagGL δ) * toMatrixGL.symm (permGL π))).toMonoidHom.comp
          ((toMatrixGL.symm.toMonoidHom).comp (glIntegralInclusion F N))))
      (fun d => by
        rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.comp_apply,
          MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom, glIntegralInclusion_diagUnit,
          map_mul, MulAut.mul_apply, conj_permPoint_diagPoint, conj_diagPoint_diagPoint]
        exact diagGL_mem_nonnegativeRootSubgroup P σ f h _ _ fun k =>
          valuation_algebraMap_unit (d _))
      (fun {i j} hij c => by
        rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.comp_apply,
          MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom,
          glIntegralInclusion_transvectionUnit, ← transvectionPoint, map_mul, MulAut.mul_apply,
          conj_permPoint_transvectionPoint, conj_diagPoint_transvectionPoint]
        apply transvectionPoint_mem_nonnegativeRootSubgroup
        intro ht0
        have hc0 : (c : F) ≠ 0 := by
          intro hc
          apply ht0
          rw [hc, mul_zero, zero_mul]
        have hc := (localFieldOrder_nonneg_iff (Units.mk0 (c : F) hc0)).2 (by simp)
        refine (hxR _ _ (π⁻¹.injective.ne hij.ne) _).2 ?_
        rw [perm_apply_inv_self, perm_apply_inv_self,
          ite_eq_right_of_eq_false _ _ (eq_false (not_lt.2 hij.le)),
          localFieldOrder_mk0_mul_mul _ _ hc0, localFieldOrder_inv, hδ,
          localFieldOrder_uniformizerDiag, localFieldOrder_uniformizerDiag]
        linarith)
      (fun {i j} hij c hcm => by
        rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.comp_apply,
          MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom,
          glIntegralInclusion_transvectionUnit, ← transvectionPoint, map_mul, MulAut.mul_apply,
          conj_permPoint_transvectionPoint, conj_diagPoint_transvectionPoint]
        apply transvectionPoint_mem_nonnegativeRootSubgroup
        intro ht0
        have hc0 : (c : F) ≠ 0 := by
          intro hc
          apply ht0
          rw [hc, mul_zero, zero_mul]
        have hc := (mem_maximalIdeal_iff_localFieldOrder_pos c.2 hc0).1 hcm
        have hc1 : (1 : ℝ) ≤ localFieldOrder F (Units.mk0 (c : F) hc0) := by
          rw [localFieldOrder_eq_intCast] at hc ⊢
          have h0 : (0 : ℤ) < (Plancherel.fieldOrderUnits F (Units.mk0 (c : F) hc0)).toAdd := by
            exact_mod_cast hc
          have h1 : (1 : ℤ) ≤ (Plancherel.fieldOrderUnits F (Units.mk0 (c : F) hc0)).toAdd := by
            omega
          exact_mod_cast h1
        refine (hxR _ _ (π⁻¹.injective.ne hij.ne') _).2 ?_
        rw [perm_apply_inv_self, perm_apply_inv_self,
          ite_eq_left_of_eq_true _ _ (eq_true hij),
          localFieldOrder_mk0_mul_mul _ _ hc0, localFieldOrder_inv, hδ,
          localFieldOrder_uniformizerDiag, localFieldOrder_uniformizerDiag]
        linarith)
      u hu_low
    have hg' : g = toMatrixGL.symm (glIntegralInclusion F N u) := by
      rw [← hu, MulEquiv.symm_apply_apply]
    rw [hg']
    exact hmem

end Diagonal

end GeneralLinearParahoric

