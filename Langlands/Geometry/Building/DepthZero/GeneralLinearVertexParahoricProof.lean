import Langlands.Geometry.Building.DepthZero.GeneralLinearStatement
import Langlands.Geometry.Building.DepthZero.GeneralLinear.PointParahoric
import Langlands.Geometry.Building.ValuationBuildingIsoGeometry

/-!
# Vertex parahorics of `GL_N` are the conjugates of `GL_N(𝒪_F)`

Proof of `GeneralLinearVertexParahoricStatement`. Let `D` be building data of `GL_N` over a
nonarchimedean local field `F` satisfying the one-group axioms.

The maximal split torus of `D` is conjugate to the diagonal torus by some `g₀`
(`maximalSplitTorusConjugacy`); transporting `D` along the inner automorphism of `g₀`
(`KPBuildingDatum.basedTransport`) gives data `P'` whose torus is the diagonal torus.
For a vertex `x₀` of the apartment of `D` and a facet `x = {h · x₀}`:

* `D.parahoric x = G(F)_{h·x₀} ∩ G(F)^0` (Axiom 4.1.20,
  `KPBuildingDatum.parahoric_eq_pointwiseFixer_inf`);
* conjugation by `g₀` carries it to `G(F)_{h'·x₁} ∩ G(F)^0` for `P'`, where `x₁` is the image
  of `x₀` and `h' = g₀ h g₀⁻¹` (`map_pointwiseFixer_basedTransport`,
  `ParahoricBuildingData.basedTransport_zeroSubgroup`), which is `h'` times
  `G(F)_{x₁} ∩ G(F)^0 = G(F)^0_{x₁}` conjugated, since `G(F)^0` is normal;
* by Axiom 4.1.8 (2) (`hasZeroFixerGenerators`), `G(F)^0_{x₁}` is the subgroup generated by
  `Z(F)^0` and the `U_ψ` with `ψ(x₁) ≥ 0`, and since `x₁` is a vertex its root values are
  differences of integers `y_k − y_l`, so this subgroup is `d K d⁻¹` with
  `d = diag(ϖ^{−y_k})` (`nonnegativeRootSubgroup_singleton_eq_of_intCast_sub`).

Hence `D.parahoric x = (h c) K (h c)⁻¹` with `c = g₀⁻¹ d` depending only on `x₀`. Every vertex
facet is of this form, and choosing `h = g c⁻¹` gives every conjugate `g K g⁻¹`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj ValuativeRel
open Langlands.GroupScheme

namespace Langlands.Geometry.Building

open BruhatTits.IntegralModels

namespace GeneralLinearParahoric

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

omit [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- On rational points, the inner automorphism of `g` is conjugation by `g`. -/
theorem map_innerIso_hom_apply {G : GroupScheme (Spec (CommRingCat.of F))}
    (g x : rationalPoints G) :
    rationalPoints.map (G.innerIso g).hom x = MulAut.conj g x := by
  rw [rationalPoints.map_apply, comp_innerIso_hom, constantPoint_self, MulAut.conj_apply]

/-- The elements of `G(F)^0` fixing `g · z` are the `g`-conjugates of those fixing `z`. -/
theorem pointwiseFixer_smul_singleton_inf_zeroSubgroup {G : GroupScheme (Spec (CommRingCat.of F))}
    [IsAffineHom G.X.hom] (B : ParahoricBuildingData G) (g : rationalPoints G)
    (z : B.ReducedBuilding) :
    B.pointwiseFixer {g • z} ⊓ B.zeroSubgroup =
      (B.pointwiseFixer {z} ⊓ B.zeroSubgroup).map (MulAut.conj g).toMonoidHom := by
  have hfix : ∀ (q : rationalPoints G) (w : B.ReducedBuilding),
      q ∈ B.pointwiseFixer {w} ↔ q • w = w := fun q w => by
    rw [ValuationBuildingData.pointwiseFixer, KPApartmentData.mem_pointwiseFixer,
      Set.forall_mem_singleton]
  ext p
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply, Subgroup.mem_inf, Subgroup.mem_inf, hfix,
    hfix, mul_smul, mul_smul, inv_smul_eq_iff]
  refine and_congr Iff.rfl ⟨fun hp => ?_, fun hp => ?_⟩
  · simpa using B.normal_zeroSubgroup.conj_mem p hp g⁻¹
  · have h1 := B.normal_zeroSubgroup.conj_mem _ hp g
    rwa [show g * (g⁻¹ * p * g) * g⁻¹ = p by group] at h1

end GeneralLinearParahoric

open GeneralLinearParahoric

/-- Proof of `GeneralLinearVertexParahoricStatement`: the parahorics of the vertex facets of
building data of `GL_N` are exactly the conjugates of `GL_N(𝒪_F)`. -/
theorem generalLinearVertexParahoric : GeneralLinearVertexParahoricStatement.{u} := by
  intro F _ _ _ _ N D hD
  dsimp only
  -- Transport to data whose maximal split torus is the diagonal torus.
  obtain ⟨g₀, e, he⟩ := (maximalSplitTorusConjugacy F _ D.base.isConnectedReductive).1
    D.base.S (diagonalSplitTorus F N) D.base.i (diagTorus F N) D.base.isMaximalSplitTorus
    (GeneralLinear.isMaximalSplitTorus_diagonalTorus F)
  let σ : D.base.S ≅ diagonalSplitTorus F N :=
    { hom := Additive.ofMul e.hom
      inv := Additive.ofMul e.inv
      hom_inv_id := congrArg Additive.ofMul e.hom_inv_id
      inv_hom_id := congrArg Additive.ofMul e.inv_hom_id }
  have hσ : D.base.i ≫ ((GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)).innerIso g₀).hom =
      CommGroupScheme.groupHom σ.hom ≫ diagTorus F N := he
  have hD' := hD.basedTransport σ _ hσ
  have hZ : (D.base.basedTransport σ _ hσ).HasZeroFixerGenerators :=
    hD'.satisfiesPartialBuildingAxioms.hasZeroFixerGenerators
  have hφ : rationalPoints.map
      ((GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)).innerIso g₀).hom =
      (MulAut.conj g₀).toMonoidHom :=
    MonoidHom.ext fun x => map_innerIso_hom_apply g₀ x
  -- The parahoric of a translate of a vertex of the apartment.
  have key : ∀ x₀ : D.base.Apartment, AffineRootSystem.IsVertex D.base.affineRoots x₀ →
      ∃ c, ∀ (h : rationalPoints (GeneralLinear.groupScheme (Fin N) (CommRingCat.of F)))
        (x : BuildingFacet D.base.toValuationBuildingData),
        x.val = {h • D.base.apartmentMap x₀} →
          D.parahoric x = (GeneralLinear.standardIntegralModel 𝒪[F] F (Fin N)).integralPoints.map
            (MulAut.conj (h * c)).toMonoidHom := by
    intro x₀ hx₀
    let x₁ : (D.base.basedTransport σ _ hσ).Apartment :=
      D.base.toValuationBuildingData.basedApartmentEquiv σ _ hσ x₀
    have hx₁ : AffineRootSystem.IsVertex (D.base.basedTransport σ _ hσ).affineRoots x₁ := by
      change AffineRootSystem.IsVertex
        (D.base.toValuationBuildingData.basedTransport σ _ hσ).affineRoots x₁
      rw [← D.base.toValuationBuildingData.transportedRoots_basedApartmentEquiv σ _ hσ]
      exact (AffineRootSystem.isVertex_transportedRoots_iff _ _ _).2 hx₀
    obtain ⟨y, hy⟩ :=
      exists_intCast_sub_of_isVertex (D.base.basedTransport σ _ hσ).apartment x₁ hx₁
    have hQ := nonnegativeRootSubgroup_singleton_eq_of_intCast_sub D.base σ _ hσ x₁ y hy
    have hzf : (D.base.basedTransport σ _ hσ).pointwiseFixer
          {(D.base.basedTransport σ _ hσ).apartmentMap x₁} ⊓
          (D.base.basedTransport σ _ hσ).zeroSubgroup =
        (GeneralLinear.standardIntegralModel 𝒪[F] F (Fin N)).integralPoints.map
          (MulAut.conj (toMatrixGL.symm (diagGL (uniformizerDiag (F := F) y)))).toMonoidHom := by
      rw [← hQ, ← hZ {x₁} (Set.singleton_nonempty _) (fun f =>
          ⟨f x₁, by rintro _ ⟨z, hz, rfl⟩; exact le_of_eq (congrArg f hz)⟩),
        ParahoricBuildingData.zeroFixer, Set.image_singleton, inf_comm]
    refine ⟨g₀⁻¹ * toMatrixGL.symm (diagGL (uniformizerDiag (F := F) y)), fun h x hx => ?_⟩
    have hP := D.parahoric_eq_pointwiseFixer_inf hD x
    rw [hx] at hP
    -- The image of the parahoric under conjugation by `g₀`.
    have hmap : (D.parahoric x).map (MulAut.conj g₀).toMonoidHom =
        (GeneralLinear.standardIntegralModel 𝒪[F] F (Fin N)).integralPoints.map
          (MulAut.conj (MulAut.conj g₀ h *
            toMatrixGL.symm (diagGL (uniformizerDiag (F := F) y)))).toMonoidHom := by
      rw [hP, Subgroup.map_inf_eq _ _ _ (MulAut.conj g₀).injective, ← hφ,
        D.base.toValuationBuildingData.map_pointwiseFixer_basedTransport σ _ hσ,
        ← ParahoricBuildingData.basedTransport_zeroSubgroup, Set.image_singleton,
        ValuationBuildingData.basedBuildingEquiv_smul,
        ValuationBuildingData.basedBuildingEquiv_apartmentMap, hφ]
      change (D.base.basedTransport σ _ hσ).pointwiseFixer
          {MulAut.conj g₀ h • (D.base.basedTransport σ _ hσ).apartmentMap x₁} ⊓
          (D.base.basedTransport σ _ hσ).zeroSubgroup = _
      rw [pointwiseFixer_smul_singleton_inf_zeroSubgroup, hzf,
        ParahoricBuildingData.map_conj_map_conj]
    have hback := congrArg (fun Q => Q.map (MulAut.conj g₀⁻¹).toMonoidHom) hmap
    rw [ParahoricBuildingData.map_conj_map_conj, ParahoricBuildingData.map_conj_map_conj,
      inv_mul_cancel, ParahoricBuildingData.map_conj_one, MulAut.conj_apply] at hback
    rw [hback]
    have hg : g₀⁻¹ * (g₀ * h * g₀⁻¹ * toMatrixGL.symm (diagGL (uniformizerDiag (F := F) y))) =
        h * (g₀⁻¹ * toMatrixGL.symm (diagGL (uniformizerDiag (F := F) y))) := by
      group
    rw [hg]
  refine ⟨?_, ?_⟩
  · rintro x ⟨_, ⟨h, x₀, rfl, hx₀⟩, hx⟩
    obtain ⟨c, hc⟩ := key x₀ hx₀
    exact ⟨h * c, hc h x hx⟩
  · intro g
    -- A vertex of the apartment of `D`.
    obtain ⟨x₁, hx₁⟩ : ∃ x₁ : (D.base.basedTransport σ _ hσ).Apartment,
        ∀ k l, rootValue (D.base.basedTransport σ _ hσ).apartment x₁ k l = 0 :=
      exists_rootValue_eq_zero _
    have hx₁v : AffineRootSystem.IsVertex (D.base.basedTransport σ _ hσ).affineRoots x₁ :=
      (isVertex_iff (D.base.basedTransport σ _ hσ).apartment x₁).2
        fun k l => ⟨0, by rw [hx₁]; simp⟩
    let x₀ := (D.base.toValuationBuildingData.basedApartmentEquiv σ _ hσ).symm x₁
    have hx₀ : AffineRootSystem.IsVertex D.base.affineRoots x₀ := by
      refine (AffineRootSystem.isVertex_transportedRoots_iff
        (D.base.toValuationBuildingData.basedApartmentEquiv σ _ hσ) _ x₀).1 ?_
      have hA : D.base.toValuationBuildingData.basedApartmentEquiv σ _ hσ x₀ = x₁ :=
        AffineEquiv.apply_symm_apply _ x₁
      rw [D.base.toValuationBuildingData.transportedRoots_basedApartmentEquiv σ _ hσ, hA]
      exact hx₁v
    obtain ⟨c, hc⟩ := key x₀ hx₀
    have hfacet : D.base.IsFacet {(g * c⁻¹) • D.base.apartmentMap x₀} :=
      ⟨g * c⁻¹, {x₀}, ⟨x₀, hx₀⟩, by rw [Set.image_singleton]⟩
    refine ⟨⟨_, hfacet⟩, ⟨_, ⟨g * c⁻¹, x₀, rfl, hx₀⟩, rfl⟩, ?_⟩
    rw [hc (g * c⁻¹) ⟨_, hfacet⟩ rfl, inv_mul_cancel_right]

end Langlands.Geometry.Building
