import Langlands.Geometry.Building.ChamberExchange
import Langlands.Geometry.Building.ParahoricBuildingAxioms
import Langlands.Geometry.Building.RootReflectionProof

/-!
# The sharp fixer of an arbitrary apartment point

For building data `B` satisfying the apartment axioms, a point `x` of the apartment and a
generic cocharacter `mu`, `G(F)^♯_x ⊆ X_x(Φ_{-mu}) X_x(Φ_mu) H_x`, where `X_x(P)` is the
subgroup generated by the `U_{b,x,0}` for `b ∈ P` and `H_x` is the subgroup of elements of
`N(F)^♯_x = N(F) ∩ G(F)^♯_x` that fix `x` (`sharpNormalizerStabilizer`). This is the range
part of Kaletha–Prasad Proposition 7.3.12(1) with `f = 0` at a point that need not lie in a
chamber, with `H_x` in place of `N′`. The remaining input is opposite factor pairs (the
conclusion of KP Proposition 2.11.17). AS 1 of KP Axiom 4.1.6 for the elements `m(u)` is
`RootReflectionProof.hasRootReflections` (KP Proposition 6.2.1).

The rank-one step is `U_{-a,x,0} U_{a,x,0} ⊆ U_{a,x,0} U_{-a,x,0} H_x`. If `x_{-a}(v) = 0`
for `v ∈ U_{-a,x,0}`, then `m(v)` fixes `x` and lies in `G(F)^♯_x`. If `x_{-a}(v) > 0`, the
factorization `v v′ = x′ z y` of `ChamberRankOne` applies, with `z = m(w) m(v′)`; both
reflections fix the midpoint of `x` and `m(v′) x`, and a centralizer point that fixes one
apartment point fixes all of them. The passage from the rank-one step to the whole sharp
fixer is `sharpFixer_subset_mul_of_exchange` of `ChamberExchange`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace
open Langlands.LinearAlgebra.RationalSpan

namespace Langlands.Geometry.Building

namespace KPApartmentData

variable {k : Type u} [Field k] {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} {i : S.toGrp ⟶ G}
  [Mono i.hom.hom.left] [IsAffineHom G.X.hom] {ω : kˣ → ℝ}

variable (D : KPApartmentData i ω) in
/-- The elements of `N(k)^♯_x = N(k) ∩ G(k)^♯_x` that fix `x`. By KP Proposition 7.3.13
this is all of `N(k)^♯_x`; that equality is not used or proved here. -/
def sharpNormalizerStabilizer (x : D.Apartment) : Subgroup (rationalPoints G) :=
  D.sharpFixer {x} ⊓
    (MulAction.stabilizer (normalizerPoints i) x).map (normalizerPoints i).subtype

theorem mem_sharpNormalizerStabilizer {D : KPApartmentData i ω} {x : D.Apartment}
    {g : rationalPoints G} :
    g ∈ D.sharpNormalizerStabilizer x ↔
      g ∈ D.sharpFixer {x} ∧
        ∃ hg : g ∈ normalizerPoints i, (⟨g, hg⟩ : normalizerPoints i) • x = x := by
  constructor
  · rintro ⟨hS, ⟨n, hn, rfl⟩⟩
    exact ⟨hS, n.2, hn⟩
  · rintro ⟨hS, hg, hx⟩
    exact ⟨hS, ⟨⟨g, hg⟩, hx, rfl⟩⟩

theorem sharpNormalizerStabilizer_le_sharpNormalizer (D : KPApartmentData i ω)
    (x : D.Apartment) : D.sharpNormalizerStabilizer x ≤ D.sharpNormalizer {x} :=
  fun _ hg => ⟨(mem_sharpNormalizerStabilizer.1 hg).2.1, (mem_sharpNormalizerStabilizer.1 hg).1⟩

/-- A centralizer point acts on the apartment by a translation, so if it fixes one point it
fixes every point. -/
theorem smul_eq_self_of_mem_centralizerPoints {D : KPApartmentData i ω}
    {n : normalizerPoints i} (hn : (n : rationalPoints G) ∈ centralizerPoints i)
    {x y : D.Apartment} (hy : n • y = y) : n • x = x := by
  have h1 : ∀ v : TranslationSpace i, translationAction i n v = v := fun v =>
    Submodule.Quotient.induction_on _ v fun w => by
      rw [translationAction_mk, normalizer_smul_def,
        normalizerAction_eq_one_of_mem_centralizerPoints i hn]
      rfl
  calc n • x = n • ((x -ᵥ y) +ᵥ y) := by rw [vsub_vadd]
    _ = translationAction i n (x -ᵥ y) +ᵥ n • y := smul_vadd n _ y
    _ = x := by rw [h1, hy, vsub_vadd]

end KPApartmentData

namespace ValuationBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (B : ValuationBuildingData G)

open KPApartmentData

/-- The rank-one factorization of `ChamberRankOne` with a central factor that fixes `x`:
for `v ∈ U_c(F) ∖ {1}` and `v′ ∈ U_{-c}(F) ∖ {1}` with `x_c(v) + x_{-c}(v′) > 0`,
`v v′ = x′ z y` with `x′ ∈ U_{-c}(F)`, `z ∈ Z(F)`, `y ∈ U_c(F)`, `x_{-c}(x′) ≥ x_{-c}(v′)`,
`x_c(y) ≥ x_c(v)` and `z x = x`. The witnesses are those of
`exists_rankOne_factorization`, `z = m(w) m(v′)` with `w = v p₁⁻¹`. By AS 1
(`RootReflectionProof.hasRootReflections`) both reflections fix the point `y₀ = x + ½ (m(v′) x - x)`, at which `y₀_{-c}(v′) = 0 = y₀_c(w)`. -/
theorem exists_rankOne_factorization_fixing
    (hrank : RelativeRoot.HasRankOneFactorization B.i)
    (x : B.Apartment) {c : characterLattice B.S} (hc : c ∈ relativeRoots B.i)
    (hc' : -c ∈ relativeRoots B.i)
    {v v' : rationalPoints G} (hv : v ∈ rootGroupPoints B.i c) (hv1 : v ≠ 1)
    (hv' : v' ∈ rootGroupPoints B.i (-c)) (hv'1 : v' ≠ 1) {t t' : ℝ}
    (ht : x.val c v = t) (ht' : x.val (-c) v' = t') (hpos : 0 < t + t') :
    ∃ x' ∈ rootGroupPoints B.i (-c), ∃ z ∈ centralizerPoints B.i,
      ∃ y ∈ rootGroupPoints B.i c,
        v * v' = x' * z * y ∧ (t' : WithTop ℝ) ≤ x.val (-c) x' ∧
          (t : WithTop ℝ) ≤ x.val c y ∧
            ∃ hz : z ∈ normalizerPoints B.i, (⟨z, hz⟩ : normalizerPoints B.i) • x = x := by
  have hT : IsSplitTorus B.S.toGrp := B.isMaximalSplitTorus.1.1
  let : Smooth G.X.hom := B.isConnectedReductive.smooth
  have hfinite : (relativeRoots B.i).Finite := hT.finite_relativeRoots B.i
  have hspan := relativeRootsRestrictedCharactersSpan F G B.isConnectedReductive B.S B.i
    B.isMaximalSplitTorus
  have h := x.isValuation
  have hc0 : c ≠ 0 := hc.1
  have hc'' : -(-c) ∈ relativeRoots B.i := by rwa [neg_neg]
  -- the opposite pair `(p₁, p₂)` of `v′` and `m = p₁ v′ p₂`
  obtain ⟨p, hp⟩ := ((hrank (-c) hc' v' hv' hv'1).1).exists
  have hp1 : p.1 ∈ rootGroupPoints B.i (-(-c)) := hp.1
  have hp2 : p.2 ∈ rootGroupPoints B.i (-(-c)) := hp.2.1
  rw [neg_neg] at hp1 hp2
  have h5p := h.opposite (-c) hc' v' hv' hv'1 p.1 hp.1 p.2 hp.2.1 hp.2.2
  rw [ht', neg_neg] at h5p
  have hp1t := withTop_eq_neg_of_add_eq_zero h5p
  -- `w = v p₁⁻¹` has `x_c(w) = -x_{-c}(v′)`
  have hp1i : x.val c p.1⁻¹ = ((-t' : ℝ) : WithTop ℝ) := by rw [h.apply_inv]; exact hp1t
  have hlt : x.val c p.1⁻¹ < x.val c v := by
    rw [hp1i, ht, WithTop.coe_lt_coe]
    linarith
  have hw : v * p.1⁻¹ ∈ rootGroupPoints B.i c :=
    Subgroup.mul_mem _ hv (Subgroup.inv_mem _ hp1)
  have hwt : x.val c (v * p.1⁻¹) = ((-t' : ℝ) : WithTop ℝ) := by
    rw [h.apply_mul_eq_right_of_lt hc hv (Subgroup.inv_mem _ hp1) hlt, hp1i]
  have hw1 : v * p.1⁻¹ ≠ 1 := by
    intro h1
    rw [h1, (h.eq_top_iff c hc 1 (Subgroup.one_mem _)).2 rfl] at hwt
    exact WithTop.top_ne_coe hwt
  -- the opposite pair `(q₁, q₂)` of `w` and `n = q₁ w q₂`
  obtain ⟨q, hq⟩ := ((hrank c hc (v * p.1⁻¹) hw hw1).1).exists
  have h5q := h.opposite c hc _ hw hw1 q.1 hq.1 q.2 hq.2.1 hq.2.2
  rw [hwt] at h5q
  have hq1t := withTop_eq_neg_of_add_eq_zero h5q
  rw [neg_neg] at hq1t
  have hmflip := hp.weylAction_eq_neg B.i hT (neg_ne_zero.2 hc0) hv' hv'1
  have hminv : weylAction B.i (⟨p.1 * v' * p.2, hp.2.2⟩ : normalizerPoints B.i)⁻¹ (-c) = c := by
    have := weylAction_inv_apply_apply (⟨p.1 * v' * p.2, hp.2.2⟩ : normalizerPoints B.i) (-c)
    rw [hmflip, map_neg] at this
    exact neg_inj.1 this
  -- `z = n m` is a centralizer point
  have hZ := weylAction_mul_factorPairs_eq_one hT hfinite hspan hc hw hw1 hv' hv'1 hp hq
  have hzC := (hT.weylAction_eq_one_iff B.i _).1 hZ
  have hy : (p.1 * v' * p.2)⁻¹ * q.2⁻¹ * (p.1 * v' * p.2) * p.2⁻¹ ∈ rootGroupPoints B.i c := by
    refine Subgroup.mul_mem _ ?_ (Subgroup.inv_mem _ hp2)
    have := conj_mem_rootGroupPoints (⟨p.1 * v' * p.2, hp.2.2⟩ : normalizerPoints B.i)⁻¹
      (Subgroup.inv_mem _ (hq.2.1 : q.2 ∈ rootGroupPoints B.i (-c)))
    rw [hminv] at this
    simpa only [Subgroup.coe_inv, inv_inv] using this
  have heq : v * v' = q.1⁻¹ * (q.1 * (v * p.1⁻¹) * q.2 * (p.1 * v' * p.2)) *
      ((p.1 * v' * p.2)⁻¹ * q.2⁻¹ * (p.1 * v' * p.2) * p.2⁻¹) := by group
  have hx' : q.1⁻¹ ∈ rootGroupPoints B.i (-c) := Subgroup.inv_mem _ hq.1
  refine ⟨q.1⁻¹, hx', _, hzC, _, hy, heq, ?_, ?_, centralizerPoints_le_normalizerPoints B.i hzC,
    ?_⟩
  · rw [h.apply_inv, hq1t]
  · refine le_val_of_mul_eq hT hrank x hc hc' hv hv1 hv' hx' hzC hy heq ht ?_ hpos
    rw [ht']
  · -- both reflections fix the midpoint `y₀` of `x` and `m x`
    obtain ⟨wm, hwm⟩ := exists_smul_val_eq_vadd
      (⟨p.1 * v' * p.2, hp.2.2⟩ : normalizerPoints B.i) x
    have hevm := eval_translation_eq_of_factor x hc' hc'' hv' hv'1 hp.1 hp.2.1 hp.2.2
      hmflip ht' hwm
    set y₀ : B.Apartment :=
      (Submodule.Quotient.mk ((1 / 2 : ℝ) • wm) : TranslationSpace B.i) +ᵥ x with hy₀
    have hy₀m : y₀.val (-c) v' = 0 := by
      rw [hy₀, val_mk_vadd, RootFunctionFamily.vadd_apply, ht', map_smul, hevm, smul_eq_mul,
        ← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_inj]
      ring
    have hy₀n : y₀.val c (v * p.1⁻¹) = 0 := by
      rw [hy₀, val_mk_vadd, RootFunctionFamily.vadd_apply, hwt, map_smul, smul_eq_mul]
      rw [eval_neg_char] at hevm
      rw [← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_inj]
      linarith
    have hfixm : (⟨p.1 * v' * p.2, hp.2.2⟩ : normalizerPoints B.i) • y₀ = y₀ :=
      RootReflectionProof.hasRootReflections B ⟨-c, hc'⟩ v' hv' hv'1 p hp y₀ hy₀m
    have hfixn : (⟨q.1 * (v * p.1⁻¹) * q.2, hq.2.2⟩ : normalizerPoints B.i) • y₀ = y₀ :=
      RootReflectionProof.hasRootReflections B ⟨c, hc⟩ (v * p.1⁻¹) hw hw1 q hq y₀ hy₀n
    have hfix : ((⟨q.1 * (v * p.1⁻¹) * q.2, hq.2.2⟩ : normalizerPoints B.i) *
        ⟨p.1 * v' * p.2, hp.2.2⟩) • y₀ = y₀ := by
      rw [mul_smul, hfixm, hfixn]
    exact smul_eq_self_of_mem_centralizerPoints hzC hfix

/-- **Rank-one exchange at an arbitrary point.** Under opposite factor pairs, for every
point `x` of the apartment and every relative root `a`,
`U_{-a,x,0} U_{a,x,0} ⊆ U_{a,x,0} U_{-a,x,0} H_x`, where `H_x` is the subgroup of elements of
`N(F)^♯_x` fixing `x`. -/
theorem filtration_neg_mul_filtration_subset_sharpNormalizerStabilizer
    (hrank : RelativeRoot.HasRankOneFactorization B.i)
    (x : B.Apartment) {a : characterLattice B.S} (ha : a ∈ relativeRoots B.i) :
    (B.filtration x (-a) 0 : Set (rationalPoints G)) * B.filtration x a 0 ⊆
      (B.filtration x a 0 : Set (rationalPoints G)) * B.filtration x (-a) 0 *
        B.apartment.sharpNormalizerStabilizer x := by
  have hT : IsSplitTorus B.S.toGrp := B.isMaximalSplitTorus.1.1
  have h := x.isValuation
  have ha' : -a ∈ relativeRoots B.i := neg_mem_relativeRoots_of_rankOne hT hrank x ha
  rintro _ ⟨v, hv, v', hv', rfl⟩
  beta_reduce
  by_cases hv1 : v = 1
  · subst hv1
    rw [show (1 : rationalPoints G) * v' = v' * 1 * 1 by group]
    exact Set.mul_mem_mul (Set.mul_mem_mul hv' (one_mem _)) (one_mem _)
  by_cases hv'1 : v' = 1
  · subst hv'1
    rw [show v * (1 : rationalPoints G) = 1 * v * 1 by group]
    exact Set.mul_mem_mul (Set.mul_mem_mul (one_mem _) hv) (one_mem _)
  obtain ⟨t, ht⟩ := exists_val_eq_coe x ha' hv.1 hv1
  obtain ⟨t', ht'⟩ := exists_val_eq_coe x ha hv'.1 hv'1
  have ht0 : 0 ≤ t := by
    have := hv.2
    rw [ht] at this
    exact WithTop.coe_le_coe.1 this
  have ht'0 : 0 ≤ t' := by
    have := hv'.2
    rw [ht'] at this
    exact WithTop.coe_le_coe.1 this
  rcases ht0.lt_or_eq with htpos | ht0
  · -- `x_{-a}(v) > 0`: the factorization with a central factor fixing `x`
    have ha'' : -(-a) ∈ relativeRoots B.i := by rwa [neg_neg]
    have hv'a : v' ∈ rootGroupPoints B.i (-(-a)) := by rw [neg_neg]; exact hv'.1
    have ht'a : x.val (-(-a)) v' = t' := by rw [neg_neg]; exact ht'
    obtain ⟨x', hx', z, hz, y, hy, heq, hx't, hyt, hzN, hzx⟩ :=
      B.exists_rankOne_factorization_fixing hrank x ha' ha'' hv.1 hv1 hv'a hv'1 ht ht'a
        (by linarith)
    rw [neg_neg] at hx' hx't
    have hzW : weylAction B.i ⟨z, hzN⟩ = 1 := (hT.weylAction_eq_one_iff B.i ⟨z, hzN⟩).2 hz
    have hx'F : x' ∈ B.filtration x a 0 :=
      ⟨hx', le_trans (WithTop.coe_le_coe.2 ht'0) hx't⟩
    have hyF : y ∈ B.filtration x (-a) 0 :=
      ⟨hy, le_trans (WithTop.coe_le_coe.2 htpos.le) hyt⟩
    have hzy : z * y * z⁻¹ ∈ B.filtration x (-a) 0 := by
      have := B.apartment.conj_mem_filtration ⟨z, hzN⟩ hyF
      rw [hzx, hzW] at this
      exact this
    have hzS : z ∈ B.sharpFixer {x} := by
      have hz' : z = x'⁻¹ * (v * v') * y⁻¹ := by rw [heq]; group
      rw [hz']
      refine Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ ?_)
        (Subgroup.mul_mem _ ?_ ?_)) (Subgroup.inv_mem _ ?_)
      · exact filtration_le_sharpFixer x ha hx'F
      · exact filtration_le_sharpFixer x ha' hv
      · exact filtration_le_sharpFixer x ha hv'
      · exact filtration_le_sharpFixer x ha' hyF
    rw [heq, show x' * z * y = x' * (z * y * z⁻¹) * z by group]
    exact Set.mul_mem_mul (Set.mul_mem_mul hx'F hzy)
      (mem_sharpNormalizerStabilizer.2 ⟨hzS, hzN, hzx⟩)
  · -- `x_{-a}(v) = 0`: `n = m(v)` fixes `x`
    subst ht0
    obtain ⟨q, hq⟩ := ((hrank (-a) ha' v hv.1 hv1).1).exists
    have hq1 : q.1 ∈ rootGroupPoints B.i (-(-a)) := hq.1
    have hq2 : q.2 ∈ rootGroupPoints B.i (-(-a)) := hq.2.1
    rw [neg_neg] at hq1 hq2
    have h5 := h.opposite (-a) ha' v hv.1 hv1 q.1 hq.1 q.2 hq.2.1 hq.2.2
    rw [ht, neg_neg] at h5
    have hq1t := withTop_eq_neg_of_add_eq_zero h5
    have h5' := h.opposite_snd ha' hv.1 hv1 hq.1 hq.2.1 hq.2.2
    rw [ht, neg_neg] at h5'
    have hq2t := withTop_eq_neg_of_add_eq_zero h5'
    have hq1F : q.1 ∈ B.filtration x a 0 := ⟨hq1, by rw [hq1t]; simp⟩
    have hq2F : q.2 ∈ B.filtration x a 0 := ⟨hq2, by rw [hq2t]; simp⟩
    set n : normalizerPoints B.i := ⟨q.1 * v * q.2, hq.2.2⟩ with hn
    have hnx : n • x = x := by
      refine RootReflectionProof.hasRootReflections B ⟨-a, ha'⟩ v hv.1 hv1 q hq x ?_
      change x.val (-a) v = 0
      rw [ht]
      rfl
    have hnflip : weylAction B.i n a = -a := by
      have hflip := hq.weylAction_eq_neg B.i hT (neg_ne_zero.2 ha.1) hv.1 hv1
      rw [map_neg] at hflip
      exact neg_inj.1 hflip
    have hnS : (n : rationalPoints G) ∈ B.sharpFixer {x} :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ (filtration_le_sharpFixer x ha hq1F)
        (filtration_le_sharpFixer x ha' hv)) (filtration_le_sharpFixer x ha hq2F)
    have hconj : (n : rationalPoints G) * (q.2⁻¹ * v') * (n : rationalPoints G)⁻¹ ∈
        B.filtration x (-a) 0 := by
      have := B.apartment.conj_mem_filtration n
        (Subgroup.mul_mem _ (Subgroup.inv_mem _ hq2F) hv')
      rw [hnx, hnflip] at this
      exact this
    have heq : v * v' = q.1⁻¹ *
        ((n : rationalPoints G) * (q.2⁻¹ * v') * (n : rationalPoints G)⁻¹) *
          (n : rationalPoints G) := by
      rw [hn]
      group
    rw [heq]
    exact Set.mul_mem_mul (Set.mul_mem_mul (Subgroup.inv_mem _ hq1F) hconj)
      (mem_sharpNormalizerStabilizer.2 ⟨hnS, n.2, hnx⟩)

/-- **The sharp fixer of an arbitrary point.** Under the apartment axioms and opposite
factor pairs, for every point `x` of the apartment and every generic cocharacter `mu`,
`G(F)^♯_x ⊆ X_x(Φ_{-mu}) X_x(Φ_mu) H_x`, where `X_x(P) = ⨆_{b ∈ P} U_{b,x,0}` and `H_x` is
the subgroup of elements of `N(F)^♯_x` fixing `x`. -/
theorem sharpFixer_subset_mul_sharpNormalizerStabilizer
    (hB : B.apartment.SatisfiesApartmentAxioms B.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization B.i)
    (x : B.Apartment) (mu : cocharacterLattice B.S) (hmu : IsGenericCocharacter B.i mu) :
    (B.sharpFixer {x} : Set (rationalPoints G)) ⊆
      ((⨆ b : positiveRelativeRoots B.i (-mu), B.apartment.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots B.i mu, B.apartment.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        (B.apartment.sharpNormalizerStabilizer x : Set (rationalPoints G)) := by
  have hT : IsSplitTorus B.S.toGrp := B.isMaximalSplitTorus.1.1
  have : Smooth G.X.hom := B.isConnectedReductive.smooth
  exact KPApartmentData.sharpFixer_subset_mul_of_exchange (D := B.apartment) hT
    (IsSplitTorus.finite_relativeRoots (i := B.i) hT)
    hB.isAffineRootSystem_extendedAffineRoots hB.derivativeRoots_extendedAffineRoots
    (fun c hc => neg_mem_relativeRoots_of_rankOne hT hrank x hc)
    (fun c hc =>
      B.filtration_neg_mul_filtration_subset_sharpNormalizerStabilizer hrank x hc)
    mu hmu

end ValuationBuildingData

/-- For building data `B` over a nonarchimedean local field `F` that satisfies the apartment
axioms (V 6, V 7 and AS 2–AS 5) and has opposite factor pairs (the conclusion of KP
Proposition 2.11.17): at every point `x` of the apartment and for every generic cocharacter
`mu`,
`G(F)^♯_x ⊆ X_x(Φ_{-mu}) X_x(Φ_mu) H_x`, where `X_x(P) = ⨆_{b ∈ P} U_{b,x,0}` and
`H_x = B.apartment.sharpNormalizerStabilizer x` is the subgroup of elements of
`N(F) ∩ G(F)^♯_x` that fix `x`. -/
def PointSharpExchangeStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (B : ValuationBuildingData G),
    B.apartment.SatisfiesApartmentAxioms B.centralizer →
    RelativeRoot.HasRankOneFactorization B.i →
    ∀ (x : B.Apartment) (mu : cocharacterLattice B.S), IsGenericCocharacter B.i mu →
      (B.sharpFixer {x} : Set (rationalPoints G)) ⊆
        ((⨆ b : positiveRelativeRoots B.i (-mu), B.apartment.chamberRootGroup x false b :
            Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
          ((⨆ b : positiveRelativeRoots B.i mu, B.apartment.chamberRootGroup x false b :
            Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
          (B.apartment.sharpNormalizerStabilizer x : Set (rationalPoints G))

theorem pointSharpExchange : PointSharpExchangeStatement.{u} := by
  intro F _ _ _ _ G _ B hB hrank x mu hmu
  exact B.sharpFixer_subset_mul_sharpNormalizerStabilizer hB hrank x mu hmu

end Langlands.Geometry.Building
