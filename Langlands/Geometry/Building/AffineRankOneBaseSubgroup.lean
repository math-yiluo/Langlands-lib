import Langlands.Geometry.Building.AffineRankOneTwoCellStatement
import Langlands.Geometry.Building.RankOneZeroFactorization
import Langlands.Geometry.Building.CentralizerZeroRootConjugation
import Langlands.Group.FilteredRankOneBaseSubgroup

/-! # The actual filtered rank-one base cell is a subgroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace
open Langlands.Plancherel

namespace Langlands.Geometry.Building.ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G)

/-- The subgroup generated by the weak positive, strict negative, and actual
centralizer-zero factors of the base cell. -/
def affineRankOneBaseSubgroup (α : relativeRoots P.i)
    (ψ : P.Apartment →ᵃ[ℝ] ℝ) : Subgroup (rationalPoints G) :=
  Langlands.Group.FilteredRankOne.baseSubgroup
    (P.affineRootGroup α ψ)
    (P.apartment.affineRootGroupPlus (-α.val) (-ψ))
    (P.centralizerZero.map (rationalPoints.map P.centralizer.j))

/-- Weak positive times strict negative exchanges into the actual base cell. -/
theorem affineRankOne_base_exchange
    (hA : P.SatisfiesApartmentAxioms)
    (hZ : P.zeroDatum.CoverImageCentralizerNormKernelStatement)
    (hF : RelativeRoot.HasRankOneFactorization P.i)
    {α : relativeRoots P.i} {ψ : P.Apartment →ᵃ[ℝ] ℝ}
    (hψ : ψ.linear = rootForm P.i α)
    {u v : rationalPoints G}
    (hu : u ∈ P.affineRootGroup α ψ)
    (hv : v ∈ P.apartment.affineRootGroupPlus (-α.val) (-ψ)) :
    ∃ a ∈ P.apartment.affineRootGroupPlus (-α.val) (-ψ),
      ∃ z ∈ P.centralizerZero.map (rationalPoints.map P.centralizer.j),
        ∃ b ∈ P.affineRootGroup α ψ, u * v = a * z * b := by
  by_cases hu1 : u = 1
  · subst u
    exact ⟨v, hv, 1, one_mem _, 1, one_mem _, by simp⟩
  by_cases hv1 : v = 1
  · subst v
    exact ⟨1, one_mem _, 1, one_mem _, u, hu, by simp⟩
  let x : P.Apartment := Classical.arbitrary P.Apartment
  have hneg := KPApartmentData.neg_mem_relativeRoots_of_rankOne
    P.isMaximalSplitTorus.isSplitSubtorus.1 hF x α.property
  let β : relativeRoots P.i := ⟨-α.val, hneg⟩
  have hψn : (-ψ).linear = rootForm P.i β := by
    apply LinearMap.ext
    intro w
    change -ψ.linear w = rootForm P.i β w
    rw [hψ]
    refine Submodule.Quotient.induction_on _ w fun w0 => ?_
    simp only [rootForm_mk, β, eval_neg_char]
  have hu0 := (KPApartmentData.mem_affineRootGroup_iff hψ x).1 hu
  have hv0 := (KPApartmentData.mem_affineRootGroupPlus_iff hψn x).1 hv
  obtain ⟨t, ht⟩ := WithTop.ne_top_iff_exists.1
    ((x.isValuation.eq_top_iff α α.property u hu0.1).not.2 hu1)
  obtain ⟨t', ht'⟩ := WithTop.ne_top_iff_exists.1
    ((x.isValuation.eq_top_iff β β.property v hv0.1).not.2 hv1)
  have hut : ψ x ≤ t := by
    have h := hu0.2
    rwa [← ht, WithTop.coe_le_coe] at h
  have hvt : -ψ x < t' := by
    have h := hv0.2
    change ((-ψ x : ℝ) : WithTop ℝ) < x.val (-α.val) v at h
    rwa [← ht', WithTop.coe_lt_coe] at h
  have hpos : 0 < t + t' := by linarith
  let f := P.rankOneZeroFactorization hA hZ hF x
    hu0.1 hu1 hv0.1 hv1 ht.symm ht'.symm hpos
  refine ⟨f.negative.val, ?_, rationalPoints.map P.centralizer.j f.central.val,
    ⟨f.central.val, f.central.property, rfl⟩, f.positive.val, ?_, f.product_eq⟩
  · apply (KPApartmentData.mem_affineRootGroupPlus_iff hψn x).2
    exact ⟨f.negative.property,
      (WithTop.coe_lt_coe.2 hvt).trans_le f.negative_depth⟩
  · apply (KPApartmentData.mem_affineRootGroup_iff hψ x).2
    exact ⟨f.positive.property,
      (WithTop.coe_le_coe.2 hut).trans f.positive_depth⟩

/-- The actual base cell is precisely the carrier of its generated subgroup.
The cover comparison and actual factor-pair existence remain explicit. -/
theorem coe_affineRankOneBaseSubgroup
    (hA : P.SatisfiesApartmentAxioms)
    (hZ : P.zeroDatum.CoverImageCentralizerNormKernelStatement)
    (hF : RelativeRoot.HasRankOneFactorization P.i)
    {α : relativeRoots P.i} {ψ : P.Apartment →ᵃ[ℝ] ℝ}
    (hψ : ψ.linear = rootForm P.i α) :
    (P.affineRankOneBaseSubgroup α ψ : Set (rationalPoints G)) =
      P.affineRankOneBaseCell α ψ := by
  apply Langlands.Group.FilteredRankOne.coe_baseSubgroup_eq_baseCell
  · intro z hz a ha
    exact (Subgroup.mem_normalizer_iff.1
      (P.map_centralizerZero_le_normalizer_affineRootGroup α ψ hz) a).1 ha
  · intro z hz a ha
    exact (Subgroup.mem_normalizer_iff.1
      (P.map_centralizerZero_le_normalizer_affineRootGroupPlus (-α.val) (-ψ) hz) a).1 ha
  · intro a ha b hb
    exact P.affineRankOne_base_exchange hA hZ hF hψ ha hb

end Langlands.Geometry.Building.ParahoricBuildingData
