import Langlands.Geometry.Building.KPLocalMoyPrasadDoubleRootConjugation
import Langlands.Geometry.Building.MoyPrasadCommutatorGenerators

/-! # K-level commutators from actual torus estimates -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj Pointwise NNReal TensorProduct commutatorElement
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace
open Langlands.LocalGalois.Separable

set_option backward.isDefEq.respectTransparency false

namespace Langlands.Geometry.Building.MaximalUnramified.BuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))} [IsAffineHom H.X.hom]
    (B : BuildingData F H) (hZ : IsTorus B.centralizer.Z)

/-- Every actual relative root takes every real value on `V(S)`. -/
theorem exists_eval_eq_of_mem_relativeRoots {a : characterLattice B.S}
    (ha : a ∈ relativeRoots B.i) (c : ℝ) : ∃ w : V B.S, eval B.S a w = c := by
  let : Smooth H.X.hom := B.isConnectedReductive.smooth
  obtain ⟨ν, hν⟩ := B.isMaximalSplitTorus.isSplitSubtorus.1.exists_genericCocharacter B.i
  have hp : ((latticePairing B.S a ν : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hν a ha
  refine ⟨(c / (latticePairing B.S a ν : ℝ)) ⊗ₜ[ℤ] ν, ?_⟩
  rw [eval_tmul]
  field_simp

/-- Membership in a root filtration at the translated point `x + w`. -/
theorem mem_filtration_vadd_of_mem {x : B.Apartment} (w : V B.S) {a : characterLattice B.S}
    {ρ ρ' : ℝ} {g : rationalPoints H} (hg : g ∈ B.filtration x a ρ')
    (h : ρ - eval B.S a w ≤ ρ') :
    g ∈ B.filtration ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x)
      a ρ := by
  change g ∈ B.apartment.filtration _ a ρ
  rw [KPApartmentData.filtration_mk_vadd]
  exact B.apartment.filtration_antitone x a h hg

/-- Membership in a root filtration at `x` from membership at the translated point. -/
theorem mem_filtration_of_mem_vadd {x : B.Apartment} (w : V B.S) {a : characterLattice B.S}
    {ρ ρ' : ℝ} {g : rationalPoints H}
    (hg : g ∈ B.filtration ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x)
      a ρ)
    (h : ρ' ≤ ρ - eval B.S a w) : g ∈ B.filtration x a ρ' := by
  change g ∈ B.apartment.filtration _ a ρ at hg
  rw [KPApartmentData.filtration_mk_vadd] at hg
  exact B.apartment.filtration_antitone x a h hg

/-- `P_{x,r}` is generated by `j(Z(F)_r)` and the root filtrations `U_{b,x,r}`. -/
theorem moyPrasad_eq_closure (x : B.Apartment) (r : NNReal) :
    B.moyPrasad hZ x r = Subgroup.closure ((B.centralizerTorusImage hZ r : Set (rationalPoints H)) ∪
      ⋃ b : relativeRoots B.i, (B.filtration x b.1 r : Set (rationalPoints H))) := by
  rw [Subgroup.closure_union, Subgroup.closure_iUnion, Subgroup.closure_eq, B.moyPrasad_eq_sup_iSup]
  simp only [Subgroup.closure_eq]

/-- A block at a translated point lies in `P_{x,D}` when both its depths, read at `x`,
are at least `D`. -/
theorem filtrationBlock_vadd_subset_moyPrasad (x : B.Apartment) (w : V B.S)
    {a : characterLattice B.S} (ha : a ∈ relativeRoots B.i) (R : ℝ) (D : NNReal)
    (h1 : (D : ℝ) ≤ R - eval B.S a w) (h2 : (D : ℝ) ≤ R - 2 * eval B.S a w) :
    B.apartment.filtrationBlock
        ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x)
        (fun _ => R) a ⊆ B.moyPrasad hZ x D := by
  rintro g ⟨d1, hd1, d2, hd2, rfl⟩
  refine (B.moyPrasad hZ x D).mul_mem ?_ ?_
  · exact B.filtration_le_moyPrasad hZ x ⟨a, ha⟩ D (B.mem_filtration_of_mem_vadd w hd1 h1)
  · by_cases h2a : 2 • a ∈ relativeRoots B.i
    · have hd2' : d2 ∈ B.filtration
          ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x)
          (2 • a) R := by
        have h := hd2
        simp only [SetLike.mem_coe] at h
        rwa [B.apartment.doubleFiltration_of_mem _ a _ h2a] at h
      refine B.filtration_le_moyPrasad hZ x ⟨2 • a, h2a⟩ D
        (B.mem_filtration_of_mem_vadd w hd2' ?_)
      rw [eval_nsmul_char]
      push_cast
      linarith
    · have h := hd2
      simp only [SetLike.mem_coe] at h
      rw [B.apartment.doubleFiltration_of_not_mem _ a _ h2a, Subgroup.mem_bot] at h
      rw [h]
      exact (B.moyPrasad hZ x D).one_mem

/-- Abstract opposite-root bookkeeping: knowing both conjugation coordinates of an
opposite pair, together with its exchange factorization, places the commutator in `N`. -/
theorem commutator_mem_of_opposite_coordinates
    {a : characterLattice B.S} (ha : a ∈ relativeRoots B.i) (N : Subgroup (rationalPoints H))
    {u v v₁ u₁ c : rationalPoints H}
    (hu : u ∈ rootGroupPoints B.i a) (hv : v ∈ rootGroupPoints B.i (-a))
    (hv₁ : v₁ ∈ rootGroupPoints B.i (-a)) (hc : c ∈ centralizerPoints B.i)
    (hu₁ : u₁ ∈ rootGroupPoints B.i a) (heq : v₁ * c * u₁ = u * v) (hcN : c ∈ N)
    (hB : ∃ n ∈ rootGroupPoints B.i (-a), ∃ c' ∈ centralizerPoints B.i,
      ∃ q ∈ rootGroupPoints B.i a, q ∈ N ∧ u * v * u⁻¹ = n * c' * q)
    (hC : ∃ m ∈ rootGroupPoints B.i a, ∃ c' ∈ centralizerPoints B.i,
      ∃ q ∈ rootGroupPoints B.i (-a), q ∈ N ∧ v⁻¹ * u⁻¹ * v = m * c' * q)
    (hvN : v ∈ Subgroup.normalizer (N : Set (rationalPoints H))) :
    ⁅u, v⁆ ∈ N := by
  obtain ⟨n, hn, c', hc', q, hq, hqN, hBeq⟩ := hB
  obtain ⟨m, hm, c'', hc'', q', hq', hq'N, hCeq⟩ := hC
  -- the positive coordinate `u₁ u⁻¹`
  have hcompB : v₁ * c * (u₁ * u⁻¹) = n * c' * q := by
    rw [← hBeq, ← mul_assoc, heq]
  have huniqB := B.oppositeRootTripleProduct_injective ha
    (a₁ := (⟨v₁, hv₁⟩, ⟨c, hc⟩,
      ⟨u₁ * u⁻¹, (rootGroupPoints B.i a).mul_mem hu₁ ((rootGroupPoints B.i a).inv_mem hu)⟩))
    (a₂ := (⟨n, hn⟩, ⟨c', hc'⟩, ⟨q, hq⟩)) hcompB
  have hpos : u₁ * u⁻¹ = q :=
    congrArg (fun p : rootGroupPoints B.i (-a) × centralizerPoints B.i ×
      rootGroupPoints B.i a => (p.2.2 : rationalPoints H)) huniqB
  -- the negative coordinate `v⁻¹ v₁`
  have hcompC : (v⁻¹ * v₁) * c * u₁ = q'⁻¹ * c''⁻¹ * m⁻¹ := by
    have h1 : v⁻¹ * u * v = (v⁻¹ * u⁻¹ * v)⁻¹ := by group
    calc (v⁻¹ * v₁) * c * u₁ = v⁻¹ * (v₁ * c * u₁) := by group
      _ = v⁻¹ * u * v := by rw [heq]; group
      _ = (m * c'' * q')⁻¹ := by rw [h1, hCeq]
      _ = q'⁻¹ * c''⁻¹ * m⁻¹ := by group
  have huniqC := B.oppositeRootTripleProduct_injective ha
    (a₁ := (⟨v⁻¹ * v₁, (rootGroupPoints B.i (-a)).mul_mem
        ((rootGroupPoints B.i (-a)).inv_mem hv) hv₁⟩, ⟨c, hc⟩, ⟨u₁, hu₁⟩))
    (a₂ := (⟨q'⁻¹, (rootGroupPoints B.i (-a)).inv_mem hq'⟩,
      ⟨c''⁻¹, (centralizerPoints B.i).inv_mem hc''⟩,
      ⟨m⁻¹, (rootGroupPoints B.i a).inv_mem hm⟩)) hcompC
  have hneg : v⁻¹ * v₁ = q'⁻¹ :=
    congrArg (fun p : rootGroupPoints B.i (-a) × centralizerPoints B.i ×
      rootGroupPoints B.i a => (p.1 : rationalPoints H)) huniqC
  -- assemble
  have hcomm : ⁅u, v⁆ = v * ((v⁻¹ * v₁) * c * (u₁ * u⁻¹)) * v⁻¹ := by
    rw [commutatorElement_def]
    calc u * v * u⁻¹ * v⁻¹ = (u * v) * u⁻¹ * v⁻¹ := by group
      _ = (v₁ * c * u₁) * u⁻¹ * v⁻¹ := by rw [heq]
      _ = v * ((v⁻¹ * v₁) * c * (u₁ * u⁻¹)) * v⁻¹ := by group
  rw [hcomm, hneg, hpos]
  exact (Subgroup.le_normalizer_iff.mp (le_refl _ : Subgroup.normalizer
    (N : Set (rationalPoints H)) ≤ _)) v hvN _
    (N.mul_mem (N.mul_mem (N.inv_mem hq'N) hcN) hqN)

/-- **Ordinary opposite pairs.** For `r, s > 0`, `u ∈ U_{a,x,r}` and `v ∈ U_{-a,x,s}`, the
commutator `⁅u, v⁆` lies in `P_{x,r+s}`, provided `v` normalizes `P_{x,r+s}`. -/
theorem commutator_opposite_mem_moyPrasad
    (hZcomm : B.LocalTorusCommutatorFriendly hZ)
    (x : B.Apartment) {a : characterLattice B.S} (ha : a ∈ relativeRoots B.i)
    (r s : NNReal) (hr : 0 < r) (hs : 0 < s) {u v : rationalPoints H}
    (hu : u ∈ B.filtration x a r) (hv : v ∈ B.filtration x (-a) s)
    (hvN : v ∈ Subgroup.normalizer (B.moyPrasad hZ x (r + s) : Set (rationalPoints H))) :
    ⁅u, v⁆ ∈ B.moyPrasad hZ x (r + s) := by
  let : Smooth H.X.hom := B.isConnectedReductive.smooth
  have hna : -a ∈ relativeRoots B.i :=
    KPApartmentData.neg_mem_relativeRoots_of_rankOne
      B.isMaximalSplitTorus.isSplitSubtorus.1
      (rootRankOneFactorization (UnramifiedClosure F) H B.isConnectedReductive B.S B.i B.isMaximalSplitTorus)
      x ha
  have hpos : 0 < r + s := add_pos hr hs
  have hr' : (0 : ℝ) < r := hr
  have hs' : (0 : ℝ) < s := hs
  obtain ⟨v₁, hv₁, z, hz, u₁, hu₁, heq⟩ :=
    B.exists_rankOne_depth_factorization hZ hZcomm x ha r s hpos hu hv
  -- the positive coordinate, at the point where `u` has depth zero
  obtain ⟨w, hw⟩ := B.exists_eval_eq_of_mem_relativeRoots ha (-(r : ℝ))
  have huy : u ∈ B.filtration
      ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x) a 0 :=
    B.mem_filtration_vadd_of_mem w hu (by rw [hw]; simp)
  have hvy : v ∈ B.filtration
      ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x) (-a)
      ((r + s : NNReal) : ℝ) :=
    B.mem_filtration_vadd_of_mem w hv (by rw [eval_neg_char, hw]; push_cast; linarith)
  obtain ⟨_, ⟨n, hn, c', hc', rfl⟩, q, hq, hBeq⟩ :=
    B.conjugate_opposite_mem_root_centralizer_block (exists_order_eq_one F) _ ha (r + s) hpos huy hvy
  have hqN : q ∈ B.moyPrasad hZ x (r + s) :=
    B.filtrationBlock_vadd_subset_moyPrasad hZ x w ha _ (r + s)
      (by rw [hw]; push_cast; linarith) (by rw [hw]; push_cast; linarith) hq
  -- the negative coordinate, at the point where `v` has depth zero
  obtain ⟨w', hw'⟩ := B.exists_eval_eq_of_mem_relativeRoots ha (s : ℝ)
  have hvy' : v⁻¹ ∈ B.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace B.i) +ᵥ x) (-a) 0 :=
    B.mem_filtration_vadd_of_mem w' ((B.filtration x (-a) s).inv_mem hv)
      (by rw [eval_neg_char, hw']; simp)
  have huy' : u⁻¹ ∈ B.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace B.i) +ᵥ x) (-(-a))
      ((r + s : NNReal) : ℝ) := by
    rw [neg_neg]
    exact B.mem_filtration_vadd_of_mem w' ((B.filtration x a r).inv_mem hu)
      (by rw [hw']; push_cast; linarith)
  obtain ⟨_, ⟨m, hm, c'', hc'', rfl⟩, q', hq', hCeq⟩ :=
    B.conjugate_opposite_mem_root_centralizer_block (exists_order_eq_one F) _ hna (r + s) hpos hvy' huy'
  have hq'N : q' ∈ B.moyPrasad hZ x (r + s) :=
    B.filtrationBlock_vadd_subset_moyPrasad hZ x w' hna _ (r + s)
      (by rw [eval_neg_char, hw']; push_cast; linarith)
      (by rw [eval_neg_char, hw']; push_cast; linarith) hq'
  refine B.commutator_mem_of_opposite_coordinates ha (B.moyPrasad hZ x (r + s)) hu.1 hv.1 hv₁.1
    (map_mem_centralizerPoints B.centralizer.isRepresentedBy z) hu₁.1 heq
    (B.centralizerTorusImage_le_moyPrasad hZ x (r + s) ⟨z, hz, rfl⟩)
    ⟨n, hn, c', hc', q, B.apartment.filtrationBlock_subset_rootGroupPoints _ _ a hq, hqN,
      hBeq.symm⟩
    ⟨m, by simpa only [neg_neg, SetLike.mem_coe] using hm, c'', hc'', q',
      B.apartment.filtrationBlock_subset_rootGroupPoints _ _ (-a) hq', hq'N,
      by simpa only [inv_inv] using hCeq.symm⟩ hvN

/-- **Mixed pairs.** For `r, s > 0`, a root `a` with `2a` a root, `u ∈ U_{a,x,r}` and
`v ∈ U_{-2a,x,s}`, the commutator `⁅u, v⁆` lies in `P_{x,r+s}` under double-root
commutator friendliness, provided `v` normalizes `P_{x,r+s}`. -/
theorem commutator_double_opposite_mem_moyPrasad
    (hZcomm : B.LocalTorusCommutatorFriendly hZ)
    (hZ2 : B.LocalTorusDoubleRootCommutatorFriendly hZ)
    (x : B.Apartment) {a : characterLattice B.S} (ha : a ∈ relativeRoots B.i)
    (h2a : 2 • a ∈ relativeRoots B.i)
    (r s : NNReal) (hr : 0 < r) (hs : 0 < s) {u v : rationalPoints H}
    (hu : u ∈ B.filtration x a r) (hv : v ∈ B.filtration x (-(2 • a)) s)
    (hvN : v ∈ Subgroup.normalizer (B.moyPrasad hZ x (r + s) : Set (rationalPoints H))) :
    ⁅u, v⁆ ∈ B.moyPrasad hZ x (r + s) := by
  let : Smooth H.X.hom := B.isConnectedReductive.smooth
  have hna : -a ∈ relativeRoots B.i :=
    KPApartmentData.neg_mem_relativeRoots_of_rankOne
      B.isMaximalSplitTorus.isSplitSubtorus.1
      (rootRankOneFactorization (UnramifiedClosure F) H B.isConnectedReductive B.S B.i B.isMaximalSplitTorus)
      x ha
  have h2na : 2 • (-a) ∈ relativeRoots B.i := by
    have hn := KPApartmentData.neg_mem_relativeRoots_of_rankOne
      B.isMaximalSplitTorus.isSplitSubtorus.1
      (rootRankOneFactorization (UnramifiedClosure F) H B.isConnectedReductive B.S B.i B.isMaximalSplitTorus)
      x h2a
    simpa only [smul_neg] using hn
  have hr' : (0 : ℝ) < r := hr
  have hs' : (0 : ℝ) < s := hs
  have hvHalf : v ∈ B.filtration x (-a) ((s / 2 : NNReal) : ℝ) := by
    have h := B.apartment.filtration_double_le_half x hna h2na (s : ℝ)
      (by simpa only [smul_neg] using hv)
    simpa only [NNReal.coe_div, NNReal.coe_ofNat] using h
  have hpos : 0 < r + s / 2 := add_pos hr (div_pos hs (by norm_num))
  obtain ⟨v₁, hv₁, z, -, u₁, hu₁, heq⟩ :=
    B.exists_rankOne_depth_factorization hZ hZcomm x ha r (s / 2) hpos hu hvHalf
  -- the point where `u` has depth zero
  obtain ⟨w, hw⟩ := B.exists_eval_eq_of_mem_relativeRoots ha (-(r : ℝ))
  have huy : u ∈ B.filtration
      ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x) a 0 :=
    B.mem_filtration_vadd_of_mem w hu (by rw [hw]; simp)
  have hvy : v ∈ B.filtration
      ((Submodule.Quotient.mk w : TranslationSpace B.i) +ᵥ x) (-(2 • a))
      ((s + 2 * r : NNReal) : ℝ) :=
    B.mem_filtration_vadd_of_mem w hv
      (by rw [eval_neg_char, eval_nsmul_char, hw]; push_cast; linarith)
  have hpos2 : 0 < s + 2 * r := add_pos hs (mul_pos (by norm_num) hr)
  -- the central coordinate, by double-root commutator friendliness
  have hzD : z ∈ B.centralizerTorusFiltration hZ (s + 2 * r) :=
    B.double_opposite_central_mem_of_doubleRootCommutatorFriendly hZ hZ2 _ ha h2a
      (s + 2 * r) hpos2 huy hvy v₁ hv₁.1 z u₁ hu₁.1 heq
  have hz : z ∈ B.centralizerTorusFiltration hZ (r + s) := by
    refine B.centralizerTorusFiltration_antitone hZ ?_ hzD
    apply NNReal.coe_le_coe.mp
    push_cast
    linarith
  -- the positive coordinate
  obtain ⟨_, ⟨n, hn, c', hc', rfl⟩, q, hq, hBeq⟩ :=
    B.conjugate_double_opposite_mem_root_centralizer_block (exists_order_eq_one F) _ ha h2a (s + 2 * r) hpos2
      huy hvy
  have hqN : q ∈ B.moyPrasad hZ x (r + s) :=
    B.filtrationBlock_vadd_subset_moyPrasad hZ x w ha _ (r + s)
      (by rw [hw]; push_cast; linarith) (by rw [hw]; push_cast; linarith) hq
  -- the negative coordinate, at the point where `v` has ordinary depth zero
  obtain ⟨w', hw'⟩ := B.exists_eval_eq_of_mem_relativeRoots ha ((s : ℝ) / 2)
  have hvy' : v⁻¹ ∈ B.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace B.i) +ᵥ x) (-a) 0 :=
    B.mem_filtration_vadd_of_mem w' ((B.filtration x (-a) _).inv_mem hvHalf)
      (by rw [eval_neg_char, hw']; push_cast; linarith)
  have huy' : u⁻¹ ∈ B.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace B.i) +ᵥ x) (-(-a))
      ((r + s / 2 : NNReal) : ℝ) := by
    rw [neg_neg]
    exact B.mem_filtration_vadd_of_mem w' ((B.filtration x a r).inv_mem hu)
      (by rw [hw']; push_cast; linarith)
  obtain ⟨_, ⟨m, hm, c'', hc'', rfl⟩, q', hq', hCeq⟩ :=
    B.conjugate_opposite_mem_root_centralizer_block (exists_order_eq_one F) _ hna (r + s / 2) hpos hvy' huy'
  have hq'N : q' ∈ B.moyPrasad hZ x (r + s) :=
    B.filtrationBlock_vadd_subset_moyPrasad hZ x w' hna _ (r + s)
      (by rw [eval_neg_char, hw']; push_cast; linarith)
      (by rw [eval_neg_char, hw']; push_cast; linarith) hq'
  have hv2 : v ∈ rootGroupPoints B.i (-a) := hvHalf.1
  refine B.commutator_mem_of_opposite_coordinates ha (B.moyPrasad hZ x (r + s)) hu.1 hv2 hv₁.1
    (map_mem_centralizerPoints B.centralizer.isRepresentedBy z) hu₁.1 heq
    (B.centralizerTorusImage_le_moyPrasad hZ x (r + s) ⟨z, hz, rfl⟩)
    ⟨n, hn, c', hc', q, B.apartment.filtrationBlock_subset_rootGroupPoints _ _ a hq, hqN,
      hBeq.symm⟩
    ⟨m, by simpa only [neg_neg, SetLike.mem_coe] using hm, c'', hc'', q',
      B.apartment.filtrationBlock_subset_rootGroupPoints _ _ (-a) hq', hq'N,
      by simpa only [inv_inv] using hCeq.symm⟩ hvN


set_option maxHeartbeats 800000 in
/-- Commutators of generators of `P_{x,r}` and `P_{x,s}` lie in `P_{x,r+s}` for `r, s > 0`. -/
theorem generator_commutator_mem_moyPrasad (hZcomm : B.LocalTorusCommutatorFriendly hZ)
    (hZ2 : B.LocalTorusDoubleRootCommutatorFriendly hZ)
    (hZr : B.LocalTorusRootCompatible hZ)
    (x : B.Apartment) (r s : NNReal) (hr : 0 < r) (hs : 0 < s) {g k : rationalPoints H}
    (hg : g ∈ (B.centralizerTorusImage hZ r : Set (rationalPoints H)) ∪
      ⋃ b : relativeRoots B.i, (B.filtration x b.1 r : Set (rationalPoints H)))
    (hk : k ∈ (B.centralizerTorusImage hZ s : Set (rationalPoints H)) ∪
      ⋃ b : relativeRoots B.i, (B.filtration x b.1 s : Set (rationalPoints H))) :
    ⁅g, k⁆ ∈ B.moyPrasad hZ x (r + s) := by
  have hnorm : ∀ t : NNReal, ∀ (b : characterLattice B.S) (hb : b ∈ relativeRoots B.i)
      (ρ : NNReal) {h : rationalPoints H}, h ∈ B.filtration x b ρ →
      h ∈ Subgroup.normalizer (B.moyPrasad hZ x t : Set (rationalPoints H)) := by
    intro t b hb ρ h hh
    exact B.localMoyPrasadNormality_of_torus_commutator_bounds hZ hZcomm hZ2 hZr x t
      (B.moyPrasad_antitone hZ x (zero_le : (0 : NNReal) ≤ ρ)
        (B.filtration_le_moyPrasad hZ x ⟨b, hb⟩ ρ hh))
  rcases hg with hg | hg <;> rcases hk with hk | hk
  · -- two central factors
    obtain ⟨z₁, hz₁, rfl⟩ := hg
    obtain ⟨z₂, hz₂, rfl⟩ := hk
    let := hZ.isCommMonObj
    have hcomm : Commute (rationalPoints.map B.centralizer.j z₁)
        (rationalPoints.map B.centralizer.j z₂) :=
      (Commute.all z₁ z₂).map (rationalPoints.map B.centralizer.j)
    rw [commutatorElement_def, hcomm.eq]
    simpa only [mul_assoc, mul_inv_cancel, mul_one] using
      (B.moyPrasad hZ x (r + s)).one_mem
  · -- a central factor and a root factor
    obtain ⟨b, hk⟩ := Set.mem_iUnion.mp hk
    have h := hZr x b r s g hg k hk
    rw [commutatorElement_def]
    exact B.block_subset_moyPrasad hZ x (r + s) b.2 h
  · -- a root factor and a central factor
    obtain ⟨b, hg⟩ := Set.mem_iUnion.mp hg
    have h := hZr x b s r k hk g hg
    rw [← commutatorElement_inv, add_comm]
    refine (B.moyPrasad hZ x (s + r)).inv_mem ?_
    rw [commutatorElement_def]
    exact B.block_subset_moyPrasad hZ x (s + r) b.2 h
  · -- two root factors
    obtain ⟨b, hg⟩ := Set.mem_iUnion.mp hg
    obtain ⟨b', hk⟩ := Set.mem_iUnion.mp hk
    classical
    by_cases hnon : ∀ t : ℝ, 0 < t →
        ((1 : ℝ) ⊗ₜ[ℤ] (b' : characterLattice B.S) : Vstar B.S) ≠
          -(t • (1 : ℝ) ⊗ₜ[ℤ] (b : characterLattice B.S))
    · -- non-opposite directions: V 3
      have hmem := B.apartment.filtration_commutator_le x b.2 b'.2 hnon r s
        (Subgroup.commutator_mem_commutator hg hk)
      refine (?_ : _ ≤ B.moyPrasad hZ x (r + s)) hmem
      refine iSup_le fun p => iSup_le fun q => iSup_le fun hp => iSup_le fun hq =>
        iSup_le fun hroot => ?_
      have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp
      have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
      have hdepth : ((r + s : NNReal) : ℝ) ≤ (p : ℝ) * r + (q : ℝ) * s := by
        push_cast
        nlinarith [r.coe_nonneg, s.coe_nonneg]
      exact (B.apartment.filtration_antitone x _ hdepth).trans
        (B.filtration_le_moyPrasad hZ x ⟨p • (b : characterLattice B.S) +
          q • (b' : characterLattice B.S), hroot⟩ (r + s))
    push Not at hnon
    obtain ⟨t, ht, heqt⟩ := hnon
    let : Smooth H.X.hom := B.isConnectedReductive.smooth
    have hT := B.isMaximalSplitTorus.isSplitSubtorus.1
    have hrank := rootRankOneFactorization (UnramifiedClosure F) H B.isConnectedReductive B.S B.i
      B.isMaximalSplitTorus
    have hnb : -(b' : characterLattice B.S) ∈ relativeRoots B.i :=
      KPApartmentData.neg_mem_relativeRoots_of_rankOne hT hrank x b'.2
    have heval : eval B.S (-(b' : characterLattice B.S)) =
        t • eval B.S (b : characterLattice B.S) := by
      apply LinearMap.ext
      intro w
      have h := congrArg (fun chi => pair B.S chi w) heqt
      simp only [map_neg, map_smul, LinearMap.neg_apply, LinearMap.smul_apply,
        smul_eq_mul, ← eval_eq_pair] at h
      rw [eval_neg_char, LinearMap.smul_apply, smul_eq_mul, h]
      ring
    rcases B.apartment.eq_or_double_of_eval_eq_smul hT
      (B.isAffineRootSystemWithRankZero_extendedAffineRoots (exists_order_eq_one F))
      B.derivativeRoots_extendedAffineRoots
      b.2 hnb ht heval with h | h | h
    · -- `b' = -b`
      have hb' : (b' : characterLattice B.S) = -(b : characterLattice B.S) := by
        rw [← h, neg_neg]
      have hk' : k ∈ B.filtration x (-(b : characterLattice B.S)) s := hb' ▸ hk
      exact B.commutator_opposite_mem_moyPrasad hZ hZcomm x b.2 r s hr hs hg hk'
        (hnorm _ _ b'.2 s hk)
    · -- `b' = -2b`
      have hb' : (b' : characterLattice B.S) = -(2 • (b : characterLattice B.S)) := by
        rw [← h, neg_neg]
      have h2b : 2 • (b : characterLattice B.S) ∈ relativeRoots B.i := h ▸ hnb
      have hk' : k ∈ B.filtration x (-(2 • (b : characterLattice B.S))) s := hb' ▸ hk
      exact B.commutator_double_opposite_mem_moyPrasad hZ hZcomm hZ2 x b.2 h2b r s hr hs hg hk'
        (hnorm _ _ b'.2 s hk)
    · -- `b = -2b'`
      have hb : (b : characterLattice B.S) = -(2 • (b' : characterLattice B.S)) := by
        rw [h, smul_neg]
      have h2b' : 2 • (b' : characterLattice B.S) ∈ relativeRoots B.i := by
        have hnegb : -(b : characterLattice B.S) ∈ relativeRoots B.i :=
          KPApartmentData.neg_mem_relativeRoots_of_rankOne hT hrank x b.2
        rwa [hb, neg_neg] at hnegb
      have hg' : g ∈ B.filtration x (-(2 • (b' : characterLattice B.S))) r := hb ▸ hg
      have hcomm := B.commutator_double_opposite_mem_moyPrasad hZ hZcomm hZ2 x b'.2 h2b' s r hs hr
        hk hg' (hnorm _ _ b.2 r hg)
      rw [← commutatorElement_inv, add_comm]
      exact (B.moyPrasad hZ x (s + r)).inv_mem hcomm

/-- Clause 3 of S2 follows from S1's first two clauses and the independent
actual doubled-root torus bound. -/
theorem localMoyPrasadCommutator_of_torus_commutator_bounds
    (hZcomm : B.LocalTorusCommutatorFriendly hZ)
    (hZ2 : B.LocalTorusDoubleRootCommutatorFriendly hZ)
    (hZr : B.LocalTorusRootCompatible hZ) :
    LocalMoyPrasadCommutator B hZ := by
  intro x r s
  have hnorm := B.localMoyPrasadNormality_of_torus_commutator_bounds hZ hZcomm hZ2 hZr
  by_cases hr0 : r = 0
  · subst r
    rw [zero_add]
    exact Subgroup.le_normalizer_iff_commutator_le_right.mp (hnorm x s)
  by_cases hs0 : s = 0
  · subst s
    rw [add_zero]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp (hnorm x r)
  have hr : 0 < r := lt_of_le_of_ne (zero_le : (0 : NNReal) ≤ r) (Ne.symm hr0)
  have hs : 0 < s := lt_of_le_of_ne (zero_le : (0 : NNReal) ≤ s) (Ne.symm hs0)
  have hgen : ∀ t : NNReal, (B.centralizerTorusImage hZ t : Set (rationalPoints H)) ∪
      ⋃ b : relativeRoots B.i, (B.filtration x b.1 t : Set (rationalPoints H)) ⊆
        B.moyPrasad hZ x 0 := by
    intro t
    refine Subgroup.subset_closure.trans ?_
    rw [← B.moyPrasad_eq_closure]
    exact B.moyPrasad_antitone hZ x (zero_le : (0 : NNReal) ≤ t)
  rw [B.moyPrasad_eq_closure hZ x r, B.moyPrasad_eq_closure hZ x s]
  exact commutator_closure_le_of_le_normalizer (hnorm x (r + s)) (hgen r) (hgen s)
    (fun g hg k hk =>
      B.generator_commutator_mem_moyPrasad hZ hZcomm hZ2 hZr x r s hr hs hg hk)

