import Langlands.Geometry.Building.AffineTransitiveRootLengths

/-! # The integral lattice generated by simple affine gradients -/

noncomputable section

universe uV uA

namespace Langlands.Geometry.Building.AffineRootSystem

open GalleryGeometry

variable {V : Type uV} {A : Type uA}
  [AddCommGroup V] [Module ℝ V] [AddTorsor V A]
  {Ψ : Set (A →ᵃ[ℝ] ℝ)}

/-- The integral span of all simple affine gradients of a chamber. -/
def simpleDerivativeLattice (Ψ : Set (A →ᵃ[ℝ] ℝ)) (C : Set A) :
    Submodule ℤ (Module.Dual ℝ V) :=
  Submodule.span ℤ (AffineMap.linear '' simpleAffineRoots Ψ C)

/-- Every full derivative root belongs to the integral span of the simple
affine gradients. Multipliable derivative roots are included. -/
def HasIntegralSimpleDerivativeSpan (Ψ : Set (A →ᵃ[ℝ] ℝ)) (C : Set A) : Prop :=
  derivativeRoots Ψ ⊆ simpleDerivativeLattice Ψ C

namespace IsAffineRootSystemWithRankZero

variable (hΨ : IsAffineRootSystemWithRankZero Ψ)
include hΨ

/-- Pullback by a simple affine reflection preserves the integral simple
derivative lattice. -/
theorem linear_comp_mem_simpleDerivativeLattice_of_simple_reflection
    {C : Set A} {η : A →ᵃ[ℝ] ℝ} (hη : η ∈ simpleAffineRoots Ψ C)
    {v : V} (hv : IsCoroot Ψ η v)
    {a : Module.Dual ℝ V} (ha : a ∈ simpleDerivativeLattice Ψ C) :
    a.comp (affineReflection η hv.1).linear.toLinearMap ∈
      simpleDerivativeLattice Ψ C := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨ψ, hψ, rfl⟩ := ha
    obtain ⟨n, hn⟩ := hΨ.coroot_integral ψ hψ.1.1 η hη.1.1 v hv
    have hcomp :
        ψ.linear.comp (affineReflection η hv.1).linear.toLinearMap =
          ψ.linear - n • η.linear := by
      have h := congrArg AffineMap.linear (comp_affineReflection η hv.1 ψ)
      simpa only [AffineMap.comp_linear, AffineMap.sub_linear, AffineMap.smul_linear,
        AffineEquiv.coe_linear, hn, Int.cast_smul_eq_zsmul] using h
    rw [hcomp]
    have hψL : ψ.linear ∈ simpleDerivativeLattice Ψ C :=
      Submodule.subset_span ⟨ψ, hψ, rfl⟩
    exact (simpleDerivativeLattice Ψ C).sub_mem hψL
      ((simpleDerivativeLattice Ψ C).smul_mem n
        (Submodule.subset_span ⟨η, hη, rfl⟩))
  | zero => simp
  | add x y _ _ hx hy =>
    simpa only [LinearMap.add_comp] using (simpleDerivativeLattice Ψ C).add_mem hx hy
  | smul n x _ hx =>
    simpa only [LinearMap.smul_comp] using (simpleDerivativeLattice Ψ C).smul_mem n hx

/-- Every product of chamber wall reflections preserves the integral lattice
of the chamber's simple affine gradients. -/
theorem linear_comp_mem_simpleDerivativeLattice_of_mem_wallClosure
    {c : A} (hc : IsRegular Ψ c) {w : A ≃ᵃ[ℝ] A}
    (hw : w ∈ Subgroup.closure (wallReflections Ψ c))
    {ψ : A →ᵃ[ℝ] ℝ} (hψ : ψ.linear ∈ simpleDerivativeLattice Ψ (facet Ψ c)) :
    (ψ.comp (w : A →ᵃ[ℝ] A)).linear ∈
      simpleDerivativeLattice Ψ (facet Ψ c) := by
  have hle : Subgroup.closure (wallReflections Ψ c) ≤
      rootStabilizer {φ : A →ᵃ[ℝ] ℝ |
        φ.linear ∈ simpleDerivativeLattice Ψ (facet Ψ c)} := by
    apply (Subgroup.closure_le _).mpr
    intro s hs
    obtain ⟨t, ⟨η, hη, v, hv, ht⟩, hts⟩ :=
      exists_chamberSimple_of_mem_wallReflections hΨ hc hs
    have hst : s = affineReflection η hv.1 := hts.symm.trans ht
    rw [hst]
    intro φ
    have key {ζ : A →ᵃ[ℝ] ℝ}
        (hζ : ζ.linear ∈ simpleDerivativeLattice Ψ (facet Ψ c)) :
        (ζ.comp (affineReflection η hv.1 : A →ᵃ[ℝ] A)).linear ∈
          simpleDerivativeLattice Ψ (facet Ψ c) := by
      exact hΨ.linear_comp_mem_simpleDerivativeLattice_of_simple_reflection hη hv hζ
    refine ⟨fun h => ?_, fun h => key h⟩
    have h := key h
    have heq :
        (φ.comp (affineReflection η hv.1 : A →ᵃ[ℝ] A)).comp
          (affineReflection η hv.1 : A →ᵃ[ℝ] A) = φ :=
      AffineMap.ext fun x => congrArg φ (affineReflection_involutive η hv.1 x)
    rwa [heq] at h
  exact (hle hw ψ).mpr hψ

/-- The conjugating map in the indivisible-root orbit theorem can be chosen
inside the subgroup generated by the prescribed chamber's wall reflections. -/
theorem exists_simple_eq_comp_or_neg_mem_wallClosure
    {c : A} (hc : IsRegular Ψ c) {ψ : A →ᵃ[ℝ] ℝ}
    (hψ : ψ ∈ nonDivisibleRoots Ψ) :
    ∃ w ∈ Subgroup.closure (wallReflections Ψ c),
      ∃ η ∈ simpleAffineRoots Ψ (facet Ψ c),
        ψ.comp (w : A →ᵃ[ℝ] A) = η ∨
          ψ.comp (w : A →ᵃ[ℝ] A) = -η := by
  obtain ⟨v, hv⟩ := hΨ.exists_isCoroot ψ hψ.1
  obtain ⟨w, hw, hwall⟩ := GalleryGeometry.exists_conjugate_mem_wallReflections
    hΨ.isLocallyFiniteReflectionArrangement hc hψ.1 hv
  have hwstab := GalleryGeometry.mem_rootStabilizer_of_mem_closure hw
  have htrans : IsCoroot Ψ (ψ.comp (w : A →ᵃ[ℝ] A)) (w⁻¹.linear v) := by
    simpa only [← AffineEquiv.inv_def, inv_inv] using hv.map (inv_mem hwstab)
  have hwall' : affineReflection (ψ.comp (w : A →ᵃ[ℝ] A)) htrans.1 ∈
      wallReflections Ψ c := by
    have href := conjugate_affineReflection w⁻¹ ψ hv.1
    simp only [← AffineEquiv.inv_def, inv_inv] at href
    rw [← href]
    exact hwall
  obtain ⟨η, hη, r, hprop⟩ :=
    exists_simple_smul_of_mem_wallReflections hΨ hc htrans hwall'
  have hφ := comp_mem_nonDivisibleRoots hwstab hψ
  have hr0 : r ≠ 0 := by
    intro hr
    apply hΨ.linear_ne_zero _ hφ.1
    rw [hprop, hr]
    simp
  refine ⟨w, hw, η, hη, ?_⟩
  rcases hr0.lt_or_gt with hr | hr
  · right
    have hn : -(ψ.comp (w : A →ᵃ[ℝ] A)) = η :=
      hΨ.eq_of_mem_nonDivisibleRoots_of_eq_smul hη.2.1
        (hΨ.neg_mem_nonDivisibleRoots hφ) (neg_pos.mpr hr) (by
          rw [hprop, neg_smul])
    exact neg_eq_iff_eq_neg.mp hn
  · left
    exact hΨ.eq_of_mem_nonDivisibleRoots_of_eq_smul hη.2.1 hφ hr hprop

/-- Every indivisible affine gradient is an integral combination of the
simple affine gradients of any prescribed chamber. -/
theorem linear_mem_simpleDerivativeLattice_of_indivisible
    {c : A} (hc : IsRegular Ψ c) {ψ : A →ᵃ[ℝ] ℝ}
    (hψ : ψ ∈ nonDivisibleRoots Ψ) :
    ψ.linear ∈ simpleDerivativeLattice Ψ (facet Ψ c) := by
  obtain ⟨w, hw, η, hη, hcomp⟩ :=
    hΨ.exists_simple_eq_comp_or_neg_mem_wallClosure hc hψ
  have hηL : η.linear ∈ simpleDerivativeLattice Ψ (facet Ψ c) :=
    Submodule.subset_span ⟨η, hη, rfl⟩
  have hψw : (ψ.comp (w : A →ᵃ[ℝ] A)).linear ∈
      simpleDerivativeLattice Ψ (facet Ψ c) := by
    rcases hcomp with h | h
    · rwa [h]
    · rw [h, AffineMap.neg_linear]
      exact (simpleDerivativeLattice Ψ (facet Ψ c)).neg_mem hηL
  have h := hΨ.linear_comp_mem_simpleDerivativeLattice_of_mem_wallClosure
    hc (inv_mem hw) hψw
  have heq : (ψ.comp (w : A →ᵃ[ℝ] A)).comp
      ((w⁻¹ : A ≃ᵃ[ℝ] A) : A →ᵃ[ℝ] A) = ψ :=
    AffineMap.ext fun x => congrArg ψ (w.apply_symm_apply x)
  rwa [heq] at h

/-- Indivisible lifts of all full derivative roots imply integral generation
by the simple affine gradients. No transitivity or reducedness is needed. -/
theorem hasIntegralSimpleDerivativeSpan_of_indivisible_lifts
    {c : A} (hc : IsRegular Ψ c) (hlift : HasIndivisibleDerivativeLifts Ψ) :
    HasIntegralSimpleDerivativeSpan Ψ (facet Ψ c) := by
  intro a ha
  obtain ⟨ψ, hψ, hlin⟩ := hlift ⟨a, ha⟩
  change ψ.linear = a at hlin
  rw [← hlin]
  exact hΨ.linear_mem_simpleDerivativeLattice_of_indivisible hc hψ

end IsAffineRootSystemWithRankZero

end Langlands.Geometry.Building.AffineRootSystem
