import Langlands.Geometry.Building.ParahoricNonnegativeRootGenerators
import Langlands.Geometry.Building.IntegerValuationAffineWeylProof
import Langlands.Geometry.Building.IntegerRootReflections
import Langlands.Geometry.Building.IntegerAffineRootLocalFiniteness
import Langlands.Geometry.Building.AffineRootDoubling
import Langlands.Geometry.Building.MaximalUnramifiedUniformizer
import Langlands.Geometry.Building.UnramifiedSharpFixerRootGenerationStatement

/-!
# Sharp fixers generated by nonnegative affine root groups, for integer-valued data

For building data `B : IntegerValuationBuildingData v G` over any field with an integer-valued
valuation having a unit of order one, this module shows that the group
`G(k)^♯_Ω = ⟨U_{a,Ω,0} | a ∈ Φ⟩` of KP Definition 7.4.1(2) is generated by the actual affine
root groups `U_ψ` for `ψ ∈ Ψ` nonnegative on `Ω` (KP Lemma 7.4.4(3)), provided every
multipliable relative root `a` (with `2a ∈ Φ`) is the derivative of some `ψ ∈ Ψ`. This
proviso holds when the derivative set of `Ψ` is `Φ` (KP Proposition 6.3.13). The module does
not prove the proviso.

* `IntegerValuationBuildingData.mem_affineRootGroup_iff_reflectionFunctional`: the corrected
  AS 3, `U_ψ = {u ∈ U_a(k) ∖ {1} | ψ^u_a ≥ ψ} ∪ {1}`, and its `U_{ψ+}` analogue.
* `IntegerValuationBuildingData.affineRootGroup_le_rootFixer`: `U_ψ ⊆ U_{a,Ω,0}` for `ψ` with
  derivative `a` nonnegative on `Ω`.
* `IntegerValuationBuildingData.rootFixer_le_nonnegativeAffineRootGroups`: each
  `U_{a,Ω,0}` lies in the subgroup generated by the `U_ψ`, `ψ ∈ Ψ` nonnegative on `Ω`.
* `IntegerValuationBuildingData.sharpFixer_eq_iSup_affineRootGroup`: the generation equality
  under the multipliable-lift hypothesis, and
  `IntegerValuationBuildingData.sharpFixer_eq_iSup_affineRootGroup_of_derivativeRoots` under
  `∇Ψ = Φ`.
* `unramifiedSharpFixerRootGeneration_of_derivativeRoots`: the published target
  `UnramifiedSharpFixerRootGenerationStatement` over `K = inertiaFixedField F`, assuming
  `∇Ψ = Φ` for every supplied datum over `K`.

The proof is a port of `ParahoricNonnegativeRootGenerators` (the local-field case) to integer
valued data. It uses only the supplied valuation axioms, the actual rank-one factorizations
(`hasOppositeFactorPairs`) and the Library's affine-root-system and local-finiteness theorems
for integer-valued data.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped Pointwise CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

namespace IntegerValuationBuildingData

variable {k : Type u} [Field k]
    {v : Valuation k (WithZero (Multiplicative ℤ))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (B : IntegerValuationBuildingData v G)

/-- The corrected AS 3: `U_ψ = {u ∈ U_a(k) ∖ {1} | ψ^u_a ≥ ψ} ∪ {1}`. -/
theorem mem_affineRootGroup_iff_reflectionFunctional {α : relativeRoots B.i}
    {ψ : B.Apartment →ᵃ[ℝ] ℝ} (hψ : ψ.linear = rootForm B.i α) {u : rationalPoints G} :
    u ∈ B.affineRootGroup α ψ ↔
      u = 1 ∨ (u ∈ B.rootGroup α ∧ u ≠ 1 ∧ ∀ x, ψ x ≤ B.reflectionFunctional α u x) := by
  constructor
  · intro h
    by_cases h1 : u = 1
    · exact Or.inl h1
    · have hu := (KPApartmentData.mem_affineRootGroup_iff hψ
        (Classical.arbitrary B.Apartment)).1 h
      refine Or.inr ⟨hu.1, h1, fun x => ?_⟩
      have hx := ((KPApartmentData.mem_affineRootGroup_iff hψ x).1 h).2
      rw [← B.coe_reflectionFunctional_apply hu.1 h1 x] at hx
      exact WithTop.coe_le_coe.1 hx
  · rintro (rfl | ⟨hu, h1, hle⟩)
    · exact (B.affineRootGroup α ψ).one_mem
    · have x : B.Apartment := Classical.arbitrary B.Apartment
      refine (KPApartmentData.mem_affineRootGroup_iff hψ x).2 ⟨hu, ?_⟩
      rw [← B.coe_reflectionFunctional_apply hu h1 x]
      exact WithTop.coe_le_coe.2 (hle x)

/-- The corrected AS 3 for `U_{ψ+}`: `U_{ψ+} = {u ∈ U_a(k) ∖ {1} | ψ^u_a > ψ} ∪ {1}`. -/
theorem mem_affineRootGroupPlus_iff_reflectionFunctional {α : relativeRoots B.i}
    {ψ : B.Apartment →ᵃ[ℝ] ℝ} (hψ : ψ.linear = rootForm B.i α) {u : rationalPoints G} :
    u ∈ B.apartment.affineRootGroupPlus α ψ ↔
      u = 1 ∨ (u ∈ B.rootGroup α ∧ u ≠ 1 ∧ ∀ x, ψ x < B.reflectionFunctional α u x) := by
  constructor
  · intro h
    by_cases h1 : u = 1
    · exact Or.inl h1
    · have hu := (KPApartmentData.mem_affineRootGroupPlus_iff hψ
        (Classical.arbitrary B.Apartment)).1 h
      refine Or.inr ⟨hu.1, h1, fun x => ?_⟩
      have hx := ((KPApartmentData.mem_affineRootGroupPlus_iff hψ x).1 h).2
      rw [← B.coe_reflectionFunctional_apply hu.1 h1 x] at hx
      exact WithTop.coe_lt_coe.1 hx
  · rintro (rfl | ⟨hu, h1, hlt⟩)
    · exact (B.apartment.affineRootGroupPlus α ψ).one_mem
    · have x : B.Apartment := Classical.arbitrary B.Apartment
      refine (KPApartmentData.mem_affineRootGroupPlus_iff hψ x).2 ⟨hu, ?_⟩
      rw [← B.coe_reflectionFunctional_apply hu h1 x]
      exact WithTop.coe_lt_coe.2 (hlt x)

/-- `U_ψ ⊆ U_{a,Ω,0}` when `ψ` has derivative `a` and is non-negative on `Ω`. -/
theorem affineRootGroup_le_rootFixer {Ω : Set B.Apartment} {α : relativeRoots B.i}
    {ψ : B.Apartment →ᵃ[ℝ] ℝ} (hψ : ψ.linear = rootForm B.i α) (hΩ : ∀ x ∈ Ω, 0 ≤ ψ x) :
    B.affineRootGroup α ψ ≤ B.rootFixer α Ω := by
  intro u h
  rw [B.apartment.mem_rootFixer]
  have hu := (KPApartmentData.mem_affineRootGroup_iff hψ (Classical.arbitrary B.Apartment)).1 h
  refine ⟨hu.1, fun x hx => KPApartmentData.mem_filtration.2 ⟨hu.1, ?_⟩⟩
  have hle := ((KPApartmentData.mem_affineRootGroup_iff hψ x).1 h).2
  exact le_trans (WithTop.coe_le_coe.2 (hΩ x hx)) hle

/-- The subgroup generated by the actual affine root groups `U_ψ` for `ψ ∈ Ψ` with derivative a
relative root and non-negative on `Ω`: the right-hand side of KP Lemma 7.4.4(3). -/
def nonnegativeAffineRootGroups (Ω : Set B.Apartment) : Subgroup (rationalPoints G) :=
  ⨆ (a : relativeRoots B.i) (ψ : B.Apartment →ᵃ[ℝ] ℝ)
    (_ : ψ ∈ B.affineRoots) (_ : ψ.linear = rootForm B.i a)
    (_ : ∀ x ∈ Ω, 0 ≤ ψ x), B.affineRootGroup a ψ

/-- A generator of `B.nonnegativeAffineRootGroups Ω`. -/
theorem affineRootGroup_le_nonnegativeAffineRootGroups {Ω : Set B.Apartment}
    {α : relativeRoots B.i} {ψ : B.Apartment →ᵃ[ℝ] ℝ} (hψ : ψ ∈ B.affineRoots)
    (hlin : ψ.linear = rootForm B.i α) (hΩ : ∀ x ∈ Ω, 0 ≤ ψ x) :
    B.affineRootGroup α ψ ≤ B.nonnegativeAffineRootGroups Ω :=
  le_iSup_of_le α <| le_iSup_of_le ψ <| le_iSup_of_le hψ <| le_iSup_of_le hlin <|
    le_iSup_of_le hΩ le_rfl

/-- Two affine functionals with the same derivative compare in the same way at every point. -/
private theorem le_of_linear_eq {f g : B.Apartment →ᵃ[ℝ] ℝ} (h : f.linear = g.linear)
    {x₀ : B.Apartment} (hx₀ : f x₀ ≤ g x₀) (x : B.Apartment) : f x ≤ g x := by
  have hc := AffineRootSystem.apply_eq_apply_of_linear_eq_zero (f := g - f)
    (by rw [AffineMap.sub_linear, h, sub_self]) x x₀
  simp only [AffineMap.coe_sub, Pi.sub_apply] at hc
  linarith

/-- `u ∈ U_ψ` for `ψ = ψ^u_a` and `u ∈ U_a(k) ∖ {1}`. -/
theorem mem_affineRootGroup_reflectionFunctional {α : relativeRoots B.i}
    {g : rationalPoints G} (hg : g ∈ B.rootGroup α) (hg1 : g ≠ 1) :
    g ∈ B.affineRootGroup α (B.reflectionFunctional α g) :=
  (B.mem_affineRootGroup_iff_reflectionFunctional (B.reflectionFunctional_linear α g)).2
    (Or.inr ⟨hg, hg1, fun _ => le_rfl⟩)

/-- A root `b` with `2b ∉ Φ`: if `φ` has derivative `b` and is non-negative on `Ω`, then
`U_φ ⊆ B.nonnegativeAffineRootGroups Ω`. Each `u ∈ U_φ ∖ {1}` lies in `U_ψ` for
`ψ = ψ^u_b ≥ φ`, and `ψ ∈ Ψ` since `U_ψ` jumps at `u` and `2b` is not a root. -/
theorem affineRootGroup_le_nonnegativeAffineRootGroups_of_not_double {Ω : Set B.Apartment}
    {β : relativeRoots B.i} (h2b : 2 • (β : characterLattice B.S) ∉ relativeRoots B.i)
    {φ : B.Apartment →ᵃ[ℝ] ℝ} (hlin : φ.linear = rootForm B.i β) (hΩ : ∀ x ∈ Ω, 0 ≤ φ x) :
    B.affineRootGroup β φ ≤ B.nonnegativeAffineRootGroups Ω := by
  intro g hg
  rcases (B.mem_affineRootGroup_iff_reflectionFunctional hlin).1 hg with rfl | ⟨hgβ, hg1, hge⟩
  · exact (B.nonnegativeAffineRootGroups Ω).one_mem
  have hψlin := B.reflectionFunctional_linear β g
  have hjump : B.apartment.affineRootGroupPlus β (B.reflectionFunctional β g) ≠
      B.apartment.affineRootGroup β (B.reflectionFunctional β g) := by
    intro heq
    have x : B.Apartment := Classical.arbitrary B.Apartment
    have hmem := B.mem_affineRootGroup_reflectionFunctional hgβ hg1
    change g ∈ B.apartment.affineRootGroup β (B.reflectionFunctional β g) at hmem
    rw [← heq, KPApartmentData.mem_affineRootGroupPlus_iff hψlin x,
      B.coe_reflectionFunctional_apply hgβ hg1 x] at hmem
    exact lt_irrefl _ hmem.2
  exact B.affineRootGroup_le_nonnegativeAffineRootGroups
    (KPApartmentData.mem_affineRoots_of_not_double_root B.apartment h2b hψlin hjump) hψlin
    (fun x hx => (hΩ x hx).trans (hge x)) (B.mem_affineRootGroup_reflectionFunctional hgβ hg1)

/-- A root `a` with `2a ∈ Φ` that is the derivative of some `ψ₁ ∈ Ψ`: if `φ` has derivative
`a` and is non-negative on `Ω`, then `U_φ ⊆ B.nonnegativeAffineRootGroups Ω`. Suppose not, and
take a bad `v ∈ U_φ` for which `ψ^v_a` is largest (there are finitely many values between `φ`
and a root `ψ ∈ Ψ` above `φ`, whose `U_ψ` is a generator). If `ψ^v_a ∉ Ψ`, then `v = v′ w`
with `v′ ∈ U_{ψ^v_a +}` and `w ∈ U_{2a, 2ψ^v_a}`; `w` is in the subgroup since `4a ∉ Φ`, so
`v′` is bad and larger. -/
theorem affineRootGroup_le_nonnegativeAffineRootGroups_of_double
    (hunit : ∃ t : kˣ, IntegerValuation.order v t = 1) {Ω : Set B.Apartment}
    {α : relativeRoots B.i} (h2a : 2 • (α : characterLattice B.S) ∈ relativeRoots B.i)
    (hlift : ∃ ψ₁ ∈ B.affineRoots, ψ₁.linear = rootForm B.i α)
    {φ : B.Apartment →ᵃ[ℝ] ℝ} (hlin : φ.linear = rootForm B.i α) (hΩ : ∀ x ∈ Ω, 0 ≤ φ x) :
    B.affineRootGroup α φ ≤ B.nonnegativeAffineRootGroups Ω := by
  classical
  have : Smooth G.X.hom := B.isConnectedReductive.smooth
  have hF := B.hasOppositeFactorPairs
  have hS : IsSplitTorus B.S.toGrp := B.isMaximalSplitTorus.isSplitSubtorus.1
  have h4a : 2 • (2 • (α : characterLattice B.S)) ∉ relativeRoots B.i := by
    simpa only [smul_smul, show (2 : ℕ) * 2 = 4 from rfl] using
      KPApartmentData.no_quadruple_root_of_oppositePairs hS hF α α.property
  set H := B.nonnegativeAffineRootGroups Ω with hH
  have x₀ : B.Apartment := Classical.arbitrary B.Apartment
  -- A root `ψ_top ∈ Ψ` with derivative `a` lying above `φ`.
  obtain ⟨ψ₁, hψ₁, hψ₁lin⟩ := hlift
  obtain ⟨ψt, hψt, hψtlin, hψtx⟩ :=
    (B.isAffineRootSystemWithRankZero_affineRoots hunit).exists_le_apply hψ₁ x₀ (φ x₀)
  rw [hψ₁lin] at hψtlin
  have htopH : B.affineRootGroup α ψt ≤ H :=
    B.affineRootGroup_le_nonnegativeAffineRootGroups hψt hψtlin fun x hx =>
      (hΩ x hx).trans (B.le_of_linear_eq (hlin.trans hψtlin.symm) hψtx x)
  -- The bad elements and their finitely many functionals.
  by_contra hbad
  rw [SetLike.not_le_iff_exists] at hbad
  obtain ⟨v₀, hv₀, hv₀H⟩ := hbad
  let Bad : Set (rationalPoints G) := {v | v ∈ B.affineRootGroup α φ ∧ v ∉ H}
  have hBad : ∀ v ∈ Bad,
      v ∈ B.rootGroup α ∧ v ≠ 1 ∧ ∀ x, φ x ≤ B.reflectionFunctional α v x := by
    rintro v ⟨hv, hvH⟩
    rcases (B.mem_affineRootGroup_iff_reflectionFunctional hlin).1 hv with rfl | h
    · exact absurd H.one_mem hvH
    · exact h
  let T := (fun v => B.reflectionFunctional α v) '' Bad
  have hT : T.Finite := by
    refine (B.finite_bounded_reflectionFunctionals_of_oppositePairs hF α x₀
      (max |φ x₀| |ψt x₀|)).subset ?_
    rintro _ ⟨v, hvBad, rfl⟩
    obtain ⟨hv, hv1, hge⟩ := hBad v hvBad
    refine ⟨v, hv, hv1, rfl, ?_⟩
    have hlt : B.reflectionFunctional α v x₀ < ψt x₀ := by
      by_contra hge'
      push Not at hge'
      refine hvBad.2 (htopH ((B.mem_affineRootGroup_iff_reflectionFunctional hψtlin).2
        (Or.inr ⟨hv, hv1, B.le_of_linear_eq ?_ hge'⟩)))
      rw [hψtlin, B.reflectionFunctional_linear]
    have hge0 := hge x₀
    exact abs_le.2 ⟨by linarith [neg_abs_le (φ x₀), le_max_left |φ x₀| |ψt x₀|],
      by linarith [le_abs_self (ψt x₀), le_max_right |φ x₀| |ψt x₀|]⟩
  obtain ⟨_, ⟨v, hvBad, rfl⟩, hmax⟩ :=
    Set.exists_max_image T (fun f => f x₀) hT ⟨_, ⟨v₀, ⟨hv₀, hv₀H⟩, rfl⟩⟩
  obtain ⟨hv, hv1, hge⟩ := hBad v hvBad
  have hψvlin := B.reflectionFunctional_linear α v
  have hvψv := B.mem_affineRootGroup_reflectionFunctional hv hv1
  have hΩv : ∀ x ∈ Ω, 0 ≤ B.reflectionFunctional α v x := fun x hx => (hΩ x hx).trans (hge x)
  by_cases hψvΨ : B.reflectionFunctional α v ∈ B.affineRoots
  · exact hvBad.2 (B.affineRootGroup_le_nonnegativeAffineRootGroups hψvΨ hψvlin hΩv hvψv)
  obtain ⟨v', hv', w, hw, hvw⟩ :=
    B.apartment.affineRootGroup_subset_mul_double_of_not_mem_affineRoots h2a hψvlin hψvΨ hvψv
  replace hvw : v' * w = v := hvw
  -- The factor in `U_{2a}` lies in the subgroup.
  have hlin2 : ((2 : ℝ) • B.reflectionFunctional α v).linear =
      rootForm B.i ⟨2 • (α : characterLattice B.S), h2a⟩ := by
    rw [AffineMap.smul_linear, hψvlin, rootForm_nsmul α.property 2 h2a]
    norm_num
  have hwH : w ∈ H :=
    B.affineRootGroup_le_nonnegativeAffineRootGroups_of_not_double
      (β := ⟨2 • (α : characterLattice B.S), h2a⟩) h4a hlin2 (fun x hx => by
        simp only [AffineMap.coe_smul, Pi.smul_apply, smul_eq_mul]
        linarith [hΩv x hx]) hw
  -- The factor in `U_{ψ^v_a +}` is bad with a larger functional.
  rcases (B.mem_affineRootGroupPlus_iff_reflectionFunctional hψvlin).1 hv' with
    rfl | ⟨hv'r, hv'1, hlt⟩
  · apply hvBad.2
    rw [← hvw, one_mul]
    exact hwH
  have hv'Bad : v' ∈ Bad := by
    refine ⟨(B.mem_affineRootGroup_iff_reflectionFunctional hlin).2
      (Or.inr ⟨hv'r, hv'1, fun x => (hge x).trans (hlt x).le⟩), fun hv'H => hvBad.2 ?_⟩
    rw [← hvw]
    exact H.mul_mem hv'H hwH
  exact absurd (hlt x₀) (not_lt.2 (hmax _ ⟨v', hv'Bad, rfl⟩))

/-- `U_{a,Ω,0} ⊆ B.nonnegativeAffineRootGroups Ω` when every multipliable root is the
derivative of an affine root: each `u ∈ U_{a,Ω,0} ∖ {1}` lies in `U_ψ` for `ψ = ψ^u_a`,
which is non-negative on `Ω`. -/
theorem rootFixer_le_nonnegativeAffineRootGroups
    (hunit : ∃ t : kˣ, IntegerValuation.order v t = 1)
    (hlift : ∀ α : relativeRoots B.i, 2 • (α : characterLattice B.S) ∈ relativeRoots B.i →
      ∃ ψ ∈ B.affineRoots, ψ.linear = rootForm B.i α)
    (α : relativeRoots B.i) (Ω : Set B.Apartment) :
    B.rootFixer α Ω ≤ B.nonnegativeAffineRootGroups Ω := by
  intro g hg
  by_cases hg1 : g = 1
  · rw [hg1]
    exact (B.nonnegativeAffineRootGroups Ω).one_mem
  rw [B.apartment.mem_rootFixer] at hg
  have hΩ : ∀ x ∈ Ω, 0 ≤ B.reflectionFunctional α g x := by
    intro x hx
    have h0 := (KPApartmentData.mem_filtration.1 (hg.2 x hx)).2
    rw [← B.coe_reflectionFunctional_apply hg.1 hg1 x] at h0
    exact WithTop.coe_le_coe.1 h0
  have hmem := B.mem_affineRootGroup_reflectionFunctional hg.1 hg1
  by_cases h2a : 2 • (α : characterLattice B.S) ∈ relativeRoots B.i
  · exact B.affineRootGroup_le_nonnegativeAffineRootGroups_of_double hunit h2a (hlift α h2a)
      (B.reflectionFunctional_linear α g) hΩ hmem
  · exact B.affineRootGroup_le_nonnegativeAffineRootGroups_of_not_double h2a
      (B.reflectionFunctional_linear α g) hΩ hmem

/-- The root-group part of KP Lemma 7.4.4(3) for integer-valued data: if `v` has a unit of
order one and every multipliable root is the derivative of an affine root, then for every
`Ω ⊆ A(S)` the group `G(k)^♯_Ω` is generated by the `U_ψ` for `ψ ∈ Ψ` non-negative on `Ω`. -/
theorem sharpFixer_eq_iSup_affineRootGroup
    (hunit : ∃ t : kˣ, IntegerValuation.order v t = 1)
    (hlift : ∀ α : relativeRoots B.i, 2 • (α : characterLattice B.S) ∈ relativeRoots B.i →
      ∃ ψ ∈ B.affineRoots, ψ.linear = rootForm B.i α)
    (Ω : Set B.Apartment) :
    B.sharpFixer Ω =
      ⨆ (a : relativeRoots B.i) (ψ : B.Apartment →ᵃ[ℝ] ℝ)
        (_ : ψ ∈ B.affineRoots) (_ : ψ.linear = rootForm B.i a)
        (_ : ∀ x ∈ Ω, 0 ≤ ψ x), B.affineRootGroup a ψ := by
  refine le_antisymm (iSup_le fun α => B.rootFixer_le_nonnegativeAffineRootGroups hunit hlift α Ω)
    (iSup_le fun α => iSup_le fun ψ => iSup_le fun _ => iSup_le fun hlin => iSup_le fun hΩ =>
      (B.affineRootGroup_le_rootFixer hlin hΩ).trans (B.apartment.rootFixer_le_sharpFixer α Ω))

/-- The same equality when the derivative set of `Ψ` is `Φ` (KP Proposition 6.3.13). -/
theorem sharpFixer_eq_iSup_affineRootGroup_of_derivativeRoots
    (hunit : ∃ t : kˣ, IntegerValuation.order v t = 1)
    (hder : AffineRootSystem.derivativeRoots B.affineRoots = Set.range (rootForm B.i))
    (Ω : Set B.Apartment) :
    B.sharpFixer Ω =
      ⨆ (a : relativeRoots B.i) (ψ : B.Apartment →ᵃ[ℝ] ℝ)
        (_ : ψ ∈ B.affineRoots) (_ : ψ.linear = rootForm B.i a)
        (_ : ∀ x ∈ Ω, 0 ≤ ψ x), B.affineRootGroup a ψ := by
  refine B.sharpFixer_eq_iSup_affineRootGroup hunit (fun α _ => ?_) Ω
  have h : rootForm B.i α ∈ AffineRootSystem.derivativeRoots B.affineRoots := by
    rw [hder]
    exact ⟨α, rfl⟩
  exact AffineRootSystem.mem_derivativeRoots.1 h

end IntegerValuationBuildingData

/-- `UnramifiedSharpFixerRootGenerationStatement` (KP Lemma 7.4.4(3) over
`K = inertiaFixedField F`), assuming that for every supplied datum over `K` the derivative set
of the affine roots `Ψ` is the relative root system `Φ` (KP Proposition 6.3.13). -/
theorem unramifiedSharpFixerRootGeneration_of_derivativeRoots
    (hder : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F]
      (H : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F))))
      [IsAffineHom H.X.hom] (C : MaximalUnramified.BuildingData F H),
      AffineRootSystem.derivativeRoots C.affineRoots = Set.range (rootForm C.i)) :
    UnramifiedSharpFixerRootGenerationStatement.{u} := by
  intro F _ _ _ _ H _ C Ω _
  exact C.sharpFixer_eq_iSup_affineRootGroup_of_derivativeRoots
    (MaximalUnramified.exists_order_eq_one F) (hder F H C) Ω

end Langlands.Geometry.Building
