import Langlands.Geometry.Building.UnramifiedFixedLeviTransportStatement
import Langlands.Geometry.Building.RootValueTorusLeviTransport
import Langlands.Geometry.Building.RootFunctionFieldEquivariance

/-! # Normalizer transport of Galois-fixed points from Levi transport

Let `K/k` be a field extension, `S ⊆ T` tori of `G` over `k` and `D` an apartment class of
`(G_K, T_K)`. If `n ∈ N_G(S)(k)` and `h ∈ G(K)` centralizes `S_K`, lies in the subgroup
generated by the groups `U_{χ,x,0}` for the roots `χ` of `T_K` vanishing on `S_K`, and
`w = n h` normalizes `T_K`, then `w · x` represents `n · [x]` in the reduced building of `G_K`,
and restricting `w · x` from `T_K` to `S_K` and from `K` to `k` gives `n` applied to the
restriction of `x`. With `UnramifiedFixedLeviTransportStatement` this gives clause 4 of
`UnramifiedValuationDescentStatement`.
-/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.GaloisPointComparison
open Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

section General

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom] [Smooth G.X.hom]
  {S T : CommGroupScheme (Spec (CommRingCat.of k))}

local notation "b" => algebraBaseMap k K
local notation "S_K" => CategoryTheory.Functor.obj (CommGroupScheme.baseChange b) S
local notation "T_K" => CategoryTheory.Functor.obj (CommGroupScheme.baseChange b) T
local notation "G_K" => baseChanged k K G

private instance leviTransportExtendedAffine : IsAffineHom (G_K).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom b)
  infer_instance

private instance leviTransportExtendedSmooth : Smooth (G_K).X.hom := by
  change Smooth (CategoryTheory.Limits.pullback.snd G.X.hom b)
  infer_instance

private instance leviTransportExtendedMono (iS : S.toGrp ⟶ G) [Mono iS.hom.hom.left] :
    Mono ((GroupScheme.baseChange b).map iS).hom.hom.left := by
  let : Mono iS.hom.hom := Over.mono_of_mono_left _
  change Mono ((Over.pullback b).map iS.hom.hom).left
  infer_instance

/-- **Normalizer transport through the Levi subgroup.** Let `D` be an apartment class of
`(G_K, T_K)`, `n ∈ N_G(S)(k)` and `x` a point of the apartment of `D`. If `h ∈ G(K)`
centralizes `S_K`, lies in the subgroup generated by the `U_{χ,x,0}` for the roots `χ` of
`T_K` vanishing on `S_K`, and `w = n h` normalizes `T_K`, then `[w · x] = n · [x]` in the
reduced building of `G_K`, and the torus-then-field restriction of `w · x` is `n` applied to
that of `x`. -/
theorem KPApartmentData.leviTransport_apartmentMap_torusFieldRestricted
    {iS : S.toGrp ⟶ G} [Mono iS.hom.hom.left] {iT : T.toGrp ⟶ G} {f : S ⟶ T}
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    [Mono ((GroupScheme.baseChange b).map iT).hom.hom.left]
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus (T_K).toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs (T := T_K) ((GroupScheme.baseChange b).map iT))
    {ω : Kˣ → ℝ} (D : KPApartmentData (S := T_K) ((GroupScheme.baseChange b).map iT) ω)
    (n : normalizerPoints iS) (x : D.Apartment) {h : rationalPoints (G_K)}
    (hh : h ∈ centralizerPoints (T := S_K) ((GroupScheme.baseChange b).map iS))
    (hlevi : h ∈ ⨆ (χ : characterLattice (T_K))
      (_ : χ ∈ relativeRoots (T := T_K) ((GroupScheme.baseChange b).map iT))
      (_ : (CommGroupScheme.baseChange b).map f ≫ χ = 0), D.filtration x χ 0)
    (hw : rationalExtend k K G (n : rationalPoints G) * h ∈
      normalizerPoints (T := T_K) ((GroupScheme.baseChange b).map iT)) :
    D.apartmentMap ((⟨_, hw⟩ : normalizerPoints (T := T_K)
        ((GroupScheme.baseChange b).map iT)) • x) =
        rationalExtend k K G (n : rationalPoints G) • D.apartmentMap x ∧
      torusFieldRestrictedRootFunctionFamily (k := k) (K := K) hS hT hE
          (D.isRootDatumValuation_of_mem ((⟨_, hw⟩ : normalizerPoints (T := T_K)
            ((GroupScheme.baseChange b).map iT)) • x).mem)
          ((CommGroupScheme.baseChange b).map f) =
        n • torusFieldRestrictedRootFunctionFamily (k := k) (K := K) hS hT hE
          (D.isRootDatumValuation_of_mem x.mem) ((CommGroupScheme.baseChange b).map f) := by
  set w : normalizerPoints (T := T_K) ((GroupScheme.baseChange b).map iT) := ⟨_, hw⟩ with hwdef
  have hle : (⨆ (χ : characterLattice (T_K))
      (_ : χ ∈ relativeRoots (T := T_K) ((GroupScheme.baseChange b).map iT))
      (_ : (CommGroupScheme.baseChange b).map f ≫ χ = 0), D.filtration x χ 0) ≤
        D.sharpFixer {x} :=
    iSup_le fun χ => iSup_le fun hχ => iSup_le fun _ => by
      rw [← D.rootFixer_singleton]
      exact D.rootFixer_le_sharpFixer ⟨χ, hχ⟩ {x}
  have hsharp : h ∈ D.sharpFixer {x} := hle hlevi
  refine ⟨?_, ?_⟩
  · rw [D.apartmentMap_smul]
    change (rationalExtend k K G (n : rationalPoints G) * h) • D.apartmentMap x = _
    rw [mul_smul, D.mem_reducedFixer.1 (D.sharpFixer_le_reducedFixer x hsharp)]
  · have hfK : CommGroupScheme.groupHom ((CommGroupScheme.baseChange b).map f) ≫
        (GroupScheme.baseChange b).map iT = (GroupScheme.baseChange b).map iS := by
      rw [← hf, Functor.map_comp]
      rfl
    have key := torusRestrictedRootFunctionFamily_smul_of_eq_mul (hS.baseChange b) hT hE
      ((CommGroupScheme.baseChange b).map f) hfK x.isValuation
      (normalizerPointsFieldExtend (K := K) iS n) w hh hlevi rfl
      (D.isRootDatumValuation_of_mem (w • x).mem)
    unfold torusFieldRestrictedRootFunctionFamily
    rw [key]
    exact RootFunctionFamily.fieldRestrict_normalizer iS n _

end General

section Unramified

set_option maxHeartbeats 1600000 in
/-- **Clause 4 of `UnramifiedValuationDescentStatement` from Levi transport.** Under the
hypotheses of the target, `UnramifiedFixedLeviTransportStatement` moves every
`Aut(K/F)`-fixed point `x` by `n ∈ N_G(S)(F)` to an `Aut(K/F)`-fixed point `y` with
`[y] = n · [x]` in the reduced building of `G_K` and `φ y = n • φ x`. -/
theorem unramifiedFixedNormalizerTransport_of_leviTransport
    (hQ : UnramifiedFixedLeviTransportStatement.{u})
    (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    [IsAffineHom G.X.hom] [Smooth G.X.hom]
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (iS : S.toGrp ⟶ G)
    (hiS : IsMaximalSplitTorus iS) [Mono iS.hom.hom.left]
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (iT : T.toGrp ⟶ G) (f : S ⟶ T)
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    (hiT : IsMaximalSplitTorus
        (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
        ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    [Mono ((GroupScheme.baseChange
          (algebraBaseMap F (inertiaFixedField F))).map iT).hom.hom.left]
    (hE : RelativeRoot.HasOppositeFactorPairs
          (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
          ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    (D : KPApartmentData
          (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
          ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)
          (IntegerValuation.order (MaximalUnramified.valuation F)))
    (C : CentralizerDatum
          (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
          ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    (hDC : IntegerValuation.IsOmegaCompatible (MaximalUnramified.valuation F) D C)
    (n : normalizerPoints iS) (x : D.Apartment)
    (hx : ∀ σ : inertiaFixedField F ≃ₐ[F] inertiaFixedField F,
      RootFunctionFamily.galoisAction F (inertiaFixedField F) T G σ x.val = x.val) :
    ∃ y : D.Apartment,
      (∀ σ : inertiaFixedField F ≃ₐ[F] inertiaFixedField F,
        RootFunctionFamily.galoisAction F (inertiaFixedField F) T G σ y.val = y.val) ∧
      D.apartmentMap y =
        (show rationalPoints ((GroupScheme.baseChange
            (algebraBaseMap F (inertiaFixedField F))).obj G) from
          rationalExtend F (inertiaFixedField F) G (n : rationalPoints G)) •
          D.apartmentMap x ∧
      torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
          hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem y.mem)
          ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) =
        n • torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
          hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem x.mem)
          ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) := by
  obtain ⟨h, hh, hlevi, hw, hy⟩ := hQ F G hG S iS hiS T iT f hf hiT D C hDC n x hx
  exact ⟨_, hy, D.leviTransport_apartmentMap_torusFieldRestricted hf hiS.isSplitSubtorus.1
    hiT.isSplitSubtorus.1 hE n x hh hlevi hw⟩

end Unramified

end Langlands.Geometry.Building
