/-! # Proof of the filtered rank-one two-cell decomposition (KP Lemma 7.1.5(3)) -/

universe u

open Langlands.GroupScheme

namespace Langlands.Geometry.Building

/-- **KP Lemma 7.1.5(3)** on the actual apartment of building data, at arbitrary universe:
the subgroup generated by `U_ψ`, `U_{-ψ}` and `Z(F)^0` contains a normalizer point acting as
the reflection of `ψ`, and equals `U_{-ψ+} Z(F)^0 U_ψ ∪ U_ψ m Z(F)^0 U_ψ`. -/
theorem affineRankOneTwoCell : AffineRankOneTwoCellStatement.{u} := by
  intro F _ _ _ _ G _ P hA α ψ hψ hjump
  -- The structural inputs of the cover-image comparison, from their Library proofs.
  have hascent : IsSimplyConnectedAlgebraicClosureAscentStatement.{u} :=
    isSimplyConnectedAlgebraicClosureAscent_of_descent_and_splitStructure
      simplyConnectedCoverTensorDescent splitSimplyConnectedCoverExistence
      simplyConnectedCentralCoverUniversalProperty maximalTorusBaseChange rootDatumExistence
      splitSimplyConnectedCorootSpan splitCorootSpanSimplyConnected
  have hderived : SplitTorusCentralizerDerivedSimplyConnectedStatement.{u} :=
    splitTorusCentralizerDerivedSimplyConnected_of_inputs dynamicCentralizerReductive
      derivedSubgroupSemisimple splitSimplyConnectedCorootSpan splitCorootSpanSimplyConnected
      splitTorusCentralizerDerivedCorootComparison hascent
  have hpreimage : SplitTorusCentralizerCoverPreimageStatement.{u} :=
    splitTorusCentralizerCoverPreimage_of_inputs reductiveCentralDerivedProduct
      dynamicCentralizerReductive hderived
  have hmodel : SplitTorusCentralizerCocenterRootModelStatement.{u} :=
    splitTorusCentralizerCocenterRootModel_of_structuralInputs rootDatumExistence
      derivedSubgroupSemisimple derivedMaximalTorusProductSurjectivity
      derivedMaximalTorusIntersection
  have hcocenter : SplitTorusCentralizerCocenterInducedStatement.{u} :=
    splitTorusCentralizerCocenterInduced_of_inputs
      ⟨dynamicCentralizerReductive, cocenterQuotientExistence, isSimplyConnectedFieldExtension,
        splitSimplyConnectedCorootSpan, hmodel⟩
  -- `G(F)^♮ ∩ Z(F)^1 ⊆ Z(F)^0` (proof of KP Corollary 2.6.28) for the actual zero datum.
  have hZ : P.zeroDatum.CoverImageCentralizerNormKernelStatement :=
    P.zeroDatum.coverImageCentralizerNormKernel_of_inputs cocenterQuotientExistence hcocenter
      inducedTorusIwahori hpreimage isSimplyConnectedFieldExtension
  -- Actual rank-one factorization (KP Proposition 2.11.17).
  have hF : RelativeRoot.HasRankOneFactorization P.i :=
    rootRankOneFactorization F G P.isConnectedReductive P.S P.i P.isMaximalSplitTorus
  exact P.exists_affineRankOneTwoCell_of_coverImage_factorization hA hZ hF hψ hjump

end Langlands.Geometry.Building
