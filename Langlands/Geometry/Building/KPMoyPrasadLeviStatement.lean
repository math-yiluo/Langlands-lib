import Langlands.Geometry.Building.KPMoyPrasadFiltration
import Langlands.Geometry.Building.ValuationBuildingAxioms
import Langlands.BruhatTits.SpecialCompact.StandardBasisProperty
import Langlands.BruhatTits.SpecialCompact.Properties

/-!
# KP Proposition 13.2.5(5),(6) on supplied data

The Moy–Prasad subgroup of a standard Levi subgroup at a restricted point, the
nonnegative part of a split component in Definition 13.2.4(2), and the statements that for
`r > 0` the Moy–Prasad subgroup `P_{x,r}` has an Iwahori decomposition with respect to every
standard parabolic subgroup and meets its standard Levi subgroup in the Levi's own
Moy–Prasad subgroup.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.AlgebraicGeometry.PointTopology
open Langlands.BruhatTits.SpecialCompact

namespace Langlands.Geometry.Building

namespace ParahoricBuildingData.CentralizerFiltration

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  {P : ParahoricBuildingData G} (Zf : P.CentralizerFiltration)

/-- The Moy–Prasad subgroup `P^M_{xM,r}` of `M(F)` for a group `M` with `j : M → G` containing
the same maximal split torus `iM : S → M` (KP Definition 13.2.1 for `M`): the subgroup of
`M(F)` generated by the preimage of `Z(F)_r` under `j` and the blocks
`U^M_{a,xM,r} U^M_{2a,xM,r}` of the apartment data `DM` of `(M, S)` at `xM`. When `M` is a Levi
subgroup containing `S`, the centralizer of `S` in `M` is `Z`, and this preimage is `Z(F)_r`
viewed in `M(F)`. -/
def leviMoyPrasad {M : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom M.X.hom]
    (j : M ⟶ G) {iM : P.S.toGrp ⟶ M} [Mono iM.hom.hom.left]
    {DM : KPApartmentData iM (localFieldOrder F)} (xM : DM.Apartment) (r : NNReal) :
    Subgroup (rationalPoints M) :=
  (Zf.image r).comap (rationalPoints.map j) ⊔ DM.sharpFiltration xM (fun _ => (r : ℝ))

end ParahoricBuildingData.CentralizerFiltration

section Chamber

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {S : CommGroupScheme (Spec (CommRingCat.of F))}
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (i : S.toGrp ⟶ G) (ν : cocharacterLattice S) (J : Set (characterLattice S))
  {A : CommGroupScheme (Spec (CommRingCat.of F))}

/-- The elements `a ∈ A(F)` with `ω(α(a)) ≥ 0` for every character `α` of `A` in
`R(A, N_J)`, mapped into `G(F)` along `q ≫ i` (KP Definition 13.2.4(2) with `A = A_M`). Here
`R(A, N_J)` consists of the restrictions to `A` of the positive relative roots outside the
additive monoid generated by `J`, the roots of `S` on the standard unipotent radical `N_J`.
The condition `ω(α(a)) ≥ 0` is written as `|α(a)| ≤ 1` for the normalized absolute value. -/
def standardComponentNonnegativePart (q : A.toGrp ⟶ S.toGrp) : Set (rationalPoints G) :=
  rationalPoints.map (q ≫ i) ''
    {a | ∀ α ∈ positiveRelativeRoots i ν \ (AddSubmonoid.closure J : Set (characterLattice S)),
      CocharacterUniformizer.characterNorm F A (componentCharacterRestriction q α) a ≤ 1}

/-- KP Definition 13.2.4(1): the ordered product
`(K ∩ Nbar) × (K ∩ M) × (K ∩ N) → K` is a homeomorphism, for the topology of `G(F)` and the
subspace topologies. -/
def IsTopologicalIwahoriDecomposition (K M N Nbar : Subgroup (rationalPoints G)) : Prop :=
  letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  letI : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
  IsHomeomorph (orderedIntersectionProduct K M N Nbar)

end Chamber

/-- **KP Proposition 13.2.5(5)** for supplied data at the parabolic subgroups containing the
maximal split torus `S` of the data. Let `r > 0`, let `ν` be a generic cocharacter of `S` and
`J` a set of simple roots for `ν`, with standard Levi `M_J`, unipotent radical `N_J` and
opposite radical `N_J⁻`. Then `P_{x,r}` has an Iwahori decomposition with respect to
`P_J = M_J N_J` (KP Definition 13.2.4):
1. the ordered product `(P_{x,r} ∩ N_J⁻(F)) × (P_{x,r} ∩ M_J(F)) × (P_{x,r} ∩ N_J(F)) → P_{x,r}`
   is a homeomorphism for the topology of `G(F)`;
2. for every split component `A_M` of `M_J` in `S` and every `a ∈ A_M(F)` with
   `ω(α(a)) ≥ 0` for all `α ∈ R(A_M, N_J)`, conjugation by `a` maps `P_{x,r} ∩ N_J(F)` into
   itself and conjugation by `a⁻¹` maps `P_{x,r} ∩ N_J⁻(F)` into itself. -/
def MoyPrasadIwahoriDecompositionStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G) (Zf : P.CentralizerFiltration),
    P.SatisfiesApartmentAxioms → Zf.SatisfiesFiltrationAxioms →
      ∀ (x : P.Apartment) (r : NNReal), 0 < r →
      ∀ (ν : cocharacterLattice P.S), IsGenericCocharacter P.i ν →
      ∀ J ⊆ simpleRelativeRoots P.i ν,
        IsTopologicalIwahoriDecomposition (Zf.moyPrasad x r)
            (standardLeviPoints P.i ν J) (standardUnipotentPoints P.i ν J)
            (standardOppositeUnipotentPoints P.i ν J) ∧
        ∀ (A : CommGroupScheme (Spec (CommRingCat.of F))) (q : A.toGrp ⟶ P.S.toGrp),
          IsCompatibleStandardSplitComponent P.i ν J A q →
            WeakChamberContraction (Zf.moyPrasad x r)
              (standardUnipotentPoints P.i ν J) (standardOppositeUnipotentPoints P.i ν J)
              (standardComponentNonnegativePart P.i ν J q)

/-- **KP Proposition 13.2.5(6)** for supplied data at the standard Levi subgroups of the
maximal split torus `S` of the data, at positive depth. Let `r > 0`, let `ν` be a generic
cocharacter of `S`, `J` a set of simple roots for `ν` and `M_J` the standard Levi subgroup with
inclusion `j`. For all apartment data `DM` of `(M_J, S)` and every point `xM` that restricts
`x` (KP Lemma 6.7.1), `P_{x,r} ∩ M_J(F)` is the image under `j` of the Moy–Prasad subgroup
`P^{M_J}_{xM,r}`. -/
def MoyPrasadLeviIntersectionStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G) (Zf : P.CentralizerFiltration),
    P.SatisfiesApartmentAxioms → Zf.SatisfiesFiltrationAxioms →
      ∀ (x : P.Apartment) (r : NNReal), 0 < r →
      ∀ (ν : cocharacterLattice P.S), IsGenericCocharacter P.i ν →
      ∀ J ⊆ simpleRelativeRoots P.i ν,
        haveI : IsAffineHom (Standard.leviScheme P.i ν J).X.hom :=
          (Standard.isClosedSubgroup_leviHom P.i ν J).isAffineHom
        haveI : Mono (Standard.leviTorusHom P.i ν J).hom.hom.left :=
          (Standard.isMaximalSplitTorus_leviTorusHom P.i ν J
            P.isMaximalSplitTorus).isSplitSubtorus.mono
        ∀ (DM : KPApartmentData (Standard.leviTorusHom P.i ν J) (localFieldOrder F))
          (xM : DM.Apartment),
          IsLeviRestriction (Standard.leviHom P.i ν J) x xM →
            (Zf.leviMoyPrasad (Standard.leviHom P.i ν J) xM r).map
                (rationalPoints.map (Standard.leviHom P.i ν J)) =
              Zf.moyPrasad x r ⊓ standardLeviPoints P.i ν J

/-- KP Proposition 13.2.5(5) and (6) together, for supplied data and `r > 0`. -/
def MoyPrasadLeviStatement : Prop :=
  MoyPrasadIwahoriDecompositionStatement.{u} ∧ MoyPrasadLeviIntersectionStatement.{u}

end Langlands.Geometry.Building
