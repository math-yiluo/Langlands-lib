import Langlands.Geometry.Building.IntegerRankOneReflectionGeneration
import Langlands.GroupScheme.Rational.RootGeneratedCentralizerRankOneProof
import Langlands.GroupScheme.Rational.RootGeneratedWeylRepresentatives
import Langlands.GroupScheme.Rational.RelativeRootSystemProof

/-! # Full integer-valued normalizer generation from rational root generation -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building.IntegerValuationBuildingData

variable {k : Type u} [Field k]
    {v : Valuation k (WithZero (Multiplicative ℤ))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (B : IntegerValuationBuildingData v G)

/-- The actual relative-Weyl projection restricted to reflection products. -/
def reflectionRelativeWeylMap : B.reflectionNormalizer →* relativeWeylGroup B.i :=
  (QuotientGroup.mk' ((centralizerPoints B.i).subgroupOf (normalizerPoints B.i))).comp
    B.reflectionNormalizer.subtype

/-- Actual opposite-pair representatives supply every finite relative-Weyl class. -/
theorem reflectionRelativeWeylMap_surjective :
    Function.Surjective B.reflectionRelativeWeylMap := by
  have : Smooth G.X.hom := B.isConnectedReductive.smooth
  let hT := B.isMaximalSplitTorus.isSplitSubtorus.1
  have hroot : HasRelativeRootSystem B.i :=
    relativeRootSystem k G B.isConnectedReductive B.S B.i B.isMaximalSplitTorus
  have hex : ∀ a : relativeRoots B.i, ∃ n : normalizerPoints B.i,
      n ∈ B.reflectionNormalizer ∧ weylAction B.i n a.val = -a.val ∧
        n.val ∈ (RelativeRoot.kernelCentralizer B.i a.val).carrier (Over.mk (𝟙 _)) := by
    intro a
    obtain ⟨g, hg, hg1⟩ := RelativeRoot.exists_rootPoint_actual hT B.i a.property
    obtain ⟨p, hp⟩ := B.hasOppositeFactorPairs a.val a.property g hg hg1
    exact ⟨B.reflectionElement hp, B.reflectionElement_mem_reflectionNormalizer hg hg1 hp,
      hp.weylAction_eq_neg B.i hT a.property.1 hg hg1,
      hp.mem_kernelCentralizer B.i hg⟩
  choose n hn hflip hc using hex
  let D := RelativeRootReflectionData.ofKernelCentralizingRepresentatives B.i hT n hflip hc
  have hgen := D.closure_representatives_eq_top hT
    (hroot.finite_relativeRoots B.i hT) hroot
  apply MonoidHom.range_eq_top.mp
  apply top_unique
  rw [← hgen, Subgroup.closure_le]
  rintro _ ⟨a, rfl⟩
  exact ⟨⟨n a, hn a⟩, rfl⟩

/-- The subgroup generated by centralizing rank-one points is contained in
the ambient image of the actual reflection-generated normalizer. -/
theorem rankOneCentralizerGeneratedPoints_le_reflectionNormalizer_map :
    RelativeRoot.rankOneCentralizerGeneratedPoints B.i ≤
      B.reflectionNormalizer.map (normalizerPoints B.i).subtype := by
  refine (Subgroup.closure_le _).2 ?_
  intro g hg
  obtain ⟨a, ha, hg⟩ := Set.mem_iUnion₂.mp hg
  exact B.rankOneCentralizer_le_reflectionNormalizer_map
    B.hasOppositeFactorPairs ⟨a, ha⟩ hg

/-- Rational root generation makes every centralizer point a product of
actual opposite-pair representatives. -/
theorem centralizerPoints_le_reflectionNormalizer_map_of_rootGenerated_eq_top
    (hgen : relativeRootGeneratedSubgroup B.i = ⊤) :
    centralizerPoints B.i ≤
      B.reflectionNormalizer.map (normalizerPoints B.i).subtype := by
  have hred :
      centralizerPoints B.i ⊓ relativeRootGeneratedSubgroup B.i ≤
        RelativeRoot.rankOneCentralizerGeneratedPoints B.i :=
    rootGeneratedCentralizerRankOne k G B.isConnectedReductive B.S B.i
      B.isMaximalSplitTorus
  rw [hgen, inf_top_eq] at hred
  exact hred.trans B.rankOneCentralizerGeneratedPoints_le_reflectionNormalizer_map

/-- Finite relative-Weyl surjectivity and containment of the centralizer
give generation of the whole actual normalizer. -/
theorem reflectionNormalizer_eq_top_of_centralizer_le
    (hc : centralizerPoints B.i ≤
      B.reflectionNormalizer.map (normalizerPoints B.i).subtype) :
    B.reflectionNormalizer = ⊤ := by
  apply top_unique
  intro n _
  obtain ⟨r, hr⟩ := B.reflectionRelativeWeylMap_surjective (QuotientGroup.mk n)
  change (QuotientGroup.mk r.val : relativeWeylGroup B.i) = QuotientGroup.mk n at hr
  have hcN : r.val⁻¹ * n ∈
      (centralizerPoints B.i).subgroupOf (normalizerPoints B.i) :=
    QuotientGroup.eq.mp hr
  obtain ⟨c, hc, heq⟩ := hc hcN
  have heq' : c = r.val⁻¹ * n := Subtype.ext heq
  rw [heq'] at hc
  have hmem := B.reflectionNormalizer.mul_mem r.property hc
  simpa only [mul_inv_cancel_left] using hmem

/-- If actual relative-root points generate all rational points, then
actual opposite-pair representatives generate the whole normalizer. -/
theorem reflectionNormalizer_eq_top_of_rootGenerated_eq_top
    (hgen : relativeRootGeneratedSubgroup B.i = ⊤) :
    B.reflectionNormalizer = ⊤ :=
  B.reflectionNormalizer_eq_top_of_centralizer_le
    (B.centralizerPoints_le_reflectionNormalizer_map_of_rootGenerated_eq_top hgen)

/-- Rational root generation suffices for the full normalizer-image equality,
for arbitrary integer-valued building data including rank zero. -/
theorem normalizerAffineEquiv_range_eq_affineWeylGroup_of_rootGenerated_eq_top
    (hgen : relativeRootGeneratedSubgroup B.i = ⊤) :
    B.apartment.normalizerAffineEquiv.range =
      AffineRootSystem.affineWeylGroup B.affineRoots := by
  have h := B.reflectionNormalizer_map_eq_affineWeylGroup
  rw [B.reflectionNormalizer_eq_top_of_rootGenerated_eq_top hgen, Subgroup.map_top] at h
  exact h

end Langlands.Geometry.Building.IntegerValuationBuildingData
