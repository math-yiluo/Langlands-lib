import Langlands.Group.TitsSystemBruhat
import Langlands.Geometry.Building.ReflectionGalleryFreenessStatement
import Mathlib.Algebra.BigOperators.Group.List.Basic
import Mathlib.Algebra.Group.Action.Defs
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Tactic.Group

/-! # Deleting reflection words using chamber separation -/

namespace Langlands.Geometry.Building.ReflectionGallery

universe uG uX

variable {G : Type uG} {X : Type uX} [Group G] [MulAction G X]

variable {S : Set G} {C : X} {separates : G → X → X → Prop}

/-- A wall separating the endpoints of a word occurs along that word.
Multiplication by its reflection deletes one letter. -/
theorem IsSeparationSystem.exchange (h : IsSeparationSystem S C separates)
    (L : List G) (hL : ∀ s ∈ L, s ∈ S) (t : G)
    (ht : separates t C (L.prod • C)) :
    ∃ L' : List G, L'.length + 1 = L.length ∧
      (∀ s ∈ L', s ∈ S) ∧ t * L.prod = L'.prod := by
  induction L generalizing t with
  | nil =>
      exact False.elim (h.not_self t C (by simpa using ht))
  | cons s L ih =>
      have hs : s ∈ S := hL s (by simp)
      have htail : ∀ a ∈ L, a ∈ S := fun a ha => hL a (by simp [ha])
      have ht' : separates t C (s • (L.prod • C)) := by
        simpa only [List.prod_cons, mul_smul] using ht
      rcases h.triangle t C (s • C) (s • (L.prod • C)) ht' with hfirst | hrest
      · have hts : t = s := (h.adjacent s hs t).1 hfirst
        refine ⟨L, by simp, htail, ?_⟩
        simp only [List.prod_cons, hts, ← mul_assoc, h.involution s hs, one_mul]
      · have hrest' : separates (s⁻¹ * t * s) C (L.prod • C) :=
          (h.covariance t s C (L.prod • C)).1 hrest
        obtain ⟨L', hlen, hmem, hprod⟩ := ih htail (s⁻¹ * t * s) hrest'
        refine ⟨s :: L', by simpa using congrArg Nat.succ hlen, ?_, ?_⟩
        · intro a ha
          rcases List.mem_cons.1 ha with rfl | ha
          · exact hs
          · exact hmem a ha
        · calc
            t * (s :: L).prod = s * ((s⁻¹ * t * s) * L.prod) := by
              simp only [List.prod_cons]
              group
            _ = (s :: L').prod := by rw [hprod, List.prod_cons]

/-- A word in adjacent reflections which returns to its initial chamber is the identity. -/
theorem IsSeparationSystem.prod_eq_one_of_smul_eq (h : IsSeparationSystem S C separates)
    (L : List G) (hL : ∀ s ∈ L, s ∈ S) (hfix : L.prod • C = C) : L.prod = 1 := by
  have main : ∀ n : ℕ, ∀ L : List G, L.length = n →
      (∀ s ∈ L, s ∈ S) → L.prod • C = C → L.prod = 1 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro L hlen hmem hfix
        cases L with
        | nil => simp
        | cons s L =>
            have hs : s ∈ S := hmem s (by simp)
            have htail : ∀ a ∈ L, a ∈ S := fun a ha => hmem a (by simp [ha])
            have htail_image : L.prod • C = s • C := by
              calc
                L.prod • C = (s * s) • (L.prod • C) := by rw [h.involution s hs, one_smul]
                _ = s • ((s :: L).prod • C) := by simp only [List.prod_cons, mul_smul]
                _ = s • C := by rw [hfix]
            have hsep : separates s C (L.prod • C) := by
              rw [htail_image]
              exact (h.adjacent s hs s).2 rfl
            obtain ⟨L', hshort, hmem', hprod⟩ := h.exchange L htail s hsep
            have hfix' : L'.prod • C = C := by
              rw [← hprod]
              exact hfix
            have hlt : L'.length < n := by simp only [List.length_cons] at hlen; omega
            have hone := ih L'.length hlt L' rfl hmem' hfix'
            simpa only [List.prod_cons] using hprod.trans hone
  exact main L.length L rfl hL hfix

/-- The subgroup generated by adjacent reflections has a trivial chamber stabilizer. -/
theorem IsSeparationSystem.eq_one_of_smul_eq (h : IsSeparationSystem S C separates)
    {w : G} (hw : w ∈ Subgroup.closure S) (hfix : w • C = C) : w = 1 := by
  obtain ⟨L, hL, rfl⟩ := Langlands.Group.TitsSystem.exists_word_of_mem_closure h.involution hw
  exact h.prod_eq_one_of_smul_eq L hL hfix

/-- Finite-word deletion proves the complete separation-system target. -/
theorem reflectionGalleryFreeness : ReflectionGalleryFreenessStatement.{uG, uX} := by
  intro G X instG instX S C separates h w hw hfix
  exact h.eq_one_of_smul_eq hw hfix

end Langlands.Geometry.Building.ReflectionGallery
