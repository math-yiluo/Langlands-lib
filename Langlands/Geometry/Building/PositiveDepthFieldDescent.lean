import Langlands.Geometry.Building.PositiveDepthRayCompression

/-! # Descent of generated actual positive-depth root subgroups -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.GaloisPointComparison

namespace Langlands.Geometry.Building

/-- The subgroup generated by the original selected root filtrations. -/
def rootDepthGeneratedSubgroup {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    (i : S.toGrp ⟶ G) (φ : RootFunctionFamily S G)
    (Ψ : Set (characterLattice S)) (f : characterLattice S → ℝ) :
    Subgroup (rationalPoints G) :=
  Subgroup.closure (⋃ a : Ψ, rootFiltration i φ a (f a))

theorem rootRayDepthSet_subset_generated {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    (i : S.toGrp ⟶ G) (φ : RootFunctionFamily S G)
    (Ψ : Set (characterLattice S)) (f : characterLattice S → ℝ)
    (a : characterLattice S) :
    rootRayDepthSet i φ Ψ f a ⊆ rootDepthGeneratedSubgroup i φ Ψ f := by
  classical
  intro g hg
  unfold rootRayDepthSet at hg
  split_ifs at hg with ha h2a
  · exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨⟨a, ha⟩, hg⟩)
  · exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨⟨2 • a, h2a⟩, hg⟩)
  · exact (Set.mem_singleton_iff.mp hg) ▸ (rootDepthGeneratedSubgroup i φ Ψ f).one_mem

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] [Smooth G.X.hom]
  (i : S.toGrp ⟶ G) [Mono i.hom.hom.left]

local notation "b" => algebraBaseMap k K
local notation "S_K" => CategoryTheory.Functor.obj (CommGroupScheme.baseChange b) S
local notation "G_K" => baseChanged k K G
local notation "i_K" => CategoryTheory.Functor.map (GroupScheme.baseChange b) i
local notation "a_K" a => characterLattice.baseChange b S a

private instance extendedAffine : IsAffineHom (G_K).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom b)
  infer_instance

private instance extendedMono : Mono (i_K).hom.hom.left := by
  let : Mono i.hom.hom := Over.mono_of_mono_left _
  change Mono ((Over.pullback b).map i.hom.hom).left
  infer_instance

omit [Smooth G.X.hom] in
private theorem rationalExtend_injective :
    Function.Injective (rationalExtend k K G) := by
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  intro x y h
  apply (rationalCoeffEquiv k G).injective
  apply GaloisPoint.extend_injective k K G
  simpa only [baseChangeCoeffEquiv_rationalExtend] using
    congrArg (baseChangeCoeffEquiv k K G) h

omit [Mono i.hom.hom.left] in
/-- Reflection retains the doubled-root-only and identity branches, as well
as every literal depth. No downstairs valuation is assumed. -/
theorem mem_rootRayDepthSet_fieldExtend_iff (hS : IsSplitTorus S.toGrp)
    (ψ : RootFunctionFamily S_K G_K) (Ψ : Set (characterLattice S_K))
    (f : characterLattice S_K → ℝ) (hroots : Ψ ⊆ relativeRoots (T := S_K) i_K)
    (a : characterLattice S) (g : rationalPoints G) :
    rationalExtend k K G g ∈ rootRayDepthSet (S := S_K) i_K ψ Ψ f (a_K a) ↔
      g ∈ rootRayDepthSet i (RootFunctionFamily.fieldRestrict (k := k) ψ)
        ((characterLattice.baseChange b S) ⁻¹' Ψ)
        (f ∘ characterLattice.baseChange b S) a := by
  classical
  have hne (c : characterLattice S) (hc : (a_K c) ∈ Ψ) : c ≠ 0 := by
    intro h
    have hzero := (hroots hc).1
    apply hzero
    rw [h, map_zero]
  unfold rootRayDepthSet
  simp only [Set.mem_preimage, Function.comp_apply, ← map_nsmul]
  by_cases ha : (a_K a) ∈ Ψ
  · simp only [ha, ite_true]
    exact (Set.ext_iff.mp
      (rootFiltration_fieldRestrict i hS ψ a (hne a ha) (f (a_K a))) g).symm
  · by_cases h2a : (a_K (2 • a)) ∈ Ψ
    · simp only [ha, h2a, ite_false, ite_true]
      exact (Set.ext_iff.mp
        (rootFiltration_fieldRestrict i hS ψ (2 • a) (hne _ h2a)
          (f (a_K (2 • a)))) g).symm
    · simp only [ha, h2a, ite_false, Set.mem_singleton_iff]
      constructor
      · intro h
        apply rationalExtend_injective (K := K) (G := G)
        simpa only [map_one] using h
      · rintro rfl
        exact map_one _

/-- A factorization in the actual retained ray factors descends with every
original factor and its retained-ray membership. -/
theorem mem_orderedRootRayDepthProduct_fieldExtend_iff
    (hS : IsSplitTorus S.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i)
    (ν : cocharacterLattice S) {n : ℕ} (a : Fin n → characterLattice S)
    (hinj : Function.Injective a)
    (ha : Set.range a = RelativeRoot.indivisiblePositiveRoots i ν)
    {ψ : RootFunctionFamily S_K G_K} (hψ : IsRootDatumValuation (S := S_K) i_K ψ)
    (Ψ : Set (characterLattice S_K)) (f : characterLattice S_K → ℝ)
    (hroots : Ψ ⊆ relativeRoots (T := S_K) i_K) (g : rationalPoints G) :
    rationalExtend k K G g ∈
        orderedRootRayDepthProduct (S := S_K) i_K ψ Ψ f (fun j => a_K (a j)) ↔
      g ∈ orderedRootRayDepthProduct i (RootFunctionFamily.fieldRestrict (k := k) ψ)
        ((characterLattice.baseChange b S) ⁻¹' Ψ)
        (f ∘ characterLattice.baseChange b S) a := by
  constructor
  · rintro ⟨y, hy⟩
    let y' : ∀ j, rootGroupPoints (S := S_K) i_K (a_K (a j)) := fun j =>
      ⟨(y j).val, hψ.rootRayDepthSubgroup_le_rootGroupPoints Ψ f _ (y j).property⟩
    obtain ⟨x, hxf, hx⟩ := orderedRootFactors_fieldDescend i hS hE ν a hinj ha g y' hy
    let x' : ∀ j, rootRayDepthSet i (RootFunctionFamily.fieldRestrict (k := k) ψ)
        ((characterLattice.baseChange b S) ⁻¹' Ψ)
        (f ∘ characterLattice.baseChange b S) (a j) := fun j =>
      ⟨(x j).val, (mem_rootRayDepthSet_fieldExtend_iff i hS ψ Ψ f hroots _ _).mp
        (by rw [hxf j]; exact (y j).property)⟩
    exact ⟨x', hx⟩
  · rintro ⟨x, hx⟩
    let y : ∀ j, rootRayDepthSet (S := S_K) i_K ψ Ψ f (a_K (a j)) := fun j =>
      ⟨rationalExtend k K G (x j),
        (mem_rootRayDepthSet_fieldExtend_iff i hS ψ Ψ f hroots _ _).mpr (x j).property⟩
    refine ⟨y, ?_⟩
    simpa only [map_list_prod, List.map_ofFn, Function.comp_def] using
      congrArg (rationalExtend k K G) hx

omit [IsAffineHom G.X.hom] [Smooth G.X.hom] [Mono i.hom.hom.left] in
/-- Preservation of the generated subgroup is proved on its original
generators; no ordered factorization or valuation is needed. -/
theorem rootDepthGeneratedSubgroup_le_comap_fieldExtend
    (ψ : RootFunctionFamily S_K G_K) (Ψ : Set (characterLattice S_K))
    (f : characterLattice S_K → ℝ) :
    rootDepthGeneratedSubgroup i (RootFunctionFamily.fieldRestrict (k := k) ψ)
        ((characterLattice.baseChange b S) ⁻¹' Ψ)
        (f ∘ characterLattice.baseChange b S) ≤
      (rootDepthGeneratedSubgroup (S := S_K) i_K ψ Ψ f).comap (rationalExtend k K G) := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hg
  apply Subgroup.subset_closure
  refine Set.mem_iUnion.mpr ⟨⟨a_K c, c.property⟩, ?_⟩
  exact ⟨rationalExtend_mem_rootGroupPoints (K := K) i c hc.1, hc.2⟩

/-- Closed-positive collection upstairs and descent of the actual ray
factors reflect the generated subgroup. In particular, V3 downstairs is
not assumed to justify this reflection. -/
theorem mem_rootDepthGeneratedSubgroup_fieldExtend_iff
    (hS : IsSplitTorus S.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i)
    (ν : cocharacterLattice S) {n : ℕ} (a : Fin n → characterLattice S)
    (hinj : Function.Injective a)
    (ha : Set.range a = RelativeRoot.indivisiblePositiveRoots i ν)
    {ψ : RootFunctionFamily S_K G_K} (hψ : IsRootDatumValuation (S := S_K) i_K ψ)
    {Ψ : Set (characterLattice S_K)} {f : characterLattice S_K → ℝ}
    (hdata : IsClosedPositiveRootDepth (S := S_K) i_K
      (cocharacterLattice.baseChange b S ν) Ψ f)
    (hdouble : ∀ c ∈ Ψ, 2 • c ∈ Ψ → 2 * f c ≤ f (2 • c))
    (hcover : ∀ c ∈ Ψ, ∃ j, c = (a_K (a j)) ∨ c = 2 • (a_K (a j)))
    (g : rationalPoints G) :
    rationalExtend k K G g ∈ rootDepthGeneratedSubgroup (S := S_K) i_K ψ Ψ f ↔
      g ∈ rootDepthGeneratedSubgroup i (RootFunctionFamily.fieldRestrict (k := k) ψ)
        ((characterLattice.baseChange b S) ⁻¹' Ψ)
        (f ∘ characterLattice.baseChange b S) := by
  constructor
  · intro hg
    have hgen : rootDepthGeneratedSubgroup (S := S_K) i_K ψ Ψ f =
        ⨆ c : Ψ, hψ.filtrationSubgroup c (f c) := by
      unfold rootDepthGeneratedSubgroup
      simp only [Subgroup.closure_iUnion, ← hψ.coe_filtrationSubgroup, Subgroup.closure_eq]
    have hprod : rationalExtend k K G g ∈
        orderedRootRayDepthProduct (S := S_K) i_K ψ Ψ f
          (fun j => a_K (a j)) := by
      rw [orderedRootRayDepthProduct_eq_iSup hψ hdata hdouble _ hcover]
      exact hgen ▸ hg
    obtain ⟨x, hx⟩ :=
      (mem_orderedRootRayDepthProduct_fieldExtend_iff i hS hE ν a hinj ha hψ Ψ f
        (fun _ hc => (hdata.positive hc).1) g).mp hprod
    rw [← hx]
    apply Subgroup.list_prod_mem
    intro z hz
    obtain ⟨j, rfl⟩ := (List.mem_ofFn.mp hz)
    exact rootRayDepthSet_subset_generated i _ _ _ _ (x j).property
  · intro hg
    exact rootDepthGeneratedSubgroup_le_comap_fieldExtend i ψ Ψ f hg

end Langlands.Geometry.Building
