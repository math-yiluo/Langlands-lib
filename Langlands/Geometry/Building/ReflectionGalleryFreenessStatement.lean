import Mathlib.Algebra.Group.Action.Defs
import Mathlib.Algebra.Group.Subgroup.Lattice

/-! # Separation-system chamber-freeness target -/

namespace Langlands.Geometry.Building.ReflectionGallery

universe uG uX

variable {G : Type uG} {X : Type uX} [Group G] [MulAction G X]

/-- The elementary side-of-wall laws needed for deletion of gallery words.
The wall label is its reflection as an element of the acting group. -/
structure IsSeparationSystem (S : Set G) (C : X) (separates : G → X → X → Prop) : Prop where
  not_self : ∀ t x, ¬ separates t x x
  triangle : ∀ t x y z, separates t x z → separates t x y ∨ separates t y z
  covariance : ∀ t g x y,
    separates t (g • x) (g • y) ↔ separates (g⁻¹ * t * g) x y
  involution : ∀ s ∈ S, s * s = 1
  adjacent : ∀ s ∈ S, ∀ t, separates t C (s • C) ↔ t = s

/-- In a separation system, the subgroup generated by the adjacent
reflections has a trivial stabilizer of its distinguished chamber. -/
def ReflectionGalleryFreenessStatement : Prop :=
  ∀ (G : Type uG) (X : Type uX) [Group G] [MulAction G X]
    (S : Set G) (C : X) (separates : G → X → X → Prop),
    IsSeparationSystem S C separates →
      ∀ w : G, w ∈ Subgroup.closure S → w • C = C → w = 1

end Langlands.Geometry.Building.ReflectionGallery
