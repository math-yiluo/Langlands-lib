import Langlands.Geometry.Building.KPLocalTorusCharacterFiltration
import Langlands.Geometry.Building.MaximalUnramifiedBuildingData
import Langlands.Geometry.Building.KPRealDepthSubgroups
import Langlands.GroupScheme.Torus.MaximalAmbient

/-!
# The groups `G(K)_{x,r}` of a quasi-split group over `K = F^ur`

For building data `B` over the maximal unramified extension `K` whose centralizer
`Z = Z_G(S)` of the maximal split torus is a torus, `Z(K)_r` is the published
`localTorusFiltration` of `Z`, and `G(K)_{x,r}` is the subgroup of `G(K)` generated by
`Z(K)_r` and the root subgroups `U_{b,x,r}` (KP Definition 7.3.3 at the constant
concave function `f = r`).
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj NNReal
open Langlands.GroupScheme Langlands.LocalGalois.Separable

set_option backward.isDefEq.respectTransparency false

namespace Langlands.Geometry.Building.MaximalUnramified.BuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))} [IsAffineHom H.X.hom]
  (B : BuildingData F H) (hZ : IsTorus B.centralizer.Z)

/-! ### The torus `Z = T` and its filtration `Z(K)_r` -/

/-- The centralizer `Z = Z_G(S)` as a commutative group scheme. Its commutativity is the
Library theorem `IsTorus.isCommMonObj`, so no structure is chosen. -/
def centralizerTorus : CommGroupScheme (Spec (CommRingCat.of (UnramifiedClosure F))) where
  toGrp := B.centralizer.Z
  comm := hZ.isCommMonObj

@[simp] theorem centralizerTorus_toGrp : (B.centralizerTorus hZ).toGrp = B.centralizer.Z :=
  rfl

/-- `Z` is affine: it is a closed subgroup of the affine group `G`. -/
instance centralizerTorus_isAffine : IsAffine (B.centralizerTorus hZ).X.left := by
  have : IsAffine H.X.left := isAffine_of_isAffineHom H.X.hom
  have : IsClosedImmersion B.centralizer.j.hom.hom.left := B.centralizer.isClosedSubgroup
  exact isAffine_of_isAffineHom B.centralizer.j.hom.hom.left

/-- The filtration `Z(K)_r` of KP §7.2 for the torus `Z = T`: the published
`localTorusFiltration` of `Z`. -/
def centralizerTorusFiltration (r : ℝ≥0) : Subgroup (rationalPoints B.centralizer.Z) :=
  localTorusFiltration F (B.centralizerTorus hZ) hZ r

theorem centralizerTorusFiltration_eq (r : ℝ≥0) :
    B.centralizerTorusFiltration hZ r = localTorusFiltration F (B.centralizerTorus hZ) hZ r :=
  rfl

theorem centralizerTorusFiltration_antitone : Antitone (B.centralizerTorusFiltration hZ) :=
  localTorusFiltration_antitone F (B.centralizerTorus hZ) hZ

/-- The zero term is the norm Iwahori subgroup of every finite Galois splitting field. -/
theorem centralizerTorusFiltration_zero
    (E : IntermediateField (UnramifiedClosure F) (SeparableClosure F))
    [FiniteDimensional (UnramifiedClosure F) E] [IsGalois (UnramifiedClosure F) E]
    (hE : IsSplitTorus (GaloisPointComparison.baseChanged (UnramifiedClosure F) E
      B.centralizer.Z)) :
    B.centralizerTorusFiltration hZ 0 =
      torusNormIwahori (UnramifiedClosure F) E (intermediateValuation F E)
        (B.centralizerTorus hZ) :=
  localTorusFiltration_zero F E (B.centralizerTorus hZ) hZ hE

theorem iInf_centralizerTorusFiltration_eq_bot :
    ⨅ r : ℝ≥0, B.centralizerTorusFiltration hZ r = ⊥ :=
  iInf_localTorusFiltration_eq_bot F (B.centralizerTorus hZ) hZ

theorem centralizerTorusFiltration_le_characterValuationKernel (r : ℝ≥0) :
    B.centralizerTorusFiltration hZ r ≤
      characterValuationKernel (fixedFieldValuation F) B.centralizer.Z :=
  localTorusFiltration_le_characterValuationKernel F (B.centralizerTorus hZ) hZ r

/-- Any presentation `e : T ≅ Z` of `Z` by a torus `T` with its own commutative structure
gives the same filtration: `Z(K)_r = e(T(K)_r)`. -/
theorem centralizerTorusFiltration_eq_map_iso
    (T : CommGroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))) [IsAffine T.X.left]
    (hT : IsTorus T.toGrp) (e : T.toGrp ≅ B.centralizer.Z) (r : ℝ≥0) :
    B.centralizerTorusFiltration hZ r =
      (localTorusFiltration F T hT r).map (rationalPoints.map e.hom) := by
  apply le_antisymm
  · intro z hz
    have hinv : rationalPoints.map e.inv z ∈ localTorusFiltration F T hT r :=
      map_localTorusFiltration_le F (B.centralizerTorus hZ) hZ hT
        (Additive.ofMul e.inv : B.centralizerTorus hZ ⟶ T) r ⟨z, hz, rfl⟩
    refine ⟨rationalPoints.map e.inv z, hinv, ?_⟩
    change (z ≫ e.inv.hom.hom) ≫ e.hom.hom.hom = z
    simp only [Category.assoc, ← Grp.comp_hom_hom, e.inv_hom_id, Grp.id_hom_hom,
      Category.comp_id]
  · exact map_localTorusFiltration_le F T hT hZ
      (Additive.ofMul e.hom : T ⟶ B.centralizerTorus hZ) r

/-- The image `j(Z(K)_r) ⊆ G(K)`. -/
def centralizerTorusImage (r : ℝ≥0) : Subgroup (rationalPoints H) :=
  (B.centralizerTorusFiltration hZ r).map (rationalPoints.map B.centralizer.j)

theorem centralizerTorusImage_antitone : Antitone (B.centralizerTorusImage hZ) :=
  fun _ _ h => Subgroup.map_mono (B.centralizerTorusFiltration_antitone hZ h)

theorem centralizerTorusImage_eq_map_iso
    (T : CommGroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))) [IsAffine T.X.left]
    (hT : IsTorus T.toGrp) (e : T.toGrp ≅ B.centralizer.Z) (r : ℝ≥0) :
    B.centralizerTorusImage hZ r =
      ((localTorusFiltration F T hT r).map (rationalPoints.map e.hom)).map
        (rationalPoints.map B.centralizer.j) := by
  rw [centralizerTorusImage, B.centralizerTorusFiltration_eq_map_iso hZ T hT e r]

/-! ### The groups `G(K)_{x,r}` -/

/-- KP's `G(K)_{x,r}` (Definition 7.3.3 at the constant function `f = r`): the subgroup of
`G(K)` generated by `j(Z(K)_r)` and the root subgroups `U_{b,x,r}` of all relative roots `b`,
divisible ones included. The second generator is `G(K)^♯_{x,r}` of KP Definition 7.3.3(1),(2). -/
def moyPrasad (x : B.Apartment) (r : ℝ≥0) : Subgroup (rationalPoints H) :=
  B.centralizerTorusImage hZ r ⊔ B.apartment.sharpFiltration x (fun _ => (r : ℝ))

theorem moyPrasad_eq_sup (x : B.Apartment) (r : ℝ≥0) :
    B.moyPrasad hZ x r =
      B.centralizerTorusImage hZ r ⊔ B.apartment.sharpFiltration x (fun _ => (r : ℝ)) :=
  rfl

theorem moyPrasad_eq_sup_iSup (x : B.Apartment) (r : ℝ≥0) :
    B.moyPrasad hZ x r =
      B.centralizerTorusImage hZ r ⊔ ⨆ b : relativeRoots B.i, B.filtration x b.1 r := by
  rw [moyPrasad, B.apartment.sharpFiltration_eq_iSup]

theorem centralizerTorusImage_le_moyPrasad (x : B.Apartment) (r : ℝ≥0) :
    B.centralizerTorusImage hZ r ≤ B.moyPrasad hZ x r :=
  le_sup_left

theorem map_mem_moyPrasad (x : B.Apartment) {r : ℝ≥0} {z : rationalPoints B.centralizer.Z}
    (hz : z ∈ B.centralizerTorusFiltration hZ r) :
    rationalPoints.map B.centralizer.j z ∈ B.moyPrasad hZ x r :=
  B.centralizerTorusImage_le_moyPrasad hZ x r (Subgroup.mem_map_of_mem _ hz)

theorem sharpFiltration_le_moyPrasad (x : B.Apartment) (r : ℝ≥0) :
    B.apartment.sharpFiltration x (fun _ => (r : ℝ)) ≤ B.moyPrasad hZ x r :=
  le_sup_right

theorem filtration_le_moyPrasad (x : B.Apartment) (b : relativeRoots B.i) (r : ℝ≥0) :
    B.filtration x b.1 r ≤ B.moyPrasad hZ x r := by
  refine le_trans ?_ (B.sharpFiltration_le_moyPrasad hZ x r)
  rw [B.apartment.sharpFiltration_eq_iSup]
  exact le_iSup (fun c : relativeRoots B.i => B.apartment.filtration x c.1 (r : ℝ)) b

/-- `G(K)_{x,r}` is the least subgroup containing `j(Z(K)_r)` and every `U_{b,x,r}`. -/
theorem moyPrasad_le_iff (x : B.Apartment) (r : ℝ≥0) (Q : Subgroup (rationalPoints H)) :
    B.moyPrasad hZ x r ≤ Q ↔
      B.centralizerTorusImage hZ r ≤ Q ∧ ∀ b : relativeRoots B.i, B.filtration x b.1 r ≤ Q := by
  rw [moyPrasad_eq_sup_iSup, sup_le_iff, iSup_le_iff]

theorem moyPrasad_antitone (x : B.Apartment) : Antitone (B.moyPrasad hZ x) := by
  intro r s h
  refine sup_le_sup (B.centralizerTorusImage_antitone hZ h) ?_
  rw [B.apartment.sharpFiltration_eq_iSup, B.apartment.sharpFiltration_eq_iSup]
  exact iSup_mono fun b => B.apartment.filtration_antitone x b.1 (NNReal.coe_le_coe.2 h)

end Langlands.Geometry.Building.MaximalUnramified.BuildingData
