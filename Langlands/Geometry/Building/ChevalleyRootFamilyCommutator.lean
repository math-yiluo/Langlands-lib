import Langlands.Geometry.Building.ChevalleyRootFamilyRankOne
import Langlands.GroupScheme.SplitExistence.RootValuationBounds

/-! # Axiom V 3 for the Chevalley root function family

For roots `a, b` of a Chevalley group with `b ∉ -ℝ_{>0} a`, the commutator of `U_{a,r}` and
`U_{b,s}` lies in the group generated by the `U_{pa+qb, pr+qs}` (KP Definition 6.1.2, V 3, for
the Chevalley valuation of KP 6.1.3). With the axioms proved earlier this shows that the
Chevalley root family is a valuation of the root datum. -/

noncomputable section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.SplitExistence
open Langlands.GroupScheme.SplitExistence.ChevalleyData
open Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

namespace ChevalleyRootFamily

variable {J X Y : Type u} [AddCommGroup X] [AddCommGroup Y] {P : RootDatum J X Y} {b : P.Base}
  {D : ChevalleyData P b} {k : Type u} [Field k]
  (G : D.ChevGroup k)

set_option quotPrecheck false in
local notation "Γk" => Γ((Over.mk (𝟙 (Spec (CommRingCat.of k)))).left, ⊤)

/-- The rational points of a Chevalley group as invertible matrices over the global sections. -/
def glHom : rationalPoints G.H →* GL (Fin D.n) Γk :=
  MonoidHom.mk' (fun g => GeneralLinear.pointsEquiv (Fin D.n) (CommRingCat.of k) _
    (g ≫ G.i.hom.hom)) fun _ _ => by
      rw [MonObj.mul_comp, map_mul]

theorem glHom_injective : Function.Injective (glHom G) := fun _ _ e =>
  G.mono_i.right_cancellation _ _
    ((GeneralLinear.pointsEquiv (Fin D.n) (CommRingCat.of k) _).injective e)

theorem glHom_rootPt (j : J) (s : k) :
    glHom G (G.rootPt j s) = D.x j ((Scheme.ΓSpecIso (CommRingCat.of k)).inv s) :=
  G.pointsEquiv_rootPt j s

/-- The valuation of the global sections of `Spec k`. -/
def omegaΓ (omega : AddValuation k (WithTop ℝ)) : AddValuation Γk (WithTop ℝ) :=
  omega.comap (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom

theorem omegaΓ_inv (omega : AddValuation k (WithTop ℝ)) (s : k) :
    omegaΓ omega ((Scheme.ΓSpecIso (CommRingCat.of k)).inv s) = omega s := by
  change omega ((Scheme.ΓSpecIso (CommRingCat.of k)).hom
    ((Scheme.ΓSpecIso (CommRingCat.of k)).inv s)) = omega s
  congr 1
  change ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (Scheme.ΓSpecIso (CommRingCat.of k)).hom) s = s
  rw [Iso.inv_hom_id]
  rfl

theorem rootPt_add (j : J) (s t : k) : G.rootPt j (s + t) = G.rootPt j s * G.rootPt j t := by
  apply glHom_injective G
  rw [map_mul, glHom_rootPt, glHom_rootPt, glHom_rootPt, map_add, x_add]

theorem rootPt_neg (j : J) (s : k) : G.rootPt j (-s) = (G.rootPt j s)⁻¹ := by
  apply glHom_injective G
  rw [map_inv, glHom_rootPt, glHom_rootPt, map_neg, x_neg]

variable [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X]
  [IsAffine G.H.X.left] [LocallyOfFiniteType G.H.X.hom]
  (omega : AddValuation k (WithTop ℝ))

/-- The filtration set of a root character consists of the root points whose coordinate has
valuation at least `r`. -/
theorem mem_rootFiltration_root_iff (j : J) (r : ℝ) (g : rationalPoints G.H) :
    g ∈ rootFiltration G.t (family G omega) (charOf k (P.root j)) r ↔
      ∃ s : k, g = G.rootPt j s ∧ (r : WithTop ℝ) ≤ omega s := by
  constructor
  · rintro ⟨hg, hr⟩
    obtain ⟨s, hs⟩ := (G.rootCoordEquiv j).surjective ⟨g, hg⟩
    have hgs : g = G.rootPt j (Multiplicative.toAdd s) := (congrArg Subtype.val hs).symm
    refine ⟨Multiplicative.toAdd s, hgs, ?_⟩
    rw [hgs, family_rootPt] at hr
    exact hr
  · rintro ⟨s, rfl, hr⟩
    exact ⟨G.rootPt_mem j s, by rw [family_rootPt]; exact hr⟩

/-- The filtration subgroup `U_{a,r}` of a root character. -/
def filtrationSubgroup (a : characterLattice (Tk (X := X) k)) (ha : a ∈ relativeRoots G.t)
    (r : ℝ) : Subgroup (rationalPoints G.H) where
  carrier := rootFiltration G.t (family G omega) a r
  mul_mem' := fun {g g'} hg hg' => mul_mem G omega a ha r g g' hg hg'
  one_mem' := one_mem G omega a ha r
  inv_mem' := fun {g} hg => inv_mem G omega a ha r g hg

theorem closure_rootFiltration (a : characterLattice (Tk (X := X) k))
    (ha : a ∈ relativeRoots G.t) (r : ℝ) :
    Subgroup.closure (rootFiltration G.t (family G omega) a r) =
      filtrationSubgroup G omega a ha r :=
  (filtrationSubgroup G omega a ha r).closure_eq

/-- The positive integral functional `(2 - ⟨i, j^∨⟩) j_i^∨ + (2 - ⟨j, i^∨⟩) j^∨`, whose value on
both roots is `4 - ⟨i, j^∨⟩⟨j, i^∨⟩`. -/
def pairHeight (i j : J) : X →+ ℤ :=
  (2 - P.pairing i j) • (P.toLinearMap.flip (P.coroot i)).toAddMonoidHom +
    (2 - P.pairing j i) • (P.toLinearMap.flip (P.coroot j)).toAddMonoidHom

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
theorem pairHeight_apply (i j : J) (x : X) :
    pairHeight (P := P) i j x = (2 - P.pairing i j) * P.toLinearMap x (P.coroot i) +
      (2 - P.pairing j i) * P.toLinearMap x (P.coroot j) := by
  simp [pairHeight]

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
theorem pairHeight_root_left (i j : J) :
    pairHeight (P := P) i j (P.root i) = 4 - P.pairing i j * P.pairing j i := by
  rw [pairHeight_apply, RootPairing.root_coroot_eq_pairing, RootPairing.root_coroot_eq_pairing,
    RootPairing.pairing_same]
  ring

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
theorem pairHeight_root_right (i j : J) :
    pairHeight (P := P) i j (P.root j) = 4 - P.pairing i j * P.pairing j i := by
  rw [pairHeight_apply, RootPairing.root_coroot_eq_pairing, RootPairing.root_coroot_eq_pairing,
    RootPairing.pairing_same]
  ring

omit [Module.Finite ℤ X] in
/-- For two linearly independent roots of a reduced finite root datum, the product of the
pairings is less than `4`. -/
theorem pairing_mul_pairing_lt_four {i j : J} (hij : i ≠ j) (hneg : P.root i ≠ -P.root j) :
    P.pairing i j * P.pairing j i < 4 := by
  have h4 : P.coxeterWeightIn ℤ i j < 4 :=
    lt_of_le_of_ne (P.coxeterWeightIn_le_four ℤ i j) (P.coxeterWeightIn_ne_four (S := ℤ) hij hneg)
  have e := P.algebraMap_coxeterWeightIn ℤ i j
  rw [Algebra.algebraMap_self, RingHom.id_apply, RootPairing.coxeterWeight] at e
  rwa [e] at h4

/-- The real functional `μ₁ ⟨·, i^∨⟩ + μ₂ ⟨·, j^∨⟩`. -/
def pairFunctional (i j : J) (μ₁ μ₂ : ℝ) : X →+ ℝ :=
  μ₁ • (Int.castAddHom ℝ).comp (P.toLinearMap.flip (P.coroot i)).toAddMonoidHom +
    μ₂ • (Int.castAddHom ℝ).comp (P.toLinearMap.flip (P.coroot j)).toAddMonoidHom

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
theorem pairFunctional_apply (i j : J) (μ₁ μ₂ : ℝ) (x : X) :
    pairFunctional (P := P) i j μ₁ μ₂ x =
      μ₁ * (P.toLinearMap x (P.coroot i) : ℝ) + μ₂ * (P.toLinearMap x (P.coroot j) : ℝ) := by
  simp [pairFunctional]

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
/-- A real functional with prescribed values `r, s` on two roots with `⟨i, j^∨⟩⟨j, i^∨⟩ < 4`. -/
theorem exists_pairFunctional {i j : J} (h4 : P.pairing i j * P.pairing j i < 4) (r s : ℝ) :
    ∃ θ : X →+ ℝ, θ (P.root i) = r ∧ θ (P.root j) = s := by
  set A : ℝ := (P.pairing i j : ℝ)
  set B : ℝ := (P.pairing j i : ℝ)
  have hΔ : (0 : ℝ) < 4 - A * B := by
    have : ((P.pairing i j * P.pairing j i : ℤ) : ℝ) < 4 := by exact_mod_cast h4
    push_cast at this
    linarith
  refine ⟨pairFunctional (P := P) i j ((2 * r - A * s) / (4 - A * B))
    ((2 * s - B * r) / (4 - A * B)), ?_, ?_⟩
  · rw [pairFunctional_apply, RootPairing.root_coroot_eq_pairing,
      RootPairing.root_coroot_eq_pairing, RootPairing.pairing_same]
    field_simp
    push_cast
    ring
  · rw [pairFunctional_apply, RootPairing.root_coroot_eq_pairing,
      RootPairing.root_coroot_eq_pairing, RootPairing.pairing_same]
    field_simp
    push_cast
    ring

/-- The roots `p i + q j` with `p, q ≥ 1`. -/
def pairCone (i j : J) : Set J :=
  {c | ∃ p q : ℕ, 1 ≤ p ∧ 1 ≤ q ∧ P.root c = p • P.root i + q • P.root j}

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
theorem mem_pairCone {i j c : J} :
    c ∈ pairCone (P := P) i j ↔
      ∃ p q : ℕ, 1 ≤ p ∧ 1 ≤ q ∧ P.root c = p • P.root i + q • P.root j :=
  Iff.rfl

omit [Finite J] [P.IsReduced] [Module.Finite ℤ X] [Module.Free ℤ X] in
theorem isClosedPositive_pairCone {h : X →+ ℤ} {i j : J} (hi : 0 < h (P.root i))
    (hj : 0 < h (P.root j)) : IsClosedPositive P h (pairCone (P := P) i j) where
  pos := by
    rintro c ⟨p, q, hp, hq, hc⟩
    rw [hc, map_add, map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul]
    have : (1 : ℤ) ≤ p := by exact_mod_cast hp
    have : (1 : ℤ) ≤ q := by exact_mod_cast hq
    nlinarith
  closed := by
    rintro c ⟨p, q, hp, hq, hc⟩ c' ⟨p', q', hp', hq', hc'⟩ d a e ha he hd
    refine ⟨a * p + e * p', a * q + e * q', by nlinarith, by nlinarith, ?_⟩
    rw [hd, hc, hc']
    simp only [smul_add, smul_smul, add_smul]
    abel

/-- **Axiom V 3** for the Chevalley root family. -/
theorem commutator :
    ∀ a ∈ relativeRoots G.t, ∀ b ∈ relativeRoots G.t,
      (∀ t : ℝ, 0 < t → ((1 : ℝ) ⊗ₜ[ℤ] b : Vstar (Tk (X := X) k)) ≠ -(t • (1 : ℝ) ⊗ₜ[ℤ] a)) →
      ∀ r s : ℝ,
        ⁅Subgroup.closure (rootFiltration G.t (family G omega) a r),
            Subgroup.closure (rootFiltration G.t (family G omega) b s)⁆ ≤
          Subgroup.closure (⋃ (p : ℕ) (q : ℕ) (_ : 0 < p) (_ : 0 < q)
            (_ : p • a + q • b ∈ relativeRoots G.t),
            rootFiltration G.t (family G omega) (p • a + q • b) (p * r + q * s)) := by
  classical
  have := Fintype.ofFinite J
  intro a ha b hb hab r s
  rw [closure_rootFiltration G omega a ha, closure_rootFiltration G omega b hb,
    Subgroup.commutator_le]
  obtain ⟨i, rfl⟩ := (mem_relativeRoots_iff G a).1 ha
  obtain ⟨j, rfl⟩ := (mem_relativeRoots_iff G b).1 hb
  intro g₁ hg₁ g₂ hg₂
  obtain ⟨x, rfl, hx⟩ := (mem_rootFiltration_root_iff G omega i r g₁).1 hg₁
  obtain ⟨y, rfl, hy⟩ := (mem_rootFiltration_root_iff G omega j s g₂).1 hg₂
  rw [commutatorElement_def]
  by_cases hij : i = j
  · subst hij
    have e : G.rootPt i x * G.rootPt i y * (G.rootPt i x)⁻¹ * (G.rootPt i y)⁻¹ = 1 := by
      rw [← rootPt_add, ← rootPt_neg, ← rootPt_add, ← rootPt_neg, ← rootPt_add,
        show x + y + -x + -y = 0 by ring, ChevGroup.rootPt_zero]
    rw [e]
    exact Subgroup.one_mem _
  by_cases hneg : P.root i = -P.root j
  · exfalso
    have hb' : charOf k (P.root j) = -charOf k (P.root i) := by
      rw [show P.root j = -P.root i by rw [hneg, neg_neg], ← charOfHom_apply, map_neg,
        charOfHom_apply]
    apply hab 1 one_pos
    rw [hb', TensorProduct.tmul_neg, one_smul]
  -- the general case
  have h4 := pairing_mul_pairing_lt_four hij hneg
  set h : X →+ ℤ := pairHeight (P := P) i j with hh
  have hi : 0 < h (P.root i) := by rw [hh, pairHeight_root_left]; linarith
  have hj : 0 < h (P.root j) := by rw [hh, pairHeight_root_right]; linarith
  have hΨ := isClosedPositive_pairCone (P := P) hi hj
  obtain ⟨θ, hθi, hθj⟩ := exists_pairFunctional h4 r s
  set toΓ := (Scheme.ΓSpecIso (CommRingCat.of k)).inv with htoΓ
  set v := omegaΓ omega with hv
  -- the commutator in `GL_n`
  set C : GL (Fin D.n) Γk := D.x i (toΓ x) * D.x j (toΓ y) * D.x i (-toΓ x) * D.x j (-toΓ y) with hC
  have hCmem : C ∈ D.rootsSub Γk (pairCone (P := P) i j) :=
    D.commutator_mem_rootsSub_ring h hi hj (fun c p q hp hq hc => mem_pairCone.2 ⟨p, q, hp, hq, hc⟩) _ _
  obtain ⟨w, hw⟩ := D.exists_listProd_of_mem_rootsSub hΨ hCmem
  have hxv : ((θ (P.root i) : ℝ) : WithTop ℝ) ≤ v (toΓ x) := by
    rw [hθi, hv, omegaΓ_inv]; exact hx
  have hyv : ((θ (P.root j) : ℝ) : WithTop ℝ) ≤ v (toΓ y) := by
    rw [hθj, hv, omegaΓ_inv]; exact hy
  have hbound : D.NormBound v θ ((C : GL (Fin D.n) Γk) : Matrix (Fin D.n) (Fin D.n) Γk) := by
    rw [hC, Units.val_mul, Units.val_mul, Units.val_mul, coe_x, coe_x, coe_x, coe_x]
    refine D.normBound_mul v θ (D.normBound_mul v θ (D.normBound_mul v θ
      (D.normBound_divExp v θ hxv) (D.normBound_divExp v θ hyv)) ?_) ?_
    · exact D.normBound_divExp v θ (by rwa [v.map_neg])
    · exact D.normBound_divExp v θ (by rwa [v.map_neg])
  rw [hw] at hbound
  have hcoef := D.le_of_normBound_listProd v θ h (heightList P h (pairCone (P := P) i j))
    heightList_nodup heightList_sorted (fun c hc => hΨ.pos c (mem_heightList.1 hc)) w hbound
  -- back to rational points
  set ofΓ := (Scheme.ΓSpecIso (CommRingCat.of k)).hom with hofΓ
  have htoΓofΓ : ∀ z : Γk, toΓ (ofΓ z) = z := by
    intro z
    change (ofΓ ≫ toΓ) z = z
    rw [hofΓ, htoΓ, Iso.hom_inv_id]
    rfl
  have heq : G.rootPt i x * G.rootPt j y * (G.rootPt i x)⁻¹ * (G.rootPt j y)⁻¹ =
      ((heightList P h (pairCone (P := P) i j)).map fun c => G.rootPt c (ofΓ (w c))).prod := by
    apply glHom_injective G
    rw [map_list_prod, List.map_map, map_mul, map_mul, map_mul, map_inv, map_inv, glHom_rootPt,
      glHom_rootPt, ← x_neg, ← x_neg]
    change C = _
    rw [hw, listProd]
    congr 1
    refine List.map_congr_left fun c _ => ?_
    rw [Function.comp_apply, glHom_rootPt, htoΓofΓ]
  rw [heq]
  refine Subgroup.list_prod_mem _ fun g hg => ?_
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hg
  have hcΨ := mem_heightList.1 hc
  obtain ⟨p, q, hp, hq, hroot⟩ := mem_pairCone.1 hcΨ
  have hchar : charOf k (P.root c) = p • charOf k (P.root i) + q • charOf k (P.root j) := by
    rw [hroot, ← charOfHom_apply, map_add, map_nsmul, map_nsmul, charOfHom_apply,
      charOfHom_apply]
  refine Subgroup.subset_closure (Set.mem_iUnion.2 ⟨p, Set.mem_iUnion.2 ⟨q,
    Set.mem_iUnion.2 ⟨hp, Set.mem_iUnion.2 ⟨hq, Set.mem_iUnion.2 ⟨?_, ?_⟩⟩⟩⟩⟩)
  · rw [← hchar]
    exact (mem_relativeRoots_iff G _).2 ⟨c, rfl⟩
  · rw [← hchar, mem_rootFiltration_root_iff]
    refine ⟨ofΓ (w c), rfl, ?_⟩
    have hcw := hcoef c hc
    rw [hroot, map_add, map_nsmul, map_nsmul, hθi, hθj] at hcw
    rw [← omegaΓ_inv omega, htoΓofΓ]
    convert hcw using 2
    simp [nsmul_eq_mul]

variable [IsAffineHom G.H.X.hom] [Mono G.t.hom.hom.left] in
/-- **The Chevalley root family is a valuation of the root datum** (KP Definition 6.1.2,
axioms V 0–V 5), for a valuation `omega` of `k` with at least three values. -/
theorem isRootDatumValuation (hω : 3 ≤ (Set.range omega).encard) :
    IsRootDatumValuation G.t (family G omega) where
  eq_top_of_not_mem_roots := eq_top_of_not_mem_roots G omega
  eq_top_of_not_mem := eq_top_of_not_mem G omega
  three_le_encard := three_le_encard G omega hω
  one_mem := one_mem G omega
  mul_mem := mul_mem G omega
  inv_mem := inv_mem G omega
  eq_top_iff := eq_top_iff G omega
  reflection := reflection G omega
  commutator := commutator G omega
  double := double G omega
  opposite := opposite G omega

end ChevalleyRootFamily

end Langlands.Geometry.Building
