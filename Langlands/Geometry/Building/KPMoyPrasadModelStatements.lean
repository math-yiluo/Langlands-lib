import Langlands.Geometry.Building.KPMinimalCongruentCentralizer
import Langlands.Geometry.Building.KPUnramifiedApartmentLift
import Langlands.GroupScheme.IntegralModel.UnramifiedModelDescent
import Langlands.GroupScheme.IntegralModel.CongruenceTower

/-! # The models `𝒢_{x,r}`, `𝒰_ψ` and `𝒵_r` over the integers of `F`

Let `F` be a nonarchimedean local field with maximal unramified extension
`K = inertiaFixedField F`, `P : ParahoricBuildingData G` and `x` a point of the apartment of
`P`. This module states the existence of the smooth models over `𝒪[F]` of KP §9.8.2 and
Proposition 9.8.3(2) (the descent of the constant-depth models `𝒢_{x,r}` of KP §8.5),
Proposition 8.5.16 for them, the root models `𝒰_ψ` of KP 9.4.5 and Lemma 9.4.6, and the
centralizer models `𝒵_r` of KP 13.3.3. Every model is characterized by its integral points over
the integers of `K`, as in KP Fact 2.10.16; its integral points over `𝒪[F]` are then the
`Gal(K/F)`-fixed points.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj NNReal ValuativeRel
open Langlands.GroupScheme Langlands.LocalGalois.Separable
open Langlands.GroupScheme.GaloisPointComparison

namespace Langlands.Geometry.Building

private instance moyPrasadModelBaseChangeAffineHom {F : Type u} [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] :
    IsAffineHom (baseChanged F (UnramifiedClosure F) G).X.hom := by
  change IsAffineHom
    (CategoryTheory.Limits.pullback.snd G.X.hom (baseMap F (UnramifiedClosure F)))
  infer_instance

/-- **KP §9.8.2 and Proposition 9.8.3(2) at the constant concave function `r`.** Let
`P : ParahoricBuildingData G` satisfy the apartment axioms, let `t` be a special torus
containing the maximal split torus `S` of `P` with an apartment lift `L` to `K`, and let
`x ∈ A(S)` and `r ≥ 0`. There is a smooth affine model `𝒢_{x,r}` of `G` over `𝒪[F]` with
geometrically connected fibres, the descent of the model of KP Theorem 8.5.2 for `G_K`: its
integral points over the integers of `K` are `G(K)_{x,r}` (computed in the apartment of the
lift), and its integral points over `𝒪[F]` are `P_{x,r} = G(F)_{x,r}`, the group generated by
`Z(F)_r` and the root blocks `U_{a,x,r} U_{2a,x,r}`. Together the two equalities give
`G(F)_{x,r} = G(K)_{x,r} ∩ G(F)`. -/
def MoyPrasadModelStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G), P.SatisfiesApartmentAxioms →
    ∀ (h : P.MinimalCongruentCentralizerOrder) (t : P.UnramifiedComparisonTorus)
      (L : t.ApartmentLift) (x : P.Apartment) (r : ℝ≥0),
      ∃ M : IntegralModel ↥𝒪[F] F G,
        M.IsSmooth ∧ M.HasGeometricallyConnectedFibres ∧
        M.baseChangeUnramified.integralPoints =
          L.buildingData.minimalCongruentMoyPrasad L.centralizer_isTorus (L.e x) r ∧
        M.integralPoints = P.minimalCongruentMoyPrasad h x r

/-- **KP Proposition 8.5.16 for the descended models `𝒢_{x,r}`.** Let `M` be a smooth model of
`G` over `𝒪[F]` whose integral points over the integers of `K` are `G(K)_{x,r}`. For every
integer `n ≥ 1`, the `n`-th congruence subgroup `ker(M(𝒪[F]) → M(𝒪[F]/𝔪ⁿ))` is
`P_{x,r+n}`. The model is characterized by its points over the integers of `K`; its points
over `𝒪[F]` alone do not determine it. -/
def MoyPrasadModelCongruenceStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G), P.SatisfiesApartmentAxioms →
    ∀ (h : P.MinimalCongruentCentralizerOrder) (t : P.UnramifiedComparisonTorus)
      (L : t.ApartmentLift) (x : P.Apartment) (r : ℝ≥0) (M : IntegralModel ↥𝒪[F] F G),
      M.IsSmooth →
      M.baseChangeUnramified.integralPoints =
        L.buildingData.minimalCongruentMoyPrasad L.centralizer_isTorus (L.e x) r →
      ∀ n : ℕ+, M.congruenceSubgroupAt n = P.minimalCongruentMoyPrasad h x (r + ((n : ℕ) : ℝ≥0))

/-- **KP 9.4.5 and Lemma 9.4.6.** Let `ψ` be an affine root of `P` with derivative the
relative root `a`, and let `j : U ⟶ G` represent the root subgroup `U_a`. There is a smooth
model `𝒰_ψ` of `U` over `𝒪[F]` with geometrically connected fibres such that, for every point
`z` of the apartment with `ψ(z) = 0` and every apartment lift `L`, the integral points of
`𝒰_ψ` over the integers of `K` have the image `U_a(K) ∩ G(K)^1_z` in `G(K)` (the `a`-root
group of the Bruhat–Tits model `𝒢^1_z`, independent of `z`), and its integral points over
`𝒪[F]` have the image `U_ψ` in `G(F)`. -/
def AffineRootGroupModelStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G), P.SatisfiesApartmentAxioms →
    ∀ (ψ : P.affineRoots) (α : relativeRoots P.i), ψ.1.linear = rootForm P.i α →
    ∀ (U : GroupScheme (Spec (CommRingCat.of F))) (j : U ⟶ G),
      (RelativeRoot.subgroup P.i α).IsRepresentedBy j →
      ∃ M : IntegralModel ↥𝒪[F] F U,
        M.IsSmooth ∧ M.HasGeometricallyConnectedFibres ∧
        (∀ (t : P.UnramifiedComparisonTorus) (L : t.ApartmentLift) (z : P.Apartment),
          ψ.1 z = 0 →
          M.baseChangeUnramified.integralPoints.map (rationalPoints.map
              ((GroupScheme.baseChange (baseMap F (UnramifiedClosure F))).map j)) =
            (rationalPoints.map
                ((GroupScheme.baseChange (baseMap F (UnramifiedClosure F))).map j)).range ⊓
              L.buildingData.oneStabilizer (L.buildingData.apartmentMap (L.e z))) ∧
        M.integralPoints.map (rationalPoints.map j) = P.affineRootGroup α ψ.1

/-- **KP 13.3.3: the centralizer models `𝒵_r`.** Let `Z = Z_G(S)` be the centralizer of the
maximal split torus of `P` and `r ≥ 0`. There is a smooth model `𝒵_r` of `Z` over `𝒪[F]` with
geometrically connected fibres such that

* its integral points over the integers of `K` are `Z(K)_{x₀,r}`, computed at the unique point
  `x₀` of the building of `Z` with the special-torus lift chosen in the definition of
  `minimalCongruentCentralizerPoints`;
* its integral points over `𝒪[F]` are `Z(F)_r = P.minimalCongruentCentralizerPoints r`;
* for every point `x` of the apartment of `P` and every apartment lift `L` of `G`, the image of
  its integral points over the integers of `K` in `G(K)` is `Z(K) ∩ G(K)_{x,r}` (KP Lemma
  8.5.19 and the proof of Proposition 9.8.3): `𝒵_r` is the fixed-point scheme of the action
  of the standard model of `S` on `𝒢_{x,r}`. -/
def CentralizerModelStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G) (r : ℝ≥0),
    ∃ M : IntegralModel ↥𝒪[F] F P.centralizer.Z,
      M.IsSmooth ∧ M.HasGeometricallyConnectedFibres ∧
      M.baseChangeUnramified.integralPoints =
        P.centralizerUnramifiedApartmentLift.2.buildingData.minimalCongruentMoyPrasad
          P.centralizerUnramifiedApartmentLift.2.centralizer_isTorus
          (P.centralizerUnramifiedApartmentLift.2.e P.centralizerBuildingPoint) r ∧
      M.integralPoints = P.minimalCongruentCentralizerPoints r ∧
      ∀ (t : P.UnramifiedComparisonTorus) (L : t.ApartmentLift) (x : P.Apartment),
        M.baseChangeUnramified.integralPoints.map (rationalPoints.map
            ((GroupScheme.baseChange (baseMap F (UnramifiedClosure F))).map P.centralizer.j)) =
          (rationalPoints.map ((GroupScheme.baseChange
              (baseMap F (UnramifiedClosure F))).map P.centralizer.j)).range ⊓
            L.buildingData.minimalCongruentMoyPrasad L.centralizer_isTorus (L.e x) r

end Langlands.Geometry.Building
