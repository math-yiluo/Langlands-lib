import Langlands.Geometry.Building.UnramifiedZeroFixerSharpComparisonStatement
import Langlands.Geometry.Building.IntegerValuationNormalizerSharpReduction
import Langlands.Geometry.Building.UnramifiedSimplyConnectedNormalizerAffineWeylProof

/-! # Proof: zero-group pointwise fixers and sharp fixers over the maximal unramified field -/

noncomputable section

universe u

namespace Langlands.Geometry.Building

/-- **Zero-group pointwise fixers are generated by the whole-apartment zero fixer and the
sharp fixer**, over the maximal unramified extension of a nonarchimedean local field, for
every supplied building datum `C`, zero datum `E`, and nonempty bounded apartment subset. -/
theorem unramifiedZeroFixerSharpComparison :
    UnramifiedZeroFixerSharpComparisonStatement.{u} := by
  intro F _ _ _ _ H _ C E Ω hne hb
  exact E.wholeApartmentZeroFixer_sup_sharpFixer_eq_of_simplyConnectedNormalizer C
    MaximalUnramified.simplyConnectedNormalizerAffineWeyl hne hb

end Langlands.Geometry.Building
