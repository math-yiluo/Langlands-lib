import Langlands.Geometry.Building.UnramifiedFixedDepthZeroOppositeStatement
import Langlands.Geometry.Building.UnramifiedFixedWallInvarianceStatement
import Langlands.Geometry.Building.UnramifiedFixedNormalizerTransportReduction
import Langlands.Geometry.Building.MaximalUnramifiedApartmentInjective
import Langlands.GroupScheme.Rational.RelativeRootNegationProof

/-! # Wall invariance from depth-zero opposite factors and Levi transport

Let `K/k` be a field extension, `S ⊆ T` tori of `G` over `k` and `D` an apartment class of
`(G_K, T_K)`. If `u ∈ U_a(k)` has nonnegative restricted depth at a point `z` of the apartment
of `D`, then its image in `G(K)` lies in the sharp fixer `G(K)^♯_z`. With the depth-zero
statement for the opposite factors of `m(u) = u' u u''` and with Levi transport, this shows
that `m(u)` fixes the restricted family at every Galois-fixed point of the wall
`φ_a(u) = 0`.
-/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.GaloisPointComparison
open Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

section General

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom] [Smooth G.X.hom]
  {S T : CommGroupScheme (Spec (CommRingCat.of k))}

local notation "b" => algebraBaseMap k K
local notation "S_K" => CategoryTheory.Functor.obj (CommGroupScheme.baseChange b) S
local notation "T_K" => CategoryTheory.Functor.obj (CommGroupScheme.baseChange b) T
local notation "G_K" => baseChanged k K G

private instance wallInvarianceExtendedAffine : IsAffineHom (G_K).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom b)
  infer_instance

private instance wallInvarianceExtendedSmooth : Smooth (G_K).X.hom := by
  change Smooth (CategoryTheory.Limits.pullback.snd G.X.hom b)
  infer_instance

/-- **Nonnegative restricted depth lies in the sharp fixer.** If `u ∈ U_a(k)` for a root `a`
of `S` and the torus-then-field restriction of the point `x` of the apartment of `D` takes a
nonnegative value at `u`, then the image of `u` in `G(K)` lies in `G(K)^♯_x`. -/
theorem KPApartmentData.rationalExtend_mem_sharpFixer_of_nonneg
    {iS : S.toGrp ⟶ G} [Mono iS.hom.hom.left] {iT : T.toGrp ⟶ G} {f : S ⟶ T}
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    [Mono ((GroupScheme.baseChange b).map iT).hom.hom.left]
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus (T_K).toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs (T := T_K) ((GroupScheme.baseChange b).map iT))
    {ω : Kˣ → ℝ} (D : KPApartmentData (S := T_K) ((GroupScheme.baseChange b).map iT) ω)
    (x : D.Apartment) {a : characterLattice S} (ha : a ∈ relativeRoots iS)
    {g : rationalPoints G} (hg : g ∈ rootGroupPoints iS a)
    (h0 : 0 ≤ torusFieldRestrictedRootFunctionFamily (k := k) (K := K) hS hT hE
      (D.isRootDatumValuation_of_mem x.mem) ((CommGroupScheme.baseChange b).map f) a g) :
    rationalExtend k K G g ∈ D.sharpFixer {x} := by
  have hfK : CommGroupScheme.groupHom ((CommGroupScheme.baseChange b).map f) ≫
      (GroupScheme.baseChange b).map iT = (GroupScheme.baseChange b).map iS := by
    rw [← hf, Functor.map_comp]
    rfl
  have hmem : g ∈ rootFiltration iS (torusFieldRestrictedRootFunctionFamily (k := k) (K := K)
      hS hT hE (D.isRootDatumValuation_of_mem x.mem) ((CommGroupScheme.baseChange b).map f))
      a 0 :=
    ⟨hg, by simpa using h0⟩
  rw [rootFiltration_torusFieldRestrictedRootFunctionFamily iS hS hT hE _ _ hfK a ha 0] at hmem
  change rationalExtend k K G g ∈ torusRestrictedRootDepthSubgroup _ _ _ 0 at hmem
  have hsub : torusRestrictedRootDepthSubgroup (D.isRootDatumValuation_of_mem x.mem)
      ((CommGroupScheme.baseChange b).map f) (characterLattice.baseChange b S a) 0 ≤
      D.sharpFixer {x} :=
    iSup_le fun χ => iSup_le fun hχ => iSup_le fun m => iSup_le fun _ =>
      iSup_le fun _ => by
        rw [mul_zero]
        have hle := D.rootFixer_le_sharpFixer ⟨χ, hχ⟩ {x}
        rw [D.rootFixer_singleton] at hle
        exact hle
  exact hsub hmem

omit [Smooth G.X.hom] in
/-- **Depth-zero root filtrations lie in the sharp fixer.** For any property `P` of roots, the
subgroup generated by the groups `U_{χ,x,0}` for the roots `χ` with `P χ` lies in
`G(K)^♯_x`. -/
theorem KPApartmentData.iSup_filtration_zero_le_sharpFixer {iT : T.toGrp ⟶ G}
    [Mono ((GroupScheme.baseChange b).map iT).hom.hom.left]
    {ω : Kˣ → ℝ} (D : KPApartmentData (S := T_K) ((GroupScheme.baseChange b).map iT) ω)
    (x : D.Apartment) (P : characterLattice (T_K) → Prop) :
    (⨆ (χ : characterLattice (T_K))
      (_ : χ ∈ relativeRoots (T := T_K) ((GroupScheme.baseChange b).map iT))
      (_ : P χ), D.filtration x χ 0) ≤ D.sharpFixer {x} :=
  iSup_le fun χ => iSup_le fun hχ => iSup_le fun _ => by
    have hle := D.rootFixer_le_sharpFixer ⟨χ, hχ⟩ {x}
    rw [D.rootFixer_singleton] at hle
    exact hle

/-- **Invariance of the restricted family under a Levi-corrected element of the sharp
fixer.** Let `n ∈ N_G(S)(k)` and let `h ∈ G(K)` be a Levi correction of `n` at `x` as in
`leviTransport_apartmentMap_torusFieldRestricted`. If the image of `n` in `G(K)` lies in
`G(K)^♯_x`, then `n` fixes the torus-then-field restriction of `x`. -/
theorem KPApartmentData.torusFieldRestricted_smul_eq_of_mem_sharpFixer
    {iS : S.toGrp ⟶ G} [Mono iS.hom.hom.left] {iT : T.toGrp ⟶ G} {f : S ⟶ T}
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    [Mono ((GroupScheme.baseChange b).map iT).hom.hom.left]
    (hGK : IsConnectedReductive (G_K))
    (hiT : IsMaximalSplitTorus (T := T_K) ((GroupScheme.baseChange b).map iT))
    (hS : IsSplitTorus S.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs (T := T_K) ((GroupScheme.baseChange b).map iT))
    {ω : Kˣ → ℝ} (D : KPApartmentData (S := T_K) ((GroupScheme.baseChange b).map iT) ω)
    (n : normalizerPoints iS) (x : D.Apartment) {h : rationalPoints (G_K)}
    (hh : h ∈ centralizerPoints (T := S_K) ((GroupScheme.baseChange b).map iS))
    (hlevi : h ∈ ⨆ (χ : characterLattice (T_K))
      (_ : χ ∈ relativeRoots (T := T_K) ((GroupScheme.baseChange b).map iT))
      (_ : (CommGroupScheme.baseChange b).map f ≫ χ = 0), D.filtration x χ 0)
    (hw : rationalExtend k K G (n : rationalPoints G) * h ∈
      normalizerPoints (T := T_K) ((GroupScheme.baseChange b).map iT))
    (hn : rationalExtend k K G (n : rationalPoints G) ∈ D.sharpFixer {x}) :
    n • torusFieldRestrictedRootFunctionFamily (k := k) (K := K) hS hiT.isSplitSubtorus.1 hE
        (D.isRootDatumValuation_of_mem x.mem) ((CommGroupScheme.baseChange b).map f) =
      torusFieldRestrictedRootFunctionFamily (k := k) (K := K) hS hiT.isSplitSubtorus.1 hE
        (D.isRootDatumValuation_of_mem x.mem) ((CommGroupScheme.baseChange b).map f) := by
  have hfix := D.normalizer_smul_eq_self_of_mem_sharpFixer hGK hiT x ⟨_, hw⟩
    (mul_mem hn (D.iSup_filtration_zero_le_sharpFixer x _ hlevi))
  have hcongr := congrArg (fun y : D.Apartment =>
    torusFieldRestrictedRootFunctionFamily (k := k) (K := K) hS hiT.isSplitSubtorus.1 hE
      (D.isRootDatumValuation_of_mem y.mem) ((CommGroupScheme.baseChange b).map f)) hfix
  exact (D.leviTransport_apartmentMap_torusFieldRestricted hf hS hiT.isSplitSubtorus.1 hE n x
    hh hlevi hw).2.symm.trans hcongr

end General

private instance wallInvarianceReductionAffineHom {F : Type u} [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] :
    IsAffineHom (baseChanged F (inertiaFixedField F) G).X.hom := by
  change IsAffineHom
    (CategoryTheory.Limits.pullback.snd G.X.hom (baseMap F (inertiaFixedField F)))
  infer_instance

set_option maxHeartbeats 8000000 in
/-- `UnramifiedFixedDepthZeroOppositeStatement` for fixed data, with explicit binders. -/
theorem unramifiedFixedDepthZeroOpposite_apply
    (hDZ : UnramifiedFixedDepthZeroOppositeStatement.{u})
    (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    [IsAffineHom G.X.hom] [Smooth G.X.hom]
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (iS : S.toGrp ⟶ G)
    (hiS : IsMaximalSplitTorus iS) [Mono iS.hom.hom.left]
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (iT : T.toGrp ⟶ G) (f : S ⟶ T)
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    (hiT : IsMaximalSplitTorus (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    [Mono ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT).hom.hom.left]
    (hE : RelativeRoot.HasOppositeFactorPairs (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    (D : KPApartmentData (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)
      (IntegerValuation.order (MaximalUnramified.valuation F)))
    (C : CentralizerDatum (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    (hDC : IntegerValuation.IsOmegaCompatible (MaximalUnramified.valuation F) D C)
    (z : D.Apartment) (hz : (∀ σ : inertiaFixedField F ≃ₐ[F] inertiaFixedField F,
        RootFunctionFamily.galoisAction F (inertiaFixedField F) T G σ z.val = z.val)) :
    ∀ a ∈ relativeRoots iS, ∀ g ∈ rootGroupPoints iS a, g ≠ 1 →
      torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
        hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
        ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) a g = 0 →
        ∀ g' ∈ rootGroupPoints iS (-a), ∀ g'' ∈ rootGroupPoints iS (-a),
          g' * g * g'' ∈ normalizerPoints iS →
            0 ≤ torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
                hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
                ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) (-a) g' ∧
            0 ≤ torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
                hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
                ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) (-a) g'' :=
  hDZ F G hG S iS hiS T iT f hf hiT hE D C hDC z hz

set_option maxHeartbeats 8000000 in
/-- The Levi correction provided by `UnramifiedFixedLeviTransportStatement` for fixed data,
with explicit binders (the fixedness of the transported point is dropped). -/
theorem unramifiedFixedLeviTransport_apply
    (hL : UnramifiedFixedLeviTransportStatement.{u})
    (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    [IsAffineHom G.X.hom] [Smooth G.X.hom]
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (iS : S.toGrp ⟶ G)
    (hiS : IsMaximalSplitTorus iS) [Mono iS.hom.hom.left]
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (iT : T.toGrp ⟶ G) (f : S ⟶ T)
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    (hiT : IsMaximalSplitTorus (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    [Mono ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT).hom.hom.left]
    (D : KPApartmentData (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)
      (IntegerValuation.order (MaximalUnramified.valuation F)))
    (C : CentralizerDatum (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    (hDC : IntegerValuation.IsOmegaCompatible (MaximalUnramified.valuation F) D C)
    (n : normalizerPoints iS) (z : D.Apartment) (hz : (∀ σ : inertiaFixedField F ≃ₐ[F] inertiaFixedField F,
        RootFunctionFamily.galoisAction F (inertiaFixedField F) T G σ z.val = z.val)) :
    ∃ h : rationalPoints ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj G),
      h ∈ centralizerPoints
      (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj S)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iS) ∧
      h ∈ (⨆ (χ : characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T))
      (_ : χ ∈ relativeRoots (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
        ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
      (_ : (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f ≫ χ = 0), D.filtration z χ 0) ∧
      (show rationalPoints ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj G) from
        rationalExtend F (inertiaFixedField F) G (n : rationalPoints G)) * h ∈
      normalizerPoints (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
        ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT) := by
  obtain ⟨h, hh, hlevi, hw, -⟩ := hL F G hG S iS hiS T iT f hf hiT D C hDC n z hz
  exact ⟨h, hh, hlevi, hw⟩

set_option maxHeartbeats 1600000 in
/-- **Wall invariance for fixed data.** Let `u ∈ U_a(F)` with `φ_a(u) = 0` at the point `z`,
let `u', u'' ∈ U_{-a}(F)` with `0 ≤ φ_{-a}(u')`, `0 ≤ φ_{-a}(u'')` and `m = u' u u'' ∈ N(F)`, and
let `h` be a Levi correction of `m` at `z`. Then `m` fixes the restricted family at `z`. -/
theorem unramifiedFixedWallInvariance_core
    (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    [IsAffineHom G.X.hom] [Smooth G.X.hom]
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (iS : S.toGrp ⟶ G)
    (hiS : IsMaximalSplitTorus iS) [Mono iS.hom.hom.left]
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (iT : T.toGrp ⟶ G) (f : S ⟶ T)
    (hf : CommGroupScheme.groupHom f ≫ iT = iS)
    (hiT : IsMaximalSplitTorus (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    [Mono ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT).hom.hom.left]
    (hE : RelativeRoot.HasOppositeFactorPairs (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
    (D : KPApartmentData (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)
      (IntegerValuation.order (MaximalUnramified.valuation F)))
    (z : D.Apartment) {a : characterLattice S} (ha : a ∈ relativeRoots iS)
    {g : rationalPoints G} (hg : g ∈ rootGroupPoints iS a)
    (hφ : torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
        hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
        ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) a g = 0)
    {g' : rationalPoints G} (hg' : g' ∈ rootGroupPoints iS (-a))
    (h0' : 0 ≤ torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
        hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
        ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) (-a) g')
    {g'' : rationalPoints G} (hg'' : g'' ∈ rootGroupPoints iS (-a))
    (h0'' : 0 ≤ torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
        hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
        ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) (-a) g'')
    (n : normalizerPoints iS) (hn : (n : rationalPoints G) = g' * g * g'')
    {h : rationalPoints ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj G)}
    (hh : h ∈ centralizerPoints
      (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj S)
      ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iS))
    (hlevi : h ∈ ⨆ (χ : characterLattice ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T))
      (_ : χ ∈ relativeRoots (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
        ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
      (_ : (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f ≫ χ = 0), D.filtration z χ 0)
    (hw : (show rationalPoints ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj G) from
        rationalExtend F (inertiaFixedField F) G (n : rationalPoints G)) * h ∈
      normalizerPoints (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
        ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)) :
    n • torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
        hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
        ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) =
      torusFieldRestrictedRootFunctionFamily (k := F) (K := inertiaFixedField F)
        hiS.isSplitSubtorus.1 hiT.isSplitSubtorus.1 hE (D.isRootDatumValuation_of_mem z.mem)
        ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f) := by
  have hna : -a ∈ relativeRoots iS := relativeRootNegation F G hG S iS hiS a ha
  have hmK : rationalExtend F (inertiaFixedField F) G (n : rationalPoints G) ∈
      D.sharpFixer {z} := by
    rw [hn, map_mul, map_mul]
    exact mul_mem (mul_mem
      (D.rationalExtend_mem_sharpFixer_of_nonneg hf hiS.isSplitSubtorus.1
        hiT.isSplitSubtorus.1 hE z hna hg' h0')
      (D.rationalExtend_mem_sharpFixer_of_nonneg hf hiS.isSplitSubtorus.1
        hiT.isSplitSubtorus.1 hE z ha hg hφ.symm.le))
      (D.rationalExtend_mem_sharpFixer_of_nonneg hf hiS.isSplitSubtorus.1
        hiT.isSplitSubtorus.1 hE z hna hg'' h0'')
  exact D.torusFieldRestricted_smul_eq_of_mem_sharpFixer hf
    (hG.baseChange_of_algebraicExtension (K := inertiaFixedField F)) hiT
    hiS.isSplitSubtorus.1 hE n z hh hlevi hw hmK

/-- **Wall invariance from depth zero and Levi transport** (internal reduction). The
depth-zero statement for the opposite factors and the Levi transport statement imply that,
at every Galois-fixed point of the wall `φ_a(u) = 0`, `m(u)` fixes the restricted family. -/
def UnramifiedFixedWallInvarianceReductionStatement : Prop :=
  UnramifiedFixedDepthZeroOppositeStatement.{u} →
    UnramifiedFixedLeviTransportStatement.{u} →
      UnramifiedFixedWallInvarianceStatement.{u}

set_option maxHeartbeats 8000000 in
/-- The factors `u, u', u''` lie in `G(K)^♯_z` by depth zero, so `m(u)` does; with the Levi
correction `h` from Levi transport, `m(u) h` fixes `z`, and Levi transport equivariance
identifies the restriction of `m(u) h · z` with `m(u)` applied to that of `z`. -/
theorem unramifiedFixedWallInvariance_of_depthZero_of_leviTransport :
    UnramifiedFixedWallInvarianceReductionStatement.{u} := by
  intro hDZ hL F _ _ _ _ G hG S iS hiS T iT f hf
  let : IsAffineHom G.X.hom := hG.isAffineHom
  let : Smooth G.X.hom := hG.smooth
  have := mono_of_isMaximalSplitTorus hiS
  intro hiT
  have : Mono ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT).hom.hom.left :=
    mono_of_isMaximalSplitTorus hiT
  intro hE D C hDC fixed φ z hz a ha g hg hg1 g' hg' g'' hg'' hm hφ
  obtain ⟨h0', h0''⟩ := unramifiedFixedDepthZeroOpposite_apply hDZ F G hG S iS hiS T iT f hf
    hiT hE D C hDC z hz a ha g hg hg1 hφ g' hg' g'' hg'' hm
  obtain ⟨h, hh, hlevi, hw⟩ := unramifiedFixedLeviTransport_apply hL F G hG S iS hiS T iT f hf
    hiT D C hDC ⟨_, hm⟩ z hz
  exact unramifiedFixedWallInvariance_core F G hG S iS hiS T iT f hf hiT hE D z ha hg hφ hg'
    h0' hg'' h0'' ⟨_, hm⟩ rfl hh hlevi hw

end Langlands.Geometry.Building
