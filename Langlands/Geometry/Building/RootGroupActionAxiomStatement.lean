import Langlands.Geometry.Building.ParahoricBuildingAxioms

/-! # Axiom 4.1.8 (2) and (3) for the building of a valuation of the root datum -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry

namespace Langlands.Geometry.Building

/-- Parts (2) and (3) of KP Axiom 4.1.8 for the building of KP Chapter 7, on supplied data over
a nonarchimedean local field. Assume V 7 and AS 2–AS 5 for the class `A(S)` of
`P : ParahoricBuildingData G` (the Chapter 7 hypotheses as corrected in 2024, with V 7 in
addition). Then, for every non-empty bounded `Ω ⊆ A(S)`:

* (2) the elements of `G(F)^0` fixing the image of `Ω` in `B(G)` pointwise form the subgroup
  generated by `Z(F)^0` and the `U_ψ` with `ψ ∈ Ψ` non-negative on `Ω`;
* (3) for every relative root `a`, `U_a(F) ∩ G(F)^0_Ω = U_{a,Ω,0}`.

In KP these follow from Proposition 7.7.5 (1), Definition 7.4.1, Lemma 7.4.4 (3) and
Lemma 7.7.3 (KP 4.1.28). No existence of the data is asserted. -/
def RootGroupActionAxiomStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G),
    P.SatisfiesApartmentAxioms →
      P.HasZeroFixerGenerators ∧ P.HasRootZeroFixers

end Langlands.Geometry.Building
