import Langlands.Geometry.Building.MaximalUnramifiedBuildingData
import Langlands.Geometry.Building.KPZeroSubgroups

/-! # Zero-group pointwise fixers and sharp fixers over the maximal unramified field -/

noncomputable section

universe u

open AlgebraicGeometry
open Langlands.GroupScheme Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

/-- **Zero-group pointwise fixers are generated by the whole-apartment zero fixer and the
sharp fixer**, over the maximal unramified extension of a nonarchimedean local field.
This is a derived interface for Kaletha–Prasad Definition 7.4.1(4) and
Proposition 7.7.5(1): the whole-apartment zero fixer represents the embedded `Z(K)^0`.
The supplied data `C` and `E` are arbitrary, and `Ω` is nonempty and bounded in every real
affine coordinate. -/
def UnramifiedZeroFixerSharpComparisonStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (H : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F))))
    [IsAffineHom H.X.hom]
    (C : MaximalUnramified.BuildingData F H)
    (E : UnramifiedZeroDatum F H) (Ω : Set C.Apartment),
    Ω.Nonempty → (∀ f : C.Apartment →ᵃ[ℝ] ℝ, BddAbove (f '' Ω)) →
    E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Ω) =
      (E.zeroPoints ⊓ C.pointwiseFixer (C.apartmentMap '' Set.univ)) ⊔ C.sharpFixer Ω

end Langlands.Geometry.Building
