import Langlands.Geometry.Building.KPApartmentAxioms
import Langlands.Geometry.Building.KPParahoric

/-!
# The filtered rank-one two-cell decomposition

KP Lemma 7.1.5(3) for the actual data of `P : ParahoricBuildingData G`. Let `a` be a
relative root and `ψ` an affine functional with derivative `a` whose actual root groups
jump, `U_{ψ+} ≠ U_ψ`. The subgroup `L` of `G(F)` generated by `U_ψ`, `U_{-ψ}` and
`Z(F)^0` should contain some `m ∈ N(F)` acting on the apartment as the reflection along
`ψ = 0`, and `L = U_{-ψ+} Z(F)^0 U_ψ ∪ U_ψ m Z(F)^0 U_ψ`.

`AffineRankOneTwoCellStatement` is a proposition definition, not proved here. The module
proves only the elementary containments of both cells, a coroot of `ψ` in `Ψ` (so the
reflection clause is not vacuous), and the reduction of the reverse containment to right
stability under the three generating subgroups.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped Pointwise CategoryTheory.MonObj
open Langlands.GroupScheme

namespace Langlands.Geometry.Building

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- The subgroup of `G(F)` generated by `U_ψ`, `U_{-ψ}` and `Z(F)^0` (KP Lemma 7.1.5(3)).
Here `U_{-ψ}` is the actual affine root group of the character `-a` and the functional
`-ψ`, and `Z(F)^0` is mapped into `G(F)` by the actual centralizer inclusion. -/
def affineRankOneSubgroup (α : relativeRoots P.i) (ψ : P.Apartment →ᵃ[ℝ] ℝ) :
    Subgroup (rationalPoints G) :=
  P.apartment.affineRootGroup α ψ ⊔
      P.apartment.affineRootGroup (-(α : characterLattice P.S)) (-ψ) ⊔
    P.centralizerZero.map (rationalPoints.map P.centralizer.j)

/-- KP's `L₁ = U_{-ψ+} · Z(F)^0 · U_ψ` (proof of Lemma 7.1.5(3)), as a set product. -/
def affineRankOneBaseCell (α : relativeRoots P.i) (ψ : P.Apartment →ᵃ[ℝ] ℝ) :
    Set (rationalPoints G) :=
  (P.apartment.affineRootGroupPlus (-(α : characterLattice P.S)) (-ψ) :
        Set (rationalPoints G)) *
      (P.centralizerZero.map (rationalPoints.map P.centralizer.j) : Set (rationalPoints G)) *
    (P.apartment.affineRootGroup α ψ : Set (rationalPoints G))

/-- KP's `L₂ = U_ψ · m · Z(F)^0 · U_ψ` (proof of Lemma 7.1.5(3)), as a set product. -/
def affineRankOneReflectionCell (α : relativeRoots P.i) (ψ : P.Apartment →ᵃ[ℝ] ℝ)
    (m : rationalPoints G) : Set (rationalPoints G) :=
  (P.apartment.affineRootGroup α ψ : Set (rationalPoints G)) * {m} *
      (P.centralizerZero.map (rationalPoints.map P.centralizer.j) : Set (rationalPoints G)) *
    (P.apartment.affineRootGroup α ψ : Set (rationalPoints G))

variable (α : relativeRoots P.i) (ψ : P.Apartment →ᵃ[ℝ] ℝ)

theorem affineRootGroup_le_affineRankOneSubgroup :
    P.apartment.affineRootGroup α ψ ≤ P.affineRankOneSubgroup α ψ :=
  le_sup_left.trans le_sup_left

theorem affineRootGroup_neg_le_affineRankOneSubgroup :
    P.apartment.affineRootGroup (-(α : characterLattice P.S)) (-ψ) ≤
      P.affineRankOneSubgroup α ψ :=
  le_sup_right.trans le_sup_left

theorem map_centralizerZero_le_affineRankOneSubgroup :
    P.centralizerZero.map (rationalPoints.map P.centralizer.j) ≤
      P.affineRankOneSubgroup α ψ :=
  le_sup_right

theorem affineRootGroupPlus_neg_le_affineRankOneSubgroup :
    P.apartment.affineRootGroupPlus (-(α : characterLattice P.S)) (-ψ) ≤
      P.affineRankOneSubgroup α ψ :=
  (KPApartmentData.affineRootGroupPlus_le (D := P.apartment) _ _).trans
    (P.affineRootGroup_neg_le_affineRankOneSubgroup α ψ)

/-- `1 ∈ L₁`. -/
theorem one_mem_affineRankOneBaseCell : (1 : rationalPoints G) ∈ P.affineRankOneBaseCell α ψ :=
  ⟨1, ⟨1, one_mem _, 1, one_mem _, one_mul 1⟩, 1, one_mem _, one_mul 1⟩

/-- `L₁ ⊆ L`. -/
theorem affineRankOneBaseCell_subset :
    P.affineRankOneBaseCell α ψ ⊆ P.affineRankOneSubgroup α ψ := by
  rintro _ ⟨_, ⟨a, ha, z, hz, rfl⟩, b, hb, rfl⟩
  exact mul_mem (mul_mem (P.affineRootGroupPlus_neg_le_affineRankOneSubgroup α ψ ha)
    (P.map_centralizerZero_le_affineRankOneSubgroup α ψ hz))
    (P.affineRootGroup_le_affineRankOneSubgroup α ψ hb)

/-- `L₂ ⊆ L` when `m ∈ L`. -/
theorem affineRankOneReflectionCell_subset {m : rationalPoints G}
    (hm : m ∈ P.affineRankOneSubgroup α ψ) :
    P.affineRankOneReflectionCell α ψ m ⊆ P.affineRankOneSubgroup α ψ := by
  rintro _ ⟨_, ⟨_, ⟨a, ha, _, rfl, rfl⟩, z, hz, rfl⟩, b, hb, rfl⟩
  exact mul_mem (mul_mem (mul_mem (P.affineRootGroup_le_affineRankOneSubgroup α ψ ha) hm)
    (P.map_centralizerZero_le_affineRankOneSubgroup α ψ hz))
    (P.affineRootGroup_le_affineRankOneSubgroup α ψ hb)

/-- `L` is the subgroup generated by the union of its three generating subgroups. -/
theorem affineRankOneSubgroup_eq_closure :
    P.affineRankOneSubgroup α ψ =
      Subgroup.closure ((P.apartment.affineRootGroup α ψ : Set (rationalPoints G)) ∪
        (P.apartment.affineRootGroup (-(α : characterLattice P.S)) (-ψ) :
          Set (rationalPoints G)) ∪
        (P.centralizerZero.map (rationalPoints.map P.centralizer.j) :
          Set (rationalPoints G))) := by
  rw [Subgroup.closure_union, Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq,
    Subgroup.closure_eq]
  rfl

/-- KP's reduction in the proof of Lemma 7.1.5(3): a set containing `1` and stable under
right multiplication by `U_ψ`, `U_{-ψ}` and `Z(F)^0` contains `L`. -/
theorem affineRankOneSubgroup_subset_of_mul_mem {L : Set (rationalPoints G)}
    (h1 : (1 : rationalPoints G) ∈ L)
    (hpos : ∀ g ∈ L, ∀ b ∈ P.apartment.affineRootGroup α ψ, g * b ∈ L)
    (hneg : ∀ g ∈ L, ∀ b ∈ P.apartment.affineRootGroup (-(α : characterLattice P.S)) (-ψ),
      g * b ∈ L)
    (hzero : ∀ g ∈ L, ∀ z ∈ P.centralizerZero.map (rationalPoints.map P.centralizer.j),
      g * z ∈ L) :
    (P.affineRankOneSubgroup α ψ : Set (rationalPoints G)) ⊆ L := by
  intro g hg
  rw [SetLike.mem_coe, affineRankOneSubgroup_eq_closure] at hg
  induction hg using Subgroup.closure_induction_right with
  | one => exact h1
  | mul_right x _ y hy ih =>
    rcases hy with (hy | hy) | hy
    · exact hpos x ih y hy
    · exact hneg x ih y hy
    · exact hzero x ih y hy
  | mul_inv_cancel x _ y hy ih =>
    rcases hy with (hy | hy) | hy
    · exact hpos x ih y⁻¹ (inv_mem hy)
    · exact hneg x ih y⁻¹ (inv_mem hy)
    · exact hzero x ih y⁻¹ (inv_mem hy)

/-- The decomposition `L = L₁ ∪ L₂` follows from `m ∈ L` and right stability of `L₁ ∪ L₂`
under the three generating subgroups, exactly as in KP's proof. The stability itself is
not proved here. -/
theorem coe_affineRankOneSubgroup_eq_of_mul_mem {m : rationalPoints G}
    (hm : m ∈ P.affineRankOneSubgroup α ψ)
    (hpos : ∀ g ∈ P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m,
      ∀ b ∈ P.apartment.affineRootGroup α ψ,
        g * b ∈ P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m)
    (hneg : ∀ g ∈ P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m,
      ∀ b ∈ P.apartment.affineRootGroup (-(α : characterLattice P.S)) (-ψ),
        g * b ∈ P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m)
    (hzero : ∀ g ∈ P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m,
      ∀ z ∈ P.centralizerZero.map (rationalPoints.map P.centralizer.j),
        g * z ∈ P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m) :
    (P.affineRankOneSubgroup α ψ : Set (rationalPoints G)) =
      P.affineRankOneBaseCell α ψ ∪ P.affineRankOneReflectionCell α ψ m :=
  Set.Subset.antisymm
    (P.affineRankOneSubgroup_subset_of_mul_mem α ψ
      (Or.inl (P.one_mem_affineRankOneBaseCell α ψ)) hpos hneg hzero)
    (Set.union_subset (P.affineRankOneBaseCell_subset α ψ)
      (P.affineRankOneReflectionCell_subset α ψ hm))

variable {P α ψ} in
/-- An actual jump `U_{ψ+} ≠ U_ψ` puts `ψ` in `Ψ′` (KP Definition 6.3.4). -/
theorem mem_extendedAffineRoots_of_ne (hψ : ψ.linear = rootForm P.i α)
    (hjump : P.apartment.affineRootGroupPlus α ψ ≠ P.apartment.affineRootGroup α ψ) :
    ψ ∈ P.apartment.extendedAffineRoots :=
  ⟨α, hψ, hjump⟩

variable {P} in
/-- Under the apartment axioms every `ψ ∈ Ψ′` has a coroot vector for `Ψ`: either `ψ ∈ Ψ`,
or `2ψ ∈ Ψ` (AS 4) and twice a coroot of `2ψ` is one for `ψ`. -/
theorem exists_isCoroot_affineRoots_of_mem
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    {ψ : P.Apartment →ᵃ[ℝ] ℝ} (hψ : ψ ∈ P.apartment.extendedAffineRoots) :
    ∃ v : TranslationSpace P.i, AffineRootSystem.IsCoroot P.affineRoots ψ v := by
  rcases hA.mem_or_two_smul_mem ψ hψ with h | h
  · exact hA.isAffineRootSystem_affineRoots.exists_isCoroot ψ h
  · obtain ⟨w, hw1, hw2⟩ := hA.isAffineRootSystem_affineRoots.exists_isCoroot _ h
    have hlin : ((2 : ℝ) • ψ).linear = (2 : ℝ) • ψ.linear := rfl
    refine ⟨(2 : ℝ) • w, ?_, fun e he => ?_⟩
    · rw [hlin, LinearMap.smul_apply] at hw1
      rw [map_smul]
      exact hw1
    · have heq : e - e.linear ((2 : ℝ) • w) • ψ = e - e.linear w • (2 : ℝ) • ψ := by
        rw [map_smul, smul_eq_mul, mul_comm, mul_smul]
      rw [heq]
      exact hw2 e he
end ParahoricBuildingData

/-- KP Lemma 7.1.5(3) on the actual apartment of building data. For every nonarchimedean
local field `F` in universe `u`, group scheme `G` and `P : ParahoricBuildingData G` whose
apartment satisfies the apartment axioms for the actual centralizer, every relative root
`a` and affine functional `ψ` with derivative `a` and `U_{ψ+} ≠ U_ψ`: the subgroup `L`
generated by `U_ψ`, `U_{-ψ}` and `Z(F)^0` contains some `m ∈ N(F)` that acts on the
apartment as the coroot reflection of `ψ` for every coroot vector of `ψ` in `Ψ`, and
`L = U_{-ψ+} Z(F)^0 U_ψ ∪ U_ψ m Z(F)^0 U_ψ`. -/
def AffineRankOneTwoCellStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (P : ParahoricBuildingData G),
    P.apartment.SatisfiesApartmentAxioms P.centralizer →
      ∀ (α : relativeRoots P.i) (ψ : P.Apartment →ᵃ[ℝ] ℝ), ψ.linear = rootForm P.i α →
        P.apartment.affineRootGroupPlus α ψ ≠ P.apartment.affineRootGroup α ψ →
          ∃ m : normalizerPoints P.i,
            (m : rationalPoints G) ∈ P.affineRankOneSubgroup α ψ ∧
            (∀ (v : TranslationSpace P.i) (hv : AffineRootSystem.IsCoroot P.affineRoots ψ v),
              P.apartment.normalizerAffineEquiv m = AffineRootSystem.affineReflection ψ hv.1) ∧
            (P.affineRankOneSubgroup α ψ : Set (rationalPoints G)) =
              P.affineRankOneBaseCell α ψ ∪
                P.affineRankOneReflectionCell α ψ (m : rationalPoints G)

end Langlands.Geometry.Building
