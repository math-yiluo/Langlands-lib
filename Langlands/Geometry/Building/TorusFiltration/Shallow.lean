import Langlands.Geometry.Building.TorusFiltration.ConnectedNeronModel
import Langlands.GroupScheme.IntegralModel.SmoothHomExtensionProof
import Langlands.GroupScheme.Torus.SplittingAssembly

/-! # The minimal congruent torus subgroup at depths below one -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.BruhatTits.IntegralModels Langlands.GroupScheme
open Langlands.LocalGalois.Separable
open scoped CategoryTheory.MonObj NNReal

namespace Langlands.Geometry.Building

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

local notation "K" => inertiaFixedField F

/-- The subgroup generated by the images of geometric character congruences
of all induced `K`-tori. At positive depth these are the standard subgroups
of the induced tori. -/
def inducedTorusStandardImages (T : CommGroupScheme (Spec (CommRingCat.of K)))
    (r : ℝ≥0) : Subgroup (rationalPoints T.toGrp) :=
  ⨆ (S : CommGroupScheme (Spec (CommRingCat.of K))) (_ : IsInducedTorus S) (f : S ⟶ T),
    (localGeometricCharacterCongruence F S r).map
      (rationalPoints.map (CommGroupScheme.groupHom f))

theorem inducedTorusStandardImages_antitone
    (T : CommGroupScheme (Spec (CommRingCat.of K))) :
    Antitone (inducedTorusStandardImages F T) := by
  intro r s hrs
  exact iSup_mono fun S => iSup_mono fun _ => iSup_mono fun _ =>
    Subgroup.map_mono (localGeometricCharacterCongruence_antitone F S hrs)

theorem map_inducedTorusStandardImages_le
    {T U : CommGroupScheme (Spec (CommRingCat.of K))} (f : T ⟶ U) (r : ℝ≥0) :
    (inducedTorusStandardImages F T r).map (rationalPoints.map (CommGroupScheme.groupHom f)) ≤
      inducedTorusStandardImages F U r := by
  simp only [inducedTorusStandardImages, Subgroup.map_iSup]
  refine iSup_le fun S => iSup_le fun hS => iSup_le fun g => ?_
  rw [Subgroup.map_map]
  exact le_iSup_of_le S (le_iSup_of_le hS (le_iSup_of_le (g ≫ f) le_rfl))

variable (T : CommGroupScheme (Spec (CommRingCat.of (inertiaFixedField F)))) [IsAffine T.X.left]
  (hT : IsTorus T.toGrp)

/-- The initial segment of the minimal congruent filtration. At zero it is
the Iwahori subgroup. At `0 < r < 1` it is generated by the first congruence
subgroup of the connected Néron model and all the induced-torus images. -/
def minimalCongruentShallowSubgroup (r : Set.Iio (1 : ℝ≥0)) :
    Subgroup (rationalPoints T.toGrp) :=
  if (r : ℝ≥0) = 0 then (connectedNeronModel F T hT).integralPoints
  else (connectedNeronModel F T hT).congruenceSubgroup ⊔ inducedTorusStandardImages F T r

theorem firstCongruence_le_minimalCongruentShallowSubgroup (r : Set.Iio (1 : ℝ≥0)) :
    (connectedNeronModel F T hT).congruenceSubgroup ≤
      minimalCongruentShallowSubgroup F T hT r := by
  by_cases h : (r : ℝ≥0) = 0
  · simpa only [minimalCongruentShallowSubgroup, ite_eq_left h] using
      (connectedNeronModel F T hT).congruenceSubgroup_le_integralPoints
  · simpa only [minimalCongruentShallowSubgroup, ite_eq_right h] using le_sup_left

set_option maxHeartbeats 800000 in
theorem minimalCongruentShallowSubgroup_le_integralPoints (r : Set.Iio (1 : ℝ≥0)) :
    minimalCongruentShallowSubgroup F T hT r ≤ (connectedNeronModel F T hT).integralPoints := by
  by_cases h : (r : ℝ≥0) = 0
  · simp only [minimalCongruentShallowSubgroup, ite_eq_left h, le_refl]
  · rw [minimalCongruentShallowSubgroup, ite_eq_right h]
    refine sup_le (connectedNeronModel F T hT).congruenceSubgroup_le_integralPoints ?_
    refine iSup_le fun S => iSup_le fun hS => iSup_le fun f => ?_
    let : IsAffine S.X.left := SplittingAssembly.isAffine_of_isTorus S.toGrp hS.isTorus
    let L := localTorusSplittingData F S hS.isTorus
    have hs : localTorusFiltration F S hS.isTorus r =
        localGeometricCharacterCongruence F S r := by
      rw [localTorusFiltration_eq_of_splitting F L.L S hS.isTorus L.splits]
      exact localTorusFiltrationAtSplitting_eq_geometric_of_induced
        F L.L S L.splits hS (pos_of_ne_zero h)
    rw [← hs, connectedNeronModel_integralPoints]
    exact (map_localTorusFiltration_le F S hS.isTorus hT f r).trans
      (localTorusFiltration_antitone F T hT zero_le)

theorem minimalCongruentShallowSubgroup_antitone :
    Antitone (minimalCongruentShallowSubgroup F T hT) := by
  intro r s hrs
  by_cases h : (r : ℝ≥0) = 0
  · simpa only [minimalCongruentShallowSubgroup, ite_eq_left h] using
      (minimalCongruentShallowSubgroup_le_integralPoints F T hT s)
  · have hs : (s : ℝ≥0) ≠ 0 := (lt_of_lt_of_le (pos_of_ne_zero h) hrs).ne'
    simp only [minimalCongruentShallowSubgroup, ite_eq_right h, ite_eq_right hs]
    exact sup_le_sup_left (inducedTorusStandardImages_antitone F T hrs) _

/-- The point subgroups at depths below one are functorial for all morphisms of tori. -/
theorem map_minimalCongruentShallowSubgroup_le
    {U : CommGroupScheme (Spec (CommRingCat.of K))} [IsAffine U.X.left]
    (hU : IsTorus U.toGrp) (f : T ⟶ U) (r : Set.Iio (1 : ℝ≥0)) :
    (minimalCongruentShallowSubgroup F T hT r).map
        (rationalPoints.map (CommGroupScheme.groupHom f)) ≤
      minimalCongruentShallowSubgroup F U hU r := by
  have h0 :
      ((connectedNeronModel F T hT).integralPoints).map
          (rationalPoints.map (CommGroupScheme.groupHom f)) ≤
        (connectedNeronModel F U hU).integralPoints := by
    rw [connectedNeronModel_integralPoints, connectedNeronModel_integralPoints]
    exact map_localTorusFiltration_le F T hT hU f 0
  by_cases hr : (r : ℝ≥0) = 0
  · simpa only [minimalCongruentShallowSubgroup, ite_eq_left hr] using h0
  · obtain ⟨φ⟩ := exists_hom_of_map_integralPoints_le
      IntegralModel.smoothHomExtension F (connectedNeronModel_isSmooth F T hT) rfl h0
    rw [minimalCongruentShallowSubgroup, minimalCongruentShallowSubgroup,
      ite_eq_right hr, ite_eq_right hr, Subgroup.map_sup]
    refine sup_le_sup ?_ (map_inducedTorusStandardImages_le F f r)
    rintro _ ⟨_, hg, rfl⟩
    obtain ⟨x, hx, rfl⟩ := hg
    exact ⟨rationalPoints.map φ.hom x, φ.map_mem_congruenceKernel hx,
      φ.integralPointMap_naturality x⟩

end Langlands.Geometry.Building
