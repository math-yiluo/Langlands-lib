import Langlands.Geometry.Building.KPLocalMoyPrasadGroupProperties
import Langlands.Geometry.Building.ChamberOrderedProductInjective
import Langlands.Geometry.Building.MoyPrasadOrderedEmbedding
import Langlands.Geometry.Building.MoyPrasadPositiveCollection
import Langlands.Geometry.Building.PositiveRootConeDepth

/-!
# Open-cell uniqueness for the groups `G(K)_{x,r}` over `K = F^ur`

Coordinates of the open cell `U⁻(μ)(K) × Z(K) × U⁺(μ)(K)` for the actual root groups,
coordinates of the positive root filtration spans, and the resulting positive-depth
centralizer intersection and separation of `G(K)_{x,r}` from an explicit product cover.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj NNReal
open Langlands.GroupScheme Langlands.LocalGalois.Separable

set_option backward.isDefEq.respectTransparency false

namespace Langlands.Geometry.Building.KPApartmentData

variable {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]
    {ω : kˣ → ℝ} (D : KPApartmentData i ω)

/-- Every complete ordering of the indivisible positive roots collects the constant-depth
blocks onto the subgroup generated by the positive root filtrations. This is
`range_orderedPositiveFiltrationBlockProduct_eq_iSup` with the covering of positive roots by
indivisible roots and their doubles taken from the algebraic rank-one factorization instead
of an affine-root-system premise. -/
theorem range_orderedPositiveFiltrationBlockProduct_eq_iSup_of_reductive
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (x : D.Apartment) (r : ℝ) (hr : 0 ≤ r) (ν : cocharacterLattice S)
    {n : ℕ} (a : Fin n → characterLattice S)
    (hrange : Set.range a = RelativeRoot.indivisiblePositiveRoots i ν) :
    Set.range (D.orderedFiltrationBlockProduct x (fun _ => r) a) =
      ((⨆ b : positiveRelativeRoots i ν, D.filtration x b r :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
  classical
  have : Smooth G.X.hom := hG.smooth
  have hS : IsSplitTorus S.toGrp := hi.1.1
  have hrank : RelativeRoot.HasRankOneFactorization i :=
    rootRankOneFactorization k G hG S i hi
  have hE : RelativeRoot.HasOppositeFactorPairs i :=
    fun a ha g hg hg1 => (hrank a ha g hg hg1).1.exists
  let c : Fin (n * 2) → characterLattice S := fun l =>
    if (finProdFinEquiv.symm l).2 = 0 then a (finProdFinEquiv.symm l).1
      else 2 • a (finProdFinEquiv.symm l).1
  let H : Fin (n * 2) → Subgroup (rationalPoints G) := fun l =>
    if c l ∈ relativeRoots i then D.filtration x (c l) r else ⊥
  have ha (j : Fin n) : a j ∈ RelativeRoot.indivisiblePositiveRoots i ν :=
    hrange ▸ Set.mem_range_self j
  have hc0 (j : Fin n) : c (finProdFinEquiv (j, 0)) = a j := by
    simp only [c, Equiv.symm_apply_apply, ↓reduceIte]
  have hc1 (j : Fin n) : c (finProdFinEquiv (j, 1)) = 2 • a j := by
    have h10 : (1 : Fin 2) ≠ 0 := by decide
    simp only [c, Equiv.symm_apply_apply, ite_eq_right h10]
  have hpos (l : Fin (n * 2)) (hl : c l ∈ relativeRoots i) :
      c l ∈ positiveRelativeRoots i ν := by
    refine ⟨hl, ?_⟩
    dsimp only [c]
    split_ifs
    · exact (ha _).2
    · have hp := (ha (finProdFinEquiv.symm l).1).2
      simp only [map_nsmul, LinearMap.smul_apply, nsmul_eq_mul]
      omega
  have hcover (b : positiveRelativeRoots i ν) : ∃ l, c l = b := by
    obtain ⟨d, hd, hb⟩ :=
      RelativeRoot.HasOppositeFactorPairs.exists_indivisiblePositiveRoot_eq_or_double
        i hS hE ν b.2
    obtain ⟨j, hj⟩ := (show d ∈ Set.range a by rw [hrange]; exact hd)
    rcases hb with hb | hb
    · exact ⟨finProdFinEquiv (j, 0), (hc0 j).trans (hj.trans hb.symm)⟩
    · exact ⟨finProdFinEquiv (j, 1),
        (hc1 j).trans ((congrArg (2 • ·) hj).trans hb.symm)⟩
  have hcollect :
      Set.range (RelativeRoot.CentralExtension.orderedProduct (fun l => (H l).subtype)) =
        ((⨆ l, H l : Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
    apply Langlands.GroupTheory.HeightCollection.range_orderedProduct_eq_iSup
      (w := fun l => (latticePairing S (c l) ν).toNat)
    intro j l
    by_cases hj : c j ∈ relativeRoots i
    · by_cases hl : c l ∈ relativeRoots i
      · have hjH : H j = D.filtration x (c j) r := ite_eq_left hj
        have hlH : H l = D.filtration x (c l) r := ite_eq_left hl
        rw [hjH, hlH]
        refine (D.filtration_commutator_positive_height x r hr ν (hpos j hj)
          (hpos l hl)).trans ?_
        refine iSup_le fun b => iSup_le fun hb => ?_
        obtain ⟨m, hm⟩ := hcover b
        have hroot : c m ∈ relativeRoots i := hm.symm ▸ b.2.1
        exact le_iSup_of_le m (le_iSup_of_le (hm.symm ▸ hb)
          (by dsimp only [H]; rw [ite_eq_left hroot, hm]))
      · simp only [H, ite_eq_right hl, Subgroup.commutator_bot_right, bot_le]
    · simp only [H, ite_eq_right hj, Subgroup.commutator_bot_left, bot_le]
  have h0 (j : Fin n) : H (finProdFinEquiv (j, 0)) = D.filtration x (a j) r := by
    simp only [H, hc0, ite_eq_left (ha j).1.1]
  have h1 (j : Fin n) : H (finProdFinEquiv (j, 1)) = D.doubleFiltration x (a j) r := by
    simp only [H, hc1, doubleFiltration]
  have hpairs := range_orderedSubgroupPairsProduct H
    (fun j => D.filtration x (a j) r) (fun j => D.doubleFiltration x (a j) r) h0 h1
  change Set.range (RelativeRoot.CentralExtension.orderedProduct (fun l => (H l).subtype)) =
    Set.range (D.orderedFiltrationBlockProduct x (fun _ => r) a) at hpairs
  rw [← hpairs, hcollect]
  apply congrArg (fun K : Subgroup (rationalPoints G) => (K : Set (rationalPoints G)))
  apply le_antisymm
  · refine iSup_le fun l => ?_
    dsimp only [H]
    split_ifs with hl
    · exact le_iSup (fun b : positiveRelativeRoots i ν =>
        D.filtration x b r) ⟨c l, hpos l hl⟩
    · exact bot_le
  · refine iSup_le fun b => ?_
    obtain ⟨l, hl⟩ := hcover b
    have hroot : c l ∈ relativeRoots i := hl.symm ▸ b.2.1
    exact le_iSup_of_le l (by dsimp only [H]; rw [ite_eq_left hroot, hl])

/-- An element lying in the subgroup generated by the positive root filtrations at every
positive constant depth is trivial. The coordinates of the ordered block product are
unique in the product of the actual root groups, so they do not depend on the depth, and
each block is separated. -/
theorem eq_one_of_forall_mem_iSup_positive_filtration
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (x : D.Apartment) (ν : cocharacterLattice S) {g : rationalPoints G}
    (hg : ∀ r : ℝ≥0, 0 < r →
      g ∈ (⨆ b : positiveRelativeRoots i ν, D.filtration x b r :
        Subgroup (rationalPoints G))) :
    g = 1 := by
  classical
  have : Smooth G.X.hom := hG.smooth
  have hS : IsSplitTorus S.toGrp := hi.1.1
  have hfin : (RelativeRoot.indivisiblePositiveRoots i ν).Finite :=
    (hS.finite_relativeRoots i).subset (fun _ hb => hb.1.1)
  obtain ⟨n, a, ha, hrange⟩ := hfin.fin_param
  have haroot (j : Fin n) : a j ∈ relativeRoots i := by
    have h : a j ∈ RelativeRoot.indivisiblePositiveRoots i ν := hrange ▸ Set.mem_range_self j
    exact h.1.1
  have hcoord (r : ℝ≥0) (hr : 0 < r) :
      ∃ t : ∀ j, D.filtrationBlock x (fun _ => (r : ℝ)) (a j),
        D.orderedFiltrationBlockProduct x (fun _ => (r : ℝ)) a t = g := by
    have h : g ∈ Set.range (D.orderedFiltrationBlockProduct x (fun _ => (r : ℝ)) a) := by
      rw [D.range_orderedPositiveFiltrationBlockProduct_eq_iSup_of_reductive hG hi x r
        r.coe_nonneg ν a hrange]
      exact hg r hr
    exact h
  choose t ht using hcoord
  have hinj := RelativeRoot.orderedRootSubgroupPoints_injective_of_statement
    RelativeRoot.dynamicRootOrderedProduct hG hi ν a ha hrange (Over.mk (𝟙 _))
  let lift (r : ℝ≥0) (hr : 0 < r) : ∀ j, rootGroupPoints i (a j) := fun j =>
    ⟨t r hr j, D.filtrationBlock_subset_rootGroupPoints x _ (a j) (t r hr j).property⟩
  have hsame (r : ℝ≥0) (hr : 0 < r) (j : Fin n) :
      (t r hr j : rationalPoints G) = t 1 one_pos j := by
    have hprod : lift r hr = lift 1 one_pos := by
      apply hinj
      change D.orderedFiltrationBlockProduct x _ a (t r hr) =
        D.orderedFiltrationBlockProduct x _ a (t 1 one_pos)
      rw [ht r hr, ht 1 one_pos]
    exact congrArg (fun z => (z j : rationalPoints G)) hprod
  have hone (j : Fin n) : (t 1 one_pos j : rationalPoints G) = 1 := by
    apply D.eq_one_of_forall_mem_filtrationBlock x (haroot j)
    intro r
    rcases (show (0 : ℝ≥0) ≤ r from zero_le).eq_or_lt with h0 | hr
    · rw [← h0]
      exact D.filtrationBlock_antitone x (a j) (by norm_num : ((0 : ℝ≥0) : ℝ) ≤ (1 : ℝ≥0))
        (t 1 one_pos j).property
    · rw [← hsame r hr j]
      exact (t r hr j).property
  rw [← ht 1 one_pos]
  change (List.ofFn fun j => (t 1 one_pos j : rationalPoints G)).prod = 1
  simp only [hone, List.ofFn_const, List.prod_replicate, one_pow]

end Langlands.Geometry.Building.KPApartmentData

namespace Langlands.Geometry.Building.MaximalUnramified.BuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))} [IsAffineHom H.X.hom]
  (B : BuildingData F H) (hZ : IsTorus B.centralizer.Z)

/-- `U_Ψ ⊆ U(μ)(K)` when every root of `Ψ` pairs positively with `μ`. -/
theorem rootGroupSpan_le_dynamicUnipotent (mu : cocharacterLattice B.S)
    {Ψ : Set (characterLattice B.S)} (hΨ : ∀ b ∈ Ψ, 0 < latticePairing B.S b mu) :
    B.rootGroupSpan Ψ ≤
      (Dynamic.unipotent (CommGroupScheme.groupHom mu ≫ B.i)).carrier (Over.mk (𝟙 _)) := by
  refine iSup₂_le fun b hb => ?_
  intro g hg
  exact RelativeRoot.subgroup_le_dynamicUnipotent B.i mu (hΨ b hb) (Over.mk (𝟙 _)) hg

/-- The filtration span lies in the root-group span. -/
theorem rootFiltrationSpan_le_rootGroupSpan (x : B.Apartment) (Ψ : Set (characterLattice B.S))
    (r : ℝ) : B.rootFiltrationSpan x Ψ r ≤ B.rootGroupSpan Ψ :=
  iSup₂_mono fun b _ => B.filtration_le_rootGroup x b r

/-- The filtration span is antitone in the depth. -/
theorem rootFiltrationSpan_antitone (x : B.Apartment) (Ψ : Set (characterLattice B.S)) :
    Antitone (B.rootFiltrationSpan x Ψ) :=
  fun _ _ h => iSup₂_mono fun b _ => B.apartment.filtration_antitone x b h

theorem rootFiltrationSpan_eq_iSup_subtype (x : B.Apartment) (Ψ : Set (characterLattice B.S))
    (r : ℝ) : B.rootFiltrationSpan x Ψ r = ⨆ b : Ψ, B.filtration x b r := by
  rw [rootFiltrationSpan, iSup_subtype']

/-- The inclusion `j : Z → G` is injective on `K`-points. -/
theorem centralizer_map_injective :
    Function.Injective (rationalPoints.map B.centralizer.j) := by
  intro z w hzw
  have : Mono B.centralizer.j.hom.hom := B.centralizer.isRepresentedBy.1
  exact (cancel_mono B.centralizer.j.hom.hom).mp hzw

/-- **Uniqueness in the open cell.** For any cocharacter `μ`, a product `u · j(z) · v` with
`u ∈ U_{Φ⁺(-μ)}`, `z ∈ Z(K)` and `v ∈ U_{Φ⁺(μ)}` determines its three factors. -/
theorem eq_of_mul_eq_mul (mu : cocharacterLattice B.S)
    {u u' : rationalPoints H} (hu : u ∈ B.rootGroupSpan (positiveRelativeRoots B.i (-mu)))
    (hu' : u' ∈ B.rootGroupSpan (positiveRelativeRoots B.i (-mu)))
    {z z' : rationalPoints B.centralizer.Z}
    {v v' : rationalPoints H} (hv : v ∈ B.rootGroupSpan (positiveRelativeRoots B.i mu))
    (hv' : v' ∈ B.rootGroupSpan (positiveRelativeRoots B.i mu))
    (h : u * rationalPoints.map B.centralizer.j z * v =
      u' * rationalPoints.map B.centralizer.j z' * v') :
    u = u' ∧ z = z' ∧ v = v' := by
  have hinj := unipotentTripleProduct_injective B.i mu
    (B.rootGroupSpan (positiveRelativeRoots B.i (-mu)))
    (B.rootGroupSpan (positiveRelativeRoots B.i mu))
    (rationalPoints.map B.centralizer.j) B.centralizer_map_injective
    (B.rootGroupSpan_le_dynamicUnipotent (-mu) fun _ hb => hb.2)
    (B.rootGroupSpan_le_dynamicUnipotent mu fun _ hb => hb.2)
    (fun z => map_mem_centralizerPoints B.centralizer.isRepresentedBy z)
  have heq := @hinj (⟨u, hu⟩, z, ⟨v, hv⟩) (⟨u', hu'⟩, z', ⟨v', hv'⟩) h
  simp only [Prod.mk.injEq, Subtype.mk.injEq] at heq
  exact heq

/-- An element of `U_{Φ⁺(μ)}` lying in `U_{Φ⁺(μ), x, r}` for every `r > 0` is trivial. -/
theorem eq_one_of_forall_mem_rootFiltrationSpan (x : B.Apartment)
    (mu : cocharacterLattice B.S) {g : rationalPoints H}
    (hg : ∀ r : ℝ≥0, 0 < r → g ∈ B.rootFiltrationSpan x (positiveRelativeRoots B.i mu) r) :
    g = 1 :=
  B.apartment.eq_one_of_forall_mem_iSup_positive_filtration B.isConnectedReductive
    B.isMaximalSplitTorus x mu fun r hr => by
      rw [← rootFiltrationSpan_eq_iSup_subtype]
      exact hg r hr

/-- **Clause 7 at a positive depth, from a product cover.** If every element of
`G(K)_{x,r}` is a product `u · j(z) · v` with `u ∈ U_{Φ⁺(-μ),x,r}`, `z ∈ Z(K)_r` and
`v ∈ U_{Φ⁺(μ),x,r}`, then `j⁻¹(G(K)_{x,r}) = Z(K)_r`. -/
theorem comap_moyPrasad_eq_of_cover (x : B.Apartment) (r : ℝ≥0)
    (mu : cocharacterLattice B.S)
    (hcover : ∀ g ∈ B.moyPrasad hZ x r,
      ∃ u ∈ B.rootFiltrationSpan x (positiveRelativeRoots B.i (-mu)) r,
        ∃ z ∈ B.centralizerTorusFiltration hZ r,
          ∃ v ∈ B.rootFiltrationSpan x (positiveRelativeRoots B.i mu) r,
            g = u * rationalPoints.map B.centralizer.j z * v) :
    (B.moyPrasad hZ x r).comap (rationalPoints.map B.centralizer.j) =
      B.centralizerTorusFiltration hZ r := by
  apply le_antisymm
  · intro z hz
    obtain ⟨u, hu, z', hz', v, hv, huv⟩ := hcover _ hz
    have h := B.eq_of_mul_eq_mul mu
      (B.rootFiltrationSpan_le_rootGroupSpan x _ r hu) (Subgroup.one_mem _)
      (B.rootFiltrationSpan_le_rootGroupSpan x _ r hv) (Subgroup.one_mem _)
      (z := z') (z' := z) (by rw [← huv, one_mul, mul_one])
    rw [← h.2.1]
    exact hz'
  · intro z hz
    exact B.map_mem_moyPrasad hZ x hz

/-- **Clause 8, from product covers.** If for one cocharacter `μ` every `G(K)_{x,r}` with
`r > 0` is covered by `U_{Φ⁺(-μ),x,r} · j(Z(K)_r) · U_{Φ⁺(μ),x,r}`, then
`⋂_r G(K)_{x,r} = {1}`. -/
theorem iInf_moyPrasad_eq_bot_of_cover (x : B.Apartment) (mu : cocharacterLattice B.S)
    (hcover : ∀ r : ℝ≥0, 0 < r → ∀ g ∈ B.moyPrasad hZ x r,
      ∃ u ∈ B.rootFiltrationSpan x (positiveRelativeRoots B.i (-mu)) r,
        ∃ z ∈ B.centralizerTorusFiltration hZ r,
          ∃ v ∈ B.rootFiltrationSpan x (positiveRelativeRoots B.i mu) r,
            g = u * rationalPoints.map B.centralizer.j z * v) :
    ⨅ r : ℝ≥0, B.moyPrasad hZ x r = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  rw [Subgroup.mem_iInf] at hg
  rw [Subgroup.mem_bot]
  choose u hu z hz v hv huv using fun (r : ℝ≥0) (hr : 0 < r) => hcover r hr g (hg r)
  have hsame (r : ℝ≥0) (hr : 0 < r) :
      u r hr = u 1 one_pos ∧ z r hr = z 1 one_pos ∧ v r hr = v 1 one_pos :=
    B.eq_of_mul_eq_mul mu
      (B.rootFiltrationSpan_le_rootGroupSpan x _ r (hu r hr))
      (B.rootFiltrationSpan_le_rootGroupSpan x _ 1 (hu 1 one_pos))
      (B.rootFiltrationSpan_le_rootGroupSpan x _ r (hv r hr))
      (B.rootFiltrationSpan_le_rootGroupSpan x _ 1 (hv 1 one_pos))
      ((huv r hr).symm.trans (huv 1 one_pos))
  have hu1 : u 1 one_pos = 1 := by
    apply B.eq_one_of_forall_mem_rootFiltrationSpan x (-mu)
    intro r hr
    rw [← (hsame r hr).1]
    exact hu r hr
  have hv1 : v 1 one_pos = 1 := by
    apply B.eq_one_of_forall_mem_rootFiltrationSpan x mu
    intro r hr
    rw [← (hsame r hr).2.2]
    exact hv r hr
  have hz1 : z 1 one_pos = 1 := by
    have hbot := B.iInf_centralizerTorusFiltration_eq_bot hZ
    have hmem : z 1 one_pos ∈ ⨅ r : ℝ≥0, B.centralizerTorusFiltration hZ r := by
      rw [Subgroup.mem_iInf]
      intro r
      rcases (show (0 : ℝ≥0) ≤ r from zero_le).eq_or_lt with h0 | hr
      · rw [← h0]
        exact B.centralizerTorusFiltration_antitone hZ (show (0 : ℝ≥0) ≤ 1 from zero_le) (hz 1 one_pos)
      · rw [← (hsame r hr).2.1]
        exact hz r hr
    rw [hbot] at hmem
    exact hmem
  rw [huv 1 one_pos, hu1, hv1, hz1, map_one, one_mul, mul_one]

end Langlands.Geometry.Building.MaximalUnramified.BuildingData
