import Langlands.Geometry.Building.KPLocalMoyPrasadGroupProperties
import Langlands.GroupScheme.Rational.StandardParabolic

/-!
# Depth-zero intersections of `G(K)_{x,0}` over the maximal unramified field

Two intersection properties of the actual depth-zero group `G(K)_{x,0} = B.moyPrasad hZ x 0`
of quasi-split building data over `K = F^ur`:

* (a) the positive unipotent intersection `U⁺(K) ∩ G(K)_{x,0} = U⁺_{x,0}` for the positive
  system of a generic integral cocharacter (KP Proposition 7.3.12(1)–(3) at `f = 0`, for the
  full group `G(K)_{x,0} = G(K)♯_{x,0} · Z(K)_0`);
* (b) the Levi intersection `M_ν(K) ∩ G(K)_{x,0} ⊆ M_ν(K)_{π(x),0}` (the inclusion of KP
  Lemma 8.5.19 at `f = 0`).

This module states them; it does not prove them.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj NNReal
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building.MaximalUnramified

/-- The depth-zero intersections of the actual group `G(K)_{x,0}` over `K = F^ur`:
(a) for every generic integral cocharacter `mu`, the intersection of `G(K)_{x,0}` with the
subgroup generated by the root groups of the positive roots of `mu` is generated by their
depth-zero filtration subgroups (KP Proposition 7.3.12(1)–(3) at `f = 0`); (b) for every `ν`,
the intersection of `G(K)_{x,0}` with `M_ν(K)` lies in the subgroup generated by `j(Z(K)_0)`
and the depth-zero filtration subgroups of the roots `b` with `⟨b, ν⟩ = 0` (KP Lemma 8.5.19
at `f = 0`). -/
def LocalMoyPrasadDepthZeroStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))) [IsAffineHom H.X.hom]
    (B : BuildingData F H) (hZ : IsTorus B.centralizer.Z),
    (∀ (x : B.Apartment) (mu : cocharacterLattice B.S), IsGenericCocharacter B.i mu →
      B.rootGroupSpan (positiveRelativeRoots B.i mu) ⊓ B.moyPrasad hZ x 0 =
        B.rootFiltrationSpan x (positiveRelativeRoots B.i mu) 0) ∧
    ∀ (x : B.Apartment) (ν : V B.S),
      B.pairingLeviSpan ν ⊓ B.moyPrasad hZ x 0 ≤
        B.centralizerTorusImage hZ 0 ⊔ B.rootFiltrationSpan x (B.zeroPairingRoots ν) 0

end Langlands.Geometry.Building.MaximalUnramified
