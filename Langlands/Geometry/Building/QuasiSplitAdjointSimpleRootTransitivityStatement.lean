import Langlands.Geometry.Building.KPApartment
import Langlands.GroupScheme.Reductive.QuasiSplit
import Langlands.GroupScheme.Reductive.Semisimple
import Langlands.GroupScheme.Rational.SplitTorus
import Langlands.GroupScheme.Rational.TorusCentralizer

/-!
# Simple-root transitivity of `Z(k)` in quasi-split adjoint groups

For a quasi-split adjoint group `G` over a field `k`, with maximal split torus `S` and
centralizer `Z = Z_G(S)`, there is a family `Δ` of relative roots that generates every
relative root, such that for each `a ∈ Δ` the points of `Z(k)` that centralize the other
root groups `U_b(k)`, `b ∈ Δ ∖ {a}`, act transitively on the nontrivial elements of
`U_a(k)/U_{2a}(k)`. This is the group-theoretic content behind Kaletha–Prasad Lemma 6.4.10
and the translation part of their Proposition 6.6.2.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.GroupScheme
open scoped CategoryTheory.MonObj

namespace Langlands.Geometry.Building

/-- **Simple-root transitivity of the centralizer in a quasi-split adjoint group.** For every
field `k`, every quasi-split adjoint `G` over `k`, every maximal split torus `i : S → G` and
every `j : Z → G` representing the centralizer of `S`, there is a finite family `Δ` of
relative roots such that every relative root lies in the additive subgroup generated by `Δ`,
and such that for each `a ∈ Δ` and all `u, u' ∈ U_a(k) ∖ U_{2a}(k)` some `z ∈ Z(k)`
commutes with every point of `U_b(k)` for every `b ∈ Δ`, `b ≠ a`, and satisfies
`z u z⁻¹ = u' w` with `w ∈ U_{2a}(k)` (`U_{2a}(k) = {1}` if `2a` is not a root). -/
def QuasiSplitAdjointSimpleRootTransitivityStatement : Prop :=
  ∀ (k : Type u) [Field k] (G : GroupScheme (Spec (CommRingCat.of k))) [IsAffineHom G.X.hom],
    IsQuasiSplit G → IsAdjoint G →
    ∀ (S : CommGroupScheme (Spec (CommRingCat.of k))) (i : S.toGrp ⟶ G),
      IsMaximalSplitTorus i →
      ∀ (Z : GroupScheme (Spec (CommRingCat.of k))) (j : Z ⟶ G),
        (torusCentralizer i).IsRepresentedBy j →
        ∃ Δ : Finset (characterLattice S),
          (∀ a ∈ Δ, a ∈ relativeRoots i) ∧
          (∀ b ∈ relativeRoots i, b ∈ AddSubgroup.closure (Δ : Set (characterLattice S))) ∧
          ∀ a ∈ Δ, ∀ u ∈ rootGroupPoints i a, ∀ u' ∈ rootGroupPoints i a,
            u ∉ doubleRootGroupPoints i a → u' ∉ doubleRootGroupPoints i a →
            ∃ z : rationalPoints Z,
              (∀ b ∈ Δ, b ≠ a → ∀ g ∈ rootGroupPoints i b,
                Commute (rationalPoints.map j z) g) ∧
              ∃ w ∈ doubleRootGroupPoints i a,
                rationalPoints.map j z * u * (rationalPoints.map j z)⁻¹ = u' * w

end Langlands.Geometry.Building
