import Langlands.Geometry.Building.RootDepthCollectionData

/-! # Descent using actual depth-collection data -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.GaloisPointComparison

namespace Langlands.Geometry.Building

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace RootDepthCollectionData

variable {k : Type u} [Field k]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : S.toGrp ⟶ G} [IsAffineHom G.X.hom]
  {φ : RootFunctionFamily S G} (D : RootDepthCollectionData i φ)

/-- Every retained ray factor lies in its actual primitive root group,
including when only its double was selected. -/
theorem rayDepthSubgroup_le_rootGroupPoints
    (Ψ : Set (characterLattice S)) (f : characterLattice S → ℝ)
    (a : characterLattice S) :
    D.rayDepthSubgroup Ψ f a ≤ rootGroupPoints i a := by
  classical
  unfold rayDepthSubgroup
  split_ifs with ha h2a
  · exact D.le_rootGroupPoints a (f a)
  · exact (D.le_rootGroupPoints (2 • a) (f (2 • a))).trans
      (RelativeRoot.double_subgroup_le i a (Over.mk (𝟙 _)))
  · exact bot_le

end RootDepthCollectionData

variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom] [Smooth G.X.hom]
  (i : S.toGrp ⟶ G) [Mono i.hom.hom.left]

local notation "b" => algebraBaseMap k K
local notation "S_K" => CategoryTheory.Functor.obj (CommGroupScheme.baseChange b) S
local notation "G_K" => baseChanged k K G
local notation "i_K" => CategoryTheory.Functor.map (GroupScheme.baseChange b) i
local notation "a_K" a => characterLattice.baseChange b S a

private instance extendedAffine : IsAffineHom (G_K).X.hom := by
  change IsAffineHom (CategoryTheory.Limits.pullback.snd G.X.hom b)
  infer_instance

omit [Smooth G.X.hom] in
private theorem rationalExtend_injective :
    Function.Injective (rationalExtend k K G) := by
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  intro x y h
  apply (rationalCoeffEquiv k G).injective
  apply GaloisPoint.extend_injective k K G
  simpa only [baseChangeCoeffEquiv_rationalExtend] using
    congrArg (baseChangeCoeffEquiv k K G) h

namespace RootDepthCollectionData

/-- The actual preimage of an upstairs retained ray subgroup. It keeps
the primitive, doubled-only and identity branches and their original depths. -/
def fieldRestrictedRayDepthSubgroup
    {ψ : RootFunctionFamily (k := K) S_K G_K}
    (D : RootDepthCollectionData (k := K) (S := S_K) (G := G_K) i_K ψ)
    (Ψ : Set (characterLattice S_K)) (f : characterLattice S_K → ℝ)
    (a : characterLattice S) : Subgroup (rationalPoints G) :=
  (D.rayDepthSubgroup Ψ f (a_K a)).comap (rationalExtend k K G)

/-- Ordered retained-ray factors descend along the actual field extension.
No positivity or complete root-datum valuation is used in factor descent. -/
theorem mem_orderedRayDepthProduct_fieldExtend_iff
    {ψ : RootFunctionFamily (k := K) S_K G_K}
    (D : RootDepthCollectionData (k := K) (S := S_K) (G := G_K) i_K ψ)
    (hS : IsSplitTorus S.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i)
    (ν : cocharacterLattice S) {n : ℕ} (a : Fin n → characterLattice S)
    (hinj : Function.Injective a)
    (ha : Set.range a = RelativeRoot.indivisiblePositiveRoots i ν)
    (Ψ : Set (characterLattice S_K)) (f : characterLattice S_K → ℝ)
    (g : rationalPoints G) :
    rationalExtend k K G g ∈ D.orderedRayDepthProduct Ψ f (fun j => a_K (a j)) ↔
      g ∈ Set.range (RelativeRoot.CentralExtension.orderedProduct
        (fun j => (D.fieldRestrictedRayDepthSubgroup (k := k) (K := K) i Ψ f (a j)).subtype)) := by
  constructor
  · rintro ⟨y, hy⟩
    let y' : ∀ j, rootGroupPoints (S := S_K) i_K (a_K (a j)) := fun j =>
      ⟨(y j).val, D.rayDepthSubgroup_le_rootGroupPoints Ψ f _ (y j).property⟩
    obtain ⟨x, hxf, hx⟩ := orderedRootFactors_fieldDescend i hS hE ν a hinj ha g y' hy
    let x' : ∀ j, D.fieldRestrictedRayDepthSubgroup (k := k) (K := K) i Ψ f (a j) := fun j =>
      ⟨(x j).val, by
        change rationalExtend k K G (x j) ∈ D.rayDepthSubgroup Ψ f (a_K (a j))
        rw [hxf j]
        exact (y j).property⟩
    exact ⟨x', hx⟩
  · rintro ⟨x, hx⟩
    let y : ∀ j, D.rayDepthSubgroup Ψ f (a_K (a j)) := fun j =>
      ⟨rationalExtend k K G (x j), (x j).property⟩
    refine ⟨y, ?_⟩
    simpa only [RelativeRoot.CentralExtension.orderedProduct, map_list_prod,
      List.map_ofFn, Function.comp_def, Subgroup.subtype_apply, y] using
      congrArg (rationalExtend k K G) hx

omit [Mono i.hom.hom.left] in
/-- Every original preimage ray factor lies in the subgroup generated by the
literal restricted filtration sets. No downstairs subgroup axiom is assumed. -/
theorem fieldRestrictedRayDepthSubgroup_le_generated
    {ψ : RootFunctionFamily (k := K) S_K G_K}
    (D : RootDepthCollectionData (k := K) (S := S_K) (G := G_K) i_K ψ)
    (hS : IsSplitTorus S.toGrp)
    (Ψ : Set (characterLattice S_K)) (f : characterLattice S_K → ℝ)
    (hroots : Ψ ⊆ relativeRoots (T := S_K) i_K)
    (a : characterLattice S) :
    D.fieldRestrictedRayDepthSubgroup (k := k) (K := K) i Ψ f a ≤
      Subgroup.closure (⋃ c : (characterLattice.baseChange b S) ⁻¹' Ψ,
        rootFiltration i (RootFunctionFamily.fieldRestrict (k := k) (K := K) (S := S) (G := G) ψ)
          c ((f ∘ characterLattice.baseChange b S) c)) := by
  classical
  intro g hg
  change rationalExtend k K G g ∈ D.rayDepthSubgroup Ψ f (a_K a) at hg
  have hne (c : characterLattice S) (hc : (a_K c) ∈ Ψ) : c ≠ 0 := by
    intro h
    apply (hroots hc).1
    rw [h, map_zero]
  simp only [rayDepthSubgroup, ← map_nsmul] at hg
  split_ifs at hg with ha h2a
  · change rationalExtend k K G g ∈
      (D.subgroup (a_K a) (f (a_K a)) : Set (rationalPoints G_K)) at hg
    rw [D.coe_subgroup] at hg
    apply Subgroup.subset_closure
    refine Set.mem_iUnion.mpr ⟨⟨a, ha⟩, ?_⟩
    exact (Set.ext_iff.mp
      (rootFiltration_fieldRestrict i hS ψ a (hne a ha) (f (a_K a))) g).mpr hg
  · change rationalExtend k K G g ∈
      (D.subgroup (a_K (2 • a)) (f (a_K (2 • a))) : Set (rationalPoints G_K)) at hg
    rw [D.coe_subgroup] at hg
    apply Subgroup.subset_closure
    refine Set.mem_iUnion.mpr ⟨⟨2 • a, h2a⟩, ?_⟩
    exact (Set.ext_iff.mp
      (rootFiltration_fieldRestrict i hS ψ (2 • a) (hne _ h2a)
        (f (a_K (2 • a)))) g).mpr hg
  · have hg1 : g = 1 := by
      apply rationalExtend_injective (K := K) (G := G)
      simpa only [Subgroup.mem_bot, map_one] using hg
    subst g
    exact Subgroup.one_mem _

/-- Collection upstairs suffices to reflect the actual generated subgroup.
All bounds are arbitrary reals; no full valuation upstairs or downstairs is
required beyond the displayed collection data. -/
theorem mem_generated_fieldExtend_iff
    {ψ : RootFunctionFamily (k := K) S_K G_K}
    (D : RootDepthCollectionData (k := K) (S := S_K) (G := G_K) i_K ψ)
    (hS : IsSplitTorus S.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i)
    (ν : cocharacterLattice S) {n : ℕ} (a : Fin n → characterLattice S)
    (hinj : Function.Injective a)
    (ha : Set.range a = RelativeRoot.indivisiblePositiveRoots i ν)
    {Ψ : Set (characterLattice S_K)} {f : characterLattice S_K → ℝ}
    (hdata : IsClosedPositiveRootDepth (S := S_K) i_K
      (cocharacterLattice.baseChange b S ν) Ψ f)
    (hdouble : ∀ c ∈ Ψ, 2 • c ∈ Ψ → 2 * f c ≤ f (2 • c))
    (hcover : ∀ c ∈ Ψ, ∃ j, c = (a_K (a j)) ∨ c = 2 • (a_K (a j)))
    (g : rationalPoints G) :
    rationalExtend k K G g ∈
        Subgroup.closure (⋃ c : Ψ, rootFiltration (S := S_K) i_K ψ c (f c)) ↔
      g ∈ Subgroup.closure (⋃ c : (characterLattice.baseChange b S) ⁻¹' Ψ,
        rootFiltration i (RootFunctionFamily.fieldRestrict (k := k) (K := K) (S := S) (G := G) ψ)
          c ((f ∘ characterLattice.baseChange b S) c)) := by
  constructor
  · intro hg
    have hprod : rationalExtend k K G g ∈
        D.orderedRayDepthProduct Ψ f (fun j => a_K (a j)) := by
      rw [D.orderedRayDepthProduct_eq_closure hdata hdouble _ hcover]
      exact hg
    obtain ⟨x, hx⟩ :=
      (D.mem_orderedRayDepthProduct_fieldExtend_iff (k := k) (K := K) i hS hE ν a hinj ha Ψ f g).mp hprod
    rw [← hx]
    apply Subgroup.list_prod_mem
    intro z hz
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hz
    exact D.fieldRestrictedRayDepthSubgroup_le_generated (k := k) (K := K) i hS Ψ f
      (fun _ hc => (hdata.positive hc).1) (a j) (x j).property
  · intro hg
    have hle :
        Subgroup.closure (⋃ c : (characterLattice.baseChange b S) ⁻¹' Ψ,
          rootFiltration i (RootFunctionFamily.fieldRestrict (k := k) (K := K) (S := S) (G := G) ψ)
            c ((f ∘ characterLattice.baseChange b S) c)) ≤
        (Subgroup.closure (⋃ c : Ψ, rootFiltration (S := S_K) i_K ψ c (f c))).comap
          (rationalExtend k K G) := by
      apply (Subgroup.closure_le _).mpr
      intro z hz
      obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hz
      apply Subgroup.subset_closure
      refine Set.mem_iUnion.mpr ⟨⟨a_K c, c.property⟩, ?_⟩
      exact ⟨rationalExtend_mem_rootGroupPoints (K := K) i c hc.1, hc.2⟩
    exact hle hg

end RootDepthCollectionData

end Langlands.Geometry.Building
