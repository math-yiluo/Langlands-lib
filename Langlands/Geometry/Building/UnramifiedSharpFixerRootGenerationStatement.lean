import Langlands.Geometry.Building.MaximalUnramifiedBuildingData

/-! # Sharp-fixer generation by affine roots over the maximal unramified field -/

noncomputable section

universe u

open AlgebraicGeometry
open Langlands.GroupScheme Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

/-- KP Lemma 7.4.4(3) over `K = inertiaFixedField F`: for every supplied building
datum of an affine `K`-group and every nonempty apartment subset `Ω`, the sharp
fixer is generated by the actual affine root groups for `ψ ∈ Ψ` nonnegative on
`Ω`. The supremum ranges over all relative roots, including multipliable roots
and their doubles. -/
def UnramifiedSharpFixerRootGenerationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (H : GroupScheme (Spec (CommRingCat.of (inertiaFixedField F))))
    [IsAffineHom H.X.hom]
    (C : MaximalUnramified.BuildingData F H) (Ω : Set C.Apartment),
    Ω.Nonempty →
      C.sharpFixer Ω =
        ⨆ (a : relativeRoots C.i) (ψ : C.Apartment →ᵃ[ℝ] ℝ)
          (_ : ψ ∈ C.affineRoots) (_ : ψ.linear = rootForm C.i a)
          (_ : ∀ x ∈ Ω, 0 ≤ ψ x), C.affineRootGroup a ψ

end Langlands.Geometry.Building
