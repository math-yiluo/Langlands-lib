import Langlands.Geometry.Building.RootReflectionAction

/-! # The affine Weyl image of the actual root-reflection representatives -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

namespace AffineRootSystem

private theorem isCoroot_two_smul
    {V A : Type*} [AddCommGroup V] [Module ℝ V] [AddTorsor V A]
    {Ψ : Set (A →ᵃ[ℝ] ℝ)} {ψ : A →ᵃ[ℝ] ℝ} {v : V}
    (hv : IsCoroot Ψ ψ v) :
    IsCoroot Ψ ((2 : ℝ) • ψ) ((2 : ℝ)⁻¹ • v) := by
  refine ⟨?_, fun f hf => ?_⟩
  · change (2 : ℝ) * ψ.linear ((2 : ℝ)⁻¹ • v) = 2
    rw [map_smul, smul_eq_mul, hv.1]
    norm_num
  · have heq :
        f.linear ((2 : ℝ)⁻¹ • v) • ((2 : ℝ) • ψ) = f.linear v • ψ := by
      rw [map_smul, smul_smul]
      congr 1
      simp only [smul_eq_mul]
      ring
    rw [heq]
    exact hv.2 f hf

private theorem affineReflection_two_smul
    {V A : Type*} [AddCommGroup V] [Module ℝ V] [AddTorsor V A]
    {Ψ : Set (A →ᵃ[ℝ] ℝ)} {ψ : A →ᵃ[ℝ] ℝ} {v : V}
    (hv : IsCoroot Ψ ψ v) :
    affineReflection ((2 : ℝ) • ψ) (isCoroot_two_smul hv).1 =
      affineReflection ψ hv.1 := by
  apply AffineEquiv.ext
  intro x
  simp only [affineReflection_apply, smul_smul]
  congr 1
  change (-(2 * ψ x) * (2 : ℝ)⁻¹) • v = (-ψ x) • v
  congr 1
  ring

end AffineRootSystem

namespace ValuationBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (B : ValuationBuildingData G)

/-- The actual subgroup of `N(F)` generated by the products from all supplied
nonidentity root-point opposite pairs. -/
def reflectionNormalizer : Subgroup (normalizerPoints B.i) :=
  Subgroup.closure {n | ∃ (α : relativeRoots B.i) (g : rationalPoints G),
    g ∈ B.rootGroup α ∧ g ≠ 1 ∧
      ∃ (p : rationalPoints G × rationalPoints G)
        (hp : RelativeRoot.IsOppositeFactorPair B.i (α : characterLattice B.S) g p),
        n = B.reflectionElement hp}

variable {α : relativeRoots B.i} {g : rationalPoints G}
    {p : rationalPoints G × rationalPoints G}

/-- Every supplied root-reflection representative is a generator. -/
theorem reflectionElement_mem_reflectionNormalizer
    (hg : g ∈ B.rootGroup α) (hg1 : g ≠ 1)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (α : characterLattice B.S) g p) :
    B.reflectionElement hp ∈ B.reflectionNormalizer :=
  Subgroup.subset_closure ⟨α, g, hg, hg1, p, hp, rfl⟩

/-- AS 4 places the action of every supplied actual pair in the affine Weyl group,
including when its root functional must first be doubled. -/
theorem normalizerAffineEquiv_reflectionElement_mem_affineWeylGroup
    (hA : B.SatisfiesApartmentAxioms) (hR : B.HasRootReflections)
    (hg : g ∈ B.rootGroup α) (hg1 : g ≠ 1)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (α : characterLattice B.S) g p) :
    B.apartment.normalizerAffineEquiv (B.reflectionElement hp) ∈
      AffineRootSystem.affineWeylGroup B.affineRoots := by
  have hψ : B.reflectionFunctional α g ∈ B.apartment.extendedAffineRoots := by
    rw [← B.reflectionAffineRoots_eq]
    exact ⟨α, g, hg, hg1, rfl⟩
  have hv := B.isCoroot_reflectionCoroot_of_hasRootReflections hA hR hg hg1 hp
  rw [B.normalizerAffineEquiv_reflectionElement_of_hasRootReflections hR hg hg1 hp]
  rcases hA.mem_or_two_smul_mem _ hψ with hm | hm
  · exact AffineRootSystem.affineReflection_mem_affineWeylGroup hm hv
  · rw [← AffineRootSystem.affineReflection_two_smul hv]
    exact AffineRootSystem.affineReflection_mem_affineWeylGroup hm
      (AffineRootSystem.isCoroot_two_smul hv)

/-- The action of the subgroup generated by actual root-reflection representatives
is contained in the affine Weyl group. -/
theorem reflectionNormalizer_map_le_affineWeylGroup
    (hA : B.SatisfiesApartmentAxioms) (hR : B.HasRootReflections) :
    B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv ≤
      AffineRootSystem.affineWeylGroup B.affineRoots := by
  rw [Subgroup.map_le_iff_le_comap]
  refine (Subgroup.closure_le _).2 ?_
  rintro n ⟨a, u, hu, hu1, q, hq, rfl⟩
  exact B.normalizerAffineEquiv_reflectionElement_mem_affineWeylGroup hA hR hu hu1 hq

/-- If every nonidentity root point has an opposite pair, the actual generated
normalizer subgroup realizes every affine Weyl reflection. -/
theorem affineWeylGroup_le_reflectionNormalizer_map
    (hA : B.SatisfiesApartmentAxioms) (hR : B.HasRootReflections)
    (hF : RelativeRoot.HasRankOneFactorization B.i) :
    AffineRootSystem.affineWeylGroup B.affineRoots ≤
      B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv := by
  refine (Subgroup.closure_le _).2 ?_
  rintro e ⟨ψ, hψ, v, hv, rfl⟩
  have hψ' := B.apartment.affineRoots_subset_extendedAffineRoots hψ
  rw [← B.reflectionAffineRoots_eq] at hψ'
  obtain ⟨a, u, hu, hu1, rfl⟩ := hψ'
  obtain ⟨q, hq⟩ := (hF a a.property u hu hu1).1.exists
  refine ⟨B.reflectionElement hq,
    B.reflectionElement_mem_reflectionNormalizer hu hu1 hq, ?_⟩
  exact B.normalizerAffineEquiv_reflectionElement_eq_of_isCoroot_of_hasRootReflections
    hA hR hu hu1 hq hv

/-- Under the explicit fixed-hyperplane and rank-one factorization hypotheses,
the actual generated normalizer subgroup has precisely the affine Weyl image. -/
theorem reflectionNormalizer_map_eq_affineWeylGroup
    (hA : B.SatisfiesApartmentAxioms) (hR : B.HasRootReflections)
    (hF : RelativeRoot.HasRankOneFactorization B.i) :
    B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv =
      AffineRootSystem.affineWeylGroup B.affineRoots :=
  le_antisymm (B.reflectionNormalizer_map_le_affineWeylGroup hA hR)
    (B.affineWeylGroup_le_reflectionNormalizer_map hA hR hF)

end ValuationBuildingData

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G)

/-- The generated actual normalizer representatives all belong to the supplied
simply connected image. This containment does not require AS 1 or pair existence. -/
theorem reflectionNormalizer_le_simplyConnectedImage
    (hA : P.SatisfiesApartmentAxioms) :
    P.reflectionNormalizer ≤
      P.simplyConnectedImage.comap (normalizerPoints P.i).subtype := by
  refine (Subgroup.closure_le _).2 ?_
  rintro n ⟨a, u, hu, hu1, q, hq, rfl⟩
  exact P.reflectionElement_mem_simplyConnectedImage hA hu hu1 hq

/-- Conditional reverse containment for the affine image of the actual normalizer
intersection with the supplied simply connected image. -/
theorem affineWeylGroup_le_simplyConnectedNormalizer_map
    (hA : P.SatisfiesApartmentAxioms) (hR : P.HasRootReflections)
    (hF : RelativeRoot.HasRankOneFactorization P.i) :
    AffineRootSystem.affineWeylGroup P.affineRoots ≤
      (P.simplyConnectedImage.comap (normalizerPoints P.i).subtype).map
        P.apartment.normalizerAffineEquiv :=
  (P.affineWeylGroup_le_reflectionNormalizer_map hA hR hF).trans
    (Subgroup.map_mono (P.reflectionNormalizer_le_simplyConnectedImage hA))

end ParahoricBuildingData

end Langlands.Geometry.Building
