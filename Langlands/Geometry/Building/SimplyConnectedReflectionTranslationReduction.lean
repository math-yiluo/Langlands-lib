import Langlands.Geometry.Building.RankOneReflectionGeneration
import Langlands.Geometry.Building.SimplyConnectedReflectionTranslationStatement
import Langlands.GroupScheme.SimplyConnected.RankOneCentralizerGenerationStatement
import Langlands.GroupScheme.Rational.RootRankOneFactorizationStatement
import Langlands.GroupScheme.Rational.RootFactorizationFromExistence

/-! # Reflection translations of simply connected groups from rank-one generation -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.Plancherel

namespace Langlands.Geometry.Building

namespace ValuationBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (B : ValuationBuildingData G)

/-- The subgroup of `G(F)` generated by the centralizer points of the rank-one
subgroups `⟨U_a(F), U_{-a}(F)⟩`, for the actual relative roots `a`. -/
def rankOneCentralizerSubgroup : Subgroup (rationalPoints G) :=
  Subgroup.closure (⋃ a ∈ relativeRoots B.i,
    ((centralizerPoints B.i ⊓ Subgroup.closure
      ((B.rootGroup a : Set (rationalPoints G)) ∪ B.rootGroup (-a)) :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)))

/-- With opposite pairs, the rank-one centralizer generators are products of
actual reflection representatives. -/
theorem rankOneCentralizerSubgroup_le_reflectionNormalizer_map
    (hF : RelativeRoot.HasOppositeFactorPairs B.i) :
    B.rankOneCentralizerSubgroup ≤
      B.reflectionNormalizer.map (normalizerPoints B.i).subtype := by
  rw [rankOneCentralizerSubgroup, Subgroup.closure_le]
  intro g hg
  simp only [Set.mem_iUnion] at hg
  obtain ⟨a, ha, hg⟩ := hg
  exact B.rankOneCentralizer_le_reflectionNormalizer_map hF ⟨a, ha⟩ hg

/-- A norm-one centralizer point acts trivially on the apartment. -/
theorem toNormalizer_mem_ker_of_mem_rationalCommonNormKernel
    {z : rationalPoints B.centralizer.Z}
    (hz : z ∈ rationalCommonNormKernel B.centralizer.Z) :
    B.centralizer.toNormalizer z ∈ B.apartment.normalizerAffineEquiv.ker := by
  rw [MonoidHom.mem_ker]
  apply AffineEquiv.ext
  intro x
  exact B.isOmegaCompatible.smul_eq_self hz x

/-- Ambient-group form: the image of `Z(F)^1` lies in the apartment action kernel. -/
theorem rationalCommonNormKernel_map_le_ker_map :
    (rationalCommonNormKernel B.centralizer.Z).map (rationalPoints.map B.centralizer.j) ≤
      B.apartment.normalizerAffineEquiv.ker.map (normalizerPoints B.i).subtype := by
  rintro _ ⟨z, hz, rfl⟩
  exact ⟨B.centralizer.toNormalizer z,
    B.toNormalizer_mem_ker_of_mem_rationalCommonNormKernel hz, rfl⟩

/-- Rank-one generation of `Z(F)` modulo `Z(F)^1` places every centralizer point
in the reflection subgroup modulo the apartment action kernel. -/
theorem toNormalizer_mem_reflections_sup_ker_of_le
    (hF : RelativeRoot.HasOppositeFactorPairs B.i)
    (hgen : (rationalPoints.map B.centralizer.j).range ≤
      B.rankOneCentralizerSubgroup ⊔
        (rationalCommonNormKernel B.centralizer.Z).map (rationalPoints.map B.centralizer.j))
    (z : rationalPoints B.centralizer.Z) :
    B.centralizer.toNormalizer z ∈
      B.reflectionNormalizer ⊔ B.apartment.normalizerAffineEquiv.ker := by
  rw [← Subgroup.mem_map_iff_mem (normalizerPoints B.i).subtype_injective, Subgroup.map_sup]
  exact sup_le_sup (B.rankOneCentralizerSubgroup_le_reflectionNormalizer_map hF)
    B.rationalCommonNormKernel_map_le_ker_map (hgen ⟨z, rfl⟩)

/-- Rank-one generation of `Z(F)` modulo `Z(F)^1` and opposite pairs give equality
of the reflection and centralizer translation lattices. -/
theorem reflectionTranslationLattice_eq_of_le
    (hF : RelativeRoot.HasOppositeFactorPairs B.i)
    (hgen : (rationalPoints.map B.centralizer.j).range ≤
      B.rankOneCentralizerSubgroup ⊔
        (rationalCommonNormKernel B.centralizer.Z).map (rationalPoints.map B.centralizer.j)) :
    B.reflectionTranslationLattice = B.centralizerTranslationLattice := by
  apply le_antisymm B.reflectionTranslationLattice_le_centralizerTranslationLattice
  rintro v ⟨z, hz⟩
  have hz' : (B.reducedCentralizerTranslation z).toAdd = v :=
    congrArg Multiplicative.toAdd hz
  rw [← hz']
  exact (B.centralizer_mem_reflections_sup_ker_iff z).mp
    (B.toNormalizer_mem_reflections_sup_ker_of_le hF hgen z)

end ValuationBuildingData

/-- The simply connected reflection-translation statement follows from actual
rank-one factorization and rank-one generation of split-torus centralizers. -/
theorem simplyConnectedReflectionTranslation_of_rankOneGeneration
    (hR : RootRankOneFactorizationStatement.{u})
    (hKT : SimplyConnectedRankOneCentralizerGenerationStatement.{u}) :
    SimplyConnectedReflectionTranslationStatement.{u} := by
  intro F _ _ _ _ G _ B hG
  have hF : RelativeRoot.HasOppositeFactorPairs B.i := by
    intro a ha x hx hx1
    exact (hR F G B.isConnectedReductive B.S B.i B.isMaximalSplitTorus
      a ha x hx hx1).1.exists
  exact B.reflectionTranslationLattice_eq_of_le hF
    (hKT F G hG B.S B.i B.isMaximalSplitTorus B.centralizer.Z B.centralizer.j
      B.centralizer.isRepresentedBy)

end Langlands.Geometry.Building
