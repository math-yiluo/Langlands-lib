import Langlands.Geometry.Building.MoyPrasadBlockExchange
import Langlands.Geometry.Building.ChamberExchange

/-! # Global exchange at constant positive Moy–Prasad depth -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj Pointwise TensorProduct
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building.ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G)

/-- The subgroup generated by the original root filtrations of the selected
directions, at one unchanged nonnegative depth. -/
def depthRootSpan (x : P.Apartment) (r : NNReal)
    (Ψ : Set (characterLattice P.S)) : Subgroup (rationalPoints G) :=
  ⨆ a : Ψ, P.filtration x a r

/-- The negative, positive and final middle-subgroup exchange set. -/
def depthExchangeSet (x : P.Apartment) (r : NNReal)
    (H : Subgroup (rationalPoints G)) (w : V P.S) : Set (rationalPoints G) :=
  (P.depthRootSpan x r (realPositiveRoots P.i (-w)) : Set (rationalPoints G)) *
    P.depthRootSpan x r (realPositiveRoots P.i w) * H

theorem filtration_le_depthRootSpan (x : P.Apartment) (r : NNReal)
    {Ψ : Set (characterLattice P.S)} {a : characterLattice P.S} (ha : a ∈ Ψ) :
    P.filtration x a r ≤ P.depthRootSpan x r Ψ :=
  le_iSup_of_le (⟨a, ha⟩ : Ψ) le_rfl

theorem depthRootSpan_mono (x : P.Apartment) (r : NNReal)
    {Ψ Ψ' : Set (characterLattice P.S)} (h : Ψ ⊆ Ψ') :
    P.depthRootSpan x r Ψ ≤ P.depthRootSpan x r Ψ' :=
  iSup_le fun a => P.filtration_le_depthRootSpan x r (h a.2)

theorem depthRootSpan_le_sup (x : P.Apartment) (r : NNReal)
    {Ψ Ψ₁ Ψ₂ : Set (characterLattice P.S)} (h : Ψ ⊆ Ψ₁ ∪ Ψ₂) :
    P.depthRootSpan x r Ψ ≤ P.depthRootSpan x r Ψ₁ ⊔ P.depthRootSpan x r Ψ₂ :=
  iSup_le fun a => (h a.2).elim
    (fun h1 => le_sup_of_le_left (P.filtration_le_depthRootSpan x r h1))
    (fun h2 => le_sup_of_le_right (P.filtration_le_depthRootSpan x r h2))

theorem depthRootSpan_eq_bot (x : P.Apartment) (r : NNReal)
    {Ψ : Set (characterLattice P.S)} (h : Ψ = ∅) :
    P.depthRootSpan x r Ψ = ⊥ := by
  subst h
  exact le_bot_iff.mp (iSup_le fun a => absurd a.2 (Set.notMem_empty _))

/-- V3 normalizes the common-positive span during a single-ray crossing
at the same original constant depth. -/
theorem filtration_le_normalizer_depthRootSpan (x : P.Apartment) (r : NNReal)
    {w w' : V P.S} (hw : IsRealGeneric P.i w) (hw' : IsRealGeneric P.i w')
    (hcross : IsRayCrossing P.i w w') {c : characterLattice P.S}
    (hc : c ∈ relativeRoots P.i) (hcD : eval P.S c w * eval P.S c w' < 0) :
    P.filtration x c r ≤ Subgroup.normalizer
      (P.depthRootSpan x r (realPositiveRoots P.i w ∩ realPositiveRoots P.i w') :
        Set (rationalPoints G)) := by
  apply le_normalizer_iSup_of_commutator_le
  intro b
  obtain ⟨⟨hb, hbw⟩, -, hbw'⟩ := b.2
  refine (P.apartment.filtration_commutator_le x hc hb
    (tmul_ne_neg_smul_of_crossing hcD hbw hbw') r r).trans ?_
  refine iSup_le fun p => iSup_le fun q => iSup_le fun hp => iSup_le fun hq =>
    iSup_le fun he => ?_
  obtain ⟨h1, h2⟩ :=
    combination_pos_of_crossing hw hw' hcross hc hcD hbw hbw' hp hq he
  refine (P.apartment.filtration_antitone x _ ?_).trans
    (P.filtration_le_depthRootSpan x r ⟨⟨he, h1⟩, he, h2⟩)
  have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp
  have hpr := mul_le_mul_of_nonneg_right hp1 r.coe_nonneg
  have hqr := mul_nonneg (Nat.cast_nonneg (α := ℝ) q) r.coe_nonneg
  linarith

theorem depthRootSpan_le_normalizer_depthRootSpan (x : P.Apartment) (r : NNReal)
    {w w' : V P.S} (hw : IsRealGeneric P.i w) (hw' : IsRealGeneric P.i w')
    (hcross : IsRayCrossing P.i w w') {Ψ : Set (characterLattice P.S)}
    (hΨ : ∀ c ∈ Ψ, c ∈ relativeRoots P.i ∧ eval P.S c w * eval P.S c w' < 0) :
    P.depthRootSpan x r Ψ ≤ Subgroup.normalizer
      (P.depthRootSpan x r (realPositiveRoots P.i w ∩ realPositiveRoots P.i w') :
        Set (rationalPoints G)) :=
  iSup_le fun c => P.filtration_le_normalizer_depthRootSpan x r
    hw hw' hcross (hΨ c c.2).1 (hΨ c c.2).2

/-- A selected ray containing its actual double is exactly the original
two-factor block subgroup, at the unchanged depth. -/
theorem depthRootSpan_eq_block_of_ray (hP : P.SatisfiesApartmentAxioms)
    (x : P.Apartment) (r : NNReal) {Ψ : Set (characterLattice P.S)}
    {a : characterLattice P.S} (ha : a ∈ Ψ) (hroots : Ψ ⊆ relativeRoots P.i)
    (hray : ∀ d ∈ Ψ, d = a ∨ d = 2 • a)
    (hdouble : 2 • a ∈ relativeRoots P.i → 2 • a ∈ Ψ) :
    P.depthRootSpan x r Ψ = P.filtrationBlockSubgroup hP x r (hroots ha) := by
  apply le_antisymm
  · refine iSup_le fun d => ?_
    rcases hray d d.2 with h | h
    · rw [h]
      exact P.filtration_le_filtrationBlockSubgroup hP x r (hroots ha)
    · have h2a : 2 • a ∈ relativeRoots P.i := h ▸ hroots d.2
      have hd : P.filtration x d r = P.apartment.doubleFiltration x a r := by
        rw [h]
        exact (P.apartment.doubleFiltration_of_mem x a r h2a).symm
      exact hd.le.trans
        (P.doubleFiltration_le_filtrationBlockSubgroup hP x r (hroots ha))
  · rintro g ⟨v, hv, w, hw, rfl⟩
    refine Subgroup.mul_mem _ (P.filtration_le_depthRootSpan x r ha hv) ?_
    by_cases h2a : 2 • a ∈ relativeRoots P.i
    · rw [P.apartment.doubleFiltration_of_mem x a r h2a] at hw
      exact P.filtration_le_depthRootSpan x r (hdouble h2a) hw
    · rw [P.apartment.doubleFiltration_of_not_mem x a r h2a] at hw
      rw [Subgroup.mem_bot.mp hw]
      exact Subgroup.one_mem _

/-- A single crossed root ray is exchanged as its complete original block. -/
theorem depthRootSpan_cross_mul_subset (hP : P.SatisfiesApartmentAxioms) (r : NNReal)
    (hT : IsSplitTorus P.S.toGrp) (hfinite : (relativeRoots P.i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero P.apartment.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots P.apartment.extendedAffineRoots =
      Set.range (rootForm P.i))
    (hneg : ∀ c ∈ relativeRoots P.i, -c ∈ relativeRoots P.i)
    {x : P.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots P.i,
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c ⊆
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * H)
    {w w' : V P.S} (hcross : IsRayCrossing P.i w w') :
    (P.depthRootSpan x r (realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w') :
        Set (rationalPoints G)) *
      P.depthRootSpan x r (realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w')) *
        (H : Set (rationalPoints G)) ⊆
      (P.depthRootSpan x r (realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w')) :
          Set (rationalPoints G)) *
        P.depthRootSpan x r (realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w') * H := by
  have mem₁ : ∀ c, c ∈ realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w') ↔
      c ∈ relativeRoots P.i ∧ 0 < eval P.S c w ∧ eval P.S c w' < 0 := by
    intro c
    simp only [realPositiveRoots, Set.mem_inter_iff, Set.mem_ofPred_eq, map_neg, neg_pos]
    tauto
  have mem₂ : ∀ c, c ∈ realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w' ↔
      c ∈ relativeRoots P.i ∧ eval P.S c w < 0 ∧ 0 < eval P.S c w' := by
    intro c
    simp only [realPositiveRoots, Set.mem_inter_iff, Set.mem_ofPred_eq, map_neg, neg_pos]
    tauto
  by_cases hne : (realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w')).Nonempty
  · obtain ⟨c₁, hc₁, hmin⟩ := Set.exists_min_image _ (fun c => eval P.S c w)
      (hfinite.subset fun c hc => ((mem₁ c).1 hc).1) hne
    obtain ⟨hc₁Φ, hc₁w, hc₁w'⟩ := (mem₁ c₁).1 hc₁
    have hray : ∀ d ∈ realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w'),
        d = c₁ ∨ d = 2 • c₁ := by
      intro d hd
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₁ d).1 hd
      obtain ⟨t, ht⟩ := hcross c₁ hc₁Φ d hdΦ (mul_neg_of_pos_of_neg hc₁w hc₁w')
        (mul_neg_of_pos_of_neg hdw hdw')
      have htw : eval P.S d w = t * eval P.S c₁ w := by rw [ht]; rfl
      have htpos : 0 < t := by
        by_contra hcon
        push Not at hcon
        nlinarith
      rcases P.apartment.eq_or_double_of_eval_eq_smul hT hsys hderiv hc₁Φ hdΦ htpos ht with h | h | h
      · exact Or.inl h
      · exact Or.inr h
      · exfalso
        have hm := hmin d hd
        rw [h, eval_nsmul_char] at hm
        push_cast at hm
        linarith
    have hc₁D₂ : -c₁ ∈ realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w' :=
      (mem₂ _).2 ⟨hneg c₁ hc₁Φ, by rw [eval_neg_char]; linarith,
        by rw [eval_neg_char]; linarith⟩
    have hU₁ : P.depthRootSpan x r
        (realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w')) =
        P.filtrationBlockSubgroup hP x r hc₁Φ := by
      refine P.depthRootSpan_eq_block_of_ray hP x r hc₁
        (fun d hd => ((mem₁ d).1 hd).1) hray ?_
      intro h2a
      exact (mem₁ _).2 ⟨h2a, by
        simp only [eval_nsmul_char, Nat.cast_ofNat]; linarith, by
        simp only [eval_nsmul_char, Nat.cast_ofNat]; linarith⟩
    have hU₂ : P.depthRootSpan x r
        (realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w') =
        P.filtrationBlockSubgroup hP x r (hneg c₁ hc₁Φ) := by
      refine P.depthRootSpan_eq_block_of_ray hP x r hc₁D₂
        (fun d hd => ((mem₂ d).1 hd).1) ?_ ?_
      · intro d hd
        obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₂ d).1 hd
        have hnd : -d ∈ realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w') :=
          (mem₁ _).2 ⟨hneg _ hdΦ, by rw [eval_neg_char]; linarith,
            by rw [eval_neg_char]; linarith⟩
        rcases hray _ hnd with h | h
        · left; rw [← h, neg_neg]
        · right; rw [smul_neg, ← h, neg_neg]
      · intro h2a
        exact (mem₂ _).2 ⟨h2a, by
          simp only [eval_nsmul_char, eval_neg_char, Nat.cast_ofNat]; linarith, by
          simp only [eval_nsmul_char, eval_neg_char, Nat.cast_ofNat]; linarith⟩
    rw [hU₁, hU₂]
    calc (P.filtrationBlockSubgroup hP x r (hneg c₁ hc₁Φ) : Set (rationalPoints G)) *
          P.filtrationBlockSubgroup hP x r hc₁Φ * H
        ⊆ (P.filtrationBlockSubgroup hP x r hc₁Φ : Set (rationalPoints G)) *
          P.filtrationBlockSubgroup hP x r (hneg c₁ hc₁Φ) * H * H :=
          Set.mul_subset_mul_right (hex c₁ hc₁Φ)
      _ = (P.filtrationBlockSubgroup hP x r hc₁Φ : Set (rationalPoints G)) *
          P.filtrationBlockSubgroup hP x r (hneg c₁ hc₁Φ) * H := by
          rw [mul_assoc _ (H : Set (rationalPoints G)), coe_mul_coe]
  · have h₁ : realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w') = ∅ :=
      Set.not_nonempty_iff_eq_empty.1 hne
    have h₂ : realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w' = ∅ := by
      refine Set.eq_empty_of_forall_notMem fun d hd => hne ⟨-d, ?_⟩
      obtain ⟨hdΦ, hdw, hdw'⟩ := (mem₂ d).1 hd
      exact (mem₁ _).2 ⟨hneg _ hdΦ, by rw [eval_neg_char]; linarith,
        by rw [eval_neg_char]; linarith⟩
    rw [P.depthRootSpan_eq_bot x r h₁, P.depthRootSpan_eq_bot x r h₂]

/-- Exchange across one root ray at the unchanged constant depth. -/
theorem depthExchangeSet_subset (hP : P.SatisfiesApartmentAxioms) (r : NNReal)
    (hT : IsSplitTorus P.S.toGrp) (hfinite : (relativeRoots P.i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero P.apartment.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots P.apartment.extendedAffineRoots =
      Set.range (rootForm P.i))
    (hneg : ∀ c ∈ relativeRoots P.i, -c ∈ relativeRoots P.i)
    {x : P.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots P.i,
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c ⊆
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * H)
    {w w' : V P.S} (hw : IsRealGeneric P.i w)
    (hw' : IsRealGeneric P.i w') (hcross : IsRayCrossing P.i w w') :
    P.depthExchangeSet x r H w ⊆ P.depthExchangeSet x r H w' := by
  set R := realPositiveRoots P.i w ∩ realPositiveRoots P.i w' with hR
  set Rn := realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i (-w') with hRn
  set D₁ := realPositiveRoots P.i w ∩ realPositiveRoots P.i (-w') with hD₁
  set D₂ := realPositiveRoots P.i (-w) ∩ realPositiveRoots P.i w' with hD₂
  have sep₁ : ∀ c ∈ D₁, c ∈ relativeRoots P.i ∧ eval P.S c w * eval P.S c w' < 0 := by
    intro c hc
    obtain ⟨⟨hcΦ, hcw⟩, -, hcw'⟩ := hc
    rw [map_neg] at hcw'
    exact ⟨hcΦ, mul_neg_of_pos_of_neg hcw (neg_pos.1 hcw')⟩
  have sep₂ : ∀ c ∈ D₂, c ∈ relativeRoots P.i ∧ eval P.S c w * eval P.S c w' < 0 := by
    intro c hc
    obtain ⟨⟨hcΦ, hcw⟩, -, hcw'⟩ := hc
    rw [map_neg] at hcw
    exact ⟨hcΦ, mul_neg_of_neg_of_pos (neg_pos.1 hcw) hcw'⟩
  have sep₂n : ∀ c ∈ D₂, c ∈ relativeRoots P.i ∧ eval P.S c (-w) * eval P.S c (-w') < 0 := by
    intro c hc
    rw [map_neg, map_neg, neg_mul_neg]
    exact sep₂ c hc
  have N1 : P.depthRootSpan x r D₂ ≤ Subgroup.normalizer (P.depthRootSpan x r Rn : Set (rationalPoints G)) :=
    P.depthRootSpan_le_normalizer_depthRootSpan x r hw.neg hw'.neg hcross.neg sep₂n
  have N2 : P.depthRootSpan x r D₂ ≤ Subgroup.normalizer (P.depthRootSpan x r R : Set (rationalPoints G)) :=
    P.depthRootSpan_le_normalizer_depthRootSpan x r hw hw' hcross sep₂
  have N3 : P.depthRootSpan x r D₁ ≤ Subgroup.normalizer (P.depthRootSpan x r R : Set (rationalPoints G)) :=
    P.depthRootSpan_le_normalizer_depthRootSpan x r hw hw' hcross sep₁
  have hcov₁ : realPositiveRoots P.i (-w) ⊆ Rn ∪ D₂ := by
    intro c hc
    rcases lt_or_gt_of_ne (hw' c hc.1) with h | h
    · left
      exact ⟨hc, hc.1, by rw [map_neg]; linarith⟩
    · right
      exact ⟨hc, hc.1, h⟩
  have hcov₂ : realPositiveRoots P.i w ⊆ R ∪ D₁ := by
    intro c hc
    rcases lt_or_gt_of_ne (hw' c hc.1) with h | h
    · right
      exact ⟨hc, hc.1, by rw [map_neg]; linarith⟩
    · left
      exact ⟨hc, hc.1, h⟩
  have hPn : (P.depthRootSpan x r (realPositiveRoots P.i (-w)) : Set (rationalPoints G)) ⊆
      (P.depthRootSpan x r Rn : Set (rationalPoints G)) * P.depthRootSpan x r D₂ := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N1]
    exact P.depthRootSpan_le_sup x r hcov₁
  have hPos : (P.depthRootSpan x r (realPositiveRoots P.i w) : Set (rationalPoints G)) ⊆
      (P.depthRootSpan x r R : Set (rationalPoints G)) * P.depthRootSpan x r D₁ := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N3]
    exact P.depthRootSpan_le_sup x r hcov₂
  have hcomm₂ : (P.depthRootSpan x r D₂ : Set (rationalPoints G)) * P.depthRootSpan x r R =
      (P.depthRootSpan x r R : Set (rationalPoints G)) * P.depthRootSpan x r D₂ := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ N2,
      ← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N2, sup_comm]
  have hcomm₁ : (P.depthRootSpan x r R : Set (rationalPoints G)) * P.depthRootSpan x r D₁ =
      (P.depthRootSpan x r D₁ : Set (rationalPoints G)) * P.depthRootSpan x r R := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ N3,
      ← Subgroup.coe_mul_of_right_le_normalizer_left _ _ N3, sup_comm]
  have hQn : (P.depthRootSpan x r Rn : Set (rationalPoints G)) * P.depthRootSpan x r D₁ ⊆
      P.depthRootSpan x r (realPositiveRoots P.i (-w')) :=
    Set.mul_subset_iff.2 fun a ha b hb => Subgroup.mul_mem _
      (P.depthRootSpan_mono x r Set.inter_subset_right ha) (P.depthRootSpan_mono x r Set.inter_subset_right hb)
  have hQ : (P.depthRootSpan x r R : Set (rationalPoints G)) * P.depthRootSpan x r D₂ ⊆
      P.depthRootSpan x r (realPositiveRoots P.i w') :=
    Set.mul_subset_iff.2 fun a ha b hb => Subgroup.mul_mem _
      (P.depthRootSpan_mono x r Set.inter_subset_right ha) (P.depthRootSpan_mono x r Set.inter_subset_right hb)
  have hex₀ := P.depthRootSpan_cross_mul_subset hP r hT hfinite hsys hderiv hneg hex hcross
  unfold depthExchangeSet
  set XR : Set (rationalPoints G) := (P.depthRootSpan x r R : Set (rationalPoints G))
  set XRn : Set (rationalPoints G) := (P.depthRootSpan x r Rn : Set (rationalPoints G))
  set X₁ : Set (rationalPoints G) := (P.depthRootSpan x r D₁ : Set (rationalPoints G))
  set X₂ : Set (rationalPoints G) := (P.depthRootSpan x r D₂ : Set (rationalPoints G))
  set Hs : Set (rationalPoints G) := (H : Set (rationalPoints G))
  calc (P.depthRootSpan x r (realPositiveRoots P.i (-w)) : Set (rationalPoints G)) *
        P.depthRootSpan x r (realPositiveRoots P.i w) * Hs
      ⊆ XRn * X₂ * (XR * X₁) * Hs := Set.mul_subset_mul_right (Set.mul_subset_mul hPn hPos)
    _ = XRn * XR * (X₂ * X₁ * Hs) := by
        simp only [mul_assoc]
        rw [← mul_assoc X₂ XR, hcomm₂, mul_assoc]
    _ ⊆ XRn * XR * (X₁ * X₂ * Hs) := Set.mul_subset_mul_left hex₀
    _ = XRn * X₁ * (XR * X₂) * Hs := by
        simp only [mul_assoc]
        rw [← mul_assoc XR X₁, hcomm₁, mul_assoc]
    _ ⊆ P.depthRootSpan x r (realPositiveRoots P.i (-w')) * P.depthRootSpan x r (realPositiveRoots P.i w') * Hs :=
        Set.mul_subset_mul_right (Set.mul_subset_mul hQn hQ)

theorem depthExchangeSet_eq (hP : P.SatisfiesApartmentAxioms) (r : NNReal)
    (hT : IsSplitTorus P.S.toGrp) (hfinite : (relativeRoots P.i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero P.apartment.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots P.apartment.extendedAffineRoots =
      Set.range (rootForm P.i))
    (hneg : ∀ c ∈ relativeRoots P.i, -c ∈ relativeRoots P.i)
    {x : P.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots P.i,
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c ⊆
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * H)
    {w w' : V P.S} (hw : IsRealGeneric P.i w)
    (hw' : IsRealGeneric P.i w') (hcross : IsRayCrossing P.i w w') :
    P.depthExchangeSet x r H w = P.depthExchangeSet x r H w' :=
  Set.Subset.antisymm
    (P.depthExchangeSet_subset hP r hT hfinite hsys hderiv hneg hex hw hw' hcross)
    (P.depthExchangeSet_subset hP r hT hfinite hsys hderiv hneg hex hw' hw hcross.symm)

/-- The finite real-vector crossing chain exchanges opposite signs. -/
theorem depthExchangeSet_tmul_eq_neg (hP : P.SatisfiesApartmentAxioms) (r : NNReal)
    (hT : IsSplitTorus P.S.toGrp) (hfinite : (relativeRoots P.i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero P.apartment.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots P.apartment.extendedAffineRoots =
      Set.range (rootForm P.i))
    (hneg : ∀ c ∈ relativeRoots P.i, -c ∈ relativeRoots P.i)
    {x : P.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots P.i,
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c ⊆
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * H)
    {mu : cocharacterLattice P.S} (hmu : IsGenericCocharacter P.i mu) :
    P.depthExchangeSet x r H ((1 : ℝ) ⊗ₜ[ℤ] mu) =
      P.depthExchangeSet x r H (-((1 : ℝ) ⊗ₜ[ℤ] mu)) := by
  set ν : V P.S := (1 : ℝ) ⊗ₜ[ℤ] mu with hν
  have hνgen : IsRealGeneric P.i ν := fun c hc => by
    rw [hν, eval_tmul, one_mul]
    exact_mod_cast hmu c hc
  have : Finite (relativeRoots P.i) := hfinite.to_subtype
  -- a vector `eta` on which the crossing parameters of non-proportional roots differ
  let ℓ : relativeRoots P.i × relativeRoots P.i → Module.Dual ℝ (V P.S) := fun p =>
    eval P.S p.2.1 ν • eval P.S p.1.1 - eval P.S p.1.1 ν • eval P.S p.2.1
  obtain ⟨eta, heta⟩ := Module.Dual.exists_forall_ne_zero_of_forall_exists
    (fun p : {p : relativeRoots P.i × relativeRoots P.i // ∃ v, ℓ p v ≠ 0} => ℓ p.1)
    (fun p => p.2)
  let lam : characterLattice P.S → ℝ := fun c => eval P.S c eta / eval P.S c ν
  have hlam : ∀ c ∈ relativeRoots P.i, ∀ d ∈ relativeRoots P.i, lam c = lam d →
      ∃ t : ℝ, eval P.S d = t • eval P.S c := by
    intro c hc d hd hcd
    have h1 := hνgen c hc
    have h2 := hνgen d hd
    by_cases hex : ∃ v, ℓ (⟨c, hc⟩, ⟨d, hd⟩) v ≠ 0
    · exfalso
      apply heta ⟨(⟨c, hc⟩, ⟨d, hd⟩), hex⟩
      simp only [ℓ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]
      simp only [lam] at hcd
      rw [div_eq_div_iff h1 h2] at hcd
      linarith
    · push Not at hex
      refine ⟨eval P.S d ν / eval P.S c ν, LinearMap.ext fun v => ?_⟩
      have hv := hex v
      simp only [ℓ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul, sub_eq_zero] at hv
      rw [LinearMap.smul_apply, smul_eq_mul, div_mul_eq_mul_div, eq_div_iff h1]
      linarith
  let w : ℝ → V P.S := fun s => eta - s • ν
  have hew : ∀ c ∈ relativeRoots P.i, ∀ s, eval P.S c (w s) = eval P.S c ν * (lam c - s) := by
    intro c hc s
    have h1 := hνgen c hc
    simp only [w, lam, map_sub, map_smul, smul_eq_mul]
    field_simp
  set Λ : Finset ℝ := hfinite.toFinset.image lam with hΛ
  have hmemΛ : ∀ c ∈ relativeRoots P.i, lam c ∈ Λ := fun c hc =>
    Finset.mem_image_of_mem _ (hfinite.mem_toFinset.2 hc)
  have hgen : ∀ s, s ∉ Λ → IsRealGeneric P.i (w s) := by
    intro s hs c hc
    rw [hew c hc]
    exact mul_ne_zero (hνgen c hc) (sub_ne_zero.2 fun h => hs (h ▸ hmemΛ c hc))
  have hchain : ∀ s s', s < s' → s ∉ Λ → s' ∉ Λ →
      P.depthExchangeSet x r H (w s) = P.depthExchangeSet x r H (w s') := by
    intro s s' hss' hs hs'
    refine eq_of_forall_single_crossing Λ (fun s => P.depthExchangeSet x r H (w s)) ?_ hss' hs hs'
    intro s s' hss' hs hs' hsingle
    refine P.depthExchangeSet_eq hP r hT hfinite hsys hderiv hneg hex (hgen s hs)
      (hgen s' hs') ?_
    intro c hc d hd hcD hdD
    rw [hew c hc, hew c hc] at hcD
    rw [hew d hd, hew d hd] at hdD
    exact hlam c hc d hd (hsingle _ (hmemΛ c hc) _ (hmemΛ d hd)
      (mem_Ioo_of_mul_neg (hνgen c hc) hss' hcD) (mem_Ioo_of_mul_neg (hνgen d hd) hss' hdD))
  -- the end points
  obtain ⟨B, hBpos, hB⟩ : ∃ B : ℝ, 0 < B ∧ ∀ c ∈ relativeRoots P.i, |lam c| < B := by
    obtain ⟨B, hB⟩ := (hfinite.image (fun c => |lam c|)).bddAbove
    refine ⟨max B 0 + 1, by positivity, fun c hc => ?_⟩
    have := hB ⟨c, hc, rfl⟩
    have := le_max_left B 0
    linarith
  have hnotΛ : ∀ s, (∀ c ∈ relativeRoots P.i, lam c ≠ s) → s ∉ Λ := by
    intro s hs h
    obtain ⟨c, hc, hcl⟩ := Finset.mem_image.1 h
    exact hs c (hfinite.mem_toFinset.1 hc) hcl
  have hB₀ : -B ∉ Λ := hnotΛ _ fun c hc h => by
    have := (abs_lt.1 (hB c hc)).1
    linarith
  have hB₁ : B ∉ Λ := hnotΛ _ fun c hc h => by
    have := (abs_lt.1 (hB c hc)).2
    linarith
  have e1 : P.depthExchangeSet x r H ν = P.depthExchangeSet x r H (w (-B)) := by
    refine P.depthExchangeSet_eq hP r hT hfinite hsys hderiv hneg hex hνgen (hgen _ hB₀)
      (isRayCrossing_of_forall_pos fun c hc => ?_)
    rw [hew c hc]
    have h1 := hνgen c hc
    have h2 : 0 < lam c - -B := by linarith [(abs_lt.1 (hB c hc)).1]
    have : eval P.S c ν * (eval P.S c ν * (lam c - -B)) = eval P.S c ν ^ 2 * (lam c - -B) := by ring
    rw [this]
    positivity
  have e3 : P.depthExchangeSet x r H (w B) = P.depthExchangeSet x r H (-ν) := by
    refine P.depthExchangeSet_eq hP r hT hfinite hsys hderiv hneg hex (hgen _ hB₁)
      hνgen.neg (isRayCrossing_of_forall_pos fun c hc => ?_)
    rw [hew c hc, map_neg]
    have h1 := hνgen c hc
    have h2 : 0 < B - lam c := by linarith [(abs_lt.1 (hB c hc)).2]
    have : eval P.S c ν * (lam c - B) * -eval P.S c ν = eval P.S c ν ^ 2 * (B - lam c) := by ring
    rw [this]
    positivity
  exact e1.trans ((hchain (-B) B (by linarith) hB₀ hB₁).trans e3)

theorem mul_mem_depthExchangeSet (x : P.Apartment) (r : NNReal)
    (H : Subgroup (rationalPoints G)) {w : V P.S} {g y : rationalPoints G}
    (hg : g ∈ P.depthRootSpan x r (realPositiveRoots P.i (-w)))
    (hy : y ∈ P.depthExchangeSet x r H w) : g * y ∈ P.depthExchangeSet x r H w := by
  obtain ⟨_, ⟨a, ha, b, hb, rfl⟩, h, hh, rfl⟩ := hy
  rw [show g * (a * b * h) = g * a * b * h by group]
  exact Set.mul_mem_mul (Set.mul_mem_mul (Subgroup.mul_mem _ hg ha) hb) hh

/-- The original root-generated depth subgroup is covered by the two sign spans
and the supplied middle subgroup whenever local block exchange holds. -/
theorem sharpFiltration_subset_depthExchangeSet (hP : P.SatisfiesApartmentAxioms) (r : NNReal)
    (hT : IsSplitTorus P.S.toGrp) (hfinite : (relativeRoots P.i).Finite)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero P.apartment.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots P.apartment.extendedAffineRoots =
      Set.range (rootForm P.i))
    (hneg : ∀ c ∈ relativeRoots P.i, -c ∈ relativeRoots P.i)
    {x : P.Apartment} {H : Subgroup (rationalPoints G)}
    (hex : ∀ c ∈ relativeRoots P.i,
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c ⊆
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * H)
    (mu : cocharacterLattice P.S) (hmu : IsGenericCocharacter P.i mu) :
    (P.apartment.sharpFiltration x (fun _ => (r : ℝ)) : Set (rationalPoints G)) ⊆
      P.depthExchangeSet x r H ((1 : ℝ) ⊗ₜ[ℤ] mu) := by
  set ν : V P.S := (1 : ℝ) ⊗ₜ[ℤ] mu with hν
  have hνgen : IsRealGeneric P.i ν := fun c hc => by
    rw [hν, eval_tmul, one_mul]
    exact_mod_cast hmu c hc
  have hYeq := P.depthExchangeSet_tmul_eq_neg hP r hT hfinite hsys hderiv hneg hex hmu
  rw [← hν] at hYeq
  have hstab : ∀ α ∈ relativeRoots P.i, ∀ g ∈ P.filtration x α r, ∀ y ∈ P.depthExchangeSet x r H ν,
      g * y ∈ P.depthExchangeSet x r H ν := by
    intro α hα g hg y hy
    rcases lt_or_gt_of_ne (hνgen α hα) with hlt | hgt
    · exact P.mul_mem_depthExchangeSet x r H (P.filtration_le_depthRootSpan x r
        (⟨hα, by rw [map_neg]; linarith⟩ : α ∈ realPositiveRoots P.i (-ν)) hg) hy
    · rw [hYeq] at hy ⊢
      exact P.mul_mem_depthExchangeSet x r H (P.filtration_le_depthRootSpan x r
        (⟨hα, by rw [neg_neg]; exact hgt⟩ : α ∈ realPositiveRoots P.i (-(-ν))) hg) hy
  let K : Subgroup (rationalPoints G) :=
    { carrier := {g | ∀ y ∈ P.depthExchangeSet x r H ν,
        g * y ∈ P.depthExchangeSet x r H ν ∧ g⁻¹ * y ∈ P.depthExchangeSet x r H ν}
      mul_mem' := fun {a b} ha hb y hy => by
        refine ⟨?_, ?_⟩
        · rw [mul_assoc]
          exact (ha _ (hb y hy).1).1
        · rw [mul_inv_rev, mul_assoc]
          exact (hb _ (ha y hy).2).2
      one_mem' := fun y hy => by simpa only [one_mul, inv_one, and_self] using hy
      inv_mem' := fun {a} ha y hy => by
        refine ⟨(ha y hy).2, ?_⟩
        rw [inv_inv]
        exact (ha y hy).1 }
  have hK : P.apartment.sharpFiltration x (fun _ => (r : ℝ)) ≤ K := by
    rw [P.apartment.sharpFiltration_eq_iSup]
    refine iSup_le fun α => ?_
    intro g hg y hy
    exact ⟨hstab α α.2 g hg y hy, hstab α α.2 g⁻¹ (Subgroup.inv_mem _ hg) y hy⟩
  intro g hg
  have h1 : (1 : rationalPoints G) ∈ P.depthExchangeSet x r H ν :=
    ⟨1, ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, mul_one 1⟩, 1, Subgroup.one_mem _,
      mul_one 1⟩
  have := (hK hg 1 h1).1
  rwa [mul_one] at this

namespace CentralizerFiltration

variable {P} (Zf : P.CentralizerFiltration)

/-- The original centralizer-depth image normalizes every selected depth span. -/
theorem image_le_normalizer_depthRootSpan (x : P.Apartment) (r s : NNReal)
    (Ψ : Set (characterLattice P.S)) :
    Zf.image r ≤ Subgroup.normalizer
      (P.depthRootSpan x s Ψ : Set (rationalPoints G)) :=
  (le_iInf fun a : Ψ => Zf.image_le_normalizer_filtration x r a s).trans
    (Subgroup.iInf_normalizer_le_normalizer_iSup _)

/-- Full local exchange supplies global covering of the original sharp
constant-depth subgroup. -/
theorem sharpFiltration_subset_signs_mul_image
    (hP : P.SatisfiesApartmentAxioms) (hZ : Zf.IsCommutatorFriendly)
    (x : P.Apartment) (r : NNReal) (hr : 0 < r)
    (mu : cocharacterLattice P.S) (hmu : IsGenericCocharacter P.i mu) :
    (P.apartment.sharpFiltration x (fun _ => (r : ℝ)) : Set (rationalPoints G)) ⊆
      (P.depthRootSpan x r (positiveRelativeRoots P.i (-mu)) : Set (rationalPoints G)) *
        P.depthRootSpan x r (positiveRelativeRoots P.i mu) * Zf.image r := by
  let : Smooth G.X.hom := P.isConnectedReductive.smooth
  have hT := P.isMaximalSplitTorus.isSplitSubtorus.1
  have hneg : ∀ c ∈ relativeRoots P.i, -c ∈ relativeRoots P.i := fun c hc =>
    KPApartmentData.neg_mem_relativeRoots_of_rankOne hT
      (rootRankOneFactorization F G P.isConnectedReductive P.S P.i P.isMaximalSplitTorus) x hc
  have hex (c : characterLattice P.S) (hc : c ∈ relativeRoots P.i) :
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c ⊆
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) c *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * Zf.image r := by
    have he := Zf.filtrationBlock_mul_opposite_subset hP hZ x (hneg c hc) r hr
    simp only [neg_neg] at he
    refine he.trans (le_of_eq ?_)
    have hcZ := Subgroup.set_mul_normalizer_comm (Zf.image r : Set (rationalPoints G))
      (P.filtrationBlockSubgroup hP x r (hneg c hc))
      (Zf.image_le_normalizer_filtrationBlockSubgroup hP x r r (hneg c hc))
    change (Zf.image r : Set (rationalPoints G)) *
        P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) =
      P.apartment.filtrationBlock x (fun _ => (r : ℝ)) (-c) * Zf.image r at hcZ
    rw [mul_assoc, hcZ, ← mul_assoc]
  have h := P.sharpFiltration_subset_depthExchangeSet hP r hT
    (hT.finite_relativeRoots P.i) hP.isAffineRootSystem_extendedAffineRoots
    hP.derivativeRoots_extendedAffineRoots hneg hex mu hmu
  have hpos : realPositiveRoots P.i ((1 : ℝ) ⊗ₜ[ℤ] mu) = positiveRelativeRoots P.i mu := by
    ext c
    simp only [realPositiveRoots, positiveRelativeRoots, Set.mem_ofPred_eq, eval_tmul,
      one_mul, Int.cast_pos]
  have hnegpos : realPositiveRoots P.i (-((1 : ℝ) ⊗ₜ[ℤ] mu)) =
      positiveRelativeRoots P.i (-mu) := by
    ext c
    simp only [realPositiveRoots, positiveRelativeRoots, Set.mem_ofPred_eq, map_neg,
      eval_tmul, one_mul, neg_pos]
    constructor
    · rintro ⟨hc, h⟩
      exact ⟨hc, by exact_mod_cast h⟩
    · rintro ⟨hc, h⟩
      exact ⟨hc, by exact_mod_cast h⟩
  simpa only [depthExchangeSet, hpos, hnegpos] using h

/-- The full original positive-depth subgroup is the product of the two
original sign spans and its actual centralizer-depth image. -/
theorem moyPrasad_eq_negative_image_positive
    (hP : P.SatisfiesApartmentAxioms) (hZ : Zf.IsCommutatorFriendly)
    (x : P.Apartment) (r : NNReal) (hr : 0 < r)
    (mu : cocharacterLattice P.S) (hmu : IsGenericCocharacter P.i mu) :
    (Zf.moyPrasad x r : Set (rationalPoints G)) =
      (P.depthRootSpan x r (positiveRelativeRoots P.i (-mu)) : Set (rationalPoints G)) *
        (Zf.image r : Set (rationalPoints G)) *
          P.depthRootSpan x r (positiveRelativeRoots P.i mu) := by
  let N := P.depthRootSpan x r (positiveRelativeRoots P.i (-mu))
  let Q := P.depthRootSpan x r (positiveRelativeRoots P.i mu)
  let Z := Zf.image r
  have hnormal : Zf.image r ≤ Subgroup.normalizer
      (P.apartment.sharpFiltration x (fun _ => (r : ℝ)) : Set (rationalPoints G)) := by
    rw [P.apartment.sharpFiltration_eq_iSup]
    exact (le_iInf fun a : relativeRoots P.i =>
      Zf.image_le_normalizer_filtration x r a r).trans
        (Subgroup.iInf_normalizer_le_normalizer_iSup _)
  have hprod : (Zf.moyPrasad x r : Set (rationalPoints G)) =
      (Z : Set (rationalPoints G)) *
        P.apartment.sharpFiltration x (fun _ => (r : ℝ)) :=
    Subgroup.coe_mul_of_left_le_normalizer_right _ _ hnormal
  have hZN : (Z : Set (rationalPoints G)) * N =
      (N : Set (rationalPoints G)) * Z :=
    Subgroup.set_mul_normalizer_comm _ _
      (Zf.image_le_normalizer_depthRootSpan x r r _)
  have hZQ : (Z : Set (rationalPoints G)) * Q =
      (Q : Set (rationalPoints G)) * Z :=
    Subgroup.set_mul_normalizer_comm _ _
      (Zf.image_le_normalizer_depthRootSpan x r r _)
  have hcollect : (Z : Set (rationalPoints G)) * ((N : Set (rationalPoints G)) * Q * Z) =
      (N : Set (rationalPoints G)) * Z * Q := by
    calc (Z : Set (rationalPoints G)) * ((N : Set (rationalPoints G)) * Q * Z)
        = ((Z : Set (rationalPoints G)) * N) * Q * Z := by
          simp only [mul_assoc]
      _ = ((N : Set (rationalPoints G)) * Z) * Q * Z := by rw [hZN]
      _ = (N : Set (rationalPoints G)) * ((Z : Set (rationalPoints G)) * Q) * Z := by
          rw [mul_assoc (N : Set (rationalPoints G))]
      _ = (N : Set (rationalPoints G)) * ((Q : Set (rationalPoints G)) * Z) * Z := by
          rw [hZQ]
      _ = ((N : Set (rationalPoints G)) * Q) * ((Z : Set (rationalPoints G)) * Z) := by
          simp only [mul_assoc]
      _ = ((N : Set (rationalPoints G)) * Q) * Z := by rw [coe_mul_coe]
      _ = (N : Set (rationalPoints G)) * Z * Q := by
          rw [mul_assoc, ← hZQ, ← mul_assoc]
  apply Set.Subset.antisymm
  · rw [hprod]
    exact (Set.mul_subset_mul_left
      (Zf.sharpFiltration_subset_signs_mul_image hP hZ x r hr mu hmu)).trans
        (le_of_eq hcollect)
  · have hle (nu : cocharacterLattice P.S) :
        P.depthRootSpan x r (positiveRelativeRoots P.i nu) ≤ Zf.moyPrasad x r :=
      iSup_le fun a => Zf.filtration_le_moyPrasad x ⟨a, a.2.1⟩ r
    rintro g ⟨_, ⟨n, hn, z, hz, rfl⟩, q, hq, rfl⟩
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hle (-mu) hn)
      (Zf.image_le_moyPrasad x r hz)) (hle mu hq)

end CentralizerFiltration

