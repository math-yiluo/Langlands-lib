import Langlands.Geometry.Building.AffineChamberAction
import Langlands.Geometry.Building.AffineReflectionGalleryGeometryStatement
import Mathlib.Topology.Instances.Real.Lemmas

/-!
# Wall-reflection generation and galleries for locally finite arrangements

A proof of `AffineReflectionGalleryGeometryStatement`. For a locally finite real
reflection arrangement `Ψ` and a regular point `x`:

* a wall of the chamber of `x` separating `x` from a regular `y` exists whenever some
  root separates them (minimal crossing time along a segment to a generic perturbation
  of `y`);
* crossing that wall strictly decreases the finite set of separating roots, which gives
  a gallery from `x` to the chamber of `y` inside the group generated by the walls;
* every coroot reflection is a wall reflection of some regular point near a generic
  point of its hyperplane, and is transported to a wall of `x` along such a gallery.
-/

noncomputable section

open Filter Topology

universe uV uA

namespace Langlands.Geometry.Building

namespace AffineRootSystem.GalleryGeometry

open AffineRootSystem

variable {V : Type uV} {A : Type uA}
variable [AddCommGroup V] [Module ℝ V] [AddTorsor V A]
variable {Ψ : Set (A →ᵃ[ℝ] ℝ)}

/-! ### Real arithmetic -/

theorem sign_add_eq_of_abs_lt {a b : ℝ} (h : |b| < |a|) :
    SignType.sign (a + b) = SignType.sign a := by
  rcases lt_trichotomy a 0 with ha | ha | ha
  · rw [abs_of_neg ha] at h
    have := (abs_lt.1 h).2
    rw [sign_neg ha, sign_neg (by linarith)]
  · rw [ha, abs_zero] at h
    exact absurd h (not_lt.2 (abs_nonneg b))
  · rw [abs_of_pos ha] at h
    have := (abs_lt.1 h).1
    rw [sign_pos ha, sign_pos (by linarith)]

theorem mul_neg_of_sign_eq {a a' b b' : ℝ} (ha : SignType.sign a = SignType.sign a')
    (hb : SignType.sign b = SignType.sign b') (h : a * b < 0) : a' * b' < 0 := by
  rcases mul_neg_iff.1 h with ⟨ha0, hb0⟩ | ⟨ha0, hb0⟩
  · rw [sign_pos ha0, eq_comm, sign_eq_one_iff] at ha
    rw [sign_neg hb0, eq_comm, sign_eq_neg_one_iff] at hb
    exact mul_neg_of_pos_of_neg ha hb
  · rw [sign_neg ha0, eq_comm, sign_eq_neg_one_iff] at ha
    rw [sign_pos hb0, eq_comm, sign_eq_one_iff] at hb
    exact mul_neg_of_neg_of_pos ha hb

theorem mul_pos_of_sign_eq {a b : ℝ} (ha : a ≠ 0) (h : SignType.sign a = SignType.sign b) :
    0 < a * b := by
  rcases lt_or_gt_of_ne ha with ha | ha
  · rw [sign_neg ha, eq_comm, sign_eq_neg_one_iff] at h
    exact mul_pos_of_neg_of_neg ha h
  · rw [sign_pos ha, eq_comm, sign_eq_one_iff] at h
    exact mul_pos ha h

theorem sign_eq_of_not_mul_neg {a b : ℝ} (ha : a ≠ 0) (hb : b ≠ 0) (h : ¬a * b < 0) :
    SignType.sign a = SignType.sign b := by
  rcases lt_or_gt_of_ne ha with ha | ha <;> rcases lt_or_gt_of_ne hb with hb | hb
  · rw [sign_neg ha, sign_neg hb]
  · exact absurd (mul_neg_of_neg_of_pos ha hb) h
  · exact absurd (mul_neg_of_pos_of_neg ha hb) h
  · rw [sign_pos ha, sign_pos hb]

/-- The zero `a / (a - b)` of `t ↦ a + t (b - a)` lies strictly between `0` and `1`
when `a` and `b` have opposite signs. -/
theorem crossTime_mem {a b : ℝ} (h : a * b < 0) :
    a - b ≠ 0 ∧ 0 < a / (a - b) ∧ a / (a - b) < 1 := by
  rcases lt_or_gt_of_ne (show a ≠ 0 by rintro rfl; simp at h) with ha | ha
  · have hb : 0 < b := by nlinarith
    have hd : a - b < 0 := by linarith
    exact ⟨hd.ne, div_pos_of_neg_of_neg ha hd, (div_lt_one_of_neg hd).2 (by linarith)⟩
  · have hb : b < 0 := by nlinarith
    have hd : 0 < a - b := by linarith
    exact ⟨hd.ne', div_pos ha hd, (div_lt_one hd).2 (by linarith)⟩

/-- A sign change of `t ↦ a + t (b - a)` before time `T ∈ (0, 1)`. -/
theorem crossing_lt {a b T : ℝ} (ha : a ≠ 0) (hT0 : 0 < T) (hT1 : T < 1)
    (h : a * (a + T * (b - a)) < 0) : a * b < 0 ∧ a / (a - b) < T := by
  have ha2 : 0 < a * a := mul_self_pos.2 ha
  have hab : a * b < 0 := by nlinarith
  refine ⟨hab, ?_⟩
  have hpos : 0 < a * (a - b) := by nlinarith
  rw [← mul_div_mul_left a (a - b) ha, div_lt_iff₀ hpos]
  nlinarith

/-- A zero of `t ↦ a + t (b - a)` at time `T ∈ (0, 1)`. -/
theorem crossing_eq {a b T : ℝ} (ha : a ≠ 0) (hT0 : 0 < T) (hT1 : T < 1)
    (h : a + T * (b - a) = 0) : a * b < 0 ∧ a / (a - b) = T := by
  have ha2 : 0 < a * a := mul_self_pos.2 ha
  have h' : a * (a + T * (b - a)) = 0 := by rw [h, mul_zero]
  have hab : a * b < 0 := by nlinarith
  refine ⟨hab, ?_⟩
  rw [div_eq_iff (crossTime_mem hab).1]
  linarith

theorem cross_mul_eq {p q a b : ℝ} (hpq : p - q ≠ 0) (hab : a - b ≠ 0)
    (h : p / (p - q) = a / (a - b)) : p * b - a * q = 0 := by
  rw [div_eq_div_iff hpq hab] at h
  linear_combination -h

/-! ### Affine functionals -/

theorem apply_smul_vadd (f : A →ᵃ[ℝ] ℝ) (c : ℝ) (u : V) (p : A) :
    f (c • u +ᵥ p) = f p + c * f.linear u := by
  rw [AffineMap.map_vadd, map_smul, smul_eq_mul, vadd_eq_add, add_comm]

theorem apply_eq_of_linear_eq_zero {f : A →ᵃ[ℝ] ℝ} (hf : f.linear = 0) (p q : A) :
    f p = f q := by
  rw [← vsub_vadd p q, AffineMap.map_vadd, hf, LinearMap.zero_apply, vadd_eq_add, zero_add]

theorem eq_zero_of_linear_eq_zero {f : A →ᵃ[ℝ] ℝ} (hf : f.linear = 0) {p : A}
    (hp : f p = 0) : f = 0 := by
  ext q
  rw [apply_eq_of_linear_eq_zero hf q p, hp]
  rfl

theorem exists_apply_ne_zero {f : A →ᵃ[ℝ] ℝ} (hf : f.linear ≠ 0) : ∃ p, f p ≠ 0 := by
  by_contra h
  simp only [not_exists, not_not] at h
  obtain ⟨p⟩ : Nonempty A := inferInstance
  refine hf (LinearMap.ext fun u => ?_)
  have := h (u +ᵥ p)
  rwa [AffineMap.map_vadd, vadd_eq_add, h p, add_zero] at this

/-- A point lies on no root hyperplane. -/
def IsRegular (Ψ : Set (A →ᵃ[ℝ] ℝ)) (x : A) : Prop :=
  ∀ ψ ∈ Ψ, ψ x ≠ 0

theorem IsRegular.apply {e : A ≃ᵃ[ℝ] A} (he : e ∈ rootStabilizer Ψ) {x : A}
    (hx : IsRegular Ψ x) : IsRegular Ψ (e x) :=
  fun ψ hψ => hx _ ((comp_mem_iff he ψ).2 hψ)

theorem IsRegular.of_facetRel {x y : A} (h : facetRel Ψ x y) (hx : IsRegular Ψ x) :
    IsRegular Ψ y := fun ψ hψ hy =>
  hx ψ hψ (by rw [← sign_eq_zero_iff, h ψ hψ, sign_eq_zero_iff]; exact hy)

/-! ### Coroots and reflections -/

/-- Coroots of a locally finite reflection arrangement are unique (Bourbaki's lemma,
`Module.Dual.eq_of_preReflection_mapsTo`, as in `IsAffineRootSystem.isCoroot_unique`). -/
theorem isCoroot_unique (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {ψ : A →ᵃ[ℝ] ℝ} {v w : V} (hv : IsCoroot Ψ ψ v) (hw : IsCoroot Ψ ψ w) : v = w := by
  have hmaps : ∀ u : V, IsCoroot Ψ ψ u →
      Set.MapsTo (Module.preReflection ψ.linear (Module.Dual.eval ℝ V u))
        (derivativeRoots Ψ) (derivativeRoots Ψ) := by
    rintro u hu _ ⟨η, hη, rfl⟩
    refine ⟨η - η.linear u • ψ, hu.2 η hη, ?_⟩
    simp [Module.preReflection_apply]
  have h := Module.Dual.eq_of_preReflection_mapsTo hΨ.finite_derivativeRoots
    hΨ.span_derivativeRoots_eq_top (by simpa using hv.1) (hmaps v hv)
    (by simpa using hw.1) (hmaps w hw)
  exact Module.eval_apply_injective ℝ h

/-- Proportional roots have the same reflection. -/
theorem affineReflection_eq_of_eq_smul (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {ψ η : A →ᵃ[ℝ] ℝ} {v w : V} (hv : IsCoroot Ψ ψ v) (hw : IsCoroot Ψ η w) {c : ℝ}
    (hc : η = c • ψ) : affineReflection η hw.1 = affineReflection ψ hv.1 := by
  subst hc
  have hc0 : c ≠ 0 := by
    rintro rfl
    have := hw.1
    simp at this
  have hcw : IsCoroot Ψ (c • ψ) (c⁻¹ • v) := by
    refine ⟨?_, fun ζ hζ => ?_⟩
    · rw [AffineMap.smul_linear, LinearMap.smul_apply, map_smul, hv.1, smul_eq_mul,
        smul_eq_mul, mul_inv_cancel_left₀ hc0]
    · convert hv.2 ζ hζ using 2
      rw [map_smul, smul_eq_mul, smul_smul]
      congr 1
      field_simp
  have := isCoroot_unique hΨ hw hcw
  subst this
  ext p
  simp only [affineReflection_apply, AffineMap.coe_smul, Pi.smul_apply, smul_eq_mul, smul_smul]
  congr 2
  field_simp

/-- Equal reflections come from proportional roots. -/
theorem exists_eq_smul_of_affineReflection_eq {ψ η : A →ᵃ[ℝ] ℝ} (hψ : ψ.linear ≠ 0)
    {v w : V} (hv : ψ.linear v = 2) (hw : η.linear w = 2)
    (h : affineReflection η hw = affineReflection ψ hv) : ∃ c : ℝ, η = c • ψ := by
  have key : ∀ p, η p * ψ.linear w = 2 * ψ p := by
    intro p
    have hp := congrArg (fun e : A ≃ᵃ[ℝ] A => e p -ᵥ p) h
    simp only [affineReflection_apply, vadd_vsub] at hp
    have := congrArg ψ.linear hp
    rw [map_smul, map_smul, hv, smul_eq_mul, smul_eq_mul] at this
    linarith
  obtain ⟨p₀, hp₀⟩ := exists_apply_ne_zero hψ
  have hw0 : ψ.linear w ≠ 0 := by
    intro h0
    have := key p₀
    rw [h0, mul_zero] at this
    exact hp₀ (by linarith)
  refine ⟨2 / ψ.linear w, ?_⟩
  ext p
  simp only [AffineMap.coe_smul, Pi.smul_apply, smul_eq_mul]
  rw [div_mul_eq_mul_div, eq_div_iff hw0]
  exact key p

/-! ### Separation and wall reflections -/

theorem mem_rootStabilizer_of_reflectionSeparates {t : A ≃ᵃ[ℝ] A} {p q : A}
    (h : reflectionSeparates Ψ t p q) : t ∈ rootStabilizer Ψ := by
  obtain ⟨η, -, w, hw, rfl, -⟩ := h
  exact affineReflection_mem_rootStabilizer hw

theorem reflectionSeparates_of_facetRel {t : A ≃ᵃ[ℝ] A} {p p' q q' : A}
    (hp : facetRel Ψ p p') (hq : facetRel Ψ q q') (h : reflectionSeparates Ψ t p q) :
    reflectionSeparates Ψ t p' q' := by
  obtain ⟨η, hη, w, hw, ht, hsep⟩ := h
  exact ⟨η, hη, w, hw, ht, mul_neg_of_sign_eq (hp η hη) (hq η hη) hsep⟩

theorem reflectionSeparates_conj {e : A ≃ᵃ[ℝ] A} (he : e ∈ rootStabilizer Ψ)
    {t : A ≃ᵃ[ℝ] A} {p q : A} (h : reflectionSeparates Ψ t p q) :
    reflectionSeparates Ψ (e * t * e⁻¹) (e p) (e q) := by
  obtain ⟨η, hη, w, hw, rfl, hsep⟩ := h
  refine ⟨η.comp (e.symm : A →ᵃ[ℝ] A), (comp_mem_iff (inv_mem he) η).2 hη, e.linear w,
    IsCoroot.map hw he, conjugate_affineReflection e η hw.1, ?_⟩
  change η (e.symm (e p)) * η (e.symm (e q)) < 0
  rwa [e.symm_apply_apply, e.symm_apply_apply]

theorem wallReflections_subset_affineWeylGroup (x : A) :
    wallReflections Ψ x ⊆ affineWeylGroup Ψ := by
  rintro s ⟨⟨ψ, hψ, v, hv, rfl, -⟩, -⟩
  exact affineReflection_mem_affineWeylGroup hψ hv

theorem closure_wallReflections_le (x : A) :
    Subgroup.closure (wallReflections Ψ x) ≤ affineWeylGroup Ψ :=
  (Subgroup.closure_le _).2 (wallReflections_subset_affineWeylGroup x)

theorem mem_rootStabilizer_of_mem_closure {x : A} {w : A ≃ᵃ[ℝ] A}
    (hw : w ∈ Subgroup.closure (wallReflections Ψ x)) : w ∈ rootStabilizer Ψ :=
  affineWeylGroup_le_rootStabilizer Ψ (closure_wallReflections_le x hw)

/-- Wall reflections depend only on the facet. -/
theorem mem_wallReflections_of_facetRel {s : A ≃ᵃ[ℝ] A} {p p' : A} (hp : facetRel Ψ p p')
    (hs : s ∈ wallReflections Ψ p) : s ∈ wallReflections Ψ p' := by
  have hst := mem_rootStabilizer_of_reflectionSeparates hs.1
  have hsp : facetRel Ψ (s p) (s p') := (facetRel_apply_iff hst p p').2 hp
  refine ⟨reflectionSeparates_of_facetRel hp hsp hs.1, fun t ht => hs.2 t ?_⟩
  exact reflectionSeparates_of_facetRel ((facetRel_equivalence Ψ).symm hp)
    ((facetRel_equivalence Ψ).symm hsp) ht

/-- Wall reflections are transported by conjugation. -/
theorem conj_mem_wallReflections {e : A ≃ᵃ[ℝ] A} (he : e ∈ rootStabilizer Ψ)
    {s : A ≃ᵃ[ℝ] A} {p : A} (hs : s ∈ wallReflections Ψ p) :
    e * s * e⁻¹ ∈ wallReflections Ψ (e p) := by
  have hsp : (e * s * e⁻¹) (e p) = e (s p) := by
    change e (s (e.symm (e p))) = e (s p)
    rw [e.symm_apply_apply]
  have hinv : ∀ q, e⁻¹ (e q) = q := fun q => e.symm_apply_apply q
  refine ⟨?_, fun t ht => ?_⟩
  · rw [hsp]
    exact reflectionSeparates_conj he hs.1
  · rw [hsp] at ht
    have h2 := reflectionSeparates_conj (inv_mem he) ht
    rw [hinv, hinv, inv_inv] at h2
    rw [← hs.2 _ h2]
    group

/-- The core wall criterion: if `ψ` vanishes at `z` and every root not proportional to
`ψ` has the same sign at `x` and `z`, then the reflection of `ψ` is a wall reflection
at the regular point `x`. -/
theorem mem_wallReflections_of_sign_eq (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {ψ : A →ᵃ[ℝ] ℝ} (hψ : ψ ∈ Ψ) {v : V} (hv : IsCoroot Ψ ψ v) {x z : A}
    (hx : IsRegular Ψ x) (hz : ψ z = 0)
    (hsign : ∀ η ∈ Ψ, (¬∃ c : ℝ, η = c • ψ) →
      SignType.sign (η x) = SignType.sign (η z)) :
    affineReflection ψ hv.1 ∈ wallReflections Ψ x := by
  refine ⟨⟨ψ, hψ, v, hv, rfl, ?_⟩, fun t ht => ?_⟩
  · rw [apply_affineReflection]
    have := mul_self_pos.2 (hx ψ hψ)
    linarith
  · obtain ⟨η, hη, w, hw, rfl, hsep⟩ := ht
    by_cases hprop : ∃ c : ℝ, η = c • ψ
    · obtain ⟨c, hc⟩ := hprop
      exact affineReflection_eq_of_eq_smul hΨ hv hw hc
    · exfalso
      have hη'Ψ : η - η.linear v • ψ ∈ Ψ := hv.2 η hη
      have hη'prop : ¬∃ c : ℝ, η - η.linear v • ψ = c • ψ := by
        rintro ⟨c, hc⟩
        exact hprop ⟨c + η.linear v, by rw [add_smul, ← hc, sub_add_cancel]⟩
      have h1 : (η - η.linear v • ψ) x = η (affineReflection ψ hv.1 x) := by
        rw [← comp_affineReflection ψ hv.1 η]
        rfl
      have h2 : (η - η.linear v • ψ) z = η z := by
        simp [hz]
      have hs := hsign _ hη'Ψ hη'prop
      rw [h1, h2, ← hsign η hη hprop] at hs
      have := mul_pos_of_sign_eq (hx η hη) hs.symm
      linarith

/-! ### Separating roots -/

/-- The roots taking opposite signs at `x` and `y`. -/
def separatingRoots (Ψ : Set (A →ᵃ[ℝ] ℝ)) (x y : A) : Set (A →ᵃ[ℝ] ℝ) :=
  {η | η ∈ Ψ ∧ η x * η y < 0}

theorem finite_separatingRoots (hΨ : IsLocallyFiniteReflectionArrangement Ψ) (x y : A) :
    (separatingRoots Ψ x y).Finite := by
  refine (hΨ.finite_bounded_at x (fun a => |a (y -ᵥ x)|)).subset ?_
  rintro η ⟨hη, hsep⟩
  refine ⟨hη, ?_⟩
  change |η x| ≤ |η.linear (y -ᵥ x)|
  rw [AffineMap.linearMap_vsub, vsub_eq_sub]
  apply sq_le_sq.mp
  nlinarith [sq_nonneg (η y)]

/-! ### Local signs and generic perturbation -/

theorem eventually_sign_apply_smul_vadd {f : A →ᵃ[ℝ] ℝ} {p : A} (hf : f p ≠ 0) (u : V) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), SignType.sign (f (ε • u +ᵥ p)) = SignType.sign (f p) := by
  have ht : Tendsto (fun ε : ℝ => |ε * f.linear u|) (𝓝 0) (𝓝 0) := by
    have : Continuous (fun ε : ℝ => |ε * f.linear u|) := by fun_prop
    simpa using this.tendsto 0
  filter_upwards [ht.eventually_lt_const (abs_pos.2 hf)] with ε hε
  rw [apply_smul_vadd]
  exact sign_add_eq_of_abs_lt hε

/-- Near `p`, along a fixed direction, no root changes its nonzero sign at `p`. -/
theorem eventually_sign_smul_vadd (hΨ : IsLocallyFiniteReflectionArrangement Ψ) (p : A)
    (u : V) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), ∀ η ∈ Ψ, η p ≠ 0 →
      SignType.sign (η (ε • u +ᵥ p)) = SignType.sign (η p) := by
  have hBf : {η | η ∈ Ψ ∧ |η p| ≤ |η.linear u|}.Finite :=
    hΨ.finite_bounded_at p (fun a => |a u|)
  have h1 : ∀ᶠ ε in 𝓝 (0 : ℝ), ∀ η ∈ {η | η ∈ Ψ ∧ |η p| ≤ |η.linear u|}, η p ≠ 0 →
      SignType.sign (η (ε • u +ᵥ p)) = SignType.sign (η p) := by
    refine (Filter.eventually_all_finite hBf).2 fun η _ => ?_
    by_cases h : η p = 0
    · exact Eventually.of_forall fun _ h' => absurd h h'
    · filter_upwards [eventually_sign_apply_smul_vadd h u] with ε hε _ using hε
  have h2 : ∀ᶠ ε in 𝓝 (0 : ℝ), ε ∈ Set.Ioo (-1 : ℝ) 1 :=
    Ioo_mem_nhds (by norm_num) (by norm_num)
  filter_upwards [h1, h2] with ε h1 h2 η hη hp
  by_cases hηB : |η p| ≤ |η.linear u|
  · exact h1 η ⟨hη, hηB⟩ hp
  · rw [apply_smul_vadd]
    apply sign_add_eq_of_abs_lt
    rw [abs_mul]
    have hε : |ε| ≤ 1 := (abs_lt.2 ⟨h2.1, h2.2⟩).le
    exact lt_of_le_of_lt (mul_le_of_le_one_left (abs_nonneg _) hε) (not_le.1 hηB)

theorem exists_pos_of_eventually {P : ℝ → Prop} (h : ∀ᶠ ε in 𝓝 (0 : ℝ), P ε) :
    ∃ ε, 0 < ε ∧ P ε := by
  obtain ⟨r, hr, hP⟩ := Metric.eventually_nhds_iff.1 h
  refine ⟨r / 2, by positivity, hP ?_⟩
  rw [Real.dist_eq, sub_zero, abs_of_pos (by positivity)]
  linarith

/-- A regular point can be moved inside its chamber off finitely many hyperplanes of
nonconstant affine functionals. -/
theorem exists_facetRel_forall_ne_zero (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {y : A} (hy : IsRegular Ψ y) {F : Set (A →ᵃ[ℝ] ℝ)} (hF : F.Finite)
    (hFl : ∀ f ∈ F, f.linear ≠ 0) : ∃ y', facetRel Ψ y y' ∧ ∀ f ∈ F, f y' ≠ 0 := by
  classical
  obtain ⟨F, rfl⟩ := hF.exists_finset_coe
  clear hF
  induction F using Finset.induction_on with
  | empty => exact ⟨y, (facetRel_equivalence Ψ).refl y, by simp⟩
  | insert f F _ ih =>
    obtain ⟨y₁, hy₁, hF₁⟩ := ih fun g hg => hFl g (by simp [hg])
    have hy₁r := hy.of_facetRel hy₁
    by_cases hf : f y₁ = 0
    · obtain ⟨u, hu⟩ : ∃ u : V, f.linear u ≠ 0 := by
        by_contra h
        simp only [not_exists, not_not] at h
        exact hFl f (by simp) (LinearMap.ext h)
      have hev := (eventually_sign_smul_vadd hΨ y₁ u).and
        ((Filter.eventually_all_finite F.finite_toSet).2 fun g hg =>
          eventually_sign_apply_smul_vadd (hF₁ g hg) u)
      obtain ⟨ε, hε, hsign, hFsign⟩ := exists_pos_of_eventually hev
      refine ⟨ε • u +ᵥ y₁, fun ψ hψ => (hy₁ ψ hψ).trans (hsign ψ hψ (hy₁r ψ hψ)).symm, ?_⟩
      intro g hg
      rw [Finset.coe_insert, Set.mem_insert_iff] at hg
      rcases hg with rfl | hg
      · rw [apply_smul_vadd, hf, zero_add]
        exact mul_ne_zero hε.ne' hu
      · intro h0
        have := hFsign g hg
        rw [h0, sign_zero, eq_comm, sign_eq_zero_iff] at this
        exact hF₁ g hg this
    · refine ⟨y₁, hy₁, fun g hg => ?_⟩
      rw [Finset.coe_insert, Set.mem_insert_iff] at hg
      rcases hg with rfl | hg
      · exact hf
      · exact hF₁ g hg

/-! ### Walls separating two chambers -/

/-- If a root separates the regular points `x` and `y`, some wall reflection at `x`
comes from a root separating them: the first hyperplane met on the segment from `x`
to a generic point of the chamber of `y`. -/
theorem exists_wall (hΨ : IsLocallyFiniteReflectionArrangement Ψ) {x y : A}
    (hx : IsRegular Ψ x) (hy : IsRegular Ψ y) (hne : (separatingRoots Ψ x y).Nonempty) :
    ∃ ψ ∈ Ψ, ∃ (v : V) (hv : IsCoroot Ψ ψ v),
      affineReflection ψ hv.1 ∈ wallReflections Ψ x ∧ ψ x * ψ y < 0 := by
  classical
  have hRf := finite_separatingRoots hΨ x y
  let F : Set (A →ᵃ[ℝ] ℝ) :=
    (fun pq : (A →ᵃ[ℝ] ℝ) × (A →ᵃ[ℝ] ℝ) => pq.1 x • pq.2 - pq.2 x • pq.1) ''
      {pq | pq.1 ∈ separatingRoots Ψ x y ∧ pq.2 ∈ separatingRoots Ψ x y ∧
        ¬∃ c : ℝ, pq.2 = c • pq.1}
  have hFf : F.Finite :=
    ((hRf.prod hRf).subset fun pq hpq => ⟨hpq.1, hpq.2.1⟩).image _
  have hFl : ∀ f ∈ F, f.linear ≠ 0 := by
    rintro _ ⟨⟨ψ, η⟩, ⟨hψ, -, hprop⟩, rfl⟩ hlin
    have hψx : ψ x ≠ 0 := hx ψ hψ.1
    have h0 := eq_zero_of_linear_eq_zero hlin (p := x) (by
      simp only [AffineMap.coe_sub, AffineMap.coe_smul, Pi.sub_apply, Pi.smul_apply,
        smul_eq_mul]
      ring)
    refine hprop ⟨η x / ψ x, ?_⟩
    ext p
    have := congrArg (fun f : A →ᵃ[ℝ] ℝ => f p) h0
    simp only [AffineMap.coe_sub, AffineMap.coe_smul, Pi.sub_apply, Pi.smul_apply,
      smul_eq_mul, AffineMap.coe_zero, Pi.zero_apply] at this ⊢
    field_simp
    linarith
  obtain ⟨y', hyy', hy'F⟩ := exists_facetRel_forall_ne_zero hΨ hy hFf hFl
  have hRy' : ∀ η ∈ Ψ, η x * η y < 0 → η x * η y' < 0 := fun η hη =>
    mul_neg_of_sign_eq rfl (hyy' η hη)
  have hRy : ∀ η ∈ Ψ, η x * η y' < 0 → η x * η y < 0 := fun η hη =>
    mul_neg_of_sign_eq rfl (hyy' η hη).symm
  obtain ⟨ψ, ⟨hψ, hψxy⟩, hmin⟩ :=
    Set.exists_min_image _ (fun η : A →ᵃ[ℝ] ℝ => η x / (η x - η y')) hRf hne
  have hψxy' := hRy' ψ hψ hψxy
  obtain ⟨hden, hT0, hT1⟩ := crossTime_mem hψxy'
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t = ψ x / (ψ x - ψ y') := ⟨_, rfl⟩
  rw [← ht] at hT0 hT1
  have hzη : ∀ η : A →ᵃ[ℝ] ℝ, η (t • (y' -ᵥ x) +ᵥ x) = η x + t * (η y' - η x) := by
    intro η
    rw [apply_smul_vadd, AffineMap.linearMap_vsub, vsub_eq_sub]
  have hψz : ψ (t • (y' -ᵥ x) +ᵥ x) = 0 := by
    rw [hzη, ht]
    field_simp
    ring
  obtain ⟨v, hv⟩ := hΨ.exists_isCoroot ψ hψ
  refine ⟨ψ, hψ, v, hv, mem_wallReflections_of_sign_eq hΨ hψ hv hx hψz ?_, hψxy⟩
  intro η hη hprop
  have hηx := hx η hη
  apply sign_eq_of_not_mul_neg hηx
  · intro hηz
    rw [hzη] at hηz
    obtain ⟨hab, heq⟩ := crossing_eq hηx hT0 hT1 hηz
    have hF : ψ x • η - η x • ψ ∈ F :=
      ⟨(ψ, η), ⟨⟨hψ, hψxy⟩, ⟨hη, hRy η hη hab⟩, hprop⟩, rfl⟩
    apply hy'F _ hF
    simp only [AffineMap.coe_sub, AffineMap.coe_smul, Pi.sub_apply, Pi.smul_apply,
      smul_eq_mul]
    exact cross_mul_eq hden (crossTime_mem hab).1 (ht ▸ heq.symm)
  · intro hneg
    rw [hzη] at hneg
    obtain ⟨hab, hlt⟩ := crossing_lt hηx hT0 hT1 hneg
    have := hmin η ⟨hη, hRy η hη hab⟩
    rw [← ht] at this
    exact absurd this (not_le.2 hlt)

/-- Crossing a separating wall removes it from the separating roots and adds none. -/
theorem separatingRoots_ssubset (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {ψ : A →ᵃ[ℝ] ℝ} (hψ : ψ ∈ Ψ) {v : V} (hv : IsCoroot Ψ ψ v) {x y : A}
    (hx : IsRegular Ψ x) (hy : IsRegular Ψ y)
    (hs : affineReflection ψ hv.1 ∈ wallReflections Ψ x) (hsep : ψ x * ψ y < 0) :
    separatingRoots Ψ (affineReflection ψ hv.1 x) y ⊂ separatingRoots Ψ x y := by
  have hsub : separatingRoots Ψ (affineReflection ψ hv.1 x) y ⊆ separatingRoots Ψ x y := by
    rintro η ⟨hη, hηsep⟩
    refine ⟨hη, ?_⟩
    by_contra hcon
    have hsign := sign_eq_of_not_mul_neg (hx η hη) (hy η hη) hcon
    have hxs : η x * η (affineReflection ψ hv.1 x) < 0 := by
      rw [mul_comm]
      exact mul_neg_of_sign_eq rfl hsign.symm hηsep
    obtain ⟨w, hw⟩ := hΨ.exists_isCoroot η hη
    have heq := hs.2 _ ⟨η, hη, w, hw, rfl, hxs⟩
    obtain ⟨c, hc⟩ :=
      exists_eq_smul_of_affineReflection_eq (hΨ.linear_ne_zero ψ hψ) hv.1 hw.1 heq
    have hpos := mul_pos_of_sign_eq (hx η hη) hsign
    have : η x * η y = c ^ 2 * (ψ x * ψ y) := by
      rw [hc]
      simp only [AffineMap.coe_smul, Pi.smul_apply, smul_eq_mul]
      ring
    nlinarith [sq_nonneg c]
  refine (Set.ssubset_iff_of_subset hsub).2 ⟨ψ, ⟨hψ, hsep⟩, fun h => ?_⟩
  have := h.2
  rw [apply_affineReflection] at this
  linarith

/-! ### Galleries -/

/-- Every regular point is facet-related to the image of `x` under the subgroup
generated by the wall reflections at `x`. -/
theorem exists_facetRel (hΨ : IsLocallyFiniteReflectionArrangement Ψ) {x : A}
    (hx : IsRegular Ψ x) {y : A} (hy : IsRegular Ψ y) :
    ∃ w ∈ Subgroup.closure (wallReflections Ψ x), facetRel Ψ (w x) y := by
  suffices H : ∀ n : ℕ, ∀ w ∈ Subgroup.closure (wallReflections Ψ x),
      (separatingRoots Ψ (w x) y).ncard = n →
        ∃ w' ∈ Subgroup.closure (wallReflections Ψ x), facetRel Ψ (w' x) y from
    H _ 1 (Subgroup.one_mem _) rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro w hw hn
  have hwst := mem_rootStabilizer_of_mem_closure hw
  have hwx := hx.apply hwst
  by_cases hne : (separatingRoots Ψ (w x) y).Nonempty
  · obtain ⟨ψ, hψ, v, hv, hs, hsep⟩ := exists_wall hΨ hwx hy hne
    have hsw : affineReflection ψ hv.1 * w ∈ Subgroup.closure (wallReflections Ψ x) := by
      have h1 := conj_mem_wallReflections (inv_mem hwst) hs
      rw [inv_inv, show w⁻¹ (w x) = x from w.symm_apply_apply x] at h1
      have : affineReflection ψ hv.1 * w = w * (w⁻¹ * affineReflection ψ hv.1 * w) := by
        group
      rw [this]
      exact mul_mem hw (Subgroup.subset_closure h1)
    have hlt : (separatingRoots Ψ ((affineReflection ψ hv.1 * w) x) y).ncard < n := by
      rw [← hn]
      exact Set.ncard_lt_ncard (separatingRoots_ssubset hΨ hψ hv hwx hy hs hsep)
        (finite_separatingRoots hΨ _ _)
    exact ih _ hlt _ hsw rfl
  · refine ⟨w, hw, fun η hη => sign_eq_of_not_mul_neg (hwx η hη) (hy η hη) fun h => hne ?_⟩
    exact ⟨η, hη, h⟩

/-! ### Generation by wall reflections -/

/-- Every coroot reflection lies in the subgroup generated by the wall reflections
at `x`. -/
theorem affineReflection_mem_closure (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {x : A} (hx : IsRegular Ψ x) {ψ : A →ᵃ[ℝ] ℝ} (hψ : ψ ∈ Ψ) {v : V}
    (hv : IsCoroot Ψ ψ v) :
    affineReflection ψ hv.1 ∈ Subgroup.closure (wallReflections Ψ x) := by
  classical
  have hsst : affineReflection ψ hv.1 ∈ rootStabilizer Ψ :=
    affineReflection_mem_rootStabilizer hv
  let g : (A →ᵃ[ℝ] ℝ) → (A →ᵃ[ℝ] ℝ) := fun η => η - (η.linear v / 2) • ψ
  have hg : ∀ η p, g η p = η p - η.linear v / 2 * ψ p := fun η p => by
    simp only [g, AffineMap.coe_sub, AffineMap.coe_smul, Pi.sub_apply, Pi.smul_apply,
      smul_eq_mul]
  let F : Set (A →ᵃ[ℝ] ℝ) :=
    g '' {η | η ∈ separatingRoots Ψ x (affineReflection ψ hv.1 x) ∧ (g η).linear ≠ 0}
  have hFf : F.Finite :=
    ((finite_separatingRoots hΨ x (affineReflection ψ hv.1 x)).subset
      fun η hη => hη.1).image g
  have hFl : ∀ f ∈ F, f.linear ≠ 0 := by
    rintro _ ⟨η, hη, rfl⟩
    exact hη.2
  obtain ⟨x', hxx', hx'F⟩ := exists_facetRel_forall_ne_zero hΨ hx hFf hFl
  have hx' := hx.of_facetRel hxx'
  have hsxx' : facetRel Ψ (affineReflection ψ hv.1 x) (affineReflection ψ hv.1 x') :=
    (facetRel_apply_iff hsst x x').2 hxx'
  -- `m` is the midpoint of `x'` and its reflection, a generic point of the hyperplane.
  obtain ⟨m, hm⟩ : ∃ m : A, m = (-(ψ x') / 2) • v +ᵥ x' := ⟨_, rfl⟩
  have hgm : ∀ η : A →ᵃ[ℝ] ℝ, η m = g η x' := by
    intro η
    rw [hm, apply_smul_vadd, hg]
    ring
  have hψm : ψ m = 0 := by
    rw [hgm, hg, hv.1]
    ring
  have hmne : ∀ η ∈ Ψ, (¬∃ c : ℝ, η = c • ψ) → η m ≠ 0 := by
    intro η hη hprop hηm
    by_cases hlin : (g η).linear = 0
    · refine hprop ⟨η.linear v / 2, ?_⟩
      have := eq_zero_of_linear_eq_zero hlin (p := x') (by rw [← hgm]; exact hηm)
      exact sub_eq_zero.1 this
    · have hηR : η ∈ separatingRoots Ψ x (affineReflection ψ hv.1 x) := by
        refine ⟨hη, ?_⟩
        have h0 := hgm η
        rw [hηm, hg] at h0
        have h1 : η (affineReflection ψ hv.1 x') = -η x' := by
          rw [affineReflection_apply, AffineMap.map_vadd, map_smul, smul_eq_mul, vadd_eq_add]
          linarith
        have h2 : η x' * η (affineReflection ψ hv.1 x') < 0 := by
          rw [h1]
          have := mul_self_pos.2 (hx' η hη)
          linarith
        exact mul_neg_of_sign_eq (hxx' η hη).symm (hsxx' η hη).symm h2
      exact hx'F (g η) ⟨η, ⟨hηR, hlin⟩, rfl⟩ (by rw [← hgm]; exact hηm)
  -- A regular point near `m`, off the hyperplane of `ψ`.
  obtain ⟨δ, hδ, hδsign⟩ := exists_pos_of_eventually (eventually_sign_smul_vadd hΨ m v)
  have hx''reg : IsRegular Ψ (δ • v +ᵥ m) := by
    intro η hη
    by_cases hprop : ∃ c : ℝ, η = c • ψ
    · obtain ⟨c, rfl⟩ := hprop
      have hc : c ≠ 0 := by
        rintro rfl
        exact hΨ.linear_ne_zero _ hη (by simp)
      have hψx'' : ψ (δ • v +ᵥ m) = δ * 2 := by
        rw [apply_smul_vadd, hψm, hv.1, zero_add]
      show c * ψ (δ • v +ᵥ m) ≠ 0
      rw [hψx'']
      exact mul_ne_zero hc (by positivity)
    · intro h0
      have := hδsign η hη (hmne η hη hprop)
      rw [h0, sign_zero, eq_comm, sign_eq_zero_iff] at this
      exact hmne η hη hprop this
  have hwall : affineReflection ψ hv.1 ∈ wallReflections Ψ (δ • v +ᵥ m) :=
    mem_wallReflections_of_sign_eq hΨ hψ hv hx''reg hψm fun η hη hprop =>
      hδsign η hη (hmne η hη hprop)
  -- Transport the wall to the chamber of `x` along a gallery.
  obtain ⟨w, hw, hwx⟩ := exists_facetRel hΨ hx hx''reg
  have hwall' := mem_wallReflections_of_facetRel ((facetRel_equivalence Ψ).symm hwx) hwall
  have h1 := conj_mem_wallReflections (inv_mem (mem_rootStabilizer_of_mem_closure hw)) hwall'
  rw [inv_inv, show w⁻¹ (w x) = x from w.symm_apply_apply x] at h1
  have : affineReflection ψ hv.1 =
      w * (w⁻¹ * affineReflection ψ hv.1 * w) * w⁻¹ := by
    group
  rw [this]
  exact mul_mem (mul_mem hw (Subgroup.subset_closure h1)) (inv_mem hw)

end AffineRootSystem.GalleryGeometry

open AffineRootSystem.GalleryGeometry in
/-- Wall reflections at a regular point generate the affine Weyl group, and their
subgroup carries that chamber to every chamber. -/
theorem affineReflectionGalleryGeometry : AffineReflectionGalleryGeometryStatement.{uV, uA} := by
  intro V A _ _ _ Ψ hΨ x hx
  refine ⟨le_antisymm (closure_wallReflections_le x) ((Subgroup.closure_le _).2 ?_),
    fun y hy => ?_⟩
  · rintro _ ⟨ψ, hψ, v, hv, rfl⟩
    exact affineReflection_mem_closure hΨ hx hψ hv
  · obtain ⟨w, hw, h⟩ := exists_facetRel hΨ hx hy
    exact ⟨⟨w, hw⟩, h⟩

end Langlands.Geometry.Building
