import Langlands.Geometry.Building.UnramifiedSharpFixerRootGenerationStatement
import Langlands.Geometry.Building.UnramifiedAffineRootDerivativesStatement
import Langlands.Geometry.Building.IntegerValuationNonnegativeRootGenerators
import Langlands.Geometry.Building.MaximalUnramifiedBuildingExistence
import Langlands.Geometry.Building.QuasiSplitDerivativeAffineRootsProof

/-!
# Sharp-fixer generation by nonnegative affine roots over the maximal unramified field

This module proves `UnramifiedSharpFixerRootGenerationStatement`, KP Lemma 7.4.4(3) over
`K = inertiaFixedField F`. A private auxiliary theorem first proves
`UnramifiedAffineRootDerivativesStatement`, the derivative part `∇Ψ = Φ` of KP
Proposition 6.3.13 over `K`. It specializes the published quasi-split result
`quasiSplitDerivativeAffineRoots` to the actual valuation of `K`. The generation theorem then
follows from the published conditional reduction
`unramifiedSharpFixerRootGeneration_of_derivativeRoots`.

The public theorem for `UnramifiedAffineRootDerivativesStatement` is in the module
`UnramifiedAffineRootDerivativesProof`, so the auxiliary theorem here is private.
-/

noncomputable section

universe u

open AlgebraicGeometry
open Langlands.GroupScheme Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

/-- KP Proposition 6.3.13, derivative part, over `K = inertiaFixedField F`: for every supplied
building datum `C` of an affine `K`-group, the derivatives of the affine roots `Ψ` are exactly
the relative roots `Φ`, multipliable roots and their doubles included. The valuation of `K` is
surjective onto `ℤ` and its valuation ring is henselian. The group is connected reductive, hence
quasi-split over `K`. So the quasi-split result applies to the apartment, centralizer and V 6
datum carried by `C`. Private: the public theorem is in `UnramifiedAffineRootDerivativesProof`.
-/
private theorem derivativeRoots_affineRoots_eq_range_rootForm :
    UnramifiedAffineRootDerivativesStatement.{u} := by
  intro F _ _ _ _ H _ C
  exact quasiSplitDerivativeAffineRoots (inertiaFixedField F) (MaximalUnramified.valuation F)
    (MaximalUnramified.valuation_surjective F)
    (MaximalUnramified.valuationSubring_isHenselian F) H
    (MaximalUnramified.isQuasiSplit F C.isConnectedReductive) C.S C.i C.isMaximalSplitTorus
    C.apartment C.centralizer C.isOmegaCompatible

/-- KP Lemma 7.4.4(3) over `K = inertiaFixedField F`: for every supplied building datum and
every nonempty `Ω ⊆ A(S)`, the sharp fixer `G(K)^♯_Ω` is generated by the affine root groups
`U_ψ` for `ψ ∈ Ψ` nonnegative on `Ω`. -/
theorem unramifiedSharpFixerRootGeneration :
    UnramifiedSharpFixerRootGenerationStatement.{u} :=
  unramifiedSharpFixerRootGeneration_of_derivativeRoots
    derivativeRoots_affineRoots_eq_range_rootForm

end Langlands.Geometry.Building
