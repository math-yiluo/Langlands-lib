import Langlands.Geometry.Building.AffineWeylFacetFixing

/-! # Point stabilizers in the affine Weyl group

For a locally finite reflection arrangement `Ψ`, an element of the affine Weyl group `W(Ψ)` that
fixes a point `p` lies in the subgroup generated by the reflections in the roots of `Ψ` that
vanish at `p`. For a finite non-empty set `s` of points there is a point `z` such that every
affine automorphism fixing `s` pointwise fixes `z`, and every root of `Ψ` vanishing at `z`
vanishes on `s`.
-/

noncomputable section

universe uV uA

namespace Langlands.Geometry.Building.AffineRootSystem

open GalleryGeometry

variable {V : Type uV} {A : Type uA}
  [AddCommGroup V] [Module ℝ V] [AddTorsor V A]
  {Ψ : Set (A →ᵃ[ℝ] ℝ)}

variable (Ψ) in
/-- The reflections `r_ψ` in the roots `ψ ∈ Ψ` with `ψ(p) = 0`. -/
def pointReflections (p : A) : Set (A ≃ᵃ[ℝ] A) :=
  {e | ∃ ψ ∈ Ψ, ψ p = 0 ∧ ∃ (v : V) (hv : IsCoroot Ψ ψ v), e = affineReflection ψ hv.1}

theorem pointReflections_subset_affineWeylGroup (p : A) :
    pointReflections Ψ p ⊆ affineWeylGroup Ψ := by
  rintro _ ⟨ψ, hψ, -, v, hv, rfl⟩
  exact affineReflection_mem_affineWeylGroup hψ hv

theorem closure_pointReflections_le_affineWeylGroup (p : A) :
    Subgroup.closure (pointReflections Ψ p) ≤ affineWeylGroup Ψ :=
  (Subgroup.closure_le _).2 (pointReflections_subset_affineWeylGroup p)

theorem apply_eq_of_mem_closure_pointReflections {p : A} {e : A ≃ᵃ[ℝ] A}
    (he : e ∈ Subgroup.closure (pointReflections Ψ p)) : e p = p := by
  let K : Subgroup (A ≃ᵃ[ℝ] A) :=
    { carrier := {e | e p = p}
      mul_mem' := fun {a b} ha hb => by
        change a (b p) = p
        rw [show b p = p from hb, show a p = p from ha]
      one_mem' := rfl
      inv_mem' := fun {a} ha => by
        change a.symm p = p
        conv_lhs => rw [← show a p = p from ha]
        exact a.symm_apply_apply p }
  have hK : Subgroup.closure (pointReflections Ψ p) ≤ K := by
    refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨ψ, -, hψp, v, hv, rfl⟩
    exact affineReflection_apply_of_mem ψ hv.1 hψp
  exact hK he

/-- Chambers whose closures contain `p` are transported to each other by a product of
reflections in roots vanishing at `p`. -/
theorem exists_facetRel_closure_pointReflections
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    {p x y : A} (hx : IsRegular Ψ x) (hy : IsRegular Ψ y)
    (hpx : p ∈ facetClosure Ψ x) (hpy : p ∈ facetClosure Ψ y) :
    ∃ w ∈ Subgroup.closure (pointReflections Ψ p), facetRel Ψ (w x) y := by
  suffices H : ∀ n : ℕ, ∀ x : A, IsRegular Ψ x →
      p ∈ facetClosure Ψ x → (separatingRoots Ψ x y).ncard = n →
        ∃ w ∈ Subgroup.closure (pointReflections Ψ p), facetRel Ψ (w x) y from
    H _ x hx hpx rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro x hx hpx hn
    by_cases hne : (separatingRoots Ψ x y).Nonempty
    · obtain ⟨ψ, hψ, v, hv, hs, hsep⟩ := exists_wall hΨ hx hy hne
      set s : A ≃ᵃ[ℝ] A := affineReflection ψ hv.1 with hsdef
      have hst : s ∈ rootStabilizer Ψ := affineReflection_mem_rootStabilizer hv
      have hψp : ψ p = 0 := root_eq_zero_of_mem_closures hpx hpy hψ hsep
      have hsmem : s ∈ pointReflections Ψ p := ⟨ψ, hψ, hψp, v, hv, rfl⟩
      have hsp : s p = p := affineReflection_apply_of_mem ψ hv.1 hψp
      have hpsx : p ∈ facetClosure Ψ (s x) := by
        simpa only [hsp] using (mem_facetClosure_apply_iff hst p x).2 hpx
      have hlt : (separatingRoots Ψ (s x) y).ncard < n := by
        rw [← hn]
        exact Set.ncard_lt_ncard (separatingRoots_ssubset hΨ hψ hv hx hy hs hsep)
          (finite_separatingRoots hΨ _ _)
      obtain ⟨w, hw, hwy⟩ := ih _ hlt (s x) (hx.apply hst) hpsx rfl
      exact ⟨w * s, Subgroup.mul_mem _ hw (Subgroup.subset_closure hsmem), hwy⟩
    · refine ⟨1, Subgroup.one_mem _, fun ψ hψ =>
        sign_eq_of_not_mul_neg (hx ψ hψ) (hy ψ hψ) fun h => hne ?_⟩
      exact ⟨ψ, hψ, h⟩

/-- **Point stabilizers.** An element of `W(Ψ)` fixing `p` is a product of reflections in roots
of `Ψ` vanishing at `p`. -/
theorem mem_closure_pointReflections_of_apply_eq
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    (w : affineWeylGroup Ψ) {p : A} (hwp : (w : A ≃ᵃ[ℝ] A) p = p) :
    (w : A ≃ᵃ[ℝ] A) ∈ Subgroup.closure (pointReflections Ψ p) := by
  obtain ⟨x, hx, hpx⟩ := hΨ.exists_regularPoint_closure p
  have hwst := affineWeylGroup_le_rootStabilizer Ψ w.property
  have hpwx : p ∈ facetClosure Ψ ((w : A ≃ᵃ[ℝ] A) x) := by
    have h := (mem_facetClosure_apply_iff hwst p x).2 hpx
    rwa [hwp] at h
  obtain ⟨v, hv, hvx⟩ :=
    exists_facetRel_closure_pointReflections hΨ hx (hx.apply hwst) hpx hpwx
  let v' : affineWeylGroup Ψ := ⟨v, closure_pointReflections_le_affineWeylGroup p hv⟩
  obtain ⟨hgen, -⟩ :=
    Langlands.Geometry.Building.affineReflectionGalleryGeometry V A Ψ hΨ x hx
  have himage : (v : A ≃ᵃ[ℝ] A) '' facet Ψ x = (w : A ≃ᵃ[ℝ] A) '' facet Ψ x := by
    rw [image_facet (affineWeylGroup_le_rootStabilizer Ψ v'.property),
      image_facet hwst]
    exact facet_eq_facet_iff.2 hvx
  have hfix : ((v'⁻¹ * w : affineWeylGroup Ψ) : A ≃ᵃ[ℝ] A) '' facet Ψ x = facet Ψ x := by
    change ((v : A ≃ᵃ[ℝ] A)⁻¹ * (w : A ≃ᵃ[ℝ] A)) '' facet Ψ x = facet Ψ x
    calc
      _ = (v : A ≃ᵃ[ℝ] A).symm '' ((w : A ≃ᵃ[ℝ] A) '' facet Ψ x) := by
        rw [AffineEquiv.coe_mul, AffineEquiv.inv_def]
        exact (Set.image_image (v : A ≃ᵃ[ℝ] A).symm (w : A ≃ᵃ[ℝ] A) (facet Ψ x)).symm
      _ = (v : A ≃ᵃ[ℝ] A).symm '' ((v : A ≃ᵃ[ℝ] A) '' facet Ψ x) := by rw [himage]
      _ = facet Ψ x := by
        rw [Set.image_image]
        simp only [AffineEquiv.symm_apply_apply]
        exact Set.image_id _
  have heq := chamber_stabilizer_eq_one
    Langlands.Geometry.Building.ReflectionGallery.reflectionGalleryFreeness
    (⟨facet Ψ x, ⟨x, hx, rfl⟩⟩ : Chambers Ψ) (mem_facet_self Ψ x) hgen (v'⁻¹ * w) hfix
  have hvw : v' = w := inv_mul_eq_one.mp heq
  rw [← hvw]
  exact hv

/-- **A generic point of a finite set.** For a finite non-empty set `s` there is a point `z`
fixed by every affine automorphism fixing `s` pointwise, such that every root of `Ψ` vanishing
at `z` vanishes on `s`. -/
theorem exists_generic_point (hΨ : IsLocallyFiniteReflectionArrangement Ψ)
    (s : Finset A) (hs : s.Nonempty) :
    ∃ z : A, (∀ e : A ≃ᵃ[ℝ] A, (∀ y ∈ s, e y = y) → e z = z) ∧
      ∀ ψ ∈ Ψ, ψ z = 0 → ∀ y ∈ s, ψ y = 0 := by
  classical
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a =>
    refine ⟨a, fun e he => he a (Finset.mem_singleton_self a), fun ψ _ hψ y hy => ?_⟩
    rw [Finset.mem_singleton.1 hy]
    exact hψ
  | cons a s ha hs ih =>
    obtain ⟨z, hzfix, hzgen⟩ := ih
    obtain ⟨ε, hε, hsign⟩ := exists_pos_of_eventually
      (eventually_sign_smul_vadd hΨ z (a -ᵥ z))
    refine ⟨ε • (a -ᵥ z) +ᵥ z, fun e he => ?_, fun ψ hψ hψz y hy => ?_⟩
    · have hez : e z = z := hzfix e fun y hy => he y (Finset.mem_cons_of_mem hy)
      have hea : e a = a := he a (Finset.mem_cons_self a s)
      have hlin : e.linear (a -ᵥ z) = e a -ᵥ e z :=
        AffineMap.linearMap_vsub (e : A →ᵃ[ℝ] A) a z
      rw [AffineEquiv.map_vadd, map_smul, hlin, hea, hez]
    · have hz0 : ψ z = 0 := by
        by_contra hz
        have h := hsign ψ hψ hz
        rw [hψz, sign_zero, eq_comm, sign_eq_zero_iff] at h
        exact hz h
      have ha0 : ψ a = 0 := by
        rw [apply_smul_vadd, hz0, zero_add, AffineMap.linearMap_vsub, hz0, vsub_eq_sub,
          sub_zero] at hψz
        exact (mul_eq_zero.1 hψz).resolve_left hε.ne'
      rcases Finset.mem_cons.1 hy with rfl | hy
      · exact ha0
      · exact hzgen ψ hψ hz0 y hy

end Langlands.Geometry.Building.AffineRootSystem
