import Langlands.GroupScheme.Rational.ValuedBoundedProducts
import Langlands.Geometry.Building.IntegerValuationBuildingData
import Langlands.Geometry.Building.GenericSpecialFixedPoint
import Langlands.Geometry.Building.RootCharacterValuationKernel
import Langlands.Geometry.Building.NormalizerNormOneFixerBoundedness
import Langlands.GroupScheme.Rational.RelativeWeylSpanFiniteness
import Langlands.Geometry.Building.IntegerCentralizerStabilizer

/-! # Boundedness of one-stabilizers for integer-valued building data -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace
open Langlands.AlgebraicGeometry.PointTopology Langlands.Plancherel
open Langlands.LinearAlgebra.RationalSpan Langlands.BruhatTits

namespace Langlands.Geometry.Building.IntegerValuationBuildingData

variable {k : Type u} [Field k]
  {v : Valuation k (WithZero (Multiplicative ℤ))}
  {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
  (C : IntegerValuationBuildingData v G)

/-! ### Kernel inclusions -/

/-- The sharp fixer of any subset of the apartment lies in `G(k)^1`: it is generated by
subgroups of root groups, on which every rational character is one. -/
theorem sharpFixer_le_characterValuationKernel (Ω : Set C.Apartment) :
    C.sharpFixer Ω ≤ characterValuationKernel v G :=
  iSup_le fun α => inf_le_left.trans
    (rootGroupPoints_le_characterValuationKernel C.isMaximalSplitTorus.isSplitSubtorus.1
      C.i α α.2.1 v)

/-- The norm-one stabilizer `N(k)^1_x = G(k)^1 ∩ N(k)_x` of a point of the apartment, as a
subgroup of `G(k)`. -/
def normOneNormalizerStabilizer (x : C.Apartment) : Subgroup (rationalPoints G) :=
  characterValuationKernel v G ⊓
    (MulAction.stabilizer (normalizerPoints C.i) x).map (normalizerPoints C.i).subtype

theorem mem_normOneNormalizerStabilizer {x : C.Apartment} {g : rationalPoints G} :
    g ∈ C.normOneNormalizerStabilizer x ↔
      g ∈ characterValuationKernel v G ∧
        ∃ n : normalizerPoints C.i, (n : rationalPoints G) = g ∧ n • x = x := by
  simp only [normOneNormalizerStabilizer, Subgroup.mem_inf, Subgroup.mem_map,
    MulAction.mem_stabilizer_iff, Subgroup.coe_subtype]
  exact Iff.rfl.and ⟨fun ⟨n, hn, h⟩ => ⟨n, h, hn⟩, fun ⟨n, h, hn⟩ => ⟨n, hn, h⟩⟩

/-! ### The cover of a point one-stabilizer (KP Proposition 7.3.12, Corollary 7.3.14) -/

/-- The subgroup `U_x(ν)` generated by the depth-zero root groups at `x` of the roots positive
on `ν`. -/
abbrev positiveZeroRootGroups (x : C.Apartment) (ν : cocharacterLattice C.S) :
    Subgroup (rationalPoints G) :=
  ⨆ b : positiveRelativeRoots C.i ν, C.apartment.chamberRootGroup x false b

/-- For a generic cocharacter `mu`, `K_x ⊆ U_x(-mu) U_x(mu) N(k)^1_x` for every point `x` of
the apartment. -/
theorem oneStabilizer_apartmentMap_subset (x : C.Apartment) (mu : cocharacterLattice C.S)
    (hmu : IsGenericCocharacter C.i mu) :
    (C.oneStabilizer (C.apartmentMap x) : Set (rationalPoints G)) ⊆
      (C.positiveZeroRootGroups x (-mu) : Set (rationalPoints G)) *
        (C.positiveZeroRootGroups x mu : Set (rationalPoints G)) *
        (C.normOneNormalizerStabilizer x : Set (rationalPoints G)) := by
  intro g hg
  obtain ⟨hg1, hgx⟩ := C.mem_oneStabilizer.mp hg
  obtain ⟨n, hnx, p, hp, rfl⟩ :=
    (ApartmentQuotient.mem_stabilizer_apartment_iff C.apartment.sharpFixerFamily x g).1
      (MulAction.mem_stabilizer_iff.2 hgx)
  have hp1 : p ∈ characterValuationKernel v G := C.sharpFixer_le_characterValuationKernel {x} hp
  have hn1 : (n : rationalPoints G) ∈ characterValuationKernel v G := by
    have h := (characterValuationKernel v G).mul_mem
      ((characterValuationKernel v G).inv_mem hp1) hg1
    rwa [inv_mul_cancel_left] at h
  obtain ⟨uw, ⟨u, hu, w, hw, rfl⟩, h, hh, hph⟩ :=
    C.apartment.sharpFixer_subset_mul_sharpNormalizerStabilizer C.isConnectedReductive
      C.isMaximalSplitTorus x mu hmu hp
  change u * w * h = p at hph
  obtain ⟨hhS, hhN, hhx⟩ := KPApartmentData.mem_sharpNormalizerStabilizer.mp hh
  have hh1 : h ∈ characterValuationKernel v G := C.sharpFixer_le_characterValuationKernel {x} hhS
  let n' : normalizerPoints C.i := ⟨h, hhN⟩ * n
  have hn' : (n' : rationalPoints G) = h * n := Subgroup.coe_mul _ _ _
  refine ⟨u * w, ⟨u, hu, w, hw, rfl⟩, h * n, ?_, ?_⟩
  · refine C.mem_normOneNormalizerStabilizer.mpr
      ⟨(characterValuationKernel v G).mul_mem hh1 hn1, ⟨n', hn', ?_⟩⟩
    rw [mul_smul, hnx]
    exact hhx
  · change u * w * (h * n) = p * n
    rw [← hph, mul_assoc (u * w)]

/-! ### Boundedness of the factors -/

variable [ValuativeRel k]

local instance oneStabilizerBoundedAffine : IsAffine G.X.left :=
  isAffine_of_isAffineHom G.X.hom

/-- If every depth-zero root group at `x` is bounded, then so is the subgroup they generate
for the roots positive on `ν`: it is the image of an ordered product. -/
theorem isAlgebraicallyBounded_positiveZeroRootGroups (x : C.Apartment)
    (ν : cocharacterLattice C.S)
    (hU : ∀ a ∈ relativeRoots C.i,
      IsAlgebraicallyBounded k G.X (C.filtration x a 0 : Set (rationalPoints G))) :
    IsAlgebraicallyBounded k G.X (C.positiveZeroRootGroups x ν : Set (rationalPoints G)) := by
  let : Smooth G.X.hom := C.isConnectedReductive.smooth
  have hS : IsSplitTorus C.S.toGrp := C.isMaximalSplitTorus.isSplitSubtorus.1
  have hfinite : (positiveRelativeRoots C.i ν).Finite :=
    (hS.finite_relativeRoots C.i).subset (fun _ ha => ha.1)
  obtain ⟨n, a, -, hrange⟩ := hfinite.fin_param
  have hmem (j : Fin n) : a j ∈ relativeRoots C.i :=
    (show a j ∈ positiveRelativeRoots C.i ν from hrange ▸ Set.mem_range_self j).1
  rw [positiveZeroRootGroups, C.apartment.iSup_chamberRootGroup_enum hrange x false,
    ← Langlands.GroupTheory.HeightCollection.range_orderedProduct_eq_iSup _
      (fun j => (latticePairing C.S (a j) ν).toNat)
      (C.apartment.commutator_chamberRootGroup_enum hrange x false)]
  exact isAlgebraicallyBounded_range_orderedProduct_of_finiteType _ fun j => hU (a j) (hmem j)

omit [ValuativeRel k] in
/-- `N(k)^1_x` lies in finitely many translates of `j(Z(k)^1)`, one for each class of
`N(k)/Z(k)`. -/
theorem normOneNormalizerStabilizer_subset_iUnion (x : C.Apartment) :
    ∃ r : relativeWeylGroup C.i → rationalPoints G,
      (C.normOneNormalizerStabilizer x : Set (rationalPoints G)) ⊆
        ⋃ w, r w • (rationalPoints.map C.centralizer.j ''
          (characterValuationKernel v C.centralizer.Z :
            Set (rationalPoints C.centralizer.Z))) := by
  classical
  let P : relativeWeylGroup C.i → normalizerPoints C.i → Prop := fun w n =>
    (QuotientGroup.mk n : relativeWeylGroup C.i) = w ∧
      (n : rationalPoints G) ∈ characterValuationKernel v G ∧ n • x = x
  refine ⟨fun w => if h : ∃ n, P w n then (h.choose : rationalPoints G) else 1, ?_⟩
  intro g hg
  obtain ⟨hg1, n, rfl, hnx⟩ := (C.mem_normOneNormalizerStabilizer).mp hg
  set w : relativeWeylGroup C.i := QuotientGroup.mk n
  have h : ∃ m, P w m := ⟨n, rfl, hg1, hnx⟩
  obtain ⟨hmw, hm1, hmx⟩ := h.choose_spec
  set m := h.choose
  refine Set.mem_iUnion.mpr ⟨w, ?_⟩
  beta_reduce
  rw [dite_eq_left h]
  have hc : ((m⁻¹ * n : normalizerPoints C.i) : rationalPoints G) ∈ centralizerPoints C.i := by
    rw [← Subgroup.mem_subgroupOf]
    exact QuotientGroup.eq.mp hmw
  rw [← torusCentralizer_carrier_base, ← C.centralizer.isRepresentedBy.2] at hc
  obtain ⟨z, hjz⟩ : ∃ z : rationalPoints C.centralizer.Z, rationalPoints.map C.centralizer.j z =
      ((m⁻¹ * n : normalizerPoints C.i) : rationalPoints G) := by
    obtain ⟨z, hz⟩ := hc
    exact ⟨z, hz⟩
  have hz1 : z ∈ characterValuationKernel v C.centralizer.Z := by
    refine C.mem_characterValuationKernel_of_smul_eq (z := z) ?_ (x := x) ?_
    · rw [hjz, Subgroup.coe_mul, Subgroup.coe_inv]
      exact mul_mem (inv_mem hm1) hg1
    · have hzn : C.centralizer.toNormalizer z = m⁻¹ * n := Subtype.ext hjz
      rw [hzn, mul_smul, hnx, inv_smul_eq_iff, hmx]
  refine ⟨rationalPoints.map C.centralizer.j z, ⟨z, hz1, rfl⟩, ?_⟩
  show (m : rationalPoints G) * rationalPoints.map C.centralizer.j z = n
  rw [hjz, Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_cancel_left]

/-- If `j(Z(k)^1)` is bounded, then so is `N(k)^1_x` for every point `x` of the apartment. -/
theorem isAlgebraicallyBounded_normOneNormalizerStabilizer
    (hZ : IsAlgebraicallyBounded k G.X (rationalPoints.map C.centralizer.j ''
      (characterValuationKernel v C.centralizer.Z : Set (rationalPoints C.centralizer.Z))))
    (x : C.Apartment) :
    IsAlgebraicallyBounded k G.X
      (C.normOneNormalizerStabilizer x : Set (rationalPoints G)) := by
  let : Smooth G.X.hom := C.isConnectedReductive.smooth
  have := (C.isMaximalSplitTorus.isSplitSubtorus.1).finite_relativeWeylGroup_of_span C.i
    (relativeRootsRestrictedCharactersSpan k G C.isConnectedReductive C.S C.i
      C.isMaximalSplitTorus)
  obtain ⟨r, hr⟩ := C.normOneNormalizerStabilizer_subset_iUnion x
  exact (isAlgebraicallyBounded_iUnion fun w =>
    isAlgebraicallyBounded_smul_set_of_finiteType hZ (r w)).mono hr

/-! ### The main reduction -/

/-- KP Theorem 4.2.15(1), boundedness half, over an arbitrary field with an integer-valued
valuation and any valuative relation: if `j(Z(k)^1)` and every depth-zero root group
`U_{a,x,0}` are algebraically bounded, then so is every one-stabilizer `K_y`. -/
theorem isAlgebraicallyBounded_oneStabilizer
    (hZ : IsAlgebraicallyBounded k G.X (rationalPoints.map C.centralizer.j ''
      (characterValuationKernel v C.centralizer.Z : Set (rationalPoints C.centralizer.Z))))
    (hU : ∀ (x : C.Apartment), ∀ a ∈ relativeRoots C.i,
      IsAlgebraicallyBounded k G.X (C.filtration x a 0 : Set (rationalPoints G)))
    (y : C.ReducedBuilding) :
    IsAlgebraicallyBounded k G.X (C.oneStabilizer y : Set (rationalPoints G)) := by
  let : Smooth G.X.hom := C.isConnectedReductive.smooth
  obtain ⟨mu, hmu⟩ := C.isMaximalSplitTorus.isSplitSubtorus.1.exists_genericCocharacter C.i
  obtain ⟨g, x, rfl⟩ := C.exists_smul_apartmentMap y
  have hx : IsAlgebraicallyBounded k G.X
      (C.oneStabilizer (C.apartmentMap x) : Set (rationalPoints G)) :=
    (isAlgebraicallyBounded_mul_of_finiteType
      (isAlgebraicallyBounded_mul_of_finiteType
        (C.isAlgebraicallyBounded_positiveZeroRootGroups x (-mu) (hU x))
        (C.isAlgebraicallyBounded_positiveZeroRootGroups x mu (hU x)))
      (C.isAlgebraicallyBounded_normOneNormalizerStabilizer hZ x)).mono
      (C.oneStabilizer_apartmentMap_subset x mu hmu)
  refine (isAlgebraicallyBounded_conj_of_finiteType hx g).mono ?_
  intro h hh
  obtain ⟨hh1, hhy⟩ := C.mem_oneStabilizer.mp hh
  have hc : g⁻¹ * h * g ∈ C.oneStabilizer (C.apartmentMap x) := by
    refine C.mem_oneStabilizer.mpr ⟨?_, ?_⟩
    · simpa only [inv_inv] using
        (characterValuationKernel_normal v G).conj_mem h hh1 g⁻¹
    · rw [mul_smul, mul_smul, hhy, inv_smul_smul]
  refine ⟨g * (g⁻¹ * h * g), ⟨g, rfl, g⁻¹ * h * g, hc, rfl⟩, g⁻¹, rfl, ?_⟩
  group

end Langlands.Geometry.Building.IntegerValuationBuildingData
