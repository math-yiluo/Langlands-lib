import Langlands.Geometry.Building.ParahoricBuildingAxioms
import Langlands.Geometry.Building.AffineRootDoubling
import Langlands.Geometry.Building.ActualAffineRootLocalFiniteness
import Langlands.Geometry.Building.ChamberIwahoriProof

/-!
# `P_Ω` is generated by `Z(F)^0` and the `U_ψ` with `ψ ∈ Ψ` non-negative on `Ω`

KP Lemma 7.4.4(3): for `P : ParahoricBuildingData G` satisfying the apartment axioms and any
`Ω ⊆ A(S)`, `P_Ω = Z(F)^0 · G(F)^♯_Ω` is the subgroup `P.nonnegativeRootSubgroup Ω` generated by
`Z(F)^0` and the groups `U_ψ` for `ψ ∈ Ψ` with `ψ(Ω) ⊆ ℝ_{≥0}`.

* `AffineRootSystem.IsAffineRootSystemWithRankZero.exists_le_apply`: the roots of an affine root
  system with a given derivative take arbitrarily large values at every point.
* `ParahoricBuildingData.affineRootGroup_le_nonnegativeRootSubgroup_of_not_double`: for a root
  `b` with `2b ∉ Φ`, `U_φ ⊆ P.nonnegativeRootSubgroup Ω` when `φ` has derivative `b` and is
  non-negative on `Ω`.
* `ParahoricBuildingData.affineRootGroup_le_nonnegativeRootSubgroup_of_double`: the same for a
  root `a` with `2a ∈ Φ`, using the groups `U_ψ` of `2a`.
* `ParahoricBuildingData.parahoric_eq_nonnegativeRootSubgroup`: KP Lemma 7.4.4(3).
* `ParahoricNonnegativeRootGenerationStatement` and its proof
  `parahoricNonnegativeRootGeneration`: the same lemma as a proposition over all supplied data.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped Pointwise CategoryTheory.MonObj
open Langlands.GroupScheme

namespace Langlands.Geometry.Building

namespace AffineRootSystem

universe uV uA

variable {V : Type uV} {A : Type uA} [AddCommGroup V] [Module ℝ V] [AddTorsor V A]

/-- The roots of an affine root system with a given derivative are unbounded above at every
point: for `ψ ∈ Ψ`, `x ∈ A` and `M ∈ ℝ` some `θ ∈ Ψ` with `θ̇ = ψ̇` has `θ(x) ≥ M`. Otherwise
the reflection `θ ↦ 2ψ - θ` of the fiber (AR 2 and `-Ψ = Ψ`) would bound the whole fiber, which
is infinite (AR 4). -/
theorem IsAffineRootSystemWithRankZero.exists_le_apply {Ψ : Set (A →ᵃ[ℝ] ℝ)}
    (hΨ : IsAffineRootSystemWithRankZero Ψ) {ψ : A →ᵃ[ℝ] ℝ} (hψ : ψ ∈ Ψ) (x : A) (M : ℝ) :
    ∃ θ ∈ Ψ, θ.linear = ψ.linear ∧ M ≤ θ x := by
  by_contra hcon
  push Not at hcon
  obtain ⟨v, hv⟩ := hΨ.exists_isCoroot ψ hψ
  refine hΨ.infinite_fiber ψ hψ ((hΨ.finite_bounded ψ hψ |M - ψ x|).subset ?_)
  rintro θ ⟨hθ, hθψ⟩
  refine ⟨hθ, hθψ, fun y => ?_⟩
  have h2 : θ.linear v = 2 := by rw [hθψ]; exact hv.1
  have hrefl : -(θ - θ.linear v • ψ) ∈ Ψ := hΨ.neg_mem (hv.2 θ hθ)
  have hrefl_lin : (-(θ - θ.linear v • ψ)).linear = ψ.linear := by
    rw [AffineMap.neg_linear, AffineMap.sub_linear, AffineMap.smul_linear, h2, hθψ, two_smul]
    abel
  have hlow := hcon _ hrefl hrefl_lin
  have hup := hcon θ hθ hθψ
  simp only [AffineMap.coe_neg, AffineMap.coe_sub, AffineMap.coe_smul, Pi.neg_apply,
    Pi.sub_apply, Pi.smul_apply, smul_eq_mul, h2] at hlow
  have hc := apply_eq_apply_of_linear_eq_zero (f := θ - ψ)
    (by rw [AffineMap.sub_linear, hθψ, sub_self]) y x
  simp only [AffineMap.coe_sub, Pi.sub_apply] at hc
  rw [hc]
  exact abs_le.2 ⟨by linarith [le_abs_self (M - ψ x)], by linarith [le_abs_self (M - ψ x)]⟩

end AffineRootSystem

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- A generator of `P.nonnegativeRootSubgroup Ω`: `U_ψ` for `ψ ∈ Ψ` with derivative `a` and
`ψ(Ω) ⊆ ℝ_{≥0}`. -/
theorem affineRootGroup_le_nonnegativeRootSubgroup {Ω : Set P.Apartment}
    {α : relativeRoots P.i} {ψ : P.Apartment →ᵃ[ℝ] ℝ} (hψ : ψ ∈ P.affineRoots)
    (hlin : ψ.linear = rootForm P.i α) (hΩ : ∀ x ∈ Ω, 0 ≤ ψ x) :
    P.affineRootGroup α ψ ≤ P.nonnegativeRootSubgroup Ω := by
  intro g hg
  refine Subgroup.mem_sup_right (Subgroup.subset_closure ?_)
  simp only [Set.mem_iUnion]
  exact ⟨α, ψ, hψ, hlin, hΩ, hg⟩

/-- Two affine functionals with the same derivative compare in the same way at every point. -/
private theorem le_of_linear_eq {f g : P.Apartment →ᵃ[ℝ] ℝ} (h : f.linear = g.linear)
    {x₀ : P.Apartment} (hx₀ : f x₀ ≤ g x₀) (x : P.Apartment) : f x ≤ g x := by
  have hc := AffineRootSystem.apply_eq_apply_of_linear_eq_zero (f := g - f)
    (by rw [AffineMap.sub_linear, h, sub_self]) x x₀
  simp only [AffineMap.coe_sub, Pi.sub_apply] at hc
  linarith

/-- `u ∈ U_ψ` for `ψ = ψ^u_a` and `u ∈ U_a(F) ∖ {1}`. -/
theorem mem_affineRootGroup_reflectionFunctional {α : relativeRoots P.i}
    {g : rationalPoints G} (hg : g ∈ P.rootGroup α) (hg1 : g ≠ 1) :
    g ∈ P.affineRootGroup α (P.reflectionFunctional α g) :=
  (P.mem_affineRootGroup_iff_reflectionFunctional (P.reflectionFunctional_linear α g)).2
    (Or.inr ⟨hg, hg1, fun _ => le_rfl⟩)

/-- A root `b` with `2b ∉ Φ`: if `φ` has derivative `b` and is non-negative on `Ω`, then
`U_φ ⊆ P.nonnegativeRootSubgroup Ω`. Each `u ∈ U_φ ∖ {1}` lies in `U_ψ` for `ψ = ψ^u_b ≥ φ`,
and `ψ ∈ Ψ′` is in `Ψ` since `2b` is not a root. -/
theorem affineRootGroup_le_nonnegativeRootSubgroup_of_not_double {Ω : Set P.Apartment}
    {β : relativeRoots P.i} (h2b : 2 • (β : characterLattice P.S) ∉ relativeRoots P.i)
    {φ : P.Apartment →ᵃ[ℝ] ℝ} (hlin : φ.linear = rootForm P.i β) (hΩ : ∀ x ∈ Ω, 0 ≤ φ x) :
    P.affineRootGroup β φ ≤ P.nonnegativeRootSubgroup Ω := by
  intro g hg
  rcases (P.mem_affineRootGroup_iff_reflectionFunctional hlin).1 hg with rfl | ⟨hgβ, hg1, hge⟩
  · exact (P.nonnegativeRootSubgroup Ω).one_mem
  have hψlin := P.reflectionFunctional_linear β g
  have hjump : P.apartment.affineRootGroupPlus β (P.reflectionFunctional β g) ≠
      P.apartment.affineRootGroup β (P.reflectionFunctional β g) := by
    intro heq
    have x : P.Apartment := Classical.arbitrary P.Apartment
    have hmem := P.mem_affineRootGroup_reflectionFunctional hgβ hg1
    change g ∈ P.apartment.affineRootGroup β (P.reflectionFunctional β g) at hmem
    rw [← heq, KPApartmentData.mem_affineRootGroupPlus_iff hψlin x,
      P.coe_reflectionFunctional_apply hgβ hg1 x] at hmem
    exact lt_irrefl _ hmem.2
  exact P.affineRootGroup_le_nonnegativeRootSubgroup
    (KPApartmentData.mem_affineRoots_of_not_double_root P.apartment h2b hψlin hjump) hψlin
    (fun x hx => (hΩ x hx).trans (hge x)) (P.mem_affineRootGroup_reflectionFunctional hgβ hg1)

/-- A root `a` with `2a ∈ Φ`: if `φ` has derivative `a` and is non-negative on `Ω`, then
`U_φ ⊆ P.nonnegativeRootSubgroup Ω`. Suppose not, and take a bad `v ∈ U_φ` for which `ψ^v_a`
is largest (there are finitely many values between `φ` and a root `ψ ∈ Ψ` above `φ`, whose
`U_ψ` is a generator). If `ψ^v_a ∉ Ψ`, then `v = v′ w` with `v′ ∈ U_{ψ^v_a +}` and
`w ∈ U_{2a, 2ψ^v_a}`; `w` is in the subgroup since `4a ∉ Φ`, so `v′` is bad and larger. -/
theorem affineRootGroup_le_nonnegativeRootSubgroup_of_double
    (hP : P.SatisfiesApartmentAxioms) {Ω : Set P.Apartment} {α : relativeRoots P.i}
    (h2a : 2 • (α : characterLattice P.S) ∈ relativeRoots P.i)
    {φ : P.Apartment →ᵃ[ℝ] ℝ} (hlin : φ.linear = rootForm P.i α) (hΩ : ∀ x ∈ Ω, 0 ≤ φ x) :
    P.affineRootGroup α φ ≤ P.nonnegativeRootSubgroup Ω := by
  classical
  have : Smooth G.X.hom := P.isConnectedReductive.smooth
  have hF := P.hasOppositeFactorPairs
  have hS : IsSplitTorus P.S.toGrp := P.isMaximalSplitTorus.isSplitSubtorus.1
  have h4a : 2 • (2 • (α : characterLattice P.S)) ∉ relativeRoots P.i := by
    simpa only [smul_smul, show (2 : ℕ) * 2 = 4 from rfl] using
      KPApartmentData.no_quadruple_root_of_oppositePairs hS hF α α.property
  set H := P.nonnegativeRootSubgroup Ω with hH
  have x₀ : P.Apartment := Classical.arbitrary P.Apartment
  -- A root `ψ_top ∈ Ψ` with derivative `a` lying above `φ`.
  obtain ⟨ψ₁, hψ₁, hψ₁lin⟩ : ∃ ψ₁ ∈ P.affineRoots, ψ₁.linear = rootForm P.i α := by
    have h : rootForm P.i α ∈ AffineRootSystem.derivativeRoots P.affineRoots := by
      rw [hP.derivativeRoots_affineRoots]
      exact ⟨α, rfl⟩
    exact AffineRootSystem.mem_derivativeRoots.1 h
  obtain ⟨ψt, hψt, hψtlin, hψtx⟩ :=
    hP.isAffineRootSystem_affineRoots.exists_le_apply hψ₁ x₀ (φ x₀)
  rw [hψ₁lin] at hψtlin
  have htopH : P.affineRootGroup α ψt ≤ H :=
    P.affineRootGroup_le_nonnegativeRootSubgroup hψt hψtlin fun x hx =>
      (hΩ x hx).trans (P.le_of_linear_eq (hlin.trans hψtlin.symm) hψtx x)
  -- The bad elements and their finitely many functionals.
  by_contra hbad
  rw [SetLike.not_le_iff_exists] at hbad
  obtain ⟨v₀, hv₀, hv₀H⟩ := hbad
  let Bad : Set (rationalPoints G) := {v | v ∈ P.affineRootGroup α φ ∧ v ∉ H}
  have hBad : ∀ v ∈ Bad,
      v ∈ P.rootGroup α ∧ v ≠ 1 ∧ ∀ x, φ x ≤ P.reflectionFunctional α v x := by
    rintro v ⟨hv, hvH⟩
    rcases (P.mem_affineRootGroup_iff_reflectionFunctional hlin).1 hv with rfl | h
    · exact absurd H.one_mem hvH
    · exact h
  let T := (fun v => P.reflectionFunctional α v) '' Bad
  have hT : T.Finite := by
    refine (P.finite_bounded_reflectionFunctionals_of_oppositePairs hF α x₀
      (max |φ x₀| |ψt x₀|)).subset ?_
    rintro _ ⟨v, hvBad, rfl⟩
    obtain ⟨hv, hv1, hge⟩ := hBad v hvBad
    refine ⟨v, hv, hv1, rfl, ?_⟩
    have hlt : P.reflectionFunctional α v x₀ < ψt x₀ := by
      by_contra hge'
      push Not at hge'
      refine hvBad.2 (htopH ((P.mem_affineRootGroup_iff_reflectionFunctional hψtlin).2
        (Or.inr ⟨hv, hv1, P.le_of_linear_eq ?_ hge'⟩)))
      rw [hψtlin, P.reflectionFunctional_linear]
    have hge0 := hge x₀
    exact abs_le.2 ⟨by linarith [neg_abs_le (φ x₀), le_max_left |φ x₀| |ψt x₀|],
      by linarith [le_abs_self (ψt x₀), le_max_right |φ x₀| |ψt x₀|]⟩
  obtain ⟨_, ⟨v, hvBad, rfl⟩, hmax⟩ :=
    Set.exists_max_image T (fun f => f x₀) hT ⟨_, ⟨v₀, ⟨hv₀, hv₀H⟩, rfl⟩⟩
  obtain ⟨hv, hv1, hge⟩ := hBad v hvBad
  have hψvlin := P.reflectionFunctional_linear α v
  have hvψv := P.mem_affineRootGroup_reflectionFunctional hv hv1
  have hΩv : ∀ x ∈ Ω, 0 ≤ P.reflectionFunctional α v x := fun x hx => (hΩ x hx).trans (hge x)
  by_cases hψvΨ : P.reflectionFunctional α v ∈ P.affineRoots
  · exact hvBad.2 (P.affineRootGroup_le_nonnegativeRootSubgroup hψvΨ hψvlin hΩv hvψv)
  obtain ⟨v', hv', w, hw, hvw⟩ :=
    P.apartment.affineRootGroup_subset_mul_double_of_not_mem_affineRoots h2a hψvlin hψvΨ hvψv
  replace hvw : v' * w = v := hvw
  -- The factor in `U_{2a}` lies in the subgroup.
  have hlin2 : ((2 : ℝ) • P.reflectionFunctional α v).linear =
      rootForm P.i ⟨2 • (α : characterLattice P.S), h2a⟩ := by
    rw [AffineMap.smul_linear, hψvlin, rootForm_nsmul α.property 2 h2a]
    norm_num
  have hwH : w ∈ H :=
    P.affineRootGroup_le_nonnegativeRootSubgroup_of_not_double
      (β := ⟨2 • (α : characterLattice P.S), h2a⟩) h4a hlin2 (fun x hx => by
        simp only [AffineMap.coe_smul, Pi.smul_apply, smul_eq_mul]
        linarith [hΩv x hx]) hw
  -- The factor in `U_{ψ^v_a +}` is bad with a larger functional.
  rcases (P.mem_affineRootGroupPlus_iff_reflectionFunctional hψvlin).1 hv' with
    rfl | ⟨hv'r, hv'1, hlt⟩
  · apply hvBad.2
    rw [← hvw, one_mul]
    exact hwH
  have hv'Bad : v' ∈ Bad := by
    refine ⟨(P.mem_affineRootGroup_iff_reflectionFunctional hlin).2
      (Or.inr ⟨hv'r, hv'1, fun x => (hge x).trans (hlt x).le⟩), fun hv'H => hvBad.2 ?_⟩
    rw [← hvw]
    exact H.mul_mem hv'H hwH
  exact absurd (hlt x₀) (not_lt.2 (hmax _ ⟨v', hv'Bad, rfl⟩))

/-- `U_{a,Ω,0} ⊆ P.nonnegativeRootSubgroup Ω`: each `u ∈ U_{a,Ω,0} ∖ {1}` lies in `U_ψ` for
`ψ = ψ^u_a`, which is non-negative on `Ω`. -/
theorem rootFixer_le_nonnegativeRootSubgroup (hP : P.SatisfiesApartmentAxioms)
    (α : relativeRoots P.i) (Ω : Set P.Apartment) :
    P.rootFixer α Ω ≤ P.nonnegativeRootSubgroup Ω := by
  intro g hg
  by_cases hg1 : g = 1
  · rw [hg1]
    exact (P.nonnegativeRootSubgroup Ω).one_mem
  rw [P.apartment.mem_rootFixer] at hg
  have hΩ : ∀ x ∈ Ω, 0 ≤ P.reflectionFunctional α g x := by
    intro x hx
    have h0 := (KPApartmentData.mem_filtration.1 (hg.2 x hx)).2
    rw [← P.coe_reflectionFunctional_apply hg.1 hg1 x] at h0
    exact WithTop.coe_le_coe.1 h0
  have hmem := P.mem_affineRootGroup_reflectionFunctional hg.1 hg1
  by_cases h2a : 2 • (α : characterLattice P.S) ∈ relativeRoots P.i
  · exact P.affineRootGroup_le_nonnegativeRootSubgroup_of_double hP h2a
      (P.reflectionFunctional_linear α g) hΩ hmem
  · exact P.affineRootGroup_le_nonnegativeRootSubgroup_of_not_double h2a
      (P.reflectionFunctional_linear α g) hΩ hmem

/-- `G(F)^♯_Ω ⊆ P.nonnegativeRootSubgroup Ω`. -/
theorem sharpFixer_le_nonnegativeRootSubgroup (hP : P.SatisfiesApartmentAxioms)
    (Ω : Set P.Apartment) : P.sharpFixer Ω ≤ P.nonnegativeRootSubgroup Ω :=
  iSup_le fun α => P.rootFixer_le_nonnegativeRootSubgroup hP α Ω

/-- KP Lemma 7.4.4(3): `P_Ω = Z(F)^0 · G(F)^♯_Ω` is generated by `Z(F)^0` and the `U_ψ` for
`ψ ∈ Ψ` with `ψ(Ω) ⊆ ℝ_{≥0}`, for every `Ω ⊆ A(S)`. -/
theorem parahoric_eq_nonnegativeRootSubgroup (hP : P.SatisfiesApartmentAxioms)
    (Ω : Set P.Apartment) : P.parahoric Ω = P.nonnegativeRootSubgroup Ω :=
  le_antisymm (sup_le le_sup_left (P.sharpFixer_le_nonnegativeRootSubgroup hP Ω))
    (P.nonnegativeRootSubgroup_le_parahoric Ω)

end ParahoricBuildingData

/-- KP Lemma 7.4.4(3) for the building of KP Chapter 7, on supplied data over a nonarchimedean
local field: under V 7 and AS 2–AS 5 for the class `A(S)` of `P`, for every `Ω ⊆ A(S)` the
subgroup `P_Ω = Z(F)^0 · G(F)^♯_Ω` is generated by `Z(F)^0` and the `U_ψ` for `ψ ∈ Ψ` with
`ψ(Ω) ⊆ ℝ_{≥0}`. -/
def ParahoricNonnegativeRootGenerationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G),
    P.SatisfiesApartmentAxioms →
      ∀ Ω : Set P.Apartment, P.parahoric Ω = P.nonnegativeRootSubgroup Ω

/-- Proof of `ParahoricNonnegativeRootGenerationStatement` (KP Lemma 7.4.4(3)). -/
theorem parahoricNonnegativeRootGeneration : ParahoricNonnegativeRootGenerationStatement.{u} :=
  fun _ _ _ _ _ _ _ P hP Ω => P.parahoric_eq_nonnegativeRootSubgroup hP Ω

end Langlands.Geometry.Building
