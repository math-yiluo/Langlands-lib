import Langlands.Geometry.Building.SelectedRootDepthCollection

/-! # Actual filtered root groups under restriction between split tori -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

set_option backward.isDefEq.respectTransparency false

variable {k : Type u} [Field k]
  {S T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : T.toGrp ⟶ G} [IsAffineHom G.X.hom] [Mono i.hom.hom.left]
  {φ : RootFunctionFamily T G}

/-- Pairing an upper character with the transported cocharacter records its
positive integral restriction multiplier. -/
theorem latticePairing_comp_torusHom_of_restrict_eq_nsmul
    (f : S ⟶ T) (α : characterLattice S) (ν : cocharacterLattice S)
    {χ : characterLattice T} {m : ℕ} (hχ : f ≫ χ = m • α) :
    latticePairing T χ (ν ≫ f) = m • latticePairing S α ν := by
  rw [latticePairing_apply, Category.assoc, hχ]
  change latticePairing S (m • α) ν = _
  rw [map_nsmul]
  rfl

/-- An auxiliary additive depth on the whole upper character lattice.
On the selected restriction fibre its value is the intrinsic multiplier times r. -/
def torusRestrictionDepth (f : S ⟶ T) (α : characterLattice S)
    (ν : cocharacterLattice S) (r : ℝ) : characterLattice T →+ ℝ :=
  (r / (latticePairing S α ν : ℝ)) •
    ((Int.castAddHom ℝ).comp ((latticePairing T).flip (ν ≫ f)).toAddMonoidHom)

@[simp] theorem torusRestrictionDepth_apply (f : S ⟶ T) (α : characterLattice S)
    (ν : cocharacterLattice S) (r : ℝ) (χ : characterLattice T) :
    torusRestrictionDepth f α ν r χ =
      r / (latticePairing S α ν : ℝ) * (latticePairing T χ (ν ≫ f) : ℝ) := rfl

/-- The selected depths do not depend on an auxiliary cocharacter; no sign
restriction on the real depth r is imposed. -/
theorem torusRestrictionDepth_eq_mul
    (f : S ⟶ T) (α : characterLattice S) (ν : cocharacterLattice S)
    (hν : latticePairing S α ν ≠ 0) (r : ℝ)
    {χ : characterLattice T} {m : ℕ} (hχ : f ≫ χ = m • α) :
    torusRestrictionDepth f α ν r χ = m * r := by
  rw [torusRestrictionDepth_apply,
    latticePairing_comp_torusHom_of_restrict_eq_nsmul f α ν hχ,
    nsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
  have hd : (latticePairing S α ν : ℝ) ≠ 0 := by exact_mod_cast hν
  field_simp

/-- A cocharacter positive on the lower character is positive on its entire
positive restriction fibre. -/
theorem latticePairing_pos_of_mem_torusRestriction
    (f : S ⟶ T) (α : characterLattice S) (ν : cocharacterLattice S)
    (hν : 0 < latticePairing S α ν)
    {χ : characterLattice T}
    (hχ : χ ∈ RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1)) :
    0 < latticePairing T χ (ν ≫ f) := by
  obtain ⟨m, _, hm, heq⟩ := hχ
  rw [latticePairing_comp_torusHom_of_restrict_eq_nsmul f α ν heq.symm,
    nsmul_eq_mul]
  exact mul_pos (by exact_mod_cast hm) hν

/-- The subgroup generated by the actual upper root filtrations at multiplier
scaled depths. This definition makes no auxiliary cocharacter choice. -/
def torusRestrictedRootDepthSubgroup (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (r : ℝ) :
    Subgroup (rationalPoints G) :=
  ⨆ χ : characterLattice T, ⨆ (_ : χ ∈ relativeRoots i) (m : ℕ)
    (_ : 0 < m) (_ : f ≫ χ = m • α), hφ.filtrationSubgroup χ (m * r)

/-- Every positive auxiliary cocharacter gives the same canonical actual subgroup. -/
theorem torusRestrictedRootDepthSubgroup_eq_selectedRootDepthSubgroup
    (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (ν : cocharacterLattice S)
    (hν : latticePairing S α ν ≠ 0) (r : ℝ) :
    torusRestrictedRootDepthSubgroup hφ f α r =
      selectedRootDepthSubgroup hφ
        (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1))
        (torusRestrictionDepth f α ν r) := by
  apply le_antisymm
  · refine iSup_le fun χ => iSup_le fun hχ => iSup_le fun m =>
      iSup_le fun hm => iSup_le fun heq => ?_
    have hχA : χ ∈ RelativeRoot.characterSemigroupPreimage f
        (RelativeRoot.cyclicTail α 1) := ⟨m, by omega, hm, heq.symm⟩
    rw [← torusRestrictionDepth_eq_mul f α ν hν r heq]
    exact le_iSup (fun a : {a : characterLattice T |
      a ∈ relativeRoots i ∧ a ∈ RelativeRoot.characterSemigroupPreimage f
        (RelativeRoot.cyclicTail α 1)} =>
      hφ.filtrationSubgroup a.val (torusRestrictionDepth f α ν r a.val)) ⟨χ, hχ, hχA⟩
  · refine iSup_le fun χ => ?_
    obtain ⟨m, _, hm, heq⟩ := χ.property.2
    rw [torusRestrictionDepth_eq_mul f α ν hν r heq.symm]
    exact le_iSup_of_le χ.val (le_iSup_of_le χ.property.1
      (le_iSup_of_le m (le_iSup_of_le hm (le_iSup_of_le heq.symm le_rfl))))

/-- The auxiliary selected-depth description is independent of its cocharacter. -/
theorem selectedRootDepthSubgroup_torusRestriction_independent
    (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (ν ν' : cocharacterLattice S)
    (hν : latticePairing S α ν ≠ 0) (hν' : latticePairing S α ν' ≠ 0) (r : ℝ) :
    selectedRootDepthSubgroup hφ
        (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1))
        (torusRestrictionDepth f α ν r) =
      selectedRootDepthSubgroup hφ
        (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1))
        (torusRestrictionDepth f α ν' r) := by
  rw [← torusRestrictedRootDepthSubgroup_eq_selectedRootDepthSubgroup hφ f α ν hν r,
    ← torusRestrictedRootDepthSubgroup_eq_selectedRootDepthSubgroup hφ f α ν' hν' r]

/-- Increasing the lower depth decreases the actual restricted filtered subgroup. -/
theorem torusRestrictedRootDepthSubgroup_antitone
    (hφ : IsRootDatumValuation i φ) (f : S ⟶ T) (α : characterLattice S) :
    Antitone (torusRestrictedRootDepthSubgroup hφ f α) := by
  intro r s hrs
  refine iSup_le fun χ => iSup_le fun hχ => iSup_le fun m =>
    iSup_le fun hm => iSup_le fun heq => ?_
  exact le_iSup_of_le χ (le_iSup_of_le hχ (le_iSup_of_le m
    (le_iSup_of_le hm (le_iSup_of_le heq
      (hφ.filtrationSubgroup_antitone χ (mul_le_mul_of_nonneg_left hrs (Nat.cast_nonneg m)))))))

section ActualRestrictedRoot

variable [Smooth G.X.hom]

/-- The canonical filtered subgroup lies in the actual lower-torus root group.
No opposite-factor-pair or product premise is used for this inclusion. -/
theorem torusRestrictedRootDepthSubgroup_le_rootGroupPoints
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (hα : α ≠ 0) (r : ℝ) :
    torusRestrictedRootDepthSubgroup hφ f α r ≤
      rootGroupPoints (CommGroupScheme.groupHom f ≫ i) α := by
  obtain ⟨D, hD, ν, hν⟩ := hS.exists_pairing_eq_pos hα
  have hνpos : 0 < latticePairing S α ν := by rw [hν]; exact_mod_cast hD
  change _ ≤ (RelativeRoot.subgroup (CommGroupScheme.groupHom f ≫ i) α).carrier
    (Over.mk (𝟙 _))
  rw [RelativeRoot.subgroup_comp_torusHom_eq_semigroupSubgroup hS hT f i α hα,
    torusRestrictedRootDepthSubgroup_eq_selectedRootDepthSubgroup hφ f α ν
      (ne_of_gt hνpos) r]
  exact selectedRootDepthSubgroup_le_semigroupSubgroup hT hφ _ _

omit [Mono i.hom.hom.left] in
/-- Selected-indivisible roots admit an injective finite enumeration together
with their positive integral restriction multipliers. -/
theorem exists_torusRestrictionRootDepth_enumeration
    (hT : IsSplitTorus T.toGrp) (f : S ⟶ T) (α : characterLattice S) :
    ∃ (n : ℕ) (a : Fin n → characterLattice T) (m : Fin n → ℕ),
      Function.Injective a ∧
      Set.range a = RelativeRoot.semigroupIndivisibleRoots i
        (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1)) ∧
      ∀ j, 0 < m j ∧ f ≫ a j = m j • α := by
  classical
  obtain ⟨n, a, hinj, hrange⟩ :=
    RelativeRoot.exists_semigroupIndivisibleRoots_enumeration i hT
      (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1))
  have hm : ∀ j, ∃ m : ℕ, 0 < m ∧ f ≫ a j = m • α := by
    intro j
    have hj : a j ∈ RelativeRoot.semigroupIndivisibleRoots i
        (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1)) :=
      hrange ▸ Set.mem_range_self j
    obtain ⟨m, _, hm, heq⟩ := hj.2.1
    exact ⟨m, hm, heq.symm⟩
  choose m hm hrestrict using hm
  exact ⟨n, a, m, hinj, hrange, fun j => ⟨hm j, hrestrict j⟩⟩

/-- Any complete selected-indivisible enumeration gives the exact restricted
filtered subgroup at its integral restriction multipliers. -/
theorem orderedRootFiltrationProduct_eq_torusRestrictedRootDepthSubgroup
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs i) (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (hα : α ≠ 0) (r : ℝ)
    {n : ℕ} (a : Fin n → characterLattice T) (m : Fin n → ℕ)
    (hrange : Set.range a = RelativeRoot.semigroupIndivisibleRoots i
      (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1)))
    (hrestrict : ∀ j, f ≫ a j = m j • α) :
    orderedRootFiltrationProduct i φ a (fun j => m j * r) =
      (torusRestrictedRootDepthSubgroup hφ f α r : Set (rationalPoints G)) := by
  obtain ⟨D, hD, ν, hν⟩ := hS.exists_pairing_eq_pos hα
  have hνpos : 0 < latticePairing S α ν := by rw [hν]; exact_mod_cast hD
  have hdepth (j : Fin n) : torusRestrictionDepth f α ν r (a j) = m j * r :=
    torusRestrictionDepth_eq_mul f α ν (ne_of_gt hνpos) r (hrestrict j)
  rw [torusRestrictedRootDepthSubgroup_eq_selectedRootDepthSubgroup hφ f α ν
    (ne_of_gt hνpos) r]
  simpa only [hdepth] using
    orderedRootFiltrationProduct_eq_selectedRootDepthSubgroup hT hE hφ
      (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1))
      (ν ≫ f) (fun χ _ hχ => latticePairing_pos_of_mem_torusRestriction f α ν hνpos hχ)
      (torusRestrictionDepth f α ν r) a hrange

/-- Injective selected-indivisible enumerations give unique actual upper
filtration coordinates for every restricted filtered root point. -/
theorem mem_torusRestrictedRootDepthSubgroup_iff_existsUnique
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs i) (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (hα : α ≠ 0) (r : ℝ)
    {n : ℕ} (a : Fin n → characterLattice T) (m : Fin n → ℕ)
    (hinj : Function.Injective a)
    (hrange : Set.range a = RelativeRoot.semigroupIndivisibleRoots i
      (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1)))
    (hrestrict : ∀ j, f ≫ a j = m j • α) (g : rationalPoints G) :
    g ∈ torusRestrictedRootDepthSubgroup hφ f α r ↔
      ∃! x : ∀ j, rootFiltration i φ (a j) (m j * r),
        (List.ofFn fun j => (x j : rationalPoints G)).prod = g := by
  obtain ⟨D, hD, ν, hν⟩ := hS.exists_pairing_eq_pos hα
  have hνpos : 0 < latticePairing S α ν := by rw [hν]; exact_mod_cast hD
  have hdepth (j : Fin n) : torusRestrictionDepth f α ν r (a j) = m j * r :=
    torusRestrictionDepth_eq_mul f α ν (ne_of_gt hνpos) r (hrestrict j)
  rw [torusRestrictedRootDepthSubgroup_eq_selectedRootDepthSubgroup hφ f α ν
    (ne_of_gt hνpos) r]
  have h := mem_selectedRootDepthSubgroup_iff_existsUnique hT hE hφ
      (RelativeRoot.characterSemigroupPreimage f (RelativeRoot.cyclicTail α 1))
      (RelativeRoot.zero_notMem_characterSemigroupPreimage_cyclicTail hS f α hα)
      (ν ≫ f) (fun χ _ hχ => latticePairing_pos_of_mem_torusRestriction f α ν hνpos hχ)
      (torusRestrictionDepth f α ν r) a hinj hrange g
  let P (d : Fin n → ℝ) : Prop :=
    ∃! x : ∀ j, rootFiltration i φ (a j) (d j),
      (List.ofFn fun j => (x j : rationalPoints G)).prod = g
  change _ ↔ P (fun j => torusRestrictionDepth f α ν r (a j)) at h
  rw [show (fun j => torusRestrictionDepth f α ν r (a j)) =
    (fun j => (m j : ℝ) * r) from funext hdepth] at h
  exact h

/-- Taking all real depths recovers the entire actual restricted root group. -/
theorem iSup_torusRestrictedRootDepthSubgroup
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs i) (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (hα : α ≠ 0) :
    (⨆ r : ℝ, torusRestrictedRootDepthSubgroup hφ f α r) =
      rootGroupPoints (CommGroupScheme.groupHom f ≫ i) α := by
  apply le_antisymm
  · exact iSup_le fun r =>
      torusRestrictedRootDepthSubgroup_le_rootGroupPoints hS hT hφ f α hα r
  · change (RelativeRoot.subgroup (CommGroupScheme.groupHom f ≫ i) α).carrier
      (Over.mk (𝟙 _)) ≤ _
    rw [RelativeRoot.subgroup_comp_torusHom_carrier_eq_iSup hS hT f i hE α hα]
    refine iSup_le fun χ => ?_
    intro g hg
    obtain ⟨m, _, hm, heq⟩ := χ.property.2
    have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hm)
    have hmem {r : ℝ} (hr : ((m * r : ℝ) : WithTop ℝ) ≤ φ χ.val g) :
        g ∈ torusRestrictedRootDepthSubgroup hφ f α r := by
      have hle : hφ.filtrationSubgroup χ.val (m * r) ≤
          torusRestrictedRootDepthSubgroup hφ f α r :=
        le_iSup_of_le χ.val (le_iSup_of_le χ.property.1 (le_iSup_of_le m
          (le_iSup_of_le hm (le_iSup_of_le heq.symm le_rfl))))
      exact hle ⟨hg, hr⟩
    induction hv : φ χ.val g using WithTop.recTopCoe with
    | top =>
        exact Subgroup.mem_iSup_of_mem (0 : ℝ) (hmem (by rw [hv]; exact le_top))
    | coe t =>
        apply Subgroup.mem_iSup_of_mem (t / m)
        apply hmem
        rw [hv, WithTop.coe_le_coe]
        exact le_of_eq (by field_simp)

/-- Every actual lower root point belongs to some real-depth subgroup, and
membership in a depth subgroup always gives an actual lower root point. -/
theorem mem_rootGroupPoints_iff_exists_torusRestrictedRootDepth
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs i) (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (hα : α ≠ 0) (g : rationalPoints G) :
    g ∈ rootGroupPoints (CommGroupScheme.groupHom f ≫ i) α ↔
      ∃ r : ℝ, g ∈ torusRestrictedRootDepthSubgroup hφ f α r := by
  rw [← iSup_torusRestrictedRootDepthSubgroup hS hT hE hφ f α hα]
  apply Subgroup.mem_iSup_of_directed
  intro r s
  refine ⟨min r s, ?_, ?_⟩
  · exact torusRestrictedRootDepthSubgroup_antitone hφ f α (min_le_left r s)
  · exact torusRestrictedRootDepthSubgroup_antitone hφ f α (min_le_right r s)

/-- The intersection of every real depth is exactly the identity subgroup. -/
theorem iInf_torusRestrictedRootDepthSubgroup
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs i) (hφ : IsRootDatumValuation i φ)
    (f : S ⟶ T) (α : characterLattice S) (hα : α ≠ 0) :
    (⨅ r : ℝ, torusRestrictedRootDepthSubgroup hφ f α r) = ⊥ := by
  classical
  apply le_antisymm
  · intro g hg
    have hi (r : ℝ) : g ∈ torusRestrictedRootDepthSubgroup hφ f α r := by
      have hle : (⨅ s : ℝ, torusRestrictedRootDepthSubgroup hφ f α s) ≤
          torusRestrictedRootDepthSubgroup hφ f α r := iInf_le _ r
      exact hle hg
    obtain ⟨n, a, m, hinj, hrange, hm⟩ := exists_torusRestrictionRootDepth_enumeration (i := i) hT f α
    have hroot (j : Fin n) : a j ∈ relativeRoots i :=
      (hrange ▸ Set.mem_range_self j).1
    have hlow : g ∈ rootGroupPoints (CommGroupScheme.groupHom f ≫ i) α :=
      torusRestrictedRootDepthSubgroup_le_rootGroupPoints hS hT hφ f α hα 0 (hi 0)
    obtain ⟨X, hX, hXu⟩ :=
      (RelativeRoot.mem_subgroup_comp_torusHom_iff_existsUnique_rootPointsProduct
        hS hT f i hE α hα a hinj hrange (Over.mk (𝟙 _)) g).mp hlow
    have hfil (r : ℝ) (j : Fin n) : ((m j * r : ℝ) : WithTop ℝ) ≤ φ (a j) (X j).val := by
      obtain ⟨y, hy, _⟩ :=
        (mem_torusRestrictedRootDepthSubgroup_iff_existsUnique hS hT hE hφ f α hα r
          a m hinj hrange (fun j => (hm j).2) g).mp (hi r)
      let Y : ∀ j, (RelativeRoot.subgroup i (a j)).carrier (Over.mk (𝟙 _)) :=
        fun j => ⟨(y j).val, (y j).property.1⟩
      have hY : RelativeRoot.rootPointsProduct i a (Over.mk (𝟙 _)) Y = g := hy
      have hYX : Y = X := hXu Y hY
      have heq : (y j).val = (X j).val := congrArg
        (fun z : (RelativeRoot.subgroup i (a j)).carrier (Over.mk (𝟙 _)) => z.val)
        (congrFun hYX j)
      rw [← heq]
      exact (y j).property.2
    have hone (j : Fin n) : (X j).val = 1 := by
      apply (hφ.eq_top_iff (a j) (hroot j) (X j).val (X j).property).mp
      induction hv : φ (a j) (X j).val using WithTop.recTopCoe with
      | top => rfl
      | coe t =>
          have hbound := hfil ((t + 1) / m j) j
          rw [hv, WithTop.coe_le_coe] at hbound
          have hmR : (m j : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (hm j).1)
          have heq : (m j : ℝ) * ((t + 1) / m j) = t + 1 := by field_simp
          rw [heq] at hbound
          exact (not_le_of_gt (lt_add_one t) hbound).elim
    change g = 1
    rw [← hX]
    unfold RelativeRoot.rootPointsProduct
    simp only [hone, List.ofFn_const, List.prod_replicate, one_pow]
  · exact bot_le

end ActualRestrictedRoot

end Langlands.Geometry.Building
