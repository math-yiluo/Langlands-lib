import Langlands.Geometry.Building.UnramifiedValuationDescentStatement

/-! # Galois-fixed points of an unramified apartment under rational normalizer points -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.GaloisPointComparison
open Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building

private instance unramifiedFixedLeviTransportAffineHom {F : Type u} [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] :
    IsAffineHom (baseChanged F (inertiaFixedField F) G).X.hom := by
  change IsAffineHom
    (CategoryTheory.Limits.pullback.snd G.X.hom (baseMap F (inertiaFixedField F)))
  infer_instance

/-- **Levi transport of Galois-fixed points** (KP Proposition 9.3.13 with the transitivity of
the parahoric subgroups of the Levi subgroup `Z_G(S)` on its apartments). Let `K` be the
maximal unramified extension of a nonarchimedean local field `F`, `S` a maximal `F`-split
torus of a connected reductive `F`-group `G`, and `T ⊇ S` an `F`-torus with `T_K` a maximal
`K`-split torus of `G_K`. Let `D` be an equipollence class of valuations of the root datum of
`(G_K, T_K)` satisfying V 6 for the order of `K`. For every `n ∈ N_G(S)(F)` and every
`Aut(K/F)`-fixed point `x` of the apartment of `D`, there is a point `h ∈ G(K)` which
centralizes `S_K` and lies in the subgroup generated by the groups `U_{χ,x,0}` for the roots
`χ` of `T_K` vanishing on `S_K`, such that `n h` normalizes `T_K` and `n h · x` is again
`Aut(K/F)`-fixed. -/
def UnramifiedFixedLeviTransportStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) (hG : IsConnectedReductive G)
    (S : CommGroupScheme (Spec (CommRingCat.of F))) (iS : S.toGrp ⟶ G)
    (hiS : IsMaximalSplitTorus iS)
    (T : CommGroupScheme (Spec (CommRingCat.of F))) (iT : T.toGrp ⟶ G) (f : S ⟶ T),
    CommGroupScheme.groupHom f ≫ iT = iS →
    letI : IsAffineHom G.X.hom := hG.isAffineHom
    letI : Smooth G.X.hom := hG.smooth
    haveI := mono_of_isMaximalSplitTorus hiS
    ∀ (hiT : IsMaximalSplitTorus
        (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
        ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)),
      haveI := mono_of_isMaximalSplitTorus hiT
      haveI : Mono ((GroupScheme.baseChange
          (algebraBaseMap F (inertiaFixedField F))).map iT).hom.hom.left :=
        mono_of_isMaximalSplitTorus hiT
      ∀ (D : KPApartmentData
          (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
          ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)
          (IntegerValuation.order (MaximalUnramified.valuation F)))
        (C : CentralizerDatum
          (S := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
          ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)),
        IntegerValuation.IsOmegaCompatible (MaximalUnramified.valuation F) D C →
        let fixed : D.Apartment → Prop := fun x =>
          ∀ σ : inertiaFixedField F ≃ₐ[F] inertiaFixedField F,
            RootFunctionFamily.galoisAction F (inertiaFixedField F) T G σ x.val = x.val
        ∀ (n : normalizerPoints iS) (x : D.Apartment), fixed x →
          ∃ h : rationalPoints ((GroupScheme.baseChange
              (algebraBaseMap F (inertiaFixedField F))).obj G),
            h ∈ centralizerPoints
              (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj S)
              ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iS) ∧
            h ∈ (⨆ (χ : characterLattice
                ((CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T))
              (_ : χ ∈ relativeRoots
                (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
                ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT))
              (_ : (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map f ≫
                χ = 0), D.filtration x χ 0) ∧
            ∃ hw : (show rationalPoints ((GroupScheme.baseChange
                  (algebraBaseMap F (inertiaFixedField F))).obj G) from
                rationalExtend F (inertiaFixedField F) G (n : rationalPoints G)) * h ∈
                normalizerPoints
                  (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
                  ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT),
              fixed ((⟨_, hw⟩ : normalizerPoints
                  (T := (CommGroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).obj T)
                  ((GroupScheme.baseChange (algebraBaseMap F (inertiaFixedField F))).map iT)) • x)

end Langlands.Geometry.Building
