import Langlands.Geometry.Building.FilteredRootProducts
import Langlands.Geometry.Building.KPParahoric

/-!
# Actual real-depth root-generated subgroups

The generated subgroup keeps the doubled-root blocks of KP Definition 7.3.3.
At constant depth zero its join with the actual central subgroup is `P_x`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme

namespace Langlands.Geometry.Building.KPApartmentData

variable {k : Type u} [Field k]
  {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]
  {ω : kˣ → ℝ} (D : KPApartmentData i ω)

/-- The real-valued specialization of concavity on `Φ ∪ {0}`. Only the
values of `f` on that subset are tested (KP Definition 7.3.1). -/
def IsRealDepthConcave (f : characterLattice S → ℝ) : Prop :=
  ∀ a ∈ relativeRoots i ∪ {0}, ∀ b ∈ relativeRoots i ∪ {0},
    a + b ∈ relativeRoots i ∪ {0} → f (a + b) ≤ f a + f b

omit [Mono i.hom.hom.left] in
/-- The constant zero function is concave (KP Example 7.3.7(1)). -/
theorem isRealDepthConcave_zero : IsRealDepthConcave (i := i) (fun _ => 0) := by
  intro a ha b hb hab
  simp

/-- The actual subgroup `G(k)^♯_{x,f}` generated by the real-depth blocks
of KP Definition 7.3.3(1),(2). Concavity is not needed for this construction. -/
def sharpFiltration (x : D.Apartment) (f : characterLattice S → ℝ) :
    Subgroup (rationalPoints G) :=
  ⨆ a : relativeRoots i, Subgroup.closure (D.filtrationBlock x f a)

/-- Every ordinary root factor belongs to its actual doubled-root block. -/
theorem filtration_subset_filtrationBlock (x : D.Apartment)
    (f : characterLattice S → ℝ) (a : characterLattice S) :
    (D.filtration x a (f a) : Set (rationalPoints G)) ⊆
      D.filtrationBlock x f a := by
  intro g hg
  exact D.mem_filtrationBlock.2
    ⟨g, hg, 1, (D.doubleFiltration x a (f (2 • a))).one_mem, mul_one g⟩

/-- Generating over all roots absorbs every doubled-root factor because it
is itself one of the indexed root factors. Individual blocks are retained. -/
theorem sharpFiltration_eq_iSup (x : D.Apartment) (f : characterLattice S → ℝ) :
    D.sharpFiltration x f = ⨆ a : relativeRoots i, D.filtration x a (f a) := by
  classical
  apply le_antisymm
  · refine iSup_le fun a => (Subgroup.closure_le _).2 ?_
    intro g hg
    obtain ⟨v, hv, w, hw, rfl⟩ := D.mem_filtrationBlock.1 hg
    apply Subgroup.mul_mem
    · exact le_iSup (fun b : relativeRoots i => D.filtration x b (f b)) a hv
    · by_cases h2a : 2 • a.1 ∈ relativeRoots i
      · rw [D.doubleFiltration_of_mem x a (f (2 • a)) h2a] at hw
        exact le_iSup (fun b : relativeRoots i => D.filtration x b (f b))
          ⟨2 • a.1, h2a⟩ hw
      · rw [D.doubleFiltration_of_not_mem x a (f (2 • a)) h2a] at hw
        have hw1 : w = 1 := Subgroup.mem_bot.1 hw
        rw [hw1]
        exact Subgroup.one_mem _
  · refine iSup_le fun a g hg => ?_
    exact le_iSup (fun b : relativeRoots i =>
      Subgroup.closure (D.filtrationBlock x f b)) a
        (Subgroup.subset_closure (D.filtration_subset_filtrationBlock x f a hg))

/-- At zero depth the actual root-generated group is the point sharp fixer. -/
theorem sharpFiltration_zero (x : D.Apartment) :
    D.sharpFiltration x (fun _ => 0) = D.sharpFixer {x} := by
  rw [D.sharpFiltration_eq_iSup]
  simp only [sharpFixer, D.rootFixer_singleton]

end Langlands.Geometry.Building.KPApartmentData

namespace Langlands.Geometry.Building.ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- The full root-generated subgroup at central depth zero. For a concave
real-valued `f` with `f(0) = 0`, this is KP's `P_{x,f}`. -/
def zeroCentralFiltration (x : P.Apartment) (f : characterLattice P.S → ℝ) :
    Subgroup (rationalPoints G) :=
  P.centralizerZero.map (rationalPoints.map P.centralizer.j) ⊔
    P.apartment.sharpFiltration x f

/-- The constant-zero full subgroup is the actual point parahoric. -/
theorem zeroCentralFiltration_zero (x : P.Apartment) :
    P.zeroCentralFiltration x (fun _ => 0) = P.parahoricAt x := by
  unfold zeroCentralFiltration parahoricAt parahoric
  rw [P.apartment.sharpFiltration_zero]

end Langlands.Geometry.Building.ParahoricBuildingData
