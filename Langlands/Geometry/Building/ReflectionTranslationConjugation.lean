import Langlands.Geometry.Building.ReflectionTranslationLattice

/-! # Conjugation and coroot corrections for actual reflection translations -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building.ValuationBuildingData

private theorem normal_closure_of_conjugates_mem {H : Type*} [Group H]
    (s : Set H)
    (h : ∀ n r, r ∈ s → n * r * n⁻¹ ∈ Subgroup.closure s) :
    (Subgroup.closure s).Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  exact Subgroup.le_normalizer_closure_iff.mpr (fun n _ r hr => h n r hr)

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (B : ValuationBuildingData G)
    {a : relativeRoots B.i} {g : rationalPoints G}
    {p : rationalPoints G × rationalPoints G}

/-- Simultaneous normalizer conjugation preserves actual opposite factor pairs,
with the root transported by the actual Weyl action. -/
theorem conjugate_oppositeFactorPair (n : normalizerPoints B.i)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p) :
    RelativeRoot.IsOppositeFactorPair B.i (weylAction B.i n a)
      ((n : rationalPoints G) * g * (n : rationalPoints G)⁻¹)
      ((n : rationalPoints G) * p.1 * (n : rationalPoints G)⁻¹,
        (n : rationalPoints G) * p.2 * (n : rationalPoints G)⁻¹) := by
  refine ⟨?_, ?_, ?_⟩
  · simpa only [rootGroupPoints, map_neg] using conj_mem_rootGroupPoints n hp.1
  · simpa only [rootGroupPoints, map_neg] using conj_mem_rootGroupPoints n hp.2.1
  · have hn := (normalizerPoints B.i).mul_mem
      ((normalizerPoints B.i).mul_mem n.property hp.2.2)
      ((normalizerPoints B.i).inv_mem n.property)
    convert hn using 1
    group

/-- The reflection representative of a conjugated pair is the conjugate of
the original representative. -/
theorem reflectionElement_conjugate (n : normalizerPoints B.i)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p) :
    B.reflectionElement
        (α := ⟨weylAction B.i n a, weylAction_mapsTo_relativeRoots B.i n a.property⟩)
        (B.conjugate_oppositeFactorPair n hp) =
      n * B.reflectionElement hp * n⁻¹ := by
  apply Subtype.ext
  simp only [coe_reflectionElement, Subgroup.coe_mul, Subgroup.coe_inv]
  group

/-- Normalizer conjugation takes each actual reflection representative into
the subgroup generated by actual reflection representatives. -/
theorem conj_reflectionElement_mem_reflectionNormalizer (n : normalizerPoints B.i)
    (hg : g ∈ B.rootGroup a) (hg1 : g ≠ 1)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p) :
    n * B.reflectionElement hp * n⁻¹ ∈ B.reflectionNormalizer := by
  let b : relativeRoots B.i :=
    ⟨weylAction B.i n a, weylAction_mapsTo_relativeRoots B.i n a.property⟩
  have hg' :
      (n : rationalPoints G) * g * (n : rationalPoints G)⁻¹ ∈ B.rootGroup b :=
    conj_mem_rootGroupPoints n hg
  have hg1' : (n : rationalPoints G) * g * (n : rationalPoints G)⁻¹ ≠ 1 := by
    intro h
    apply hg1
    apply (MulAut.conj (n : rationalPoints G)).injective
    simpa only [MulAut.conj_apply, map_one] using h
  have hmem := B.reflectionElement_mem_reflectionNormalizer hg' hg1'
    (B.conjugate_oppositeFactorPair n hp)
  rw [B.reflectionElement_conjugate] at hmem
  exact hmem

/-- The subgroup generated by all actual opposite-pair representatives is
normal in the actual normalizer. -/
instance reflectionNormalizer_normal : B.reflectionNormalizer.Normal := by
  apply normal_closure_of_conjugates_mem
  rintro n r ⟨b, u, hu, hu1, q, hq, rfl⟩
  exact B.conj_reflectionElement_mem_reflectionNormalizer n hu hu1 hq

/-- A centralizer translation supplies, in every direction represented by an
actual opposite pair, its root coordinate times the actual reduced coroot. -/
theorem rootForm_translation_smul_coroot_mem_reflectionTranslationLattice
    (z : rationalPoints B.centralizer.Z)
    (hg : g ∈ B.rootGroup a) (hg1 : g ≠ 1)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p) :
    rootForm B.i a (B.reducedCentralizerTranslation z).toAdd •
      B.reflectionCoroot hg hg1 hp ∈ B.reflectionTranslationLattice := by
  let n := B.centralizer.toNormalizer z
  let g' := (n : rationalPoints G)⁻¹ * g * (n : rationalPoints G)
  let p' := ((n : rationalPoints G)⁻¹ * p.1 * (n : rationalPoints G),
    (n : rationalPoints G)⁻¹ * p.2 * (n : rationalPoints G))
  have hw : weylAction B.i n⁻¹ = 1 := by
    change weylAction B.i (B.centralizer.toNormalizer z)⁻¹ = 1
    rw [← map_inv]
    exact weylAction_centralizerToNormalizer B.centralizer.isRepresentedBy z⁻¹
  have hg' : g' ∈ B.rootGroup a := by
    simpa only [hw, LinearEquiv.coe_one, id, Subgroup.coe_inv, inv_inv] using
      conj_mem_rootGroupPoints n⁻¹ hg
  have hg1' : g' ≠ 1 := by
    intro h
    apply hg1
    apply (MulAut.conj (n : rationalPoints G)⁻¹).injective
    simpa only [g', MulAut.conj_apply, map_one, inv_inv] using h
  have hp' : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g' p' := by
    simpa only [hw, LinearEquiv.coe_one, id, Subgroup.coe_inv, inv_inv] using
      B.conjugate_oppositeFactorPair n⁻¹ hp
  let x : B.Apartment := Classical.arbitrary _
  have hv := (x.isCentralizerCompatible B.isOmegaCompatible) a a.property z g hg
  change x.val a g' = x.val a g +
    ((rootForm B.i a (B.reducedCentralizerTranslation z).toAdd : ℝ) : WithTop ℝ) at hv
  rw [← B.coe_reflectionFunctional_apply hg' hg1' x,
    ← B.coe_reflectionFunctional_apply hg hg1 x,
    ← WithTop.coe_add, WithTop.coe_eq_coe] at hv
  have hd : B.reflectionFunctional a g' x - B.reflectionFunctional a g x =
      rootForm B.i a (B.reducedCentralizerTranslation z).toAdd := by
    linarith
  have hm := B.rootValueDifference_smul_coroot_mem_reflectionTranslationLattice
    hg hg1 hg' hg1' hp hp' x
  rwa [hd] at hm

/-- If there are no actual relative roots, the reduced translation space is
zero and the two actual translation images coincide. -/
theorem reflectionTranslationLattice_eq_of_no_relativeRoots
    (hroot : relativeRoots B.i = ∅) :
    B.reflectionTranslationLattice = B.centralizerTranslationLattice := by
  apply le_antisymm B.reflectionTranslationLattice_le_centralizerTranslationLattice
  intro v _
  have hv : v = 0 := eq_zero_of_rootForm_eq_zero B.i v fun b => by
    exact False.elim (by simpa only [hroot, Set.mem_empty_iff_false] using b.property)
  rw [hv]
  exact B.reflectionTranslationLattice.zero_mem

end Langlands.Geometry.Building.ValuationBuildingData
