import Langlands.Geometry.Building.PositiveDepthRayCompression
import Langlands.GroupScheme.Rational.RootSubgroupTorusProduct

/-! # Filtered collection for roots selected by a character semigroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

set_option backward.isDefEq.respectTransparency false

variable {k : Type u} [Field k]
  {T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}
  {i : T.toGrp ⟶ G} [IsAffineHom G.X.hom] [Mono i.hom.hom.left]
  {φ : RootFunctionFamily T G}


omit [Mono i.hom.hom.left] in
/-- Additive real depths on a positive selected root set satisfy the exact
combination bound needed by V3 collection. -/
theorem isClosedPositiveRootDepth_of_addSubsemigroup
    (A : AddSubsemigroup (characterLattice T)) (ν : cocharacterLattice T)
    (hpos : ∀ a ∈ relativeRoots i, a ∈ A → 0 < latticePairing T a ν)
    (f : characterLattice T →+ ℝ) :
    IsClosedPositiveRootDepth i ν
      {a : characterLattice T | a ∈ relativeRoots i ∧ a ∈ A} f := by
  constructor
  · rintro a ⟨ha, haA⟩
    exact ⟨ha, hpos a ha haA⟩
  · rintro a b ⟨ha, haA⟩ ⟨hb, hbA⟩ p q hp hq hc
    refine ⟨⟨hc, A.add_mem
      (RelativeRoot.cyclicTail_one_le_of_mem haA ⟨p, by omega, hp, rfl⟩)
      (RelativeRoot.cyclicTail_one_le_of_mem hbA ⟨q, by omega, hq, rfl⟩)⟩, ?_⟩
    simp only [map_add, map_nsmul, nsmul_eq_mul, le_refl]

/-- The subgroup generated by the actual selected root filtrations at
the supplied additive real depths. -/
def selectedRootDepthSubgroup (hφ : IsRootDatumValuation i φ)
    (A : AddSubsemigroup (characterLattice T)) (f : characterLattice T →+ ℝ) :
    Subgroup (rationalPoints G) :=
  ⨆ a : {a : characterLattice T | a ∈ relativeRoots i ∧ a ∈ A},
    hφ.filtrationSubgroup a.val (f a.val)

/-- The supremum is the subgroup closure of the original filtration sets. -/
theorem selectedRootDepthSubgroup_eq_closure (hφ : IsRootDatumValuation i φ)
    (A : AddSubsemigroup (characterLattice T)) (f : characterLattice T →+ ℝ) :
    selectedRootDepthSubgroup hφ A f =
      Subgroup.closure (⋃ a : {a : characterLattice T |
        a ∈ relativeRoots i ∧ a ∈ A}, rootFiltration i φ a.val (f a.val)) := by
  rw [Subgroup.closure_iUnion]
  simp only [← hφ.coe_filtrationSubgroup, Subgroup.closure_eq, selectedRootDepthSubgroup]

section Collection

variable [Smooth G.X.hom]
  (hT : IsSplitTorus T.toGrp) (hE : RelativeRoot.HasOppositeFactorPairs i)
  (hφ : IsRootDatumValuation i φ)
  (A : AddSubsemigroup (characterLattice T))

include hT hE

/-- Every selected actual root is selected-indivisible or twice one, using
the original opposite factor pairs rather than an affine root system. -/
theorem exists_semigroupIndivisibleRoot_eq_or_double
    {b : characterLattice T} (hb : b ∈ relativeRoots i) (hbA : b ∈ A) :
    ∃ a ∈ RelativeRoot.semigroupIndivisibleRoots i A, b = a ∨ b = 2 • a := by
  obtain ⟨a, ha, m, _, hm, hma⟩ :=
    RelativeRoot.exists_semigroupIndivisibleRoot_ray i hT hE A hb hbA
  refine ⟨a, ha, ?_⟩
  rcases hE.eq_one_or_two_of_nsmul_mem i hT (hma.symm ▸ hb) with h | h
  · left
    simpa only [h, one_smul] using hma.symm
  · right
    simpa only [h] using hma.symm

include hφ

/-- The prescribed selected-indivisible-root product equals the generated
subgroup. V3 collects all actual roots first; V4 absorbs each doubled factor. -/
theorem orderedRootFiltrationProduct_eq_selectedRootDepthSubgroup
    (ν : cocharacterLattice T)
    (hpos : ∀ b ∈ relativeRoots i, b ∈ A → 0 < latticePairing T b ν)
    (f : characterLattice T →+ ℝ)
    {n : ℕ} (a : Fin n → characterLattice T)
    (hrange : Set.range a = RelativeRoot.semigroupIndivisibleRoots i A) :
    orderedRootFiltrationProduct i φ a (fun j => f (a j)) =
      (selectedRootDepthSubgroup hφ A f : Set (rationalPoints G)) := by
  classical
  let Ψ := {b : characterLattice T | b ∈ relativeRoots i ∧ b ∈ A}
  have hdata : IsClosedPositiveRootDepth i ν Ψ f :=
    isClosedPositiveRootDepth_of_addSubsemigroup A ν hpos f
  let c : Fin (n * 2) → characterLattice T := fun l =>
    if (finProdFinEquiv.symm l).2 = 0 then a (finProdFinEquiv.symm l).1
      else 2 • a (finProdFinEquiv.symm l).1
  let H : Fin (n * 2) → Subgroup (rationalPoints G) := fun l =>
    if c l ∈ relativeRoots i then hφ.filtrationSubgroup (c l) (f (c l)) else ⊥
  have ha (j : Fin n) : a j ∈ RelativeRoot.semigroupIndivisibleRoots i A :=
    hrange ▸ Set.mem_range_self j
  have hc0 (j : Fin n) : c (finProdFinEquiv (j, 0)) = a j := by
    simp only [c, Equiv.symm_apply_apply, ↓reduceIte]
  have hc1 (j : Fin n) : c (finProdFinEquiv (j, 1)) = 2 • a j := by
    have h10 : (1 : Fin 2) ≠ 0 := by decide
    simp only [c, Equiv.symm_apply_apply, ite_eq_right h10]
  have hcΨ (l : Fin (n * 2)) (hl : c l ∈ relativeRoots i) : c l ∈ Ψ := by
    refine ⟨hl, ?_⟩
    dsimp only [c]
    split_ifs
    · exact (ha _).2.1
    · exact RelativeRoot.cyclicTail_one_le_of_mem (ha _).2.1
        ⟨2, by omega, by omega, rfl⟩
  have hcover (b : Ψ) : ∃ l, c l = b := by
    obtain ⟨d, hd, hb⟩ :=
      exists_semigroupIndivisibleRoot_eq_or_double hT hE A b.2.1 b.2.2
    obtain ⟨j, hj⟩ := (show d ∈ Set.range a by rw [hrange]; exact hd)
    rcases hb with hb | hb
    · exact ⟨finProdFinEquiv (j, 0), (hc0 j).trans (hj.trans hb.symm)⟩
    · exact ⟨finProdFinEquiv (j, 1),
        (hc1 j).trans ((congrArg (2 • ·) hj).trans hb.symm)⟩
  have hcollect :
      Set.range (RelativeRoot.CentralExtension.orderedProduct (fun l => (H l).subtype)) =
        ((⨆ l, H l : Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
    apply Langlands.GroupTheory.HeightCollection.range_orderedProduct_eq_iSup
      (w := fun l => (latticePairing T (c l) ν).toNat)
    intro j k
    by_cases hj : c j ∈ relativeRoots i
    · by_cases hk : c k ∈ relativeRoots i
      · have hjH : H j = hφ.filtrationSubgroup (c j) (f (c j)) := ite_eq_left hj
        have hkH : H k = hφ.filtrationSubgroup (c k) (f (c k)) := ite_eq_left hk
        rw [hjH, hkH]
        refine (positiveDepth_commutator_height hφ hdata (hcΨ j hj) (hcΨ k hk)).trans ?_
        refine iSup_le fun b => iSup_le fun hb => ?_
        obtain ⟨l, hl⟩ := hcover b
        have hroot : c l ∈ relativeRoots i := hl.symm ▸ b.2.1
        exact le_iSup_of_le l (le_iSup_of_le (hl.symm ▸ hb)
          (by dsimp only [H]; rw [ite_eq_left hroot, hl]))
      · simp only [H, ite_eq_right hk, Subgroup.commutator_bot_right, bot_le]
    · simp only [H, ite_eq_right hj, Subgroup.commutator_bot_left, bot_le]
  have h0 (j : Fin n) :
      H (finProdFinEquiv (j, 0)) = hφ.filtrationSubgroup (a j) (f (a j)) := by
    simp only [H, hc0, ite_eq_left (ha j).1]
  have h1 (j : Fin n) :
      H (finProdFinEquiv (j, 1)) ≤ hφ.filtrationSubgroup (a j) (f (a j)) := by
    simp only [H, hc1]
    split_ifs with h2a
    · simpa only [map_nsmul, nsmul_eq_mul, Nat.cast_ofNat] using
        hφ.filtrationSubgroup_double_le (ha j).1 h2a (r := f (a j)) le_rfl
    · exact bot_le
  change Set.range (RelativeRoot.CentralExtension.orderedProduct
    (fun j => (hφ.filtrationSubgroup (a j) (f (a j))).subtype)) = _
  rw [← range_orderedProduct_pairs H _ h0 h1, hcollect]
  apply congrArg (fun K : Subgroup (rationalPoints G) => (K : Set (rationalPoints G)))
  apply le_antisymm
  · refine iSup_le fun l => ?_
    dsimp only [H]
    split_ifs with hl
    · exact le_iSup (fun b : Ψ => hφ.filtrationSubgroup b (f b)) ⟨c l, hcΨ l hl⟩
    · exact bot_le
  · refine iSup_le fun b => ?_
    obtain ⟨l, hl⟩ := hcover b
    have hroot : c l ∈ relativeRoots i := hl.symm ▸ b.2.1
    exact le_iSup_of_le l (by dsimp only [H]; rw [ite_eq_left hroot, hl])

/-- Collection is independent of the selected enumeration and its length.
The product equality itself permits repetitions. -/
theorem orderedSelectedRootFiltrationProduct_order_independent
    (ν : cocharacterLattice T)
    (hpos : ∀ b ∈ relativeRoots i, b ∈ A → 0 < latticePairing T b ν)
    (f : characterLattice T →+ ℝ)
    {n m : ℕ} (a : Fin n → characterLattice T) (b : Fin m → characterLattice T)
    (ha : Set.range a = RelativeRoot.semigroupIndivisibleRoots i A)
    (hb : Set.range b = RelativeRoot.semigroupIndivisibleRoots i A) :
    orderedRootFiltrationProduct i φ a (fun j => f (a j)) =
      orderedRootFiltrationProduct i φ b (fun j => f (b j)) := by
  rw [orderedRootFiltrationProduct_eq_selectedRootDepthSubgroup hT hE hφ A ν hpos f a ha,
    orderedRootFiltrationProduct_eq_selectedRootDepthSubgroup hT hE hφ A ν hpos f b hb]

omit hE in
/-- The selected filtered subgroup lies inside the original actual semigroup
subgroup, without assuming any ordered factorization. -/
theorem selectedRootDepthSubgroup_le_semigroupSubgroup
    (f : characterLattice T →+ ℝ) :
    selectedRootDepthSubgroup hφ A f ≤
      (RelativeRoot.semigroupSubgroup (AutomorphicAction.conjugation i) A).carrier
        (Over.mk (𝟙 _)) := by
  refine iSup_le fun a => ?_
  have hroot : RelativeRoot.subgroup i a.val ≤
      RelativeRoot.semigroupSubgroup (AutomorphicAction.conjugation i) A := by
    rw [← RelativeRoot.weightFiltration_one_eq_subgroup hT i a.val a.2.1.1]
    exact RelativeRoot.semigroupSubgroup_mono _
      (RelativeRoot.cyclicTail_one_le_of_mem a.2.2)
  exact fun g hg => hroot _ hg.1

/-- Injective selected-root enumerations give unique actual filtered
coordinates. Uniqueness is inherited from the all-test scheme product. -/
theorem mem_selectedRootDepthSubgroup_iff_existsUnique
    (hzero : 0 ∉ A) (ν : cocharacterLattice T)
    (hpos : ∀ b ∈ relativeRoots i, b ∈ A → 0 < latticePairing T b ν)
    (f : characterLattice T →+ ℝ)
    {n : ℕ} (a : Fin n → characterLattice T) (hinj : Function.Injective a)
    (hrange : Set.range a = RelativeRoot.semigroupIndivisibleRoots i A)
    (g : rationalPoints G) :
    g ∈ selectedRootDepthSubgroup hφ A f ↔
      ∃! x : ∀ j, rootFiltration i φ (a j) (f (a j)),
        (List.ofFn fun j => (x j : rationalPoints G)).prod = g := by
  constructor
  · intro hg
    have hgprod : g ∈ orderedRootFiltrationProduct i φ a (fun j => f (a j)) := by
      rw [orderedRootFiltrationProduct_eq_selectedRootDepthSubgroup hT hE hφ A
        ν hpos f a hrange]
      exact hg
    obtain ⟨x, hx⟩ := hgprod
    have hgu := selectedRootDepthSubgroup_le_semigroupSubgroup hT hφ A f hg
    have hu := (RelativeRoot.mem_semigroupSubgroup_iff_existsUnique_rootPointsProduct
      i hT hE A hzero a hinj hrange (Over.mk (𝟙 _)) g).mp hgu
    let X : ∀ j, (RelativeRoot.subgroup i (a j)).carrier (Over.mk (𝟙 _)) :=
      fun j => ⟨(x j).val, (x j).property.1⟩
    refine ⟨x, hx, ?_⟩
    intro y hy
    let Y : ∀ j, (RelativeRoot.subgroup i (a j)).carrier (Over.mk (𝟙 _)) :=
      fun j => ⟨(y j).val, (y j).property.1⟩
    have hX : RelativeRoot.rootPointsProduct i a (Over.mk (𝟙 _)) X = g := hx
    have hY : RelativeRoot.rootPointsProduct i a (Over.mk (𝟙 _)) Y = g := hy
    have hYX : Y = X := hu.unique hY hX
    funext j
    apply Subtype.ext
    exact congrArg (fun z : (RelativeRoot.subgroup i (a j)).carrier
      (Over.mk (𝟙 _)) => z.val) (congrFun hYX j)
  · rintro ⟨x, hx, _⟩
    have hg : g ∈ orderedRootFiltrationProduct i φ a (fun j => f (a j)) := ⟨x, hx⟩
    rw [orderedRootFiltrationProduct_eq_selectedRootDepthSubgroup hT hE hφ A
      ν hpos f a hrange] at hg
    exact hg

end Collection

end Langlands.Geometry.Building
