import Langlands.Geometry.Building.AffineReflectionGalleryGeometry
import Mathlib.Analysis.Convex.KreinMilman
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-! # Compact facet closures are generated by their vertices -/

noncomputable section

universe u

namespace Langlands.Geometry.Building.AffineRootSystem

open Set GalleryGeometry

section Algebra

variable {V : Type u} [AddCommGroup V] [Module ℝ V]
  {Ψ : Set (V →ᵃ[ℝ] ℝ)}

/-- All vertices incident to the facet of a given point. -/
def facetClosureVertices (Ψ : Set (V →ᵃ[ℝ] ℝ)) (p : V) : Set V :=
  {q | q ∈ facetClosure Ψ p ∧ IsVertex Ψ q}

/-- A sufficiently short segment in a facet, centered at one of its points,
can be chosen in every direction joining two points of that facet. -/
theorem exists_pos_add_sub_mem_facet
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ) {x y : V}
    (hy : y ∈ facet Ψ x) :
    ∃ ε : ℝ, 0 < ε ∧ x + ε • (y - x) ∈ facet Ψ x ∧
      x - ε • (y - x) ∈ facet Ψ x := by
  obtain ⟨ε, hε, hp, hm⟩ := exists_pos_of_eventually
    ((eventually_sign_smul_vadd hΨ x (y - x)).and
      (eventually_sign_smul_vadd hΨ x (-(y - x))))
  have hzero : ∀ ψ ∈ Ψ, ψ x = 0 → ψ.linear (y - x) = 0 := by
    intro ψ hψ hx
    have hys : ψ y = 0 := by
      apply sign_eq_zero_iff.mp
      rw [← hy ψ hψ, hx, sign_zero]
    simpa only [vsub_eq_sub, hx, hys, sub_self] using ψ.linearMap_vsub y x
  refine ⟨ε, hε, ?_, ?_⟩
  · intro ψ hψ
    by_cases hx : ψ x = 0
    · rw [add_comm, ← vadd_eq_add, apply_smul_vadd, hzero ψ hψ hx, hx]
      simp
    · simpa only [vadd_eq_add, add_comm] using (hp ψ hψ hx).symm
  · intro ψ hψ
    by_cases hx : ψ x = 0
    · rw [sub_eq_add_neg, ← smul_neg, add_comm, ← vadd_eq_add,
        apply_smul_vadd, map_neg, hzero ψ hψ hx, hx]
      simp
    · simpa only [vadd_eq_add, smul_neg, neg_add_eq_sub, add_comm, sub_eq_add_neg]
        using (hm ψ hψ hx).symm

/-- Every extreme point of a facet closure is an actual zero-dimensional facet. -/
theorem isVertex_of_mem_extremePoints_facetClosure
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ) {p x : V}
    (hx : x ∈ (facetClosure Ψ p).extremePoints ℝ) : IsVertex Ψ x := by
  apply Set.Subset.antisymm ?_ (Set.singleton_subset_iff.2 (mem_facet_self Ψ x))
  intro y hy
  obtain ⟨ε, hε, hp, hm⟩ := exists_pos_add_sub_mem_facet hΨ hy
  have hsub : facet Ψ x ⊆ facetClosure Ψ p := facet_subset_facetClosure_iff.2 hx.1
  have heq : x + ε • (y - x) = x :=
    hx.2 (hsub hp) (hsub hm) (mem_openSegment_add_sub x (ε • (y - x)))
  have hz : ε • (y - x) = 0 :=
    add_left_cancel (show x + ε • (y - x) = x + 0 by simpa using heq)
  exact Set.mem_singleton_iff.2 (sub_eq_zero.mp ((smul_eq_zero.mp hz).resolve_left hε.ne'))

end Algebra

section Topology

variable {V : Type u} [NormedAddCommGroup V] [NormedSpace ℝ V]
  {Ψ : Set (V →ᵃ[ℝ] ℝ)}

/-- Compact convex facet closures are the closed convex hulls of their actual vertices. -/
theorem closure_convexHull_facetClosureVertices
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ) (p : V)
    (hc : IsCompact (facetClosure Ψ p)) (hv : Convex ℝ (facetClosure Ψ p)) :
    closure (convexHull ℝ (facetClosureVertices Ψ p)) = facetClosure Ψ p := by
  apply Set.Subset.antisymm
  · exact closure_minimal (convexHull_min (fun _ h => h.1) hv) hc.isClosed
  · rw [← closure_convexHull_extremePoints hc hv]
    apply closure_mono
    apply convexHull_mono
    intro x hx
    exact ⟨hx.1, isVertex_of_mem_extremePoints_facetClosure hΨ hx⟩

/-- A continuous affine map fixing the vertices of a compact convex facet closure
fixes the whole closure pointwise. -/
theorem eqOn_facetClosure_of_vertex_fixing
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ) (p : V)
    (hc : IsCompact (facetClosure Ψ p)) (hv : Convex ℝ (facetClosure Ψ p))
    (e : V →ᵃ[ℝ] V) (he : Continuous e)
    (hfix : ∀ q ∈ facetClosureVertices Ψ p, e q = q) :
    Set.EqOn e id (facetClosure Ψ p) := by
  have hclosed : IsClosed {q : V | e q = q} := isClosed_eq he continuous_id
  have hconvex : Convex ℝ {q : V | e q = q} := by
    have hset : {q : V | e q = q} =
        (e - AffineMap.id ℝ V) ⁻¹' ({0} : Set V) := by
      ext q
      change (e q = q) ↔ e q - q = 0
      exact sub_eq_zero.symm
    rw [hset]
    exact (convex_singleton (0 : V)).affine_preimage (e - AffineMap.id ℝ V)
  have hsub : closure (convexHull ℝ (facetClosureVertices Ψ p)) ⊆
      {q : V | e q = q} := closure_minimal (convexHull_min hfix hconvex) hclosed
  rwa [closure_convexHull_facetClosureVertices hΨ p hc hv] at hsub

/-- Setwise fixation of every incident facet suffices for pointwise fixation on
a compact convex facet closure. -/
theorem eqOn_facetClosure_of_face_fixing
    (hΨ : IsLocallyFiniteReflectionArrangement Ψ) (p : V)
    (hc : IsCompact (facetClosure Ψ p)) (hv : Convex ℝ (facetClosure Ψ p))
    (e : V →ᵃ[ℝ] V) (he : Continuous e)
    (hfix : ∀ q ∈ facetClosure Ψ p, e '' facet Ψ q = facet Ψ q) :
    Set.EqOn e id (facetClosure Ψ p) := by
  apply eqOn_facetClosure_of_vertex_fixing hΨ p hc hv e he
  intro q hq
  have hm : e q ∈ facet Ψ q := by
    rw [← hfix q hq.1]
    exact Set.mem_image_of_mem e (mem_facet_self Ψ q)
  rwa [hq.2, Set.mem_singleton_iff] at hm

end Topology

end Langlands.Geometry.Building.AffineRootSystem
