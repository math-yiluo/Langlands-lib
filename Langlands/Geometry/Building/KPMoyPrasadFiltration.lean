import Langlands.Geometry.Building.KPRealDepthSubgroups
import Langlands.AlgebraicGeometry.PointTopology.RationalPoints

/-!
# Moy–Prasad filtration subgroups on supplied data

A supplied filtration of `Z(F)` indexed by `ℝ≥0` (KP §7.2), the predicates it
must satisfy for KP Chapter 13, and the subgroup `P_{x,r}` generated by
`Z(F)_r` and the `U_{a,x,r}` (KP Definition 13.2.1, via Definition 7.3.3).
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Geometry.Building.ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- A decreasing separated filtration `(Z(F)_r)_{r ≥ 0}` of `Z(F)`, `Z = Z_G(S)`, with
`Z(F)_0 = Z(F)^0` (the first clauses of KP Definition 7.2.1). -/
structure CentralizerFiltration where
  /-- The filtration subgroup `Z(F)_r`. -/
  filtration : NNReal → Subgroup (rationalPoints P.centralizer.Z)
  filtration_zero : filtration 0 = P.centralizerZero
  antitone : Antitone filtration
  separated : ⨅ r, filtration r = ⊥

namespace CentralizerFiltration

variable {P} (Zf : P.CentralizerFiltration)

/-- The image `Z(F)_r ⊆ G(F)` of a filtration subgroup. -/
def image (r : NNReal) : Subgroup (rationalPoints G) :=
  (Zf.filtration r).map (rationalPoints.map P.centralizer.j)

theorem image_zero :
    Zf.image 0 = P.centralizerZero.map (rationalPoints.map P.centralizer.j) := by
  rw [image, Zf.filtration_zero]

theorem image_antitone : Antitone Zf.image :=
  fun _ _ h => Subgroup.map_mono (Zf.antitone h)

/-- KP Definition 7.2.1, commutator clause: for `u ∈ U_a(F)*`, `u' ∈ U_{-a}(F)*` and a point
`x` of the apartment with `r = x_a(u) + x_{-a}(u') > 0`, the `Z`-component `z` of the
commutator `u'⁻¹ u u' u⁻¹ ∈ U_{-a}(F) z U_a(F)` (KP Definition 7.1.3) lies in `Z(F)_r`. -/
def IsCommutatorFriendly : Prop :=
  ∀ (x : P.Apartment) (a : relativeRoots P.i) (u u' : rationalPoints G),
    u ∈ P.rootGroup a.1 → u ≠ 1 → u' ∈ P.rootGroup (-a.1) → u' ≠ 1 →
    ∀ r : NNReal, 0 < r → (((r : ℝ) : WithTop ℝ) = x.val a.1 u + x.val (-a.1) u') →
    ∀ (v' v : rationalPoints G) (z : rationalPoints P.centralizer.Z),
      v' ∈ P.rootGroup (-a.1) → v ∈ P.rootGroup a.1 →
      u'⁻¹ * u * u' * u⁻¹ = v' * rationalPoints.map P.centralizer.j z * v →
      z ∈ Zf.filtration r

/-- Every `Z(F)_r` is stable under conjugation by `N(F)`. -/
def IsNormalizerStable : Prop :=
  ∀ n ∈ normalizerPoints P.i, ∀ r : NNReal,
    (Zf.image r).map (MulAut.conj n).toMonoidHom = Zf.image r

/-- `[Z(F)_r, Z(F)_s] ⊆ Z(F)_{r+s}`. -/
def IsCommutatorFiltered : Prop :=
  ∀ r s : NNReal, ⁅Zf.filtration r, Zf.filtration s⁆ ≤ Zf.filtration (r + s)

/-- For `z ∈ Z(F)_r` and `u ∈ U_{a,x,s}` with `s ≥ 0`, the commutator `z u z⁻¹ u⁻¹` lies in
the block `U_{a,x,r+s} U_{2a,x,r+s}` of KP Definition 7.3.3(1). For a multipliable root the
`2a`-factor cannot be omitted. -/
def IsRootCompatible : Prop :=
  ∀ (x : P.Apartment) (a : relativeRoots P.i) (r s : NNReal),
    ∀ z ∈ Zf.image r, ∀ u ∈ P.filtration x a.1 s,
      z * u * z⁻¹ * u⁻¹ ∈ P.apartment.filtrationBlock x (fun _ => ((r + s : NNReal) : ℝ)) a.1

/-- The four algebraic properties of the actual filtration of KP §9.8 used by the
Moy–Prasad statements. -/
def SatisfiesFiltrationAxioms : Prop :=
  Zf.IsCommutatorFriendly ∧ Zf.IsNormalizerStable ∧ Zf.IsCommutatorFiltered ∧
    Zf.IsRootCompatible

/-- Every `Z(F)_r` is open in `Z(F)` for the point topology. -/
def IsOpenFiltration : Prop :=
  letI : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  letI : IsAffine P.centralizer.Z.X.left := by
    have : IsClosedImmersion P.centralizer.j.hom.hom.left :=
      P.centralizer.isClosedSubgroup
    exact isAffine_of_isAffineHom P.centralizer.j.hom.hom.left
  letI : TopologicalSpace (rationalPoints P.centralizer.Z) :=
    rationalPointTopology F P.centralizer.Z.X
  ∀ r : NNReal, IsOpen (Zf.filtration r : Set (rationalPoints P.centralizer.Z))

/-! ### Moy–Prasad subgroups -/

/-- The Moy–Prasad filtration subgroup `P_{x,r}` (KP Definition 13.2.1): the subgroup of
`G(F)` generated by `Z(F)_r` and the blocks `U_{a,x,r} U_{2a,x,r}` of KP Definition 7.3.3
at the constant function `r`. -/
def moyPrasad (x : P.Apartment) (r : NNReal) : Subgroup (rationalPoints G) :=
  Zf.image r ⊔ P.apartment.sharpFiltration x (fun _ => (r : ℝ))

theorem image_le_moyPrasad (x : P.Apartment) (r : NNReal) : Zf.image r ≤ Zf.moyPrasad x r :=
  le_sup_left

theorem filtration_le_moyPrasad (x : P.Apartment) (a : relativeRoots P.i) (r : NNReal) :
    P.filtration x a.1 r ≤ Zf.moyPrasad x r := by
  refine le_trans ?_ le_sup_right
  rw [P.apartment.sharpFiltration_eq_iSup]
  exact le_iSup (fun b : relativeRoots P.i => P.apartment.filtration x b.1 (r : ℝ)) a

/-- `P_{x,0} = P_x`, the parahoric subgroup of the point `x`. -/
theorem moyPrasad_zero (x : P.Apartment) : Zf.moyPrasad x 0 = P.parahoricAt x := by
  rw [moyPrasad, image_zero, NNReal.coe_zero]
  exact P.zeroCentralFiltration_zero x

theorem moyPrasad_antitone (x : P.Apartment) : Antitone (Zf.moyPrasad x) := by
  intro r s h
  refine sup_le_sup (Zf.image_antitone h) ?_
  rw [P.apartment.sharpFiltration_eq_iSup, P.apartment.sharpFiltration_eq_iSup]
  exact iSup_mono fun a => P.apartment.filtration_antitone x a.1 (NNReal.coe_le_coe.2 h)

/-- `P_{x,r} ⊆ P_x`. -/
theorem moyPrasad_le_parahoricAt (x : P.Apartment) (r : NNReal) :
    Zf.moyPrasad x r ≤ P.parahoricAt x :=
  Zf.moyPrasad_zero x ▸ Zf.moyPrasad_antitone x (zero_le : (0 : NNReal) ≤ r)

/-- The strict-depth group `P_{x,r+} = ⋃_{s > r} P_{x,s}` (KP §1.6 convention). -/
def moyPrasadPlus (x : P.Apartment) (r : NNReal) : Subgroup (rationalPoints G) :=
  ⨆ (s : NNReal) (_ : r < s), Zf.moyPrasad x s

theorem moyPrasadPlus_le (x : P.Apartment) (r : NNReal) :
    Zf.moyPrasadPlus x r ≤ Zf.moyPrasad x r :=
  iSup₂_le fun _ hs => Zf.moyPrasad_antitone x hs.le

/-! ### Points of the reduced building -/

/-- `Q` is a Moy–Prasad subgroup of depth `r` at the point `y` of the reduced building:
`Q = g P_{x,r} g⁻¹` for some `g ∈ G(F)` and some `x ∈ A` with `y = g · x`. -/
def IsMoyPrasadAt (y : P.ReducedBuilding) (r : NNReal) (Q : Subgroup (rationalPoints G)) :
    Prop :=
  ∃ (g : rationalPoints G) (x : P.Apartment),
    g • P.apartmentMap x = y ∧ Q = (Zf.moyPrasad x r).map (MulAut.conj g).toMonoidHom

theorem isMoyPrasadAt_apartmentMap (x : P.Apartment) (r : NNReal) :
    Zf.IsMoyPrasadAt (P.apartmentMap x) r (Zf.moyPrasad x r) :=
  ⟨1, x, one_smul _ _, (map_conj_one _).symm⟩

theorem IsMoyPrasadAt.smul {Zf : P.CentralizerFiltration} {y : P.ReducedBuilding} {r : NNReal}
    {Q : Subgroup (rationalPoints G)} (hQ : Zf.IsMoyPrasadAt y r Q) (h : rationalPoints G) :
    Zf.IsMoyPrasadAt (h • y) r (Q.map (MulAut.conj h).toMonoidHom) := by
  obtain ⟨g, x, rfl, rfl⟩ := hQ
  exact ⟨h * g, x, mul_smul h g _, map_conj_map_conj _ g h⟩

theorem exists_isMoyPrasadAt (y : P.ReducedBuilding) (r : NNReal) :
    ∃ Q, Zf.IsMoyPrasadAt y r Q := by
  obtain ⟨g, x, rfl⟩ := P.exists_smul_apartmentMap y
  exact ⟨_, (Zf.isMoyPrasadAt_apartmentMap x r).smul g⟩

end CentralizerFiltration

end Langlands.Geometry.Building.ParahoricBuildingData
