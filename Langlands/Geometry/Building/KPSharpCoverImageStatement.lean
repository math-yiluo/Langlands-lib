import Langlands.Geometry.Building.KPParahoric

/-! # Actual root groups and sharp fixers in the simply connected image -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme

namespace Langlands.Geometry.Building

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

namespace ZeroSubgroupDatum

variable {S : CommGroupScheme (Spec (CommRingCat.of F))}
  {G Z : GroupScheme (Spec (CommRingCat.of F))}
  {i : S.toGrp ⟶ G} {j : Z ⟶ G} (E : ZeroSubgroupDatum i j)

/-- The actual relative root groups lift on rational points through the supplied
simply connected derived cover. This is the algebraic input for the
simply connected reduction in KP Lemma 7.3.16. -/
def RootGroupLeSimplyConnectedImageStatement : Prop :=
  haveI := E.isSimplyConnectedDerivedCover.isConnectedReductive.isAffineHom
  ∀ a ∈ relativeRoots i, rootGroupPoints i a ≤ E.simplyConnectedImage

end ZeroSubgroupDatum

namespace ParahoricBuildingData

variable {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- Every actual sharp fixer lies in the actual simply connected image.
No nonemptiness or apartment-axiom premise is needed for this algebraic
containment, including the sharp subgroup generated by all root groups. -/
def SharpFixerLeSimplyConnectedImageStatement : Prop :=
  ∀ Ω : Set P.Apartment, P.sharpFixer Ω ≤ P.simplyConnectedImage

/-- Root-group rational lifting implies the sharp-fixer containment. -/
theorem sharpFixer_le_simplyConnectedImage_of_rootGroups
    (h : P.zeroDatum.RootGroupLeSimplyConnectedImageStatement)
    (Ω : Set P.Apartment) : P.sharpFixer Ω ≤ P.simplyConnectedImage := by
  change (⨆ a : relativeRoots P.i, P.apartment.rootFixer a Ω) ≤ P.simplyConnectedImage
  refine iSup_le fun a u hu => ?_
  exact h a a.property (P.apartment.mem_rootFixer.mp hu).1

/-- Empty-set sharp fixers contain every relative root group, so the
all-subset containment has exactly the root-group lifting content. -/
theorem rootGroupLeSimplyConnectedImage_iff_sharpFixer :
    P.zeroDatum.RootGroupLeSimplyConnectedImageStatement ↔
      P.SharpFixerLeSimplyConnectedImageStatement := by
  constructor
  · exact fun h Ω => P.sharpFixer_le_simplyConnectedImage_of_rootGroups h Ω
  · intro h a ha u hu
    apply h ∅
    apply P.apartment.rootFixer_le_sharpFixer ⟨a, ha⟩ ∅
    exact P.apartment.mem_rootFixer.mpr ⟨hu, by simp⟩

/-- The actual sharp-fixer containment also puts the full parahoric in the
actual zero subgroup, using its unchanged join definition. -/
theorem parahoric_le_zeroSubgroup_of_rootGroups
    (h : P.zeroDatum.RootGroupLeSimplyConnectedImageStatement)
    (Ω : Set P.Apartment) : P.parahoric Ω ≤ P.zeroSubgroup := by
  apply sup_le
  · exact P.zeroDatum.map_centralizerZero_le_zeroSubgroup
  · exact (P.sharpFixer_le_simplyConnectedImage_of_rootGroups h Ω).trans
      P.zeroDatum.simplyConnectedImage_le_zeroSubgroup

end ParahoricBuildingData

end Langlands.Geometry.Building
