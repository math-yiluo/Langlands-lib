import Langlands.Geometry.Building.MoyPrasadDoubleRootConjugation
import Langlands.Geometry.Building.RootFixerExchange

/-! # Commutators of Moy–Prasad subgroups at one apartment point -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj Pointwise TensorProduct commutatorElement
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

/-- Commutators of two generated subgroups lie in `N` once the generators lie in a
subgroup normalizing `N` and all commutators of generators lie in `N`. -/
theorem commutator_closure_le_of_le_normalizer {M : Type*} [Group M] {N K : Subgroup M}
    (hK : K ≤ Subgroup.normalizer (N : Set M)) {S T : Set M} (hS : S ⊆ K) (hT : T ⊆ K)
    (h : ∀ g ∈ S, ∀ k ∈ T, ⁅g, k⁆ ∈ N) :
    ⁅Subgroup.closure S, Subgroup.closure T⁆ ≤ N := by
  have hnorm : ∀ g ∈ K, ∀ n ∈ N, g * n * g⁻¹ ∈ N := Subgroup.le_normalizer_iff.mp hK
  have hclS : Subgroup.closure S ≤ K := (Subgroup.closure_le K).mpr hS
  have hclT : Subgroup.closure T ≤ K := (Subgroup.closure_le K).mpr hT
  have hright : ∀ g ∈ S, ∀ k ∈ Subgroup.closure T, ⁅g, k⁆ ∈ N := by
    intro g hg k hk
    induction hk using Subgroup.closure_induction with
    | mem k hk => exact h g hg k hk
    | one =>
      rw [commutatorElement_one_right]
      exact N.one_mem
    | mul k₁ k₂ hk₁ hk₂ ih₁ ih₂ =>
      have heq : ⁅g, k₁ * k₂⁆ = ⁅g, k₁⁆ * (k₁ * ⁅g, k₂⁆ * k₁⁻¹) := by
        simp only [commutatorElement_def]
        group
      rw [heq]
      exact N.mul_mem ih₁ (hnorm k₁ (hclT hk₁) _ ih₂)
    | inv k hk ih =>
      have heq : ⁅g, k⁻¹⁆ = k⁻¹ * ⁅g, k⁆⁻¹ * k⁻¹⁻¹ := by
        simp only [commutatorElement_def]
        group
      rw [heq]
      exact hnorm k⁻¹ (K.inv_mem (hclT hk)) _ (N.inv_mem ih)
  rw [Subgroup.commutator_le]
  intro g hg k hk
  induction hg using Subgroup.closure_induction with
  | mem g hg => exact hright g hg k hk
  | one =>
    rw [commutatorElement_one_left]
    exact N.one_mem
  | mul g₁ g₂ hg₁ hg₂ ih₁ ih₂ =>
    have heq : ⁅g₁ * g₂, k⁆ = g₁ * ⁅g₂, k⁆ * g₁⁻¹ * ⁅g₁, k⁆ := by
      simp only [commutatorElement_def]
      group
    rw [heq]
    exact N.mul_mem (hnorm g₁ (hclS hg₁) _ ih₂) ih₁
  | inv g hg ih =>
    have heq : ⁅g⁻¹, k⁆ = g⁻¹ * ⁅g, k⁆⁻¹ * g⁻¹⁻¹ := by
      simp only [commutatorElement_def]
      group
    rw [heq]
    exact hnorm g⁻¹ (K.inv_mem (hclS hg)) _ (N.inv_mem ih)

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G)

/-- Every actual relative root takes every real value on `V(S)`. -/
theorem exists_eval_eq_of_mem_relativeRoots {a : characterLattice P.S}
    (ha : a ∈ relativeRoots P.i) (c : ℝ) : ∃ w : V P.S, eval P.S a w = c := by
  let : Smooth G.X.hom := P.isConnectedReductive.smooth
  obtain ⟨ν, hν⟩ := P.isMaximalSplitTorus.isSplitSubtorus.1.exists_genericCocharacter P.i
  have hp : ((latticePairing P.S a ν : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hν a ha
  refine ⟨(c / (latticePairing P.S a ν : ℝ)) ⊗ₜ[ℤ] ν, ?_⟩
  rw [eval_tmul]
  field_simp

/-- Membership in a root filtration at the translated point `x + w`. -/
theorem mem_filtration_vadd_of_mem {x : P.Apartment} (w : V P.S) {a : characterLattice P.S}
    {ρ ρ' : ℝ} {g : rationalPoints G} (hg : g ∈ P.filtration x a ρ')
    (h : ρ - eval P.S a w ≤ ρ') :
    g ∈ P.filtration ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x)
      a ρ := by
  change g ∈ P.apartment.filtration _ a ρ
  rw [KPApartmentData.filtration_mk_vadd]
  exact P.apartment.filtration_antitone x a h hg

/-- Membership in a root filtration at `x` from membership at the translated point. -/
theorem mem_filtration_of_mem_vadd {x : P.Apartment} (w : V P.S) {a : characterLattice P.S}
    {ρ ρ' : ℝ} {g : rationalPoints G}
    (hg : g ∈ P.filtration ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x)
      a ρ)
    (h : ρ' ≤ ρ - eval P.S a w) : g ∈ P.filtration x a ρ' := by
  change g ∈ P.apartment.filtration _ a ρ at hg
  rw [KPApartmentData.filtration_mk_vadd] at hg
  exact P.apartment.filtration_antitone x a h hg

namespace CentralizerFiltration

variable {P} (Zf : P.CentralizerFiltration)

/-- `P_{x,r}` is generated by `j(Z(F)_r)` and the root filtrations `U_{b,x,r}`. -/
theorem moyPrasad_eq_closure (x : P.Apartment) (r : NNReal) :
    Zf.moyPrasad x r = Subgroup.closure ((Zf.image r : Set (rationalPoints G)) ∪
      ⋃ b : relativeRoots P.i, (P.filtration x b.1 r : Set (rationalPoints G))) := by
  rw [Subgroup.closure_union, Subgroup.closure_iUnion, Subgroup.closure_eq, moyPrasad,
    P.apartment.sharpFiltration_eq_iSup]
  simp only [Subgroup.closure_eq]

/-- A block at a translated point lies in `P_{x,D}` when both its depths, read at `x`,
are at least `D`. -/
theorem filtrationBlock_vadd_subset_moyPrasad (x : P.Apartment) (w : V P.S)
    {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i) (R : ℝ) (D : NNReal)
    (h1 : (D : ℝ) ≤ R - eval P.S a w) (h2 : (D : ℝ) ≤ R - 2 * eval P.S a w) :
    P.apartment.filtrationBlock
        ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x)
        (fun _ => R) a ⊆ Zf.moyPrasad x D := by
  rintro g ⟨d1, hd1, d2, hd2, rfl⟩
  refine (Zf.moyPrasad x D).mul_mem ?_ ?_
  · exact Zf.filtration_le_moyPrasad x ⟨a, ha⟩ D (P.mem_filtration_of_mem_vadd w hd1 h1)
  · by_cases h2a : 2 • a ∈ relativeRoots P.i
    · have hd2' : d2 ∈ P.filtration
          ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x)
          (2 • a) R := by
        have h := hd2
        simp only [SetLike.mem_coe] at h
        rwa [P.apartment.doubleFiltration_of_mem _ a _ h2a] at h
      refine Zf.filtration_le_moyPrasad x ⟨2 • a, h2a⟩ D
        (P.mem_filtration_of_mem_vadd w hd2' ?_)
      rw [eval_nsmul_char]
      push_cast
      linarith
    · have h := hd2
      simp only [SetLike.mem_coe] at h
      rw [P.apartment.doubleFiltration_of_not_mem _ a _ h2a, Subgroup.mem_bot] at h
      rw [h]
      exact (Zf.moyPrasad x D).one_mem

/-- Abstract opposite-root bookkeeping: knowing both conjugation coordinates of an
opposite pair, together with its exchange factorization, places the commutator in `N`. -/
theorem commutator_mem_of_opposite_coordinates
    {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i) (N : Subgroup (rationalPoints G))
    {u v v₁ u₁ c : rationalPoints G}
    (hu : u ∈ rootGroupPoints P.i a) (hv : v ∈ rootGroupPoints P.i (-a))
    (hv₁ : v₁ ∈ rootGroupPoints P.i (-a)) (hc : c ∈ centralizerPoints P.i)
    (hu₁ : u₁ ∈ rootGroupPoints P.i a) (heq : v₁ * c * u₁ = u * v) (hcN : c ∈ N)
    (hB : ∃ n ∈ rootGroupPoints P.i (-a), ∃ c' ∈ centralizerPoints P.i,
      ∃ q ∈ rootGroupPoints P.i a, q ∈ N ∧ u * v * u⁻¹ = n * c' * q)
    (hC : ∃ m ∈ rootGroupPoints P.i a, ∃ c' ∈ centralizerPoints P.i,
      ∃ q ∈ rootGroupPoints P.i (-a), q ∈ N ∧ v⁻¹ * u⁻¹ * v = m * c' * q)
    (hvN : v ∈ Subgroup.normalizer (N : Set (rationalPoints G))) :
    ⁅u, v⁆ ∈ N := by
  obtain ⟨n, hn, c', hc', q, hq, hqN, hBeq⟩ := hB
  obtain ⟨m, hm, c'', hc'', q', hq', hq'N, hCeq⟩ := hC
  -- the positive coordinate `u₁ u⁻¹`
  have hcompB : v₁ * c * (u₁ * u⁻¹) = n * c' * q := by
    rw [← hBeq, ← mul_assoc, heq]
  have huniqB := P.oppositeRootTripleProduct_injective ha
    (a₁ := (⟨v₁, hv₁⟩, ⟨c, hc⟩,
      ⟨u₁ * u⁻¹, (rootGroupPoints P.i a).mul_mem hu₁ ((rootGroupPoints P.i a).inv_mem hu)⟩))
    (a₂ := (⟨n, hn⟩, ⟨c', hc'⟩, ⟨q, hq⟩)) hcompB
  have hpos : u₁ * u⁻¹ = q :=
    congrArg (fun p : rootGroupPoints P.i (-a) × centralizerPoints P.i ×
      rootGroupPoints P.i a => (p.2.2 : rationalPoints G)) huniqB
  -- the negative coordinate `v⁻¹ v₁`
  have hcompC : (v⁻¹ * v₁) * c * u₁ = q'⁻¹ * c''⁻¹ * m⁻¹ := by
    have h1 : v⁻¹ * u * v = (v⁻¹ * u⁻¹ * v)⁻¹ := by group
    calc (v⁻¹ * v₁) * c * u₁ = v⁻¹ * (v₁ * c * u₁) := by group
      _ = v⁻¹ * u * v := by rw [heq]; group
      _ = (m * c'' * q')⁻¹ := by rw [h1, hCeq]
      _ = q'⁻¹ * c''⁻¹ * m⁻¹ := by group
  have huniqC := P.oppositeRootTripleProduct_injective ha
    (a₁ := (⟨v⁻¹ * v₁, (rootGroupPoints P.i (-a)).mul_mem
        ((rootGroupPoints P.i (-a)).inv_mem hv) hv₁⟩, ⟨c, hc⟩, ⟨u₁, hu₁⟩))
    (a₂ := (⟨q'⁻¹, (rootGroupPoints P.i (-a)).inv_mem hq'⟩,
      ⟨c''⁻¹, (centralizerPoints P.i).inv_mem hc''⟩,
      ⟨m⁻¹, (rootGroupPoints P.i a).inv_mem hm⟩)) hcompC
  have hneg : v⁻¹ * v₁ = q'⁻¹ :=
    congrArg (fun p : rootGroupPoints P.i (-a) × centralizerPoints P.i ×
      rootGroupPoints P.i a => (p.1 : rationalPoints G)) huniqC
  -- assemble
  have hcomm : ⁅u, v⁆ = v * ((v⁻¹ * v₁) * c * (u₁ * u⁻¹)) * v⁻¹ := by
    rw [commutatorElement_def]
    calc u * v * u⁻¹ * v⁻¹ = (u * v) * u⁻¹ * v⁻¹ := by group
      _ = (v₁ * c * u₁) * u⁻¹ * v⁻¹ := by rw [heq]
      _ = v * ((v⁻¹ * v₁) * c * (u₁ * u⁻¹)) * v⁻¹ := by group
  rw [hcomm, hneg, hpos]
  exact (Subgroup.le_normalizer_iff.mp (le_refl _ : Subgroup.normalizer
    (N : Set (rationalPoints G)) ≤ _)) v hvN _
    (N.mul_mem (N.mul_mem (N.inv_mem hq'N) hcN) hqN)

/-- **Ordinary opposite pairs.** For `r, s > 0`, `u ∈ U_{a,x,r}` and `v ∈ U_{-a,x,s}`, the
commutator `⁅u, v⁆` lies in `P_{x,r+s}`, provided `v` normalizes `P_{x,r+s}`. -/
theorem commutator_opposite_mem_moyPrasad
    (hP : P.SatisfiesApartmentAxioms) (hZ : Zf.IsCommutatorFriendly)
    (x : P.Apartment) {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i)
    (r s : NNReal) (hr : 0 < r) (hs : 0 < s) {u v : rationalPoints G}
    (hu : u ∈ P.filtration x a r) (hv : v ∈ P.filtration x (-a) s)
    (hvN : v ∈ Subgroup.normalizer (Zf.moyPrasad x (r + s) : Set (rationalPoints G))) :
    ⁅u, v⁆ ∈ Zf.moyPrasad x (r + s) := by
  let : Smooth G.X.hom := P.isConnectedReductive.smooth
  have hna : -a ∈ relativeRoots P.i :=
    KPApartmentData.neg_mem_relativeRoots_of_rankOne
      P.isMaximalSplitTorus.isSplitSubtorus.1
      (rootRankOneFactorization F G P.isConnectedReductive P.S P.i P.isMaximalSplitTorus)
      x ha
  have hpos : 0 < r + s := add_pos hr hs
  have hr' : (0 : ℝ) < r := hr
  have hs' : (0 : ℝ) < s := hs
  obtain ⟨v₁, hv₁, z, hz, u₁, hu₁, heq⟩ :=
    Zf.exists_rankOne_depth_factorization hZ x ha r s hpos hu hv
  -- the positive coordinate, at the point where `u` has depth zero
  obtain ⟨w, hw⟩ := P.exists_eval_eq_of_mem_relativeRoots ha (-(r : ℝ))
  have huy : u ∈ P.filtration
      ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x) a 0 :=
    P.mem_filtration_vadd_of_mem w hu (by rw [hw]; simp)
  have hvy : v ∈ P.filtration
      ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x) (-a)
      ((r + s : NNReal) : ℝ) :=
    P.mem_filtration_vadd_of_mem w hv (by rw [eval_neg_char, hw]; push_cast; linarith)
  obtain ⟨_, ⟨n, hn, c', hc', rfl⟩, q, hq, hBeq⟩ :=
    P.conjugate_opposite_mem_root_centralizer_block hP _ ha (r + s) hpos huy hvy
  have hqN : q ∈ Zf.moyPrasad x (r + s) :=
    Zf.filtrationBlock_vadd_subset_moyPrasad x w ha _ (r + s)
      (by rw [hw]; push_cast; linarith) (by rw [hw]; push_cast; linarith) hq
  -- the negative coordinate, at the point where `v` has depth zero
  obtain ⟨w', hw'⟩ := P.exists_eval_eq_of_mem_relativeRoots ha (s : ℝ)
  have hvy' : v⁻¹ ∈ P.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace P.i) +ᵥ x) (-a) 0 :=
    P.mem_filtration_vadd_of_mem w' ((P.filtration x (-a) s).inv_mem hv)
      (by rw [eval_neg_char, hw']; simp)
  have huy' : u⁻¹ ∈ P.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace P.i) +ᵥ x) (-(-a))
      ((r + s : NNReal) : ℝ) := by
    rw [neg_neg]
    exact P.mem_filtration_vadd_of_mem w' ((P.filtration x a r).inv_mem hu)
      (by rw [hw']; push_cast; linarith)
  obtain ⟨_, ⟨m, hm, c'', hc'', rfl⟩, q', hq', hCeq⟩ :=
    P.conjugate_opposite_mem_root_centralizer_block hP _ hna (r + s) hpos hvy' huy'
  have hq'N : q' ∈ Zf.moyPrasad x (r + s) :=
    Zf.filtrationBlock_vadd_subset_moyPrasad x w' hna _ (r + s)
      (by rw [eval_neg_char, hw']; push_cast; linarith)
      (by rw [eval_neg_char, hw']; push_cast; linarith) hq'
  refine commutator_mem_of_opposite_coordinates ha (Zf.moyPrasad x (r + s)) hu.1 hv.1 hv₁.1
    (map_mem_centralizerPoints P.centralizer.isRepresentedBy z) hu₁.1 heq
    (Zf.image_le_moyPrasad x (r + s) ⟨z, hz, rfl⟩)
    ⟨n, hn, c', hc', q, P.apartment.filtrationBlock_subset_rootGroupPoints _ _ a hq, hqN,
      hBeq.symm⟩
    ⟨m, by simpa only [neg_neg, SetLike.mem_coe] using hm, c'', hc'', q',
      P.apartment.filtrationBlock_subset_rootGroupPoints _ _ (-a) hq', hq'N,
      by simpa only [inv_inv] using hCeq.symm⟩ hvN

/-- **Mixed pairs.** For `r, s > 0`, a root `a` with `2a` a root, `u ∈ U_{a,x,r}` and
`v ∈ U_{-2a,x,s}`, the commutator `⁅u, v⁆` lies in `P_{x,r+s}` under double-root
commutator friendliness, provided `v` normalizes `P_{x,r+s}`. -/
theorem commutator_double_opposite_mem_moyPrasad
    (hP : P.SatisfiesApartmentAxioms) (hZ : Zf.IsCommutatorFriendly)
    (hZ2 : Zf.IsDoubleRootCommutatorFriendly)
    (x : P.Apartment) {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i)
    (h2a : 2 • a ∈ relativeRoots P.i)
    (r s : NNReal) (hr : 0 < r) (hs : 0 < s) {u v : rationalPoints G}
    (hu : u ∈ P.filtration x a r) (hv : v ∈ P.filtration x (-(2 • a)) s)
    (hvN : v ∈ Subgroup.normalizer (Zf.moyPrasad x (r + s) : Set (rationalPoints G))) :
    ⁅u, v⁆ ∈ Zf.moyPrasad x (r + s) := by
  let : Smooth G.X.hom := P.isConnectedReductive.smooth
  have hna : -a ∈ relativeRoots P.i :=
    KPApartmentData.neg_mem_relativeRoots_of_rankOne
      P.isMaximalSplitTorus.isSplitSubtorus.1
      (rootRankOneFactorization F G P.isConnectedReductive P.S P.i P.isMaximalSplitTorus)
      x ha
  have h2na : 2 • (-a) ∈ relativeRoots P.i := by
    have hn := KPApartmentData.neg_mem_relativeRoots_of_rankOne
      P.isMaximalSplitTorus.isSplitSubtorus.1
      (rootRankOneFactorization F G P.isConnectedReductive P.S P.i P.isMaximalSplitTorus)
      x h2a
    simpa only [smul_neg] using hn
  have hr' : (0 : ℝ) < r := hr
  have hs' : (0 : ℝ) < s := hs
  have hvHalf : v ∈ P.filtration x (-a) ((s / 2 : NNReal) : ℝ) := by
    have h := P.apartment.filtration_double_le_half x hna h2na (s : ℝ)
      (by simpa only [smul_neg] using hv)
    simpa only [NNReal.coe_div, NNReal.coe_ofNat] using h
  have hpos : 0 < r + s / 2 := add_pos hr (div_pos hs (by norm_num))
  obtain ⟨v₁, hv₁, z, -, u₁, hu₁, heq⟩ :=
    Zf.exists_rankOne_depth_factorization hZ x ha r (s / 2) hpos hu hvHalf
  -- the point where `u` has depth zero
  obtain ⟨w, hw⟩ := P.exists_eval_eq_of_mem_relativeRoots ha (-(r : ℝ))
  have huy : u ∈ P.filtration
      ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x) a 0 :=
    P.mem_filtration_vadd_of_mem w hu (by rw [hw]; simp)
  have hvy : v ∈ P.filtration
      ((Submodule.Quotient.mk w : TranslationSpace P.i) +ᵥ x) (-(2 • a))
      ((s + 2 * r : NNReal) : ℝ) :=
    P.mem_filtration_vadd_of_mem w hv
      (by rw [eval_neg_char, eval_nsmul_char, hw]; push_cast; linarith)
  have hpos2 : 0 < s + 2 * r := add_pos hs (mul_pos (by norm_num) hr)
  -- the central coordinate, by double-root commutator friendliness
  have hzD : z ∈ Zf.filtration (s + 2 * r) :=
    Zf.double_opposite_central_mem_of_doubleRootCommutatorFriendly hZ2 _ ha h2a
      (s + 2 * r) hpos2 huy hvy v₁ hv₁.1 z u₁ hu₁.1 heq
  have hz : z ∈ Zf.filtration (r + s) := by
    refine Zf.antitone ?_ hzD
    apply NNReal.coe_le_coe.mp
    push_cast
    linarith
  -- the positive coordinate
  obtain ⟨_, ⟨n, hn, c', hc', rfl⟩, q, hq, hBeq⟩ :=
    P.conjugate_double_opposite_mem_root_centralizer_block hP _ ha h2a (s + 2 * r) hpos2
      huy hvy
  have hqN : q ∈ Zf.moyPrasad x (r + s) :=
    Zf.filtrationBlock_vadd_subset_moyPrasad x w ha _ (r + s)
      (by rw [hw]; push_cast; linarith) (by rw [hw]; push_cast; linarith) hq
  -- the negative coordinate, at the point where `v` has ordinary depth zero
  obtain ⟨w', hw'⟩ := P.exists_eval_eq_of_mem_relativeRoots ha ((s : ℝ) / 2)
  have hvy' : v⁻¹ ∈ P.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace P.i) +ᵥ x) (-a) 0 :=
    P.mem_filtration_vadd_of_mem w' ((P.filtration x (-a) _).inv_mem hvHalf)
      (by rw [eval_neg_char, hw']; push_cast; linarith)
  have huy' : u⁻¹ ∈ P.filtration
      ((Submodule.Quotient.mk w' : TranslationSpace P.i) +ᵥ x) (-(-a))
      ((r + s / 2 : NNReal) : ℝ) := by
    rw [neg_neg]
    exact P.mem_filtration_vadd_of_mem w' ((P.filtration x a r).inv_mem hu)
      (by rw [hw']; push_cast; linarith)
  obtain ⟨_, ⟨m, hm, c'', hc'', rfl⟩, q', hq', hCeq⟩ :=
    P.conjugate_opposite_mem_root_centralizer_block hP _ hna (r + s / 2) hpos hvy' huy'
  have hq'N : q' ∈ Zf.moyPrasad x (r + s) :=
    Zf.filtrationBlock_vadd_subset_moyPrasad x w' hna _ (r + s)
      (by rw [eval_neg_char, hw']; push_cast; linarith)
      (by rw [eval_neg_char, hw']; push_cast; linarith) hq'
  have hv2 : v ∈ rootGroupPoints P.i (-a) := hvHalf.1
  refine commutator_mem_of_opposite_coordinates ha (Zf.moyPrasad x (r + s)) hu.1 hv2 hv₁.1
    (map_mem_centralizerPoints P.centralizer.isRepresentedBy z) hu₁.1 heq
    (Zf.image_le_moyPrasad x (r + s) ⟨z, hz, rfl⟩)
    ⟨n, hn, c', hc', q, P.apartment.filtrationBlock_subset_rootGroupPoints _ _ a hq, hqN,
      hBeq.symm⟩
    ⟨m, by simpa only [neg_neg, SetLike.mem_coe] using hm, c'', hc'', q',
      P.apartment.filtrationBlock_subset_rootGroupPoints _ _ (-a) hq', hq'N,
      by simpa only [inv_inv] using hCeq.symm⟩ hvN

/-- `j(Z(F)^0) = j(Z(F)_0)` normalizes every `P_{x,t}`. -/
theorem image_zero_le_normalizer_moyPrasad (hZc : Zf.IsCommutatorFiltered)
    (x : P.Apartment) (t : NNReal) :
    Zf.image 0 ≤ Subgroup.normalizer (Zf.moyPrasad x t : Set (rationalPoints G)) := by
  apply Subgroup.le_normalizer_iff.mpr
  intro g hg k hk
  have hle : Zf.moyPrasad x t ≤ (Zf.moyPrasad x t).comap (MulAut.conj g).toMonoidHom := by
    conv_lhs => rw [moyPrasad, P.apartment.sharpFiltration_eq_iSup]
    refine sup_le ?_ (iSup_le fun b v hv => ?_)
    · intro w hw
      change g * w * g⁻¹ ∈ Zf.moyPrasad x t
      obtain ⟨z₀, hz₀, rfl⟩ := hg
      obtain ⟨w₀, hw₀, rfl⟩ := hw
      have heq : rationalPoints.map P.centralizer.j z₀ * rationalPoints.map P.centralizer.j w₀ *
          (rationalPoints.map P.centralizer.j z₀)⁻¹ =
          rationalPoints.map P.centralizer.j ⁅z₀, w₀⁆ * rationalPoints.map P.centralizer.j w₀ := by
        rw [map_commutatorElement, commutatorElement_def]
        group
      rw [heq]
      have hc : ⁅z₀, w₀⁆ ∈ Zf.filtration (0 + t) :=
        hZc 0 t (Subgroup.commutator_mem_commutator hz₀ hw₀)
      rw [zero_add] at hc
      exact (Zf.moyPrasad x t).mul_mem (Zf.image_le_moyPrasad x t ⟨_, hc, rfl⟩)
        (Zf.image_le_moyPrasad x t ⟨w₀, hw₀, rfl⟩)
    · change g * v * g⁻¹ ∈ Zf.moyPrasad x t
      exact Zf.filtration_le_moyPrasad x b t
        (Subgroup.le_normalizer_iff.mp (Zf.image_le_normalizer_filtration x 0 b.1 t) g hg v hv)
  exact hle hk

/-- The parahoric subgroup `P_x = j(Z(F)^0) G(F)^♯_x` normalizes every `P_{x,t}`, for a
filtration satisfying the filtration axioms and double-root commutator friendliness. -/
theorem parahoricAt_le_normalizer_moyPrasad (hP : P.SatisfiesApartmentAxioms)
    (hZ : Zf.SatisfiesFiltrationAxioms) (hZ2 : Zf.IsDoubleRootCommutatorFriendly)
    (x : P.Apartment) (t : NNReal) :
    P.parahoricAt x ≤ Subgroup.normalizer (Zf.moyPrasad x t : Set (rationalPoints G)) := by
  refine sup_le ?_ ?_
  · rw [← Zf.image_zero]
    exact Zf.image_zero_le_normalizer_moyPrasad hZ.2.2.1 x t
  · exact Zf.sharpFixer_le_normalizer_moyPrasad_of_doubleRootCommutatorFriendly
      hP hZ.1 hZ.2.2.2 hZ2 x t

/-- Commutators of generators of `P_{x,r}` and `P_{x,s}` lie in `P_{x,r+s}` for `r, s > 0`. -/
theorem generator_commutator_mem_moyPrasad (hP : P.SatisfiesApartmentAxioms)
    (hZ : Zf.SatisfiesFiltrationAxioms) (hZ2 : Zf.IsDoubleRootCommutatorFriendly)
    (x : P.Apartment) (r s : NNReal) (hr : 0 < r) (hs : 0 < s) {g k : rationalPoints G}
    (hg : g ∈ (Zf.image r : Set (rationalPoints G)) ∪
      ⋃ b : relativeRoots P.i, (P.filtration x b.1 r : Set (rationalPoints G)))
    (hk : k ∈ (Zf.image s : Set (rationalPoints G)) ∪
      ⋃ b : relativeRoots P.i, (P.filtration x b.1 s : Set (rationalPoints G))) :
    ⁅g, k⁆ ∈ Zf.moyPrasad x (r + s) := by
  have hnorm : ∀ t : NNReal, ∀ (b : characterLattice P.S) (hb : b ∈ relativeRoots P.i)
      (ρ : NNReal) {h : rationalPoints G}, h ∈ P.filtration x b ρ →
      h ∈ Subgroup.normalizer (Zf.moyPrasad x t : Set (rationalPoints G)) := by
    intro t b hb ρ h hh
    exact Zf.parahoricAt_le_normalizer_moyPrasad hP hZ hZ2 x t
      (Zf.moyPrasad_le_parahoricAt x ρ (Zf.filtration_le_moyPrasad x ⟨b, hb⟩ ρ hh))
  rcases hg with hg | hg <;> rcases hk with hk | hk
  · -- two central factors
    obtain ⟨z₁, hz₁, rfl⟩ := hg
    obtain ⟨z₂, hz₂, rfl⟩ := hk
    rw [← map_commutatorElement]
    exact Zf.image_le_moyPrasad x (r + s)
      ⟨_, hZ.2.2.1 r s (Subgroup.commutator_mem_commutator hz₁ hz₂), rfl⟩
  · -- a central factor and a root factor
    obtain ⟨b, hk⟩ := Set.mem_iUnion.mp hk
    have h := hZ.2.2.2 x b r s g hg k hk
    rw [commutatorElement_def]
    exact Zf.block_subset_moyPrasad x (r + s) b.2 h
  · -- a root factor and a central factor
    obtain ⟨b, hg⟩ := Set.mem_iUnion.mp hg
    have h := hZ.2.2.2 x b s r k hk g hg
    rw [← commutatorElement_inv, add_comm]
    refine (Zf.moyPrasad x (s + r)).inv_mem ?_
    rw [commutatorElement_def]
    exact Zf.block_subset_moyPrasad x (s + r) b.2 h
  · -- two root factors
    obtain ⟨b, hg⟩ := Set.mem_iUnion.mp hg
    obtain ⟨b', hk⟩ := Set.mem_iUnion.mp hk
    classical
    by_cases hnon : ∀ t : ℝ, 0 < t →
        ((1 : ℝ) ⊗ₜ[ℤ] (b' : characterLattice P.S) : Vstar P.S) ≠
          -(t • (1 : ℝ) ⊗ₜ[ℤ] (b : characterLattice P.S))
    · -- non-opposite directions: V 3
      have hmem := P.apartment.filtration_commutator_le x b.2 b'.2 hnon r s
        (Subgroup.commutator_mem_commutator hg hk)
      refine (?_ : _ ≤ Zf.moyPrasad x (r + s)) hmem
      refine iSup_le fun p => iSup_le fun q => iSup_le fun hp => iSup_le fun hq =>
        iSup_le fun hroot => ?_
      have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp
      have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
      have hdepth : ((r + s : NNReal) : ℝ) ≤ (p : ℝ) * r + (q : ℝ) * s := by
        push_cast
        nlinarith [r.coe_nonneg, s.coe_nonneg]
      exact (P.apartment.filtration_antitone x _ hdepth).trans
        (Zf.filtration_le_moyPrasad x ⟨p • (b : characterLattice P.S) +
          q • (b' : characterLattice P.S), hroot⟩ (r + s))
    push Not at hnon
    obtain ⟨t, ht, heqt⟩ := hnon
    let : Smooth G.X.hom := P.isConnectedReductive.smooth
    have hT := P.isMaximalSplitTorus.isSplitSubtorus.1
    have hrank := rootRankOneFactorization F G P.isConnectedReductive P.S P.i
      P.isMaximalSplitTorus
    have hnb : -(b' : characterLattice P.S) ∈ relativeRoots P.i :=
      KPApartmentData.neg_mem_relativeRoots_of_rankOne hT hrank x b'.2
    have heval : eval P.S (-(b' : characterLattice P.S)) =
        t • eval P.S (b : characterLattice P.S) := by
      apply LinearMap.ext
      intro w
      have h := congrArg (fun chi => pair P.S chi w) heqt
      simp only [map_neg, map_smul, LinearMap.neg_apply, LinearMap.smul_apply,
        smul_eq_mul, ← eval_eq_pair] at h
      rw [eval_neg_char, LinearMap.smul_apply, smul_eq_mul, h]
      ring
    rcases P.apartment.eq_or_double_of_eval_eq_smul hT
      hP.isAffineRootSystem_extendedAffineRoots hP.derivativeRoots_extendedAffineRoots
      b.2 hnb ht heval with h | h | h
    · -- `b' = -b`
      have hb' : (b' : characterLattice P.S) = -(b : characterLattice P.S) := by
        rw [← h, neg_neg]
      have hk' : k ∈ P.filtration x (-(b : characterLattice P.S)) s := hb' ▸ hk
      exact Zf.commutator_opposite_mem_moyPrasad hP hZ.1 x b.2 r s hr hs hg hk'
        (hnorm _ _ b'.2 s hk)
    · -- `b' = -2b`
      have hb' : (b' : characterLattice P.S) = -(2 • (b : characterLattice P.S)) := by
        rw [← h, neg_neg]
      have h2b : 2 • (b : characterLattice P.S) ∈ relativeRoots P.i := h ▸ hnb
      have hk' : k ∈ P.filtration x (-(2 • (b : characterLattice P.S))) s := hb' ▸ hk
      exact Zf.commutator_double_opposite_mem_moyPrasad hP hZ.1 hZ2 x b.2 h2b r s hr hs hg hk'
        (hnorm _ _ b'.2 s hk)
    · -- `b = -2b'`
      have hb : (b : characterLattice P.S) = -(2 • (b' : characterLattice P.S)) := by
        rw [h, smul_neg]
      have h2b' : 2 • (b' : characterLattice P.S) ∈ relativeRoots P.i := by
        have hnegb : -(b : characterLattice P.S) ∈ relativeRoots P.i :=
          KPApartmentData.neg_mem_relativeRoots_of_rankOne hT hrank x b.2
        rwa [hb, neg_neg] at hnegb
      have hg' : g ∈ P.filtration x (-(2 • (b' : characterLattice P.S))) r := hb ▸ hg
      have hcomm := Zf.commutator_double_opposite_mem_moyPrasad hP hZ.1 hZ2 x b'.2 h2b' s r hs hr
        hk hg' (hnorm _ _ b.2 r hg)
      rw [← commutatorElement_inv, add_comm]
      exact (Zf.moyPrasad x (s + r)).inv_mem hcomm

/-- **KP Proposition 13.2.5(4) on supplied data, with the double-root premise.**
`⁅P_{x,r}, P_{x,s}⁆ ≤ P_{x,r+s}`. -/
theorem commutator_moyPrasad_le (hP : P.SatisfiesApartmentAxioms)
    (hZ : Zf.SatisfiesFiltrationAxioms) (hZ2 : Zf.IsDoubleRootCommutatorFriendly)
    (x : P.Apartment) (r s : NNReal) :
    ⁅Zf.moyPrasad x r, Zf.moyPrasad x s⁆ ≤ Zf.moyPrasad x (r + s) := by
  by_cases hr0 : r = 0
  · subst r
    rw [zero_add]
    apply Subgroup.le_normalizer_iff_commutator_le_right.mp
    rw [Zf.moyPrasad_zero]
    exact Zf.parahoricAt_le_normalizer_moyPrasad hP hZ hZ2 x s
  by_cases hs0 : s = 0
  · subst s
    rw [add_zero]
    apply Subgroup.le_normalizer_iff_commutator_le_left.mp
    rw [Zf.moyPrasad_zero]
    exact Zf.parahoricAt_le_normalizer_moyPrasad hP hZ hZ2 x r
  have hr : 0 < r := lt_of_le_of_ne (zero_le : (0 : NNReal) ≤ r) (Ne.symm hr0)
  have hs : 0 < s := lt_of_le_of_ne (zero_le : (0 : NNReal) ≤ s) (Ne.symm hs0)
  have hgen : ∀ t : NNReal, (Zf.image t : Set (rationalPoints G)) ∪
      ⋃ b : relativeRoots P.i, (P.filtration x b.1 t : Set (rationalPoints G)) ⊆
        P.parahoricAt x := by
    intro t
    rw [← Zf.moyPrasad_zero]
    refine (Subgroup.subset_closure.trans ?_)
    rw [← Zf.moyPrasad_eq_closure]
    exact Zf.moyPrasad_antitone x (zero_le : (0 : NNReal) ≤ t)
  rw [Zf.moyPrasad_eq_closure x r, Zf.moyPrasad_eq_closure x s]
  exact commutator_closure_le_of_le_normalizer
    (Zf.parahoricAt_le_normalizer_moyPrasad hP hZ hZ2 x (r + s)) (hgen r) (hgen s)
    (fun g hg k hk => Zf.generator_commutator_mem_moyPrasad hP hZ hZ2 x r s hr hs hg hk)

end CentralizerFiltration

