import Langlands.AlgebraicGeometry.PointTopology.AffineGroupProofs
import Langlands.AlgebraicGeometry.PointTopology.RepresentedSubgroup
import Langlands.GroupScheme.Rational.ProductDetection
import Langlands.Geometry.Building.KPZeroSubgroups

/-! # Openness of a subgroup join from an open product map on rational points -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

namespace Langlands.GroupScheme

open Langlands.AlgebraicGeometry.PointTopology

section Generic

variable {R : Type u} [CommRing R] {C T H : GroupScheme (Spec (CommRingCat.of R))}

/-- On rational points, the product map is the product of the two images. -/
theorem comp_subgroupProductMap (a : C ⟶ H) (b : T ⟶ H)
    (p : Over.mk (𝟙 (Spec (CommRingCat.of R))) ⟶ C.X ⊗ T.X) :
    p ≫ subgroupProductMap a b =
      rationalPoints.map a (p ≫ fst C.X T.X) * rationalPoints.map b (p ≫ snd C.X T.X) := by
  simp only [subgroupProductMap, MonObj.comp_mul, rationalPoints.map_apply, Category.assoc]

/-- The product map `(C × T)(R) → H(R)`, `p ↦ a(p₁) · b(p₂)`, on rational points. -/
def rationalProductPointMap (a : C ⟶ H) (b : T ⟶ H) :
    RationalPoint R (C.X ⊗ T.X) → rationalPoints H :=
  fun p => p ≫ subgroupProductMap a b

theorem rationalProductPointMap_apply (a : C ⟶ H) (b : T ⟶ H)
    (p : RationalPoint R (C.X ⊗ T.X)) :
    rationalProductPointMap a b p =
      rationalPoints.map a (p ≫ fst C.X T.X) * rationalPoints.map b (p ≫ snd C.X T.X) :=
  comp_subgroupProductMap a b p

variable (R) [TopologicalSpace R] [IsTopologicalRing R]
  [IsAffine H.X.left] [LocallyOfFiniteType H.X.hom] [IsAffine T.X.left]
  [IsAffine (C.X ⊗ T.X).left]

/-- If the product map `C × T → H` is open on rational points and `U` is an open subgroup of
`T(R)`, then the subgroup of `H(R)` generated by the image of `C(R)` and the image of `U` is
open. -/
theorem isOpen_range_sup_map_of_isOpenMap (a : C ⟶ H) (b : T ⟶ H)
    (U : Subgroup (rationalPoints T)) :
    letI : TopologicalSpace (rationalPoints T) := rationalPointTopology R T.X
    letI : TopologicalSpace (rationalPoints H) := rationalPointTopology R H.X
    letI : TopologicalSpace (RationalPoint R (C.X ⊗ T.X)) :=
      rationalPointTopology R (C.X ⊗ T.X)
    IsOpen (U : Set (rationalPoints T)) →
      IsOpenMap (rationalProductPointMap a b) →
        IsOpen (((rationalPoints.map a).range ⊔ U.map (rationalPoints.map b) :
          Subgroup (rationalPoints H)) : Set (rationalPoints H)) := by
  let : TopologicalSpace (rationalPoints T) := rationalPointTopology R T.X
  let : TopologicalSpace (rationalPoints H) := rationalPointTopology R H.X
  let : TopologicalSpace (RationalPoint R (C.X ⊗ T.X)) :=
    rationalPointTopology R (C.X ⊗ T.X)
  intro hU hm
  let : IsTopologicalGroup (rationalPoints H) := rationalPoint_isTopologicalGroup R H
  let W : Set (RationalPoint R (C.X ⊗ T.X)) :=
    (fun p => p ≫ snd C.X T.X) ⁻¹' (U : Set (rationalPoints T))
  have hW : IsOpen W := hU.preimage (continuous_rationalPointMap R (snd C.X T.X))
  have himage : rationalProductPointMap a b '' W ⊆
      (((rationalPoints.map a).range ⊔ U.map (rationalPoints.map b) :
        Subgroup (rationalPoints H)) : Set (rationalPoints H)) := by
    rintro _ ⟨p, hp, rfl⟩
    rw [rationalProductPointMap_apply]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left ⟨p ≫ fst C.X T.X, rfl⟩)
      (Subgroup.mem_sup_right ⟨p ≫ snd C.X T.X, hp, rfl⟩)
  have h1 : (lift (1 : Over.mk (𝟙 (Spec (CommRingCat.of R))) ⟶ C.X) 1 :
      RationalPoint R (C.X ⊗ T.X)) ∈ W := by
    change lift (1 : Over.mk (𝟙 (Spec (CommRingCat.of R))) ⟶ C.X) 1 ≫ snd C.X T.X ∈ U
    rw [lift_snd]
    exact U.one_mem
  exact Subgroup.isOpen_of_mem_nhds _
    (Filter.mem_of_superset ((hm W hW).mem_nhds ⟨_, h1, rfl⟩) himage)

end Generic

end Langlands.GroupScheme

namespace Langlands.Geometry.Building

open Langlands.GroupScheme Langlands.AlgebraicGeometry.PointTopology
open Langlands.LocalGalois.Separable

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

namespace UnramifiedZeroDatum

variable {H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))}

/-- The simply connected cover is affine. -/
theorem isAffine_cover (E : UnramifiedZeroDatum F H) : IsAffine E.C.X.left := by
  have : IsAffineHom E.C.X.hom := E.isSimplyConnectedDerivedCover.isSimplyConnectedCover
    |>.isSimplyConnected.isSemisimple.isConnectedReductive.isAffineHom
  exact isAffine_of_isAffineHom E.C.X.hom

/-- The ambient group is affine. -/
theorem isAffine_ambient (E : UnramifiedZeroDatum F H) : IsAffine H.X.left := by
  have : IsAffineHom H.X.hom :=
    E.isSimplyConnectedDerivedCover.isConnectedReductive.isAffineHom
  exact isAffine_of_isAffineHom H.X.hom

/-- The ambient group is locally of finite type. -/
theorem locallyOfFiniteType_ambient (E : UnramifiedZeroDatum F H) :
    LocallyOfFiniteType H.X.hom := by
  have : Smooth H.X.hom := E.isSimplyConnectedDerivedCover.isConnectedReductive.smooth
  infer_instance

/-- The product of the simply connected cover and the maximal torus is affine. -/
theorem isAffine_coverTorus (E : UnramifiedZeroDatum F H) :
    IsAffine (E.C.X ⊗ E.T.toGrp.X).left := by
  have := E.isAffine_cover
  exact tensor_isAffine (UnramifiedClosure F) E.C.X E.T.toGrp.X

/-- KP Definition 2.6.23(1): `H(K)^0 = H(K)^♮ · T(K)^0` is open as soon as `T(K)^0` is open
and the multiplication map `C × T → H` is open on `K`-points. -/
theorem isOpen_zeroPoints_of_isOpenMap (E : UnramifiedZeroDatum F H) [IsAffine H.X.left]
    [IsAffine (E.C.X ⊗ E.T.toGrp.X).left] :
    letI : TopologicalSpace (UnramifiedClosure F) := fixedFieldTopology F
    letI : TopologicalSpace (rationalPoints E.T.toGrp) :=
      rationalPointTopology (UnramifiedClosure F) E.T.toGrp.X
    letI : TopologicalSpace (rationalPoints H) := rationalPointTopology (UnramifiedClosure F) H.X
    letI : TopologicalSpace (RationalPoint (UnramifiedClosure F) (E.C.X ⊗ E.T.toGrp.X)) :=
      rationalPointTopology (UnramifiedClosure F) (E.C.X ⊗ E.T.toGrp.X)
    IsOpen (E.torusIwahori : Set (rationalPoints E.T.toGrp)) →
      IsOpenMap (rationalProductPointMap (E.π ≫ E.d) E.i) →
        IsOpen (E.zeroPoints : Set (rationalPoints H)) := by
  let : Valued (UnramifiedClosure F) NNReal := fixedFieldValued F
  have := E.locallyOfFiniteType_ambient
  exact isOpen_range_sup_map_of_isOpenMap (UnramifiedClosure F) (E.π ≫ E.d) E.i
    E.torusIwahori

end UnramifiedZeroDatum

end Langlands.Geometry.Building
