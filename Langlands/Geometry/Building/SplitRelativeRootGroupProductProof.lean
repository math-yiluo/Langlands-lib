import Langlands.GroupScheme.Rational.DynamicRootProductsLargerSupport
import Langlands.GroupScheme.Rational.RelativeRootGroupAbsoluteGenerationProof
import Langlands.GroupScheme.Reductive.RootReducednessProof

/-! # Rational points of relative root groups in a split group: proof -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RelativeRoot

set_option backward.isDefEq.respectTransparency false

namespace Langlands.Geometry.Building

namespace SplitRelativeRootGroupProduct

section Characters

variable {K : Type u} [Field K] {S T : CommGroupScheme (Spec (CommRingCat.of K))}

/-- The characters of `T` whose restriction along `f` is a positive multiple of `a`. -/
def positiveMultiples (f : S ⟶ T) (a : characterLattice S) :
    AddSubsemigroup (characterLattice T) where
  carrier := {χ | ∃ m : ℕ, 0 < m ∧ f ≫ χ = m • a}
  add_mem' := by
    rintro χ ψ ⟨m, hm, hχ⟩ ⟨m', hm', hψ⟩
    refine ⟨m + m', by omega, ?_⟩
    rw [Preadditive.comp_add, hχ, hψ, add_nsmul]

theorem mem_positiveMultiples {f : S ⟶ T} {a : characterLattice S} {χ : characterLattice T} :
    χ ∈ positiveMultiples f a ↔ ∃ m : ℕ, 0 < m ∧ f ≫ χ = m • a :=
  Iff.rfl

/-- For a split `S` and `a ≠ 0`, the zero character is not in `positiveMultiples f a`. -/
theorem zero_not_mem_positiveMultiples (hS : IsSplitTorus S.toGrp) (f : S ⟶ T)
    {a : characterLattice S} (ha : a ≠ 0) :
    (0 : characterLattice T) ∉ positiveMultiples f a := by
  rintro ⟨m, hm, h⟩
  rw [Limits.comp_zero] at h
  exact hS.nsmul_ne_zero ha (by omega) h.symm

/-- Positive multiples of an element of an additive subsemigroup of characters lie in it. -/
theorem nsmul_mem_of_pos (A : AddSubsemigroup (characterLattice T)) {x : characterLattice T}
    (hx : x ∈ A) (m : ℕ) (hm : 0 < m) : m • x ∈ A := by
  induction m with
  | zero => omega
  | succ m ih =>
      by_cases hm0 : m = 0
      · subst m
        simpa using hx
      · simpa only [succ_nsmul] using A.add_mem (ih (by omega)) hx

/-- The subsemigroup generated by one character is its positive cyclic tail. -/
theorem addClosure_singleton_eq_cyclicTail (χ : characterLattice T) :
    AddSubsemigroup.closure {χ} = cyclicTail χ 1 := by
  apply le_antisymm
  · rw [AddSubsemigroup.closure_le, Set.singleton_subset_iff, SetLike.mem_coe]
    show ∃ n : ℕ, 1 ≤ n ∧ 0 < n ∧ n • χ = χ
    exact ⟨1, le_rfl, one_pos, one_nsmul χ⟩
  · rintro ψ ⟨m, _, hm, rfl⟩
    exact nsmul_mem_of_pos _ (AddSubsemigroup.subset_closure (Set.mem_singleton χ)) m hm

/-- The cyclic tail of a member of `positiveMultiples f a` stays in it. -/
theorem cyclicTail_le_positiveMultiples {f : S ⟶ T} {a : characterLattice S}
    {β : characterLattice T} (hβ : β ∈ positiveMultiples f a) :
    cyclicTail β 1 ≤ positiveMultiples f a := by
  obtain ⟨m, hm, hfm⟩ := hβ
  rintro χ ⟨r, _, hr, rfl⟩
  refine ⟨r * m, Nat.mul_pos hr hm, ?_⟩
  rw [Preadditive.comp_nsmul, hfm, smul_smul]

end Characters

section Reduced

variable {K : Type u} [Field K] {T : CommGroupScheme (Spec (CommRingCat.of K))}
  {G : GroupScheme (Spec (CommRingCat.of K))} [IsAffineHom G.X.hom]

/-- For a split maximal torus of a connected reductive group, a root is not a positive
multiple of a different root. -/
theorem not_mem_cyclicTail_of_ne (hG : IsConnectedReductive G) (hT : IsSplitTorus T.toGrp)
    (j : T.toGrp ⟶ G) (hj : IsMaximalTorus j) {β δ : characterLattice T}
    (hβ : β ∈ roots j) (hδ : δ ∈ roots j) (hne : β ≠ δ) : β ∉ cyclicTail δ 1 := by
  rintro ⟨m, -, hm, hmδ⟩
  have hdep : ¬ LinearIndependent ℤ ![β, δ] := by
    rw [LinearIndependent.pair_iff]
    intro h
    have h1 := (h 1 (-(m : ℤ)) (by rw [one_smul, neg_smul, natCast_zsmul, hmδ,
      add_neg_cancel])).1
    exact one_ne_zero h1
  rcases rootReducedness K G hG T hT j hj β hβ δ hδ hdep with h | h
  · exact hne h
  · apply hT.nsmul_ne_zero hδ.1 (r := m + 1) (by omega)
    rw [succ_nsmul, hmδ, h, neg_add_cancel]

end Reduced

end SplitRelativeRootGroupProduct

open SplitRelativeRootGroupProduct in
/-- **Ordered products of absolute root points.** This proves
`SplitRelativeRootGroupProductStatement` at every universe. -/
theorem splitRelativeRootGroupProduct : SplitRelativeRootGroupProductStatement.{u} := by
  intro K _ G hG S T j f hT hj hS a ha n β hβinj hβ
  let : IsAffineHom G.X.hom := hG.isAffineHom
  have : Smooth G.X.hom := hG.smooth
  let b := AutomorphicAction.conjugation j
  let A := positiveMultiples f a
  obtain ⟨⟨U, jU, hjU, hjUc, hUs, hUc⟩, hStable, _, hUnip, hmax, _⟩ :=
    semigroupRealization K G inferInstance inferInstance T hT b A
  obtain ⟨hUu, _⟩ := hUnip U jU hjU (zero_not_mem_positiveMultiples hS f ha)
  let : IsAffineHom U.X.hom := hjUc.isAffineHom
  let : Smooth U.X.hom := hUs
  let : ConnectedSpace U.X.left := hUc
  let c := b.onRepresentedSubgroup jU hjU hStable
  have hequiv : ∀ (V : Over (Spec (CommRingCat.of K))) (s : V ⟶ T.X) (x : V ⟶ U.X),
      c.act s x ≫ jU.hom.hom = b.act s (x ≫ jU.hom.hom) :=
    fun _ s x => b.onRepresentedSubgroup_act_comp jU hjU hStable s x
  -- The weights of the realized group are roots restricting to positive multiples of `a`.
  have hsupportA : actionWeightSupport b (semigroupSubgroup b A) ⊆ A :=
    (hmax _ ⟨U, jU, hjU, hjUc, hUs, hUc⟩ hStable).mpr le_rfl
  have hsupport : actionWeightSupport c (⊤ : SubgroupFunctor U) ⊆ Set.range β := by
    rw [← actionWeightSupport_map jU hjU.1 c b hequiv, SubgroupFunctor.map_top, hjU.2]
    intro χ hχ
    have hχA := hsupportA hχ
    have hχ0 : χ ≠ 0 := fun h => zero_not_mem_positiveMultiples hS f ha (h ▸ hχA)
    have hχroot : χ ∈ roots j :=
      (mem_actionWeightSupport_conjugation_iff j hχ0).mp
        (actionWeightSupport_mono b (fun _ _ _ => Subgroup.mem_top _) hχ)
    exact (hβ χ).mpr ⟨hχroot, hχA⟩
  have hroot : ∀ r, β r ∈ roots j ∧ β r ∈ A := fun r => (hβ (β r)).mp ⟨r, rfl⟩
  -- Ordered products of the singleton blocks.
  obtain ⟨H, jH, hH, hIso⟩ :=
    (hasOrderedSemigroupProducts_of_unipotent c hT hUu).for_larger_support
      (Set.range β) hsupport n (fun r => {β r}) (Set.iUnion_singleton_eq_range β)
      (fun r s hrs => Set.disjoint_singleton.mpr (hβinj.ne hrs))
      (fun r s hrs => by
        show Disjoint {β r} ((AddSubsemigroup.closure {β s} :
          AddSubsemigroup (characterLattice T)) : Set (characterLattice T))
        rw [addClosure_singleton_eq_cyclicTail]
        exact Set.disjoint_singleton_left.mpr
          (not_mem_cyclicTail_of_ne hG hT j hj (hroot r).1 (hroot s).1 (hβinj.ne hrs)))
  have hcyc : ∀ δ ∈ roots j, semigroupSubgroup b (cyclicTail δ 1) = subgroup j δ :=
    fun δ hδ => cyclicRootFunctorComparison K G inferInstance inferInstance T hT j δ hδ.1
  have hsemigroup (r : Fin n) :
      (semigroupSubgroup c (AddSubsemigroup.closure {β r})).map jU =
        semigroupSubgroup b (cyclicTail (β r) 1) := by
    rw [addClosure_singleton_eq_cyclicTail]
    apply semigroupSubgroup_map_eq jU hjUc c b hequiv
    rw [hjU.2]
    exact semigroupSubgroup_mono b (cyclicTail_le_positiveMultiples (hroot r).2)
  have hfactor (r : Fin n) : (subgroup j (β r)).IsRepresentedBy (jH r ≫ jU) := by
    rw [← hcyc _ (hroot r).1, ← hsemigroup r]
    exact (hH r).1.comp hjU
  -- The relative root group lies in the realized group.
  have hrange : subgroup (CommGroupScheme.groupHom f ≫ j) a ≤ SubgroupFunctor.range jU :=
    subgroup_comp_torusHom_le_range_of_roots hS hT f j ha jU hjUc (fun δ hδ hpos => by
      rw [hjU.2, ← hcyc δ hδ]
      exact semigroupSubgroup_mono b (cyclicTail_le_positiveMultiples hpos))
  -- Point-level consequences of the product isomorphism.
  let J : ∀ r, H r ⟶ G := fun r => jH r ≫ jU
  have := hIso
  have : Mono jU.hom.hom := hjU.1
  have hJ : orderedMultiplication J = orderedMultiplication jH ≫ jU.hom.hom :=
    (orderedMultiplication_comp jH jU).symm
  have hmono : Mono (orderedMultiplication J) := by
    rw [hJ]
    infer_instance
  let pt : Over (Spec (CommRingCat.of K)) := Over.mk (𝟙 _)
  have hmem : ∀ (r : Fin n) (x : pt ⟶ (H r).X),
      x ≫ (J r).hom.hom ∈ rootGroupPoints j (β r) := by
    intro r x
    show x ≫ (J r).hom.hom ∈ (subgroup j (β r)).carrier pt
    rw [← (hfactor r).2]
    exact SubgroupFunctor.mem_range.mpr ⟨x, rfl⟩
  have hlift : ∀ (r : Fin n) (g : rootGroupPoints j (β r)),
      ∃ x : pt ⟶ (H r).X, x ≫ (J r).hom.hom = (g : rationalPoints G) := by
    intro r g
    have hg : (g : rationalPoints G) ∈ (SubgroupFunctor.range (J r)).carrier pt := by
      rw [(hfactor r).2]
      exact g.property
    exact SubgroupFunctor.mem_range.mp hg
  refine ⟨fun g => ⟨fun hg => ?_, ?_⟩, fun x y hxy => ?_⟩
  · -- Existence of the ordered factorization.
    obtain ⟨u, hu⟩ := SubgroupFunctor.mem_range.mp (hrange pt hg)
    let p : pt ⟶ (∏ᶜ H).X := u ≫ inv (orderedMultiplication jH)
    let x := finiteProductPointsEquiv H pt p
    refine ⟨fun r => ⟨x r ≫ (J r).hom.hom, hmem r (x r)⟩, ?_⟩
    change g = orderedPoints J x
    rw [← comp_orderedMultiplication, hJ, ← Category.assoc]
    change g = (u ≫ inv (orderedMultiplication jH) ≫ orderedMultiplication jH) ≫ jU.hom.hom
    rw [IsIso.inv_hom_id, Category.comp_id, hu]
  · -- Every ordered product lies in the relative root group.
    rintro ⟨x, rfl⟩
    apply Subgroup.list_prod_mem
    intro g hg
    obtain ⟨r, rfl⟩ := List.mem_ofFn.mp hg
    obtain ⟨m, hm, hfm⟩ := (hroot r).2
    exact subgroup_le_subgroup_comp_torusHom_of_nsmul f j hm hfm pt (x r).property
  · -- Uniqueness of the ordered factorization.
    choose x' hx' using fun r => hlift r (x r)
    choose y' hy' using fun r => hlift r (y r)
    have hx : (List.ofFn fun r => (x r : rationalPoints G)).prod = orderedPoints J x' := by
      simp only [orderedPoints, hx']
    have hy : (List.ofFn fun r => (y r : rationalPoints G)).prod = orderedPoints J y' := by
      simp only [orderedPoints, hy']
    have hxy' : orderedPoints J x' = orderedPoints J y' := by rw [← hx, ← hy, hxy]
    rw [← finiteProductPointsEquiv_symm_orderedMultiplication,
      ← finiteProductPointsEquiv_symm_orderedMultiplication] at hxy'
    have hsymm := (cancel_mono (orderedMultiplication J)).mp hxy'
    have heq : x' = y' := (finiteProductPointsEquiv H pt).symm.injective hsymm
    funext r
    apply Subtype.ext
    rw [← hx' r, ← hy' r, heq]

end Langlands.Geometry.Building
