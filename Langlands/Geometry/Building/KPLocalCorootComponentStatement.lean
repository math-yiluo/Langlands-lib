import Langlands.Geometry.Building.KPLocalMoyPrasadGroups

/-! # KP Proposition 7.1.1 over `K = F^ur`: the `Z`-component of a rank-one commutator

Let `B` be building data over the maximal unramified extension `K = F^ur` whose centralizer
`Z = B.centralizer.Z` is a torus (`hZ : IsTorus Z`, the binder convention of
`MaximalUnramified.BuildingData.centralizerTorus`). For every relative root `a` there is an
induced torus `T_a` over `K` and a morphism `f : T_a → Z` of commutative group schemes (the
coroot of the simply connected rank-one group generated by `U_{±a}`) such that the
`Z`-component of `u'⁻¹ u u' u⁻¹` (KP Definition 7.1.3), for nontrivial `u ∈ U_a(K)`,
`u' ∈ U_{-a}(K)` of depth `r = x_a(u) + x_{-a}(u') > 0`, is `f(c)` for some `c ∈ T_a(K)`
with `ω(χ(c) - 1) ≥ r` for every character `χ` of `T_a` over `Ω = SeparableClosure F`.

KP do not state this as a separate result: it is the formula of the quasi-split proof of
KP Proposition 7.1.1 (`c` is the element `γ` of the `SL_2` and `SU_3` computations), as used
in the proof of KP Lemma 7.2.3.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open Langlands.GroupScheme Langlands.LocalField Langlands.LocalGalois.Separable
open Langlands.GroupScheme.GaloisPointComparison
open scoped CategoryTheory.MonObj NNReal

namespace Langlands.Geometry.Building

/-- KP Proposition 7.1.1 over `K = F^ur`, coroot formula for the `Z`-component of the
commutator `u'⁻¹ u u' u⁻¹` of opposite root-group elements (quasi-split proof of
Proposition 7.1.1, Definition 7.1.3, proof of Lemma 7.2.3). -/
def KPLocalCorootComponentStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))) [IsAffineHom H.X.hom]
    (B : MaximalUnramified.BuildingData F H) (hZ : IsTorus B.centralizer.Z)
    (a : relativeRoots B.i),
    ∃ (Ta : CommGroupScheme (Spec (CommRingCat.of (UnramifiedClosure F))))
      (_ : IsAffine Ta.X.left), IsTorus Ta.toGrp ∧ IsInducedTorus Ta ∧
      ∃ f : Ta ⟶ B.centralizerTorus hZ,
        ∀ (x : B.Apartment) (u u' : rationalPoints H),
          u ∈ B.rootGroup a.1 → u ≠ 1 → u' ∈ B.rootGroup (-a.1) → u' ≠ 1 →
          ∀ r : ℝ≥0, 0 < r → (((r : ℝ) : WithTop ℝ) = x.val a.1 u + x.val (-a.1) u') →
          ∀ (v' v : rationalPoints H) (z : rationalPoints B.centralizer.Z),
            v' ∈ B.rootGroup (-a.1) → v ∈ B.rootGroup a.1 →
            u'⁻¹ * u * u' * u⁻¹ = v' * rationalPoints.map B.centralizer.j z * v →
            ∃ c : rationalPoints Ta.toGrp,
              rationalPoints.map (CommGroupScheme.groupHom f) c = z ∧
              ∀ χ : rationalCharacters
                  (baseChanged (UnramifiedClosure F) (SeparableClosure F) Ta.toGrp),
                ((r : ℝ) : WithTop ℝ) ≤
                  algebraicExtensionAddValuation F (SeparableClosure F)
                    ((rationalCharacterEval χ
                      (rationalExtend (UnramifiedClosure F) (SeparableClosure F) Ta.toGrp c) :
                        SeparableClosure F) - 1)

end Langlands.Geometry.Building
