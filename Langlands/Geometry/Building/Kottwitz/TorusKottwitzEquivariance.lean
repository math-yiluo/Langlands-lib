section StableField

variable {k K E : Type u} [Field k] [Field K] [Field E]
  [Algebra k K] [Algebra k E] [Algebra K E] [IsScalarTower k K E]

/-- The `K`-subfield of `E` generated by the roots of a polynomial over `k` is stable under every
`k`-automorphism of `E`, when `K/k` is normal. -/
theorem adjoin_rootSet_stable [Normal k K] (f : k[X]) (ρ : E ≃ₐ[k] E) {x : E}
    (hx : x ∈ IntermediateField.adjoin K ((f.map (algebraMap k K)).rootSet E)) :
    ρ x ∈ IntermediateField.adjoin K ((f.map (algebraMap k K)).rootSet E) := by
  set L := IntermediateField.adjoin K ((f.map (algebraMap k K)).rootSet E)
  have hsub : Subfield.closure (Set.range (algebraMap K E) ∪ (f.map (algebraMap k K)).rootSet E)
      ≤ L.toSubfield.comap (ρ : E →+* E) := by
    rw [Subfield.closure_le]
    rintro y (⟨b, rfl⟩ | hy)
    · change ρ (algebraMap K E b) ∈ L
      rw [← AlgEquiv.restrictNormal_commutes]
      exact L.algebraMap_mem _
    · change ρ y ∈ L
      apply IntermediateField.subset_adjoin
      rw [Polynomial.mem_rootSet', Polynomial.aeval_map_algebraMap] at hy ⊢
      refine ⟨hy.1, ?_⟩
      rw [Polynomial.aeval_algEquiv, AlgHom.comp_apply, hy.2, map_zero]
  exact hsub hx

/-- Restriction of an automorphism of `E/k` to an intermediate field of `E/K` that it preserves
in both directions. -/
def stableRestrict (L : IntermediateField K E) (ρ : E ≃ₐ[k] E)
    (h₁ : ∀ x ∈ L, ρ x ∈ L) (h₂ : ∀ x ∈ L, ρ.symm x ∈ L) : L ≃ₐ[k] L where
  toFun x := ⟨ρ (x : E), h₁ x x.2⟩
  invFun x := ⟨ρ.symm (x : E), h₂ x x.2⟩
  left_inv x := Subtype.ext (ρ.symm_apply_apply (x : E))
  right_inv x := Subtype.ext (ρ.apply_symm_apply (x : E))
  map_mul' x y := Subtype.ext (map_mul ρ (x : E) y)
  map_add' x y := Subtype.ext (map_add ρ (x : E) y)
  commutes' r := Subtype.ext (ρ.commutes r)

@[simp] theorem coe_stableRestrict (L : IntermediateField K E) (ρ : E ≃ₐ[k] E)
    (h₁ : ∀ x ∈ L, ρ x ∈ L) (h₂ : ∀ x ∈ L, ρ.symm x ∈ L) (x : L) :
    ((stableRestrict L ρ h₁ h₂ x : L) : E) = ρ x := rfl

end StableField

section NormConjugate

variable (k K L : Type u) [Field k] [Field K] [Field L]
  [Algebra k K] [Algebra k L] [Algebra K L] [IsScalarTower k K L]

/-- Conjugating a relative automorphism by a compatible pair `(σ, τ)`. -/
def conjAut (σ : K ≃ₐ[k] K) (τ : L ≃ₐ[k] L)
    (h : ∀ a : K, τ (algebraMap K L a) = algebraMap K L (σ a)) (ρ : L ≃ₐ[K] L) :
    L ≃ₐ[K] L :=
  AlgEquiv.ofRingEquiv (f := ((τ.symm.trans (ρ.restrictScalars k)).trans τ).toRingEquiv)
    (fun a => by
      have h' : τ.symm (algebraMap K L a) = algebraMap K L (σ.symm a) := by
        rw [AlgEquiv.symm_apply_eq, h, AlgEquiv.apply_symm_apply]
      change τ (ρ (τ.symm (algebraMap K L a))) = algebraMap K L a
      rw [h', AlgEquiv.commutes, h, AlgEquiv.apply_symm_apply])

theorem conjAut_apply (σ : K ≃ₐ[k] K) (τ : L ≃ₐ[k] L)
    (h : ∀ a : K, τ (algebraMap K L a) = algebraMap K L (σ a)) (ρ : L ≃ₐ[K] L) (x : L) :
    conjAut k K L σ τ h ρ x = τ (ρ (τ.symm x)) := rfl

/-- Conjugation by a compatible pair is a bijection of `Aut_K(L)`. -/
def conjAutEquiv (σ : K ≃ₐ[k] K) (τ : L ≃ₐ[k] L)
    (h : ∀ a : K, τ (algebraMap K L a) = algebraMap K L (σ a)) :
    (L ≃ₐ[K] L) ≃ (L ≃ₐ[K] L) where
  toFun := conjAut k K L σ τ h
  invFun := conjAut k K L σ.symm τ.symm (fun a => by
    rw [AlgEquiv.symm_apply_eq, h, AlgEquiv.apply_symm_apply])
  left_inv ρ := by
    ext x
    simp only [conjAut_apply, AlgEquiv.symm_symm, AlgEquiv.symm_apply_apply]
  right_inv ρ := by
    ext x
    simp only [conjAut_apply, AlgEquiv.symm_symm, AlgEquiv.apply_symm_apply]

variable [FiniteDimensional K L] [IsGalois K L]
  (T : CommGroupScheme (Spec (CommRingCat.of k))) [IsAffine T.X.left]

/-- Conjugation commutes with the relative norm: for a `k`-automorphism `τ` of `L` extending
`σ` on `K`, `σ (N_{L/K} x) = N_{L/K} (τ x)`. -/
theorem conjugate_relativeNorm (σ : K ≃ₐ[k] K) (τ : L ≃ₐ[k] L)
    (h : ∀ a : K, τ (algebraMap K L a) = algebraMap K L (σ a))
    (x : affinePoints T.toGrp (CommAlgCat.of k L)) :
    conjugate k K T.toGrp σ (relativeNorm k K L T x) =
      relativeNorm k K L T (conjugate k L T.toGrp τ x) := by
  apply relativeExtend_injective k K L T.toGrp
  rw [Langlands.Geometry.Building.Kottwitz.relativeExtend_conjugate k K L T.toGrp σ τ h,
    relativeExtend_norm, relativeExtend_norm, map_prod]
  refine Fintype.prod_equiv (conjAutEquiv k K L σ τ h) _ _ (fun ρ => ?_)
  have hρ : τ * ρ.restrictScalars k =
      (conjAutEquiv k K L σ τ h ρ).restrictScalars k * τ := by
    ext a
    change τ (ρ a) = τ (ρ (τ.symm (τ a)))
    rw [AlgEquiv.symm_apply_apply]
  simp only [relativeConjugate, ← conjugate_mul, hρ]

end NormConjugate

section StableSplitting

-- Between intermediate fields `L ⊆ M`, the module and scalar structures come from the given
-- algebra; searching other paths first times out.
attribute [local instance high] Algebra.toModule Algebra.toSMul

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  (k : Type u) [Field k] [Algebra k (UnramifiedClosure F)] [Algebra k (SeparableClosure F)]
  [IsScalarTower k (UnramifiedClosure F) (SeparableClosure F)]
  [IsSepClosure k (SeparableClosure F)] [Normal k (UnramifiedClosure F)]
  (T : CommGroupScheme (Spec (CommRingCat.of k)))

/-- A torus over `k` splits over a finite Galois intermediate field `L` of `F^sep / K` that is
stable under a given `k`-automorphism `ρ` of `F^sep` and its inverse. -/
theorem exists_stable_finiteGalois_splitting (hT : IsTorus T.toGrp)
    (ρ : SeparableClosure F ≃ₐ[k] SeparableClosure F) :
    ∃ L : IntermediateField (UnramifiedClosure F) (SeparableClosure F),
      FiniteDimensional (UnramifiedClosure F) L ∧ IsGalois (UnramifiedClosure F) L ∧
      IsSplitTorus ((CommGroupScheme.baseChange (baseMap k L)).obj T).toGrp ∧
      (∀ x ∈ L, ρ x ∈ L) ∧ (∀ x ∈ L, ρ.symm x ∈ L) := by
  let K := UnramifiedClosure F
  let E := SeparableClosure F
  obtain ⟨L₀, _, _, hL₀⟩ := exists_finiteGalois_splitting F k T hT
  obtain ⟨α, hα⟩ := Field.exists_primitive_element K L₀
  have hL₀eq : L₀ = IntermediateField.adjoin K {(α : E)} := by
    have h₁ : IntermediateField.lift (⊤ : IntermediateField K L₀) = L₀ :=
      IntermediateField.lift_top K L₀
    have h₂ := IntermediateField.lift_adjoin_simple K L₀ α
    rw [hα] at h₂
    exact h₁.symm.trans h₂
  -- The minimal polynomial of `α` over `k`, viewed over `K`.
  let f : k[X] := minpoly k (α : E)
  have hint : IsIntegral k (α : E) := Algebra.IsIntegral.isIntegral _
  have hsep : f.Separable := Algebra.IsSeparable.isSeparable k (α : E)
  let p : K[X] := f.map (algebraMap k K)
  have hpsep : p.Separable := hsep.map
  have hpsplit : (p.map (algebraMap K E)).Splits := IsSepClosed.splits_codomain p hpsep
  let L : IntermediateField K E := IntermediateField.adjoin K (p.rootSet E)
  have : p.IsSplittingField K L := IntermediateField.adjoin_rootSet_isSplittingField hpsplit
  have : FiniteDimensional K L := Polynomial.IsSplittingField.finiteDimensional L p
  have : IsGalois K L := IsGalois.of_separable_splitting_field hpsep
  have hαL : (α : E) ∈ L := by
    apply IntermediateField.subset_adjoin
    rw [Polynomial.mem_rootSet', Polynomial.aeval_map_algebraMap]
    refine ⟨?_, minpoly.aeval k (α : E)⟩
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    exact (Polynomial.map_ne_zero_iff (algebraMap k E).injective).2 (minpoly.ne_zero hint)
  have hle : L₀ ≤ L := by
    rw [hL₀eq, IntermediateField.adjoin_simple_le_iff]
    exact hαL
  -- `T` splits over `L ⊇ L₀`.
  let : Algebra L₀ L := (IntermediateField.inclusion hle).toAlgebra
  let : Module L₀ L := Algebra.toModule
  have : IsScalarTower k L₀ L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hL : IsSplitTorus ((CommGroupScheme.baseChange (baseMap k L)).obj T).toGrp :=
    (IsSplitTorus.baseChange_fieldTower_iff k L₀ L T.toGrp).2 (hL₀.baseChange (baseMap L₀ L))
  exact ⟨L, inferInstance, inferInstance, hL, fun x hx => adjoin_rootSet_stable f ρ hx,
    fun x hx => adjoin_rootSet_stable f ρ.symm hx⟩

end StableSplitting

section Equivariance

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  (k : Type u) [Field k] [Algebra k (UnramifiedClosure F)] [Algebra k (SeparableClosure F)]
  [IsScalarTower k (UnramifiedClosure F) (SeparableClosure F)] [Normal k (UnramifiedClosure F)]
  [Normal k (SeparableClosure F)]
  (T : CommGroupScheme (Spec (CommRingCat.of k))) [IsAffine T.X.left]

/-- The norm square value of a pure evaluation conjugated by a `k`-automorphism `τ` of `L` that
is the restriction of a `k`-automorphism `ρ` of `F^sep` and preserves the normalized valuation
of `L`. -/
theorem normLawValue_conjugate_tmul_of_valuation
    (L : IntermediateField (UnramifiedClosure F) (SeparableClosure F))
    [FiniteDimensional (UnramifiedClosure F) L]
    (hL : IsSplitTorus (baseChanged k L T).toGrp)
    (hE : IsSplitTorus (baseChanged k (SeparableClosure F) T).toGrp)
    (ρ : SeparableClosure F ≃ₐ[k] SeparableClosure F) (τ : L ≃ₐ[k] L)
    (hτ : ∀ a : L, ρ (algebraMap L (SeparableClosure F) a) =
      algebraMap L (SeparableClosure F) (τ a))
    (hv : ∀ x : L, normalizedIntermediateValuation F L (τ x) =
      normalizedIntermediateValuation F L x)
    (w : Additive Lˣ) (ν : cocharacterLattice (baseChanged k L T)) :
    normLawValue F k T L hL (Additive.ofMul (conjugate k L T.toGrp τ
      (coefficientEvaluation k L T (w ⊗ₜ[ULift.{u} ℤ] ν)).toMul)) =
    torusGammaRepresentation k (UnramifiedClosure F) (SeparableClosure F) T
      (ρ.restrictNormal (UnramifiedClosure F))
      (normLawValue F k T L hL (coefficientEvaluation k L T (w ⊗ₜ[ULift.{u} ℤ] ν))) := by
  obtain ⟨u₀, hu₀⟩ := exists_not_isOfFinOrder F L
  have hord : IntegerValuation.orderUnits (normalizedIntermediateValuation F L)
      (Units.map τ.toMonoidHom w.toMul) =
      IntegerValuation.orderUnits (normalizedIntermediateValuation F L) w.toMul := by
    apply Multiplicative.toAdd.injective
    rw [IntegerValuation.orderUnits_toAdd, IntegerValuation.orderUnits_toAdd]
    exact congrArg (fun z => -WithZero.log z) (hv (w.toMul : L))
  have h1 := coefficientEvaluation_galois_tmul k L T τ w ν
  have h2 := normLawValue_tmul F k T L hL (Additive.ofMul (Units.map τ.toMonoidHom w.toMul))
    (cocharacterLattice.galoisRepresentation k L T τ ν)
  have h3 := normLawValue_tmul F k T L hL w ν
  have h4 := extendGeometricCocharacters_galois k L (SeparableClosure F) T hE hu₀ τ ρ hτ
    ((IntegerValuation.orderUnits (normalizedIntermediateValuation F L) w.toMul).toAdd • ν)
  have h5 := inertiaGammaRepresentation_restrict k (UnramifiedClosure F) (SeparableClosure F)
    (cocharacterLattice.galoisRepresentation k (SeparableClosure F) T) ρ
    (extendGeometricCocharacters k L (SeparableClosure F) T
      ((IntegerValuation.orderUnits (normalizedIntermediateValuation F L) w.toMul).toAdd • ν))
  have e2 : (IntegerValuation.orderUnits (normalizedIntermediateValuation F L)
      (Additive.ofMul (Units.map τ.toMonoidHom w.toMul)).toMul).toAdd •
        cocharacterLattice.galoisRepresentation k L T τ ν =
      cocharacterLattice.galoisRepresentation k L T τ
        ((IntegerValuation.orderUnits (normalizedIntermediateValuation F L) w.toMul).toAdd • ν) := by
    rw [toMul_ofMul, hord]
    exact (map_zsmul (cocharacterLattice.galoisRepresentation k L T τ) _ ν).symm
  refine (congrArg (normLawValue F k T L hL) h1.symm).trans (h2.trans ?_)
  refine (congrArg (fun z => inertiaProjection k (UnramifiedClosure F) (SeparableClosure F)
    (cocharacterLattice.galoisRepresentation k (SeparableClosure F) T)
    (extendGeometricCocharacters k L (SeparableClosure F) T z)) e2).trans ?_
  refine (congrArg (inertiaProjection k (UnramifiedClosure F) (SeparableClosure F)
    (cocharacterLattice.galoisRepresentation k (SeparableClosure F) T)) h4).trans ?_
  refine h5.symm.trans ?_
  exact congrArg (torusGammaRepresentation k (UnramifiedClosure F) (SeparableClosure F) T
    (ρ.restrictNormal (UnramifiedClosure F))) h3.symm

/-- Conjugating a coefficient point by a valuation-preserving `k`-automorphism `τ` of `L`, the
restriction of `ρ ∈ Aut_k(F^sep)`, acts on the norm square value through the residual Galois
action of `ρ|_K`. -/
theorem normLawValue_conjugate_of_valuation
    (L : IntermediateField (UnramifiedClosure F) (SeparableClosure F))
    [FiniteDimensional (UnramifiedClosure F) L]
    (hL : IsSplitTorus (baseChanged k L T).toGrp)
    (hE : IsSplitTorus (baseChanged k (SeparableClosure F) T).toGrp)
    (ρ : SeparableClosure F ≃ₐ[k] SeparableClosure F) (τ : L ≃ₐ[k] L)
    (hτ : ∀ a : L, ρ (algebraMap L (SeparableClosure F) a) =
      algebraMap L (SeparableClosure F) (τ a))
    (hv : ∀ x : L, normalizedIntermediateValuation F L (τ x) =
      normalizedIntermediateValuation F L x)
    (x : affinePoints T.toGrp (CommAlgCat.of k L)) :
    normLawValue F k T L hL (Additive.ofMul (conjugate k L T.toGrp τ x)) =
    torusGammaRepresentation k (UnramifiedClosure F) (SeparableClosure F) T
      (ρ.restrictNormal (UnramifiedClosure F)) (normLawValue F k T L hL (Additive.ofMul x)) := by
  have key := additive_ext_coefficientEvaluation k L T hL
    (φ := (normLawValue F k T L hL).comp (conjugate k L T.toGrp τ).toAdditive)
    (φ' := (torusGammaRepresentation k (UnramifiedClosure F) (SeparableClosure F) T
      (ρ.restrictNormal (UnramifiedClosure F))).toAddMonoidHom.comp (normLawValue F k T L hL))
    (fun w ν => normLawValue_conjugate_tmul_of_valuation F k T L hL hE ρ τ hτ hv w ν)
  exact DFunLike.congr_fun key (Additive.ofMul x)

end Equivariance

/-- Residual Galois equivariance of the torus Kottwitz map, assuming the existence statement for
the torus Kottwitz map and the existence and uniqueness of the normalized valuation. -/
theorem generalTorusKottwitzEquivariance_of_existence
    (hex : TorusKottwitzExistenceStatement.{u})
    (hnorm : NormalizedIntermediateValuationStatement.{u}) :
    GeneralTorusKottwitzEquivarianceStatement.{u} := by
  intro F _ _ _ _ k _ _ _ _ _ _ T hT σ x
  let : IsAffine T.X.left := torusIsAffine k T hT
  let ρ : SeparableClosure F ≃ₐ[k] SeparableClosure F := σ.liftNormal (SeparableClosure F)
  obtain ⟨L, _, _, hL, h₁, h₂⟩ := exists_stable_finiteGalois_splitting F k T hT ρ
  let τ : L ≃ₐ[k] L := stableRestrict L ρ h₁ h₂
  have hτσ : ∀ a : UnramifiedClosure F,
      τ (algebraMap (UnramifiedClosure F) L a) = algebraMap (UnramifiedClosure F) L (σ a) :=
    fun a => Subtype.ext (AlgEquiv.liftNormal_commutes σ (SeparableClosure F) a)
  have hτ : ∀ a : L, ρ (algebraMap L (SeparableClosure F) a) =
      algebraMap L (SeparableClosure F) (τ a) := fun a => rfl
  have hE : IsSplitTorus (baseChanged k (SeparableClosure F) T).toGrp :=
    hL.baseChange_fieldTower k L (SeparableClosure F) T.toGrp
  obtain ⟨-, hspec, -, hall⟩ := hex F k T hT
  obtain ⟨hsurj, -⟩ := hall L hL
  have hlaw := (torusNormLawAt_iff F k T L hL _).1 (hspec L hL)
  obtain ⟨y, rfl⟩ := hsurj x
  rw [conjugate_relativeNorm k (UnramifiedClosure F) L T σ τ hτσ y, hlaw, hlaw, toAdd_ofAdd,
    toAdd_ofAdd, normLawValue_conjugate_of_valuation F k T L hL hE ρ τ hτ
      (normalizedIntermediateValuation_ringEquiv_of_comm F L hnorm σ.toRingEquiv τ.toRingEquiv
        hτσ) y, AlgEquiv.restrict_liftNormal]

/-- Residual Galois equivariance of the torus Kottwitz homomorphism (KP Proposition 11.1.1, for
the residual Galois action of `Aut_k(K)`): `κ_T(σ x) = σ κ_T(x)`. -/
theorem generalTorusKottwitzEquivariance : GeneralTorusKottwitzEquivarianceStatement.{u} :=
  generalTorusKottwitzEquivariance_of_existence torusKottwitzExistence
    normalizedIntermediateValuationStatement

end Langlands.Geometry.Building.Kottwitz
