import Langlands.Geometry.Building.GenericPointSharpExchange
import Langlands.Geometry.Building.PositiveRootFixerCoordinates

/-! # Positive-root fixer coordinates over any field -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme

namespace Langlands.Geometry.Building.KPApartmentData

variable {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]
    {ω : kˣ → ℝ} (D : KPApartmentData i ω)

omit [Mono i.hom.hom.left] in
/-- The ray property makes every positive root an indivisible positive root or its double. -/
theorem exists_indivisiblePositiveRoot_eq_or_double_of_rayProperty
    (hRay : RootGroupFamily.HasRayProperty i) (ν : cocharacterLattice S)
    {b : characterLattice S} (hb : b ∈ positiveRelativeRoots i ν) :
    ∃ a ∈ RelativeRoot.indivisiblePositiveRoots i ν, b = a ∨ b = 2 • a := by
  obtain ⟨a, ha, m, _, hm, hma⟩ :=
    RelativeRoot.exists_indivisiblePositiveRoot_ray i ν hb.1 hb.2
  have heval : RealTorusSpace.eval S b = (m : ℝ) • RealTorusSpace.eval S a := by
    rw [← hma]
    apply LinearMap.ext
    intro v
    rw [eval_nsmul_char, LinearMap.smul_apply, smul_eq_mul]
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  refine ⟨a, ha, ?_⟩
  rcases hRay ha.1.1 hb.1 hmR heval with heq | heq | heq
  · exact Or.inl heq
  · exact Or.inr heq
  · exact (ha.1.2 b hb.1 2 (by omega) heq.symm).elim

/-- The prescribed primitive-root product is the subgroup generated by all
positive root groups, at either zero depth and at every apartment point. -/
theorem range_orderedIndivisiblePositiveRootGroupProduct_eq_iSup_of_rayProperty
    (hRay : RootGroupFamily.HasRayProperty i)
    (x : D.Apartment) (strict : Bool) (ν : cocharacterLattice S)
    {n : ℕ} (a : Fin n → characterLattice S)
    (hrange : Set.range a = RelativeRoot.indivisiblePositiveRoots i ν) :
    Set.range (RelativeRoot.CentralExtension.orderedProduct
      (fun j => (D.chamberRootGroup x strict (a j)).subtype)) =
      ((⨆ b : positiveRelativeRoots i ν, D.chamberRootGroup x strict b :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
  classical
  let c : Fin (n * 2) → characterLattice S := fun l =>
    if (finProdFinEquiv.symm l).2 = 0 then a (finProdFinEquiv.symm l).1
      else 2 • a (finProdFinEquiv.symm l).1
  let H : Fin (n * 2) → Subgroup (rationalPoints G) := fun l =>
    if c l ∈ relativeRoots i then D.chamberRootGroup x strict (c l) else ⊥
  have ha (j : Fin n) : a j ∈ RelativeRoot.indivisiblePositiveRoots i ν :=
    hrange ▸ Set.mem_range_self j
  have hc0 (j : Fin n) : c (finProdFinEquiv (j, 0)) = a j := by
    simp only [c, Equiv.symm_apply_apply, ↓reduceIte]
  have hc1 (j : Fin n) : c (finProdFinEquiv (j, 1)) = 2 • a j := by
    have h10 : (1 : Fin 2) ≠ 0 := by decide
    simp only [c, Equiv.symm_apply_apply, ite_eq_right h10]
  have hpos (l : Fin (n * 2)) (hl : c l ∈ relativeRoots i) :
      c l ∈ positiveRelativeRoots i ν := by
    refine ⟨hl, ?_⟩
    dsimp only [c]
    split_ifs
    · exact (ha _).2
    · have hp := (ha (finProdFinEquiv.symm l).1).2
      simp only [map_nsmul, LinearMap.smul_apply, nsmul_eq_mul]
      omega
  have hcover (b : positiveRelativeRoots i ν) : ∃ l, c l = b := by
    obtain ⟨d, hd, hb⟩ := exists_indivisiblePositiveRoot_eq_or_double_of_rayProperty hRay ν b.2
    obtain ⟨j, hj⟩ := (show d ∈ Set.range a by rw [hrange]; exact hd)
    rcases hb with hb | hb
    · exact ⟨finProdFinEquiv (j, 0), (hc0 j).trans (hj.trans hb.symm)⟩
    · exact ⟨finProdFinEquiv (j, 1),
        (hc1 j).trans ((congrArg (2 • ·) hj).trans hb.symm)⟩
  have hcollect :
      Set.range (RelativeRoot.CentralExtension.orderedProduct (fun l => (H l).subtype)) =
        ((⨆ l, H l : Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
    apply Langlands.GroupTheory.HeightCollection.range_orderedProduct_eq_iSup
      (w := fun l => (latticePairing S (c l) ν).toNat)
    intro j k
    by_cases hj : c j ∈ relativeRoots i
    · by_cases hk : c k ∈ relativeRoots i
      · have hjH : H j = D.chamberRootGroup x strict (c j) := ite_eq_left hj
        have hkH : H k = D.chamberRootGroup x strict (c k) := ite_eq_left hk
        rw [hjH, hkH]
        refine (D.chamberRootGroup_commutator_height x strict ν (hpos j hj)
          (hpos k hk)).trans ?_
        refine iSup_le fun b => iSup_le fun hb => ?_
        obtain ⟨l, hl⟩ := hcover b
        have hroot : c l ∈ relativeRoots i := hl.symm ▸ b.2.1
        exact le_iSup_of_le l (le_iSup_of_le (hl.symm ▸ hb)
          (by dsimp only [H]; rw [ite_eq_left hroot, hl]))
      · simp only [H, ite_eq_right hk, Subgroup.commutator_bot_right, bot_le]
    · simp only [H, ite_eq_right hj, Subgroup.commutator_bot_left, bot_le]
  have h0 (j : Fin n) :
      H (finProdFinEquiv (j, 0)) = D.chamberRootGroup x strict (a j) := by
    simp only [H, hc0, ite_eq_left (ha j).1.1]
  have h1 (j : Fin n) :
      H (finProdFinEquiv (j, 1)) ≤ D.chamberRootGroup x strict (a j) := by
    simp only [H, hc1]
    split_ifs with h2a
    · cases strict with
      | false => exact D.filtration_double_le x (ha j).1.1 h2a
      | true => exact D.filtrationPlus_double_le x (ha j).1.1 h2a
    · exact bot_le
  rw [← range_orderedProduct_pairs H _ h0 h1, hcollect]
  apply congrArg (fun K : Subgroup (rationalPoints G) => (K : Set (rationalPoints G)))
  apply le_antisymm
  · refine iSup_le fun l => ?_
    dsimp only [H]
    split_ifs with hl
    · exact le_iSup (fun b : positiveRelativeRoots i ν =>
        D.chamberRootGroup x strict b) ⟨c l, hpos l hl⟩
    · exact bot_le
  · refine iSup_le fun b => ?_
    obtain ⟨l, hl⟩ := hcover b
    have hroot : c l ∈ relativeRoots i := hl.symm ▸ b.2.1
    exact le_iSup_of_le l (by dsimp only [H]; rw [ite_eq_left hroot, hl])

/-- An element in the positive depth-zero root groups at every point of a non-empty `Ω` lies in
the subgroup generated by the positive root fixers `U_{b,Ω,0}`. Its ordered coordinates over
the indivisible positive roots at one point of `Ω` are those at every other point. -/
theorem iInf_iSup_chamberRootGroup_le_iSup_rootFixer_of_rayProperty
    (hinj : RelativeRoot.OrderedRootPointInjectivity i)
    (hRay : RootGroupFamily.HasRayProperty i)
    (hfin : (relativeRoots i).Finite) (ν : cocharacterLattice S)
    {Ω : Set D.Apartment} (hΩ : Ω.Nonempty) :
    (⨅ x ∈ Ω, ⨆ b : positiveRelativeRoots i ν, D.chamberRootGroup x false b) ≤
      ⨆ b : positiveRelativeRoots i ν, D.rootFixer b Ω := by
  classical
  intro g hg
  simp only [Subgroup.mem_iInf] at hg
  have hfinite : (RelativeRoot.indivisiblePositiveRoots i ν).Finite :=
    hfin.subset (fun _ ha => ha.1.1)
  obtain ⟨n, a, ha, hrange⟩ := hfinite.fin_param
  have hpos (j : Fin n) : a j ∈ positiveRelativeRoots i ν := by
    have h : a j ∈ RelativeRoot.indivisiblePositiveRoots i ν := hrange ▸ Set.mem_range_self j
    exact ⟨h.1.1, h.2⟩
  have hrng (x : D.Apartment) (hx : x ∈ Ω) : g ∈ Set.range
      (RelativeRoot.CentralExtension.orderedProduct
        (fun j => (D.chamberRootGroup x false (a j)).subtype)) := by
    rw [D.range_orderedIndivisiblePositiveRootGroupProduct_eq_iSup_of_rayProperty hRay x false ν a
      hrange]
    exact hg x hx
  obtain ⟨y, hy⟩ := hΩ
  obtain ⟨t, ht⟩ := hrng y hy
  let t' : ∀ j, rootGroupPoints i (a j) := fun j =>
    ⟨t j, D.filtration_le_rootGroupPoints y (a j) 0 (t j).property⟩
  have hmem (j : Fin n) : (t j : rationalPoints G) ∈ D.rootFixer (a j) Ω := by
    refine D.mem_rootFixer.2 ⟨(t' j).property, fun x hx => ?_⟩
    obtain ⟨s, hs⟩ := hrng x hx
    let s' : ∀ j, rootGroupPoints i (a j) := fun j =>
      ⟨s j, D.filtration_le_rootGroupPoints x (a j) 0 (s j).property⟩
    have hcoords : t' = s' := hinj ν n a ha hrange (ht.trans hs.symm)
    have heq : (t j : rationalPoints G) = (s j : rationalPoints G) :=
      congrArg (fun z => (z j : rationalPoints G)) hcoords
    rw [heq]
    exact (s j).property
  rw [← ht]
  change (List.ofFn fun j => (t j : rationalPoints G)).prod ∈ _
  refine list_prod_mem fun z hz => ?_
  obtain ⟨j, rfl⟩ := List.mem_ofFn.1 hz
  exact Subgroup.mem_iSup_of_mem (⟨a j, hpos j⟩ : positiveRelativeRoots i ν) (hmem j)

/-- Positive depth-zero groups intersect coordinatewise over a nonempty subset, for
apartment data over any field with no additional apartment axioms. -/
theorem iInf_iSup_chamberRootGroup_eq_iSup_rootFixer_of_rankOne
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (ν : cocharacterLattice S) {Ω : Set D.Apartment} (hΩ : Ω.Nonempty) :
    (⨅ x ∈ Ω, ⨆ b : positiveRelativeRoots i ν, D.chamberRootGroup x false b) =
      ⨆ b : positiveRelativeRoots i ν, D.rootFixer b Ω := by
  let : Smooth G.X.hom := hG.smooth
  have hS : IsSplitTorus S.toGrp := hi.1.1
  have hrank := rootRankOneFactorization k G hG S i hi
  have hE : RelativeRoot.HasOppositeFactorPairs i :=
    fun a ha g hg hg1 => (hrank a ha g hg hg1).1.exists
  exact le_antisymm
    (D.iInf_iSup_chamberRootGroup_le_iSup_rootFixer_of_rayProperty
      (RelativeRoot.orderedRootPointInjectivity_of_hasOppositeFactorPairs i hS hE)
      (hasRayProperty_of_rankOne hS hrank) (hS.finite_relativeRoots i) ν hΩ)
    (D.iSup_rootFixer_le_iInf_iSup_chamberRootGroup ν Ω)

end Langlands.Geometry.Building.KPApartmentData
