import Langlands.Geometry.Building.SplitIntegralFrame
import Langlands.GroupScheme.Absolute.MaximalTorusCentralizerProof

/-! # Split integral pinnings of a split torus

A split integral pinning of a split torus `i : S → G` over a field `k` with a `ℤ`-valued
valuation `v` is the field-level part of a split integral frame that does not mention a
building datum: an integral subgroup `K ≤ G(k)` and root parametrizations `u_a` with
Chevalley-type relations, where the centralizer conditions of a frame are replaced by
conditions on the torus. When `i` is the maximal split torus of a building datum `B` and a
maximal torus, a pinning is a split integral frame on `B` (`toFrame`).
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

variable {k : Type u} [Field k] (v : Valuation k (WithZero (Multiplicative ℤ)))
  {S : CommGroupScheme (Spec (CommRingCat.of k))} {G : GroupScheme (Spec (CommRingCat.of k))}
  [IsAffineHom G.X.hom]

/-- The value `a(t) ∈ kˣ` of a character `a` of `S` at `t ∈ S(k)`. -/
abbrev torusCharEval (S : CommGroupScheme (Spec (CommRingCat.of k)))
    (a : characterLattice S) : rationalPoints S.toGrp →* kˣ :=
  rationalCharacterEval ((rationalCharacters.equivCharacterLattice S).symm a)

/-- A split integral pinning of `i : S → G` (internal definition, see the Markdown). The
fields are those of `IntegerValuationBuildingData.SplitIntegralFrame`, except that the two
centralizer conditions are replaced by `torus_mem_K` and `K_le_closure`, which mention only
`S(k)`. -/
structure SplitIntegralPinning (i : S.toGrp ⟶ G) [Mono i.hom.hom.left] where
  /-- The integral subgroup. -/
  K : Subgroup (rationalPoints G)
  /-- The root parametrizations `u a : k → U_a(k)`. -/
  u : characterLattice S → k → rationalPoints G
  u_add : ∀ a ∈ relativeRoots i, ∀ c d : k, u a (c + d) = u a c * u a d
  u_mem : ∀ a ∈ relativeRoots i, ∀ c : k, u a c ∈ rootGroupPoints i a
  u_surjective : ∀ a ∈ relativeRoots i, ∀ g ∈ rootGroupPoints i a, ∃ c : k, u a c = g
  u_eq_one : ∀ a ∈ relativeRoots i, ∀ c : k, u a c = 1 → c = 0
  torus_conj : ∀ a ∈ relativeRoots i, ∀ (t : rationalPoints S.toGrp) (c : k),
    rationalPoints.map i t * u a c * (rationalPoints.map i t)⁻¹ =
      u a ((torusCharEval S a t : k) * c)
  rankOne : ∀ a ∈ relativeRoots i, ∀ c : kˣ,
    ∃ (p q : rationalPoints G × rationalPoints G) (t : rationalPoints S.toGrp),
      RelativeRoot.IsOppositeFactorPair i a (u a c) p ∧
        RelativeRoot.IsOppositeFactorPair i a (u a 1) q ∧
        torusCharEval S a t = c ^ 2 ∧
        p.1 * u a c * p.2 = rationalPoints.map i t * (q.1 * u a 1 * q.2)
  two_smul_not_mem : ∀ a ∈ relativeRoots i, 2 • a ∉ relativeRoots i
  u_mem_K : ∀ a ∈ relativeRoots i, ∀ c : k, u a c ∈ K ↔ v c ≤ 1
  /-- A torus point whose root values are units and whose image lies in `G(k)^1` lies in
  `K`. -/
  torus_mem_K : ∀ t : rationalPoints S.toGrp,
    (∀ a ∈ relativeRoots i, IntegerValuation.order v (torusCharEval S a t) = 0) →
      rationalPoints.map i t ∈ characterValuationKernel v G → rationalPoints.map i t ∈ K
  /-- `K` is generated by `S(k)^1` and the integral root points. -/
  K_le_closure : K ≤ Subgroup.closure
    (rationalPoints.map i '' (characterValuationKernel v S.toGrp : Set _) ∪
      ⋃ a ∈ relativeRoots i, u a '' {c | v c ≤ 1})
  simple : Set (characterLattice S)
  simple_subset : simple ⊆ relativeRoots i
  simple_linearIndependent :
    LinearIndependent ℝ fun b : simple => rootForm i ⟨b, simple_subset b.2⟩
  weyl_mem : ∀ b ∈ simple, u (-b) (-1) * u b 1 * u (-b) (-1) ∈ normalizerPoints i
  induction : ∀ P : characterLattice S → Prop, (∀ b ∈ simple, P b) →
    (∀ b (hb : b ∈ simple), ∀ a ∈ relativeRoots i, P a →
      P (weylAction i ⟨_, weyl_mem b hb⟩ a)) →
    ∀ a ∈ relativeRoots i, P a
  weyl_generated : ∀ n : normalizerPoints i, ∃ m ∈ Subgroup.closure
      (Set.range fun b : simple => (⟨_, weyl_mem b b.2⟩ : normalizerPoints i)),
    weylAction i n = weylAction i m

namespace IntegerValuationBuildingData

variable {v} (B : IntegerValuationBuildingData v G)

/-- If the maximal split torus of `B` is a maximal torus, every centralizer point is a torus
point. -/
theorem exists_map_eq_map_j (hmax : IsMaximalTorus B.i) (z : rationalPoints B.centralizer.Z) :
    ∃ t : rationalPoints B.S.toGrp,
      rationalPoints.map B.i t = rationalPoints.map B.centralizer.j z := by
  have hz : rationalPoints.map B.centralizer.j z ∈
      (torusCentralizer B.i).carrier (Over.mk (𝟙 (Spec (CommRingCat.of k)))) := by
    rw [← B.centralizer.isRepresentedBy.2]
    exact ⟨z, rfl⟩
  rw [maximalTorusCentralizer k G B.isConnectedReductive B.S B.i hmax] at hz
  obtain ⟨t, ht⟩ := hz
  exact ⟨t, ht⟩

/-- A split integral pinning of the maximal split torus of `B`, when that torus is a maximal
torus, is a split integral frame on `B`. -/
def SplitIntegralPinning.toFrame (hmax : IsMaximalTorus B.i) (P : SplitIntegralPinning v B.i) :
    B.SplitIntegralFrame where
  K := P.K
  u := P.u
  u_add := P.u_add
  u_mem := P.u_mem
  u_surjective := P.u_surjective
  u_eq_one := P.u_eq_one
  torus_conj := P.torus_conj
  rankOne := P.rankOne
  two_smul_not_mem := P.two_smul_not_mem
  u_mem_K := P.u_mem_K
  centralizer_mem_K := by
    intro z hz
    obtain ⟨t, ht⟩ := B.exists_map_eq_map_j hmax z
    rw [← ht]
    refine P.torus_mem_K t (fun a ha => ?_) ?_
    · obtain ⟨x⟩ := (inferInstance : Nonempty B.Apartment)
      have hn : B.torusNormalizer t = B.centralizer.toNormalizer z := by
        apply Subtype.ext
        rw [B.coe_torusNormalizer, ht, CentralizerDatum.toNormalizer,
          coe_centralizerToNormalizer]
      have hfix : B.torusNormalizer t • x = x := by
        rw [hn]
        exact B.isOmegaCompatible.smul_eq_self hz x
      have h := B.rootForm_torusNormalizer_vsub t x ⟨a, ha⟩
      rw [hfix, vsub_self, map_zero] at h
      change (0 : ℝ) = -(IntegerValuation.order v (B.charEval a t) : ℝ) at h
      exact_mod_cast neg_eq_zero.1 h.symm
    · rw [ht]
      exact IntegerValuation.map_mem_characterValuationKernel v B.centralizer.j hz
  K_le_closure := by
    refine P.K_le_closure.trans (Subgroup.closure_mono ?_)
    rintro g (⟨t, ht, rfl⟩ | hg)
    · refine Or.inl ⟨rationalPoints.map B.centralizer.s t,
        IntegerValuation.map_mem_characterValuationKernel v B.centralizer.s ht, ?_⟩
      have h : rationalPoints.map (B.centralizer.s ≫ B.centralizer.j) t =
          rationalPoints.map B.i t :=
        congrArg (fun f => rationalPoints.map f t) B.centralizer.comp_eq
      rw [← h]
      simp only [rationalPoints.map_apply, Grp.comp_hom_hom, Category.assoc]
    · exact Or.inr hg
  simple := P.simple
  simple_subset := P.simple_subset
  simple_linearIndependent := P.simple_linearIndependent
  weyl_mem := P.weyl_mem
  induction := P.induction
  weyl_generated := P.weyl_generated

end IntegerValuationBuildingData

end Langlands.Geometry.Building
