namespace Langlands.Geometry.Building

private theorem prod_ofFn_eq_single {M : Type*} [Monoid M] {n : ℕ}
    (f : Fin n → M) (r : Fin n) (hf : ∀ j, j ≠ r → f j = 1) :
    (List.ofFn f).prod = f r := by
  classical
  rw [List.ofFn_eq_map, List.prod_map_eq_pow_single r f (fun j hj _ => hf j hj)]
  simp

namespace KPApartmentData

variable {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]
    {ω : kˣ → ℝ} (D : KPApartmentData i ω)

/-- Ordered root coordinates isolate an indivisible root inside the subgroup
generated by positive depth-zero filtrations. -/
theorem mem_filtration_of_indivisible_of_mem_positiveRootGroups
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots =
      Set.range (rootForm i))
    (x : D.Apartment) (ν : cocharacterLattice S)
    {b : characterLattice S} (hb : b ∈ RelativeRoot.indivisiblePositiveRoots i ν)
    {g : rationalPoints G} (hg : g ∈ rootGroupPoints i b)
    (hgpos : g ∈ ⨆ c : positiveRelativeRoots i ν, D.chamberRootGroup x false c) :
    g ∈ D.filtration x b 0 := by
  classical
  have : Smooth G.X.hom := hG.smooth
  have hfinite : (RelativeRoot.indivisiblePositiveRoots i ν).Finite :=
    (hi.1.1.finite_relativeRoots i).subset (fun _ ha => ha.1.1)
  obtain ⟨n, a, ha, hrange⟩ := hfinite.fin_param
  obtain ⟨r, hr⟩ := (show b ∈ Set.range a by rw [hrange]; exact hb)
  obtain ⟨t, ht⟩ := (show g ∈ Set.range
      (RelativeRoot.CentralExtension.orderedProduct
        (fun j => (D.chamberRootGroup x false (a j)).subtype)) by
    rw [D.range_orderedIndivisiblePositiveRootGroupProduct_eq_iSup
      hsys hderiv x false ν a hrange]
    exact hgpos)
  let t' : ∀ j, rootGroupPoints i (a j) := fun j =>
    ⟨t j, D.filtration_le_rootGroupPoints x (a j) 0 (t j).property⟩
  let s : ∀ j, rootGroupPoints i (a j) := fun j =>
    if h : j = r then ⟨g, by simpa only [h, hr] using hg⟩ else 1
  have hsprod : (List.ofFn fun j => (s j : rationalPoints G)).prod = g := by
    rw [prod_ofFn_eq_single (fun j => (s j : rationalPoints G)) r
      (fun j hj => by simp only [s, dite_eq_right hj, OneMemClass.coe_one])]
    simp only [s, dite_eq_left rfl]
  have hcoords : t' = s :=
    RelativeRoot.orderedRootSubgroupPoints_injective_of_statement
      hprod hG hi ν a ha hrange (Over.mk (𝟙 _)) (ht.trans hsprod.symm)
  have hcoord : (t r : rationalPoints G) = g := by
    have hc := congrArg (fun z => (z r : rationalPoints G)) hcoords
    simpa only [t', s, dite_eq_left rfl] using hc
  have hmem : (t r : rationalPoints G) ∈ D.filtration x b 0 := by
    rw [← hr]
    exact (t r).property
  rwa [hcoord] at hmem

/-- V4 recovers the doubled-root filtration from its primitive filtration
for a point already in the doubled-root group. -/
theorem mem_filtration_double_of_mem_filtration
    (x : D.Apartment) {a : characterLattice S}
    (ha : a ∈ relativeRoots i) (h2a : 2 • a ∈ relativeRoots i)
    {g : rationalPoints G} (hg : g ∈ rootGroupPoints i (2 • a))
    (hga : g ∈ D.filtration x a 0) :
    g ∈ D.filtration x (2 • a) 0 := by
  refine ⟨hg, ?_⟩
  rw [x.isValuation.double a ha h2a g hg, two_nsmul]
  simpa only [← WithTop.coe_add, add_zero] using add_le_add hga.2 hga.2

/-- Every positive actual root, including a divisible root, has its
depth-zero coordinate isolated by ordered-product injectivity and V4. -/
theorem mem_filtration_of_mem_rootGroup_of_mem_positiveRootGroups
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (hG : IsConnectedReductive G) (hi : IsMaximalSplitTorus i)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots =
      Set.range (rootForm i))
    (x : D.Apartment) (ν : cocharacterLattice S)
    {b : characterLattice S} (hb : b ∈ positiveRelativeRoots i ν)
    {g : rationalPoints G} (hg : g ∈ rootGroupPoints i b)
    (hgpos : g ∈ ⨆ c : positiveRelativeRoots i ν, D.chamberRootGroup x false c) :
    g ∈ D.filtration x b 0 := by
  obtain ⟨a, ha, hba⟩ := D.exists_indivisiblePositiveRoot_eq_or_double hsys hderiv ν hb
  rcases hba with rfl | rfl
  · exact D.mem_filtration_of_indivisible_of_mem_positiveRootGroups
      hprod hG hi hsys hderiv x ν ha hg hgpos
  · have hga := RelativeRoot.double_subgroup_le i a (Over.mk (𝟙 _)) hg
    exact D.mem_filtration_double_of_mem_filtration x ha.1.1 hb.1 hg
      (D.mem_filtration_of_indivisible_of_mem_positiveRootGroups
        hprod hG hi hsys hderiv x ν ha hga hgpos)

end KPApartmentData

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G)

/-- Point exchange with the chosen unipotent factor first removes the
normalizer factor from an actual full-parahoric element. -/
theorem mem_positiveRootGroups_of_mem_unipotent_of_mem_parahoric
    (hP : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization P.i)
    (x : P.Apartment) (ν : cocharacterLattice P.S)
    (hν : IsGenericCocharacter P.i ν)
    {g : rationalPoints G}
    (hgU : g ∈ (Dynamic.unipotent
      (CommGroupScheme.groupHom ν ≫ P.i)).carrier (Over.mk (𝟙 _)))
    (hgP : g ∈ P.parahoric {x}) :
    g ∈ ⨆ b : positiveRelativeRoots P.i ν, P.apartment.chamberRootGroup x false b := by
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have hνneg : IsGenericCocharacter P.i (-ν) := by
    intro a ha
    simpa only [map_neg] using neg_ne_zero.mpr (hν a ha)
  have hsharp := P.toValuationBuildingData.sharpFixer_subset_mul_sharpNormalizerStabilizer
    hP hrank x (-ν) hνneg
  rw [neg_neg] at hsharp
  have hgP' : g ∈ (P.sharpFixer {x} : Set (rationalPoints G)) *
      (P.centralizerZero.map (rationalPoints.map P.centralizer.j) :
        Set (rationalPoints G)) := by
    rw [← P.coe_parahoric_eq_mul_reverse {x}]
    exact hgP
  obtain ⟨s, hs, z, hz, hsz⟩ := hgP'
  obtain ⟨vw, ⟨v, hv, w, hw, rfl⟩, n, hn, hvwn⟩ := hsharp hs
  change v * w * n = s at hvwn
  change s * z = g at hsz
  have hnN : n ∈ normalizerPoints P.i :=
    (KPApartmentData.mem_sharpNormalizerStabilizer.mp hn).2.1
  have hzN : z ∈ normalizerPoints P.i := by
    obtain ⟨z₀, _, rfl⟩ := hz
    exact centralizerPoints_le_normalizerPoints P.i
      (map_mem_centralizerPoints P.centralizer.isRepresentedBy z₀)
  let n' : normalizerPoints P.i := ⟨n * z, (normalizerPoints P.i).mul_mem hnN hzN⟩
  have hfactor : v * w * (n' : rationalPoints G) = g := by
    change v * w * (n * z) = g
    rw [← mul_assoc, hvwn]
    exact hsz
  have hvU := (P.apartment.positiveChamberRootGroups_le_sharpUnipotentPoints x ν hv).1
  have hwU := (P.apartment.positiveChamberRootGroups_le_sharpUnipotentPoints x (-ν) hw).1
  have hpos : v⁻¹ * g ∈ (Dynamic.unipotent
      (CommGroupScheme.groupHom ν ≫ P.i)).carrier (Over.mk (𝟙 _)) :=
    Subgroup.mul_mem _ (Subgroup.inv_mem _ hvU) hgU
  have hopp : w⁻¹ ∈ (Dynamic.unipotent (Dynamic.oppositeCocharacter
      (CommGroupScheme.groupHom ν ≫ P.i))).carrier (Over.mk (𝟙 _)) := by
    rw [← groupHom_neg_comp_eq_oppositeCocharacter P.i ν]
    exact Subgroup.inv_mem _ hwU
  have heq : (n' : rationalPoints G) = w⁻¹ * (v⁻¹ * g) := by
    rw [← hfactor]
    group
  have hn' : n' = 1 :=
    normalizer_eq_one_of_unipotent_product P.i ν n' ⟨_, hopp⟩ ⟨_, hpos⟩ heq
  have hfactor' : v * w = g := by simpa only [hn', OneMemClass.coe_one, mul_one] using hfactor
  have hwpos : w ∈ (Dynamic.unipotent
      (CommGroupScheme.groupHom ν ≫ P.i)).carrier (Over.mk (𝟙 _)) := by
    have hwg : w = v⁻¹ * g := by rw [← hfactor']; group
    rw [hwg]
    exact hpos
  have hwopp : w ∈ (Dynamic.unipotent (Dynamic.oppositeCocharacter
      (CommGroupScheme.groupHom ν ≫ P.i))).carrier (Over.mk (𝟙 _)) := by
    rw [← groupHom_neg_comp_eq_oppositeCocharacter P.i ν]
    exact hwU
  have hw1 : w = 1 :=
    Dynamic.eq_one_of_mem_opposite_unipotent_of_mem_parabolic
      (CommGroupScheme.groupHom ν ≫ P.i) hwopp
      (Dynamic.unipotent_le_parabolic _ _ hwpos)
  have hvg : v = g := by simpa only [hw1, mul_one] using hfactor'
  exact hvg ▸ hv

/-- A root-group element of the actual point parahoric has nonnegative
valuation, with factor pairs and ordered products retained as inputs. -/
theorem mem_filtration_of_mem_rootGroup_of_mem_parahoricAt
    (hP : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization P.i)
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (x : P.Apartment) {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i)
    {g : rationalPoints G} (hgRoot : g ∈ P.rootGroup a)
    (hgP : g ∈ P.parahoricAt x) :
    g ∈ P.filtration x a 0 := by
  have : Smooth G.X.hom := P.isConnectedReductive.smooth
  obtain ⟨ν₀, hν₀⟩ :=
    P.isMaximalSplitTorus.isSplitSubtorus.1.exists_genericCocharacter P.i
  have hchoice : ∃ ν : cocharacterLattice P.S,
      IsGenericCocharacter P.i ν ∧ 0 < latticePairing P.S a ν := by
    rcases lt_or_gt_of_ne (hν₀ a ha) with hneg | hpos
    · refine ⟨-ν₀, ?_, ?_⟩
      · intro b hb
        simpa only [map_neg] using neg_ne_zero.mpr (hν₀ b hb)
      · simpa only [map_neg] using neg_pos.mpr hneg
    · exact ⟨ν₀, hν₀, hpos⟩
  obtain ⟨ν, hν, hpos⟩ := hchoice
  have hgU := RelativeRoot.subgroup_le_dynamicUnipotent P.i ν hpos
    (Over.mk (𝟙 _)) hgRoot
  exact P.apartment.mem_filtration_of_mem_rootGroup_of_mem_positiveRootGroups
    hprod P.isConnectedReductive P.isMaximalSplitTorus
    hP.isAffineRootSystem_extendedAffineRoots hP.derivativeRoots_extendedAffineRoots
    x ν ⟨ha, hpos⟩ hgRoot
    (P.mem_positiveRootGroups_of_mem_unipotent_of_mem_parahoric
      hP hrank x ν hν hgU hgP)

/-- The actual root group meets the actual point parahoric in its
depth-zero filtration. -/
theorem rootGroup_inf_parahoricAt_eq_filtration
    (hP : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization P.i)
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (x : P.Apartment) {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i) :
    P.rootGroup a ⊓ P.parahoricAt x = P.filtration x a 0 := by
  apply le_antisymm
  · intro g hg
    exact P.mem_filtration_of_mem_rootGroup_of_mem_parahoricAt
      hP hrank hprod x ha hg.1 hg.2
  · exact le_inf (P.filtration_le_rootGroup x a 0)
      ((P.apartment.filtration_le_sharpFixer x ha).trans
        (P.sharpFixer_le_parahoric {x}))

/-- The identity on ambient rational points identifies the root-group
intersection with the depth-zero filtration. -/
def rootGroupParahoricAtEquivFiltration
    (hP : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization P.i)
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (x : P.Apartment) {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i) :
    ↥(P.rootGroup a ⊓ P.parahoricAt x) ≃* P.filtration x a 0 :=
  MulEquiv.subgroupCongr (P.rootGroup_inf_parahoricAt_eq_filtration hP hrank hprod x ha)

@[simp]
theorem rootGroupParahoricAtEquivFiltration_apply
    (hP : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization P.i)
    (hprod : RelativeRoot.DynamicRootOrderedProductStatement.{u})
    (x : P.Apartment) {a : characterLattice P.S} (ha : a ∈ relativeRoots P.i)
    (g : ↥(P.rootGroup a ⊓ P.parahoricAt x)) :
    (P.rootGroupParahoricAtEquivFiltration hP hrank hprod x ha g :
      rationalPoints G) = g := rfl

end ParahoricBuildingData
end Langlands.Geometry.Building
