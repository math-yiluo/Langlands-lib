import Langlands.Geometry.Building.FullValidity.DatumTransport.RootSystem

/-!
# Axiom 4.1.8 under based group isomorphisms

Bounded subsets of the apartments, the zero fixers `G(F)^0_Ω`, the root groups, the fixers
`U_{a,Ω,0}` and the groups generated by `Z(F)^0` and the `U_ψ` with `ψ(Ω) ≥ 0` all correspond
under `f` and the apartment comparison. Hence clauses (2) and (3) of KP Axiom 4.1.8 are carried
from `G` to `H`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped Pointwise CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

open DatumTransport

namespace ValuationBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G H : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] [IsAffineHom H.X.hom]
  (B : ValuationBuildingData G) {S : CommGroupScheme (Spec (CommRingCat.of F))}
  {j : S.toGrp ⟶ H} (σ : B.S ≅ S) (f : G ≅ H)
  (h : B.i ≫ f.hom = CommGroupScheme.groupHom σ.hom ≫ j)

/-- Bounded subsets of the apartments correspond. -/
theorem isBoundedSubset_image_basedApartmentEquiv_iff (Ω : Set B.Apartment) :
    (B.basedTransport σ f h).IsBoundedSubset (B.basedApartmentEquiv σ f h '' Ω) ↔
      B.IsBoundedSubset Ω := by
  constructor
  · intro hb φ
    have hφ := hb (φ.comp (B.basedApartmentEquiv σ f h).symm.toAffineMap)
    rw [Set.image_image] at hφ
    simpa only [AffineMap.coe_comp, AffineEquiv.coe_toAffineMap, Function.comp_apply,
      AffineEquiv.symm_apply_apply] using hφ
  · intro hb φ
    have hφ := hb (φ.comp (B.basedApartmentEquiv σ f h).toAffineMap)
    rw [Set.image_image]
    simpa only [AffineMap.coe_comp, AffineEquiv.coe_toAffineMap, Function.comp_apply] using hφ

/-- The image of a subset of the apartment in the building is carried to the image of its
transport. -/
theorem image_apartmentMap_basedTransport (Ω : Set B.Apartment) :
    B.basedBuildingEquiv σ f h '' (B.apartmentMap '' Ω) =
      (B.basedTransport σ f h).apartmentMap '' (B.basedApartmentEquiv σ f h '' Ω) := by
  rw [Set.image_image, Set.image_image]
  exact Set.image_congr fun x _ => B.basedBuildingEquiv_apartmentMap σ f h x

/-- Root groups correspond under `f`. -/
theorem map_rootGroup_basedTransport (α : characterLattice B.S) :
    (B.rootGroup α).map (rationalPoints.map f.hom) =
      (B.basedTransport σ f h).rootGroup (characterLattice.congr σ α) := by
  ext y
  obtain ⟨g, rfl⟩ := (pointsEquiv f).surjective y
  rw [pointsEquiv_apply, mem_map_iff]
  exact (rootGroupPoints_transport_iff σ f h α g).symm

/-- The fixers `U_{a,Ω,0}` correspond under `f`. -/
theorem map_rootFixer_basedTransport (α : characterLattice B.S) (Ω : Set B.Apartment) :
    (B.rootFixer α Ω).map (rationalPoints.map f.hom) =
      (B.basedTransport σ f h).rootFixer (characterLattice.congr σ α)
        (B.basedApartmentEquiv σ f h '' Ω) :=
  have := mono_of_isMaximalSplitTorus (B.isMaximalSplitTorus_of_basedIso σ f h)
  B.apartment.map_rootFixer_transport σ f h α Ω

end ValuationBuildingData

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G H : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom] [IsAffineHom H.X.hom]
  (P : ParahoricBuildingData G) {S : CommGroupScheme (Spec (CommRingCat.of F))}
  {j : S.toGrp ⟶ H} (σ : P.S ≅ S) (f : G ≅ H)
  (h : P.i ≫ f.hom = CommGroupScheme.groupHom σ.hom ≫ j)

/-- `G(F)^0_Ω` is carried onto `H(F)^0_{Ω'}` for the transported subset `Ω'`. -/
theorem map_zeroFixer_basedTransport (Ω : Set P.Apartment) :
    (P.zeroFixer Ω).map (rationalPoints.map f.hom) =
      (P.basedTransport σ f h).zeroFixer (P.basedApartmentEquiv σ f h '' Ω) := by
  have h1 := Subgroup.map_inf_eq P.zeroSubgroup (P.pointwiseFixer (P.apartmentMap '' Ω))
    (rationalPoints.map f.hom) (pointsEquiv f).injective
  have h3 := P.map_pointwiseFixer_basedTransport σ f h (P.apartmentMap '' Ω)
  rw [P.image_apartmentMap_basedTransport σ f h Ω] at h3
  exact h1.trans (congrArg₂ (· ⊓ ·) (P.basedTransport_zeroSubgroup σ f h).symm h3)

/-- The group generated by `Z(F)^0` and the `U_ψ` with `ψ(Ω) ≥ 0` is carried onto the
corresponding group for the transported subset. -/
theorem map_nonnegativeRootSubgroup_basedTransport (Ω : Set P.Apartment) :
    (P.nonnegativeRootSubgroup Ω).map (rationalPoints.map f.hom) =
      (P.basedTransport σ f h).nonnegativeRootSubgroup (P.basedApartmentEquiv σ f h '' Ω) := by
  have := mono_of_isMaximalSplitTorus (P.isMaximalSplitTorus_of_basedIso σ f h)
  let A := P.basedApartmentEquiv σ f h
  let T := P.apartment.affineFunctionalTransportEquiv σ f h
  have hT (ψ : P.Apartment →ᵃ[ℝ] ℝ) (x : P.Apartment) : T ψ (A x) = ψ x :=
    P.apartment.affineFunctionalTransportEquiv_apply_map σ f h ψ x
  rw [nonnegativeRootSubgroup, nonnegativeRootSubgroup, Subgroup.map_sup, MonoidHom.map_closure]
  congr 1
  · exact (subgroup_map_comp P.centralizer.j f.hom P.centralizerZero).symm
  · congr 1
    ext y
    simp only [Set.mem_image, Set.mem_iUnion, exists_prop, SetLike.mem_coe]
    constructor
    · rintro ⟨g, ⟨α, ψ, hψ, hlin, hΩ, hg⟩, rfl⟩
      refine ⟨relativeRootsTransportEquiv σ f h α, T ψ,
        (P.apartment.mem_affineRoots_transport_iff σ f h ψ).2 hψ,
        (P.apartment.affineFunctionalTransportEquiv_linear_eq_rootForm_iff σ f h ψ α).2 hlin,
        ?_, (P.apartment.mem_affineRootGroup_transport_iff σ f h α ψ g).2 hg⟩
      rintro _ ⟨x, hx, rfl⟩
      exact (hΩ x hx).trans_eq (hT ψ x).symm
    · rintro ⟨α', ψ', hψ', hlin', hΩ', hy⟩
      obtain ⟨α, rfl⟩ := (relativeRootsTransportEquiv σ f h).surjective α'
      obtain ⟨ψ, rfl⟩ := T.surjective ψ'
      obtain ⟨g, rfl⟩ := (pointsEquiv f).surjective y
      refine ⟨g, ⟨α, ψ, (P.apartment.mem_affineRoots_transport_iff σ f h ψ).1 hψ',
        (P.apartment.affineFunctionalTransportEquiv_linear_eq_rootForm_iff σ f h ψ α).1 hlin',
        fun x hx => ?_, (P.apartment.mem_affineRootGroup_transport_iff σ f h α ψ g).1 hy⟩, rfl⟩
      exact (hΩ' (A x) ⟨x, hx, rfl⟩).trans_eq (hT ψ x)

/-- Every subset of the target apartment is the transport of a subset of the source
apartment. -/
theorem exists_image_basedApartmentEquiv (Ω' : Set (P.basedTransport σ f h).Apartment) :
    ∃ Ω : Set P.Apartment, P.basedApartmentEquiv σ f h '' Ω = Ω' :=
  ⟨P.basedApartmentEquiv σ f h ⁻¹' Ω',
    Set.image_preimage_eq Ω' (P.basedApartmentEquiv σ f h).surjective⟩

/-- KP Axiom 4.1.8 (2) for `G` gives Axiom 4.1.8 (2) for `H`. -/
theorem HasZeroFixerGenerators.basedTransport (hP : P.HasZeroFixerGenerators) :
    (P.basedTransport σ f h).HasZeroFixerGenerators := by
  intro Ω' hne hb
  obtain ⟨Ω, rfl⟩ := P.exists_image_basedApartmentEquiv σ f h Ω'
  have hb' := (P.isBoundedSubset_image_basedApartmentEquiv_iff σ f h Ω).1 hb
  exact (P.map_zeroFixer_basedTransport σ f h Ω).symm.trans
    ((congrArg (Subgroup.map (rationalPoints.map f.hom)) (hP Ω hne.of_image hb')).trans
      (P.map_nonnegativeRootSubgroup_basedTransport σ f h Ω))

/-- KP Axiom 4.1.8 (3) for `G` gives Axiom 4.1.8 (3) for `H`. -/
theorem HasRootZeroFixers.basedTransport (hP : P.HasRootZeroFixers) :
    (P.basedTransport σ f h).HasRootZeroFixers := by
  have := mono_of_isMaximalSplitTorus (P.isMaximalSplitTorus_of_basedIso σ f h)
  intro Ω' hne hb α'
  obtain ⟨Ω, rfl⟩ := P.exists_image_basedApartmentEquiv σ f h Ω'
  obtain ⟨α, rfl⟩ := (relativeRootsTransportEquiv σ f h).surjective α'
  have hb' := (P.isBoundedSubset_image_basedApartmentEquiv_iff σ f h Ω).1 hb
  have hroot := P.map_rootGroup_basedTransport σ f h α
  have hfix := P.map_rootFixer_basedTransport σ f h α Ω
  have hzero := P.map_zeroFixer_basedTransport σ f h Ω
  exact (congrArg₂ (· ⊓ ·) hroot hzero).symm.trans
    ((Subgroup.map_inf_eq _ _ (rationalPoints.map f.hom) (pointsEquiv f).injective).symm.trans
      ((congrArg (Subgroup.map (rationalPoints.map f.hom)) (hP Ω hne.of_image hb' α)).trans hfix))

end ParahoricBuildingData

end Langlands.Geometry.Building
