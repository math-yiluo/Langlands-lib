import Langlands.Geometry.Building.NormalizerNormOneFixerBoundedness
import Langlands.Geometry.Building.SharpFixerBoundednessStatement
import Langlands.Geometry.Building.ChamberPositiveCollection
import Langlands.Geometry.Building.KPRootFixerTopology
import Langlands.Geometry.Building.KPParahoricFixerComparison
import Langlands.GroupScheme.Rational.GenericCocharacter

/-!
# Assembly of singleton sharp-fixer boundedness (KP Corollary 7.3.14)

The product `U⁻_x U⁺_x N(F)^1_x` of the subgroups generated by the zero-depth root
groups of the negative and of the positive roots, and of the norm-one stabilizer
of `x` in `N(F)`, is bounded once `Z(F)^1` is. Any subset of `G(F)` covered by it,
in particular the singleton sharp fixer under the KP Proposition 7.3.12 cover, is
then bounded. The cover and the boundedness of `Z(F)^1` are explicit premises.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.AlgebraicGeometry.PointTopology Langlands.Plancherel

namespace Langlands.Geometry.Building.ValuationBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (B : ValuationBuildingData G)

local instance sharpAssemblyAffine : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom

local instance sharpAssemblyCentralizerAffine : IsAffine B.centralizer.Z.X.left := by
  have : IsClosedImmersion B.centralizer.j.hom.hom.left := B.centralizer.isClosedSubgroup
  exact isAffine_of_isAffineHom B.centralizer.j.hom.hom.left

/-- The indivisible roots positive on `ν` admit an enumeration by actual relative roots. -/
theorem exists_indivisiblePositiveRoots_enumeration (ν : cocharacterLattice B.S) :
    ∃ (n : ℕ) (a : Fin n → relativeRoots B.i),
      Set.range (fun j => (a j : characterLattice B.S)) =
        RelativeRoot.indivisiblePositiveRoots B.i ν := by
  classical
  have := B.isConnectedReductive.smooth
  have : Finite (relativeRoots B.i) :=
    (B.isMaximalSplitTorus.isSplitSubtorus.1.finite_relativeRoots B.i).to_subtype
  let T : Set (relativeRoots B.i) :=
    {a | (a : characterLattice B.S) ∈ RelativeRoot.indivisiblePositiveRoots B.i ν}
  let : Fintype T := Fintype.ofFinite T
  let e : Fin (Fintype.card T) ≃ T := (Fintype.equivFin T).symm
  refine ⟨Fintype.card T, fun j => (e j : relativeRoots B.i), ?_⟩
  ext b
  constructor
  · rintro ⟨j, rfl⟩
    exact (e j).property
  · intro hb
    let t : T := ⟨⟨b, hb.1.1⟩, hb⟩
    exact ⟨e.symm t, by simp only [Equiv.apply_symm_apply]; rfl⟩

/-- The subgroup generated by the root groups `U_{b,x,0}` (or `U_{b,x,0+}`) of the
roots `b` positive on `ν` is bounded: it is the compact range of a finite ordered
product of root blocks. -/
theorem isAlgebraicallyBounded_iSup_chamberRootGroup
    (hB : B.apartment.SatisfiesApartmentAxioms B.centralizer)
    (x : B.Apartment) (strict : Bool) (ν : cocharacterLattice B.S) :
    IsAlgebraicallyBounded F G.X
      ((⨆ b : positiveRelativeRoots B.i ν, B.apartment.chamberRootGroup x strict b :
        Subgroup (rationalPoints G)) : Set (rationalPoints G)) := by
  obtain ⟨n, a, ha⟩ := B.exists_indivisiblePositiveRoots_enumeration ν
  rw [← B.apartment.range_orderedPositiveChamberBlockProduct_eq_iSup
    hB.isAffineRootSystem_extendedAffineRoots hB.derivativeRoots_extendedAffineRoots
    x strict ν _ ha]
  exact isAlgebraicallyBounded_of_isCompact
    (B.isCompact_range_orderedChamberBlockProduct hB.topologyCompatible x strict a)

/-- The product `U⁻_x U⁺_x N(F)^1_x`: the subgroups generated by the zero-depth root
groups at `x` of the roots negative and positive on `ν`, and the norm-one stabilizer
of `x` in `N(F)`. -/
def normOneExchangeProduct (x : B.Apartment) (ν : cocharacterLattice B.S) :
    Set (rationalPoints G) :=
  ((⨆ b : positiveRelativeRoots B.i (-ν), B.apartment.chamberRootGroup x false b :
      Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
    ((⨆ b : positiveRelativeRoots B.i ν, B.apartment.chamberRootGroup x false b :
      Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
    (B.normOneNormalizerStabilizer x : Set (rationalPoints G))

/-- If `j(Z(F)^1)` is bounded, the product `U⁻_x U⁺_x N(F)^1_x` is bounded. -/
theorem isAlgebraicallyBounded_normOneExchangeProduct
    (hB : B.apartment.SatisfiesApartmentAxioms B.centralizer)
    (hZ : IsAlgebraicallyBounded F G.X (rationalPoints.map B.centralizer.j ''
      (rationalCommonNormKernel B.centralizer.Z : Set (rationalPoints B.centralizer.Z))))
    (x : B.Apartment) (ν : cocharacterLattice B.S) :
    IsAlgebraicallyBounded F G.X (B.normOneExchangeProduct x ν) := by
  let : Smooth G.X.hom := B.isConnectedReductive.smooth
  exact ((B.isAlgebraicallyBounded_iSup_chamberRootGroup hB x false (-ν)).mul
    (B.isAlgebraicallyBounded_iSup_chamberRootGroup hB x false ν)).mul
    (B.isAlgebraicallyBounded_normOneNormalizerStabilizer hZ x)

/-- Elements of the singleton sharp fixer that normalize `S` and fix `x` lie in
`N(F)^1_x`, since the sharp fixer lies in `G(F)^1`. -/
theorem sharpFixer_inf_stabilizer_le_normOneNormalizerStabilizer
    (hB : B.apartment.IsTopologyCompatible) (x : B.Apartment) :
    B.sharpFixer {x} ⊓
        (MulAction.stabilizer (normalizerPoints B.i) x).map (normalizerPoints B.i).subtype ≤
      B.normOneNormalizerStabilizer x :=
  inf_le_inf_right _ (B.sharpFixer_le_rationalCommonNormKernel hB (Set.mem_singleton x))

/-- A KP Proposition 7.3.12 cover of the singleton sharp fixer by
`U⁻_x U⁺_x (G(F)^♯_x ∩ N(F)_x)` and boundedness of `j(Z(F)^1)` bound the sharp fixer. -/
theorem isAlgebraicallyBounded_sharpFixer_of_subset
    (hB : B.apartment.SatisfiesApartmentAxioms B.centralizer)
    (hZ : IsAlgebraicallyBounded F G.X (rationalPoints.map B.centralizer.j ''
      (rationalCommonNormKernel B.centralizer.Z : Set (rationalPoints B.centralizer.Z))))
    (x : B.Apartment) (ν : cocharacterLattice B.S)
    (hsub : (B.sharpFixer {x} : Set (rationalPoints G)) ⊆
      ((⨆ b : positiveRelativeRoots B.i (-ν), B.apartment.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots B.i ν, B.apartment.chamberRootGroup x false b :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((B.sharpFixer {x} ⊓ (MulAction.stabilizer (normalizerPoints B.i) x).map
          (normalizerPoints B.i).subtype : Subgroup (rationalPoints G)) :
          Set (rationalPoints G))) :
    IsAlgebraicallyBounded F G.X (B.sharpFixer {x} : Set (rationalPoints G)) :=
  (B.isAlgebraicallyBounded_normOneExchangeProduct hB hZ x ν).mono
    (hsub.trans (Set.mul_subset_mul_left
      (B.sharpFixer_inf_stabilizer_le_normOneNormalizerStabilizer hB.topologyCompatible x)))

/-- Compactness of `Z(F)^1` in the canonical topology of `Z(F)` bounds `j(Z(F)^1)`. -/
theorem isAlgebraicallyBounded_image_centralizerNormKernel_of_isCompact
    (hZ : letI : TopologicalSpace (rationalPoints B.centralizer.Z) :=
        rationalPointTopology F B.centralizer.Z.X
      IsCompact (rationalCommonNormKernel B.centralizer.Z :
        Set (rationalPoints B.centralizer.Z))) :
    IsAlgebraicallyBounded F G.X (rationalPoints.map B.centralizer.j ''
      (rationalCommonNormKernel B.centralizer.Z : Set (rationalPoints B.centralizer.Z))) := by
  exact (isAlgebraicallyBounded_of_isCompact hZ).image_rationalPointsMap B.centralizer.j

/-- KP Corollary 7.3.14 for singletons, from boundedness of `j(Z(F)^1)` and the
KP Proposition 7.3.12 cover for generic cocharacters. -/
theorem sharpFixerBoundedness_of_cover
    (hZ : IsAlgebraicallyBounded F G.X (rationalPoints.map B.centralizer.j ''
      (rationalCommonNormKernel B.centralizer.Z : Set (rationalPoints B.centralizer.Z))))
    (hcover : B.apartment.SatisfiesApartmentAxioms B.centralizer →
      ∀ (x : B.Apartment) (ν : cocharacterLattice B.S), IsGenericCocharacter B.i ν →
        (B.sharpFixer {x} : Set (rationalPoints G)) ⊆
          ((⨆ b : positiveRelativeRoots B.i (-ν), B.apartment.chamberRootGroup x false b :
              Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
            ((⨆ b : positiveRelativeRoots B.i ν, B.apartment.chamberRootGroup x false b :
              Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
            ((B.sharpFixer {x} ⊓ (MulAction.stabilizer (normalizerPoints B.i) x).map
              (normalizerPoints B.i).subtype : Subgroup (rationalPoints G)) :
              Set (rationalPoints G))) :
    B.SharpFixerBoundednessStatement := by
  intro hB x
  let : Smooth G.X.hom := B.isConnectedReductive.smooth
  obtain ⟨ν, hν⟩ := B.isMaximalSplitTorus.isSplitSubtorus.1.exists_genericCocharacter B.i
  exact B.isAlgebraicallyBounded_sharpFixer_of_subset hB hZ x ν (hcover hB x ν hν)

end Langlands.Geometry.Building.ValuationBuildingData
