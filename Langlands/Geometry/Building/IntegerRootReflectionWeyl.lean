import Langlands.Geometry.Building.IntegerAffineRootArrangement
import Langlands.Geometry.Building.AffineRootDoubling

/-! # The reflection-generated normalizer for integer-valued building data -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building.IntegerValuationBuildingData

variable {k : Type u} [Field k]
    {v : Valuation k (WithZero (Multiplicative ℤ))}
    {G : GroupScheme (Spec (CommRingCat.of k))} [IsAffineHom G.X.hom]
    (B : IntegerValuationBuildingData v G)

/-- The subgroup of actual normalizer points generated by all opposite-pair
representatives of nonidentity relative-root points. -/
def reflectionNormalizer : Subgroup (normalizerPoints B.i) :=
  Subgroup.closure {n | ∃ (a : relativeRoots B.i) (g : rationalPoints G),
    g ∈ B.rootGroup a ∧ g ≠ 1 ∧
      ∃ (p : rationalPoints G × rationalPoints G)
        (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p),
        n = B.reflectionElement hp}

variable {a : relativeRoots B.i} {g : rationalPoints G}
    {p : rationalPoints G × rationalPoints G}

/-- Each actual opposite-pair representative belongs to the generated subgroup. -/
theorem reflectionElement_mem_reflectionNormalizer
    (hg : g ∈ B.rootGroup a) (hg1 : g ≠ 1)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p) :
    B.reflectionElement hp ∈ B.reflectionNormalizer :=
  Subgroup.subset_closure ⟨a, g, hg, hg1, p, hp, rfl⟩

/-- The action of every actual opposite pair is an affine Weyl reflection.
The ordinary affine root may be twice the original point functional. -/
theorem normalizerAffineEquiv_reflectionElement_mem_affineWeylGroup
    (hg : g ∈ B.rootGroup a) (hg1 : g ≠ 1)
    (hp : RelativeRoot.IsOppositeFactorPair B.i (a : characterLattice B.S) g p) :
    B.apartment.normalizerAffineEquiv (B.reflectionElement hp) ∈
      AffineRootSystem.affineWeylGroup B.affineRoots := by
  have : Smooth G.X.hom := B.isConnectedReductive.smooth
  have hψ : B.reflectionFunctional a g ∈ B.apartment.extendedAffineRoots := by
    rw [← B.reflectionAffineRoots_eq]
    exact ⟨a, g, hg, hg1, rfl⟩
  have hv := B.isCoroot_reflectionCoroot_without_apartment_axioms hg hg1 hp
  rw [B.normalizerAffineEquiv_reflectionElement hg hg1 hp]
  rcases B.apartment.mem_or_two_smul_mem_affineRoots_of_oppositePairs
    B.isMaximalSplitTorus.isSplitSubtorus.1 B.hasOppositeFactorPairs hψ with hm | hm
  · exact AffineRootSystem.affineReflection_mem_affineWeylGroup hm hv
  · have hv2 := hv.smul (by norm_num : (2 : ℝ) ≠ 0)
    rw [← AffineRootSystem.affineReflection_smul _ hv.1
      (by norm_num : (2 : ℝ) ≠ 0) hv2.1]
    exact AffineRootSystem.affineReflection_mem_affineWeylGroup hm hv2

/-- The image of all actual reflection products is contained in the affine Weyl group. -/
theorem reflectionNormalizer_map_le_affineWeylGroup :
    B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv ≤
      AffineRootSystem.affineWeylGroup B.affineRoots := by
  rw [Subgroup.map_le_iff_le_comap]
  refine (Subgroup.closure_le _).2 ?_
  rintro n ⟨a, g, hg, hg1, p, hp, rfl⟩
  exact B.normalizerAffineEquiv_reflectionElement_mem_affineWeylGroup hg hg1 hp

/-- Every affine Weyl generator is realized by an actual opposite-pair representative. -/
theorem affineWeylGroup_le_reflectionNormalizer_map :
    AffineRootSystem.affineWeylGroup B.affineRoots ≤
      B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv := by
  refine (Subgroup.closure_le _).2 ?_
  rintro e ⟨ψ, hψ, w, hw, rfl⟩
  have hψ' := B.apartment.affineRoots_subset_extendedAffineRoots hψ
  rw [← B.reflectionAffineRoots_eq] at hψ'
  obtain ⟨a, g, hg, hg1, rfl⟩ := hψ'
  obtain ⟨p, hp⟩ := B.hasOppositeFactorPairs a a.property g hg hg1
  refine ⟨B.reflectionElement hp,
    B.reflectionElement_mem_reflectionNormalizer hg hg1 hp, ?_⟩
  have heq := B.reflectionCoroot_eq_of_isCoroot hg hg1 hp hw
  simpa only [heq] using B.normalizerAffineEquiv_reflectionElement hg hg1 hp

/-- The actual reflection-generated normalizer has precisely the affine Weyl image,
over an arbitrary field with supplied integer-valued building data. -/
theorem reflectionNormalizer_map_eq_affineWeylGroup :
    B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv =
      AffineRootSystem.affineWeylGroup B.affineRoots :=
  le_antisymm B.reflectionNormalizer_map_le_affineWeylGroup
    B.affineWeylGroup_le_reflectionNormalizer_map

/-- The actual apartment action of reflection products, with codomain restricted
to the affine Weyl group. -/
def reflectionWeylAction :
    B.reflectionNormalizer →* AffineRootSystem.affineWeylGroup B.affineRoots where
  toFun n := ⟨B.apartment.normalizerAffineEquiv n.val,
    B.reflectionNormalizer_map_le_affineWeylGroup ⟨n.val, n.property, rfl⟩⟩
  map_one' := Subtype.ext (map_one B.apartment.normalizerAffineEquiv)
  map_mul' n m := Subtype.ext (map_mul B.apartment.normalizerAffineEquiv n.val m.val)

@[simp]
theorem reflectionWeylAction_coe (n : B.reflectionNormalizer) :
    (B.reflectionWeylAction n : B.Apartment ≃ᵃ[ℝ] B.Apartment) =
      B.apartment.normalizerAffineEquiv n.val :=
  rfl

/-- Every affine Weyl element is the action of an actual reflection product. -/
theorem reflectionWeylAction_surjective :
    Function.Surjective B.reflectionWeylAction := by
  intro w
  have hw : w.val ∈ B.reflectionNormalizer.map B.apartment.normalizerAffineEquiv := by
    rw [B.reflectionNormalizer_map_eq_affineWeylGroup]
    exact w.property
  obtain ⟨n, hn, heq⟩ := hw
  exact ⟨⟨n, hn⟩, Subtype.ext heq⟩

end Langlands.Geometry.Building.IntegerValuationBuildingData
