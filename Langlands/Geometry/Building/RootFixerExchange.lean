import Langlands.Geometry.Building.RootGroupFamilyExchange
import Langlands.Geometry.Building.PointSharpExchange
import Langlands.GroupScheme.Rational.RootRankOneFactorizationProof

/-!
# The sharp fixer of a finite set of apartment points

For building data `B` satisfying the apartment axioms with opposite factor pairs, a finite
non-empty set `Ω` of apartment points and a generic cocharacter `mu`,
`G(F)^♯_Ω ⊆ X_Ω(Φ_{-mu}) X_Ω(Φ_mu) H_Ω`, where `X_Ω(P)` is the subgroup generated by the root
fixers `U_{b,Ω,0}` for `b ∈ P` and `H_Ω` is the subgroup of elements of `N(F) ∩ G(F)^♯_Ω` that
fix every point of `Ω`. This is the range part of Kaletha–Prasad Proposition 7.3.12(1) for the
concave function of `Ω` with `H_Ω` in place of `N′`.

The family `b ↦ U_{b,Ω,0}` satisfies the commutator relations: with a base point `x₀` and
`Ω` finite, `U_{b,Ω,0} = U_{b,x₀,r_b}` for the largest of the depths `-b(y - x₀)`, `y ∈ Ω`, and
these depths are subadditive. The rank-one exchange `U_{-a,Ω,0} U_{a,Ω,0} ⊆ U_{a,Ω,0}
U_{-a,Ω,0} H_Ω` follows the point case of `PointSharpExchange`, with all valuations at a base
point of `Ω`. The passage to the whole sharp fixer is `RootGroupFamily.iSup_subset_mul_of_exchange`.
`FiniteSharpFixerExchangeStatement` states the result with opposite factor pairs discharged by
`rootRankOneFactorization`; `finiteSharpFixerExchange` proves it.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

namespace KPApartmentData

variable {k : Type u} [Field k] {S : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))} {i : S.toGrp ⟶ G}
  [Mono i.hom.hom.left] [IsAffineHom G.X.hom] {ω : kˣ → ℝ}

section Translation

variable {D : KPApartmentData i ω}

/-- `U_{a,x+w,r} = U_{a,x,r-a(w)}` for every character `a`. -/
theorem filtration_mk_vadd (w : V S) (x : D.Apartment) (a : characterLattice S) (r : ℝ) :
    D.filtration ((Submodule.Quotient.mk w : TranslationSpace i) +ᵥ x) a r =
      D.filtration x a (r - eval S a w) :=
  SetLike.ext' (rootFiltration_vadd' x.val w a r)

/-- `x_{a}` at `x + w` is `x_a` at `x` shifted by `a(w)`. -/
theorem val_mk_vadd_apply (w : V S) (x : D.Apartment) (a : characterLattice S)
    (u : rationalPoints G) :
    ((Submodule.Quotient.mk w : TranslationSpace i) +ᵥ x).val a u =
      x.val a u + ((eval S a w : ℝ) : WithTop ℝ) := by
  rw [val_mk_vadd]
  rfl

theorem exists_mk_vadd_eq (x y : D.Apartment) :
    ∃ w : V S, y = (Submodule.Quotient.mk w : TranslationSpace i) +ᵥ x := by
  obtain ⟨w, hw⟩ := Submodule.Quotient.mk_surjective _ (y -ᵥ x)
  exact ⟨w, by rw [hw, vsub_vadd]⟩

/-- If `u′ ∈ U_a(k)` is at least as deep as `u` at one point, then `u′ ∈ U_{a,y,r}` whenever
`u ∈ U_{a,y,r}`. -/
theorem mem_filtration_of_val_le {x y : D.Apartment} {a : characterLattice S}
    {u u' : rationalPoints G} {r : ℝ} (hu : u ∈ D.filtration y a r)
    (hu' : u' ∈ rootGroupPoints i a) (h : x.val a u ≤ x.val a u') :
    u' ∈ D.filtration y a r := by
  obtain ⟨w, rfl⟩ := exists_mk_vadd_eq x y
  rw [filtration_mk_vadd] at hu ⊢
  exact ⟨hu', hu.2.trans h⟩

end Translation

variable (D : KPApartmentData i ω)

/-- `H_Ω`: the elements of `N(k) ∩ G(k)^♯_Ω` that fix every point of `Ω`. -/
def sharpNormalizerFixer (Ω : Set D.Apartment) : Subgroup (rationalPoints G) :=
  D.sharpFixer Ω ⊓
    (⨅ x ∈ Ω, MulAction.stabilizer (normalizerPoints i) x).map (normalizerPoints i).subtype

variable {D}

theorem mem_sharpNormalizerFixer {Ω : Set D.Apartment} {g : rationalPoints G} :
    g ∈ D.sharpNormalizerFixer Ω ↔
      g ∈ D.sharpFixer Ω ∧
        ∃ hg : g ∈ normalizerPoints i, ∀ x ∈ Ω, (⟨g, hg⟩ : normalizerPoints i) • x = x := by
  constructor
  · rintro ⟨hS, ⟨n, hn, rfl⟩⟩
    refine ⟨hS, n.2, fun x hx => ?_⟩
    have hn' := Subgroup.mem_iInf.1 hn x
    exact Subgroup.mem_iInf.1 hn' hx
  · rintro ⟨hS, hg, hx⟩
    refine ⟨hS, ⟨⟨g, hg⟩, ?_, rfl⟩⟩
    exact Subgroup.mem_iInf.2 fun x => Subgroup.mem_iInf.2 fun h => hx x h

theorem sharpNormalizerFixer_le_sharpFixer (Ω : Set D.Apartment) :
    D.sharpNormalizerFixer Ω ≤ D.sharpFixer Ω :=
  inf_le_left

/-- The root fixers of a finite non-empty set satisfy the commutator relations (V 3). -/
theorem rootFixer_hasCommutatorRelations {Ω : Set D.Apartment} (hΩ : Ω.Finite)
    (hne : Ω.Nonempty) :
    RootGroupFamily.HasCommutatorRelations i (fun b => D.rootFixer b Ω) := by
  intro c b hc hb hnon
  obtain ⟨x₀, hx₀⟩ := hne
  choose w hw using fun y : D.Apartment => exists_mk_vadd_eq x₀ y
  obtain ⟨yc, hyc, hminc⟩ := Set.exists_min_image Ω (fun y => eval S c (w y)) hΩ ⟨x₀, hx₀⟩
  obtain ⟨yb, hyb, hminb⟩ := Set.exists_min_image Ω (fun y => eval S b (w y)) hΩ ⟨x₀, hx₀⟩
  have hc' : D.rootFixer c Ω ≤ D.filtration x₀ c (-eval S c (w yc)) := by
    intro u hu
    have h := (D.mem_rootFixer.1 hu).2 yc hyc
    rwa [hw yc, filtration_mk_vadd, zero_sub] at h
  have hb' : D.rootFixer b Ω ≤ D.filtration x₀ b (-eval S b (w yb)) := by
    intro u hu
    have h := (D.mem_rootFixer.1 hu).2 yb hyb
    rwa [hw yb, filtration_mk_vadd, zero_sub] at h
  refine (Subgroup.commutator_mono hc' hb').trans
    ((D.filtration_commutator_le x₀ hc hb hnon _ _).trans ?_)
  refine iSup_le fun p => iSup_le fun q => iSup_le fun hp => iSup_le fun hq =>
    iSup_le fun he => ?_
  refine le_iSup_of_le p (le_iSup_of_le q (le_iSup_of_le hp (le_iSup_of_le hq
    (le_iSup_of_le he ?_))))
  intro u hu
  refine D.mem_rootFixer.2 ⟨D.filtration_le_rootGroupPoints _ _ _ hu, fun y hy => ?_⟩
  rw [hw y, filtration_mk_vadd, zero_sub]
  refine D.filtration_antitone x₀ _ ?_ hu
  rw [eval_add_char, eval_nsmul_char, eval_nsmul_char]
  have h1 := hminc y hy
  have h2 := hminb y hy
  have hp' : (0 : ℝ) ≤ p := Nat.cast_nonneg p
  have hq' : (0 : ℝ) ≤ q := Nat.cast_nonneg q
  nlinarith [mul_nonneg hp' (sub_nonneg.2 h1), mul_nonneg hq' (sub_nonneg.2 h2)]

end KPApartmentData

namespace ValuationBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (B : ValuationBuildingData G)

open KPApartmentData

/-- **Rank-one exchange over a set.** Under opposite factor pairs, for every non-empty set `Ω`
of apartment points and every relative root `a`,
`U_{-a,Ω,0} U_{a,Ω,0} ⊆ U_{a,Ω,0} U_{-a,Ω,0} H_Ω`. -/
theorem rootFixer_neg_mul_rootFixer_subset_sharpNormalizerFixer
    (hrank : RelativeRoot.HasRankOneFactorization B.i)
    {Ω : Set B.Apartment} (hne : Ω.Nonempty) {a : characterLattice B.S}
    (ha : a ∈ relativeRoots B.i) :
    (B.apartment.rootFixer (-a) Ω : Set (rationalPoints G)) * B.apartment.rootFixer a Ω ⊆
      (B.apartment.rootFixer a Ω : Set (rationalPoints G)) * B.apartment.rootFixer (-a) Ω *
        B.apartment.sharpNormalizerFixer Ω := by
  have hT : IsSplitTorus B.S.toGrp := B.isMaximalSplitTorus.1.1
  obtain ⟨x₀, hx₀⟩ := hne
  have h := x₀.isValuation
  have ha' : -a ∈ relativeRoots B.i := neg_mem_relativeRoots_of_rankOne hT hrank x₀ ha
  rintro _ ⟨v, hv, v', hv', rfl⟩
  beta_reduce
  obtain ⟨hvU, hvΩ⟩ := B.apartment.mem_rootFixer.1 hv
  obtain ⟨hv'U, hv'Ω⟩ := B.apartment.mem_rootFixer.1 hv'
  by_cases hv1 : v = 1
  · subst hv1
    rw [show (1 : rationalPoints G) * v' = v' * 1 * 1 by group]
    exact Set.mul_mem_mul (Set.mul_mem_mul hv' (one_mem _)) (one_mem _)
  by_cases hv'1 : v' = 1
  · subst hv'1
    rw [show v * (1 : rationalPoints G) = 1 * v * 1 by group]
    exact Set.mul_mem_mul (Set.mul_mem_mul (one_mem _) hv) (one_mem _)
  obtain ⟨t, ht⟩ := exists_val_eq_coe x₀ ha' hvU hv1
  obtain ⟨t', ht'⟩ := exists_val_eq_coe x₀ ha hv'U hv'1
  have ht0 : 0 ≤ t := by
    have := (hvΩ x₀ hx₀).2
    rw [ht] at this
    exact WithTop.coe_le_coe.1 this
  have ht'0 : 0 ≤ t' := by
    have := (hv'Ω x₀ hx₀).2
    rw [ht'] at this
    exact WithTop.coe_le_coe.1 this
  have haR : B.apartment.rootFixer a Ω ≤ B.apartment.sharpFixer Ω :=
    B.apartment.rootFixer_le_sharpFixer ⟨a, ha⟩ Ω
  have ha'R : B.apartment.rootFixer (-a) Ω ≤ B.apartment.sharpFixer Ω :=
    B.apartment.rootFixer_le_sharpFixer ⟨-a, ha'⟩ Ω
  rcases (add_nonneg ht0 ht'0).lt_or_eq with hpos | hzero
  · -- `x_{-a}(v) + x_a(v′) > 0` at `x₀`: the factorization with a central factor
    have ha'' : -(-a) ∈ relativeRoots B.i := by rwa [neg_neg]
    have hv'a : v' ∈ rootGroupPoints B.i (-(-a)) := by rw [neg_neg]; exact hv'U
    have ht'a : x₀.val (-(-a)) v' = t' := by rw [neg_neg]; exact ht'
    obtain ⟨x', hx', z, hz, y, hy, heq, hx't, hyt, hzN, hzx⟩ :=
      B.exists_rankOne_factorization_fixing hrank x₀ ha' ha'' hvU hv1 hv'a hv'1 ht ht'a hpos
    rw [neg_neg] at hx' hx't
    have hzW : weylAction B.i ⟨z, hzN⟩ = 1 := (hT.weylAction_eq_one_iff B.i ⟨z, hzN⟩).2 hz
    have hx'F : x' ∈ B.apartment.rootFixer a Ω :=
      B.apartment.mem_rootFixer.2 ⟨hx', fun y₀ hy₀ =>
        mem_filtration_of_val_le (hv'Ω y₀ hy₀) hx' (by rw [ht']; exact hx't)⟩
    have hyF : ∀ y₀ ∈ Ω, y ∈ B.filtration y₀ (-a) 0 := fun y₀ hy₀ =>
      mem_filtration_of_val_le (hvΩ y₀ hy₀) hy (by rw [ht]; exact hyt)
    have hzfix : ∀ y₀ ∈ Ω, (⟨z, hzN⟩ : normalizerPoints B.i) • y₀ = y₀ := fun y₀ _ =>
      KPApartmentData.smul_eq_self_of_mem_centralizerPoints (D := B.apartment)
        (n := ⟨z, hzN⟩) (x := y₀) (y := x₀) hz hzx
    have hzyF : ∀ y₀ ∈ Ω, z * y * z⁻¹ ∈ B.filtration y₀ (-a) 0 := by
      intro y₀ hy₀
      have := B.apartment.conj_mem_filtration ⟨z, hzN⟩ (hyF y₀ hy₀)
      rw [hzfix y₀ hy₀, hzW] at this
      exact this
    have hzy : z * y * z⁻¹ ∈ B.apartment.rootFixer (-a) Ω :=
      B.apartment.mem_rootFixer.2 ⟨(hzyF x₀ hx₀).1, hzyF⟩
    have hyR : y ∈ B.apartment.rootFixer (-a) Ω := B.apartment.mem_rootFixer.2 ⟨hy, hyF⟩
    have hzS : z ∈ B.apartment.sharpFixer Ω := by
      have hz' : z = x'⁻¹ * (v * v') * y⁻¹ := by rw [heq]; group
      rw [hz']
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ (haR hx'F))
        (Subgroup.mul_mem _ (ha'R hv) (haR hv'))) (Subgroup.inv_mem _ (ha'R hyR))
    rw [heq, show x' * z * y = x' * (z * y * z⁻¹) * z by group]
    exact Set.mul_mem_mul (Set.mul_mem_mul hx'F hzy)
      (mem_sharpNormalizerFixer.2 ⟨hzS, hzN, hzfix⟩)
  · -- `x_{-a}(v) = 0 = x_a(v′)` at `x₀`: `n = m(v)` fixes every point of `Ω`
    have ht00 : t = 0 := by linarith
    have ht'00 : t' = 0 := by linarith
    subst ht00 ht'00
    obtain ⟨q, hq⟩ := ((hrank (-a) ha' v hvU hv1).1).exists
    have hq1 : q.1 ∈ rootGroupPoints B.i (-(-a)) := hq.1
    have hq2 : q.2 ∈ rootGroupPoints B.i (-(-a)) := hq.2.1
    rw [neg_neg] at hq1 hq2
    have h5 := h.opposite (-a) ha' v hvU hv1 q.1 hq.1 q.2 hq.2.1 hq.2.2
    rw [ht, neg_neg] at h5
    have hq1t := withTop_eq_neg_of_add_eq_zero h5
    have h5' := h.opposite_snd ha' hvU hv1 hq.1 hq.2.1 hq.2.2
    rw [ht, neg_neg] at h5'
    have hq2t := withTop_eq_neg_of_add_eq_zero h5'
    have hq1F : q.1 ∈ B.apartment.rootFixer a Ω :=
      B.apartment.mem_rootFixer.2 ⟨hq1, fun y₀ hy₀ =>
        mem_filtration_of_val_le (hv'Ω y₀ hy₀) hq1 (by rw [ht', hq1t]; simp)⟩
    have hq2F : q.2 ∈ B.apartment.rootFixer a Ω :=
      B.apartment.mem_rootFixer.2 ⟨hq2, fun y₀ hy₀ =>
        mem_filtration_of_val_le (hv'Ω y₀ hy₀) hq2 (by rw [ht', hq2t]; simp)⟩
    set n : normalizerPoints B.i := ⟨q.1 * v * q.2, hq.2.2⟩ with hn
    have hval : ∀ y₀ ∈ Ω, y₀.val (-a) v = 0 := by
      intro y₀ hy₀
      obtain ⟨w, rfl⟩ := exists_mk_vadd_eq x₀ y₀
      have e1 := (hvΩ _ hy₀).2
      have e2 := (hv'Ω _ hy₀).2
      rw [val_mk_vadd_apply, ht, ← WithTop.coe_add, WithTop.coe_le_coe] at e1
      rw [val_mk_vadd_apply, ht', ← WithTop.coe_add, WithTop.coe_le_coe] at e2
      rw [eval_neg_char] at e1
      rw [val_mk_vadd_apply, ht, ← WithTop.coe_add, eval_neg_char]
      have he : eval B.S a w = 0 := by linarith
      rw [he, neg_zero, add_zero]
      rfl
    have hnx : ∀ y₀ ∈ Ω, n • y₀ = y₀ := by
      intro y₀ hy₀
      refine RootReflectionProof.hasRootReflections B ⟨-a, ha'⟩ v hvU hv1 q hq y₀ ?_
      change y₀.val (-a) v = 0
      exact hval y₀ hy₀
    have hnflip : weylAction B.i n a = -a := by
      have hflip := hq.weylAction_eq_neg B.i hT (neg_ne_zero.2 ha.1) hvU hv1
      rw [map_neg] at hflip
      exact neg_inj.1 hflip
    have hnS : (n : rationalPoints G) ∈ B.apartment.sharpFixer Ω :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ (haR hq1F) (ha'R hv)) (haR hq2F)
    have hconjF : ∀ y₀ ∈ Ω, (n : rationalPoints G) * (q.2⁻¹ * v') *
        (n : rationalPoints G)⁻¹ ∈ B.filtration y₀ (-a) 0 := by
      intro y₀ hy₀
      have := B.apartment.conj_mem_filtration n
        (Subgroup.mul_mem _ (Subgroup.inv_mem _
          ((B.apartment.mem_rootFixer.1 hq2F).2 y₀ hy₀)) (hv'Ω y₀ hy₀))
      rw [hnx y₀ hy₀, hnflip] at this
      exact this
    have hconj : (n : rationalPoints G) * (q.2⁻¹ * v') * (n : rationalPoints G)⁻¹ ∈
        B.apartment.rootFixer (-a) Ω :=
      B.apartment.mem_rootFixer.2 ⟨(hconjF x₀ hx₀).1, hconjF⟩
    have heq : v * v' = q.1⁻¹ *
        ((n : rationalPoints G) * (q.2⁻¹ * v') * (n : rationalPoints G)⁻¹) *
          (n : rationalPoints G) := by
      rw [hn]
      group
    rw [heq]
    exact Set.mul_mem_mul (Set.mul_mem_mul (Subgroup.inv_mem _ hq1F) hconj)
      (mem_sharpNormalizerFixer.2 ⟨hnS, n.2, hnx⟩)

/-- **The sharp fixer of a finite set.** Under the apartment axioms and opposite factor pairs,
for every finite non-empty set `Ω` of apartment points and every generic cocharacter `mu`,
`G(F)^♯_Ω ⊆ X_Ω(Φ_{-mu}) X_Ω(Φ_mu) H_Ω`, where `X_Ω(P) = ⨆_{b ∈ P} U_{b,Ω,0}` and `H_Ω` is the
subgroup of elements of `N(F) ∩ G(F)^♯_Ω` fixing every point of `Ω`. -/
theorem sharpFixer_subset_mul_sharpNormalizerFixer
    (hB : B.apartment.SatisfiesApartmentAxioms B.centralizer)
    (hrank : RelativeRoot.HasRankOneFactorization B.i)
    {Ω : Set B.Apartment} (hΩ : Ω.Finite) (hne : Ω.Nonempty)
    (mu : cocharacterLattice B.S) (hmu : IsGenericCocharacter B.i mu) :
    (B.apartment.sharpFixer Ω : Set (rationalPoints G)) ⊆
      ((⨆ b : positiveRelativeRoots B.i (-mu), B.apartment.rootFixer b Ω :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        ((⨆ b : positiveRelativeRoots B.i mu, B.apartment.rootFixer b Ω :
          Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
        (B.apartment.sharpNormalizerFixer Ω : Set (rationalPoints G)) := by
  have hT : IsSplitTorus B.S.toGrp := B.isMaximalSplitTorus.1.1
  have : Smooth G.X.hom := B.isConnectedReductive.smooth
  obtain ⟨x₀, hx₀⟩ := hne
  exact RootGroupFamily.iSup_subset_mul_of_exchange (U := fun b => B.apartment.rootFixer b Ω)
    (B.apartment.rootFixer_hasCommutatorRelations hΩ ⟨x₀, hx₀⟩)
    (IsSplitTorus.finite_relativeRoots (i := B.i) hT)
    (fun _ _ hc hd _ ht h => B.apartment.eq_or_double_of_eval_eq_smul hT
      hB.isAffineRootSystem_extendedAffineRoots hB.derivativeRoots_extendedAffineRoots
      hc hd ht h)
    (fun c hc => neg_mem_relativeRoots_of_rankOne hT hrank x₀ hc)
    (fun c hc h2c => B.apartment.rootFixer_double_le Ω hc h2c)
    (fun c hc => B.rootFixer_neg_mul_rootFixer_subset_sharpNormalizerFixer hrank ⟨x₀, hx₀⟩ hc)
    mu hmu

end ValuationBuildingData

/-- **The sharp fixer of a finite set (KP Proposition 7.3.12(1), range part).** For every
nonarchimedean local field `F`, every affine group scheme `G` over `F` and all building data
`B : ValuationBuildingData G` satisfying the apartment axioms: for every finite non-empty set `Ω`
of apartment points and every generic cocharacter `mu`,
`G(F)^♯_Ω ⊆ X_Ω(Φ_{-mu}) X_Ω(Φ_mu) H_Ω`, where `X_Ω(P) = ⨆_{b ∈ P} U_{b,Ω,0}` and `H_Ω` is the
subgroup of elements of `N(F) ∩ G(F)^♯_Ω` fixing every point of `Ω`. -/
def FiniteSharpFixerExchangeStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (B : ValuationBuildingData G),
    B.SatisfiesApartmentAxioms →
      ∀ (Ω : Set B.Apartment), Ω.Finite → Ω.Nonempty →
        ∀ (mu : cocharacterLattice B.S), IsGenericCocharacter B.i mu →
          (B.apartment.sharpFixer Ω : Set (rationalPoints G)) ⊆
            ((⨆ b : positiveRelativeRoots B.i (-mu), B.apartment.rootFixer b Ω :
                Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
              ((⨆ b : positiveRelativeRoots B.i mu, B.apartment.rootFixer b Ω :
                  Subgroup (rationalPoints G)) : Set (rationalPoints G)) *
              (B.apartment.sharpNormalizerFixer Ω : Set (rationalPoints G))

/-- Opposite factor pairs hold for every maximal split torus of a connected reductive group
(`rootRankOneFactorization`), so `sharpFixer_subset_mul_sharpNormalizerFixer` applies. -/
theorem finiteSharpFixerExchange : FiniteSharpFixerExchangeStatement.{u} := by
  intro F _ _ _ _ G _ B hB Ω hΩ hne mu hmu
  exact B.sharpFixer_subset_mul_sharpNormalizerFixer hB
    (rootRankOneFactorization F G B.isConnectedReductive B.S B.i B.isMaximalSplitTorus)
    hΩ hne mu hmu

end Langlands.Geometry.Building
