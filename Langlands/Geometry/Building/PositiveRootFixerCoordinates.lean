import Langlands.Geometry.Building.ChamberPositiveCollection
import Langlands.Geometry.Building.ChamberParahoricIntersection
import Langlands.Geometry.Building.ChamberIwahoriProof
import Langlands.Geometry.Building.ParahoricBuildingAxioms

/-!
# Positive root fixers of a set from ordered root coordinates

For a cocharacter `ν` and a non-empty `Ω ⊆ A`, an element lying, at every point `x ∈ Ω`, in
the subgroup generated by the depth-zero groups `U_{b,x,0}` of the `ν`-positive roots `b` lies
in the subgroup generated by the root fixers `U_{b,Ω,0}` of the `ν`-positive roots:

`⋂_{x ∈ Ω} ⟨U_{b,x,0} : b > 0⟩ = ⟨U_{b,Ω,0} : b > 0⟩`.

Write the element as an ordered product over the indivisible positive roots at one point; the
coordinates are unique, so each coordinate lies in `U_{b,x,0}` for every `x ∈ Ω`.

* `KPApartmentData.iInf_iSup_chamberRootGroup_le_iSup_rootFixer`: the inclusion `⊆`, given
  ordered root injectivity and the affine root system of extended affine roots.
* `KPApartmentData.iSup_rootFixer_le_iInf_iSup_chamberRootGroup`: the trivial inclusion `⊇`.
* `ParahoricBuildingData.iInf_iSup_chamberRootGroup_eq_iSup_rootFixer`: the equality for
  supplied data satisfying the apartment axioms.
* `PositiveRootFixerCoordinatesStatement` and its proof `positiveRootFixerCoordinates`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme

namespace Langlands.Geometry.Building

namespace KPApartmentData

variable {k : Type u} [Field k]
    {S : CommGroupScheme (Spec (CommRingCat.of k))}
    {G : GroupScheme (Spec (CommRingCat.of k))}
    {i : S.toGrp ⟶ G} [Mono i.hom.hom.left] [IsAffineHom G.X.hom]
    {ω : kˣ → ℝ} (D : KPApartmentData i ω)

/-- `U_{b,Ω,0} ⊆ U_{b,x,0}` for `x ∈ Ω`, so the positive root fixers of `Ω` lie in the positive
depth-zero root groups at every point of `Ω`. -/
theorem iSup_rootFixer_le_iInf_iSup_chamberRootGroup (ν : cocharacterLattice S)
    (Ω : Set D.Apartment) :
    (⨆ b : positiveRelativeRoots i ν, D.rootFixer b Ω) ≤
      ⨅ x ∈ Ω, ⨆ b : positiveRelativeRoots i ν, D.chamberRootGroup x false b :=
  le_iInf₂ fun x hx => iSup_mono fun _ _ hu => (D.mem_rootFixer.1 hu).2 x hx

/-- An element in the positive depth-zero root groups at every point of a non-empty `Ω` lies in
the subgroup generated by the positive root fixers `U_{b,Ω,0}`. Its ordered coordinates over
the indivisible positive roots at one point of `Ω` are those at every other point. -/
theorem iInf_iSup_chamberRootGroup_le_iSup_rootFixer
    (hinj : RelativeRoot.OrderedRootPointInjectivity i)
    (hsys : AffineRootSystem.IsAffineRootSystemWithRankZero D.extendedAffineRoots)
    (hderiv : AffineRootSystem.derivativeRoots D.extendedAffineRoots =
      Set.range (rootForm i))
    (hfin : (relativeRoots i).Finite) (ν : cocharacterLattice S)
    {Ω : Set D.Apartment} (hΩ : Ω.Nonempty) :
    (⨅ x ∈ Ω, ⨆ b : positiveRelativeRoots i ν, D.chamberRootGroup x false b) ≤
      ⨆ b : positiveRelativeRoots i ν, D.rootFixer b Ω := by
  classical
  intro g hg
  simp only [Subgroup.mem_iInf] at hg
  have hfinite : (RelativeRoot.indivisiblePositiveRoots i ν).Finite :=
    hfin.subset (fun _ ha => ha.1.1)
  obtain ⟨n, a, ha, hrange⟩ := hfinite.fin_param
  have hpos (j : Fin n) : a j ∈ positiveRelativeRoots i ν := by
    have h : a j ∈ RelativeRoot.indivisiblePositiveRoots i ν := hrange ▸ Set.mem_range_self j
    exact ⟨h.1.1, h.2⟩
  have hrng (x : D.Apartment) (hx : x ∈ Ω) : g ∈ Set.range
      (RelativeRoot.CentralExtension.orderedProduct
        (fun j => (D.chamberRootGroup x false (a j)).subtype)) := by
    rw [D.range_orderedIndivisiblePositiveRootGroupProduct_eq_iSup hsys hderiv x false ν a
      hrange]
    exact hg x hx
  obtain ⟨y, hy⟩ := hΩ
  obtain ⟨t, ht⟩ := hrng y hy
  let t' : ∀ j, rootGroupPoints i (a j) := fun j =>
    ⟨t j, D.filtration_le_rootGroupPoints y (a j) 0 (t j).property⟩
  have hmem (j : Fin n) : (t j : rationalPoints G) ∈ D.rootFixer (a j) Ω := by
    refine D.mem_rootFixer.2 ⟨(t' j).property, fun x hx => ?_⟩
    obtain ⟨s, hs⟩ := hrng x hx
    let s' : ∀ j, rootGroupPoints i (a j) := fun j =>
      ⟨s j, D.filtration_le_rootGroupPoints x (a j) 0 (s j).property⟩
    have hcoords : t' = s' := hinj ν n a ha hrange (ht.trans hs.symm)
    have heq : (t j : rationalPoints G) = (s j : rationalPoints G) :=
      congrArg (fun z => (z j : rationalPoints G)) hcoords
    rw [heq]
    exact (s j).property
  rw [← ht]
  change (List.ofFn fun j => (t j : rationalPoints G)).prod ∈ _
  refine list_prod_mem fun z hz => ?_
  obtain ⟨j, rfl⟩ := List.mem_ofFn.1 hz
  exact Subgroup.mem_iSup_of_mem (⟨a j, hpos j⟩ : positiveRelativeRoots i ν) (hmem j)

end KPApartmentData

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- For supplied data satisfying the apartment axioms, a cocharacter `ν` and a non-empty `Ω`,
`⋂_{x ∈ Ω} ⟨U_{b,x,0} : b ∈ Φ, ⟨b, ν⟩ > 0⟩ = ⟨U_{b,Ω,0} : b ∈ Φ, ⟨b, ν⟩ > 0⟩`. -/
theorem iInf_iSup_chamberRootGroup_eq_iSup_rootFixer (hP : P.SatisfiesApartmentAxioms)
    (ν : cocharacterLattice P.S) {Ω : Set P.Apartment} (hΩ : Ω.Nonempty) :
    (⨅ x ∈ Ω, ⨆ b : positiveRelativeRoots P.i ν, P.apartment.chamberRootGroup x false b) =
      ⨆ b : positiveRelativeRoots P.i ν, P.apartment.rootFixer b Ω := by
  have : Smooth G.X.hom := P.isConnectedReductive.smooth
  have hS : IsSplitTorus P.S.toGrp := P.isMaximalSplitTorus.isSplitSubtorus.1
  exact le_antisymm
    (P.apartment.iInf_iSup_chamberRootGroup_le_iSup_rootFixer
      (RelativeRoot.orderedRootPointInjectivity_of_hasOppositeFactorPairs P.i hS
        P.hasOppositeFactorPairs)
      hP.isAffineRootSystem_extendedAffineRoots hP.derivativeRoots_extendedAffineRoots
      (hS.finite_relativeRoots P.i) ν hΩ)
    (P.apartment.iSup_rootFixer_le_iInf_iSup_chamberRootGroup ν Ω)

end ParahoricBuildingData

/-- For supplied Chapter 7 building data over a nonarchimedean local field satisfying the
apartment axioms, every cocharacter `ν` of `S` and every non-empty `Ω ⊆ A(S)`, the elements
lying, at every `x ∈ Ω`, in the subgroup generated by the `U_{b,x,0}` for the roots `b` with
`⟨b, ν⟩ > 0` form the subgroup generated by the root fixers `U_{b,Ω,0}` of those roots. -/
def PositiveRootFixerCoordinatesStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (G : GroupScheme (Spec (CommRingCat.of F))) [IsAffineHom G.X.hom]
    (P : ParahoricBuildingData G),
    P.SatisfiesApartmentAxioms → ∀ (ν : cocharacterLattice P.S) (Ω : Set P.Apartment),
      Ω.Nonempty →
        (⨅ x ∈ Ω, ⨆ b : positiveRelativeRoots P.i ν,
            P.apartment.chamberRootGroup x false b) =
          ⨆ b : positiveRelativeRoots P.i ν, P.apartment.rootFixer b Ω

/-- Proof of `PositiveRootFixerCoordinatesStatement`. -/
theorem positiveRootFixerCoordinates : PositiveRootFixerCoordinatesStatement.{u} :=
  fun _ _ _ _ _ _ _ P hP ν _ hΩ => P.iInf_iSup_chamberRootGroup_eq_iSup_rootFixer hP ν hΩ

end Langlands.Geometry.Building
