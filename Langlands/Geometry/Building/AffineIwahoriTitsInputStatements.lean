import Langlands.Geometry.Building.AffineIwahoriTitsAssembly
import Langlands.Geometry.Building.AffineIwahoriTitsStatement
import Langlands.Geometry.Building.AffineChamberTransitivity
import Langlands.Geometry.Building.AffineChamberWallComparisonProof
import Langlands.Geometry.Building.AffineReflectionGalleryGeometry
import Langlands.Geometry.Building.ApartmentRootCover
import Langlands.Geometry.Building.IwahoriWeylStatement

/-!
# The remaining inputs of the actual affine Iwahori–Tits system

Five statements, not proved here, about the actual data of `P : ParahoricBuildingData G`
under the apartment axioms. Each is one field of `AffineIwahoriTitsInputs` with the same
conclusion, quantified over all data, and each is a step in the proof of KP Theorem 7.5.1:

* `ChamberParahoricNormalizerStatement`: `P_C ∩ N(F) ⊆ Z(F)^0` (KP Lemma 7.5.2(1));
* `ChamberParahoricGenerationStatement`: `P_C` and `N(F) ∩ G(F)^0` generate `G(F)^0`;
* `ChamberSimpleFactorizationStatement`: `P_C ⊆ P_{r C} U_ψ` (KP (7.5.1));
* `RootGroupParahoricFiltrationStatement`: `U_a(F) ∩ P_x ⊆ U_{a,x,0}` (from KP 7.3.12);
* `ChamberConjugateIntersectionStatement`: `⋂_{n ∈ N(F) ∩ G(F)^0} P_{n C} ⊆ Z(F)^0`.

`AffineIwahoriTitsInputStatement` is their conjunction. The module proves the remaining
inputs: generation of `W(Ψ)` by the chamber-simple reflections (KP Proposition 1.3.22(1)),
from the published wall comparison and gallery geometry, and `P_Ω ⊆ G(F)^0`, from
`ApartmentRootCover`. Then `affineIwahoriTitsStatement_of_inputStatements` derives
`AffineIwahoriTitsStatement` from the five statements, `AffineRankOneTwoCellStatement` and
`IwahoriWeylExactSequenceStatement`.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped Pointwise CategoryTheory.MonObj
open Langlands.GroupScheme

namespace Langlands.Geometry.Building

/-! ### The statements -/

/-- KP Lemma 7.5.2(1), `I ∩ N = Z`: for the actual data under the apartment axioms and a
chamber `C`, every `n ∈ N(F)` lying in `P_C` lies in `Z(F)^0`. -/
def ChamberParahoricNormalizerStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (P : ParahoricBuildingData G),
    P.apartment.SatisfiesApartmentAxioms P.centralizer →
      ∀ C : Set P.Apartment, AffineRootSystem.IsChamber P.affineRoots C →
        ∀ n : normalizerPoints P.i, (n : rationalPoints G) ∈ P.parahoric C →
          n ∈ P.normalizerZero

/-- The generation step of KP Theorem 7.5.1, on `G(F)^0`: for the actual data under the
apartment axioms and a chamber `C`, `G(F)^0` lies in the subgroup generated by `P_C` and
`N(F) ∩ G(F)^0`. -/
def ChamberParahoricGenerationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (P : ParahoricBuildingData G),
    P.apartment.SatisfiesApartmentAxioms P.centralizer →
      ∀ C : Set P.Apartment, AffineRootSystem.IsChamber P.affineRoots C →
        P.zeroSubgroup ≤ P.parahoric C ⊔ (normalizerPoints P.i ⊓ P.zeroSubgroup)

/-- KP (7.5.1), `I ⊆ s I s U_ψ`: for the actual data under the apartment axioms, a chamber
`C`, a chamber-simple affine root `ψ` with derivative the root `a` and a coroot `v` of `ψ`
in `Ψ`, every `b ∈ P_C` is a product `b' u` with `b' ∈ P_{r C}` and `u ∈ U_ψ`, where `r` is
the reflection along `ψ = 0`. -/
def ChamberSimpleFactorizationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (P : ParahoricBuildingData G),
    P.apartment.SatisfiesApartmentAxioms P.centralizer →
      ∀ C : Set P.Apartment, AffineRootSystem.IsChamber P.affineRoots C →
        ∀ ψ ∈ AffineRootSystem.simpleAffineRoots P.affineRoots C,
          ∀ α : relativeRoots P.i, ψ.linear = rootForm P.i α →
            ∀ (v : TranslationSpace P.i) (hv : AffineRootSystem.IsCoroot P.affineRoots ψ v),
              ∀ b ∈ P.parahoric C,
                ∃ b' ∈ P.parahoric (AffineRootSystem.affineReflection ψ hv.1 '' C),
                  ∃ u ∈ P.apartment.affineRootGroup α ψ, b = b' * u

/-- The consequence `U_a(F) ∩ P_x ⊆ U_{a,x,0}` of KP Proposition 7.3.12, used in the proofs
of KP Theorem 7.5.1 and Proposition 7.4.13(1): for the actual data under the apartment
axioms, every relative root `a` and every point `x` of the apartment. -/
def RootGroupParahoricFiltrationStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (P : ParahoricBuildingData G),
    P.apartment.SatisfiesApartmentAxioms P.centralizer →
      ∀ (α : relativeRoots P.i) (x : P.Apartment),
        rootGroupPoints P.i α ⊓ P.parahoricAt x ≤ P.apartment.filtration x α 0

/-- The saturation step of KP Theorem 7.5.1, `⋂_{n ∈ N} n I n⁻¹ = Z`, on `G(F)^0`: for the
actual data under the apartment axioms and a chamber `C`, an element of `G(F)` lying in
`P_{n C}` for every `n ∈ N(F) ∩ G(F)^0` lies in `Z(F)^0`. -/
def ChamberConjugateIntersectionStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] (P : ParahoricBuildingData G),
    P.apartment.SatisfiesApartmentAxioms P.centralizer →
      ∀ C : Set P.Apartment, AffineRootSystem.IsChamber P.affineRoots C →
        ∀ g : rationalPoints G,
          (∀ n : normalizerPoints P.i, (n : rationalPoints G) ∈ P.zeroSubgroup →
            g ∈ P.parahoric (n • C)) →
            g ∈ P.centralizerZero.map (rationalPoints.map P.centralizer.j)

/-- All five statements of this module together. -/
def AffineIwahoriTitsInputStatement : Prop :=
  ChamberParahoricNormalizerStatement.{u} ∧ ChamberParahoricGenerationStatement.{u} ∧
    ChamberSimpleFactorizationStatement.{u} ∧ RootGroupParahoricFiltrationStatement.{u} ∧
      ChamberConjugateIntersectionStatement.{u}

/-! ### Assembly from the statements -/

namespace ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- KP Proposition 1.3.22(1) for the actual affine roots: the chamber-simple reflections of a
chamber generate `W(Ψ)`. -/
theorem closure_chamberSimpleReflections_affineRoots
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer) {C : Set P.Apartment}
    (hC : AffineRootSystem.IsChamber P.affineRoots C) :
    Subgroup.closure (AffineRootSystem.chamberSimpleReflections P.affineRoots C) = ⊤ := by
  have hΨ := hA.isAffineRootSystem_affineRoots
  obtain ⟨x, hx, rfl⟩ := hC
  exact AffineRootSystem.closure_chamberSimpleReflections_eq_top_of_wall_generation _ x
    (affineChamberWallComparison _ _ _ hΨ x hx)
    (affineReflectionGalleryGeometry _ _ _ hΨ.isLocallyFiniteReflectionArrangement x hx).1

/-- The five statements and the rank-one two-cell statement give the actual inputs for a
chamber `C`. -/
theorem affineIwahoriTitsInputs_of_statements
    (hnorm : ChamberParahoricNormalizerStatement.{u})
    (hgen : ChamberParahoricGenerationStatement.{u})
    (htwo : AffineRankOneTwoCellStatement.{u})
    (hfact : ChamberSimpleFactorizationStatement.{u})
    (hroot : RootGroupParahoricFiltrationStatement.{u})
    (hsat : ChamberConjugateIntersectionStatement.{u})
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer) {C : Set P.Apartment}
    (hC : AffineRootSystem.IsChamber P.affineRoots C) :
    P.AffineIwahoriTitsInputs C where
  parahoric_le_zeroSubgroup := P.parahoric_le_zeroSubgroup hA
  mem_normalizerZero_of_mem_parahoric := hnorm F G P hA C hC
  zeroSubgroup_le_sup := hgen F G P hA C hC
  closure_chamberSimpleReflections := P.closure_chamberSimpleReflections_affineRoots hA hC
  twoCell := htwo F G P hA
  simpleFactorization := hfact F G P hA C hC
  rootGroup_inf_parahoricAt_le := hroot F G P hA
  mem_centralizerZero_of_forall_mem_parahoric := hsat F G P hA C hC

/-- The actual affine Iwahori–Tits system for the chamber `C`, from the input statements,
the normality of `Z(F)^0` in `N(F)` and a comparison realizing the apartment action. -/
theorem affineIwahoriTits_of_statements [P.normalizerZero.Normal]
    (hnorm : ChamberParahoricNormalizerStatement.{u})
    (hgen : ChamberParahoricGenerationStatement.{u})
    (htwo : AffineRankOneTwoCellStatement.{u})
    (hfact : ChamberSimpleFactorizationStatement.{u})
    (hroot : RootGroupParahoricFiltrationStatement.{u})
    (hsat : ChamberConjugateIntersectionStatement.{u})
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer) {C : Set P.Apartment}
    (hC : AffineRootSystem.IsChamber P.affineRoots C)
    (hcmp : ∃ e : P.affinePart ≃* AffineRootSystem.affineWeylGroup P.affineRoots,
      P.IsAffineWeylComparison e) :
    P.AffineIwahoriTits C :=
  P.affineIwahoriTits_of_inputs hA hC hcmp
    (P.affineIwahoriTitsInputs_of_statements hnorm hgen htwo hfact hroot hsat hA hC)

end ParahoricBuildingData

/-- `AffineIwahoriTitsStatement` from the five input statements, KP Lemma 7.1.5(3)
(`AffineRankOneTwoCellStatement`) and KP Theorem 7.8.1(1)
(`IwahoriWeylExactSequenceStatement`), which supplies both normalities and the comparison. -/
theorem affineIwahoriTitsStatement_of_inputStatements
    (hex : IwahoriWeylExactSequenceStatement.{u})
    (hnorm : ChamberParahoricNormalizerStatement.{u})
    (hgen : ChamberParahoricGenerationStatement.{u})
    (htwo : AffineRankOneTwoCellStatement.{u})
    (hfact : ChamberSimpleFactorizationStatement.{u})
    (hroot : RootGroupParahoricFiltrationStatement.{u})
    (hsat : ChamberConjugateIntersectionStatement.{u}) :
    AffineIwahoriTitsStatement.{u} := by
  intro F _ _ _ _ G _ P hA C hC
  obtain ⟨hN, hG, ⟨e, he⟩, -⟩ := hex F G P hA
  exact ⟨hN, hG, P.affineIwahoriTits_of_statements hnorm hgen htwo hfact hroot hsat hA hC
    ⟨e, he⟩⟩

/-- `AffineIwahoriTitsStatement` from the bundled input statements, KP Lemma 7.1.5(3) and
KP Theorem 7.8.1(1). -/
theorem affineIwahoriTitsStatement_of_inputStatement
    (hex : IwahoriWeylExactSequenceStatement.{u}) (htwo : AffineRankOneTwoCellStatement.{u})
    (h : AffineIwahoriTitsInputStatement.{u}) : AffineIwahoriTitsStatement.{u} :=
  affineIwahoriTitsStatement_of_inputStatements hex h.1 h.2.1 htwo h.2.2.1 h.2.2.2.1 h.2.2.2.2

end Langlands.Geometry.Building
