import Langlands.Geometry.Building.KPBuilding
import Langlands.Geometry.Building.RootValueTorusRestriction
import Langlands.Geometry.Building.PositiveDepthCollection
import Langlands.GroupTheory.GeneratedCommutator

/-! # Restricted root functions under normalizer points through the Levi subgroup

Let `f : S → T` be a homomorphism of split tori and `i : T → G`, and put `j = f ≫ i`. Suppose
that `w ∈ N_i(k)` factors as `w = n h` with `n ∈ N_j(k)` and `h` a point centralizing `j` that
lies in the subgroup generated by the filtrations `U_{χ,φ,0}` of the roots `χ` of `T` with
`f ≫ χ = 0`. Then restricting `w • φ` from `T` to `S` gives `n` applied to the restriction
of `φ`.
-/

set_option backward.isDefEq.respectTransparency false

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace

namespace Langlands.Geometry.Building

variable {k : Type u} [Field k]
  {S T : CommGroupScheme (Spec (CommRingCat.of k))}
  {G : GroupScheme (Spec (CommRingCat.of k))}

section Characters

variable {i : T.toGrp ⟶ G} [Mono i.hom.hom.left]

/-- If `w = n h` with `w` normalizing `i`, `n` normalizing `j = f ≫ i` and `h` centralizing
`j`, then restriction along `f` intertwines the Weyl actions of `w` and `n`. -/
theorem torusHom_comp_weylAction_of_eq_mul {i' : S.toGrp ⟶ G} [Mono i'.hom.hom.left]
    (f : S ⟶ T) (hf : CommGroupScheme.groupHom f ≫ i = i') (n : normalizerPoints i')
    (w : normalizerPoints i) {h : rationalPoints G} (hh : h ∈ centralizerPoints i')
    (hw : (w : rationalPoints G) = n * h) (χ : characterLattice T) :
    f ≫ weylAction i w χ = weylAction i' n (f ≫ χ) := by
  subst hf
  have hσ := isNormalizingPoint_normalizingAut i w
  have hτ := isNormalizingPoint_normalizingAut (CommGroupScheme.groupHom f ≫ i) n
  have hh' := (mem_centralizerPoints (CommGroupScheme.groupHom f ≫ i)).1 hh
  rw [IsNormalizingPoint] at hσ hτ
  have key : CommGroupScheme.groupHom (f ≫ (normalizingAut i w).hom) ≫ i =
      CommGroupScheme.groupHom
        ((normalizingAut (CommGroupScheme.groupHom f ≫ i) n).hom ≫ f) ≫ i := by
    change (CommGroupScheme.groupHom f ≫ CommGroupScheme.groupHom (normalizingAut i w).hom) ≫
        i = (CommGroupScheme.groupHom (normalizingAut (CommGroupScheme.groupHom f ≫ i) n).hom ≫
          CommGroupScheme.groupHom f) ≫ i
    rw [Category.assoc, ← hσ, hw, innerIso_mul_hom, ← Category.assoc, ← Category.assoc, hh',
      hτ, Category.assoc]
  have key' : f ≫ (normalizingAut i w).hom =
      (normalizingAut (CommGroupScheme.groupHom f ≫ i) n).hom ≫ f := by
    have h' := congrArg (fun g : S.toGrp ⟶ G => g.hom.hom.left) key
    simp only [Grp.comp_hom_hom, Over.comp_left] at h'
    have h'' := (cancel_mono _).1 h'
    change Additive.ofMul (CommGroupScheme.groupHom (f ≫ (normalizingAut i w).hom)) =
      Additive.ofMul (CommGroupScheme.groupHom
        ((normalizingAut (CommGroupScheme.groupHom f ≫ i) n).hom ≫ f))
    congr 1
    apply Grp.hom_ext
    exact Over.OverMorphism.ext h''
  have key'' : (normalizingAut (CommGroupScheme.groupHom f ≫ i) n).inv ≫ f =
      f ≫ (normalizingAut i w).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← key', Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  rw [weylAction_apply, weylAction_apply, ← Category.assoc, ← Category.assoc, key'']

/-- The inverse form of `torusHom_comp_weylAction_of_eq_mul`. -/
theorem torusHom_comp_weylAction_inv_of_eq_mul {i' : S.toGrp ⟶ G} [Mono i'.hom.hom.left]
    (f : S ⟶ T) (hf : CommGroupScheme.groupHom f ≫ i = i') (n : normalizerPoints i')
    (w : normalizerPoints i) {h : rationalPoints G} (hh : h ∈ centralizerPoints i')
    (hw : (w : rationalPoints G) = n * h) (χ : characterLattice T) :
    f ≫ weylAction i w⁻¹ χ = weylAction i' n⁻¹ (f ≫ χ) := by
  have h := torusHom_comp_weylAction_of_eq_mul f hf n w hh hw (weylAction i w⁻¹ χ)
  rw [weylAction_apply_inv_apply] at h
  rw [h, weylAction_inv_apply_apply]

end Characters

variable {i : T.toGrp ⟶ G} [IsAffineHom G.X.hom] [Mono i.hom.hom.left]
  {φ : RootFunctionFamily T G}

/-- A nonzero character of a split torus is positive on some cocharacter. -/
private theorem exists_latticePairing_pos_of_ne_zero (hS : IsSplitTorus S.toGrp)
    {α : characterLattice S} (hα : α ≠ 0) :
    ∃ ν : cocharacterLattice S, 0 < latticePairing S α ν := by
  by_contra h
  simp only [not_exists, not_lt] at h
  apply hα
  apply hS.isPerfPair_latticePairing.separatingLeft α
  intro ν
  have h1 := h ν
  have h2 := h (-ν)
  rw [map_neg] at h2
  omega

/-- A character restricting to a positive multiple of a nonzero character is not on the
opposite ray of a character restricting to zero. -/
theorem torusRestriction_not_opposite (hS : IsSplitTorus S.toGrp) (f : S ⟶ T)
    {α : characterLattice S} (hα : α ≠ 0) {χ θ : characterLattice T} {m : ℕ} (hm : 0 < m)
    (hχ : f ≫ χ = m • α) (hθ : f ≫ θ = 0) :
    ∀ t : ℝ, 0 < t → ((1 : ℝ) ⊗ₜ[ℤ] χ : Vstar T) ≠ -(t • (1 : ℝ) ⊗ₜ[ℤ] θ) := by
  obtain ⟨ν, hν⟩ := exists_latticePairing_pos_of_ne_zero hS hα
  intro t _ heq
  have h := congrArg (fun c => pair T c ((1 : ℝ) ⊗ₜ[ℤ] (ν ≫ f))) heq
  simp only [map_neg, map_smul, LinearMap.neg_apply, LinearMap.smul_apply,
    pair_tmul_tmul, smul_eq_mul, one_mul] at h
  have hθ' : f ≫ θ = (0 : ℕ) • α := by rw [hθ, zero_smul]
  rw [latticePairing_comp_torusHom_of_restrict_eq_nsmul f α ν hχ,
    latticePairing_comp_torusHom_of_restrict_eq_nsmul f α ν hθ'] at h
  simp only [zero_smul, Int.cast_zero, mul_zero, neg_zero, nsmul_eq_mul, Int.cast_mul,
    Int.cast_natCast] at h
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hν' : (0 : ℝ) < (latticePairing S α ν : ℝ) := by exact_mod_cast hν
  have := mul_pos hm' hν'
  linarith

private abbrev RestrictionFibre (f : S ⟶ T) (α : characterLattice S) :=
  {x : characterLattice T × ℕ // x.1 ∈ relativeRoots i ∧ 0 < x.2 ∧ f ≫ x.1 = x.2 • α}

private theorem torusRestrictedRootDepthSubgroup_eq_iSup_fibre
    (hφ : IsRootDatumValuation i φ) (f : S ⟶ T) (α : characterLattice S) (r : ℝ) :
    torusRestrictedRootDepthSubgroup hφ f α r =
      ⨆ x : RestrictionFibre (i := i) f α, hφ.filtrationSubgroup x.val.1 (x.val.2 * r) := by
  apply le_antisymm
  · refine iSup_le fun χ => iSup_le fun hχ => iSup_le fun m =>
      iSup_le fun hm => iSup_le fun heq => ?_
    exact le_iSup (fun x : RestrictionFibre (i := i) f α =>
      hφ.filtrationSubgroup x.val.1 (x.val.2 * r)) ⟨⟨χ, m⟩, hχ, hm, heq⟩
  · refine iSup_le fun x => ?_
    exact le_iSup_of_le x.val.1 (le_iSup_of_le x.property.1
      (le_iSup_of_le x.val.2 (le_iSup_of_le x.property.2.1
        (le_iSup_of_le x.property.2.2 le_rfl))))

/-- By V 3, the depth-zero filtration of a root of `T` vanishing on `S` normalizes every
restricted depth subgroup `U_{α,r}` of a nonzero character `α` of `S`. -/
theorem filtrationSubgroup_le_normalizer_torusRestrictedRootDepthSubgroup
    (hS : IsSplitTorus S.toGrp) (hφ : IsRootDatumValuation i φ) (f : S ⟶ T)
    {α : characterLattice S} (hα : α ≠ 0) {θ : characterLattice T}
    (hθ : θ ∈ relativeRoots i) (hθ0 : f ≫ θ = 0) (r : ℝ) :
    hφ.filtrationSubgroup θ 0 ≤
      Subgroup.normalizer
        (torusRestrictedRootDepthSubgroup hφ f α r : Set (rationalPoints G)) := by
  rw [torusRestrictedRootDepthSubgroup_eq_iSup_fibre]
  apply Langlands.GroupTheory.le_normalizer_iSup_of_commutator_le
  intro x
  obtain ⟨⟨χ, m⟩, hχ, hm, hχres⟩ := x
  refine (hφ.filtrationSubgroup_commutator_le hθ hχ
    (torusRestriction_not_opposite hS f hα hm hχres hθ0) 0 (m * r)).trans ?_
  refine iSup_le fun p => iSup_le fun q => iSup_le fun _ => iSup_le fun hq =>
    iSup_le fun hroot => ?_
  have hres : f ≫ (p • θ + q • χ) = (q * m) • α := by
    simp only [Preadditive.comp_add, Preadditive.comp_nsmul, hθ0, hχres, smul_zero,
      zero_add, smul_smul]
  have hd : (p : ℝ) * 0 + q * (m * r) = ((q * m : ℕ) : ℝ) * r := by
    push_cast
    ring
  rw [hd]
  exact le_iSup (fun x : RestrictionFibre (i := i) f α =>
    hφ.filtrationSubgroup x.val.1 (x.val.2 * r))
    ⟨⟨p • θ + q • χ, q * m⟩, hroot, Nat.mul_pos hq hm, hres⟩

/-- The subgroup generated by the depth-zero filtrations of the roots of `T` vanishing on `S`
normalizes every restricted depth subgroup of a nonzero character of `S`. -/
theorem leviSharp_le_normalizer_torusRestrictedRootDepthSubgroup
    (hS : IsSplitTorus S.toGrp) (hφ : IsRootDatumValuation i φ) (f : S ⟶ T)
    {α : characterLattice S} (hα : α ≠ 0) (r : ℝ) :
    (⨆ θ : characterLattice T, ⨆ (_ : θ ∈ relativeRoots i) (_ : f ≫ θ = 0),
        hφ.filtrationSubgroup θ 0) ≤
      Subgroup.normalizer
        (torusRestrictedRootDepthSubgroup hφ f α r : Set (rationalPoints G)) :=
  iSup_le fun _ => iSup_le fun hθ => iSup_le fun hθ0 =>
    filtrationSubgroup_le_normalizer_torusRestrictedRootDepthSubgroup hS hφ f hα hθ hθ0 r

/-- The restricted depth subgroups depend only on the family, not on the proof that it is a
valuation. -/
theorem torusRestrictedRootDepthSubgroup_congr {φ₁ φ₂ : RootFunctionFamily T G}
    (h : φ₁ = φ₂) (h₁ : IsRootDatumValuation i φ₁) (h₂ : IsRootDatumValuation i φ₂)
    (f : S ⟶ T) (α : characterLattice S) (r : ℝ) :
    torusRestrictedRootDepthSubgroup h₁ f α r = torusRestrictedRootDepthSubgroup h₂ f α r := by
  subst h
  rfl

/-- Conjugation by `w ∈ N_i(k)` carries the restricted depth subgroups of `φ` to those of
`w • φ`, along any linear map `ρ` of characters of `S` compatible with the Weyl action of
`w`. -/
theorem conj_mem_torusRestrictedRootDepthSubgroup_smul
    (hφ : IsRootDatumValuation i φ) (w : normalizerPoints i)
    (hwφ : IsRootDatumValuation i (w • φ)) (f : S ⟶ T)
    (ρ : characterLattice S ≃ₗ[ℤ] characterLattice S)
    (hρ : ∀ χ, f ≫ weylAction i w χ = ρ (f ≫ χ)) (β : characterLattice S) (r : ℝ)
    {u : rationalPoints G} (hu : u ∈ torusRestrictedRootDepthSubgroup hφ f β r) :
    (w : rationalPoints G) * u * (w : rationalPoints G)⁻¹ ∈
      torusRestrictedRootDepthSubgroup hwφ f (ρ β) r := by
  suffices hle : torusRestrictedRootDepthSubgroup hφ f β r ≤
      (torusRestrictedRootDepthSubgroup hwφ f (ρ β) r).comap
        (MulAut.conj (w : rationalPoints G)).toMonoidHom from hle hu
  refine iSup_le fun χ => iSup_le fun hχ => iSup_le fun m => iSup_le fun hm =>
    iSup_le fun heq => ?_
  intro v hv
  rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
  have hmem : (w : rationalPoints G) * v * (w : rationalPoints G)⁻¹ ∈
      hwφ.filtrationSubgroup (weylAction i w χ) (m * r) := by
    refine ⟨conj_mem_rootGroupPoints w hv.1, ?_⟩
    have hv' : (w : rationalPoints G)⁻¹ * ((w : rationalPoints G) * v *
        (w : rationalPoints G)⁻¹) * (w : rationalPoints G) = v := by
      group
    rw [RootFunctionFamily.smul_apply, weylAction_inv_apply_apply, hv']
    exact hv.2
  have hres : f ≫ weylAction i w χ = m • ρ β := by
    rw [hρ, heq, map_nsmul]
  exact Subgroup.mem_iSup_of_mem (weylAction i w χ)
    (Subgroup.mem_iSup_of_mem (weylAction_mapsTo_relativeRoots i w hχ)
      (Subgroup.mem_iSup_of_mem m (Subgroup.mem_iSup_of_mem hm
        (Subgroup.mem_iSup_of_mem hres hmem))))

/-- **Levi transport of restricted depth subgroups.** If `w = n h ∈ N_i(k)` with `n ∈ N_j(k)`
for `j = f ≫ i` and `h` centralizing `j` and generated by depth-zero filtrations of the roots
of `T` vanishing on `S`, then `U^{w φ}_{α,r} = n U^φ_{n⁻¹ α, r} n⁻¹` for every nonzero `α`. -/
theorem mem_torusRestrictedRootDepthSubgroup_smul_iff (hS : IsSplitTorus S.toGrp)
    {i' : S.toGrp ⟶ G} [Mono i'.hom.hom.left]
    (f : S ⟶ T) (hf : CommGroupScheme.groupHom f ≫ i = i')
    (hφ : IsRootDatumValuation i φ) (n : normalizerPoints i') (w : normalizerPoints i)
    {h : rationalPoints G} (hh : h ∈ centralizerPoints i')
    (hlevi : h ∈ ⨆ θ : characterLattice T, ⨆ (_ : θ ∈ relativeRoots i) (_ : f ≫ θ = 0),
      hφ.filtrationSubgroup θ 0)
    (hw : (w : rationalPoints G) = n * h) (hwφ : IsRootDatumValuation i (w • φ))
    {α : characterLattice S} (hα : α ≠ 0) (r : ℝ) (g : rationalPoints G) :
    g ∈ torusRestrictedRootDepthSubgroup hwφ f α r ↔
      (n : rationalPoints G)⁻¹ * g * n ∈
        torusRestrictedRootDepthSubgroup hφ f (weylAction i' n⁻¹ α) r := by
  have hβ : weylAction i' n⁻¹ α ≠ 0 := fun h0 =>
    hα ((weylAction i' n⁻¹).map_eq_zero_iff.1 h0)
  have hnorm := leviSharp_le_normalizer_torusRestrictedRootDepthSubgroup hS hφ f hβ r hlevi
  constructor
  · intro hg
    have hφ' : IsRootDatumValuation i (w⁻¹ • w • φ) := by
      rw [inv_smul_smul]
      exact hφ
    have h1 := conj_mem_torusRestrictedRootDepthSubgroup_smul hwφ w⁻¹ hφ' f
      (weylAction i' n⁻¹) (torusHom_comp_weylAction_inv_of_eq_mul f hf n w hh hw) α r hg
    rw [torusRestrictedRootDepthSubgroup_congr (inv_smul_smul w φ) hφ' hφ, Subgroup.coe_inv,
      inv_inv] at h1
    have h2 := (Subgroup.mem_normalizer_iff.1 hnorm _).1 h1
    have heq : h * ((w : rationalPoints G)⁻¹ * g * (w : rationalPoints G)) * h⁻¹ =
        (n : rationalPoints G)⁻¹ * g * n := by
      rw [hw]
      group
    rwa [heq] at h2
  · intro hg
    have h1 := (Subgroup.mem_normalizer_iff''.1 hnorm _).1 hg
    have h2 := conj_mem_torusRestrictedRootDepthSubgroup_smul hφ w hwφ f
      (weylAction i' n) (torusHom_comp_weylAction_of_eq_mul f hf n w hh hw)
      (weylAction i' n⁻¹ α) r h1
    rw [weylAction_apply_inv_apply] at h2
    have heq : (w : rationalPoints G) * (h⁻¹ * ((n : rationalPoints G)⁻¹ * g * n) * h) *
        (w : rationalPoints G)⁻¹ = g := by
      rw [hw]
      group
    rwa [heq] at h2

/-- **Levi transport of restricted root functions.** If `w = n h ∈ N_i(k)` with `n ∈ N_j(k)`
for `j = f ≫ i`, and `h` centralizes `j` and lies in the subgroup generated by the
depth-zero filtrations of the roots of `T` vanishing on `S`, then restricting `w • φ` from
`T` to `S` gives `n` applied to the restriction of `φ`. -/
theorem torusRestrictedRootFunctionFamily_smul_of_eq_mul [Smooth G.X.hom]
    (hS : IsSplitTorus S.toGrp) (hT : IsSplitTorus T.toGrp)
    (hE : RelativeRoot.HasOppositeFactorPairs i)
    {i' : S.toGrp ⟶ G} [Mono i'.hom.hom.left]
    (f : S ⟶ T) (hf : CommGroupScheme.groupHom f ≫ i = i')
    (hφ : IsRootDatumValuation i φ) (n : normalizerPoints i') (w : normalizerPoints i)
    {h : rationalPoints G} (hh : h ∈ centralizerPoints i')
    (hlevi : h ∈ ⨆ θ : characterLattice T, ⨆ (_ : θ ∈ relativeRoots i) (_ : f ≫ θ = 0),
      hφ.filtrationSubgroup θ 0)
    (hw : (w : rationalPoints G) = n * h) (hwφ : IsRootDatumValuation i (w • φ)) :
    torusRestrictedRootFunctionFamily hS hT hE hwφ f =
      n • torusRestrictedRootFunctionFamily hS hT hE hφ f := by
  subst hf
  have hroot_iff : ∀ α, weylAction (CommGroupScheme.groupHom f ≫ i) n⁻¹ α ∈
      relativeRoots (CommGroupScheme.groupHom f ≫ i) ↔
        α ∈ relativeRoots (CommGroupScheme.groupHom f ≫ i) := fun α =>
    weylAction_mem_roots_iff n⁻¹ α
  have hgroup_iff : ∀ α (g : rationalPoints G),
      (n : rationalPoints G)⁻¹ * g * n ∈
          rootGroupPoints (CommGroupScheme.groupHom f ≫ i)
            (weylAction (CommGroupScheme.groupHom f ≫ i) n⁻¹ α) ↔
        g ∈ rootGroupPoints (CommGroupScheme.groupHom f ≫ i) α := by
    intro α g
    constructor
    · intro hg
      have h1 := conj_mem_rootGroupPoints n hg
      rwa [weylAction_apply_inv_apply,
        show (n : rationalPoints G) * ((n : rationalPoints G)⁻¹ * g * n) *
          (n : rationalPoints G)⁻¹ = g by group] at h1
    · intro hg
      have h1 := conj_mem_rootGroupPoints n⁻¹ hg
      rwa [Subgroup.coe_inv, inv_inv] at h1
  symm
  apply torusRestrictedRootFunctionFamily_unique hS hT hE hwφ f
  · intro α hα g
    rw [RootFunctionFamily.smul_apply]
    exact torusRestrictedRootFunctionFamily_eq_top_of_not_mem_roots hS hT hE hφ f _
      (fun h' => hα ((hroot_iff α).1 h')) _
  · intro α _ g hg
    rw [RootFunctionFamily.smul_apply]
    exact torusRestrictedRootFunctionFamily_eq_top_of_not_mem hS hT hE hφ f _ _
      (fun h' => hg ((hgroup_iff α g).1 h'))
  · intro α hα r
    ext g
    have hα0 : α ≠ 0 := (mem_relativeRoots.1 hα).1
    have hαn := (hroot_iff α).2 hα
    have hfil := Set.ext_iff.1
      (rootFiltration_torusRestrictedRootFunctionFamily hS hT hE hφ f _ hαn r)
      ((n : rationalPoints G)⁻¹ * g * n)
    rw [SetLike.mem_coe,
      mem_torusRestrictedRootDepthSubgroup_smul_iff hS f rfl hφ n w hh hlevi hw hwφ hα0 r g, ← SetLike.mem_coe, ← hfil, mem_rootFiltration,
      mem_rootFiltration, RootFunctionFamily.smul_apply, hgroup_iff]

end Langlands.Geometry.Building
