import Langlands.Geometry.Building.KPLocalMoyPrasadGroups
import Langlands.Geometry.Building.RealTorusSpace

/-!
# Group properties of the groups `G(K)_{x,r}` over `K = F^ur`

The group properties of the groups `G(K)_{x,r}` of quasi-split building data over the maximal
unramified extension `K = F^ur` (`BuildingData.moyPrasad`): normality, equivariance,
commutators, intersections with root subgroups, Levi subgroups and the centralizer, the
Iwahori factorization, and separation. Sources: KP Lemma 7.3.16, Propositions 7.3.12,
7.3.17 and 13.2.5(4), Remark 7.6.5 with (7.6.2), and Lemma 8.5.19.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj NNReal
open Langlands.GroupScheme Langlands.GroupScheme.RealTorusSpace Langlands.LocalGalois.Separable

namespace Langlands.Geometry.Building.MaximalUnramified

namespace BuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))} [IsAffineHom H.X.hom]
  (B : BuildingData F H)

/-- `U_Ψ`: the subgroup of `G(K)` generated by the root groups `U_b(K)`, `b ∈ Ψ`. -/
def rootGroupSpan (Ψ : Set (characterLattice B.S)) : Subgroup (rationalPoints H) :=
  ⨆ b ∈ Ψ, B.rootGroup b

/-- The subgroup of `G(K)` generated by the root filtration subgroups `U_{b,x,r}`, `b ∈ Ψ`. -/
def rootFiltrationSpan (x : B.Apartment) (Ψ : Set (characterLattice B.S)) (r : ℝ) :
    Subgroup (rationalPoints H) :=
  ⨆ b ∈ Ψ, B.filtration x b r

/-- `Ψ` is a closed set of relative roots: if `b, c ∈ Ψ` and `p b + q c` is a relative root
for positive integers `p, q`, then `p b + q c ∈ Ψ`. -/
def IsClosedRootSet (Ψ : Set (characterLattice B.S)) : Prop :=
  Ψ ⊆ relativeRoots B.i ∧
    ∀ b ∈ Ψ, ∀ c ∈ Ψ, ∀ p q : ℕ, 0 < p → 0 < q →
      p • b + q • c ∈ relativeRoots B.i → p • b + q • c ∈ Ψ

/-- The relative roots `b` with `⟨b, ν⟩ > 0`, for `ν` in the real cocharacter space of `S`. -/
def positivePairingRoots (ν : V B.S) : Set (characterLattice B.S) :=
  {b | b ∈ relativeRoots B.i ∧ 0 < eval B.S b ν}

/-- The relative roots `b` with `⟨b, ν⟩ < 0`. -/
def negativePairingRoots (ν : V B.S) : Set (characterLattice B.S) :=
  {b | b ∈ relativeRoots B.i ∧ eval B.S b ν < 0}

/-- The relative roots `b` with `⟨b, ν⟩ = 0`, the relative roots of the Levi subgroup `M_ν`. -/
def zeroPairingRoots (ν : V B.S) : Set (characterLattice B.S) :=
  {b | b ∈ relativeRoots B.i ∧ eval B.S b ν = 0}

/-- `M_ν(K)`: the subgroup of `G(K)` generated by `j(Z(K))` and the root groups `U_b(K)` with
`⟨b, ν⟩ = 0`. -/
def pairingLeviSpan (ν : V B.S) : Subgroup (rationalPoints H) :=
  (rationalPoints.map B.centralizer.j).range ⊔ B.rootGroupSpan (B.zeroPairingRoots ν)

end BuildingData

section Clauses

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))} [IsAffineHom H.X.hom]
  (B : BuildingData F H) (hZ : IsTorus B.centralizer.Z)

/-- Clause 1 (KP Proposition 7.3.17): `G(K)_{x,0}` normalizes `G(K)_{x,r}`. -/
def LocalMoyPrasadNormality : Prop :=
  ∀ (x : B.Apartment) (r : ℝ≥0),
    B.moyPrasad hZ x 0 ≤ Subgroup.normalizer (B.moyPrasad hZ x r : Set (rationalPoints H))

/-- Clause 2 (KP Proposition 7.3.17, Remark 7.6.5 and (7.6.2)): if `g · [x] = [x']` in the
reduced building, conjugation by `g` maps `G(K)_{x,r}` onto `G(K)_{x',r}`. In particular,
conjugation by `n ∈ N(K)` maps `G(K)_{x,r}` onto `G(K)_{n·x,r}`. -/
def LocalMoyPrasadEquivariance : Prop :=
  (∀ (g : rationalPoints H) (x x' : B.Apartment),
      B.apartmentMap x' = g • B.apartmentMap x → ∀ r : ℝ≥0,
        (B.moyPrasad hZ x r).map (MulAut.conj g).toMonoidHom = B.moyPrasad hZ x' r) ∧
    ∀ (n : normalizerPoints B.i) (x : B.Apartment) (r : ℝ≥0),
      (B.moyPrasad hZ x r).map (MulAut.conj (n : rationalPoints H)).toMonoidHom =
        B.moyPrasad hZ (n • x) r

/-- Clause 3 (KP Proposition 13.2.5(4) over `K`): `⁅G(K)_{x,r}, G(K)_{x,s}⁆ ≤ G(K)_{x,r+s}`. -/
def LocalMoyPrasadCommutator : Prop :=
  ∀ (x : B.Apartment) (r s : ℝ≥0),
    ⁅B.moyPrasad hZ x r, B.moyPrasad hZ x s⁆ ≤ B.moyPrasad hZ x (r + s)

/-- Clause 4 (KP Proposition 7.3.12(1), (3), (5)): for a closed set `Ψ` of relative roots in
an open half-space `{b | 0 < ⟨b, ν⟩}`, `U_Ψ ⊓ G(K)_{x,r}` is generated by the `U_{b,x,r}`,
`b ∈ Ψ`. -/
def LocalMoyPrasadRootIntersection : Prop :=
  ∀ (Ψ : Set (characterLattice B.S)) (ν : V B.S), B.IsClosedRootSet Ψ →
    (∀ b ∈ Ψ, 0 < eval B.S b ν) → ∀ (x : B.Apartment) (r : ℝ≥0),
      B.rootGroupSpan Ψ ⊓ B.moyPrasad hZ x r = B.rootFiltrationSpan x Ψ r

/-- Clause 5 (KP Proposition 7.3.12(5), Lemmas 7.3.16 and 8.5.19): for `r > 0`, if
`v' · m · v ∈ G(K)_{x,r}` with `v' ∈ U_{-ν}`, `m ∈ M_ν` and `v ∈ U_ν`, then each factor lies
in `G(K)_{x,r}`. -/
def LocalMoyPrasadIwahoriFactorization : Prop :=
  ∀ (ν : V B.S) (x : B.Apartment) (r : ℝ≥0), 0 < r →
    ∀ v' ∈ B.rootGroupSpan (B.negativePairingRoots ν), ∀ m ∈ B.pairingLeviSpan ν,
      ∀ v ∈ B.rootGroupSpan (B.positivePairingRoots ν),
        v' * m * v ∈ B.moyPrasad hZ x r →
          v' ∈ B.moyPrasad hZ x r ∧ m ∈ B.moyPrasad hZ x r ∧ v ∈ B.moyPrasad hZ x r

/-- Clause 6 (KP Lemma 8.5.19): `M_ν ⊓ G(K)_{x,r}` is generated by `j(Z(K)_r)` and the
`U_{b,x,r}` with `⟨b, ν⟩ = 0`. -/
def LocalMoyPrasadLeviIntersection : Prop :=
  ∀ (ν : V B.S) (x : B.Apartment) (r : ℝ≥0),
    B.pairingLeviSpan ν ⊓ B.moyPrasad hZ x r =
      B.centralizerTorusImage hZ r ⊔ B.rootFiltrationSpan x (B.zeroPairingRoots ν) r

/-- Clause 7 (KP Lemma 7.3.16): the preimage of `G(K)_{x,r}` under `j` is `Z(K)_r`. -/
def LocalMoyPrasadCentralizerIntersection : Prop :=
  ∀ (x : B.Apartment) (r : ℝ≥0),
    (B.moyPrasad hZ x r).comap (rationalPoints.map B.centralizer.j) =
      B.centralizerTorusFiltration hZ r

/-- Clause 8: the filtration is separated, `⋂_r G(K)_{x,r} = {1}`. -/
def LocalMoyPrasadSeparated : Prop :=
  ∀ x : B.Apartment, ⨅ r : ℝ≥0, B.moyPrasad hZ x r = ⊥

end Clauses

/-- The group properties of the groups `G(K)_{x,r}` over `K = F^ur`, clauses 1–8: normality,
equivariance, commutators, root intersections, Iwahori factorization, Levi and centralizer
intersections, and separation. -/
def LocalMoyPrasadGroupPropertiesStatement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (H : GroupScheme (Spec (CommRingCat.of (UnramifiedClosure F)))) [IsAffineHom H.X.hom]
    (B : BuildingData F H) (hZ : IsTorus B.centralizer.Z),
    LocalMoyPrasadNormality B hZ ∧ LocalMoyPrasadEquivariance B hZ ∧
      LocalMoyPrasadCommutator B hZ ∧ LocalMoyPrasadRootIntersection B hZ ∧
      LocalMoyPrasadIwahoriFactorization B hZ ∧ LocalMoyPrasadLeviIntersection B hZ ∧
      LocalMoyPrasadCentralizerIntersection B hZ ∧ LocalMoyPrasadSeparated B hZ

end Langlands.Geometry.Building.MaximalUnramified
