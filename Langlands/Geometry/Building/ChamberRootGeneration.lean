import Langlands.Geometry.Building.ApartmentRootCover
import Langlands.Geometry.Building.ChamberFiltration
import Langlands.Geometry.Building.KPFiltrationTopology
import Langlands.GroupScheme.CentralIsogeny.KernelTorsion
import Langlands.GroupScheme.CentralIsogeny.PowerLift
import Langlands.GroupScheme.Rational.RootSubgroupStability
import Langlands.BruhatTits.Unipotent.CocharacterContraction

/-! # Actual root groups in the chamber and zero-normalizer join -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology Filter
open scoped CategoryTheory.MonObj
open Langlands.GroupScheme Langlands.AlgebraicGeometry.PointTopology
open Langlands.BruhatTits.DynamicUnipotentContainment

namespace Langlands.Geometry.Building.ParahoricBuildingData

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  {G : GroupScheme (Spec (CommRingCat.of F))} [IsAffineHom G.X.hom]
  (P : ParahoricBuildingData G)

/-- Every positive derived contracting cocharacter has a positive power whose
values lift through the supplied simply connected derived cover. -/
theorem exists_positive_power_cocharPoint_mem_simplyConnectedImage
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer) (a : relativeRoots P.i) :
    ∃ m : ℕ, 0 < m ∧ ∀ t : Fˣ,
      cocharPoint (CommGroupScheme.groupHom
        (KPApartmentData.positiveDerivedCocharacter P.i P.apartment P.centralizer hA
          P.zeroDatum.isMaximalSplitTorus.isSplitSubtorus.1 a) ≫ P.i) t ^ m ∈
        P.simplyConnectedImage := by
  let E := P.zeroDatum
  let hπ := E.isSimplyConnectedDerivedCover.isSimplyConnectedCover.isCentralIsogeny
  let χ := KPApartmentData.derivedContractingCocharacter P.i P.apartment P.centralizer hA
    E.isMaximalSplitTorus.isSplitSubtorus.1 E.isSimplyConnectedDerivedCover.isDerivedSubgroup a
  obtain ⟨N, hN, hk⟩ := hπ.exists_pow_eq_one_kernel
  obtain ⟨Φ, hΦ⟩ := hπ.exists_comp_eq_multiplication_comp χ hk
  refine ⟨2 * N, Nat.mul_pos (by decide) hN, fun t => ?_⟩
  refine ⟨cocharPoint Φ t, ?_⟩
  change cocharPoint Φ t ≫ (E.π ≫ E.d).hom.hom = _
  have hcomp : Φ ≫ E.π ≫ E.d =
      multiplication (Gm (Spec (CommRingCat.of F))).toGrp (2 * N : ℕ) ≫
        (CommGroupScheme.groupHom
          (KPApartmentData.positiveDerivedCocharacter P.i P.apartment P.centralizer hA
            E.isMaximalSplitTorus.isSplitSubtorus.1 a) ≫ P.i) := by
    rw [← Category.assoc, hΦ, Category.assoc]
    exact congrArg (_ ≫ ·)
      (KPApartmentData.derivedContractingCocharacter_comp P.i P.apartment P.centralizer
        hA E.isMaximalSplitTorus.isSplitSubtorus.1
        E.isSimplyConnectedDerivedCover.isDerivedSubgroup a)
  have hp := congrArg (fun f : (Gm (Spec (CommRingCat.of F))).toGrp ⟶ G =>
    (Gm.affinePointsEquiv (𝟙 (Spec (CommRingCat.of F)))).symm t ≫ f.hom.hom) hcomp
  simpa only [cocharPoint_eq, Grp.comp_hom_hom, ← Category.assoc,
    points_multiplication, zpow_natCast, MonObj.pow_comp] using hp

set_option maxHeartbeats 200000 in
/-- The actual root group lies in the subgroup generated by the chamber
parahoric and the normalizer elements in the actual zero subgroup. -/
theorem rootGroup_le_parahoric_sup_zeroNormalizer
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C)
    (a : relativeRoots P.i) :
    rootGroupPoints P.i a ≤ P.parahoric C ⊔ (normalizerPoints P.i ⊓ P.zeroSubgroup) := by
  let : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  let : TopologicalSpace (rationalPoints G) := rationalPointTopology F G.X
  let ν := KPApartmentData.positiveDerivedCocharacter P.i P.apartment P.centralizer hA
    P.zeroDatum.isMaximalSplitTorus.isSplitSubtorus.1 a
  let χ := CommGroupScheme.groupHom ν ≫ P.i
  obtain ⟨m, hm, hmlift⟩ := P.exists_positive_power_cocharPoint_mem_simplyConnectedImage hA a
  obtain ⟨t, ht⟩ := exists_unit_tendsto_pow_zero (F := F)
  let s := t ^ m
  let z := cocharPoint χ s
  have hsz : z = cocharPoint χ t ^ m := cocharPoint_pow χ t m
  have hz0 : z ∈ P.zeroSubgroup :=
    P.zeroDatum.simplyConnectedImage_le_zeroSubgroup (hsz ▸ hmlift t)
  let v : rationalPoints P.S.toGrp :=
    (Gm.affinePointsEquiv (𝟙 (Spec (CommRingCat.of F)))).symm s ≫
      (CommGroupScheme.groupHom ν).hom.hom
  have hzv : z = v ≫ P.i.hom.hom := by
    dsimp only [z, χ, v]
    rw [cocharPoint_eq, Grp.comp_hom_hom, Category.assoc]
  have hzN : z ∈ normalizerPoints P.i := by
    apply centralizerPoints_le_normalizerPoints P.i
    apply (mem_centralizerPoints P.i).2
    apply (mem_torusCentralizer_base_iff P.i z).1
    intro V f q
    rw [hzv, ← Category.assoc]
    exact (Commute.all (f ≫ v) q).map (IsMonHom.monoidHom P.i.hom.hom V)
  have hs : Tendsto (fun n : ℕ => (s : F) ^ n) atTop (𝓝 0) := by
    have hh := ht.pow m
    simpa only [s, Units.val_pow_eq_pow_val, ← pow_mul,
      Nat.mul_comm m, zero_pow hm.ne'] using hh
  intro g hg
  have hgU : g ∈ RationalPoint.unipotent χ :=
    RelativeRoot.subgroup_le_dynamicUnipotent P.i ν
      (KPApartmentData.positiveDerivedCocharacter_pos P.i P.apartment P.centralizer hA
        P.zeroDatum.isMaximalSplitTorus.isSplitSubtorus.1 a) _ hg
  have hc := tendsto_cocharPoint_pow_conj χ s hs ⟨g, hgU⟩
  have hp : Tendsto (fun n : ℕ => (n, (⟨g, hgU⟩ : unipotentPoints χ))) atTop
      (atTop ×ˢ 𝓝 (⟨g, hgU⟩ : unipotentPoints χ)) :=
    tendsto_id.prodMk tendsto_const_nhds
  have hlim := hc.comp hp
  have hroot (n : ℕ) : z ^ n * g * (z ^ n)⁻¹ ∈ rootGroupPoints P.i a := by
    rw [hzv, ← MonObj.pow_comp]
    simpa only [rootGroupPoints, AutomorphicAction.conjugation_act] using
      RelativeRoot.subgroup_isStable P.i a _ (v ^ n) g hg
  let f : ℕ → rootGroupPoints P.i a := fun n => ⟨z ^ n * g * (z ^ n)⁻¹, hroot n⟩
  have hlim' : Tendsto f atTop (𝓝 (1 : rootGroupPoints P.i a)) :=
    tendsto_subtype_rng.2 hlim
  obtain ⟨x, hx⟩ : C.Nonempty := by
    obtain ⟨x, _, rfl⟩ := hC
    exact ⟨x, AffineRootSystem.mem_facet_self P.affineRoots x⟩
  let W := P.toValuationBuildingData.filtrationOpenSubgroup hA.topologyCompatible x a 0
  obtain ⟨n, hn⟩ := (hlim'.eventually (W.isOpen.mem_nhds W.one_mem)).exists
  have hfilt : z ^ n * g * (z ^ n)⁻¹ ∈ P.rootFixer a C := by
    change z ^ n * g * (z ^ n)⁻¹ ∈ P.apartment.rootFixer a C
    rw [(P.apartment.rootFixer_eq_filtration_of_isFacet hA.mem_or_two_smul_mem
      hC.isFacet hx a.property).1]
    exact hn
  let K := P.parahoric C ⊔ (normalizerPoints P.i ⊓ P.zeroSubgroup)
  have hzK : z ∈ K := Subgroup.mem_sup_right ⟨hzN, hz0⟩
  have hgK : z ^ n * g * (z ^ n)⁻¹ ∈ K :=
    Subgroup.mem_sup_left (P.rootFixer_le_parahoric a C hfilt)
  have h := K.mul_mem (K.mul_mem (K.inv_mem (K.pow_mem hzK n)) hgK) (K.pow_mem hzK n)
  convert h using 1
  group

/-- The actual root subgroup maps into the chamber and zero-normalizer join
by its identity inclusion on rational points. -/
def rootGroupChamberInclusion
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C)
    (a : relativeRoots P.i) :
    rootGroupPoints P.i a →* ↥(P.parahoric C ⊔ (normalizerPoints P.i ⊓ P.zeroSubgroup)) :=
  Subgroup.inclusion (P.rootGroup_le_parahoric_sup_zeroNormalizer hA hC a)

@[simp] theorem rootGroupChamberInclusion_coe
    (hA : P.apartment.SatisfiesApartmentAxioms P.centralizer)
    {C : Set P.Apartment} (hC : AffineRootSystem.IsChamber P.affineRoots C)
    (a : relativeRoots P.i) (g : rootGroupPoints P.i a) :
    (P.rootGroupChamberInclusion hA hC a g : rationalPoints G) = g := rfl

end Langlands.Geometry.Building.ParahoricBuildingData
