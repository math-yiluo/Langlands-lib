import Langlands.Geometry.FormalGroup.FiniteKernelCompositionStatement
import Langlands.Geometry.FormalGroup.FiniteFlatRankDescent
import Mathlib.RingTheory.FinitePresentation
import Mathlib.RingTheory.Finiteness.ModuleFinitePresentation
import Mathlib.RingTheory.Flat.EquationalCriterion

/-! # Finite projective kernels of composites of formal-module maps -/

noncomputable section

universe u v

namespace Langlands.FormalGroup.ModuleLaw

open CategoryTheory TensorProduct

variable {O : Type u} [CommRing O]
variable {R : Type v} [CommRing R] [Algebra O R]
variable {σ τ υ : Type} [Finite σ] [Finite τ] [Finite υ]

attribute [local instance] coefficientAlgebra coefficientScalarTower

namespace FiniteKernelComposition

/-- An element of an ideal spanned by finitely many elements whose `(c+1)`-st powers vanish
has vanishing `(card * c + 1)`-st power. -/
theorem pow_eq_zero_of_mem_span_range {A : Type*} [CommRing A] {ι : Type*} [Fintype ι]
    (s : ι → A) (c : ℕ) (hs : ∀ j, s j ^ (c + 1) = 0) {z : A}
    (hz : z ∈ Ideal.span (Set.range s)) : z ^ (Fintype.card ι * c + 1) = 0 := by
  obtain ⟨r, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hz
  have h := Ideal.sum_pow_mem_span_pow Finset.univ (fun j => r j * s j) c
  rw [Finset.card_univ] at h
  have h0 : (fun j => (r j * s j) ^ (c + 1)) '' (Finset.univ : Finset ι) ⊆ ({0} : Set A) := by
    rintro _ ⟨j, -, rfl⟩
    simp [mul_pow, hs j]
  have := Ideal.span_mono h0 h
  rw [Ideal.span_singleton_zero, Ideal.mem_bot] at this
  exact this

/-- Coordinates of an actual point. -/
def coord (M : ModuleLaw O R σ) {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A) (i : σ) : A :=
  (M.algebraPointEquiv A x).val i

variable {M : ModuleLaw O R σ}

theorem coord_isNilpotent {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A) (i : σ) :
    IsNilpotent (coord M x i) :=
  (M.algebraPointEquiv A x).property i

theorem ext_coord {A : CommAlgCat.{v} R} {x y : M.AlgebraPoint A}
    (h : ∀ i, coord M x i = coord M y i) : x = y :=
  (M.algebraPointEquiv A).injective (Subtype.ext (funext h))

@[simp]
theorem coord_algebraMapPoints {A B : CommAlgCat.{v} R} (φ : A →ₐ[R] B) (x : M.AlgebraPoint A)
    (i : σ) : coord M (M.algebraMapPoints φ x) i = φ (coord M x i) :=
  rfl

@[simp]
theorem coord_zero {A : CommAlgCat.{v} R} (i : σ) : coord M (0 : M.AlgebraPoint A) i = 0 :=
  map_zero (MvPowerSeries.constantCoeff (σ := Empty) (R := A))

/-- The coordinates of a sum lie in the ideal generated by the coordinates of the summands. -/
theorem coord_add_mem {A : CommAlgCat.{v} R} (x y : M.AlgebraPoint A) (i : σ) :
    coord M (x + y) i ∈
      Ideal.span (Set.range (coord M x)) ⊔ Ideal.span (Set.range (coord M y)) := by
  set I := Ideal.span (Set.range (coord M x)) ⊔ Ideal.span (Set.range (coord M y))
  let π : A ⟶ CommAlgCat.of R (A ⧸ I) := CommAlgCat.ofHom (Ideal.Quotient.mkₐ R I)
  have hx : M.algebraMapPoints π.hom x = 0 := by
    refine ext_coord fun j => ?_
    rw [coord_algebraMapPoints, coord_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩))
  have hy : M.algebraMapPoints π.hom y = 0 := by
    refine ext_coord fun j => ?_
    rw [coord_algebraMapPoints, coord_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩))
  have h : M.algebraMapPoints π.hom (x + y) = 0 := by
    rw [map_add, hx, hy, add_zero]
  have h' := congrArg (fun z => coord M z i) h
  simp only [coord_zero] at h'
  exact Ideal.Quotient.eq_zero_iff_mem.mp h'

/-- A uniform nilpotence bound for the coordinates of a sum. -/
theorem coord_add_pow_eq_zero {A : CommAlgCat.{v} R} (x y : M.AlgebraPoint A) (a b : ℕ)
    (hx : ∀ i, coord M x i ^ (a + 1) = 0) (hy : ∀ i, coord M y i ^ (b + 1) = 0) (i : σ) :
    coord M (x + y) i ^ (2 * Nat.card σ * (a + b) + 1) = 0 := by
  let := Fintype.ofFinite σ
  have hs : ∀ j, Sum.elim (coord M x) (coord M y) j ^ (a + b + 1) = 0 := by
    rintro (j | j)
    · exact pow_eq_zero_of_le (by omega) (hx j)
    · exact pow_eq_zero_of_le (by omega) (hy j)
  have hmem := coord_add_mem x y i
  rw [← Ideal.span_union, ← Set.Sum.elim_range] at hmem
  have := pow_eq_zero_of_mem_span_range _ _ hs hmem
  rwa [Fintype.card_sum, ← two_mul, Fintype.card_eq_nat_card] at this

/-- A finite tuple of nilpotent coordinates has a common nilpotence exponent. -/
theorem exists_coord_pow_eq_zero {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A) :
    ∃ a : ℕ, ∀ i, coord M x i ^ (a + 1) = 0 := by
  let := Fintype.ofFinite σ
  choose n hn using coord_isNilpotent x
  refine ⟨∑ i, n i, fun i => pow_eq_zero_of_le ?_ (hn i)⟩
  have := Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
  omega

variable {N : ModuleLaw O R τ} {P : ModuleLaw O R υ}

/-- View an element of the kernel set functor as an actual kernel point. -/
def kernelVal {f : Hom M N} {A : CommAlgCat.{v} R} (x : f.kernelSetFunctor.obj A) :
    M.AlgebraPoint A :=
  (show f.kernelPoints A from x).val

theorem kernelVal_property {f : Hom M N} {A : CommAlgCat.{v} R}
    (x : f.kernelSetFunctor.obj A) : f.onAlgebraPoints (kernelVal x) = 0 :=
  (show f.kernelPoints A from x).property

/-- Package an actual kernel point as an element of the kernel set functor. -/
def kernelMk (f : Hom M N) {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : f.onAlgebraPoints x = 0) : f.kernelSetFunctor.obj A :=
  show f.kernelPoints A from ⟨x, hx⟩

@[simp]
theorem kernelVal_kernelMk (f : Hom M N) {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : f.onAlgebraPoints x = 0) : kernelVal (kernelMk f x hx) = x :=
  rfl

theorem kernelVal_injective {f : Hom M N} {A : CommAlgCat.{v} R} :
    Function.Injective (kernelVal (f := f) (A := A)) :=
  fun _ _ h => Subtype.ext h

theorem kernelVal_map {f : Hom M N} {A B : CommAlgCat.{v} R} (χ : A ⟶ B)
    (x : f.kernelSetFunctor.obj A) :
    kernelVal (f.kernelSetFunctor.map χ x) = M.algebraMapPoints χ.hom (kernelVal x) :=
  rfl

/-- The universal kernel point carried by a corepresentation of the kernel. -/
def universalPoint {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) : M.AlgebraPoint X :=
  kernelVal (E.homEquiv (𝟙 X))

theorem universalPoint_property {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) : f.onAlgebraPoints (universalPoint E) = 0 :=
  kernelVal_property _

theorem kernelVal_homEquiv {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) {A : CommAlgCat.{v} R} (χ : X ⟶ A) :
    kernelVal (E.homEquiv χ) = M.algebraMapPoints χ.hom (universalPoint E) := by
  rw [E.homEquiv_eq]
  rfl

theorem homEquiv_symm_spec {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) {A : CommAlgCat.{v} R}
    (x : M.AlgebraPoint A) (hx : f.onAlgebraPoints x = 0) :
    M.algebraMapPoints (E.homEquiv.symm (kernelMk f x hx)).hom (universalPoint E) = x := by
  rw [← kernelVal_homEquiv, Equiv.apply_symm_apply, kernelVal_kernelMk]

/-- Two maps out of a corepresenting algebra agree when they move the universal point equally. -/
theorem hom_ext_of_universalPoint {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) {A : CommAlgCat.{v} R} {χ χ' : X ⟶ A}
    (h : M.algebraMapPoints χ.hom (universalPoint E) =
      M.algebraMapPoints χ'.hom (universalPoint E)) :
    χ = χ' := by
  apply E.homEquiv.injective
  apply kernelVal_injective
  rw [kernelVal_homEquiv, kernelVal_homEquiv, h]

/-- Coordinates of all points of a corepresented kernel have a common nilpotence bound. -/
theorem exists_kernel_bound {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) :
    ∃ a : ℕ, ∀ (A : CommAlgCat.{v} R) (x : M.AlgebraPoint A), f.onAlgebraPoints x = 0 →
      ∀ i, coord M x i ^ (a + 1) = 0 := by
  obtain ⟨a, ha⟩ := exists_coord_pow_eq_zero (universalPoint E)
  refine ⟨a, fun A x hx i => ?_⟩
  rw [← homEquiv_symm_spec E x hx, coord_algebraMapPoints, ← map_pow, ha i, map_zero]

/-- A faithfully flat map out of `L` and any map out of `L` fit into a commutative square whose
new edge out of the second target is injective. -/
theorem exists_pushout_injective {L A B : CommAlgCat.{v} R} (φ : L ⟶ B) (ψ : L ⟶ A)
    (hφ : φ.hom.toRingHom.FaithfullyFlat) :
    ∃ (A' : CommAlgCat.{v} R) (i : A ⟶ A') (j : B ⟶ A'),
      Function.Injective i.hom ∧ φ ≫ j = ψ ≫ i := by
  let : Algebra L B := φ.hom.toRingHom.toAlgebra
  let : Algebra L A := ψ.hom.toRingHom.toAlgebra
  have : IsScalarTower R L B := IsScalarTower.of_algebraMap_eq' φ.hom.comp_algebraMap.symm
  have : IsScalarTower R L A := IsScalarTower.of_algebraMap_eq' ψ.hom.comp_algebraMap.symm
  have : Module.FaithfullyFlat L B := hφ
  let i : A →ₐ[R] B ⊗[L] A := Algebra.TensorProduct.includeRight.restrictScalars R
  refine ⟨CommAlgCat.of R (B ⊗[L] A), CommAlgCat.ofHom i,
    CommAlgCat.ofHom (Algebra.TensorProduct.includeLeft (S := R)), ?_, ?_⟩
  · exact fun a b h => Module.FaithfullyFlat.tensorProduct_mk_injective (A := L) (B := B) A h
  · ext l
    exact Algebra.TensorProduct.algebraMap_apply' (R := L) (A := B) (B := A) l

/-- Coordinates of all kernel points of a composite have a common nilpotence bound. -/
theorem exists_comp_kernel_bound {f : Hom M N} {g : Hom N P} (hf : f.IsFppfLocallySurjective)
    (K : Hom.FiniteKernelModel f) (L : Hom.FiniteKernelModel g) :
    ∃ n : ℕ, ∀ (A : CommAlgCat.{v} R) (x : M.AlgebraPoint A),
      (g.comp f).onAlgebraPoints x = 0 → ∀ i, coord M x i ^ n = 0 := by
  obtain ⟨a, ha⟩ := exists_kernel_bound K.represents
  obtain ⟨B, φ, hφ, -, x0, hx0⟩ := hf L.coordinateAlgebra (universalPoint L.represents)
  obtain ⟨b, hb⟩ := exists_coord_pow_eq_zero x0
  refine ⟨2 * Nat.card σ * (a + b) + 1, fun A x hx i => ?_⟩
  have hfx : g.onAlgebraPoints (f.onAlgebraPoints x) = 0 := by
    rwa [← Hom.onAlgebraPoints_comp]
  have hψ := homEquiv_symm_spec L.represents _ hfx
  obtain ⟨A', i', j, hi, hsq⟩ :=
    exists_pushout_injective φ (L.represents.homEquiv.symm (kernelMk g _ hfx)) hφ
  have h1 : f.onAlgebraPoints (M.algebraMapPoints i'.hom x) =
      N.algebraMapPoints (L.represents.homEquiv.symm (kernelMk g _ hfx) ≫ i').hom
        (universalPoint L.represents) := by
    rw [← Hom.onAlgebraPoints_natural, CommAlgCat.hom_comp, algebraMapPoints_comp, hψ]
  have h2 : f.onAlgebraPoints (M.algebraMapPoints j.hom x0) =
      N.algebraMapPoints (φ ≫ j).hom (universalPoint L.represents) := by
    rw [← Hom.onAlgebraPoints_natural, hx0, CommAlgCat.hom_comp, algebraMapPoints_comp]
  have hy : f.onAlgebraPoints
      (M.algebraMapPoints i'.hom x - M.algebraMapPoints j.hom x0) = 0 := by
    rw [map_sub, h1, h2, hsq, sub_self]
  have hx0' : ∀ k, coord M (M.algebraMapPoints j.hom x0) k ^ (b + 1) = 0 := fun k => by
    rw [coord_algebraMapPoints, ← map_pow, hb k, map_zero]
  have key := coord_add_pow_eq_zero _ _ a b (ha A' _ hy) hx0' i
  rw [sub_add_cancel, coord_algebraMapPoints, ← map_pow] at key
  exact hi (key.trans (map_zero i'.hom).symm)


/-- An algebra homomorphism between objects of `CommAlgCat` as a morphism. -/
abbrev homOf {A B : CommAlgCat.{v} R} (φ : A →ₐ[R] B) : A ⟶ B :=
  CommAlgCat.ofHom φ

@[simp]
theorem hom_homOf {A B : CommAlgCat.{v} R} (φ : A →ₐ[R] B) : (homOf φ).hom = φ :=
  rfl

section Presentation

variable {Q : ModuleLaw O R υ}

variable (σ R) in
/-- The ideal generated by the `n`-th powers of the coordinate variables. -/
abbrev truncIdeal (n : ℕ) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun i : σ => (MvPolynomial.X i : MvPolynomial σ R) ^ n)

variable (σ R) in
/-- The polynomial algebra in the coordinates modulo the `n`-th powers of the variables. -/
def truncAlg (n : ℕ) : CommAlgCat.{v} R :=
  CommAlgCat.of R (MvPolynomial σ R ⧸ truncIdeal R σ n)

instance (n : ℕ) : Algebra.FinitePresentation R (truncAlg R σ n) :=
  Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))

variable (σ R) in
/-- The quotient map onto the truncated algebra. -/
def truncProj (n : ℕ) : MvPolynomial σ R →ₐ[R] truncAlg R σ n :=
  Ideal.Quotient.mkₐ R (truncIdeal R σ n)

omit [Finite σ] in
theorem truncProj_surjective (n : ℕ) : Function.Surjective (truncProj R σ n) :=
  Ideal.Quotient.mkₐ_surjective R _

omit [Finite σ] in
theorem truncProj_eq_zero_iff {n : ℕ} {p : MvPolynomial σ R} :
    truncProj R σ n p = 0 ↔ p ∈ truncIdeal R σ n :=
  Ideal.Quotient.eq_zero_iff_mem

omit [Finite σ] in
theorem truncProj_X_pow (n : ℕ) (i : σ) : truncProj R σ n (MvPolynomial.X i) ^ n = 0 := by
  rw [← map_pow, truncProj_eq_zero_iff]
  exact Ideal.subset_span ⟨i, rfl⟩

variable (M) in
/-- The tautological point of the truncated algebra. -/
def truncPoint (n : ℕ) : M.AlgebraPoint (truncAlg R σ n) :=
  (M.algebraPointEquiv _).symm
    ⟨fun i => truncProj R σ n (MvPolynomial.X i), fun i => ⟨n, truncProj_X_pow n i⟩⟩

@[simp]
theorem coord_truncPoint (n : ℕ) (i : σ) :
    coord M (truncPoint M n) i = truncProj R σ n (MvPolynomial.X i) := by
  simp [coord, truncPoint]

/-- Evaluation of the truncated algebra at a point whose coordinates have vanishing `n`-th
powers. -/
def truncLift {n : ℕ} {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : ∀ i, coord M x i ^ n = 0) : truncAlg R σ n →ₐ[R] A :=
  Ideal.Quotient.liftₐ (truncIdeal R σ n) (MvPolynomial.aeval (coord M x)) (by
    have hle : truncIdeal R σ n ≤ RingHom.ker (MvPolynomial.aeval (R := R) (coord M x)) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_pow, MvPolynomial.aeval_X, hx i]
    exact fun a ha => RingHom.mem_ker.mp (hle ha))

theorem truncLift_comp {n : ℕ} {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : ∀ i, coord M x i ^ n = 0) :
    (truncLift x hx).comp (truncProj R σ n) = MvPolynomial.aeval (coord M x) :=
  Ideal.Quotient.liftₐ_comp _ _ _

theorem truncLift_X {n : ℕ} {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : ∀ i, coord M x i ^ n = 0) (i : σ) :
    truncLift x hx (truncProj R σ n (MvPolynomial.X i)) = coord M x i := by
  rw [← AlgHom.comp_apply, truncLift_comp, MvPolynomial.aeval_X]

theorem truncLift_point {n : ℕ} {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : ∀ i, coord M x i ^ n = 0) :
    M.algebraMapPoints (truncLift x hx) (truncPoint M n) = x :=
  ext_coord fun i => by rw [coord_algebraMapPoints, coord_truncPoint, truncLift_X]

variable (M) in
/-- The ideal of the truncated algebra cut out by the coordinates of the image point. -/
def kerIdeal (h : Hom M Q) (n : ℕ) : Ideal (truncAlg R σ n) :=
  Ideal.span (Set.range (coord Q (h.onAlgebraPoints (truncPoint M n))))

/-- The candidate coordinate algebra of the kernel of `h`. -/
def kerAlg (h : Hom M Q) (n : ℕ) : CommAlgCat.{v} R :=
  CommAlgCat.of R (truncAlg R σ n ⧸ kerIdeal M h n)

instance (h : Hom M Q) (n : ℕ) : Algebra.FinitePresentation R (kerAlg h n) :=
  Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))

/-- The quotient map onto the candidate kernel algebra. -/
def kerProj (h : Hom M Q) (n : ℕ) : truncAlg R σ n →ₐ[R] kerAlg h n :=
  Ideal.Quotient.mkₐ R (kerIdeal M h n)

theorem kerProj_surjective (h : Hom M Q) (n : ℕ) : Function.Surjective (kerProj h n) :=
  Ideal.Quotient.mkₐ_surjective R _

theorem kerProj_eq_zero_iff {h : Hom M Q} {n : ℕ} {y : truncAlg R σ n} :
    kerProj h n y = 0 ↔ y ∈ kerIdeal M h n :=
  Ideal.Quotient.eq_zero_iff_mem

/-- The tautological point of the candidate kernel algebra. -/
def kerPoint (h : Hom M Q) (n : ℕ) : M.AlgebraPoint (kerAlg h n) :=
  M.algebraMapPoints (kerProj h n) (truncPoint M n)

theorem kerPoint_mem (h : Hom M Q) (n : ℕ) : h.onAlgebraPoints (kerPoint h n) = 0 := by
  refine ext_coord fun j => ?_
  rw [kerPoint, ← Hom.onAlgebraPoints_natural, coord_algebraMapPoints, coord_zero,
    kerProj_eq_zero_iff]
  exact Ideal.subset_span ⟨j, rfl⟩

/-- Maps out of the candidate kernel algebra are determined by the image of its point. -/
theorem kerAlg_hom_ext {h : Hom M Q} {n : ℕ} {A : CommAlgCat.{v} R} {χ χ' : kerAlg h n →ₐ[R] A}
    (hχ : M.algebraMapPoints χ (kerPoint h n) = M.algebraMapPoints χ' (kerPoint h n)) :
    χ = χ' := by
  have h2 : (χ.comp (kerProj h n)).comp (truncProj R σ n) =
      (χ'.comp (kerProj h n)).comp (truncProj R σ n) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    have := congrArg (fun z => coord M z i) hχ
    simpa only [kerPoint, coord_algebraMapPoints, coord_truncPoint, AlgHom.comp_apply] using this
  refine AlgHom.ext fun y => ?_
  obtain ⟨y, rfl⟩ := kerProj_surjective h n y
  obtain ⟨p, rfl⟩ := truncProj_surjective n y
  exact DFunLike.congr_fun h2 p

variable {h : Hom M Q} {n : ℕ}
  (hn : ∀ (A : CommAlgCat.{v} R) (x : M.AlgebraPoint A), h.onAlgebraPoints x = 0 →
    ∀ i, coord M x i ^ n = 0)

include hn in
/-- The map out of the candidate kernel algebra classifying a kernel point. -/
def kerLift {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A) (hx : h.onAlgebraPoints x = 0) :
    kerAlg h n →ₐ[R] A :=
  Ideal.Quotient.liftₐ (kerIdeal M h n) (truncLift x (hn A x hx)) (by
    have hle : kerIdeal M h n ≤ RingHom.ker (truncLift x (hn A x hx)) := by
      rw [kerIdeal, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, ← coord_algebraMapPoints,
        Hom.onAlgebraPoints_natural, truncLift_point, hx, coord_zero]
    exact fun a ha => RingHom.mem_ker.mp (hle ha))

include hn in
theorem kerLift_comp {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : h.onAlgebraPoints x = 0) :
    (kerLift hn x hx).comp (kerProj h n) = truncLift x (hn A x hx) :=
  Ideal.Quotient.liftₐ_comp _ _ _

include hn in
theorem kerLift_point {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A)
    (hx : h.onAlgebraPoints x = 0) :
    M.algebraMapPoints (kerLift hn x hx) (kerPoint h n) = x := by
  rw [kerPoint, ← algebraMapPoints_comp, kerLift_comp, truncLift_point]

include hn in
/-- Under a uniform nilpotence bound, the candidate algebra corepresents the actual kernel. -/
def kerRepresents : h.kernelSetFunctor.CorepresentableBy (kerAlg h n) where
  homEquiv := {
    toFun := fun χ => kernelMk h (M.algebraMapPoints χ.hom (kerPoint h n)) (by
      rw [← Hom.onAlgebraPoints_natural, kerPoint_mem, map_zero])
    invFun := fun x => homOf (kerLift hn (kernelVal x) (kernelVal_property x))
    left_inv := fun χ => by
      dsimp only
      apply CommAlgCat.hom_ext
      apply kerAlg_hom_ext
      rw [hom_homOf, kerLift_point, kernelVal_kernelMk]
    right_inv := fun x => by
      dsimp only
      apply kernelVal_injective
      rw [kernelVal_kernelMk, hom_homOf, kerLift_point] }
  homEquiv_comp := fun ψ χ => by
    apply kernelVal_injective
    change M.algebraMapPoints (χ ≫ ψ).hom (kerPoint h n) =
      M.algebraMapPoints ψ.hom (M.algebraMapPoints χ.hom (kerPoint h n))
    rw [CommAlgCat.hom_comp, algebraMapPoints_comp]

theorem universalPoint_kerRepresents : universalPoint (kerRepresents hn) = kerPoint h n := by
  change M.algebraMapPoints (𝟙 (kerAlg h n) : kerAlg h n ⟶ kerAlg h n).hom (kerPoint h n) =
    kerPoint h n
  rw [CommAlgCat.hom_id, algebraMapPoints_id]

end Presentation

section Classify

/-- The algebra homomorphism out of a corepresenting algebra that classifies a kernel point. -/
def classify {f : Hom M N} {X : CommAlgCat.{v} R} (E : f.kernelSetFunctor.CorepresentableBy X)
    {A : CommAlgCat.{v} R} (x : M.AlgebraPoint A) (hx : f.onAlgebraPoints x = 0) :
    X →ₐ[R] A :=
  (E.homEquiv.symm (kernelMk f x hx)).hom

theorem classify_point {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) {A : CommAlgCat.{v} R}
    (x : M.AlgebraPoint A) (hx : f.onAlgebraPoints x = 0) :
    M.algebraMapPoints (classify E x hx) (universalPoint E) = x :=
  homEquiv_symm_spec E x hx

/-- Algebra homomorphisms out of a corepresenting algebra are determined by the universal
point. -/
theorem algHom_ext_of_universalPoint {f : Hom M N} {X : CommAlgCat.{v} R}
    (E : f.kernelSetFunctor.CorepresentableBy X) {A : CommAlgCat.{v} R} {χ χ' : X →ₐ[R] A}
    (h : M.algebraMapPoints χ (universalPoint E) = M.algebraMapPoints χ' (universalPoint E)) :
    χ = χ' :=
  congrArg CommAlgCat.Hom.hom (hom_ext_of_universalPoint E (χ := homOf χ) (χ' := homOf χ') h)

end Classify

section Descent

variable (S : Type v) [CommRing S] [Algebra R S] (B C : CommAlgCat.{v} R)
  [Algebra S B] [Algebra S C] [IsScalarTower R S B] [IsScalarTower R S C]

/-- The tensor product of two algebras over an intermediate algebra, in `CommAlgCat`. -/
def tensorObj : CommAlgCat.{v} R :=
  CommAlgCat.of R (B ⊗[S] C)

/-- The left inclusion into the tensor product. -/
def tensorInl : B →ₐ[R] tensorObj S B C :=
  Algebra.TensorProduct.includeLeft

/-- The right inclusion into the tensor product. -/
def tensorInr : C →ₐ[R] tensorObj S B C :=
  { (Algebra.TensorProduct.includeRight : C →ₐ[S] B ⊗[S] C).toRingHom with
    commutes' := fun r => by
      show (1 : B) ⊗ₜ[S] algebraMap R C r = algebraMap R B r ⊗ₜ[S] (1 : C)
      rw [IsScalarTower.algebraMap_apply R S C, IsScalarTower.algebraMap_apply R S B]
      exact (Algebra.TensorProduct.tmul_one_eq_one_tmul _).symm }

variable {S B C}

omit [IsScalarTower R S C] in
theorem tensorInl_apply (b : B) : tensorInl S B C b = (b ⊗ₜ[S] (1 : C) : B ⊗[S] C) :=
  rfl

theorem tensorInr_apply (c : C) : tensorInr S B C c = ((1 : B) ⊗ₜ[S] c : B ⊗[S] C) :=
  rfl

theorem tensorInl_comp_toAlgHom :
    (tensorInl S B C).comp (IsScalarTower.toAlgHom R S B) =
      (tensorInr S B C).comp (IsScalarTower.toAlgHom R S C) :=
  AlgHom.ext fun s => Algebra.TensorProduct.tmul_one_eq_one_tmul (R := S) (A := B) (B := C) s

variable {f : Hom M N} {g : Hom N P}

/-- After base change along a lift of the universal point of the kernel of `g`, the coordinate
algebra of the composite kernel becomes the base change of the coordinate algebra of the kernel
of `f`. -/
theorem nonempty_tensor_equiv (K : Hom.FiniteKernelModel f) (L : Hom.FiniteKernelModel g)
    (E : (g.comp f).kernelSetFunctor.CorepresentableBy C)
    [Algebra L.coordinateAlgebra B] [IsScalarTower R L.coordinateAlgebra B]
    [Algebra L.coordinateAlgebra C] [IsScalarTower R L.coordinateAlgebra C]
    (x0 : M.AlgebraPoint B)
    (hx0 : f.onAlgebraPoints x0 = N.algebraMapPoints
      (IsScalarTower.toAlgHom R L.coordinateAlgebra B) (universalPoint L.represents))
    (hρ : N.algebraMapPoints (IsScalarTower.toAlgHom R L.coordinateAlgebra C)
      (universalPoint L.represents) = f.onAlgebraPoints (universalPoint E)) :
    Nonempty (B ⊗[L.coordinateAlgebra] C ≃ₗ[B] B ⊗[R] K.coordinateAlgebra) := by
  -- the two inclusions into each tensor product
  have hsq := tensorInl_comp_toAlgHom (S := L.coordinateAlgebra) (B := B) (C := C)
  -- the point of the composite kernel over `B ⊗[R] K`
  have hp2 : f.onAlgebraPoints
      (M.algebraMapPoints (tensorInr R B K.coordinateAlgebra) (universalPoint K.represents) +
        M.algebraMapPoints (tensorInl R B K.coordinateAlgebra) x0) =
      N.algebraMapPoints ((tensorInl R B K.coordinateAlgebra).comp
        (IsScalarTower.toAlgHom R L.coordinateAlgebra B)) (universalPoint L.represents) := by
    rw [map_add, ← Hom.onAlgebraPoints_natural, ← Hom.onAlgebraPoints_natural,
      universalPoint_property K.represents, map_zero, zero_add, hx0, algebraMapPoints_comp]
  have hp2' : (g.comp f).onAlgebraPoints
      (M.algebraMapPoints (tensorInr R B K.coordinateAlgebra) (universalPoint K.represents) +
        M.algebraMapPoints (tensorInl R B K.coordinateAlgebra) x0) = 0 := by
    rw [Hom.onAlgebraPoints_comp, hp2, ← Hom.onAlgebraPoints_natural,
      universalPoint_property L.represents, map_zero]
  -- the point of the kernel of `f` over `B ⊗[L] C`
  have hp1 : f.onAlgebraPoints
      (M.algebraMapPoints (tensorInr L.coordinateAlgebra B C) (universalPoint E) -
        M.algebraMapPoints (tensorInl L.coordinateAlgebra B C) x0) = 0 := by
    rw [map_sub, ← Hom.onAlgebraPoints_natural, ← Hom.onAlgebraPoints_natural, ← hρ, hx0,
      ← algebraMapPoints_comp, ← algebraMapPoints_comp, hsq, sub_self]
  set v := classify E _ hp2' with hv_def
  set k := classify K.represents _ hp1 with hk_def
  have hv : M.algebraMapPoints v (universalPoint E) = _ := classify_point E _ hp2'
  have hk : M.algebraMapPoints k (universalPoint K.represents) = _ :=
    classify_point K.represents _ hp1
  -- compatibility of `v` with the `L`-algebra structures
  have hvL : v.comp (IsScalarTower.toAlgHom R L.coordinateAlgebra C) =
      (tensorInl R B K.coordinateAlgebra).comp
        (IsScalarTower.toAlgHom R L.coordinateAlgebra B) := by
    apply algHom_ext_of_universalPoint L.represents
    rw [algebraMapPoints_comp, hρ, Hom.onAlgebraPoints_natural, hv, hp2]
  let vL : C →ₐ[L.coordinateAlgebra] B ⊗[R] K.coordinateAlgebra :=
    { v.toRingHom with commutes' := fun r => DFunLike.congr_fun hvL r }
  -- the comparison maps in both directions
  obtain ⟨αR, hαR⟩ : ∃ αR : tensorObj R B K.coordinateAlgebra →ₐ[R]
      tensorObj L.coordinateAlgebra B C,
      ∀ (b : B) (y : K.coordinateAlgebra),
        αR (b ⊗ₜ[R] y) = tensorInl L.coordinateAlgebra B C b * k y :=
    ⟨Algebra.TensorProduct.lift (tensorInl L.coordinateAlgebra B C) k
      (fun _ _ => Commute.all _ _), fun _ _ => rfl⟩
  obtain ⟨β0, hβ0⟩ : ∃ β0 : B ⊗[L.coordinateAlgebra] C →ₐ[L.coordinateAlgebra]
      B ⊗[R] K.coordinateAlgebra,
      ∀ (b : B) (c : C), β0 (b ⊗ₜ[L.coordinateAlgebra] c) =
        (b ⊗ₜ[R] (1 : K.coordinateAlgebra)) * vL c :=
    ⟨Algebra.TensorProduct.lift Algebra.TensorProduct.includeLeft vL
      (fun _ _ => Commute.all _ _), fun _ _ => rfl⟩
  obtain ⟨βR, hβR⟩ : ∃ βR : tensorObj L.coordinateAlgebra B C →ₐ[R]
      tensorObj R B K.coordinateAlgebra,
      ∀ (b : B) (c : C), βR (b ⊗ₜ[L.coordinateAlgebra] c) =
        tensorInl R B K.coordinateAlgebra b * v c :=
    ⟨{ β0.toRingHom with
        commutes' := fun r => by
          show β0 (algebraMap R B r ⊗ₜ[L.coordinateAlgebra] (1 : C)) =
            algebraMap R B r ⊗ₜ[R] (1 : K.coordinateAlgebra)
          rw [hβ0, map_one, mul_one] }, hβ0⟩
  have hαK : αR.comp (tensorInr R B K.coordinateAlgebra) = k := AlgHom.ext fun y => by
    rw [AlgHom.comp_apply, tensorInr_apply, hαR, map_one, one_mul]
  have hαB : αR.comp (tensorInl R B K.coordinateAlgebra) = tensorInl L.coordinateAlgebra B C :=
    AlgHom.ext fun b => by
      rw [AlgHom.comp_apply, tensorInl_apply, hαR, map_one, mul_one]
  have hβC : βR.comp (tensorInr L.coordinateAlgebra B C) = v := AlgHom.ext fun c => by
    rw [AlgHom.comp_apply, tensorInr_apply, hβR, map_one, one_mul]
  have hβB : βR.comp (tensorInl L.coordinateAlgebra B C) = tensorInl R B K.coordinateAlgebra :=
    AlgHom.ext fun b => by
      rw [AlgHom.comp_apply, tensorInl_apply, hβR, map_one, mul_one]
  have hαv : αR.comp v = tensorInr L.coordinateAlgebra B C := by
    apply algHom_ext_of_universalPoint E
    rw [algebraMapPoints_comp, hv, map_add, ← algebraMapPoints_comp, ← algebraMapPoints_comp,
      hαK, hαB, hk, sub_add_cancel]
  have hβk : βR.comp k = tensorInr R B K.coordinateAlgebra := by
    apply algHom_ext_of_universalPoint K.represents
    rw [algebraMapPoints_comp, hk, map_sub, ← algebraMapPoints_comp, ← algebraMapPoints_comp,
      hβC, hβB, hv, add_sub_cancel_right]
  have h1 : βR.comp αR = AlgHom.id R _ := by
    refine AlgHom.coe_ringHom_injective (Algebra.TensorProduct.ringHom_ext
      (RingHom.ext fun b => ?_) (RingHom.ext fun y => ?_))
    · show βR (αR (tensorInl R B K.coordinateAlgebra b)) = tensorInl R B K.coordinateAlgebra b
      rw [← AlgHom.comp_apply αR, hαB, ← AlgHom.comp_apply βR, hβB]
    · show βR (αR (tensorInr R B K.coordinateAlgebra y)) = tensorInr R B K.coordinateAlgebra y
      rw [← AlgHom.comp_apply αR, hαK, ← AlgHom.comp_apply βR, hβk]
  have h2 : αR.comp βR = AlgHom.id R _ := by
    refine AlgHom.coe_ringHom_injective (Algebra.TensorProduct.ringHom_ext
      (RingHom.ext fun b => ?_) (RingHom.ext fun c => ?_))
    · show αR (βR (tensorInl L.coordinateAlgebra B C b)) = tensorInl L.coordinateAlgebra B C b
      rw [← AlgHom.comp_apply βR, hβB, ← AlgHom.comp_apply αR, hαB]
    · show αR (βR (tensorInr L.coordinateAlgebra B C c)) = tensorInr L.coordinateAlgebra B C c
      rw [← AlgHom.comp_apply βR, hβC, ← AlgHom.comp_apply αR, hαv]
  refine ⟨
    { toFun := βR
      invFun := αR
      map_add' := map_add βR
      map_smul' := fun b x => ?_
      left_inv := fun x => DFunLike.congr_fun h2 x
      right_inv := fun y => DFunLike.congr_fun h1 y }⟩
  rw [RingHom.id_apply, Algebra.smul_def]
  exact (map_mul βR _ _).trans ((congrArg (· * βR x) (DFunLike.congr_fun hβB b)).trans
    (Algebra.smul_def (A := B ⊗[R] K.coordinateAlgebra) b (βR x)).symm)

end Descent

end FiniteKernelComposition

namespace Hom

open FiniteKernelComposition

variable (M : ModuleLaw O R σ) (N : ModuleLaw O R τ) (P : ModuleLaw O R υ)

/-- The composite of two maps of formal modules, the first with affine fppf local lifting, has
a finite projective kernel model whose rank is pointwise the product of the ranks of the two
given kernel models. -/
theorem finiteKernelCompositionStatement : FiniteKernelCompositionStatement M N P := by
  intro f g hf K L
  obtain ⟨n, hn⟩ := exists_comp_kernel_bound hf K L
  obtain ⟨B, φ, hφ, -, x0, hx0⟩ := hf L.coordinateAlgebra (universalPoint L.represents)
  let E := kerRepresents (h := g.comp f) hn
  have hfu : g.onAlgebraPoints (f.onAlgebraPoints (universalPoint E)) = 0 := by
    rw [← Hom.onAlgebraPoints_comp]
    exact universalPoint_property E
  let ρ := classify L.represents _ hfu
  have hρ : N.algebraMapPoints ρ (universalPoint L.represents) =
      f.onAlgebraPoints (universalPoint E) :=
    classify_point L.represents _ hfu
  let _ : Algebra L.coordinateAlgebra B := φ.hom.toRingHom.toAlgebra
  let _ : Algebra L.coordinateAlgebra (kerAlg (g.comp f) n) := ρ.toRingHom.toAlgebra
  have : IsScalarTower R L.coordinateAlgebra B :=
    IsScalarTower.of_algebraMap_eq' φ.hom.comp_algebraMap.symm
  have : IsScalarTower R L.coordinateAlgebra (kerAlg (g.comp f) n) :=
    IsScalarTower.of_algebraMap_eq' ρ.comp_algebraMap.symm
  have : Module.FaithfullyFlat L.coordinateAlgebra B := hφ
  have htoB : IsScalarTower.toAlgHom R L.coordinateAlgebra B = φ.hom := AlgHom.ext fun _ => rfl
  have htoC : IsScalarTower.toAlgHom R L.coordinateAlgebra (kerAlg (g.comp f) n) = ρ :=
    AlgHom.ext fun _ => rfl
  obtain ⟨e⟩ := nonempty_tensor_equiv K L E x0 (by rw [htoB]; exact hx0)
    (by rw [htoC]; exact hρ)
  obtain ⟨hfin, hflat, hrank⟩ := FiniteFlatRank.descent_of_tensor_equiv e
  have : Module.Finite R (kerAlg (g.comp f) n) := Module.Finite.trans L.coordinateAlgebra _
  have : Module.Flat R (kerAlg (g.comp f) n) := Module.Flat.trans R L.coordinateAlgebra _
  have : Module.FinitePresentation R (kerAlg (g.comp f) n) :=
    Module.FinitePresentation.of_finite_of_finitePresentation R _
  have : Module.Projective R (kerAlg (g.comp f) n) := Module.Flat.projective_of_finitePresentation
  refine ⟨⟨kerAlg (g.comp f) n, inferInstance, inferInstance, E⟩, fun p => ?_⟩
  exact FiniteFlatRank.rankAtStalk_eq_mul_of_tower p (K.rank p)
    (fun q hq => (hrank q).trans (congrArg (Module.rankAtStalk K.coordinateAlgebra) hq))

end Hom

end Langlands.FormalGroup.ModuleLaw
