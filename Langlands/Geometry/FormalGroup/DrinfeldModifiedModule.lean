import Mathlib.LinearAlgebra.Pi
import Mathlib.LinearAlgebra.Quotient.Basic

/-! # The quotient defining the modified Dieudonné module -/

noncomputable section

open scoped BigOperators

namespace Langlands.FormalGroup.Drinfeld

variable {O M : Type*} [CommRing O] [AddCommGroup M] [Module O M]
variable (n : ℕ) (V P : Module.End O M)

/-- Insert the adjacent relation with entries `V x` and `-(P x)`. -/
def adjacentRelation (i : Fin n) : M →ₗ[O] (Fin (n + 1) → M) :=
  (LinearMap.single O (fun _ => M) i.castSucc).comp V -
    (LinearMap.single O (fun _ => M) i.succ).comp P

/-- The submodule generated by the adjacent relations. -/
def modifiedRelations : Submodule O (Fin (n + 1) → M) :=
  ⨆ i : Fin n, LinearMap.range (adjacentRelation n V P i)

theorem adjacentRelation_mem (i : Fin n) (x : M) :
    adjacentRelation n V P i x ∈ modifiedRelations n V P :=
  le_iSup (fun i => LinearMap.range (adjacentRelation n V P i)) i
    (LinearMap.mem_range_self _ x)

private theorem modifiedRelations_le {Q : Submodule O (Fin (n + 1) → M)}
    (h : ∀ i x, adjacentRelation n V P i x ∈ Q) : modifiedRelations n V P ≤ Q := by
  refine iSup_le fun i => ?_
  rintro _ ⟨x, rfl⟩
  exact h i x

/-- The modified module is the quotient of `n + 1` copies by the adjacent relations. -/
abbrev ModifiedModule := (Fin (n + 1) → M) ⧸ modifiedRelations n V P

namespace ModifiedModule

/-- Insert an element into a selected slot and take its class in the modified module. -/
def slot (i : Fin (n + 1)) : M →ₗ[O] ModifiedModule n V P :=
  (modifiedRelations n V P).mkQ.comp (LinearMap.single O (fun _ => M) i)

theorem slot_adjacent (i : Fin n) (x : M) :
    slot n V P i.castSucc (V x) = slot n V P i.succ (P x) := by
  have h := adjacentRelation_mem n V P i x
  rw [← (modifiedRelations n V P).ker_mkQ, LinearMap.mem_ker] at h
  simpa only [adjacentRelation, LinearMap.sub_apply, LinearMap.comp_apply, map_sub,
    sub_eq_zero, slot] using h

private def weightedSum : (Fin (n + 1) → M) →ₗ[O] M :=
  ∑ i : Fin (n + 1), (P ^ (n - i.val) * V ^ i.val).comp (LinearMap.proj i)

private theorem weightedSum_single (i : Fin (n + 1)) (x : M) :
    weightedSum n V P (Pi.single i x) = (P ^ (n - i.val) * V ^ i.val) x := by
  simp only [weightedSum, LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    simp [Pi.single_eq_of_ne hj]
  · simp

/-- The weighted sum of the slots descends to the modified module. -/
def toDieudonne (hcomm : Commute P V) : ModifiedModule n V P →ₗ[O] M :=
  (modifiedRelations n V P).liftQ (weightedSum n V P)
    (modifiedRelations_le n V P (by
      intro i x
      rw [LinearMap.mem_ker]
      change weightedSum n V P (Pi.single i.castSucc (V x) - Pi.single i.succ (P x)) = 0
      rw [map_sub, weightedSum_single, weightedSum_single, sub_eq_zero]
      have hidx : n - i.val = n - (i.val + 1) + 1 := by have hi := i.isLt; omega
      have hop : (P ^ (n - i.val) * V ^ i.val) * V =
          (P ^ (n - (i.val + 1)) * V ^ (i.val + 1)) * P := by
        calc
          (P ^ (n - i.val) * V ^ i.val) * V = P ^ (n - i.val) * V ^ (i.val + 1) := by
            rw [pow_succ, mul_assoc]
          _ = (P ^ (n - (i.val + 1)) * P) * V ^ (i.val + 1) := by
            rw [← pow_succ, hidx]
          _ = (P ^ (n - (i.val + 1)) * V ^ (i.val + 1)) * P := by
            rw [mul_assoc, (hcomm.pow_right _).eq, ← mul_assoc]
      exact LinearMap.congr_fun hop x))

@[simp]
theorem toDieudonne_mkQ (hcomm : Commute P V) (x : Fin (n + 1) → M) :
    toDieudonne n V P hcomm ((modifiedRelations n V P).mkQ x) =
      ∑ i : Fin (n + 1), (P ^ (n - i.val) * V ^ i.val) (x i) := by
  change weightedSum n V P x = _
  simp only [weightedSum, LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply]

@[simp]
theorem toDieudonne_slot (hcomm : Commute P V) (i : Fin (n + 1)) (x : M) :
    toDieudonne n V P hcomm (slot n V P i x) = (P ^ (n - i.val) * V ^ i.val) x :=
  weightedSum_single n V P i x

/-- The first coordinate modulo the range of Verschiebung. -/
def toTangent : ModifiedModule n V P →ₗ[O] (M ⧸ LinearMap.range V) := by
  refine (modifiedRelations n V P).liftQ
    ((LinearMap.range V).mkQ.comp (LinearMap.proj 0)) (modifiedRelations_le n V P ?_)
  intro i x
  rw [LinearMap.mem_ker]
  change (LinearMap.range V).mkQ
    ((Pi.single i.castSucc (V x) : Fin (n + 1) → M) 0 -
      (Pi.single i.succ (P x) : Fin (n + 1) → M) 0) = 0
  rw [Pi.single_eq_of_ne (Fin.succ_ne_zero i).symm, sub_zero]
  by_cases hi : (0 : Fin (n + 1)) = i.castSucc
  · rw [← hi, Pi.single_eq_same, ← LinearMap.mem_ker, Submodule.ker_mkQ]
    exact LinearMap.mem_range_self V x
  · rw [Pi.single_eq_of_ne hi, map_zero]

@[simp]
theorem toTangent_mkQ (x : Fin (n + 1) → M) :
    toTangent n V P ((modifiedRelations n V P).mkQ x) = (LinearMap.range V).mkQ (x 0) := rfl

theorem toTangent_surjective : Function.Surjective (toTangent n V P) := by
  intro y
  obtain ⟨x, rfl⟩ := (LinearMap.range V).mkQ_surjective y
  refine ⟨slot n V P 0 x, ?_⟩
  change (LinearMap.range V).mkQ ((Pi.single 0 x : Fin (n + 1) → M) 0) = _
  rw [Pi.single_eq_same]

section Map

variable {M' : Type*} [AddCommGroup M'] [Module O M']
  {V' P' : Module.End O M'} (f : M →ₗ[O] M')

private theorem map_adjacentRelation
    (hV : ∀ x, f (V x) = V' (f x)) (hP : ∀ x, f (P x) = P' (f x)) (i : Fin n) (x : M) :
    f.compLeft (Fin (n + 1)) (adjacentRelation n V P i x) =
      adjacentRelation n V' P' i (f x) := by
  funext j
  change f ((Pi.single i.castSucc (V x) : Fin (n + 1) → M) j -
      (Pi.single i.succ (P x) : Fin (n + 1) → M) j) =
    (Pi.single i.castSucc (V' (f x)) : Fin (n + 1) → M') j -
      (Pi.single i.succ (P' (f x)) : Fin (n + 1) → M') j
  rw [map_sub, LinearMap.apply_single (fun _ : Fin (n + 1) => f),
    LinearMap.apply_single (fun _ : Fin (n + 1) => f), hV, hP]

/-- A linear map intertwining the two operators acts on the modified modules. -/
def map (hV : ∀ x, f (V x) = V' (f x)) (hP : ∀ x, f (P x) = P' (f x)) :
    ModifiedModule n V P →ₗ[O] ModifiedModule n V' P' :=
  (modifiedRelations n V P).mapQ (modifiedRelations n V' P') (f.compLeft (Fin (n + 1)))
    (modifiedRelations_le n V P (by
      intro i x
      rw [Submodule.mem_comap, map_adjacentRelation n V P f hV hP]
      exact adjacentRelation_mem n V' P' i (f x)))

variable (hV : ∀ x, f (V x) = V' (f x)) (hP : ∀ x, f (P x) = P' (f x))

@[simp]
theorem map_mkQ (x : Fin (n + 1) → M) :
    map n V P f hV hP ((modifiedRelations n V P).mkQ x) =
      (modifiedRelations n V' P').mkQ (fun i => f (x i)) := rfl

theorem map_surjective (hf : Function.Surjective f) :
    Function.Surjective (map n V P f hV hP) := by
  intro y
  obtain ⟨y, rfl⟩ := (modifiedRelations n V' P').mkQ_surjective y
  choose x hx using fun i => hf (y i)
  refine ⟨(modifiedRelations n V P).mkQ x, ?_⟩
  rw [map_mkQ, show (fun i => f (x i)) = y from funext hx]

end Map

end ModifiedModule

end Langlands.FormalGroup.Drinfeld
