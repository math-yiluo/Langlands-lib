import Langlands.Geometry.FormalGroup.NilpotentAlgebras
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.Algebra.DirectSum.Module
import Mathlib.Data.ZMod.Basic

/-! # The cyclically graded coefficient algebra in Deligne's construction -/

noncomputable section

universe u v

namespace Langlands.DeligneFormalSpace

open Polynomial CategoryTheory Module

variable (d : ℕ)
variable {A : Type v} [CommRing A]

/-- The actual defining polynomial for the distinguished degree-one operator. -/
def piRelation (a : A) : A[X] := X ^ d - C a

/-- The algebra denoted by B[Π] in Drinfeld's description of Deligne's functor. -/
abbrev PiAlgebra (a : A) := AdjoinRoot (piRelation d a)

namespace PiAlgebra

variable {d} {a : A}

/-- The residue class of X, which acts in degree one. -/
def pi (d : ℕ) (a : A) : PiAlgebra d a := AdjoinRoot.root (piRelation d a)

@[simp]
theorem pi_pow : pi d a ^ d = algebraMap A (PiAlgebra d a) a := by
  apply sub_eq_zero.mp
  change AdjoinRoot.root (piRelation d a) ^ d - AdjoinRoot.of (piRelation d a) a = 0
  have h := AdjoinRoot.eval₂_root (piRelation d a)
  rw [piRelation, Polynomial.eval₂_sub, Polynomial.eval₂_pow,
    Polynomial.eval₂_X, Polynomial.eval₂_C] at h
  exact h

/-- Nilpotence of the base uniformizer forces nilpotence of Π itself. -/
theorem isNilpotent_pi (ha : IsNilpotent a) : IsNilpotent (pi d a) := by
  apply IsNilpotent.of_pow (m := d)
  rw [pi_pow]
  exact ha.map (algebraMap A (PiAlgebra d a))

variable [NeZero d]

theorem relation_monic (a : A) : (piRelation d a).Monic :=
  Polynomial.monic_X_pow_sub_C a (NeZero.ne d)

/-- The distinguished power basis, indexed by the actual cyclic grading group. -/
def basis (d : ℕ) [NeZero d] (a : A) : Basis (ZMod d) A (PiAlgebra d a) := by
  classical
  by_cases h : Nontrivial A
  · letI := h
    have hn : (piRelation d a).natDegree = d := Polynomial.natDegree_X_pow_sub_C
    exact (((AdjoinRoot.powerBasis' (relation_monic a)).basis).reindex (finCongr hn)).reindex
      (ZMod.finEquiv d).toEquiv
  · haveI : Subsingleton A := not_nontrivial_iff_subsingleton.mp h
    haveI := Module.subsingleton A (PiAlgebra d a)
    exact Basis.ofEquivFun (LinearEquiv.ofSubsingleton _ _)

@[simp]
theorem basis_apply (i : ZMod d) : basis d a i = pi d a ^ i.val := by
  classical
  by_cases h : Nontrivial A
  · have : Nontrivial A := h
    simp only [basis, dite_eq_left h, Basis.reindex_apply, PowerBasis.basis_eq_pow,
      AdjoinRoot.powerBasis'_gen]
    congr 1
    cases d with
    | zero => exact (NeZero.ne 0 rfl).elim
    | succ n => rfl
  · have : Subsingleton A := not_nontrivial_iff_subsingleton.mp h
    have := Module.subsingleton A (PiAlgebra d a)
    exact Subsingleton.elim _ _

instance : Module.Free A (PiAlgebra d a) := Module.Free.of_basis (basis d a)

instance : Module.Finite A (PiAlgebra d a) := Module.Finite.of_basis (basis d a)

/-- The degree-i summand is the A-line generated by the corresponding power of Π. -/
def component (i : ZMod d) : Submodule A (PiAlgebra d a) :=
  A ∙ (pi d a ^ i.val)

/-- The homogeneous components are an actual internal direct sum. -/
theorem isInternal_component :
    DirectSum.IsInternal (component (d := d) (a := a)) := by
  classical
  apply (DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top _).mpr
  have hc : component (d := d) (a := a) =
      fun i : ZMod d => A ∙ (basis d a i) := by
    funext i
    rw [component, basis_apply]
  rw [hc]
  exact ⟨(basis d a).linearIndependent.iSupIndep_span_singleton,
    by rw [← Submodule.span_range_eq_iSup, (basis d a).span_eq]⟩

omit [NeZero d] in
/-- Reduction of powers records the scalar introduced on passing around the cycle. -/
theorem pow_reduce (n : ℕ) :
    pi d a ^ n = a ^ (n / d) • pi d a ^ (n % d) := by
  calc
    pi d a ^ n = pi d a ^ (n % d + d * (n / d)) := by rw [Nat.mod_add_div]
    _ = pi d a ^ (n % d) * (pi d a ^ d) ^ (n / d) := by rw [pow_add, pow_mul]
    _ = a ^ (n / d) • pi d a ^ (n % d) := by
      rw [pi_pow, Algebra.smul_def, map_pow, mul_comm]

omit [NeZero d] in
theorem one_mem_component :
    (1 : PiAlgebra d a) ∈ component (d := d) (a := a) 0 := by
  apply Submodule.subset_span
  simp

/-- Multiplication adds the cyclic degrees, including the factor a at a wrap. -/
theorem mul_mem_component {i j : ZMod d} {x y : PiAlgebra d a}
    (hx : x ∈ component (d := d) (a := a) i)
    (hy : y ∈ component (d := d) (a := a) j) :
    x * y ∈ component (d := d) (a := a) (i + j) := by
  obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
  obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.mp hy
  rw [smul_mul_smul_comm, ← pow_add, pow_reduce, smul_smul, ← ZMod.val_add]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

omit [NeZero d] in
/-- Π belongs to degree one even when the cyclic grading group is trivial. -/
theorem pi_mem_component :
    pi d a ∈ component (d := d) (a := a) 1 := by
  have h := pow_reduce (d := d) (a := a) 1
  rw [pow_one] at h
  rw [h]
  apply Submodule.smul_mem
  apply Submodule.subset_span
  simp only [Set.mem_singleton_iff, ZMod.val_one_eq_one_mod]

end PiAlgebra

section Functoriality

variable {O : Type u} [CommRing O]
variable {B : Type v} [CommRing B] [Algebra O A] [Algebra O B]
variable (π : O)

/-- A coefficient map acts on the actual quotient algebra and preserves Π. -/
def piAlgebraMap (φ : A →ₐ[O] B) :
    PiAlgebra d (algebraMap O A π) →ₐ[O] PiAlgebra d (algebraMap O B π) :=
  AdjoinRoot.mapAlgHom φ _ _ (by
    change piRelation d (algebraMap O B π) ∣
      (piRelation d (algebraMap O A π)).map φ.toRingHom
    have h : (piRelation d (algebraMap O A π)).map φ.toRingHom =
        piRelation d (algebraMap O B π) := by
      simp only [piRelation, Polynomial.map_sub, Polynomial.map_pow,
        Polynomial.map_X, Polynomial.map_C]
      change X ^ d - C (φ (algebraMap O A π)) = X ^ d - C (algebraMap O B π)
      rw [φ.commutes]
    exact h.symm.dvd)

@[simp]
theorem piAlgebraMap_pi (φ : A →ₐ[O] B) :
    piAlgebraMap d π φ (PiAlgebra.pi d (algebraMap O A π)) =
      PiAlgebra.pi d (algebraMap O B π) := by
  simp [piAlgebraMap, PiAlgebra.pi]

@[simp]
theorem piAlgebraMap_algebraMap (φ : A →ₐ[O] B) (a : A) :
    piAlgebraMap d π φ (algebraMap A _ a) = algebraMap B _ (φ a) := by
  simp [piAlgebraMap, AdjoinRoot.algebraMap_eq]

@[simp]
theorem piAlgebraMap_id :
    piAlgebraMap d π (AlgHom.id O A) = AlgHom.id O _ := by
  apply AdjoinRoot.algHom_ext'
  · ext a
    exact piAlgebraMap_algebraMap d π (AlgHom.id O A) a
  · exact piAlgebraMap_pi d π (AlgHom.id O A)

variable {C : Type v} [CommRing C] [Algebra O C]

theorem piAlgebraMap_comp (φ : A →ₐ[O] B) (ψ : B →ₐ[O] C) :
    (piAlgebraMap d π ψ).comp (piAlgebraMap d π φ) =
      piAlgebraMap d π (ψ.comp φ) := by
  apply AdjoinRoot.algHom_ext'
  · ext a
    change piAlgebraMap d π ψ (piAlgebraMap d π φ (algebraMap A _ a)) =
      piAlgebraMap d π (ψ.comp φ) (algebraMap A _ a)
    simp only [piAlgebraMap_algebraMap, AlgHom.comp_apply]
  · change piAlgebraMap d π ψ
        (piAlgebraMap d π φ (PiAlgebra.pi d (algebraMap O A π))) =
      piAlgebraMap d π (ψ.comp φ) (PiAlgebra.pi d (algebraMap O A π))
    simp only [piAlgebraMap_pi]

/-- The functor B ↦ B[Π]/(Π^d-π), with its structural O-algebra. -/
def piAlgebraFunctor : CommAlgCat.{v} O ⥤ CommAlgCat.{v} O where
  obj B := CommAlgCat.of O (PiAlgebra d (algebraMap O B π))
  map f := CommAlgCat.ofHom (piAlgebraMap d π f.hom)
  map_id B := by
    apply CommAlgCat.hom_ext
    exact piAlgebraMap_id d π
  map_comp f g := by
    apply CommAlgCat.hom_ext
    exact (piAlgebraMap_comp d π f.hom g.hom).symm

/-- Restrict the constructed coefficient algebra functor to actual Nilp algebras. -/
def nilpPiAlgebraFunctor :
    FormalGroup.Nilp.{u, v} O π ⥤ CommAlgCat.{v} O :=
  FormalGroup.Nilp.forget O π ⋙ piAlgebraFunctor d π

end Functoriality

end Langlands.DeligneFormalSpace
