import Langlands.Geometry.ModuleExteriorStalk
import Langlands.Geometry.ModuleSheafSubmodule
import Langlands.Geometry.FormalGroup.DeligneDeterminantLattice

/-! # Actual exterior subsheaves of integral images -/

noncomputable section

universe u

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

namespace Langlands.DeligneFormalSpace

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open Langlands.ModuleSheaf

variable {O : Type u} [CommRing O] {F : Type u} [Field F] [Algebra O F]
  {X : TopCat.{u}}

/-- Scalar-restriction stalk comparison on an arbitrary actual germ. -/
@[reassoc]
theorem restrictionStalkIso_germ (N : X.Sheaf (ModuleCat.{u} F))
    (U : Opens X) (x : X) (hx : x ∈ U) :
    TopCat.Presheaf.germ ((rationalRestriction F X).obj N).obj U x hx ≫
        (restrictionStalkIso F X N x).hom =
      (ModuleCat.restrictScalars (algebraMap O F)).map
        (TopCat.Presheaf.germ N.obj U x hx) :=
  ι_preservesColimitIso_inv (ModuleCat.restrictScalars (algebraMap O F))
    ((OpenNhds.inclusion x).op ⋙ N.obj) (.op ⟨U, hx⟩)

variable (M : X.Sheaf (ModuleCat.{u} O)) (N : X.Sheaf (ModuleCat.{u} F))
  (f : M ⟶ (rationalRestriction F X).obj N) (n : ℕ)

/-- The ambient rational exterior sheaf, viewed with integral scalars. -/
def exteriorAmbient : X.Sheaf (ModuleCat.{u} O) :=
  (rationalRestriction F X).obj (exteriorSheaf N.obj n)

/-- The sheafified rational exterior product of images of integral sections. -/
def exteriorSection (U : (Opens X)ᵒᵖ) (s : Fin n → M.obj.obj U) :
    (exteriorAmbient (O := O) N n).obj.obj U :=
  (toSheafify (Opens.grothendieckTopology X) (exteriorPresheaf N.obj n)).app U
    (exteriorPower.ιMulti F n (fun j => f.hom.app U (s j)))

/-- Exterior section generators commute with every restriction map. -/
theorem exteriorSection_res {U V : (Opens X)ᵒᵖ} (g : U ⟶ V)
    (s : Fin n → M.obj.obj U) :
    (exteriorAmbient (O := O) N n).obj.map g (exteriorSection M N f n U s) =
      exteriorSection M N f n V (fun j => M.obj.map g (s j)) := by
  have h := congrArg (fun k => k
      (exteriorPower.ιMulti F n (fun j => f.hom.app U (s j))))
    ((toSheafify (Opens.grothendieckTopology X)
      (exteriorPresheaf N.obj n)).naturality g)
  change (toSheafify (Opens.grothendieckTopology X)
      (exteriorPresheaf N.obj n)).app V
      ((exteriorPresheaf N.obj n).map g
        (exteriorPower.ιMulti F n (fun j => f.hom.app U (s j)))) =
    (exteriorSheaf N.obj n).obj.map g
      ((toSheafify (Opens.grothendieckTopology X)
        (exteriorPresheaf N.obj n)).app U
        (exteriorPower.ιMulti F n (fun j => f.hom.app U (s j)))) at h
  change (exteriorSheaf N.obj n).obj.map g
      ((toSheafify (Opens.grothendieckTopology X)
        (exteriorPresheaf N.obj n)).app U
        (exteriorPower.ιMulti F n (fun j => f.hom.app U (s j)))) = _
  rw [← h]
  change (toSheafify (Opens.grothendieckTopology X)
      (exteriorPresheaf N.obj n)).app V
    (exteriorPower.map n (N.obj.map g).hom
      (exteriorPower.ιMulti F n (fun j => f.hom.app U (s j)))) = _
  rw [exteriorPower.map_apply_ιMulti]
  congr 2
  funext j
  exact (congrArg (fun k => k (s j)) (f.hom.naturality g)).symm

/-- Integral spans of exterior generators, defined independently on each open set. -/
def exteriorSectionSubmodule : SectionSubmodule (exteriorAmbient (O := O) N n).obj where
  obj U := Submodule.span O (Set.range (exteriorSection M N f n U))
  map_mem {U V} g {s} hs := by
    refine Submodule.span_induction (fun z hz => ?_) ?_
      (fun a b _ _ ha hb => ?_) (fun a b _ hb => ?_) hs
    · obtain ⟨s, rfl⟩ := hz
      rw [exteriorSection_res]
      exact Submodule.subset_span ⟨_, rfl⟩
    · rw [map_zero]; exact Submodule.zero_mem _
    · rw [map_add]; exact Submodule.add_mem _ ha hb
    · rw [map_smul]; exact Submodule.smul_mem _ a hb

/-- The actual exterior subsheaf generated by integral image sections. -/
def exteriorSubsheaf : X.Sheaf (ModuleCat.{u} O) :=
  (exteriorSectionSubmodule M N f n).sheaf

/-- The constructed monomorphic inclusion into the rational exterior sheaf. -/
def exteriorSubsheafInclusion : exteriorSubsheaf M N f n ⟶ exteriorAmbient (O := O) N n :=
  (exteriorSectionSubmodule M N f n).sheafInclusion

instance : Mono (exteriorSubsheafInclusion M N f n) := by
  unfold exteriorSubsheafInclusion
  infer_instance

/-- The actual integral-image map into the rational stalk. -/
def imageStalkMap (x : X) :
    TopCat.Presheaf.stalk (C := ModuleCat.{u} O) M.obj x ⟶
      (ModuleCat.restrictScalars (algebraMap O F)).obj
        (TopCat.Presheaf.stalk (C := ModuleCat.{u} F) N.obj x) :=
  (TopCat.Presheaf.stalkFunctor (ModuleCat.{u} O) x).map f.hom ≫
    (restrictionStalkIso F X N x).hom

/-- On a germ the integral-image stalk map is the given section map. -/
@[reassoc]
theorem imageStalkMap_germ (U : Opens X) (x : X) (hx : x ∈ U) :
    TopCat.Presheaf.germ M.obj U x hx ≫ imageStalkMap M N f x =
      f.hom.app (.op U) ≫ (ModuleCat.restrictScalars (algebraMap O F)).map
        (TopCat.Presheaf.germ N.obj U x hx) := by
  rw [imageStalkMap, ← Category.assoc, TopCat.Presheaf.stalkFunctor_map_germ,
    Category.assoc, restrictionStalkIso_germ]

/-- Canonical identification of the ambient exterior stalk with an actual exterior power. -/
def exteriorAmbientStalkIso (x : X) :
    TopCat.Presheaf.stalk (C := ModuleCat.{u} O) (exteriorAmbient (O := O) N n).obj x ≅
      (ModuleCat.restrictScalars (algebraMap O F)).obj
        ((TopCat.Presheaf.stalk (C := ModuleCat.{u} F) N.obj x).exteriorPower n) :=
  restrictionStalkIso F X (exteriorSheaf N.obj n) x ≪≫
    (ModuleCat.restrictScalars (algebraMap O F)).mapIso (exteriorSheafStalkIso N.obj x n)

/-- The ambient comparison on germs, before evaluating an exterior generator. -/
@[reassoc]
theorem exteriorAmbientStalkIso_germ (U : Opens X) (x : X) (hx : x ∈ U) :
    TopCat.Presheaf.germ (exteriorAmbient (O := O) N n).obj U x hx ≫
        (exteriorAmbientStalkIso (O := O) N n x).hom =
      (ModuleCat.restrictScalars (algebraMap O F)).map
        (TopCat.Presheaf.germ (exteriorSheaf N.obj n).obj U x hx ≫
          (exteriorSheafStalkIso N.obj x n).hom) := by
  change TopCat.Presheaf.germ
      ((rationalRestriction F X).obj (exteriorSheaf N.obj n)).obj U x hx ≫
      (restrictionStalkIso F X (exteriorSheaf N.obj n) x).hom ≫
      (ModuleCat.restrictScalars (algebraMap O F)).map
        (exteriorSheafStalkIso N.obj x n).hom = _
  rw [← Category.assoc, restrictionStalkIso_germ, Functor.map_comp]

set_option maxHeartbeats 800000 in
/-- Exterior generators map to exterior products of the original integral-image germs. -/
theorem exteriorSection_germ (U : Opens X) (x : X) (hx : x ∈ U)
    (s : Fin n → M.obj.obj (.op U)) :
    (exteriorAmbientStalkIso (O := O) N n x).hom
        (TopCat.Presheaf.germ (exteriorAmbient (O := O) N n).obj U x hx
          (exteriorSection M N f n (.op U) s)) =
      exteriorPower.ιMulti F n (fun j => imageStalkMap M N f x
        (TopCat.Presheaf.germ M.obj U x hx (s j))) := by
  change (TopCat.Presheaf.germ (exteriorAmbient (O := O) N n).obj U x hx ≫
    (exteriorAmbientStalkIso (O := O) N n x).hom) _ = _
  rw [exteriorAmbientStalkIso_germ]
  change ((toSheafify (Opens.grothendieckTopology X)
      (exteriorPresheaf N.obj n)).app (.op U) ≫
    TopCat.Presheaf.germ (exteriorSheaf N.obj n).obj U x hx ≫
    (exteriorSheafStalkIso N.obj x n).hom)
      (exteriorPower.ιMulti F n (fun j => f.hom.app (.op U) (s j))) = _
  rw [exteriorSheafStalkIso_germ]
  change exteriorPower.map n (TopCat.Presheaf.germ N.obj U x hx).hom _ = _
  rw [exteriorPower.map_apply_ιMulti]
  apply congrArg (exteriorPower.ιMulti F n)
  funext j
  exact (congrArg (fun k => k (s j)) (imageStalkMap_germ M N f U x hx)).symm

/-- Stalk map of the actual exterior subsheaf, in the ambient exterior-power coordinates. -/
def exteriorSubsheafStalkMap (x : X) :
    TopCat.Presheaf.stalk (C := ModuleCat.{u} O) (exteriorSubsheaf M N f n).obj x ⟶
      (ModuleCat.restrictScalars (algebraMap O F)).obj
        ((TopCat.Presheaf.stalk (C := ModuleCat.{u} F) N.obj x).exteriorPower n) :=
  (TopCat.Presheaf.stalkFunctor (ModuleCat.{u} O) x).map
      (exteriorSubsheafInclusion M N f n).hom ≫
    (exteriorAmbientStalkIso (O := O) N n x).hom

set_option maxHeartbeats 1200000 in
/-- The independently generated exterior subpresheaf has exactly the exterior image lattice. -/
theorem exteriorSectionSubmodule_stalk_range (x : X) :
    ((exteriorSectionSubmodule M N f n).stalkRange x).map
        (exteriorAmbientStalkIso (O := O) N n x).hom.hom =
      exteriorStalkLattice F n
        (TopCat.Presheaf.stalk (C := ModuleCat.{u} F) N.obj x)
        (LinearMap.range (imageStalkMap M N f x).hom) := by
  classical
  apply le_antisymm
  · rintro v ⟨w, hw, rfl⟩
    obtain ⟨U, hx, s, hs, rfl⟩ :=
      ((exteriorSectionSubmodule M N f n).mem_stalkRange_iff x w).mp hw
    change s ∈ Submodule.span O (Set.range (exteriorSection M N f n (.op U))) at hs
    refine Submodule.span_induction (fun z hz => ?_) ?_
      (fun a b _ _ ha hb => ?_) (fun a b _ hb => ?_) hs
    · obtain ⟨t, rfl⟩ := hz
      rw [exteriorSection_germ]
      exact Submodule.subset_span ⟨fun j =>
        ⟨imageStalkMap M N f x (TopCat.Presheaf.germ M.obj U x hx (t j)),
          ⟨TopCat.Presheaf.germ M.obj U x hx (t j), rfl⟩⟩, rfl⟩
    · rw [map_zero, map_zero]; exact Submodule.zero_mem _
    · rw [map_add, map_add]; exact Submodule.add_mem _ ha hb
    · rw [map_smul, map_smul]; exact Submodule.smul_mem _ a hb
  · apply Submodule.span_le.mpr
    rintro _ ⟨v, rfl⟩
    choose t ht using (fun j => (v j).property)
    obtain ⟨U, hx, s, hs⟩ := exists_fin_germs_eq M.obj x n t
    refine ⟨TopCat.Presheaf.germ (exteriorAmbient (O := O) N n).obj U x hx
      (exteriorSection M N f n (.op U) s), ?_, ?_⟩
    · exact ((exteriorSectionSubmodule M N f n).mem_stalkRange_iff x _).mpr
        ⟨U, hx, exteriorSection M N f n (.op U) s,
          Submodule.subset_span ⟨s, rfl⟩, rfl⟩
    · rw [exteriorSection_germ]
      apply congrArg (exteriorPower.ιMulti F n)
      funext j
      rw [hs j]
      exact ht j

/-- The actual exterior subsheaf has the exterior span of the actual integral-image stalk. -/
theorem exteriorSubsheafStalkMap_range (x : X) :
    LinearMap.range (exteriorSubsheafStalkMap M N f n x).hom =
      exteriorStalkLattice F n
        (TopCat.Presheaf.stalk (C := ModuleCat.{u} F) N.obj x)
        (LinearMap.range (imageStalkMap M N f x).hom) := by
  change LinearMap.range
    ((exteriorAmbientStalkIso (O := O) N n x).hom.hom.comp
      ((TopCat.Presheaf.stalkFunctor (ModuleCat.{u} O) x).map
        (exteriorSectionSubmodule M N f n).sheafInclusion.hom).hom) = _
  rw [LinearMap.range_comp, (exteriorSectionSubmodule M N f n).sheafInclusion_stalk_range]
  exact exteriorSectionSubmodule_stalk_range M N f n x

end Langlands.DeligneFormalSpace
