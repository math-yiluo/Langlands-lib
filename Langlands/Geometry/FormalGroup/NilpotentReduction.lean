import Langlands.Geometry.FormalGroup.NilpotentAlgebras
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Reduction modulo the distinguished element -/

noncomputable section

universe u v

namespace Langlands.FormalGroup

open CategoryTheory

variable (R : Type u) [CommRing R] (π : R)

/-- The coefficient ring modulo the distinguished element. -/
abbrev ResidueRing := R ⧸ Ideal.span {π}

namespace Nilp

variable {R}

/-- The principal ideal generated by the image of π in a coefficient algebra. -/
def reductionIdeal (A : CommAlgCat.{v} R) : Ideal A :=
  Ideal.span {algebraMap R A π}

/-- The actual quotient algebra A/(π). This construction also applies outside Nilp. -/
abbrev Reduction (A : CommAlgCat.{v} R) := A ⧸ reductionIdeal π A

/-- The canonical quotient as an R-algebra map. -/
def reductionQuotient (A : CommAlgCat.{v} R) : A →ₐ[R] Reduction π A :=
  Ideal.Quotient.mkₐ R (reductionIdeal π A)

@[simp]
theorem reductionQuotient_uniformizer (A : CommAlgCat.{v} R) :
    reductionQuotient π A (algebraMap R A π) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))

theorem reductionQuotient_surjective (A : CommAlgCat.{v} R) :
    Function.Surjective (reductionQuotient π A) := Ideal.Quotient.mkₐ_surjective R _

@[simp]
theorem reduction_algebraMap (A : CommAlgCat.{v} R) :
    algebraMap R (Reduction π A) π = 0 := reductionQuotient_uniformizer π A

/-- The canonical coefficient-ring quotient acts on A/(π). -/
instance reductionResidueAlgebra (A : CommAlgCat.{v} R) :
    Algebra (ResidueRing R π) (Reduction π A) :=
  Ideal.Quotient.algebraQuotientOfLEComap
    ((Ideal.span_singleton_le_iff_mem _).mpr
      (Ideal.subset_span (Set.mem_singleton _)))

variable {π}

/-- An R-algebra map preserves the principal ideal of the image of π. -/
theorem reductionIdeal_le_comap {A B : CommAlgCat.{v} R} (f : A →ₐ[R] B) :
    reductionIdeal π A ≤ (reductionIdeal π B).comap f := by
  apply (Ideal.span_singleton_le_iff_mem _).mpr
  change f (algebraMap R A π) ∈ reductionIdeal π B
  rw [f.commutes]
  exact Ideal.subset_span (Set.mem_singleton _)

/-- The algebra homomorphism on actual reductions induced by f. -/
def reductionMap {A B : CommAlgCat.{v} R} (f : A →ₐ[R] B) :
    Reduction π A →ₐ[R] Reduction π B :=
  Ideal.quotientMapₐ (reductionIdeal π B) f (reductionIdeal_le_comap f)

@[simp]
theorem reductionMap_quotient {A B : CommAlgCat.{v} R} (f : A →ₐ[R] B) (a : A) :
    reductionMap (π := π) f (reductionQuotient π A a) =
      reductionQuotient π B (f a) := rfl

@[simp]
theorem reductionMap_id (A : CommAlgCat.{v} R) :
    reductionMap (π := π) (AlgHom.id R A) = AlgHom.id R (Reduction π A) := by
  apply Ideal.Quotient.algHom_ext
  apply AlgHom.ext
  intro a
  rfl

@[simp]
theorem reductionMap_comp {A B C : CommAlgCat.{v} R} (f : A →ₐ[R] B) (g : B →ₐ[R] C) :
    reductionMap (π := π) (g.comp f) = (reductionMap g).comp (reductionMap f) := by
  apply Ideal.Quotient.algHom_ext
  apply AlgHom.ext
  intro a
  rfl

/-- The same reduction map is linear over the quotient coefficient ring. -/
def residueReductionMap {A B : CommAlgCat.{v} R} (f : A →ₐ[R] B) :
    Reduction π A →ₐ[ResidueRing R π] Reduction π B where
  __ := (reductionMap (π := π) f).toRingHom
  commutes' r := by
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    change reductionQuotient π B (f (algebraMap R A r)) =
      reductionQuotient π B (algebraMap R B r)
    rw [f.commutes]

variable (R π)

/-- Reduction of a Nilp algebra, viewed as an algebra over R/(π). -/
def residueReductionFunctor : Nilp.{u, v} R π ⥤ CommAlgCat.{v} (ResidueRing R π) where
  obj A := CommAlgCat.of (ResidueRing R π) (Reduction π A.obj)
  map f := CommAlgCat.ofHom (residueReductionMap f.hom.hom)
  map_id A := by
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro a
    obtain ⟨a, rfl⟩ := reductionQuotient_surjective π A.obj a
    rfl
  map_comp f g := by
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro a
    obtain ⟨a, rfl⟩ := reductionQuotient_surjective π _ a
    rfl

/-- Reduction, kept as a Nilp algebra via R → R/(π) → A/(π). -/
def reductionFunctor : Nilp.{u, v} R π ⥤ Nilp.{u, v} R π where
  obj A := Nilp.of R π (Reduction π A.obj) (by
    rw [reduction_algebraMap]
    exact ⟨1, by simp⟩)
  map f := ObjectProperty.homMk (CommAlgCat.ofHom (reductionMap f.hom.hom))
  map_id A := by
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    exact reductionMap_id A.obj
  map_comp f g := by
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    exact reductionMap_comp f.hom.hom g.hom.hom

/-- The quotient maps are natural in the Nilp algebra. -/
def reductionNatTrans : 𝟭 (Nilp.{u, v} R π) ⟶ reductionFunctor R π where
  app A := ObjectProperty.homMk (CommAlgCat.ofHom (reductionQuotient π A.obj))
  naturality A B f := by
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro a
    rfl

variable {R π}

/-- On Nilp the reduction ideal is actually nilpotent, with no chosen exponent. -/
theorem reductionIdeal_isNilpotent (A : Nilp.{u, v} R π) :
    IsNilpotent (reductionIdeal π A.obj) := by
  obtain ⟨n, hn⟩ := A.property
  refine ⟨n, ?_⟩
  change Ideal.span {algebraMap R A.obj π} ^ n = 0
  rw [Ideal.span_singleton_pow, hn]
  exact Ideal.span_singleton_zero

end Nilp

end Langlands.FormalGroup
