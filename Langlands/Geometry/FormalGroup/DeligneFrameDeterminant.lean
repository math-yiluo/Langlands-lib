import Langlands.Geometry.FormalGroup.DeligneDeterminantBaseChange
import Mathlib.LinearAlgebra.Determinant

/-! # Determinants of actual Deligne frame lattices -/

noncomputable section

universe u

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

namespace Langlands.DeligneFormalSpace

open CategoryTheory TopologicalSpace

/-- An alternating map with as many arguments as a basis is determined by its basis value,
with determinant coefficient, even for a module-valued target. -/
theorem alternatingMap_apply_eq_det_smul
    {R M N ι : Type*} [CommRing R] [AddCommGroup M] [AddCommGroup N]
    [Module R M] [Module R N] [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι R M) (A : M [⋀^ι]→ₗ[R] N) (v : ι → M) :
    A v = b.det v • A b := by
  have h : A = (LinearMap.toSpanSingleton R N (A b)).compAlternatingMap b.det := by
    refine b.ext_alternating fun i hi => ?_
    let σ : Equiv.Perm ι := Equiv.ofBijective i (Finite.injective_iff_bijective.1 hi)
    change A (b ∘ σ) =
      (LinearMap.toSpanSingleton R N (A b)).compAlternatingMap b.det (b ∘ σ)
    simp [AlternatingMap.map_perm, Module.Basis.det_self]
  exact congrArg (fun B => B v) h

variable {O : Type u} [CommRing O] (F : Type u) [Field F] [Algebra O F]

/-- The actual O-linear map obtained by applying an F-linear map to O-coordinate vectors. -/
def integralCoordinateRangeMap {d : ℕ} {V : ModuleCat.{u} F}
    (f : (Fin d → F) →ₗ[F] V) :
    (Fin d → O) →ₗ[O] ((ModuleCat.restrictScalars (algebraMap O F)).obj V) where
  toFun v := f (fun j => algebraMap O F (v j))
  map_add' v w := by
    have h : (fun j => algebraMap O F ((v + w) j)) =
        (fun j => algebraMap O F (v j)) + (fun j => algebraMap O F (w j)) := by
      funext j
      exact map_add (algebraMap O F) _ _
    rw [h]
    exact f.map_add _ _
  map_smul' a v := by
    change f (fun j => algebraMap O F ((a • v) j)) =
      algebraMap O F a • f (fun j => algebraMap O F (v j))
    have h : (fun j => algebraMap O F ((a • v) j)) =
        algebraMap O F a • (fun j => algebraMap O F (v j)) := by
      funext j
      exact map_mul (algebraMap O F) _ _
    rw [h]
    exact f.map_smul _ _

/-- The top exterior O-lattice of an integral frame is generated by its single basis wedge. -/
theorem exteriorStalkLattice_integralCoordinateRange {d : ℕ} {V : ModuleCat.{u} F}
    (f : (Fin d → F) →ₗ[F] V) :
    exteriorStalkLattice F d V (LinearMap.range (integralCoordinateRangeMap (O := O) F f)) =
      Submodule.span O ({exteriorPower.ιMulti F d (fun j => f (Pi.basisFun F (Fin d) j))} :
        Set ((ModuleCat.restrictScalars (algebraMap O F)).obj
          (ModuleCat.of F (⋀[F]^d V)))) := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨v, rfl⟩
    choose w hw using fun j => (v j).property
    have heq : (fun j => (show V from (v j).val)) =
        fun j => f (fun k => algebraMap O F (w j k)) := by
      funext j
      exact (hw j).symm
    have h := alternatingMap_apply_eq_det_smul (Pi.basisFun F (Fin d))
      ((exteriorPower.ιMulti F d).compLinearMap f)
      (fun j k => algebraMap O F (w j k))
    change exteriorPower.ιMulti F d (fun j => f (fun k => algebraMap O F (w j k))) =
      (Pi.basisFun F (Fin d)).det (fun j k => algebraMap O F (w j k)) •
        exteriorPower.ιMulti F d (fun j => f (Pi.basisFun F (Fin d) j)) at h
    have hd : (Pi.basisFun F (Fin d)).det (fun j k => algebraMap O F (w j k)) =
        algebraMap O F ((Pi.basisFun O (Fin d)).det w) := by
      simp only [Pi.basisFun_det_apply]
      exact ((algebraMap O F).map_det (Matrix.of w)).symm
    apply Submodule.mem_span_singleton.mpr
    refine ⟨(Pi.basisFun O (Fin d)).det w, ?_⟩
    change algebraMap O F ((Pi.basisFun O (Fin d)).det w) •
      exteriorPower.ιMulti F d (fun j => f (Pi.basisFun F (Fin d) j)) =
        exteriorPower.ιMulti F d (fun j => (show V from (v j).val))
    rw [heq, ← hd]
    exact h.symm
  · apply Submodule.span_le.mpr
    rintro _ (rfl : _ = _)
    apply Submodule.subset_span
    refine ⟨fun j => ⟨f (Pi.basisFun F (Fin d) j), ?_⟩, rfl⟩
    refine ⟨Pi.basisFun O (Fin d) j, ?_⟩
    change f (fun k => algebraMap O F (Pi.basisFun O (Fin d) j k)) = _
    congr 1
    ext k
    simp [Pi.basisFun_apply, Pi.single_apply]

/-- Scaling a cyclic O-lattice scales its chosen generator. -/
theorem scaleStalkLattice_span_singleton {V : ModuleCat.{u} F} (a : F) (v : V) :
    scaleStalkLattice F a V
        (Submodule.span O ({v} : Set ((ModuleCat.restrictScalars (algebraMap O F)).obj V))) =
      Submodule.span O ({a • v} :
        Set ((ModuleCat.restrictScalars (algebraMap O F)).obj V)) := by
  unfold scaleStalkLattice
  rw [Submodule.map_span, Set.image_singleton]
  rfl

/-- Consecutive scalar operations multiply their scalars after taking the exterior power. -/
theorem scaleStalkLattice_mul {V : ModuleCat.{u} F} (a b : F)
    (L : Submodule O ((ModuleCat.restrictScalars (algebraMap O F)).obj V)) :
    scaleStalkLattice F a V (scaleStalkLattice F b V L) =
      scaleStalkLattice F (a * b) V L := by
  unfold scaleStalkLattice
  rw [← Submodule.map_comp]
  congr 1
  apply LinearMap.ext
  intro v
  exact (mul_smul a b v).symm

/-- Multiplication by an integral unit preserves every O-lattice in an F-module. -/
theorem scaleStalkLattice_algebraMap_unit {V : ModuleCat.{u} F} (a : Oˣ)
    (L : Submodule O ((ModuleCat.restrictScalars (algebraMap O F)).obj V)) :
    scaleStalkLattice F (algebraMap O F (a : O)) V L = L := by
  ext v
  constructor
  · rintro ⟨w, hw, hv⟩
    change algebraMap O F (a : O) • w = v at hv
    rw [← hv]
    exact L.smul_mem (a : O) hw
  · intro hv
    refine ⟨(↑(a⁻¹) : O) • v, L.smul_mem _ hv, ?_⟩
    change algebraMap O F (a : O) • (algebraMap O F (↑(a⁻¹) : O) • v) = v
    rw [smul_smul, ← map_mul]
    simp

/-- Precomposition of a basis wedge multiplies it by the actual linear determinant. -/
theorem exteriorBasisWedge_comp {d : ℕ} {V : ModuleCat.{u} F}
    (f : (Fin d → F) →ₗ[F] V) (g : Module.End F (Fin d → F)) :
    exteriorPower.ιMulti F d (fun j => f (g (Pi.basisFun F (Fin d) j))) =
      LinearMap.det g • exteriorPower.ιMulti F d (fun j => f (Pi.basisFun F (Fin d) j)) := by
  have h := alternatingMap_apply_eq_det_smul (Pi.basisFun F (Fin d))
    ((exteriorPower.ιMulti F d).compLinearMap f)
    (g ∘ Pi.basisFun F (Fin d))
  simpa only [AlternatingMap.compLinearMap_apply, Function.comp_apply,
    Module.Basis.det_comp, Module.Basis.det_self, mul_one] using h

/-- The top exterior lattice changes by det(g) under precomposition by any endomorphism. -/
theorem exteriorStalkLattice_integralCoordinateRange_comp {d : ℕ} {V : ModuleCat.{u} F}
    (f : (Fin d → F) →ₗ[F] V) (g : Module.End F (Fin d → F)) :
    exteriorStalkLattice F d V (LinearMap.range (integralCoordinateRangeMap (O := O) F (f.comp g))) =
      scaleStalkLattice F (LinearMap.det g) _
        (exteriorStalkLattice F d V (LinearMap.range (integralCoordinateRangeMap (O := O) F f))) := by
  rw [exteriorStalkLattice_integralCoordinateRange,
    exteriorStalkLattice_integralCoordinateRange, scaleStalkLattice_span_singleton]
  congr 1
  exact congrArg singleton (exteriorBasisWedge_comp F f g)

namespace FramedLatticePiSheaf

variable {d : ℕ} {π : O} {X : TopCat.{u}}
  (M : FramedLatticePiSheaf d π X F)

/-- A genuine change of rational frame; no determinant-admissibility assertion is imposed. -/
def reframe (g : (Fin d → F) ≃ₗ[F] (Fin d → F)) : FramedLatticePiSheaf d π X F where
  lattice := M.lattice
  frame := (constantSheaf (Opens.grothendieckTopology X) (ModuleCat.{u} F)).mapIso
    g.toModuleIso ≪≫ M.frame

/-- Changing frame precomposes the actual constant-vector stalk map by g. -/
theorem frameStalkMap_reframe (g : (Fin d → F) ≃ₗ[F] (Fin d → F)) (x : X) :
    (M.reframe F g).frameStalkMap F x =
      ModuleCat.ofHom g.toLinearMap ≫ M.frameStalkMap F x := by
  have h := congrArg (fun k => k.app (.op ⊤))
    (toSheafify_naturality (Opens.grothendieckTopology X)
      ((Functor.const (Opens X)ᵒᵖ).map (ModuleCat.ofHom g.toLinearMap)))
  change ModuleCat.ofHom g.toLinearMap ≫
      (toSheafify (Opens.grothendieckTopology X)
        ((Functor.const (Opens X)ᵒᵖ).obj (ModuleCat.of F (Fin d → F)))).app (.op ⊤) =
    (toSheafify (Opens.grothendieckTopology X)
      ((Functor.const (Opens X)ᵒᵖ).obj (ModuleCat.of F (Fin d → F)))).app (.op ⊤) ≫
        ((constantSheaf (Opens.grothendieckTopology X) (ModuleCat.{u} F)).map
          g.toModuleIso.hom).hom.app (.op ⊤) at h
  dsimp only [frameStalkMap, frameToTotal, reframe, Iso.trans_hom, Functor.mapIso_hom]
  simp only [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, Category.assoc]
  rw [← Category.assoc
    ((toSheafify (Opens.grothendieckTopology X)
      ((Functor.const (Opens X)ᵒᵖ).obj (ModuleCat.of F (Fin d → F)))).app (.op ⊤)), ← h]
  simp only [Category.assoc]

/-- The original integral frame map is the general integral-coordinate construction. -/
theorem integralFrameStalkMap_eq (x : X) :
    M.integralFrameStalkMap F x = integralCoordinateRangeMap (O := O) F (M.frameStalkMap F x).hom := rfl

/-- The actual top exterior frame lattice is generated by the actual basis-frame wedge. -/
theorem exteriorFrameStalkLattice_eq_span (x : X) :
    exteriorStalkLattice F d _ (M.frameStalkLattice F x) =
      Submodule.span O
        ({exteriorPower.ιMulti F d (fun j => M.frameStalkMap F x (Pi.basisFun F (Fin d) j))} :
          Set ((ModuleCat.restrictScalars (algebraMap O F)).obj
            (ModuleCat.of F (⋀[F]^d (rationalLatticeStalk F X d π M.lattice.sheaf x))))) :=
  exteriorStalkLattice_integralCoordinateRange F (M.frameStalkMap F x).hom

/-- Changing the actual rational frame scales its top exterior O-lattice by det(g). -/
theorem exteriorFrameStalkLattice_reframe
    (g : (Fin d → F) ≃ₗ[F] (Fin d → F)) (x : X) :
    exteriorStalkLattice F d _ ((M.reframe F g).frameStalkLattice F x) =
      scaleStalkLattice F (LinearMap.det g.toLinearMap) _
        (exteriorStalkLattice F d _ (M.frameStalkLattice F x)) := by
  change exteriorStalkLattice F d _
    (LinearMap.range (integralCoordinateRangeMap (O := O) F ((M.reframe F g).frameStalkMap F x).hom)) = _
  rw [M.frameStalkMap_reframe F g x]
  exact exteriorStalkLattice_integralCoordinateRange_comp F (M.frameStalkMap F x).hom
    g.toLinearMap

variable [NeZero d]

/-- Every integer Pi-translate has the same determinant change under reframing. -/
theorem exteriorTranslatedFrameStalkLattice_reframe
    (g : (Fin d → F) ≃ₗ[F] (Fin d → F))
    (hπ : algebraMap O F π ≠ 0) (n : ℤ) (x : X) :
    exteriorStalkLattice F d _ ((M.reframe F g).translatedFrameStalkLattice F hπ n x) =
      scaleStalkLattice F (LinearMap.det g.toLinearMap) _
        (exteriorStalkLattice F d _ (M.translatedFrameStalkLattice F hπ n x)) := by
  unfold translatedFrameStalkLattice
  rw [← exteriorStalkLattice_map, ← exteriorStalkLattice_map,
    M.exteriorFrameStalkLattice_reframe F g x, scaleStalkLattice_map]
  rfl

/-- The literal pi^(-n) normalized determinant scales by det(g) for every integer n. -/
theorem normalizedFrameDeterminant_reframe
    (g : (Fin d → F) ≃ₗ[F] (Fin d → F))
    (hπ : algebraMap O F π ≠ 0) (n : ℤ) (x : X) :
    (M.reframe F g).normalizedFrameDeterminant F hπ n x =
      scaleStalkLattice F (LinearMap.det g.toLinearMap) _
        (M.normalizedFrameDeterminant F hπ n x) := by
  unfold normalizedFrameDeterminant
  rw [M.exteriorTranslatedFrameStalkLattice_reframe F g hπ n x,
    scaleStalkLattice_mul, scaleStalkLattice_mul, mul_comm]

/-- An integral-unit determinant therefore preserves every normalized determinant lattice. -/
theorem normalizedFrameDeterminant_reframe_of_det_unit
    (g : (Fin d → F) ≃ₗ[F] (Fin d → F)) (a : Oˣ)
    (hdet : LinearMap.det g.toLinearMap = algebraMap O F (a : O))
    (hπ : algebraMap O F π ≠ 0) (n : ℤ) (x : X) :
    (M.reframe F g).normalizedFrameDeterminant F hπ n x =
      M.normalizedFrameDeterminant F hπ n x := by
  rw [M.normalizedFrameDeterminant_reframe F g hπ n x, hdet,
    scaleStalkLattice_algebraMap_unit]

end FramedLatticePiSheaf

end Langlands.DeligneFormalSpace
