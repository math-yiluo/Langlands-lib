import Langlands.Geometry.FormalGroup.DrinfeldFramedComparisonIdentity
import Mathlib.Logic.Relation

/-! # Classes generated by chains of actual framed formal comparisons -/

noncomputable section

universe u v s t

namespace Langlands.FormalGroup.LocalDivision.DrinfeldFramedAtlas

open CategoryTheory ValuativeRel CentralDivision ModuleLaw

variable {K D : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [DivisionRing D] [Algebra K D]
  [FiniteDimensional K D] [Algebra.IsCentral K D]
variable {L : Type s} [Field L] [Algebra K L] {ι : L →ₐ[K] D}
variable {R : Type v} [CommRing R] [Algebra 𝒪[K] R]
variable {κ : Type u} [Field κ] [Algebra 𝒪[K] κ] {π : 𝒪[K]}
variable {A : Nilp.{v, u} R (algebraMap 𝒪[K] R π)}
variable {Φ : SpecialModule.HeightSquaredModule (K := K) (D := D) (ι := ι)
  (R := κ) π}
variable {X Y Z : DrinfeldFramedAtlas Φ A}

attribute [local instance] coefficientAlgebra coefficientScalarTower

/-- Each step retains actual target refinements and the full rational framing square. -/
def DirectlyComparable (X Y : DrinfeldFramedAtlas Φ A) : Prop :=
  Nonempty (Comparison X Y)

/-- A finite chain of the specified actual framed formal comparisons. -/
def ChainEquivalent (X Y : DrinfeldFramedAtlas Φ A) : Prop :=
  Relation.ReflTransGen DirectlyComparable X Y

theorem chainEquivalent_refl (X : DrinfeldFramedAtlas Φ A) : ChainEquivalent X X :=
  Relation.ReflTransGen.refl

theorem chainEquivalent_of_comparison (f : Comparison X Y) : ChainEquivalent X Y :=
  Relation.ReflTransGen.single ⟨f⟩

theorem chainEquivalent_trans (h : ChainEquivalent X Y) (k : ChainEquivalent Y Z) :
    ChainEquivalent X Z :=
  Relation.ReflTransGen.trans h k

/-- Reverse each actual formal comparison and the order of its finite chain. -/
theorem chainEquivalent_symm (h : ChainEquivalent X Y) : ChainEquivalent Y X := by
  induction h with
  | refl => exact chainEquivalent_refl _
  | tail h hf ih =>
    obtain ⟨f⟩ := hf
    exact chainEquivalent_trans (chainEquivalent_of_comparison f.symm) ih

/-- An invariant of each actual comparison is invariant along every finite chain. -/
theorem ChainEquivalent.map_eq {T : Sort t} (h : ChainEquivalent X Y)
    (f : DrinfeldFramedAtlas Φ A → T)
    (hf : ∀ {U V : DrinfeldFramedAtlas Φ A}, Comparison U V → f U = f V) :
    f X = f Y := by
  induction h with
  | refl => rfl
  | tail h hg ih =>
    obtain ⟨g⟩ := hg
    exact ih.trans (hf g)

/-- The chain relation preserves the actual stored residue map. -/
theorem ChainEquivalent.residue_eq (h : ChainEquivalent X Y) :
    X.residueMap = Y.residueMap :=
  h.map_eq residueMap (fun f => f.residue_eq)

/-- The chain relation preserves the class of the actual height-certified target. -/
theorem ChainEquivalent.targetClass_eq (h : ChainEquivalent X Y) :
    SpecialAtlas.HeightSquaredAtlas.classOf X.target =
      SpecialAtlas.HeightSquaredAtlas.classOf Y.target :=
  h.map_eq (fun U => SpecialAtlas.HeightSquaredAtlas.classOf U.target)
    (fun f => SpecialAtlas.HeightSquaredAtlas.classOf_eq_of_comparison f.targetComparison)

/-- The equivalence closure is generated solely by the actual formal comparison steps. -/
def comparisonChainSetoid : Setoid (DrinfeldFramedAtlas Φ A) where
  r := ChainEquivalent
  iseqv := ⟨chainEquivalent_refl, chainEquivalent_symm, chainEquivalent_trans⟩

/-- Classes of actual framed representatives under finite actual comparison chains. -/
def ComparisonClass (Φ : SpecialModule.HeightSquaredModule
    (K := K) (D := D) (ι := ι) (R := κ) π)
    (A : Nilp.{v, u} R (algebraMap 𝒪[K] R π)) :=
  Quotient (comparisonChainSetoid (Φ := Φ) (A := A))

/-- Send an actual height-zero framed representative to its comparison-chain class. -/
def comparisonClassOf (X : DrinfeldFramedAtlas Φ A) : ComparisonClass Φ A :=
  Quotient.mk _ X

/-- Equality in this quotient means precisely a finite chain of actual framed comparisons. -/
theorem comparisonClassOf_eq_iff (X Y : DrinfeldFramedAtlas Φ A) :
    comparisonClassOf X = comparisonClassOf Y ↔ ChainEquivalent X Y :=
  Quotient.eq

theorem comparisonClassOf_eq_of_comparison (f : Comparison X Y) :
    comparisonClassOf X = comparisonClassOf Y :=
  (comparisonClassOf_eq_iff X Y).mpr (chainEquivalent_of_comparison f)

namespace ComparisonClass

/-- Descend any function invariant under each specified actual formal comparison. -/
def lift {T : Sort t} (f : DrinfeldFramedAtlas Φ A → T)
    (hf : ∀ {U V : DrinfeldFramedAtlas Φ A}, Comparison U V → f U = f V) :
    ComparisonClass Φ A → T :=
  Quotient.lift f (fun _ _ h => h.map_eq f hf)

@[simp]
theorem lift_comparisonClassOf {T : Sort t} (f : DrinfeldFramedAtlas Φ A → T)
    (hf : ∀ {U V : DrinfeldFramedAtlas Φ A}, Comparison U V → f U = f V)
    (X : DrinfeldFramedAtlas Φ A) : lift f hf (comparisonClassOf X) = f X := rfl

/-- The stored residue map is independent of the actual framed representative. -/
def residueMap (q : ComparisonClass Φ A) :
    κ →ₐ[𝒪[K]] ((Nilp.reductionFunctor R (algebraMap 𝒪[K] R π)).obj A).obj :=
  lift DrinfeldFramedAtlas.residueMap (fun f => f.residue_eq) q

@[simp]
theorem residueMap_comparisonClassOf (X : DrinfeldFramedAtlas Φ A) :
    (comparisonClassOf X).residueMap = X.residueMap := rfl

/-- Forget framing through the exact class of the actual height-certified target. -/
def targetClass (q : ComparisonClass Φ A) :
    SpecialAtlas.HeightSquaredAtlas.IsoClass
      (K := K) (D := D) (ι := ι) (R := A.obj) π :=
  lift (fun X => SpecialAtlas.HeightSquaredAtlas.classOf X.target)
    (fun f => SpecialAtlas.HeightSquaredAtlas.classOf_eq_of_comparison f.targetComparison) q

@[simp]
theorem targetClass_comparisonClassOf (X : DrinfeldFramedAtlas Φ A) :
    (comparisonClassOf X).targetClass = SpecialAtlas.HeightSquaredAtlas.classOf X.target := rfl

/-- The actual quotient-reduced height-certified target class is also independent of representative. -/
def reducedTargetClass (q : ComparisonClass Φ A) :
    SpecialAtlas.HeightSquaredAtlas.IsoClass
      (K := K) (D := D) (ι := ι)
      (R := ((Nilp.reductionFunctor R (algebraMap 𝒪[K] R π)).obj A).obj) π :=
  q.targetClass.reduction (A := A)

@[simp]
theorem reducedTargetClass_comparisonClassOf (X : DrinfeldFramedAtlas Φ A) :
    (comparisonClassOf X).reducedTargetClass =
      SpecialAtlas.HeightSquaredAtlas.classOf X.target.reduction := rfl

/-- Choose an actual framed representative, retaining its target and framing certificates. -/
def representative (q : ComparisonClass Φ A) : DrinfeldFramedAtlas Φ A :=
  Quotient.out q

@[simp]
theorem comparisonClassOf_representative (q : ComparisonClass Φ A) :
    comparisonClassOf q.representative = q :=
  Quotient.out_eq q

/-- The chosen representative has exactly the class's descended residue map. -/
theorem representative_residueMap (q : ComparisonClass Φ A) :
    q.representative.residueMap = q.residueMap :=
  congrArg residueMap (comparisonClassOf_representative q)

/-- Its actual height-certified target represents the descended target class. -/
theorem representative_targetClass (q : ComparisonClass Φ A) :
    SpecialAtlas.HeightSquaredAtlas.classOf q.representative.target = q.targetClass :=
  congrArg targetClass (comparisonClassOf_representative q)

end ComparisonClass

end Langlands.FormalGroup.LocalDivision.DrinfeldFramedAtlas
