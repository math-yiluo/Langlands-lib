import Langlands.Sheaf.AdicSystem
import Mathlib.AlgebraicGeometry.Sites.EtalePoint

/-!
# Coefficient inverse systems on the small etale site

These constructions instantiate the sheafification and inverse-system
functors on the actual small etale site of a scheme.
-/

noncomputable section

namespace Langlands.Geometry.EtaleAdicSystem

open CategoryTheory AlgebraicGeometry Opposite

universe u

variable (X : Scheme.{u}) {R : Type u} [CommRing R] (I : Ideal R)

/-- Change the coefficient ring of an etale sheaf by an ideal quotient. -/
def quotientCoefficients :
    CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R) ⥤
      CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} (R ⧸ I)) :=
  Langlands.Sheaf.AdicSystem.quotientCoefficients (Scheme.smallEtaleTopology X) I

/-- The constructed inverse coefficient system of an etale module sheaf. -/
def functor :
    CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R) ⥤
      (ℕᵒᵖ ⥤ CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R)) :=
  Langlands.Sheaf.AdicSystem.functor (Scheme.smallEtaleTopology X) I

/-- Constant etale coefficient systems associated to actual module reductions. -/
def constantSystemFunctor :
    ModuleCat.{u} R ⥤
      (ℕᵒᵖ ⥤ CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R)) :=
  Langlands.Sheaf.AdicSystem.constantSystemFunctor (Scheme.smallEtaleTopology X) I

/-- The ordinary inverse-limit etale sheaf of the reductions. -/
def inverseLimit (F : CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R)) :
    CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R) :=
  Langlands.Sheaf.AdicSystem.inverseLimit (Scheme.smallEtaleTopology X) I F

/-- The constant system modulo powers of the ideal generated by an integer `ell`. -/
def ellPowerConstantSystem (ell : ℕ) (M : ModuleCat.{u} R) :
    ℕᵒᵖ ⥤ CategoryTheory.Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u} R) :=
  (constantSystemFunctor X (Ideal.span {(ell : R)})).obj M

end Langlands.Geometry.EtaleAdicSystem
