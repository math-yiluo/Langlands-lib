import Mathlib.GroupTheory.Commutator.Basic

/-! # Commutator bounds for generated subgroups with explicit normalization -/

universe u v w

open scoped commutatorElement

namespace Langlands.GroupTheory

variable {G : Type u} [Group G]

/-- Elements that normalize K and commute modulo K with every element of B. -/
def normalizingCentralizerModulo (B K : Subgroup G) : Subgroup G :=
    { carrier := {x | x ∈ (Subgroup.normalizer (K : Set G)) ∧ ∀ y ∈ B, ⁅x, y⁆ ∈ K}
      one_mem' := ⟨(Subgroup.normalizer (K : Set G)).one_mem, fun y _ => by
        simpa only [commutatorElement_one_left] using K.one_mem⟩
      mul_mem' := by
        intro a b ha hb
        refine ⟨(Subgroup.normalizer (K : Set G)).mul_mem ha.1 hb.1, fun y hy => ?_⟩
        rw [commutatorElement_mul_left_eq_conj_mul]
        exact K.mul_mem
          ((Subgroup.mem_normalizer_iff.mp ha.1 _).mp (hb.2 y hy)) (ha.2 y hy)
      inv_mem' := by
        intro a ha
        refine ⟨(Subgroup.normalizer (K : Set G)).inv_mem ha.1, fun y hy => ?_⟩
        rw [commutatorElement_inv_left, ← commutatorElement_inv]
        have h := (Subgroup.mem_normalizer_iff.mp ((Subgroup.normalizer (K : Set G)).inv_mem ha.1)
          (⁅a, y⁆⁻¹)).mp (K.inv_mem (ha.2 y hy))
        simpa only [inv_inv] using h }
/-- Bounds against a fixed subgroup pass to the subgroup generated by a family
when every generating subgroup normalizes the target. -/
theorem commutator_iSup_left_le_of_normalizes
    {ι : Sort v} (A : ι → Subgroup G) (B K : Subgroup G)
    (hnorm : ∀ j, A j ≤ (Subgroup.normalizer (K : Set G)))
    (hcomm : ∀ j, ⁅A j, B⁆ ≤ K) :
    ⁅⨆ j, A j, B⁆ ≤ K := by
  have hle : (⨆ j, A j) ≤ normalizingCentralizerModulo B K := by
    refine iSup_le fun j x hx => ?_
    exact ⟨hnorm j hx, fun y hy => Subgroup.commutator_le.mp (hcomm j) x hx y hy⟩
  exact Subgroup.commutator_le.mpr fun x hx y hy => (hle hx).2 y hy

/-- Pairwise commutator bounds pass to both generated subgroups when both
generating families normalize the target. -/
theorem commutator_iSup_le_of_normalizes
    {ι : Sort v} {κ : Sort w} (A : ι → Subgroup G) (B : κ → Subgroup G)
    (K : Subgroup G)
    (hA : ∀ j, A j ≤ (Subgroup.normalizer (K : Set G))) (hB : ∀ l, B l ≤ (Subgroup.normalizer (K : Set G)))
    (hcomm : ∀ j l, ⁅A j, B l⁆ ≤ K) :
    ⁅⨆ j, A j, ⨆ l, B l⁆ ≤ K := by
  apply commutator_iSup_left_le_of_normalizes A (⨆ l, B l) K hA
  intro j
  rw [Subgroup.commutator_comm]
  apply commutator_iSup_left_le_of_normalizes B (A j) K hB
  intro l
  rw [Subgroup.commutator_comm]
  exact hcomm j l

/-- To show that a subgroup normalizes a generated subgroup it suffices to
bound its commutators with every generator. -/
theorem le_normalizer_iSup_of_commutator_le
    {ι : Sort v} (A : Subgroup G) (B : ι → Subgroup G)
    (hcomm : ∀ j, ⁅A, B j⁆ ≤ ⨆ l, B l) :
    A ≤ Subgroup.normalizer (⨆ j, B j : Subgroup G) := by
  rw [Subgroup.le_normalizer_iff_commutator_le_right, Subgroup.commutator_comm]
  apply commutator_iSup_left_le_of_normalizes B A (⨆ j, B j)
  · intro j
    exact (le_iSup B j).trans Subgroup.le_normalizer
  · intro j
    rw [Subgroup.commutator_comm]
    exact hcomm j

end Langlands.GroupTheory
