import Langlands.GroupTheory.HeightCollection

/-! # Height subgroups and their ordered coordinates -/

noncomputable section

universe v

open scoped commutatorElement

namespace Langlands.GroupTheory.HeightFiltration

open Langlands.GroupScheme.RelativeRoot.CentralExtension

variable {G : Type v} [Group G] {n : ℕ}

/-- Keep a factor if its height is at least the level. -/
def factor (H : Fin n → Subgroup G) (w : Fin n → ℕ) (d : ℕ) (i : Fin n) :
    Subgroup G :=
  ⨆ (_ : d ≤ w i), H i

/-- The subgroup generated by all factors of height at least `d`. -/
def level (H : Fin n → Subgroup G) (w : Fin n → ℕ) (d : ℕ) : Subgroup G :=
  ⨆ i, factor H w d i

variable (H : Fin n → Subgroup G) (w : Fin n → ℕ)

theorem factor_of_le {d : ℕ} {i : Fin n} (h : d ≤ w i) :
    factor H w d i = H i :=
  iSup_pos h

theorem factor_of_lt {d : ℕ} {i : Fin n} (h : w i < d) :
    factor H w d i = ⊥ :=
  iSup_neg (Nat.not_le.mpr h)

theorem factor_le (d : ℕ) (i : Fin n) : factor H w d i ≤ H i :=
  iSup_le fun _ => le_rfl

theorem le_level {d : ℕ} {i : Fin n} (h : d ≤ w i) : H i ≤ level H w d := by
  rw [← factor_of_le H w h]
  exact le_iSup (factor H w d) i

theorem antitone_level : Antitone (level H w) := by
  intro d e hde
  exact iSup_le fun i => iSup_le fun hi =>
    le_level H w (hde.trans hi)

theorem level_zero : level H w 0 = ⨆ i, H i :=
  iSup_congr fun _ => factor_of_le H w (Nat.zero_le _)

theorem level_one (hw : ∀ i, 0 < w i) : level H w 1 = ⨆ i, H i :=
  iSup_congr fun i => factor_of_le H w (hw i)

theorem level_eq_bot {d : ℕ} (hd : ∀ i, w i < d) : level H w d = ⊥ :=
  le_bot_iff.mp (iSup_le fun i => (factor_of_lt H w (hd i)).le)

/-- The sum bound on generators implies the strict-height bound needed for
ordered collection after discarding any initial heights. -/
theorem commutator_factor_le
    (hw : ∀ i, 0 < w i)
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j)) (d : ℕ) (i j : Fin n) :
    ⁅factor H w d i, factor H w d j⁆ ≤
      ⨆ k, ⨆ (_ : max (w i) (w j) < w k), factor H w d k := by
  rcases lt_or_ge (w i) d with hi | hi
  · rw [factor_of_lt H w hi, Subgroup.commutator_bot_left]
    exact bot_le
  rcases lt_or_ge (w j) d with hj | hj
  · rw [factor_of_lt H w hj, Subgroup.commutator_bot_right]
    exact bot_le
  rw [factor_of_le H w hi, factor_of_le H w hj]
  refine (hc i j).trans (iSup_le fun k => iSup_le fun hk => ?_)
  have hmax : max (w i) (w j) < w k := by
    have := hw i
    have := hw j
    omega
  refine le_iSup_of_le k (le_iSup_of_le hmax ?_)
  rw [factor_of_le H w (by omega : d ≤ w k)]

/-- Every element of a level has ordered coordinates trivial at lower heights. -/
theorem exists_coords
    (hw : ∀ i, 0 < w i)
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j))
    (d : ℕ) {g : G} (hg : g ∈ level H w d) :
    ∃ c : Fin n → G, (∀ i, c i ∈ H i) ∧
      (∀ i, w i < d → c i = 1) ∧ (List.ofFn c).prod = g := by
  have hrange := HeightCollection.range_orderedProduct_eq_iSup
    (factor H w d) w (commutator_factor_le H w hw hc d)
  obtain ⟨a, ha⟩ := (show g ∈ Set.range
      (orderedProduct (fun i => (factor H w d i).subtype)) by
    rw [hrange]
    exact hg)
  refine ⟨fun i => (a i : G), fun i => factor_le H w d i (a i).property,
    fun i hi => ?_, ha⟩
  exact Subgroup.mem_bot.mp ((factor_of_lt H w hi).le (a i).property)

/-- Every root factor normalizes every height subgroup. -/
theorem le_normalizer_level
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j))
    (d : ℕ) (i : Fin n) : H i ≤ Subgroup.normalizer (level H w d : Set G) := by
  apply Subgroup.le_normalizer_iff.mpr
  intro x hx y hy
  refine Subgroup.iSup_induction (factor H w d)
    (C := fun y => x * y * x⁻¹ ∈ level H w d) hy
    (fun j y hy => ?_) ?_ (fun a b ha hb => ?_)
  · rcases lt_or_ge (w j) d with hj | hj
    · rw [factor_of_lt H w hj] at hy
      rw [Subgroup.mem_bot.mp hy, mul_one, mul_inv_cancel]
      exact one_mem _
    rw [factor_of_le H w hj] at hy
    have hcomm : ⁅x, y⁆ ∈ level H w d :=
      antitone_level H w (by omega : d ≤ w i + w j)
        (hc i j (Subgroup.commutator_mem_commutator hx hy))
    rw [show x * y * x⁻¹ = ⁅x, y⁆ * y by
      rw [commutatorElement_def]; group]
    exact mul_mem hcomm (le_level H w hj hy)
  · simp only [mul_one, mul_inv_cancel]
    exact one_mem _
  · rw [show x * (a * b) * x⁻¹ = (x * a * x⁻¹) * (x * b * x⁻¹) by group]
    exact mul_mem ha hb

/-- Every height subgroup is normal in the subgroup generated by the factors. -/
theorem normal_level_subgroupOf
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j)) (d : ℕ) :
    ((level H w d).subgroupOf (⨆ i, H i)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    (iSup_le fun i => le_normalizer_level H w hc d i)

/-- In particular each next level is normal in the current level. -/
theorem normal_next
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j)) (d : ℕ) :
    ((level H w (d + 1)).subgroupOf (level H w d)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    (iSup_le fun i => (factor_le H w d i).trans (le_normalizer_level H w hc _ i))

end Langlands.GroupTheory.HeightFiltration
