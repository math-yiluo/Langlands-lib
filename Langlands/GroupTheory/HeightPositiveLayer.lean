import Langlands.GroupTheory.HeightLayer

/-! # Positive layers with possibly zero weights -/

noncomputable section

universe v

open scoped commutatorElement

namespace Langlands.GroupTheory.HeightFiltration

open Langlands.GroupScheme.RelativeRoot.CentralExtension

variable {G : Type v} [Group G] {n : ℕ}
variable (H : Fin n → Subgroup G) (w : Fin n → ℕ)

/-- A positive cutoff supplies the strict increase needed for collection even
when some of the original weights vanish. -/
theorem commutator_factor_le_of_pos
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j))
    {d : ℕ} (hd : 0 < d) (i j : Fin n) :
    ⁅factor H w d i, factor H w d j⁆ ≤
      ⨆ k, ⨆ (_ : max (w i) (w j) < w k), factor H w d k := by
  rcases lt_or_ge (w i) d with hi | hi
  · rw [factor_of_lt H w hi, Subgroup.commutator_bot_left]
    exact bot_le
  rcases lt_or_ge (w j) d with hj | hj
  · rw [factor_of_lt H w hj, Subgroup.commutator_bot_right]
    exact bot_le
  rw [factor_of_le H w hi, factor_of_le H w hj]
  refine (hc i j).trans (iSup_le fun k => iSup_le fun hk => ?_)
  have hmax : max (w i) (w j) < w k := by omega
  refine le_iSup_of_le k (le_iSup_of_le hmax ?_)
  rw [factor_of_le H w (by omega : d ≤ w k)]

/-- Every positive level has ordered coordinates trivial at all lower weights,
without a positivity assumption on the discarded factors. -/
theorem exists_coords_of_pos
    (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j))
    {d : ℕ} (hd : 0 < d) {g : G} (hg : g ∈ level H w d) :
    ∃ c : Fin n → G, (∀ i, c i ∈ H i) ∧
      (∀ i, w i < d → c i = 1) ∧ (List.ofFn c).prod = g := by
  have hrange := HeightCollection.range_orderedProduct_eq_iSup
    (factor H w d) w (commutator_factor_le_of_pos H w hc hd)
  obtain ⟨a, ha⟩ := (show g ∈ Set.range
      (orderedProduct (fun i => (factor H w d i).subtype)) by
    rw [hrange]
    exact hg)
  refine ⟨fun i => (a i : G), fun i => factor_le H w d i (a i).property,
    fun i hi => ?_, ha⟩
  exact Subgroup.mem_bot.mp ((factor_of_lt H w hi).le (a i).property)

end Langlands.GroupTheory.HeightFiltration

namespace Langlands.GroupTheory.HeightLayer

open HeightFiltration
open Langlands.GroupScheme.RelativeRoot.CentralExtension

variable {G : Type v} [Group G] {n : ℕ}
variable (H : Fin n → Subgroup G) (w : Fin n → ℕ)
variable (hc : ∀ i j, ⁅H i, H j⁆ ≤ level H w (w i + w j))

/-- Uniqueness of full ordered coordinates gives injectivity at a positive
layer even when other factors have zero weight. -/
theorem layerMap_injective_of_pos
    (hu : Function.Injective (orderedProduct (fun i => (H i).subtype)))
    (d : ℕ) (hd : 0 < d) :
    Function.Injective (layerMap H w hc d hd) := by
  apply (layerMap H w hc d hd).ker_eq_bot_iff.mp
  apply le_bot_iff.mp
  intro a ha
  have ha' : layerMap H w hc d hd a = 1 := ha
  rw [layerMap_eq_projection H w hc d hd] at ha'
  have hnext := (projection_eq_one_iff H w hc d _).mp ha'
  obtain ⟨b, hb, hlow, hprod⟩ :=
    exists_coords_of_pos H w hc (Nat.zero_lt_succ d) hnext
  let A : ∀ i, H i := fun i => ⟨(a i : G), exactFactor_le H w d i (a i).property⟩
  let B : ∀ i, H i := fun i => ⟨b i, hb i⟩
  have hAB : orderedProduct (fun i => (H i).subtype) A =
      orderedProduct (fun i => (H i).subtype) B := hprod.symm
  have hcoords := hu hAB
  apply Subgroup.mem_bot.mpr
  funext i
  apply Subtype.ext
  change (a i : G) = 1
  by_cases hi : w i = d
  · have hei : (a i : G) = b i :=
      congrArg (fun c : ∀ i, H i => ((c i : H i) : G)) hcoords
    exact hei.trans (hlow i (by omega))
  · exact Subgroup.mem_bot.mp ((exactFactor_of_ne H w hi).le (a i).property)

/-- Positive layers are generated by their exact-weight coordinates with no
positivity condition on the full weight family. -/
theorem layerMap_surjective_of_pos (d : ℕ) (hd : 0 < d) :
    Function.Surjective (layerMap H w hc d hd) := by
  classical
  intro z
  obtain ⟨g, rfl⟩ := projection_surjective H w hc d z
  obtain ⟨c, hcH, hlow, hprod⟩ := exists_coords_of_pos H w hc hd g.property
  have hcLevel (i : Fin n) : c i ∈ level H w d := by
    by_cases hi : d ≤ w i
    · exact le_level H w hi (hcH i)
    · rw [hlow i (Nat.lt_of_not_ge hi)]
      exact one_mem _
  let b : Fin n → level H w d := fun i => ⟨c i, hcLevel i⟩
  let a : ∀ i, exactFactor H w d i := fun i =>
    if hi : w i = d then ⟨c i, (exactFactor_of_eq H w hi).symm ▸ hcH i⟩ else 1
  have hprodLevel : (List.ofFn b).prod = g := by
    apply Subtype.ext
    change (level H w d).subtype ((List.ofFn b).prod) = (g : G)
    rw [map_list_prod, List.map_ofFn]
    exact hprod
  have hcoord (i : Fin n) :
      coordinateMap H w hc d i (a i) = projection H w hc d (b i) := by
    by_cases hi : w i = d
    · simp only [a, dite_eq_left hi]
      rfl
    · have ha : a i = 1 := dite_eq_right hi
      rw [ha, map_one]
      symm
      apply (projection_eq_one_iff H w hc d _).mpr
      change c i ∈ level H w (d + 1)
      rcases lt_or_gt_of_ne hi with hi' | hi'
      · rw [hlow i hi']
        exact one_mem _
      · exact le_level H w (by omega) (hcH i)
  refine ⟨a, ?_⟩
  change (List.ofFn fun i => coordinateMap H w hc d i (a i)).prod = _
  simp_rw [hcoord]
  rw [← hprodLevel, map_list_prod, List.map_ofFn]
  rfl

/-- The quotient at a positive weight is the product of the exact-weight
factors, allowing zero weights elsewhere in the full coordinate chart. -/
def layerEquivOfPos
    (hu : Function.Injective (orderedProduct (fun i => (H i).subtype)))
    (d : ℕ) (hd : 0 < d) :
    (∀ i, exactFactor H w d i) ≃* Layer H w hc d :=
  MulEquiv.ofBijective (layerMap H w hc d hd)
    ⟨layerMap_injective_of_pos H w hc hu d hd,
      layerMap_surjective_of_pos H w hc d hd⟩

end Langlands.GroupTheory.HeightLayer
