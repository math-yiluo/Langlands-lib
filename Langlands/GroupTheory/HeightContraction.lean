import Langlands.GroupTheory.HeightCollection

/-! # Fixed cosets of an endomorphism of a height-filtered ordered product -/

noncomputable section

universe v

open scoped commutatorElement

namespace Langlands.GroupTheory.HeightContraction

open Langlands.GroupScheme.RelativeRoot.CentralExtension

/-- Splitting off the first factor of an ordered product whose earlier factors are trivial. -/
theorem prod_ofFn_eq_mul_update {M : Type*} [Monoid M] :
    ∀ {n : ℕ} (f : Fin n → M) (t : Fin n), (∀ r, r < t → f r = 1) →
      (List.ofFn f).prod = f t * (List.ofFn (Function.update f t 1)).prod
  | 0, _, t, _ => t.elim0
  | n + 1, f, t, h => by
    revert h
    refine Fin.cases (fun _ => ?_) (fun t h => ?_) t
    · rw [List.ofFn_succ, List.ofFn_succ, List.prod_cons, List.prod_cons,
        Function.update_self, one_mul]
      congr 2
    · have h0 : f 0 = 1 := h 0 (Fin.succ_pos t)
      have ih := prod_ofFn_eq_mul_update (fun i : Fin n => f i.succ) t
        (fun r hr => h r.succ (Fin.succ_lt_succ_iff.mpr hr))
      rw [List.ofFn_succ, List.ofFn_succ, List.prod_cons, List.prod_cons, h0, one_mul,
        Function.update_of_ne (Fin.succ_ne_zero t).symm, h0, one_mul, ih]
      rw [show (fun i : Fin n => Function.update f t.succ 1 i.succ) =
          Function.update (fun i : Fin n => f i.succ) t 1 from by
        funext i
        simp only [Function.update_apply, Fin.succ_inj]]

section Tail

variable {G : Type v} [Group G] {n : ℕ} (H : Fin n → Subgroup G)

/-- The factor `H r` if `t ≤ r`, and `⊥` otherwise. -/
def tailFactor (t : ℕ) (r : Fin n) : Subgroup G :=
  ⨆ (_ : t ≤ (r : ℕ)), H r

/-- The subgroup generated by the factors with index at least `t`. -/
def tail (t : ℕ) : Subgroup G :=
  ⨆ r, tailFactor H t r

theorem tailFactor_of_le {t : ℕ} {r : Fin n} (h : t ≤ (r : ℕ)) : tailFactor H t r = H r :=
  iSup_pos h

theorem tailFactor_of_lt {t : ℕ} {r : Fin n} (h : (r : ℕ) < t) : tailFactor H t r = ⊥ :=
  iSup_neg (Nat.not_le.mpr h)

theorem tailFactor_le (t : ℕ) (r : Fin n) : tailFactor H t r ≤ H r :=
  iSup_le fun _ => le_rfl

theorem le_tail {t : ℕ} {r : Fin n} (h : t ≤ (r : ℕ)) : H r ≤ tail H t := by
  rw [← tailFactor_of_le H h]
  exact le_iSup (tailFactor H t) r

theorem tail_zero : tail H 0 = ⨆ r, H r :=
  iSup_congr fun _ => tailFactor_of_le H (Nat.zero_le _)

theorem tail_eq_bot {t : ℕ} (h : n ≤ t) : tail H t = ⊥ :=
  le_bot_iff.mp (iSup_le fun r => (tailFactor_of_lt H (lt_of_lt_of_le r.2 h)).le)

variable (w : Fin n → ℕ)

/-- With monotone heights, the commutator bound only involves later factors. -/
theorem lt_of_height_lt (hw : Monotone w) {r k : Fin n} (h : w r < w k) : r < k := by
  by_contra hkr
  exact absurd (hw (not_lt.mp hkr)) (not_le.mpr h)

theorem commutator_tailFactor_le (hw : Monotone w)
    (hcH : ∀ i j, ⁅H i, H j⁆ ≤ ⨆ k, ⨆ (_ : max (w i) (w j) < w k), H k) (t : ℕ)
    (i j : Fin n) :
    ⁅tailFactor H t i, tailFactor H t j⁆ ≤
      ⨆ k, ⨆ (_ : max (w i) (w j) < w k), tailFactor H t k := by
  rcases lt_or_ge (i : ℕ) t with hi | hi
  · rw [tailFactor_of_lt H hi, Subgroup.commutator_bot_left]
    exact bot_le
  rcases lt_or_ge (j : ℕ) t with hj | hj
  · rw [tailFactor_of_lt H hj, Subgroup.commutator_bot_right]
    exact bot_le
  rw [tailFactor_of_le H hi, tailFactor_of_le H hj]
  refine (hcH i j).trans (iSup_mono fun k => iSup_mono' fun hk => ⟨hk, ?_⟩)
  have hik : i < k := lt_of_height_lt w hw (lt_of_le_of_lt (le_max_left _ _) hk)
  rw [tailFactor_of_le H (hi.trans (le_of_lt hik))]

/-- Ordered coordinates of an element of a tail, trivial before the tail starts. -/
theorem exists_coords (hw : Monotone w)
    (hcH : ∀ i j, ⁅H i, H j⁆ ≤ ⨆ k, ⨆ (_ : max (w i) (w j) < w k), H k) (t : ℕ)
    {u : G} (hu : u ∈ tail H t) :
    ∃ c : Fin n → G, (∀ r, c r ∈ H r) ∧ (∀ r : Fin n, (r : ℕ) < t → c r = 1) ∧
      (List.ofFn c).prod = u := by
  have hrange := HeightCollection.range_orderedProduct_eq_iSup (tailFactor H t) w
    (commutator_tailFactor_le H w hw hcH t)
  obtain ⟨a, ha⟩ := (show u ∈ Set.range
      (orderedProduct (fun r => (tailFactor H t r).subtype)) by
    rw [hrange]
    exact hu)
  refine ⟨fun r => (a r : G), fun r => tailFactor_le H t r (a r).property, fun r hr => ?_, ha⟩
  have key : ∀ y ∈ tailFactor H t r, y = 1 := fun y hy => by
    rw [tailFactor_of_lt H hr] at hy
    exact Subgroup.mem_bot.mp hy
  exact key _ (a r).property

/-- The factor at index `t` normalizes the tail starting after it. -/
theorem conj_mem_tail_succ (hw : Monotone w)
    (hcH : ∀ i j, ⁅H i, H j⁆ ≤ ⨆ k, ⨆ (_ : max (w i) (w j) < w k), H k) (τ : Fin n)
    {g : G} (hg : g ∈ H τ) {y : G} (hy : y ∈ tail H ((τ : ℕ) + 1)) :
    g * y * g⁻¹ ∈ tail H ((τ : ℕ) + 1) := by
  refine Subgroup.iSup_induction (tailFactor H ((τ : ℕ) + 1))
    (C := fun y => g * y * g⁻¹ ∈ tail H ((τ : ℕ) + 1)) hy (fun r y hy => ?_) ?_
    (fun y₁ y₂ h₁ h₂ => ?_)
  · rcases lt_or_ge (r : ℕ) ((τ : ℕ) + 1) with hr | hr
    · rw [tailFactor_of_lt H hr] at hy
      rw [Subgroup.mem_bot.mp hy, mul_one, mul_inv_cancel]
      exact one_mem _
    rw [tailFactor_of_le H hr] at hy
    have hc : ⁅g, y⁆ ∈ tail H ((τ : ℕ) + 1) := by
      refine (hcH τ r).trans (iSup_le fun k => iSup_le fun hk => le_tail H ?_)
        (Subgroup.commutator_mem_commutator hg hy)
      have hrk : r < k := lt_of_height_lt w hw (lt_of_le_of_lt (le_max_right _ _) hk)
      exact hr.trans (le_of_lt hrk)
    rw [show g * y * g⁻¹ = ⁅g, y⁆ * y by rw [commutatorElement_def]; group]
    exact mul_mem hc (le_tail H hr hy)
  · simp only [mul_one, mul_inv_cancel]
    exact one_mem _
  · rw [show g * (y₁ * y₂) * g⁻¹ = (g * y₁ * g⁻¹) * (g * y₂ * g⁻¹) by group]
    exact mul_mem h₁ h₂

/-- An endomorphism preserving every factor preserves every tail. -/
theorem map_mem_tail (s : G →* G) (hsH : ∀ i, ∀ h ∈ H i, s h ∈ H i) (t : ℕ) {y : G}
    (hy : y ∈ tail H t) : s y ∈ tail H t := by
  refine Subgroup.iSup_induction (tailFactor H t) (C := fun y => s y ∈ tail H t) hy
    (fun r y hy => ?_) ?_ (fun y₁ y₂ h₁ h₂ => ?_)
  · rcases lt_or_ge (r : ℕ) t with hr | hr
    · rw [tailFactor_of_lt H hr] at hy
      rw [Subgroup.mem_bot.mp hy, map_one]
      exact one_mem _
    rw [tailFactor_of_le H hr] at hy
    exact le_tail H hr (hsH r y hy)
  · simp only [map_one]
    exact one_mem _
  · rw [map_mul]
    exact mul_mem h₁ h₂

end Tail

section Main

variable {G : Type v} [Group G] {n : ℕ} (H X : Fin n → Subgroup G) (w : Fin n → ℕ)

/-- **Fixed cosets of a contracting endomorphism.** Let `H` be a finite family of subgroups
with monotone heights `w`, commutators of increasing height and injective ordered products,
and let `X i ≤ H i` be subgroups with the same commutator property. Let `s` be an
endomorphism preserving every `H i` and `X i` such that `h⁻¹ s(h) ∈ X i` forces `h ∈ X i`
for `h ∈ H i`. Then for every `u` in the subgroup generated by the `H i`,
`u⁻¹ s(u) ∈ ⨆ X` forces `u ∈ ⨆ X`. -/
theorem mem_iSup_of_inv_mul_map_mem (hw : Monotone w)
    (hcH : ∀ i j, ⁅H i, H j⁆ ≤ ⨆ k, ⨆ (_ : max (w i) (w j) < w k), H k)
    (hcX : ∀ i j, ⁅X i, X j⁆ ≤ ⨆ k, ⨆ (_ : max (w i) (w j) < w k), X k)
    (hXH : ∀ i, X i ≤ H i)
    (hinj : ∀ f g : Fin n → G, (∀ i, f i ∈ H i) → (∀ i, g i ∈ H i) →
      (List.ofFn f).prod = (List.ofFn g).prod → f = g)
    (s : G →* G) (hsH : ∀ i, ∀ h ∈ H i, s h ∈ H i) (hsX : ∀ i, ∀ h ∈ X i, s h ∈ X i)
    (hrank : ∀ i, ∀ h ∈ H i, h⁻¹ * s h ∈ X i → h ∈ X i)
    {u : G} (hu : u ∈ ⨆ i, H i) (hφ : u⁻¹ * s u ∈ ⨆ i, X i) : u ∈ ⨆ i, X i := by
  classical
  have hXrange := HeightCollection.range_orderedProduct_eq_iSup X w hcX
  suffices key : ∀ m t : ℕ, n - t = m → ∀ u ∈ tail H t, u⁻¹ * s u ∈ ⨆ i, X i →
      u ∈ ⨆ i, X i by
    exact key (n - 0) 0 rfl u (by rwa [tail_zero]) hφ
  intro m
  induction m with
  | zero =>
    intro t ht u hu _
    rw [tail_eq_bot H (Nat.sub_eq_zero_iff_le.mp ht), Subgroup.mem_bot] at hu
    rw [hu]
    exact one_mem _
  | succ m ih =>
    intro t ht u hu hφ
    have htn : t < n := by omega
    let τ : Fin n := ⟨t, htn⟩
    obtain ⟨c, hcH', hc1, hcu⟩ := exists_coords H w hw hcH t hu
    set a := c τ with ha_def
    have haH : a ∈ H τ := hcH' τ
    set u' := (List.ofFn (Function.update c τ 1)).prod with hu'_def
    have hsplit : u = a * u' := by
      rw [← hcu]
      exact prod_ofFn_eq_mul_update c τ (fun r hr => hc1 r hr)
    have hu'tail : u' ∈ tail H (t + 1) := by
      refine (tail H (t + 1)).list_prod_mem fun z hz => ?_
      obtain ⟨r, rfl⟩ := List.mem_ofFn.mp hz
      by_cases hrτ : r = τ
      · rw [hrτ, Function.update_self]
        exact one_mem _
      rw [Function.update_of_ne hrτ]
      rcases lt_or_ge (r : ℕ) t with hrt | hrt
      · rw [hc1 r hrt]
        exact one_mem _
      have hr : t + 1 ≤ (r : ℕ) := by
        have : (r : ℕ) ≠ t := fun h => hrτ (Fin.ext h)
        omega
      exact le_tail H hr (hcH' r)
    -- the coordinates of `u⁻¹ s(u)` in `X`
    obtain ⟨x, hx⟩ := (show u⁻¹ * s u ∈ Set.range
        (orderedProduct (fun r => (X r).subtype)) by
      rw [hXrange]
      exact hφ)
    set φa := a⁻¹ * s a with hφa_def
    have hφaH : φa ∈ H τ := mul_mem (inv_mem haH) (hsH τ a haH)
    set m' := φa⁻¹ * u'⁻¹ * φa * s u' with hm'_def
    have hm'tail : m' ∈ tail H (t + 1) := by
      have h1 : φa⁻¹ * u'⁻¹ * φa⁻¹⁻¹ ∈ tail H (t + 1) :=
        conj_mem_tail_succ H w hw hcH τ (inv_mem hφaH) (inv_mem hu'tail)
      rw [inv_inv] at h1
      exact mul_mem h1 (map_mem_tail H s hsH (t + 1) hu'tail)
    have hφu : u⁻¹ * s u = φa * m' := by
      rw [hsplit, hm'_def, hφa_def, map_mul]
      group
    obtain ⟨d, hdH, hd1, hdm⟩ := exists_coords H w hw hcH (t + 1) hm'tail
    have hdτ : d τ = 1 := hd1 τ (Nat.lt_succ_self t)
    set e := Function.update d τ φa with he_def
    have heprod : (List.ofFn e).prod = u⁻¹ * s u := by
      rw [prod_ofFn_eq_mul_update e τ (fun r hr => by
          rw [he_def, Function.update_of_ne (ne_of_lt hr)]
          exact hd1 r (Nat.lt_succ_of_lt hr)),
        he_def, Function.update_self, Function.update_idem]
      have hd : Function.update d τ 1 = d := by
        rw [← hdτ, Function.update_eq_self]
      rw [hd, hdm, hφu]
    have hxe : (fun r => (x r : G)) = e := by
      refine hinj _ _ (fun r => hXH r (x r).property) (fun r => ?_) (hx.trans heprod.symm)
      by_cases hrτ : r = τ
      · rw [hrτ, he_def, Function.update_self]
        exact hφaH
      rw [he_def, Function.update_of_ne hrτ]
      exact hdH r
    have hφaX : φa ∈ X τ := by
      have h := congrFun hxe τ
      rw [he_def, Function.update_self] at h
      rw [← h]
      exact (x τ).property
    have haX : a ∈ X τ := hrank τ a haH hφaX
    set y := a * u' * a⁻¹ with hy_def
    have hytail : y ∈ tail H (t + 1) := conj_mem_tail_succ H w hw hcH τ haH hu'tail
    have hφy : y⁻¹ * s y = a * (u⁻¹ * s u) * (s a)⁻¹ := by
      rw [hy_def, hsplit, map_mul, map_mul, map_inv]
      group
    have hφyX : y⁻¹ * s y ∈ ⨆ i, X i := by
      rw [hφy]
      have haX' : a ∈ ⨆ i, X i := Subgroup.mem_iSup_of_mem τ haX
      have hsaX : s a ∈ ⨆ i, X i := Subgroup.mem_iSup_of_mem τ (hsX τ a haX)
      exact mul_mem (mul_mem haX' hφ) (inv_mem hsaX)
    have hyX : y ∈ ⨆ i, X i := ih (t + 1) (by omega) y hytail hφyX
    have hu_eq : u = y * a := by
      rw [hy_def, hsplit]
      group
    rw [hu_eq]
    exact mul_mem hyX (Subgroup.mem_iSup_of_mem τ haX)

end Main

end Langlands.GroupTheory.HeightContraction
