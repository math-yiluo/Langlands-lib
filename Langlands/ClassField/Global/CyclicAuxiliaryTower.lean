import Langlands.ClassField.Global.CommonGaloisOverfield
import Langlands.Global.Arithmetic.CyclotomicAuxiliary

/-! # Cyclic auxiliary towers for global invariant descent -/

noncomputable section

namespace Langlands.ClassField.Global

universe u

private theorem isCyclic_of_compositum
    (F E K L : Type u) [Field F] [Field E] [Field K] [Field L]
    [Algebra F E] [Algebra F K] [Algebra F L] [Algebra E L] [Algebra K L]
    [IsScalarTower F E L] [IsScalarTower F K L] [Normal F K]
    [IsCyclic (K ≃ₐ[F] K)]
    (hgen : (IsScalarTower.toAlgHom F E L).fieldRange ⊔
      (IsScalarTower.toAlgHom F K L).fieldRange = ⊤) : IsCyclic (L ≃ₐ[E] L) := by
  apply isCyclic_of_injective (IntermediateField.restrictRestrictAlgEquivMapHom F K E L)
  apply (injective_iff_map_eq_one _).2
  intro σ hσ
  let τ : L ≃ₐ[F] L := σ.restrictScalars F
  let U : IntermediateField F L :=
    { τ.toRingHom.eqLocusField (RingHom.id L) with
      algebraMap_mem' := fun x => τ.commutes x }
  have hU : (⊤ : IntermediateField F L) ≤ U := by
    rw [← hgen]
    apply sup_le
    · rintro _ ⟨x, rfl⟩
      exact σ.commutes x
    · rintro _ ⟨x, rfl⟩
      change τ (algebraMap K L x) = algebraMap K L x
      have hx := τ.restrictNormal_commutes K x
      have heq : τ.restrictNormal K = 1 := hσ
      rw [heq] at hx
      exact hx.symm
  apply AlgEquiv.ext
  intro x
  exact hU (by trivial)

private theorem map_fieldRange {F K L M : Type u} [Field F] [Field K] [Field L] [Field M]
    [Algebra F K] [Algebra F L] [Algebra F M] (f : K →ₐ[F] L) (g : L →ₐ[F] M) :
    f.fieldRange.map g = (g.comp f).fieldRange := by
  ext x
  simp [IntermediateField.mem_map, AlgHom.mem_fieldRange]

variable (F E L₁ L₂ : Type u) [Field F] [Field E] [Field L₁] [Field L₂]
  [Algebra F E] [Algebra F L₁] [Algebra F L₂] [Algebra E L₁] [Algebra E L₂]
  [IsScalarTower F E L₁] [IsScalarTower F E L₂]
  [NumberField F] [NumberField E] [NumberField L₁] [NumberField L₂]
  [IsGalois F L₁] [IsGalois F L₂]

/-- The chosen common overfield is generated by the two embedded fields. -/
theorem commonGaloisOverfield_generated :
    let M := commonGaloisOverfield F E L₁ L₂
    (IsScalarTower.toAlgHom F L₁ M.carrier).fieldRange ⊔
      (IsScalarTower.toAlgHom F L₂ M.carrier).fieldRange = ⊤ := by
  dsimp only [commonGaloisOverfield]
  apply IntermediateField.map_injective (IntermediateField.val _)
  rw [IntermediateField.map_sup]
  rw [map_fieldRange, map_fieldRange]
  change _ = IntermediateField.lift ⊤
  rw [IntermediateField.lift_top]
  rfl

/-- A cyclic right field gives a cyclic extension of the left field in the
chosen compositum. -/
theorem commonGaloisOverfield_isCyclic_left [IsCyclic (L₂ ≃ₐ[F] L₂)] :
    let M := commonGaloisOverfield F E L₁ L₂
    IsCyclic (M.carrier ≃ₐ[L₁] M.carrier) :=
  isCyclic_of_compositum F L₁ L₂ (commonGaloisOverfield F E L₁ L₂).carrier
    (commonGaloisOverfield_generated F E L₁ L₂)

end Langlands.ClassField.Global

namespace Langlands.ClassField.Global

universe u

variable (F E : Type u) [Field F] [NumberField F] [Field E] [NumberField E]
  [Algebra F E] [IsGalois F E]

/-- An auxiliary cyclic extension of degree `n`, together with a common Galois
overfield whose extension over the given field `E` is cyclic. -/
structure CyclicAuxiliaryTower (n : ℕ) where
  auxiliary : Type u
  [field : Field auxiliary]
  [numberField : NumberField auxiliary]
  [algebra : Algebra F auxiliary]
  [galois : IsGalois F auxiliary]
  [cyclic : IsCyclic (auxiliary ≃ₐ[F] auxiliary)]
  degree : Module.finrank F auxiliary = n
  overfield : Type u
  [overfieldField : Field overfield]
  [overfieldNumberField : NumberField overfield]
  [overfieldAlgebra : Algebra F overfield]
  [overfieldAlgebraE : Algebra E overfield]
  [overfieldAlgebraAuxiliary : Algebra auxiliary overfield]
  [towerE : IsScalarTower F E overfield]
  [towerAuxiliary : IsScalarTower F auxiliary overfield]
  [overfieldGalois : IsGalois F overfield]
  [cyclicOverE : IsCyclic (overfield ≃ₐ[E] overfield)]

attribute [instance] CyclicAuxiliaryTower.field CyclicAuxiliaryTower.numberField
  CyclicAuxiliaryTower.algebra CyclicAuxiliaryTower.galois CyclicAuxiliaryTower.cyclic
  CyclicAuxiliaryTower.overfieldField CyclicAuxiliaryTower.overfieldNumberField
  CyclicAuxiliaryTower.overfieldAlgebra CyclicAuxiliaryTower.overfieldAlgebraE
  CyclicAuxiliaryTower.overfieldAlgebraAuxiliary CyclicAuxiliaryTower.towerE
  CyclicAuxiliaryTower.towerAuxiliary CyclicAuxiliaryTower.overfieldGalois
  CyclicAuxiliaryTower.cyclicOverE

/-- The upper extension in an auxiliary tower is also Galois over `E`. -/
instance {n : ℕ} (T : CyclicAuxiliaryTower F E n) : IsGalois E T.overfield :=
  IsGalois.tower_top_of_isGalois F E T.overfield

/-- Construct the auxiliary tower using the existing exact-degree cyclotomic
existence theorem and the chosen common compositum. -/
def cyclicAuxiliaryTower {n : ℕ} (hn : 0 < n) : CyclicAuxiliaryTower F E n :=
  Classical.choice <| by
    obtain ⟨K, hK, hNF, hAlg, hGal, hCyc, hdeg⟩ :=
      Langlands.Global.exists_cyclic_extension F hn
    let := hK
    let := hNF
    let := hAlg
    let := hGal
    let := hCyc
    let M := commonGaloisOverfield F F E K
    exact ⟨{
      auxiliary := K
      degree := hdeg
      overfield := M.carrier
      overfieldAlgebra := M.algebraF
      overfieldAlgebraE := M.algebraLeft
      overfieldAlgebraAuxiliary := M.algebraRight
      towerE := M.towerFLeft
      towerAuxiliary := M.towerFRight
      overfieldGalois := M.galois
      cyclicOverE := commonGaloisOverfield_isCyclic_left F F E K }⟩

end Langlands.ClassField.Global
