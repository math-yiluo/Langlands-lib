import Langlands.ClassField.Global.IdelePrimePowerDescent
import Langlands.Global.Arithmetic.CyclicPrimePowerLocalDegreeStatement
import Langlands.Global.Arithmetic.CyclotomicAuxiliary

/-! # Cyclic local degree coverage from the prime-power arithmetic statement -/

noncomputable section

namespace Langlands.ClassField.Global

open NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped NumberField Langlands.Global.AdelicFunctoriality.FiniteExtension
open Langlands.Global.AdelicFunctoriality Langlands.Global.CompletionPadic
open Langlands.ClassFieldTheory.Local

universe u

variable (F E : Type u) [Field F] [NumberField F] [Field E] [NumberField E]
  [Algebra F E] [IsGalois F E] [IsCyclic (E ≃ₐ[F] E)]

/-- The fixed field of the subgroup generated by the `n`th power of a chosen
Galois generator. For a positive divisor `n` of the extension degree, it has degree `n`. -/
def cyclicIntermediateFieldOfDegree (n : ℕ) : IntermediateField F E :=
  IntermediateField.fixedField
    (Subgroup.zpowers ((Classical.choose (IsCyclic.exists_generator (α := E ≃ₐ[F] E))) ^ n))

instance (n : ℕ) : NumberField (cyclicIntermediateFieldOfDegree F E n) :=
  Langlands.Global.intermediateField_numberField _

instance (n : ℕ) : IsGalois F (cyclicIntermediateFieldOfDegree F E n) := by
  dsimp [cyclicIntermediateFieldOfDegree]
  exact IsGalois.of_fixedField_normal_subgroup _

instance (n : ℕ) : IsCyclic (cyclicIntermediateFieldOfDegree F E n ≃ₐ[F]
    cyclicIntermediateFieldOfDegree F E n) :=
  isCyclic_of_surjective (AlgEquiv.restrictNormalHom (cyclicIntermediateFieldOfDegree F E n))
    (AlgEquiv.restrictNormalHom_surjective E)

/-- The selected intermediate field has the prescribed divisor degree. -/
theorem finrank_cyclicIntermediateFieldOfDegree (n : ℕ) (hn : 0 < n)
    (hdvd : n ∣ Module.finrank F E) :
    Module.finrank F (cyclicIntermediateFieldOfDegree F E n) = n := by
  let g : E ≃ₐ[F] E := Classical.choose (IsCyclic.exists_generator (α := E ≃ₐ[F] E))
  have hg : ∀ x : E ≃ₐ[F] E, x ∈ Subgroup.zpowers g :=
    Classical.choose_spec (IsCyclic.exists_generator (α := E ≃ₐ[F] E))
  have hog : orderOf g = Module.finrank F E := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, IsGalois.card_aut_eq_finrank]
  have hcard : Nat.card (Subgroup.zpowers (g ^ n)) = Module.finrank F E / n := by
    rw [Nat.card_zpowers, orderOf_pow_of_dvd hn.ne' (hog ▸ hdvd), hog]
  have hKE : Module.finrank (cyclicIntermediateFieldOfDegree F E n) E =
      Module.finrank F E / n := by
    rw [cyclicIntermediateFieldOfDegree, IntermediateField.finrank_fixedField_eq_card]
    exact hcard
  have hpos : 0 < Module.finrank F E := Module.finrank_pos
  have h := Module.finrank_mul_finrank F (cyclicIntermediateFieldOfDegree F E n) E
  rw [hKE] at h
  apply Nat.eq_of_mul_eq_mul_right (Nat.div_pos (Nat.le_of_dvd hpos hdvd) hn)
  rw [h, Nat.mul_div_cancel' hdvd]

variable {F E}

/-- The prime-power local-degree arithmetic statement implies local degree
coverage for every cyclic extension and any chosen finite lifts. -/
theorem primePowerLocalDegreeCoverage_of_cyclic
    (hlocal : Langlands.Global.CyclicPrimePowerLocalDegreeStatement.{u, u})
    (wf : ∀ v : HeightOneSpectrum (𝓞 F), FinitePlacesAbove E v) :
    PrimePowerLocalDegreeCoverage wf := by
  intro p k hp hk hpk
  let K := cyclicIntermediateFieldOfDegree F E (p ^ k)
  have hK : Module.finrank F K = p ^ k :=
    finrank_cyclicIntermediateFieldOfDegree F E _ (pow_pos hp.pos _) hpk
  obtain ⟨v, _, w, hw, hdegree⟩ := hlocal F K p k hp hk hK ∅
  let := hw
  obtain ⟨z, hz⟩ := exists_place_above (L := E) w
  let := hz
  have : z.asIdeal.LiesOver v.asIdeal := Ideal.LiesOver.trans z.asIdeal w.asIdeal v.asIdeal
  have hdvd := localDegree_dvd_localDegree v w z
  rw [hdegree, hK] at hdvd
  refine ⟨v, hdvd.trans ?_⟩
  apply dvd_of_eq
  change Module.finrank (v.adicCompletion F) (z.adicCompletion E) =
    Module.finrank (v.adicCompletion F) ((wf v).1.adicCompletion E)
  rw [localDegree_eq, localDegree_eq,
    Ideal.ramificationIdx_eq_of_isGaloisGroup v.asIdeal z.asIdeal (wf v).1.asIdeal (E ≃ₐ[F] E),
    Ideal.inertiaDeg_eq_of_isGaloisGroup v.asIdeal z.asIdeal (wf v).1.asIdeal (E ≃ₐ[F] E)]

variable (I : ∀ (p : ℕ) [Fact p.Prime], InvariantFamily.{u, u} p)
  (hI : ∀ (p : ℕ) [Fact p.Prime], (I p).RelativeImages)
  (hlocal : Langlands.Global.CyclicPrimePowerLocalDegreeStatement.{u, u})
  (wf : ∀ v : HeightOneSpectrum (𝓞 F), FinitePlacesAbove E v)
  (wi : ∀ v : InfinitePlace F, InfinitePlacesAbove E v)
  (hrec : ∀ x : relativeCohomology F E 2, Reciprocity.SumOfInvariantsVanishes I x)
  [Finite (relativeIdeleClassCohomology F E 2)]
  (hcard : Nat.card (relativeIdeleClassCohomology F E 2) ≤ Module.finrank F E)

/-- Conditional invariant equivalence for a cyclic extension, using only
prime-power local-degree existence as the arithmetic coverage input. -/
def cyclicIdeleClassInvariantEquiv :
    relativeIdeleClassCohomology F E 2 ≃+ denominatorSubgroup (Module.finrank F E) :=
  ideleClassInvariantEquivOfPrimePowerLocalDegreeCoverage I hI wf wi
    (primePowerLocalDegreeCoverage_of_cyclic hlocal wf) hrec hcard

@[simp] theorem cyclicIdeleClassInvariantEquiv_apply_quotient
    (c : relativeIdeleCohomology F E 2) :
    cyclicIdeleClassInvariantEquiv I hI hlocal wf wi hrec hcard
      (ideleQuotientCohomologyMap F E 2 c) = totalIdeleInvariantToDenominator I hI wf wi c :=
  ideleClassInvariantEquivOfPrimePowerLocalDegreeCoverage_apply_quotient
    I hI wf wi _ hrec hcard c

end Langlands.ClassField.Global
