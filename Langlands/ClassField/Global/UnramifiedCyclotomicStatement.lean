import Langlands.ClassField.Global.LocalSymbolIdentity

/-! # Unramified cyclotomic completions and the Frobenius of the Artin symbol (statement) -/

noncomputable section

open NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped NumberField Langlands.Global.AdelicFunctoriality.FiniteExtension
open Langlands.Global.AdelicFunctoriality Langlands.Global.CompletionPadic
open Langlands.ClassFieldTheory.Local

namespace Langlands.ClassField.Global

universe u

namespace UnramifiedCyclotomic

open FundamentalClass CompletionTower LocalSymbolIdentity

/-- The subgroup of `Gal(L/F)` fixing `ζ ^ k`. -/
def rootStabilizer {F L : Type*} [Field F] [Field L] [Algebra F L] {ζ : L} (k : ℕ) :
    Subgroup (L ≃ₐ[F] L) where
  carrier := {σ | σ (ζ ^ k) = ζ ^ k}
  one_mem' := rfl
  mul_mem' {σ τ} hσ hτ := by
    change σ (τ (ζ ^ k)) = ζ ^ k
    rw [show τ (ζ ^ k) = ζ ^ k from hτ]
    exact hσ
  inv_mem' {σ} hσ := by
    change σ.symm (ζ ^ k) = ζ ^ k
    rw [AlgEquiv.symm_apply_eq]
    exact hσ.symm

/-- The fixed field of the stabilizer of `ζ ^ k`, i.e. `F(ζ ^ k)` when `ζ` generates `L`. -/
abbrev stabilizerField {F L : Type*} [Field F] [Field L] [Algebra F L] (ζ : L) (k : ℕ) :
    IntermediateField F L :=
  IntermediateField.fixedField (rootStabilizer (F := F) (ζ := ζ) k)

/-- The place of `stabilizerField ζ k` below `u`. -/
abbrev stabilizerPlace {F L : Type u} [Field F] [Field L] [NumberField L] [Algebra F L]
    [NumberField F] (ζ : L) (k : ℕ) (u : HeightOneSpectrum (𝓞 L)) :
    HeightOneSpectrum (𝓞 (stabilizerField (F := F) ζ k)) :=
  fixedFieldPlace (rootStabilizer (F := F) (ζ := ζ) k) u

/-- **Unramified cyclotomic completions.** Let `L / F` be a Galois extension of number fields
generated by a primitive `M`-th root of unity `ζ` (so `autToPow` is injective), `v` a finite
place of `F` with `q = |𝓞 F / v|`, `u` a place of `L` above `v`, and `N ∣ M` with `N ∉ v`.
Let `U = stabilizerField ζ (M / N)`, i.e. `U = F(ζ^{M/N})`, and `U_w` its completion below
`u`. Then `U_w / F_v` has an arithmetic unramified coordinate `χ_U : Gal(U_w/F_v) ≃ ℤ/e` with
`e` the order of `q` modulo `N`, and for every `π ∈ F_vˣ` of order `1` the local Artin symbol
of `π` restricts on `U` to the arithmetic Frobenius `χ_U⁻¹(1)`. -/
def UnramifiedCyclotomicFrobenius : Prop :=
  ∀ (F L : Type u) [Field F] [Field L] [NumberField F] [NumberField L] [Algebra F L]
    [IsGalois F L] (M : ℕ) [NeZero M] (ζ : L) (hζ : IsPrimitiveRoot ζ M)
    (hinj : Function.Injective (hζ.autToPow F))
    (v : HeightOneSpectrum (𝓞 F)) (u : HeightOneSpectrum (𝓞 L)) [u.asIdeal.LiesOver v.asIdeal]
    (N : ℕ) [NeZero N], N ∣ M → ((N : ℕ) : 𝓞 F) ∉ v.asIdeal →
    ∀ (hH : (rootStabilizer (F := F) (ζ := ζ) (M / N)).Normal),
      haveI := hH
      ∃ (e : ℕ) (he : NeZero e), e = orderOf ((Nat.card (𝓞 F ⧸ v.asIdeal) : ℕ) : ZMod N) ∧
        haveI := he
        ∃ χU : (((stabilizerPlace (F := F) ζ (M / N) u).adicCompletion
            (stabilizerField (F := F) ζ (M / N))) ≃ₐ[v.adicCompletion F]
            ((stabilizerPlace (F := F) ζ (M / N) u).adicCompletion
              (stabilizerField (F := F) ζ (M / N)))) ≃* Multiplicative (ZMod e),
          IsArithmeticUnramifiedCoordinate (padicField v)
            ((stabilizerPlace (F := F) ζ (M / N) u).adicCompletion
              (stabilizerField (F := F) ζ (M / N))) χU ∧
          ∀ π : (v.adicCompletion F)ˣ,
            (padicField v).canonicalTopologicalData.ord (π : v.adicCompletion F) = 1 →
              decompositionHom v (stabilizerPlace (F := F) ζ (M / N) u)
                  (χU.symm (Multiplicative.ofAdd 1)) =
                (artinSymbol hζ hinj v π).restrictNormal (stabilizerField (F := F) ζ (M / N))

end UnramifiedCyclotomic

end Langlands.ClassField.Global
