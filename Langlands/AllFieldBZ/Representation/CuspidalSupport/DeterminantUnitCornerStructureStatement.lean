namespace Langlands.AllFieldBZ.CuspidalSupport
open Langlands.CuspidalSupport hiding DeterminantUnitCornerStructureStatement continuous_determinantUnitInclusion determinantUnitInclusion determinantUnitInclusion_apply determinantUnitOpenSubgroup determinantUnitRestriction determinantUnitRestrictionMap determinantUnitRestrictionMap_apply determinantUnitRestrictionMap_comp determinantUnitRestrictionMap_id determinantUnitRestriction_apply determinantUnitSubgroup determinantUnitSubgroup_normal isOpen_determinantUnitSubgroup leviDeterminantNorm leviDeterminantNorm_apply mem_determinantUnitSubgroup mem_determinantUnitSubgroup_iff_normalizedAbs
open Langlands.GeneralLinear
open MeasureTheory
universe uF

/-- Every compact open subgroup `K` of the determinant-unit subgroup `G°` of a product
Levi contains a compact open subgroup `N` such that, for every Haar measure on `G°`,
the corner `H_N` is spanned by products `x i * m * x j`, where `m` ranges over the
subalgebra generated by finitely many pairwise commuting elements `a k`. -/
def DeterminantUnitCornerStructureStatement : Prop :=
  ∀ (F : LocalFieldPackage.{uF}) (T : F.TopologicalData)
    (n : ℕ) (B : BlockShape n),
    letI := T.topology
    haveI := T.leviTopologicalGroup B
    letI : MeasurableSpace (determinantUnitSubgroup T B) := borel _
    haveI : BorelSpace (determinantUnitSubgroup T B) := ⟨rfl⟩
    ∀ K : OpenSubgroup (determinantUnitSubgroup T B),
      IsCompact (K : Set (determinantUnitSubgroup T B)) →
        ∃ (N : OpenSubgroup (determinantUnitSubgroup T B))
          (hN : IsCompact (N : Set (determinantUnitSubgroup T B))), N ≤ K ∧
          ∀ (μ : Measure (determinantUnitSubgroup T B)) [μ.IsHaarMeasure],
            ∃ (q l : ℕ) (x : Fin q → Hecke.HeckeAlgebra.Corner μ N hN)
              (a : Fin l → Hecke.HeckeAlgebra.Corner μ N hN),
              (∀ i j, Commute (a i) (a j)) ∧
              Submodule.span ℂ
                {y | ∃ i j, ∃ m ∈ Algebra.adjoin ℂ (Set.range a), y = x i * m * x j} = ⊤

end Langlands.AllFieldBZ.CuspidalSupport
