import Langlands.Automorphic.GroupSchemeActualDifferential
import Langlands.Automorphic.GroupSchemeCharacterTwistEnveloping
import Langlands.Automorphic.GroupSchemePlotSmoothRightCovariance
import Langlands.Global.AdelicParameterTwistCenterFiniteReductionStatement
import Langlands.Global.AdelicSmoothIwasawaHeight
import Langlands.Global.AdelicIwasawaSmoothHeight
import Langlands.Global.AdelicConstantTermSplitFinitenessReduction
import Langlands.Global.EisensteinConstantTerm.Height

/-! # Center finiteness of twists from the finite Harish-Chandra transfer: proof

`parameterTwistCenterFiniteReduction` proves `ParameterTwistCenterFiniteReductionStatement`:
`ParabolicLeviCenterRestrictionStatement` implies `ParameterTwistCenterFiniteStatement`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry NumberField
open scoped Classical CategoryTheory.MonObj ContDiff Manifold

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Global

open Langlands.GroupScheme Langlands.Automorphic.GroupSchemeFunctions AdelicGroupPoints
  InfiniteAdelicGroupPoints

namespace AdelicGroupPoints

variable {F : Type u} [Field F] [NumberField F]
  {G P : GroupScheme (Spec (CommRingCat.of F))} [IsAffine G.X.left] [IsAffine P.X.left]
  {p : P ⟶ G} [IsClosedImmersion p.hom.hom.left] {K : Subgroup (AdelicGroupPoints F G)}

/-- `m_P^λ` takes the value `1` at the identity. -/
theorem IsIwasawaCompact.heightPower_one (hK : IsIwasawaCompact p K)
    (lam : ComplexCharacterParameter F P) : hK.heightPower lam 1 = 1 := by
  simp only [IsIwasawaCompact.heightPower, hK.height_of_mem K.one_mem, map_zero,
    Complex.exp_zero]

/-- For a maximal compact `K`, `m_P^λ` of a pair `(a, b)` is the product of its values at
`(a, 1)` and `(1, b)`. -/
theorem IsIwasawaCompact.heightPower_pair (hK : IsIwasawaCompact p K)
    (hmax : IsMaximalCompactSubgroup F G K) (lam : ComplexCharacterParameter F P)
    (a : InfiniteAdelicGroupPoints F G) (b : FiniteAdelicGroupPoints F G) :
    hK.heightPower lam (pair F G a b) =
      hK.heightPower lam (ofInfinite F G a) * hK.heightPower lam (ofFinite F G b) := by
  simp only [IsIwasawaCompact.heightPower, hK.height_pair_of_maximal hmax, map_add,
    Complex.exp_add]

/-- The twist of a function left invariant under the image of a unipotent subgroup `V` of `P`
is again left invariant under it. -/
theorem IsIwasawaCompact.isLeftInvariantUnder_unipotentImage_parameterTwist
    (hK : IsIwasawaCompact p K) {V : GroupScheme (Spec (CommRingCat.of F))} (iV : V ⟶ P)
    (hV : IsUnipotent V) {φ : AdelicGroupPoints F G → ℂ}
    (hφ : IsLeftInvariantUnder F G (parabolicUnipotentImage F p iV) φ)
    (lam : ComplexCharacterParameter F P) :
    IsLeftInvariantUnder F G (parabolicUnipotentImage F p iV) (hK.parameterTwist φ lam) := by
  rintro _ ⟨x, rfl⟩ g
  simp only [IsIwasawaCompact.parameterTwist]
  rw [hφ _ ⟨x, rfl⟩ g]
  congr 1
  exact hK.heightPower_unipotent_mul hV iV lam x g

omit [IsAffine P.X.left] [IsClosedImmersion p.hom.hom.left] in
/-- The infinite slices of a function left invariant under the image of `V(𝔸)` are left
invariant under the image of `V(F_∞)`. -/
theorem functionInfiniteSlice_unipotent_mul {V : GroupScheme (Spec (CommRingCat.of F))}
    [IsAffine V.X.left] (iV : V ⟶ P) {φ : AdelicGroupPoints F G → ℂ}
    (hφ : IsLeftInvariantUnder F G (parabolicUnipotentImage F p iV) φ)
    (b : FiniteAdelicGroupPoints F G) (v : InfiniteAdelicGroupPoints F V)
    (x : InfiniteAdelicGroupPoints F G) :
    functionInfiniteSlice F G φ b
        (V.affinePointsTarget (iV ≫ p) (CommAlgCat.of F (InfiniteAdeleRing F)) v * x) =
      functionInfiniteSlice F G φ b x := by
  have hmem : ofInfinite F G
      (V.affinePointsTarget (iV ≫ p) (CommAlgCat.of F (InfiniteAdeleRing F)) v) ∈
        parabolicUnipotentImage F p iV :=
    ⟨ofInfinite F V v, map_ofInfinite (iV ≫ p) v⟩
  have heq : pair F G
      (V.affinePointsTarget (iV ≫ p) (CommAlgCat.of F (InfiniteAdeleRing F)) v * x) b =
        ofInfinite F G
          (V.affinePointsTarget (iV ≫ p) (CommAlgCat.of F (InfiniteAdeleRing F)) v) *
            pair F G x b := by
    rw [ofInfinite_eq_pair, pair_mul, one_mul]
  simp only [functionInfiniteSlice, heq, hφ _ hmem]

end AdelicGroupPoints

/-- **Center finiteness of twists from the finite transfer of centers.** For `φ` smooth, left
invariant under `U_I(𝔸)` and killed by an ideal `J` of finite codimension of `𝔷`, take the
finite transfer `p : 𝔷 → 𝔷_M` to the Levi `M_I` at the translate `1`, the ideal `I_M` of `𝔷_M`
generated by `p(J)`, and the endomorphism `θ` of `𝔷_M` by which multiplication by the character
`m ↦ m_P(m)^λ` of `M_I(F_∞)` intertwines the center action. The ideal `(θ ∘ p)⁻¹(I_M)` has
finite codimension and kills every infinite slice of `φ_λ`. -/
theorem parameterTwistCenterFiniteReduction : ParameterTwistCenterFiniteReductionStatement.{u} := by
  intro hCenter F _ _ G _ _ _ fam I _ K hK hmax d hsmooth hcalc phi hleft hsm hfin lam
  obtain ⟨J, hJ, hJphi⟩ := hfin
  have hGred := fam.connectedReductive
  have hU : IsUnipotent (fam.U I) := (fam.isUnipotentRadical I).1.isUnipotent
  have hmul : IsIso (subgroupMultiplication (fam.l I) (fam.iU I)) :=
    (fam.isCompatible I).levi.isIso_subgroupMultiplication_of_radical (fam.isUnipotentRadical I)
  have hcM := adelicDifferentialCommutator_of_smooth F (fam.M I) (fam.leviSmooth I)
  obtain ⟨pz, hpfin, hpAction⟩ := hCenter F G (fam.P I) (fam.M I) (fam.U I) (fam.p I)
    (fam.iU I) (fam.l I) hGred (fam.isCompatible I).parabolic (fam.isUnipotentRadical I)
    (fam.isCompatible I).levi hmul hsmooth (fam.leviSmooth I) hcalc hcM 1
  obtain ⟨IM, hIM, hIMkill⟩ := exists_cofinite_center_ideal_of_leviRestriction (q := fam.p I)
    (fam.l I) (fam.iU I) hcalc hcM 1 pz hpfin hpAction J hJ
  -- The character `χ(m) = m_P(m)^λ` of `M_I(F_∞)` and the archimedean factor of `m_P^λ`.
  let ιM : InfiniteAdelicGroupPoints F (fam.M I) →* InfiniteAdelicGroupPoints F G :=
    (fam.M I).affinePointsTarget (fam.l I ≫ fam.p I) (CommAlgCat.of F (InfiniteAdeleRing F))
  let hInf : InfiniteAdelicGroupPoints F G → ℂ := fun x => hK.heightPower lam (ofInfinite F G x)
  let χ : InfiniteAdelicGroupPoints F (fam.M I) → ℂ := fun m => hInf (ιM m)
  -- Left translation by a point `y` of `P_I(𝔸)` multiplies `m_P^λ` by `m_P(y)^λ`.
  have hPmul : ∀ (y : AdelicGroupPoints F (fam.P I)) (x : AdelicGroupPoints F G),
      hK.heightPower lam (map F (fam.P I) G (fam.p I) y * x) =
        hK.heightPower lam (map F (fam.P I) G (fam.p I) y) * hK.heightPower lam x := by
    intro y x
    simp only [IsIwasawaCompact.heightPower, hK.height_map_mul, hK.height_map, map_add,
      Complex.exp_add]
  have hχleft : ∀ m x, hInf (ιM m * x) = χ m * hInf x := by
    intro m x
    have hm : ofInfinite F G (ιM m) = map F (fam.P I) G (fam.p I)
        (map F (fam.M I) (fam.P I) (fam.l I) (ofInfinite F (fam.M I) m)) := by
      rw [← map_comp_apply_of_hom, map_ofInfinite]
    simp only [hInf, χ, map_mul, hm, hPmul]
  have hχmul : ∀ m m', χ (m * m') = χ m * χ m' := by
    intro m m'
    change hInf (ιM (m * m')) = χ m * hInf (ιM m')
    rw [map_mul, hχleft]
  have hχone : χ 1 = 1 := by
    change hK.heightPower lam (ofInfinite F G (ιM 1)) = 1
    rw [map_one, map_one, hK.heightPower_one]
  have hInfs : hInf ∈ InfinitePlotSmoothFunctions F G := by
    let := fun v : NumberField.InfinitePlace F => InfinitePlaceGroupPoints.completionRCLike F v
    let := smoothChartedSpace F G hsmooth
    have hH := hK.hasSmoothHeightPairings_of_maximalCompact hsmooth hmax lam 1
    exact (isPlotSmooth_iff_contMDiff F G hsmooth hInf).mpr
      ((Complex.contDiff_exp (𝕜 := ℝ) (n := ∞)).contMDiff.comp hH)
  have hχ : χ ∈ InfinitePlotSmoothFunctions F (fam.M I) :=
    GroupScheme.IsPlotSmooth.postcomp hInfs (fam.l I ≫ fam.p I).hom.hom
  obtain ⟨θ, hθ⟩ := exists_centerShift_plotSmoothMultiplication F (fam.M I) (fam.leviSmooth I)
    hcM χ hχ hχmul hχone
  refine ⟨IM.comap (θ.comp pz).toRingHom, ?_, ?_⟩
  · have : Module.Finite ℂ (AdelicEnvelopingCenter F (fam.M I) (fam.leviSmooth I) ⧸ IM) :=
      (Module.Finite.equiv_iff (Submodule.Quotient.restrictScalarsEquiv ℂ IM)).mp hIM
    have h := Langlands.Algebra.quotientFinite_comap (θ.comp pz) IM
    exact (Module.Finite.equiv_iff (Submodule.Quotient.restrictScalarsEquiv ℂ _)).mpr h
  · intro z hz b hb
    have hf : functionInfiniteSlice F G phi b ∈ InfinitePlotSmoothFunctions F G := hsm.2.1 b
    let f : InfinitePlotSmoothFunctions F G := ⟨_, hf⟩
    let Fl : InfinitePlotSmoothFunctions F G := ⟨_, hb⟩
    let R := G.plotSmoothRightAction (CommAlgCat.of F (InfiniteAdeleRing F))
      (InfiniteAdeleRing.ringEquiv_mixedSpace F).toRingHom
    let cb : ℂ := hK.heightPower lam (ofFinite F G b)
    have hslice : ∀ x, Fl.val x = cb * (hInf x * f.val x) := by
      intro x
      change hK.parameterTwist phi lam (pair F G x b) = cb * (hInf x * phi (pair F G x b))
      rw [IsIwasawaCompact.parameterTwist, hK.heightPower_pair hmax]
      ring
    have hVf : ∀ g v x, (R g f).val
        ((fam.U I).affinePointsTarget (fam.iU I ≫ fam.p I)
          (CommAlgCat.of F (InfiniteAdeleRing F)) v * x) = (R g f).val x := by
      intro g v x
      change functionInfiniteSlice F G phi b (_ * x * g) = functionInfiniteSlice F G phi b (x * g)
      rw [mul_assoc]
      exact functionInfiniteSlice_unipotent_mul (fam.iU I) hleft b v (x * g)
    have hVF : ∀ g v x, (R g Fl).val
        ((fam.U I).affinePointsTarget (fam.iU I ≫ fam.p I)
          (CommAlgCat.of F (InfiniteAdeleRing F)) v * x) = (R g Fl).val x := by
      intro g v x
      change functionInfiniteSlice F G (hK.parameterTwist phi lam) b (_ * x * g) =
        functionInfiniteSlice F G (hK.parameterTwist phi lam) b (x * g)
      rw [mul_assoc]
      exact functionInfiniteSlice_unipotent_mul (fam.iU I)
        (hK.isLeftInvariantUnder_unipotentImage_parameterTwist (fam.iU I) hU hleft lam) b v (x * g)
    have hJf : ∀ g, ∀ z' ∈ J, plotSmoothCenterAction F G hsmooth hcalc z' (R g f) = 0 := by
      intro g z' hz'
      rw [← plotSmoothCenterAction_rightTranslation F G hsmooth hcalc hGred g z' f,
        hJphi z' hz' b hf, map_zero]
    apply Subtype.ext
    funext g
    change (plotSmoothCenterAction F G hsmooth hcalc z Fl).val g = 0
    have h1 : (plotSmoothCenterAction F G hsmooth hcalc z Fl).val g =
        (R g (plotSmoothCenterAction F G hsmooth hcalc z Fl)).val 1 := by
      rw [GroupScheme.plotSmoothRightAction_apply, one_mul]
    rw [h1, plotSmoothCenterAction_rightTranslation F G hsmooth hcalc hGred g z Fl]
    have h2 : ∀ w : InfinitePlotSmoothFunctions F G,
        w.val 1 = (infiniteLeviRestriction (q := fam.p I) (fam.l I) 1 w).val 1 := by
      intro w
      change w.val 1 = w.val (ιM 1 * 1)
      rw [map_one, one_mul]
    rw [h2, hpAction (R g Fl) (hVF g) z]
    have h3 : infiniteLeviRestriction (q := fam.p I) (fam.l I) 1 (R g Fl) =
        (cb * hInf g) • plotSmoothMultiplication F (fam.M I) χ hχ
          (infiniteLeviRestriction (q := fam.p I) (fam.l I) 1 (R g f)) := by
      apply Subtype.ext
      funext m
      change Fl.val (ιM m * 1 * g) = (cb * hInf g) * (χ m * f.val (ιM m * 1 * g))
      rw [hslice, mul_one, hχleft]
      ring
    have h4 : plotSmoothCenterAction F (fam.M I) (fam.leviSmooth I) hcM (θ (pz z))
        (infiniteLeviRestriction (q := fam.p I) (fam.l I) 1 (R g f)) = 0 :=
      hIMkill (R g f) (hVf g) (hJf g) (θ (pz z)) hz
    rw [h3, map_smul, hθ, h4, map_zero, smul_zero]
    rfl

end Langlands.Global
