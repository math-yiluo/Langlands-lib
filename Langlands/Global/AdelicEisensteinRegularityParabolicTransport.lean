import Langlands.Global.AdelicEisensteinAmbientParametersProof
import Langlands.Global.AdelicEisensteinConstantTermStatement
import Langlands.Global.AdelicWeylTorusAlignment
import Langlands.GroupScheme.Rational.ParabolicRootPresentationSimpleRoots
import Langlands.Representation.Plancherel.AmbientCharacterIntertwiningCone

/-! # Regularity under comparison of standard parabolic presentations -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped CategoryTheory.MonObj TensorProduct

set_option autoImplicit false

open Langlands.GroupScheme Langlands.Global Langlands.Global.AdelicGroupPoints
  Langlands.Plancherel RealTorusSpace

namespace Langlands.GroupScheme.ParabolicRootPresentation

variable {F : Type u} [Field F]
  {G P M : GroupScheme (Spec (CommRingCat.of F))}
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
  {A : CommGroupScheme (Spec (CommRingCat.of F))}
  {p : P ⟶ G} {l : M ⟶ P} {a : A.toGrp ⟶ M} (r : ParabolicRootPresentation p l a)

/-- A positive ambient root restricts trivially to the split component
exactly when it belongs to the positive monoid generated by the Levi roots. -/
theorem restrict_positiveRoot_eq_zero_iff
    {beta : characterLattice r.data.T} (hbeta : beta ∈ positiveRelativeRoots r.data.i r.data.ν) :
    r.data.f ≫ beta = 0 ↔ beta ∈ AddSubmonoid.closure r.data.J := by
  refine ⟨fun hz => (r.isStandard_splitComponentCocharacter.pairing_eq_zero_iff_mem_closure
    r.data.i r.data.ν hbeta).mp ?_, r.restrict_eq_zero_of_mem_closure⟩
  rw [← RelativeRoot.latticePairing_restrict_cocharacterMapInt, hz]
  simp

variable [NumberField F] [Mono r.data.i.hom.hom.left] [Fintype (relativeWeylGroup r.data.i)]
  [Mono (CommGroupScheme.groupHom r.data.f).hom.hom.left]

/-- Express the regularity inequalities in the common ambient torus
using the restriction through the actual Levi. -/
theorem isRegularParameter_iff_ambientBounds (hA : IsSplitTorus A.toGrp)
    (hT : IsSplitTorus r.data.T.toGrp) (hG : IsConnectedReductive G)
    (t : r.data.T.toGrp ⟶ M) (ht : t ≫ l ≫ p = r.data.i)
    (R : ℝ) (lam : ComplexCharacterParameter F P) :
    r.IsRegularParameter hA hT R lam ↔
      ∀ beta ∈ positiveRelativeRoots r.data.i r.data.ν, beta ∉ AddSubmonoid.closure r.data.J →
        R < relativeWeylInvariantForm r.data.i hT
          (realParameterRestriction (t ≫ l) (parameterRealPart F P lam))
          ((1 : ℝ) ⊗ₜ[ℤ] beta) := by
  let x := parameterRealPart F P lam
  let xA := realParameterRestriction (a ≫ l) x
  have hLift := eisensteinAmbientParameterLift F G P M A p l a r hA hT t hG ht x
  constructor
  · intro hReg beta hbeta hne
    have hnonzero : r.data.f ≫ beta ≠ 0 := fun hz => hne ((r.restrict_positiveRoot_eq_zero_iff hbeta).mp hz)
    have h : R < weylInducedCharacterForm hA hT r.data.f r.data.i xA
        ((1 : ℝ) ⊗ₜ[ℤ] (r.data.f ≫ beta)) :=
      hReg _ ⟨hnonzero, beta, hbeta, rfl⟩
    rw [hLift]
    exact (weylInducedCharacterForm_root_inequality_iff hA hT r.data.f r.data.i xA beta R).mpr h
  · rintro hBounds alpha ⟨hne, beta, hbeta, rfl⟩
    have h := hBounds beta hbeta (fun hb => hne (r.restrict_eq_zero_of_mem_closure hb))
    rw [hLift] at h
    exact (weylInducedCharacterForm_root_inequality_iff hA hT r.data.f r.data.i xA beta R).mp h

end Langlands.GroupScheme.ParabolicRootPresentation

namespace Langlands.Global

/-- For two presentations in the same ambient torus, chamber and standard
index, restriction along a map over the parabolic inclusions identifies
the regularity regions with the same threshold. -/
def EisensteinRegularityParabolicTransportStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F]
    (G P M P' M' : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
    (T A A' : CommGroupScheme (Spec (CommRingCat.of F))) (i : T.toGrp ⟶ G)
    [Mono i.hom.hom.left] [Fintype (relativeWeylGroup i)] (nu : cocharacterLattice T)
    (J : Set (characterLattice T)) (f : A ⟶ T) (f' : A' ⟶ T)
    [Mono (CommGroupScheme.groupHom f).hom.hom.left]
    [Mono (CommGroupScheme.groupHom f').hom.hom.left]
    (p : P ⟶ G) (l : M ⟶ P) (a : A.toGrp ⟶ M)
    (p' : P' ⟶ G) (l' : M' ⟶ P') (a' : A'.toGrp ⟶ M')
    (hp : ParabolicRootPresentationData.IsCompatible ⟨T, i, nu, J, f⟩ p l a)
    (hp' : ParabolicRootPresentationData.IsCompatible ⟨T, i, nu, J, f'⟩ p' l' a')
    (hA : IsSplitTorus A.toGrp) (hA' : IsSplitTorus A'.toGrp) (hT : IsSplitTorus T.toGrp),
    IsConnectedReductive G → ∀ j : P' ⟶ P, j ≫ p = p' →
      ∀ (R : ℝ) (lam : ComplexCharacterParameter F P),
        (ParabolicRootPresentation.mk ⟨T, i, nu, J, f'⟩ hp').IsRegularParameter hA' hT R
          (parameterRestrict j lam) ↔
        (ParabolicRootPresentation.mk ⟨T, i, nu, J, f⟩ hp).IsRegularParameter hA hT R lam

theorem eisensteinRegularityParabolicTransport : EisensteinRegularityParabolicTransportStatement.{u} := by
  intro F _ _ G P M P' M' _ _ T A A' i _ _ nu J f f' _ _ p l a p' l' a'
    hp hp' hA hA' hT hG j hj R lam
  let r : ParabolicRootPresentation p l a := ⟨⟨T, i, nu, J, f⟩, hp⟩
  let r' : ParabolicRootPresentation p' l' a' := ⟨⟨T, i, nu, J, f'⟩, hp'⟩
  obtain ⟨t, _, ht⟩ := r.exists_leviTorusLift
  obtain ⟨t', _, ht'⟩ := r'.exists_leviTorusLift
  let : Mono p.hom.hom.left := hp.parabolic.isClosedSubgroup.mono
  have hpOver : Mono p.hom.hom := Over.mono_of_mono_left _
  let : Mono p := (Grp.forget _).mono_of_mono_map (f := p) hpOver
  have htcomp : (t' ≫ l') ≫ j = t ≫ l := by
    apply (cancel_mono p).mp
    simpa only [Category.assoc, hj, r, r'] using ht'.trans ht.symm
  have hReal : realParameterRestriction (t' ≫ l')
      (parameterRealPart F P' (parameterRestrict j lam)) =
        realParameterRestriction (t ≫ l) (parameterRealPart F P lam) := by
    induction lam using TensorProduct.inductionOn with
    | tmul s chi =>
      change s.re ⊗ₜ[ℤ] characterRestrict (t' ≫ l') (characterRestrict j chi) =
        s.re ⊗ₜ[ℤ] characterRestrict (t ≫ l) chi
      rw [← AddMonoidHom.comp_apply, ← characterRestrict_comp, htcomp]
    | add x y hx hy => simp only [map_add, hx, hy]
  change r'.IsRegularParameter hA' hT R (parameterRestrict j lam) ↔ r.IsRegularParameter hA hT R lam
  rw [r'.isRegularParameter_iff_ambientBounds hA' hT hG t' ht',
    r.isRegularParameter_iff_ambientBounds hA hT hG t ht, hReal]

end Langlands.Global
