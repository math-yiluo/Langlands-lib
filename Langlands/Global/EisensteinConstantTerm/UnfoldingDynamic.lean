import Langlands.GroupScheme.Dynamic.CommonTorusIntersections
import Langlands.GroupScheme.Dynamic.CommutingRefinements
import Langlands.GroupScheme.Dynamic.ActionStability
import Langlands.GroupScheme.Rational.StandardWeylMinimalRepresentativesProof

/-! # Intersections of dynamic subgroups of two commuting cocharacters -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Pointwise

set_option autoImplicit false

namespace Langlands.GroupScheme.Dynamic

section Affine

variable {R : CommRingCat.{u}} {G : GroupScheme (Spec R)} [IsAffine G.X.left]
    [IsSeparated G.X.hom] {A : CommGroupScheme (Spec R)} (i : A.toGrp ⟶ G)
    (α β : (Gm (Spec R)).toGrp ⟶ A.toGrp)

variable (ψ : (Gm (Spec R)).toGrp ⟶ G) (hψ : IsCommutingRefinement (β ≫ i) (α ≫ i) ψ)

include hψ in
/-- For a commuting refinement `ψ` of `χ = β ≫ i` by `τ = α ≫ i`, the parabolic `P(ψ)` is
generated by `P(χ) ∩ P(τ)` and `U(χ)`: `P(ψ) = (P(χ) ∩ P(τ)) U(χ)` on every test scheme. -/
theorem parabolic_refinement_eq_sup (T : Over (Spec R)) :
    (parabolic ψ).carrier T =
      (parabolic (β ≫ i) ⊓ parabolic (α ≫ i)).carrier T ⊔ (unipotent (β ≫ i)).carrier T := by
  apply le_antisymm
  · intro x hx
    have hx' : x ∈ (↑((parabolic ψ).carrier T) : Set (T ⟶ G.X)) := hx
    rw [hψ.2.2.2.2 T] at hx'
    obtain ⟨z, hz, u, hu, rfl⟩ := Set.mem_mul.mp hx'
    exact Subgroup.mul_mem _
      (Subgroup.mem_sup_left ⟨centralizer_le_parabolic _ T hz.1, hz.2⟩)
      (Subgroup.mem_sup_right hu)
  · refine sup_le ?_ ((hψ.2.2.1 T).trans (unipotent_le_parabolic ψ T))
    intro x hx
    have hx' : x ∈ (↑((parabolic (α ≫ i) ⊓ parabolic (β ≫ i)).carrier T) : Set (T ⟶ G.X)) :=
      ⟨hx.2, hx.1⟩
    rw [parabolic_inf_parabolic_eq_mul i α β T] at hx'
    obtain ⟨z, hz, u, hu, rfl⟩ := Set.mem_mul.mp hx'
    refine Subgroup.mul_mem _ ?_ ((hψ.2.2.1 T).trans (unipotent_le_parabolic ψ T) hu.2)
    have hz' : z ∈ (↑((parabolic ψ).carrier T) : Set (T ⟶ G.X)) := by
      rw [hψ.2.2.2.2 T]
      exact Set.mem_mul.mpr ⟨z, ⟨hz.2, hz.1⟩, 1, Subgroup.one_mem _, mul_one z⟩
    exact hz'

include hψ in
/-- For a commuting refinement `ψ` of `χ = β ≫ i` by `τ = α ≫ i`, `U(τ) ∩ P(χ) ⊆ U(ψ)`. -/
theorem unipotent_inf_parabolic_le_refinement :
    unipotent (α ≫ i) ⊓ parabolic (β ≫ i) ≤ unipotent ψ := by
  intro T x hx
  have hx' : x ∈ (↑((unipotent (α ≫ i) ⊓ parabolic (β ≫ i)).carrier T) : Set (T ⟶ G.X)) := hx
  rw [unipotent_inf_parabolic_eq_mul i α β T] at hx'
  obtain ⟨z, hz, u, hu, rfl⟩ := Set.mem_mul.mp hx'
  refine Subgroup.mul_mem _ ?_ (hψ.2.2.1 T hu.2)
  have hz' : z ∈ (↑((unipotent ψ).carrier T) : Set (T ⟶ G.X)) := by
    rw [hψ.2.2.2.1 T]
    exact Set.mem_mul.mpr ⟨z, ⟨hz.2, hz.1⟩, 1, Subgroup.one_mem _, mul_one z⟩
  exact hz'

end Affine

end Langlands.GroupScheme.Dynamic
