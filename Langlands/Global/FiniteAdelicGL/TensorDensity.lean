import Langlands.Global.FiniteAdelicGL.IrreducibleTensor

/-!
# Density for the finite adelic tensor

The operators generated by finite adelic translations agree with any given
endomorphism on any finite set of vectors of the algebraic restricted tensor.
-/

noncomputable section

set_option autoImplicit false

universe uF uV

namespace Langlands.Global.FiniteAdelicGL

open Langlands.RestrictedTensor
open scoped MonoidAlgebra

variable (F : Type uF) [Field F] [NumberField F] (n : ℕ)
  {V : FinitePlace F → Type uV}
  [∀ v, AddCommGroup (V v)] [∀ v, Module ℂ (V v)]
  (ρ : ∀ v, Representation ℂ (FiniteLocalGL F n v) (V v))
  (E : Finset (FinitePlace F)) (e : ∀ v, V v)
  (he : ∀ v ∉ E, ∀ g ∈ localIntegral F n v, ρ v g (e v) = e v)

/-- The algebra generated by translations on the finite adelic tensor. -/
abbrev tensorTranslationAlgebra : Subalgebra ℂ (Module.End ℂ (Space ℂ V E e)) :=
  Algebra.adjoin ℂ (Set.range (tensorRepresentation F n ρ E e he))

omit [NumberField F] in
private theorem exists_common_stage (s : Finset (Space ℂ V E e)) :
    ∃ S : Index E, ∀ x ∈ s, x ∈ LinearMap.range (of ℂ V E e S) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    exact ⟨⟨E, le_rfl⟩, by simp⟩
  | insert x s _ ih =>
    obtain ⟨S, hS⟩ := ih
    obtain ⟨T, z, hz⟩ := exists_of E e x
    let U : Index E := ⟨S.1 ∪ T.1, S.2.trans Finset.subset_union_left⟩
    have hSU : S ≤ U := Finset.subset_union_left
    have hTU : T ≤ U := Finset.subset_union_right
    refine ⟨U, ?_⟩
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact ⟨transition e hTU z, (of_transition E e hTU z).trans hz.symm⟩
    · obtain ⟨w, hw⟩ := hS y hy
      exact ⟨transition e hSU w, (of_transition E e hSU w).trans hw⟩

private theorem exists_stage_operator (S : Index E)
    (a : MonoidAlgebra ℂ (∀ v : S.1, FiniteLocalGL F n v)) :
    ∃ A ∈ tensorTranslationAlgebra F n ρ E e he,
      ∀ z : Stage ℂ V S.1, A (of ℂ V E e S z) =
        of ℂ V E e S ((FiniteTensor.external (fun v : S.1 => ρ v)).asAlgebraHom a z) := by
  classical
  induction a using MonoidAlgebra.induction_on with
  | of g =>
    let h := stageGroupElement (fun v => (localIntegral F n v).toSubgroup) S.1 g
    let d := (restrictedProductEquiv F n).symm h
    refine ⟨tensorRepresentation F n ρ E e he d, Algebra.subset_adjoin ⟨d, rfl⟩, ?_⟩
    intro z
    rw [Representation.asAlgebraHom_of]
    change representation _ ρ E e he (restrictedProductEquiv F n d) (of ℂ V E e S z) = _
    rw [show restrictedProductEquiv F n d = h from (restrictedProductEquiv F n).apply_symm_apply h]
    exact (of_external _ ρ E e he S g z).symm
  | add a b ha hb =>
    obtain ⟨A, hA, hAa⟩ := ha
    obtain ⟨B, hB, hBb⟩ := hb
    refine ⟨A + B, (tensorTranslationAlgebra F n ρ E e he).add_mem hA hB, ?_⟩
    intro z
    rw [LinearMap.add_apply, hAa, hBb, map_add, LinearMap.add_apply, map_add]
  | smul c a ha =>
    obtain ⟨A, hA, hAa⟩ := ha
    refine ⟨c • A, (tensorTranslationAlgebra F n ρ E e he).smul_mem hA c, ?_⟩
    intro z
    rw [LinearMap.smul_apply, hAa, map_smul, LinearMap.smul_apply, map_smul]

/-- The finite adelic translations generate an algebra acting densely on each
finite set of vectors in the restricted tensor of admissible irreducibles. -/
theorem tensorRepresentation_exists_eq_on
    (hne : ∀ v ∉ E, e v ≠ 0)
    (hI : ∀ v, (ρ v).IsIrreducible) (hA : ∀ v, IsAdmissible (ρ v))
    (s : Finset (Space ℂ V E e)) (T : Module.End ℂ (Space ℂ V E e)) :
    ∃ A ∈ tensorTranslationAlgebra F n ρ E e he,
      ∀ x ∈ s, A x = T x := by
  classical
  obtain ⟨S, hS⟩ := exists_common_stage F E e (s ∪ s.image T)
  let i := of ℂ V E e S
  have hi : LinearMap.ker i = ⊥ := LinearMap.ker_eq_bot.mpr (of_injective E e hne S)
  have hpreimage (x : Space ℂ V E e) (hx : x ∈ s ∪ s.image T) :
      i (i.leftInverse x) = x := by
    obtain ⟨z, rfl⟩ := hS x hx
    rw [LinearMap.leftInverse_apply_of_inj hi]
  let σ := FiniteTensor.external (fun v : S.1 => ρ v)
  let : ∀ v : S.1, (ρ v).IsIrreducible := fun v => hI v
  let : σ.IsIrreducible := FiniteTensor.isIrreducible_external _
    (fun v f => (admissibleSchur_scalarEndomorphism (ρ v) (hA v) (hI v) f).exists)
  have hσ : IsAdmissible σ := FiniteTensor.isAdmissible_external _ (fun v => hA v)
  obtain ⟨a, ha⟩ := FiniteTensor.exists_asAlgebraHom_eq_on σ
    (fun f => (admissibleSchur_scalarEndomorphism σ hσ inferInstance f).exists)
    (i.leftInverse.comp (T.comp i)) (s.image i.leftInverse)
  obtain ⟨A, hmem, hAa⟩ := exists_stage_operator F n ρ E e he S a
  refine ⟨A, hmem, fun x hx => ?_⟩
  have hx' := hpreimage x (Finset.mem_union_left _ hx)
  rw [← hx', hAa, ha _ (Finset.mem_image_of_mem _ hx)]
  change i (i.leftInverse (T (i (i.leftInverse x)))) = T (i (i.leftInverse x))
  rw [hx', hpreimage _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hx))]

end Langlands.Global.FiniteAdelicGL
