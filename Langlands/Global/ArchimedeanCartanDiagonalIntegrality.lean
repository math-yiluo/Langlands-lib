import Langlands.Global.ArchimedeanCartanCharacteristicCoefficients
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
import Mathlib.RingTheory.Adjoin.FG

/-! # Finite integral diagonal extension over actual characteristic coefficients -/

noncomputable section
universe u
open scoped TensorProduct
open NumberField
set_option autoImplicit false

namespace Langlands.Global.ArchimedeanGL

variable (K : Type u) [Field K] (n : ℕ)

/-- The monic diagonal product at one actual infinite place. -/
def cartanDiagonalCharacteristicPolynomial (v : CartanCharacteristicPlace K) :
    Polynomial (CartanDiagonalPolynomialAlgebra K n) :=
  ∏ i, (Polynomial.X - Polynomial.C (cartanDiagonalCoordinate K n v i))

theorem cartanDiagonalCharacteristicPolynomial_monic (v : CartanCharacteristicPlace K) :
    (cartanDiagonalCharacteristicPolynomial K n v).Monic := by
  classical
  exact Polynomial.monic_prod_of_monic _ _ (fun _ _ => Polynomial.monic_X_sub_C _)

theorem cartanDiagonalCharacteristicPolynomial_natDegree (v : CartanCharacteristicPlace K) :
    (cartanDiagonalCharacteristicPolynomial K n v).natDegree = n := by
  classical
  unfold cartanDiagonalCharacteristicPolynomial
  rw [Polynomial.natDegree_prod_of_monic Finset.univ
    (fun i : Fin n => Polynomial.X - Polynomial.C (cartanDiagonalCoordinate K n v i))
    (fun _ _ => Polynomial.monic_X_sub_C _)]
  simp

/-- The algebra generated by all bounded characteristic coefficients at all places. -/
def cartanDiagonalCharacteristicSubalgebra :
    Subalgebra ℂ (CartanDiagonalPolynomialAlgebra K n) :=
  Algebra.adjoin ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin (n + 1) =>
    (cartanDiagonalCharacteristicPolynomial K n a.1).coeff a.2))

theorem cartanDiagonalCharacteristicPolynomial_coeff_mem
    (v : CartanCharacteristicPlace K) (r : ℕ) :
    (cartanDiagonalCharacteristicPolynomial K n v).coeff r ∈
      cartanDiagonalCharacteristicSubalgebra K n := by
  by_cases hr : r < n + 1
  · exact Algebra.subset_adjoin ⟨(v, ⟨r, hr⟩), rfl⟩
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by
      rw [cartanDiagonalCharacteristicPolynomial_natDegree]
      omega)]
    exact (cartanDiagonalCharacteristicSubalgebra K n).zero_mem

theorem cartanDiagonalCoordinate_isIntegral
    (v : CartanCharacteristicPlace K) (i : Fin n) :
    IsIntegral (cartanDiagonalCharacteristicSubalgebra K n)
      (cartanDiagonalCoordinate K n v i) := by
  classical
  let A := cartanDiagonalCharacteristicSubalgebra K n
  have hl : cartanDiagonalCharacteristicPolynomial K n v ∈
      Polynomial.lifts (algebraMap A (CartanDiagonalPolynomialAlgebra K n)) := by
    apply (Polynomial.lifts_iff_coeff_lifts _).mpr
    intro r
    exact ⟨⟨_, cartanDiagonalCharacteristicPolynomial_coeff_mem K n v r⟩, rfl⟩
  obtain ⟨p, hp, _, hm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl
    (cartanDiagonalCharacteristicPolynomial_monic K n v)
  refine ⟨p, hm, ?_⟩
  rw [← Polynomial.eval_map, hp]
  simp only [cartanDiagonalCharacteristicPolynomial, Polynomial.eval_prod,
    Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
  exact Finset.prod_eq_zero (Finset.mem_univ i) (sub_self _)

section FinitePlaces

variable [NumberField K]

local instance : Fintype (CartanCharacteristicPlace K) := Fintype.ofFinite _
local instance : DecidableEq (CartanCharacteristicPlace K) := Classical.decEq _

theorem cartanDiagonalCharacteristicSubalgebra_fg :
    (cartanDiagonalCharacteristicSubalgebra K n).FG :=
  Subalgebra.fg_def.mpr ⟨_, Set.finite_range _, rfl⟩

instance cartanDiagonalCharacteristicSubalgebra_noetherian :
    IsNoetherianRing (cartanDiagonalCharacteristicSubalgebra K n) :=
  isNoetherianRing_of_fg (cartanDiagonalCharacteristicSubalgebra_fg K n)

/-- Collect the real diagonal entries at all actual places in a single coordinate space. -/
def realCartanDiagonalCoordinates :
    RealCartanDiagonal K n ≃ₗ[ℝ] (CartanCharacteristicPlace K × Fin n → ℝ) where
  toFun t a := match a.1 with
    | .inl v => t.1 v a.2
    | .inr v => t.2 v a.2
  invFun f := (fun v i => f (.inl v, i), fun v i => f (.inr v, i))
  left_inv t := rfl
  right_inv f := by
    funext a
    rcases a with ⟨v, i⟩
    cases v <;> rfl
  map_add' t s := by
    funext a
    rcases a with ⟨v, i⟩
    cases v <;> rfl
  map_smul' r t := by
    funext a
    rcases a with ⟨v, i⟩
    cases v <;> rfl

/-- The coordinate basis of the actual real diagonal space. -/
def realCartanDiagonalBasis :
    Module.Basis (CartanCharacteristicPlace K × Fin n) ℝ (RealCartanDiagonal K n) :=
  (Pi.basisFun ℝ _).map (realCartanDiagonalCoordinates K n).symm

theorem realCartanDiagonalBasis_repr (t : RealCartanDiagonal K n)
    (a : CartanCharacteristicPlace K × Fin n) :
    (realCartanDiagonalBasis K n).repr t a =
      match a.1 with
      | .inl v => t.1 v a.2
      | .inr v => t.2 v a.2 := by
  simp [realCartanDiagonalBasis, realCartanDiagonalCoordinates]

theorem cartanDiagonalCoordinateDual_eq_dualBasis
    (a : CartanCharacteristicPlace K × Fin n) :
    cartanDiagonalCoordinateDual K n a.1 a.2 =
      ((realCartanDiagonalBasis K n).baseChange ℂ).dualBasis a := by
  apply TensorProduct.AlgebraTensorModule.ext
  intro z t
  rw [cartanDiagonalCoordinateDual_tmul, Module.Basis.dualBasis_apply,
    Module.Basis.baseChange_repr_tmul, realCartanDiagonalBasis_repr]
  cases a.1 <;> simp [mul_comm]

theorem cartanDiagonalCoordinateDual_span :
    Submodule.span ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin n =>
      cartanDiagonalCoordinateDual K n a.1 a.2)) = ⊤ := by
  simp_rw [cartanDiagonalCoordinateDual_eq_dualBasis]
  exact ((realCartanDiagonalBasis K n).baseChange ℂ).dualBasis.span_eq

theorem cartanDiagonalCoordinate_adjoin_eq_top :
    Algebra.adjoin ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin n =>
      cartanDiagonalCoordinate K n a.1 a.2)) = ⊤ := by
  let B := Algebra.adjoin ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin n =>
    cartanDiagonalCoordinate K n a.1 a.2))
  have hι (f : Module.Dual ℂ (ComplexCartanDiagonal K n)) :
      SymmetricAlgebra.ι ℂ _ f ∈ B := by
    have hle : Submodule.span ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin n =>
        cartanDiagonalCoordinateDual K n a.1 a.2)) ≤
        B.toSubmodule.comap (SymmetricAlgebra.ι ℂ _) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨a, rfl⟩
      exact Algebra.subset_adjoin ⟨a, rfl⟩
    apply hle
    rw [cartanDiagonalCoordinateDual_span]
    exact Submodule.mem_top
  apply top_unique
  intro p hp
  clear hp
  change p ∈ B
  induction p using SymmetricAlgebra.induction with
  | algebraMap z => exact B.algebraMap_mem z
  | ι f => exact hι f
  | mul p q hp hq => exact B.mul_mem hp hq
  | add p q hp hq => exact B.add_mem hp hq

theorem cartanDiagonalCoordinate_adjoin_characteristic_eq_top :
    Algebra.adjoin (cartanDiagonalCharacteristicSubalgebra K n)
      (Set.range (fun a : CartanCharacteristicPlace K × Fin n =>
        cartanDiagonalCoordinate K n a.1 a.2)) = ⊤ := by
  apply Subalgebra.restrictScalars_injective ℂ
  rw [Algebra.Subalgebra.restrictScalars_adjoin, cartanDiagonalCoordinate_adjoin_eq_top,
    sup_top_eq, Subalgebra.restrictScalars_top]

/-- The entire actual diagonal polynomial algebra is finite over the characteristic coefficients. -/
instance cartanDiagonalPolynomialAlgebra_finite_characteristic :
    Module.Finite (cartanDiagonalCharacteristicSubalgebra K n)
      (CartanDiagonalPolynomialAlgebra K n) := by
  let A := cartanDiagonalCharacteristicSubalgebra K n
  let s := Set.range (fun a : CartanCharacteristicPlace K × Fin n =>
    cartanDiagonalCoordinate K n a.1 a.2)
  let B := Algebra.adjoin A s
  let : Module.Finite A B :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _) (by
      rintro _ ⟨a, rfl⟩
      exact cartanDiagonalCoordinate_isIntegral K n a.1 a.2)
  apply Module.Finite.of_surjective B.val.toLinearMap
  intro p
  refine ⟨⟨p, ?_⟩, rfl⟩
  change p ∈ Algebra.adjoin (cartanDiagonalCharacteristicSubalgebra K n) _
  rw [cartanDiagonalCoordinate_adjoin_characteristic_eq_top]
  exact Algebra.mem_top

/-- Every coefficient comes from an actual full-group fixed symmetric tensor. -/
theorem cartanDiagonalCharacteristicSubalgebra_le_invariant_range :
    cartanDiagonalCharacteristicSubalgebra K n ≤
      ((cartanCompactInvariantDiagonalRestriction K n).comp
        (cartanGroupInvariantRestriction K n)).range := by
  apply Algebra.adjoin_le
  rintro _ ⟨a, rfl⟩
  refine ⟨lieCharacteristicSymmetricInvariant K n a.1 a.2, ?_⟩
  exact lieCharacteristicSymmetricInvariant_diagonal_restriction K n a.1 a.2

end FinitePlaces
end Langlands.Global.ArchimedeanGL
