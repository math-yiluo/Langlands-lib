import Langlands.Global.AdelicNormOneDecomposition
import Langlands.Global.AdelicGroupQuotient

/-! # Actual positive-central rational quotient and norm-one comparison -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry
open scoped CategoryTheory.MonObj Topology

namespace Langlands.Global.PositiveRealTorus

open Langlands.GroupScheme AdelicGroupPoints

variable (F : Type u) [Field F] [NumberField F]
variable (G : GroupScheme (Spec (CommRingCat.of F)))
variable (T : CommGroupScheme (Spec (CommRingCat.of F)))
variable (i : T.toGrp ⟶ G)

/-- The actual subgroup generated by the intrinsic positive image and principal points. -/
def positiveRationalSubgroup : Subgroup (AdelicGroupPoints F G) :=
  imageSubgroup F T G i ⊔ rationalSubgroup F G

/-- The actual left homogeneous quotient by positive and principal rational points. -/
abbrev PositiveRationalQuotient := LeftCosetSpace (positiveRationalSubgroup F G T i)

theorem imageSubgroup_le_positiveRationalSubgroup :
    imageSubgroup F T G i ≤ positiveRationalSubgroup F G T i := le_sup_left

theorem rationalSubgroup_le_positiveRationalSubgroup :
    rationalSubgroup F G ≤ positiveRationalSubgroup F G T i := le_sup_right

/-- Inclusion of actual norm-one representatives descends to the positive rational quotient. -/
def normOneToPositiveQuotient :
    NormOneRationalQuotient F G → PositiveRationalQuotient F G T i :=
  LeftCosetSpace.lift (rationalNormOneSubgroup F G)
    (fun n => LeftCosetSpace.mk (positiveRationalSubgroup F G T i)
      (n : AdelicGroupPoints F G)) (by
        intro q n
        exact LeftCosetSpace.mk_subgroup_mul (positiveRationalSubgroup F G T i)
          ⟨q.val.val, rationalSubgroup_le_positiveRationalSubgroup F G T i
            (rationalNormOneSubgroupInclusion F G q).property⟩ n.val)

@[simp] theorem normOneToPositiveQuotient_mk (n : normOneSubgroup F G) :
    normOneToPositiveQuotient F G T i
      (LeftCosetSpace.mk (rationalNormOneSubgroup F G) n) =
        LeftCosetSpace.mk (positiveRationalSubgroup F G T i) (n : AdelicGroupPoints F G) :=
  rfl

variable (hi : Function.Injective (characterRestrict i))
variable [(characterRestrict i).range.FiniteIndex]
variable (I : Type u) [Fintype I]
variable (e : T.toGrp ≅ splitTorus (Spec (CommRingCat.of F)) I)

@[simp] theorem normOneFactor_normOne (n : normOneSubgroup F G) :
    normOneFactor F G T i hi I e (n : AdelicGroupPoints F G) = n := by
  apply Subtype.ext
  rw [normOneFactor_val, positiveFactor_normOne, map_one, inv_one, one_mul]

@[simp] theorem normOneFactor_positivePointMap (a : intrinsicSubgroup F T) :
    normOneFactor F G T i hi I e (positivePointMap F G T i a) = 1 := by
  apply Subtype.ext
  rw [normOneFactor_val, positiveFactor_positivePointMap, inv_mul_cancel]
  rfl

variable [IsAffine G.X.left]

/-- The actual norm-one projection is a continuous homomorphism under actual centrality. -/
def normOneProjection (hc : IsCentral i) :
    AdelicGroupPoints F G →ₜ* normOneSubgroup F G where
  toFun := normOneFactor F G T i hi I e
  map_one' := by
    simpa using normOneFactor_normOne F G T i hi I e (1 : normOneSubgroup F G)
  map_mul' x y :=
    congrArg Prod.snd ((normOneDecompositionMulEquiv F G T i hi I e hc).symm.map_mul x y)
  continuous_toFun := continuous_normOneFactor F G T i hi I e

@[simp] theorem normOneProjection_apply (hc : IsCentral i) (x : AdelicGroupPoints F G) :
    normOneProjection F G T i hi I e hc x = normOneFactor F G T i hi I e x := rfl

@[simp] theorem normOneProjection_normOne (hc : IsCentral i) (n : normOneSubgroup F G) :
    normOneProjection F G T i hi I e hc (n : AdelicGroupPoints F G) = n :=
  normOneFactor_normOne F G T i hi I e n

@[simp] theorem normOneProjection_positivePointMap (hc : IsCentral i)
    (a : intrinsicSubgroup F T) :
    normOneProjection F G T i hi I e hc (positivePointMap F G T i a) = 1 :=
  normOneFactor_positivePointMap F G T i hi I e a

@[simp] theorem normOneProjection_rational (hc : IsCentral i) (q : RationalGroupPoints F G) :
    normOneProjection F G T i hi I e hc (rational F G q) = rationalNormOne F G q :=
  normOneProjection_normOne F G T i hi I e hc (rationalNormOne F G q)

/-- The generated subgroup is exactly the inverse image of the actual norm-one principal
subgroup under the constructed projection. -/
theorem positiveRationalSubgroup_eq_comap (hc : IsCentral i) :
    positiveRationalSubgroup F G T i =
      (rationalNormOneSubgroup F G).comap
        (normOneProjection F G T i hi I e hc).toMonoidHom := by
  apply le_antisymm
  · apply sup_le
    · rintro x ⟨a, ha, rfl⟩
      change normOneProjection F G T i hi I e hc
        (positivePointMap F G T i ⟨a, ha⟩) ∈ rationalNormOneSubgroup F G
      rw [normOneProjection_positivePointMap]
      exact (rationalNormOneSubgroup F G).one_mem
    · rintro x ⟨q, rfl⟩
      change normOneProjection F G T i hi I e hc (rational F G q) ∈
        rationalNormOneSubgroup F G
      rw [normOneProjection_rational]
      exact ⟨q, rfl⟩
  · intro x hx
    change normOneFactor F G T i hi I e x ∈ rationalNormOneSubgroup F G at hx
    rcases hx with ⟨q, hq⟩
    rw [← positivePointMap_mul_normOneFactor F G T i hi I e x]
    apply (positiveRationalSubgroup F G T i).mul_mem
    · exact imageSubgroup_le_positiveRationalSubgroup F G T i
        (show positivePointMap F G T i
        (positiveFactor F G T i hi I e x) ∈ imageSubgroup F T G i from
          ⟨_, (positiveFactor F G T i hi I e x).property, rfl⟩)
    · apply rationalSubgroup_le_positiveRationalSubgroup F G T i
      exact ⟨q, congrArg Subtype.val hq⟩

include hi I e in
/-- The generated subgroup is the actual positive-times-principal product, in that order. -/
theorem mem_positiveRationalSubgroup_iff (hc : IsCentral i) (x : AdelicGroupPoints F G) :
    x ∈ positiveRationalSubgroup F G T i ↔
      ∃ (a : intrinsicSubgroup F T) (q : RationalGroupPoints F G),
        positivePointMap F G T i a * rational F G q = x := by
  constructor
  · intro hx
    have hp : normOneFactor F G T i hi I e x ∈ rationalNormOneSubgroup F G :=
      (congrArg (fun S : Subgroup (AdelicGroupPoints F G) => x ∈ S)
        (positiveRationalSubgroup_eq_comap F G T i hi I e hc)).mp hx
    obtain ⟨q, hq⟩ := hp
    refine ⟨positiveFactor F G T i hi I e x, q, ?_⟩
    rw [show rational F G q = (normOneFactor F G T i hi I e x : AdelicGroupPoints F G)
      from congrArg Subtype.val hq]
    exact positivePointMap_mul_normOneFactor F G T i hi I e x
  · rintro ⟨a, q, rfl⟩
    exact (positiveRationalSubgroup F G T i).mul_mem
      (imageSubgroup_le_positiveRationalSubgroup F G T i ⟨a.val, a.property, rfl⟩)
      (rationalSubgroup_le_positiveRationalSubgroup F G T i ⟨q, rfl⟩)

/-- The explicit norm-one factor descends through the full generated subgroup. -/
def positiveQuotientToNormOne (hc : IsCentral i) :
    PositiveRationalQuotient F G T i → NormOneRationalQuotient F G :=
  LeftCosetSpace.lift (positiveRationalSubgroup F G T i)
    (fun x => LeftCosetSpace.mk (rationalNormOneSubgroup F G)
      (normOneProjection F G T i hi I e hc x)) (by
        intro q x
        rw [map_mul]
        exact LeftCosetSpace.mk_subgroup_mul (rationalNormOneSubgroup F G)
          ⟨normOneProjection F G T i hi I e hc q.val, by
            exact (congrArg (fun S : Subgroup (AdelicGroupPoints F G) => q.val ∈ S)
              (positiveRationalSubgroup_eq_comap F G T i hi I e hc)).mp q.property⟩ _)

@[simp] theorem positiveQuotientToNormOne_mk (hc : IsCentral i)
    (x : AdelicGroupPoints F G) :
    positiveQuotientToNormOne F G T i hi I e hc
      (LeftCosetSpace.mk (positiveRationalSubgroup F G T i) x) =
        LeftCosetSpace.mk (rationalNormOneSubgroup F G)
          (normOneProjection F G T i hi I e hc x) := rfl

/-- The actual norm-one principal quotient is homeomorphic to the actual positive principal
quotient, by inclusion and the explicitly constructed norm-one factor. -/
def positiveQuotientHomeomorph (hc : IsCentral i) :
    NormOneRationalQuotient F G ≃ₜ PositiveRationalQuotient F G T i where
  toFun := normOneToPositiveQuotient F G T i
  invFun := positiveQuotientToNormOne F G T i hi I e hc
  left_inv q := by
    induction q using Quotient.inductionOn with
    | _ n =>
      change LeftCosetSpace.mk (rationalNormOneSubgroup F G)
        (normOneProjection F G T i hi I e hc n.val) =
          LeftCosetSpace.mk (rationalNormOneSubgroup F G) n
      rw [normOneProjection_normOne]
  right_inv q := by
    induction q using Quotient.inductionOn with
    | _ x =>
      change LeftCosetSpace.mk (positiveRationalSubgroup F G T i)
        (normOneFactor F G T i hi I e x : AdelicGroupPoints F G) =
          LeftCosetSpace.mk (positiveRationalSubgroup F G T i) x
      conv_rhs => rw [← positivePointMap_mul_normOneFactor F G T i hi I e x]
      exact (LeftCosetSpace.mk_subgroup_mul (positiveRationalSubgroup F G T i)
        ⟨_, imageSubgroup_le_positiveRationalSubgroup F G T i
          ⟨_, (positiveFactor F G T i hi I e x).property, rfl⟩⟩ _).symm
  continuous_toFun := by
    apply (LeftCosetSpace.continuous_iff (rationalNormOneSubgroup F G)).mpr
    exact (LeftCosetSpace.continuous_mk (positiveRationalSubgroup F G T i)).comp
      continuous_subtype_val
  continuous_invFun := by
    apply (LeftCosetSpace.continuous_iff (positiveRationalSubgroup F G T i)).mpr
    exact (LeftCosetSpace.continuous_mk (rationalNormOneSubgroup F G)).comp
      (normOneProjection F G T i hi I e hc).continuous

@[simp] theorem positiveQuotientHomeomorph_mk (hc : IsCentral i) (n : normOneSubgroup F G) :
    positiveQuotientHomeomorph F G T i hi I e hc
      (LeftCosetSpace.mk (rationalNormOneSubgroup F G) n) =
        LeftCosetSpace.mk (positiveRationalSubgroup F G T i) (n : AdelicGroupPoints F G) :=
  rfl

/-- Positive right translation on the actual quotient corresponds to translation by the
constructed norm-one projection, including for ambient elements outside the norm-one group. -/
theorem positiveQuotientHomeomorph_rightTranslate (hc : IsCentral i)
    (g : AdelicGroupPoints F G) (q : NormOneRationalQuotient F G) :
    positiveQuotientHomeomorph F G T i hi I e hc
      (LeftCosetSpace.rightTranslate (rationalNormOneSubgroup F G)
        (normOneProjection F G T i hi I e hc g) q) =
      LeftCosetSpace.rightTranslate (positiveRationalSubgroup F G T i) g
        (positiveQuotientHomeomorph F G T i hi I e hc q) := by
  apply (positiveQuotientHomeomorph F G T i hi I e hc).symm.injective
  induction q using Quotient.inductionOn with
  | _ n =>
    change LeftCosetSpace.mk (rationalNormOneSubgroup F G)
      (normOneProjection F G T i hi I e hc ((n : AdelicGroupPoints F G) *
        (normOneProjection F G T i hi I e hc g : AdelicGroupPoints F G))) =
      LeftCosetSpace.mk (rationalNormOneSubgroup F G)
        (normOneProjection F G T i hi I e hc ((n : AdelicGroupPoints F G) * g))
    simp only [map_mul, normOneProjection_normOne]

variable [LocallyOfFiniteType G.X.hom]

include hi I e in
/-- Closedness follows from the constructed projection and actual principal closedness. -/
theorem isClosed_positiveRationalSubgroup (hc : IsCentral i) :
    IsClosed (positiveRationalSubgroup F G T i : Set (AdelicGroupPoints F G)) := by
  rw [positiveRationalSubgroup_eq_comap F G T i hi I e hc]
  exact (rationalNormOneSubgroup_isClosed F G).preimage
    (normOneProjection F G T i hi I e hc).continuous

include hi I e in
theorem positiveRationalQuotient_t2Space (hc : IsCentral i) :
    T2Space (PositiveRationalQuotient F G T i) := by
  let : IsClosed (positiveRationalSubgroup F G T i : Set (AdelicGroupPoints F G)) :=
    isClosed_positiveRationalSubgroup F G T i hi I e hc
  infer_instance

omit [(characterRestrict i).range.FiniteIndex] in
/-- Local compactness descends through the open actual homogeneous quotient map. -/
instance positiveRationalQuotientLocallyCompactSpace :
    LocallyCompactSpace (PositiveRationalQuotient F G T i) := inferInstance

end Langlands.Global.PositiveRealTorus
