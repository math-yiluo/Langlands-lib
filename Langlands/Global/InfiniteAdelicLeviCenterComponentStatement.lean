import Langlands.Global.InfiniteAdelicLeviEnveloping
import Langlands.Automorphic.GroupSchemeForms
import Langlands.GroupScheme.Rational.LeviSubgroup
import Langlands.GroupScheme.Reductive.Basic

/-! # The Levi component of a central element of the archimedean enveloping algebra

For a parabolic `Q = M'V` of a connected reductive group `G` over a number field, every central
element `z` of the complex enveloping algebra of `G(F_∞)` is congruent, modulo the right ideal
generated by the tangent directions of `V(F_∞)`, to the image of a unique element of the complex
enveloping algebra of `M'(F_∞)`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry NumberField

set_option autoImplicit false

namespace Langlands.Global

open Langlands.GroupScheme Langlands.Automorphic.GroupSchemeFunctions InfiniteAdelicGroupPoints

/-- The Levi component of a central element (Knapp–Vogan, Lemma 4.123 (b); Harish-Chandra).
Let `G` be connected reductive over a number field `F`, `q : Q → G` a parabolic subgroup with
geometric unipotent radical `iV : V → Q` and rational Levi subgroup `l' : M' → Q`, and fix smooth
structures on `G` and `M'`. Write `j` for the algebra map from the complex enveloping algebra of
`M'(F_∞)` to that of `G(F_∞)` induced by the tangent map of `ι = l' ≫ q`, and `I_V` for the right
ideal generated by the tangent vectors at `1` of smooth curves in the image of `V(F_∞)`. Then every
central `z` has the form `j(y) + I_V`, and `j(y) ∈ I_V` only for `y = 0`; in particular `y` is
unique. -/
def LeviCenterComponentStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F]
    (G Q M' V : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffine G.X.left] [IsAffine Q.X.left] [IsAffine M'.X.left]
    (q : Q ⟶ G) (iV : V ⟶ Q) (l' : M' ⟶ Q),
    IsConnectedReductive G → IsParabolicSubgroup q →
    LeviSubgroup.IsGeometricUnipotentRadical iV → IsRationalLeviSubgroup l' →
    ∀ {d d' : ℕ} (hsmooth : SmoothOfRelativeDimension d G.X.hom)
      (hsmooth' : SmoothOfRelativeDimension d' M'.X.hom),
      let SV : Set (InfiniteAdelicGroupPoints F G) :=
        Set.range (V.affinePointsTarget (iV ≫ q) (CommAlgCat.of F (InfiniteAdeleRing F)))
      (∀ z : AdelicEnvelopingCenter F G hsmooth, ∃ y : AdelicEnvelopingAlgebra F M' hsmooth',
        (z : AdelicEnvelopingAlgebra F G hsmooth) -
            pointEnvelopingMap F hsmooth' hsmooth (l' ≫ q) y ∈
          curveRightIdeal F hsmooth SV) ∧
      ∀ y : AdelicEnvelopingAlgebra F M' hsmooth',
        pointEnvelopingMap F hsmooth' hsmooth (l' ≫ q) y ∈ curveRightIdeal F hsmooth SV →
          y = 0

end Langlands.Global
