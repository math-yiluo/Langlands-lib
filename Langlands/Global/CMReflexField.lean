import Langlands.Global.CMType
import Mathlib.Algebra.Algebra.Hom.Rat
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Trace.Basic

/-!
# Reflex fields of CM types and Clozel's field `E = F_c R`

For a CM type `Φ` of a CM field `K`, `Φ.reflexField` is the subfield of `ℂ`
generated by the partial traces `∑_{σ ∈ Φ} σ x`, `x ∈ K` (Clozel 1991, §5.1).
For an embedding `ι₀ : K → ℂ`, `Φ.clozelReflexField ι₀` is the compositum
`E = F_c R` of `ι₀(K)` and the reflex field (Clozel 1991, Définition 5.2).
It is a number field, and `ι₀` makes it an extension of `K`.

For the CM type induced from an imaginary quadratic subfield, the reflex
field lies in `ι₀(K)`, so `E = ι₀(K)`.
-/

noncomputable section

open NumberField Algebra

universe u v

namespace Langlands.Global.CMType

variable {K : Type u} [Field K] [NumberField K] [IsCMField K]

open scoped Classical in
/-- The partial trace `∑_{σ ∈ Φ} σ x` of `x ∈ K` along the CM type `Φ`. -/
def partialTrace (Φ : CMType K) (x : K) : ℂ :=
  ∑ σ ∈ Finset.univ.filter (· ∈ Φ), σ x

/-- The reflex field `R` of `(K, Φ)`: the subfield of `ℂ` generated by the partial traces. -/
def reflexField (Φ : CMType K) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range Φ.partialTrace)

/-- Clozel's reflex field `E = F_c R ⊂ ℂ`, where `F_c = K` is identified with a
subfield of `ℂ` by `ι₀`. -/
def clozelReflexField (Φ : CMType K) (ι₀ : K →+* ℂ) : IntermediateField ℚ ℂ :=
  Φ.reflexField ⊔ ι₀.toRatAlgHom.fieldRange

theorem partialTrace_mem_iSup (Φ : CMType K) (x : K) :
    Φ.partialTrace x ∈ ⨆ σ : K →+* ℂ, σ.toRatAlgHom.fieldRange := by
  classical
  refine IntermediateField.sum_mem _ fun σ _ => ?_
  exact (le_iSup (fun σ : K →+* ℂ => σ.toRatAlgHom.fieldRange) σ) ⟨x, rfl⟩

/-- `E` lies in the compositum of all complex embeddings of `K`. -/
theorem clozelReflexField_le_iSup (Φ : CMType K) (ι₀ : K →+* ℂ) :
    Φ.clozelReflexField ι₀ ≤ ⨆ σ : K →+* ℂ, σ.toRatAlgHom.fieldRange := by
  refine sup_le ?_ (le_iSup (fun σ : K →+* ℂ => σ.toRatAlgHom.fieldRange) ι₀)
  rw [reflexField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨x, rfl⟩
  exact Φ.partialTrace_mem_iSup x

instance finiteDimensional_fieldRange (σ : K →+* ℂ) :
    FiniteDimensional ℚ σ.toRatAlgHom.fieldRange :=
  LinearEquiv.finiteDimensional (AlgEquiv.ofInjectiveField σ.toRatAlgHom).toLinearEquiv

instance finiteDimensional_clozelReflexField (Φ : CMType K) (ι₀ : K →+* ℂ) :
    FiniteDimensional ℚ (Φ.clozelReflexField ι₀) :=
  FiniteDimensional.of_injective
    (IntermediateField.inclusion (Φ.clozelReflexField_le_iSup ι₀)).toLinearMap
    (IntermediateField.inclusion (Φ.clozelReflexField_le_iSup ι₀)).injective

instance numberField_clozelReflexField (Φ : CMType K) (ι₀ : K →+* ℂ) :
    NumberField (Φ.clozelReflexField ι₀) where

/-- The embedding `ι₀ : K → E`. -/
def toClozelReflexField (Φ : CMType K) (ι₀ : K →+* ℂ) : K →+* Φ.clozelReflexField ι₀ :=
  (ι₀.toRatAlgHom.codRestrict (Φ.clozelReflexField ι₀).toSubalgebra
    fun x => (le_sup_right : ι₀.toRatAlgHom.fieldRange ≤ Φ.clozelReflexField ι₀)
      ⟨x, rfl⟩).toRingHom

@[simp]
theorem coe_toClozelReflexField (Φ : CMType K) (ι₀ : K →+* ℂ) (x : K) :
    (Φ.toClozelReflexField ι₀ x : ℂ) = ι₀ x := rfl

section ImaginaryQuadratic

variable {F : Type v} [Field F] [NumberField F] [IsCMField F] [IsQuadraticExtension ℚ F]

/-- For Harris's CM type, induced from an embedding `τ` of an imaginary quadratic
subfield `ι : F → K`, the partial trace of `x` is `τ` of the trace of `x` over `F`. -/
theorem partialTrace_inducedFromImaginaryQuadratic (ι : F →+* K) (τ : F →+* ℂ) (x : K) :
    letI : Algebra F K := ι.toAlgebra
    (inducedFromImaginaryQuadratic ι τ).partialTrace x = τ (Algebra.trace F K x) := by
  classical
  let : Algebra F K := ι.toAlgebra
  let : Algebra F ℂ := τ.toAlgebra
  have h := trace_eq_sum_embeddings (K := F) (L := K) ℂ (x := x)
  change τ (Algebra.trace F K x) = ∑ σ : K →ₐ[F] ℂ, σ x at h
  rw [h, partialTrace]
  refine Finset.sum_bij' (fun σ hσ => ⟨σ, fun a => ?_⟩) (fun σ _ => (σ : K →+* ℂ)) ?_ ?_ ?_ ?_ ?_
  · exact RingHom.congr_fun ((Finset.mem_filter.mp hσ).2) a
  · intro σ _
    exact Finset.mem_univ _
  · intro σ _
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
    rw [mem_inducedFromImaginaryQuadratic]
    exact RingHom.ext fun a => σ.commutes a
  · intro σ _
    rfl
  · intro σ _
    rfl
  · intro σ _
    rfl

/-- For Harris's CM type, `E = ι₀(K)`: the reflex field lies in `ι₀(K)`. -/
theorem clozelReflexField_inducedFromImaginaryQuadratic (ι : F →+* K) (τ : F →+* ℂ)
    (ι₀ : K →+* ℂ) (hι₀ : ι₀ ∈ inducedFromImaginaryQuadratic ι τ) :
    (inducedFromImaginaryQuadratic ι τ).clozelReflexField ι₀ = ι₀.toRatAlgHom.fieldRange := by
  refine sup_eq_right.mpr ?_
  rw [reflexField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨x, rfl⟩
  let : Algebra F K := ι.toAlgebra
  rw [partialTrace_inducedFromImaginaryQuadratic]
  rw [mem_inducedFromImaginaryQuadratic] at hι₀
  refine ⟨ι (Algebra.trace F K x), ?_⟩
  change ι₀ (ι _) = τ _
  rw [← RingHom.comp_apply, hι₀]

end ImaginaryQuadratic

end Langlands.Global.CMType
