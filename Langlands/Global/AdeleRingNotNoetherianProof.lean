import Langlands.Global.AdeleRingNotNoetherianStatement
import Langlands.Global.AdelicNonunitSequence
import Mathlib.RingTheory.Noetherian.Basic

/-!
# Adele rings are not noetherian: proof

An infinite family of nonzero pairwise orthogonal idempotents gives a strictly increasing chain
of ideals. In a cofinite restricted product of nonzero rings over an infinite index set, the
tuples with coordinate one at a single place and zero elsewhere form such a family.
-/

noncomputable section

universe u v w

open scoped RestrictedProduct

namespace Langlands.Global

/-- A commutative ring with nonzero pairwise orthogonal idempotents `e n` is not noetherian:
the ideals generated by `e 0, …, e (n - 1)` strictly increase. -/
theorem not_isNoetherianRing_of_orthogonal_idempotents {A : Type w} [CommRing A] (e : ℕ → A)
    (hidem : ∀ n, e n * e n = e n) (hne : ∀ n, e n ≠ 0)
    (horth : ∀ m n, m ≠ n → e m * e n = 0) : ¬ IsNoetherianRing A := by
  intro hA
  let I : ℕ →o Ideal A := ⟨fun n => Ideal.span (e '' {m | m < n}), fun a b hab =>
    Ideal.span_mono (Set.image_mono fun m (hm : m < a) => lt_of_lt_of_le hm hab)⟩
  obtain ⟨n, hn⟩ := monotone_stabilizes_iff_noetherian.mpr hA I
  have hmem : e n ∈ I n := by
    rw [hn (n + 1) (Nat.le_succ n)]
    exact Ideal.subset_span ⟨n, Nat.lt_succ_self n, rfl⟩
  have key : ∀ x ∈ I n, x * e n = 0 := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      exact horth m n (ne_of_lt hm)
    | zero => exact zero_mul _
    | add x y _ _ hx hy => rw [add_mul, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_eq_mul, mul_assoc, hx, mul_zero]
  exact hne n (by rw [← hidem n]; exact key _ hmem)

section Restricted

variable {ι : Type u} {R : ι → Type v} [∀ i, CommRing (R i)] [∀ i, TopologicalSpace (R i)]
  (A : ∀ i, Subring (R i))

/-- The tuple with coordinate one at `i` and zero at every other place. -/
def restrictedOneAtPlace (i : ι) : Πʳ j, [R j, A j] := 1 - restrictedZeroAtPlace A i

theorem restrictedOneAtPlace_apply_self (i : ι) : restrictedOneAtPlace A i i = 1 := by
  simp [restrictedOneAtPlace, RestrictedProduct.sub_apply]

theorem restrictedOneAtPlace_apply_of_ne {i j : ι} (h : j ≠ i) :
    restrictedOneAtPlace A i j = 0 := by
  simp [restrictedOneAtPlace, RestrictedProduct.sub_apply, h]

theorem restrictedOneAtPlace_mul_self (i : ι) :
    restrictedOneAtPlace A i * restrictedOneAtPlace A i = restrictedOneAtPlace A i := by
  apply RestrictedProduct.ext
  intro j
  rw [RestrictedProduct.mul_apply]
  by_cases h : j = i
  · subst h
    rw [restrictedOneAtPlace_apply_self, mul_one]
  · rw [restrictedOneAtPlace_apply_of_ne A h, mul_zero]

theorem restrictedOneAtPlace_mul_of_ne {i i' : ι} (h : i ≠ i') :
    restrictedOneAtPlace A i * restrictedOneAtPlace A i' = 0 := by
  apply RestrictedProduct.ext
  intro j
  rw [RestrictedProduct.mul_apply, RestrictedProduct.zero_apply]
  by_cases hj : j = i
  · subst hj
    rw [restrictedOneAtPlace_apply_of_ne A h, mul_zero]
  · rw [restrictedOneAtPlace_apply_of_ne A hj, zero_mul]

theorem restrictedOneAtPlace_ne_zero [∀ i, Nontrivial (R i)] (i : ι) :
    restrictedOneAtPlace A i ≠ 0 := by
  intro h
  have h1 := restrictedOneAtPlace_apply_self A i
  rw [h, RestrictedProduct.zero_apply] at h1
  exact zero_ne_one h1

/-- A cofinite restricted product of nonzero commutative rings over an infinite index set is
not noetherian. -/
theorem not_isNoetherianRing_restrictedProduct [∀ i, Nontrivial (R i)] [Infinite ι] :
    ¬ IsNoetherianRing (Πʳ j, [R j, A j]) := by
  let e : ℕ ↪ ι := Infinite.natEmbedding ι
  exact not_isNoetherianRing_of_orthogonal_idempotents (fun n => restrictedOneAtPlace A (e n))
    (fun n => restrictedOneAtPlace_mul_self A (e n))
    (fun n => restrictedOneAtPlace_ne_zero A (e n))
    (fun m n hmn => restrictedOneAtPlace_mul_of_ne A (e.injective.ne hmn))

end Restricted

/-- The finite adele ring of a number field is not noetherian. -/
theorem finiteAdeles_not_isNoetherianRing (K : Type u) [Field K] [NumberField K] :
    ¬ IsNoetherianRing (FiniteAdeles K) := by
  have : Infinite (FinitePlace K) := numberField_finitePlaces_infinite K
  exact not_isNoetherianRing_restrictedProduct
    (fun v : FinitePlace K => (v.adicCompletionIntegers K).toSubring)

/-- The adele ring of a number field is not noetherian: it surjects onto the finite adeles. -/
theorem adeles_not_isNoetherianRing (K : Type u) [Field K] [NumberField K] :
    ¬ IsNoetherianRing (Adeles K) := by
  intro h
  exact finiteAdeles_not_isNoetherianRing K
    (isNoetherianRing_of_surjective (Adeles K) (FiniteAdeles K)
      (RingHom.snd (InfiniteAdeles K) (FiniteAdeles K)) Prod.snd_surjective)

/-- The curve-place adele ring of a function field over any constant field is not noetherian. -/
theorem curvePlaceAdeleRing_not_isNoetherianRing (k F : Type u) [Field k] [Field F]
    [Algebra k F] [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F] [FunctionField k F] :
    ¬ IsNoetherianRing (CurvePlaceAdeleRing k F) := by
  have : Infinite (AlgebraicCurve.Place k F) := functionField_places_infinite k F
  exact not_isNoetherianRing_restrictedProduct
    (fun v : AlgebraicCurve.Place k F => (curvePlaceCompletionIntegers v).toSubring)

/-- Conrad's remark (printed p.5) that adele rings are not noetherian holds. -/
theorem adeleRingNotNoetherian : AdeleRingNotNoetherianStatement.{u} :=
  ⟨fun K _ _ => adeles_not_isNoetherianRing K,
    fun k F _ _ _ _ _ _ => curvePlaceAdeleRing_not_isNoetherianRing k F⟩

end Langlands.Global
