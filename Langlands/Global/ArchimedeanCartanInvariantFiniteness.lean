import Langlands.Global.ArchimedeanCartanDiagonalIntegrality

/-! # Actual invariant restriction is a finite algebra homomorphism -/

noncomputable section
universe u
open NumberField
set_option autoImplicit false

namespace Langlands.Global.ArchimedeanGL

private theorem finite_of_finite_comp_of_injective
    {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    [Algebra ℂ A] [Algebra ℂ B] [Algebra ℂ C] [IsNoetherianRing A]
    (f : A →ₐ[ℂ] B) (g : B →ₐ[ℂ] C) (hg : Function.Injective g)
    (h : (g.comp f).Finite) : f.Finite := by
  let : Algebra A B := f.toRingHom.toAlgebra
  let : Algebra A C := (g.comp f).toRingHom.toAlgebra
  let : Module.Finite A C := h
  let L : B →ₗ[A] C :=
    { toFun := g
      map_add' := g.map_add
      map_smul' := fun a b => by
        change g (f a * b) = g (f a) * g b
        exact g.map_mul _ _ }
  exact Module.Finite.of_injective L hg

private theorem finite_of_subalgebra_image
    {A C : Type*} [CommRing A] [CommRing C] [Algebra ℂ A] [Algebra ℂ C]
    (f : A →ₐ[ℂ] C) (S : Subalgebra ℂ A) (T : Subalgebra ℂ C)
    (hST : S.map f = T) (hT : T.val.Finite) :
    AlgHom.Finite (R := ℂ) (A := S) (B := C) (f.comp S.val) := by
  let e : S.map f ≃ₐ[ℂ] T := Subalgebra.equivOfEq _ _ hST
  let q : S →ₐ[ℂ] T := e.toAlgHom.comp (f.subalgebraMap S)
  have hq : Function.Surjective q :=
    e.surjective.comp (f.subalgebraMap_surjective S)
  have heq : T.val.comp q = f.comp S.val := by
    ext x
    rfl
  have hfinite : AlgHom.Finite (R := ℂ) (A := S) (B := C) (T.val.comp q) :=
    AlgHom.Finite.comp (R := ℂ) (A := S) (B := T) (C := C) hT
      (AlgHom.Finite.of_surjective q hq)
  exact heq ▸ hfinite

variable (K : Type u) [Field K] [NumberField K] (n : ℕ)

local instance : Fintype (CartanCharacteristicPlace K) := Fintype.ofFinite _

/-- The subalgebra of actual full-group invariants generated by characteristic tensors. -/
def lieCharacteristicInvariantSubalgebra :
    Subalgebra ℂ (lieSymmetricGroupInvariants K n) :=
  Algebra.adjoin ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin (n + 1) =>
    lieCharacteristicSymmetricInvariant K n a.1 a.2))

theorem lieCharacteristicInvariantSubalgebra_fg :
    (lieCharacteristicInvariantSubalgebra K n).FG :=
  Subalgebra.fg_def.mpr ⟨_, Set.finite_range _, rfl⟩

instance lieCharacteristicInvariantSubalgebra_noetherian :
    IsNoetherianRing (lieCharacteristicInvariantSubalgebra K n) :=
  isNoetherianRing_of_fg (lieCharacteristicInvariantSubalgebra_fg K n)

/-- The characteristic tensor algebra maps onto precisely the diagonal coefficient algebra. -/
theorem lieCharacteristicInvariantSubalgebra_diagonal_image :
    (lieCharacteristicInvariantSubalgebra K n).map
      ((cartanCompactInvariantDiagonalRestriction K n).comp
        (cartanGroupInvariantRestriction K n)) =
      cartanDiagonalCharacteristicSubalgebra K n := by
  rw [lieCharacteristicInvariantSubalgebra, AlgHom.map_adjoin, ← Set.range_comp']
  change Algebra.adjoin ℂ (Set.range (fun a : CartanCharacteristicPlace K × Fin (n + 1) =>
    cartanCompactInvariantDiagonalRestriction K n
      (cartanGroupInvariantRestriction K n
        (lieCharacteristicSymmetricInvariant K n a.1 a.2)))) = _
  simp_rw [lieCharacteristicSymmetricInvariant_diagonal_restriction]
  rfl

/-- Actual characteristic tensors act finitely on all diagonal polynomial functions. -/
theorem lieCharacteristicInvariantSubalgebra_diagonal_finite :
    AlgHom.Finite (R := ℂ) (A := lieCharacteristicInvariantSubalgebra K n)
      (B := CartanDiagonalPolynomialAlgebra K n)
      (((cartanCompactInvariantDiagonalRestriction K n).comp
      (cartanGroupInvariantRestriction K n)).comp
        (lieCharacteristicInvariantSubalgebra K n).val) := by
  apply finite_of_subalgebra_image
    ((cartanCompactInvariantDiagonalRestriction K n).comp
      (cartanGroupInvariantRestriction K n))
    (lieCharacteristicInvariantSubalgebra K n)
    (cartanDiagonalCharacteristicSubalgebra K n)
    (lieCharacteristicInvariantSubalgebra_diagonal_image K n)
  change (algebraMap (cartanDiagonalCharacteristicSubalgebra K n)
    (CartanDiagonalPolynomialAlgebra K n)).Finite
  exact RingHom.finite_algebraMap.mpr inferInstance

/-- Compact fixed tensors are finite over the actual characteristic tensor algebra. -/
theorem cartanCharacteristicInvariantRestriction_finite :
    AlgHom.Finite (R := ℂ) (A := lieCharacteristicInvariantSubalgebra K n)
      (B := cartanSymmetricCompactInvariants K n)
      ((cartanGroupInvariantRestriction K n).comp
        (lieCharacteristicInvariantSubalgebra K n).val) :=
  finite_of_finite_comp_of_injective _ (cartanCompactInvariantDiagonalRestriction K n)
    (cartanCompactInvariantDiagonalRestriction_injective K n)
    (lieCharacteristicInvariantSubalgebra_diagonal_finite K n)

/-- Actual compact invariants form a finite module over actual full-group invariants. -/
theorem cartanGroupInvariantRestriction_finite :
    (cartanGroupInvariantRestriction K n).Finite :=
  AlgHom.Finite.of_comp_finite (cartanCharacteristicInvariantRestriction_finite K n)

end Langlands.Global.ArchimedeanGL
