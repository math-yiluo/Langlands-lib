import Langlands.Global.Arithmetic.CMFiniteNormSign
import Langlands.Global.Arithmetic.CMHalfWeightFiniteControl
import Langlands.Global.Arithmetic.CMHalfWeightLocalNormControl
import Langlands.ClassField.Global.IdeleClassNormGaloisProductProof
import Langlands.Global.Arithmetic.CMHalfWeightCharacterStatement
import Langlands.Global.Arithmetic.CMHalfWeightExtension
import Langlands.Global.Arithmetic.CMHalfWeightRealSign
import Langlands.Global.Arithmetic.CMHalfWeightNormInfinity

/-! # Conjugate-inverse weight-one characters on CM fields -/

noncomputable section

open Algebra NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped NumberField Langlands.Global.AdelicFunctoriality.FiniteExtension
open Langlands.ClassField.Global Langlands.Global.AdelicFunctoriality

namespace Langlands.Global.CMHalfWeight

universe u

variable {K : Type u} [Field K] [NumberField K]

local instance : CommGroup (IdeleClasses K) := inferInstance

/-- Integral ideles with trivial infinity part and finite support in `S`. -/
def supportedIntegralIdeles (S : Finset (FinitePlace K)) : Subgroup (Ideles K) where
  carrier := {s | s ∈ integralIdeles K ∧
    CMUnramifiedInfinity.infinityProjection s = 1 ∧
    ∀ w ∉ S, ideleCoordinate w s = 1}
  one_mem' := ⟨(integralIdeles K).one_mem, map_one _, fun _ _ => map_one _⟩
  mul_mem' := by
    rintro a b ⟨ha, haInf, haS⟩ ⟨hb, hbInf, hbS⟩
    exact ⟨(integralIdeles K).mul_mem ha hb, by rw [map_mul, haInf, hbInf, one_mul],
      fun w hw => by rw [map_mul, haS w hw, hbS w hw, one_mul]⟩
  inv_mem' := by
    rintro a ⟨ha, haInf, haS⟩
    exact ⟨(integralIdeles K).inv_mem ha, by rw [map_inv, haInf, inv_one],
      fun w hw => by rw [map_inv, haS w hw, inv_one]⟩

/-- Every prescribed local integral unit gives a supported integral idele. -/
theorem finiteIdeleInclusion_mem_supportedIntegralIdeles
    (S : Finset (FinitePlace K)) (w : FinitePlace K) (hw : w ∈ S)
    (a : (FiniteCompletion K w)ˣ)
    (ha : a ∈ (Submonoid.ofClass (w.adicCompletionIntegers K)).units) :
    finiteIdeleInclusion K w a ∈ supportedIntegralIdeles S := by
  classical
  have hau : Valued.v (a : FiniteCompletion K w) = 1 :=
    (HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one).mp ha
  refine ⟨?_, ?_, ?_⟩
  · intro v
    change Valued.v (Pi.mulSingle w (a : FiniteCompletion K w) v) = 1
    by_cases hv : v = w
    · subst v
      simpa only [Pi.mulSingle_eq_same] using hau
    · simp only [Pi.mulSingle_eq_of_ne hv, map_one]
  · apply Units.ext
    rfl
  · intro v hv
    apply Units.ext
    change Pi.mulSingle w (a : FiniteCompletion K w) v = 1
    exact Pi.mulSingle_eq_of_ne (show v ≠ w from fun h => hv (h.symm ▸ hw)) _

variable [IsCMField K]

local notation "F" => maximalRealSubfield K

/-- The quotient subgroup generated by included norm classes and supported
integral classes. -/
def normAndSupportClasses (S : Finset (FinitePlace K)) : Subgroup (IdeleClasses K) :=
  ((ideleClassInclusion (K := F) (L := K)).comp
    (ideleClassNorm (K := F) (L := K))).toMonoidHom.range ⊔
      (supportedIntegralIdeles S).map (ideleClassMap K).toMonoidHom

omit [IsCMField K] in
/-- The quotient subgroup contains every prescribed local integral unit. -/
theorem finiteClassInclusion_mem_normAndSupportClasses
    (S : Finset (FinitePlace K)) (w : FinitePlace K) (hw : w ∈ S)
    (a : (FiniteCompletion K w)ˣ)
    (ha : a ∈ (Submonoid.ofClass (w.adicCompletionIntegers K)).units) :
    finiteClassInclusion K w a ∈ normAndSupportClasses S :=
  Subgroup.mem_sup_right ⟨finiteIdeleInclusion K w a,
    finiteIdeleInclusion_mem_supportedIntegralIdeles S w hw a ha, rfl⟩

/-- The quotient subgroup kills the product of any class with its conjugate. -/
theorem mul_complexConj_mem_normAndSupportClasses
    (S : Finset (FinitePlace K)) (x : IdeleClasses K) :
    x * ideleClassComplexConj x ∈ normAndSupportClasses S := by
  classical
  apply Subgroup.mem_sup_left
  refine ⟨x, ?_⟩
  change ideleClassInclusion (ideleClassNorm (K := F) x) = _
  rw [ideleClassNormGaloisProduct F K x]
  let : Fintype (K ≃ₐ[F] K) := Fintype.ofFinite _
  have hcard : Fintype.card (K ≃ₐ[F] K) = 2 := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank,
      IsQuadraticExtension.finrank_eq_two]
  have huniv : (Finset.univ : Finset (K ≃ₐ[F] K)) = {1, IsCMField.complexConj K} := by
    symm
    apply Finset.eq_univ_of_card
    rw [Finset.card_pair (Ne.symm (IsCMField.complexConj_ne_one K)), hcard]
  rw [huniv, Finset.prod_pair (Ne.symm (IsCMField.complexConj_ne_one K))]
  change ideleClassEquiv (RingEquiv.refl K) x * ideleClassComplexConj x = _
  rw [ideleClassEquiv_refl]
  rfl

omit [IsCMField K] in
/-- A class in the chosen quotient subgroup has an actual principal, norm,
and supported-idele factorization. -/
theorem exists_principal_norm_support_of_mem (S : Finset (FinitePlace K))
    (x : Ideles K) (hx : ideleClassMap K x ∈ normAndSupportClasses S) :
    ∃ (a : Kˣ) (y s : Ideles K), s ∈ supportedIntegralIdeles S ∧
      diagonalUnits K a * ideleInclusion (ideleNorm (K := F) y) * s = x := by
  rw [normAndSupportClasses, Subgroup.mem_sup] at hx
  obtain ⟨n, hn, z, hz, heq⟩ := hx
  obtain ⟨ycl, rfl⟩ := hn
  obtain ⟨s, hs, rfl⟩ := hz
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (principalIdeles K) ycl
  have hquot : ideleClassMap K (ideleInclusion (ideleNorm (K := F) y) * s) =
      ideleClassMap K x := by
    rw [map_mul]
    exact heq
  have hprin : x / (ideleInclusion (ideleNorm (K := F) y) * s) ∈ principalIdeles K :=
    QuotientGroup.eq_iff_div_mem.mp hquot.symm
  obtain ⟨a, ha⟩ := hprin
  refine ⟨a, y, s, hs, ?_⟩
  rw [mul_assoc, ha, div_mul_cancel]

/-- An open subgroup containing infinity forces the real principal factor in
a norm-and-support relation to have positive rational norm. -/
theorem exists_open_subgroup_principal_norm_pos
    (S : Finset (FinitePlace K))
    (hS : Disjoint S (S.map
      (finitePlaceEquiv (IsCMField.complexConj K).toRingEquiv).toEmbedding)) :
    ∃ H : OpenSubgroup (Ideles K),
      (∀ x : (InfiniteAdeles K)ˣ, infiniteIdelesInclusion K x ∈ H) ∧
      ∀ (a : Kˣ) (y s : Ideles K), s ∈ supportedIntegralIdeles S →
        diagonalUnits K a * ideleInclusion (ideleNorm (K := F) y) * s ∈ H →
        ∃ aF : Fˣ, Units.map (algebraMap F K).toMonoidHom aF = a ∧
          0 < Algebra.norm ℚ (aF : F) := by
  classical
  obtain ⟨Hreal, _, hrealInf, hreal⟩ := exists_open_integral_subgroup_forcing_real S
  obtain ⟨Hnorm, _, hnormInf, hnorm⟩ :=
    exists_open_integral_subgroup_localNorm_control S hS
  refine ⟨Hreal ⊓ Hnorm, fun x => ⟨hrealInf x, hnormInf x⟩, ?_⟩
  intro a y s hs hx
  have hb : ideleEquiv (IsCMField.complexConj K).toRingEquiv
      (ideleInclusion (ideleNorm (K := F) y)) =
        ideleInclusion (ideleNorm (K := F) y) := by
    apply Units.ext
    exact IdeleGaloisDescentProof.adeleEquiv_adeleInclusion
      (IsCMField.complexConj K) _
  have hfix := hreal a _ s hb hs.1 hs.2.2 hx.1
  have haF : (a : K) ∈ F := (IsCMField.complexConj_eq_self_iff K (a : K)).mp hfix
  let aF : Fˣ := Units.mk0 ⟨a, haF⟩ (by
    intro hzero
    exact a.ne_zero (congrArg Subtype.val hzero))
  have hemb : Units.map (algebraMap F K).toMonoidHom aF = a := Units.ext rfl
  refine ⟨aF, hemb, norm_pos_of_finiteLocalNorm K aF ?_⟩
  have hh : ideleInclusion (diagonalUnits F aF * ideleNorm (K := F) y) * s ∈ Hnorm := by
    rw [map_mul, ideleInclusion_diagonal, hemb]
    exact hx.2
  intro p
  obtain ⟨q, hq⟩ := hnorm _ s hs.2.2 hh p
  have hn := ideleCoordinate_ideleNorm_mem_localNorm p q y
  rw [map_mul] at hq
  have ha : ideleCoordinate p (diagonalUnits F aF) ∈
      (Units.map (FiniteExtension.localNorm p q.1)).range :=
    ((Units.map (FiniteExtension.localNorm p q.1)).range.mul_mem_cancel_right hn).mp hq
  obtain ⟨b, hb⟩ := ha
  exact ⟨q, b, hb⟩

/-- The normalized weight-one infinity character is compatible with the
norm-and-support quotient on an open subgroup containing infinity. -/
theorem exists_open_subgroup_normAndSupport_kernel
    {t : InfinityType K} (ht : t.IsPureOfWeight 1)
    (S : Finset (FinitePlace K))
    (hS : Disjoint S (S.map
      (finitePlaceEquiv (IsCMField.complexConj K).toRingEquiv).toEmbedding)) :
    ∃ H : OpenSubgroup (Ideles K),
      (∀ x : (InfiniteAdeles K)ˣ, infiniteIdelesInclusion K x ∈ H) ∧
      ∀ x : H, ideleClassMap K (x : Ideles K) ∈ normAndSupportClasses S →
        normalizedCharacter t
          (CMUnramifiedInfinity.infinityProjection (x : Ideles K)) = 1 := by
  obtain ⟨H, hInf, hpos⟩ := exists_open_subgroup_principal_norm_pos S hS
  refine ⟨H, hInf, ?_⟩
  intro x hx
  obtain ⟨a, y, s, hs, heq⟩ := exists_principal_norm_support_of_mem S x hx
  have hmem : diagonalUnits K a * ideleInclusion (ideleNorm (K := F) y) * s ∈ H := by
    rw [heq]
    exact x.property
  obtain ⟨aF, haF, hnorm⟩ := hpos a y s hs hmem
  have hdiag : ideleInfinityCharacter t (diagonalUnits K a) = 1 := by
    change normalizedCharacter t (CMUnramifiedInfinity.infinityDiagonal a) = 1
    rw [← haF]
    exact normalizedCharacter_real_diagonal_of_norm_pos ht aF hnorm
  have hsInf : ideleInfinityCharacter t s = 1 := by
    change normalizedCharacter t (CMUnramifiedInfinity.infinityProjection s) = 1
    rw [hs.2.1, map_one]
  change ideleInfinityCharacter t (x : Ideles K) = 1
  simp only [← heq, map_mul, hdiag,
    ideleInfinityCharacter_included_norm ht, hsInf, one_mul]

end Langlands.Global.CMHalfWeight

namespace Langlands.Global

/-- Every pure weight-one infinity type on a CM field has the conjugate-inverse
Hecke-character realization with the exact absolute-value twist and the
prescribed finite unramifiedness. -/
theorem cmHalfWeightCharacter : CMHalfWeightCharacterStatement.{u} := by
  intro K _ _ _ t ht S hS
  obtain ⟨H, hInf, hker⟩ := CMHalfWeight.exists_open_subgroup_normAndSupport_kernel ht S hS
  obtain ⟨φ, hφc, hφInf, hφS⟩ := CMHalfWeight.exists_heckeCharacter_of_open_kernel
    (CMHalfWeight.normAndSupportClasses S)
    (CMHalfWeight.mul_complexConj_mem_normAndSupportClasses S)
    S (CMHalfWeight.finiteClassInclusion_mem_normAndSupportClasses S)
    H.toSubgroup H.isOpen hInf (CMHalfWeight.normalizedCharacter t) hker
  refine ⟨φ, hφc, ?_, hφS⟩
  intro x
  rw [hφInf]
  exact CMHalfWeight.normalizedCharacter_twist t x

end Langlands.Global
