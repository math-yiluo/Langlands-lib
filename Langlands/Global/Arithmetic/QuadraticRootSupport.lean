import Langlands.Global.Arithmetic.FieldRealizationStatement
import Mathlib.FieldTheory.KummerPolynomial

/-! # Square-root intermediate fields -/

namespace Langlands.Global

open Polynomial IntermediateField

universe u v

/-- The rational intermediate field generated by a supplied element. -/
@[reducible] noncomputable def rationalRootField {C : Type u} [Field C] [Algebra ℚ C]
    (x : C) : IntermediateField ℚ C := ℚ⟮x⟯

lemma squareRoot_isIntegral {F : Type u} {E : Type v} [Field F] [Field E]
    [Algebra F E] {a : F} {x : E} (hx : x ^ 2 = algebraMap F E a) :
    IsIntegral F x := by
  refine ⟨X ^ 2 - C a, monic_X_pow_sub_C _ (by decide), ?_⟩
  simpa only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_C, sub_eq_zero] using hx

lemma squareRoot_minpoly {F : Type u} {E : Type v} [Field F] [Field E]
    [Algebra F E] {a : F} {x : E} (ha : ¬ IsSquare a)
    (hx : x ^ 2 = algebraMap F E a) : minpoly F x = X ^ 2 - C a := by
  symm
  apply minpoly.eq_of_irreducible_of_monic
  · apply X_pow_sub_C_irreducible_of_prime Nat.prime_two
    intro b hb
    exact ha ⟨b, by simpa only [pow_two] using hb.symm⟩
  · simpa only [map_sub, map_pow, aeval_X, aeval_C, sub_eq_zero] using hx
  · exact monic_X_pow_sub_C _ (by decide)

lemma squareRoot_finrank {F : Type u} {E : Type v} [Field F] [Field E]
    [Algebra F E] {a : F} {x : E} (ha : ¬ IsSquare a)
    (hx : x ^ 2 = algebraMap F E a) : Module.finrank F F⟮x⟯ = 2 := by
  rw [adjoin.finrank (squareRoot_isIntegral hx), squareRoot_minpoly ha hx,
    natDegree_X_pow_sub_C]

lemma rationalRootField_gen_sq {C : Type u} [Field C] [Algebra ℚ C]
    {d : ℚ} {x : C} (hx : x ^ 2 = algebraMap ℚ C d) :
    (AdjoinSimple.gen ℚ x) ^ 2 = algebraMap ℚ (rationalRootField x) d := by
  apply Subtype.ext
  simpa using hx

lemma rationalRootField_numberField {C : Type u} [Field C] [CharZero C]
    {d : ℚ} {x : C} (hx : x ^ 2 = algebraMap ℚ C d) :
    NumberField (rationalRootField x) := by
  have := adjoin.finiteDimensional (squareRoot_isIntegral hx)
  exact NumberField.of_module_finite ℚ (rationalRootField x)

lemma complexRoot_im_zero {d : ℚ} (hd : 0 < d) {z : ℂ}
    (hz : z ^ 2 = algebraMap ℚ ℂ d) : z.im = 0 := by
  have hr := congrArg Complex.re hz
  have hi := congrArg Complex.im hz
  simp [pow_two] at hr hi
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hr' : z.re * z.re - z.im * z.im = (d : ℝ) := by simpa using hr
  have hi' : z.re * z.im + z.im * z.re = 0 := by simpa using hi
  have hre : z.re ≠ 0 := by intro h; rw [h] at hr'; nlinarith [sq_nonneg z.im]
  rcases mul_eq_zero.mp (show z.re * z.im = 0 by linarith) with h | h
  · exact (hre h).elim
  · exact h

lemma rationalRootField_totallyReal {C : Type u} [Field C] [CharZero C]
    {d : ℚ} {x : C} (hd : 0 < d) (hx : x ^ 2 = algebraMap ℚ C d) :
    NumberField.IsTotallyReal (rationalRootField x) := by
  constructor
  intro w
  rw [NumberField.InfinitePlace.isReal_iff, NumberField.ComplexEmbedding.isReal_iff]
  apply RingHom.ext
  intro y
  have hφ : (NumberField.ComplexEmbedding.conjugate w.embedding).toRatAlgHom =
      w.embedding.toRatAlgHom := by
    apply adjoin_algHom_ext ℚ
    intro z hz
    have hz' : z = x := Set.mem_singleton_iff.mp hz
    subst z
    have hsq : (w.embedding (AdjoinSimple.gen ℚ x)) ^ 2 = algebraMap ℚ ℂ d := by
      rw [← map_pow, rationalRootField_gen_sq hx]
      exact w.embedding.toRatAlgHom.commutes d
    have him := complexRoot_im_zero hd hsq
    apply Complex.ext
    · rfl
    · change -(w.embedding (AdjoinSimple.gen ℚ x)).im =
        (w.embedding (AdjoinSimple.gen ℚ x)).im
      rw [him, neg_zero]
  exact AlgHom.congr_fun hφ y

lemma rationalRootField_totallyComplex {C : Type u} [Field C] [CharZero C]
    {d : ℚ} {x : C} (hd : d < 0) (hx : x ^ 2 = algebraMap ℚ C d) :
    NumberField.IsTotallyComplex (rationalRootField x) := by
  constructor
  intro w
  rw [NumberField.InfinitePlace.isComplex_iff]
  intro hw
  let φ := NumberField.ComplexEmbedding.IsReal.embedding hw
  have hsq : (φ (AdjoinSimple.gen ℚ x)) ^ 2 = (d : ℝ) := by
    rw [← map_pow, rationalRootField_gen_sq hx]
    exact φ.toRatAlgHom.commutes d
  have hd' : (d : ℝ) < 0 := by exact_mod_cast hd
  nlinarith [sq_nonneg (φ (AdjoinSimple.gen ℚ x))]

lemma rationalRootField_two_embeddings {C : Type u} {L : Type v}
    [Field C] [CharZero C] [Field L] [CharZero L]
    {d : ℚ} {x : C} (hd : ¬ IsSquare d) (hx : x ^ 2 = algebraMap ℚ C d)
    (hL : IsSquare (algebraMap ℚ L d)) :
    ∃ φ ψ : rationalRootField x →ₐ[ℚ] L, φ ≠ ψ := by
  obtain ⟨y, hy⟩ := hL
  have hy2 : y ^ 2 = algebraMap ℚ L d := by simpa only [pow_two] using hy.symm
  let pb := adjoin.powerBasis (squareRoot_isIntegral hx)
  have hm : minpoly ℚ pb.gen = X ^ 2 - Polynomial.C d := by
    rw [adjoin.powerBasis_gen, minpoly_gen, squareRoot_minpoly hd hx]
  have hyroot : aeval y (minpoly ℚ pb.gen) = 0 := by
    rw [hm]
    simpa only [map_sub, map_pow, aeval_X, aeval_C, sub_eq_zero] using hy2
  have hnyroot : aeval (-y) (minpoly ℚ pb.gen) = 0 := by
    rw [hm]
    simpa only [map_sub, map_pow, aeval_X, aeval_C, neg_sq, sub_eq_zero] using hy2
  refine ⟨pb.lift y hyroot, pb.lift (-y) hnyroot, ?_⟩
  intro heq
  have he := AlgHom.congr_fun heq pb.gen
  rw [pb.lift_gen, pb.lift_gen] at he
  have hy0 : y = 0 := by
    have : (2 : L) * y = 0 := by linear_combination he
    exact (mul_eq_zero.mp this).resolve_left (by norm_num)
  have hd0 : d = 0 := by
    apply (algebraMap ℚ L).injective
    simpa [hy0] using hy2.symm
  subst d
  exact hd ⟨0, by simp⟩

end Langlands.Global
