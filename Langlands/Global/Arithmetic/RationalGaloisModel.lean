import Langlands.Global.Arithmetic.KrasnerNeighborhood
import Langlands.Global.Arithmetic.RationalPadicApproximation
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.NumberTheory.NumberField.InfinitePlace.TotallyRealComplex

/-! # Totally real rational splitting models of finite p-adic Galois fields -/

noncomputable section

namespace Langlands.Global.FieldRealization

open Polynomial IntermediateField NumberField

universe u

/-- A finite Galois p-adic field is generated by a root of a rational polynomial
that splits over both that field and the real numbers. -/
theorem exists_rational_defining_polynomial (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    ∃ (g : Polynomial ℚ) (y : M), g.Monic ∧ g.Separable ∧
      (g.map (algebraMap ℚ ℝ)).Splits ∧
      (g.map (algebraMap ℚ M)).Splits ∧
      aeval y g = 0 ∧ (Padic p)⟮y⟯ = ⊤ := by
  classical
  let C := AlgebraicClosure M
  let : NormedField C := spectralNorm.normedField (Padic p) C
  let : NormedAlgebra (Padic p) C := spectralNorm.normedAlgebra (Padic p) C
  let i : M →ₐ[Padic p] C := IsScalarTower.toAlgHom (Padic p) M C
  obtain ⟨x, hx⟩ := Field.exists_primitive_element (Padic p) M
  have hxsep : IsSeparable (Padic p) (i x) := Algebra.IsSeparable.isSeparable _ _
  obtain ⟨g, hgm, hgdeg, hgr, hgsep, hgcoeff⟩ :=
    exists_monic_rat_real_split_padic_approx p (minpoly (Padic p) (i x))
      (minpoly.monic hxsep.isIntegral) (coefficientRadius_pos (K := Padic p) (i x))
  obtain ⟨z, hz, hxz⟩ := exists_root_adjoin_eq_of_coeff_lt (i x) hxsep
    (IsAlgClosed.splits _) (g.map (algebraMap ℚ (Padic p)))
    (hgm.map _) (by simpa using hgdeg) hgcoeff (by
      simpa only [Polynomial.map_map, ← IsScalarTower.algebraMap_eq] using
        IsAlgClosed.splits (g.map (algebraMap ℚ C)))
  have hzmem : z ∈ (⊤ : IntermediateField (Padic p) M).map i := by
    rw [← hx, IntermediateField.adjoin_map, Set.image_singleton, hxz]
    exact IntermediateField.mem_adjoin_simple_self _ _
  change ∃ y ∈ (⊤ : IntermediateField (Padic p) M), i y = z at hzmem
  obtain ⟨y, _, hy⟩ := hzmem
  have hymap : aeval (i y) (g.map (algebraMap ℚ (Padic p))) = 0 := hy.symm ▸ hz
  have hy0P : aeval y (g.map (algebraMap ℚ (Padic p))) = 0 := by
    apply i.injective
    change i (aeval y (g.map (algebraMap ℚ (Padic p)))) = i 0
    rw [← Polynomial.aeval_algHom_apply i, hymap, map_zero]
  have hy0 : aeval y g = 0 := by
    simpa only [aeval_def, eval₂_map, ← IsScalarTower.algebraMap_eq] using hy0P
  have hytop : (Padic p)⟮y⟯ = ⊤ := by
    apply IntermediateField.map_injective i
    rw [IntermediateField.adjoin_map, Set.image_singleton, hy, ← hxz,
      ← Set.image_singleton, ← IntermediateField.adjoin_map, hx]
  have hyint : IsIntegral (Padic p) y := IsIntegral.of_finite _ _
  have hxeq : (minpoly (Padic p) (i x)).natDegree = Module.finrank (Padic p) M := by
    rw [minpoly.algHom_eq i i.injective x,
      ← Field.primitive_element_iff_minpoly_natDegree_eq]
    exact hx
  have hyeq : (minpoly (Padic p) y).natDegree = Module.finrank (Padic p) M :=
    (Field.primitive_element_iff_minpoly_natDegree_eq (Padic p) y).mp hytop
  have hpoly : g.map (algebraMap ℚ (Padic p)) = minpoly (Padic p) y :=
    eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hyint) (hgm.map _)
      (minpoly.dvd (Padic p) y hy0P) (by simp [hgdeg, hxeq, hyeq])
  refine ⟨g, y, hgm, hgsep, hgr, ?_, hy0, hytop⟩
  have hs := (inferInstance : Normal (Padic p) M).splits y
  rw [← hpoly, Polynomial.map_map, ← IsScalarTower.algebraMap_eq] at hs
  exact hs


/-- A rational polynomial defining the supplied finite p-adic Galois field,
chosen with simple real roots. -/
def rationalDefiningPolynomial (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] : Polynomial ℚ :=
  Classical.choose (exists_rational_defining_polynomial p M)

theorem rationalDefiningPolynomial_spec (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    ∃ y : M, (rationalDefiningPolynomial p M).Monic ∧
      (rationalDefiningPolynomial p M).Separable ∧
      ((rationalDefiningPolynomial p M).map (algebraMap ℚ ℝ)).Splits ∧
      ((rationalDefiningPolynomial p M).map (algebraMap ℚ M)).Splits ∧
      aeval y (rationalDefiningPolynomial p M) = 0 ∧ (Padic p)⟮y⟯ = ⊤ :=
  Classical.choose_spec (exists_rational_defining_polynomial p M)

/-- A Type-0 rational splitting field modeling the supplied p-adic Galois field. -/
abbrev rationalGaloisModel (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] : Type :=
  (rationalDefiningPolynomial p M).SplittingField

instance rationalGaloisModel_numberField (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    NumberField (rationalGaloisModel p M) where
  to_charZero := inferInstance
  to_finiteDimensional := inferInstance

instance rationalGaloisModel_isGalois (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    IsGalois ℚ (rationalGaloisModel p M) := by
  obtain ⟨y, -, hsep, -⟩ := rationalDefiningPolynomial_spec p M
  exact IsGalois.of_separable_splitting_field hsep

instance rationalGaloisModel_isTotallyReal (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    NumberField.IsTotallyReal (rationalGaloisModel p M) := by
  obtain ⟨y, -, -, hreal, -⟩ := rationalDefiningPolynomial_spec p M
  let r : rationalGaloisModel p M →ₐ[ℚ] ℝ := SplittingField.lift _ hreal
  let φ : rationalGaloisModel p M →+* ℂ := Complex.ofRealHom.comp r.toRingHom
  have hφ : ComplexEmbedding.IsReal φ := by
    apply ComplexEmbedding.isReal_iff.mpr
    ext x
    simp [φ]
  refine ⟨fun v ↦ NumberField.InfinitePlace.isReal_iff.mpr ?_⟩
  obtain ⟨σ, hσ⟩ := ComplexEmbedding.exists_comp_symm_eq_of_comp_eq (k := ℚ)
    φ v.embedding (Subsingleton.elim _ _)
  rw [← hσ]
  exact hφ.comp σ.symm.toRingHom

/-- The rational splitting model embeds into the supplied p-adic Galois field. -/
def rationalGaloisModelEmbedding (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    rationalGaloisModel p M →ₐ[ℚ] M :=
  SplittingField.lift _ (Classical.choose_spec
    (rationalDefiningPolynomial_spec p M)).2.2.2.1

theorem rationalGaloisModelEmbedding_adjoin (p : ℕ) [Fact p.Prime]
    (M : Type u) [Field M] [CharZero M] [Algebra (Padic p) M]
    [FiniteDimensional (Padic p) M] [IsGalois (Padic p) M] :
    IntermediateField.adjoin (Padic p) (Set.range (rationalGaloisModelEmbedding p M)) = ⊤ := by
  obtain ⟨y, hmonic, -, -, -, hy, hytop⟩ := rationalDefiningPolynomial_spec p M
  have hyrange : y ∈ (rationalGaloisModelEmbedding p M).range := by
    rw [← Polynomial.IsSplittingField.adjoin_rootSet_eq_range (rationalGaloisModel p M)
      (rationalDefiningPolynomial p M) (rationalGaloisModelEmbedding p M)]
    exact Algebra.subset_adjoin ((hmonic.mem_rootSet).mpr hy)
  apply top_unique
  rw [← hytop]
  apply IntermediateField.adjoin_le_iff.mpr
  exact Set.singleton_subset_iff.mpr (IntermediateField.subset_adjoin _ _ hyrange)

end Langlands.Global.FieldRealization
