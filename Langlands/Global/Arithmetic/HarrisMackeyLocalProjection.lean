import Langlands.Global.Arithmetic.HarrisMackeyLocalTower

/-! # Intersecting a prime cyclic tower with a normal local extension -/

noncomputable section

universe uF

namespace Langlands.Global.GeneralPosition

open LocalFactor.CommonClosure Weil.Local

private theorem sup_normal_step {G : Type*} [Group G]
    (A B N : Subgroup G) [N.Normal] (hAB : A ≤ B) (h : (A.subgroupOf B).Normal) :
    ((A ⊔ N).subgroupOf (B ⊔ N)).Normal ∧
      (A ⊔ N).relIndex (B ⊔ N) ∣ A.relIndex B := by
  let q := QuotientGroup.mk' N
  have hc (S : Subgroup G) : (S.map q).comap q = S ⊔ N := by
    rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk']
  constructor
  · refine ⟨fun x hx y => ?_⟩
    have hx' : (x : G) ∈ A ⊔ N := hx
    obtain ⟨a, ha, hax⟩ : q (x : G) ∈ A.map q := show (x : G) ∈ (A.map q).comap q from
      (hc A).symm ▸ hx'
    obtain ⟨b, hb, hby⟩ : q (y : G) ∈ B.map q := show (y : G) ∈ (B.map q).comap q from
      (hc B).symm ▸ y.2
    have hab : b * a * b⁻¹ ∈ A := h.conj_mem ⟨a, hAB ha⟩ ha ⟨b, hb⟩
    have hq : (y : G) * x * (y : G)⁻¹ ∈ (A.map q).comap q :=
      ⟨b * a * b⁻¹, hab, by simp only [map_mul, map_inv, hax, hby]⟩
    exact (hc A) ▸ hq
  · calc
      (A ⊔ N).relIndex (B ⊔ N) = (A.map q).relIndex (B.map q) := by
        rw [Subgroup.relIndex_map_map, QuotientGroup.ker_mk']
      _ = (A ⊔ N).relIndex B := by rw [← Subgroup.relIndex_comap, hc A]
      _ ∣ A.relIndex B := Subgroup.relIndex_dvd_of_le_left B le_sup_left

variable {p : ℕ} [Fact p.Prime] (F : PadicField.{uF} p)

private theorem localCharZero : CharZero F.Carrier :=
  charZero_of_injective_algebraMap (algebraMap (Padic p) F.Carrier).injective

/-- The actual intersection of two finite subextensions. -/
def intersect (X M : Extension F) : Extension F :=
  ⟨X.field ⊓ M.field, FiniteDimensional.of_injective
    (IntermediateField.inclusion (inf_le_left : X.field ⊓ M.field ≤ X.field)).toLinearMap
    (IntermediateField.inclusion (inf_le_left : X.field ⊓ M.field ≤ X.field)).injective⟩

private theorem fixingSubgroup_intersect (X M : Extension F) :
    (intersect F X M).field.fixingSubgroup = X.field.fixingSubgroup ⊔ M.field.fixingSubgroup := by
  let := localCharZero F
  let : IsGalois F.Carrier (AlgebraicClosure F.Carrier) := ⟨⟩
  let H := X.field.fixingSubgroup ⊔ M.field.fixingSubgroup
  have hH : IsOpen (H : Set (Gal(AlgebraicClosure F.Carrier/F.Carrier))) :=
    Subgroup.isOpen_mono le_sup_left (IntermediateField.fixingSubgroup_isOpen X.field)
  have hfix : IntermediateField.fixedField H = X.field ⊓ M.field := by
    apply le_antisymm
    · refine le_inf ?_ ?_
      · rw [← InfiniteGalois.fixedField_fixingSubgroup X.field]
        exact IntermediateField.fixedField_le le_sup_left
      · rw [← InfiniteGalois.fixedField_fixingSubgroup M.field]
        exact IntermediateField.fixedField_le le_sup_right
    · rw [IntermediateField.le_iff_le]
      exact sup_le (IntermediateField.fixingSubgroup_antitone inf_le_left)
        (IntermediateField.fixingSubgroup_antitone inf_le_right)
  change (X.field ⊓ M.field).fixingSubgroup = H
  rw [← hfix]
  exact InfiniteGalois.fixingSubgroup_fixedField ⟨H, (⟨H, hH⟩ : OpenSubgroup _).isClosed⟩

/-- The Weil subgroup of the intersection is generated by the two Weil fixing
subgroups when the second field is Galois. -/
theorem weilSubgroup_intersect (X M : Extension F) [IsGalois F.Carrier M.field] :
    weilSubgroup F (intersect F X M) = weilSubgroup F X ⊔ weilSubgroup F M := by
  let := localCharZero F
  let : IsGalois F.Carrier (AlgebraicClosure F.Carrier) := ⟨⟩
  let : M.field.fixingSubgroup.Normal := (InfiniteGalois.normal_iff_isGalois M.field).mpr inferInstance
  let : (weilSubgroup F M).Normal := (inferInstance : M.field.fixingSubgroup.Normal).comap _
  apply le_antisymm
  · intro w hw
    have hw' : localProjection F w ∈ X.field.fixingSubgroup ⊔ M.field.fixingSubgroup :=
      (fixingSubgroup_intersect F X M) ▸ (show localProjection F w ∈ _ from hw)
    obtain ⟨σ, hσ, τ, hτ, hστ⟩ :=
      (Subgroup.mem_sup_of_normal_right (s := X.field.fixingSubgroup)
        (t := M.field.fixingSubgroup)).mp hw'
    let q : Gal(AlgebraicClosure F.Carrier/F.Carrier) →* Gal(M.field/F.Carrier) :=
      AlgEquiv.restrictNormalHom M.field
    let g : localWeilGroup F →* Gal(AlgebraicClosure F.Carrier/F.Carrier) :=
      (localProjection F).toMonoidHom
    have hk : q.ker = M.field.fixingSubgroup := M.field.restrictNormalHom_ker
    have hq : Continuous q := InfiniteGalois.restrictNormalHom_continuous M.field
    have hopen : IsOpen ((X.field.fixingSubgroup :
        Set Gal(AlgebraicClosure F.Carrier/F.Carrier)) ∩
        q ⁻¹' {q σ}) :=
      (IntermediateField.fixingSubgroup_isOpen X.field).inter
        ((isOpen_discrete ({q σ} : Set Gal(M.field/F.Carrier))).preimage hq)
    obtain ⟨v, hv⟩ := (localProjection_denseRange F).exists_mem_open hopen ⟨σ, hσ, rfl⟩
    have hvw : v⁻¹ * w ∈ weilSubgroup F M := by
      change localProjection F (v⁻¹ * w) ∈ M.field.fixingSubgroup
      rw [← hk]
      apply q.mem_ker.mpr
      change q (g (v⁻¹ * w)) = 1
      have he : q (g v) = q σ := hv.2
      change σ * τ = g w at hστ
      have hτ' : q τ = 1 := q.mem_ker.mp (hk.symm ▸ hτ)
      rw [map_mul g, map_inv g, map_mul q, map_inv q, he, ← hστ, map_mul q,
        hτ', mul_one, inv_mul_cancel]
    exact Subgroup.mem_sup_of_normal_right.mpr ⟨v, hv.1, v⁻¹ * w, hvw, by simp⟩
  · exact sup_le (weilSubgroup_antitone F _ _ inf_le_left)
      (weilSubgroup_antitone F _ _ inf_le_right)

private theorem relative_fixing (X Y : Extension F) (h : X.field ≤ Y.field) :
    ((Y.field.fixingSubgroup.subgroupOf X.field.fixingSubgroup).Normal ↔
      IsGalois X.field (IntermediateField.extendScalars h)) ∧
    Y.field.fixingSubgroup.relIndex X.field.fixingSubgroup =
      Module.finrank X.field (IntermediateField.extendScalars h) := by
  let := localCharZero F
  let : CharZero X.field := charZero_of_injective_algebraMap (algebraMap F.Carrier X.field).injective
  let : IsGalois X.field (AlgebraicClosure X.field) := ⟨⟩
  let Z := rebase F X Y h
  let e := intermediateGaloisEquiv F X
  let H := Y.field.fixingSubgroup.subgroupOf X.field.fixingSubgroup
  have hH : H.comap e.toMulEquiv.toMonoidHom = Z.field.fixingSubgroup := by
    ext g
    exact (rebase_galois_mem F X Y h g).symm
  let f : IntermediateField.extendScalars h ≃ₐ[X.field] Z.field :=
    IntermediateField.intermediateFieldMap (intermediateClosureEquiv F X).symm
      (IntermediateField.extendScalars h)
  constructor
  · change H.Normal ↔ _
    rw [← Subgroup.normal_comap_iff_of_surjective (f := e.toMulEquiv.toMonoidHom) e.surjective,
      hH]
    exact (InfiniteGalois.normal_iff_isGalois Z.field).trans f.symm.transfer_galois
  · change H.index = _
    let : FiniteDimensional X.field Z.field :=
      inferInstanceAs (FiniteDimensional (X.asPadicField (p := p)).Carrier Z.field)
    calc
      H.index = Z.field.fixingSubgroup.index :=
        (Subgroup.index_comap_of_surjective H e.surjective).symm.trans (congrArg Subgroup.index hH)
      _ = Module.finrank X.field Z.field := (Z.field.finrank_eq_fixingSubgroup_index).symm
      _ = Module.finrank X.field (IntermediateField.extendScalars h) := f.symm.toLinearEquiv.finrank_eq

/-- Intersecting with a Galois field leaves a prime cyclic step or an equality. -/
theorem intersect_primeStep (M X Y : Extension F) [IsGalois F.Carrier M.field]
    (hs : IsCyclicPrimeStep F X Y) :
    intersect F X M = intersect F Y M ∨
      IsCyclicPrimeStep F (intersect F X M) (intersect F Y M) := by
  let := localCharZero F
  let : IsGalois F.Carrier (AlgebraicClosure F.Carrier) := ⟨⟩
  obtain ⟨h, hGal, _, hp⟩ := hs
  let X' := intersect F X M
  let Y' := intersect F Y M
  let h' : X'.field ≤ Y'.field := inf_le_inf_right M.field h
  let : M.field.fixingSubgroup.Normal := (InfiniteGalois.normal_iff_isGalois M.field).mpr inferInstance
  obtain ⟨hn, hd⟩ := sup_normal_step Y.field.fixingSubgroup X.field.fixingSubgroup
    M.field.fixingSubgroup (IntermediateField.fixingSubgroup_antitone h)
    ((relative_fixing F X Y h).1.mpr hGal)
  rw [← fixingSubgroup_intersect F Y M, ← fixingSubgroup_intersect F X M] at hn hd
  change Y'.field.fixingSubgroup.relIndex X'.field.fixingSubgroup ∣
    Y.field.fixingSubgroup.relIndex X.field.fixingSubgroup at hd
  rw [(relative_fixing F X Y h).2] at hd
  rcases (Nat.dvd_prime hp).mp hd with h1 | hprime
  · left
    apply Subtype.ext
    refine le_antisymm h' ?_
    have hg := Subgroup.relIndex_eq_one.mp h1
    have hf := IntermediateField.fixedField_le hg
    simpa only [InfiniteGalois.fixedField_fixingSubgroup] using hf
  · right
    let : IsGalois X'.field (IntermediateField.extendScalars h') :=
      (relative_fixing F X' Y' h').1.mp hn
    have hp' : (Module.finrank X'.field (IntermediateField.extendScalars h')).Prime :=
      ((relative_fixing F X' Y' h').2.symm.trans hprime) ▸ hp
    let : FiniteDimensional X'.field (IntermediateField.extendScalars h') :=
      Module.finite_of_finrank_pos hp'.pos
    let : Fact (Module.finrank X'.field (IntermediateField.extendScalars h')).Prime := ⟨hp'⟩
    exact ⟨h', inferInstance, isCyclic_of_prime_card (IsGalois.card_aut_eq_finrank _ _), hp'⟩

end Langlands.Global.GeneralPosition
