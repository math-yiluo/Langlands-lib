import Langlands.Global.ArchimedeanCompactGroupFiniteStatement
import Langlands.Global.ArchimedeanCompactTangentProof
import Mathlib.Analysis.Calculus.Deriv.Slope
import Mathlib.Topology.Algebra.Module.FiniteDimension

/-! # Compact group orbit finiteness and genuine differential finiteness -/

noncomputable section
universe u
open scoped Classical Matrix.Norms.Operator TensorProduct
open Filter Topology
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Global.ArchimedeanGL

variable (K : Type u) [Field K] [NumberField K] (n : ℕ)

/-- Scalar right-translation derivative along an actual compact tangent curve. -/
theorem compactCurve_right_deriv
    (X : RealLieAlgebra K n) (c : ℝ → standardInfiniteCompact K n)
    (hc0 : c 0 = 1)
    (hc : HasDerivAt
      (fun t : ℝ => (archimedeanGLCoordinates K n (c t).val : ArchimedeanMatrix K n))
      (realLieAlgebraToMatrix K n X) 0)
    (f : SmoothFunctions K n)
    (g : Matrix.GeneralLinearGroup (Fin n) (NumberField.InfiniteAdeleRing K)) :
    HasDerivAt (fun t : ℝ => f.val (g * (c t).val))
      ((smoothDifferential K n X f).val g) 0 := by
  have hp := hc.const_mul (archimedeanGLCoordinates K n g : ArchimedeanMatrix K n)
  have hzero : (archimedeanGLCoordinates K n (c 0).val : ArchimedeanMatrix K n) = 1 := by
    simp [hc0]
  have hf := ((coordinateExtension_contDiffAt K n f
    (archimedeanGLCoordinates K n g)).differentiableAt (by simp)).hasFDerivAt
  have hd := hf.comp_hasDerivAt_of_eq (0 : ℝ) hp (by simp only [hzero, mul_one])
  have he : (fun t : ℝ => coordinateExtension K n f
      ((archimedeanGLCoordinates K n g : ArchimedeanMatrix K n) *
        (archimedeanGLCoordinates K n (c t).val : ArchimedeanMatrix K n))) =
      (fun t : ℝ => f.val (g * (c t).val)) := by
    funext t
    rw [← Units.val_mul, ← map_mul, coordinateExtension_apply,
      ContinuousMulEquiv.symm_apply_apply]
  rw [Function.comp_def, he] at hd
  exact hd

/-- A finite-dimensional smooth subspace is closed in its inherited pointwise topology.
Pointwise differentiability therefore suffices for preservation along compact curves. -/
theorem compactCurve_differential_mem
    (S : Submodule ℂ (SmoothFunctions K n)) [Module.Finite ℂ S]
    (hS : ∀ k : standardInfiniteCompact K n, ∀ f ∈ S,
      smoothRightAction K n k.val f ∈ S)
    (X : RealLieAlgebra K n) (c : ℝ → standardInfiniteCompact K n)
    (hc0 : c 0 = 1)
    (hc : HasDerivAt
      (fun t : ℝ => (archimedeanGLCoordinates K n (c t).val : ArchimedeanMatrix K n))
      (realLieAlgebraToMatrix K n X) 0)
    (f : SmoothFunctions K n) (hf : f ∈ S) :
    smoothDifferential K n X f ∈ S := by
  let q : ℝ → SmoothFunctions K n := fun t =>
    ((t⁻¹ : ℝ) : ℂ) • (smoothRightAction K n (c t).val f - f)
  have hq : ∀ t, q t ∈ S := fun t =>
    S.smul_mem _ (S.sub_mem (hS (c t) f hf) hf)
  have hlim : Tendsto q (𝓝[≠] (0 : ℝ)) (𝓝 (smoothDifferential K n X f)) := by
    apply tendsto_subtype_rng.mpr
    apply tendsto_pi_nhds.mpr
    intro g
    have hd := (compactCurve_right_deriv K n X c hc0 hc f g).tendsto_slope_zero
    simpa [q, hc0, Complex.real_smul] using hd
  exact S.closed_of_finiteDimensional.mem_of_tendsto hlim (Eventually.of_forall hq)

/-- Preservation by real compact directions extends through scalar extension. -/
theorem compactGenerator_preserves
    (S : Submodule ℂ (SmoothFunctions K n))
    (hS : ∀ X : compactLieSubalgebra K n, ∀ f ∈ S,
      smoothDifferential K n (X : RealLieAlgebra K n) f ∈ S)
    (Y : CompactComplexLieAlgebra K n) :
    ∀ f ∈ S, envelopingAction K n (compactEnvelopingGenerator K n Y) f ∈ S := by
  induction Y using TensorProduct.inductionOn with
  | tmul z X =>
    intro f hf
    simpa only [compactEnvelopingGenerator_tmul, envelopingAction_generator,
      complexSmoothLieAction_tmul, LinearMap.smul_apply] using S.smul_mem z (hS X f hf)
  | add Y Z hY hZ =>
    intro f hf
    simpa only [map_add, LinearMap.add_apply] using S.add_mem (hY f hf) (hZ f hf)

/-- The unital algebra generated by compact directions preserves the same subspace. -/
theorem compactEnveloping_preserves
    (S : Submodule ℂ (SmoothFunctions K n))
    (hS : ∀ X : compactLieSubalgebra K n, ∀ f ∈ S,
      smoothDifferential K n (X : RealLieAlgebra K n) f ∈ S)
    (a : EnvelopingAlgebra K n) (ha : a ∈ compactEnvelopingSubalgebra K n) :
    ∀ f ∈ S, envelopingAction K n a f ∈ S := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha =>
    obtain ⟨Y, rfl⟩ := ha
    exact compactGenerator_preserves K n S hS Y
  | algebraMap z =>
    intro f hf
    rw [(envelopingAction K n).commutes]
    exact S.smul_mem z hf
  | add a b ha hb iha ihb =>
    intro f hf
    simpa only [map_add, LinearMap.add_apply] using S.add_mem (iha f hf) (ihb f hf)
  | mul a b ha hb iha ihb =>
    intro f hf
    rw [envelopingAction_mul]
    exact iha _ (ihb f hf)

/-- Conditional reduction: actual compact tangent curves imply the exact full target. -/
theorem compactGroupFiniteDifferential_of_curves
    (hcurve : CompactTangentCurveStatement K n) :
    CompactGroupFiniteDifferentialStatement K n := by
  intro f hf
  let ρ := (smoothRightAction K n).comp (standardInfiniteCompact K n).subtype
  let S := Langlands.FiniteVectors.orbitSpan ρ f
  have : Module.Finite ℂ S := hf
  have hS : ∀ k : standardInfiniteCompact K n, ∀ g ∈ S,
      smoothRightAction K n k.val g ∈ S := by
    intro k g hg
    exact (Langlands.FiniteVectors.orbitSubrepresentation ρ f).apply_mem_toSubmodule k hg
  have hreal : ∀ X : compactLieSubalgebra K n, ∀ g ∈ S,
      smoothDifferential K n (X : RealLieAlgebra K n) g ∈ S := by
    intro X g hg
    obtain ⟨c, hc0, hc⟩ := hcurve X
    exact compactCurve_differential_mem K n S hS X c hc0 hc g hg
  have hle : compactOrbitSpan K n f ≤ S := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact compactEnveloping_preserves K n S hreal a.val a.property f
      (Langlands.FiniteVectors.self_mem_orbitSpan ρ f)
  exact Submodule.finiteDimensional_of_le hle

/-- Finite compact-group orbit implies finite orbit under the genuine compact
enveloping action, for every number field and every natural rank. -/
theorem compactGroupFiniteDifferential :
    CompactGroupFiniteDifferentialStatement K n :=
  compactGroupFiniteDifferential_of_curves K n (compactTangentCurve K n)

example : (K : Type u) → [Field K] → [NumberField K] → (n : ℕ) →
    CompactGroupFiniteDifferentialStatement K n :=
  @compactGroupFiniteDifferential

end Langlands.Global.ArchimedeanGL
