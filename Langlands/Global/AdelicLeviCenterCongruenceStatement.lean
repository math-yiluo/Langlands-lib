import Langlands.Global.AdelicLeviCenterTransferStatement
import Langlands.Global.InfiniteAdelicLeviEnveloping

/-! # The normalized Harish-Chandra congruence of the center, common to two parabolics

For a parabolic `Q = M'V` of a connected reductive group `G` over a number field, every element
`z` of the center of the complex enveloping algebra of `G(F_∞)` is congruent, modulo the right
ideal generated by the tangent directions of `V(F_∞)`, to the image of an element of the
enveloping algebra of `M'(F_∞)`. After the `ρ`-shift this element does not depend on the
parabolic. This file states that one element `y` of the enveloping algebra of `M'(F_∞)` gives both
congruences, for `Q` and, transported along a Weyl conjugation, for a second parabolic `P = MU`. -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry NumberField
open scoped CategoryTheory.MonObj Manifold ContDiff TensorProduct

set_option autoImplicit false

namespace Langlands.Global

open Langlands.GroupScheme Langlands.Automorphic.GroupSchemeFunctions AdelicGroupPoints
  InfiniteAdelicGroupPoints

/-- The normalized Harish-Chandra congruence of the center, common to two Weyl-conjugate
parabolics (Knapp–Vogan, Lemma 4.123 and Proposition 4.129 (c); Mœglin–Waldspurger I.2.17).
Let `G` be connected reductive over a number field `F`, `p : P → G` and `q : Q → G` parabolics
with geometric unipotent radicals `iU`, `iV` and rational Levi subgroups `l : M → P`,
`l' : M' → Q`, and let `(w, c)` be a Weyl conjugation. Fix smooth structures on `G` and `M'`.
Write `j_Q`, `j_P` for the algebra maps from the complex enveloping algebra of `M'(F_∞)` to that
of `G(F_∞)` induced by the tangent maps of `ι_Q = l' ≫ q` and `ι_P = c ≫ l ≫ p`, and `τ_Q`,
`τ_P` for the automorphisms `Y ↦ Y + dδ(Y)` of the first algebra, where `δ` is
`m ↦ δ_Q(m)^{-1/2}`, resp. `m ↦ δ_P(c(m))^{-1/2}`. For every central `z` there is `y` with
`z - j_Q(τ_Q y)` in the right ideal generated by the tangent directions of `V(F_∞)` and
`z - j_P(τ_P y)` in the right ideal generated by those of `U(F_∞)`. The statement holds for
every proof that `dδ` vanishes on brackets. -/
def LeviRestrictionCenterCongruenceStatement : Prop :=
  ∀ (F : Type u) [Field F] [NumberField F]
    (G P M U Q M' V : GroupScheme (Spec (CommRingCat.of F)))
    [IsAffine G.X.left] [IsAffine P.X.left] [LocallyOfFiniteType P.X.hom]
    [IsAffine Q.X.left] [LocallyOfFiniteType Q.X.hom] [IsAffine M'.X.left]
    (p : P ⟶ G) (iU : U ⟶ P) (l : M ⟶ P) (q : Q ⟶ G) (iV : V ⟶ Q) (l' : M' ⟶ Q)
    (w : Over.mk (𝟙 (Spec (CommRingCat.of F))) ⟶ G.X) (c : M' ⟶ M),
    IsConnectedReductive G → IsParabolicSubgroup p → LeviSubgroup.IsGeometricUnipotentRadical iU →
    IsRationalLeviSubgroup l → IsParabolicSubgroup q →
    LeviSubgroup.IsGeometricUnipotentRadical iV → IsRationalLeviSubgroup l' →
    IsWeylConjugation p l q l' w c →
    ∀ {d d' : ℕ} (hsmooth : SmoothOfRelativeDimension d G.X.hom)
      (hsmooth' : SmoothOfRelativeDimension d' M'.X.hom)
      (z : AdelicEnvelopingCenter F G hsmooth),
      let Ainf := CommAlgCat.of F (InfiniteAdeleRing F)
      let δQ : InfiniteAdelicGroupPoints F M' → ℂ := fun m =>
        parameterPower F Q (-halfModulusParameter F Q) (map F M' Q l' (ofInfinite F M' m))
      let δP : InfiniteAdelicGroupPoints F M' → ℂ := fun m =>
        parameterPower F P (-halfModulusParameter F P) (map F M' P (c ≫ l) (ofInfinite F M' m))
      let SV : Set (InfiniteAdelicGroupPoints F G) :=
        Set.range (V.affinePointsTarget (iV ≫ q) Ainf)
      let SU : Set (InfiniteAdelicGroupPoints F G) :=
        Set.range (U.affinePointsTarget (iU ≫ p) Ainf)
      letI := fun v : NumberField.InfinitePlace F => InfinitePlaceGroupPoints.completionRCLike F v
      letI := smoothChartedSpace F M' hsmooth'
      letI := smoothLieGroup F M' hsmooth'
      letI : LieGroup 𝓘(ℝ, smoothModel F d') (minSmoothness ℝ 3)
        (InfiniteAdelicGroupPoints F M') := LieGroup.of_le (n := ∞) (by simp)
      ∀ (hQ : ∀ X Y : GroupLieAlgebra 𝓘(ℝ, smoothModel F d') (InfiniteAdelicGroupPoints F M'),
          identityDerivative F hsmooth' δQ ⁅X, Y⁆ = 0)
        (hP : ∀ X Y : GroupLieAlgebra 𝓘(ℝ, smoothModel F d') (InfiniteAdelicGroupPoints F M'),
          identityDerivative F hsmooth' δP ⁅X, Y⁆ = 0),
      ∃ y : AdelicEnvelopingAlgebra F M' hsmooth',
        (z : AdelicEnvelopingAlgebra F G hsmooth) -
            pointEnvelopingMap F hsmooth' hsmooth (l' ≫ q)
              (envelopingCharacterShift F hsmooth' δQ hQ y) ∈
          curveRightIdeal F hsmooth SV ∧
        (z : AdelicEnvelopingAlgebra F G hsmooth) -
            pointEnvelopingMap F hsmooth' hsmooth (c ≫ l ≫ p)
              (envelopingCharacterShift F hsmooth' δP hP y) ∈
          curveRightIdeal F hsmooth SU

end Langlands.Global
