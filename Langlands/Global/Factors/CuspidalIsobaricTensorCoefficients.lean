import Langlands.Automorphic.AlgebraOperatorSubquotient
import Langlands.Global.EisensteinJetSubquotient
import Langlands.Global.Factors.CuspidalIsobaricTensorSimplicity

/-! # Finite detection of a prescribed simple constituent by Eisenstein coefficients -/

noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u uI

namespace Langlands.Global.EisensteinJet

open Langlands.Automorphic

variable (F : Type u) [Field F] [NumberField F] (r : ℕ)

local notation "Operators" => FreeOperatorAlgebra F (r + 1)
local notation "Stable" => StableAutomorphicFunctions F (r + 1)

local instance coefficientRationalAddCommGroup : AddCommGroup (RationalInvariantFunctions F (r + 1)) :=
  Submodule.addCommGroup _
local instance coefficientContinuousAddCommGroup : AddCommGroup (ContinuousRationalFunctions F (r + 1)) :=
  Submodule.addCommGroup _
local instance coefficientSmoothAddCommGroup : AddCommGroup (FiniteSmoothRationalFunctions F (r + 1)) :=
  Submodule.addCommGroup _
local instance coefficientFormsAddCommGroup : AddCommGroup (AutomorphicForms F (r + 1)) :=
  Submodule.addCommGroup _
local instance coefficientStableAddCommGroup : AddCommGroup Stable := Submodule.addCommGroup _

private theorem scalarTower_of_action {R V : Type*} [Ring R] [Algebra ℂ R]
    [AddCommGroup V] [Module ℂ V] (a : R →ₐ[ℂ] Module.End ℂ V) :
    letI := moduleOfAlgebraAction a
    IsScalarTower ℂ R V := by
  let := moduleOfAlgebraAction a
  refine ⟨fun c b x => ?_⟩
  change a (c • b) x = c • a b x
  rw [map_smul, LinearMap.smul_apply]

/-- Finitely many coefficient maps detect the prescribed specialization on a
submodule of the free operator module generated by the inducing seeds. -/
def HasCoefficientDetection {V : Type*} [AddCommGroup V] [Module ℂ V]
    (a : Operators →ₐ[ℂ] Module.End ℂ V) (I : Type uI) : Prop :=
  letI := moduleOfAlgebraAction (stableFreeOperatorAction F (r + 1))
  letI := moduleOfAlgebraAction a
  ∃ (s : Finset ℕ) (c : ℕ → (I →₀ Operators) →ₗ[Operators] Stable)
    (S : Submodule Operators (I →₀ Operators)) (q : S →ₗ[Operators] V),
    Function.Surjective q ∧
    ∀ x : S, (∀ j ∈ s, c j x.val = 0) → q x = 0

set_option maxHeartbeats 1800000 in
/-- Restrict a quotient of an actual automorphic operator module to obtain
an intertwiner for the full free representation. -/
theorem exists_freeIntertwiner_of_operatorModuleSurjection
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (a : Operators →ₐ[ℂ] Module.End ℂ V) :
    letI := moduleOfAlgebraAction (stableFreeOperatorAction F (r + 1))
    letI := moduleOfAlgebraAction a
    ∀ (S : Submodule Operators Stable) (p : S →ₗ[Operators] V), Function.Surjective p →
      ∃ (U : Subrepresentation
        ((stableAutomorphicAction F (r + 1)).comp (freeOperatorProjection F (r + 1)).toMonoidHom))
        (q : U.toRepresentation.IntertwiningMap a.toMonoidHom), Function.Surjective q := by
  let := moduleOfAlgebraAction (stableFreeOperatorAction F (r + 1))
  let := moduleOfAlgebraAction a
  let := scalarTower_of_action (stableFreeOperatorAction F (r + 1))
  let := scalarTower_of_action a
  intro S p hp
  let π := freeOperatorProjection F (r + 1)
  let U : Subrepresentation ((stableAutomorphicAction F (r + 1)).comp π.toMonoidHom) :=
    { toSubmodule := S.restrictScalars ℂ
      apply_mem_toSubmodule b x hx := by
        change stableAutomorphicAction F (r + 1) (π b) x ∈ S
        rw [← stableFreeOperatorAction_apply]
        exact S.smul_mem b hx }
  let f : U.toRepresentation.IntertwiningMap a.toMonoidHom :=
    { toLinearMap := p.restrictScalars ℂ
      isIntertwining' b := by
        apply LinearMap.ext
        intro x
        have hval : (U.toRepresentation b x : Stable) = b • (x : Stable) :=
          (stableFreeOperatorAction_apply F (r + 1) b x.val).symm
        have hx : U.toRepresentation b x = (b • (x : S) : S) := Subtype.ext hval
        change p (U.toRepresentation b x) = a b (p x)
        rw [hx]
        exact p.map_smul b (x : S) }
  exact ⟨U, f, hp⟩

set_option maxHeartbeats 1600000 in
/-- A simple specialization detected by finitely many actual stable form
coefficients is a quotient for the whole free action on a stable subspace. -/
theorem exists_freeIntertwiner_of_coefficientDetection
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (a : Operators →ₐ[ℂ] Module.End ℂ V) {I : Type uI}
    (ha : Representation.IsIrreducible a.toMonoidHom)
    (h : HasCoefficientDetection F r a I) :
    ∃ (S : Subrepresentation
      ((stableAutomorphicAction F (r + 1)).comp (freeOperatorProjection F (r + 1)).toMonoidHom))
      (q : S.toRepresentation.IntertwiningMap a.toMonoidHom), Function.Surjective q := by
  let := moduleOfAlgebraAction (stableFreeOperatorAction F (r + 1))
  let := moduleOfAlgebraAction a
  let : IsSimpleModule Operators V := (isSimpleModule_iff_irreducible_algebraAction a).mpr ha
  obtain ⟨s, c, D, q, hq, hdetect⟩ := h
  let coeff (j : ℕ) := (c j).comp D.subtype
  have hqTop : Function.Surjective (q.comp (⊤ : Submodule Operators D).subtype) := by
    intro y
    obtain ⟨x, rfl⟩ := hq y
    exact ⟨⟨x, Submodule.mem_top⟩, rfl⟩
  obtain ⟨S, p, hp⟩ := exists_subquotient_of_coefficients s coeff q ⊤ hqTop
    (fun x _ hx => hdetect x hx)
  exact exists_freeIntertwiner_of_operatorModuleSurjection F r a S p hp

end Langlands.Global.EisensteinJet

namespace Langlands.Global.CuspidalInducedFiniteTensor

open Langlands.Automorphic
open CompletionPadic (padicField)
open Correspondence (AutomorphicObject)
open FiniteAdelicGL EisensteinJet

variable {F : Type u} [Field F] [NumberField F] [CompactSpace (AdeleQuotient F)]
  {r k : ℕ} {m : Fin k → ℕ} {T : ∀ i, CuspidalOperatorRealization F (m i)}

local instance coefficientMatrixTopology (v : FinitePlace F) (n : ℕ) :
    TopologicalSpace (GeneralLinear n (padicField v).Carrier) :=
  (padicField v).canonicalGeneralLinearTopology n

variable {U : FinitePlace F → Type u} [∀ v, AddCommGroup (U v)] [∀ v, Module ℂ (U v)]
variable {ρ : ∀ v, Representation ℂ (FiniteLocalGL F (r + 1) v) (U v)}
variable {E : Finset (FinitePlace F)}
variable (A : ∀ v : FinitePlace F, AutomorphicObject.{u, u} (padicField v) r.succPNat)
variable (D : TensorSubquotient F (r + 1) ρ (fun v => (A v).obj.representation) E)

set_option maxHeartbeats 2200000 in
/-- Finite coefficient detection gives the prescribed realization of the
exact constituent tensor. -/
theorem hasTensorRealization_of_coefficientDetection
    (real : ∀ v : {v : NumberField.InfinitePlace F // NumberField.InfinitePlace.IsReal v},
      RealIsobaricPlaceData (r := r) T v)
    (complex : ∀ v : {v : NumberField.InfinitePlace F // NumberField.InfinitePlace.IsComplex v},
      ComplexIsobaricPlaceData (r := r) T v)
    {I : Type uI}
    (h : HasCoefficientDetection F r (targetTensorAction A D real complex) I) :
    HasTensorRealization A D
      (fun v => (real v).orderedBlocks) (fun v => (complex v).orderedBlocks)
      (fun v => (real v).kernel) (fun v => (complex v).kernel)
      (fun v => (real v).stable) (fun v => (complex v).stable) := by
  apply hasTensorRealization_of_targetSurjection
  exact exists_freeIntertwiner_of_coefficientDetection F r (targetTensorAction A D real complex)
    (targetTensorAction_isIrreducible A D real complex) h

end Langlands.Global.CuspidalInducedFiniteTensor
