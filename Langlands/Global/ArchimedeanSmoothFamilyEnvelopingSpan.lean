import Langlands.Global.ArchimedeanSmoothFamily
import Langlands.Global.ArchimedeanCompactHomGeneration
import Langlands.Global.ArchimedeanAdjointCoefficientsProof

/-! # Enveloping spans of smooth families and their compact intertwiners -/

noncomputable section
universe u w
open scoped Classical
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Langlands.Global.ArchimedeanGL.SmoothFamily

variable {F : Type u} [Field F] [NumberField F] {n : ℕ} {ι : Type w}
variable {m : ℕ} {σ : Representation ℂ (standardInfiniteCompact F n) (Fin m → ℂ)}

local notation "V" => SmoothFamily F n ι
local notation "U" => EnvelopingAlgebra F n
local notation "K" => standardInfiniteCompact F n
local notation "ρ" => compactRepresentation (F := F) (n := n) (ι := ι)

/-- The module generated by the whole image of a finite compact intertwiner under the
genuine enveloping algebra. -/
def envelopingSpan (j : σ.IntertwiningMap ρ) : Submodule U V where
  carrier := ((⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap : Submodule ℂ V)
  zero_mem' := Submodule.zero_mem _
  add_mem' := Submodule.add_mem _
  smul_mem' a f hf := by
    change a • f ∈ (⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap
    refine Submodule.smul_induction_on hf ?_ ?_
    · intro b _ v hv
      rw [smul_smul]
      exact Submodule.smul_mem_smul Submodule.mem_top hv
    · intro v w hv hw
      rw [smul_add]
      exact Submodule.add_mem _ hv hw

@[simp]
theorem restrictScalars_envelopingSpan (j : σ.IntertwiningMap ρ) :
    (envelopingSpan j).restrictScalars ℂ =
      (⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap := rfl

theorem mem_envelopingSpan (j : σ.IntertwiningMap ρ) (v : Fin m → ℂ) :
    j v ∈ envelopingSpan j := by
  change j.toLinearMap v ∈ (⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap
  simpa only [one_smul] using
    Submodule.smul_mem_smul (show (1 : U) ∈ (⊤ : Submodule ℂ U) from Submodule.mem_top)
      (LinearMap.mem_range_self j.toLinearMap v)

theorem compactRepresentation_mem_envelopingSpan (j : σ.IntertwiningMap ρ)
    (k : K) {f : V} (hf : f ∈ envelopingSpan j) :
    ρ k f ∈ envelopingSpan j := by
  change f ∈ (⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap at hf
  refine Submodule.smul_induction_on hf ?_ ?_
  · rintro a _ _ ⟨v, rfl⟩
    change ρ k (a • j v) ∈ envelopingSpan j
    rw [compactRepresentation_enveloping_smul, ← Representation.IntertwiningMap.isIntertwining]
    exact (envelopingSpan j).smul_mem _ (mem_envelopingSpan j (σ k v))
  · intro v w hv hw
    rw [map_add]
    exact (envelopingSpan j).add_mem hv hw

/-- Restrict the actual compact representation to the module generated by the source. -/
def envelopingSpanSubrepresentation (j : σ.IntertwiningMap ρ) : Subrepresentation ρ where
  toSubmodule := (envelopingSpan j).restrictScalars ℂ
  apply_mem_toSubmodule k {_} hf := compactRepresentation_mem_envelopingSpan j k hf

private theorem isFiniteVector_smul_generator (j : σ.IntertwiningMap ρ)
    (a : U) (v : Fin m → ℂ) : Langlands.FiniteVectors.IsFiniteVector ρ (a • j v) := by
  obtain ⟨d, b, c, hc⟩ := envelopingConjugationCoefficients F n a
  let T : Submodule ℂ V := ⨆ l : Fin d, LinearMap.range
    ((Algebra.lsmul ℂ ℂ V (b l)).comp j.toLinearMap)
  have hfinite (l : Fin d) : Module.Finite ℂ (LinearMap.range
      ((Algebra.lsmul ℂ ℂ V (b l)).comp j.toLinearMap)) := Module.Finite.range _
  have : Module.Finite ℂ T := Submodule.finite_iSup _
  apply Submodule.finiteDimensional_of_le (S₂ := T)
  apply Submodule.span_le.mpr
  rintro _ ⟨k, rfl⟩
  change ρ k (a • j v) ∈ T
  rw [compactRepresentation_enveloping_smul, ← Representation.IntertwiningMap.isIntertwining,
    hc k.val, Finset.sum_smul]
  apply Submodule.sum_mem
  intro l _
  rw [smul_assoc]
  apply T.smul_mem
  exact Submodule.mem_iSup_of_mem l
    (LinearMap.mem_range_self ((Algebra.lsmul ℂ ℂ V (b l)).comp j.toLinearMap) (σ k v))

/-- Every value in the generated module has finite compact orbit span, even for an
arbitrary index set of smooth functions. -/
theorem isFiniteVector_of_mem_envelopingSpan (j : σ.IntertwiningMap ρ)
    {f : V} (hf : f ∈ envelopingSpan j) : Langlands.FiniteVectors.IsFiniteVector ρ f := by
  change f ∈ (⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap at hf
  change f ∈ (Langlands.FiniteVectors.subrepresentation ρ).toSubmodule
  refine Submodule.smul_induction_on hf ?_ ?_
  · rintro a _ _ ⟨v, rfl⟩
    exact isFiniteVector_smul_generator j a v
  · intro v w hv hw
    exact Submodule.add_mem _ hv hw

private theorem center_smul_eq_zero_of_mem (j : σ.IntertwiningMap ρ) (z : EnvelopingCenter F n)
    (hz : ∀ v, (z : U) • j v = 0) {f : V} (hf : f ∈ envelopingSpan j) :
    (z : U) • f = 0 := by
  change f ∈ (⊤ : Submodule ℂ U) • LinearMap.range j.toLinearMap at hf
  refine Submodule.smul_induction_on hf ?_ ?_
  · rintro a _ _ ⟨v, rfl⟩
    change (z : U) • (a • j v) = 0
    rw [smul_smul, ← centerInclusion_apply, ← centerInclusion_commute,
      ← smul_smul, centerInclusion_apply, hz, smul_zero]
  · intro v w hv hw
    rw [smul_add, hv, hw, add_zero]

omit [NumberField F] in
private theorem finite_center_span
    {W : Type*} [AddCommGroup W] [Module ℂ W] [Module U W] [IsScalarTower ℂ U W]
    (J : Ideal (EnvelopingCenter F n))
    [Module.Finite ℂ (EnvelopingCenter F n ⧸ J.restrictScalars ℂ)]
    (x : W) (hx : ∀ z ∈ J, (z : U) • x = 0) :
    Module.Finite ℂ (Submodule.span ℂ (Set.range fun z : EnvelopingCenter F n =>
      (z : U) • x)) := by
  let L : EnvelopingCenter F n →ₗ[ℂ] W :=
    (LinearMap.applyₗ (R := ℂ) x).comp
      ((Algebra.lsmul ℂ ℂ W).toLinearMap.comp (centerInclusion F n).toLinearMap)
  let q := (J.restrictScalars ℂ).liftQ L (by intro z hz; exact hx z hz)
  have : Module.Finite ℂ q.range := Module.Finite.range _
  apply Submodule.finiteDimensional_of_le (S₂ := q.range)
  apply Submodule.span_le.mpr
  rintro _ ⟨z, rfl⟩
  exact ⟨Submodule.Quotient.mk z, rfl⟩

/-- For a fixed cofinite annihilator of the generating image, there is one
finite-dimensional subspace containing the values of all compact intertwiners
from the prescribed source into the generated module. -/
theorem exists_finite_cover_of_intertwiner_values (τ η : ContinuousCompactRep F n)
    (j : η.toRepresentation.IntertwiningMap ρ) (J : Ideal (EnvelopingCenter F n))
    [Module.Finite ℂ (EnvelopingCenter F n ⧸ J.restrictScalars ℂ)]
    (hJ : ∀ z ∈ J, ∀ v, (z : U) • j v = 0) :
    ∃ E : Submodule ℂ V, Module.Finite ℂ E ∧
      ∀ T : τ.toRepresentation.IntertwiningMap ρ,
        (∀ v, T v ∈ envelopingSpan j) → ∀ v, T v ∈ E := by
  let M := envelopingSpanSubrepresentation j
  let W := M.toSubmodule
  let : Module U W := (inferInstance : Module U (envelopingSpan j))
  let : IsScalarTower ℂ U W := (inferInstance : IsScalarTower ℂ U (envelopingSpan j))
  let j₀ : (Fin η.dim → ℂ) →ₗ[ℂ] W :=
    j.toLinearMap.codRestrict W (mem_envelopingSpan j)
  have hj (k : K) (v : Fin η.dim → ℂ) :
      j₀ (η.toRepresentation k v) = M.toRepresentation k (j₀ v) := by
    apply Subtype.ext
    exact Representation.IntertwiningMap.isIntertwining _ _ j k v
  have hcov (k : K) (a : U) (v : W) :
      M.toRepresentation k (a • v : W) =
        (envelopingConjugation F n k.val a • M.toRepresentation k v : W) := by
    apply Subtype.ext
    exact compactRepresentation_enveloping_smul k a v.val
  have hstable (X : CompactComplexLieAlgebra F n) (v : W) (hv : v ∈ j₀.range) :
      compactEnvelopingGenerator F n X • v ∈ j₀.range := by
    obtain ⟨y, rfl⟩ := hv
    have : Module.Finite ℂ j.range.toSubmodule := Module.Finite.range j.toLinearMap
    obtain ⟨x, hx⟩ := compactGenerator_mem j.range X (j y)
      (LinearMap.mem_range_self j.toLinearMap y)
    exact ⟨x, Subtype.ext hx⟩
  let D : Submodule ℂ W := (⊤ : Submodule ℂ U) • j₀.range
  have hg (v : W) : v ∈ D := by
    have hv : v.val ∈ (⊤ : Submodule ℂ U) • j.toLinearMap.range := v.property
    have hle : (⊤ : Submodule ℂ U) • j.toLinearMap.range ≤ D.map W.subtype := by
      apply Submodule.smul_le.mpr
      rintro a _ _ ⟨y, rfl⟩
      exact ⟨a • j₀ y, Submodule.smul_mem_smul Submodule.mem_top
        (LinearMap.mem_range_self j₀ y), rfl⟩
    obtain ⟨w, hw, he⟩ := hle hv
    exact (Subtype.ext he : w = v) ▸ hw
  obtain ⟨d, A, hA⟩ := exists_finite_central_cover_of_intertwiner_values F n τ η
    j₀ M.toRepresentation hj hcov hstable
  let P := compactHomCentralEvaluationSpan F n τ A
  have hP (p : Fin d × Fin τ.dim) : Module.Finite ℂ
      (Submodule.span ℂ (Set.range fun z : EnvelopingCenter F n =>
        (z : U) • A p.1 (Pi.single p.2 1))) := by
    apply finite_center_span J
    intro z hz
    apply Subtype.ext
    exact center_smul_eq_zero_of_mem j z (hJ z hz) (A p.1 (Pi.single p.2 1)).property
  have : Module.Finite ℂ P := Submodule.finite_iSup _
  refine ⟨P.map W.subtype, Module.Finite.map _ _, ?_⟩
  intro T hT v
  let t : τ.toRepresentation.IntertwiningMap M.toRepresentation :=
    (T.toLinearMap.codRestrict W hT).intertwiningMap_of_isIntertwiningMap _ _
      (fun k a => Subtype.ext (Representation.IntertwiningMap.isIntertwining _ _ T k a))
  exact Submodule.mem_map_of_mem (hA t (fun a => hg (t a)) v)

end Langlands.Global.ArchimedeanGL.SmoothFamily
