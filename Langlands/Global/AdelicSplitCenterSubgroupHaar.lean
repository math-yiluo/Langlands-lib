import Langlands.Global.AdelicSplitCenterHaar
import Langlands.Global.AdelicSplitCenterMeasure

/-! # Exact Haar measure on the actual positive-times-principal subgroup -/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry MeasureTheory MeasureTheory.Measure
open scoped CategoryTheory.MonObj Topology

namespace Langlands.Global.PositiveRealTorus

open Langlands.GroupScheme AdelicGroupPoints

variable (F : Type u) [Field F] [NumberField F]
variable (G : GroupScheme (Spec (CommRingCat.of F)))
variable (T : CommGroupScheme (Spec (CommRingCat.of F)))
variable (i : T.toGrp ⟶ G)
variable (hi : Function.Injective (characterRestrict i))
variable [(characterRestrict i).range.FiniteIndex]
variable (I : Type u) [Fintype I]
variable (e : T.toGrp ≅ splitTorus (Spec (CommRingCat.of F)) I)
variable [IsAffine G.X.left]

/-- Actual multiplication identifies positive points times the principal norm-one subgroup
with the subgroup generated by positive and principal points. -/
def positiveRationalDecomposition (hc : IsCentral i) :
    intrinsicSubgroup F T × rationalNormOneSubgroup F G ≃ₜ*
      positiveRationalSubgroup F G T i := by
  classical
  exact {
    toFun p := ⟨positivePointMap F G T i p.1 * p.2.val.val,
      (positiveRationalSubgroup F G T i).mul_mem
        (imageSubgroup_le_positiveRationalSubgroup F G T i ⟨p.1.val, p.1.property, rfl⟩)
        (rationalSubgroup_le_positiveRationalSubgroup F G T i
          (rationalNormOneSubgroupInclusion F G p.2).property)⟩
    invFun x := (positiveFactor F G T i hi I e x.val,
      ⟨normOneFactor F G T i hi I e x.val, by
        exact (congrArg (fun S : Subgroup (AdelicGroupPoints F G) => x.val ∈ S)
          (positiveRationalSubgroup_eq_comap F G T i hi I e hc)).mp x.property⟩)
    left_inv p := by
      apply Prod.ext
      · exact positiveFactor_mul_normOne F G T i hi I e p.1 p.2.val
      · apply Subtype.ext
        exact congrArg Prod.snd ((normOneDecomposition F G T i hi I e).left_inv
          (p.1, p.2.val))
    right_inv x := Subtype.ext (positivePointMap_mul_normOneFactor F G T i hi I e x.val)
    map_mul' p q := Subtype.ext
      ((normOneDecompositionMulEquiv F G T i hi I e hc).map_mul
        (p.1, p.2.val) (q.1, q.2.val))
    continuous_toFun := (((positivePointMap F G T i).continuous.comp continuous_fst).mul
      (continuous_subtype_val.comp (continuous_subtype_val.comp continuous_snd))).subtype_mk _
    continuous_invFun := ((positiveFactor F G T i hi I e).continuous.comp
      continuous_subtype_val).prodMk
        (((continuous_normOneFactor F G T i hi I e).comp
          continuous_subtype_val).subtype_mk (fun x =>
            (congrArg (fun S : Subgroup (AdelicGroupPoints F G) => x.val ∈ S)
              (positiveRationalSubgroup_eq_comap F G T i hi I e hc)).mp x.property)) }

@[simp] theorem positiveRationalDecomposition_apply (hc : IsCentral i)
    (p : intrinsicSubgroup F T × rationalNormOneSubgroup F G) :
    (positiveRationalDecomposition F G T i hi I e hc p : AdelicGroupPoints F G) =
      positivePointMap F G T i p.1 * p.2.val.val := rfl

@[simp] theorem positiveRationalDecomposition_symm_fst (hc : IsCentral i)
    (x : positiveRationalSubgroup F G T i) :
    ((positiveRationalDecomposition F G T i hi I e hc).symm x).1 =
      positiveFactor F G T i hi I e x.val := rfl

@[simp] theorem positiveRationalDecomposition_symm_snd (hc : IsCentral i)
    (x : positiveRationalSubgroup F G T i) :
    (((positiveRationalDecomposition F G T i hi I e hc).symm x).2 : normOneSubgroup F G) =
      normOneFactor F G T i hi I e x.val := rfl

variable [LocallyOfFiniteType G.X.hom]

/-- Counting measure is Haar on the actual discrete principal norm-one subgroup. -/
theorem rationalNormOneSubgroup_count_isHaarMeasure :
    (Measure.count : Measure (rationalNormOneSubgroup F G)).IsHaarMeasure := by
  exact { toIsFiniteMeasureOnCompacts :=
            LeftCosetSpace.isFiniteMeasureOnCompacts_count (rationalNormOneSubgroup F G)
              (isDiscrete_rationalNormOneSubgroup F G)
          toIsMulLeftInvariant := inferInstance
          toIsOpenPosMeasure := inferInstance }

/-- The full subgroup carries positive Haar times principal counting, transported through
actual multiplication, with the ambient/norm-one normalization already fixed. -/
def positiveRationalSubgroupHaarMeasure (hc : IsCentral i) :
    Measure (positiveRationalSubgroup F G T i) :=
  Measure.map (positiveRationalDecomposition F G T i hi I e hc)
    ((normalizedPositiveHaarMeasure F G T i hi I e hc).prod
      (Measure.count : Measure (rationalNormOneSubgroup F G)))

theorem positiveRationalSubgroupHaarMeasure_isHaarMeasure (hc : IsCentral i) :
    (positiveRationalSubgroupHaarMeasure F G T i hi I e hc).IsHaarMeasure := by
  let := positiveIsTopologicalGroup F T I e
  let := normalizedPositiveHaarMeasure_isHaarMeasure F G T i hi I e hc
  let := normalizedPositiveHaarMeasure_sigmaFinite F G T i hi I e hc
  let := rationalNormOneSubgroup_count_isHaarMeasure F G
  exact (positiveRationalDecomposition F G T i hi I e hc).isHaarMeasure_map _

theorem positiveRationalSubgroupHaarMeasure_sigmaFinite (hc : IsCentral i) :
    SigmaFinite (positiveRationalSubgroupHaarMeasure F G T i hi I e hc) := by
  let := normalizedPositiveHaarMeasure_sigmaFinite F G T i hi I e hc
  exact (positiveRationalDecomposition F G T i hi I e hc).toHomeomorph.toMeasurableEquiv.sigmaFinite_map

theorem positiveRationalSubgroupHaarMeasure_regular (hc : IsCentral i) :
    (positiveRationalSubgroupHaarMeasure F G T i hi I e hc).Regular := by
  let : LocallyCompactSpace (positiveRationalSubgroup F G T i) :=
    (isClosed_positiveRationalSubgroup F G T i hi I e hc).locallyCompactSpace
  let := positiveRationalSubgroupHaarMeasure_isHaarMeasure F G T i hi I e hc
  let : PolishSpace (positiveRationalSubgroup F G T i) :=
    (isClosed_positiveRationalSubgroup F G T i hi I e hc).polishSpace
  infer_instance

/-- This actual subgroup is unimodular by its positive-times-discrete decomposition;
no ambient or norm-one unimodularity hypothesis is used. -/
theorem positiveRationalSubgroupHaarMeasure_isMulRightInvariant (hc : IsCentral i) :
    (positiveRationalSubgroupHaarMeasure F G T i hi I e hc).IsMulRightInvariant := by
  let := positiveIsTopologicalGroup F T I e
  let := normalizedPositiveHaarMeasure_sigmaFinite F G T i hi I e hc
  let := normalizedPositiveHaarMeasure_isMulRightInvariant F G T i hi I e hc
  exact Langlands.QuotientIntegration.isMulRightInvariant_map
    (positiveRationalDecomposition F G T i hi I e hc) _

/-- Multiplication preserves the exact positive-Haar times counting normalization. -/
theorem measurePreserving_positiveRationalDecomposition (hc : IsCentral i) :
    MeasurePreserving (positiveRationalDecomposition F G T i hi I e hc)
      ((normalizedPositiveHaarMeasure F G T i hi I e hc).prod
        (Measure.count : Measure (rationalNormOneSubgroup F G)))
      (positiveRationalSubgroupHaarMeasure F G T i hi I e hc) :=
  ⟨(positiveRationalDecomposition F G T i hi I e hc).continuous.measurable, rfl⟩

theorem measurePreserving_positiveRationalDecomposition_symm (hc : IsCentral i) :
    MeasurePreserving (positiveRationalDecomposition F G T i hi I e hc).symm
      (positiveRationalSubgroupHaarMeasure F G T i hi I e hc)
      ((normalizedPositiveHaarMeasure F G T i hi I e hc).prod
        (Measure.count : Measure (rationalNormOneSubgroup F G))) :=
  MeasurePreserving.symm
    (positiveRationalDecomposition F G T i hi I e hc).toHomeomorph.toMeasurableEquiv
    (measurePreserving_positiveRationalDecomposition F G T i hi I e hc)

/-- Convergence is transported separately from the total integral identity. -/
theorem integrable_positiveRationalDecomposition_iff (hc : IsCentral i)
    (f : positiveRationalSubgroup F G T i → ℂ) :
    Integrable f (positiveRationalSubgroupHaarMeasure F G T i hi I e hc) ↔
      Integrable (fun p => f (positiveRationalDecomposition F G T i hi I e hc p))
        ((normalizedPositiveHaarMeasure F G T i hi I e hc).prod
          (Measure.count : Measure (rationalNormOneSubgroup F G))) :=
  integrable_map_equiv
    (positiveRationalDecomposition F G T i hi I e hc).toHomeomorph.toMeasurableEquiv f

/-- Equality of total Bochner integrals in the actual subgroup coordinates. -/
theorem integral_positiveRationalDecomposition (hc : IsCentral i)
    (f : positiveRationalSubgroup F G T i → ℂ) :
    (∫ x, f x ∂positiveRationalSubgroupHaarMeasure F G T i hi I e hc) =
      ∫ p, f (positiveRationalDecomposition F G T i hi I e hc p)
        ∂((normalizedPositiveHaarMeasure F G T i hi I e hc).prod
          (Measure.count : Measure (rationalNormOneSubgroup F G))) :=
  integral_map_equiv
    (positiveRationalDecomposition F G T i hi I e hc).toHomeomorph.toMeasurableEquiv f

end Langlands.Global.PositiveRealTorus
