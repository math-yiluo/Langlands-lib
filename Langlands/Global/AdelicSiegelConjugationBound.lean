import Langlands.Global.PositiveTorusUnipotentModulus
import Langlands.GroupScheme.Rational.PositiveTorusTriangularCoordinatesProof
import Langlands.GroupScheme.Rational.PositiveRootInduction
import Langlands.Global.AdelicRepresentationHeightPropernessProof

/-!
# Bounded heights of positive-chamber conjugates of compact unipotent sets

On a weak simple-root chamber, conjugation by the inverse of a positive torus point contracts
the standard unipotent subgroup. `exists_adelicHeight_conj_unipotent_le` bounds the full adelic
height of `a⁻¹ n a` uniformly for `n` in a compact subset of `N(𝔸_F)` and `a` in the chamber.
The paired Markdown records the argument.
-/

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry Topology
open scoped CategoryTheory.MonObj NNReal

namespace Langlands.Global.AdelicSiegelFactors

open Langlands.GroupScheme AdelicGroupPoints

section ChamberBounds

variable {F : Type u} [Field F] [NumberField F]
  {G : GroupScheme (Spec (CommRingCat.of F))}
  {T : CommGroupScheme (Spec (CommRingCat.of F))}
  [IsAffineHom G.X.hom] (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)
  {T₀ : CommGroupScheme (Spec (CommRingCat.of F))} (j : T₀ ⟶ T)

omit [IsAffineHom G.X.hom] in
/-- The normalized norm of a restricted character is multiplicative in the character. -/
theorem normCharacter_comp_add_val (x : Lie.AffinePoints T₀.toGrp (Adeles F))
    (β₁ β₂ : characterLattice T) :
    (PositiveRealTorus.normCharacter F T₀ (j ≫ (β₁ + β₂)) x : ℝ≥0) =
      (PositiveRealTorus.normCharacter F T₀ (j ≫ β₁) x : ℝ≥0) *
        (PositiveRealTorus.normCharacter F T₀ (j ≫ β₂) x : ℝ≥0) := by
  have h := congrArg Additive.toMul ((restrictedNormHom j x).map_add β₁ β₂)
  simpa only [restrictedNormHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, toMul_add,
    toMul_ofMul] using h

omit [IsAffineHom G.X.hom] in
/-- The normalized norm of the zero character is one. -/
theorem normCharacter_comp_zero_val (x : Lie.AffinePoints T₀.toGrp (Adeles F)) :
    (PositiveRealTorus.normCharacter F T₀ (j ≫ (0 : characterLattice T)) x : ℝ≥0) = 1 := by
  have h := congrArg Additive.toMul ((restrictedNormHom j x).map_zero)
  simpa only [restrictedNormHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, toMul_zero,
    toMul_ofMul] using h

/-- Every character in the additive monoid generated by the simple relative roots has a
uniform positive lower bound for its normalized norm on a weak simple-root chamber. -/
theorem exists_le_normCharacter_of_mem_closure (t : ℝ≥0ˣ) {β : characterLattice T}
    (hβ : β ∈ AddSubmonoid.closure (simpleRelativeRoots i ν)) :
    ∃ L : ℝ≥0, 0 < L ∧
      ∀ a ∈ PositiveRealTorus.weakSimpleRootChamber F T₀ T j G i ν t,
        L ≤ (PositiveRealTorus.normCharacter F T₀ (j ≫ β) a : ℝ≥0) := by
  induction hβ using AddSubmonoid.closure_induction with
  | mem β hβ =>
    exact ⟨(t : ℝ≥0), t.ne_zero.bot_lt, fun a ha => Units.val_le_val.mpr (ha β hβ)⟩
  | zero =>
    refine ⟨1, one_pos, fun a _ => ?_⟩
    rw [normCharacter_comp_zero_val j]
  | add β₁ β₂ _ _ hβ₁ hβ₂ =>
    obtain ⟨L₁, hL₁, h₁⟩ := hβ₁
    obtain ⟨L₂, hL₂, h₂⟩ := hβ₂
    refine ⟨L₁ * L₂, mul_pos hL₁ hL₂, fun a ha => ?_⟩
    rw [normCharacter_comp_add_val j]
    exact mul_le_mul' (h₁ a ha) (h₂ a ha)

/-- A positive real whose `D`-th power, `D ≥ 1`, is at least `L > 0` has inverse at most
`max 1 L⁻¹`. -/
theorem inv_le_max_of_le_pow {σ L : ℝ≥0} {D : ℕ} (hD : D ≠ 0) (hL : 0 < L)
    (h : L ≤ σ ^ D) : ((σ : ℝ))⁻¹ ≤ max 1 ((L : ℝ))⁻¹ := by
  rcases le_or_gt 1 σ with h1 | h1
  · exact (inv_le_one_of_one_le₀ (by exact_mod_cast h1)).trans (le_max_left _ _)
  · have hσL : L ≤ σ := h.trans (pow_le_of_le_one (by positivity) h1.le hD)
    have hL' : (0 : ℝ) < L := by exact_mod_cast hL
    refine le_trans ?_ (le_max_right _ _)
    exact inv_anti₀ hL' (by exact_mod_cast hσL)

end ChamberBounds

section Scaling

variable (F : Type u) [Field F] [NumberField F]

/-- The adele with the real number `c` at every infinite place and `1` at every finite place.
For `c > 0` it is the positive real idele `PositiveRealIdeles.full F c`. -/
def realScaling (c : ℝ) : Adeles F :=
  (PositiveRealIdeles.infiniteRealEmbedding F c, 1)

theorem continuous_realScaling : Continuous (realScaling F) :=
  (PositiveRealIdeles.continuous_infiniteRealEmbedding F).prodMk continuous_const

theorem coe_full_eq_realScaling (σ : ℝ≥0ˣ) :
    ((PositiveRealIdeles.full F σ : Ideles F) : Adeles F) = realScaling F ((σ : ℝ≥0) : ℝ) :=
  rfl

end Scaling

section ConjugationBound

variable (F : Type u) [Field F] [NumberField F]
  (G : GroupScheme (Spec (CommRingCat.of F)))
  (T : CommGroupScheme (Spec (CommRingCat.of F)))
  [IsAffineHom G.X.hom] [LocallyOfFiniteType G.X.hom]
  (i : T.toGrp ⟶ G) (ν : cocharacterLattice T)
  (T₀ : CommGroupScheme (Spec (CommRingCat.of F))) (j : T₀ ⟶ T)

/-- **Chamber conjugates of a compact unipotent set have bounded height.** For an actual
algebraic Siegel setup, a compact subset `Ω` of the adelic points of the standard unipotent
subgroup and a threshold `t`, the full adelic height of `a⁻¹ n a` is bounded uniformly for
`n ∈ Ω` and `a` the image of a point of the weak simple-root chamber. -/
theorem exists_adelicHeight_conj_unipotent_le (hG : IsConnectedReductive G)
    (hsetup : IsSiegelAlgebraicSetup F G T i ν T₀ j) {N : ℕ}
    (rho : MatrixRepresentation G (Fin N)) (hN : 0 < N)
    (Ω : Set (AdelicGroupPoints F (Standard.unipotentScheme i ν ∅))) (hΩ : IsCompact Ω)
    (t : ℝ≥0ˣ) :
    ∃ B : ℝ, ∀ n ∈ Ω, ∀ a ∈ PositiveRealTorus.weakSimpleRootChamber F T₀ T j G i ν t,
      RepresentationGrowth.adelicHeight F G rho
        ((positiveMap F G T i T₀ j a)⁻¹ *
          map F (Standard.unipotentScheme i ν ∅) G (Standard.unipotentHom i ν ∅) n *
          positiveMap F G T i T₀ j a) ≤ B := by
  classical
  obtain ⟨hTmax, hgen, -⟩ := id hsetup
  have : IsAffine G.X.left := isAffine_of_isAffineHom G.X.hom
  have hcl := Standard.isClosedSubgroup_unipotentHom i ν ∅
  have : IsAffineHom (Standard.unipotentScheme i ν ∅).X.hom := hcl.isAffineHom
  have : IsAffine (Standard.unipotentScheme i ν ∅).X.left :=
    isAffine_of_isAffineHom (Standard.unipotentScheme i ν ∅).X.hom
  obtain ⟨d, tc, P, w, ht, -, -, hconj, hpos, -⟩ :=
    positiveTorusTriangularCoordinates F G hG T i ν hTmax hgen
  let Φ₀ := coordinateHomeomorph (Standard.unipotentScheme i ν ∅) ht
  let f := map F (Standard.unipotentScheme i ν ∅) G (Standard.unipotentHom i ν ∅)
  -- uniform lower bounds for the coordinate weights on the chamber
  have hL : ∀ k, ∃ L : ℝ≥0, 0 < L ∧
      ∀ a ∈ PositiveRealTorus.weakSimpleRootChamber F T₀ T j G i ν t,
        L ≤ (PositiveRealTorus.normCharacter F T₀ (j ≫ w k) a : ℝ≥0) := fun k =>
    exists_le_normCharacter_of_mem_closure i ν j t
      (positiveRelativeRoots_subset_closure_simpleRelativeRoots i ν (hpos k))
  choose L hL0 hL using hL
  let C : Fin d → ℝ := fun k => max 1 ((L k : ℝ))⁻¹
  -- the compact parameter set and the continuous scaling map
  let S : (Fin d → ℝ) × (Fin d → Adeles F) → (Fin d → Adeles F) :=
    fun p k => realScaling F (p.1 k) * p.2 k
  have hS : Continuous S := continuous_pi fun k =>
    ((continuous_realScaling F).comp ((continuous_apply k).comp continuous_fst)).mul
      ((continuous_apply k).comp continuous_snd)
  let K : Set ((Fin d → ℝ) × (Fin d → Adeles F)) :=
    (Set.univ.pi fun k => Set.Icc 0 (C k)) ×ˢ (Φ₀ '' Ω)
  have hK : IsCompact K :=
    (isCompact_univ_pi fun k => isCompact_Icc).prod (hΩ.image Φ₀.continuous)
  let h : (Fin d → ℝ) × (Fin d → Adeles F) → ℝ :=
    fun p => RepresentationGrowth.adelicHeight F G rho (f (Φ₀.symm (S p)))
  have hh : Continuous h :=
    (RepresentationGrowth.continuous_adelicHeight F G rho hN).comp
      (f.continuous.comp (Φ₀.symm.continuous.comp hS))
  obtain ⟨B, hB⟩ := hK.bddAbove_image hh.continuousOn
  refine ⟨B, fun n hn a ha => ?_⟩
  -- the torus point and its character values
  let s : GroupScheme.affinePoints T.toGrp (CommAlgCat.of F (Adeles F)) :=
    a.1 ≫ (CommGroupScheme.groupHom j).hom.hom
  have hsa : positiveMap F G T i T₀ j a =
      GroupScheme.affinePointsTarget T.toGrp i (CommAlgCat.of F (Adeles F)) s := by
    change a.1 ≫ (CommGroupScheme.groupHom j ≫ i).hom.hom =
      (a.1 ≫ (CommGroupScheme.groupHom j).hom.hom) ≫ i.hom.hom
    rw [Category.assoc]
    rfl
  have hσ : ∀ k, ∃ σ : ℝ≥0ˣ, PositiveRealIdeles.full F σ = Lie.characterValue (w k) s := by
    intro k
    obtain ⟨σ, hσ⟩ := (PositiveRealTorus.mem_intrinsicSubgroup_iff F T₀ a.1).mp a.2 (j ≫ w k)
    exact ⟨σ, hσ.trans (Lie.characterValue_comp j (w k) a.1)⟩
  choose σ hσ using hσ
  have hnormσ : ∀ k, (σ k : ℝ≥0) ^ Module.finrank ℚ F =
      (PositiveRealTorus.normCharacter F T₀ (j ≫ w k) a : ℝ≥0) := by
    intro k
    change _ = ((IdeleAbsoluteValue.full F (Lie.characterValue (j ≫ w k) a.1) : ℝ≥0ˣ) : ℝ≥0)
    rw [Lie.characterValue_comp j (w k) a.1, ← hσ k, PositiveRealIdeles.absoluteValue_full,
      Units.val_pow_eq_pow_val]
  -- the conjugate lies in `N(𝔸_F)`
  have hmem : (positiveMap F G T i T₀ j a)⁻¹ * f n * positiveMap F G T i T₀ j a ∈
      standardUnipotentImage F G T i ν := by
    have hnorm := inv_mem (positiveMap_mem_normalizer F G T i ν T₀ j a)
    have h1 := (Subgroup.mem_normalizer_iff.mp hnorm (f n)).mp (MonoidHom.mem_range.mpr ⟨n, rfl⟩)
    rwa [inv_inv] at h1
  obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hmem
  have hy' : f y = (positiveMap F G T i T₀ j a)⁻¹ * f n * positiveMap F G T i T₀ j a := hy
  have hny : f n = positiveMap F G T i T₀ j a * f y * (positiveMap F G T i T₀ j a)⁻¹ := by
    rw [hy']
    group
  rw [hsa] at hny
  have hck := hconj (CommAlgCat.of F (Adeles F)) s y n hny
  -- coordinates of the conjugate
  let c : Fin d → ℝ := fun k => (((σ k)⁻¹ : ℝ≥0ˣ) : ℝ≥0)
  have hcoord : Φ₀ y = S (c, Φ₀ n) := by
    funext k
    change (Standard.unipotentScheme i ν ∅).affinePointEvaluation
        (CommAlgCat.of F (Adeles F)) y (tc k) =
      realScaling F (c k) * (Standard.unipotentScheme i ν ∅).affinePointEvaluation
        (CommAlgCat.of F (Adeles F)) n (tc k)
    rw [hck k, ← hσ k, ← coe_full_eq_realScaling, map_inv, ← mul_assoc, Units.inv_mul,
      one_mul]
  have hc : c ∈ Set.univ.pi fun k => Set.Icc 0 (C k) := by
    intro k _
    refine ⟨NNReal.coe_nonneg _, ?_⟩
    have h2 := inv_le_max_of_le_pow (Module.finrank_pos (R := ℚ) (M := F)).ne' (hL0 k)
      ((hL k a ha).trans_eq (hnormσ k).symm)
    simpa [c, C] using h2
  have hpK : (c, Φ₀ n) ∈ K := ⟨hc, n, hn, rfl⟩
  have hval : h (c, Φ₀ n) =
      RepresentationGrowth.adelicHeight F G rho
        ((positiveMap F G T i T₀ j a)⁻¹ * f n * positiveMap F G T i T₀ j a) := by
    change RepresentationGrowth.adelicHeight F G rho (f (Φ₀.symm (S (c, Φ₀ n)))) = _
    rw [← hcoord, Φ₀.symm_apply_apply, hy']
  rw [← hval]
  exact hB ⟨_, hpK, rfl⟩

end ConjugationBound

end Langlands.Global.AdelicSiegelFactors
