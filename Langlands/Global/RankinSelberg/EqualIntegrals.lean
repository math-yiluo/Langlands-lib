import Langlands.Global.RankinSelberg.SchwartzBruhat

/-! # The equal-rank global Rankin–Selberg integrals

For `n = r + 1`: the Haar measure `d^×a` on `𝔸^× = GL_1(𝔸)` normalized by the idele class
slab `F^× \ {1 ≤ |a| < e}`, the section
`F(g, Φ; s, χ) = |det g|^s ∫_(𝔸^×) Φ(a e_n g) |a|^(ns) χ(a) d^×a`, the parabolic
`P'_n = Z_n P_n` of type `(n - 1, 1)`, the Eisenstein series
`E(g, Φ; s, χ) = Σ_(γ ∈ P'_n(F) \ GL_n(F)) F(γ g, Φ; s, χ)`, the quotient
`Z_n(𝔸) GL_n(F) \ GL_n(𝔸)` with its measure, the global integral
`I(s; φ, φ', Φ) = ∫ φ(g) φ'(g) E(g, Φ; s, χ) dg`, and the global Whittaker integral
`Ψ(s; W, W', Φ) = ∫_(N_n(𝔸) \ GL_n(𝔸)) W(g) W'(g) Φ(e_n g) |det g|^s dg`
(Cogdell 2004, §2.3, pp.208–210). See the paired Markdown for sources and normalizations.
-/

noncomputable section
universe u
open NumberField MeasureTheory
open scoped CategoryTheory.MonObj
set_option autoImplicit false

namespace Langlands.Global.RankinSelbergGlobal

local instance equalSchemeAffine (F : Type u) [Field F] (n : ℕ) :
    AlgebraicGeometry.IsAffine (Scheme F n).X.left :=
  GroupScheme.GeneralLinear.isAffine_groupScheme _ _
local instance equalSchemeSmooth (F : Type u) [Field F] (n : ℕ) :
    AlgebraicGeometry.Smooth (Scheme F n).X.hom :=
  GroupScheme.GeneralLinear.smoothStatement _ _

variable (F : Type u) [Field F] [NumberField F]

/-- The point `γ ∈ GL_n(F) ⊆ GL_n(𝔸)` of a rational matrix `γ`, through the Library's
principal-point map of the group scheme. -/
def rationalPoint (n : ℕ) (γ : RationalGL F n) : Points F n :=
  AdelicGroupPoints.rational F (Scheme F n) ((GeneralLinearGroupPoints.rationalEquiv F n).symm γ)

/-- The idele `a = det z ∈ 𝔸^×` of a point `z ∈ GL_1(𝔸)`. -/
def ideleOf (z : Points F 1) : IdeleGroup (𝓞 F) F :=
  Matrix.GeneralLinearGroup.det (GeneralLinearGroupPoints.adelicEquiv F 1 z)

/-- The last row `e_n g` of `g ∈ GL_n(𝔸)`, `n = r + 1`. -/
def lastRow (r : ℕ) (g : Points F (r + 1)) : RowVector F (r + 1) :=
  Matrix.of fun _ j =>
    (GeneralLinearGroupPoints.adelicEquiv F (r + 1) g : Matrix (Fin (r + 1)) (Fin (r + 1))
      (Adeles F)) (Fin.last r) j

/-- The classes in `GL_n(F) \ GL_n(𝔸)` of the points `g` with `a ≤ |det g| < b`. -/
def determinantSlab (n : ℕ) (a b : ℝ) :
    Set (AdelicGroupPoints.RationalQuotient F (Scheme F n)) :=
  LeftCosetSpace.mk _ '' {g : Points F n | a ≤ detNorm F n g ∧ detNorm F n g < b}

/-- The volume of `F^× \ {a ∈ 𝔸^× : 1 ≤ |a| < e}` for the Library's quotient Haar measure on
`GL_1(F) \ GL_1(𝔸)`. -/
def ideleSlabVolume : ENNReal :=
  AdelicGroupPoints.rationalQuotientHaarMeasure F (Scheme F 1)
    (determinantSlab F 1 1 (Real.exp 1))

/-- The Haar measure `d^×a` on `𝔸^× = GL_1(𝔸)`, scaled so that its quotient by `F^×` gives
the slab `F^× \ {1 ≤ |a| < e}` volume one. -/
def ideleMeasure : Measure (Points F 1) :=
  (ideleSlabVolume F)⁻¹ • Measure.haar

/-- The integrand `Φ(a e_n g) |a|^(ns) χ(a)` of the section, at `a = det z`. -/
def eisensteinSectionIntegrand {r : ℕ} (χ : IdeleClassGroup (𝓞 F) F →ₜ* ℂˣ)
    (Φ : RowVector F (r + 1) → ℂ) (s : ℂ) (g : Points F (r + 1)) (z : Points F 1) : ℂ :=
  Φ ((ideleOf F z : Adeles F) • lastRow F r g) * detPower F 1 z ((r + 1 : ℂ) * s) *
    (Automorphic.centralIdeleCharacter F χ (ideleOf F z) : ℂ)

/-- The section `F(g, Φ; s, χ) = |det g|^s ∫_(𝔸^×) Φ(a e_n g) |a|^(ns) χ(a) d^×a`. -/
def eisensteinSection {r : ℕ} (χ : IdeleClassGroup (𝓞 F) F →ₜ* ℂˣ)
    (Φ : RowVector F (r + 1) → ℂ) (s : ℂ) (g : Points F (r + 1)) : ℂ :=
  detPower F (r + 1) g s * ∫ z, eisensteinSectionIntegrand F χ Φ s g z ∂ideleMeasure F

/-- The rational parabolic `P'_n(F) = Z_n(F) P_n(F)` of type `(n - 1, 1)`: the subgroup
generated by the mirabolic and the center. -/
def eisensteinParabolic (r : ℕ) : Subgroup (RationalGL F (r + 1)) :=
  GeneralLinear.mirabolic r F ⊔ Subgroup.center (RationalGL F (r + 1))

/-- The Eisenstein series `E(g, Φ; s, χ) = Σ_(γ ∈ P'_n(F) \ GL_n(F)) F(γ g, Φ; s, χ)`, as an
unconditional sum (`0` when not summable). -/
def eisensteinSeries {r : ℕ} (χ : IdeleClassGroup (𝓞 F) F →ₜ* ℂˣ)
    (Φ : RowVector F (r + 1) → ℂ) (s : ℂ) (g : Points F (r + 1)) : ℂ :=
  ∑' q : LeftCosetSpace (eisensteinParabolic F r),
    eisensteinSection F χ Φ s (rationalPoint F (r + 1) q.out * g)

/-- The subgroup `Z_n(𝔸) GL_n(F)` of `GL_n(𝔸)`. -/
def centralRationalSubgroup (n : ℕ) : Subgroup (Points F n) :=
  Subgroup.center (Points F n) ⊔ AdelicGroupPoints.rationalSubgroup F (Scheme F n)

/-- The quotient `Z_n(𝔸) GL_n(F) \ GL_n(𝔸)`. -/
abbrev CentralQuotient (n : ℕ) := LeftCosetSpace (centralRationalSubgroup F n)

/-- The projection `GL_n(F) \ GL_n(𝔸) → Z_n(𝔸) GL_n(F) \ GL_n(𝔸)`. -/
def toCentralQuotient (n : ℕ) :
    AdelicGroupPoints.RationalQuotient F (Scheme F n) → CentralQuotient F n :=
  LeftCosetSpace.lift _ (LeftCosetSpace.mk (centralRationalSubgroup F n)) fun γ x =>
    LeftCosetSpace.mk_subgroup_mul (centralRationalSubgroup F n)
      ⟨γ, (le_sup_right : AdelicGroupPoints.rationalSubgroup F (Scheme F n) ≤
        centralRationalSubgroup F n) γ.2⟩ x

theorem measurable_toCentralQuotient (n : ℕ) : Measurable (toCentralQuotient F n) :=
  measurable_from_quotient.mpr (LeftCosetSpace.measurable_mk (centralRationalSubgroup F n))

/-- The measure on `Z_n(𝔸) GL_n(F) \ GL_n(𝔸)`: the image of the Library's quotient Haar
measure on `GL_n(F) \ GL_n(𝔸)` restricted to the slab `1 ≤ |det g| < e^n`. -/
def centralQuotientMeasure (n : ℕ) : Measure (CentralQuotient F n) :=
  Measure.map (toCentralQuotient F n)
    ((AdelicGroupPoints.rationalQuotientHaarMeasure F (Scheme F n)).restrict
      (determinantSlab F n 1 (Real.exp n)))

/-- The integrand `φ(g) φ'(g) E(g, Φ; s, χ)` on `Z_n(𝔸) GL_n(F) \ GL_n(𝔸)`, at the
representative of a class. -/
def equalIntegrand {r : ℕ} (χ : IdeleClassGroup (𝓞 F) F →ₜ* ℂˣ)
    (φ φ' : Points F (r + 1) → ℂ) (Φ : RowVector F (r + 1) → ℂ) (s : ℂ)
    (q : CentralQuotient F (r + 1)) : ℂ :=
  let g := q.out
  φ g * φ' g * eisensteinSeries F χ Φ s g

/-- The equal-rank global integral
`I(s; φ, φ', Φ) = ∫_(Z_n(𝔸) GL_n(F) \ GL_n(𝔸)) φ(g) φ'(g) E(g, Φ; s, χ) dg`, with the series
`E` itself (no continuation). -/
def equalIntegral {r : ℕ} (χ : IdeleClassGroup (𝓞 F) F →ₜ* ℂˣ)
    (φ φ' : Points F (r + 1) → ℂ) (Φ : RowVector F (r + 1) → ℂ) (s : ℂ) : ℂ :=
  ∫ q, equalIntegrand F χ φ φ' Φ s q ∂centralQuotientMeasure F (r + 1)

/-- The integrand `W(g) W'(g) Φ(e_n g) |det g|^s` on `N_n(𝔸) \ GL_n(𝔸)`, at the
representative of a class. -/
def equalWhittakerIntegrand {r : ℕ} (W W' : Points F (r + 1) → ℂ)
    (Φ : RowVector F (r + 1) → ℂ) (s : ℂ) (q : WhittakerQuotient F (r + 1)) : ℂ :=
  let g := q.out
  W g * W' g * Φ (lastRow F r g) * detPower F (r + 1) g s

/-- The equal-rank global Whittaker integral
`Ψ(s; W, W', Φ) = ∫_(N_n(𝔸) \ GL_n(𝔸)) W(g) W'(g) Φ(e_n g) |det g|^s dg`. -/
def equalWhittakerIntegral {r : ℕ} (W W' : Points F (r + 1) → ℂ)
    (Φ : RowVector F (r + 1) → ℂ) (s : ℂ) : ℂ :=
  ∫ q, equalWhittakerIntegrand F W W' Φ s q ∂whittakerQuotientMeasure F (r + 1)

/-- The set `P(χ)` of possible poles: if `χ(a) = |a|^w` for all ideles `a`, the points
`s = -w/n` and `s = 1 - w/n`; otherwise empty. -/
def equalPoleSet (n : ℕ) (χ : IdeleClassGroup (𝓞 F) F →ₜ* ℂˣ) : Set ℂ :=
  {s | ∃ w : ℂ, (∀ z : Points F 1,
      (Automorphic.centralIdeleCharacter F χ (ideleOf F z) : ℂ) = detPower F 1 z w) ∧
    (s = -w / n ∨ s = 1 - w / n)}

end Langlands.Global.RankinSelbergGlobal
