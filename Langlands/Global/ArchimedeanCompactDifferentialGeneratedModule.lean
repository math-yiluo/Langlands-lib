import Langlands.Global.ArchimedeanCompactOrbitSource
import Mathlib.Algebra.Algebra.Operations

/-! # The actual compact-and-differential generated module -/

noncomputable section
universe u
set_option autoImplicit false

namespace Langlands.Global.ArchimedeanGL

open DerivativeSmoothFunctions

variable (K : Type u) [Field K] [NumberField K] (n : ℕ)

private theorem smul_mem_full_actionSpan
    (S : Submodule ℂ (DerivativeSmoothFunctions K n))
    (a : EnvelopingAlgebra K n) {v : DerivativeSmoothFunctions K n}
    (hv : v ∈ (⊤ : Submodule ℂ (EnvelopingAlgebra K n)) • S) :
    a • v ∈ (⊤ : Submodule ℂ (EnvelopingAlgebra K n)) • S := by
  refine Submodule.smul_induction_on hv ?_ ?_
  · intro b hb w hw
    simpa only [mul_smul] using
      (Submodule.smul_mem_smul (I := (⊤ : Submodule ℂ (EnvelopingAlgebra K n)))
        (r := a * b) (Submodule.mem_top) hw)
  · intro v w hv hw
    simpa only [smul_add] using Submodule.add_mem _ hv hw

/-- The full complex action span is the scalar restriction of the genuine
enveloping submodule generated by the same source. -/
theorem full_actionSpan_eq_restrictScalars_span
    (S : Submodule ℂ (DerivativeSmoothFunctions K n)) :
    (⊤ : Submodule ℂ (EnvelopingAlgebra K n)) • S =
      (Submodule.span (EnvelopingAlgebra K n) (S : Set (DerivativeSmoothFunctions K n))).restrictScalars ℂ := by
  apply le_antisymm
  · apply Submodule.smul_le.mpr
    intro a ha v hv
    exact (Submodule.span (EnvelopingAlgebra K n) (S : Set (DerivativeSmoothFunctions K n))).smul_mem
      a (Submodule.subset_span hv)
  · intro v hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
      simpa only [one_smul] using
        (Submodule.smul_mem_smul (I := (⊤ : Submodule ℂ (EnvelopingAlgebra K n)))
          (r := 1) Submodule.mem_top hv)
    | zero => exact Submodule.zero_mem _
    | add v w hv hw ihv ihw => exact Submodule.add_mem _ ihv ihw
    | smul a v hv ih => exact smul_mem_full_actionSpan K n S a ih

/-- The genuine enveloping submodule generated by the entire actual compact orbit. -/
def compactDifferentialGeneratedModule (f : DerivativeSmoothFunctions K n) :
    Submodule (EnvelopingAlgebra K n) (DerivativeSmoothFunctions K n) :=
  Submodule.span (EnvelopingAlgebra K n)
    (Langlands.FiniteVectors.orbitSpan (compactAction K n) f :
      Set (DerivativeSmoothFunctions K n))

/-- The explicit complex span appearing in the actual compact-type statement. -/
def compactDifferentialGeneratedSpan (f : DerivativeSmoothFunctions K n) :
    Submodule ℂ (DerivativeSmoothFunctions K n) :=
  Submodule.span ℂ (Set.range fun p : standardInfiniteCompact K n × EnvelopingAlgebra K n =>
    compactAction K n p.1 (operator K n p.2 f))

/-- Genuine covariance identifies both orders of the whole compact and
enveloping generated span. No compact-finiteness premise is needed. -/
theorem full_actionSpan_compactOrbit_eq_generatedSpan (f : DerivativeSmoothFunctions K n) :
    (⊤ : Submodule ℂ (EnvelopingAlgebra K n)) •
        Langlands.FiniteVectors.orbitSpan (compactAction K n) f =
      compactDifferentialGeneratedSpan K n f := by
  apply le_antisymm
  · apply Submodule.smul_le.mpr
    intro a ha v hv
    change v ∈ Submodule.span ℂ (Set.range fun k : standardInfiniteCompact K n =>
      compactAction K n k f) at hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨k, rfl⟩ := hv
      have heq : a • compactAction K n k f =
          compactAction K n k (operator K n ((envelopingConjugation K n k.val).symm a) f) := by
        rw [← enveloping_smul_eq_operator, compactAction_enveloping_smul,
          AlgEquiv.apply_symm_apply]
      rw [heq]
      exact Submodule.subset_span ⟨(k, (envelopingConjugation K n k.val).symm a), rfl⟩
    | zero => simpa only [smul_zero] using (compactDifferentialGeneratedSpan K n f).zero_mem
    | add v w hv hw ihv ihw =>
      simpa only [smul_add] using (compactDifferentialGeneratedSpan K n f).add_mem ihv ihw
    | smul z v hv ih =>
      rw [smul_comm]
      exact (compactDifferentialGeneratedSpan K n f).smul_mem z ih
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨k, a⟩, rfl⟩
    change compactAction K n k (operator K n a f) ∈ _
    rw [← enveloping_smul_eq_operator, compactAction_enveloping_smul]
    exact Submodule.smul_mem_smul Submodule.mem_top
      (Langlands.FiniteVectors.action_mem_orbitSpan (compactAction K n) k f)

/-- The underlying complex space is exactly the unchanged published generated span. -/
theorem compactDifferentialGeneratedModule_restrictScalars (f : DerivativeSmoothFunctions K n) :
    (compactDifferentialGeneratedModule K n f).restrictScalars ℂ =
      compactDifferentialGeneratedSpan K n f := by
  rw [compactDifferentialGeneratedModule, ← full_actionSpan_eq_restrictScalars_span K n]
  exact full_actionSpan_compactOrbit_eq_generatedSpan K n f

/-- The whole compact group preserves the actual generated enveloping submodule. -/
theorem compactAction_mem_generatedModule (f : DerivativeSmoothFunctions K n)
    (k : standardInfiniteCompact K n) {v : DerivativeSmoothFunctions K n}
    (hv : v ∈ compactDifferentialGeneratedModule K n f) :
    compactAction K n k v ∈ compactDifferentialGeneratedModule K n f := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    apply Submodule.subset_span
    exact (Langlands.FiniteVectors.orbitSubrepresentation (compactAction K n) f).apply_mem_toSubmodule k hv
  | zero => simpa only [map_zero] using (compactDifferentialGeneratedModule K n f).zero_mem
  | add v w hv hw ihv ihw =>
    simpa only [map_add] using (compactDifferentialGeneratedModule K n f).add_mem ihv ihw
  | smul a v hv ih =>
    rw [compactAction_enveloping_smul]
    exact (compactDifferentialGeneratedModule K n f).smul_mem _ ih

/-- The actual generated module as a subrepresentation of the whole compact group. -/
def compactDifferentialGeneratedSubrepresentation (f : DerivativeSmoothFunctions K n) :
    Subrepresentation (compactAction K n) where
  toSubmodule := (compactDifferentialGeneratedModule K n f).restrictScalars ℂ
  apply_mem_toSubmodule k _v hv := compactAction_mem_generatedModule K n f k hv

/-- The actual whole compact representation on the generated genuine enveloping module. -/
def compactDifferentialGeneratedAction (f : DerivativeSmoothFunctions K n) :
    _root_.Representation ℂ (standardInfiniteCompact K n)
      (compactDifferentialGeneratedModule K n f) where
  toFun k :=
    { toFun := fun v =>
        ⟨compactAction K n k v.val, compactAction_mem_generatedModule K n f k v.property⟩
      map_add' := fun v w => Subtype.ext (map_add (compactAction K n k) v.val w.val)
      map_smul' := fun c v => Subtype.ext (map_smul (compactAction K n k) c v.val) }
  map_one' := by
    ext v : 1
    apply Subtype.ext
    change compactAction K n 1 v.val = v.val
    simp only [map_one, Module.End.one_apply]
  map_mul' k l := by
    ext v : 1
    apply Subtype.ext
    change compactAction K n (k * l) v.val = compactAction K n k (compactAction K n l v.val)
    simp only [map_mul, Module.End.mul_apply]

/-- The restricted actual actions retain the genuine conjugation law. -/
theorem generatedAction_enveloping_compatible (f : DerivativeSmoothFunctions K n)
    (k : standardInfiniteCompact K n) (a : EnvelopingAlgebra K n)
    (v : compactDifferentialGeneratedModule K n f) :
    compactDifferentialGeneratedAction K n f k (a • v) =
      envelopingConjugation K n k.val a • compactDifferentialGeneratedAction K n f k v := by
  apply Subtype.ext
  change compactAction K n k (a • v.val) =
    envelopingConjugation K n k.val a • compactAction K n k v.val
  exact compactAction_enveloping_smul K n k a v.val

end Langlands.Global.ArchimedeanGL
