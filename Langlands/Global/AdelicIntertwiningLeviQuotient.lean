import Langlands.Global.AdelicIntertwiningNormalizedLevi
import Langlands.Global.AdelicNormOneQuotientIso

/-! # Canonical Levi quotient transport and normalized inducing functions -/

noncomputable section

open CategoryTheory AlgebraicGeometry MeasureTheory
open scoped CategoryTheory.MonObj ENNReal NNReal

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Langlands.Global.RestrictionSplitCentre

open Langlands.GroupScheme AdelicGroupPoints

variable {F : Type} [Field F] [NumberField F]
  {L L' : GroupScheme (Spec (CommRingCat.of F))}
  [IsAffine L.X.left] [LocallyOfFiniteType L.X.hom]
  [IsAffine L'.X.left] [LocallyOfFiniteType L'.X.hom]
  (e : L ≅ L')

/-- The point map of an isomorphism sends the subgroup generated by the canonical positive
component and the rational points into the corresponding subgroup. -/
theorem map_mem_canonicalRationalSubgroup {m : AdelicGroupPoints F L}
    (hm : m ∈ canonicalRationalSubgroup F L) : map F L L' e.hom m ∈ canonicalRationalSubgroup F L' := by
  change m ∈ canonicalSubgroup F L ⊔ AdelicGroupPoints.rationalSubgroup F L at hm
  refine (sup_le (fun x hx => Subgroup.mem_sup_left (map_mem_canonicalSubgroup e hx))
    ?_ : canonicalSubgroup F L ⊔ AdelicGroupPoints.rationalSubgroup F L ≤
      (canonicalRationalSubgroup F L').comap (map F L L' e.hom).toMonoidHom) hm
  rintro _ ⟨x, rfl⟩
  apply Subgroup.mem_sup_right
  exact ⟨L.affinePointsTarget e.hom (CommAlgCat.of F F) x,
    DFunLike.congr_fun (rational_naturality F L e.hom) x⟩

/-- The point map on the actual canonical quotients. -/
def canonicalQuotientMap : CanonicalQuotient F L → CanonicalQuotient F L' :=
  LeftCosetSpace.lift (canonicalRationalSubgroup F L)
    (fun m => LeftCosetSpace.mk (canonicalRationalSubgroup F L') (map F L L' e.hom m))
    (fun z m => by
      rw [map_mul]
      exact LeftCosetSpace.mk_subgroup_mul _ ⟨_, map_mem_canonicalRationalSubgroup e z.property⟩ _)

@[simp] theorem canonicalQuotientMap_mk (m : AdelicGroupPoints F L) :
    canonicalQuotientMap e (LeftCosetSpace.mk (canonicalRationalSubgroup F L) m) =
      LeftCosetSpace.mk (canonicalRationalSubgroup F L') (map F L L' e.hom m) := rfl

theorem measurable_canonicalQuotientMap : Measurable (canonicalQuotientMap e) :=
  measurable_from_quotient.mpr ((LeftCosetSpace.measurable_mk _).comp (map F L L' e.hom).measurable)

/-- The point map transports the specific measures defining the canonical quotient up to a
strictly positive scalar. -/
theorem map_canonicalMeasure :
    ∃ s : ℝ≥0, 0 < s ∧ Measure.map (canonicalQuotientMap e) (canonicalMeasure F L) =
      (s : ℝ≥0∞) • canonicalMeasure F L' := by
  let f (H : GroupScheme (Spec (CommRingCat.of F))) [IsAffine H.X.left] [LocallyOfFiniteType H.X.hom] :=
    normOneToQuotient F H (canonicalRestrictionTorus F H) (canonicalRestrictionComponent F H)
  have hf : canonicalQuotientMap e ∘ f L = f L' ∘ normOneQuotientIso e := by
    funext x
    induction x using Quotient.inductionOn with
    | _ m => rfl
  have hfL : Measurable (f L) := measurable_normOneToQuotient _ _ _ _
  have hfL' : Measurable (f L') := measurable_normOneToQuotient _ _ _ _
  obtain ⟨s, hs, hmap⟩ := normOneQuotientIsoHaar e
  refine ⟨s, hs, ?_⟩
  change Measure.map (canonicalQuotientMap e)
    (Measure.map (f L) (normOneRationalQuotientHaarMeasure F L)) =
      (s : ℝ≥0∞) • Measure.map (f L') (normOneRationalQuotientHaarMeasure F L')
  rw [Measure.map_map (measurable_canonicalQuotientMap e) hfL, hf,
    ← Measure.map_map hfL' (normOneQuotientIso e).measurable, hmap,
    Measure.map_smul (s : ℝ≥0∞) hfL'.aemeasurable]

end Langlands.Global.RestrictionSplitCentre

namespace Langlands.Global.AdelicGroupPoints

open Langlands.GroupScheme Langlands.Automorphic.GroupSchemeFunctions RestrictionSplitCentre
open InducedInnerProductIntegrable (form_canonical_mul form_rational_mul
  parameterPower_map_mul_left neg_modulus_add_half_add_half continuous_parameterPower)

variable {F : Type} [Field F] [NumberField F]
  {G P M U : GroupScheme (Spec (CommRingCat.of F))}
  [IsAffine G.X.left] [LocallyOfFiniteType G.X.hom]
  [IsAffine P.X.left] [LocallyOfFiniteType P.X.hom]
  [IsAffine M.X.left] [LocallyOfFiniteType M.X.hom]
  (p : P ⟶ G) (l : M ⟶ P) {iU : U ⟶ P} {φ : AdelicGroupPoints F G → ℂ}

/-- The Levi restriction normalized by the inverse parabolic half modulus, with arbitrary
adelic argument. -/
def normalizedLeviValue (φ : AdelicGroupPoints F G → ℂ)
    (m : AdelicGroupPoints F M) (g : AdelicGroupPoints F G) : ℂ :=
  parameterPower F P (-halfModulusParameter F P) (map F M P l m) *
    φ (map F P G p (map F M P l m) * g)

theorem continuous_normalizedLeviValue (hc : Continuous φ) :
    Continuous (fun z : AdelicGroupPoints F M × AdelicGroupPoints F G =>
      normalizedLeviValue p l φ z.1 z.2) := by
  unfold normalizedLeviValue
  exact ((continuous_parameterPower _).comp ((map F M P l).continuous.comp continuous_fst)).mul
    (hc.comp (((map F P G p).continuous.comp ((map F M P l).continuous.comp continuous_fst)).mul
      continuous_snd))

/-- The normalized restriction descends through both the positive split centre and the rational
Levi points. -/
theorem normalizedLeviValue_invariant
    (hi : IsLeftInvariantUnder F G (parabolicQuotientSubgroup F p iU l) φ)
    (he : IsSplitComponentEquivariant p l φ) (g : AdelicGroupPoints F G) :
    ∀ a ∈ canonicalRationalSubgroup F M, ∀ m,
      normalizedLeviValue p l φ (a * m) g = normalizedLeviValue p l φ m g := by
  apply LeftCosetSpace.invariant_sup (canonicalSubgroup F M)
    (Δ := AdelicGroupPoints.rationalSubgroup F M) (fun m => normalizedLeviValue p l φ m g)
  · intro a ha m
    have hcancel : parameterPower F P (-halfModulusParameter F P) (map F M P l a) *
        parameterPower F P (halfModulusParameter F P) (map F M P l a) = 1 := by
      simp only [parameterPower, map_neg, LinearMap.neg_apply, ← Complex.exp_add, neg_add_cancel,
        Complex.exp_zero]
    unfold normalizedLeviValue
    rw [map_mul, map_mul, mul_assoc, he a ha, InducedInnerProductIntegrable.parameterPower_mul,
      mul_mul_mul_comm, hcancel, one_mul]
  · intro a ha m
    unfold normalizedLeviValue
    rw [parameterPower_map_mul_left _ l (rationalSubgroup_le_normOneSubgroup F M ha)]
    rw [form_rational_mul hi ha]

/-- The squared norm of the normalized value is precisely the weight in the published
square-integrability predicate. -/
theorem sq_norm_normalizedLeviValue (m : AdelicGroupPoints F M) (g : AdelicGroupPoints F G) :
    ‖normalizedLeviValue p l φ m g‖ ^ 2 = ‖parameterPower F P (-modulusParameter F P)
      (map F M P l m)‖ * ‖φ (map F P G p (map F M P l m) * g)‖ ^ 2 := by
  have hpar : -halfModulusParameter F P + -halfModulusParameter F P = -modulusParameter F P := by
    have h := neg_modulus_add_half_add_half (F := F) (P := P)
    calc
      _ = (-modulusParameter F P + halfModulusParameter F P + halfModulusParameter F P) +
          (-halfModulusParameter F P + -halfModulusParameter F P) := by rw [h, zero_add]
      _ = _ := by abel
  unfold normalizedLeviValue
  rw [norm_mul, mul_pow, sq ‖parameterPower F P (-halfModulusParameter F P) (map F M P l m)‖,
    ← norm_mul, ← InducedInnerProductIntegrable.parameterPower_add, hpar]

end Langlands.Global.AdelicGroupPoints
