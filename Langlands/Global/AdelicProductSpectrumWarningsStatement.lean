import Langlands.Global.AdelicLevelModelPoints
import Langlands.Global.GlobalPlaceTopologyFacts

/-! # Support warnings for spectra of infinite products and adelic levels -/

universe u

open CategoryTheory Filter Polynomial
open _root_.AlgebraicGeometry

namespace Langlands.AlgebraicGeometry.PointTopology

/-- Factor spectra of an arbitrary product ring: disjoint open subschemes, a cover exactly
when only finitely many factors are nonzero, never quasi-compact otherwise, and
scheme-theoretically dense. -/
def ProductFactorSpectrumStatement : Prop :=
  ∀ (ι : Type u) (R : ι → Type u) [∀ i, CommRing (R i)],
    (∀ i, IsOpenImmersion (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i)))) ∧
    Pairwise (fun i j =>
      Disjoint (Set.range (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))))
        (Set.range (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R j))))) ∧
    ((⋃ i, Set.range (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i)))) = Set.univ ↔
      {i | Nontrivial (R i)}.Finite) ∧
    ({i | Nontrivial (R i)}.Infinite →
      ¬ IsCompact (⋃ i, Set.range (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))))) ∧
    ∀ I : Ideal (∀ i, R i),
      (∀ i, ∃ f : Spec (CommRingCat.of (R i)) ⟶ Spec (CommRingCat.of ((∀ i, R i) ⧸ I)),
        f ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) =
          Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))) → I = ⊥

/-- Conrad's warnings for a ring `A` with local factor maps `p i : A →+* B i`. -/
def LocalFactorSpectrumWarnings {ι : Type u} (A : Type u) [CommRing A] (B : ι → Type u)
    [∀ i, CommRing (B i)] [∀ i, IsLocalRing (B i)] (p : ∀ i, A →+* B i) : Prop :=
  (∀ i, IsOpenImmersion (Spec.map (CommRingCat.ofHom (p i)))) ∧
    Pairwise (fun i j => Disjoint (Set.range (Spec.map (CommRingCat.ofHom (p i))))
      (Set.range (Spec.map (CommRingCat.ofHom (p j))))) ∧
    (∀ i, (Set.range (Spec.map (CommRingCat.ofHom (p i)))).Nonempty) ∧
    (⋃ i, Set.range (Spec.map (CommRingCat.ofHom (p i)))) ≠ Set.univ ∧
    ¬ IsCompact (⋃ i, Set.range (Spec.map (CommRingCat.ofHom (p i)))) ∧
    (∀ I : Ideal A, (∀ i, ∃ f : Spec (CommRingCat.of (B i)) ⟶ Spec (CommRingCat.of (A ⧸ I)),
        f ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) =
          Spec.map (CommRingCat.ofHom (p i))) → I = ⊥) ∧
    (∀ a, a ∈ Ideal.span {b : A | ∀ᶠ j in cofinite, Irreducible (p j b)} ↔
      ∀ᶠ j in cofinite, p j a ∈ IsLocalRing.maximalIdeal (B j)) ∧
    ¬ (Ideal.span {b : A | ∀ᶠ j in cofinite, Irreducible (p j b)}).FG ∧
    ∀ i, (Ideal.span {b : A | ∀ᶠ j in cofinite, Irreducible (p j b)}).map (p i) = ⊤

/-- The warnings for an infinite product of local rings, cofinitely many of them with a
principal maximal ideal generated by an irreducible element. -/
def LocalProductSpectrumWarningsStatement : Prop :=
  ∀ (ι : Type u) [Infinite ι] (R : ι → Type u) [∀ i, CommRing (R i)]
    [∀ i, IsLocalRing (R i)],
    (∀ᶠ i in cofinite, ∃ ϖ : R i, Irreducible ϖ ∧
      IsLocalRing.maximalIdeal (R i) = Ideal.span {ϖ}) →
      LocalFactorSpectrumWarnings (∀ i, R i) R (Pi.evalRingHom R)

/-- Killing `r` in `∏ R i` gives a closed subscheme containing every factor point but no
factor indexed by `N` scheme-theoretically, with `r` not nilpotent, so the factor spectra
are not topologically dense. -/
def ClosedSubschemeSupportWarning {ι : Type} (R : ι → Type u) [∀ i, CommRing (R i)]
    (r : ∀ i, R i) (N : Set ι) : Prop :=
  (∀ i, Set.range (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))) ⊆
      Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {r}))))) ∧
    (∀ i ∈ N, ¬ ∃ f : Spec (CommRingCat.of (R i)) ⟶
        Spec (CommRingCat.of ((∀ i, R i) ⧸ Ideal.span {r})),
      f ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {r}))) =
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))) ∧
    ¬ IsNilpotent r ∧
    Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {r})))) ≠
      Set.univ ∧
    closure (⋃ i, Set.range (Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i)))) ≠ Set.univ

/-- Moret-Bailly's example `R n = k[t]/(t^(n+1))` with the diagonal element `(t, t, ...)`. -/
def MoretBaillyDiagonalStatement : Prop :=
  ∀ (k : Type u) [Field k],
    ClosedSubschemeSupportWarning (fun n : ℕ => k[X] ⧸ Ideal.span {(X : k[X]) ^ (n + 1)})
      (fun n => Ideal.Quotient.mk (Ideal.span {(X : k[X]) ^ (n + 1)}) X) {n | 1 ≤ n}

end Langlands.AlgebraicGeometry.PointTopology

namespace Langlands.Global

open Langlands.AlgebraicGeometry.PointTopology

/-- The warnings for every full number-field adelic level and its completed factors. -/
def NumberFieldLevelSpectrumWarningsStatement : Prop :=
  ∀ (K : Type u) [Field K] [NumberField K] (S : Finset (FinitePlace K)),
    LocalFactorSpectrumWarnings (numberFieldAdeleLevel K S) (NumberFieldLevelFactor K S)
      (numberFieldLevelFactorProjection K S)

/-- The warnings for every curve-place adelic level and its completed factors. -/
def CurvePlaceLevelSpectrumWarningsStatement : Prop :=
  ∀ (k F : Type u) [Field k] [Field F] [Algebra k F]
    [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F] [FunctionField k F]
    (S : Finset (AlgebraicCurve.Place k F)),
    LocalFactorSpectrumWarnings (curvePlaceAdeleLevel k F S) (CurvePlaceLevelFactor k F S)
      (curvePlaceLevelFactorProjection k F S)

/-- Conrad's product-spectrum warnings, Moret-Bailly's example and both adelic levels. -/
def AdelicProductSpectrumWarningsStatement : Prop :=
  ProductFactorSpectrumStatement.{u} ∧ LocalProductSpectrumWarningsStatement.{u} ∧
    MoretBaillyDiagonalStatement.{u} ∧ NumberFieldLevelSpectrumWarningsStatement.{u} ∧
    CurvePlaceLevelSpectrumWarningsStatement.{u}

end Langlands.Global
