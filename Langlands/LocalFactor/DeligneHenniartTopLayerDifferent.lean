import Langlands.LocalFactor.DeligneHenniartTopLayerOrders
import Langlands.AnthropicFLT.Theorems.Thm_IsDiscreteValuationRing_exists_adjoin_singleton_eq_top_of_isSeparable_residueField

/-!
# Hilbert's formula for the different of a Galois extension of p-adic fields

For a finite Galois extension `M/K` of p-adic fields with arbitrary topological data, the
different of `O_M` over `O_K` is `m_M ^ d` with `d = Σ_{i < N} (|G_i| - 1)` for every `N` with
`G_N = 1` (Serre, *Local Fields*, IV §1, Proposition 4). The proof takes a generator `θ` of `O_M`
as an `O_K`-algebra, writes the different as the product of the `θ - σ θ` for `σ ≠ 1`, and
computes `ord_M(θ - σ θ)` as the number of lower groups containing `σ`.
-/

noncomputable section

namespace Langlands.LocalFactor.NonabelianSystem.DeligneHenniart.TopLayer

open IsLocalRing Ramification.Padic PadicField.TopologicalData

universe u w

variable {p : ℕ} [Fact p.Prime] {K : PadicField.{u} p} {M : PadicField.{w} p}
  [Algebra K.Carrier M.Carrier] [IsScalarTower (Padic p) K.Carrier M.Carrier]
  (TK : K.TopologicalData) (TM : M.TopologicalData)

/-- The number of lower groups `G_i`, `i < N`, containing `σ`. -/
def lowerDepth (N : ℕ) (σ : M.Carrier ≃ₐ[K.Carrier] M.Carrier) : ℕ :=
  letI : DecidablePred fun i => σ ∈ lowerRamificationGroup TM K.Carrier i :=
    fun _ => Classical.propDecidable _
  ((Finset.range N).filter fun i => σ ∈ lowerRamificationGroup TM K.Carrier i).card

/-- `Σ_{σ ≠ 1}` of the depths is `Σ_{i < N} (|G_i| - 1)`. -/
theorem sum_lowerDepth_erase_one [Fintype (M.Carrier ≃ₐ[K.Carrier] M.Carrier)]
    [DecidableEq (M.Carrier ≃ₐ[K.Carrier] M.Carrier)] (N : ℕ) :
    ∑ σ ∈ Finset.univ.erase (1 : M.Carrier ≃ₐ[K.Carrier] M.Carrier), lowerDepth TM N σ =
      ∑ i ∈ Finset.range N, (lowerGroupOrder TM K.Carrier i - 1) := by
  classical
  simp only [lowerDepth, Finset.card_filter]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← Finset.card_filter, Finset.filter_erase,
    Finset.card_erase_of_mem (Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      (lowerRamificationGroup TM K.Carrier i).one_mem⟩),
    lowerGroupOrder, Nat.card_eq_fintype_card, Fintype.card_subtype]

section Generator

variable {TK TM}

/-- If `θ` generates `O_M` over `O_K`, every `σ z - z` lies in the ideal generated by
`σ θ - θ`. -/
theorem sub_mem_span_of_adjoin_eq_top (θ : TM.Integers)
    (hθ : letI := relativeIntegerAlgebra TK TM; Algebra.adjoin TK.Integers {θ} = ⊤)
    (σ : M.Carrier ≃ₐ[K.Carrier] M.Carrier) (z : TM.Integers) :
    integerAutomorphism TM K.Carrier σ z - z ∈
      Ideal.span {integerAutomorphism TM K.Carrier σ θ - θ} := by
  let := relativeIntegerAlgebra TK TM
  have hz : z ∈ Algebra.adjoin TK.Integers {θ} := hθ ▸ Algebra.mem_top
  induction hz using Algebra.adjoin_induction with
  | mem y hy =>
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact Ideal.subset_span rfl
  | algebraMap a =>
    have : integerAutomorphism TM K.Carrier σ (algebraMap TK.Integers TM.Integers a) =
        algebraMap TK.Integers TM.Integers a :=
      Subtype.ext (σ.commutes (a : K.Carrier))
    rw [this, sub_self]
    exact Ideal.zero_mem _
  | add y w _ _ hy hw =>
    rw [map_add, add_sub_add_comm]
    exact Ideal.add_mem _ hy hw
  | mul y w _ _ hy hw =>
    have : integerAutomorphism TM K.Carrier σ (y * w) - y * w =
        integerAutomorphism TM K.Carrier σ y * (integerAutomorphism TM K.Carrier σ w - w) +
          (integerAutomorphism TM K.Carrier σ y - y) * w := by
      rw [map_mul]
      ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hw) (Ideal.mul_mem_right _ _ hy)

/-- For a generator `θ`, membership in `G_i` is tested on `θ` alone. -/
theorem mem_lowerRamificationGroup_iff_of_adjoin_eq_top (θ : TM.Integers)
    (hθ : letI := relativeIntegerAlgebra TK TM; Algebra.adjoin TK.Integers {θ} = ⊤)
    (σ : M.Carrier ≃ₐ[K.Carrier] M.Carrier) (i : ℕ) :
    σ ∈ lowerRamificationGroup TM K.Carrier i ↔
      integerAutomorphism TM K.Carrier σ θ - θ ∈ maximalIdeal TM.Integers ^ (i + 1) := by
  rw [Ramification.Padic.mem_lowerRamificationGroup]
  refine ⟨fun h => h θ, fun h z => ?_⟩
  exact (Ideal.span_singleton_le_iff_mem _).mpr h (sub_mem_span_of_adjoin_eq_top θ hθ σ z)

/-- For a generator `θ` and `σ ≠ 1`, the ideal of `θ - σ θ` is `m_M` to the depth of `σ`. -/
theorem span_sub_eq_maximalIdeal_pow_lowerDepth (θ : TM.Integers)
    (hθ : letI := relativeIntegerAlgebra TK TM; Algebra.adjoin TK.Integers {θ} = ⊤)
    {N : ℕ} (hN : lowerRamificationGroup TM K.Carrier N = ⊥)
    {σ : M.Carrier ≃ₐ[K.Carrier] M.Carrier} (hσ : σ ≠ 1) :
    Ideal.span {θ - integerAutomorphism TM K.Carrier σ θ} =
      maximalIdeal TM.Integers ^ lowerDepth TM N σ := by
  set δ := integerAutomorphism TM K.Carrier σ θ - θ with hδdef
  have key := mem_lowerRamificationGroup_iff_of_adjoin_eq_top θ hθ σ
  have hδ : (δ : M.Carrier) ≠ 0 := by
    intro h0
    have h0' : δ = 0 := Subtype.ext h0
    have hmem : σ ∈ lowerRamificationGroup TM K.Carrier N :=
      (key N).mpr (by rw [← hδdef, h0']; exact Ideal.zero_mem _)
    rw [hN] at hmem
    exact hσ (Subgroup.mem_bot.mp hmem)
  have hint : 0 ≤ TM.ord (δ : M.Carrier) := (TM.mem_integers_iff_zero_le_ord hδ).mp δ.property
  obtain ⟨d, hd⟩ : ∃ d : ℕ, (d : ℤ) = TM.ord (δ : M.Carrier) := ⟨_, Int.toNat_of_nonneg hint⟩
  have key' : ∀ i : ℕ, σ ∈ lowerRamificationGroup TM K.Carrier i ↔ i + 1 ≤ d := by
    intro i
    rw [key, ← hδdef, TM.mem_maximalIdeal_pow_iff_ord TM.uniformizer TM.ord_uniformizer, ← hd]
    simp only [hδ, false_or]
    omega
  have hdN : d ≤ N := by
    by_contra h
    have hmem : σ ∈ lowerRamificationGroup TM K.Carrier N := (key' N).mpr (by omega)
    rw [hN] at hmem
    exact hσ (Subgroup.mem_bot.mp hmem)
  have hdepth : lowerDepth TM N σ = d := by
    unfold lowerDepth
    convert Finset.card_range d using 2
    ext i
    simp only [Finset.mem_filter, Finset.mem_range, key']
    omega
  rw [hdepth, ← neg_sub, Ideal.span_singleton_neg]
  exact LocalClassField.span_singleton_eq_maximalIdeal_pow_of_ord TM δ hδ d hd.symm

end Generator

/-- Hilbert's formula: the different of `O_M/O_K` is `m_M ^ Σ_{i < N} (|G_i| - 1)` as soon as
`G_N = 1`. -/
theorem differentIdeal_eq_maximalIdeal_pow [FiniteDimensional K.Carrier M.Carrier]
    [IsGalois K.Carrier M.Carrier] {N : ℕ}
    (hN : lowerRamificationGroup TM K.Carrier N = ⊥) :
    letI := TK.topology
    letI := TK.valuativeRel
    letI := TK.localField
    letI := TM.topology
    letI := TM.valuativeRel
    letI := TM.localField
    letI := relativeIntegerAlgebra TK TM
    letI := relativeIntegerFieldAlgebra (E := M) TK
    haveI := relativeIntegerFieldTower (E := M) TK
    haveI := relativeIntegerTower TK TM
    haveI := relativeIntegerAlgebra_isTorsionFree TK TM
    differentIdeal TK.Integers TM.Integers =
      maximalIdeal TM.Integers ^ ∑ i ∈ Finset.range N, (lowerGroupOrder TM K.Carrier i - 1) := by
  let := TK.topology
  let := TK.valuativeRel
  let := TK.localField
  let := TM.topology
  let := TM.valuativeRel
  let := TM.localField
  let := relativeIntegerAlgebra TK TM
  let := relativeIntegerFieldAlgebra (E := M) TK
  have := relativeIntegerFieldTower (E := M) TK
  have := relativeIntegerTower TK TM
  have := relativeIntegerAlgebra_isTorsionFree TK TM
  have : IsLocalHom (algebraMap TK.Integers TM.Integers) := relativeIntegerMap_isLocalHom TK TM
  have := (LocalClassField.NYLL.relativeIntegerStructure p K M TK TM).2
  have : Finite (ResidueField TK.Integers) := TK.finite_residueField
  have : Finite (ResidueField TM.Integers) := TM.finite_residueField
  have : Algebra.IsSeparable (ResidueField TK.Integers) (ResidueField TM.Integers) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hinj : Function.Injective (algebraMap TK.Integers TM.Integers) := by
    intro a b h
    apply Subtype.ext
    exact (algebraMap K.Carrier M.Carrier).injective (congrArg Subtype.val h)
  obtain ⟨θ, hθ⟩ :=
    IsDiscreteValuationRing.exists_adjoin_singleton_eq_top_of_isSeparable_residueField
      (A := TK.Integers) (B := TM.Integers) hinj
  classical
  rw [LocalClassField.different_eq_span_prod_automorphisms_of_integer_adjoin TK TM θ hθ,
    ← Ideal.prod_span_singleton,
    Finset.prod_congr rfl (fun σ hσ => span_sub_eq_maximalIdeal_pow_lowerDepth θ hθ hN
      (Finset.ne_of_mem_erase hσ)),
    Finset.prod_pow_eq_pow_sum, sum_lowerDepth_erase_one]

end Langlands.LocalFactor.NonabelianSystem.DeligneHenniart.TopLayer
