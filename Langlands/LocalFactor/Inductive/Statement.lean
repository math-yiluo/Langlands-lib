import Langlands.ClassFieldTheory.Local.Transfer
import Langlands.HarmonicAnalysis.CharacterTransport
import Langlands.LocalFactor.Euler.Definitions
import Langlands.LocalFactor.Inductive.Definitions
import Langlands.Weil.Representation.Determinant
import Langlands.Weil.Representation.Invariants
import Mathlib.GroupTheory.Transfer

/-!
# Inductive functions of Weil representations: statements (Tate 1979, 2.3)

Statements only; no proofs are claimed. Gallagher's determinant formula (Deligne
1973, Proposition 1.2) is stated for an arbitrary group, field and finite-index
subgroup. The other clauses concern the actual local Weil groups of p-adic fields
and induction along the actual Weil maps, from
`Langlands.LocalFactor.Inductive.Definitions`.
-/

noncomputable section

namespace Langlands.LocalFactor.Inductive

universe u v uK uG uV

open FiniteRepresentation VirtualRepresentation Weil.Local

/-- Deligne 1973, Proposition 1.2 (Gallagher): for a finite-index subgroup `H` of a
group `G` and a finite-dimensional representation `V` of `H`,
`det (Ind V) = (det (Ind 1_H))^{dim V} · (det V ∘ transfer)`. Here `Ind` is the
Library's finite-index induction and the transfer is Mathlib's. -/
def GallagherDeterminantStatement : Prop :=
  ∀ (K : Type uK) [Field K] (G : Type uG) [Group G] (H : Subgroup G) [H.FiniteIndex]
    (A : FiniteRepresentation.{uK, uG, uV} K H),
    determinantCharacter (induce H A) =
      determinantCharacter (induce H (of (Representation.trivial K H K))) ^ A.rank *
        (determinantCharacter A).transfer

variable {p : ℕ} [Fact p.Prime]

/-- Tate 2.3.1 for every p-adic field `E`: `R(W_E)` is generated by the classes
`Ind_{E'/E}[χ]`, and `R⁰(W_E)` by the classes `Ind_{E'/E}([χ] - [χ'])`, for finite
extensions `E'` of `E` and quasi-characters `χ, χ'` of `W_{E'}`. -/
def GenerationStatement : Prop :=
  ∀ E : PadicField.{u} p,
    Submodule.span ℤ {x : Virtual E | ∃ (E' : PadicField.{u} p)
        (g : E.Carrier →ₐ[Padic p] E'.Carrier) (χ : localWeilGroup E' →ₜ* ℂˣ),
          x = virtualInduce E E' g (virtualClass E' (characterClass E' χ))} = ⊤ ∧
    Submodule.span ℤ {x : Virtual E | ∃ (E' : PadicField.{u} p)
        (g : E.Carrier →ₐ[Padic p] E'.Carrier) (χ χ' : localWeilGroup E' →ₜ* ℂˣ),
          x = virtualInduce E E' g
            (virtualClass E' (characterClass E' χ) - virtualClass E' (characterClass E' χ'))} =
      VirtualDegreeZero E

/-- Tate 3.3 and Deligne 1973, Proposition 3.8, for p-adic fields: the Euler factor of
Weil representations is inductive. For geometric Frobenius elements `Φ ∈ W_E` and
`Φ' ∈ W_{E'}` and a representation `V` of `W_{E'}`,
`det(1 - X Φ | (Ind_{E'/E} V)^{I_E}) = det(1 - X^f Φ' | V^{I_{E'}})`, with `f` the residue
degree of `E'/E`. Evaluated at `q_E^{-s}` and `q_{E'}^{-s}` respectively, the two Euler
polynomials agree for every `s`, so `L_E(Ind_{E'/E} V, s) = L_{E'}(V, s)`. -/
def EulerFactorInductionStatement : Prop :=
  ∀ (E E' : PadicField.{u} p) (g : E.Carrier →ₐ[Padic p] E'.Carrier)
    (A : FiniteRepresentation.{0, u, u} ℂ (localWeilGroup E')), A.IsContinuous →
    ∀ (Φ : localWeilGroup E) (Φ' : localWeilGroup E'),
      localDegreeInt E Φ = 1 → localDegreeInt E' Φ' = 1 →
      let B := induceAlong (extensionWeilMap E E' g).toMonoidHom
        (extensionWeilMap_injective E E' g) A
      let P := LocalFactor.eulerPolynomial ((invariants (localInertia E) B).representation Φ)
      let P' := LocalFactor.eulerPolynomial ((invariants (localInertia E') A).representation Φ')
      let logq : ℂ := Real.log (E.canonicalTopologicalData.residueCardinality : ℝ)
      let logq' : ℂ := Real.log (E'.canonicalTopologicalData.residueCardinality : ℝ)
      P = Polynomial.expand ℂ (extensionResidueDegree E E' g) P' ∧
        ∀ s : ℂ, P.eval (Complex.exp (-s * logq)) = P'.eval (Complex.exp (-s * logq'))

/-- The trace characters `ψ_E = ψ ∘ Tr_{E/F}` used in Tate (3.4.1) form a coherent family:
for embeddings `E → E' → E''`, `(ψ ∘ Tr_{E'/E}) ∘ Tr_{E''/E'} = ψ ∘ Tr_{E''/E}`, for the
Library's trace characters on the canonical topologies. -/
def TraceCharacterTowerStatement : Prop :=
  ∀ (E E' E'' : PadicField.{u} p) (g : E.Carrier →ₐ[Padic p] E'.Carrier)
    (h : E'.Carrier →ₐ[Padic p] E''.Carrier)
    (ψ : @HarmonicAnalysis.UnitaryAdditiveCharacter E.Carrier _
      E.canonicalTopologicalData.topology),
    letI := extensionAlgebra E E' g
    letI := extensionAlgebra E' E'' h
    letI := extensionAlgebra E E'' (h.comp g)
    haveI := extensionAlgebra_isScalarTower E E' g
    haveI := extensionAlgebra_isScalarTower E' E'' h
    haveI := extensionAlgebra_isScalarTower E E'' (h.comp g)
    E'.canonicalTopologicalData.traceCharacter E''.canonicalTopologicalData
        (E.canonicalTopologicalData.traceCharacter E'.canonicalTopologicalData ψ) =
      E.canonicalTopologicalData.traceCharacter E''.canonicalTopologicalData ψ

variable (F : PadicField.{u} p)

/-- Tate 2.3.3: a function inductive in degree zero over `F` is determined by its
values on the quasi-characters of `W_E`, for all finite extensions `E` of `F`. -/
def UniquenessStatement : Prop :=
  ∀ (X : Type v) [AddCommGroup X] (a b : ClassFunction F X),
    IsInductiveInDegreeZero F X a → IsInductiveInDegreeZero F X b →
      (∀ (E : Extension F) (χ : localWeilGroup E.field →ₜ* ℂˣ),
        a E (characterClass E.field χ) = b E (characterClass E.field χ)) → a = b

/-- Tate 2.3.4: let `r_E : E^× → W_E^{ab}` be homomorphisms into the topological
abelianizations (quotients by the closed commutator subgroups) that satisfy Tate's (W3)
for every tower `E'/E/F`: `t(r_E(x)) = r_{E'}(x)` for `x ∈ E^×`, with `t` the continuous
transfer `W_E^{ab} → W_{E'}^{ab}`. Fix `a ∈ F^×` and, for every extension `E`, an element
`w_E ∈ W_E` whose class in `W_E^{ab}` is `r_E(a)`. Then `λ(V) = (det V)(w_E)` is inductive
in degree zero over `F`. -/
def DeterminantExampleStatement : Prop :=
  ∀ (r : ∀ E : Extension F,
      E.field.Carrierˣ →* TopologicalAbelianization (localWeilGroup E.field)),
    (∀ (E E' : Extension F) (g : E.field.Carrier →ₐ[Padic p] E'.field.Carrier),
      IsTower E E' g → ∀ x : E.field.Carrierˣ,
        LocalClassField.abelianizationMap
            ((extensionWeilRangeEquiv E.field E'.field g).symm :
              extensionWeilRange E.field E'.field g →ₜ* localWeilGroup E'.field)
            (LocalClassField.abelianizedTransfer (extensionWeilRange E.field E'.field g)
              (extensionWeilMap_range_isOpen E.field E'.field g) (r E x)) =
          r E' (Units.map g.toRingHom.toMonoidHom x)) →
    ∀ (a : F.Carrierˣ) (w : ∀ E : Extension F, localWeilGroup E.field),
      (∀ E : Extension F,
        LocalClassField.abelianizationProjection (localWeilGroup E.field) (w E) =
          r E (Units.map E.embedding.toRingHom.toMonoidHom a)) →
      IsInductiveInDegreeZero F (Additive ℂˣ) fun E c =>
        Additive.ofMul
          (determinantCharacterClass (forgetPropertyClass (IsRepresentation E.field) c) (w E))

/-- The degree correction, a consequence of Tate's (2.3.2) applied to `[V] - dim V [1_{E'}]`:
for `λ` inductive in degree zero and `V ∈ M(W_{E'})`,
`λ(Ind_{E'/E} V) = λ(V) + dim V · (λ(Ind_{E'/E} 1_{E'}) - λ(1_{E'}))`, written additively. -/
def DegreeCorrectionStatement : Prop :=
  ∀ (X : Type v) [AddCommGroup X] (a : ClassFunction F X),
    IsInductiveInDegreeZero F X a →
      ∀ (E E' : Extension F) (g : E.field.Carrier →ₐ[Padic p] E'.field.Carrier),
        IsTower E E' g → ∀ c : Classes E'.field,
          a E (induceClass E.field E'.field g c) =
            a E' c + classRank (forgetPropertyClass (IsRepresentation E'.field) c) •
              (a E (induceClass E.field E'.field g (trivialClass E'.field)) -
                a E' (trivialClass E'.field))

/-- A function is inductive exactly when it is inductive in degree zero and
`λ(Ind_{E'/E} 1_{E'}) = λ(1_{E'})` for every tower `E'/E/F`. -/
def InductiveCharacterizationStatement : Prop :=
  ∀ (X : Type v) [AddCommGroup X] (a : ClassFunction F X),
    IsInductive F X a ↔ IsInductiveInDegreeZero F X a ∧
      ∀ (E E' : Extension F) (g : E.field.Carrier →ₐ[Padic p] E'.field.Carrier),
        IsTower E E' g →
          a E (induceClass E.field E'.field g (trivialClass E'.field)) =
            a E' (trivialClass E'.field)

/-- The row-10 statement: all the clauses above. -/
def InductiveFunctionsStatement : Prop :=
  GallagherDeterminantStatement.{uK, uG, uV} ∧ GenerationStatement.{u} (p := p) ∧
    EulerFactorInductionStatement.{u} (p := p) ∧ TraceCharacterTowerStatement.{u} (p := p) ∧
    UniquenessStatement.{u, v} F ∧ DeterminantExampleStatement F ∧
    DegreeCorrectionStatement.{u, v} F ∧ InductiveCharacterizationStatement.{u, v} F

end Langlands.LocalFactor.Inductive
