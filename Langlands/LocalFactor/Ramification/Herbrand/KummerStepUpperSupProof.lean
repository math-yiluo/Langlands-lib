/-!
# Upper ramification of a Kummer step over an arbitrary p-adic field

Compute the degree-prime radical filtration after adjoining roots of unity,
descend through the tame cyclotomic extension, and lift through finite
restriction to prove the absolute transitivity and strict upper-bound results.
-/

noncomputable section

namespace Langlands.Ramification.Kummer

open LocalClassField Polynomial

universe u v

variable {p : ℕ} [Fact p.Prime] (F : PadicField.{u} p)

/-- Natural powers multiply the normalized additive order, including at zero
under the Library's zero-order convention. -/
theorem ord_pow (x : F.Carrier) (n : ℕ) :
    F.canonicalTopologicalData.ord (x ^ n) =
      (n : ℤ) * F.canonicalTopologicalData.ord x :=
  Langlands.ClassFieldTheory.Local.UnramifiedBaseChange.ord_pow (K := F) x n

/-- A uniformizer cannot be a `p`-th power in the base. -/
theorem uniformizer_not_pow {ϖ : F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1) (x : F.Carrier) :
    x ^ p ≠ ϖ := by
  intro hx
  have h := congrArg F.canonicalTopologicalData.ord hx
  rw [ord_pow, hϖ] at h
  have hp : (p : ℤ) ∣ 1 := ⟨F.canonicalTopologicalData.ord x, h.symm⟩
  have hle : p ≤ 1 := Nat.le_of_dvd Nat.zero_lt_one (Int.natCast_dvd_natCast.mp hp)
  exact (not_le_of_gt (Fact.out : p.Prime).one_lt) hle

/-- An element of positive order prime to `p` cannot be a `p`-th power. -/
theorem coprime_ord_not_pow {ϖ : F.Carrier} {r : ℕ}
    (_hr : 0 < r) (hcop : r.Coprime p)
    (hϖ : F.canonicalTopologicalData.ord ϖ = r) (x : F.Carrier) :
    x ^ p ≠ ϖ := by
  intro hx
  have h := congrArg F.canonicalTopologicalData.ord hx
  rw [ord_pow, hϖ] at h
  have hp : p ∣ r :=
    Int.natCast_dvd_natCast.mp ⟨F.canonicalTopologicalData.ord x, h.symm⟩
  have hdiv : p ∣ 1 := by
    simpa only [hcop.gcd_eq_one] using Nat.dvd_gcd hp (dvd_refl p)
  exact (Fact.out : p.Prime).not_dvd_one hdiv

/-- The radical polynomial of a uniformizer is irreducible without a
root-of-unity assumption on the base. -/
theorem kummerStep_polynomial_irreducible {ϖ : F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1) :
    Irreducible (X ^ p - C ϖ) :=
  X_pow_sub_C_irreducible_of_prime (Fact.out : p.Prime)
    (uniformizer_not_pow F hϖ)

/-- The minimal polynomial of the specified root is exactly its radical
polynomial. -/
theorem kummerStep_minpoly {ϖ : F.Carrier} {α : AlgebraicClosure F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hα : α ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ) :
    minpoly F.Carrier α = X ^ p - C ϖ := by
  symm
  apply minpoly.eq_of_irreducible_of_monic
    (kummerStep_polynomial_irreducible F hϖ)
  · simpa only [map_sub, map_pow, aeval_X, aeval_C] using sub_eq_zero.mpr hα
  · exact monic_X_pow_sub_C ϖ (Fact.out : p.Prime).ne_zero

/-- The actual intermediate field generated by the specified root has degree
`p`, including when the extension is not normal. -/
theorem kummerStep_finrank {ϖ : F.Carrier} {α : AlgebraicClosure F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hα : α ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ) :
    Module.finrank F.Carrier (adjoinFiniteIntermediate F α).field = p := by
  change Module.finrank F.Carrier (IntermediateField.adjoin F.Carrier {α}) = p
  rw [IntermediateField.adjoin.finrank (Algebra.IsIntegral.isIntegral α),
    kummerStep_minpoly F hϖ hα,
    natDegree_X_pow_sub_C]

/-- A degree-`p` radical of a uniformizer is a uniformizer, and the extension
has relative residue degree one. This calculation uses the canonical orders
and the relative degree identity, without a normality hypothesis. -/
theorem uniformizer_radical_arithmetic (L : PadicField.{v} p)
    [Algebra F.Carrier L.Carrier] [IsScalarTower (Padic p) F.Carrier L.Carrier]
    [FiniteDimensional F.Carrier L.Carrier]
    {ϖ : F.Carrier} {β : L.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p) :
    L.canonicalTopologicalData.ord β = 1 ∧
      L.canonicalTopologicalData.ramificationIndex =
        p * F.canonicalTopologicalData.ramificationIndex ∧
      Weil.Local.extensionResidueDegree F L
        (IsScalarTower.toAlgHom (Padic p) F.Carrier L.Carrier) = 1 := by
  let T := F.canonicalTopologicalData
  let S := L.canonicalTopologicalData
  let f := IsScalarTower.toAlgHom (Padic p) F.Carrier L.Carrier
  let d := Weil.Local.extensionResidueDegree F L f
  have ho := ramificationIndex_mul_ord_relative_algebraMap F L T S ϖ
  rw [← hβ, ord_pow, hϖ, mul_one] at ho
  have he : S.ramificationIndex * d = p * T.ramificationIndex := by
    have h := PadicField.ramificationIndex_mul_extensionResidueDegree F L f
    have ha : Weil.Local.extensionAlgebra F L f =
        (inferInstance : Algebra F.Carrier L.Carrier) := toAlgebra_algebraMap
    unfold Weil.Local.extensionDegree at h
    rw [ha, hd] at h
    exact h
  have hT : (0 : ℤ) < T.ramificationIndex := by exact_mod_cast T.ramificationIndex_pos
  have hS : (0 : ℤ) < S.ramificationIndex := by exact_mod_cast S.ramificationIndex_pos
  have hp : (0 : ℤ) < p := by exact_mod_cast (Fact.out : p.Prime).pos
  have hdpos : (0 : ℤ) < d := by
    exact_mod_cast Weil.Local.extensionResidueDegree_pos F L f
  have hbpos : 0 < S.ord β := by
    have hmul : 0 < (T.ramificationIndex : ℤ) * ((p : ℤ) * S.ord β) := by
      rw [ho]
      exact hS
    exact (mul_pos_iff_of_pos_left hp).mp ((mul_pos_iff_of_pos_left hT).mp hmul)
  have hprod : S.ord β * (d : ℤ) = 1 := by
    apply mul_left_cancel₀ (show (T.ramificationIndex : ℤ) * p ≠ 0 by positivity)
    calc
      (T.ramificationIndex : ℤ) * p * (S.ord β * d) =
          S.ramificationIndex * (d : ℤ) := by rw [← ho]; ring
      _ = p * (T.ramificationIndex : ℤ) := by exact_mod_cast he
      _ = (T.ramificationIndex : ℤ) * p * 1 := by ring
  have hb : S.ord β = 1 := by
    have : (1 : ℤ) ≤ d := hdpos
    nlinarith
  have hf : d = 1 := by
    rw [hb, one_mul] at hprod
    exact_mod_cast hprod
  refine ⟨hb, ?_, hf⟩
  rw [hb, mul_one] at ho
  exact_mod_cast ho.symm.trans (mul_comm _ _)

/-- The specified radical is a uniformizer of its actual simple intermediate
field, whose absolute ramification index is multiplied by `p`. -/
theorem kummerStep_root_ord_and_ramificationIndex
    {ϖ : F.Carrier} {α : AlgebraicClosure F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hα : α ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ) :
    let L := (adjoinFiniteIntermediate F α).asPadicField (p := p)
    L.canonicalTopologicalData.ord (IntermediateField.AdjoinSimple.gen F.Carrier α) = 1 ∧
      L.canonicalTopologicalData.ramificationIndex =
        p * F.canonicalTopologicalData.ramificationIndex := by
  let L := (adjoinFiniteIntermediate F α).asPadicField (p := p)
  let := L.algebra
  let : IsScalarTower (Padic p) F.Carrier L.Carrier :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hβ : (IntermediateField.AdjoinSimple.gen F.Carrier α : L.Carrier) ^ p =
      algebraMap F.Carrier L.Carrier ϖ := by
    apply Subtype.ext
    exact hα
  have h := uniformizer_radical_arithmetic F L hϖ hβ (kummerStep_finrank F hϖ hα)
  exact ⟨h.1, h.2.1⟩

/-- Associated elements of the actual canonical integer ring have the same
normalized order, with the Library's convention also covering zero. -/
theorem ord_integer_associated
    {x y : F.canonicalTopologicalData.Integers} (h : Associated x y) :
    F.canonicalTopologicalData.ord (x : F.Carrier) =
      F.canonicalTopologicalData.ord (y : F.Carrier) := by
  let T := F.canonicalTopologicalData
  let := T.topology
  let := T.valuativeRel
  let := T.localField
  obtain ⟨a, ha⟩ := h
  have hu : ValuativeRel.valuation F.Carrier ((a : T.Integers) : F.Carrier) = 1 :=
    (Valuation.Integers.isUnit_iff_valuation_eq_one
      (Valuation.integer.integers (ValuativeRel.valuation F.Carrier))).mp a.isUnit
  have hd : T.discreteValuation ((a : T.Integers) : F.Carrier) = 1 := by
    change (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F.Carrier)
      ((ValuativeRel.valuation F.Carrier) ((a : T.Integers) : F.Carrier)) = 1
    rw [hu, map_one]
  change -WithZero.log (T.discreteValuation (x : F.Carrier)) =
    -WithZero.log (T.discreteValuation (y : F.Carrier))
  rw [← ha, Subring.coe_mul, map_mul, hd, mul_one]

/-- The cyclotomic displacement has its exact canonical order. The proof
multiplies the differences of the prime-order roots in the actual integer
ring, where the cyclotomic-unit identities show they are associated. -/
theorem ord_primitiveRoot_sub_one {ζ : F.Carrier} (hζ : IsPrimitiveRoot ζ p) :
    ((p : ℤ) - 1) * F.canonicalTopologicalData.ord (ζ - 1) =
      F.canonicalTopologicalData.ramificationIndex := by
  let T := F.canonicalTopologicalData
  have hp := (Fact.out : p.Prime)
  have hzord : T.ord ζ = 0 := by
    have h := congrArg T.ord hζ.pow_eq_one
    rw [ord_pow, T.ord_one] at h
    exact (mul_eq_zero.mp h).resolve_left (by exact_mod_cast hp.ne_zero)
  have hzmem : ζ ∈ T.Integers :=
    (T.mem_integers_iff_zero_le_ord (hζ.ne_zero hp.ne_zero)).mpr hzord.ge
  let z : T.Integers := ⟨ζ, hzmem⟩
  have hz : IsPrimitiveRoot z p :=
    hζ.of_map_of_injective (f := T.Integers.subtype) Subtype.val_injective
  have hp' : p - 1 + 1 = p := Nat.sub_add_cancel hp.one_le
  have hz' : IsPrimitiveRoot z (p - 1 + 1) := by rw [hp']; exact hz
  have hprod : ∏ k ∈ Finset.range (p - 1), (1 - z ^ (k + 1)) = (p : T.Integers) := by
    exact hz'.prod_one_sub_pow_eq_order.trans
      (by simpa only [Nat.cast_add, Nat.cast_one] using
        congrArg (fun n : ℕ => (n : T.Integers)) hp')
  have hassoc : Associated ((z - 1) ^ (p - 1)) (p : T.Integers) := by
    have h := Associated.prod (Finset.range (p - 1)) (fun _ => z - 1)
      (fun k => 1 - z ^ (k + 1)) (fun k hk => by
        have hk' : k + 1 < p := by have := Finset.mem_range.mp hk; omega
        simpa only [neg_sub] using
          (hz.associated_sub_one_pow_sub_one_of_coprime
            (Nat.coprime_of_lt_prime (Nat.succ_ne_zero k) hk' hp).symm).neg_right)
    simpa only [Finset.prod_const, Finset.card_range, hprod] using h
  have h := ord_integer_associated F hassoc
  change T.ord ((ζ - 1) ^ (p - 1)) = T.ord (p : F.Carrier) at h
  rw [ord_pow, ← T.ramificationIndex_cast, Nat.cast_sub hp.one_le, Nat.cast_one] at h
  exact h

/-- Distinct roots of one nonzero prime-degree radical differ by a primitive
root of unity. -/
theorem radical_ratio_primitive {β γ : F.Carrier} (hβ : β ≠ 0)
    (hpow : γ ^ p = β ^ p) (hne : γ ≠ β) :
    IsPrimitiveRoot (γ / β) p := by
  apply isPrimitiveRoot_of_mem_nthRootsFinset (Fact.out : p.Prime)
  · rw [Polynomial.mem_nthRootsFinset (Fact.out : p.Prime).pos, div_pow, hpow]
    exact div_self (pow_ne_zero p hβ)
  · exact fun h => hne ((div_eq_one_iff_eq hβ).mp h)

/-- The exact distance between distinct radical roots, in the actual canonical
order. This also applies when the radical is not a uniformizer. -/
theorem ord_radical_sub {β γ : F.Carrier} (hβ : β ≠ 0)
    (hpow : γ ^ p = β ^ p) (hne : γ ≠ β) :
    ((p : ℤ) - 1) * F.canonicalTopologicalData.ord (γ - β) =
      F.canonicalTopologicalData.ramificationIndex +
        ((p : ℤ) - 1) * F.canonicalTopologicalData.ord β := by
  let T := F.canonicalTopologicalData
  have h := ord_primitiveRoot_sub_one F (radical_ratio_primitive F hβ hpow hne)
  have hquot : γ / β - 1 ≠ 0 := by
    rw [sub_ne_zero, ne_eq, div_eq_one_iff_eq hβ]
    exact hne
  have heq : γ - β = (γ / β - 1) * β := by
    field_simp
  rw [heq, T.ord_mul hquot hβ]
  linarith

/-- Positivity of the proposed upper break. -/
theorem kummerBreak_pos : 0 < kummerBreak F := by
  unfold kummerBreak
  have hp : (1 : ℝ) < p := by exact_mod_cast (Fact.out : p.Prime).one_lt
  have he : (0 : ℝ) < F.canonicalTopologicalData.ramificationIndex := by
    exact_mod_cast F.canonicalTopologicalData.ramificationIndex_pos
  positivity

section FiniteRadical

variable (L : PadicField.{v} p)
  [Algebra F.Carrier L.Carrier] [IsScalarTower (Padic p) F.Carrier L.Carrier]

/-- The uniformizer test and the cyclotomic distance formula give the exact
lower-group test on a radical uniformizer. -/
theorem mem_lowerRamificationGroup_radical
    (hsurj : Function.Surjective (PadicField.TopologicalData.relativeResidueMap
      F.canonicalTopologicalData L.canonicalTopologicalData))
    {ϖ : F.Carrier} {β : L.Carrier}
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hord : L.canonicalTopologicalData.ord β = 1)
    (σ : L.Carrier ≃ₐ[F.Carrier] L.Carrier) (i : ℕ) :
    σ ∈ Padic.lowerRamificationGroup L.canonicalTopologicalData F.Carrier i ↔
      σ β = β ∨
        ((p : ℤ) - 1) * i ≤ L.canonicalTopologicalData.ramificationIndex := by
  let T := L.canonicalTopologicalData
  rw [Padic.mem_lowerRamificationGroup_iff_uniformizer
    F.canonicalTopologicalData T hsurj β hord σ i, sub_eq_zero]
  by_cases hσ : σ β = β
  · simp only [hσ, true_or]
  · simp only [hσ, false_or]
    have hp : (0 : ℤ) < (p : ℤ) - 1 := by
      have := (Fact.out : p.Prime).one_lt
      omega
    have hd := ord_radical_sub L (T.coordinateUniformizer_ne_zero β hord)
      (show (σ β) ^ p = β ^ p by rw [← map_pow, hβ, σ.commutes]) hσ
    rw [hord] at hd
    constructor
    · intro hi
      nlinarith
    · intro hi
      nlinarith

/-- Residue degree one gives the surjectivity required by the uniformizer test. -/
theorem relativeResidueMap_surjective_of_degree_one
    (hres : Weil.Local.extensionResidueDegree F L
      (IsScalarTower.toAlgHom (Padic p) F.Carrier L.Carrier) = 1) :
    Function.Surjective (PadicField.TopologicalData.relativeResidueMap
      F.canonicalTopologicalData L.canonicalTopologicalData) := by
  let f := IsScalarTower.toAlgHom (Padic p) F.Carrier L.Carrier
  let := Weil.Local.extensionResidueAlgebra F L f
  rw [PadicField.TopologicalData.relativeResidueMap_canonical]
  intro x
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero'
    (1 : L.canonicalTopologicalData.ResidueField) one_ne_zero).mp hres x
  refine ⟨c, ?_⟩
  change (algebraMap F.canonicalTopologicalData.ResidueField
    L.canonicalTopologicalData.ResidueField) c = x
  simpa only [Algebra.smul_def, mul_one] using hc

variable [FiniteDimensional F.Carrier L.Carrier]

omit [IsScalarTower (Padic p) F.Carrier L.Carrier] in
/-- In a degree-`p` extension, every radical of a base uniformizer generates
the entire extension. -/
theorem adjoin_radical_eq_top
    {ϖ : F.Carrier} {β : L.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p) :
    Algebra.adjoin F.Carrier {β} = ⊤ := by
  have hm : minpoly F.Carrier β = X ^ p - C ϖ := by
    symm
    apply minpoly.eq_of_irreducible_of_monic
      (kummerStep_polynomial_irreducible F hϖ)
    · simpa only [map_sub, map_pow, aeval_X, aeval_C] using sub_eq_zero.mpr hβ
    · exact monic_X_pow_sub_C ϖ (Fact.out : p.Prime).ne_zero
  apply Subalgebra.toSubmodule_injective
  apply Submodule.eq_top_of_finrank_eq
  change Module.finrank F.Carrier (Algebra.adjoin F.Carrier {β}) = _
  rw [(Algebra.adjoin.powerBasis (Algebra.IsIntegral.isIntegral β)).finrank,
    Algebra.adjoin.powerBasis_dim, hm, natDegree_X_pow_sub_C, hd]

omit [IsScalarTower (Padic p) F.Carrier L.Carrier] in
/-- A radical whose radicand has order prime to `p` can be replaced by a
radical uniformizer using Bezout powers. -/
theorem exists_uniformizer_radical_generator
    {ϖ : F.Carrier} {β : L.Carrier} {r : ℕ}
    (hr : 0 < r) (hcop : r.Coprime p)
    (hϖ : F.canonicalTopologicalData.ord ϖ = r)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p) :
    ∃ (ϖ' : F.Carrier) (δ : L.Carrier),
      F.canonicalTopologicalData.ord ϖ' = 1 ∧
      δ ^ p = algebraMap F.Carrier L.Carrier ϖ' ∧
      Algebra.adjoin F.Carrier {δ} = ⊤ := by
  let T := F.canonicalTopologicalData
  let a := Nat.gcdA r p
  let b := Nat.gcdB r p
  have hab : (r : ℤ) * a + (p : ℤ) * b = 1 := by
    rw [← Nat.gcd_eq_gcd_ab, hcop.gcd_eq_one, Nat.cast_one]
  have hϖ0 : ϖ ≠ 0 := by
    intro h
    rw [h, T.ord_zero] at hϖ
    have : r = 0 := by exact_mod_cast hϖ.symm
    omega
  have hη0 : T.uniformizer ≠ 0 :=
    T.coordinateUniformizer_ne_zero _ T.ord_uniformizer
  let ϖ' := ϖ ^ a * T.uniformizer ^ ((p : ℤ) * b)
  let δ := β ^ a * (algebraMap F.Carrier L.Carrier T.uniformizer) ^ b
  have ho : T.ord ϖ' = 1 := by
    rw [T.ord_mul (zpow_ne_zero _ hϖ0) (zpow_ne_zero _ hη0), T.ord_zpow,
      T.ord_zpow, hϖ, T.ord_uniformizer]
    dsimp [a, b] at *
    linarith
  have hδ : δ ^ p = algebraMap F.Carrier L.Carrier ϖ' := by
    dsimp [δ, ϖ']
    rw [mul_pow, ← zpow_natCast (β ^ a), ← zpow_mul, mul_comm a,
      zpow_mul, zpow_natCast, hβ, map_mul, map_zpow₀, map_zpow₀]
    congr 1
    rw [← zpow_natCast, ← zpow_mul, mul_comm]
  exact ⟨ϖ', δ, ho, hδ, adjoin_radical_eq_top F L ho hδ hd⟩

omit [IsScalarTower (Padic p) F.Carrier L.Carrier] in
/-- An automorphism fixing the radical generator is the identity. -/
theorem aut_eq_one_of_radical_fixed {β : L.Carrier}
    (hgen : Algebra.adjoin F.Carrier {β} = ⊤)
    {σ : L.Carrier ≃ₐ[F.Carrier] L.Carrier} (hσ : σ β = β) : σ = 1 := by
  let pb := PowerBasis.ofAdjoinEqTop (Algebra.IsIntegral.isIntegral β) hgen
  apply AlgEquiv.ext
  intro x
  exact congrArg (fun f : L.Carrier →ₐ[F.Carrier] L.Carrier => f x)
    (pb.algHom_ext (f := σ.toAlgHom) (g := (1 : L.Carrier ≃ₐ[F.Carrier] L.Carrier).toAlgHom)
      (by simpa [pb] using hσ))

/-- Exact lower filtration of a degree-`p` radical step which is Galois.
The arithmetic inequality avoids choosing a break in advance. -/
theorem lowerRamificationGroup_radical_pattern
    {ϖ : F.Carrier} {β : L.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p)
    (hgen : Algebra.adjoin F.Carrier {β} = ⊤) (i : ℕ) :
    Padic.lowerRamificationGroup L.canonicalTopologicalData F.Carrier i =
      if ((p : ℤ) - 1) * i ≤ L.canonicalTopologicalData.ramificationIndex
        then ⊤ else ⊥ := by
  obtain ⟨hord, _, hres⟩ := uniformizer_radical_arithmetic F L hϖ hβ hd
  have hsurj := relativeResidueMap_surjective_of_degree_one F L hres
  ext σ
  rw [mem_lowerRamificationGroup_radical F L hsurj hβ hord]
  split_ifs with hi
  · simp only [hi, or_true, Subgroup.mem_top]
  · simp only [hi, or_false, Subgroup.mem_bot]
    exact ⟨aut_eq_one_of_radical_fixed F L hgen, fun h => by rw [h]; rfl⟩

variable [IsGalois F.Carrier L.Carrier]

/-- A Galois radical step has a natural lower break equal to the stated real
Kummer break, and its actual lower groups have that single-break profile. -/
theorem galois_radical_lower_break
    {ϖ : F.Carrier} {β : L.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p)
    (hgen : Algebra.adjoin F.Carrier {β} = ⊤) :
    ∃ t : ℕ, (t : ℝ) = kummerBreak F ∧
      ∀ i : ℕ, Padic.lowerRamificationGroup L.canonicalTopologicalData F.Carrier i =
        if i ≤ t then ⊤ else ⊥ := by
  have hcard : Nat.card (L.Carrier ≃ₐ[F.Carrier] L.Carrier) = p := by
    rw [IsGalois.card_aut_eq_finrank, hd]
  have : Nontrivial (L.Carrier ≃ₐ[F.Carrier] L.Carrier) :=
    Finite.one_lt_card_iff_nontrivial.mp (by rw [hcard]; exact (Fact.out : p.Prime).one_lt)
  obtain ⟨σ, hσ⟩ := exists_ne (1 : L.Carrier ≃ₐ[F.Carrier] L.Carrier)
  obtain ⟨hord, he, _⟩ := uniformizer_radical_arithmetic F L hϖ hβ hd
  have hfix : σ β ≠ β := fun h => hσ (aut_eq_one_of_radical_fixed F L hgen h)
  have hz := radical_ratio_primitive L
    (L.canonicalTopologicalData.coordinateUniformizer_ne_zero β hord)
    (show (σ β) ^ p = β ^ p by rw [← map_pow, hβ, σ.commutes]) hfix
  have h := ord_primitiveRoot_sub_one L hz
  have hp : (0 : ℤ) < (p : ℤ) - 1 := by
    have := (Fact.out : p.Prime).one_lt
    omega
  have hepos : (0 : ℤ) < L.canonicalTopologicalData.ramificationIndex := by
    exact_mod_cast L.canonicalTopologicalData.ramificationIndex_pos
  have ho : 0 ≤ L.canonicalTopologicalData.ord (σ β / β - 1) := by
    nlinarith
  let t := (L.canonicalTopologicalData.ord (σ β / β - 1)).toNat
  have ht : ((p : ℤ) - 1) * (t : ℤ) = L.canonicalTopologicalData.ramificationIndex := by
    simpa only [t, Int.toNat_of_nonneg ho] using h
  refine ⟨t, ?_, fun i => ?_⟩
  · unfold kummerBreak
    apply (eq_div_iff (show (p : ℝ) - 1 ≠ 0 by exact_mod_cast ne_of_gt hp)).mpr
    have ht' : ((p : ℝ) - 1) * t = L.canonicalTopologicalData.ramificationIndex := by
      exact_mod_cast ht
    rw [he] at ht'
    push_cast at ht'
    linarith
  · rw [lowerRamificationGroup_radical_pattern F L hϖ hβ hd hgen]
    have hi : ((p : ℤ) - 1) * (i : ℤ) ≤
        L.canonicalTopologicalData.ramificationIndex ↔ i ≤ t := by
      rw [← ht, mul_le_mul_iff_right₀ hp]
      exact_mod_cast Iff.rfl
    simp only [hi]

/-- The upper filtration of a Galois radical step is the whole group through
the Kummer break and trivial at every strictly greater real index. -/
theorem galois_radical_upper_pattern
    {ϖ : F.Carrier} {β : L.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p)
    (hgen : Algebra.adjoin F.Carrier {β} = ⊤) (x : ℝ) :
    Padic.upperRamificationGroup L.canonicalTopologicalData F.Carrier x =
      if x ≤ kummerBreak F then ⊤ else ⊥ := by
  obtain ⟨t, ht, hpat⟩ := galois_radical_lower_break F L hϖ hβ hd hgen
  have hpsi : Padic.herbrandPsi L.canonicalTopologicalData F.Carrier (t : ℝ) = t := by
    simpa only [le_refl, ite_true] using
      herbrandPsi_nat_of_prime_pattern F L L.canonicalTopologicalData
        (by rw [hd]; exact Fact.out) t hpat t
  have hat : Padic.upperRamificationGroup L.canonicalTopologicalData
      F.Carrier (t : ℝ) = ⊤ := by
    rw [Padic.upperRamificationGroup, hpsi, Padic.lowerRamificationGroupReal_nat,
      hpat t, ite_eq_left le_rfl]
  split_ifs with hx
  · apply top_le_iff.mp
    rw [← hat]
    exact Padic.upperRamificationGroup_antitone _ _ (hx.trans_eq ht.symm)
  · have htx : (t : ℝ) < x := by rw [ht]; exact lt_of_not_ge hx
    have hp : (t : ℝ) < Padic.herbrandPsi L.canonicalTopologicalData F.Carrier x := by
      rw [← hpsi]
      exact Padic.herbrandPsi_strictMono _ _ htx
    have hp0 : 0 ≤ Padic.herbrandPsi L.canonicalTopologicalData F.Carrier x :=
      (Nat.cast_nonneg t).trans hp.le
    rw [Padic.upperRamificationGroup,
      HerbrandBridge.lowerRamificationGroupReal_of_ceil_eq
        _ _ (Int.natCast_ceil_eq_ceil hp0).symm, hpat]
    apply ite_eq_right
    have hn := hp.trans_le (Nat.le_ceil
      (Padic.herbrandPsi L.canonicalTopologicalData F.Carrier x))
    exact not_le_of_gt (by exact_mod_cast hn)

/-- The same upper profile applies to any positive radicand order prime to
the radical degree. -/
theorem galois_coprime_radical_upper_pattern
    {ϖ : F.Carrier} {β : L.Carrier} {r : ℕ}
    (hr : 0 < r) (hcop : r.Coprime p)
    (hϖ : F.canonicalTopologicalData.ord ϖ = r)
    (hβ : β ^ p = algebraMap F.Carrier L.Carrier ϖ)
    (hd : Module.finrank F.Carrier L.Carrier = p) (x : ℝ) :
    Padic.upperRamificationGroup L.canonicalTopologicalData F.Carrier x =
      if x ≤ kummerBreak F then ⊤ else ⊥ := by
  obtain ⟨ϖ', δ, hϖ', hδ, hgen⟩ :=
    exists_uniformizer_radical_generator F L hr hcop hϖ hβ hd
  exact galois_radical_upper_pattern F L hϖ' hδ hd hgen x

/-- A finite Galois extension of degree prime to the residue characteristic
has no positive lower ramification groups. -/
theorem lowerRamificationGroup_eq_bot_of_coprime_degree
    (hcop : (Module.finrank F.Carrier L.Carrier).Coprime p)
    {i : ℕ} (hi : 1 ≤ i) :
    Padic.lowerRamificationGroup L.canonicalTopologicalData F.Carrier i = ⊥ := by
  let T := L.canonicalTopologicalData
  let := Padic.integerAction T F.Carrier
  let G := L.Carrier ≃ₐ[F.Carrier] L.Carrier
  let H := Padic.lowerRamificationGroup T F.Carrier 1
  have hcard : (Nat.card H).Coprime p :=
    (hcop.of_dvd_left (by
      rw [← IsGalois.card_aut_eq_finrank]
      exact Subgroup.card_subgroup_dvd_card H))
  let := T.residueCharP
  have hpm : (p : T.Integers) ∈ IsLocalRing.maximalIdeal T.Integers := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact CharP.cast_eq_zero T.ResidueField p
  have hall : ∀ k : ℕ, H ≤ Padic.lowerRamificationGroup T F.Carrier (k + 1) := by
    intro k
    induction k with
    | zero => exact le_rfl
    | succ k ih =>
      intro g hg
      obtain ⟨h, hh⟩ := (powCoprime hcard).surjective (⟨g, hg⟩ : H)
      have heq : (h : G) ^ p = g := congrArg Subtype.val hh
      rw [← heq]
      exact _root_.Langlands.Ramification.pow_mem_lowerGroup_succ_of_natCast_mem
        (by omega) hpm (ih h.2)
  obtain ⟨b, hb⟩ := Padic.exists_lowerRamificationGroup_eq_bot T F.Carrier
  have hH : H = ⊥ := by
    apply le_bot_iff.mp
    exact (hall b).trans (le_of_eq (hb (b + 1) (by omega)))
  exact le_bot_iff.mp ((Padic.lowerRamificationGroup_antitone T F.Carrier hi).trans
    (le_of_eq hH))

/-- For a tame Galois extension the positive Herbrand function is division
by the inertia order. -/
theorem herbrandPhi_of_coprime_degree
    (hcop : (Module.finrank F.Carrier L.Carrier).Coprime p)
    {x : ℝ} (hx : 0 ≤ x) :
    Padic.herbrandPhi L.canonicalTopologicalData F.Carrier x =
      x / Padic.lowerGroupOrder L.canonicalTopologicalData F.Carrier 0 := by
  have horder : ∀ i : ℕ,
      Padic.lowerGroupOrder L.canonicalTopologicalData F.Carrier (i + 1) = 1 := by
    intro i
    unfold Padic.lowerGroupOrder
    rw [lowerRamificationGroup_eq_bot_of_coprime_degree F L hcop (by omega)]
    simp
  rw [Padic.herbrandPhi_floor _ _ hx]
  simp only [horder, Nat.cast_one, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
    mul_one, add_sub_cancel]

/-- The tame Herbrand function carries the Kummer break of the upper field
to the Kummer break of the base. -/
theorem herbrandPhi_kummerBreak_of_coprime_degree
    (hcop : (Module.finrank F.Carrier L.Carrier).Coprime p) :
    Padic.herbrandPhi L.canonicalTopologicalData F.Carrier (kummerBreak L) =
      kummerBreak F := by
  rw [herbrandPhi_of_coprime_degree F L hcop (kummerBreak_pos L).le]
  have he := _root_.Langlands.LocalFactor.NonabelianSystem.DeligneHenniart.TopLayer.lowerGroupOrder_zero_mul_ramificationIndex
      F.canonicalTopologicalData L.canonicalTopologicalData
  have hi : (Padic.lowerGroupOrder L.canonicalTopologicalData F.Carrier 0 : ℝ) ≠ 0 :=
    by exact_mod_cast ne_of_gt (Padic.lowerGroupOrder_pos _ _ _)
  unfold kummerBreak
  rw [← he]
  push_cast
  field_simp

end FiniteRadical

section TameDescent

variable (N : PadicField.{u} p) (M : PadicField.{v} p)
  [Algebra F.Carrier N.Carrier] [Algebra F.Carrier M.Carrier]
  [Algebra N.Carrier M.Carrier]
  [IsScalarTower (Padic p) F.Carrier N.Carrier]
  [IsScalarTower (Padic p) F.Carrier M.Carrier]
  [IsScalarTower (Padic p) N.Carrier M.Carrier]
  [IsScalarTower F.Carrier N.Carrier M.Carrier]
  [FiniteDimensional F.Carrier N.Carrier] [FiniteDimensional F.Carrier M.Carrier]
  [FiniteDimensional N.Carrier M.Carrier]
  [IsGalois F.Carrier N.Carrier] [IsGalois F.Carrier M.Carrier]
  [IsGalois N.Carrier M.Carrier]

omit [FiniteDimensional F.Carrier N.Carrier] [FiniteDimensional F.Carrier M.Carrier]
  [FiniteDimensional N.Carrier M.Carrier] in
/-- In a tame tower the relative subgroup index is the inverse Herbrand
function of the tame step. -/
theorem tame_tower_relative_index (x : ℝ) :
    Padic.herbrandPhi M.canonicalTopologicalData N.Carrier
        (Padic.herbrandPsi M.canonicalTopologicalData F.Carrier x) =
      Padic.herbrandPsi N.canonicalTopologicalData F.Carrier x := by
  rw [HerbrandBridge.herbrandPsi_tower F M N M.canonicalTopologicalData
    N.canonicalTopologicalData, Padic.herbrandPhi_herbrandPsi]

omit [FiniteDimensional F.Carrier M.Carrier] [FiniteDimensional N.Carrier M.Carrier] in
/-- All automorphisms over the tame cyclotomic step lie in the upper group
at the base Kummer break. -/
theorem restrictScalars_mem_upper_at_kummerBreak
    (hcop : (Module.finrank F.Carrier N.Carrier).Coprime p)
    (hpat : ∀ x : ℝ, Padic.upperRamificationGroup M.canonicalTopologicalData N.Carrier x =
      if x ≤ kummerBreak N then ⊤ else ⊥)
    (σ : Gal(M.Carrier/N.Carrier)) :
    σ.restrictScalars F.Carrier ∈
      Padic.upperRamificationGroup M.canonicalTopologicalData F.Carrier (kummerBreak F) := by
  rw [HerbrandBridge.restrictScalars_mem_upperRamificationGroup_iff,
    tame_tower_relative_index F N M,
    ← herbrandPhi_kummerBreak_of_coprime_degree F N hcop,
    Padic.herbrandPsi_herbrandPhi, hpat, ite_eq_left le_rfl]
  exact Subgroup.mem_top σ

omit [FiniteDimensional F.Carrier M.Carrier] [FiniteDimensional N.Carrier M.Carrier] in
/-- Above the base break, a tame quotient and the radical subgroup are both
trivial, so the full upper group is trivial. -/
theorem upper_eq_bot_above_kummerBreak_of_tame_tower
    (hcop : (Module.finrank F.Carrier N.Carrier).Coprime p)
    (hpat : ∀ x : ℝ, Padic.upperRamificationGroup M.canonicalTopologicalData N.Carrier x =
      if x ≤ kummerBreak N then ⊤ else ⊥)
    {x : ℝ} (hx : kummerBreak F < x) :
    Padic.upperRamificationGroup M.canonicalTopologicalData F.Carrier x = ⊥ := by
  have hx0 : 0 < x := (kummerBreak_pos F).trans hx
  have hN : Padic.upperRamificationGroup N.canonicalTopologicalData F.Carrier x = ⊥ := by
    have hp0 : 0 < Padic.herbrandPsi N.canonicalTopologicalData F.Carrier x :=
      Padic.herbrandPsi_pos _ _ hx0
    rw [Padic.upperRamificationGroup,
      HerbrandBridge.lowerRamificationGroupReal_of_ceil_eq _ _
        (Int.natCast_ceil_eq_ceil hp0.le).symm]
    exact lowerRamificationGroup_eq_bot_of_coprime_degree F N hcop
      (by have := (Nat.ceil_pos.mpr hp0); omega)
  have hmap := HerbrandBridge.upperRestrictionCompatibility F M N
    M.canonicalTopologicalData N.canonicalTopologicalData x (by linarith)
  rw [hN] at hmap
  apply le_bot_iff.mp
  intro σ hσ
  have hker : σ ∈ HerbrandBridge.towerKernel F M N := by
    apply Subgroup.mem_bot.mp
    rw [← hmap]
    exact Subgroup.mem_map.mpr ⟨σ, hσ, rfl⟩
  let τ := (HerbrandBridge.towerSubgroupEquiv F M N).symm ⟨σ, hker⟩
  have heq : τ.restrictScalars F.Carrier = σ :=
    congrArg Subtype.val ((HerbrandBridge.towerSubgroupEquiv F M N).apply_symm_apply ⟨σ, hker⟩)
  have hτ := (HerbrandBridge.restrictScalars_mem_upperRamificationGroup_iff
    F.Carrier N.Carrier M.canonicalTopologicalData x τ).mp (heq.symm ▸ hσ)
  rw [tame_tower_relative_index F N M, hpat] at hτ
  have hlt : kummerBreak N < Padic.herbrandPsi N.canonicalTopologicalData F.Carrier x := by
    rw [← Padic.herbrandPsi_herbrandPhi N.canonicalTopologicalData F.Carrier (kummerBreak N)]
    apply Padic.herbrandPsi_strictMono
    rwa [herbrandPhi_kummerBreak_of_coprime_degree F N hcop]
  rw [ite_eq_right (not_le_of_gt hlt)] at hτ
  have h1 : τ = 1 := Subgroup.mem_bot.mp hτ
  rw [← heq, h1]
  exact Subgroup.one_mem _

end TameDescent

/-- Adjoining a primitive `p`-th root has degree less than `p`. The relative
cyclotomic polynomial need not be irreducible. -/
theorem cyclotomic_adjoin_finrank_lt {ζ : AlgebraicClosure F.Carrier}
    (hζ : IsPrimitiveRoot ζ p) :
    Module.finrank F.Carrier (adjoinFiniteIntermediate F ζ).field < p := by
  change Module.finrank F.Carrier (IntermediateField.adjoin F.Carrier {ζ}) < p
  rw [IntermediateField.adjoin.finrank (Algebra.IsIntegral.isIntegral ζ)]
  have hdvd : minpoly F.Carrier ζ ∣ cyclotomic p F.Carrier := by
    apply minpoly.dvd
    rw [aeval_def, eval₂_eq_eval_map, map_cyclotomic]
    exact hζ.isRoot_cyclotomic (Fact.out : p.Prime).pos
  have hd := natDegree_le_of_dvd hdvd (cyclotomic_ne_zero p F.Carrier)
  rw [natDegree_cyclotomic, Nat.totient_prime (Fact.out : p.Prime)] at hd
  exact hd.trans_lt (Nat.sub_lt (Fact.out : p.Prime).pos Nat.zero_lt_one)

/-- A finite Galois splitting field detects the Kummer break: some upper
automorphism moves the specified root at the break, and every upper
automorphism is trivial above it. -/
theorem exists_finite_kummer_upper_model
    {ϖ : F.Carrier} {α : AlgebraicClosure F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hα : α ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ) :
    ∃ (M : FiniteGaloisIntermediateField F.Carrier (AlgebraicClosure F.Carrier))
      (hαM : α ∈ M.toIntermediateField),
      (∃ σ : Gal(M/F.Carrier),
        σ ∈ Padic.upperRamificationGroup
          (Padic.absoluteFiniteExtension F M).canonicalTopologicalData F.Carrier
          (kummerBreak F) ∧ σ ⟨α, hαM⟩ ≠ ⟨α, hαM⟩) ∧
      ∀ x : ℝ, kummerBreak F < x →
        Padic.upperRamificationGroup
          (Padic.absoluteFiniteExtension F M).canonicalTopologicalData F.Carrier x = ⊥ := by
  let : CharZero F.Carrier := Algebra.charZero_of_charZero (Padic p) F.Carrier
  let : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot
    (AlgebraicClosure F.Carrier) p
  let N₀ := IntermediateField.adjoin F.Carrier {ζ}
  let : FiniteDimensional F.Carrier N₀ :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral ζ)
  let : IsCyclotomicExtension {p} F.Carrier N₀ :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
      p F.Carrier (AlgebraicClosure F.Carrier) N₀ hζ).mpr rfl
  let : IsGalois F.Carrier N₀ := IsCyclotomicExtension.isGalois {p} F.Carrier N₀
  let N : FiniteGaloisIntermediateField F.Carrier (AlgebraicClosure F.Carrier) := ⟨N₀⟩
  let N' := Padic.absoluteFiniteExtension F N
  have hcop : (Module.finrank F.Carrier N'.Carrier).Coprime p :=
    (Nat.coprime_of_lt_prime (Module.finrank_pos.ne')
      (cyclotomic_adjoin_finrank_lt F hζ) (Fact.out : p.Prime)).symm
  let P : F.Carrier[X] := X ^ p - C ϖ
  let M₀ := Langlands.ClassFieldTheory.Local.KummerNorm.radicalField F.Carrier p ϖ
  let : P.IsSplittingField F.Carrier M₀ :=
    Langlands.ClassFieldTheory.Local.KummerNorm.radicalField_splitting F.Carrier p ϖ
  let : FiniteDimensional F.Carrier M₀ :=
    Langlands.ClassFieldTheory.Local.KummerNorm.radicalField_finiteDimensional F.Carrier p ϖ
  let : Normal F.Carrier M₀ := Normal.of_isSplittingField P
  let : IsGalois F.Carrier M₀ := ⟨⟩
  let M : FiniteGaloisIntermediateField F.Carrier (AlgebraicClosure F.Carrier) := ⟨M₀⟩
  let M' := Padic.absoluteFiniteExtension F M
  have hroot : ∀ β : AlgebraicClosure F.Carrier,
      β ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ → β ∈ M₀ := by
    intro β hβ
    apply IntermediateField.subset_adjoin
    rw [(monic_X_pow_sub_C ϖ (Fact.out : p.Prime).ne_zero).mem_rootSet]
    simpa only [map_sub, map_pow, aeval_X, aeval_C] using sub_eq_zero.mpr hβ
  have hαM : α ∈ M₀ := hroot α hα
  have hϖ0 : ϖ ≠ 0 := F.canonicalTopologicalData.coordinateUniformizer_ne_zero ϖ hϖ
  have hα0 : α ≠ 0 := by
    intro h
    rw [h, zero_pow (Fact.out : p.Prime).ne_zero] at hα
    exact hϖ0 ((algebraMap F.Carrier (AlgebraicClosure F.Carrier)).injective
      (by simpa using hα.symm))
  have hζM : ζ ∈ M₀ := by
    have hza : ζ * α ∈ M₀ := hroot _ (by rw [mul_pow, hζ.pow_eq_one, one_mul, hα])
    have h := M₀.div_mem hza hαM
    rw [mul_div_assoc, div_self hα0, mul_one] at h
    exact h
  have hNM : N₀ ≤ M₀ :=
    IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hζM)
  let : Algebra N'.Carrier M'.Carrier :=
    (IntermediateField.inclusion hNM).toRingHom.toAlgebra
  let : IsScalarTower F.Carrier N'.Carrier M'.Carrier :=
    IsScalarTower.of_algHom (IntermediateField.inclusion hNM)
  let : IsScalarTower (Padic p) N'.Carrier M'.Carrier :=
    IsScalarTower.of_algebraMap_eq' rfl
  let : IsGalois N'.Carrier M'.Carrier :=
    IsGalois.tower_top_of_isGalois F.Carrier N'.Carrier M'.Carrier
  let : FiniteDimensional N'.Carrier M'.Carrier :=
    FiniteDimensional.right F.Carrier N'.Carrier M'.Carrier
  let β : M'.Carrier := ⟨α, hαM⟩
  let a : N'.Carrier := algebraMap F.Carrier N'.Carrier ϖ
  have hβ : β ^ p = algebraMap N'.Carrier M'.Carrier a := by
    apply Subtype.ext
    exact hα
  let z : N'.Carrier := ⟨ζ, IntermediateField.subset_adjoin F.Carrier {ζ} (by simp)⟩
  have hz : IsPrimitiveRoot z p :=
    hζ.of_map_of_injective N₀.val.injective
  let r := Padic.lowerGroupOrder N'.canonicalTopologicalData F.Carrier 0
  have hr : 0 < r := Padic.lowerGroupOrder_pos _ _ _
  have hrcop : r.Coprime p := hcop.of_dvd_left (by
    rw [← IsGalois.card_aut_eq_finrank]
    exact Subgroup.card_subgroup_dvd_card
      (Padic.lowerRamificationGroup N'.canonicalTopologicalData F.Carrier 0))
  have ha : N'.canonicalTopologicalData.ord a = r := by
    rw [_root_.Langlands.LocalFactor.NonabelianSystem.DeligneHenniart.TopLayer.ord_algebraMap_eq
      F.canonicalTopologicalData N'.canonicalTopologicalData, hϖ, mul_one]
  have hirr : Irreducible (X ^ p - C a) :=
    X_pow_sub_C_irreducible_of_prime (Fact.out : p.Prime)
      (coprime_ord_not_pow N' hr hrcop ha)
  let : Polynomial.IsSplittingField N'.Carrier M'.Carrier (X ^ p - C a) := by
    have h := (inferInstance :
      Polynomial.IsSplittingField N'.Carrier M'.Carrier
        (P.map (algebraMap F.Carrier N'.Carrier)))
    simpa only [P, Polynomial.map_sub, Polynomial.map_pow, map_X, map_C] using h
  have hd : Module.finrank N'.Carrier M'.Carrier = p :=
    finrank_of_isSplittingField_X_pow_sub_C
      ⟨z, (mem_primitiveRoots (Fact.out : p.Prime).pos).mpr hz⟩ hirr M'.Carrier
  have hpat := galois_coprime_radical_upper_pattern N' M' hr hrcop ha hβ hd
  have hmoving : ∃ σ : Gal(M'.Carrier/N'.Carrier), σ β ≠ β := by
    by_contra h
    have hall : ∀ σ : Gal(M'.Carrier/N'.Carrier), σ β = β := by
      simpa only [not_exists, not_not] using h
    obtain ⟨b, hb⟩ := (IsGalois.mem_range_algebraMap_iff_fixed β).mpr hall
    apply coprime_ord_not_pow N' hr hrcop ha b
    apply (algebraMap N'.Carrier M'.Carrier).injective
    rw [map_pow, hb, hβ]
  obtain ⟨σ, hσ⟩ := hmoving
  refine ⟨M, hαM, ⟨σ.restrictScalars F.Carrier,
    restrictScalars_mem_upper_at_kummerBreak F N' M' hcop hpat σ, hσ⟩, ?_⟩
  intro x hx
  exact upper_eq_bot_above_kummerBreak_of_tame_tower F N' M' hcop hpat hx

/-- The fixing subgroup of the actual simple intermediate field consists
exactly of the automorphisms fixing its specified generator. -/
theorem mem_adjoin_fixingSubgroup_iff (α : AlgebraicClosure F.Carrier)
    (σ : Gal(AlgebraicClosure F.Carrier/F.Carrier)) :
    σ ∈ (adjoinFiniteIntermediate F α).field.fixingSubgroup ↔ σ α = α := by
  change σ ∈ (IntermediateField.adjoin F.Carrier {α}).fixingSubgroup ↔ _
  rw [IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h
    exact h α (IntermediateField.subset_adjoin F.Carrier {α} (by simp))
  · intro h x hx
    have heq : σ.toAlgHom.comp (IntermediateField.adjoin F.Carrier {α}).val =
        (IntermediateField.adjoin F.Carrier {α}).val := by
      apply IntermediateField.adjoin_algHom_ext F.Carrier
      intro y hy
      obtain rfl := Set.mem_singleton_iff.mp hy
      exact h
    exact DFunLike.congr_fun heq ⟨x, hx⟩

/-- At the Kummer break the absolute upper group contains an automorphism
moving the radical. -/
theorem exists_absolute_upper_moving
    {ϖ : F.Carrier} {α : AlgebraicClosure F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hα : α ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ) :
    ∃ σ : Gal(AlgebraicClosure F.Carrier/F.Carrier),
      σ ∈ Padic.absoluteUpperRamificationGroup F (kummerBreak F) ∧ σ α ≠ α := by
  obtain ⟨M, hαM, ⟨τ, hτ, hmove⟩, _⟩ := exists_finite_kummer_upper_model F hϖ hα
  have hmem : τ ∈ (Padic.absoluteUpperRamificationGroup F (kummerBreak F)).map
      (Padic.absoluteFiniteRestriction F M).toMonoidHom := by
    rw [HerbrandBridge.absoluteUpperFiniteImage F M (kummerBreak F)
      (by have := kummerBreak_pos F; linarith)]
    exact hτ
  obtain ⟨σ, hσ, hres⟩ := Subgroup.mem_map.mp hmem
  change Padic.absoluteFiniteRestriction F M σ = τ at hres
  refine ⟨σ, hσ, fun hfix => hmove ?_⟩
  apply Subtype.ext
  have heval := AlgEquiv.restrictNormalHom_apply M.toIntermediateField σ ⟨α, hαM⟩
  change ((Padic.absoluteFiniteRestriction F M σ) ⟨α, hαM⟩ :
    AlgebraicClosure F.Carrier) = σ.toAlgHom α at heval
  rw [hres] at heval
  exact heval.trans hfix

/-- Strictly above the Kummer break, every absolute upper automorphism fixes
the entire radical intermediate field. -/
theorem kummerStep_upper_le_fixingSubgroup
    {ϖ : F.Carrier} {α : AlgebraicClosure F.Carrier}
    (hϖ : F.canonicalTopologicalData.ord ϖ = 1)
    (hα : α ^ p = algebraMap F.Carrier (AlgebraicClosure F.Carrier) ϖ)
    {x : ℝ} (hx : kummerBreak F < x) :
    Padic.absoluteUpperRamificationGroup F x ≤
      (adjoinFiniteIntermediate F α).field.fixingSubgroup := by
  obtain ⟨M, hαM, _, hbot⟩ := exists_finite_kummer_upper_model F hϖ hα
  intro σ hσ
  refine (mem_adjoin_fixingSubgroup_iff F α σ).mpr ?_
  have hres := (Padic.mem_absoluteUpperRamificationGroup_iff F x σ).mp hσ M
  change Padic.absoluteFiniteRestriction F M σ ∈
    Padic.upperRamificationGroup
      (Padic.absoluteFiniteExtension F M).canonicalTopologicalData F.Carrier x at hres
  rw [hbot x hx] at hres
  have h1 := Subgroup.mem_bot.mp hres
  have heval := AlgEquiv.restrictNormalHom_apply M.toIntermediateField σ ⟨α, hαM⟩
  change ((Padic.absoluteFiniteRestriction F M σ) ⟨α, hαM⟩ :
    AlgebraicClosure F.Carrier) = σ.toAlgHom α at heval
  have hfix : ((Padic.absoluteFiniteRestriction F M σ) ⟨α, hαM⟩ :
      AlgebraicClosure F.Carrier) = α := by
    rw [h1]
    rfl
  exact heval.symm.trans hfix

/-- Upper ramification groups through the Kummer break generate the whole
absolute Galois group together with the radical's fixing subgroup. -/
theorem kummerStepUpperSup : KummerStepUpperSupStatement.{u} := by
  intro p hp F ϖ α hϖ hα x _hx hx
  let : CharZero F.Carrier := Algebra.charZero_of_charZero (Padic p) F.Carrier
  let : IsGalois F.Carrier (AlgebraicClosure F.Carrier) := ⟨⟩
  let H := (adjoinFiniteIntermediate F α).field.fixingSubgroup
  let U : Subgroup Gal(AlgebraicClosure F.Carrier/F.Carrier) :=
    Padic.absoluteUpperRamificationGroup F x
  have hindex : H.index = p := by
    rw [← IntermediateField.finrank_eq_fixingSubgroup_index]
    exact kummerStep_finrank F hϖ hα
  let : H.FiniteIndex := ⟨by rw [hindex]; exact (Fact.out : p.Prime).ne_zero⟩
  obtain ⟨σ, hσ, hmove⟩ := exists_absolute_upper_moving F hϖ hα
  have hσU : σ ∈ U := Padic.absoluteUpperRamificationGroup_antitone F hx hσ
  have hnot : ¬ H ⊔ U ≤ H := by
    intro h
    exact hmove ((mem_adjoin_fixingSubgroup_iff F α σ).mp
      (h ((show U ≤ H ⊔ U from le_sup_right) hσU)))
  have hstrict : H < H ⊔ U := lt_of_le_not_ge le_sup_left hnot
  have hlt := Subgroup.index_strictAnti hstrict
  have hdvd : (H ⊔ U).index ∣ p := by
    exact (Subgroup.index_dvd_of_le
      (show H ≤ H ⊔ U from le_sup_left)).trans (dvd_of_eq hindex)
  rcases (Nat.dvd_prime (Fact.out : p.Prime)).mp hdvd with hi | hi
  · exact Subgroup.index_eq_one.mp hi
  · rw [hi, hindex] at hlt
    exact (lt_irrefl p hlt).elim

end Langlands.Ramification.Kummer
