import Langlands.LocalFactor.Ramification.InductionProof
import Langlands.Representation.Finite.InductionTransport
import Langlands.LocalFactor.Ramification.RankOneConductorIntegrality

/-!
# The Artin conductor of a difference of two induced characters is an integer

For a finite Galois extension `F/K` of p-adic fields with group `G`, a subgroup `S ≤ G` and two
characters `χ, χ'` of `S`, the difference `a_K(Ind_S χ) − a_K(Ind_S χ')` of the Artin
expressions of the induced representations is an integer (`exists_int_artinConductor_ind_sub`).

The Library's induction formula (`finiteGaloisInducedConductor`) writes `a_K(Ind ψ)` as
`dim ψ · a_K(Ind 1) + f · a_{K_S}(ψ)`, with `K_S` the fixed field of `S` and
`f = [G : G_0] / [Gal(F/K_S) : Gal(F/K_S)_0]`. For two characters the first terms are equal and
cancel; `f` is the natural number `[G : S ⊔ G_0]` (`inertia_index_eq_mul`); and the conductors of
characters over `K_S` are natural numbers (`exists_nat_artinConductor_rankOne`).
-/

noncomputable section

namespace Langlands.Ramification.Padic

open Module

universe uK uK' uL

section Index

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{uL} p}
  (T : F.TopologicalData) (K : Type uK) [Field K] [Algebra (Padic p) K]
  [Algebra K F.Carrier] [IsScalarTower (Padic p) K F.Carrier]
  (K' : Type uK') [Field K'] [Algebra (Padic p) K'] [Algebra K K']
  [Algebra K' F.Carrier] [IsScalarTower (Padic p) K' F.Carrier]
  [IsScalarTower K K' F.Carrier]

/-- **The residue degree as an index.** For a tower `K → K' → F`, the index of the inertia
group of `F/K` is the index of the inertia group of `F/K'` times the index of the subgroup
generated by `Gal(F/K')` and the inertia group of `F/K`. -/
theorem inertia_index_eq_mul :
    (inertia T K).index = (inertia T K').index *
      ((AlgEquiv.restrictScalarsHom (S := K') (A := F.Carrier) K).range ⊔ inertia T K).index := by
  rw [← lowerRamificationGroup_zero T K, ← lowerRamificationGroup_zero T K',
    ← lowerRamificationGroup_comap T K K' 0, Subgroup.index_comap,
    ← Subgroup.relIndex_sup_right]
  exact (Subgroup.relIndex_mul_index le_sup_right).symm

end Index

/-- An intermediate field of `F/K` lies in the scalar tower `ℚ_p → E → F`. -/
instance intermediateFieldPadicScalarTower {p : ℕ} [Fact p.Prime] {F : PadicField.{uL} p}
    {K : Type uK} [Field K] [Algebra (Padic p) K] [Algebra K F.Carrier]
    [IsScalarTower (Padic p) K F.Carrier] (E : IntermediateField K F.Carrier) :
    IsScalarTower (Padic p) E F.Carrier :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

namespace InducedRankOneDifference

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{uL} p} {K : Type uK} [Field K]
  [Algebra K F.Carrier] [FiniteDimensional K F.Carrier] (S : Subgroup (F.Carrier ≃ₐ[K] F.Carrier))

/-- The fixed field `K_S` of `S`. -/
abbrev fixedField : IntermediateField K F.Carrier := IntermediateField.fixedField S

/-- `S` as the Galois group of `F` over its fixed field. -/
abbrev galoisEquiv : S ≃* (F.Carrier ≃ₐ[fixedField S] F.Carrier) :=
  IntermediateField.subgroupEquivAlgEquiv S

/-- Restriction of scalars from `Gal(F/K_S)` to `G`. -/
abbrev restrictScalars : (F.Carrier ≃ₐ[fixedField S] F.Carrier) →* (F.Carrier ≃ₐ[K] F.Carrier) :=
  AlgEquiv.restrictScalarsHom (S := fixedField S) (A := F.Carrier) K

theorem restrictScalars_galoisEquiv (h : S) :
    S.subtype h = restrictScalars S (galoisEquiv S h) :=
  AlgEquiv.ext fun _ => rfl

theorem range_restrictScalars : (restrictScalars S).range = S := by
  ext σ
  constructor
  · rintro ⟨τ, rfl⟩
    obtain ⟨h, rfl⟩ := (galoisEquiv S).surjective τ
    rw [← restrictScalars_galoisEquiv]
    exact h.2
  · intro hσ
    exact ⟨galoisEquiv S ⟨σ, hσ⟩, (restrictScalars_galoisEquiv S ⟨σ, hσ⟩).symm⟩

/-- The character of `Gal(F/K_S)` corresponding to a character of `S`. -/
abbrev transportCharacter (χ : S →* ℂˣ) : (F.Carrier ≃ₐ[fixedField S] F.Carrier) →* ℂˣ :=
  χ.comp (galoisEquiv S).symm.toMonoidHom

/-- Inducing `oneDimensional χ` along `S.subtype` is inducing the rank-one representation of the
transported character along restriction of scalars. -/
def indEquiv (χ : S →* ℂˣ) :
    (Representation.ind S.subtype (FiniteRep.oneDimensional χ).ρ).Equiv
      (Representation.ind (restrictScalars S)
        ((FiniteRep.oneDimensional χ).ρ.comp (galoisEquiv S).symm.toMonoidHom)) :=
  FiniteRep.indCongrEquiv (galoisEquiv S) (restrictScalars_galoisEquiv S)
    (fun h => by simp)

/-- On `Gal(F/K_S)` the transported `oneDimensional χ` is the rank-one representation of the
transported character. -/
def transportEquiv (χ : S →* ℂˣ) :
    Representation.Equiv ((FiniteRep.oneDimensional χ).ρ.comp (galoisEquiv S).symm.toMonoidHom)
      (LocalClassField.rankOneCharacterRepresentation (transportCharacter S χ)) :=
  Representation.Equiv.mk (FiniteRep.oneDimensionalEquiv χ).toLinearEquiv
    (fun g => (FiniteRep.oneDimensionalEquiv χ).isIntertwining' ((galoisEquiv S).symm g))

end InducedRankOneDifference

section Difference

open InducedRankOneDifference

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{uL} p} (T : F.TopologicalData)
  {K : Type uK} [Field K] [Algebra (Padic p) K] [Algebra K F.Carrier]
  [IsScalarTower (Padic p) K F.Carrier] [FiniteDimensional K F.Carrier]

/-- **The induced difference identity.** The difference of the Artin expressions of two
characters of `S` induced to `G` is `[G : S ⊔ G_0]` times the difference of the Artin
expressions over the fixed field `K_S` of the corresponding characters of `Gal(F/K_S)`. -/
theorem artinConductor_ind_sub_eq [IsGalois K F.Carrier]
    (S : Subgroup (F.Carrier ≃ₐ[K] F.Carrier)) (χ χ' : S →* ℂˣ) :
    artinConductor T K (Representation.ind S.subtype (FiniteRep.oneDimensional χ).ρ) -
        artinConductor T K (Representation.ind S.subtype (FiniteRep.oneDimensional χ').ρ) =
      ((S ⊔ inertia T K).index : ℚ) *
        (artinConductor T (fixedField S)
            (LocalClassField.rankOneCharacterRepresentation (transportCharacter S χ)) -
          artinConductor T (fixedField S)
            (LocalClassField.rankOneCharacterRepresentation (transportCharacter S χ'))) := by
  have hind := finiteGaloisInducedConductor T K (fixedField S)
    (V := FiniteRep.oneDimensional χ)
    ((FiniteRep.oneDimensional χ).ρ.comp (galoisEquiv S).symm.toMonoidHom)
  have hind' := finiteGaloisInducedConductor T K (fixedField S)
    (V := FiniteRep.oneDimensional χ')
    ((FiniteRep.oneDimensional χ').ρ.comp (galoisEquiv S).symm.toMonoidHom)
  have hidx := inertia_index_eq_mul T K (fixedField S)
  rw [range_restrictScalars] at hidx
  have hpos : ((inertia T (fixedField S)).index : ℚ) ≠ 0 :=
    Nat.cast_ne_zero.mpr Subgroup.index_ne_zero_of_finite
  rw [artinConductor_equiv T K (indEquiv S χ), artinConductor_equiv T K (indEquiv S χ'),
    hind, hind', artinConductor_equiv T (fixedField S) (transportEquiv S χ),
    artinConductor_equiv T (fixedField S) (transportEquiv S χ'),
    FiniteRep.oneDimensional_finrank, FiniteRep.oneDimensional_finrank, hidx]
  push_cast
  field_simp
  ring

/-- **The induced difference is an integer.** -/
theorem exists_int_artinConductor_ind_sub [IsGalois K F.Carrier]
    (S : Subgroup (F.Carrier ≃ₐ[K] F.Carrier)) (χ χ' : S →* ℂˣ) :
    ∃ z : ℤ,
      artinConductor T K (Representation.ind S.subtype (FiniteRep.oneDimensional χ).ρ) -
        artinConductor T K (Representation.ind S.subtype (FiniteRep.oneDimensional χ').ρ) =
      (z : ℚ) := by
  obtain ⟨a, ha⟩ := exists_nat_artinConductor_rankOne T (fixedField S) (transportCharacter S χ)
  obtain ⟨a', ha'⟩ :=
    exists_nat_artinConductor_rankOne T (fixedField S) (transportCharacter S χ')
  refine ⟨(S ⊔ inertia T K).index * ((a : ℤ) - a'), ?_⟩
  rw [artinConductor_ind_sub_eq T S χ χ', ha, ha']
  push_cast
  ring

end Difference

end Langlands.Ramification.Padic
