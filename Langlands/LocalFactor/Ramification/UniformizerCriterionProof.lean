import Langlands.LocalFactor.Ramification.UniformizerCriterionStatement
import Langlands.ClassFieldTheory.Local.GradedUnitCoordinates

/-!
# Proof of the uniformizer test for actual lower ramification groups

For a ring endomorphism of a local ring whose maximal ideal is generated by `ϖ`, and
which fixes a representative of every residue class, the congruence `f x ≡ x` modulo
`m ^ n` for all `x` is equivalent to the single congruence `f ϖ ≡ ϖ`. Surjectivity of the
actual relative residue map supplies such representatives from the base integer ring,
and the normalized order of the extension converts ideal-power membership into the
order inequality, with the zero case kept explicit.
-/

noncomputable section

namespace Langlands.Ramification

open IsLocalRing

section Generic

universe uR uH

variable {R : Type uR} [CommRing R] [IsLocalRing R] {ϖ : R}
  {H : Type uH} [FunLike H R R] [RingHomClass H R R]

/-- With fixed residue representatives, a generator congruence modulo `m ^ n` propagates
to every element modulo `m ^ k` for each `k ≤ n`. -/
theorem sub_mem_maximalIdeal_pow_of_fixed (hϖ : maximalIdeal R = Ideal.span {ϖ}) (f : H)
    (hrep : ∀ x : R, ∃ a : R, f a = a ∧ x - a ∈ maximalIdeal R) {n : ℕ}
    (hf : f ϖ - ϖ ∈ maximalIdeal R ^ n) :
    ∀ k ≤ n, ∀ x : R, f x - x ∈ maximalIdeal R ^ k := by
  intro k
  induction k with
  | zero =>
    intro _ x
    simp
  | succ k ih =>
    intro hk x
    obtain ⟨a, ha, hxa⟩ := hrep x
    rw [hϖ, Ideal.mem_span_singleton'] at hxa
    obtain ⟨b, hb⟩ := hxa
    have e : f x - x = f b * (f ϖ - ϖ) + (f b - b) * ϖ := by
      have hx : x = a + b * ϖ := by rw [hb]; ring
      rw [hx, map_add, map_mul, ha]
      ring
    rw [e]
    refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right hk hf)) ?_
    rw [pow_succ]
    refine Ideal.mul_mem_mul (ih (by omega) b) ?_
    rw [hϖ]
    exact Ideal.mem_span_singleton_self ϖ

/-- With fixed residue representatives, the congruence modulo `m ^ n` is tested on one
generator of the maximal ideal. -/
theorem forall_sub_mem_maximalIdeal_pow_iff_of_fixed
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) (f : H)
    (hrep : ∀ x : R, ∃ a : R, f a = a ∧ x - a ∈ maximalIdeal R) (n : ℕ) :
    (∀ x : R, f x - x ∈ maximalIdeal R ^ n) ↔ f ϖ - ϖ ∈ maximalIdeal R ^ n :=
  ⟨fun h => h ϖ, fun hf => sub_mem_maximalIdeal_pow_of_fixed hϖ f hrep hf n le_rfl⟩

end Generic

end Langlands.Ramification

namespace Langlands.PadicField.TopologicalData

universe u

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{u} p} (T : F.TopologicalData)

/-- A nonzero element is integral exactly when its normalized order is nonnegative. -/
theorem mem_integers_iff_zero_le_ord {x : F.Carrier} (hx : x ≠ 0) :
    x ∈ T.Integers ↔ 0 ≤ T.ord x := by
  rw [← T.normalizedAbs_le_one_iff_mem_integers, T.normalizedAbs_of_ne_zero hx,
    zpow_le_one_iff_right₀ (by exact_mod_cast T.residueCardinality_gt_one), neg_nonpos]

/-- Membership in a maximal-ideal power, read through the normalized order with the
explicit zero case required by the convention `ord 0 = 0`. -/
theorem mem_maximalIdeal_pow_iff_ord (π : F.Carrier) (hπ : T.ord π = 1) (n : ℕ)
    (d : T.Integers) :
    d ∈ IsLocalRing.maximalIdeal T.Integers ^ n ↔
      (d : F.Carrier) = 0 ∨ (n : ℤ) ≤ T.ord (d : F.Carrier) := by
  have hπn : π ^ n ≠ 0 := pow_ne_zero n (T.coordinateUniformizer_ne_zero π hπ)
  have hord : T.ord (π ^ n) = n := by
    have h := T.ord_zpow π n
    rwa [zpow_natCast, hπ, mul_one] at h
  rw [T.mem_maximalIdeal_pow_iff_coordinate_dvd π hπ]
  constructor
  · rintro ⟨c, rfl⟩
    have hcoe : ((T.coordinateUniformizer π hπ ^ n * c : T.Integers) : F.Carrier) =
        π ^ n * (c : F.Carrier) := by
      simp only [Subring.coe_mul, Subring.coe_pow, coordinateUniformizer_coe]
    rw [hcoe]
    by_cases hc : (c : F.Carrier) = 0
    · left
      rw [hc, mul_zero]
    · right
      rw [T.ord_mul hπn hc, hord]
      have := (T.mem_integers_iff_zero_le_ord hc).mp c.property
      omega
  · intro h
    by_cases hd : (d : F.Carrier) = 0
    · rw [show d = 0 from Subtype.ext hd]
      exact dvd_zero _
    have hle : (n : ℤ) ≤ T.ord (d : F.Carrier) := h.resolve_left hd
    have hq : (d : F.Carrier) / π ^ n ∈ T.Integers := by
      rw [T.mem_integers_iff_zero_le_ord (div_ne_zero hd hπn), div_eq_mul_inv,
        T.ord_mul hd (inv_ne_zero hπn), T.ord_inv, hord]
      omega
    refine ⟨⟨_, hq⟩, Subtype.ext ?_⟩
    simp only [Subring.coe_mul, Subring.coe_pow, coordinateUniformizer_coe]
    exact (mul_div_cancel₀ _ hπn).symm

end Langlands.PadicField.TopologicalData

namespace Langlands.Ramification.Padic

universe u v

section Criterion

variable {p : ℕ} [Fact p.Prime] {F : PadicField.{u} p} {E : PadicField.{v} p}
  [Algebra F.Carrier E.Carrier] [IsScalarTower (Padic p) F.Carrier E.Carrier]
  (T : F.TopologicalData) (S : E.TopologicalData)

/-- Surjectivity of the actual relative residue map gives every extension integer a
representative modulo the maximal ideal coming from the base integers; every base-field
automorphism fixes it. -/
theorem exists_fixed_residue_representative
    (hsurj : Function.Surjective (PadicField.TopologicalData.relativeResidueMap T S))
    (σ : E.Carrier ≃ₐ[F.Carrier] E.Carrier) (x : S.Integers) :
    ∃ a : S.Integers, integerAutomorphism S F.Carrier σ a = a ∧
      x - a ∈ IsLocalRing.maximalIdeal S.Integers := by
  obtain ⟨z, hz⟩ := hsurj (S.residue x)
  obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective z
  rw [PadicField.TopologicalData.relativeResidueMap_residue] at hz
  refine ⟨PadicField.TopologicalData.relativeIntegerMap T S b, Subtype.ext ?_, ?_⟩
  · exact σ.commutes (b : F.Carrier)
  · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
    exact hz.symm

/-- The uniformizer test for the actual lower ramification groups, for arbitrary supplied
realizations, an arbitrary element of order one, and every natural index. -/
theorem mem_lowerRamificationGroup_iff_uniformizer
    (hsurj : Function.Surjective (PadicField.TopologicalData.relativeResidueMap T S))
    (π : E.Carrier) (hπ : S.ord π = 1) (σ : E.Carrier ≃ₐ[F.Carrier] E.Carrier) (i : ℕ) :
    σ ∈ lowerRamificationGroup S F.Carrier i ↔
      σ π - π = 0 ∨ (i + 1 : ℤ) ≤ S.ord (σ π - π) := by
  have hcoe : ((integerAutomorphism S F.Carrier σ (S.coordinateUniformizer π hπ) -
      S.coordinateUniformizer π hπ : S.Integers) : E.Carrier) = σ π - π := by
    change σ (S.coordinateUniformizer π hπ : E.Carrier) -
      (S.coordinateUniformizer π hπ : E.Carrier) = σ π - π
    rw [PadicField.TopologicalData.coordinateUniformizer_coe]
  rw [mem_lowerRamificationGroup,
    forall_sub_mem_maximalIdeal_pow_iff_of_fixed
      (S.maximalIdeal_eq_span_coordinateUniformizer π hπ) (integerAutomorphism S F.Carrier σ)
      (exists_fixed_residue_representative T S hsurj σ),
    S.mem_maximalIdeal_pow_iff_ord π hπ, hcoe]
  push_cast
  rfl

end Criterion

/-- The uniformizer criterion for the actual lower ramification groups. -/
theorem uniformizerCriterion : UniformizerCriterion.{u, v} := by
  intro p _ F E _ _ T S hsurj π hπ σ i
  exact mem_lowerRamificationGroup_iff_uniformizer T S hsurj π hπ σ i

end Langlands.Ramification.Padic
