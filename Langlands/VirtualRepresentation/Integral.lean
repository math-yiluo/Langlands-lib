import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.Finsupp.VectorSpace
import Mathlib.GroupTheory.GroupAction.Defs
import Mathlib.Data.PNat.Basic

/-!
# Integral lattices with a specified basis

Concrete finitely supported integral combinations, and the constructions on them
used in Henniart's virtual-representation argument. The index type is explicit:
this module neither constructs local representation classes nor identifies a
representation Grothendieck group with a free group on irreducibles.
-/

noncomputable section

universe u v w z

namespace Langlands
namespace VirtualRepresentation

/-- The free integral module on the specified basis. -/
abbrev IntegralLattice (ι : Type u) := ι →₀ ℤ

variable {ι : Type u} {κ : Type v}

/-- A basis class, with multiplicity one. -/
def generator (i : ι) : IntegralLattice ι :=
  Finsupp.single i 1

/-- The actual basis of the free integral module. -/
def integralBasis : Module.Basis ι ℤ (IntegralLattice ι) :=
  Finsupp.basisSingleOne

/-- Integral multiplicity of a specified basis class. -/
def coefficient (i : ι) : IntegralLattice ι →ₗ[ℤ] ℤ :=
  Finsupp.lapply i

/-- Extend specified values on the basis by integral linearity. -/
def extend {M : Type z} [AddCommGroup M] [Module ℤ M] (f : ι → M) :
    IntegralLattice ι →ₗ[ℤ] M :=
  Finsupp.linearCombination ℤ f

/-- Extend values on two bases by integral bilinearity. No tensor decomposition
or factor comparison is supplied by this construction. -/
def extendBilinear {M : Type z} [AddCommGroup M] [Module ℤ M]
    (f : ι → κ → M) : IntegralLattice ι →ₗ[ℤ] IntegralLattice κ →ₗ[ℤ] M :=
  extend (fun i => extend (f i))

/-- Push forward multiplicities. Noninjective maps add the colliding coefficients. -/
def map (f : ι → κ) : IntegralLattice ι →ₗ[ℤ] IntegralLattice κ :=
  Finsupp.lmapDomain ℤ ℤ f

/-- Relabel a basis by a genuine equivalence, preserving all multiplicities. -/
def reindex (e : ι ≃ κ) : IntegralLattice ι ≃ₗ[ℤ] IntegralLattice κ :=
  Finsupp.domLCongr e

/-- An integer-valued degree obtained from a natural-number weight on the basis.
Virtual elements may have negative or zero degree. -/
def degree (weight : ι → ℕ) : IntegralLattice ι →ₗ[ℤ] ℤ :=
  extend (fun i => (weight i : ℤ))

/-- The integral coefficient pairing with the specified basis orthonormal.
Its relation to a representation-theoretic Hom dimension or a local-factor pole
is a separate mathematical assertion. -/
def pairing : IntegralLattice ι →ₗ[ℤ] IntegralLattice ι →ₗ[ℤ] ℤ :=
  extend coefficient

/-- Elements whose coefficients are all nonnegative. This is an additive monoid,
not an integral submodule, and makes no assertion about irreducibility. -/
def effective : AddSubmonoid (IntegralLattice ι) where
  carrier := {x | ∀ i, 0 ≤ x i}
  zero_mem' := fun _ => le_rfl
  add_mem' hx hy i := add_nonneg (hx i) (hy i)

/-- The sublattice supported on a specified subset of the basis. In particular,
one can use the actual unitary classes once that predicate has been constructed. -/
def supported (s : Set ι) : Submodule ℤ (IntegralLattice ι) :=
  Finsupp.supported ℤ ℤ s

/-- The supported sublattice has its own concrete coefficient model on the subset. -/
def supportedEquiv (s : Set ι) : supported s ≃ₗ[ℤ] IntegralLattice s :=
  Finsupp.supportedEquivFinsupp s

/-- Include integral combinations on a subset into the ambient lattice. -/
def includeSubset (s : Set ι) : IntegralLattice s →ₗ[ℤ] IntegralLattice ι :=
  map Subtype.val

/-- Restrict coefficients to a subset. This is not an induced-character operation. -/
def restrictSubset (s : Set ι) : IntegralLattice ι →ₗ[ℤ] IntegralLattice s :=
  Finsupp.lcomapDomain Subtype.val Subtype.val_injective

/-- The sublattice generated by an actual family of lattice elements.
No spanning property is included. -/
def generated {J : Type v} (family : J → IntegralLattice ι) : Submodule ℤ (IntegralLattice ι) :=
  Submodule.span ℤ (Set.range family)

/-- Evaluate a formal combination of generators in the sublattice they generate.
The membership proof uses only the definition of integral span. -/
def evaluateGenerators {J : Type v} (family : J → IntegralLattice ι) :
    IntegralLattice J →ₗ[ℤ] generated family :=
  extend (fun j => ⟨family j, Submodule.subset_span (Set.mem_range_self j)⟩)

/-- The submodule of integral relations among a supplied family. -/
def relations {J : Type v} (family : J → IntegralLattice ι) : Submodule ℤ (IntegralLattice J) :=
  LinearMap.ker (extend family)

/-- Pairs generated by corresponding genuine objects. This does not assert that
either projection is injective, or choose an isomorphism between their spans. -/
def generatedPairs {J : Type z} (left : J → IntegralLattice ι) (right : J → IntegralLattice κ) :
    Submodule ℤ (IntegralLattice ι × IntegralLattice κ) :=
  Submodule.span ℤ (Set.range (fun j => (left j, right j)))

/-- All basis classes across positive ranks, as a disjoint union. -/
abbrev RankedBasis (B : ℕ+ → Type u) := Σ n, B n

/-- The integral lattice on a family of positive-rank bases. -/
abbrev RankedLattice (B : ℕ+ → Type u) := IntegralLattice (RankedBasis B)

/-- Rank degree on a disjoint union of positive-rank bases. -/
def rankedDegree (B : ℕ+ → Type u) : RankedLattice B →ₗ[ℤ] ℤ :=
  degree (fun b => (b.1 : ℕ))

/-- Include the basis of rank `n`; the ambient rank is not lost. -/
def includeRank (B : ℕ+ → Type u) (n : ℕ+) : IntegralLattice (B n) →ₗ[ℤ] RankedLattice B :=
  map (Sigma.mk n)

/-- Extract the coefficients with basis rank `n`. -/
def restrictRank (B : ℕ+ → Type u) (n : ℕ+) : RankedLattice B →ₗ[ℤ] IntegralLattice (B n) :=
  Finsupp.lcomapDomain (Sigma.mk n) (fun _ _ h => eq_of_heq (Sigma.mk.inj h).2)

/-- Support on one basis-rank stratum. This is distinct from total degree `n`. -/
def rankSupported (B : ℕ+ → Type u) (n : ℕ+) : Submodule ℤ (RankedLattice B) :=
  supported {b | b.1 = n}

/-- A specified total-degree stratum; no finiteness is asserted. -/
def degreeStratum (weight : ι → ℕ) (d : ℤ) : Set (IntegralLattice ι) :=
  {x | degree weight x = d}

/-- Effective elements of specified total degree; no finiteness is asserted. -/
def effectiveDegreeStratum (weight : ι → ℕ) (d : ℤ) : Set (IntegralLattice ι) :=
  {x | x ∈ effective ∧ degree weight x = d}

/-- Basis classes of fixed rank and a supplied invariant. Examples of invariants
require genuine conductor or central-character constructions in the application. -/
def basisStratum (B : ℕ+ → Type u) {A : Type v} (invariant : RankedBasis B → A)
    (n : ℕ+) (a : A) : Set (RankedBasis B) :=
  {b | b.1 = n ∧ invariant b = a}

/-- Rank-preserving basis equivalences induce an equivalence of the full lattices.
This applies to duality or twisting only after those basis equivalences exist. -/
def reindexRanks {B : ℕ+ → Type u} {C : ℕ+ → Type v} (e : ∀ n, B n ≃ C n) :
    RankedLattice B ≃ₗ[ℤ] RankedLattice C :=
  reindex (Equiv.sigmaCongrRight e)

section Orbits

variable (T : Type v) [Group T] [MulAction T ι]

/-- The genuine orbit quotient of an already supplied basis action.
Finiteness, faithfulness and transitivity are not assumed. -/
abbrev OrbitClasses := Quotient (MulAction.orbitRel T ι)

/-- Send a basis class to its orbit. -/
def orbitClass (i : ι) : OrbitClasses (ι := ι) T :=
  Quotient.mk _ i

/-- Collect coefficients by orbits of the given action. -/
def orbitMap : IntegralLattice ι →ₗ[ℤ] IntegralLattice (OrbitClasses (ι := ι) T) :=
  map (orbitClass T)

end Orbits

end VirtualRepresentation
end Langlands
