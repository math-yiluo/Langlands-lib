import Langlands.ClassField.Global.RelativeWeilGroup
import Langlands.VirtualRepresentation.ExactInductionTwist
import Langlands.Weil.Representation.CharacterLine

/-!
# Brauer induction for relative Weil groups

The exact virtual group of continuous finite-dimensional complex representations
of `W_{E/F}` is generated by representations induced from continuous characters
of the inverse images of subgroups of `Gal(E/F)`; compare Tate (1979), (2.2.3)
and (2.3.1). Proposition definitions only.
-/

noncomputable section

set_option autoImplicit false

universe u uV

namespace Langlands.ClassField.Global.RelativeWeilGroup

open Langlands.VirtualRepresentation

variable (c : FundamentalClass.ClassFamily.{u}) (F E : Type u)
  [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] [IsGalois F E]

attribute [local instance] relativeGaloisTopology

/-- The inverse image in `W_{E/F}` of a subgroup `H` of `Gal(E/F)`. It contains
the image of `C_E`. -/
abbrev galoisPreimage (H : Subgroup (E ≃ₐ[F] E)) : Subgroup (RelativeWeilGroup c F E) :=
  H.comap (projection c F E)

/-- The inverse image is open, because the projection is continuous onto the
discrete automorphism group. -/
theorem isOpen_galoisPreimage (H : Subgroup (E ≃ₐ[F] E)) :
    IsOpen (galoisPreimage c F E H : Set (RelativeWeilGroup c F E)) :=
  (continuousProjection c F E).continuous.isOpen_preimage _ (isOpen_discrete _)

/-- The exact virtual group of continuous finite-dimensional complex
representations of `W_{E/F}`, with carriers in universe `max u uV`. -/
abbrev ContinuousVirtual :=
  ExactGrothendieckGroup
    (fun A : FiniteRepresentation.{0, u, max u uV} ℂ (RelativeWeilGroup c F E) =>
      A.IsContinuous)

/-- The classes `Ind_{W_H}^{W_{E/F}} θ` for a subgroup `H` of `Gal(E/F)` and a
continuous character `θ` of its inverse image `W_H`. -/
def inducedCharacterGenerators : Set (ContinuousVirtual.{u, uV} c F E) :=
  {x | ∃ (H : Subgroup (E ≃ₐ[F] E)) (θ : galoisPreimage c F E H →ₜ* ℂˣ),
    x = ExactGrothendieckGroup.continuousInduce (galoisPreimage c F E H)
      (isOpen_galoisPreimage c F E H)
      (ExactGrothendieckGroup.characterClass.{u, max u uV} θ)}

/-- Brauer induction for `W_{E/F}`: the induced character classes span the whole
exact virtual group over `ℤ`. -/
def InducedCharacterGeneration : Prop :=
  Submodule.span ℤ (inducedCharacterGenerators.{u, uV} c F E) = ⊤

/-- Brauer induction for every class family and every finite Galois extension of
number fields, with an independent carrier universe. -/
def InducedCharacterGenerationStatement : Prop :=
  ∀ (c : FundamentalClass.ClassFamily.{u}) (F E : Type u)
    [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] [IsGalois F E],
    InducedCharacterGeneration.{u, uV} c F E

end Langlands.ClassField.Global.RelativeWeilGroup
