module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.FiniteStability
public import Mathlib.RingTheory.IsTensorProduct
public import Mathlib.RingTheory.TensorProduct.Finite
public import Langlands.RingTheory.TensorProduct.BaseChangeMaps

/-! # Extensionality for algebra maps out of a pushout

If `S'` is the pushout of `S` and `R'` over `R`, two `R'`-algebra maps out of `S'` are equal as
soon as they agree on `S` (`Algebra.IsPushout.algHom_ext'`): they agree on `R'` because both are
`R'`-linear, and `S'` is generated by the images of `S` and `R'`.
-/

public section

namespace Algebra.IsPushout

variable {R S R' S' : Type*} [CommSemiring R] [CommSemiring S] [CommSemiring R'] [CommSemiring S']
  [Algebra R S] [Algebra R R'] [Algebra R' S'] [Algebra R S'] [Algebra S S'] [IsScalarTower R R' S']
  [IsScalarTower R S S'] [h : IsPushout R S R' S']

variable {A : Type*} [Semiring A] [Algebra R' A] [Algebra R A] [IsScalarTower R R' A]

/-- Two `R'`-algebra maps out of the pushout `S'` that agree on `S` are equal. -/
@[ext (iff := false)]
theorem algHom_ext' {f g : S' →ₐ[R'] A}
    (h : (f.restrictScalars R).comp (IsScalarTower.toAlgHom R S S') =
      (g.restrictScalars R).comp (IsScalarTower.toAlgHom R S S')) : f = g := by
  refine AlgHom.restrictScalars_injective R (IsPushout.algHom_ext (R' := R') S' ?_ h)
  exact AlgHom.ext fun r => (f.commutes r).trans (g.commutes r).symm

end Algebra.IsPushout
