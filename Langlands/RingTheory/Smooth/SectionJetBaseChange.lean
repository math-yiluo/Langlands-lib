import Langlands.RingTheory.Smooth.SectionJetFiltration
import Mathlib.RingTheory.TensorProduct.Quotient

/-! # Arbitrary scalar extension of augmented section jets -/

noncomputable section

universe u v w

set_option autoImplicit false

open scoped TensorProduct

namespace Algebra.SectionJet

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]
  (ε : A →ₐ[R] R) (S : Type w) [CommRing S] [Algebra R S]

/-- Evaluation at the base-changed section on the tensor-product algebra. -/
def baseChangeAugmentation : S ⊗[R] A →ₐ[S] S :=
  (Algebra.TensorProduct.rid R S S).toAlgHom.comp
    (Algebra.TensorProduct.map (AlgHom.id S S) ε)

@[simp]
theorem baseChangeAugmentation_tmul (s : S) (a : A) :
    baseChangeAugmentation ε S (s ⊗ₜ[R] a) = s * algebraMap R S (ε a) := by
  simp [baseChangeAugmentation, Algebra.smul_def, mul_comm]

/-- The tensor augmentation ideal is generated by the original augmentation ideal. -/
theorem ker_baseChangeAugmentation :
    RingHom.ker (baseChangeAugmentation ε S) =
      (RingHom.ker ε).map
        (Algebra.TensorProduct.includeRight : A →ₐ[R] S ⊗[R] A) := by
  change RingHom.ker
    ((Algebra.TensorProduct.rid R S S).toRingEquiv.toRingHom.comp
      (Algebra.TensorProduct.map (AlgHom.id R S) ε).toRingHom) = _
  rw [RingHom.ker_equiv_comp]
  exact Algebra.TensorProduct.lTensor_ker (A := S) ε
    (fun r => ⟨algebraMap R A r, ε.commutes r⟩)

/-- Section jets commute with arbitrary extension of the coefficient ring. -/
def baseChangeEquiv (n : ℕ) :
    S ⊗[R] Quotient ε n ≃ₐ[S] Quotient (baseChangeAugmentation ε S) n :=
  (Algebra.TensorProduct.tensorQuotientEquiv S A S
    (RingHom.ker ε ^ (n + 1))).trans
      (Ideal.quotientEquivAlgOfEq S (by
        rw [Ideal.map_pow, ker_baseChangeAugmentation]))

@[simp]
theorem baseChangeEquiv_tmul_mk (n : ℕ) (s : S) (a : A) :
    baseChangeEquiv ε S n (s ⊗ₜ[R] Ideal.Quotient.mk _ a) =
      Ideal.Quotient.mk _ (s ⊗ₜ[R] a) := rfl

/-- The scalar-extension comparison commutes with every jet truncation. -/
theorem baseChangeEquiv_truncate (n : ℕ) (z : S ⊗[R] Quotient ε (n + 1)) :
    baseChangeEquiv ε S n
      (Algebra.TensorProduct.map (AlgHom.id S S) (truncate ε n) z) =
      truncate (baseChangeAugmentation ε S) n (baseChangeEquiv ε S (n + 1) z) := by
  induction z using TensorProduct.inductionOn with
  | tmul s a =>
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rfl
  | add x y hx hy =>
    simpa only [map_add] using congrArg₂ (· + ·) hx hy

end Algebra.SectionJet
