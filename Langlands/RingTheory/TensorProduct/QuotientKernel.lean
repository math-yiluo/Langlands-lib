module

public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # The ideal extended from the right tensor factor and the kernel of a tensor quotient

For an ideal `I` of `B`, `Ideal.rightTensorIdeal R A I` is the ideal of `A ⊗[R] B` generated by
the image of `I` under the inclusion of the right factor. It is the kernel of the map
`A ⊗[R] B → A ⊗[R] (B ⧸ I)` (`Ideal.ker_tensorProduct_map_id_quotient`), by right exactness of the
tensor product.
-/

@[expose] public section

open scoped TensorProduct

namespace Ideal

section Right

variable (R A : Type*) {B : Type*} [CommSemiring R] [Semiring A] [Semiring B]
  [Algebra R A] [Algebra R B]

/-- The ideal of `A ⊗[R] B` generated by the right inclusion of `I`. -/
def rightTensorIdeal (I : Ideal B) : Ideal (A ⊗[R] B) :=
  Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I

theorem rightTensorIdeal_def (I : Ideal B) :
    rightTensorIdeal R A I =
      Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I :=
  rfl

end Right

section Quotient

variable {R A B : Type*} [CommRing R] [Ring A] [Ring B] [Algebra R A] [Algebra R B]

/-- The kernel of tensoring a quotient map on the right is the right tensor ideal. -/
theorem ker_tensorProduct_map_id_quotient (I : Ideal B) [I.IsTwoSided] :
    RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R A) (Ideal.Quotient.mkₐ R I)) =
      rightTensorIdeal R A I := by
  rw [Algebra.TensorProduct.lTensor_ker _ (Ideal.Quotient.mkₐ_surjective R I)]
  rw [AlgHom.ker_coe, Ideal.Quotient.mkₐ_ker]
  rfl

end Quotient

end Ideal
