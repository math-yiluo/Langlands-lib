import Langlands.RingTheory.LocalFieldDensity.ImplicitPoints
import Mathlib.RingTheory.Ideal.GoingUp
import Mathlib.RingTheory.Localization.Integral
import Mathlib.RingTheory.Smooth.StandardSmoothCotangent
import Mathlib.RingTheory.Smooth.StandardSmoothOfFree
import Mathlib.RingTheory.Unramified.Field

/-! # Density of rational points of smooth domains over complete normed fields

Let `K` be a complete nontrivially normed field and let `A` be a smooth `K`-algebra which is a
domain and has a `K`-point. Then every nonzero element of `A` is nonzero at some `K`-point.

Near the given point, `A` has a basic open localization `S` with a submersive presentation. By the
implicit function theorem (`eventually_exists_algHom`), the free coordinates of the `K`-points of
`S` fill a neighbourhood, so the free coordinates are algebraically independent and `S` is
formally unramified, hence algebraic at the level of fraction fields, over the polynomial ring in
them. Therefore a nonzero element of `S` divides a nonzero polynomial in the free coordinates,
and that polynomial cannot vanish on a whole neighbourhood.
-/

noncomputable section

open MvPolynomial Filter Topology

namespace Langlands.RingTheory.LocalFieldDensity

section Algebraicity

variable {K : Type*} [Field K] {S : Type*} [CommRing S] [Algebra K S] {ι σ : Type*}

/-- The `K`-algebra map from polynomials in the free variables of a pre-submersive
presentation. -/
def freeCoordinates (P : Algebra.PreSubmersivePresentation K S ι σ) :
    MvPolynomial (FreeVar P) K →ₐ[K] S :=
  aeval fun i => P.val i

@[simp] theorem freeCoordinates_X (P : Algebra.PreSubmersivePresentation K S ι σ)
    (i : FreeVar P) : freeCoordinates P (X i) = P.val i :=
  aeval_X _ _

/-- If the free coordinates of a submersive presentation of a domain are algebraically
independent, then every nonzero element divides a nonzero polynomial in them. -/
theorem exists_ne_zero_freeCoordinates_eq_mul [Finite ι] [Finite σ] [IsDomain S]
    (P : Algebra.SubmersivePresentation K S ι σ)
    (hinj : Function.Injective (freeCoordinates P.toPreSubmersivePresentation))
    {h : S} (hh : h ≠ 0) :
    ∃ c : MvPolynomial (FreeVar P.toPreSubmersivePresentation) K, c ≠ 0 ∧
      ∃ b : S, freeCoordinates P.toPreSubmersivePresentation c = h * b := by
  classical
  set φ := freeCoordinates P.toPreSubmersivePresentation
  set A := MvPolynomial (FreeVar P.toPreSubmersivePresentation) K
  let : Algebra A S := φ.toRingHom.toAlgebra
  have : IsScalarTower K A S := IsScalarTower.of_algebraMap_eq fun r => (φ.commutes r).symm
  -- the differentials of `S` over the free coordinates vanish
  have hmap : KaehlerDifferential.map K A S S = 0 := by
    refine P.basisKaehler.ext fun k => ?_
    rw [P.basisKaehler_apply, KaehlerDifferential.map_D, LinearMap.zero_apply]
    have hk : algebraMap S S (P.val k) = algebraMap A S (X ⟨k.1, k.2⟩) :=
      (freeCoordinates_X P.toPreSubmersivePresentation ⟨k.1, k.2⟩).symm
    rw [hk, Derivation.map_algebraMap]
  have : Algebra.FormallyUnramified A S := by
    refine ⟨⟨fun ω ω' => ?_⟩⟩
    obtain ⟨ω, rfl⟩ := KaehlerDifferential.map_surjective K A S ω
    obtain ⟨ω', rfl⟩ := KaehlerDifferential.map_surjective K A S ω'
    rw [hmap, LinearMap.zero_apply, LinearMap.zero_apply]
  -- pass to fraction fields
  have := P.toGenerators.finiteType
  have : Algebra.FiniteType A S := Algebra.FiniteType.of_restrictScalars_finiteType K A S
  set L := FractionRing S
  set K₀ := FractionRing A
  have : FaithfulSMul A L := (faithfulSMul_iff_algebraMap_injective A L).mpr
    ((IsFractionRing.injective S L).comp hinj)
  let : Algebra K₀ L := FractionRing.liftAlgebra A L
  have : IsScalarTower A K₀ L := FractionRing.isScalarTower_liftAlgebra A L
  have : Algebra.FormallyUnramified S L :=
    Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors S)
  have : Algebra.FormallyUnramified A L := Algebra.FormallyUnramified.comp A S L
  have : Algebra.FormallyUnramified K₀ L := Algebra.FormallyUnramified.of_restrictScalars A K₀ L
  have : Algebra.EssFiniteType S L := Algebra.EssFiniteType.of_isLocalization L (nonZeroDivisors S)
  have : Algebra.EssFiniteType A L := Algebra.EssFiniteType.comp A S L
  have : Algebra.EssFiniteType K₀ L := Algebra.EssFiniteType.of_comp A K₀ L
  have : Algebra.IsSeparable K₀ L := Algebra.FormallyUnramified.isSeparable K₀ L
  have halg : IsAlgebraic A (algebraMap S L h) :=
    (IsFractionRing.isAlgebraic_iff A K₀ L).mpr (Algebra.IsAlgebraic.isAlgebraic _)
  have halgS : IsAlgebraic A h :=
    (isAlgebraic_algHom_iff (IsScalarTower.toAlgHom A S L) (IsFractionRing.injective S L)).mp halg
  -- a nonzero element of `A` in the ideal generated by `h`
  obtain ⟨c, hc, hc0⟩ := Submodule.ne_bot_iff _ |>.mp
    (Ideal.under_ne_bot_of_algebraic_mem hh (Ideal.mem_span_singleton_self h) halgS)
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (Ideal.mem_comap.mp hc)
  exact ⟨c, hc0, b, by rw [mul_comm]; exact hb.symm⟩

end Algebraicity

section Density

variable {K : Type*} [NontriviallyNormedField K] [CompleteSpace K]
  {A : Type*} [CommRing A] [Algebra K A]

/-- A smooth domain over a complete nontrivially normed field with a `K`-point: every nonzero
element is nonzero at some `K`-point. -/
theorem exists_algHom_apply_ne_zero [Algebra.Smooth K A] [IsDomain A] (x : A →ₐ[K] K)
    {a : A} (ha : a ≠ 0) : ∃ y : A →ₐ[K] K, y a ≠ 0 := by
  classical
  by_contra hcon
  push Not at hcon
  have : (RingHom.ker x).IsPrime := RingHom.ker_isPrime x
  obtain ⟨f, hf, hstd⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth K (RingHom.ker x)
  obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := hstd.out
  set S := Localization.Away f
  have hxf : x f ≠ 0 := fun h => hf (RingHom.mem_ker.mpr h)
  have hf0 : f ≠ 0 := fun h => hxf (by rw [h, map_zero])
  have hpow := powers_le_nonZeroDivisors_of_noZeroDivisors hf0
  have : IsDomain S := IsLocalization.isDomain_localization hpow
  let x' : S →ₐ[K] K := IsLocalization.Away.liftAlgHom f (isUnit_iff_ne_zero.mpr hxf)
  set φ := freeCoordinates P.toPreSubmersivePresentation
  have hev : ∀ (y : S →ₐ[K] K) (c : MvPolynomial (FreeVar P.toPreSubmersivePresentation) K),
      y (φ c) = eval (fun i : FreeVar P.toPreSubmersivePresentation => y (P.val i)) c :=
    fun y c => by
      change y (aeval (fun i : FreeVar P.toPreSubmersivePresentation => P.val i) c) = _
      rw [MvPolynomial.comp_aeval_apply]; rfl
  have hN := eventually_exists_algHom P x'
  -- the free coordinates are algebraically independent
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro c hc
    refine eq_zero_of_eventually_eval_eq_zero (hN.mono fun t ht => ?_)
    obtain ⟨y, hy⟩ := ht
    have : (fun i : FreeVar P.toPreSubmersivePresentation => y (P.val i)) = t := funext hy
    rw [← this, ← hev, hc, map_zero]
  have hh : algebraMap A S a ≠ 0 := fun h =>
    ha (IsLocalization.injective S hpow (by rw [h, map_zero]))
  obtain ⟨c, hc0, b, hcb⟩ := exists_ne_zero_freeCoordinates_eq_mul P hinj hh
  refine hc0 (eq_zero_of_eventually_eval_eq_zero (hN.mono fun t ht => ?_))
  obtain ⟨y, hy⟩ := ht
  have : (fun i : FreeVar P.toPreSubmersivePresentation => y (P.val i)) = t := funext hy
  have hya : y (algebraMap A S a) = 0 := hcon (y.comp (IsScalarTower.toAlgHom K A S))
  rw [← this, ← hev, hcb, map_mul, hya, zero_mul]

end Density

end Langlands.RingTheory.LocalFieldDensity
